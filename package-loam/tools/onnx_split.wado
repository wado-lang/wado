//! Split an `.onnx` into the two files Loam reads: a textual graph whose
//! weights carry no values, and a safetensors checkpoint holding them. A
//! model keeping its weights in external data files reads them from beside it.

use { args, eprintln, exit, println, Environment, Exit, Stderr, Stdout } from "core:cli";
use fs from "core:fs";
use { Preopens } from "core:fs";
use { TreeMap } from "core:collections";
use { Graph } from "../src/graph.wado";
use { external_locations, read_with_external } from "../src/onnx_proto.wado";
use { print } from "../src/onnx_print.wado";
use { split_weights, write_safetensors } from "../src/safetensors.wado";

/// The value, or the failure after `prefix` on stderr and exit status 1.
fn or_exit<T, E: Display>(result: Result<T, E>, prefix: String) -> T with (Stderr, Exit) {
    return match result {
        Ok(v) => v,
        Err(e) => {
            eprintln(`${prefix}${e}`);
            exit(1);
        },
    };
}

/// The graph `source` holds, its weights read from the external data files it
/// names. Those files are dropped on return, before the checkpoint is built.
fn read_model(source: &String) -> Graph with (Stderr, Exit, Preopens) {
    let bytes = or_exit(fs::read(source), "");
    // An external data file's location is relative to the model's directory.
    let dir = fs::parent(source).map(|p| p.to_string()).unwrap_or("");
    let mut files = TreeMap::<String, ByteList>::new();
    for let location of or_exit(external_locations(&bytes), `${*source}: `) {
        files[location] = or_exit(fs::read(fs::join(&dir, &location)), "");
    }
    return or_exit(read_with_external(&bytes, &files), `${*source}: `);
}

export fn run() with (Stdout, Stderr, Environment, Exit, Preopens) {
    let given = args();
    if given.len() != 2 {
        eprintln("usage: onnx_split <model.onnx> <stem>, writing <stem>.onnxtext and <stem>.safetensors");
        exit(2);
    }
    let [source, stem] = [given[0], given[1]];
    // A filesystem error names its path; a read or print error does not.
    let [kept, stored] = split_weights(read_model(&source));
    let text = or_exit(print(&kept), `${source}: `);
    or_exit(fs::write(`${stem}.onnxtext`, &text), "");
    or_exit(fs::write(`${stem}.safetensors`, &write_safetensors(&stored)), "");
    println(`${stem}.onnxtext and ${stem}.safetensors: ${stored.len()} weights`);
}
