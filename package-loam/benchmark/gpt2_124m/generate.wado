//! GPT-2 (124M) as `../generate.wado` drives it. `onnxruntime.cpp` is the
//! same program over onnxruntime.

use { Backend } from "lib:loam";
use { Generator } from "../generate.wado";
use { Model, Tokenizer } from "../../example/gpt2-124m/model.wado";

pub use { timed } from "../generate.wado";

impl<affine Bk: Backend> Generator for Model<Bk> {
    /// The graph takes no attention cache, so a run leaves nothing behind.
    fn reset(&mut self) {
    }

    fn step(&mut self, ids: &List<i32>) -> i32 with _ {
        return self.next_token(ids);
    }

    fn encode(text: &String) -> List<i32> {
        return Tokenizer::encode(text);
    }

    fn decode(ids: &List<i32>) -> String {
        return Tokenizer::decode(ids);
    }
}
