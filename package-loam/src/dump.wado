//! `loam dump`: how `build` lowers each operator of a checked graph, and the
//! shape stage 0 proved for each tensor. One `Report` holds it, and renders as
//! text for a reader or as JSON for a test. The device compiler's fusion is
//! decided when it runs, so no build-time report holds it.

use { to_string } from "core:json";
use { Serialize } from "core:serde";
use { CodeWriter } from "lib:wadopoet";
use { Graph, Known, Node, ValueInfo, element_of } from "./graph.wado";
use { rows_judged } from "./emit.wado";
use { Checked } from "./infer.wado";
use { Lowering, branches, lowerings } from "./lowering.wado";
use { Judged, padding } from "./pad.wado";
use { Shape } from "./shape.wado";

/// What `loam dump` reports for one graph.
pub struct Report {
    pub graph: String,
    /// The default domain's opset, `None` where the graph names none.
    pub opset: Option<i64>,
    pub scope: ScopeReport,
    /// Each length the inputs read: padded to a capacity, or the node that
    /// refused it.
    pub padding: List<Judged>,
    /// Whether each row of a batch holds padded lengths of its own: the axis
    /// the rows run along, or why they share them. `None` where no input pads
    /// a length behind its first axis.
    pub rows: Option<String> = null,
}

impl Serialize for Report;

/// One scope: the graph, or a branch of an `If`.
pub struct ScopeReport {
    /// Each axis's name and where it took it from.
    pub named_axes: List<[String, String]>,
    pub inputs: List<TensorReport>,
    pub weights: List<TensorReport>,
    pub nodes: List<NodeReport>,
    pub outputs: List<TensorReport>,
    /// Each condition stage 0 left `compute` to check: its reason, and the
    /// slack that must not be negative.
    pub owed: List<[String, String]>,
}

/// One node: how `build` lowers it.
pub struct NodeReport {
    pub lowering: Lowered,
    pub op: String,
    /// The node's operands, an absent optional one spelled `_`.
    pub inputs: List<String>,
    pub outputs: List<TensorReport>,
    pub branches: List<BranchReport> = [],
}

/// `Lowering` as a report spells it.
#[wire(name_policy = "snake_case")]
pub enum Lowered {
    Operation,
    Folded,
    Alias,
    Branch,
    Viewed,
    Attended,
    Attention,
}

/// One branch of an `If`, by the attribute holding it.
pub struct BranchReport {
    pub attr: String,
    pub scope: ScopeReport,
}

/// A tensor: the element it is computed in, its axes, and the elements stage
/// 0 folded it to. A folded tensor nothing reads as a tensor has extents and
/// no axes.
pub struct TensorReport {
    pub name: String,
    pub element: String,
    pub axes: List<[String, String]>,
    /// The extents of a folded tensor that has no axes.
    pub extents: Option<List<i32>> = null,
    /// The primitive a boundary tensor is held in, where it differs.
    pub held: Option<String> = null,
    /// The first `SHOWN` folded elements, and how many follow them.
    pub values: Option<List<String>> = null,
    pub more: i32 = 0,
}

/// The report for `graph`, checked as `checked`.
pub fn report(graph: &Graph, checked: &Checked) -> Report {
    return Report {
        graph: graph.name,
        opset: graph.opset,
        scope: scope(graph, checked),
        padding: padding(graph, checked),
        rows: match rows_judged(graph, checked) {
            Ok(Some(axis)) => Option::Some(`each its own, along ${axis}`),
            Ok(None) => null,
            Err(Shared(refusal)) => Option::Some(`shared: ${refusal}`),
            Err(e) => Option::Some(`${e}`),
        },
    };
}

/// `report` as text.
pub fn render_dump(graph: &Graph, checked: &Checked) -> String {
    let r = report(graph, checked);
    let mut w = CodeWriter::with_capacity(4096);
    let opset = match r.opset {
        Some(v) => `${v}`,
        None => "current",
    };
    w.line(`graph ${r.graph} (opset ${opset})`);
    let mut tally = Tally {};
    write_scope(&mut w, &r.scope, &mut tally);
    if !r.padding.is_empty() {
        w.line("padding");
        w.indent();
        for let judged of &r.padding {
            w.line(`${*judged}`);
        }
        w.dedent();
    }
    if let Some(rows) = &r.rows {
        w.line(`rows: ${*rows}`);
    }
    w.blank();
    w.line(
        `${tally.operations} operations, ${tally.folded} folded, ${tally.aliases} aliases, ${tally.branches} branches, ${tally.viewed} transposes viewed, ${tally.attentions} attentions of ${tally.attended} nodes`,
    );
    return w.to_string();
}

/// `report` as JSON.
pub fn render_dump_json(graph: &Graph, checked: &Checked) -> String {
    // Every field is a string, a number, a list or an option of them.
    return to_string(&report(graph, checked)).unwrap();
}

fn scope(graph: &Graph, checked: &Checked) -> ScopeReport {
    let lowered = lowerings(graph, checked);
    let mut nodes: List<NodeReport> = [];
    for let [at, node] of graph.nodes.into_iter().enumerate() {
        nodes.push(node_report(&node, lowered[at], checked));
    }
    let mut owed: List<[String, String]> = [];
    for let c of &checked.owed {
        owed.push([c.reason, `${c.slack}`]);
    }
    return ScopeReport {
        named_axes: checked.axis_names.into_iter().map(|n| [n.name, n.source]).collect(),
        inputs: boundary(&graph.inputs, checked),
        weights: boundary(&graph.initializers, checked),
        nodes,
        outputs: boundary(&graph.outputs, checked),
        owed,
    };
}

fn node_report(node: &Node, lowering: Lowering, checked: &Checked) -> NodeReport {
    // An optional output left unnamed is not computed.
    let computed = node.outputs.into_iter().filter(|o| o != "");
    let outputs: List<TensorReport> = computed.map(|o| tensor(checked, &o)).collect();
    let inputs: List<String> = node.inputs.into_iter().map(|i| if i == "" { "_" } else { i }).collect();
    let mut r = NodeReport { lowering: reported(lowering), op: node.op, inputs, outputs };
    if lowering matches { Branch } {
        for let b of branches(node, checked) {
            r.branches.push(BranchReport { attr: b.attr, scope: scope(&b.graph, &b.checked) });
        }
    }
    return r;
}

fn reported(lowering: Lowering) -> Lowered {
    return match lowering {
        Folded => Lowered::Folded,
        Alias => Lowered::Alias,
        Branch => Lowered::Branch,
        Operation => Lowered::Operation,
        Transposed => Lowered::Viewed,
        Attended => Lowered::Attended,
        Attention(_) => Lowered::Attention,
    };
}

/// A lowering as the left column reads it.
fn label(lowering: &Lowered) -> String {
    return match lowering {
        Operation => "operation",
        Folded => "folded",
        Alias => "alias",
        Branch => "branch",
        Viewed => "viewed",
        Attended => "attended",
        Attention => "attention",
    };
}

/// The tensors a graph declares at one boundary.
fn boundary(declared: &List<ValueInfo>, checked: &Checked) -> List<TensorReport> {
    let mut tensors: List<TensorReport> = [];
    for let vi of *declared {
        let mut t = tensor(checked, &vi.name);
        if let Some(element) = element_of(&vi.dtype) && element.primitive != element.computed {
            t.held = Option::Some(element.primitive);
        }
        tensors.push(t);
    }
    return tensors;
}

fn tensor(checked: &Checked, name: &String) -> TensorReport {
    let known = checked.known.get(*name);
    let mut t = TensorReport { name: *name, element: checked.primitives[*name], axes: [] };
    match checked.shapes.get(*name) {
        Some(shape) => t.axes = axes(&shape),
        None => t.extents = Option::Some(known.unwrap().extents),
    }
    if let Some(k) = known {
        t.values = Option::Some(shown(&k));
        t.more = i32::max(k.len() - SHOWN, 0);
    }
    return t;
}

fn axes(shape: &Shape) -> List<[String, String]> {
    return shape.axes.into_iter().map(|a| [a.name, `${a.extent}`]).collect();
}

/// A folded tensor's first `SHOWN` elements.
fn shown(k: &Known) -> List<String> {
    return match &k.elements {
        Ints(v) => first_shown(v),
        Symbolic(v) => first_shown(v),
        Floats(v) => first_shown(v),
        Bools(v) => first_shown(v),
    };
}

fn first_shown<T: Display>(values: &List<T>) -> List<String> {
    return values.into_iter().take(SHOWN).map(|x| `${x}`).collect();
}

/// Enough elements to tell a shape or an index list by, and few enough that a
/// mask as large as the context stays one line.
global SHOWN: i32 = 8;

/// How many nodes each lowering took, over every scope.
struct Tally {
    operations: i32 = 0,
    folded: i32 = 0,
    aliases: i32 = 0,
    branches: i32 = 0,
    /// The `Transpose`s a product reads past, by the weight as stored.
    viewed: i32 = 0,
    /// The attention composites, and the nodes each computes in its node's.
    attentions: i32 = 0,
    attended: i32 = 0,
}

fn write_scope(w: &mut CodeWriter, s: &ScopeReport, tally: &mut Tally) {
    if !s.named_axes.is_empty() {
        w.line("axes");
        w.indent();
        for let [name, source] of &s.named_axes {
            w.line(`${*name}: ${*source}`);
        }
        w.dedent();
    }
    write_boundary(w, "inputs", &s.inputs);
    write_boundary(w, "weights", &s.weights);
    w.line("nodes");
    w.indent();
    for let node of &s.nodes {
        match node.lowering {
            Operation => tally.operations += 1,
            Folded => tally.folded += 1,
            Alias => tally.aliases += 1,
            Branch => tally.branches += 1,
            Viewed => tally.viewed += 1,
            Attended => tally.attended += 1,
            Attention => tally.attentions += 1,
        }
        let outputs: List<String> = node.outputs.into_iter().map(|t| t.name).collect();
        // As wide as `operation`, the longest label.
        w.line(`${label(&node.lowering):<9} ${outputs.join(", ")} = ${node.op}(${node.inputs.join(", ")})`);
        w.indent();
        for let t of &node.outputs {
            w.line(`${t.name}: ${tensor_text(t)}`);
        }
        for let b of &node.branches {
            w.line(b.attr);
            w.indent();
            write_scope(w, &b.scope, tally);
            w.dedent();
        }
        w.dedent();
    }
    w.dedent();
    write_boundary(w, "outputs", &s.outputs);
    if !s.owed.is_empty() {
        w.line("owed");
        w.indent();
        for let [reason, slack] of &s.owed {
            w.line(`${*reason} (where ${*slack} >= 0)`);
        }
        w.dedent();
    }
}

/// One heading over the tensors a scope declares, which a branch may leave empty.
fn write_boundary(w: &mut CodeWriter, heading: String, declared: &List<TensorReport>) {
    if declared.is_empty() {
        return;
    }
    w.line(heading);
    w.indent();
    for let t of *declared {
        let held = match &t.held {
            Some(p) => ` (held as ${*p})`,
            None => "",
        };
        w.line(`${t.name}: ${tensor_text(&t)}${held}`);
    }
    w.dedent();
}

fn tensor_text(t: &TensorReport) -> String {
    let shape = match &t.extents {
        Some(e) => `${*e}`,
        None => {
            let spelled: List<String> = t.axes.into_iter().map(|axis| `${axis.0}=${axis.1}`).collect();
            `[${spelled.join(", ")}]`;
        },
    };
    let Some(values) = &t.values else {
        return `${t.element} ${shape}`;
    };
    let more = if t.more > 0 { `, … ${t.more} more` } else { "" };
    return `${t.element} ${shape} = [${values.join(", ")}${more}]`;
}
