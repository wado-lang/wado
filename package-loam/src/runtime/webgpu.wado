//! The WebGPU backend: the kernels over `wasi:webgpu`, beside `Cpu`.
//!
//! An f32 tensor lives on the device from the kernel, `upload` or `keep` that
//! writes it there until `compute` downloads it, and so does a `bool` one, as
//! 1.0 and 0.0. A kernel computes in f32 and rounds what it stores to a half
//! tensor's half, which it stores as f16s on a device with `shader-f16`, and
//! as the f32 equal to each otherwise. An `i64` or `i32` tensor stays on the
//! host, since WGSL stores no `i64` and the host computes both, and a gather
//! writes its indices to the device as `u32` when it runs, but for the index
//! `arg_max` leaves on the device as an f32, which a gather reads there. A
//! weight kept for products and gathers alone is held in bf16 or f16 where one
//! loses nothing, which halves what a product reads. The convolutions and
//! `max_pool` run on the CPU. See `package-loam/webgpu.md`.

use {
    Attention,
    BinaryOp,
    Holds,
    Cpu,
    CpuTensor,
    Element,
    ElementKind,
    Float,
    Epilogue,
    Expr,
    HalfFloat,
    Prologue,
    Read,
    RowOp,
    Tensor,
    UnaryOp,
    arg_max,
    broadcast_extents,
    constant,
    element_count,
    fused,
    fused_rows,
    matmul_broadcast,
    operand,
    row_extents,
} from "./tensor.wado";
use { HashMap, HashSet, TreeMap } from "core:collections";
use { LinearArray } from "core:linear";
use { HostWeight } from "./weight.wado";
use {
    Webgpu,
    Gpu,
    GpuAdapter,
    GpuDevice,
    GpuQueue,
    GpuCommandEncoder,
    GpuCommandBuffer,
    GpuBuffer,
    GpuBindGroupLayout,
    GpuBindGroup,
    GpuShaderModule,
    GpuComputePipeline,
    GpuComputePassEncoder,
    GpuSupportedFeatures,
    GpuSupportedLimits,
    RecordOptionGpuSize64,
    GpuFeatureName,
    GpuBufferDescriptor,
    GpuBufferUsage,
    GpuBindGroupDescriptor,
    GpuBindGroupEntry,
    GpuBindingResource,
    GpuBufferBinding,
    GpuCommandEncoderDescriptor,
    GpuComputePassDescriptor,
    GpuComputePassTimestampWrites,
    GpuQuerySet,
    GpuQuerySetDescriptor,
    GpuQueryType,
    GpuCommandBufferDescriptor,
    GpuDeviceDescriptor,
    GpuShaderModuleDescriptor,
    GpuComputePipelineDescriptor,
    GpuProgrammableStage,
    GpuLayoutMode,
    GpuMapMode,
    GpuIndex32,
    GpuSize32,
    GpuSize64,
} from "wasi:webgpu";

/// Elements of a device buffer seen through a view. The element at
/// coordinates `c` is the buffer's `offset + c[0] * strides[0] + …`, so an axis
/// a tensor is broadcast along has stride 0, and a regrouping is a new view of
/// the same buffer.
pub struct DeviceTensor {
    /// The buffer's place in the backend: see `WebGpuBackend::buffer`.
    internal slot: i32,
    internal offset: i32,
    internal extents: List<i32>,
    internal strides: List<i32>,
    /// How the buffer packs its elements where a word holds more than one. A
    /// shader reads the words as `Words` says.
    internal packed: Option<Packed>,
}

/// The elements a word holds more than one of: two halves, the even one in
/// the low half, or four bytes, the first in the lowest.
internal enum Packed {
    F16,
    BF16,
    U8,
}

impl Packed {
    /// The half `h` two to a word.
    fn halves(h: Option<HalfFloat>) -> Option<Packed> {
        return match h {
            Some(_::F16) => Option::Some(Packed::F16),
            Some(_::BF16) => Option::Some(Packed::BF16),
            null => null,
        };
    }
}

/// A tensor where the WebGPU backend holds it.
pub variant Placed<E, Axes> {
    Host(Tensor<E, Axes>),
    Device(DeviceTensor),
}

/// An operand of a fused or row kernel whose output has the axes `Axes`: a
/// view under its own extents, aligned with the output's from the end.
pub struct PlacedRead<Axes> {
    internal view: DeviceTensor,
}

/// A buffer the backend owns. A struct, so a list hands one out by reference,
/// which it cannot do for a resource held bare.
affine struct Slot {
    buffer: GpuBuffer,
    words: i32,
    /// Unique among the buffers the backend has made, so a cached bind group
    /// never names a buffer made in the place of the one it bound.
    id: i32,
}

/// A buffer an earlier pass retained: the slot it was made at, and its place
/// in `buffers`.
struct Carried {
    slot: i32,
    at: i32,
}

/// The positions an attention cache has written, of the `capacity` it holds.
struct Filled {
    positions: i32,
    capacity: i32,
}

/// A buffer no tensor holds, at its place in `buffers`.
struct Spare {
    at: i32,
    words: i32,
}

/// Values at places that stay theirs while they live, so a place can name
/// one, and a place a dropped value left is the next one's.
struct Places<affine T> {
    held: List<Option<T>>,
    vacant: List<i32>,
}

impl<affine T> Places<T> {
    fn new() -> Places<T> {
        return Places { held: [], vacant: [] };
    }

    /// `value`'s place.
    fn put(&mut self, value: T) -> i32 {
        let Some(at) = self.vacant.pop() else {
            self.held.push(Option::Some(value));
            return self.held.len() - 1;
        };
        self.held[at] = Option::Some(value);
        return at;
    }

    fn get(&self, at: i32) -> &T {
        let Some(value) = &self.held[at] else {
            unreachable();
        };
        return value;
    }

    fn get_mut(&mut self, at: i32) -> &mut T {
        let Some(value) = &mut self.held[at] else {
            unreachable();
        };
        return value;
    }

    /// Drops the value at `at`.
    fn remove(&mut self, at: i32) {
        self.held[at] = null;
        self.vacant.push(at);
    }
}

/// A bind group a dispatch made, which a later dispatch binding the same
/// spans to the same shader reuses.
affine struct CachedGroup {
    group: GpuBindGroup,
    key: List<i32>,
    /// The last pass a dispatch bound it in.
    used: i32,
}

/// A compiled shader, held as `Slot` holds a buffer.
affine struct Pipeline {
    compiled: GpuComputePipeline,
    layout: GpuBindGroupLayout,
    /// The case of the `ShaderKey` it was compiled from.
    kernel: String,
}

/// The device time of each dispatch since `profile`: a pair of timestamps
/// around each, resolved to the device and read back a query set at a time.
affine struct Profiler {
    queries: GpuQuerySet,
    resolved: GpuBuffer,
    readable: GpuBuffer,
    /// What each pair of `queries` written times, in order.
    timed: List<Timed>,
    /// The nanoseconds and the count of each `Timed` read back so far.
    spent: TreeMap<Timed, [i64, i32]>,
}

/// One kind of dispatch a profile tells apart: a shader on a grid.
struct Timed {
    pipeline: i32,
    groups: [i32, i32, i32],
}

/// What `WebGpuBackend::profiled` tells of one kind of dispatch.
pub struct KernelTime {
    /// The shader's kind, the `ShaderKey` case it was compiled from.
    pub kernel: String,
    /// Its workgroups along each dimension.
    pub groups: [i32, i32, i32],
    pub dispatches: i32,
    /// The device time all of them took, as the passes' timestamps measure it.
    pub nanoseconds: i64,
}

/// The dispatches one query set times: two queries each, and wgpu's limit of
/// 4096 queries a set.
global PROFILED_DISPATCHES: i32 = 2048;

/// The encoder recording a pass's commands until they are submitted, and the
/// one compute pass every dispatch goes into. A compute pass makes each
/// dispatch see what the ones before it wrote.
affine struct Recording {
    encoder: GpuCommandEncoder,
    pass: GpuComputePassEncoder,
}

/// The buffer the pass's dispatches read their parameters from, each at a
/// span of its own, so none is overwritten before the encoder runs.
struct Parameters {
    slot: i32,
    words: List<u32>,
    /// How many of `words` are on the device.
    written: i32,
}

/// What a launch did to the device, in order, which a replay does again
/// without working it out.
variant Command {
    /// A buffer of that many words, made at that slot.
    Allocated([i32, i32]),
    Dispatched(Dispatch),
}

/// A dispatch as `dispatched` takes it, its spans but the parameters', and
/// the place in `groups` of the bind group it bound.
struct Dispatch {
    pipeline: i32,
    spans: List<Span>,
    params: List<u32>,
    groups: [i32, i32, i32],
    group: i32,
}

/// The commands of a launch over `reads`, which a later launch reading views
/// laid out as those replays.
struct Encoded {
    reads: List<DeviceTensor>,
    commands: List<Command>,
    result: DeviceTensor,
    /// How many leading parameters of each dispatch a replay sets anew: none,
    /// or one count for each dispatch.
    heads: List<i32>,
    /// The last pass that recorded or replayed it.
    used: i32,
}

/// A buffer a launch of a program makes its `n`th buffer of `words` in, which
/// lives while the launch runs, so each call binds the one the call before
/// bound. Counted by size, a buffer one call makes and another does not, such
/// as a cache moved to a larger one, leaves the others where they were.
struct Owned {
    slot: i32,
    words: i32,
    /// Whether a call returned what it held, which then moved to the pass as
    /// the caller's, so a later call makes that buffer in the pass.
    returned: bool,
}

/// The parameters of a launch's dispatches, each at a span of its own in a
/// `Carved` buffer, which the dispatch binds on every call, so a call finds
/// its bind groups made.
struct LaunchParameters {
    /// Each dispatch's span and the place in `pipelines` of its shader, in
    /// the order the calls first dispatched them. A dispatch takes the span
    /// of the `n`th dispatch of its shader, so one a call makes and another
    /// does not, such as a copy of a cache, leaves the others where they were.
    spans: List<Span>,
    pipelines: List<i32>,
    /// The last pass a call ran the launch in.
    pass: i32,
    /// The submits made when a call last set its parameters: a later call
    /// sets them again only once the dispatches that read them are submitted.
    staged_at: i32,
}

/// A buffer launches' parameters are carved from, how many of its words are
/// carved, and how many spans of it launches still hold.
affine struct Carved {
    slot: i32,
    used: i32,
    spans: i32,
    /// The buffer's words as the host last set them, little-endian, so the
    /// words a call changes reach the device in one write.
    bytes: LinearArray<u8>,
    /// The words `from..<to` hold what the device does not yet.
    from: i32,
    to: i32,
}

/// The launch of a program running, by its `launch_key`, the words of each
/// buffer it has made, and the shader of each dispatch.
struct Running {
    launch: i64,
    made: List<i32>,
    dispatched: List<i32>,
}

/// The slots a recorded launch named, and those its replay names in their
/// place.
struct Renamed {
    from: List<i32>,
    to: List<i32>,
}

/// Whether the bind group cached under `key`, as `group_key` spells one, binds
/// a buffer whose `id` is among `ids`.
fn binds_any(key: &List<i32>, ids: &HashSet<i32>) -> bool {
    for let at of (1..<key.len()).step_by(3) {
        if ids.contains(key[at]) {
            return true;
        }
    }
    return false;
}

/// The launch whose root is the node `root` of the programs `serial`.
fn launch_key(serial: i32, root: i32) -> i64
    contract serial >= 0 && root >= 0
{
    return serial as i64 << 32 | root as i64;
}

/// The number `numbers` gives `key`, the next one where it gives none.
fn numbered<K: Hash>(numbers: &mut HashMap<K, i32>, key: K) -> i32 {
    if let Some(n) = numbers.get(key) {
        return n;
    }
    let n = numbers.len();
    numbers[key] = n;
    return n;
}

/// How many of `seen` are `value`, which then joins them.
fn occurrence(seen: &mut List<i32>, value: i32) -> i32 {
    let mut n = 0;
    for let v of &*seen {
        if *v == value {
            n += 1;
        }
    }
    seen.push(value);
    return n;
}

/// The slots `now` names in place of those `was` named, where each of `now` is
/// laid out as the one of `was` at its place: at the same place in its buffer,
/// and two in one buffer exactly where those were.
fn renamed_over(was: &List<DeviceTensor>, now: &List<&DeviceTensor>) -> Option<Renamed>
    contract was.len() == now.len(), "a launch reads as many views on every call"
{
    let mut slots = Renamed::new();
    for let i of 0..<now.len() {
        let a = &was[i];
        let b = now[i];
        let laid_out = a.extents == b.extents && reads_as(b, a.offset, &a.strides) && a.packed == b.packed;
        if !laid_out || !slots.bound(a.slot, b.slot) {
            return null;
        }
    }
    return Option::Some(slots);
}

impl Carved {
    fn word(&self, at: i32) -> u32 {
        let b = 4 * at;
        return self.bytes[b] as u32 | self.bytes[b + 1] as u32 << 8 | self.bytes[b + 2] as u32 << 16 | self.bytes[b + 3] as u32 << 24;
    }

    fn set_word(&mut self, at: i32, word: u32) {
        let b = 4 * at;
        self.bytes[b] = word as u8;
        self.bytes[b + 1] = (word >> 8) as u8;
        self.bytes[b + 2] = (word >> 16) as u8;
        self.bytes[b + 3] = (word >> 24) as u8;
    }
}

/// How many of `commands` are dispatches.
fn dispatches_in(commands: &List<Command>) -> i32 {
    let mut n = 0;
    for let c of commands {
        if c matches { Dispatched(_) } {
            n += 1;
        }
    }
    return n;
}

/// `d`'s spans, each slot as `slots` renames it.
fn renamed_spans(d: &Dispatch, slots: &Renamed) -> List<Span> {
    let mut spans: List<Span> = [];
    for let s of &d.spans {
        spans.push(Span { ..*s, slot: slots.of(s.slot) });
    }
    return spans;
}

impl Renamed {
    fn new() -> Renamed {
        return Renamed { from: [], to: [] };
    }

    /// Whether `from` is named `to`, taking that name where neither is named
    /// yet.
    fn bound(&mut self, from: i32, to: i32) -> bool {
        for let i of 0..<self.from.len() {
            if self.from[i] == from || self.to[i] == to {
                return self.from[i] == from && self.to[i] == to;
            }
        }
        self.from.push(from);
        self.to.push(to);
        return true;
    }

    fn of(&self, from: i32) -> i32 {
        for let i of 0..<self.from.len() {
            if self.from[i] == from {
                return self.to[i];
            }
        }
        panic("loam: a launch binds a buffer it neither reads nor makes");
    }
}

/// The kernels on a WebGPU device, and on the CPU where no shader is written.
pub affine struct WebGpuBackend {
    device: GpuDevice,
    queue: GpuQueue,
    pipelines: List<Pipeline>,
    /// Each compiled shader's place in `pipelines`, by what it is made of. A
    /// `Shader` has no `Hash` while its derivation is a roadmap item of WEP:
    /// HashMap.
    compiled: TreeMap<Shader, i32>,
    /// The place in `buffers` of each buffer that outlives a pass, by its
    /// negative slot: one `keep` wrote, which lives as long as the backend, or
    /// one a launch owns, or carves parameters from, which lives while the
    /// launch runs.
    held: HashMap<i32, i32>,
    /// The slots `held` has numbered.
    held_slots: i32,
    /// Every buffer: held, of the current pass, carried into it, or spare.
    buffers: Places<Slot>,
    /// The places in `buffers` of the last pass's buffers that nothing
    /// retained, in the order it made them, for this pass to make its own
    /// of. A pass makes the buffers the one before it made, so its dispatches
    /// bind the same buffers, and find their bind groups made. `begin` drops
    /// a spare no buffer of the pass took.
    spare: List<Spare>,
    /// The places in `buffers` of the current pass's buffers, which `begin`
    /// releases.
    pass: List<i32>,
    /// The slot of `pass[0]`. Each pass numbers its buffers after the last
    /// one's, so a slot never names two buffers.
    pass_start: i32,
    /// The slots of this pass's buffers, and of those carried into it, that
    /// `retain` keeps through the next `begin`.
    retaining: HashSet<i32>,
    /// The buffers of earlier passes that the pass before this one retained.
    carried: List<Carried>,
    /// What each attention cache holds, by slot. A step appends to the cache
    /// its past is in only where that past ends at the last position written,
    /// so a branch from an earlier past never writes over what a later step
    /// reads.
    filled: HashMap<i32, Filled>,
    /// The commands recorded and not yet submitted: none, or one encoder.
    recording: List<Recording>,
    /// The dispatches recorded and not yet submitted.
    unsubmitted: i32,
    /// How many times `flush` has submitted what was recorded.
    submits: i32,
    /// Each bind group made, and its place by its `group_key`.
    groups: Places<CachedGroup>,
    group_at: HashMap<List<i32>, i32>,
    /// The commands of the launch being recorded: none where no launch is, or
    /// where it wrote a host value or read one back, which a replay would not.
    taping: Option<List<Command>>,
    /// Each launch recorded, by its `replay_key`.
    encoded: HashMap<i32, List<Encoded>>,
    replay_keys: HashMap<List<i32>, i32>,
    /// The serial of the programs of each structure `compiled` met.
    programs: HashMap<List<i32>, i32>,
    /// The number of each launch signature `compiled` met.
    signatures: HashMap<List<i32>, i32>,
    /// The buffers each launch of a program makes, by its `launch_key`, in
    /// the order a launch makes them.
    owned: HashMap<i64, List<Owned>>,
    /// The slots of those a launch still makes its next ones in.
    remade_slots: HashSet<i32>,
    /// The parameters of each launch of a program, by the same key.
    launch_parameters: HashMap<i64, LaunchParameters>,
    /// The buffers launches' parameters are carved from, the last the one
    /// carved from now.
    carved: List<Carved>,
    running: Option<Running>,
    /// The passes `begin` has started.
    passes: i32,
    next_id: i32,
    /// The parameters of this pass's dispatches: none before the first.
    parameters: Option<Parameters>,
    /// The storage buffers one shader binds, less its output and parameters.
    max_operands: i32,
    /// The 32-bit words one storage binding holds.
    max_binding: i32,
    /// The 32-bit words a binding's start is a multiple of.
    alignment: i32,
    /// Whether a shader reads and writes f16s, which the device's
    /// `shader-f16` grants; where not, it reads a word of two halves.
    f16: bool,
    /// Whether the device grants `timestamp-query`, which `profile` needs.
    timestamps: bool,
    profiler: Option<Profiler>,
    read_backs: i32,
    dispatches: i32,
    bind_groups: i32,
    replays: i32,
    internal cpu: Cpu,
}

/// Invocations per workgroup of every shader but the product's: a power of
/// two, as the shaders' reductions halve it, and WebGPU's default limit. A
/// step over one token runs a row kernel as one workgroup, which waits on its
/// lanes' walk along the row: Gemma 3 (270M)'s token took 0.90 times the
/// device time it took at 64.
global LANES: i32 = 256;

/// The positions one workgroup of `attend_shader` scores, a power of two
/// dividing `LANES`: the lanes split each position's dot among
/// `LANES / ATTEND_PART` of them. The parts grow from it where a prompt's
/// rows would outgrow a binding. Fewer positions a part means more parts for
/// `attend_join_shader` to read, and more lanes a dot: on Gemma 3 (270M)'s 8
/// tokens from a short prompt, the two shaders took 1.46 times as long on the
/// device with parts of 16 as with parts of 4, and 0.99 times with parts of 2.
global ATTEND_PART: i32 = 4;

/// The fewest positions an attention cache holds, a power of two.
global CACHE_LEAST: i32 = 64;

/// The most workgroups one dispatch dimension takes, as WebGPU's default limit
/// sets it.
global MAX_GROUPS: i32 = 65535;

/// The bytes one write to the device copies at most.
global WRITE_BYTES: i32 = 16_777_216;

/// The words one buffer of dispatch parameters holds.
global PARAMETER_WORDS: i32 = 65536;

/// The dispatches recorded before they are submitted, so the device runs the
/// first while the host records the rest. Gemma 3 (270M)'s 7 steps after a
/// prompt took 0.97 times as long through `compute` at 16 as at 32, and 1.05
/// times at 8, where each submit costs the host more than the device waits.
global SUBMIT_EVERY: i32 = 16;

/// The layouts of its reads a launch keeps the commands of. A generation's
/// first step reads a cache the prompt wrote, laid out unlike the one a step
/// writes, and its first step past a capacity reads one just refitted.
global LAYOUTS: i32 = 4;

/// The passes a launch's commands, buffers and parameters, and a bind group
/// of buffers that live, outlive their last use by. A generation's first
/// steps come round again only with the next prompt.
global IDLE_PASSES: i32 = 256;

/// The passes between two walks of every launch for the idle ones, which
/// `IDLE_PASSES` then outlive by up to this many more.
global SWEEP_PASSES: i32 = 32;

/// The slot of a buffer not allocated yet, which `binds` reads a view of
/// before the buffer exists. No buffer is ever at it.
global PENDING: i32 = i32::MAX;

/// The side of a matrix product's tile, which `product_shader` spells as `16u`.
global TILE: i32 = 16;

/// The rows `narrow_product_shader` sums at once, a block of them per pass
/// over the inner axis.
global NARROW: i32 = 4;

/// The most rows a product runs `narrow_product_shader` for. A tile of 16
/// rows leaves 15 of 16 lanes idle on a model's step over one token. The
/// narrow product's time grows with its rows and the tiled one's does not:
/// on GPT-2 (124M)'s layers on an RTX 4060 Ti the two meet at about 7, and on
/// Gemma 3 (270M)'s narrower ones the narrow product still runs a prompt
/// padded to 8 rows 1.3x as fast.
global NARROW_ROWS: i32 = 8;

/// The invocations of one workgroup of `narrow_product_shader`.
global NARROW_LANES: i32 = 256;

/// The bytes of workgroup memory one shader declares at most, as WebGPU's
/// default limit sets it, which the device keeps.
global WORKGROUP_BYTES: i32 = 16384;

/// The workgroups `narrow_columns` keeps a product across a transposed weight
/// at: four for each of an RTX 4060 Ti's 34 multiprocessors, below which the
/// device waits on too few reads at once.
global NARROW_GROUPS: i32 = 128;

/// The longest attention head `attend_shader` holds a query of in workgroup
/// memory.
global MAX_HEAD: i32 = 1024;

impl WebGpuBackend {
    /// The backend on the first adapter the host offers, or `None` where it
    /// offers none. The device takes the adapter's own limits, since a model's
    /// embedding outgrows WebGPU's default binding of 128 MiB.
    pub fn new() -> Option<WebGpuBackend> with (Webgpu, Gpu, GpuAdapter, GpuDevice, GpuSupportedFeatures, GpuSupportedLimits, RecordOptionGpuSize64) {
        let gpu = Webgpu::get_gpu();
        let Some(adapter) = gpu.request_adapter(null).wait() else {
            return null;
        };
        let shader_f16 = adapter.features().has("shader-f16");
        let timestamps = adapter.features().has("timestamp-query");
        let mut features: List<GpuFeatureName> = [];
        if shader_f16 {
            features.push(GpuFeatureName::ShaderF16);
        }
        if timestamps {
            features.push(GpuFeatureName::TimestampQuery);
        }
        let offered = adapter.limits();
        let required = RecordOptionGpuSize64::new();
        required.add(
            "maxStorageBufferBindingSize",
            Option::Some(offered.max_storage_buffer_binding_size() as GpuSize64),
        );
        required.add("maxBufferSize", Option::Some(offered.max_buffer_size() as GpuSize64));
        required.add(
            "maxStorageBuffersPerShaderStage",
            Option::Some(offered.max_storage_buffers_per_shader_stage() as u64 as GpuSize64),
        );
        required.add(
            "minStorageBufferOffsetAlignment",
            Option::Some(offered.min_storage_buffer_offset_alignment() as u64 as GpuSize64),
        );
        let descriptor = GpuDeviceDescriptor {
            required_features: Option::Some(features),
            required_limits: Option::Some(required),
            default_queue: null,
            label: null,
        };
        let Ok(device) = adapter.request_device(Option::Some(descriptor)).wait() else {
            return null;
        };
        // What the device grants, which a binding must keep to.
        let limits = device.limits();
        let bytes = u64::min(limits.max_storage_buffer_binding_size(), limits.max_buffer_size()) / 4;
        let buffers = limits.max_storage_buffers_per_shader_stage();
        let alignment = limits.min_storage_buffer_offset_alignment() as i32 / 4;
        let queue = device.queue();
        return Option::Some(WebGpuBackend {
            device,
            queue,
            pipelines: [],
            compiled: TreeMap::new(),
            held: HashMap::new(),
            held_slots: 0,
            buffers: Places::new(),
            spare: [],
            pass: [],
            pass_start: 0,
            retaining: HashSet::new(),
            carried: [],
            filled: HashMap::new(),
            recording: [],
            unsubmitted: 0,
            submits: 0,
            groups: Places::new(),
            group_at: HashMap::new(),
            taping: null,
            encoded: HashMap::new(),
            replay_keys: HashMap::new(),
            programs: HashMap::new(),
            signatures: HashMap::new(),
            owned: HashMap::new(),
            remade_slots: HashSet::new(),
            launch_parameters: HashMap::new(),
            carved: [],
            running: null,
            passes: 0,
            next_id: 0,
            parameters: null,
            max_operands: saturated(buffers as u64) - 2,
            max_binding: saturated(bytes),
            alignment,
            f16: shader_f16,
            timestamps,
            profiler: null,
            read_backs: 0,
            dispatches: 0,
            bind_groups: 0,
            replays: 0,
            cpu: Cpu {},
        });
    }

    /// The device's storage buffer offset alignment, in f32 elements: where a
    /// binding may start.
    pub fn alignment(&self) -> i32 {
        return self.alignment;
    }

    /// Binds at most `words` 32-bit words to one shader, as a device with a
    /// smaller limit would: a kernel past it splits, or runs on the CPU.
    pub fn limit_binding(&mut self, words: i32)
        contract words >= self.alignment()
    {
        self.max_binding = i32::min(self.max_binding, words);
    }

    /// Computes a half as a device without `shader-f16` does, in f32 words.
    pub fn forgo_shader_f16(&mut self) {
        self.f16 = false;
    }

    /// The bytes of the buffers that outlive a pass: those `keep` and
    /// `kept_matrix` wrote, and those launches of programs own or carve
    /// parameters from.
    pub fn kept_bytes(&self) -> u64 with GpuBuffer {
        let mut bytes: u64 = 0;
        for let at of self.held.values() {
            bytes += self.buffers.get(*at).buffer.size() as u64;
        }
        return bytes;
    }

    /// How many times a tensor has been read back from the device: each is a
    /// synchronization, which a pass makes only for what it returns.
    pub fn read_backs(&self) -> i32 {
        return self.read_backs;
    }

    /// How many shaders have been dispatched: the cost a pass pays per kernel
    /// at batch size 1.
    pub fn dispatches(&self) -> i32 {
        return self.dispatches;
    }

    /// The most words one buffer, or one binding of it, holds.
    internal fn max_binding(&self) -> i32 {
        return self.max_binding;
    }

    /// Starts timing each later dispatch on the device, for `profiled`, where
    /// the device grants `timestamp-query`; returns whether it does. Each
    /// dispatch then takes a compute pass and a submit of its own, so the
    /// host's time is no longer the one to read.
    pub fn profile(
        &mut self,
    ) -> bool with (GpuDevice, GpuQuerySet, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroup, GpuComputePassEncoder) {
        if !self.timestamps {
            return false;
        }
        // A dispatch joining a pass begun before would go untimed.
        self.flush();
        let Ok(queries) = self.device.create_query_set(GpuQuerySetDescriptor {
            type: GpuQueryType::Timestamp,
            count: (2 * PROFILED_DISPATCHES) as u32 as GpuSize32,
            label: null,
        }) else {
            panic("loam: a device granting `timestamp-query` made no query set");
        };
        let size = (16 * PROFILED_DISPATCHES) as u64 as GpuSize64;
        let resolved = self.device.create_buffer(GpuBufferDescriptor {
            size,
            usage: GpuBufferUsage::QueryResolve | GpuBufferUsage::CopySrc,
            mapped_at_creation: null,
            label: null,
        });
        let readable = self.device.create_buffer(GpuBufferDescriptor {
            size,
            usage: GpuBufferUsage::MapRead | GpuBufferUsage::CopyDst,
            mapped_at_creation: null,
            label: null,
        });
        self.profiler = Option::Some(Profiler { queries, resolved, readable, timed: [], spent: TreeMap::new() });
        return true;
    }

    /// The device time each kind of dispatch took since `profile`, the
    /// longest first. Waits for the device to finish what was recorded.
    pub fn profiled(
        &mut self,
    ) -> List<KernelTime> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroup, GpuComputePassEncoder) {
        self.flush();
        self.read_profile();
        let Some(p) = &self.profiler else {
            unreachable();
        };
        let mut times: List<KernelTime> = [];
        for let [timed, [nanoseconds, dispatches]] of p.spent.entries() {
            times.push(KernelTime {
                kernel: self.pipelines[timed.pipeline].kernel,
                groups: timed.groups,
                dispatches: *dispatches,
                nanoseconds: *nanoseconds,
            });
        }
        times.sort_by(|a, b| b.nanoseconds.cmp(&a.nanoseconds));
        return times;
    }

    /// Adds the timestamps the profile's dispatches wrote to what it has
    /// spent, leaving its query set to write again.
    fn read_profile(&mut self) with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer) {
        let Some(p) = &mut self.profiler else {
            panic("loam: `profile` must have started a profile");
        };
        let count = p.timed.len();
        if count == 0 {
            return;
        }
        let size = (16 * count) as u64 as GpuSize64;
        let encoder = self.device.create_command_encoder(Option::Some(GpuCommandEncoderDescriptor { label: null }));
        encoder.resolve_query_set(&p.queries, 0, (2 * count) as u32 as GpuSize32, &p.resolved, 0);
        encoder.copy_buffer_to_buffer(&p.resolved, null, &p.readable, null, Option::Some(size));
        let commands = encoder.finish(Option::Some(GpuCommandBufferDescriptor { label: null }));
        self.queue.submit([&commands]);
        if p.readable.map_async(GpuMapMode::Read, null, Option::Some(size)).wait().is_err() {
            panic("loam: a profile's timestamps did not map for reading");
        }
        let Ok(bytes) = p.readable.get_mapped_range_get_with_copy(null, Option::Some(size)) else {
            panic("loam: a profile's mapped timestamps gave no bytes");
        };
        let stamps = List::<u64>::from_le_bytes(bytes as ByteList);
        if p.readable.unmap().is_err() {
            panic("loam: a profile's timestamps did not unmap");
        }
        for let i of 0..<count {
            // A device may reset its counter between two stamps, and WebGPU
            // lets such a pass be ignored.
            if stamps[2 * i + 1] < stamps[2 * i] {
                continue;
            }
            let elapsed = (stamps[2 * i + 1] - stamps[2 * i]) as i64;
            let [nanoseconds, dispatches] = p.spent.get(p.timed[i]).unwrap_or([0 as i64, 0]);
            p.spent[p.timed[i]] = [nanoseconds + elapsed, dispatches + 1];
        }
        p.timed = [];
    }

    /// How many bind groups have been made: a pass that binds what the one
    /// before it bound makes none.
    pub fn bind_groups(&self) -> i32 {
        return self.bind_groups;
    }

    /// How many launches of a program did again what an earlier call of it
    /// recorded, rather than working out their dispatches.
    pub fn replays(&self) -> i32 {
        return self.replays;
    }

    /// The buffer at `slot`: a held one where it is negative, one of the pass
    /// otherwise.
    fn buffer(&self, slot: i32) -> &GpuBuffer {
        return &self.slot(slot).buffer;
    }

    fn slot(&self, slot: i32) -> &Slot {
        return self.buffers.get(self.place(slot));
    }

    /// The place in `buffers` of a held, the pass's or a carried buffer.
    fn place(&self, slot: i32) -> i32 {
        if slot < 0 {
            return self.held[slot];
        }
        if slot >= self.pass_start {
            return self.pass[slot - self.pass_start];
        }
        for let c of &self.carried {
            if c.slot == slot {
                return c.at;
            }
        }
        panic("loam: a tensor of an earlier pass is read after `begin`, and that pass did not retain it");
    }

    /// A buffer of `count` 32-bit words, and its slot: a spare of that size,
    /// or a new one. A spare's words are what its last pass left.
    internal fn allocated(&mut self, count: i32, kept: bool) -> i32 with (GpuDevice, GpuBuffer) {
        if kept {
            return self.held_buffer(count);
        }
        let slot = match self.owned_buffer(count) {
            Some(s) => s,
            null => self.pass_buffer(count),
        };
        if let Some(commands) = &mut self.taping {
            commands.push(Command::Allocated([count, slot]));
        }
        return slot;
    }

    /// The buffer the running launch makes its next one in, made where no
    /// call made that one yet: `None` where no program runs, or where its
    /// calls make that one in the pass.
    fn owned_buffer(&mut self, count: i32) -> Option<i32> with (GpuDevice, GpuBuffer) {
        let Some(r) = &mut self.running else {
            return null;
        };
        let key = r.launch;
        let mut nth = occurrence(&mut r.made, count);
        if !self.owned.contains_key(key) {
            self.owned[key] = [];
        }
        for let o of &self.owned[key] {
            if o.words != count {
                continue;
            }
            if nth == 0 {
                return if o.returned { null } else { Option::Some(o.slot) };
            }
            nth -= 1;
        }
        let slot = self.held_buffer(count);
        self.owned[key].push(Owned { slot, words: count, returned: false });
        self.remade_slots.insert(slot);
        return Option::Some(slot);
    }

    /// Passes over the buffer of `count` words the running launch makes next,
    /// which this run already holds, so each one after it stays the one it was.
    fn made_elsewhere(&mut self, count: i32) {
        if let Some(r) = &mut self.running {
            occurrence(&mut r.made, count);
        }
    }

    /// A new buffer of `count` 32-bit words that outlives a pass, and its
    /// slot.
    fn held_buffer(&mut self, count: i32) -> i32 with (GpuDevice, GpuBuffer) {
        self.held_slots += 1;
        let slot = -self.held_slots;
        self.held[slot] = self.buffers.put(self.created(count));
        return slot;
    }

    /// Drops the held buffer at `slot`, adding its `id` to `dropped`.
    fn dropped_held(&mut self, slot: i32, dropped: &mut HashSet<i32>) {
        self.dropped_buffer(self.held[slot], dropped);
        self.held.remove(slot);
    }

    /// Drops the buffer at `at` in `buffers`, adding its `id` to `dropped`.
    fn dropped_buffer(&mut self, at: i32, dropped: &mut HashSet<i32>) {
        dropped.insert(self.buffers.get(at).id);
        self.buffers.remove(at);
    }

    /// Starts the launch whose root is the node `root` of the program
    /// `serial`, which makes its buffers in those its calls own and binds the
    /// parameters they bound, so a call finds its bind groups made. A call
    /// whose last one's dispatches are still recorded submits them first:
    /// queued after the submit, its write to the parameters reaches the device
    /// once they ran.
    internal fn launching(
        &mut self,
        serial: i32,
        root: i32,
    ) with (GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBindGroup, GpuBuffer, GpuComputePassEncoder) {
        let launch = launch_key(serial, root);
        if !self.launch_parameters.contains_key(launch) {
            self.launch_parameters[launch] = LaunchParameters { spans: [], pipelines: [], pass: -1, staged_at: -1 };
        }
        if self.launch_parameters[launch].staged_at == self.submits {
            self.flush();
        }
        self.launch_parameters[launch].pass = self.passes;
        if let Some(r) = &mut self.running {
            r.launch = launch;
            r.made.clear();
            r.dispatched.clear();
            return;
        }
        self.running = Option::Some(Running { launch, made: [], dispatched: [] });
    }

    /// Ends a call of the program `serial`, which returned the values at the
    /// slots `returned`. Each buffer a launch owns that holds a returned value
    /// moves to the pass, as the caller's. The result maps each such buffer's
    /// slot to the one it takes in the pass.
    internal fn ran_program(&mut self, serial: i32, returned: &List<i32>) -> HashMap<i32, i32> {
        self.running = null;
        let mut launches: List<i64> = [];
        for let key of self.owned.keys() {
            if *key >> 32 == serial as i64 {
                launches.push(*key);
            }
        }
        let mut given: List<i32> = [];
        for let key of launches {
            for let o of &mut self.owned[key] {
                if !o.returned && returned.contains(&o.slot) {
                    o.returned = true;
                    given.push(o.slot);
                }
            }
        }
        let mut moved = HashMap::<i32, i32>::new();
        for let slot of given {
            self.pass.push(self.held[slot]);
            self.held.remove(slot);
            self.remade_slots.remove(slot);
            let to = self.pass_start + self.pass.len() - 1;
            moved[slot] = to;
            if let Some(cache) = self.filled.get(slot) {
                self.filled.remove(slot);
                self.filled[to] = cache;
            }
        }
        return moved;
    }

    /// The span of `params` a dispatch of the shader at `pipeline` binds: the
    /// running launch's own, carved where its calls have not dispatched the
    /// shader that often yet, and the pass's where no launch runs.
    fn parameters_for(&mut self, pipeline: i32, params: &List<u32>) -> Span with (GpuDevice, GpuQueue, GpuBuffer) {
        let Some(r) = &mut self.running else {
            return self.parameter_span(params);
        };
        let mut nth = occurrence(&mut r.dispatched, pipeline);
        let own = &mut self.launch_parameters[r.launch];
        own.staged_at = self.submits;
        for let i of 0..<own.spans.len() {
            if own.pipelines[i] != pipeline {
                continue;
            }
            if nth > 0 {
                nth -= 1;
                continue;
            }
            let span = own.spans[i];
            if span.count != params.len() {
                return self.parameter_span(params);
            }
            self.staged(&span, params);
            return span;
        }
        let span = self.carved_span(params.len());
        own.spans.push(span);
        own.pipelines.push(pipeline);
        self.staged(&span, params);
        return span;
    }

    /// Sets the words of `span`, carved from a launch's buffer, to `params`,
    /// for the next submit to write where they changed.
    fn staged(&mut self, span: &Span, params: &List<u32>) {
        for let k of 0..<self.carved.len() {
            let c = &mut self.carved[k];
            if c.slot != span.slot {
                continue;
            }
            for let i of 0..<span.count {
                let at = span.first + i;
                if c.word(at) != params[i] {
                    c.set_word(at, params[i]);
                    c.from = i32::min(c.from, at);
                    c.to = i32::max(c.to, at + 1);
                }
            }
            return;
        }
        unreachable();
    }

    /// A span of `count` words of parameters for a launch to hold.
    fn carved_span(&mut self, count: i32) -> Span with (GpuDevice, GpuBuffer)
        contract count <= PARAMETER_WORDS
    {
        let last = self.carved.len() - 1;
        if last >= 0 {
            let c = &mut self.carved[last];
            let first = self.aligned(c.used);
            if first + count <= PARAMETER_WORDS {
                c.used = first + count;
                c.spans += 1;
                return Span { slot: c.slot, first, count };
            }
        }
        let slot = self.held_buffer(PARAMETER_WORDS);
        self.carved.push(Carved {
            slot,
            used: count,
            spans: 1,
            bytes: LinearArray::<u8>::filled(4 * PARAMETER_WORDS, 0),
            from: PARAMETER_WORDS,
            to: 0,
        });
        return Span { slot, first: 0, count };
    }

    /// Gives back a span `carved_span` carved from the buffer at `slot`,
    /// which drops once it holds no span, adding its `id` to `dropped`.
    fn uncarved(&mut self, slot: i32, dropped: &mut HashSet<i32>) {
        for let i of 0..<self.carved.len() {
            if self.carved[i].slot == slot {
                self.carved[i].spans -= 1;
                if self.carved[i].spans == 0 {
                    self.carved.remove(i);
                    self.dropped_held(slot, dropped);
                }
                return;
            }
        }
        unreachable();
    }

    /// Drops what each launch the last `IDLE_PASSES` passes did not run
    /// holds: the buffers it owns, but those a call returned, which are the
    /// caller's, and its parameters. Each buffer dropped adds its `id` to
    /// `dropped`.
    fn dropped_idle_launches(&mut self, oldest: i32, dropped: &mut HashSet<i32>) {
        let mut idle: List<i64> = [];
        for let [key, parameters] of self.launch_parameters.entries() {
            if parameters.pass < oldest {
                idle.push(*key);
            }
        }
        for let key of idle {
            if let Some(owned) = self.owned.get(key) {
                for let o of owned {
                    if !o.returned {
                        self.dropped_held(o.slot, dropped);
                        self.remade_slots.remove(o.slot);
                    }
                }
                self.owned.remove(key);
            }
            for let s of self.launch_parameters[key].spans {
                self.uncarved(s.slot, dropped);
            }
            self.launch_parameters.remove(key);
        }
    }

    /// `words` rounded up to a multiple of the binding alignment.
    fn aligned(&self, words: i32) -> i32 {
        return (words + self.alignment - 1) / self.alignment * self.alignment;
    }

    /// A buffer of the pass of `count` 32-bit words, and its slot, which no
    /// launch records: a spare of that size, or a new one.
    fn pass_buffer(&mut self, count: i32) -> i32 with (GpuDevice, GpuBuffer) {
        let mut at = -1;
        for let i of 0..<self.spare.len() {
            if self.spare[i].words == count {
                at = self.spare.remove(i).at;
                break;
            }
        }
        if at < 0 {
            at = self.buffers.put(self.created(count));
        }
        self.pass.push(at);
        return self.pass_start + self.pass.len() - 1;
    }

    fn created(&mut self, count: i32) -> Slot with (GpuDevice, GpuBuffer) {
        let buffer = self.device.create_buffer(GpuBufferDescriptor {
            size: byte_size(count),
            usage: GpuBufferUsage::Storage | GpuBufferUsage::CopySrc | GpuBufferUsage::CopyDst,
            mapped_at_creation: null,
            label: null,
        });
        self.next_id += 1;
        return Slot { buffer, words: count, id: self.next_id };
    }

    /// Makes the buffer at `at` in `buffers` a spare.
    fn release(&mut self, at: i32) {
        self.spare.push(Spare { at, words: self.buffers.get(at).words });
    }

    /// A new buffer of `count` 32-bit words, `word(i)` the `i`th, and its
    /// slot. The words are encoded one write at a time, so a tensor never has
    /// a second copy whole on the host.
    fn written(&mut self, count: i32, word: fn(i32) -> u32, kept: bool) -> i32 with (GpuDevice, GpuQueue, GpuBuffer) {
        let slot = self.reserved(count, kept);
        self.write(slot, 0, count, word);
        return slot;
    }

    /// A new buffer of `count` 32-bit words for a `write`, and its slot. A
    /// `word` reading an affine value goes to `write` alone, which takes
    /// `&self` and so cannot keep it.
    fn reserved(&mut self, count: i32, kept: bool) -> i32 with (GpuDevice, GpuQueue, GpuBuffer) {
        self.taping = null;
        // A write reaches the device ahead of the commands not yet submitted,
        // which may read a buffer a program's calls own.
        return if kept { self.allocated(count, true) } else { self.pass_buffer(count) };
    }

    /// Writes the words `word(i)` for `i` in `from..<to` to the buffer at
    /// `slot`, each at its index.
    fn write(&self, slot: i32, from: i32, to: i32, word: fn(i32) -> u32) with (GpuQueue, GpuBuffer) {
        // A host bounds what one call copies, and a model's embedding is past
        // what wasmtime lets through at once.
        let per_write = WRITE_BYTES / 4;
        for let mut at = from; at < to; at += per_write {
            let end = i32::min(at + per_write, to);
            let mut words = LinearArray::<u32>::filled(end - at, 0);
            for let i of at..<end {
                words[i - at] = word(i);
            }
            let bytes = words.cast::<u8>();
            if self.queue
                .write_buffer_with_copy(
                    self.buffer(slot),
                    (at * 4) as u64 as GpuSize64,
                    &bytes,
                    null,
                    null,
                )
                .is_err() {
                panic("loam: a host tensor did not write to the device");
            }
        }
    }

    /// The span `params` is at in the pass's parameter buffer. The words reach
    /// the device when the pass is submitted.
    fn parameter_span(&mut self, params: &List<u32>) -> Span with (GpuDevice, GpuQueue, GpuBuffer)
        contract params.len() <= PARAMETER_WORDS
    {
        let at = match &self.parameters {
            Some(p) => self.aligned(p.words.len()),
            null => PARAMETER_WORDS,
        };
        if at + params.len() > PARAMETER_WORDS {
            self.write_parameters();
            let slot = self.pass_buffer(PARAMETER_WORDS);
            self.parameters = Option::Some(Parameters { slot, words: [], written: 0 });
            return self.parameter_span(params);
        }
        let Some(p) = &mut self.parameters else {
            unreachable();
        };
        while p.words.len() < at {
            p.words.push(0);
        }
        p.words.extend(params);
        return Span { slot: p.slot, first: at, count: params.len() };
    }

    /// Writes the parameters not yet on the device: those launches changed,
    /// one write a carved buffer, and the pass's.
    fn write_parameters(&mut self) with (GpuQueue, GpuBuffer) {
        for let k of 0..<self.carved.len() {
            let c = &mut self.carved[k];
            if c.from >= c.to {
                continue;
            }
            if self.queue
                .write_buffer_with_copy(
                    self.buffer(c.slot),
                    (c.from * 4) as u64 as GpuSize64,
                    &c.bytes,
                    Option::Some((c.from * 4) as u64 as GpuSize64),
                    Option::Some(((c.to - c.from) * 4) as u64 as GpuSize64),
                )
                .is_err() {
                panic("loam: a launch's parameters did not write to the device");
            }
            c.from = PARAMETER_WORDS;
            c.to = 0;
        }
        let Some(p) = &mut self.parameters else {
            return;
        };
        let words = &p.words;
        self.write(p.slot, p.written, words.len(), |i| words[i]);
        p.written = words.len();
    }

    /// `t` written to a buffer of its own, as a view over its extents.
    fn placed<E: Element, Axes>(
        &mut self,
        t: &Tensor<E, Axes>,
        kept: bool,
    ) -> DeviceTensor with (GpuDevice, GpuQueue, GpuBuffer) {
        if E::kind() matches { _::U8 } {
            let bytes = self.reserved_bytes(t.extents, kept);
            self.write_bytes(&bytes, |i| t.data[i].cast_to::<i64>() as u32);
            return bytes;
        }
        let slot = self.written(t.data.len(), |i| t.data[i].cast_to::<f32>().to_bits(), kept);
        return contiguous(slot, 0, t.extents);
    }

    /// A new buffer for a tensor of bytes of `extents`, four to a word, for a
    /// `write_bytes`.
    internal fn reserved_bytes(
        &mut self,
        extents: List<i32>,
        kept: bool,
    ) -> DeviceTensor with (GpuDevice, GpuQueue, GpuBuffer) {
        let slot = self.reserved(element_count(&extents).div_ceil(4), kept);
        return DeviceTensor {
            ..contiguous(slot, 0, extents),
            packed: Option::Some(Packed::U8),
        };
    }

    /// Writes the bytes `byte(i)` of `t`, little-endian within each word.
    internal fn write_bytes(&self, t: &DeviceTensor, byte: fn(i32) -> u32) with (GpuQueue, GpuBuffer) {
        let count = element_count(&t.extents);
        self.write(t.slot, 0, count.div_ceil(4), |w| {
            let mut word: u32 = 0;
            for let i of 4 * w..<i32::min(4 * w + 4, count) {
                word |= byte(i) << (i % 4 * 8) as u32;
            }
            return word;
        });
    }

    /// A `[k, n]` matrix of `parts`, `at(parts, r, c)` its element at row `r`
    /// and column `c`, kept in the half `half_holding` finds. It is kept column by
    /// column, so a product of a few rows reads each column's run along the
    /// inner axis: one workgroup lane per run of it, rather than one per
    /// column, which leaves most of a device idle where the columns are few.
    /// Columns enough to fill `NARROW_GROUPS` workgroups a lane each are kept
    /// row by row, where a run of lanes reads one row's run of columns at
    /// once: Gemma 3 (270M)'s logits, 262144 columns, took a step over one
    /// token 0.98 times as long so. A matrix one binding does not hold is kept
    /// row by row too, where a row, and a run of rows, is a span of its own:
    /// column by column, every row reaches across the whole buffer, and no
    /// gather or chunk of the inner axis would bind.
    internal fn kept_matrix(
        &mut self,
        k: i32,
        n: i32,
        parts: &List<HostWeight>,
        at: fn(&List<HostWeight>, i32, i32) -> f32,
    ) -> DeviceTensor with (GpuDevice, GpuQueue, GpuBuffer) {
        let count = k * n;
        let packed = half_holding(count, |i| at(parts, i / n, i % n));
        let width = if packed matches { Some(_) } { 2 } else { 1 };
        let words = count.div_ceil(width);
        let by_columns = words <= self.max_binding && n < NARROW_GROUPS * narrow_columns(false, width, n);
        let element = |i: i32| if by_columns { at(parts, i % k, i / k) } else { at(parts, i / n, i % n) };
        let slot = self.reserved(words, true);
        match packed {
            Some(half) => {
                let bits = |i: i32| match half {
                    _::F16 => f16::from_f32(element(i)).to_bits() as u32,
                    _::BF16 => element(i).to_bits() >> 16,
                };
                self.write(slot, 0, words, |w| {
                    let high = if 2 * w + 1 < count { bits(2 * w + 1) << 16 } else { 0 };
                    return high | bits(2 * w);
                });
            },
            null => self.write(slot, 0, words, |i| element(i).to_bits()),
        }
        return DeviceTensor {
            slot,
            offset: 0,
            extents: [k, n],
            strides: if by_columns { [1, k] } else { [n, 1] },
            packed: Packed::halves(packed),
        };
    }

    /// A buffer kept for a pool of `kind` and `extents`, as `kept_plain` lays
    /// a weight: four bytes to a word, or a float to a word.
    internal fn pooled(
        &mut self,
        kind: ElementKind,
        extents: List<i32>,
    ) -> DeviceTensor with (GpuDevice, GpuQueue, GpuBuffer)
        contract kind matches { _::U8 | _::F32 | _::F16 | _::BF16 }
    {
        if kind matches { _::U8 } {
            return self.reserved_bytes(extents, true);
        }
        return contiguous(self.reserved(element_count(&extents), true), 0, extents);
    }

    /// Writes `row` over the slot `slot` of the pool `pool` laid as `pooled`
    /// lays one.
    internal fn written_slot(&self, pool: &DeviceTensor, slot: i32, row: &HostWeight) with (GpuQueue, GpuBuffer) {
        let width = row.count();
        assert width * pool.extents[0] == element_count(&pool.extents), "a row fills one slot of the pool";
        let start = slot * width;
        if row.kind matches { _::U8 } {
            assert width % 4 == 0, "a slot of bytes fills whole words";
            let bytes = row.bytes();
            self.write(
                pool.slot,
                start / 4,
                (start + width) / 4,
                |w| {
                    let at = 4 * w - start;
                    return bytes[at] as u32 | bytes[at + 1] as u32 << 8 | bytes[at + 2] as u32 << 16 | bytes[at + 3] as u32 << 24;
                },
            );
            return;
        }
        self.write(pool.slot, start, start + width, |i| row.value(i - start).to_bits());
    }

    /// `w`, whose every element an f32 holds, kept in a buffer of its own.
    internal fn kept_values(&mut self, w: &HostWeight) -> DeviceTensor with (GpuDevice, GpuQueue, GpuBuffer) {
        let slot = self.reserved(w.count(), true);
        self.write(slot, 0, w.count(), |i| w.value(i).to_bits());
        return contiguous(slot, 0, w.extents);
    }

    /// `t` on the device where an f32 holds its values or it is bytes, and on
    /// the host otherwise.
    fn stored<E: Element, Axes>(
        &mut self,
        t: &Tensor<E, Axes>,
        kept: bool,
    ) -> Placed<E, Axes> with (GpuDevice, GpuQueue, GpuBuffer) {
        if E::exact_in_f32() || E::kind() matches { _::U8 } {
            return Placed::Device(self.placed(t, kept));
        }
        return Placed::Host(*t);
    }

    /// `t`, which a caller found on the host.
    internal fn host_only<E, Axes>(&self, t: &Placed<E, Axes>) -> Tensor<E, Axes> {
        let Host(h) = t else {
            unreachable();
        };
        return *h;
    }

    /// `t` on the device: its view, or the host tensor written there for this
    /// pass.
    internal fn device_view<E: Element, Axes>(
        &mut self,
        t: &Placed<E, Axes>,
    ) -> DeviceTensor with (GpuDevice, GpuQueue, GpuBuffer) {
        return match t {
            Device(d) => *d,
            Host(h) => self.placed(h, false),
        };
    }

    internal fn host<E: Element, Axes>(
        &mut self,
        t: &Placed<E, Axes>,
    ) -> Tensor<E, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        return match t {
            Host(h) => *h,
            Device(d) => {
                // A loop rather than `map` and `collect`, which allocate per
                // element: under `wado run-webgpu`'s wasmtime that runs twenty
                // times slower than under `wado run`.
                let values = self.read_back(d);
                let mut data = List::<E>::with_capacity(values.len());
                for let v of values {
                    data.push(E::from_f32(v));
                }
                Tensor { data, extents: d.extents };
            },
        };
    }

    /// `t` as `Cpu` computes on it.
    internal fn on_cpu<E: Element, Axes>(
        &mut self,
        t: &Placed<E, Axes>,
    ) -> CpuTensor<E, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        return CpuTensor::Value(self.host(t));
    }

    /// `t`'s elements on the host, in row-major order. Every command recorded
    /// is submitted first, and this waits for the device to finish them.
    fn read_back(
        &mut self,
        t: &DeviceTensor,
    ) -> List<f32> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let count = element_count(&t.extents);
        if count == 0 {
            return [];
        }
        self.read_backs += 1;
        self.taping = null;
        let whole = self.materialized(t);
        self.flush();
        let size = byte_size(count);
        let readback = self.device.create_buffer(GpuBufferDescriptor {
            size,
            usage: GpuBufferUsage::MapRead | GpuBufferUsage::CopyDst,
            mapped_at_creation: null,
            label: null,
        });
        let encoder = self.device.create_command_encoder(Option::Some(GpuCommandEncoderDescriptor { label: null }));
        encoder.copy_buffer_to_buffer(
            self.buffer(whole.slot),
            Option::Some((whole.offset * 4) as u64 as GpuSize64),
            &readback,
            null,
            Option::Some(size),
        );
        let commands = encoder.finish(Option::Some(GpuCommandBufferDescriptor { label: null }));
        self.queue.submit([&commands]);
        self.queue.on_submitted_work_done().wait();
        if readback.map_async(GpuMapMode::Read, null, null).wait().is_err() {
            panic("loam: a device buffer did not map for reading");
        }
        let Ok(bytes) = readback.get_mapped_range_get_with_copy(null, null) else {
            panic("loam: a mapped device buffer gave no bytes");
        };
        return List::<f32>::from_le_bytes(bytes as ByteList)[0..<count].to_list();
    }

    /// Submits every command recorded.
    fn flush(
        &mut self,
    ) with (GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBindGroup, GpuBuffer, GpuComputePassEncoder) {
        self.write_parameters();
        if let Some(r) = self.recording.pop() {
            let Recording { encoder, pass } = r;
            pass.end();
            let commands = encoder.finish(Option::Some(GpuCommandBufferDescriptor { label: null }));
            self.queue.submit([&commands]);
        }
        self.unsubmitted = 0;
        self.submits += 1;
    }

    /// `t` with its f32 elements in row-major order from its offset: `t`
    /// itself, or a copy.
    fn materialized(
        &mut self,
        t: &DeviceTensor,
    ) -> DeviceTensor with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        if is_contiguous(t) && t.packed matches { null } {
            return *t;
        }
        let out = contiguous(self.allocated(element_count(&t.extents), false), 0, t.extents);
        self.copy(t, &out);
        return out;
    }

    /// `t` under `extents`: a view where its strides allow one, a copy
    /// otherwise.
    internal fn reshaped(
        &mut self,
        t: &DeviceTensor,
        extents: &List<i32>,
    ) -> DeviceTensor with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        assert element_count(extents) == element_count(&t.extents), "a reshape keeps every element";
        if let Some(view) = regrouped(t, extents) {
            return view;
        }
        if is_contiguous(t) {
            return row_major_view(t, *extents);
        }
        let whole = self.new_tensor(t.extents, holds_f16(t));
        self.copy(t, &whole);
        return row_major_view(&whole, *extents);
    }

    /// `shader` compiled, at the place in `pipelines` it is kept.
    fn compile(&mut self, shader: &Shader) -> i32 with (GpuDevice, GpuShaderModule, GpuComputePipeline) {
        let module = self.device.create_shader_module(GpuShaderModuleDescriptor {
            code: shader.source(),
            compilation_hints: null,
            label: null,
        });
        let pipeline = self.device.create_compute_pipeline(GpuComputePipelineDescriptor {
            compute: GpuProgrammableStage {
                module: &module,
                entry_point: Option::Some("main"),
                constants: null,
            },
            layout: GpuLayoutMode::Auto,
            label: null,
        });
        let at = self.pipelines.len();
        let layout = pipeline.get_bind_group_layout(0);
        self.pipelines.push(Pipeline { compiled: pipeline, layout, kernel: shader.key.kind() });
        self.compiled[*shader] = at;
        return at;
    }

    /// How a shader holds the elements of a binding `packed` packs.
    fn words(&self, packed: Option<Packed>) -> Words {
        return match packed {
            null => Words::F32,
            Some(_::BF16) => Words::PackedBF16,
            Some(_::F16) => if self.f16 { Words::F16 } else { Words::PackedF16 },
            Some(_::U8) => Words::Bytes,
        };
    }

    /// Records the shader `key` makes over `spans`, bound in order, then its
    /// parameters, in `groups` workgroups along each dimension.
    fn dispatch(
        &mut self,
        key: ShaderKey,
        spans: List<Span>,
        params: List<u32>,
        groups: [i32, i32, i32],
    ) with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let [x, y, z] = groups;
        if x == 0 || y == 0 || z == 0 {
            return;
        }
        let mut words: List<Words> = [];
        for let s of &spans {
            words.push(self.words(s.packed));
        }
        let shader = Shader { key, words };
        let found = match self.compiled.get(shader) {
            Some(at) => at,
            null => self.compile(&shader),
        };
        let mut all = spans;
        all.push(self.parameters_for(found, &params));
        let at = self.group_of(found, &all);
        if let Some(commands) = &mut self.taping {
            all.pop();
            commands.push(Command::Dispatched(Dispatch { pipeline: found, spans: all, params, groups, group: at }));
        }
        self.enqueued(found, at, groups);
    }

    /// Records `d` again with `params` in `groups` workgroups, over the
    /// buffers `slots` names in place of those it bound: on the bind group it
    /// bound, where that binds them.
    fn redispatched(
        &mut self,
        d: &Dispatch,
        slots: &Renamed,
        params: &List<u32>,
        groups: [i32, i32, i32],
    ) with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuComputePassEncoder) {
        let span = self.parameters_for(d.pipeline, params);
        let at = if self.binds_renamed(d, slots, &span) {
            d.group;
        } else {
            let mut all = renamed_spans(d, slots);
            all.push(span);
            self.group_of(d.pipeline, &all);
        };
        if let Some(commands) = &mut self.taping {
            commands.push(Command::Dispatched(Dispatch {
                pipeline: d.pipeline,
                spans: renamed_spans(d, slots),
                params: *params,
                groups,
                group: at,
            }));
        }
        self.enqueued(d.pipeline, at, groups);
    }

    /// Whether the bind group `d` bound binds its spans as `slots` renames
    /// them, then `params`: the key `group_key` spells for them.
    fn binds_renamed(&self, d: &Dispatch, slots: &Renamed, params: &Span) -> bool {
        let Some(cached) = &self.groups.held[d.group] else {
            return false;
        };
        let key = &cached.key;
        let n = d.spans.len();
        if key.len() != 1 + 3 * (n + 1) || key[0] != d.pipeline {
            return false;
        }
        for let i of 0..<n {
            let s = &d.spans[i];
            if !self.keyed_at(key, i, slots.of(s.slot), s.first, s.count) {
                return false;
            }
        }
        return self.keyed_at(key, n, params.slot, params.first, params.count);
    }

    /// Whether `key`, as `group_key` spells one, binds the words
    /// `first..<first + count` of the buffer at `slot` at its `i`th binding.
    fn keyed_at(&self, key: &List<i32>, i: i32, slot: i32, first: i32, count: i32) -> bool {
        let at = 1 + 3 * i;
        return key[at] == self.slot(slot).id && key[at + 1] == first && key[at + 2] == count;
    }

    /// Records a dispatch of the shader at `pipeline` in `pipelines` on the
    /// bind group at `at` in `groups`, in `groups` workgroups along each
    /// dimension.
    fn enqueued(
        &mut self,
        pipeline: i32,
        at: i32,
        groups: [i32, i32, i32],
    ) with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroup, GpuComputePassEncoder) {
        let [x, y, z] = groups;
        self.dispatches += 1;
        let cached = self.groups.get_mut(at);
        cached.used = self.passes;
        if self.recording.is_empty() {
            if let Some(p) = &self.profiler && p.timed.len() == PROFILED_DISPATCHES {
                self.read_profile();
            }
            let encoder = self.device.create_command_encoder(Option::Some(GpuCommandEncoderDescriptor { label: null }));
            let timestamp_writes = match &mut self.profiler {
                Some(p) => {
                    let first = 2 * p.timed.len();
                    p.timed.push(Timed { pipeline, groups });
                    Option::Some(GpuComputePassTimestampWrites {
                        query_set: &p.queries,
                        beginning_of_pass_write_index: Option::Some(first as u32 as GpuSize32),
                        end_of_pass_write_index: Option::Some((first + 1) as u32 as GpuSize32),
                    });
                },
                null => null,
            };
            let pass = encoder.begin_compute_pass(Option::Some(GpuComputePassDescriptor {
                timestamp_writes,
                label: null,
            }));
            self.recording.push(Recording { encoder, pass });
        }
        let pass = &self.recording[0].pass;
        pass.set_pipeline(&self.pipelines[pipeline].compiled);
        if pass.set_bind_group(0, Option::Some(&cached.group), null, null, null).is_err() {
            panic("loam: a kernel's buffers did not bind");
        }
        pass.dispatch_workgroups(
            x as u32 as GpuSize32,
            Option::Some(y as u32 as GpuSize32),
            Option::Some(z as u32 as GpuSize32),
        );
        self.unsubmitted += 1;
        if self.unsubmitted >= SUBMIT_EVERY || self.profiler matches { Some(_) } {
            self.flush();
        }
    }

    /// The place in `groups` of the bind group of `spans` to the shader at
    /// `pipeline`, made where none is.
    fn group_of(
        &mut self,
        pipeline: i32,
        spans: &List<Span>,
    ) -> i32 with (GpuDevice, GpuBuffer, GpuBindGroupLayout, GpuBindGroup) {
        let key = self.group_key(pipeline, spans);
        return match self.group_at.get(key) {
            Some(at) => at,
            null => self.bind_group(pipeline, spans, key),
        };
    }

    /// What a bind group is cached under: the shader's place in `pipelines`,
    /// then each span's buffer `id`, first word and words.
    fn group_key(&self, pipeline: i32, spans: &List<Span>) -> List<i32> {
        let mut key: List<i32> = [pipeline];
        for let s of spans {
            assert s.first % self.alignment == 0 && s.count <= self.max_binding;
            key.push(self.slot(s.slot).id);
            key.push(s.first);
            key.push(s.count);
        }
        return key;
    }

    /// A new bind group of `spans` to the shader at `pipeline`, cached under
    /// `key`, and its place in `groups`.
    fn bind_group(
        &mut self,
        pipeline: i32,
        spans: &List<Span>,
        key: List<i32>,
    ) -> i32 with (GpuDevice, GpuBuffer, GpuBindGroupLayout, GpuBindGroup) {
        self.bind_groups += 1;
        let mut entries: List<GpuBindGroupEntry> = [];
        for let i of 0..<spans.len() {
            let s = spans[i];
            entries.push(GpuBindGroupEntry {
                binding: i as u32 as GpuIndex32,
                resource: GpuBindingResource::GpuBufferBinding(GpuBufferBinding {
                    buffer: self.buffer(s.slot),
                    offset: Option::Some((s.first * 4) as u64 as GpuSize64),
                    size: Option::Some(byte_size(s.count)),
                }),
            });
        }
        let group = self.device.create_bind_group(GpuBindGroupDescriptor {
            layout: &self.pipelines[pipeline].layout,
            entries,
            label: null,
        });
        let at = self.groups.put(CachedGroup { group, key, used: self.passes });
        self.group_at[key] = at;
        return at;
    }

    /// A new tensor of `extents` for a kernel to write: f16s where `in_f16`
    /// and the device computes in f16, f32s otherwise.
    internal fn new_tensor(&mut self, extents: List<i32>, in_f16: bool) -> DeviceTensor with (GpuDevice, GpuBuffer) {
        let count = element_count(&extents);
        if in_f16 && self.f16 {
            let words = self.allocated(count.div_ceil(2), false);
            return DeviceTensor {
                ..contiguous(words, 0, extents),
                packed: Option::Some(Packed::F16),
            };
        }
        return contiguous(self.allocated(count, false), 0, extents);
    }

    /// `op` over `operands` into a new tensor of `extents`, or `None` where the
    /// operands outgrow what one dispatch binds. Each operand's extents align
    /// with `extents` from the end, an axis of 1 stretching.
    fn elementwise(
        &mut self,
        operands: &List<DeviceTensor>,
        extents: List<i32>,
        op: &Expr,
    ) -> Option<DeviceTensor> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder)
        contract !op.folds_rows()
    {
        let count = element_count(&extents);
        if count > self.max_binding {
            return null;
        }
        let Some(bound) = self.bindable(operands) else {
            return null;
        };
        let out = self.new_tensor(extents, rounds_to_f16(op));
        let [x, y] = grid(count);
        let mut params = element_params(count, x, &extents);
        for let o of bound.views {
            push_view(&mut params, o.offset, &stretched(&o, &extents));
        }
        let key = ShaderKey::Elementwise([*op, bound.bindings, extents.len()]);
        let mut spans = bound.spans;
        spans.push(fresh(&out));
        self.dispatch(key, spans, params, [x, y, 1]);
        return Option::Some(out);
    }

    /// `op` over `operands` row by row into a new tensor, a row being the last
    /// `row_axes` axes of `extents`, or `None` where they outgrow a dispatch.
    fn row_kernel(
        &mut self,
        operands: &List<DeviceTensor>,
        extents: List<i32>,
        op: &Expr,
        row_axes: i32,
        reduced: bool,
    ) -> Option<DeviceTensor> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let rank = extents.len();
        let row = element_count(&extents[rank - row_axes..<rank].to_list());
        let rows = element_count(&extents[0..<rank - row_axes].to_list());
        // No elements leaves nothing to dispatch: `Cpu` writes what a row of
        // none reduces to, reading only the values per row.
        if rows * row == 0 || rows * row > self.max_binding {
            return null;
        }
        let Some(bound) = self.bindable(operands) else {
            return null;
        };
        let out_extents = row_extents(&extents, row_axes, reduced);
        let out = self.new_tensor(out_extents, rounds_to_f16(op));
        let [x, y] = spread(rows);
        let mut params: List<u32> = [rows as u32, x as u32, row as u32];
        push_all(&mut params, &extents);
        for let o of bound.views {
            push_view(&mut params, o.offset, &stretched(&o, &extents));
        }
        let key = ShaderKey::Rows([*op, bound.bindings, rank, row_axes, reduced]);
        let mut spans = bound.spans;
        spans.push(fresh(&out));
        self.dispatch(key, spans, params, [x, y, 1]);
        return Option::Some(out);
    }

    /// The spans `operands` read and the binding each reads, or all in one
    /// pack where they are more spans than a shader binds. `None` where even
    /// the pack outgrows a binding.
    fn bindable(
        &mut self,
        operands: &List<DeviceTensor>,
    ) -> Option<Bindings> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        if let Some(bound) = self.spans_for(operands) && bound.spans.len() <= self.max_operands {
            return Option::Some(bound);
        }
        let total = packed_count(operands);
        if total > self.max_binding {
            return null;
        }
        // Each operand is copied to its own place in one buffer, in order.
        let pack = self.allocated(total, false);
        let mut views: List<DeviceTensor> = [];
        let mut at = 0;
        for let o of *operands {
            let placed = contiguous(pack, at, o.extents);
            self.copy(&o, &placed);
            views.push(placed);
            at += element_count(&o.extents);
        }
        return Option::Some(Bindings {
            spans: [fresh(&contiguous(pack, 0, [total]))],
            bindings: List::<i32>::filled(operands.len(), 0),
            views,
        });
    }

    /// Whether `bindable` binds `operands`, asked before a kernel that runs in
    /// several dispatches records the first.
    fn binds(&self, operands: &List<DeviceTensor>) -> bool {
        return self.spanned(operands) matches { Some([spans, _]) && spans.len() <= self.max_operands }
            || packed_count(operands) <= self.max_binding;
    }

    /// One span for each run of `operands` in one buffer that one binding
    /// holds, so a buffer two distant views read is bound twice, and each view
    /// rebased to its span. `None` where one view alone outgrows a binding.
    fn spans_for(&self, operands: &List<DeviceTensor>) -> Option<Bindings> {
        let [spans, bindings] = self.spanned(operands)?;
        let mut views: List<DeviceTensor> = [];
        for let i of 0..<operands.len() {
            let o = &operands[i];
            views.push(DeviceTensor { ..*o, offset: rebased(o, &spans[bindings[i]]) });
        }
        return Option::Some(Bindings { spans, bindings, views });
    }

    /// The spans of `spans_for`, and the one each operand reads.
    fn spanned(&self, operands: &List<DeviceTensor>) -> Option<[List<Span>, List<i32>]> {
        let mut spans: List<Span> = [];
        // The words each span's views read, and the first of them, whose
        // element type the others share.
        let mut words: List<[i32, i32]> = [];
        let mut firsts: List<i32> = [];
        let mut bindings: List<i32> = [];
        for let i of 0..<operands.len() {
            let o = &operands[i];
            let [lo, hi] = words_read(o);
            let mut at = -1;
            for let b of 0..<spans.len() {
                if spans[b].slot != o.slot {
                    continue;
                }
                assert o.packed == operands[firsts[b]].packed, "one buffer holds one element type";
                let [least, most] = [
                    i32::min(words[b].0, lo),
                    i32::max(words[b].1, hi),
                ];
                if let Some(wider) = self.span_over(o, least, most) {
                    spans[b] = wider;
                    words[b] = [least, most];
                    at = b;
                    break;
                }
            }
            if at < 0 {
                spans.push(self.span_over(o, lo, hi)?);
                words.push([lo, hi]);
                firsts.push(i);
                at = spans.len() - 1;
            }
            bindings.push(at);
        }
        return Option::Some([spans, bindings]);
    }

    /// The span one binding of `view`'s buffer takes to reach every element it
    /// reads, or `None` where it outgrows a binding.
    fn span_of(&self, view: &DeviceTensor) -> Option<Span> {
        let [least, most] = words_read(view);
        return self.span_over(view, least, most);
    }

    /// The span reaching the words `least..=most` of `view`'s buffer, its
    /// start aligned as a binding's must be, or `None` where it outgrows a
    /// binding.
    fn span_over(&self, view: &DeviceTensor, least: i32, most: i32) -> Option<Span> {
        let first = least - least % self.alignment;
        let count = most - first + 1;
        if count > self.max_binding {
            return null;
        }
        return Option::Some(Span { slot: view.slot, first, count, packed: view.packed });
    }

    /// `a` and `b` joined along `axis`: one of them where the other is empty
    /// along it, a copy of both otherwise.
    internal fn joined(
        &mut self,
        a: &DeviceTensor,
        b: &DeviceTensor,
        axis: i32,
    ) -> DeviceTensor with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        if a.extents[axis] == 0 {
            return *b;
        }
        if b.extents[axis] == 0 {
            return *a;
        }
        let mut extents = a.extents;
        extents[axis] += b.extents[axis];
        let out = self.new_tensor(extents, holds_f16(a) && holds_f16(b));
        self.copy(a, &DeviceTensor { ..out, extents: a.extents });
        let at = out.offset + a.extents[axis] * out.strides[axis];
        self.copy(b, &DeviceTensor { ..out, offset: at, extents: b.extents });
        return out;
    }

    /// Copies `from`'s elements to `to`'s place, the two of one extents, each
    /// as `to` holds it: in one dispatch, or in halves along an axis where one
    /// outgrows a binding.
    internal fn copy(
        &mut self,
        from: &DeviceTensor,
        to: &DeviceTensor,
    ) with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder)
        contract from.extents == to.extents, to.packed matches { null } || holds_f16(to) && self.f16
    {
        let count = element_count(&to.extents);
        if count == 0 {
            return;
        }
        if let Some(source) = self.span_of(from) && let Some(target) = self.span_of(to) {
            let [x, y] = grid(count);
            let mut params = element_params(count, x, &to.extents);
            push_view(&mut params, rebased(from, &source), &from.strides);
            push_view(&mut params, rebased(to, &target), &to.strides);
            self.dispatch(ShaderKey::Copy(to.extents.len()), [source, target], params, [x, y, 1]);
            return;
        }
        let axis = split_axis(&to.extents);
        let half = to.extents[axis] / 2;
        let rest = to.extents[axis] - half;
        self.copy(&sliced(from, axis, 0, half), &sliced(to, axis, 0, half));
        self.copy(&sliced(from, axis, half, rest), &sliced(to, axis, half, rest));
    }

    /// `op` over `operands`, on the device where they fit a dispatch and on
    /// the CPU otherwise.
    internal fn fused_on<Axes>(
        &mut self,
        operands: &List<DeviceTensor>,
        op: &Expr,
    ) -> Placed<f32, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder)
        contract !op.folds_rows()
    {
        return self.grouped(operands, broadcast_all(operands), op, false);
    }

    /// `op` over `operands` at each element of `extents`, or row by row of its
    /// last axis where it folds one, writing one value a row where `reduced`:
    /// on the device where they fit a dispatch and on the CPU otherwise.
    internal fn grouped<Axes>(
        &mut self,
        operands: &List<DeviceTensor>,
        extents: List<i32>,
        op: &Expr,
        reduced: bool,
    ) -> Placed<f32, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        if op.folds_rows() {
            return self.rows_over::<Axes, Axes>(operands, extents, op, 1, reduced);
        }
        if let Some(out) = self.elementwise(operands, extents, op) {
            return Placed::Device(out);
        }
        let held = self.held(operands);
        return Placed::Host(fused(&self.cpu_reads::<Axes>(&held, operands), op, extents));
    }

    /// `op` over `operands` row by row of `extents`, a row being its last
    /// `row_axes` axes, writing one value a row where `reduced`: on the device
    /// where they fit a dispatch and on the CPU otherwise.
    fn rows_over<In, Out>(
        &mut self,
        operands: &List<DeviceTensor>,
        extents: List<i32>,
        op: &Expr,
        row_axes: i32,
        reduced: bool,
    ) -> Placed<f32, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        if let Some(out) = self.row_kernel(operands, extents, op, row_axes, reduced) {
            return Placed::Device(out);
        }
        let held = self.held(operands);
        return Placed::Host(fused_rows::<In, Out>(
            &self.cpu_reads::<In>(&held, operands),
            op,
            row_axes,
            reduced,
            extents,
        ));
    }

    /// Each operand's elements on the host, for a kernel the device cannot run.
    fn held(
        &mut self,
        operands: &List<DeviceTensor>,
    ) -> List<List<f32>> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let mut held: List<List<f32>> = [];
        for let o of *operands {
            held.push(self.read_back(&o));
        }
        return held;
    }

    fn cpu_reads<Axes>(&mut self, held: &List<List<f32>>, operands: &List<DeviceTensor>) -> List<Read<Axes>> {
        let mut reads: List<Read<Axes>> = [];
        for let [i, o] of operands.into_iter().enumerate() {
            reads.push(Read { data: &held[i], extents: o.extents });
        }
        return reads;
    }

    /// `then` applied to `computed`, which the epilogue reads as `operand(0)`.
    fn finished<Axes>(
        &mut self,
        computed: DeviceTensor,
        then: &Option<Epilogue<PlacedRead<Axes>>>,
    ) -> Placed<f32, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let Some(e) = then else {
            return Placed::Device(computed);
        };
        let mut operands = [computed] as List<DeviceTensor>;
        for let o of e.operands {
            operands.push(o.view);
        }
        return self.fused_on(&operands, &e.op);
    }

    /// The product of `a` and `b` as ONNX's `MatMul` defines it, numpy's: a
    /// rank-1 operand is a row on the left or a column on the right, whose axis
    /// the result drops, and the batch axes broadcast. `then` runs in the same
    /// dispatch where its operands fit beside the two matrices.
    internal fn product<A, B, Out>(
        &mut self,
        a: &Placed<f32, A>,
        b: &Placed<f32, B>,
        then: &Option<Epilogue<PlacedRead<Out>>>,
    ) -> Placed<f32, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        return self.product_kernel(a, b, then, false).unwrap();
    }

    /// [`Self::product`], or where `paired`, the products by the two matrices `b`
    /// interleaves as `Paired` says, joined by `then`: it reads the product by
    /// the first as `operand(0)`, by the second as `operand(1)`, and its own
    /// operands from `operand(2)`, as a gated layer's two products of one input
    /// meet. A paired product runs as
    /// one narrow dispatch reading `b` along its inner axis, or not at all:
    /// `None` where it cannot.
    internal fn product_kernel<A, B, Out>(
        &mut self,
        a: &Placed<f32, A>,
        b: &Placed<f32, B>,
        then: &Option<Epilogue<PlacedRead<Out>>>,
        paired: bool,
    ) -> Option<Placed<f32, Out>> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let av = self.device_view(a);
        let bv = self.device_view(b);
        let lhs = if av.extents.len() == 1 { as_row(&av) } else { av };
        let rhs = if bv.extents.len() == 1 { as_column(&bv) } else { bv };
        let ra = lhs.extents.len();
        let rb = rhs.extents.len();
        let [rows, inner, cols] = [lhs.extents[ra - 2], lhs.extents[ra - 1], rhs.extents[rb - 1]];
        assert inner == rhs.extents[rb - 2];
        let batch = broadcast_extents(&lhs.extents[0..<ra - 2].to_list(), &rhs.extents[0..<rb - 2].to_list()).unwrap();
        assert !paired || ra == av.extents.len() && rb == 2 && cols % 2 == 0, "a paired product is of matrices";
        // The columns written: one of each pair where paired.
        let written = if paired { cols / 2 } else { cols };
        // The result's extents drop the axis a rank-1 operand stands in for.
        let mut extents = batch;
        if av.extents.len() > 1 {
            extents.push(rows);
        }
        if bv.extents.len() > 1 {
            extents.push(written);
        }
        let count = element_count(&batch);
        let narrow = rows <= NARROW_ROWS;
        let across = rhs.strides[rb - 2] == 1 && rhs.strides[rb - 1] != 1;
        // The fewest columns a workgroup takes, which a wider read only raises.
        let per_group = if narrow { narrow_columns(across, 1, cols) } else { TILE };
        let fits = count <= MAX_GROUPS
            && rows.div_ceil(TILE) <= MAX_GROUPS
            && cols.div_ceil(per_group) <= MAX_GROUPS
            && count * rows * written <= self.max_binding;
        let epilogue: List<DeviceTensor> = match then {
            Some(e) => e.operands.into_iter().map(|o| o.view).collect(),
            null => [],
        };
        let chunk = if fits { self.inner_chunk(&lhs, &rhs) } else { null };
        if paired && !(narrow && across && chunk == Option::Some(inner)) {
            return null;
        }
        let Some(chunk) = chunk else {
            return Option::Some(self.product_on_cpu(a, b, then));
        };
        let mut matrices = batch;
        matrices.push(rows);
        matrices.push(written);
        let br = batch.len();
        // What the chunk from `start` reads: the two slices, `then`'s operands
        // where it is the last, and the sums the chunk before left.
        let chunk_operands = |start: i32, partial: Option<DeviceTensor>| -> List<DeviceTensor> {
            let length = i32::min(chunk, inner - start);
            let mut operands = [
                sliced(&lhs, ra - 1, start, length),
                sliced(&rhs, rb - 2, start, length),
            ] as List<DeviceTensor>;
            if start + length >= inner {
                operands.extend(&epilogue);
            }
            if let Some(p) = partial {
                operands.push(p);
            }
            return operands;
        };
        // Every chunk binds before the first is recorded, so none is wasted.
        // The middle chunks bind as the first does, plus the partial sums.
        let last_start = (inner.div_ceil(i32::max(chunk, 1)) - 1) * chunk;
        let pending = if last_start > 0 { Option::Some(contiguous(PENDING, 0, matrices)) } else { null };
        if !self.binds(&chunk_operands(0, pending)) || !self.binds(&chunk_operands(last_start, pending)) {
            return if paired { null } else { Option::Some(self.product_on_cpu(a, b, then)) };
        }
        // Each chunk of the inner axis continues the sums the one before left,
        // tile by tile as one dispatch would add them, and the last applies
        // `then`.
        let mut partial: Option<DeviceTensor> = null;
        let mut start = 0;
        loop {
            let length = i32::min(chunk, inner - start);
            let last = start + length >= inner;
            let Some(bound) = self.bindable(&chunk_operands(start, partial)) else {
                unreachable();
            };
            let op = match then {
                Some(e) && last => e.op,
                _ => operand(0),
            };
            let out = self.new_tensor(matrices, rounds_to_f16(&op));
            let continued = partial matches { Some(_) };
            let read = bound.views.len() - if continued { 1 } else { 0 };
            let mut params = product_params(
                [rows, length, cols],
                &batch,
                &bound.views[0..<read].to_list(),
                &extents,
                &av.extents,
                &bv.extents,
            );
            if continued {
                params.push(bound.views[read].offset as u32);
            }
            let [key, row_groups, group_columns] = if narrow {
                let width = word_width(&bound.views[1], across);
                [
                    ShaderKey::NarrowProduct(
                        [op, bound.bindings, br, continued, across, width, per_group, paired, null],
                    ),
                    1,
                    narrow_columns(across, width, cols),
                ];
            } else {
                [
                    ShaderKey::Product([op, bound.bindings, br, continued, across]),
                    rows.div_ceil(TILE),
                    TILE,
                ];
            };
            let mut spans = bound.spans;
            spans.push(fresh(&out));
            self.dispatch(key, spans, params, [cols.div_ceil(group_columns), row_groups, count]);
            if last {
                return Option::Some(Placed::Device(row_major_view(&out, extents)));
            }
            partial = Option::Some(out);
            start += length;
        }
    }

    /// [`Self::product_kernel`] of the left matrix `a` computes, by the matrix
    /// `b` as stored, as one narrow dispatch whose workgroups each compute
    /// `a` block by block into workgroup memory. `None` where it cannot run
    /// so: too many rows, an inner axis a binding or that memory cannot hold
    /// whole, or a paired product not across `b`.
    internal fn staged_product<A, B, Out>(
        &mut self,
        a: &Prologue<PlacedRead<A>>,
        b: &Placed<f32, B>,
        then: &Option<Epilogue<PlacedRead<Out>>>,
        paired: bool,
    ) -> Option<Placed<f32, Out>> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let prologue: List<DeviceTensor> = a.operands.into_iter().map(|o| o.view).collect();
        let space = broadcast_all(&prologue);
        let bv = self.device_view(b);
        let ra = space.len();
        assert ra >= 2 && bv.extents.len() == 2, "a prologue computes a matrix product's left matrices";
        let [rows, inner, cols] = [space[ra - 2], space[ra - 1], bv.extents[1]];
        assert inner == bv.extents[0];
        let batch = space[0..<ra - 2].to_list();
        let count = element_count(&batch);
        let across = bv.strides[0] == 1 && bv.strides[1] != 1;
        let per_group = narrow_columns(across, 1, cols);
        let written = if paired { cols / 2 } else { cols };
        let staged = Staged {
            op: a.op,
            operands: prologue.len(),
            rows: i32::min(rows, NARROW),
            inner,
        };
        // A lane of a product not across `b` sums two columns of a packed one.
        let partial_bytes = 4 * NARROW * if across { 1 } else { 2 } * NARROW_LANES;
        if rows > NARROW_ROWS
            || paired && !across
            || count > MAX_GROUPS
            || cols.div_ceil(per_group) > MAX_GROUPS
            || count * rows * written > self.max_binding
            || staged_bytes(&staged) + partial_bytes > WORKGROUP_BYTES {
            return null;
        }
        // The left matrix's binding stands in for the matrix the shader never
        // reads, so its views keep their places.
        let lhs = DeviceTensor { ..prologue[0], extents: space, strides: stretched(&prologue[0], &space) };
        if self.inner_chunk(&lhs, &bv) != Option::Some(inner) {
            return null;
        }
        let mut operands = [lhs, bv] as List<DeviceTensor>;
        if let Some(e) = then {
            for let o of e.operands {
                operands.push(o.view);
            }
        }
        let read = operands.len();
        operands.extend(&prologue);
        if !self.binds(&operands) {
            return null;
        }
        let Some(bound) = self.bindable(&operands) else {
            unreachable();
        };
        let mut extents = batch;
        extents.push(rows);
        extents.push(written);
        let mut params = product_params(
            [rows, inner, cols],
            &batch,
            &bound.views[0..<read].to_list(),
            &extents,
            &space,
            &bv.extents,
        );
        for let i of read..<bound.views.len() {
            let o = &bound.views[i];
            push_view(&mut params, o.offset, &stretched(o, &space));
        }
        let op = match then {
            Some(e) => e.op,
            null => operand(0),
        };
        let width = word_width(&bound.views[1], across);
        let key = ShaderKey::NarrowProduct(
            [
                op,
                bound.bindings,
                batch.len(),
                false,
                across,
                width,
                per_group,
                paired,
                Option::Some(staged),
            ],
        );
        let out = self.new_tensor(extents, rounds_to_f16(&op));
        let mut spans = bound.spans;
        spans.push(fresh(&out));
        self.dispatch(key, spans, params, [cols.div_ceil(narrow_columns(across, width, cols)), 1, count]);
        return Option::Some(Placed::Device(out));
    }

    /// The longest run of whole tiles along the inner axis whose slices of
    /// `lhs` and `rhs` each fit a binding: all of it where they fit whole.
    /// `None` where not even one tile's do.
    fn inner_chunk(&self, lhs: &DeviceTensor, rhs: &DeviceTensor) -> Option<i32> {
        let ra = lhs.extents.len();
        let rb = rhs.extents.len();
        let mut chunk = lhs.extents[ra - 1];
        loop {
            if self.span_of(&sliced(lhs, ra - 1, 0, chunk)) matches { Some(_) }
                && self.span_of(&sliced(rhs, rb - 2, 0, chunk)) matches { Some(_) } {
                return Option::Some(chunk);
            }
            if chunk <= TILE {
                return null;
            }
            chunk = chunk.div_ceil(2).div_ceil(TILE) * TILE;
        }
    }

    fn product_on_cpu<A, B, Out>(
        &mut self,
        a: &Placed<f32, A>,
        b: &Placed<f32, B>,
        then: &Option<Epilogue<PlacedRead<Out>>>,
    ) -> Placed<f32, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let product = matmul_broadcast::<A, B, Out>(&self.host(a), &self.host(b), &null);
        let computed = self.placed(&product, false);
        return self.finished(computed, then);
    }

    /// A gather of `data` along `axis` by `indices`, a negative one counting
    /// from the end: the result's axes are `data`'s before `axis`, the
    /// indices', then `data`'s after `axis`.
    internal fn gathered<Ix>(
        &mut self,
        data: &DeviceTensor,
        indices: &Tensor<i64, Ix>,
        axis: i32,
    ) -> Option<DeviceTensor> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let along = data.extents[axis];
        let mut words = List::<u32>::with_capacity(indices.data.len());
        for let i of indices.data {
            let at = if i < 0 { i + along as i64 } else { i };
            assert 0 <= at < along as i64, "loam: a gather index is past its axis";
            words.push(at as u32);
        }
        let mut extents = data.extents[0..<axis].to_list();
        extents.extend(&indices.extents);
        extents.extend(&data.extents[axis + 1..<data.extents.len()].to_list());
        if consecutive(&words) {
            // A view of the rows, the index axes split out of `axis`.
            let mut strides = data.strides[0..<axis].to_list();
            for let s of row_major(&indices.extents) {
                strides.push(s * data.strides[axis]);
            }
            strides.extend(&data.strides[axis + 1..<data.strides.len()].to_list());
            return Option::Some(DeviceTensor {
                ..*data,
                offset: data.offset + words[0] as i32 * data.strides[axis],
                extents,
                strides,
            });
        }
        // The output, its index axes as one, row by row of `words`.
        let mut flat = data.extents;
        flat[axis] = words.len();
        // Halving the indices ends at one row, so the gather runs on the
        // device exactly where one row of the data and of the output binds.
        let row_binds = |view: DeviceTensor| self.span_of(&sliced(&view, axis, 0, 1)) matches { Some(_) };
        if words.len() > self.max_binding || !row_binds(*data) || !row_binds(contiguous(PENDING, 0, flat)) {
            return null;
        }
        let index_slot = self.written(words.len(), |i| words[i], false);
        let out = self.new_tensor(flat, holds_f16(data));
        self.gathered_part(data, &words, index_slot, axis, &out, 0, words.len());
        return Option::Some(row_major_view(&out, extents));
    }

    /// [`Self::gathered`] by `indices` on the device, each an f32 clamped into
    /// the axis, its result of `extents`, or `None` where the data or the output
    /// outgrows a binding.
    internal fn gathered_by(
        &mut self,
        data: &DeviceTensor,
        indices: &DeviceTensor,
        axis: i32,
        extents: &List<i32>,
    ) -> Option<DeviceTensor> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let mut flat = data.extents;
        flat[axis] = element_count(&indices.extents);
        let source = self.span_of(data)?;
        self.span_of(&contiguous(PENDING, 0, flat))?;
        let whole = self.materialized(indices);
        let by = self.span_of(&whole)?;
        let total = element_count(&flat);
        let out = self.new_tensor(flat, holds_f16(data));
        let target = self.span_of(&out)?;
        let [x, y] = grid(total);
        let mut params = element_params(total, x, &flat);
        let mut across = data.strides;
        across[axis] = 0;
        push_view(&mut params, rebased(data, &source), &across);
        push_signed(&mut params, data.strides[axis]);
        params.push(rebased(&whole, &by) as u32);
        push_view(&mut params, 0, &out.strides);
        params.push((data.extents[axis] - 1) as u32);
        self.dispatch(ShaderKey::Gather([flat.len(), axis, true]), [source, by, target], params, [x, y, 1]);
        return Option::Some(row_major_view(&out, *extents));
    }

    /// Writes `out`'s rows `lo..<hi` along `axis`, the data's rows `words`
    /// picks there: in one dispatch, or in halves where the data's rows they
    /// pick outgrow a binding.
    fn gathered_part(
        &mut self,
        data: &DeviceTensor,
        words: &List<u32>,
        index_slot: i32,
        axis: i32,
        out: &DeviceTensor,
        lo: i32,
        hi: i32,
    ) with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let part = sliced(out, axis, lo, hi - lo);
        let count = element_count(&part.extents);
        if count == 0 {
            return;
        }
        let mut least = words[lo] as i32;
        let mut most = least;
        for let i of lo..<hi {
            least = i32::min(least, words[i] as i32);
            most = i32::max(most, words[i] as i32);
        }
        let picked = sliced(data, axis, least, most - least + 1);
        if let Some(source) = self.span_of(&picked) && let Some(target) = self.span_of(&part) {
            let [x, y] = grid(count);
            let mut params = element_params(count, x, &part.extents);
            let mut across = data.strides;
            across[axis] = 0;
            push_view(&mut params, rebased(data, &source), &across);
            push_signed(&mut params, data.strides[axis]);
            params.push(lo as u32);
            push_view(&mut params, rebased(&part, &target), &part.strides);
            let indices = Span { slot: index_slot, first: 0, count: words.len() };
            self.dispatch(
                ShaderKey::Gather([part.extents.len(), axis, false]),
                [source, indices, target],
                params,
                [x, y, 1],
            );
            return;
        }
        // `gathered` checked that one row binds.
        assert hi - lo > 1;
        let mid = lo + (hi - lo) / 2;
        self.gathered_part(data, words, index_slot, axis, out, lo, mid);
        self.gathered_part(data, words, index_slot, axis, out, mid, hi);
    }

    /// `t` folded along `axes` by the row kernel, those axes kept at extent 1.
    internal fn reduced(
        &mut self,
        t: &DeviceTensor,
        axes: &List<i32>,
        op: &Expr,
    ) -> Option<DeviceTensor> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let perm = moved_last(t.extents.len(), axes);
        let moved = permuted(t, &perm);
        let out = self.row_kernel(&([moved] as List<DeviceTensor>), moved.extents, op, axes.len(), true)?;
        return Option::Some(permuted(&out, &inverse(&perm)));
    }

    /// `group_query_attention` in three dispatches: one appends the new keys,
    /// turned, and values to the attention cache, one attends each
    /// query row over each part of its positions in a workgroup of its own,
    /// and one joins each row's parts. `rotary` is the cosine and sine
    /// tables. Of a `stored` half, the turned keys and queries and the result
    /// round to it, held as the f32 equal to each, and the scores stay f32.
    /// Each batch row's past is the first of its `pasts` positions
    /// `past_k` and `past_v` hold, and the cache holds every position they do:
    /// their buffer where they are `shared`, onnxruntime's shared buffer. A
    /// query of a row reads no position at or past the row's of `reaches`.
    /// The join adds each query head's sink, of `sinks`, to its rows'
    /// denominators.
    /// `None` where the operands outgrow what a dispatch binds.
    internal fn attended(
        &mut self,
        q: &DeviceTensor,
        k: &DeviceTensor,
        v: &DeviceTensor,
        past_k: &DeviceTensor,
        past_v: &DeviceTensor,
        pasts: &List<i32>,
        reaches: &List<i32>,
        shared: bool,
        rotary: &Option<[DeviceTensor, DeviceTensor]>,
        bias: &Option<DeviceTensor>,
        sinks: &Option<DeviceTensor>,
        options: &Attention,
        stored: Option<HalfFloat>,
    ) -> Option<[DeviceTensor, DeviceTensor, DeviceTensor]> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder)
        contract pasts.len() == q.extents[0] && reaches.len() == q.extents[0]
        contract q.extents[0] > 0, "a batch holds a row"
        contract (0..<pasts.len()).all(|b| 0 <= pasts[b] <= past_k.extents[2] && reaches[b] <= pasts[b] + q.extents[1])
    {
        let [batch, s, d] = [q.extents[0], q.extents[1], past_k.extents[3]];
        let [heads, kv] = [options.heads, options.kv_heads];
        let past = max_of(pasts);
        let furthest = max_of(reaches);
        let total = past + s;
        let rows = batch * s * heads;
        let capacity = self.cache_capacity(batch * kv * d, i32::max(total, past_k.extents[2]));
        let n = batch * kv * capacity * d;
        // The parts are held for every position the cache holds, as its
        // views are, so their bindings too stay those of the step before.
        // Rows enough to outgrow a binding spread over the device in any
        // parts, so the parts grow until they fit one.
        let held_for = |part: i32| rows as i64 * capacity.div_ceil(part) as i64 * (d + 2) as i64;
        let mut part = ATTEND_PART;
        while part < LANES && held_for(part) > self.max_binding as i64 {
            part *= 2;
        }
        let attended = held_for(part);
        if 2 * n > self.max_binding || attended > self.max_binding as i64 || d > MAX_HEAD {
            return null;
        }
        let attended = attended as i32;
        let groups = rows * furthest.div_ceil(part);
        let half = match rotary {
            Some([c, _]) => c.extents[1],
            null => 0,
        };
        let held = [batch, kv, capacity, d] as List<i32>;
        let strides = row_major(&held);
        if let Some(b) = bias {
            assert b.extents[3] >= furthest, "a bias holds every position attended";
        }
        // What the positions set: each dispatch's leading parameters, and the
        // attention's workgroups.
        let appended = batch * kv * s * d;
        let [x, y] = grid(2 * appended);
        let [gx, gy] = spread(groups);
        let [rx, ry] = spread(rows);
        let mut append_head = element_params(2 * appended, x, &([batch, kv, s, d] as List<i32>));
        append_head.push(half as u32);
        push_view(&mut append_head, 0, &strides);
        append_head.push(n as u32);
        push_all(&mut append_head, pasts);
        let mut attend_head: List<u32> = [];
        push_all(&mut attend_head, &([groups, gx, batch, s, heads, d, furthest, heads / kv, half] as List<i32>));
        attend_head.push(options.scale.to_bits());
        attend_head.push(options.softcap.to_bits());
        push_signed(&mut attend_head, options.window);
        attend_head.push(attention_flags(options));
        attend_head.push(options.hidden.unwrap_or(0.0).to_bits());
        for let b of 0..<batch {
            push_all(&mut attend_head, &([pasts[b], reaches[b]] as List<i32>));
        }
        let join_head: List<u32> = [rows as u32, rx as u32, furthest.div_ceil(part) as u32, d as u32, heads as u32];
        let heads_of: List<List<u32>> = [append_head, attend_head, join_head];
        let grids: List<[i32, i32, i32]> = [
            [x, y, 1],
            [gx, gy, 1],
            [rx, ry, 1],
        ];
        let mut reads: List<&DeviceTensor> = [q, k, v, past_k, past_v];
        if let Some([c, sn]) = rotary {
            reads.push(c);
            reads.push(sn);
        }
        if let Some(b) = bias {
            reads.push(b);
        }
        if let Some(h) = sinks {
            reads.push(h);
        }
        let present = |cache: i32| [
            DeviceTensor {
                slot: cache,
                offset: 0,
                extents: [batch, kv, total, d],
                strides,
                packed: null,
            },
            DeviceTensor {
                slot: cache,
                offset: n,
                extents: [batch, kv, total, d],
                strides,
                packed: null,
            },
        ];
        let appending = self.appendable(past_k, past_v, capacity, n, &strides, past, shared);
        if appending matches { Some(_) } {
            self.made_elsewhere(2 * n);
        }
        // Recorded where a later call can do it again: over the cache it
        // appends to in place, in a launch, outside another recording.
        let key = if appending matches { Some(_) } && self.taping matches { null } {
            self.attention_key(stored);
        } else {
            null;
        };
        if let Some(cache) = appending
            && let Some(replay) = key
            && let Some(result) = self.replayed_as(replay, &reads, &heads_of, &grids) {
            self.filled[cache] = Filled { positions: total, capacity };
            let [present_k, present_v] = present(cache);
            return Option::Some([result, present_k, present_v]);
        }

        let mut tables: List<DeviceTensor> = [];
        if let Some([c, sn]) = rotary {
            tables = [*c, *sn];
        }
        let mut append_operands = [*k, *v] as List<DeviceTensor>;
        append_operands.extend(&tables);
        // The cache's views before its buffer is known, for `binds`. The
        // attention reads them over every position the cache holds, so its
        // bindings stay those of the step before while the cache fills.
        let mut attend_operands: List<DeviceTensor> = [
            *q,
            contiguous(PENDING, 0, held),
            contiguous(PENDING, n, held),
        ];
        attend_operands.extend(&tables);
        if let Some(b) = bias {
            // Bound over every position it holds, as the cache is, so its
            // binding too stays the step before's. The kernel reads each
            // row's reach.
            let over = [batch, heads, s, b.extents[3]] as List<i32>;
            attend_operands.push(DeviceTensor { ..*b, strides: stretched(b, &over), extents: over });
        }
        let mut join_operands = [contiguous(PENDING, 0, [attended])] as List<DeviceTensor>;
        if let Some(h) = sinks {
            join_operands.push(*h);
        }
        if !self.binds(&append_operands) || !self.binds(&attend_operands) || !self.binds(&join_operands) {
            return null;
        }

        let cache = match appending {
            Some(slot) => slot,
            null => {
                // Only the positions the past holds: the append writes the
                // next ones, and the attention reads none past them. A shared
                // past is the present, which keeps what its rows hold past
                // their own.
                let slot = self.allocated(2 * n, false);
                let copied = if shared { past_k.extents[2] } else { past };
                let held_past = [batch, kv, copied, d] as List<i32>;
                self.copy(&sliced(past_k, 2, 0, copied), &DeviceTensor {
                    slot,
                    offset: 0,
                    extents: held_past,
                    strides,
                    packed: null,
                });
                self.copy(&sliced(past_v, 2, 0, copied), &DeviceTensor {
                    slot,
                    offset: n,
                    extents: held_past,
                    strides,
                    packed: null,
                });
                slot;
            },
        };
        self.filled[cache] = Filled { positions: total, capacity };
        if key matches { Some(_) } {
            self.tape();
        }
        self.dispatch_bound(
            &append_operands,
            Span { slot: cache, first: 0, count: 2 * n },
            heads_of[0],
            |bindings| ShaderKey::Append([bindings, half > 0, batch, stored]),
            grids[0],
        );

        let [present_k, present_v] = present(cache);
        attend_operands[1] = DeviceTensor { ..present_k, extents: held };
        attend_operands[2] = DeviceTensor { ..present_v, extents: held };
        let parts = self.allocated(attended, false);
        let biased = bias matches { Some(_) };
        self.dispatch_bound(
            &attend_operands,
            Span { slot: parts, first: 0, count: attended },
            heads_of[1],
            |bindings| ShaderKey::Attend([bindings, d, half > 0, biased, part, batch, stored]),
            grids[1],
        );

        let result = contiguous(self.allocated(rows * d, false), 0, [batch, s, heads * d]);
        join_operands[0] = contiguous(parts, 0, [attended]);
        let sunk = sinks matches { Some(_) };
        self.dispatch_bound(
            &join_operands,
            fresh(&result),
            heads_of[2],
            |bindings| ShaderKey::AttendJoin([bindings, sunk, stored]),
            grids[2],
        );
        if let Some(replay) = key {
            let mut lengths: List<i32> = [];
            for let h of &heads_of {
                lengths.push(h.len());
            }
            self.taped(replay, &reads, Option::Some(&result), lengths);
        }
        return Option::Some([result, present_k, present_v]);
    }

    /// The replay key of the attention of the running launch, where one runs,
    /// writing its result as `stored` says. Programs whose graphs differ in
    /// their element kinds alone share a serial, so the format is in the key.
    fn attention_key(&mut self, stored: Option<HalfFloat>) -> Option<i32> {
        let Some(r) = &self.running else {
            return null;
        };
        let format = match stored {
            null => 0,
            Some(_::F16) => 1,
            Some(_::BF16) => 2,
        };
        // A kernel's key starts with its program's serial, which is never
        // negative.
        return Option::Some(self.replay_key([-1, (r.launch >> 32) as i32, r.launch as i32, format]));
    }

    /// The positions an attention cache holds once it holds `total`: a power
    /// of two, at least `CACHE_LEAST`, so a step appends where the one before
    /// left room. Exactly `total` where that outgrows a binding, and every
    /// step then moves the cache.
    fn cache_capacity(&self, per_position: i32, total: i32) -> i32 {
        let mut capacity = CACHE_LEAST;
        while capacity < total {
            capacity *= 2;
        }
        if 2 * per_position as i64 * capacity as i64 > self.max_binding as i64 {
            return total;
        }
        return capacity;
    }

    /// The cache `past_k` and `past_v` are in where a step appends to it in
    /// place: one of `capacity` positions, their keys at its start and their
    /// values `values` after, laid out by `strides`, and nothing written past
    /// their `past` positions. A `shared` past is the present's buffer, so
    /// what it holds past `past` is the step's to overwrite.
    fn appendable(
        &self,
        past_k: &DeviceTensor,
        past_v: &DeviceTensor,
        capacity: i32,
        values: i32,
        strides: &List<i32>,
        past: i32,
        shared: bool,
    ) -> Option<i32> {
        let slot = past_k.slot;
        let Some(cache) = self.filled.get(slot) else {
            return null;
        };
        let laid_out = past_v.slot == slot && reads_as(past_k, 0, strides) && reads_as(past_v, values, strides);
        let overwrites_nothing_held = cache.positions == past || shared && cache.positions > past;
        if laid_out && overwrites_nothing_held && cache.capacity == capacity {
            return Option::Some(slot);
        }
        return null;
    }

    /// `t`, the keys or the values of an attention cache, over `extent` of
    /// its positions, where the cache has room for them: what it holds past
    /// the ones `t` reads is the attention's own, which it reads none of.
    internal fn widened_cache(&self, t: &DeviceTensor, axis: i32, extent: i32) -> Option<DeviceTensor> {
        let Some(cache) = self.filled.get(t.slot) else {
            return null;
        };
        if axis != 2 || extent > cache.capacity {
            return null;
        }
        let mut extents = t.extents;
        extents[axis] = cache.capacity;
        let strides = row_major(&extents);
        let values = element_count(&extents);
        if !reads_as(t, 0, &strides) && !reads_as(t, values, &strides) {
            return null;
        }
        extents[axis] = extent;
        return Option::Some(DeviceTensor { ..*t, extents, strides });
    }

    /// Records the shader `shader` makes of the bindings `operands` take, as
    /// `bindable` binds them, writing `out`. Its parameters are `head`, then
    /// each operand's offset and strides.
    fn dispatch_bound(
        &mut self,
        operands: &List<DeviceTensor>,
        out: Span,
        head: List<u32>,
        shader: fn(List<i32>) -> ShaderKey,
        groups: [i32, i32, i32],
    ) with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let Some(bound) = self.bindable(operands) else {
            panic("loam: a kernel's operands do not bind, which `binds` said they would");
        };
        let mut params = head;
        for let o of bound.views {
            push_view(&mut params, o.offset, &o.strides);
        }
        let mut spans = bound.spans;
        spans.push(out);
        self.dispatch(shader(bound.bindings), spans, params, groups);
    }

    /// The serial of the programs of `structure`: one no other structure has.
    internal fn program_serial(&mut self, structure: List<i32>) -> i32 {
        return numbered(&mut self.programs, structure);
    }

    /// A number for the kernel signature `s`, the one it had where one had
    /// it.
    internal fn signature(&mut self, s: List<i32>) -> i32 {
        return numbered(&mut self.signatures, s);
    }

    /// Starts recording the commands of a launch.
    internal fn tape(&mut self) {
        self.taping = Option::Some([]);
    }

    /// The number a launch's commands are recorded under, for `key`: the
    /// program's serial, then each of its roots and that kernel's signature.
    internal fn replay_key(&mut self, key: List<i32>) -> i32 {
        return numbered(&mut self.replay_keys, key);
    }

    /// Ends the recording `tape` started, keeping it under `key` as the
    /// commands of a launch over `views` that yields `result` on the device,
    /// where it wrote no host value and read none back. A replay sets the
    /// leading `heads[k]` parameters of its `k`th dispatch anew, where `heads`
    /// counts any.
    internal fn taped(&mut self, key: i32, views: &List<&DeviceTensor>, result: Option<&DeviceTensor>, heads: List<i32>) {
        let taping = self.taping;
        self.taping = null;
        let Some(commands) = taping else {
            return;
        };
        let Some(r) = result else {
            return;
        };
        // Operands packed to bind add dispatches of their own, which no
        // count names.
        if !heads.is_empty() && dispatches_in(&commands) != heads.len() {
            return;
        }
        let mut reads: List<DeviceTensor> = [];
        for let v of views {
            reads.push(**v);
        }
        let mut layouts = self.encoded.get(key).unwrap_or([]);
        if layouts.len() >= LAYOUTS {
            let mut oldest = 0;
            for let i of 1..<layouts.len() {
                if layouts[i].used < layouts[oldest].used {
                    oldest = i;
                }
            }
            layouts.remove(oldest);
        }
        layouts.push(Encoded { reads, commands, result: *r, heads, used: self.passes });
        self.encoded[key] = layouts;
    }

    /// What the launch recorded under `key` yields, its commands done again
    /// over `reads`, or `None` where none is recorded over reads laid out as
    /// `renamed_over` says.
    internal fn replayed(
        &mut self,
        key: i32,
        reads: &List<&DeviceTensor>,
    ) -> Option<DeviceTensor> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuComputePassEncoder) {
        return self.replayed_as(key, reads, &[], &[]);
    }

    /// What `replayed` yields, the `k`th dispatch done with `heads[k]` in
    /// place of the leading parameters its recording counts, in `grids[k]`
    /// workgroups, where `heads` holds any.
    fn replayed_as(
        &mut self,
        key: i32,
        reads: &List<&DeviceTensor>,
        heads: &List<List<u32>>,
        grids: &List<[i32, i32, i32]>,
    ) -> Option<DeviceTensor> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuComputePassEncoder) {
        if !self.encoded.contains_key(key) {
            return null;
        }
        let layouts = &mut self.encoded[key];
        let mut found: Option<[i32, Renamed]> = null;
        for let at of 0..<layouts.len() {
            if let Some(slots) = renamed_over(&layouts[at].reads, reads) {
                found = Option::Some([at, slots]);
                break;
            }
        }
        let Some([at, mut slots]) = found else {
            return null;
        };
        let e = &mut layouts[at];
        assert e.heads.len() == heads.len(), "a launch replays with the parameters it recorded it would set";
        e.used = self.passes;
        self.replays += 1;
        let mut k = 0;
        for let c of &e.commands {
            match c {
                Allocated([count, slot]) => {
                    let named = slots.bound(*slot, self.allocated(*count, false));
                    assert named, "a buffer a launch makes is no buffer it reads";
                },
                Dispatched(d) => {
                    if heads.is_empty() {
                        self.redispatched(d, &slots, &d.params, d.groups);
                    } else {
                        let mut params = heads[k];
                        for let i of e.heads[k]..<d.params.len() {
                            params.push(d.params[i]);
                        }
                        self.redispatched(d, &slots, &params, grids[k]);
                    }
                    k += 1;
                },
            }
        }
        return Option::Some(DeviceTensor { ..e.result, slot: slots.of(e.result.slot) });
    }
}

impl Holds for WebGpuBackend {
    type Tensor<E: Element, Axes> = Placed<E, Axes>;

    fn upload<E: Element, Axes>(&mut self, t: &Tensor<E, Axes>) -> Placed<E, Axes> with (GpuDevice, GpuQueue, GpuBuffer) {
        return self.stored(t, false);
    }

    /// A kept mask is written once, and each pass reads it where it is.
    fn keep<E: Element, Axes>(&mut self, t: &Tensor<E, Axes>) -> Placed<E, Axes> with (GpuDevice, GpuQueue, GpuBuffer) {
        return self.stored(t, true);
    }

    fn extents_of<E: Element, Axes>(&self, t: &Placed<E, Axes>) -> List<i32> {
        return match t {
            Host(h) => h.extents,
            Device(d) => d.extents,
        };
    }

    fn download<E: Element, Axes>(
        &mut self,
        t: &Placed<E, Axes>,
    ) -> Tensor<E, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        return self.host(t);
    }

    /// Submits what the pass before recorded and releases its buffers, so a
    /// tensor of that pass is no longer one to read, but for those it
    /// retained, which live through this pass. A spare it did not take is
    /// dropped, and so is a bind group of a dropped buffer. A bind group that
    /// the last `IDLE_PASSES` passes did not use is dropped too, and so are a
    /// launch's layouts and what a launch owns, every `SWEEP_PASSES`th pass,
    /// since finding those walks every launch.
    fn begin(&mut self) with (GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBindGroup, GpuBuffer) {
        self.flush();
        self.parameters = null;
        let mut dropped = HashSet::<i32>::new();
        while let Some(s) = self.spare.pop() {
            self.dropped_buffer(s.at, &mut dropped);
        }
        let mut carried: List<Carried> = [];
        let start = self.pass_start;
        self.pass_start += self.pass.len();
        for let i of 0..<self.pass.len() {
            if self.retaining.contains(start + i) {
                carried.push(Carried { slot: start + i, at: self.pass[i] });
            } else {
                self.release(self.pass[i]);
            }
        }
        self.pass = [];
        for let c of self.carried {
            if self.retaining.contains(c.slot) {
                carried.push(c);
            } else {
                self.release(c.at);
            }
        }
        let mut filled: HashMap<i32, Filled> = HashMap::new();
        for let c of &carried {
            if let Some(cache) = self.filled.get(c.slot) {
                filled[c.slot] = cache;
            }
        }
        self.filled = filled;
        self.carried = carried;
        self.retaining = HashSet::new();
        let oldest = self.passes - IDLE_PASSES;
        if self.passes % SWEEP_PASSES == 0 {
            self.dropped_idle_launches(oldest, &mut dropped);
            self.dropped_idle_layouts(oldest);
        }
        for let at of 0..<self.groups.held.len() {
            if let Some(g) = &self.groups.held[at]
                && (g.used < oldest || !dropped.is_empty() && binds_any(&g.key, &dropped)) {
                self.group_at.remove(g.key);
                self.groups.remove(at);
            }
        }
        self.passes += 1;
    }

    /// Drops each launch's layout the passes since `oldest` did not use.
    fn dropped_idle_layouts(&mut self, oldest: i32) {
        let mut stale: List<i32> = [];
        for let [key, layouts] of self.encoded.entries() {
            for let e of layouts {
                if e.used < oldest {
                    stale.push(*key);
                    break;
                }
            }
        }
        for let key of stale {
            let kept: List<Encoded> = self.encoded[key].into_iter().filter(|e| e.used >= oldest).collect();
            if kept.is_empty() {
                self.encoded.remove(key);
            } else {
                self.encoded[key] = kept;
            }
        }
    }

    fn retain<E: Element, Axes>(&mut self, t: &Placed<E, Axes>) {
        if let Device(d) = t && d.slot >= 0 {
            self.retaining.insert(d.slot);
        }
    }
}

impl WebGpuBackend {
    /// `Graph::arg_max`: one workgroup per part of a lane, then one per
    /// lane over the parts' winners, each index left on the device as an f32,
    /// which holds it exactly, for a step after it to read.
    internal fn arg_max_kernel<E: Float, Axes>(
        &mut self,
        t: &Placed<E, Axes>,
        axis: i32,
    ) -> Placed<i64, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let view = self.device_view(t);
        let rank = view.extents.len();
        let moved = permuted(&view, &moved_last(rank, &([axis] as List<i32>)));
        let lane = view.extents[axis];
        // An empty axis breaks the contract the Cpu kernel states.
        if lane == 0 {
            return Placed::Host(arg_max(&self.host(t), axis));
        }
        let lanes = element_count(&view.extents) / lane;
        let operands = [moved] as List<DeviceTensor>;
        if lane > 1 << 24 || lanes > self.max_binding || !self.binds(&operands) {
            return Placed::Host(arg_max(&self.host(t), axis));
        }
        let out = self.allocated(lanes, false);
        let written = Span { slot: out, first: 0, count: lanes };
        let parts = lane.div_ceil(ARG_MAX_PART);
        let groups = lanes * parts;
        let [gx, gy] = spread(groups);
        let mut head: List<u32> = [];
        push_all(&mut head, &([groups, gx, lane, parts] as List<i32>));
        push_all(&mut head, &moved.extents);
        if parts == 1 {
            self.dispatch_bound(&operands, written, head, |bindings| ShaderKey::ArgMax([bindings, rank, Whole]), [
                gx, gy, 1,
            ]);
        } else {
            let pairs = self.allocated(2 * groups, false);
            self.dispatch_bound(
                &operands,
                Span { slot: pairs, first: 0, count: 2 * groups },
                head,
                |bindings| ShaderKey::ArgMax(
                    [bindings, rank, Parts],
                ),
                [gx, gy, 1],
            );
            let [lx, ly] = spread(lanes);
            let combine = [contiguous(pairs, 0, [2 * groups])] as List<DeviceTensor>;
            let mut combined = head;
            combined[0] = lanes as u32;
            combined[1] = lx as u32;
            self.dispatch_bound(
                &combine,
                written,
                combined,
                |bindings| ShaderKey::ArgMax([bindings, rank, Combine]),
                [lx, ly, 1],
            );
        }
        let mut extents = view.extents;
        extents[axis] = 1;
        return Placed::Device(contiguous(out, 0, extents));
    }

    /// `Graph::quantized_product` of `operands`, the input as `[M, K]`, the
    /// packed weight, its scales and any zero points, then `then` over a
    /// `[M, N]` product: one workgroup per `QUANTIZED_COLUMNS` columns and at
    /// most `QUANTIZED_ROWS` rows, each weight rounded to any `half`, and the
    /// result held as `new_tensor` holds what `then` stores. Where `paired`,
    /// the weights' rows alternate between two products', and `then` reads
    /// both over `[M, N / 2]`: `operand(0)` the even column's sum and
    /// `operand(1)` the odd one's. `None` where they do not bind.
    internal fn quantized_product_kernel<Out>(
        &mut self,
        operands: &List<DeviceTensor>,
        bits: i32,
        block: i32,
        half: Option<HalfFloat>,
        then: &Epilogue<PlacedRead<Out>>,
        paired: bool,
    ) -> Option<DeviceTensor> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let [m, k] = [operands[0].extents[0], operands[0].extents[1]];
        let packed = &operands[1].extents;
        let n = packed[0];
        assert !paired || n % 2 == 0, "a pair's weights hold two products' rows";
        let product = [m, if paired { n / 2 } else { n }] as List<i32>;
        let mut all = *operands;
        for let o of &then.operands {
            all.push(DeviceTensor { ..o.view, extents: product, strides: stretched(&o.view, &product) });
        }
        if m * n > self.max_binding || !self.binds(&all) {
            return null;
        }
        let out = self.new_tensor(product, rounds_to_f16(&then.op));
        // An empty input dispatches no workgroup, whatever its rows.
        let rows = i32::clamp(m, 1, QUANTIZED_ROWS);
        let groups = n.div_ceil(QUANTIZED_COLUMNS) * m.div_ceil(rows);
        let [gx, gy] = spread(groups);
        let zero_points = operands.len() > 3;
        let weight = &operands[1];
        let blob = packed[2];
        let aligned = blob % 4 == 0 && weight.offset % 4 == 0 && weight.strides == [packed[1] * blob, blob, 1];
        let shape = QuantizedShape { bits, block, zero_points, half, rows, aligned, paired, padded: k % block != 0 };
        self.dispatch_bound(
            &all,
            fresh(&out),
            [groups as u32, gx as u32, m as u32, k as u32, n as u32, packed[1] as u32, blob as u32],
            |bindings| ShaderKey::QuantizedProduct([then.op, bindings, shape]),
            [gx, gy, 1],
        );
        return Option::Some(out);
    }

    /// `Graph::quantized_gather` of `operands`, the packed table, the indices
    /// flat, its scales and any zero points, as a `[I, W]` result: one
    /// invocation per element, rounded to any `half` and held as `new_tensor`
    /// holds it. `None` where they do not bind.
    internal fn quantized_gather_kernel(
        &mut self,
        operands: &List<DeviceTensor>,
        bits: i32,
        block: i32,
        half: Option<HalfFloat>,
    ) -> Option<DeviceTensor> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let [rows, width] = [operands[0].extents[0], operands[0].extents[1] * (8 / bits)];
        let count = operands[1].extents[0] * width;
        if count > self.max_binding || !self.binds(operands) {
            return null;
        }
        let out = self.new_tensor([operands[1].extents[0], width], half matches { Some(_::F16) });
        let [x, y] = grid(count);
        let zero_points = operands.len() > 3;
        self.dispatch_bound(
            operands,
            fresh(&out),
            [count as u32, (x * LANES) as u32, width as u32, rows as u32],
            |bindings| ShaderKey::QuantizedGather([bindings, bits, block, zero_points, half]),
            [x, y, 1],
        );
        return Option::Some(out);
    }

    /// Whether a launch makes its next run's buffer at `slot` where it made
    /// this one's: one it owns, but for an attention cache, which a run
    /// appends to.
    internal fn remade(&self, slot: i32) -> bool {
        return self.remade_slots.contains(slot) && !self.filled.contains_key(slot);
    }

    /// `t` copied to a buffer of the pass, which no launch makes again.
    internal fn moved_to_pass(
        &mut self,
        t: &DeviceTensor,
    ) -> DeviceTensor with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        self.running = null;
        let to = contiguous(self.pass_buffer(element_count(&t.extents)), 0, t.extents);
        self.copy(t, &to);
        return to;
    }
}

/// The permutation moving `axes`, sorted, after the rest of `rank` axes.
fn moved_last(rank: i32, axes: &List<i32>) -> List<i32> {
    let mut perm: List<i32> = [];
    for let d of 0..<rank {
        if !axes.contains(&d) {
            perm.push(d);
        }
    }
    perm.extend(&axes.sorted());
    return perm;
}

/// The spans an operand list binds, which binding each operand reads, and the
/// views the shader reads them through, each from the start of its span.
struct Bindings {
    spans: List<Span>,
    bindings: List<i32>,
    views: List<DeviceTensor>,
}

/// The 32-bit words `first..<first + count` of the buffer at `slot`, which one
/// binding of a dispatch holds.
struct Span {
    slot: i32,
    first: i32,
    count: i32,
    /// How the views of the buffer pack their elements, as
    /// `DeviceTensor.packed` says.
    packed: Option<Packed> = null,
}

/// The elements of `t`'s buffer one word holds.
fn elements_per_word(t: &DeviceTensor) -> i32 {
    return match t.packed {
        null => 1,
        Some(_::F16 | _::BF16) => 2,
        Some(_::U8) => 4,
    };
}

/// `t`'s offset from the start of `span`, a binding of its buffer.
fn rebased(t: &DeviceTensor, span: &Span) -> i32 {
    return t.offset - span.first * elements_per_word(t);
}

/// Whether the last step of `op` rounds to f16, which a kernel computing it
/// may then store as f16s.
fn rounds_to_f16(op: &Expr) -> bool {
    return op.steps[op.steps.len() - 1] matches { Rounded([_::F16, _]) };
}

/// Whether `t` holds f16s, which a kernel moving them may store as f16s.
fn holds_f16(t: &DeviceTensor) -> bool {
    return t.packed matches { Some(_::F16) };
}

/// `t`'s buffer from its offset, row-major under `extents`.
fn row_major_view(t: &DeviceTensor, extents: List<i32>) -> DeviceTensor {
    return DeviceTensor { ..contiguous(t.slot, t.offset, extents), packed: t.packed };
}

/// The half that holds each of the `count` values `value(i)` exactly, bf16
/// before f16: a bf16 is an f32's high bits, which a shader widens with a
/// shift. f16 is offered finite values alone, since WGSL leaves what
/// `unpack2x16float` makes of any other open.
fn half_holding(count: i32, value: fn(i32) -> f32) -> Option<HalfFloat> {
    let mut in_bf16 = true;
    let mut in_f16 = true;
    for let i of 0..<count {
        let v = value(i);
        in_bf16 = in_bf16 && v.to_bits() & 0xFFFF == 0;
        in_f16 = in_f16 && v.is_finite() && (f16::from_f32(v) as f32).to_bits() == v.to_bits();
        if !in_bf16 && !in_f16 {
            return null;
        }
    }
    return Option::Some(if in_bf16 { HalfFloat::BF16 } else { HalfFloat::F16 });
}

/// The elements a pack of `operands` holds, each copied whole.
fn packed_count(operands: &List<DeviceTensor>) -> i32 {
    let mut total = 0;
    for let o of *operands {
        total += element_count(&o.extents);
    }
    return total;
}

/// The whole of `t`, a buffer just allocated for it.
fn fresh(t: &DeviceTensor) -> Span
    contract t.offset == 0
{
    let words = element_count(&t.extents).div_ceil(elements_per_word(t));
    return Span { slot: t.slot, first: 0, count: i32::max(words, 1), packed: t.packed };
}

/// The first and last word of its buffer `t` reads.
fn words_read(t: &DeviceTensor) -> [i32, i32] {
    let per_word = elements_per_word(t);
    let [first, last] = reach(t);
    return [first / per_word, last / per_word];
}

/// The first and last element `t` reads: only its offset where it has no
/// elements, which a binding of one element covers.
fn reach(t: &DeviceTensor) -> [i32, i32] {
    let mut first = t.offset;
    let mut last = t.offset;
    if element_count(&t.extents) == 0 {
        return [first, last];
    }
    for let d of 0..<t.extents.len() {
        let step = t.strides[d] * i32::max(t.extents[d] - 1, 0);
        first += i32::min(step, 0);
        last += i32::max(step, 0);
    }
    return [first, last];
}

/// Whether `words` is a run of one or more consecutive rows, ascending.
fn consecutive(words: &List<u32>) -> bool {
    for let i of 1..<words.len() {
        if words[i] != words[0] + i as u32 {
            return false;
        }
    }
    return !words.is_empty();
}

/// `t` along `axis` from `start`, `length` of it.
internal fn sliced(t: &DeviceTensor, axis: i32, start: i32, length: i32) -> DeviceTensor {
    let mut view = *t;
    view.offset += start * t.strides[axis];
    view.extents[axis] = length;
    return view;
}

/// The first axis of `extents` longer than 1, along which a kernel too wide
/// for one dispatch is halved.
fn split_axis(extents: &List<i32>) -> i32 {
    let Some(axis) = extents.position(|e| e > 1) else {
        panic("loam: one element outgrows a binding");
    };
    return axis;
}

/// A view of `extents` laid out row-major from `offset`.
fn contiguous(slot: i32, offset: i32, extents: List<i32>) -> DeviceTensor {
    return DeviceTensor { slot, offset, strides: row_major(&extents), extents, packed: null };
}

/// The strides of `extents` laid out row-major.
fn row_major(extents: &List<i32>) -> List<i32> {
    let mut strides = List::<i32>::filled(extents.len(), 1);
    for let mut d = extents.len() - 2; d >= 0; d -= 1 {
        strides[d] = strides[d + 1] * extents[d + 1];
    }
    return strides;
}

/// Whether `t`'s elements lie row-major from its offset.
fn is_contiguous(t: &DeviceTensor) -> bool {
    return reads_as(t, t.offset, &row_major(&t.extents));
}

/// Whether `t` reads the elements a view from `offset` with `strides` reads
/// over its extents. An axis of extent 1 steps nowhere, so its stride does
/// not matter, and a `reshape` rewrites it freely.
internal fn reads_as(t: &DeviceTensor, offset: i32, strides: &List<i32>) -> bool {
    if t.offset != offset {
        return false;
    }
    for let d of 0..<t.extents.len() {
        if t.extents[d] != 1 && t.strides[d] != strides[d] {
            return false;
        }
    }
    return true;
}

/// `t`'s strides read under `out`, its extents aligned with `out`'s from the
/// end: 0 along an axis it lacks or has at extent 1.
fn stretched(t: &DeviceTensor, out: &List<i32>) -> List<i32> {
    let lead = out.len() - t.extents.len();
    assert lead >= 0;
    let mut strides = List::<i32>::filled(lead, 0);
    for let d of 0..<t.extents.len() {
        strides.push(if t.extents[d] == 1 && out[lead + d] != 1 { 0 } else { t.strides[d] });
    }
    return strides;
}

/// The extents every operand broadcasts to.
fn broadcast_all(operands: &List<DeviceTensor>) -> List<i32> {
    let mut extents: List<i32> = [];
    for let o of *operands {
        extents = broadcast_extents(&extents, &o.extents).unwrap();
    }
    return extents;
}

/// `t`'s axes in the order `perm` lists them.
internal fn permuted(t: &DeviceTensor, perm: &List<i32>) -> DeviceTensor {
    let mut extents: List<i32> = [];
    let mut strides: List<i32> = [];
    for let p of *perm {
        extents.push(t.extents[p]);
        strides.push(t.strides[p]);
    }
    return DeviceTensor { ..*t, extents, strides };
}

/// `t`'s elements under `extents`, in row-major order, as a view of the same
/// buffer, or `None` where its strides cannot say it so a copy must. Each run
/// of `t`'s axes that `extents` regroups must step through memory as one axis
/// would, as numpy's reshape asks before it copies.
fn regrouped(t: &DeviceTensor, extents: &List<i32>) -> Option<DeviceTensor> {
    if element_count(extents) == 0 {
        return null;
    }
    // An axis of 1 steps nowhere, so it joins no run.
    let mut old: List<i32> = [];
    let mut old_strides: List<i32> = [];
    for let d of 0..<t.extents.len() {
        if t.extents[d] != 1 {
            old.push(t.extents[d]);
            old_strides.push(t.strides[d]);
        }
    }
    let mut strides = List::<i32>::filled(extents.len(), 0);
    let [mut oi, mut ni] = [0, 0];
    while oi < old.len() && ni < extents.len() {
        // The shortest runs of old and new axes holding one count.
        let [mut oj, mut nj] = [oi + 1, ni + 1];
        let [mut held, mut wanted] = [old[oi], extents[ni]];
        while held != wanted {
            if wanted < held {
                wanted *= extents[nj];
                nj += 1;
            } else {
                held *= old[oj];
                oj += 1;
            }
        }
        for let k of oi..<oj - 1 {
            if old_strides[k] != old[k + 1] * old_strides[k + 1] {
                return null;
            }
        }
        strides[nj - 1] = old_strides[oj - 1];
        for let mut k = nj - 1; k > ni; k -= 1 {
            strides[k - 1] = strides[k] * extents[k];
        }
        oi = oj;
        ni = nj;
    }
    return Option::Some(DeviceTensor { ..*t, extents: *extents, strides });
}

/// The permutation undoing `perm`.
fn inverse(perm: &List<i32>) -> List<i32> {
    let mut out = List::<i32>::filled(perm.len(), 0);
    for let [i, p] of perm.into_iter().enumerate() {
        out[*p] = i;
    }
    return out;
}

/// A rank-1 operand on the left of a product: one row.
fn as_row(t: &DeviceTensor) -> DeviceTensor {
    return DeviceTensor {
        ..*t,
        extents: [1, t.extents[0]],
        strides: [0, t.strides[0]],
    };
}

/// A rank-1 operand on the right of a product: one column.
fn as_column(t: &DeviceTensor) -> DeviceTensor {
    return DeviceTensor {
        ..*t,
        extents: [t.extents[0], 1],
        strides: [t.strides[0], 0],
    };
}

/// A matrix operand's strides along `batch`, its own batch axes aligned with
/// it from the end, 0 along one it lacks or has at extent 1.
fn batch_strides(m: &DeviceTensor, batch: &List<i32>) -> List<i32> {
    let r = m.extents.len();
    let own = DeviceTensor {
        ..*m,
        extents: m.extents[0..<r - 2].to_list(),
        strides: m.strides[0..<r - 2].to_list(),
    };
    return stretched(&own, batch);
}

/// The parameters [`product_shader`] and [`narrow_product_shader`] read up to
/// a chunk's partial sums: `dims`, its rows, inner and columns, the `batch`
/// extents, the two matrices' views, the first two of `views`, then each
/// epilogue operand's after them, read under the result's `extents`, which
/// drop an axis a rank-1 operand of `a_extents` or `b_extents` stands in for.
fn product_params(
    dims: [i32, i32, i32],
    batch: &List<i32>,
    views: &List<DeviceTensor>,
    extents: &List<i32>,
    a_extents: &List<i32>,
    b_extents: &List<i32>,
) -> List<u32> {
    let [rows, inner, cols] = dims;
    let mut params: List<u32> = [rows as u32, inner as u32, cols as u32];
    push_all(&mut params, batch);
    for let i of 0..<2 {
        let m = &views[i];
        let r = m.extents.len();
        push_view(&mut params, m.offset, &batch_strides(m, batch));
        push_signed(&mut params, m.strides[r - 2]);
        push_signed(&mut params, m.strides[r - 1]);
    }
    for let i of 2..<views.len() {
        let o = &views[i];
        push_view(&mut params, o.offset, &internal_strides(&stretched(o, extents), a_extents, b_extents, batch.len()));
    }
    return params;
}

/// An epilogue operand's strides over the product's `[..batch, rows, cols]`,
/// from its strides over the result, which drops the rows axis where `a` is
/// rank 1 and the columns axis where `b` is.
fn internal_strides(over_result: &List<i32>, a: &List<i32>, b: &List<i32>, batch: i32) -> List<i32> {
    let mut strides = over_result[0..<batch].to_list();
    let mut at = batch;
    if a.len() > 1 {
        strides.push(over_result[at]);
        at += 1;
    } else {
        strides.push(0);
    }
    strides.push(if b.len() > 1 { over_result[at] } else { 0 });
    return strides;
}

/// The workgroups covering `count` invocations of `LANES` each: as many as one
/// dimension takes along `x`, the rest along `y`.
fn grid(count: i32) -> [i32, i32] {
    return spread(count.div_ceil(LANES));
}

/// `groups` workgroups as a grid of rows of at most `MAX_GROUPS`: the
/// workgroups per row, and the rows.
fn spread(groups: i32) -> [i32, i32] {
    let x = i32::min(groups, MAX_GROUPS);
    return [x, if x == 0 { 0 } else { groups.div_ceil(x) }];
}

/// The parameters every shader with one invocation per element starts with:
/// the count, the invocations per row of `x` workgroups, and the extents.
fn element_params(count: i32, x: i32, extents: &List<i32>) -> List<u32> {
    let mut params: List<u32> = [count as u32, (x * LANES) as u32];
    push_all(&mut params, extents);
    return params;
}

/// A device's limit as a count the backend computes with: a limit past
/// `i32::MAX`, which a driver may report as unbounded, is `i32::MAX`.
fn saturated(limit: u64) -> i32 {
    return if limit > i32::MAX as u64 { i32::MAX } else { limit as i32 };
}

/// The bytes `count` f32 elements take, at least one element's: WebGPU binds
/// no empty buffer.
fn byte_size(count: i32) -> GpuSize64 {
    return (i32::max(count, 1) * 4) as u64 as GpuSize64;
}

fn push_all(params: &mut List<u32>, values: &List<i32>) {
    for let v of *values {
        params.push(v as u32);
    }
}

/// `v`, which may be negative, as a shader reads it back with `bitcast<i32>`.
fn push_signed(params: &mut List<u32>, v: i32) {
    params.push(v as u32);
}

fn push_view(params: &mut List<u32>, offset: i32, strides: &List<i32>) {
    push_signed(params, offset);
    for let s of *strides {
        push_signed(params, s);
    }
}

/// How a shader holds the elements of a binding: f32s, f16s where the device
/// computes in f16, or two halves to a `u32` where it does not, the even one
/// in the low half.
enum Words {
    F32,
    F16,
    PackedF16,
    PackedBF16,
    /// Indices the host wrote, which no float read may flush.
    U32,
    /// Four bytes to a `u32`, the first in the lowest.
    Bytes,
}

/// The WGSL declaring a read-only buffer `o{k}` for each of `words` but the
/// last, which is the output `out`'s, then the parameters `p`. `load{k}(i)` reads
/// element `i` of `o{k}` as an f32, and `put(i, v)` writes `v` to `out`, which
/// holds f32s or f16s.
fn buffers_wgsl(words: &List<Words>) -> String {
    let last = words.len() - 1;
    let mut out = "";
    for let k of 0..<last {
        out.push_str(`@group(0) @binding(${k}) var<storage, read> o${k}: array<${array_wgsl(words[k])}>;
fn load${k}(i: u32) -> f32 {
    return ${element_wgsl(`o${k}`, "i", words[k])};
}
`);
    }
    let stored = match words[last] {
        _::F32 => "v",
        _::F16 => "f16(v)",
        _ => panic("loam: a kernel writes f32s or f16s alone"),
    };
    out.push_str(`@group(0) @binding(${last}) var<storage, read_write> out: array<${array_wgsl(words[last])}>;
fn put(i: u32, v: f32) {
    out[i] = ${stored};
}
@group(0) @binding(${last + 1}) var<storage, read> p: array<u32>;
`);
    return out;
}

/// The WGSL type of an element of a buffer of `words`.
fn array_wgsl(words: Words) -> String {
    return match words {
        _::F32 => "f32",
        _::F16 => "f16",
        _::PackedF16 | _::PackedBF16 | _::U32 | _::Bytes => "u32",
    };
}

/// The f32 at the element index `index`, a `u32`, of the buffer `buffer`
/// holding `words`, a half widened.
fn element_wgsl(buffer: String, index: String, words: Words) -> String {
    return match words {
        _::F32 => `${buffer}[${index}]`,
        _::F16 | _::U32 => `f32(${buffer}[${index}])`,
        _::PackedF16 => `unpack2x16float(${buffer}[(${index}) >> 1u])[(${index}) & 1u]`,
        _::PackedBF16 => `bitcast<f32>((${buffer}[(${index}) >> 1u] >> (((${index}) & 1u) * 16u)) << 16u)`,
        _::Bytes => `f32((${buffer}[(${index}) >> 2u] >> (((${index}) & 3u) * 8u)) & 0xFFu)`,
    };
}

/// Lines binding `v0` and `v1` to the elements `index`, which is even, and
/// the one after it of binding `k`, which holds `words` of halves.
fn pair_wgsl(words: Words, k: i32, index: String, indent: String) -> String {
    return match words {
        _::F16 => `${indent}let v0 = load${k}(${index});
${indent}let v1 = load${k}(${index} + 1u);
`,
        _::PackedF16 => `${indent}let v = unpack2x16float(o${k}[${index} >> 1u]);
${indent}let v0 = v.x;
${indent}let v1 = v.y;
`,
        _::PackedBF16 => `${indent}let w = o${k}[${index} >> 1u];
${indent}let v0 = bitcast<f32>(w << 16u);
${indent}let v1 = bitcast<f32>(w & 0xFFFF0000u);
`,
        _::F32 | _::U32 | _::Bytes => panic("loam: a lane reads two halves of a word that holds none"),
    };
}

/// Lines binding `{name}{from}`, … `{name}{to - 1}` to the coordinates of
/// `linear` over the axes `from..<to` of the extents at `p[extents]` on.
fn coords_wgsl(linear: String, extents: i32, from: i32, to: i32, name: String, indent: String) -> String {
    let mut out = `${indent}var ${name}_rest = ${linear};\n`;
    for let mut d = to - 1; d >= from; d -= 1 {
        out.push_str(`${indent}let ${name}${d} = ${name}_rest % p[${extents + d}];\n`);
        out.push_str(`${indent}${name}_rest = ${name}_rest / p[${extents + d}];\n`);
    }
    return out;
}

/// The element index of a view whose offset is at `p[at]` and whose strides
/// follow, at coordinates `c{from}` … over the axes `from..<to`, plus `base`.
fn index_wgsl(at: i32, from: i32, to: i32, coords: String, base: String) -> String {
    let mut terms = base;
    for let d of from..<to {
        terms.push_str(` + i32(${coords}${d}) * bitcast<i32>(p[${at + 1 + d}])`);
    }
    return terms;
}

/// The statements computing `op`'s steps up to `last` as `s0`, `s1`, …, its
/// operands read as `x0`, `x1`, … and a `Fold` step as `folds[i]`, `i` its
/// place among the folds.
fn steps_wgsl(op: &Expr, last: i32, indent: String) -> String {
    let mut body = "";
    let mut fold = 0;
    for let i of 0..=last {
        let value = match op.steps[i] {
            Operand(n) => `x${n}`,
            Constant(c) => if c.is_finite() { `bitcast<f32>(${c.to_bits()}u)` } else { `non_finite(${c.to_bits()}u)` },
            Unary([u, a]) => unary_wgsl(u, `s${a}`),
            Binary([o, a, b]) => binary_wgsl(o, `s${a}`, `s${b}`),
            Select([c, a, b]) => `select(s${b}, s${a}, s${c} != 0.0)`,
            Rounded([to, a]) => rounded_wgsl(Option::Some(to), `s${a}`),
            Fold(_) => {
                fold += 1;
                `folds[${fold - 1}]`;
            },
        };
        body.push_str(`${indent}let s${i} = ${value};\n`);
    }
    return body;
}

/// What a shader is made of. Equal keys make the same WGSL, so the compiled
/// pipelines are found by the key, compared in place of the source it would
/// take to build first.
variant ShaderKey {
    /// [`elementwise_shader`]'s arguments.
    Elementwise([Expr, List<i32>, i32]),
    /// [`row_shader`]'s arguments.
    Rows([Expr, List<i32>, i32, i32, bool]),
    /// [`copy_shader`]'s argument.
    Copy(i32),
    /// [`product_shader`]'s arguments.
    Product([Expr, List<i32>, i32, bool, bool]),
    /// [`narrow_product_shader`]'s arguments.
    NarrowProduct([Expr, List<i32>, i32, bool, bool, i32, i32, bool, Option<Staged>]),
    /// [`gather_shader`]'s arguments.
    Gather([i32, i32, bool]),
    /// [`append_shader`]'s arguments.
    Append([List<i32>, bool, i32, Option<HalfFloat>]),
    /// [`attend_shader`]'s arguments.
    Attend([List<i32>, i32, bool, bool, i32, i32, Option<HalfFloat>]),
    /// [`attend_join_shader`]'s arguments.
    AttendJoin([List<i32>, bool, Option<HalfFloat>]),
    /// [`arg_max_shader`]'s arguments.
    ArgMax([List<i32>, i32, ArgMaxStage]),
    /// [`quantized_product_shader`]'s arguments.
    QuantizedProduct([Expr, List<i32>, QuantizedShape]),
    /// [`quantized_gather_shader`]'s arguments.
    QuantizedGather([List<i32>, i32, i32, bool, Option<HalfFloat>]),
}

impl ShaderKey {
    /// The name of its case.
    fn kind(&self) -> String {
        for let case of ReflectVariant::<ShaderKey>::members() {
            if case.holds(self) {
                return case.name();
            }
        }
        unreachable();
    }
}

/// A shader: what its key makes, over bindings holding `words`, the output's
/// last.
struct Shader {
    key: ShaderKey,
    words: List<Words>,
}

impl Shader {
    /// The WGSL this shader is.
    fn source(&self) -> String {
        let words = &self.words;
        let source = match &self.key {
            Elementwise([op, bindings, rank]) => elementwise_shader(op, bindings, *rank, words),
            Rows([op, bindings, rank, row_axes, reduced]) => row_shader(op, bindings, *rank, *row_axes, *reduced, words),
            Copy(rank) => copy_shader(*rank, words),
            Product([op, bindings, batch, continued, across]) => product_shader(
                op,
                bindings,
                *batch,
                *continued,
                *across,
                words,
            ),
            NarrowProduct([op, bindings, batch, continued, across, width, lanes, paired, staged]) => narrow_product_shader(
                op,
                bindings,
                *batch,
                *continued,
                *across,
                *width,
                *lanes,
                *paired,
                staged,
                words,
            ),
            Gather([rank, axis, ranked]) => {
                let mut bound = *words;
                if !*ranked {
                    bound[1] = Words::U32;
                }
                gather_shader(*rank, *axis, *ranked, &bound);
            },
            Append([bindings, rotary, batch, stored]) => append_shader(bindings, *rotary, *batch, *stored, words),
            Attend([bindings, head, rotary, biased, part, batch, stored]) => attend_shader(
                bindings,
                *head,
                *rotary,
                *biased,
                *part,
                *batch,
                *stored,
                words,
            ),
            AttendJoin([bindings, sunk, stored]) => attend_join_shader(bindings, *sunk, *stored, words),
            ArgMax([bindings, rank, stage]) => arg_max_shader(bindings, *rank, *stage, words),
            QuantizedProduct([op, bindings, shape]) => quantized_product_shader(op, bindings, shape, words),
            QuantizedGather([bindings, bits, block, zero_points, half]) => quantized_gather_shader(
                bindings,
                *bits,
                *block,
                *zero_points,
                *half,
                words,
            ),
        };
        // An `enable` directive comes before every declaration.
        let enable = if words.contains(&Words::F16) { "enable f16;\n" } else { "" };
        return `${enable}${NON_FINITE_WGSL}${source}`;
    }
}

/// The f32 of `bits`, an infinity or a NaN. A const-expression that evaluates to
/// one is a shader-creation error, and a call's result is no const-expression.
global NON_FINITE_WGSL: String = "fn non_finite(bits: u32) -> f32 {
    return bitcast<f32>(bits);
}
";

test "an infinity in a kernel is no const-expression" {
    let source = Shader {
        key: ShaderKey::Elementwise([
            constant(f32::NEG_INFINITY),
            [0],
            1,
        ]),
        words: [Words::F32, Words::F32],
    }.source();
    assert source.contains("non_finite(4286578688u)");
}

test "a shader reads and writes f16 words where the device computes in f16" {
    let source = Shader {
        key: ShaderKey::Elementwise([
            operand(0),
            [0],
            1,
        ]),
        words: [Words::F16, Words::F16],
    }.source();
    assert source.starts_with("enable f16;");
    assert source.contains("o0: array<f16>");
    assert source.contains("out: array<f16>");
}

test "a matrix packs in a half only where each value fits it" {
    let past_f16 = f32::from_bits(0x71000000);
    let past_bf16 = f32::from_bits(0x3F802000);
    let holding = |values: List<f32>| half_holding(values.len(), |i| values[i]);
    assert holding([1.0, past_f16]) matches { Some(_::BF16) };
    assert holding([1.0, past_bf16]) matches { Some(_::F16) };
    assert holding([past_f16, past_bf16]) matches { null };
    assert holding([1.0, f32::INFINITY, past_bf16]) matches { null };
}

/// The element of operand `k`, read from binding `bindings[k]`, whose view's
/// offset is at `p[at]` and strides follow, at `coords`.
fn view_wgsl(bindings: &List<i32>, k: i32, at: i32, coords: List<String>) -> String {
    return `load${bindings[k]}(u32(${view_index_wgsl(at, coords)}))`;
}

/// The index, as an i32, of the element at `coords` of the view whose offset
/// is at `p[at]` and strides follow, over the leading axes `coords` names.
fn view_index_wgsl(at: i32, coords: List<String>) -> String {
    let mut index = `bitcast<i32>(p[${at}])`;
    for let [d, c] of coords.into_iter().enumerate() {
        index.push_str(` + i32(${c}) * bitcast<i32>(p[${at + 1 + d}])`);
    }
    return index;
}

/// Lines setting `turned` to `x`, element `e` of a head whose element `c` is
/// `row(c)`, turned by row `position` of the cosine and sine tables, which
/// operands `cos` and `cos + 1` read through their views at `p[at]` and
/// `p[at + 3]`. Halves `(a, b)` become `(a cos − b sin, b cos + a sin)`, and an
/// element past both halves, or every one where `half` is 0, stays.
fn turned_wgsl(
    bindings: &List<i32>,
    cos: i32,
    at: i32,
    position: String,
    row: fn(String) -> String,
    indent: String,
) -> String {
    let cosine = |i: String| view_wgsl(bindings, cos, at, [position, i]);
    let sine = |i: String| view_wgsl(bindings, cos + 1, at + 3, [position, i]);
    return `${indent}var turned = x;
${indent}if e < half {
${indent}    turned = x * ${cosine("e")} - ${row("e + half")} * ${sine("e")};
${indent}} else if e < 2u * half {
${indent}    turned = x * ${cosine("e - half")} + ${row("e - half")} * ${sine("e - half")};
${indent}}
`;
}

/// The WGSL appending the new keys and then values of `group_query_attention`
/// to the attention cache, one invocation per element of `[2, batch, key heads,
/// new positions, head]`, each key turned where `rotary`. Parameters: the
/// count, the invocations per row, the extents `[batch, key heads, new
/// positions, head]`, the turned half's length, the view of the cache's keys,
/// where its values start, each of the `batch` rows' past length, then the
/// views of the new keys, new values, cosines and sines. A turned key rounds
/// once to the `stored` half, as the decomposition stores one.
fn append_shader(
    bindings: &List<i32>,
    rotary: bool,
    batch: i32,
    stored: Option<HalfFloat>,
    words: &List<Words>,
) -> String {
    let views = 13 + batch;
    let new_at = |k: i32, at: i32, col: String| view_wgsl(bindings, k, at, ["b", "s", col]);
    let key = if rotary {
        turned_wgsl(bindings, 2, views + 8, "t", |c| new_at(0, views, `h * d + ${c}`), "    ");
    } else {
        "    let turned = x;\n";
    };
    return `${buffers_wgsl(words)}
@compute @workgroup_size(${LANES})
fn main(@builtin(global_invocation_id) id: vec3<u32>) {
    let i = id.x + id.y * p[1];
    if i >= p[0] {
        return;
    }
    let n = p[0] / 2u;
    let r = i % n;
    let d = p[5];
    let e = r % d;
    let s = (r / d) % p[4];
    let h = (r / (d * p[4])) % p[3];
    let b = r / (d * p[4] * p[3]);
    let t = p[13u + b] + s;
    let half = p[6];
    let at = u32(${view_index_wgsl(7, ["b", "h", "t", "e"])} + select(0, bitcast<i32>(p[12]), i >= n));
    if i >= n {
        out[at] = ${new_at(1, views + 4, "h * d + e")};
        return;
    }
    let x = ${new_at(0, views, "h * d + e")};
${key}    out[at] = ${rounded_wgsl(stored, "turned")};
}
${ELEMENTWISE_OPERATORS}`;
}

/// `attend_shader`'s word of what `options` says, a bit each: causal, whether
/// the scale divides, and whether a hidden position keeps a score.
fn attention_flags(options: &Attention) -> u32 {
    let bit = |set: bool, value: u32| if set { value } else { 0 };
    return bit(options.causal, 1) | bit(options.divides, 2) | bit(options.hidden matches { Some(_) }, 4);
}

/// The WGSL attending one query row of `group_query_attention` over one part
/// of `part` positions per workgroup, for heads of `head` elements: the
/// query turned where `rotary`, its scores against each position's key scaled,
/// capped, biased where `biased` and masked, and the values they weigh. A
/// position the mask hides is skipped, or scores what `Attention::hidden` says
/// and the bias, which the softmax still reads. A part writes its weighed
/// values, its greatest score, and its weights' sum, each weight taken against
/// that score: `attend_join_shader` joins a row's parts.
/// The lanes split each position's dot, so a step over one token, whose
/// rows are few, still spreads over the device.
/// Parameters: the workgroups, the workgroups per row of the grid, the batch,
/// the new positions, the heads, the head's length, the most positions a row
/// attends, the query heads per key head, the turned half's length, the scale
/// and the cap as f32 bits, the window, `attention_flags`, a hidden position's
/// score as f32 bits, each of the `batch` rows' past length and the positions
/// it attends, then the views of the queries, the present keys and values, the
/// cosines and sines, and the bias. A turned query rounds once to the `stored`
/// half, and the scores stay f32, as the decomposition's do.
fn attend_shader(
    bindings: &List<i32>,
    head: i32,
    rotary: bool,
    biased: bool,
    part: i32,
    batch: i32,
    stored: Option<HalfFloat>,
    words: &List<Words>,
) -> String {
    let views = 14 + 2 * batch;
    let query_at = |c: String| view_wgsl(bindings, 0, views, ["b", "s", `h * d + ${c}`]);
    let turning = if rotary {
        turned_wgsl(bindings, 3, views + 14, "position", query_at, "        ");
    } else {
        "        let turned = x;\n";
    };
    let [bias, bias_at] = if rotary { [5, views + 20] } else { [3, views + 14] };
    let biasing = if biased {
        `            sc += ${view_wgsl(bindings, bias, bias_at, ["b", "h", "s", "j"])};\n`;
    } else {
        "";
    };
    let splits = LANES / part;
    assert splits * part == LANES && splits & splits - 1 == 0, "a dot's parts add in halves";
    return `${buffers_wgsl(words)}
var<workgroup> query: array<f32, ${head}>;
var<workgroup> partial: array<f32, ${LANES}>;
var<workgroup> weights: array<f32, ${part}>;

@compute @workgroup_size(${LANES})
fn main(@builtin(workgroup_id) group: vec3<u32>, @builtin(local_invocation_index) lid: u32) {
    let flat = group.x + group.y * p[1];
    if flat >= p[0] {
        return;
    }
    let parts = (p[6] + ${part - 1}u) / ${part}u;
    let row = flat / parts;
    let first = flat % parts * ${part}u;
    let seq = p[3];
    let heads = p[4];
    let d = p[5];
    let half = p[8];
    let scale = bitcast<f32>(p[9]);
    let softcap = bitcast<f32>(p[10]);
    let window = bitcast<i32>(p[11]);
    let causal = (p[12] & 1u) != 0u;
    let divides = (p[12] & 2u) != 0u;
    let scores_hidden = (p[12] & 4u) != 0u;
    let hidden = bitcast<f32>(p[13]);
    let h = row % heads;
    let s = (row / heads) % seq;
    let b = row / (heads * seq);
    let kh = h / p[7];
    let past = p[14u + 2u * b];
    let reach = p[15u + 2u * b];
    let position = past + s;
    let none = non_finite(0xff800000u);
    for (var e = lid; e < d; e += ${LANES}u) {
        let x = ${query_at("e")};
${turning}        query[e] = ${rounded_wgsl(stored, "turned")};
    }
    workgroupBarrier();
    // Adjacent lanes split one position's dot, reading adjacent elements.
    let split = lid % ${splits}u;
    let j = first + lid / ${splits}u;
    let attended = j < reach;
    let masked = (causal && j > position) || (window > 0 && i32(position) - i32(j) >= window);
    var dot = 0.0;
    if attended && !masked {
        let key = ${view_index_wgsl(views + 4, ["b", "kh", "j"])};
        let along = bitcast<i32>(p[${views + 8}]);
        for (var e = split; e < d; e += ${splits}u) {
            dot += query[e] * load${bindings[1]}(u32(key + i32(e) * along));
        }
    }
    partial[lid] = dot;
    workgroupBarrier();
    for (var w = ${splits / 2}u; w > 0u; w = w >> 1u) {
        if split < w {
            partial[lid] += partial[lid + w];
        }
        workgroupBarrier();
    }
    var sc = none;
    if split == 0u && attended && (!masked || scores_hidden) {
        sc = hidden;
        if !masked {
            sc = select(partial[lid] * scale, partial[lid] / scale, divides);
            if softcap > 0.0 {
                sc = softcap * tanh(sc / softcap);
            }
        }
${biasing}    }
    if split == 0u {
        weights[lid / ${splits}u] = sc;
    }
    workgroupBarrier();
    var most = none;
    for (var i = 0u; i < ${part}u; i++) {
        most = max(most, weights[i]);
    }
    workgroupBarrier();
    if lid < ${part}u {
        let score = weights[lid];
        weights[lid] = select(exp(score - most), 0.0, score == none);
    }
    workgroupBarrier();
    let at = flat * (d + 2u);
    // A row attending fewer positions than the most leaves its last parts
    // none to weigh.
    let count = select(0u, min(${part}u, reach - first), reach > first);
    let values = ${view_index_wgsl(views + 9, ["b", "kh", "first"])};
    let next = bitcast<i32>(p[${views + 12}]);
    let along = bitcast<i32>(p[${views + 13}]);
    for (var e = lid; e < d; e += ${LANES}u) {
        var acc = 0.0;
        let column = values + i32(e) * along;
        for (var i = 0u; i < count; i++) {
            let w = weights[i];
            if w != 0.0 {
                acc += w * load${bindings[2]}(u32(column + i32(i) * next));
            }
        }
        out[at + e] = acc;
    }
    if lid == 0u {
        var sum = 0.0;
        for (var i = 0u; i < ${part}u; i++) {
            sum += weights[i];
        }
        out[at + d] = most;
        out[at + d + 1u] = sum;
    }
}
${ELEMENTWISE_OPERATORS}`;
}

/// The WGSL joining the parts `attend_shader` wrote of each row, one row per
/// workgroup: each part's weighed values and weights' sum rescaled from its
/// greatest score to the row's, the result rounded once to the `stored` half.
/// Where `sunk`, the row's query head's sink is a score of the row's that
/// weighs no value. Parameters: the rows, the workgroups per row of the grid,
/// the parts of a row, the head's length, the heads, then the views of the
/// parts and of the sinks.
fn attend_join_shader(bindings: &List<i32>, sunk: bool, stored: Option<HalfFloat>, words: &List<Words>) -> String {
    let part = |c: String, at: String| `load${bindings[0]}(p[5] + (row * parts + ${c}) * (d + 2u) + ${at})`;
    let [sink, least, sunk_weight] = if sunk {
        [`let sink = ${view_wgsl(bindings, 1, 7, ["row % p[4]"])};\n    `, "sink", "exp(sink - most)"];
    } else {
        ["", "none", "0.0"];
    };
    return `${buffers_wgsl(words)}
@compute @workgroup_size(${LANES})
fn main(@builtin(workgroup_id) group: vec3<u32>, @builtin(local_invocation_index) lid: u32) {
    let row = group.x + group.y * p[1];
    if row >= p[0] {
        return;
    }
    let parts = p[2];
    let d = p[3];
    let none = non_finite(0xff800000u);
    ${sink}var most = ${least};
    for (var c = 0u; c < parts; c++) {
        most = max(most, ${part("c", "d")});
    }
    var all = ${sunk_weight};
    for (var c = 0u; c < parts; c++) {
        let top = ${part("c", "d")};
        all += select(exp(top - most), 0.0, top == none) * ${part("c", "d + 1u")};
    }
    for (var e = lid; e < d; e += ${LANES}u) {
        var acc = 0.0;
        for (var c = 0u; c < parts; c++) {
            let top = ${part("c", "d")};
            acc += select(exp(top - most), 0.0, top == none) * ${part("c", "e")};
        }
        out[row * d + e] = ${rounded_wgsl(stored, "acc / all")};
    }
}
${ELEMENTWISE_OPERATORS}`;
}

/// What one dispatch of [`arg_max_shader`] reduces.
enum ArgMaxStage {
    /// Each lane whole, in one workgroup.
    Whole,
    /// Each lane's parts of `ARG_MAX_PART` elements, one workgroup a part,
    /// into its greatest element and that element's index.
    Parts,
    /// Each lane's parts as `Parts` wrote them, in one workgroup.
    Combine,
}

/// The elements one workgroup of an `arg_max` reduces at most, a part of a
/// longer lane, so a vocabulary's lane spreads over the device.
global ARG_MAX_PART: i32 = 4096;

/// The WGSL writing, one workgroup per lane along the last of `rank` axes, the
/// index of the lane's first greatest element as an f32. A NaN is greatest,
/// as `Cpu`'s `>` orders it; WGSL may assume a comparison meets none, so its
/// bits say what it is. Parameters: the workgroups, the workgroups per row of
/// the grid, the lane's length, the parts of a lane, the extents, then the
/// view of the operand. A `Parts` dispatch writes each part's greatest element
/// and its index as an f32 pair, and `Combine` reads those pairs.
fn arg_max_shader(bindings: &List<i32>, rank: i32, stage: ArgMaxStage, words: &List<Words>) -> String {
    let at = 4 + rank;
    let index = index_wgsl(at, 0, rank - 1, "c", `bitcast<i32>(p[${at}])`);
    let direct = `        let x = load${bindings[0]}(u32(${index} + i32(j) * bitcast<i32>(p[${at + rank}])));
        let i = j;
`;
    let [range, read, write] = match stage {
        _::Whole => [
            `    let row = flat;
${coords_wgsl("row", 4, 0, rank - 1, "c", "    ")}    let first = 0u;
    let end = p[2];
`, direct, "        out[row] = f32(indices[0]);\n",
        ],
        _::Parts => [
            `    let row = flat / p[3];
    let first = flat % p[3] * ${ARG_MAX_PART}u;
    let end = min(p[2], first + ${ARG_MAX_PART}u);
${coords_wgsl("row", 4, 0, rank - 1, "c", "    ")}`, direct,
            "        out[2u * flat] = values[0];\n        out[2u * flat + 1u] = f32(indices[0]);\n",
        ],
        _::Combine => [
            "    let row = flat;\n    let first = 0u;\n    let end = p[3];\n",
            `        let pair = p[${at}] + 2u * (row * p[3] + j);
        let x = load${bindings[0]}(pair);
        let i = u32(load${bindings[0]}(pair + 1u));
`, "        out[row] = f32(indices[0]);\n",
        ],
    };
    return `${buffers_wgsl(words)}
var<workgroup> values: array<f32, ${LANES}>;
var<workgroup> indices: array<u32, ${LANES}>;

const NONE = 0xffffffffu;

fn is_nan(x: f32) -> bool {
    return (bitcast<u32>(x) & 0x7fffffffu) > 0x7f800000u;
}

// Whether a at i comes before b at j: greater, or equal and earlier.
fn before(a: f32, i: u32, b: f32, j: u32) -> bool {
    if i == NONE {
        return false;
    }
    if j == NONE {
        return true;
    }
    if is_nan(a) || is_nan(b) {
        return is_nan(a) && (!is_nan(b) || i < j);
    }
    return a > b || (a == b && i < j);
}

@compute @workgroup_size(${LANES})
fn main(@builtin(workgroup_id) group: vec3<u32>, @builtin(local_invocation_index) lid: u32) {
    let flat = group.x + group.y * p[1];
    if flat >= p[0] {
        return;
    }
${range}    var best = 0.0;
    var at = NONE;
    for (var j = first + lid; j < end; j += ${LANES}u) {
${read}        if before(x, i, best, at) {
            best = x;
            at = i;
        }
    }
    values[lid] = best;
    indices[lid] = at;
    workgroupBarrier();
    for (var w = ${LANES / 2}u; w > 0u; w = w >> 1u) {
        if lid < w && before(values[lid + w], indices[lid + w], values[lid], indices[lid]) {
            values[lid] = values[lid + w];
            indices[lid] = indices[lid + w];
        }
        workgroupBarrier();
    }
    if lid == 0u {
${write}    }
}
`;
}

/// The WGSL an elementwise kernel runs: `op` at each output position of a
/// rank-`rank` output, operand `k` read from binding `bindings[k]`.
/// Parameters: the count, the invocations per row of workgroups, the output's
/// extents, then each operand's offset and strides over them.
fn elementwise_shader(op: &Expr, bindings: &List<i32>, rank: i32, words: &List<Words>) -> String {
    let mut body = coords_wgsl("i", 2, 0, rank, "c", "    ");
    for let [k, binding] of bindings.into_iter().enumerate() {
        let at = 2 + rank + k * (rank + 1);
        let index = index_wgsl(at, 0, rank, "c", `bitcast<i32>(p[${at}])`);
        body.push_str(`    let x${k} = load${binding}(u32(${index}));\n`);
    }
    body.push_str(&steps_wgsl(op, op.steps.len() - 1, "    "));
    return `${buffers_wgsl(words)}
@compute @workgroup_size(${LANES})
fn main(@builtin(global_invocation_id) id: vec3<u32>) {
    let i = id.x + id.y * p[1];
    if i >= p[0] {
        return;
    }
${body}    put(i, s${op.steps.len() - 1});
}
${ELEMENTWISE_OPERATORS}`;
}

/// The WGSL a row kernel runs: one workgroup per row, a row being the last
/// `row_axes` of `rank` axes. Each `Fold` step is folded over the row by the
/// workgroup before the steps that read it, which then read it at every
/// element. Parameters: the rows, the workgroups per row of the grid, the
/// elements per row, the extents, then each operand's offset and strides.
fn row_shader(op: &Expr, bindings: &List<i32>, rank: i32, row_axes: i32, reduced: bool, words: &List<Words>) -> String {
    let lead = rank - row_axes;
    // Each operand's index at the row's start, which every element adds to.
    let mut prelude = coords_wgsl("row", 3, 0, lead, "r", "    ");
    for let [k, _] of bindings.into_iter().enumerate() {
        let at = 3 + rank + k * (rank + 1);
        prelude.push_str(`    let base${k} = ${index_wgsl(at, 0, lead, "r", `bitcast<i32>(p[${at}])`)};\n`);
    }
    // The steps at element `e` of the row, up to `last`.
    let element = |last: i32| {
        let mut code = coords_wgsl("e", 3, lead, rank, "t", "        ");
        for let [k, binding] of bindings.into_iter().enumerate() {
            let at = 3 + rank + k * (rank + 1);
            code.push_str(`        let x${k} = load${binding}(u32(${index_wgsl(at, lead, rank, "t", `base${k}`)}));\n`);
        }
        code.push_str(&steps_wgsl(op, last, "        "));
        return code;
    };
    let mut phases = "";
    let mut fold = 0;
    for let step of op.steps {
        let Fold([kind, a]) = step else {
            continue;
        };
        let value = `${element(a)}        let v = s${a};\n`;
        phases.push_str(`    {\n${fold_wgsl(kind, value, "e", "len", LANES, `folds[${fold}]`, "        ")}    }\n`);
        fold += 1;
    }
    let last = op.steps.len() - 1;
    let write = if reduced {
        `    if lid == 0u {
        let e = 0u;
${element(last)}        put(row, s${last});
    }
`;
    } else {
        `    for (var e = lid; e < len; e += ${LANES}u) {
${element(last)}        put(row * len + e, s${last});
    }
`;
    };
    return `${buffers_wgsl(words)}
var<workgroup> partial: array<f32, ${LANES}>;
var<workgroup> folds: array<f32, ${fold_slots(op)}>;

@compute @workgroup_size(${LANES})
fn main(@builtin(workgroup_id) group: vec3<u32>, @builtin(local_invocation_index) lid: u32) {
    let row = group.x + group.y * p[1];
    if row >= p[0] {
        return;
    }
    let len = p[2];
${prelude}${phases}${write}}
${ELEMENTWISE_OPERATORS}`;
}

/// The WGSL copying a view to another of one extents. Parameters: the count,
/// the invocations per row, the extents, then the source's offset and strides
/// and the destination's.
fn copy_shader(rank: i32, words: &List<Words>) -> String {
    let from = 2 + rank;
    let to = from + rank + 1;
    let source = index_wgsl(from, 0, rank, "c", `bitcast<i32>(p[${from}])`);
    return `${buffers_wgsl(words)}
@compute @workgroup_size(${LANES})
fn main(@builtin(global_invocation_id) id: vec3<u32>) {
    let i = id.x + id.y * p[1];
    if i >= p[0] {
        return;
    }
${coords_wgsl("i", 2, 0, rank, "c", "    ")}    put(u32(${index_wgsl(to, 0, rank, "c", `bitcast<i32>(p[${to}])`)}), load0(u32(${source})));
}
`;
}

/// The most rows of the input one workgroup of a quantized product sums
/// against its columns, each in a lane's register.
global QUANTIZED_ROWS: i32 = 8;

/// The columns one workgroup of a quantized product sums, each over
/// `QUANTIZED_LANES / QUANTIZED_COLUMNS` lanes, which write a row each. On
/// Gemma 3 (270M)'s `q4` products, 8 lanes a column ran its output layer 1.4
/// times as fast as 16, and its layers as fast; 8, 16 and 32 columns of 8
/// lanes ran alike.
global QUANTIZED_COLUMNS: i32 = 16;

/// The lanes of a quantized product's workgroup.
global QUANTIZED_LANES: i32 = 128;

/// The most values of a block one lane of a quantized product sums at once,
/// which bounds the inputs a workgroup stages.
global SEGMENT: i32 = 32;

/// The WGSL rounding `value` to the nearest `half`, or `value` where there is
/// none.
fn rounded_wgsl(half: Option<HalfFloat>, value: String) -> String {
    return match half {
        Some(_::F16) => `to_f16(${value})`,
        Some(_::BF16) => `to_bf16(${value})`,
        null => value,
    };
}

/// The f32 element of the operand bound at `binding`, whose view's offset is at
/// `p[at]` and whose strides follow, at `coords`.
fn view_load_wgsl(binding: i32, at: i32, coords: &List<String>) -> String {
    let mut index = `bitcast<i32>(p[${at}])`;
    for let [d, c] of coords.into_iter().enumerate() {
        index.push_str(` + i32(${c}) * bitcast<i32>(p[${at + 1 + d}])`);
    }
    return `load${binding}(u32(${index}))`;
}

/// The WGSL declaring a packed value's width, the values a byte holds, its
/// mask, the block, and `zero(n, b)`: the zero point of block `b` of row `n`,
/// from the operand bound at `binding`, whose view is at `p[at]`, or the
/// center of the values' range where there are no `zero_points`.
fn dequantizing_wgsl(bits: i32, block: i32, zero_points: bool, binding: i32, at: i32) -> String {
    let zero = if zero_points {
        `f32((u32(${view_load_wgsl(binding, at, &(["n", "b / PER"] as List<String>))}) >> ((b % PER) * BITS)) & MASK)`;
    } else {
        `${1 << bits - 1}.0`;
    };
    return `const BITS = ${bits}u;
const PER = ${8 / bits}u;
const MASK = ${(1 << bits) - 1}u;
const BLOCK = ${block}u;

fn zero(n: u32, b: u32) -> f32 {
    return ${zero};
}
`;
}

/// What a quantized product's shader is specialized to beside its epilogue:
/// the bits of a value and the values of a block, whether zero points are
/// bound, the half each weight rounds to, the most rows a workgroup sums,
/// whether the weight's columns each start a word, whether its columns pair,
/// as `quantized_product_kernel` says, and whether its last block pads past
/// the inner extent.
struct QuantizedShape {
    bits: i32,
    block: i32,
    zero_points: bool,
    half: Option<HalfFloat>,
    rows: i32,
    aligned: bool,
    paired: bool,
    padded: bool,
}

/// The WGSL of `Graph::quantized_product`, one workgroup per
/// `QUANTIZED_COLUMNS` columns of the output and `rows` of its rows. The inner
/// axis splits into segments of at most `SEGMENT` values within a block, and
/// a chunk of as many segments as a column has lanes. The workgroup stages a
/// chunk of the rows' inputs in workgroup memory, which each of its columns
/// reads, and each lane of a column dequantizes a segment of the column's
/// packed weight and adds each value times the staged inputs; the column's
/// lanes then sum. A `half` rounds each weight to it, as the decomposition
/// stores one. Each lane of a column then writes a row's element through `op`,
/// whose `operand(0)` is the sum and `operand(i)` the `i - 1`th epilogue
/// operand; where `paired`, only an even column's lanes write, with `operand(1)`
/// the odd column's sum and the epilogue's operands from `operand(2)`.
/// Parameters: the workgroups, the workgroups per row of the grid, `M`, `K`,
/// `N`, the blocks, the bytes of a block, then the views of the input
/// `[M, K]`, the packed weight, the scales, any zero points and the epilogue's
/// operands over `[M, N]`, or `[M, N / 2]` where `paired`.
fn quantized_product_shader(op: &Expr, bindings: &List<i32>, shape: &QuantizedShape, words: &List<Words>) -> String {
    let QuantizedShape { bits, block, zero_points, half, rows, aligned, paired, padded } = *shape;
    let lanes = QUANTIZED_LANES / QUANTIZED_COLUMNS;
    assert lanes >= QUANTIZED_ROWS, "a column's lanes write its rows";
    let segment = i32::min(block, SEGMENT);
    let chunk = lanes * segment;
    assert block >= 16 && block % segment == 0, "a block is a power of two of at least 16 values";
    assert rows * chunk % QUANTIZED_LANES == 0, "a chunk's values stage evenly over the lanes";
    assert 4 * rows * (chunk + QUANTIZED_LANES) <= WORKGROUP_BYTES;
    let per = 8 / bits;
    let segment_bytes = segment * bits / 8;
    // An aligned weight's column starts a word, and so does each segment: a
    // lane reads its words whole. A weight copied to bind holds a byte a word.
    let weight = bindings[1];
    let [unit, read]: [i32, fn(i32) -> String] = if aligned
        && words[weight] matches { _::Bytes }
        && segment_bytes % 4 == 0 {
        [4, |t| `o${weight}[(p[10] + n * p[11] + b * p[6] + within) / 4u + ${t}u]`];
    } else {
        [1, |t| `u32(${view_load_wgsl(weight, 10, &(["n", "b", `within + ${t}u`] as List<String>))})`];
    };
    let scale = view_load_wgsl(bindings[2], 14, &(["n", "b"] as List<String>));
    let weights = if zero_points { 4 } else { 3 };
    let zp = if zero_points { bindings[3] } else { 0 };
    // Both the staging and the sums are written out rather than looped: a WGSL
    // loop is bounded by a counter the compiler adds to every iteration. A
    // chunk is staged a segment's value at a time across the lanes, so the
    // lanes of a column read neighbouring words, not one bank: Gemma 3
    // (270M)'s `q4` output layer took 0.66 times as long as when each lane's
    // segment lay whole.
    let mut staging = "";
    for let i of 0..<rows * chunk / QUANTIZED_LANES {
        staging.push_str(`        {
            let i = lid + ${i * QUANTIZED_LANES}u;
            let r = i / ${chunk}u;
            let k = c * ${chunk}u + i % ${chunk}u;
            let at = x_at + i32(min(r, rows - 1u)) * row_stride + i32(min(k, p[3] - 1u)) * k_stride;
            let into = r * ${chunk}u + i % ${segment}u * ${lanes}u + i % ${chunk}u / ${segment}u;
            xs[into] = select(0.0, load${bindings[0]}(u32(at)), r < rows && k < p[3]);
        }
`);
    }
    // A segment reaching past the inner extent `K` pads with values the
    // product never reads: one that rounds to an infinity would make the
    // staged zero it meets a NaN, so each value past `K` weighs zero. Only a
    // `padded` weight's last block holds one, so the other segments, and every
    // segment of a weight whose blocks fill `K`, test nothing.
    let segment_sums = |past_k: bool| {
        let mut sums = "";
        for let t of 0..<segment_bytes / unit {
            sums.push_str(`                let packed${t} = ${read(t)};\n`);
            for let v of 0..<unit * per {
                let k = t * unit * per + v;
                let mut w = rounded_wgsl(half, `(f32((packed${t} >> ${v * bits}u) & MASK) - center) * scale`);
                if past_k {
                    w = `select(0.0, ${w}, start + ${k}u < p[3])`;
                }
                sums.push_str(`                {\n                    let w = ${w};\n`);
                for let r of 0..<rows {
                    sums.push_str(`                    acc[${r}] += xs[${r * chunk + k * lanes}u + lane] * w;\n`);
                }
                sums.push_str("                }\n");
            }
        }
        return sums;
    };
    let sums = if padded {
        `            let start = b * ${block}u + s % ${block / segment}u * ${segment}u;
            if start + ${segment}u <= p[3] {
${segment_sums(false)}            } else {
${segment_sums(true)}            }
`;
    } else {
        segment_sums(false);
    };
    assert !paired || QUANTIZED_COLUMNS % 2 == 0, "a pair's columns sum in one workgroup";
    // Where `paired`, the odd column's lanes follow the even one's.
    let mut epilogue = `        let x0 = sums[lane * ${QUANTIZED_LANES}u + lid - lane];\n`;
    if paired {
        epilogue.push_str(`        let x1 = sums[lane * ${QUANTIZED_LANES}u + lid - lane + ${lanes}u];\n`);
    }
    let [sums_read, column, columns] = if paired { [2, "n / 2u", "p[4] / 2u"] } else { [1, "n", "p[4]"] };
    for let i of weights..<bindings.len() {
        let at = 17 + (i - 3) * 3;
        epilogue.push_str(`        let x${i - weights + sums_read} = ${view_load_wgsl(
            bindings[i],
            at,
            &(["m", column] as List<String>),
        )};\n`);
    }
    epilogue.push_str(&steps_wgsl(op, op.steps.len() - 1, "        "));
    return `${buffers_wgsl(words)}
${dequantizing_wgsl(bits, block, zero_points, zp, 17)}
var<workgroup> sums: array<f32, ${rows * QUANTIZED_LANES}>;
var<workgroup> xs: array<f32, ${rows * chunk}>;

@compute @workgroup_size(${QUANTIZED_LANES})
fn main(@builtin(workgroup_id) group: vec3<u32>, @builtin(local_invocation_index) lid: u32) {
    let flat = group.x + group.y * p[1];
    if flat >= p[0] {
        return;
    }
    let column_groups = (p[4] + ${QUANTIZED_COLUMNS - 1}u) / ${QUANTIZED_COLUMNS}u;
    let n = flat % column_groups * ${QUANTIZED_COLUMNS}u + lid / ${lanes}u;
    let lane = lid % ${lanes}u;
    let m0 = flat / column_groups * ${rows}u;
    let rows = min(${rows}u, p[2] - m0);
    var acc: array<f32, ${rows}>;
    let row_stride = bitcast<i32>(p[8]);
    let k_stride = bitcast<i32>(p[9]);
    let x_at = bitcast<i32>(p[7]) + i32(m0) * row_stride;
    let segments = p[5] * ${block / segment}u;
    for (var c = 0u; c * ${lanes}u < segments; c++) {
${staging}        workgroupBarrier();
        let s = c * ${lanes}u + lane;
        if s < segments && n < p[4] {
            let b = s / ${block / segment}u;
            let within = s % ${block / segment}u * ${segment_bytes}u;
            let scale = ${scale};
            let center = zero(n, b);
${sums}        }
        workgroupBarrier();
    }
    for (var r = 0u; r < ${rows}u; r++) {
        sums[r * ${QUANTIZED_LANES}u + lid] = acc[r];
    }
    workgroupBarrier();
    for (var half = ${lanes / 2}u; half > 0u; half >>= 1u) {
        if lane < half {
            for (var r = 0u; r < ${rows}u; r++) {
                sums[r * ${QUANTIZED_LANES}u + lid] += sums[r * ${QUANTIZED_LANES}u + lid + half];
            }
        }
        workgroupBarrier();
    }
    if lane < rows && n < p[4]${if paired { " && n % 2u == 0u" } else { "" }} {
        let m = m0 + lane;
${epilogue}        put(m * ${columns} + ${column}, s${op.steps.len() - 1});
    }
}
${ELEMENTWISE_OPERATORS}`;
}

/// The WGSL of `Graph::quantized_gather`, one invocation per element of the
/// output: the value its row's packed bytes hold, dequantized, or zero where
/// the index, wrapped once from the end, falls outside the table, rounded to
/// any `half`. Parameters: the elements, the invocations per row of the grid,
/// the values of a row, the table's rows, then the views of the packed table,
/// the indices, the scales and any zero points.
fn quantized_gather_shader(
    bindings: &List<i32>,
    bits: i32,
    block: i32,
    zero_points: bool,
    half: Option<HalfFloat>,
    words: &List<Words>,
) -> String {
    let index = view_load_wgsl(bindings[1], 7, &(["at"] as List<String>));
    let byte = view_load_wgsl(bindings[0], 4, &(["n", "e / PER"] as List<String>));
    let scale = view_load_wgsl(bindings[2], 9, &(["n", "b"] as List<String>));
    let zp = if zero_points { bindings[3] } else { 0 };
    return `${buffers_wgsl(words)}
${dequantizing_wgsl(bits, block, zero_points, zp, 12)}
@compute @workgroup_size(${LANES})
fn main(@builtin(global_invocation_id) id: vec3<u32>) {
    let i = id.x + id.y * p[1];
    if i >= p[0] {
        return;
    }
    let at = i / p[2];
    let e = i % p[2];
    let rows = i32(p[3]);
    var row = i32(${index});
    if row < 0 {
        row += rows;
    }
    if row < 0 || row >= rows {
        put(i, 0.0);
        return;
    }
    let n = u32(row);
    let b = e / BLOCK;
    let packed = u32(${byte});
    put(i, ${rounded_wgsl(half, `(f32((packed >> (e % PER * BITS)) & MASK) - zero(n, b)) * ${scale}`)});
}
${ELEMENTWISE_OPERATORS}`;
}

/// The WGSL of a gather along `axis`, the indices' axes flattened to it.
/// Parameters: the count, the invocations per row, the output's extents, the
/// data's offset and its stride along each output axis, 0 along `axis`, its
/// stride along `axis`, the index the output's first row along `axis` reads,
/// then the output's offset and strides. A `ranked` index is an f32 a kernel
/// left, which the last parameter, the axis's last index, clamps as StableHLO
/// does; the host has clamped any other, written as a `u32`.
fn gather_shader(rank: i32, axis: i32, ranked: bool, words: &List<Words>) -> String {
    let data = 2 + rank;
    let along = data + rank + 1;
    let first = along + 1;
    let out = first + 1;
    let source = index_wgsl(data, 0, rank, "c", `bitcast<i32>(p[${data}])`);
    let index = `o1[p[${first}] + c${axis}]`;
    let picked = if ranked { `clamp(${index}, 0.0, f32(p[${out + rank + 1}]))` } else { index };
    return `${buffers_wgsl(words)}
@compute @workgroup_size(${LANES})
fn main(@builtin(global_invocation_id) id: vec3<u32>) {
    let i = id.x + id.y * p[1];
    if i >= p[0] {
        return;
    }
${coords_wgsl("i", 2, 0, rank, "c", "    ")}    let picked = i32(${picked});
    put(u32(${index_wgsl(out, 0, rank, "c", `bitcast<i32>(p[${out}])`)}), load0(u32(${source} + picked * bitcast<i32>(p[${along}]))));
}
`;
}

/// The WGSL of a batched matrix product in 16 by 16 tiles, one workgroup per
/// output tile of one batch element, `op` applied to each element of the
/// result once its sum is complete, read as `operand(0)`; its other operands
/// are read from `bindings[2..]`. Parameters: rows, inner, cols, the `batch`
/// extents, then for each matrix its offset, batch strides and its two matrix
/// strides, then each epilogue operand's offset and strides over
/// `[..batch, rows, cols]`. Where `continued`, the sums start from a partial
/// result laid out as the output is, the last binding, after whose offset the
/// parameters end. Where `across`, the right matrix is contiguous along its inner axis, so a
/// tile of it is read with neighbouring lanes along that axis.
fn product_shader(
    op: &Expr,
    bindings: &List<i32>,
    batch: i32,
    continued: bool,
    across: bool,
    words: &List<Words>,
) -> String {
    // The tile element a lane loads of the right matrix: its step of the inner
    // axis and its column, each within the tile.
    let [step, column] = if across { ["local.x", "local.y"] } else { ["local.y", "local.x"] };
    let mut start = "";
    if continued {
        start = `    if row < rows && col < cols {
        acc = ${product_partial(bindings, batch)};
    }
`;
    }
    return `${buffers_wgsl(words)}
var<workgroup> ta: array<f32, 256>;
var<workgroup> tb: array<f32, 256>;

@compute @workgroup_size(16, 16)
fn main(@builtin(workgroup_id) group: vec3<u32>, @builtin(local_invocation_id) local: vec3<u32>) {
${product_bases(batch)}    let row = group.y * 16u + local.y;
    let col = group.x * 16u + local.x;
    var acc = 0.0;
${start}    for (var t = 0u; t < (inner + 15u) / 16u; t++) {
        let ka = t * 16u + local.x;
        var va = 0.0;
        if row < rows && ka < inner {
            va = load${bindings[0]}(u32(a_base + i32(row) * a_row + i32(ka) * a_inner));
        }
        ta[local.y * 16u + local.x] = va;
        let kb = t * 16u + ${step};
        let cb = group.x * 16u + ${column};
        var vb = 0.0;
        if kb < inner && cb < cols {
            vb = ${right_wgsl(bindings, "kb", "cb")};
        }
        tb[${step} * 16u + ${column}] = vb;
        workgroupBarrier();
        for (var k = 0u; k < 16u; k++) {
            acc += ta[local.y * 16u + k] * tb[k * 16u + local.x];
        }
        workgroupBarrier();
    }
    if row < rows && col < cols {
${product_epilogue(op, bindings, batch, continued, false, 0)}    }
}
${ELEMENTWISE_OPERATORS}`;
}

/// The WGSL of [`product_shader`]'s product where it has at most `NARROW_ROWS`
/// rows, as a model's step over one token or a short prompt has: one
/// workgroup per run of columns, its lanes splitting the inner axis and their
/// sums added in workgroup memory, `NARROW` rows at a time. Where `across`,
/// the right matrix is read along its inner axis, which is where it is
/// contiguous, as a transposed weight is: a run of lanes reads one column.
/// Otherwise a run of lanes reads one row's run of columns. A workgroup
/// computes `lanes` columns, as `narrow_columns` counts them for a lane
/// reading one element. The parameters are the tiled shader's.
/// Where `width` is 2, the right matrix holds halves and each lane reads a
/// word, two elements of it: two steps of the inner axis where `across`, two
/// columns otherwise. Where `paired`, the right matrix interleaves two, and
/// each even column's lane writes through `op` what its column and the next
/// one sum, as `product_epilogue` says. Where `staged`, the left matrix is
/// what its prologue computes, block by block into workgroup memory, and
/// binding `bindings[0]` is read for nothing.
fn narrow_product_shader(
    op: &Expr,
    bindings: &List<i32>,
    batch: i32,
    continued: bool,
    across: bool,
    width: i32,
    lanes: i32,
    paired: bool,
    staged: &Option<Staged>,
    words: &List<Words>,
) -> String {
    assert width == 1 || width == 2;
    assert !paired || across && !continued && lanes % 2 == 0, "a pair's sums meet in one workgroup";
    assert !continued || staged matches { null }, "a prologue reads the whole inner axis";
    let splits = NARROW_LANES / lanes;
    assert splits * lanes == NARROW_LANES && splits & splits - 1 == 0, "the parts add in halves";
    // The columns a lane sums, and the steps of the inner axis it reads at once.
    let [lane_cols, steps] = if across { [1, width] } else { [width, 1] };
    let [col, split, stride] = if across {
        [`group.x * ${lanes}u + lid / ${splits}u`, `lid % ${splits}u`, "1u"];
    } else {
        [`group.x * ${lanes * width}u + lid % ${lanes}u * ${width}u`, `lid / ${lanes}u`, `${lanes}u`];
    };
    let [stage, staging, prologue_operands] = match staged {
        Some(s) => [
            stage_wgsl(s, bindings, batch),
            staged_wgsl(s),
            s.operands,
        ],
        null => ["", "", 0],
    };
    let lhs: fn(String) -> String = match staged {
        Some(s) => |k: String| `staged[b * ${s.inner}u + ${k}]`,
        null => |k: String| `load${bindings[0]}(u32(a_base + i32(r0 + b) * a_row + i32(${k}) * a_inner))`,
    };
    let sum = if width == 1 {
        `                let vb = ${right_wgsl(bindings, "k")};
                for (var b = 0u; b < block; b++) {
                    sums[b] += ${lhs("k")} * vb;
                }
`;
    } else {
        let pair = pair_wgsl(words[bindings[1]], bindings[1], right_index_wgsl("k"), "                ");
        if across {
            `${pair}                for (var b = 0u; b < block; b++) {
                    sums[b] += ${lhs("k")} * v0;
                    if k + 1u < inner {
                        sums[b] += ${lhs("k + 1u")} * v1;
                    }
                }
`;
        } else {
            `${pair}                for (var b = 0u; b < block; b++) {
                    let x = ${lhs("k")};
                    sums[b * 2u] += x * v0;
                    sums[b * 2u + 1u] += x * v1;
                }
`;
        }
    };
    let start = if continued { product_partial(bindings, batch) } else { "0.0" };
    // Where `across`, the next column's sum is a column's lanes further on.
    let pair_sum = if paired {
        `                        let acc_pair = partial[b * ${NARROW_LANES}u + lid + ${splits}u];\n`;
    } else {
        "";
    };
    return `${buffers_wgsl(words)}
var<workgroup> partial: array<f32, ${NARROW * lane_cols * NARROW_LANES}>;
${staging}
@compute @workgroup_size(${NARROW_LANES})
fn main(@builtin(workgroup_id) group: vec3<u32>, @builtin(local_invocation_index) lid: u32) {
${product_bases(batch)}    let col = ${col};
    let split = ${split};
    for (var r0 = 0u; r0 < rows; r0 += ${NARROW}u) {
        let block = min(rows - r0, ${NARROW}u);
${stage}        var sums = array<f32, ${NARROW * lane_cols}>();
        if col < cols {
            for (var k = split * ${steps}u; k < inner; k += ${splits * steps}u) {
${sum}            }
        }
        for (var i = 0u; i < block * ${lane_cols}u; i++) {
            partial[i * ${NARROW_LANES}u + lid] = sums[i];
        }
        workgroupBarrier();
        // Each column's parts add in halves, so the first split holds the sum.
        for (var h = ${splits / 2}u; h > 0u; h >>= 1u) {
            if split < h {
                for (var i = 0u; i < block * ${lane_cols}u; i++) {
                    partial[i * ${NARROW_LANES}u + lid] += partial[i * ${NARROW_LANES}u + lid + h * ${stride}];
                }
            }
            workgroupBarrier();
        }
        if split == 0u && col < cols${if paired { " && col % 2u == 0u" } else { "" }} {
            let first = col;
            for (var b = 0u; b < block; b++) {
                let row = r0 + b;
                for (var j = 0u; j < ${lane_cols}u; j++) {
                    let col = first + j;
                    if col < cols {
                        let acc = ${start} + partial[(b * ${lane_cols}u + j) * ${NARROW_LANES}u + lid];
${pair_sum}${product_epilogue(op, bindings, batch, continued, paired, prologue_operands)}                    }
                }
            }
        }
        // The next block's sums overwrite these.
        workgroupBarrier();
    }
}
${ELEMENTWISE_OPERATORS}`;
}

/// The elements of `rhs`, a product's right matrix, that one word read gives
/// [`narrow_product_shader`]: 2 where it is packed and each word starts at an
/// even element along the axis read contiguously, the inner one where
/// `across` and the columns otherwise, and 1 elsewhere.
fn word_width(rhs: &DeviceTensor, across: bool) -> i32 {
    let r = rhs.extents.len();
    let unit = if across { r - 2 } else { r - 1 };
    if !rhs.packed matches { Some(_::F16 | _::BF16) } || rhs.strides[unit] != 1 || rhs.offset % 2 != 0 {
        return 1;
    }
    for let d of 0..<r {
        if d != unit && rhs.strides[d] % 2 != 0 {
            return 1;
        }
    }
    return 2;
}

/// A product's right matrix at the inner index `k` and column `column`.
fn right_wgsl(bindings: &List<i32>, k: String, column: String = "col") -> String {
    return `load${bindings[1]}(${right_index_wgsl(k, column)})`;
}

/// The element index, a `u32`, of a product's right matrix at the inner index
/// `k` and column `column`.
fn right_index_wgsl(k: String, column: String = "col") -> String {
    return `u32(b_base + i32(${k}) * b_inner + i32(${column}) * b_col)`;
}

/// The columns one workgroup of [`narrow_product_shader`] computes of a
/// product of `cols` columns, whose lanes read `width` elements at once.
/// Where `across`, a column's lanes split the inner axis, so fewer columns a
/// workgroup means more workgroups and a longer sum of each column's parts:
/// the most columns that still leave `NARROW_GROUPS` workgroups, and at least
/// 4. On Gemma 3 (270M)'s layers each of 2048, 1024, 640 and 256 columns runs
/// fastest at the count this picks.
fn narrow_columns(across: bool, width: i32, cols: i32) -> i32 {
    if !across {
        return 32 * width;
    }
    let mut columns = 16;
    while columns > 4 && cols / columns < NARROW_GROUPS {
        columns /= 2;
    }
    return columns;
}

/// Lines binding a product's extents, the bases of its two matrices for the
/// batch element `group.z`, and their matrix strides.
fn product_bases(batch: i32) -> String {
    let a = 3 + batch;
    let b = a + batch + 3;
    return `    let rows = p[0];
    let inner = p[1];
    let cols = p[2];
${coords_wgsl("group.z", 3, 0, batch, "c", "    ")}    let a_base = ${index_wgsl(
        a,
        0,
        batch,
        "c",
        `bitcast<i32>(p[${a}])`,
    )};
    let b_base = ${index_wgsl(b, 0, batch, "c", `bitcast<i32>(p[${b}])`)};
    let a_row = bitcast<i32>(p[${a + batch + 1}]);
    let a_inner = bitcast<i32>(p[${a + batch + 2}]);
    let b_inner = bitcast<i32>(p[${b + batch + 1}]);
    let b_col = bitcast<i32>(p[${b + batch + 2}]);
`;
}

/// The sums a product's chunk before left at `row` and `col`.
fn product_partial(bindings: &List<i32>, batch: i32) -> String {
    let last = bindings.len() - 1;
    let at = epilogue_params(batch) + (last - 2) * (batch + 3);
    return `load${bindings[last]}(p[${at}] + group.z * rows * cols + row * cols + col)`;
}

/// Lines writing a product's element at `row` and `col` from its sum `acc`,
/// through `op` over the epilogue's operands, which the last
/// `prologue_operands` bindings are not. Where `paired`, `col` is even and
/// `acc_pair` is the next column's sum: the two are `op`'s first two
/// operands, and the element written is the pair's, at `col / 2`.
fn product_epilogue(
    op: &Expr,
    bindings: &List<i32>,
    batch: i32,
    continued: bool,
    paired: bool,
    prologue_operands: i32,
) -> String {
    let rank = batch + 2;
    let first = epilogue_params(batch);
    let read = bindings.len() - if continued { 1 } else { 0 } - prologue_operands;
    let [written, column, sums] = if paired { ["(cols / 2u)", "col / 2u", 2] } else { ["cols", "col", 1] };
    let mut out = `        let c${batch} = row;\n        let c${batch + 1} = ${column};\n`;
    for let k of 2..<read {
        let at = first + (k - 2) * (rank + 1);
        let index = index_wgsl(at, 0, rank, "c", `bitcast<i32>(p[${at}])`);
        out.push_str(`        let x${k - 2 + sums} = load${bindings[k]}(u32(${index}));\n`);
    }
    out.push_str("        let x0 = acc;\n");
    if paired {
        out.push_str("        let x1 = acc_pair;\n");
    }
    out.push_str(&steps_wgsl(op, op.steps.len() - 1, "        "));
    out.push_str(`        put(group.z * rows * ${written} + row * ${written} + ${column}, s${op.steps.len() - 1});\n`);
    return out;
}

/// Where a product's parameters for its first epilogue operand start, past
/// its extents and its two matrices' views.
fn epilogue_params(batch: i32) -> i32 {
    return 3 + batch + batch + 3 + batch + 3;
}

/// The prologue [`narrow_product_shader`] computes its left matrix with: `op`
/// over the last `operands` bindings, each read under the left matrix's
/// `[..batch, rows, inner]` after the epilogue's operands' parameters. A block
/// of at most `rows` rows is staged at a time.
struct Staged {
    op: Expr,
    operands: i32,
    rows: i32,
    inner: i32,
}

/// The workgroup memory a [`Staged`] prologue takes: its block of rows, and
/// each row's folds.
fn staged_wgsl(s: &Staged) -> String {
    return `var<workgroup> staged: array<f32, ${s.rows * s.inner}>;
var<workgroup> staged_folds: array<f32, ${s.rows * fold_slots(&s.op)}>;
`;
}

/// The workgroup memory a [`Staged`] prologue takes, in bytes.
fn staged_bytes(s: &Staged) -> i32 {
    return 4 * s.rows * (s.inner + fold_slots(&s.op));
}

/// The folds a shader keeps for each row of `op`: one at least, as a WGSL
/// array is never empty.
fn fold_slots(op: &Expr) -> i32 {
    return i32::max(op.fold_count(), 1);
}

/// Lines folding `kind` over `index` from `lid` up to `bound`, `lanes` at a
/// time, `value` being the lines that bind the value at `index` to `v`. Each
/// lane folds its part, the parts add in halves through `partial`, and lane 0
/// stores the whole to `target`.
fn fold_wgsl(
    kind: RowOp,
    value: String,
    index: String,
    bound: String,
    lanes: i32,
    target: String,
    indent: String,
) -> String {
    let [init, combine] = match kind {
        _::Sum => ["0.0", "acc + v"],
        _::Max => ["non_finite(0xff800000u)", "max(acc, v)"],
    };
    let tree = combine.replace("acc", "partial[lid]").replace("v", "partial[lid + h]");
    return `${indent}var acc = ${init};
${indent}for (var ${index} = lid; ${index} < ${bound}; ${index} += ${lanes}u) {
${value}${indent}    acc = ${combine};
${indent}}
${indent}partial[lid] = acc;
${indent}workgroupBarrier();
${indent}for (var h = ${lanes / 2}u; h > 0u; h >>= 1u) {
${indent}    if lid < h {
${indent}        partial[lid] = ${tree};
${indent}    }
${indent}    workgroupBarrier();
${indent}}
${indent}if lid == 0u {
${indent}    ${target} = partial[0];
${indent}}
${indent}workgroupBarrier();
`;
}

/// Lines computing the block of rows from `r0` of a [`Staged`] prologue into
/// `staged`: each fold along each row, then each element.
fn stage_wgsl(s: &Staged, bindings: &List<i32>, batch: i32) -> String {
    let rank = batch + 2;
    let folds = fold_slots(&s.op);
    let first_operand = bindings.len() - s.operands;
    let first_param = epilogue_params(batch) + (first_operand - 2) * (rank + 1);
    // The steps up to `last` at row `r0 + b` and inner index `k`, the row's
    // folds so far read from `staged_folds`.
    let element = |last: i32, indent: String| {
        let row_folds: List<String> = (0..<folds).into_iter().map(|f| `staged_folds[b * ${folds}u + ${f}u]`).collect();
        let mut code = `${indent}let folds = array<f32, ${folds}>(${row_folds.join(", ")});
${indent}let c${batch} = r0 + b;
${indent}let c${batch + 1} = k;
`;
        for let j of 0..<s.operands {
            let at = first_param + j * (rank + 1);
            let index = index_wgsl(at, 0, rank, "c", `bitcast<i32>(p[${at}])`);
            code.push_str(`${indent}let x${j} = load${bindings[first_operand + j]}(u32(${index}));\n`);
        }
        code.push_str(&steps_wgsl(&s.op, last, indent));
        return code;
    };
    let mut out = "";
    let mut fold = 0;
    for let step of s.op.steps {
        let Fold([kind, a]) = step else {
            continue;
        };
        let value = `${element(a, "                ")}                let v = s${a};\n`;
        let target = `staged_folds[b * ${folds}u + ${fold}u]`;
        let phase = fold_wgsl(kind, value, "k", "inner", NARROW_LANES, target, "            ");
        out.push_str(`        for (var b = 0u; b < block; b++) {\n${phase}        }\n`);
        fold += 1;
    }
    let last = s.op.steps.len() - 1;
    out.push_str(`        for (var e = lid; e < block * ${s.inner}u; e += ${NARROW_LANES}u) {
            let b = e / ${s.inner}u;
            let k = e % ${s.inner}u;
${element(last, "            ")}            staged[e] = s${last};
        }
        workgroupBarrier();
`);
    return out;
}

fn max_of(values: &List<i32>) -> i32
    contract !values.is_empty()
{
    let mut m = values[0];
    for let v of *values {
        m = i32::max(m, v);
    }
    return m;
}

fn unary_wgsl(op: UnaryOp, v: String) -> String {
    return match op {
        _::Relu => `max(${v}, 0.0)`,
        _::Sigmoid => `sigmoid_(${v})`,
        _::Tanh => `tanh(${v})`,
        _::Erf => `erf_(${v})`,
        _::Exp => `exp(${v})`,
        _::Log => `log(${v})`,
        _::Sqrt => `sqrt(${v})`,
        _::Neg => `-(${v})`,
        _::Abs => `abs(${v})`,
    };
}

fn binary_wgsl(op: BinaryOp, a: String, b: String) -> String {
    return match op {
        _::Add => `(${a} + ${b})`,
        _::Sub => `(${a} - ${b})`,
        _::Mul => `(${a} * ${b})`,
        _::Div => `(${a} / ${b})`,
        _::Pow => `pow_(${a}, ${b})`,
        _::Maximum => `maximum_(${a}, ${b})`,
        _::Minimum => `minimum_(${a}, ${b})`,
        _::Eq => `holds_(ordered_(${a}, ${b}) && ${a} == ${b})`,
        _::Ne => `holds_(!ordered_(${a}, ${b}) || ${a} != ${b})`,
        _::Lt => `holds_(ordered_(${a}, ${b}) && ${a} < ${b})`,
        _::Le => `holds_(ordered_(${a}, ${b}) && ${a} <= ${b})`,
        _::Gt => `holds_(ordered_(${a}, ${b}) && ${a} > ${b})`,
        _::Ge => `holds_(ordered_(${a}, ${b}) && ${a} >= ${b})`,
    };
}

/// The operators WGSL does not have as ONNX defines them, which every shader
/// computing an `Expr` carries.
global ELEMENTWISE_OPERATORS: String = "
fn sigmoid_(v: f32) -> f32 {
    if v >= 0.0 {
        return 1.0 / (1.0 + exp(-v));
    }
    let e = exp(v);
    return e / (1.0 + e);
}

// Abramowitz and Stegun 7.1.26, within 1.5e-7 of erf.
fn erf_(v: f32) -> f32 {
    let x = abs(v);
    let t = 1.0 / (1.0 + 0.3275911 * x);
    let poly = t * (0.254829592 + t * (-0.284496736 + t * (1.421413741 + t * (-1.453152027 + t * 1.061405429))));
    return sign(v) * (1.0 - poly * exp(-x * x));
}

// WGSL's pow is undefined below zero, where ONNX's takes an integral exponent,
// and at zero to a power not above zero, where ONNX's is 1 or infinite.
fn pow_(x: f32, y: f32) -> f32 {
    if y == 0.0 {
        return 1.0;
    }
    if x == 0.0 {
        if y < 0.0 {
            return non_finite(0x7f800000u);
        }
        return 0.0;
    }
    if x > 0.0 || y != floor(y) {
        return pow(x, y);
    }
    let magnitude = pow(-x, y);
    if (y * 0.5) == floor(y * 0.5) {
        return magnitude;
    }
    return -magnitude;
}

// WGSL lets an implementation assume no NaN, so one is told by its bits.
fn nan_(x: f32) -> bool {
    return (bitcast<u32>(x) & 0x7fffffffu) > 0x7f800000u;
}

fn ordered_(a: f32, b: f32) -> bool {
    return !nan_(a) && !nan_(b);
}

fn holds_(condition: bool) -> f32 {
    return select(0.0, 1.0, condition);
}

fn maximum_(a: f32, b: f32) -> f32 {
    if !ordered_(a, b) {
        return a + b;
    }
    return max(a, b);
}

fn minimum_(a: f32, b: f32) -> f32 {
    if !ordered_(a, b) {
        return a + b;
    }
    return min(a, b);
}

// The nearest bf16 to v, ties to even, in the integers: WGSL may compute a
// float expression at a higher precision, which would round it twice.
fn to_bf16(v: f32) -> f32 {
    let b = bitcast<u32>(v);
    if (b & 0x7f800000u) == 0x7f800000u {
        return v;
    }
    return bitcast<f32>((b + 0x7fffu + ((b >> 16u) & 1u)) & 0xffff0000u);
}

// The nearest f16 to v, ties to even. Below 2^-14 an f16 is a multiple of
// 2^-24, and above 65520 it is infinite.
fn to_f16(v: f32) -> f32 {
    let b = bitcast<u32>(v);
    let magnitude = b & 0x7fffffffu;
    if magnitude >= 0x7f800000u {
        return v;
    }
    if magnitude < 0x38800000u {
        return round(v * 16777216.0) * (1.0 / 16777216.0);
    }
    let r = (b + 0x0fffu + ((b >> 13u) & 1u)) & 0xffffe000u;
    if (r & 0x7fffffffu) >= 0x47800000u {
        return bitcast<f32>((b & 0x80000000u) | 0x7f800000u);
    }
    return bitcast<f32>(r);
}
";
