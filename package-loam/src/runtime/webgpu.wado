//! The WebGPU backend: the kernels over `wasi:webgpu`, beside `Cpu`.
//!
//! An f32 tensor lives on the device from the kernel, `upload` or `keep` that
//! writes it there until `forward` downloads it, and so does a `bool` one, as
//! 1.0 and 0.0. An `i64` tensor stays on the host, since WGSL stores none, and
//! a gather writes its indices to the device as `u32` when it runs. A weight
//! kept for products alone is held in bf16 where that loses nothing, which
//! halves what a product reads. The convolutions and `max_pool` run on the
//! CPU. See `package-loam/webgpu.md`.

use {
    Attention,
    Backend,
    BinaryOp,
    Cpu,
    Element,
    Epilogue,
    Expr,
    Paired,
    Prologue,
    Read,
    RowOp,
    Tensor,
    UnaryOp,
    Window,
    broadcast_extents,
    element_count,
    group_query_attention,
    operand,
    paired_by_parts,
    prologue_tensor,
    reduced_count,
    row_extents,
    slices_within,
} from "./tensor.wado";
use { HashMap, HashSet, TreeMap } from "core:collections";
use {
    Webgpu,
    Gpu,
    GpuAdapter,
    GpuDevice,
    GpuQueue,
    GpuCommandEncoder,
    GpuCommandBuffer,
    GpuBuffer,
    GpuBindGroupLayout,
    GpuBindGroup,
    GpuShaderModule,
    GpuComputePipeline,
    GpuComputePassEncoder,
    GpuSupportedLimits,
    RecordOptionGpuSize64,
    GpuBufferDescriptor,
    GpuBufferUsage,
    GpuBindGroupDescriptor,
    GpuBindGroupEntry,
    GpuBindingResource,
    GpuBufferBinding,
    GpuCommandEncoderDescriptor,
    GpuComputePassDescriptor,
    GpuCommandBufferDescriptor,
    GpuDeviceDescriptor,
    GpuShaderModuleDescriptor,
    GpuComputePipelineDescriptor,
    GpuProgrammableStage,
    GpuLayoutMode,
    GpuMapMode,
    GpuIndex32,
    GpuSize32,
    GpuSize64,
} from "wasi:webgpu";

/// f32 elements of a device buffer seen through a view. The element at
/// coordinates `c` is the buffer's `offset + c[0] * strides[0] + …`, so an axis
/// a tensor is broadcast along has stride 0, and a regrouping is a new view of
/// the same buffer.
pub struct DeviceTensor {
    /// The buffer's place in the backend: see `WebGpuBackend::buffer`.
    slot: i32,
    offset: i32,
    extents: List<i32>,
    strides: List<i32>,
    /// Whether the buffer holds bf16 elements, two to a word, the even one in
    /// the low half. Only a product's right operand, a gather's data and a
    /// copy's source read one so; every other kernel takes f32, which
    /// `materialized` widens it to.
    half: bool,
}

/// A tensor where the WebGPU backend holds it.
pub variant Placed<E, Axes> {
    Host(Tensor<E, Axes>),
    Device(DeviceTensor),
}

/// An operand of a fused or row kernel whose output has the axes `Axes`: a
/// view under its own extents, aligned with the output's from the end.
pub struct PlacedRead<Axes> {
    view: DeviceTensor,
}

/// A buffer the backend owns. A struct, so a list hands one out by reference,
/// which it cannot do for a resource held bare.
affine struct Slot {
    buffer: GpuBuffer,
    words: i32,
    /// Unique among the buffers the backend has made, so a cached bind group
    /// never names a buffer made in the place of the one it bound.
    id: i32,
}

/// A buffer an earlier pass retained: the slot it was made at, and its place
/// in `buffers`.
struct Carried {
    slot: i32,
    at: i32,
}

/// The positions an attention cache has written, of the `capacity` it holds.
struct Filled {
    positions: i32,
    capacity: i32,
}

/// A buffer no tensor holds, at its place in `buffers`.
struct Spare {
    at: i32,
    words: i32,
}

/// Values at places that stay theirs while they live, so a place can name
/// one, and a place a dropped value left is the next one's.
struct Places<affine T> {
    held: List<Option<T>>,
    vacant: List<i32>,
}

impl<affine T> Places<T> {
    fn new() -> Places<T> {
        return Places { held: [], vacant: [] };
    }

    /// `value`'s place.
    fn put(&mut self, value: T) -> i32 {
        let Some(at) = self.vacant.pop() else {
            self.held.push(Option::Some(value));
            return self.held.len() - 1;
        };
        self.held[at] = Option::Some(value);
        return at;
    }

    fn get(&self, at: i32) -> &T {
        let Some(value) = &self.held[at] else {
            unreachable();
        };
        return value;
    }

    fn get_mut(&mut self, at: i32) -> &mut T {
        let Some(value) = &mut self.held[at] else {
            unreachable();
        };
        return value;
    }

    /// Drops the value at `at`.
    fn remove(&mut self, at: i32) {
        self.held[at] = null;
        self.vacant.push(at);
    }
}

/// A bind group a dispatch made, which a later dispatch binding the same
/// spans to the same shader reuses.
affine struct CachedGroup {
    group: GpuBindGroup,
    key: List<i32>,
    /// The last pass a dispatch bound it in.
    used: i32,
}

/// A compiled shader, held as `Slot` holds a buffer.
affine struct Pipeline {
    compiled: GpuComputePipeline,
    layout: GpuBindGroupLayout,
}

/// The encoder recording a pass's commands until they are submitted, and the
/// one compute pass every dispatch goes into. A compute pass makes each
/// dispatch see what the ones before it wrote.
affine struct Recording {
    encoder: GpuCommandEncoder,
    pass: GpuComputePassEncoder,
}

/// The buffer the pass's dispatches read their parameters from, each at a
/// span of its own, so none is overwritten before the encoder runs.
struct Parameters {
    slot: i32,
    words: List<u32>,
    /// How many of `words` are on the device.
    written: i32,
}

/// The kernels on a WebGPU device, and on the CPU where no shader is written.
pub affine struct WebGpuBackend {
    device: GpuDevice,
    queue: GpuQueue,
    pipelines: List<Pipeline>,
    /// Each compiled shader's place in `pipelines`, by what it is made of. A
    /// `ShaderKey` has no `Hash` while its derivation is a roadmap item of WEP:
    /// HashMap.
    compiled: TreeMap<ShaderKey, i32>,
    /// The buffers `keep` wrote, which live as long as the backend.
    kept: List<Slot>,
    /// Every other buffer: of the current pass, carried into it, or spare.
    buffers: Places<Slot>,
    /// The places in `buffers` of the last pass's buffers that nothing
    /// retained, in the order it made them, for this pass to make its own
    /// of. A pass makes the buffers the one before it made, so its dispatches
    /// bind the same buffers, and find their bind groups made. `begin` drops
    /// a spare no buffer of the pass took.
    spare: List<Spare>,
    /// The places in `buffers` of the current pass's buffers, which `begin`
    /// releases.
    pass: List<i32>,
    /// The slot of `pass[0]`. Each pass numbers its buffers after the last
    /// one's, so a slot never names two buffers.
    pass_start: i32,
    /// The slots of this pass's buffers, and of those carried into it, that
    /// `retain` keeps through the next `begin`.
    retaining: HashSet<i32>,
    /// The buffers of earlier passes that the pass before this one retained.
    carried: List<Carried>,
    /// What each attention cache holds, by slot. A step appends to the cache
    /// its past is in only where that past ends at the last position written,
    /// so a branch from an earlier past never writes over what a later step
    /// reads.
    filled: HashMap<i32, Filled>,
    /// The commands recorded and not yet submitted: none, or one encoder.
    recording: List<Recording>,
    /// The dispatches recorded and not yet submitted.
    unsubmitted: i32,
    /// Each bind group made, and its place by its key: the shader's place in
    /// `pipelines`, then each span's buffer `id`, first word and words.
    groups: Places<CachedGroup>,
    group_at: HashMap<List<i32>, i32>,
    /// The passes `begin` has started.
    passes: i32,
    next_id: i32,
    /// The parameters of this pass's dispatches: none before the first.
    parameters: Option<Parameters>,
    /// The storage buffers one shader binds, less its output and parameters.
    max_operands: i32,
    /// The 32-bit words one storage binding holds.
    max_binding: i32,
    /// The 32-bit words a binding's start is a multiple of.
    alignment: i32,
    read_backs: i32,
    dispatches: i32,
    bind_groups: i32,
    cpu: Cpu,
}

/// Invocations per workgroup of every shader but the product's: a power of
/// two, as the shaders' reductions halve it.
global LANES: i32 = 64;

/// The positions one workgroup of `attend_shader` scores, a power of two
/// dividing `LANES`: the lanes split each position's dot among
/// `LANES / ATTEND_PART` of them. Fewer positions a part means more parts for
/// `attend_join_shader` to read: on Gemma 3 (270M)'s 8 tokens from a short
/// prompt, parts of 8 took 1.02 times as long as parts of 4, and parts of 2
/// 0.99 times.
global ATTEND_PART: i32 = 4;

/// The most workgroups one dispatch dimension takes, as WebGPU's default limit
/// sets it.
global MAX_GROUPS: i32 = 65535;

/// The bytes one write to the device copies at most.
global WRITE_BYTES: i32 = 16_777_216;

/// The words one buffer of dispatch parameters holds.
global PARAMETER_WORDS: i32 = 65536;

/// The dispatches recorded before they are submitted, so the device runs the
/// first while the host records the rest.
global SUBMIT_EVERY: i32 = 32;

/// The slot of a buffer not allocated yet, which `binds` reads a view of
/// before the buffer exists. No buffer is ever at it.
global PENDING: i32 = i32::MAX;

/// The side of a matrix product's tile, which `product_shader` spells as `16u`.
global TILE: i32 = 16;

/// The rows `narrow_product_shader` sums at once, a block of them per pass
/// over the inner axis.
global NARROW: i32 = 4;

/// The most rows a product runs `narrow_product_shader` for. A tile of 16
/// rows leaves 15 of 16 lanes idle on a model's step over one token. The
/// narrow product's time grows with its rows and the tiled one's does not:
/// on GPT-2 (124M)'s layers on an RTX 4060 Ti the two meet at about 7.
global NARROW_ROWS: i32 = 6;

/// The invocations of one workgroup of `narrow_product_shader`.
global NARROW_LANES: i32 = 256;

/// The bytes of workgroup memory one shader declares at most, as WebGPU's
/// default limit sets it, which the device keeps.
global WORKGROUP_BYTES: i32 = 16384;

/// The workgroups `narrow_columns` keeps a product across a transposed weight
/// at: four for each of an RTX 4060 Ti's 34 multiprocessors, below which the
/// device waits on too few reads at once.
global NARROW_GROUPS: i32 = 128;

/// The longest attention head `attend_shader` holds a query of in workgroup
/// memory.
global MAX_HEAD: i32 = 1024;

impl WebGpuBackend {
    /// The backend on the first adapter the host offers, or `None` where it
    /// offers none. The device takes the adapter's own limits, since a model's
    /// embedding outgrows WebGPU's default binding of 128 MiB.
    pub fn new() -> Option<WebGpuBackend> with (Webgpu, Gpu, GpuAdapter, GpuDevice, GpuSupportedLimits, RecordOptionGpuSize64) {
        let gpu = Webgpu::get_gpu();
        let Some(adapter) = gpu.request_adapter(null).wait() else {
            return null;
        };
        let offered = adapter.limits();
        let required = RecordOptionGpuSize64::new();
        required.add(
            "maxStorageBufferBindingSize",
            Option::Some(offered.max_storage_buffer_binding_size() as GpuSize64),
        );
        required.add("maxBufferSize", Option::Some(offered.max_buffer_size() as GpuSize64));
        required.add(
            "maxStorageBuffersPerShaderStage",
            Option::Some(offered.max_storage_buffers_per_shader_stage() as u64 as GpuSize64),
        );
        required.add(
            "minStorageBufferOffsetAlignment",
            Option::Some(offered.min_storage_buffer_offset_alignment() as u64 as GpuSize64),
        );
        let descriptor = GpuDeviceDescriptor {
            required_features: null,
            required_limits: Option::Some(required),
            default_queue: null,
            label: null,
        };
        let Ok(device) = adapter.request_device(Option::Some(descriptor)).wait() else {
            return null;
        };
        // What the device grants, which a binding must keep to.
        let limits = device.limits();
        let bytes = u64::min(limits.max_storage_buffer_binding_size(), limits.max_buffer_size()) / 4;
        let buffers = limits.max_storage_buffers_per_shader_stage();
        let alignment = limits.min_storage_buffer_offset_alignment() as i32 / 4;
        let queue = device.queue();
        return Option::Some(WebGpuBackend {
            device,
            queue,
            pipelines: [],
            compiled: TreeMap::new(),
            kept: [],
            buffers: Places::new(),
            spare: [],
            pass: [],
            pass_start: 0,
            retaining: HashSet::new(),
            carried: [],
            filled: HashMap::new(),
            recording: [],
            unsubmitted: 0,
            groups: Places::new(),
            group_at: HashMap::new(),
            passes: 0,
            next_id: 0,
            parameters: null,
            max_operands: saturated(buffers as u64) - 2,
            max_binding: saturated(bytes),
            alignment,
            read_backs: 0,
            dispatches: 0,
            bind_groups: 0,
            cpu: Cpu {},
        });
    }

    /// The device's storage buffer offset alignment, in f32 elements: where a
    /// binding may start.
    pub fn alignment(&self) -> i32 {
        return self.alignment;
    }

    /// Binds at most `words` 32-bit words to one shader, as a device with a
    /// smaller limit would: a kernel past it splits, or runs on the CPU.
    pub fn limit_binding(&mut self, words: i32)
        // TODO: call `self.alignment()` once #2369 is resolved.
        contract words >= self.alignment
    {
        self.max_binding = i32::min(self.max_binding, words);
    }

    /// The bytes of the buffers `keep` and `keep_rhs` wrote.
    pub fn kept_bytes(&self) -> u64 with GpuBuffer {
        let mut bytes: u64 = 0;
        for let s of &self.kept {
            bytes += s.buffer.size() as u64;
        }
        return bytes;
    }

    /// How many times a tensor has been read back from the device: each is a
    /// synchronization, which a pass makes only for what it returns.
    pub fn read_backs(&self) -> i32 {
        return self.read_backs;
    }

    /// How many shaders have been dispatched: the cost a pass pays per kernel
    /// at batch size 1.
    pub fn dispatches(&self) -> i32 {
        return self.dispatches;
    }

    /// How many bind groups have been made: a pass that binds what the one
    /// before it bound makes none.
    pub fn bind_groups(&self) -> i32 {
        return self.bind_groups;
    }

    /// The buffer at `slot`: a kept one where it is negative, one of the pass
    /// otherwise.
    fn buffer(&self, slot: i32) -> &GpuBuffer {
        return &self.slot(slot).buffer;
    }

    fn slot(&self, slot: i32) -> &Slot {
        if slot < 0 {
            return &self.kept[-slot - 1];
        }
        return self.buffers.get(self.place(slot));
    }

    /// The place in `buffers` of the pass's or a carried buffer.
    fn place(&self, slot: i32) -> i32 {
        if slot >= self.pass_start {
            return self.pass[slot - self.pass_start];
        }
        for let c of &self.carried {
            if c.slot == slot {
                return c.at;
            }
        }
        panic("loam: a tensor of an earlier pass is read after `begin`, and that pass did not retain it");
    }

    /// A buffer of `count` 32-bit words, and its slot: a spare of that size,
    /// or a new one. A spare's words are what its last pass left.
    fn allocated(&mut self, count: i32, kept: bool) -> i32 with (GpuDevice, GpuBuffer) {
        if kept {
            self.kept.push(self.created(count));
            return -self.kept.len();
        }
        let mut at = -1;
        for let i of 0..<self.spare.len() {
            if self.spare[i].words == count {
                at = self.spare.remove(i).at;
                break;
            }
        }
        if at < 0 {
            at = self.buffers.put(self.created(count));
        }
        self.pass.push(at);
        return self.pass_start + self.pass.len() - 1;
    }

    fn created(&mut self, count: i32) -> Slot with (GpuDevice, GpuBuffer) {
        let buffer = self.device.create_buffer(GpuBufferDescriptor {
            size: byte_size(count),
            usage: GpuBufferUsage::Storage | GpuBufferUsage::CopySrc | GpuBufferUsage::CopyDst,
            mapped_at_creation: null,
            label: null,
        });
        self.next_id += 1;
        return Slot { buffer, words: count, id: self.next_id };
    }

    /// Makes the buffer at `at` in `buffers` a spare.
    fn release(&mut self, at: i32) {
        self.spare.push(Spare { at, words: self.buffers.get(at).words });
    }

    /// A new buffer of `count` 32-bit words, `word(i)` the `i`th, and its
    /// slot. The words are encoded one write at a time, so a tensor never has
    /// a second copy whole on the host.
    fn written(&mut self, count: i32, word: fn(i32) -> u32, kept: bool) -> i32 with (GpuDevice, GpuQueue, GpuBuffer) {
        let slot = self.allocated(count, kept);
        self.write(slot, 0, count, word);
        return slot;
    }

    /// Writes the words `word(i)` for `i` in `from..<to` to the buffer at
    /// `slot`, each at its index.
    fn write(&self, slot: i32, from: i32, to: i32, word: fn(i32) -> u32) with (GpuQueue, GpuBuffer) {
        // A host bounds what one call copies, and a model's embedding is past
        // what wasmtime lets through at once.
        let per_write = WRITE_BYTES / 4;
        for let mut at = from; at < to; at += per_write {
            let end = i32::min(at + per_write, to);
            let mut bytes = ByteList::with_capacity((end - at) * 4);
            for let i of at..<end {
                let bits = word(i);
                bytes.push(bits as u8);
                bytes.push((bits >> 8) as u8);
                bytes.push((bits >> 16) as u8);
                bytes.push((bits >> 24) as u8);
            }
            let Ok(_) = self.queue.write_buffer_with_copy(
                self.buffer(slot),
                (at * 4) as u64 as GpuSize64,
                bytes,
                null,
                null,
            ) else {
                panic("loam: a host tensor did not write to the device");
            };
        }
    }

    /// The span `params` is at in the pass's parameter buffer. The words reach
    /// the device when the pass is submitted.
    fn parameter_span(&mut self, params: &List<u32>) -> Span with (GpuDevice, GpuQueue, GpuBuffer)
        contract params.len() <= PARAMETER_WORDS
    {
        let at = match &self.parameters {
            Some(p) => (p.words.len() + self.alignment - 1) / self.alignment * self.alignment,
            None => PARAMETER_WORDS,
        };
        if at + params.len() > PARAMETER_WORDS {
            self.write_parameters();
            let slot = self.allocated(PARAMETER_WORDS, false);
            self.parameters = Option::Some(Parameters { slot, words: [], written: 0 });
            return self.parameter_span(params);
        }
        let Some(p) = &mut self.parameters else {
            unreachable();
        };
        while p.words.len() < at {
            p.words.push(0);
        }
        p.words.extend(params);
        return Span { slot: p.slot, first: at, count: params.len() };
    }

    /// Writes the parameters not yet on the device.
    fn write_parameters(&mut self) with (GpuQueue, GpuBuffer) {
        let Some(p) = &mut self.parameters else {
            return;
        };
        let words = &p.words;
        self.write(p.slot, p.written, words.len(), |i| words[i]);
        p.written = words.len();
    }

    /// `t` written to a buffer of its own, as a view over its extents.
    fn placed<E: Element, Axes>(
        &mut self,
        t: &Tensor<E, Axes>,
        kept: bool,
    ) -> DeviceTensor with (GpuDevice, GpuQueue, GpuBuffer) {
        let slot = self.written(t.data.len(), |i| t.data[i].cast_to::<f32>().to_bits(), kept);
        return contiguous(slot, 0, t.extents);
    }

    /// A `[k, n]` matrix of `values`, `at(r, c)` its element at row `r` and
    /// column `c`, kept in bf16 where that loses nothing. It is kept column by
    /// column, so a product of a few rows reads each column's run along the
    /// inner axis: one workgroup lane per run of it, rather than one per
    /// column, which leaves most of a device idle where the columns are few.
    /// A matrix one binding does not hold is kept row by row instead, where a
    /// row, and a run of rows, is a span of its own: column by column, every
    /// row reaches across the whole buffer, and no gather or chunk of the
    /// inner axis would bind.
    fn kept_matrix<K, N>(
        &mut self,
        k: i32,
        n: i32,
        values: &List<f32>,
        at: fn(i32, i32) -> f32,
    ) -> Placed<f32, [K, N]> with (GpuDevice, GpuQueue, GpuBuffer) {
        let count = k * n;
        let half = held_in_bf16(values);
        let words = if half { count.div_ceil(2) } else { count };
        let by_columns = words <= self.max_binding;
        let element = |i: i32| if by_columns { at(i % k, i / k) } else { at(i / n, i % n) };
        let slot = if half {
            self.written(words, |w| {
                let low = element(2 * w).to_bits() >> 16;
                let high = if 2 * w + 1 < count { element(2 * w + 1).to_bits() & 0xFFFF_0000 } else { 0 };
                return high | low;
            }, true);
        } else {
            self.written(words, |i| element(i).to_bits(), true);
        };
        return Placed::Device(DeviceTensor {
            slot,
            offset: 0,
            extents: [k, n],
            strides: if by_columns { [1, k] } else { [n, 1] },
            half,
        });
    }

    /// `t` on the device where an f32 holds its values, and on the host
    /// otherwise.
    fn stored<E: Element, Axes>(
        &mut self,
        t: &Tensor<E, Axes>,
        kept: bool,
    ) -> Placed<E, Axes> with (GpuDevice, GpuQueue, GpuBuffer) {
        if E::exact_in_f32() {
            return Placed::Device(self.placed(t, kept));
        }
        return Placed::Host(*t);
    }

    /// `t`, which a caller found on the host.
    fn host_only<E, Axes>(&self, t: &Placed<E, Axes>) -> Tensor<E, Axes> {
        let Host(h) = t else {
            unreachable();
        };
        return *h;
    }

    /// `t` on the device: its view, or the host tensor written there for this
    /// pass.
    fn device_view<E: Element, Axes>(
        &mut self,
        t: &Placed<E, Axes>,
    ) -> DeviceTensor with (GpuDevice, GpuQueue, GpuBuffer) {
        return match t {
            Device(d) => *d,
            Host(h) => self.placed(h, false),
        };
    }

    /// `host` over an optional operand.
    fn host_of<E: Element, Axes>(
        &mut self,
        t: Option<&Placed<E, Axes>>,
    ) -> Option<Tensor<E, Axes>> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let Some(placed) = t else {
            return null;
        };
        return Option::Some(self.host(placed));
    }

    fn host<E: Element, Axes>(
        &mut self,
        t: &Placed<E, Axes>,
    ) -> Tensor<E, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        return match t {
            Host(h) => *h,
            Device(d) => {
                // A loop rather than `map` and `collect`, which allocate per
                // element: under `wado run-webgpu`'s wasmtime that runs twenty
                // times slower than under `wado run`.
                let values = self.read_back(d);
                let mut data = List::<E>::with_capacity(values.len());
                for let v of values {
                    data.push(E::from_f32(v));
                }
                Tensor { data, extents: d.extents };
            },
        };
    }

    /// `t`'s elements on the host, in row-major order. Every command recorded
    /// is submitted first, and this waits for the device to finish them.
    fn read_back(
        &mut self,
        t: &DeviceTensor,
    ) -> List<f32> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let count = element_count(&t.extents);
        if count == 0 {
            return [];
        }
        self.read_backs += 1;
        let whole = self.materialized(t);
        self.flush();
        let size = byte_size(count);
        let readback = self.device.create_buffer(GpuBufferDescriptor {
            size,
            usage: GpuBufferUsage::MapRead | GpuBufferUsage::CopyDst,
            mapped_at_creation: null,
            label: null,
        });
        let encoder = self.device.create_command_encoder(Option::Some(GpuCommandEncoderDescriptor { label: null }));
        encoder.copy_buffer_to_buffer(
            self.buffer(whole.slot),
            Option::Some((whole.offset * 4) as u64 as GpuSize64),
            &readback,
            null,
            Option::Some(size),
        );
        let commands = encoder.finish(Option::Some(GpuCommandBufferDescriptor { label: null }));
        self.queue.submit([&commands]);
        self.queue.on_submitted_work_done().wait();
        let Ok(_) = readback.map_async(GpuMapMode::Read, null, null).wait() else {
            panic("loam: a device buffer did not map for reading");
        };
        let Ok(bytes) = readback.get_mapped_range_get_with_copy(null, null) else {
            panic("loam: a mapped device buffer gave no bytes");
        };
        return List::<f32>::from_le_bytes(bytes as ByteList)[0..<count].to_list();
    }

    /// Submits every command recorded.
    fn flush(
        &mut self,
    ) with (GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBindGroup, GpuBuffer, GpuComputePassEncoder) {
        self.write_parameters();
        if let Some(r) = self.recording.pop() {
            let Recording { encoder, pass } = r;
            pass.end();
            let commands = encoder.finish(Option::Some(GpuCommandBufferDescriptor { label: null }));
            self.queue.submit([&commands]);
        }
        self.unsubmitted = 0;
    }

    /// `t` with its f32 elements in row-major order from its offset: `t`
    /// itself, or a copy.
    fn materialized(
        &mut self,
        t: &DeviceTensor,
    ) -> DeviceTensor with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        if is_contiguous(t) && !t.half {
            return *t;
        }
        let out = contiguous(self.allocated(element_count(&t.extents), false), 0, t.extents);
        self.copy(t, &out);
        return out;
    }

    /// The shader `key` makes compiled, at the place in `pipelines` it is kept.
    fn compile(&mut self, key: &ShaderKey) -> i32 with (GpuDevice, GpuShaderModule, GpuComputePipeline) {
        let module = self.device.create_shader_module(GpuShaderModuleDescriptor {
            code: key.source(),
            compilation_hints: null,
            label: null,
        });
        let pipeline = self.device.create_compute_pipeline(GpuComputePipelineDescriptor {
            compute: GpuProgrammableStage {
                module: &module,
                entry_point: Option::Some("main"),
                constants: null,
            },
            layout: GpuLayoutMode::Auto,
            label: null,
        });
        let at = self.pipelines.len();
        let layout = pipeline.get_bind_group_layout(0);
        self.pipelines.push(Pipeline { compiled: pipeline, layout });
        self.compiled[*key] = at;
        return at;
    }

    /// Records the shader `key` makes over `spans`, bound in order, then its
    /// parameters, in `groups` workgroups along each dimension.
    fn dispatch(
        &mut self,
        key: ShaderKey,
        spans: List<Span>,
        params: List<u32>,
        groups: [i32, i32, i32],
    ) with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let [x, y, z] = groups;
        if x == 0 || y == 0 || z == 0 {
            return;
        }
        self.dispatches += 1;
        let found = match self.compiled.get(key) {
            Some(at) => at,
            None => self.compile(&key),
        };
        let mut all = spans;
        all.push(self.parameter_span(&params));
        let mut bound: List<i32> = [found];
        for let s of &all {
            assert s.first % self.alignment == 0 && s.count <= self.max_binding;
            bound.push(self.slot(s.slot).id);
            bound.push(s.first);
            bound.push(s.count);
        }
        let at = match self.group_at.get(bound) {
            Some(at) => at,
            None => self.bind_group(found, &all, bound),
        };
        let cached = self.groups.get_mut(at);
        cached.used = self.passes;
        if self.recording.is_empty() {
            let encoder = self.device.create_command_encoder(Option::Some(GpuCommandEncoderDescriptor { label: null }));
            let pass = encoder.begin_compute_pass(Option::Some(GpuComputePassDescriptor {
                timestamp_writes: null,
                label: null,
            }));
            self.recording.push(Recording { encoder, pass });
        }
        let pass = &self.recording[0].pass;
        pass.set_pipeline(&self.pipelines[found].compiled);
        let Ok(_) = pass.set_bind_group(0, Option::Some(&cached.group), null, null, null) else {
            panic("loam: a kernel's buffers did not bind");
        };
        pass.dispatch_workgroups(
            x as u32 as GpuSize32,
            Option::Some(y as u32 as GpuSize32),
            Option::Some(z as u32 as GpuSize32),
        );
        self.unsubmitted += 1;
        if self.unsubmitted >= SUBMIT_EVERY {
            self.flush();
        }
    }

    /// A new bind group of `spans` to the shader at `pipeline`, cached under
    /// `key`, and its place in `groups`.
    fn bind_group(
        &mut self,
        pipeline: i32,
        spans: &List<Span>,
        key: List<i32>,
    ) -> i32 with (GpuDevice, GpuBuffer, GpuBindGroupLayout, GpuBindGroup) {
        self.bind_groups += 1;
        let mut entries: List<GpuBindGroupEntry> = [];
        for let i of 0..<spans.len() {
            let s = spans[i];
            entries.push(GpuBindGroupEntry {
                binding: i as u32 as GpuIndex32,
                resource: GpuBindingResource::GpuBufferBinding(GpuBufferBinding {
                    buffer: self.buffer(s.slot),
                    offset: Option::Some((s.first * 4) as u64 as GpuSize64),
                    size: Option::Some(byte_size(s.count)),
                }),
            });
        }
        let group = self.device.create_bind_group(GpuBindGroupDescriptor {
            layout: &self.pipelines[pipeline].layout,
            entries,
            label: null,
        });
        let at = self.groups.put(CachedGroup { group, key, used: self.passes });
        self.group_at[key] = at;
        return at;
    }

    /// `op` over `operands` into a new tensor of `extents`, or `None` where the
    /// operands outgrow what one dispatch binds. Each operand's extents align
    /// with `extents` from the end, an axis of 1 stretching.
    fn elementwise(
        &mut self,
        operands: &List<DeviceTensor>,
        extents: List<i32>,
        op: &Expr,
    ) -> Option<DeviceTensor> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder)
        contract !op.folds_rows(), all_f32(operands)
    {
        let count = element_count(&extents);
        if count > self.max_binding {
            return null;
        }
        let Some(bound) = self.bindable(operands) else {
            return null;
        };
        let out = contiguous(self.allocated(count, false), 0, extents);
        let [x, y] = grid(count);
        let mut params = element_params(count, x, &extents);
        for let o of bound.views {
            push_view(&mut params, o.offset, &stretched(&o, &extents));
        }
        let key = ShaderKey::Elementwise([*op, bound.bindings, extents.len()]);
        let mut spans = bound.spans;
        spans.push(fresh(&out));
        self.dispatch(key, spans, params, [x, y, 1]);
        return Option::Some(out);
    }

    /// `op` over `operands` row by row into a new tensor, a row being the last
    /// `row_axes` axes of `extents`, or `None` where they outgrow a dispatch.
    fn row_kernel(
        &mut self,
        operands: &List<DeviceTensor>,
        extents: List<i32>,
        op: &Expr,
        row_axes: i32,
        reduced: bool,
    ) -> Option<DeviceTensor> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder)
        contract all_f32(operands)
    {
        let rank = extents.len();
        let row = element_count(&extents[rank - row_axes..<rank].to_list());
        let rows = element_count(&extents[0..<rank - row_axes].to_list());
        // No elements leaves nothing to dispatch: `Cpu` writes what a row of
        // none reduces to, reading only the values per row.
        if rows * row == 0 || rows * row > self.max_binding {
            return null;
        }
        let Some(bound) = self.bindable(operands) else {
            return null;
        };
        let out_extents = row_extents(&extents, row_axes, reduced);
        let out = contiguous(self.allocated(element_count(&out_extents), false), 0, out_extents);
        let [x, y] = spread(rows);
        let mut params: List<u32> = [rows as u32, x as u32, row as u32];
        push_all(&mut params, &extents);
        for let o of bound.views {
            push_view(&mut params, o.offset, &stretched(&o, &extents));
        }
        let key = ShaderKey::Rows([*op, bound.bindings, rank, row_axes, reduced]);
        let mut spans = bound.spans;
        spans.push(fresh(&out));
        self.dispatch(key, spans, params, [x, y, 1]);
        return Option::Some(out);
    }

    /// The spans `operands` read and the binding each reads, or all in one
    /// pack where they are more spans than a shader binds. `None` where even
    /// the pack outgrows a binding.
    fn bindable(
        &mut self,
        operands: &List<DeviceTensor>,
    ) -> Option<Bindings> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        if let Some(bound) = self.spans_for(operands) && bound.spans.len() <= self.max_operands {
            return Option::Some(bound);
        }
        let total = packed_count(operands);
        if total > self.max_binding {
            return null;
        }
        // Each operand is copied to its own place in one buffer, in order.
        let pack = self.allocated(total, false);
        let mut views: List<DeviceTensor> = [];
        let mut at = 0;
        for let o of *operands {
            let placed = contiguous(pack, at, o.extents);
            self.copy(&o, &placed);
            views.push(placed);
            at += element_count(&o.extents);
        }
        return Option::Some(Bindings {
            spans: [fresh(&contiguous(pack, 0, [total]))],
            bindings: List::<i32>::filled(operands.len(), 0),
            views,
        });
    }

    /// Whether `bindable` binds `operands`, asked before a kernel that runs in
    /// several dispatches records the first.
    fn binds(&self, operands: &List<DeviceTensor>) -> bool {
        return self.spans_for(operands) matches { Some(b) && b.spans.len() <= self.max_operands }
            || packed_count(operands) <= self.max_binding;
    }

    /// One span for each run of `operands` in one buffer that one binding
    /// holds, so a buffer two distant views read is bound twice, and each view
    /// rebased to its span. `None` where one view alone outgrows a binding.
    fn spans_for(&self, operands: &List<DeviceTensor>) -> Option<Bindings> {
        let mut spans: List<Span> = [];
        let mut members: List<List<DeviceTensor>> = [];
        let mut bindings: List<i32> = [];
        for let o of *operands {
            let mut at = -1;
            for let b of 0..<spans.len() {
                if spans[b].slot != o.slot {
                    continue;
                }
                let mut joined = members[b];
                joined.push(o);
                if let Some(wider) = self.span_of(&joined) {
                    spans[b] = wider;
                    members[b] = joined;
                    at = b;
                    break;
                }
            }
            if at < 0 {
                let alone = [o] as List<DeviceTensor>;
                spans.push(self.span_of(&alone)?);
                members.push(alone);
                at = spans.len() - 1;
            }
            bindings.push(at);
        }
        let mut views: List<DeviceTensor> = [];
        for let [i, o] of operands.into_iter().enumerate() {
            views.push(DeviceTensor { ..*o, offset: rebased(o, &spans[bindings[i]]) });
        }
        return Option::Some(Bindings { spans, bindings, views });
    }

    /// The span one binding of `views`' buffer takes to reach every element
    /// they read, its start aligned as a binding's must be, or `None` where it
    /// outgrows a binding.
    fn span_of(&self, views: &List<DeviceTensor>) -> Option<Span> {
        let per_word = elements_per_word(&views[0]);
        let mut least = i32::MAX;
        let mut most = i32::MIN;
        for let v of *views {
            assert v.half == views[0].half, "one buffer holds one element type";
            let [first, last] = reach(&v);
            least = i32::min(least, first / per_word);
            most = i32::max(most, last / per_word);
        }
        let first = least - least % self.alignment;
        let count = most - first + 1;
        if count > self.max_binding {
            return null;
        }
        return Option::Some(Span { slot: views[0].slot, first, count });
    }

    /// Copies `from`'s elements to `to`'s place, the two of one extents, a
    /// half `from` widened: in one dispatch, or in halves along an axis where
    /// one outgrows a binding.
    fn copy(
        &mut self,
        from: &DeviceTensor,
        to: &DeviceTensor,
    ) with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder)
        contract from.extents == to.extents, !to.half
    {
        let count = element_count(&to.extents);
        if count == 0 {
            return;
        }
        if let Some(source) = self.span_of(&([*from] as List<DeviceTensor>))
            && let Some(target) = self.span_of(&([*to] as List<DeviceTensor>)) {
            let [x, y] = grid(count);
            let mut params = element_params(count, x, &to.extents);
            push_view(&mut params, rebased(from, &source), &from.strides);
            push_view(&mut params, rebased(to, &target), &to.strides);
            self.dispatch(ShaderKey::Copy([to.extents.len(), from.half]), [source, target], params, [x, y, 1]);
            return;
        }
        let axis = split_axis(&to.extents);
        let half = to.extents[axis] / 2;
        let rest = to.extents[axis] - half;
        self.copy(&sliced(from, axis, 0, half), &sliced(to, axis, 0, half));
        self.copy(&sliced(from, axis, half, rest), &sliced(to, axis, half, rest));
    }

    /// `op` over `operands`, on the device where they fit a dispatch and on
    /// the CPU otherwise.
    fn fused_on<Axes>(
        &mut self,
        operands: &List<DeviceTensor>,
        op: &Expr,
    ) -> Placed<f32, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let extents = broadcast_all(operands);
        if let Some(out) = self.elementwise(operands, extents, op) {
            return Placed::Device(out);
        }
        let held = self.held(operands);
        return Placed::Host(self.cpu.fused(self.cpu_reads::<Axes>(&held, operands), op));
    }

    /// Each operand's elements on the host, for a kernel the device cannot run.
    fn held(
        &mut self,
        operands: &List<DeviceTensor>,
    ) -> List<List<f32>> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let mut held: List<List<f32>> = [];
        for let o of *operands {
            held.push(self.read_back(&o));
        }
        return held;
    }

    fn cpu_reads<Axes>(&mut self, held: &List<List<f32>>, operands: &List<DeviceTensor>) -> List<Read<Axes>> {
        let mut reads: List<Read<Axes>> = [];
        for let [i, o] of operands.into_iter().enumerate() {
            reads.push(Read { data: &held[i], extents: o.extents });
        }
        return reads;
    }

    /// `then` applied to `computed`, which the epilogue reads as `operand(0)`.
    fn finished<Axes>(
        &mut self,
        computed: DeviceTensor,
        then: &Option<Epilogue<PlacedRead<Axes>>>,
    ) -> Placed<f32, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let Some(e) = then else {
            return Placed::Device(computed);
        };
        let mut operands = [computed] as List<DeviceTensor>;
        for let o of e.operands {
            operands.push(o.view);
        }
        return self.fused_on(&operands, &e.op);
    }

    /// The product of `a` and `b` as ONNX's `MatMul` defines it, numpy's: a
    /// rank-1 operand is a row on the left or a column on the right, whose axis
    /// the result drops, and the batch axes broadcast. `then` runs in the same
    /// dispatch where its operands fit beside the two matrices.
    fn product<A, B, Out>(
        &mut self,
        a: &Placed<f32, A>,
        b: &Placed<f32, B>,
        then: &Option<Epilogue<PlacedRead<Out>>>,
    ) -> Placed<f32, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        return self.product_kernel(a, b, then, false).unwrap();
    }

    /// [`Self::product`], or where `paired`, the products by the two matrices `b`
    /// interleaves as `Paired` says, joined by `then` as
    /// [`Backend::matmul_rhs_paired`] joins them. A paired product runs as
    /// one narrow dispatch reading `b` along its inner axis, or not at all:
    /// `None` where it cannot.
    fn product_kernel<A, B, Out>(
        &mut self,
        a: &Placed<f32, A>,
        b: &Placed<f32, B>,
        then: &Option<Epilogue<PlacedRead<Out>>>,
        paired: bool,
    ) -> Option<Placed<f32, Out>> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let av = self.device_view(a);
        let bv = self.device_view(b);
        assert !av.half, "a product reads half elements on its right only";
        let lhs = if av.extents.len() == 1 { as_row(&av) } else { av };
        let rhs = if bv.extents.len() == 1 { as_column(&bv) } else { bv };
        let ra = lhs.extents.len();
        let rb = rhs.extents.len();
        let [rows, inner, cols] = [lhs.extents[ra - 2], lhs.extents[ra - 1], rhs.extents[rb - 1]];
        assert inner == rhs.extents[rb - 2];
        let batch = broadcast_extents(&lhs.extents[0..<ra - 2].to_list(), &rhs.extents[0..<rb - 2].to_list()).unwrap();
        assert !paired || ra == av.extents.len() && rb == 2 && cols % 2 == 0, "a paired product is of matrices";
        // The columns written: one of each pair where paired.
        let written = if paired { cols / 2 } else { cols };
        // The result's extents drop the axis a rank-1 operand stands in for.
        let mut extents = batch;
        if av.extents.len() > 1 {
            extents.push(rows);
        }
        if bv.extents.len() > 1 {
            extents.push(written);
        }
        let count = element_count(&batch);
        let narrow = rows <= NARROW_ROWS;
        let across = rhs.strides[rb - 2] == 1 && rhs.strides[rb - 1] != 1;
        // The fewest columns a workgroup takes, which a wider read only raises.
        let per_group = if narrow { narrow_columns(across, 1, cols) } else { TILE };
        let fits = count <= MAX_GROUPS
            && rows.div_ceil(TILE) <= MAX_GROUPS
            && cols.div_ceil(per_group) <= MAX_GROUPS
            && count * rows * cols <= self.max_binding;
        let epilogue: List<DeviceTensor> = match then {
            Some(e) => e.operands.into_iter().map(|o| o.view).collect(),
            None => [],
        };
        let chunk = if fits { self.inner_chunk(&lhs, &rhs) } else { null };
        if paired && !(narrow && across && chunk == Option::Some(inner)) {
            return null;
        }
        let Some(chunk) = chunk else {
            return Option::Some(self.product_on_cpu(a, b, then));
        };
        let mut matrices = batch;
        matrices.push(rows);
        matrices.push(written);
        let br = batch.len();
        // What the chunk from `start` reads: the two slices, `then`'s operands
        // where it is the last, and the sums the chunk before left.
        let chunk_operands = |start: i32, partial: Option<DeviceTensor>| -> List<DeviceTensor> {
            let length = i32::min(chunk, inner - start);
            let mut operands = [
                sliced(&lhs, ra - 1, start, length),
                sliced(&rhs, rb - 2, start, length),
            ] as List<DeviceTensor>;
            if start + length >= inner {
                operands.extend(&epilogue);
            }
            if let Some(p) = partial {
                operands.push(p);
            }
            return operands;
        };
        // Every chunk binds before the first is recorded, so none is wasted.
        // The middle chunks bind as the first does, plus the partial sums.
        let last_start = (inner.div_ceil(i32::max(chunk, 1)) - 1) * chunk;
        let pending = if last_start > 0 { Option::Some(contiguous(PENDING, 0, matrices)) } else { null };
        if !self.binds(&chunk_operands(0, pending)) || !self.binds(&chunk_operands(last_start, pending)) {
            return if paired { null } else { Option::Some(self.product_on_cpu(a, b, then)) };
        }
        // Each chunk of the inner axis continues the sums the one before left,
        // tile by tile as one dispatch would add them, and the last applies
        // `then`.
        let mut partial: Option<DeviceTensor> = null;
        let mut start = 0;
        loop {
            let length = i32::min(chunk, inner - start);
            let last = start + length >= inner;
            let Some(bound) = self.bindable(&chunk_operands(start, partial)) else {
                unreachable();
            };
            let out = contiguous(self.allocated(count * rows * written, false), 0, matrices);
            let continued = partial matches { Some(_) };
            let read = bound.views.len() - if continued { 1 } else { 0 };
            let mut params = product_params(
                [rows, length, cols],
                &batch,
                &bound.views[0..<read].to_list(),
                &extents,
                &av.extents,
                &bv.extents,
            );
            if continued {
                params.push(bound.views[read].offset as u32);
            }
            let op = match then {
                Some(e) && last => e.op,
                _ => operand(0),
            };
            let half = bound.views[1].half;
            let [key, row_groups, group_columns] = if narrow {
                let width = word_width(&bound.views[1], across);
                [
                    ShaderKey::NarrowProduct(
                        [op, bound.bindings, br, continued, across, half, width, per_group, paired, null],
                    ),
                    1,
                    narrow_columns(across, width, cols),
                ];
            } else {
                [
                    ShaderKey::Product([op, bound.bindings, br, continued, half, across]),
                    rows.div_ceil(TILE),
                    TILE,
                ];
            };
            let mut spans = bound.spans;
            spans.push(fresh(&out));
            self.dispatch(key, spans, params, [cols.div_ceil(group_columns), row_groups, count]);
            if last {
                return Option::Some(Placed::Device(contiguous(out.slot, 0, extents)));
            }
            partial = Option::Some(out);
            start += length;
        }
    }

    /// [`Self::product_kernel`] of the left matrix `a` computes, by the matrix
    /// `b` as stored, as one narrow dispatch whose workgroups each compute
    /// `a` block by block into workgroup memory. `None` where it cannot run
    /// so: too many rows, an inner axis a binding or that memory cannot hold
    /// whole, or a paired product not across `b`.
    fn staged_product<A, B, Out>(
        &mut self,
        a: &Prologue<PlacedRead<A>>,
        b: &Placed<f32, B>,
        then: &Option<Epilogue<PlacedRead<Out>>>,
        paired: bool,
    ) -> Option<Placed<f32, Out>> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let prologue: List<DeviceTensor> = a.operands.into_iter().map(|o| o.view).collect();
        let space = broadcast_all(&prologue);
        let bv = self.device_view(b);
        let ra = space.len();
        assert ra >= 2 && bv.extents.len() == 2, "a prologue computes a matrix product's left matrices";
        let [rows, inner, cols] = [space[ra - 2], space[ra - 1], bv.extents[1]];
        assert inner == bv.extents[0];
        let batch = space[0..<ra - 2].to_list();
        let count = element_count(&batch);
        let across = bv.strides[0] == 1 && bv.strides[1] != 1;
        let per_group = narrow_columns(across, 1, cols);
        let staged = Staged {
            op: a.op,
            operands: prologue.len(),
            rows: i32::min(rows, NARROW),
            inner,
        };
        // A lane of a product not across `b` sums two columns of a bf16 one.
        let partial_bytes = 4 * NARROW * if across { 1 } else { 2 } * NARROW_LANES;
        if rows > NARROW_ROWS
            || paired && !across
            || count > MAX_GROUPS
            || cols.div_ceil(per_group) > MAX_GROUPS
            || count * rows * cols > self.max_binding
            || staged_bytes(&staged) + partial_bytes > WORKGROUP_BYTES {
            return null;
        }
        // The left matrix's binding stands in for the matrix the shader never
        // reads, so its views keep their places.
        let lhs = DeviceTensor { ..prologue[0], extents: space, strides: stretched(&prologue[0], &space) };
        if self.inner_chunk(&lhs, &bv) != Option::Some(inner) {
            return null;
        }
        let mut operands = [lhs, bv] as List<DeviceTensor>;
        if let Some(e) = then {
            for let o of e.operands {
                operands.push(o.view);
            }
        }
        let read = operands.len();
        operands.extend(&prologue);
        if !self.binds(&operands) {
            return null;
        }
        let Some(bound) = self.bindable(&operands) else {
            unreachable();
        };
        let written = if paired { cols / 2 } else { cols };
        let mut extents = batch;
        extents.push(rows);
        extents.push(written);
        let mut params = product_params(
            [rows, inner, cols],
            &batch,
            &bound.views[0..<read].to_list(),
            &extents,
            &space,
            &bv.extents,
        );
        for let i of read..<bound.views.len() {
            let o = &bound.views[i];
            push_view(&mut params, o.offset, &stretched(o, &space));
        }
        let op = match then {
            Some(e) => e.op,
            None => operand(0),
        };
        let width = word_width(&bound.views[1], across);
        let key = ShaderKey::NarrowProduct(
            [
                op,
                bound.bindings,
                batch.len(),
                false,
                across,
                bound.views[1].half,
                width,
                per_group,
                paired,
                Option::Some(staged),
            ],
        );
        let out = contiguous(self.allocated(count * rows * written, false), 0, extents);
        let mut spans = bound.spans;
        spans.push(fresh(&out));
        self.dispatch(key, spans, params, [cols.div_ceil(narrow_columns(across, width, cols)), 1, count]);
        return Option::Some(Placed::Device(out));
    }

    /// The longest run of whole tiles along the inner axis whose slices of
    /// `lhs` and `rhs` each fit a binding: all of it where they fit whole.
    /// `None` where not even one tile's do.
    fn inner_chunk(&self, lhs: &DeviceTensor, rhs: &DeviceTensor) -> Option<i32> {
        let ra = lhs.extents.len();
        let rb = rhs.extents.len();
        let mut chunk = lhs.extents[ra - 1];
        loop {
            let a = [sliced(lhs, ra - 1, 0, chunk)] as List<DeviceTensor>;
            let b = [sliced(rhs, rb - 2, 0, chunk)] as List<DeviceTensor>;
            if self.span_of(&a) matches { Some(_) } && self.span_of(&b) matches { Some(_) } {
                return Option::Some(chunk);
            }
            if chunk <= TILE {
                return null;
            }
            chunk = chunk.div_ceil(2).div_ceil(TILE) * TILE;
        }
    }

    fn product_on_cpu<A, B, Out>(
        &mut self,
        a: &Placed<f32, A>,
        b: &Placed<f32, B>,
        then: &Option<Epilogue<PlacedRead<Out>>>,
    ) -> Placed<f32, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let product = self.cpu.matmul_broadcast::<A, B, Out>(&self.host(a), &self.host(b), null);
        let computed = self.placed(&product, false);
        return self.finished(computed, then);
    }

    /// A gather of `data` along `axis` by `indices`, a negative one counting
    /// from the end: the result's axes are `data`'s before `axis`, the
    /// indices', then `data`'s after `axis`.
    fn gathered<Ix>(
        &mut self,
        data: &DeviceTensor,
        indices: &Tensor<i64, Ix>,
        axis: i32,
    ) -> Option<DeviceTensor> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let along = data.extents[axis];
        let mut words = List::<u32>::with_capacity(indices.data.len());
        for let i of indices.data {
            let at = if i < 0 { i + along as i64 } else { i };
            assert 0 <= at < along as i64, "loam: a gather index is past its axis";
            words.push(at as u32);
        }
        // The output, its index axes as one, row by row of `words`.
        let mut flat = data.extents;
        flat[axis] = words.len();
        // Halving the indices ends at one row, so the gather runs on the
        // device exactly where one row of the data and of the output binds.
        let row_binds = |view: DeviceTensor| self.span_of(&([sliced(&view, axis, 0, 1)] as List<DeviceTensor>)) matches { Some(_) };
        if words.len() > self.max_binding || !row_binds(*data) || !row_binds(contiguous(PENDING, 0, flat)) {
            return null;
        }
        let index_slot = self.written(words.len(), |i| words[i], false);
        let out = contiguous(self.allocated(element_count(&flat), false), 0, flat);
        self.gathered_part(data, &words, index_slot, axis, &out, 0, words.len());
        let mut extents = data.extents[0..<axis].to_list();
        extents.extend(&indices.extents);
        extents.extend(&data.extents[axis + 1..<data.extents.len()].to_list());
        return Option::Some(contiguous(out.slot, 0, extents));
    }

    /// Writes `out`'s rows `lo..<hi` along `axis`, the data's rows `words`
    /// picks there: in one dispatch, or in halves where the data's rows they
    /// pick outgrow a binding.
    fn gathered_part(
        &mut self,
        data: &DeviceTensor,
        words: &List<u32>,
        index_slot: i32,
        axis: i32,
        out: &DeviceTensor,
        lo: i32,
        hi: i32,
    ) with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let part = sliced(out, axis, lo, hi - lo);
        let count = element_count(&part.extents);
        if count == 0 {
            return;
        }
        let mut least = words[lo] as i32;
        let mut most = least;
        for let i of lo..<hi {
            least = i32::min(least, words[i] as i32);
            most = i32::max(most, words[i] as i32);
        }
        let picked = sliced(data, axis, least, most - least + 1);
        if let Some(source) = self.span_of(&([picked] as List<DeviceTensor>))
            && let Some(target) = self.span_of(&([part] as List<DeviceTensor>)) {
            let [x, y] = grid(count);
            let mut params = element_params(count, x, &part.extents);
            let mut across = data.strides;
            across[axis] = 0;
            push_view(&mut params, rebased(data, &source), &across);
            push_signed(&mut params, data.strides[axis]);
            params.push(lo as u32);
            push_view(&mut params, rebased(&part, &target), &part.strides);
            let indices = Span { slot: index_slot, first: 0, count: words.len() };
            self.dispatch(
                ShaderKey::Gather([part.extents.len(), axis, data.half]),
                [source, indices, target],
                params,
                [x, y, 1],
            );
            return;
        }
        // `gathered` checked that one row binds.
        assert hi - lo > 1;
        let mid = lo + (hi - lo) / 2;
        self.gathered_part(data, words, index_slot, axis, out, lo, mid);
        self.gathered_part(data, words, index_slot, axis, out, mid, hi);
    }

    /// `t` folded along `axes` by the row kernel, those axes kept at extent 1.
    fn reduced(
        &mut self,
        t: &DeviceTensor,
        axes: &List<i32>,
        op: &Expr,
    ) -> Option<DeviceTensor> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let perm = moved_last(t.extents.len(), axes);
        let moved = permuted(t, &perm);
        let out = self.row_kernel(&([moved] as List<DeviceTensor>), moved.extents, op, axes.len(), true)?;
        return Option::Some(permuted(&out, &inverse(&perm)));
    }

    /// `group_query_attention` in three dispatches: one appends the new keys,
    /// turned, and values to the attention cache, one attends each
    /// query row over each part of `ATTEND_PART` positions in a workgroup of
    /// its own, and one joins each row's parts. `rotary` is the cosine and sine
    /// tables. `None` where the operands outgrow what a dispatch binds.
    fn attended(
        &mut self,
        q: &DeviceTensor,
        k: &DeviceTensor,
        v: &DeviceTensor,
        past_k: &DeviceTensor,
        past_v: &DeviceTensor,
        rotary: &Option<[DeviceTensor, DeviceTensor]>,
        bias: &Option<DeviceTensor>,
        options: &Attention,
    ) -> Option<[DeviceTensor, DeviceTensor, DeviceTensor]> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let [batch, s, past, d] = [q.extents[0], q.extents[1], past_k.extents[2], past_k.extents[3]];
        let [heads, kv] = [options.heads, options.kv_heads];
        let total = past + s;
        let rows = batch * s * heads;
        let capacity = self.cache_capacity(batch * kv * d, total);
        let n = batch * kv * capacity * d;
        let groups = rows * total.div_ceil(ATTEND_PART);
        // The parts are held for every position the cache holds, as its
        // views are, so their bindings too stay those of the step before.
        let attended = rows * capacity.div_ceil(ATTEND_PART) * (d + 2);
        if 2 * n > self.max_binding || attended > self.max_binding || d > MAX_HEAD {
            return null;
        }
        let half = match rotary {
            Some([c, _]) => c.extents[1],
            None => 0,
        };
        let held = [batch, kv, capacity, d] as List<i32>;
        let strides = row_major(&held);
        let mut tables: List<DeviceTensor> = [];
        if let Some([c, sn]) = rotary {
            tables = [*c, *sn];
        }
        let mut append_operands = [*k, *v] as List<DeviceTensor>;
        append_operands.extend(&tables);
        // The cache's views before its buffer is known, for `binds`. The
        // attention reads them over every position the cache holds, so its
        // bindings stay those of the step before while the cache fills.
        let mut attend_operands: List<DeviceTensor> = [
            *q,
            contiguous(PENDING, 0, held),
            contiguous(PENDING, n, held),
        ];
        attend_operands.extend(&tables);
        if let Some(b) = bias {
            let over = [batch, heads, s, total] as List<i32>;
            attend_operands.push(DeviceTensor { ..*b, strides: stretched(b, &over), extents: over });
        }
        if !self.binds(&append_operands) || !self.binds(&attend_operands) {
            return null;
        }

        let cache = match self.appendable(past_k, past_v, capacity, n, &strides, past) {
            Some(slot) => slot,
            None => {
                let slot = self.allocated(2 * n, false);
                self.copy(past_k, &DeviceTensor { slot, offset: 0, extents: past_k.extents, strides, half: false });
                self.copy(past_v, &DeviceTensor { slot, offset: n, extents: past_v.extents, strides, half: false });
                slot;
            },
        };
        self.filled[cache] = Filled { positions: total, capacity };
        let appended = batch * kv * s * d;
        let [x, y] = grid(2 * appended);
        let mut append_head = element_params(2 * appended, x, &([batch, kv, s, d] as List<i32>));
        push_all(&mut append_head, &([past, half] as List<i32>));
        push_view(&mut append_head, 0, &strides);
        append_head.push(n as u32);
        self.dispatch_bound(&append_operands, cache, 2 * n, append_head, |bindings| ShaderKey::Append([
            bindings, half > 0,
        ]), [x, y, 1]);

        let present_k = DeviceTensor {
            slot: cache,
            offset: 0,
            extents: [batch, kv, total, d],
            strides,
            half: false,
        };
        let present_v = DeviceTensor { ..present_k, offset: n };
        attend_operands[1] = DeviceTensor { ..present_k, extents: held };
        attend_operands[2] = DeviceTensor { ..present_v, extents: held };
        let parts = self.allocated(attended, false);
        let [gx, gy] = spread(groups);
        let mut attend_head: List<u32> = [];
        push_all(&mut attend_head, &([groups, gx, batch, s, heads, d, total, past, heads / kv, half] as List<i32>));
        attend_head.push(options.scale.to_bits());
        attend_head.push(options.softcap.to_bits());
        push_signed(&mut attend_head, options.window);
        attend_head.push(if options.causal { 1 } else { 0 });
        let biased = bias matches { Some(_) };
        self.dispatch_bound(&attend_operands, parts, attended, attend_head, |bindings| ShaderKey::Attend([
            bindings, d, half > 0, biased,
        ]), [gx, gy, 1]);

        let out = self.allocated(rows * d, false);
        let [rx, ry] = spread(rows);
        let joined = [contiguous(parts, 0, [attended])] as List<DeviceTensor>;
        let join_head: List<u32> = [rows as u32, rx as u32, total.div_ceil(ATTEND_PART) as u32, d as u32];
        self.dispatch_bound(&joined, out, rows * d, join_head, |bindings| ShaderKey::AttendJoin(bindings), [rx, ry, 1]);
        return Option::Some([contiguous(out, 0, [batch, s, heads * d]), present_k, present_v]);
    }

    /// The positions an attention cache holds once it holds `total`: a power
    /// of two, at least `LANES`, so a step appends where the one before left
    /// room. Exactly `total` where that outgrows a binding, and every step
    /// then moves the cache.
    fn cache_capacity(&self, per_position: i32, total: i32) -> i32 {
        let mut capacity = LANES;
        while capacity < total {
            capacity *= 2;
        }
        if 2 * per_position as i64 * capacity as i64 > self.max_binding as i64 {
            return total;
        }
        return capacity;
    }

    /// The cache `past_k` and `past_v` are in where a step appends to it in
    /// place: one of `capacity` positions, their keys at its start and their
    /// values `values` after, laid out by `strides`, and nothing written past
    /// their `past` positions.
    fn appendable(
        &self,
        past_k: &DeviceTensor,
        past_v: &DeviceTensor,
        capacity: i32,
        values: i32,
        strides: &List<i32>,
        past: i32,
    ) -> Option<i32> {
        let slot = past_k.slot;
        let Some(cache) = self.filled.get(slot) else {
            return null;
        };
        let laid_out = past_v.slot == slot && reads_as(past_k, 0, strides) && reads_as(past_v, values, strides);
        if laid_out && cache.positions == past && cache.capacity == capacity {
            return Option::Some(slot);
        }
        return null;
    }

    /// Records the shader `shader` makes of the bindings `operands` take, as
    /// `bindable` binds them, writing the `count` elements of the buffer at
    /// `out`. Its parameters are `head`, then each operand's offset and
    /// strides.
    fn dispatch_bound(
        &mut self,
        operands: &List<DeviceTensor>,
        out: i32,
        count: i32,
        head: List<u32>,
        shader: fn(List<i32>) -> ShaderKey,
        groups: [i32, i32, i32],
    ) with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder)
        contract all_f32(operands)
    {
        let Some(bound) = self.bindable(operands) else {
            panic("loam: a kernel's operands do not bind, which `binds` said they would");
        };
        let mut params = head;
        for let o of bound.views {
            push_view(&mut params, o.offset, &o.strides);
        }
        let mut spans = bound.spans;
        spans.push(Span { slot: out, first: 0, count });
        self.dispatch(shader(bound.bindings), spans, params, groups);
    }
}

impl Backend for WebGpuBackend {
    type Tensor<E: Element, Axes> = Placed<E, Axes>;
    type Operand<Axes> = PlacedRead<Axes>;
    /// A matrix kept column by column where one binding holds it, of bf16
    /// elements where those hold every value: see `kept_matrix`.
    type Rhs<K, N> = Placed<f32, [K, N]>;

    fn upload<E: Element, Axes>(&mut self, t: &Tensor<E, Axes>) -> Placed<E, Axes> with (GpuDevice, GpuQueue, GpuBuffer) {
        return self.stored(t, false);
    }

    /// A kept mask is written once, and each pass reads it where it is.
    fn keep<E: Element, Axes>(&mut self, t: &Tensor<E, Axes>) -> Placed<E, Axes> with (GpuDevice, GpuQueue, GpuBuffer) {
        return self.stored(t, true);
    }

    fn keep_rhs<K, N>(&mut self, t: &Tensor<f32, [K, N]>) -> Placed<f32, [K, N]> with (GpuDevice, GpuQueue, GpuBuffer) {
        let [k, n] = [t.extents[0], t.extents[1]];
        let data = &t.data;
        return self.kept_matrix(k, n, data, |r, c| data[r * n + c]);
    }

    fn keep_rhs_transposed<K, N>(
        &mut self,
        t: &Tensor<f32, [N, K]>,
    ) -> Placed<f32, [K, N]> with (GpuDevice, GpuQueue, GpuBuffer) {
        let k = t.extents[1];
        let data = &t.data;
        return self.kept_matrix(k, t.extents[0], data, |r, c| data[c * k + r]);
    }

    /// Submits what the pass before recorded and releases its buffers, so a
    /// tensor of that pass is no longer one to read, but for those it
    /// retained, which live through this pass. A spare it did not take, and
    /// a bind group it did not bind, are dropped.
    fn begin(&mut self) with (GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBindGroup, GpuBuffer) {
        self.flush();
        self.parameters = null;
        while let Some(s) = self.spare.pop() {
            self.buffers.remove(s.at);
        }
        let mut carried: List<Carried> = [];
        let start = self.pass_start;
        self.pass_start += self.pass.len();
        for let i of 0..<self.pass.len() {
            if self.retaining.contains(start + i) {
                carried.push(Carried { slot: start + i, at: self.pass[i] });
            } else {
                self.release(self.pass[i]);
            }
        }
        self.pass = [];
        for let c of self.carried {
            if self.retaining.contains(c.slot) {
                carried.push(c);
            } else {
                self.release(c.at);
            }
        }
        let mut filled: HashMap<i32, Filled> = HashMap::new();
        for let c of &carried {
            if let Some(cache) = self.filled.get(c.slot) {
                filled[c.slot] = cache;
            }
        }
        self.filled = filled;
        self.carried = carried;
        self.retaining = HashSet::new();
        for let at of 0..<self.groups.held.len() {
            if let Some(g) = &self.groups.held[at] && g.used < self.passes {
                self.group_at.remove(g.key);
                self.groups.remove(at);
            }
        }
        self.passes += 1;
    }

    fn retain<E: Element, Axes>(&mut self, t: &Placed<E, Axes>) {
        if let Device(d) = t && d.slot >= 0 {
            self.retaining.insert(d.slot);
        }
    }

    fn extents_of<E: Element, Axes>(&self, t: &Placed<E, Axes>) -> List<i32> {
        return match t {
            Host(h) => h.extents,
            Device(d) => d.extents,
        };
    }

    fn download<E: Element, Axes>(
        &mut self,
        t: &Placed<E, Axes>,
    ) -> Tensor<E, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        return self.host(t);
    }

    fn filled<E: Element, Axes>(&mut self, extents: List<i32>, value: E) -> Placed<E, Axes> {
        return Placed::Host(self.cpu.filled(extents, value));
    }

    fn range_i64<A>(&mut self, start: i64, count: i32, delta: i64) -> Placed<i64, [A]> {
        return Placed::Host(self.cpu.range_i64(start, count, delta));
    }

    fn read<Axes>(&mut self, t: &Placed<f32, Axes>) -> PlacedRead<Axes> with (GpuDevice, GpuQueue, GpuBuffer) {
        return PlacedRead { view: self.device_view(t) };
    }

    fn read_suffix<..Pre, ..Suf>(
        &mut self,
        t: &Placed<f32, [..Suf]>,
    ) -> PlacedRead<[..Pre, ..Suf]> with (GpuDevice, GpuQueue, GpuBuffer) {
        return PlacedRead { view: self.device_view(t) };
    }

    fn read_at<..Pre, ..Mid, ..Post>(
        &mut self,
        t: &Placed<f32, [..Mid]>,
        trailing: i32,
    ) -> PlacedRead<[..Pre, ..Mid, ..Post]> with (GpuDevice, GpuQueue, GpuBuffer) {
        let mut view = self.device_view(t);
        for let _ of 0..<trailing {
            view.extents.push(1);
            view.strides.push(0);
        }
        return PlacedRead { view };
    }

    fn read_condition<Axes>(&mut self, t: &Placed<bool, Axes>) -> PlacedRead<Axes> with (GpuDevice, GpuQueue, GpuBuffer) {
        return PlacedRead { view: self.device_view(t) };
    }

    fn fused<Axes>(
        &mut self,
        operands: List<PlacedRead<Axes>>,
        op: &Expr,
    ) -> Placed<f32, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        return self.fused_on(&operand_views(&operands), op);
    }

    fn rows<In, Out>(
        &mut self,
        operands: List<PlacedRead<In>>,
        op: &Expr,
        row_axes: i32,
        reduced: bool,
    ) -> Placed<f32, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let all = operand_views(&operands);
        if let Some(out) = self.row_kernel(&all, broadcast_all(&all), op, row_axes, reduced) {
            return Placed::Device(out);
        }
        let held = self.held(&all);
        return Placed::Host(self.cpu.rows::<In, Out>(self.cpu_reads::<In>(&held, &all), op, row_axes, reduced));
    }

    fn cast<A: Element, B: Element, Axes>(
        &mut self,
        t: &Placed<A, Axes>,
    ) -> Placed<B, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        // A device holds a bool as the f32 it casts to.
        if A::exact_in_f32() && B::is_f32() && let Device(d) = t {
            return Placed::Device(*d);
        }
        return Placed::Host(self.cpu.cast::<A, B, Axes>(&self.host(t)));
    }

    fn select<E: Element, Axes>(
        &mut self,
        cond: &Placed<bool, Axes>,
        x: &Placed<E, Axes>,
        y: &Placed<E, Axes>,
    ) -> Placed<E, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        if !E::is_f32() {
            return Placed::Host(self.cpu.select(&self.host(cond), &self.host(x), &self.host(y)));
        }
        let operands = [
            self.device_view(cond),
            self.device_view(x),
            self.device_view(y),
        ] as List<DeviceTensor>;
        let picked = self.fused_on::<Axes>(&operands, &operand(0).select(&operand(1), &operand(2)));
        return match picked {
            Device(d) => Placed::Device(d),
            Host(h) => Placed::Host(self.cpu.cast::<f32, E, Axes>(&h)),
        };
    }

    fn matmul<..Bs, M, K, N>(
        &mut self,
        a: &Placed<f32, [..Bs, M, K]>,
        b: &Placed<f32, [..Bs, K, N]>,
        then: Option<Epilogue<PlacedRead<[..Bs, M, N]>>>,
    ) -> Placed<f32, [..Bs, M, N]> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        return self.product::<[..Bs, M, K], [..Bs, K, N], [..Bs, M, N]>(a, b, &then);
    }

    fn matmul_shared<..Bs, M, K, N>(
        &mut self,
        a: &Placed<f32, [..Bs, M, K]>,
        b: &Placed<f32, [K, N]>,
        then: Option<Epilogue<PlacedRead<[..Bs, M, N]>>>,
    ) -> Placed<f32, [..Bs, M, N]> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        return self.product::<[..Bs, M, K], [K, N], [..Bs, M, N]>(a, b, &then);
    }

    /// The product over the transpose as a view, which strides say.
    fn matmul_by_transposed<..Bs, M, K, N>(
        &mut self,
        a: &Placed<f32, [..Bs, M, K]>,
        b: &Placed<f32, [N, K]>,
        then: Option<Epilogue<PlacedRead<[..Bs, M, N]>>>,
    ) -> Placed<f32, [..Bs, M, N]> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let transposed = self.transpose2(b);
        return self.product::<[..Bs, M, K], [K, N], [..Bs, M, N]>(a, &transposed, &then);
    }

    fn matmul_by_rhs_transposed<..Bs, M, K, N>(
        &mut self,
        a: &Placed<f32, [..Bs, M, K]>,
        b: &Placed<f32, [N, K]>,
        then: Option<Epilogue<PlacedRead<[..Bs, M, N]>>>,
    ) -> Placed<f32, [..Bs, M, N]> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        return self.matmul_by_transposed(a, b, then);
    }

    fn gather_rhs_rows<Row, Col, ..Ix>(
        &mut self,
        rows: &Placed<f32, [Row, Col]>,
        indices: &Placed<i64, [..Ix]>,
    ) -> Placed<f32, [..Ix, Col]> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        return self.gather_rows::<f32, Row, [Col], [..Ix]>(rows, indices);
    }

    fn matmul_broadcast<A, B, Out>(
        &mut self,
        a: &Placed<f32, A>,
        b: &Placed<f32, B>,
        then: Option<Epilogue<PlacedRead<Out>>>,
    ) -> Placed<f32, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        return self.product::<A, B, Out>(a, b, &then);
    }

    fn matmul_rhs<..Bs, M, K, N>(
        &mut self,
        a: &Placed<f32, [..Bs, M, K]>,
        b: &Placed<f32, [K, N]>,
        then: Option<Epilogue<PlacedRead<[..Bs, M, N]>>>,
    ) -> Placed<f32, [..Bs, M, N]> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        return self.matmul_shared(a, b, then);
    }

    fn matmul_rhs_paired<..Bs, M, K, N>(
        &mut self,
        a: &Placed<f32, [..Bs, M, K]>,
        bc: &Placed<f32, [K, Paired<N>]>,
        then: Epilogue<PlacedRead<[..Bs, M, N]>>,
    ) -> Placed<f32, [..Bs, M, N]> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let joined = Option::Some(then);
        if let Some(out) = self.product_kernel::<[..Bs, M, K], [K, Paired<N>], [..Bs, M, N]>(a, bc, &joined, true) {
            return out;
        }
        return paired_by_parts::<WebGpuBackend, [..Bs], M, K, N>(self, a, bc, joined.unwrap());
    }

    fn matmul_rhs_from<..Bs, M, K, N>(
        &mut self,
        a: Prologue<PlacedRead<[..Bs, M, K]>>,
        b: &Placed<f32, [K, N]>,
        then: Option<Epilogue<PlacedRead<[..Bs, M, N]>>>,
    ) -> Placed<f32, [..Bs, M, N]> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        if let Some(out) = self.staged_product::<[..Bs, M, K], [K, N], [..Bs, M, N]>(&a, b, &then, false) {
            return out;
        }
        let lhs = prologue_tensor::<WebGpuBackend, [..Bs, M, K]>(self, a);
        return self.matmul_rhs(&lhs, b, then);
    }

    fn matmul_rhs_paired_from<..Bs, M, K, N>(
        &mut self,
        a: Prologue<PlacedRead<[..Bs, M, K]>>,
        bc: &Placed<f32, [K, Paired<N>]>,
        then: Epilogue<PlacedRead<[..Bs, M, N]>>,
    ) -> Placed<f32, [..Bs, M, N]> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let joined = Option::Some(then);
        if let Some(out) = self.staged_product::<[..Bs, M, K], [K, Paired<N>], [..Bs, M, N]>(&a, bc, &joined, true) {
            return out;
        }
        let lhs = prologue_tensor::<WebGpuBackend, [..Bs, M, K]>(self, a);
        return self.matmul_rhs_paired(&lhs, bc, joined.unwrap());
    }

    fn gather_rows<E: Element, Row, ..Rest, ..Ix>(
        &mut self,
        data: &Placed<E, [Row, ..Rest]>,
        indices: &Placed<i64, [..Ix]>,
    ) -> Placed<E, [..Ix, ..Rest]> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        if E::is_f32() {
            let view = self.device_view(data);
            if let Some(out) = self.gathered(&view, &self.host(indices), 0) {
                return Placed::Device(out);
            }
        }
        return Placed::Host(self.cpu.gather_rows::<E, Row, [..Rest], [..Ix]>(&self.host(data), &self.host(indices)));
    }

    fn gather<E: Element, ..Pre, Along, ..Post, ..Ix>(
        &mut self,
        data: &Placed<E, [..Pre, Along, ..Post]>,
        indices: &Placed<i64, [..Ix]>,
        axis: i32,
    ) -> Placed<E, [..Pre, ..Ix, ..Post]> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        if E::is_f32() {
            let view = self.device_view(data);
            if let Some(out) = self.gathered(&view, &self.host(indices), axis) {
                return Placed::Device(out);
            }
        }
        return Placed::Host(
            self.cpu.gather::<E, [..Pre], Along, [..Post], [..Ix]>(&self.host(data), &self.host(indices), axis),
        );
    }

    fn slice_axis<E: Element, ..Pre, In, Out, ..Post>(
        &mut self,
        t: &Placed<E, [..Pre, In, ..Post]>,
        axis: i32,
        start: i64,
        length: i32,
        step: i64,
    ) -> Placed<E, [..Pre, Out, ..Post]> {
        let Device(d) = t else {
            return Placed::Host(self.cpu.slice_axis::<E, [..Pre], In, Out, [..Post]>(
                &self.host_only(t),
                axis,
                start,
                length,
                step,
            ));
        };
        assert slices_within(d.extents[axis], start, length, step);
        let mut view = sliced(d, axis, start as i32, length);
        view.strides[axis] *= step as i32;
        return Placed::Device(view);
    }

    fn concat<E: Element, ..Pre, A, B, Out, ..Post>(
        &mut self,
        a: &Placed<E, [..Pre, A, ..Post]>,
        b: &Placed<E, [..Pre, B, ..Post]>,
        axis: i32,
    ) -> Placed<E, [..Pre, Out, ..Post]> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        if !E::is_f32() {
            return Placed::Host(self.cpu.concat::<E, [..Pre], A, B, Out, [..Post]>(&self.host(a), &self.host(b), axis));
        }
        let av = self.device_view(a);
        let bv = self.device_view(b);
        let mut extents = av.extents;
        extents[axis] += bv.extents[axis];
        let out = contiguous(self.allocated(element_count(&extents), false), 0, extents);
        self.copy(&av, &DeviceTensor { ..out, extents: av.extents });
        let at = out.offset + av.extents[axis] * out.strides[axis];
        self.copy(&bv, &DeviceTensor { ..out, offset: at, extents: bv.extents });
        return Placed::Device(out);
    }

    fn lift<E: Element, In, Out>(&mut self, t: &Placed<E, In>, rank: i32) -> Placed<E, Out> {
        let Device(d) = t else {
            return Placed::Host(self.cpu.lift::<E, In, Out>(&self.host_only(t), rank));
        };
        assert rank >= d.extents.len();
        let mut extents = List::<i32>::filled(rank - d.extents.len(), 1);
        let mut strides = List::<i32>::filled(rank - d.extents.len(), 0);
        extents.extend(&d.extents);
        strides.extend(&d.strides);
        return Placed::Device(DeviceTensor { ..*d, extents, strides });
    }

    /// A view: each stretched axis reads its one element through a stride of 0.
    fn expand<E: Element, In, Out>(&mut self, t: &Placed<E, In>, extents: List<i32>) -> Placed<E, Out> {
        let Device(d) = t else {
            return Placed::Host(self.cpu.expand::<E, In, Out>(&self.host_only(t), extents));
        };
        assert broadcast_extents(&d.extents, &extents) == Option::Some(extents), "the operand broadcasts to the extents";
        let lead = extents.len() - d.extents.len();
        let mut strides = List::<i32>::filled(lead, 0);
        for let a of 0..<d.extents.len() {
            strides.push(if d.extents[a] == 1 { 0 } else { d.strides[a] });
        }
        return Placed::Device(DeviceTensor { ..*d, extents, strides });
    }

    fn reshape<E: Element, In, Out>(
        &mut self,
        t: &Placed<E, In>,
        extents: List<i32>,
    ) -> Placed<E, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let Device(d) = t else {
            return Placed::Host(self.cpu.reshape::<E, In, Out>(&self.host_only(t), extents));
        };
        assert element_count(&extents) == element_count(&d.extents);
        if let Some(view) = regrouped(d, &extents) {
            return Placed::Device(view);
        }
        let whole = self.materialized(d);
        return Placed::Device(contiguous(whole.slot, whole.offset, extents));
    }

    fn transpose2<E: Element, A, B>(&mut self, t: &Placed<E, [A, B]>) -> Placed<E, [B, A]> {
        let Device(d) = t else {
            return Placed::Host(self.cpu.transpose2(&self.host_only(t)));
        };
        return Placed::Device(permuted(d, &([1, 0] as List<i32>)));
    }

    fn permute<E: Element, In, Out>(&mut self, t: &Placed<E, In>, perm: List<i32>) -> Placed<E, Out> {
        let Device(d) = t else {
            return Placed::Host(self.cpu.permute::<E, In, Out>(&self.host_only(t), perm));
        };
        return Placed::Device(permuted(d, &perm));
    }

    fn max_pool<N, C, ..In, ..Out>(
        &mut self,
        x: &Placed<f32, [N, C, ..In]>,
        window: &Window,
    ) -> Placed<f32, [N, C, ..Out]> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        return Placed::Host(self.cpu.max_pool::<N, C, [..In], [..Out]>(&self.host(x), window));
    }

    fn group_query_attention<B, S, Q, K, H, P, T, D, Pos, Half, BB, BH>(
        &mut self,
        q: &Placed<f32, [B, S, Q]>,
        k: &Placed<f32, [B, S, K]>,
        v: &Placed<f32, [B, S, K]>,
        past_k: &Placed<f32, [B, H, P, D]>,
        past_v: &Placed<f32, [B, H, P, D]>,
        cos: Option<&Placed<f32, [Pos, Half]>>,
        sin: Option<&Placed<f32, [Pos, Half]>>,
        bias: Option<&Placed<f32, [BB, BH, S, T]>>,
        options: &Attention,
    ) -> [Placed<f32, [B, S, Q]>, Placed<f32, [B, H, T, D]>, Placed<f32, [B, H, T, D]>] with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let rotary = match [cos, sin] {
            [Some(c), Some(s)] => Option::Some([
                self.device_view(c),
                self.device_view(s),
            ]),
            _ => null,
        };
        let bias_view = match bias {
            Some(b) => Option::Some(self.device_view(b)),
            None => null,
        };
        if let Some([out, present_k, present_v]) = self.attended(
            &self.device_view(q),
            &self.device_view(k),
            &self.device_view(v),
            &self.device_view(past_k),
            &self.device_view(past_v),
            &rotary,
            &bias_view,
            options,
        ) {
            return [
                Placed::Device(out),
                Placed::Device(present_k),
                Placed::Device(present_v),
            ];
        }
        let cos_host = self.host_of(cos);
        let sin_host = self.host_of(sin);
        let bias_host = self.host_of(bias);
        let [out, present_k, present_v] = group_query_attention(
            &self.host(q),
            &self.host(k),
            &self.host(v),
            &self.host(past_k),
            &self.host(past_v),
            optional(&cos_host),
            optional(&sin_host),
            optional(&bias_host),
            options,
        );
        return [
            Placed::Host(out),
            Placed::Host(present_k),
            Placed::Host(present_v),
        ];
    }

    fn conv<N, Ci, Co, ..In, ..K, ..Out>(
        &mut self,
        x: &Placed<f32, [N, Ci, ..In]>,
        w: &Placed<f32, [Co, Ci, ..K]>,
        window: &Window,
        then: Option<Epilogue<PlacedRead<[N, Co, ..Out]>>>,
    ) -> Placed<f32, [N, Co, ..Out]> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let computed = self.cpu.conv::<N, Ci, Co, [..In], [..K], [..Out]>(&self.host(x), &self.host(w), window, null);
        let placed = self.placed(&computed, false);
        return self.finished(placed, &then);
    }

    fn conv_bias<N, Ci, Co, ..In, ..K, ..Out>(
        &mut self,
        x: &Placed<f32, [N, Ci, ..In]>,
        w: &Placed<f32, [Co, Ci, ..K]>,
        b: &Placed<f32, [Co]>,
        window: &Window,
        then: Option<Epilogue<PlacedRead<[N, Co, ..Out]>>>,
    ) -> Placed<f32, [N, Co, ..Out]> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let computed = self.cpu.conv_bias::<N, Ci, Co, [..In], [..K], [..Out]>(
            &self.host(x),
            &self.host(w),
            &self.host(b),
            window,
            null,
        );
        let placed = self.placed(&computed, false);
        return self.finished(placed, &then);
    }

    fn conv_grouped<N, Ci, Cg, Co, ..In, ..K, ..Out>(
        &mut self,
        x: &Placed<f32, [N, Ci, ..In]>,
        w: &Placed<f32, [Co, Cg, ..K]>,
        group: i32,
        window: &Window,
        then: Option<Epilogue<PlacedRead<[N, Co, ..Out]>>>,
    ) -> Placed<f32, [N, Co, ..Out]> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let computed = self.cpu.conv_grouped::<N, Ci, Cg, Co, [..In], [..K], [..Out]>(
            &self.host(x),
            &self.host(w),
            group,
            window,
            null,
        );
        let placed = self.placed(&computed, false);
        return self.finished(placed, &then);
    }

    fn conv_grouped_bias<N, Ci, Cg, Co, ..In, ..K, ..Out>(
        &mut self,
        x: &Placed<f32, [N, Ci, ..In]>,
        w: &Placed<f32, [Co, Cg, ..K]>,
        b: &Placed<f32, [Co]>,
        group: i32,
        window: &Window,
        then: Option<Epilogue<PlacedRead<[N, Co, ..Out]>>>,
    ) -> Placed<f32, [N, Co, ..Out]> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let computed = self.cpu.conv_grouped_bias::<N, Ci, Cg, Co, [..In], [..K], [..Out]>(
            &self.host(x),
            &self.host(w),
            &self.host(b),
            group,
            window,
            null,
        );
        let placed = self.placed(&computed, false);
        return self.finished(placed, &then);
    }

    fn softmax<Axes>(
        &mut self,
        t: &Placed<f32, Axes>,
        axis: i32,
    ) -> Placed<f32, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let view = self.device_view(t);
        let perm = moved_last(view.extents.len(), &([axis] as List<i32>));
        let moved = permuted(&view, &perm);
        let Some(out) = self.row_kernel(
            &([moved] as List<DeviceTensor>),
            moved.extents,
            &operand(0).row_softmax(),
            1,
            false,
        ) else {
            return Placed::Host(self.cpu.softmax(&self.host(t), axis));
        };
        return Placed::Device(permuted(&out, &inverse(&perm)));
    }

    fn softmax_flattened<Axes>(
        &mut self,
        t: &Placed<f32, Axes>,
        axis: i32,
    ) -> Placed<f32, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let view = self.device_view(t);
        let row_axes = view.extents.len() - axis;
        let Some(out) = self.row_kernel(
            &([view] as List<DeviceTensor>),
            view.extents,
            &operand(0).row_softmax(),
            row_axes,
            false,
        ) else {
            return Placed::Host(self.cpu.softmax_flattened(&self.host(t), axis));
        };
        return Placed::Device(out);
    }

    fn reduce_sum<Axes>(
        &mut self,
        t: &Placed<f32, Axes>,
        axes: List<i32>,
    ) -> Placed<f32, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let view = self.device_view(t);
        let Some(out) = self.reduced(&view, &axes, &operand(0).row_sum(null)) else {
            return Placed::Host(self.cpu.reduce_sum(&self.host(t), axes));
        };
        return Placed::Device(out);
    }

    fn reduce_mean<Axes>(
        &mut self,
        t: &Placed<f32, Axes>,
        axes: List<i32>,
    ) -> Placed<f32, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let view = self.device_view(t);
        let count = reduced_count(&view.extents, &axes);
        let Some(out) = self.reduced(&view, &axes, &operand(0).row_sum(Option::Some(count))) else {
            return Placed::Host(self.cpu.reduce_mean(&self.host(t), axes));
        };
        return Placed::Device(out);
    }

    /// One workgroup per part of a lane, then one per lane over the parts'
    /// winners, each index read back as an f32, which holds it exactly: an
    /// `i64` tensor lives on the host.
    fn arg_max<Axes>(
        &mut self,
        t: &Placed<f32, Axes>,
        axis: i32,
    ) -> Placed<i64, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let view = self.device_view(t);
        let rank = view.extents.len();
        let moved = permuted(&view, &moved_last(rank, &([axis] as List<i32>)));
        let lane = view.extents[axis];
        // An empty axis breaks the contract the Cpu kernel states.
        if lane == 0 {
            return Placed::Host(self.cpu.arg_max(&self.host(t), axis));
        }
        let lanes = element_count(&view.extents) / lane;
        let operands = [moved] as List<DeviceTensor>;
        if lane > 1 << 24 || lanes > self.max_binding || !self.binds(&operands) {
            return Placed::Host(self.cpu.arg_max(&self.host(t), axis));
        }
        let out = self.allocated(lanes, false);
        let parts = lane.div_ceil(ARG_MAX_PART);
        let groups = lanes * parts;
        let [gx, gy] = spread(groups);
        let mut head: List<u32> = [];
        push_all(&mut head, &([groups, gx, lane, parts] as List<i32>));
        push_all(&mut head, &moved.extents);
        if parts == 1 {
            self.dispatch_bound(&operands, out, lanes, head, |bindings| ShaderKey::ArgMax([bindings, rank, Whole]), [
                gx, gy, 1,
            ]);
        } else {
            let pairs = self.allocated(2 * groups, false);
            self.dispatch_bound(&operands, pairs, 2 * groups, head, |bindings| ShaderKey::ArgMax(
                [bindings, rank, Parts],
            ), [gx, gy, 1]);
            let [lx, ly] = spread(lanes);
            let combine = [contiguous(pairs, 0, [2 * groups])] as List<DeviceTensor>;
            let mut combined = head;
            combined[0] = lanes as u32;
            combined[1] = lx as u32;
            self.dispatch_bound(
                &combine,
                out,
                lanes,
                combined,
                |bindings| ShaderKey::ArgMax([bindings, rank, Combine]),
                [lx, ly, 1],
            );
        }
        let mut extents = view.extents;
        extents[axis] = 1;
        let mut data = List::<i64>::with_capacity(lanes);
        for let i of self.read_back(&contiguous(out, 0, [lanes])) {
            data.push(i as i64);
        }
        return Placed::Host(Tensor { data, extents });
    }
}

/// The permutation moving `axes`, sorted, after the rest of `rank` axes.
fn moved_last(rank: i32, axes: &List<i32>) -> List<i32> {
    let mut perm: List<i32> = [];
    for let d of 0..<rank {
        if !axes.contains(&d) {
            perm.push(d);
        }
    }
    perm.extend(&axes.sorted());
    return perm;
}

fn operand_views<Axes>(operands: &List<PlacedRead<Axes>>) -> List<DeviceTensor> {
    return operands.into_iter().map(|o| o.view).collect();
}

/// The spans an operand list binds, which binding each operand reads, and the
/// views the shader reads them through, each from the start of its span.
struct Bindings {
    spans: List<Span>,
    bindings: List<i32>,
    views: List<DeviceTensor>,
}

/// The 32-bit words `first..<first + count` of the buffer at `slot`, which one
/// binding of a dispatch holds.
struct Span {
    slot: i32,
    first: i32,
    count: i32,
}

/// The elements of `t`'s buffer one word holds.
fn elements_per_word(t: &DeviceTensor) -> i32 {
    return if t.half { 2 } else { 1 };
}

/// `t`'s offset from the start of `span`, a binding of its buffer.
fn rebased(t: &DeviceTensor, span: &Span) -> i32 {
    return t.offset - span.first * elements_per_word(t);
}

/// Whether every one of `operands` holds f32 elements, as every kernel but a
/// product's right operand, a gather's data and a copy's source reads them.
fn all_f32(operands: &List<DeviceTensor>) -> bool {
    for let o of *operands {
        if o.half {
            return false;
        }
    }
    return true;
}

/// Whether bf16 holds each of `values` exactly: its low 16 bits are zero.
fn held_in_bf16(values: &List<f32>) -> bool {
    for let v of *values {
        if v.to_bits() & 0xFFFF != 0 {
            return false;
        }
    }
    return true;
}

/// The elements a pack of `operands` holds, each copied whole.
fn packed_count(operands: &List<DeviceTensor>) -> i32 {
    let mut total = 0;
    for let o of *operands {
        total += element_count(&o.extents);
    }
    return total;
}

/// The whole of `t`, a buffer just allocated for it.
fn fresh(t: &DeviceTensor) -> Span
    contract t.offset == 0
{
    return Span { slot: t.slot, first: 0, count: i32::max(element_count(&t.extents), 1) };
}

/// The first and last element `t` reads: only its offset where it has no
/// elements, which a binding of one element covers.
fn reach(t: &DeviceTensor) -> [i32, i32] {
    let mut first = t.offset;
    let mut last = t.offset;
    if element_count(&t.extents) == 0 {
        return [first, last];
    }
    for let d of 0..<t.extents.len() {
        let step = t.strides[d] * i32::max(t.extents[d] - 1, 0);
        first += i32::min(step, 0);
        last += i32::max(step, 0);
    }
    return [first, last];
}

/// `t` along `axis` from `start`, `length` of it.
fn sliced(t: &DeviceTensor, axis: i32, start: i32, length: i32) -> DeviceTensor {
    let mut view = *t;
    view.offset += start * t.strides[axis];
    view.extents[axis] = length;
    return view;
}

/// The first axis of `extents` longer than 1, along which a kernel too wide
/// for one dispatch is halved.
fn split_axis(extents: &List<i32>) -> i32 {
    let Some(axis) = extents.position(|e| e > 1) else {
        panic("loam: one element outgrows a binding");
    };
    return axis;
}

/// A view of `extents` laid out row-major from `offset`.
fn contiguous(slot: i32, offset: i32, extents: List<i32>) -> DeviceTensor {
    return DeviceTensor { slot, offset, strides: row_major(&extents), extents, half: false };
}

/// The strides of `extents` laid out row-major.
fn row_major(extents: &List<i32>) -> List<i32> {
    let mut strides = List::<i32>::filled(extents.len(), 1);
    for let mut d = extents.len() - 2; d >= 0; d -= 1 {
        strides[d] = strides[d + 1] * extents[d + 1];
    }
    return strides;
}

/// Whether `t`'s elements lie row-major from its offset.
fn is_contiguous(t: &DeviceTensor) -> bool {
    return reads_as(t, t.offset, &row_major(&t.extents));
}

/// Whether `t` reads the elements a view from `offset` with `strides` reads
/// over its extents. An axis of extent 1 steps nowhere, so its stride does
/// not matter, and a `reshape` rewrites it freely.
fn reads_as(t: &DeviceTensor, offset: i32, strides: &List<i32>) -> bool {
    if t.offset != offset {
        return false;
    }
    for let d of 0..<t.extents.len() {
        if t.extents[d] != 1 && t.strides[d] != strides[d] {
            return false;
        }
    }
    return true;
}

/// `t`'s strides read under `out`, its extents aligned with `out`'s from the
/// end: 0 along an axis it lacks or has at extent 1.
fn stretched(t: &DeviceTensor, out: &List<i32>) -> List<i32> {
    let lead = out.len() - t.extents.len();
    assert lead >= 0;
    let mut strides = List::<i32>::filled(lead, 0);
    for let d of 0..<t.extents.len() {
        strides.push(if t.extents[d] == 1 && out[lead + d] != 1 { 0 } else { t.strides[d] });
    }
    return strides;
}

/// The extents every operand broadcasts to.
fn broadcast_all(operands: &List<DeviceTensor>) -> List<i32> {
    let mut extents: List<i32> = [];
    for let o of *operands {
        extents = broadcast_extents(&extents, &o.extents).unwrap();
    }
    return extents;
}

/// `t`'s axes in the order `perm` lists them.
fn permuted(t: &DeviceTensor, perm: &List<i32>) -> DeviceTensor {
    let mut extents: List<i32> = [];
    let mut strides: List<i32> = [];
    for let p of *perm {
        extents.push(t.extents[p]);
        strides.push(t.strides[p]);
    }
    return DeviceTensor { ..*t, extents, strides };
}

/// `t`'s elements under `extents`, in row-major order, as a view of the same
/// buffer, or `None` where its strides cannot say it so a copy must. Each run
/// of `t`'s axes that `extents` regroups must step through memory as one axis
/// would, as numpy's reshape asks before it copies.
fn regrouped(t: &DeviceTensor, extents: &List<i32>) -> Option<DeviceTensor> {
    if element_count(extents) == 0 {
        return null;
    }
    // An axis of 1 steps nowhere, so it joins no run.
    let mut old: List<i32> = [];
    let mut old_strides: List<i32> = [];
    for let d of 0..<t.extents.len() {
        if t.extents[d] != 1 {
            old.push(t.extents[d]);
            old_strides.push(t.strides[d]);
        }
    }
    let mut strides = List::<i32>::filled(extents.len(), 0);
    let [mut oi, mut ni] = [0, 0];
    while oi < old.len() && ni < extents.len() {
        // The shortest runs of old and new axes holding one count.
        let [mut oj, mut nj] = [oi + 1, ni + 1];
        let [mut held, mut wanted] = [old[oi], extents[ni]];
        while held != wanted {
            if wanted < held {
                wanted *= extents[nj];
                nj += 1;
            } else {
                held *= old[oj];
                oj += 1;
            }
        }
        for let k of oi..<oj - 1 {
            if old_strides[k] != old[k + 1] * old_strides[k + 1] {
                return null;
            }
        }
        strides[nj - 1] = old_strides[oj - 1];
        for let mut k = nj - 1; k > ni; k -= 1 {
            strides[k - 1] = strides[k] * extents[k];
        }
        oi = oj;
        ni = nj;
    }
    return Option::Some(DeviceTensor { ..*t, extents: *extents, strides });
}

/// The permutation undoing `perm`.
fn inverse(perm: &List<i32>) -> List<i32> {
    let mut out = List::<i32>::filled(perm.len(), 0);
    for let [i, p] of perm.into_iter().enumerate() {
        out[*p] = i;
    }
    return out;
}

/// A rank-1 operand on the left of a product: one row.
fn as_row(t: &DeviceTensor) -> DeviceTensor {
    return DeviceTensor {
        ..*t,
        extents: [1, t.extents[0]],
        strides: [0, t.strides[0]],
    };
}

/// A rank-1 operand on the right of a product: one column.
fn as_column(t: &DeviceTensor) -> DeviceTensor {
    return DeviceTensor {
        ..*t,
        extents: [t.extents[0], 1],
        strides: [t.strides[0], 0],
    };
}

/// A matrix operand's strides along `batch`, its own batch axes aligned with
/// it from the end, 0 along one it lacks or has at extent 1.
fn batch_strides(m: &DeviceTensor, batch: &List<i32>) -> List<i32> {
    let r = m.extents.len();
    let own = DeviceTensor {
        ..*m,
        extents: m.extents[0..<r - 2].to_list(),
        strides: m.strides[0..<r - 2].to_list(),
    };
    return stretched(&own, batch);
}

/// The parameters [`product_shader`] and [`narrow_product_shader`] read up to
/// a chunk's partial sums: `dims`, its rows, inner and columns, the `batch`
/// extents, the two matrices' views, the first two of `views`, then each
/// epilogue operand's after them, read under the result's `extents`, which
/// drop an axis a rank-1 operand of `a_extents` or `b_extents` stands in for.
fn product_params(
    dims: [i32, i32, i32],
    batch: &List<i32>,
    views: &List<DeviceTensor>,
    extents: &List<i32>,
    a_extents: &List<i32>,
    b_extents: &List<i32>,
) -> List<u32> {
    let [rows, inner, cols] = dims;
    let mut params: List<u32> = [rows as u32, inner as u32, cols as u32];
    push_all(&mut params, batch);
    for let i of 0..<2 {
        let m = &views[i];
        let r = m.extents.len();
        push_view(&mut params, m.offset, &batch_strides(m, batch));
        push_signed(&mut params, m.strides[r - 2]);
        push_signed(&mut params, m.strides[r - 1]);
    }
    for let i of 2..<views.len() {
        let o = &views[i];
        push_view(&mut params, o.offset, &internal_strides(&stretched(o, extents), a_extents, b_extents, batch.len()));
    }
    return params;
}

/// An epilogue operand's strides over the product's `[..batch, rows, cols]`,
/// from its strides over the result, which drops the rows axis where `a` is
/// rank 1 and the columns axis where `b` is.
fn internal_strides(over_result: &List<i32>, a: &List<i32>, b: &List<i32>, batch: i32) -> List<i32> {
    let mut strides = over_result[0..<batch].to_list();
    let mut at = batch;
    if a.len() > 1 {
        strides.push(over_result[at]);
        at += 1;
    } else {
        strides.push(0);
    }
    strides.push(if b.len() > 1 { over_result[at] } else { 0 });
    return strides;
}

/// The workgroups covering `count` invocations of `LANES` each: as many as one
/// dimension takes along `x`, the rest along `y`.
fn grid(count: i32) -> [i32, i32] {
    return spread(count.div_ceil(LANES));
}

/// `groups` workgroups as a grid of rows of at most `MAX_GROUPS`: the
/// workgroups per row, and the rows.
fn spread(groups: i32) -> [i32, i32] {
    let x = i32::min(groups, MAX_GROUPS);
    return [x, if x == 0 { 0 } else { groups.div_ceil(x) }];
}

/// The parameters every shader with one invocation per element starts with:
/// the count, the invocations per row of `x` workgroups, and the extents.
fn element_params(count: i32, x: i32, extents: &List<i32>) -> List<u32> {
    let mut params: List<u32> = [count as u32, (x * LANES) as u32];
    push_all(&mut params, extents);
    return params;
}

/// A device's limit as a count the backend computes with: a limit past
/// `i32::MAX`, which a driver may report as unbounded, is `i32::MAX`.
fn saturated(limit: u64) -> i32 {
    return if limit > i32::MAX as u64 { i32::MAX } else { limit as i32 };
}

/// The bytes `count` f32 elements take, at least one element's: WebGPU binds
/// no empty buffer.
fn byte_size(count: i32) -> GpuSize64 {
    return (i32::max(count, 1) * 4) as u64 as GpuSize64;
}

fn push_all(params: &mut List<u32>, values: &List<i32>) {
    for let v of *values {
        params.push(v as u32);
    }
}

/// `v`, which may be negative, as a shader reads it back with `bitcast<i32>`.
fn push_signed(params: &mut List<u32>, v: i32) {
    params.push(v as u32);
}

fn push_view(params: &mut List<u32>, offset: i32, strides: &List<i32>) {
    push_signed(params, offset);
    for let s of *strides {
        push_signed(params, s);
    }
}

/// The WGSL declaring `bindings` read-only buffers `o0`, `o1`, …, the output
/// `out` and the parameters `p` after them. Binding `half` holds bf16 words,
/// which [`element_wgsl`] reads.
fn buffers_wgsl(bindings: i32, half: Option<i32>) -> String {
    let mut out = "";
    for let k of 0..<bindings {
        out.push_str(
            `@group(0) @binding(${k}) var<storage, read> o${k}: array<${word_wgsl(half == Option::Some(k))}>;\n`,
        );
    }
    out.push_str(`@group(0) @binding(${bindings}) var<storage, read_write> out: array<f32>;\n`);
    out.push_str(`@group(0) @binding(${bindings + 1}) var<storage, read> p: array<u32>;\n`);
    return out;
}

/// The WGSL type of a buffer's words: `u32` where they hold bf16 pairs.
fn word_wgsl(half: bool) -> String {
    return if half { "u32" } else { "f32" };
}

/// The f32 at the element index `index`, a `u32`, of the buffer `buffer`: an
/// f32 element, or a bf16 one widened, its word's low half for an even index.
fn element_wgsl(buffer: String, index: String, half: bool) -> String {
    if !half {
        return `${buffer}[${index}]`;
    }
    return `bitcast<f32>((${buffer}[(${index}) >> 1u] >> (((${index}) & 1u) * 16u)) << 16u)`;
}

/// Lines binding `{name}{from}`, … `{name}{to - 1}` to the coordinates of
/// `linear` over the axes `from..<to` of the extents at `p[extents]` on.
fn coords_wgsl(linear: String, extents: i32, from: i32, to: i32, name: String, indent: String) -> String {
    let mut out = `${indent}var ${name}_rest = ${linear};\n`;
    for let mut d = to - 1; d >= from; d -= 1 {
        out.push_str(`${indent}let ${name}${d} = ${name}_rest % p[${extents + d}];\n`);
        out.push_str(`${indent}${name}_rest = ${name}_rest / p[${extents + d}];\n`);
    }
    return out;
}

/// The element index of a view whose offset is at `p[at]` and whose strides
/// follow, at coordinates `c{from}` … over the axes `from..<to`, plus `base`.
fn index_wgsl(at: i32, from: i32, to: i32, coords: String, base: String) -> String {
    let mut terms = base;
    for let d of from..<to {
        terms.push_str(` + i32(${coords}${d}) * bitcast<i32>(p[${at + 1 + d}])`);
    }
    return terms;
}

/// The statements computing `op`'s steps up to `last` as `s0`, `s1`, …, its
/// operands read as `x0`, `x1`, … and a `Fold` step as `folds[i]`, `i` its
/// place among the folds.
fn steps_wgsl(op: &Expr, last: i32, indent: String) -> String {
    let mut body = "";
    let mut fold = 0;
    for let i of 0..=last {
        let value = match op.steps[i] {
            Operand(n) => `x${n}`,
            Constant(c) => `bitcast<f32>(${c.to_bits()}u)`,
            Unary([u, a]) => unary_wgsl(u, `s${a}`),
            Binary([o, a, b]) => binary_wgsl(o, `s${a}`, `s${b}`),
            Select([c, a, b]) => `select(s${b}, s${a}, s${c} != 0.0)`,
            Fold(_) => {
                fold += 1;
                `folds[${fold - 1}]`;
            },
        };
        body.push_str(`${indent}let s${i} = ${value};\n`);
    }
    return body;
}

/// What a shader is made of. Equal keys make the same WGSL, so the compiled
/// pipelines are found by the key, compared in place of the source it would
/// take to build first.
variant ShaderKey {
    /// [`elementwise_shader`]'s arguments.
    Elementwise([Expr, List<i32>, i32]),
    /// [`row_shader`]'s arguments.
    Rows([Expr, List<i32>, i32, i32, bool]),
    /// [`copy_shader`]'s arguments.
    Copy([i32, bool]),
    /// [`product_shader`]'s arguments.
    Product([Expr, List<i32>, i32, bool, bool, bool]),
    /// [`narrow_product_shader`]'s arguments.
    NarrowProduct([Expr, List<i32>, i32, bool, bool, bool, i32, i32, bool, Option<Staged>]),
    /// [`gather_shader`]'s arguments.
    Gather([i32, i32, bool]),
    /// [`append_shader`]'s arguments.
    Append([List<i32>, bool]),
    /// [`attend_shader`]'s arguments.
    Attend([List<i32>, i32, bool, bool]),
    /// [`attend_join_shader`]'s argument.
    AttendJoin(List<i32>),
    /// [`arg_max_shader`]'s arguments.
    ArgMax([List<i32>, i32, ArgMaxStage]),
}

impl ShaderKey {
    /// The WGSL this key makes.
    fn source(&self) -> String {
        return match self {
            Elementwise([op, bindings, rank]) => elementwise_shader(op, bindings, *rank),
            Rows([op, bindings, rank, row_axes, reduced]) => row_shader(op, bindings, *rank, *row_axes, *reduced),
            Copy([rank, half]) => copy_shader(*rank, *half),
            Product([op, bindings, batch, continued, half, across]) => product_shader(
                op,
                bindings,
                *batch,
                *continued,
                *half,
                *across,
            ),
            NarrowProduct([op, bindings, batch, continued, across, half, width, lanes, paired, staged]) => narrow_product_shader(
                op,
                bindings,
                *batch,
                *continued,
                *across,
                *half,
                *width,
                *lanes,
                *paired,
                staged,
            ),
            Gather([rank, axis, half]) => gather_shader(*rank, *axis, *half),
            Append([bindings, rotary]) => append_shader(bindings, *rotary),
            Attend([bindings, head, rotary, biased]) => attend_shader(bindings, *head, *rotary, *biased),
            AttendJoin(bindings) => attend_join_shader(bindings),
            ArgMax([bindings, rank, stage]) => arg_max_shader(bindings, *rank, *stage),
        };
    }
}

/// The element of operand `k`, read from binding `bindings[k]`, whose view's
/// offset is at `p[at]` and strides follow, at `coords`.
fn view_wgsl(bindings: &List<i32>, k: i32, at: i32, coords: List<String>) -> String {
    return `o${bindings[k]}[u32(${view_index_wgsl(at, coords)})]`;
}

/// The index, as an i32, of the element at `coords` of the view whose offset
/// is at `p[at]` and strides follow, over the leading axes `coords` names.
fn view_index_wgsl(at: i32, coords: List<String>) -> String {
    let mut index = `bitcast<i32>(p[${at}])`;
    for let [d, c] of coords.into_iter().enumerate() {
        index.push_str(` + i32(${c}) * bitcast<i32>(p[${at + 1 + d}])`);
    }
    return index;
}

/// Lines setting `turned` to `x`, element `e` of a head whose element `c` is
/// `row(c)`, turned by row `position` of the cosine and sine tables, which
/// operands `cos` and `cos + 1` read through their views at `p[at]` and
/// `p[at + 3]`. Halves `(a, b)` become `(a cos − b sin, b cos + a sin)`, and an
/// element past both halves, or every one where `half` is 0, stays.
fn turned_wgsl(
    bindings: &List<i32>,
    cos: i32,
    at: i32,
    position: String,
    row: fn(String) -> String,
    indent: String,
) -> String {
    let cosine = |i: String| view_wgsl(bindings, cos, at, [position, i]);
    let sine = |i: String| view_wgsl(bindings, cos + 1, at + 3, [position, i]);
    return `${indent}var turned = x;
${indent}if e < half {
${indent}    turned = x * ${cosine("e")} - ${row("e + half")} * ${sine("e")};
${indent}} else if e < 2u * half {
${indent}    turned = x * ${cosine("e - half")} + ${row("e - half")} * ${sine("e - half")};
${indent}}
`;
}

/// The WGSL appending the new keys and then values of `group_query_attention`
/// to the attention cache, one invocation per element of `[2, batch, key heads,
/// new positions, head]`, each key turned where `rotary`. Parameters: the
/// count, the invocations per row, the extents `[batch, key heads, new
/// positions, head]`, the past's length, the turned half's, the view of the
/// cache's keys, where its values start, then the views of the new keys, new
/// values, cosines and sines.
fn append_shader(bindings: &List<i32>, rotary: bool) -> String {
    let new_at = |k: i32, at: i32, col: String| view_wgsl(bindings, k, at, ["b", "s", col]);
    let key = if rotary {
        turned_wgsl(bindings, 2, 22, "t", |c| new_at(0, 14, `h * d + ${c}`), "    ");
    } else {
        "    let turned = x;\n";
    };
    return `${buffers_wgsl(1 + max_of(bindings), null)}
@compute @workgroup_size(${LANES})
fn main(@builtin(global_invocation_id) id: vec3<u32>) {
    let i = id.x + id.y * p[1];
    if i >= p[0] {
        return;
    }
    let n = p[0] / 2u;
    let r = i % n;
    let d = p[5];
    let e = r % d;
    let s = (r / d) % p[4];
    let h = (r / (d * p[4])) % p[3];
    let b = r / (d * p[4] * p[3]);
    let t = p[6] + s;
    let half = p[7];
    let at = u32(${view_index_wgsl(8, ["b", "h", "t", "e"])} + select(0, bitcast<i32>(p[13]), i >= n));
    if i >= n {
        out[at] = ${new_at(1, 18, "h * d + e")};
        return;
    }
    let x = ${new_at(0, 14, "h * d + e")};
${key}    out[at] = turned;
}
`;
}

/// The WGSL attending one query row of `group_query_attention` over one part
/// of `ATTEND_PART` positions per workgroup, for heads of `head` elements: the
/// query turned where `rotary`, its scores against each position's key scaled,
/// capped, biased where `biased` and masked, and the values they weigh. A part
/// writes its weighed values, its greatest score, and its weights' sum, each
/// weight taken against that score: `attend_join_shader` joins a row's parts.
/// The lanes split each position's dot, so a step over one token, whose
/// rows are few, still spreads over the device.
/// Parameters: the workgroups, the workgroups per row of the grid, the batch,
/// the new positions, the heads, the head's length, the positions in all, the
/// past's, the query heads per key head, the turned half's length, the scale
/// and the cap as f32 bits, the window, whether causal, then the views of the
/// queries, the present keys and values, the cosines and sines, and the bias.
fn attend_shader(bindings: &List<i32>, head: i32, rotary: bool, biased: bool) -> String {
    let query_at = |c: String| view_wgsl(bindings, 0, 14, ["b", "s", `h * d + ${c}`]);
    let turning = if rotary {
        turned_wgsl(bindings, 3, 28, "position", query_at, "        ");
    } else {
        "        let turned = x;\n";
    };
    let [bias, bias_at] = if rotary { [5, 34] } else { [3, 28] };
    let biasing = if biased {
        `            sc += ${view_wgsl(bindings, bias, bias_at, ["b", "h", "s", "j"])};\n`;
    } else {
        "";
    };
    let splits = LANES / ATTEND_PART;
    assert splits * ATTEND_PART == LANES && splits & splits - 1 == 0, "a dot's parts add in halves";
    return `${buffers_wgsl(1 + max_of(bindings), null)}
var<workgroup> query: array<f32, ${head}>;
var<workgroup> partial: array<f32, ${LANES}>;
var<workgroup> weights: array<f32, ${ATTEND_PART}>;

@compute @workgroup_size(${LANES})
fn main(@builtin(workgroup_id) group: vec3<u32>, @builtin(local_invocation_index) lid: u32) {
    let flat = group.x + group.y * p[1];
    if flat >= p[0] {
        return;
    }
    let parts = (p[6] + ${ATTEND_PART - 1}u) / ${ATTEND_PART}u;
    let row = flat / parts;
    let first = flat % parts * ${ATTEND_PART}u;
    let seq = p[3];
    let heads = p[4];
    let d = p[5];
    let total = p[6];
    let past = p[7];
    let half = p[9];
    let scale = bitcast<f32>(p[10]);
    let softcap = bitcast<f32>(p[11]);
    let window = bitcast<i32>(p[12]);
    let causal = p[13] != 0u;
    let h = row % heads;
    let s = (row / heads) % seq;
    let b = row / (heads * seq);
    let kh = h / p[8];
    let position = past + s;
    let none = bitcast<f32>(0xff800000u);
    for (var e = lid; e < d; e += ${LANES}u) {
        let x = ${query_at("e")};
${turning}        query[e] = turned;
    }
    workgroupBarrier();
    // Adjacent lanes split one position's dot, reading adjacent elements.
    let split = lid % ${splits}u;
    let j = first + lid / ${splits}u;
    let masked = j >= total || (causal && j > position)
        || (window > 0 && i32(position) - i32(j) >= window);
    var dot = 0.0;
    if !masked {
        let key = ${view_index_wgsl(18, ["b", "kh", "j"])};
        let along = bitcast<i32>(p[22]);
        for (var e = split; e < d; e += ${splits}u) {
            dot += query[e] * o${bindings[1]}[u32(key + i32(e) * along)];
        }
    }
    partial[lid] = dot;
    workgroupBarrier();
    for (var w = ${splits / 2}u; w > 0u; w = w >> 1u) {
        if split < w {
            partial[lid] += partial[lid + w];
        }
        workgroupBarrier();
    }
    var sc = none;
    if split == 0u && !masked {
        sc = partial[lid] * scale;
        if softcap > 0.0 {
            sc = softcap * tanh(sc / softcap);
        }
${biasing}    }
    if split == 0u {
        weights[lid / ${splits}u] = sc;
    }
    workgroupBarrier();
    var most = none;
    for (var i = 0u; i < ${ATTEND_PART}u; i++) {
        most = max(most, weights[i]);
    }
    workgroupBarrier();
    if lid < ${ATTEND_PART}u {
        let score = weights[lid];
        weights[lid] = select(exp(score - most), 0.0, score == none);
    }
    workgroupBarrier();
    let at = flat * (d + 2u);
    let count = min(${ATTEND_PART}u, total - first);
    let values = ${view_index_wgsl(23, ["b", "kh", "first"])};
    let next = bitcast<i32>(p[26]);
    let along = bitcast<i32>(p[27]);
    for (var e = lid; e < d; e += ${LANES}u) {
        var acc = 0.0;
        let column = values + i32(e) * along;
        for (var i = 0u; i < count; i++) {
            let w = weights[i];
            if w != 0.0 {
                acc += w * o${bindings[2]}[u32(column + i32(i) * next)];
            }
        }
        out[at + e] = acc;
    }
    if lid == 0u {
        var sum = 0.0;
        for (var i = 0u; i < ${ATTEND_PART}u; i++) {
            sum += weights[i];
        }
        out[at + d] = most;
        out[at + d + 1u] = sum;
    }
}
`;
}

/// The WGSL joining the parts `attend_shader` wrote of each row, one row per
/// workgroup: each part's weighed values and weights' sum rescaled from its
/// greatest score to the row's. Parameters: the rows, the workgroups per row of
/// the grid, the parts of a row, the head's length, then the view of the parts.
fn attend_join_shader(bindings: &List<i32>) -> String {
    let part = |c: String, at: String| `o${bindings[0]}[p[4] + (row * parts + ${c}) * (d + 2u) + ${at}]`;
    return `${buffers_wgsl(1 + max_of(bindings), null)}
@compute @workgroup_size(${LANES})
fn main(@builtin(workgroup_id) group: vec3<u32>, @builtin(local_invocation_index) lid: u32) {
    let row = group.x + group.y * p[1];
    if row >= p[0] {
        return;
    }
    let parts = p[2];
    let d = p[3];
    let none = bitcast<f32>(0xff800000u);
    var most = none;
    for (var c = 0u; c < parts; c++) {
        most = max(most, ${part("c", "d")});
    }
    var all = 0.0;
    for (var c = 0u; c < parts; c++) {
        let top = ${part("c", "d")};
        all += select(exp(top - most), 0.0, top == none) * ${part("c", "d + 1u")};
    }
    for (var e = lid; e < d; e += ${LANES}u) {
        var acc = 0.0;
        for (var c = 0u; c < parts; c++) {
            let top = ${part("c", "d")};
            acc += select(exp(top - most), 0.0, top == none) * ${part("c", "e")};
        }
        out[row * d + e] = acc / all;
    }
}
`;
}

/// What one dispatch of [`arg_max_shader`] reduces.
enum ArgMaxStage {
    /// Each lane whole, in one workgroup.
    Whole,
    /// Each lane's parts of `ARG_MAX_PART` elements, one workgroup a part,
    /// into its greatest element and that element's index.
    Parts,
    /// Each lane's parts as `Parts` wrote them, in one workgroup.
    Combine,
}

/// The elements one workgroup of an `arg_max` reduces at most, a part of a
/// longer lane, so a vocabulary's lane spreads over the device.
global ARG_MAX_PART: i32 = 4096;

/// The WGSL writing, one workgroup per lane along the last of `rank` axes, the
/// index of the lane's first greatest element as an f32. A NaN is greatest,
/// as `Cpu`'s `>` orders it; WGSL may assume a comparison meets none, so its
/// bits say what it is. Parameters: the workgroups, the workgroups per row of
/// the grid, the lane's length, the parts of a lane, the extents, then the
/// view of the operand. A `Parts` dispatch writes each part's greatest element
/// and its index as an f32 pair, and `Combine` reads those pairs.
fn arg_max_shader(bindings: &List<i32>, rank: i32, stage: ArgMaxStage) -> String {
    let at = 4 + rank;
    let index = index_wgsl(at, 0, rank - 1, "c", `bitcast<i32>(p[${at}])`);
    let direct = `        let x = o${bindings[0]}[u32(${index} + i32(j) * bitcast<i32>(p[${at + rank}]))];
        let i = j;
`;
    let [range, read, write] = match stage {
        Whole => [
            `    let row = flat;
${coords_wgsl("row", 4, 0, rank - 1, "c", "    ")}    let first = 0u;
    let end = p[2];
`, direct, "        out[row] = f32(indices[0]);\n",
        ],
        Parts => [
            `    let row = flat / p[3];
    let first = flat % p[3] * ${ARG_MAX_PART}u;
    let end = min(p[2], first + ${ARG_MAX_PART}u);
${coords_wgsl("row", 4, 0, rank - 1, "c", "    ")}`, direct,
            "        out[2u * flat] = values[0];\n        out[2u * flat + 1u] = f32(indices[0]);\n",
        ],
        Combine => [
            "    let row = flat;\n    let first = 0u;\n    let end = p[3];\n",
            `        let pair = p[${at}] + 2u * (row * p[3] + j);
        let x = o${bindings[0]}[pair];
        let i = u32(o${bindings[0]}[pair + 1u]);
`, "        out[row] = f32(indices[0]);\n",
        ],
    };
    return `${buffers_wgsl(1 + max_of(bindings), null)}
var<workgroup> values: array<f32, ${LANES}>;
var<workgroup> indices: array<u32, ${LANES}>;

const NONE = 0xffffffffu;

fn is_nan(x: f32) -> bool {
    return (bitcast<u32>(x) & 0x7fffffffu) > 0x7f800000u;
}

// Whether a at i comes before b at j: greater, or equal and earlier.
fn before(a: f32, i: u32, b: f32, j: u32) -> bool {
    if i == NONE {
        return false;
    }
    if j == NONE {
        return true;
    }
    if is_nan(a) || is_nan(b) {
        return is_nan(a) && (!is_nan(b) || i < j);
    }
    return a > b || (a == b && i < j);
}

@compute @workgroup_size(${LANES})
fn main(@builtin(workgroup_id) group: vec3<u32>, @builtin(local_invocation_index) lid: u32) {
    let flat = group.x + group.y * p[1];
    if flat >= p[0] {
        return;
    }
${range}    var best = 0.0;
    var at = NONE;
    for (var j = first + lid; j < end; j += ${LANES}u) {
${read}        if before(x, i, best, at) {
            best = x;
            at = i;
        }
    }
    values[lid] = best;
    indices[lid] = at;
    workgroupBarrier();
    for (var w = ${LANES / 2}u; w > 0u; w = w >> 1u) {
        if lid < w && before(values[lid + w], indices[lid + w], values[lid], indices[lid]) {
            values[lid] = values[lid + w];
            indices[lid] = indices[lid + w];
        }
        workgroupBarrier();
    }
    if lid == 0u {
${write}    }
}
`;
}

/// The WGSL an elementwise kernel runs: `op` at each output position of a
/// rank-`rank` output, operand `k` read from binding `bindings[k]`.
/// Parameters: the count, the invocations per row of workgroups, the output's
/// extents, then each operand's offset and strides over them.
fn elementwise_shader(op: &Expr, bindings: &List<i32>, rank: i32) -> String {
    let buffers = 1 + max_of(bindings);
    let mut body = coords_wgsl("i", 2, 0, rank, "c", "    ");
    for let [k, binding] of bindings.into_iter().enumerate() {
        let at = 2 + rank + k * (rank + 1);
        let index = index_wgsl(at, 0, rank, "c", `bitcast<i32>(p[${at}])`);
        body.push_str(`    let x${k} = o${binding}[u32(${index})];\n`);
    }
    body.push_str(&steps_wgsl(op, op.steps.len() - 1, "    "));
    return `${buffers_wgsl(buffers, null)}
@compute @workgroup_size(${LANES})
fn main(@builtin(global_invocation_id) id: vec3<u32>) {
    let i = id.x + id.y * p[1];
    if i >= p[0] {
        return;
    }
${body}    out[i] = s${op.steps.len() - 1};
}
${ELEMENTWISE_OPERATORS}`;
}

/// The WGSL a row kernel runs: one workgroup per row, a row being the last
/// `row_axes` of `rank` axes. Each `Fold` step is folded over the row by the
/// workgroup before the steps that read it, which then read it at every
/// element. Parameters: the rows, the workgroups per row of the grid, the
/// elements per row, the extents, then each operand's offset and strides.
fn row_shader(op: &Expr, bindings: &List<i32>, rank: i32, row_axes: i32, reduced: bool) -> String {
    let buffers = 1 + max_of(bindings);
    let lead = rank - row_axes;
    // Each operand's index at the row's start, which every element adds to.
    let mut prelude = coords_wgsl("row", 3, 0, lead, "r", "    ");
    for let [k, _] of bindings.into_iter().enumerate() {
        let at = 3 + rank + k * (rank + 1);
        prelude.push_str(`    let base${k} = ${index_wgsl(at, 0, lead, "r", `bitcast<i32>(p[${at}])`)};\n`);
    }
    // The steps at element `e` of the row, up to `last`.
    let element = |last: i32| {
        let mut code = coords_wgsl("e", 3, lead, rank, "t", "        ");
        for let [k, binding] of bindings.into_iter().enumerate() {
            let at = 3 + rank + k * (rank + 1);
            code.push_str(`        let x${k} = o${binding}[u32(${index_wgsl(at, lead, rank, "t", `base${k}`)})];\n`);
        }
        code.push_str(&steps_wgsl(op, last, "        "));
        return code;
    };
    let mut phases = "";
    let mut fold = 0;
    for let step of op.steps {
        let Fold([kind, a]) = step else {
            continue;
        };
        let value = `${element(a)}        let v = s${a};\n`;
        phases.push_str(`    {\n${fold_wgsl(kind, value, "e", "len", LANES, `folds[${fold}]`, "        ")}    }\n`);
        fold += 1;
    }
    let last = op.steps.len() - 1;
    let write = if reduced {
        `    if lid == 0u {
        let e = 0u;
${element(last)}        out[row] = s${last};
    }
`;
    } else {
        `    for (var e = lid; e < len; e += ${LANES}u) {
${element(last)}        out[row * len + e] = s${last};
    }
`;
    };
    return `${buffers_wgsl(buffers, null)}
var<workgroup> partial: array<f32, ${LANES}>;
var<workgroup> folds: array<f32, ${fold_slots(op)}>;

@compute @workgroup_size(${LANES})
fn main(@builtin(workgroup_id) group: vec3<u32>, @builtin(local_invocation_index) lid: u32) {
    let row = group.x + group.y * p[1];
    if row >= p[0] {
        return;
    }
    let len = p[2];
${prelude}${phases}${write}}
${ELEMENTWISE_OPERATORS}`;
}

/// The WGSL copying a view to another of one extents, widening a `half`
/// source. Parameters: the count, the invocations per row, the extents, then
/// the source's offset and strides and the destination's.
fn copy_shader(rank: i32, half: bool) -> String {
    let from = 2 + rank;
    let to = from + rank + 1;
    let source = index_wgsl(from, 0, rank, "c", `bitcast<i32>(p[${from}])`);
    return `@group(0) @binding(0) var<storage, read> src: array<${word_wgsl(half)}>;
@group(0) @binding(1) var<storage, read_write> dst: array<f32>;
@group(0) @binding(2) var<storage, read> p: array<u32>;

@compute @workgroup_size(${LANES})
fn main(@builtin(global_invocation_id) id: vec3<u32>) {
    let i = id.x + id.y * p[1];
    if i >= p[0] {
        return;
    }
${coords_wgsl("i", 2, 0, rank, "c", "    ")}    dst[u32(${index_wgsl(to, 0, rank, "c", `bitcast<i32>(p[${to}])`)})] = ${element_wgsl(
        "src",
        `u32(${source})`,
        half,
    )};
}
`;
}

/// The WGSL of a gather along `axis`, the indices' axes flattened to it.
/// Parameters: the count, the invocations per row, the output's extents, the
/// data's offset and its stride along each output axis, 0 along `axis`, its
/// stride along `axis`, the index the output's first row along `axis` reads,
/// then the output's offset and strides. A `half` data is widened.
fn gather_shader(rank: i32, axis: i32, half: bool) -> String {
    let data = 2 + rank;
    let along = data + rank + 1;
    let first = along + 1;
    let out = first + 1;
    let source = index_wgsl(data, 0, rank, "c", `bitcast<i32>(p[${data}])`);
    return `@group(0) @binding(0) var<storage, read> data: array<${word_wgsl(half)}>;
@group(0) @binding(1) var<storage, read> indices: array<u32>;
@group(0) @binding(2) var<storage, read_write> out: array<f32>;
@group(0) @binding(3) var<storage, read> p: array<u32>;

@compute @workgroup_size(${LANES})
fn main(@builtin(global_invocation_id) id: vec3<u32>) {
    let i = id.x + id.y * p[1];
    if i >= p[0] {
        return;
    }
${coords_wgsl("i", 2, 0, rank, "c", "    ")}    let picked = i32(indices[p[${first}] + c${axis}]);
    out[u32(${index_wgsl(out, 0, rank, "c", `bitcast<i32>(p[${out}])`)})] = ${element_wgsl(
        "data",
        `u32(${source} + picked * bitcast<i32>(p[${along}]))`,
        half,
    )};
}
`;
}

/// The WGSL of a batched matrix product in 16 by 16 tiles, one workgroup per
/// output tile of one batch element, `op` applied to each element of the
/// result once its sum is complete, read as `operand(0)`; its other operands
/// are read from `bindings[2..]`. Parameters: rows, inner, cols, the `batch`
/// extents, then for each matrix its offset, batch strides and its two matrix
/// strides, then each epilogue operand's offset and strides over
/// `[..batch, rows, cols]`. Where `continued`, the sums start from a partial
/// result laid out as the output is, the last binding, after whose offset the
/// parameters end. Where `half`, the right matrix is bf16, widened as read.
/// Where `across`, the right matrix is contiguous along its inner axis, so a
/// tile of it is read with neighbouring lanes along that axis.
fn product_shader(op: &Expr, bindings: &List<i32>, batch: i32, continued: bool, half: bool, across: bool) -> String {
    // The tile element a lane loads of the right matrix: its step of the inner
    // axis and its column, each within the tile.
    let [step, column] = if across { ["local.x", "local.y"] } else { ["local.y", "local.x"] };
    let mut start = "";
    if continued {
        start = `    if row < rows && col < cols {
        acc = ${product_partial(bindings, batch)};
    }
`;
    }
    return `${buffers_wgsl(1 + max_of(bindings), right_binding(bindings, half))}
var<workgroup> ta: array<f32, 256>;
var<workgroup> tb: array<f32, 256>;

@compute @workgroup_size(16, 16)
fn main(@builtin(workgroup_id) group: vec3<u32>, @builtin(local_invocation_id) local: vec3<u32>) {
${product_bases(batch)}    let row = group.y * 16u + local.y;
    let col = group.x * 16u + local.x;
    var acc = 0.0;
${start}    for (var t = 0u; t < (inner + 15u) / 16u; t++) {
        let ka = t * 16u + local.x;
        var va = 0.0;
        if row < rows && ka < inner {
            va = o${bindings[0]}[u32(a_base + i32(row) * a_row + i32(ka) * a_inner)];
        }
        ta[local.y * 16u + local.x] = va;
        let kb = t * 16u + ${step};
        let cb = group.x * 16u + ${column};
        var vb = 0.0;
        if kb < inner && cb < cols {
            vb = ${right_wgsl(bindings, half, "kb", "cb")};
        }
        tb[${step} * 16u + ${column}] = vb;
        workgroupBarrier();
        for (var k = 0u; k < 16u; k++) {
            acc += ta[local.y * 16u + k] * tb[k * 16u + local.x];
        }
        workgroupBarrier();
    }
    if row < rows && col < cols {
${product_epilogue(op, bindings, batch, continued, false, 0)}    }
}
${ELEMENTWISE_OPERATORS}`;
}

/// The WGSL of [`product_shader`]'s product where it has at most `NARROW_ROWS`
/// rows, as a model's step over one token or a short prompt has: one
/// workgroup per run of columns, its lanes splitting the inner axis and their
/// sums added in workgroup memory, `NARROW` rows at a time. Where `across`,
/// the right matrix is read along its inner axis, which is where it is
/// contiguous, as a transposed weight is: a run of lanes reads one column.
/// Otherwise a run of lanes reads one row's run of columns. A workgroup
/// computes `lanes` columns, as `narrow_columns` counts them for a lane
/// reading one element. The parameters and `half` are the tiled shader's.
/// Where `width` is 2, the right matrix is bf16 and each lane reads a word,
/// two elements of it: two steps of the inner axis where `across`, two
/// columns otherwise. Where `paired`, the right matrix interleaves two, and
/// each even column's lane writes through `op` what its column and the next
/// one sum, as `product_epilogue` says. Where `staged`, the left matrix is
/// what its prologue computes, block by block into workgroup memory, and
/// binding `bindings[0]` is read for nothing.
fn narrow_product_shader(
    op: &Expr,
    bindings: &List<i32>,
    batch: i32,
    continued: bool,
    across: bool,
    half: bool,
    width: i32,
    lanes: i32,
    paired: bool,
    staged: &Option<Staged>,
) -> String {
    assert width == 1 || half && width == 2;
    assert !paired || across && !continued && lanes % 2 == 0, "a pair's sums meet in one workgroup";
    assert !continued || staged matches { None }, "a prologue reads the whole inner axis";
    let splits = NARROW_LANES / lanes;
    assert splits * lanes == NARROW_LANES && splits & splits - 1 == 0, "the parts add in halves";
    // The columns a lane sums, and the steps of the inner axis it reads at once.
    let [lane_cols, steps] = if across { [1, width] } else { [width, 1] };
    let [col, split, stride] = if across {
        [`group.x * ${lanes}u + lid / ${splits}u`, `lid % ${splits}u`, "1u"];
    } else {
        [`group.x * ${lanes * width}u + lid % ${lanes}u * ${width}u`, `lid / ${lanes}u`, `${lanes}u`];
    };
    let [stage, staging, prologue_operands] = match staged {
        Some(s) => [
            stage_wgsl(s, bindings, batch),
            staged_wgsl(s),
            s.operands,
        ],
        None => ["", "", 0],
    };
    let lhs: fn(String) -> String = match staged {
        Some(s) => |k: String| `staged[b * ${s.inner}u + ${k}]`,
        None => |k: String| `o${bindings[0]}[u32(a_base + i32(r0 + b) * a_row + i32(${k}) * a_inner)]`,
    };
    let sum = if width == 1 {
        `                let vb = ${right_wgsl(bindings, half, "k")};
                for (var b = 0u; b < block; b++) {
                    sums[b] += ${lhs("k")} * vb;
                }
`;
    } else {
        let pair = `                let w = o${bindings[1]}[${right_index_wgsl("k")} >> 1u];
                let v0 = bitcast<f32>(w << 16u);
                let v1 = bitcast<f32>(w & 0xFFFF0000u);
`;
        if across {
            `${pair}                for (var b = 0u; b < block; b++) {
                    sums[b] += ${lhs("k")} * v0;
                    if k + 1u < inner {
                        sums[b] += ${lhs("k + 1u")} * v1;
                    }
                }
`;
        } else {
            `${pair}                for (var b = 0u; b < block; b++) {
                    let x = ${lhs("k")};
                    sums[b * 2u] += x * v0;
                    sums[b * 2u + 1u] += x * v1;
                }
`;
        }
    };
    let start = if continued { product_partial(bindings, batch) } else { "0.0" };
    // Where `across`, the next column's sum is a column's lanes further on.
    let pair_sum = if paired {
        `                        let acc_pair = partial[b * ${NARROW_LANES}u + lid + ${splits}u];\n`;
    } else {
        "";
    };
    return `${buffers_wgsl(1 + max_of(bindings), right_binding(bindings, half))}
var<workgroup> partial: array<f32, ${NARROW * lane_cols * NARROW_LANES}>;
${staging}
@compute @workgroup_size(${NARROW_LANES})
fn main(@builtin(workgroup_id) group: vec3<u32>, @builtin(local_invocation_index) lid: u32) {
${product_bases(batch)}    let col = ${col};
    let split = ${split};
    for (var r0 = 0u; r0 < rows; r0 += ${NARROW}u) {
        let block = min(rows - r0, ${NARROW}u);
${stage}        var sums = array<f32, ${NARROW * lane_cols}>();
        if col < cols {
            for (var k = split * ${steps}u; k < inner; k += ${splits * steps}u) {
${sum}            }
        }
        for (var i = 0u; i < ${NARROW * lane_cols}u; i++) {
            partial[i * ${NARROW_LANES}u + lid] = sums[i];
        }
        workgroupBarrier();
        // Each column's parts add in halves, so the first split holds the sum.
        for (var h = ${splits / 2}u; h > 0u; h >>= 1u) {
            if split < h {
                for (var i = 0u; i < ${NARROW * lane_cols}u; i++) {
                    partial[i * ${NARROW_LANES}u + lid] += partial[i * ${NARROW_LANES}u + lid + h * ${stride}];
                }
            }
            workgroupBarrier();
        }
        if split == 0u && col < cols${if paired { " && col % 2u == 0u" } else { "" }} {
            let first = col;
            for (var b = 0u; b < block; b++) {
                let row = r0 + b;
                for (var j = 0u; j < ${lane_cols}u; j++) {
                    let col = first + j;
                    if col < cols {
                        let acc = ${start} + partial[(b * ${lane_cols}u + j) * ${NARROW_LANES}u + lid];
${pair_sum}${product_epilogue(op, bindings, batch, continued, paired, prologue_operands)}                    }
                }
            }
        }
        // The next block's sums overwrite these.
        workgroupBarrier();
    }
}
${ELEMENTWISE_OPERATORS}`;
}

/// The elements of `rhs`, a product's right matrix, that one word read gives
/// [`narrow_product_shader`]: 2 where it is bf16 and each word starts at an
/// even element along the axis read contiguously, the inner one where
/// `across` and the columns otherwise, and 1 elsewhere.
fn word_width(rhs: &DeviceTensor, across: bool) -> i32 {
    let r = rhs.extents.len();
    let unit = if across { r - 2 } else { r - 1 };
    if !rhs.half || rhs.strides[unit] != 1 || rhs.offset % 2 != 0 {
        return 1;
    }
    for let d of 0..<r {
        if d != unit && rhs.strides[d] % 2 != 0 {
            return 1;
        }
    }
    return 2;
}

/// The binding a product's right matrix is read from where it is bf16.
fn right_binding(bindings: &List<i32>, half: bool) -> Option<i32> {
    if !half {
        return null;
    }
    let mut readers = 0;
    for let b of *bindings {
        if b == bindings[1] {
            readers += 1;
        }
    }
    assert readers == 1, "a bf16 binding holds the right matrix alone";
    return Option::Some(bindings[1]);
}

/// A product's right matrix at the inner index `k` and column `column`.
fn right_wgsl(bindings: &List<i32>, half: bool, k: String, column: String = "col") -> String {
    return element_wgsl(`o${bindings[1]}`, right_index_wgsl(k, column), half);
}

/// The element index, a `u32`, of a product's right matrix at the inner index
/// `k` and column `column`.
fn right_index_wgsl(k: String, column: String = "col") -> String {
    return `u32(b_base + i32(${k}) * b_inner + i32(${column}) * b_col)`;
}

/// The columns one workgroup of [`narrow_product_shader`] computes of a
/// product of `cols` columns, whose lanes read `width` elements at once.
/// Where `across`, a column's lanes split the inner axis, so fewer columns a
/// workgroup means more workgroups and a longer sum of each column's parts:
/// the most columns that still leave `NARROW_GROUPS` workgroups, and at least
/// 4. On Gemma 3 (270M)'s layers each of 2048, 1024, 640 and 256 columns runs
/// fastest at the count this picks.
fn narrow_columns(across: bool, width: i32, cols: i32) -> i32 {
    if !across {
        return 32 * width;
    }
    let mut columns = 16;
    while columns > 4 && cols / columns < NARROW_GROUPS {
        columns /= 2;
    }
    return columns;
}

/// Lines binding a product's extents, the bases of its two matrices for the
/// batch element `group.z`, and their matrix strides.
fn product_bases(batch: i32) -> String {
    let a = 3 + batch;
    let b = a + batch + 3;
    return `    let rows = p[0];
    let inner = p[1];
    let cols = p[2];
${coords_wgsl("group.z", 3, 0, batch, "c", "    ")}    let a_base = ${index_wgsl(
        a,
        0,
        batch,
        "c",
        `bitcast<i32>(p[${a}])`,
    )};
    let b_base = ${index_wgsl(b, 0, batch, "c", `bitcast<i32>(p[${b}])`)};
    let a_row = bitcast<i32>(p[${a + batch + 1}]);
    let a_inner = bitcast<i32>(p[${a + batch + 2}]);
    let b_inner = bitcast<i32>(p[${b + batch + 1}]);
    let b_col = bitcast<i32>(p[${b + batch + 2}]);
`;
}

/// The sums a product's chunk before left at `row` and `col`.
fn product_partial(bindings: &List<i32>, batch: i32) -> String {
    let last = bindings.len() - 1;
    let at = epilogue_params(batch) + (last - 2) * (batch + 3);
    return `o${bindings[last]}[p[${at}] + group.z * rows * cols + row * cols + col]`;
}

/// Lines writing a product's element at `row` and `col` from its sum `acc`,
/// through `op` over the epilogue's operands, which the last
/// `prologue_operands` bindings are not. Where `paired`, `col` is even and
/// `acc_pair` is the next column's sum: the two are `op`'s first two
/// operands, and the element written is the pair's, at `col / 2`.
fn product_epilogue(
    op: &Expr,
    bindings: &List<i32>,
    batch: i32,
    continued: bool,
    paired: bool,
    prologue_operands: i32,
) -> String {
    let rank = batch + 2;
    let first = epilogue_params(batch);
    let read = bindings.len() - if continued { 1 } else { 0 } - prologue_operands;
    let [written, column, sums] = if paired { ["(cols / 2u)", "col / 2u", 2] } else { ["cols", "col", 1] };
    let mut out = `        let c${batch} = row;\n        let c${batch + 1} = ${column};\n`;
    for let k of 2..<read {
        let at = first + (k - 2) * (rank + 1);
        let index = index_wgsl(at, 0, rank, "c", `bitcast<i32>(p[${at}])`);
        out.push_str(`        let x${k - 2 + sums} = o${bindings[k]}[u32(${index})];\n`);
    }
    out.push_str("        let x0 = acc;\n");
    if paired {
        out.push_str("        let x1 = acc_pair;\n");
    }
    out.push_str(&steps_wgsl(op, op.steps.len() - 1, "        "));
    out.push_str(`        out[group.z * rows * ${written} + row * ${written} + ${column}] = s${op.steps.len() - 1};\n`);
    return out;
}

/// Where a product's parameters for its first epilogue operand start, past
/// its extents and its two matrices' views.
fn epilogue_params(batch: i32) -> i32 {
    return 3 + batch + batch + 3 + batch + 3;
}

/// The prologue [`narrow_product_shader`] computes its left matrix with: `op`
/// over the last `operands` bindings, each read under the left matrix's
/// `[..batch, rows, inner]` after the epilogue's operands' parameters. A block
/// of at most `rows` rows is staged at a time.
struct Staged {
    op: Expr,
    operands: i32,
    rows: i32,
    inner: i32,
}

/// The workgroup memory a [`Staged`] prologue takes: its block of rows, and
/// each row's folds.
fn staged_wgsl(s: &Staged) -> String {
    return `var<workgroup> staged: array<f32, ${s.rows * s.inner}>;
var<workgroup> staged_folds: array<f32, ${s.rows * fold_slots(&s.op)}>;
`;
}

/// The workgroup memory a [`Staged`] prologue takes, in bytes.
fn staged_bytes(s: &Staged) -> i32 {
    return 4 * s.rows * (s.inner + fold_slots(&s.op));
}

/// The folds a shader keeps for each row of `op`: one at least, as a WGSL
/// array is never empty.
fn fold_slots(op: &Expr) -> i32 {
    return i32::max(op.fold_count(), 1);
}

/// Lines folding `kind` over `index` from `lid` up to `bound`, `lanes` at a
/// time, `value` being the lines that bind the value at `index` to `v`. Each
/// lane folds its part, the parts add in halves through `partial`, and lane 0
/// stores the whole to `target`.
fn fold_wgsl(
    kind: RowOp,
    value: String,
    index: String,
    bound: String,
    lanes: i32,
    target: String,
    indent: String,
) -> String {
    let [init, combine] = match kind {
        Sum => ["0.0", "acc + v"],
        Max => ["bitcast<f32>(0xff800000u)", "max(acc, v)"],
    };
    let tree = combine.replace("acc", "partial[lid]").replace("v", "partial[lid + h]");
    return `${indent}var acc = ${init};
${indent}for (var ${index} = lid; ${index} < ${bound}; ${index} += ${lanes}u) {
${value}${indent}    acc = ${combine};
${indent}}
${indent}partial[lid] = acc;
${indent}workgroupBarrier();
${indent}for (var h = ${lanes / 2}u; h > 0u; h >>= 1u) {
${indent}    if lid < h {
${indent}        partial[lid] = ${tree};
${indent}    }
${indent}    workgroupBarrier();
${indent}}
${indent}if lid == 0u {
${indent}    ${target} = partial[0];
${indent}}
${indent}workgroupBarrier();
`;
}

/// Lines computing the block of rows from `r0` of a [`Staged`] prologue into
/// `staged`: each fold along each row, then each element.
fn stage_wgsl(s: &Staged, bindings: &List<i32>, batch: i32) -> String {
    let rank = batch + 2;
    let folds = fold_slots(&s.op);
    let first_operand = bindings.len() - s.operands;
    let first_param = epilogue_params(batch) + (first_operand - 2) * (rank + 1);
    // The steps up to `last` at row `r0 + b` and inner index `k`, the row's
    // folds so far read from `staged_folds`.
    let element = |last: i32, indent: String| {
        let mut code = `${indent}var folds = array<f32, ${folds}>();
${indent}for (var f = 0u; f < ${folds}u; f++) {
${indent}    folds[f] = staged_folds[b * ${folds}u + f];
${indent}}
${indent}let c${batch} = r0 + b;
${indent}let c${batch + 1} = k;
`;
        for let j of 0..<s.operands {
            let at = first_param + j * (rank + 1);
            let index = index_wgsl(at, 0, rank, "c", `bitcast<i32>(p[${at}])`);
            code.push_str(`${indent}let x${j} = o${bindings[first_operand + j]}[u32(${index})];\n`);
        }
        code.push_str(&steps_wgsl(&s.op, last, indent));
        return code;
    };
    let mut out = "";
    let mut fold = 0;
    for let step of s.op.steps {
        let Fold([kind, a]) = step else {
            continue;
        };
        let value = `${element(a, "                ")}                let v = s${a};\n`;
        let target = `staged_folds[b * ${folds}u + ${fold}u]`;
        let phase = fold_wgsl(kind, value, "k", "inner", NARROW_LANES, target, "            ");
        out.push_str(`        for (var b = 0u; b < block; b++) {\n${phase}        }\n`);
        fold += 1;
    }
    let last = s.op.steps.len() - 1;
    out.push_str(`        for (var e = lid; e < block * ${s.inner}u; e += ${NARROW_LANES}u) {
            let b = e / ${s.inner}u;
            let k = e % ${s.inner}u;
${element(last, "            ")}            staged[e] = s${last};
        }
        workgroupBarrier();
`);
    return out;
}

/// A reference to the tensor `t` holds, where it holds one.
fn optional<E, Axes>(t: &Option<Tensor<E, Axes>>) -> Option<&Tensor<E, Axes>> {
    return match t {
        Some(held) => Option::Some(held),
        None => null,
    };
}

fn max_of(values: &List<i32>) -> i32 {
    let mut m = -1;
    for let v of *values {
        m = i32::max(m, v);
    }
    return m;
}

fn unary_wgsl(op: UnaryOp, v: String) -> String {
    return match op {
        Relu => `max(${v}, 0.0)`,
        Sigmoid => `sigmoid_(${v})`,
        Tanh => `tanh(${v})`,
        Erf => `erf_(${v})`,
        Exp => `exp(${v})`,
        Log => `log(${v})`,
        Sqrt => `sqrt(${v})`,
        Neg => `-(${v})`,
        Abs => `abs(${v})`,
    };
}

fn binary_wgsl(op: BinaryOp, a: String, b: String) -> String {
    return match op {
        Add => `(${a} + ${b})`,
        Sub => `(${a} - ${b})`,
        Mul => `(${a} * ${b})`,
        Div => `(${a} / ${b})`,
        Pow => `pow_(${a}, ${b})`,
    };
}

/// The operators WGSL does not have as ONNX defines them, which every shader
/// computing an `Expr` carries.
global ELEMENTWISE_OPERATORS: String = "
fn sigmoid_(v: f32) -> f32 {
    if v >= 0.0 {
        return 1.0 / (1.0 + exp(-v));
    }
    let e = exp(v);
    return e / (1.0 + e);
}

// Abramowitz and Stegun 7.1.26, within 1.5e-7 of erf.
fn erf_(v: f32) -> f32 {
    let x = abs(v);
    let t = 1.0 / (1.0 + 0.3275911 * x);
    let poly = t * (0.254829592 + t * (-0.284496736 + t * (1.421413741 + t * (-1.453152027 + t * 1.061405429))));
    return sign(v) * (1.0 - poly * exp(-x * x));
}

// WGSL's pow is undefined below zero, where ONNX's takes an integral exponent,
// and at zero to a power not above zero, where ONNX's is 1 or infinite.
fn pow_(x: f32, y: f32) -> f32 {
    if y == 0.0 {
        return 1.0;
    }
    if x == 0.0 {
        if y < 0.0 {
            return bitcast<f32>(0x7f800000u);
        }
        return 0.0;
    }
    if x > 0.0 || y != floor(y) {
        return pow(x, y);
    }
    let magnitude = pow(-x, y);
    if (y * 0.5) == floor(y * 0.5) {
        return magnitude;
    }
    return -magnitude;
}
";
