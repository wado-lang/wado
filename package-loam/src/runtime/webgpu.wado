        return Placed::Host(self.cpu.conv::<N, Ci, Co, [..In], [..K], [..Out]>(&self.host(x), &self.host(w), window));
    }

    fn conv_bias<N, Ci, Co, ..In, ..K, ..Out>(
        &mut self,
        x: &Placed<f32, [N, Ci, ..In]>,
        w: &Placed<f32, [Co, Ci, ..K]>,
        b: &Placed<f32, [Co]>,
