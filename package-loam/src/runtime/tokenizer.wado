//! Byte-pair encoding (Sennrich et al. 2016) in the two spellings Hugging Face
//! tokenizers write down. GPT-2's (Radford et al. 2019, § 2.2) splits text by
//! its pattern and spells each piece as bytes. SentencePiece's (Kudo and
//! Richardson 2018), as Gemma uses it, spells each space as `▁`, takes the
//! whole text as one piece, and spells a character the vocabulary lacks as its
//! UTF-8 bytes, each a `<0xXX>` token. A generated tokenizer builds one from the
//! vocabulary and merges its `tokenizer.json` names.

use { TreeMap } from "core:collections";
use icu from "core:icu";

/// How a tokenizer spells text before it merges, and back after.
pub enum TokenSpelling {
    /// GPT-2's: each piece of its pattern as bytes, each byte a character.
    ByteLevel,
    /// SentencePiece's: each space as `▁`, each character as itself, and one
    /// the vocabulary lacks as its bytes.
    Pieces,
}

/// The character SentencePiece spells a space as.
global SPACE_PIECE: char = '▁';

/// A BPE tokenizer.
pub struct BpeTokenizer {
    spelling: TokenSpelling,
    ids: TreeMap<String, i32>,
    tokens: List<String>,
    /// Each mergeable pair of ids, keyed by `pair_key`, as `[rank, merged id]`:
    /// the lowest rank merges first.
    merges: TreeMap<i64, [i32, i32]>,
    /// The added tokens, matched in the text as they stand before it is split.
    specials: List<String>,
    /// Whether each id is an added token, which decodes as its own text.
    special_ids: List<bool>,
    /// The id of the token each byte is spelled as, -1 where none is.
    byte_ids: List<i32>,
    /// The byte each id stands for where it stands for one byte, -1 elsewhere:
    /// under `ByteLevel` a character of the byte alphabet, by code point, and
    /// under `Pieces` a `<0xXX>` token, by id.
    bytes_of: List<i32>,
    /// What a character no token and no byte spells encodes as, -1 for none.
    unknown: i32,
    /// The ids every encoding starts with.
    prefix: List<i32>,
    letters: List<[u32, u32]>,
    numbers: List<[u32, u32]>,
}

enum Class {
    Space,
    Letter,
    Number,
    Other,
}

impl BpeTokenizer {
    /// `tokens` holds each token, its id the index, separated by NUL bytes.
    /// `merges` holds three little-endian `i32`s per merge by rank: the two ids
    /// it joins, then the id they join to. `specials` are matched in the text
    /// as they stand, before it is split. Under `ByteLevel` every byte's
    /// character is a token; under `Pieces` the `<0xXX>` tokens spell the
    /// bytes, and `unknown` names the token a character neither spells.
    pub fn new(
        tokens: &ByteList,
        merges: &ByteList,
        specials: List<String>,
        spelling: TokenSpelling,
        unknown: i32,
        prefix: List<i32>,
    ) -> BpeTokenizer {
        let tokens = entries_of(tokens);
        let mut ids = TreeMap::<String, i32>::new();
        for let [id, token] of tokens.into_iter().enumerate() {
            ids.try_insert(token, id);
        }
        let mut merge_ranks = TreeMap::<i64, [i32, i32]>::new();
        let triples = List::<i32>::from_le_bytes(*merges);
        for let rank of 0..<triples.len() / 3 {
            merge_ranks.try_insert(pair_key(triples[rank * 3], triples[rank * 3 + 1]), [rank, triples[rank * 3 + 2]]);
        }
        let mut special_ids = List::<bool>::filled(tokens.len(), false);
        for let special of specials {
            special_ids[ids.get(special).unwrap()] = true;
        }
        let mut byte_ids = List::<i32>::filled(256, -1);
        let mut bytes_of: List<i32> = [];
        match spelling {
            ByteLevel => {
                for let [b, c] of byte_chars().into_iter().enumerate() {
                    byte_ids[b] = ids.get(char_string(c)).unwrap();
                    while bytes_of.len() <= c as i32 {
                        bytes_of.push(-1);
                    }
                    bytes_of[c as i32] = b;
                }
            },
            Pieces => {
                bytes_of = List::<i32>::filled(tokens.len(), -1);
                for let b of 0..<256 {
                    if let Some(id) = ids.get(byte_token(b)) {
                        byte_ids[b] = id;
                        bytes_of[id] = b;
                    }
                }
            },
        }
        return BpeTokenizer {
            spelling,
            ids,
            tokens,
            merges: merge_ranks,
            specials,
            special_ids,
            byte_ids,
            bytes_of,
            unknown,
            prefix,
            letters: icu::value_ranges("gc", "L").unwrap(),
            numbers: icu::value_ranges("gc", "N").unwrap(),
        };
    }

    /// The ids `text` encodes to.
    pub fn encode(&self, text: &String) -> List<i32> {
        let mut out = self.prefix;
        let mut rest = text.as_str_slice();
        loop {
            let Some([at, special]) = self.next_special(rest) else {
                self.encode_ordinary(rest, &mut out);
                return out;
            };
            self.encode_ordinary(rest.slice(0, at), &mut out);
            out.push(self.ids.get_str(&special).unwrap());
            rest = rest.slice(at + special.len(), rest.len());
        }
    }

    /// The text `ids` decode to. Each token stands for the bytes its spelling
    /// spells, but under `ByteLevel` an added token is its own text. A byte
    /// sequence that is not UTF-8 decodes with U+FFFD in its place, as a token
    /// boundary can split a character.
    pub fn decode(&self, ids: &List<i32>) -> String {
        let mut bytes: ByteList = [];
        for let id of *ids {
            let token = &self.tokens[id];
            match self.spelling {
                ByteLevel => {
                    if self.special_ids[id] {
                        bytes.extend_from_slice(token.as_bytes() as Slice<u8>);
                        continue;
                    }
                    for let c of token.chars() {
                        bytes.push(self.bytes_of[c as i32] as u8);
                    }
                },
                Pieces => {
                    if self.bytes_of[id] >= 0 {
                        bytes.push(self.bytes_of[id] as u8);
                        continue;
                    }
                    for let c of token.chars() {
                        if c == SPACE_PIECE {
                            bytes.push(b' ');
                        } else {
                            push_utf8(&mut bytes, c);
                        }
                    }
                },
            }
        }
        return String::from_utf8_lossy(bytes);
    }

    /// The special token that starts first in `text`, the longest of those
    /// starting there, and where it starts.
    fn next_special(&self, text: StrSlice) -> Option<[i32, String]> {
        let mut first: Option<[i32, String]> = null;
        for let special of self.specials {
            let Some(at) = text.find(&special) else {
                continue;
            };
            let better = match first {
                None => true,
                Some([earlier, held]) => at < earlier || at == earlier && special.len() > held.len(),
            };
            if better {
                first = Option::Some([at, special]);
            }
        }
        return first;
    }

    fn encode_ordinary(&self, text: StrSlice, out: &mut List<i32>) {
        if text.is_empty() {
            return;
        }
        if self.spelling matches { Pieces } {
            let mut parts: List<i32> = [];
            for let c of text.chars() {
                self.spell_piece(if c == ' ' { SPACE_PIECE } else { c }, &mut parts);
            }
            self.merge(parts, out);
            return;
        }
        let chars: List<char> = text.chars().collect();
        let mut at = 0;
        while at < chars.len() {
            let end = self.piece_end(&chars, at);
            let mut parts: List<i32> = [];
            for let k of at..<end {
                let mut utf8: ByteList = [];
                push_utf8(&mut utf8, chars[k]);
                for let b of utf8 {
                    parts.push(self.byte_ids[b as i32]);
                }
            }
            self.merge(parts, out);
            at = end;
        }
    }

    /// `c` as `Pieces` spells it before merging: its own token, else its
    /// bytes', else the unknown token, one for a run of them.
    fn spell_piece(&self, c: char, parts: &mut List<i32>) {
        if let Some(id) = self.ids.get(char_string(c)) {
            parts.push(id);
            return;
        }
        let mut utf8: ByteList = [];
        push_utf8(&mut utf8, c);
        if utf8.into_iter().all(|b| self.byte_ids[b as i32] >= 0) {
            for let b of utf8 {
                parts.push(self.byte_ids[b as i32]);
            }
            return;
        }
        if parts.last() != Option::Some(self.unknown) {
            parts.push(self.unknown);
        }
    }

    /// Where the piece starting at `at` ends, as GPT-2's pattern splits text:
    /// `'s|'t|'re|'ve|'m|'ll|'d| ?\p{L}+| ?\p{N}+| ?[^\s\p{L}\p{N}]+|\s+(?!\S)|\s+`.
    fn piece_end(&self, chars: &List<char>, at: i32) -> i32 {
        let n = chars.len();
        if chars[at] == '\'' {
            for let suffix of ["s", "t", "re", "ve", "m", "ll", "d"] {
                if spells(chars, at + 1, &suffix) {
                    return at + 1 + suffix.len();
                }
            }
        }
        let spaced = chars[at] == ' ' && at + 1 < n && !self.class_of(chars[at + 1]) matches { Space };
        let lead = if spaced { at + 1 } else { at };
        let class = self.class_of(chars[lead]);
        let mut end = lead + 1;
        while end < n && self.class_of(chars[end]) == class {
            end += 1;
        }
        // A space run before a word leaves its last space to the word.
        let leaves_one = class matches { Space } && end < n && end - at > 1;
        return if leaves_one { end - 1 } else { end };
    }

    fn class_of(&self, c: char) -> Class {
        if c.is_whitespace() {
            return Class::Space;
        }
        if within(&self.letters, c as u32) {
            return Class::Letter;
        }
        if within(&self.numbers, c as u32) {
            return Class::Number;
        }
        return Class::Other;
    }

    /// Merges the adjacent pair of lowest rank in `parts` until no pair
    /// merges, and appends what is left.
    fn merge(&self, initial: List<i32>, out: &mut List<i32>) {
        let mut parts = initial;
        loop {
            let mut best = -1;
            let mut best_rank = i32::MAX;
            let mut merged_id = 0;
            for let mut i = 0; i + 1 < parts.len(); i += 1 {
                if let Some([rank, merged]) = self.merges.get(pair_key(parts[i], parts[i + 1])) && rank < best_rank {
                    best_rank = rank;
                    best = i;
                    merged_id = merged;
                }
            }
            if best < 0 {
                break;
            }
            let [left, right] = [parts[best], parts[best + 1]];
            let mut next: List<i32> = [];
            let mut i = 0;
            while i < parts.len() {
                if i + 1 < parts.len() && parts[i] == left && parts[i + 1] == right {
                    next.push(merged_id);
                    i += 2;
                } else {
                    next.push(parts[i]);
                    i += 1;
                }
            }
            parts = next;
        }
        out.extend(&parts);
    }
}

/// The key of the pair `left` then `right` among the merges.
fn pair_key(left: i32, right: i32) -> i64 {
    return left as i64 << 32 | right as i64;
}

/// Whether `code` is in one of `ranges`, inclusive and lowest first.
fn within(ranges: &List<[u32, u32]>, code: u32) -> bool {
    let mut low = 0;
    let mut high = ranges.len();
    while low < high {
        let mid = (low + high) / 2;
        let [start, end] = ranges[mid];
        if code < start {
            high = mid;
        } else if code > end {
            low = mid + 1;
        } else {
            return true;
        }
    }
    return false;
}

/// The entries of `bytes`, UTF-8 that its writer separated by NUL bytes.
fn entries_of(bytes: &ByteList) -> List<String> {
    let Ok(text) = String::try_from_utf8(*bytes) else {
        unreachable();
    };
    if text.is_empty() {
        return [];
    }
    return text.split("\0").map(|entry| entry.to_string()).collect();
}

fn char_string(c: char) -> String {
    let mut s = String::new();
    s.push(c);
    return s;
}

fn push_utf8(bytes: &mut ByteList, c: char) {
    bytes.extend_from_slice(char_string(c).as_bytes() as Slice<u8>);
}

/// The token SentencePiece spells the byte `b` as.
pub fn byte_token(b: i32) -> String {
    return `<0x${b:02X}>`;
}

/// The printable character each byte is spelled as, so that a token is text:
/// a printable byte is itself, and the rest are shifted past 255 in order.
pub fn byte_chars() -> List<char> {
    let mut chars: List<char> = [];
    let mut shifted: u32 = 256;
    for let b of 0..<256 {
        let printable = 0x21 <= b <= 0x7e || 0xa1 <= b <= 0xac || 0xae <= b <= 0xff;
        let mut code = b as u32;
        if !printable {
            code = shifted;
            shifted += 1;
        }
        chars.push(unchecked char::from_u32(code));
    }
    return chars;
}

fn spells(chars: &List<char>, at: i32, text: &String) -> bool {
    let mut i = at;
    for let c of text.chars() {
        if i >= chars.len() || chars[i] != c {
            return false;
        }
        i += 1;
    }
    return true;
}
