//! Byte-pair encoding (Sennrich et al. 2016) in the two spellings Hugging Face
//! tokenizers write down. GPT-2's (Radford et al. 2019, § 2.2) splits text by
//! its pattern, or by o200k's as gpt-oss does, and spells each piece as bytes.
//! SentencePiece's (Kudo and Richardson 2018), as Gemma uses it, spells each
//! space as `▁`, takes the whole text as one piece, and spells a character the
//! vocabulary lacks as its UTF-8 bytes, each a `<0xXX>` token. A generated
//! tokenizer builds one from the vocabulary and merges its `tokenizer.json`
//! names.

use { HashMap } from "core:collections";
use icu from "core:icu";
use { GeneralCategoryGroup } from "core:icu";

/// How a tokenizer spells text before it merges, and back after.
pub enum TokenSpelling {
    /// GPT-2's: each piece of its pattern as bytes, each byte a character.
    ByteLevel,
    /// SentencePiece's: each space as `▁`, each character as itself, and one
    /// the vocabulary lacks as its bytes.
    Pieces,
}

/// How a tokenizer splits text into the pieces it merges apart.
pub enum PieceSplit {
    /// The whole text as one piece, as SentencePiece takes it.
    Whole,
    /// GPT-2's pattern.
    Gpt2,
    /// The pattern of OpenAI's o200k encoding, which gpt-oss's tokenizer uses.
    O200k,
}

/// The character SentencePiece spells a space as.
global SPACE_PIECE: char = '▁';

/// A BPE tokenizer.
///
/// It holds no object per token or per merge, only flat columns: a program
/// keeps its tokenizer for life, and a collector traces every object it keeps
/// at every collection.
pub struct BpeTokenizer {
    spelling: TokenSpelling,
    split: PieceSplit,
    /// Whether a piece the vocabulary spells whole is that token, merged or not.
    ignore_merges: bool,
    /// Each token, its id the index, separated by NUL bytes.
    text: String,
    /// Where each token starts in `text`, then one past the end of `text`.
    starts: List<i32>,
    /// The ids ordered by their tokens, the lowest of a repeated token's first.
    by_token: List<i32>,
    /// Each mergeable pair of ids, keyed by `pair_key`, as `merge_entry`
    /// packs its rank and merged id: the lowest rank merges first.
    merges: HashMap<i64, i64>,
    /// The added tokens, matched in the text as they stand before it is split.
    specials: List<String>,
    /// Whether each id is an added token, which decodes as its own text.
    special_ids: List<bool>,
    /// The id of the token each byte is spelled as, -1 where none is.
    byte_ids: List<i32>,
    /// The byte each id stands for where it stands for one byte, -1 elsewhere:
    /// under `ByteLevel` a character of the byte alphabet, by code point, and
    /// under `Pieces` a `<0xXX>` token, by id.
    bytes_of: List<i32>,
    /// Under `Pieces`, the id of each character's own token, by code point,
    /// the lowest where several spell it, so encoding searches no token.
    char_ids: HashMap<i32, i32>,
    /// What a character no token and no byte spells encodes as, -1 for none.
    unknown: i32,
    /// The ids every encoding starts with.
    prefix: List<i32>,
    letters: List<[u32, u32]>,
    numbers: List<[u32, u32]>,
    /// Under `O200k`, what its pattern lets lead a word, `[\p{Lu}\p{Lt}\p{Lm}\p{Lo}\p{M}]`,
    /// and what it lets end one, `[\p{Ll}\p{Lm}\p{Lo}\p{M}]`.
    capitals: List<[u32, u32]>,
    lowers: List<[u32, u32]>,
}

enum Class {
    Space,
    Letter,
    Number,
    Other,
}

impl BpeTokenizer {
    /// `tokens` holds each token, its id the index, separated by NUL bytes.
    /// `by_token` holds the ids as little-endian `i32`s, ordered by their
    /// tokens, the lowest of a repeated token's first. `merges` holds three
    /// little-endian `i32`s per merge by rank: the two ids it joins, then the
    /// id they join to. `specials` are matched in the text as they stand,
    /// before it is split. Under `ByteLevel` every byte's character is a
    /// token; under `Pieces` the `<0xXX>` tokens spell the bytes, and
    /// `unknown` names the token a character neither spells.
    pub fn new(
        tokens: &ByteList,
        by_token: &ByteList,
        merges: &ByteList,
        specials: List<String>,
        spelling: TokenSpelling,
        split: PieceSplit,
        ignore_merges: bool,
        unknown: i32,
        prefix: List<i32>,
    ) -> BpeTokenizer
        contract spelling matches { _::Pieces } == split matches { _::Whole }, "SentencePiece's spelling takes the whole text as one piece"
    {
        let Ok(text) = String::try_from_utf8(*tokens) else {
            unreachable();
        };
        let starts = starts_of(&text);
        let count = starts.len() - 1;
        let by_token = List::<i32>::from_le_bytes(*by_token);
        assert by_token.len() == count;
        let mut merge_ranks = HashMap::<i64, i64>::new();
        let triples = List::<i32>::from_le_bytes(*merges);
        for let rank of 0..<triples.len() / 3 {
            merge_ranks.try_insert(pair_key(triples[rank * 3], triples[rank * 3 + 1]), merge_entry(
                rank,
                triples[rank * 3 + 2],
            ));
        }
        let o200k = split matches { _::O200k };
        let mut t = BpeTokenizer {
            spelling,
            split,
            ignore_merges,
            text,
            starts,
            by_token,
            merges: merge_ranks,
            specials,
            special_ids: List::<bool>::filled(count, false),
            byte_ids: List::<i32>::filled(256, -1),
            bytes_of: [],
            char_ids: HashMap::new(),
            unknown,
            prefix,
            letters: icu::ranges(GeneralCategoryGroup::Letter),
            numbers: icu::ranges(GeneralCategoryGroup::Number),
            capitals: if o200k {
                union_of([UppercaseLetter, TitlecaseLetter, ModifierLetter, OtherLetter, Mark]);
            } else {
                [];
            },
            lowers: if o200k { union_of([LowercaseLetter, ModifierLetter, OtherLetter, Mark]) } else { [] },
        };
        for let special of t.specials {
            t.special_ids[t.id_of(&special).unwrap()] = true;
        }
        match spelling {
            _::ByteLevel => {
                for let [b, c] of byte_chars().into_iter().enumerate() {
                    t.byte_ids[b] = t.id_of(String::from(c)).unwrap();
                    while t.bytes_of.len() <= c as i32 {
                        t.bytes_of.push(-1);
                    }
                    t.bytes_of[c as i32] = b;
                }
            },
            _::Pieces => {
                t.bytes_of = List::<i32>::filled(count, -1);
                for let id of 0..<count {
                    let token = t.token(id);
                    if let Some(c) = token.chars().next() && c.len_utf8() == token.len() {
                        t.char_ids.try_insert(c as i32, id);
                    }
                }
                for let b of 0..<256 {
                    if let Some(id) = t.id_of(byte_token(b)) {
                        t.byte_ids[b] = id;
                        t.bytes_of[id] = b;
                    }
                }
                assert unknown >= 0 || t.byte_ids.into_iter().all(|id| id >= 0), "a character the vocabulary lacks needs its bytes' tokens or an unknown token";
            },
        }
        return t;
    }

    fn token(&self, id: i32) -> StrSlice {
        return self.text.as_str_slice().slice(self.starts[id], self.starts[id + 1] - 1);
    }

    /// The id of the token `text` spells, the lowest where several do.
    fn id_of<S: AsStrSlice>(&self, text: S) -> Option<i32> {
        let wanted = text.as_str_slice();
        let mut low = 0;
        let mut high = self.by_token.len();
        while low < high {
            let mid = (low + high) / 2;
            if self.token(self.by_token[mid]) < wanted {
                low = mid + 1;
            } else {
                high = mid;
            }
        }
        if low < self.by_token.len() && self.token(self.by_token[low]) == wanted {
            return Option::Some(self.by_token[low]);
        }
        return null;
    }

    /// The ids `text` encodes to.
    pub fn encode(&self, text: &String) -> List<i32> {
        let mut out = self.prefix;
        let mut rest = text.as_str_slice();
        loop {
            let Some([at, special]) = self.next_special(rest) else {
                self.encode_ordinary(rest, &mut out);
                return out;
            };
            self.encode_ordinary(rest.slice(0, at), &mut out);
            out.push(self.id_of(&special).unwrap());
            rest = rest.slice(at + special.len(), rest.len());
        }
    }

    /// The text `ids` decode to. Each token stands for the bytes its spelling
    /// spells, but under `ByteLevel` an added token is its own text. A byte
    /// sequence that is not UTF-8 decodes with U+FFFD in its place, as a token
    /// boundary can split a character.
    pub fn decode(&self, ids: &List<i32>) -> String {
        let mut bytes: ByteList = [];
        for let id of *ids {
            let token = self.token(id);
            match self.spelling {
                _::ByteLevel => {
                    if self.special_ids[id] {
                        bytes.extend_from_slice(token.as_bytes() as Slice<u8>);
                        continue;
                    }
                    for let c of token.chars() {
                        bytes.push(self.bytes_of[c as i32] as u8);
                    }
                },
                _::Pieces => {
                    if self.bytes_of[id] >= 0 {
                        bytes.push(self.bytes_of[id] as u8);
                        continue;
                    }
                    for let c of token.chars() {
                        if c == SPACE_PIECE {
                            bytes.push(b' ');
                        } else {
                            bytes.extend(&c.encode_utf8());
                        }
                    }
                },
            }
        }
        return String::from_utf8_lossy(bytes);
    }

    /// The special token that starts first in `text`, the longest of those
    /// starting there, and where it starts.
    fn next_special(&self, text: StrSlice) -> Option<[i32, String]> {
        let mut first: Option<[i32, String]> = null;
        for let special of self.specials {
            let Some(at) = text.find(&special) else {
                continue;
            };
            let better = match first {
                null => true,
                Some([earlier, held]) => at < earlier || at == earlier && special.len() > held.len(),
            };
            if better {
                first = Option::Some([at, special]);
            }
        }
        return first;
    }

    fn encode_ordinary(&self, text: StrSlice, out: &mut List<i32>) {
        let chars: List<char> = text.chars().collect();
        let mut at = 0;
        while at < chars.len() {
            let end = match self.split {
                _::Whole => chars.len(),
                _::Gpt2 => self.piece_end(&chars, at),
                _::O200k => self.o200k_end(&chars, at),
            };
            let mut parts: List<i32> = [];
            for let k of at..<end {
                match self.spelling {
                    _::ByteLevel => {
                        for let b of chars[k].encode_utf8() {
                            parts.push(self.byte_ids[b as i32]);
                        }
                    },
                    _::Pieces => self.spell_piece(if chars[k] == ' ' { SPACE_PIECE } else { chars[k] }, &mut parts),
                }
            }
            if let Some(id) = self.spelled_whole(&parts) {
                out.push(id);
            } else {
                self.merge(parts, out);
            }
            at = end;
        }
    }

    /// The token that spells `parts` whole, where merges are ignored.
    fn spelled_whole(&self, parts: &List<i32>) -> Option<i32> {
        if !self.ignore_merges || parts.len() < 2 {
            return null;
        }
        let mut spelled = "";
        for let id of *parts {
            spelled.push_str(self.token(id));
        }
        return self.id_of(&spelled);
    }

    /// `c` as `Pieces` spells it before merging: its own token, else its
    /// bytes', else the unknown token, one for a run of them.
    fn spell_piece(&self, c: char, parts: &mut List<i32>) {
        if let Some(id) = self.char_ids.get(c as i32) {
            parts.push(id);
            return;
        }
        let utf8 = c.encode_utf8();
        if utf8.into_iter().all(|b| self.byte_ids[b as i32] >= 0) {
            for let b of utf8 {
                parts.push(self.byte_ids[b as i32]);
            }
            return;
        }
        if parts.last() != Option::Some(self.unknown) {
            parts.push(self.unknown);
        }
    }

    /// Where the piece starting at `at` ends, as GPT-2's pattern splits text:
    /// `'s|'t|'re|'ve|'m|'ll|'d| ?\p{L}+| ?\p{N}+| ?[^\s\p{L}\p{N}]+|\s+(?!\S)|\s+`.
    fn piece_end(&self, chars: &List<char>, at: i32) -> i32 {
        if let Some(end) = contraction_end(chars, at, false) {
            return end;
        }
        let spaced = chars[at] == ' ' && at + 1 < chars.len() && !self.class_of(chars[at + 1]) matches { _::Space };
        let lead = if spaced { at + 1 } else { at };
        let class = self.class_of(chars[lead]);
        let end = run_end(chars, lead + 1, |d| self.class_of(d) == class);
        return if class matches { _::Space } { space_run_end(chars, at, end) } else { end };
    }

    /// Where the piece starting at `at` ends, as o200k's pattern splits text,
    /// its alternatives tried in turn, each quantifier greedy:
    /// `[^\r\n\p{L}\p{N}]?[\p{Lu}\p{Lt}\p{Lm}\p{Lo}\p{M}]*[\p{Ll}\p{Lm}\p{Lo}\p{M}]+(?i:'s|'t|'re|'ve|'m|'ll|'d)?`,
    /// `[^\r\n\p{L}\p{N}]?[\p{Lu}\p{Lt}\p{Lm}\p{Lo}\p{M}]+[\p{Ll}\p{Lm}\p{Lo}\p{M}]*(?i:'s|'t|'re|'ve|'m|'ll|'d)?`,
    /// `\p{N}{1,3}`, ` ?[^\s\p{L}\p{N}]+[\r\n/]*`, `\s*[\r\n]+`, `\s+(?!\S)`, `\s+`.
    fn o200k_end(&self, chars: &List<char>, at: i32) -> i32 {
        let n = chars.len();
        let c = chars[at];
        let leads: List<i32> = if c != '\r' && c != '\n' && self.class_of(c) matches { _::Space | _::Other } {
            [at + 1, at];
        } else {
            [at];
        };
        for let capital_first of [false, true] {
            for let start of leads {
                if let Some(end) = self.cased_end(chars, start, capital_first) {
                    return contraction_end(chars, end, true).unwrap_or(end);
                }
            }
        }
        if within(&self.numbers, c as u32) {
            return i32::min(run_end(chars, at, |d| within(&self.numbers, d as u32)), at + 3);
        }
        let other = |d: char| self.class_of(d) matches { _::Other };
        let spaced: List<i32> = if c == ' ' { [at + 1, at] } else { [at] };
        for let start of spaced {
            if start < n && other(chars[start]) {
                return run_end(chars, run_end(chars, start, other), |d| d == '\r' || d == '\n' || d == '/');
            }
        }
        let spaces = run_end(chars, at, |d| d.is_whitespace());
        for let mut q = spaces - 1; q >= at; q -= 1 {
            if chars[q] == '\r' || chars[q] == '\n' {
                return q + 1;
            }
        }
        assert spaces > at, "every character starts some alternative of the pattern";
        return space_run_end(chars, at, spaces);
    }

    /// Where a word from `start` ends under o200k's pattern: capitals then
    /// lowercase, at least one of the lowercase, or with `capital_first` at
    /// least one capital then any lowercase. None where neither matches.
    fn cased_end(&self, chars: &List<char>, start: i32, capital_first: bool) -> Option<i32> {
        if start >= chars.len() {
            return null;
        }
        let capitals = run_end(chars, start, |d| within(&self.capitals, d as u32));
        let lowers_from = |from: i32| run_end(chars, from, |d| within(&self.lowers, d as u32));
        if capital_first {
            return if capitals > start { Option::Some(lowers_from(capitals)) } else { null };
        }
        // The capitals give back what the lowercase need, from the right.
        for let mut split = capitals; split >= start; split -= 1 {
            if split < chars.len() && within(&self.lowers, chars[split] as u32) {
                return Option::Some(lowers_from(split));
            }
        }
        return null;
    }

    fn class_of(&self, c: char) -> Class {
        if c.is_whitespace() {
            return Class::Space;
        }
        if within(&self.letters, c as u32) {
            return Class::Letter;
        }
        if within(&self.numbers, c as u32) {
            return Class::Number;
        }
        return Class::Other;
    }

    /// Merges the adjacent pair of lowest rank in `parts` until no pair
    /// merges, and appends what is left. A round merges every place the pair
    /// of its rank stands, left to right, as the parts stood when it began.
    ///
    /// `parts` is a linked list by place, and a heap orders its pairs by rank,
    /// then by place, so a round finds its pairs without a scan. A pair a merge
    /// forms joins the heap once the round ends, and a pair a merge broke is
    /// skipped when it comes up.
    fn merge(&self, parts: List<i32>, out: &mut List<i32>) {
        let n = parts.len();
        let mut ids = parts;
        let mut prev: List<i32> = [];
        let mut next: List<i32> = [];
        for let at of 0..<n {
            prev.push(at - 1);
            next.push(if at + 1 < n { at + 1 } else { -1 });
        }
        let mut alive = List::<bool>::filled(n, true);
        let mut pairs: List<i64> = [];
        for let at of 0..<n - 1 {
            self.queue_pair(&ids, at, at + 1, &mut pairs);
        }
        let mut formed: List<i64> = [];
        let mut round = -1;
        let mut last: i64 = -1;
        loop {
            if pairs.is_empty() || (pairs[0] >> 32) as i32 != round {
                for let pair of formed {
                    heap_push(&mut pairs, pair);
                }
                formed = [];
                if pairs.is_empty() {
                    break;
                }
                round = (pairs[0] >> 32) as i32;
                last = -1;
            }
            let pair = heap_pop(&mut pairs);
            if pair == last {
                continue;
            }
            last = pair;
            let at = pair as i32;
            let right = next[at];
            if !alive[at] || right < 0 {
                continue;
            }
            let Some(entry) = self.merges.get(pair_key(ids[at], ids[right])) else {
                continue;
            };
            if merge_rank(entry) != round {
                continue;
            }
            ids[at] = entry as i32;
            alive[right] = false;
            next[at] = next[right];
            if next[at] >= 0 {
                prev[next[at]] = at;
                self.queue_pair(&ids, at, next[at], &mut formed);
            }
            if prev[at] >= 0 {
                self.queue_pair(&ids, prev[at], at, &mut formed);
            }
        }
        for let mut at = 0; at >= 0 && at < n; at = next[at] {
            out.push(ids[at]);
        }
    }

    /// Adds the pair of `ids` at `left` and `right` to `pairs`, keyed by its
    /// rank and then its place, where it merges.
    fn queue_pair(&self, ids: &List<i32>, left: i32, right: i32, pairs: &mut List<i64>) {
        if let Some(entry) = self.merges.get(pair_key(ids[left], ids[right])) {
            heap_push(pairs, merge_rank(entry) as i64 << 32 | left as i64);
        }
    }
}

/// A merge's rank and the id it merges to, in one `i64`.
fn merge_entry(rank: i32, merged: i32) -> i64 {
    return rank as i64 << 32 | merged as i64;
}

fn merge_rank(entry: i64) -> i32 {
    return (entry >> 32) as i32;
}

/// Adds `entry` to the least-first heap `heap`.
fn heap_push(heap: &mut List<i64>, entry: i64) {
    heap.push(entry);
    let mut at = heap.len() - 1;
    while at > 0 && heap[(at - 1) / 2] > heap[at] {
        heap.swap(at, (at - 1) / 2);
        at = (at - 1) / 2;
    }
}

/// Takes the least entry out of the heap `heap`, which holds one.
fn heap_pop(heap: &mut List<i64>) -> i64 {
    let least = heap[0];
    let last = heap.pop().unwrap();
    if heap.is_empty() {
        return least;
    }
    heap[0] = last;
    let mut at = 0;
    loop {
        let left = at * 2 + 1;
        if left >= heap.len() {
            return least;
        }
        let child = if left + 1 < heap.len() && heap[left + 1] < heap[left] { left + 1 } else { left };
        if heap[at] <= heap[child] {
            return least;
        }
        heap.swap(at, child);
        at = child;
    }
}

/// The key of the pair `left` then `right` among the merges.
fn pair_key(left: i32, right: i32) -> i64 {
    return left as i64 << 32 | right as i64;
}

/// Whether `code` is in one of `ranges`, inclusive and lowest first.
fn within(ranges: &List<[u32, u32]>, code: u32) -> bool {
    let mut low = 0;
    let mut high = ranges.len();
    while low < high {
        let mid = (low + high) / 2;
        let [start, end] = ranges[mid];
        if code < start {
            high = mid;
        } else if code > end {
            low = mid + 1;
        } else {
            return true;
        }
    }
    return false;
}

/// The code points of any of `groups`, as disjoint ranges, lowest first.
fn union_of(groups: List<GeneralCategoryGroup>) -> List<[u32, u32]> {
    let mut all: List<[u32, u32]> = [];
    for let group of groups {
        all.extend(&icu::ranges(group));
    }
    all.sort();
    let mut merged: List<[u32, u32]> = [];
    for let [start, end] of all {
        let last = merged.len() - 1;
        if last >= 0 && start <= merged[last].1 + 1 {
            merged[last] = [merged[last].0, u32::max(merged[last].1, end)];
        } else {
            merged.push([start, end]);
        }
    }
    return merged;
}

/// Where the run of characters from `from` that `holds` takes ends.
fn run_end(chars: &List<char>, from: i32, holds: fn(char) -> bool) -> i32 {
    let mut end = from;
    while end < chars.len() && holds(chars[end]) {
        end += 1;
    }
    return end;
}

/// Where each entry of `text`, separated by NUL bytes, starts, then one past
/// the end of `text`. An empty `text` holds no entry.
fn starts_of(text: &String) -> List<i32> {
    let mut starts: List<i32> = [0];
    if text.is_empty() {
        return starts;
    }
    for let [at, b] of text.bytes().enumerate() {
        if b == 0 {
            starts.push(at + 1);
        }
    }
    starts.push(text.len() + 1);
    return starts;
}

/// The token SentencePiece spells the byte `b` as.
pub fn byte_token(b: i32) -> String {
    return `<0x${b:02X}>`;
}

/// The printable character each byte is spelled as, so that a token is text:
/// a printable byte is itself, and the rest are shifted past 255 in order.
pub fn byte_chars() -> List<char> {
    let mut chars: List<char> = [];
    let mut shifted: u32 = 256;
    for let b of 0..<256 {
        let printable = 0x21 <= b <= 0x7e || 0xa1 <= b <= 0xac || 0xae <= b <= 0xff;
        let mut code = b as u32;
        if !printable {
            code = shifted;
            shifted += 1;
        }
        chars.push(unchecked char::from_u32(code));
    }
    return chars;
}

fn spells(chars: &List<char>, at: i32, text: &String, folded: bool) -> bool {
    let mut i = at;
    for let c of text.chars() {
        if i >= chars.len() || if folded { icu::simple_fold(chars[i]) } else { chars[i] } != c {
            return false;
        }
        i += 1;
    }
    return true;
}

/// One past the contraction at `at`, an apostrophe and `s`, `t`, `re`, `ve`,
/// `m`, `ll` or `d`, its letters in either case where `folded`.
fn contraction_end(chars: &List<char>, at: i32, folded: bool) -> Option<i32> {
    if at >= chars.len() || chars[at] != '\'' {
        return null;
    }
    for let suffix of ["s", "t", "re", "ve", "m", "ll", "d"] {
        if spells(chars, at + 1, &suffix, folded) {
            return Option::Some(at + 1 + suffix.len());
        }
    }
    return null;
}

/// Where a whitespace run from `at` to `end` ends as a piece: a run of two or
/// more before anything else leaves its last character to the next piece.
fn space_run_end(chars: &List<char>, at: i32, end: i32) -> i32 {
    return if end < chars.len() && end - at > 1 { end - 1 } else { end };
}
