//! A mixture of experts' weights held in pools of slots, each slot one expert.
//! Where the budget holds every expert of a layout, each layer holds its own.
//! Otherwise runs of its layers share pools of fewer slots than their experts,
//! which each host step fills with the experts the tokens pick.

use { HashMap } from "core:collections";
use { LoadError, WeightSource } from "./checkpoint.wado";
use { ExpertsOnHost } from "./cpu_experts.wado";
use { Picked, Pool, Tokens } from "./experts.wado";
use { Backend, One, Quantized } from "./hlo.wado";
use { Any, Untyped, typed } from "./recorded.wado";
use { ElementKind, Tensor } from "./tensor.wado";
use { HostWeight, stored_bytes } from "./weight.wado";
use { LinearArray } from "core:linear";

/// Where a layer's experts of one weight are stored, back to back: from a byte
/// of a file the source reads, or in bytes the guest holds, such as those the
/// graph carries.
pub variant ExpertBytes {
    File([String, i32]),
    Held(ByteList),
}

/// One weight of a layer's experts as it is stored: each expert's slice of
/// `extents` in `kind`, back to back in `bytes`.
pub struct StoredExperts {
    pub bytes: ExpertBytes,
    pub kind: ElementKind,
    pub extents: List<i32>,
}

impl StoredExperts {
    fn slice_bytes(&self) -> i32 {
        return stored_bytes(self.kind, &self.extents);
    }
}

/// The layers whose experts are laid out alike.
pub struct ExpertLayout {
    /// Where each layer's pools are among the weights a pass reads, one for
    /// each of its expert weights.
    pub weights: List<List<i32>>,
    /// Each layer's expert weights, in the order of its pools, and the host
    /// step that fetches its experts.
    pub layers: List<List<StoredExperts>>,
    pub steps: List<i32>,
    /// The experts of one layer.
    pub experts: i32,
    /// How the layers quantize their expert weights.
    pub quantized: Quantized,
}

impl ExpertLayout {
    /// The bytes a checkpoint stores one expert of these layers in.
    fn slot_bytes(&self) -> i64 {
        return self.layers[0].into_iter().map(|w| w.slice_bytes() as i64).sum().unwrap();
    }

    /// What planning reads of these layers, a pool of a weight holding at
    /// most `most(weight)` slots.
    fn shape(&self, most: fn(&StoredExperts) -> i32) -> ExpertShape {
        return ExpertShape {
            layers: self.layers.len(),
            experts: self.experts,
            slot_bytes: self.slot_bytes(),
            steps: self.steps,
            most_slots: self.layers[0].into_iter().map(|w| most(&w)).min().unwrap(),
        };
    }
}

/// What planning a layout's pools reads of it: its layers, the experts of
/// each, the bytes a checkpoint stores one expert in, the host step of each
/// layer, and the most slots one of its pools may hold.
pub struct ExpertShape {
    pub layers: i32,
    pub experts: i32,
    pub slot_bytes: i64,
    pub steps: List<i32>,
    pub most_slots: i32,
}

/// The layers `first..<first + count` of a layout, which share one pool for
/// each weight of `slots` slots. A run of one layer holds its own experts, a
/// slot each; a longer run holds more than one layer's experts and fewer than
/// all of its layers'.
pub struct LayerRun {
    pub first: i32,
    pub count: i32,
    pub slots: i32,
}

impl LayerRun {
    fn shared(&self) -> bool {
        return self.count > 1;
    }
}

/// Each layout's layers in runs within `budget` bytes, counted as a
/// checkpoint stores them. A budget past every expert gives each layer its
/// own. Otherwise each layout first gets one layer's experts and one more,
/// then the rest is shared by the bytes each still lacks, and its layers are
/// split into as few runs as keep each pool within `most_slots`.
pub fn planned(shapes: &List<ExpertShape>, budget: i64) -> Result<List<List<LayerRun>>, LoadError> {
    let least_of = |s: &ExpertShape| if s.layers == 1 { s.experts } else { s.experts + 1 };
    let all_of = |s: &ExpertShape| s.layers * s.experts;
    let least = shapes.into_iter().map(|s| least_of(s) as i64 * s.slot_bytes).sum().unwrap_or(0);
    if budget < least {
        return Result::Err(
            LoadError { reason: `a budget of ${budget} bytes holds less than one layer's experts and one more of each layout, ${least} bytes` },
        );
    }
    let rest = shapes.into_iter().map(|s| (all_of(s) - least_of(s)) as i64 * s.slot_bytes).sum().unwrap_or(0);
    let spare = i64::min(budget - least, rest);
    let mut plans: List<List<LayerRun>> = [];
    for let s of *shapes {
        let others = all_of(&s) - least_of(&s);
        let extra = if spare == rest { others } else { (others as i64 * spare / rest) as i32 };
        plans.push(runs_of(&s, least_of(&s) + extra)?);
    }
    return Result::Ok(plans);
}

/// `shape`'s layers in runs sharing `slots` slots, or each its own where the
/// slots hold every expert.
fn runs_of(shape: &ExpertShape, slots: i32) -> Result<List<LayerRun>, LoadError> {
    let [layers, experts] = [shape.layers, shape.experts];
    if experts > shape.most_slots {
        return Result::Err(
            LoadError { reason: `one layer's ${experts} experts outgrow a pool of ${shape.most_slots} slots` },
        );
    }
    let own = |first: i32, count: i32| -> List<LayerRun> {
        return (first..<first + count).map(|l| LayerRun { first: l, count: 1, slots: experts }).collect();
    };
    if slots >= layers * experts {
        return Result::Ok(own(0, layers));
    }
    let kept = |runs: &List<LayerRun>| -> List<LayerRun> {
        let mut kept: List<LayerRun> = [];
        for let run of *runs {
            if run.count == 1 || run.slots >= run.count * experts {
                kept.extend(&own(run.first, run.count));
            } else {
                kept.push(run);
            }
        }
        return kept;
    };
    // Where no count of runs keeps each pool within `most_slots`, the most runs
    // the slots afford, each cut to `most_slots`, which spends less than the
    // budget rather than none of it.
    let mut cut: Option<List<LayerRun>> = null;
    for let count of 1..=layers {
        if count * (experts + 1) > slots {
            break;
        }
        let mut runs: List<LayerRun> = [];
        let extra = slots - count * (experts + 1);
        let mut given = 0;
        for let r of 0..<count {
            let [first, end] = [r * layers / count, (r + 1) * layers / count];
            let share = if r == count - 1 { extra - given } else { extra * (end - first) / layers };
            given += share;
            runs.push(LayerRun { first, count: end - first, slots: experts + 1 + share });
        }
        if runs.into_iter().all(|run| run.slots <= shape.most_slots) {
            return Result::Ok(kept(&runs));
        }
        if shape.most_slots > experts {
            cut = Option::Some(
                runs.into_iter().map(|run| LayerRun { ..run, slots: i32::min(run.slots, shape.most_slots) }).collect(),
            );
        }
    }
    if let Some(runs) = cut {
        return Result::Ok(kept(&runs));
    }
    return Result::Err(
        LoadError { reason: `${slots} slots of ${experts} experts a layer outgrow pools of ${shape.most_slots} slots` },
    );
}

/// Which expert of a shared pool gives way to one a step needs. Each breaks a
/// tie by taking the one used longest ago.
pub enum Eviction {
    /// The one used longest ago.
    Recent,
    /// The one picked least often, of those the pool has seen.
    Frequent,
    /// The one whose layer runs last from here, the run's layers running in
    /// order and over again.
    LayerOrder,
    /// The one picked next furthest from now, which only a replay of known
    /// steps can tell.
    Farthest,
}

/// A shared pool's slots: the expert in each as `layer · experts + expert` of
/// the run's layers or -1, when each was used last, and how often each expert
/// has been picked.
pub struct SharedSlots {
    layers: i32,
    experts: i32,
    eviction: Eviction,
    held: List<i32>,
    used: List<i64>,
    picked: List<i64>,
    clock: i64,
}

impl SharedSlots {
    pub fn new(layers: i32, experts: i32, slots: i32, eviction: Eviction) -> SharedSlots
        contract experts < slots < layers * experts, "a shared pool holds more than one layer's experts and fewer than all"
    {
        return SharedSlots {
            layers,
            experts,
            eviction,
            held: List::filled(slots, -1),
            used: List::filled(slots, -1),
            picked: List::filled(layers * experts, 0),
            clock: 0,
        };
    }

    /// The slot holding each of `picked`, distinct experts of the run's layer
    /// `layer`, and whether it was filled now: the first `most_filled` the
    /// pool lacks are, and the rest stay without a slot, -1. Those held
    /// already are kept, so no expert this step needs gives way.
    /// `next_use(key)` is when the expert `key` is picked next, which only
    /// `Farthest` reads.
    pub fn placed(
        &mut self,
        layer: i32,
        picked: &List<i32>,
        next_use: fn(i32) -> i64,
        most_filled: i32,
    ) -> List<[i32, bool]>
        contract 0 <= layer < self.layers
    {
        self.clock += 1;
        let keys: List<i32> = picked.into_iter().map(|e| layer * self.experts + *e).collect();
        let mut slots = List::<i32>::filled(keys.len(), -1);
        for let [i, key] of keys.into_iter().enumerate() {
            self.picked[key] += 1;
            if let Some(s) = self.held.into_iter().position(|h| h == key) {
                self.used[s] = self.clock;
                slots[i] = s;
            }
        }
        let mut placed: List<[i32, bool]> = [];
        let mut filled = 0;
        for let [i, key] of keys.into_iter().enumerate() {
            if slots[i] >= 0 || filled == most_filled {
                placed.push([slots[i], false]);
                continue;
            }
            let s = self.victim(layer, next_use);
            self.held[s] = key;
            self.used[s] = self.clock;
            filled += 1;
            placed.push([s, true]);
        }
        return placed;
    }

    /// The slot that gives way: an empty one, else the one the eviction keeps
    /// least, among those this step has not used.
    fn victim(&self, layer: i32, next_use: fn(i32) -> i64) -> i32 {
        let mut best = -1;
        let mut best_kept: i64 = 0;
        for let s of 0..<self.held.len() {
            if self.used[s] == self.clock {
                continue;
            }
            let key = self.held[s];
            if key < 0 {
                return s;
            }
            let kept = self.kept(key, layer, next_use);
            if best < 0 || kept < best_kept || kept == best_kept && self.used[s] < self.used[best] {
                best = s;
                best_kept = kept;
            }
        }
        assert best >= 0, "a shared pool holds one layer's experts and more";
        return best;
    }

    /// How much the eviction would keep `key` while layer `layer` runs: the
    /// least is the one to give way.
    fn kept(&self, key: i32, layer: i32, next_use: fn(i32) -> i64) -> i64 {
        return match self.eviction {
            _::Recent => 0,
            _::Frequent => self.picked[key],
            _::LayerOrder => -(((key / self.experts - layer - 1) % self.layers + self.layers) % self.layers) as i64,
            _::Farthest => -next_use(key),
        };
    }
}

/// One host step's fetch: its id, the tokens it ran, and the distinct experts
/// they picked, in the order they first appear.
pub struct Fetch {
    pub step: i32,
    pub tokens: i32,
    pub experts: List<i32>,
}

/// What a model's host steps fetched, with the shapes of its layouts: what
/// [`replayed`] reads.
pub struct Fetches {
    pub shapes: List<ExpertShape>,
    pub fetches: List<Fetch>,
}

/// How many experts steps picked, how many of those a pool held already, how
/// many ran on the host, and the bytes the rest took to load, as a checkpoint
/// stores them.
pub struct ExpertCounts {
    pub picked: i64 = 0,
    pub held: i64 = 0,
    pub hosted: i64 = 0,
    pub loaded_bytes: i64 = 0,
}

impl ExpertCounts {
    /// One more pick, in `slot`, filled now or not, a slot's `bytes` each.
    fn counted(&mut self, placed: [i32, bool], bytes: i64) {
        let [slot, filled] = placed;
        self.picked += 1;
        if slot < 0 {
            self.hosted += 1;
        } else if filled {
            self.loaded_bytes += bytes;
        } else {
            self.held += 1;
        }
    }
}

/// A shared run of a layout's layers and its slots.
struct SharedRun {
    layout: i32,
    run: LayerRun,
    slots: SharedSlots,
}

/// Each shared run of `plans`, slots under `eviction`, and the run and layer
/// each host step of `shapes` fetches into.
fn shared_runs(
    shapes: &List<ExpertShape>,
    plans: &List<List<LayerRun>>,
    eviction: Eviction,
) -> [List<SharedRun>, HashMap<i32, [i32, i32]>] {
    let mut runs: List<SharedRun> = [];
    let mut of_step = HashMap::<i32, [i32, i32]>::new();
    for let [at, plan] of plans.into_iter().enumerate() {
        let shape = &shapes[at];
        for let run of plan {
            if !run.shared() {
                continue;
            }
            for let layer of run.first..<run.first + run.count {
                of_step[shape.steps[layer]] = [runs.len(), layer];
            }
            runs.push(SharedRun {
                layout: at,
                run: *run,
                slots: SharedSlots::new(run.count, shape.experts, run.slots, eviction),
            });
        }
    }
    return [runs, of_step];
}

/// What `fetches`, recorded by a model of `shapes`, would have held within
/// `budget` bytes under `eviction`, a step of one token filling at most
/// `step_fills` slots a layer and leaving the rest to the host: the counts of
/// the steps of many tokens, as a prompt's are, and of one.
pub fn replayed(
    shapes: &List<ExpertShape>,
    fetches: &List<Fetch>,
    budget: i64,
    eviction: Eviction,
    step_fills: i32,
) -> Result<[ExpertCounts, ExpertCounts], LoadError> {
    let [mut runs, of_step] = shared_runs(shapes, &planned(shapes, budget)?, eviction);
    // The fetch that next picks each expert, by step and expert: at first the
    // one that first does, and past each fetch the one after it.
    let mut upcoming = HashMap::<[i32, i32], i64>::new();
    let mut after: List<List<i64>> = [];
    for let back of 1..=fetches.len() {
        let i = fetches.len() - back;
        let f = &(*fetches)[i];
        let mut next: List<i64> = [];
        for let e of f.experts {
            next.push(upcoming.get([f.step, e]).unwrap_or(i64::MAX));
            upcoming[[f.step, e]] = i as i64;
        }
        after.push(next);
    }
    after.reverse();
    let mut prompts = ExpertCounts {};
    let mut steps = ExpertCounts {};
    for let [i, f] of fetches.into_iter().enumerate() {
        for let [k, e] of f.experts.into_iter().enumerate() {
            upcoming[[f.step, e]] = after[i][k];
        }
        let counts = if f.tokens > 1 { &mut prompts } else { &mut steps };
        let Some([r, layer]) = of_step.get(f.step) else {
            // A layer holding its own experts holds each it picks.
            for let _ of f.experts {
                counts.counted([0, false], 0);
            }
            continue;
        };
        let shared = &mut runs[r];
        let shape = &shapes[shared.layout];
        let first = shared.run.first;
        let next_use = |key: i32| -> i64 {
            return upcoming.get([shape.steps[first + key / shape.experts], key % shape.experts]).unwrap_or(i64::MAX);
        };
        let most = most_filled(f.tokens, f.experts.len(), shape.experts, step_fills);
        for let placed of shared.slots.placed(layer - first, &f.experts, next_use, most) {
            counts.counted(placed, shape.slot_bytes);
        }
    }
    return Result::Ok([prompts, steps]);
}

/// The most of its misses a step of `tokens` picking `picked` of `experts`
/// writes into slots: `step_fills` for one token whose mixture runs by picks,
/// the only kind that reads a slot of -1, as `runs_by_picks` decides.
fn most_filled(tokens: i32, picked: i32, experts: i32, step_fills: i32) -> i32 {
    return if tokens == 1 && picked < experts { step_fills } else { experts };
}

/// Every layout's pools a model reads, and what the shared ones hold.
pub struct HeldExperts {
    layouts: List<ExpertLayout>,
    shapes: List<ExpertShape>,
    plans: List<List<LayerRun>>,
    runs: List<SharedRun>,
    of_step: HashMap<i32, [i32, i32]>,
    counts: ExpertCounts,
    recording: bool,
    fetches: List<Fetch>,
    step_fills: i32,
}

/// The order in which a shared pool's experts give way.
global EVICTION: Eviction = Eviction::LayerOrder;

/// The most experts whose bytes are read at once, which bounds the guest's
/// memory and the streams open.
global EXPERTS_AT_ONCE: i32 = 4;

/// The most slots a step of one token fills a layer, on a backend that
/// computes the rest of the experts the pools lack. gpt-oss-20b's 32 tokens
/// at 5 GB ran 1.03 times as fast at 2 as at 1.
global STEP_FILLS: i32 = 2;

impl HeldExperts {
    /// Pools of `layouts` within `budget` bytes, as a checkpoint stores them,
    /// planned as [`planned`] does, each within what `g` holds in one pool.
    pub fn within<affine G: Backend>(layouts: List<ExpertLayout>, budget: i64, g: &G) -> Result<HeldExperts, LoadError> {
        let shapes: List<ExpertShape> = layouts.into_iter().map(|l| {
            assert l.layers.len() == l.steps.len() && l.layers.len() == l.weights.len();
            return l.shape(|w| g.pool_slots(w.kind, &w.extents));
        }).collect();
        let plans = planned(&shapes, budget)?;
        return Result::Ok(HeldExperts::of(layouts, shapes, plans));
    }

    fn of(layouts: List<ExpertLayout>, shapes: List<ExpertShape>, plans: List<List<LayerRun>>) -> HeldExperts {
        let [runs, of_step] = shared_runs(&shapes, &plans, EVICTION);
        return HeldExperts {
            layouts,
            shapes,
            plans,
            runs,
            of_step,
            counts: ExpertCounts {},
            recording: false,
            fetches: [],
            step_fills: STEP_FILLS,
        };
    }

    /// Fills at most `most` slots a layer in a step of one token, on a
    /// backend that computes misses.
    pub fn limit_step_fills(&mut self, most: i32) {
        self.step_fills = most;
    }

    /// Pools of `layouts`, each layer holding its own experts, as `g` holds
    /// them.
    pub fn resident<affine G: Backend>(layouts: List<ExpertLayout>, g: &G) -> HeldExperts {
        return match HeldExperts::within(layouts, i64::MAX, g) {
            Ok(held) => held,
            Err(e) => panic(`${e}`),
        };
    }

    /// No pools, for a model whose weights come whole.
    pub fn none() -> HeldExperts {
        return HeldExperts::of([], [], []);
    }

    /// Records each host step's fetch from here on, for [`Self::fetches`].
    pub fn record_fetches(&mut self) {
        self.recording = true;
    }

    /// Every host step's fetch recorded, in order, and the shapes of the
    /// layouts as they were planned.
    pub fn fetches(&self) -> Fetches {
        return Fetches { shapes: self.shapes, fetches: self.fetches };
    }

    /// How many experts the host steps have picked, held and loaded.
    pub fn counts(&self) -> &ExpertCounts {
        return &self.counts;
    }

    /// Each layer's pools in the order of their weights: a layer's own filled
    /// from `source`, a shared run's one pool for each of its layers, empty.
    pub fn pools<affine G: Backend, affine Src: WeightSource>(&self, g: &mut G, source: &Src) -> List<Any<G>> with _ {
        let mut made: List<Any<G>> = [];
        if self.layouts.is_empty() {
            return made;
        }
        let first = self.layouts[0].weights[0][0];
        for let [at, layout] of self.layouts.into_iter().enumerate() {
            for let run of &self.plans[at] {
                let mut pools: List<Any<G>> = [];
                for let w of layout.layers[run.first] {
                    let mut extents: List<i32> = [run.slots];
                    extents.extend(&w.extents);
                    assert run.slots <= g.pool_slots(w.kind, &w.extents), "a pool fits the backend";
                    pools.push(g.pool(w.kind, extents));
                }
                if !run.shared() {
                    let experts: List<i32> = (0..<layout.experts).collect();
                    written(g, source, &layout.layers[run.first], &experts, &experts, &mut pools);
                } else if let Some(host) = g.experts_on_host(&layout.quantized, &pools[0]) {
                    for let layer of run.first..<run.first + run.count {
                        held_on_host(host, source, &layout.layers[layer], layout.experts, layout.steps[layer]);
                    }
                }
                for let layer of run.first..<run.first + run.count {
                    for let [i, pool] of pools.into_iter().enumerate() {
                        assert layout.weights[layer][i] == first + made.len(), "the pools follow each other";
                        made.push(pool);
                    }
                }
            }
        }
        return made;
    }

    /// The host step `step`: the experts `read[0]` picks, each written into a
    /// slot of its run's pools unless one holds it already; then each expert's
    /// slot, the picked experts in order, and how many they are. Where the
    /// backend has [`Backend::experts_on_host`], a slot is written from there,
    /// and in a step of one token at most [`Self::limit_step_fills`]: the slot
    /// of each other expert the pools lack is -1.
    pub fn fetched<affine G: Backend, affine Src: WeightSource>(
        &mut self,
        g: &mut G,
        source: &Src,
        step: i32,
        read: &List<Any<G>>,
        weights: &mut List<Any<G>>,
    ) -> List<Any<G>> with _ {
        let Some([r, layer]) = self.of_step.get(step) else {
            panic(`no shared pool's experts are fetched at host step ${step}`);
        };
        let shared = &mut self.runs[r];
        let layout = &self.layouts[shared.layout];
        let experts = layout.experts;
        let picks = g.download(&typed::<G, i64, [Tokens, Picked]>(g, &read[0]));
        let mut order: List<i64> = [];
        for let pick of picks.data {
            if !order.contains(&pick) {
                order.push(pick);
            }
        }
        let picked: List<i32> = order.into_iter().map(|e| e as i32).collect();
        if self.recording {
            self.fetches.push(Fetch { step, tokens: picks.extents[0], experts: picked });
        }
        let mut slot_of = List::<i64>::filled(experts, -1);
        let slot_bytes = layout.slot_bytes();
        let first = shared.run.first;
        let mut pools: List<Any<G>> = layout.weights[first].into_iter().map(|p| weights[p]).collect();
        let on_host = g.experts_on_host(&layout.quantized, &pools[0]);
        let step_fills = if on_host matches { Some(_) } { self.step_fills } else { experts };
        let most = most_filled(picks.extents[0], picked.len(), experts, step_fills);
        let placed = shared.slots.placed(layer - first, &picked, |_| unreachable(), most);
        let mut loading: List<i32> = [];
        let mut into: List<i32> = [];
        for let [i, [slot, filled]] of placed.into_iter().enumerate() {
            slot_of[picked[i]] = slot as i64;
            self.counts.counted([slot, filled], slot_bytes);
            if filled {
                loading.push(picked[i]);
                into.push(slot);
            }
        }
        match on_host {
            Some(host) => {
                for let [i, expert] of loading.into_iter().enumerate() {
                    for let w of 0..<pools.len() {
                        g.written(&mut pools[w], into[i], host.of(step, w).expert(expert));
                    }
                }
            },
            null => written(g, source, &layout.layers[layer], &loading, &into, &mut pools),
        }
        for let l of first..<first + shared.run.count {
            for let [w, pool] of pools.into_iter().enumerate() {
                weights[layout.weights[l][w]] = pool;
            }
        }
        return slots_and_order(g, slot_of, order, experts);
    }
}

/// What a host step answers: each of the `experts`' slot, the picked ones in
/// `order` padded to them all, and how many were picked.
fn slots_and_order<affine G: Backend>(
    g: &mut G,
    slot_of: List<i64>,
    order: List<i64>,
    experts: i32,
) -> List<Any<G>> with _ {
    let count = order.len();
    let mut padded = order;
    while padded.len() < experts {
        padded.push(0);
    }
    let column: List<i32> = [experts, 1];
    return [
        uploaded(g, Tensor::<i64, [Pool, One]> { data: slot_of, extents: column }),
        uploaded(g, Tensor::<i64, [Pool, One]> { data: padded, extents: column }),
        uploaded(g, Tensor::<i64, []> {
            data: [count as i64],
            extents: [],
        }),
    ];
}

/// `pools`, one for each of `stored`, with their slot `slots[i]` holding
/// expert `experts[i]`, the bytes of `EXPERTS_AT_ONCE` of them read from
/// `source` at once.
fn written<affine G: Backend, affine Src: WeightSource>(
    g: &mut G,
    source: &Src,
    stored: &List<StoredExperts>,
    experts: &List<i32>,
    slots: &List<i32>,
    pools: &mut List<Any<G>>,
) with _
    contract experts.len() == slots.len()
{
    for let mut from = 0; from < experts.len(); from += EXPERTS_AT_ONCE {
        let mut ranges: List<[String, i32, i32]> = [];
        // The slot of each range, and the pool it fills.
        let mut targets: List<[i32, i32]> = [];
        for let at of from..<i32::min(from + EXPERTS_AT_ONCE, experts.len()) {
            for let [i, w] of stored.into_iter().enumerate() {
                let size = w.slice_bytes();
                let start = experts[at] * size;
                match w.bytes {
                    File([file, first]) => {
                        ranges.push([file, first + start, first + start + size]);
                        targets.push([slots[at], i]);
                    },
                    Held(bytes) => write_slot(g, pools, w, i, slots[at], LinearArray::<u8>::of_bytes(
                        &bytes,
                        start,
                        size,
                    )),
                }
            }
        }
        let read = match source.read_many(&ranges) {
            Ok(read) => read,
            Err(e) => panic(`${e}`),
        };
        let mut r = 0;
        for let bytes of read {
            let [slot, i] = targets[r];
            write_slot(g, pools, &stored[i], i, slot, bytes);
            r += 1;
        }
    }
}

/// Every expert of `stored`, a layer's weights whose host step is `step`, held
/// by `host`.
fn held_on_host<affine Src: WeightSource>(
    host: &mut ExpertsOnHost,
    source: &Src,
    stored: &List<StoredExperts>,
    experts: i32,
    step: i32,
) with _ {
    for let [i, w] of stored.into_iter().enumerate() {
        let size = experts * w.slice_bytes();
        let bytes = match w.bytes {
            File([file, first]) => match source.read(&file, first, first + size) {
                Ok(read) => read,
                Err(e) => panic(`${e}`),
            },
            Held(held) => LinearArray::<u8>::of_bytes(&held, 0, size),
        };
        let mut extents: List<i32> = [experts];
        extents.extend(&w.extents);
        host.held(step, i, &HostWeight::stored(w.kind, extents, bytes));
    }
}

/// Slot `slot` of `pools[i]`, the pool of `w`, holding `bytes`.
fn write_slot<affine G: Backend>(
    g: &mut G,
    pools: &mut List<Any<G>>,
    w: &StoredExperts,
    i: i32,
    slot: i32,
    bytes: LinearArray<u8>,
) with _ {
    let mut pool = pools[i];
    g.written(&mut pool, slot, HostWeight::stored(w.kind, w.extents, bytes));
    pools[i] = pool;
}

/// The source of a model whose experts are all held, which nothing reads.
pub struct Unread {
}

impl WeightSource for Unread {
    fn read(&self, _file: &String, _start: i32, _end: i32) -> Result<LinearArray<u8>, LoadError> {
        unreachable();
    }

    fn len(&self, _file: &String) -> Result<i64, LoadError> {
        unreachable();
    }
}

fn uploaded<affine G: Backend, Axes>(g: &mut G, t: Tensor<i64, Axes>) -> Any<G> with _ {
    return Any::I64(g.relabeled::<i64, Axes, Untyped>(&g.upload(&t)));
}
