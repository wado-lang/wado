//! The graph a pass is built as. Its operations take their meaning from the
//! StableHLO specification, so a compiler of the graph lowers each one to one
//! operation, and `Cpu` computes each as it is added.

use {
    Attention,
    Cpu,
    Element,
    Holds,
    Tensor,
    Window,
    advance,
    conv_grouped,
    element_count,
    max_pool,
    permute,
    reshape,
    sigmoid_f32,
    stretched_strides,
    walked,
} from "./tensor.wado";

/// A StableHLO elementwise operation of one operand. `Erf` is CHLO's, as
/// StableHLO has no error function.
pub enum Unary {
    Abs,
    Erf,
    Exponential,
    Log,
    Logistic,
    Negate,
    Rsqrt,
    Sqrt,
    Tanh,
}

/// A StableHLO elementwise operation of two operands.
pub enum Binary {
    Add,
    Divide,
    Maximum,
    Minimum,
    Multiply,
    Power,
    Subtract,
}

/// The direction of a StableHLO `compare`, which on floats is IEEE's: a NaN
/// equals nothing.
pub enum Comparison {
    Eq,
    Ne,
    Ge,
    Gt,
    Le,
    Lt,
}

/// The dimension numbers of a StableHLO `dot_general`. The result's axes are
/// the batch axes, then the left operand's free axes, then the right's.
pub struct DotDims {
    pub lhs_batch: List<i32>,
    pub rhs_batch: List<i32>,
    pub lhs_contracting: List<i32>,
    pub rhs_contracting: List<i32>,
}

/// The attributes of a StableHLO `gather`, without batching dimensions.
pub struct GatherDims {
    pub offset_dims: List<i32>,
    pub collapsed_slice_dims: List<i32>,
    pub start_index_map: List<i32>,
    pub index_vector_dim: i32,
    pub slice_sizes: List<i32>,
}

/// The attributes of a StableHLO `scatter`, without batching dimensions.
pub struct ScatterDims {
    pub update_window_dims: List<i32>,
    pub inserted_window_dims: List<i32>,
    pub scatter_dims_to_operand_dims: List<i32>,
    pub index_vector_dim: i32,
}

/// The attributes of a StableHLO `convolution` whose input and output are laid
/// out batch, feature, then the spatial axes, and whose kernel is laid out
/// output feature, input feature, then the spatial axes. `padding` holds each
/// spatial axis's low then high padding.
pub struct Convolution {
    pub window_strides: List<i32>,
    pub padding: List<i32>,
    pub rhs_dilation: List<i32>,
    pub feature_group_count: i32,
}

/// The attributes of a StableHLO `reduce_window`, one entry per axis.
/// `padding` holds each axis's low then high padding.
pub struct WindowReduce {
    pub window_dimensions: List<i32>,
    pub window_strides: List<i32>,
    pub window_dilations: List<i32>,
    pub padding: List<i32>,
}

/// A pass built as a graph. Each method adds one operation and returns the
/// tensor it computes. An operation whose output axes are not its operands'
/// takes them as `Out`, which the caller spells.
pub affine trait Graph: Holds with _ {
    /// StableHLO's `iota`: each element its index along `dimension`.
    fn iota<E: Element, Axes>(&mut self, extents: List<i32>, dimension: i32) -> Self::Tensor<E, Axes>;
    fn convert<A: Element, B: Element, Axes>(&mut self, x: &Self::Tensor<A, Axes>) -> Self::Tensor<B, Axes>;
    fn unary<Axes>(&mut self, op: Unary, x: &Self::Tensor<f32, Axes>) -> Self::Tensor<f32, Axes>;
    fn binary<E: Element, Axes>(
        &mut self,
        op: Binary,
        a: &Self::Tensor<E, Axes>,
        b: &Self::Tensor<E, Axes>,
    ) -> Self::Tensor<E, Axes>;
    fn compare<E: Element, Axes>(
        &mut self,
        direction: Comparison,
        a: &Self::Tensor<E, Axes>,
        b: &Self::Tensor<E, Axes>,
    ) -> Self::Tensor<bool, Axes>;
    fn select<E: Element, Axes>(
        &mut self,
        pred: &Self::Tensor<bool, Axes>,
        on_true: &Self::Tensor<E, Axes>,
        on_false: &Self::Tensor<E, Axes>,
    ) -> Self::Tensor<E, Axes>;
    /// StableHLO's `broadcast_in_dim`: operand axis `i` becomes result axis
    /// `dims[i]`, stretched where its extent is 1.
    fn broadcast_in_dim<E: Element, In, Out>(
        &mut self,
        x: &Self::Tensor<E, In>,
        extents: List<i32>,
        dims: List<i32>,
    ) -> Self::Tensor<E, Out>;
    fn reshape<E: Element, In, Out>(&mut self, x: &Self::Tensor<E, In>, extents: List<i32>) -> Self::Tensor<E, Out>;
    /// StableHLO's `transpose`: result axis `i` is operand axis `perm[i]`.
    fn transpose<E: Element, In, Out>(&mut self, x: &Self::Tensor<E, In>, perm: List<i32>) -> Self::Tensor<E, Out>;
    fn slice<E: Element, In, Out>(
        &mut self,
        x: &Self::Tensor<E, In>,
        start: List<i32>,
        limit: List<i32>,
        strides: List<i32>,
    ) -> Self::Tensor<E, Out>;
    fn concatenate<E: Element, A, B, Out>(
        &mut self,
        a: &Self::Tensor<E, A>,
        b: &Self::Tensor<E, B>,
        dimension: i32,
    ) -> Self::Tensor<E, Out>;
    /// StableHLO's `reduce` whose body is `op`, from `init`. The result drops
    /// the axes `dims`.
    fn reduce<In, Out>(
        &mut self,
        x: &Self::Tensor<f32, In>,
        op: Binary,
        init: f32,
        dims: List<i32>,
    ) -> Self::Tensor<f32, Out>;
    fn dot_general<A, B, Out>(
        &mut self,
        lhs: &Self::Tensor<f32, A>,
        rhs: &Self::Tensor<f32, B>,
        dims: &DotDims,
    ) -> Self::Tensor<f32, Out>;
    /// StableHLO's `gather`, which clamps each start index into the operand.
    fn gather<E: Element, D, I, Out>(
        &mut self,
        operand: &Self::Tensor<E, D>,
        indices: &Self::Tensor<i64, I>,
        dims: &GatherDims,
    ) -> Self::Tensor<E, Out>;
    /// StableHLO's `scatter` whose update computation returns the update, so
    /// each element an update reaches is replaced. The specification leaves an
    /// update outside the operand to the implementation; here it is dropped.
    fn scatter<E: Element, D, I, U>(
        &mut self,
        operand: &Self::Tensor<E, D>,
        indices: &Self::Tensor<i64, I>,
        updates: &Self::Tensor<E, U>,
        dims: &ScatterDims,
    ) -> Self::Tensor<E, D>;
    fn convolution<In, K, Out>(
        &mut self,
        x: &Self::Tensor<f32, In>,
        kernel: &Self::Tensor<f32, K>,
        conv: &Convolution,
    ) -> Self::Tensor<f32, Out>;
    fn reduce_window<In, Out>(
        &mut self,
        x: &Self::Tensor<f32, In>,
        op: Binary,
        init: f32,
        window: &WindowReduce,
    ) -> Self::Tensor<f32, Out>;
    /// StableHLO's `reverse` along each of `dims`.
    fn reverse<E: Element, Axes>(&mut self, x: &Self::Tensor<E, Axes>, dims: List<i32>) -> Self::Tensor<E, Axes>;
    /// StableHLO's `case` over two branches: `then` where the one element of
    /// `pred` is true, `otherwise` where it is false. Each branch adds its
    /// operations through the graph it captured, which this call has set to
    /// record into that branch.
    fn conditional<Axes, T>(
        &mut self,
        pred: &Self::Tensor<bool, Axes>,
        then: fn() -> T with _,
        otherwise: fn() -> T with _,
    ) -> T with _;
    /// `x` as a result of the branch being built, each in the order the
    /// branch returns them.
    fn yielded<E: Element, Axes>(&mut self, x: &Self::Tensor<E, Axes>) -> Self::Tensor<E, Axes> {
        return *x;
    }

    /// onnxruntime's `GroupQueryAttention` (its `docs/ContribOperators.md`),
    /// as `group_query_attention` in the kernels computes it, decomposed into
    /// the operations above. Returns the attended queries, then the past key
    /// and value with the new (turned) positions after them. Where
    /// `past_length` is given, the past is a buffer of fixed capacity holding
    /// that many positions, and the present is the same buffer, the new
    /// positions written from there: onnxruntime's shared buffer. The buffer
    /// must hold them, `past_length` + S ≤ P; a position past P is dropped. A
    /// new position may be padding, which a causal mask keeps every valid
    /// query from reading.
    fn group_query_attention<B, S, Q, K, H, P, T, D, Pos, Half, BB, BH>(
        &mut self,
        q: &Self::Tensor<f32, [B, S, Q]>,
        k: &Self::Tensor<f32, [B, S, K]>,
        v: &Self::Tensor<f32, [B, S, K]>,
        past_k: &Self::Tensor<f32, [B, H, P, D]>,
        past_v: &Self::Tensor<f32, [B, H, P, D]>,
        past_length: Option<&Self::Tensor<i64, []>>,
        cos: Option<&Self::Tensor<f32, [Pos, Half]>>,
        sin: Option<&Self::Tensor<f32, [Pos, Half]>>,
        bias: Option<&Self::Tensor<f32, [BB, BH, S, T]>>,
        options: &Attention,
    ) -> [Self::Tensor<f32, [B, S, Q]>, Self::Tensor<f32, [B, H, T, D]>, Self::Tensor<f32, [B, H, T, D]>]
        contract past_length matches { None } || options.causal, "a shared buffer's padding is masked causally"
    {
        return decomposed_attention::<Self, B, S, Q, K, H, P, T, D, Pos, Half, BB, BH>(
            self,
            q,
            k,
            v,
            past_k,
            past_v,
            past_length,
            cos,
            sin,
            bias,
            options,
        );
    }
}

/// `Graph::group_query_attention`'s decomposition, which a graph that runs
/// some cases as a kernel of its own runs for the rest.
pub fn decomposed_attention<affine G: Graph, B, S, Q, K, H, P, T, D, Pos, Half, BB, BH>(
    g: &mut G,
    q: &G::Tensor<f32, [B, S, Q]>,
    k: &G::Tensor<f32, [B, S, K]>,
    v: &G::Tensor<f32, [B, S, K]>,
    past_k: &G::Tensor<f32, [B, H, P, D]>,
    past_v: &G::Tensor<f32, [B, H, P, D]>,
    past_length: Option<&G::Tensor<i64, []>>,
    cos: Option<&G::Tensor<f32, [Pos, Half]>>,
    sin: Option<&G::Tensor<f32, [Pos, Half]>>,
    bias: Option<&G::Tensor<f32, [BB, BH, S, T]>>,
    options: &Attention,
) -> [G::Tensor<f32, [B, S, Q]>, G::Tensor<f32, [B, H, T, D]>, G::Tensor<f32, [B, H, T, D]>] with _ {
    let [batch, s, past, d] = [
        g.extents_of(q)[0],
        g.extents_of(q)[1],
        g.extents_of(past_k)[2],
        g.extents_of(past_k)[3],
    ];
    let [heads, kv] = [options.heads, options.kv_heads];
    let [first, total] = match past_length {
        Some(l) => [*l, past],
        None => [full::<G, i64, []>(g, past as i64, []), past + s],
    };
    let mut query = heads_first::<G, B, S, Q, Heads, D>(g, q, heads, d);
    let mut key = heads_first::<G, B, S, K, H, D>(g, k, kv, d);
    let value = heads_first::<G, B, S, K, H, D>(g, v, kv, d);
    if let Some(c) = cos && let Some(n) = sin {
        let cos_rows = strided_gather::<G, f32, [Pos, Half], [S, Half]>(g, c, 0, &first, s, 1);
        let sin_rows = strided_gather::<G, f32, [Pos, Half], [S, Half]>(g, n, 0, &first, s, 1);
        query = turned::<G, B, Heads, S, D, Half>(g, &query, &cos_rows, &sin_rows);
        key = turned::<G, B, H, S, D, Half>(g, &key, &cos_rows, &sin_rows);
    }
    let mut present = |held: &G::Tensor<f32, [B, H, P, D]>, new: &G::Tensor<f32, [B, H, S, D]>| -> G::Tensor<f32, [B, H, T, D]> {
        if past_length matches { None } {
            return g.concatenate(held, new, 2);
        }
        return g.reshape(&written_at::<G, f32, [B, H, P, D], [B, H, S, D]>(g, held, new, 2, &first), [
            batch, kv, total, d,
        ]);
    };
    let present_k = present(past_k, &key);
    let present_v = present(past_v, &value);
    let keys = grouped::<G, B, H, T, D, Heads>(g, &present_k, heads);
    let values = grouped::<G, B, H, T, D, Heads>(g, &present_v, heads);
    let product = DotDims {
        lhs_batch: [0, 1],
        rhs_batch: [0, 1],
        lhs_contracting: [3],
        rhs_contracting: [3],
    };
    let raw: G::Tensor<f32, [B, Heads, S, T]> = g.dot_general(&query, &keys, &product);
    let score_extents: List<i32> = [batch, heads, s, total];
    let mut scores = g.binary(
        Binary::Multiply,
        &raw,
        &full::<G, f32, [B, Heads, S, T]>(g, options.scale, score_extents),
    );
    if options.softcap > 0.0 {
        let cap = full::<G, f32, [B, Heads, S, T]>(g, options.softcap, score_extents);
        let tanh = g.unary(Unary::Tanh, &g.binary(Binary::Divide, &scores, &cap));
        scores = g.binary(Binary::Multiply, &cap, &tanh);
    }
    if let Some(b) = bias {
        let stretched: G::Tensor<f32, [B, Heads, S, T]> = g.broadcast_in_dim(b, score_extents, [0, 1, 2, 3]);
        scores = g.binary(Binary::Add, &scores, &stretched);
    }
    if options.causal || options.window > 0 {
        let hidden = attention_mask::<G, B, Heads, S, T>(g, &first, options, &score_extents);
        let lowest = full::<G, f32, [B, Heads, S, T]>(g, f32::NEG_INFINITY, score_extents);
        scores = g.select(&hidden, &lowest, &scores);
    }
    let weights = softmax::<G, [B, Heads, S, T]>(g, &scores, 3);
    let attend = DotDims {
        lhs_batch: [0, 1],
        rhs_batch: [0, 1],
        lhs_contracting: [3],
        rhs_contracting: [2],
    };
    let attended: G::Tensor<f32, [B, Heads, S, D]> = g.dot_general(&weights, &values, &attend);
    let back: G::Tensor<f32, [B, S, Heads, D]> = g.transpose(&attended, [0, 2, 1, 3]);
    return [g.reshape(&back, [batch, s, heads * d]), present_k, present_v];
}

/// The query heads, the key heads' groups, and the head width, inside the
/// attention composite's decomposition.
struct Heads {
}
struct Group {
}

/// `[batch, sequence, heads × width]` as `[batch, heads, sequence, width]`.
fn heads_first<affine G: Graph, B, S, X, N, D>(
    g: &mut G,
    x: &G::Tensor<f32, [B, S, X]>,
    heads: i32,
    width: i32,
) -> G::Tensor<f32, [B, N, S, D]> with _ {
    let extents = g.extents_of(x);
    let split: G::Tensor<f32, [B, S, N, D]> = g.reshape(x, [extents[0], extents[1], heads, width]);
    return g.transpose(&split, [0, 2, 1, 3]);
}

/// Each of `x`'s key heads repeated for the `heads / kv` query heads it serves,
/// in order, so query head `h` reads key head `h / (heads / kv)`.
fn grouped<affine G: Graph, B, H, T, D, N>(
    g: &mut G,
    x: &G::Tensor<f32, [B, H, T, D]>,
    heads: i32,
) -> G::Tensor<f32, [B, N, T, D]> with _ {
    let [batch, kv, total, width] = unpacked4(&g.extents_of(x));
    let repeated: G::Tensor<f32, [B, H, Group, T, D]> = g.broadcast_in_dim(x, [batch, kv, heads / kv, total, width], [
        0, 1, 3, 4,
    ]);
    return g.reshape(&repeated, [batch, heads, total, width]);
}

fn unpacked4(extents: &List<i32>) -> [i32, i32, i32, i32] {
    return [extents[0], extents[1], extents[2], extents[3]];
}

/// `value` at every position of `extents`: a constant broadcast, as StableHLO
/// spells one.
pub fn full<affine G: Graph, E: Element, Axes>(g: &mut G, value: E, extents: List<i32>) -> G::Tensor<E, Axes> with _ {
    let scalar: G::Tensor<E, []> = g.upload(&Tensor::<E, []> {
        data: [value],
        extents: [],
    });
    return g.broadcast_in_dim(&scalar, extents, []);
}

/// ONNX's `Softmax` along `axis`: less the greatest along it, exponentiated,
/// over the sum along it.
pub fn softmax<affine G: Graph, Axes>(g: &mut G, x: &G::Tensor<f32, Axes>, axis: i32) -> G::Tensor<f32, Axes> with _ {
    let extents = g.extents_of(x);
    let mut kept: List<i32> = [];
    for let i of 0..<extents.len() {
        if i != axis {
            kept.push(i);
        }
    }
    let top: G::Tensor<f32, Rows> = g.reduce(x, Binary::Maximum, f32::NEG_INFINITY, [axis]);
    let shifted = g.binary(Binary::Subtract, x, &g.broadcast_in_dim(&top, extents, kept));
    let e = g.unary(Unary::Exponential, &shifted);
    let sum: G::Tensor<f32, Rows> = g.reduce(&e, Binary::Add, 0.0, [axis]);
    return g.binary(Binary::Divide, &e, &g.broadcast_in_dim(&sum, extents, kept));
}

/// `Softmax` before opset 13: the axes from `axis` on normalized as one.
pub fn softmax_flattened<affine G: Graph, Axes>(
    g: &mut G,
    x: &G::Tensor<f32, Axes>,
    axis: i32,
) -> G::Tensor<f32, Axes> with _ {
    let extents = g.extents_of(x);
    let rows = element_count(&extents[0..<axis].to_list());
    let flat: G::Tensor<f32, [Rows, Row]> = g.reshape(
        x,
        [rows, element_count(&extents[axis..<extents.len()].to_list())],
    );
    let normalized = softmax::<G, [Rows, Row]>(g, &flat, 1);
    return g.reshape(&normalized, extents);
}

/// `x`'s elements under `rank` axes, those added leading at extent 1, and
/// under the axes `Out` names: a branch's output, say, under the `If`'s.
pub fn lifted<affine G: Graph, E: Element, In, Out>(
    g: &mut G,
    x: &G::Tensor<E, In>,
    rank: i32,
) -> G::Tensor<E, Out> with _ {
    let own = g.extents_of(x);
    let mut extents = List::<i32>::filled(rank - own.len(), 1);
    extents.extend(&own);
    return g.reshape(x, extents);
}

/// ONNX's `ReduceMean` over `dims`, which the result drops: the sum over
/// `count`, the elements each sums, a value the graph computes where a valid
/// length is among them.
pub fn reduce_mean<affine G: Graph, In, Out>(
    g: &mut G,
    x: &G::Tensor<f32, In>,
    dims: List<i32>,
    count: &G::Tensor<i64, []>,
) -> G::Tensor<f32, Out> with _ {
    let sum: G::Tensor<f32, Out> = g.reduce(x, Binary::Add, 0.0, dims);
    let divisor: G::Tensor<f32, Out> = g.broadcast_in_dim(&g.convert::<i64, f32, []>(count), g.extents_of(&sum), []);
    return g.binary(Binary::Divide, &sum, &divisor);
}

/// The one axis of a mask along an axis of a wider tensor.
struct Along {
}

/// `x` with each position along `axis` at or past `length` replaced by
/// `fill`: the padding of a valid length read as what a reduction over it
/// leaves unchanged.
pub fn masked<affine G: Graph, E: Element, Axes>(
    g: &mut G,
    x: &G::Tensor<E, Axes>,
    axis: i32,
    length: &G::Tensor<i64, []>,
    fill: E,
) -> G::Tensor<E, Axes> with _ {
    let extents = g.extents_of(x);
    let along = [extents[axis]] as List<i32>;
    let positions: G::Tensor<i64, [Along]> = g.iota(along, 0);
    let valid_along: G::Tensor<bool, [Along]> = g.compare(Comparison::Lt, &positions, &g.broadcast_in_dim(
        length,
        along,
        [],
    ));
    let valid: G::Tensor<bool, Axes> = g.broadcast_in_dim(&valid_along, extents, [axis]);
    return g.select(&valid, x, &full::<G, E, Axes>(g, fill, extents));
}

/// `a` joined by `b` along `axis`, `b` written from `a`'s valid length
/// `length` on: a `Concat` along a padded length, which would otherwise put
/// `a`'s padding between the two.
pub fn joined_at<affine G: Graph, E: Element, A, B, Out>(
    g: &mut G,
    a: &G::Tensor<E, A>,
    b: &G::Tensor<E, B>,
    axis: i32,
    length: &G::Tensor<i64, []>,
) -> G::Tensor<E, Out> with _ {
    let joined: G::Tensor<E, Out> = g.concatenate(a, b, axis);
    return written_at::<G, E, Out, B>(g, &joined, b, axis, length);
}

/// `a` with `b` written over it along `axis` from `at` on, any part of `b`
/// past `a`'s end dropped.
pub fn written_at<affine G: Graph, E: Element, A, B>(
    g: &mut G,
    a: &G::Tensor<E, A>,
    b: &G::Tensor<E, B>,
    axis: i32,
    at: &G::Tensor<i64, []>,
) -> G::Tensor<E, A> with _ {
    let start: G::Tensor<i64, [Row]> = g.broadcast_in_dim(at, [1], []);
    let dims = ScatterDims {
        update_window_dims: (0..<g.extents_of(b).len()).collect(),
        inserted_window_dims: [],
        scatter_dims_to_operand_dims: [axis],
        index_vector_dim: 0,
    };
    return g.scatter(a, &start, b, &dims);
}

/// ONNX's `Range` of `count` elements: `start`, then `delta` apart, each a
/// value the graph computes, as a valid length is.
pub fn range_i64<affine G: Graph, A>(
    g: &mut G,
    start: &G::Tensor<i64, []>,
    count: i32,
    delta: &G::Tensor<i64, []>,
) -> G::Tensor<i64, [A]> with _ {
    let steps: G::Tensor<i64, [A]> = g.iota([count], 0);
    let scaled = g.binary(Binary::Multiply, &steps, &g.broadcast_in_dim(delta, [count], []));
    return g.binary(Binary::Add, &scaled, &g.broadcast_in_dim(start, [count], []));
}

/// ONNX's indices into an axis of `extent` elements, each negative one counted
/// from the end, as StableHLO's `gather` reads none.
pub fn from_end_indices<affine G: Graph, I>(
    g: &mut G,
    indices: &G::Tensor<i64, I>,
    extent: &G::Tensor<i64, []>,
) -> G::Tensor<i64, I> with _ {
    let extents = g.extents_of(indices);
    let negative = g.compare(Comparison::Lt, indices, &full::<G, i64, I>(g, 0, extents));
    let wrapped = g.binary(Binary::Add, indices, &g.broadcast_in_dim(extent, extents, []));
    return g.select(&negative, &wrapped, indices);
}

/// `a / d` rounded down, or up where `up`, as shape arithmetic divides.
/// StableHLO's `divide` rounds toward zero, which is the other way where the
/// remainder is not zero: down where it and `d` differ in sign, up where they
/// agree.
pub fn quotient<affine G: Graph, Axes>(
    g: &mut G,
    a: &G::Tensor<i64, Axes>,
    d: &G::Tensor<i64, Axes>,
    up: bool,
) -> G::Tensor<i64, Axes> with _ {
    let extents = g.extents_of(a);
    let toward_zero = g.binary(Binary::Divide, a, d);
    let rest = g.binary(Binary::Subtract, a, &g.binary(Binary::Multiply, &toward_zero, d));
    let zero = full::<G, i64, Axes>(g, 0, extents);
    let signs = g.compare(
        if up { Comparison::Eq } else { Comparison::Ne },
        &g.compare(Comparison::Lt, &rest, &zero),
        &g.compare(Comparison::Lt, d, &zero),
    );
    let off = g.select(&g.compare(Comparison::Ne, &rest, &zero), &signs, &full::<G, bool, Axes>(g, false, extents));
    let step = full::<G, i64, Axes>(g, if up { 1 } else { -1 }, extents);
    return g.select(&off, &g.binary(Binary::Add, &toward_zero, &step), &toward_zero);
}

/// A tensor of `extents` holding `elements` in row-major order: a literal of
/// shape arithmetic whose elements are values the graph computes.
pub fn assembled<affine G: Graph, E: Element, Axes>(
    g: &mut G,
    elements: List<G::Tensor<i64, []>>,
    extents: List<i32>,
) -> G::Tensor<E, Axes> with _ {
    let count = elements.len();
    let positions: G::Tensor<i64, [Row]> = g.iota([count], 0);
    let mut flat = full::<G, i64, [Row]>(g, 0, [count]);
    for let [i, e] of elements.into_iter().enumerate() {
        let here = g.compare(Comparison::Eq, &positions, &full::<G, i64, [Row]>(g, i as i64, [count]));
        flat = g.select(&here, &g.broadcast_in_dim(&e, [count], []), &flat);
    }
    let shaped: G::Tensor<i64, Axes> = g.reshape(&flat, extents);
    return g.convert(&shaped);
}

/// `x`'s elements at `start + i * step` along `axis`, for each `i` below
/// `count`: a `Slice` whose start is a value the graph computes, which no
/// `slice` takes.
pub fn strided_gather<affine G: Graph, E: Element, In, Out>(
    g: &mut G,
    x: &G::Tensor<E, In>,
    axis: i32,
    start: &G::Tensor<i64, []>,
    count: i32,
    step: i64,
) -> G::Tensor<E, Out> with _ {
    let indices = range_i64::<G, Row>(g, start, count, &full::<G, i64, []>(g, step, []));
    let mut sizes = g.extents_of(x);
    sizes[axis] = 1;
    let dims = GatherDims {
        offset_dims: (0..<sizes.len()).filter(|d| d != axis).collect(),
        collapsed_slice_dims: [axis],
        start_index_map: [axis],
        index_vector_dim: 1,
        slice_sizes: sizes,
    };
    return g.gather(x, &indices, &dims);
}

/// The capacity a length pads to: the next power of two, and 0 its own.
pub fn capacity_of(length: i32) -> i32
    contract 0 <= length <= 1 << 30, "a capacity is a power of two an i32 holds"
{
    let mut capacity = if length == 0 { 0 } else { 1 };
    while capacity < length {
        capacity *= 2;
    }
    return capacity;
}

/// `x` with `axis` cut to `extent` or padded past its own with zeros, where
/// the graph holds it: a cache moved to the capacity a pass takes it at.
pub fn fitted<affine G: Graph, E: Element, Axes>(
    g: &mut G,
    x: &G::Tensor<E, Axes>,
    axis: i32,
    extent: i32,
) -> G::Tensor<E, Axes> with _ {
    let mut extents = g.extents_of(x);
    let own = extents[axis];
    if extent == own {
        return *x;
    }
    if extent < own {
        let mut limits = extents;
        limits[axis] = extent;
        let rank = extents.len();
        return g.slice(x, List::<i32>::filled(rank, 0), limits, List::<i32>::filled(rank, 1));
    }
    extents[axis] = extent - own;
    let zeros = full::<G, E, Axes>(g, E::from_i64(0), extents);
    return g.concatenate(x, &zeros, axis);
}

/// `t` under `extents`, each axis cut to its extent or padded past it with
/// zeros: an input padded to its capacities, or an output cut to its lengths.
/// An element need only be stored, since an input held in half precision is.
pub fn resized<E: Default, Axes>(t: &Tensor<E, Axes>, extents: List<i32>) -> Tensor<E, Axes>
    contract extents.len() == t.extents.len()
{
    let own = row_major_strides(&t.extents);
    let count = element_count(&extents);
    let mut data = List::<E>::with_capacity(count);
    let mut index = List::<i32>::filled(extents.len(), 0);
    for let _ of 0..<count {
        let mut at = 0;
        let mut inside = true;
        for let [a, i] of index.into_iter().enumerate() {
            inside = inside && i < t.extents[a];
            at += i * own[a];
        }
        data.push(if inside { t.data[at] } else { E::default() });
        advance(&mut index, &extents);
    }
    return Tensor { data, extents };
}

/// An axis of extent 1 a built pass adds, as a matrix product does to an
/// operand of rank 1.
pub struct One {
}

/// The axes left once a reduction drops one, inside these helpers, and the
/// axis it drops where they flatten a tensor into rows.
struct Rows {
}
struct Row {
}

/// `x`'s rows `[a, b, rest]`, `a` and `b` as wide as a row of `cos`, turned
/// by `(a cos − b sin, b cos + a sin)` of the row of `cos` and `sin` at each
/// row's position, and `rest` as it is.
fn turned<affine G: Graph, B, N, S, D, Half>(
    g: &mut G,
    x: &G::Tensor<f32, [B, N, S, D]>,
    cos: &G::Tensor<f32, [S, Half]>,
    sin: &G::Tensor<f32, [S, Half]>,
) -> G::Tensor<f32, [B, N, S, D]> with _ {
    let extents = g.extents_of(x);
    let half = g.extents_of(cos)[1];
    let columns = |from: i32, to: i32| -> [List<i32>, List<i32>] {
        return [
            [0, 0, 0, from],
            [extents[0], extents[1], extents[2], to],
        ];
    };
    let [a_start, a_limit] = columns(0, half);
    let [b_start, b_limit] = columns(half, 2 * half);
    let a: G::Tensor<f32, [B, N, S, Half]> = g.slice(x, a_start, a_limit, [1, 1, 1, 1]);
    let b: G::Tensor<f32, [B, N, S, Half]> = g.slice(x, b_start, b_limit, [1, 1, 1, 1]);
    let c: G::Tensor<f32, [B, N, S, Half]> = g.broadcast_in_dim(cos, a_limit, [2, 3]);
    let n: G::Tensor<f32, [B, N, S, Half]> = g.broadcast_in_dim(sin, a_limit, [2, 3]);
    let first = g.binary(Binary::Subtract, &g.binary(Binary::Multiply, &a, &c), &g.binary(Binary::Multiply, &b, &n));
    let second = g.binary(Binary::Add, &g.binary(Binary::Multiply, &b, &c), &g.binary(Binary::Multiply, &a, &n));
    let rotated: G::Tensor<f32, [B, N, S, D]> = g.concatenate(&first, &second, 3);
    if 2 * half == extents[3] {
        return rotated;
    }
    let [rest_start, rest_limit] = columns(2 * half, extents[3]);
    let rest: G::Tensor<f32, [B, N, S, D]> = g.slice(x, rest_start, rest_limit, [1, 1, 1, 1]);
    return g.concatenate(&rotated, &rest, 3);
}

/// Where a query at row `i` after `first` positions may not read key `j`: past
/// it where `causal`, and `window` or more before it where there is a window.
fn attention_mask<affine G: Graph, B, N, S, T>(
    g: &mut G,
    first: &G::Tensor<i64, []>,
    options: &Attention,
    extents: &List<i32>,
) -> G::Tensor<bool, [B, N, S, T]> with _ {
    let plane: List<i32> = [extents[2], extents[3]];
    let row: G::Tensor<i64, [S, T]> = g.iota(plane, 0);
    let position = g.binary(Binary::Add, &row, &g.broadcast_in_dim(first, plane, []));
    let key: G::Tensor<i64, [S, T]> = g.iota(plane, 1);
    let mut hidden: G::Tensor<bool, [S, T]> = if options.causal {
        g.compare(Comparison::Gt, &key, &position);
    } else {
        full::<G, bool, [S, T]>(g, false, plane);
    };
    if options.window > 0 {
        let behind = g.binary(Binary::Subtract, &position, &key);
        let far = g.compare(Comparison::Ge, &behind, &full::<G, i64, [S, T]>(g, options.window as i64, plane));
        hidden = g.select(&far, &far, &hidden);
    }
    return g.broadcast_in_dim(&hidden, *extents, [2, 3]);
}

impl Graph for Cpu {
    fn iota<E: Element, Axes>(&mut self, extents: List<i32>, dimension: i32) -> Tensor<E, Axes> {
        let mut data = List::<E>::with_capacity(element_count(&extents));
        let mut index = List::<i32>::filled(extents.len(), 0);
        for let _ of 0..<element_count(&extents) {
            data.push(E::from_i64(index[dimension] as i64));
            advance(&mut index, &extents);
        }
        return Tensor { data, extents };
    }

    fn convert<A: Element, B: Element, Axes>(&mut self, x: &Tensor<A, Axes>) -> Tensor<B, Axes> {
        let mut data = List::<B>::with_capacity(x.data.len());
        for let v of x.data {
            data.push(v.cast_to::<B>());
        }
        return Tensor { data, extents: x.extents };
    }

    fn unary<Axes>(&mut self, op: Unary, x: &Tensor<f32, Axes>) -> Tensor<f32, Axes> {
        let mut data = List::<f32>::with_capacity(x.data.len());
        for let v of x.data {
            data.push(unary_f32(op, v));
        }
        return Tensor { data, extents: x.extents };
    }

    fn binary<E: Element, Axes>(&mut self, op: Binary, a: &Tensor<E, Axes>, b: &Tensor<E, Axes>) -> Tensor<E, Axes> {
        let extents = elementwise_extents([a.extents, b.extents]);
        let mut data = List::<E>::with_capacity(a.data.len());
        if E::is_f32() {
            for let i of 0..<a.data.len() {
                data.push(E::from_f32(binary_f32(op, a.data[i].cast_to::<f32>(), b.data[i].cast_to::<f32>())));
            }
        } else {
            for let i of 0..<a.data.len() {
                data.push(E::from_i64(binary_i64(op, a.data[i].cast_to::<i64>(), b.data[i].cast_to::<i64>())));
            }
        }
        return Tensor { data, extents };
    }

    fn compare<E: Element, Axes>(
        &mut self,
        direction: Comparison,
        a: &Tensor<E, Axes>,
        b: &Tensor<E, Axes>,
    ) -> Tensor<bool, Axes> {
        let extents = elementwise_extents([a.extents, b.extents]);
        let mut data = List::<bool>::with_capacity(a.data.len());
        for let i of 0..<a.data.len() {
            data.push(if E::is_f32() {
                compared_f32(direction, a.data[i].cast_to::<f32>(), b.data[i].cast_to::<f32>());
            } else {
                compared_i64(direction, a.data[i].cast_to::<i64>(), b.data[i].cast_to::<i64>());
            });
        }
        return Tensor { data, extents };
    }

    fn select<E: Element, Axes>(
        &mut self,
        pred: &Tensor<bool, Axes>,
        on_true: &Tensor<E, Axes>,
        on_false: &Tensor<E, Axes>,
    ) -> Tensor<E, Axes> {
        let extents = elementwise_extents([pred.extents, on_true.extents, on_false.extents]);
        let mut data = List::<E>::with_capacity(pred.data.len());
        for let i of 0..<pred.data.len() {
            data.push(if pred.data[i] { on_true.data[i] } else { on_false.data[i] });
        }
        return Tensor { data, extents };
    }

    fn broadcast_in_dim<E: Element, In, Out>(
        &mut self,
        x: &Tensor<E, In>,
        extents: List<i32>,
        dims: List<i32>,
    ) -> Tensor<E, Out> {
        let extents = broadcast_in_dim_extents(&x.extents, extents, &dims);
        let own = row_major_strides(&x.extents);
        let mut strides = List::<i32>::filled(extents.len(), 0);
        for let [i, d] of dims.into_iter().enumerate() {
            if x.extents[i] != 1 {
                strides[d] = own[i];
            }
        }
        return Tensor { data: walked(&x.data, 0, &strides, &extents), extents };
    }

    fn reshape<E: Element, In, Out>(&mut self, x: &Tensor<E, In>, extents: List<i32>) -> Tensor<E, Out> {
        return reshape(x, extents);
    }

    fn transpose<E: Element, In, Out>(&mut self, x: &Tensor<E, In>, perm: List<i32>) -> Tensor<E, Out> {
        if is_identity(&perm) {
            return Tensor { data: x.data, extents: x.extents };
        }
        return permute(x, perm);
    }

    fn slice<E: Element, In, Out>(
        &mut self,
        x: &Tensor<E, In>,
        start: List<i32>,
        limit: List<i32>,
        strides: List<i32>,
    ) -> Tensor<E, Out> {
        let own = row_major_strides(&x.extents);
        let mut base = 0;
        let mut steps: List<i32> = [];
        for let i of 0..<x.extents.len() {
            base += start[i] * own[i];
            steps.push(own[i] * strides[i]);
        }
        let extents = sliced_extents(&x.extents, &start, &limit, &strides);
        return Tensor { data: walked(&x.data, base, &steps, &extents), extents };
    }

    fn concatenate<E: Element, A, B, Out>(
        &mut self,
        a: &Tensor<E, A>,
        b: &Tensor<E, B>,
        dimension: i32,
    ) -> Tensor<E, Out> {
        let extents = joined_extents(&a.extents, &b.extents, dimension);
        let outer = element_count(&a.extents[0..<dimension].to_list());
        let [a_run, b_run] = [
            element_count(&a.extents[dimension..<a.extents.len()].to_list()),
            element_count(&b.extents[dimension..<b.extents.len()].to_list()),
        ];
        let mut data = List::<E>::with_capacity(element_count(&extents));
        for let o of 0..<outer {
            data.extend_from_slice(a.data[o * a_run..<(o + 1) * a_run]);
            data.extend_from_slice(b.data[o * b_run..<(o + 1) * b_run]);
        }
        return Tensor { data, extents };
    }

    fn reduce<In, Out>(&mut self, x: &Tensor<f32, In>, op: Binary, init: f32, dims: List<i32>) -> Tensor<f32, Out> {
        let kept = kept_axes(x.extents.len(), &dims);
        let mut perm = kept;
        perm.extend(&(0..<x.extents.len()).filter(|i| dims.contains(&i)).collect());
        let laid: Tensor<f32, In> = self.transpose(x, perm);
        let extents = picked(&x.extents, &kept);
        let rows = element_count(&extents);
        let width = if rows == 0 { 0 } else { laid.data.len() / rows };
        let mut data = List::<f32>::with_capacity(rows);
        for let r of 0..<rows {
            let mut acc = init;
            for let j of 0..<width {
                acc = binary_f32(op, acc, laid.data[r * width + j]);
            }
            data.push(acc);
        }
        return Tensor { data, extents };
    }

    fn dot_general<A, B, Out>(&mut self, lhs: &Tensor<f32, A>, rhs: &Tensor<f32, B>, dims: &DotDims) -> Tensor<f32, Out> {
        let extents = dot_extents(&lhs.extents, &rhs.extents, dims);
        let lhs_free = free_axes(lhs.extents.len(), &dims.lhs_batch, &dims.lhs_contracting);
        let rhs_free = free_axes(rhs.extents.len(), &dims.rhs_batch, &dims.rhs_contracting);
        let batch = element_count(&picked(&lhs.extents, &dims.lhs_batch));
        let [m, k, n] = [
            element_count(&picked(&lhs.extents, &lhs_free)),
            element_count(&picked(&lhs.extents, &dims.lhs_contracting)),
            element_count(&picked(&rhs.extents, &rhs_free)),
        ];
        let mut lhs_order = dims.lhs_batch;
        lhs_order.extend(&lhs_free);
        lhs_order.extend(&dims.lhs_contracting);
        let a = laid_out(lhs, &lhs_order);
        // A weight is read in place in either order it is stored in, rather
        // than copied on every call: by rows where its contracting axes are
        // last, as a tied embedding's are, and by columns where they lead.
        let mut by_rows = dims.rhs_batch;
        by_rows.extend(&rhs_free);
        by_rows.extend(&dims.rhs_contracting);
        if is_identity(&by_rows) {
            return Tensor { data: product_by_rows(a.of(lhs), &rhs.data, batch, m, k, n), extents };
        }
        let mut by_columns = dims.rhs_batch;
        by_columns.extend(&dims.rhs_contracting);
        by_columns.extend(&rhs_free);
        let b = laid_out(rhs, &by_columns);
        return Tensor { data: product_by_columns(a.of(lhs), b.of(rhs), batch, m, k, n), extents };
    }

    fn gather<E: Element, D, I, Out>(
        &mut self,
        operand: &Tensor<E, D>,
        indices: &Tensor<i64, I>,
        dims: &GatherDims,
    ) -> Tensor<E, Out> {
        let rank = operand.extents.len();
        let implicit = dims.index_vector_dim == indices.extents.len();
        let offset_axes: List<i32> = (0..<rank).filter(|a| !dims.collapsed_slice_dims.contains(&a)).collect();
        let extents = gathered_extents(&indices.extents, dims);
        let out_rank = extents.len();
        let batch_at: List<i32> = (0..<out_rank).filter(|d| !dims.offset_dims.contains(&d)).collect();
        let own = row_major_strides(&operand.extents);
        let index_strides = row_major_strides(&indices.extents);
        let vector_stride = if implicit { 0 } else { index_strides[dims.index_vector_dim] };
        let mut data = List::<E>::with_capacity(element_count(&extents));
        let mut out = List::<i32>::filled(out_rank, 0);
        for let _ of 0..<element_count(&extents) {
            let mut index_base = 0;
            let mut batch_axis = 0;
            for let i of 0..<indices.extents.len() {
                if i == dims.index_vector_dim {
                    continue;
                }
                index_base += out[batch_at[batch_axis]] * index_strides[i];
                batch_axis += 1;
            }
            let mut at = 0;
            for let [k, axis] of dims.start_index_map.into_iter().enumerate() {
                let start = indices.data[index_base + k * vector_stride];
                let room = (operand.extents[axis] - dims.slice_sizes[axis]) as i64;
                at += i64::clamp(start, 0, room) as i32 * own[axis];
            }
            for let [j, d] of dims.offset_dims.into_iter().enumerate() {
                at += out[d] * own[offset_axes[j]];
            }
            data.push(operand.data[at]);
            advance(&mut out, &extents);
        }
        return Tensor { data, extents };
    }

    fn scatter<E: Element, D, I, U>(
        &mut self,
        operand: &Tensor<E, D>,
        indices: &Tensor<i64, I>,
        updates: &Tensor<E, U>,
        dims: &ScatterDims,
    ) -> Tensor<E, D> {
        let rank = operand.extents.len();
        let window_axes: List<i32> = (0..<rank).filter(|a| !dims.inserted_window_dims.contains(&a)).collect();
        let index_axes: List<i32> = (0..<indices.extents.len()).filter(|i| i != dims.index_vector_dim).collect();
        let scatter_axes: List<i32> = (0..<updates.extents.len()).filter(|d| !dims.update_window_dims.contains(&d)).collect();
        let own = row_major_strides(&operand.extents);
        let index_strides = row_major_strides(&indices.extents);
        let vector_stride = if dims.index_vector_dim == indices.extents.len() {
            0;
        } else {
            index_strides[dims.index_vector_dim];
        };
        let mut data = operand.data;
        let mut u = List::<i32>::filled(updates.extents.len(), 0);
        for let n of 0..<element_count(&updates.extents) {
            let mut index_base = 0;
            for let [k, i] of index_axes.into_iter().enumerate() {
                index_base += u[scatter_axes[k]] * index_strides[i];
            }
            let mut position = List::<i64>::filled(rank, 0);
            for let [k, axis] of dims.scatter_dims_to_operand_dims.into_iter().enumerate() {
                position[axis] = indices.data[index_base + k * vector_stride];
            }
            for let [j, d] of dims.update_window_dims.into_iter().enumerate() {
                position[window_axes[j]] += u[d] as i64;
            }
            let mut at = 0;
            let mut inside = true;
            for let a of 0..<rank {
                inside = inside && 0 <= position[a] < operand.extents[a] as i64;
                at += position[a] as i32 * own[a];
            }
            if inside {
                data[at] = updates.data[n];
            }
            advance(&mut u, &updates.extents);
        }
        return Tensor { data, extents: operand.extents };
    }

    fn convolution<In, K, Out>(
        &mut self,
        x: &Tensor<f32, In>,
        kernel: &Tensor<f32, K>,
        conv: &Convolution,
    ) -> Tensor<f32, Out> {
        let window = conv_window(&x.extents, &kernel.extents, conv);
        let t = conv_grouped::<Batch, Feature, Feature, Feature, [Spatial], [Spatial], [Spatial]>(
            &Tensor { data: x.data, extents: x.extents },
            &Tensor { data: kernel.data, extents: kernel.extents },
            conv.feature_group_count,
            &window,
            &null,
        );
        return Tensor { data: t.data, extents: t.extents };
    }

    fn reduce_window<In, Out>(
        &mut self,
        x: &Tensor<f32, In>,
        op: Binary,
        init: f32,
        window: &WindowReduce,
    ) -> Tensor<f32, Out>
        contract op matches { Maximum } && init == f32::NEG_INFINITY, "the CPU reduces windows by their greatest alone"
    {
        let pooled = pooled_window(&x.extents, window);
        let t = max_pool::<Batch, Feature, [Spatial], [Spatial]>(&Tensor { data: x.data, extents: x.extents }, &pooled);
        return Tensor { data: t.data, extents: t.extents };
    }

    fn reverse<E: Element, Axes>(&mut self, x: &Tensor<E, Axes>, dims: List<i32>) -> Tensor<E, Axes> {
        let mut strides = row_major_strides(&x.extents);
        let mut base = 0;
        for let d of dims {
            base += (x.extents[d] - 1) * strides[d];
            strides[d] = -strides[d];
        }
        return Tensor { data: walked(&x.data, base, &strides, &x.extents), extents: x.extents };
    }

    fn conditional<Axes, T>(
        &mut self,
        pred: &Tensor<bool, Axes>,
        then: fn() -> T with _,
        otherwise: fn() -> T with _,
    ) -> T with _ {
        assert pred.data.len() == 1, "a condition is one element";
        return if pred.data[0] { then() } else { otherwise() };
    }
}

/// The axes a convolution's kernels type their operands by, which the CPU
/// reads only through extents, a window's spatial axes being one pack of any
/// rank.
struct Batch {
}
struct Feature {
}
struct Spatial {
}

fn unary_f32(op: Unary, v: f32) -> f32 {
    return match op {
        Abs => f32::abs(v),
        Erf => f32::erf(v),
        Exponential => f32::exp(v),
        Log => f32::ln(v),
        Logistic => sigmoid_f32(v),
        Negate => -v,
        Rsqrt => 1.0 / f32::sqrt(v),
        Sqrt => f32::sqrt(v),
        Tanh => f32::tanh(v),
    };
}

/// StableHLO's float arithmetic: `maximum` and `minimum` are NaN where either
/// operand is.
fn binary_f32(op: Binary, a: f32, b: f32) -> f32 {
    return match op {
        Add => a + b,
        Divide => a / b,
        Maximum => f32::ieee754_max(a, b),
        Minimum => f32::ieee754_min(a, b),
        Multiply => a * b,
        Power => f32::pow(a, b),
        Subtract => a - b,
    };
}

/// StableHLO's integer arithmetic, which wraps and divides toward zero.
fn binary_i64(op: Binary, a: i64, b: i64) -> i64 {
    return match op {
        Add => a + b,
        Divide => a / b,
        Maximum => i64::max(a, b),
        Minimum => i64::min(a, b),
        Multiply => a * b,
        Power => unreachable(),
        Subtract => a - b,
    };
}

fn compared_f32(direction: Comparison, a: f32, b: f32) -> bool {
    return match direction {
        Eq => a.ieee754_eq(b),
        Ne => !a.ieee754_eq(b),
        Ge => a.ieee754_ge(b),
        Gt => a.ieee754_gt(b),
        Le => a.ieee754_le(b),
        Lt => a.ieee754_lt(b),
    };
}

fn compared_i64(direction: Comparison, a: i64, b: i64) -> bool {
    return match direction {
        Eq => a == b,
        Ne => a != b,
        Ge => a >= b,
        Gt => a > b,
        Le => a <= b,
        Lt => a < b,
    };
}

/// Each axis's step through a row-major tensor of `extents`. An axis of 1
/// steps by zero, which reads the same elements.
fn row_major_strides(extents: &List<i32>) -> List<i32> {
    return stretched_strides(extents, extents.len());
}

fn is_identity(perm: &List<i32>) -> bool {
    for let [i, p] of perm.into_iter().enumerate() {
        if *p != i {
            return false;
        }
    }
    return true;
}

/// An operand's elements walked in another order of its axes, or none where
/// that order is its own.
struct Laid {
    data: Option<List<f32>>,
}

impl Laid {
    /// The elements in the order asked for, read from `x` where they are its own.
    fn of<Axes>(&self, x: &Tensor<f32, Axes>) -> &List<f32> {
        return match &self.data {
            Some(laid) => laid,
            None => &x.data,
        };
    }
}

/// `x`'s elements with its axes in `order`.
fn laid_out<Axes>(x: &Tensor<f32, Axes>, order: &List<i32>) -> Laid {
    if is_identity(order) {
        return Laid { data: null };
    }
    let strides = picked(&row_major_strides(&x.extents), order);
    return Laid { data: Option::Some(walked(&x.data, 0, &strides, &picked(&x.extents, order))) };
}

/// The extents of the axes `axes`, in that order.
internal fn picked(extents: &List<i32>, axes: &List<i32>) -> List<i32> {
    let mut out: List<i32> = [];
    for let a of *axes {
        out.push(extents[a]);
    }
    return out;
}

/// The axes of a `rank` operand of `dot_general` neither batch nor contracting.
internal fn free_axes(rank: i32, batch: &List<i32>, contracting: &List<i32>) -> List<i32> {
    let mut free: List<i32> = [];
    for let a of 0..<rank {
        if !batch.contains(&a) && !contracting.contains(&a) {
            free.push(a);
        }
    }
    return free;
}

/// The axes of a rank `rank` operand that a reduction over `dims` keeps.
internal fn kept_axes(rank: i32, dims: &List<i32>) -> List<i32> {
    return (0..<rank).filter(|i| !dims.contains(&i)).collect();
}

/// The extents of an elementwise operation over operands of `operands`.
pub fn elementwise_extents(operands: List<List<i32>>) -> List<i32> {
    for let o of operands {
        assert o == operands[0], "the operands of an elementwise operation share their extents";
    }
    return operands[0];
}

/// `extents`, checked as the result a `broadcast_in_dim` of an operand of
/// `own` along `dims` can have. ONNX's rule is `broadcast_extents`.
pub fn broadcast_in_dim_extents(own: &List<i32>, extents: List<i32>, dims: &List<i32>) -> List<i32> {
    assert dims.len() == own.len(), "broadcast_in_dim maps every operand axis";
    for let [i, d] of dims.into_iter().enumerate() {
        assert own[i] == 1 || own[i] == extents[*d], "an operand axis is 1 or the result's";
    }
    return extents;
}

/// The extents a `reduce` over `dims` leaves of `extents`.
pub fn reduced_extents(extents: &List<i32>, dims: &List<i32>) -> List<i32> {
    return picked(extents, &kept_axes(extents.len(), dims));
}

/// The extents of a `slice` of an operand of `extents`.
pub fn sliced_extents(extents: &List<i32>, start: &List<i32>, limit: &List<i32>, strides: &List<i32>) -> List<i32> {
    let mut out: List<i32> = [];
    for let i of 0..<extents.len() {
        assert 0 <= start[i] <= limit[i] <= extents[i] && strides[i] > 0, "a slice lies within its operand";
        out.push((limit[i] - start[i]).div_ceil(strides[i]));
    }
    return out;
}

/// The extents of `a` and `b` joined along `dimension`.
pub fn joined_extents(a: &List<i32>, b: &List<i32>, dimension: i32) -> List<i32> {
    let mut extents = *a;
    extents[dimension] = a[dimension] + b[dimension];
    for let i of 0..<extents.len() {
        assert i == dimension || a[i] == b[i], "concatenated operands agree off the joined axis";
    }
    return extents;
}

/// The extents of a `dot_general`: the batch axes, then the left operand's free
/// axes, then the right's.
pub fn dot_extents(lhs: &List<i32>, rhs: &List<i32>, dims: &DotDims) -> List<i32> {
    for let [i, a] of dims.lhs_batch.into_iter().enumerate() {
        assert lhs[a] == rhs[dims.rhs_batch[i]], "the batch axes agree";
    }
    for let [i, a] of dims.lhs_contracting.into_iter().enumerate() {
        assert lhs[a] == rhs[dims.rhs_contracting[i]], "the contracting axes agree";
    }
    let mut extents = picked(lhs, &dims.lhs_batch);
    extents.extend(&picked(lhs, &free_axes(lhs.len(), &dims.lhs_batch, &dims.lhs_contracting)));
    extents.extend(&picked(rhs, &free_axes(rhs.len(), &dims.rhs_batch, &dims.rhs_contracting)));
    return extents;
}

/// The extents of a `gather` by indices of `indices`: each offset axis a
/// slice size where `offset_dims` places it, the indices' batch axes between.
pub fn gathered_extents(indices: &List<i32>, dims: &GatherDims) -> List<i32> {
    let batch: List<i32> = (0..<indices.len()).filter(|i| i != dims.index_vector_dim).map(|i| indices[i]).collect();
    let offsets: List<i32> = (0..<dims.slice_sizes.len()).filter(|a| !dims.collapsed_slice_dims.contains(&a)).map(
        |a| dims.slice_sizes[a],
    ).collect();
    let mut extents: List<i32> = [];
    let [mut b, mut o] = [0, 0];
    for let d of 0..<batch.len() + offsets.len() {
        if dims.offset_dims.contains(&d) {
            extents.push(offsets[o]);
            o += 1;
        } else {
            extents.push(batch[b]);
            b += 1;
        }
    }
    return extents;
}

/// The window a `convolution` of an input of `x` by a kernel of `kernel` slides.
pub fn conv_window(x: &List<i32>, kernel: &List<i32>, conv: &Convolution) -> Window {
    let mut window = Window {
        kernel: [],
        strides: conv.window_strides,
        dilations: conv.rhs_dilation,
        pads: [],
        output: [],
    };
    let mut ends: List<i32> = [];
    for let i of 0..<x.len() - 2 {
        let k = kernel[2 + i];
        let [lo, hi] = [conv.padding[2 * i], conv.padding[2 * i + 1]];
        window.kernel.push(k);
        window.pads.push(lo);
        ends.push(hi);
        let span = (k - 1) * conv.rhs_dilation[i] + 1;
        window.output.push((x[2 + i] + lo + hi - span) / conv.window_strides[i] + 1);
    }
    window.pads.extend(&ends);
    return window;
}

/// The window a `reduce_window` over an input of `x` slides, its batch and
/// feature axes windows of one.
pub fn pooled_window(x: &List<i32>, window: &WindowReduce) -> Window {
    let mut pooled = Window { kernel: [], strides: [], dilations: [], pads: [], output: [] };
    let mut ends: List<i32> = [];
    for let a of 0..<2 {
        assert window.window_dimensions[a] == 1 && window.window_strides[a] == 1, "the batch and feature axes are windows of one";
    }
    for let i of 2..<x.len() {
        let k = window.window_dimensions[i];
        let [lo, hi] = [window.padding[2 * i], window.padding[2 * i + 1]];
        pooled.kernel.push(k);
        pooled.strides.push(window.window_strides[i]);
        pooled.dilations.push(window.window_dilations[i]);
        pooled.pads.push(lo);
        ends.push(hi);
        let span = (k - 1) * window.window_dilations[i] + 1;
        pooled.output.push((x[i] + lo + hi - span) / window.window_strides[i] + 1);
    }
    pooled.pads.extend(&ends);
    return pooled;
}

/// `batch` products of an `[m, k]` matrix by a `[k, n]` one, each output row
/// a sum of the right operand's rows.
fn product_by_columns(a: &List<f32>, b: &List<f32>, batch: i32, m: i32, k: i32, n: i32) -> List<f32>
    contract a.len() == batch * m * k && b.len() == batch * k * n
{
    let mut out = List::<f32>::filled(batch * m * n, 0.0);
    for let s of 0..<batch {
        for let r of 0..<m {
            let row = (s * m + r) * n;
            for let j of 0..<k {
                let av = unchecked a[(s * m + r) * k + j];
                let from = (s * k + j) * n;
                for let c of 0..<n {
                    out[row + c] += av * unchecked b[from + c];
                }
            }
        }
    }
    return out;
}

/// `batch` products of an `[m, k]` matrix by the transpose of an `[n, k]` one,
/// each output element a dot product of two contiguous rows.
fn product_by_rows(a: &List<f32>, b: &List<f32>, batch: i32, m: i32, k: i32, n: i32) -> List<f32>
    contract a.len() == batch * m * k && b.len() == batch * n * k
{
    let mut out = List::<f32>::with_capacity(batch * m * n);
    for let s of 0..<batch {
        for let r of 0..<m {
            let a_at = (s * m + r) * k;
            for let c of 0..<n {
                let b_at = (s * n + c) * k;
                let [mut s0, mut s1, mut s2, mut s3]: [f32, f32, f32, f32] = [0.0, 0.0, 0.0, 0.0];
                let quads = k - k % 4;
                for let mut j = 0; j < quads; j += 4 {
                    s0 += unchecked a[a_at + j] * unchecked b[b_at + j];
                    s1 += unchecked a[a_at + j + 1] * unchecked b[b_at + j + 1];
                    s2 += unchecked a[a_at + j + 2] * unchecked b[b_at + j + 2];
                    s3 += unchecked a[a_at + j + 3] * unchecked b[b_at + j + 3];
                }
                for let j of quads..<k {
                    s0 += unchecked a[a_at + j] * unchecked b[b_at + j];
                }
                out.push(s0 + s1 + (s2 + s3));
            }
        }
    }
    return out;
}
