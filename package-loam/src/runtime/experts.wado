//! onnxruntime's `QMoE` (its `docs/ContribOperators.md`): each token through
//! the `k` experts its router's logits rank highest, each expert a SwiGLU
//! between two block-quantized products, the results weighed by the router's
//! softmax.

use { ElementKind, Float, element_count, optional } from "./tensor.wado";
use { Binary, Comparison, Graph, One, Quantized, Unary, full, rows_at, scalar, softmax } from "./hlo.wado";
use { Any, Untyped, typed } from "./recorded.wado";

/// What a `QMoE` computes beyond its operands, off its attributes.
pub struct Experts {
    /// How many experts each token runs.
    pub k: i32,
    /// Whether a token's weights are its picks' softmax over the picks alone,
    /// rather than over every expert.
    pub normalized: bool,
    /// The SwiGLU's gate scale, the offset added to its up value, and the bound
    /// on both.
    pub alpha: f32,
    pub beta: f32,
    pub limit: f32,
    pub quantized: Quantized,
    /// The id of the host step that fetches these experts where the layer
    /// shares its pools with others.
    pub step: i32,
}

/// The tokens, the experts, the slots the pools hold an expert in, a row of
/// one expert's weights laid flat, the rows an expert runs, the hidden width,
/// a projection's width, the SwiGLU's width, a gate and up pair, and a token's
/// picks.
pub struct Tokens {
}
pub struct Pool {
}
pub struct ExpertSlots {
}
pub struct Flat {
}
pub struct Picked {
}
pub struct Hidden {
}
struct Width {
}
struct Inner {
}
struct Pair {
}
pub struct ExpertPicks {
}

/// One of an expert's two products, each expert's tensors a row of the flat
/// ones. The scales and the bias stay in `E`, so a run widens to f32 only the
/// expert it reads.
pub struct Projection<affine G: Graph, E: Float> {
    pub packed: G::Tensor<u8, [ExpertSlots, Flat]>,
    pub scales: G::Tensor<E, [ExpertSlots, Flat]>,
    pub bias: Option<G::Tensor<E, [ExpertSlots, Flat]>>,
    pub zero_points: Option<G::Tensor<u8, [ExpertSlots, Flat]>>,
    pub shape: ProjectionShape,
}

/// One expert's weight of a projection as `quantized_product` takes it: its
/// rows, its blocks, each block's bytes, and the bytes of a row's zero points.
pub struct ProjectionShape {
    pub rows: i32,
    pub blocks: i32,
    pub blob: i32,
    pub zero_bytes: i32,
}

/// `QMoE` of `x`, whose last axis is the hidden width and whose other axes
/// hold the tokens `router` holds a row of logits for, through the experts
/// `up` and `down` hold: each expert's `up` product, its gate and up values
/// interleaved, then the SwiGLU of them, then its `down` product. Each product
/// reads its weight as `Graph::quantized_product` does, and adds its bias.
/// The experts compute in f32, and the result rounds once to `E`.
///
/// The weights are pools of slots, each holding one expert. Pools of exactly
/// one slot for each expert are the layer's own, expert `e` in slot `e`.
/// Larger pools are shared with other layers and hold what a host step puts in
/// them: it reads the picks, writes their experts into slots, and answers where
/// each expert is.
///
/// Where a token's picks are fewer than the experts, each pick runs its expert
/// on its token's row, so only the experts the tokens route to are read.
/// Otherwise each expert picked runs on every row, and a row it is not picked
/// for adds nothing, so no temporary grows with the picks.
pub fn mixture_of_experts<affine G: Graph, E: Float, In, T, X, S, N, P, Blocks, Z, H, P2, Blocks2, Z2>(
    g: &mut G,
    x: &G::Tensor<E, In>,
    router: &G::Tensor<E, [T, X]>,
    up: &G::Tensor<u8, [S, N, P]>,
    up_scales: &G::Tensor<E, [S, N, Blocks]>,
    up_bias: Option<&G::Tensor<E, [S, N]>>,
    up_zero_points: Option<&G::Tensor<u8, [S, N, Z]>>,
    down: &G::Tensor<u8, [S, H, P2]>,
    down_scales: &G::Tensor<E, [S, H, Blocks2]>,
    down_bias: Option<&G::Tensor<E, [S, H]>>,
    down_zero_points: Option<&G::Tensor<u8, [S, H, Z2]>>,
    experts: &Experts,
) -> G::Tensor<E, In> with _
    contract 0 < experts.k
{
    let extents = g.extents_of(x);
    let hidden = extents[extents.len() - 1];
    let logits = g.extents_of(router);
    let [tokens, pool] = [logits[0], logits[1]];
    assert experts.k <= pool, "a token picks among the experts";
    assert tokens * hidden == element_count(&extents), "the router holds a row for each token";
    let rows: G::Tensor<f32, [Picked, Hidden]> = g.convert(&g.reshape::<E, In, [Picked, Hidden]>(x, [tokens, hidden]));
    let ffn = [
        projection_of::<G, E, S, N, P, Blocks, Z>(g, up, up_scales, up_bias, up_zero_points),
        projection_of::<G, E, S, H, P2, Blocks2, Z2>(g, down, down_scales, down_bias, down_zero_points),
    ];
    let routing = routed::<G, E, T, X>(g, router, experts);
    let held = held_experts(g, &routing.picks, g.extents_of(up)[0], pool, experts);
    let result = g.expert_mixture::<E>(&rows, &routing, &held, &ffn, experts);
    return g.reshape(&g.convert::<f32, E, [Picked, Hidden]>(&result), extents);
}

/// `Graph::expert_mixture`'s decomposition: each pick run on its token's row
/// where the tokens pick fewer experts than there are, as a step does, and each
/// expert run on every row otherwise, as a prompt does.
pub fn decomposed_mixture<affine G: Graph, E: Float>(
    g: &mut G,
    rows: &G::Tensor<f32, [Picked, Hidden]>,
    routing: &Routing<G>,
    held: &Held<G>,
    ffn: &[Projection<G, E>, Projection<G, E>],
    experts: &Experts,
) -> G::Tensor<f32, [Picked, Hidden]> with _ {
    if runs_by_picks(g, rows, routing, experts) {
        return by_picks(g, ffn, held, rows, &routing.picks, &routing.weights, experts);
    }
    return by_experts(g, ffn, held, rows, &routing.gates, experts);
}

/// Whether the tokens of `rows` pick fewer experts than there are, as a step's
/// do, so that a mixture runs each pick rather than each expert.
pub fn runs_by_picks<affine G: Graph>(
    g: &G,
    rows: &G::Tensor<f32, [Picked, Hidden]>,
    routing: &Routing<G>,
    experts: &Experts,
) -> bool with _ {
    return g.extents_of(rows)[0] * experts.k < g.extents_of(&routing.gates)[1];
}

/// A layer's routing: each token's weight for each expert, zero where it does
/// not pick it; the experts it picks, greatest logit first and the lower index
/// first among equal ones; and each pick's weight.
pub struct Routing<affine G: Graph> {
    pub gates: G::Tensor<f32, [Picked, Pool]>,
    pub picks: G::Tensor<i64, [Tokens, ExpertPicks]>,
    pub weights: G::Tensor<f32, [Tokens, ExpertPicks]>,
}

/// Where the pools hold the experts of one layer: each expert's slot, the
/// experts the tokens pick in the order they run, and how many of them run.
pub struct Held<affine G: Graph> {
    pub slots: G::Tensor<i64, [Pool, One]>,
    pub order: G::Tensor<i64, [Pool, One]>,
    pub count: G::Tensor<i64, []>,
}

impl<affine G: Graph> Held<G> {
    /// The slot that holds the expert `expert`.
    fn slot_of(&self, g: &mut G, expert: &G::Tensor<i64, [One]>) -> G::Tensor<i64, [One]> with _ {
        return g.reshape(&rows_at::<G, i64, Pool, One, One>(g, &self.slots, expert), [1]);
    }
}

/// The experts `picks` reach and their slots: each in its own where the pools
/// are the layer's own, else what the host step `experts.step` answers once it
/// has put them in.
fn held_experts<affine G: Graph>(
    g: &mut G,
    picks: &G::Tensor<i64, [Tokens, ExpertPicks]>,
    slots: i32,
    pool: i32,
    experts: &Experts,
) -> Held<G> with _ {
    let column: List<i32> = [pool, 1];
    if slots == pool {
        let order: G::Tensor<i64, [Pool, One]> = g.iota(column, 0);
        return Held { slots: order, order, count: scalar(g, pool as i64) };
    }
    assert pool < slots, "shared pools hold one layer's experts and more";
    let fetched = g.fetched(
        experts.step,
        &[Any::I64(g.relabeled::<i64, [Tokens, ExpertPicks], Untyped>(picks))],
        &[
            [ElementKind::I64, column],
            [ElementKind::I64, column],
            [ElementKind::I64, []],
        ],
    );
    return Held {
        slots: typed::<G, i64, [Pool, One]>(g, &fetched[0]),
        order: typed::<G, i64, [Pool, One]>(g, &fetched[1]),
        count: typed::<G, i64, []>(g, &fetched[2]),
    };
}

/// Each pick's expert run on its token's row, times its weight.
fn by_picks<affine G: Graph, E: Float>(
    g: &mut G,
    ffn: &[Projection<G, E>, Projection<G, E>],
    held: &Held<G>,
    rows: &G::Tensor<f32, [Picked, Hidden]>,
    picks: &G::Tensor<i64, [Tokens, ExpertPicks]>,
    weights: &G::Tensor<f32, [Tokens, ExpertPicks]>,
    experts: &Experts,
) -> G::Tensor<f32, [Picked, Hidden]> with _ {
    let plane = g.extents_of(rows);
    let count = plane[0] * experts.k;
    let column = |t: G::Tensor<i64, [Tokens, ExpertPicks]>| -> G::Tensor<i64, [ExpertPicks, One]> {
        return g.reshape(&t, [count, 1]);
    };
    let experts_picked = column(*picks);
    let owners = column(g.iota([plane[0], experts.k], 0));
    let picked_weights: G::Tensor<f32, [ExpertPicks, One]> = g.reshape(weights, [count, 1]);
    let token_rows: G::Tensor<i64, [Picked, Hidden]> = g.iota(plane, 0);
    let zero = full::<G, f32, [Picked, Hidden]>(g, 0.0, plane);
    return summed(g, &scalar(g, count as i64), &zero, |run| {
        let of = |t: &G::Tensor<i64, [ExpertPicks, One]>| -> G::Tensor<i64, [One]> {
            return g.reshape(&rows_at::<G, i64, ExpertPicks, One, One>(g, t, run), [1]);
        };
        let [expert, token] = [
            of(&experts_picked),
            of(&owners),
        ];
        let row: G::Tensor<f32, [Picked, Hidden]> = g.relabeled(
            &rows_at::<G, f32, Picked, Hidden, One>(g, rows, &token),
        );
        let out: G::Tensor<f32, [Picked, Hidden]> = g.broadcast_in_dim(
            &expert_output(g, ffn, &held.slot_of(g, &expert), &row, experts),
            plane,
            [0, 1],
        );
        let weight: G::Tensor<f32, [Picked, Hidden]> = g.broadcast_in_dim(
            &rows_at::<G, f32, ExpertPicks, One, One>(g, &picked_weights, run),
            plane,
            [0, 1],
        );
        let mine = g.compare(Comparison::Eq, &token_rows, &g.broadcast_in_dim::<i64, [One], [Picked, Hidden]>(
            &token,
            plane,
            [0],
        ));
        return weighed(g, &out, &g.select(&mine, &weight, &zero), &zero);
    });
}

/// Each expert `held` runs, run on every row, times each row's weight for it.
fn by_experts<affine G: Graph, E: Float>(
    g: &mut G,
    ffn: &[Projection<G, E>, Projection<G, E>],
    held: &Held<G>,
    rows: &G::Tensor<f32, [Picked, Hidden]>,
    gates: &G::Tensor<f32, [Picked, Pool]>,
    experts: &Experts,
) -> G::Tensor<f32, [Picked, Hidden]> with _ {
    let plane = g.extents_of(rows);
    let columns: G::Tensor<f32, [Pool, Picked]> = g.transpose(gates, [1, 0]);
    let zero = full::<G, f32, [Picked, Hidden]>(g, 0.0, plane);
    return summed(g, &held.count, &zero, |run| {
        let expert: G::Tensor<i64, [One]> = g.reshape(&rows_at::<G, i64, Pool, One, One>(g, &held.order, run), [1]);
        let out = expert_output(g, ffn, &held.slot_of(g, &expert), rows, experts);
        let column = rows_at::<G, f32, Pool, Picked, One>(g, &columns, &expert);
        let weight: G::Tensor<f32, [Picked, Hidden]> = g.broadcast_in_dim(
            &g.reshape::<f32, [One, Picked], [Picked]>(&column, [plane[0]]),
            plane,
            [0],
        );
        return weighed(g, &out, &weight, &zero);
    });
}

/// `out` times `weight`, and zero where the weight is not positive: a row an
/// expert ran on without being picked, or picked by a weight that rounded to
/// zero, may hold anything, an infinity among it.
fn weighed<affine G: Graph>(
    g: &mut G,
    out: &G::Tensor<f32, [Picked, Hidden]>,
    weight: &G::Tensor<f32, [Picked, Hidden]>,
    zero: &G::Tensor<f32, [Picked, Hidden]>,
) -> G::Tensor<f32, [Picked, Hidden]> with _ {
    return g.select(&g.compare(Comparison::Gt, weight, zero), &g.binary(Binary::Multiply, out, weight), zero);
}

/// The sum over `runs` runs of what `added` gives for each, from `zero`.
fn summed<affine G: Graph>(
    g: &mut G,
    runs: &G::Tensor<i64, []>,
    zero: &G::Tensor<f32, [Picked, Hidden]>,
    added: fn(&G::Tensor<i64, [One]>) -> G::Tensor<f32, [Picked, Hidden]> with _,
) -> G::Tensor<f32, [Picked, Hidden]> with _ {
    let last = g.repeated(
        runs,
        &([Any::F32(g.relabeled::<f32, [Picked, Hidden], Untyped>(zero))] as List<Any<G>>),
        |at, state| {
            let total = typed::<G, f32, [Picked, Hidden]>(g, &state[0]);
            let run: G::Tensor<i64, [One]> = g.reshape(at, [1]);
            return [
                Any::F32(g.relabeled::<f32, [Picked, Hidden], Untyped>(&g.binary(Binary::Add, &total, &added(&run)))),
            ];
        },
    );
    return typed::<G, f32, [Picked, Hidden]>(g, &last[0]);
}

/// The routing `router`'s logits give.
fn routed<affine G: Graph, E: Float, T, X>(
    g: &mut G,
    router: &G::Tensor<E, [T, X]>,
    experts: &Experts,
) -> Routing<G> with _ {
    let logits: G::Tensor<f32, [Picked, Pool]> = g.convert(&g.relabeled::<E, [T, X], [Picked, Pool]>(router));
    let extents = g.extents_of(&logits);
    let positions: G::Tensor<i64, [Picked, Pool]> = g.iota(extents, 1);
    let none = full::<G, f32, [Picked, Pool]>(g, 0.0, extents);
    let mut left = logits;
    let mut chosen = full::<G, bool, [Picked, Pool]>(g, false, extents);
    let mut hits: List<G::Tensor<bool, [Picked, Pool]>> = [];
    let mut picks: Option<G::Tensor<i64, [Tokens, ExpertPicks]>> = null;
    let blocked = full::<G, f32, [Picked, Pool]>(g, f32::NEG_INFINITY, extents);
    let unblocked = full::<G, f32, [Picked, Pool]>(g, 1.0, extents);
    let all_chosen = full::<G, bool, [Picked, Pool]>(g, true, extents);
    let row_blocked = full::<G, f32, [Picked, Pool]>(g, f32::NEG_INFINITY, [extents[0], 1]);
    for let _ of 0..<experts.k {
        // Where every expert left has a logit of -inf, the first of them, so
        // that no expert is picked twice.
        let best: G::Tensor<i64, [Picked, Pool]> = g.arg_max(&left, 1);
        let first_left: G::Tensor<i64, [Picked, Pool]> = g.arg_max(&g.select(&chosen, &none, &unblocked), 1);
        let top: G::Tensor<f32, [Picked]> = g.reduce(&left, Binary::Maximum, f32::NEG_INFINITY, [1]);
        let none_finite = g.compare(
            Comparison::Eq,
            &g.reshape::<f32, [Picked], [Picked, Pool]>(&top, [extents[0], 1]),
            &row_blocked,
        );
        let at = g.select(&none_finite, &first_left, &best);
        let hit = g.compare(Comparison::Eq, &positions, &g.broadcast_in_dim(&at, extents, [0, 1]));
        chosen = g.select(&hit, &all_chosen, &chosen);
        left = g.select(&hit, &blocked, &left);
        let column = g.relabeled::<i64, [Picked, Pool], [Tokens, ExpertPicks]>(&at);
        picks = Option::Some(match &picks {
            Some(p) => g.concatenate(p, &column, 1),
            null => column,
        });
        hits.push(hit);
    }
    let mut gates = g.select(&chosen, &softmax::<G, f32, [Picked, Pool]>(g, &logits, 1), &none);
    if experts.normalized {
        let total: G::Tensor<f32, [Picked]> = g.reduce(&gates, Binary::Add, 0.0, [1]);
        gates = g.binary(Binary::Divide, &gates, &g.broadcast_in_dim(&total, extents, [0]));
    }
    let mut weights: Option<G::Tensor<f32, [Tokens, ExpertPicks]>> = null;
    for let hit of hits {
        let weight: G::Tensor<f32, [Tokens, ExpertPicks]> = g.reshape(
            &g.reduce::<f32, [Picked, Pool], [Picked]>(&g.select(&hit, &gates, &none), Binary::Add, 0.0, [1]),
            [extents[0], 1],
        );
        weights = Option::Some(match &weights {
            Some(w) => g.concatenate(w, &weight, 1),
            null => weight,
        });
    }
    return Routing {
        gates,
        picks: picks.unwrap(),
        weights: weights.unwrap(),
    };
}

/// The product `packed`, `scales`, `bias` and `zero_points` hold one expert's
/// weight of, each expert's tensors laid flat as a row.
fn projection_of<affine G: Graph, E: Float, S, N, P, Blocks, Z>(
    g: &mut G,
    packed: &G::Tensor<u8, [S, N, P]>,
    scales: &G::Tensor<E, [S, N, Blocks]>,
    bias: Option<&G::Tensor<E, [S, N]>>,
    zero_points: Option<&G::Tensor<u8, [S, N, Z]>>,
) -> Projection<G, E> with _ {
    let weight = g.extents_of(packed);
    let [slots, rows, bytes] = [weight[0], weight[1], weight[2]];
    let blocks = g.extents_of(scales)[2];
    assert bytes % blocks == 0, "a row's bytes are whole blocks";
    let flat = |extents: List<i32>| [slots, element_count(&extents) / slots] as List<i32>;
    return Projection {
        packed: g.reshape(packed, [slots, rows * bytes]),
        scales: g.reshape(scales, flat(g.extents_of(scales))),
        bias: match bias {
            Some(b) => Option::Some(g.reshape(b, flat(g.extents_of(b)))),
            null => null,
        },
        zero_points: match zero_points {
            Some(z) => Option::Some(g.reshape(z, flat(g.extents_of(z)))),
            null => null,
        },
        shape: ProjectionShape {
            rows,
            blocks,
            blob: bytes / blocks,
            zero_bytes: match zero_points {
                Some(z) => g.extents_of(z)[2],
                null => 0,
            },
        },
    };
}

/// `rows` through the expert in the slot `at`: its first projection, the
/// SwiGLU, then its second.
fn expert_output<affine G: Graph, E: Float>(
    g: &mut G,
    ffn: &[Projection<G, E>, Projection<G, E>],
    at: &G::Tensor<i64, [One]>,
    rows: &G::Tensor<f32, [Picked, Hidden]>,
    experts: &Experts,
) -> G::Tensor<f32, [Picked, Hidden]> with _ {
    let gated = swiglu(g, &projected::<G, E, Hidden>(g, &ffn.0, at, rows, &experts.quantized), experts);
    return g.relabeled(&projected::<G, E, Inner>(g, &ffn.1, at, &gated, &experts.quantized));
}

/// `rows` times the transpose of the weight of `p` in the slot `at`, plus its
/// bias.
fn projected<affine G: Graph, E: Float, C>(
    g: &mut G,
    p: &Projection<G, E>,
    at: &G::Tensor<i64, [One]>,
    rows: &G::Tensor<f32, [Picked, C]>,
    quantized: &Quantized,
) -> G::Tensor<f32, [Picked, Width]> with _ {
    let shape = &p.shape;
    let packed: G::Tensor<u8, [Width, Flat, Pair]> = g.reshape(
        &rows_at::<G, u8, ExpertSlots, Flat, One>(g, &p.packed, at),
        [shape.rows, shape.blocks, shape.blob],
    );
    let scales: G::Tensor<f32, [Width, Flat]> = g.reshape(
        &g.convert::<E, f32, [One, Flat]>(&rows_at::<G, E, ExpertSlots, Flat, One>(g, &p.scales, at)),
        [shape.rows, shape.blocks],
    );
    let zero_points: Option<G::Tensor<u8, [Width, Pair]>> = match &p.zero_points {
        Some(z) => Option::Some(g.reshape(&rows_at::<G, u8, ExpertSlots, Flat, One>(g, z, at), [
            shape.rows, shape.zero_bytes,
        ])),
        null => null,
    };
    let product = g.quantized_product::<f32, [Picked, C], Width, Flat, Pair, Pair, [Picked, Width]>(
        rows,
        &packed,
        &scales,
        optional(&zero_points),
        quantized,
    );
    let Some(b) = &p.bias else {
        return product;
    };
    let extents = g.extents_of(&product);
    let bias = g.convert::<E, f32, [One, Flat]>(&rows_at::<G, E, ExpertSlots, Flat, One>(g, b, at));
    return g.binary(Binary::Add, &product, &g.broadcast_in_dim(&bias, extents, [0, 1]));
}

/// onnxruntime's SwiGLU of each row's interleaved gate and up values:
/// `min(gate, limit) · σ(alpha · min(gate, limit)) · (clamp(up, ±limit) + beta)`.
fn swiglu<affine G: Graph>(
    g: &mut G,
    h: &G::Tensor<f32, [Picked, Width]>,
    experts: &Experts,
) -> G::Tensor<f32, [Picked, Inner]> with _ {
    let extents = g.extents_of(h);
    let [rows, inner] = [extents[0], extents[1] / 2];
    let pairs: G::Tensor<f32, [Picked, Inner, Pair]> = g.reshape(h, [rows, inner, 2]);
    let half = |offset: i32| -> G::Tensor<f32, [Picked, Inner]> {
        return g.reshape(
            &g.slice::<f32, [Picked, Inner, Pair], [Picked, Inner, One]>(&pairs, [0, 0, offset], [
                rows, inner, offset + 1,
            ], [1, 1, 1]),
            [rows, inner],
        );
    };
    let plane: List<i32> = [rows, inner];
    let constant = |value: f32| full::<G, f32, [Picked, Inner]>(g, value, plane);
    let gate = g.binary(Binary::Minimum, &half(0), &constant(experts.limit));
    let up = g.binary(
        Binary::Maximum,
        &g.binary(Binary::Minimum, &half(1), &constant(experts.limit)),
        &constant(-experts.limit),
    );
    let sigmoid = g.unary(Unary::Logistic, &g.binary(Binary::Multiply, &gate, &constant(experts.alpha)));
    return g.binary(
        Binary::Multiply,
        &g.binary(Binary::Multiply, &gate, &sigmoid),
        &g.binary(Binary::Add, &up, &constant(experts.beta)),
    );
}
