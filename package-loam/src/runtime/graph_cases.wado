/// Attention over a past of `past.2` positions in each row of a shared buffer,
/// turned by `rotation`, biased over the buffer's positions by `bias`, each
/// query head's softmax joined by its of `sinks`.
pub fn attending<affine G: Graph, E: Float = f32>(
    g: &mut G,
    inputs: &[G::Tensor<E, [Bt, St, Qt]>, G::Tensor<E, [Bt, St, Kt]>, G::Tensor<E, [Bt, St, Kt]>],
    past: &[G::Tensor<E, [Bt, Ht, Pt, Dt]>, G::Tensor<E, [Bt, Ht, Pt, Dt]>, G::Tensor<i64, [Slots]>],
    rotation: &[G::Tensor<E, [Pos, Half]>, G::Tensor<E, [Pos, Half]>],
    bias: &G::Tensor<E, [Bt, Ht, St, Tt]>,
    sinks: &G::Tensor<E, [Qt]>,
    options: &Attention,
) -> [G::Tensor<E, [Bt, St, Qt]>, G::Tensor<E, [Bt, Ht, Tt, Dt]>, G::Tensor<E, [Bt, Ht, Tt, Dt]>] with _ {
    return g.group_query_attention::<E, Bt, St, Qt, Kt, Ht, Pt, Tt, Dt, Pos, Half, Bt, Ht, St, Qt>(
        &inputs.0,
        &inputs.1,
        &inputs.2,
        &past.0,
        &past.1,
        Option::Some(&past.2),
        null,
        Option::Some(&rotation.0),
        Option::Some(&rotation.1),
        Option::Some(bias),
        Option::Some(sinks),
        options,
    );
}

pub fn mixed_inputs() -> [Tensor<f32, [A, B]>, Tensor<i64, [C]>] {
    return [
        Tensor {
            data: [0.5, -1.0, 2.0, 3.0, -0.25, 1.5],
            extents: [2, 3],
        },
        Tensor {
            data: [1, 5],
            extents: [2],
        },
    ];
}

pub fn elementwise_inputs() -> [Tensor<f32, [A]>, Tensor<f32, [A]>] {
    return [
        Tensor {
            data: [0.25, 1.5, 3.0, 2.0],
            extents: [4],
        },
        Tensor {
            data: [1.5, -2.0, 3.0, -0.5],
            extents: [4],
        },
    ];
}

pub fn windowed_input() -> Tensor<f32, [A, B, C]> {
    return Tensor {
        data: [1.0, 4.0, -2.0, 3.0],
        extents: [1, 1, 4],
    };
}

pub fn branching_inputs(p: bool) -> [Tensor<bool, [C]>, Tensor<f32, [A]>] {
    return [
        Tensor {
            data: [p],
            extents: [1],
        },
        Tensor {
            data: [1.0, -3.0],
            extents: [2],
        },
    ];
}

/// `attending`'s arguments: pasts in a buffer of four, and a bias shared by the
/// rows and the heads, as a decoder makes one of its attention mask.
pub struct AttentionCase {
    pub inputs: [Tensor<f32, [Bt, St, Qt]>, Tensor<f32, [Bt, St, Kt]>, Tensor<f32, [Bt, St, Kt]>],
    pub past: [Tensor<f32, [Bt, Ht, Pt, Dt]>, Tensor<f32, [Bt, Ht, Pt, Dt]>, Tensor<i64, [Slots]>],
    pub rotation: [Tensor<f32, [Pos, Half]>, Tensor<f32, [Pos, Half]>],
    pub bias: Tensor<f32, [Bt, Ht, St, Tt]>,
    pub sinks: Tensor<f32, [Qt]>,
    pub options: Attention,
}

/// A past of one position.
pub fn attention_case() -> AttentionCase {
    return attention_rows([1]);
}

/// `attention_case` over a row for each of `pasts`, each holding that many
/// positions of its buffer.
pub fn attention_rows(pasts: List<i64>) -> AttentionCase {
    let [s, heads, kv, capacity, d, positions] = [2, 4, 2, 4, 4, 8];
    let batch = pasts.len();
    return AttentionCase {
        inputs: [
            noisy([batch, s, heads * d], 1),
            noisy([batch, s, kv * d], 2),
            noisy([batch, s, kv * d], 3),
        ],
        past: [
            noisy([batch, kv, capacity, d], 4),
            noisy([batch, kv, capacity, d], 5),
            Tensor {
                data: pasts,
                extents: [batch],
            },
        ],
        rotation: [
            noisy([positions, d / 2], 6),
            noisy([positions, d / 2], 7),
        ],
        // Over a past of one position: that position, the two new ones, then
        // padding, which a causal attention never reads, so a large bias there
        // shows a read of it.
        bias: Tensor {
            data: [0.25, -0.5, 0.0, 7.0, -0.75, 0.5, 0.3, 7.0],
            extents: [1, 1, s, capacity],
        },
        sinks: noisy([heads], 8),
        options: Attention { heads, kv_heads: kv, scale: 0.5, softcap: 0.0, window: -1, causal: true },
    };
}

/// `quantizing`'s arguments: a product over a weight of 40 columns in blocks of
/// 32, so its last block is cut short, and a table of 5 rows.
pub struct QuantizedCase {
    pub a: Tensor<f32, [A, B]>,
    pub weight: Tensor<u8, [C, Blocks, Blob]>,
    pub scales: Tensor<f32, [C, Blocks]>,
    pub zero_points: Tensor<u8, [C, Zeros]>,
    pub table: Tensor<u8, [Rows, Blob]>,
    pub table_scales: Tensor<f32, [Rows, Blocks]>,
    pub ids: Tensor<i64, [A]>,
}

pub struct Blocks {
}
pub struct Blob {
}
pub struct Zeros {
}
pub struct Rows {
}

/// A product by a weight with zero points, and the rows of a table without
/// them that `ids` name, one past its end.
pub fn quantizing<affine G: Graph, E: Float = f32>(
    g: &mut G,
    a: &G::Tensor<E, [A, B]>,
    weight: &[G::Tensor<u8, [C, Blocks, Blob]>, G::Tensor<E, [C, Blocks]>, G::Tensor<u8, [C, Zeros]>],
    table: &[G::Tensor<u8, [Rows, Blob]>, G::Tensor<E, [Rows, Blocks]>],
    ids: &G::Tensor<i64, [A]>,
) -> [G::Tensor<E, [A, C]>, G::Tensor<E, [A, B]>] with _ {
    let quantized = Quantized { bits: 4, block: 32 };
    let product = g.quantized_product::<E, [A, B], C, Blocks, Blob, Zeros, [A, C]>(
        a,
        &weight.0,
        &weight.1,
        Option::Some(&weight.2),
        &quantized,
    );
    let rows = g.quantized_gather::<E, Rows, Blob, [A], Blocks, Zeros, [A, B]>(
        &table.0,
        ids,
        &table.1,
        null,
        &quantized,
    );
    return [product, rows];
}

pub fn quantized_case() -> QuantizedCase {
    let [n, k, blocks, rows] = [3, 40, 2, 5];
    return QuantizedCase {
        a: noisy([2, k], 8),
        weight: bytes([n, blocks, 16], 1),
        scales: noisy([n, blocks], 9),
        zero_points: bytes([n, 1], 2),
        table: bytes([rows, k / 2], 3),
        table_scales: noisy([rows, blocks], 10),
        ids: Tensor {
            data: [5, -2],
            extents: [2],
        },
    };
}

/// `mixing`'s arguments: tokens of 32 values over 4 experts, a SwiGLU of 32
/// between two products in 4 bits and blocks of 32.
pub struct ExpertsCase {
    pub x: Tensor<f32, [A, B]>,
    pub router: Tensor<f32, [A, C]>,
    pub up: [Tensor<u8, [C, Rows, Blob]>, Tensor<f32, [C, Rows, Blocks]>, Tensor<f32, [C, Rows]>],
    pub down: [Tensor<u8, [C, B, Blob]>, Tensor<f32, [C, B, Blocks]>, Tensor<f32, [C, B]>],
}

/// `tokens` tokens, each picking 2 of the experts: 3 tokens run every expert
/// on every row, and 1 runs its picks alone.
pub fn experts_case(tokens: i32) -> ExpertsCase {
    let [experts, hidden, inner] = [4, 32, 32];
    return ExpertsCase {
        x: noisy([tokens, hidden], 11),
        router: noisy([tokens, experts], 12),
        up: [
            bytes([experts, 2 * inner, hidden / 2], 4),
            noisy([experts, 2 * inner, 1], 13),
            noisy([experts, 2 * inner], 14),
        ],
        down: [
            bytes([experts, hidden, inner / 2], 5),
            noisy([experts, hidden, 1], 15),
            noisy([experts, hidden], 16),
        ],
    };
}

/// `x` through the experts `router` picks, as a `QMoE` of `ExpertsCase`'s
/// shape computes it.
pub fn mixing<affine G: Graph, E: Float = f32>(
    g: &mut G,
    x: &G::Tensor<E, [A, B]>,
    router: &G::Tensor<E, [A, C]>,
    up: &[G::Tensor<u8, [C, Rows, Blob]>, G::Tensor<E, [C, Rows, Blocks]>, G::Tensor<E, [C, Rows]>],
    down: &[G::Tensor<u8, [C, B, Blob]>, G::Tensor<E, [C, B, Blocks]>, G::Tensor<E, [C, B]>],
) -> G::Tensor<E, [A, B]> with _ {
    return mixture_of_experts::<G, E, [A, B], A, C, Rows, Blob, Blocks, Blocks, B, Blob, Blocks, Blocks>(
        g,
        x,
        router,
        &up.0,
        &up.1,
        Option::Some(&up.2),
        null,
        &down.0,
        &down.1,
        Option::Some(&down.2),
        null,
        &Experts {
            k: 2,
            normalized: true,
            alpha: 1.702,
            beta: 1.0,
            limit: 7.0,
            quantized: Quantized { bits: 4, block: 32 },
        },
    );
}

/// `mixing` of `experts_case(tokens)` recorded, its input and router then its
/// weights as parameters.
pub fn mixing_pass(r: &mut Recorder, tokens: i32) -> Recorded {
    let c = experts_case(tokens);
    let x = r.parameter::<f32, [A, B]>(c.x.extents);
    let router = r.parameter::<f32, [A, C]>(c.router.extents);
    let up = [
        r.parameter::<u8, [C, Rows, Blob]>(c.up.0.extents),
        r.parameter::<f32, [C, Rows, Blocks]>(c.up.1.extents),
        r.parameter::<f32, [C, Rows]>(c.up.2.extents),
    ];
    let down = [
        r.parameter::<u8, [C, B, Blob]>(c.down.0.extents),
        r.parameter::<f32, [C, B, Blocks]>(c.down.1.extents),
        r.parameter::<f32, [C, B]>(c.down.2.extents),
    ];
    return r.finished([mixing(r, &x, &router, &up, &down).id]);
}

/// `experts_case(tokens)`'s tensors in `mixing_pass`'s order, held by `g`.
pub fn mixing_arguments<affine G: Graph>(g: &mut G, tokens: i32) -> List<Any<G>> with _ {
    let c = experts_case(tokens);
    return [
        Any::F32(g.relabeled::<f32, [A, B], Untyped>(&g.upload(&c.x))),
        Any::F32(g.relabeled::<f32, [A, C], Untyped>(&g.upload(&c.router))),
        Any::U8(g.relabeled::<u8, [C, Rows, Blob], Untyped>(&g.upload(&c.up.0))),
        Any::F32(g.relabeled::<f32, [C, Rows, Blocks], Untyped>(&g.upload(&c.up.1))),
        Any::F32(g.relabeled::<f32, [C, Rows], Untyped>(&g.upload(&c.up.2))),
        Any::U8(g.relabeled::<u8, [C, B, Blob], Untyped>(&g.upload(&c.down.0))),
        Any::F32(g.relabeled::<f32, [C, B, Blocks], Untyped>(&g.upload(&c.down.1))),
        Any::F32(g.relabeled::<f32, [C, B], Untyped>(&g.upload(&c.down.2))),
    ];
}

/// `quantizing` over its input and indices, then its weights, as
/// `quantized_weight` numbers them.
pub fn quantized_pass(r: &mut Recorder) -> Recorded {
    let q = quantized_case();
    let a = r.parameter::<f32, [A, B]>(q.a.extents);
    let ids = r.parameter::<i64, [A]>(q.ids.extents);
    let weight = [
        r.parameter::<u8, [C, Blocks, Blob]>(q.weight.extents),
        r.parameter::<f32, [C, Blocks]>(q.scales.extents),
        r.parameter::<u8, [C, Zeros]>(q.zero_points.extents),
    ];
    let table = [
        r.parameter::<u8, [Rows, Blob]>(q.table.extents),
        r.parameter::<f32, [Rows, Blocks]>(q.table_scales.extents),
    ];
    let got = quantizing(r, &a, &weight, &table, &ids);
    return r.finished([got.0.id, got.1.id]);
}

/// `quantizing`'s product gated by itself, plus each row's sum of `a`: what a
/// device computes in the product's epilogue, reading one value per row.
pub fn quantized_then<affine G: Graph>(
    g: &mut G,
    a: &G::Tensor<f32, [A, B]>,
    weight: &[G::Tensor<u8, [C, Blocks, Blob]>, G::Tensor<f32, [C, Blocks]>, G::Tensor<u8, [C, Zeros]>],
) -> G::Tensor<f32, [A, C]> with _ {
    let product = g.quantized_product::<f32, [A, B], C, Blocks, Blob, Zeros, [A, C]>(
        a,
        &weight.0,
        &weight.1,
        Option::Some(&weight.2),
        &Quantized { bits: 4, block: 32 },
    );
    let sums = g.reduce::<f32, [A, B], [A]>(a, Binary::Add, 0.0, [1]);
    let q = quantized_case();
    let spread = g.broadcast_in_dim::<f32, [A], [A, C]>(&sums, [q.a.extents[0], q.weight.extents[0]], [0]);
    let gated = g.binary(Binary::Multiply, &product, &g.unary(Unary::Logistic, &product));
    return g.binary(Binary::Add, &gated, &spread);
}

/// `quantized_then` recorded, its input then `quantized_case`'s weight with
/// zero points as parameters.
pub fn quantized_then_pass(r: &mut Recorder) -> Recorded {
    let q = quantized_case();
    let a = r.parameter::<f32, [A, B]>(q.a.extents);
    let weight = [
        r.parameter::<u8, [C, Blocks, Blob]>(q.weight.extents),
        r.parameter::<f32, [C, Blocks]>(q.scales.extents),
        r.parameter::<u8, [C, Zeros]>(q.zero_points.extents),
    ];
    return r.finished([quantized_then(r, &a, &weight).id]);
}

/// What a decoder layer asks of products by `a` and four weights with zero
/// points: two that end its outputs, and the SiLU of one gating another.
pub fn quantized_layer<affine G: Graph>(
    g: &mut G,
    a: &G::Tensor<f32, [A, B]>,
    weights: &List<[G::Tensor<u8, [C, Blocks, Blob]>, G::Tensor<f32, [C, Blocks]>, G::Tensor<u8, [C, Zeros]>]>,
) -> [G::Tensor<f32, [A, C]>, G::Tensor<f32, [A, C]>, G::Tensor<f32, [A, C]>] with _ {
    assert weights.len() == 4;
    let quantized = Quantized { bits: 4, block: 32 };
    let mut products: List<G::Tensor<f32, [A, C]>> = [];
    for let w of weights {
        products.push(g.quantized_product::<f32, [A, B], C, Blocks, Blob, Zeros, [A, C]>(
            a,
            &w.0,
            &w.1,
            Option::Some(&w.2),
            &quantized,
        ));
    }
    let gate = g.binary(Binary::Multiply, &products[2], &g.unary(Unary::Logistic, &products[2]));
    return [products[0], products[1], g.binary(Binary::Multiply, &gate, &products[3])];
}

/// `quantized_layer` recorded, its input then each weight's three parts.
pub fn quantized_layer_pass(r: &mut Recorder) -> Recorded {
    let q = quantized_case();
    let a = r.parameter::<f32, [A, B]>(q.a.extents);
    let mut weights: List<[Value<u8, [C, Blocks, Blob]>, Value<f32, [C, Blocks]>, Value<u8, [C, Zeros]>]> = [];
    for let _ of 0..<4 {
        weights.push([
            r.parameter::<u8, [C, Blocks, Blob]>(q.weight.extents),
            r.parameter::<f32, [C, Blocks]>(q.scales.extents),
            r.parameter::<u8, [C, Zeros]>(q.zero_points.extents),
        ]);
    }
    let got = quantized_layer(r, &a, &weights);
    return r.finished([got.0.id, got.1.id, got.2.id]);
}

/// The weights of `quantized_layer`, each apart from the others.
pub fn quantized_layer_weights() -> List<[Tensor<u8, [C, Blocks, Blob]>, Tensor<f32, [C, Blocks]>, Tensor<u8, [C, Zeros]>]> {
    let q = quantized_case();
    return (0..<4).map(|i| [
        bytes::<[C, Blocks, Blob]>(q.weight.extents, 20 + i),
        noisy::<[C, Blocks]>(q.scales.extents, (30 + i) as u32),
        bytes::<[C, Zeros]>(q.zero_points.extents, 40 + i),
    ]).collect();
}

/// The weight `at` of `quantized_layer_pass`, as a model's loader hands it over.
pub fn quantized_layer_weight(at: i32) -> Result<HostWeight, ()> {
    let w = quantized_layer_weights()[at / 3];
    return Result::Ok(match at % 3 {
        0 => HostWeight::of(&w.0),
        1 => HostWeight::of(&w.1),
        _ => HostWeight::of(&w.2),
    });
}

/// The weight `at` of `quantized_pass`, as a model's loader hands it over.
pub fn quantized_weight(at: i32) -> Result<HostWeight, ()> {
    let q = quantized_case();
    return Result::Ok(match at {
        0 => HostWeight::of(&q.weight),
        1 => HostWeight::of(&q.scales),
        2 => HostWeight::of(&q.zero_points),
        3 => HostWeight::of(&q.table),
        _ => HostWeight::of(&q.table_scales),
    });
}

/// Bytes spread over their range, apart for each `seed`.
fn bytes<Axes>(extents: List<i32>, seed: i32) -> Tensor<u8, Axes> {
    let data: List<u8> = (0..<element_count(&extents)).map(|i| ((i * 37 + seed * 101) % 256) as u8).collect();
    return Tensor { data, extents };
}

fn noisy<Axes>(extents: List<i32>, seed: u32) -> Tensor<f32, Axes> {
    return Tensor { data: noise(element_count(&extents), seed, 1.0), extents };
}

/// A loop of `count` runs, one value doubling by what it reads from outside the
/// loop, the other adding up the runs' numbers, over `x` and `ids` of one shape.
pub fn repeating<affine G: Graph>(
    g: &mut G,
    count: &G::Tensor<i64, []>,
    x: &G::Tensor<f32, [A]>,
    ids: &G::Tensor<i64, [A]>,
) -> [G::Tensor<f32, [A]>, G::Tensor<i64, [A]>] with _ {
    let scale = g.binary(Binary::Add, x, x);
    let start: List<Any<G>> = [
        Any::F32(g.relabeled::<f32, [A], Untyped>(x)),
        Any::I64(g.relabeled::<i64, [A], Untyped>(ids)),
    ];
    let last = g.repeated(count, &start, |step, state| {
        let held = typed::<G, f32, [A]>(g, &state[0]);
        let tally = typed::<G, i64, [A]>(g, &state[1]);
        let doubled = g.binary(Binary::Multiply, &held, &scale);
        let added = g.binary(Binary::Add, &tally, &g.broadcast_in_dim(step, g.extents_of(&held), []));
        return [
            Any::F32(g.relabeled::<f32, [A], Untyped>(&doubled)),
            Any::I64(g.relabeled::<i64, [A], Untyped>(&added)),
        ];
    });
    return [
        typed::<G, f32, [A]>(g, &last[0]),
        typed::<G, i64, [A]>(g, &last[1]),
    ];
}

/// A loop of `count` runs, each carrying its value doubled and transposed, so
/// what it carries is a view.
pub fn repeating_view<affine G: Graph>(
    g: &mut G,
    count: &G::Tensor<i64, []>,
    x: &G::Tensor<f32, [A, A]>,
) -> G::Tensor<f32, [A, A]> with _ {
    let start: List<Any<G>> = [Any::F32(g.relabeled::<f32, [A, A], Untyped>(x))];
    let last = g.repeated(count, &start, |_, state| {
        let held = typed::<G, f32, [A, A]>(g, &state[0]);
        let doubled = g.binary(Binary::Add, &held, &held);
        let turned = g.transpose::<f32, [A, A], [A, A]>(&doubled, [1, 0]);
        return [Any::F32(g.relabeled::<f32, [A, A], Untyped>(&turned))];
    });
    return typed::<G, f32, [A, A]>(g, &last[0]);
}

/// A loop of `count` runs of a shared cache's attention, each attending what the
/// run before did, from a past of one position: the last run's queries.
pub fn repeating_attention<affine G: Graph>(
    g: &mut G,
    count: &G::Tensor<i64, []>,
    q: &G::Tensor<f32, [Bt, St, Qt]>,
    k: &G::Tensor<f32, [Bt, St, Kt]>,
    v: &G::Tensor<f32, [Bt, St, Kt]>,
    past: &G::Tensor<f32, [Bt, Ht, Pt, Dt]>,
) -> G::Tensor<f32, [Bt, St, Qt]> with _ {
    let start: List<Any<G>> = [
        Any::F32(g.relabeled::<f32, [Bt, St, Qt], Untyped>(q)),
        Any::F32(g.relabeled::<f32, [Bt, Ht, Pt, Dt], Untyped>(past)),
        Any::F32(g.relabeled::<f32, [Bt, Ht, Pt, Dt], Untyped>(past)),
    ];
    let first = scalar(g, 1 as i64);
    let last = g.repeated(
        count,
        &start,
        |step, state| {
            let attended = typed::<G, f32, [Bt, St, Qt]>(g, &state[0]);
            let keys = typed::<G, f32, [Bt, Ht, Pt, Dt]>(g, &state[1]);
            let values = typed::<G, f32, [Bt, Ht, Pt, Dt]>(g, &state[2]);
            let length = g.binary(Binary::Add, &first, step);
            let [out, present_k, present_v] = g.group_query_attention::<f32, Bt, St, Qt, Kt, Ht, Pt, Pt, Dt, Pos, Half, Bt, Ht, St, Qt>(
                &attended,
                k,
                v,
                &keys,
                &values,
                Option::Some(&shared(g, &length)),
                null,
                null,
                null,
                null,
                null,
                &LOOPED_ATTENTION,
            );
            return [
                Any::F32(g.relabeled::<f32, [Bt, St, Qt], Untyped>(&out)),
                Any::F32(g.relabeled::<f32, [Bt, Ht, Pt, Dt], Untyped>(&present_k)),
                Any::F32(g.relabeled::<f32, [Bt, Ht, Pt, Dt], Untyped>(&present_v)),
            ];
        },
    );
    return typed::<G, f32, [Bt, St, Qt]>(g, &last[0]);
}

/// Six heads over one of 6 elements, which on a device makes the parts of a step
/// over one position as many words as the cache it attends.
global LOOPED_ATTENTION: Attention = Attention {
    heads: 6,
    kv_heads: 1,
    scale: 0.5,
    softcap: 0.0,
    window: -1,
    causal: true,
};

/// `repeating_attention`'s arguments, for `count` runs.
pub fn repeating_attention_inputs(
    count: i64,
) -> [Tensor<i64, []>, Tensor<f32, [Bt, St, Qt]>, Tensor<f32, [Bt, St, Kt]>, Tensor<f32, [Bt, St, Kt]>, Tensor<f32, [Bt, Ht, Pt, Dt]>] {
    return [
        Tensor {
            data: [count],
            extents: [],
        },
        noisy([1, 1, 36], 8),
        noisy([1, 1, 6], 9),
        noisy([1, 1, 6], 10),
        noisy([1, 1, 4, 6], 11),
    ];
}

/// `repeating`'s arguments, for `count` runs.
pub fn repeating_inputs(count: i64) -> [Tensor<i64, []>, Tensor<f32, [A]>, Tensor<i64, [A]>] {
    return [
        Tensor {
            data: [count],
            extents: [],
        },
        Tensor {
            data: [1.0, -3.0],
            extents: [2],
        },
        Tensor {
            data: [5, 7],
            extents: [2],
        },
    ];
}
