use {
    A,
    AttentionCase,
    B,
    Bt,
    C,
    Dt,
    Half,
    Ht,
    Kt,
    Pos,
    Pt,
    Qt,
    St,
    Tt,
    attending,
    attention_case,
    attention_rows,
    branching,
    branching_inputs,
    elementwise,
    elementwise_inputs,
    mixed,
    mixed_inputs,
    repeating,
    repeating_inputs,
    windowed,
    windowed_input,
} from "./graph_cases.wado";
use { Any, Recorder, Untyped, host_of, run } from "./recorded.wado";
use { Graph, Slots } from "./hlo.wado";
use { Cpu, Holds, Tensor } from "./tensor.wado";

test "a recorded graph run on the CPU computes what the CPU computes as each operation is added" {
    let [x, ids] = mixed_inputs();
    let cpu = &mut Cpu {};
    let want = mixed(cpu, &x, &ids);
    let mut r = Recorder::new();
    let rx = r.parameter::<f32, [A, B]>(x.extents);
    let rids = r.parameter::<i64, [C]>(ids.extents);
    let got = mixed(&mut r, &rx, &rids);
    let recorded = r.finished([got.0.id, got.1.id, got.2.id, got.3.id, got.4.id]);
    assert recorded.nodes[got.0.id].extents == want.0.extents;
    assert run(cpu, &recorded, &[
        host_of(&x),
        host_of(&ids),
    ]) == [
        host_of(&want.0),
        host_of(&want.1),
        host_of(&want.2),
        host_of(&want.3),
        host_of(&want.4),
    ] as List<Any<Cpu>>;
}

test "an arg max records as one node, which a run computes as the backend's kernel does, a NaN greatest" {
    let x = Tensor::<f32, [A, B]> {
        data: [1.0, 3.0, 3.0, f32::NAN, 2.0, -1.0],
        extents: [2, 3],
    };
    let mut r = Recorder::new();
    let rx = r.parameter::<f32, [A, B]>(x.extents);
    let ranked = r.arg_max(&rx, 1);
    let recorded = r.finished([ranked.id]);
    assert recorded.nodes.len() == 2;
    assert run(&mut Cpu {}, &recorded, &[host_of(&x)]) == [
        host_of(&Tensor::<i64, [A, B]> {
            data: [1, 0],
            extents: [2, 1],
        }),
    ] as List<Any<Cpu>>;
}

test "every recorded elementwise operation computes the CPU's" {
    let cpu = &mut Cpu {};
    let [x, y] = elementwise_inputs();
    let want = elementwise(cpu, &x, &y);
    let mut r = Recorder::new();
    let rx = r.parameter::<f32, [A]>(x.extents);
    let ry = r.parameter::<f32, [A]>(y.extents);
    let recorded = r.finished([elementwise(&mut r, &rx, &ry).id]);
    assert run(cpu, &recorded, &[
        host_of(&x),
        host_of(&y),
    ]) == [host_of(&want)] as List<Any<Cpu>>;
}

test "a recorded convolution and pooling compute the CPU's, an uploaded tensor a constant of the graph" {
    let x = windowed_input();
    let cpu = &mut Cpu {};
    let want = windowed(cpu, &x);
    let mut r = Recorder::new();
    let rx = r.parameter::<f32, [A, B, C]>(x.extents);
    let got = windowed(&mut r, &rx);
    let recorded = r.finished([got.id]);
    assert recorded.nodes[got.id].extents == want.extents;
    assert run(cpu, &recorded, &[host_of(&x)]) == [host_of(&want)] as List<Any<Cpu>>;
}

test "a recorded conditional runs the branch its predicate picks, the first branch's results naming those of either" {
    for let p of [true, false] as List<bool> {
        let [pred, x] = branching_inputs(p);
        let cpu = &mut Cpu {};
        let want = branching(cpu, &pred, &x);
        let mut r = Recorder::new();
        let rpred = r.parameter::<bool, [C]>(pred.extents);
        let rx = r.parameter::<f32, [A]>(x.extents);
        let got = branching(&mut r, &rpred, &rx);
        let recorded = r.finished([got.id]);
        assert run(cpu, &recorded, &[
            host_of(&pred),
            host_of(&x),
        ]) == [host_of(&want)] as List<Any<Cpu>>;
    }
}

test "a recorded loop runs its body as many times as its count, reading what lies outside it" {
    for let times of [0, 1, 3] as List<i64> {
        let [count, x, ids] = repeating_inputs(times);
        let cpu = &mut Cpu {};
        let want = repeating(cpu, &count, &x, &ids);
        let mut r = Recorder::new();
        let rcount = r.parameter::<i64, []>(count.extents);
        let rx = r.parameter::<f32, [A]>(x.extents);
        let rids = r.parameter::<i64, [A]>(ids.extents);
        let got = repeating(&mut r, &rcount, &rx, &rids);
        let recorded = r.finished([got.0.id, got.1.id]);
        assert run(cpu, &recorded, &[
            host_of(&count),
            host_of(&x),
            host_of(&ids),
        ]) == [
            host_of(&want.0),
            host_of(&want.1),
        ] as List<Any<Cpu>>;
    }
}

test "a loop's body runs on the values the run before returned" {
    let [count, x, ids] = repeating_inputs(3);
    let got = repeating(&mut Cpu {}, &count, &x, &ids);
    assert got.0.data == [8.0, 648.0] as List<f32>;
    assert got.1.data == [8, 10] as List<i64>;
}

#[expect_trap]
test "a loop's body returns what it carries, at its extents" {
    let mut r = Recorder::new();
    let count = r.parameter::<i64, []>([]);
    let x = r.parameter::<f32, [A]>([2]);
    let wider = r.parameter::<f32, [A]>([3]);
    let start: List<Any<Recorder>> = [Any::F32(r.relabeled::<f32, [A], Untyped>(&x))];
    r.repeated(&count, &start, |_, _| [Any::F32(r.relabeled::<f32, [A], Untyped>(&wider))]);
}

#[expect_trap]
test "a loop on Cpu holds its body to what it carries, as a recording does" {
    let cpu = &mut Cpu {};
    let count = Tensor::<i64, []> {
        data: [1],
        extents: [],
    };
    let x = Tensor::<f32, [A]> {
        data: [1.0],
        extents: [1],
    };
    let wider = Tensor::<f32, [A]> {
        data: [1.0, 2.0],
        extents: [2],
    };
    let start: List<Any<Cpu>> = [Any::F32(cpu.relabeled::<f32, [A], Untyped>(&x))];
    cpu.repeated(&count, &start, |_, _| [Any::F32(cpu.relabeled::<f32, [A], Untyped>(&wider))]);
}

#[expect_trap]
test "a recorded graph holds no element to download" {
    let mut r = Recorder::new();
    let x = r.parameter::<f32, [A]>([2]);
    r.download(&x);
}

test "a recorded attention composite computes the CPU's, its presents the buffer it shares" {
    for let case of [
        attention_case(),
        attention_rows([1, 2]),
    ] as List<AttentionCase> {
        recorded_attention(&case);
    }
}

fn recorded_attention(case: &AttentionCase) {
    let [q, k, v] = case.inputs;
    let [past_k, past_v, length] = case.past;
    let [cos, sin] = case.rotation;
    let cpu = &mut Cpu {};
    let want = attending(cpu, &case.inputs, &case.past, &case.rotation, &case.bias, &case.options);
    let mut r = Recorder::new();
    let inputs = [
        r.parameter::<f32, [Bt, St, Qt]>(q.extents),
        r.parameter::<f32, [Bt, St, Kt]>(k.extents),
        r.parameter::<f32, [Bt, St, Kt]>(v.extents),
    ];
    let past = [
        r.parameter::<f32, [Bt, Ht, Pt, Dt]>(past_k.extents),
        r.parameter::<f32, [Bt, Ht, Pt, Dt]>(past_v.extents),
        r.parameter::<i64, [Slots]>(length.extents),
    ];
    let rotation = [
        r.parameter::<f32, [Pos, Half]>(cos.extents),
        r.parameter::<f32, [Pos, Half]>(sin.extents),
    ];
    let bias = r.parameter::<f32, [Bt, Ht, St, Tt]>(case.bias.extents);
    let got = attending(&mut r, &inputs, &past, &rotation, &bias, &case.options);
    let recorded = r.finished([got.0.id, got.1.id, got.2.id]);
    assert recorded.nodes[got.1.id].extents == want.1.extents;
    let arguments: List<Any<Cpu>> = [
        host_of(&q),
        host_of(&k),
        host_of(&v),
        host_of(&past_k),
        host_of(&past_v),
        host_of(&length),
        host_of(&cos),
        host_of(&sin),
        host_of(&case.bias),
    ];
    assert run(cpu, &recorded, &arguments) == [
        host_of(&want.0),
        host_of(&want.1),
        host_of(&want.2),
    ] as List<Any<Cpu>>;
}
