//! `WebGpuBackend` as a `Graph`: each operation computed as it is added, on
//! the device where a kernel of the backend computes it, and on the host
//! otherwise. An `i64` tensor stays on the host, as it does for the kernels,
//! but for the index a kernel ranks and what reckons with it, held as an f32.
//! A compiled program launches the kernels `fusion.wado` plans instead.

use { HashMap, HashSet } from "core:collections";
use {
    GpuDevice,
    GpuQueue,
    GpuCommandEncoder,
    GpuCommandBuffer,
    GpuBuffer,
    GpuBindGroupLayout,
    GpuBindGroup,
    GpuShaderModule,
    GpuComputePipeline,
    GpuComputePassEncoder,
} from "wasi:webgpu";
use {
    Backend,
    Binary,
    Comparison,
    Convolution,
    DotDims,
    GatherDims,
    Graph,
    Quantized,
    ScatterDims,
    Slots,
    Unary,
    WindowReduce,
    broadcast_in_dim_extents,
    decomposed_attention,
    decomposed_gather,
    decomposed_product,
    dot_extents,
    elementwise_extents,
    free_axes,
    gathered_extents,
    kept_axes,
    padded_with_zeros,
    picked,
    reduced_extents,
    scalar,
    sliced_extents,
} from "./hlo.wado";
use {
    Attention,
    BinaryOp,
    Cpu,
    CpuTensor,
    Element,
    Float,
    ElementKind,
    HalfFloat,
    Epilogue,
    Expr,
    Holds,
    Prologue,
    RowOp,
    Tensor,
    constant,
    element_count,
    operand,
    optional,
} from "./tensor.wado";
use {
    Kernel,
    KernelOperand,
    Pair,
    Plan,
    binary_op,
    compared_op,
    planned,
    replanned,
    splats_of,
    unary_of,
    weights_of,
} from "./fusion.wado";
use {
    Any,
    Operation,
    QuantizedNode,
    Recorded,
    RecordedNode,
    Recorder,
    Run,
    Untyped,
    Values,
    bools,
    carried_starts,
    constants,
    kept_any,
} from "./recorded.wado";
use {
    DeviceTensor,
    ExpertPool,
    Placed,
    PlacedRead,
    WebGpuBackend,
    permuted,
    reads_as,
    sliced,
    slot_layout,
} from "./webgpu.wado";
use { Experts, Held, Hidden, Picked, Projection, Routing, decomposed_mixture, runs_by_picks } from "./experts.wado";
use { HostWeight, stored_bytes } from "./weight.wado";
use { HostExperts, HostProjection, computes_on_host, expert_row } from "./cpu_experts.wado";
use { LinearArray } from "core:linear";

/// A pass recorded once per shape class and planned into kernels, which each
/// call launches, and the values of the nodes that read no argument, kept on
/// the device.
pub struct WebGpuProgram {
    recorded: Recorded,
    plan: Plan,
    /// What `plan` folds of the nodes that read no argument.
    splats: HashMap<i32, Option<f32>>,
    constants: HashMap<i32, Any<WebGpuBackend>>,
    /// What the backend keys this program's launches by: one serial for every
    /// program of one structure, each shape class of a graph, so a launch of a
    /// new class binds the buffers and parameters another class's made.
    serial: i32,
    /// How each launch of kernels replays, by the root `launched` starts it
    /// by.
    replays: HashMap<i32, Replay>,
}

/// What a launch's commands are recorded under, and the nodes whose views
/// they read. The key holds the signature of each kernel: what its commands
/// depend on beside those views, so a recording of one shape class replays in
/// another only where they agree.
struct Replay {
    key: i32,
    reads: List<i32>,
}

impl Backend for WebGpuBackend {
    type Program = WebGpuProgram;

    /// A program takes the plan of an earlier one of its structure where the
    /// extents let it. A constant is kept only where a launch reads it, so
    /// neither one only other constants read nor one a kernel writes in.
    fn compiled(
        &mut self,
        recorded: Recorded,
        weights: &List<Any<WebGpuBackend>>,
        earlier: &List<&WebGpuProgram>,
    ) -> WebGpuProgram with (_, GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let folded = constants(&mut self.cpu, &recorded);
        let splats = splats_of(&folded);
        let serial = self.program_serial(structure_of(&recorded));
        let mut reused: Option<Plan> = null;
        for let p of *earlier {
            if p.serial == serial {
                reused = replanned(&p.recorded, &p.plan, &p.splats, &recorded, &splats);
                if reused matches { Some(_) } {
                    break;
                }
            }
        }
        let plan = match reused {
            Some(p) => p,
            null => planned(&recorded, &splats),
        };
        let mut kept = HashMap::<i32, Any<WebGpuBackend>>::new();
        for let id of plan.reads(&recorded) {
            if let Some(value) = folded.get(id) && !kept.contains_key(id) {
                kept[id] = kept_any(self, &value);
            }
        }
        let mut replays = HashMap::<i32, Replay>::new();
        keyed(self, &recorded, serial, &plan, &mut replays);
        return WebGpuProgram { recorded, plan, splats, constants: kept, serial, replays };
    }

    /// A weight read only as products' right matrix, or as a gather's rows, is
    /// kept as `kept_matrix` keeps one, read from its stored bytes along the
    /// axis the products contract. The weights of a `Joined` launch are kept
    /// so as one matrix, side by side, and those of a `Paired` one as one
    /// matrix whose columns alternate between theirs, each a view of it. The
    /// weights of quantized products, each one per column, are laid so too
    /// along their rows. Any other weight is kept as `kept_plain` keeps it.
    fn kept_weights<Er>(
        &mut self,
        record: fn(&mut Recorder) -> Recorded with _,
        first: i32,
        count: i32,
        load: fn(i32) -> Result<HostWeight, Er> with _,
    ) -> Result<List<Any<WebGpuBackend>>, Er> with (_, GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let recorded = record(&mut Recorder::new());
        let contracted = contracted_axes(&recorded, first, count);
        let joined = joined_products(&recorded, self.max_binding());
        let mut kept = List::<Option<Any<WebGpuBackend>>>::filled(count, null);
        for let [run, paired] of weight_runs(&recorded, &joined, first, count, &contracted) {
            let axis = contracted[run[0]].unwrap();
            let free = 1 - axis;
            let mut parts: List<HostWeight> = [];
            for let at of run {
                parts.push(load(at)?);
            }
            // One product's operands are of one element, and so are a run's.
            let kind = parts[0].kind;
            let inner = parts[0].extents[axis];
            if paired {
                // Column `2j + p` is column `j` of part `p`, as `Paired` says.
                let d = self.kept_matrix(inner, 2 * parts[0].extents[free], &parts, |ps, r, c| {
                    return contracted_at(&ps[c % 2], axis, r, c / 2);
                });
                for let [j, at] of run.into_iter().enumerate() {
                    let view = DeviceTensor {
                        ..d,
                        offset: d.offset + j * d.strides[1],
                        extents: [d.extents[0], d.extents[1] / 2],
                        strides: [d.strides[0], 2 * d.strides[1]],
                    };
                    kept[at] = Option::Some(of_kind(self, kind, Placed::Device(if axis == 0 {
                        view;
                    } else {
                        permuted(&view, &([1, 0] as List<i32>));
                    })));
                }
                continue;
            }
            // Side by side along their free axis.
            let mut starts: List<i32> = [];
            let mut columns = 0;
            for let p of &parts {
                starts.push(columns);
                columns += p.extents[free];
            }
            let d = oriented(self.kept_matrix(inner, columns, &parts, |ps, r, c| {
                let mut p = ps.len() - 1;
                while starts[p] > c {
                    p -= 1;
                }
                return contracted_at(&ps[p], axis, r, c - starts[p]);
            }), axis);
            for let [k, at] of run.into_iter().enumerate() {
                kept[at] = Option::Some(
                    of_kind(self, kind, Placed::Device(sliced(&d, free, starts[k], parts[k].extents[free]))),
                );
            }
        }
        for let [run, paired] of weight_rows(&recorded, &joined, first, count) {
            let [laid, rows_of] = rows_laid(&run, paired, load)?;
            let whole = kept_plain(self, &laid);
            let d = *on_device(&whole).unwrap();
            let mut start = 0;
            for let [j, at] of run.into_iter().enumerate() {
                let rows = rows_of[j];
                let mut extents = d.extents;
                extents[0] = rows;
                let mut strides = d.strides;
                let offset = if paired {
                    strides[0] = 2 * d.strides[0];
                    d.offset + j * d.strides[0];
                } else {
                    d.offset + start * d.strides[0];
                };
                kept[at] = Option::Some(viewing(&whole, DeviceTensor { ..d, offset, extents, strides }));
                start += rows;
            }
        }
        for let at of 0..<count {
            if kept[at] matches { Some(_) } {
                continue;
            }
            let w = load(at)?;
            kept[at] = Option::Some(if let Some(axis) = contracted[at] {
                let [kind, inner, outer] = [w.kind, w.extents[axis], w.extents[1 - axis]];
                let one: List<HostWeight> = [w];
                let matrix = self.kept_matrix(inner, outer, &one, |ps, r, c| contracted_at(&ps[0], axis, r, c));
                of_kind(self, kind, Placed::Device(oriented(matrix, axis)));
            } else {
                kept_plain(self, &w);
            });
        }
        return Result::Ok(kept.into_iter().map(|k| k.unwrap()).collect());
    }

    fn executed(
        &mut self,
        program: &WebGpuProgram,
        arguments: &List<Any<WebGpuBackend>>,
        weights: &List<Any<WebGpuBackend>>,
    ) -> List<Any<WebGpuBackend>> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let mut state = Run::<WebGpuBackend>::new(&program.recorded, arguments, weights, &program.constants);
        let results = launched(self, &mut state, program, &program.plan);
        let mut returned: List<i32> = [];
        for let r of &results {
            if let Some(d) = on_device(r) {
                returned.push(d.slot);
            }
        }
        let moved = self.ran_program(program.serial, &returned);
        return results.into_iter().map(|r| match on_device(&r) {
            Some(d) && moved.contains_key(d.slot) => at_slot(&r, moved[d.slot]),
            _ => r,
        }).collect();
    }

    fn pool(
        &mut self,
        kind: ElementKind,
        extents: List<i32>,
    ) -> Any<WebGpuBackend> with (GpuDevice, GpuQueue, GpuBuffer) {
        let d = self.pooled(kind, extents);
        if kind matches { _::U8 } {
            return Any::U8(Placed::Device(d));
        }
        return of_kind(self, kind, Placed::Device(d));
    }

    /// As many slots as one binding holds, laid as `pooled` lays them.
    fn pool_slots(&self, kind: ElementKind, slot: &List<i32>) -> i32 {
        return self.max_binding() / slot_layout(kind, element_count(slot)).0;
    }

    fn written(&mut self, pool: &mut Any<WebGpuBackend>, slot: i32, row: HostWeight) with (GpuQueue, GpuBuffer) {
        self.written_slot(on_device(pool).unwrap(), slot, &row);
    }

    fn computes_misses(&self, quantized: &Quantized) -> bool {
        return computes_on_host(quantized);
    }

    fn held_on_host(&mut self, pool: &Any<WebGpuBackend>, step: i32, experts: HostWeight) {
        let key = host_expert_key(on_device(pool).unwrap(), step);
        let held = HostExperts::of(&experts);
        match self.host_expert_at.get(key) {
            Some(at) => self.host_experts[at] = held,
            null => {
                self.host_expert_at[key] = self.host_experts.len();
                self.host_experts.push(held);
            },
        }
    }

    fn written_from_host(
        &mut self,
        pool: &mut Any<WebGpuBackend>,
        slot: i32,
        step: i32,
        expert: i32,
    ) with (GpuQueue, GpuBuffer) {
        let on = on_device(pool).unwrap();
        self.written_slot(on, slot, &host_experts(self, on, step).expert(expert));
    }
}

/// Where `WebGpuBackend::host_experts` holds the experts of the layer whose
/// host step is `step`, for the pool `pool` views.
fn host_expert_key(pool: &DeviceTensor, step: i32) -> i64 {
    return pool.slot as i64 << 32 | step as i64;
}

impl Graph for WebGpuBackend {
    fn relabeled<E: Element, In, Out>(&self, t: &Placed<E, In>) -> Placed<E, Out> {
        return match t {
            Host(h) => Placed::Host(Tensor { data: h.data, extents: h.extents }),
            Device(d) => Placed::Device(*d),
        };
    }

    fn iota<E: Element, Axes>(&mut self, extents: List<i32>, dimension: i32) -> Placed<E, Axes> {
        return hosted(self.cpu.iota(extents, dimension));
    }

    fn convert<A: Element, B: Element, Axes>(
        &mut self,
        x: &Placed<A, Axes>,
    ) -> Placed<B, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let truncates = A::is_float() && B::kind() matches { _::I64 };
        if let Device(d) = x && !truncates && B::kind() matches { _::F32 | _::F16 | _::BF16 | _::I64 | _::Bool } {
            // A device holds a bool, or an index a kernel ranked, as the f32 it
            // converts to.
            let held = operand(0);
            let converted = if A::kind() == B::kind() || A::kind() matches { _::Bool } {
                held;
            } else if B::kind() matches { _::Bool } {
                held.binary(BinaryOp::Ne, &constant(0.0));
            } else {
                held.stored_as(B::kind());
            };
            if converted == held {
                return Placed::Device(*d);
            }
            return as_element(self, self.fused_on::<Axes>(&([*d] as List<DeviceTensor>), &converted));
        }
        return hosted(self.cpu.convert(&self.on_cpu(x)));
    }

    fn unary<E: Float, Axes>(
        &mut self,
        op: Unary,
        x: &Placed<E, Axes>,
    ) -> Placed<E, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let stored = unary_of(op).stored_as(E::kind());
        return as_element(self, self.fused_on::<Axes>(&([self.device_view(x)] as List<DeviceTensor>), &stored));
    }

    fn binary<E: Element, Axes>(
        &mut self,
        op: Binary,
        a: &Placed<E, Axes>,
        b: &Placed<E, Axes>,
    ) -> Placed<E, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        // On the device an `i64` is the index it holds as an f32, and those
        // four stay one: a product might not, and a quotient would not truncate.
        // A `u8` wraps, which an f32 does not.
        let index_reckoning = !E::kind() matches { _::U8 }
            && op matches { _::Add | _::Subtract | _::Minimum | _::Maximum }
            && held_as_f32(a, b);
        if !E::is_float() && !index_reckoning {
            return hosted(self.cpu.binary(op, &self.on_cpu(a), &self.on_cpu(b)));
        }
        let operands = [
            self.device_view(a),
            self.device_view(b),
        ] as List<DeviceTensor>;
        let stored = operand(0).binary(binary_op(op), &operand(1)).stored_as(E::kind());
        return as_element(self, elementwise_on::<Axes>(self, &operands, &stored));
    }

    fn compare<E: Element, Axes>(
        &mut self,
        direction: Comparison,
        a: &Placed<E, Axes>,
        b: &Placed<E, Axes>,
    ) -> Placed<bool, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        if !held_as_f32(a, b) {
            return hosted(self.cpu.compare(direction, &self.on_cpu(a), &self.on_cpu(b)));
        }
        let operands = [
            self.device_view(a),
            self.device_view(b),
        ] as List<DeviceTensor>;
        let held = operand(0).binary(compared_op(direction), &operand(1));
        return as_element(self, elementwise_on::<Axes>(self, &operands, &held));
    }

    fn select<E: Element, Axes>(
        &mut self,
        pred: &Placed<bool, Axes>,
        on_true: &Placed<E, Axes>,
        on_false: &Placed<E, Axes>,
    ) -> Placed<E, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        if !held_as_f32(on_true, on_false) {
            return hosted(self.cpu.select(&self.on_cpu(pred), &self.on_cpu(on_true), &self.on_cpu(on_false)));
        }
        let operands = [
            self.device_view(pred),
            self.device_view(on_true),
            self.device_view(on_false),
        ] as List<DeviceTensor>;
        let chosen = operand(0).select(&operand(1), &operand(2));
        return as_element(self, elementwise_on::<Axes>(self, &operands, &chosen));
    }

    /// A view: each stretched axis reads its one element through a stride of 0.
    fn broadcast_in_dim<E: Element, In, Out>(
        &mut self,
        x: &Placed<E, In>,
        extents: List<i32>,
        dims: List<i32>,
    ) -> Placed<E, Out> {
        let Device(d) = x else {
            return hosted(self.cpu.broadcast_in_dim(&CpuTensor::Value(self.host_only(x)), extents, dims));
        };
        let extents = broadcast_in_dim_extents(&d.extents, extents, &dims);
        let mut strides = List::<i32>::filled(extents.len(), 0);
        for let [i, axis] of dims.into_iter().enumerate() {
            if d.extents[i] != 1 {
                strides[axis] = d.strides[i];
            }
        }
        return Placed::Device(DeviceTensor { ..*d, extents, strides });
    }

    fn reshape<E: Element, In, Out>(
        &mut self,
        x: &Placed<E, In>,
        extents: List<i32>,
    ) -> Placed<E, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let Device(d) = x else {
            return hosted(self.cpu.reshape(&CpuTensor::Value(self.host_only(x)), extents));
        };
        return Placed::Device(self.reshaped(d, &extents));
    }

    fn transpose<E: Element, In, Out>(&mut self, x: &Placed<E, In>, perm: List<i32>) -> Placed<E, Out> {
        let Device(d) = x else {
            return hosted(self.cpu.transpose(&CpuTensor::Value(self.host_only(x)), perm));
        };
        return Placed::Device(permuted(d, &perm));
    }

    /// A view: each axis from its start, its stride scaled by the step.
    fn slice<E: Element, In, Out>(
        &mut self,
        x: &Placed<E, In>,
        start: List<i32>,
        limit: List<i32>,
        strides: List<i32>,
    ) -> Placed<E, Out> {
        let Device(d) = x else {
            return hosted(self.cpu.slice(&CpuTensor::Value(self.host_only(x)), start, limit, strides));
        };
        let mut view = DeviceTensor { ..*d, extents: sliced_extents(&d.extents, &start, &limit, &strides) };
        for let a of 0..<start.len() {
            view.offset += start[a] * d.strides[a];
            view.strides[a] = d.strides[a] * strides[a];
        }
        return Placed::Device(view);
    }

    fn concatenate<E: Element, A, B, Out>(
        &mut self,
        a: &Placed<E, A>,
        b: &Placed<E, B>,
        dimension: i32,
    ) -> Placed<E, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        if !E::exact_in_f32() {
            return hosted(self.cpu.concatenate(&self.on_cpu(a), &self.on_cpu(b), dimension));
        }
        return Placed::Device(self.joined(&self.device_view(a), &self.device_view(b), dimension));
    }

    /// A view over more of an attention cache's positions where it has room
    /// for them, and zeros joined on otherwise.
    fn grown<E: Element, Axes>(
        &mut self,
        x: &Placed<E, Axes>,
        axis: i32,
        extent: i32,
    ) -> Placed<E, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        if let Device(d) = x && let Some(widened) = self.widened_cache(d, axis, extent) {
            return Placed::Device(widened);
        }
        if !E::exact_in_f32() {
            return padded_with_zeros::<WebGpuBackend, E, Axes>(self, x, axis, extent);
        }
        let mut extents = self.extents_of(x);
        let own = extents[axis];
        extents[axis] = extent;
        let to = self.new_tensor(extents, E::kind() matches { _::F16 });
        if element_count(&self.extents_of(x)) > 0 {
            let from = self.device_view(x);
            self.copy(&from, &sliced(&to, axis, 0, own));
        }
        return Placed::Device(to);
    }

    /// The row kernel where `init` is the fold's identity, so the fold from it
    /// is the fold of the elements alone.
    fn reduce<E: Element, In, Out>(
        &mut self,
        x: &Placed<E, In>,
        op: Binary,
        init: f32,
        dims: List<i32>,
    ) -> Placed<E, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        // WGSL holds no 64-bit integer, so an integer stays on the host.
        if !E::is_float() {
            return hosted(self.cpu.reduce(&self.on_cpu(x), op, init, dims));
        }
        let fold = match op {
            _::Add && init.to_bits() == 0 => Option::Some(operand(0).row_sum(null)),
            _::Maximum && init == f32::NEG_INFINITY => Option::Some(operand(0).row(RowOp::Max)),
            _ => null,
        };
        let view = self.device_view(x);
        if let Some(e) = fold && let Some(kept) = self.reduced(&view, &dims, &e.stored_as(E::kind())) {
            return Placed::Device(self.reshaped(&kept, &reduced_extents(&view.extents, &dims)));
        }
        return hosted(self.cpu.reduce(&self.on_cpu(x), op, init, dims));
    }

    /// One product of `[batch…, rows, inner]` by `[batch…, inner, columns]`,
    /// each operand's free and contracting axes merged by a view where its
    /// strides allow one, and by a copy otherwise.
    fn dot_general<E: Float, A, B, Out>(
        &mut self,
        lhs: &Placed<E, A>,
        rhs: &Placed<E, B>,
        dims: &DotDims,
    ) -> Placed<E, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let [l, r] = [
            self.device_view(lhs),
            self.device_view(rhs),
        ];
        let then = HalfFloat::of(E::kind()).map(|to: HalfFloat| Epilogue::<PlacedRead<Untyped>> {
            operands: [],
            op: operand(0).rounded(to),
        });
        return as_element(self, self.relabeled::<f32, Untyped, Out>(&dotted(self, &l, &r, dims, &then)));
    }

    /// The gather kernel where the gather takes whole slices along one axis,
    /// each index clamped into it as StableHLO clamps a start.
    fn gather<E: Element, D, I, Out>(
        &mut self,
        data: &Placed<E, D>,
        indices: &Placed<i64, I>,
        dims: &GatherDims,
    ) -> Placed<E, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let extents = self.extents_of(data);
        if let Device(by) = indices
            && E::exact_in_f32()
            && let Some(axis) = taken_axis(&extents, &by.extents, dims)
            && let Some(out) = self.gathered_by(
                &self.device_view(data),
                by,
                axis,
                &gathered_extents(&by.extents, dims),
            ) {
            return Placed::Device(out);
        }
        let index = self.host(indices);
        let exact = E::exact_in_f32();
        // An element an f32 does not hold is taken by a view alone, which a
        // merge of the axes taken could copy.
        if let Some(TakenAxes { first, count, batch }) = taken_axes(&extents, &index.extents, dims)
            && (exact || count == 1) {
            // The axes taken merge into one, which each index's flat position
            // along them takes.
            let mut starts = List::<i64>::with_capacity(index.data.len() / count);
            for let at of 0..<index.data.len() / count {
                let mut flat: i64 = 0;
                for let k of 0..<count {
                    let along = extents[first + k] as i64;
                    flat = flat * along + i64::clamp(index.data[at * count + k], 0, along - 1);
                }
                starts.push(flat);
            }
            let clamped = Tensor::<i64, I> {
                data: starts,
                extents: index.extents[0..<batch].to_list(),
            };
            let mut merged = extents[0..<first].to_list();
            merged.push(element_count(&extents[first..<first + count].to_list()));
            merged.extend(&extents[first + count..<extents.len()].to_list());
            let view = self.device_view(data);
            if let Some(out) = self.gathered(&self.reshaped(&view, &merged), &clamped, first, exact) {
                assert out.extents == gathered_extents(&index.extents, dims);
                return Placed::Device(out);
            }
        }
        return hosted(self.cpu.gather(&self.on_cpu(data), &CpuTensor::Value(index), dims));
    }

    /// A copy of the operand, then each update window copied over it, cut to
    /// the operand where it reaches past it.
    fn scatter<E: Element, D, I, U>(
        &mut self,
        base: &Placed<E, D>,
        indices: &Placed<i64, I>,
        updates: &Placed<E, U>,
        dims: &ScatterDims,
    ) -> Placed<E, D> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let index = self.host(indices);
        if !held_as_f32(base, updates) {
            return hosted(self.cpu.scatter(&self.on_cpu(base), &CpuTensor::Value(index), &self.on_cpu(updates), dims));
        }
        let source = self.device_view(base);
        let update = self.device_view(updates);
        let out = self.new_tensor(source.extents, E::kind() matches { _::F16 });
        self.copy(&source, &out);
        for let [from, to] of scatter_windows(&out, &update, &index, dims) {
            self.copy(&from, &to);
        }
        return Placed::Device(out);
    }

    fn convolution<E: Float, In, K, Out>(
        &mut self,
        x: &Placed<E, In>,
        kernel: &Placed<E, K>,
        conv: &Convolution,
    ) -> Placed<E, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        return hosted(self.cpu.convolution(&self.on_cpu(x), &self.on_cpu(kernel), conv));
    }

    fn reduce_window<E: Float, In, Out>(
        &mut self,
        x: &Placed<E, In>,
        op: Binary,
        init: f32,
        window: &WindowReduce,
    ) -> Placed<E, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        return hosted(self.cpu.reduce_window(&self.on_cpu(x), op, init, window));
    }

    /// A view: each reversed axis read from its last element back.
    fn reverse<E: Element, Axes>(&mut self, x: &Placed<E, Axes>, dims: List<i32>) -> Placed<E, Axes> {
        let Device(d) = x else {
            return hosted(self.cpu.reverse(&CpuTensor::Value(self.host_only(x)), dims));
        };
        let mut view = *d;
        for let a of dims {
            view.offset += (d.extents[a] - 1) * d.strides[a];
            view.strides[a] = -d.strides[a];
        }
        return Placed::Device(view);
    }

    fn arg_max<E: Float, Axes>(
        &mut self,
        x: &Placed<E, Axes>,
        axis: i32,
    ) -> Placed<i64, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        return self.arg_max_kernel(x, axis);
    }

    /// The branch the condition picks, which is read back from the device.
    fn conditional<Axes, T>(
        &mut self,
        pred: &Placed<bool, Axes>,
        then: fn() -> T with _,
        otherwise: fn() -> T with _,
    ) -> T with (_, GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let condition = self.host(pred);
        assert condition.data.len() == 1, "a condition is one element";
        return if condition.data[0] { then() } else { otherwise() };
    }

    /// The backend's attention kernels, and the decomposition where they
    /// cannot run it. Each row of a shared past holds its `past_length` valid
    /// positions, the kernels attend over those and the new ones, or the first
    /// of its `reach` of them, as many columns of the bias,
    /// and the present is the past's buffer with the new ones written after the
    /// valid ones. Past the valid ones a causal attention reads none, so the
    /// kernels compute what the decomposition does.
    fn group_query_attention<E: Float, B, S, Q, K, H, P, T, D, Pos, Half, BB, BH, BS, SH>(
        &mut self,
        q: &Placed<E, [B, S, Q]>,
        k: &Placed<E, [B, S, K]>,
        v: &Placed<E, [B, S, K]>,
        past_k: &Placed<E, [B, H, P, D]>,
        past_v: &Placed<E, [B, H, P, D]>,
        past_length: Option<&Placed<i64, [Slots]>>,
        reach: Option<&Placed<i64, [Slots]>>,
        cos: Option<&Placed<E, [Pos, Half]>>,
        sin: Option<&Placed<E, [Pos, Half]>>,
        bias: Option<&Placed<E, [BB, BH, BS, T]>>,
        sinks: Option<&Placed<E, [SH]>>,
        options: &Attention,
    ) -> [Placed<E, [B, S, Q]>, Placed<E, [B, H, T, D]>, Placed<E, [B, H, T, D]>] with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let shared = past_length matches { Some(_) };
        kernels: {
            if shared && !options.causal {
                break kernels;
            }
            let positions = self.extents_of(past_k)[2];
            let queries = self.extents_of(q);
            let [rows, fresh] = [queries[0], queries[1]];
            let valid = row_lengths(self, past_length, rows, |_| positions);
            let attended = row_lengths(self, reach, rows, |row| valid[row] + fresh);
            for let row of 0..<rows {
                assert !shared || valid[row] + fresh <= positions, "a shared past holds the new positions after its valid ones";
            }
            let rotary = match [cos, sin] {
                [Some(c), Some(s)] => Option::Some([
                    self.device_view(c),
                    self.device_view(s),
                ]),
                _ => null,
            };
            let [held_k, held_v] = [
                self.device_view(past_k),
                self.device_view(past_v),
            ];
            let query = self.device_view(q);
            let biased = match bias {
                Some(b) => Option::Some(self.device_view(b)),
                null => null,
            };
            let sunk = match sinks {
                Some(h) => Option::Some(self.device_view(h)),
                null => null,
            };
            if let Some([out, present_k, present_v]) = self.attended(
                &query,
                &self.device_view(k),
                &self.device_view(v),
                &held_k,
                &held_v,
                &valid,
                &attended,
                shared,
                &rotary,
                &biased,
                &sunk,
                options,
                HalfFloat::of(E::kind()),
            ) {
                let span = |t: DeviceTensor| if shared { DeviceTensor { ..t, extents: held_k.extents } } else { t };
                return [
                    Placed::Device(out),
                    Placed::Device(span(present_k)),
                    Placed::Device(span(present_v)),
                ];
            }
        }
        return decomposed_attention::<WebGpuBackend, E, B, S, Q, K, H, P, T, D, Pos, Half, BB, BH, BS, SH>(
            self,
            q,
            k,
            v,
            past_k,
            past_v,
            past_length,
            reach,
            cos,
            sin,
            bias,
            sinks,
            options,
        );
    }

    /// The backend's kernel over the packed weight, and the decomposition
    /// where it cannot run it.
    fn quantized_product<E: Float, In, N, Blocks, Blob, Z, Out>(
        &mut self,
        a: &Placed<E, In>,
        packed: &Placed<u8, [N, Blocks, Blob]>,
        scales: &Placed<E, [N, Blocks]>,
        zero_points: Option<&Placed<u8, [N, Z]>>,
        quantized: &Quantized,
    ) -> Placed<E, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        // Held once, for the kernel and for the decomposition where it declines.
        let a = &Placed::<E, In>::Device(self.device_view(a));
        let mut extents = self.extents_of(a);
        let last = extents.len() - 1;
        let operands = with_zero_points(self, [
            as_rows(self, &self.device_view(a)),
            self.device_view(packed),
            self.device_view(scales),
        ], zero_points);
        let half = HalfFloat::of(E::kind());
        let stored = Epilogue::<PlacedRead<Untyped>> { operands: [], op: operand(0).stored_as(E::kind()) };
        if let Some(out) = self.quantized_product_kernel(
            &operands,
            quantized.bits,
            quantized.block,
            half,
            &stored,
            false,
        ) {
            extents[last] = out.extents[1];
            return Placed::Device(self.reshaped(&out, &extents));
        }
        return decomposed_product::<WebGpuBackend, E, In, N, Blocks, Blob, Z, Out>(
            self,
            a,
            packed,
            scales,
            zero_points,
            quantized,
        );
    }

    /// The backend's kernel over the packed table, and the decomposition where
    /// it cannot run it.
    fn quantized_gather<E: Float, R, P, I, Blocks, Z, Out>(
        &mut self,
        packed: &Placed<u8, [R, P]>,
        indices: &Placed<i64, I>,
        scales: &Placed<E, [R, Blocks]>,
        zero_points: Option<&Placed<u8, [R, Z]>>,
        quantized: &Quantized,
    ) -> Placed<E, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        // The kernel reads each index as an f32.
        if within_index_bound(indices) {
            let mut extents = self.extents_of(indices);
            let operands = with_zero_points(self, [
                self.device_view(packed),
                self.reshaped(&self.device_view(indices), &([element_count(&extents)] as List<i32>)),
                self.device_view(scales),
            ], zero_points);
            let half = HalfFloat::of(E::kind());
            if let Some(out) = self.quantized_gather_kernel(&operands, quantized.bits, quantized.block, half) {
                extents.push(out.extents[1]);
                return Placed::Device(self.reshaped(&out, &extents));
            }
        }
        return decomposed_gather::<WebGpuBackend, E, R, P, I, Blocks, Z, Out>(
            self,
            packed,
            indices,
            scales,
            zero_points,
            quantized,
        );
    }

    /// The backend's kernels for a step's form, two for each pick, and the
    /// decomposition for a prompt's and where they do not bind.
    fn expert_mixture<E: Float>(
        &mut self,
        rows: &Placed<f32, [Picked, Hidden]>,
        routing: &Routing<WebGpuBackend>,
        held: &Held<WebGpuBackend>,
        ffn: &[Projection<WebGpuBackend, E>, Projection<WebGpuBackend, E>],
        experts: &Experts,
    ) -> Placed<f32, [Picked, Hidden]> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        if runs_by_picks(self, rows, routing, experts)
            && let Some(mixed) = by_picks(self, rows, routing, held, ffn, experts) {
            return Placed::Device(mixed);
        }
        return decomposed_mixture::<WebGpuBackend, E>(self, rows, routing, held, ffn, experts);
    }
}

/// Each token's row through its picks, each pick's two products read where
/// its pool holds the expert, the second summing the picks in order: the
/// decomposition's `by_picks`. `None` where a product does not bind.
fn by_picks<E: Float>(
    g: &mut WebGpuBackend,
    rows: &Placed<f32, [Picked, Hidden]>,
    routing: &Routing<WebGpuBackend>,
    held: &Held<WebGpuBackend>,
    ffn: &[Projection<WebGpuBackend, E>, Projection<WebGpuBackend, E>],
    experts: &Experts,
) -> Option<DeviceTensor> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let picks = g.host(&routing.picks).data;
    let slots = g.host(&held.slots).data;
    let k = experts.k;
    let slot_of = |pick: i32| slots[picks[pick] as i32] as i32;
    let tokens = g.extents_of(rows)[0];
    let on_host = (0..<tokens * k).any(|pick| slot_of(pick) < 0);
    // What the host reads is read back before the device's products are
    // queued, so that the host computes its picks while the device runs them.
    let mut host_rows: List<f32> = [];
    let mut host_weights: List<f32> = [];
    if on_host {
        host_rows = g.host(rows).data;
        host_weights = g.host(&routing.weights).data;
    }
    let x = g.device_view(rows);
    let weights = g.device_view(&routing.weights);
    let [up, down] = [
        expert_pool(g, &ffn.0),
        expert_pool(g, &ffn.1),
    ];
    let mut totals: List<Option<DeviceTensor>> = [];
    for let t of 0..<tokens {
        let row = DeviceTensor {
            ..x,
            offset: x.offset + t * x.strides[0],
            extents: [1, x.extents[1]],
        };
        let mut total: Option<DeviceTensor> = null;
        for let j of 0..<k {
            let slot = slot_of(t * k + j);
            if slot < 0 {
                continue;
            }
            let Some(inner) = g.gated_up(&row, &up, slot, experts) else {
                assert !on_host, "the host's picks have no slot to fall back on";
                return null;
            };
            let weight = DeviceTensor {
                ..weights,
                offset: weights.offset + t * weights.strides[0] + j * weights.strides[1],
                extents: [1, 1],
            };
            let Some(sum) = g.weighed_down(&inner, &down, slot, &weight, optional(&total), &experts.quantized) else {
                assert !on_host, "the host's picks have no slot to fall back on";
                return null;
            };
            total = Option::Some(sum);
        }
        totals.push(total);
    }
    if on_host {
        g.flush();
        let host_up = host_projection(g, &up, experts.step);
        let host_down = host_projection(g, &down, experts.step);
        let hidden = x.extents[1];
        for let t of 0..<tokens {
            let mut sum = List::<f32>::filled(hidden, 0.0);
            let row = host_rows[t * hidden..<(t + 1) * hidden].to_list();
            for let j of 0..<k {
                let weight = host_weights[t * k + j];
                if slot_of(t * k + j) >= 0 || !(weight > 0.0) {
                    continue;
                }
                let out = expert_row(&host_up, &host_down, picks[t * k + j] as i32, &row, experts);
                for let i of 0..<hidden {
                    sum[i] += weight * out[i];
                }
            }
            let computed = g.upload(&Tensor::<f32, [Picked, Hidden]> {
                data: sum,
                extents: [1, hidden],
            });
            totals[t] = Option::Some(g.device_view(&match &totals[t] {
                Some(d) => g.binary(Binary::Add, &Placed::<f32, [Picked, Hidden]>::Device(*d), &computed),
                null => computed,
            }));
        }
    }
    let mut mixed: Option<Placed<f32, [Picked, Hidden]>> = null;
    for let total of totals {
        let done = Placed::<f32, [Picked, Hidden]>::Device(total.unwrap());
        mixed = Option::Some(match &mixed {
            Some(before) => g.concatenate(before, &done, 0),
            null => done,
        });
    }
    return Option::Some(g.device_view(&mixed.unwrap()));
}

/// `pool`'s projection of every expert of the layer whose host step is `step`,
/// as the host holds it.
fn host_projection(g: &WebGpuBackend, pool: &ExpertPool, step: i32) -> HostProjection {
    let scales = host_experts(g, &pool.scales, step);
    return HostProjection {
        packed: host_experts(g, &pool.packed, step).bytes(),
        scales: scales.bytes(),
        bias: match &pool.bias {
            Some(b) => Option::Some(host_experts(g, b, step).bytes()),
            null => null,
        },
        zero_points: match &pool.zero_points {
            Some(z) => Option::Some(host_experts(g, z, step).bytes()),
            null => null,
        },
        kind: scales.kind,
        shape: pool.shape,
    };
}

/// The weight the pool `pool` views holds, of every expert of the layer whose
/// host step is `step`, as the host holds it.
fn host_experts(g: &WebGpuBackend, pool: &DeviceTensor, step: i32) -> &HostExperts {
    let Some(at) = g.host_expert_at.get(host_expert_key(pool, step)) else {
        panic(`no layer's experts are held on the host for host step ${step}`);
    };
    return &g.host_experts[at];
}

/// `p`'s pools on the device.
fn expert_pool<E: Float>(
    g: &mut WebGpuBackend,
    p: &Projection<WebGpuBackend, E>,
) -> ExpertPool with (GpuDevice, GpuQueue, GpuBuffer) {
    let bias = match &p.bias {
        Some(b) => Option::Some(g.device_view(b)),
        null => null,
    };
    let zero_points = match &p.zero_points {
        Some(z) => Option::Some(g.device_view(z)),
        null => null,
    };
    return ExpertPool {
        packed: g.device_view(&p.packed),
        scales: g.device_view(&p.scales),
        bias,
        zero_points,
        shape: p.shape,
    };
}

/// `view` as a matrix of its last axis, its other axes one: what a quantized
/// product multiplies, and computes.
fn as_rows(
    g: &mut WebGpuBackend,
    view: &DeviceTensor,
) -> DeviceTensor with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let last = view.extents.len() - 1;
    let inner = view.extents[last];
    return g.reshaped(view, &([element_count(&view.extents) / inner, inner] as List<i32>));
}

/// A quantized kernel's `operands`, then its zero points where it has them.
fn with_zero_points<Z>(
    g: &mut WebGpuBackend,
    operands: List<DeviceTensor>,
    zero_points: Option<&Placed<u8, Z>>,
) -> List<DeviceTensor> with (GpuDevice, GpuQueue, GpuBuffer) {
    let mut all = operands;
    if let Some(z) = zero_points {
        all.push(g.device_view(z));
    }
    return all;
}

/// The length each of `rows` rows holds in `length`, one for every row or one
/// they share, or `absent` of the row where there is none.
fn row_lengths(
    g: &mut WebGpuBackend,
    length: Option<&Placed<i64, [Slots]>>,
    rows: i32,
    absent: fn(i32) -> i32,
) -> List<i32> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let mut lengths = List::<i32>::with_capacity(rows);
    let held = match length {
        Some(l) => {
            let data = g.host(l).data;
            assert data.len() == 1 || data.len() == rows, "a length holds one for every row, or one they share";
            Option::Some(data);
        },
        null => null,
    };
    for let row of 0..<rows {
        lengths.push(match &held {
            Some(data) => data[if data.len() == 1 { 0 } else { row }] as i32,
            null => absent(row),
        });
    }
    return lengths;
}

/// For each of the `count` weights `recorded` takes from its parameter
/// `first` on, the axis the products reading it contract, where every node
/// reading it is a product taking it as its right matrix or a gather taking
/// its rows, and the pass returns none of them.
internal fn contracted_axes(recorded: &Recorded, first: i32, count: i32) -> List<Option<i32>> {
    let mut axes = List::<Option<i32>>::filled(count, null);
    for let [id, node] of recorded.nodes.into_iter().enumerate() {
        if let Parameter(p) = node.op && first <= p < first + count {
            axes[p - first] = contracted_axis(recorded, id);
        }
    }
    return axes;
}

/// What `Cpu` computed, which is never a weight it keeps.
fn hosted<E: Element, Axes>(t: CpuTensor<E, Axes>) -> Placed<E, Axes> {
    return Placed::Host(t.into_value());
}

/// The products of each `Joined` and `Paired` launch `recorded` plans into,
/// and whether they pair, where each weight they read, laid as one across
/// them, fits a buffer of `words` words. A launch whose weights lie apart runs
/// a product at a time.
internal fn joined_products(recorded: &Recorded, words: i32) -> List<[List<Kernel>, bool]> {
    let mut joined: List<[List<Kernel>, bool]> = [];
    for let launch of planned(recorded, &splats_of(&constants(&mut Cpu {}, recorded))).flattened() {
        let [ks, paired] = match launch {
            Joined(ks) => [ks, false],
            Paired(p) => [[p.first, p.second] as List<Kernel>, true],
            _ => {
                continue;
            },
        };
        if fits_together(recorded, &ks, words) {
            joined.push([ks, paired]);
        }
    }
    return joined;
}

/// Whether each weight the products of `ks` read, laid as one across them,
/// takes at most `words` words on the device.
fn fits_together(recorded: &Recorded, ks: &List<Kernel>, words: i32) -> bool {
    let weights: List<List<i32>> = ks.into_iter().map(|k| weights_of(&recorded.nodes[k.product.unwrap()])).collect();
    for let i of 0..<weights[0].len() {
        let mut held: i64 = 0;
        for let w of &weights {
            held += kept_words(&recorded.nodes[w[i]]);
        }
        if held > words as i64 {
            return false;
        }
    }
    return true;
}

/// The most words `weight` takes on the device: a quarter of one a byte, and
/// one any other element.
fn kept_words(weight: &RecordedNode) -> i64 {
    let count = element_count(&weight.extents) as i64;
    return if weight.kind matches { _::U8 } { count.div_ceil(4) } else { count };
}

/// The right matrices of each of `joined`'s launches, by their places among
/// the `count` weights `recorded` takes from its parameter `first` on, and
/// whether they pair: each run whose weights `contracted` keeps along one
/// axis, and which share none with a run before it.
fn weight_runs(
    recorded: &Recorded,
    joined: &List<[List<Kernel>, bool]>,
    first: i32,
    count: i32,
    contracted: &List<Option<i32>>,
) -> List<[List<i32>, bool]> {
    let mut taken = HashSet::<i32>::new();
    let mut runs: List<[List<i32>, bool]> = [];
    for let [ks, paired] of *joined {
        let run: List<i32> = ks
            .into_iter()
            .map(|k| match recorded.nodes[recorded.nodes[k.product.unwrap()].operands[1]].op {
                Parameter(p) => p - first,
                _ => unreachable(),
            })
            .collect();
        if !run.into_iter().all(|w| 0 <= w < count) {
            continue;
        }
        let axis = contracted[run[0]];
        let mut own = HashSet::<i32>::new();
        let kept_alike = run.into_iter().all(|w| contracted[w] == axis && !taken.contains(w) && own.insert(w));
        if axis matches { Some(_) } && kept_alike {
            for let w of run {
                taken.insert(w);
            }
            runs.push([run, paired]);
        }
    }
    return runs;
}

/// The weights of each of `joined`'s launches of quantized products, by their
/// places among the `count` weights `recorded` takes from its parameter
/// `first` on, and whether they pair: one run for each weight a product reads,
/// its packed values, scales or zero points, in the launch's order, each of
/// whose weights no run before it holds.
fn weight_rows(
    recorded: &Recorded,
    joined: &List<[List<Kernel>, bool]>,
    first: i32,
    count: i32,
) -> List<[List<i32>, bool]> {
    let mut taken = HashSet::<i32>::new();
    let mut runs: List<[List<i32>, bool]> = [];
    for let [ks, paired] of *joined {
        let products: List<&RecordedNode> = ks.into_iter().map(|k| &recorded.nodes[k.product.unwrap()]).collect();
        if !products[0].op matches { QuantizedProduct(_) } {
            continue;
        }
        for let i of 1..<products[0].operands.len() {
            let run: List<i32> = products.into_iter().map(|p| match recorded.nodes[p.operands[i]].op {
                Parameter(at) => at - first,
                _ => unreachable(),
            }).collect();
            let mut own = HashSet::<i32>::new();
            if run.into_iter().all(|w| 0 <= w < count && !taken.contains(w) && own.insert(w)) {
                for let w of run {
                    taken.insert(w);
                }
                runs.push([run, paired]);
            }
        }
    }
    return runs;
}

/// `parts`, weights of one kind whose extents differ along the first axis
/// alone, as one: their rows one after another, or alternating between the
/// two where `paired`.
/// `w` on the device: a float or bool one in f32 words, a `u8` one four bytes
/// to a word, and an `i64` one as `kept_any` keeps it.
fn kept_plain(g: &mut WebGpuBackend, w: &HostWeight) -> Any<WebGpuBackend> with (GpuDevice, GpuQueue, GpuBuffer) {
    if w.kind matches { _::U8 } {
        let bytes = g.reserved_bytes(w.extents, true);
        g.write_linear(bytes.slot, 0, w.bytes());
        return Any::U8(Placed::Device(bytes));
    }
    if w.kind matches { _::I64 | _::I32 } {
        return kept_any(g, &w.decoded());
    }
    return of_kind(g, w.kind, Placed::Device(g.kept_values(w)));
}

/// The weights at `run`, which `load` reads, of one kind and differing in
/// extents along the first axis alone, as one: their rows one after another,
/// or alternating between the two of a pair. Each is read and laid in turn, so
/// one weight is held beside the result. Also each weight's rows.
fn rows_laid<Er>(
    run: &List<i32>,
    paired: bool,
    load: fn(i32) -> Result<HostWeight, Er> with _,
) -> Result<[HostWeight, List<i32>], Er> with _ {
    let first = load(run[0])?;
    let [kind, mut extents, size] = [first.kind, first.extents, first.bytes().len()];
    let mut head = Option::Some(first);
    assert !paired || run.len() == 2, "a pair is of two weights";
    let row = stored_bytes(kind, &extents[1..<extents.len()].to_list());
    let mut bytes = LinearArray::<u8>::filled(if paired { 2 * size } else { 0 }, 0);
    let mut rows: List<i32> = [];
    for let [j, at] of run.into_iter().enumerate() {
        let part = match head.take() {
            Some(h) => h,
            null => load(*at)?,
        };
        if paired {
            assert part.extents == extents, "a pair's weights are of one shape";
            for let r of 0..<part.extents[0] {
                bytes.copy_from((2 * r + j) * row, part.bytes(), r * row, row);
            }
        } else {
            let end = bytes.len();
            bytes.lengthen(end + part.bytes().len());
            bytes.copy_from(end, part.bytes(), 0, part.bytes().len());
        }
        rows.push(part.extents[0]);
    }
    extents[0] = rows.into_iter().sum().unwrap();
    return Result::Ok([HostWeight::stored(kind, extents, bytes), rows]);
}

fn contracted_axis(recorded: &Recorded, weight: i32) -> Option<i32> {
    let extents = &recorded.nodes[weight].extents;
    if extents.len() != 2
        || !recorded.nodes[weight].kind matches { _::F32 | _::F16 | _::BF16 }
        || recorded.body.results.contains(&weight) {
        return null;
    }
    let mut axis: Option<i32> = null;
    for let node of &recorded.nodes {
        if !node.operands.contains(&weight) {
            continue;
        }
        let read = match node.op {
            DotGeneral(dims) && node.operands[0] != weight
                && dims.rhs_contracting.len() == 1
                && dims.rhs_batch.is_empty() => dims.rhs_contracting[0],
            Gather(dims) && node.operands[0] == weight
                && taken_axis(extents, &recorded.nodes[node.operands[1]].extents, &dims) == Option::Some(0) => 1,
            _ => {
                return null;
            },
        };
        if axis matches { Some(a) && a != read } {
            return null;
        }
        axis = Option::Some(read);
    }
    return axis;
}

/// The extents a product of `l` by `r` computes before its result takes the
/// axes `dims` says: the batch axes, then the left operand's free axes as one,
/// then the right's.
fn product_extents(l: &List<i32>, r: &List<i32>, dims: &DotDims) -> List<i32> {
    let mut extents = picked(l, &dims.lhs_batch);
    extents.push(product_of(l, &free_axes(l.len(), &dims.lhs_batch, &dims.lhs_contracting)));
    extents.push(product_of(r, &free_axes(r.len(), &dims.rhs_batch, &dims.rhs_contracting)));
    return extents;
}

/// `l` by `r` as `dims` contracts them, then `then` over the product: one
/// product of `[batch…, rows, inner]` by `[batch…, inner, columns]`, each
/// operand's free and contracting axes merged by a view where its strides
/// allow one, and by a copy otherwise. `then`'s operands are of the product's
/// `product_extents`.
fn dotted(
    g: &mut WebGpuBackend,
    l: &DeviceTensor,
    r: &DeviceTensor,
    dims: &DotDims,
    then: &Option<Epilogue<PlacedRead<Untyped>>>,
) -> Placed<f32, Untyped> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let extents = dot_extents(&l.extents, &r.extents, dims);
    let l_free = free_axes(l.extents.len(), &dims.lhs_batch, &dims.lhs_contracting);
    let r_free = free_axes(r.extents.len(), &dims.rhs_batch, &dims.rhs_contracting);
    let batch = picked(&l.extents, &dims.lhs_batch);
    let [rows, inner, columns] = [
        product_of(&l.extents, &l_free),
        product_of(&l.extents, &dims.lhs_contracting),
        product_of(&r.extents, &r_free),
    ];
    let merged = |view: &DeviceTensor, order: List<List<i32>>, tail: [i32, i32]| -> DeviceTensor {
        let mut perm: List<i32> = [];
        for let part of order {
            perm.extend(&part);
        }
        let mut shape = batch;
        shape.push(tail.0);
        shape.push(tail.1);
        return g.reshaped(&permuted(view, &perm), &shape);
    };
    let left = merged(l, [dims.lhs_batch, l_free, dims.lhs_contracting], [rows, inner]);
    let right = merged(r, [dims.rhs_batch, dims.rhs_contracting, r_free], [inner, columns]);
    let product = g.product::<Untyped, Untyped, Untyped>(
        &Placed::<f32, Untyped>::Device(left),
        &Placed::<f32, Untyped>::Device(right),
        then,
    );
    return match product {
        Device(d) => Placed::Device(g.reshaped(&d, &extents)),
        Host(h) => hosted(g.cpu.reshape(&CpuTensor::Value(h), extents)),
    };
}

/// What `plan` yields, each of its launches run in turn into `state`.
fn launched(
    g: &mut WebGpuBackend,
    state: &mut Run<WebGpuBackend>,
    program: &WebGpuProgram,
    plan: &Plan,
) -> List<Any<WebGpuBackend>> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let recorded = &program.recorded;
    for let launch of &plan.launches {
        let root = match launch {
            Node(id) | Case([id, _, _]) | Repeat([id, _]) => *id,
            Kernel(k) => k.root,
            Joined(ks) => ks[0].root,
            Paired(p) => p.second.root,
        };
        g.launching(program.serial, root);
        match launch {
            Node(id) => state.ran(g, *id, &recorded.nodes[*id]),
            Kernel(k) => rooted(
                g,
                &mut state.values,
                root,
                &program.replays[root],
                recorded.nodes[root].kind,
                || kernel_result(g, &state.values, recorded, k),
            ),
            Joined(ks) => {
                let values = match joined_replayed(g, &state.values, program, ks) {
                    Some(vs) => vs,
                    null => apart(g, &mut state.values, program, ks),
                };
                for let [at, k] of ks.into_iter().enumerate() {
                    state.values[k.root] = values[at];
                }
            },
            Paired(p) => rooted(
                g,
                &mut state.values,
                root,
                &program.replays[root],
                recorded.nodes[root].kind,
                || paired_result(g, &state.values, recorded, p),
            ),
            Case([id, first, second]) => {
                let pred = *bools(&state.values[recorded.nodes[*id].operands[0]]);
                let yielded = g.conditional::<Untyped, List<Any<WebGpuBackend>>>(
                    &pred,
                    || launched(g, state, program, first),
                    || launched(g, state, program, second),
                );
                for let [k, result] of first.results.into_iter().enumerate() {
                    state.values[result] = yielded[k];
                }
            },
            Repeat([id, body]) => repeated_launch(g, state, program, *id, body),
        }
    }
    return plan.results.into_iter().map(|r| state.values[r]).collect();
}

/// Runs the `Repeat` node `id`'s `body` its count of times, each run's commands
/// after the last's: one pass, read back from no more than the count. A launch
/// makes the buffers of its next run in those of its last, so what the runs
/// carry leaves those, but for a cache, which each run writes in place.
fn repeated_launch(
    g: &mut WebGpuBackend,
    state: &mut Run<WebGpuBackend>,
    program: &WebGpuProgram,
    id: i32,
    body: &Plan,
) with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let node = &program.recorded.nodes[id];
    let Repeat(repeat) = &node.op else {
        unreachable();
    };
    let I64(count) = &state.values[node.operands[0]] else {
        unreachable();
    };
    let mut carried: List<Any<WebGpuBackend>> = carried_starts(node).into_iter().map(|o| state.values[o]).collect();
    for let at of 0..<g.host(count).data[0] {
        state.values[repeat.step] = Any::I64(g.relabeled::<i64, [], Untyped>(&scalar(g, at)));
        for let [k, c] of repeat.carried.into_iter().enumerate() {
            state.values[c] = carried[k];
        }
        let returned = launched(g, state, program, body);
        carried = returned.into_iter().map(|value| match on_device(&value) {
            Some(d) && g.remade(d.slot) => viewing(&value, g.moved_to_pass(d)),
            _ => value,
        }).collect();
    }
    for let [k, result] of repeat.body.results.into_iter().enumerate() {
        state.values[result] = carried[k];
    }
}

/// What every shape class of one graph records alike: each node's operation,
/// without its attributes, and the nodes it reads, and the body's results.
fn structure_of(recorded: &Recorded) -> List<i32> {
    let mut structure: List<i32> = [];
    for let node of &recorded.nodes {
        structure.push(ReflectVariant::<Operation>::discriminant(&node.op));
        structure.push(node.operands.len());
        structure.extend(&node.operands);
    }
    structure.extend(&recorded.body.results);
    return structure;
}

/// Adds how each launch of kernels of `plan`, a plan of the program `serial`,
/// or of a branch within it, replays to `replays`, by the root `launched`
/// starts it by.
fn keyed(g: &mut WebGpuBackend, recorded: &Recorded, serial: i32, plan: &Plan, replays: &mut HashMap<i32, Replay>) {
    for let launch of &plan.launches {
        match launch {
            Node(_) => {
            },
            Kernel(k) => {
                replays[k.root] = kernel_replay(g, recorded, serial, k);
            },
            Joined(ks) => {
                let all: List<&Kernel> = ks.into_iter().collect();
                replays[ks[0].root] = Replay {
                    key: signed(g, recorded, serial, &all),
                    reads: left_reads(recorded, &ks[0]),
                };
            },
            Paired(p) => {
                let both = [&p.first, &p.second] as List<&Kernel>;
                let mut reads = left_reads(recorded, &p.first);
                for let k of both {
                    reads.extend(&weights_of(&recorded.nodes[k.product.unwrap()]));
                }
                for let o of &p.operands {
                    reads.push(o.node);
                }
                replays[p.second.root] = Replay { key: signed(g, recorded, serial, &both), reads };
            },
            Case([_, first, second]) => {
                keyed(g, recorded, serial, first, replays);
                keyed(g, recorded, serial, second, replays);
            },
            Repeat([_, body]) => keyed(g, recorded, serial, body, replays),
        }
    }
}

/// How `k` alone replays, in the program `serial`.
fn kernel_replay(g: &mut WebGpuBackend, recorded: &Recorded, serial: i32, k: &Kernel) -> Replay {
    return Replay {
        key: signed(g, recorded, serial, &([k] as List<&Kernel>)),
        reads: k.reads(recorded),
    };
}

/// The `replay_key` of the kernels `ks` of the program `serial`.
fn signed(g: &mut WebGpuBackend, recorded: &Recorded, serial: i32, ks: &List<&Kernel>) -> i32 {
    let mut key = [serial] as List<i32>;
    for let k of *ks {
        key.push(k.root);
        key.push(g.signature(kernel_signature(recorded, k)));
    }
    return g.replay_key(key);
}

/// What `kernel_result` reads of `k` and `recorded` beside the views of the
/// nodes it reads, each list after its length.
fn kernel_signature(recorded: &Recorded, k: &Kernel) -> List<i32> {
    let mut s = [k.op.steps.len()] as List<i32>;
    for let step of &k.op.steps {
        let [a, b, c, d] = step.key();
        s.push(a);
        s.push(b);
        s.push(c);
        s.push(d);
    }
    let list = |into: &mut List<i32>, l: &List<i32>| {
        into.push(l.len());
        into.extend(l);
    };
    s.push(k.operands.len());
    for let o of &k.operands {
        list(&mut s, &o.extents);
    }
    list(&mut s, &k.extents);
    s.push(if k.reduced { 1 } else { 0 });
    let root = &recorded.nodes[k.root];
    list(&mut s, &root.extents);
    s.push(ReflectEnum::<ElementKind>::discriminant(&root.kind));
    if let Some(p) = k.product {
        match recorded.nodes[p].op {
            DotGeneral(dims) => {
                s.push(1);
                for let axes of [dims.lhs_batch, dims.rhs_batch, dims.lhs_contracting, dims.rhs_contracting] as List<List<i32>> {
                    list(&mut s, &axes);
                }
            },
            QuantizedProduct(q) => {
                s.push(3);
                s.push(q.quantized.bits);
                s.push(q.quantized.block);
                s.push(if q.zero_points { 1 } else { 0 });
            },
            _ => unreachable(),
        }
    }
    if let Some(p) = &k.prologue {
        s.push(2);
        s.extend(&kernel_signature(recorded, p));
    }
    return s;
}

/// How the product `k` computes contracts.
fn product_dims(recorded: &Recorded, k: &Kernel) -> DotDims {
    let DotGeneral(dims) = recorded.nodes[k.product.unwrap()].op else {
        unreachable();
    };
    return dims;
}

/// Gives `root`, a node of `kind`, its value: the commands the backend
/// recorded as `replay` says replayed where they were recorded over views laid
/// out as the ones it reads are now, what `computed` yields otherwise,
/// recorded. A replay's value is fresh, so it moves into `values` without a
/// copy.
fn rooted(
    g: &mut WebGpuBackend,
    values: &mut Values<WebGpuBackend>,
    root: i32,
    replay: &Replay,
    kind: ElementKind,
    computed: fn() -> Any<WebGpuBackend> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder),
) with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let Some(views) = device_reads(values, &replay.reads) else {
        let value = computed();
        values[root] = value;
        return;
    };
    if let Some(out) = g.replayed(replay.key, &views) {
        values[root] = of_kind(g, kind, Placed::Device(out));
        return;
    }
    g.tape();
    let value = computed();
    g.taped(replay.key, &views, on_device(&value), []);
    values[root] = value;
}

/// The nodes a product kernel `k` reads for its left matrix: its prologue's,
/// or the matrix.
fn left_reads(recorded: &Recorded, k: &Kernel) -> List<i32> {
    return match k.prologue {
        Some(p) => p.reads(recorded),
        null => [recorded.nodes[k.product.unwrap()].operands[0]],
    };
}

/// The values of the roots of `ks`, a `Joined` launch, each kernel launched
/// on its own, after their prologue once.
fn apart(
    g: &mut WebGpuBackend,
    values: &mut Values<WebGpuBackend>,
    program: &WebGpuProgram,
    ks: &List<Kernel>,
) -> List<Any<WebGpuBackend>> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let recorded = &program.recorded;
    let alone = |k: &Kernel| rooted(
        g,
        values,
        k.root,
        &kernel_replay(g, recorded, program.serial, k),
        recorded.nodes[k.root].kind,
        || kernel_result(g, values, recorded, k),
    );
    if let Some(p) = ks[0].prologue {
        alone(&p);
    }
    let mut out: List<Any<WebGpuBackend>> = [];
    for let k of ks {
        alone(&Kernel { ..*k, prologue: null });
        out.push(values[k.root]);
    }
    return out;
}

/// The view `value` is, where it is on the device.
fn on_device(value: &Any<WebGpuBackend>) -> Option<&DeviceTensor> {
    return match value {
        F32(Device(d)) | F16(Device(d)) | BF16(Device(d)) | U8(Device(d)) | I64(Device(d)) | I32(Device(d)) | Bool(Device(d)) => Option::Some(
            d,
        ),
        _ => null,
    };
}

/// `value`, a view on the device, of the buffer at `slot`.
fn at_slot(value: &Any<WebGpuBackend>, slot: i32) -> Any<WebGpuBackend> {
    return viewing(value, DeviceTensor { ..*on_device(value).unwrap(), slot });
}

/// `view`, of `value`'s element.
fn viewing(value: &Any<WebGpuBackend>, view: DeviceTensor) -> Any<WebGpuBackend> {
    return match value {
        F32(_) => Any::F32(Placed::Device(view)),
        F16(_) => Any::F16(Placed::Device(view)),
        BF16(_) => Any::BF16(Placed::Device(view)),
        U8(_) => Any::U8(Placed::Device(view)),
        I64(_) => Any::I64(Placed::Device(view)),
        I32(_) => Any::I32(Placed::Device(view)),
        Bool(_) => Any::Bool(Placed::Device(view)),
    };
}

/// The values of the roots of `ks`, a `Joined` launch: one product by their
/// right matrices as one, each root a slice of it, where those lie side by
/// side on the device and the left matrix is there to compute. `None`
/// otherwise.
fn joined_replayed(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    program: &WebGpuProgram,
    ks: &List<Kernel>,
) -> Option<List<Any<WebGpuBackend>>> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let recorded = &program.recorded;
    let head = &ks[0];
    let first = &recorded.nodes[head.product.unwrap()];
    if let QuantizedProduct(q) = first.op {
        return joined_quantized(g, values, program, ks, &q);
    }
    let dims = product_dims(recorded, head);
    let free = 1 - dims.rhs_contracting[0];
    let mut rights: List<DeviceTensor> = [];
    for let k of ks {
        if let Some(d) = on_device(&values[recorded.nodes[k.product.unwrap()].operands[1]]) {
            rights.push(*d);
        }
    }
    let joined = if rights.len() == ks.len() { side_by_side(&rights, free) } else { null };
    let replay = &program.replays[head.root];
    let [Some(left), Some(r)] = [device_reads(values, &replay.reads), joined] else {
        return null;
    };
    let mut views = left;
    views.push(&r);
    let extents = dot_extents(&recorded.nodes[first.operands[0]].extents, &r.extents, &dims);
    let key = replay.key;
    let product = match g.replayed(key, &views) {
        Some(out) => Placed::<f32, Untyped>::Device(out),
        null => {
            g.tape();
            // Every product of the run is stored as the head's is.
            let then = Option::Some(Epilogue { operands: [], op: head.op });
            let computed = if head.prologue matches { Some(_) } {
                let matrix = permuted(&r, &([dims.rhs_contracting[0], free] as List<i32>));
                g.reshape::<f32, Untyped, Untyped>(&left_product(g, values, recorded, head, &matrix, &then), extents);
            } else {
                dotted(g, left[0], &r, &dims, &then);
            };
            g.taped(key, &views, if let Device(d) = &computed {
                Option::Some(d);
            } else {
                null;
            }, []);
            computed;
        },
    };
    let last = extents.len() - 1;
    let mut start = List::<i32>::filled(extents.len(), 0);
    let mut out: List<Any<WebGpuBackend>> = [];
    for let k of ks {
        let mut limit = extents;
        limit[last] = start[last] + rights[out.len()].extents[free];
        let part = g.slice::<f32, Untyped, Untyped>(&product, start, limit, List::<i32>::filled(extents.len(), 1));
        let root = &recorded.nodes[k.root];
        out.push(of_kind(g, root.kind, g.reshape::<f32, Untyped, Untyped>(&part, root.extents)));
        start[last] = limit[last];
    }
    return Option::Some(out);
}

/// What `joined_replayed` yields of `ks`, quantized products as `q` says: one
/// product by each of their weights as one, where those lie row after row on
/// the device, each root a slice of its columns.
fn joined_quantized(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    program: &WebGpuProgram,
    ks: &List<Kernel>,
    q: &QuantizedNode,
) -> Option<List<Any<WebGpuBackend>>> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let recorded = &program.recorded;
    let head = &ks[0];
    let node = &recorded.nodes[head.product.unwrap()];
    let mut weights: List<DeviceTensor> = [];
    for let i of 1..<node.operands.len() {
        let mut parts: List<DeviceTensor> = [];
        for let k of ks {
            parts.push(*on_device(&values[recorded.nodes[k.product.unwrap()].operands[i]])?);
        }
        weights.push(side_by_side(&parts, 0)?);
    }
    let replay = &program.replays[head.root];
    let left = device_reads(values, &replay.reads)?;
    let mut views = left;
    for let w of &weights {
        views.push(w);
    }
    let product = match g.replayed(replay.key, &views) {
        Some(out) => Placed::<f32, Untyped>::Device(out),
        null => {
            g.tape();
            let mut operands = [*left[0]] as List<DeviceTensor>;
            operands.extend(&weights);
            // Every product of the run is stored as the head's is.
            let computed = quantized_on(g, &operands, node.kind, q, &Epilogue { operands: [], op: head.op });
            g.taped(replay.key, &views, if let Device(d) = &computed {
                Option::Some(d);
            } else {
                null;
            }, []);
            computed;
        },
    };
    let extents = g.extents_of(&product);
    let mut start = 0;
    let mut out: List<Any<WebGpuBackend>> = [];
    for let k of ks {
        let columns = recorded.nodes[recorded.nodes[k.product.unwrap()].operands[1]].extents[0];
        let part = g.slice::<f32, Untyped, Untyped>(&product, [0, start], [extents[0], start + columns], [1, 1]);
        let root = &recorded.nodes[k.root];
        out.push(of_kind(g, root.kind, g.reshape::<f32, Untyped, Untyped>(&part, root.extents)));
        start += columns;
    }
    return Option::Some(out);
}

/// The matrices `parts` as one, side by side along the axis `along`, where
/// each starts in its buffer where the one before ends.
fn side_by_side(parts: &List<DeviceTensor>, along: i32) -> Option<DeviceTensor> {
    let mut joined = parts[0];
    for let p of parts[1..<parts.len()].to_list() {
        let mut extents = p.extents;
        extents[along] = joined.extents[along];
        let next = joined.offset + joined.extents[along] * joined.strides[along];
        if p.slot != joined.slot
            || p.packed != joined.packed
            || extents != joined.extents
            || !reads_as(&p, next, &joined.strides) {
            return null;
        }
        joined.extents[along] += p.extents[along];
    }
    return Option::Some(joined);
}

/// The views of the nodes `ids`, or `None` where one is on the host.
fn device_reads(values: &Values<WebGpuBackend>, ids: &List<i32>) -> Option<List<&DeviceTensor>> {
    let mut reads: List<&DeviceTensor> = [];
    for let id of *ids {
        reads.push(on_device(&values[id])?);
    }
    return Option::Some(reads);
}

/// The value of `k`'s root, each operand read at the extents it names.
fn kernel_result(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    recorded: &Recorded,
    k: &Kernel,
) -> Any<WebGpuBackend> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let grouped = match k.product {
        Some(p) => {
            let node = &recorded.nodes[p];
            let then = Epilogue {
                operands: epilogue_reads(g, values, recorded, p, &k.operands, &k.extents),
                op: k.op,
            };
            match node.op {
                QuantizedProduct(q) => quantized_result(g, values, node, &q, &then),
                DotGeneral(dims) => {
                    let then = Option::Some(then);
                    if k.prologue matches { Some(_) } {
                        left_product(g, values, recorded, k, &right_matrix(g, values, recorded, k), &then);
                    } else {
                        dotted(
                            g,
                            &view_of(g, values, node.operands[0]),
                            &view_of(g, values, node.operands[1]),
                            &dims,
                            &then,
                        );
                    }
                },
                _ => unreachable(),
            }
        },
        null => {
            let operands: List<DeviceTensor> = k.operands
                .into_iter()
                .map(|o| g.reshaped(
                    &view_of(g, values, o.node),
                    &o.extents,
                ))
                .collect();
            g.grouped::<Untyped>(&operands, k.extents, &k.op, k.reduced);
        },
    };
    let root = &recorded.nodes[k.root];
    return of_kind(g, root.kind, g.reshape::<f32, Untyped, Untyped>(&grouped, root.extents));
}

/// The quantized product `node` computes, of the element `E`, then `then`
/// over its `product_space`: in one dispatch where the backend's kernel binds
/// them, and as `Graph::quantized_product` computes it, then `then` on its
/// own, otherwise.
fn quantized_result(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    node: &RecordedNode,
    q: &QuantizedNode,
    then: &Epilogue<PlacedRead<Untyped>>,
) -> Placed<f32, Untyped> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    return quantized_on(g, &operands_of(g, values, node), node.kind, q, then);
}

/// The views of what `node` reads.
fn operands_of(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    node: &RecordedNode,
) -> List<DeviceTensor> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    return node.operands.into_iter().map(|o| view_of(g, values, o)).collect();
}

/// The quantized product of `operands`, the input and the weights `q` reads,
/// of the element `kind`, then `then` over its `[rows, columns]`: in one
/// dispatch where the backend's kernel binds them, and as
/// `Graph::quantized_product` computes it, then `then` on its own, otherwise.
fn quantized_on(
    g: &mut WebGpuBackend,
    operands: &List<DeviceTensor>,
    kind: ElementKind,
    q: &QuantizedNode,
    then: &Epilogue<PlacedRead<Untyped>>,
) -> Placed<f32, Untyped> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let mut rows = *operands;
    rows[0] = as_rows(g, &operands[0]);
    let half = HalfFloat::of(kind);
    let [bits, block] = [q.quantized.bits, q.quantized.block];
    if let Some(out) = g.quantized_product_kernel(&rows, bits, block, half, then, false) {
        return Placed::Device(out);
    }
    let product = match kind {
        _::F32 => quantized_apart::<f32>(g, &rows, q),
        _::F16 => quantized_apart::<f16>(g, &rows, q),
        _::BF16 => quantized_apart::<bf16>(g, &rows, q),
        _::U8 | _::I64 | _::I32 | _::Bool => unreachable(),
    };
    let mut computed = [as_rows(g, &product)] as List<DeviceTensor>;
    for let o of &then.operands {
        computed.push(o.view);
    }
    return g.fused_on(&computed, &then.op);
}

/// `Graph::quantized_product` of `operands`, the input as `[M, K]` and the
/// weights, of the element `E`.
fn quantized_apart<E: Float>(
    g: &mut WebGpuBackend,
    operands: &List<DeviceTensor>,
    q: &QuantizedNode,
) -> DeviceTensor with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let zero_points = if q.zero_points {
        Option::Some(Placed::<u8, [Untyped, Untyped]>::Device(operands[3]));
    } else {
        null;
    };
    let product = g.quantized_product::<E, Untyped, Untyped, Untyped, Untyped, Untyped, Untyped>(
        &Placed::<E, Untyped>::Device(operands[0]),
        &Placed::<u8, [Untyped, Untyped, Untyped]>::Device(operands[1]),
        &Placed::<E, [Untyped, Untyped]>::Device(operands[2]),
        optional(&zero_points),
        &q.quantized,
    );
    return g.device_view(&product);
}

/// The value of `p`'s second root: one product by both right matrices, where
/// they lie interleaved and the device runs it so, and one by each otherwise.
fn paired_result(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    recorded: &Recorded,
    p: &Pair,
) -> Any<WebGpuBackend> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let operands = epilogue_reads(g, values, recorded, p.second.product.unwrap(), &p.operands, &p.second.extents);
    if let QuantizedProduct(q) = recorded.nodes[p.first.product.unwrap()].op {
        let computed = paired_quantized(g, values, recorded, p, &q, &operands);
        let root = &recorded.nodes[p.second.root];
        return of_kind(g, root.kind, g.reshape::<f32, Untyped, Untyped>(&computed, root.extents));
    }
    let then = Option::Some(Epilogue { operands, op: p.op });
    let [b, c] = [
        right_matrix(g, values, recorded, &p.first),
        right_matrix(g, values, recorded, &p.second),
    ];
    let both = interleaved_view(&b, &c);
    let computed = product: {
        if let Some(bc) = both && let Some(out) = staged(g, values, recorded, &p.first, &bc, &then, true) {
            break product: out;
        }
        let left = left_matrix(g, values, recorded, &p.first);
        if let Some(bc) = both
            && let Some(out) = g.product_kernel::<Untyped, Untyped, Untyped>(&left, &Placed::Device(bc), &then, true) {
            break product: out;
        }
        // The first product joins the second's epilogue as its first operand.
        let first = g.product::<Untyped, Untyped, Untyped>(&left, &Placed::Device(b), &null);
        let mut reads = [
            PlacedRead { view: g.device_view(&first) },
        ] as List<PlacedRead<Untyped>>;
        reads.extend(&operands);
        let mut to = [1, 0] as List<i32>;
        for let i of 0..<operands.len() {
            to.push(i + 2);
        }
        g.product::<Untyped, Untyped, Untyped>(&left, &Placed::Device(c), &Option::Some(Epilogue {
            operands: reads,
            op: p.op.renumbered(&to),
        }));
    };
    let root = &recorded.nodes[p.second.root];
    return of_kind(g, root.kind, g.reshape::<f32, Untyped, Untyped>(&computed, root.extents));
}

/// What `paired_result` computes of `p`, quantized products as `q` says, with
/// `operands` its epilogue's: one product by both weights, where their rows
/// lie interleaved and the device runs it so, and one by each otherwise.
fn paired_quantized(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    recorded: &Recorded,
    p: &Pair,
    q: &QuantizedNode,
    operands: &List<PlacedRead<Untyped>>,
) -> Placed<f32, Untyped> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let [first, second] = [
        &recorded.nodes[p.first.product.unwrap()],
        &recorded.nodes[p.second.product.unwrap()],
    ];
    let [b, c] = [
        operands_of(g, values, first),
        operands_of(g, values, second),
    ];
    let mut both = [as_rows(g, &b[0])] as List<DeviceTensor>;
    for let i of 1..<b.len() {
        if let Some(rows) = interleaved_rows(&b[i], &c[i]) {
            both.push(rows);
        }
    }
    let half = HalfFloat::of(first.kind);
    let then = Epilogue { operands: *operands, op: p.op };
    if both.len() == b.len()
        && let Some(out) = g.quantized_product_kernel(&both, q.quantized.bits, q.quantized.block, half, &then, true) {
        return Placed::Device(out);
    }
    // The first product joins the second's epilogue as its first operand.
    let alone = quantized_on(g, &b, first.kind, q, &Epilogue { operands: [], op: operand(0) });
    let mut reads = [
        PlacedRead { view: g.device_view(&alone) },
    ] as List<PlacedRead<Untyped>>;
    reads.extend(operands);
    let mut to = [1, 0] as List<i32>;
    for let i of 0..<operands.len() {
        to.push(i + 2);
    }
    return quantized_on(g, &c, second.kind, q, &Epilogue { operands: reads, op: p.op.renumbered(&to) });
}

/// The weights `a` and `b`, of one shape, as one whose rows alternate between
/// theirs, where they lie so in one buffer.
fn interleaved_rows(a: &DeviceTensor, b: &DeviceTensor) -> Option<DeviceTensor> {
    let step = a.strides[0];
    if a.slot != b.slot
        || a.packed != b.packed
        || a.extents != b.extents
        || step % 2 != 0
        || !reads_as(b, a.offset + step / 2, &a.strides) {
        return null;
    }
    let mut extents = a.extents;
    extents[0] = 2 * extents[0];
    let mut strides = a.strides;
    strides[0] = step / 2;
    return Option::Some(DeviceTensor { ..*a, extents, strides });
}

/// The product of `k`'s left matrix, `[rows, inner]`, by `r`, `[inner,
/// columns]`, then `then` over operands of `[rows, columns]`: `k`'s prologue
/// computed row by row in the same dispatch where the device can, and on its
/// own before it otherwise.
fn left_product(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    recorded: &Recorded,
    k: &Kernel,
    r: &DeviceTensor,
    then: &Option<Epilogue<PlacedRead<Untyped>>>,
) -> Placed<f32, Untyped> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    if let Some(out) = staged(g, values, recorded, k, r, then, false) {
        return out;
    }
    return g.product::<Untyped, Untyped, Untyped>(&left_matrix(g, values, recorded, k), &Placed::Device(*r), then);
}

/// [`left_product`] as one dispatch computing `k`'s prologue, paired as
/// `WebGpuBackend::staged_product` pairs, or `None` where it cannot run so.
fn staged(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    recorded: &Recorded,
    k: &Kernel,
    r: &DeviceTensor,
    then: &Option<Epilogue<PlacedRead<Untyped>>>,
    paired: bool,
) -> Option<Placed<f32, Untyped>> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let Some(p) = k.prologue else {
        return null;
    };
    let operands = reads_over(g, values, &p.operands, &p.extents, &left_extents(recorded, k));
    return g.staged_product::<Untyped, Untyped, Untyped>(
        &Prologue { operands, op: p.op },
        &Placed::Device(*r),
        then,
        paired,
    );
}

/// `k`'s left matrix as `[rows, inner]`: its prologue's result, where it has
/// one.
fn left_matrix(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    recorded: &Recorded,
    k: &Kernel,
) -> Placed<f32, Untyped> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let left = match k.prologue {
        Some(p) => any_view(g, &kernel_result(g, values, recorded, &p)),
        null => view_of(g, values, recorded.nodes[k.product.unwrap()].operands[0]),
    };
    return Placed::Device(g.reshaped(&left, &left_extents(recorded, k)));
}

/// The extents of the left matrix of `k`'s product as `[rows, inner]`, its
/// last axis the one contracted.
fn left_extents(recorded: &Recorded, k: &Kernel) -> List<i32> {
    let e = &recorded.nodes[recorded.nodes[k.product.unwrap()].operands[0]].extents;
    let last = e.len() - 1;
    return [element_count(&e[0..<last].to_list()), e[last]];
}

/// The right matrix of `k`'s product as `[inner, columns]`.
fn right_matrix(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    recorded: &Recorded,
    k: &Kernel,
) -> DeviceTensor with (GpuDevice, GpuQueue, GpuBuffer) {
    let node = &recorded.nodes[k.product.unwrap()];
    let c = product_dims(recorded, k).rhs_contracting[0];
    return permuted(&view_of(g, values, node.operands[1]), &([c, 1 - c] as List<i32>));
}

/// The matrices `a` and `b`, each `[inner, columns]`, as one whose columns
/// alternate between theirs, where they lie so in one buffer.
fn interleaved_view(a: &DeviceTensor, b: &DeviceTensor) -> Option<DeviceTensor> {
    let step = a.strides[1];
    if a.slot != b.slot
        || a.packed != b.packed
        || a.extents != b.extents
        || step % 2 != 0
        || !reads_as(b, a.offset + step / 2, &a.strides) {
        return null;
    }
    return Option::Some(DeviceTensor {
        ..*a,
        extents: [a.extents[0], 2 * a.extents[1]],
        strides: [a.strides[0], step / 2],
    });
}

/// `operands`, of a kernel iterating `extents`, as the epilogue of the product
/// `product` reads them: over the product's own extents, each element where
/// the kernel's extents hold it.
fn epilogue_reads(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    recorded: &Recorded,
    product: i32,
    operands: &List<KernelOperand>,
    extents: &List<i32>,
) -> List<PlacedRead<Untyped>> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    return reads_over(g, values, operands, extents, &product_space(recorded, product));
}

/// The extents the product `product` computes before its result takes its
/// own: `product_extents` of a `DotGeneral`, and a quantized product's input
/// rows as one, by its columns.
fn product_space(recorded: &Recorded, product: i32) -> List<i32> {
    let node = &recorded.nodes[product];
    let lhs = &recorded.nodes[node.operands[0]].extents;
    return match node.op {
        DotGeneral(dims) => product_extents(lhs, &recorded.nodes[node.operands[1]].extents, &dims),
        QuantizedProduct(_) => {
            let last = lhs.len() - 1;
            [element_count(&lhs[0..<last].to_list()), node.extents[last]];
        },
        _ => unreachable(),
    };
}

/// `operands`, of a kernel iterating `extents`, read over `space`: each
/// element where the kernel's extents hold it, one per row of `space` where
/// the operand holds one per row of them.
fn reads_over(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    operands: &List<KernelOperand>,
    extents: &List<i32>,
    space: &List<i32>,
) -> List<PlacedRead<Untyped>> with (GpuDevice, GpuQueue, GpuBuffer) {
    let mut per_row = space[0..<space.len() - 1].to_list();
    per_row.push(1);
    return (*operands)
        .into_iter()
        .map(|o| PlacedRead::<Untyped> { view: g.reshaped(&view_of(g, values, o.node), if o.extents == *extents {
            space;
        } else {
            &per_row;
        }) })
        .collect();
}

/// The view of node `id`'s value on the device.
fn view_of(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    id: i32,
) -> DeviceTensor with (GpuDevice, GpuQueue, GpuBuffer) {
    return any_view(g, &values[id]);
}

fn any_view(g: &mut WebGpuBackend, value: &Any<WebGpuBackend>) -> DeviceTensor with (GpuDevice, GpuQueue, GpuBuffer) {
    return match value {
        F32(t) => g.device_view(t),
        F16(t) => g.device_view(t),
        BF16(t) => g.device_view(t),
        Bool(t) => g.device_view(t),
        U8(t) => g.device_view(t),
        I64(_) | I32(_) => unreachable(),
    };
}

/// A kernel's f32 result as the element `kind` its root computes.
fn of_kind(g: &mut WebGpuBackend, kind: ElementKind, computed: Placed<f32, Untyped>) -> Any<WebGpuBackend> {
    return match kind {
        _::F32 => Any::F32(computed),
        _::F16 => Any::F16(as_element(g, computed)),
        _::BF16 => Any::BF16(as_element(g, computed)),
        _::Bool => Any::Bool(as_element(g, computed)),
        _::U8 | _::I64 | _::I32 => unreachable(),
    };
}

/// Element `j` along the free axis of `w`'s row `i` along the axis `axis`
/// that products contract.
fn contracted_at(w: &HostWeight, axis: i32, i: i32, j: i32) -> f32 {
    return w.value(if axis == 0 { i * w.extents[1] + j } else { j * w.extents[1] + i });
}

/// `d`, a matrix kept as `[inner, free]`, under the extents of the weight whose
/// axis `axis` products contract.
fn oriented(d: DeviceTensor, axis: i32) -> DeviceTensor {
    return if axis == 0 { d } else { permuted(&d, &([1, 0] as List<i32>)) };
}

/// `op` over operands of one shape, as a StableHLO elementwise operation takes
/// them; the kernel would broadcast any other.
fn elementwise_on<Axes>(
    g: &mut WebGpuBackend,
    operands: &List<DeviceTensor>,
    op: &Expr,
) -> Placed<f32, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let _ = elementwise_extents(operands.into_iter().map(|o| o.extents).collect());
    return g.fused_on(operands, op);
}

/// Below this an i64 is exact in an f32, and so is the sum of two.
global INDEX_BOUND: i64 = 8388608;

/// Whether an operation that moves or picks `E`s runs on the device over `a`
/// and `b`: an `E` it holds, or an i64 one of them already holds as an f32, a
/// token a kernel ranked, where the other's values stay within [`INDEX_BOUND`].
fn held_as_f32<E: Element, A, B>(a: &Placed<E, A>, b: &Placed<E, B>) -> bool {
    let either_held = a matches { Device(_) } || b matches { Device(_) };
    return E::exact_in_f32() || either_held && within_index_bound(a) && within_index_bound(b);
}

fn within_index_bound<E: Element, Axes>(t: &Placed<E, Axes>) -> bool {
    let Host(h) = t else {
        return true;
    };
    return h.data.into_iter().all(|v| -INDEX_BOUND < v.cast_to::<i64>() < INDEX_BOUND);
}

/// An f32 result as the element `E` it computed, which the device holds as
/// an f32: a bool as 1.0 or 0.0.
fn as_element<E: Element, Axes>(g: &mut WebGpuBackend, t: Placed<f32, Axes>) -> Placed<E, Axes> {
    return match t {
        Device(d) => Placed::Device(d),
        Host(h) => hosted(g.cpu.convert(&CpuTensor::Value(h))),
    };
}


fn product_of(extents: &List<i32>, axes: &List<i32>) -> i32 {
    return element_count(&picked(extents, axes));
}

/// The axis a gather takes whole slices along, a position an index, where
/// `dims` says that and nothing else.
fn taken_axis(extents: &List<i32>, index_extents: &List<i32>, dims: &GatherDims) -> Option<i32> {
    let Some(taken) = taken_axes(extents, index_extents, dims) else {
        return null;
    };
    return if taken.count == 1 && taken.batch == index_extents.len() { Option::Some(taken.first) } else { null };
}

/// The adjacent axes a gather takes whole slices across, one position along
/// each, where `dims` says that and nothing else: the index's positions stand
/// where those axes were.
fn taken_axes(extents: &List<i32>, index_extents: &List<i32>, dims: &GatherDims) -> Option<TakenAxes> {
    let [collapsed, mapped] = [dims.collapsed_slice_dims, dims.start_index_map];
    let count = collapsed.len();
    let rank = index_extents.len();
    let implicit = dims.index_vector_dim == rank;
    let vectored = rank > 0 && dims.index_vector_dim == rank - 1 && index_extents[rank - 1] == count;
    if count == 0 || mapped != collapsed || !(implicit && count == 1 || vectored) {
        return null;
    }
    let first = collapsed[0];
    let mut whole = *extents;
    for let k of 0..<count {
        if collapsed[k] != first + k {
            return null;
        }
        whole[first + k] = 1;
    }
    let batch = if implicit { rank } else { rank - 1 };
    let mut offsets: List<i32> = (0..<first).collect();
    offsets.extend(&(first + batch..<extents.len() - count + batch).collect());
    if dims.slice_sizes != whole || dims.offset_dims != offsets {
        return null;
    }
    return Option::Some(TakenAxes { first, count, batch });
}

/// The run of adjacent axes a gather takes one position along each of, and
/// keeps every other axis whole: its first axis, how many, and the rank of the
/// index's positions, past which it holds one coordinate per axis.
struct TakenAxes {
    first: i32,
    count: i32,
    batch: i32,
}

/// Each update window a scatter writes: the part of `update` at each index,
/// and the part of `out` it lands on, cut where it reaches past `out`.
fn scatter_windows<I>(
    out: &DeviceTensor,
    update: &DeviceTensor,
    index: &Tensor<i64, I>,
    dims: &ScatterDims,
) -> List<[DeviceTensor, DeviceTensor]> {
    let rank = out.extents.len();
    let window_axes: List<i32> = (0..<rank).filter(|a| !dims.inserted_window_dims.contains(&a)).collect();
    let scatter_axes = kept_axes(update.extents.len(), &dims.update_window_dims);
    let vector = dims.index_vector_dim;
    let implicit = vector == index.extents.len();
    let count = if implicit { 1 } else { index.extents[vector] };
    let mut windows: List<[DeviceTensor, DeviceTensor]> = [];
    let positions = element_count(&picked(&update.extents, &scatter_axes));
    for let p of 0..<positions {
        // The position's coordinates along the update's scatter axes, which
        // are the index tensor's axes but for its index vector's.
        let mut at = List::<i32>::filled(scatter_axes.len(), 0);
        let mut rest = p;
        for let mut i = scatter_axes.len() - 1; i >= 0; i -= 1 {
            at[i] = rest % update.extents[scatter_axes[i]];
            rest /= update.extents[scatter_axes[i]];
        }
        let mut start = List::<i64>::filled(rank, 0);
        for let k of 0..<count {
            let mut coordinates = at;
            if !implicit {
                coordinates.insert(vector, k);
            }
            start[dims.scatter_dims_to_operand_dims[k]] = index.data[row_major_index(&index.extents, &coordinates)];
        }
        let mut from = DeviceTensor { ..*update, extents: [], strides: [] };
        for let i of 0..<scatter_axes.len() {
            from.offset += at[i] * update.strides[scatter_axes[i]];
        }
        let mut to = DeviceTensor { ..*out, extents: [], strides: [] };
        let mut empty = false;
        for let w of 0..<window_axes.len() {
            let [axis, u] = [window_axes[w], dims.update_window_dims[w]];
            let [lo, hi] = [
                i64::max(start[axis], 0),
                i64::min(start[axis] + update.extents[u] as i64, out.extents[axis] as i64),
            ];
            if lo >= hi {
                empty = true;
                break;
            }
            from.offset += (lo - start[axis]) as i32 * update.strides[u];
            from.extents.push((hi - lo) as i32);
            from.strides.push(update.strides[u]);
            to.offset += lo as i32 * out.strides[axis];
            to.extents.push((hi - lo) as i32);
            to.strides.push(out.strides[axis]);
        }
        for let axis of dims.inserted_window_dims {
            if start[axis] < 0 || start[axis] >= out.extents[axis] as i64 {
                empty = true;
            }
            to.offset += start[axis] as i32 * out.strides[axis];
        }
        if !empty {
            windows.push([from, to]);
        }
    }
    return windows;
}

fn row_major_index(extents: &List<i32>, coordinates: &List<i32>) -> i32 {
    let mut at = 0;
    for let a of 0..<extents.len() {
        at = at * extents[a] + coordinates[a];
    }
    return at;
}
