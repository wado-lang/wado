//! `WebGpuBackend` as a `Graph`: each operation computed as it is added, on
//! the device where a kernel of the backend computes it, and on the host
//! otherwise. An `i64` tensor stays on the host, as it does for the kernels,
//! but for the index a kernel ranks and what reckons with it, held as an f32.
//! A compiled program launches the kernels `fusion.wado` plans instead.

use { HashMap, HashSet } from "core:collections";
use {
    GpuDevice,
    GpuQueue,
    GpuCommandEncoder,
    GpuCommandBuffer,
    GpuBuffer,
    GpuBindGroupLayout,
    GpuBindGroup,
    GpuShaderModule,
    GpuComputePipeline,
    GpuComputePassEncoder,
} from "wasi:webgpu";
use {
    Binary,
    Comparison,
    Convolution,
    DotDims,
    GatherDims,
    Graph,
    ScatterDims,
    Slots,
    Unary,
    WindowReduce,
    broadcast_in_dim_extents,
    decomposed_attention,
    dot_extents,
    elementwise_extents,
    free_axes,
    gathered_extents,
    kept_axes,
    padded_with_zeros,
    picked,
    reduced_extents,
    scalar,
    sliced_extents,
} from "./hlo.wado";
use {
    Attention,
    BinaryOp,
    Cpu,
    Element,
    ElementKind,
    Epilogue,
    Expr,
    Holds,
    Prologue,
    RowOp,
    Tensor,
    constant,
    element_count,
    interleaved,
    operand,
    transpose2,
} from "./tensor.wado";
use {
    Kernel,
    KernelOperand,
    Pair,
    Plan,
    binary_op,
    compared_op,
    planned,
    replanned,
    splats_of,
    unary_of,
} from "./fusion.wado";
use {
    Any,
    Operation,
    Recorded,
    Recorder,
    Run,
    Untyped,
    Values,
    bools,
    carried_starts,
    constants,
    kept_any,
} from "./recorded.wado";
use { DeviceTensor, Placed, PlacedRead, WebGpuBackend, contiguous, permuted, reads_as, sliced } from "./webgpu.wado";

/// A pass recorded once per shape class and planned into kernels, which each
/// call launches, and the values of the nodes that read no argument, kept on
/// the device.
pub struct WebGpuProgram {
    recorded: Recorded,
    plan: Plan,
    /// What `plan` folds of the nodes that read no argument.
    splats: HashMap<i32, Option<f32>>,
    constants: HashMap<i32, Any<WebGpuBackend>>,
    /// What the backend keys this program's launches by: one serial for every
    /// program of one structure, each shape class of a graph, so a launch of a
    /// new class binds the buffers and parameters another class's made.
    serial: i32,
    /// How each launch of kernels replays, by the root `launched` starts it
    /// by.
    replays: HashMap<i32, Replay>,
}

/// What a launch's commands are recorded under, and the nodes whose views
/// they read. The key holds the signature of each kernel: what its commands
/// depend on beside those views, so a recording of one shape class replays in
/// another only where they agree.
struct Replay {
    key: i32,
    reads: List<i32>,
}

impl Graph for WebGpuBackend {
    type Program = WebGpuProgram;

    fn relabeled<E: Element, In, Out>(&self, t: &Placed<E, In>) -> Placed<E, Out> {
        return match t {
            Host(h) => Placed::Host(Tensor { data: h.data, extents: h.extents }),
            Device(d) => Placed::Device(*d),
        };
    }

    /// A program takes the plan of an earlier one of its structure where the
    /// extents let it. A constant is kept only where a launch reads it, so
    /// neither one only other constants read nor one a kernel writes in.
    fn compiled(
        &mut self,
        record: fn(&mut Recorder) -> Recorded with _,
        weights: &List<Any<WebGpuBackend>>,
        earlier: &List<&WebGpuProgram>,
    ) -> Option<WebGpuProgram> with _ {
        let recorded = record(&mut Recorder::new());
        let folded = constants(&recorded);
        let splats = splats_of(&folded);
        let serial = self.program_serial(structure_of(&recorded));
        let mut reused: Option<Plan> = null;
        for let p of *earlier {
            if p.serial == serial {
                reused = replanned(&p.recorded, &p.plan, &p.splats, &recorded, &splats);
                if reused matches { Some(_) } {
                    break;
                }
            }
        }
        let plan = match reused {
            Some(p) => p,
            None => planned(&recorded, &splats),
        };
        let mut kept = HashMap::<i32, Any<WebGpuBackend>>::new();
        for let id of plan.reads(&recorded) {
            if let Some(value) = folded.get(id) && !kept.contains_key(id) {
                kept[id] = kept_any(self, &value);
            }
        }
        let mut replays = HashMap::<i32, Replay>::new();
        keyed(self, &recorded, serial, &plan, &mut replays);
        return Option::Some(WebGpuProgram { recorded, plan, splats, constants: kept, serial, replays });
    }

    /// A weight read only as products' right matrix, or as a gather's rows, is
    /// kept as `kept_contracted` keeps one: column by column along the axis the
    /// products contract, in bf16 where that loses nothing. The weights of a
    /// `Joined` launch are kept so as one matrix, side by side, and those of a
    /// `Paired` one as one matrix whose columns alternate between theirs, each
    /// a view of it. Any other is kept as `keep` keeps it.
    fn kept_weights<Er>(
        &mut self,
        record: fn(&mut Recorder) -> Recorded with _,
        first: i32,
        count: i32,
        load: fn(i32) -> Result<Any<Cpu>, Er> with _,
    ) -> Result<List<Any<WebGpuBackend>>, Er> with _ {
        let recorded = record(&mut Recorder::new());
        let contracted = contracted_axes(&recorded, first, count);
        let mut kept = List::<Option<Any<WebGpuBackend>>>::filled(count, null);
        for let [run, paired] of weight_runs(&recorded, first, count, &contracted) {
            let axis = contracted[run[0]].unwrap();
            let free = 1 - axis;
            let mut parts: List<Tensor<f32, Untyped>> = [];
            for let at of run {
                let F32(t) = load(at)? else {
                    unreachable();
                };
                parts.push(t);
            }
            if paired {
                // As `[inner, columns]`, which `interleaved` pairs.
                let matrix = |t: &Tensor<f32, Untyped>| {
                    let m = Tensor::<f32, [Untyped, Untyped]> { data: t.data, extents: t.extents };
                    return if axis == 0 { m } else { transpose2(&m) };
                };
                let both = interleaved(&matrix(&parts[0]), &matrix(&parts[1]));
                let Device(d) = self.kept_contracted(&both, 0) else {
                    unreachable();
                };
                for let [j, at] of run.into_iter().enumerate() {
                    let view = DeviceTensor {
                        ..d,
                        offset: d.offset + j * d.strides[1],
                        extents: [d.extents[0], d.extents[1] / 2],
                        strides: [d.strides[0], 2 * d.strides[1]],
                    };
                    kept[at] = Option::Some(Any::F32(Placed::Device(if axis == 0 {
                        view;
                    } else {
                        permuted(&view, &([1, 0] as List<i32>));
                    })));
                }
                continue;
            }
            let mut joined = parts[0];
            for let p of parts[1..<parts.len()].to_list() {
                joined = self.cpu.concatenate::<f32, Untyped, Untyped, Untyped>(&joined, &p, free);
            }
            let Device(d) = self.kept_contracted(&joined, axis) else {
                unreachable();
            };
            let mut start = 0;
            for let [at, p] of run.into_iter().zip(parts.into_iter()) {
                kept[at] = Option::Some(Any::F32(Placed::Device(sliced(&d, free, start, p.extents[free]))));
                start += p.extents[free];
            }
        }
        for let at of 0..<count {
            if kept[at] matches { Some(_) } {
                continue;
            }
            let host = load(at)?;
            kept[at] = Option::Some(if let Some(axis) = contracted[at] && let F32(t) = &host {
                Any::F32(self.kept_contracted(t, axis));
            } else {
                kept_any(self, &host);
            });
        }
        return Result::Ok(kept.into_iter().map(|k| k.unwrap()).collect());
    }

    fn executed(
        &mut self,
        program: &WebGpuProgram,
        arguments: &List<Any<WebGpuBackend>>,
        weights: &List<Any<WebGpuBackend>>,
    ) -> List<Any<WebGpuBackend>> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let mut state = Run::<WebGpuBackend>::new(&program.recorded, arguments, weights, &program.constants);
        let results = launched(self, &mut state, program, &program.plan);
        let mut returned: List<i32> = [];
        for let r of &results {
            if let Some(d) = on_device(r) {
                returned.push(d.slot);
            }
        }
        let moved = self.ran_program(program.serial, &returned);
        return results.into_iter().map(|r| match on_device(&r) {
            Some(d) && moved.contains_key(d.slot) => at_slot(&r, moved[d.slot]),
            _ => r,
        }).collect();
    }

    fn iota<E: Element, Axes>(&mut self, extents: List<i32>, dimension: i32) -> Placed<E, Axes> {
        return Placed::Host(self.cpu.iota(extents, dimension));
    }

    fn convert<A: Element, B: Element, Axes>(
        &mut self,
        x: &Placed<A, Axes>,
    ) -> Placed<B, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        if let Device(d) = x && !(A::is_f32() && B::kind() matches { I64 }) {
            // A device holds a bool, or an index a kernel ranked, as the f32 it
            // converts to.
            if !B::kind() matches { Bool } || A::kind() matches { Bool } {
                return Placed::Device(*d);
            }
            let nonzero = operand(0).binary(BinaryOp::Ne, &constant(0.0));
            return as_element(self, self.fused_on::<Axes>(&([*d] as List<DeviceTensor>), &nonzero));
        }
        return Placed::Host(self.cpu.convert(&self.host(x)));
    }

    fn unary<Axes>(
        &mut self,
        op: Unary,
        x: &Placed<f32, Axes>,
    ) -> Placed<f32, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        return self.fused_on(&([self.device_view(x)] as List<DeviceTensor>), &unary_of(op));
    }

    fn binary<E: Element, Axes>(
        &mut self,
        op: Binary,
        a: &Placed<E, Axes>,
        b: &Placed<E, Axes>,
    ) -> Placed<E, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        // On the device an `i64` is the index it holds as an f32, and those
        // four stay one: a product might not, and a quotient would not truncate.
        let index_reckoning = op matches { Add | Subtract | Minimum | Maximum } && held_as_f32(a, b);
        if !E::is_f32() && !index_reckoning {
            return Placed::Host(self.cpu.binary(op, &self.host(a), &self.host(b)));
        }
        let operands = [
            self.device_view(a),
            self.device_view(b),
        ] as List<DeviceTensor>;
        return as_element(self, elementwise_on::<Axes>(self, &operands, &operand(0).binary(binary_op(op), &operand(1))));
    }

    fn compare<E: Element, Axes>(
        &mut self,
        direction: Comparison,
        a: &Placed<E, Axes>,
        b: &Placed<E, Axes>,
    ) -> Placed<bool, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        if !held_as_f32(a, b) {
            return Placed::Host(self.cpu.compare(direction, &self.host(a), &self.host(b)));
        }
        let operands = [
            self.device_view(a),
            self.device_view(b),
        ] as List<DeviceTensor>;
        let held = operand(0).binary(compared_op(direction), &operand(1));
        return as_element(self, elementwise_on::<Axes>(self, &operands, &held));
    }

    fn select<E: Element, Axes>(
        &mut self,
        pred: &Placed<bool, Axes>,
        on_true: &Placed<E, Axes>,
        on_false: &Placed<E, Axes>,
    ) -> Placed<E, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        if !held_as_f32(on_true, on_false) {
            return Placed::Host(self.cpu.select(&self.host(pred), &self.host(on_true), &self.host(on_false)));
        }
        let operands = [
            self.device_view(pred),
            self.device_view(on_true),
            self.device_view(on_false),
        ] as List<DeviceTensor>;
        let chosen = operand(0).select(&operand(1), &operand(2));
        return as_element(self, elementwise_on::<Axes>(self, &operands, &chosen));
    }

    /// A view: each stretched axis reads its one element through a stride of 0.
    fn broadcast_in_dim<E: Element, In, Out>(
        &mut self,
        x: &Placed<E, In>,
        extents: List<i32>,
        dims: List<i32>,
    ) -> Placed<E, Out> {
        let Device(d) = x else {
            return Placed::Host(self.cpu.broadcast_in_dim(&self.host_only(x), extents, dims));
        };
        let extents = broadcast_in_dim_extents(&d.extents, extents, &dims);
        let mut strides = List::<i32>::filled(extents.len(), 0);
        for let [i, axis] of dims.into_iter().enumerate() {
            if d.extents[i] != 1 {
                strides[axis] = d.strides[i];
            }
        }
        return Placed::Device(DeviceTensor { ..*d, extents, strides });
    }

    fn reshape<E: Element, In, Out>(
        &mut self,
        x: &Placed<E, In>,
        extents: List<i32>,
    ) -> Placed<E, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let Device(d) = x else {
            return Placed::Host(self.cpu.reshape(&self.host_only(x), extents));
        };
        return Placed::Device(self.reshaped(d, &extents));
    }

    fn transpose<E: Element, In, Out>(&mut self, x: &Placed<E, In>, perm: List<i32>) -> Placed<E, Out> {
        let Device(d) = x else {
            return Placed::Host(self.cpu.transpose(&self.host_only(x), perm));
        };
        return Placed::Device(permuted(d, &perm));
    }

    /// A view: each axis from its start, its stride scaled by the step.
    fn slice<E: Element, In, Out>(
        &mut self,
        x: &Placed<E, In>,
        start: List<i32>,
        limit: List<i32>,
        strides: List<i32>,
    ) -> Placed<E, Out> {
        let Device(d) = x else {
            return Placed::Host(self.cpu.slice(&self.host_only(x), start, limit, strides));
        };
        let mut view = DeviceTensor { ..*d, extents: sliced_extents(&d.extents, &start, &limit, &strides) };
        for let a of 0..<start.len() {
            view.offset += start[a] * d.strides[a];
            view.strides[a] = d.strides[a] * strides[a];
        }
        return Placed::Device(view);
    }

    fn concatenate<E: Element, A, B, Out>(
        &mut self,
        a: &Placed<E, A>,
        b: &Placed<E, B>,
        dimension: i32,
    ) -> Placed<E, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        if !E::exact_in_f32() {
            return Placed::Host(self.cpu.concatenate(&self.host(a), &self.host(b), dimension));
        }
        return Placed::Device(self.joined(&self.device_view(a), &self.device_view(b), dimension));
    }

    /// A view over more of an attention cache's positions where it has room
    /// for them, and zeros joined on otherwise.
    fn grown<E: Element, Axes>(
        &mut self,
        x: &Placed<E, Axes>,
        axis: i32,
        extent: i32,
    ) -> Placed<E, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        if let Device(d) = x && let Some(widened) = self.widened_cache(d, axis, extent) {
            return Placed::Device(widened);
        }
        if !E::exact_in_f32() {
            return padded_with_zeros::<WebGpuBackend, E, Axes>(self, x, axis, extent);
        }
        let mut extents = self.extents_of(x);
        let own = extents[axis];
        extents[axis] = extent;
        let to = contiguous(self.allocated(element_count(&extents), false), 0, extents);
        if element_count(&self.extents_of(x)) > 0 {
            let from = self.device_view(x);
            self.copy(&from, &sliced(&to, axis, 0, own));
        }
        return Placed::Device(to);
    }

    /// The row kernel where `init` is the fold's identity, so the fold from it
    /// is the fold of the elements alone.
    fn reduce<In, Out>(
        &mut self,
        x: &Placed<f32, In>,
        op: Binary,
        init: f32,
        dims: List<i32>,
    ) -> Placed<f32, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let fold = match op {
            Add && init.to_bits() == 0 => Option::Some(operand(0).row_sum(null)),
            Maximum && init == f32::NEG_INFINITY => Option::Some(operand(0).row(RowOp::Max)),
            _ => null,
        };
        let view = self.device_view(x);
        if let Some(e) = fold && let Some(kept) = self.reduced(&view, &dims, &e) {
            return Placed::Device(self.reshaped(&kept, &reduced_extents(&view.extents, &dims)));
        }
        return Placed::Host(self.cpu.reduce(&self.host(x), op, init, dims));
    }

    /// One product of `[batch…, rows, inner]` by `[batch…, inner, columns]`,
    /// each operand's free and contracting axes merged by a view where its
    /// strides allow one, and by a copy otherwise.
    fn dot_general<A, B, Out>(
        &mut self,
        lhs: &Placed<f32, A>,
        rhs: &Placed<f32, B>,
        dims: &DotDims,
    ) -> Placed<f32, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let [l, r] = [
            self.device_view(lhs),
            self.device_view(rhs),
        ];
        return self.relabeled(&dotted(self, &l, &r, dims, &null));
    }

    /// The gather kernel where the gather takes whole slices along one axis,
    /// each index clamped into it as StableHLO clamps a start.
    fn gather<E: Element, D, I, Out>(
        &mut self,
        data: &Placed<E, D>,
        indices: &Placed<i64, I>,
        dims: &GatherDims,
    ) -> Placed<E, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let extents = self.extents_of(data);
        if let Device(by) = indices
            && E::exact_in_f32()
            && let Some(axis) = taken_axis(&extents, &by.extents, dims)
            && let Some(out) = self.gathered_by(
                &self.device_view(data),
                by,
                axis,
                &gathered_extents(&by.extents, dims),
            ) {
            return Placed::Device(out);
        }
        let index = self.host(indices);
        if E::exact_in_f32()
            && let Some(TakenAxes { first, count, batch }) = taken_axes(&extents, &index.extents, dims) {
            // The axes taken merge into one, which each index's flat position
            // along them takes.
            let mut starts = List::<i64>::with_capacity(index.data.len() / count);
            for let at of 0..<index.data.len() / count {
                let mut flat: i64 = 0;
                for let k of 0..<count {
                    let along = extents[first + k] as i64;
                    flat = flat * along + i64::clamp(index.data[at * count + k], 0, along - 1);
                }
                starts.push(flat);
            }
            let clamped = Tensor::<i64, I> {
                data: starts,
                extents: index.extents[0..<batch].to_list(),
            };
            let mut merged = extents[0..<first].to_list();
            merged.push(element_count(&extents[first..<first + count].to_list()));
            merged.extend(&extents[first + count..<extents.len()].to_list());
            let view = self.device_view(data);
            if let Some(out) = self.gathered(&self.reshaped(&view, &merged), &clamped, first) {
                assert out.extents == gathered_extents(&index.extents, dims);
                return Placed::Device(out);
            }
        }
        return Placed::Host(self.cpu.gather(&self.host(data), &index, dims));
    }

    /// A copy of the operand, then each update window copied over it, cut to
    /// the operand where it reaches past it.
    fn scatter<E: Element, D, I, U>(
        &mut self,
        base: &Placed<E, D>,
        indices: &Placed<i64, I>,
        updates: &Placed<E, U>,
        dims: &ScatterDims,
    ) -> Placed<E, D> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let index = self.host(indices);
        if !held_as_f32(base, updates) {
            return Placed::Host(self.cpu.scatter(&self.host(base), &index, &self.host(updates), dims));
        }
        let source = self.device_view(base);
        let update = self.device_view(updates);
        let out = contiguous(self.allocated(element_count(&source.extents), false), 0, source.extents);
        self.copy(&source, &out);
        for let [from, to] of scatter_windows(&out, &update, &index, dims) {
            self.copy(&from, &to);
        }
        return Placed::Device(out);
    }

    fn convolution<In, K, Out>(
        &mut self,
        x: &Placed<f32, In>,
        kernel: &Placed<f32, K>,
        conv: &Convolution,
    ) -> Placed<f32, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        return Placed::Host(self.cpu.convolution(&self.host(x), &self.host(kernel), conv));
    }

    fn reduce_window<In, Out>(
        &mut self,
        x: &Placed<f32, In>,
        op: Binary,
        init: f32,
        window: &WindowReduce,
    ) -> Placed<f32, Out> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        return Placed::Host(self.cpu.reduce_window(&self.host(x), op, init, window));
    }

    /// A view: each reversed axis read from its last element back.
    fn reverse<E: Element, Axes>(&mut self, x: &Placed<E, Axes>, dims: List<i32>) -> Placed<E, Axes> {
        let Device(d) = x else {
            return Placed::Host(self.cpu.reverse(&self.host_only(x), dims));
        };
        let mut view = *d;
        for let a of dims {
            view.offset += (d.extents[a] - 1) * d.strides[a];
            view.strides[a] = -d.strides[a];
        }
        return Placed::Device(view);
    }

    fn arg_max<Axes>(
        &mut self,
        x: &Placed<f32, Axes>,
        axis: i32,
    ) -> Placed<i64, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        return self.arg_max_kernel(x, axis);
    }

    /// The branch the condition picks, which is read back from the device.
    fn conditional<Axes, T>(
        &mut self,
        pred: &Placed<bool, Axes>,
        then: fn() -> T with _,
        otherwise: fn() -> T with _,
    ) -> T with (_, GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let condition = self.host(pred);
        assert condition.data.len() == 1, "a condition is one element";
        return if condition.data[0] { then() } else { otherwise() };
    }

    /// The backend's attention kernels, and the decomposition where they
    /// cannot run it, rows of different lengths among those. A shared past
    /// holds `past_length` valid positions, the kernels attend over those and
    /// the new ones, or the first `reach` of them, as many columns of the bias,
    /// and the present is the past's buffer with the new ones written after the
    /// valid ones. Past the valid ones a causal attention reads none, so the
    /// kernels compute what the decomposition does.
    fn group_query_attention<B, S, Q, K, H, P, T, D, Pos, Half, BB, BH, BS>(
        &mut self,
        q: &Placed<f32, [B, S, Q]>,
        k: &Placed<f32, [B, S, K]>,
        v: &Placed<f32, [B, S, K]>,
        past_k: &Placed<f32, [B, H, P, D]>,
        past_v: &Placed<f32, [B, H, P, D]>,
        past_length: Option<&Placed<i64, [Slots]>>,
        reach: Option<&Placed<i64, [Slots]>>,
        cos: Option<&Placed<f32, [Pos, Half]>>,
        sin: Option<&Placed<f32, [Pos, Half]>>,
        bias: Option<&Placed<f32, [BB, BH, BS, T]>>,
        options: &Attention,
    ) -> [Placed<f32, [B, S, Q]>, Placed<f32, [B, H, T, D]>, Placed<f32, [B, H, T, D]>] with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
        let shared = past_length matches { Some(_) };
        kernels: {
            if shared && !options.causal {
                break kernels;
            }
            let positions = self.extents_of(past_k)[2];
            let fresh = self.extents_of(q)[1];
            let Some(valid) = one_length(self, past_length, positions) else {
                break kernels;
            };
            let Some(attended) = one_length(self, reach, valid + fresh) else {
                break kernels;
            };
            assert !shared || valid + fresh <= positions, "a shared past holds the new positions after its valid ones";
            let rotary = match [cos, sin] {
                [Some(c), Some(s)] => Option::Some([
                    self.device_view(c),
                    self.device_view(s),
                ]),
                _ => null,
            };
            let [held_k, held_v] = [
                self.device_view(past_k),
                self.device_view(past_v),
            ];
            let query = self.device_view(q);
            let biased = match bias {
                Some(b) => Option::Some(self.device_view(b)),
                None => null,
            };
            if let Some([out, present_k, present_v]) = self.attended(
                &query,
                &self.device_view(k),
                &self.device_view(v),
                &held_k,
                &held_v,
                valid,
                attended,
                shared,
                &rotary,
                &biased,
                options,
            ) {
                let span = |t: DeviceTensor| if shared { DeviceTensor { ..t, extents: held_k.extents } } else { t };
                return [
                    Placed::Device(out),
                    Placed::Device(span(present_k)),
                    Placed::Device(span(present_v)),
                ];
            }
        }
        return decomposed_attention::<WebGpuBackend, B, S, Q, K, H, P, T, D, Pos, Half, BB, BH, BS>(
            self,
            q,
            k,
            v,
            past_k,
            past_v,
            past_length,
            reach,
            cos,
            sin,
            bias,
            options,
        );
    }
}

/// The length every row of `length` holds, where they hold one, or `absent`
/// where there is none.
fn one_length(
    g: &mut WebGpuBackend,
    length: Option<&Placed<i64, [Slots]>>,
    absent: i32,
) -> Option<i32> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let Some(l) = length else {
        return Option::Some(absent);
    };
    let rows = g.host(l).data;
    for let row of &rows {
        if *row != rows[0] {
            return null;
        }
    }
    return Option::Some(rows[0] as i32);
}

/// For each of the `count` weights `recorded` takes from its parameter
/// `first` on, the axis the products reading it contract, where every node
/// reading it is a product taking it as its right matrix or a gather taking
/// its rows, and the pass returns none of them.
internal fn contracted_axes(recorded: &Recorded, first: i32, count: i32) -> List<Option<i32>> {
    let mut axes = List::<Option<i32>>::filled(count, null);
    for let [id, node] of recorded.nodes.into_iter().enumerate() {
        if let Parameter(p) = node.op && first <= p < first + count {
            axes[p - first] = contracted_axis(recorded, id);
        }
    }
    return axes;
}

/// The right matrices of each `Joined` and `Paired` launch `recorded` plans
/// into, by their places among the `count` weights it takes from its parameter
/// `first` on, and whether they pair: each run whose weights `contracted` keeps
/// along one axis, and which share none with a run before it.
fn weight_runs(recorded: &Recorded, first: i32, count: i32, contracted: &List<Option<i32>>) -> List<[List<i32>, bool]> {
    let mut taken = HashSet::<i32>::new();
    let mut runs: List<[List<i32>, bool]> = [];
    for let launch of planned(recorded, &splats_of(&constants(recorded))).flattened() {
        let [ks, paired] = match launch {
            Joined(ks) => [ks, false],
            Paired(p) => [[p.first, p.second] as List<Kernel>, true],
            _ => {
                continue;
            },
        };
        let run: List<i32> = ks.into_iter().map(
            |k| match recorded.nodes[recorded.nodes[k.product.unwrap()].operands[1]].op {
                Parameter(p) => p - first,
                _ => unreachable(),
            },
        ).collect();
        if !run.into_iter().all(|w| 0 <= w < count) {
            continue;
        }
        let axis = contracted[run[0]];
        let mut own = HashSet::<i32>::new();
        let kept_alike = run.into_iter().all(|w| contracted[w] == axis && !taken.contains(w) && own.insert(w));
        if axis matches { Some(_) } && kept_alike {
            for let w of run {
                taken.insert(w);
            }
            runs.push([run, paired]);
        }
    }
    return runs;
}

fn contracted_axis(recorded: &Recorded, weight: i32) -> Option<i32> {
    let extents = &recorded.nodes[weight].extents;
    if extents.len() != 2 || !recorded.nodes[weight].kind matches { F32 } || recorded.body.results.contains(&weight) {
        return null;
    }
    let mut axis: Option<i32> = null;
    for let node of &recorded.nodes {
        if !node.operands.contains(&weight) {
            continue;
        }
        let read = match node.op {
            DotGeneral(dims) && node.operands[0] != weight
                && dims.rhs_contracting.len() == 1
                && dims.rhs_batch.is_empty() => dims.rhs_contracting[0],
            Gather(dims) && node.operands[0] == weight
                && taken_axis(extents, &recorded.nodes[node.operands[1]].extents, &dims) == Option::Some(0) => 1,
            _ => {
                return null;
            },
        };
        if axis matches { Some(a) && a != read } {
            return null;
        }
        axis = Option::Some(read);
    }
    return axis;
}

/// The extents a product of `l` by `r` computes before its result takes the
/// axes `dims` says: the batch axes, then the left operand's free axes as one,
/// then the right's.
fn product_extents(l: &List<i32>, r: &List<i32>, dims: &DotDims) -> List<i32> {
    let mut extents = picked(l, &dims.lhs_batch);
    extents.push(product_of(l, &free_axes(l.len(), &dims.lhs_batch, &dims.lhs_contracting)));
    extents.push(product_of(r, &free_axes(r.len(), &dims.rhs_batch, &dims.rhs_contracting)));
    return extents;
}

/// `l` by `r` as `dims` contracts them, then `then` over the product: one
/// product of `[batch…, rows, inner]` by `[batch…, inner, columns]`, each
/// operand's free and contracting axes merged by a view where its strides
/// allow one, and by a copy otherwise. `then`'s operands are of the product's
/// `product_extents`.
fn dotted(
    g: &mut WebGpuBackend,
    l: &DeviceTensor,
    r: &DeviceTensor,
    dims: &DotDims,
    then: &Option<Epilogue<PlacedRead<Untyped>>>,
) -> Placed<f32, Untyped> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let extents = dot_extents(&l.extents, &r.extents, dims);
    let l_free = free_axes(l.extents.len(), &dims.lhs_batch, &dims.lhs_contracting);
    let r_free = free_axes(r.extents.len(), &dims.rhs_batch, &dims.rhs_contracting);
    let batch = picked(&l.extents, &dims.lhs_batch);
    let [rows, inner, columns] = [
        product_of(&l.extents, &l_free),
        product_of(&l.extents, &dims.lhs_contracting),
        product_of(&r.extents, &r_free),
    ];
    let merged = |view: &DeviceTensor, order: List<List<i32>>, tail: [i32, i32]| -> DeviceTensor {
        let mut perm: List<i32> = [];
        for let part of order {
            perm.extend(&part);
        }
        let mut shape = batch;
        shape.push(tail.0);
        shape.push(tail.1);
        return g.reshaped(&permuted(view, &perm), &shape);
    };
    let left = merged(l, [dims.lhs_batch, l_free, dims.lhs_contracting], [rows, inner]);
    let right = merged(r, [dims.rhs_batch, dims.rhs_contracting, r_free], [inner, columns]);
    let product = g.product::<Untyped, Untyped, Untyped>(
        &Placed::<f32, Untyped>::Device(left),
        &Placed::<f32, Untyped>::Device(right),
        then,
    );
    return match product {
        Device(d) => Placed::Device(g.reshaped(&d, &extents)),
        Host(h) => Placed::Host(g.cpu.reshape(&h, extents)),
    };
}

/// What `plan` yields, each of its launches run in turn into `state`.
fn launched(
    g: &mut WebGpuBackend,
    state: &mut Run<WebGpuBackend>,
    program: &WebGpuProgram,
    plan: &Plan,
) -> List<Any<WebGpuBackend>> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let recorded = &program.recorded;
    for let launch of &plan.launches {
        let root = match launch {
            Node(id) | Case([id, _, _]) | Repeat([id, _]) => *id,
            Kernel(k) => k.root,
            Joined(ks) => ks[0].root,
            Paired(p) => p.second.root,
        };
        g.launching(program.serial, root);
        match launch {
            Node(id) => state.ran(g, *id, &recorded.nodes[*id]),
            Kernel(k) => rooted(
                g,
                &mut state.values,
                root,
                &program.replays[root],
                recorded.nodes[root].kind,
                || kernel_result(g, &state.values, recorded, k),
            ),
            Joined(ks) => {
                let values = match joined_replayed(g, &state.values, program, ks) {
                    Some(vs) => vs,
                    None => apart(g, &mut state.values, program, ks),
                };
                for let [at, k] of ks.into_iter().enumerate() {
                    state.values[k.root] = values[at];
                }
            },
            Paired(p) => rooted(
                g,
                &mut state.values,
                root,
                &program.replays[root],
                recorded.nodes[root].kind,
                || paired_result(g, &state.values, recorded, p),
            ),
            Case([id, first, second]) => {
                let pred = *bools(&state.values[recorded.nodes[*id].operands[0]]);
                let yielded = g.conditional::<Untyped, List<Any<WebGpuBackend>>>(
                    &pred,
                    || launched(g, state, program, first),
                    || launched(g, state, program, second),
                );
                for let [k, result] of first.results.into_iter().enumerate() {
                    state.values[result] = yielded[k];
                }
            },
            Repeat([id, body]) => repeated_launch(g, state, program, *id, body),
        }
    }
    return plan.results.into_iter().map(|r| state.values[r]).collect();
}

/// Runs the `Repeat` node `id`'s `body` its count of times, each run's commands
/// after the last's: one pass, read back from no more than the count. A launch
/// makes the buffers of its next run in those of its last, so what the runs
/// carry leaves those, but for a cache, which each run writes in place.
fn repeated_launch(
    g: &mut WebGpuBackend,
    state: &mut Run<WebGpuBackend>,
    program: &WebGpuProgram,
    id: i32,
    body: &Plan,
) with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let node = &program.recorded.nodes[id];
    let Repeat(repeat) = &node.op else {
        unreachable();
    };
    let I64(count) = &state.values[node.operands[0]] else {
        unreachable();
    };
    let mut carried: List<Any<WebGpuBackend>> = carried_starts(node).into_iter().map(|o| state.values[o]).collect();
    for let at of 0..<g.host(count).data[0] {
        state.values[repeat.step] = Any::I64(g.relabeled::<i64, [], Untyped>(&scalar(g, at)));
        for let [k, c] of repeat.carried.into_iter().enumerate() {
            state.values[c] = carried[k];
        }
        let returned = launched(g, state, program, body);
        carried = returned.into_iter().map(|value| match on_device(&value) {
            Some(d) && g.remade(d.slot) => viewing(&value, g.moved_to_pass(d)),
            _ => value,
        }).collect();
    }
    for let [k, result] of repeat.body.results.into_iter().enumerate() {
        state.values[result] = carried[k];
    }
}

/// What every shape class of one graph records alike: each node's operation,
/// without its attributes, and the nodes it reads, and the body's results.
fn structure_of(recorded: &Recorded) -> List<i32> {
    let mut structure: List<i32> = [];
    for let node of &recorded.nodes {
        structure.push(ReflectVariant::<Operation>::discriminant(&node.op));
        structure.push(node.operands.len());
        structure.extend(&node.operands);
    }
    structure.extend(&recorded.body.results);
    return structure;
}

/// Adds how each launch of kernels of `plan`, a plan of the program `serial`,
/// or of a branch within it, replays to `replays`, by the root `launched`
/// starts it by.
fn keyed(g: &mut WebGpuBackend, recorded: &Recorded, serial: i32, plan: &Plan, replays: &mut HashMap<i32, Replay>) {
    for let launch of &plan.launches {
        match launch {
            Node(_) => {
            },
            Kernel(k) => {
                replays[k.root] = kernel_replay(g, recorded, serial, k);
            },
            Joined(ks) => {
                let all: List<&Kernel> = ks.into_iter().collect();
                replays[ks[0].root] = Replay {
                    key: signed(g, recorded, serial, &all),
                    reads: left_reads(recorded, &ks[0]),
                };
            },
            Paired(p) => {
                let both = [&p.first, &p.second] as List<&Kernel>;
                let mut reads = left_reads(recorded, &p.first);
                for let k of both {
                    reads.push(recorded.nodes[k.product.unwrap()].operands[1]);
                }
                for let o of &p.operands {
                    reads.push(o.node);
                }
                replays[p.second.root] = Replay { key: signed(g, recorded, serial, &both), reads };
            },
            Case([_, first, second]) => {
                keyed(g, recorded, serial, first, replays);
                keyed(g, recorded, serial, second, replays);
            },
            Repeat([_, body]) => keyed(g, recorded, serial, body, replays),
        }
    }
}

/// How `k` alone replays, in the program `serial`.
fn kernel_replay(g: &mut WebGpuBackend, recorded: &Recorded, serial: i32, k: &Kernel) -> Replay {
    return Replay {
        key: signed(g, recorded, serial, &([k] as List<&Kernel>)),
        reads: k.reads(recorded),
    };
}

/// The `replay_key` of the kernels `ks` of the program `serial`.
fn signed(g: &mut WebGpuBackend, recorded: &Recorded, serial: i32, ks: &List<&Kernel>) -> i32 {
    let mut key = [serial] as List<i32>;
    for let k of *ks {
        key.push(k.root);
        key.push(g.signature(kernel_signature(recorded, k)));
    }
    return g.replay_key(key);
}

/// What `kernel_result` reads of `k` and `recorded` beside the views of the
/// nodes it reads, each list after its length.
fn kernel_signature(recorded: &Recorded, k: &Kernel) -> List<i32> {
    let mut s = [k.op.steps.len()] as List<i32>;
    for let step of &k.op.steps {
        let [a, b, c, d] = step.key();
        s.push(a);
        s.push(b);
        s.push(c);
        s.push(d);
    }
    let list = |into: &mut List<i32>, l: &List<i32>| {
        into.push(l.len());
        into.extend(l);
    };
    s.push(k.operands.len());
    for let o of &k.operands {
        list(&mut s, &o.extents);
    }
    list(&mut s, &k.extents);
    s.push(if k.reduced { 1 } else { 0 });
    let root = &recorded.nodes[k.root];
    list(&mut s, &root.extents);
    s.push(ReflectEnum::<ElementKind>::discriminant(&root.kind));
    if k.product matches { Some(_) } {
        let dims = product_dims(recorded, k);
        s.push(1);
        for let axes of [dims.lhs_batch, dims.rhs_batch, dims.lhs_contracting, dims.rhs_contracting] as List<List<i32>> {
            list(&mut s, &axes);
        }
    }
    if let Some(p) = &k.prologue {
        s.push(2);
        s.extend(&kernel_signature(recorded, p));
    }
    return s;
}

/// How the product `k` computes contracts.
fn product_dims(recorded: &Recorded, k: &Kernel) -> DotDims {
    let DotGeneral(dims) = recorded.nodes[k.product.unwrap()].op else {
        unreachable();
    };
    return dims;
}

/// Gives `root`, a node of `kind`, its value: the commands the backend
/// recorded as `replay` says replayed where they were recorded over views laid
/// out as the ones it reads are now, what `computed` yields otherwise,
/// recorded. A replay's value is fresh, so it moves into `values` without a
/// copy.
fn rooted(
    g: &mut WebGpuBackend,
    values: &mut Values<WebGpuBackend>,
    root: i32,
    replay: &Replay,
    kind: ElementKind,
    computed: fn() -> Any<WebGpuBackend> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder),
) with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let Some(views) = device_reads(values, &replay.reads) else {
        let value = computed();
        values[root] = value;
        return;
    };
    if let Some(out) = g.replayed(replay.key, &views) {
        values[root] = of_kind(g, kind, Placed::Device(out));
        return;
    }
    g.tape();
    let value = computed();
    g.taped(replay.key, &views, on_device(&value), []);
    values[root] = value;
}

/// The nodes a product kernel `k` reads for its left matrix: its prologue's,
/// or the matrix.
fn left_reads(recorded: &Recorded, k: &Kernel) -> List<i32> {
    return match k.prologue {
        Some(p) => p.reads(recorded),
        None => [recorded.nodes[k.product.unwrap()].operands[0]],
    };
}

/// The values of the roots of `ks`, a `Joined` launch, each kernel launched
/// on its own, after their prologue once.
fn apart(
    g: &mut WebGpuBackend,
    values: &mut Values<WebGpuBackend>,
    program: &WebGpuProgram,
    ks: &List<Kernel>,
) -> List<Any<WebGpuBackend>> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let recorded = &program.recorded;
    let alone = |k: &Kernel| rooted(
        g,
        values,
        k.root,
        &kernel_replay(g, recorded, program.serial, k),
        recorded.nodes[k.root].kind,
        || kernel_result(g, values, recorded, k),
    );
    if let Some(p) = ks[0].prologue {
        alone(&p);
    }
    let mut out: List<Any<WebGpuBackend>> = [];
    for let k of ks {
        alone(&Kernel { ..*k, prologue: null });
        out.push(values[k.root]);
    }
    return out;
}

/// The view `value` is, where it is on the device.
fn on_device(value: &Any<WebGpuBackend>) -> Option<&DeviceTensor> {
    return match value {
        F32(Device(d)) | I64(Device(d)) | Bool(Device(d)) => Option::Some(d),
        _ => null,
    };
}

/// `value`, a view on the device, of the buffer at `slot`.
fn at_slot(value: &Any<WebGpuBackend>, slot: i32) -> Any<WebGpuBackend> {
    return viewing(value, DeviceTensor { ..*on_device(value).unwrap(), slot });
}

/// `view`, of `value`'s element.
fn viewing(value: &Any<WebGpuBackend>, view: DeviceTensor) -> Any<WebGpuBackend> {
    return match value {
        F32(_) => Any::F32(Placed::Device(view)),
        I64(_) => Any::I64(Placed::Device(view)),
        Bool(_) => Any::Bool(Placed::Device(view)),
    };
}

/// The values of the roots of `ks`, a `Joined` launch: one product by their
/// right matrices as one, each root a slice of it, where those lie side by
/// side on the device and the left matrix is there to compute. `None`
/// otherwise.
fn joined_replayed(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    program: &WebGpuProgram,
    ks: &List<Kernel>,
) -> Option<List<Any<WebGpuBackend>>> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let recorded = &program.recorded;
    let head = &ks[0];
    let first = &recorded.nodes[head.product.unwrap()];
    let dims = product_dims(recorded, head);
    let free = 1 - dims.rhs_contracting[0];
    let mut rights: List<DeviceTensor> = [];
    for let k of ks {
        if let Some(d) = on_device(&values[recorded.nodes[k.product.unwrap()].operands[1]]) {
            rights.push(*d);
        }
    }
    let joined = if rights.len() == ks.len() { side_by_side(&rights, free) } else { null };
    let replay = &program.replays[head.root];
    let [Some(left), Some(r)] = [device_reads(values, &replay.reads), joined] else {
        return null;
    };
    let mut views = left;
    views.push(&r);
    let extents = dot_extents(&recorded.nodes[first.operands[0]].extents, &r.extents, &dims);
    let key = replay.key;
    let product = match g.replayed(key, &views) {
        Some(out) => Placed::<f32, Untyped>::Device(out),
        None => {
            g.tape();
            let computed = if head.prologue matches { Some(_) } {
                let matrix = permuted(&r, &([dims.rhs_contracting[0], free] as List<i32>));
                g.reshape::<f32, Untyped, Untyped>(&left_product(g, values, recorded, head, &matrix, &null), extents);
            } else {
                dotted(g, left[0], &r, &dims, &null);
            };
            g.taped(key, &views, if let Device(d) = &computed {
                Option::Some(d);
            } else {
                null;
            }, []);
            computed;
        },
    };
    let last = extents.len() - 1;
    let mut start = List::<i32>::filled(extents.len(), 0);
    let mut out: List<Any<WebGpuBackend>> = [];
    for let k of ks {
        let mut limit = extents;
        limit[last] = start[last] + rights[out.len()].extents[free];
        let part = g.slice::<f32, Untyped, Untyped>(&product, start, limit, List::<i32>::filled(extents.len(), 1));
        out.push(Any::F32(g.reshape::<f32, Untyped, Untyped>(&part, recorded.nodes[k.root].extents)));
        start[last] = limit[last];
    }
    return Option::Some(out);
}

/// The matrices `parts` as one, side by side along the axis `along`, where
/// each starts in its buffer where the one before ends.
fn side_by_side(parts: &List<DeviceTensor>, along: i32) -> Option<DeviceTensor> {
    let mut joined = parts[0];
    for let p of parts[1..<parts.len()].to_list() {
        let mut extents = p.extents;
        extents[along] = joined.extents[along];
        let next = joined.offset + joined.extents[along] * joined.strides[along];
        if p.slot != joined.slot
            || p.half != joined.half
            || extents != joined.extents
            || !reads_as(&p, next, &joined.strides) {
            return null;
        }
        joined.extents[along] += p.extents[along];
    }
    return Option::Some(joined);
}

/// The views of the nodes `ids`, or `None` where one is on the host.
fn device_reads(values: &Values<WebGpuBackend>, ids: &List<i32>) -> Option<List<&DeviceTensor>> {
    let mut reads: List<&DeviceTensor> = [];
    for let id of *ids {
        reads.push(on_device(&values[id])?);
    }
    return Option::Some(reads);
}

/// The value of `k`'s root, each operand read at the extents it names.
fn kernel_result(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    recorded: &Recorded,
    k: &Kernel,
) -> Any<WebGpuBackend> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let grouped = match k.product {
        Some(p) => {
            let node = &recorded.nodes[p];
            let DotGeneral(dims) = node.op else {
                unreachable();
            };
            let then = Option::Some(Epilogue {
                operands: epilogue_reads(g, values, recorded, p, &k.operands, &k.extents),
                op: k.op,
            });
            if k.prologue matches { Some(_) } {
                left_product(g, values, recorded, k, &right_matrix(g, values, recorded, k), &then);
            } else {
                dotted(g, &view_of(g, values, node.operands[0]), &view_of(g, values, node.operands[1]), &dims, &then);
            }
        },
        None => {
            let operands: List<DeviceTensor> = k.operands.into_iter().map(|o| g.reshaped(
                &view_of(g, values, o.node),
                &o.extents,
            )).collect();
            g.grouped::<Untyped>(&operands, k.extents, &k.op, k.reduced);
        },
    };
    let root = &recorded.nodes[k.root];
    return of_kind(g, root.kind, g.reshape::<f32, Untyped, Untyped>(&grouped, root.extents));
}

/// The value of `p`'s second root: one product by both right matrices, where
/// they lie interleaved and the device runs it so, and one by each otherwise.
fn paired_result(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    recorded: &Recorded,
    p: &Pair,
) -> Any<WebGpuBackend> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let operands = epilogue_reads(g, values, recorded, p.second.product.unwrap(), &p.operands, &p.second.extents);
    let then = Option::Some(Epilogue { operands, op: p.op });
    let [b, c] = [
        right_matrix(g, values, recorded, &p.first),
        right_matrix(g, values, recorded, &p.second),
    ];
    let both = interleaved_view(&b, &c);
    let computed = product: {
        if let Some(bc) = both && let Some(out) = staged(g, values, recorded, &p.first, &bc, &then, true) {
            break product: out;
        }
        let left = left_matrix(g, values, recorded, &p.first);
        if let Some(bc) = both
            && let Some(out) = g.product_kernel::<Untyped, Untyped, Untyped>(&left, &Placed::Device(bc), &then, true) {
            break product: out;
        }
        // The first product joins the second's epilogue as its first operand.
        let first = g.product::<Untyped, Untyped, Untyped>(&left, &Placed::Device(b), &null);
        let mut reads = [
            PlacedRead { view: g.device_view(&first) },
        ] as List<PlacedRead<Untyped>>;
        reads.extend(&operands);
        let mut to = [1, 0] as List<i32>;
        for let i of 0..<operands.len() {
            to.push(i + 2);
        }
        g.product::<Untyped, Untyped, Untyped>(&left, &Placed::Device(c), &Option::Some(Epilogue {
            operands: reads,
            op: p.op.renumbered(&to),
        }));
    };
    let root = &recorded.nodes[p.second.root];
    return of_kind(g, root.kind, g.reshape::<f32, Untyped, Untyped>(&computed, root.extents));
}

/// The product of `k`'s left matrix, `[rows, inner]`, by `r`, `[inner,
/// columns]`, then `then` over operands of `[rows, columns]`: `k`'s prologue
/// computed row by row in the same dispatch where the device can, and on its
/// own before it otherwise.
fn left_product(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    recorded: &Recorded,
    k: &Kernel,
    r: &DeviceTensor,
    then: &Option<Epilogue<PlacedRead<Untyped>>>,
) -> Placed<f32, Untyped> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    if let Some(out) = staged(g, values, recorded, k, r, then, false) {
        return out;
    }
    return g.product::<Untyped, Untyped, Untyped>(&left_matrix(g, values, recorded, k), &Placed::Device(*r), then);
}

/// [`left_product`] as one dispatch computing `k`'s prologue, paired as
/// `WebGpuBackend::staged_product` pairs, or `None` where it cannot run so.
fn staged(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    recorded: &Recorded,
    k: &Kernel,
    r: &DeviceTensor,
    then: &Option<Epilogue<PlacedRead<Untyped>>>,
    paired: bool,
) -> Option<Placed<f32, Untyped>> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let Some(p) = k.prologue else {
        return null;
    };
    let operands = reads_over(g, values, &p.operands, &p.extents, &left_extents(recorded, k));
    return g.staged_product::<Untyped, Untyped, Untyped>(
        &Prologue { operands, op: p.op },
        &Placed::Device(*r),
        then,
        paired,
    );
}

/// `k`'s left matrix as `[rows, inner]`: its prologue's result, where it has
/// one.
fn left_matrix(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    recorded: &Recorded,
    k: &Kernel,
) -> Placed<f32, Untyped> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let left = match k.prologue {
        Some(p) => any_view(g, &kernel_result(g, values, recorded, &p)),
        None => view_of(g, values, recorded.nodes[k.product.unwrap()].operands[0]),
    };
    return Placed::Device(g.reshaped(&left, &left_extents(recorded, k)));
}

/// The extents of the left matrix of `k`'s product as `[rows, inner]`, its
/// last axis the one contracted.
fn left_extents(recorded: &Recorded, k: &Kernel) -> List<i32> {
    let e = &recorded.nodes[recorded.nodes[k.product.unwrap()].operands[0]].extents;
    let last = e.len() - 1;
    return [element_count(&e[0..<last].to_list()), e[last]];
}

/// The right matrix of `k`'s product as `[inner, columns]`.
fn right_matrix(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    recorded: &Recorded,
    k: &Kernel,
) -> DeviceTensor with (GpuDevice, GpuQueue, GpuBuffer) {
    let node = &recorded.nodes[k.product.unwrap()];
    let c = product_dims(recorded, k).rhs_contracting[0];
    return permuted(&view_of(g, values, node.operands[1]), &([c, 1 - c] as List<i32>));
}

/// The matrices `a` and `b`, each `[inner, columns]`, as one whose columns
/// alternate between theirs, where they lie so in one buffer.
fn interleaved_view(a: &DeviceTensor, b: &DeviceTensor) -> Option<DeviceTensor> {
    let step = a.strides[1];
    if a.slot != b.slot
        || a.half != b.half
        || a.extents != b.extents
        || step % 2 != 0
        || !reads_as(b, a.offset + step / 2, &a.strides) {
        return null;
    }
    return Option::Some(DeviceTensor {
        ..*a,
        extents: [a.extents[0], 2 * a.extents[1]],
        strides: [a.strides[0], step / 2],
    });
}

/// `operands`, of a kernel iterating `extents`, as the epilogue of the product
/// `product` reads them: over the product's own extents, each element where
/// the kernel's extents hold it.
fn epilogue_reads(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    recorded: &Recorded,
    product: i32,
    operands: &List<KernelOperand>,
    extents: &List<i32>,
) -> List<PlacedRead<Untyped>> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let node = &recorded.nodes[product];
    let DotGeneral(dims) = node.op else {
        unreachable();
    };
    let space = product_extents(
        &recorded.nodes[node.operands[0]].extents,
        &recorded.nodes[node.operands[1]].extents,
        &dims,
    );
    return reads_over(g, values, operands, extents, &space);
}

/// `operands`, of a kernel iterating `extents`, read over `space`: each
/// element where the kernel's extents hold it, one per row of `space` where
/// the operand holds one per row of them.
fn reads_over(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    operands: &List<KernelOperand>,
    extents: &List<i32>,
    space: &List<i32>,
) -> List<PlacedRead<Untyped>> with (GpuDevice, GpuQueue, GpuBuffer) {
    let mut per_row = space[0..<space.len() - 1].to_list();
    per_row.push(1);
    return (*operands).into_iter().map(
        |o| PlacedRead::<Untyped> { view: g.reshaped(&view_of(g, values, o.node), if o.extents == *extents {
            space;
        } else {
            &per_row;
        }) },
    ).collect();
}

/// The view of node `id`'s value on the device.
fn view_of(
    g: &mut WebGpuBackend,
    values: &Values<WebGpuBackend>,
    id: i32,
) -> DeviceTensor with (GpuDevice, GpuQueue, GpuBuffer) {
    return any_view(g, &values[id]);
}

fn any_view(g: &mut WebGpuBackend, value: &Any<WebGpuBackend>) -> DeviceTensor with (GpuDevice, GpuQueue, GpuBuffer) {
    return match value {
        F32(t) => g.device_view(t),
        Bool(t) => g.device_view(t),
        I64(_) => unreachable(),
    };
}

/// A kernel's f32 result as the element `kind` its root computes.
fn of_kind(g: &mut WebGpuBackend, kind: ElementKind, computed: Placed<f32, Untyped>) -> Any<WebGpuBackend> {
    return match kind {
        F32 => Any::F32(computed),
        Bool => Any::Bool(as_element(g, computed)),
        I64 => unreachable(),
    };
}

/// `op` over operands of one shape, as a StableHLO elementwise operation takes
/// them; the kernel would broadcast any other.
fn elementwise_on<Axes>(
    g: &mut WebGpuBackend,
    operands: &List<DeviceTensor>,
    op: &Expr,
) -> Placed<f32, Axes> with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let _ = elementwise_extents(operands.into_iter().map(|o| o.extents).collect());
    return g.fused_on(operands, op);
}

/// Below this an i64 is exact in an f32, and so is the sum of two.
global INDEX_BOUND: i64 = 8388608;

/// Whether an operation that moves or picks `E`s runs on the device over `a`
/// and `b`: an `E` it holds, or an i64 one of them already holds as an f32, a
/// token a kernel ranked, where the other's values stay within [`INDEX_BOUND`].
fn held_as_f32<E: Element, A, B>(a: &Placed<E, A>, b: &Placed<E, B>) -> bool {
    let either_held = a matches { Device(_) } || b matches { Device(_) };
    return E::exact_in_f32() || either_held && within_index_bound(a) && within_index_bound(b);
}

fn within_index_bound<E: Element, Axes>(t: &Placed<E, Axes>) -> bool {
    let Host(h) = t else {
        return true;
    };
    return h.data.into_iter().all(|v| -INDEX_BOUND < v.cast_to::<i64>() < INDEX_BOUND);
}

/// An f32 result as the element `E` it computed, which the device holds as
/// an f32: a bool as 1.0 or 0.0.
fn as_element<E: Element, Axes>(g: &mut WebGpuBackend, t: Placed<f32, Axes>) -> Placed<E, Axes> {
    return match t {
        Device(d) => Placed::Device(d),
        Host(h) => Placed::Host(g.cpu.convert(&h)),
    };
}


fn product_of(extents: &List<i32>, axes: &List<i32>) -> i32 {
    return element_count(&picked(extents, axes));
}

/// The axis a gather takes whole slices along, a position an index, where
/// `dims` says that and nothing else.
fn taken_axis(extents: &List<i32>, index_extents: &List<i32>, dims: &GatherDims) -> Option<i32> {
    let Some(taken) = taken_axes(extents, index_extents, dims) else {
        return null;
    };
    return if taken.count == 1 && taken.batch == index_extents.len() { Option::Some(taken.first) } else { null };
}

/// The adjacent axes a gather takes whole slices across, one position along
/// each, where `dims` says that and nothing else: the index's positions stand
/// where those axes were.
fn taken_axes(extents: &List<i32>, index_extents: &List<i32>, dims: &GatherDims) -> Option<TakenAxes> {
    let [collapsed, mapped] = [dims.collapsed_slice_dims, dims.start_index_map];
    let count = collapsed.len();
    let rank = index_extents.len();
    let implicit = dims.index_vector_dim == rank;
    let vectored = rank > 0 && dims.index_vector_dim == rank - 1 && index_extents[rank - 1] == count;
    if count == 0 || mapped != collapsed || !(implicit && count == 1 || vectored) {
        return null;
    }
    let first = collapsed[0];
    let mut whole = *extents;
    for let k of 0..<count {
        if collapsed[k] != first + k {
            return null;
        }
        whole[first + k] = 1;
    }
    let batch = if implicit { rank } else { rank - 1 };
    let mut offsets: List<i32> = (0..<first).collect();
    offsets.extend(&(first + batch..<extents.len() - count + batch).collect());
    if dims.slice_sizes != whole || dims.offset_dims != offsets {
        return null;
    }
    return Option::Some(TakenAxes { first, count, batch });
}

/// The run of adjacent axes a gather takes one position along each of, and
/// keeps every other axis whole: its first axis, how many, and the rank of the
/// index's positions, past which it holds one coordinate per axis.
struct TakenAxes {
    first: i32,
    count: i32,
    batch: i32,
}

/// Each update window a scatter writes: the part of `update` at each index,
/// and the part of `out` it lands on, cut where it reaches past `out`.
fn scatter_windows<I>(
    out: &DeviceTensor,
    update: &DeviceTensor,
    index: &Tensor<i64, I>,
    dims: &ScatterDims,
) -> List<[DeviceTensor, DeviceTensor]> {
    let rank = out.extents.len();
    let window_axes: List<i32> = (0..<rank).filter(|a| !dims.inserted_window_dims.contains(&a)).collect();
    let scatter_axes = kept_axes(update.extents.len(), &dims.update_window_dims);
    let vector = dims.index_vector_dim;
    let implicit = vector == index.extents.len();
    let count = if implicit { 1 } else { index.extents[vector] };
    let mut windows: List<[DeviceTensor, DeviceTensor]> = [];
    let positions = element_count(&picked(&update.extents, &scatter_axes));
    for let p of 0..<positions {
        // The position's coordinates along the update's scatter axes, which
        // are the index tensor's axes but for its index vector's.
        let mut at = List::<i32>::filled(scatter_axes.len(), 0);
        let mut rest = p;
        for let mut i = scatter_axes.len() - 1; i >= 0; i -= 1 {
            at[i] = rest % update.extents[scatter_axes[i]];
            rest /= update.extents[scatter_axes[i]];
        }
        let mut start = List::<i64>::filled(rank, 0);
        for let k of 0..<count {
            let mut coordinates = at;
            if !implicit {
                coordinates.insert(vector, k);
            }
            start[dims.scatter_dims_to_operand_dims[k]] = index.data[row_major_index(&index.extents, &coordinates)];
        }
        let mut from = DeviceTensor { ..*update, extents: [], strides: [] };
        for let i of 0..<scatter_axes.len() {
            from.offset += at[i] * update.strides[scatter_axes[i]];
        }
        let mut to = DeviceTensor { ..*out, extents: [], strides: [] };
        let mut empty = false;
        for let w of 0..<window_axes.len() {
            let [axis, u] = [window_axes[w], dims.update_window_dims[w]];
            let [lo, hi] = [
                i64::max(start[axis], 0),
                i64::min(start[axis] + update.extents[u] as i64, out.extents[axis] as i64),
            ];
            if lo >= hi {
                empty = true;
                break;
            }
            from.offset += (lo - start[axis]) as i32 * update.strides[u];
            from.extents.push((hi - lo) as i32);
            from.strides.push(update.strides[u]);
            to.offset += lo as i32 * out.strides[axis];
            to.extents.push((hi - lo) as i32);
            to.strides.push(out.strides[axis]);
        }
        for let axis of dims.inserted_window_dims {
            if start[axis] < 0 || start[axis] >= out.extents[axis] as i64 {
                empty = true;
            }
            to.offset += start[axis] as i32 * out.strides[axis];
        }
        if !empty {
            windows.push([from, to]);
        }
    }
    return windows;
}

fn row_major_index(extents: &List<i32>, coordinates: &List<i32>) -> i32 {
    let mut at = 0;
    for let a of 0..<extents.len() {
        at = at * extents[a] + coordinates[a];
    }
    return at;
}
