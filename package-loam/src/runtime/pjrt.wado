//! `PjrtBackend`: a `Graph` whose programs a PJRT plugin compiles and runs. An
//! operation a pass adds outside a program computes on the host, as `Cpu`
//! computes it. `core:pjrt` hosts it, so only `wado run-pjrt` runs it.

use { HashMap, HashSet } from "core:collections";
use { LinearArray } from "core:linear";
use { Analysis, Buffer, ElementType, Executable, PjrtHost } from "core:pjrt";
use {
    Backend,
    Binary,
    Comparison,
    Convolution,
    DotDims,
    GatherDims,
    Graph,
    ScatterDims,
    Slots,
    Unary,
    WindowReduce,
    full,
    written_at,
} from "./hlo.wado";
use { Cpu, CpuTensor, Element, ElementKind, Float, Holds, Tensor } from "./tensor.wado";
use {
    Any,
    Recorded,
    Recorder,
    Untyped,
    data_of,
    kept_any,
    kind_of,
    uploaded_any,
    zeros_on_host,
} from "./recorded.wado";
use { in_place, le_bytes, module_of } from "./stablehlo.wado";
use { HostWeight } from "./weight.wado";

/// A tensor on the device: which of the backend's buffers holds it.
pub struct DeviceBuffer {
    slot: i32,
    /// Which of the buffers the slot has held, as a freed slot is used again.
    generation: i32,
    extents: List<i32>,
    /// Whether a weight of f32 sits there in bf16, which a program converts.
    halved: bool,
}

/// Where `PjrtBackend` holds a tensor.
pub variant Located<E, Axes> {
    Host(Tensor<E, Axes>),
    Device(DeviceBuffer),
}

/// What a program returns, each as its recording does.
struct Returned {
    kind: ElementKind,
    extents: List<i32>,
}

/// A compiled pass: which of the backend's executables it is.
pub struct PjrtProgram {
    at: i32,
    returned: List<Returned>,
    /// Each `[parameter, result]` the program updates in place.
    in_place: List<[i32, i32]>,
}

/// The device of the plugin `wado run-pjrt` loaded. Buffers and executables are
/// resources, which a tensor's value cannot hold, so the backend holds them
/// and a tensor names its slot.
///
/// Donating a shared attention buffer consumes it while a caller may still hold
/// the cache it was, and read it or branch from it. That cache's positions are
/// the same in the buffer it became, so its slot moves there. Past its length it
/// reads what later steps wrote, which are no positions of that cache: its mask
/// leaves them out, and a step from it writes them first. Only the last cache of
/// a buffer is donated, whose new positions no other cache reads: any earlier
/// one is copied by the program, so two branches never write one buffer.
pub affine struct PjrtBackend {
    cpu: Cpu,
    buffers: List<Option<Buffer>>,
    /// How many buffers each slot has released.
    generations: List<i32>,
    /// The slots of `buffers` that hold none.
    free: List<i32>,
    /// The slots the next `begin` releases: what this pass put on the device,
    /// and what the pass before retained.
    pass: List<i32>,
    retaining: HashSet<i32>,
    /// Where each donated slot's cache went.
    moved: HashMap<i32, i32>,
    executables: List<Executable>,
    /// The executables of `pool` and `written`, by the element and extents
    /// they are of.
    helpers: HashMap<String, i32>,
    /// The topology a program compiles for, instead of running on a device.
    topology: Option<String>,
    analyses: List<Analysis>,
    reads: i32,
    runs: i32,
    donated: i32,
    halved_bytes: i64,
    whole_bytes: i64,
}

/// `outcome`'s value. What a plugin refuses is a bug of the writer or of the
/// plugin, and its message is the one thing that says which.
fn done<affine T>(outcome: Result<T, String>) -> T {
    return match outcome {
        Ok(value) => value,
        Err(message) => panic(message),
    };
}

fn element_type(kind: ElementKind) -> ElementType {
    return match kind {
        F32 => ElementType::Float32,
        F16 => ElementType::Float16,
        BF16 => ElementType::Bfloat16,
        U8 => ElementType::Uint8,
        I64 => ElementType::Int64,
        I32 => ElementType::Int32,
        Bool => ElementType::Pred,
    };
}

/// `extents` as PJRT takes a buffer's dimensions.
fn buffer_extents(extents: &List<i32>) -> List<i64> {
    return extents.into_iter().map(|e| e as i64).collect();
}

/// The `E`s `bytes` holds, as `le_bytes` lays them out.
fn elements_of<E: Element>(bytes: ByteList) -> List<E> {
    return match E::kind() {
        F32 => List::<f32>::from_le_bytes(bytes).into_iter().map(|v| E::from_f32(v)).collect(),
        F16 => List::<u16>::from_le_bytes(bytes).into_iter().map(|bits| f16::from_bits(bits).cast_to::<E>()).collect(),
        BF16 => widened(bytes),
        U8 => bytes.into_iter().map(|b| b.cast_to::<E>()).collect(),
        I64 => List::<i64>::from_le_bytes(bytes).into_iter().map(|v| E::from_i64(v)).collect(),
        I32 => List::<i32>::from_le_bytes(bytes).into_iter().map(|v| E::from_i64(v as i64)).collect(),
        Bool => bytes.into_iter().map(|b| E::from_bool(b != 0)).collect(),
    };
}

/// The bf16s `bytes` hold, each as an `E`.
fn widened<E: Element>(bytes: ByteList) -> List<E> {
    return List::<u16>::from_le_bytes(bytes).into_iter().map(|bits| bf16::from_bits(bits).cast_to::<E>()).collect();
}

/// `analysis` as a line. A TPU's `optimal_seconds` takes 1 off for each
/// operation at a computed index, whose time its model leaves out. So where it
/// is negative, its estimate is what lies above the next whole number, which
/// reads true while that estimate is under a second.
pub fn summary(analysis: &Analysis) -> String {
    let mut line = `${analysis.argument_bytes} argument bytes, ${analysis.alias_bytes} aliased, ${analysis.temporary_bytes} temporary`;
    for let cost of analysis.costs {
        if cost.name == "optimal_seconds" {
            let unmodeled = if cost.value < 0.0 { f64::ceil(-cost.value) as i64 } else { 0 };
            line.push_str(`, ${cost.value + unmodeled as f64:e} optimal seconds, ${unmodeled} operations unmodeled`);
        }
    }
    return line;
}

/// The buffer `slot` holds as a program returned it, of an element of `kind`.
fn returned_at(kind: ElementKind, on: DeviceBuffer) -> Any<PjrtBackend> {
    return match kind {
        F32 => Any::F32(Located::Device(on)),
        F16 => Any::F16(Located::Device(on)),
        BF16 => Any::BF16(Located::Device(on)),
        U8 => Any::U8(Located::Device(on)),
        I64 => Any::I64(Located::Device(on)),
        I32 => Any::I32(Located::Device(on)),
        Bool => Any::Bool(Located::Device(on)),
    };
}

impl PjrtBackend {
    pub fn new() -> PjrtBackend {
        return PjrtBackend {
            cpu: Cpu {},
            buffers: [],
            generations: [],
            free: [],
            pass: [],
            retaining: HashSet::new(),
            moved: HashMap::new(),
            executables: [],
            helpers: HashMap::new(),
            topology: null,
            analyses: [],
            reads: 0,
            runs: 0,
            donated: 0,
            halved_bytes: 0,
            whole_bytes: 0,
        };
    }

    /// A backend that compiles each program for `topology`, such as `v5e:1x1`,
    /// with no device, and keeps what the plugin reports of it. A program it
    /// compiled returns zeros, which is what lets a model's own call reach
    /// every program it would run.
    pub fn analyzing(topology: String) -> PjrtBackend {
        return PjrtBackend {
            ..PjrtBackend::new(),
            topology: Option::Some(topology),
        };
    }

    /// What the plugin reported of each program, in the order they compiled.
    pub fn analyses(&self) -> &List<Analysis> {
        return &self.analyses;
    }

    /// How many tensors have been read back from the device.
    pub fn read_backs(&self) -> i32 {
        return self.reads;
    }

    /// How many times a program has run.
    pub fn executions(&self) -> i32 {
        return self.runs;
    }

    /// How many buffers a program has updated in place.
    pub fn donations(&self) -> i32 {
        return self.donated;
    }

    /// The bytes the weights take in halves, those of a half graph and the f32
    /// ones bf16 holds exactly, and those that stay f32 to lose nothing.
    pub fn weight_bytes(&self) -> [i64, i64] {
        return [self.halved_bytes, self.whole_bytes];
    }

    fn stored(&mut self, buffer: Buffer) -> i32 {
        let Some(slot) = self.free.pop() else {
            self.buffers.push(Option::Some(buffer));
            self.generations.push(0);
            return self.buffers.len() - 1;
        };
        self.buffers[slot] = Option::Some(buffer);
        return slot;
    }

    fn device_buffer(&self, slot: i32, extents: List<i32>, halved: bool) -> DeviceBuffer {
        return DeviceBuffer { slot, generation: self.generations[slot], extents, halved };
    }

    /// The slot of `d`, which must still hold it: one that has been freed may
    /// hold another tensor by now.
    fn slot_of(&self, d: &DeviceBuffer) -> i32 {
        assert d.slot >= 0, "a backend compiling for a topology holds no weight";
        assert self.generations[d.slot] == d.generation, "a tensor of a pass that has ended is no longer held";
        return d.slot;
    }

    /// The executable of `recorded`, compiled once for its `key`.
    fn compiled_once(&mut self, key: String, recorded: fn() -> Recorded) -> i32 with PjrtHost {
        if let Some(at) = self.helpers.get(key) {
            return at;
        }
        self.executables.push(done(PjrtHost::compile(module_of(&recorded(), &HashSet::new()))));
        self.helpers[key] = self.executables.len() - 1;
        return self.executables.len() - 1;
    }

    fn sent<E: Element, Axes>(&mut self, t: &Tensor<E, Axes>) -> i32 with PjrtHost {
        return self.stored(done(PjrtHost::upload(element_type(E::kind()), buffer_extents(&t.extents), le_bytes(&data_of(
            &t.data,
        )))));
    }

    /// `w`, a weight of f32s: in bf16 where that loses nothing, an f32 whose
    /// low half is zero, and as stored otherwise.
    fn kept_weight(&mut self, w: &HostWeight) -> DeviceBuffer with PjrtHost
        contract w.kind matches { F32 }
    {
        let count = w.count();
        let mut halves = LinearArray::<u16>::filled(count, 0);
        let mut halved = true;
        for let at of 0..<count {
            let bits = w.bytes().load_at::<u32>(4 * at);
            if bits & 0xFFFF != 0 {
                halved = false;
                break;
            }
            halves[at] = (bits >> 16) as u16;
        }
        if halved {
            self.halved_bytes += count as i64 * 2;
        } else {
            self.whole_bytes += count as i64 * 4;
        }
        if self.topology matches { Some(_) } {
            return DeviceBuffer { slot: -1, generation: 0, extents: w.extents, halved };
        }
        let buffer = if halved {
            done(PjrtHost::upload(ElementType::Bfloat16, buffer_extents(&w.extents), &halves.cast::<u8>()));
        } else {
            done(PjrtHost::upload(ElementType::Float32, buffer_extents(&w.extents), w.bytes()));
        };
        return self.device_buffer(self.stored(buffer), w.extents, halved);
    }

    /// `w` on the device as it is stored.
    fn kept_stored(&mut self, w: &HostWeight) -> Any<PjrtBackend> with PjrtHost {
        if self.topology matches { Some(_) } {
            return kept_any(self, &w.decoded());
        }
        let buffer = done(PjrtHost::upload(element_type(w.kind), buffer_extents(&w.extents), w.bytes()));
        let d = self.device_buffer(self.stored(buffer), w.extents, false);
        return match w.kind {
            F32 => Any::F32(Located::Device(d)),
            F16 => Any::F16(Located::Device(d)),
            BF16 => Any::BF16(Located::Device(d)),
            U8 => Any::U8(Located::Device(d)),
            I64 => Any::I64(Located::Device(d)),
            I32 => Any::I32(Located::Device(d)),
            Bool => Any::Bool(Located::Device(d)),
        };
    }

    /// The slot of `value`, sent to the device for this pass if it is on the host.
    fn on_device(&mut self, value: &Any<PjrtBackend>) -> i32 with PjrtHost {
        let host = match value {
            F32(Device(d)) | F16(Device(d)) | BF16(Device(d)) | U8(Device(d)) | I64(Device(d)) | I32(Device(d)) | Bool(Device(d)) => {
                return self.slot_of(d);
            },
            F32(Host(t)) => self.sent(t),
            F16(Host(t)) => self.sent(t),
            BF16(Host(t)) => self.sent(t),
            U8(Host(t)) => self.sent(t),
            I64(Host(t)) => self.sent(t),
            I32(Host(t)) => self.sent(t),
            Bool(Host(t)) => self.sent(t),
        };
        self.pass.push(host);
        return host;
    }

    /// The slot that holds what `slot` held.
    fn current(&self, slot: i32) -> i32 {
        let mut at = slot;
        while let Some(next) = self.moved.get(at) {
            at = next;
        }
        return at;
    }

    fn buffer_at(&self, slot: i32) -> &Buffer {
        let Some(buffer) = &self.buffers[self.current(slot)] else {
            unreachable();
        };
        return buffer;
    }

    fn host<E: Element, Axes>(&mut self, t: &Located<E, Axes>) -> Tensor<E, Axes> {
        return match t {
            Host(h) => *h,
            Device(d) => {
                self.reads += 1;
                let bytes = done(self.buffer_at(self.slot_of(d)).to_host());
                Tensor { data: if d.halved { widened(bytes) } else { elements_of(bytes) }, extents: d.extents };
            },
        };
    }

    /// `t` as `Cpu` computes on it.
    fn on_cpu<E: Element, Axes>(&mut self, t: &Located<E, Axes>) -> CpuTensor<E, Axes> {
        return CpuTensor::Value(self.host(t));
    }
}

/// What `Cpu` computed, held on the host.
fn hosted<E, Axes>(t: CpuTensor<E, Axes>) -> Located<E, Axes> {
    let Value(v) = t else {
        unreachable();
    };
    return Located::Host(v);
}

impl Holds for PjrtBackend {
    type Tensor<E: Element, Axes> = Located<E, Axes>;

    fn upload<E: Element, Axes>(&mut self, t: &Tensor<E, Axes>) -> Located<E, Axes> {
        return Located::Host(*t);
    }

    fn keep<E: Element, Axes>(&mut self, t: &Tensor<E, Axes>) -> Located<E, Axes> with PjrtHost {
        if self.topology matches { Some(_) } {
            return Located::Host(*t);
        }
        return Located::Device(self.device_buffer(self.sent(t), t.extents, false));
    }

    fn extents_of<E: Element, Axes>(&self, t: &Located<E, Axes>) -> List<i32> {
        return match t {
            Host(h) => h.extents,
            Device(d) => d.extents,
        };
    }

    fn download<E: Element, Axes>(&mut self, t: &Located<E, Axes>) -> Tensor<E, Axes> {
        return self.host(t);
    }

    fn begin(&mut self) {
        let pass = self.pass;
        self.pass = [];
        for let slot of pass {
            if self.retaining.contains(slot) {
                self.pass.push(slot);
            } else {
                self.buffers[slot] = null;
                self.generations[slot] += 1;
                self.moved.remove(slot);
                self.free.push(slot);
            }
        }
        self.retaining = HashSet::new();
    }

    fn retain<E: Element, Axes>(&mut self, t: &Located<E, Axes>) {
        if let Device(d) = t {
            let mut at = self.slot_of(d);
            self.retaining.insert(at);
            while let Some(next) = self.moved.get(at) {
                at = next;
                self.retaining.insert(at);
            }
        }
    }
}

impl Backend for PjrtBackend {
    type Program = PjrtProgram;

    /// XLA fuses a composite's decomposition itself.
    fn recorder(&self) -> Recorder {
        return Recorder::decomposing();
    }

    fn compiled(
        &mut self,
        recorded: Recorded,
        weights: &List<Any<PjrtBackend>>,
        earlier: &List<&PjrtProgram>,
    ) -> PjrtProgram with PjrtHost {
        let returned: List<Returned> = recorded.body.results.into_iter().map(|id| {
            let node = &recorded.nodes[id];
            return Returned { kind: node.kind, extents: node.extents };
        }).collect();
        let first = recorded.parameters - weights.len();
        let mut halved = HashSet::<i32>::new();
        for let [at, weight] of weights.into_iter().enumerate() {
            if let F32(Device(d)) = weight && d.halved {
                halved.insert(first + at);
            }
        }
        let module = module_of(&recorded, &halved);
        if let Some(topology) = self.topology {
            self.analyses.push(done(PjrtHost::analyzed(module, topology)));
            return PjrtProgram { at: -1, returned, in_place: [] };
        }
        self.executables.push(done(PjrtHost::compile(module)));
        return PjrtProgram {
            at: self.executables.len() - 1,
            returned,
            in_place: in_place(&recorded),
        };
    }

    fn kept_weights<Er>(
        &mut self,
        record: fn(&mut Recorder) -> Recorded with _,
        first: i32,
        count: i32,
        load: fn(i32) -> Result<HostWeight, Er> with _,
    ) -> Result<List<Any<PjrtBackend>>, Er> with (_, PjrtHost) {
        let mut kept: List<Any<PjrtBackend>> = [];
        for let at of 0..<count {
            let w = load(at)?;
            if w.kind matches { F32 } {
                kept.push(Any::F32(Located::Device(self.kept_weight(&w))));
                continue;
            }
            if w.kind matches { F16 | BF16 } {
                self.halved_bytes += w.bytes().len() as i64;
            }
            kept.push(self.kept_stored(&w));
        }
        return Result::Ok(kept);
    }

    fn executed(
        &mut self,
        program: &PjrtProgram,
        arguments: &List<Any<PjrtBackend>>,
        weights: &List<Any<PjrtBackend>>,
    ) -> List<Any<PjrtBackend>> with PjrtHost {
        self.runs += 1;
        if self.topology matches { Some(_) } {
            return program.returned.into_iter().map(|r| uploaded_any(self, &zeros_on_host(r.kind, r.extents))).collect();
        }
        let slots: List<i32> = arguments.into_iter().chain(weights.into_iter()).map(|a| self.on_device(a)).collect();
        let currents: List<i32> = slots.into_iter().map(|slot| self.current(slot)).collect();
        let mut donated: List<[i32, i32]> = [];
        let mut kept: List<i64> = [];
        for let [parameter, result] of program.in_place {
            let last_of_its_buffer = !self.moved.contains_key(slots[parameter]);
            let once = currents.into_iter().filter(|c| c == currents[parameter]).count() == 1;
            if last_of_its_buffer && once {
                donated.push([slots[parameter], result]);
            } else {
                kept.push(parameter as i64);
            }
        }
        let held: List<&Buffer> = currents.into_iter().map(|slot| self.buffer_at(slot)).collect();
        let results = done(self.executables[program.at].execute(held, kept));
        let mut values: List<Any<PjrtBackend>> = [];
        let mut result_slots: List<i32> = [];
        for let result of results {
            let slot = self.stored(result);
            self.pass.push(slot);
            result_slots.push(slot);
            let returned = &program.returned[values.len()];
            let on = self.device_buffer(slot, returned.extents, false);
            values.push(returned_at(returned.kind, on));
        }
        for let [slot, result] of donated {
            self.buffers[slot] = null;
            self.moved[slot] = result_slots[result];
            self.donated += 1;
        }
        return values;
    }

    /// A program's zeros, which the backend keeps.
    fn pool(&mut self, kind: ElementKind, extents: List<i32>) -> Any<PjrtBackend> with PjrtHost {
        if self.topology matches { Some(_) } {
            return kept_any(self, &zeros_on_host(kind, extents));
        }
        let at = self.compiled_once(`zeros ${kind:?} ${extents:?}`, || zeros_pass(kind, extents));
        let zeros = done(self.executables[at].execute([], [])).pop().unwrap();
        let on = self.device_buffer(self.stored(zeros), extents, false);
        return returned_at(kind, on);
    }

    /// A program that writes the slot over the pool it is given, in place.
    fn written(&mut self, pool: &mut Any<PjrtBackend>, slot: i32, row: HostWeight) with PjrtHost {
        if self.topology matches { Some(_) } {
            return;
        }
        let F32(Device(d)) | F16(Device(d)) | BF16(Device(d)) | U8(Device(d)) | I64(Device(d)) | I32(Device(d)) | Bool(Device(d)) = pool else {
            unreachable();
        };
        let kind = kind_of(pool);
        let at = self.compiled_once(`slot ${kind:?} ${d.extents:?}`, || slot_pass(kind, d.extents));
        let held = self.slot_of(d);
        let mut one = d.extents;
        one[0] = 1;
        let given = done(PjrtHost::upload(element_type(kind), buffer_extents(&one), row.bytes()));
        let index = done(PjrtHost::upload(ElementType::Int64, [1], le_bytes(&data_of(&([slot as i64] as List<i64>)))));
        let updated = done(self.executables[at].execute([self.buffer_at(held), &given, &index], [])).pop().unwrap();
        self.buffers[held] = Option::Some(updated);
    }
}

/// A pass of no parameters that returns zeros of `kind` and `extents`.
fn zeros_pass(kind: ElementKind, extents: List<i32>) -> Recorded {
    return match kind {
        F32 => zeros_of::<f32>(extents),
        F16 => zeros_of::<f16>(extents),
        BF16 => zeros_of::<bf16>(extents),
        U8 => zeros_of::<u8>(extents),
        I64 => zeros_of::<i64>(extents),
        I32 => zeros_of::<i32>(extents),
        Bool => zeros_of::<bool>(extents),
    };
}

fn zeros_of<E: Element>(extents: List<i32>) -> Recorded {
    let mut r = Recorder::new();
    let zeros = full::<Recorder, E, Untyped>(&mut r, E::from_i64(0), extents);
    return r.finished([zeros.id]);
}

/// A pass that writes its second parameter, one slice along the first axis
/// of a pool of `kind` and `extents`, over the slot its third names in the
/// pool its first holds, which becomes the result.
fn slot_pass(kind: ElementKind, extents: List<i32>) -> Recorded {
    return match kind {
        F32 => slot_of::<f32>(extents),
        F16 => slot_of::<f16>(extents),
        BF16 => slot_of::<bf16>(extents),
        U8 => slot_of::<u8>(extents),
        I64 => slot_of::<i64>(extents),
        I32 => slot_of::<i32>(extents),
        Bool => slot_of::<bool>(extents),
    };
}

fn slot_of<E: Element>(extents: List<i32>) -> Recorded {
    let mut r = Recorder::new();
    let pool = r.parameter::<E, Untyped>(extents);
    let mut one = extents;
    one[0] = 1;
    let row = r.parameter::<E, Untyped>(one);
    let at = r.parameter::<i64, [Slots]>([1]);
    let written = written_at::<Recorder, E, Untyped, Untyped>(&mut r, &pool, &row, 0, &at, null);
    let mut recorded = r.finished([written.id]);
    recorded.appended.push([pool.id, written.id]);
    return recorded;
}

impl Graph for PjrtBackend {
    fn relabeled<E: Element, In, Out>(&self, t: &Located<E, In>) -> Located<E, Out> {
        return match t {
            Host(h) => Located::Host(Tensor { data: h.data, extents: h.extents }),
            Device(d) => Located::Device(*d),
        };
    }

    fn iota<E: Element, Axes>(&mut self, extents: List<i32>, dimension: i32) -> Located<E, Axes> {
        return hosted(self.cpu.iota(extents, dimension));
    }

    fn convert<A: Element, B: Element, Axes>(&mut self, x: &Located<A, Axes>) -> Located<B, Axes> {
        return hosted(self.cpu.convert(&self.on_cpu(x)));
    }

    fn unary<E: Float, Axes>(&mut self, op: Unary, x: &Located<E, Axes>) -> Located<E, Axes> {
        return hosted(self.cpu.unary(op, &self.on_cpu(x)));
    }

    fn binary<E: Element, Axes>(&mut self, op: Binary, a: &Located<E, Axes>, b: &Located<E, Axes>) -> Located<E, Axes> {
        return hosted(self.cpu.binary(op, &self.on_cpu(a), &self.on_cpu(b)));
    }

    fn compare<E: Element, Axes>(
        &mut self,
        direction: Comparison,
        a: &Located<E, Axes>,
        b: &Located<E, Axes>,
    ) -> Located<bool, Axes> {
        return hosted(self.cpu.compare(direction, &self.on_cpu(a), &self.on_cpu(b)));
    }

    fn select<E: Element, Axes>(
        &mut self,
        pred: &Located<bool, Axes>,
        on_true: &Located<E, Axes>,
        on_false: &Located<E, Axes>,
    ) -> Located<E, Axes> {
        return hosted(self.cpu.select(&self.on_cpu(pred), &self.on_cpu(on_true), &self.on_cpu(on_false)));
    }

    fn broadcast_in_dim<E: Element, In, Out>(
        &mut self,
        x: &Located<E, In>,
        extents: List<i32>,
        dims: List<i32>,
    ) -> Located<E, Out> {
        return hosted(self.cpu.broadcast_in_dim(&self.on_cpu(x), extents, dims));
    }

    fn reshape<E: Element, In, Out>(&mut self, x: &Located<E, In>, extents: List<i32>) -> Located<E, Out> {
        return hosted(self.cpu.reshape(&self.on_cpu(x), extents));
    }

    fn transpose<E: Element, In, Out>(&mut self, x: &Located<E, In>, perm: List<i32>) -> Located<E, Out> {
        return hosted(self.cpu.transpose(&self.on_cpu(x), perm));
    }

    fn slice<E: Element, In, Out>(
        &mut self,
        x: &Located<E, In>,
        start: List<i32>,
        limit: List<i32>,
        strides: List<i32>,
    ) -> Located<E, Out> {
        return hosted(self.cpu.slice(&self.on_cpu(x), start, limit, strides));
    }

    fn concatenate<E: Element, A, B, Out>(
        &mut self,
        a: &Located<E, A>,
        b: &Located<E, B>,
        dimension: i32,
    ) -> Located<E, Out> {
        return hosted(self.cpu.concatenate(&self.on_cpu(a), &self.on_cpu(b), dimension));
    }

    fn reduce<E: Element, In, Out>(
        &mut self,
        x: &Located<E, In>,
        op: Binary,
        init: f32,
        dims: List<i32>,
    ) -> Located<E, Out> {
        return hosted(self.cpu.reduce(&self.on_cpu(x), op, init, dims));
    }

    fn dot_general<E: Float, A, B, Out>(
        &mut self,
        lhs: &Located<E, A>,
        rhs: &Located<E, B>,
        dims: &DotDims,
    ) -> Located<E, Out> {
        return hosted(self.cpu.dot_general(&self.on_cpu(lhs), &self.on_cpu(rhs), dims));
    }

    fn gather<E: Element, D, I, Out>(
        &mut self,
        operand: &Located<E, D>,
        indices: &Located<i64, I>,
        dims: &GatherDims,
    ) -> Located<E, Out> {
        return hosted(self.cpu.gather(&self.on_cpu(operand), &self.on_cpu(indices), dims));
    }

    fn scatter<E: Element, D, I, U>(
        &mut self,
        operand: &Located<E, D>,
        indices: &Located<i64, I>,
        updates: &Located<E, U>,
        dims: &ScatterDims,
    ) -> Located<E, D> {
        return hosted(self.cpu.scatter(&self.on_cpu(operand), &self.on_cpu(indices), &self.on_cpu(updates), dims));
    }

    fn convolution<E: Float, In, K, Out>(
        &mut self,
        x: &Located<E, In>,
        kernel: &Located<E, K>,
        conv: &Convolution,
    ) -> Located<E, Out> {
        return hosted(self.cpu.convolution(&self.on_cpu(x), &self.on_cpu(kernel), conv));
    }

    fn reduce_window<E: Float, In, Out>(
        &mut self,
        x: &Located<E, In>,
        op: Binary,
        init: f32,
        window: &WindowReduce,
    ) -> Located<E, Out> {
        return hosted(self.cpu.reduce_window(&self.on_cpu(x), op, init, window));
    }

    fn reverse<E: Element, Axes>(&mut self, x: &Located<E, Axes>, dims: List<i32>) -> Located<E, Axes> {
        return hosted(self.cpu.reverse(&self.on_cpu(x), dims));
    }

    fn conditional<Axes, T>(
        &mut self,
        pred: &Located<bool, Axes>,
        then: fn() -> T with _,
        otherwise: fn() -> T with _,
    ) -> T with _ {
        return self.cpu.conditional(&self.on_cpu(pred), then, otherwise);
    }

    fn arg_max<E: Float, Axes>(&mut self, x: &Located<E, Axes>, axis: i32) -> Located<i64, Axes> {
        return hosted(self.cpu.arg_max(&self.on_cpu(x), axis));
    }
}
