//! A weight on its way from the host to a backend, in the bytes a checkpoint
//! stores it in.

use { LinearArray } from "core:linear";
use { Any, Untyped, data_of } from "./recorded.wado";
use { Cpu, Element, ElementKind, Tensor, element_count } from "./tensor.wado";

/// A weight on the host as a checkpoint stores it: `kind` elements,
/// little-endian and a bool a byte each, row-major under `extents`. The bytes
/// are in linear memory, where no collection traces them and no GC array
/// bounds them. A device lays its copy out from them; `Cpu` decodes them.
pub affine struct HostWeight {
    pub kind: ElementKind,
    pub extents: List<i32>,
    bytes: LinearArray<u8>,
}

/// The bytes one `kind` element takes as a checkpoint stores it.
pub fn stored_width(kind: ElementKind) -> i32 {
    return match kind {
        F32 => 4,
        F16 | BF16 => 2,
        U8 | Bool => 1,
        I64 => 8,
    };
}

impl HostWeight {
    /// `bytes`, which hold the `kind` elements of `extents` as a checkpoint
    /// stores them.
    pub fn stored(kind: ElementKind, extents: List<i32>, bytes: LinearArray<u8>) -> HostWeight
        contract bytes.len() == element_count(&extents) * stored_width(kind)
    {
        return HostWeight { kind, extents, bytes };
    }

    /// `t`'s elements, stored.
    pub fn of<E: Element, Axes>(t: &Tensor<E, Axes>) -> HostWeight {
        let count = t.data.len();
        let mut bytes = LinearArray::<u8>::filled(count * stored_width(E::kind()), 0);
        match data_of(&t.data) {
            F32(values) => {
                for let i of 0..<count {
                    bytes.store_at::<u32>(4 * i, values[i].to_bits());
                }
            },
            F16(values) => {
                for let i of 0..<count {
                    bytes.store_at::<u16>(2 * i, values[i].to_bits());
                }
            },
            BF16(values) => {
                for let i of 0..<count {
                    bytes.store_at::<u16>(2 * i, values[i].to_bits());
                }
            },
            U8(values) => {
                for let i of 0..<count {
                    bytes[i] = values[i];
                }
            },
            I64(values) => {
                for let i of 0..<count {
                    bytes.store_at::<i64>(8 * i, values[i]);
                }
            },
            Bool(values) => {
                for let i of 0..<count {
                    bytes[i] = values[i] as u8;
                }
            },
        }
        return HostWeight { kind: E::kind(), extents: t.extents, bytes };
    }

    /// The `E`s `bytes` stores under `extents`, as a module embeds a weight.
    pub fn of_bytes<E: Element>(extents: List<i32>, bytes: &ByteList) -> HostWeight {
        return HostWeight::stored(E::kind(), extents, LinearArray::<u8>::of_bytes(bytes, 0, bytes.len()));
    }

    /// How many elements this holds.
    pub fn count(&self) -> i32 {
        return element_count(&self.extents);
    }

    /// The bytes, as a checkpoint stores them.
    pub fn bytes(&self) -> &LinearArray<u8> {
        return &self.bytes;
    }

    /// Element `i` as the f32 that holds it exactly: a float's value, or a
    /// `u8` or a bool as a number.
    pub fn value(&self, i: i32) -> f32
        contract !self.kind matches { I64 }
    {
        return match self.kind {
            F32 => f32::from_bits(self.bytes.load_at::<u32>(4 * i)),
            F16 => f16::from_bits(self.bytes.load_at::<u16>(2 * i)) as f32,
            BF16 => bf16::from_bits(self.bytes.load_at::<u16>(2 * i)) as f32,
            U8 | Bool => self.bytes[i] as f32,
            I64 => unreachable(),
        };
    }

    /// The elements, decoded as `Cpu` holds them.
    pub fn decoded(&self) -> Any<Cpu> {
        let n = self.count();
        let extents = self.extents;
        return match self.kind {
            F32 => Any::F32(Tensor::<f32, Untyped> { data: self.bytes.to_list_of::<f32>(0, 4 * n), extents }),
            F16 => Any::F16(Tensor::<f16, Untyped> { data: self.bytes.to_list_of::<f16>(0, 2 * n), extents }),
            BF16 => Any::BF16(Tensor::<bf16, Untyped> { data: self.bytes.to_list_of::<bf16>(0, 2 * n), extents }),
            U8 => Any::U8(Tensor::<u8, Untyped> { data: self.bytes.to_list_of::<u8>(0, n), extents }),
            I64 => Any::I64(Tensor::<i64, Untyped> { data: self.bytes.to_list_of::<i64>(0, 8 * n), extents }),
            Bool => Any::Bool(Tensor::<bool, Untyped> {
                data: self.bytes.to_list_of::<u8>(0, n).into_iter().map(|b| b != 0).collect(),
                extents,
            }),
        };
    }
}
