//! A weight on its way from the host to a backend, in the bytes a checkpoint
//! stores it in.

use { LinearArray } from "core:linear";
use { Any, Untyped, data_of } from "./recorded.wado";
use { Cpu, CpuTensor, Element, ElementKind, Tensor, element_count } from "./tensor.wado";

/// A weight on the host as a checkpoint stores it: `kind` elements,
/// little-endian and a bool a byte each, row-major under `extents`. The bytes
/// are in linear memory, where no collection traces them and no GC array
/// bounds them. A device lays its copy out from them; `Cpu` decodes them.
pub affine struct HostWeight {
    pub kind: ElementKind,
    pub extents: List<i32>,
    bytes: LinearArray<u8>,
}

/// The bytes one `kind` element takes as a checkpoint stores it.
pub fn stored_width(kind: ElementKind) -> i32 {
    return match kind {
        _::F32 => 4,
        _::F16 | _::BF16 => 2,
        _::U8 | _::Bool => 1,
        _::I64 => 8,
        _::I32 => 4,
    };
}

/// The bytes `kind` elements under `extents` take as a checkpoint stores them.
pub fn stored_bytes(kind: ElementKind, extents: &List<i32>) -> i32
    contract element_count(extents) <= i32::MAX / stored_width(kind), "a weight's bytes fit linear memory"
{
    return element_count(extents) * stored_width(kind);
}

/// The most slots of `kind` and `slot`'s extents whose bytes stay within `i32`.
pub fn slots_within_i32(kind: ElementKind, slot: &List<i32>) -> i32 {
    return i32::MAX / stored_bytes(kind, slot);
}

impl HostWeight {
    /// `bytes`, which hold the `kind` elements of `extents` as a checkpoint
    /// stores them. A bool's nonzero byte becomes 1 here, so every backend
    /// reads one truth from it, as a PJRT `PRED` must hold 0 or 1.
    pub fn stored(kind: ElementKind, extents: List<i32>, bytes: LinearArray<u8>) -> HostWeight
        contract bytes.len() == stored_bytes(kind, &extents)
    {
        let mut held = bytes;
        if kind matches { _::Bool } {
            for let i of 0..<held.len() {
                held[i] = (held[i] != 0) as u8;
            }
        }
        return HostWeight { kind, extents, bytes: held };
    }

    /// `t`'s elements, stored.
    pub fn of<E: Element, Axes>(t: &Tensor<E, Axes>) -> HostWeight {
        let count = t.data.len();
        let mut bytes = LinearArray::<u8>::filled(stored_bytes(E::kind(), &t.extents), 0);
        match data_of(&t.data) {
            F32(values) => {
                for let i of 0..<count {
                    bytes.store_at::<u32>(4 * i, values[i].to_bits());
                }
            },
            F16(values) => {
                for let i of 0..<count {
                    bytes.store_at::<u16>(2 * i, values[i].to_bits());
                }
            },
            BF16(values) => {
                for let i of 0..<count {
                    bytes.store_at::<u16>(2 * i, values[i].to_bits());
                }
            },
            U8(values) => {
                for let i of 0..<count {
                    bytes[i] = values[i];
                }
            },
            I64(values) => {
                for let i of 0..<count {
                    bytes.store_at::<i64>(8 * i, values[i]);
                }
            },
            I32(values) => {
                for let i of 0..<count {
                    bytes.store_at::<i32>(4 * i, values[i]);
                }
            },
            Bool(values) => {
                for let i of 0..<count {
                    bytes[i] = values[i] as u8;
                }
            },
        }
        return HostWeight { kind: E::kind(), extents: t.extents, bytes };
    }

    /// The `E`s `bytes` stores under `extents`, as a module embeds a weight.
    pub fn of_bytes<E: Element>(extents: List<i32>, bytes: &ByteList) -> HostWeight {
        return HostWeight::stored(E::kind(), extents, LinearArray::<u8>::of_bytes(bytes, 0, bytes.len()));
    }

    /// Zeros of `kind` under `extents`.
    pub fn zeroed(kind: ElementKind, extents: List<i32>) -> HostWeight {
        let bytes = LinearArray::<u8>::filled(stored_bytes(kind, &extents), 0);
        return HostWeight { kind, extents, bytes };
    }

    /// This with `row`, one slice along the first axis, written over the
    /// slice `slot`.
    pub fn written_at(&mut self, slot: i32, row: &HostWeight)
        contract row.kind == self.kind && 0 <= slot < self.extents[0]
        contract row.bytes.len() * self.extents[0] == self.bytes.len(), "a row fills one slice"
    {
        let width = row.bytes.len();
        self.bytes.copy_from(slot * width, &row.bytes, 0, width);
    }

    /// How many elements this holds.
    pub fn count(&self) -> i32 {
        return element_count(&self.extents);
    }

    /// The bytes, as a checkpoint stores them.
    pub fn bytes(&self) -> &LinearArray<u8> {
        return &self.bytes;
    }

    /// The bytes, as a checkpoint stores them, in the guest's heap.
    pub fn stored_bytes(&self) -> ByteList {
        return self.bytes.to_byte_list(self.bytes.len()) as ByteList;
    }

    /// Element `i` as the f32 that holds it exactly: a float's value, or a
    /// `u8` or a bool as a number.
    pub fn value(&self, i: i32) -> f32
        contract !self.kind matches { _::I64 | _::I32 }
    {
        return match self.kind {
            _::F32 => f32::from_bits(self.bytes.load_at::<u32>(4 * i)),
            _::F16 => f16::from_bits(self.bytes.load_at::<u16>(2 * i)) as f32,
            _::BF16 => bf16::from_bits(self.bytes.load_at::<u16>(2 * i)) as f32,
            _::U8 | _::Bool => self.bytes[i] as f32,
            _::I64 | _::I32 => unreachable(),
        };
    }

    /// The elements, decoded as `Cpu` holds a value.
    pub fn decoded(&self) -> Any<Cpu> {
        return match self.kind {
            _::F32 => Any::F32(self.values::<f32>()),
            _::F16 => Any::F16(self.values::<f16>()),
            _::BF16 => Any::BF16(self.values::<bf16>()),
            _::U8 => Any::U8(self.values::<u8>()),
            _::I64 => Any::I64(self.values::<i64>()),
            _::I32 => Any::I32(self.values::<i32>()),
            _::Bool => Any::Bool(self.values::<bool>()),
        };
    }

    fn values<E: Element>(&self) -> CpuTensor<E, Untyped> {
        return CpuTensor::Value(Tensor { data: E::loaded(&self.bytes, 0, self.count()), extents: self.extents });
    }
}
