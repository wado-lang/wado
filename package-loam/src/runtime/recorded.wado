//! A pass recorded as a graph of the operations `Graph` names, for a device's
//! compiler to lower, and which `Cpu` runs node by node to hold that compiler
//! to what the operations mean.

use { HashMap } from "core:collections";
use {
    Binary,
    Comparison,
    Convolution,
    DotDims,
    GatherDims,
    Graph,
    Quantized,
    ScatterDims,
    Slots,
    Unary,
    WindowReduce,
    broadcast_in_dim_extents,
    conv_window,
    decomposed_attention,
    decomposed_gather,
    decomposed_product,
    dot_extents,
    elementwise_extents,
    gathered_extents,
    joined_extents,
    pooled_window,
    reduced_extents,
    sliced_extents,
} from "./hlo.wado";
use { Attention, Cpu, Element, ElementKind, Float, Holds, Tensor, element_count, optional } from "./tensor.wado";

/// A tensor's elements, whichever element it holds.
pub variant Data {
    F32(List<f32>),
    F16(List<f16>),
    BF16(List<bf16>),
    U8(List<u8>),
    I64(List<i64>),
    Bool(List<bool>),
}

/// What an attention node takes beside its query, key, value and past: the
/// options, and which of its optional operands follow them, in this order.
pub struct AttentionNode {
    pub options: Attention,
    pub shared: bool,
    pub bounded: bool,
    pub rotary: bool,
    pub biased: bool,
    pub sunk: bool,
}

/// What a quantized product or gather takes beside its operands: how the
/// weight is packed, and whether its zero points follow its scales.
pub struct QuantizedNode {
    pub quantized: Quantized,
    pub zero_points: bool,
}

/// One operation of a recorded graph, with the attributes `Graph`'s method
/// takes beside its operands.
pub variant Operation {
    /// The run's `i`th argument.
    Parameter(i32),
    Constant(Data),
    Iota(i32),
    Convert,
    Unary(Unary),
    Binary(Binary),
    Compare(Comparison),
    Select,
    BroadcastInDim(List<i32>),
    Reshape,
    Transpose(List<i32>),
    /// The start, the limit and the stride of each axis.
    Slice([List<i32>, List<i32>, List<i32>]),
    Concatenate(i32),
    Reduce([Binary, f32, List<i32>]),
    DotGeneral(DotDims),
    Gather(GatherDims),
    Scatter(ScatterDims),
    Convolution(Convolution),
    ReduceWindow([Binary, f32, WindowReduce]),
    Reverse(List<i32>),
    /// `Graph::arg_max` along the axis.
    ArgMax(i32),
    /// A `case` on its operand, the condition. Outside the node, each result
    /// of the first branch names the result of whichever branch ran.
    Case([Region, Region]),
    /// `Graph::repeated`, whose operands are the count and each carried value's
    /// start. Outside the node, each result of the body names what the last
    /// run left there.
    Repeat(Repeat),
    /// A value of the loop whose body holds it, which each run gives it.
    Carried,
    /// A branch's or a loop's result: its operand, in the order of results.
    Yield,
    /// The attention composite. Its value is the attended queries, and its
    /// presents are the `Part`s that read it.
    Attention(AttentionNode),
    /// The `k`th output of the node it reads, past the first.
    Part(i32),
    /// `Graph::quantized_product` over its input, weight, scales and zero
    /// points.
    QuantizedProduct(QuantizedNode),
    /// `Graph::quantized_gather` over its table, indices, scales and zero
    /// points.
    QuantizedGather(QuantizedNode),
}

/// A node: its operation, the nodes it reads, and what it holds.
pub struct RecordedNode {
    pub op: Operation,
    pub operands: List<i32>,
    pub kind: ElementKind,
    pub extents: List<i32>,
}

/// A run of nodes, in the order they compute, and what it yields.
pub struct Region {
    pub nodes: List<i32>,
    pub results: List<i32>,
}

impl Region {
    fn empty() -> Region {
        return Region { nodes: [], results: [] };
    }
}

/// A loop: its body, the node holding which run it is, and the nodes holding
/// what it carries, one for each result of the body.
pub struct Repeat {
    pub body: Region,
    pub step: i32,
    pub carried: List<i32>,
}

/// A recorded pass: every node by its id, the body that runs them, how many
/// arguments it takes, and the nodes it returns.
pub struct Recorded {
    pub nodes: List<RecordedNode>,
    pub body: Region,
    pub parameters: i32,
    /// Each decomposed attention's past over a shared buffer, and the present
    /// that buffer becomes: the same positions, and more of them valid.
    pub appended: List<[i32, i32]>,
}

/// What a `Repeat` node starts each carried value at.
pub fn carried_starts(node: &RecordedNode) -> List<i32> {
    return node.operands[1..<node.operands.len()].to_list();
}

/// A tensor of the graph being recorded: the node that computes it.
pub struct Value<E, Axes> {
    pub id: i32,
}

/// A `Graph` that records each operation rather than computing it.
pub struct Recorder {
    nodes: List<RecordedNode>,
    /// The region operations are recorded into, a branch's while it records.
    current: Region,
    parameters: i32,
    /// Whether a composite records as the operations it is made of, for a
    /// compiler with no operation for it.
    decomposes: bool,
    appended: List<[i32, i32]>,
}

impl Recorder {
    pub fn new() -> Recorder {
        return Recorder { nodes: [], current: Region::empty(), parameters: 0, decomposes: false, appended: [] };
    }

    pub fn decomposing() -> Recorder {
        return Recorder { nodes: [], current: Region::empty(), parameters: 0, decomposes: true, appended: [] };
    }

    /// The next argument of the run, of `extents`.
    pub fn parameter<E: Element, Axes>(&mut self, extents: List<i32>) -> Value<E, Axes> {
        let at = self.parameters;
        self.parameters += 1;
        return Value { id: self.added(Operation::Parameter(at), [], E::kind(), extents) };
    }

    /// The graph recorded, returning `results`.
    pub fn finished(&self, results: List<i32>) -> Recorded {
        let mut body = self.current;
        body.results = results;
        return Recorded { nodes: self.nodes, body, parameters: self.parameters, appended: self.appended };
    }

    fn added(&mut self, op: Operation, operands: List<i32>, kind: ElementKind, extents: List<i32>) -> i32 {
        let id = self.nodes.len();
        self.nodes.push(RecordedNode { op, operands, kind, extents });
        self.current.nodes.push(id);
        return id;
    }

    fn value<E, Axes>(
        &mut self,
        op: Operation,
        operands: List<i32>,
        kind: ElementKind,
        extents: List<i32>,
    ) -> Value<E, Axes> {
        return Value { id: self.added(op, operands, kind, extents) };
    }

    fn extents(&self, id: i32) -> List<i32> {
        return self.nodes[id].extents;
    }
}

/// `v`'s elements, as `Data` holds them.
internal fn data_of<E: Element>(v: &List<E>) -> Data {
    return match E::kind() {
        F32 => Data::F32(v.into_iter().map(|x| x.cast_to::<f32>()).collect()),
        F16 => Data::F16(v.into_iter().map(|x| x.cast_to::<f16>()).collect()),
        BF16 => Data::BF16(v.into_iter().map(|x| x.cast_to::<bf16>()).collect()),
        U8 => Data::U8(v.into_iter().map(|x| x.cast_to::<u8>()).collect()),
        I64 => Data::I64(v.into_iter().map(|x| x.cast_to::<i64>()).collect()),
        Bool => Data::Bool(v.into_iter().map(|x| x.cast_to::<bool>()).collect()),
    };
}

impl Holds for Recorder {
    type Tensor<E: Element, Axes> = Value<E, Axes>;

    /// A constant of the graph.
    fn upload<E: Element, Axes>(&mut self, t: &Tensor<E, Axes>) -> Value<E, Axes> {
        return self.value(Operation::Constant(data_of(&t.data)), [], E::kind(), t.extents);
    }

    fn extents_of<E: Element, Axes>(&self, t: &Value<E, Axes>) -> List<i32> {
        return self.extents(t.id);
    }

    fn download<E: Element, Axes>(&mut self, t: &Value<E, Axes>) -> Tensor<E, Axes> {
        panic("a recorded graph holds no element until it runs");
    }
}

impl Graph for Recorder {
    type Program = ();

    fn relabeled<E: Element, In, Out>(&self, t: &Value<E, In>) -> Value<E, Out> {
        return Value { id: t.id };
    }

    fn iota<E: Element, Axes>(&mut self, extents: List<i32>, dimension: i32) -> Value<E, Axes> {
        return self.value(Operation::Iota(dimension), [], E::kind(), extents);
    }

    fn convert<A: Element, B: Element, Axes>(&mut self, x: &Value<A, Axes>) -> Value<B, Axes> {
        return self.value(Operation::Convert, [x.id], B::kind(), self.extents(x.id));
    }

    fn unary<E: Float, Axes>(&mut self, op: Unary, x: &Value<E, Axes>) -> Value<E, Axes> {
        return self.value(Operation::Unary(op), [x.id], E::kind(), self.extents(x.id));
    }

    fn binary<E: Element, Axes>(&mut self, op: Binary, a: &Value<E, Axes>, b: &Value<E, Axes>) -> Value<E, Axes> {
        let extents = elementwise_extents([
            self.extents(a.id),
            self.extents(b.id),
        ]);
        return self.value(Operation::Binary(op), [a.id, b.id], E::kind(), extents);
    }

    fn compare<E: Element, Axes>(
        &mut self,
        direction: Comparison,
        a: &Value<E, Axes>,
        b: &Value<E, Axes>,
    ) -> Value<bool, Axes> {
        let extents = elementwise_extents([
            self.extents(a.id),
            self.extents(b.id),
        ]);
        return self.value(Operation::Compare(direction), [a.id, b.id], ElementKind::Bool, extents);
    }

    fn select<E: Element, Axes>(
        &mut self,
        pred: &Value<bool, Axes>,
        on_true: &Value<E, Axes>,
        on_false: &Value<E, Axes>,
    ) -> Value<E, Axes> {
        let extents = elementwise_extents([
            self.extents(pred.id),
            self.extents(on_true.id),
            self.extents(on_false.id),
        ]);
        return self.value(Operation::Select, [pred.id, on_true.id, on_false.id], E::kind(), extents);
    }

    fn broadcast_in_dim<E: Element, In, Out>(
        &mut self,
        x: &Value<E, In>,
        extents: List<i32>,
        dims: List<i32>,
    ) -> Value<E, Out> {
        let extents = broadcast_in_dim_extents(&self.extents(x.id), extents, &dims);
        return self.value(Operation::BroadcastInDim(dims), [x.id], E::kind(), extents);
    }

    fn reshape<E: Element, In, Out>(&mut self, x: &Value<E, In>, extents: List<i32>) -> Value<E, Out> {
        assert element_count(&self.extents(x.id)) == element_count(&extents), "a reshape keeps every element";
        return self.value(Operation::Reshape, [x.id], E::kind(), extents);
    }

    fn transpose<E: Element, In, Out>(&mut self, x: &Value<E, In>, perm: List<i32>) -> Value<E, Out> {
        let own = self.extents(x.id);
        let extents: List<i32> = perm.into_iter().map(|p| own[p]).collect();
        return self.value(Operation::Transpose(perm), [x.id], E::kind(), extents);
    }

    fn slice<E: Element, In, Out>(
        &mut self,
        x: &Value<E, In>,
        start: List<i32>,
        limit: List<i32>,
        strides: List<i32>,
    ) -> Value<E, Out> {
        let extents = sliced_extents(&self.extents(x.id), &start, &limit, &strides);
        return self.value(Operation::Slice([start, limit, strides]), [x.id], E::kind(), extents);
    }

    fn concatenate<E: Element, A, B, Out>(&mut self, a: &Value<E, A>, b: &Value<E, B>, dimension: i32) -> Value<E, Out> {
        let extents = joined_extents(&self.extents(a.id), &self.extents(b.id), dimension);
        return self.value(Operation::Concatenate(dimension), [a.id, b.id], E::kind(), extents);
    }

    fn reduce<E: Float, In, Out>(&mut self, x: &Value<E, In>, op: Binary, init: f32, dims: List<i32>) -> Value<E, Out> {
        let extents = reduced_extents(&self.extents(x.id), &dims);
        return self.value(Operation::Reduce([op, init, dims]), [x.id], E::kind(), extents);
    }

    fn dot_general<E: Float, A, B, Out>(
        &mut self,
        lhs: &Value<E, A>,
        rhs: &Value<E, B>,
        dims: &DotDims,
    ) -> Value<E, Out> {
        let extents = dot_extents(&self.extents(lhs.id), &self.extents(rhs.id), dims);
        return self.value(Operation::DotGeneral(*dims), [lhs.id, rhs.id], E::kind(), extents);
    }

    fn gather<E: Element, D, I, Out>(
        &mut self,
        operand: &Value<E, D>,
        indices: &Value<i64, I>,
        dims: &GatherDims,
    ) -> Value<E, Out> {
        let extents = gathered_extents(&self.extents(indices.id), dims);
        return self.value(Operation::Gather(*dims), [operand.id, indices.id], E::kind(), extents);
    }

    fn scatter<E: Element, D, I, U>(
        &mut self,
        operand: &Value<E, D>,
        indices: &Value<i64, I>,
        updates: &Value<E, U>,
        dims: &ScatterDims,
    ) -> Value<E, D> {
        let extents = self.extents(operand.id);
        return self.value(Operation::Scatter(*dims), [operand.id, indices.id, updates.id], E::kind(), extents);
    }

    fn convolution<E: Float, In, K, Out>(
        &mut self,
        x: &Value<E, In>,
        kernel: &Value<E, K>,
        conv: &Convolution,
    ) -> Value<E, Out> {
        let [input, weights] = [
            self.extents(x.id),
            self.extents(kernel.id),
        ];
        let mut extents: List<i32> = [input[0], weights[0]];
        extents.extend(&conv_window(&input, &weights, conv).output);
        return self.value(Operation::Convolution(*conv), [x.id, kernel.id], E::kind(), extents);
    }

    fn reduce_window<E: Float, In, Out>(
        &mut self,
        x: &Value<E, In>,
        op: Binary,
        init: f32,
        window: &WindowReduce,
    ) -> Value<E, Out> {
        let input = self.extents(x.id);
        let mut extents: List<i32> = [input[0], input[1]];
        extents.extend(&pooled_window(&input, window).output);
        return self.value(Operation::ReduceWindow([op, init, *window]), [x.id], E::kind(), extents);
    }

    fn reverse<E: Element, Axes>(&mut self, x: &Value<E, Axes>, dims: List<i32>) -> Value<E, Axes> {
        return self.value(Operation::Reverse(dims), [x.id], E::kind(), self.extents(x.id));
    }

    fn arg_max<E: Float, Axes>(&mut self, x: &Value<E, Axes>, axis: i32) -> Value<i64, Axes> {
        let mut extents = self.extents(x.id);
        extents[axis] = 1;
        return self.value(Operation::ArgMax(axis), [x.id], ElementKind::I64, extents);
    }

    /// Records each branch into a region of its own, each yielding its
    /// results by `yielded`, and returns the first branch's, which name the
    /// case's outside it.
    fn conditional<Axes, T>(
        &mut self,
        pred: &Value<bool, Axes>,
        then: fn() -> T with _,
        otherwise: fn() -> T with _,
    ) -> T with _ {
        let outer = self.current;
        self.current = Region::empty();
        let taken = then();
        let first = self.current;
        self.current = Region::empty();
        otherwise();
        let second = self.current;
        self.current = outer;
        assert first.results.len() == second.results.len(), "both branches yield as many results";
        self.added(Operation::Case([first, second]), [pred.id], ElementKind::Bool, []);
        return taken;
    }

    fn yielded<E: Element, Axes>(&mut self, x: &Value<E, Axes>) -> Value<E, Axes> {
        let id = self.added(Operation::Yield, [x.id], E::kind(), self.extents(x.id));
        self.current.results.push(id);
        return Value { id };
    }

    fn taken<T>(&mut self, branch: fn() -> T with _) -> T with _ {
        let results = self.current.results.len();
        let value = branch();
        self.current.results.truncate(results);
        return value;
    }

    /// Records the body into a region of its own, over a node for which run it
    /// is and one for each carried value, each result yielded, so it names
    /// the loop's outside it whatever the body returns.
    fn repeated(
        &mut self,
        count: &Value<i64, []>,
        initial: &List<Any<Recorder>>,
        body: fn(&Value<i64, []>, &List<Any<Recorder>>) -> List<Any<Recorder>> with _,
    ) -> List<Any<Recorder>> with _ {
        let outer = self.current;
        self.current = Region::empty();
        let step = self.added(Operation::Carried, [], ElementKind::I64, []);
        let mut carried: List<i32> = [];
        for let start of initial {
            let node = &self.nodes[node_of(start)];
            carried.push(self.added(Operation::Carried, [], node.kind, node.extents));
        }
        let state: List<Any<Recorder>> = carried.into_iter().map(|id| any_at(self.nodes[id].kind, id)).collect();
        let returned = body(&Value { id: step }, &state);
        assert_carries(self, &state, &returned);
        for let r of &returned {
            let node = &self.nodes[node_of(r)];
            self.current.results.push(self.added(Operation::Yield, [node_of(r)], node.kind, node.extents));
        }
        let region = self.current;
        self.current = outer;
        let mut operands: List<i32> = [count.id];
        for let start of initial {
            operands.push(node_of(start));
        }
        self.added(Operation::Repeat(Repeat { body: region, step, carried }), operands, ElementKind::Bool, []);
        return region.results.into_iter().map(|id| any_at(self.nodes[id].kind, id)).collect();
    }

    fn group_query_attention<E: Float, B, S, Q, K, H, P, T, D, Pos, Half, BB, BH, BS, SH>(
        &mut self,
        q: &Value<E, [B, S, Q]>,
        k: &Value<E, [B, S, K]>,
        v: &Value<E, [B, S, K]>,
        past_k: &Value<E, [B, H, P, D]>,
        past_v: &Value<E, [B, H, P, D]>,
        past_length: Option<&Value<i64, [Slots]>>,
        reach: Option<&Value<i64, [Slots]>>,
        cos: Option<&Value<E, [Pos, Half]>>,
        sin: Option<&Value<E, [Pos, Half]>>,
        bias: Option<&Value<E, [BB, BH, BS, T]>>,
        sinks: Option<&Value<E, [SH]>>,
        options: &Attention,
    ) -> [Value<E, [B, S, Q]>, Value<E, [B, H, T, D]>, Value<E, [B, H, T, D]>] {
        if self.decomposes {
            let attended = decomposed_attention::<Recorder, E, B, S, Q, K, H, P, T, D, Pos, Half, BB, BH, BS, SH>(
                self,
                q,
                k,
                v,
                past_k,
                past_v,
                past_length,
                reach,
                cos,
                sin,
                bias,
                sinks,
                options,
            );
            if past_length matches { Some(_) } {
                self.appended.push([past_k.id, attended.1.id]);
                self.appended.push([past_v.id, attended.2.id]);
            }
            return attended;
        }
        let mut operands: List<i32> = [q.id, k.id, v.id, past_k.id, past_v.id];
        let mut node = AttentionNode {
            options: *options,
            shared: false,
            bounded: false,
            rotary: false,
            biased: false,
            sunk: false,
        };
        if let Some(l) = past_length {
            operands.push(l.id);
            node.shared = true;
        }
        if let Some(l) = reach {
            operands.push(l.id);
            node.bounded = true;
        }
        if let Some(c) = cos && let Some(n) = sin {
            operands.push(c.id);
            operands.push(n.id);
            node.rotary = true;
        }
        if let Some(b) = bias {
            operands.push(b.id);
            node.biased = true;
        }
        if let Some(h) = sinks {
            operands.push(h.id);
            node.sunk = true;
        }
        let mut present = self.extents(past_k.id);
        if !node.shared {
            present[2] += self.extents(q.id)[1];
        }
        let attended = self.added(Operation::Attention(node), operands, E::kind(), self.extents(q.id));
        return [
            Value { id: attended },
            self.value(Operation::Part(1), [attended], E::kind(), present),
            self.value(Operation::Part(2), [attended], E::kind(), present),
        ];
    }

    fn quantized_product<E: Float, In, N, Blocks, Blob, Z, Out>(
        &mut self,
        a: &Value<E, In>,
        packed: &Value<u8, [N, Blocks, Blob]>,
        scales: &Value<E, [N, Blocks]>,
        zero_points: Option<&Value<u8, [N, Z]>>,
        quantized: &Quantized,
    ) -> Value<E, Out> {
        if self.decomposes {
            return decomposed_product::<Recorder, E, In, N, Blocks, Blob, Z, Out>(
                self,
                a,
                packed,
                scales,
                zero_points,
                quantized,
            );
        }
        let mut extents = self.extents(a.id);
        extents[extents.len() - 1] = self.extents(packed.id)[0];
        let [node, read] = quantized_read([a.id, packed.id, scales.id], zero_points, quantized);
        return self.value(Operation::QuantizedProduct(node), read, E::kind(), extents);
    }

    fn quantized_gather<E: Float, R, P, I, Blocks, Z, Out>(
        &mut self,
        packed: &Value<u8, [R, P]>,
        indices: &Value<i64, I>,
        scales: &Value<E, [R, Blocks]>,
        zero_points: Option<&Value<u8, [R, Z]>>,
        quantized: &Quantized,
    ) -> Value<E, Out> {
        if self.decomposes {
            return decomposed_gather::<Recorder, E, R, P, I, Blocks, Z, Out>(
                self,
                packed,
                indices,
                scales,
                zero_points,
                quantized,
            );
        }
        let mut extents = self.extents(indices.id);
        extents.push(self.extents(packed.id)[1] * (8 / quantized.bits));
        let [node, read] = quantized_read([packed.id, indices.id, scales.id], zero_points, quantized);
        return self.value(Operation::QuantizedGather(node), read, E::kind(), extents);
    }
}

/// A quantized composite's attributes, and the nodes it reads: `operands`,
/// then `zero_points` where given.
fn quantized_read<ZeroAxes>(
    operands: List<i32>,
    zero_points: Option<&Value<u8, ZeroAxes>>,
    quantized: &Quantized,
) -> [QuantizedNode, List<i32>] {
    let mut read = operands;
    if let Some(z) = zero_points {
        read.push(z.id);
    }
    return [
        QuantizedNode { quantized: *quantized, zero_points: zero_points matches { Some(_) } },
        read,
    ];
}

/// The node `a` is the value of.
fn node_of(a: &Any<Recorder>) -> i32 {
    return match a {
        F32(v) => v.id,
        F16(v) => v.id,
        BF16(v) => v.id,
        U8(v) => v.id,
        I64(v) => v.id,
        Bool(v) => v.id,
    };
}

/// The node `id`, of an element of `kind`.
fn any_at(kind: ElementKind, id: i32) -> Any<Recorder> {
    return match kind {
        F32 => Any::F32(Value { id }),
        F16 => Any::F16(Value { id }),
        BF16 => Any::BF16(Value { id }),
        U8 => Any::U8(Value { id }),
        I64 => Any::I64(Value { id }),
        Bool => Any::Bool(Value { id }),
    };
}

/// The axes every tensor `run` computes with, which a `Graph` reads only
/// through extents.
pub struct Untyped {
}

/// A tensor of the graph `G` builds, whichever element it holds: what a
/// program takes and returns.
pub variant Any<affine G: Holds> {
    F32(G::Tensor<f32, Untyped>),
    F16(G::Tensor<f16, Untyped>),
    BF16(G::Tensor<bf16, Untyped>),
    U8(G::Tensor<u8, Untyped>),
    I64(G::Tensor<i64, Untyped>),
    Bool(G::Tensor<bool, Untyped>),
}

/// The element `a` holds.
pub fn kind_of<affine G: Holds>(a: &Any<G>) -> ElementKind {
    return match a {
        F32(_) => ElementKind::F32,
        F16(_) => ElementKind::F16,
        BF16(_) => ElementKind::BF16,
        U8(_) => ElementKind::U8,
        I64(_) => ElementKind::I64,
        Bool(_) => ElementKind::Bool,
    };
}

/// An element with a case of `Any`.
pub trait Erasable: Element with () {
    /// `t` as `Any` holds it.
    fn any<affine G: Holds>(t: G::Tensor<Self, Untyped>) -> Any<G>;
    /// The tensor `a` holds, which must be of this element.
    fn of_any<affine G: Holds>(a: &Any<G>) -> &G::Tensor<Self, Untyped>;
}

impl Erasable for f32 {
    fn any<affine G: Holds>(t: G::Tensor<f32, Untyped>) -> Any<G> {
        return Any::F32(t);
    }

    fn of_any<affine G: Holds>(a: &Any<G>) -> &G::Tensor<f32, Untyped> {
        return f32s(a);
    }
}

impl Erasable for f16 {
    fn any<affine G: Holds>(t: G::Tensor<f16, Untyped>) -> Any<G> {
        return Any::F16(t);
    }

    fn of_any<affine G: Holds>(a: &Any<G>) -> &G::Tensor<f16, Untyped> {
        let F16(t) = a else {
            unreachable();
        };
        return t;
    }
}

impl Erasable for bf16 {
    fn any<affine G: Holds>(t: G::Tensor<bf16, Untyped>) -> Any<G> {
        return Any::BF16(t);
    }

    fn of_any<affine G: Holds>(a: &Any<G>) -> &G::Tensor<bf16, Untyped> {
        let BF16(t) = a else {
            unreachable();
        };
        return t;
    }
}

impl Erasable for u8 {
    fn any<affine G: Holds>(t: G::Tensor<u8, Untyped>) -> Any<G> {
        return Any::U8(t);
    }

    fn of_any<affine G: Holds>(a: &Any<G>) -> &G::Tensor<u8, Untyped> {
        let U8(t) = a else {
            unreachable();
        };
        return t;
    }
}

impl Erasable for i64 {
    fn any<affine G: Holds>(t: G::Tensor<i64, Untyped>) -> Any<G> {
        return Any::I64(t);
    }

    fn of_any<affine G: Holds>(a: &Any<G>) -> &G::Tensor<i64, Untyped> {
        return i64s(a);
    }
}

impl Erasable for bool {
    fn any<affine G: Holds>(t: G::Tensor<bool, Untyped>) -> Any<G> {
        return Any::Bool(t);
    }

    fn of_any<affine G: Holds>(a: &Any<G>) -> &G::Tensor<bool, Untyped> {
        return bools(a);
    }
}

/// `t` as `Cpu` holds it among a program's arguments.
pub fn host_of<E: Element, Axes>(t: &Tensor<E, Axes>) -> Any<Cpu> {
    return match data_of(&t.data) {
        F32(data) => Any::F32(Tensor { data, extents: t.extents }),
        F16(data) => Any::F16(Tensor { data, extents: t.extents }),
        BF16(data) => Any::BF16(Tensor { data, extents: t.extents }),
        U8(data) => Any::U8(Tensor { data, extents: t.extents }),
        I64(data) => Any::I64(Tensor { data, extents: t.extents }),
        Bool(data) => Any::Bool(Tensor { data, extents: t.extents }),
    };
}

/// `value`, held on the host, as `h` keeps it.
pub fn kept_any<affine H: Holds>(h: &mut H, value: &Any<Cpu>) -> Any<H> with _ {
    return match value {
        F32(t) => Any::F32(h.keep(t)),
        F16(t) => Any::F16(h.keep(t)),
        BF16(t) => Any::BF16(h.keep(t)),
        U8(t) => Any::U8(h.keep(t)),
        I64(t) => Any::I64(h.keep(t)),
        Bool(t) => Any::Bool(h.keep(t)),
    };
}

/// `a`, which must hold `E`, under the axes `Axes`.
pub fn typed<affine G: Graph, E: Erasable, Axes>(g: &G, a: &Any<G>) -> G::Tensor<E, Axes> {
    return g.relabeled::<E, Untyped, Axes>(E::of_any::<G>(a));
}

/// `a`'s extents.
fn extents_of_any<affine G: Graph>(g: &G, a: &Any<G>) -> List<i32> with _ {
    return match a {
        F32(t) => g.extents_of(t),
        F16(t) => g.extents_of(t),
        BF16(t) => g.extents_of(t),
        U8(t) => g.extents_of(t),
        I64(t) => g.extents_of(t),
        Bool(t) => g.extents_of(t),
    };
}

/// Holds a loop's body, which took `held`, to the values it `returned`.
pub fn assert_carries<affine G: Graph>(g: &G, held: &List<Any<G>>, returned: &List<Any<G>>) with _ {
    assert returned.len() == held.len(), "a loop's body returns each value it carries";
    for let [k, r] of returned.into_iter().enumerate() {
        assert kind_of(r) == kind_of(&held[k]) && extents_of_any(g, r) == extents_of_any(g, &held[k]), "a run returns what the next one takes";
    }
}

/// The programs a backend compiled, one for each shape class: the extents of
/// the arguments that vary between calls. The weights the programs take
/// after those are one model's, the same on every call, and erased once.
pub struct Programs<affine G: Graph> {
    held: HashMap<List<List<i32>>, G::Program>,
    weights: Option<List<Any<G>>>,
}

impl<affine G: Graph> Programs<G> {
    pub fn new() -> Programs<G> {
        return Programs { held: HashMap::new(), weights: null };
    }

    /// How many shape classes a program is held for.
    pub fn len(&self) -> i32 {
        return self.held.len();
    }

    /// What the program of `class` returns over `arguments()` and the
    /// `weights()` of the first call, compiled from what `record` records
    /// over their extents where none is held yet; `None` where `g` compiles
    /// nothing, and builds itself.
    pub fn run(
        &mut self,
        g: &mut G,
        class: List<List<i32>>,
        record: fn(&mut Recorder, &List<List<i32>>) -> Recorded,
        arguments: fn() -> List<Any<G>> with _,
        weights: fn() -> List<Any<G>> with _,
    ) -> Option<List<Any<G>>> with _ {
        if self.weights matches { None } {
            self.weights = Option::Some(weights());
        }
        let Some(erased) = &self.weights else {
            unreachable();
        };
        if !self.held.contains_key(class) {
            let mut earlier: List<&G::Program> = [];
            for let c of self.held.keys() {
                earlier.push(&self.held[*c]);
            }
            let Some(program) = g.compiled(|r| {
                let mut extents: List<List<i32>> = arguments().into_iter().map(|a| extents_of_any(g, &a)).collect();
                for let w of erased {
                    extents.push(extents_of_any(g, w));
                }
                return record(r, &extents);
            }, erased, &earlier) else {
                return null;
            };
            self.held[class] = program;
        }
        return Option::Some(g.executed(&self.held[class], &arguments(), erased));
    }
}

/// `recorded` run on `g` over `arguments`, each node computed by `g`'s
/// `Graph`. On `Cpu` it is what a device's compiled program must compute.
pub fn run<affine G: Graph>(g: &mut G, recorded: &Recorded, arguments: &List<Any<G>>) -> List<Any<G>> with _
    contract arguments.len() == recorded.parameters
{
    return Run::<G>::new(recorded, arguments, &[], &HashMap::new()).region(g, recorded, &recorded.body);
}

/// The value of each node of `recorded` that reads no argument, computed on
/// `Cpu`: what a program computes once, when it is compiled.
pub fn constants(recorded: &Recorded) -> HashMap<i32, Any<Cpu>> {
    let mut cpu = Cpu {};
    let mut state = Run::<Cpu>::new(recorded, &[], &[], &HashMap::new());
    let mut folded = HashMap::<i32, Any<Cpu>>::new();
    for let id of 0..<recorded.nodes.len() {
        let node = &recorded.nodes[id];
        let reads_none = match &node.op {
            Parameter(_) | Case(_) | Repeat(_) | Carried | Yield | Attention(_) | Part(_) => false,
            _ => node.operands.into_iter().all(|o| state.values.holds(o)),
        };
        if reads_none {
            let value = state.computed(&mut cpu, id, node);
            folded[id] = value;
            state.values[id] = value;
        }
    }
    return folded;
}

/// The values a run has computed, each by its node's id.
internal struct Run<affine G: Graph> {
    internal values: Values<G>,
    /// Each attention node's presents, which its `Part`s read.
    parts: HashMap<i32, List<Any<G>>>,
}

/// Each node's value, by its id, where a run has computed one: a slot for
/// every node of the recording, since a call computes most of them. A
/// parameter reads the call's argument or weight and a constant the
/// program's, in place, so a call copies none of them.
internal struct Values<affine G: Graph> {
    at: List<Option<Any<G>>>,
    recorded: &Recorded,
    arguments: &List<Any<G>>,
    weights: &List<Any<G>>,
    constants: &HashMap<i32, Any<G>>,
}

impl<affine G: Graph> Values<G> {
    /// Whether node `id` has a value that reads no argument.
    internal fn holds(&self, id: i32) -> bool {
        return self.at[id] matches { Some(_) } || self.constants.contains_key(id);
    }
}

impl<affine G: Graph> IndexRef<i32> for Values<G> {
    type Output = Any<G>;

    fn index_ref(&self, id: i32) -> &Any<G> {
        if let Some(value) = &self.at[id] {
            return value;
        }
        if let Parameter(i) = &self.recorded.nodes[id].op {
            let given = self.arguments.len();
            return if *i < given { &self.arguments[*i] } else { &self.weights[*i - given] };
        }
        if !self.constants.contains_key(id) {
            panic("loam: a node is read before it is computed");
        }
        return &self.constants[id];
    }
}

impl<affine G: Graph> IndexValue<i32> for Values<G> {
    type Output = Any<G>;

    fn index_value(&self, id: i32) -> Any<G> {
        return *self.index_ref(id);
    }
}

impl<affine G: Graph> IndexAssign<i32> for Values<G> {
    type Output = Any<G>;

    fn index_assign(&mut self, id: i32, value: Any<G>) {
        self.at[id] = Option::Some(value);
    }
}

impl<affine G: Graph> Run<G> {
    /// A run of `recorded` over `arguments` and then `weights`, which reads
    /// the constants in `computed` as computed.
    internal fn new(
        recorded: &Recorded,
        arguments: &List<Any<G>>,
        weights: &List<Any<G>>,
        computed: &HashMap<i32, Any<G>>,
    ) -> Run<G> {
        return Run {
            values: Values {
                at: List::<Option<Any<G>>>::filled(recorded.nodes.len(), null),
                recorded,
                arguments,
                weights,
                constants: computed,
            },
            parts: HashMap::new(),
        };
    }

    /// Runs `region`'s nodes, and returns what it yields.
    fn region(&mut self, g: &mut G, recorded: &Recorded, region: &Region) -> List<Any<G>> with _ {
        for let id of region.nodes {
            let node = &recorded.nodes[id];
            if let Case([first, second]) = &node.op {
                let pred = *bools(&self.values[node.operands[0]]);
                let yielded = g.conditional::<Untyped, List<Any<G>>>(
                    &pred,
                    || self.region(g, recorded, first),
                    || self.region(g, recorded, second),
                );
                for let [k, result] of first.results.into_iter().enumerate() {
                    self.values[result] = yielded[k];
                }
                continue;
            }
            if let Repeat(repeat) = &node.op {
                let initial: List<Any<G>> = carried_starts(node).into_iter().map(|o| self.values[o]).collect();
                let count = g.relabeled::<i64, Untyped, []>(i64s(&self.values[node.operands[0]]));
                let last = g.repeated(&count, &initial, |step, state| {
                    self.values[repeat.step] = Any::I64(g.relabeled::<i64, [], Untyped>(step));
                    for let [k, carried] of repeat.carried.into_iter().enumerate() {
                        self.values[carried] = state[k];
                    }
                    return self.region(g, recorded, &repeat.body);
                });
                for let [k, result] of repeat.body.results.into_iter().enumerate() {
                    self.values[result] = last[k];
                }
                continue;
            }
            self.ran(g, id, node);
        }
        return region.results.into_iter().map(|r| self.values[r]).collect();
    }

    /// Gives node `id` its value: a parameter's is the argument `values`
    /// reads, a part's and a yielded one's are read, every other node's
    /// computed.
    internal fn ran(&mut self, g: &mut G, id: i32, node: &RecordedNode) with _ {
        match &node.op {
            Parameter(_) | Carried => {
            },
            Part(k) => {
                self.values[id] = self.parts[node.operands[0]][*k - 1];
            },
            Yield => {
                self.values[id] = self.values[node.operands[0]];
            },
            _ => {
                let value = self.computed(g, id, node);
                self.values[id] = value;
            },
        }
    }

    fn operand(&self, node: &RecordedNode, i: i32) -> &Any<G> {
        return &self.values[node.operands[i]];
    }

    /// The `i`th operand, of the element `E`.
    fn of<E: Erasable>(&self, node: &RecordedNode, i: i32) -> &G::Tensor<E, Untyped> {
        return E::of_any::<G>(self.operand(node, i));
    }

    /// The `i`th operand under the axes the composite's signature spells.
    fn at<E: Erasable, Axes>(&self, g: &G, node: &RecordedNode, i: i32) -> G::Tensor<E, Axes> {
        return g.relabeled::<E, Untyped, Axes>(self.of::<E>(node, i));
    }

    /// The element type is settled once a node, here: by what the node
    /// computes over, its operands' where its own differs.
    fn computed(&mut self, g: &mut G, id: i32, node: &RecordedNode) -> Any<G> with _ {
        if let Constant(data) = &node.op {
            return match data {
                F32(v) => Any::F32(g.upload(&Tensor::<f32, Untyped> { data: *v, extents: node.extents })),
                F16(v) => Any::F16(g.upload(&Tensor::<f16, Untyped> { data: *v, extents: node.extents })),
                BF16(v) => Any::BF16(g.upload(&Tensor::<bf16, Untyped> { data: *v, extents: node.extents })),
                U8(v) => Any::U8(g.upload(&Tensor::<u8, Untyped> { data: *v, extents: node.extents })),
                I64(v) => Any::I64(g.upload(&Tensor::<i64, Untyped> { data: *v, extents: node.extents })),
                Bool(v) => Any::Bool(g.upload(&Tensor::<bool, Untyped> { data: *v, extents: node.extents })),
            };
        }
        let over = if node.op matches { Convert | Compare(_) | ArgMax(_) } {
            kind_of(self.operand(node, 0));
        } else {
            node.kind;
        };
        if node.op matches { Unary(_) | Reduce(_) | DotGeneral(_) | Convolution(_) | ReduceWindow(_) | ArgMax(_) | Attention(_) | QuantizedProduct(_) | QuantizedGather(_) } {
            return match over {
                F32 => self.computed_in::<f32>(g, id, node),
                F16 => self.computed_in::<f16>(g, id, node),
                BF16 => self.computed_in::<bf16>(g, id, node),
                U8 | I64 | Bool => unreachable(),
            };
        }
        return match over {
            F32 => self.computed_of::<f32>(g, node),
            F16 => self.computed_of::<f16>(g, node),
            BF16 => self.computed_of::<bf16>(g, node),
            U8 => self.computed_of::<u8>(g, node),
            I64 => self.computed_of::<i64>(g, node),
            Bool => self.computed_of::<bool>(g, node),
        };
    }

    /// A node any element computes, over `E`.
    fn computed_of<E: Erasable>(&self, g: &mut G, node: &RecordedNode) -> Any<G> with _ {
        return match &node.op {
            Iota(dimension) => E::any::<G>(g.iota::<E, Untyped>(node.extents, *dimension)),
            Convert => match node.kind {
                F32 => Any::F32(g.convert::<E, f32, Untyped>(self.of::<E>(node, 0))),
                F16 => Any::F16(g.convert::<E, f16, Untyped>(self.of::<E>(node, 0))),
                BF16 => Any::BF16(g.convert::<E, bf16, Untyped>(self.of::<E>(node, 0))),
                U8 => Any::U8(g.convert::<E, u8, Untyped>(self.of::<E>(node, 0))),
                I64 => Any::I64(g.convert::<E, i64, Untyped>(self.of::<E>(node, 0))),
                Bool => Any::Bool(g.convert::<E, bool, Untyped>(self.of::<E>(node, 0))),
            },
            Binary(op) => E::any::<G>(g.binary::<E, Untyped>(*op, self.of::<E>(node, 0), self.of::<E>(node, 1))),
            Compare(direction) => Any::Bool(g.compare::<E, Untyped>(
                *direction,
                self.of::<E>(node, 0),
                self.of::<E>(node, 1),
            )),
            Select => E::any::<G>(g.select::<E, Untyped>(
                bools(self.operand(node, 0)),
                self.of::<E>(node, 1),
                self.of::<E>(node, 2),
            )),
            BroadcastInDim(_) | Reshape | Transpose(_) | Slice(_) | Reverse(_) => E::any::<G>(regrouped::<G, E>(
                g,
                node,
                self.of::<E>(node, 0),
            )),
            Concatenate(dimension) => E::any::<G>(g.concatenate::<E, Untyped, Untyped, Untyped>(
                self.of::<E>(node, 0),
                self.of::<E>(node, 1),
                *dimension,
            )),
            Gather(dims) => E::any::<G>(g.gather::<E, Untyped, Untyped, Untyped>(
                self.of::<E>(node, 0),
                i64s(self.operand(node, 1)),
                dims,
            )),
            Scatter(dims) => E::any::<G>(g.scatter::<E, Untyped, Untyped, Untyped>(
                self.of::<E>(node, 0),
                i64s(self.operand(node, 1)),
                self.of::<E>(node, 2),
                dims,
            )),
            _ => unreachable(),
        };
    }

    /// A node only a float computes, in `E`.
    fn computed_in<E: Erasable + Float>(&mut self, g: &mut G, id: i32, node: &RecordedNode) -> Any<G> with _ {
        return match &node.op {
            Unary(op) => E::any::<G>(g.unary::<E, Untyped>(*op, self.of::<E>(node, 0))),
            Reduce([op, init, dims]) => E::any::<G>(g.reduce::<E, Untyped, Untyped>(
                self.of::<E>(node, 0),
                *op,
                *init,
                *dims,
            )),
            DotGeneral(dims) => E::any::<G>(g.dot_general::<E, Untyped, Untyped, Untyped>(
                self.of::<E>(node, 0),
                self.of::<E>(node, 1),
                dims,
            )),
            Convolution(conv) => E::any::<G>(g.convolution::<E, Untyped, Untyped, Untyped>(
                self.of::<E>(node, 0),
                self.of::<E>(node, 1),
                conv,
            )),
            ReduceWindow([op, init, window]) => E::any::<G>(g.reduce_window::<E, Untyped, Untyped>(
                self.of::<E>(node, 0),
                *op,
                *init,
                window,
            )),
            ArgMax(axis) => Any::I64(g.arg_max::<E, Untyped>(self.of::<E>(node, 0), *axis)),
            Attention(attention) => {
                let [attended, present_k, present_v] = self.attended::<E>(g, node, attention);
                self.parts[id] = [present_k, present_v];
                attended;
            },
            QuantizedProduct(q) => E::any::<G>(
                g.quantized_product::<E, Untyped, Untyped, Untyped, Untyped, Untyped, Untyped>(
                    self.of::<E>(node, 0),
                    &self.at(g, node, 1),
                    &self.at(g, node, 2),
                    optional(&self.zero_points_at(g, node, q)),
                    &q.quantized,
                ),
            ),
            QuantizedGather(q) => E::any::<G>(
                g.quantized_gather::<E, Untyped, Untyped, Untyped, Untyped, Untyped, Untyped>(
                    &self.at(g, node, 0),
                    i64s(self.operand(node, 1)),
                    &self.at(g, node, 2),
                    optional(&self.zero_points_at(g, node, q)),
                    &q.quantized,
                ),
            ),
            _ => unreachable(),
        };
    }

    /// A quantized node's zero points, its last operand where it has them.
    fn zero_points_at(&self, g: &G, node: &RecordedNode, q: &QuantizedNode) -> Option<G::Tensor<u8, [Untyped, Untyped]>> {
        if !q.zero_points {
            return null;
        }
        return Option::Some(self.at(g, node, 3));
    }

    /// The length at `node`'s operand `next` where it is `given`, which then
    /// steps past it.
    fn length_at(
        &self,
        g: &mut G,
        node: &RecordedNode,
        given: bool,
        next: &mut i32,
    ) -> Option<G::Tensor<i64, [Slots]>> with _ {
        if !given {
            return null;
        }
        *next += 1;
        return Option::Some(typed::<G, i64, [Slots]>(g, self.operand(node, *next - 1)));
    }

    /// An attention node's attended queries and presents, by `g`'s
    /// `group_query_attention`.
    fn attended<E: Erasable + Float>(
        &self,
        g: &mut G,
        node: &RecordedNode,
        attention: &AttentionNode,
    ) -> [Any<G>, Any<G>, Any<G>] with _ {
        let mut next = 5;
        let past_length = self.length_at(g, node, attention.shared, &mut next);
        let bound = self.length_at(g, node, attention.bounded, &mut next);
        let [cos, sin]: [Option<G::Tensor<E, [Untyped, Untyped]>>, Option<G::Tensor<E, [Untyped, Untyped]>>] = if attention.rotary {
            next += 2;
            [
                Option::Some(self.at(g, node, next - 2)),
                Option::Some(self.at(g, node, next - 1)),
            ];
        } else {
            [null, null];
        };
        let bias: Option<G::Tensor<E, [Untyped, Untyped, Untyped, Untyped]>> = if attention.biased {
            next += 1;
            Option::Some(self.at(g, node, next - 1));
        } else {
            null;
        };
        let sinks: Option<G::Tensor<E, [Untyped]>> = if attention.sunk {
            Option::Some(self.at(g, node, next));
        } else {
            null;
        };
        let [a, k, v] = g.group_query_attention::<E, Untyped, Untyped, Untyped, Untyped, Untyped, Untyped, Untyped, Untyped, Untyped, Untyped, Untyped, Untyped, Untyped, Untyped>(
            &self.at(g, node, 0),
            &self.at(g, node, 1),
            &self.at(g, node, 2),
            &self.at(g, node, 3),
            &self.at(g, node, 4),
            optional(&past_length),
            optional(&bound),
            optional(&cos),
            optional(&sin),
            optional(&bias),
            optional(&sinks),
            &attention.options,
        );
        return [
            E::any::<G>(g.relabeled::<E, [Untyped, Untyped, Untyped], Untyped>(&a)),
            E::any::<G>(g.relabeled::<E, [Untyped, Untyped, Untyped, Untyped], Untyped>(&k)),
            E::any::<G>(g.relabeled::<E, [Untyped, Untyped, Untyped, Untyped], Untyped>(&v)),
        ];
    }
}

fn f32s<affine G: Holds>(a: &Any<G>) -> &G::Tensor<f32, Untyped> {
    let F32(t) = a else {
        unreachable();
    };
    return t;
}

fn i64s<affine G: Holds>(a: &Any<G>) -> &G::Tensor<i64, Untyped> {
    let I64(t) = a else {
        unreachable();
    };
    return t;
}

internal fn bools<affine G: Holds>(a: &Any<G>) -> &G::Tensor<bool, Untyped> {
    let Bool(t) = a else {
        unreachable();
    };
    return t;
}

/// A node that moves its one operand's elements, over `t`.
fn regrouped<affine G: Graph, E: Element>(
    g: &mut G,
    node: &RecordedNode,
    t: &G::Tensor<E, Untyped>,
) -> G::Tensor<E, Untyped> with _ {
    return match node.op {
        BroadcastInDim(dims) => g.broadcast_in_dim::<E, Untyped, Untyped>(t, node.extents, dims),
        Reshape => g.reshape::<E, Untyped, Untyped>(t, node.extents),
        Transpose(perm) => g.transpose::<E, Untyped, Untyped>(t, perm),
        Slice([start, limit, strides]) => g.slice::<E, Untyped, Untyped>(t, start, limit, strides),
        Reverse(dims) => g.reverse::<E, Untyped>(t, dims),
        _ => unreachable(),
    };
}
