//! A pass recorded as a graph of the operations `Graph` names, for a device's
//! compiler to lower, and which `Cpu` runs node by node to hold that compiler
//! to what the operations mean.

use { HashMap } from "core:collections";
use {
    Binary,
    Comparison,
    Convolution,
    DotDims,
    GatherDims,
    Graph,
    ScatterDims,
    Unary,
    WindowReduce,
    broadcast_in_dim_extents,
    conv_window,
    dot_extents,
    elementwise_extents,
    gathered_extents,
    joined_extents,
    pooled_window,
    reduced_extents,
    sliced_extents,
} from "./hlo.wado";
use { Attention, Cpu, Element, ElementKind, Holds, Tensor, element_count, optional } from "./tensor.wado";

/// A tensor's elements, whichever element it holds.
pub variant Data {
    F32(List<f32>),
    I64(List<i64>),
    Bool(List<bool>),
}

/// What an attention node takes beside its query, key, value and past: the
/// options, and which of its optional operands follow them, in this order.
pub struct AttentionNode {
    pub options: Attention,
    pub shared: bool,
    pub rotary: bool,
    pub biased: bool,
}

/// One operation of a recorded graph, with the attributes `Graph`'s method
/// takes beside its operands.
pub variant Operation {
    /// The run's `i`th argument.
    Parameter(i32),
    Constant(Data),
    Iota(i32),
    Convert,
    Unary(Unary),
    Binary(Binary),
    Compare(Comparison),
    Select,
    BroadcastInDim(List<i32>),
    Reshape,
    Transpose(List<i32>),
    /// The start, the limit and the stride of each axis.
    Slice([List<i32>, List<i32>, List<i32>]),
    Concatenate(i32),
    Reduce([Binary, f32, List<i32>]),
    DotGeneral(DotDims),
    Gather(GatherDims),
    Scatter(ScatterDims),
    Convolution(Convolution),
    ReduceWindow([Binary, f32, WindowReduce]),
    Reverse(List<i32>),
    /// A `case` on its operand, the condition. Outside the node, each result
    /// of the first branch names the result of whichever branch ran.
    Case([Region, Region]),
    /// A branch's result: its operand, in the branch's order of results.
    Yield,
    /// The attention composite. Its value is the attended queries, and its
    /// presents are the `Part`s that read it.
    Attention(AttentionNode),
    /// The `k`th output of the node it reads, past the first.
    Part(i32),
}

/// A node: its operation, the nodes it reads, and what it holds.
pub struct RecordedNode {
    pub op: Operation,
    pub operands: List<i32>,
    pub kind: ElementKind,
    pub extents: List<i32>,
}

/// A run of nodes, in the order they compute, and what it yields.
pub struct Region {
    pub nodes: List<i32>,
    pub results: List<i32>,
}

impl Region {
    fn empty() -> Region {
        return Region { nodes: [], results: [] };
    }
}

/// A recorded pass: every node by its id, the body that runs them, how many
/// arguments it takes, and the nodes it returns.
pub struct Recorded {
    pub nodes: List<RecordedNode>,
    pub body: Region,
    pub parameters: i32,
}

/// A tensor of the graph being recorded: the node that computes it.
pub struct Value<E, Axes> {
    pub id: i32,
}

/// A `Graph` that records each operation rather than computing it.
pub struct Recorder {
    nodes: List<RecordedNode>,
    /// The region operations are recorded into, a branch's while it records.
    current: Region,
    parameters: i32,
}

impl Recorder {
    pub fn new() -> Recorder {
        return Recorder { nodes: [], current: Region::empty(), parameters: 0 };
    }

    /// The next argument of the run, of `extents`.
    pub fn parameter<E: Element, Axes>(&mut self, extents: List<i32>) -> Value<E, Axes> {
        let at = self.parameters;
        self.parameters += 1;
        return Value { id: self.added(Operation::Parameter(at), [], E::kind(), extents) };
    }

    /// The graph recorded, returning `results`.
    pub fn finished(&self, results: List<i32>) -> Recorded {
        let mut body = self.current;
        body.results = results;
        return Recorded { nodes: self.nodes, body, parameters: self.parameters };
    }

    fn added(&mut self, op: Operation, operands: List<i32>, kind: ElementKind, extents: List<i32>) -> i32 {
        let id = self.nodes.len();
        self.nodes.push(RecordedNode { op, operands, kind, extents });
        self.current.nodes.push(id);
        return id;
    }

    fn value<E, Axes>(
        &mut self,
        op: Operation,
        operands: List<i32>,
        kind: ElementKind,
        extents: List<i32>,
    ) -> Value<E, Axes> {
        return Value { id: self.added(op, operands, kind, extents) };
    }

    fn extents(&self, id: i32) -> List<i32> {
        return self.nodes[id].extents;
    }
}

/// `v`'s elements, as `Data` holds them.
fn data_of<E: Element>(v: &List<E>) -> Data {
    return match E::kind() {
        F32 => Data::F32(v.into_iter().map(|x| x.cast_to::<f32>()).collect()),
        I64 => Data::I64(v.into_iter().map(|x| x.cast_to::<i64>()).collect()),
        Bool => Data::Bool(v.into_iter().map(|x| x.cast_to::<bool>()).collect()),
    };
}

impl Holds for Recorder {
    type Tensor<E: Element, Axes> = Value<E, Axes>;

    /// A constant of the graph.
    fn upload<E: Element, Axes>(&mut self, t: &Tensor<E, Axes>) -> Value<E, Axes> {
        return self.value(Operation::Constant(data_of(&t.data)), [], E::kind(), t.extents);
    }

    fn extents_of<E: Element, Axes>(&self, t: &Value<E, Axes>) -> List<i32> {
        return self.extents(t.id);
    }

    fn download<E: Element, Axes>(&mut self, t: &Value<E, Axes>) -> Tensor<E, Axes> {
        panic("a recorded graph holds no element until it runs");
    }
}

impl Graph for Recorder {
    type Program = ();

    fn relabeled<E: Element, In, Out>(&self, t: &Value<E, In>) -> Value<E, Out> {
        return Value { id: t.id };
    }

    fn iota<E: Element, Axes>(&mut self, extents: List<i32>, dimension: i32) -> Value<E, Axes> {
        return self.value(Operation::Iota(dimension), [], E::kind(), extents);
    }

    fn convert<A: Element, B: Element, Axes>(&mut self, x: &Value<A, Axes>) -> Value<B, Axes> {
        return self.value(Operation::Convert, [x.id], B::kind(), self.extents(x.id));
    }

    fn unary<Axes>(&mut self, op: Unary, x: &Value<f32, Axes>) -> Value<f32, Axes> {
        return self.value(Operation::Unary(op), [x.id], ElementKind::F32, self.extents(x.id));
    }

    fn binary<E: Element, Axes>(&mut self, op: Binary, a: &Value<E, Axes>, b: &Value<E, Axes>) -> Value<E, Axes> {
        let extents = elementwise_extents([
            self.extents(a.id),
            self.extents(b.id),
        ]);
        return self.value(Operation::Binary(op), [a.id, b.id], E::kind(), extents);
    }

    fn compare<E: Element, Axes>(
        &mut self,
        direction: Comparison,
        a: &Value<E, Axes>,
        b: &Value<E, Axes>,
    ) -> Value<bool, Axes> {
        let extents = elementwise_extents([
            self.extents(a.id),
            self.extents(b.id),
        ]);
        return self.value(Operation::Compare(direction), [a.id, b.id], ElementKind::Bool, extents);
    }

    fn select<E: Element, Axes>(
        &mut self,
        pred: &Value<bool, Axes>,
        on_true: &Value<E, Axes>,
        on_false: &Value<E, Axes>,
    ) -> Value<E, Axes> {
        let extents = elementwise_extents([
            self.extents(pred.id),
            self.extents(on_true.id),
            self.extents(on_false.id),
        ]);
        return self.value(Operation::Select, [pred.id, on_true.id, on_false.id], E::kind(), extents);
    }

    fn broadcast_in_dim<E: Element, In, Out>(
        &mut self,
        x: &Value<E, In>,
        extents: List<i32>,
        dims: List<i32>,
    ) -> Value<E, Out> {
        let extents = broadcast_in_dim_extents(&self.extents(x.id), extents, &dims);
        return self.value(Operation::BroadcastInDim(dims), [x.id], E::kind(), extents);
    }

    fn reshape<E: Element, In, Out>(&mut self, x: &Value<E, In>, extents: List<i32>) -> Value<E, Out> {
        assert element_count(&self.extents(x.id)) == element_count(&extents), "a reshape keeps every element";
        return self.value(Operation::Reshape, [x.id], E::kind(), extents);
    }

    fn transpose<E: Element, In, Out>(&mut self, x: &Value<E, In>, perm: List<i32>) -> Value<E, Out> {
        let own = self.extents(x.id);
        let extents: List<i32> = perm.into_iter().map(|p| own[p]).collect();
        return self.value(Operation::Transpose(perm), [x.id], E::kind(), extents);
    }

    fn slice<E: Element, In, Out>(
        &mut self,
        x: &Value<E, In>,
        start: List<i32>,
        limit: List<i32>,
        strides: List<i32>,
    ) -> Value<E, Out> {
        let extents = sliced_extents(&self.extents(x.id), &start, &limit, &strides);
        return self.value(Operation::Slice([start, limit, strides]), [x.id], E::kind(), extents);
    }

    fn concatenate<E: Element, A, B, Out>(&mut self, a: &Value<E, A>, b: &Value<E, B>, dimension: i32) -> Value<E, Out> {
        let extents = joined_extents(&self.extents(a.id), &self.extents(b.id), dimension);
        return self.value(Operation::Concatenate(dimension), [a.id, b.id], E::kind(), extents);
    }

    fn reduce<In, Out>(&mut self, x: &Value<f32, In>, op: Binary, init: f32, dims: List<i32>) -> Value<f32, Out> {
        let extents = reduced_extents(&self.extents(x.id), &dims);
        return self.value(Operation::Reduce([op, init, dims]), [x.id], ElementKind::F32, extents);
    }

    fn dot_general<A, B, Out>(&mut self, lhs: &Value<f32, A>, rhs: &Value<f32, B>, dims: &DotDims) -> Value<f32, Out> {
        let extents = dot_extents(&self.extents(lhs.id), &self.extents(rhs.id), dims);
        return self.value(Operation::DotGeneral(*dims), [lhs.id, rhs.id], ElementKind::F32, extents);
    }

    fn gather<E: Element, D, I, Out>(
        &mut self,
        operand: &Value<E, D>,
        indices: &Value<i64, I>,
        dims: &GatherDims,
    ) -> Value<E, Out> {
        let extents = gathered_extents(&self.extents(indices.id), dims);
        return self.value(Operation::Gather(*dims), [operand.id, indices.id], E::kind(), extents);
    }

    fn scatter<E: Element, D, I, U>(
        &mut self,
        operand: &Value<E, D>,
        indices: &Value<i64, I>,
        updates: &Value<E, U>,
        dims: &ScatterDims,
    ) -> Value<E, D> {
        let extents = self.extents(operand.id);
        return self.value(Operation::Scatter(*dims), [operand.id, indices.id, updates.id], E::kind(), extents);
    }

    fn convolution<In, K, Out>(
        &mut self,
        x: &Value<f32, In>,
        kernel: &Value<f32, K>,
        conv: &Convolution,
    ) -> Value<f32, Out> {
        let [input, weights] = [
            self.extents(x.id),
            self.extents(kernel.id),
        ];
        let mut extents: List<i32> = [input[0], weights[0]];
        extents.extend(&conv_window(&input, &weights, conv).output);
        return self.value(Operation::Convolution(*conv), [x.id, kernel.id], ElementKind::F32, extents);
    }

    fn reduce_window<In, Out>(
        &mut self,
        x: &Value<f32, In>,
        op: Binary,
        init: f32,
        window: &WindowReduce,
    ) -> Value<f32, Out> {
        let input = self.extents(x.id);
        let mut extents: List<i32> = [input[0], input[1]];
        extents.extend(&pooled_window(&input, window).output);
        return self.value(Operation::ReduceWindow([op, init, *window]), [x.id], ElementKind::F32, extents);
    }

    fn reverse<E: Element, Axes>(&mut self, x: &Value<E, Axes>, dims: List<i32>) -> Value<E, Axes> {
        return self.value(Operation::Reverse(dims), [x.id], E::kind(), self.extents(x.id));
    }

    /// Records each branch into a region of its own, each yielding its
    /// results by `yielded`, and returns the first branch's, which name the
    /// case's outside it.
    fn conditional<Axes, T>(
        &mut self,
        pred: &Value<bool, Axes>,
        then: fn() -> T with _,
        otherwise: fn() -> T with _,
    ) -> T with _ {
        let outer = self.current;
        self.current = Region::empty();
        let taken = then();
        let first = self.current;
        self.current = Region::empty();
        otherwise();
        let second = self.current;
        self.current = outer;
        assert first.results.len() == second.results.len(), "both branches yield as many results";
        self.added(Operation::Case([first, second]), [pred.id], ElementKind::Bool, []);
        return taken;
    }

    fn yielded<E: Element, Axes>(&mut self, x: &Value<E, Axes>) -> Value<E, Axes> {
        let id = self.added(Operation::Yield, [x.id], E::kind(), self.extents(x.id));
        self.current.results.push(id);
        return Value { id };
    }

    fn group_query_attention<B, S, Q, K, H, P, T, D, Pos, Half, BB, BH>(
        &mut self,
        q: &Value<f32, [B, S, Q]>,
        k: &Value<f32, [B, S, K]>,
        v: &Value<f32, [B, S, K]>,
        past_k: &Value<f32, [B, H, P, D]>,
        past_v: &Value<f32, [B, H, P, D]>,
        past_length: Option<&Value<i64, []>>,
        cos: Option<&Value<f32, [Pos, Half]>>,
        sin: Option<&Value<f32, [Pos, Half]>>,
        bias: Option<&Value<f32, [BB, BH, S, T]>>,
        options: &Attention,
    ) -> [Value<f32, [B, S, Q]>, Value<f32, [B, H, T, D]>, Value<f32, [B, H, T, D]>] {
        let mut operands: List<i32> = [q.id, k.id, v.id, past_k.id, past_v.id];
        let mut node = AttentionNode { options: *options, shared: false, rotary: false, biased: false };
        if let Some(l) = past_length {
            operands.push(l.id);
            node.shared = true;
        }
        if let Some(c) = cos && let Some(n) = sin {
            operands.push(c.id);
            operands.push(n.id);
            node.rotary = true;
        }
        if let Some(b) = bias {
            operands.push(b.id);
            node.biased = true;
        }
        let mut present = self.extents(past_k.id);
        if !node.shared {
            present[2] += self.extents(q.id)[1];
        }
        let attended = self.added(Operation::Attention(node), operands, ElementKind::F32, self.extents(q.id));
        return [
            Value { id: attended },
            self.value(Operation::Part(1), [attended], ElementKind::F32, present),
            self.value(Operation::Part(2), [attended], ElementKind::F32, present),
        ];
    }
}

/// The axes every tensor `run` computes with, which a `Graph` reads only
/// through extents.
pub struct Untyped {
}

/// A tensor of the graph `G` builds, whichever element it holds: what a
/// program takes and returns.
pub variant Any<affine G: Holds> {
    F32(G::Tensor<f32, Untyped>),
    I64(G::Tensor<i64, Untyped>),
    Bool(G::Tensor<bool, Untyped>),
}

/// `t` as `Cpu` holds it among a program's arguments.
pub fn host_of<E: Element, Axes>(t: &Tensor<E, Axes>) -> Any<Cpu> {
    return match data_of(&t.data) {
        F32(data) => Any::F32(Tensor { data, extents: t.extents }),
        I64(data) => Any::I64(Tensor { data, extents: t.extents }),
        Bool(data) => Any::Bool(Tensor { data, extents: t.extents }),
    };
}

/// `a`, an f32 tensor, under the axes `Axes`.
pub fn f32_of<affine G: Graph, Axes>(g: &G, a: &Any<G>) -> G::Tensor<f32, Axes> {
    return g.relabeled::<f32, Untyped, Axes>(&f32s(a));
}

/// `a`, an i64 tensor, under the axes `Axes`.
pub fn i64_of<affine G: Graph, Axes>(g: &G, a: &Any<G>) -> G::Tensor<i64, Axes> {
    return g.relabeled::<i64, Untyped, Axes>(&i64s(a));
}

/// `a`, a bool tensor, under the axes `Axes`.
pub fn bool_of<affine G: Graph, Axes>(g: &G, a: &Any<G>) -> G::Tensor<bool, Axes> {
    return g.relabeled::<bool, Untyped, Axes>(&bools(a));
}

/// `a`'s extents.
fn extents_of_any<affine G: Graph>(g: &G, a: &Any<G>) -> List<i32> with _ {
    return match a {
        F32(t) => g.extents_of(t),
        I64(t) => g.extents_of(t),
        Bool(t) => g.extents_of(t),
    };
}

/// The programs a backend compiled, one for each shape class: the extents of
/// the arguments that vary between calls.
pub struct Programs<affine G: Graph> {
    held: HashMap<List<List<i32>>, G::Program>,
}

impl<affine G: Graph> Programs<G> {
    pub fn new() -> Programs<G> {
        return Programs { held: HashMap::new() };
    }

    /// How many shape classes a program is held for.
    pub fn len(&self) -> i32 {
        return self.held.len();
    }

    /// What the program of `class` returns over `arguments()`, compiled from
    /// what `record` records over the arguments' extents where none is held
    /// yet; `None` where `g` compiles nothing, and builds itself.
    pub fn run(
        &mut self,
        g: &mut G,
        class: List<List<i32>>,
        record: fn(&mut Recorder, &List<List<i32>>) -> Recorded,
        arguments: fn() -> List<Any<G>> with _,
    ) -> Option<List<Any<G>>> with _ {
        if !self.held.contains_key(class) {
            let Some(program) = g.compiled(|r| {
                let given = arguments();
                return record(r, &given.into_iter().map(|a| extents_of_any(g, &a)).collect());
            }) else {
                return null;
            };
            self.held[class] = program;
        }
        return Option::Some(g.executed(&self.held[class], &arguments()));
    }
}

/// `recorded` run on `g` over `arguments`, each node computed by `g`'s
/// `Graph`. On `Cpu` it is what a device's compiled program must compute.
pub fn run<affine G: Graph>(g: &mut G, recorded: &Recorded, arguments: &List<Any<G>>) -> List<Any<G>> with _
    contract arguments.len() == recorded.parameters
{
    return Run::<G>::new().region(g, recorded, &recorded.body, arguments);
}

/// The value of each node of `recorded` that reads no argument, computed on
/// `Cpu`: what a program computes once, when it is compiled.
pub fn constants(recorded: &Recorded) -> HashMap<i32, Any<Cpu>> {
    let mut cpu = Cpu {};
    let mut state = Run::<Cpu>::new();
    for let [id, node] of recorded.nodes.into_iter().enumerate() {
        let reads_none = match node.op {
            Parameter(_) | Case(_) | Yield | Attention(_) | Part(_) => false,
            _ => node.operands.into_iter().all(|o| state.values.contains_key(o)),
        };
        if reads_none {
            state.values[id] = state.computed(&mut cpu, id, &node, &[]);
        }
    }
    return state.values;
}

/// The values a run has computed, each by its node's id.
internal struct Run<affine G: Graph> {
    internal values: HashMap<i32, Any<G>>,
    /// Each attention node's presents, which its `Part`s read.
    parts: HashMap<i32, List<Any<G>>>,
}

impl<affine G: Graph> Run<G> {
    internal fn new() -> Run<G> {
        return Run { values: HashMap::new(), parts: HashMap::new() };
    }

    /// Runs `region`'s nodes, and returns what it yields.
    fn region(
        &mut self,
        g: &mut G,
        recorded: &Recorded,
        region: &Region,
        arguments: &List<Any<G>>,
    ) -> List<Any<G>> with _ {
        for let id of region.nodes {
            let node = recorded.nodes[id];
            if let Case([first, second]) = node.op {
                let pred = bools(&self.values[node.operands[0]]);
                let yielded = g.conditional::<Untyped, List<Any<G>>>(
                    &pred,
                    || self.region(g, recorded, &first, arguments),
                    || self.region(g, recorded, &second, arguments),
                );
                for let [k, result] of first.results.into_iter().enumerate() {
                    self.values[result] = yielded[k];
                }
                continue;
            }
            let value = self.computed(g, id, &node, arguments);
            self.values[id] = value;
        }
        return region.results.into_iter().map(|r| self.values[r]).collect();
    }

    fn operand(&self, node: &RecordedNode, i: i32) -> Any<G> {
        return self.values[node.operands[i]];
    }

    /// The `i`th operand, an f32 tensor, under the axes the composite's
    /// signature spells.
    fn f32_at<Axes>(&self, g: &G, node: &RecordedNode, i: i32) -> G::Tensor<f32, Axes> {
        return f32_of::<G, Axes>(g, &self.operand(node, i));
    }

    internal fn computed(&mut self, g: &mut G, id: i32, node: &RecordedNode, arguments: &List<Any<G>>) -> Any<G> with _ {
        let extents = node.extents;
        return match node.op {
            Parameter(i) => arguments[i],
            Constant(data) => match data {
                F32(v) => Any::F32(g.upload(&Tensor::<f32, Untyped> { data: v, extents })),
                I64(v) => Any::I64(g.upload(&Tensor::<i64, Untyped> { data: v, extents })),
                Bool(v) => Any::Bool(g.upload(&Tensor::<bool, Untyped> { data: v, extents })),
            },
            Iota(dimension) => match node.kind {
                F32 => Any::F32(g.iota::<f32, Untyped>(extents, dimension)),
                I64 => Any::I64(g.iota::<i64, Untyped>(extents, dimension)),
                Bool => Any::Bool(g.iota::<bool, Untyped>(extents, dimension)),
            },
            Convert => match self.operand(node, 0) {
                F32(t) => converted::<G, f32>(g, &t, node.kind),
                I64(t) => converted::<G, i64>(g, &t, node.kind),
                Bool(t) => converted::<G, bool>(g, &t, node.kind),
            },
            Unary(op) => Any::F32(g.unary::<Untyped>(op, &f32s(&self.operand(node, 0)))),
            Binary(op) => match [
                self.operand(node, 0),
                self.operand(node, 1),
            ] {
                [F32(a), F32(b)] => Any::F32(g.binary::<f32, Untyped>(op, &a, &b)),
                [I64(a), I64(b)] => Any::I64(g.binary::<i64, Untyped>(op, &a, &b)),
                _ => unreachable(),
            },
            Compare(direction) => match [
                self.operand(node, 0),
                self.operand(node, 1),
            ] {
                [F32(a), F32(b)] => Any::Bool(g.compare::<f32, Untyped>(direction, &a, &b)),
                [I64(a), I64(b)] => Any::Bool(g.compare::<i64, Untyped>(direction, &a, &b)),
                [Bool(a), Bool(b)] => Any::Bool(g.compare::<bool, Untyped>(direction, &a, &b)),
                _ => unreachable(),
            },
            Select => {
                let pred = bools(&self.operand(node, 0));
                match [
                    self.operand(node, 1),
                    self.operand(node, 2),
                ] {
                    [F32(a), F32(b)] => Any::F32(g.select::<f32, Untyped>(&pred, &a, &b)),
                    [I64(a), I64(b)] => Any::I64(g.select::<i64, Untyped>(&pred, &a, &b)),
                    [Bool(a), Bool(b)] => Any::Bool(g.select::<bool, Untyped>(&pred, &a, &b)),
                    _ => unreachable(),
                }
            },
            BroadcastInDim(_) | Reshape | Transpose(_) | Slice(_) | Reverse(_) | Yield => match self.operand(node, 0) {
                F32(t) => Any::F32(regrouped::<G, f32>(g, node, &t)),
                I64(t) => Any::I64(regrouped::<G, i64>(g, node, &t)),
                Bool(t) => Any::Bool(regrouped::<G, bool>(g, node, &t)),
            },
            Concatenate(dimension) => match [
                self.operand(node, 0),
                self.operand(node, 1),
            ] {
                [F32(a), F32(b)] => Any::F32(g.concatenate::<f32, Untyped, Untyped, Untyped>(&a, &b, dimension)),
                [I64(a), I64(b)] => Any::I64(g.concatenate::<i64, Untyped, Untyped, Untyped>(&a, &b, dimension)),
                [Bool(a), Bool(b)] => Any::Bool(g.concatenate::<bool, Untyped, Untyped, Untyped>(&a, &b, dimension)),
                _ => unreachable(),
            },
            Reduce([op, init, dims]) => Any::F32(g.reduce::<Untyped, Untyped>(
                &f32s(&self.operand(node, 0)),
                op,
                init,
                dims,
            )),
            DotGeneral(dims) => Any::F32(g.dot_general::<Untyped, Untyped, Untyped>(
                &f32s(&self.operand(node, 0)),
                &f32s(&self.operand(node, 1)),
                &dims,
            )),
            Gather(dims) => {
                let indices = i64s(&self.operand(node, 1));
                match self.operand(node, 0) {
                    F32(t) => Any::F32(g.gather::<f32, Untyped, Untyped, Untyped>(&t, &indices, &dims)),
                    I64(t) => Any::I64(g.gather::<i64, Untyped, Untyped, Untyped>(&t, &indices, &dims)),
                    Bool(t) => Any::Bool(g.gather::<bool, Untyped, Untyped, Untyped>(&t, &indices, &dims)),
                }
            },
            Scatter(dims) => {
                let indices = i64s(&self.operand(node, 1));
                match [
                    self.operand(node, 0),
                    self.operand(node, 2),
                ] {
                    [F32(a), F32(u)] => Any::F32(g.scatter::<f32, Untyped, Untyped, Untyped>(&a, &indices, &u, &dims)),
                    [I64(a), I64(u)] => Any::I64(g.scatter::<i64, Untyped, Untyped, Untyped>(&a, &indices, &u, &dims)),
                    [Bool(a), Bool(u)] => Any::Bool(g.scatter::<bool, Untyped, Untyped, Untyped>(
                        &a,
                        &indices,
                        &u,
                        &dims,
                    )),
                    _ => unreachable(),
                }
            },
            Convolution(conv) => Any::F32(g.convolution::<Untyped, Untyped, Untyped>(
                &f32s(&self.operand(node, 0)),
                &f32s(&self.operand(node, 1)),
                &conv,
            )),
            ReduceWindow([op, init, window]) => Any::F32(g.reduce_window::<Untyped, Untyped>(
                &f32s(&self.operand(node, 0)),
                op,
                init,
                &window,
            )),
            Attention(attention) => {
                let [attended, present_k, present_v] = self.attended(g, node, &attention);
                self.parts[id] = [present_k, present_v];
                attended;
            },
            Part(k) => self.parts[node.operands[0]][k - 1],
            Case(_) => unreachable(),
        };
    }

    /// An attention node's attended queries and presents, by `g`'s
    /// `group_query_attention`.
    fn attended(&self, g: &mut G, node: &RecordedNode, attention: &AttentionNode) -> [Any<G>, Any<G>, Any<G>] with _ {
        let mut next = 5;
        let past_length: Option<G::Tensor<i64, []>> = if attention.shared {
            next += 1;
            Option::Some(i64_of::<G, []>(g, &self.operand(node, 5)));
        } else {
            null;
        };
        let [cos, sin]: [Option<G::Tensor<f32, [Untyped, Untyped]>>, Option<G::Tensor<f32, [Untyped, Untyped]>>] = if attention.rotary {
            next += 2;
            [
                Option::Some(self.f32_at(g, node, next - 2)),
                Option::Some(self.f32_at(g, node, next - 1)),
            ];
        } else {
            [null, null];
        };
        let bias: Option<G::Tensor<f32, [Untyped, Untyped, Untyped, Untyped]>> = if attention.biased {
            Option::Some(self.f32_at(g, node, next));
        } else {
            null;
        };
        let [a, k, v] = g.group_query_attention::<Untyped, Untyped, Untyped, Untyped, Untyped, Untyped, Untyped, Untyped, Untyped, Untyped, Untyped, Untyped>(
            &self.f32_at(g, node, 0),
            &self.f32_at(g, node, 1),
            &self.f32_at(g, node, 2),
            &self.f32_at(g, node, 3),
            &self.f32_at(g, node, 4),
            optional(&past_length),
            optional(&cos),
            optional(&sin),
            optional(&bias),
            &attention.options,
        );
        return [
            Any::F32(g.relabeled::<f32, [Untyped, Untyped, Untyped], Untyped>(&a)),
            Any::F32(g.relabeled::<f32, [Untyped, Untyped, Untyped, Untyped], Untyped>(&k)),
            Any::F32(g.relabeled::<f32, [Untyped, Untyped, Untyped, Untyped], Untyped>(&v)),
        ];
    }
}

fn f32s<affine G: Holds>(a: &Any<G>) -> G::Tensor<f32, Untyped> {
    let F32(t) = *a else {
        unreachable();
    };
    return t;
}

fn i64s<affine G: Holds>(a: &Any<G>) -> G::Tensor<i64, Untyped> {
    let I64(t) = *a else {
        unreachable();
    };
    return t;
}

internal fn bools<affine G: Holds>(a: &Any<G>) -> G::Tensor<bool, Untyped> {
    let Bool(t) = *a else {
        unreachable();
    };
    return t;
}

/// `t` converted to the element `to` names.
fn converted<affine G: Graph, A: Element>(g: &mut G, t: &G::Tensor<A, Untyped>, to: ElementKind) -> Any<G> with _ {
    return match to {
        F32 => Any::F32(g.convert::<A, f32, Untyped>(t)),
        I64 => Any::I64(g.convert::<A, i64, Untyped>(t)),
        Bool => Any::Bool(g.convert::<A, bool, Untyped>(t)),
    };
}

/// A node that moves its one operand's elements, or yields it, over `t`.
fn regrouped<affine G: Graph, E: Element>(
    g: &mut G,
    node: &RecordedNode,
    t: &G::Tensor<E, Untyped>,
) -> G::Tensor<E, Untyped> with _ {
    return match node.op {
        BroadcastInDim(dims) => g.broadcast_in_dim::<E, Untyped, Untyped>(t, node.extents, dims),
        Reshape => g.reshape::<E, Untyped, Untyped>(t, node.extents),
        Transpose(perm) => g.transpose::<E, Untyped, Untyped>(t, perm),
        Slice([start, limit, strides]) => g.slice::<E, Untyped, Untyped>(t, start, limit, strides),
        Reverse(dims) => g.reverse::<E, Untyped>(t, dims),
        Yield => *t,
        _ => unreachable(),
    };
}
