/// A tensor of `E` over the axis list `Axes`, row-major.
pub struct Tensor<E, Axes> {
    pub data: List<E>,
    pub extents: List<i32>,
}

/// The elements `extents` hold, or `None` where its non-empty extents multiply
/// past `i32::MAX`. A kernel counts sub-shapes, so every partial product must fit.
pub fn checked_element_count(extents: &List<i32>) -> Option<i32> {
    let mut count = 1;
    let mut empty = false;
    for let e of *extents {
        assert e >= 0;
        if e == 0 {
            empty = true;
        } else if count > i32::MAX / e {
            return null;
        } else {
            count *= e;
        }
    }
    return Option::Some(if empty { 0 } else { count });
}

/// A reference to what `t` holds, where it holds something.
pub fn optional<T>(t: &Option<T>) -> Option<&T> {
    return match t {
        Some(held) => Option::Some(held),
        None => null,
    };
}

/// The elements a tensor of `extents` holds, which a list must be able to hold.
pub fn element_count(extents: &List<i32>) -> i32 {
    let Some(count) = checked_element_count(extents) else {
        panic(`extents ${*extents} multiply past what a list can hold`);
    };
    return count;
}

/// Why the input `tensor` disagrees with the graph. `stated` holds each axis's
/// extent where the graph states one, and -1 where it leaves the axis to the run.
pub fn input_mismatch<E, Axes>(
    t: &Tensor<E, Axes>,
    tensor: String,
    axes: List<String>,
    stated: List<i32>,
) -> Option<String> {
    if let Some(why) = extents_mismatch(&t.extents, tensor, axes, stated) {
        return Option::Some(why);
    }
    let Some(count) = checked_element_count(&t.extents) else {
        return Option::Some(`${tensor}: extents ${t.extents} multiply past what a list can hold`);
    };
    if count != t.data.len() {
        return Option::Some(`${tensor}: extents ${t.extents} hold ${count} elements, and the data ${t.data.len()}`);
    }
    return null;
}

/// [`input_mismatch`] of a tensor a backend holds, read through its extents.
pub fn extents_mismatch(extents: &List<i32>, tensor: String, axes: List<String>, stated: List<i32>) -> Option<String> {
    if extents.len() != axes.len() {
        return Option::Some(`${tensor}: the tensor gives ${extents.len()} axes, and the graph [${axes.join(", ")}]`);
    }
    for let [i, axis] of axes.into_iter().enumerate() {
        let extent = extents[i];
        if extent < 0 {
            return Option::Some(`${tensor}: axis ${axis} is ${extent} in the tensor`);
        }
        if stated[i] >= 0 && extent != stated[i] {
            return Option::Some(`${tensor}: axis ${axis} is ${extent} in the tensor and ${stated[i]} in the graph`);
        }
    }
    return null;
}

/// Why two inputs disagree on an extent the graph leaves to the run as `symbol`.
pub fn axis_mismatch(
    symbol: String,
    tensor: String,
    axis: String,
    extent: i32,
    other: String,
    other_extent: i32,
) -> Option<String> {
    if extent == other_extent {
        return null;
    }
    return Option::Some(
        `${tensor}: axis ${axis} is ${extent} in the tensor and ${other_extent} in ${other}, and the graph makes both ${symbol}`,
    );
}

/// Why an input's axis is not the length the graph spells for it, `length`,
/// which the other inputs make `expected`.
pub fn extent_mismatch(tensor: String, axis: String, extent: i32, length: String, expected: i64) -> Option<String> {
    if extent as i64 == expected {
        return null;
    }
    return Option::Some(
        `${tensor}: axis ${axis} is ${extent} in the tensor, and the graph makes it ${length}, which the inputs make ${expected}`,
    );
}

/// Why the inputs break a condition the build relied on and could not prove:
/// `slack` is how far within it they are, and `condition` states it.
pub fn unmet(slack: i64, condition: String) -> Option<String> {
    if slack >= 0 {
        return null;
    }
    return Option::Some(`${condition}, and the inputs miss it by ${-slack}`);
}

/// An ONNX index into an axis of `extent` positions, which counts from the end
/// where negative.
pub fn from_end(i: i64, extent: i64) -> i64 {
    return if i < 0 { i + extent } else { i };
}

/// A length `build` computes from the inputs', as an operation takes one. It
/// is computed in `i64` so that no product of lengths wraps on the way.
pub fn to_extent(value: i64) -> i32 {
    if !(0 <= value <= i32::MAX as i64) {
        panic(`the inputs make a length of ${value}, which no list holds`);
    }
    return value as i32;
}

/// Stops `build` or `compute` with the reason an input disagrees with the graph.
pub fn refuse(reason: Option<String>) {
    if let Some(r) = reason {
        panic(r);
    }
}

/// ONNX's `MatMul` in full, which is numpy's: a rank-1 operand is a row on the
/// left or a column on the right, whose axis the result drops, and the batch
/// axes broadcast. The caller spells `Out`. `then` is applied to each batch
/// element's matrix as it completes.
pub fn matmul_broadcast<A, B, Out>(
    a: &Tensor<f32, A>,
    b: &Tensor<f32, B>,
    then: &Option<Epilogue<Read<Out>>>,
) -> Tensor<f32, Out> {
    let a_matrix = if a.extents.len() == 1 { [1, a.extents[0]] as List<i32> } else { a.extents };
    let b_matrix = if b.extents.len() == 1 { [b.extents[0], 1] as List<i32> } else { b.extents };
    let ra = a_matrix.len();
    let rb = b_matrix.len();
    let rows = a_matrix[ra - 2];
    let inner = a_matrix[ra - 1];
    let cols = b_matrix[rb - 1];
    assert inner == b_matrix[rb - 2];
    let a_batch = a_matrix[0..<ra - 2].to_list();
    let b_batch = b_matrix[0..<rb - 2].to_list();
    let batch = broadcast_extents(&a_batch, &b_batch).unwrap();
    let mut extents = batch;
    if a.extents.len() > 1 {
        extents.push(rows);
    }
    if b.extents.len() > 1 {
        extents.push(cols);
    }
    let mut out = List::<f32>::filled(element_count(&extents), 0.0);
    let finishing = finish(then, &extents);
    // Each batch element's matrices, where a batch axis of 1 stretches.
    let a_carries = stretched_carries(&a_batch, &batch);
    let b_carries = stretched_carries(&b_batch, &batch);
    let mut index = List::<i32>::filled(batch.len(), 0);
    let [mut at_a, mut at_b] = [0, 0];
    let lhs_data = &a.data;
    let rhs_data = &b.data;
    for let s of 0..<element_count(&batch) {
        let a_base = at_a * rows * inner;
        let b_base = at_b * inner * cols;
        let out_base = s * rows * cols;
        let at = MatrixAt { a: a_base, b: b_base, out: out_base };
        scalar_product(lhs_data, rhs_data, &mut out, rows, inner, cols, &at);
        if let Some(f) = &finishing {
            f.apply(&mut out, out_base, rows * cols);
        }
        let axis = advance(&mut index, &batch);
        if axis >= 0 {
            at_a += a_carries[axis];
            at_b += b_carries[axis];
        }
    }
    return Tensor { data: out, extents };
}

/// Where one batch element's matrices start in `a`, `b` and the output.
struct MatrixAt {
    a: i32,
    b: i32,
    out: i32,
}

/// One batch element's product over `b` as stored: rows in bands of up to
/// [`TILE`], a lone row left over on its own, and the columns past the last
/// whole tile one element at a time.
fn scalar_product(a: &List<f32>, b: &List<f32>, out: &mut List<f32>, rows: i32, inner: i32, cols: i32, at: &MatrixAt) {
    let whole_cols = cols - cols % TILE;
    let mut r = 0;
    while r < rows {
        let height = i32::min(TILE, rows - r);
        for let mut c = 0; c < whole_cols; c += TILE {
            let a_at = at.a + r * inner;
            let b_at = at.b + c;
            let out_at = at.out + r * cols + c;
            if height > 1 {
                tile_4x4(a, b, out, inner, cols, height, a_at, b_at, out_at);
            } else {
                tile_1x4(a, b, out, inner, cols, a_at, b_at, out_at);
            }
        }
        for let rr of r..<r + height {
            for let c of whole_cols..<cols {
                out[at.out + rr * cols + c] = dot(a, b, inner, cols, at.a + rr * inner, at.b + c);
            }
        }
        r += height;
    }
}

/// The side of the square of output elements `matmul_broadcast` computes at
/// once, its sums held in locals across the whole inner axis. Per step of that
/// axis it reads 4 elements of `a` and 4 adjacent ones of `b` for 16 products,
/// where an element at a time reads 2 and writes 1 for each.
global TILE: i32 = 4;

/// The square of `out` at `out_at`, `height` rows (2 to 4) by 4 columns: rows
/// of `a` from `a_at`, `inner` long, against 4 adjacent columns of `b` from
/// `b_at`, rows `cols` apart. A band short of 4 rows computes its last row
/// again in the place of the missing ones, which costs less than a narrower
/// tile, and stores only its own.
fn tile_4x4(
    a: &List<f32>,
    b: &List<f32>,
    out: &mut List<f32>,
    inner: i32,
    cols: i32,
    height: i32,
    a_at: i32,
    b_at: i32,
    out_at: i32,
)
    contract 2 <= height <= TILE
{
    let [mut s00, mut s01, mut s02, mut s03] = [0.0 as f32, 0.0 as f32, 0.0 as f32, 0.0 as f32];
    let [mut s10, mut s11, mut s12, mut s13] = [0.0 as f32, 0.0 as f32, 0.0 as f32, 0.0 as f32];
    let [mut s20, mut s21, mut s22, mut s23] = [0.0 as f32, 0.0 as f32, 0.0 as f32, 0.0 as f32];
    let [mut s30, mut s31, mut s32, mut s33] = [0.0 as f32, 0.0 as f32, 0.0 as f32, 0.0 as f32];
    let a1 = a_at + inner;
    let a2 = a_at + inner * i32::min(2, height - 1);
    let a3 = a_at + inner * (height - 1);
    for let mut k = 0; k < inner; k += 1 {
        let x0 = a[a_at + k];
        let x1 = a[a1 + k];
        let x2 = a[a2 + k];
        let x3 = a[a3 + k];
        let bk = b_at + k * cols;
        let y0 = b[bk];
        let y1 = b[bk + 1];
        let y2 = b[bk + 2];
        let y3 = b[bk + 3];
        s00 += x0 * y0;
        s01 += x0 * y1;
        s02 += x0 * y2;
        s03 += x0 * y3;
        s10 += x1 * y0;
        s11 += x1 * y1;
        s12 += x1 * y2;
        s13 += x1 * y3;
        s20 += x2 * y0;
        s21 += x2 * y1;
        s22 += x2 * y2;
        s23 += x2 * y3;
        s30 += x3 * y0;
        s31 += x3 * y1;
        s32 += x3 * y2;
        s33 += x3 * y3;
    }
    let o1 = out_at + cols;
    let o2 = o1 + cols;
    let o3 = o2 + cols;
    out[out_at] = s00;
    out[out_at + 1] = s01;
    out[out_at + 2] = s02;
    out[out_at + 3] = s03;
    out[o1] = s10;
    out[o1 + 1] = s11;
    out[o1 + 2] = s12;
    out[o1 + 3] = s13;
    if height > 2 {
        out[o2] = s20;
        out[o2 + 1] = s21;
        out[o2 + 2] = s22;
        out[o2 + 3] = s23;
    }
    if height > 3 {
        out[o3] = s30;
        out[o3 + 1] = s31;
        out[o3 + 2] = s32;
        out[o3 + 3] = s33;
    }
}

/// [`tile_4x4`] for a lone row of `a`, where computing three more would cost
/// more than it saves.
fn tile_1x4(a: &List<f32>, b: &List<f32>, out: &mut List<f32>, inner: i32, cols: i32, a_at: i32, b_at: i32, out_at: i32) {
    let [mut s0, mut s1, mut s2, mut s3] = [0.0 as f32, 0.0 as f32, 0.0 as f32, 0.0 as f32];
    for let mut k = 0; k < inner; k += 1 {
        let x = a[a_at + k];
        let bk = b_at + k * cols;
        s0 += x * b[bk];
        s1 += x * b[bk + 1];
        s2 += x * b[bk + 2];
        s3 += x * b[bk + 3];
    }
    out[out_at] = s0;
    out[out_at + 1] = s1;
    out[out_at + 2] = s2;
    out[out_at + 3] = s3;
}

/// One element of the product: the row of `a` from `a_at` against the column
/// of `b` from `b_at`, as the columns past the last whole tile are.
fn dot(a: &List<f32>, b: &List<f32>, inner: i32, cols: i32, a_at: i32, b_at: i32) -> f32 {
    let mut sum: f32 = 0.0;
    for let mut k = 0; k < inner; k += 1 {
        sum += a[a_at + k] * b[b_at + k * cols];
    }
    return sum;
}

/// `extents` followed by `count` extents of 1, which broadcasting from the end
/// stretches across the axes they stand for.
pub fn followed_by_units(extents: &List<i32>, count: i32) -> List<i32> {
    let mut out = *extents;
    for let _ of 0..<count {
        out.push(1);
    }
    return out;
}

/// Whether an operand of `extents`, broadcast to `out`, repeats one run of its
/// elements across `out`'s leading axes: its extents past its leading ones of
/// 1 are `out`'s trailing ones. Element `i` of the output then reads its
/// element `i % len`, with no stretched copy made.
pub fn repeats_over(extents: &List<i32>, out: &List<i32>) -> bool {
    let mut first = 0;
    while first < extents.len() && extents[first] == 1 {
        first += 1;
    }
    let offset = out.len() - (extents.len() - first);
    if offset < 0 {
        return false;
    }
    for let i of first..<extents.len() {
        if out[offset + i - first] != extents[i] {
            return false;
        }
    }
    return true;
}

/// Moves a row-major `index` over `extents` one position on and returns the
/// axis that advanced, every later one having wrapped to 0; -1 past the end.
internal fn advance(index: &mut List<i32>, extents: &List<i32>) -> i32 {
    for let mut axis = extents.len() - 1; axis >= 0; axis -= 1 {
        index[axis] += 1;
        if index[axis] < extents[axis] {
            return axis;
        }
        index[axis] = 0;
    }
    return -1;
}

/// How far an offset stepping by `strides` moves when `advance` names each
/// axis: that axis's stride, less the span every later axis wound back.
internal fn carries(strides: &List<i32>, extents: &List<i32>) -> List<i32> {
    let mut carry = List::<i32>::filled(extents.len(), 0);
    let mut unwound = 0;
    for let mut axis = extents.len() - 1; axis >= 0; axis -= 1 {
        carry[axis] = strides[axis] - unwound;
        unwound += strides[axis] * (extents[axis] - 1);
    }
    return carry;
}

/// `carries` for a tensor of `extents` stretched over `out`.
fn stretched_carries(extents: &List<i32>, out: &List<i32>) -> List<i32> {
    return carries(&stretched_strides(extents, out.len()), out);
}

/// The extents two operands broadcast to under ONNX's rule, or `None` where an
/// axis meets a different extent and neither is 1.
pub fn broadcast_extents(a: &List<i32>, b: &List<i32>) -> Option<List<i32>> {
    let rank = i32::max(a.len(), b.len());
    let mut extents: List<i32> = [];
    for let i of 0..<rank {
        let ea = aligned_extent(a, rank, i);
        let eb = aligned_extent(b, rank, i);
        if ea != eb && ea != 1 && eb != 1 {
            return null;
        }
        extents.push(if ea == 1 { eb } else { ea });
    }
    return Option::Some(extents);
}

/// `extents` aligned to `rank` axes from the end, a missing axis being 1.
fn aligned_extent(extents: &List<i32>, rank: i32, axis: i32) -> i32 {
    let own = axis - (rank - extents.len());
    return if own < 0 { 1 } else { extents[own] };
}

/// Each of `rank` axes' step through a tensor of `extents`, aligned from the
/// end. A stretched axis steps by zero, so every position reads one element.
pub fn stretched_strides(extents: &List<i32>, rank: i32) -> List<i32> {
    let mut strides = List::<i32>::filled(rank, 0);
    let mut step = 1;
    for let mut back = 0; back < extents.len(); back += 1 {
        let e = extents[extents.len() - 1 - back];
        if e != 1 {
            strides[rank - 1 - back] = step;
        }
        step *= e;
    }
    return strides;
}

/// The axis a merge makes of `Parts`, a tuple of axis markers.
pub struct Merged<Parts> {
}

/// Two matrices' axis `N` interleaved: position `2j` is the first's `j`, and
/// `2j + 1` the second's. Two products of one left operand by matrices paired
/// so are one product, whose columns of each pair are adjacent.
pub struct Paired<N> {
}

/// `b` and `c`, of one shape, interleaved along their last axis as `Paired`
/// says.
pub fn interleaved<E, K, N>(b: &Tensor<E, [K, N]>, c: &Tensor<E, [K, N]>) -> Tensor<E, [K, Paired<N>]>
    contract b.extents == c.extents
{
    let [k, n] = [b.extents[0], b.extents[1]];
    let mut data = List::<E>::with_capacity(2 * k * n);
    for let i of 0..<k * n {
        data.push(b.data[i]);
        data.push(c.data[i]);
    }
    return Tensor {
        data,
        extents: [k, 2 * n],
    };
}

/// The same elements under another axis list. A regrouping keeps row-major
/// order, so no element moves.
pub fn reshape<E, In, Out>(t: &Tensor<E, In>, extents: List<i32>) -> Tensor<E, Out>
    contract element_count(&extents) == t.data.len()
{
    return Tensor { data: t.data, extents };
}

/// Along each spatial axis: a window's extent, step, tap spacing and output
/// extent. `pads` is ONNX's order: every leading pad, then every trailing one.
pub struct Window {
    pub kernel: List<i32>,
    pub strides: List<i32>,
    pub dilations: List<i32>,
    pub pads: List<i32>,
    pub output: List<i32>,
}

/// What `group_query_attention` computes beyond its operands.
pub struct Attention {
    pub heads: i32,
    pub kv_heads: i32,
    /// What each score is multiplied by.
    pub scale: f32,
    /// Where above 0, each scaled score `x` becomes `softcap · tanh(x / softcap)`.
    pub softcap: f32,
    /// Where above 0, a position reads only the `window` positions ending at
    /// itself; -1 for no window.
    pub window: i32,
    /// Whether a position reads only the positions up to itself.
    pub causal: bool,
}

/// ONNX's `MaxPool` over `window`: each position's greatest value under the
/// kernel, a padded position counting as none.
pub fn max_pool<N, C, ..In, ..Out>(x: &Tensor<f32, [N, C, ..In]>, window: &Window) -> Tensor<f32, [N, C, ..Out]> {
    let input = spatial_extents(&x.extents);
    let planes = x.extents[0] * x.extents[1];
    let in_size = element_count(&input);
    let out_size = element_count(&window.output);
    let extents = windowed_extents(x.extents[0], x.extents[1], window);
    let mut out = List::<f32>::filled(element_count(&extents), -f32::INFINITY);
    for let at of 0..<out_size {
        for let tap of 0..<element_count(&window.kernel) {
            let offset = tap_offset(&input, window, at, tap);
            if offset < 0 {
                continue;
            }
            for let plane of 0..<planes {
                out[plane * out_size + at] = f32::ieee754_max(
                    out[plane * out_size + at],
                    x.data[plane * in_size + offset],
                );
            }
        }
    }
    return Tensor { data: out, extents };
}

/// ONNX's `Conv` over `window` in `group` groups: each output channel sums
/// its own group's run of `Cg` input channels under its kernel, and `then` is
/// applied once every element is complete.
pub fn conv_grouped<N, Ci, Cg, Co, ..In, ..K, ..Out>(
    x: &Tensor<f32, [N, Ci, ..In]>,
    w: &Tensor<f32, [Co, Cg, ..K]>,
    group: i32,
    window: &Window,
    then: &Option<Epilogue<Read<[N, Co, ..Out]>>>,
) -> Tensor<f32, [N, Co, ..Out]> {
    return convolve(x, w, List::<f32>::filled(w.extents[0], 0.0), group, window, then);
}

/// A convolution in `group` groups, each output channel reading the input
/// channels of its own group, and `then` applied in place once every element
/// is complete. The loops run tap by tap over every output channel, so one
/// input element serves each channel while it is in cache; no channel's plane
/// completes before the last tap.
fn convolve<X, W, Y>(
    x: &Tensor<f32, X>,
    w: &Tensor<f32, W>,
    bias: List<f32>,
    group: i32,
    window: &Window,
    then: &Option<Epilogue<Read<Y>>>,
) -> Tensor<f32, Y> {
    let batch = x.extents[0];
    let channels = x.extents[1];
    let outputs = w.extents[0];
    let inputs = w.extents[1];
    assert inputs * group == channels && outputs % group == 0 && bias.len() == outputs;
    let group_outputs = outputs / group;
    let input = spatial_extents(&x.extents);
    let in_size = element_count(&input);
    let out_size = element_count(&window.output);
    let taps = element_count(&window.kernel);
    assert element_count(&spatial_extents(&w.extents)) == taps;
    let extents = windowed_extents(batch, outputs, window);
    let finishing = finish(then, &extents);
    let mut out = List::<f32>::with_capacity(element_count(&extents));
    for let _ of 0..<batch {
        for let oc of 0..<outputs {
            for let _ of 0..<out_size {
                out.push(bias[oc]);
            }
        }
    }
    for let at of 0..<out_size {
        for let tap of 0..<taps {
            let offset = tap_offset(&input, window, at, tap);
            if offset < 0 {
                continue;
            }
            for let n of 0..<batch {
                for let oc of 0..<outputs {
                    let first = n * channels + oc / group_outputs * inputs;
                    let mut sum: f32 = 0.0;
                    for let ic of 0..<inputs {
                        sum += x.data[(first + ic) * in_size + offset] * w.data[(oc * inputs + ic) * taps + tap];
                    }
                    out[(n * outputs + oc) * out_size + at] += sum;
                }
            }
        }
    }
    if let Some(f) = &finishing {
        f.apply(&mut out, 0, out.len());
    }
    return Tensor { data: out, extents };
}

/// The extents past the batch and channel axes, which a window slides over.
pub fn spatial_extents(extents: &List<i32>) -> List<i32> {
    return extents[2..<extents.len()].to_list();
}

fn windowed_extents(batch: i32, channels: i32, window: &Window) -> List<i32> {
    let mut extents = [batch, channels] as List<i32>;
    extents.extend(&window.output);
    return extents;
}

/// Where tap `tap` of the window at output position `at` reads one spatial
/// plane of extents `input`, row-major, or `-1` where it lands in the padding.
fn tap_offset(input: &List<i32>, window: &Window, at: i32, tap: i32) -> i32 {
    let spatial = input.len();
    let mut offset = 0;
    let mut step = 1;
    let mut rest_at = at;
    let mut rest_tap = tap;
    for let mut i = spatial - 1; i >= 0; i -= 1 {
        let o = rest_at % window.output[i];
        let k = rest_tap % window.kernel[i];
        rest_at /= window.output[i];
        rest_tap /= window.kernel[i];
        let position = o * window.strides[i] - window.pads[i] + k * window.dilations[i];
        if position < 0 || position >= input[i] {
            return -1;
        }
        offset += position * step;
        step *= input[i];
    }
    return offset;
}

/// A matrix transposed.
pub fn transpose2<E, A, B>(t: &Tensor<E, [A, B]>) -> Tensor<E, [B, A]> {
    return permute(t, [1, 0]);
}

/// The elements with input axis `perm[i]` moved to output axis `i`. The caller
/// spells `Out`, since each order of three or more axes is its own signature.
pub fn permute<E, In, Out>(t: &Tensor<E, In>, perm: List<i32>) -> Tensor<E, Out> {
    let rank = t.extents.len();
    assert perm.len() == rank;
    let in_strides = stretched_strides(&t.extents, rank);
    let mut extents: List<i32> = [];
    let mut strides: List<i32> = [];
    for let p of perm {
        extents.push(t.extents[p]);
        strides.push(in_strides[p]);
    }
    return Tensor { data: walked(&t.data, 0, &strides, &extents), extents };
}

/// The elements of `data` an offset from `base` reaches stepping by `strides`
/// over `extents`, in row-major order.
internal fn walked<E>(data: &List<E>, base: i32, strides: &List<i32>, extents: &List<i32>) -> List<E> {
    let count = element_count(extents);
    let mut out = List::<E>::with_capacity(count);
    let steps = carries(strides, extents);
    let mut index = List::<i32>::filled(extents.len(), 0);
    let mut at = base;
    for let _ of 0..<count {
        out.push(data[at]);
        let axis = advance(&mut index, extents);
        if axis >= 0 {
            at += steps[axis];
        }
    }
    return out;
}

/// ONNX's `ArgMax` keeping its axis: the index along `axis` of each lane's
/// first greatest element, in the order `>` reads, so a NaN is greatest.
pub fn arg_max<Axes>(t: &Tensor<f32, Axes>, axis: i32) -> Tensor<i64, Axes>
    contract t.extents[axis] > 0, "ArgMax needs an element along its axis"
{
    let extent = t.extents[axis];
    let inner = element_count(&t.extents[axis + 1..<t.extents.len()].to_list());
    let lanes = t.data.len() / extent;
    let mut out = List::<i64>::with_capacity(lanes);
    for let lane of 0..<lanes {
        let base = lane / inner * extent * inner + lane % inner;
        let mut best = 0;
        for let k of 1..<extent {
            if t.data[base + k * inner] > t.data[base + best * inner] {
                best = k;
            }
        }
        out.push(best as i64);
    }
    let mut extents = t.extents;
    extents[axis] = 1;
    return Tensor { data: out, extents };
}

/// Each element through `op`.
pub fn map<A, B, Axes>(t: &Tensor<A, Axes>, op: fn(A) -> B) -> Tensor<B, Axes> {
    let mut out = List::<B>::with_capacity(t.data.len());
    for let v of t.data {
        out.push(op(v));
    }
    return Tensor { data: out, extents: t.extents };
}

/// `1 / (1 + e^-v)`, computed from the side whose exponential cannot overflow.
pub fn sigmoid_f32(v: f32) -> f32 {
    if v >= 0.0 {
        return 1.0 / (1.0 + f32::exp(-v));
    }
    let e = f32::exp(v);
    return e / (1.0 + e);
}

/// An element type a tensor is held in and no kernel computes in. Wado's half
/// precision carries bits and no arithmetic, so f32 is the only side with any.
pub trait Held with () {
    fn to_wide(&self) -> f32;
    fn from_wide(v: f32) -> Self;
}

impl Held for f16 {
    fn to_wide(&self) -> f32 {
        return f32::from(*self);
    }

    fn from_wide(v: f32) -> f16 {
        return f16::from_f32(v);
    }
}

impl Held for bf16 {
    fn to_wide(&self) -> f32 {
        return f32::from(*self);
    }

    fn from_wide(v: f32) -> bf16 {
        return bf16::from_f32(v);
    }
}

/// A held tensor in f32, where the kernels compute.
pub fn widen<E: Held, Axes>(t: &Tensor<E, Axes>) -> Tensor<f32, Axes> {
    return map(t, |v| v.to_wide());
}

/// An f32 tensor rounded to the type it is held in.
pub fn narrow<E: Held, Axes>(t: &Tensor<f32, Axes>) -> Tensor<E, Axes> {
    return map(t, |v| E::from_wide(v));
}

/// An element type a backend stores: one the kernels compute in. Each converts
/// to another as ONNX's `Cast` does: a bool is 1 or 0, and anything nonzero is
/// true.
pub trait Element with () {
    /// Which element this is, for a graph that records its operations rather
    /// than computing them.
    fn kind() -> ElementKind;
    fn cast_to<T: Element>(&self) -> T;
    fn from_f32(v: f32) -> Self;
    fn from_i64(v: i64) -> Self;
    fn from_bool(v: bool) -> Self;
    /// Whether this is `f32`, the one element a GPU computes in: WGSL has
    /// neither `i64` nor a stored `bool`.
    fn is_f32() -> bool {
        return Self::kind() matches { F32 };
    }
    /// Whether an f32 holds every value of this exactly, so a GPU can store
    /// it as one: `f32` itself, and `bool` as 1.0 and 0.0.
    fn exact_in_f32() -> bool {
        return Self::is_f32();
    }
}

/// Each [`Element`].
pub enum ElementKind {
    F32,
    I64,
    Bool,
}

impl Element for f32 {
    fn kind() -> ElementKind {
        return ElementKind::F32;
    }

    fn cast_to<T: Element>(&self) -> T {
        return T::from_f32(*self);
    }

    fn from_f32(v: f32) -> f32 {
        return v;
    }

    fn from_i64(v: i64) -> f32 {
        return v as f32;
    }

    fn from_bool(v: bool) -> f32 {
        return if v { 1.0 } else { 0.0 };
    }
}

impl Element for i64 {
    fn kind() -> ElementKind {
        return ElementKind::I64;
    }

    fn cast_to<T: Element>(&self) -> T {
        return T::from_i64(*self);
    }

    fn from_f32(v: f32) -> i64 {
        return v as i64;
    }

    fn from_i64(v: i64) -> i64 {
        return v;
    }

    fn from_bool(v: bool) -> i64 {
        return if v { 1 } else { 0 };
    }
}

impl Element for bool {
    fn kind() -> ElementKind {
        return ElementKind::Bool;
    }

    fn cast_to<T: Element>(&self) -> T {
        return T::from_bool(*self);
    }

    fn from_f32(v: f32) -> bool {
        return v != 0.0;
    }

    fn from_i64(v: i64) -> bool {
        return v != 0;
    }

    fn from_bool(v: bool) -> bool {
        return v;
    }

    fn exact_in_f32() -> bool {
        return true;
    }
}

/// A one-operand operator of an [`Expr`].
pub enum UnaryOp {
    Relu,
    Sigmoid,
    Tanh,
    Erf,
    Exp,
    Log,
    Sqrt,
    Neg,
    Abs,
}

/// A two-operand operator of an [`Expr`]. The cases past `Pow` are
/// StableHLO's, named apart from any ONNX operator, which the generator reads
/// a case by: `maximum` and `minimum` are NaN where either operand is, and a
/// comparison is IEEE's, a NaN equal to nothing, and 1.0 where it holds.
pub enum BinaryOp {
    Add,
    Sub,
    Mul,
    Div,
    Pow,
    Maximum,
    Minimum,
    Eq,
    Ne,
    Lt,
    Le,
    Gt,
    Ge,
}

/// A fold of a step along a row of a row kernel.
pub enum RowOp {
    /// Added from 0.0, in the row's order.
    Sum,
    /// Folded from negative infinity by `ieee754_max`.
    Max,
}

/// One step of an [`Expr`], reading the steps before it by position.
pub variant Step {
    Operand(i32),
    Constant(f32),
    Unary([UnaryOp, i32]),
    Binary([BinaryOp, i32, i32]),
    /// `[condition, then, else]`: the second where the first is not zero.
    Select([i32, i32, i32]),
    /// The step folded along its row, the same at every element of the row.
    /// Only a row kernel (`fused_rows`) runs one.
    Fold([RowOp, i32]),
}

/// Constants compare by their bits, since a step stands for what it computes:
/// `==` on `f32` takes -0.0 for 0.0, which a sum tells apart, and every NaN for
/// one, whose payload a shader passes on.
impl Eq for Step {
    fn eq(&self, other: &Self) -> bool {
        return self.key() == other.key();
    }
}

impl Ord for Step {
    fn cmp(&self, other: &Self) -> Ordering {
        return self.key().cmp(&other.key());
    }
}

impl Step {
    /// The case, then its payload, each as a number.
    pub fn key(&self) -> [i32, i32, i32, i32] {
        return match *self {
            Operand(n) => [0, n, 0, 0],
            Constant(c) => [1, c.to_bits() as i32, 0, 0],
            Unary([op, a]) => [2, ReflectEnum::<UnaryOp>::discriminant(&op), a, 0],
            Binary([op, a, b]) => [3, ReflectEnum::<BinaryOp>::discriminant(&op), a, b],
            Select([c, a, b]) => [4, c, a, b],
            Fold([op, a]) => [5, ReflectEnum::<RowOp>::discriminant(&op), a, 0],
        };
    }
}

/// An elementwise operator as data: each output element over the operands'
/// elements at its position and the constants folded in. A backend reads it as
/// it can, the CPU one step at a time and a GPU one as a shader, which a
/// closure could never become.
pub struct Expr {
    /// Each reading the steps before it, the last the output.
    pub steps: List<Step>,
}

/// The kernel's operand `index`: 0 the first, 1 the second.
pub fn operand(index: i32) -> Expr {
    return Expr {
        steps: [Step::Operand(index)],
    };
}

/// A constant folded into the operator.
pub fn constant(value: f32) -> Expr {
    return Expr {
        steps: [Step::Constant(value)],
    };
}

impl Expr {
    /// `op` applied to this.
    pub fn unary(&self, op: UnaryOp) -> Expr {
        let mut e = *self;
        e.ended(Step::Unary([op, self.last()]));
        return e;
    }

    /// `op` applied to this and `rhs`.
    pub fn binary(&self, op: BinaryOp, rhs: &Expr) -> Expr {
        let mut e = *self;
        let b = e.merged(rhs);
        e.ended(Step::Binary([op, self.last(), b]));
        return e;
    }

    /// `then` where this is not zero, and `otherwise` where it is.
    pub fn select(&self, then: &Expr, otherwise: &Expr) -> Expr {
        let mut e = *self;
        let a = e.merged(then);
        let b = e.merged(otherwise);
        e.ended(Step::Select([self.last(), a, b]));
        return e;
    }

    /// This folded along its row by `op`, read at every element of the row.
    pub fn row(&self, op: RowOp) -> Expr {
        let mut e = *self;
        e.ended(Step::Fold([op, self.last()]));
        return e;
    }

    /// This summed along its row, divided by `count` where one is given: a
    /// mean.
    pub fn row_sum(&self, count: Option<f32>) -> Expr {
        let sum = self.row(RowOp::Sum);
        return match count {
            Some(n) => sum.binary(BinaryOp::Div, &constant(n)),
            None => sum,
        };
    }

    /// ONNX's `Softmax` of this along its row: each element's exponential,
    /// less the row's largest first so none overflows, over the row's sum of
    /// them.
    pub fn row_softmax(&self) -> Expr {
        let e = self.binary(BinaryOp::Sub, &self.row(RowOp::Max)).unary(UnaryOp::Exp);
        return e.binary(BinaryOp::Div, &e.row(RowOp::Sum));
    }

    /// The one value a reducing row kernel writes for a row of no elements,
    /// `operands[k]` the value per row operand `k` holds there, or `None` for
    /// an operand along the row. A fold of nothing is its start, 0.0 for a
    /// sum and negative infinity for a maximum.
    pub fn over_empty_row(&self, operands: &List<Option<f32>>) -> f32 {
        let mut values: List<Option<f32>> = [];
        for let step of self.steps {
            values.push(match step {
                Operand(k) => operands[k],
                Constant(c) => Option::Some(c),
                Unary([op, a]) => match values[a] {
                    Some(v) => Option::Some(unary_over(op, &whole([v]))[0]),
                    None => null,
                },
                Binary([op, a, b]) => match [values[a], values[b]] {
                    [Some(x), Some(y)] => Option::Some(binary_over(op, &whole([x]), &whole([y]))[0]),
                    _ => null,
                },
                Select([c, a, b]) => match [values[c], values[a], values[b]] {
                    [Some(k), Some(x), Some(y)] => Option::Some(if k != 0.0 { x } else { y }),
                    _ => null,
                },
                Fold([op, _]) => Option::Some(folded(op, &whole([]), 0)),
            });
        }
        let Some(value) = values[values.len() - 1] else {
            panic("loam: a reducing row kernel's output reads an element of its row");
        };
        return value;
    }

    /// This with each `operand(k)` reading `to[k]` instead.
    pub fn renumbered(&self, to: &List<i32>) -> Expr {
        return Expr {
            steps: self.steps.into_iter().map(|step| match step {
                Operand(k) => Step::Operand(to[k]),
                other => other,
            }).collect(),
        };
    }

    /// Whether a step folds along a row, so only a row kernel runs this.
    pub fn folds_rows(&self) -> bool {
        return self.fold_count() > 0;
    }

    /// The steps that fold along a row.
    pub fn fold_count(&self) -> i32 {
        return self.steps.into_iter().filter(|s| s matches { Fold(_) }).count();
    }

    fn last(&self) -> i32 {
        return self.steps.len() - 1;
    }

    /// `other`'s steps added to these, each one these already compute taken
    /// once, and where `other`'s output now is.
    fn merged(&mut self, other: &Expr) -> i32 {
        let mut at: List<i32> = [];
        for let step of other.steps {
            at.push(self.shared(match step {
                Unary([o, a]) => Step::Unary([o, at[a]]),
                Binary([o, a, b]) => Step::Binary([o, at[a], at[b]]),
                Select([c, a, b]) => Step::Select([at[c], at[a], at[b]]),
                Fold([o, a]) => Step::Fold([o, at[a]]),
                leaf => leaf,
            }));
        }
        return at[at.len() - 1];
    }

    /// The step at `at` as the output: computed again last where it is not
    /// the last.
    pub fn ending(&mut self, at: i32) {
        if at != self.last() {
            self.steps.push(self.steps[at]);
        }
    }

    /// Where `step` is computed: an equal step already here, or `step` added
    /// last.
    pub fn shared(&mut self, step: Step) -> i32 {
        if let Some(at) = self.steps.position(|s| s == step) {
            return at;
        }
        self.steps.push(step);
        return self.last();
    }

    /// `step` as the output, which is always the last step: one already
    /// computed earlier is computed again there.
    fn ended(&mut self, step: Step) {
        let at = self.shared(step);
        self.ending(at);
    }

    /// The output's `count` elements over whole operands, `operand(i)` reading
    /// `operands[i]`. Each holds a run of elements the output repeats, so
    /// output element `j` reads its element `j % len`: all `count` of them,
    /// one, or the output's trailing axes.
    pub fn over(&self, count: i32, operands: &List<&List<f32>>) -> List<f32>
        contract !self.folds_rows()
    {
        return self.in_passes(count, CHUNK, operands);
    }

    /// `over`, one pass per row of `row` elements, so a `Fold` step folds
    /// exactly one row.
    pub fn over_rows(&self, count: i32, row: i32, operands: &List<&List<f32>>) -> List<f32>
        contract row > 0 && count % row == 0
    {
        return self.in_passes(count, row, operands);
    }

    fn in_passes(&self, count: i32, size: i32, operands: &List<&List<f32>>) -> List<f32> {
        for let o of *operands {
            assert count == 0 || o.len() > 0 && count % o.len() == 0;
        }
        let mut out = List::<f32>::filled(count, 0.0);
        for let mut start = 0; start < count; start += size {
            self.pass(&mut out, start, i32::min(size, count - start), operands);
        }
        return out;
    }

    /// The `n` output elements from `start`, every step run over them before
    /// the next pass, written to `out` there.
    fn pass(&self, out: &mut List<f32>, start: i32, n: i32, operands: &List<&List<f32>>) {
        let mut values: List<Slice<f32>> = [];
        for let step of self.steps {
            values.push(match step {
                Operand(k) => run_of(operands[k], start, n),
                Constant(c) => whole([c]),
                Unary([op, a]) => whole(unary_over(op, &values[a])),
                Binary([op, a, b]) => whole(binary_over(op, &values[a], &values[b])),
                Select([c, a, b]) => whole(selected(&values[c], &values[a], &values[b])),
                Fold([op, a]) => whole([folded(op, &values[a], n)]),
            });
        }
        let last = &values[values.len() - 1];
        for let j of 0..<n {
            out[start + j] = value_at(last, j);
        }
    }
}

/// A step's value at element `j` of a pass: a step of one value holds it at
/// every element.
fn value_at(v: &Slice<f32>, j: i32) -> f32 {
    return if v.len() == 1 { v[0] } else { v[j] };
}

/// `v`'s `n` elements folded by `op`.
fn folded(op: RowOp, v: &Slice<f32>, n: i32) -> f32 {
    return match op {
        Sum => {
            let mut sum: f32 = 0.0;
            for let j of 0..<n {
                sum += value_at(v, j);
            }
            sum;
        },
        Max => {
            let mut max = -f32::INFINITY;
            for let j of 0..<n {
                max = f32::ieee754_max(max, value_at(v, j));
            }
            max;
        },
    };
}

/// `a` where `c` is not zero and `b` where it is, element by element.
fn selected(c: &Slice<f32>, a: &Slice<f32>, b: &Slice<f32>) -> List<f32> {
    let count = i32::max(c.len(), i32::max(a.len(), b.len()));
    let mut out = List::<f32>::with_capacity(count);
    for let j of 0..<count {
        out.push(if value_at(c, j) != 0.0 { value_at(a, j) } else { value_at(b, j) });
    }
    return out;
}

fn whole(values: List<f32>) -> Slice<f32> {
    return values[0..<values.len()];
}

/// The output elements an `Expr` computes per pass. A step's values never
/// outgrow it, so what one operator hands the next stays in cache rather than
/// becoming a tensor. Each step is still one loop whose operator is fixed
/// before it starts: read step by step per element, an `Expr` runs several
/// times slower.
global CHUNK: i32 = 1024;

/// The `n` output elements from `start` read from `values`, which the output
/// repeats: a slice where they lie in one stretch, its one value where it
/// holds one, and gathered where the pass wraps around it.
fn run_of(values: &List<f32>, start: i32, n: i32) -> Slice<f32> {
    let len = values.len();
    if len == 1 {
        return values[0..<1];
    }
    let at = start % len;
    if at + n <= len {
        return values[at..<at + n];
    }
    let mut out = List::<f32>::with_capacity(n);
    for let j of 0..<n {
        out.push(values[(start + j) % len]);
    }
    return whole(out);
}

fn unary_over(op: UnaryOp, v: &Slice<f32>) -> List<f32> {
    return match op {
        Relu => each(v, |e| f32::ieee754_max(e, 0.0)),
        Sigmoid => each(v, |e| sigmoid_f32(e)),
        Tanh => each(v, |e| f32::tanh(e)),
        Erf => each(v, |e| f32::erf(e)),
        Exp => each(v, |e| f32::exp(e)),
        Log => each(v, |e| f32::ln(e)),
        Sqrt => each(v, |e| f32::sqrt(e)),
        Neg => each(v, |e| -e),
        Abs => each(v, |e| f32::abs(e)),
    };
}

fn binary_over(op: BinaryOp, a: &Slice<f32>, b: &Slice<f32>) -> List<f32> {
    return match op {
        Add => pairwise(a, b, |x, y| x + y),
        Sub => pairwise(a, b, |x, y| x - y),
        Mul => pairwise(a, b, |x, y| x * y),
        Div => pairwise(a, b, |x, y| x / y),
        Pow => pairwise(a, b, |x, y| f32::pow(x, y)),
        Maximum => pairwise(a, b, |x, y| f32::ieee754_max(x, y)),
        Minimum => pairwise(a, b, |x, y| f32::ieee754_min(x, y)),
        Eq => pairwise(a, b, |x, y| holds(x.ieee754_eq(y))),
        Ne => pairwise(a, b, |x, y| holds(!x.ieee754_eq(y))),
        Lt => pairwise(a, b, |x, y| holds(x.ieee754_lt(y))),
        Le => pairwise(a, b, |x, y| holds(x.ieee754_le(y))),
        Gt => pairwise(a, b, |x, y| holds(x.ieee754_gt(y))),
        Ge => pairwise(a, b, |x, y| holds(x.ieee754_ge(y))),
    };
}

/// A condition as the f32 an `Expr` holds it in.
fn holds(condition: bool) -> f32 {
    return if condition { 1.0 } else { 0.0 };
}

fn each(v: &Slice<f32>, f: fn(f32) -> f32) -> List<f32> {
    let mut out = List::<f32>::with_capacity(v.len());
    for let e of *v {
        out.push(f(e));
    }
    return out;
}

/// `f` over `a` and `b` element by element, a one-element side read at each.
fn pairwise(a: &Slice<f32>, b: &Slice<f32>, f: fn(f32, f32) -> f32) -> List<f32> {
    let count = i32::max(a.len(), b.len());
    assert (a.len() == count || a.len() == 1) && (b.len() == count || b.len() == 1);
    let mut out = List::<f32>::with_capacity(count);
    if a.len() == b.len() {
        for let i of 0..<count {
            out.push(f(a[i], b[i]));
        }
    } else if a.len() == 1 {
        let x = a[0];
        for let y of *b {
            out.push(f(x, y));
        }
    } else {
        let y = b[0];
        for let x of *a {
            out.push(f(x, y));
        }
    }
    return out;
}

/// An operand of a fused elementwise kernel whose output has the axes `Axes`:
/// its elements, and its extents aligned with the output's from the end, where
/// an extent of 1 or a missing axis stretches.
pub struct Read<Axes> {
    pub data: &List<f32>,
    pub extents: List<i32>,
}

/// `op` over `operands` at each element of `extents`, each operand stretched
/// to them.
pub fn fused<Axes>(operands: &List<Read<Axes>>, op: &Expr, extents: List<i32>) -> Tensor<f32, Axes> {
    return Tensor { data: op.over(element_count(&extents), &repeated_over(operands, &extents)), extents };
}

/// `op` over `operands` row by row of `extents`, a row being its last
/// `row_axes` axes, so a `Fold` step folds along one. Where `reduced`, the
/// output holds each row's first element, the row axes at extent 1.
pub fn fused_rows<In, Out>(
    operands: &List<Read<In>>,
    op: &Expr,
    row_axes: i32,
    reduced: bool,
    extents: List<i32>,
) -> Tensor<f32, Out> {
    let rank = extents.len();
    assert 0 < row_axes <= rank;
    let row = element_count(&extents[rank - row_axes..<rank].to_list());
    let count = element_count(&extents);
    if count == 0 {
        let out = row_extents(&extents, row_axes, reduced);
        return Tensor { data: over_no_elements(operands, op, &out), extents: out };
    }
    let full = op.over_rows(count, row, &repeated_over(operands, &extents));
    if !reduced {
        return Tensor { data: full, extents };
    }
    let mut data = List::<f32>::with_capacity(count / row);
    for let mut at = 0; at < count; at += row {
        data.push(full[at]);
    }
    return Tensor { data, extents: row_extents(&extents, row_axes, true) };
}

/// What a row kernel over no elements writes to an output of `out`: nothing
/// where `out` has no elements, and otherwise, its rows reduced, each row's
/// fold of nothing and the values per row `operands` hold there.
fn over_no_elements<Axes>(operands: &List<Read<Axes>>, op: &Expr, out: &List<i32>) -> List<f32> {
    let rows = element_count(out);
    if rows == 0 {
        return [];
    }
    // An operand with elements holds one per row; the rest run along it.
    let mut per_row: List<Read<Axes>> = [];
    let mut at: List<i32> = [];
    for let o of *operands {
        if element_count(&o.extents) == 0 {
            at.push(-1);
        } else {
            at.push(per_row.len());
            per_row.push(o);
        }
    }
    let runs = repeated_over(&per_row, out);
    let mut data = List::<f32>::with_capacity(rows);
    for let r of 0..<rows {
        let values: List<Option<f32>> = at.into_iter().map(|k| if k < 0 {
            null;
        } else {
            Option::Some(runs[k][r % runs[k].len()]);
        }).collect();
        data.push(op.over_empty_row(&values));
    }
    return data;
}

/// `extents` with its last `row_axes` at 1 where `reduced`.
pub fn row_extents(extents: &List<i32>, row_axes: i32, reduced: bool) -> List<i32> {
    let mut out = *extents;
    if reduced {
        for let axis of extents.len() - row_axes..<extents.len() {
            out[axis] = 1;
        }
    }
    return out;
}

/// Each of `operands` as a run of elements an output of `extents` repeats:
/// itself where it repeats over them, and otherwise stretched to them.
fn repeated_over<Axes>(operands: &List<Read<Axes>>, extents: &List<i32>) -> List<&List<f32>> {
    let mut reads: List<&List<f32>> = [];
    for let o of *operands {
        if repeats_over(&o.extents, extents) {
            reads.push(o.data);
        } else {
            let stretched = stretched_to(o.data, &o.extents, extents);
            reads.push(&stretched);
        }
    }
    return reads;
}

/// The elementwise operators a contraction applies to each element it
/// computes, once the element is complete: `op` reads that element as
/// `operand(0)`, and `operands[i]` as `operand(i + 1)`.
pub struct Epilogue<O> {
    pub operands: List<O>,
    pub op: Expr,
}

/// What a product computes its left operand from, each element as it reads
/// it: `op` over `operands`, `operand(i)` reading the `i`th, row by row along
/// the product's inner axis as [`fused_rows`] runs it, so a `Fold` step
/// folds a row of the left operand.
pub struct Prologue<O> {
    pub operands: List<O>,
    pub op: Expr,
}

/// An epilogue ready to apply to a contraction's output of `extents`.
struct Finish {
    op: Expr,
    /// Each operand after the contraction's own, as `repeated_over` reads it.
    reads: List<&List<f32>>,
}

fn finish<Axes>(then: &Option<Epilogue<Read<Axes>>>, extents: &List<i32>) -> Option<Finish> {
    let Some(e) = then else {
        return null;
    };
    return Option::Some(Finish { op: e.op, reads: repeated_over(&e.operands, extents) });
}

impl Finish {
    /// The epilogue over `out`'s `n` elements from `start`, which the
    /// contraction has just completed, written back in place.
    fn apply(&self, out: &mut List<f32>, start: i32, n: i32) {
        let mut operands: List<&List<f32>> = [out];
        operands.extend(&self.reads);
        for let mut at = start; at < start + n; at += CHUNK {
            self.op.pass(out, at, i32::min(CHUNK, start + n - at), &operands);
        }
    }
}

/// `data`, of `from`, repeated over `to` where `from` stretches.
fn stretched_to<E>(data: &List<E>, from: &List<i32>, to: &List<i32>) -> List<E> {
    let count = element_count(to);
    let steps = stretched_carries(from, to);
    let mut out = List::<E>::with_capacity(count);
    let mut index = List::<i32>::filled(to.len(), 0);
    let mut at = 0;
    for let _ of 0..<count {
        out.push(data[at]);
        let axis = advance(&mut index, to);
        if axis >= 0 {
            at += steps[axis];
        }
    }
    return out;
}

/// How a graph holds a tensor, which a generated `Cache` and `Passed` are
/// generic over.
pub affine trait Holds with _ {
    type Tensor<E: Element, Axes>;

    /// `t`, held on the host, as this holds it.
    fn upload<E: Element, Axes>(&mut self, t: &Tensor<E, Axes>) -> Self::Tensor<E, Axes>;
    /// `t`, a weight every pass reads, as this holds it for as long as it
    /// lives: on a device, where its kernels run.
    fn keep<E: Element, Axes>(&mut self, t: &Tensor<E, Axes>) -> Self::Tensor<E, Axes> {
        return self.upload(t);
    }
    /// `t`, held in half precision on the host, as this computes with it. How
    /// it stores the result is its own: the type says only that what reads it
    /// reads it as f32.
    fn prepare<E: Held, Axes>(&mut self, t: &Tensor<E, Axes>) -> Self::Tensor<f32, Axes> {
        return self.keep(&widen(t));
    }
    /// `t`'s extents.
    fn extents_of<E: Element, Axes>(&self, t: &Self::Tensor<E, Axes>) -> List<i32>;
    /// `t` back on the host.
    fn download<E: Element, Axes>(&mut self, t: &Self::Tensor<E, Axes>) -> Tensor<E, Axes>;
    /// The start of a pass. What the pass before computed is dead, but for
    /// what it retained: `compute` has downloaded its outputs, so a graph may
    /// release it.
    fn begin(&mut self) {
    }
    /// Keeps `t` alive through the next [`Self::begin`], for the pass after
    /// it to read, as a model retains the attention cache it still holds just
    /// before it begins. The begin after that releases it, unless `t` is
    /// retained again.
    fn retain<E: Element, Axes>(&mut self, t: &Self::Tensor<E, Axes>) {
    }
}

/// The graph that runs where the module runs.
pub struct Cpu {
}

impl Holds for Cpu {
    type Tensor<E: Element, Axes> = Tensor<E, Axes>;

    fn upload<E: Element, Axes>(&mut self, t: &Tensor<E, Axes>) -> Tensor<E, Axes> {
        return *t;
    }

    fn extents_of<E: Element, Axes>(&self, t: &Tensor<E, Axes>) -> List<i32> {
        return t.extents;
    }

    fn download<E: Element, Axes>(&mut self, t: &Tensor<E, Axes>) -> Tensor<E, Axes> {
        return *t;
    }
}
