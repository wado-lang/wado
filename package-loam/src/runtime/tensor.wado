/// A tensor of `E` over the axis list `Axes`, row-major.
pub struct Tensor<E, Axes> {
    pub data: List<E>,
    pub extents: List<i32>,
}

/// The elements `extents` hold, or `None` where its non-empty extents multiply
/// past `i32::MAX`. A kernel counts sub-shapes, so every partial product must fit.
pub fn checked_element_count(extents: &List<i32>) -> Option<i32> {
    let mut count = 1;
    let mut empty = false;
    for let e of *extents {
        assert e >= 0;
        if e == 0 {
            empty = true;
        } else if count > i32::MAX / e {
            return null;
        } else {
            count *= e;
        }
    }
    return Option::Some(if empty { 0 } else { count });
}

/// The elements a tensor of `extents` holds, which a list must be able to hold.
pub fn element_count(extents: &List<i32>) -> i32 {
    let Some(count) = checked_element_count(extents) else {
        panic(`extents ${*extents} multiply past what a list can hold`);
    };
    return count;
}

/// Why the input `tensor` disagrees with the graph. `stated` holds each axis's
/// extent where the graph states one, and -1 where it leaves the axis to the run.
pub fn input_mismatch<E, Axes>(
    t: &Tensor<E, Axes>,
    tensor: String,
    axes: List<String>,
    stated: List<i32>,
) -> Option<String> {
    if t.extents.len() != axes.len() {
        return Option::Some(`${tensor}: the tensor gives ${t.extents.len()} axes, and the graph [${axes.join(", ")}]`);
    }
    for let [i, axis] of axes.into_iter().enumerate() {
        let extent = t.extents[i];
        if extent < 0 {
            return Option::Some(`${tensor}: axis ${axis} is ${extent} in the tensor`);
        }
        if stated[i] >= 0 && extent != stated[i] {
            return Option::Some(`${tensor}: axis ${axis} is ${extent} in the tensor and ${stated[i]} in the graph`);
        }
    }
    let Some(count) = checked_element_count(&t.extents) else {
        return Option::Some(`${tensor}: extents ${t.extents} multiply past what a list can hold`);
    };
    if count != t.data.len() {
        return Option::Some(`${tensor}: extents ${t.extents} hold ${count} elements, and the data ${t.data.len()}`);
    }
    return null;
}

/// Why two inputs disagree on an extent the graph leaves to the run as `symbol`.
pub fn axis_mismatch(
    symbol: String,
    tensor: String,
    axis: String,
    extent: i32,
    other: String,
    other_extent: i32,
) -> Option<String> {
    if extent == other_extent {
        return null;
    }
    return Option::Some(
        `${tensor}: axis ${axis} is ${extent} in the tensor and ${other_extent} in ${other}, and the graph makes both ${symbol}`,
    );
}

/// Why an input's axis is not the length the graph spells for it, `length`,
/// which the other inputs make `expected`.
pub fn extent_mismatch(tensor: String, axis: String, extent: i32, length: String, expected: i64) -> Option<String> {
    if extent as i64 == expected {
        return null;
    }
    return Option::Some(
        `${tensor}: axis ${axis} is ${extent} in the tensor, and the graph makes it ${length}, which the inputs make ${expected}`,
    );
}

/// Why the inputs break a condition the build relied on and could not prove:
/// `slack` is how far within it they are, and `condition` states it.
pub fn unmet(slack: i64, condition: String) -> Option<String> {
    if slack >= 0 {
        return null;
    }
    return Option::Some(`${condition}, and the inputs miss it by ${-slack}`);
}

/// `a / d` rounded up, for a positive `d`, as `Slice` and `Range` count steps.
pub fn ceil_div(a: i64, d: i64) -> i64 {
    assert d > 0;
    let q = a / d;
    return if a % d > 0 { q + 1 } else { q };
}

/// `a / d` rounded down, for a positive `d`.
pub fn floor_div(a: i64, d: i64) -> i64 {
    assert d > 0;
    let q = a / d;
    return if a % d < 0 { q - 1 } else { q };
}

/// An ONNX index into an axis of `extent` positions, which counts from the end
/// where negative.
pub fn from_end(i: i64, extent: i64) -> i64 {
    return if i < 0 { i + extent } else { i };
}

/// A tensor of `extents` holding `value` at every position, as a
/// `ConstantOfShape` whose shape only the run knows fills it.
pub fn filled<E, Axes>(extents: List<i32>, value: E) -> Tensor<E, Axes> {
    return Tensor { data: List::<E>::filled(element_count(&extents), value), extents };
}

/// A length `forward` computed from the inputs', as the kernels take one. It
/// is computed in `i64` so that no product of lengths wraps on the way.
pub fn to_extent(value: i64) -> i32 {
    if !(0 <= value <= i32::MAX as i64) {
        panic(`the inputs make a length of ${value}, which no list holds`);
    }
    return value as i32;
}

/// Stops `forward` with the reason an input disagrees with the graph.
pub fn refuse(reason: Option<String>) {
    if let Some(r) = reason {
        panic(r);
    }
}

/// A batched matrix product whose operands share every batch axis.
pub fn matmul<..Bs, M, K, N>(a: &Tensor<f32, [..Bs, M, K]>, b: &Tensor<f32, [..Bs, K, N]>) -> Tensor<f32, [..Bs, M, N]> {
    return matmul_broadcast(a, b);
}

/// `matmul` with one matrix on the right, shared by every batch element, as a
/// language model's head multiplies each position by one weight.
pub fn matmul_shared<..Bs, M, K, N>(a: &Tensor<f32, [..Bs, M, K]>, b: &Tensor<f32, [K, N]>) -> Tensor<f32, [..Bs, M, N]> {
    return matmul_broadcast(a, b);
}

/// ONNX's `MatMul` in full, which is numpy's: a rank-1 operand is a row on the
/// left or a column on the right, whose axis the result drops, and the batch
/// axes broadcast. The caller spells `Out`.
pub fn matmul_broadcast<A, B, Out>(a: &Tensor<f32, A>, b: &Tensor<f32, B>) -> Tensor<f32, Out> {
    return product(a, b, &null);
}

/// `matmul_broadcast`, `then` applied to each batch element's matrix as it
/// completes.
fn product<A, B, Out>(a: &Tensor<f32, A>, b: &Tensor<f32, B>, then: &Option<Epilogue<Read<Out>>>) -> Tensor<f32, Out> {
    let a_matrix = if a.extents.len() == 1 { [1, a.extents[0]] as List<i32> } else { a.extents };
    let b_matrix = if b.extents.len() == 1 { [b.extents[0], 1] as List<i32> } else { b.extents };
    let ra = a_matrix.len();
    let rb = b_matrix.len();
    let rows = a_matrix[ra - 2];
    let inner = a_matrix[ra - 1];
    let cols = b_matrix[rb - 1];
    assert inner == b_matrix[rb - 2];
    let a_batch = a_matrix[0..<ra - 2].to_list();
    let b_batch = b_matrix[0..<rb - 2].to_list();
    let batch = broadcast_extents(&a_batch, &b_batch).unwrap();
    let mut extents = batch;
    if a.extents.len() > 1 {
        extents.push(rows);
    }
    if b.extents.len() > 1 {
        extents.push(cols);
    }
    let mut out = List::<f32>::filled(element_count(&extents), 0.0);
    let finishing = finish(then, &extents);
    // Each batch element's matrices, where a batch axis of 1 stretches.
    let a_carries = stretched_carries(&a_batch, &batch);
    let b_carries = stretched_carries(&b_batch, &batch);
    let mut index = List::<i32>::filled(batch.len(), 0);
    let [mut at_a, mut at_b] = [0, 0];
    let lhs_data = &a.data;
    let rhs_data = &b.data;
    for let s of 0..<element_count(&batch) {
        let a_base = at_a * rows * inner;
        let b_base = at_b * inner * cols;
        let out_base = s * rows * cols;
        for let mut r = 0; r < rows; r += 1 {
            for let mut k = 0; k < inner; k += 1 {
                let lhs = lhs_data[a_base + r * inner + k];
                for let mut c = 0; c < cols; c += 1 {
                    out[out_base + r * cols + c] += lhs * rhs_data[b_base + k * cols + c];
                }
            }
        }
        if let Some(f) = &finishing {
            f.apply(&mut out, out_base, rows * cols);
        }
        let axis = advance(&mut index, &batch);
        if axis >= 0 {
            at_a += a_carries[axis];
            at_b += b_carries[axis];
        }
    }
    return Tensor { data: out, extents };
}

/// `Gather` along axis 0: the row of `data` each index names, as an embedding
/// looks a token up. A negative index counts from the end.
pub fn gather_rows<E, Row, ..Rest, ..Ix>(
    data: &Tensor<E, [Row, ..Rest]>,
    indices: &Tensor<i64, [..Ix]>,
) -> Tensor<E, [..Ix, ..Rest]> {
    return gathered(data, indices, 0);
}

/// `Gather` along `axis`: the index axes take its place, and each index names
/// one of its positions. The caller spells the axes, since the index axes land
/// between two packs.
pub fn gather<E, ..Pre, Along, ..Post, ..Ix>(
    data: &Tensor<E, [..Pre, Along, ..Post]>,
    indices: &Tensor<i64, [..Ix]>,
    axis: i32,
) -> Tensor<E, [..Pre, ..Ix, ..Post]> {
    return gathered(data, indices, axis);
}

/// `Gather` along `axis`, the kernel `gather_rows` and `gather` share.
fn gathered<E, D, Ix, Out>(data: &Tensor<E, D>, indices: &Tensor<i64, Ix>, axis: i32) -> Tensor<E, Out> {
    let rank = data.extents.len();
    let along = data.extents[axis];
    let before = data.extents[0..<axis].to_list();
    let after = data.extents[axis + 1..<rank].to_list();
    let outer = element_count(&before);
    let inner = element_count(&after);
    let mut extents = before;
    extents.extend(&indices.extents);
    extents.extend(&after);
    let mut out = List::<E>::with_capacity(element_count(&extents));
    for let o of 0..<outer {
        for let index of indices.data {
            let at = from_end(index, along as i64);
            assert 0 <= at < along as i64;
            let base = (o * along + at as i32) * inner;
            for let k of 0..<inner {
                out.push(data.data[base + k]);
            }
        }
    }
    return Tensor { data: out, extents };
}

/// `extents` followed by `count` extents of 1, which broadcasting from the end
/// stretches across the axes they stand for.
pub fn followed_by_units(extents: &List<i32>, count: i32) -> List<i32> {
    let mut out = *extents;
    for let _ of 0..<count {
        out.push(1);
    }
    return out;
}

/// Whether an operand of `extents`, broadcast to `out`, repeats one run of its
/// elements across `out`'s leading axes: its extents past its leading ones of
/// 1 are `out`'s trailing ones. Element `i` of the output then reads its
/// element `i % len`, with no stretched copy made.
pub fn repeats_over(extents: &List<i32>, out: &List<i32>) -> bool {
    let mut first = 0;
    while first < extents.len() && extents[first] == 1 {
        first += 1;
    }
    let offset = out.len() - (extents.len() - first);
    if offset < 0 {
        return false;
    }
    for let i of first..<extents.len() {
        if out[offset + i - first] != extents[i] {
            return false;
        }
    }
    return true;
}

/// ONNX's `Where`: `x` where `cond` holds and `y` elsewhere, each operand
/// stretched under ONNX's broadcasting.
pub fn select<E, Axes>(cond: &Tensor<bool, Axes>, x: &Tensor<E, Axes>, y: &Tensor<E, Axes>) -> Tensor<E, Axes> {
    let extents = broadcast_extents(&broadcast_extents(&cond.extents, &x.extents).unwrap(), &y.extents).unwrap();
    let rank = extents.len();
    let c_carries = stretched_carries(&cond.extents, &extents);
    let x_carries = stretched_carries(&x.extents, &extents);
    let y_carries = stretched_carries(&y.extents, &extents);
    let count = element_count(&extents);
    let mut out = List::<E>::with_capacity(count);
    let mut index = List::<i32>::filled(rank, 0);
    let mut at_c = 0;
    let mut at_x = 0;
    let mut at_y = 0;
    for let _ of 0..<count {
        out.push(if cond.data[at_c] { x.data[at_x] } else { y.data[at_y] });
        let axis = advance(&mut index, &extents);
        if axis >= 0 {
            at_c += c_carries[axis];
            at_x += x_carries[axis];
            at_y += y_carries[axis];
        }
    }
    return Tensor { data: out, extents };
}

/// ONNX's `Range` over integers: `count` values from `start`, `delta` apart.
pub fn range_i64<A>(start: i64, count: i32, delta: i64) -> Tensor<i64, [A]> {
    let mut data = List::<i64>::with_capacity(count);
    for let i of 0..<count {
        data.push(start + i as i64 * delta);
    }
    return Tensor {
        data,
        extents: [count],
    };
}

/// The `length` positions along `axis` from `start`, `step` apart, which
/// `Split` and `Slice` cut. The caller spells both packs.
pub fn slice_axis<E, ..Pre, In, Out, ..Post>(
    t: &Tensor<E, [..Pre, In, ..Post]>,
    axis: i32,
    start: i64,
    length: i32,
    step: i64,
) -> Tensor<E, [..Pre, Out, ..Post]> {
    let extent = t.extents[axis];
    assert length >= 0;
    if length > 0 {
        let last = start + (length - 1) as i64 * step;
        assert 0 <= start < extent as i64 && 0 <= last < extent as i64;
    }
    let outer = element_count(&t.extents[0..<axis].to_list());
    let inner = element_count(&t.extents[axis + 1..<t.extents.len()].to_list());
    let mut out = List::<E>::with_capacity(outer * length * inner);
    for let o of 0..<outer {
        for let k of 0..<length {
            let base = (o * extent + (start + k as i64 * step) as i32) * inner;
            for let n of 0..<inner {
                out.push(t.data[base + n]);
            }
        }
    }
    let mut extents = t.extents;
    extents[axis] = length;
    return Tensor { data: out, extents };
}

/// `a` and then `b` along `axis`, the two meeting on every other axis, as
/// `Concat` joins a cache and the positions computed after it.
pub fn concat<E, ..Pre, A, B, Out, ..Post>(
    a: &Tensor<E, [..Pre, A, ..Post]>,
    b: &Tensor<E, [..Pre, B, ..Post]>,
    axis: i32,
) -> Tensor<E, [..Pre, Out, ..Post]> {
    let outer = element_count(&a.extents[0..<axis].to_list());
    let a_run = element_count(&a.extents[axis..<a.extents.len()].to_list());
    let b_run = element_count(&b.extents[axis..<b.extents.len()].to_list());
    let mut out = List::<E>::with_capacity(a.data.len() + b.data.len());
    for let o of 0..<outer {
        for let n of 0..<a_run {
            out.push(a.data[o * a_run + n]);
        }
        for let n of 0..<b_run {
            out.push(b.data[o * b_run + n]);
        }
    }
    let mut extents = a.extents;
    extents[axis] = a.extents[axis] + b.extents[axis];
    return Tensor { data: out, extents };
}

/// The same elements under `rank` axes, the ones added leading at extent 1, so
/// a lower-rank operand stretches as one of the output's rank does.
pub fn lift<E, In, Out>(t: &Tensor<E, In>, rank: i32) -> Tensor<E, Out> {
    assert rank >= t.extents.len();
    let mut extents = List::<i32>::filled(rank - t.extents.len(), 1);
    extents.extend(&t.extents);
    return Tensor { data: t.data, extents };
}

/// Moves a row-major `index` over `extents` one position on and returns the
/// axis that advanced, every later one having wrapped to 0; -1 past the end.
fn advance(index: &mut List<i32>, extents: &List<i32>) -> i32 {
    for let mut axis = extents.len() - 1; axis >= 0; axis -= 1 {
        index[axis] += 1;
        if index[axis] < extents[axis] {
            return axis;
        }
        index[axis] = 0;
    }
    return -1;
}

/// How far an offset stepping by `strides` moves when `advance` names each
/// axis: that axis's stride, less the span every later axis wound back.
fn carries(strides: &List<i32>, extents: &List<i32>) -> List<i32> {
    let mut carry = List::<i32>::filled(extents.len(), 0);
    let mut unwound = 0;
    for let mut axis = extents.len() - 1; axis >= 0; axis -= 1 {
        carry[axis] = strides[axis] - unwound;
        unwound += strides[axis] * (extents[axis] - 1);
    }
    return carry;
}

/// `carries` for a tensor of `extents` stretched over `out`.
fn stretched_carries(extents: &List<i32>, out: &List<i32>) -> List<i32> {
    return carries(&stretched_strides(extents, out.len()), out);
}

/// The extents two operands broadcast to under ONNX's rule, or `None` where an
/// axis meets a different extent and neither is 1.
pub fn broadcast_extents(a: &List<i32>, b: &List<i32>) -> Option<List<i32>> {
    let rank = i32::max(a.len(), b.len());
    let mut extents: List<i32> = [];
    for let i of 0..<rank {
        let ea = aligned_extent(a, rank, i);
        let eb = aligned_extent(b, rank, i);
        if ea != eb && ea != 1 && eb != 1 {
            return null;
        }
        extents.push(if ea == 1 { eb } else { ea });
    }
    return Option::Some(extents);
}

/// `extents` aligned to `rank` axes from the end, a missing axis being 1.
fn aligned_extent(extents: &List<i32>, rank: i32, axis: i32) -> i32 {
    let own = axis - (rank - extents.len());
    return if own < 0 { 1 } else { extents[own] };
}

/// Each of `rank` axes' step through a tensor of `extents`, aligned from the
/// end. A stretched axis steps by zero, so every position reads one element.
pub fn stretched_strides(extents: &List<i32>, rank: i32) -> List<i32> {
    let mut strides = List::<i32>::filled(rank, 0);
    let mut step = 1;
    for let mut back = 0; back < extents.len(); back += 1 {
        let e = extents[extents.len() - 1 - back];
        if e != 1 {
            strides[rank - 1 - back] = step;
        }
        step *= e;
    }
    return strides;
}

/// The axis a merge makes of `Parts`, a tuple of axis markers.
pub struct Merged<Parts> {
}

/// The same elements under another axis list. A regrouping keeps row-major
/// order, so no element moves.
pub fn reshape<E, In, Out>(t: &Tensor<E, In>, extents: List<i32>) -> Tensor<E, Out> {
    assert element_count(&extents) == t.data.len();
    return Tensor { data: t.data, extents };
}

/// Along each spatial axis: a window's extent, step, tap spacing and output
/// extent. `pads` is ONNX's order: every leading pad, then every trailing one.
pub struct Window {
    pub kernel: List<i32>,
    pub strides: List<i32>,
    pub dilations: List<i32>,
    pub pads: List<i32>,
    pub output: List<i32>,
}

/// ONNX's `MaxPool` over `window`: each position's greatest value under the
/// kernel, a padded position counting as none.
pub fn max_pool<N, C, ..In, ..Out>(x: &Tensor<f32, [N, C, ..In]>, window: &Window) -> Tensor<f32, [N, C, ..Out]> {
    let input = spatial_extents(&x.extents);
    let planes = x.extents[0] * x.extents[1];
    let in_size = element_count(&input);
    let out_size = element_count(&window.output);
    let extents = windowed_extents(x.extents[0], x.extents[1], window);
    let mut out = List::<f32>::filled(element_count(&extents), -f32::INFINITY);
    for let at of 0..<out_size {
        for let tap of 0..<element_count(&window.kernel) {
            let offset = tap_offset(&input, window, at, tap);
            if offset < 0 {
                continue;
            }
            for let plane of 0..<planes {
                out[plane * out_size + at] = f32::ieee754_max(
                    out[plane * out_size + at],
                    x.data[plane * in_size + offset],
                );
            }
        }
    }
    return Tensor { data: out, extents };
}

/// ONNX's `Conv` over `window`: each output channel sums every input channel
/// under its kernel.
pub fn conv<N, Ci, Co, ..In, ..K, ..Out>(
    x: &Tensor<f32, [N, Ci, ..In]>,
    w: &Tensor<f32, [Co, Ci, ..K]>,
    window: &Window,
) -> Tensor<f32, [N, Co, ..Out]> {
    return convolve(x, w, List::<f32>::filled(w.extents[0], 0.0), 1, window, &null);
}

/// `conv` plus each output channel's bias.
pub fn conv_bias<N, Ci, Co, ..In, ..K, ..Out>(
    x: &Tensor<f32, [N, Ci, ..In]>,
    w: &Tensor<f32, [Co, Ci, ..K]>,
    b: &Tensor<f32, [Co]>,
    window: &Window,
) -> Tensor<f32, [N, Co, ..Out]> {
    return convolve(x, w, b.data, 1, window, &null);
}

/// `conv` in `group` groups: each reads its own run of `Cg` input channels
/// and writes its own run of the output channels.
pub fn conv_grouped<N, Ci, Cg, Co, ..In, ..K, ..Out>(
    x: &Tensor<f32, [N, Ci, ..In]>,
    w: &Tensor<f32, [Co, Cg, ..K]>,
    group: i32,
    window: &Window,
) -> Tensor<f32, [N, Co, ..Out]> {
    return convolve(x, w, List::<f32>::filled(w.extents[0], 0.0), group, window, &null);
}

/// `conv_grouped` plus each output channel's bias.
pub fn conv_grouped_bias<N, Ci, Cg, Co, ..In, ..K, ..Out>(
    x: &Tensor<f32, [N, Ci, ..In]>,
    w: &Tensor<f32, [Co, Cg, ..K]>,
    b: &Tensor<f32, [Co]>,
    group: i32,
    window: &Window,
) -> Tensor<f32, [N, Co, ..Out]> {
    return convolve(x, w, b.data, group, window, &null);
}

/// A convolution in `group` groups, each output channel reading the input
/// channels of its own group, and `then` applied in place once every element
/// is complete. The loops run tap by tap over every output channel, so one
/// input element serves each channel while it is in cache; no channel's plane
/// completes before the last tap.
fn convolve<X, W, Y>(
    x: &Tensor<f32, X>,
    w: &Tensor<f32, W>,
    bias: List<f32>,
    group: i32,
    window: &Window,
    then: &Option<Epilogue<Read<Y>>>,
) -> Tensor<f32, Y> {
    let batch = x.extents[0];
    let channels = x.extents[1];
    let outputs = w.extents[0];
    let inputs = w.extents[1];
    assert inputs * group == channels && outputs % group == 0 && bias.len() == outputs;
    let group_outputs = outputs / group;
    let input = spatial_extents(&x.extents);
    let in_size = element_count(&input);
    let out_size = element_count(&window.output);
    let taps = element_count(&window.kernel);
    assert element_count(&spatial_extents(&w.extents)) == taps;
    let extents = windowed_extents(batch, outputs, window);
    let finishing = finish(then, &extents);
    let mut out = List::<f32>::with_capacity(element_count(&extents));
    for let _ of 0..<batch {
        for let oc of 0..<outputs {
            for let _ of 0..<out_size {
                out.push(bias[oc]);
            }
        }
    }
    for let at of 0..<out_size {
        for let tap of 0..<taps {
            let offset = tap_offset(&input, window, at, tap);
            if offset < 0 {
                continue;
            }
            for let n of 0..<batch {
                for let oc of 0..<outputs {
                    let first = n * channels + oc / group_outputs * inputs;
                    let mut sum: f32 = 0.0;
                    for let ic of 0..<inputs {
                        sum += x.data[(first + ic) * in_size + offset] * w.data[(oc * inputs + ic) * taps + tap];
                    }
                    out[(n * outputs + oc) * out_size + at] += sum;
                }
            }
        }
    }
    if let Some(f) = &finishing {
        f.apply(&mut out, 0, out.len());
    }
    return Tensor { data: out, extents };
}

/// The extents past the batch and channel axes, which a window slides over.
pub fn spatial_extents(extents: &List<i32>) -> List<i32> {
    return extents[2..<extents.len()].to_list();
}

fn windowed_extents(batch: i32, channels: i32, window: &Window) -> List<i32> {
    let mut extents = [batch, channels] as List<i32>;
    extents.extend(&window.output);
    return extents;
}

/// Where tap `tap` of the window at output position `at` reads one spatial
/// plane of extents `input`, row-major, or `-1` where it lands in the padding.
fn tap_offset(input: &List<i32>, window: &Window, at: i32, tap: i32) -> i32 {
    let spatial = input.len();
    let mut offset = 0;
    let mut step = 1;
    let mut rest_at = at;
    let mut rest_tap = tap;
    for let mut i = spatial - 1; i >= 0; i -= 1 {
        let o = rest_at % window.output[i];
        let k = rest_tap % window.kernel[i];
        rest_at /= window.output[i];
        rest_tap /= window.kernel[i];
        let position = o * window.strides[i] - window.pads[i] + k * window.dilations[i];
        if position < 0 || position >= input[i] {
            return -1;
        }
        offset += position * step;
        step *= input[i];
    }
    return offset;
}

/// A matrix transposed.
pub fn transpose2<E, A, B>(t: &Tensor<E, [A, B]>) -> Tensor<E, [B, A]> {
    return permute(t, [1, 0]);
}

/// The elements with input axis `perm[i]` moved to output axis `i`. The caller
/// spells `Out`, since each order of three or more axes is its own signature.
pub fn permute<E, In, Out>(t: &Tensor<E, In>, perm: List<i32>) -> Tensor<E, Out> {
    let rank = t.extents.len();
    assert perm.len() == rank;
    let in_strides = stretched_strides(&t.extents, rank);
    let mut extents: List<i32> = [];
    let mut strides: List<i32> = [];
    for let p of perm {
        extents.push(t.extents[p]);
        strides.push(in_strides[p]);
    }
    let steps = carries(&strides, &extents);
    let mut out = List::<E>::with_capacity(t.data.len());
    let mut index = List::<i32>::filled(rank, 0);
    let mut at = 0;
    for let _ of 0..<t.data.len() {
        out.push(t.data[at]);
        let axis = advance(&mut index, &extents);
        if axis >= 0 {
            at += steps[axis];
        }
    }
    return Tensor { data: out, extents };
}

/// ONNX's `Softmax` along `axis`: each lane's exponentials over their sum.
pub fn softmax<Axes>(t: &Tensor<f32, Axes>, axis: i32) -> Tensor<f32, Axes> {
    return softmax_lanes(t, axis, axis + 1);
}

/// ONNX's `Softmax` before opset 13, which normalized the axes from `axis` on
/// as one lane.
pub fn softmax_flattened<Axes>(t: &Tensor<f32, Axes>, axis: i32) -> Tensor<f32, Axes> {
    return softmax_lanes(t, axis, t.extents.len());
}

/// The softmax of each lane running across axes `from..<to`, which are adjacent
/// and so step through the data as one axis would. The lane's maximum is
/// subtracted first, so no exponential overflows.
fn softmax_lanes<Axes>(t: &Tensor<f32, Axes>, from: i32, to: i32) -> Tensor<f32, Axes> {
    let extent = element_count(&t.extents[from..<to].to_list());
    let inner = element_count(&t.extents[to..<t.extents.len()].to_list());
    let mut out = t.data;
    let lanes = if extent == 0 { 0 } else { t.data.len() / extent };
    for let lane of 0..<lanes {
        let base = lane / inner * extent * inner + lane % inner;
        let mut max = -f32::INFINITY;
        for let k of 0..<extent {
            max = f32::ieee754_max(max, t.data[base + k * inner]);
        }
        let mut sum: f32 = 0.0;
        for let k of 0..<extent {
            let e = f32::exp(t.data[base + k * inner] - max);
            out[base + k * inner] = e;
            sum += e;
        }
        for let k of 0..<extent {
            out[base + k * inner] /= sum;
        }
    }
    return Tensor { data: out, extents: t.extents };
}

/// The elements folded through `op` from `init` along each of `axes`, which
/// stay in the result at extent 1.
pub fn reduce<Axes>(t: &Tensor<f32, Axes>, axes: List<i32>, init: f32, op: fn(f32, f32) -> f32) -> Tensor<f32, Axes> {
    let rank = t.extents.len();
    let mut extents = t.extents;
    for let axis of axes {
        extents[axis] = 1;
    }
    let steps = stretched_carries(&extents, &t.extents);
    let mut out = List::<f32>::filled(element_count(&extents), init);
    let mut index = List::<i32>::filled(rank, 0);
    let mut at = 0;
    for let v of t.data {
        out[at] = op(out[at], v);
        let axis = advance(&mut index, &t.extents);
        if axis >= 0 {
            at += steps[axis];
        }
    }
    return Tensor { data: out, extents };
}

/// `reduce` to the mean of the elements along `axes`.
pub fn reduce_mean<Axes>(t: &Tensor<f32, Axes>, axes: List<i32>) -> Tensor<f32, Axes> {
    let mut count: f32 = 1.0;
    for let axis of axes {
        count *= t.extents[axis] as f32;
    }
    let sum = reduce(t, axes, 0.0, |x, y| x + y);
    return map(&sum, |v| v / count);
}

/// Each element through `op`.
pub fn map<A, B, Axes>(t: &Tensor<A, Axes>, op: fn(A) -> B) -> Tensor<B, Axes> {
    let mut out = List::<B>::with_capacity(t.data.len());
    for let v of t.data {
        out.push(op(v));
    }
    return Tensor { data: out, extents: t.extents };
}

/// `1 / (1 + e^-v)`, computed from the side whose exponential cannot overflow.
pub fn sigmoid_f32(v: f32) -> f32 {
    if v >= 0.0 {
        return 1.0 / (1.0 + f32::exp(-v));
    }
    let e = f32::exp(v);
    return e / (1.0 + e);
}

/// An element type a tensor is held in and no kernel computes in. Wado's half
/// precision carries bits and no arithmetic, so f32 is the only side with any.
pub trait Held with () {
    fn to_wide(&self) -> f32;
    fn from_wide(v: f32) -> Self;
}

impl Held for f16 {
    fn to_wide(&self) -> f32 {
        return f32::from(*self);
    }

    fn from_wide(v: f32) -> f16 {
        return f16::from_f32(v);
    }
}

impl Held for bf16 {
    fn to_wide(&self) -> f32 {
        return f32::from(*self);
    }

    fn from_wide(v: f32) -> bf16 {
        return bf16::from_f32(v);
    }
}

/// A held tensor in f32, where the kernels compute.
pub fn widen<E: Held, Axes>(t: &Tensor<E, Axes>) -> Tensor<f32, Axes> {
    return map(t, |v| v.to_wide());
}

/// An f32 tensor rounded to the type it is held in.
pub fn narrow<E: Held, Axes>(t: &Tensor<f32, Axes>) -> Tensor<E, Axes> {
    return map(t, |v| E::from_wide(v));
}

/// An element type a backend stores: one the kernels compute in. Each converts
/// to another as ONNX's `Cast` does: a bool is 1 or 0, and anything nonzero is
/// true.
pub trait Element with () {
    fn cast_to<T: Element>(&self) -> T;
    fn from_f32(v: f32) -> Self;
    fn from_i64(v: i64) -> Self;
    fn from_bool(v: bool) -> Self;
}

impl Element for f32 {
    fn cast_to<T: Element>(&self) -> T {
        return T::from_f32(*self);
    }

    fn from_f32(v: f32) -> f32 {
        return v;
    }

    fn from_i64(v: i64) -> f32 {
        return v as f32;
    }

    fn from_bool(v: bool) -> f32 {
        return if v { 1.0 } else { 0.0 };
    }
}

impl Element for i64 {
    fn cast_to<T: Element>(&self) -> T {
        return T::from_i64(*self);
    }

    fn from_f32(v: f32) -> i64 {
        return v as i64;
    }

    fn from_i64(v: i64) -> i64 {
        return v;
    }

    fn from_bool(v: bool) -> i64 {
        return if v { 1 } else { 0 };
    }
}

impl Element for bool {
    fn cast_to<T: Element>(&self) -> T {
        return T::from_bool(*self);
    }

    fn from_f32(v: f32) -> bool {
        return v != 0.0;
    }

    fn from_i64(v: i64) -> bool {
        return v != 0;
    }

    fn from_bool(v: bool) -> bool {
        return v;
    }
}

/// A one-operand operator of an [`Expr`].
pub enum UnaryOp {
    Relu,
    Sigmoid,
    Tanh,
    Erf,
    Exp,
    Log,
    Sqrt,
    Neg,
    Abs,
}

/// A two-operand operator of an [`Expr`].
pub enum BinaryOp {
    Add,
    Sub,
    Mul,
    Div,
    Pow,
}

/// One step of an [`Expr`], reading the steps before it by position.
pub variant Step {
    Operand(i32),
    Constant(f32),
    Unary([UnaryOp, i32]),
    Binary([BinaryOp, i32, i32]),
}

/// An elementwise operator as data: each output element over the operands'
/// elements at its position and the constants folded in. A backend reads it as
/// it can, the CPU one step at a time and a GPU one as a shader, which a
/// closure could never become.
pub struct Expr {
    /// Each reading the steps before it, the last the output.
    pub steps: List<Step>,
}

/// The kernel's operand `index`: 0 the first, 1 the second.
pub fn operand(index: i32) -> Expr {
    return Expr {
        steps: [Step::Operand(index)],
    };
}

/// A constant folded into the operator.
pub fn constant(value: f32) -> Expr {
    return Expr {
        steps: [Step::Constant(value)],
    };
}

impl Expr {
    /// `op` applied to this.
    pub fn unary(&self, op: UnaryOp) -> Expr {
        let mut steps = self.steps;
        steps.push(Step::Unary([op, self.steps.len() - 1]));
        return Expr { steps };
    }

    /// `op` applied to this and `rhs`.
    pub fn binary(&self, op: BinaryOp, rhs: &Expr) -> Expr {
        let mut steps = self.steps;
        let offset = steps.len();
        for let step of rhs.steps {
            steps.push(match step {
                Unary([o, a]) => Step::Unary([o, a + offset]),
                Binary([o, a, b]) => Step::Binary([o, a + offset, b + offset]),
                leaf => leaf,
            });
        }
        steps.push(Step::Binary([op, offset - 1, steps.len() - 1]));
        return Expr { steps };
    }

    /// The output's `count` elements over whole operands, `operand(i)` reading
    /// `operands[i]`. Each holds a run of elements the output repeats, so
    /// output element `j` reads its element `j % len`: all `count` of them,
    /// one, or the output's trailing axes.
    pub fn over(&self, count: i32, operands: &List<&List<f32>>) -> List<f32> {
        for let o of *operands {
            assert count == 0 || o.len() > 0 && count % o.len() == 0;
        }
        let mut out = List::<f32>::filled(count, 0.0);
        for let mut start = 0; start < count; start += CHUNK {
            self.pass(&mut out, start, i32::min(CHUNK, count - start), operands);
        }
        return out;
    }

    /// The `n` output elements from `start`, every step run over them before
    /// the next pass, written to `out` there.
    fn pass(&self, out: &mut List<f32>, start: i32, n: i32, operands: &List<&List<f32>>) {
        let mut runs: List<Run> = [];
        for let step of self.steps {
            runs.push(match step {
                Operand(k) => run_of(operands, k, start, n),
                Constant(c) => Run::Owned([c]),
                Unary([op, a]) => Run::Owned(unary_over(op, &runs[a].view(operands))),
                Binary([op, a, b]) => Run::Owned(binary_over(op, &runs[a].view(operands), &runs[b].view(operands))),
            });
        }
        let last = runs[runs.len() - 1].view(operands);
        for let j of 0..<n {
            out[start + j] = last.at(j);
        }
    }
}

/// One step's values over a pass: computed, or a stretch of an operand read in
/// place.
variant Run {
    Owned(List<f32>),
    /// `[operand, from, len]`: `len` elements of `operands[operand]` from `from`.
    Within([i32, i32, i32]),
}

impl Run {
    fn view(&self, operands: &List<&List<f32>>) -> RunView {
        return match self {
            Owned(v) => RunView { data: v, from: 0, len: v.len() },
            Within([k, from, len]) => RunView { data: operands[*k], from: *from, len: *len },
        };
    }
}

/// `len` elements of `data` from `from`, as a `Run` reads.
struct RunView {
    data: &List<f32>,
    from: i32,
    len: i32,
}

impl RunView {
    /// Element `j`, or the one element where the run holds one.
    fn at(&self, j: i32) -> f32 {
        return if self.len == 1 { self.data[self.from] } else { self.data[self.from + j] };
    }
}

/// The output elements an `Expr` computes per pass. A step's values never
/// outgrow it, so what one operator hands the next stays in cache rather than
/// becoming a tensor. Each step is still one loop whose operator is fixed
/// before it starts: read step by step per element, an `Expr` runs several
/// times slower.
global CHUNK: i32 = 1024;

/// The `n` output elements from `start` read from `operands[k]`, which the
/// output repeats: in place where they lie in one stretch, its one value where
/// it holds one, and gathered where the pass wraps around it.
fn run_of(operands: &List<&List<f32>>, k: i32, start: i32, n: i32) -> Run {
    let values = operands[k];
    let len = values.len();
    if len == 1 {
        return Run::Within([k, 0, 1]);
    }
    let at = start % len;
    if at + n <= len {
        return Run::Within([k, at, n]);
    }
    let mut out = List::<f32>::with_capacity(n);
    for let j of 0..<n {
        out.push(values[(start + j) % len]);
    }
    return Run::Owned(out);
}

fn unary_over(op: UnaryOp, v: &RunView) -> List<f32> {
    return match op {
        Relu => each(v, |e| f32::ieee754_max(e, 0.0)),
        Sigmoid => each(v, |e| sigmoid_f32(e)),
        Tanh => each(v, |e| f32::tanh(e)),
        Erf => each(v, |e| f32::erf(e)),
        Exp => each(v, |e| f32::exp(e)),
        Log => each(v, |e| f32::ln(e)),
        Sqrt => each(v, |e| f32::sqrt(e)),
        Neg => each(v, |e| -e),
        Abs => each(v, |e| f32::abs(e)),
    };
}

fn binary_over(op: BinaryOp, a: &RunView, b: &RunView) -> List<f32> {
    return match op {
        Add => pairwise(a, b, |x, y| x + y),
        Sub => pairwise(a, b, |x, y| x - y),
        Mul => pairwise(a, b, |x, y| x * y),
        Div => pairwise(a, b, |x, y| x / y),
        Pow => pairwise(a, b, |x, y| f32::pow(x, y)),
    };
}

fn each(v: &RunView, f: fn(f32) -> f32) -> List<f32> {
    let mut out = List::<f32>::with_capacity(v.len);
    for let i of v.from..<v.from + v.len {
        out.push(f(v.data[i]));
    }
    return out;
}

/// `f` over `a` and `b` element by element, a one-element side read at each.
fn pairwise(a: &RunView, b: &RunView, f: fn(f32, f32) -> f32) -> List<f32> {
    let count = i32::max(a.len, b.len);
    assert (a.len == count || a.len == 1) && (b.len == count || b.len == 1);
    let mut out = List::<f32>::with_capacity(count);
    if a.len == b.len {
        for let i of 0..<count {
            out.push(f(a.data[a.from + i], b.data[b.from + i]));
        }
    } else if a.len == 1 {
        let x = a.data[a.from];
        for let i of b.from..<b.from + count {
            out.push(f(x, b.data[i]));
        }
    } else {
        let y = b.data[b.from];
        for let i of a.from..<a.from + count {
            out.push(f(a.data[i], y));
        }
    }
    return out;
}

/// An operand of a fused elementwise kernel whose output has the axes `Axes`:
/// its elements, and its extents aligned with the output's from the end, where
/// an extent of 1 or a missing axis stretches.
pub struct Read<Axes> {
    pub data: &List<f32>,
    pub extents: List<i32>,
}

/// `op` over `operands`, stretched to the extents they broadcast to.
pub fn fused<Axes>(operands: &List<Read<Axes>>, op: &Expr) -> Tensor<f32, Axes> {
    assert !operands.is_empty();
    let mut extents: List<i32> = [];
    for let o of *operands {
        extents = broadcast_extents(&extents, &o.extents).unwrap();
    }
    return Tensor { data: op.over(element_count(&extents), &repeated_over(operands, &extents)), extents };
}

/// Each of `operands` as a run of elements an output of `extents` repeats:
/// itself where it repeats over them, and otherwise stretched to them.
fn repeated_over<Axes>(operands: &List<Read<Axes>>, extents: &List<i32>) -> List<&List<f32>> {
    let mut reads: List<&List<f32>> = [];
    for let o of *operands {
        if repeats_over(&o.extents, extents) {
            reads.push(o.data);
        } else {
            let stretched = stretched_to(o.data, &o.extents, extents);
            reads.push(&stretched);
        }
    }
    return reads;
}

/// The elementwise operators a contraction applies to each element it
/// computes, once the element is complete: `op` reads that element as
/// `operand(0)`, and `operands[i]` as `operand(i + 1)`.
pub struct Epilogue<O> {
    pub operands: List<O>,
    pub op: Expr,
}

/// An epilogue ready to apply to a contraction's output of `extents`.
struct Finish {
    op: Expr,
    /// Each operand after the contraction's own, as `repeated_over` reads it.
    reads: List<&List<f32>>,
}

fn finish<Axes>(then: &Option<Epilogue<Read<Axes>>>, extents: &List<i32>) -> Option<Finish> {
    let Some(e) = then else {
        return null;
    };
    return Option::Some(Finish { op: e.op, reads: repeated_over(&e.operands, extents) });
}

impl Finish {
    /// The epilogue over `out`'s `n` elements from `start`, which the
    /// contraction has just completed, written back in place.
    fn apply(&self, out: &mut List<f32>, start: i32, n: i32) {
        let mut operands: List<&List<f32>> = [out];
        operands.extend(&self.reads);
        for let mut at = start; at < start + n; at += CHUNK {
            self.op.pass(out, at, i32::min(CHUNK, start + n - at), &operands);
        }
    }
}

/// `data`, of `from`, repeated over `to` where `from` stretches.
fn stretched_to(data: &List<f32>, from: &List<i32>, to: &List<i32>) -> List<f32> {
    let count = element_count(to);
    let steps = stretched_carries(from, to);
    let mut out = List::<f32>::with_capacity(count);
    let mut index = List::<i32>::filled(to.len(), 0);
    let mut at = 0;
    for let _ of 0..<count {
        out.push(data[at]);
        let axis = advance(&mut index, to);
        if axis >= 0 {
            at += steps[axis];
        }
    }
    return out;
}

/// Where the kernels run. `forward` is instantiated at each backend, and the
/// backend owns how a tensor is held: as a `Tensor` on the CPU, as a buffer on
/// a GPU. Each kernel's signature is its function's, `Tensor` read as
/// `Self::Tensor`, so a generated call is checked through the trait as it is
/// against the function.
pub trait Backend with _ {
    type Tensor<E: Element, Axes>;
    /// An operand of an elementwise kernel whose output has the axes `Axes`.
    /// Each `read` checks a tensor against the output's axes, so `fused`
    /// takes its operands as one list.
    type Operand<Axes>;

    /// `t`, held on the host, as this backend holds it.
    fn upload<E: Element, Axes>(&mut self, t: &Tensor<E, Axes>) -> Self::Tensor<E, Axes>;
    /// `t` back on the host.
    fn download<E: Element, Axes>(&mut self, t: &Self::Tensor<E, Axes>) -> Tensor<E, Axes>;
    /// `t`, held in half precision on the host, as this backend computes with
    /// it. How it stores the result is its own: the type says only that the
    /// kernels read it as f32.
    fn prepare<E: Held, Axes>(&mut self, t: &Tensor<E, Axes>) -> Self::Tensor<f32, Axes> {
        return self.upload(&widen(t));
    }

    fn filled<E: Element, Axes>(&mut self, extents: List<i32>, value: E) -> Self::Tensor<E, Axes>;
    fn range_i64<A>(&mut self, start: i64, count: i32, delta: i64) -> Self::Tensor<i64, [A]>;

    /// `t` as an operand over its own axes.
    fn read<Axes>(&mut self, t: &Self::Tensor<f32, Axes>) -> Self::Operand<Axes>;
    /// `t` repeated across the leading axes `Pre`.
    fn read_suffix<..Pre, ..Suf>(&mut self, t: &Self::Tensor<f32, [..Suf]>) -> Self::Operand<[..Pre, ..Suf]>;
    /// `t` meeting the output at `Mid`, repeated across the `trailing` axes
    /// after it as well as those before, as arithmetic before opset 7 aligned.
    fn read_at<..Pre, ..Mid, ..Post>(
        &mut self,
        t: &Self::Tensor<f32, [..Mid]>,
        trailing: i32,
    ) -> Self::Operand<[..Pre, ..Mid, ..Post]>;
    /// `op` over `operands`, `operand(i)` reading the `i`th.
    fn fused<Axes>(&mut self, operands: List<Self::Operand<Axes>>, op: &Expr) -> Self::Tensor<f32, Axes>;

    fn cast<A: Element, B: Element, Axes>(&mut self, t: &Self::Tensor<A, Axes>) -> Self::Tensor<B, Axes>;
    fn select<E: Element, Axes>(
        &mut self,
        cond: &Self::Tensor<bool, Axes>,
        x: &Self::Tensor<E, Axes>,
        y: &Self::Tensor<E, Axes>,
    ) -> Self::Tensor<E, Axes>;

    // A contraction takes the elementwise operators after it as `then`, applied
    // to each element once it is complete.
    fn matmul<..Bs, M, K, N>(
        &mut self,
        a: &Self::Tensor<f32, [..Bs, M, K]>,
        b: &Self::Tensor<f32, [..Bs, K, N]>,
        then: Option<Epilogue<Self::Operand<[..Bs, M, N]>>>,
    ) -> Self::Tensor<f32, [..Bs, M, N]>;
    fn matmul_shared<..Bs, M, K, N>(
        &mut self,
        a: &Self::Tensor<f32, [..Bs, M, K]>,
        b: &Self::Tensor<f32, [K, N]>,
        then: Option<Epilogue<Self::Operand<[..Bs, M, N]>>>,
    ) -> Self::Tensor<f32, [..Bs, M, N]>;
    fn matmul_broadcast<A, B, Out>(
        &mut self,
        a: &Self::Tensor<f32, A>,
        b: &Self::Tensor<f32, B>,
        then: Option<Epilogue<Self::Operand<Out>>>,
    ) -> Self::Tensor<f32, Out>;

    fn gather_rows<E: Element, Row, ..Rest, ..Ix>(
        &mut self,
        data: &Self::Tensor<E, [Row, ..Rest]>,
        indices: &Self::Tensor<i64, [..Ix]>,
    ) -> Self::Tensor<E, [..Ix, ..Rest]>;
    fn gather<E: Element, ..Pre, Along, ..Post, ..Ix>(
        &mut self,
        data: &Self::Tensor<E, [..Pre, Along, ..Post]>,
        indices: &Self::Tensor<i64, [..Ix]>,
        axis: i32,
    ) -> Self::Tensor<E, [..Pre, ..Ix, ..Post]>;
    fn slice_axis<E: Element, ..Pre, In, Out, ..Post>(
        &mut self,
        t: &Self::Tensor<E, [..Pre, In, ..Post]>,
        axis: i32,
        start: i64,
        length: i32,
        step: i64,
    ) -> Self::Tensor<E, [..Pre, Out, ..Post]>;
    fn concat<E: Element, ..Pre, A, B, Out, ..Post>(
        &mut self,
        a: &Self::Tensor<E, [..Pre, A, ..Post]>,
        b: &Self::Tensor<E, [..Pre, B, ..Post]>,
        axis: i32,
    ) -> Self::Tensor<E, [..Pre, Out, ..Post]>;
    fn lift<E: Element, In, Out>(&mut self, t: &Self::Tensor<E, In>, rank: i32) -> Self::Tensor<E, Out>;
    fn reshape<E: Element, In, Out>(&mut self, t: &Self::Tensor<E, In>, extents: List<i32>) -> Self::Tensor<E, Out>;
    fn transpose2<E: Element, A, B>(&mut self, t: &Self::Tensor<E, [A, B]>) -> Self::Tensor<E, [B, A]>;
    fn permute<E: Element, In, Out>(&mut self, t: &Self::Tensor<E, In>, perm: List<i32>) -> Self::Tensor<E, Out>;

    fn max_pool<N, C, ..In, ..Out>(
        &mut self,
        x: &Self::Tensor<f32, [N, C, ..In]>,
        window: &Window,
    ) -> Self::Tensor<f32, [N, C, ..Out]>;
    fn conv<N, Ci, Co, ..In, ..K, ..Out>(
        &mut self,
        x: &Self::Tensor<f32, [N, Ci, ..In]>,
        w: &Self::Tensor<f32, [Co, Ci, ..K]>,
        window: &Window,
        then: Option<Epilogue<Self::Operand<[N, Co, ..Out]>>>,
    ) -> Self::Tensor<f32, [N, Co, ..Out]>;
    fn conv_bias<N, Ci, Co, ..In, ..K, ..Out>(
        &mut self,
        x: &Self::Tensor<f32, [N, Ci, ..In]>,
        w: &Self::Tensor<f32, [Co, Ci, ..K]>,
        b: &Self::Tensor<f32, [Co]>,
        window: &Window,
        then: Option<Epilogue<Self::Operand<[N, Co, ..Out]>>>,
    ) -> Self::Tensor<f32, [N, Co, ..Out]>;
    fn conv_grouped<N, Ci, Cg, Co, ..In, ..K, ..Out>(
        &mut self,
        x: &Self::Tensor<f32, [N, Ci, ..In]>,
        w: &Self::Tensor<f32, [Co, Cg, ..K]>,
        group: i32,
        window: &Window,
        then: Option<Epilogue<Self::Operand<[N, Co, ..Out]>>>,
    ) -> Self::Tensor<f32, [N, Co, ..Out]>;
    fn conv_grouped_bias<N, Ci, Cg, Co, ..In, ..K, ..Out>(
        &mut self,
        x: &Self::Tensor<f32, [N, Ci, ..In]>,
        w: &Self::Tensor<f32, [Co, Cg, ..K]>,
        b: &Self::Tensor<f32, [Co]>,
        group: i32,
        window: &Window,
        then: Option<Epilogue<Self::Operand<[N, Co, ..Out]>>>,
    ) -> Self::Tensor<f32, [N, Co, ..Out]>;

    fn softmax<Axes>(&mut self, t: &Self::Tensor<f32, Axes>, axis: i32) -> Self::Tensor<f32, Axes>;
    fn softmax_flattened<Axes>(&mut self, t: &Self::Tensor<f32, Axes>, axis: i32) -> Self::Tensor<f32, Axes>;
    fn reduce_sum<Axes>(&mut self, t: &Self::Tensor<f32, Axes>, axes: List<i32>) -> Self::Tensor<f32, Axes>;
    fn reduce_mean<Axes>(&mut self, t: &Self::Tensor<f32, Axes>, axes: List<i32>) -> Self::Tensor<f32, Axes>;
}

/// The kernels above, run where the module runs.
pub struct Cpu {
}

impl Backend for Cpu {
    type Tensor<E: Element, Axes> = Tensor<E, Axes>;
    type Operand<Axes> = Read<Axes>;

    fn upload<E: Element, Axes>(&mut self, t: &Tensor<E, Axes>) -> Tensor<E, Axes> {
        return *t;
    }

    fn download<E: Element, Axes>(&mut self, t: &Tensor<E, Axes>) -> Tensor<E, Axes> {
        return *t;
    }

    fn filled<E: Element, Axes>(&mut self, extents: List<i32>, value: E) -> Tensor<E, Axes> {
        return filled(extents, value);
    }

    fn range_i64<A>(&mut self, start: i64, count: i32, delta: i64) -> Tensor<i64, [A]> {
        return range_i64(start, count, delta);
    }

    fn read<Axes>(&mut self, t: &Tensor<f32, Axes>) -> Read<Axes> {
        return Read { data: &t.data, extents: t.extents };
    }

    fn read_suffix<..Pre, ..Suf>(&mut self, t: &Tensor<f32, [..Suf]>) -> Read<[..Pre, ..Suf]> {
        return Read { data: &t.data, extents: t.extents };
    }

    fn read_at<..Pre, ..Mid, ..Post>(&mut self, t: &Tensor<f32, [..Mid]>, trailing: i32) -> Read<[..Pre, ..Mid, ..Post]> {
        return Read { data: &t.data, extents: followed_by_units(&t.extents, trailing) };
    }

    fn fused<Axes>(&mut self, operands: List<Read<Axes>>, op: &Expr) -> Tensor<f32, Axes> {
        return fused(&operands, op);
    }

    fn cast<A: Element, B: Element, Axes>(&mut self, t: &Tensor<A, Axes>) -> Tensor<B, Axes> {
        return map(t, |v| v.cast_to::<B>());
    }

    fn select<E: Element, Axes>(
        &mut self,
        cond: &Tensor<bool, Axes>,
        x: &Tensor<E, Axes>,
        y: &Tensor<E, Axes>,
    ) -> Tensor<E, Axes> {
        return select(cond, x, y);
    }

    fn matmul<..Bs, M, K, N>(
        &mut self,
        a: &Tensor<f32, [..Bs, M, K]>,
        b: &Tensor<f32, [..Bs, K, N]>,
        then: Option<Epilogue<Read<[..Bs, M, N]>>>,
    ) -> Tensor<f32, [..Bs, M, N]> {
        return product(a, b, &then);
    }

    fn matmul_shared<..Bs, M, K, N>(
        &mut self,
        a: &Tensor<f32, [..Bs, M, K]>,
        b: &Tensor<f32, [K, N]>,
        then: Option<Epilogue<Read<[..Bs, M, N]>>>,
    ) -> Tensor<f32, [..Bs, M, N]> {
        return product(a, b, &then);
    }

    fn matmul_broadcast<A, B, Out>(
        &mut self,
        a: &Tensor<f32, A>,
        b: &Tensor<f32, B>,
        then: Option<Epilogue<Read<Out>>>,
    ) -> Tensor<f32, Out> {
        return product(a, b, &then);
    }

    fn gather_rows<E: Element, Row, ..Rest, ..Ix>(
        &mut self,
        data: &Tensor<E, [Row, ..Rest]>,
        indices: &Tensor<i64, [..Ix]>,
    ) -> Tensor<E, [..Ix, ..Rest]> {
        return gather_rows(data, indices);
    }

    fn gather<E: Element, ..Pre, Along, ..Post, ..Ix>(
        &mut self,
        data: &Tensor<E, [..Pre, Along, ..Post]>,
        indices: &Tensor<i64, [..Ix]>,
        axis: i32,
    ) -> Tensor<E, [..Pre, ..Ix, ..Post]> {
        return gather::<E, [..Pre], Along, [..Post], [..Ix]>(data, indices, axis);
    }

    fn slice_axis<E: Element, ..Pre, In, Out, ..Post>(
        &mut self,
        t: &Tensor<E, [..Pre, In, ..Post]>,
        axis: i32,
        start: i64,
        length: i32,
        step: i64,
    ) -> Tensor<E, [..Pre, Out, ..Post]> {
        return slice_axis::<E, [..Pre], In, Out, [..Post]>(t, axis, start, length, step);
    }

    fn concat<E: Element, ..Pre, A, B, Out, ..Post>(
        &mut self,
        a: &Tensor<E, [..Pre, A, ..Post]>,
        b: &Tensor<E, [..Pre, B, ..Post]>,
        axis: i32,
    ) -> Tensor<E, [..Pre, Out, ..Post]> {
        return concat::<E, [..Pre], A, B, Out, [..Post]>(a, b, axis);
    }

    fn lift<E: Element, In, Out>(&mut self, t: &Tensor<E, In>, rank: i32) -> Tensor<E, Out> {
        return lift(t, rank);
    }

    fn reshape<E: Element, In, Out>(&mut self, t: &Tensor<E, In>, extents: List<i32>) -> Tensor<E, Out> {
        return reshape(t, extents);
    }

    fn transpose2<E: Element, A, B>(&mut self, t: &Tensor<E, [A, B]>) -> Tensor<E, [B, A]> {
        return transpose2(t);
    }

    fn permute<E: Element, In, Out>(&mut self, t: &Tensor<E, In>, perm: List<i32>) -> Tensor<E, Out> {
        return permute(t, perm);
    }

    fn max_pool<N, C, ..In, ..Out>(
        &mut self,
        x: &Tensor<f32, [N, C, ..In]>,
        window: &Window,
    ) -> Tensor<f32, [N, C, ..Out]> {
        return max_pool::<N, C, [..In], [..Out]>(x, window);
    }

    fn conv<N, Ci, Co, ..In, ..K, ..Out>(
        &mut self,
        x: &Tensor<f32, [N, Ci, ..In]>,
        w: &Tensor<f32, [Co, Ci, ..K]>,
        window: &Window,
        then: Option<Epilogue<Read<[N, Co, ..Out]>>>,
    ) -> Tensor<f32, [N, Co, ..Out]> {
        return convolve(x, w, List::<f32>::filled(w.extents[0], 0.0), 1, window, &then);
    }

    fn conv_bias<N, Ci, Co, ..In, ..K, ..Out>(
        &mut self,
        x: &Tensor<f32, [N, Ci, ..In]>,
        w: &Tensor<f32, [Co, Ci, ..K]>,
        b: &Tensor<f32, [Co]>,
        window: &Window,
        then: Option<Epilogue<Read<[N, Co, ..Out]>>>,
    ) -> Tensor<f32, [N, Co, ..Out]> {
        return convolve(x, w, b.data, 1, window, &then);
    }

    fn conv_grouped<N, Ci, Cg, Co, ..In, ..K, ..Out>(
        &mut self,
        x: &Tensor<f32, [N, Ci, ..In]>,
        w: &Tensor<f32, [Co, Cg, ..K]>,
        group: i32,
        window: &Window,
        then: Option<Epilogue<Read<[N, Co, ..Out]>>>,
    ) -> Tensor<f32, [N, Co, ..Out]> {
        return convolve(x, w, List::<f32>::filled(w.extents[0], 0.0), group, window, &then);
    }

    fn conv_grouped_bias<N, Ci, Cg, Co, ..In, ..K, ..Out>(
        &mut self,
        x: &Tensor<f32, [N, Ci, ..In]>,
        w: &Tensor<f32, [Co, Cg, ..K]>,
        b: &Tensor<f32, [Co]>,
        group: i32,
        window: &Window,
        then: Option<Epilogue<Read<[N, Co, ..Out]>>>,
    ) -> Tensor<f32, [N, Co, ..Out]> {
        return convolve(x, w, b.data, group, window, &then);
    }

    fn softmax<Axes>(&mut self, t: &Tensor<f32, Axes>, axis: i32) -> Tensor<f32, Axes> {
        return softmax(t, axis);
    }

    fn softmax_flattened<Axes>(&mut self, t: &Tensor<f32, Axes>, axis: i32) -> Tensor<f32, Axes> {
        return softmax_flattened(t, axis);
    }

    fn reduce_sum<Axes>(&mut self, t: &Tensor<f32, Axes>, axes: List<i32>) -> Tensor<f32, Axes> {
        return reduce(t, axes, 0.0, |x, y| x + y);
    }

    fn reduce_mean<Axes>(&mut self, t: &Tensor<f32, Axes>, axes: List<i32>) -> Tensor<f32, Axes> {
        return reduce_mean(t, axes);
    }
}
