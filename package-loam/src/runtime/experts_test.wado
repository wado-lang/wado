//! The two forms a mixture of experts takes compute one result, and so do its
//! experts held in pools of every slot or fetched into fewer.

use { A, B, C, experts_case, mixing, stacked_runs } from "./graph_cases.wado";
use { Untyped, typed } from "./recorded.wado";
use { LoadError } from "./checkpoint.wado";
use { ExpertLayout, HeldExperts, StoredExperts } from "./held_experts.wado";
use { ElementKind } from "./tensor.wado";
use { HashMap } from "core:collections";
use { Cpu, Tensor } from "./tensor.wado";

test "a token whose other logits are -inf runs its one expert once, in either form" {
    let cpu = &mut Cpu {};
    let c = experts_case(2);
    let alone = [5.0, -f32::INFINITY, -f32::INFINITY, -f32::INFINITY] as List<f32>;
    let mut twice = alone;
    twice.extend(&alone);
    let mut rows = c.x;
    rows.data = c.x.data[0..<32].to_list();
    rows.data.extend(&rows.data);
    let by_experts = mixing(cpu, &rows, &Tensor::<f32, [A, C]> {
        data: twice,
        extents: [2, 4],
    }, &c.up, &c.down);
    let mut row = rows;
    row.data = rows.data[0..<32].to_list();
    row.extents = [1, 32];
    // One token's two picks are fewer than the four experts, so it runs each pick.
    let by_picks = mixing(cpu, &row, &Tensor::<f32, [A, C]> {
        data: alone,
        extents: [1, 4],
    }, &c.up, &c.down);
    assert by_picks.data == by_experts.data[0..<32].to_list();
}

/// The slots of each pool `HeldExperts::within` makes of a layout of 3 layers
/// and one of 2, each of 4 experts of 2 bytes, within `budget` bytes.
fn slots_within(budget: i64) -> Result<List<i32>, LoadError> {
    let layout = |layers: i32, weight: i32| ExpertLayout {
        weights: [weight],
        layers: (0..<layers)
            .map(|_| [
                StoredExperts {
                    file: "w",
                    start: 0,
                    kind: ElementKind::U8,
                    extents: [2],
                },
            ] as List<StoredExperts>)
            .collect(),
        steps: (0..<layers).collect(),
        experts: 4,
    };
    let mut held = HeldExperts::within([
        layout(3, 0),
        layout(2, 1),
    ], budget)?;
    let mut files = HashMap::<String, ByteList>::new();
    files["w"] = List::<u8>::filled(8, 0) as ByteList;
    let pools = held.pools(&mut Cpu {}, &files);
    return Result::Ok(pools.into_iter().map(|p| typed::<Cpu, u8, Untyped>(&Cpu {}, &p).extents[0]).collect());
}

test "a budget holds one layer's experts of each pool, then shares the rest by each pool's bytes" {
    assert slots_within(15) matches { Err(_) };
    assert slots_within(16).unwrap() == [4, 4] as List<i32>;
    assert slots_within(28).unwrap() == [8, 6] as List<i32>;
    assert slots_within(40).unwrap() == [12, 8] as List<i32>;
    assert slots_within(i64::MAX).unwrap() == [12, 8] as List<i32>;
}

test "experts fetched into pools of fewer slots compute what pools of every slot do" {
    // Each layer of 3 tokens runs every expert it picks, which 5 slots hold
    // only by giving way to the other layer's; 1 token runs its picks. A
    // budget of 8 experts holds both layers.
    let runs: List<i32> = [3, 1, 3];
    let resident = stacked_runs(&mut Cpu {}, 8, runs);
    let fetched = stacked_runs(&mut Cpu {}, 5, runs);
    for let [r, f] of resident.into_iter().zip(fetched.into_iter()) {
        let [want, got] = [
            typed::<Cpu, f32, [A, B]>(&Cpu {}, &r),
            typed::<Cpu, f32, [A, B]>(&Cpu {}, &f),
        ];
        for let [a, b] of want.data.into_iter().zip(got.data.into_iter()) {
            assert f32::abs(a - b) <= 1e-5 * f32::max(1.0, f32::abs(a));
        }
    }
}
