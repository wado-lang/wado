//! The two forms a mixture of experts takes compute one result, and so do its
//! experts held in pools of every slot or fetched into fewer.

use { A, B, C, STACKED_RUNS, STACKINGS, experts_case, mixing, stacked_runs } from "./graph_cases.wado";
use { typed } from "./recorded.wado";
use { LoadError } from "./checkpoint.wado";
use { Eviction, ExpertCounts, ExpertShape, Fetch, planned, replayed } from "./held_experts.wado";
use { Cpu, Holds, Tensor } from "./tensor.wado";

test "a token whose other logits are -inf runs its one expert once, in either form" {
    let cpu = &mut Cpu {};
    let c = experts_case(2);
    let alone = [5.0, -f32::INFINITY, -f32::INFINITY, -f32::INFINITY] as List<f32>;
    let mut twice = alone;
    twice.extend(&alone);
    let mut rows = c.x;
    rows.data = c.x.data[0..<32].to_list();
    rows.data.extend(&rows.data);
    let up = [
        cpu.upload(&c.up.0),
        cpu.upload(&c.up.1),
        cpu.upload(&c.up.2),
    ];
    let down = [
        cpu.upload(&c.down.0),
        cpu.upload(&c.down.1),
        cpu.upload(&c.down.2),
    ];
    let by_experts = mixing(cpu, &cpu.upload(&rows), &cpu.upload(&Tensor::<f32, [A, C]> {
        data: twice,
        extents: [2, 4],
    }), &up, &down);
    let mut row = rows;
    row.data = rows.data[0..<32].to_list();
    row.extents = [1, 32];
    // One token's two picks are fewer than the four experts, so it runs each pick.
    let by_picks = mixing(cpu, &cpu.upload(&row), &cpu.upload(&Tensor::<f32, [A, C]> {
        data: alone,
        extents: [1, 4],
    }), &up, &down);
    assert cpu.download(&by_picks).data == cpu.download(&by_experts).data[0..<32].to_list();
}

/// A layout of `layers` layers of 4 experts of 2 bytes, each pool holding at
/// most `most_slots`, its host steps numbered from `first_step`.
fn shape(layers: i32, first_step: i32, most_slots: i32 = i32::MAX) -> ExpertShape {
    return ExpertShape {
        layers,
        experts: 4,
        slot_bytes: 2,
        steps: (first_step..<first_step + layers).collect(),
        most_slots,
    };
}

/// Each run of each layout `planned` makes, as `[first, count, slots]`.
fn runs(shapes: List<ExpertShape>, budget: i64) -> Result<List<List<[i32, i32, i32]>>, LoadError> {
    return Result::Ok(
        planned(&shapes, budget)?
            .into_iter()
            .map(|plan| plan.into_iter().map(|r| [r.first, r.count, r.slots]).collect())
            .collect(),
    );
}

test "a budget holds one layer's experts and one more of each layout, then shares the rest by each layout's bytes" {
    let two_layouts = || [
        shape(3, 0),
        shape(2, 3),
    ] as List<ExpertShape>;
    assert runs(two_layouts(), 19) matches { Err(_) };
    assert runs(two_layouts(), 20).unwrap() == [
        [
            [0, 3, 5],
        ],
        [
            [0, 2, 5],
        ],
    ];
    assert runs(two_layouts(), 30).unwrap() == [
        [
            [0, 3, 8],
        ],
        [
            [0, 2, 6],
        ],
    ];
    let own: List<List<[i32, i32, i32]>> = [
        [
            [0, 1, 4],
            [1, 1, 4],
            [2, 1, 4],
        ],
        [
            [0, 1, 4],
            [1, 1, 4],
        ],
    ];
    assert runs(two_layouts(), 40).unwrap() == own;
    assert runs(two_layouts(), i64::MAX).unwrap() == own;
    // One layer shares with none, so it holds its own experts or nothing.
    assert runs([shape(1, 0)], 7) matches { Err(_) };
    assert runs([shape(1, 0)], 8).unwrap() == [
        [
            [0, 1, 4],
        ],
    ];
}

test "a layout's layers split into as few runs as keep each pool within what the backend holds" {
    assert runs([shape(4, 0, 7)], 24).unwrap() == [
        [
            [0, 2, 6],
            [2, 2, 6],
        ],
    ];
    assert runs([shape(4, 0, 3)], 24) matches { Err(_) };
    // Slots past what the runs the budget affords hold are left unspent.
    assert runs([shape(2, 0, 5)], 14).unwrap() == [
        [
            [0, 2, 5],
        ],
    ];
    assert runs([shape(2, 0, 4)], 14) matches { Err(_) };
    // A run of one layer holds its own experts.
    assert runs([shape(3, 0, 6)], 22).unwrap() == [
        [
            [0, 1, 4],
            [1, 2, 6],
        ],
    ];
}

/// Rounds of three layers within `budget` bytes, 5 slots at 10, each layer
/// picking experts 0 and 1 at every one-token step: the counts `eviction`
/// gives.
fn cycled(eviction: Eviction, budget: i64 = 10) -> ExpertCounts {
    let mut fetches: List<Fetch> = [];
    for let _ of 0..<10 {
        for let layer of 0..<3 {
            fetches.push(Fetch {
                step: layer,
                tokens: 1,
                experts: [0, 1],
            });
        }
    }
    let [prompts, steps] = replayed(&[shape(3, 0)], &fetches, budget, eviction).unwrap();
    assert prompts.picked == 0;
    assert steps.picked == 60;
    assert steps.loaded_bytes == 2 * (steps.picked - steps.held);
    return steps;
}

test "layers taken in turn hold more under the layer that runs last from here than under the slot used longest ago" {
    let recent = cycled(Eviction::Recent).held;
    let in_order = cycled(Eviction::LayerOrder).held;
    assert recent < in_order;
    assert in_order <= cycled(Eviction::Farthest).held;
}

test "a replay counts the picks of layers holding their own experts as held" {
    assert cycled(Eviction::Recent, i64::MAX).held == 60;
}

test "experts fetched into pools of fewer slots compute what pools of every slot do, in a loop or a branch too" {
    let mut cpu = Cpu {};
    for let stacking of STACKINGS {
        let resident = stacked_runs(&mut cpu, 8, stacking, STACKED_RUNS);
        let fetched = stacked_runs(&mut cpu, 5, stacking, STACKED_RUNS);
        for let [r, f] of resident.into_iter().zip(fetched.into_iter()) {
            let [want, got] = [
                cpu.download(&typed::<Cpu, f32, [A, B]>(&cpu, &r)),
                cpu.download(&typed::<Cpu, f32, [A, B]>(&cpu, &f)),
            ];
            for let [a, b] of want.data.into_iter().zip(got.data.into_iter()) {
                assert f32::abs(a - b) <= 1e-5 * f32::max(1.0, f32::abs(a));
            }
        }
    }
}
