//! The two forms a mixture of experts takes compute one result, and so do its
//! experts held in pools of every slot or fetched into fewer.

use { A, B, C, experts_case, mixing, stacked_runs } from "./graph_cases.wado";
use { typed } from "./recorded.wado";
use { Cpu, Tensor } from "./tensor.wado";

test "a token whose other logits are -inf runs its one expert once, in either form" {
    let cpu = &mut Cpu {};
    let c = experts_case(2);
    let alone = [5.0, -f32::INFINITY, -f32::INFINITY, -f32::INFINITY] as List<f32>;
    let mut twice = alone;
    twice.extend(&alone);
    let mut rows = c.x;
    rows.data = c.x.data[0..<32].to_list();
    rows.data.extend(&rows.data);
    let by_experts = mixing(cpu, &rows, &Tensor::<f32, [A, C]> {
        data: twice,
        extents: [2, 4],
    }, &c.up, &c.down);
    let mut row = rows;
    row.data = rows.data[0..<32].to_list();
    row.extents = [1, 32];
    // One token's two picks are fewer than the four experts, so it runs each pick.
    let by_picks = mixing(cpu, &row, &Tensor::<f32, [A, C]> {
        data: alone,
        extents: [1, 4],
    }, &c.up, &c.down);
    assert by_picks.data == by_experts.data[0..<32].to_list();
}

test "experts fetched into pools of fewer slots compute what pools of every slot do" {
    // Each layer of 3 tokens runs every expert it picks, which 5 slots hold
    // only by giving way to the other layer's; 1 token runs its picks.
    let runs: List<i32> = [3, 1, 3];
    let resident = stacked_runs(&mut Cpu {}, 8, runs);
    let fetched = stacked_runs(&mut Cpu {}, 5, runs);
    for let [r, f] of resident.into_iter().zip(fetched.into_iter()) {
        let [want, got] = [typed::<Cpu, f32, [A, B]>(&Cpu {}, &r), typed::<Cpu, f32, [A, B]>(&Cpu {}, &f)];
        for let [a, b] of want.data.into_iter().zip(got.data.into_iter()) {
            assert f32::abs(a - b) <= 1e-5 * f32::max(1.0, f32::abs(a));
        }
    }
}
