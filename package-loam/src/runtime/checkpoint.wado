use json from "core:json";
use { HashMap } from "core:collections";
use { LinearArray } from "core:linear";
use { Deserialize, DeserializeError, Deserializer, IgnoredAny, report_duplicate_field } from "core:serde";

/// The bytes a checkpoint is read from: in the GC heap, or in linear memory as
/// `fs::read_linear` reads a file, where no collection traces them.
pub affine trait CheckpointBytes with () {
    fn byte_len(&self) -> i32;
    /// The bytes from `start` to `end`, read as little-endian `U`s.
    fn decoded<U: FromLeBytes + AnyBits>(&self, start: i32, end: i32) -> List<U>;
}

impl CheckpointBytes for ByteSlice {
    fn byte_len(&self) -> i32 {
        return self.len();
    }

    fn decoded<U: FromLeBytes + AnyBits>(&self, start: i32, end: i32) -> List<U> {
        return List::<U>::from_le_bytes(self.slice(start, end));
    }
}

impl CheckpointBytes for ByteList {
    fn byte_len(&self) -> i32 {
        return self.len();
    }

    fn decoded<U: FromLeBytes + AnyBits>(&self, start: i32, end: i32) -> List<U> {
        return self.as_byte_slice().decoded::<U>(start, end);
    }
}

impl CheckpointBytes for LinearArray<u8> {
    fn byte_len(&self) -> i32 {
        return self.len();
    }

    fn decoded<U: FromLeBytes + AnyBits>(&self, start: i32, end: i32) -> List<U> {
        return self.to_list_of::<U>(start, end);
    }
}

/// A checkpoint that disagrees with the graph, or is not a safetensors file.
pub struct LoadError {
    pub reason: String,
}

impl Display for LoadError {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(&self.reason);
    }
}

impl Error for LoadError {
}

/// One tensor as the header states it: its element type, its extents, and its
/// byte range after the header.
pub struct HeaderEntry {
    pub dtype: String,
    pub shape: List<i64>,
    pub data_offsets: List<i64>,
}

/// The header key the format reserves for a map of free strings, which no tensor
/// can be stored under.
pub global METADATA_KEY: String = "__metadata__";

/// The header's tensor entries, `METADATA_KEY` skipped.
struct Header {
    entries: HashMap<String, HeaderEntry>,
}

impl Deserialize for Header {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<Header, DeserializeError> {
        let on_duplicate = d.on_duplicate_field();
        let mut map = d.begin_map()?;
        let mut entries = HashMap::<String, HeaderEntry>::new();
        while let Some(key) = map.next_key::<String>()? {
            if key == METADATA_KEY {
                let _ = map.next_value::<IgnoredAny>()?;
                continue;
            }
            let entry = map.next_value::<HeaderEntry>()?;
            if !entries.try_insert(key, entry) {
                report_duplicate_field(on_duplicate, &key)?;
                entries[key] = entry;
            }
        }
        map.end()?;
        return Result::Ok(Header { entries });
    }
}

/// A checkpoint's header, read, and where its payloads start.
pub struct Checkpoint {
    entries: HashMap<String, HeaderEntry>,
    data_start: i32,
}

/// Where the header ends, which the bytes must reach.
pub fn header_end<affine B: CheckpointBytes>(bytes: &B) -> Result<i32, LoadError> {
    let len = bytes.byte_len();
    if len < 8 {
        return Result::Err(LoadError { reason: `the header is 8 bytes, past the ${len} given` });
    }
    let end = declared_header_end(bytes.decoded::<u8>(0, 8) as ByteList)?;
    if end > len {
        return Result::Err(LoadError { reason: `the header is ${end - 8} bytes, past the ${len - 8} given` });
    }
    return Result::Ok(end);
}

/// Where the header the leading 8 bytes declare ends, whether or not the bytes
/// reach it.
pub fn declared_header_end<B: AsByteSlice>(bytes: B) -> Result<i32, LoadError> {
    let view = bytes.as_byte_slice();
    assert view.len() >= 8;
    let length = List::<u64>::from_le_bytes(view.slice(0, 8))[0];
    if length > (i32::MAX - 8) as u64 {
        return Result::Err(LoadError { reason: `the header is ${length} bytes, past what a module can address` });
    }
    return Result::Ok(8 + length as i32);
}

/// The header of the checkpoint `bytes` begins with; the payloads may be absent.
pub fn read_checkpoint<affine B: CheckpointBytes>(bytes: &B) -> Result<Checkpoint, LoadError> {
    let data_start = header_end(bytes)?;
    let header = match json::from_bytes::<Header>(bytes.decoded::<u8>(8, data_start) as ByteList) {
        Ok(header) => header,
        Err(e) => {
            return Result::Err(LoadError { reason: `the header is not JSON: ${e}` });
        },
    };
    return Result::Ok(Checkpoint { entries: header.entries, data_start });
}

/// What the build compiled a checkpoint tensor as, which its header must state.
/// `elements` is the extents' product, which the build has shown a list holds.
pub struct Expected {
    pub tensor: String,
    pub dtype: String,
    pub axes: List<String>,
    pub extents: List<i32>,
    pub elements: i32,
    pub width: i32,
}

impl Checkpoint {
    /// The byte range holding `e`, once the header states it as the build compiled it.
    pub fn range(&self, e: &Expected) -> Result<[i32, i32], LoadError> {
        let fail = |reason: String| LoadError { reason: `${e.tensor}: ${reason}` };
        let Some(entry) = self.entries.get(e.tensor) else {
            return Result::Err(fail("the checkpoint has no such tensor"));
        };
        if entry.dtype != e.dtype {
            return Result::Err(fail(`the checkpoint holds ${entry.dtype}, and the graph ${e.dtype}`));
        }
        if entry.shape.len() != e.axes.len() {
            return Result::Err(fail(
                `the checkpoint gives ${entry.shape.len()} axes, and the graph [${e.axes.join(", ")}]`,
            ));
        }
        for let [i, axis] of e.axes.into_iter().enumerate() {
            if entry.shape[i] != e.extents[i] as i64 {
                return Result::Err(fail(
                    `axis ${axis} is ${entry.shape[i]} in the checkpoint and ${e.extents[i]} in the graph`,
                ));
            }
        }
        let offsets = &entry.data_offsets;
        let held = if offsets.len() == 2 { offsets[1] - offsets[0] } else { -1 };
        let needed = e.elements as i64 * e.width as i64;
        if held != needed {
            return Result::Err(
                fail(
                    `the checkpoint's offsets hold ${held} bytes, and ${e.elements} ${e.dtype} elements need ${needed}`,
                ),
            );
        }
        if offsets[0] < 0 || offsets[1] > (i32::MAX - self.data_start) as i64 {
            return Result::Err(fail(`the checkpoint's offsets ${*offsets} fall outside what a module can address`));
        }
        return Result::Ok([self.data_start + offsets[0] as i32, self.data_start + offsets[1] as i32]);
    }

    /// `e`'s elements within `bytes`, the whole checkpoint this header was
    /// read from. `U` is what `e.dtype` names, `e.width` bytes wide.
    pub fn payload<U: FromLeBytes + AnyBits, affine B: CheckpointBytes>(
        &self,
        bytes: &B,
        e: &Expected,
    ) -> Result<List<U>, LoadError> {
        assert e.width == builtin::size_of::<U>();
        let [start, end] = self.range(e)?;
        return payload_at::<U, B>(bytes, e.tensor, start, end);
    }
}

/// Whether `bytes` are as long as the file the build found the weights in.
pub fn expect_len<affine B: CheckpointBytes>(bytes: &B, len: i32) -> Result<(), LoadError> {
    if bytes.byte_len() != len {
        return Result::Err(
            LoadError { reason: `the file is ${bytes.byte_len()} bytes, and the build found the weights in one of ${len}` },
        );
    }
    return Result::Ok(());
}

/// `tensor`'s elements at bytes `start` to `end` of `bytes`, where the build
/// found them.
pub fn payload_at<U: FromLeBytes + AnyBits, affine B: CheckpointBytes>(
    bytes: &B,
    tensor: String,
    start: i32,
    end: i32,
) -> Result<List<U>, LoadError> {
    if end > bytes.byte_len() {
        return Result::Err(
            LoadError { reason: `${tensor}: the payload ends at byte ${end}, past the ${bytes.byte_len()} given` },
        );
    }
    return Result::Ok(bytes.decoded::<U>(start, end));
}

/// A checkpoint published in shards, each shard's header read, keyed by the
/// file name the index gives the shard.
pub struct Shards {
    headers: HashMap<String, Checkpoint>,
}

/// The header of each shard in `shards`, keyed as `shards` is. A shard's
/// payloads may be absent.
pub fn read_shards(shards: &HashMap<String, ByteList>) -> Result<Shards, LoadError> {
    let mut headers = HashMap::<String, Checkpoint>::new();
    for let [name, bytes] of shards.entries() {
        let header = read_checkpoint(bytes).map_err(|e| LoadError { reason: `${name}: ${e}` })?;
        headers[*name] = header;
    }
    return Result::Ok(Shards { headers });
}

impl Shards {
    /// `e`'s elements within the shard named `shard`, of `shards`, which these
    /// headers were read from.
    pub fn payload<U: FromLeBytes + AnyBits>(
        &self,
        shards: &HashMap<String, ByteList>,
        shard: String,
        e: &Expected,
    ) -> Result<List<U>, LoadError> {
        if let Some(header) = self.headers.get_ref_str(&shard) && let Some(bytes) = shards.get_ref_str(&shard) {
            return header.payload::<U, ByteList>(bytes, e).map_err(|err| LoadError { reason: `${shard}: ${err}` });
        }
        return Result::Err(shard_not_given(&e.tensor, &shard));
    }
}

/// Why a tensor cannot be read: the shard the index places it in is absent.
pub fn shard_not_given(tensor: &String, shard: &String) -> LoadError {
    return LoadError { reason: `${*tensor}: the index places it in ${*shard}, which is not given` };
}
