use json from "core:json";
use { HashMap } from "core:collections";
use fs from "core:fs";
use { FsError, Preopens } from "core:fs";
use { LinearArray } from "core:linear";
use { Deserialize, DeserializeError, Deserializer, IgnoredAny, report_duplicate_field } from "core:serde";
use { Element } from "./tensor.wado";
use { HostWeight, stored_width } from "./weight.wado";

/// Where `Params::load` reads the weights: a range of one of the files the
/// model names, a tensor at a time, so no file need fit the guest whole. An
/// error names the file it failed on.
pub affine trait WeightSource with _ {
    /// The bytes `start` to `end` of `file`.
    fn read(&self, file: &String, start: i32, end: i32) -> Result<LinearArray<u8>, LoadError>
        contract 0 <= start <= end;
    /// How many bytes `file` holds.
    fn len(&self, file: &String) -> Result<i64, LoadError>;
}

/// The files of a directory, each read a range at a time.
pub struct FileSource {
    pub dir: String,
}

impl WeightSource for FileSource {
    fn read(&self, file: &String, start: i32, end: i32) -> Result<LinearArray<u8>, LoadError> with Preopens {
        return fs::read_linear_range(fs::join(&self.dir, file), start as u64, end - start).map_err(failed);
    }

    fn len(&self, file: &String) -> Result<i64, LoadError> with Preopens {
        return fs::metadata(fs::join(&self.dir, file)).map(|meta| meta.size as i64).map_err(failed);
    }
}

/// An `FsError` names the path it failed on, as a source's error must.
fn failed(e: FsError) -> LoadError {
    return LoadError { reason: `${e}` };
}

/// Files the guest holds whole, by the name the model gives each.
impl WeightSource for HashMap<String, ByteList> {
    fn read(&self, file: &String, start: i32, end: i32) -> Result<LinearArray<u8>, LoadError> {
        let bytes = given(self, file)?;
        if end > bytes.len() {
            return Result::Err(
                LoadError { reason: `${*file}: bytes ${start} to ${end} asked for, past the ${bytes.len()} it holds` },
            );
        }
        return Result::Ok(LinearArray::<u8>::of_bytes(bytes, start, end - start));
    }

    fn len(&self, file: &String) -> Result<i64, LoadError> {
        return Result::Ok(given(self, file)?.len() as i64);
    }
}

fn given(files: &HashMap<String, ByteList>, file: &String) -> Result<&ByteList, LoadError> {
    return files.get_ref_str(file).ok_or(LoadError { reason: `${*file}: not given` });
}

/// Why the weights do not load: a file the source cannot read, or a checkpoint
/// that disagrees with the graph or is not a safetensors file.
pub struct LoadError {
    pub reason: String,
}

impl Display for LoadError {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(&self.reason);
    }
}

impl Error for LoadError {
}

/// One tensor as the header states it: its element type, its extents, and its
/// byte range after the header.
pub struct HeaderEntry {
    pub dtype: String,
    pub shape: List<i64>,
    pub data_offsets: List<i64>,
}

/// The header key the format reserves for a map of free strings, which no tensor
/// can be stored under.
pub global METADATA_KEY: String = "__metadata__";

/// The header's tensor entries, `METADATA_KEY` skipped.
struct Header {
    entries: HashMap<String, HeaderEntry>,
}

impl Deserialize for Header {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<Header, DeserializeError> {
        let on_duplicate = d.on_duplicate_field();
        let mut map = d.begin_map()?;
        let mut entries = HashMap::<String, HeaderEntry>::new();
        while let Some(key) = map.next_key::<String>()? {
            if key == METADATA_KEY {
                let _ = map.next_value::<IgnoredAny>()?;
                continue;
            }
            let entry = map.next_value::<HeaderEntry>()?;
            if !entries.try_insert(key, entry) {
                report_duplicate_field(on_duplicate, &key)?;
                entries[key] = entry;
            }
        }
        map.end()?;
        return Result::Ok(Header { entries });
    }
}

/// A checkpoint's header, read, and where its payloads start.
pub struct Checkpoint {
    entries: HashMap<String, HeaderEntry>,
    data_start: i32,
    /// The bytes of the file the header was read from.
    len: i64,
}


/// Where the header the leading 8 bytes declare ends, whether or not the bytes
/// reach it.
pub fn declared_header_end<B: AsByteSlice>(bytes: B) -> Result<i32, LoadError> {
    let view = bytes.as_byte_slice();
    assert view.len() >= 8;
    let length = List::<u64>::from_le_bytes(view.slice(0, 8))[0];
    if length > (i32::MAX - 8) as u64 {
        return Result::Err(LoadError { reason: `the header is ${length} bytes, past what a module can address` });
    }
    return Result::Ok(8 + length as i32);
}

/// The header of the checkpoint `file` of `source` begins with; the payloads
/// may be absent. `refuse` words a fault of the file itself, which a source's
/// own error has already named.
fn read_checkpoint<affine Src: WeightSource>(
    source: &Src,
    file: &String,
    refuse: fn(String) -> LoadError,
) -> Result<Checkpoint, LoadError> with _ {
    let len = source.len(file)?;
    if len < 8 {
        return Result::Err(refuse(`the header is 8 bytes, past the ${len} given`));
    }
    let data_start = declared_header_end(source.read(file, 0, 8)?.to_list() as ByteList).map_err(
        |e: LoadError| refuse(e.reason),
    )?;
    if data_start as i64 > len {
        return Result::Err(refuse(`the header is ${data_start - 8} bytes, past the ${len - 8} given`));
    }
    let header = match json::from_bytes::<Header>(source.read(file, 8, data_start)?.to_list() as ByteList) {
        Ok(header) => header,
        Err(e) => {
            return Result::Err(refuse(`the header is not JSON: ${e}`));
        },
    };
    return Result::Ok(Checkpoint { entries: header.entries, data_start, len });
}

/// The header `bytes` begins with, read as `read_headers` reads a file's: what
/// a build reads of a checkpoint.
pub fn header_of(bytes: ByteList) -> Result<Checkpoint, LoadError> {
    let mut held = HashMap::<String, ByteList>::new();
    held[""] = bytes;
    return read_checkpoint(&held, &"", |reason| LoadError { reason });
}

/// What the build compiled a checkpoint tensor as, which its header must state.
/// `elements` is the extents' product, which the build has shown a list holds.
pub struct Expected {
    pub tensor: String,
    pub dtype: String,
    pub axes: List<String>,
    pub extents: List<i32>,
    pub elements: i32,
    pub width: i32,
}

impl Checkpoint {
    /// The byte past the last the header places a tensor in. An entry whose
    /// offsets are no range is `range`'s to refuse.
    fn data_end(&self) -> i64 {
        let mut end = self.data_start as i64;
        for let [_, entry] of self.entries.entries() {
            if entry.data_offsets.len() == 2 {
                end = i64::max(end, self.data_start as i64 + entry.data_offsets[1]);
            }
        }
        return end;
    }

    /// The byte range holding `e`, once the header states it as the build compiled it.
    pub fn range(&self, e: &Expected) -> Result<[i32, i32], LoadError> {
        let fail = |reason: String| LoadError { reason: `${e.tensor}: ${reason}` };
        let Some(entry) = self.entries.get(e.tensor) else {
            return Result::Err(fail("the checkpoint has no such tensor"));
        };
        if entry.dtype != e.dtype {
            return Result::Err(fail(`the checkpoint holds ${entry.dtype}, and the graph ${e.dtype}`));
        }
        if entry.shape.len() != e.axes.len() {
            return Result::Err(fail(
                `the checkpoint gives ${entry.shape.len()} axes, and the graph [${e.axes.join(", ")}]`,
            ));
        }
        for let [i, axis] of e.axes.into_iter().enumerate() {
            if entry.shape[i] != e.extents[i] as i64 {
                return Result::Err(fail(
                    `axis ${axis} is ${entry.shape[i]} in the checkpoint and ${e.extents[i]} in the graph`,
                ));
            }
        }
        let offsets = &entry.data_offsets;
        let held = if offsets.len() == 2 { offsets[1] - offsets[0] } else { -1 };
        let needed = e.elements as i64 * e.width as i64;
        if held != needed {
            return Result::Err(
                fail(
                    `the checkpoint's offsets hold ${held} bytes, and ${e.elements} ${e.dtype} elements need ${needed}`,
                ),
            );
        }
        if offsets[0] < 0 || offsets[1] > (i32::MAX - self.data_start) as i64 {
            return Result::Err(fail(`the checkpoint's offsets ${*offsets} fall outside what a module can address`));
        }
        return Result::Ok([self.data_start + offsets[0] as i32, self.data_start + offsets[1] as i32]);
    }
}

/// Whether `file` of `source` is as long as the file the build found the
/// weights in.
pub fn expect_len<affine Src: WeightSource>(source: &Src, file: String, len: i32) -> Result<(), LoadError> with _ {
    let held = source.len(&file)?;
    if held != len as i64 {
        return Result::Err(
            LoadError { reason: `${file} is ${held} bytes, and the build found the weights in one of ${len}` },
        );
    }
    return Result::Ok(());
}

/// Whether `file` of `source`, which the build did not read, is at least `end`
/// bytes long, holding every weight the graph places in it.
pub fn expect_holds<affine Src: WeightSource>(source: &Src, file: String, end: i32) -> Result<(), LoadError> with _ {
    let held = source.len(&file)?;
    if held < end as i64 {
        return Result::Err(LoadError { reason: `${file} is ${held} bytes, and the graph places weights up to ${end}` });
    }
    return Result::Ok(());
}

/// `tensor`, the `U`s of `extents` at bytes `start` to `end` of `file`, where
/// the build found them.
pub fn payload_at<U: Element, affine Src: WeightSource>(
    source: &Src,
    file: String,
    tensor: String,
    extents: List<i32>,
    start: i32,
    end: i32,
) -> Result<HostWeight, LoadError> with _
    contract 0 <= start <= end
{
    let bytes = source.read(&file, start, end).map_err(|e| LoadError { reason: `${tensor}: ${e}` })?;
    return Result::Ok(HostWeight::stored(U::kind(), extents, bytes));
}

/// A safetensors checkpoint in one file or in shards, each file's header read,
/// keyed by its name.
pub struct Headers {
    headers: HashMap<String, Checkpoint>,
}

/// The header of each of `files` in `source`, each file checked to hold every
/// byte its header places a tensor in, so a short file stops the load before
/// any weight is read.
pub fn read_headers<affine Src: WeightSource>(source: &Src, files: List<String>) -> Result<Headers, LoadError> with _ {
    let mut headers = HashMap::<String, Checkpoint>::new();
    for let file of files {
        let refuse = |reason: String| LoadError { reason: `${file}: ${reason}` };
        let checkpoint = read_checkpoint(source, &file, refuse)?;
        let end = checkpoint.data_end();
        if end > checkpoint.len {
            return Result::Err(refuse(`the header places tensors up to byte ${end}, past the ${checkpoint.len} given`));
        }
        headers[file] = checkpoint;
    }
    return Result::Ok(Headers { headers });
}

impl Headers {
    /// `e` within `file` of `source`, which these headers were read from. `U`
    /// is what `e.dtype` names, `e.width` bytes wide.
    pub fn payload<U: Element, affine Src: WeightSource>(
        &self,
        source: &Src,
        file: String,
        e: &Expected,
    ) -> Result<HostWeight, LoadError> with _
        contract e.width == stored_width(U::kind())
    {
        let [start, end] = self.range(file, e)?;
        return payload_at::<U, Src>(source, file, e.tensor, e.extents, start, end);
    }

    /// The bytes of `file` holding `e`, once its header states it as the
    /// build compiled it.
    pub fn range(&self, file: String, e: &Expected) -> Result<[i32, i32], LoadError>
        contract self.headers.contains_key(file), "`file` must be one `read_headers` read"
    {
        return self.headers[file].range(e).map_err(|err| LoadError { reason: `${file}: ${err}` });
    }
}
