//! An expert computed on the host from every expert's weights as a checkpoint
//! stores them, where a device's pools lack it: the SwiGLU between two
//! block-quantized products that `experts.wado`'s decomposition computes. Its
//! values are 4 bits in blocks of 32, so one guest core runs each product in
//! 128-bit SIMD, its activations quantized to 15 bits per block. That parts
//! from the decomposition's f32 by at most half a step of 1/16383 of each
//! block's largest activation; 8 bits part from it by 0.9% on `experts_case`,
//! past what a device's product is held to.
//!
//! An activation `v` is split as `128 · high + low`, `high` an i8 and `low` in
//! 0..<128, so that each half multiplies the 4-bit values in
//! `relaxed_dot_i8x16_i7x16_add_s`, whose second operand within 0..<128 makes it
//! exact on every host. The zero point comes off a block's sum as
//! `zero · Σ v`.

use { LinearArray, LinearArray64 } from "core:linear";
use { f32x4, i16x8, i32x4, i8x16, u8x16 } from "core:simd";
use { Experts, ProjectionShape } from "./experts.wado";
use { Quantized } from "./hlo.wado";
use { HostWeight } from "./weight.wado";

/// The values a block holds, and the bytes of one block of 4-bit values.
global BLOCK: i32 = 32;
global BLOB: i32 = 16;

/// Whether the host computes a product quantized as `quantized`.
pub fn computes_on_host(quantized: &Quantized) -> bool {
    return quantized.bits == 4 && quantized.block == BLOCK;
}

/// `experts` as the host reads them: bytes as they are stored, and floats
/// widened to f32, so a product reads each scale without converting it.
pub fn host_bytes(experts: &HostWeight) -> LinearArray64<u8> {
    let bytes = experts.bytes();
    if experts.kind matches { _::U8 } {
        let mut held = LinearArray64::<u8>::filled(bytes.len() as i64, 0);
        held.copy_from(0, bytes, 0, bytes.len());
        return held;
    }
    assert experts.kind matches { _::F16 | _::BF16 | _::F32 }, "a scale or a bias is a float";
    let count = experts.count();
    let mut held = LinearArray64::<u8>::filled(4 * count as i64, 0);
    for let i of 0..<count {
        held.store_at::<f32>(4 * i as i64, experts.value(i));
    }
    return held;
}

/// One projection of every expert of a layer, as [`host_bytes`] holds each
/// of its weights, and one expert's shape.
pub struct HostProjection {
    pub packed: &LinearArray64<u8>,
    pub scales: &LinearArray64<u8>,
    pub bias: Option<&LinearArray64<u8>>,
    pub zero_points: Option<&LinearArray64<u8>>,
    pub shape: ProjectionShape,
}

/// Expert `expert`'s output for the row `x`, of the hidden width: `up`'s
/// product, the SwiGLU of each gate and up pair, then `down`'s product.
pub fn expert_row(
    up: &HostProjection,
    down: &HostProjection,
    expert: i32,
    x: &List<f32>,
    experts: &Experts,
) -> List<f32>
    contract computes_on_host(&experts.quantized)
{
    let h = product(up, expert, &QuantizedRow::of(x));
    let inner = up.shape.rows / 2;
    let mut gated = List::<f32>::filled(inner, 0.0);
    for let i of 0..<inner {
        let gate = f32::min(h[2 * i], experts.limit);
        let value = f32::clamp(h[2 * i + 1], -experts.limit, experts.limit);
        let sigmoid = 1.0 / (1.0 + f32::exp(-gate * experts.alpha));
        gated[i] = gate * sigmoid * (value + experts.beta);
    }
    return product(down, expert, &QuantizedRow::of(&gated));
}

/// The largest magnitude an activation is quantized to.
global LARGEST: f32 = 16383.0;

/// A row of activations quantized to 15 bits per block: each block's values
/// `v` stand for `v · scale`. A block's 64 bytes hold the values' `high` at
/// its even places, then at its odd ones, then their `low` likewise, as a
/// weight's byte holds an even place in its low bits and the next in its high
/// bits. `sums` holds each block's values summed in its first lane.
affine struct QuantizedRow {
    values: LinearArray<u8>,
    scales: List<f32>,
    sums: LinearArray<u8>,
}

impl QuantizedRow {
    fn of(x: &List<f32>) -> QuantizedRow
        contract x.len() % BLOCK == 0, "a row spans whole blocks"
    {
        let blocks = x.len() / BLOCK;
        let mut values = LinearArray::<u8>::filled(2 * x.len(), 0);
        let mut scales = List::<f32>::filled(blocks, 0.0);
        let mut sums = LinearArray::<u8>::filled(16 * blocks, 0);
        for let b of 0..<blocks {
            let first = b * BLOCK;
            let mut largest: f32 = 0.0;
            for let i of first..<first + BLOCK {
                largest = f32::max(largest, f32::abs(x[i]));
            }
            if largest == 0.0 {
                continue;
            }
            let scale = largest / LARGEST;
            scales[b] = scale;
            let mut sum = 0;
            for let i of 0..<BLOCK {
                let v = f32::round(x[first + i] / scale) as i32;
                let place = 2 * first + if i % 2 == 0 { i / 2 } else { BLOB + i / 2 };
                values[place] = (v >> 7) as u8;
                values[place + BLOCK] = (v & 127) as u8;
                sum += v;
            }
            sums.store_at::<i32>(16 * b, sum);
        }
        return QuantizedRow { values, scales, sums };
    }
}

/// Each row of expert `expert`'s weight in `p` times `x`, plus its bias.
fn product(p: &HostProjection, expert: i32, x: &QuantizedRow) -> List<f32> {
    let shape = &p.shape;
    assert shape.blob == BLOB && shape.blocks == x.scales.len(), "the row spans the weight's blocks";
    assert shape.rows % ROWS_AT_ONCE == 0, "a projection's rows come in fours";
    let zero_points = p.zero_points matches { Some(_) };
    let blocks = shape.blocks as i64;
    let mut out = List::<f32>::filled(shape.rows, 0.0);
    for let mut r = 0; r < shape.rows; r += ROWS_AT_ONCE {
        let row = expert as i64 * shape.rows as i64 + r as i64;
        let [mut s0, mut s1, mut s2, mut s3] = [f32x4::splat(0.0), f32x4::splat(0.0), f32x4::splat(0.0), f32x4::splat(0.0)];
        for let b of 0..<shape.blocks {
            let at = 2 * BLOCK * b;
            let [high_evens, high_odds, low_evens, low_odds] = [
                x.at(at),
                x.at(at + BLOB),
                x.at(at + BLOCK),
                x.at(at + BLOCK + BLOB),
            ];
            let sums = unchecked x.sums.load_at::<v128>(16 * b) as i32x4;
            let x_scale = unchecked x.scales[b];
            let block = row * blocks + b as i64;
            let scaled = |n: i64| -> f32x4 {
                let zero = if zero_points { zero_point(p, row + n, b) } else { 8 };
                return block_sum(p, block + n * blocks, high_evens, high_odds, low_evens, low_odds, sums * i32x4::splat(zero), x_scale);
            };
            s0 = s0 + scaled(0);
            s1 = s1 + scaled(1);
            s2 = s2 + scaled(2);
            s3 = s3 + scaled(3);
        }
        for let [n, s] of ([s0, s1, s2, s3] as List<f32x4>).into_iter().enumerate() {
            let mut value = s.extract_lane(0) + s.extract_lane(1) + s.extract_lane(2) + s.extract_lane(3);
            if let Some(bias) = p.bias {
                value += bias.load_at::<f32>(4 * (row + n as i64));
            }
            out[r + n] = value;
        }
    }
    return out;
}

/// The rows a product runs together, sharing the reads of the activations.
global ROWS_AT_ONCE: i32 = 4;

/// Block `block` of `p`'s weight times the block of activations whose 15-bit
/// values' halves `high_*` and `low_*` hold, `offset` taken off for the zero
/// point, scaled by the weight's scale and `x_scale`: lanes that sum to it.
fn block_sum(
    p: &HostProjection,
    block: i64,
    high_evens: i8x16,
    high_odds: i8x16,
    low_evens: i8x16,
    low_odds: i8x16,
    offset: i32x4,
    x_scale: f32,
) -> f32x4 {
    let packed = unchecked p.packed.load_at::<v128>(BLOB as i64 * block) as u8x16;
    let evens = (packed & u8x16::splat(15)) as i16x8;
    let odds = (packed >> 4) as i16x8;
    // Each lane of a half's pairs sums 4 products of at most 128 · 15, which
    // an i16 holds, so the halves widen to i32 only once.
    let high = (high_evens as i16x8).relaxed_dot_i8x16_i7x16_s(&evens) + (high_odds as i16x8).relaxed_dot_i8x16_i7x16_s(
        &odds,
    );
    let low = (low_evens as i16x8).relaxed_dot_i8x16_i7x16_s(&evens) + (low_odds as i16x8).relaxed_dot_i8x16_i7x16_s(&odds);
    let dot = (high as i32x4).dot_i16x8_s(&(i16x8::splat(128) as i32x4)) + (low as i32x4).dot_i16x8_s(
        &(i16x8::splat(1) as i32x4),
    );
    let scale = unchecked p.scales.load_at::<f32>(4 * block) * x_scale;
    return f32x4::convert_i32x4_s(dot - offset) * f32x4::splat(scale);
}

impl QuantizedRow {
    /// The 16 bytes of `values` from `at`.
    fn at(&self, at: i32) -> i8x16 {
        return unchecked self.values.load_at::<v128>(at) as i8x16;
    }
}

/// The zero point of block `b` of the weight's row `row`, packed two to a
/// byte as the values are, or 8 without them.
fn zero_point(p: &HostProjection, row: i64, b: i32) -> i32 {
    let Some(z) = p.zero_points else {
        return 8;
    };
    let byte = unchecked z.at(row * p.shape.zero_bytes as i64 + (b / 2) as i64) as i32;
    return byte >> b % 2 * 4 & 15;
}
