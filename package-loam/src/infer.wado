//! Stage 0's pass over a graph: name every tensor's axes from the schema,
//! then discharge each operator's extent conditions in order.

use { TreeMap, TreeSet } from "core:collections";
use { Extent, solved } from "./extent.wado";
use { Axis, AxisConflict, Shape } from "./shape.wado";
use {
    SliceBounds,
    axes_of,
    axis_indices,
    carried_axes,
    count_of,
    fill_of,
    fits,
    fold,
    operand_polys,
    polys_at,
    regrouped_extents,
    slice_bounds,
} from "./fold.wado";
use {
    AttrError,
    Dim,
    Graph,
    KERNEL_ELEMENT,
    Known,
    Node,
    Rank,
    ValueInfo,
    absent,
    data_type,
    dims_of,
    element_of,
    is_binary_elementwise,
    is_unary_operator,
    trailing_axes,
} from "./graph.wado";
use { Condition, Poly, owe as owe_at } from "./poly.wado";
use { from_end, spatial_extents } from "./runtime/tensor.wado";
use { Schema } from "./schema.wado";
use { Geometry, ints, window_over } from "./window.wado";

/// A tensor the schema does not reach. Loam does not fall back to positional
/// axes, for the same reason stage 0 has no runtime tier to defer an unproven
/// extent to.
pub struct UnnamedTensor {
    pub tensor: String,
}

/// The schema named a different number of axes than the graph gave the tensor
/// dimensions.
pub struct AxisCountConflict {
    pub tensor: String,
    pub named: i32,
    pub dims: i32,
}

/// An operator's conditions failed, at the node its first output names.
pub struct NodeConflict {
    pub node: String,
    pub error: AxisConflict,
}

/// A graph output whose declared rank is not the rank the nodes produced.
pub struct DeclaredRankConflict {
    pub tensor: String,
    pub declared: i32,
    pub produced: i32,
}

/// A graph output whose declared extent is not the one the nodes produced.
pub struct DeclaredConflict {
    pub tensor: String,
    pub axis: String,
    pub declared: Extent,
    pub produced: Extent,
}

/// A graph output declared as an element other than the one its node computes.
pub struct DeclaredElementConflict {
    pub tensor: String,
    pub declared: String,
    pub produced: String,
}

/// An operator was given fewer operands than it reads.
pub struct OperandCountConflict {
    pub node: String,
    pub op: String,
    pub given: i32,
    pub needed: i32,
}

/// An operand is not the rank the operator is defined for.
pub struct OperandRankConflict {
    pub node: String,
    pub op: String,
    pub operand: i32,
    pub rank: i32,
    pub needed: i32,
}

/// An operator's attribute is not one this Loam can act on: absent where the
/// operator requires it, or a value the graph cannot mean.
pub struct AttributeConflict {
    pub node: String,
    pub op: String,
    pub attr: String,
    pub reason: String,
}

/// Every operator Loam carries but `Split` and `If` produces one value, so a node naming
/// any other number of outputs has nowhere to put them.
pub struct OutputCountConflict {
    pub node: String,
    pub op: String,
    pub given: i32,
}

/// A node this Loam cannot act on, and why: stage 0's shape algebra, or the
/// kernels emit writes.
pub struct Refusal {
    pub node: String,
    pub op: String,
    pub reason: String,
}

impl Refusal {
    /// `node` refused for `reason`, named as every diagnostic names a node.
    pub fn of(node: &Node, reason: String) -> Refusal {
        builtin::cold_path();
        return Refusal { node: node.name(), op: node.op, reason };
    }
}

/// Why stage 0 cannot read a graph.
pub variant InferError {
    Unnamed(UnnamedTensor),
    Refused(Refusal),
    AxisCount(AxisCountConflict),
    UnknownOperator(String),
    UnrankedTensor(String),
    Oversized(String),
    Undefined(String),
    ScalarOperand(String),
    OperandCount(OperandCountConflict),
    OutputCount(OutputCountConflict),
    Attribute(AttributeConflict),
    OperandRank(OperandRankConflict),
    DeclaredRank(DeclaredRankConflict),
    Declared(DeclaredConflict),
    DeclaredElement(DeclaredElementConflict),
    Node(NodeConflict),
}

impl Display for UnnamedTensor {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(`${self.tensor}: no layout pattern names this tensor's axes`);
    }
}

impl Display for AxisCountConflict {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(
            `${self.tensor}: the schema names ${self.named} axes and the graph gives ${self.dims} dimensions`,
        );
    }
}

impl Display for Refusal {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(`${self.node} = ${self.op}: ${self.reason}`);
    }
}

impl Display for NodeConflict {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(`${self.node} = ${self.error}`);
    }
}

impl Display for OperandCountConflict {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(
            `${self.node} = ${self.op}: reads ${self.needed} operands and was given ${self.given}`,
        );
    }
}

impl Display for OutputCountConflict {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(`${self.node} = ${self.op}: produces one output and names ${self.given}`);
    }
}

impl Display for OperandRankConflict {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(
            `${self.node} = ${self.op}: operand ${self.operand} has rank ${self.rank} and the operator reads rank ${self.needed}`,
        );
    }
}

impl Display for AttributeConflict {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(`${self.node} = ${self.op}: attribute ${self.attr} ${self.reason}`);
    }
}

impl Display for DeclaredRankConflict {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(
            `${self.tensor}: the graph declares rank ${self.declared} and the nodes produce rank ${self.produced}`,
        );
    }
}

impl Display for DeclaredConflict {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(
            `${self.tensor}: axis ${self.axis} is declared ${self.declared} and produced ${self.produced}`,
        );
    }
}

impl Display for DeclaredElementConflict {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(`${self.tensor}: declared ${self.declared} and computed in ${self.produced}`);
    }
}

impl Display for InferError {
    fn fmt(&self, f: &mut Formatter) {
        match self {
            Unnamed(e) => e.fmt(f),
            Refused(e) => e.fmt(f),
            AxisCount(e) => e.fmt(f),
            UnknownOperator(op) => f.write_str(`${op}: no shape rule for this operator`),
            UnrankedTensor(name) => f.write_str(`${name}: the graph states no rank`),
            Oversized(name) => f.write_str(`${name}: its extents multiply past what a list can hold`),
            Undefined(name) => f.write_str(`${name}: no graph input, initializer or node defines this`),
            ScalarOperand(name) => f.write_str(`${name} = MatMul: a scalar operand has no axis to contract`),
            OperandCount(e) => e.fmt(f),
            OutputCount(e) => e.fmt(f),
            Attribute(e) => e.fmt(f),
            OperandRank(e) => e.fmt(f),
            DeclaredRank(e) => e.fmt(f),
            Declared(e) => e.fmt(f),
            DeclaredElement(e) => e.fmt(f),
            Node(e) => e.fmt(f),
        }
    }
}

impl Error for UnnamedTensor {
}

impl Error for AxisCountConflict {
}

impl Error for Refusal {
}

impl Error for NodeConflict {
}

impl Error for OperandCountConflict {
}

impl Error for OutputCountConflict {
}

impl Error for OperandRankConflict {
}

impl Error for AttributeConflict {
}

impl Error for DeclaredRankConflict {
}

impl Error for DeclaredConflict {
}

impl Error for DeclaredElementConflict {
}

impl Error for InferError {
}

/// A checked graph: every shape a kernel reads and the primitive it holds,
/// keyed by tensor name, the elements of every tensor the build folded, and
/// what the inputs owe that the build could not prove.
pub struct Checked {
    pub shapes: TreeMap<String, Shape>,
    pub primitives: TreeMap<String, String>,
    pub known: TreeMap<String, Known>,
    pub owed: List<Condition>,
    /// Each `If`'s two branches, keyed by its first output, then before else:
    /// the branch's scope, the one around it included, and what it owes where
    /// it runs.
    pub branches: TreeMap<String, [Checked, Checked]> = TreeMap::new(),
}

/// `owe_at` the node, which a graph wrong for every input stops at.
fn owe(node: &Node, owed: &mut List<Condition>, slack: Poly, condition: String) -> Result<(), InferError> {
    return owe_at(owed, &node.site(), &slack, condition).map_err(|reason| refusal(node, reason));
}

/// Check a graph. Producing a shape for every tensor a kernel reads is what
/// discharges the graph's extent conditions, so a successful return is the
/// proof, save the conditions it hands `forward` to check.
pub fn infer(graph: &Graph, schema: &Schema) -> Result<Checked, InferError> {
    let mut scope = Checked {
        shapes: TreeMap::new(),
        primitives: TreeMap::new(),
        known: TreeMap::new(),
        owed: [],
    };
    checked_graph(graph, &mut scope, schema)?;
    return Result::Ok(scope);
}

/// Check `graph` within `scope`, which gains its tensors and what it owes.
fn checked_graph(graph: &Graph, scope: &mut Checked, schema: &Schema) -> Result<(), InferError> {
    let local = schema.within(&graph.name);
    for let [name, k] of graph.constants.entries() {
        scope.known[*name] = *k;
        scope.primitives[*name] = known_primitive(k);
    }
    for let declared of [&graph.inputs, &graph.initializers] {
        for let vi of *declared {
            scope.shapes[vi.name] = shape_of(&vi, &local)?;
            // An element no kernel reaches is left out, for emit to name.
            if let Some(element) = element_of(&vi.dtype) {
                scope.primitives[vi.name] = element.computed;
            }
        }
    }
    unspell_unbound(graph, &mut scope.shapes);
    for let node of &graph.nodes {
        checked_node(node, scope, schema, &local, graph.opset)?;
    }
    for let vi of &graph.outputs {
        materialize(&vi.name, &scope.known, &mut scope.shapes, &local)?;
        let Some(produced) = scope.shapes.get(vi.name) else {
            builtin::cold_path();
            return Result::Err(InferError::Undefined(vi.name));
        };
        scope.shapes[vi.name] = held(&vi.name, merge_declared(vi, &produced, &mut scope.owed)?)?;
        if let Some(element) = element_of(&vi.dtype) && let Some(computed) = scope.primitives.get(vi.name) && element.computed != computed {
            builtin::cold_path();
            return Result::Err(InferError::DeclaredElement(DeclaredElementConflict {
                tensor: vi.name,
                declared: vi.dtype,
                produced: computed,
            }));
        }
    }
    scope.owed = distinct(scope.owed);
    return Result::Ok(());
}

/// Each input axis whose `dim_param` spells arithmetic over a name no input
/// binds (`solved`) read again as one symbol of its own, which the run reads
/// from that axis.
fn unspell_unbound(graph: &Graph, shapes: &mut TreeMap<String, Shape>) {
    let mut extents: List<Extent> = [];
    for let vi of &graph.inputs {
        extents.extend(&shapes[vi.name].axes.into_iter().map(|a| a.extent).collect());
    }
    let bound: List<String> = solved(&extents).into_iter().map(|s| s.symbol).collect();
    for let vi of &graph.inputs {
        let Dims(dims) = vi.rank else {
            continue;
        };
        for let [i, d] of dims.into_iter().enumerate() {
            let Symbol(text) = d else {
                continue;
            };
            let axis = shapes[vi.name].axes[i];
            let Symbolic(p) = axis.extent else {
                continue;
            };
            if !p.symbols().into_iter().all(|s| bound.contains_str(s.as_str_slice())) {
                shapes[vi.name].axes[i] = Axis { ..axis, extent: Extent::symbol(&text) };
            }
        }
    }
}

/// Check one node: `schema` is the whole schema, which a branch narrows to its
/// own graph, and `local` the part that reaches this graph's tensors.
fn checked_node(
    node: &Node,
    scope: &mut Checked,
    schema: &Schema,
    local: &Schema,
    opset: Option<i64>,
) -> Result<(), InferError> {
    if node.outputs.is_empty() || node.outputs.len() != 1 && node.op != "Split" && node.op != "If" {
        builtin::cold_path();
        return Result::Err(InferError::OutputCount(OutputCountConflict {
            node: node.name(),
            op: node.op,
            given: node.outputs.len(),
        }));
    }
    for let output of node.outputs {
        if scope.shapes.contains_key(output) || scope.known.contains_key(output) {
            return Result::Err(refusal(node, `${output} is already defined in its graph`));
        }
    }
    operands_given(node, &scope.known, &scope.shapes)?;
    match fold(node, &scope.known, &scope.shapes) {
        Ok(Some(k)) => {
            scope.primitives[node.outputs[0]] = known_primitive(&k);
            scope.known[node.outputs[0]] = k;
            return Result::Ok(());
        },
        Ok(None) => {
        },
        Err(reason) => {
            return Result::Err(refusal(node, reason));
        },
    }
    for let [index, input] of node.inputs.into_iter().enumerate() {
        if !read_at_build_time(node, index) {
            materialize(&input, &scope.known, &mut scope.shapes, local)?;
        }
    }
    if node.op == "If" {
        return branched(node, scope, schema, local);
    }
    let produced = if node.op == "Split" {
        split(node, &scope.shapes, &scope.known, local, &mut scope.owed)?;
    } else {
        [infer_node(node, &scope.shapes, &scope.known, local, opset, &mut scope.owed)?] as List<Shape>;
    };
    let primitive = produced_primitive(node, &scope.primitives)?;
    for let [i, shape] of produced.into_iter().enumerate() {
        scope.shapes[node.outputs[i]] = held(&node.outputs[i], shape)?;
        if let Some(p) = primitive {
            scope.primitives[node.outputs[i]] = p;
        }
    }
    return Result::Ok(());
}

/// An `If`: each branch checked in a scope of its own, and each output the
/// axes both branches give it. An axis the two name apart takes the name the
/// output's layout gives, and one of two lengths a length of its own, which
/// nothing after the node can spell.
fn branched(node: &Node, scope: &mut Checked, schema: &Schema, local: &Schema) -> Result<(), InferError> {
    branch_condition(node, scope)?;
    let [then_graph, then_scope] = checked_branch(node, "then_branch", scope, schema)?;
    let [else_graph, else_scope] = checked_branch(node, "else_branch", scope, schema)?;
    for let [i, output] of node.outputs.into_iter().enumerate() {
        let t = then_scope.shapes[then_graph.outputs[i].name];
        let e = else_scope.shapes[else_graph.outputs[i].name];
        if t.rank() != e.rank() {
            return Result::Err(refusal(
                node,
                `output ${i} has rank ${t.rank()} in then_branch and ${e.rank()} in else_branch`,
            ));
        }
        let pt = then_scope.primitives.get(then_graph.outputs[i].name);
        let pe = else_scope.primitives.get(else_graph.outputs[i].name);
        if pt != pe {
            return Result::Err(refusal(
                node,
                `output ${i} is ${held_name(&pt)} in then_branch and ${held_name(&pe)} in else_branch`,
            ));
        }
        let mut axes: List<Axis> = [];
        for let j of 0..<t.rank() {
            let [a, b] = [t.axes[j], e.axes[j]];
            let extent = if a.extent.agrees(&b.extent) { a.extent } else { Extent::symbol(&`${output}[${j}]`) };
            axes.push(if a.name == b.name {
                Axis { ..a, extent };
            } else {
                output_layout_axis(node, &output, local, j, t.rank(), extent, "is named apart in its branches")?;
            });
        }
        scope.shapes[output] = held(&output, Shape { axes })?;
        if let Some(p) = pt {
            scope.primitives[output] = p;
        }
    }
    for let branch of [&then_scope, &else_scope] {
        hoist_constants(scope, branch, local)?;
    }
    scope.branches[node.outputs[0]] = [then_scope, else_scope];
    return Result::Ok(());
}

/// Give `scope` a shape, under its own layout, for each of its constants
/// `branch` read, so the constant is spelled once around the branches and each
/// branch relabels it to the axes it read it under. One the layout around the
/// branches does not name is left to each branch.
fn hoist_constants(scope: &mut Checked, branch: &Checked, local: &Schema) -> Result<(), InferError> {
    for let [name, _] of branch.shapes.entries() {
        if scope.known.contains_key(*name) && local.axes_for(name) matches { Some(_) } {
            materialize(name, &scope.known, &mut scope.shapes, local)?;
        }
    }
    return Result::Ok(());
}

/// What a message calls a tensor's primitive, where it may have none.
fn held_name(primitive: &Option<String>) -> String {
    return match primitive {
        Some(p) => *p,
        None => "an element no kernel holds",
    };
}

/// An `If`'s condition, which is one bool.
fn branch_condition(node: &Node, scope: &Checked) -> Result<(), InferError> {
    let cond = node.inputs[0];
    let primitive = scope.primitives.get(cond);
    if primitive != Option::Some("bool") {
        return Result::Err(refusal(node, `operand ${cond} is ${held_name(&primitive)}, and If branches on bool`));
    }
    let mut count: i64 = 1;
    for let axis of scope.shapes[cond].axes {
        let Static(n) = axis.extent else {
            return Result::Err(refusal(
                node,
                `operand ${cond}'s axis ${axis.name} is ${axis.extent}, and If branches on one element`,
            ));
        };
        count *= n as i64;
    }
    if count != 1 {
        return Result::Err(refusal(node, `operand ${cond} holds ${count} elements, and If branches on one`));
    }
    return Result::Ok(());
}

/// The graph an `If` attribute holds, checked in a copy of `scope` that owes
/// nothing yet.
fn checked_branch(node: &Node, attr: String, scope: &Checked, schema: &Schema) -> Result<[Graph, Checked], InferError> {
    let Some(a) = node.attr(attr) else {
        return attr_read(node, Result::Err(absent(attr)));
    };
    let Some(graph) = a.graph else {
        return Result::Err(attribute_error(node, attr, "holds no graph, and If branches into one"));
    };
    if !graph.inputs.is_empty() {
        return Result::Err(refusal(node, `${attr} declares inputs, and a branch reads only the scope around it`));
    }
    if !graph.initializers.is_empty() {
        return Result::Err(refusal(node, `${attr} declares weights, and a branch reads those of the graph around it`));
    }
    if graph.outputs.len() != node.outputs.len() {
        return Result::Err(refusal(
            node,
            `${attr} gives ${graph.outputs.len()} outputs, and the node names ${node.outputs.len()}`,
        ));
    }
    let mut inner = Checked { ..*scope, owed: [], branches: TreeMap::new() };
    checked_graph(&graph, &mut inner, schema)?;
    return Result::Ok([graph, inner]);
}

/// `owed` with each slack kept once, as every layer slicing one mask owes the
/// same, under the first node that owed it.
fn distinct(owed: List<Condition>) -> List<Condition> {
    let mut kept: List<Condition> = [];
    let mut seen = TreeSet::<Poly>::new();
    for let c of owed {
        if seen.insert(c.slack) {
            kept.push(c);
        }
    }
    return kept;
}

/// Whether operand `index` is one the operator reads when the build runs, as
/// `Reshape` reads its target, rather than a tensor its kernel computes on.
fn read_at_build_time(node: &Node, index: i32) -> bool {
    if node.op == "Range" || node.op == "ConstantOfShape" {
        return true;
    }
    if node.op == "Slice" {
        return index >= 1;
    }
    return index == 1
        && (node.op == "Reshape"
            || node.op == "Unsqueeze"
            || node.op == "Squeeze"
            || node.op == "Split"
            || is_reduction(&node.op));
}

/// The operators whose kernel moves elements without computing on them, so
/// they carry any primitive through.
fn is_layout(op: &String) -> bool {
    return *op == "Reshape"
        || *op == "Flatten"
        || *op == "Unsqueeze"
        || *op == "Squeeze"
        || *op == "Identity"
        || *op == "Transpose"
        || *op == "Split"
        || *op == "Slice";
}

/// The primitive a node's kernel produces: its operand's for a layout kernel,
/// `Cast`'s target, and f32 for every other; `None` for an element emit refuses.
fn produced_primitive(node: &Node, primitives: &TreeMap<String, String>) -> Result<Option<String>, InferError> {
    let op = node.op;
    if op == "Cast" {
        let to = attr_read(node, node.required_int_attr("to"))?;
        return match data_type(to) {
            Some(Float) => Result::Ok(Option::Some(KERNEL_ELEMENT)),
            Some(Int64) => Result::Ok(Option::Some("i64")),
            Some(Bool) => Result::Ok(Option::Some("bool")),
            _ => Result::Err(refusal(node, `\`to\` is element type ${to}, which no kernel holds`)),
        };
    }
    if op == "Range" {
        // A float range folds, so only an integer one reaches the run.
        return Result::Ok(Option::Some("i64"));
    }
    if op == "ConstantOfShape" {
        return Result::Ok(Option::Some(known_primitive(&attr_read(node, fill_of(node))?)));
    }
    if op == "Gather" {
        let indices = node.inputs[1];
        if let Some(p) = primitives.get(indices) && p != "i64" {
            return Result::Err(refusal(node, `operand ${indices} is ${p}, and Gather indexes with i64`));
        }
        return Result::Ok(primitives.get(node.inputs[0]));
    }
    if op == "Concat" {
        let first = node.inputs[0];
        let element = primitives.get(first);
        for let input of node.inputs {
            if let Some(a) = element && let Some(b) = primitives.get(input) && a != b {
                return Result::Err(refusal(
                    node,
                    `operand ${input} is ${b} and ${first} is ${a}, and Concat joins one element`,
                ));
            }
        }
        return Result::Ok(element);
    }
    if is_layout(&op) {
        return Result::Ok(primitives.get(node.inputs[0]));
    }
    if op == "Where" {
        let [cond, x, y] = [node.inputs[0], node.inputs[1], node.inputs[2]];
        if let Some(p) = primitives.get(cond) && p != "bool" {
            return Result::Err(refusal(node, `operand ${cond} is ${p}, and Where selects with bool`));
        }
        let px = primitives.get(x);
        let py = primitives.get(y);
        if let Some(a) = px && let Some(b) = py && a != b {
            return Result::Err(refusal(node, `operand ${x} is ${a} and ${y} is ${b}, and Where returns one of them`));
        }
        return Result::Ok(px);
    }
    for let [index, input] of node.inputs.into_iter().enumerate() {
        if read_at_build_time(node, index) {
            continue;
        }
        if let Some(p) = primitives.get(input) && p != KERNEL_ELEMENT {
            return Result::Err(refusal(node, `operand ${input} is ${p}, and ${op} computes in ${KERNEL_ELEMENT}`));
        }
    }
    return Result::Ok(Option::Some(KERNEL_ELEMENT));
}

/// The primitive a folded tensor is held in once a kernel reads it. Every
/// folded tensor has one, read or not, so no two compare equal for want of it.
fn known_primitive(k: &Known) -> String {
    return match k.elements {
        Ints(_) | Symbolic(_) => "i64",
        Floats(_) => KERNEL_ELEMENT,
        Bools(_) => "bool",
    };
}

/// Give a folded tensor a kernel reads the axes the layout names.
fn materialize(
    tensor: &String,
    known: &TreeMap<String, Known>,
    shapes: &mut TreeMap<String, Shape>,
    schema: &Schema,
) -> Result<(), InferError> {
    if shapes.contains_key(*tensor) {
        return Result::Ok(());
    }
    let Some(k) = known.get(*tensor) else {
        return Result::Ok(());
    };
    let mut dims: List<Dim> = [];
    for let e of k.extents {
        dims.push(Dim::Static(e));
    }
    shapes[*tensor] = shape_of(&ValueInfo { name: *tensor, dtype: "", rank: Rank::Dims(dims) }, schema)?;
    return Result::Ok(());
}

/// The graph's output declaration merged into what the nodes produced, as ONNX's
/// `mergeInDimensionInfo` does: a declared static extent settles a symbolic
/// one, and the inputs owe that the two are equal.
fn merge_declared(vi: &ValueInfo, produced: &Shape, owed: &mut List<Condition>) -> Result<Shape, InferError> {
    let Some(dims) = dims_of(&vi.rank) else {
        return Result::Ok(*produced);
    };
    if dims.len() != produced.rank() {
        builtin::cold_path();
        return Result::Err(InferError::DeclaredRank(DeclaredRankConflict {
            tensor: vi.name,
            declared: dims.len(),
            produced: produced.rank(),
        }));
    }
    let mut merged = *produced;
    for let mut i = 0; i < dims.len(); i += 1 {
        // A `dim_param` names the axis in the model author's words and `?`
        // names nothing, so neither can disagree with the schema's own name.
        let Static(declared) = dims[i] else {
            continue;
        };
        let axis = &merged.axes[i];
        let agrees = match axis.extent {
            Static(found) => declared == found,
            // The graph states a length the nodes only carried a polynomial
            // for, and a consumer of the shape table is owed the constant.
            Symbolic(p) => {
                let stated = Poly::constant(declared as i64);
                let condition = `axis ${axis.name} must be ${declared}, as the graph declares`;
                match [
                    p.try_sub(&stated),
                    stated.try_sub(&p),
                ] {
                    [Some(above), Some(below)] => {
                        owe_at(owed, &vi.name, &above, condition).is_ok()
                            && owe_at(owed, &vi.name, &below, condition).is_ok();
                    },
                    // A difference no polynomial holds is one the build cannot owe.
                    _ => false,
                }
            },
            Unstated => unreachable(),
        };
        if !agrees {
            builtin::cold_path();
            return Result::Err(InferError::Declared(DeclaredConflict {
                tensor: vi.name,
                axis: axis.name,
                declared: Extent::Static(declared),
                produced: axis.extent,
            }));
        }
        merged.axes[i].extent = Extent::Static(declared);
    }
    return Result::Ok(merged);
}

/// The axes a value info declares, named by the schema and given extents by
/// the graph.
fn shape_of(vi: &ValueInfo, schema: &Schema) -> Result<Shape, InferError> {
    let Some(dims) = dims_of(&vi.rank) else {
        builtin::cold_path();
        return Result::Err(InferError::UnrankedTensor(vi.name));
    };
    // A scalar has no axis for a pattern to name.
    if dims.is_empty() {
        return Result::Ok(Shape { axes: [] });
    }
    let Some(names) = schema.axes_for(&vi.name) else {
        builtin::cold_path();
        return Result::Err(InferError::Unnamed(UnnamedTensor { tensor: vi.name }));
    };
    if names.len() != dims.len() {
        builtin::cold_path();
        return Result::Err(InferError::AxisCount(AxisCountConflict {
            tensor: vi.name,
            named: names.len(),
            dims: dims.len(),
        }));
    }
    let mut axes: List<Axis> = [];
    for let mut i = 0; i < dims.len(); i += 1 {
        axes.push(Axis::named(&names[i], extent_of(&dims[i], &names[i])));
    }
    return held(&vi.name, Shape { axes });
}

/// `shape`, which a list must be able to hold.
fn held(tensor: &String, shape: Shape) -> Result<Shape, InferError> {
    let extents: List<Extent> = shape.axes.into_iter().map(|axis| axis.extent).collect();
    if !fits(&extents) {
        builtin::cold_path();
        return Result::Err(InferError::Oversized(*tensor));
    }
    return Result::Ok(shape);
}

/// An ONNX `dim_value` is a static extent and a `dim_param` a symbolic one, or
/// the arithmetic over symbols it spells. A `?` has no symbol, so the axis's
/// name stands for it, as one length.
fn extent_of(dim: &Dim, axis: &String) -> Extent {
    return match dim {
        Static(n) => Extent::Static(*n),
        Symbol(s) => Extent::param(s),
        Unknown => Extent::symbol(axis),
    };
}

fn infer_node(
    node: &Node,
    shapes: &TreeMap<String, Shape>,
    known: &TreeMap<String, Known>,
    schema: &Schema,
    opset: Option<i64>,
    owed: &mut List<Condition>,
) -> Result<Shape, InferError> {
    let op = node.op;
    if op == "Unsqueeze" || op == "Squeeze" {
        let operand = operand_at(node, shapes, 0);
        let input: List<Extent> = operand.axes.into_iter().map(|axis| axis.extent).collect();
        let carried = carried_axes(node, known, &input).map_err(|reason| refusal(node, reason))?;
        let mut axes: List<Axis> = [];
        for let [i, from] of carried.into_iter().enumerate() {
            axes.push(match from {
                Some(a) => operand.axes[a],
                None => output_layout_axis(
                    node,
                    &node.outputs[0],
                    schema,
                    i,
                    carried.len(),
                    Extent::Static(1),
                    "is inserted",
                )?,
            });
        }
        return Result::Ok(Shape { axes });
    }
    if op == "Reshape" {
        let operand = operand_at(node, shapes, 0);
        let input = extents_of(node, &operand)?;
        let targets = regrouped_extents(node, known, &input, owed).map_err(|reason| refusal(node, reason))?;
        return regrouped(node, &operand, &targets, schema);
    }
    if op == "Flatten" {
        return flatten(node, &operand_at(node, shapes, 0), schema);
    }
    if op == "Slice" {
        return sliced(node, &operand_at(node, shapes, 0), known, schema);
    }
    if op == "ConstantOfShape" {
        return filled(node, known, schema, owed);
    }
    if op == "Range" {
        let count = range_count(node, known, owed)?;
        return Result::Ok(Shape {
            axes: [output_layout_axis(node, &node.outputs[0], schema, 0, 1, count, "is a range")?],
        });
    }
    if op == "Gather" {
        let data = operand_at(node, shapes, 0);
        let indices = operand_at(node, shapes, 1);
        let axis = gather_axis(node, data.rank())?;
        let mut axes = data.axes[0..<axis].to_list();
        axes.extend(&indices.axes);
        axes.extend(&data.axes[axis + 1..<data.rank()].to_list());
        return Result::Ok(Shape { axes });
    }
    if op == "MaxPool" {
        let x = operand_at(node, shapes, 0);
        let window = window_of(node, &x, shapes, owed)?;
        return windowed(node, [x.axes[0], x.axes[1]], &window, schema);
    }
    if op == "Conv" {
        let x = operand_at(node, shapes, 0);
        let w = operand_at(node, shapes, 1);
        // `window_of` checks the weight's rank, which `conv_group` relies on.
        let window = window_of(node, &x, shapes, owed)?;
        let group = conv_group(node, &w)?;
        agree_at(node, &x.axes[1], &grouped_inputs(node, &x.axes[1], &w.axes[1], group)?, owed)?;
        if has_bias(node) {
            let b = operand_at(node, shapes, 2);
            if b.rank() != 1 {
                return Result::Err(operand_rank(node, 2, b.rank(), 1));
            }
            agree_at(node, &w.axes[0], &b.axes[0], owed)?;
        }
        return windowed(node, [x.axes[0], w.axes[0]], &window, schema);
    }
    if op == "MatMul" {
        let [a, b] = binary_operands(node, shapes)?;
        if a.rank() == 0 || b.rank() == 0 {
            builtin::cold_path();
            return Result::Err(InferError::ScalarOperand(node.name()));
        }
        return at_node(node, a.matmul(&b, op, owed));
    }
    if is_binary_elementwise(&op) {
        let [a, b] = binary_operands(node, shapes)?;
        let trailing = trailing_axes(node, a.rank(), b.rank()).map_err(|reason| refusal(node, reason))?;
        return at_node(node, a.elementwise(&b.followed_by_units(&a, trailing), op, owed));
    }
    if op == "Gemm" {
        let [_, _, trans_a, trans_b] = gemm_options(node)?;
        let a = gemm_matrix(node, shapes, 0, trans_a)?;
        let b = gemm_matrix(node, shapes, 1, trans_b)?;
        let product = at_node(node, a.matmul(&b, op, owed))?;
        if !has_bias(node) {
            return Result::Ok(product);
        }
        // ONNX broadcasts `C` into the product, so a bias of higher rank is
        // refused rather than widening a `Gemm` past the two axes it has.
        let c = operand_at(node, shapes, 2);
        if c.rank() > product.rank() {
            return Result::Err(operand_rank(node, 2, c.rank(), product.rank()));
        }
        return at_node(node, product.elementwise(&c, op, owed));
    }
    if op == "Transpose" {
        let shape = operand_at(node, shapes, 0);
        let perm = transpose_perm(node, shape.rank())?;
        return Result::Ok(shape.permute(&perm));
    }
    if op == "Concat" {
        return joined(node, shapes, schema, owed);
    }
    if is_unary_elementwise(&op) {
        return Result::Ok(operand_at(node, shapes, 0));
    }
    if op == "Where" {
        let branches = at_node(node, operand_at(node, shapes, 1).elementwise(&operand_at(node, shapes, 2), op, owed))?;
        return at_node(node, branches.elementwise(&operand_at(node, shapes, 0), op, owed));
    }
    if op == "Softmax" {
        let x = operand_at(node, shapes, 0);
        softmax_lane(node, x.rank(), opset)?;
        return Result::Ok(x);
    }
    if is_reduction(&op) {
        let x = operand_at(node, shapes, 0);
        let reduced = reduced_axes(node, known, x.rank())?;
        let keep = int_attr(node, "keepdims", 1)? != 0;
        let mut axes: List<Axis> = [];
        for let [i, axis] of x.axes.into_iter().enumerate() {
            if !reduced.contains(&i) {
                axes.push(axis);
            } else if keep {
                axes.push(Axis { ..axis, extent: Extent::Static(1) });
            }
        }
        return Result::Ok(Shape { axes });
    }
    builtin::cold_path();
    return Result::Err(InferError::UnknownOperator(op));
}

/// `Split`'s outputs: the operand with the split axis cut to each part. A part
/// narrower than the axis is a new axis, for its output's layout to name.
fn split(
    node: &Node,
    shapes: &TreeMap<String, Shape>,
    known: &TreeMap<String, Known>,
    schema: &Schema,
    owed: &mut List<Condition>,
) -> Result<List<Shape>, InferError> {
    let x = operand_at(node, shapes, 0);
    let parts = split_parts(node, known, &x, owed)?;
    let axis = split_axis(node, x.rank())?;
    let whole = x.axes[axis].extent.poly();
    let mut produced: List<Shape> = [];
    for let [i, part] of parts.into_iter().enumerate() {
        let mut axes = x.axes;
        if part != whole {
            axes[axis] = output_layout_axis(
                node,
                &node.outputs[i],
                schema,
                axis,
                x.rank(),
                counted(node, part)?,
                "is a part of a split axis",
            )?;
        }
        produced.push(Shape { axes });
    }
    return Result::Ok(produced);
}

/// A `Concat` the run computes, since some operand is only known then. The
/// operands meet on every other axis, and the joined axis, as long as their
/// parts together, is new, for the output's layout to name.
fn joined(
    node: &Node,
    shapes: &TreeMap<String, Shape>,
    schema: &Schema,
    owed: &mut List<Condition>,
) -> Result<Shape, InferError> {
    let first = operand_at(node, shapes, 0);
    let axis = concat_axis(node, first.rank())?;
    if node.inputs.len() == 1 {
        return Result::Ok(first);
    }
    let mut sum = Poly::constant(0);
    for let index of 0..<node.inputs.len() {
        let x = operand_at(node, shapes, index);
        if x.rank() != first.rank() {
            return Result::Err(operand_rank(node, index, x.rank(), first.rank()));
        }
        for let i of 0..<x.rank() {
            if i == axis {
                continue;
            }
            agree_at(node, &first.axes[i], &x.axes[i], owed)?;
        }
        let part = extents_of(node, &x)?[axis].poly();
        sum = sum.try_add(&part).ok_or(refusal(node, `${sum} + ${part} leaves i64`))?;
    }
    let mut axes = first.axes;
    axes[axis] = output_layout_axis(
        node,
        &node.outputs[0],
        schema,
        axis,
        first.rank(),
        counted(node, sum)?,
        "is a concatenation",
    )?;
    return Result::Ok(Shape { axes });
}

/// The axis `Concat` joins along, resolved against `rank`.
pub fn concat_axis(node: &Node, rank: i32) -> Result<i32, InferError> {
    return resolved_axis(node, attr_read(node, node.required_int_attr("axis"))?, rank, rank - 1);
}

/// The axis `Split` cuts, resolved against `rank`.
pub fn split_axis(node: &Node, rank: i32) -> Result<i32, InferError> {
    return axis_attr(node, 0, rank, rank - 1);
}

/// The extent of each part `Split` cuts its operand's axis into: the sizes it
/// reads, or equal parts with the last taking what remains. `owed` gains what
/// only the run can check: that each part lies within the axis, and that the
/// parts sum to it.
pub fn split_parts(
    node: &Node,
    known: &TreeMap<String, Known>,
    x: &Shape,
    owed: &mut List<Condition>,
) -> Result<List<Poly>, InferError> {
    let axis = split_axis(node, x.rank())?;
    let whole = extents_of(node, x)?[axis].poly();
    let count = node.outputs.len();
    let sizes = match polys_at(node, known, 1, "split").map_err(|reason| refusal(node, reason))? {
        Some(given) => {
            if given.len() != count {
                return Result::Err(refusal(node, `${given.len()} sizes are given for ${count} outputs`));
            }
            given;
        },
        None => {
            let chunk = Poly::ceil_div(&whole, &Poly::constant(count as i64), &node.site());
            let mut equal = List::<Poly>::filled(count - 1, chunk);
            let others = chunk.try_mul(&Poly::constant(count as i64 - 1)).ok_or(refusal(
                node,
                `${chunk} * ${count - 1} leaves i64`,
            ))?;
            equal.push(difference(node, &whole, &others)?);
            equal;
        },
    };
    let mut sum = Poly::constant(0);
    for let size of sizes {
        let within = `a part is ${size}, which must lie within axis ${axis}'s ${whole}`;
        owe(node, owed, size, within)?;
        owe(node, owed, difference(node, &whole, &size)?, within)?;
        sum = sum.try_add(&size).ok_or(refusal(node, `${sum} + ${size} leaves i64`))?;
    }
    match Extent::Symbolic(sum).agreement(&Extent::Symbolic(whole)) {
        Some(presumed) => owed.extend(&presumed),
        None => {
            let exact = `the parts sum to ${sum}, which must be axis ${axis}'s ${whole}`;
            owe(node, owed, difference(node, &sum, &whole)?, exact)?;
            owe(node, owed, difference(node, &whole, &sum)?, exact)?;
        },
    }
    return Result::Ok(sizes);
}

/// `Flatten` regroups the axes ahead of `axis` into one and the rest into
/// another, either of which may be empty and so extent 1.
fn flatten(node: &Node, operand: &Shape, schema: &Schema) -> Result<Shape, InferError> {
    let extents = extents_of(node, operand)?;
    let axis = axis_attr(node, 1, operand.rank(), operand.rank())?;
    let mut targets: List<Extent> = [];
    for let run of [
        extents[0..<axis].to_list(),
        extents[axis..<extents.len()].to_list(),
    ] {
        let Some(count) = count_of(&run) else {
            return Result::Err(refusal(node, `the extents ${node.inputs[0]} flattens multiply past i64`));
        };
        // `held` bounded the operand's elements, so either run's are an extent.
        targets.push(Extent::of(count).unwrap());
    }
    return regrouped(node, operand, &targets, schema);
}

/// Every extent of an operand a regrouping reads.
fn extents_of(node: &Node, operand: &Shape) -> Result<List<Extent>, InferError> {
    return operand.extents(&node.op).map_err(|reason| refusal(node, reason));
}

/// Every extent of an operand the operator reads as static.
fn static_extents_of(node: &Node, operand: &Shape) -> Result<List<i32>, InferError> {
    return operand.static_extents(&node.op).map_err(|reason| refusal(node, reason));
}

/// The operand's axes regrouped onto `targets`. An axis no regrouping
/// determines is the output layout's to name.
fn regrouped(node: &Node, operand: &Shape, targets: &List<Extent>, schema: &Schema) -> Result<Shape, InferError> {
    let mut axes: List<Axis> = [];
    for let [i, found] of operand.regroup(targets).into_iter().enumerate() {
        axes.push(match found {
            Some(axis) => axis,
            None => layout_axis(node, schema, i, targets, "regroups none of the operand's axes")?,
        });
    }
    return Result::Ok(Shape { axes });
}

/// A `Slice` the run computes, since a bound or the data is only known then.
/// An axis it narrows is new, for the output layout to name.
fn sliced(node: &Node, x: &Shape, known: &TreeMap<String, Known>, schema: &Schema) -> Result<Shape, InferError> {
    let mut extents: List<Extent> = x.axes.into_iter().map(|axis| axis.extent).collect();
    let mut axes = x.axes;
    for let cut of slice_cuts(node, known, x)? {
        extents[cut.axis] = cut.extent;
        axes[cut.axis] = layout_axis(node, schema, cut.axis, &extents, "is a slice of an axis")?;
    }
    return Result::Ok(Shape { axes });
}

/// One axis a `Slice` narrows: where it starts, the extent it keeps, and the
/// step from one kept position to the next.
pub struct Cut {
    pub axis: i32,
    /// At least -1, which only a backward cut of an empty axis starts at, and
    /// it keeps nothing.
    pub start: Poly,
    pub extent: Extent,
    pub step: i64,
}

/// The axes a `Slice` over `x` narrows, leaving out one it keeps whole. A bound
/// may be symbolic, and a clamp the build cannot decide is a symbol the run
/// derives.
pub fn slice_cuts(node: &Node, known: &TreeMap<String, Known>, x: &Shape) -> Result<List<Cut>, InferError> {
    let SliceBounds { starts, ends, axes, steps } = slice_bounds(node, known).map_err(|reason| refusal(node, reason))?;
    let mut cuts: List<Cut> = [];
    let resolved = axis_indices(&axes, x.rank()).map_err(|reason| refusal(node, reason))?;
    for let [i, a] of resolved.into_iter().enumerate() {
        let step = steps[i];
        if step == 0 {
            return Result::Err(refusal(node, "a step is 0"));
        }
        let dim = x.axes[a].extent.poly();
        // Walking backwards, the first position is the axis's last, and the
        // end may lie before the axis, at -1.
        let [top, floor] = if step > 0 { [dim, 0_i64] } else { [difference(node, &dim, &Poly::constant(1))?, -1_i64] };
        let begin = slice_bound(node, &starts[i], &dim, 0, &top)?;
        let end = slice_bound(node, &ends[i], &dim, floor, &top)?;
        // A step is a number other than 0, which owes nothing.
        let mut unowed: List<Condition> = [];
        let count = stepped_count(node, &begin, &end, &Poly::constant(step), &mut unowed)?;
        assert unowed.is_empty();
        if begin != Poly::constant(0) || count != dim || step != 1 {
            cuts.push(Cut { axis: a, start: begin, extent: counted(node, count)?, step });
        }
    }
    return Result::Ok(cuts);
}

/// A `Slice` bound as ONNX reads it against an axis of `dim`: counted from the
/// end where negative, then clamped within `[floor, top]`.
fn slice_bound(node: &Node, written: &Poly, dim: &Poly, floor: i64, top: &Poly) -> Result<Poly, InferError> {
    // An exporter writes "to the end" as a constant past any axis. No extent is
    // past `i32::MAX`, so every constant beyond `i32::MAX + 1` clamps as that
    // one does, and the build can tell it lies past every axis.
    let limit = i32::MAX as i64 + 1;
    let bound = match written.as_constant() {
        Some(c) => Poly::constant(i64::clamp(c, -limit, limit)),
        None => *written,
    };
    let site = node.site();
    let Some(resolved) = Poly::from_end(&bound, dim, &site) else {
        return Result::Err(refusal(node, `${bound} + ${*dim} leaves i64`));
    };
    return Result::Ok(Poly::clamped(&resolved, &Poly::constant(floor), top, &site));
}

/// `a - b`, of integers the graph computed, or the refusal where no polynomial
/// holds it.
fn difference(node: &Node, a: &Poly, b: &Poly) -> Result<Poly, InferError> {
    return a.try_sub(b).ok_or(refusal(node, `${*a} - ${*b} leaves i64`));
}

/// `count` as the extent of what the run computes, or the refusal where no
/// list holds that many.
fn counted(node: &Node, count: Poly) -> Result<Extent, InferError> {
    return Extent::of(count).ok_or(refusal(node, `${count} elements are more than a list holds`));
}

/// A `ConstantOfShape` the run fills, since a symbol stands for an extent of
/// its shape. Each extent owes that it is not negative, and every axis is new,
/// for the output layout to name.
fn filled(
    node: &Node,
    known: &TreeMap<String, Known>,
    schema: &Schema,
    owed: &mut List<Condition>,
) -> Result<Shape, InferError> {
    let written = operand_polys(node, known, 0).map_err(|reason| refusal(node, reason))?;
    let mut extents: List<Extent> = [];
    for let e of written {
        owe(node, owed, e, `the shape's ${e} must not be negative`)?;
        extents.push(counted(node, e)?);
    }
    let mut axes: List<Axis> = [];
    for let i of 0..<extents.len() {
        axes.push(layout_axis(node, schema, i, &extents, "is filled")?);
    }
    return Result::Ok(Shape { axes });
}

/// How many elements a `Range` the run computes yields. Its operands are one
/// element each, and the build knows them, symbolic or not.
fn range_count(node: &Node, known: &TreeMap<String, Known>, owed: &mut List<Condition>) -> Result<Extent, InferError> {
    let [start, limit, delta] = range_bounds(node, known)?;
    return counted(node, stepped_count(node, &start, &limit, &delta, owed)?);
}

/// How many steps of `step` fit from `from` to `to`, as ONNX counts them for
/// `Slice` and `Range`: the last may fall short, and a span running against
/// the step holds none. The step's sign must be one the build can tell, and a
/// symbolic step owes that it is not 0.
fn stepped_count(
    node: &Node,
    from: &Poly,
    to: &Poly,
    step: &Poly,
    owed: &mut List<Condition>,
) -> Result<Poly, InferError> {
    let zero = Poly::constant(0);
    let forward = step.is_nonnegative();
    // `i64::MIN` has no magnitude in `i64`. A span is an `i64`, so a step of
    // `i64::MAX` counts it as the one step `i64::MIN` would.
    let magnitude = if forward { *step } else { zero.try_sub(step).unwrap_or(Poly::constant(i64::MAX)) };
    if !magnitude.is_nonnegative() {
        return Result::Err(refusal(node, `the step is ${*step}, whose sign the build cannot tell`));
    }
    owe(node, owed, difference(node, &magnitude, &Poly::constant(1))?, `the step ${*step} must not be 0`)?;
    let span = if forward { difference(node, to, from)? } else { difference(node, from, to)? };
    let site = node.site();
    return Result::Ok(Poly::max_of(&Poly::ceil_div(&span, &magnitude, &site), &zero, &site));
}

/// A `Range`'s start, limit and delta, each one integer the build knows.
pub fn range_bounds(node: &Node, known: &TreeMap<String, Known>) -> Result<[Poly, Poly, Poly], InferError> {
    let mut bounds: List<Poly> = [];
    let operands: List<String> = ["start", "limit", "delta"];
    for let [i, operand] of operands.into_iter().enumerate() {
        let values = operand_polys(node, known, i).map_err(|reason| refusal(node, reason))?;
        if values.len() != 1 {
            return Result::Err(refusal(node, `${operand} is not one integer`));
        }
        bounds.push(values[0]);
    }
    return Result::Ok([bounds[0], bounds[1], bounds[2]]);
}

/// A window's output: the two leading axes it carries through, and one axis
/// per spatial position, which the output layout names.
fn windowed(node: &Node, lead: [Axis, Axis], window: &Geometry, schema: &Schema) -> Result<Shape, InferError> {
    let [batch, channels] = lead;
    let mut extents = [batch.extent, channels.extent] as List<Extent>;
    for let e of window.output {
        extents.push(counted(node, e)?);
    }
    let mut axes = [batch, channels] as List<Axis>;
    for let i of 2..<extents.len() {
        axes.push(layout_axis(node, schema, i, &extents, "is a window's output")?);
    }
    return Result::Ok(Shape { axes });
}

/// Axis `index` of the node's first output, which the operator left
/// undetermined, under the name the output's layout gives it. `why` says what made it new.
fn layout_axis(
    node: &Node,
    schema: &Schema,
    index: i32,
    extents: &List<Extent>,
    why: String,
) -> Result<Axis, InferError> {
    return output_layout_axis(node, &node.outputs[0], schema, index, extents.len(), extents[index], why);
}

/// `layout_axis` for any of the node's outputs, of rank `rank`.
fn output_layout_axis(
    node: &Node,
    output: &String,
    schema: &Schema,
    index: i32,
    rank: i32,
    extent: Extent,
    why: String,
) -> Result<Axis, InferError> {
    let Some(names) = schema.axes_for(output) else {
        return Result::Err(refusal(node, `axis ${index} ${why}, so a layout pattern must name ${output}'s`));
    };
    if names.len() != rank {
        builtin::cold_path();
        return Result::Err(InferError::AxisCount(AxisCountConflict {
            tensor: *output,
            named: names.len(),
            dims: rank,
        }));
    }
    return Result::Ok(Axis::named(&names[index], extent));
}

/// The window a `Conv` or `MaxPool` slides over its first operand. `emit`
/// reads it again to write the kernel's geometry.
pub fn window_of(
    node: &Node,
    x: &Shape,
    shapes: &TreeMap<String, Shape>,
    owed: &mut List<Condition>,
) -> Result<Geometry, InferError> {
    if x.rank() < 3 {
        return Result::Err(refusal(
            node,
            `the operand has rank ${x.rank()}, and a window slides over axes past the second`,
        ));
    }
    let spatial: List<Poly> = extents_of(node, x)?[2..<x.rank()].to_list().into_iter().map(|e| e.poly()).collect();
    let kernel = if node.op == "Conv" {
        let w = operand_at(node, shapes, 1);
        if w.rank() != x.rank() {
            return Result::Err(operand_rank(node, 1, w.rank(), x.rank()));
        }
        spatial_extents(&static_extents_of(node, &w)?);
    } else {
        if node.attr("kernel_shape") matches { None } {
            return attr_read(node, Result::Err(absent("kernel_shape")));
        }
        attr_read(node, ints(node, "kernel_shape", spatial.len(), 1))?;
    };
    let ceil = int_attr(node, "ceil_mode", 0)? != 0;
    return attr_read(node, window_over(node, &spatial, kernel, ceil, owed));
}

/// An attribute read, its failure said at `node`.
fn attr_read<T>(node: &Node, read: Result<T, AttrError>) -> Result<T, InferError> {
    return match read {
        Ok(v) => Result::Ok(v),
        Err(e) => Result::Err(attribute_error(node, e.attr, e.reason)),
    };
}

fn agree_at(node: &Node, left: &Axis, right: &Axis, owed: &mut List<Condition>) -> Result<(), InferError> {
    return match Shape::agree(left, right, &node.op, owed) {
        Ok(_) => Result::Ok(()),
        Err(e) => Result::Err(InferError::Node(NodeConflict { node: node.name(), error: e })),
    };
}

fn refusal(node: &Node, reason: String) -> InferError {
    return InferError::Refused(Refusal::of(node, reason));
}

/// `Conv`'s `group`, which must divide the output channels, `w`'s first axis.
pub fn conv_group(node: &Node, w: &Shape) -> Result<i32, InferError> {
    let group = int_attr(node, "group", 1)?;
    if group == 1 {
        return Result::Ok(1);
    }
    let Static(outputs) = w.axes[0].extent else {
        return Result::Err(attribute_error(
            node,
            "group",
            `is ${group}, and a symbolic count of output channels proves no divisor`,
        ));
    };
    if !(1 <= group <= outputs as i64) || outputs as i64 % group != 0 {
        return Result::Err(attribute_error(
            node,
            "group",
            `is ${group}, which does not divide the ${outputs} output channels`,
        ));
    }
    return Result::Ok(group as i32);
}

/// The input channels a `Conv` of `group` groups reads, each group reading
/// `per_group` of them, as an axis to hold the input's, `input`, to. One group
/// reads the input's own axis. Over several, a group's share is an axis of its
/// own, so only the lengths meet and the input's name stands for the whole.
fn grouped_inputs(node: &Node, input: &Axis, per_group: &Axis, group: i32) -> Result<Axis, InferError> {
    if group == 1 {
        return Result::Ok(*per_group);
    }
    let read = match per_group.extent.poly().try_mul(&Poly::constant(group as i64)) {
        Some(p) => Extent::of(p),
        None => null,
    };
    let Some(extent) = read else {
        return Result::Err(attribute_error(
            node,
            "group",
            `is ${group}, and so many groups of ${per_group.extent} channels pass what an axis holds`,
        ));
    };
    return Result::Ok(Axis { name: input.name, extent });
}

/// Whether a `Gemm` was given its `C` operand, or a `Conv` its `B`. ONNX
/// writes an absent optional operand as an empty name, or omits it.
pub fn has_bias(node: &Node) -> bool {
    return node.inputs.len() >= 3 && node.inputs[2] != "";
}

/// `Gemm`'s `alpha`, `beta`, `transA` and `transB`, each defaulted as ONNX
/// defaults it. `emit` reads them again to pick its kernels.
pub fn gemm_options(node: &Node) -> Result<[f32, f32, bool, bool], InferError> {
    return Result::Ok([
        float_attr(node, "alpha", 1.0)?,
        float_attr(node, "beta", 1.0)?,
        int_attr(node, "transA", 0)? != 0,
        int_attr(node, "transB", 0)? != 0,
    ]);
}

fn operand_rank(node: &Node, index: i32, rank: i32, needed: i32) -> InferError {
    builtin::cold_path();
    return InferError::OperandRank(OperandRankConflict {
        node: node.name(),
        op: node.op,
        operand: index,
        rank,
        needed,
    });
}

/// One `Gemm` matrix operand, transposed where its flag says so. ONNX defines
/// `Gemm` over two-dimensional operands only.
fn gemm_matrix(node: &Node, shapes: &TreeMap<String, Shape>, index: i32, transposed: bool) -> Result<Shape, InferError> {
    let shape = operand_at(node, shapes, index);
    if shape.rank() != 2 {
        return Result::Err(operand_rank(node, index, shape.rank(), 2));
    }
    if transposed {
        return Result::Ok(shape.permute(&([1, 0] as List<i32>)));
    }
    return Result::Ok(shape);
}

fn float_attr(node: &Node, name: String, fallback: f32) -> Result<f32, InferError> {
    return attr_read(node, node.float_attr(name, fallback));
}

fn int_attr(node: &Node, name: String, fallback: i64) -> Result<i64, InferError> {
    return attr_read(node, node.int_attr(name, fallback));
}

/// The operand axis `Gather` indexes along.
pub fn gather_axis(node: &Node, rank: i32) -> Result<i32, InferError> {
    return axis_attr(node, 0, rank, rank - 1);
}

/// The lane `Softmax` normalizes: `axis` alone, or where `flattened`, every
/// axis from `axis` on as one.
pub struct SoftmaxLane {
    pub axis: i32,
    pub flattened: bool,
}

/// Before opset 13 `Softmax` normalized every axis from `axis` on as one, which
/// is a single axis only where `axis` is the last.
pub fn softmax_lane(node: &Node, rank: i32, opset: Option<i64>) -> Result<SoftmaxLane, InferError> {
    if let Some(version) = opset && version < 13 {
        let axis = axis_attr(node, 1, rank, rank - 1)?;
        return Result::Ok(SoftmaxLane { axis, flattened: axis < rank - 1 });
    }
    return Result::Ok(SoftmaxLane { axis: axis_attr(node, -1, rank, rank - 1)?, flattened: false });
}

/// Whether `op` is a reduction stage 0 reads.
pub fn is_reduction(op: &String) -> bool {
    return *op == "ReduceMean" || *op == "ReduceSum";
}

/// The axes a reduction folds, resolved against `rank`. Naming none folds every
/// axis, unless `noop_with_empty_axes` makes it fold none.
pub fn reduced_axes(node: &Node, known: &TreeMap<String, Known>, rank: i32) -> Result<List<i32>, InferError> {
    let written = axes_of(node, known, 1, "axes").map_err(|reason| refusal(node, reason))?;
    let listed: List<i64> = written.unwrap_or([]);
    if !listed.is_empty() {
        return axis_indices(&listed, rank).map_err(|reason| refusal(node, reason));
    }
    let mut axes: List<i32> = [];
    if int_attr(node, "noop_with_empty_axes", 0)? == 0 {
        for let i of 0..<rank {
            axes.push(i);
        }
    }
    return Result::Ok(axes);
}

/// The `axis` attribute, where a negative one counts from `rank` and the
/// operator reads at most `last`.
fn axis_attr(node: &Node, fallback: i64, rank: i32, last: i32) -> Result<i32, InferError> {
    return resolved_axis(node, int_attr(node, "axis", fallback)?, rank, last);
}

/// The `axis` attribute's `written` value, resolved as `axis_attr` resolves it.
fn resolved_axis(node: &Node, written: i64, rank: i32, last: i32) -> Result<i32, InferError> {
    let resolved = from_end(written, rank as i64);
    if !(0 <= resolved <= last as i64) {
        return Result::Err(attribute_error(node, "axis", `is ${written}, outside rank ${rank}`));
    }
    return Result::Ok(resolved as i32);
}

/// `Transpose`'s `perm`: the axis order the output takes, which ONNX defaults
/// to the reversed order. `emit` reads it again to pick the kernel.
pub fn transpose_perm(node: &Node, rank: i32) -> Result<List<i32>, InferError> {
    let Some(attr) = node.attr("perm") else {
        let mut reversed: List<i32> = [];
        for let mut i = rank - 1; i >= 0; i -= 1 {
            reversed.push(i);
        }
        return Result::Ok(reversed);
    };
    let written = attr_read(node, attr.ints())?;
    if written.len() != rank {
        builtin::cold_path();
        return Result::Err(attribute_error(node, "perm", `names ${written.len()} axes and the operand has ${rank}`));
    }
    let mut perm: List<i32> = [];
    let mut taken: List<bool> = List::filled(rank, false);
    for let axis of written {
        if !(0 <= axis < rank as i64) || taken[axis as i32] {
            builtin::cold_path();
            return Result::Err(attribute_error(node, "perm", `is not a permutation of ${rank} axes`));
        }
        taken[axis as i32] = true;
        perm.push(axis as i32);
    }
    return Result::Ok(perm);
}

fn attribute_error(node: &Node, attr: String, reason: String) -> InferError {
    return InferError::Attribute(AttributeConflict {
        node: node.name(),
        op: node.op,
        attr,
        reason,
    });
}

fn binary_operands(node: &Node, shapes: &TreeMap<String, Shape>) -> Result<[Shape, Shape], InferError> {
    return Result::Ok([
        operand_at(node, shapes, 0),
        operand_at(node, shapes, 1),
    ]);
}

/// Every operand `node` names is defined, and none it needs is absent, so the
/// rules after this read an operand by position. A hand-edited file breaks this.
fn operands_given(
    node: &Node,
    known: &TreeMap<String, Known>,
    shapes: &TreeMap<String, Shape>,
) -> Result<(), InferError> {
    if let Some(needed) = required_operands(&node.op) {
        let mut given = 0;
        while given < node.inputs.len() && node.inputs[given] != "" {
            given += 1;
        }
        if given < needed {
            builtin::cold_path();
            return Result::Err(InferError::OperandCount(OperandCountConflict {
                node: node.name(),
                op: node.op,
                given,
                needed,
            }));
        }
    }
    for let input of node.inputs {
        if input != "" && !known.contains_key(input) && !shapes.contains_key(input) {
            builtin::cold_path();
            return Result::Err(InferError::Undefined(input));
        }
    }
    return Result::Ok(());
}

/// How many leading operands `op` cannot do without, or `None` for an operator
/// Loam does not know. One an older opset wrote as an attribute is not counted.
fn required_operands(op: &String) -> Option<i32> {
    if is_unary_elementwise(op) || is_reduction(op) {
        return Option::Some(1);
    }
    if is_binary_elementwise(op) {
        return Option::Some(2);
    }
    return match op.as_str_slice() {
        "Constant" => Option::Some(0),
        "Shape" | "Reshape" | "Unsqueeze" | "Squeeze" | "Flatten" | "Concat" | "Slice" | "ConstantOfShape" | "Transpose" | "Softmax" | "Split" | "MaxPool" => Option::Some(
            1,
        ),
        "Gather" | "MatMul" | "Gemm" | "Conv" => Option::Some(2),
        "If" => Option::Some(1),
        "Range" | "Where" => Option::Some(3),
        _ => null,
    };
}

/// The operators whose output shape is their input's.
fn is_unary_elementwise(op: &String) -> bool {
    return *op == "Identity" || *op == "Cast" || is_unary_operator(op);
}

/// Operand `index`'s shape. `operands_given` proved it defined, and a folded one
/// is materialized before any rule reads it.
fn operand_at(node: &Node, shapes: &TreeMap<String, Shape>, index: i32) -> Shape {
    return shapes.get(node.inputs[index]).unwrap();
}

fn at_node(node: &Node, result: Result<Shape, AxisConflict>) -> Result<Shape, InferError> {
    return match result {
        Ok(shape) => Result::Ok(shape),
        Err(error) => Result::Err(InferError::Node(NodeConflict {
            node: node.name(),
            error,
        })),
    };
}
