//! The ONNX textual format, read off the parse tree into `graph.wado`'s types.

use onnx from "../grammar/Onnx.g4"
    with {
        generator: { module: "lib:gale" },
    };

use { TreeMap } from "core:collections";
use {
    Attr,
    Dim,
    Elements,
    Graph,
    Known,
    Node,
    Rank,
    ReadError,
    ValueInfo,
    bit_pattern,
    check_element_count,
    constant_without_values,
    default_opset,
    element_of,
    is_build_time,
    parameters,
    push_element,
    static_extents,
    upgraded,
} from "./graph.wado";

/// Read a graph out of the ONNX textual format. A syntax error comes back as
/// the first diagnostic; anything the reader does not cover names itself.
pub fn read<S: AsStrSlice>(source: S) -> Result<Graph, ReadError> {
    return read_model(source).map_err(|reason| ReadError { reason });
}

fn read_model<S: AsStrSlice>(source: S) -> Result<Graph, String> {
    let result = onnx::parse(source);
    if !result.ok() {
        let d = &result.diagnostics[0];
        return Result::Err(`${d.line}:${d.col}: ${d.message}`);
    }
    let s = &result.cst;
    let toks = &result.tokens;
    let Some(graph) = first_child_of_kind(s, 0, onnx::RK_GRAPH) else {
        return Result::Err("a model without a graph");
    };
    let opset = default_opset(&read_opset_imports(s, toks)?);
    let written = read_graph(s, toks, graph)?;
    return Result::Ok(Graph { ..written, nodes: upgraded(written.nodes, opset)?, opset });
}

/// The `(domain, version)` pairs the model's metadata lists under `opset_import`.
fn read_opset_imports(s: &onnx::CstStore, toks: &onnx::TokenStream) -> Result<List<[String, i64]>, String> {
    let mut imports: List<[String, i64]> = [];
    let Some(metadata) = first_child_of_kind(s, 0, onnx::RK_METADATA) else {
        return Result::Ok(imports);
    };
    for let entry of children_of_kind(s, metadata, onnx::RK_META_ENTRY) {
        if first_token_text(s, toks, entry) != "opset_import" {
            continue;
        }
        let value = first_child_of_kind(s, entry, onnx::RK_META_VALUE).unwrap();
        let Some(list) = first_child_of_kind(s, value, onnx::RK_ATOM_LIST) else {
            return Result::Err("opset_import is not a list");
        };
        for let pair of children_of_kind(s, list, onnx::RK_ATOM_PAIR) {
            let atoms = children_of_kind(s, pair, onnx::RK_ATOM);
            if atoms.len() != 2 {
                return Result::Err("an opset_import entry is not `domain : version`");
            }
            let text = first_token_text(s, toks, atoms[1]);
            let Ok(version) = i64::from_str(&text) else {
                return Result::Err(`opset_import holds '${text}' where a version goes`);
            };
            imports.push([quotable_text(s, toks, atoms[0]), version]);
        }
    }
    return Result::Ok(imports);
}

fn read_graph(s: &onnx::CstStore, toks: &onnx::TokenStream, graph: i32) -> Result<Graph, String> {
    let Some(name_node) = first_child_of_kind(s, graph, onnx::RK_QUOTABLE_ID) else {
        return Result::Err("a graph without a name");
    };
    let mut inputs: List<ValueInfo> = [];
    let mut outputs: List<ValueInfo> = [];
    let mut initializers: List<ValueInfo> = [];
    let mut constants = TreeMap::<String, Known>::new();
    let mut nodes: List<Node> = [];
    for let c of children(s, graph) {
        if !s.is_node(c) {
            continue;
        }
        let kind = s.kind(c);
        if kind == onnx::RK_INPUTS {
            inputs = read_value_infos(s, toks, c)?;
        } else if kind == onnx::RK_OUTPUTS {
            outputs = read_value_infos(s, toks, c)?;
        } else if kind == onnx::RK_INITIALIZERS {
            for let vi of children_of_kind(s, c, onnx::RK_VALUE_INFO) {
                let info = read_value_info(s, toks, vi)?;
                if static_extents(&info.rank) matches { None } {
                    return Result::Err(`${info.name}: an initializer's extents are integers`);
                }
                if is_build_time(&info.dtype) {
                    constants[info.name] = read_known(s, toks, vi, &info)?;
                } else {
                    initializers.push(info);
                }
            }
        } else if kind == onnx::RK_NODES {
            nodes = read_nodes(s, toks, c)?;
        }
    }
    return Result::Ok(Graph {
        name: quotable_text(s, toks, name_node),
        inputs: parameters(inputs, &initializers, &constants),
        outputs,
        initializers,
        constants,
        nodes,
    });
}

fn read_value_infos(s: &onnx::CstStore, toks: &onnx::TokenStream, list: i32) -> Result<List<ValueInfo>, String> {
    let mut out: List<ValueInfo> = [];
    for let c of children_of_kind(s, list, onnx::RK_VALUE_INFO) {
        out.push(read_value_info(s, toks, c)?);
    }
    return Result::Ok(out);
}

fn read_value_info(s: &onnx::CstStore, toks: &onnx::TokenStream, vi: i32) -> Result<ValueInfo, String> {
    let Some(type_node) = first_child_of_kind(s, vi, onnx::RK_TYPE) else {
        return Result::Err("a value without a type");
    };
    let Some(name_node) = first_child_of_kind(s, vi, onnx::RK_QUOTABLE_ID) else {
        return Result::Err("a value without a name");
    };
    let name = quotable_text(s, toks, name_node);
    // `seq(...)` / `map(...)` parse as an `ID (` that no `tensorType` follows.
    let Some(tensor) = first_child_of_kind(s, type_node, onnx::RK_TENSOR_TYPE) else {
        return Result::Err(`${name}: only a tensor type is read, not a sequence or a map`);
    };
    let [dtype, rank] = read_tensor_type(s, toks, tensor, &name)?;
    let data = read_constant_data(s, toks, vi, &name, &dtype, &rank)?;
    return Result::Ok(ValueInfo { name, dtype, rank, data });
}

/// A weight's inline elements as the little-endian bytes the protobuf form
/// carries. A build-time tensor's are read into a `Known` instead.
fn read_constant_data(
    s: &onnx::CstStore,
    toks: &onnx::TokenStream,
    vi: i32,
    name: &String,
    dtype: &String,
    rank: &Rank,
) -> Result<Option<ByteList>, String> {
    if is_build_time(dtype) {
        return Result::Ok(null);
    }
    let Some(element) = element_of(dtype) else {
        return Result::Ok(null);
    };
    let Some(texts) = inline_texts(s, toks, vi, name, rank)? else {
        return Result::Ok(null);
    };
    let width = element.width;
    let mut bytes = ByteList::with_capacity(texts.len() * width);
    for let text of texts {
        push_element(&mut bytes, element_bits(name, &text, dtype, width)? as u64, width);
    }
    return Result::Ok(Option::Some(bytes));
}

/// A value's inline elements as text, each as ONNX's parser reads it
/// (`onnx/defs/parser.cc`), or `None` where the value is written without any.
fn inline_texts(
    s: &onnx::CstStore,
    toks: &onnx::TokenStream,
    vi: i32,
    name: &String,
    rank: &Rank,
) -> Result<Option<List<String>>, String> {
    let Some(data) = first_child_of_kind(s, vi, onnx::RK_CONSTANT_DATA) else {
        return Result::Ok(null);
    };
    // Loam takes its weights from the graph or the checkpoint the invocation
    // names, so dropping this would leave a tensor whose data came from nowhere.
    let Some(values) = first_child_of_kind(s, data, onnx::RK_TENSOR_VALUES) else {
        return Result::Err(`${name}: an initializer whose data lives in another file is not read`);
    };
    return Result::Ok(Option::Some(element_texts(s, toks, values, name, rank)?));
}

/// A `tensorValues`'s elements as text, as many as `rank` says.
fn element_texts(
    s: &onnx::CstStore,
    toks: &onnx::TokenStream,
    values: i32,
    name: &String,
    rank: &Rank,
) -> Result<List<String>, String> {
    let Some(extents) = static_extents(rank) else {
        return Result::Err(`${name}: inline values need every extent stated`);
    };
    let elements = children_of_kind(s, values, onnx::RK_TENSOR_ELEM);
    check_element_count(name, elements.len(), &extents)?;
    let mut texts: List<String> = [];
    for let e of elements {
        texts.push(literal_text(toks, first_token(s, e)));
    }
    return Result::Ok(texts);
}

/// An initializer the build reads, as its inline values spell it.
fn read_known(s: &onnx::CstStore, toks: &onnx::TokenStream, vi: i32, info: &ValueInfo) -> Result<Known, String> {
    let Some(texts) = inline_texts(s, toks, vi, &info.name, &info.rank)? else {
        return Result::Err(constant_without_values(&info.name));
    };
    return Result::Ok(known_of(&info.name, &info.dtype, static_extents(&info.rank).unwrap(), texts)?.unwrap());
}

/// Elements written as text, in the type stage 0 computes `dtype` in, or `None`
/// for a type it does not read. ONNX writes a bool as the integer `int32_data` holds.
fn known_of(name: &String, dtype: &String, extents: List<i32>, texts: List<String>) -> Result<Option<Known>, String> {
    if *dtype == "float" {
        let mut values: List<f32> = [];
        for let text of texts {
            let Ok(v) = f32::from_str(&text) else {
                return Result::Err(`${name}: ${text} is not a float`);
            };
            values.push(v);
        }
        return Result::Ok(Option::Some(Known { extents, elements: Elements::Floats(values) }));
    }
    if !is_build_time(dtype) {
        return Result::Ok(null);
    }
    let mut values: List<i64> = [];
    for let text of texts {
        let Ok(v) = i64::from_str(&text) else {
            return Result::Err(`${name}: ${text} is not an integer`);
        };
        values.push(v);
    }
    let elements = if *dtype == "bool" {
        Elements::Bools(values.into_iter().map(|v| v != 0).collect());
    } else {
        Elements::Ints(values);
    };
    return Result::Ok(Option::Some(Known { extents, elements }));
}

/// A tensor attribute, which travels whole as the protobuf reader carries it.
fn read_tensor_attr(s: &onnx::CstStore, toks: &onnx::TokenStream, tensor: i32, name: String) -> Result<Attr, String> {
    let type_node = first_child_of_kind(s, tensor, onnx::RK_TYPE).unwrap();
    let Some(tensor_type) = first_child_of_kind(s, type_node, onnx::RK_TENSOR_TYPE) else {
        return Result::Err(`${name}: only a tensor type is read, not a sequence or a map`);
    };
    let [dtype, rank] = read_tensor_type(s, toks, tensor_type, &name)?;
    let values = first_child_of_kind(s, tensor, onnx::RK_TENSOR_VALUES).unwrap();
    let texts = element_texts(s, toks, values, &name, &rank)?;
    let known = known_of(&name, &dtype, static_extents(&rank).unwrap(), texts)?;
    return Result::Ok(Attr {
        name,
        values: [],
        is_list: false,
        tensor: known,
    });
}

/// An element's bits in `dtype`, `width` bytes wide. ONNX writes a half as the
/// integer its `int32_data` holds, not as a decimal.
fn element_bits(name: &String, text: &String, dtype: &String, width: i32) -> Result<u32, String> {
    if *dtype == "float" {
        let Ok(v) = f32::from_str(text) else {
            return Result::Err(`${name}: ${text} is not a float`);
        };
        return Result::Ok(v.to_bits());
    }
    let Ok(v) = i32::from_str(text) else {
        return Result::Err(`${name}: ${text} is not a ${dtype} bit pattern`);
    };
    return bit_pattern(name, dtype, v, width);
}

/// A literal token's value as text `FromStr` reads: a string without its
/// quotes, and a float with a digit after its point.
fn literal_text(toks: &onnx::TokenStream, token: i32) -> String {
    let text = toks.token_text(token);
    if toks.kind_at(token) == onnx::TK_FLOAT {
        return digit_after_point(&text);
    }
    return unquote(text);
}

/// ONNX's float literal may end its fraction at the point (`1.`, `1.e5`), which
/// `f32::from_str` refuses.
fn digit_after_point(text: &String) -> String {
    let mut spelled = String::with_capacity(text.len() + 1);
    let mut after_point = false;
    for let c of text.chars() {
        if after_point && !c.is_ascii_digit() {
            spelled.push('0');
        }
        spelled.push(c);
        after_point = c == '.';
    }
    if after_point {
        spelled.push('0');
    }
    return spelled;
}

fn read_tensor_type(
    s: &onnx::CstStore,
    toks: &onnx::TokenStream,
    tensor: i32,
    name: &String,
) -> Result<[String, Rank], String> {
    let mut dtype = "";
    let mut saw_bracket = false;
    let mut rank = Rank::Scalar;
    for let c of children(s, tensor) {
        if s.is_token(c) {
            let text = toks.token_text(s.token_index(c));
            if text == "[" {
                saw_bracket = true;
            } else if text != "]" {
                dtype = text;
            }
        } else if s.is_node(c) {
            let mut dims: List<Dim> = [];
            for let d of children_of_kind(s, c, onnx::RK_DIM) {
                dims.push(read_dim(s, toks, d, name)?);
            }
            rank = Rank::Dims(dims);
        }
    }
    if saw_bracket && rank matches { Scalar } {
        rank = Rank::Unranked;
    }
    return Result::Ok([dtype, rank]);
}

fn read_dim(s: &onnx::CstStore, toks: &onnx::TokenStream, dim: i32, tensor: &String) -> Result<Dim, String> {
    for let c of children(s, dim) {
        if s.is_node(c) {
            return Result::Ok(Dim::Symbol(quotable_text(s, toks, c)));
        }
        if s.is_token(c) {
            // The grammar's only tokens here are `?` and `INT`: a name is a node.
            let token = s.token_index(c);
            if toks.kind_at(token) != onnx::TK_INT {
                return Result::Ok(Dim::Unknown);
            }
            let text = toks.token_text(token);
            return match i32::from_str(&text) {
                Ok(n) && n >= 0 => Result::Ok(Dim::Static(n)),
                _ => Result::Err(`${tensor}: dimension ${text}`),
            };
        }
    }
    panic("dim: no child");
}

fn read_nodes(s: &onnx::CstStore, toks: &onnx::TokenStream, nodes: i32) -> Result<List<Node>, String> {
    let mut out: List<Node> = [];
    for let c of children_of_kind(s, nodes, onnx::RK_NODE) {
        out.push(read_node(s, toks, c)?);
    }
    return Result::Ok(out);
}

fn read_node(s: &onnx::CstStore, toks: &onnx::TokenStream, node: i32) -> Result<Node, String> {
    let mut op = "";
    let mut outputs: List<String> = [];
    let mut inputs: List<String> = [];
    let mut attrs: List<Attr> = [];
    for let c of children(s, node) {
        if !s.is_node(c) {
            continue;
        }
        let kind = s.kind(c);
        if kind == onnx::RK_QUALIFIED_ID {
            op = joined_text(s, toks, c);
        } else if kind == onnx::RK_OUTPUT_NAMES {
            outputs = read_names(s, toks, c);
        } else if kind == onnx::RK_INPUT_NAMES {
            inputs = read_names(s, toks, c);
        } else if kind == onnx::RK_ATTRS {
            attrs = read_attrs(s, toks, c)?;
        }
    }
    return Result::Ok(Node { op, outputs, inputs, attrs });
}

fn read_names(s: &onnx::CstStore, toks: &onnx::TokenStream, list: i32) -> List<String> {
    let mut out: List<String> = [];
    for let c of children_of_kind(s, list, onnx::RK_QUOTABLE_ID) {
        out.push(quotable_text(s, toks, c));
    }
    return out;
}

fn read_attrs(s: &onnx::CstStore, toks: &onnx::TokenStream, list: i32) -> Result<List<Attr>, String> {
    let mut out: List<Attr> = [];
    for let c of children_of_kind(s, list, onnx::RK_ATTR) {
        out.push(read_attr(s, toks, c)?);
    }
    return Result::Ok(out);
}

fn read_attr(s: &onnx::CstStore, toks: &onnx::TokenStream, attr: i32) -> Result<Attr, String> {
    let name = first_token_text(s, toks, attr);
    let Some(value) = first_child_of_kind(s, attr, onnx::RK_ATTR_VALUE) else {
        return Result::Err(`${name}: an attribute without a value`);
    };
    if let Some(list) = first_child_of_kind(s, value, onnx::RK_ATTR_VALUE_LIST) {
        let mut values: List<String> = [];
        for let c of children_of_kind(s, list, onnx::RK_SINGLE_ATTR_VALUE) {
            values.push(single_attr_text(s, toks, c, &name)?);
        }
        return Result::Ok(Attr { name, values, is_list: true });
    }
    let Some(single) = first_child_of_kind(s, value, onnx::RK_SINGLE_ATTR_VALUE) else {
        return Result::Err(`${name}: an attribute without a value`);
    };
    if let Some(tensor) = first_child_of_kind(s, single, onnx::RK_TENSOR_CONSTANT) {
        return read_tensor_attr(s, toks, tensor, name);
    }
    let text = single_attr_text(s, toks, single, &name)?;
    return Result::Ok(Attr {
        name,
        values: [text],
        is_list: false,
    });
}

fn single_attr_text(
    s: &onnx::CstStore,
    toks: &onnx::TokenStream,
    single: i32,
    attr_name: &String,
) -> Result<String, String> {
    for let c of children(s, single) {
        if s.is_token(c) {
            return Result::Ok(literal_text(toks, s.token_index(c)));
        }
        if s.is_node(c) {
            if first_child_of_kind(s, single, onnx::RK_TENSOR_CONSTANT) matches { Some(_) } {
                return Result::Err(`${attr_name}: a list of tensors is not read`);
            }
            return Result::Err(`${attr_name}: a subgraph attribute is not read`);
        }
    }
    panic("singleAttrValue: no child");
}

/// A `quotableId`'s text, with a quoted name's quotes taken off. An exporter's
/// names carry `/` and `.`, so most of them arrive quoted.
fn quotable_text(s: &onnx::CstStore, toks: &onnx::TokenStream, node: i32) -> String {
    return unquote(first_token_text(s, toks, node));
}

/// The first terminal under a node. Each caller names a rule that starts with
/// one, so a node with none is a grammar that moved under the reader.
fn first_token_text(s: &onnx::CstStore, toks: &onnx::TokenStream, node: i32) -> String {
    return toks.token_text(first_token(s, node));
}

fn first_token(s: &onnx::CstStore, node: i32) -> i32 {
    for let mut c = s.first_child(node); c >= 0; c = s.next_sibling(c) {
        if s.is_token(c) {
            return s.token_index(c);
        }
    }
    panic(`${s.kind(node)}: expected a terminal`);
}

/// Every token under a node, run together. `qualifiedId` is `ID ('.' ID)*`, so
/// this is the operator's domain-qualified name.
fn joined_text(s: &onnx::CstStore, toks: &onnx::TokenStream, node: i32) -> String {
    let mut out = "";
    for let c of children(s, node) {
        if s.is_token(c) {
            out.push_str(&toks.token_text(s.token_index(c)));
        }
    }
    return out;
}

fn unquote(text: String) -> String {
    let view = text.as_str_slice();
    if view.len() >= 2 && view.slice(0, 1) == "\"" {
        return view.slice(1, view.len() - 1).to_string();
    }
    return text;
}

fn children(s: &onnx::CstStore, node: i32) -> List<i32> {
    let mut out: List<i32> = [];
    for let mut c = s.first_child(node); c >= 0; c = s.next_sibling(c) {
        out.push(c);
    }
    return out;
}

fn children_of_kind(s: &onnx::CstStore, node: i32, kind: onnx::NodeKind) -> List<i32> {
    let mut out: List<i32> = [];
    for let mut c = s.first_child(node); c >= 0; c = s.next_sibling(c) {
        if s.is_node(c) && s.kind(c) == kind {
            out.push(c);
        }
    }
    return out;
}

fn first_child_of_kind(s: &onnx::CstStore, node: i32, kind: onnx::NodeKind) -> Option<i32> {
    let found = s.find_child(node, kind);
    if found < 0 {
        return null;
    }
    return Option::Some(found);
}
