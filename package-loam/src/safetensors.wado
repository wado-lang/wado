//! A safetensors file: a length-prefixed JSON header naming each tensor's
//! element type, shape and byte range, then the payloads back to back.

use { from_string, to_string, to_string_pretty } from "core:json";
use { HashMap, HashSet } from "core:collections";
use { Deserialize } from "core:serde";
use fs from "core:fs";
use { Graph, ValueInfo, element_of, push_element, static_extents } from "./graph.wado";
use {
    Checkpoint,
    Expected,
    HeaderEntry,
    LoadError,
    METADATA_KEY,
    read_checkpoint,
    shard_not_given,
} from "./runtime/checkpoint.wado";
use { element_count } from "./runtime/tensor.wado";
use { Shape } from "./shape.wado";

/// The initializer `vi`, whose axes stage 0 gave as `shape`, as a checkpoint
/// must hold it.
pub fn expected(vi: &ValueInfo, shape: &Shape) -> Expected {
    let element = element_of(&vi.dtype).unwrap();
    // ONNX states an initializer's extents as integers, and both readers hold to it.
    let extents = static_extents(&vi.rank).unwrap();
    return Expected {
        tensor: vi.name,
        dtype: element.stored,
        axes: shape.axes.into_iter().map(|axis| axis.name).collect(),
        elements: element_count(&extents),
        extents,
        width: element.width,
    };
}

/// Whether `checkpoint` holds every initializer the graph carries no data for,
/// as the build compiles it.
pub fn check_checkpoint(
    graph: &Graph,
    shapes: &HashMap<String, Shape>,
    checkpoint: &Checkpoint,
) -> Result<(), LoadError> {
    for let vi of &graph.initializers {
        if vi.data matches { None } {
            checkpoint.range(&expected(vi, &shapes.get(vi.name).unwrap()))?;
        }
    }
    return Result::Ok(());
}

/// A checkpoint file named by its path, and its header, the payloads unread.
pub struct CheckpointFile {
    pub path: String,
    pub header: ByteList,
}

/// Why the shards given do not supply the graph, and the file to blame.
pub struct ShardRefusal {
    pub path: String,
    pub reason: String,
}

/// Whether `shards` hold every initializer the graph carries no data for, each
/// in the shard `placed` names, as the build compiles it. `index` is the index
/// read from `index_path`, and `placed` what `placement` answers from it.
pub fn check_shards(
    graph: &Graph,
    shapes: &HashMap<String, Shape>,
    index_path: &String,
    index: &HashMap<String, String>,
    placed: &HashMap<String, String>,
    shards: List<CheckpointFile>,
) -> Result<(), ShardRefusal> {
    let mut named = HashSet::<String>::new();
    for let [_, shard] of index.entries() {
        named.insert(*shard);
    }
    let mut paths = HashMap::<String, String>::new();
    let mut headers = HashMap::<String, Checkpoint>::new();
    for let shard of shards {
        // An index names a shard by its file name. A path that was read names
        // a file, so it has one.
        let name = fs::file_name(&shard.path).unwrap().to_string();
        if !named.contains(name) {
            return Result::Err(ShardRefusal { path: shard.path, reason: "the index names no shard of this file name" });
        }
        if !paths.try_insert(name, shard.path) {
            return Result::Err(ShardRefusal { path: shard.path, reason: "another shard has this file name" });
        }
        headers[name] = read_checkpoint(&shard.header).map_err(|e| ShardRefusal { path: shard.path, reason: `${e}` })?;
    }
    for let vi of &graph.initializers {
        if vi.data matches { Some(_) } {
            continue;
        }
        let shard = placed[vi.name];
        let Some(header) = headers.get_ref_str(&shard) else {
            return Result::Err(ShardRefusal { path: *index_path, reason: `${shard_not_given(&vi.name, &shard)}` });
        };
        header.range(&expected(vi, &shapes.get(vi.name).unwrap())).map_err(
            |e| ShardRefusal { path: paths[shard], reason: `${e}` },
        )?;
    }
    return Result::Ok(());
}

/// The shard `index` places each initializer the graph carries no data for in.
pub fn placement(graph: &Graph, index: &HashMap<String, String>) -> Result<HashMap<String, String>, LoadError> {
    let mut placed = HashMap::<String, String>::new();
    for let vi of &graph.initializers {
        if vi.data matches { Some(_) } {
            continue;
        }
        let Some(shard) = index.get(vi.name) else {
            return Result::Err(LoadError { reason: `${vi.name}: the index places it in no shard` });
        };
        placed[vi.name] = shard;
    }
    return Result::Ok(placed);
}

/// A sharded checkpoint's index, `model.safetensors.index.json` as Hugging Face
/// writes it: the file name of the shard holding each tensor.
struct Index {
    weight_map: HashMap<String, String>,
}

impl Deserialize for Index;

/// The shard holding each tensor, by name, as the index `text` places it. A
/// shard sits beside its index, so the index names each by a file name alone.
pub fn read_index(text: &String) -> Result<HashMap<String, String>, String> {
    let index = match from_string::<Index>(text) {
        Ok(index) => index.weight_map,
        Err(e) => {
            return Result::Err(`not a safetensors index: ${e}`);
        },
    };
    for let [tensor, shard] of index.entries() {
        if shard.contains("/") {
            return Result::Err(`${tensor}: the index places it in ${shard}, which is not a file name`);
        }
    }
    return Result::Ok(index);
}

/// `tensors` in order, in shards of at most `max_bytes` of payload each: a
/// shard closes before the tensor that would take it past the size, and a
/// tensor larger than a shard has one of its own.
pub fn shard_tensors(tensors: List<StoredTensor>, max_bytes: i64) -> List<List<StoredTensor>>
    contract max_bytes > 0
{
    let mut shards: List<List<StoredTensor>> = [];
    let mut open: List<StoredTensor> = [];
    let mut held: i64 = 0;
    for let t of tensors {
        let size = t.data.len() as i64;
        if !open.is_empty() && held + size > max_bytes {
            shards.push(open);
            open = [];
            held = 0;
        }
        open.push(t);
        held += size;
    }
    if !open.is_empty() {
        shards.push(open);
    }
    return shards;
}

/// The file name of shard `i`, counted from 0, of `count`, after `stem`.
pub fn shard_name(stem: &String, i: i32, count: i32) -> String {
    return `${*stem}-${i + 1:05}-of-${count:05}.safetensors`;
}

/// The index Hugging Face writes beside a sharded checkpoint.
struct WrittenIndex {
    metadata: IndexMetadata,
    weight_map: HashMap<String, String>,
}

struct IndexMetadata {
    total_size: i64,
}

/// The index of `shards`, each a file name and the tensors it holds, as
/// Hugging Face writes one.
pub fn write_index(shards: &List<[String, List<StoredTensor>]>) -> String {
    let mut index = WrittenIndex {
        metadata: IndexMetadata { total_size: 0 },
        weight_map: HashMap::new(),
    };
    for let [name, tensors] of *shards {
        for let t of tensors {
            index.metadata.total_size += t.data.len() as i64;
            index.weight_map[t.name] = name;
        }
    }
    return to_string_pretty(&index, Option::Some('\n')).unwrap();
}

/// One tensor to write, its elements already little-endian.
pub struct StoredTensor {
    pub name: String,
    pub dtype: String,
    pub shape: List<i64>,
    pub data: ByteList,
}

/// `graph` with every weight it carries moved out, and those weights as a
/// checkpoint holds them, under the graph's names. A weight named `METADATA_KEY`
/// has no checkpoint entry, so it stays in the graph.
pub fn split_weights(graph: Graph) -> [Graph, List<StoredTensor>] {
    let mut kept: List<ValueInfo> = [];
    let mut stored: List<StoredTensor> = [];
    for let vi of graph.initializers {
        if let Some(data) = vi.data && vi.name != METADATA_KEY {
            let shape: List<i64> = static_extents(&vi.rank).unwrap().into_iter().map(|e| e as i64).collect();
            stored.push(StoredTensor { name: vi.name, dtype: element_of(&vi.dtype).unwrap().stored, shape, data });
            kept.push(ValueInfo { ..vi, data: null });
        } else {
            kept.push(vi);
        }
    }
    return [
        Graph { ..graph, initializers: kept },
        stored,
    ];
}

/// The file holding `tensors` in order. The header is padded with spaces to a
/// multiple of 8 bytes, as the format recommends, so each payload is aligned.
pub fn write_safetensors(tensors: &List<StoredTensor>) -> ByteList {
    let mut header = HashMap::<String, HeaderEntry>::new();
    let mut offset: i64 = 0;
    for let t of *tensors {
        let end = offset + t.data.len() as i64;
        header[t.name] = HeaderEntry {
            dtype: t.dtype,
            shape: t.shape,
            data_offsets: [offset, end],
        };
        offset = end;
    }
    let mut text = to_string(&header).unwrap();
    while text.len() % 8 != 0 {
        text.push(' ');
    }
    let size = 8 + text.len() as i64 + offset;
    assert size <= i32::MAX as i64;
    let mut out = ByteList::with_capacity(size as i32);
    push_element(&mut out, text.len() as u64, 8);
    out.extend_from_slice(text.as_bytes() as Slice<u8>);
    for let t of *tensors {
        out.extend(&t.data);
    }
    return out;
}
