//! The Wado a checked graph becomes: one marker type per axis, a `build` that
//! adds the operations the graph's operators lower to, and a `compute` that
//! runs it from inputs on the host.

use { HashMap, HashSet, TreeMap } from "core:collections";
use { Deserialize } from "core:serde";
use { CodeWriter, FnSpec, ImplSpec, ParamSpec, StructSpec, Vis, byte_string_literal, wado } from "lib:wadopoet";
use { ExpertPlan } from "./emit_experts.wado";
use { built_call, built_split } from "./emit_ops.wado";
use {
    Carrier,
    Grown,
    Names,
    Operands,
    Symbols,
    axis_list,
    capacity_key,
    f32_literal,
    number_literal,
    symbol_carriers,
    symbol_key,
} from "./emit_symbols.wado";
use { Extent } from "./extent.wado";
use {
    BACKEND_PARAM,
    CACHE,
    CHOSEN,
    DECODE,
    DECODE_ROWS,
    DECODED,
    DECODED_TYPE,
    LEAST_EXTENTS,
    LENGTHS,
    MODEL,
    OUTPUTS,
    PARAMS,
    PASSED,
    RECORDED_DECODED,
    RECORDED,
    REQUESTS,
    RUNTIME_NAMES,
    SOURCE_PARAM,
} from "./idents.wado";
use { padding } from "./pad.wado";
use { Condition, Poly, equalities } from "./poly.wado";
use { Axis, Shape } from "./shape.wado";
use {
    Elements,
    GROUP_QUERY_ATTENTION,
    Graph,
    InPlace,
    Known,
    Node,
    ValueInfo,
    element_of,
    is_float,
    settled,
} from "./graph.wado";
use { IfBranch, SpelledAttention, branches, branches_of, is_alias, lowerings } from "./lowering.wado";
use { Expected } from "./runtime/checkpoint.wado";
