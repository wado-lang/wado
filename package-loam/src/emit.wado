/// The initializers `Params` holds as they are: all but those pools hold.
fn held_initializers(graph: &Graph, experts: &ExpertPlan) -> List<ValueInfo> {
    return graph.initializers.into_iter().filter(|vi| !experts.is_pooled(&vi.name)).collect();
}

/// The initializers pools hold, each by its position among them all.
fn pooled_initializers(graph: &Graph, experts: &ExpertPlan) -> List<[i32, ValueInfo]> {
    return graph.initializers.into_iter().enumerate().filter(|p| experts.is_pooled(&p.1.name)).collect();
}

/// The pools' layouts where the graph carries every pooled initializer.
global CARRIED_LAYOUTS: String = "expert_layouts(|at| Result::Ok(ExpertBytes::Held(embedded_data(at)))).unwrap()";

/// `expert_layouts`: each pool layout, every layer's expert weights where its
/// argument places the initializer at each position. The pools follow the
/// held initializers and `kept` in `Params`.
fn emit_expert_layouts(w: &mut CodeWriter, graph: &Graph, checked: &Checked, kept: &List<String>, experts: &ExpertPlan) {
    if experts.groups.is_empty() {
        return;
    }
    let position = |name: &String| graph.initializers.into_iter().position(|vi| vi.name == *name).unwrap();
    let mut first = held_initializers(graph, experts).len() + kept.len();
    let mut layouts: List<String> = [];
    for let group of &experts.groups {
        let mut layers: List<String> = [];
        let mut pools: List<String> = [];
        for let layer of &group.layers {
            let positions: List<String> = (first..<first + layer.len()).map(|i| `${i}`).collect();
            pools.push(`[${positions.join(", ")}]`);
            first += layer.len();
            let mut stored: List<String> = [];
            for let weight of layer {
                let at = position(weight);
                let extents = static_extents(&checked.shapes[*weight]).unwrap();
                let slice: List<String> = extents[1..<extents.len()].into_iter().map(|e| `${e}`).collect();
                stored.push(
                    `StoredExperts { bytes: placed(${at})?, kind: ElementKind::${any_case(
                        &checked.primitives[*weight],
                    )}, extents: [${slice.join(", ")}] }`,
                );
            }
            layers.push(`[${stored.join(", ")}]`);
        }
        let steps: List<String> = group.steps.into_iter().map(|s| `${s}`).collect();
        let x = static_extents(&checked.shapes[group.pools()[0]]).unwrap()[0];
        layouts.push(
            `ExpertLayout { weights: [${pools.join(", ")}], layers: [${layers.join(", ")}], steps: [${steps.join(
                ", ",
            )}], experts: ${x} }`,
        );
    }
    w.blank();
    FnSpec::new("expert_layouts")
        .set_doc(
            "Each layout of pools, every layer's expert weights where `placed` finds\nthe initializer at each position.",
        )
        .add_param({ name: "placed", type: "fn(i32) -> Result<ExpertBytes, LoadError> with _" })
        .set_return_type("Result<List<ExpertLayout>, LoadError>")
        .add_effect("_")
        .emit(w, |w| w.line(`return Result::Ok([${layouts.join(", ")}]);`));
}

/// A tensor as the backend holds it.
fn prepared_type(checked: &Checked, tensor: &String) -> String {
    return `${BACKEND_PARAM}::${tensor_type(checked, tensor)}`;
}

/// Whether some initializer's data is left to a checkpoint.
fn loads_weights(graph: &Graph) -> bool {
    for let vi of &graph.initializers {
        if vi.data matches { null } {
            return true;
        }
    }
    return false;
}

/// `Params::embedded` where the graph carries every initializer's data, and
