//! The Wado a checked graph becomes: one marker type per axis, the kernels
//! the graph's operators lower to, and a `forward` that runs them in order.

use { HashMap, HashSet } from "core:collections";
use { CodeWriter, FnSpec, ImplSpec, StructSpec, Vis, byte_string_literal, wado } from "lib:wadopoet";
use { Extent, Solved, solved } from "./extent.wado";
use {
    BACKEND_PARAM,
    CACHE,
    CHECKPOINT_PARAM,
    KEPT,
    LENGTHS,
    MAP,
    OUTPUTS,
    PARAMS,
    PASSED,
    PREPARED,
    RUNTIME_NAMES,
    is_bound,
    module_idents,
} from "./idents.wado";
use { padding } from "./pad.wado";
use { Lowers, Op, Poly } from "./poly.wado";
use { Axes, Axis, Shape } from "./shape.wado";
use {
    Elements,
    GROUP_QUERY_ATTENTION,
    Graph,
    InPlace,
    KERNEL_ELEMENT,
    Node,
    case_named,
    element_of,
    is_binary_elementwise,
    settled,
    trailing_axes,
} from "./graph.wado";
use { fill_of } from "./fold.wado";
use {
    IfBranch,
    Lowering,
    Plan,
    Spread,
    branch_plan,
    branches,
    branches_of,
    is_alias,
    lowering_of,
    plan,
    reduces_rows,
    row_fold,
    selects_floats,
} from "./plan.wado";
use { Expected } from "./runtime/checkpoint.wado";
use { BinaryOp, Expr, Step, UnaryOp, constant as constant_expr, operand as operand_expr } from "./runtime/tensor.wado";
use { expected } from "./safetensors.wado";
use {
    ATTENTION_BIAS,
    Checked,
    Cut,
    ROTARY_COS,
    ROTARY_SIN,
    attention_options,
    concat_axis,
    conv_group,
    gather_axis,
    gemm_options,
    has_bias,
    is_reduction,
    named_present,
    range_bounds,
    reduced_axes,
    slice_cuts,
    softmax_lane,
    split_axis,
    split_parts,
    transpose_perm,
    window_of,
} from "./infer.wado";

/// A boundary tensor of an element type no kernel holds.
pub struct UnmappedDtype {
    pub tensor: String,
    pub dtype: String,
}

/// Two tensor names that become one Wado identifier.
pub struct NameCollision {
    pub tensor: String,
    pub other: String,
    pub ident: String,
}

pub variant EmitError {
    Dtype(UnmappedDtype),
    Collision(NameCollision),
    /// A graph with nothing for `forward` to return.
    NoOutput,
    /// A symbol the run needs the value of, which no input's axis carries.
    Unbound(String),
    /// A value the run computes in `i64`, which some input carries past it.
    Wide(Poly),
}

impl Display for UnmappedDtype {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(`${self.tensor}: no kernel holds ${self.dtype}`);
    }
}

impl Display for NameCollision {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(`${self.tensor} and ${self.other} both name \`${self.ident}\``);
    }
}

impl Display for EmitError {
    fn fmt(&self, f: &mut Formatter) {
        match self {
            Dtype(e) => e.fmt(f),
            Collision(e) => e.fmt(f),
            NoOutput => f.write_str("the graph declares no output for `forward` to return"),
            Unbound(symbol) => {
                f.write_str(`${Poly::symbol(symbol)}: the run needs this length, and no input's axis gives it`);
            },
            Wide(p) => f.write_str(`${p}: the run computes this in i64, and some input carries it past`),
        }
    }
}

impl Error for UnmappedDtype {
}

impl Error for NameCollision {
}

impl Error for EmitError {
}

/// Where `Prepared::load` reads the weights the graph leaves to it: a
/// checkpoint in one file, each in the shard an index places it in, or one
/// file at the byte ranges the build found them at.
pub variant Placement {
    File,
    Shards(HashMap<String, String>),
    InPlace(InPlace),
}

/// The generated module's source, importing the runtime from the package spec
/// `runtime`. Every axis the graph mentions becomes a marker type, so two
/// tensors sharing an axis share one type.
pub fn emit(
    graph: &Graph,
    checked: &Checked,
    runtime: &String,
    fuse: bool = true,
    placement: Placement = Placement::File,
) -> Result<String, EmitError> {
    let shapes = &checked.shapes;
    if let Shards(placed) = &placement {
        for let vi of &graph.initializers {
            assert vi.data matches { Some(_) } || placed.contains_key(vi.name), "a sharded placement must place every weight the graph leaves to the checkpoint";
        }
    }
    if let InPlace(in_place) = &placement {
        for let vi of &graph.initializers {
            assert vi.data matches { Some(_) } || in_place.ranges.contains_key(vi.name), "weights left in place must each have a range";
        }
    }
    if graph.outputs.is_empty() {
        builtin::cold_path();
        return Result::Err(EmitError::NoOutput);
    }
    let held = boundary_elements(graph)?;

    let mut w = CodeWriter::with_capacity(8192);
    w.line(`//! Generated by Loam from the ONNX graph \`${graph.name}\`.`);
    w.line("//! Each axis is a marker type, so two tensors that share an axis");
    w.line("//! share the type that names it.");
    w.blank();
    w.line("use {");
    for let name of RUNTIME_NAMES {
        w.line(`    ${name},`);
    }
    w.line(wado`} from "${*runtime}";`);
    // Only a sharded `load` names the map.
    let imports_map = placement matches { Shards(_) } && loads_weights(graph);
    if imports_map {
        w.line(`use { ${MAP} } from "core:collections";`);
    }
    w.blank();

    let axes = axis_names(graph, checked);
    let scalars = scalar_literals(checked);
    let literals = kernel_literals(graph, checked, &scalars);
    let built = graph_literals(graph, checked);
    let carriers = symbol_carriers(graph, shapes);
    let mut spelled = literals.spelled;
    spelled.extend(&built.spelled);
    let names = Names::of(graph, checked, &spelled, &axes, &carriers, imports_map)?;
    let fixed = boundary_extents(graph, shapes);
    for let axis of axes {
        StructSpec::new(axis, Vis::Pub).emit(&mut w);
        if let Some(extent) = fixed.get(axis) {
            ImplSpec::new(axis).emit_begin(&mut w);
            w.line(`pub const EXTENT: i32 = ${extent};`);
            w.end();
        }
    }

    let kept = KeptLiterals {
        kernels: kept_literals(&literals, checked),
        graph: kept_literals(&built, checked),
    };
    let decided = plan(graph, checked, fuse);
    let rhs = decided.rhs;
    let together = Together::of(graph, &decided);
    emit_weights(&mut w, graph, checked, &names, &held, &kept, &rhs, &together, &placement);
    let exprs = Operands {
        values: HashMap::<String, String>::new(),
        scalars,
        rhs,
        paired: together.paired,
    };
    let crossing = Crossing::of(graph, cache_pairs(graph));
    let held_symbols = Symbols::of(&carriers, &names, |input, axis| `backend.extents_of(${*input})[${axis}]`);
    emit_forward(
        &mut w,
        graph,
        checked,
        &decided,
        &names,
        &held,
        exprs,
        &literals,
        &kept.kernels,
        held_symbols,
        fuse,
        &crossing,
    )?;
    // A length is padded where no node refuses it and an input carries it.
    let padded: List<String> = padding(graph, checked).into_iter().filter(|j| j.refused matches { None }
        && carriers.into_iter().any(|c| c.solved.symbol == j.symbol)).map(|j| j.symbol).collect();
    let read = emit_build(
        &mut w,
        graph,
        checked,
        &decided,
        &names,
        &built,
        &kept.graph,
        held_symbols.padded(&padded),
        &crossing,
    )?;
    if !crossing.has_cache() {
        let host_symbols = Symbols::of(&carriers, &names, |input, axis| `${*input}.extents[${axis}]`);
        emit_compute(&mut w, graph, checked, &names, &held, &carriers, host_symbols, &padded, &read, &crossing)?;
    }
    return Result::Ok(w.to_string());
}

/// The length of each axis that every input, output and weight naming it fixes
/// to one, which the caller then writes as the axis's `EXTENT` rather than a
/// number. A weight's extents are its checkpoint header's, read at build time.
fn boundary_extents(graph: &Graph, shapes: &HashMap<String, Shape>) -> HashMap<String, i32> {
    let mut fixed = HashMap::<String, i32>::new();
    let mut open = HashSet::<String>::new();
    for let declared of [&graph.inputs, &graph.outputs, &graph.initializers] {
        for let vi of *declared {
            for let axis of shapes.get(vi.name).unwrap().axes {
                let Static(extent) = axis.extent else {
                    open.insert(axis.name);
                    continue;
                };
                if !fixed.try_insert(axis.name, extent) && fixed[axis.name] != extent {
                    open.insert(axis.name);
                }
            }
        }
    }
    for let name of open {
        fixed.remove(name);
    }
    return fixed;
}

/// Each past input and the present output it pairs with, by the names Hugging
/// Face's exporters give them: `past<rest>` pairs with `present<rest>`, but
/// `past_key_values.<rest>` with `present.<rest>`. A past no present pairs
/// with stays an input, as a decoder's encoder keys or `past_sequence_length`
/// do, and a present no past pairs with stays an output.
fn cache_pairs(graph: &Graph) -> List<[String, String]> {
    let outputs: List<String> = graph.outputs.into_iter().map(|vi| vi.name).collect();
    let mut pairs: List<[String, String]> = [];
    for let vi of &graph.inputs {
        let past = vi.name;
        if !past.starts_with("past") {
            continue;
        }
        let rest = past.strip_prefix("past_key_values.").map(|r| `.${r}`).unwrap_or(past.substr_bytes(4, past.len()));
        let present = `present${rest}`;
        if outputs.contains(&present) {
            pairs.push([past, present]);
        }
    }
    return pairs;
}

/// What each boundary tensor is held in, and where an element type no kernel
/// reaches stops the build. A node's own output is held as it is computed.
fn boundary_elements(graph: &Graph) -> Result<HashMap<String, String>, EmitError> {
    let mut held = HashMap::<String, String>::new();
    for let declared of [&graph.inputs, &graph.initializers, &graph.outputs] {
        for let vi of *declared {
            let Some(element) = element_of(&vi.dtype) else {
                builtin::cold_path();
                return Result::Err(EmitError::Dtype(UnmappedDtype {
                    tensor: vi.name,
                    dtype: vi.dtype,
                }));
            };
            held[vi.name] = element.primitive;
        }
    }
    return Result::Ok(held);
}

/// Every identifier the generated module declares, minted from one set: the
/// axes, then each tensor name sanitized. Two that collide stop the build.
struct Names {
    idents: HashMap<String, String>,
    reserved: HashSet<String>,
}

impl Names {
    fn of(
        graph: &Graph,
        checked: &Checked,
        literals: &List<String>,
        axes: &List<String>,
        carriers: &List<Carrier>,
        imports_map: bool,
    ) -> Result<Names, EmitError> {
        let mut reserved = module_idents();
        if imports_map {
            reserved.insert(MAP);
        }
        for let axis of *axes {
            assert !is_bound(&reserved, &axis), "infer names an axis past every name the module declares";
            reserved.insert(axis);
        }
        let mut tensors: List<String> = [];
        for let declared of [&graph.inputs, &graph.initializers] {
            for let vi of *declared {
                tensors.push(vi.name);
            }
        }
        scope_tensors(&mut tensors, graph, checked, literals);
        for let c of carriers {
            tensors.push(symbol_key(&c.solved.symbol));
            tensors.push(capacity_key(&c.solved.symbol));
        }
        // Every symbol of an input's axes, of which `Cache::empty` takes the
        // ones a past leaves open.
        for let vi of &graph.inputs {
            for let axis of checked.shapes[vi.name].axes {
                for let symbol of axis.extent.poly().symbols() {
                    tensors.push(symbol_key(&symbol));
                }
            }
        }
        // In first-seen order, each tensor once.
        let mut sanitized = HashMap::<String, String>::new();
        for let tensor of tensors {
            if !sanitized.contains_key(tensor) {
                sanitized[tensor] = sanitize(&tensor);
            }
        }
        let mut claimed = HashSet::<String>::new();
        for let [_, ident] of sanitized.entries() {
            claimed.insert(*ident);
        }
        let mut names = Names {
            idents: HashMap::<String, String>::new(),
            reserved,
        };
        let mut taken = HashMap::<String, String>::new();
        for let [tensor, ident] of sanitized.entries() {
            names.take(&mut taken, tensor, *ident, &claimed)?;
        }
        return Result::Ok(names);
    }

    /// Mint `tensor`'s identifier from its sanitized form, `ident`. One the
    /// generated module already binds is renamed past it, past every form some
    /// tensor sanitizes to, and past every identifier taken before, so the
    /// renaming takes no other tensor's.
    fn take(
        &mut self,
        taken: &mut HashMap<String, String>,
        tensor: &String,
        ident: String,
        claimed: &HashSet<String>,
    ) -> Result<(), EmitError> {
        let mut ident = ident;
        if is_bound(&self.reserved, &ident) {
            ident = `${ident}_`;
            while is_bound(&self.reserved, &ident) || claimed.contains(ident) || taken.contains_key(ident) {
                ident = `${ident}_`;
            }
        }
        if let Some(other) = taken.get(ident) {
            builtin::cold_path();
            return Result::Err(EmitError::Collision(NameCollision {
                tensor: *tensor,
                other,
                ident,
            }));
        }
        taken[ident] = *tensor;
        self.idents[*tensor] = ident;
        return Result::Ok(());
    }

    fn get(&self, tensor: &String) -> String {
        return self.idents.get(*tensor).unwrap();
    }
}

/// The tensors one scope computes and spells, then each branch's. A tensor
/// two branches both name is one identifier, bound in each branch's block.
fn scope_tensors(tensors: &mut List<String>, graph: &Graph, checked: &Checked, literals: &List<String>) {
    for let node of &graph.nodes {
        for let output of node.outputs {
            if !checked.known.contains_key(output) {
                tensors.push(output);
            }
        }
    }
    tensors.extend(literals);
    for let [branch_graph, branch] of branches_of(graph, checked) {
        let mut spelled = kernel_literals(&branch_graph, &branch, &scalar_literals(&branch)).spelled;
        spelled.extend(&graph_literals(&branch_graph, &branch).spelled);
        scope_tensors(tensors, &branch_graph, &branch, &spelled);
    }
}

/// The backend parameter declared with its kind and bound: a backend may own
/// device resources.
global BACKEND_BOUND: String = `affine ${BACKEND_PARAM}: Backend`;

/// The same parameter as a graph `build` adds its operations to.
global GRAPH_BOUND: String = `affine ${BACKEND_PARAM}: Graph`;

/// The same parameter where code serves the kernels and the graph alike:
/// `Cache`, `Passed` and `Kept`'s functions.
global HOLDS_BOUND: String = `affine ${BACKEND_PARAM}: Holds`;

/// `Prepared` over the backend.
global PREPARED_TYPE: String = `${PREPARED}<${BACKEND_PARAM}>`;

/// Which entry a struct of prepared weights serves: the kernels' `pass`, which
/// reads `Prepared`, or the graph's `build`, which reads `Params`.
enum Holder {
    Kernels,
    Built,
}

impl Holder {
    fn name(&self) -> String {
        return match *self {
            Kernels => PREPARED,
            Built => PARAMS,
        };
    }

    fn bound(&self) -> String {
        return match *self {
            Kernels => BACKEND_BOUND,
            Built => GRAPH_BOUND,
        };
    }

    fn ty(&self) -> String {
        return `${self.name()}<${BACKEND_PARAM}>`;
    }

    /// The function that computes a pass through what this holds.
    fn entry(&self) -> String {
        return match *self {
            Kernels => "pass",
            Built => "build",
        };
    }
}

/// The folded tensors each entry reads from its weights' struct rather than
/// building them per pass. `Kept` holds both.
struct KeptLiterals {
    kernels: List<String>,
    graph: List<String>,
}

impl KeptLiterals {
    fn of(&self, holder: Holder) -> List<String> {
        return match holder {
            Kernels => self.kernels,
            Built => self.graph,
        };
    }

    /// Each kept tensor once, the kernels' first.
    fn all(&self) -> List<String> {
        let mut all = self.kernels;
        for let tensor of self.graph {
            if !all.contains(&tensor) {
                all.push(tensor);
            }
        }
        return all;
    }
}

/// An ONNX tensor name as a Wado identifier: exporters write `/` and `.` into
/// one, and a name may start with a digit.
fn sanitize(name: &String) -> String {
    let mut out = String::with_capacity(name.len() + 1);
    for let c of name.chars() {
        if c.is_ascii_alphanumeric() || c == '_' {
            out.push(c);
        } else {
            out.push('_');
        }
    }
    let Some(first) = out.chars().next() else {
        return "t_";
    };
    if first.is_ascii_alphabetic() || first == '_' {
        return out;
    }
    return `t_${out}`;
}

/// The graph's initializers three times: `Weights` on the host as the graph
/// holds them; `Prepared`, which `forward` reads, as the backend's kernels
/// compute with them; and `Params`, which `build` reads, each a tensor of the
/// graph. `Prepared` and `Params` hold the `kept` literals too, which need no
/// host copy, and `Prepared` the `rhs` weights as a product's right operand.
fn emit_weights(
    w: &mut CodeWriter,
    graph: &Graph,
    checked: &Checked,
    names: &Names,
    held: &HashMap<String, String>,
    kept: &KeptLiterals,
    rhs: &HashMap<String, bool>,
    together: &Together,
    placement: &Placement,
) {
    let mut weights = StructSpec::new("Weights", Vis::Pub);
    let mut prepared = StructSpec::new(PREPARED, Vis::Pub);
    prepared.add_generic(BACKEND_BOUND);
    let mut params = StructSpec::new(PARAMS, Vis::Pub);
    params.add_generic(GRAPH_BOUND);
    for let vi of &graph.initializers {
        let ident = names.get(&vi.name);
        weights.add_pub_field(ident, tensor_type(checked, held, &vi.name));
        if !together.elsewhere.contains(vi.name) {
            prepared.add_pub_field(ident, weight_type(checked, rhs, together, &vi.name));
        }
        params.add_pub_field(ident, prepared_type(checked, &vi.name));
    }
    for let tensor of kept.kernels {
        prepared.add_pub_field(names.get(&tensor), prepared_type(checked, &tensor));
    }
    for let tensor of kept.graph {
        params.add_pub_field(names.get(&tensor), prepared_type(checked, &tensor));
    }
    w.blank();
    w.line("/// The graph's initializers, held on the host as the graph holds them.");
    weights.emit(w);
    w.blank();
    ImplSpec::new("Weights").emit_begin(w);
    let mut hosts = HashMap::<String, String>::new();
    for let vi of &graph.initializers {
        hosts[vi.name] = `&self.${names.get(&vi.name)}`;
    }
    for let [holder, method, doc] of [
        [Holder::Kernels, "prepare", "/// These weights as `backend`'s kernels compute with them."],
        [Holder::Built, "params", "/// These weights as tensors of the graph `backend` builds."],
    ] as List<[Holder, String, String]> {
        w.line(doc);
        FnSpec::new(method, Vis::Pub).add_generic(holder.bound()).set_receiver("&self").add_param(
            "backend",
            `&mut ${BACKEND_PARAM}`,
        ).set_return_type(holder.ty()).add_effect("_").emit_begin(w);
        w.begin(`return ${holder.name()}`);
        emit_prepared_fields(w, graph, checked, names, held, rhs, together, &hosts, holder);
        emit_kept_fields(w, names, &kept.of(holder));
        w.end_with(";");
        w.end();
    }
    w.end();
    w.blank();
    w.line("/// The graph's initializers as the backend `forward` runs on computes with them.");
    prepared.emit(w);
    emit_constructor(w, graph, checked, names, held, rhs, together, &kept.kernels, placement, Holder::Kernels);
    w.blank();
    w.line("/// The graph's initializers as tensors of the graph `build` adds operations to.");
    params.emit(w);
    emit_constructor(w, graph, checked, names, held, rhs, together, &kept.graph, placement, Holder::Built);
    if !kept.all().is_empty() {
        emit_kept(w, checked, names, &kept.all());
    }
    emit_embedded_data(w, graph);
}

/// Each initializer's field in `holder`'s struct, from its host tensor in
/// `hosts`. `Prepared` holds each pair or concatenation `together` names
/// from its weights.
fn emit_prepared_fields(
    w: &mut CodeWriter,
    graph: &Graph,
    checked: &Checked,
    names: &Names,
    held: &HashMap<String, String>,
    rhs: &HashMap<String, bool>,
    together: &Together,
    hosts: &HashMap<String, String>,
    holder: Holder,
) {
    for let vi of &graph.initializers {
        let ident = names.get(&vi.name);
        let host = hosts[vi.name];
        if holder matches { Built } {
            w.line(`${ident}: ${preparation(checked, held, &vi.name, host, Holding::Keep)},`);
            continue;
        }
        if together.elsewhere.contains(vi.name) {
            continue;
        }
        let call = if let Some(second) = together.paired.get(vi.name) {
            let verb = if converted(checked, held, &vi.name) { "prepare_rhs_paired" } else { "keep_rhs_paired" };
            `backend.${verb}(${host}, ${hosts[second]})`;
        } else if let Some(parts) = together.concat.get(vi.name) {
            let mut joined = `Columns::of(${host})`;
            for let part of parts[1..<parts.len()].to_list() {
                joined = `${joined}.then(${hosts[part]})`;
            }
            preparation(checked, held, &vi.name, `&${joined}.joined()`, Holding::KeepRhs);
        } else {
            preparation(checked, held, &vi.name, host, weight_holding(rhs, &vi.name));
        };
        w.line(`${ident}: ${call},`);
    }
}

/// The weights a backend holds together: in pairs, each pair's first mapped to
/// its second, and concatenated, each run's first mapped to the run.
struct Together {
    paired: HashMap<String, String>,
    concat: HashMap<String, List<String>>,
    /// The weights held in another's field: each pair's second, and every
    /// weight of a run but its first.
    elsewhere: HashSet<String>,
}

impl Together {
    /// The weights of `graph` the plan `decided` holds together.
    fn of(graph: &Graph, decided: &Plan) -> Together {
        let weight_of = product_weights(graph);
        let paired = paired_weights(decided, &weight_of);
        let concat = concat_weights(decided, &weight_of);
        let mut elsewhere = HashSet::<String>::new();
        for let [_, second] of paired.entries() {
            elsewhere.insert(*second);
        }
        for let [_, parts] of concat.entries() {
            for let part of parts[1..<parts.len()].to_list() {
                elsewhere.insert(part);
            }
        }
        return Together { paired, concat, elsewhere };
    }

    /// The column axis the weight `tensor` is held under, `n` being its own
    /// column axis's position.
    fn columns(&self, checked: &Checked, tensor: &String, n: i32) -> String {
        let own = checked.shapes[*tensor].axes[n].name;
        if self.paired.contains_key(*tensor) {
            return `Paired<${own}>`;
        }
        return match self.concat.get(*tensor) {
            Some(parts) => concatenated_axis(checked, &parts, n),
            None => own,
        };
    }
}

/// The axis the tensors `parts` concatenate along their axis `at` into.
fn concatenated_axis(checked: &Checked, parts: &List<String>, at: i32) -> String {
    let mut joined = checked.shapes[parts[0]].axes[at].name;
    for let part of parts[1..<parts.len()].to_list() {
        joined = `Concat<${joined}, ${checked.shapes[part].axes[at].name}>`;
    }
    return joined;
}

/// The right operand of each matrix product, by the tensor it computes.
fn product_weights(graph: &Graph) -> HashMap<String, String> {
    let mut weight_of = HashMap::<String, String>::new();
    for let node of &graph.nodes {
        if node.op == "MatMul" || node.op == "Gemm" {
            weight_of[node.outputs[0]] = node.inputs[1];
        }
    }
    return weight_of;
}

/// The weights of the products each product kernel computes by weights
/// concatenated, by the first weight, in the order the plan concatenates them.
fn concat_weights(decided: &Plan, weight_of: &HashMap<String, String>) -> HashMap<String, List<String>> {
    let mut concat = HashMap::<String, List<String>>::new();
    for let [_, parts] of decided.concats.entries() {
        let weights: List<String> = parts.into_iter().map(|p| weight_of[*p]).collect();
        concat[weights[0]] = weights;
    }
    return concat;
}

/// `Kept`, one function per `kept` literal keeping it on the backend, for the
/// constructors of `Prepared` and `Params` to call each its own: spelled in
/// each, a mask's data would be in the module twice.
fn emit_kept(w: &mut CodeWriter, checked: &Checked, names: &Names, kept: &List<String>) {
    w.blank();
    w.line("/// The folded tensors `Prepared` and `Params` hold, which no symbol enters.");
    StructSpec::new(KEPT).emit(w);
    w.blank();
    ImplSpec::new(KEPT).emit_begin(w);
    for let tensor of kept {
        FnSpec::new(names.get(tensor)).add_generic(HOLDS_BOUND).add_param("backend", `&mut ${BACKEND_PARAM}`).set_return_type(
            prepared_type(checked, tensor),
        ).add_effect("_").emit_begin(w);
        w.line(`return ${kept_literal(checked, tensor)};`);
        w.end();
    }
    w.end();
}

/// The `Prepared` or `Params` fields of the `kept` literals.
fn emit_kept_fields(w: &mut CodeWriter, names: &Names, kept: &List<String>) {
    for let tensor of kept {
        let ident = names.get(tensor);
        w.line(`${ident}: ${KEPT}::${ident}(backend),`);
    }
}

/// A weight as the backend holds it: in the primitive the kernels compute in.
fn prepared_type(checked: &Checked, tensor: &String) -> String {
    let shape = checked.shapes.get(*tensor).unwrap();
    return `${BACKEND_PARAM}::Tensor<${checked.primitives.get(*tensor).unwrap()}, [${axis_list(&shape)}]>`;
}

/// How long the backend holds a tensor, and what reads it.
enum Holding {
    /// For this pass: an input.
    Pass,
    /// For every pass: a weight.
    Keep,
    /// For every pass, prepared as a matrix product's right operand.
    KeepRhs,
    /// As `KeepRhs`, from the transpose of the weight as stored.
    KeepRhsTransposed,
}

/// The call making the host tensor `host`, a reference, the backend's: a
/// half-precision one is converted once here, so `forward` converts none.
fn preparation(
    checked: &Checked,
    held: &HashMap<String, String>,
    tensor: &String,
    host: String,
    holding: Holding,
) -> String {
    let converted = converted(checked, held, tensor);
    let verb = match holding {
        Pass | Keep && converted => "prepare",
        Pass => "upload",
        Keep => "keep",
        KeepRhs => if converted { "prepare_rhs" } else { "keep_rhs" },
        KeepRhsTransposed => if converted { "prepare_rhs_transposed" } else { "keep_rhs_transposed" },
    };
    return `backend.${verb}(${host})`;
}

/// How the backend holds the weight `tensor`, prepared as a product's right
/// operand where `rhs` names it.
fn weight_holding(rhs: &HashMap<String, bool>, tensor: &String) -> Holding {
    return match rhs.get(*tensor) {
        Some(true) => Holding::KeepRhsTransposed,
        Some(false) => Holding::KeepRhs,
        None => Holding::Keep,
    };
}

/// The weight `tensor` as `Prepared` holds it: with the weights `together`
/// holds in its field.
fn weight_type(checked: &Checked, rhs: &HashMap<String, bool>, together: &Together, tensor: &String) -> String {
    let Some(transposed) = rhs.get(*tensor) else {
        return prepared_type(checked, tensor);
    };
    let [k, n] = if transposed { [1, 0] } else { [0, 1] };
    return `${BACKEND_PARAM}::Rhs<${checked.shapes[*tensor].axes[k].name}, ${together.columns(checked, tensor, n)}>`;
}

/// The weights a backend holds in pairs, each pair's first mapped to its
/// second: the right operands of two products the plan pairs.
fn paired_weights(decided: &Plan, weight_of: &HashMap<String, String>) -> HashMap<String, String> {
    let mut paired = HashMap::<String, String>::new();
    for let [x, y] of decided.pairs {
        paired[weight_of[x]] = weight_of[y];
    }
    return paired;
}

/// Whether some initializer's data is left to a checkpoint.
fn loads_weights(graph: &Graph) -> bool {
    for let vi of &graph.initializers {
        if vi.data matches { None } {
            return true;
        }
    }
    return false;
}

/// `embedded` of `holder`'s struct where the graph carries every
/// initializer's data, and `load` reading the rest from a safetensors
/// checkpoint otherwise. Each tensor is prepared as it is read, so the host
/// copy of one weight at a time, or of the weights held together, is all that
/// lives beside the prepared ones.
fn emit_constructor(
    w: &mut CodeWriter,
    graph: &Graph,
    checked: &Checked,
    names: &Names,
    held: &HashMap<String, String>,
    rhs: &HashMap<String, bool>,
    together: &Together,
    kept: &List<String>,
    placement: &Placement,
    holder: Holder,
) {
    let loads = loads_weights(graph);
    w.blank();
    let mut block = ImplSpec::new(holder.ty());
    block.add_generic(holder.bound());
    block.emit_begin(w);
    if loads {
        // What `load` checks of its file before reading a weight out of it.
        let [doc, param, ty, first]: [String, String, String, Option<String>] = match *placement {
            File => [
                "a safetensors checkpoint",
                "checkpoint",
                `&${CHECKPOINT_PARAM}`,
                Option::Some("let header = read_checkpoint(checkpoint)?;"),
            ],
            Shards(_) => [
                "the shards of a safetensors checkpoint, by the file name its index gives each",
                "shards",
                `&${MAP}<String, ByteList>`,
                Option::Some("let header = read_shards(shards)?;"),
            ],
            InPlace(in_place) => [
                `${in_place.file} where the build found them`,
                "checkpoint",
                `&${CHECKPOINT_PARAM}`,
                in_place.len.map(|len: i32| `expect_len(checkpoint, ${len})?;`),
            ],
        };
        w.line(`/// The weights, those the graph does not carry read from ${doc}.`);
        let mut load = FnSpec::new("load", Vis::Pub);
        if !placement matches { Shards(_) } {
            load.add_generic(`affine ${CHECKPOINT_PARAM}: CheckpointBytes`);
        }
        load.add_param("backend", `&mut ${BACKEND_PARAM}`).add_param(param, ty).set_return_type(
            `Result<${holder.ty()}, LoadError>`,
        ).add_effect("_").emit_begin(w);
        if let Some(line) = first {
            w.line(line);
        }
        w.begin(`return Result::Ok(${holder.name()}`);
    } else {
        w.line("/// The weights the graph carries.");
        FnSpec::new("embedded", Vis::Pub).add_param("backend", `&mut ${BACKEND_PARAM}`).set_return_type(
            holder.ty(),
        ).add_effect("_").emit_begin(w);
        w.begin(`return ${holder.name()}`);
    }
    let mut hosts = HashMap::<String, String>::new();
    for let [at, vi] of graph.initializers.into_iter().enumerate() {
        let primitive = held.get(vi.name).unwrap();
        let shape = checked.shapes.get(vi.name).unwrap();
        let e = expected(&vi, &shape);
        let data = match vi.data {
            Some(_) => `List::<${primitive}>::from_le_bytes(${EMBEDDED_DATA}(${at}))`,
            None => checkpoint_payload(&e, &primitive, placement),
        };
        hosts[vi.name] = `&Tensor::<${primitive}, [${axis_list(&shape)}]> { data: ${data}, extents: ${e.extents} }`;
    }
    emit_prepared_fields(w, graph, checked, names, held, rhs, together, &hosts, holder);
    emit_kept_fields(w, names, kept);
    w.end_with(if loads { ");" } else { ";" });
    w.end();
    w.end();
}

/// The function holding the bytes of each weight the graph carries, by its
/// position among the initializers, so `Prepared` and `Params` both read the
/// one copy in the module.
global EMBEDDED_DATA: String = "embedded_data";

fn emit_embedded_data(w: &mut CodeWriter, graph: &Graph) {
    let mut arms: List<String> = [];
    for let [at, vi] of graph.initializers.into_iter().enumerate() {
        if let Some(bytes) = vi.data {
            arms.push(`${at} => ${byte_string_literal(&bytes)},`);
        }
    }
    if arms.is_empty() {
        return;
    }
    w.blank();
    w.line("/// The bytes of the weight at each position among the initializers the graph carries.");
    w.begin(`fn ${EMBEDDED_DATA}(at: i32) -> ByteList`);
    w.begin("return match at");
    for let arm of arms {
        w.line(arm);
    }
    w.line("_ => unreachable(),");
    w.end_with(";");
    w.end();
}

/// The call reading a tensor's `primitive` elements out of the checkpoint
/// `load` was given, checked against what the build compiled it as.
fn checkpoint_payload(e: &Expected, primitive: &String, placement: &Placement) -> String {
    let axes: List<String> = e.axes.into_iter().map(|axis| wado`"${axis}"`).collect();
    let [types, within] = match *placement {
        File => [`${*primitive}, ${CHECKPOINT_PARAM}`, "checkpoint"],
        Shards(placed) => [*primitive, wado`shards, "${placed[e.tensor]}"`],
        InPlace(in_place) => {
            let [start, end] = in_place.ranges[e.tensor];
            return wado`payload_at::<${*primitive}, ${CHECKPOINT_PARAM}>(checkpoint, "${e.tensor}", ${start}, ${end})?`;
        },
    };
    return wado`header.payload::<${types}>(${within}, &Expected { tensor: "${e.tensor}", dtype: "${e.dtype}", axes: [${axes.join(
        ", ",
    )}], extents: ${e.extents}, elements: ${e.elements}, width: ${e.width} })?`;
}

/// What each tensor is called inside `forward`, each a value the backend holds.
struct Operands {
    values: HashMap<String, String>,
    /// A folded float of one element, as the constant an `Expr` folds in.
    scalars: HashMap<String, f32>,
    /// The weights held as a product's right operand, which only `matmul_rhs`
    /// reads, as `rhs_weights` finds them.
    rhs: HashMap<String, bool>,
    /// The weights held in pairs, as `paired_weights` finds them.
    paired: HashMap<String, String> = HashMap::new(),
    /// What a kernel `Plan` fuses into the kernel after it computes, not yet
    /// written.
    pending: HashMap<String, Term> = HashMap::new(),
    /// What a kernel `Plan` takes into the product after it computes, as the
    /// `Prologue` the product reads its left operand from.
    prologues: HashMap<String, String> = HashMap::new(),
    /// The weight each `Transposed` lowering's output is the transpose of,
    /// which the product reading it reads as stored.
    transposed: HashMap<String, String> = HashMap::new(),
    /// The tensors whose value is a reference already: `pass`'s inputs.
    borrowed: HashSet<String> = HashSet::new(),
}

/// The lengths only the run knows, each bound in `forward` from the first input
/// axis that carries it, once something spells it.
struct Symbols {
    idents: HashMap<String, String>,
    sources: HashMap<String, String>,
    /// The symbols in the order `forward` binds them, each after those its source reads.
    order: List<String>,
    requires: HashMap<String, List<String>>,
    used: HashSet<String>,
    /// Each padded symbol's valid length, as `build` reads it from `lengths`.
    /// Its extent in the inputs is the capacity.
    lengths: HashMap<String, String> = HashMap::new(),
    /// The padded symbols something read the value of.
    read: HashSet<String> = HashSet::new(),
}

impl Symbols {
    /// The symbols `carriers` bind, each read from its input's extent as
    /// `extent` spells it, given the input's identifier and the axis.
    fn of(carriers: &List<Carrier>, names: &Names, extent: fn(&String, i32) -> String) -> Symbols {
        let mut symbols = Symbols {
            idents: HashMap::<String, String>::new(),
            sources: HashMap::<String, String>::new(),
            order: [],
            requires: HashMap::<String, List<String>>::new(),
            used: HashSet::<String>::new(),
        };
        for let c of *carriers {
            let Solved { symbol, coefficient, rest, .. } = c.solved;
            let extent = `${extent(&names.get(&c.input), c.axis)} as i64`;
            let mut value = if rest == Poly::constant(0) {
                extent;
            } else {
                `(${extent} - (${rest.spelled(&symbols.idents)}))`;
            };
            if coefficient != 1 {
                value = `${value} / ${coefficient}`;
            }
            symbols.sources[symbol] = if value == extent { extent } else { `to_extent(${value}) as i64` };
            symbols.idents[symbol] = names.get(&symbol_key(&symbol));
            symbols.order.push(symbol);
            symbols.requires[symbol] = rest.symbols();
        }
        return symbols;
    }

    /// The symbols as `build` reads them where `padded` names a symbol: its
    /// extent the capacity, and its value `lengths`'s field of the symbol's name.
    fn padded(&self, padded: &List<String>) -> Symbols {
        let mut symbols = *self;
        for let symbol of *padded {
            symbols.lengths[symbol] = `lengths.${self.idents[symbol]}`;
        }
        return symbols;
    }

    /// A symbolic integer as the value of `[]` the graph computes it as. Where
    /// it reads a padded symbol, that is its valid length, not the capacity.
    fn value(&mut self, p: &Poly) -> Result<String, EmitError> {
        if !self.reads_lengths(p) {
            return Result::Ok(value_of(self.spell(p)?));
        }
        self.computable(p)?;
        return Result::Ok(p.lowered(self));
    }

    /// Why the run cannot compute `p`, where it cannot: in `i64`, from the
    /// symbols the inputs bind.
    fn computable(&self, p: &Poly) -> Result<(), EmitError> {
        if !p.fits_i64() {
            builtin::cold_path();
            return Result::Err(EmitError::Wide(*p));
        }
        for let symbol of p.symbols() {
            if !self.idents.contains_key(symbol) {
                builtin::cold_path();
                return Result::Err(EmitError::Unbound(symbol));
            }
        }
        return Result::Ok(());
    }

    /// Whether `p` reads a padded symbol, whose value is not its extent.
    fn reads_lengths(&self, p: &Poly) -> bool {
        return p.symbols().into_iter().any(|s| self.lengths.contains_key(s));
    }

    /// A symbolic integer as the `i64` expression `forward` computes it by.
    fn spell(&mut self, p: &Poly) -> Result<String, EmitError> {
        self.computable(p)?;
        for let symbol of p.symbols() {
            self.used.insert(symbol);
        }
        return Result::Ok(p.spelled(&self.idents));
    }

    /// A length or a position within one, as the `i32` a kernel takes.
    fn spell_extent(&mut self, p: &Poly) -> Result<String, EmitError> {
        if let Some(c) = p.as_constant() {
            assert 0 <= c <= i32::MAX as i64;
            return Result::Ok(`${c}`);
        }
        return Result::Ok(`to_extent(${self.spell(p)?})`);
    }

    /// A shape's extents as the list literal of `i32` a kernel takes.
    fn spell_shape(&mut self, shape: &Shape) -> Result<String, EmitError> {
        return self.spell_polys(&shape.axes.into_iter().map(|axis| axis.extent.poly()).collect());
    }

    /// Lengths or positions as the list literal of `i32` a kernel takes.
    fn spell_polys(&mut self, polys: &List<Poly>) -> Result<String, EmitError> {
        let mut spelled: List<String> = [];
        for let p of *polys {
            spelled.push(self.spell_extent(&p)?);
        }
        return Result::Ok(`[${spelled.join(", ")}]`);
    }

    /// The bindings of every symbol something spelled, and of those their sources read.
    fn bindings(&self) -> List<String> {
        let mut needed = self.used;
        for let mut i = self.order.len() - 1; i >= 0; i -= 1 {
            let symbol = self.order[i];
            if needed.contains(symbol) {
                for let read of self.requires.get(symbol).unwrap() {
                    needed.insert(read);
                }
            }
        }
        let mut lines: List<String> = [];
        for let symbol of self.order {
            if needed.contains(symbol) {
                lines.push(`let ${self.idents[symbol]} = ${self.sources[symbol]};`);
            }
        }
        return lines;
    }
}

/// A value `build` computes from the lengths, each step an operation of the
/// graph over `[]`.
impl Lowers for Symbols {
    fn constant(&mut self, c: i64) -> String {
        return value_of(`${c}`);
    }

    fn symbol(&mut self, name: &String) -> String {
        if let Some(length) = self.lengths.get(*name) {
            self.read.insert(*name);
            return length;
        }
        // `value` checked the polynomial binds every symbol it reads.
        self.used.insert(*name);
        return value_of(self.idents[*name]);
    }

    fn add(&mut self, a: String, b: String) -> String {
        return value_binary("Add", a, b);
    }

    fn mul(&mut self, a: String, b: String) -> String {
        return value_binary("Multiply", a, b);
    }

    fn derived(&mut self, op: Op, operands: List<String>) -> String {
        let a = operands[0];
        return match op {
            Min => value_binary("Minimum", a, operands[1]),
            Max => value_binary("Maximum", a, operands[1]),
            CeilDiv | FloorDiv => `quotient::<${BACKEND_PARAM}, []>(backend, &${a}, &${operands[1]}, ${op matches { CeilDiv }})`,
            FromEnd => `from_end_indices::<${BACKEND_PARAM}, []>(backend, &${a}, &${operands[1]})`,
            // `a - 2^32 * floor((a + 2^31) / 2^32)`, as no tensor holds an `i32`.
            Wrap32 => {
                let turn = value_of("4294967296");
                let shifted = value_binary("Add", a, value_of("2147483648"));
                let turns = `quotient::<${BACKEND_PARAM}, []>(backend, &${shifted}, &${turn}, false)`;
                value_binary("Subtract", a, value_binary("Multiply", turn, turns));
            },
        };
    }
}

/// The `i64` the host computes as `host`, as a value of `[]`.
fn value_of(host: String) -> String {
    return `full::<${BACKEND_PARAM}, i64, []>(backend, ${host}, [])`;
}

/// `Binary::<op>` of two values of `[]`.
fn value_binary(op: String, a: String, b: String) -> String {
    return `backend.binary::<i64, []>(Binary::${op}, &${a}, &${b})`;
}

/// The key a symbol takes among the names `forward` binds, apart from any
/// tensor's, since both come out of the model file.
fn symbol_key(symbol: &String) -> String {
    return `dim ${*symbol}`;
}

/// A symbol `forward` reads back from an input axis, as `solved` finds it.
struct Carrier {
    solved: Solved,
    input: String,
    axis: i32,
}

fn symbol_carriers(graph: &Graph, shapes: &HashMap<String, Shape>) -> List<Carrier> {
    let mut extents: List<Extent> = [];
    let mut sites: List<[String, i32]> = [];
    for let vi of &graph.inputs {
        for let [axis, a] of shapes.get(vi.name).unwrap().axes.into_iter().enumerate() {
            extents.push(a.extent);
            sites.push([vi.name, axis]);
        }
    }
    return solved(&extents).into_iter().map(|s| {
        let [input, axis] = sites[s.at];
        return Carrier { solved: s, input, axis };
    }).collect();
}

impl Operands {
    /// A product's left operand `tensor`: the `Prologue` computing it inside
    /// the product, and `true`, where the plan took it in so, and its
    /// reference otherwise.
    fn left(&self, tensor: &String) -> [String, bool] {
        return match self.prologues.get(*tensor) {
            Some(prologue) => [prologue, true],
            None => [self.reference(tensor), false],
        };
    }

    fn reference(&self, tensor: &String) -> String {
        let named = self.values.get(*tensor).unwrap();
        return if self.borrowed.contains(*tensor) { named } else { `&${named}` };
    }

    fn value(&self, tensor: &String) -> String {
        let named = self.values.get(*tensor).unwrap();
        return if self.borrowed.contains(*tensor) { `*${named}` } else { named };
    }
}

/// The forward pass: `pass`, the graph's nodes in order, each a kernel call or
/// a step of the kernel the plan fuses it into; and `forward` around it.
fn emit_forward(
    w: &mut CodeWriter,
    graph: &Graph,
    checked: &Checked,
    decided: &Plan,
    names: &Names,
    held: &HashMap<String, String>,
    exprs: Operands,
    literals: &Literals,
    kept: &List<String>,
    symbols: Symbols,
    fuse: bool,
    crossing: &Crossing,
) -> Result<(), EmitError> {
    let mut forward = FnSpec::new("forward", Vis::Pub);
    forward.add_generic(BACKEND_BOUND).add_param("backend", `&mut ${BACKEND_PARAM}`);
    // `forward` takes each input on the host and uploads it once the pass has
    // begun. The weights are the backend's already.
    let [has_cache, several, returned] = [
        crossing.has_cache(),
        crossing.several(),
        crossing.returned,
    ];
    let mut uploads: List<String> = [];
    let mut arguments: List<String> = ["backend"];
    for let vi of &graph.inputs {
        if crossing.cached.contains(vi.name) {
            continue;
        }
        let ident = names.get(&vi.name);
        forward.add_param(ident, `&${tensor_type(checked, held, &vi.name)}`);
        uploads.push(`let ${ident} = ${preparation(checked, held, &vi.name, ident, Holding::Pass)};`);
        arguments.push(`&${ident}`);
    }
    if has_cache {
        forward.add_param("cache", `&${CACHE}<${BACKEND_PARAM}>`);
        arguments.push("cache");
    }
    arguments.push("weights");
    let returned_type = if has_cache {
        `${OUTPUTS}<${BACKEND_PARAM}>`;
    } else if several {
        OUTPUTS;
    } else {
        tensor_type(checked, held, &returned[0]);
    };
    forward.add_param("weights", `&${PREPARED_TYPE}`).set_return_type(returned_type).add_effect("_");

    if has_cache {
        emit_cache(w, &crossing.pairs, checked, names);
    }
    if several {
        emit_outputs(w, &returned, has_cache, checked, names, held);
        emit_passed(w, &returned, has_cache, checked, names);
    }
    w.blank();
    w.line("/// The graph's forward pass over inputs the backend holds, one kernel call");
    w.line("/// per kernel `loam dump` reports, its outputs left where the backend");
    w.line("/// computed them, for a caller to read only the part it needs. The caller");
    w.line("/// begins the pass, `backend.begin()`, before it uploads the inputs. The next");
    w.line("/// begin releases what the pass computed, but for what `backend.retain` keeps.");
    // The kernels pad nothing, so they read no valid length.
    emit_entry(w, graph, checked, decided, names, Holder::Kernels, exprs, literals, kept, symbols, fuse, crossing)?;

    w.blank();
    w.line("/// [`pass`] over inputs on the host, its outputs read back to the host.");
    forward.emit_begin(w);
    // The cache was computed before the pass this call begins.
    let keep_cache: List<String> = if has_cache { ["cache.retain(backend);"] } else { [] };
    let host = input_checks(graph, &checked.shapes, names, &crossing.cached).host;
    for let lines of [host, keep_cache, ["backend.begin();"] as List<String>, uploads] as List<List<String>> {
        for let line of lines {
            w.line(&line);
        }
    }
    let passed = `pass(${arguments.join(", ")})`;
    let downloaded = |tensor: &String, place: String| {
        let read = `backend.download(&${place})`;
        return if converted(checked, held, tensor) { `narrow(&${read})` } else { read };
    };
    // Bound to the outputs' own names, which the module's names already
    // keep apart, so `forward` reserves none of its own.
    if !several {
        w.line(`return ${downloaded(&returned[0], passed)};`);
    } else {
        let mut idents: List<String> = returned.into_iter().map(|o| names.get(&o)).collect();
        let mut fields: List<String> = returned.into_iter().map(
            |o| `${names.get(&o)}: ${downloaded(&o, names.get(&o))}`,
        ).collect();
        if has_cache {
            idents.push("cache");
            fields.push("cache: cache");
        }
        w.line(`let ${PASSED} { ${idents.join(", ")} } = ${passed};`);
        w.line(`return ${OUTPUTS} { ${fields.join(", ")} };`);
    }
    w.end();
    return Result::Ok(());
}

/// The pass built as a graph, each node as the operations of `Graph` that
/// compute it, and `Lengths`. Returns the padded symbols it reads the value
/// of, which `Lengths` holds.
fn emit_build(
    w: &mut CodeWriter,
    graph: &Graph,
    checked: &Checked,
    decided: &Plan,
    names: &Names,
    literals: &Literals,
    kept: &List<String>,
    symbols: Symbols,
    crossing: &Crossing,
) -> Result<List<String>, EmitError> {
    let exprs = Operands {
        values: HashMap::<String, String>::new(),
        scalars: HashMap::<String, f32>::new(),
        rhs: HashMap::<String, bool>::new(),
    };
    let idents = symbols.idents;
    w.blank();
    w.line("/// The graph's forward pass, each operation added to the graph `backend`");
    w.line("/// builds, over inputs it holds.");
    let read = emit_entry(
        w,
        graph,
        checked,
        decided,
        names,
        Holder::Built,
        exprs,
        literals,
        kept,
        symbols,
        false,
        crossing,
    )?;
    if !read.is_empty() {
        let mut lengths = StructSpec::new(LENGTHS, Vis::Pub);
        lengths.add_generic(HOLDS_BOUND);
        for let symbol of read {
            lengths.add_pub_field(idents[symbol], `${BACKEND_PARAM}::Tensor<i64, []>`);
        }
        w.blank();
        w.line("/// The valid length of each length the inputs pad to a capacity, their");
        w.line("/// extent, where `build` reads it.");
        lengths.emit(w);
    }
    return Result::Ok(read);
}

/// `compute`: [`build`] over inputs on the host. It checks them as `forward`
/// does, pads each padded length to its capacity, builds, and reads the
/// outputs back cut to their lengths. `symbols` reads the lengths off the
/// inputs on the host, and `read` lists those `build` reads as values.
fn emit_compute(
    w: &mut CodeWriter,
    graph: &Graph,
    checked: &Checked,
    names: &Names,
    held: &HashMap<String, String>,
    carriers: &List<Carrier>,
    mut symbols: Symbols,
    padded: &List<String>,
    read: &List<String>,
    crossing: &Crossing,
) -> Result<(), EmitError> {
    let shapes = &checked.shapes;
    let returned = crossing.returned;
    let mut compute = FnSpec::new("compute", Vis::Pub);
    compute.add_generic(GRAPH_BOUND).add_param("backend", `&mut ${BACKEND_PARAM}`);
    let mut lines: List<String> = [];
    // Every symbolic axis is its symbols' arithmetic over the lengths, but for
    // the axis a symbol is read from.
    for let vi of &graph.inputs {
        let ident = names.get(&vi.name);
        compute.add_param(ident, `&${tensor_type(checked, held, &vi.name)}`);
        for let [i, axis] of shapes[vi.name].axes.into_iter().enumerate() {
            let Symbolic(length) = axis.extent else {
                continue;
            };
            if carriers.into_iter().any(|c| c.input == vi.name && c.axis == i) {
                continue;
            }
            lines.push(
                wado`refuse(extent_mismatch("${vi.name}", "${axis.name}", ${ident}.extents[${i}], "${length}", ${symbols.spell(
                    &length,
                )?}));`,
            );
        }
    }
    lines.extend(&owed_checks(checked, &mut symbols)?);
    // Each padded length's capacity, which stands for it in every extent.
    let mut capacities = symbols;
    for let symbol of *padded {
        let length = symbols.spell(&Poly::symbol(&symbol))?;
        let capacity = names.get(&capacity_key(&symbol));
        lines.push(`let ${capacity} = capacity_of(to_extent(${length})) as i64;`);
        capacities.idents[symbol] = capacity;
    }
    let mut arguments: List<String> = ["backend"];
    for let vi of &graph.inputs {
        let ident = names.get(&vi.name);
        let padded_to = `&resized(${ident}, ${capacities.spell_shape(&shapes[vi.name])?})`;
        lines.push(`let ${ident} = ${preparation(checked, held, &vi.name, padded_to, Holding::Pass)};`);
        arguments.push(`&${ident}`);
    }
    // A capacity reads its length, and an unpadded symbol is its own capacity.
    for let symbol of capacities.used {
        symbols.used.insert(symbol);
    }
    if !read.is_empty() {
        let mut fields: List<String> = [];
        for let symbol of *read {
            fields.push(`${symbols.idents[symbol]}: backend.upload(&Tensor::<i64, []> { data: [${symbols.spell(
                &Poly::symbol(&symbol),
            )?}], extents: [] })`);
        }
        lines.push(`let lengths = ${LENGTHS} { ${fields.join(", ")} };`);
        arguments.push("&lengths");
    }
    arguments.push("weights");
    let built = `build(${arguments.join(", ")})`;
    let mut read_back = |tensor: &String, place: String| -> Result<String, EmitError> {
        let mut downloaded = `backend.download(&${place})`;
        if converted(checked, held, tensor) {
            downloaded = `narrow(&${downloaded})`;
        }
        let shape = shapes[*tensor];
        let cut = shape.axes.into_iter().any(|a| a.extent.poly().symbols().into_iter().any(|s| padded.contains(&s)));
        return Result::Ok(if cut { `resized(&${downloaded}, ${symbols.spell_shape(&shape)?})` } else { downloaded });
    };
    let returned_type = if crossing.several() {
        let mut idents: List<String> = [];
        let mut fields: List<String> = [];
        for let output of returned {
            let ident = names.get(&output);
            idents.push(ident);
            fields.push(`${ident}: ${read_back(&output, ident)?}`);
        }
        lines.push(`let ${PASSED} { ${idents.join(", ")} } = ${built};`);
        lines.push(`return ${OUTPUTS} { ${fields.join(", ")} };`);
        OUTPUTS;
    } else {
        lines.push(`return ${read_back(&returned[0], built)?};`);
        tensor_type(checked, held, &returned[0]);
    };
    compute.add_param("weights", `&${PARAMS}<${BACKEND_PARAM}>`).set_return_type(returned_type).add_effect("_");
    w.blank();
    w.line("/// [`build`] over inputs on the host, each length padded to a capacity, its");
    w.line("/// outputs read back cut to their lengths.");
    compute.emit_begin(w);
    // The checks come first, as a binding reads an extent they check is there.
    let checks = input_checks(graph, shapes, names, &crossing.cached).host;
    for let line of checks.into_iter().chain(symbols.bindings().into_iter()).chain(lines.into_iter()) {
        w.line(&line);
    }
    w.end();
    return Result::Ok(());
}

/// The key a padded symbol's capacity takes among the names `compute` binds.
fn capacity_key(symbol: &String) -> String {
    return `capacity ${*symbol}`;
}

/// What crosses a pass's boundary beside its inputs and weights, which every
/// entry and the structs around them agree on.
struct Crossing {
    /// Each past and the present that replaces it in the cache.
    pairs: List<[String, String]>,
    /// The pasts, which an entry reads from the cache rather than taking.
    cached: HashSet<String>,
    /// The outputs a pass returns, a present aside: the cache holds it.
    returned: List<String>,
}

impl Crossing {
    fn of(graph: &Graph, pairs: List<[String, String]>) -> Crossing {
        let mut cached = HashSet::<String>::new();
        for let [past, _] of pairs {
            cached.insert(past);
        }
        let presents: List<String> = pairs.into_iter().map(|p| p.1).collect();
        let returned = graph.outputs.into_iter().map(|vi| vi.name).filter(|o| !presents.contains(&o)).collect();
        return Crossing { pairs, cached, returned };
    }

    fn has_cache(&self) -> bool {
        return !self.pairs.is_empty();
    }

    /// Whether a pass returns its outputs in `Passed`, and `forward` in `Outputs`.
    fn several(&self) -> bool {
        return self.returned.len() > 1 || self.has_cache();
    }
}

/// `holder`'s entry: the inputs as the backend holds them, the cache, the
/// valid lengths the body reads and the weights in; the checks of what the
/// inputs owe; the body; and the outputs out, the presents as the next pass's
/// cache. Returns the padded symbols the body reads the value of.
fn emit_entry(
    w: &mut CodeWriter,
    graph: &Graph,
    checked: &Checked,
    decided: &Plan,
    names: &Names,
    holder: Holder,
    mut exprs: Operands,
    literals: &Literals,
    kept: &List<String>,
    mut symbols: Symbols,
    fuse: bool,
    crossing: &Crossing,
) -> Result<List<String>, EmitError> {
    let shapes = &checked.shapes;
    let mut entry = FnSpec::new(holder.entry(), Vis::Pub);
    entry.add_generic(holder.bound()).add_param("backend", `&mut ${BACKEND_PARAM}`);
    // The pasts cross in one `Cache`, and the presents replace them in it.
    let [has_cache, several, returned] = [
        crossing.has_cache(),
        crossing.several(),
        crossing.returned,
    ];
    for let vi of &graph.inputs {
        let ident = names.get(&vi.name);
        exprs.values[vi.name] = ident;
        exprs.borrowed.insert(vi.name);
        if !crossing.cached.contains(vi.name) {
            entry.add_param(ident, `&${prepared_type(checked, &vi.name)}`);
        }
    }
    if has_cache {
        entry.add_param("cache", `&${CACHE}<${BACKEND_PARAM}>`);
    }
    for let vi of &graph.initializers {
        exprs.values[vi.name] = `weights.${names.get(&vi.name)}`;
    }
    for let tensor of kept {
        exprs.values[*tensor] = `weights.${names.get(tensor)}`;
    }
    // A symbol is bound once something spells it, and a valid length taken
    // once something reads it, which the body decides.
    let body = scope_body(graph, checked, decided, names, &mut exprs, literals, &mut symbols, holder, fuse)?;
    let read: List<String> = symbols.order.into_iter().filter(|s| symbols.read.contains(s)).collect();
    if !read.is_empty() {
        entry.add_param("lengths", `&${LENGTHS}<${BACKEND_PARAM}>`);
    }
    let passed_type = if several { `${PASSED}<${BACKEND_PARAM}>` } else { prepared_type(checked, &returned[0]) };
    entry.add_param("weights", `&${holder.ty()}`).set_return_type(passed_type).add_effect("_");
    entry.emit_begin(w);
    for let [past, _] of crossing.pairs {
        let ident = names.get(&past);
        w.line(`let ${ident} = &cache.${ident};`);
    }
    let checks = input_checks(graph, shapes, names, &crossing.cached);
    for let line of checks.held {
        w.line(&line);
    }
    let mut owed: List<String> = [];
    for let spelled of checks.spelled {
        let SpelledAxis { tensor, axis, extent, length } = spelled;
        owed.push(
            wado`refuse(extent_mismatch("${tensor}", "${axis}", ${extent}, "${length}", ${symbols.spell(&length)?}));`,
        );
    }
    owed.extend(&owed_checks(checked, &mut symbols)?);
    for let lines of [symbols.bindings(), owed, body] as List<List<String>> {
        for let line of lines {
            w.line(&line);
        }
    }
    if !several {
        w.line(`return ${exprs.value(&returned[0])};`);
    } else {
        let mut fields: List<String> = returned.into_iter().map(|o| `${names.get(&o)}: ${exprs.value(&o)}`).collect();
        if has_cache {
            // Each present under its past's axes, as the next pass reads it.
            let mut parts: List<String> = [];
            for let [past, present] of crossing.pairs {
                let at = exprs.reference(&present);
                let element = checked.primitives.get(present).unwrap();
                let axes = `[${axis_list(&shapes.get(present).unwrap())}], [${axis_list(&shapes.get(past).unwrap())}]`;
                parts.push(
                    `${names.get(&past)}: backend.reshape::<${element}, ${axes}>(${at}, backend.extents_of(${at}))`,
                );
            }
            fields.push(`cache: ${CACHE} { ${parts.join(", ")} }`);
        }
        w.line(`return ${PASSED} { ${fields.join(", ")} };`);
    }
    w.end();
    return Result::Ok(read);
}

/// `Cache`, one field per pair, each held under its past's axes; its `empty`,
/// the state before the first pass, which takes the length of each axis the
/// graph leaves open; and its `retain`.
fn emit_cache(w: &mut CodeWriter, pairs: &List<[String, String]>, checked: &Checked, names: &Names) {
    let mut cache = StructSpec::new(CACHE, Vis::Pub);
    cache.add_generic(HOLDS_BOUND);
    let mut opened: List<String> = [];
    let mut empties: List<String> = [];
    let mut retains: List<String> = [];
    for let [past, present] of *pairs {
        let ident = names.get(&past);
        cache.add_pub_field(ident, prepared_type(checked, &past));
        let shape = checked.shapes[past];
        let mut extents: List<String> = [];
        let mut empty = false;
        let mut fixed = 1;
        let mut open: List<String> = [];
        for let [i, axis] of shape.axes.into_iter().enumerate() {
            let Symbolic(p) = axis.extent else {
                extents.push(`${axis.static_extent()}`);
                fixed *= axis.static_extent();
                continue;
            };
            // The past's length grows into the present's, and an empty cache
            // holds none of it.
            if checked.shapes[present].axes[i].name != axis.name {
                extents.push("0");
                empty = true;
                continue;
            }
            let length = open_length(&p, names, &mut opened);
            extents.push(length);
            open.push(length);
        }
        let primitive = checked.primitives[past];
        let data = if empty {
            "[]";
        } else {
            if fixed != 1 || open.is_empty() {
                open.push(`${fixed}`);
            }
            `List::<${primitive}>::filled(${open.join(" * ")}, ${zero_of(&primitive)})`;
        };
        empties.push(
            `${ident}: backend.upload(&Tensor::<${primitive}, [${axis_list(&shape)}]> { data: ${data}, extents: [${extents.join(
                ", ",
            )}] }),`,
        );
        retains.push(`backend.retain(&self.${ident});`);
    }
    let mut params: List<String> = [`backend: &mut ${BACKEND_PARAM}`];
    for let length of opened {
        params.push(`${length}: i32`);
    }
    w.blank();
    w.line("/// The state the graph hands from one pass to the next, as the backend holds");
    w.line("/// it: each past it reads, which the present it computes replaces.");
    cache.emit(w);
    w.blank();
    let mut held = ImplSpec::new(`${CACHE}<${BACKEND_PARAM}>`);
    held.add_generic(HOLDS_BOUND);
    held.emit_begin(w);
    w.line("/// The state before the first pass: no position along a past's length,");
    w.line("/// and zeros of every other state.");
    w.line(`pub fn empty(${params.join(", ")}) -> ${CACHE}<${BACKEND_PARAM}> with _ {`);
    w.line(`    return ${CACHE} {`);
    for let line of empties {
        w.line(`        ${line}`);
    }
    w.line("    };");
    w.line("}");
    w.end();
    w.blank();
    let mut block = ImplSpec::new(`${CACHE}<${BACKEND_PARAM}>`);
    block.add_generic(BACKEND_BOUND);
    block.emit_begin(w);
    w.line("/// Keeps the cache through the next `backend.begin()`.");
    w.line(`pub fn retain(&self, backend: &mut ${BACKEND_PARAM}) with _ {`);
    for let line of retains {
        w.line(`    ${line}`);
    }
    w.line("}");
    w.end();
}

/// The `i32` length `Cache::empty` gives an open axis of extent `p`, each
/// symbol in it a parameter of `empty`, which `opened` lists once.
fn open_length(p: &Poly, names: &Names, opened: &mut List<String>) -> String {
    let mut spelled = HashMap::<String, String>::new();
    for let symbol of p.symbols() {
        let ident = names.get(&symbol_key(&symbol));
        if !opened.contains(&ident) {
            opened.push(ident);
        }
        if *p == Poly::symbol(&symbol) {
            return ident;
        }
        spelled[symbol] = `(${ident} as i64)`;
    }
    return `to_extent(${p.spelled(&spelled)})`;
}

/// A zero of `primitive`, as an empty state holds.
fn zero_of(primitive: &String) -> String {
    return if *primitive == "bool" { "false" } else { `0 as ${*primitive}` };
}

/// The struct `pass` returns a graph's several outputs in, each as the
/// backend holds it.
fn emit_passed(w: &mut CodeWriter, returned: &List<String>, has_cache: bool, checked: &Checked, names: &Names) {
    let mut passed = StructSpec::new(PASSED, Vis::Pub);
    passed.add_generic(HOLDS_BOUND);
    for let output of *returned {
        passed.add_pub_field(names.get(&output), prepared_type(checked, &output));
    }
    if has_cache {
        passed.add_pub_field("cache", `${CACHE}<${BACKEND_PARAM}>`);
    }
    w.blank();
    w.line("/// The graph's outputs as the backend holds them, in the order it declares them.");
    passed.emit(w);
}

/// The checks of what a scope owes, which run before any kernel in it.
fn owed_checks(checked: &Checked, symbols: &mut Symbols) -> Result<List<String>, EmitError> {
    let mut lines: List<String> = [];
    for let c of &checked.owed {
        lines.push(wado`refuse(unmet(${symbols.spell(&c.slack)?}, "${c.reason}"));`);
    }
    return Result::Ok(lines);
}

/// One scope's statements: the literals it spells that no scope around it
/// did, then each node as `holder`'s entry computes it. `pass` calls the
/// kernels as `decided`, the scope's plan, lowers them, and `fuse` plans the
/// branches inside it. `build` adds each node's operations, but for a weight's
/// transpose, which the product reading it reads past.
fn scope_body(
    graph: &Graph,
    checked: &Checked,
    decided: &Plan,
    names: &Names,
    exprs: &mut Operands,
    literals: &Literals,
    symbols: &mut Symbols,
    holder: Holder,
    fuse: bool,
) -> Result<List<String>, EmitError> {
    let mut body: List<String> = [];
    for let tensor of literals.spelled {
        if exprs.values.contains_key(tensor) {
            continue;
        }
        let ident = names.get(&tensor);
        body.push(`let ${ident} = ${literal_tensor(checked, &tensor, symbols, holder)?};`);
        exprs.values[tensor] = ident;
    }
    for let [alias, spelled] of literals.aliases.entries() {
        if !exprs.values.contains_key(*alias) {
            exprs.values[*alias] = exprs.value(spelled);
        }
    }
    for let [at, node] of graph.nodes.into_iter().enumerate() {
        let lowering = match holder {
            Kernels => decided.lowering(at),
            Built => if decided.lowering(at) matches { Transposed } {
                Lowering::Transposed;
            } else {
                lowering_of(&node, checked);
            },
        };
        match lowering {
            Folded | Flattened => {
            },
            Transposed => exprs.transposed[node.outputs[0]] = node.inputs[0],
            // A restored product is the product, computed over its axes.
            Alias | Restored => {
                // An alias of a value a later kernel computes stays pending.
                if let Some(pending) = exprs.pending.get(node.inputs[0]) {
                    exprs.pending[node.outputs[0]] = pending;
                } else if let Some(prologue) = exprs.prologues.get(node.inputs[0]) {
                    exprs.prologues[node.outputs[0]] = prologue;
                } else {
                    exprs.values[node.outputs[0]] = exprs.values.get(node.inputs[0]).unwrap();
                    if exprs.borrowed.contains(node.inputs[0]) {
                        exprs.borrowed.insert(node.outputs[0]);
                    }
                }
            },
            Branch => body.extend(&branch_block(&node, checked, names, exprs, symbols, holder, fuse)?),
            Kernel => {
                if holder matches { Built } {
                    body.extend(&node_calls(&node, checked, names, exprs, symbols, graph.opset, holder)?);
                    continue;
                }
                // The first product of a concatenation binds this one.
                if decided.of(&node.outputs[0]) matches { Concatenated(_) } {
                    continue;
                }
                let spread = decided.spread_of(&node.outputs[0]);
                let Some(term) = node_term(&node, checked, exprs, symbols, graph.opset, &spread)? else {
                    body.extend(&node_calls(&node, checked, names, exprs, symbols, graph.opset, holder)?);
                    continue;
                };
                let output = node.outputs[0];
                if decided.is_fused(&output) {
                    exprs.pending[output] = term;
                    continue;
                }
                let space = decided.space_of(checked, &output);
                if decided.is_prologue(&output) {
                    exprs.prologues[output] = term.prologue(&space);
                    continue;
                }
                body.push(bound_to(&output, term.call(&space, &decided.rows_of(&output), &exprs.paired), names, exprs));
                if let Some(parts) = decided.concats.get(output) {
                    body.extend(&concat_parts(checked, &parts, names, exprs));
                }
            },
        }
    }
    return Result::Ok(body);
}

/// The products `parts` as views of their concatenation, which the first's
/// name holds: each later one, then the first, shadowing it.
fn concat_parts(checked: &Checked, parts: &List<String>, names: &Names, exprs: &mut Operands) -> List<String> {
    let mut whole = checked.shapes[parts[0]];
    let last = whole.rank() - 1;
    whole.axes[last].name = concatenated_axis(checked, parts, last);
    let operand = `&${names.get(&parts[0])}`;
    let mut views: List<String> = [];
    let mut start = 0;
    for let part of *parts {
        let cut = checked.shapes[part].axes[last];
        let length = cut.static_extent();
        let call = slice_axis_call(&"f32", &whole, last, &cut.name, &operand, [`${start}`, `${length}`], 1);
        views.push(bound_to(&part, call, names, exprs));
        start += length;
    }
    // The first's view reads the name it then takes.
    views.push(views.remove(0));
    return views;
}

/// A node's kernel calls, or its operations, as `holder`'s entry computes it,
/// each bound to the output it computes.
fn node_calls(
    node: &Node,
    checked: &Checked,
    names: &Names,
    exprs: &mut Operands,
    symbols: &mut Symbols,
    opset: Option<i64>,
    holder: Holder,
) -> Result<List<String>, EmitError> {
    if node.op == GROUP_QUERY_ATTENTION {
        let mut bound: List<String> = [];
        for let output of node.outputs {
            if output == "" {
                bound.push("_");
                continue;
            }
            let ident = names.get(&output);
            exprs.values[output] = ident;
            bound.push(ident);
        }
        // The kernel and the composite each compute every output, so an
        // unnamed one is dropped.
        while bound.len() < 3 {
            bound.push("_");
        }
        return Result::Ok([`let [${bound.join(", ")}] = ${attention_call(node, checked, exprs)};`]);
    }
    let calls = match [holder, node.op == "Split"] {
        [Kernels, true] => split_calls(node, checked, exprs, symbols)?,
        [Built, true] => built_split(node, checked, exprs, symbols)?,
        [Kernels, false] => [node_call(node, checked, exprs, symbols, opset)?] as List<String>,
        [Built, false] => [built_call(node, checked, exprs, symbols, opset)?] as List<String>,
    };
    let mut lines: List<String> = [];
    for let [i, call] of calls.into_iter().enumerate() {
        lines.push(bound_to(&node.outputs[i], call, names, exprs));
    }
    return Result::Ok(lines);
}

/// A `GroupQueryAttention` as its kernel's call. An optional operand absent
/// still needs its axes named, so the turbofish spells the query's for it.
fn attention_call(node: &Node, checked: &Checked, exprs: &Operands) -> String {
    let shapes = &checked.shapes;
    let options = settled(attention_options(node));
    let q = shapes[node.inputs[0]];
    let k = shapes[node.inputs[1]];
    let past = shapes[node.inputs[3]];
    let total = shapes[named_present(node).unwrap()].axes[2].name;
    let optional = |index: i32| if node.has_operand(index) {
        `Option::Some(${exprs.reference(&node.inputs[index])})`;
    } else {
        "null";
    };
    let [pos, half] = if node.has_operand(ROTARY_COS) {
        let cache = shapes[node.inputs[ROTARY_COS]];
        [cache.axes[0].name, cache.axes[1].name];
    } else {
        [q.axes[1].name, past.axes[3].name];
    };
    let [bias_batch, bias_heads] = if node.has_operand(ATTENTION_BIAS) {
        let bias = shapes[node.inputs[ATTENTION_BIAS]];
        [bias.axes[0].name, bias.axes[1].name];
    } else {
        [q.axes[0].name, past.axes[1].name];
    };
    let turbofish = [
        q.axes[0].name, q.axes[1].name, q.axes[2].name, k.axes[2].name, past.axes[1].name, past.axes[2].name, total,
        past.axes[3].name, pos, half, bias_batch, bias_heads,
    ] as List<String>;
    let head = past.axes[3].static_extent();
    let scale = options.scale.unwrap_or(1.0 / f32::sqrt(head as f32));
    let attention = `&Attention { heads: ${options.heads}, kv_heads: ${options.kv_heads}, scale: ${float_literal(scale)}, softcap: ${float_literal(
        options.softcap,
    )}, window: ${options.window}, causal: ${options.causal} }`;
    let mut operands: List<String> = [];
    for let i of 0..<5 {
        operands.push(exprs.reference(&node.inputs[i]));
    }
    // The caches are read only where the attribute asks for rotation.
    for let index of [ROTARY_COS, ROTARY_SIN] {
        operands.push(if options.rotary { optional(index) } else { "null" });
    }
    operands.push(optional(ATTENTION_BIAS));
    operands.push(attention);
    return `backend.group_query_attention::<${turbofish.join(", ")}>(${operands.join(", ")})`;
}

/// The statement binding `call` to `output`'s name, which later reads of
/// `output` then take.
fn bound_to(output: &String, call: String, names: &Names, exprs: &mut Operands) -> String {
    let ident = names.get(output);
    exprs.values[*output] = ident;
    return `let ${ident} = ${call};`;
}

/// An `If`, each branch a block that checks what it owes, computes its
/// outputs, and yields them under the axes the node's outputs carry. `pass`
/// reads the condition's element and takes one block; `build` adds a
/// conditional whose branches are the blocks.
fn branch_block(
    node: &Node,
    checked: &Checked,
    names: &Names,
    exprs: &mut Operands,
    symbols: &mut Symbols,
    holder: Holder,
    fuse: bool,
) -> Result<List<String>, EmitError> {
    let [then_branch, else_branch] = branches(node, checked);
    let outputs: List<String> = node.outputs.into_iter().map(|o| names.get(&o)).collect();
    let bound = if outputs.len() == 1 { outputs[0] } else { `[${outputs.join(", ")}]` };
    let condition = exprs.reference(&node.inputs[0]);
    let [opening, between, closing] = match holder {
        // The condition is read on the host, which on a GPU is a synchronization.
        Kernels => [`let ${bound} = if backend.download(${condition}).data[0] {`, "} else {", "};"],
        Built => {
            let types: List<String> = node.outputs.into_iter().map(|o| prepared_type(checked, &o)).collect();
            let yielded = if types.len() == 1 { types[0] } else { `[${types.join(", ")}]` };
            let axes = axis_list(&checked.shapes[node.inputs[0]]);
            [`let ${bound} = backend.conditional::<[${axes}], ${yielded}>(${condition}, || {`, "}, || {", "});"];
        },
    };
    let mut lines: List<String> = [opening];
    lines.extend(&indented(branch_lines(node, &then_branch, checked, names, exprs, symbols, holder, fuse)?));
    lines.push(between);
    lines.extend(&indented(branch_lines(node, &else_branch, checked, names, exprs, symbols, holder, fuse)?));
    lines.push(closing);
    for let [i, output] of node.outputs.into_iter().enumerate() {
        exprs.values[output] = outputs[i];
    }
    return Result::Ok(lines);
}

/// One branch's block, in a copy of the operands around it.
fn branch_lines(
    node: &Node,
    taken: &IfBranch,
    around: &Checked,
    names: &Names,
    exprs: &Operands,
    symbols: &mut Symbols,
    holder: Holder,
    fuse: bool,
) -> Result<List<String>, EmitError> {
    let graph = &taken.graph;
    let branch = &taken.checked;
    let mut inner = Operands {
        values: exprs.values,
        scalars: scalar_literals(branch),
        rhs: exprs.rhs,
        borrowed: exprs.borrowed,
    };
    for let [tensor, _] of exprs.values.entries() {
        let [Some(from), Some(to)] = [
            around.shapes.get(*tensor),
            branch.shapes.get(*tensor),
        ] else {
            continue;
        };
        if axis_list(&from) != axis_list(&to) {
            // A branch checks against a copy of the shapes around it, and only
            // the outermost graph declares weights.
            assert !exprs.rhs.contains_key(*tensor), "a branch renames no weight's axes";
            inner.values[*tensor] = relabeled(
                holder,
                &around.primitives[*tensor],
                &from,
                &to,
                &exprs.reference(tensor),
            );
            inner.borrowed.remove(*tensor);
        }
    }
    let literals = match holder {
        Kernels => kernel_literals(graph, branch, &inner.scalars),
        Built => graph_literals(graph, branch),
    };
    let mut lines = owed_checks(branch, symbols)?;
    lines.extend(&scope_body(
        graph,
        branch,
        &branch_plan(graph, branch, fuse),
        names,
        &mut inner,
        &literals,
        symbols,
        holder,
        fuse,
    )?);
    let mut yielded: List<String> = [];
    for let [i, vi] of graph.outputs.into_iter().enumerate() {
        let from = branch.shapes[vi.name];
        let to = around.shapes[node.outputs[i]];
        if axis_list(&from) == axis_list(&to) {
            yielded.push(inner.value(&vi.name));
            continue;
        }
        yielded.push(relabeled(holder, &around.primitives[node.outputs[i]], &from, &to, &inner.reference(&vi.name)));
    }
    let value = if yielded.len() == 1 { yielded[0] } else { `[${yielded.join(", ")}]` };
    // A conditional's branch is a closure, which returns its value.
    lines.push(if holder matches { Built } { `return ${value};` } else { value });
    return Result::Ok(lines);
}

/// The tensor `operand` refers to, of axes `from`, as one of axes `to`.
fn relabeled(holder: Holder, element: &String, from: &Shape, to: &Shape, operand: &String) -> String {
    let axes = `${*element}, [${axis_list(from)}], [${axis_list(to)}]`;
    return match holder {
        Kernels => `backend.lift::<${axes}>(${*operand}, ${to.rank()})`,
        Built => `lifted::<${BACKEND_PARAM}, ${axes}>(backend, ${*operand}, ${to.rank()})`,
    };
}

fn indented(lines: List<String>) -> List<String> {
    return lines.into_iter().map(|line| `    ${line}`).collect();
}

/// The struct `forward` returns a graph's several outputs in, one field each.
fn emit_outputs(
    w: &mut CodeWriter,
    returned: &List<String>,
    has_cache: bool,
    checked: &Checked,
    names: &Names,
    held: &HashMap<String, String>,
) {
    let mut outputs = StructSpec::new(OUTPUTS, Vis::Pub);
    if has_cache {
        outputs.add_generic(BACKEND_BOUND);
    }
    for let output of *returned {
        outputs.add_pub_field(names.get(&output), tensor_type(checked, held, &output));
    }
    if has_cache {
        // The cache stays where the backend holds it, for the next pass.
        outputs.add_pub_field("cache", `${CACHE}<${BACKEND_PARAM}>`);
    }
    w.blank();
    w.line("/// The graph's outputs, in the order it declares them.");
    outputs.emit(w);
}

/// Every folded float of one element, as the constant an `Expr` folds in.
fn scalar_literals(checked: &Checked) -> HashMap<String, f32> {
    let mut scalars = HashMap::<String, f32>::new();
    for let [name, k] of checked.known.entries() {
        if let Floats(v) = k.elements && v.len() == 1 {
            scalars[*name] = v[0];
        }
    }
    return scalars;
}

/// The folded tensors `forward` binds as literals.
struct Literals {
    spelled: List<String>,
    /// A tensor a node names again under the same axes (`is_alias`), and the
    /// spelled one it reads: a transformer names its mask once per layer, and
    /// the mask is as large as the context.
    aliases: HashMap<String, String>,
}

/// The folded tensors `pass` reads as a tensor: all a kernel reads or the
/// graph returns, save a scalar an `Expr` folds.
fn kernel_literals(graph: &Graph, checked: &Checked, scalars: &HashMap<String, f32>) -> Literals {
    return literal_tensors(
        graph,
        checked,
        |name| !scalars.contains_key(*name) || read_as_tensor(graph, checked, scalars, name),
    );
}

/// The folded tensors `build` reads as a tensor: all an operation reads as
/// one or the graph returns.
fn graph_literals(graph: &Graph, checked: &Checked) -> Literals {
    let mut read = HashSet::<String>::new();
    read_by_graph(&mut read, graph, checked);
    return literal_tensors(graph, checked, |name| read.contains(*name));
}

/// Into `read`, what the graph returns and what an operation `build` adds
/// reads as a tensor, in a branch's scope among them.
fn read_by_graph(read: &mut HashSet<String>, graph: &Graph, checked: &Checked) {
    for let vi of &graph.outputs {
        read.insert(vi.name);
    }
    for let node of graph.nodes {
        let lowering = lowering_of(&node, checked);
        if lowering matches { Folded } {
            continue;
        }
        if lowering matches { Branch } {
            for let b of branches(&node, checked) {
                read_by_graph(read, &b.graph, &b.checked);
            }
        }
        for let index of graph_operands(&node) {
            if node.has_operand(index) {
                read.insert(node.inputs[index]);
            }
        }
    }
}

/// The operands of `node` its operations read as tensors. The rest are
/// extents, positions or axes, which the build reads from the folded values.
fn graph_operands(node: &Node) -> List<i32> {
    if node.op == GROUP_QUERY_ATTENTION {
        let mut read: List<i32> = [0, 1, 2, 3, 4];
        if settled(attention_options(node)).rotary {
            read.push(ROTARY_COS);
            read.push(ROTARY_SIN);
        }
        read.push(ATTENTION_BIAS);
        return read;
    }
    return match node.op.as_str_slice() {
        "ConstantOfShape" | "Range" => [],
        "Reshape" | "Squeeze" | "Unsqueeze" | "Slice" | "Expand" | "Split" | "ReduceSum" | "ReduceMean" | "If" => [0],
        _ => (0..<node.inputs.len()).collect(),
    };
}

/// The folded tensors something reads as a tensor, those `wanted` keeps, each
/// spelled once under its axes.
fn literal_tensors(graph: &Graph, checked: &Checked, wanted: fn(&String) -> bool) -> Literals {
    let mut sources = HashMap::<String, String>::new();
    for let node of &graph.nodes {
        if is_alias(node, checked) && checked.known.contains_key(node.outputs[0]) {
            sources[node.outputs[0]] = node.inputs[0];
        }
    }
    let mut literals = Literals { spelled: [], aliases: HashMap::<String, String>::new() };
    let mut spelled_for = HashMap::<String, String>::new();
    for let [name, _] of checked.known.entries() {
        if !checked.shapes.contains_key(*name) || !wanted(name) {
            continue;
        }
        let mut root = *name;
        while let Some(source) = sources.get(root) {
            root = source;
        }
        let axes = axis_list(&checked.shapes[*name]);
        if let Some(spelled) = spelled_for.get(root) && axis_list(&checked.shapes[spelled]) == axes {
            literals.aliases[*name] = spelled;
            continue;
        }
        spelled_for.try_insert(root, *name);
        literals.spelled.push(*name);
    }
    return literals;
}

/// Whether a folded scalar is returned, or read where no `Expr` folds it.
fn read_as_tensor(graph: &Graph, checked: &Checked, scalars: &HashMap<String, f32>, scalar: &String) -> bool {
    if graph.outputs.position(|vi| vi.name == *scalar) matches { Some(_) } {
        return true;
    }
    for let node of graph.nodes {
        if checked.known.contains_key(node.outputs[0]) {
            continue;
        }
        for let [index, input] of node.inputs.into_iter().enumerate() {
            if input == *scalar && folded_literal(&node, index, scalars, &checked.shapes) matches { None } {
                return true;
            }
        }
    }
    return false;
}

/// A folded tensor spelled out as a `Tensor` literal for this pass, under the
/// shape stage 0 gave it. An element reading a valid length is a value the
/// graph computes, so `build` assembles those in the graph.
fn literal_tensor(
    checked: &Checked,
    tensor: &String,
    symbols: &mut Symbols,
    holder: Holder,
) -> Result<String, EmitError> {
    let shape = checked.shapes.get(*tensor).unwrap();
    let extents = symbols.spell_shape(&shape)?;
    let data = match checked.known.get(*tensor).unwrap().elements {
        Symbolic(v) => {
            if holder matches { Built } && v.into_iter().any(|p| symbols.reads_lengths(&p)) {
                let mut values: List<String> = [];
                for let p of v {
                    values.push(symbols.value(&p)?);
                }
                let typed = `${checked.primitives[*tensor]}, [${axis_list(&shape)}]`;
                return Result::Ok(
                    `assembled::<${BACKEND_PARAM}, ${typed}>(backend, [${values.join(", ")}], ${extents})`,
                );
            }
            let mut spelled: List<String> = [];
            for let p of v {
                spelled.push(symbols.spell(&p)?);
            }
            `[${spelled.join(", ")}]`;
        },
        constant => constant_elements(&constant),
    };
    return Result::Ok(`backend.upload(${host_literal(checked, tensor, data, extents)})`);
}

/// A folded tensor that no symbol enters, held by the backend for every pass:
/// one `forward` would otherwise rebuild and upload on each call, as large as
/// the context where it is a mask.
fn kept_literal(checked: &Checked, tensor: &String) -> String {
    let extents = static_extents(&checked.shapes[*tensor]).expect("a kept literal's shape is static");
    let data = constant_elements(&checked.known[*tensor].elements);
    return `backend.keep(${host_literal(checked, tensor, data, `${extents}`)})`;
}

/// The folded tensors in `literals` that no symbol enters, which `Prepared`
/// holds rather than `forward` building them.
fn kept_literals(literals: &Literals, checked: &Checked) -> List<String> {
    let mut kept: List<String> = [];
    for let tensor of literals.spelled {
        let constant = !checked.known[tensor].elements matches { Symbolic(_) };
        if constant && static_extents(&checked.shapes[tensor]) matches { Some(_) } {
            kept.push(tensor);
        }
    }
    return kept;
}

/// The shape's extents where each is a constant.
fn static_extents(shape: &Shape) -> Option<List<i64>> {
    let mut extents: List<i64> = [];
    for let axis of shape.axes {
        extents.push(axis.extent.poly().as_constant()?);
    }
    return Option::Some(extents);
}

/// The elements of a folded tensor no symbol enters, as a list expression.
fn constant_elements(elements: &Elements) -> String {
    return match *elements {
        Ints(v) => `${v}`,
        Floats(v) => {
            let spelled: List<String> = v.into_iter().map(|x| float_literal(x)).collect();
            `[${spelled.join(", ")}]`;
        },
        // A mask is as large as the context it covers, so it is spelled as
        // bytes, which the compiler folds into a data segment.
        Bools(v) => {
            let mut bytes = ByteList::with_capacity(v.len());
            for let b of v {
                bytes.push(if b { 1 } else { 0 });
            }
            `List::<u8>::from_le_bytes(${byte_string_literal(&bytes)}).into_iter().map(|b| b != 0).collect()`;
        },
        Symbolic(_) => unreachable(),
    };
}

/// A reference to the host `Tensor` of `data` over `extents`, typed as the
/// folded `tensor` is.
fn host_literal(checked: &Checked, tensor: &String, data: String, extents: String) -> String {
    let element = checked.primitives.get(*tensor).unwrap();
    let shape = checked.shapes.get(*tensor).unwrap();
    return `&Tensor::<${element}, [${axis_list(&shape)}]> { data: ${data}, extents: ${extents} }`;
}

/// An input axis whose length the graph spells as arithmetic over symbols,
/// which `forward` checks once it has bound them.
struct SpelledAxis {
    tensor: String,
    axis: String,
    /// The axis's extent as `forward` reads it off the input.
    extent: String,
    length: Poly,
}

/// The checks that stop a pass naming the axis an input disagrees on, before
/// any kernel reads the input.
struct InputChecks {
    /// What `pass` checks of the inputs the backend holds: their extents.
    held: List<String>,
    /// What `forward` checks of the inputs on the host before it uploads them:
    /// their extents, and that the data fills them. A past the cache holds is
    /// on the backend already, so only `pass` checks it.
    host: List<String>,
    /// The axes whose length is arithmetic over symbols, for `pass` to check
    /// once it has bound them.
    spelled: List<SpelledAxis>,
}

fn input_checks(graph: &Graph, shapes: &HashMap<String, Shape>, names: &Names, cached: &HashSet<String>) -> InputChecks {
    let mut checks = InputChecks { held: [], host: [], spelled: [] };
    let mut first_seen = HashMap::<String, String>::new();
    let mut agreements: List<String> = [];
    for let vi of &graph.inputs {
        let ident = names.get(&vi.name);
        let shape = shapes.get(vi.name).unwrap();
        let mut axes: List<String> = [];
        let mut stated: List<i32> = [];
        for let [i, axis] of shape.axes.into_iter().enumerate() {
            axes.push(wado`"${axis.name}"`);
            let extent = `backend.extents_of(${ident})[${i}]`;
            let Symbolic(length) = axis.extent else {
                stated.push(axis.static_extent());
                continue;
            };
            stated.push(-1);
            let Some(symbol) = axis.extent.lone_symbol() else {
                checks.spelled.push(SpelledAxis { tensor: vi.name, axis: axis.name, extent, length });
                continue;
            };
            if let Some(first) = first_seen.get(symbol) {
                agreements.push(
                    wado`refuse(axis_mismatch("${symbol}", "${vi.name}", "${axis.name}", ${extent}, ${first}));`,
                );
            } else {
                first_seen[symbol] = `${wado`"${vi.name}"`}, ${extent}`;
            }
        }
        let described = wado`"${vi.name}", [${axes.join(", ")}], ${stated}`;
        checks.held.push(`refuse(extents_mismatch(&backend.extents_of(${ident}), ${described}));`);
        if !cached.contains(vi.name) {
            checks.host.push(`refuse(input_mismatch(${ident}, ${described}));`);
        }
    }
    checks.held.extend(&agreements);
    return checks;
}

/// Whether a boundary tensor is held in something other than what the kernels
/// compute it in, so `forward` converts it on the way past.
fn converted(checked: &Checked, held: &HashMap<String, String>, tensor: &String) -> bool {
    return held.get(*tensor).unwrap() != checked.primitives.get(*tensor).unwrap();
}

/// A tensor's type, as the axis marker types name it. A tensor the boundary
/// does not declare is held in what stage 0 computes it in.
fn tensor_type(checked: &Checked, held: &HashMap<String, String>, tensor: &String) -> String {
    let shape = checked.shapes.get(*tensor).unwrap();
    let element = match held.get(*tensor) {
        Some(p) => p,
        None => checked.primitives.get(*tensor).unwrap(),
    };
    return `Tensor<${element}, [${axis_list(&shape)}]>`;
}

fn axis_list(shape: &Shape) -> String {
    return axis_run(shape, 0, shape.rank());
}

/// The names of `shape`'s axes `from..<to`, as a turbofish lists them.
fn axis_run(shape: &Shape, from: i32, to: i32) -> String {
    let mut names: List<String> = [];
    for let i of from..<to {
        names.push(shape.axes[i].name);
    }
    return names.join(", ");
}

/// One node as the kernel call that computes it. The operand expressions are
/// already in scope, since a graph's nodes are in topological order.
fn node_call(
    node: &Node,
    checked: &Checked,
    exprs: &Operands,
    symbols: &mut Symbols,
    opset: Option<i64>,
) -> Result<String, EmitError> {
    let shapes = &checked.shapes;
    let op = node.op;
    if op == "Reshape" || op == "Flatten" || op == "Unsqueeze" || op == "Squeeze" {
        return reshaped(node, checked, &exprs.reference(&node.inputs[0]), symbols);
    }
    if op == "Slice" {
        return slice_call(node, checked, exprs, symbols);
    }
    if op == "ConstantOfShape" {
        let out = shapes.get(node.outputs[0]).unwrap();
        let element = checked.primitives.get(node.outputs[0]).unwrap();
        let value = element_literal(&fill_of(node).unwrap().elements);
        return Result::Ok(
            `backend.filled::<${element}, [${axis_list(&out)}]>(${symbols.spell_shape(&out)?}, ${value})`,
        );
    }
    if op == "Range" {
        let [start, _, delta] = settled(range_bounds(node, &checked.known));
        let axis = shapes.get(node.outputs[0]).unwrap().axes[0];
        return Result::Ok(
            `backend.range_i64::<${axis.name}>(${symbols.spell(&start)?}, ${symbols.spell_extent(&axis.extent.poly())?}, ${symbols.spell(
                &delta,
            )?})`,
        );
    }
    if op == "Cast" {
        let from = checked.primitives.get(node.inputs[0]).unwrap();
        let to = checked.primitives.get(node.outputs[0]).unwrap();
        let axes = axis_list(&shapes.get(node.inputs[0]).unwrap());
        return Result::Ok(`backend.cast::<${from}, ${to}, [${axes}]>(${exprs.reference(&node.inputs[0])})`);
    }
    if op == "Gather" {
        let data = shapes.get(node.inputs[0]).unwrap();
        let axis = settled(gather_axis(node, data.rank()));
        let operand = exprs.reference(&node.inputs[0]);
        let indices = exprs.reference(&node.inputs[1]);
        if axis == 0 && exprs.rhs.contains_key(node.inputs[0]) {
            return Result::Ok(`backend.gather_rhs_rows(${operand}, ${indices})`);
        }
        if axis == 0 {
            return Result::Ok(`backend.gather_rows(${operand}, ${indices})`);
        }
        let element = checked.primitives.get(node.inputs[0]).unwrap();
        let pre = axis_run(&data, 0, axis);
        let post = axis_run(&data, axis + 1, data.rank());
        let index_axes = axis_list(&shapes.get(node.inputs[1]).unwrap());
        let turbofish = `::<${element}, [${pre}], ${data.axes[axis].name}, [${post}], [${index_axes}]>`;
        return Result::Ok(`backend.gather${turbofish}(${operand}, ${indices}, ${axis})`);
    }
    if op == "MaxPool" {
        return max_pool_call(node, shapes, exprs, symbols);
    }
    if op == "Where" {
        let out = shapes.get(node.outputs[0]).unwrap();
        let mut operands: List<String> = [];
        for let tensor of node.inputs {
            let shape = shapes.get(tensor).unwrap();
            let element = checked.primitives.get(tensor).unwrap();
            operands.push(under_axes_of(&exprs.reference(&tensor), &shape, &out, &element));
        }
        return Result::Ok(`backend.select(${operands.join(", ")})`);
    }
    if op == "Softmax" {
        let lane = settled(softmax_lane(node, shapes.get(node.inputs[0]).unwrap().rank(), opset));
        let kernel = if lane.flattened { "softmax_flattened" } else { "softmax" };
        return Result::Ok(`backend.${kernel}(${exprs.reference(&node.inputs[0])}, ${lane.axis})`);
    }
    if is_reduction(&op) {
        return reduction_call(node, checked, exprs, symbols);
    }
    if op == "Concat" {
        return Result::Ok(concat_call(node, checked, exprs));
    }
    if op == "Expand" {
        let element = checked.primitives.get(node.inputs[0]).unwrap();
        let from = shapes.get(node.inputs[0]).unwrap();
        let to = shapes.get(node.outputs[0]).unwrap();
        return Result::Ok(
            `backend.expand::<${element}, [${axis_list(&from)}], [${axis_list(&to)}]>(${exprs.reference(&node.inputs[0])}, ${symbols.spell_shape(
                &to,
            )?})`,
        );
    }
    if op == "Transpose" {
        let shape = shapes.get(node.inputs[0]).unwrap();
        let perm = settled(transpose_perm(node, shape.rank()));
        // Every node result is bound as a value, so the operand is read as one.
        if is_identity(&perm) {
            return Result::Ok(exprs.value(&node.inputs[0]));
        }
        let a = exprs.reference(&node.inputs[0]);
        let element = checked.primitives.get(node.inputs[0]).unwrap();
        let to = shapes.get(node.outputs[0]).unwrap();
        return Result::Ok(`backend.permute::<${element}, [${axis_list(&shape)}], [${axis_list(&to)}]>(${a}, ${perm})`);
    }
    // `node_term` took every other operator stage 0 lowers.
    unreachable();
}

/// One node as the operations of `Graph` that compute it, nested in one
/// expression. The operand expressions are already in scope, since a graph's
/// nodes are in topological order.
fn built_call(
    node: &Node,
    checked: &Checked,
    exprs: &Operands,
    symbols: &mut Symbols,
    opset: Option<i64>,
) -> Result<String, EmitError> {
    let shapes = &checked.shapes;
    let op = node.op;
    let out = shapes[node.outputs[0]];
    let axes = axis_list(&out);
    let element = checked.primitives[node.outputs[0]];
    let operand = |index: i32| exprs.reference(&node.inputs[index]);
    if op == "Reshape" || op == "Flatten" || op == "Unsqueeze" || op == "Squeeze" {
        return reshaped(node, checked, &operand(0), symbols);
    }
    if op == "Slice" {
        return built_slice(node, checked, exprs, symbols);
    }
    if op == "ConstantOfShape" {
        let value = element_literal(&fill_of(node).unwrap().elements);
        return Result::Ok(
            `full::<${BACKEND_PARAM}, ${element}, [${axes}]>(backend, ${value}, ${symbols.spell_shape(&out)?})`,
        );
    }
    if op == "Range" {
        let [start, _, delta] = settled(range_bounds(node, &checked.known));
        let count = symbols.spell_extent(&out.axes[0].extent.poly())?;
        return Result::Ok(
            `range_i64::<${BACKEND_PARAM}, ${axes}>(backend, &${symbols.value(&start)?}, ${count}, &${symbols.value(
                &delta,
            )?})`,
        );
    }
    if op == "Cast" {
        let from = checked.primitives[node.inputs[0]];
        return Result::Ok(`backend.convert::<${from}, ${element}, [${axes}]>(${operand(0)})`);
    }
    if op == "Gather" {
        return built_gather(node, checked, exprs, symbols);
    }
    if op == "MaxPool" {
        return built_max_pool(node, shapes, exprs, symbols);
    }
    if op == "Where" {
        let mut operands: List<String> = [];
        for let tensor of node.inputs {
            operands.push(stretched(checked, exprs, symbols, &tensor, &out, 0)?);
        }
        return Result::Ok(`backend.select::<${element}, [${axes}]>(${operands.join(", ")})`);
    }
    if op == "Softmax" {
        let lane = settled(softmax_lane(node, out.rank(), opset));
        let helper = if lane.flattened { "softmax_flattened" } else { "softmax" };
        let normalized: List<i32> = if lane.flattened { (lane.axis..<out.rank()).collect() } else { [lane.axis] };
        let mut x = operand(0);
        for let axis of normalized {
            x = masked_along(x, &out, axis, float_literal(f32::NEG_INFINITY), symbols)?;
        }
        return Result::Ok(`${helper}::<${BACKEND_PARAM}, [${axes}]>(backend, ${x}, ${lane.axis})`);
    }
    if is_reduction(&op) {
        return built_reduction(node, checked, exprs, symbols);
    }
    if op == "Concat" {
        return built_concat(node, checked, exprs, symbols);
    }
    if op == "Expand" {
        return broadcast_call(&element, &shapes[node.inputs[0]], &out, &operand(0), 0, symbols);
    }
    if op == "Transpose" {
        let x = shapes[node.inputs[0]];
        let perm = settled(transpose_perm(node, x.rank()));
        if is_identity(&perm) {
            return Result::Ok(exprs.value(&node.inputs[0]));
        }
        return Result::Ok(`backend.transpose::<${element}, [${axis_list(&x)}], [${axes}]>(${operand(0)}, ${perm})`);
    }
    if op == "MatMul" {
        return built_matmul(node, checked, exprs, symbols);
    }
    if op == "Gemm" {
        return built_gemm(node, checked, exprs, symbols);
    }
    if op == "Conv" {
        return built_conv(node, checked, exprs, symbols);
    }
    if let Some(binary) = case_named::<BinaryOp>(&op) {
        let trailing = settled(trailing_axes(node, shapes[node.inputs[0]].rank(), shapes[node.inputs[1]].rank()));
        let a = stretched(checked, exprs, symbols, &node.inputs[0], &out, 0)?;
        let b = stretched(checked, exprs, symbols, &node.inputs[1], &out, trailing)?;
        let name = match binary {
            Add => "Add",
            Sub => "Subtract",
            Mul => "Multiply",
            Div => "Divide",
            Pow => "Power",
        };
        return Result::Ok(`backend.binary::<${element}, [${axes}]>(Binary::${name}, ${a}, ${b})`);
    }
    // Stage 0 refuses every operator the graph lowers no other way.
    let unary = case_named::<UnaryOp>(&op).unwrap();
    if unary matches { Relu } {
        let zero = `&full::<${BACKEND_PARAM}, f32, [${axes}]>(backend, 0 as f32, ${symbols.spell_shape(&out)?})`;
        return Result::Ok(`backend.binary::<f32, [${axes}]>(Binary::Maximum, ${operand(0)}, ${zero})`);
    }
    let name = match unary {
        Relu => unreachable(),
        Sigmoid => "Logistic",
        Tanh => "Tanh",
        Erf => "Erf",
        Exp => "Exponential",
        Log => "Log",
        Sqrt => "Sqrt",
        Neg => "Negate",
        Abs => "Abs",
    };
    return Result::Ok(`backend.unary::<[${axes}]>(Unary::${name}, ${operand(0)})`);
}

/// `operand`, of axes `from`, broadcast to `to`'s axes, its axes meeting
/// `to`'s `trailing` axes before the end.
fn broadcast_call(
    element: &String,
    from: &Shape,
    to: &Shape,
    operand: &String,
    trailing: i32,
    symbols: &mut Symbols,
) -> Result<String, EmitError> {
    let first = to.rank() - from.rank() - trailing;
    let dims: List<i32> = (first..<first + from.rank()).collect();
    return Result::Ok(
        `backend.broadcast_in_dim::<${*element}, [${axis_list(from)}], [${axis_list(to)}]>(${*operand}, ${symbols.spell_shape(
            to,
        )?}, ${dims})`,
    );
}

/// `tensor` read under `out`'s axes: as it is where they are its own, and
/// broadcast to them otherwise. An axis of 1 may share its name with the one
/// it stretches over, so the names alone do not say they are one.
fn stretched(
    checked: &Checked,
    exprs: &Operands,
    symbols: &mut Symbols,
    tensor: &String,
    out: &Shape,
    trailing: i32,
) -> Result<String, EmitError> {
    let shape = checked.shapes[*tensor];
    if same_axes(&shape, out) {
        return Result::Ok(exprs.reference(tensor));
    }
    let element = checked.primitives[*tensor];
    return Result::Ok(`&${broadcast_call(&element, &shape, out, &exprs.reference(tensor), trailing, symbols)?}`);
}

/// The value `operand` refers to, of axes `shape`, times `factor`.
fn scaled(operand: &String, shape: &Shape, factor: f32, symbols: &mut Symbols) -> Result<String, EmitError> {
    let axes = axis_list(shape);
    let by = `&full::<${BACKEND_PARAM}, f32, [${axes}]>(backend, ${float_literal(factor)}, ${symbols.spell_shape(shape)?})`;
    return Result::Ok(`backend.binary::<f32, [${axes}]>(Binary::Multiply, ${*operand}, ${by})`);
}

/// `dot_general` of `lhs`, of axes `left`, by `rhs`, of axes `right`, into
/// `out`, over the axes `batch` on both sides, contracting the left's axis
/// `contracting.0` with the right's `contracting.1`. A contraction sums over
/// its padding as a sum does, so where a valid length enters it, both
/// operands hold zeros there: either may hold anything in its own.
fn dot_call(
    left: &Shape,
    right: &Shape,
    out: &Shape,
    lhs: &String,
    rhs: &String,
    batch: List<i32>,
    contracting: [i32, i32],
    symbols: &mut Symbols,
) -> Result<String, EmitError> {
    let [l, r] = contracting;
    let dims = `&DotDims { lhs_batch: ${batch}, rhs_batch: ${batch}, lhs_contracting: [${l}], rhs_contracting: [${r}] }`;
    let [a, b] = [
        masked_along(*lhs, left, l, "0 as f32", symbols)?,
        masked_along(*rhs, right, r, "0 as f32", symbols)?,
    ];
    return Result::Ok(
        `backend.dot_general::<[${axis_list(left)}], [${axis_list(right)}], [${axis_list(out)}]>(${a}, ${b}, ${dims})`,
    );
}

/// A `MatMul` as `dot_general`. A right operand of rank 2 or less, or a left
/// one of rank 1, leaves no batch axis; otherwise both stretch their batch
/// axes to the output's. A weight's transpose is read as the weight, its rows
/// the product's columns.
fn built_matmul(node: &Node, checked: &Checked, exprs: &Operands, symbols: &mut Symbols) -> Result<String, EmitError> {
    let shapes = &checked.shapes;
    let out = shapes[node.outputs[0]];
    let left = shapes[node.inputs[0]];
    let a = exprs.reference(&node.inputs[0]);
    let last = left.rank() - 1;
    if let Some(weight) = exprs.transposed.get(node.inputs[1]) {
        return dot_call(&left, &shapes[weight], &out, &a, &exprs.reference(&weight), [], [last, 1], symbols);
    }
    let right = shapes[node.inputs[1]];
    let b = exprs.reference(&node.inputs[1]);
    if right.rank() <= 2 || left.rank() == 1 {
        let contracted = if right.rank() == 1 { 0 } else { right.rank() - 2 };
        return dot_call(&left, &right, &out, &a, &b, [], [last, contracted], symbols);
    }
    let batch = out.rank() - 2;
    let under_batch = |matrix: &Shape| {
        let mut axes = out.axes[0..<batch].to_list();
        axes.extend(&matrix.axes[matrix.rank() - 2..<matrix.rank()].to_list());
        return Shape { axes };
    };
    let [lhs, rhs] = [
        under_batch(&left),
        under_batch(&right),
    ];
    return dot_call(
        &lhs,
        &rhs,
        &out,
        &stretched(checked, exprs, symbols, &node.inputs[0], &lhs, 0)?,
        &stretched(checked, exprs, symbols, &node.inputs[1], &rhs, 0)?,
        (0..<batch).collect(),
        [batch + 1, batch],
        symbols,
    );
}

/// `Gemm`'s `alpha * A' * B' + beta * C`: `dot_general` contracting the axes
/// `transA` and `transB` choose, its scalars, and its bias broadcast to the
/// output, whose axes the bias may rename where they meet at an extent of 1.
fn built_gemm(node: &Node, checked: &Checked, exprs: &Operands, symbols: &mut Symbols) -> Result<String, EmitError> {
    let shapes = &checked.shapes;
    let [alpha, beta, trans_a, trans_b] = settled(gemm_options(node));
    let product = gemm_product(node, shapes);
    let mut call = dot_call(
        &shapes[node.inputs[0]],
        &shapes[node.inputs[1]],
        &product,
        &exprs.reference(&node.inputs[0]),
        &exprs.reference(&node.inputs[1]),
        [],
        [if trans_a { 0 } else { 1 }, if trans_b { 1 } else { 0 }],
        symbols,
    )?;
    if alpha != 1.0 {
        call = scaled(&`&${call}`, &product, alpha, symbols)?;
    }
    if !has_bias(node) {
        return Result::Ok(call);
    }
    let out = shapes[node.outputs[0]];
    if !same_axes(&product, &out) {
        call = broadcast_call(&KERNEL_ELEMENT, &product, &out, &`&${call}`, 0, symbols)?;
    }
    let mut bias = stretched(checked, exprs, symbols, &node.inputs[2], &out, 0)?;
    if beta != 1.0 {
        bias = `&${scaled(&bias, &out, beta, symbols)?}`;
    }
    return Result::Ok(`backend.binary::<f32, [${axis_list(&out)}]>(Binary::Add, &${call}, ${bias})`);
}

/// A `Conv` as `convolution`, its bias broadcast along the output's channels.
fn built_conv(node: &Node, checked: &Checked, exprs: &Operands, symbols: &mut Symbols) -> Result<String, EmitError> {
    let shapes = &checked.shapes;
    let x = shapes[node.inputs[0]];
    let w = shapes[node.inputs[1]];
    let y = shapes[node.outputs[0]];
    // Stage 0 owed these already.
    let window = settled(window_of(node, &x, shapes, &mut [], &Axes {}));
    let spatial = x.rank() - 2;
    let mut pads: List<String> = [];
    for let i of 0..<spatial {
        pads.push(symbols.spell_extent(&window.pads[i])?);
        pads.push(symbols.spell_extent(&window.pads[spatial + i])?);
    }
    let conv = `&Convolution { window_strides: ${window.strides}, padding: [${pads.join(
        ", ",
    )}], rhs_dilation: ${window.dilations}, feature_group_count: ${settled(conv_group(node, &w))} }`;
    let call = `backend.convolution::<[${axis_list(&x)}], [${axis_list(&w)}], [${axis_list(&y)}]>(${exprs.reference(
        &node.inputs[0],
    )}, ${exprs.reference(&node.inputs[1])}, ${conv})`;
    if !has_bias(node) {
        return Result::Ok(call);
    }
    let bias = broadcast_call(
        &KERNEL_ELEMENT,
        &shapes[node.inputs[2]],
        &y,
        &exprs.reference(&node.inputs[2]),
        spatial,
        symbols,
    )?;
    return Result::Ok(`backend.binary::<f32, [${axis_list(&y)}]>(Binary::Add, &${call}, &${bias})`);
}

/// A `MaxPool` as `reduce_window` by the greatest, the batch and channel axes
/// windows of one. Each high padding is what the last window reaches past the
/// input, which `ceil_mode` may take past the padding the node declares, or 0
/// where the last window ends short of the input's end.
fn built_max_pool(
    node: &Node,
    shapes: &HashMap<String, Shape>,
    exprs: &Operands,
    symbols: &mut Symbols,
) -> Result<String, EmitError> {
    let x = shapes[node.inputs[0]];
    let y = shapes[node.outputs[0]];
    // Stage 0 owed these already.
    let window = settled(window_of(node, &x, shapes, &mut [], &Axes {}));
    let mut dimensions: List<i32> = [1, 1];
    let mut strides: List<i32> = [1, 1];
    let mut dilations: List<i32> = [1, 1];
    let mut pads: List<String> = ["0", "0", "0", "0"];
    for let i of 0..<x.rank() - 2 {
        let [k, s, d] = [window.kernel[i], window.strides[i], window.dilations[i]];
        dimensions.push(k);
        strides.push(s);
        dilations.push(d);
        let low = window.pads[i];
        let reach = Poly::constant(((k - 1) * d + 1) as i64);
        let last_start = window.output[i].try_sub(&Poly::constant(1)).unwrap().try_mul(&Poly::constant(s as i64)).unwrap();
        let reached = last_start.try_add(&reach).unwrap().try_sub(&x.axes[2 + i].extent.poly()).unwrap().try_sub(&low).unwrap();
        let high = Poly::max_of(&reached, &Poly::constant(0), &node.site());
        pads.push(symbols.spell_extent(&low)?);
        pads.push(symbols.spell_extent(&high)?);
    }
    let reduce = `&WindowReduce { window_dimensions: ${dimensions}, window_strides: ${strides}, window_dilations: ${dilations}, padding: [${pads.join(
        ", ",
    )}] }`;
    return Result::Ok(
        `backend.reduce_window::<[${axis_list(&x)}], [${axis_list(&y)}]>(${exprs.reference(&node.inputs[0])}, Binary::Maximum, ${float_literal(
            f32::NEG_INFINITY,
        )}, ${reduce})`,
    );
}

/// A `Gather` as StableHLO's, each index counted from the end where negative:
/// one start index per index element, the gathered axis collapsed, and the
/// operand's other axes kept whole around the index's.
fn built_gather(node: &Node, checked: &Checked, exprs: &Operands, symbols: &mut Symbols) -> Result<String, EmitError> {
    let shapes = &checked.shapes;
    let data = shapes[node.inputs[0]];
    let indices = shapes[node.inputs[1]];
    let out = shapes[node.outputs[0]];
    let axis = settled(gather_axis(node, data.rank()));
    let rank = indices.rank();
    let offset_dims: List<i32> = (0..<out.rank()).filter(|d| d < axis || d >= axis + rank).collect();
    let mut sizes: List<String> = [];
    for let [a, extent] of data.extents().into_iter().enumerate() {
        sizes.push(if a == axis { "1" } else { symbols.spell_extent(&extent.poly())? });
    }
    let index_axes = axis_list(&indices);
    let wrapped = `&from_end_indices::<${BACKEND_PARAM}, [${index_axes}]>(backend, ${exprs.reference(
        &node.inputs[1],
    )}, &${symbols.value(&data.axes[axis].extent.poly())?})`;
    let dims = `&GatherDims { offset_dims: ${offset_dims}, collapsed_slice_dims: [${axis}], start_index_map: [${axis}], index_vector_dim: ${rank}, slice_sizes: [${sizes.join(
        ", ",
    )}] }`;
    let element = checked.primitives[node.inputs[0]];
    return Result::Ok(
        `backend.gather::<${element}, [${axis_list(&data)}], [${index_axes}], [${axis_list(&out)}]>(${exprs.reference(
            &node.inputs[0],
        )}, ${wrapped}, ${dims})`,
    );
}

/// A `ReduceMean` or `ReduceSum` as `reduce`, which drops the reduced axes, and
/// a reshape where the node keeps them.
fn built_reduction(node: &Node, checked: &Checked, exprs: &Operands, symbols: &mut Symbols) -> Result<String, EmitError> {
    let x = checked.shapes[node.inputs[0]];
    let out = checked.shapes[node.outputs[0]];
    let reduced = settled(reduced_axes(node, &checked.known, x.rank()));
    let mut kept = Shape { axes: [] };
    for let [i, axis] of x.axes.into_iter().enumerate() {
        if !reduced.contains(&i) {
            kept.axes.push(axis);
        }
    }
    let types = `[${axis_list(&x)}], [${axis_list(&kept)}]`;
    let mut a = exprs.reference(&node.inputs[0]);
    let mut count = Poly::constant(1);
    for let d of reduced {
        a = masked_along(a, &x, d, "0 as f32", symbols)?;
        count = count.try_mul(&x.axes[d].extent.poly()).expect("a count of elements is within i64");
    }
    let call = if node.op == "ReduceMean" {
        `reduce_mean::<${BACKEND_PARAM}, ${types}>(backend, ${a}, ${reduced}, &${symbols.value(&count)?})`;
    } else {
        `backend.reduce::<${types}>(${a}, Binary::Add, 0 as f32, ${reduced})`;
    };
    if axis_list(&kept) == axis_list(&out) {
        return Result::Ok(call);
    }
    return Result::Ok(
        `backend.reshape::<f32, [${axis_list(&kept)}], [${axis_list(&out)}]>(&${call}, ${symbols.spell_shape(&out)?})`,
    );
}

/// A `Concat` as `concatenate` folded over its operands from the left, each
/// partial join under the output's axes. Where the join so far reads a valid
/// length, the next part is written from it on, past which the join's padding
/// lies.
fn built_concat(node: &Node, checked: &Checked, exprs: &Operands, symbols: &mut Symbols) -> Result<String, EmitError> {
    let shapes = &checked.shapes;
    let out = axis_list(&shapes[node.outputs[0]]);
    let axis = settled(concat_axis(node, shapes[node.outputs[0]].rank()));
    let element = checked.primitives[node.outputs[0]];
    // A single operand is joined to nothing, and every result is bound as a value.
    let mut call = exprs.value(&node.inputs[0]);
    let mut left = exprs.reference(&node.inputs[0]);
    let mut left_axes = axis_list(&shapes[node.inputs[0]]);
    let mut length = shapes[node.inputs[0]].axes[axis].extent.poly();
    for let input of node.inputs[1..<node.inputs.len()].to_list() {
        let right = shapes[input];
        let types = `${element}, [${left_axes}], [${axis_list(&right)}], [${out}]`;
        let operands = `${left}, ${exprs.reference(&input)}, ${axis}`;
        call = if symbols.reads_lengths(&length) {
            `joined_at::<${BACKEND_PARAM}, ${types}>(backend, ${operands}, &${symbols.value(&length)?})`;
        } else {
            `backend.concatenate::<${types}>(${operands})`;
        };
        left = `&${call}`;
        left_axes = out;
        length = length.try_add(&right.axes[axis].extent.poly()).expect("a joined extent is within i64");
    }
    return Result::Ok(call);
}

/// `operand`, of axes `shape`, its padding along `axis` read as `fill`, where
/// a valid length enters that axis's extent.
fn masked_along(
    operand: String,
    shape: &Shape,
    axis: i32,
    fill: String,
    symbols: &mut Symbols,
) -> Result<String, EmitError> {
    let extent = shape.axes[axis].extent.poly();
    if !symbols.reads_lengths(&extent) {
        return Result::Ok(operand);
    }
    let typed = `${KERNEL_ELEMENT}, [${axis_list(shape)}]`;
    return Result::Ok(
        `&masked::<${BACKEND_PARAM}, ${typed}>(backend, ${operand}, ${axis}, &${symbols.value(&extent)?}, ${fill})`,
    );
}

/// The starts, limits and strides of a `slice` keeping every axis of `x` whole.
struct Bounds {
    starts: List<String>,
    limits: List<String>,
    strides: List<i64>,
}

impl Bounds {
    fn whole(x: &Shape, symbols: &mut Symbols) -> Result<Bounds, EmitError> {
        let mut limits: List<String> = [];
        for let extent of x.extents() {
            limits.push(symbols.spell_extent(&extent.poly())?);
        }
        return Result::Ok(Bounds {
            starts: List::<String>::filled(x.rank(), "0"),
            limits,
            strides: List::<i64>::filled(x.rank(), 1),
        });
    }

    /// `slice` over `operand`, of axes `x`, into `out`.
    fn sliced(&self, element: &String, x: &Shape, out: &Shape, operand: &String) -> String {
        return `backend.slice::<${*element}, [${axis_list(x)}], [${axis_list(out)}]>(${*operand}, [${self.starts.join(
            ", ",
        )}], [${self.limits.join(", ")}], ${self.strides})`;
    }
}

/// A `Slice` as one `slice`. An axis cut backwards is reversed first, where
/// its cut starts at the mirror of its start; an empty cut starts at 0. A cut
/// starting at a valid length is a `strided_gather` first, since a `slice`
/// starts where the capacity says.
fn built_slice(node: &Node, checked: &Checked, exprs: &Operands, symbols: &mut Symbols) -> Result<String, EmitError> {
    let mut x = checked.shapes[node.inputs[0]];
    let out = checked.shapes[node.outputs[0]];
    let all = settled(slice_cuts(node, &checked.known, &x));
    // A slice that narrows nothing is its operand, read as a value.
    if all.is_empty() {
        return Result::Ok(exprs.value(&node.inputs[0]));
    }
    let element = checked.primitives[node.inputs[0]];
    let mut cuts: List<Cut> = [];
    let mut gathered: Option<String> = null;
    let operand_of = |so_far: &Option<String>| match so_far {
        Some(call) => `&${*call}`,
        None => exprs.reference(&node.inputs[0]),
    };
    for let cut of all {
        let length = cut.extent.poly();
        if !symbols.reads_lengths(&cut.start) || length.as_constant() == Option::Some(0) {
            cuts.push(cut);
            continue;
        }
        let operand = operand_of(&gathered);
        let mut to = x;
        to.axes[cut.axis] = out.axes[cut.axis];
        let typed = `${element}, [${axis_list(&x)}], [${axis_list(&to)}]`;
        gathered = Option::Some(
            `strided_gather::<${BACKEND_PARAM}, ${typed}>(backend, ${operand}, ${cut.axis}, &${symbols.value(
                &cut.start,
            )?}, ${symbols.spell_extent(&length)?}, ${cut.step})`,
        );
        x = to;
    }
    if let Some(call) = gathered && cuts.is_empty() {
        return Result::Ok(call);
    }
    let mut bounds = Bounds::whole(&x, symbols)?;
    let mut reversed: List<i32> = [];
    for let cut of cuts {
        let a = cut.axis;
        let stride = i64::abs(cut.step);
        bounds.strides[a] = stride;
        let length = cut.extent.poly();
        if length.as_constant() == Option::Some(0) {
            bounds.starts[a] = "0";
            bounds.limits[a] = "0";
            continue;
        }
        let start = if cut.step < 0 {
            reversed.push(a);
            x.axes[a].extent.poly().try_sub(&Poly::constant(1)).unwrap().try_sub(&cut.start).unwrap();
        } else {
            cut.start;
        };
        let from = symbols.spell_extent(&start)?;
        bounds.limits[a] = if let Some(n) = length.as_constant() {
            symbols.spell_extent(&start.try_add(&Poly::constant((n - 1) * stride + 1)).unwrap())?;
        } else {
            // The cut's last element is within the axis, and one stride past it may not be.
            `i32::min(${from} + ${symbols.spell_extent(&length)?} * ${stride}, ${bounds.limits[a]})`;
        };
        bounds.starts[a] = from;
    }
    let mut operand = operand_of(&gathered);
    if !reversed.is_empty() {
        operand = `&backend.reverse::<${element}, [${axis_list(&x)}]>(${operand}, ${reversed})`;
    }
    return Result::Ok(bounds.sliced(&element, &x, &out, &operand));
}

/// A `Split` as one `slice` per output, each taking the next run of the axis.
fn built_split(
    node: &Node,
    checked: &Checked,
    exprs: &Operands,
    symbols: &mut Symbols,
) -> Result<List<String>, EmitError> {
    let x = checked.shapes[node.inputs[0]];
    // Stage 0 owed these already.
    let parts = settled(split_parts(node, &checked.known, &x, &mut []));
    let axis = settled(split_axis(node, x.rank()));
    let element = checked.primitives[node.inputs[0]];
    let operand = exprs.reference(&node.inputs[0]);
    let mut bounds = Bounds::whole(&x, symbols)?;
    let mut calls: List<String> = [];
    let mut start = Poly::constant(0);
    for let [i, part] of parts.into_iter().enumerate() {
        // The parts sum to the axis, so every running sum is within it.
        let limit = start.try_add(&part).unwrap();
        bounds.starts[axis] = symbols.spell_extent(&start)?;
        bounds.limits[axis] = symbols.spell_extent(&limit)?;
        calls.push(bounds.sliced(&element, &x, &checked.shapes[node.outputs[i]], &operand));
        start = limit;
    }
    return Result::Ok(calls);
}

/// One node as the `Term` it computes, for an elementwise operator, a
/// contraction or a fold along a row, which a later kernel may take in.
/// `None` for every other operator.
fn node_term(
    node: &Node,
    checked: &Checked,
    exprs: &Operands,
    symbols: &mut Symbols,
    opset: Option<i64>,
    spread: &Option<Spread>,
) -> Result<Option<Term>, EmitError> {
    let shapes = &checked.shapes;
    let op = node.op;
    let out = shapes.get(node.outputs[0]).unwrap();
    if let Some(s) = spread {
        return Result::Ok(Option::Some(gemm_term(node, shapes, exprs, Option::Some(spread_product(s, shapes, exprs)))));
    }
    if let Some(fold) = row_fold(node, checked, opset) {
        let x = lane_of(node, 0, shapes, exprs, 0);
        let expr = match fold {
            Sum(count) => x.expr.row_sum(count),
            Softmax => x.expr.row_softmax(),
        };
        return Result::Ok(Option::Some(Term { lanes: x.lanes, expr }));
    }
    if selects_floats(node, checked) {
        let cond = node.inputs[0];
        let condition = Term::condition(exprs.reference(&cond), shapes.get(cond).unwrap());
        let then = lane_of(node, 1, shapes, exprs, 0);
        let otherwise = lane_of(node, 2, shapes, exprs, 0);
        return Result::Ok(Option::Some(condition.select(&then, &otherwise)));
    }
    if op == "MatMul" {
        if let Some(weight) = exprs.transposed.get(node.inputs[1]) {
            let a = exprs.reference(&node.inputs[0]);
            let kernel = if exprs.rhs.contains_key(weight) {
                "matmul_by_rhs_transposed";
            } else {
                "matmul_by_transposed";
            };
            let head = `backend.${kernel}(${a}, ${exprs.reference(&weight)}`;
            return Result::Ok(Option::Some(Term::after(Product::of(head), out)));
        }
        let head = if exprs.rhs.contains_key(node.inputs[1]) {
            Product::by_rhs(exprs.left(&node.inputs[0]), exprs.reference(&node.inputs[1]), node.inputs[1]);
        } else {
            let [a, b, left, right] = binary_call(node, shapes, exprs);
            Product::of(product_head(&a, &b, &left, &right, &out));
        };
        return Result::Ok(Option::Some(Term::after(head, out)));
    }
    if op == "Conv" {
        return Result::Ok(Option::Some(Term::after(Product::of(conv_head(node, shapes, exprs, symbols)?), out)));
    }
    if op == "Gemm" {
        return Result::Ok(Option::Some(gemm_term(node, shapes, exprs, null)));
    }
    if is_binary_elementwise(&op) {
        return Result::Ok(Option::Some(binary_term(node, shapes, exprs)));
    }
    if let Some(unary) = case_named::<UnaryOp>(&op) {
        return Result::Ok(Option::Some(lane_of(node, 0, shapes, exprs, 0).unary(unary)));
    }
    return Result::Ok(null);
}

/// The node's operand `index` as a `Term`: the one a fused kernel before it
/// left pending, or else the tensor read whole, met `trailing` axes before
/// the output's end.
fn lane_of(node: &Node, index: i32, shapes: &HashMap<String, Shape>, exprs: &Operands, trailing: i32) -> Term {
    let tensor = node.inputs[index];
    if let Some(pending) = exprs.pending.get(tensor) {
        // The plan fuses only a tensor of the reader's own axes.
        assert trailing == 0;
        return pending;
    }
    return Term::of(exprs.reference(&tensor), shapes.get(tensor).unwrap(), trailing);
}

/// A `Split` as one `slice_axis` per output, each cutting the next run.
fn split_calls(
    node: &Node,
    checked: &Checked,
    exprs: &Operands,
    symbols: &mut Symbols,
) -> Result<List<String>, EmitError> {
    let shapes = &checked.shapes;
    let x = shapes.get(node.inputs[0]).unwrap();
    // Stage 0 owed these already.
    let parts = settled(split_parts(node, &checked.known, &x, &mut []));
    let axis = settled(split_axis(node, x.rank()));
    let element = checked.primitives.get(node.inputs[0]).unwrap();
    let operand = exprs.reference(&node.inputs[0]);
    let mut calls: List<String> = [];
    let mut start = Poly::constant(0);
    for let [i, part] of parts.into_iter().enumerate() {
        let part_axis = shapes.get(node.outputs[i]).unwrap().axes[axis].name;
        let range = [
            symbols.spell(&start)?,
            symbols.spell_extent(&part)?,
        ];
        calls.push(slice_axis_call(&element, &x, axis, &part_axis, &operand, range, 1));
        // The parts sum to the axis, so every running sum is within it.
        start = start.try_add(&part).unwrap();
    }
    return Result::Ok(calls);
}

/// A `Slice` as one `slice_axis` per axis it narrows, each call reading the
/// last. The axes between are the output's where already cut, the input's where not.
fn slice_call(node: &Node, checked: &Checked, exprs: &Operands, symbols: &mut Symbols) -> Result<String, EmitError> {
    let x = checked.shapes.get(node.inputs[0]).unwrap();
    let out = checked.shapes.get(node.outputs[0]).unwrap();
    let element = checked.primitives.get(node.inputs[0]).unwrap();
    let cuts = settled(slice_cuts(node, &checked.known, &x));
    // A slice that narrows nothing is its operand, read as a value.
    let mut call = exprs.value(&node.inputs[0]);
    let mut operand = exprs.reference(&node.inputs[0]);
    let mut current = x;
    for let cut of cuts {
        let a = cut.axis;
        let range = [
            symbols.spell(&cut.start)?,
            symbols.spell_extent(&cut.extent.poly())?,
        ];
        call = slice_axis_call(&element, &current, a, &out.axes[a].name, &operand, range, cut.step);
        operand = `&${call}`;
        current.axes[a] = out.axes[a];
    }
    return Result::Ok(call);
}

/// A `Concat` as `concat` folded over its operands from the left, each partial
/// join naming the joined axis as the output does.
fn concat_call(node: &Node, checked: &Checked, exprs: &Operands) -> String {
    let shapes = &checked.shapes;
    let out = shapes.get(node.outputs[0]).unwrap();
    let axis = settled(concat_axis(node, out.rank()));
    let element = checked.primitives.get(node.outputs[0]).unwrap();
    let [pre, post] = [
        axis_run(&out, 0, axis),
        axis_run(&out, axis + 1, out.rank()),
    ];
    let joined = out.axes[axis].name;
    // A single operand is joined to nothing, and every result is bound as a value.
    let mut call = exprs.value(&node.inputs[0]);
    let mut left = exprs.reference(&node.inputs[0]);
    let mut left_axis = shapes.get(node.inputs[0]).unwrap().axes[axis].name;
    for let input of node.inputs[1..<node.inputs.len()].to_list() {
        let right_axis = shapes.get(input).unwrap().axes[axis].name;
        let turbofish = `::<${element}, [${pre}], ${left_axis}, ${right_axis}, ${joined}, [${post}]>`;
        call = `backend.concat${turbofish}(${left}, ${exprs.reference(&input)}, ${axis})`;
        left = `&${call}`;
        left_axis = joined;
    }
    return call;
}

/// `slice_axis` over `operand`, of axes `shape`, taking `range` (a start and a
/// length, each spelled) of `axis` by `step` as the axis named `cut`.
fn slice_axis_call(
    element: &String,
    shape: &Shape,
    axis: i32,
    cut: &String,
    operand: &String,
    range: [String, String],
    step: i64,
) -> String {
    let [start, length] = range;
    let turbofish = `::<${*element}, [${axis_run(shape, 0, axis)}], ${shape.axes[axis].name}, ${*cut}, [${axis_run(
        shape,
        axis + 1,
        shape.rank(),
    )}]>`;
    return `backend.slice_axis${turbofish}(${*operand}, ${axis}, ${start}, ${length}, ${step})`;
}

/// `operand`, whose axes are `node`'s first input's, laid out as `node`'s output.
fn reshaped(node: &Node, checked: &Checked, operand: &String, symbols: &mut Symbols) -> Result<String, EmitError> {
    let element = checked.primitives.get(node.inputs[0]).unwrap();
    let from = checked.shapes.get(node.inputs[0]).unwrap();
    let to = checked.shapes.get(node.outputs[0]).unwrap();
    let extents = symbols.spell_shape(&to)?;
    return Result::Ok(
        `backend.reshape::<${element}, [${axis_list(&from)}], [${axis_list(&to)}]>(${operand}, ${extents})`,
    );
}

/// A `ReduceMean` or `ReduceSum`. The kernels keep each reduced axis at
/// extent 1, and a reshape drops them where the node does.
fn reduction_call(node: &Node, checked: &Checked, exprs: &Operands, symbols: &mut Symbols) -> Result<String, EmitError> {
    let x = checked.shapes.get(node.inputs[0]).unwrap();
    let axes = settled(reduced_axes(node, &checked.known, x.rank()));
    let a = exprs.reference(&node.inputs[0]);
    let kept = if node.op == "ReduceMean" {
        `backend.reduce_mean(${a}, ${axes})`;
    } else {
        `backend.reduce_sum(${a}, ${axes})`;
    };
    if checked.shapes.get(node.outputs[0]).unwrap().rank() == x.rank() {
        return Result::Ok(kept);
    }
    return reshaped(node, checked, &`&${kept}`, symbols);
}

/// The literal operand `index` folds into an `Expr` as: a `Gemm` bias, or an
/// arithmetic operand whose partner is a tensor. The `Expr` maps over the
/// partner, so the output must carry the partner's axes: a scalar of higher
/// rank widens it, and an axis of 1 the scalar names apart renames it. `None`
/// reads it as a tensor.
fn folded_literal(
    node: &Node,
    index: i32,
    scalars: &HashMap<String, f32>,
    shapes: &HashMap<String, Shape>,
) -> Option<f32> {
    let Some(literal) = scalars.get(node.inputs[index]) else {
        return null;
    };
    let mapped = if node.op == "Gemm" && index == 2 {
        gemm_product(node, shapes);
    } else if index <= 1 && is_binary_elementwise(&node.op) && !scalars.contains_key(node.inputs[1 - index]) {
        shapes[node.inputs[1 - index]];
    } else {
        return null;
    };
    if axis_list(&mapped) != axis_list(&shapes[node.outputs[0]]) {
        return null;
    }
    return Option::Some(literal);
}

/// A two-operand node's operand expressions and the shapes stage 0 gave them.
fn binary_call(node: &Node, shapes: &HashMap<String, Shape>, exprs: &Operands) -> [String, String, Shape, Shape] {
    return [
        exprs.reference(&node.inputs[0]),
        exprs.reference(&node.inputs[1]),
        shapes.get(node.inputs[0]).unwrap(),
        shapes.get(node.inputs[1]).unwrap(),
    ];
}

/// One binary elementwise node. A folded scalar operand folds into the
/// operator, so no tensor is allocated for it and the other operand is walked
/// once.
fn binary_term(node: &Node, shapes: &HashMap<String, Shape>, exprs: &Operands) -> Term {
    // Stage 0 refuses every operator the kernels lack.
    let op = case_named::<BinaryOp>(&node.op).unwrap();
    if let Some(literal) = folded_literal(node, 1, &exprs.scalars, shapes) {
        return lane_of(node, 0, shapes, exprs, 0).binary(op, &Term::constant(literal));
    }
    if let Some(literal) = folded_literal(node, 0, &exprs.scalars, shapes) {
        return Term::constant(literal).binary(op, &lane_of(node, 1, shapes, exprs, 0));
    }
    let left = shapes.get(node.inputs[0]).unwrap();
    let right = shapes.get(node.inputs[1]).unwrap();
    let trailing = settled(trailing_axes(node, left.rank(), right.rank()));
    return lane_of(node, 0, shapes, exprs, 0).binary(op, &lane_of(node, 1, shapes, exprs, trailing));
}

/// The window stage 0 read for a `MaxPool` or `Conv`, as the kernel takes it.
fn window_geometry(node: &Node, shapes: &HashMap<String, Shape>, symbols: &mut Symbols) -> Result<String, EmitError> {
    // Stage 0 owed these already.
    let window = settled(window_of(node, &shapes.get(node.inputs[0]).unwrap(), shapes, &mut [], &Axes {}));
    let pads = symbols.spell_polys(&window.pads)?;
    let output = symbols.spell_polys(&window.output)?;
    return Result::Ok(
        `&Window { kernel: ${window.kernel}, strides: ${window.strides}, dilations: ${window.dilations}, pads: ${pads}, output: ${output} }`,
    );
}

/// A `MaxPool` as its kernel. Each spatial axis list is a pack, so the
/// turbofish spells the output's.
fn max_pool_call(
    node: &Node,
    shapes: &HashMap<String, Shape>,
    exprs: &Operands,
    symbols: &mut Symbols,
) -> Result<String, EmitError> {
    let x = shapes.get(node.inputs[0]).unwrap();
    let y = shapes.get(node.outputs[0]).unwrap();
    let geometry = window_geometry(node, shapes, symbols)?;
    let input = exprs.reference(&node.inputs[0]);
    return Result::Ok(
        `backend.max_pool::<${x.axes[0].name}, ${x.axes[1].name}, [${spatial_axes(&x)}], [${spatial_axes(&y)}]>(${input}, ${geometry})`,
    );
}

/// A `Conv` as its kernel's call, every argument written but `then`.
fn conv_head(
    node: &Node,
    shapes: &HashMap<String, Shape>,
    exprs: &Operands,
    symbols: &mut Symbols,
) -> Result<String, EmitError> {
    let x = shapes.get(node.inputs[0]).unwrap();
    let y = shapes.get(node.outputs[0]).unwrap();
    let geometry = window_geometry(node, shapes, symbols)?;
    let input = exprs.reference(&node.inputs[0]);
    let w = shapes.get(node.inputs[1]).unwrap();
    let group = settled(conv_group(node, &w));
    // `conv` takes one type for the input's channels and the weight's; the
    // grouped kernel types each apart, a group's share of the input's.
    let [kernel, biased, channels, grouping] = if group == 1 {
        ["conv", "conv_bias", x.axes[1].name, ""];
    } else {
        ["conv_grouped", "conv_grouped_bias", `${x.axes[1].name}, ${w.axes[1].name}`, `${group}, `];
    };
    let spatial = `[${spatial_axes(&x)}], [${spatial_axes(&w)}], [${spatial_axes(&y)}]`;
    let turbofish = `::<${x.axes[0].name}, ${channels}, ${w.axes[0].name}, ${spatial}>`;
    let weight = exprs.reference(&node.inputs[1]);
    if has_bias(node) {
        let bias = exprs.reference(&node.inputs[2]);
        return Result::Ok(`backend.${biased}${turbofish}(${input}, ${weight}, ${bias}, ${grouping}${geometry}`);
    }
    return Result::Ok(`backend.${kernel}${turbofish}(${input}, ${weight}, ${grouping}${geometry}`);
}

/// The axes past a shape's first two, which a window slides over.
fn spatial_axes(shape: &Shape) -> String {
    return axis_run(shape, 2, shape.rank());
}

/// The first of `elements` as an expression the generated source spells.
fn element_literal(elements: &Elements) -> String {
    return match elements {
        Ints(v) => `${v[0]}`,
        Floats(v) => float_literal(v[0]),
        Bools(v) => `${v[0]}`,
        // A tensor attribute holds numbers.
        Symbolic(_) => unreachable(),
    };
}

/// A constant as an expression the generated source spells. Wado has no
/// literal for a non-finite float, and a mask is written with `-inf`.
fn float_literal(value: f32) -> String {
    if value.is_nan() {
        return "f32::NAN";
    }
    if value == f32::INFINITY {
        return "f32::INFINITY";
    }
    if value == f32::NEG_INFINITY {
        return "-f32::INFINITY";
    }
    // The shortest round-tripping form of a float can be an integer, so the
    // cast is what makes it a float.
    return `${value} as f32`;
}

/// What one kernel computes: the operands it reads, and the `Expr` over them.
/// One operand may be a contraction's result, which the rest then follows as
/// its epilogue.
struct Term {
    lanes: List<Lane>,
    expr: Expr,
}

/// One operand of a `Term`, of axes `shape`, met `trailing` axes before the
/// output's end, as arithmetic before opset 7 aligned one.
struct Lane {
    source: Source,
    shape: Shape,
    trailing: i32,
}

impl Lane {
    /// The contraction this lane reads, which the caller found it to be.
    fn product(&self) -> Product {
        let Contraction(p) = self.source else {
            unreachable();
        };
        return p;
    }
}

/// What a `Lane` reads.
variant Source {
    /// The tensor this expression refers to.
    Tensor(String),
    /// The `bool` tensor this expression refers to, read as 1.0 and 0.0.
    Condition(String),
    /// What a contraction computes. The operators after it become its
    /// epilogue, so it never becomes a tensor of its own.
    Contraction(Product),
}

/// A contraction as its call less `then`, and where it is a product by a
/// prepared right operand, that product's operands, by which a second
/// product pairs with it.
struct Product {
    call: String,
    rhs: Option<RhsProduct>,
}

/// A product `matmul_rhs` computes: `a` by the weight `weight`, which `b`
/// refers to. Where `from`, `a` is the `Prologue` computing the left operand.
struct RhsProduct {
    a: String,
    from: bool,
    b: String,
    weight: String,
}

impl RhsProduct {
    /// The call computing this, `kernel` named for a left operand as is.
    fn kernel(&self, kernel: String) -> String {
        return if self.from { `backend.${kernel}_from` } else { `backend.${kernel}` };
    }
}

impl Product {
    fn of(call: String) -> Product {
        return Product { call, rhs: null };
    }

    /// The product by the weight `weight` of the left operand `left` gives,
    /// as `Operands::left` gives it.
    fn by_rhs(left: [String, bool], b: String, weight: String) -> Product {
        let [a, from] = left;
        let product = RhsProduct { a, from, b, weight };
        return Product { call: `${product.kernel("matmul_rhs")}(${a}, ${b}`, rhs: Option::Some(product) };
    }
}

impl Term {
    fn of(reference: String, shape: Shape, trailing: i32) -> Term {
        return Term {
            lanes: [
                Lane { source: Source::Tensor(reference), shape, trailing },
            ],
            expr: operand_expr(0),
        };
    }

    /// What the contraction `head` computes, of axes `shape`.
    fn after(head: Product, shape: Shape) -> Term {
        return Term {
            lanes: [
                Lane { source: Source::Contraction(head), shape, trailing: 0 },
            ],
            expr: operand_expr(0),
        };
    }

    /// The `bool` tensor `reference`, of axes `shape`, as 1.0 and 0.0.
    fn condition(reference: String, shape: Shape) -> Term {
        return Term {
            lanes: [
                Lane { source: Source::Condition(reference), shape, trailing: 0 },
            ],
            expr: operand_expr(0),
        };
    }

    fn constant(value: f32) -> Term {
        return Term { lanes: [], expr: constant_expr(value) };
    }

    fn unary(&self, op: UnaryOp) -> Term {
        return Term { lanes: self.lanes, expr: self.expr.unary(op) };
    }

    /// `op` over this and `rhs`, an operand both read taken once.
    fn binary(&self, op: BinaryOp, rhs: &Term) -> Term {
        let mut lanes = self.lanes;
        let b = merged_into(&mut lanes, rhs);
        return Term { lanes, expr: self.expr.binary(op, &b) };
    }

    /// `then` where this is not zero, and `otherwise` where it is.
    fn select(&self, then: &Term, otherwise: &Term) -> Term {
        let mut lanes = self.lanes;
        let a = merged_into(&mut lanes, then);
        let b = merged_into(&mut lanes, otherwise);
        return Term { lanes, expr: self.expr.select(&a, &b) };
    }

    /// The call computing this over `out`'s axes: the contraction it follows,
    /// or the two `paired` prepares together, what comes after it its
    /// epilogue, a row kernel over the whole `rows` where it folds along them,
    /// or else one `fused` kernel.
    fn call(&self, out: &Shape, rows: &Option<Shape>, paired: &HashMap<String, String>) -> String {
        // Stage 0 folds a computation over constants alone.
        assert !self.lanes.is_empty();
        if let Some(space) = rows {
            let reads: List<String> = self.lanes.into_iter().map(|lane| lane_read(&lane, space)).collect();
            // A row's one value is written once where the output holds one
            // per row; a row of one element is written whole either way.
            return `backend.rows::<[${axis_list(space)}], [${axis_list(out)}]>([${reads.join(", ")}], &${expr_source(
                &self.expr,
            )}, 1, ${reduces_rows(out, space)})`;
        }
        let mut lanes = self.lanes;
        let mut heads: List<i32> = [];
        for let [i, lane] of lanes.into_iter().enumerate() {
            if lane.source matches { Contraction(_) } {
                heads.push(i);
            }
        }
        // The plan pairs two products at most in a kernel, each over the
        // kernel's axes, by weights held together. A product an epilogue
        // reads under other axes, as a `Gemm`'s bias may rename them, is
        // written and read as any tensor.
        assert heads.len() <= 2;
        let under_out = |at: i32| axis_list(&lanes[at].shape) == axis_list(out);
        if heads.len() == 2 {
            let order = pair_order(&lanes, heads[0], heads[1], paired);
            assert under_out(order[0]) && under_out(order[1]);
            heads = order;
        }
        if heads.len() == 1 && !under_out(heads[0]) {
            let at = heads[0];
            lanes[at] = Lane { ..lanes[at], source: Source::Tensor(`&${lanes[at].product().call}, null)`) };
            heads = [];
        }
        if heads.is_empty() {
            return Term { lanes, expr: self.expr }.fused_call(out);
        }
        let first = lanes[heads[0]].product();
        if lanes.len() == 1 && self.expr.steps.len() == 1 {
            return `${first.call}, null)`;
        }
        // The contractions' results are the epilogue's first operands, and
        // the rest follow in order.
        let mut renumbered: List<i32> = [];
        let mut reads: List<String> = [];
        for let [i, lane] of lanes.into_iter().enumerate() {
            if let Some(k) = heads.position(|h| h == i) {
                renumbered.push(k);
            } else {
                renumbered.push(reads.len() + heads.len());
                reads.push(lane_read(&lane, out));
            }
        }
        let epilogue = `Epilogue { operands: [${reads.join(", ")}], op: ${expr_source(
            &operands_renumbered(&self.expr, &renumbered),
        )} }`;
        if heads.len() == 2 {
            let product = first.rhs.unwrap();
            return `${product.kernel("matmul_rhs_paired")}(${product.a}, ${product.b}, ${epilogue})`;
        }
        return `${first.call}, Option::Some(${epilogue}))`;
    }

    /// This as the `Prologue` a product computes its left operand from, over
    /// that operand's axes, `space`.
    fn prologue(&self, space: &Shape) -> String {
        let reads: List<String> = self.lanes.into_iter().map(|lane| lane_read(&lane, space)).collect();
        return `Prologue { operands: [${reads.join(", ")}], op: ${expr_source(&self.expr)} }`;
    }

    /// The `fused` call computing this over `out`'s axes, every lane a tensor.
    fn fused_call(&self, out: &Shape) -> String {
        let reads: List<String> = self.lanes.into_iter().map(|lane| lane_read(&lane, out)).collect();
        return `backend.fused::<[${axis_list(out)}]>([${reads.join(", ")}], &${expr_source(&self.expr)})`;
    }
}

/// The lanes `i` and `j` of two products the plan pairs, in the order
/// `paired` prepares their weights together in.
fn pair_order(lanes: &List<Lane>, i: i32, j: i32, paired: &HashMap<String, String>) -> List<i32> {
    let weight = |at: i32| lanes[at].product().rhs.unwrap().weight;
    if paired.get(weight(i)) == Option::Some(weight(j)) {
        return [i, j];
    }
    assert paired.get(weight(j)) == Option::Some(weight(i)), "two products in one kernel are paired by the plan";
    return [j, i];
}

/// `term`'s lanes added to `lanes`, a lane already there taken once, and its
/// `Expr` reading them where they now are.
fn merged_into(lanes: &mut List<Lane>, term: &Term) -> Expr {
    let mut renumbered: List<i32> = [];
    for let lane of term.lanes {
        let mut at = 0;
        while at < lanes.len() && !(lanes[at].source == lane.source && lanes[at].trailing == lane.trailing) {
            at += 1;
        }
        if at == lanes.len() {
            lanes.push(lane);
        }
        renumbered.push(at);
    }
    return operands_renumbered(&term.expr, &renumbered);
}

/// `e` with each `operand(k)` reading `to[k]` instead.
fn operands_renumbered(e: &Expr, to: &List<i32>) -> Expr {
    let mut steps: List<Step> = [];
    for let step of e.steps {
        steps.push(match step {
            Operand(k) => Step::Operand(to[k]),
            other => other,
        });
    }
    return Expr { steps };
}

/// The source of `e` as its steps, so a step several read is spelled once.
internal fn expr_source(e: &Expr) -> String {
    let steps: List<String> = e.steps.into_iter().map(|s| step_source(&s)).collect();
    return `Expr { steps: [${steps.join(", ")}] }`;
}

fn step_source(step: &Step) -> String {
    return match *step {
        Operand(k) => `Step::Operand(${k})`,
        Constant(c) => `Step::Constant(${float_literal(c)})`,
        Unary([op, a]) => `Step::Unary([UnaryOp::${op}, ${a}])`,
        Binary([op, a, b]) => `Step::Binary([BinaryOp::${op}, ${a}, ${b}])`,
        Select([c, a, b]) => `Step::Select([${c}, ${a}, ${b}])`,
        Fold([op, a]) => `Step::Fold([RowOp::${op}, ${a}])`,
    };
}

/// The read of `lane` under `out`'s axes: as it is where its axes are
/// `out`'s, repeated across `out`'s leading axes where its axes are `out`'s
/// trailing ones, met at an axis where it aligns there, and otherwise lifted to
/// `out`'s rank under `out`'s names.
fn lane_read(lane: &Lane, out: &Shape) -> String {
    let reference = match lane.source {
        Tensor(r) => r,
        Condition(c) => {
            return `backend.read_condition(${under_axes_of(&c, &lane.shape, out, &"bool")})`;
        },
        // `Term::call` gives a contraction no read: what follows it is its
        // epilogue.
        Contraction(_) => unreachable(),
    };
    let own = &lane.shape;
    if lane.trailing > 0 {
        let axis = out.rank() - own.rank() - lane.trailing;
        let met = Shape { axes: out.axes[axis..<axis + own.rank()].to_list() };
        let read = under_axes_of(&reference, own, &met, &KERNEL_ELEMENT);
        let after = axis_run(out, out.rank() - lane.trailing, out.rank());
        return `backend.read_at::<[${axis_run(out, 0, axis)}], [${axis_list(&met)}], [${after}]>(${read}, ${lane.trailing})`;
    }
    if axis_list(own) == axis_list(out) {
        return `backend.read(${reference})`;
    }
    let leading = out.rank() - own.rank();
    if leading > 0 && axis_list(own) == axis_run(out, leading, out.rank()) {
        return `backend.read_suffix::<[${axis_run(out, 0, leading)}], [${axis_list(own)}]>(${reference})`;
    }
    return `backend.read(${under_axes_of(&reference, own, out, &KERNEL_ELEMENT)})`;
}

/// `operand` read under `out`'s axes: itself where they are its own, and
/// otherwise lifted to `out`'s rank under `out`'s names. Stage 0 proved the
/// extents broadcast and every elementwise kernel stretches an extent of 1, so
/// an axis of 1 named apart from the one it meets differs in its type alone.
fn under_axes_of(operand: &String, shape: &Shape, out: &Shape, element: &String) -> String {
    let own = axis_list(shape);
    let theirs = axis_list(out);
    if own == theirs {
        return *operand;
    }
    return `&backend.lift::<${element}, [${own}], [${theirs}]>(${operand}, ${out.rank()})`;
}

/// The first operand of a `Spread`'s product, read before its leading axes were
/// flattened, and the axes the product computes over.
struct SpreadOperand {
    /// The operand as `Operands::left` gives it.
    left: [String, bool],
    shape: Shape,
    product: Shape,
}

fn spread_product(s: &Spread, shapes: &HashMap<String, Shape>, exprs: &Operands) -> SpreadOperand {
    return SpreadOperand {
        left: exprs.left(&s.operand),
        shape: shapes[s.operand],
        product: shapes[s.restored],
    };
}

/// `Gemm`'s `alpha * A' * B' + beta * C`, as a matrix product under optional
/// `transpose2`s followed by its scalars and its bias. Where `spread`, the
/// product reads the operand its first `Reshape` flattened, batched over the
/// leading axes, and computes over the axes the second restores.
fn gemm_term(node: &Node, shapes: &HashMap<String, Shape>, exprs: &Operands, spread: Option<SpreadOperand>) -> Term {
    let [alpha, beta, trans_a, trans_b] = settled(gemm_options(node));
    let [a, left, product_axes] = match spread {
        Some(s) => [s.left, s.shape, s.product],
        None => {
            let [a, left] = gemm_operand(
                &exprs.reference(&node.inputs[0]),
                &shapes.get(node.inputs[0]).unwrap(),
                trans_a,
            );
            [
                [a, false],
                left,
                gemm_product(node, shapes),
            ];
        },
    };
    let b_operand = exprs.reference(&node.inputs[1]);
    let head = if exprs.rhs.contains_key(node.inputs[1]) {
        Product::by_rhs(a, b_operand, node.inputs[1]);
    } else {
        // The plan takes a prologue in only by a weight held for products.
        let [reference, from] = a;
        assert !from;
        let [b, right] = gemm_operand(&b_operand, &shapes.get(node.inputs[1]).unwrap(), trans_b);
        Product::of(product_head(&reference, &b, &left, &right, &product_axes));
    };
    let mut term = Term::after(head, product_axes);
    if alpha != 1.0 {
        term = term.binary(BinaryOp::Mul, &Term::constant(alpha));
    }
    if !has_bias(node) {
        return term;
    }
    let bias = if let Some(literal) = folded_literal(node, 2, &exprs.scalars, shapes) {
        Term::constant(if beta == 1.0 { literal } else { literal * beta });
    } else {
        let c = lane_of(node, 2, shapes, exprs, 0);
        if beta == 1.0 {
            c;
        } else {
            c.binary(BinaryOp::Mul, &Term::constant(beta));
        }
    };
    return term.binary(BinaryOp::Add, &bias);
}

/// The axes of `Gemm`'s matrix product, which its bias may rename where they
/// meet at an extent of 1.
fn gemm_product(node: &Node, shapes: &HashMap<String, Shape>) -> Shape {
    let [_, _, trans_a, trans_b] = settled(gemm_options(node));
    let rows = shapes[node.inputs[0]].axes[if trans_a { 1 } else { 0 }];
    let cols = shapes[node.inputs[1]].axes[if trans_b { 0 } else { 1 }];
    return Shape {
        axes: [rows, cols],
    };
}

/// A `Gemm` operand of axes `shape`, and those axes, transposed where `flag` says.
fn gemm_operand(operand: &String, shape: &Shape, flag: bool) -> [String, Shape] {
    if flag {
        return [
            `&backend.transpose2(${operand})`,
            Shape {
                axes: [shape.axes[1], shape.axes[0]],
            },
        ];
    }
    return [*operand, *shape];
}

/// A matrix product of `a`, of axes `left`, by `b`, of axes `right`, into
/// `out`, as its call less `then`. `matmul` and `matmul_shared` take one type per axis the operands
/// share, so they serve only matrices whose batch axes are one list;
/// `matmul_broadcast` spells each operand's axes and serves a rank-1 operand
/// and a batch axis of 1 named apart.
fn product_head(a: &String, b: &String, left: &Shape, right: &Shape, out: &Shape) -> String {
    let matrices = left.rank() >= 2 && right.rank() >= 2;
    if matrices && left.rank() > 2 && right.rank() == 2 {
        return `backend.matmul_shared(${a}, ${b}`;
    }
    if matrices && left.rank() == right.rank() && batch_axes_agree(left, right) {
        return `backend.matmul(${a}, ${b}`;
    }
    let turbofish = `::<[${axis_list(left)}], [${axis_list(right)}], [${axis_list(out)}]>`;
    return `backend.matmul_broadcast${turbofish}(${a}, ${b}`;
}

fn is_identity(perm: &List<i32>) -> bool {
    for let [i, axis] of perm.into_iter().enumerate() {
        if *axis != i {
            return false;
        }
    }
    return true;
}

/// Whether one axis of a kernel's signature can stand for both of these. Stage
/// 0 stretches an extent of 1 and a kernel taking one type for both does not,
/// so the name is not enough; a condition stage 0 owed for the two to meet is
/// one `forward` checks.
fn same_axis(left: &Axis, right: &Axis) -> bool {
    return left.name == right.name && left.extent.agreement(&right.extent) matches { Some(_) };
}

/// Whether each axis of `left` can stand for `right`'s at its position.
fn same_axes(left: &Shape, right: &Shape) -> bool {
    if left.rank() != right.rank() {
        return false;
    }
    for let i of 0..<left.rank() {
        if !same_axis(&left.axes[i], &right.axes[i]) {
            return false;
        }
    }
    return true;
}

/// Whether two `MatMul` operands' batch axes are one list, which is what the
/// kernel's single `..Bs` says.
fn batch_axes_agree(left: &Shape, right: &Shape) -> bool
    contract left.rank() == right.rank()
{
    for let mut i = 0; i < left.rank() - 2; i += 1 {
        if !same_axis(&left.axes[i], &right.axes[i]) {
            return false;
        }
    }
    return true;
}

/// Every axis name the checked graph uses, in the order stage 0 gave each
/// tensor its shape, so the emitted module is stable across runs.
fn axis_names(graph: &Graph, checked: &Checked) -> List<String> {
    let mut seen = HashSet::<String>::new();
    let mut names: List<String> = [];
    push_scope_axes(&mut names, &mut seen, graph, checked);
    return names;
}

/// The axes every tensor a scope gave a shape carries, a constant a kernel
/// reads among them, then those of each `If`'s branches.
fn push_scope_axes(names: &mut List<String>, seen: &mut HashSet<String>, graph: &Graph, checked: &Checked) {
    for let [_, shape] of checked.shapes.entries() {
        push_markers(names, seen, &shape.axes);
    }
    for let [branch_graph, branch] of branches_of(graph, checked) {
        push_scope_axes(names, seen, &branch_graph, &branch);
    }
}


/// A merged axis is spelled with its parts' markers, so the parts are what the
/// module declares.
fn push_markers(names: &mut List<String>, seen: &mut HashSet<String>, axes: &List<Axis>) {
    for let axis of *axes {
        if !axis.parts.is_empty() {
            push_markers(names, seen, &axis.parts);
        } else if seen.insert(axis.name) {
            names.push(axis.name);
        }
    }
}
