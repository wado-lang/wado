//! The Wado a checked graph becomes: one marker type per axis, the kernels
//! the graph's operators lower to, and a `forward` that runs them in order.

use { TreeMap, TreeSet } from "core:collections";
use { CodeWriter, FnSpec, ImplSpec, StructSpec, Vis, byte_string_literal, is_reserved, wado } from "lib:wadopoet";
use { Extent } from "./extent.wado";
use { Poly } from "./poly.wado";
use { Axis, Shape } from "./shape.wado";
use { Graph, Node, element_of, is_binary_elementwise } from "./graph.wado";
use { Expected } from "./runtime/checkpoint.wado";
use { expected } from "./safetensors.wado";
use {
    Checked,
    InferError,
    Refusal,
    gather_axis,
    gemm_options,
    has_bias,
    is_reduction,
    range_bounds,
    range_count,
    reduced_axes,
    slice_cuts,
    softmax_axis,
    split_axis,
    split_parts,
    transpose_perm,
    window_of,
} from "./infer.wado";

/// A boundary tensor of an element type no kernel holds.
pub struct UnmappedDtype {
    pub tensor: String,
    pub dtype: String,
}

/// A broadcast the kernels do not cover: one operand's axes must be the
/// other's, or a suffix of them.
pub struct UnimplementedBroadcast {
    pub node: String,
    pub op: String,
    pub left: String,
    pub right: String,
}

/// Two tensor names that become one Wado identifier.
pub struct NameCollision {
    pub tensor: String,
    pub other: String,
    pub ident: String,
}

pub variant EmitError {
    /// An axis named as something the generated module declares. Unlike a
    /// tensor, it is not renamed: the schema's author chose the word.
    ReservedAxis(String),
    Dtype(UnmappedDtype),
    /// A node stage 0 checks in a form no kernel computes.
    Refused(Refusal),
    Broadcast(UnimplementedBroadcast),
    Collision(NameCollision),
    /// A graph whose outputs `forward` cannot return: it delivers one value.
    OutputCount(i32),
    /// A symbol the run needs the value of, which no input's axis carries.
    Unbound(String),
}

impl Display for UnmappedDtype {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(`${self.tensor}: no kernel holds ${self.dtype}`);
    }
}

impl Display for UnimplementedBroadcast {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(
            `${self.node} = ${self.op}: no kernel broadcasts [${self.left}] against [${self.right}]`,
        );
    }
}

impl Display for NameCollision {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(`${self.tensor} and ${self.other} both name \`${self.ident}\``);
    }
}

impl Display for EmitError {
    fn fmt(&self, f: &mut Formatter) {
        match self {
            ReservedAxis(axis) => {
                f.write_str(`${axis}: an axis cannot be named as the generated module names something`);
            },
            Dtype(e) => e.fmt(f),
            Refused(e) => e.fmt(f),
            Broadcast(e) => e.fmt(f),
            Collision(e) => e.fmt(f),
            OutputCount(n) => f.write_str(`the graph has ${n} outputs and \`forward\` returns one`),
            Unbound(symbol) => f.write_str(`${symbol}: the run needs this length, and no input's axis gives it`),
        }
    }
}

impl Error for UnmappedDtype {
}

impl Error for UnimplementedBroadcast {
}

impl Error for NameCollision {
}

impl Error for EmitError {
}

/// The generated module's source. Every axis the graph mentions becomes a
/// marker type, so two tensors sharing an axis share one type.
pub fn emit(graph: &Graph, checked: &Checked) -> Result<String, EmitError> {
    let shapes = &checked.shapes;
    if graph.outputs.len() != 1 {
        builtin::cold_path();
        return Result::Err(EmitError::OutputCount(graph.outputs.len()));
    }
    let held = boundary_elements(graph)?;

    let mut w = CodeWriter::with_capacity(8192);
    w.line(`//! Generated by Loam from the ONNX graph \`${graph.name}\`.`);
    w.line("//! Each axis is a marker type, so two tensors that share an axis");
    w.line("//! share the type that names it.");
    w.blank();

    let axes = axis_names(graph, shapes);
    let scalars = scalar_literals(checked);
    let literals = literal_tensors(graph, checked, &scalars);
    let carriers = symbol_carriers(graph, shapes);
    let names = Names::of(graph, checked, &literals.spelled, &axes, &carriers)?;
    let fixed = boundary_extents(graph, shapes);
    for let axis of axes {
        StructSpec::new(axis, Vis::Pub).emit(&mut w);
        if let Some(extent) = fixed.get(axis) {
            ImplSpec::new(axis).emit_begin(&mut w);
            w.line(`pub const EXTENT: i32 = ${extent};`);
            w.end();
        }
    }
    w.blank();
    w.raw(&RUNTIME);
    if loads_weights(graph) {
        w.raw(&CHECKPOINT_RUNTIME);
    }
    w.raw(&GRAPH_BANNER);

    emit_weights(&mut w, graph, checked, &names, &held);
    let symbols = Symbols::of(&carriers, &names);
    emit_forward(&mut w, graph, checked, &names, &held, scalars, &literals, symbols)?;
    return Result::Ok(w.to_string());
}

/// The length of each axis that every input and output naming it fixes to one,
/// which the caller then writes as the axis's `EXTENT` rather than a number.
fn boundary_extents(graph: &Graph, shapes: &TreeMap<String, Shape>) -> TreeMap<String, i32> {
    let mut fixed = TreeMap::<String, i32>::new();
    let mut open = TreeSet::<String>::new();
    for let declared of [&graph.inputs, &graph.outputs] {
        for let vi of *declared {
            for let axis of shapes.get(vi.name).unwrap().axes {
                let Static(extent) = axis.extent else {
                    open.insert(axis.name);
                    continue;
                };
                if !fixed.try_insert(axis.name, extent) && fixed[axis.name] != extent {
                    open.insert(axis.name);
                }
            }
        }
    }
    for let name of open {
        fixed.remove(name);
    }
    return fixed;
}

/// What each boundary tensor is held in, and where an element type no kernel
/// reaches stops the build. A node's own output is held as it is computed.
fn boundary_elements(graph: &Graph) -> Result<TreeMap<String, String>, EmitError> {
    let mut held = TreeMap::<String, String>::new();
    for let declared of [&graph.inputs, &graph.initializers, &graph.outputs] {
        for let vi of *declared {
            let Some(element) = element_of(&vi.dtype) else {
                builtin::cold_path();
                return Result::Err(EmitError::Dtype(UnmappedDtype {
                    tensor: vi.name,
                    dtype: vi.dtype,
                }));
            };
            held[vi.name] = element.primitive;
        }
    }
    return Result::Ok(held);
}

/// Every identifier the generated module declares, minted from one set: the
/// axes, then each tensor name sanitized. Two that collide stop the build.
struct Names {
    idents: TreeMap<String, String>,
    reserved: TreeSet<String>,
}

impl Names {
    fn of(
        graph: &Graph,
        checked: &Checked,
        literals: &List<String>,
        axes: &List<String>,
        carriers: &List<Carrier>,
    ) -> Result<Names, EmitError> {
        let mut reserved = module_idents();
        for let axis of *axes {
            if is_bound(&reserved, &axis) {
                builtin::cold_path();
                return Result::Err(EmitError::ReservedAxis(axis));
            }
            reserved.insert(axis);
        }
        let mut names = Names {
            idents: TreeMap::<String, String>::new(),
            reserved,
        };
        let mut taken = TreeMap::<String, String>::new();
        for let vi of &graph.inputs {
            names.take(&mut taken, &vi.name)?;
        }
        for let vi of &graph.initializers {
            names.take(&mut taken, &vi.name)?;
        }
        for let node of &graph.nodes {
            for let output of node.outputs {
                if !checked.known.contains_key(output) {
                    names.take(&mut taken, &output)?;
                }
            }
        }
        for let tensor of *literals {
            names.take(&mut taken, &tensor)?;
        }
        for let c of carriers {
            names.take(&mut taken, &symbol_key(&c.symbol))?;
        }
        return Result::Ok(names);
    }

    fn take(&mut self, taken: &mut TreeMap<String, String>, tensor: &String) -> Result<(), EmitError> {
        let mut ident = sanitize(tensor);
        // A name the generated module already binds is not this tensor's to
        // take, and a trailing `_` is a name no other rule here produces.
        while is_bound(&self.reserved, &ident) {
            ident = `${ident}_`;
        }
        if let Some(other) = taken.get(ident) {
            builtin::cold_path();
            return Result::Err(EmitError::Collision(NameCollision {
                tensor: *tensor,
                other,
                ident,
            }));
        }
        taken[ident] = *tensor;
        self.idents[*tensor] = ident;
        return Result::Ok(());
    }

    fn get(&self, tensor: &String) -> String {
        return self.idents.get(*tensor).unwrap();
    }
}

/// The kernels every generated module carries, inlined rather than imported so
/// the module stands on its own.
global RUNTIME: String = #include_str("./runtime/tensor.wado");

/// The safetensors reader `Weights::load` calls, inlined only where the graph
/// leaves a weight to a checkpoint.
global CHECKPOINT_RUNTIME: String = #include_str("./runtime/checkpoint.wado");

/// Where the inlined runtime ends and this graph's own code begins. A reader
/// needs the line, and a test asserting a kernel is absent needs the boundary.
internal global GRAPH_BANNER: String = `
// --- The Loam runtime ends here; the rest is generated from this graph. ---
`;

/// Whether `name` already means something in the generated module.
fn is_bound(module: &TreeSet<String>, name: &String) -> bool {
    return module.contains(*name) || is_reserved(name);
}

/// The names the generated module binds beyond the language's own. The
/// runtime's are read out of the runtime, so a new kernel cannot be missed, and
/// the checkpoint reader's are bound whether or not a graph inlines it.
fn module_idents() -> TreeSet<String> {
    let mut reserved = TreeSet::<String>::new();
    for let source of [&RUNTIME, &CHECKPOINT_RUNTIME] {
        for let name of declared_in(source) {
            reserved.insert(name);
        }
    }
    reserved.insert("forward");
    reserved.insert("weights");
    reserved.insert("Weights");
    return reserved;
}

/// Every keyword a Wado declaration can open with. An `impl` is left out: it
/// declares no name of its own, and its methods are reached through a type.
global DECLARATION_KEYWORDS: List<String> = [
    "fn ", "struct ", "trait ", "interface ", "type ", "enum ", "variant ", "flags ", "global ",
];

/// The modifiers a declaration carries before its keyword. `export` is absent
/// because the runtime is inlined rather than lowered at a CM boundary.
global VISIBILITY_PREFIXES: List<String> = ["pub ", "internal "];

/// Every module-level name a Wado source declares or imports, by the one shape
/// the runtime is written in: a declaration or a `use` at column zero.
fn declared_in(source: &String) -> List<String> {
    let mut names: List<String> = [];
    for let line of source.lines() {
        let mut declaration = line.as_str_slice();
        for let prefix of VISIBILITY_PREFIXES {
            if let Some(rest) = declaration.strip_prefix(prefix) {
                declaration = rest;
            }
        }
        if let Some(clause) = declaration.strip_prefix("use ") {
            names.extend(&imported_names(&clause.to_string()));
            continue;
        }
        for let keyword of DECLARATION_KEYWORDS {
            let Some(rest) = declaration.strip_prefix(keyword) else {
                continue;
            };
            let mut name = String::with_capacity(rest.len());
            for let c of rest.chars() {
                if !c.is_ascii_alphanumeric() && c != '_' {
                    break;
                }
                name.push(c);
            }
            names.push(name);
        }
    }
    return names;
}

test "a use line binds its names, whatever its visibility" {
    let source = "use ns from \"a\";\npub use { A, B as C } from \"b\";\ninternal use { D } from \"c\";\n";
    assert declared_in(&source) == ["ns", "A", "C", "D"] as List<String>;
}

/// The names a `use` clause binds: its namespace, or each item under its alias.
fn imported_names(clause: &String) -> List<String> {
    let Some([bound, _]) = clause.split_once(" from ") else {
        panic(`an inlined runtime's import is one line: use ${clause}`);
    };
    let mut names: List<String> = [];
    let mut aliased = false;
    for let token of bound.to_string().replace("{", " ").replace("}", " ").replace(",", " ").split_whitespace() {
        if token == "as" {
            aliased = true;
            continue;
        }
        if aliased {
            names.pop();
            aliased = false;
        }
        names.push(token.to_string());
    }
    return names;
}

/// An ONNX tensor name as a Wado identifier: exporters write `/` and `.` into
/// one, and a name may start with a digit.
fn sanitize(name: &String) -> String {
    let mut out = String::with_capacity(name.len() + 1);
    for let c of name.chars() {
        if c.is_ascii_alphanumeric() || c == '_' {
            out.push(c);
        } else {
            out.push('_');
        }
    }
    let Some(first) = out.chars().next() else {
        return "t_";
    };
    if first.is_ascii_alphabetic() || first == '_' {
        return out;
    }
    return `t_${out}`;
}

/// The graph's initializers, as the struct `forward` reads them from.
fn emit_weights(w: &mut CodeWriter, graph: &Graph, checked: &Checked, names: &Names, held: &TreeMap<String, String>) {
    let mut weights = StructSpec::new("Weights", Vis::Pub);
    for let vi of &graph.initializers {
        weights.add_pub_field(names.get(&vi.name), tensor_type(checked, held, &vi.name));
    }
    w.blank();
    w.line("/// The graph's initializers.");
    weights.emit(w);
    emit_constructor(w, graph, &checked.shapes, names, held);
}

/// Whether some initializer's data is left to a checkpoint.
fn loads_weights(graph: &Graph) -> bool {
    for let vi of &graph.initializers {
        if vi.data matches { None } {
            return true;
        }
    }
    return false;
}

/// `Weights::embedded()` where the graph carries every initializer's data, and
/// `Weights::load` reading the rest from a safetensors checkpoint otherwise.
fn emit_constructor(
    w: &mut CodeWriter,
    graph: &Graph,
    shapes: &TreeMap<String, Shape>,
    names: &Names,
    held: &TreeMap<String, String>,
) {
    let loads = loads_weights(graph);
    w.blank();
    ImplSpec::new("Weights").emit_begin(w);
    if loads {
        w.line("/// The weights, those the graph does not carry read from a safetensors checkpoint.");
        FnSpec::new("load", Vis::Pub).add_param("checkpoint", "&ByteList").set_return_type("Result<Weights, LoadError>").emit_begin(
            w,
        );
        w.line("let header = read_checkpoint(checkpoint)?;");
        w.begin("return Result::Ok(Weights");
    } else {
        w.line("/// The weights the graph carries.");
        FnSpec::new("embedded", Vis::Pub).set_return_type("Weights").emit_begin(w);
        w.begin("return Weights");
    }
    for let vi of &graph.initializers {
        let primitive = held.get(vi.name).unwrap();
        let shape = shapes.get(vi.name).unwrap();
        let e = expected(vi, &shape);
        let data = match vi.data {
            Some(bytes) => byte_string_literal(&bytes),
            None => checkpoint_payload(&e),
        };
        w.begin(`${names.get(&vi.name)}: Tensor::<${primitive}, [${axis_list(&shape)}]>`);
        w.line(`data: List::<${primitive}>::from_le_bytes(${data}),`);
        w.line(`extents: ${e.extents},`);
        w.end_with(",");
    }
    w.end_with(if loads { ");" } else { ";" });
    w.end();
    w.end();
}

/// The call reading a tensor's bytes out of the checkpoint `load` was given,
/// checked against what the build compiled it as.
fn checkpoint_payload(e: &Expected) -> String {
    let axes: List<String> = e.axes.into_iter().map(|axis| wado`"${axis}"`).collect();
    return wado`header.payload(checkpoint, &Expected { tensor: "${e.tensor}", dtype: "${e.dtype}", axes: [${axes.join(
        ", ",
    )}], extents: ${e.extents}, elements: ${e.elements}, width: ${e.width} })?`;
}

/// What each tensor is called inside `forward`. A graph input arrives as a
/// reference and everything else as a value.
struct Operands {
    values: TreeMap<String, String>,
    already_reference: TreeSet<String>,
    /// A folded float of one element, as the literal a closure folds in.
    scalars: TreeMap<String, String>,
}

/// The lengths only the run knows, each bound in `forward` from the first input
/// axis that carries it, once something spells it.
struct Symbols {
    idents: TreeMap<String, String>,
    sources: TreeMap<String, String>,
    used: TreeSet<String>,
}

impl Symbols {
    fn of(carriers: &List<Carrier>, names: &Names) -> Symbols {
        let mut symbols = Symbols {
            idents: TreeMap::<String, String>::new(),
            sources: TreeMap::<String, String>::new(),
            used: TreeSet::<String>::new(),
        };
        for let c of carriers {
            symbols.sources[c.symbol] = `${names.get(&c.input)}.extents[${c.axis}]`;
            symbols.idents[c.symbol] = names.get(&symbol_key(&c.symbol));
        }
        return symbols;
    }

    /// A symbolic integer as the `i64` expression `forward` computes it by.
    fn spell(&mut self, p: &Poly) -> Result<String, EmitError> {
        for let symbol of p.symbols() {
            if !self.idents.contains_key(symbol) {
                builtin::cold_path();
                return Result::Err(EmitError::Unbound(symbol));
            }
            self.used.insert(symbol);
        }
        return Result::Ok(p.spelled(&self.idents));
    }

    /// A length or a position within one, as the `i32` a kernel takes.
    fn spell_extent(&mut self, p: &Poly) -> Result<String, EmitError> {
        if let Some(c) = p.as_constant() {
            assert 0 <= c <= i32::MAX as i64;
            return Result::Ok(`${c}`);
        }
        return Result::Ok(`to_extent(${self.spell(p)?})`);
    }

    fn spell_all(&mut self, extents: &List<Extent>) -> Result<String, EmitError> {
        let mut spelled: List<String> = [];
        for let e of *extents {
            spelled.push(self.spell_extent(&e.poly())?);
        }
        return Result::Ok(`[${spelled.join(", ")}]`);
    }

    /// The bindings of every symbol something spelled.
    fn bindings(&self) -> List<String> {
        let mut lines: List<String> = [];
        for let symbol of self.used {
            lines.push(`let ${self.idents.get(symbol).unwrap()} = ${self.sources.get(symbol).unwrap()} as i64;`);
        }
        return lines;
    }
}

/// The key a symbol takes among the names `forward` binds, apart from any
/// tensor's, since both come out of the model file.
fn symbol_key(symbol: &String) -> String {
    return `dim ${*symbol}`;
}

/// The symbol an input axis's extent is, as a `dim_param` or `?` makes it.
/// An input's extent is never an expression of symbols.
fn input_symbol(extent: &Extent) -> Option<String> {
    let Symbolic(p) = *extent else {
        return null;
    };
    let read = p.symbols();
    assert read.len() == 1 && p == Poly::symbol(&read[0]);
    return Option::Some(read[0]);
}

/// A symbol an input axis carries, and the first input axis that does.
struct Carrier {
    symbol: String,
    input: String,
    axis: i32,
}

fn symbol_carriers(graph: &Graph, shapes: &TreeMap<String, Shape>) -> List<Carrier> {
    let mut carriers: List<Carrier> = [];
    for let vi of &graph.inputs {
        for let [axis, a] of shapes.get(vi.name).unwrap().axes.into_iter().enumerate() {
            if let Some(symbol) = input_symbol(&a.extent) && !carriers.into_iter().any(|c| c.symbol == symbol) {
                carriers.push(Carrier { symbol, input: vi.name, axis });
            }
        }
    }
    return carriers;
}

impl Operands {
    fn reference(&self, tensor: &String) -> String {
        let value = self.values.get(*tensor).unwrap();
        if self.already_reference.contains(*tensor) {
            return value;
        }
        return `&${value}`;
    }

    fn value(&self, tensor: &String) -> String {
        let value = self.values.get(*tensor).unwrap();
        if self.already_reference.contains(*tensor) {
            return `*${value}`;
        }
        return value;
    }
}

/// The forward pass: the graph's nodes in order, each a kernel call.
fn emit_forward(
    w: &mut CodeWriter,
    graph: &Graph,
    checked: &Checked,
    names: &Names,
    held: &TreeMap<String, String>,
    scalars: TreeMap<String, String>,
    literals: &Literals,
    mut symbols: Symbols,
) -> Result<(), EmitError> {
    let shapes = &checked.shapes;
    let mut exprs = Operands {
        values: TreeMap::<String, String>::new(),
        already_reference: TreeSet::<String>::new(),
        scalars,
    };
    let result = graph.outputs[0].name;
    let mut forward = FnSpec::new("forward", Vis::Pub);
    let mut widened: List<String> = [];
    for let vi of &graph.inputs {
        let ident = names.get(&vi.name);
        forward.add_param(ident, `&${tensor_type(checked, held, &vi.name)}`);
        exprs.values[vi.name] = ident;
        exprs.already_reference.insert(vi.name);
        if converted(checked, held, &vi.name) {
            widened.push(`let ${ident} = widen(${ident});`);
            exprs.already_reference.remove(vi.name);
        }
    }
    for let vi of &graph.initializers {
        let ident = names.get(&vi.name);
        exprs.values[vi.name] = `weights.${ident}`;
        if converted(checked, held, &vi.name) {
            widened.push(`let ${ident} = widen(&weights.${ident});`);
            exprs.values[vi.name] = ident;
        }
    }
    forward.add_param("weights", "&Weights").set_return_type(tensor_type(checked, held, &result));

    w.blank();
    w.line("/// The graph's forward pass, one kernel call per operator.");
    forward.emit_begin(w);
    emit_input_checks(w, graph, shapes, names);
    for let line of widened {
        w.line(&line);
    }
    // A symbol is bound once something spells it, which the body decides.
    let mut body: List<String> = [];
    for let tensor of literals.spelled {
        let ident = names.get(&tensor);
        body.push(`let ${ident} = ${literal_tensor(checked, &tensor, &mut symbols)?};`);
        exprs.values[tensor] = ident;
    }
    for let [alias, spelled] of literals.aliases.entries() {
        exprs.values[*alias] = names.get(spelled);
    }
    for let node of &graph.nodes {
        let produced = node.outputs[0];
        if checked.known.contains_key(produced) {
            continue;
        }
        if is_alias(node, checked) {
            let source = node.inputs[0];
            exprs.values[produced] = exprs.values.get(source).unwrap();
            if exprs.already_reference.contains(source) {
                exprs.already_reference.insert(produced);
            }
            continue;
        }
        let calls = if node.op == "Split" {
            split_calls(node, checked, &exprs);
        } else {
            [node_call(node, checked, &exprs, &mut symbols, graph.opset)?] as List<String>;
        };
        for let [i, call] of calls.into_iter().enumerate() {
            let output = node.outputs[i];
            let ident = names.get(&output);
            body.push(`let ${ident} = ${call};`);
            exprs.values[output] = ident;
        }
    }
    let mut owed: List<String> = [];
    for let c of &checked.owed {
        owed.push(wado`refuse(unmet(${symbols.spell(&c.slack)?}, "${c.reason}"));`);
    }
    for let line of symbols.bindings() {
        w.line(&line);
    }
    for let line of owed {
        w.line(&line);
    }
    for let line of body {
        w.line(&line);
    }
    let returned = if converted(checked, held, &result) {
        `narrow(${exprs.reference(&result)})`;
    } else {
        exprs.value(&result);
    };
    w.line(`return ${returned};`);
    w.end();
    return Result::Ok(());
}

/// Every folded float of one element, as the literal a closure folds in.
fn scalar_literals(checked: &Checked) -> TreeMap<String, String> {
    let mut scalars = TreeMap::<String, String>::new();
    for let [name, k] of checked.known.entries() {
        if let Floats(v) = k.elements && v.len() == 1 {
            scalars[*name] = float_literal(v[0]);
        }
    }
    return scalars;
}

/// The folded tensors `forward` binds as literals.
struct Literals {
    spelled: List<String>,
    /// A tensor a node names again under the same axes (`is_alias`), and the
    /// spelled one it reads: a transformer names its mask once per layer, and
    /// the mask is as large as the context.
    aliases: TreeMap<String, String>,
}

/// The folded tensors something reads as a tensor: all a kernel reads or the
/// graph returns, save a scalar a closure folds.
fn literal_tensors(graph: &Graph, checked: &Checked, scalars: &TreeMap<String, String>) -> Literals {
    let mut sources = TreeMap::<String, String>::new();
    for let node of &graph.nodes {
        if is_alias(node, checked) && checked.known.contains_key(node.outputs[0]) {
            sources[node.outputs[0]] = node.inputs[0];
        }
    }
    let mut literals = Literals { spelled: [], aliases: TreeMap::<String, String>::new() };
    let mut spelled_for = TreeMap::<String, String>::new();
    for let [name, _] of checked.known.entries() {
        if !checked.shapes.contains_key(*name)
            || scalars.contains_key(*name) && !read_as_tensor(graph, checked, scalars, name) {
            continue;
        }
        let mut root = *name;
        while let Some(source) = sources.get(root) {
            root = source;
        }
        let axes = axis_list(&checked.shapes[*name]);
        if let Some(spelled) = spelled_for.get(root) && axis_list(&checked.shapes[spelled]) == axes {
            literals.aliases[*name] = spelled;
            continue;
        }
        spelled_for.try_insert(root, *name);
        literals.spelled.push(*name);
    }
    return literals;
}

/// Whether a folded scalar is returned, or read where no closure folds it.
fn read_as_tensor(graph: &Graph, checked: &Checked, scalars: &TreeMap<String, String>, scalar: &String) -> bool {
    if graph.outputs[0].name == *scalar {
        return true;
    }
    for let node of graph.nodes {
        if checked.known.contains_key(node.outputs[0]) {
            continue;
        }
        for let [index, input] of node.inputs.into_iter().enumerate() {
            if input == *scalar && folded_literal(&node, index, scalars, &checked.shapes) matches { None } {
                return true;
            }
        }
    }
    return false;
}

/// A folded tensor spelled out as a `Tensor` literal, under the shape stage 0
/// gave it.
fn literal_tensor(checked: &Checked, tensor: &String, symbols: &mut Symbols) -> Result<String, EmitError> {
    let shape = checked.shapes.get(*tensor).unwrap();
    let data = match checked.known.get(*tensor).unwrap().elements {
        Ints(v) => `${v}`,
        Symbolic(v) => {
            let mut spelled: List<String> = [];
            for let p of v {
                spelled.push(symbols.spell(&p)?);
            }
            `[${spelled.join(", ")}]`;
        },
        Floats(v) => {
            let spelled: List<String> = v.into_iter().map(|x| float_literal(x)).collect();
            `[${spelled.join(", ")}]`;
        },
        // A mask is as large as the context it covers, so it is spelled as
        // bytes, which the compiler folds into a data segment.
        Bools(v) => {
            let mut bytes = ByteList::with_capacity(v.len());
            for let b of v {
                bytes.push(if b { 1 } else { 0 });
            }
            `List::<u8>::from_le_bytes(${byte_string_literal(&bytes)}).into_iter().map(|b| b != 0).collect()`;
        },
    };
    let element = checked.primitives.get(*tensor).unwrap();
    return Result::Ok(
        `Tensor::<${element}, [${axis_list(&shape)}]> { data: ${data}, extents: ${symbols.spell_all(&extents_of(&shape))?} }`,
    );
}

/// Checks at the top of `forward` that stop it naming the axis an input
/// disagrees on, before any kernel reads the input.
fn emit_input_checks(w: &mut CodeWriter, graph: &Graph, shapes: &TreeMap<String, Shape>, names: &Names) {
    let mut first_seen = TreeMap::<String, String>::new();
    let mut agreements: List<String> = [];
    for let vi of &graph.inputs {
        let ident = names.get(&vi.name);
        let shape = shapes.get(vi.name).unwrap();
        let mut axes: List<String> = [];
        let mut stated: List<i32> = [];
        for let [i, axis] of shape.axes.into_iter().enumerate() {
            axes.push(wado`"${axis.name}"`);
            let Some(symbol) = input_symbol(&axis.extent) else {
                stated.push(axis.static_extent());
                continue;
            };
            stated.push(-1);
            let extent = `${ident}.extents[${i}]`;
            if let Some(first) = first_seen.get(symbol) {
                agreements.push(
                    wado`refuse(axis_mismatch("${symbol}", "${vi.name}", "${axis.name}", ${extent}, ${first}));`,
                );
            } else {
                first_seen[symbol] = `${wado`"${vi.name}"`}, ${extent}`;
            }
        }
        w.line(wado`refuse(input_mismatch(${ident}, "${vi.name}", [${axes.join(", ")}], ${stated}));`);
    }
    for let line of agreements {
        w.line(&line);
    }
}

fn extents_of(shape: &Shape) -> List<Extent> {
    return shape.axes.into_iter().map(|axis| axis.extent).collect();
}

/// Whether a boundary tensor is held in something other than what the kernels
/// compute it in, so `forward` converts it on the way past.
fn converted(checked: &Checked, held: &TreeMap<String, String>, tensor: &String) -> bool {
    return held.get(*tensor).unwrap() != checked.primitives.get(*tensor).unwrap();
}

/// Whether a node computes nothing, so its output is another name for its
/// operand: an `Identity`, or a `Cast` to the primitive the operand has.
fn is_alias(node: &Node, checked: &Checked) -> bool {
    let primitives = &checked.primitives;
    return node.op == "Identity"
        || node.op == "Cast" && primitives.get(node.inputs[0]) == primitives.get(node.outputs[0]);
}

/// A tensor's type, as the axis marker types name it. A tensor the boundary
/// does not declare is held in what stage 0 computes it in.
fn tensor_type(checked: &Checked, held: &TreeMap<String, String>, tensor: &String) -> String {
    let shape = checked.shapes.get(*tensor).unwrap();
    let element = match held.get(*tensor) {
        Some(p) => p,
        None => checked.primitives.get(*tensor).unwrap(),
    };
    return `Tensor<${element}, [${axis_list(&shape)}]>`;
}

fn axis_list(shape: &Shape) -> String {
    return axis_run(shape, 0, shape.rank());
}

/// The names of `shape`'s axes `from..<to`, as a turbofish lists them.
fn axis_run(shape: &Shape, from: i32, to: i32) -> String {
    let mut names: List<String> = [];
    for let i of from..<to {
        names.push(shape.axes[i].name);
    }
    return names.join(", ");
}

/// What stage 0 read already: a failure stopped the build there.
fn settled<T>(read: Result<T, InferError>) -> T {
    let Ok(value) = read else {
        unreachable();
    };
    return value;
}

/// One node as the kernel call that computes it. The operand expressions are
/// already in scope, since a graph's nodes are in topological order.
fn node_call(
    node: &Node,
    checked: &Checked,
    exprs: &Operands,
    symbols: &mut Symbols,
    opset: Option<i64>,
) -> Result<String, EmitError> {
    let shapes = &checked.shapes;
    let op = node.op;
    if op == "Reshape" || op == "Flatten" || op == "Unsqueeze" || op == "Squeeze" {
        let from = shapes.get(node.inputs[0]).unwrap();
        let to = shapes.get(node.outputs[0]).unwrap();
        let operand = exprs.reference(&node.inputs[0]);
        let element = checked.primitives.get(node.inputs[0]).unwrap();
        return Result::Ok(
            `reshape::<${element}, [${axis_list(&from)}], [${axis_list(&to)}]>(${operand}, ${symbols.spell_all(
                &extents_of(&to),
            )?})`,
        );
    }
    if op == "Slice" {
        return slice_call(node, checked, exprs, symbols);
    }
    if op == "Range" {
        let [start, _, delta] = settled(range_bounds(node, &checked.known));
        // Stage 0 kept what the count owes in `checked.owed` already.
        let count = settled(range_count(node, &checked.known, &mut []));
        let axis = shapes.get(node.outputs[0]).unwrap().axes[0].name;
        return Result::Ok(
            `range_i64::<${axis}>(${symbols.spell(&start)?}, ${symbols.spell_extent(&count.poly())?}, ${symbols.spell(&delta)?})`,
        );
    }
    if op == "Cast" {
        let from = checked.primitives.get(node.inputs[0]).unwrap();
        let to = checked.primitives.get(node.outputs[0]).unwrap();
        return Result::Ok(`map(${exprs.reference(&node.inputs[0])}, |v| ${cast_body(&from, &to)})`);
    }
    if op == "Gather" {
        let axis = settled(gather_axis(node, shapes.get(node.inputs[0]).unwrap().rank()));
        if axis != 0 {
            return Result::Err(EmitError::Refused(Refusal::of(node, `no kernel gathers along axis ${axis}`)));
        }
        return Result::Ok(`gather_rows(${exprs.reference(&node.inputs[0])}, ${exprs.reference(&node.inputs[1])})`);
    }
    if op == "MaxPool" || op == "Conv" {
        return Result::Ok(window_call(node, shapes, exprs));
    }
    if op == "MatMul" {
        let [a, b, left, right] = binary_call(node, shapes, exprs);
        if left.rank() > 2 && right.rank() == 2 {
            return Result::Ok(`matmul_shared(${a}, ${b})`);
        }
        // The kernel's signature is `[..Bs, M, K]` against `[..Bs, K, N]`, so
        // a rank-1 operand and a broadcast batch axis have no call to write.
        if left.rank() < 2 || left.rank() != right.rank() || !batch_axes_agree(&left, &right) {
            builtin::cold_path();
            return Result::Err(broadcast_error(node, &left, &right));
        }
        return Result::Ok(`matmul(${a}, ${b})`);
    }
    if is_binary_elementwise(&op) {
        return binary_node_call(node, shapes, exprs);
    }
    if op == "Gemm" {
        return gemm_call(node, shapes, exprs);
    }
    if op == "Where" {
        let out = shapes.get(node.outputs[0]).unwrap();
        let mut operands: List<String> = [];
        for let tensor of node.inputs {
            operands.push(lifted(node, &tensor, &out, checked, exprs)?);
        }
        return Result::Ok(`select(${operands.join(", ")})`);
    }
    if op == "Softmax" {
        let axis = settled(softmax_axis(node, shapes.get(node.inputs[0]).unwrap().rank(), opset));
        return Result::Ok(`softmax(${exprs.reference(&node.inputs[0])}, ${axis})`);
    }
    if is_reduction(&op) {
        return reduction_call(node, checked, exprs);
    }
    if op == "Transpose" {
        let shape = shapes.get(node.inputs[0]).unwrap();
        let perm = settled(transpose_perm(node, shape.rank()));
        // Every node result is bound as a value, so the operand is read as one.
        if is_identity(&perm) {
            return Result::Ok(exprs.value(&node.inputs[0]));
        }
        let a = exprs.reference(&node.inputs[0]);
        let element = checked.primitives.get(node.inputs[0]).unwrap();
        let to = shapes.get(node.outputs[0]).unwrap();
        return Result::Ok(`permute::<${element}, [${axis_list(&shape)}], [${axis_list(&to)}]>(${a}, ${perm})`);
    }
    let Some(body) = unary_body(&op) else {
        // Stage 0 refuses every operator the kernels lack.
        unreachable();
    };
    return Result::Ok(`map(${exprs.reference(&node.inputs[0])}, |v| ${body})`);
}

/// A `Split` as one `slice_axis` per output, each cutting the next run.
fn split_calls(node: &Node, checked: &Checked, exprs: &Operands) -> List<String> {
    let shapes = &checked.shapes;
    let x = shapes.get(node.inputs[0]).unwrap();
    let parts = settled(split_parts(node, &checked.known, &x));
    let axis = settled(split_axis(node, x.rank()));
    let element = checked.primitives.get(node.inputs[0]).unwrap();
    let pre = axis_run(&x, 0, axis);
    let post = axis_run(&x, axis + 1, x.rank());
    let operand = exprs.reference(&node.inputs[0]);
    let mut calls: List<String> = [];
    let mut start = 0;
    for let [i, part] of parts.into_iter().enumerate() {
        let part_axis = shapes.get(node.outputs[i]).unwrap().axes[axis].name;
        let turbofish = `::<${element}, [${pre}], ${x.axes[axis].name}, ${part_axis}, [${post}]>`;
        calls.push(`slice_axis${turbofish}(${operand}, ${axis}, ${start}, ${part})`);
        start += part;
    }
    return calls;
}

/// A `Slice` as one `slice_axis` per axis it narrows, each call reading the
/// last. The axes between are the output's where already cut, the input's where not.
fn slice_call(node: &Node, checked: &Checked, exprs: &Operands, symbols: &mut Symbols) -> Result<String, EmitError> {
    let x = checked.shapes.get(node.inputs[0]).unwrap();
    let out = checked.shapes.get(node.outputs[0]).unwrap();
    let element = checked.primitives.get(node.inputs[0]).unwrap();
    // Stage 0 kept what the bounds owe in `checked.owed` already.
    let cuts = settled(slice_cuts(node, &checked.known, &x, &mut []));
    // A slice that narrows nothing is its operand, read as a value.
    let mut call = exprs.value(&node.inputs[0]);
    let mut operand = exprs.reference(&node.inputs[0]);
    let mut current = x;
    for let cut of cuts {
        let a = cut.axis;
        let turbofish = `::<${element}, [${axis_run(&current, 0, a)}], ${current.axes[a].name}, ${out.axes[a].name}, [${axis_run(
            &current,
            a + 1,
            current.rank(),
        )}]>`;
        call = `slice_axis${turbofish}(${operand}, ${a}, ${symbols.spell_extent(&cut.start)?}, ${symbols.spell_extent(
            &cut.extent.poly(),
        )?})`;
        operand = `&${call}`;
        current.axes[a] = out.axes[a];
    }
    return Result::Ok(call);
}

/// An operand as a tensor of `out`'s rank, for a kernel whose operands share
/// one axis list. A shorter one is lifted under `out`'s leading axes.
fn lifted(node: &Node, tensor: &String, out: &Shape, checked: &Checked, exprs: &Operands) -> Result<String, EmitError> {
    let shape = checked.shapes.get(*tensor).unwrap();
    if !shared_axes_agree(&shape, out) {
        builtin::cold_path();
        return Result::Err(broadcast_error(node, &shape, out));
    }
    let operand = exprs.reference(tensor);
    if shape.rank() == out.rank() {
        return Result::Ok(operand);
    }
    // The shared axes agree by name, so the lifted operand's are `out`'s.
    let element = checked.primitives.get(*tensor).unwrap();
    return Result::Ok(
        `&lift::<${element}, [${axis_list(&shape)}], [${axis_list(out)}]>(${operand}, ${out.rank()})`,
    );
}

/// A `ReduceMean` or `ReduceSum`, whose kernels keep each reduced axis at
/// extent 1, so one that drops them has no call to write.
fn reduction_call(node: &Node, checked: &Checked, exprs: &Operands) -> Result<String, EmitError> {
    let x = checked.shapes.get(node.inputs[0]).unwrap();
    if checked.shapes.get(node.outputs[0]).unwrap().rank() != x.rank() {
        return Result::Err(EmitError::Refused(Refusal::of(node, "no kernel drops a reduced axis")));
    }
    let axes = settled(reduced_axes(node, &checked.known, x.rank()));
    let a = exprs.reference(&node.inputs[0]);
    if node.op == "ReduceMean" {
        return Result::Ok(`reduce_mean(${a}, ${axes})`);
    }
    return Result::Ok(`reduce(${a}, ${axes}, 0.0, |x, y| x + y)`);
}

/// The literal operand `index` folds into a closure as: a `Gemm` bias, or an
/// arithmetic operand whose partner is a tensor it does not widen. `None` reads it as a tensor.
fn folded_literal(
    node: &Node,
    index: i32,
    scalars: &TreeMap<String, String>,
    shapes: &TreeMap<String, Shape>,
) -> Option<String> {
    let Some(literal) = scalars.get(node.inputs[index]) else {
        return null;
    };
    if node.op == "Gemm" {
        return if index == 2 { Option::Some(literal) } else { null };
    }
    if index > 1 || !is_binary_elementwise(&node.op) {
        return null;
    }
    let partner = node.inputs[1 - index];
    if scalars.contains_key(partner) || shapes[node.inputs[index]].rank() > shapes[partner].rank() {
        return null;
    }
    return Option::Some(literal);
}

/// A two-operand node's operand expressions and the shapes stage 0 gave them.
fn binary_call(node: &Node, shapes: &TreeMap<String, Shape>, exprs: &Operands) -> [String, String, Shape, Shape] {
    return [
        exprs.reference(&node.inputs[0]),
        exprs.reference(&node.inputs[1]),
        shapes.get(node.inputs[0]).unwrap(),
        shapes.get(node.inputs[1]).unwrap(),
    ];
}

/// One binary elementwise node. A folded scalar operand folds into the closure,
/// so no tensor is allocated for it and the other operand is walked once.
fn binary_node_call(node: &Node, shapes: &TreeMap<String, Shape>, exprs: &Operands) -> Result<String, EmitError> {
    let op = node.op;
    if let Some(literal) = folded_literal(node, 1, &exprs.scalars, shapes) {
        let body = binary_body(&op, &"v", &literal);
        return Result::Ok(`map(${exprs.reference(&node.inputs[0])}, |v| ${body})`);
    }
    if let Some(literal) = folded_literal(node, 0, &exprs.scalars, shapes) {
        let body = binary_body(&op, &literal, &"v");
        return Result::Ok(`map(${exprs.reference(&node.inputs[1])}, |v| ${body})`);
    }
    let [a, b, left, right] = binary_call(node, shapes, exprs);
    let body = binary_body(&op, &"x", &"y");
    let Some(call) = elementwise_call(&a, &b, &left, &right, &body) else {
        builtin::cold_path();
        return Result::Err(broadcast_error(node, &left, &right));
    };
    return Result::Ok(call);
}

/// A `MaxPool` or `Conv` as its kernel, over the window stage 0 read. Each
/// spatial axis list is a pack, so the turbofish spells the output's.
fn window_call(node: &Node, shapes: &TreeMap<String, Shape>, exprs: &Operands) -> String {
    let x = shapes.get(node.inputs[0]).unwrap();
    let y = shapes.get(node.outputs[0]).unwrap();
    let window = settled(window_of(node, &x, shapes));
    let geometry = `&Window { kernel: ${window.kernel}, strides: ${window.strides}, dilations: ${window.dilations}, pads: ${window.pads}, output: ${window.output} }`;
    let input = exprs.reference(&node.inputs[0]);
    if node.op == "MaxPool" {
        return `max_pool::<${x.axes[0].name}, ${x.axes[1].name}, [${spatial_axes(&x)}], [${spatial_axes(&y)}]>(${input}, ${geometry})`;
    }
    let w = shapes.get(node.inputs[1]).unwrap();
    let turbofish = `::<${x.axes[0].name}, ${x.axes[1].name}, ${w.axes[0].name}, [${spatial_axes(&x)}], [${spatial_axes(
        &w,
    )}], [${spatial_axes(&y)}]>`;
    let weight = exprs.reference(&node.inputs[1]);
    if has_bias(node) {
        return `conv_bias${turbofish}(${input}, ${weight}, ${exprs.reference(&node.inputs[2])}, ${geometry})`;
    }
    return `conv${turbofish}(${input}, ${weight}, ${geometry})`;
}

/// The axes past a shape's first two, which a window slides over.
fn spatial_axes(shape: &Shape) -> String {
    return axis_run(shape, 2, shape.rank());
}

/// A constant as an expression the generated source spells. Wado has no
/// literal for a non-finite float, and a mask is written with `-inf`.
fn float_literal(value: f32) -> String {
    if value.is_nan() {
        return "f32::NAN";
    }
    if value == f32::INFINITY {
        return "f32::INFINITY";
    }
    if value == f32::NEG_INFINITY {
        return "-f32::INFINITY";
    }
    // The shortest round-tripping form of a float can be an integer, so the
    // cast is what makes it a float.
    return `(${value} as f32)`;
}

/// The kernel that combines two operands elementwise, chosen by which is the
/// shorter, or `None` where no kernel broadcasts one against the other.
fn elementwise_call(a: &String, b: &String, left: &Shape, right: &Shape, body: &String) -> Option<String> {
    if !shared_axes_agree(left, right) {
        return null;
    }
    if left.rank() == right.rank() {
        return Option::Some(`zip(${a}, ${b}, |x, y| ${body})`);
    }
    if right.rank() < left.rank() {
        let turbofish = `::<[${axis_run(left, 0, left.rank() - right.rank())}], [${axis_list(right)}]>`;
        return Option::Some(`zip_suffix${turbofish}(${a}, ${b}, |x, y| ${body})`);
    }
    let turbofish = `::<[${axis_run(right, 0, right.rank() - left.rank())}], [${axis_list(left)}]>`;
    return Option::Some(`zip_suffix_lhs${turbofish}(${a}, ${b}, |x, y| ${body})`);
}

/// `Gemm`'s `alpha * A' * B' + beta * C`, as a `matmul` under optional
/// `transpose2`s, a `map` per scalar that is not one, and a bias add.
fn gemm_call(node: &Node, shapes: &TreeMap<String, Shape>, exprs: &Operands) -> Result<String, EmitError> {
    let [alpha, beta, trans_a, trans_b] = settled(gemm_options(node));
    let a = transposed(&exprs.reference(&node.inputs[0]), trans_a);
    let b = transposed(&exprs.reference(&node.inputs[1]), trans_b);
    let mut product = `matmul(${a}, ${b})`;
    if alpha != 1.0 {
        product = `map(&${product}, |v| v * ${float_literal(alpha)})`;
    }
    if !has_bias(node) {
        return Result::Ok(product);
    }
    if let Some(literal) = folded_literal(node, 2, &exprs.scalars, shapes) {
        let scaled = if beta == 1.0 { literal } else { `${literal} * ${float_literal(beta)}` };
        return Result::Ok(`map(&${product}, |v| v + ${scaled})`);
    }
    let mut bias = exprs.reference(&node.inputs[2]);
    if beta != 1.0 {
        bias = `&map(${bias}, |v| v * ${float_literal(beta)})`;
    }
    let produced = shapes.get(node.outputs[0]).unwrap();
    let c = shapes.get(node.inputs[2]).unwrap();
    let Some(call) = elementwise_call(&`&${product}`, &bias, &produced, &c, &"x + y") else {
        builtin::cold_path();
        return Result::Err(broadcast_error(node, &produced, &c));
    };
    return Result::Ok(call);
}

fn transposed(operand: &String, flag: bool) -> String {
    if flag {
        return `&transpose2(${operand})`;
    }
    return *operand;
}

fn is_identity(perm: &List<i32>) -> bool {
    for let [i, axis] of perm.into_iter().enumerate() {
        if *axis != i {
            return false;
        }
    }
    return true;
}

fn broadcast_error(node: &Node, left: &Shape, right: &Shape) -> EmitError {
    return EmitError::Broadcast(UnimplementedBroadcast {
        node: node.outputs[0],
        op: node.op,
        left: axis_list(left),
        right: axis_list(right),
    });
}

/// Whether one axis of a kernel's signature can stand for both of these. Stage
/// 0 stretches an extent of 1 and `matmul` does not, so the name is not enough.
fn same_axis(left: &Axis, right: &Axis) -> bool {
    return left.name == right.name && left.extent.agrees(&right.extent);
}

/// `same_axis` for an elementwise kernel, which stretches an extent of 1.
fn stretchable_axis(left: &Axis, right: &Axis) -> bool {
    return left.name == right.name
        && (left.extent.agrees(&right.extent) || left.extent.is_one() || right.extent.is_one());
}

/// Whether the axes the two operands share, aligned from the end as every
/// elementwise kernel aligns them, are one list.
fn shared_axes_agree(left: &Shape, right: &Shape) -> bool {
    let common = i32::min(left.rank(), right.rank());
    for let mut back = 0; back < common; back += 1 {
        if !stretchable_axis(left.from_end(back), right.from_end(back)) {
            return false;
        }
    }
    return true;
}

/// Whether two `MatMul` operands' batch axes are one list, which is what the
/// kernel's single `..Bs` says.
fn batch_axes_agree(left: &Shape, right: &Shape) -> bool {
    assert left.rank() == right.rank();
    for let mut i = 0; i < left.rank() - 2; i += 1 {
        if !same_axis(&left.axes[i], &right.axes[i]) {
            return false;
        }
    }
    return true;
}

/// The expression a binary operator's elements combine through.
fn binary_body(op: &String, lhs: &String, rhs: &String) -> String {
    if *op == "Add" {
        return `${lhs} + ${rhs}`;
    }
    if *op == "Sub" {
        return `${lhs} - ${rhs}`;
    }
    if *op == "Mul" {
        return `${lhs} * ${rhs}`;
    }
    if *op == "Div" {
        return `${lhs} / ${rhs}`;
    }
    if *op == "Pow" {
        return `f32::pow(${lhs}, ${rhs})`;
    }
    // Stage 0 refuses every operator the kernels lack.
    unreachable();
}

/// One element `v` of primitive `from` as `to`, as ONNX's `Cast` converts it:
/// a bool is 1 or 0, and anything nonzero is true.
fn cast_body(from: &String, to: &String) -> String {
    if *from == "bool" {
        return if *to == "i64" { "if v { 1 } else { 0 }" } else { "if v { 1.0 } else { 0.0 }" };
    }
    if *to == "bool" {
        return if *from == "i64" { "v != 0" } else { "v != 0.0" };
    }
    return `v as ${to}`;
}

/// The expression a unary operator maps each element through, over `v`.
fn unary_body(op: &String) -> Option<String> {
    if *op == "Relu" {
        return Option::Some("f32::max(v, 0.0)");
    }
    if *op == "Sigmoid" {
        return Option::Some("sigmoid_f32(v)");
    }
    if *op == "Tanh" {
        return Option::Some("f32::tanh(v)");
    }
    if *op == "Erf" {
        return Option::Some("f32::erf(v)");
    }
    if *op == "Exp" {
        return Option::Some("f32::exp(v)");
    }
    if *op == "Log" {
        return Option::Some("f32::ln(v)");
    }
    if *op == "Sqrt" {
        return Option::Some("f32::sqrt(v)");
    }
    if *op == "Neg" {
        return Option::Some("-v");
    }
    if *op == "Abs" {
        return Option::Some("f32::abs(v)");
    }
    return null;
}

/// Every axis name the checked graph uses, in first-seen order so the emitted
/// module is stable across runs.
fn axis_names(graph: &Graph, shapes: &TreeMap<String, Shape>) -> List<String> {
    let mut seen = TreeSet::<String>::new();
    let mut names: List<String> = [];
    for let vi of &graph.inputs {
        push_axes(&mut names, &mut seen, shapes, &vi.name);
    }
    for let vi of &graph.initializers {
        push_axes(&mut names, &mut seen, shapes, &vi.name);
    }
    for let node of &graph.nodes {
        for let output of node.outputs {
            push_axes(&mut names, &mut seen, shapes, &output);
        }
    }
    return names;
}

fn push_axes(names: &mut List<String>, seen: &mut TreeSet<String>, shapes: &TreeMap<String, Shape>, tensor: &String) {
    let Some(shape) = shapes.get(*tensor) else {
        return;
    };
    push_markers(names, seen, &shape.axes);
}

/// A merged axis is spelled with its parts' markers, so the parts are what the
/// module declares.
fn push_markers(names: &mut List<String>, seen: &mut TreeSet<String>, axes: &List<Axis>) {
    for let axis of *axes {
        if !axis.parts.is_empty() {
            push_markers(names, seen, &axis.parts);
        } else if seen.insert(axis.name) {
            names.push(axis.name);
        }
    }
}
