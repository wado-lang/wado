//! The Wado a checked graph becomes: one marker type per axis, a `build` that
//! adds the operations the graph's operators lower to, and a `compute` that
//! runs it from inputs on the host.

use { HashMap, HashSet } from "core:collections";
use { Deserialize } from "core:serde";
use { CodeWriter, FnSpec, ImplSpec, StructSpec, Vis, byte_string_literal, wado } from "lib:wadopoet";
use { built_call, built_split } from "./emit_ops.wado";
use {
    Carrier,
    Grown,
    Names,
    Operands,
    Symbols,
    axis_list,
    capacity_key,
    float_literal,
    symbol_carriers,
    symbol_key,
} from "./emit_symbols.wado";
use { Extent } from "./extent.wado";
use {
    BACKEND_PARAM,
    CACHE,
    CHECKPOINT_PARAM,
    CHOSEN,
    DECODE,
    DECODE_ROWS,
    DECODED,
    DECODED_TYPE,
    LEAST_EXTENTS,
    LENGTHS,
    MAP,
    MODEL,
    OUTPUTS,
    PARAMS,
    PASSED,
    RECORDED_DECODED,
    RECORDED,
    REQUESTS,
    RUNTIME_NAMES,
} from "./idents.wado";
use { padding } from "./pad.wado";
use { Condition, Poly, equalities } from "./poly.wado";
use { Axis, Shape } from "./shape.wado";
use {
    Elements,
    GROUP_QUERY_ATTENTION,
    Graph,
    InPlace,
    Known,
    Node,
    ValueInfo,
    element_of,
    settled,
} from "./graph.wado";
use { IfBranch, SpelledAttention, branches, branches_of, is_alias, lowerings } from "./lowering.wado";
use { Expected } from "./runtime/checkpoint.wado";
use { RowRefusal, SLOTS, folded_rows, graph_operands, judged_rows, keeps_lifted, lifted_operands } from "./rows.wado";
use { expected } from "./safetensors.wado";
use {
    ATTENTION_BIAS,
    Checked,
    ROTARY_COS,
    ROTARY_SIN,
    attention_options,
    is_elementwise,
    named_present,
    range_bounds,
} from "./infer.wado";

pub use { EmitError, NameCollision, UnmappedDtype } from "./emit_symbols.wado";

/// Where `Params::load` reads the weights the graph leaves to it: a
/// checkpoint in one file, each in the shard an index places it in, or one
/// file at the byte ranges the build found them at.
pub variant Placement {
    File,
    Shards(HashMap<String, String>),
    InPlace(InPlace),
}

/// The tensors a `decode` entry loops over: the input taking each row's token,
/// the mask of the positions so far, and the output a step picks from.
export struct Decode {
    pub ids: String,
    pub mask: String,
    pub logits: String,
}

impl Deserialize for Decode;

/// The generated module's source, importing the runtime from the package spec
/// `runtime`. Every axis the graph mentions becomes a marker type, so two
/// tensors sharing an axis share one type. `decode` offers `decode` beside
/// `compute`. Each row of a batch holds lengths of its own where `rows_judged`
/// finds the axis they run along, and shares one otherwise.
pub fn emit(
    graph: &Graph,
    checked: &Checked,
    runtime: &String,
    placement: Placement = Placement::File,
    decode: Option<Decode> = null,
) -> Result<String, EmitError> {
    let prepared = Prepared::of(graph, checked, &placement)?;
    let rows = match prepared.rows(graph, checked) {
        Ok(rows) => rows,
        Err(_) => null,
    };
    return prepared.written(graph, checked, runtime, &placement, decode, &prepared.built(graph, checked, rows)?);
}

/// The axis the rows of a batch run along where each row holds lengths of its
/// own in what `emit` writes, `null` where the inputs pad no length, and the
/// refusal where the rows share their lengths.
pub fn rows_judged(graph: &Graph, checked: &Checked) -> Result<Option<String>, EmitError> {
    let rows = Prepared::of(graph, checked, &Placement::File)?.rows(graph, checked).map_err(|r| EmitError::Shared(r))?;
    return Result::Ok(rows.map(|r| r.name));
}

/// The lengths `build` pads to a capacity: each one no node refuses and an
/// input carries.
fn padded_symbols(graph: &Graph, checked: &Checked, carriers: &List<Carrier>) -> List<String> {
    return padding(graph, checked).into_iter().filter(|j| j.refused matches { None }
        && carriers.into_iter().any(|c| c.solved.symbol == j.symbol)).map(|j| j.symbol).collect();
}

/// What `emit` writes the module from but `build`: the graph's names, and the
/// lengths every entry reads.
struct Prepared {
    held: HashMap<String, String>,
    /// Only a sharded `load` names the map.
    imports_map: bool,
    axes: List<String>,
    literals: Literals,
    crossing: Crossing,
    carriers: List<Carrier>,
    names: Names,
    kept: List<String>,
    grown: List<[Grown, Option<Poly>]>,
    padded: List<String>,
    conditions: List<String>,
}

/// `build`, written apart, and the padded symbols it reads the value of.
struct Built {
    source: CodeWriter,
    read: List<String>,
    per_row: bool,
}

impl Prepared {
    fn of(graph: &Graph, checked: &Checked, placement: &Placement) -> Result<Prepared, EmitError> {
        if let Shards(placed) = placement {
            for let vi of &graph.initializers {
                assert vi.data matches { Some(_) } || placed.contains_key(vi.name), "a sharded placement must place every weight the graph leaves to the checkpoint";
            }
        }
        if let InPlace(in_place) = placement {
            for let vi of &graph.initializers {
                assert vi.data matches { Some(_) } || in_place.ranges.contains_key(vi.name), "weights left in place must each have a range";
            }
        }
        if graph.outputs.is_empty() {
            builtin::cold_path();
            return Result::Err(EmitError::NoOutput);
        }
        let held = boundary_elements(graph)?;
        let imports_map = placement matches { Shards(_) } && loads_weights(graph);
        let axes = axis_names(graph, checked);
        let literals = graph_literals(graph, checked);
        let crossing = Crossing::of(graph, cache_pairs(graph));
        let carriers = symbol_carriers(graph, &checked.shapes, &crossing.cached);
        let names = Names::of(named_tensors(graph, checked, &literals.spelled, &carriers), &axes, imports_map)?;
        let kept = kept_literals(&literals, checked);
        let grown = grown_lengths(checked, &crossing, &carriers)?;
        let padded = padded_symbols(graph, checked, &carriers);
        let inputs: List<String> = graph.inputs.into_iter().map(|vi| vi.name).filter(|t| !crossing.cached.contains(t)).collect();
        let conditions = held_conditions(graph, checked, &inputs);
        return Result::Ok(
            Prepared { held, imports_map, axes, literals, crossing, carriers, names, kept, grown, padded, conditions },
        );
    }

    /// The lengths that grow, as the graph owes them, that `build` pads.
    fn padded_grown(&self) -> List<[Grown, Option<Poly>]> {
        return self.grown.into_iter().filter(|o| self.padded.contains(&o.0.symbol)).collect();
    }

    /// `judged_rows` of the lengths `build` pads.
    fn rows(&self, graph: &Graph, checked: &Checked) -> Result<Option<Axis>, RowRefusal> {
        let grown: List<String> = self.padded_grown().into_iter().map(|o| o.0.symbol).collect();
        return judged_rows(graph, checked, &self.padded, &grown);
    }

    /// `build`, each row's lengths its own along `rows` where it is an axis,
    /// which `rows` must have judged.
    fn built(&self, graph: &Graph, checked: &Checked, rows: Option<Axis>) -> Result<Built, EmitError> {
        let held_symbols = Symbols::of(
            &self.carriers,
            &self.names,
            |input, axis| `backend.extents_of(${*input})[${axis}]`,
        );
        let mut symbols = held_symbols.padded(&self.padded, &self.padded_grown(), &self.conditions, &self.names);
        if let Some(r) = rows {
            symbols.along_rows(r.name, r.extent.poly().symbols());
        }
        let mut source = CodeWriter::with_capacity(8192);
        let read = emit_build(
            &mut source,
            graph,
            checked,
            &self.names,
            &self.literals,
            &self.kept,
            symbols,
            &self.crossing,
            &self.conditions,
        )?;
        return Result::Ok(Built { source, read, per_row: rows matches { Some(_) } });
    }

    /// The module, `built` its `build`.
    fn written(
        &self,
        graph: &Graph,
        checked: &Checked,
        runtime: &String,
        placement: &Placement,
        decode: Option<Decode>,
        built: &Built,
    ) -> Result<String, EmitError> {
        let [names, crossing] = [&self.names, &self.crossing];
        let mut w = CodeWriter::with_capacity(8192);
        w.line(`//! Generated by Loam from the ONNX graph \`${graph.name}\`.`);
        w.line("//! Each axis is a marker type, so two tensors that share an axis");
        w.line("//! share the type that names it.");
        w.blank();
        w.line("use {");
        for let name of RUNTIME_NAMES {
            w.line(`    ${name},`);
        }
        w.line(wado`} from "${*runtime}";`);
        if self.imports_map {
            w.line(`use { ${MAP} } from "core:collections";`);
        }
        w.blank();
        let fixed = boundary_extents(graph, &checked.shapes);
        for let axis of &self.axes {
            StructSpec::new(*axis, Vis::Pub).emit(&mut w);
            if let Some(extent) = fixed.get(*axis) {
                ImplSpec::new(*axis).emit_begin(&mut w);
                w.line(`pub const EXTENT: i32 = ${extent};`);
                w.end();
            }
        }
        emit_weights(&mut w, graph, checked, names, &self.held, &self.kept, placement);
        if crossing.has_cache() {
            emit_cache(&mut w, &crossing.pairs, checked, names);
        }
        if crossing.several() {
            emit_outputs(&mut w, &crossing.returned, crossing.has_cache(), checked, names, &self.held);
            emit_passed(&mut w, &crossing.returned, crossing.has_cache(), checked, names);
        }
        w.blank();
        w.append(&built.source);
        let per_row = built.per_row;
        // A past is held in the cache, at its capacity.
        let cached: List<String> = crossing.cached.into_iter().map(|t| names.get(&t)).collect();
        let host_symbols = Symbols::of(&self.carriers, names, |input, axis| if cached.contains(input) {
            `backend.extents_of(&cache.${*input})[${axis}]`;
        } else {
            `${*input}.extents[${axis}]`;
        });
        let mut decoding: Option<DecodingAxes> = null;
        if let Some(d) = &decode {
            decoding = Option::Some(
                decoding_axes(d, graph, checked, crossing, &self.padded, &self.grown, &self.conditions)?,
            );
        }
        let context = EntryContext {
            graph,
            checked,
            names,
            held: &self.held,
            carriers: &self.carriers,
            padded: &self.padded,
            read: &built.read,
            kept: &self.kept,
            crossing,
            owed: &self.grown,
            conditions: &self.conditions,
            per_row,
        };
        emit_compute(&mut w, &context, host_symbols, &decoding)?;
        if let Some(decoded) = &decoding {
            emit_decode(&mut w, &context, host_symbols, decoded, null)?;
            let grown = &self.grown;
            if per_row
                && let Some(first) = grown.into_iter().next()
                && grown.into_iter().all(|g| g.0.symbol == first.0.symbol) {
                let past = first.0.symbol;
                assert self.padded.contains(&past), "each row's past is a length a row of its own holds apart";
                emit_decode(&mut w, &context, host_symbols, decoded, Option::Some(past))?;
                emit_requests(&mut w, &context, decoded);
            }
        }
        return Result::Ok(w.to_string());
    }
}

/// The length of each axis that every input, output and weight naming it fixes
/// to one, which the caller then writes as the axis's `EXTENT` rather than a
/// number. A weight's extents are its checkpoint header's, read at build time.
fn boundary_extents(graph: &Graph, shapes: &HashMap<String, Shape>) -> HashMap<String, i32> {
    let mut fixed = HashMap::<String, i32>::new();
    let mut open = HashSet::<String>::new();
    for let declared of [&graph.inputs, &graph.outputs, &graph.initializers] {
        for let vi of *declared {
            for let axis of shapes.get(vi.name).unwrap().axes {
                let Static(extent) = axis.extent else {
                    open.insert(axis.name);
                    continue;
                };
                if !fixed.try_insert(axis.name, extent) && fixed[axis.name] != extent {
                    open.insert(axis.name);
                }
            }
        }
    }
    for let name of open {
        fixed.remove(name);
    }
    return fixed;
}

/// Each past input and the present output it pairs with, by the names Hugging
/// Face's exporters give them: `past<rest>` pairs with `present<rest>`, but
/// `past_key_values.<rest>` with `present.<rest>`. A past no present pairs
/// with stays an input, as a decoder's encoder keys or `past_sequence_length`
/// do, and a present no past pairs with stays an output.
fn cache_pairs(graph: &Graph) -> List<[String, String]> {
    let outputs: List<String> = graph.outputs.into_iter().map(|vi| vi.name).collect();
    let mut pairs: List<[String, String]> = [];
    for let vi of &graph.inputs {
        let past = vi.name;
        if !past.starts_with("past") {
            continue;
        }
        let rest = past.strip_prefix("past_key_values.").map(|r| `.${r}`).unwrap_or(past.substr_bytes(4, past.len()));
        let present = `present${rest}`;
        if outputs.contains(&present) {
            pairs.push([past, present]);
        }
    }
    return pairs;
}

/// What each boundary tensor is held in, and where an element type no kernel
/// reaches stops the build. A node's own output is held as it is computed.
fn boundary_elements(graph: &Graph) -> Result<HashMap<String, String>, EmitError> {
    let mut held = HashMap::<String, String>::new();
    for let declared of [&graph.inputs, &graph.initializers, &graph.outputs] {
        for let vi of *declared {
            let Some(element) = element_of(&vi.dtype) else {
                builtin::cold_path();
                return Result::Err(EmitError::Dtype(UnmappedDtype {
                    tensor: vi.name,
                    dtype: vi.dtype,
                }));
            };
            held[vi.name] = element.primitive;
        }
    }
    return Result::Ok(held);
}

/// Every name `Names` mints an identifier for beside the axes: the inputs, the
/// weights, the tensors each scope computes and spells, and each symbol and
/// capacity `build` and `compute` bind.
fn named_tensors(graph: &Graph, checked: &Checked, literals: &List<String>, carriers: &List<Carrier>) -> List<String> {
    let mut tensors: List<String> = [];
    for let declared of [&graph.inputs, &graph.initializers] {
        for let vi of *declared {
            tensors.push(vi.name);
        }
    }
    scope_tensors(&mut tensors, graph, checked, literals);
    for let c of carriers {
        tensors.push(symbol_key(&c.solved.symbol));
        tensors.push(capacity_key(&c.solved.symbol));
    }
    // Every symbol of an input's axes, of which `Cache::empty` takes the
    // ones a past leaves open.
    for let vi of &graph.inputs {
        for let axis of checked.shapes[vi.name].axes {
            for let symbol of axis.extent.poly().symbols() {
                tensors.push(symbol_key(&symbol));
            }
        }
    }
    return tensors;
}

/// The tensors one scope computes and spells, then each branch's. A tensor
/// two branches both name is one identifier, bound in each branch's block.
fn scope_tensors(tensors: &mut List<String>, graph: &Graph, checked: &Checked, literals: &List<String>) {
    for let node of &graph.nodes {
        for let output of node.outputs {
            if !checked.known.contains_key(output) {
                tensors.push(output);
            }
        }
    }
    tensors.extend(literals);
    for let [branch_graph, branch] of branches_of(graph, checked) {
        scope_tensors(tensors, &branch_graph, &branch, &graph_literals(&branch_graph, &branch).spelled);
    }
}

/// The backend parameter declared with its kind and bound, as the graph
/// `build` adds its operations to: a backend may own device resources.
global GRAPH_BOUND: String = `affine ${BACKEND_PARAM}: Graph`;

/// The same parameter where code only holds tensors: `Cache` and `Passed`,
/// which a recording graph serves too.
global HOLDS_BOUND: String = `affine ${BACKEND_PARAM}: Holds`;

/// `Params` over the backend.
global PARAMS_TYPE: String = `${PARAMS}<${BACKEND_PARAM}>`;

/// The graph's initializers twice: `Weights` on the host as the graph holds
/// them, and `Params`, which `build` reads, each a tensor of the graph.
/// `Params` holds the `kept` literals too, which need no host copy.
fn emit_weights(
    w: &mut CodeWriter,
    graph: &Graph,
    checked: &Checked,
    names: &Names,
    held: &HashMap<String, String>,
    kept: &List<String>,
    placement: &Placement,
) {
    let mut weights = StructSpec::new("Weights", Vis::Pub);
    let mut params = StructSpec::new(PARAMS, Vis::Pub);
    params.add_generic(GRAPH_BOUND);
    for let vi of &graph.initializers {
        let ident = names.get(&vi.name);
        weights.add_pub_field(ident, tensor_type(checked, held, &vi.name));
        params.add_pub_field(ident, prepared_type(checked, &vi.name));
    }
    for let tensor of *kept {
        params.add_pub_field(names.get(&tensor), prepared_type(checked, &tensor));
    }
    w.blank();
    w.line("/// The graph's initializers, held on the host as the graph holds them.");
    weights.emit(w);
    w.blank();
    ImplSpec::new("Weights").emit_begin(w);
    let mut hosts = HashMap::<String, String>::new();
    for let vi of &graph.initializers {
        hosts[vi.name] = `self.${names.get(&vi.name)}`;
    }
    w.line("/// These weights as tensors of the graph `backend` builds.");
    FnSpec::new("params", Vis::Pub).add_generic(GRAPH_BOUND).set_receiver("&self").add_param(
        "backend",
        `&mut ${BACKEND_PARAM}`,
    ).set_return_type(PARAMS_TYPE).add_effect("_").emit_begin(w);
    emit_held_call(w, graph, checked, held, &hosts, false);
    w.end();
    w.end();
    w.blank();
    w.line("/// The graph's initializers as tensors of the graph `build` adds operations to.");
    params.emit(w);
    emit_constructor(w, graph, checked, held, placement);
    emit_embedded_data(w, graph);
}

/// A tensor as the backend holds it: in the primitive the graph computes in.
fn prepared_type(checked: &Checked, tensor: &String) -> String {
    let shape = checked.shapes.get(*tensor).unwrap();
    return `${BACKEND_PARAM}::Tensor<${checked.primitives.get(*tensor).unwrap()}, [${axis_list(&shape)}]>`;
}

/// The call making the host input `host`, a reference, the backend's: a
/// half-precision one is converted on the way.
fn uploaded(checked: &Checked, held: &HashMap<String, String>, tensor: &String, host: String) -> String {
    let verb = if converted(checked, held, tensor) { "prepare" } else { "upload" };
    return `backend.${verb}(${host})`;
}

/// Whether some initializer's data is left to a checkpoint.
fn loads_weights(graph: &Graph) -> bool {
    for let vi of &graph.initializers {
        if vi.data matches { None } {
            return true;
        }
    }
    return false;
}

/// `Params::embedded` where the graph carries every initializer's data, and
/// `Params::load` reading the rest from a safetensors checkpoint otherwise.
/// Each tensor is kept as it is read, so the host copy of one weight at a time
/// is all that lives beside the kept ones.
fn emit_constructor(
    w: &mut CodeWriter,
    graph: &Graph,
    checked: &Checked,
    held: &HashMap<String, String>,
    placement: &Placement,
) {
    let loads = loads_weights(graph);
    w.blank();
    let mut block = ImplSpec::new(PARAMS_TYPE);
    block.add_generic(GRAPH_BOUND);
    block.emit_begin(w);
    if loads {
        // What `load` checks of its file before reading a weight out of it.
        let [doc, param, ty, first]: [String, String, String, Option<String>] = match *placement {
            File => [
                "a safetensors checkpoint",
                "checkpoint",
                `&${CHECKPOINT_PARAM}`,
                Option::Some("let header = read_checkpoint(checkpoint)?;"),
            ],
            Shards(_) => [
                "the shards of a safetensors checkpoint, by the file name its index gives each",
                "shards",
                `&${MAP}<String, ByteList>`,
                Option::Some("let header = read_shards(shards)?;"),
            ],
            InPlace(in_place) => [
                `${in_place.file} where the build found them`,
                "checkpoint",
                `&${CHECKPOINT_PARAM}`,
                in_place.len.map(|len: i32| `expect_len(checkpoint, ${len})?;`),
            ],
        };
        w.line(`/// The weights, those the graph does not carry read from ${doc}.`);
        let mut load = FnSpec::new("load", Vis::Pub);
        if !placement matches { Shards(_) } {
            load.add_generic(`affine ${CHECKPOINT_PARAM}: CheckpointBytes`);
        }
        load.add_param("backend", `&mut ${BACKEND_PARAM}`).add_param(param, ty).set_return_type(
            `Result<${PARAMS_TYPE}, LoadError>`,
        ).add_effect("_").emit_begin(w);
        if let Some(line) = first {
            w.line(line);
        }
    } else {
        w.line("/// The weights the graph carries.");
        FnSpec::new("embedded", Vis::Pub).add_param("backend", `&mut ${BACKEND_PARAM}`).set_return_type(
            PARAMS_TYPE,
        ).add_effect("_").emit_begin(w);
    }
    let mut hosts = HashMap::<String, String>::new();
    for let [at, vi] of graph.initializers.into_iter().enumerate() {
        let primitive = held.get(vi.name).unwrap();
        let shape = checked.shapes.get(vi.name).unwrap();
        let e = expected(&vi, &shape);
        let data = match vi.data {
            Some(_) => `List::<${primitive}>::from_le_bytes(${EMBEDDED_DATA}(${at}))`,
            None => checkpoint_payload(&e, &primitive, placement),
        };
        hosts[vi.name] = `Tensor::<${primitive}, [${axis_list(&shape)}]> { data: ${data}, extents: ${e.extents} }`;
    }
    emit_held_call(w, graph, checked, held, &hosts, loads);
    w.end();
    w.end();
}

/// A `return` of `Params::held` over the initializers' host tensors in
/// `hosts`, each by its place among them: the `Result` where `fallible`, as a
/// `load` returns one, and the unwrapped struct otherwise.
fn emit_held_call(
    w: &mut CodeWriter,
    graph: &Graph,
    checked: &Checked,
    held: &HashMap<String, String>,
    hosts: &HashMap<String, String>,
    fallible: bool,
) {
    let error = if fallible { "LoadError" } else { "!" };
    w.begin(`return ${PARAMS}::held::<${error}>(backend, |at| Result::Ok(match at`);
    for let [at, vi] of graph.initializers.into_iter().enumerate() {
        let host = hosts[vi.name];
        let widened = if converted(checked, held, &vi.name) { `widen(&${host})` } else { host };
        w.line(`${at} => ${checked.primitives[vi.name]}_host(${widened}),`);
    }
    w.line("_ => unreachable(),");
    w.end_with(if fallible { "));" } else { ")).unwrap();" });
}

/// The function holding the bytes of each weight the graph carries, by its
/// position among the initializers.
global EMBEDDED_DATA: String = "embedded_data";

fn emit_embedded_data(w: &mut CodeWriter, graph: &Graph) {
    let mut arms: List<String> = [];
    for let [at, vi] of graph.initializers.into_iter().enumerate() {
        if let Some(bytes) = vi.data {
            arms.push(`${at} => ${byte_string_literal(&bytes)},`);
        }
    }
    if arms.is_empty() {
        return;
    }
    w.blank();
    w.line("/// The bytes of the weight at each position among the initializers the graph carries.");
    w.begin(`fn ${EMBEDDED_DATA}(at: i32) -> ByteList`);
    w.begin("return match at");
    for let arm of arms {
        w.line(arm);
    }
    w.line("_ => unreachable(),");
    w.end_with(";");
    w.end();
}

/// The call reading a tensor's `primitive` elements out of the checkpoint
/// `load` was given, checked against what the build compiled it as.
fn checkpoint_payload(e: &Expected, primitive: &String, placement: &Placement) -> String {
    let axes: List<String> = e.axes.into_iter().map(|axis| wado`"${axis}"`).collect();
    let [types, within] = match *placement {
        File => [`${*primitive}, ${CHECKPOINT_PARAM}`, "checkpoint"],
        Shards(placed) => [*primitive, wado`shards, "${placed[e.tensor]}"`],
        InPlace(in_place) => {
            let [start, end] = in_place.ranges[e.tensor];
            return wado`payload_at::<${*primitive}, ${CHECKPOINT_PARAM}>(checkpoint, "${e.tensor}", ${start}, ${end})?`;
        },
    };
    return wado`header.payload::<${types}>(${within}, &Expected { tensor: "${e.tensor}", dtype: "${e.dtype}", axes: [${axes.join(
        ", ",
    )}], extents: ${e.extents}, elements: ${e.elements}, width: ${e.width} })?`;
}

/// The pass built as a graph, each node as the operations of `Graph` that
/// compute it, `Lengths`, and `Chosen`, a field for each of `conditions`.
/// Returns the padded symbols it reads the value of, which `Lengths` holds.
fn emit_build(
    w: &mut CodeWriter,
    graph: &Graph,
    checked: &Checked,
    names: &Names,
    literals: &Literals,
    kept: &List<String>,
    symbols: Symbols,
    crossing: &Crossing,
    conditions: &List<String>,
) -> Result<List<String>, EmitError> {
    let spelled = symbols;
    let axes = if symbols.per_row() { "[Slots]" } else { "[]" };
    w.line("/// The graph's pass, each operation added to the graph `backend` builds,");
    w.line("/// over inputs it holds.");
    let read = emit_entry(w, graph, checked, names, literals, kept, symbols, crossing)?;
    if !read.is_empty() {
        let mut lengths = StructSpec::new(LENGTHS, Vis::Pub);
        lengths.add_generic(HOLDS_BOUND);
        for let symbol of read {
            lengths.add_pub_field(spelled.ident(&symbol), `${BACKEND_PARAM}::Tensor<i64, ${axes}>`);
        }
        w.blank();
        w.line("/// The valid length of each length the inputs pad to a capacity, their");
        w.line("/// extent, where `build` reads it.");
        if axes != "[]" {
            w.line("/// Each holds one length per row, or one every row shares.");
        }
        lengths.emit(w);
    }
    if !conditions.is_empty() {
        let mut chosen = StructSpec::new(CHOSEN, Vis::Pub);
        for let c of *conditions {
            chosen.add_pub_field(names.get(&c), "Option<bool>");
        }
        w.blank();
        w.line("/// The branch each `If` on an input takes, which the host read off it; or");
        w.line("/// none, where `build` adds both at lengths each branch holds at.");
        chosen.emit(w);
    }
    return Result::Ok(read);
}

/// `compute`: [`build`] over inputs on the host. It checks them against the
/// graph, pads each padded length to its capacity, builds, and reads the
/// outputs back cut to their lengths. `symbols` reads the lengths off the
/// inputs on the host, and `read` lists those `build` reads as values.
fn emit_compute(
    w: &mut CodeWriter,
    context: &EntryContext,
    given: Symbols,
    decoding: &Option<DecodingAxes>,
) -> Result<(), EmitError> {
    let EntryContext { graph, checked, names, held, carriers, padded, kept, crossing, owed, per_row, .. } = *context;
    let shapes = &checked.shapes;
    let returned = crossing.returned;
    let has_cache = crossing.has_cache();
    let mut compute = FnSpec::new("compute", Vis::Pub);
    let mut room: Option<Room> = null;
    if let Some(axes) = decoding {
        room = Option::Some(Room { symbol: axes.total, spelled: "room as i64" });
    }
    let entry = prepared_entry(context, &mut compute, given, &room)?;
    if room matches { Some(_) } {
        compute.add_param("room", "i32");
    }
    let Entry { lines: mut lines, symbols: mut symbols, arguments: mut arguments, taken_args, first_weight, class, chosen, cache_fits } = entry;
    // `build` and `recorded` take the branches where they take the lengths.
    let [record, least] = if chosen.is_empty() {
        [RECORDED, `${RECORDED}(recorder, &${LEAST_EXTENTS}())`];
    } else {
        arguments.push("&chosen");
        let unchosen: List<String> = chosen.into_iter().map(|c| `${c}: null`).collect();
        [
            `|recorder, extents| ${RECORDED}(recorder, extents, &chosen)`,
            `${RECORDED}(recorder, &${LEAST_EXTENTS}(), &${CHOSEN} { ${unchosen.join(", ")} })`,
        ];
    };
    arguments.push("&model.weights");
    let erased = erased_arguments(&taken_args, first_weight);
    let results = if crossing.several() {
        let mut fields: List<String> = [];
        for let [at, output] of returned.into_iter().enumerate() {
            fields.push(`${names.get(&output)}: ${typed_result(checked, &output, at)}`);
        }
        if has_cache {
            fields.push(`cache: ${cache_from_results(returned.len())}`);
        }
        `${PASSED} { ${fields.join(", ")} }`;
    } else {
        typed_result(checked, &returned[0], 0);
    };
    // Bound by a pattern, the run reads the `cache` the pattern shadows.
    let mut bind_run = |pattern: String| {
        lines.push(
            `let ${pattern} = match model.programs.run(backend, [${class.join(", ")}], ${record}, || [${erased.join(
                ", ",
            )}], || ${ERASED_WEIGHTS}) {`,
        );
        lines.push(`    Some(results) => ${results},`);
        lines.push(`    None => build(${arguments.join(", ")}),`);
        lines.push("};");
    };
    let mut read_back = |tensor: &String, place: String| -> Result<String, EmitError> {
        let mut downloaded = `backend.download(&${place})`;
        if converted(checked, held, tensor) {
            downloaded = `narrow(&${downloaded})`;
        }
        let shape = shapes[*tensor];
        let cut = shape.axes.into_iter().any(|a| a.extent.poly().symbols().into_iter().any(|s| padded.contains(&s)));
        return Result::Ok(if cut { `resized(&${downloaded}, ${symbols.spell_shape(&shape)?})` } else { downloaded });
    };
    let returned_type = if crossing.several() {
        let mut idents: List<String> = [];
        let mut fields: List<String> = [];
        for let output of returned {
            let ident = names.get(&output);
            idents.push(ident);
            fields.push(`${ident}: ${read_back(&output, ident)?}`);
        }
        if has_cache {
            idents.push("cache");
            fields.push(`cache: fitted_fields(backend, &cache, ${cache_fits})`);
        }
        bind_run(`${PASSED} { ${idents.join(", ")} }`);
        lines.push(`return ${OUTPUTS} { ${fields.join(", ")} };`);
        if has_cache {
            `${OUTPUTS}<${BACKEND_PARAM}>`;
        } else {
            OUTPUTS;
        }
    } else {
        bind_run("passed");
        lines.push(`return ${read_back(&returned[0], "passed")?};`);
        tensor_type(checked, held, &returned[0]);
    };
    compute.add_param("model", `&mut ${MODEL}<${BACKEND_PARAM}>`).set_return_type(returned_type).add_effect("_");
    emit_model(w);
    w.blank();
    w.line("/// [`build`] over inputs on the host, each length padded to a capacity, its");
    w.line("/// outputs read back cut to their lengths. A backend that compiles its");
    w.line("/// pass runs the program it compiled for the capacities.");
    if decoding matches { Some(_) } {
        w.line("/// The cache holds `room` positions past these, for the steps to come.");
    }
    compute.emit_begin(w);
    if decoding matches { Some(_) } {
        w.line(`refuse(unmet(room as i64, "room must not be negative"));`);
    }
    for let line of entry_lines(context, &symbols, &lines) {
        w.line(&line);
    }
    w.end();
    emit_recorded(w, names, &taken_args, first_weight, &returned, crossing, !chosen.is_empty(), false);
    emit_least_extents(w, checked, carriers, names, owed, padded, &taken_args, per_row)?;
    emit_held(w, graph, checked, kept, first_weight, least);
    return Result::Ok(());
}

/// A length a call asks a capacity to hold more of: `symbol`, and every past
/// that grows, read as `spelled` more.
struct Room {
    symbol: String,
    spelled: String,
}

/// What `compute` and `decode` each read of the graph.
struct EntryContext {
    graph: &Graph,
    checked: &Checked,
    names: &Names,
    held: &HashMap<String, String>,
    carriers: &List<Carrier>,
    padded: &List<String>,
    read: &List<String>,
    kept: &List<String>,
    crossing: &Crossing,
    owed: &List<[Grown, Option<Poly>]>,
    conditions: &List<String>,
    /// Whether each row holds lengths of its own, each a value of `[Slots]`.
    per_row: bool,
}

/// What an entry has made by the time it can run its program: its `lines`, the
/// lengths, what `build` is passed, what the program takes, its weights from
/// `first_weight` on, what tells its programs apart, the fields of `chosen`,
/// and what `fitted_fields` fits the cache to the capacities by.
struct Entry {
    lines: List<String>,
    symbols: Symbols,
    arguments: List<String>,
    taken_args: List<ProgramArgument>,
    first_weight: i32,
    class: List<String>,
    chosen: List<String>,
    cache_fits: String,
}

/// The lengths of an entry whose rows each decode at a past of their own: the
/// total the host spells at the past `past`, which every row shares.
struct Apart {
    total: String,
    past: String,
}

/// The entry `spec`, its inputs and the cache given, up to the program it runs.
/// Where `apart` is given, each row's lengths are its own, moved from the
/// host's to the row's past in `pasts`.
fn prepared_entry(
    context: &EntryContext,
    spec: &mut FnSpec,
    mut symbols: Symbols,
    room: &Option<Room>,
    apart: Option<Apart> = null,
) -> Result<Entry, EmitError> {
    let EntryContext { graph, checked, names, held, carriers, padded, read, kept, crossing, owed, conditions, per_row } = *context;
    let shapes = &checked.shapes;
    let has_cache = crossing.has_cache();
    // The cache holds a past at a capacity, so its length is what the graph
    // owes it to be, given the other inputs'.
    symbols.derive_owed(owed);
    spec.add_generic(GRAPH_BOUND).add_param("backend", `&mut ${BACKEND_PARAM}`);
    let mut lines: List<String> = [];
    let taken: List<ValueInfo> = graph.inputs.into_iter().filter(|vi| !crossing.cached.contains(vi.name)).collect();
    // Every symbolic axis is its symbols' arithmetic over the lengths, but for
    // the axis a symbol is read from as itself. One spelling arithmetic over it
    // may hold no length the arithmetic gives.
    for let vi of &taken {
        let ident = names.get(&vi.name);
        spec.add_param(ident, `&${tensor_type(checked, held, &vi.name)}`);
        for let [i, axis] of shapes[vi.name].axes.into_iter().enumerate() {
            let Symbolic(length) = axis.extent else {
                continue;
            };
            let carries = carriers.into_iter().any(|c| c.input == vi.name && c.axis == i);
            if carries && axis.extent.lone_symbol() matches { Some(_) } {
                continue;
            }
            lines.push(
                wado`refuse(extent_mismatch("${vi.name}", "${axis.name}", ${ident}.extents[${i}], "${length}", ${symbols.spell(
                    &length,
                )?}));`,
            );
        }
    }
    if has_cache {
        spec.add_param("cache", `&${CACHE}<${BACKEND_PARAM}>`);
    }
    // A step past what the graph owes reads past a table, and answers anyway.
    let mut at_end: Option<Symbols> = null;
    if let Some(r) = room {
        let mut end = symbols;
        let mut moving: List<String> = [r.symbol];
        moving.extend(&owed.into_iter().map(|o| o.0.symbol).collect());
        for let symbol of moving {
            if moves_a_step(&symbol, &r.symbol, owed)? {
                end.spell_as(&symbol, `(${symbols.ident(&symbol)} + ${r.spelled})`);
            }
        }
        at_end = Option::Some(end);
    }
    lines.extend(&checks_at(checked, &mut symbols, &mut at_end)?);
    lines.extend(&branch_checks(graph, checked, names, conditions, &mut symbols, &mut at_end)?);
    if let Some(end) = &at_end {
        symbols.use_what(end);
    }
    // Each `If` on an input takes its branch on the host, so the program holds
    // the one branch, at lengths it holds at.
    let chosen: List<String> = conditions.into_iter().map(|c| names.get(c)).collect();
    if !chosen.is_empty() {
        let fields: List<String> = chosen.into_iter().map(|c| `${c}: Option::Some(${c}.data[0])`).collect();
        lines.push(`let chosen = ${CHOSEN} { ${fields.join(", ")} };`);
    }
    let mut nonnegative = HashSet::<String>::new();
    for let [g, _] of *owed {
        let past = symbols.spell(&Poly::symbol(&g.symbol))?;
        let held_extent = `backend.extents_of(&cache.${names.get(&g.past)})[${g.axis}] as i64`;
        if nonnegative.insert(g.symbol) {
            lines.push(wado`refuse(unmet(${past}, "${g.symbol} must not be negative"));`);
        }
        lines.push(wado`refuse(unmet(${held_extent} - ${past}, "${g.past} holds fewer positions than ${g.symbol}"));`);
    }
    let mut capacities = at_capacities(&mut symbols, &mut lines, padded, owed, names, room)?;
    // The cache was computed before the pass this call begins.
    if has_cache {
        lines.push("retain_fields(backend, cache);");
    }
    lines.push("backend.begin();");
    let mut arguments: List<String> = ["backend"];
    for let vi of &taken {
        let ident = names.get(&vi.name);
        let padded_to = `&resized(${ident}, ${capacities.spell_shape(&shapes[vi.name])?})`;
        lines.push(`let ${ident} = ${uploaded(checked, held, &vi.name, padded_to)};`);
        arguments.push(`&${ident}`);
    }
    // The cache at the capacities, both as the pass takes it and as it returns it.
    let cache_fits = fits_at_capacities(crossing, owed, padded, &mut capacities)?;
    if has_cache {
        lines.push(`let cache = fitted_fields(backend, cache, ${cache_fits});`);
        arguments.push("&cache");
    }
    // A capacity reads its length, and an unpadded symbol is its own capacity.
    symbols.use_what(&capacities);
    // What the program takes, in the order `recorded` makes its parameters:
    // the inputs and the cache, whose extents are the shape class, then the
    // lengths and the weights.
    let mut taken_args: List<ProgramArgument> = [];
    for let vi of &taken {
        taken_args.push(ProgramArgument::of(checked, names, &vi.name, Crossed::Input));
    }
    for let [past, _] of crossing.pairs {
        taken_args.push(ProgramArgument::of(checked, names, &past, Crossed::Cache));
    }
    let mut class: List<String> = taken_args.into_iter().map(|a| `backend.extents_of(&${a.held()})`).collect();
    // The branches the host took tell the programs apart too.
    for let c of chosen {
        class.push(`[chosen.${c}.unwrap() as i32]`);
    }
    if !read.is_empty() {
        // The host's one length, which every row shares, or each row's own.
        let [axes, extents] = if apart matches { Some(_) } {
            ["[Slots]", "[pasts.len()]"];
        } else if per_row {
            ["[Slots]", "[1]"];
        } else {
            ["[]", "[]"];
        };
        let mut fields: List<String> = [];
        for let symbol of *read {
            let ident = symbols.ident(&symbol);
            let host = symbols.spell(&Poly::symbol(&symbol))?;
            let data = match &apart {
                None => `[${host}]`,
                Some(a) => if moves_a_step(&symbol, &a.total, owed)? {
                    at_each_past(host, symbols.spell(&Poly::symbol(&a.past))?);
                } else {
                    `List::<i64>::filled(pasts.len(), ${host})`;
                },
            };
            fields.push(`${ident}: backend.upload(&Tensor::<i64, ${axes}> { data: ${data}, extents: ${extents} })`);
            taken_args.push(ProgramArgument {
                crossed: Crossed::Length,
                tensor: symbol,
                ident,
                element: "i64",
                axes,
            });
        }
        lines.push(`let lengths = ${LENGTHS}::<${BACKEND_PARAM}> { ${fields.join(", ")} };`);
        arguments.push("&lengths");
        // A program holds as many rows of lengths as it was recorded with.
        class.push(`backend.extents_of(&lengths.${symbols.ident(&read[0])})`);
    }
    let first_weight = taken_args.len();
    for let weight of weight_names(graph, kept) {
        taken_args.push(ProgramArgument::of(checked, names, &weight, Crossed::Weight));
    }
    return Result::Ok(Entry {
        lines,
        symbols,
        arguments,
        taken_args,
        first_weight,
        class,
        chosen,
        cache_fits,
    });
}

/// An entry's body: the checks first, as a binding reads an extent they check
/// is there.
fn entry_lines(context: &EntryContext, symbols: &Symbols, lines: &List<String>) -> List<String> {
    let mut all = input_checks(context.graph, &context.checked.shapes, context.names, &context.crossing.cached).host;
    all.extend(&symbols.bindings());
    all.extend(lines);
    return all;
}

/// The input a decoding program feeds its picks to and the input it opens a
/// position of, the output it picks from, and the length a step adds 1 to.
struct DecodingAxes {
    ids: String,
    mask: String,
    logits: String,
    total: String,
}

/// What `decode` names, once the graph is known to loop: a step must feed
/// nothing but its token and its mask to the next, and the cache must keep its
/// extents through a step.
fn decoding_axes(
    decode: &Decode,
    graph: &Graph,
    checked: &Checked,
    crossing: &Crossing,
    padded: &List<String>,
    owed: &List<[Grown, Option<Poly>]>,
    conditions: &List<String>,
) -> Result<DecodingAxes, EmitError> {
    let refused = |why: String| Result::<DecodingAxes, EmitError>::Err(EmitError::Undecodable(why));
    if !crossing.has_cache() {
        return refused("the graph holds no cache to carry its positions from one step to the next");
    }
    if decode.ids == decode.mask {
        return refused(`${decode.ids} cannot be both the token and the mask`);
    }
    for let vi of &graph.inputs {
        if crossing.cached.contains(vi.name)
            || vi.name == decode.ids
            || vi.name == decode.mask
            || conditions.contains(&vi.name) {
            continue;
        }
        return refused(`${vi.name} is an input no step knows how to advance`);
    }
    for let name of [decode.ids, decode.mask] {
        if !graph.inputs.into_iter().any(|vi| vi.name == name) || crossing.cached.contains(name) {
            return refused(`${name} is no input outside the cache`);
        }
        if checked.primitives[name] != "i64" || checked.shapes[name].rank() != 2 {
            return refused(`${name} must be an i64 tensor of rows and positions`);
        }
    }
    if !crossing.returned.contains(&decode.logits) || checked.primitives[decode.logits] != "f32" {
        return refused(`${decode.logits} is no f32 output a pass returns`);
    }
    let logits = checked.shapes[decode.logits].axes;
    if logits.len() < 2 || logits.into_iter().skip(1).take(logits.len() - 2).any(|a| !a.extent matches { Static(1) }) {
        return refused(`${decode.logits} must hold one position a row: name it in \`last\``);
    }
    let [ids, mask] = [checked.shapes[decode.ids].axes, checked.shapes[decode.mask].axes];
    if ids[1].extent matches { Static(n) && n != 1 } {
        return refused(`${decode.ids} must take one token a row`);
    }
    if !mask[0].extent.agrees(&ids[0].extent) || !logits[0].extent.agrees(&ids[0].extent) {
        return refused(`${decode.mask} and ${decode.logits} must hold as many rows as ${decode.ids}`);
    }
    let Some(total) = mask[1].extent.lone_symbol() else {
        return refused(`${decode.mask} must be one length long`);
    };
    if !padded.contains(&total) {
        return refused(`${total} must be a length held at a capacity`);
    }
    for let [g, _] of *owed {
        if !padded.contains(&g.symbol) {
            return refused(`${g.past} must be a buffer the pass writes in place, as ${g.symbol} grows`);
        }
    }
    for let [past, present] of crossing.pairs {
        let held = checked.shapes[present].axes;
        for let [i, axis] of checked.shapes[past].axes.into_iter().enumerate() {
            let grows = owed.into_iter().any(|o| o.0.past == past && o.0.axis == i);
            if !grows && !axis.extent.agrees(&held[i].extent) {
                return refused(`${past} must keep its extents through a step, as ${present} does not`);
            }
        }
    }
    return Result::Ok(DecodingAxes { ids: decode.ids, mask: decode.mask, logits: decode.logits, total });
}

/// `decode`: [`DECODED`] over inputs on the host, its tokens read back. A
/// backend that compiles its pass runs the program `RECORDED_DECODED` records.
/// `rows_past`, the length every row's past is, makes it `DECODE_ROWS`, each row
/// at a past of its own, which the mask's extent holds with its steps, so no
/// room moves the cache.
fn emit_decode(
    w: &mut CodeWriter,
    context: &EntryContext,
    given: Symbols,
    axes: &DecodingAxes,
    rows_past: Option<String>,
) -> Result<(), EmitError> {
    let EntryContext { checked, names, crossing, padded, .. } = *context;
    let apart = rows_past matches { Some(_) };
    let mut decode = FnSpec::new(if apart { DECODE_ROWS } else { DECODE }, Vis::Pub);
    let room = if apart { null } else { Option::Some(Room { symbol: axes.total, spelled: "(steps - 1) as i64" }) };
    let entry = prepared_entry(context, &mut decode, given, &room, rows_past.map(|past| Apart {
        total: axes.total,
        past,
    }))?;
    if apart {
        decode.add_param("pasts", "&List<i64>");
    }
    decode.add_param("steps", "i32").add_param("sampling", "&Sampling");
    let mut symbols = entry.symbols;
    let mut lines = entry.lines;
    let ids = names.get(&axes.ids);
    let chooses = !entry.chosen.is_empty();
    let total = symbols.spell(&Poly::symbol(&axes.total))?;
    let mut apart_checks: List<String> = [];
    let at = if let Some(rows_past) = &rows_past {
        let past = symbols.spell(&Poly::symbol(rows_past))?;
        apart_checks = [
            `assert pasts.len() == rows, "decode_rows takes a past for each row";`, "for let past of pasts {",
            `    refuse(unmet(*past, "a row's past must not be negative"));`,
            `    refuse(unmet(${total} - *past - steps as i64, "a row's past and its steps must fit the mask"));`, "}",
            "let mut pasts = *pasts;", "while pasts.len() < ended.len() {", "    pasts.push(0);", "}",
        ];
        at_each_past(total, past);
    } else {
        `[${total}]`;
    };
    lines.push(`let decoding = Decoding::new(backend, sampling, ended, steps, ${at});`);
    lines.push("let sampler = sampling.sampler();");
    let mut arguments = entry.arguments;
    if chooses {
        arguments.push("&chosen");
    }
    arguments.push("&model.weights");
    arguments.push("&decoding");
    let mut class = entry.class;
    class.push("sampler.key()");
    class.push("backend.extents_of(&decoding.tokens)");
    class.push("backend.extents_of(&decoding.position)");
    let taken = entry.taken_args;
    let erased = erased_arguments(&taken, entry.first_weight);
    let chosen_argument = if chooses { ", &chosen" } else { "" };
    lines.push(
        `let [tokens, cache]: [${BACKEND_PARAM}::Tensor<i64, [Slots, Picks]>, ${CACHE}<${BACKEND_PARAM}>] = match model.programs.run(backend, [${class.join(
            ", ",
        )}], |recorder, extents| ${RECORDED_DECODED}(recorder, extents, &sampler${chosen_argument}), || {`,
    );
    lines.push(`    let mut all: List<Any<${BACKEND_PARAM}>> = [${erased.join(", ")}];`);
    lines.push("    all.extend(&decoding.erased(backend));");
    lines.push("    return all;");
    lines.push(`}, || ${ERASED_WEIGHTS}) {`);
    lines.push(
        `    Some(results) => [i64_of::<${BACKEND_PARAM}, [Slots, Picks]>(backend, &results[0]), ${cache_from_results(1)}],`,
    );
    lines.push(`    None => ${DECODED}(${arguments.join(", ")}),`);
    lines.push("};");
    lines.push(`return ${DECODED_TYPE} { tokens: resized(&backend.download(&tokens), [rows, steps]), cache };`);
    decode.add_param("model", `&mut ${MODEL}<${BACKEND_PARAM}>`).set_return_type(`${DECODED_TYPE}<${BACKEND_PARAM}>`).add_effect(
        "_",
    );

    if !apart {
        let mut decoded_type = StructSpec::new(DECODED_TYPE, Vis::Pub);
        decoded_type.add_generic(HOLDS_BOUND);
        decoded_type.add_pub_field("tokens", "Tensor<i64, [Slots, Picks]>");
        decoded_type.add_pub_field("cache", `${CACHE}<${BACKEND_PARAM}>`);
        w.blank();
        w.line("/// What `decode` picked, by row, and the cache, which holds each of them but the last.");
        decoded_type.emit(w);
    }
    w.blank();
    if apart {
        w.line("/// [`decode`] with each row at its own past, `pasts`, which its mask holds");
        w.line("/// open with its token, and the mask's extent holds with its steps.");
    } else {
        w.line("/// `steps` tokens after the one token each row of the input holds, all read");
        w.line("/// back once the last is picked. The mask holds the positions so far, that");
        w.line("/// token's among them, and the cache the ones before it.");
    }
    decode.emit_begin(w);
    let [rows_axis, ids_axis] = [checked.shapes[axes.ids].axes[0], checked.shapes[axes.ids].axes[1]];
    let mut body: List<String> = [
        `refuse(unmet(steps as i64 - 1, "decode takes at least one step"));`,
        wado`refuse(extent_mismatch("${axes.ids}", "${ids_axis.name}", ${ids}.extents[1], "1", 1));`,
        `let rows = ${ids}.extents[0];`, `let mut ended = sampling.ended(&${ids}.data);`,
    ];
    // A row the capacity adds has ended, and its past is empty.
    let held_rows = if rows_axis.extent.lone_symbol() matches { Some(r) && padded.contains(&r) } {
        "capacity_of(rows)";
    } else {
        "rows";
    };
    body.push(`while ended.len() < ${held_rows} {`);
    body.push("    ended.push(true);");
    body.push("}");
    body.extend(&apart_checks);
    body.extend(&lines);
    for let line of entry_lines(context, &symbols, &body) {
        w.line(&line);
    }
    w.end();
    // Both entries run one program, which `decode` emits.
    if !apart {
        emit_decoded(w, context, axes, &taken, chooses)?;
        emit_recorded(w, names, &taken, entry.first_weight, &[], crossing, chooses, true);
    }
    return Result::Ok(());
}

/// `host`, a length the host spells at the past `past`, moved to each row's
/// own past in the generated `pasts`.
fn at_each_past(host: String, past: String) -> String {
    return `pasts.into_iter().map(|past| ${host} + past - (${past})).collect()`;
}

/// `Requests`: the requests that decode side by side, one in each row of a
/// cache of fixed capacity, over `DECODE_ROWS`. `place` runs a request's prompt
/// alone through `compute` and writes its cache into its row; `decode` runs
/// every row's steps in one call. Nothing is emitted where a past does not
/// grow, or its extent has an open axis besides its rows and its length.
fn emit_requests(w: &mut CodeWriter, context: &EntryContext, axes: &DecodingAxes) {
    let EntryContext { graph, checked, names, crossing, owed, .. } = *context;
    let bk = BACKEND_PARAM;
    let mut empties: List<String> = [];
    let mut grown_axes: List<String> = [];
    for let [past, _] of crossing.pairs {
        let shape = checked.shapes[past];
        let Some([g, _]) = owed.into_iter().find(|o| o.0.past == past) else {
            return;
        };
        let grown = g.axis;
        let mut extents: List<String> = [];
        for let [i, axis] of shape.axes.into_iter().enumerate() {
            // The slots are the rows, the one length `Cache::empty` takes.
            let extent = if i == 0 {
                if axis.extent matches { Static(_) } {
                    return;
                }
                "slots";
            } else if i == grown {
                "capacity";
            } else if let Static(n) = axis.extent {
                `${n}`;
            } else {
                return;
            };
            extents.push(extent);
        }
        empties.push(`[${extents.join(", ")}]`);
        grown_axes.push(`${grown}`);
    }
    let taken: List<String> = graph.inputs.into_iter().map(|vi| vi.name).filter(|t| !crossing.cached.contains(t)).collect();
    let mut place_params: List<String> = [];
    let mut compute_args: List<String> = [];
    let mut decode_params: List<String> = [];
    let mut decode_args: List<String> = [];
    for let input of taken {
        let ident = names.get(&input);
        let typed = `${ident}: &${tensor_type(checked, context.held, &input)}`;
        place_params.push(typed);
        compute_args.push(ident);
        if input == axes.ids {
            decode_args.push("&ids");
        } else if input == axes.mask {
            decode_args.push("&mask");
        } else {
            decode_params.push(typed);
            decode_args.push(ident);
        }
    }
    let mask = names.get(&axes.mask);
    let logits = names.get(&axes.logits);
    let [ids_type, mask_type] = [
        `Tensor::<i64, [${axis_list(&checked.shapes[axes.ids])}]>`, `Tensor::<i64, [${axis_list(
            &checked.shapes[axes.mask],
        )}]>`,
    ];
    let mut requests = StructSpec::new(REQUESTS, Vis::Pub);
    requests.add_generic(HOLDS_BOUND);
    requests.add_pub_field("cache", `${CACHE}<${bk}>`);
    requests.add_pub_field("pasts", "List<i64>");
    requests.add_pub_field("tokens", "List<i64>");
    requests.add_pub_field("active", "List<bool>");
    requests.add_field("capacity", "i32");
    w.blank();
    w.line("/// The requests decoding side by side, one in each slot: a row of the cache,");
    w.line("/// each holding `capacity` positions. A slot holds its past, its last token,");
    w.line("/// and whether a request is in it. The cache is kept through these calls.");
    requests.emit(w);
    w.blank();
    let mut held = ImplSpec::new(`${REQUESTS}<${bk}>`);
    held.add_generic(GRAPH_BOUND);
    held.emit_begin(w);
    w.line("/// `slots` empty slots of `capacity` positions, each a capacity of its own.");
    w.line(`pub fn new(backend: &mut ${bk}, slots: i32, capacity: i32) -> ${REQUESTS}<${bk}> with _ {`);
    w.line(
        `    assert capacity_of(slots) == slots && capacity_of(capacity) == capacity, "a slot count and a capacity are each one capacity_of gives";`,
    );
    w.line(`    return ${REQUESTS} {`);
    w.line(`        cache: zeroed_fields(backend, &[${empties.join(", ")}]),`);
    w.line("        pasts: List::<i64>::filled(slots, 0),");
    w.line("        tokens: List::<i64>::filled(slots, 0),");
    w.line("        active: List::<bool>::filled(slots, false),");
    w.line("        capacity,");
    w.line("    };");
    w.line("}");
    w.blank();
    w.line("/// Runs a request's prompt alone through `compute` and puts it in `slot`:");
    w.line("/// its cache, its past, and the token `sampling` picks after it, which this");
    w.line("/// returns.");
    w.line(
        `pub fn place(&mut self, backend: &mut ${bk}, slot: i32, ${place_params.join(", ")}, sampling: &Sampling, model: &mut ${MODEL}<${bk}>) -> i64 with _ {`,
    );
    w.line(`    assert !self.active[slot], "a request is placed in an empty slot";`);
    w.line("    retain_fields(backend, &self.cache);");
    w.line(`    let passed = compute(backend, ${compute_args.join(", ")}, &${CACHE}::empty(backend, 1), 0, model);`);
    w.line(`    let past = ${mask}.extents[1] as i64;`);
    w.line(`    assert past < self.capacity as i64, "a prompt leaves its slot a position for its steps";`);
    w.line(`    let at = shared::<${bk}>(backend, &scalar::<${bk}, i64>(backend, slot as i64));`);
    w.line(`    self.cache = written_fields(backend, &self.cache, &passed.cache, &[${grown_axes.join(", ")}], &at);`);
    w.line(`    let token = sampling.first_tokens(&passed.${logits}, past)[0];`);
    w.line("    self.pasts[slot] = past;");
    w.line("    self.tokens[slot] = token;");
    w.line("    self.active[slot] = true;");
    w.line("    return token;");
    w.line("}");
    w.blank();
    w.line("/// Empties `slot`. Its row goes on running, and no one reads it.");
    w.line("pub fn release(&mut self, slot: i32) {");
    w.line("    self.pasts[slot] = 0;");
    w.line("    self.tokens[slot] = 0;");
    w.line("    self.active[slot] = false;");
    w.line("}");
    w.blank();
    w.line("/// `steps` tokens after each slot's last, by slot, every slot in one call.");
    w.line("/// An empty slot's are of no request.");
    let mut params = [`&mut self`, `backend: &mut ${bk}`] as List<String>;
    params.extend(&decode_params);
    w.line(
        `pub fn decode(${params.join(", ")}, steps: i32, sampling: &Sampling, model: &mut ${MODEL}<${bk}>) -> Tensor<i64, [Slots, Picks]> with _ {`,
    );
    w.line("    let slots = self.pasts.len();");
    w.line(`    let ids = ${ids_type} { data: self.tokens, extents: [slots, 1] };`);
    w.line("    let mut open: List<i64> = [];");
    w.line("    for let past of self.pasts {");
    w.line("        open.extend(&List::<i64>::filled(to_extent(past + 1), 1));");
    w.line("        open.extend(&List::<i64>::filled(self.capacity - to_extent(past + 1), 0));");
    w.line("    }");
    w.line(`    let mask = ${mask_type} { data: open, extents: [slots, self.capacity] };`);
    w.line(
        `    let decoded = ${DECODE_ROWS}(backend, ${decode_args.join(", ")}, &self.cache, &self.pasts, steps, sampling, model);`,
    );
    w.line("    self.cache = decoded.cache;");
    w.line("    for let slot of 0..<slots {");
    w.line("        if self.active[slot] {");
    w.line("            self.pasts[slot] += steps as i64;");
    w.line("            self.tokens[slot] = decoded.tokens.data[slot * steps + steps - 1];");
    w.line("        }");
    w.line("    }");
    w.line("    return decoded.tokens;");
    w.line("}");
    w.end();
}

/// `decoded`: [`build`] run a step at a time around the sampler, each step's
/// token the next's input, its mask one position longer, and the lengths moved
/// as that moves them.
fn emit_decoded(
    w: &mut CodeWriter,
    context: &EntryContext,
    axes: &DecodingAxes,
    taken: &List<ProgramArgument>,
    chooses: bool,
) -> Result<(), EmitError> {
    let EntryContext { checked, names, read, owed, per_row, .. } = *context;
    let bk = BACKEND_PARAM;
    let mut decoded = FnSpec::new(DECODED);
    decoded.add_generic(GRAPH_BOUND).add_param("backend", `&mut ${bk}`);
    // What a step changes, as the first of them takes it and the rest the step
    // before returned it.
    let mut start: List<String> = [];
    let mut carried: List<ProgramArgument> = [];
    let mut build_arguments: List<String> = ["backend"];
    // Where the cache starts among what a step carries: past the inputs it carries.
    let mut first_cached = 0;
    for let a of *taken {
        if a.crossed matches { Input } {
            decoded.add_param(a.ident, `&${bk}::Tensor<${a.element}, ${a.axes}>`);
            if a.tensor != axes.ids && a.tensor != axes.mask {
                build_arguments.push(a.ident);
                continue;
            }
            start.push(a.erased_from(a.ident));
        } else if a.crossed matches { Cache } {
            start.push(a.erased_from(`&cache.${a.ident}`));
        } else {
            continue;
        }
        if a.crossed matches { Input } {
            build_arguments.push(`&${a.taken_from("state", carried.len())}`);
            first_cached += 1;
        }
        carried.push(a);
    }
    decoded.add_param("cache", `&${CACHE}<${bk}>`);
    build_arguments.push("&held");
    if !read.is_empty() {
        decoded.add_param("lengths", `&${LENGTHS}<${bk}>`);
        build_arguments.push("&moved");
    }
    if chooses {
        decoded.add_param("chosen", `&${CHOSEN}`);
        build_arguments.push("chosen");
    }
    decoded.add_param("weights", `&${PARAMS_TYPE}`);
    build_arguments.push("weights");
    decoded.add_param("decoding", `&Decoding<${bk}>`);
    decoded.set_return_type(`[${bk}::Tensor<i64, [Slots, Picks]>, ${CACHE}<${bk}>]`).add_effect("_");
    w.blank();
    w.line("/// [`build`] a step at a time, each step's token the next's input: the tokens");
    w.line("/// picked, by row, and the cache after the last step.");
    decoded.emit_begin(w);
    let count = carried.len();
    w.line(`let mut start: List<Any<${bk}>> = [${start.join(", ")}];`);
    w.line("start.extend(&decoding.carried(backend));");
    w.line("let last = backend.repeated(&decoding.steps, &start, |step, state| {");
    w.line(`    let held: ${CACHE}<${bk}> = restored_fields(backend, state, ${first_cached});`);
    if !read.is_empty() {
        let mut fields: List<String> = [];
        for let symbol of *read {
            let ident = names.get(&symbol_key(&symbol));
            fields.push(
                if moves_a_step(&symbol, &axes.total, owed)? {
                    if per_row {
                        `${ident}: row_binary::<${bk}>(backend, Binary::Add, &lengths.${ident}, &shared::<${bk}>(backend, step))`;
                    } else {
                        `${ident}: backend.binary::<i64, []>(Binary::Add, &lengths.${ident}, step)`;
                    }
                } else {
                    `${ident}: lengths.${ident}`;
                },
            );
        }
        w.line(`    let moved = ${LENGTHS}::<${bk}> { ${fields.join(", ")} };`);
    }
    w.line(`    let passed = build(${build_arguments.join(", ")});`);
    let logits = `passed.${names.get(&axes.logits)}`;
    w.line(`    let tokens = i64_of::<${bk}, [Slots, Picks]>(backend, &state[${count}]);`);
    w.line(`    let finished = bool_of::<${bk}, [Slots]>(backend, &state[${count + 1}]);`);
    let logits_axes = axis_list(&checked.shapes[axes.logits]);
    w.line(
        `    let next = stepped::<${bk}, [${logits_axes}]>(backend, &${logits}, decoding, &tokens, &finished, step);`,
    );
    w.line(
        `    let at = row_binary::<${bk}>(backend, Binary::Add, &decoding.position, &shared::<${bk}>(backend, step));`,
    );
    let mut returned: List<String> = [];
    for let [k, a] of carried.into_iter().enumerate() {
        returned.push(if a.tensor == axes.ids {
            "Any::I64(backend.relabeled::<i64, [Slots, One], Untyped>(&next.token))";
        } else if a.tensor == axes.mask {
            a.erased_from(`&opened::<${bk}, ${a.axes}>(backend, &${a.taken_from("state", k)}, &at)`);
        } else {
            a.erased_from(`&passed.cache.${a.ident}`);
        });
    }
    w.line(`    let mut returned: List<Any<${bk}>> = [${returned.join(", ")}];`);
    w.line("    returned.extend(&next.carried(backend));");
    w.line("    return returned;");
    w.line("});");
    w.line(
        `return [i64_of::<${bk}, [Slots, Picks]>(backend, &last[${count}]), restored_fields(backend, &last, ${first_cached})];`,
    );
    w.end();
    return Result::Ok(());
}

/// Whether `symbol` moves in a step, by 1 as `total` does. One that no past's
/// arithmetic ties to `total` is an input's other than the mask's, which no
/// step changes.
fn moves_a_step(symbol: &String, total: &String, owed: &List<[Grown, Option<Poly>]>) -> Result<bool, EmitError> {
    if symbol == total {
        return Result::Ok(true);
    }
    let Some([_, Some(v)]) = owed.into_iter().find(|o| o.0.symbol == *symbol) else {
        return Result::Ok(false);
    };
    if !v.symbols().contains(total) {
        return Result::Ok(false);
    }
    if !v.linear_in(total) matches { Some([1, _]) } {
        builtin::cold_path();
        return Result::Err(EmitError::Undecodable(`${*symbol} must move one position a step`));
    }
    return Result::Ok(true);
}

/// `least_extents`: the extents `recorded` takes where each length an input
/// carries is 1, as `compute` pads them to their capacities.
fn emit_least_extents(
    w: &mut CodeWriter,
    checked: &Checked,
    carriers: &List<Carrier>,
    names: &Names,
    owed: &List<[Grown, Option<Poly>]>,
    padded: &List<String>,
    taken: &List<ProgramArgument>,
    per_row: bool,
) -> Result<(), EmitError> {
    let mut symbols = Symbols::at_one(carriers, names);
    symbols.derive_owed(owed);
    let mut lines: List<String> = [];
    let mut capacities = at_capacities(&mut symbols, &mut lines, padded, owed, names, &null)?;
    let mut extents: List<String> = [];
    for let a of *taken {
        extents.push(if a.crossed matches { Length } {
            // One length every row shares, where each row holds its own.
            if per_row {
                "[1]";
            } else {
                "[]";
            }
        } else {
            capacities.spell_shape(&checked.shapes[a.tensor])?;
        });
    }
    symbols.use_what(&capacities);
    w.blank();
    w.line("/// The extents `recorded` takes where each length an input carries is 1, as");
    w.line("/// `compute` pads them to their capacities.");
    w.begin(`fn ${LEAST_EXTENTS}() -> List<List<i32>>`);
    for let line of symbols.bindings().into_iter().chain(lines.into_iter()) {
        w.line(&line);
    }
    w.line(`return [${extents.join(", ")}];`);
    w.end();
    return Result::Ok(());
}

/// `Params::held`: the initializers as the backend keeps them for the pass
/// `least`, a call of `recorded`, records at the least lengths, the weights
/// taking its parameters from `first` on, and the folded literals `kept`.
fn emit_held(w: &mut CodeWriter, graph: &Graph, checked: &Checked, kept: &List<String>, first: i32, least: String) {
    w.blank();
    let mut block = ImplSpec::new(PARAMS_TYPE);
    block.add_generic(GRAPH_BOUND);
    block.emit_begin(w);
    w.line("/// The initializers, `load(at)` the `at`th on the host, as `backend` keeps");
    w.line("/// them for the pass that reads them, and the folded literals.");
    FnSpec::new("held").add_generic("Er").add_param("backend", `&mut ${BACKEND_PARAM}`).add_param(
        "load",
        "fn(i32) -> Result<Any<Cpu>, Er> with _",
    ).set_return_type(`Result<${PARAMS_TYPE}, Er>`).add_effect("_").emit_begin(w);
    let count = graph.initializers.len() + kept.len();
    if kept.is_empty() {
        w.line(`let weights = backend.kept_weights(|recorder| ${least}, ${first}, ${count}, load)?;`);
    } else {
        w.begin(`let weights = backend.kept_weights(|recorder| ${least}, ${first}, ${count}, |at| match at`);
        for let [k, tensor] of kept.into_iter().enumerate() {
            w.line(`${graph.initializers.len() + k} => Result::Ok(${kept_literal(checked, tensor)}),`);
        }
        w.line("_ => load(at),");
        w.end_with(")?;");
    }
    w.line("return Result::Ok(restored_fields(backend, &weights, 0));");
    w.end();
    w.end();
}

/// `symbols` with each padded length's capacity standing for it in every
/// extent, each bound by a line `lines` takes. A grown past's holds the present
/// too, which the pass writes into it, so where the present is the past and
/// more, the past's capacity is what the present's leaves of it.
fn at_capacities(
    symbols: &mut Symbols,
    lines: &mut List<String>,
    padded: &List<String>,
    owed: &List<[Grown, Option<Poly>]>,
    names: &Names,
    room: &Option<Room>,
) -> Result<Symbols, EmitError> {
    let mut capacities = *symbols;
    let grows = |symbol: &String| owed.into_iter().find(|o| o.0.symbol == *symbol);
    let more = if let Some(r) = room {
        ` + ${r.spelled}`;
    } else {
        "";
    };
    // The rest of a present is spelled at the capacities of the lengths it reads.
    let mut ordered: List<String> = padded.into_iter().filter(|s| grows(s) matches { None }).map(|s| *s).collect();
    ordered.extend(&padded.into_iter().filter(|s| grows(s) matches { Some(_) }).map(|s| *s).collect());
    for let symbol of ordered {
        let capacity = names.get(&capacity_key(&symbol));
        let Some([g, _]) = grows(&symbol) else {
            let own_more = if room matches { Some(r) && r.symbol == symbol } { more } else { "" };
            lines.push(
                `let ${capacity} = capacity_of(to_extent(${symbols.spell(&Poly::symbol(&symbol))?}${own_more})) as i64;`,
            );
            capacities.spell_as(&symbol, capacity);
            continue;
        };
        let present = `capacity_of(to_extent(${symbols.spell(&g.present)?}${more})) as i64`;
        lines.push(match g.present.linear_in(&symbol) {
            Some([1, rest]) => `let ${capacity} = ${present} - (${capacities.spell(&rest)?});`,
            _ => `let ${capacity} = ${present};`,
        });
        capacities.spell_as(&symbol, capacity);
    }
    return Result::Ok(capacities);
}

/// Where an argument of the program crosses from: as `build` takes it, and
/// so as `compute` holds it and `recorded` binds it.
enum Crossed {
    Input,
    Cache,
    Length,
    Weight,
}

/// One argument of the program `compute` runs: where it crosses, the tensor
/// or the length it is, its name there, and its element and axes.
struct ProgramArgument {
    crossed: Crossed,
    tensor: String,
    ident: String,
    element: String,
    axes: String,
}

impl ProgramArgument {
    fn of(checked: &Checked, names: &Names, tensor: &String, crossed: Crossed) -> ProgramArgument {
        return ProgramArgument {
            crossed,
            tensor: *tensor,
            ident: names.get(tensor),
            element: checked.primitives[*tensor],
            axes: `[${axis_list(&checked.shapes[*tensor])}]`,
        };
    }

    /// Where `compute` holds the argument.
    fn held(&self) -> String {
        return match self.crossed {
            Input => self.ident,
            Cache => `cache.${self.ident}`,
            Length => `lengths.${self.ident}`,
            Weight => `model.weights.${self.ident}`,
        };
    }

    /// The argument as the program takes it.
    fn erased(&self) -> String {
        return self.erased_from(`&${self.held()}`);
    }

    /// `place`, a reference to a value of the argument's type, as the program
    /// takes it.
    fn erased_from(&self, place: String) -> String {
        return `Any::${any_case(&self.element)}(backend.relabeled::<${self.element}, ${self.axes}, Untyped>(${place}))`;
    }

    /// The argument as `decoded` reads it at `at` of the erased `list`.
    fn taken_from(&self, list: String, at: i32) -> String {
        return `${self.element}_of::<${BACKEND_PARAM}, ${self.axes}>(backend, &${list}[${at}])`;
    }

    /// The parameter `recorded` makes of the argument, of the extents at `at`.
    fn parameter(&self, at: &String) -> String {
        return `recorder.parameter::<${self.element}, ${self.axes}>(extents[${*at}])`;
    }
}

/// The program's `at`th result as `tensor`'s type.
fn typed_result(checked: &Checked, tensor: &String, at: i32) -> String {
    let axes = axis_list(&checked.shapes[*tensor]);
    return `${checked.primitives[*tensor]}_of::<${BACKEND_PARAM}, [${axes}]>(backend, &results[${at}])`;
}

/// The `Cache` the program's results hold from `first` on.
fn cache_from_results(first: i32) -> String {
    return `restored_fields(backend, &results, ${first})`;
}

/// `taken` up to `first_weight` as the program takes it.
fn erased_arguments(taken: &List<ProgramArgument>, first_weight: i32) -> List<String> {
    return taken.into_iter().take(first_weight).map(|a| a.erased()).collect();
}

/// The weights as the program takes them.
global ERASED_WEIGHTS: String = "erased_fields(backend, &model.weights)";

/// The case of `Any` holding an element of `primitive`.
fn any_case(primitive: &String) -> String {
    return match *primitive {
        "f32" => "F32",
        "i64" => "I64",
        "bool" => "Bool",
        _ => unreachable(),
    };
}

/// The initializers, then the folded literals `kept`, as `Params` holds them.
fn weight_names(graph: &Graph, kept: &List<String>) -> List<String> {
    let mut weights: List<String> = graph.initializers.into_iter().map(|vi| vi.name).collect();
    weights.extend(kept);
    return weights;
}

/// `Model`, the weights beside the programs a backend compiled. The weights
/// are private, since the programs hold them as the first call erased them.
fn emit_model(w: &mut CodeWriter) {
    let mut model = StructSpec::new(MODEL, Vis::Pub);
    model.add_generic(GRAPH_BOUND);
    model.add_field("weights", PARAMS_TYPE);
    model.add_pub_field("programs", `Programs<${BACKEND_PARAM}>`);
    w.blank();
    w.line("/// The weights as `Bk` holds them, and the program `Bk` compiled for each");
    w.line("/// shape class `compute` has met.");
    model.emit(w);
    w.blank();
    let mut held = ImplSpec::new(`${MODEL}<${BACKEND_PARAM}>`);
    held.add_generic(GRAPH_BOUND);
    held.emit_begin(w);
    w.line(`pub fn new(weights: ${PARAMS_TYPE}) -> ${MODEL}<${BACKEND_PARAM}> {`);
    w.line(`    return ${MODEL} { weights, programs: Programs::new() };`);
    w.line("}");
    w.end();
}

/// `recorded`: [`build`] recorded over parameters, one for each of `taken`,
/// in its order, for a backend to compile, taking the branches `chosen` where
/// `chooses`. `decoding` records [`DECODED`] as `RECORDED_DECODED` instead,
/// over what `Decoding` takes between `taken` and its weights.
fn emit_recorded(
    w: &mut CodeWriter,
    names: &Names,
    taken: &List<ProgramArgument>,
    first_weight: i32,
    returned: &List<String>,
    crossing: &Crossing,
    chooses: bool,
    decoding: bool,
) {
    w.blank();
    w.line("/// [`build`] recorded over parameters of `extents`, in the order `compute`");
    w.line("/// passes its program the arguments.");
    let chosen = if chooses { `, chosen: &${CHOSEN}` } else { "" };
    let name = if decoding { RECORDED_DECODED } else { RECORDED };
    let sampler = if decoding { ", sampler: &Sampler" } else { "" };
    w.begin(`fn ${name}(recorder: &mut Recorder, extents: &List<List<i32>>${sampler}${chosen}) -> Recorded`);
    // The weights come last, past however many values the sampler takes.
    let extents_at = |at: i32| if decoding && at >= first_weight {
        `extents.len() - ${taken.len() - at}`;
    } else {
        `${at}`;
    };
    let mut arguments: List<String> = ["recorder"];
    for let [at, a] of taken.into_iter().enumerate() {
        if a.crossed matches { Input } {
            w.line(`let ${a.ident} = ${a.parameter(&extents_at(at))};`);
            arguments.push(`&${a.ident}`);
        }
    }
    if crossing.has_cache() {
        // The cache follows the inputs.
        let first_cache = taken.into_iter().filter(|a| a.crossed matches { Input }).count();
        w.line(`let cache: ${CACHE}<Recorder> = recorded_fields(recorder, extents, ${first_cache});`);
        arguments.push("&cache");
    }
    let mut lengths: List<String> = [];
    for let [at, a] of taken.into_iter().enumerate() {
        if a.crossed matches { Length } {
            lengths.push(`${a.ident}: ${a.parameter(&extents_at(at))}`);
        }
    }
    if !lengths.is_empty() {
        w.line(`let lengths = ${LENGTHS}::<Recorder> { ${lengths.join(", ")} };`);
        arguments.push("&lengths");
    }
    if decoding {
        w.line(`let decoding = Decoding::recorded(recorder, extents, ${first_weight}, sampler);`);
    }
    if chooses {
        arguments.push("chosen");
    }
    w.line(`let weights: ${PARAMS}<Recorder> = recorded_fields(recorder, extents, ${extents_at(first_weight)});`);
    arguments.push("&weights");
    if decoding {
        arguments.push("&decoding");
    }
    w.line(`let passed = ${if decoding { DECODED } else { "build" }}(${arguments.join(", ")});`);
    let mut results: List<String> = [];
    if decoding {
        results.push("passed.0.id");
        for let [past, _] of crossing.pairs {
            results.push(`passed.1.${names.get(&past)}.id`);
        }
    } else if crossing.several() {
        for let output of *returned {
            results.push(`passed.${names.get(&output)}.id`);
        }
        for let [past, _] of crossing.pairs {
            results.push(`passed.cache.${names.get(&past)}.id`);
        }
    } else {
        results.push("passed.id");
    }
    w.line(`return recorder.finished([${results.join(", ")}]);`);
    w.end();
}

/// Each axis a pass grows, where the present's axis is not the past's.
fn grown_axes(checked: &Checked, crossing: &Crossing) -> List<Grown> {
    let mut grown: List<Grown> = [];
    for let [past, present] of crossing.pairs {
        let [from, to] = [checked.shapes[past], checked.shapes[present]];
        for let [i, axis] of from.axes.into_iter().enumerate() {
            let Symbolic(length) = axis.extent else {
                continue;
            };
            if axis.name == to.axes[i].name {
                continue;
            }
            let symbols = length.symbols();
            assert symbols.len() == 1 && length == Poly::symbol(&symbols[0]);
            grown.push(Grown { past, axis: i, symbol: symbols[0], present: to.axes[i].extent.poly() });
        }
    }
    return grown;
}

/// Each axis a pass grows, and the length the graph owes its past to be, or
/// none where an input outside the cache carries it. Where neither gives it,
/// the cache's extent is a capacity, and nothing says how much of it is past.
fn grown_lengths(
    checked: &Checked,
    crossing: &Crossing,
    carriers: &List<Carrier>,
) -> Result<List<[Grown, Option<Poly>]>, EmitError> {
    let grown = grown_axes(checked, crossing);
    let mut owed: List<[Grown, Option<Poly>]> = [];
    for let g of grown {
        let carried = carriers.into_iter().any(|c| c.solved.symbol == g.symbol && !crossing.cached.contains(c.input));
        if carried {
            owed.push([g, null]);
            continue;
        }
        let Some(value) = owed_value(checked, &g.symbol, &grown) else {
            builtin::cold_path();
            return Result::Err(EmitError::Unbound(g.symbol));
        };
        owed.push([g, Option::Some(value)]);
    }
    return Result::Ok(owed);
}

/// The value the graph owes `symbol` to be, where it owes it to equal a sum
/// of the other inputs' lengths: `symbol` once in a slack owed to be 0,
/// beside no grown length. A branch owes it where it runs, and a branch that
/// reads no past owes it nothing, so each scope that solves it must agree.
fn owed_value(checked: &Checked, symbol: &String, grown: &List<Grown>) -> Option<Poly> {
    let mut value: Option<Poly> = null;
    for let owed of scopes_owed(checked) {
        let Some(found) = solved_in(&owed, symbol, grown) else {
            continue;
        };
        if let Some(v) = value && v != found {
            return null;
        }
        value = Option::Some(found);
    }
    return value;
}

/// What `checked` owes and what each branch in it owes, scope by scope.
fn scopes_owed(checked: &Checked) -> List<List<Condition>> {
    let mut all: List<List<Condition>> = [checked.owed];
    for let [_, [then_scope, else_scope]] of checked.branches.entries() {
        all.extend(&scopes_owed(then_scope));
        all.extend(&scopes_owed(else_scope));
    }
    return all;
}

/// `symbol` as one equality of `owed` solves it, as `owed_value` takes it.
fn solved_in(owed: &List<Condition>, symbol: &String, grown: &List<Grown>) -> Option<Poly> {
    for let slack of equalities(owed) {
        let Some([coefficient, rest]) = slack.linear_in(symbol) else {
            continue;
        };
        if rest.symbols().into_iter().any(|s| grown.into_iter().any(|g| g.symbol == s)) {
            continue;
        }
        if coefficient == -1 {
            return Option::Some(rest);
        }
        if coefficient == 1 {
            return Poly::constant(0).try_sub(&rest);
        }
    }
    return null;
}

/// The fits `fitted_fields` takes for the cache: each grown axis whose length
/// is padded, to its present's capacity.
fn fits_at_capacities(
    crossing: &Crossing,
    owed: &List<[Grown, Option<Poly>]>,
    padded: &List<String>,
    capacities: &mut Symbols,
) -> Result<String, EmitError> {
    let mut fields: List<String> = [];
    for let [past, _] of crossing.pairs {
        let mut fits: List<String> = [];
        for let [g, _] of *owed {
            if g.past == past && padded.contains(&g.symbol) {
                fits.push(`[${g.axis}, ${capacities.spell_extent(&g.present)?}]`);
            }
        }
        fields.push(`[${fits.join(", ")}]`);
    }
    return Result::Ok(`&[${fields.join(", ")}]`);
}

/// What crosses a pass's boundary beside its inputs and weights, which every
/// entry and the structs around them agree on.
struct Crossing {
    /// Each past and the present that replaces it in the cache.
    pairs: List<[String, String]>,
    /// The pasts, which an entry reads from the cache rather than taking.
    cached: HashSet<String>,
    /// The outputs a pass returns, a present aside: the cache holds it.
    returned: List<String>,
}

impl Crossing {
    fn of(graph: &Graph, pairs: List<[String, String]>) -> Crossing {
        let mut cached = HashSet::<String>::new();
        for let [past, _] of pairs {
            cached.insert(past);
        }
        let presents: List<String> = pairs.into_iter().map(|p| p.1).collect();
        let returned = graph.outputs.into_iter().map(|vi| vi.name).filter(|o| !presents.contains(&o)).collect();
        return Crossing { pairs, cached, returned };
    }

    fn has_cache(&self) -> bool {
        return !self.pairs.is_empty();
    }

    /// Whether `build` returns its outputs in `Passed`, and `compute` in `Outputs`.
    fn several(&self) -> bool {
        return self.returned.len() > 1 || self.has_cache();
    }
}

/// `build`: the inputs as the backend holds them, the cache, the valid lengths
/// the body reads and the weights in; the checks of what the inputs owe; the
/// body; and the outputs out, the presents as the next pass's cache. Returns
/// the padded symbols the body reads the value of.
fn emit_entry(
    w: &mut CodeWriter,
    graph: &Graph,
    checked: &Checked,
    names: &Names,
    literals: &Literals,
    kept: &List<String>,
    mut symbols: Symbols,
    crossing: &Crossing,
) -> Result<List<String>, EmitError> {
    let shapes = &checked.shapes;
    let mut exprs = Operands {};
    let mut entry = FnSpec::new("build", Vis::Pub);
    entry.add_generic(GRAPH_BOUND).add_param("backend", `&mut ${BACKEND_PARAM}`);
    // The pasts cross in one `Cache`, and the presents replace them in it.
    let [has_cache, several, returned] = [
        crossing.has_cache(),
        crossing.several(),
        crossing.returned,
    ];
    for let vi of &graph.inputs {
        let ident = names.get(&vi.name);
        exprs.values[vi.name] = ident;
        exprs.borrowed.insert(vi.name);
        if !crossing.cached.contains(vi.name) {
            entry.add_param(ident, `&${prepared_type(checked, &vi.name)}`);
        }
    }
    if has_cache {
        entry.add_param("cache", `&${CACHE}<${BACKEND_PARAM}>`);
    }
    for let vi of &graph.initializers {
        exprs.values[vi.name] = `weights.${names.get(&vi.name)}`;
    }
    for let tensor of kept {
        exprs.values[*tensor] = `weights.${names.get(tensor)}`;
    }
    // A symbol is bound once something spells it, and a valid length taken
    // once something reads it, which the body decides.
    let body = scope_body(graph, checked, names, &mut exprs, literals, &mut symbols)?;
    for let tensor of returned.into_iter().chain(crossing.pairs.into_iter().map(|p| p.1)) {
        exprs.unlifted(&tensor);
    }
    let read = symbols.read_lengths();
    // The rows a tensor each row's lengths computed holds, as many as the lengths do.
    if symbols.uses(&SLOTS) {
        symbols.bind_slots(`backend.extents_of(&lengths.${symbols.ident(&read[0])})[0] as i64`);
    }
    if !read.is_empty() {
        entry.add_param("lengths", `&${LENGTHS}<${BACKEND_PARAM}>`);
    }
    if symbols.chooses() {
        entry.add_param("chosen", `&${CHOSEN}`);
    }
    let passed_type = if several { `${PASSED}<${BACKEND_PARAM}>` } else { prepared_type(checked, &returned[0]) };
    entry.add_param("weights", `&${PARAMS_TYPE}`).set_return_type(passed_type).add_effect("_");
    entry.emit_begin(w);
    for let [past, _] of crossing.pairs {
        let ident = names.get(&past);
        w.line(`let ${ident} = &cache.${ident};`);
    }
    let checks = input_checks(graph, shapes, names, &crossing.cached);
    for let line of checks.held {
        w.line(&line);
    }
    let mut owed: List<String> = [];
    // A tensor each row's lengths computed holds as many rows as each length.
    if symbols.uses(&SLOTS) {
        for let symbol of read.into_iter().skip(1) {
            let field = `lengths.${symbols.ident(&symbol)}`;
            owed.push(
                wado`refuse(extents_mismatch(&backend.extents_of(&${field}), "${field}", ["Slots"], [to_extent(slots)]));`,
            );
        }
    }
    for let spelled of checks.spelled {
        let SpelledAxis { tensor, axis, extent, length } = spelled;
        owed.push(
            wado`refuse(extent_mismatch("${tensor}", "${axis}", ${extent}, "${length}", ${symbols.spell(&length)?}));`,
        );
    }
    owed.extend(&owed_checks(checked, &mut symbols)?);
    for let lines of [symbols.bindings(), owed, body] as List<List<String>> {
        for let line of lines {
            w.line(&line);
        }
    }
    if !several {
        w.line(`return ${exprs.value(&returned[0])};`);
    } else {
        let mut fields: List<String> = returned.into_iter().map(|o| `${names.get(&o)}: ${exprs.value(&o)}`).collect();
        if has_cache {
            // Each present under its past's axes, as the next pass reads it.
            let mut parts: List<String> = [];
            for let [past, present] of crossing.pairs {
                let at = exprs.reference(&present);
                let element = checked.primitives.get(present).unwrap();
                let axes = `[${axis_list(&shapes.get(present).unwrap())}], [${axis_list(&shapes.get(past).unwrap())}]`;
                parts.push(
                    `${names.get(&past)}: backend.reshape::<${element}, ${axes}>(${at}, backend.extents_of(${at}))`,
                );
            }
            fields.push(`cache: ${CACHE} { ${parts.join(", ")} }`);
        }
        w.line(`return ${PASSED} { ${fields.join(", ")} };`);
    }
    w.end();
    return Result::Ok(read);
}

/// `Cache`, one field per pair, each held under its past's axes, and its
/// `empty`, the state before the first pass, which takes the length of each
/// axis the graph leaves open.
fn emit_cache(w: &mut CodeWriter, pairs: &List<[String, String]>, checked: &Checked, names: &Names) {
    let mut cache = StructSpec::new(CACHE, Vis::Pub);
    cache.add_generic(HOLDS_BOUND);
    let mut opened: List<String> = [];
    let mut empties: List<String> = [];
    for let [past, present] of *pairs {
        cache.add_pub_field(names.get(&past), prepared_type(checked, &past));
        let mut extents: List<String> = [];
        for let [i, axis] of checked.shapes[past].axes.into_iter().enumerate() {
            extents.push(match axis.extent {
                Symbolic(p) => if checked.shapes[present].axes[i].name != axis.name {
                    // The past's length grows into the present's, and an empty
                    // cache holds none of it.
                    "0";
                } else {
                    open_length(&p, names, &mut opened);
                },
                _ => `${axis.static_extent()}`,
            });
        }
        empties.push(`[${extents.join(", ")}]`);
    }
    let mut params: List<String> = [`backend: &mut ${BACKEND_PARAM}`];
    for let length of opened {
        params.push(`${length}: i32`);
    }
    w.blank();
    w.line("/// The state the graph hands from one pass to the next, as the backend holds");
    w.line("/// it: each past it reads, which the present it computes replaces.");
    cache.emit(w);
    w.blank();
    let mut held = ImplSpec::new(`${CACHE}<${BACKEND_PARAM}>`);
    held.add_generic(GRAPH_BOUND);
    held.emit_begin(w);
    w.line("/// The state before the first pass: no position along a past's length,");
    w.line("/// and zeros of every other state.");
    w.line(`pub fn empty(${params.join(", ")}) -> ${CACHE}<${BACKEND_PARAM}> with _ {`);
    w.line(`    return zeroed_fields(backend, &[${empties.join(", ")}]);`);
    w.line("}");
    w.end();
}

/// The `i32` length `Cache::empty` gives an open axis of extent `p`, each
/// symbol in it a parameter of `empty`, which `opened` lists once.
fn open_length(p: &Poly, names: &Names, opened: &mut List<String>) -> String {
    let mut spelled = HashMap::<String, String>::new();
    for let symbol of p.symbols() {
        let ident = names.get(&symbol_key(&symbol));
        if !opened.contains(&ident) {
            opened.push(ident);
        }
        if *p == Poly::symbol(&symbol) {
            return ident;
        }
        spelled[symbol] = `(${ident} as i64)`;
    }
    return `to_extent(${p.spelled(&spelled)})`;
}

/// The struct `pass` returns a graph's several outputs in, each as the
/// backend holds it.
fn emit_passed(w: &mut CodeWriter, returned: &List<String>, has_cache: bool, checked: &Checked, names: &Names) {
    let mut passed = StructSpec::new(PASSED, Vis::Pub);
    passed.add_generic(HOLDS_BOUND);
    for let output of *returned {
        passed.add_pub_field(names.get(&output), prepared_type(checked, &output));
    }
    if has_cache {
        passed.add_pub_field("cache", `${CACHE}<${BACKEND_PARAM}>`);
    }
    w.blank();
    w.line("/// The graph's outputs as the backend holds them, in the order it declares them.");
    passed.emit(w);
}

/// The checks of what a scope owes, which run before any kernel in it.
fn owed_checks(checked: &Checked, symbols: &mut Symbols) -> Result<List<String>, EmitError> {
    let mut lines: List<String> = [];
    for let c of &checked.owed {
        // Its extents are capacities, which need not meet what the lengths
        // meet: whoever pads the inputs checks it at the lengths.
        if symbols.reads_lengths(&c.slack) {
            continue;
        }
        lines.push(wado`refuse(unmet(${symbols.spell(&c.slack)?}, "${c.reason}"));`);
    }
    return Result::Ok(lines);
}

/// Each input among `inputs` some `If` in `graph` branches on, in the order
/// the `If`s come.
fn held_conditions(graph: &Graph, checked: &Checked, inputs: &List<String>) -> List<String> {
    let mut found: List<String> = [];
    for let node of &graph.nodes {
        if !checked.branches.contains_key(node.outputs[0]) {
            continue;
        }
        if inputs.contains(&node.inputs[0]) && !found.contains(&node.inputs[0]) {
            found.push(node.inputs[0]);
        }
        for let b of branches(node, checked) {
            for let c of held_conditions(&b.graph, &b.checked, inputs) {
                if !found.contains(&c) {
                    found.push(c);
                }
            }
        }
    }
    return found;
}

/// What one scope owes at its lengths, then at `at_end`'s where those differ.
fn checks_at(checked: &Checked, symbols: &mut Symbols, at_end: &mut Option<Symbols>) -> Result<List<String>, EmitError> {
    let mut lines = owed_checks(checked, symbols)?;
    if let Some(end) = at_end {
        for let check of owed_checks(checked, end)? {
            if !lines.contains(&check) {
                lines.push(check);
            }
        }
    }
    return Result::Ok(lines);
}

/// What each `If` in `graph` owes in the branch it takes, checked on the host
/// against its condition, which must be one of `conditions`, the inputs the
/// host holds.
fn branch_checks(
    graph: &Graph,
    checked: &Checked,
    names: &Names,
    conditions: &List<String>,
    symbols: &mut Symbols,
    at_end: &mut Option<Symbols>,
) -> Result<List<String>, EmitError> {
    let mut lines: List<String> = [];
    for let node of &graph.nodes {
        if !checked.branches.contains_key(node.outputs[0]) {
            continue;
        }
        let mut owed: List<List<String>> = [];
        for let b of branches(node, checked) {
            let mut scope = checks_at(&b.checked, symbols, at_end)?;
            scope.extend(&branch_checks(&b.graph, &b.checked, names, conditions, symbols, at_end)?);
            owed.push(scope);
        }
        if owed.into_iter().all(|o| o.is_empty()) {
            continue;
        }
        if !conditions.contains(&node.inputs[0]) {
            return Result::Err(EmitError::HiddenCondition(node.outputs[0]));
        }
        lines.push(`if ${names.get(&node.inputs[0])}.data[0] {`);
        lines.extend(&indented(owed[0]));
        lines.push("} else {");
        lines.extend(&indented(owed[1]));
        lines.push("}");
    }
    return Result::Ok(lines);
}

/// One scope's statements: the literals it spells that no scope around it
/// did, then each node's operations, but for a weight's transpose, which the
/// product reading it reads past.
fn scope_body(
    graph: &Graph,
    checked: &Checked,
    names: &Names,
    exprs: &mut Operands,
    literals: &Literals,
    symbols: &mut Symbols,
) -> Result<List<String>, EmitError> {
    let mut body: List<String> = [];
    for let tensor of literals.spelled {
        if exprs.values.contains_key(tensor) {
            continue;
        }
        let ident = names.get(&tensor);
        body.push(`let ${ident} = ${literal_tensor(checked, &tensor, symbols)?};`);
        exprs.values[tensor] = ident;
    }
    for let [alias, spelled] of literals.aliases.entries() {
        if !exprs.values.contains_key(*alias) {
            exprs.values[*alias] = exprs.value(spelled);
        }
    }
    let lowered = lowerings(graph, checked);
    for let [at, node] of graph.nodes.into_iter().enumerate() {
        match lowered[at] {
            Folded => {
            },
            Transposed => {
                exprs.transposed[node.outputs[0]] = node.inputs[0];
                exprs.unlifted(&node.inputs[0]);
            },
            Alias => {
                exprs.values[node.outputs[0]] = exprs.values.get(node.inputs[0]).unwrap();
                if exprs.borrowed.contains(node.inputs[0]) {
                    exprs.borrowed.insert(node.outputs[0]);
                }
                if exprs.lifted.contains(node.inputs[0]) {
                    exprs.lifted.insert(node.outputs[0]);
                }
            },
            Branch => {
                exprs.unlifted(&node.inputs[0]);
                body.extend(&branch_block(&node, checked, names, exprs, symbols)?);
            },
            Operation => body.extend(&node_calls(&node, checked, names, exprs, symbols, graph.opset)?),
            Attended => {
            },
            Attention(a) => {
                for let tensor of a.operands() {
                    exprs.unlifted(&tensor);
                }
                body.extend(&spelled_attention_call(&node, &a, checked, names, exprs, symbols)?);
            },
        }
    }
    return Result::Ok(body);
}

/// A node's operations, each bound to the output it computes.
fn node_calls(
    node: &Node,
    checked: &Checked,
    names: &Names,
    exprs: &mut Operands,
    symbols: &mut Symbols,
    opset: Option<i64>,
) -> Result<List<String>, EmitError> {
    if let Some(call) = lifted_call(node, checked, exprs, symbols, opset)? {
        return Result::Ok([bound_to(&node.outputs[0], call, names, exprs)]);
    }
    if node.op == GROUP_QUERY_ATTENTION {
        let mut bound: List<String> = [];
        for let output of node.outputs {
            if output == "" {
                bound.push("_");
                continue;
            }
            let ident = names.get(&output);
            exprs.values[output] = ident;
            bound.push(ident);
        }
        // The composite computes every output, so an unnamed one is dropped.
        while bound.len() < 3 {
            bound.push("_");
        }
        return Result::Ok([`let [${bound.join(", ")}] = ${attention_call(node, checked, exprs, symbols)?};`]);
    }
    let calls = if node.op == "Split" {
        built_split(node, checked, exprs, symbols)?;
    } else {
        [built_call(node, checked, exprs, symbols, opset)?] as List<String>;
    };
    let mut lines: List<String> = [];
    for let [i, call] of calls.into_iter().enumerate() {
        lines.push(bound_to(&node.outputs[i], call, names, exprs));
    }
    return Result::Ok(lines);
}

/// `node`'s call where it reads a tensor each row's lengths computed, or
/// computes one: `null` where it does neither. Such a tensor holds the rows of
/// `[Slots]` ahead of its axes, which an elementwise operation, a reshape and
/// a gather by it keep there, until an operand meets the batch whose rows they
/// are, where they fold into its axis.
fn lifted_call(
    node: &Node,
    checked: &Checked,
    exprs: &mut Operands,
    symbols: &mut Symbols,
    opset: Option<i64>,
) -> Result<Option<String>, EmitError> {
    let Some(rows) = symbols.rows() else {
        return Result::Ok(null);
    };
    let shapes = &checked.shapes;
    let output = node.outputs[0];
    let out = shapes[output];
    if node.op == "Range" {
        let [start, _, delta] = settled(range_bounds(node, &checked.known));
        if !symbols.reads_lengths(&start) && !symbols.reads_lengths(&delta) {
            return Result::Ok(null);
        }
        let axis = out.axes[0];
        exprs.lifted.insert(output);
        return Result::Ok(
            Option::Some(
                `row_range::<${BACKEND_PARAM}, ${axis.name}>(backend, &${symbols.row_lengths(&start)?}, ${symbols.spell_extent(
                    &axis.extent.poly(),
                )?}, &${symbols.row_lengths(&delta)?})`,
            ),
        );
    }
    let read = lifted_operands(node, &exprs.lifted);
    if read.is_empty() {
        return Result::Ok(null);
    }
    assert keeps_lifted(node, checked, &read), "only a node keeping them apart reads what each row's lengths computed";
    let folds = is_elementwise(node) && out.axes.into_iter().any(|a| a.name == rows);
    // A builder reads only the node's own tensors, so a scope of those stands in.
    let mut local = Checked {
        shapes: HashMap::<String, Shape>::new(),
        primitives: HashMap::<String, String>::new(),
        known: HashMap::<String, Known>::new(),
        owed: [],
    };
    let mut operands = Operands {};
    for let tensor of node.inputs.into_iter().chain(node.outputs.into_iter()) {
        if let Some(shape) = shapes.get(tensor) {
            local.shapes[tensor] = shape;
            local.primitives[tensor] = checked.primitives[tensor];
        }
        if let Some(known) = checked.known.get(tensor) {
            local.known[tensor] = known;
        }
        if let Some(value) = exprs.values.get(tensor) {
            operands.values[tensor] = value;
        }
        if exprs.borrowed.contains(tensor) {
            operands.borrowed.insert(tensor);
        }
    }
    for let tensor of read {
        let lifted = lifted_shape(&shapes[tensor]);
        if !folds {
            local.shapes[tensor] = lifted;
            continue;
        }
        let folded = folded_rows(&shapes[tensor], &out, &rows).expect("an operand holds one element ahead of its rows");
        operands.values[tensor] = `backend.reshape::<${checked.primitives[tensor]}, [${axis_list(&lifted)}], [${axis_list(
            &folded,
        )}]>(${exprs.reference(&tensor)}, ${symbols.spell_shape(&folded)?})`;
        operands.borrowed.remove(tensor);
        local.shapes[tensor] = folded;
    }
    if !folds {
        local.shapes[output] = lifted_shape(&out);
        exprs.lifted.insert(output);
    }
    return Result::Ok(Option::Some(built_call(node, &local, &operands, symbols, opset)?));
}

/// `shape` with the rows of `[Slots]` ahead of its axes.
fn lifted_shape(shape: &Shape) -> Shape {
    let mut axes: List<Axis> = [
        Axis { name: "Slots", extent: Extent::symbol(&SLOTS) },
    ];
    axes.extend(&shape.axes);
    return Shape { axes };
}

/// A `GroupQueryAttention` as its composite's call. An optional operand absent
/// still needs its axes named, so the turbofish spells the query's for it. The
/// composite takes a padded past as a buffer of fixed capacity, with its valid
/// length.
fn attention_call(node: &Node, checked: &Checked, exprs: &Operands, symbols: &mut Symbols) -> Result<String, EmitError> {
    let shapes = &checked.shapes;
    let options = settled(attention_options(node));
    let q = shapes[node.inputs[0]];
    let k = shapes[node.inputs[1]];
    let past = shapes[node.inputs[3]];
    let total = shapes[named_present(node).unwrap()].axes[2].name;
    let optional = |index: i32| if node.has_operand(index) {
        `Option::Some(${exprs.reference(&node.inputs[index])})`;
    } else {
        "null";
    };
    let [pos, half] = if node.has_operand(ROTARY_COS) {
        let cache = shapes[node.inputs[ROTARY_COS]];
        [cache.axes[0].name, cache.axes[1].name];
    } else {
        [q.axes[1].name, past.axes[3].name];
    };
    let [bias_batch, bias_heads] = if node.has_operand(ATTENTION_BIAS) {
        let bias = shapes[node.inputs[ATTENTION_BIAS]];
        [bias.axes[0].name, bias.axes[1].name];
    } else {
        [q.axes[0].name, past.axes[1].name];
    };
    let turbofish = [
        q.axes[0].name, q.axes[1].name, q.axes[2].name, k.axes[2].name, past.axes[1].name, past.axes[2].name, total,
        past.axes[3].name, pos, half, bias_batch, bias_heads, q.axes[1].name,
    ] as List<String>;
    let head = past.axes[3].static_extent();
    let scale = options.scale.unwrap_or(1.0 / f32::sqrt(head as f32));
    let attention = `&Attention { heads: ${options.heads}, kv_heads: ${options.kv_heads}, scale: ${float_literal(scale)}, softcap: ${float_literal(
        options.softcap,
    )}, window: ${options.window}, causal: ${options.causal} }`;
    let mut operands: List<String> = [];
    for let i of 0..<5 {
        operands.push(exprs.reference(&node.inputs[i]));
    }
    operands.push(symbols.length_operand(&past.axes[2].extent.poly(), &q)?);
    // A causal attention reads no padding, whose hidden score is infinite.
    operands.push("null");
    // The caches are read only where the attribute asks for rotation.
    for let index of [ROTARY_COS, ROTARY_SIN] {
        operands.push(if options.rotary { optional(index) } else { "null" });
    }
    operands.push(optional(ATTENTION_BIAS));
    operands.push(attention);
    return Result::Ok(`backend.group_query_attention::<${turbofish.join(", ")}>(${operands.join(", ")})`);
}

/// An attention spelled in parts as the composite's call, computing what the
/// node at its end returns and the presents. The call names each axis once,
/// so an operand or result the graph names otherwise crosses by `relabeled`.
/// With no past it joins the new positions to an empty one, bound to the
/// present value's name, which the call then binds to the present.
fn spelled_attention_call(
    node: &Node,
    a: &SpelledAttention,
    checked: &Checked,
    names: &Names,
    exprs: &mut Operands,
    symbols: &mut Symbols,
) -> Result<List<String>, EmitError> {
    let shapes = &checked.shapes;
    let q = shapes[a.query];
    let present = shapes[a.present_value];
    let [batch, sequence] = [q.axes[0].name, q.axes[1].name];
    let [heads, total, width] = [present.axes[1].name, present.axes[2].name, present.axes[3].name];
    let key_width = shapes[a.key].axes[2].name;
    let new_axes = ([batch, sequence, key_width] as List<String>).join(", ");
    let held_axes = |positions: &String| ([batch, heads, *positions, width] as List<String>).join(", ");
    let as_axes = |tensor: &String, to: &String| -> String {
        let from = axis_list(&shapes[*tensor]);
        if from == *to {
            return exprs.reference(tensor);
        }
        return `&backend.relabeled::<f32, [${from}], [${to}]>(${exprs.reference(tensor)})`;
    };
    let mut lines: List<String> = [];
    let present_value = names.get(&a.present_value);
    let mut operands = [
        exprs.reference(&a.query),
        as_axes(&a.key, &new_axes),
        as_axes(&a.value, &new_axes),
    ] as List<String>;
    let positions = match &a.past {
        Some([past_k, past_v]) => {
            let positions = shapes[*past_k].axes[2];
            let held = held_axes(&positions.name);
            // The present is the past's buffer, written after its valid
            // positions, so a padded past takes the present's extent first: a
            // cache arrives at it, and anything else at its own capacity.
            let padded = symbols.reads_lengths(&positions.extent.poly());
            let room = symbols.spell_extent(&present.axes[2].extent.poly())?;
            for let past of [past_k, past_v] {
                let operand = as_axes(past, &held);
                operands.push(
                    if padded {
                        `&fitted::<${BACKEND_PARAM}, f32, [${held}]>(backend, ${operand}, 2, ${room})`;
                    } else {
                        operand;
                    },
                );
            }
            operands.push(symbols.length_operand(&positions.extent.poly(), &q)?);
            positions.name;
        },
        None => {
            let extents = [symbols.spell_extent(&present.axes[0].extent.poly())?, `${a.heads}`, "0", `${a.width}`] as List<String>;
            lines.push(
                `let ${present_value} = backend.upload(&Tensor::<f32, [${held_axes(&total)}]> { data: [], extents: [${extents.join(
                    ", ",
                )}] });`,
            );
            operands.push(`&${present_value}`);
            operands.push(`&${present_value}`);
            operands.push("null");
            total;
        },
    };
    operands.push(symbols.length_operand(&present.axes[2].extent.poly(), &q)?);
    // No rotary tables.
    operands.push("null");
    operands.push("null");
    let bias_axes = match &a.bias {
        Some(b) => {
            let own = shapes[*b];
            let axes = [own.axes[0].name, own.axes[1].name, own.axes[2].name] as List<String>;
            operands.push(`Option::Some(${as_axes(b, &`${axes.join(", ")}, ${total}`)})`);
            axes;
        },
        None => {
            operands.push("null");
            [batch, heads, sequence] as List<String>;
        },
    };
    operands.push(
        `&Attention { heads: ${a.heads}, kv_heads: ${a.heads}, scale: ${float_literal(a.scale)}, divides: ${a.divides}, softcap: 0.0, window: -1, causal: true, hidden: Option::Some(${float_literal(
            a.hidden,
        )}) }`,
    );
    let mut turbofish = [batch, sequence, q.axes[2].name, key_width, heads, positions, total, width, sequence, width] as List<String>;
    turbofish.extend(&bias_axes);
    let attended = names.get(&node.outputs[0]);
    let present_key = match &a.present_key {
        Some(key) => names.get(key),
        None => "_",
    };
    lines.push(
        `let [${attended}, ${present_key}, ${present_value}] = backend.group_query_attention::<${turbofish.join(", ")}>(${operands.join(
            ", ",
        )});`,
    );
    let mut results = [
        [node.outputs[0], attended, axis_list(&q)],
        [a.present_value, present_value, held_axes(&total)],
    ] as List<[String, String, String]>;
    if let Some(key) = &a.present_key {
        results.push([*key, present_key, held_axes(&total)]);
    }
    for let [tensor, ident, from] of results {
        exprs.values[tensor] = ident;
        let to = axis_list(&shapes[tensor]);
        if from != to {
            lines.push(`let ${ident} = backend.relabeled::<f32, [${from}], [${to}]>(&${ident});`);
        }
    }
    return Result::Ok(lines);
}

/// The statement binding `call` to `output`'s name, which later reads of
/// `output` then take.
fn bound_to(output: &String, call: String, names: &Names, exprs: &mut Operands) -> String {
    let ident = names.get(output);
    exprs.values[*output] = ident;
    return `let ${ident} = ${call};`;
}

/// An `If`, each branch a block that checks what it owes, computes its
/// outputs, and yields them under the axes the node's outputs carry. `build`
/// takes the one the host chose, or adds a conditional whose branches are the
/// blocks.
fn branch_block(
    node: &Node,
    checked: &Checked,
    names: &Names,
    exprs: &mut Operands,
    symbols: &mut Symbols,
) -> Result<List<String>, EmitError> {
    let [then_branch, else_branch] = branches(node, checked);
    let outputs: List<String> = node.outputs.into_iter().map(|o| names.get(&o)).collect();
    let bound = if outputs.len() == 1 { outputs[0] } else { `[${outputs.join(", ")}]` };
    let condition = exprs.reference(&node.inputs[0]);
    let types: List<String> = node.outputs.into_iter().map(|o| prepared_type(checked, &o)).collect();
    let yielded = if types.len() == 1 { types[0] } else { `[${types.join(", ")}]` };
    let axes = axis_list(&checked.shapes[node.inputs[0]]);
    let opening = match symbols.chosen_branch(&node.inputs[0]) {
        Some(chosen) => `branched::<${BACKEND_PARAM}, [${axes}], ${yielded}>(backend, ${condition}, ${chosen}, || {`,
        None => `backend.conditional::<[${axes}], ${yielded}>(${condition}, || {`,
    };
    let mut lines: List<String> = [`let ${bound} = ${opening}`];
    lines.extend(&indented(branch_lines(node, &then_branch, checked, names, exprs, symbols)?));
    lines.push("}, || {");
    lines.extend(&indented(branch_lines(node, &else_branch, checked, names, exprs, symbols)?));
    lines.push("});");
    for let [i, output] of node.outputs.into_iter().enumerate() {
        exprs.values[output] = outputs[i];
    }
    return Result::Ok(lines);
}

/// One branch's block, in a copy of the operands around it.
fn branch_lines(
    node: &Node,
    taken: &IfBranch,
    around: &Checked,
    names: &Names,
    exprs: &Operands,
    symbols: &mut Symbols,
) -> Result<List<String>, EmitError> {
    let graph = &taken.graph;
    let branch = &taken.checked;
    let mut inner = Operands { values: exprs.values, borrowed: exprs.borrowed, lifted: exprs.lifted };
    // A branch checks against a copy of the shapes around it.
    for let [tensor, _] of exprs.values.entries() {
        let [Some(from), Some(to)] = [
            around.shapes.get(*tensor),
            branch.shapes.get(*tensor),
        ] else {
            continue;
        };
        if axis_list(&from) != axis_list(&to) {
            inner.values[*tensor] = relabeled(&around.primitives[*tensor], &from, &to, &exprs.reference(tensor));
            inner.borrowed.remove(*tensor);
        }
    }
    let mut lines = owed_checks(branch, symbols)?;
    lines.extend(&scope_body(graph, branch, names, &mut inner, &graph_literals(graph, branch), symbols)?);
    let mut yielded: List<String> = [];
    for let [i, vi] of graph.outputs.into_iter().enumerate() {
        inner.unlifted(&vi.name);
        let from = branch.shapes[vi.name];
        let to = around.shapes[node.outputs[i]];
        let element = &around.primitives[node.outputs[i]];
        let result = if axis_list(&from) == axis_list(&to) {
            inner.value(&vi.name);
        } else {
            relabeled(element, &from, &to, &inner.reference(&vi.name));
        };
        // A recording graph learns from `yielded` which of its tensors a
        // branch returns.
        yielded.push(`backend.yielded::<${*element}, [${axis_list(&to)}]>(&${result})`);
    }
    let value = if yielded.len() == 1 { yielded[0] } else { `[${yielded.join(", ")}]` };
    // A conditional's branch is a closure, which returns its value.
    lines.push(`return ${value};`);
    return Result::Ok(lines);
}

/// The tensor `operand` refers to, of axes `from`, as one of axes `to`.
fn relabeled(element: &String, from: &Shape, to: &Shape, operand: &String) -> String {
    let axes = `${*element}, [${axis_list(from)}], [${axis_list(to)}]`;
    return `lifted::<${BACKEND_PARAM}, ${axes}>(backend, ${*operand}, ${to.rank()})`;
}

fn indented(lines: List<String>) -> List<String> {
    return lines.into_iter().map(|line| `    ${line}`).collect();
}

/// The struct `compute` returns a graph's several outputs in, one field each.
fn emit_outputs(
    w: &mut CodeWriter,
    returned: &List<String>,
    has_cache: bool,
    checked: &Checked,
    names: &Names,
    held: &HashMap<String, String>,
) {
    let mut outputs = StructSpec::new(OUTPUTS, Vis::Pub);
    if has_cache {
        outputs.add_generic(HOLDS_BOUND);
    }
    for let output of *returned {
        outputs.add_pub_field(names.get(&output), tensor_type(checked, held, &output));
    }
    if has_cache {
        // The cache stays where the backend holds it, for the next pass.
        outputs.add_pub_field("cache", `${CACHE}<${BACKEND_PARAM}>`);
    }
    w.blank();
    w.line("/// The graph's outputs, in the order it declares them.");
    outputs.emit(w);
}

/// The folded tensors `build` binds as literals.
struct Literals {
    spelled: List<String>,
    /// A tensor a node names again under the same axes (`is_alias`), and the
    /// spelled one it reads: a transformer names its mask once per layer, and
    /// the mask is as large as the context.
    aliases: HashMap<String, String>,
}

/// The folded tensors `build` reads as a tensor: all an operation reads as
/// one or the graph returns.
fn graph_literals(graph: &Graph, checked: &Checked) -> Literals {
    let mut read = HashSet::<String>::new();
    read_by_graph(&mut read, graph, checked);
    return literal_tensors(graph, checked, |name| read.contains(*name));
}

/// Into `read`, what the graph returns and what an operation `build` adds
/// reads as a tensor, in a branch's scope among them.
fn read_by_graph(read: &mut HashSet<String>, graph: &Graph, checked: &Checked) {
    for let vi of &graph.outputs {
        read.insert(vi.name);
    }
    let lowered = lowerings(graph, checked);
    for let [at, node] of graph.nodes.into_iter().enumerate() {
        if lowered[at] matches { Folded | Attended } {
            continue;
        }
        if let Attention(a) = lowered[at] {
            for let t of a.operands() {
                read.insert(t);
            }
            continue;
        }
        if lowered[at] matches { Branch } {
            for let b of branches(&node, checked) {
                read_by_graph(read, &b.graph, &b.checked);
            }
        }
        for let index of graph_operands(&node) {
            if node.has_operand(index) {
                read.insert(node.inputs[index]);
            }
        }
    }
}

/// The folded tensors something reads as a tensor, those `wanted` keeps, each
/// spelled once under its axes.
fn literal_tensors(graph: &Graph, checked: &Checked, wanted: fn(&String) -> bool) -> Literals {
    let mut sources = HashMap::<String, String>::new();
    for let node of &graph.nodes {
        if is_alias(node, checked) && checked.known.contains_key(node.outputs[0]) {
            sources[node.outputs[0]] = node.inputs[0];
        }
    }
    let mut literals = Literals { spelled: [], aliases: HashMap::<String, String>::new() };
    let mut spelled_for = HashMap::<String, String>::new();
    for let [name, _] of checked.known.entries() {
        if !checked.shapes.contains_key(*name) || !wanted(name) {
            continue;
        }
        let mut root = *name;
        while let Some(source) = sources.get(root) {
            root = source;
        }
        let axes = axis_list(&checked.shapes[*name]);
        if let Some(spelled) = spelled_for.get(root) && axis_list(&checked.shapes[spelled]) == axes {
            literals.aliases[*name] = spelled;
            continue;
        }
        spelled_for.try_insert(root, *name);
        literals.spelled.push(*name);
    }
    return literals;
}

/// A folded tensor spelled out as a `Tensor` literal for this pass, under the
/// shape stage 0 gave it. An element reading a valid length is a value the
/// graph computes, so `build` assembles those in the graph.
fn literal_tensor(checked: &Checked, tensor: &String, symbols: &mut Symbols) -> Result<String, EmitError> {
    let shape = checked.shapes.get(*tensor).unwrap();
    let extents = symbols.spell_shape(&shape)?;
    let data = match checked.known.get(*tensor).unwrap().elements {
        Symbolic(v) => {
            if v.into_iter().any(|p| symbols.reads_lengths(&p)) {
                let mut values: List<String> = [];
                for let p of v {
                    values.push(symbols.scalar_value(&p)?);
                }
                let typed = `${checked.primitives[*tensor]}, [${axis_list(&shape)}]`;
                return Result::Ok(
                    `assembled::<${BACKEND_PARAM}, ${typed}>(backend, [${values.join(", ")}], ${extents})`,
                );
            }
            let mut spelled: List<String> = [];
            for let p of v {
                spelled.push(symbols.spell(&p)?);
            }
            `[${spelled.join(", ")}]`;
        },
        constant => constant_elements(&constant),
    };
    return Result::Ok(`backend.upload(&${host_literal(checked, tensor, data, extents)})`);
}

/// A folded tensor that no symbol enters on the host, which the backend keeps
/// among the weights for every pass: one `build` would otherwise rebuild and
/// upload on each call, as large as the context where it is a mask.
fn kept_literal(checked: &Checked, tensor: &String) -> String {
    let extents = static_extents(&checked.shapes[*tensor]).expect("a kept literal's shape is static");
    let data = constant_elements(&checked.known[*tensor].elements);
    return `${checked.primitives[*tensor]}_host(${host_literal(checked, tensor, data, `${extents}`)})`;
}

/// The folded tensors in `literals` that no symbol enters, which `Params`
/// holds rather than `build` building them.
fn kept_literals(literals: &Literals, checked: &Checked) -> List<String> {
    let mut kept: List<String> = [];
    for let tensor of literals.spelled {
        let constant = !checked.known[tensor].elements matches { Symbolic(_) };
        if constant && static_extents(&checked.shapes[tensor]) matches { Some(_) } {
            kept.push(tensor);
        }
    }
    return kept;
}

/// The shape's extents where each is a constant.
fn static_extents(shape: &Shape) -> Option<List<i64>> {
    let mut extents: List<i64> = [];
    for let axis of shape.axes {
        extents.push(axis.extent.poly().as_constant()?);
    }
    return Option::Some(extents);
}

/// The elements of a folded tensor no symbol enters, as a list expression.
fn constant_elements(elements: &Elements) -> String {
    return match *elements {
        Ints(v) => `${v}`,
        Floats(v) => {
            let spelled: List<String> = v.into_iter().map(|x| float_literal(x)).collect();
            `[${spelled.join(", ")}]`;
        },
        // A mask is as large as the context it covers, so it is spelled as
        // bytes, which the compiler folds into a data segment.
        Bools(v) => {
            let mut bytes = ByteList::with_capacity(v.len());
            for let b of v {
                bytes.push(if b { 1 } else { 0 });
            }
            `List::<u8>::from_le_bytes(${byte_string_literal(&bytes)}).into_iter().map(|b| b != 0).collect()`;
        },
        Symbolic(_) => unreachable(),
    };
}

/// The host `Tensor` of `data` over `extents`, typed as the folded `tensor` is.
fn host_literal(checked: &Checked, tensor: &String, data: String, extents: String) -> String {
    let element = checked.primitives.get(*tensor).unwrap();
    let shape = checked.shapes.get(*tensor).unwrap();
    return `Tensor::<${element}, [${axis_list(&shape)}]> { data: ${data}, extents: ${extents} }`;
}

/// An input axis whose length the graph spells as arithmetic over symbols,
/// which `build` checks once it has bound them.
struct SpelledAxis {
    tensor: String,
    axis: String,
    /// The axis's extent as `build` reads it off the input.
    extent: String,
    length: Poly,
}

/// The checks that stop a pass naming the axis an input disagrees on, before
/// any operation reads the input.
struct InputChecks {
    /// What `build` checks of the inputs the backend holds: their extents.
    held: List<String>,
    /// What `compute` checks of the inputs on the host before it uploads them:
    /// their extents, and that the data fills them. A past the cache holds is
    /// on the backend already, so only `build` checks it.
    host: List<String>,
    /// The axes whose length is arithmetic over symbols, for `build` to check
    /// once it has bound them.
    spelled: List<SpelledAxis>,
}

fn input_checks(graph: &Graph, shapes: &HashMap<String, Shape>, names: &Names, cached: &HashSet<String>) -> InputChecks {
    let mut checks = InputChecks { held: [], host: [], spelled: [] };
    let mut first_seen = HashMap::<String, String>::new();
    let mut agreements: List<String> = [];
    for let vi of &graph.inputs {
        let ident = names.get(&vi.name);
        let shape = shapes.get(vi.name).unwrap();
        let mut axes: List<String> = [];
        let mut stated: List<i32> = [];
        for let [i, axis] of shape.axes.into_iter().enumerate() {
            axes.push(wado`"${axis.name}"`);
            let extent = `backend.extents_of(${ident})[${i}]`;
            let Symbolic(length) = axis.extent else {
                stated.push(axis.static_extent());
                continue;
            };
            stated.push(-1);
            let Some(symbol) = axis.extent.lone_symbol() else {
                checks.spelled.push(SpelledAxis { tensor: vi.name, axis: axis.name, extent, length });
                continue;
            };
            if let Some(first) = first_seen.get(symbol) {
                agreements.push(
                    wado`refuse(axis_mismatch("${symbol}", "${vi.name}", "${axis.name}", ${extent}, ${first}));`,
                );
            } else {
                first_seen[symbol] = `${wado`"${vi.name}"`}, ${extent}`;
            }
        }
        let described = wado`"${vi.name}", [${axes.join(", ")}], ${stated}`;
        checks.held.push(`refuse(extents_mismatch(&backend.extents_of(${ident}), ${described}));`);
        if !cached.contains(vi.name) {
            checks.host.push(`refuse(input_mismatch(${ident}, ${described}));`);
        }
    }
    checks.held.extend(&agreements);
    return checks;
}

/// Whether a boundary tensor is held in something other than what the
/// operations compute it in, so it is converted on the way past.
fn converted(checked: &Checked, held: &HashMap<String, String>, tensor: &String) -> bool {
    return held.get(*tensor).unwrap() != checked.primitives.get(*tensor).unwrap();
}

/// A tensor's type, as the axis marker types name it. A tensor the boundary
/// does not declare is held in what stage 0 computes it in.
fn tensor_type(checked: &Checked, held: &HashMap<String, String>, tensor: &String) -> String {
    let shape = checked.shapes.get(*tensor).unwrap();
    let element = match held.get(*tensor) {
        Some(p) => p,
        None => checked.primitives.get(*tensor).unwrap(),
    };
    return `Tensor<${element}, [${axis_list(&shape)}]>`;
}

/// Every axis name the checked graph uses, in the order stage 0 gave each
/// tensor its shape, so the emitted module is stable across runs.
fn axis_names(graph: &Graph, checked: &Checked) -> List<String> {
    let mut seen = HashSet::<String>::new();
    let mut names: List<String> = [];
    push_scope_axes(&mut names, &mut seen, graph, checked);
    return names;
}

/// The axes every tensor a scope gave a shape carries, a constant a kernel
/// reads among them, then those of each `If`'s branches.
fn push_scope_axes(names: &mut List<String>, seen: &mut HashSet<String>, graph: &Graph, checked: &Checked) {
    for let [_, shape] of checked.shapes.entries() {
        push_markers(names, seen, &shape.axes);
    }
    for let [branch_graph, branch] of branches_of(graph, checked) {
        push_scope_axes(names, seen, &branch_graph, &branch);
    }
}


/// A merged axis is spelled with its parts' markers, so the parts are what the
/// module declares.
fn push_markers(names: &mut List<String>, seen: &mut HashSet<String>, axes: &List<Axis>) {
    for let axis of *axes {
        if !axis.parts.is_empty() {
            push_markers(names, seen, &axis.parts);
        } else if seen.insert(axis.name) {
            names.push(axis.name);
        }
    }
}
