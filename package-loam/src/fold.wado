//! Stage 0's evaluation of what a graph computes from what the build knows:
//! the shape arithmetic an exporter writes, and the constants it reaches.

use { TreeMap } from "core:collections";
use { Extent } from "./extent.wado";
use { AttrError, Elements, Known, Node, Stored, data_type, trailing_axes } from "./graph.wado";
use { Condition, Poly, ceiling, owe } from "./poly.wado";
use {
    broadcast_extents,
    checked_element_count,
    element_count,
    followed_by_units,
    from_end,
    stretched_strides,
} from "./runtime/tensor.wado";
use { Shape } from "./shape.wado";

/// The tensor `node` produces when every operand it reads is known, or `None`
/// where the run computes it. `Err` says why the build cannot evaluate it.
pub fn fold(
    node: &Node,
    known: &TreeMap<String, Known>,
    shapes: &TreeMap<String, Shape>,
) -> Result<Option<Known>, String> {
    return evaluated(node, known, shapes).map(|found| found.map(|k| in_width(k, node)));
}

/// `k` as its ONNX element holds it: an int32 keeps the low 32 bits of each
/// value, which the run derives where only it knows the value, as `node`
/// computes it, and a half rounds each value to one it holds.
fn in_width(k: Known, node: &Node) -> Known {
    let elements = match [k.stored, k.elements] {
        [Computed, _] => {
            return k;
        },
        [Int32, Ints(v)] => Elements::Ints(v.into_iter().map(|c| c as i32 as i64).collect()),
        [Int32, Symbolic(v)] => {
            let site = node.site();
            Elements::integers(v.into_iter().map(|p| Poly::wrapped32(&p, &site)).collect());
        },
        [half, Floats(v)] => Elements::Floats(v.into_iter().map(|x| half.widened(half.narrowed(x))).collect()),
        _ => unreachable(),
    };
    return Known { ..k, elements };
}

fn evaluated(
    node: &Node,
    known: &TreeMap<String, Known>,
    shapes: &TreeMap<String, Shape>,
) -> Result<Option<Known>, String> {
    let op = node.op;
    if op == "Constant" {
        return constant(node).map(|k| Option::Some(k));
    }
    if op == "Shape" {
        return shape_of(node, known, shapes).map(|k| Option::Some(k));
    }
    let mut operands: List<Known> = [];
    for let input of node.inputs {
        if input == "" {
            continue;
        }
        let Some(k) = known.get(input) else {
            return Result::Ok(null);
        };
        operands.push(k);
    }
    if operands.is_empty() {
        return Result::Ok(null);
    }
    let x = &operands[0];
    let folded = match op.as_str_slice() {
        "Identity" => *x,
        "Gather" => gather(x, &operands[1], int_attr(node, "axis", 0)?)?,
        "Reshape" | "Unsqueeze" | "Squeeze" => regrouped(node, known, x)?,
        "Concat" => concat(&operands, required_int_attr(node, "axis")?)?,
        "ConstantOfShape" => {
            return constant_of_shape(node, x);
        },
        "Add" | "Sub" | "Mul" | "Div" | "Pow" => arithmetic(node, x, &operands[1])?,
        "Slice" => {
            return slice(x, node, known);
        },
        "Cast" => {
            return cast(x, int_attr(node, "to", 0)?);
        },
        "Range" => {
            return range(x, &operands[1], &operands[2]);
        },
        _ => {
            return Result::Ok(null);
        },
    };
    return Result::Ok(Option::Some(folded));
}

/// A known tensor regrouped. It holds a number of elements, so a target that
/// leaves an extent symbolic cannot take them.
fn regrouped(node: &Node, known: &TreeMap<String, Known>, x: &Known) -> Result<Known, String> {
    let input: List<Extent> = x.extents.into_iter().map(|e| Extent::Static(e)).collect();
    let mut extents: List<i32> = [];
    // Only a symbolic target owes, and one leaves an extent symbolic below.
    let mut owed: List<Condition> = [];
    for let e of regrouped_extents(node, known, &input, &mut owed)? {
        let Static(n) = e else {
            return Result::Err(`extent ${e} of the target leaves ${x.len()} elements no fixed shape`);
        };
        extents.push(n);
    }
    assert owed.is_empty();
    return Result::Ok(Known { ..*x, extents });
}

/// The extents a regrouping gives `input`: `Reshape`'s target, or `input` with
/// the unit axes `Unsqueeze` adds or `Squeeze` drops. `owed` gains what the
/// regrouping relies on and cannot prove.
pub fn regrouped_extents(
    node: &Node,
    known: &TreeMap<String, Known>,
    input: &List<Extent>,
    owed: &mut List<Condition>,
) -> Result<List<Extent>, String> {
    return match node.op.as_str_slice() {
        "Reshape" => reshape_extents(
            &polys_at(node, known, 1, "shape")?.ok_or("the target shape is absent")?,
            input,
            int_attr(node, "allowzero", 0)? != 0,
            owed,
            &node.site(),
        ),
        "Unsqueeze" | "Squeeze" => {
            let carried = carried_axes(node, known, input)?;
            Result::Ok(carried.into_iter().map(|c| if let Some(i) = c {
                input[i];
            } else {
                Extent::Static(1);
            }).collect());
        },
        _ => unreachable(),
    };
}

/// A `Reshape` target as ONNX reads it: `0` copies the input's extent at that
/// position unless `allowzero` is set, and one `-1` is what the rest leave.
/// The target holds as many elements as the input for every value of the
/// symbols, or once its derived symbols are read as `Poly::presumed` reads
/// them, or where a `-1` the build cannot divide out divides exactly, which
/// `owed` gains for the node `site` names; else the build cannot show the
/// reshape sound.
fn reshape_extents(
    written: &List<Poly>,
    input: &List<Extent>,
    allow_zero: bool,
    owed: &mut List<Condition>,
    site: &String,
) -> Result<List<Extent>, String> {
    let total = count_of(input).expect("`held` or a known tensor bounded the operand's count");
    let mut extents: List<Extent> = [];
    let mut inferred = -1;
    for let [i, w] of written.into_iter().enumerate() {
        if *w == Poly::constant(-1) && inferred < 0 {
            inferred = i;
            extents.push(Extent::Static(1));
            continue;
        }
        if *w == Poly::constant(0) && !allow_zero && i < input.len() {
            extents.push(input[i]);
            continue;
        }
        let e = if w.is_nonnegative() { Extent::of(*w) } else { null };
        let Some(extent) = e else {
            return Result::Err(`the target shape holds ${*w}`);
        };
        if !allow_zero && w.as_constant() matches { None } {
            owe_not_zero(w, input.get(i), owed, site)?;
        }
        extents.push(extent);
    }
    if !fits(&extents) {
        return Result::Err(`the target shape ${spelled(written)} multiplies past what a list can hold`);
    }
    let stated = count_of(&extents).unwrap();
    if inferred >= 0 {
        // ONNX finds no extent for a `-1` beside extents multiplying to 0.
        let rest = `the target's extents besides -1 multiply to ${stated}`;
        let above_zero = stated.try_sub(&Poly::constant(1)).ok_or(`${stated} - 1 leaves i64`)?;
        owe(owed, site, &above_zero, `${rest}, which must not be 0`)?;
        let q = Poly::floor_div(&total, &stated, site);
        extents[inferred] = Extent::of(q).ok_or(`${total} / ${stated} is more than a list holds`)?;
        // The quotient rounds down, so the shortfall is at most 0; the inputs
        // owe that it is 0.
        let shortfall = count_of(&extents).unwrap().try_sub(&total).ok_or(`${stated} * ${q} leaves i64`)?;
        owe(owed, site, &shortfall, `${rest}, which must divide ${total}`)?;
        return Result::Ok(extents);
    }
    if excess(&extents, &total, owed) != Option::Some(Poly::constant(0)) {
        return Result::Err(`${total} elements cannot take the shape ${spelled(written)}`);
    }
    return Result::Ok(extents);
}

/// What a symbolic target extent `w` owes. It is read as written, which is
/// ONNX's reading save where it is 0: without `allowzero`, ONNX then reads
/// the input's extent at that position, `copied`. So `w` owes that it is not
/// 0, unless `copied` is the same length, or reads as it under what
/// `Extent::agreement` owes.
fn owe_not_zero(w: &Poly, copied: Option<Extent>, owed: &mut List<Condition>, site: &String) -> Result<(), String> {
    if let Some(e) = copied && let Some(agreed) = e.agreement(&Extent::Symbolic(*w)) {
        owed.extend(&agreed);
        return Result::Ok(());
    }
    let instead = match copied {
        Some(e) => `which reads the input's extent ${e} instead`,
        None => "which ONNX reads nowhere past the input's axes",
    };
    let above_zero = w.try_sub(&Poly::constant(1)).ok_or(`${*w} - 1 leaves i64`)?;
    return owe(owed, site, &above_zero, `the target's ${*w} must not be 0, ${instead}`);
}

/// How many more elements `extents` hold than `total`, read as `Poly::presumed`
/// reads it, or `None` where no polynomial holds that.
fn excess(extents: &List<Extent>, total: &Poly, owed: &mut List<Condition>) -> Option<Poly> {
    return count_of(extents)?.try_sub(total)?.presumed(owed);
}

/// The elements a tensor of `extents` holds, which the caller has shown
/// stated, or `None` where no polynomial holds the product.
pub fn count_of(extents: &List<Extent>) -> Option<Poly> {
    let mut p = Poly::constant(1);
    for let e of *extents {
        p = p.try_mul(&e.poly())?;
    }
    return Option::Some(p);
}

/// Whether the extents a shape states multiply within what a list can hold,
/// and all of them into a polynomial stage 0 can compare. A symbolic extent can
/// only raise the product, so the stated ones decide the first.
pub fn fits(extents: &List<Extent>) -> bool {
    let mut stated: List<i32> = [];
    for let e of *extents {
        if let Static(n) = e {
            stated.push(n);
        }
    }
    return checked_element_count(&stated) matches { Some(_) } && count_of(extents) matches { Some(_) };
}

fn spelled(values: &List<Poly>) -> String {
    let texts: List<String> = values.into_iter().map(|p| `${p}`).collect();
    return `[${texts.join(", ")}]`;
}

fn constant(node: &Node) -> Result<Known, String> {
    if let Some(a) = node.attr("value") && let Some(t) = a.tensor {
        return Result::Ok(t);
    }
    if node.attr("value_int") matches { Some(_) } {
        return Result::Ok(Known { extents: [], elements: Elements::Ints([int_attr(node, "value_int", 0)?]) });
    }
    if let Some(a) = node.attr("value_ints") {
        let values = a.ints().map_err(|e| `${e}`)?;
        return Result::Ok(Known {
            extents: [values.len()],
            elements: Elements::Ints(values),
        });
    }
    if node.attr("value_float") matches { Some(_) } {
        let v = node.float_attr("value_float", 0.0).map_err(|e| `${e}`)?;
        return Result::Ok(Known { extents: [], elements: Elements::Floats([v]) });
    }
    if let Some(a) = node.attr("value_floats") {
        let values = a.floats().map_err(|e| `${e}`)?;
        return Result::Ok(Known {
            extents: [values.len()],
            elements: Elements::Floats(values),
        });
    }
    return Result::Err("the value is none this reader carries");
}

/// `Shape`, whose elements are symbolic where the operand's extents are.
fn shape_of(node: &Node, known: &TreeMap<String, Known>, shapes: &TreeMap<String, Shape>) -> Result<Known, String> {
    let input = node.inputs[0];
    let extents: List<Poly> = match known.get(input) {
        Some(k) => k.extents.into_iter().map(|e| Poly::constant(e as i64)).collect(),
        None => shapes.get(input).unwrap().axes.into_iter().map(|a| a.extent.poly()).collect(),
    };
    let rank = extents.len() as i64;
    let start = clamped(int_attr(node, "start", 0)?, rank, 0, rank);
    let end = clamped(int_attr(node, "end", rank)?, rank, 0, rank);
    let mut values: List<Poly> = [];
    for let i of start..<i64::max(start, end) {
        values.push(extents[i as i32]);
    }
    return Result::Ok(Known {
        extents: [values.len()],
        elements: Elements::integers(values),
    });
}

/// `i` resolved against `extent`, then held within `[lo, hi]`. An empty axis
/// read backwards gives the empty `[0, -1]`, which yields `hi`, so the slice
/// starts where it ends and holds nothing.
fn clamped(i: i64, extent: i64, lo: i64, hi: i64) -> i64 {
    return i64::min(i64::max(from_end(i, extent), lo), hi);
}

fn gather(data: &Known, indices: &Known, axis: i64) -> Result<Known, String> {
    let rank = data.extents.len();
    let a = axis_index(axis, rank)?;
    let along = data.extents[a];
    let leading = data.extents[0..<a].to_list();
    let trailing = data.extents[a + 1..<rank].to_list();
    let inner = element_count(&trailing);
    let wanted = ints_of(indices)?;
    let mut picks: List<i32> = [];
    for let o of 0..<element_count(&leading) {
        for let index of wanted {
            let i = from_end(index, along as i64);
            if !(0 <= i < along as i64) {
                return Result::Err(`index ${index} is outside an axis of ${along}`);
            }
            for let n of 0..<inner {
                picks.push((o * along + i as i32) * inner + n);
            }
        }
    }
    let mut extents = leading;
    extents.extend(&indices.extents);
    extents.extend(&trailing);
    return Result::Ok(Known { ..*data, extents, elements: picked(&data.elements, &picks) });
}

/// For each output axis of an `Unsqueeze` or `Squeeze`, the operand axis it
/// carries, or `None` for one `Unsqueeze` inserts. Neither moves an axis, so
/// unlike a `Reshape` neither leaves its axes to be told apart by extent.
pub fn carried_axes(
    node: &Node,
    known: &TreeMap<String, Known>,
    input: &List<Extent>,
) -> Result<List<Option<i32>>, String> {
    return match node.op.as_str_slice() {
        "Unsqueeze" => unsqueezed(input.len(), &axes_of(node, known, 1, "axes")?.ok_or("axes is absent")?),
        "Squeeze" => squeezed(input, axes_of(node, known, 1, "axes")?),
        _ => unreachable(),
    };
}

/// `Unsqueeze`'s output axes: the operand's `rank` with one inserted at each
/// of `axes`, which count the output's axes.
fn unsqueezed(rank: i32, axes: &List<i64>) -> Result<List<Option<i32>>, String> {
    let out = rank + axes.len();
    let mut inserted = List::<bool>::filled(out, false);
    for let i of axis_indices(axes, out)? {
        inserted[i] = true;
    }
    let mut carried: List<Option<i32>> = [];
    let mut next = 0;
    for let i of 0..<out {
        if inserted[i] {
            carried.push(null);
        } else {
            carried.push(Option::Some(next));
            next += 1;
        }
    }
    return Result::Ok(carried);
}

/// `Squeeze`'s output axes: `input` without the listed axes, each of which
/// must be 1, or without every 1 where none is listed.
fn squeezed(input: &List<Extent>, axes: Option<List<i64>>) -> Result<List<Option<i32>>, String> {
    let rank = input.len();
    let mut dropped = List::<bool>::filled(rank, false);
    match axes {
        Some(listed) => {
            for let i of axis_indices(&listed, rank)? {
                if !input[i].is_one() {
                    return Result::Err(`axis ${i} has extent ${input[i]}, not 1`);
                }
                dropped[i] = true;
            }
        },
        None => {
            for let i of 0..<rank {
                dropped[i] = input[i].is_one();
            }
        },
    }
    let mut carried: List<Option<i32>> = [];
    for let i of 0..<rank {
        if !dropped[i] {
            carried.push(Option::Some(i));
        }
    }
    return Result::Ok(carried);
}

fn concat(parts: &List<Known>, axis: i64) -> Result<Known, String> {
    let first = &parts[0];
    let rank = first.extents.len();
    let a = axis_index(axis, rank)?;
    let outer = element_count(&first.extents[0..<a].to_list());
    let mut offsets: List<i32> = [];
    let mut joined = 0;
    let mut along = 0;
    for let p of *parts {
        if p.extents.len() != rank
            || p.extents[0..<a] != first.extents[0..<a]
            || p.extents[a + 1..<rank] != first.extents[a + 1..<rank] {
            return Result::Err(
                `operands of extents ${first.extents:?} and ${p.extents:?} do not join along axis ${axis}`,
            );
        }
        offsets.push(joined);
        joined += p.len();
        along += p.extents[a];
    }
    let mut picks: List<i32> = [];
    for let o of 0..<outer {
        for let [i, p] of parts.into_iter().enumerate() {
            let block = p.len() / outer;
            for let n of 0..<block {
                picks.push(offsets[i] + o * block + n);
            }
        }
    }
    let mut extents = first.extents;
    extents[a] = along;
    return Result::Ok(Known { ..*first, extents, elements: picked(&joined_elements(parts)?, &picks) });
}

/// A `Slice`'s operands: one start, end, axis and step per axis it lists. A
/// start or an end may be symbolic.
pub struct SliceBounds {
    pub starts: List<Poly>,
    pub ends: List<Poly>,
    pub axes: List<i64>,
    pub steps: List<i64>,
}

/// The operands of `Slice` `node`, with ONNX's defaults filled in: the leading
/// axes where it lists none, and a step of 1.
pub fn slice_bounds(node: &Node, known: &TreeMap<String, Known>) -> Result<SliceBounds, String> {
    let starts = polys_at(node, known, 1, "starts")?.ok_or("starts is absent")?;
    let ends = polys_at(node, known, 2, "ends")?.ok_or("ends is absent")?;
    let sliced = starts.len();
    let axes = match axes_of(node, known, 3, "axes")? {
        Some(listed) => listed,
        None => (0..<sliced).map(|i| i as i64).collect(),
    };
    let steps = axes_of(node, known, 4, "steps")?.unwrap_or(List::<i64>::filled(sliced, 1));
    if ends.len() != sliced || axes.len() != sliced || steps.len() != sliced {
        return Result::Err(
            `${sliced} starts, ${ends.len()} ends, ${axes.len()} axes and ${steps.len()} steps do not pair up`,
        );
    }
    return Result::Ok(SliceBounds { starts, ends, axes, steps });
}

/// `Slice` of a known tensor, or `None` where a bound only the run knows
/// leaves the slice to it.
fn slice(x: &Known, node: &Node, known: &TreeMap<String, Known>) -> Result<Option<Known>, String> {
    let rank = x.extents.len();
    let SliceBounds { starts, ends, axes, steps } = slice_bounds(node, known)?;
    let [Some(starts), Some(ends)] = [
        numbers(&starts),
        numbers(&ends),
    ] else {
        return Result::Ok(null);
    };
    let mut begin = List::<i64>::filled(rank, 0);
    let mut step = List::<i64>::filled(rank, 1);
    let mut extents = x.extents;
    for let [i, a] of axis_indices(&axes, rank)?.into_iter().enumerate() {
        let dim = x.extents[a] as i64;
        let s = steps[i];
        if s == 0 {
            return Result::Err("a step is 0");
        }
        let b = if s > 0 { clamped(starts[i], dim, 0, dim) } else { clamped(starts[i], dim, 0, dim - 1) };
        let e = if s > 0 { clamped(ends[i], dim, 0, dim) } else { clamped(ends[i], dim, -1, dim - 1) };
        begin[a] = b;
        step[a] = s;
        let count = steps_over(b, e, s);
        assert count <= dim as i128;
        extents[a] = count as i32;
    }
    let mut picks: List<i32> = [];
    let strides = stretched_strides(&x.extents, rank);
    for let n of 0..<element_count(&extents) {
        let mut rest = n;
        let mut at = 0;
        for let mut a = rank - 1; a >= 0; a -= 1 {
            let index = begin[a] + (rest % extents[a]) as i64 * step[a];
            // An extent-1 axis has stride 0 here, and only index 0 to read.
            at += index as i32 * strides[a];
            rest /= extents[a];
        }
        picks.push(at);
    }
    return Result::Ok(Option::Some(Known { ..*x, extents, elements: picked(&x.elements, &picks) }));
}

/// `Cast` to float, int32, int64 or bool. A float becomes an integer by
/// truncation toward zero, `in_width` takes an int32's low 32 bits, and
/// anything nonzero becomes `true`. A symbolic integer stays one. The run
/// converts one to anything else.
fn cast(x: &Known, to: i64) -> Result<Option<Known>, String> {
    let target = data_type(to);
    let stored = if target matches { Some(Int32) } { Stored::Int32 } else { Stored::Computed };
    if x.elements matches { Symbolic(_) } {
        return Result::Ok(if target matches { Some(Int32 | Int64) } {
            Option::Some(Known { ..*x, stored });
        } else {
            null;
        });
    }
    let count = x.len();
    let elements = match target {
        Some(Float) => {
            let mut out = List::<f32>::with_capacity(count);
            for let i of 0..<count {
                out.push(as_float(&x.elements, i));
            }
            Elements::Floats(out);
        },
        Some(Int32 | Int64) => {
            let mut out = List::<i64>::with_capacity(count);
            for let i of 0..<count {
                out.push(as_int(&x.elements, i));
            }
            Elements::Ints(out);
        },
        Some(Bool) => {
            let mut out = List::<bool>::with_capacity(count);
            for let i of 0..<count {
                out.push(as_float(&x.elements, i) != 0.0);
            }
            Elements::Bools(out);
        },
        _ => {
            return Result::Err(`\`to\` is element type ${to}, which the build does not compute in`);
        },
    };
    return Result::Ok(Option::Some(Known { extents: x.extents, elements, stored }));
}

/// Element `i` as a float. `cast` has taken the symbolic case already.
fn as_float(elements: &Elements, i: i32) -> f32 {
    return match elements {
        Ints(v) => v[i] as f32,
        Symbolic(_) => unreachable(),
        Floats(v) => v[i],
        Bools(v) => if v[i] { 1.0 } else { 0.0 },
    };
}

/// Element `i` as an integer. `cast` has taken the symbolic case already.
fn as_int(elements: &Elements, i: i32) -> i64 {
    return match elements {
        Ints(v) => v[i],
        Symbolic(_) => unreachable(),
        Floats(v) => v[i] as i64,
        Bools(v) => if v[i] { 1 } else { 0 },
    };
}

/// How many steps of `step` fit from `from` to `to`, as `Slice` and `Range`
/// count them: the last may fall short, and a span running against the step
/// holds none. Wide, since the span and the count of any two `i64` do not fit
/// one.
fn steps_over(from: i64, to: i64, step: i64) -> i128 {
    assert step != 0;
    let [span, s] = [to as i128 - from as i128, step as i128];
    return i128::max(if s > 0 { ceiling(span, s) } else { ceiling(-span, -s) }, 0);
}

/// The refusal of a tensor of `count` elements, where that is more than a list holds.
fn too_many(count: i128) -> Result<(), String> {
    if count > i32::MAX as i128 {
        return Result::Err(`${count} elements are more than a list holds`);
    }
    return Result::Ok(());
}

/// `Range`, or `None` where a bound only the run knows leaves it to the run.
fn range(start: &Known, limit: &Known, delta: &Known) -> Result<Option<Known>, String> {
    if start.len() != 1 || limit.len() != 1 || delta.len() != 1 {
        return Result::Err("start, limit and delta are not each one element");
    }
    return match [&start.elements, &limit.elements, &delta.elements] {
        [Ints(s), Ints(l), Ints(d)] => {
            let [s, l, d] = [s[0], l[0], d[0]];
            if d == 0 {
                return Result::Err("delta is 0");
            }
            let count = steps_over(s, l, d);
            too_many(count)?;
            let mut values: List<i64> = [];
            for let i of 0..<count as i32 {
                // Wide, since `i * d` may leave i64 where the value does not.
                let v = s as i128 + i as i128 * d as i128;
                assert i128::min(s as i128, l as i128) <= v <= i128::max(s as i128, l as i128);
                values.push(v as i64);
            }
            Result::Ok(Option::Some(Known {
                extents: [values.len()],
                elements: Elements::Ints(values),
                stored: start.stored,
            }));
        },
        [Floats(s), Floats(l), Floats(d)] => {
            let [s, l, d] = [s[0], l[0], d[0]];
            if d == 0.0 {
                return Result::Err("delta is 0");
            }
            let wide = f32::max(f32::ceil((l - s) / d), 0.0);
            if wide.is_nan() {
                return Result::Err(`${s} to ${l} by ${d} counts no number of elements`);
            }
            // A float past `i128` converts to its largest, which is too many as well.
            too_many(wide as i128)?;
            let count = wide as i32;
            let mut values: List<f32> = [];
            for let i of 0..<count {
                values.push(s + i as f32 * d);
            }
            Result::Ok(Option::Some(Known {
                extents: [count],
                elements: Elements::Floats(values),
            }));
        },
        _ => {
            if integer_polys(&start.elements) matches { Some(_) }
                && integer_polys(&limit.elements) matches { Some(_) }
                && integer_polys(&delta.elements) matches { Some(_) } {
                return Result::Ok(null);
            }
            Result::Err("start, limit and delta are not one element type");
        },
    };
}

/// `ConstantOfShape` of a shape the build knows every number of, or `None`
/// where a symbol stands for one and the run fills it.
fn constant_of_shape(node: &Node, shape: &Known) -> Result<Option<Known>, String> {
    let Some(values) = numbers(&polys_of(shape)?) else {
        return Result::Ok(null);
    };
    let mut extents: List<i32> = [];
    for let e of values {
        if !(0 <= e <= i32::MAX as i64) {
            return Result::Err(`the shape holds ${e}`);
        }
        extents.push(e as i32);
    }
    let fill = fill_of(node).map_err(|e| `${e}`)?;
    let count = element_count(&extents);
    return Result::Ok(Option::Some(Known { ..fill, extents, elements: picked(&fill.elements, &List::<i32>::filled(
        count,
        0,
    )) }));
}

/// The one element a `ConstantOfShape` fills with: its `value`, or a float 0.
pub fn fill_of(node: &Node) -> Result<Known, AttrError> {
    let Some(a) = node.attr("value") else {
        return Result::Ok(Known {
            extents: [1],
            elements: Elements::Floats([0.0]),
        });
    };
    let Some(t) = a.tensor else {
        return Result::Err(AttrError { attr: a.name, reason: "holds no tensor the build reads" });
    };
    let count = element_count(&t.extents);
    if count != 1 {
        return Result::Err(AttrError {
            attr: a.name,
            reason: `holds ${count} elements, and the operator fills with one`,
        });
    }
    return Result::Ok(t);
}

fn arithmetic(node: &Node, a: &Known, b: &Known) -> Result<Known, String> {
    let op = &node.op;
    let b_extents = aligned_extents(node, &a.extents, &b.extents)?;
    let Some(extents) = broadcast_extents(&a.extents, &b_extents) else {
        return Result::Err(`operands of extents ${a.extents:?} and ${b.extents:?} do not broadcast`);
    };
    let x = picked(&a.elements, &positions(&a.extents, &extents));
    let y = picked(&b.elements, &positions(&b_extents, &extents));
    let elements = match [&x, &y] {
        [Floats(l), Floats(r)] => {
            let mut out: List<f32> = [];
            for let i of 0..<l.len() {
                out.push(float_op(op, l[i], r[i]));
            }
            Elements::Floats(out);
        },
        _ => {
            let [Some(l), Some(r)] = [
                integer_polys(&x),
                integer_polys(&y),
            ] else {
                return Result::Err("the operands are not one element type the build computes in");
            };
            let mut out: List<Poly> = [];
            let site = node.site();
            for let i of 0..<l.len() {
                out.push(poly_op(op, &l[i], &r[i], &site)?);
            }
            Elements::integers(out);
        },
    };
    // ONNX computes in the operands' one element type.
    return Result::Ok(Known { extents, elements, stored: a.stored });
}

/// B's extents, followed by an extent of 1 for each of A's axes after it where
/// the node aligns B at an axis, so that broadcasting from the end stretches it.
fn aligned_extents(node: &Node, a: &List<i32>, b: &List<i32>) -> Result<List<i32>, String> {
    return Result::Ok(followed_by_units(b, trailing_axes(node, a.len(), b.len())?));
}

/// Integer arithmetic, where a symbol may stand for an operand, as the node
/// `site` names computes it. ONNX's quotient truncates toward zero, which a
/// symbolic one takes as rounding down: a dividend not negative for any input,
/// over a positive number, since a symbol may be 0.
fn poly_op(op: &String, l: &Poly, r: &Poly, site: &String) -> Result<Poly, String> {
    let overflow = `${*l} ${*op} ${*r} leaves i64`;
    return match op.as_str_slice() {
        "Add" => in_int64(l.try_add(r), overflow),
        "Sub" => in_int64(l.try_sub(r), overflow),
        "Mul" => in_int64(l.try_mul(r), overflow),
        "Div" => quotient(l, r, site, overflow),
        _ => Result::Err(`${*op} of integers is not evaluated`),
    };
}

fn quotient(l: &Poly, r: &Poly, site: &String, overflow: String) -> Result<Poly, String> {
    if r.as_constant() == Option::Some(0) {
        return Result::Err(`${*l} / 0 divides by zero`);
    }
    if let [Some(n), Some(d)] = [
        l.as_constant(),
        r.as_constant(),
    ] {
        if n == i64::MIN && d == -1 {
            return Result::Err(overflow);
        }
        return Result::Ok(Poly::constant(n / d));
    }
    if !l.is_nonnegative() || !r.as_constant() matches { Some(d) && d > 0 } {
        return Result::Err(
            `${*l} / ${*r} truncates, which the build computes only for a dividend never negative over a positive number`,
        );
    }
    return Result::Ok(Poly::floor_div(l, r, site));
}

/// An int64 the graph computed, or `overflow` where no polynomial holds it or
/// some input carries it past i64, where ONNX's int64 wraps and it does not.
fn in_int64(exact: Option<Poly>, overflow: String) -> Result<Poly, String> {
    return match exact {
        Some(v) && v.fits_i64() => Result::Ok(v),
        _ => Result::Err(overflow),
    };
}

/// Integer elements as polynomials, symbolic or not; `None` for any other.
fn integer_polys(elements: &Elements) -> Option<List<Poly>> {
    return match elements {
        Ints(v) => Option::Some(v.into_iter().map(|c| Poly::constant(*c)).collect()),
        Symbolic(v) => Option::Some(*v),
        _ => null,
    };
}

fn float_op(op: &String, l: f32, r: f32) -> f32 {
    return match op.as_str_slice() {
        "Add" => l + r,
        "Sub" => l - r,
        "Mul" => l * r,
        "Div" => l / r,
        _ => f32::pow(l, r),
    };
}

/// For each element of a tensor of `out` extents, the element a tensor of
/// `extents` broadcast to it reads.
fn positions(extents: &List<i32>, out: &List<i32>) -> List<i32> {
    let strides = stretched_strides(extents, out.len());
    let mut at: List<i32> = [];
    for let n of 0..<element_count(out) {
        let mut rest = n;
        let mut p = 0;
        for let mut a = out.len() - 1; a >= 0; a -= 1 {
            p += rest % out[a] * strides[a];
            rest /= out[a];
        }
        at.push(p);
    }
    return at;
}

fn picked(elements: &Elements, at: &List<i32>) -> Elements {
    return match elements {
        Ints(v) => Elements::Ints(pick(v, at)),
        Symbolic(v) => Elements::integers(pick(v, at)),
        Floats(v) => Elements::Floats(pick(v, at)),
        Bools(v) => Elements::Bools(pick(v, at)),
    };
}

fn pick<T>(values: &List<T>, at: &List<i32>) -> List<T> {
    let mut out = List::<T>::with_capacity(at.len());
    for let i of *at {
        out.push(values[i]);
    }
    return out;
}

/// The operands' elements back to back. Integers join as polynomials where any
/// operand is symbolic, as a `Reshape` target built from a `Shape` is.
fn joined_elements(parts: &List<Known>) -> Result<Elements, String> {
    let mut joined = parts[0].elements;
    for let i of 1..<parts.len() {
        match [&mut joined, &parts[i].elements] {
            [Ints(a), Ints(b)] => a.extend(b),
            [Floats(a), Floats(b)] => a.extend(b),
            [Bools(a), Bools(b)] => a.extend(b),
            [a, b] => {
                let [Some(l), Some(r)] = [
                    integer_polys(a),
                    integer_polys(b),
                ] else {
                    return Result::Err("the operands are not one element type");
                };
                let mut values = l;
                values.extend(&r);
                *a = Elements::integers(values);
            },
        }
    }
    return Result::Ok(joined);
}

fn polys_of(k: &Known) -> Result<List<Poly>, String> {
    return integer_polys(&k.elements).ok_or("an operand read as integers is not an integer tensor");
}

fn ints_of(k: &Known) -> Result<List<i64>, String> {
    let values = polys_of(k)?;
    return numbers(&values).ok_or(`an operand read as numbers holds ${spelled(&values)}, which only the run knows`);
}

/// The numbers `values` holds, or `None` where a symbol stands for one.
fn numbers(values: &List<Poly>) -> Option<List<i64>> {
    let mut out: List<i64> = [];
    for let v of *values {
        out.push(v.as_constant()?);
    }
    return Option::Some(out);
}

/// The integers an operator reads from operand `index`, or from the attribute
/// `attr` an opset before 13 wrote them in. `None` where neither is given.
pub fn axes_of(
    node: &Node,
    known: &TreeMap<String, Known>,
    index: i32,
    attr: String,
) -> Result<Option<List<i64>>, String> {
    if index < node.inputs.len() && node.inputs[index] != "" {
        return ints_of(&operand_known(node, known, index)?).map(|v| Option::Some(v));
    }
    let Some(a) = node.attr(attr) else {
        return Result::Ok(null);
    };
    return a.ints().map(|v| Option::Some(v)).map_err(|e| `${e}`);
}

/// The integers operand `index` holds, which the operator requires and the
/// build must know, symbolic or not.
pub fn operand_polys(node: &Node, known: &TreeMap<String, Known>, index: i32) -> Result<List<Poly>, String> {
    return polys_of(&operand_known(node, known, index)?);
}

/// `axes_of` for an operand that may hold a symbol: a `Reshape` target, or a
/// `Slice` bound.
pub fn polys_at(
    node: &Node,
    known: &TreeMap<String, Known>,
    index: i32,
    attr: String,
) -> Result<Option<List<Poly>>, String> {
    if index < node.inputs.len() && node.inputs[index] != "" {
        return operand_polys(node, known, index).map(|v| Option::Some(v));
    }
    return axes_of(node, known, index, attr).map(
        |read| read.map(|v| v.into_iter().map(|c| Poly::constant(c)).collect()),
    );
}

fn operand_known(node: &Node, known: &TreeMap<String, Known>, index: i32) -> Result<Known, String> {
    return known.get(node.inputs[index]).ok_or(
        `operand ${node.inputs[index]} is computed at run time, and the build reads it`,
    );
}

fn int_attr(node: &Node, name: String, fallback: i64) -> Result<i64, String> {
    return node.int_attr(name, fallback).map_err(|e| `${e}`);
}

/// `int_attr` for an attribute ONNX gives no default.
fn required_int_attr(node: &Node, name: String) -> Result<i64, String> {
    let Some(a) = node.attr(name) else {
        return Result::Err(`attribute ${name} is absent and the operator reads it`);
    };
    return a.int().map_err(|e| `${e}`);
}

fn axis_index(axis: i64, rank: i32) -> Result<i32, String> {
    let i = from_end(axis, rank as i64);
    if !(0 <= i < rank as i64) {
        return Result::Err(`axis ${axis} is outside rank ${rank}`);
    }
    return Result::Ok(i as i32);
}

/// Each of `axes` resolved against `rank`. ONNX leaves a list that names an
/// axis twice undefined, so one stops the build.
pub fn axis_indices(axes: &List<i64>, rank: i32) -> Result<List<i32>, String> {
    let mut resolved: List<i32> = [];
    for let axis of *axes {
        let i = axis_index(axis, rank)?;
        if resolved.contains(&i) {
            return Result::Err(`axis ${axis} is listed twice`);
        }
        resolved.push(i);
    }
    return Result::Ok(resolved);
}
