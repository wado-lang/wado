//! Stage 0's evaluation of what a graph computes from what the build knows:
//! the shape arithmetic an exporter writes, and the constants it reaches.

use { TreeMap } from "core:collections";
use { Extent } from "./extent.wado";
use { Elements, Known, Node } from "./graph.wado";
use { Poly } from "./poly.wado";
use { broadcast_extents, checked_element_count, element_count, stretched_strides } from "./runtime/tensor.wado";
use { Shape } from "./shape.wado";

/// The tensor `node` produces when every operand it reads is known, or `None`
/// where the run computes it. `Err` says why the build cannot evaluate it.
pub fn fold(
    node: &Node,
    known: &TreeMap<String, Known>,
    shapes: &TreeMap<String, Shape>,
) -> Result<Option<Known>, String> {
    let op = node.op;
    if op == "Constant" {
        return constant(node).map(|k| Option::Some(k));
    }
    if op == "Shape" {
        return shape_of(node, known, shapes).map(|k| Option::Some(k));
    }
    let mut operands: List<Known> = [];
    for let input of node.inputs {
        if input == "" {
            continue;
        }
        let Some(k) = known.get(input) else {
            return Result::Ok(null);
        };
        operands.push(k);
    }
    if operands.is_empty() {
        return Result::Ok(null);
    }
    let x = &operands[0];
    return match op.as_str_slice() {
        "Identity" => Result::Ok(Option::Some(*x)),
        "Gather" => gather(x, &operands[1], int_attr(node, "axis", 0)?).map(|k| Option::Some(k)),
        "Reshape" | "Unsqueeze" | "Squeeze" => regrouped(node, known, x).map(|k| Option::Some(k)),
        "Concat" => concat(&operands, int_attr(node, "axis", 0)?).map(|k| Option::Some(k)),
        "Slice" => slice(x, node, known),
        "Cast" => cast(x, int_attr(node, "to", 0)?),
        "Range" => range(x, &operands[1], &operands[2]),
        "ConstantOfShape" => constant_of_shape(node, x).map(|k| Option::Some(k)),
        "Add" | "Sub" | "Mul" | "Div" | "Pow" => arithmetic(&op, x, &operands[1]).map(|k| Option::Some(k)),
        _ => Result::Ok(null),
    };
}

/// A known tensor regrouped. It holds a number of elements, so a target that
/// leaves an extent symbolic cannot take them.
fn regrouped(node: &Node, known: &TreeMap<String, Known>, x: &Known) -> Result<Known, String> {
    let input: List<Extent> = x.extents.into_iter().map(|e| Extent::Static(e)).collect();
    let mut extents: List<i32> = [];
    for let e of regrouped_extents(node, known, &input)? {
        let Static(n) = e else {
            return Result::Err(`extent ${e} of the target leaves ${x.len()} elements no fixed shape`);
        };
        extents.push(n);
    }
    return Result::Ok(Known { extents, elements: x.elements });
}

/// The extents a regrouping gives `input`: `Reshape`'s target, or `input` with
/// the unit axes `Unsqueeze` adds or `Squeeze` drops.
pub fn regrouped_extents(
    node: &Node,
    known: &TreeMap<String, Known>,
    input: &List<Extent>,
) -> Result<List<Extent>, String> {
    return match node.op.as_str_slice() {
        "Reshape" => reshape_extents(
            &polys_at(node, known, 1, "shape")?.ok_or("the target shape is absent")?,
            input,
            int_attr(node, "allowzero", 0)? != 0,
        ),
        "Unsqueeze" => unsqueezed(input, &axes_of(node, known, 1, "axes")?.ok_or("axes is absent")?),
        "Squeeze" => squeezed(input, axes_of(node, known, 1, "axes")?),
        _ => unreachable(),
    };
}

/// A `Reshape` target as ONNX reads it: `0` copies the input's extent at that
/// position unless `allowzero` is set, and one `-1` is what the rest leave.
/// The target holds as many elements as the input for every value of the
/// symbols, or the build cannot show the reshape sound.
fn reshape_extents(written: &List<Poly>, input: &List<Extent>, allow_zero: bool) -> Result<List<Extent>, String> {
    let total = count_of(input);
    let mut extents: List<Extent> = [];
    let mut inferred = -1;
    for let [i, w] of written.into_iter().enumerate() {
        if *w == Poly::constant(-1) && inferred < 0 {
            inferred = i;
            extents.push(Extent::Static(1));
            continue;
        }
        if *w == Poly::constant(0) && !allow_zero && i < input.len() {
            extents.push(input[i]);
            continue;
        }
        let e = if w.is_nonnegative() { Extent::of(*w) } else { null };
        let Some(extent) = e else {
            return Result::Err(`the target shape holds ${*w}`);
        };
        extents.push(extent);
    }
    if !fits(&extents) {
        return Result::Err(`the target shape ${spelled(written)} multiplies past what a list can hold`);
    }
    let stated = count_of(&extents);
    if inferred >= 0 && stated != Poly::constant(0) {
        if let Some(rest) = total.divided_by(&stated) && let Some(e) = Extent::of(rest) {
            extents[inferred] = e;
        }
    }
    if count_of(&extents) != total {
        return Result::Err(`${total} elements cannot take the shape ${spelled(written)}`);
    }
    return Result::Ok(extents);
}

/// The elements a tensor of `extents` holds, which the caller has shown stated.
pub fn count_of(extents: &List<Extent>) -> Poly {
    let mut p = Poly::constant(1);
    for let e of *extents {
        p = p.mul(&e.poly());
    }
    return p;
}

/// Whether the extents a shape states multiply within what a list can hold. A
/// symbolic extent can only raise the product, so the stated ones decide it.
pub fn fits(extents: &List<Extent>) -> bool {
    let mut stated: List<i32> = [];
    for let e of *extents {
        if let Static(n) = e {
            stated.push(n);
        }
    }
    return checked_element_count(&stated) matches { Some(_) };
}

fn spelled(values: &List<Poly>) -> String {
    let texts: List<String> = values.into_iter().map(|p| `${p}`).collect();
    return `[${texts.join(", ")}]`;
}

fn constant(node: &Node) -> Result<Known, String> {
    if let Some(a) = node.attr("value") && let Some(t) = a.tensor {
        return Result::Ok(t);
    }
    if node.attr("value_int") matches { Some(_) } {
        return Result::Ok(Known { extents: [], elements: Elements::Ints([int_attr(node, "value_int", 0)?]) });
    }
    if let Some(a) = node.attr("value_ints") {
        let values = a.ints().map_err(|e| `${e}`)?;
        return Result::Ok(Known {
            extents: [values.len()],
            elements: Elements::Ints(values),
        });
    }
    if node.attr("value_float") matches { Some(_) } {
        let v = node.float_attr("value_float", 0.0).map_err(|e| `${e}`)?;
        return Result::Ok(Known { extents: [], elements: Elements::Floats([v]) });
    }
    if let Some(a) = node.attr("value_floats") {
        let values = a.floats().map_err(|e| `${e}`)?;
        return Result::Ok(Known {
            extents: [values.len()],
            elements: Elements::Floats(values),
        });
    }
    return Result::Err("the value is none this reader carries");
}

/// `Shape`, whose elements are symbolic where the operand's extents are.
fn shape_of(node: &Node, known: &TreeMap<String, Known>, shapes: &TreeMap<String, Shape>) -> Result<Known, String> {
    let input = node.inputs[0];
    let extents: List<Poly> = match known.get(input) {
        Some(k) => k.extents.into_iter().map(|e| Poly::constant(e as i64)).collect(),
        None => shapes.get(input).unwrap().axes.into_iter().map(|a| a.extent.poly()).collect(),
    };
    let rank = extents.len() as i64;
    let start = clamped(int_attr(node, "start", 0)?, rank, 0, rank);
    let end = clamped(int_attr(node, "end", rank)?, rank, 0, rank);
    let mut values: List<Poly> = [];
    for let i of start..<i64::max(start, end) {
        values.push(extents[i as i32]);
    }
    return Result::Ok(Known {
        extents: [values.len()],
        elements: Elements::integers(values),
    });
}

/// `i` resolved against `extent`, then held within `[lo, hi]`.
fn clamped(i: i64, extent: i64, lo: i64, hi: i64) -> i64 {
    return i64::clamp(resolve_index(i, extent), lo, hi);
}

/// An ONNX index into `extent` positions, which counts from the end where negative.
pub fn resolve_index(i: i64, extent: i64) -> i64 {
    return if i < 0 { i + extent } else { i };
}

fn gather(data: &Known, indices: &Known, axis: i64) -> Result<Known, String> {
    let rank = data.extents.len();
    let a = axis_index(axis, rank)?;
    let along = data.extents[a];
    let leading = data.extents[0..<a].to_list();
    let trailing = data.extents[a + 1..<rank].to_list();
    let inner = element_count(&trailing);
    let wanted = ints_of(indices)?;
    let mut picks: List<i32> = [];
    for let o of 0..<element_count(&leading) {
        for let index of wanted {
            let i = resolve_index(index, along as i64);
            if !(0 <= i < along as i64) {
                return Result::Err(`index ${index} is outside an axis of ${along}`);
            }
            for let n of 0..<inner {
                picks.push((o * along + i as i32) * inner + n);
            }
        }
    }
    let mut extents = leading;
    extents.extend(&indices.extents);
    extents.extend(&trailing);
    return Result::Ok(Known { extents, elements: picked(&data.elements, &picks) });
}

/// `Unsqueeze`'s output extents: `input` with a 1 at each of `axes`, which
/// count the output's axes.
fn unsqueezed(input: &List<Extent>, axes: &List<i64>) -> Result<List<Extent>, String> {
    let rank = input.len() + axes.len();
    let mut inserted = List::<bool>::filled(rank, false);
    for let axis of *axes {
        let i = axis_index(axis, rank)?;
        if inserted[i] {
            return Result::Err(`axis ${axis} is listed twice`);
        }
        inserted[i] = true;
    }
    let mut extents: List<Extent> = [];
    let mut next = 0;
    for let i of 0..<rank {
        if inserted[i] {
            extents.push(Extent::Static(1));
        } else {
            extents.push(input[next]);
            next += 1;
        }
    }
    return Result::Ok(extents);
}

/// `Squeeze`'s output extents: `input` without the listed axes, each of which
/// must be 1, or without every 1 where none is listed.
fn squeezed(input: &List<Extent>, axes: Option<List<i64>>) -> Result<List<Extent>, String> {
    let rank = input.len();
    let mut dropped = List::<bool>::filled(rank, false);
    match axes {
        Some(listed) => {
            for let axis of listed {
                let i = axis_index(axis, rank)?;
                if !input[i].is_one() {
                    return Result::Err(`axis ${axis} has extent ${input[i]}, not 1`);
                }
                dropped[i] = true;
            }
        },
        None => {
            for let i of 0..<rank {
                dropped[i] = input[i].is_one();
            }
        },
    }
    let mut extents: List<Extent> = [];
    for let i of 0..<rank {
        if !dropped[i] {
            extents.push(input[i]);
        }
    }
    return Result::Ok(extents);
}

fn concat(parts: &List<Known>, axis: i64) -> Result<Known, String> {
    let first = &parts[0];
    let rank = first.extents.len();
    let a = axis_index(axis, rank)?;
    let outer = element_count(&first.extents[0..<a].to_list());
    let mut offsets: List<i32> = [];
    let mut joined = 0;
    let mut along = 0;
    for let p of *parts {
        if p.extents.len() != rank
            || p.extents[0..<a] != first.extents[0..<a]
            || p.extents[a + 1..<rank] != first.extents[a + 1..<rank] {
            return Result::Err(
                `operands of extents ${first.extents:?} and ${p.extents:?} do not join along axis ${axis}`,
            );
        }
        offsets.push(joined);
        joined += p.len();
        along += p.extents[a];
    }
    let mut picks: List<i32> = [];
    for let o of 0..<outer {
        for let [i, p] of parts.into_iter().enumerate() {
            let block = p.len() / outer;
            for let n of 0..<block {
                picks.push(offsets[i] + o * block + n);
            }
        }
    }
    let mut extents = first.extents;
    extents[a] = along;
    return Result::Ok(Known { extents, elements: picked(&joined_elements(parts)?, &picks) });
}

/// `Slice` of a known tensor, or `None` where a bound only the run knows
/// leaves the slice to it.
fn slice(x: &Known, node: &Node, known: &TreeMap<String, Known>) -> Result<Option<Known>, String> {
    let rank = x.extents.len();
    let Some(starts) = numbers(&polys_at(node, known, 1, "starts")?.ok_or("starts is absent")?) else {
        return Result::Ok(null);
    };
    let Some(ends) = numbers(&polys_at(node, known, 2, "ends")?.ok_or("ends is absent")?) else {
        return Result::Ok(null);
    };
    let mut axes: List<i64> = [];
    for let i of 0..<starts.len() {
        axes.push(i as i64);
    }
    if let Some(listed) = axes_of(node, known, 3, "axes")? {
        axes = listed;
    }
    let steps = axes_of(node, known, 4, "steps")?.unwrap_or(List::<i64>::filled(starts.len(), 1));
    let sliced = starts.len();
    if ends.len() != sliced || axes.len() != sliced || steps.len() != sliced {
        return Result::Err(
            `${sliced} starts, ${ends.len()} ends, ${axes.len()} axes and ${steps.len()} steps do not pair up`,
        );
    }
    let mut begin = List::<i64>::filled(rank, 0);
    let mut step = List::<i64>::filled(rank, 1);
    let mut extents = x.extents;
    for let i of 0..<starts.len() {
        let a = axis_index(axes[i], rank)?;
        let dim = x.extents[a] as i64;
        let s = steps[i];
        if s == 0 {
            return Result::Err("a step is 0");
        }
        let b = if s > 0 { clamped(starts[i], dim, 0, dim) } else { clamped(starts[i], dim, 0, dim - 1) };
        let e = if s > 0 { clamped(ends[i], dim, 0, dim) } else { clamped(ends[i], dim, -1, dim - 1) };
        let count = if s > 0 { (e - b + s - 1) / s } else { (b - e - s - 1) / -s };
        begin[a] = b;
        step[a] = s;
        extents[a] = i64::max(count, 0) as i32;
    }
    let mut picks: List<i32> = [];
    let strides = stretched_strides(&x.extents, rank);
    for let n of 0..<element_count(&extents) {
        let mut rest = n;
        let mut at = 0;
        for let mut a = rank - 1; a >= 0; a -= 1 {
            let index = begin[a] + (rest % extents[a]) as i64 * step[a];
            // An extent-1 axis has stride 0 here, and only index 0 to read.
            at += index as i32 * strides[a];
            rest /= extents[a];
        }
        picks.push(at);
    }
    return Result::Ok(Option::Some(Known { extents, elements: picked(&x.elements, &picks) }));
}

/// `Cast` to float, int32, int64 or bool. A float becomes an integer by
/// truncation toward zero, and anything nonzero becomes `true`. A symbolic
/// integer stays one, since an extent fits either width, and the run converts
/// it to anything else.
fn cast(x: &Known, to: i64) -> Result<Option<Known>, String> {
    if x.elements matches { Symbolic(_) } {
        return Result::Ok(if to == 6 || to == 7 { Option::Some(*x) } else { null });
    }
    let count = x.len();
    let elements = match to {
        1 => {
            let mut out = List::<f32>::with_capacity(count);
            for let i of 0..<count {
                out.push(as_float(&x.elements, i));
            }
            Elements::Floats(out);
        },
        6 | 7 => {
            let mut out = List::<i64>::with_capacity(count);
            for let i of 0..<count {
                let v = as_int(&x.elements, i);
                out.push(if to == 6 { v as i32 as i64 } else { v });
            }
            Elements::Ints(out);
        },
        9 => {
            let mut out = List::<bool>::with_capacity(count);
            for let i of 0..<count {
                out.push(as_float(&x.elements, i) != 0.0);
            }
            Elements::Bools(out);
        },
        _ => {
            return Result::Err(`\`to\` is element type ${to}, which the build does not compute in`);
        },
    };
    return Result::Ok(Option::Some(Known { extents: x.extents, elements }));
}

/// Element `i` as a float. `cast` has taken the symbolic case already.
fn as_float(elements: &Elements, i: i32) -> f32 {
    return match elements {
        Ints(v) => v[i] as f32,
        Symbolic(_) => unreachable(),
        Floats(v) => v[i],
        Bools(v) => if v[i] { 1.0 } else { 0.0 },
    };
}

/// Element `i` as an integer. `cast` has taken the symbolic case already.
fn as_int(elements: &Elements, i: i32) -> i64 {
    return match elements {
        Ints(v) => v[i],
        Symbolic(_) => unreachable(),
        Floats(v) => v[i] as i64,
        Bools(v) => if v[i] { 1 } else { 0 },
    };
}

/// `Range`, or `None` where a bound only the run knows leaves it to the run.
fn range(start: &Known, limit: &Known, delta: &Known) -> Result<Option<Known>, String> {
    if start.len() != 1 || limit.len() != 1 || delta.len() != 1 {
        return Result::Err("start, limit and delta are not each one element");
    }
    return match [&start.elements, &limit.elements, &delta.elements] {
        [Ints(s), Ints(l), Ints(d)] => {
            let [s, l, d] = [s[0], l[0], d[0]];
            if d == 0 {
                return Result::Err("delta is 0");
            }
            let count = i64::max(if d > 0 { (l - s + d - 1) / d } else { (s - l - d - 1) / -d }, 0);
            let mut values: List<i64> = [];
            for let i of 0..<count {
                values.push(s + i * d);
            }
            Result::Ok(Option::Some(Known {
                extents: [values.len()],
                elements: Elements::Ints(values),
            }));
        },
        [Floats(s), Floats(l), Floats(d)] => {
            let [s, l, d] = [s[0], l[0], d[0]];
            if d == 0.0 {
                return Result::Err("delta is 0");
            }
            let count = f32::max(f32::ceil((l - s) / d), 0.0) as i32;
            let mut values: List<f32> = [];
            for let i of 0..<count {
                values.push(s + i as f32 * d);
            }
            Result::Ok(Option::Some(Known {
                extents: [count],
                elements: Elements::Floats(values),
            }));
        },
        _ => {
            if integer_polys(&start.elements) matches { Some(_) }
                && integer_polys(&limit.elements) matches { Some(_) }
                && integer_polys(&delta.elements) matches { Some(_) } {
                return Result::Ok(null);
            }
            Result::Err("start, limit and delta are not one element type");
        },
    };
}

fn constant_of_shape(node: &Node, shape: &Known) -> Result<Known, String> {
    let mut extents: List<i32> = [];
    for let e of ints_of(shape)? {
        if !(0 <= e <= i32::MAX as i64) {
            return Result::Err(`the shape holds ${e}`);
        }
        extents.push(e as i32);
    }
    let mut fill = Known {
        extents: [1],
        elements: Elements::Floats([0.0]),
    };
    if let Some(a) = node.attr("value") && let Some(t) = a.tensor {
        fill = t;
    }
    let count = element_count(&extents);
    return Result::Ok(Known { extents, elements: picked(&fill.elements, &List::<i32>::filled(count, 0)) });
}

fn arithmetic(op: &String, a: &Known, b: &Known) -> Result<Known, String> {
    let Some(extents) = broadcast_extents(&a.extents, &b.extents) else {
        return Result::Err(`operands of extents ${a.extents:?} and ${b.extents:?} do not broadcast`);
    };
    let x = picked(&a.elements, &positions(&a.extents, &extents));
    let y = picked(&b.elements, &positions(&b.extents, &extents));
    let elements = match [&x, &y] {
        [Ints(l), Ints(r)] => {
            let mut out: List<i64> = [];
            for let i of 0..<l.len() {
                out.push(int_op(op, l[i], r[i])?);
            }
            Elements::Ints(out);
        },
        [Floats(l), Floats(r)] => {
            let mut out: List<f32> = [];
            for let i of 0..<l.len() {
                out.push(float_op(op, l[i], r[i]));
            }
            Elements::Floats(out);
        },
        _ => {
            let [Some(l), Some(r)] = [
                integer_polys(&x),
                integer_polys(&y),
            ] else {
                return Result::Err("the operands are not one element type the build computes in");
            };
            let mut out: List<Poly> = [];
            for let i of 0..<l.len() {
                out.push(poly_op(op, &l[i], &r[i])?);
            }
            Elements::integers(out);
        },
    };
    return Result::Ok(Known { extents, elements });
}

/// `int_op` where a symbol stands for an operand. A quotient is one the build
/// can show exact for every value of the symbols, which needs no rounding.
fn poly_op(op: &String, l: &Poly, r: &Poly) -> Result<Poly, String> {
    return match op.as_str_slice() {
        "Add" => Result::Ok(l.add(r)),
        "Sub" => Result::Ok(l.sub(r)),
        "Mul" => Result::Ok(l.mul(r)),
        "Div" => {
            let exact = if l.is_nonnegative() && r.is_nonnegative() { l.divided_by(r) } else { null };
            exact.ok_or(`${*l} / ${*r} is not a quotient the build can show exact`);
        },
        _ => Result::Err(`${*op} of integers is not evaluated`),
    };
}

/// Integer elements as polynomials, symbolic or not; `None` for any other.
fn integer_polys(elements: &Elements) -> Option<List<Poly>> {
    return match elements {
        Ints(v) => Option::Some(v.into_iter().map(|c| Poly::constant(*c)).collect()),
        Symbolic(v) => Option::Some(*v),
        _ => null,
    };
}

/// ONNX leaves the rounding of a negative integer quotient unstated, so the
/// build divides only where every rounding agrees.
fn int_op(op: &String, l: i64, r: i64) -> Result<i64, String> {
    return match op.as_str_slice() {
        "Add" => Result::Ok(l + r),
        "Sub" => Result::Ok(l - r),
        "Mul" => Result::Ok(l * r),
        "Div" => {
            if r == 0 || l < 0 || r < 0 {
                return Result::Err(`${l} / ${r} has no rounding every implementation shares`);
            }
            Result::Ok(l / r);
        },
        _ => Result::Err(`${op} of integers is not evaluated`),
    };
}

fn float_op(op: &String, l: f32, r: f32) -> f32 {
    return match op.as_str_slice() {
        "Add" => l + r,
        "Sub" => l - r,
        "Mul" => l * r,
        "Div" => l / r,
        _ => f32::pow(l, r),
    };
}

/// For each element of a tensor of `out` extents, the element a tensor of
/// `extents` broadcast to it reads.
fn positions(extents: &List<i32>, out: &List<i32>) -> List<i32> {
    let strides = stretched_strides(extents, out.len());
    let mut at: List<i32> = [];
    for let n of 0..<element_count(out) {
        let mut rest = n;
        let mut p = 0;
        for let mut a = out.len() - 1; a >= 0; a -= 1 {
            p += rest % out[a] * strides[a];
            rest /= out[a];
        }
        at.push(p);
    }
    return at;
}

fn picked(elements: &Elements, at: &List<i32>) -> Elements {
    return match elements {
        Ints(v) => Elements::Ints(pick(v, at)),
        Symbolic(v) => Elements::integers(pick(v, at)),
        Floats(v) => Elements::Floats(pick(v, at)),
        Bools(v) => Elements::Bools(pick(v, at)),
    };
}

fn pick<T>(values: &List<T>, at: &List<i32>) -> List<T> {
    let mut out = List::<T>::with_capacity(at.len());
    for let i of *at {
        out.push(values[i]);
    }
    return out;
}

/// The operands' elements back to back. Integers join as polynomials where any
/// operand is symbolic, as a `Reshape` target built from a `Shape` is.
fn joined_elements(parts: &List<Known>) -> Result<Elements, String> {
    let mut joined = parts[0].elements;
    for let i of 1..<parts.len() {
        match [&mut joined, &parts[i].elements] {
            [Ints(a), Ints(b)] => a.extend(b),
            [Floats(a), Floats(b)] => a.extend(b),
            [Bools(a), Bools(b)] => a.extend(b),
            [a, b] => {
                let [Some(l), Some(r)] = [
                    integer_polys(a),
                    integer_polys(b),
                ] else {
                    return Result::Err("the operands are not one element type");
                };
                let mut values = l;
                values.extend(&r);
                *a = Elements::integers(values);
            },
        }
    }
    return Result::Ok(joined);
}

fn polys_of(k: &Known) -> Result<List<Poly>, String> {
    return integer_polys(&k.elements).ok_or("an operand read as integers is not an integer tensor");
}

fn ints_of(k: &Known) -> Result<List<i64>, String> {
    let values = polys_of(k)?;
    return numbers(&values).ok_or(`an operand read as numbers holds ${spelled(&values)}, which only the run knows`);
}

/// The numbers `values` holds, or `None` where a symbol stands for one.
fn numbers(values: &List<Poly>) -> Option<List<i64>> {
    let mut out: List<i64> = [];
    for let v of *values {
        out.push(v.as_constant()?);
    }
    return Option::Some(out);
}

/// The integers an operator reads from operand `index`, or from the attribute
/// `attr` an opset before 13 wrote them in. `None` where neither is given.
pub fn axes_of(
    node: &Node,
    known: &TreeMap<String, Known>,
    index: i32,
    attr: String,
) -> Result<Option<List<i64>>, String> {
    if index < node.inputs.len() && node.inputs[index] != "" {
        return ints_of(&operand_known(node, known, index)?).map(|v| Option::Some(v));
    }
    let Some(a) = node.attr(attr) else {
        return Result::Ok(null);
    };
    return a.ints().map(|v| Option::Some(v)).map_err(|e| `${e}`);
}

/// `axes_of` for an operand that may hold a symbol: a `Reshape` target, or a
/// `Slice` bound.
pub fn polys_at(
    node: &Node,
    known: &TreeMap<String, Known>,
    index: i32,
    attr: String,
) -> Result<Option<List<Poly>>, String> {
    if index < node.inputs.len() && node.inputs[index] != "" {
        return polys_of(&operand_known(node, known, index)?).map(|v| Option::Some(v));
    }
    return axes_of(node, known, index, attr).map(
        |read| read.map(|v| v.into_iter().map(|c| Poly::constant(c)).collect()),
    );
}

fn operand_known(node: &Node, known: &TreeMap<String, Known>, index: i32) -> Result<Known, String> {
    return known.get(node.inputs[index]).ok_or(
        `operand ${node.inputs[index]} is computed at run time, and the build reads it`,
    );
}

fn int_attr(node: &Node, name: String, fallback: i64) -> Result<i64, String> {
    return node.int_attr(name, fallback).map_err(|e| `${e}`);
}

pub fn axis_index(axis: i64, rank: i32) -> Result<i32, String> {
    let i = resolve_index(axis, rank as i64);
    if !(0 <= i < rank as i64) {
        return Result::Err(`axis ${axis} is outside rank ${rank}`);
    }
    return Result::Ok(i as i32);
}
