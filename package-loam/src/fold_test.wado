//! Stage 0's evaluation of what a graph computes from what the build knows.

use { TreeMap } from "core:collections";
use { Extent } from "./extent.wado";
use { axis_indices, fold } from "./fold.wado";
use { Attr, Elements, Known, Node, Stored } from "./graph.wado";
use { Poly } from "./poly.wado";
use { Axis, Shape } from "./shape.wado";

fn ints(extents: List<i32>, values: List<i64>) -> Known {
    return Known { extents, elements: Elements::Ints(values) };
}

fn floats(extents: List<i32>, values: List<f32>) -> Known {
    return Known { extents, elements: Elements::Floats(values) };
}

fn attr(name: String, values: List<String>) -> Attr {
    return Attr { name, values, is_list: false };
}

fn node(op: String, inputs: List<String>, attrs: List<Attr>) -> Node {
    return Node {
        op,
        outputs: ["Y"],
        inputs,
        attrs,
    };
}

fn knowns(entries: List<[String, Known]>) -> TreeMap<String, Known> {
    let mut map = TreeMap::<String, Known>::new();
    for let [name, known] of entries {
        map[name] = known;
    }
    return map;
}

/// A runtime tensor `X` of the given extents, symbolic where negative.
fn runtime(extents: List<i32>) -> TreeMap<String, Shape> {
    let mut axes: List<Axis> = [];
    for let [i, e] of extents.into_iter().enumerate() {
        let extent = if e < 0 { Extent::symbol(&"N") } else { Extent::Static(e) };
        axes.push(Axis { name: `A${i}`, extent });
    }
    let mut shapes = TreeMap::<String, Shape>::new();
    shapes["X"] = Shape { axes };
    return shapes;
}

fn folded(n: Node, k: TreeMap<String, Known>) -> Known {
    return fold(&n, &k, &runtime([2, 3, 4])).unwrap().unwrap();
}

test "Shape reads a runtime tensor's static extents" {
    assert folded(node("Shape", ["X"], []), knowns([])) == ints([3], [2, 3, 4]);
}

test "Shape takes start and end" {
    let n = node("Shape", ["X"], [
        attr("start", ["-2"]),
        attr("end", ["3"]),
    ]);
    assert folded(n, knowns([])) == ints([2], [3, 4]);
}

test "Shape of a symbolic extent holds the symbol" {
    let k = fold(&node("Shape", ["X"], []), &knowns([]), &runtime([-1, 3])).unwrap().unwrap();
    assert k == Known {
        extents: [2],
        elements: Elements::integers([
            Poly::symbol(&"N"),
            Poly::constant(3),
        ]),
    };
}

test "shape arithmetic over a symbol folds as a polynomial" {
    let k = knowns([
        [
            "S",
            Known {
                extents: [1],
                elements: Elements::integers([Poly::symbol(&"N")]),
            },
        ],
        ["T", ints([1], [4])],
    ]);
    let product = folded(node("Mul", ["S", "T"], []), k);
    assert product == Known {
        extents: [1],
        elements: Elements::integers([Poly::symbol(&"N").try_mul(&Poly::constant(4)).unwrap()]),
    };
    let gone = folded(node("Sub", ["S", "S"], []), k);
    assert gone == ints([1], [0]);
}

test "arithmetic aligned at an axis, as before opset 7, stretches B along the axes after it" {
    let k = knowns([
        ["A", ints([2, 3], [1, 2, 3, 4, 5, 6])],
        ["B", ints([2], [10, 20])],
    ]);
    let aligned = folded(node("Add", ["A", "B"], [attr("axis", ["0"])]), k);
    assert aligned == ints([2, 3], [11, 12, 13, 24, 25, 26]);
}

test "an integer quotient truncates toward zero, and one over a symbol only where that rounds down" {
    let k = knowns([
        [
            "S",
            Known {
                extents: [1],
                elements: Elements::integers([Poly::symbol(&"N")]),
            },
        ],
        ["T", ints([1], [2])],
        ["M", ints([1], [-7])],
        ["U", ints([1], [-2])],
        ["Z", ints([1], [0])],
    ]);
    let half = folded(node("Div", ["S", "T"], []), k);
    assert half.elements == Elements::integers([Poly::floor_div(&Poly::symbol(&"N"), &Poly::constant(2), &"Y = Div")]);
    assert folded(node("Div", ["M", "T"], []), k) == ints([1], [-3]);
    assert folded(node("Div", ["T", "U"], []), k) == ints([1], [-1]);
    assert folded(node("Div", ["M", "U"], []), k) == ints([1], [3]);
    assert fold(&node("Div", ["M", "Z"], []), &k, &runtime([])).unwrap_err() == "-7 / 0 divides by zero";
    // N may be 0, where ONNX divides by zero.
    assert fold(&node("Div", ["S", "S"], []), &k, &runtime([])).unwrap_err() == "N / N truncates, which the build computes only for a dividend never negative over a positive number";
    assert fold(&node("Div", ["S", "U"], []), &k, &runtime([])).unwrap_err() == "N / -2 truncates, which the build computes only for a dividend never negative over a positive number";
}

test "half arithmetic rounds each result to the half it is stored as" {
    let half = |v: f32, stored: Stored| Known {
        extents: [1],
        elements: Elements::Floats([v]),
        stored,
    };
    let tiny: f32 = 0.00048828125;
    let k = knowns([
        ["A", half(1.0, Stored::Float16)],
        ["B", half(tiny, Stored::Float16)],
        ["C", half(1.0, Stored::BFloat16)],
        ["D", half(tiny, Stored::BFloat16)],
    ]);
    assert folded(node("Add", ["A", "B"], []), k) == half(1.0, Stored::Float16);
    assert folded(node("Add", ["C", "D"], []), k) == half(1.0, Stored::BFloat16);
}

test "an axis list naming one axis twice, once from the end, stops the build" {
    assert axis_indices(&[0, -1], 3).unwrap() == [0, 2];
    assert axis_indices(&[0, -2], 2).unwrap_err() == "axis -2 is listed twice";
}

test "integer arithmetic past i64 stops the build rather than wrapping" {
    let k = knowns([
        ["S", ints([1], [i64::MAX])],
        ["T", ints([1], [2])],
    ]);
    assert fold(&node("Mul", ["S", "T"], []), &k, &runtime([])).unwrap_err() == "9223372036854775807 Mul 2 leaves i64";
}

test "numbers beside a symbol divide as numbers do" {
    let k = knowns([
        [
            "S",
            Known {
                extents: [2],
                elements: Elements::integers([
                    Poly::symbol(&"N"),
                    Poly::constant(7),
                ]),
            },
        ],
        ["T", ints([2], [1, 2])],
    ]);
    let quotient = folded(node("Div", ["S", "T"], []), k);
    assert quotient == Known {
        extents: [2],
        elements: Elements::integers([
            Poly::symbol(&"N"),
            Poly::constant(3),
        ]),
    };
}

test "a Range or Slice bound only the run knows leaves the node to the run" {
    let k = knowns([
        ["Zero", ints([], [0])],
        [
            "N",
            Known { extents: [], elements: Elements::integers([Poly::symbol(&"N")]) },
        ],
        ["One", ints([], [1])],
        [
            "Ends",
            Known {
                extents: [1],
                elements: Elements::integers([Poly::symbol(&"N")]),
            },
        ],
        ["Starts", ints([1], [0])],
        ["M", ints([4], [1, 2, 3, 4])],
    ]);
    assert fold(&node("Range", ["Zero", "N", "One"], []), &k, &runtime([])).unwrap() matches { None };
    assert fold(&node("Slice", ["M", "Starts", "Ends"], []), &k, &runtime([])).unwrap() matches { None };
}

test "Gather with a scalar index drops the axis" {
    let k = knowns([
        ["S", ints([3], [2, 3, 4])],
        ["I", ints([], [-2])],
    ]);
    assert folded(node("Gather", ["S", "I"], [attr("axis", ["0"])]), k) == ints([], [3]);
}

test "Gather along an inner axis keeps the index shape" {
    let k = knowns([
        ["D", ints([2, 3], [1, 2, 3, 4, 5, 6])],
        ["I", ints([2], [2, 0])],
    ]);
    assert folded(node("Gather", ["D", "I"], [attr("axis", ["1"])]), k) == ints([2, 2], [3, 1, 6, 4]);
}

test "Gather reading a runtime tensor is left to the run" {
    let k = knowns([
        ["I", ints([1], [0])],
    ]);
    assert fold(&node("Gather", ["X", "I"], []), &k, &runtime([2, 3, 4])).unwrap() matches { None };
}

test "Unsqueeze and Squeeze move extent-1 axes" {
    let k = knowns([
        ["S", ints([], [7])],
        ["A", ints([1], [0])],
    ]);
    let up = folded(node("Unsqueeze", ["S", "A"], []), k);
    assert up == ints([1], [7]);
    let k2 = knowns([
        ["U", up],
        ["A", ints([1], [-1])],
    ]);
    assert folded(node("Squeeze", ["U", "A"], []), k2) == ints([], [7]);
}

test "Unsqueeze reads axes from an attribute before opset 13" {
    let k = knowns([
        ["S", ints([2], [7, 8])],
    ]);
    assert folded(node("Unsqueeze", ["S"], [attr("axes", ["0", "2"])]), k) == ints([1, 2, 1], [7, 8]);
}

test "Concat joins along its axis" {
    let k = knowns([
        ["A", ints([1], [-1])],
        ["B", ints([2], [4, 8])],
    ]);
    assert folded(node("Concat", ["A", "B"], [attr("axis", ["0"])]), k) == ints([3], [-1, 4, 8]);
}

test "Slice clamps an end past the axis" {
    let k = knowns([
        ["S", ints([3], [1, 4, 32])],
        ["B", ints([1], [-1])],
        ["E", ints([1], [i64::MAX])],
        ["X0", ints([1], [0])],
    ]);
    assert folded(node("Slice", ["S", "B", "E", "X0"], []), k) == ints([1], [32]);
}

test "Slice steps backwards" {
    let k = knowns([
        ["S", ints([4], [1, 2, 3, 4])],
        ["B", ints([1], [-1])],
        ["E", ints([1], [i64::MIN])],
        ["X0", ints([1], [0])],
        ["St", ints([1], [-2])],
    ]);
    assert folded(node("Slice", ["S", "B", "E", "X0", "St"], []), k) == ints([2], [4, 2]);
}

test "Slice steps backwards over an empty axis to nothing" {
    let k = knowns([
        ["S", ints([0], [])],
        ["B", ints([1], [-1])],
        ["E", ints([1], [i64::MIN])],
        ["X0", ints([1], [0])],
        ["St", ints([1], [-1])],
    ]);
    assert folded(node("Slice", ["S", "B", "E", "X0", "St"], []), k) == ints([0], []);
}

test "Slice of a bool mask takes the corner the ends name" {
    let mut mask: List<bool> = [];
    for let r of 0..<4 {
        for let c of 0..<4 {
            mask.push(c <= r);
        }
    }
    let k = knowns([
        [
            "M",
            Known {
                extents: [4, 4],
                elements: Elements::Bools(mask),
            },
        ],
        ["B", ints([2], [0, 0])],
        ["E", ints([2], [2, 2])],
    ]);
    let want = Known {
        extents: [2, 2],
        elements: Elements::Bools([true, false, true, true]),
    };
    assert folded(node("Slice", ["M", "B", "E"], []), k) == want;
}

test "Cast turns an extent into a float the scale is computed in" {
    let d = folded(node("Cast", ["D"], [attr("to", ["1"])]), knowns([
        ["D", ints([], [8])],
    ]));
    assert d == floats([], [8.0]);
    let k2 = knowns([
        ["D", d],
        ["H", floats([], [0.5])],
    ]);
    assert folded(node("Pow", ["D", "H"], []), k2) == floats([], [f32::sqrt(8.0)]);
}

test "Cast to int32 keeps a known integer's low 32 bits beside a symbolic one" {
    let n = Poly::symbol(&"N");
    let k = knowns([
        [
            "D",
            Known {
                extents: [2],
                elements: Elements::Symbolic([n, Poly::constant(5000000000)]),
            },
        ],
    ]);
    assert folded(node("Cast", ["D"], [attr("to", ["6"])]), k) == Known {
        extents: [2],
        elements: Elements::Symbolic([n, Poly::constant(705032704)]),
        stored: Stored::Int32,
    };
}

test "integer arithmetic broadcasts" {
    let k = knowns([
        ["A", ints([2], [5, 7])],
        ["B", ints([], [2])],
    ]);
    assert folded(node("Sub", ["A", "B"], []), k) == ints([2], [3, 5]);
}

test "Range counts from start to limit" {
    let k = knowns([
        ["S", ints([], [0])],
        ["L", ints([], [4])],
        ["D", ints([], [1])],
    ]);
    assert folded(node("Range", ["S", "L", "D"], []), k) == ints([4], [0, 1, 2, 3]);
}

test "a step past the span takes one element, however large the step" {
    let up = knowns([
        ["S", ints([], [0])],
        ["L", ints([], [5])],
        ["D", ints([], [i64::MAX])],
    ]);
    assert folded(node("Range", ["S", "L", "D"], []), up) == ints([1], [0]);
    let down = knowns([
        ["S", ints([], [5])],
        ["L", ints([], [0])],
        ["D", ints([], [i64::MIN])],
    ]);
    assert folded(node("Range", ["S", "L", "D"], []), down) == ints([1], [5]);
    let sliced = knowns([
        ["X", ints([5], [0, 1, 2, 3, 4])],
        ["B", ints([1], [0])],
        ["E", ints([1], [5])],
        ["A", ints([1], [0])],
        ["P", ints([1], [i64::MAX])],
    ]);
    assert folded(node("Slice", ["X", "B", "E", "A", "P"], []), sliced) == ints([1], [0]);
}

test "a Range longer than any list is refused before it is counted out" {
    let ints_range = knowns([
        ["S", ints([], [0])],
        ["L", ints([], [3_000_000_000])],
        ["D", ints([], [1])],
    ]);
    assert fold(&node("Range", ["S", "L", "D"], []), &ints_range, &runtime([])).unwrap_err() == "3000000000 elements are more than a list holds";
    let floats_range = knowns([
        ["S", floats([], [0.0])],
        ["L", floats([], [3.0e9])],
        ["D", floats([], [1.0])],
    ]);
    assert fold(&node("Range", ["S", "L", "D"], []), &floats_range, &runtime([])).unwrap_err() == "3000000000 elements are more than a list holds";
}

test "Range with a zero float delta is refused" {
    let k = knowns([
        ["S", floats([], [0.0])],
        ["L", floats([], [4.0])],
        ["D", floats([], [0.0])],
    ]);
    assert fold(&node("Range", ["S", "L", "D"], []), &k, &runtime([])).unwrap_err() == "delta is 0";
}

test "ConstantOfShape of an empty shape is a scalar" {
    let k = knowns([
        ["S", ints([0], [])],
    ]);
    assert folded(node("ConstantOfShape", ["S"], []), k) == floats([], [0.0]);
}

test "Reshape infers the one negative extent" {
    let k = knowns([
        ["D", ints([4], [0, 1, 2, 3])],
        ["T", ints([2], [1, -1])],
    ]);
    assert folded(node("Reshape", ["D", "T"], []), k) == ints([1, 4], [0, 1, 2, 3]);
}

test "a Reshape -1 beside extents multiplying to 0 is refused, as ONNX leaves it no extent" {
    let k = knowns([
        ["D", ints([0, 4], [])],
        ["T", ints([2], [0, -1])],
    ]);
    let e = fold(&node("Reshape", ["D", "T"], []), &k, &runtime([2])).unwrap_err();
    assert e == "the target's extents besides -1 multiply to 0, which must not be 0, and it is not";
}

test "a Reshape target no list can hold is refused, even where its product wraps to the count" {
    // 65536^4 is 2^64, which an i64 product wraps to the empty input's 0.
    let k = knowns([
        ["D", ints([0], [])],
        ["T", ints([4], [65536, 65536, 65536, 65536])],
    ]);
    let e = fold(&node("Reshape", ["D", "T"], []), &k, &runtime([2])).unwrap_err();
    assert e == "the target shape [65536, 65536, 65536, 65536] multiplies past what a list can hold";
}

test "an operator the build does not evaluate is left to the run" {
    let k = knowns([
        ["A", floats([1], [1.0])],
    ]);
    assert fold(&node("Relu", ["A"], []), &k, &runtime([2])).unwrap() matches { None };
}
