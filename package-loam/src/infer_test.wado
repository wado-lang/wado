//! What stage 0 proves of a graph, and what it stops the build for.

use { Extent } from "./extent.wado";
use { Attr, Elements, Node } from "./graph.wado";
use {
    AttributeConflict,
    AxisCountConflict,
    Checked,
    DeclaredConflict,
    DeclaredElementConflict,
    DeclaredRankConflict,
    InferError,
    NodeConflict,
    OperandCountConflict,
    OperandRankConflict,
    OutputCountConflict,
    Refusal,
    UnnamedTensor,
    infer,
    softmax_lane,
} from "./infer.wado";
use { read } from "./onnx_text.wado";
use { Poly } from "./poly.wado";
use { LayoutRule, Schema } from "./schema.wado";
use { AxisConflict } from "./shape.wado";

fn is_error<E: Error>() {
}

test "every error stage 0 reports is an Error" {
    is_error::<InferError>();
    is_error::<Refusal>();
    is_error::<UnnamedTensor>();
    is_error::<AxisCountConflict>();
    is_error::<NodeConflict>();
    is_error::<AxisConflict>();
    is_error::<OperandCountConflict>();
    is_error::<OutputCountConflict>();
    is_error::<OperandRankConflict>();
    is_error::<AttributeConflict>();
    is_error::<DeclaredRankConflict>();
    is_error::<DeclaredConflict>();
    is_error::<DeclaredElementConflict>();
}

fn rule(pattern: String, axes: List<String>) -> LayoutRule {
    return LayoutRule { pattern, axes };
}

/// `Y`'s axes after stage 0, as `name=extent` pairs, or the build error.
fn y_axes(source: String, layout: List<LayoutRule>) -> Result<String, String> {
    let graph = read(&source).unwrap();
    return match infer(&graph, &Schema { layout }) {
        Ok(Checked { shapes, .. }) => {
            let axes: List<String> = shapes["Y"].axes.into_iter().map(|a| `${a.name}=${a.extent}`).collect();
            Result::Ok(axes.join(","));
        },
        Err(e) => Result::Err(`${e}`),
    };
}

/// The MLP's schema. `Hidden` names an output axis on the first layer and an
/// input axis on the second, which is what makes the two layers check.
fn mlp_schema() -> Schema {
    return Schema {
        layout: [
            rule("X", ["Batch", "In"]),
            rule("W1", ["In", "Hidden"]),
            rule("B1", ["Hidden"]),
            rule("W2", ["Hidden", "Out"]),
            rule("B2", ["Out"]),
        ],
    };
}

fn mlp(hidden_in_w2: i32) -> String {
    return `mlp (float[N, 128] X) => (float[N, 10] Y)
    <float[128, 64] W1, float[64] B1, float[${hidden_in_w2}, 10] W2, float[10] B2>
    {
        H = MatMul(X, W1)
        HB = Add(H, B1)
        A = Relu(HB)
        T = MatMul(A, W2)
        Y = Add(T, B2)
    }`;
}

fn infer_mlp(hidden_in_w2: i32) -> Result<String, String> {
    return y_axes(mlp(hidden_in_w2), mlp_schema().layout);
}

test "a consistent MLP infers its output shape" {
    assert infer_mlp(64).unwrap() == "Batch=N,Out=10";
}

test "an extent mismatch between the layers names both extents" {
    assert infer_mlp(32).unwrap_err() == "T = MatMul: axis Hidden is 64 on the left and 32 on the right";
}

test "a symbolic batch axis flows through both layers" {
    let graph = read(&mlp(64)).unwrap();
    let shapes = infer(&graph, &mlp_schema()).unwrap().shapes;
    assert shapes["H"].axes[0].extent.agrees(&Extent::symbol(&"N"));
    assert shapes["Y"].axes[0].extent.agrees(&Extent::symbol(&"N"));
}

test "a bias broadcasts against the batch axis ahead of it" {
    let graph = read(&mlp(64)).unwrap();
    let shapes = infer(&graph, &mlp_schema()).unwrap().shapes;
    assert shapes["HB"].rank() == 2;
    assert shapes["HB"].axes[1].name == "Hidden";
}

test "a tensor no pattern reaches stops the build naming it" {
    let graph = read(&mlp(64)).unwrap();
    let partial = Schema {
        layout: [rule("X", ["Batch", "In"])],
    };
    let e = infer(&graph, &partial).unwrap_err();
    assert `${e}` == "W1: no layout pattern names this tensor's axes";
}

test "a pattern naming the wrong number of axes stops the build" {
    let graph = read(&mlp(64)).unwrap();
    let mut schema = mlp_schema();
    schema.layout[1] = rule("W1", ["In"]);
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "W1: the schema names 1 axes and the graph gives 2 dimensions";
}

test "an operator with no shape rule stops the build naming it" {
    let graph = read(
        `agraph (float[2, 3] X) => (float[2, 3] Y) {
            Y = LpNormalization(X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["A", "B"])],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "LpNormalization: no shape rule for this operator";
}

test "a wildcard pattern reaches every tensor" {
    let graph = read(
        `agraph (float[2, 3] X) => (float[2, 3] Y) {
            Y = Relu(X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["A", "B"])],
    };
    let shapes = infer(&graph, &schema).unwrap().shapes;
    assert shapes["X"].axes[0].name == "A";
}

test "an earlier pattern overrides a later one" {
    let graph = read(
        `agraph (float[2, 3] "layers.0.weight") => (float[2, 3] Y) {
            Y = Relu("layers.0.weight")
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [
            rule("*.0.weight", ["First", "Second"]),
            rule("*", ["A", "B"]),
        ],
    };
    let shapes = infer(&graph, &schema).unwrap().shapes;
    assert shapes["layers.0.weight"].axes[0].name == "First";
}

test "an unknown dimension takes its axis's name as its symbol" {
    let graph = read(
        `agraph (float[?, 4] X, float[4, 4] W) => (float[?, 4] Y) {
            Y = MatMul(X, W)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [
            rule("X", ["Batch", "In"]),
            rule("W", ["In", "Out"]),
        ],
    };
    let shapes = infer(&graph, &schema).unwrap().shapes;
    assert shapes["Y"].axes[0].extent.agrees(&Extent::symbol(&"Batch"));
}

test "an operator given too few operands stops the build rather than trapping" {
    let graph = read(
        `agraph (float[2, 3] X) => (float[2, 3] Y) {
            Y = Add(X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["A", "B"])],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "Y = Add: reads 2 operands and was given 1";
}

test "a node the build folds, given too few operands, stops the build rather than trapping" {
    let source = `g (float[2] X) => (float[2] Y) {
        S = Shape(X)
        G = Gather(S)
        Y = Relu(X)
    }`;
    assert y_axes(source, [rule("*", ["A"])]).unwrap_err() == "G = Gather: reads 2 operands and was given 1";
}

test "a node the build folds, reading an undefined tensor, stops the build" {
    let source = `g (float[2] X) => (float[2] Y) {
        S = Shape(Missing)
        Y = Relu(X)
    }`;
    assert y_axes(source, [rule("*", ["A"])]).unwrap_err() == "Missing: no graph input, initializer or node defines this";
}

test "Unsqueeze listing an axis twice stops the build rather than trapping" {
    let source = `g (float[3] X) => (float[1, 1, 3] Y) {
        A = Constant<value_ints = [0, 0]>()
        Y = Unsqueeze(X, A)
    }`;
    assert y_axes(source, [rule("X", ["C"])]).unwrap_err() == "Y = Unsqueeze: axis 0 is listed twice";
}

test "the axis Unsqueeze inserts is new, even ahead of an operand axis of extent 1" {
    let source = `g (float[1] X) => (float[1, 1] Y) {
        A = Constant<value_ints = [0]>()
        Y = Unsqueeze(X, A)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Seq"]),
        rule("Y", ["Batch", "Other"]),
    ];
    assert y_axes(source, layout).unwrap() == "Batch=1,Seq=1";
}

test "Squeeze keeps the operand's axes it does not list, extent 1 or not" {
    let source = `g (float[1, 1, 3] X) => (float[1, 3] Y) {
        A = Constant<value_ints = [0]>()
        Y = Squeeze(X, A)
    }`;
    assert y_axes(source, [rule("X", ["Batch", "Seq", "C"])]).unwrap() == "Seq=1,C=3";
}

test "Slice given more starts than axes stops the build rather than trapping" {
    let source = `g (float[2, 3] X) => (float[2, 3] Y) <int64[2] B = {0, 0}, int64[2] E = {1, 1}, int64[1] P = {0}> {
        S = Shape(X)
        T = Slice(S, B, E, P)
        Y = Relu(X)
    }`;
    let e = y_axes(source, [rule("*", ["A", "B"])]).unwrap_err();
    assert e == "T = Slice: 2 starts, 2 ends, 1 axes and 2 steps do not pair up";
}

test "a Constant written as value_floats folds" {
    let source = `g (float[2] X) => (float[2] Y) {
        C = Constant<value_floats = [0.5, 2.0]>()
        Y = Mul(X, C)
    }`;
    assert y_axes(source, [rule("*", ["A"])]).unwrap() == "A=2";
}

test "Flatten of a tensor with no elements keeps the extents on each side" {
    let source = `g (float[0, 3, 4] X) => (float[0, 12] Y) {
        Y = Flatten <axis = 1> (X)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["A", "B", "C"]),
        rule("Y", ["A", "BC"]),
    ];
    assert y_axes(source, layout).unwrap() == "A=0,BC=12";
}

test "a folded tensor of one element keeps its rank" {
    let source = `g (float[3] X) => (float[1, 3] Y) <int64[2] S = {1, 1}> {
        C = ConstantOfShape(S)
        Y = Add(X, C)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["A"]),
        rule("C", ["One", "A"]),
    ];
    assert y_axes(source, layout).unwrap() == "One=1,A=3";
}

test "a node naming several outputs stops the build rather than trapping" {
    let graph = read(
        `agraph (float[2, 3] X) => (float[2, 3] Y) {
            Y, Z = Relu(X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["A", "B"])],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "Y = Relu: produces one output and names 2";
}

test "a weight's merged axis, written as its parts, contracts with a regrouped activation" {
    let source = `g (float[1, 4, 2, 8] X) => (float[1, 4, 6] Y) <float[16, 6] W, int64[3] S = {1, 4, 16}> {
        R = Reshape(X, S)
        Y = MatMul(R, W)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Batch", "Seq", "Head", "Dim"]),
        rule("W", ["(Head Dim)", "Out"]),
    ];
    assert y_axes(source, layout).unwrap() == "Batch=1,Seq=4,Out=6";
}

test "regrouping a merged axis the layout wrote stops the build, its parts having no extents" {
    let source = `g (float[16, 6] W) => (float[2, 8, 6] Y) <int64[3] S = {2, 8, 6}> {
        Y = Reshape(W, S)
    }`;
    let e = y_axes(source, [rule("W", ["(Head Dim)", "Out"])]).unwrap_err();
    assert e == "Y = Reshape: axis Head has no stated extent, and Reshape reads it";
}

fn qkv() -> List<LayoutRule> {
    return [
        rule("X", ["Batch", "Seq", "Qkv"]),
        rule("?", ["Batch", "Seq", "Embed"]),
    ];
}

test "Split cuts an axis into parts the outputs' layout names" {
    let source = `g (float[1, 4, 24] X) => (float[1, 4, 8] Y) {
        S = Constant<value_ints = [8, 8, 8]>()
        Q, Y, V = Split<axis = 2>(X, S)
    }`;
    assert y_axes(source, qkv()).unwrap() == "Batch=1,Seq=4,Embed=8";
}

test "Split with no sizes cuts equal parts, the last taking what remains" {
    let source = `g (float[1, 4, 23] X) => (float[1, 4, 7] V) {
        Q, Y, V = Split<axis = -1>(X)
    }`;
    let graph = read(&source).unwrap();
    let shapes = infer(&graph, &Schema { layout: qkv() }).unwrap().shapes;
    assert shapes["Y"].axes[2].extent.agrees(&Extent::Static(8));
    assert shapes["V"].axes[2].extent.agrees(&Extent::Static(7));
}

test "Split sizes that miss the axis's extent stop the build" {
    let source = `g (float[1, 4, 24] X) => (float[1, 4, 8] Y) {
        S = Constant<value_ints = [8, 8, 4]>()
        Q, Y, V = Split<axis = 2>(X, S)
    }`;
    assert y_axes(source, qkv()).unwrap_err() == "Q = Split: the parts sum to 20, which must be axis 2's 24, and it is not";
}

test "a Split size past the axis stops the build rather than wrapping into it" {
    let source = `g (float[1, 4, 24] X) => (float[1, 4, 8] Y) {
        S = Constant<value_ints = [4294967304, 8, 8]>()
        Q, Y, V = Split<axis = 2>(X, S)
    }`;
    assert y_axes(source, qkv()).unwrap_err() == "Q = Split: a part is 4294967304, which must lie within axis 2's 24, and it is not";
}

fn cache() -> List<LayoutRule> {
    return [
        rule("P", ["Batch", "Past", "Dim"]),
        rule("N", ["Batch", "Seq", "Dim"]),
        rule("Y", ["Batch", "Total", "Dim"]),
    ];
}

test "Concat sums the axis it joins, which the output's layout names" {
    let source = `g (float[1, T, 8] P, float[1, 1, 8] N) => (float[1, T, 8] Y) {
        Y = Concat<axis = -2>(P, N)
    }`;
    let graph = read(&source).unwrap();
    let shapes = infer(&graph, &Schema { layout: cache() }).unwrap().shapes;
    assert shapes["Y"].axes[1].name == "Total";
    assert shapes["Y"].axes[1].extent.agrees(&Extent::Symbolic(Poly::symbol(&"T").try_add(&Poly::constant(1)).unwrap()));
}

test "Concat of one operand is that operand, as a Split into one part is" {
    let source = `g (float[1, T, 8] P) => (float[1, T, 8] Y) {
        Y = Concat<axis = -2>(P)
    }`;
    assert y_axes(source, cache()).unwrap() == "Batch=1,Past=T,Dim=8";
}

test "Concat of operands that disagree on another axis stops the build" {
    let source = `g (float[1, 3, 8] P, float[1, 1, 4] N) => (float[1, 4, 8] Y) {
        Y = Concat<axis = 1>(P, N)
    }`;
    assert y_axes(source, cache()).unwrap_err() == "Y = Concat: axis Dim is 8 on the left and 4 on the right";
}

test "Concat of operands naming another axis apart stops the build" {
    let source = `g (float[1, 3, 8] P, float[1, 1, 8] N) => (float[1, 4, 8] Y) {
        Y = Concat<axis = 1>(P, N)
    }`;
    let layout: List<LayoutRule> = [
        rule("P", ["Batch", "Past", "Dim"]),
        rule("N", ["Batch", "Seq", "Embed"]),
        rule("Y", ["Batch", "Total", "Dim"]),
    ];
    assert y_axes(source, layout).unwrap_err() == "Y = Concat: axis Dim on the left meets Embed on the right, and only an axis of 1 takes another's name";
}

test "Concat of operands of different ranks stops the build" {
    let source = `g (float[1, 3, 8] P, float[1, 8] N) => (float[1, 4, 8] Y) {
        Y = Concat<axis = 1>(P, N)
    }`;
    let layout: List<LayoutRule> = [
        rule("P", ["Batch", "Past", "Dim"]),
        rule("N", ["Batch", "Dim"]),
        rule("Y", ["Batch", "Total", "Dim"]),
    ];
    assert y_axes(source, layout).unwrap_err() == "Y = Concat: operand 1 has rank 2 and the operator reads rank 3";
}

test "Concat of operands held in different elements stops the build" {
    let source = `g (float[1, 3, 8] P, int64[1, 1, 8] N) => (float[1, 4, 8] Y) {
        Y = Concat<axis = 1>(P, N)
    }`;
    assert y_axes(source, cache()).unwrap_err() == "Y = Concat: operand N is i64 and P is f32, and Concat joins one element";
}

test "Concat with no layout for the axis it joins stops the build naming the output" {
    let source = `g (float[1, 3, 8] P, float[1, 1, 8] N) => (float[1, 4, 8] Y) {
        Y = Concat<axis = 1>(P, N)
    }`;
    let layout: List<LayoutRule> = [
        rule("P", ["Batch", "Past", "Dim"]),
        rule("N", ["Batch", "Seq", "Dim"]),
    ];
    assert y_axes(source, layout).unwrap_err() == "Y = Concat: axis 1 is a concatenation, so a layout pattern must name Y's";
}

test "a scalar operand to MatMul stops the build rather than trapping" {
    let graph = read(
        `agraph (float S, float[2, 3] W) => (float[2, 3] Y) {
            Y = MatMul(S, W)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [
            rule("S", []),
            rule("*", ["A", "B"]),
        ],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "Y = MatMul: a scalar operand has no axis to contract";
}

test "a declared output extent disagreeing with the produced one stops the build" {
    let graph = read(
        `agraph (float[2, 3] X, float[3, 10] W) => (float[2, 7] Y) {
            Y = MatMul(X, W)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [
            rule("X", ["A", "K"]),
            rule("W", ["K", "B"]),
        ],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "Y: axis B is declared 7 and produced 10";
}

test "a declared output rank disagreeing with the produced one stops the build" {
    let graph = read(
        `agraph (float[2, 3] X) => (float[2] Y) {
            Y = Relu(X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["A", "B"])],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "Y: the graph declares rank 1 and the nodes produce rank 2";
}

test "a declared symbolic name need not be the one the schema gave the axis" {
    let graph = read(
        `agraph (float[?, 3] X) => (float[N, 3] Y) {
            Y = Relu(X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["Batch", "B"])],
    };
    let shapes = infer(&graph, &schema).unwrap().shapes;
    assert shapes["Y"].axes[0].extent.agrees(&Extent::symbol(&"Batch"));
}

test "a declared static extent settles an axis the nodes left symbolic" {
    let graph = read(
        `agraph (float[N, 3] X) => (float[8, 3] Y) {
            Y = Relu(X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["Batch", "B"])],
    };
    let shapes = infer(&graph, &schema).unwrap().shapes;
    assert shapes["Y"].axes[0].extent.agrees(&Extent::Static(8));
    // Only the declared output is settled; the input keeps what it stated.
    assert shapes["X"].axes[0].extent.agrees(&Extent::symbol(&"N"));
}

test "a declared `?` claims nothing about the produced extent" {
    let graph = read(
        `agraph (float[N, 3] X) => (float[?, 3] Y) {
            Y = Relu(X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["Batch", "B"])],
    };
    let shapes = infer(&graph, &schema).unwrap().shapes;
    assert shapes["Y"].axes[0].extent.agrees(&Extent::symbol(&"N"));
}

test "a graph output no node produces stops the build" {
    let graph = read(
        `agraph (float[2, 3] X) => (float[2, 3] Y, float[2, 3] Z) {
            Y = Relu(X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["A", "B"])],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "Z: no graph input, initializer or node defines this";
}

test "Gemm contracts the axis its transpose flags leave facing" {
    let graph = read(
        `agraph (float[2, 3] A, float[4, 3] B, float[4] C) => (float[2, 4] Y) {
            Y = Gemm <transB = 1> (A, B, C)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [
            rule("A", ["Batch", "In"]),
            rule("B", ["Out", "In"]),
            rule("C", ["Out"]),
            rule("Y", ["Batch", "Out"]),
        ],
    };
    let shapes = infer(&graph, &schema).unwrap().shapes;
    assert shapes["Y"].axes[0].name == "Batch";
    assert shapes["Y"].axes[1].name == "Out";
}

test "Gemm without its C operand is the product alone" {
    let graph = read(
        `agraph (float[2, 3] A, float[3, 4] B) => (float[2, 4] Y) {
            Y = Gemm(A, B)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [
            rule("A", ["Batch", "In"]),
            rule("B", ["In", "Out"]),
            rule("Y", ["Batch", "Out"]),
        ],
    };
    let shapes = infer(&graph, &schema).unwrap().shapes;
    assert shapes["Y"].axes[1].extent.agrees(&Extent::Static(4));
}

test "Gemm refuses operands naming the contracted axis apart" {
    let graph = read(
        `agraph (float[2, 3] A, float[4, 3] B) => (float[2, 4] Y) {
            Y = Gemm <transB = 1> (A, B)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [
            rule("A", ["Batch", "Hidden"]),
            rule("B", ["Out", "Inner"]),
            rule("Y", ["Batch", "Out"]),
        ],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "Y = Gemm: axis Hidden on the left meets Inner on the right, and only an axis of 1 takes another's name";
}

test "a Gemm operand that is not a matrix stops the build" {
    let graph = read(
        `agraph (float[3] A, float[3, 4] B) => (float[4] Y) {
            Y = Gemm(A, B)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [
            rule("A", ["In"]),
            rule("B", ["In", "Out"]),
            rule("Y", ["Out"]),
        ],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "Y = Gemm: operand 0 has rank 1 and the operator reads rank 2";
}

test "Transpose reorders the axes its perm names" {
    let graph = read(
        `agraph (float[2, 3] X) => (float[3, 2] Y) {
            Y = Transpose <perm = [1, 0]> (X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["A", "B"])],
    };
    let shapes = infer(&graph, &schema).unwrap().shapes;
    assert shapes["Y"].axes[0].name == "B";
    assert shapes["Y"].axes[1].name == "A";
    assert shapes["Y"].axes[0].extent.agrees(&Extent::Static(3));
}

test "Transpose with no perm reverses the axes, as ONNX defaults it" {
    let graph = read(
        `agraph (float[2, 3] X) => (float[3, 2] Y) {
            Y = Transpose(X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["A", "B"])],
    };
    let shapes = infer(&graph, &schema).unwrap().shapes;
    assert shapes["Y"].axes[0].name == "B";
}

test "a perm that is not a permutation stops the build" {
    let graph = read(
        `agraph (float[2, 3] X) => (float[3, 2] Y) {
            Y = Transpose <perm = [1, 1]> (X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["A", "B"])],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "Y = Transpose: attribute perm is not a permutation of 2 axes";
}

test "a perm naming the wrong number of axes stops the build" {
    let graph = read(
        `agraph (float[2, 3] X) => (float[3, 2] Y) {
            Y = Transpose <perm = [0]> (X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["A", "B"])],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "Y = Transpose: attribute perm names 1 axes and the operand has 2";
}

fn rows() -> List<LayoutRule> {
    return [rule("X", ["Batch", "Seq", "Embed"])];
}

test "Softmax keeps its operand's shape" {
    let source = `g (float[2, 4, 8] X) => (float[2, 4, 8] Y) {
        Y = Softmax <axis = -1> (X)
    }`;
    assert y_axes(source, rows()).unwrap() == "Batch=2,Seq=4,Embed=8";
}

test "a Softmax axis outside the operand stops the build" {
    let source = `g (float[2, 4, 8] X) => (float[2, 4, 8] Y) {
        Y = Softmax <axis = 3> (X)
    }`;
    assert y_axes(source, rows()).unwrap_err() == "Y = Softmax: attribute axis is 3, outside rank 3";
}

test "Softmax before opset 13 normalizing past one axis keeps its operand's shape" {
    let source = `<ir_version: 7, opset_import: ["" : 11]>
    g (float[2, 4, 8] X) => (float[2, 4, 8] Y) {
        Y = Softmax(X)
    }`;
    assert y_axes(source, rows()).unwrap() == "Batch=2,Seq=4,Embed=8";
}

test "Softmax before opset 13 normalizes from axis 1 on, and along the last axis is the one-axis Softmax" {
    let softmax = |axis: Option<String>| Node {
        op: "Softmax",
        outputs: ["Y"],
        inputs: ["X"],
        attrs: match axis {
            Some(v) => [
                Attr {
                    name: "axis",
                    values: [v],
                    is_list: false,
                },
            ],
            None => [],
        },
    };
    let old = Option::Some(11_i64);
    let fallback = softmax_lane(&softmax(null), 3, old).unwrap();
    assert fallback.axis == 1 && fallback.flattened;
    let last = softmax_lane(&softmax(Option::Some("2")), 3, old).unwrap();
    assert last.axis == 2 && !last.flattened;
    let current = softmax_lane(&softmax(null), 3, Option::Some(13_i64)).unwrap();
    assert current.axis == 2 && !current.flattened;
}

test "arithmetic before opset 7 aligns B at A's axis and stretches it over the axes after" {
    let source = `<ir_version: 3, opset_import: ["" : 6]>
    g (float[2, 4, 8] X, float[4] B) => (float[2, 4, 8] Y) {
        Y = Add <broadcast = 1, axis = 1> (X, B)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Batch", "Seq", "Embed"]),
        rule("B", ["Seq"]),
    ];
    assert y_axes(source, layout).unwrap() == "Batch=2,Seq=4,Embed=8";
}

test "arithmetic before opset 7 aligning B past A's last axis stops the build" {
    let source = `<ir_version: 3, opset_import: ["" : 6]>
    g (float[2, 4, 8] X, float[4, 8] B) => (float[2, 4, 8] Y) {
        Y = Add <broadcast = 1, axis = 2> (X, B)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Batch", "Seq", "Embed"]),
        rule("B", ["Seq", "Embed"]),
    ];
    let e = y_axes(source, layout).unwrap_err();
    assert e == "Y = Add: attribute axis is 2, and B's 2 axes from there pass A's 3";
}

test "a reduction that keeps its axes leaves each at extent 1 under its name" {
    let source = `g (float[2, 4, 8] X) => (float[2, 4, 1] Y) {
        Y = ReduceMean <axes = [-1]> (X)
    }`;
    assert y_axes(source, rows()).unwrap() == "Batch=2,Seq=4,Embed=1";
}

test "a reduction that drops its axes removes them" {
    let source = `g (float[2, 4, 8] X) => (float[2, 8] Y) {
        A = Constant <value_ints = [1]> ()
        Y = ReduceSum <keepdims = 0> (X, A)
    }`;
    assert y_axes(source, rows()).unwrap() == "Batch=2,Embed=8";
}

test "a reduction naming no axes reduces every axis" {
    let source = `g (float[2, 4, 8] X) => (float[1, 1, 1] Y) {
        Y = ReduceMean(X)
    }`;
    assert y_axes(source, rows()).unwrap() == "Batch=1,Seq=1,Embed=1";
}

test "a reduction axis outside the operand stops the build" {
    let source = `g (float[2, 4, 8] X) => (float[2, 4, 1] Y) {
        Y = ReduceMean <axes = [3]> (X)
    }`;
    assert y_axes(source, rows()).unwrap_err() == "Y = ReduceMean: axis 3 is outside rank 3";
}

fn nchw() -> List<LayoutRule> {
    return [rule("X", ["Batch", "Chan", "Row", "Col"])];
}

test "Reshape merges adjacent axes into one named by its parts" {
    let source = `g (float[1, 16, 4, 4] X) => (float[1, 256] Y) <int64[2] S = {1, 256}> {
        Y = Reshape(X, S)
    }`;
    assert y_axes(source, nchw()).unwrap() == "Batch=1,Merged<[Chan, Row, Col]>=256";
}

test "Reshape reads 0 as the input's extent and -1 as what remains" {
    let source = `g (float[1, 16, 4, 4] X) => (float[1, 256] Y) <int64[2] S = {0, -1}> {
        Y = Reshape(X, S)
    }`;
    assert y_axes(source, nchw()).unwrap() == "Batch=1,Merged<[Chan, Row, Col]>=256";
}

test "a Reshape target the graph computes from Shape folds at build time" {
    // An exporter's spelling of `x.view(x.size(0), -1)`.
    let source = `g (float[2, 3, 4] X) => (float[2, 12] Y) <int64[1] M = {-1}> {
        S = Shape(X)
        I = Constant<value_int = 0>()
        B = Gather(S, I)
        A = Constant<value_ints = [0]>()
        U = Unsqueeze(B, A)
        T = Concat<axis = 0>(U, M)
        Y = Reshape(X, T)
    }`;
    assert y_axes(source, [rule("X", ["Batch", "Row", "Col"])]).unwrap() == "Batch=2,Merged<[Row, Col]>=12";
}

/// An attention mask as an exporter writes it: an int64 input reshaped and
/// widened by two unit axes before it becomes a float.
global MASK: String = `g (int64[1, 4] M) => (float[1, 1, 1, 4] Y) <int64[2] T = {1, -1}> {
    R = Reshape(M, T)
    A = Constant<value_ints = [1]>()
    U = Unsqueeze(R, A)
    B = Constant<value_ints = [2]>()
    V = Unsqueeze(U, B)
    Y = Cast<to = 1>(V)
}`;

fn mask_layout() -> List<LayoutRule> {
    return [
        rule("M", ["Batch", "Key"]),
        rule("U", ["Batch", "Head", "Key"]),
        rule("V", ["Batch", "Head", "Query", "Key"]),
    ];
}

test "an int64 input keeps its element until Cast makes it a float" {
    let graph = read(&MASK).unwrap();
    let checked = infer(&graph, &Schema { layout: mask_layout() }).unwrap();
    assert checked.primitives["R"] == "i64";
    assert checked.primitives["V"] == "i64";
    assert checked.primitives["Y"] == "f32";
    assert y_axes(MASK, mask_layout()).unwrap() == "Batch=1,Head=1,Query=1,Key=4";
}

test "arithmetic on an int64 tensor stops the build" {
    let source = `g (int64[4] M) => (int64[4] Y) {
        Y = Add(M, M)
    }`;
    assert y_axes(source, [rule("M", ["Key"])]).unwrap_err() == "Y = Add: operand M is i64, and Add computes in f32";
}

test "Where broadcasts its three operands and takes its branches' element" {
    let source = `g (float[1, 1, 4, 4] M, float[2, 3, 4, 4] X) => (float[2, 3, 4, 4] Y) <float S> {
        C = Cast<to = 9>(M)
        Y = Where(C, X, S)
    }`;
    let layout: List<LayoutRule> = [
        rule("M", ["Batch", "Head", "Query", "Key"]),
        rule("X", ["Batch", "Head", "Query", "Key"]),
    ];
    assert y_axes(source, layout).unwrap() == "Batch=2,Head=3,Query=4,Key=4";
}

test "a Where condition other than bool stops the build" {
    let source = `g (float[4] M, float[4] X) => (float[4] Y) {
        Y = Where(M, X, X)
    }`;
    assert y_axes(source, [rule("*", ["Key"])]).unwrap_err() == "Y = Where: operand M is f32, and Where selects with bool";
}

test "Where between two element types stops the build" {
    let source = `g (float[4] M, float[4] X, int64[4] I) => (float[4] Y) {
        C = Cast<to = 9>(M)
        Y = Where(C, X, I)
    }`;
    assert y_axes(source, [rule("*", ["Key"])]).unwrap_err() == "Y = Where: operand X is f32 and I is i64, and Where returns one of them";
}

test "Gather along axis 0 puts the indices' axes where the row's was" {
    let source = `g (int64[1, 4] I) => (float[1, 4, 8] Y) <float[16, 8] W> {
        Y = Gather(W, I)
    }`;
    let layout: List<LayoutRule> = [
        rule("I", ["Batch", "Seq"]),
        rule("W", ["Vocab", "Hidden"]),
    ];
    assert y_axes(source, layout).unwrap() == "Batch=1,Seq=4,Hidden=8";
}

test "Gather indexing with floats stops the build" {
    let source = `g (float[4] I) => (float[4, 8] Y) <float[16, 8] W> {
        Y = Gather(W, I)
    }`;
    let layout: List<LayoutRule> = [
        rule("I", ["Seq"]),
        rule("W", ["Vocab", "Hidden"]),
    ];
    assert y_axes(source, layout).unwrap_err() == "Y = Gather: operand I is f32, and Gather indexes with i64";
}

test "an output declared as an element other than the one computed stops the build" {
    let source = `g (int64[4] M) => (float[4] Y) {
        Y = Identity(M)
    }`;
    assert y_axes(source, [rule("M", ["Key"])]).unwrap_err() == "Y: declared float and computed in i64";
}

test "a Reshape to the Shape of a symbolic tensor keeps its axes" {
    let source = `g (float[N, 3] X) => (float[N, 3] Y) {
        S = Shape(X)
        Y = Reshape(X, S)
    }`;
    assert y_axes(source, [rule("X", ["Batch", "Col"])]).unwrap() == "Batch=N,Col=3";
}

test "a Reshape's -1 takes what the symbolic rest leaves" {
    // An exporter writes `x.view(-1, x.size(1))` as a Shape, a Gather and a
    // Concat, so the target holds the symbol itself.
    let source = `g (float[B, N, 4] X) => (float[B, N, 4] Y) <int64[1] Minus = {-1}, int64[1] Four = {4}, int64[1] Zero = {0}> {
        One = Constant <value = int64 {1}> ()
        S = Shape(X)
        N = Gather <axis = 0> (S, One)
        U = Unsqueeze(N, Zero)
        T = Concat <axis = 0> (Minus, U, Four)
        Y = Reshape(X, T)
    }`;
    assert y_axes(source, [rule("X", ["Batch", "Seq", "Dim"])]).unwrap() == "Batch=B,Seq=N,Dim=4";
}

test "a Reshape merging symbolic axes gives the merge their product" {
    let source = `g (float[B, N, 4] X) => (float[?, 4] Y) <int64[2] T = {-1, 4}> {
        Y = Reshape(X, T)
    }`;
    assert y_axes(source, [rule("X", ["Batch", "Seq", "Dim"])]).unwrap() == "Merged<[Batch, Seq]>=B * N,Dim=4";
}

test "Reshape splits a merged axis back into its parts" {
    let source = `g (float[2, 3, 4] X) => (float[2, 3, 4] Y) <int64[2] F = {2, 12}, int64[3] S = {2, 3, 4}> {
        M = Reshape(X, F)
        Y = Reshape(M, S)
    }`;
    assert y_axes(source, [rule("X", ["Batch", "Row", "Col"])]).unwrap() == "Batch=2,Row=3,Col=4";
}

test "Reshape drops an extent-1 axis it merges past" {
    let source = `g (float[2, 16, 1, 1] X) => (float[2, 16] Y) <int64[2] S = {2, 16}> {
        Y = Reshape(X, S)
    }`;
    assert y_axes(source, nchw()).unwrap() == "Batch=2,Chan=16";
}

test "Flatten merges the axes on each side of its axis" {
    let source = `g (float[2, 16, 4, 4] X) => (float[2, 256] Y) {
        Y = Flatten <axis = 1> (X)
    }`;
    assert y_axes(source, nchw()).unwrap() == "Batch=2,Merged<[Chan, Row, Col]>=256";
}

test "Flatten at axis 0 puts a new unit axis first" {
    let source = `g (float[2, 3] X) => (float[1, 6] Y) {
        Y = Flatten <axis = 0> (X)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Row", "Col"]),
        rule("Y", ["One", "Cells"]),
    ];
    assert y_axes(source, layout).unwrap() == "One=1,Merged<[Row, Col]>=6";
}

test "an axis no regrouping determines stops the build without a layout" {
    let source = `g (float[2, 12] X) => (float[2, 3, 4] Y) <int64[3] S = {2, 3, 4}> {
        Y = Reshape(X, S)
    }`;
    let e = y_axes(source, [rule("X", ["Batch", "Wide"])]).unwrap_err();
    assert e == "Y = Reshape: axis 1 regroups none of the operand's axes, so a layout pattern must name Y's";
}

test "an axis no regrouping determines takes the output's layout name" {
    let source = `g (float[2, 12] X) => (float[2, 1, 3, 4] Y) <int64[4] S = {2, 1, 3, 4}> {
        Y = Reshape(X, S)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Batch", "Wide"]),
        rule("Y", ["Batch", "One", "Three", "Four"]),
    ];
    assert y_axes(source, layout).unwrap() == "Batch=2,One=1,Three=3,Four=4";
}

test "a Reshape target computed at run time stops the build" {
    let source = `g (float[2, 12] X, float[2] S) => (float[24] Y) {
        Y = Reshape(X, S)
    }`;
    let e = y_axes(source, [
        rule("X", ["Batch", "Wide"]),
        rule("S", ["Two"]),
    ]).unwrap_err();
    assert e == "Y = Reshape: operand S is computed at run time, and the build reads it";
}

test "a Reshape target that changes the element count stops the build" {
    let source = `g (float[2, 12] X) => (float[5, 5] Y) <int64[2] S = {5, 5}> {
        Y = Reshape(X, S)
    }`;
    let e = y_axes(source, [rule("X", ["Batch", "Wide"])]).unwrap_err();
    assert e == "Y = Reshape: 24 elements cannot take the shape [5, 5]";
}

/// The axis of `Y`, which slices an axis of 8 from `start` to `end` by `step`,
/// each an expression of `X`'s length `N`. The inputs owe nothing for it.
fn sliced(start: String, end: String, step: String = "One") -> String {
    let source = `g (float[N] X, float[8] M) => (float[?] Y) <int64[1] Z = {0}, int64[1] One = {1}, int64[1] Three = {3}, int64[1] Back = {-1}> {
        S = Shape(X)
        Y = Slice(M, ${start}, ${end}, Z, ${step})
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Seq"]),
        rule("M", ["Pos"]),
        rule("Y", ["Part"]),
    ];
    assert owed_by(source, layout).is_empty();
    return y_axes(source, layout).unwrap();
}

test "a Slice bound the build cannot decide is clamped by a length the run derives" {
    assert sliced("Z", "S") == "Part=min(N, 8)";
}

test "a Slice from a number to a symbol clamps its count at none" {
    assert sliced("Three", "S") == "Part=max(min(N, 8) - 3, 0)";
}

test "a Slice counted from a symbol's negation counts from the end only where it is negative" {
    let source = `g (float[N] X, float[8] M) => (float[?] Y) <int64[1] Z = {0}, int64[1] Eight = {8}> {
        S = Shape(X)
        B = Sub(Z, S)
        Y = Slice(M, B, Eight)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Seq"]),
        rule("M", ["Pos"]),
        rule("Y", ["Part"]),
    ];
    assert y_axes(source, layout).unwrap() == "Part=-max(from_end(-N, 8), 0) + 8";
}

test "a backward Slice starts at the last position a bound reaches" {
    assert sliced("S", "Z", "Back") == "Part=min(N, 7)";
}

test "a clamp read as its operand where the graph meets that operand is owed by the inputs" {
    let source = `g (float[N] X, float[8] M) => (float[N] Y) <int64[1] Z = {0}> {
        S = Shape(X)
        A = Slice(M, Z, S)
        Y = Add(A, X)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Seq"]),
        rule("M", ["Pos"]),
        rule("A", ["Seq"]),
    ];
    assert owed_by(source, layout) == ["A = Slice: N must be at most 8 (-N + 8 >= 0)"] as List<String>;
    assert y_axes(source, layout).unwrap() == "Seq=N";
}

test "a Slice running backwards between numbers is empty, as ONNX counts it" {
    let source = `g (float[N] X) => (float[?] Y) <int64[1] B = {5}, int64[1] E = {3}> {
        Y = Slice(X, B, E)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Seq"]),
        rule("Y", ["Part"]),
    ];
    assert y_axes(source, layout).unwrap() == "Part=0";
}

test "a Slice running backwards by a symbolic amount for every input is empty" {
    let source = `g (float[N] X, float[8] M) => (float[?] Y) <int64[1] Z = {0}, int64[1] Three = {3}> {
        S = Shape(X)
        B = Add(S, Three)
        Y = Slice(M, B, Z)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Seq"]),
        rule("M", ["Pos"]),
        rule("Y", ["Part"]),
    ];
    assert y_axes(source, layout).unwrap() == "Part=0";
}

test "a Range over a symbolic start counts a span the build knows, however it divides" {
    let source = `g (float[N] X) => (int64[?] Y, int64[?] W) <int64[1] Three = {3}, int64[1] Two = {2}> {
        S = Shape(X)
        L = Add(S, Three)
        Y = Range(S, L, Two)
        W = Range(L, S, Two)
    }`;
    let graph = read(&source).unwrap();
    let checked = infer(&graph, &Schema {
        layout: [
            rule("X", ["Seq"]),
            rule("Y", ["Pos"]),
            rule("W", ["Back"]),
        ],
    }).unwrap();
    assert checked.shapes["Y"].axes[0].extent.agrees(&Extent::Static(2));
    assert checked.shapes["W"].axes[0].extent.agrees(&Extent::Static(0));
    assert checked.owed.is_empty();
}

test "Slice bounds past either end of a symbolic axis keep it whole and owe nothing" {
    let source = `g (float[N] X) => (float[N] Y) <int64[1] B = {-4000000000}, int64[1] E = {4000000000}> {
        Y = Slice(X, B, E)
    }`;
    let graph = read(&source).unwrap();
    let checked = infer(&graph, &Schema {
        layout: [rule("X", ["Seq"])],
    }).unwrap();
    assert checked.owed.is_empty();
    assert checked.shapes["Y"].axes[0].name == "Seq";
}

test "a symbolic Slice bound past the end for every input clamps there and owes nothing" {
    let source = `g (float[N] X) => (float[N] Y) <int64[1] Z = {0}, int64[1] Three = {3}> {
        S = Shape(X)
        E = Add(S, Three)
        Y = Slice(X, Z, E)
    }`;
    let graph = read(&source).unwrap();
    let checked = infer(&graph, &Schema {
        layout: [rule("X", ["Seq"])],
    }).unwrap();
    assert checked.owed.is_empty();
    assert checked.shapes["Y"].axes[0].name == "Seq";
}

test "Slice listing an axis twice stops the build rather than guessing" {
    let source = `g (float[4] X) => (float[1] Y) <int64[2] B = {0, 1}, int64[2] E = {3, 2}, int64[2] P = {0, 0}> {
        Y = Slice(X, B, E, P)
    }`;
    let e = y_axes(source, [rule("*", ["A"])]).unwrap_err();
    assert e == "Y = Slice: axis 0 is listed twice";
}

test "an output declared static where the nodes left a symbol owes the two equal" {
    let source = `g (float[N] X) => (float[8] Y) {
        Y = Relu(X)
    }`;
    let graph = read(&source).unwrap();
    let checked = infer(&graph, &Schema {
        layout: [rule("*", ["Seq"])],
    }).unwrap();
    assert checked.shapes["Y"].axes[0].extent.agrees(&Extent::Static(8));
    let owed: List<String> = checked.owed.into_iter().map(|c| `${c.reason} (${c.slack} >= 0)`).collect();
    assert owed == [
        "Y: axis Seq must be 8, as the graph declares (N - 8 >= 0)",
        "Y: axis Seq must be 8, as the graph declares (-N + 8 >= 0)",
    ] as List<String>;
}

test "an output declared static that no symbol value produces stops the build" {
    let source = `g (float[N] X) => (int64[3] Y) <int64[1] Z = {0}, int64[1] Ten = {10}, int64[1] One = {1}> {
        S = Shape(X)
        L = Add(S, Ten)
        Y = Range(Z, L, One)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Seq"]),
        rule("Y", ["Pos"]),
    ];
    assert y_axes(source, layout).unwrap_err() == "Y: axis Pos is declared 3 and produced N + 10";
}

test "a symbolic integer cast to int32 wraps as the run does, where an extent cannot show it fits" {
    let source = `g (float[N] X) => (int64[?] Y) <int64[1] Z = {0}, int64[1] Big = {100000}, int64[1] One = {1}> {
        S = Shape(X)
        W = Cast<to = 6>(S)
        P = Mul(S, Big)
        Q = Cast<to = 6>(P)
        Y = Range(Z, Q, One)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Seq"]),
        rule("Y", ["Pos"]),
    ];
    assert owed_by(source, layout).is_empty();
    assert y_axes(source, layout).unwrap() == "Pos=max(wrap32(100000 * N), 0)";
    let graph = read(&source).unwrap();
    let checked = infer(&graph, &Schema { layout }).unwrap();
    assert checked.known["W"].elements == Elements::integers([Poly::symbol(&"N")]);
}

test "a string attribute an operator reads as a number stops the build" {
    let source = `g (float[2, 3] X) => (float[2, 3] Y) {
        Y = Softmax <axis = "1"> (X)
    }`;
    assert y_axes(source, [rule("*", ["A", "B"])]).unwrap_err() == "Y = Softmax: attribute axis holds strings, and the operator reads numbers";
}

test "a ConstantOfShape value the build cannot read, or not of one element, stops the build" {
    let layout: List<LayoutRule> = [
        rule("X", ["Len"]),
        rule("Y", ["Pos"]),
    ];
    let filled = |value: String| y_axes(
        `g (float[1] X) => (float[?] Y) <int64[1] S = {3}> {
            Y = ConstantOfShape <value = ${value}> (S)
        }`,
        layout,
    );
    assert filled("double[1] {5}").unwrap_err() == "Y = ConstantOfShape: attribute value holds no tensor the build reads";
    assert filled("3").unwrap_err() == "Y = ConstantOfShape: attribute value holds no tensor the build reads";
    assert filled("float[0] {}").unwrap_err() == "Y = ConstantOfShape: attribute value holds 0 elements, and the operator fills with one";
    assert filled("float[2] {1, 2}").unwrap_err() == "Y = ConstantOfShape: attribute value holds 2 elements, and the operator fills with one";
}

test "an attribute an operator reads as numbers, holding a tensor, stops the build" {
    let source = `g (float[1, 3] X) => (float[3] Y) {
        Y = Squeeze <axes = int64[1] {0}> (X)
    }`;
    assert y_axes(source, [rule("X", ["One", "C"])]).unwrap_err() == "Y = Squeeze: attribute axes holds a tensor, and the operator reads numbers";
}

test "a string attribute of no value, or a number where a string is read, stops the build" {
    let padded = |auto_pad: String| y_axes(
        `g (float[1, 1, 4, 4] X) => (float[1, 1, 2, 2] Y) {
            Y = MaxPool <kernel_shape = [2, 2], strides = [2, 2], auto_pad = ${auto_pad}> (X)
        }`,
        [rule("*", ["N", "C", "H", "W"])],
    );
    assert padded("[]").unwrap_err() == "Y = MaxPool: attribute auto_pad is a list and the operator reads one value";
    assert padded("3").unwrap_err() == "Y = MaxPool: attribute auto_pad holds numbers, and the operator reads a string";
}

test "a ConstantOfShape whose shape a kernel computes stops the build" {
    let source = `g (float[1] X) => (float[?] Y) {
        S = Cast <to = 7> (X)
        Y = ConstantOfShape(S)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Len"]),
        rule("Y", ["Pos"]),
    ];
    assert y_axes(source, layout).unwrap_err() == "Y = ConstantOfShape: operand S is computed at run time, and the build reads it";
}

test "a Range the run computes, longer than any list, stops the build" {
    let source = `g (float[N] X) => (int64[?] Y) <int64[1] Far = {3000000000}, int64[1] One = {1}> {
        S = Shape(X)
        L = Add(S, Far)
        Y = Range(S, L, One)
    }`;
    let e = y_axes(source, [rule("*", ["Seq"])]).unwrap_err();
    assert e == "Y = Range: 3000000000 elements are more than a list holds";
}

test "a condition every layer repeats is owed once" {
    let source = `g (float[N] X, float[8] M) => (float[N] Y) <int64[1] Z = {0}> {
        S = Shape(X)
        A = Slice(M, Z, S)
        B = Slice(M, Z, S)
        C = Add(A, X)
        Y = Add(B, C)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Seq"]),
        rule("M", ["Pos"]),
        rule("A", ["Seq"]),
        rule("B", ["Seq"]),
    ];
    let graph = read(&source).unwrap();
    assert infer(&graph, &Schema { layout }).unwrap().owed.len() == 1;
}

test "a Reshape carries a symbolic extent past the axes it splits" {
    let source = `g (float[N, 12] X) => (float[N, 3, 4] Y) <int64[3] S = {0, 3, 4}> {
        Y = Reshape(X, S)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Batch", "Wide"]),
        rule("Y", ["Batch", "Row", "Col"]),
    ];
    assert y_axes(source, layout).unwrap() == "Batch=N,Row=3,Col=4";
}

test "a Reshape whose target cannot hold the symbolic count stops the build" {
    let source = `g (float[N, 12] X) => (float[N, 3, 4] Y) <int64[2] S = {3, 4}> {
        Y = Reshape(X, S)
    }`;
    let e = y_axes(source, [rule("X", ["Batch", "Wide"])]).unwrap_err();
    assert e == "Y = Reshape: 12 * N elements cannot take the shape [3, 4]";
}

fn pooled() -> List<LayoutRule> {
    return [
        rule("X", ["Batch", "Chan", "Row", "Col"]),
        rule("Y", ["Batch", "Chan", "PRow", "PCol"]),
    ];
}

test "MaxPool names its window's output axes from the output's layout" {
    let source = `g (float[1, 3, 7, 7] X) => (float[1, 3, 4, 4] Y) {
        Y = MaxPool <kernel_shape = [3, 3], strides = [2, 2], pads = [1, 1, 1, 1]> (X)
    }`;
    assert y_axes(source, pooled()).unwrap() == "Batch=1,Chan=3,PRow=4,PCol=4";
}

test "MaxPool rounds its output extent up under ceil_mode" {
    let source = `g (float[1, 1, 5, 5] X) => (float[1, 1, 3, 3] Y) {
        Y = MaxPool <kernel_shape = [2, 2], strides = [2, 2], ceil_mode = 1> (X)
    }`;
    assert y_axes(source, pooled()).unwrap() == "Batch=1,Chan=1,PRow=3,PCol=3";
}

test "a window's output axis stops the build without a layout" {
    let source = `g (float[1, 3, 7, 7] X) => (float[1, 3, 3, 3] Y) {
        Y = MaxPool <kernel_shape = [2, 2], strides = [2, 2]> (X)
    }`;
    let e = y_axes(source, nchw()).unwrap_err();
    assert e == "Y = MaxPool: axis 2 is a window's output, so a layout pattern must name Y's";
}

fn convolved() -> List<LayoutRule> {
    return [
        rule("X", ["Batch", "Chan", "Row", "Col"]),
        rule("W", ["Out", "Chan", "KRow", "KCol"]),
        rule("B", ["Out"]),
        rule("Y", ["Batch", "Out", "Row", "Col"]),
    ];
}

test "Conv under SAME_UPPER keeps the spatial extents" {
    let source = `g (float[1, 1, 28, 28] X) => (float[1, 8, 28, 28] Y) <float[8, 1, 5, 5] W> {
        Y = Conv <kernel_shape = [5, 5], auto_pad = "SAME_UPPER"> (X, W)
    }`;
    assert y_axes(source, convolved()).unwrap() == "Batch=1,Out=8,Row=28,Col=28";
}

test "Conv reads its kernel off the weight and its bias checks against the output channels" {
    let source = `g (float[2, 3, 7, 5] X) => (float[2, 4, 5, 4] Y) <float[4, 3, 3, 2] W, float[4] B> {
        Y = Conv (X, W, B)
    }`;
    assert y_axes(source, convolved()).unwrap() == "Batch=2,Out=4,Row=5,Col=4";
}

test "Conv whose weight reads another channel count stops the build" {
    let source = `g (float[1, 1, 28, 28] X) => (float[1, 8, 24, 24] Y) <float[8, 2, 5, 5] W> {
        Y = Conv (X, W)
    }`;
    let e = y_axes(source, convolved()).unwrap_err();
    assert e == "Y = Conv: axis Chan is 1 on the left and 2 on the right";
}

fn grouped() -> List<LayoutRule> {
    return [
        rule("X", ["Batch", "Chan", "Row", "Col"]),
        rule("W", ["Out", "Share", "KRow", "KCol"]),
        rule("Y", ["Batch", "Out", "Row", "Col"]),
    ];
}

test "Conv over several groups reads a group's share of the input channels" {
    let source = `g (float[1, 4, 8, 8] X) => (float[1, 6, 6, 6] Y) <float[6, 2, 3, 3] W> {
        Y = Conv <group = 2> (X, W)
    }`;
    assert y_axes(source, grouped()).unwrap() == "Batch=1,Out=6,Row=6,Col=6";
}

test "Conv groups sharing out other than all the input channels stop the build" {
    let source = `g (float[1, 4, 8, 8] X) => (float[1, 6, 6, 6] Y) <float[6, 1, 3, 3] W> {
        Y = Conv <group = 2> (X, W)
    }`;
    assert y_axes(source, grouped()).unwrap_err() == "Y = Conv: axis Chan is 4 on the left and 2 on the right";
}

test "a Conv of one group refuses a weight naming the input channels apart" {
    let source = `g (float[1, 4, 8, 8] X) => (float[1, 6, 6, 6] Y) <float[6, 4, 3, 3] W> {
        Y = Conv (X, W)
    }`;
    assert y_axes(source, grouped()).unwrap_err() == "Y = Conv: axis Chan on the left meets Share on the right, and only an axis of 1 takes another's name";
}

test "a Conv refuses a bias naming the output channels apart" {
    let source = `g (float[1, 4, 8, 8] X) => (float[1, 6, 6, 6] Y) <float[6, 4, 3, 3] W, float[6] B> {
        Y = Conv (X, W, B)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Batch", "Chan", "Row", "Col"]),
        rule("W", ["Out", "Chan", "KRow", "KCol"]),
        rule("B", ["Bias"]),
        rule("Y", ["Batch", "Out", "Row", "Col"]),
    ];
    assert y_axes(source, layout).unwrap_err() == "Y = Conv: axis Out on the left meets Bias on the right, and only an axis of 1 takes another's name";
}

test "a grouped Conv over a scalar weight stops the build on the weight's rank" {
    let source = `g (float[1, 4, 8, 8] X) => (float[1, 6, 6, 6] Y) <float W = {1}> {
        Y = Conv <group = 2> (X, W)
    }`;
    let e = y_axes(source, grouped()).unwrap_err();
    assert e == "Y = Conv: operand 1 has rank 0 and the operator reads rank 4";
}

test "a Conv group count that does not divide the output channels stops the build" {
    let source = `g (float[1, 4, 8, 8] X) => (float[1, 6, 6, 6] Y) <float[6, 1, 3, 3] W> {
        Y = Conv <group = 4> (X, W)
    }`;
    let e = y_axes(source, grouped()).unwrap_err();
    assert e == "Y = Conv: attribute group is 4, which does not divide the 6 output channels";
}

test "a node reading an undefined tensor stops the build" {
    let graph = read(
        `agraph (float[2, 3] X) => (float[2, 3] Y) {
            Y = Add(X, Missing)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["A", "B"])],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "Missing: no graph input, initializer or node defines this";
}

test "a tensor of more elements than a list holds stops the build, however it arises" {
    let declared = `g (float[N, 65536, 65536] X) => (float[N, 65536, 65536] Y) {
        Y = Relu(X)
    }`;
    assert y_axes(declared, [rule("*", ["B", "R", "C"])]).unwrap_err() == "X: its extents multiply past what a list can hold";

    // Empty, but a kernel counting the trailing axes would still overflow.
    let empty = `g (float[0, 65536, 65536] X) => (float[0, 65536, 65536] Y) {
        Y = Relu(X)
    }`;
    assert y_axes(empty, [rule("*", ["B", "R", "C"])]).unwrap_err() == "X: its extents multiply past what a list can hold";

    let produced = `g (float[65536, 1] A, float[1, 65536] B) => (float[65536, 65536] Y) {
        Y = MatMul(A, B)
    }`;
    let layout: List<LayoutRule> = [
        rule("A", ["R", "K"]),
        rule("B", ["K", "C"]),
        rule("Y", ["R", "C"]),
    ];
    assert y_axes(produced, layout).unwrap_err() == "Y: its extents multiply past what a list can hold";
}

test "a symbolic integer some input could carry past i64 stops the build, since the run would wrap it" {
    let source = `g (float[N] X) => (int64[1] Y) <int64[1] Big = {5000000000000000000}> {
        S = Shape(X)
        Y = Mul(S, Big)
    }`;
    assert y_axes(source, [rule("X", ["Seq"])]).unwrap_err() == "Y = Mul: N Mul 5000000000000000000 leaves i64";
}

test "a Reshape target whose symbolic extents multiply past i64 stops the build rather than trapping" {
    let source = `g (float[N] X) => (float[?, ?, ?] Y) <int64[1] Big = {3000000000}> {
        S = Shape(X)
        B = Mul(S, Big)
        T = Concat<axis = 0>(B, B, B)
        Y = Reshape(X, T)
    }`;
    let e = y_axes(source, [rule("X", ["Seq"])]).unwrap_err();
    assert e == "Y = Reshape: the target shape [3000000000 * N, 3000000000 * N, 3000000000 * N] multiplies past what a list can hold";
}

/// What the inputs owe a graph, as `reason (slack >= 0)`.
fn owed_by(source: String, layout: List<LayoutRule>) -> List<String> {
    let graph = read(&source).unwrap();
    let checked = infer(&graph, &Schema { layout }).unwrap();
    return checked.owed.into_iter().map(|c| `${c.reason} (${c.slack} >= 0)`).collect();
}

test "a symbolic Reshape extent owes that it is not 0, which would copy the input's extent instead" {
    let source = `g (float[4, N] X) => (float[N, 4] Y) <int64[1] Four = {4}, int64[1] One = {1}, int64[1] Two = {2}> {
        S = Shape(X)
        L = Slice(S, One, Two)
        T = Concat<axis = 0>(L, Four)
        Y = Reshape(X, T)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Row", "Col"]),
        rule("Y", ["Col", "Row"]),
    ];
    assert owed_by(source, layout) == [
        "Y = Reshape: the target's N must not be 0, which reads the input's extent 4 instead (N - 1 >= 0)",
    ] as List<String>;
}

test "a symbolic Reshape extent that is the input's own at its position owes nothing, since 0 copies the same" {
    let source = `g (float[N, 4] X) => (float[N, 2, 2] Y) <int64[1] Z = {0}, int64[1] One = {1}, int64[2] Halves = {2, 2}> {
        S = Shape(X)
        L = Slice(S, Z, One)
        T = Concat<axis = 0>(L, Halves)
        Y = Reshape(X, T)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Row", "Col"]),
        rule("Y", ["Row", "Half", "Pair"]),
    ];
    assert owed_by(source, layout).is_empty();
}

test "a Reshape -1 beside a symbolic extent owes that the rest do not multiply to 0" {
    let source = `g (float[N, 4] X) => (float[N, 4] Y) <int64[1] Z = {0}, int64[1] One = {1}, int64[1] Rest = {-1}> {
        S = Shape(X)
        L = Slice(S, Z, One)
        T = Concat<axis = 0>(L, Rest)
        Y = Reshape(X, T)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Row", "Col"]),
        rule("Y", ["Row", "Col"]),
    ];
    assert owed_by(source, layout) == [
        "Y = Reshape: the target's extents besides -1 multiply to N, which must not be 0 (N - 1 >= 0)",
    ] as List<String>;
}

test "int32 arithmetic the build folds keeps the low 32 bits, as the run's int32 does" {
    let source = `g (float[1] X) => (int64[1] Y) <int32[1] A = {50000}> {
        M = Mul(A, A)
        Y = Cast<to = 7>(M)
    }`;
    let graph = read(&source).unwrap();
    let checked = infer(&graph, &Schema {
        layout: [rule("*", ["One"])],
    }).unwrap();
    assert checked.known["Y"].elements == Elements::Ints([-1794967296]);
}

test "symbolic int32 arithmetic wraps as the run does, as a Cast to int32 does" {
    let source = `g (float[N] X) => (int64[1] Y) {
        S = Shape(X)
        W = Cast<to = 6>(S)
        P = Mul(W, W)
        Y = Cast<to = 7>(P)
    }`;
    let graph = read(&source).unwrap();
    let checked = infer(&graph, &Schema {
        layout: [rule("*", ["Seq"])],
    }).unwrap();
    assert checked.owed.is_empty();
    let Symbolic(values) = checked.known["Y"].elements else {
        unreachable();
    };
    assert `${values[0]}` == "wrap32(N * N)";
}

test "a Reshape whose count agrees once a clamp is read as its operand owes that reading" {
    let source = `g (float[N] X, float[8] M) => (float[N] Y) <int64[1] Z = {0}> {
        S = Shape(X)
        A = Slice(M, Z, S)
        Y = Reshape(A, S)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Seq"]),
        rule("M", ["Pos"]),
        rule("A", ["Part"]),
        rule("Y", ["Seq"]),
    ];
    assert owed_by(source, layout) == ["A = Slice: N must be at most 8 (-N + 8 >= 0)"] as List<String>;
    assert y_axes(source, layout).unwrap() == "Seq=N";
}

test "a Reshape -1 the build cannot divide out rounds down, and owes that the rest divide the count" {
    let source = `g (float[N] X) => (float[?, 2] Y) <int64[2] T = {-1, 2}> {
        Y = Reshape(X, T)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Seq"]),
        rule("Y", ["Pair", "Two"]),
    ];
    assert owed_by(source, layout) == [
        "Y = Reshape: the target's extents besides -1 multiply to 2, which must divide N (-N + 2 * floor(N / 2) >= 0)",
    ] as List<String>;
    assert y_axes(source, layout).unwrap() == "Pair=floor(N / 2),Two=2";
}

/// Both branches of an `If` over `X`, each `then_body` / `else_body` producing
/// its one output from the outer scope.
fn branching(declared: String, cond: String, then_body: String, else_body: String) -> String {
    return `g (${cond} C, float[N, 4] X, float[N, 4] Z) => (${declared} Y) {
        Y = If <then_branch = t () => (${declared} A) { ${then_body} }, else_branch = e () => (${declared} B) { ${else_body} }> (C)
    }`;
}

fn branch_layout() -> List<LayoutRule> {
    return [
        rule("C", ["One"]),
        rule("X", ["Seq", "Embed"]),
        rule("Z", ["Seq", "Embed"]),
    ];
}

test "an If's output is its branches' shape where the two agree" {
    let source = branching("float[N, 4]", "bool[1]", "A = Relu(X)", "B = Neg(Z)");
    assert y_axes(source, branch_layout()).unwrap() == "Seq=N,Embed=4";
}

test "each branch keeps the tensors it computes, apart from the other's" {
    let graph = read(&branching("float[N, 4]", "bool[1]", "H = Relu(X) A = Neg(H)", "H = Neg(Z) B = Relu(H)")).unwrap();
    let checked = infer(&graph, &Schema { layout: branch_layout() }).unwrap();
    let [then_branch, else_branch] = checked.branches["Y"];
    assert then_branch.shapes.contains_key("H") && then_branch.shapes.contains_key("A");
    assert else_branch.shapes.contains_key("B") && !else_branch.shapes.contains_key("A");
    assert !checked.shapes.contains_key("H");
}

test "an If's output takes a fresh length where its branches' lengths differ" {
    let source = `g (bool[1] C, float[N, 4] X, float[M, 4] P) => (float[?, 4] Y) {
        Y = If <then_branch = t () => (float[?, 4] A) { A = Concat<axis = 0>(P, X) }, else_branch = e () => (float[N, 4] B) { B = Relu(X) }> (C)
    }`;
    let layout: List<LayoutRule> = [
        rule("C", ["One"]),
        rule("X", ["Seq", "Embed"]),
        rule("P", ["Past", "Embed"]),
        rule("A", ["Total", "Embed"]),
        rule("Y", ["Total", "Embed"]),
    ];
    assert y_axes(source, layout).unwrap() == `Total="Y[0]",Embed=4`;
}

test "an If's output axis named apart in its branches is named by the output's layout" {
    let layout: List<LayoutRule> = [
        rule("C", ["One"]),
        rule("X", ["Seq", "Embed"]),
        rule("Z", ["Other", "Embed"]),
        rule("Y", ["Either", "Embed"]),
    ];
    let source = branching("float[N, 4]", "bool[1]", "A = Relu(X)", "B = Neg(Z)");
    assert y_axes(source, layout).unwrap() == "Either=N,Embed=4";
    let unnamed: List<LayoutRule> = [
        rule("C", ["One"]),
        rule("X", ["Seq", "Embed"]),
        rule("Z", ["Other", "Embed"]),
    ];
    assert y_axes(source, unnamed).unwrap_err() == "Y = If: axis 0 is named apart in its branches, so a layout pattern must name Y's";
}

test "a layout rule naming a graph reaches only that graph's tensors" {
    let with_shape = `g (bool[1] C, float[2, 3] X) => (float[3, 2] Y) <int64[2] S = {3, 2}> {
        Y = If <then_branch = t () => (float[3, 2] A) { A = Reshape(X, S) }, else_branch = e () => (float[3, 2] B) { B = Reshape(X, S) }> (C)
    }`;
    let layout: List<LayoutRule> = [
        rule("C", ["One"]),
        rule("X", ["Row", "Col"]),
        LayoutRule {
            pattern: "A",
            axes: ["Three", "Two"],
            graph: Option::Some("t"),
        },
        LayoutRule {
            pattern: "*",
            axes: ["Three", "Two"],
            graph: Option::Some("e"),
        },
    ];
    assert y_axes(with_shape, layout).unwrap() == "Three=3,Two=2";
    let top_only: List<LayoutRule> = [
        rule("C", ["One"]),
        rule("X", ["Row", "Col"]),
        LayoutRule {
            pattern: "*",
            axes: ["Three", "Two"],
            graph: Option::Some("g"),
        },
    ];
    assert y_axes(with_shape, top_only).unwrap_err().ends_with("so a layout pattern must name A's");
}

test "what a branch owes is owed only where it runs" {
    let source = `g (bool[1] C, float[N, 4] X, float[M, 4] Z) => (float[N, 4] Y) {
        Y = If <then_branch = t () => (float[N, 4] A) { A = Add(X, Z) }, else_branch = e () => (float[N, 4] B) { B = Relu(X) }> (C)
    }`;
    let graph = read(&source).unwrap();
    let checked = infer(&graph, &Schema { layout: branch_layout() }).unwrap();
    assert checked.owed.is_empty();
    let [then_branch, else_branch] = checked.branches["Y"];
    assert then_branch.owed.len() == 2;
    assert else_branch.owed.is_empty();
}

test "an If's condition is one bool" {
    let source = branching("float[N, 4]", "float[1]", "A = Relu(X)", "B = Neg(Z)");
    assert y_axes(source, branch_layout()).unwrap_err() == "Y = If: operand C is f32, and If branches on bool";
    let two = branching("float[N, 4]", "bool[2]", "A = Relu(X)", "B = Neg(Z)");
    let mut layout: List<LayoutRule> = [rule("C", ["Two"])];
    layout.extend(&branch_layout());
    assert y_axes(two, layout).unwrap_err() == "Y = If: operand C holds 2 elements, and If branches on one";
}

test "an If's branches agree on each output's rank and element" {
    let rank = `g (bool[1] C, float[N, 4] X) => (float[N, 4] Y) <int64[1] Axes = {1}> {
        Y = If <then_branch = t () => (float[N, 4] A) { A = Relu(X) }, else_branch = e () => (float[N] B) { B = ReduceSum<keepdims = 0>(X, Axes) }> (C)
    }`;
    assert y_axes(rank, branch_layout()).unwrap_err() == "Y = If: output 0 has rank 2 in then_branch and 1 in else_branch";
    let element = `g (bool[1] C, float[N, 4] X) => (float[N, 4] Y) {
        Y = If <then_branch = t () => (float[N, 4] A) { A = Relu(X) }, else_branch = e () => (int64[N, 4] B) { B = Cast<to = 7>(X) }> (C)
    }`;
    assert y_axes(element, branch_layout()).unwrap_err() == "Y = If: output 0 is f32 in then_branch and i64 in else_branch";
}

test "an If's branches give as many outputs as it names" {
    let source = `g (bool[1] C, float[N, 4] X) => (float[N, 4] Y) {
        Y = If <then_branch = t () => (float[N, 4] A, float[N, 4] A2) { A = Relu(X) A2 = Neg(X) }, else_branch = e () => (float[N, 4] B) { B = Relu(X) }> (C)
    }`;
    assert y_axes(source, branch_layout()).unwrap_err() == "Y = If: then_branch gives 2 outputs, and the node names 1";
}

test "a branch that takes inputs is refused" {
    let source = `g (bool[1] C, float[N, 4] X) => (float[N, 4] Y) {
        Y = If <then_branch = t (float[N, 4] I) => (float[N, 4] A) { A = Relu(I) }, else_branch = e () => (float[N, 4] B) { B = Relu(X) }> (C)
    }`;
    assert y_axes(source, branch_layout()).unwrap_err() == "Y = If: then_branch declares inputs, and a branch reads only the scope around it";
}

test "a tensor defined twice in one scope is refused" {
    let over_input = `g (float[N, 4] X) => (float[N, 4] X) {
        X = Relu(X)
    }`;
    assert y_axes(over_input, branch_layout()).unwrap_err() == "X = Relu: X is already defined in its graph";
    let twice = `g (float[N, 4] X) => (float[N, 4] Y) {
        Y = Relu(X)
        Y = Neg(X)
    }`;
    let mut layout = branch_layout();
    layout.push(rule("Y", ["Seq", "Embed"]));
    assert y_axes(twice, layout).unwrap_err() == "Y = Neg: Y is already defined in its graph";
}

test "two branches may name a tensor alike, and a branch may not redefine one around it" {
    let alike = branching("float[N, 4]", "bool[1]", "T = Relu(X) A = Neg(T)", "T = Neg(Z) B = Relu(T)");
    assert y_axes(alike, branch_layout()).unwrap() == "Seq=N,Embed=4";
    let shadowing = branching("float[N, 4]", "bool[1]", "X = Relu(Z) A = Neg(X)", "B = Neg(Z)");
    assert y_axes(shadowing, branch_layout()).unwrap_err() == "X = Relu: X is already defined in its graph";
}

test "a constant around the branches keeps the shape the layout around them gives it" {
    let source = `g (bool[1] C, float[2] X, float[2] H) => (float[2] Y) {
        K = Constant<value_floats = [1.0, 2.0]>()
        V = If <then_branch = t () => (float[2] A) { A = Mul(H, K) }, else_branch = e () => (float[2] B) { B = Add(H, K) }> (C)
        Y = Add(X, K)
    }`;
    let layout: List<LayoutRule> = [
        rule("C", ["One"]),
        rule("X", ["Embed"]),
        rule("H", ["Hidden"]),
        rule("V", ["Hidden"]),
        LayoutRule {
            pattern: "K",
            axes: ["Hidden"],
            graph: Option::Some("t"),
        },
        LayoutRule {
            pattern: "K",
            axes: ["Hidden"],
            graph: Option::Some("e"),
        },
        rule("K", ["Embed"]),
    ];
    assert y_axes(source, layout).unwrap() == "Embed=2";
}

test "a spelled length over names no input binds alone is one symbol" {
    let source = `g (float["batch * seq", 4] X) => (float["batch * seq", 4] Y) {
        Y = Relu(X)
    }`;
    assert y_axes(source, [rule("X", ["Rows", "Embed"])]).unwrap() == "Rows=\"batch * seq\",Embed=4";
}

test "a spelled length over names the inputs bind stays arithmetic" {
    let source = `g (float["n + 1", 4] X, float[n, 4] P) => (float["n + 1", 4] Y) {
        Y = Relu(X)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Seq", "Embed"]),
        rule("P", ["Past", "Embed"]),
    ];
    assert y_axes(source, layout).unwrap() == "Seq=n + 1,Embed=4";
}
