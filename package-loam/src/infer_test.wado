//! Stage 0 over a two-layer MLP: what it proves, and what it stops the build
//! for.

use { Extent } from "./extent.wado";
use { Checked, infer } from "./infer.wado";
use { read } from "./onnx_text.wado";
use { LayoutRule, Schema } from "./schema.wado";

fn rule(pattern: String, axes: List<String>) -> LayoutRule {
    return LayoutRule { pattern, axes };
}

/// The MLP's schema. `Hidden` names an output axis on the first layer and an
/// input axis on the second, which is what makes the two layers check.
fn mlp_schema() -> Schema {
    return Schema {
        layout: [
            rule("X", ["Batch", "In"]),
            rule("W1", ["In", "Hidden"]),
            rule("B1", ["Hidden"]),
            rule("W2", ["Hidden", "Out"]),
            rule("B2", ["Out"]),
        ],
    };
}

fn mlp(hidden_in_w2: i32) -> String {
    return `mlp (float[N, 128] X) => (float[N, 10] Y)
    <float[128, 64] W1, float[64] B1, float[${hidden_in_w2}, 10] W2, float[10] B2>
    {
        H = MatMul(X, W1)
        HB = Add(H, B1)
        A = Relu(HB)
        T = MatMul(A, W2)
        Y = Add(T, B2)
    }`;
}

fn infer_mlp(hidden_in_w2: i32) -> Result<String, String> {
    let graph = read(&mlp(hidden_in_w2)).unwrap();
    return match infer(&graph, &mlp_schema()) {
        Ok(Checked { shapes, .. }) => {
            let y = shapes["Y"];
            Result::Ok(`${y.axes[0].name}=${y.axes[0].extent},${y.axes[1].name}=${y.axes[1].extent}`);
        },
        Err(e) => Result::Err(`${e}`),
    };
}

test "a consistent MLP infers its output shape" {
    assert infer_mlp(64).unwrap() == "Batch=N,Out=10";
}

test "an extent mismatch between the layers names both extents" {
    assert infer_mlp(32).unwrap_err() == "T = MatMul: axis Hidden is 64 on the left and 32 on the right";
}

test "a symbolic batch axis flows through both layers" {
    let graph = read(&mlp(64)).unwrap();
    let shapes = infer(&graph, &mlp_schema()).unwrap().shapes;
    assert shapes["H"].axes[0].extent.agrees(&Extent::Symbol("N"));
    assert shapes["Y"].axes[0].extent.agrees(&Extent::Symbol("N"));
}

test "a bias broadcasts against the batch axis ahead of it" {
    let graph = read(&mlp(64)).unwrap();
    let shapes = infer(&graph, &mlp_schema()).unwrap().shapes;
    assert shapes["HB"].rank() == 2;
    assert shapes["HB"].axes[1].name == "Hidden";
}

test "a tensor no pattern reaches stops the build naming it" {
    let graph = read(&mlp(64)).unwrap();
    let partial = Schema {
        layout: [rule("X", ["Batch", "In"])],
    };
    let e = infer(&graph, &partial).unwrap_err();
    assert `${e}` == "W1: no layout pattern names this tensor's axes";
}

test "a pattern naming the wrong number of axes stops the build" {
    let graph = read(&mlp(64)).unwrap();
    let mut schema = mlp_schema();
    schema.layout[1] = rule("W1", ["In"]);
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "W1: the schema names 1 axes and the graph gives 2 dimensions";
}

test "an operator with no shape rule stops the build naming it" {
    let graph = read(
        `agraph (float[2, 3] X) => (float[2, 3] Y) {
            Y = LpNormalization(X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["A", "B"])],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "LpNormalization: no shape rule for this operator";
}

test "a wildcard pattern reaches every tensor" {
    let graph = read(
        `agraph (float[2, 3] X) => (float[2, 3] Y) {
            Y = Relu(X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["A", "B"])],
    };
    let shapes = infer(&graph, &schema).unwrap().shapes;
    assert shapes["X"].axes[0].name == "A";
}

test "an earlier pattern overrides a later one" {
    let graph = read(
        `agraph (float[2, 3] "layers.0.weight") => (float[2, 3] Y) {
            Y = Relu("layers.0.weight")
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [
            rule("*.0.weight", ["First", "Second"]),
            rule("*", ["A", "B"]),
        ],
    };
    let shapes = infer(&graph, &schema).unwrap().shapes;
    assert shapes["layers.0.weight"].axes[0].name == "First";
}

test "an unknown dimension takes its axis's name as its symbol" {
    let graph = read(
        `agraph (float[?, 4] X, float[4, 4] W) => (float[?, 4] Y) {
            Y = MatMul(X, W)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [
            rule("X", ["Batch", "In"]),
            rule("W", ["In", "Out"]),
        ],
    };
    let shapes = infer(&graph, &schema).unwrap().shapes;
    assert shapes["Y"].axes[0].extent.agrees(&Extent::Symbol("Batch"));
}

test "an operator given too few operands stops the build rather than trapping" {
    let graph = read(
        `agraph (float[2, 3] X) => (float[2, 3] Y) {
            Y = Add(X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["A", "B"])],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "Y = Add: reads 2 operands and was given 1";
}

test "a node naming several outputs stops the build rather than trapping" {
    let graph = read(
        `agraph (float[2, 3] X) => (float[2, 3] Y) {
            Y, Z = Relu(X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["A", "B"])],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "Y = Relu: produces one output and names 2";
}

test "a scalar operand to MatMul stops the build rather than trapping" {
    let graph = read(
        `agraph (float S, float[2, 3] W) => (float[2, 3] Y) {
            Y = MatMul(S, W)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [
            rule("S", []),
            rule("*", ["A", "B"]),
        ],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "Y = MatMul: a scalar operand has no axis to contract";
}

test "a declared output extent disagreeing with the produced one stops the build" {
    let graph = read(
        `agraph (float[2, 3] X, float[3, 10] W) => (float[2, 7] Y) {
            Y = MatMul(X, W)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [
            rule("X", ["A", "K"]),
            rule("W", ["K", "B"]),
        ],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "Y: axis B is declared 7 and produced 10";
}

test "a declared output rank disagreeing with the produced one stops the build" {
    let graph = read(
        `agraph (float[2, 3] X) => (float[2] Y) {
            Y = Relu(X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["A", "B"])],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "Y: the graph declares rank 1 and the nodes produce rank 2";
}

test "a declared symbolic name need not be the one the schema gave the axis" {
    let graph = read(
        `agraph (float[?, 3] X) => (float[N, 3] Y) {
            Y = Relu(X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["Batch", "B"])],
    };
    let shapes = infer(&graph, &schema).unwrap().shapes;
    assert shapes["Y"].axes[0].extent.agrees(&Extent::Symbol("Batch"));
}

test "a declared static extent settles an axis the nodes left symbolic" {
    let graph = read(
        `agraph (float[N, 3] X) => (float[8, 3] Y) {
            Y = Relu(X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["Batch", "B"])],
    };
    let shapes = infer(&graph, &schema).unwrap().shapes;
    assert shapes["Y"].axes[0].extent.agrees(&Extent::Static(8));
    // Only the declared output is settled; the input keeps what it stated.
    assert shapes["X"].axes[0].extent.agrees(&Extent::Symbol("N"));
}

test "a declared `?` claims nothing about the produced extent" {
    let graph = read(
        `agraph (float[N, 3] X) => (float[?, 3] Y) {
            Y = Relu(X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["Batch", "B"])],
    };
    let shapes = infer(&graph, &schema).unwrap().shapes;
    assert shapes["Y"].axes[0].extent.agrees(&Extent::Symbol("N"));
}

test "a graph output no node produces stops the build" {
    let graph = read(
        `agraph (float[2, 3] X) => (float[2, 3] Y, float[2, 3] Z) {
            Y = Relu(X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["A", "B"])],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "Z: no graph input, initializer or node defines this";
}

test "Gemm contracts the axis its transpose flags leave facing" {
    let graph = read(
        `agraph (float[2, 3] A, float[4, 3] B, float[4] C) => (float[2, 4] Y) {
            Y = Gemm <transB = 1> (A, B, C)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [
            rule("A", ["Batch", "In"]),
            rule("B", ["Out", "In"]),
            rule("C", ["Out"]),
            rule("Y", ["Batch", "Out"]),
        ],
    };
    let shapes = infer(&graph, &schema).unwrap().shapes;
    assert shapes["Y"].axes[0].name == "Batch";
    assert shapes["Y"].axes[1].name == "Out";
}

test "Gemm without its C operand is the product alone" {
    let graph = read(
        `agraph (float[2, 3] A, float[3, 4] B) => (float[2, 4] Y) {
            Y = Gemm(A, B)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [
            rule("A", ["Batch", "In"]),
            rule("B", ["In", "Out"]),
            rule("Y", ["Batch", "Out"]),
        ],
    };
    let shapes = infer(&graph, &schema).unwrap().shapes;
    assert shapes["Y"].axes[1].extent.agrees(&Extent::Static(4));
}

test "a Gemm operand that is not a matrix stops the build" {
    let graph = read(
        `agraph (float[3] A, float[3, 4] B) => (float[4] Y) {
            Y = Gemm(A, B)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [
            rule("A", ["In"]),
            rule("B", ["In", "Out"]),
            rule("Y", ["Out"]),
        ],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "Y = Gemm: operand 0 has rank 1 and the operator reads rank 2";
}

test "Transpose reorders the axes its perm names" {
    let graph = read(
        `agraph (float[2, 3] X) => (float[3, 2] Y) {
            Y = Transpose <perm = [1, 0]> (X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["A", "B"])],
    };
    let shapes = infer(&graph, &schema).unwrap().shapes;
    assert shapes["Y"].axes[0].name == "B";
    assert shapes["Y"].axes[1].name == "A";
    assert shapes["Y"].axes[0].extent.agrees(&Extent::Static(3));
}

test "Transpose with no perm reverses the axes, as ONNX defaults it" {
    let graph = read(
        `agraph (float[2, 3] X) => (float[3, 2] Y) {
            Y = Transpose(X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["A", "B"])],
    };
    let shapes = infer(&graph, &schema).unwrap().shapes;
    assert shapes["Y"].axes[0].name == "B";
}

test "a perm that is not a permutation stops the build" {
    let graph = read(
        `agraph (float[2, 3] X) => (float[3, 2] Y) {
            Y = Transpose <perm = [1, 1]> (X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["A", "B"])],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "Y = Transpose: attribute perm is not a permutation of 2 axes";
}

test "a perm naming the wrong number of axes stops the build" {
    let graph = read(
        `agraph (float[2, 3] X) => (float[3, 2] Y) {
            Y = Transpose <perm = [0]> (X)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["A", "B"])],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "Y = Transpose: attribute perm names 1 axes and the operand has 2";
}

/// `Y`'s axes after stage 0, as `name=extent` pairs, or the build error.
fn reshaped(source: String, layout: List<LayoutRule>) -> Result<String, String> {
    let graph = read(&source).unwrap();
    return match infer(&graph, &Schema { layout }) {
        Ok(Checked { shapes, .. }) => {
            let mut axes: List<String> = [];
            for let a of shapes["Y"].axes {
                axes.push(`${a.name}=${a.extent}`);
            }
            Result::Ok(axes.join(","));
        },
        Err(e) => Result::Err(`${e}`),
    };
}

fn nchw() -> List<LayoutRule> {
    return [rule("X", ["Batch", "Chan", "Row", "Col"])];
}

test "Reshape merges adjacent axes into one named by its parts" {
    let source = `g (float[1, 16, 4, 4] X) => (float[1, 256] Y) <int64[2] S = {1, 256}> {
        Y = Reshape(X, S)
    }`;
    assert reshaped(source, nchw()).unwrap() == "Batch=1,Merged<[Chan, Row, Col]>=256";
}

test "Reshape reads 0 as the input's extent and -1 as what remains" {
    let source = `g (float[1, 16, 4, 4] X) => (float[1, 256] Y) <int64[2] S = {0, -1}> {
        Y = Reshape(X, S)
    }`;
    assert reshaped(source, nchw()).unwrap() == "Batch=1,Merged<[Chan, Row, Col]>=256";
}

test "a Reshape target the graph computes from Shape folds at build time" {
    // An exporter's spelling of `x.view(x.size(0), -1)`.
    let source = `g (float[2, 3, 4] X) => (float[2, 12] Y) <int64[1] M = {-1}> {
        S = Shape(X)
        I = Constant<value_int = 0>()
        B = Gather(S, I)
        A = Constant<value_ints = [0]>()
        U = Unsqueeze(B, A)
        T = Concat<axis = 0>(U, M)
        Y = Reshape(X, T)
    }`;
    assert reshaped(source, [rule("X", ["Batch", "Row", "Col"])]).unwrap() == "Batch=2,Merged<[Row, Col]>=12";
}

/// An attention mask as an exporter writes it: an int64 input reshaped and
/// widened by two unit axes before it becomes a float.
global MASK: String = `g (int64[1, 4] M) => (float[1, 1, 1, 4] Y) <int64[2] T = {1, -1}> {
    R = Reshape(M, T)
    A = Constant<value_ints = [1]>()
    U = Unsqueeze(R, A)
    B = Constant<value_ints = [2]>()
    V = Unsqueeze(U, B)
    Y = Cast<to = 1>(V)
}`;

fn mask_layout() -> List<LayoutRule> {
    return [
        rule("M", ["Batch", "Key"]),
        rule("U", ["Batch", "Head", "Key"]),
        rule("V", ["Batch", "Head", "Query", "Key"]),
    ];
}

test "an int64 input keeps its element until Cast makes it a float" {
    let graph = read(&MASK).unwrap();
    let checked = infer(&graph, &Schema { layout: mask_layout() }).unwrap();
    assert checked.primitives["R"] == "i64";
    assert checked.primitives["V"] == "i64";
    assert checked.primitives["Y"] == "f32";
    assert reshaped(MASK, mask_layout()).unwrap() == "Batch=1,Head=1,Query=1,Key=4";
}

test "arithmetic on an int64 tensor stops the build" {
    let source = `g (int64[4] M) => (int64[4] Y) {
        Y = Add(M, M)
    }`;
    assert reshaped(source, [rule("M", ["Key"])]).unwrap_err() == "Y = Add: operand M is i64, and Add computes in f32";
}

test "an output declared as an element other than the one computed stops the build" {
    let source = `g (int64[4] M) => (float[4] Y) {
        Y = Identity(M)
    }`;
    assert reshaped(source, [rule("M", ["Key"])]).unwrap_err() == "Y: declared float and computed in i64";
}

test "Shape of a symbolic extent stops the build" {
    let source = `g (float[N, 3] X) => (float[N, 3] Y) {
        S = Shape(X)
        Y = Reshape(X, S)
    }`;
    assert reshaped(source, [rule("X", ["Batch", "Col"])]).unwrap_err() == "S = Shape: axis Batch is N, and the build reads static extents";
}

test "Reshape splits a merged axis back into its parts" {
    let source = `g (float[2, 3, 4] X) => (float[2, 3, 4] Y) <int64[2] F = {2, 12}, int64[3] S = {2, 3, 4}> {
        M = Reshape(X, F)
        Y = Reshape(M, S)
    }`;
    assert reshaped(source, [rule("X", ["Batch", "Row", "Col"])]).unwrap() == "Batch=2,Row=3,Col=4";
}

test "Reshape drops an extent-1 axis it merges past" {
    let source = `g (float[2, 16, 1, 1] X) => (float[2, 16] Y) <int64[2] S = {2, 16}> {
        Y = Reshape(X, S)
    }`;
    assert reshaped(source, nchw()).unwrap() == "Batch=2,Chan=16";
}

test "Flatten merges the axes on each side of its axis" {
    let source = `g (float[2, 16, 4, 4] X) => (float[2, 256] Y) {
        Y = Flatten <axis = 1> (X)
    }`;
    assert reshaped(source, nchw()).unwrap() == "Batch=2,Merged<[Chan, Row, Col]>=256";
}

test "Flatten at axis 0 puts a new unit axis first" {
    let source = `g (float[2, 3] X) => (float[1, 6] Y) {
        Y = Flatten <axis = 0> (X)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Row", "Col"]),
        rule("Y", ["One", "Cells"]),
    ];
    assert reshaped(source, layout).unwrap() == "One=1,Merged<[Row, Col]>=6";
}

test "an axis no regrouping determines stops the build without a layout" {
    let source = `g (float[2, 12] X) => (float[2, 3, 4] Y) <int64[3] S = {2, 3, 4}> {
        Y = Reshape(X, S)
    }`;
    let e = reshaped(source, [rule("X", ["Batch", "Wide"])]).unwrap_err();
    assert e == "Y = Reshape: axis 1 regroups none of the operand's axes, so a layout pattern must name Y's";
}

test "an axis no regrouping determines takes the output's layout name" {
    let source = `g (float[2, 12] X) => (float[2, 1, 3, 4] Y) <int64[4] S = {2, 1, 3, 4}> {
        Y = Reshape(X, S)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Batch", "Wide"]),
        rule("Y", ["Batch", "One", "Three", "Four"]),
    ];
    assert reshaped(source, layout).unwrap() == "Batch=2,One=1,Three=3,Four=4";
}

test "a Reshape target no integer initializer carries stops the build" {
    let source = `g (float[2, 12] X, float[2] S) => (float[24] Y) {
        Y = Reshape(X, S)
    }`;
    let e = reshaped(source, [
        rule("X", ["Batch", "Wide"]),
        rule("S", ["Two"]),
    ]).unwrap_err();
    assert e == "Y = Reshape: the target shape S is not an integer tensor the build knows";
}

test "a Reshape target that changes the element count stops the build" {
    let source = `g (float[2, 12] X) => (float[5, 5] Y) <int64[2] S = {5, 5}> {
        Y = Reshape(X, S)
    }`;
    let e = reshaped(source, [rule("X", ["Batch", "Wide"])]).unwrap_err();
    assert e == "Y = Reshape: 24 elements cannot take the shape [5, 5]";
}

test "a Reshape over a symbolic extent stops the build" {
    let source = `g (float[N, 12] X) => (float[N, 3, 4] Y) <int64[3] S = {0, 3, 4}> {
        Y = Reshape(X, S)
    }`;
    let e = reshaped(source, [rule("X", ["Batch", "Wide"])]).unwrap_err();
    assert e == "Y = Reshape: axis Batch is N, and Reshape reads static extents";
}

fn pooled() -> List<LayoutRule> {
    return [
        rule("X", ["Batch", "Chan", "Row", "Col"]),
        rule("Y", ["Batch", "Chan", "PRow", "PCol"]),
    ];
}

test "MaxPool names its window's output axes from the output's layout" {
    let source = `g (float[1, 3, 7, 7] X) => (float[1, 3, 4, 4] Y) {
        Y = MaxPool <kernel_shape = [3, 3], strides = [2, 2], pads = [1, 1, 1, 1]> (X)
    }`;
    assert reshaped(source, pooled()).unwrap() == "Batch=1,Chan=3,PRow=4,PCol=4";
}

test "MaxPool rounds its output extent up under ceil_mode" {
    let source = `g (float[1, 1, 5, 5] X) => (float[1, 1, 3, 3] Y) {
        Y = MaxPool <kernel_shape = [2, 2], strides = [2, 2], ceil_mode = 1> (X)
    }`;
    assert reshaped(source, pooled()).unwrap() == "Batch=1,Chan=1,PRow=3,PCol=3";
}

test "a window's output axis stops the build without a layout" {
    let source = `g (float[1, 3, 7, 7] X) => (float[1, 3, 3, 3] Y) {
        Y = MaxPool <kernel_shape = [2, 2], strides = [2, 2]> (X)
    }`;
    let e = reshaped(source, nchw()).unwrap_err();
    assert e == "Y = MaxPool: axis 2 is a window's output, so a layout pattern must name Y's";
}

fn convolved() -> List<LayoutRule> {
    return [
        rule("X", ["Batch", "Chan", "Row", "Col"]),
        rule("W", ["Out", "Chan", "KRow", "KCol"]),
        rule("B", ["Out"]),
        rule("Y", ["Batch", "Out", "Row", "Col"]),
    ];
}

test "Conv under SAME_UPPER keeps the spatial extents" {
    let source = `g (float[1, 1, 28, 28] X) => (float[1, 8, 28, 28] Y) <float[8, 1, 5, 5] W> {
        Y = Conv <kernel_shape = [5, 5], auto_pad = "SAME_UPPER"> (X, W)
    }`;
    assert reshaped(source, convolved()).unwrap() == "Batch=1,Out=8,Row=28,Col=28";
}

test "Conv reads its kernel off the weight and its bias checks against the output channels" {
    let source = `g (float[2, 3, 7, 5] X) => (float[2, 4, 5, 4] Y) <float[4, 3, 3, 2] W, float[4] B> {
        Y = Conv (X, W, B)
    }`;
    assert reshaped(source, convolved()).unwrap() == "Batch=2,Out=4,Row=5,Col=4";
}

test "Conv whose weight reads another channel count stops the build" {
    let source = `g (float[1, 1, 28, 28] X) => (float[1, 8, 24, 24] Y) <float[8, 2, 5, 5] W> {
        Y = Conv (X, W)
    }`;
    let e = reshaped(source, convolved()).unwrap_err();
    assert e == "Y = Conv: axis Chan is 1 on the left and 2 on the right";
}

test "Conv over several groups stops the build" {
    let source = `g (float[1, 2, 8, 8] X) => (float[1, 2, 6, 6] Y) <float[2, 1, 3, 3] W> {
        Y = Conv <group = 2> (X, W)
    }`;
    let e = reshaped(source, convolved()).unwrap_err();
    assert e == "Y = Conv: attribute group is 2, and only a single group is read";
}

test "a node reading an undefined tensor stops the build" {
    let graph = read(
        `agraph (float[2, 3] X) => (float[2, 3] Y) {
            Y = Add(X, Missing)
        }`,
    ).unwrap();
    let schema = Schema {
        layout: [rule("*", ["A", "B"])],
    };
    let e = infer(&graph, &schema).unwrap_err();
    assert `${e}` == "Missing: no graph input, initializer or node defines this";
}
