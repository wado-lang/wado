use { Extent } from "./extent.wado";
use { Poly } from "./poly.wado";

test "two numbers agree when they are the same number" {
    assert Extent::Static(4).agrees(&Extent::Static(4));
    assert !Extent::Static(4).agrees(&Extent::Static(8));
}

test "a symbol agrees only with itself" {
    // The batch axis flows through a whole network unchanged, so it meets its
    // own symbol at every operation and never has to be a number.
    assert Extent::symbol(&"batch").agrees(&Extent::symbol(&"batch"));
    assert !Extent::symbol(&"batch").agrees(&Extent::symbol(&"seq"));
}

test "a symbol proves nothing about a number" {
    // `forward` checks only the inequalities stage 0 owes, so an operation
    // needing the two equal is a failure rather than a check deferred to the run.
    assert !Extent::symbol(&"seq").agrees(&Extent::Static(4));
    assert !Extent::Static(4).agrees(&Extent::symbol(&"seq"));
}

test "an unstated extent agrees with nothing, itself included" {
    assert !Extent::Unstated.agrees(&Extent::Unstated);
    assert !Extent::Unstated.agrees(&Extent::Static(4));
}

test "a polynomial with no symbol left is a static extent" {
    let seq = Poly::symbol(&"seq");
    assert Extent::of(seq.try_sub(&seq).unwrap().try_add(&Poly::constant(3)).unwrap()) matches { Some(Static(3)) };
    assert Extent::of(Poly::constant(-1)) matches { None };
    let doubled = Extent::of(seq.try_mul(&Poly::constant(2)).unwrap()).unwrap();
    assert doubled.agrees(&Extent::of(seq.try_add(&seq).unwrap()).unwrap());
}

test "an extent renders as what a diagnostic should name it" {
    assert `${Extent::Static(512)}` == "512";
    assert `${Extent::symbol(&"seq")}` == "seq";
    assert `${Extent::Unstated}` == "?";
}

test "agreement owes only what the extents' difference reads" {
    let n = Poly::symbol(&"N");
    let m = Poly::symbol(&"M");
    let eight = Poly::constant(8);
    let site = "Y = Slice";
    let shared = Poly::min_of(&m, &eight, &site);
    let a = Extent::Symbolic(Poly::min_of(&n, &eight, &site).try_add(&shared).unwrap());
    let b = Extent::Symbolic(n.try_add(&shared).unwrap());
    let owed = a.agreement(&b).unwrap();
    assert owed.len() == 1;
    assert owed[0].reason == "Y = Slice: N must be at most 8";
}

test "a dim_param spelling arithmetic over names is that polynomial" {
    let past = Poly::symbol(&"past_sequence_length");
    let one_more = Extent::param(&"past_sequence_length + 1");
    assert one_more.agrees(&Extent::Symbolic(past.try_add(&Poly::constant(1)).unwrap()));
    let total = Extent::param(&"past_sequence_length + sequence_length");
    assert total.agrees(&Extent::Symbolic(past.try_add(&Poly::symbol(&"sequence_length")).unwrap()));
    let product = Extent::param(&"2 * heads - 1");
    assert product.agrees(&Extent::Symbolic(Poly::symbol(&"heads").try_mul(&Poly::constant(2)).unwrap().try_sub(
        &Poly::constant(1),
    ).unwrap()));
}

test "any other dim_param is one symbol of its own" {
    assert Extent::param(&"batch").agrees(&Extent::symbol(&"batch"));
    // An operator is a word of its own, so a hyphen inside a name is the name's.
    assert Extent::param(&"seq-len").agrees(&Extent::symbol(&"seq-len"));
    assert Extent::param(&"past_sequence_length+1").agrees(&Extent::symbol(&"past_sequence_length+1"));
    assert Extent::param(&"encoder_sequence_length / 2").agrees(&Extent::symbol(&"encoder_sequence_length / 2"));
    assert Extent::param(&"n +").agrees(&Extent::symbol(&"n +"));
}
