use { Extent } from "./extent.wado";
use { Poly } from "./poly.wado";

test "two numbers agree when they are the same number" {
    assert Extent::Static(4).agrees(&Extent::Static(4));
    assert !Extent::Static(4).agrees(&Extent::Static(8));
}

test "a symbol agrees only with itself" {
    // The batch axis flows through a whole network unchanged, so it meets its
    // own symbol at every operation and never has to be a number.
    assert Extent::symbol(&"batch").agrees(&Extent::symbol(&"batch"));
    assert !Extent::symbol(&"batch").agrees(&Extent::symbol(&"seq"));
}

test "a symbol proves nothing about a number" {
    // Stage 0 has no runtime tier to fall back on, so an undischargeable
    // condition is a failure rather than a check deferred to the run.
    assert !Extent::symbol(&"seq").agrees(&Extent::Static(4));
    assert !Extent::Static(4).agrees(&Extent::symbol(&"seq"));
}

test "an unstated extent agrees with nothing, itself included" {
    assert !Extent::Unstated.agrees(&Extent::Unstated);
    assert !Extent::Unstated.agrees(&Extent::Static(4));
}

test "a polynomial with no symbol left is a static extent" {
    let seq = Poly::symbol(&"seq");
    assert Extent::of(seq.sub(&seq).add(&Poly::constant(3))) matches { Some(Static(3)) };
    assert Extent::of(Poly::constant(-1)) matches { None };
    assert Extent::of(seq.mul(&Poly::constant(2))).unwrap().agrees(&Extent::of(seq.add(&seq)).unwrap());
}

test "an extent renders as what a diagnostic should name it" {
    assert `${Extent::Static(512)}` == "512";
    assert `${Extent::symbol(&"seq")}` == "seq";
    assert `${Extent::Unstated}` == "?";
}
