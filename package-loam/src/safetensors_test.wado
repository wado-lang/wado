//! The build's check of a checkpoint's header against the graph it supplies.

use { Graph } from "./graph.wado";
use { Checked, infer } from "./infer.wado";
use { read } from "./onnx_text.wado";
use { read_checkpoint } from "./runtime/checkpoint.wado";
use { LayoutRule, Schema } from "./schema.wado";
use {
    CheckpointFile,
    StoredTensor,
    check_checkpoint,
    check_shards,
    placement,
    read_index,
    shard_name,
    shard_tensors,
    split_weights,
    write_index,
    write_safetensors,
} from "./safetensors.wado";

global GRAPH: String = `
g (float[N, 2] X) => (float[N, 3] Y)
<float[2, 3] W, float[3] B = {0.0, 0.0, 0.0}>
{
    H = MatMul(X, W)
    Y = Add(H, B)
}
`;

fn checked_graph() -> [Graph, Checked] {
    let graph = read(&GRAPH).unwrap();
    let layout: List<LayoutRule> = [
        LayoutRule {
            pattern: "X",
            axes: ["Batch", "In"],
        },
        LayoutRule {
            pattern: "W",
            axes: ["In", "Out"],
        },
        LayoutRule {
            pattern: "B",
            axes: ["Out"],
        },
    ];
    let checked = infer(&graph, &Schema { layout }).unwrap();
    return [graph, checked];
}

fn check(stored: List<StoredTensor>) -> Result<(), String> {
    let [graph, checked] = checked_graph();
    let bytes = write_safetensors(&stored);
    return check_checkpoint(&graph, &checked.shapes, &read_checkpoint(&bytes).unwrap()).map_err(|e| `${e}`);
}

fn weight(shape: List<i64>) -> StoredTensor {
    let mut count = 1;
    for let e of shape {
        count *= e as i32;
    }
    return StoredTensor {
        name: "W",
        dtype: "F32",
        shape,
        data: ByteList::filled(count * 4, 0),
    };
}

test "a checkpoint holding what the graph leaves to it checks" {
    assert check([weight([2, 3])]) == Result::<(), String>::Ok(());
}

test "a weight the graph carries is not looked for in the checkpoint" {
    let mut stored = [weight([2, 3])] as List<StoredTensor>;
    stored.push(StoredTensor {
        name: "B",
        dtype: "F32",
        shape: [7],
        data: ByteList::filled(28, 0),
    });
    assert check(stored) == Result::<(), String>::Ok(());
}

test "an extent that disagrees with the graph names the axis" {
    assert check([weight([2, 4])]).unwrap_err() == "W: axis Out is 4 in the checkpoint and 3 in the graph";
}

test "a weight the checkpoint lacks names itself" {
    assert check([]).unwrap_err() == "W: the checkpoint has no such tensor";
}

test "a weight named as the format's metadata stays in the graph, which can name it" {
    let graph = read(
        `g (float[2] X) => (float[2] Y) <float[2] "__metadata__" = {1.0, 2.0}> { Y = Add(X, "__metadata__") }`,
    ).unwrap();
    let [kept, stored] = split_weights(graph);
    assert kept.initializers[0].data matches { Some(_) };
    assert stored.is_empty();
}

/// The check of `GRAPH` against the shards in `given`, each a path and the
/// tensors it holds, which `index` at `index.json` places its weights in. A
/// failure follows the path it blames.
fn check_sharded(index: String, given: List<[String, List<StoredTensor>]>) -> Result<(), String> {
    let [graph, checked] = checked_graph();
    let index = read_index(&index)?;
    let placed = placement(&graph, &index).map_err(|e| `${e}`)?;
    let mut shards: List<CheckpointFile> = [];
    for let [path, stored] of given {
        shards.push(CheckpointFile { path, header: write_safetensors(&stored) });
    }
    return check_shards(&graph, &checked.shapes, &"index.json", &index, &placed, shards).map_err(
        |r| `${r.path}: ${r.reason}`,
    );
}

/// `W` in the second shard, the first holding only a tensor the graph does not
/// read.
global INDEX: String = `{"metadata": {"total_size": 28}, "weight_map": {"V": "m-00001-of-00002.safetensors", "W": "m-00002-of-00002.safetensors"}}`;

test "a sharded checkpoint checks each weight in the shard its index places it in" {
    assert check_sharded(INDEX, [
        [
            "dir/m-00002-of-00002.safetensors",
            [weight([2, 3])],
        ],
    ]) == Result::<(), String>::Ok(());
}

test "a weight in a shard not given is blamed on the index, naming the shard" {
    let refused = check_sharded(INDEX, [
        ["dir/m-00001-of-00002.safetensors", []],
    ]).unwrap_err();
    assert refused == "index.json: W: the index places it in m-00002-of-00002.safetensors, which is not given";
}

test "a weight the index places in no shard names itself" {
    let refused = check_sharded(`{"weight_map": {}}`, []).unwrap_err();
    assert refused == "W: the index places it in no shard";
}

test "a weight is looked for in its own shard alone, which is blamed" {
    let refused = check_sharded(INDEX, [
        [
            "dir/m-00001-of-00002.safetensors",
            [weight([2, 3])],
        ],
        ["dir/m-00002-of-00002.safetensors", []],
    ]).unwrap_err();
    assert refused == "dir/m-00002-of-00002.safetensors: W: the checkpoint has no such tensor";
}

test "a shard the index does not name is refused" {
    let refused = check_sharded(INDEX, [
        ["dir/other.safetensors", []],
    ]).unwrap_err();
    assert refused == "dir/other.safetensors: the index names no shard of this file name";
}

test "two shards of one file name are refused" {
    let refused = check_sharded(INDEX, [
        ["a/m-00001-of-00002.safetensors", []],
        ["b/m-00001-of-00002.safetensors", []],
    ]).unwrap_err();
    assert refused == "b/m-00001-of-00002.safetensors: another shard has this file name";
}

test "an index that is not one is refused" {
    assert read_index(&"{\"weight_map\": []}").unwrap_err().starts_with("not a safetensors index: ");
}

test "an index placing a tensor in a path rather than a file name is refused" {
    assert read_index(&"{\"weight_map\": {\"W\": \"shards/m.safetensors\"}}").unwrap_err() == "W: the index places it in shards/m.safetensors, which is not a file name";
}

fn sized(name: String, bytes: i32) -> StoredTensor {
    return StoredTensor {
        name,
        dtype: "U8",
        shape: [bytes as i64],
        data: ByteList::filled(bytes, 0),
    };
}

fn names(shard: &List<StoredTensor>) -> List<String> {
    return shard.iter_ref().map(|t| t.name).collect();
}

test "tensors fill a shard in order until the next would pass its size" {
    let shards = shard_tensors([
        sized("a", 10),
        sized("b", 10),
        sized("c", 10),
    ], 25);
    assert shards.len() == 2;
    assert names(&shards[0]) == ["a", "b"];
    assert names(&shards[1]) == ["c"];
}

test "a tensor larger than a shard has one of its own" {
    let shards = shard_tensors([
        sized("a", 10),
        sized("big", 40),
        sized("c", 10),
    ], 25);
    assert shards.len() == 3;
    assert names(&shards[1]) == ["big"];
}

test "a shard is named as Hugging Face names one" {
    assert shard_name(&"model", 0, 3) == "model-00001-of-00003.safetensors";
}

test "the index written places each tensor in its shard, and reads back" {
    let shards: List<[String, List<StoredTensor>]> = [
        [
            "m-00001-of-00002.safetensors",
            [sized("a", 10)],
        ],
        [
            "m-00002-of-00002.safetensors",
            [
                sized("b", 4),
                sized("c", 2),
            ],
        ],
    ];
    let text = write_index(&shards);
    assert text.contains("\"total_size\": 16");
    let index = read_index(&text).unwrap();
    assert index["a"] == "m-00001-of-00002.safetensors";
    assert index["c"] == "m-00002-of-00002.safetensors";
}

test "splitting moves every carried weight into the checkpoint, under its name" {
    let graph = read(&GRAPH).unwrap();
    let [kept, stored] = split_weights(graph);
    assert kept.initializers.len() == 2;
    for let vi of kept.initializers {
        assert vi.data matches { None };
    }
    assert stored.len() == 1;
    assert stored[0].name == "B";
    assert stored[0].dtype == "F32";
    assert stored[0].shape == [3] as List<i64>;
    assert stored[0].data == ByteList::filled(12, 0);
}
