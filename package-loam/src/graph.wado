//! The ONNX graph Loam reads, in the shape the rest of the package consumes.
//! Dimensions are extents without identity, since an ONNX shape is positional.

use { HashMap, HashSet, TreeMap } from "core:collections";
use { Enumeration } from "lib:grog";
use onnx from "./onnx.proto"
    with {
        generator: { module: "lib:grog" },
    };
use { Poly } from "./poly.wado";
use { BinaryOp, UnaryOp, checked_element_count } from "./runtime/tensor.wado";

/// One dimension as the model states it. `Unknown` is ONNX's `?`, a dimension
/// the exporter left open and no symbol stands for. `Bound` is a `dim_param`
/// the `dims` option fixed, which still says which axes are one.
pub variant Dim {
    Static(i32),
    Symbol(String),
    Bound([String, i32]),
    Unknown,
}

impl Dim {
    /// The extent the dimension states, where it states one.
    pub fn as_static(&self) -> Option<i32> {
        return match self {
            Static(e) => Option::Some(*e),
            Bound([_, e]) => Option::Some(*e),
            _ => null,
        };
    }
}

/// A tensor type's rank. ONNX separates a scalar from a tensor whose rank it
/// does not state, so the two are separate cases rather than an empty list.
pub variant Rank {
    Scalar,
    Unranked,
    Dims(List<Dim>),
}

/// The rank stating `dims`, which is a scalar where there are none.
pub fn rank_of(dims: List<Dim>) -> Rank {
    if dims.is_empty() {
        return Rank::Scalar;
    }
    return Rank::Dims(dims);
}

/// The dimensions a rank states, a scalar's being none. `None` is a tensor
/// whose rank the graph leaves open.
pub fn dims_of(rank: &Rank) -> Option<List<Dim>> {
    return match rank {
        Dims(d) => Option::Some(*d),
        Scalar => Option::Some([] as List<Dim>),
        Unranked => null,
    };
}

/// Every extent `rank` states, or `None` where it leaves one open.
pub fn static_extents(rank: &Rank) -> Option<List<i32>> {
    let Some(dims) = dims_of(rank) else {
        return null;
    };
    let mut extents: List<i32> = [];
    for let d of dims {
        extents.push(d.as_static()?);
    }
    return Option::Some(extents);
}

/// A named tensor the graph declares: an input, an output, or an initializer.
pub struct ValueInfo {
    pub name: String,
    pub dtype: String,
    pub rank: Rank,
    /// The elements as little-endian bytes, where the graph carries them.
    pub data: Option<ByteList> = null,
}

/// An element type a kernel reaches: the primitive a tensor is held and
/// computed in, its width in a payload, and its name in a safetensors header.
pub struct Element {
    pub primitive: String,
    pub width: i32,
    pub stored: String,
}

/// Whether `primitive` is one the kernels have arithmetic for. A layout kernel
/// moves any element, and every other kernel reads and produces one of these.
pub fn is_float(primitive: &String) -> bool {
    return *primitive == "f32" || *primitive == "f16" || *primitive == "bf16";
}

/// The `TensorProto.DataType` an attribute's number names, as `Cast`'s `to`
/// carries one. `None` for a number the enum does not declare.
pub fn data_type(number: i64) -> Option<onnx::TensorProtoDataType> {
    let Ok(n) = i32::try_from(number) else {
        return null;
    };
    return onnx::TensorProtoDataType::from_number(n);
}

/// `dtype`'s element, or `None` for one no kernel reaches, whose payload is not
/// read.
pub fn element_of(dtype: &String) -> Option<Element> {
    return match dtype.as_str_slice() {
        "float" => Option::Some(Element { primitive: "f32", width: 4, stored: "F32" }),
        "float16" => Option::Some(Element { primitive: "f16", width: 2, stored: "F16" }),
        "bfloat16" => Option::Some(Element { primitive: "bf16", width: 2, stored: "BF16" }),
        "uint8" => Option::Some(Element { primitive: "u8", width: 1, stored: "U8" }),
        "int64" => Option::Some(Element { primitive: "i64", width: 8, stored: "I64" }),
        "bool" => Option::Some(Element { primitive: "bool", width: 1, stored: "BOOL" }),
        _ => null,
    };
}

/// An integer standing for one element, as `int32_data` and the text form write
/// a half: its bit pattern, which must fit `width` bytes.
pub fn bit_pattern(tensor: &String, dtype: &String, v: i32, width: i32) -> Result<u32, String> {
    if v < 0 || v >= 1 << 8 * width {
        return Result::Err(`${tensor}: ${v} is not a ${dtype} bit pattern`);
    }
    return Result::Ok(v as u32);
}

/// Whether `text` is a float the text form spells as a word, as ONNX's parser
/// reads one: `nan`, `inf` or `infinity` in any case, after an optional minus.
pub fn is_float_word<S: AsStrSlice>(text: S) -> bool {
    let word = text.trim_prefix("-");
    return word.eq_ignore_ascii_case("nan") || word.eq_ignore_ascii_case("inf") || word.eq_ignore_ascii_case("infinity");
}

/// One element's low `width` bytes, little-endian, as the protobuf form lays
/// out a payload.
pub fn push_element(bytes: &mut ByteList, bits: u64, width: i32) {
    for let mut at = 0; at < width; at += 1 {
        bytes.push((bits >> (8 * at) as u64) as u8);
    }
}

/// Records that the node at `at` reads `tensor`.
pub fn read_at(readers: &mut HashMap<String, List<i32>>, tensor: &String, at: i32) {
    let mut by = readers.get(*tensor).unwrap_or([]);
    by.push(at);
    readers[*tensor] = by;
}

/// The extents' product is how many elements the tensor says it has, and a
/// payload of any other length is a file disagreeing with itself.
pub fn check_element_count(tensor: &String, elements: i32, extents: &List<i32>) -> Result<(), String> {
    let Some(declared) = checked_element_count(extents) else {
        return Result::Err(
            `${tensor}: ${elements} elements for a shape whose extents multiply past what a list can hold`,
        );
    };
    if declared != elements {
        return Result::Err(`${tensor}: ${elements} elements for a shape of ${declared}`);
    }
    return Result::Ok(());
}

/// Whether `bytes` bytes of `dtype` elements, each `width` wide, are whole
/// elements, as many as `extents` declare.
pub fn check_payload_len(
    tensor: &String,
    dtype: &String,
    width: i32,
    bytes: i32,
    extents: &List<i32>,
) -> Result<(), String> {
    if bytes % width != 0 {
        return Result::Err(`${*tensor}: ${bytes} raw bytes is not whole ${*dtype} elements`);
    }
    return check_element_count(tensor, bytes / width, extents);
}

/// A tensor whose elements the build reads: a `Constant`, an initializer no
/// kernel computes in, or what stage 0 folds from them.
pub struct Known {
    pub extents: List<i32>,
    pub elements: Elements,
    /// The ONNX element type the elements are stored as.
    pub stored: Stored = Stored::Computed,
}

/// The ONNX element type a known tensor is stored as, where it is narrower
/// than the type stage 0 computes its elements in. A half is computed in f32,
/// which holds each of its values exactly.
pub enum Stored {
    /// int64, float or bool, each computed as it is stored.
    Computed,
    /// Held in `i64`, but wrapping at 32 bits where int64 does not.
    Int32,
    Float16,
    BFloat16,
}

impl Stored {
    /// The half type `dtype` names, or `None` for any other.
    pub fn half(dtype: &String) -> Option<Stored> {
        return match dtype.as_str_slice() {
            "float16" => Option::Some(Stored::Float16),
            "bfloat16" => Option::Some(Stored::BFloat16),
            _ => null,
        };
    }

    /// A half's bit pattern as the f32 that holds it.
    pub fn widened(&self, bits: u16) -> f32 {
        return match self {
            Float16 => f32::from(f16::from_bits(bits)),
            BFloat16 => f32::from(bf16::from_bits(bits)),
            _ => unreachable(),
        };
    }

    /// The bit pattern of the half `widened` gave `v` for.
    pub fn narrowed(&self, v: f32) -> u16 {
        return match self {
            Float16 => f16::from_f32(v).to_bits(),
            BFloat16 => bf16::from_f32(v).to_bits(),
            _ => unreachable(),
        };
    }
}

/// A known tensor's elements, in the type stage 0 computes them in. ONNX's
/// integer types all fit `i64`, as its shape arithmetic does.
pub variant Elements {
    Ints(List<i64>),
    /// Integers some of which only the run knows, as `Shape` reads from a
    /// tensor with a symbolic extent. Where none is, they are `Ints`.
    Symbolic(List<Poly>),
    Floats(List<f32>),
    Bools(List<bool>),
}

impl Elements {
    /// `values` as the one case that holds them.
    pub fn integers(values: List<Poly>) -> Elements {
        let mut ints = List::<i64>::with_capacity(values.len());
        for let v of &values {
            let Some(c) = v.as_constant() else {
                return Elements::Symbolic(values);
            };
            ints.push(c);
        }
        return Elements::Ints(ints);
    }
}

impl Known {
    /// How many elements the tensor holds.
    pub fn len(&self) -> i32 {
        return match &self.elements {
            Ints(v) => v.len(),
            Symbolic(v) => v.len(),
            Floats(v) => v.len(),
            Bools(v) => v.len(),
        };
    }
}

/// An attribute's values as written, each number or string as its text. A
/// tensor or a graph has no text form and travels in `tensor` or `graph`.
pub struct Attr {
    pub name: String,
    pub values: List<String>,
    pub is_list: bool,
    /// Whether the values are strings rather than numbers, which their text
    /// alone does not tell where a string reads as `3` or `inf`.
    pub is_string: bool = false,
    pub tensor: Option<Known> = null,
    /// A subgraph, as `If` carries its branches.
    pub graph: Option<Graph> = null,
}

/// An attribute its operator cannot read as written, and why.
pub struct AttrError {
    pub attr: String,
    pub reason: String,
}

impl Display for AttrError {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(`attribute ${self.attr} ${self.reason}`);
    }
}

impl Error for AttrError {
}

impl Attr {
    /// Every value read as an integer.
    pub fn ints(&self) -> Result<List<i64>, AttrError> {
        let mut values: List<i64> = [];
        for let text of self.numbers()? {
            values.push(int_of(&text).map_err(|reason| self.error(reason))?);
        }
        return Result::Ok(values);
    }

    /// `ints` for a float attribute.
    pub fn floats(&self) -> Result<List<f32>, AttrError> {
        let mut values: List<f32> = [];
        for let text of self.numbers()? {
            values.push(float_of(&text).map_err(|reason| self.error(reason))?);
        }
        return Result::Ok(values);
    }

    /// The one value an operator reads as an integer.
    pub fn int(&self) -> Result<i64, AttrError> {
        return int_of(&self.one_of(self.numbers()?)?).map_err(|reason| self.error(reason));
    }

    /// `int` for a float attribute.
    pub fn float(&self) -> Result<f32, AttrError> {
        return float_of(&self.one_of(self.numbers()?)?).map_err(|reason| self.error(reason));
    }

    /// The one value an operator reads as a string.
    pub fn string(&self) -> Result<String, AttrError> {
        return self.one_of(self.texts(true, "a string")?);
    }

    fn one_of(&self, values: List<String>) -> Result<String, AttrError> {
        if values.len() != 1 {
            return Result::Err(self.error("is a list and the operator reads one value"));
        }
        return Result::Ok(values[0]);
    }

    fn numbers(&self) -> Result<List<String>, AttrError> {
        return self.texts(false, "numbers");
    }

    /// The values, which the operator `reads` as strings or as numbers. An
    /// empty list is either.
    fn texts(&self, strings: bool, reads: String) -> Result<List<String>, AttrError> {
        if self.tensor matches { Some(_) } {
            return Result::Err(self.error(`holds a tensor, and the operator reads ${reads}`));
        }
        if self.graph matches { Some(_) } {
            return Result::Err(self.error(`holds a graph, and the operator reads ${reads}`));
        }
        if !self.is_list && self.values.is_empty() {
            return Result::Err(self.error("holds no value the build reads"));
        }
        if !self.values.is_empty() && self.is_string != strings {
            let holds = if self.is_string { "strings" } else { "numbers" };
            return Result::Err(self.error(`holds ${holds}, and the operator reads ${reads}`));
        }
        return Result::Ok(self.values);
    }

    fn error(&self, reason: String) -> AttrError {
        return AttrError { attr: self.name, reason };
    }
}

/// An attribute the operator requires, which the node does not carry.
pub fn absent(attr: String) -> AttrError {
    return AttrError { attr, reason: "is absent and the operator reads it" };
}

fn int_of(text: &String) -> Result<i64, String> {
    let Ok(v) = i64::from_str(text) else {
        return Result::Err(`holds '${text}', which is not an integer`);
    };
    return Result::Ok(v);
}

fn float_of(text: &String) -> Result<f32, String> {
    let Ok(v) = f32::from_str(text) else {
        return Result::Err(`holds '${text}', which is not a number`);
    };
    return Result::Ok(v);
}

/// One operator application: what it reads, what it writes, and its attributes.
pub struct Node {
    pub op: String,
    pub outputs: List<String>,
    pub inputs: List<String>,
    pub attrs: List<Attr>,
}

impl Node {
    /// What names the node in a message. ONNX identifies one by its first
    /// output, and a node the file gave none falls back to its operator.
    pub fn name(&self) -> String {
        if self.outputs.is_empty() {
            return self.op;
        }
        return self.outputs[0];
    }

    /// The node as a message places something at it: its name and operator.
    pub fn site(&self) -> String {
        return `${self.name()} = ${self.op}`;
    }

    /// Every tensor the node reads: its operands, and what each subgraph it
    /// carries reads from the graph around it.
    pub fn reads(&self) -> List<String> {
        let mut read = self.inputs;
        for let a of self.attrs {
            if let Some(g) = a.graph {
                read.extend(&g.outer_reads());
            }
        }
        return read;
    }

    /// How many operands the node gives before the first it leaves absent,
    /// which ONNX writes as an empty name.
    pub fn leading_operands(&self) -> i32 {
        return self.inputs.position(|input| input == "").unwrap_or(self.inputs.len());
    }

    /// Whether the node was given operand `index`. ONNX writes an absent
    /// optional operand as an empty name, or omits it.
    pub fn has_operand(&self, index: i32) -> bool {
        return index < self.inputs.len() && self.inputs[index] != "";
    }

    /// Whether the node names output `index`, which ONNX leaves absent as it
    /// does an operand.
    pub fn has_output(&self, index: i32) -> bool {
        return index < self.outputs.len() && self.outputs[index] != "";
    }

    /// The attribute `name`, where the node carries it.
    pub fn attr<S: AsStrSlice>(&self, name: S) -> Option<Attr> {
        for let a of self.attrs {
            if a.name.as_str_slice() == name.as_str_slice() {
                return Option::Some(a);
            }
        }
        return null;
    }

    /// The one integer attribute `name` holds, or `fallback` where it is absent.
    pub fn int_attr<S: AsStrSlice>(&self, name: S, fallback: i64) -> Result<i64, AttrError> {
        return match self.attr(name) {
            Some(a) => a.int(),
            None => Result::Ok(fallback),
        };
    }

    /// The one integer attribute `name` holds, which ONNX gives no default.
    pub fn required_int_attr<S: AsStrSlice>(&self, name: S) -> Result<i64, AttrError> {
        return match self.attr(name) {
            Some(a) => a.int(),
            None => Result::Err(absent(name.as_str_slice().to_string())),
        };
    }

    /// `int_attr` for a float attribute.
    pub fn float_attr<S: AsStrSlice>(&self, name: S, fallback: f32) -> Result<f32, AttrError> {
        return match self.attr(name) {
            Some(a) => a.float(),
            None => Result::Ok(fallback),
        };
    }

    /// `int_attr` for a string attribute.
    pub fn string_attr<S: AsStrSlice>(&self, name: S, fallback: String) -> Result<String, AttrError> {
        return match self.attr(name) {
            Some(a) => a.string(),
            None => Result::Ok(fallback),
        };
    }
}

/// Whether an initializer of `dtype` is read at build time, as `Reshape` reads
/// its target shape. No kernel computes in these, so none is ever a weight.
pub fn is_build_time(dtype: &String) -> bool {
    return *dtype == "int64" || *dtype == "int32" || *dtype == "bool";
}

/// `inputs` holds the parameters `compute` takes, so it never names an
/// initializer: both readers pass theirs through `parameters` first.
pub struct Graph {
    pub name: String,
    pub inputs: List<ValueInfo>,
    pub outputs: List<ValueInfo>,
    pub initializers: List<ValueInfo>,
    pub constants: HashMap<String, Known> = HashMap::new(),
    pub nodes: List<Node>,
    /// The default domain's opset, which fixes what an operator means. `None`
    /// where the graph names none, read as the current one.
    pub opset: Option<i64> = null,
    /// The weights `Params::load` reads out of a file where the build found
    /// them, rather than under a checkpoint header naming each.
    pub in_place: Option<InPlace> = null,
}

/// Weights left in the files the model names, at the byte ranges the build
/// found them at.
pub struct InPlace {
    /// Where each weight is, by its name.
    pub ranges: TreeMap<String, WeightRange>,
    /// The length of each file the build read the whole of, which the file
    /// `Params::load` reads must have.
    pub lens: TreeMap<String, i32> = TreeMap::<String, i32>::new(),
}

/// A weight's place: its file as the model names it, an external data file's
/// location or the model file's own name, and its first byte and the byte past
/// its last.
pub struct WeightRange {
    pub file: String,
    pub start: i32,
    pub end: i32,
}

impl InPlace {
    /// The files the weights are in, in their order of first use.
    pub fn files(&self) -> List<String> {
        let mut files: List<String> = [];
        for let [_, stored] of self.ranges.entries() {
            if !files.contains(&stored.file) {
                files.push(stored.file);
            }
        }
        return files;
    }
}

impl Graph {
    /// The tensors the graph reads and does not define, which a subgraph reads
    /// from the scope around it.
    pub fn outer_reads(&self) -> List<String> {
        let mut defined = HashSet::<String>::new();
        for let declared of [&self.inputs, &self.initializers] {
            for let vi of *declared {
                defined.insert(vi.name);
            }
        }
        for let [name, _] of self.constants.entries() {
            defined.insert(*name);
        }
        let mut read: List<String> = [];
        for let node of &self.nodes {
            for let input of node.reads() {
                if input != "" && !defined.contains(input) {
                    read.push(input);
                }
            }
            for let output of node.outputs {
                defined.insert(output);
            }
        }
        for let vi of &self.outputs {
            if !defined.contains(vi.name) {
                read.push(vi.name);
            }
        }
        return read;
    }
}

/// The version a model imports the default domain at, from `(domain, version)`
/// pairs: ONNX spells that domain `""` or `"ai.onnx"`.
pub fn default_opset(imports: &List<[String, i64]>) -> Option<i64> {
    for let [domain, version] of *imports {
        if domain == "" || domain == "ai.onnx" {
            return Option::Some(version);
        }
    }
    return null;
}

/// `nodes` as the current opset defines them, read from `opset`'s definitions.
/// A graph naming no opset is read as the current one. Arithmetic keeps its
/// `axis` only where it aligns B at it, as before opset 7 with `broadcast`,
/// which no later opset spells. A subgraph is read at its model's opset.
pub fn upgraded(nodes: List<Node>, opset: Option<i64>) -> Result<List<Node>, String> {
    let version = opset.unwrap_or(i64::MAX);
    let mut out: List<Node> = [];
    for let read of nodes {
        let node = Node { ..read, attrs: upgraded_subgraphs(read.attrs, opset)? };
        if is_binary_elementwise(&node.op) && node.attr("axis") matches { Some(_) } {
            let aligns = version < 7 && node.int_attr("broadcast", 0).map_err(|e| at_node(&node, e))? != 0;
            if !aligns {
                out.push(Node { ..node, attrs: node.attrs.into_iter().filter(|a| a.name != "axis").collect() });
                continue;
            }
        }
        if let Some(body) = function_body(&node)? {
            out.extend(&body);
            continue;
        }
        if version < 4 && node.op == "Concat" && node.attr("axis") matches { None } {
            let mut attrs = node.attrs;
            attrs.push(Attr {
                name: "axis",
                values: ["1"],
                is_list: false,
            });
            out.push(Node { ..node, attrs });
            continue;
        }
        out.push(node);
    }
    return Result::Ok(out);
}

/// The operators Loam lowers from outside ONNX's default domain, onnxruntime's,
/// as the domain qualifies each.
pub global GROUP_QUERY_ATTENTION: String = "com.microsoft.GroupQueryAttention";
pub global MATMUL_NBITS: String = "com.microsoft.MatMulNBits";
pub global GATHER_BLOCK_QUANTIZED: String = "com.microsoft.GatherBlockQuantized";

/// The nodes an operator defined as a function of others stands for, in the
/// operators Loam lowers, or `None` for any other operator. Each kernel the body
/// becomes is fused as written ones are, so an operator gains no kernel of its
/// own by being one. The body's tensors are named after the node's output.
///
/// - `Gelu` is ONNX's function (opset 20): `0.5 x (1 + erf(x / √2))`, or with
///   `approximate = "tanh"`, `0.5 x (1 + tanh(√(2/π) (x + 0.044715 x³)))`.
/// - `SimplifiedLayerNormalization` is onnxruntime's RMS normalization over the
///   last axis: `x / √(mean(x²) + epsilon) · scale`, the function ONNX's
///   `RMSNormalization` (opset 23) defines.
/// - `com.microsoft.SkipSimplifiedLayerNormalization` is that normalization
///   of a sum, which it also gives.
/// - `Max` and `Min` take any number of operands, two at a time.
/// - `Clip` is `Min(Max(x, min), max)`, as ONNX defines it, each bound an
///   optional operand, or before opset 11 an optional attribute.
fn function_body(node: &Node) -> Result<Option<List<Node>>, String> {
    let [needed, write]: [i32, fn(&Node, &mut FunctionBody) -> Result<(), String>] = match node.op.as_str_slice() {
        "Gelu" => [1, gelu],
        "SimplifiedLayerNormalization" => [2, rms_normalization],
        "com.microsoft.SkipSimplifiedLayerNormalization" => [3, skip_rms_normalization],
        "Max" | "Min" => [1, pairwise],
        "Clip" => [1, clip],
        _ => {
            return Result::Ok(null);
        },
    };
    let given = node.leading_operands();
    if given < needed {
        return Result::Err(`${node.site()}: ${operands_short(needed, given)}`);
    }
    let named = node.outputs.into_iter().find(|o| o != "");
    let mut body = FunctionBody { prefix: named.unwrap_or(node.op), x: node.inputs[0], nodes: [] };
    write(node, &mut body)?;
    return Result::Ok(Option::Some(body.nodes));
}

/// Why a node given `given` leading operands cannot be one reading `needed`.
pub fn operands_short(needed: i32, given: i32) -> String {
    let noun = if needed == 1 { "operand" } else { "operands" };
    return `reads ${needed} ${noun} and was given ${given}`;
}

/// An attribute `node` cannot read as written, said at the node.
fn at_node(node: &Node, e: AttrError) -> String {
    return `${node.site()}: ${e}`;
}

/// Computed in f32 and rounded once, since a half would round `erf` or `tanh`
/// near -1 to it, and the tanh form's cube past a half's range.
fn gelu(node: &Node, body: &mut FunctionBody) -> Result<(), String> {
    let given = node.inputs[0];
    let x = body.computed_in(given, 1);
    let inner = match node.string_attr("approximate", "none").map_err(|e| at_node(node, e))?.as_str_slice() {
        "none" => body.unary("Erf", &body.binary("Mul", &x, &body.constant(f32::sqrt(0.5)))),
        "tanh" => {
            let cube = body.binary("Mul", &body.binary("Mul", &x, &x), &x);
            let widened = body.binary("Add", &x, &body.binary("Mul", &cube, &body.constant(0.044715)));
            body.unary("Tanh", &body.binary("Mul", &widened, &body.constant(f32::sqrt(2.0 / f32::PI))));
        },
        other => {
            return Result::Err(`${node.site()}: approximate ${other} is neither none nor tanh`);
        },
    };
    let half = body.binary("Mul", &x, &body.constant(0.5));
    let product = body.binary("Mul", &half, &body.binary("Add", &inner, &body.constant(1.0)));
    body.output("CastLike", [product, given], node);
    return Result::Ok(());
}

fn rms_normalization(node: &Node, body: &mut FunctionBody) -> Result<(), String> {
    if node.int_attr("axis", -1).map_err(|e| at_node(node, e))? != -1 {
        return Result::Err(`${node.site()}: only the last axis normalizes`);
    }
    let stash = node.int_attr("stash_type", 1).map_err(|e| at_node(node, e))?;
    let x = body.computed_in(node.inputs[0], stash);
    return normalized_rows(node, body, &x, node.inputs[1]);
}

/// onnxruntime's `SkipSimplifiedLayerNormalization`: the RMS normalization of
/// `input + skip + bias`, and that sum as its fourth output. The sum is computed
/// in f32, and the normalization reads it there: onnxruntime normalizes a sum
/// of halves past a half's range, which the fourth output rounds to infinity.
fn skip_rms_normalization(node: &Node, body: &mut FunctionBody) -> Result<(), String> {
    if node.has_output(1) || node.has_output(2) {
        return Result::Err(`${node.site()}: names a mean or an inverse deviation, which only training reads`);
    }
    let given = node.inputs[0];
    let mut sum = body.binary("Add", &body.computed_in(given, 1), &body.computed_in(node.inputs[1], 1));
    if node.has_operand(3) {
        sum = body.binary("Add", &sum, &body.computed_in(node.inputs[3], 1));
    }
    body.x = sum;
    if node.has_output(3) {
        body.output_to("CastLike", [sum, given], node.outputs[3]);
    }
    if !node.has_output(0) {
        return Result::Ok(());
    }
    return normalized_rows(node, body, &sum, node.inputs[2]);
}

/// `x` normalized by the root of each last-axis row's mean square, then scaled
/// by `scale`, whose element the result takes.
fn normalized_rows(node: &Node, body: &mut FunctionBody, x: &String, scale: String) -> Result<(), String> {
    let epsilon = node.float_attr("epsilon", 1e-5).map_err(|e| at_node(node, e))?;
    let square = body.binary("Mul", x, x);
    let mean = body.node("ReduceMean", [square], [
        Attr {
            name: "axes",
            values: ["-1"],
            is_list: true,
        },
    ]);
    let root = body.unary("Sqrt", &body.binary("Add", &mean, &body.constant(epsilon)));
    // The result takes the scale's element, which may differ from the input's.
    let normalized = body.node("CastLike", [body.binary("Div", x, &root), scale], []);
    body.output("Mul", [normalized, scale], node);
    return Result::Ok(());
}

fn pairwise(node: &Node, body: &mut FunctionBody) -> Result<(), String> {
    let steps: List<[String, String]> = node.inputs.into_iter().skip(1).map(|operand| [node.op, operand]).collect();
    body.chained(node.inputs[0], steps, node);
    return Result::Ok(());
}

fn clip(node: &Node, body: &mut FunctionBody) -> Result<(), String> {
    let mut steps: List<[String, String]> = [];
    for let [index, bound, op] of [
        [1, "min", "Max"],
        [2, "max", "Min"],
    ] {
        if node.has_operand(index) {
            steps.push([op, node.inputs[index]]);
        } else if node.attr(bound) matches { Some(_) } {
            steps.push([op, body.constant(node.float_attr(bound, 0.0).map_err(|e| at_node(node, e))?)]);
        }
    }
    body.chained(node.inputs[0], steps, node);
    return Result::Ok(());
}

/// A function's body as it is written out, each tensor named under `prefix`.
struct FunctionBody {
    prefix: String,
    /// The function's first operand, whose element its constants take.
    x: String,
    nodes: List<Node>,
}

impl FunctionBody {
    /// A node of the body, and the tensor it computes.
    fn node(&mut self, op: String, inputs: List<String>, attrs: List<Attr>) -> String {
        let out = `${self.prefix}/${op}_${self.nodes.len()}`;
        self.nodes.push(Node {
            op,
            outputs: [out],
            inputs,
            attrs,
        });
        return out;
    }

    /// `value` in the element `x` has, as ONNX's function bodies write a
    /// constant: through `CastLike`.
    fn constant(&mut self, value: f32) -> String {
        let written = self.node("Constant", [], [
            Attr {
                name: "value_float",
                values: [`${value}`],
                is_list: false,
            },
        ]);
        return self.binary("CastLike", &written, &self.x);
    }

    fn unary(&mut self, op: String, x: &String) -> String {
        return self.node(op, [*x], []);
    }

    fn binary(&mut self, op: String, a: &String, b: &String) -> String {
        return self.node(op, [*a, *b], []);
    }

    /// `x` through each `[op, operand]` of `steps` in turn, the last of them
    /// computing the function's output, which is `x` where there is none.
    fn chained(&mut self, x: String, steps: List<[String, String]>, function: &Node) {
        let mut rest = steps;
        let Some([last_op, last]) = rest.pop() else {
            self.output("Identity", [x], function);
            return;
        };
        let mut reached = x;
        for let [op, operand] of rest {
            reached = self.binary(op, &reached, &operand);
        }
        self.output(last_op, [reached, last], function);
    }

    /// `given` cast to the element `TensorProto.DataType` numbers `to`, which
    /// the body's constants then take too.
    fn computed_in(&mut self, given: String, to: i64) -> String {
        self.x = self.node("Cast", [given], [
            Attr {
                name: "to",
                values: [`${to}`],
                is_list: false,
            },
        ]);
        return self.x;
    }

    /// The body's last node, which computes the function's output.
    fn output(&mut self, op: String, inputs: List<String>, function: &Node) {
        self.output_to(op, inputs, function.outputs[0]);
    }

    /// A node computing the function's output `name`.
    fn output_to(&mut self, op: String, inputs: List<String>, name: String) {
        self.nodes.push(Node {
            op,
            outputs: [name],
            inputs,
            attrs: [],
        });
    }
}

fn upgraded_subgraphs(attrs: List<Attr>, opset: Option<i64>) -> Result<List<Attr>, String> {
    let mut out: List<Attr> = [];
    for let a of attrs {
        let Some(g) = a.graph else {
            out.push(a);
            continue;
        };
        out.push(Attr { ..a, graph: Option::Some(Graph { ..g, nodes: upgraded(g.nodes, opset)?, opset }) });
    }
    return Result::Ok(out);
}

/// What stage 0 read already: a failure stopped the build there.
pub fn settled<T, E>(read: Result<T, E>) -> T {
    let Ok(value) = read else {
        unreachable();
    };
    return value;
}

/// Whether `op` broadcasts two operands against each other.
pub fn is_binary_elementwise(op: &String) -> bool {
    return binary_operator(op) matches { Some(_) };
}

/// What an operator broadcasting two operands against each other computes of
/// each pair, or `None` for any other operator.
pub fn binary_operator(op: &String) -> Option<BinaryOp> {
    return Option::Some(match op.as_str_slice() {
        "Add" => BinaryOp::Add,
        "Sub" => BinaryOp::Sub,
        "Mul" => BinaryOp::Mul,
        "Div" => BinaryOp::Div,
        "Pow" => BinaryOp::Pow,
        "Max" => BinaryOp::Maximum,
        "Min" => BinaryOp::Minimum,
        _ => {
            return null;
        },
    });
}

/// The one-operand operators an `Expr` applies: each a case of the runtime's
/// `UnaryOp`, by name.
pub fn is_unary_operator(op: &String) -> bool {
    return case_named::<UnaryOp>(op) matches { Some(_) };
}

/// The case of `E` named `name`, as the generated module spells it.
pub fn case_named<E: ReflectEnum + Display>(name: &String) -> Option<E> {
    let mut i = 0;
    while let Some(case) = ReflectEnum::<E>::from_discriminant(i) {
        if `${case}` == *name {
            return Option::Some(case);
        }
        i += 1;
    }
    return null;
}

/// How many of A's axes follow B's where arithmetic aligns B at A's `axis`, or
/// 0 where it aligns B at A's end, as numpy does.
pub fn trailing_axes(node: &Node, a_rank: i32, b_rank: i32) -> Result<i32, String>
    contract is_binary_elementwise(&node.op)
{
    if node.attr("axis") matches { None } {
        return Result::Ok(0);
    }
    let axis = node.int_attr("axis", 0).map_err(|e| `${e}`)?;
    if !(0 <= axis <= (a_rank - b_rank) as i64) {
        return Result::Err(`attribute axis is ${axis}, and B's ${b_rank} axes from there pass A's ${a_rank}`);
    }
    return Result::Ok(a_rank - b_rank - axis as i32);
}

/// A model neither reader can take, and why.
pub struct ReadError {
    pub reason: String,
}

impl Display for ReadError {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(&self.reason);
    }
}

impl Error for ReadError {
}

/// The message both readers give a build-time tensor written without values.
pub fn constant_without_values(tensor: &String) -> String {
    return `${tensor}: the build reads this tensor, so the graph must carry its values`;
}

/// The declared inputs that are parameters. An input an initializer also names
/// is that initializer's default, and Loam reads it from the graph.
pub fn parameters(
    inputs: List<ValueInfo>,
    initializers: &List<ValueInfo>,
    constants: &HashMap<String, Known>,
) -> List<ValueInfo> {
    let mut named: List<String> = [];
    for let vi of *initializers {
        named.push(vi.name);
    }
    let mut kept: List<ValueInfo> = [];
    for let vi of inputs {
        if !named.contains_str(&vi.name) && !constants.contains_key(vi.name) {
            kept.push(vi);
        }
    }
    return kept;
}

impl Display for Dim {
    fn fmt(&self, f: &mut Formatter) {
        match self {
            Static(n) => f.write_str(`${n}`),
            Bound([_, n]) => f.write_str(`${n}`),
            Symbol(s) => f.write_str(s),
            Unknown => f.write_str("?"),
        }
    }
}
