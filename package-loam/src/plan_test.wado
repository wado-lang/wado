use { infer } from "./infer.wado";
use { read } from "./onnx_text.wado";
use { Decision, Kind, Plan, Reason, plan } from "./plan.wado";

/// The plan for `source`.
fn plan_of(source: String, fuse: bool = true) -> Plan {
    let graph = read(&source).unwrap();
    return plan(&graph, &infer(&graph).unwrap(), fuse);
}

fn fused(into: String) -> Decision {
    return Decision::Fused(into);
}

fn written(reason: Reason) -> Decision {
    return Decision::Written(reason);
}

global MLP: String = `
mlp (float[N, 4] X) => (float[N, 2] Y)
<float[4, 3] W1, float[3] B1, float[3, 2] W2, float[2] B2>
{
    H = MatMul(X, W1)
    HB = Add(H, B1)
    A = Relu(HB)
    T = MatMul(A, W2)
    Y = Add(T, B2)
}
`;

test "a contraction and the elementwise chain after it fuse into the last kernel of the chain" {
    let p = plan_of(MLP);
    assert p.of(&"H") == fused("A");
    assert p.of(&"HB") == fused("A");
    // A kernel that takes a product in is no prologue of the product reading it.
    assert p.of(&"A") == written(Reason::Reader(Kind::Contraction));
    assert p.of(&"T") == fused("Y");
    assert p.of(&"Y") == written(Reason::Returned);
}

test "a kernel read only by a Shape is written, its reader making elements from extents alone" {
    let p = plan_of(`
shaped (float[N, 4] X) => (int64[2] S, float[N, 4] Y)
{
    R = Relu(X)
    S = Shape(R)
    Y = Neg(X)
}
`);
    // A Shape reads extents alone, which stage 0 has, so nothing reads R.
    assert p.of(&"R") == written(Reason::ReadTimes(0));
}

global LINEAR: String = `
lin (float[2, 4, 8] X, float[8, 6] W, float[6] B) => (float[2, 4, 6] Y)
<int64[2] Flat = {-1, 8}, int64[3] Back = {2, 4, 6}>
{
    F = Reshape(X, Flat)
    G = Gemm(F, W, B)
    R = Reshape(G, Back)
    Y = Relu(R)
}
`;

test "a Gemm between a flattening Reshape and its restoring one is one product over the leading axes" {
    let p = plan_of(LINEAR);
    assert p.lowering(0) matches { Flattened };
    assert p.lowering(2) matches { Restored };
    assert p.spread_of(&"G") matches { Some(s) && s.operand == "X" && s.restored == "R" };
    // So the operator after it joins its kernel.
    assert p.of(&"G") == fused("Y");
}

test "a Gemm whose flattened operand or product the scope returns is no spread" {
    for let returned of ["float[8, 8] F", "float[8, 6] G"] {
        let source = LINEAR.replace("=> (float[2, 4, 6] Y)", `=> (float[2, 4, 6] Y, ${returned})`);
        let p = plan_of(source);
        assert p.lowering(0) matches { Kernel };
        assert p.spread_of(&"G") matches { None };
    }
}

test "a Gemm whose bias varies along its rows is no spread" {
    let source = `
lin (float[2, 4, 8] X, float[8, 6] W, float[8, 6] B) => (float[2, 4, 6] Y)
<int64[2] Flat = {-1, 8}, int64[3] Back = {2, 4, 6}>
{
    F = Reshape(X, Flat)
    G = Gemm(F, W, B)
    R = Reshape(G, Back)
    Y = Relu(R)
}
`;
    assert plan_of(source).spread_of(&"G") matches { None };
}

test "a Reshape merging more than the leading axes is no spread" {
    // The restored axes lead with X's, yet the product's inner axis merges
    // X's last two, not X's last alone.
    let source = `
lin (float[2, 3, 4] X, float[12, 6] W) => (float[2, 3, 2] Y)
<int64[2] Flat = {2, 12}, int64[3] Back = {2, 3, 2}>
{
    F = Reshape(X, Flat)
    G = Gemm(F, W)
    Y = Reshape(G, Back)
}
`;
    assert plan_of(source).spread_of(&"G") matches { None };
}

test "with fusion off, nothing is spread" {
    let p = plan_of(LINEAR, false);
    assert p.lowering(0) matches { Kernel };
    assert p.spread_of(&"G") matches { None };
}

test "a value per row fused without a fold leaves the product before it in the kernel" {
    let source = `
g (float[N, 4] A, float[4, 8] B, float[N, 1] V) => (float[N, 8] Z)
{
    P = MatMul(A, B)
    S = Sqrt(V)
    Z = Mul(P, S)
}
`;
    let p = plan_of(source);
    assert p.of(&"P") == fused("Z");
    assert p.rows_of(&"Z") matches { None };
}

test "with fusion off, every kernel writes its output" {
    let p = plan_of(MLP, false);
    for let tensor of ["H", "HB", "A", "T", "Y"] {
        assert p.of(&tensor) == written(Reason::Unfused);
    }
}

test "a tensor one kernel reads twice fuses into it, computed once" {
    let source = `
g (float[N, 4] X) => (float[N, 4] Y)
{
    A = Relu(X)
    Y = Mul(A, A)
}
`;
    assert plan_of(source).of(&"A") == fused("Y");
}

test "a tensor two kernels read is written, since fusing it would compute it twice" {
    let source = `
g (float[N, 4] X) => (float[N, 4] Y, float[N, 4] Z)
{
    A = Relu(X)
    Y = Neg(A)
    Z = Abs(A)
}
`;
    assert plan_of(source).of(&"A") == written(Reason::ReadTimes(2));
}

test "a reduction along the last axis joins one row kernel with what it reads and what reads it" {
    let source = `
g (float[N, 4] X) => (float[N, 4] Y)
<int64[1] Axes = {1}>
{
    A = Relu(X)
    S = ReduceSum <keepdims = 1> (A, Axes)
    Y = Add(X, S)
}
`;
    let p = plan_of(source);
    assert p.of(&"A") == fused("Y");
    assert p.of(&"S") == fused("Y");
    assert p.rows_of(&"Y") matches { Some(_) };
}

test "a kernel over one value per row folds no row unless a reduction reaches it" {
    let source = `
g (float[N, 4] X) => (float[N, 1] Y)
<int64[1] Axes = {1}>
{
    S = ReduceMean <keepdims = 1> (X, Axes)
    E = Abs(S)
    Y = Sqrt(E)
}
`;
    let p = plan_of(source);
    assert p.of(&"S") == fused("Y");
    assert p.rows_of(&"Y") matches { Some(rows) && rows.axes[1].name == "X1" };
    let plain = plan_of(`
g (float[N, 1] X) => (float[N, 1] Y)
{
    Y = Relu(X)
}
`);
    assert plain.rows_of(&"Y") matches { None };
}

test "a reduction along another axis is a kernel of its own" {
    let source = `
g (float[N, 4] X) => (float[N, 4] Y)
<int64[1] Axes = {0}>
{
    A = Relu(X)
    S = ReduceSum <keepdims = 1> (A, Axes)
    Y = Add(X, S)
}
`;
    let p = plan_of(source);
    assert p.of(&"A") == written(Reason::Reader(Kind::Reduction));
    assert p.of(&"S") == written(Reason::Computes(Kind::Reduction));
}

test "a layer normalization is one row kernel" {
    let source = `
g (float[N, 4] X, float[4] G, float[4] B) => (float[N, 4] Y)
<int64[1] Axes = {1}>
{
    M = ReduceMean <keepdims = 1> (X, Axes)
    C = Sub(X, M)
    Two = Constant <value = float {2.0}> ()
    P = Pow(C, Two)
    V = ReduceMean <keepdims = 1> (P, Axes)
    Eps = Constant <value = float {0.00001}> ()
    A = Add(V, Eps)
    D = Sqrt(A)
    Q = Div(C, D)
    R = Mul(Q, G)
    Y = Add(R, B)
}
`;
    let p = plan_of(source);
    for let tensor of ["M", "C", "P", "V", "A", "D", "Q", "R"] {
        assert p.of(&tensor) == fused("Y");
    }
    assert p.rows_of(&"Y") matches { Some(_) };
}

test "a masked softmax takes in its scale and mask, and no product before it" {
    let source = `
g (float[N, 4] X, float[4, 4] W, bool[N, 4] K) => (float[N, 4] Y)
{
    S = MatMul(X, W)
    Half = Constant <value = float {0.5}> ()
    T = Mul(S, Half)
    Low = Constant <value = float {-10000.0}> ()
    U = Where(K, T, Low)
    Y = Softmax <axis = -1> (U)
}
`;
    let p = plan_of(source);
    assert p.of(&"T") == fused("Y");
    assert p.of(&"U") == fused("Y");
    assert p.of(&"S") == written(Reason::ContractionAndFold);
}

test "a tensor its reader stretches is written" {
    let source = `
g (float[N, 4] X, float[4] B) => (float[N, 4] Y)
{
    R = Relu(B)
    Y = Add(X, R)
}
`;
    assert plan_of(source).of(&"R") == written(Reason::Stretched);
}

/// Two products of one left operand, by initializers where `weights` and by
/// inputs otherwise, and their sum.
fn two_products_plan(weights: bool) -> Plan {
    let [inputs, initializers] = if weights {
        ["", "<float[4, 3] W, float[4, 3] V>"];
    } else {
        [", float[4, 3] W, float[4, 3] V", ""];
    };
    return plan_of(`
g (float[N, 4] X${inputs}) => (float[N, 3] Y)
${initializers}
{
    P = MatMul(X, W)
    Q = MatMul(X, V)
    Y = Add(P, Q)
}
`);
}

test "two products of one left operand pair in one kernel" {
    let p = two_products_plan(true);
    assert p.of(&"Q") == fused("Y");
    assert p.of(&"P") == fused("Y");
    assert p.pairs == [
        ["P", "Q"],
    ];
}

test "two products by weights no backend holds together do not pair" {
    let p = two_products_plan(false);
    assert p.of(&"Q") == fused("Y");
    assert p.of(&"P") == written(Reason::SecondContraction);
    assert p.pairs.is_empty();
}

test "a kernel takes in one contraction, and the second is written" {
    let source = `
g (float[N, 4] X, float[N, 4] Z, float[4, 3] W, float[4, 3] V) => (float[N, 3] Y)
{
    P = MatMul(X, W)
    Q = MatMul(Z, V)
    Y = Add(P, Q)
}
`;
    let p = plan_of(source);
    // The nodes are read last to first, so the later product is the one taken in.
    assert p.of(&"Q") == fused("Y");
    assert p.of(&"P") == written(Reason::SecondContraction);
}

/// An RMS normalization that two products read, by initializers where
/// `weights` and by inputs otherwise.
fn normalized_plan(weights: bool) -> Plan {
    let [inputs, initializers] = if weights {
        ["", ", float[4, 3] W, float[4, 3] V"];
    } else {
        [", float[4, 3] W, float[4, 3] V", ""];
    };
    return plan_of(`
g (float[N, 4] X${inputs}) => (float[N, 3] Y)
<float[4] G, int64[1] Axes = {1}${initializers}>
{
    S = Mul(X, X)
    M = ReduceMean <keepdims = 1> (S, Axes)
    Eps = Constant <value = float {0.000001}> ()
    A = Add(M, Eps)
    D = Sqrt(A)
    Q = Div(X, D)
    H = Mul(Q, G)
    P = MatMul(H, W)
    R = MatMul(H, V)
    Y = Add(P, R)
}
`);
}

test "a row kernel only products by weights read is their kernel's prologue" {
    let p = normalized_plan(true);
    assert p.of(&"H") == Decision::Prologue("Y");
    for let tensor of ["S", "M", "A", "D", "Q"] {
        assert p.of(&tensor) == fused("H");
    }
    assert p.rows_of(&"H") matches { Some(_) };
    assert p.pairs == [
        ["P", "R"],
    ];
}

test "a row kernel products by inputs read is written" {
    let p = normalized_plan(false);
    assert p.of(&"H") == written(Reason::Reader(Kind::Contraction));
}

test "a row kernel writing one value per row is no prologue" {
    let source = `
g (float[N, 4] X) => (float[N, 3] Y)
<int64[1] Axes = {1}, float[1, 3] W>
{
    S = Mul(X, X)
    M = ReduceMean <keepdims = 1> (S, Axes)
    Y = MatMul(M, W)
}
`;
    let p = plan_of(source);
    assert p.of(&"S") == fused("M");
    assert p.of(&"M") == written(Reason::Reader(Kind::Contraction));
}

/// The plan of three products of one normalized input by weights of 3, 2 and
/// 3 columns, each returned, the first read through `first`.
fn concatenated_plan(first: String) -> Plan {
    return plan_of(`
g (float[N, 4] X) => (float[N, 3] Y, float[N, 2] R, float[N, 3] T)
<int64[1] Axes = {1}, float[4, 3] W, float[4, 2] V, float[4, 3] U>
{
    S = Mul(X, X)
    M = ReduceMean <keepdims = 1> (S, Axes)
    D = Sqrt(M)
    H = Div(X, D)
    P = MatMul(H, W)
    R = MatMul(H, V)
    T = MatMul(H, U)
    Y = ${first}(P)
}
`);
}

test "products of one input by weights, each a kernel alone, are one product" {
    let p = concatenated_plan("Identity");
    assert p.concats.len() == 1;
    assert p.concats.get("P") == Option::Some(["P", "R", "T"]);
    assert p.of(&"R") == Decision::Concatenated("P");
    assert p.of(&"T") == Decision::Concatenated("P");
    assert p.of(&"H") == Decision::Prologue("P");
}

test "a product with an operator after it is not concatenated" {
    let p = concatenated_plan("Relu");
    assert p.concats.get("R") == Option::Some(["R", "T"]);
    assert p.of(&"P") == fused("Y");
    assert p.of(&"H") == written(Reason::Reader(Kind::Contraction));
}

test "a window takes in no operator after it" {
    let source = `
g (float[1, 1, 4, 4] X) => (float[1, 1, 2, 2] Y)
{
    P = MaxPool <kernel_shape = [2, 2], strides = [2, 2]> (X)
    Y = Relu(P)
}
`;
    assert plan_of(source).of(&"P") == written(Reason::Computes(Kind::Window));
}

test "a fused chain names the kernel that finally writes it" {
    let source = `
g (float[N, 4] X) => (float[N, 4] Y)
{
    A = Relu(X)
    B = Neg(A)
    Y = Abs(B)
}
`;
    let p = plan_of(source);
    assert p.of(&"A") == fused("Y");
    assert p.of(&"B") == fused("Y");
}

/// A language model's head: the hidden states by the token embedding's
/// transpose. The embedding is a weight unless `input`, and the scope returns
/// the transpose too where `returned`.
fn head_plan(input: bool, returned: bool) -> Plan {
    let embedding = "float[6, 4] E";
    let inputs = if input { `float[1, 2, 4] X, ${embedding}` } else { "float[1, 2, 4] X" };
    let outputs = if returned { "float[1, 2, 6] Y, float[4, 6] T" } else { "float[1, 2, 6] Y" };
    let weights = if input { "" } else { `<${embedding}>` };
    return plan_of(`
head (${inputs}) => (${outputs})
${weights}
{
    T = Transpose(E)
    Y = MatMul(X, T)
}
`);
}

test "a weight's transpose only a product reads is read as the weight is stored" {
    let p = head_plan(false, false);
    assert p.lowering(0) matches { Transposed };
    assert p.lowering(1) matches { Kernel };
}

test "a transpose of an input, or one read again, is written" {
    assert head_plan(true, false).lowering(0) matches { Kernel };
    assert head_plan(false, true).lowering(0) matches { Kernel };
}

test "a product by an attention key's transpose, of rank 3, is written" {
    let source = `
scores (float[1, 2, 4] Q, float[1, 3, 4] K) => (float[1, 2, 3] Y)
{
    T = Transpose<perm = [0, 2, 1]>(K)
    Y = MatMul(Q, T)
}
`;
    assert plan_of(source).lowering(0) matches { Kernel };
}
