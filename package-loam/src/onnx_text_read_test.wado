//! What the reader takes out of a graph, on the forms a real model carries.

use { AttrError, Dim, Elements, Graph, Known, Rank, ReadError } from "./graph.wado";
use { read } from "./onnx_text.wado";

fn is_error<E: Error>() {
}

test "a reader's failure and an attribute's are Errors" {
    is_error::<ReadError>();
    is_error::<AttrError>();
}

test "an attribute read names the attribute it failed on" {
    let g = read(`agraph (float[2] X) => (float[2] Y) { Y = Softmax <axis = [1, 2]> (X) }`).unwrap();
    let e = g.nodes[0].int_attr("axis", -1).unwrap_err();
    assert e.attr == "axis";
    assert `${e}` == "attribute axis is a list and the operator reads one value";
}

global MLP: String = `<ir_version: 7, opset_import: [ "" : 10 ]>
mlp (float[N, 128] X) => (float[N, 10] Y)
<float[128, 64] W1, float[64] B1, float[64, 10] W2, float[10] B2>
{
    H = MatMul(X, W1)
    HB = Add(H, B1)
    A = Relu(HB)
    T = MatMul(A, W2)
    Y = Add(T, B2)
}`;

fn mlp() -> Graph {
    return read(&MLP).unwrap();
}

fn dims(rank: &Rank) -> List<Dim> {
    return match rank {
        Dims(d) => *d,
        Scalar => panic("expected a ranked tensor, found a scalar"),
        Unranked => panic("expected a ranked tensor, found an unranked one"),
    };
}

test "the graph carries its name" {
    assert mlp().name == "mlp";
}

test "the default domain's opset comes off the model's metadata" {
    assert mlp().opset == Option::Some(10);
    assert read("g (float[1] X) => (float[1] Y) { Y = Relu(X) }").unwrap().opset == null;
}

test "a Concat before opset 4 without an axis reads as the axis 1 it defaulted to" {
    let g = read(`<ir_version: 3, opset_import: ["" : 3]> g (float[1, 2] X) => (float[1, 4] Y) { Y = Concat(X, X) }`).unwrap(
    );
    assert g.nodes[0].attr("axis").unwrap().values == ["1"] as List<String>;
}

test "arithmetic before opset 7 aligned at an axis stops the build" {
    let e = read(
        `<ir_version: 3, opset_import: ["" : 6]> g (float[2, 3] X, float[2] B) => (float[2, 3] Y) {
            Y = Add <broadcast = 1, axis = 0> (X, B)
        }`,
    ).unwrap_err().reason;
    assert e == "Y = Add: opset 6 aligns the operands at attribute axis, which no later opset does";
}

test "an input's dtype and dimensions come off its type" {
    let g = mlp();
    assert g.inputs.len() == 1;
    assert g.inputs[0].name == "X";
    assert g.inputs[0].dtype == "float";

    let d = dims(&g.inputs[0].rank);
    assert d.len() == 2;
    assert `${d[0]}` == "N";
    assert `${d[1]}` == "128";
}

test "initializers are read in order, separately from the inputs" {
    let g = mlp();
    assert g.initializers.len() == 4;
    assert g.initializers[0].name == "W1";
    assert g.initializers[3].name == "B2";
    assert dims(&g.initializers[1].rank).len() == 1;
}

test "a node carries its operator and both name lists" {
    let g = mlp();
    assert g.nodes.len() == 5;
    assert g.nodes[0].op == "MatMul";
    assert g.nodes[0].outputs == ["H"];
    assert g.nodes[0].inputs == ["X", "W1"];
    assert g.nodes[2].op == "Relu";
    assert g.nodes[2].inputs == ["HB"];
}

test "the graph's output is a value info of its own" {
    let g = mlp();
    assert g.outputs.len() == 1;
    assert g.outputs[0].name == "Y";
    assert `${dims(&g.outputs[0].rank)[1]}` == "10";
}

test "a quoted name loses its quotes" {
    let g = read(
        `agraph (float[2] "input.1") => (float[2] "/out") {
            "/out" = Relu("input.1")
        }`,
    ).unwrap();
    assert g.inputs[0].name == "input.1";
    assert g.nodes[0].outputs == ["/out"];
    assert g.nodes[0].inputs == ["input.1"];
}

test "an unknown dimension is distinct from a symbolic one" {
    let g = read(
        `agraph (float[N, ?] X) => (float[N, ?] Y) {
            Y = Relu(X)
        }`,
    ).unwrap();
    let d = dims(&g.inputs[0].rank);
    assert d[0] matches { Symbol(_) };
    assert d[1] matches { Unknown };
}

test "a scalar and an unranked tensor are told apart" {
    let g = read(
        `agraph (float X, float[] Z) => (float Y) {
            Y = Add(X, Z)
        }`,
    ).unwrap();
    assert g.inputs[0].rank matches { Scalar };
    assert g.inputs[1].rank matches { Unranked };
}

test "an operator keeps its domain" {
    let g = read(
        `agraph (float[2] X) => (float[2] Y) {
            Y = com.microsoft.Gelu(X)
        }`,
    ).unwrap();
    assert g.nodes[0].op == "com.microsoft.Gelu";
}

test "an attribute is read as the text the operator's schema types" {
    let g = read(
        `agraph (float[1, 3, 8, 8] X, float[4, 3, 3, 3] W) => (float[1, 4, 8, 8] Y) {
            Y = Conv <kernel_shape = [3, 3], alpha: float = 1.5, name = "c"> (X, W)
        }`,
    ).unwrap();
    let a = &g.nodes[0].attrs;
    assert a.len() == 3;
    assert a[0].name == "kernel_shape";
    assert a[0].is_list;
    assert a[0].values == ["3", "3"];
    assert a[1].name == "alpha";
    assert !a[1].is_list;
    assert a[1].values == ["1.5"];
    assert a[2].values == ["c"];
}

test "a float attribute may end its fraction at the point" {
    let g = read(
        `agraph (float[2] X) => (float[2] Y) {
            Y = LeakyRelu <alpha = 1.> (X)
        }`,
    ).unwrap();
    assert g.nodes[0].attrs[0].values == ["1.0"];
}

test "a tensor attribute is read as the tensor it spells" {
    let g = read(
        `agraph (float[2] X) => (float[2] Y) {
            S = Constant <value = float {0.125}> ()
            K = Constant <value = int64[2] {3, -4}> ()
            M = Constant <value = bool[2] {1, 0}> ()
            Y = Mul(X, S)
        }`,
    ).unwrap();
    assert g.nodes[0].attrs[0].tensor == Option::Some(Known { extents: [], elements: Elements::Floats([0.125]) });
    assert g.nodes[1].attrs[0].tensor == Option::Some(Known {
        extents: [2],
        elements: Elements::Ints([3, -4]),
    });
    assert g.nodes[2].attrs[0].tensor == Option::Some(Known {
        extents: [2],
        elements: Elements::Bools([true, false]),
    });
}

test "a tensor attribute of an element type not read carries no value" {
    let g = read(
        `agraph (float[2] X) => (float[2] Y) {
            S = Constant <value = float16 {15360}> ()
            Y = Identity(X)
        }`,
    ).unwrap();
    assert g.nodes[0].attrs[0].tensor matches { None };
    assert g.nodes[0].attrs[0].values.is_empty();
}

test "a list of tensor attributes is refused as one" {
    let e = read(
        `agraph (float[2] X) => (float[2] Y) {
            Y = Foo <values = [float {1}, float {2}]> (X)
        }`,
    ).unwrap_err().reason;
    assert e.ends_with("values: a list of tensors is not read");
}

test "an attribute after the input list reads as the same attribute" {
    let g = read(
        `agraph (float[2, 3] X) => (float[3, 2] Y) {
            Y = Transpose(X) <perm = [1, 0]>
        }`,
    ).unwrap();
    let a = &g.nodes[0].attrs;
    assert a.len() == 1;
    assert a[0].name == "perm";
    assert a[0].values == ["1", "0"];
    assert g.nodes[0].inputs == ["X"];
}

test "an initializer's inline values are not mistaken for its name" {
    let g = read(
        `agraph (float[2] X) => (float[2] Y)
        <float[2] W = {1.0, -2.5}>
        {
            Y = Add(X, W)
        }`,
    ).unwrap();
    assert g.initializers.len() == 1;
    assert g.initializers[0].name == "W";
    // 1.0 is 0x3f800000 and -2.5 is 0xc0200000, little-endian.
    assert g.initializers[0].data == Option::Some(b"\x00\x00\x80\x3f\x00\x00\x20\xc0");
}

test "an int64 initializer is an integer the build reads, not a weight" {
    let g = read(
        `agraph (float[2, 3] X) => (float[6] Y)
        <int64[1] S = {6}, float[2] W = {1.0, 2.0}>
        {
            Y = Reshape(X, S)
        }`,
    ).unwrap();
    assert g.constants.get("S") == Option::Some(Known {
        extents: [1],
        elements: Elements::Ints([6]),
    });
    assert g.initializers.len() == 1;
    assert g.initializers[0].name == "W";
}

test "a bool initializer is a constant the build reads" {
    let g = read(
        `agraph (float[2] X) => (float[2] Y)
        <bool[2] M = {1, 0}>
        {
            Y = Relu(X)
        }`,
    ).unwrap();
    assert g.constants.get("M") == Option::Some(Known {
        extents: [2],
        elements: Elements::Bools([true, false]),
    });
    assert g.initializers.is_empty();
}

test "an int64 initializer without inline values names itself" {
    let e = read(
        `agraph (float[2, 3] X) => (float[6] Y)
        <int64[1] S>
        {
            Y = Reshape(X, S)
        }`,
    ).unwrap_err().reason;
    assert e == "S: the build reads this tensor, so the graph must carry its values";
}

test "an initializer's extents are integers, as ONNX's tensors state them" {
    let e = read(
        `agraph (float[N, 2] X) => (float[N, 2] Y)
        <float[N] W>
        {
            Y = Add(X, W)
        }`,
    ).unwrap_err().reason;
    assert e == "W: an initializer's extents are integers";
}

test "an initializer without inline values carries no data" {
    assert mlp().initializers[0].data matches { None };
}

test "inline values that disagree with the shape name the tensor" {
    let e = read(
        `agraph (float[2] X) => (float[2] Y)
        <float[3] W = {1.0, -2.5}>
        {
            Y = Add(X, W)
        }`,
    ).unwrap_err().reason;
    assert e == "W: 2 elements for a shape of 3 or more";
}

test "a zero extent after a larger one still means no elements" {
    let g = read(
        `agraph (float[2] X) => (float[2] Y)
        <float[3, 0] W = {}>
        {
            Y = Identity(X)
        }`,
    ).unwrap();
    assert g.initializers[0].data == Option::Some(b"");
}

test "inline half values are bit patterns, as ONNX's parser reads them" {
    let g = read(
        `agraph (float16[2] X) => (float16[2] Y)
        <float16[2] W = {15360, 2049}, bfloat16[1] B = {49184}>
        {
            Y = Add(X, W)
        }`,
    ).unwrap();
    assert g.initializers[0].data == Option::Some(b"\x00\x3c\x01\x08");
    assert g.initializers[1].data == Option::Some(b"\x20\xc0");
}

test "a half bit pattern past sixteen bits names itself" {
    for let text of ["70000", "-1"] {
        let e = read(
            `agraph (float16[1] X) => (float16[1] Y)
            <float16[1] W = {${text}}>
            {
                Y = Add(X, W)
            }`,
        ).unwrap_err().reason;
        assert e == `W: ${text} is not a float16 bit pattern`;
    }
}

test "a decimal in a half tensor names itself" {
    let e = read(
        `agraph (float16[1] X) => (float16[1] Y)
        <float16[1] W = {1.0}>
        {
            Y = Add(X, W)
        }`,
    ).unwrap_err().reason;
    assert e == "W: 1.0 is not a float16 bit pattern";
}

test "a float may end its fraction at the point" {
    let g = read(
        `agraph (float[3] X) => (float[3] Y)
        <float[3] W = {1., 1.e1, -2.5}>
        {
            Y = Add(X, W)
        }`,
    ).unwrap();
    assert g.initializers[0].data == Option::Some(b"\x00\x00\x80\x3f\x00\x00\x20\x41\x00\x00\x20\xc0");
}

test "a float may not start at the point" {
    let e = read(
        `agraph (float[1] X) => (float[1] Y)
        <float[1] W = {.5}>
        {
            Y = Add(X, W)
        }`,
    ).unwrap_err().reason;
    assert e.starts_with("2:");
}

test "a syntax error comes back with its position" {
    let e = read("agraph (float[2] X) => (float[2] Y)").unwrap_err().reason;
    assert e.starts_with("1:");
}

test "an initializer pointing at another file names itself rather than being dropped" {
    let e = read(
        `agraph (float[2] X) => (float[2] Y)
        <float[2] W = ["location": "weights.bin"]>
        {
            Y = Add(X, W)
        }`,
    ).unwrap_err().reason;
    assert e == "W: an initializer whose data lives in another file is not read";
}

test "a sequence type names itself rather than being read as a tensor" {
    let e = read(
        `agraph (seq(float[2]) X) => (float[2] Y) {
            Y = Relu(X)
        }`,
    ).unwrap_err().reason;
    assert e == "X: only a tensor type is read, not a sequence or a map";
}
