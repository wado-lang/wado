//! Reading a graph out of a serialized ONNX `ModelProto`. The schema is
//! `onnx.proto` as ONNX ships it, and Grog generates its types.

use { HashMap, TreeMap } from "core:collections";
use grog from "lib:grog";
use onnx from "./onnx.proto"
    with {
        generator: { module: "lib:grog" },
    };
use {
    Attr,
    Dim,
    Elements,
    Graph,
    InPlace,
    Known,
    Stored,
    Node,
    Rank,
    ReadError,
    ValueInfo,
    bit_pattern,
    check_element_count,
    constant_without_values,
    default_opset,
    element_of,
    is_build_time,
    parameters,
    push_element,
    rank_of,
    upgraded,
} from "./graph.wado";

/// A bare `TensorProto`, which is how ONNX's backend test data stores one.
pub fn read_tensor<S: AsByteSlice>(bytes: S) -> Result<onnx::TensorProto, String> {
    return grog::decode::<onnx::TensorProto, S>(bytes).map_err(|e| `${e}`);
}

/// A tensor's elements, from its typed field or the little-endian `raw_data`
/// every exporter writes. `None` for an element type not read.
pub fn known_tensor(t: &onnx::TensorProto) -> Result<Option<Known>, String> {
    let name = name_of(t);
    let raw = t.raw_data.unwrap_or(b"");
    let Some(element) = onnx::TensorProtoDataType::from_number(t.data_type.unwrap_or(0)) else {
        return Result::Ok(null);
    };
    let [width, stored] = match element {
        Float => [4, Stored::Computed],
        Int32 => [4, Stored::Int32],
        Int64 => [8, Stored::Computed],
        Bool => [1, Stored::Computed],
        Float16 => [2, Stored::Float16],
        Bfloat16 => [2, Stored::BFloat16],
        _ => {
            return Result::Ok(null);
        },
    };
    if raw.len() % width != 0 {
        return Result::Err(`${name}: ${raw.len()} raw bytes is not whole elements of ${width} bytes`);
    }
    let typed = raw.is_empty();
    let elements = match element {
        Float => Elements::Floats(if typed { t.float_data } else { List::<f32>::from_le_bytes(raw) }),
        Int32 => {
            let values = if typed { t.int32_data } else { List::<i32>::from_le_bytes(raw) };
            Elements::Ints(values.into_iter().map(|v| v as i64).collect());
        },
        Int64 => Elements::Ints(if typed { t.int64_data } else { List::<i64>::from_le_bytes(raw) }),
        Bool => {
            let values = if typed {
                t.int32_data;
            } else {
                List::<u8>::from_le_bytes(raw).into_iter().map(|v| v as i32).collect();
            };
            Elements::Bools(values.into_iter().map(|v| v != 0).collect());
        },
        Float16 | Bfloat16 => {
            let mut bits: List<u16> = [];
            if typed {
                let dtype = dtype_name(element.number()).unwrap();
                for let v of t.int32_data {
                    bits.push(bit_pattern(&name, &dtype, v, width)? as u16);
                }
            } else {
                bits = List::<u16>::from_le_bytes(raw);
            }
            Elements::Floats(bits.into_iter().map(|b| stored.widened(b)).collect());
        },
        _ => unreachable(),
    };
    let known = Known { extents: extents_of(t, &name)?, elements, stored };
    if known.len() == 0 && check_element_count(&name, 0, &known.extents).is_err() {
        return Result::Err(constant_without_values(&name));
    }
    check_element_count(&name, known.len(), &known.extents)?;
    return Result::Ok(Option::Some(known));
}

fn name_of(t: &onnx::TensorProto) -> String {
    return t.name.unwrap_or("");
}

fn extents_of(t: &onnx::TensorProto, name: &String) -> Result<List<i32>, String> {
    let mut extents: List<i32> = [];
    for let d of t.dims {
        extents.push(extent(d, name)?);
    }
    return Result::Ok(extents);
}

/// The element type name the textual format spells for a `TensorProto.DataType`:
/// the enum's own name in lower case, for the types up to `bfloat16`.
internal fn dtype_name(elem_type: i32) -> Option<String> {
    let Some(element) = onnx::TensorProtoDataType::from_number(elem_type) else {
        return null;
    };
    if element matches { Undefined } || element.number() > onnx::TensorProtoDataType::Bfloat16.number() {
        return null;
    }
    return Option::Some(`${element}`.to_ascii_lowercase());
}

/// An ONNX `int64` dimension as the shape algebra's `i32` extent.
fn extent(dim: i64, tensor: &String) -> Result<i32, String> {
    if !(0 <= dim <= i32::MAX as i64) {
        return Result::Err(`${tensor}: dimension ${dim}`);
    }
    return Result::Ok(dim as i32);
}

fn read_dim(d: &onnx::TensorShapeProtoDimension, tensor: &String) -> Result<Dim, String> {
    return match &d.value {
        Some(DimParam(name)) => Result::Ok(Dim::Symbol(*name)),
        Some(DimValue(value)) => Result::Ok(Dim::Static(extent(*value, tensor)?)),
        None => Result::Ok(Dim::Unknown),
    };
}

fn read_value_info(vi: &onnx::ValueInfoProto) -> Result<ValueInfo, String> {
    let name = vi.name.unwrap_or("");
    let Some(ty) = &vi.type else {
        return Result::Err(`${name}: a value with no type`);
    };
    let Some(TensorType(tensor)) = &ty.value else {
        return Result::Err(`${name}: a value that is not a tensor`);
    };
    let elem_type = tensor.elem_type.unwrap_or(0);
    let Some(dtype) = dtype_name(elem_type) else {
        return Result::Err(`${name}: element type ${elem_type}`);
    };
    let rank = match &tensor.shape {
        Some(shape) => {
            let mut dims: List<Dim> = [];
            for let d of shape.dim {
                dims.push(read_dim(&d, &name)?);
            }
            rank_of(dims);
        },
        None => Rank::Unranked,
    };
    return Result::Ok(ValueInfo { name, dtype, rank });
}

/// The `external_data` entry `key` of `t`.
fn external_entry(t: &onnx::TensorProto, key: String) -> Option<String> {
    let entry = t.external_data.into_iter().find(|e| e.key == Option::Some(key))?;
    return entry.value;
}

fn is_external(t: &onnx::TensorProto) -> bool {
    return !t.external_data.is_empty() || t.data_location matches { Some(External) };
}

/// The `external_data` entry `key` of `t` as a number, where `t` has one.
fn external_number(t: &onnx::TensorProto, name: &String, key: String) -> Result<Option<i64>, String> {
    let Some(text) = external_entry(t, key) else {
        return Result::Ok(null);
    };
    return Result::Ok(Option::Some(i64::from_str(&text).map_err(|_| `${*name}: external data ${key} ${text}`)?));
}

fn external_location(t: &onnx::TensorProto, name: &String) -> Result<String, String> {
    return external_entry(t, "location").ok_or(`${*name}: external data with no location`);
}

/// `t`'s bytes out of the file its `external_data` names, among `files`.
fn external_bytes(t: &onnx::TensorProto, name: &String, files: &HashMap<String, ByteList>) -> Result<ByteList, String> {
    let location = external_location(t, name)?;
    let Some(file) = files.get_ref_str(&location) else {
        return Result::Err(`${*name}: external data in ${location}, which the reader was not given`);
    };
    let offset = external_number(t, name, "offset")?.unwrap_or(0);
    let length = external_number(t, name, "length")?.unwrap_or(file.len() as i64 - offset);
    if offset < 0 || length < 0 || length > file.len() as i64 - offset {
        return Result::Err(
            `${*name}: external data at ${offset} for ${length} bytes, past the end of ${location}'s ${file.len()}`,
        );
    }
    return Result::Ok(file[offset as i32..<(offset + length) as i32].to_list() as ByteList);
}

/// An initializer as a `ValueInfo`: its name, type, extents and data. External
/// data comes out of `files`, or stays `in_place` where its file is not given.
fn read_initializer(
    t: &onnx::TensorProto,
    name: String,
    dtype: String,
    files: &HashMap<String, ByteList>,
    in_place: &mut Option<InPlace>,
) -> Result<ValueInfo, String> {
    let extents = extents_of(t, &name)?;
    let mut dims: List<Dim> = [];
    for let e of extents {
        dims.push(Dim::Static(e));
    }
    let data = if !is_external(t) {
        payload(t, &name, &dtype, &extents)?;
    } else if files.contains_key(external_location(t, &name)?) {
        Option::Some(external_payload(t, &name, &dtype, &extents, files)?);
    } else {
        leave_in_place(t, &name, &dtype, &extents, in_place)?;
        null;
    };
    return Result::Ok(ValueInfo { name, dtype, rank: rank_of(dims), data });
}

/// Records where `t`'s external data sits in its file, which the reader was
/// not given, for `Prepared::load` to read it there.
fn leave_in_place(
    t: &onnx::TensorProto,
    name: &String,
    dtype: &String,
    extents: &List<i32>,
    in_place: &mut Option<InPlace>,
) -> Result<(), String> {
    let location = external_location(t, name)?;
    let Some(element) = element_of(dtype) else {
        return Result::Err(`${*name}: external ${*dtype} data`);
    };
    let Some(length) = external_number(t, name, "length")? else {
        return Result::Err(`${*name}: external data in ${location} with no length, which a weight left in place states`);
    };
    let offset = external_number(t, name, "offset")?.unwrap_or(0);
    if offset < 0 || length < 0 || length > i32::MAX as i64 - offset {
        return Result::Err(`${*name}: external data at ${offset} for ${length} bytes, past what a module can address`);
    }
    let width = element.width;
    if length % width as i64 != 0 {
        return Result::Err(`${*name}: ${length} raw bytes is not whole ${*dtype} elements`);
    }
    check_element_count(name, (length / width as i64) as i32, extents)?;
    let range = [offset as i32, (offset + length) as i32];
    let Some(held) = in_place else {
        let mut ranges = TreeMap::<String, [i32, i32]>::new();
        ranges[*name] = range;
        *in_place = Option::Some(InPlace { file: location, ranges });
        return Result::Ok(());
    };
    if held.file != location {
        let [first, _] = held.ranges.entries().next().unwrap();
        return Result::Err(
            `${*name}: external data in ${location}, and ${first}'s in ${held.file}; the weights left in place are in one file`,
        );
    }
    held.ranges[*name] = range;
    return Result::Ok(());
}

/// An external tensor's bytes, checked against its shape. They are copied out
/// of the file once and moved from there, since a weight can be most of a
/// model and a second copy of it is what a large model cannot afford.
fn external_payload(
    t: &onnx::TensorProto,
    name: &String,
    dtype: &String,
    extents: &List<i32>,
    files: &HashMap<String, ByteList>,
) -> Result<ByteList, String> {
    let Some(element) = element_of(dtype) else {
        return Result::Err(`${*name}: external ${*dtype} data`);
    };
    let bytes = external_bytes(t, name, files)?;
    let width = element.width;
    if bytes.len() % width != 0 {
        return Result::Err(`${*name}: ${bytes.len()} raw bytes is not whole ${*dtype} elements`);
    }
    check_element_count(name, bytes.len() / width, extents)?;
    return Result::Ok(bytes);
}

/// A tensor's elements as little-endian bytes: `raw_data` as it stands, or the
/// typed field re-encoded. A 16-bit element sits in the low half of an `int32`.
fn payload(
    t: &onnx::TensorProto,
    name: &String,
    dtype: &String,
    extents: &List<i32>,
) -> Result<Option<ByteList>, String> {
    let Some(element) = element_of(dtype) else {
        return Result::Ok(null);
    };
    let width = element.width;
    let mut bytes = t.raw_data.unwrap_or(b"");
    if bytes.is_empty() {
        if *dtype == "float" {
            for let v of t.float_data {
                push_element(&mut bytes, v.to_bits() as u64, width);
            }
        } else {
            for let v of t.int32_data {
                push_element(&mut bytes, bit_pattern(name, dtype, v, width)? as u64, width);
            }
        }
    }
    // No value field at all, on a shape that has elements: the checkpoint
    // supplies them, as a textual initializer written without `=` says.
    if bytes.is_empty() && check_element_count(name, 0, extents).is_err() {
        return Result::Ok(null);
    }
    if bytes.len() % width != 0 {
        return Result::Err(`${name}: ${bytes.len()} raw bytes is not whole ${dtype} elements`);
    }
    check_element_count(name, bytes.len() / width, extents)?;
    return Result::Ok(Option::Some(bytes));
}

/// An attribute's values as text, so the two readers hand `Attr` the same
/// thing. The declared `type` says which payload field holds them.
fn read_attr(a: &onnx::AttributeProto) -> Result<Attr, String> {
    let name = a.name.unwrap_or("");
    let mut values: List<String> = [];
    let is_list = a.type matches { Some(onnx::AttributeProtoAttributeType::Floats | onnx::AttributeProtoAttributeType::Ints | onnx::AttributeProtoAttributeType::Strings) };
    match a.type {
        Some(onnx::AttributeProtoAttributeType::Float) => values.push(`${a.f.unwrap_or(0.0)}`),
        Some(onnx::AttributeProtoAttributeType::Int) => values.push(`${a.i.unwrap_or(0)}`),
        Some(onnx::AttributeProtoAttributeType::String) => values.push(String::from_utf8_lossy(a.s.unwrap_or(b""))),
        Some(onnx::AttributeProtoAttributeType::Floats) => {
            for let v of a.floats {
                values.push(`${v}`);
            }
        },
        Some(onnx::AttributeProtoAttributeType::Ints) => {
            for let v of a.ints {
                values.push(`${v}`);
            }
        },
        Some(onnx::AttributeProtoAttributeType::Strings) => {
            for let v of a.strings {
                values.push(String::from_utf8_lossy(v));
            }
        },
        // A tensor has no text form, so it travels whole.
        Some(onnx::AttributeProtoAttributeType::Tensor) => {
            if let Some(t) = &a.t && let Some(known) = known_tensor(t)? {
                return Result::Ok(Attr { name, values, is_list, tensor: Option::Some(known) });
            }
        },
        Some(onnx::AttributeProtoAttributeType::Graph) => {
            if let Some(g) = &a.g {
                // A branch's own initializers stop the build, so none is external.
                let graph = read_graph(g, &HashMap::<String, ByteList>::new())?;
                return Result::Ok(Attr { name, values, is_list, graph: Option::Some(graph) });
            }
        },
        Some(onnx::AttributeProtoAttributeType::Graphs) => {
            return Result::Err(`${name}: a list of subgraphs is not read`);
        },
        // A type has no text form, so the attribute is carried with no value;
        // the operator that reads one is refused by name anyway.
        _ => {
        },
    }
    let is_string = a.type matches { Some(onnx::AttributeProtoAttributeType::String | onnx::AttributeProtoAttributeType::Strings) };
    return Result::Ok(Attr { name, values, is_list, is_string });
}

fn read_node(n: &onnx::NodeProto) -> Result<Node, String> {
    let mut attrs: List<Attr> = [];
    for let a of n.attribute {
        attrs.push(read_attr(&a)?);
    }
    return Result::Ok(Node { op: qualified_op(n), outputs: n.output, inputs: n.input, attrs });
}

/// The operator's name as the textual format writes it: qualified by its
/// domain, unless that is the default one. Two domains may each define an
/// operator of one name, such as `Gelu`, and they need not agree on it.
fn qualified_op(n: &onnx::NodeProto) -> String {
    let op = n.op_type.unwrap_or("");
    return match n.domain {
        Some(domain) && domain != "" && domain != "ai.onnx" => `${domain}.${op}`,
        _ => op,
    };
}

/// Read a graph out of a serialized `ModelProto`. What the subset does not
/// cover names itself, as the textual reader's errors do.
pub fn read<S: AsByteSlice>(bytes: S) -> Result<Graph, ReadError> {
    return read_with_external(bytes, &HashMap::<String, ByteList>::new());
}

/// Read a graph whose initializers may keep their data in other files: `files`
/// holds each such file's bytes under the location the model names it by.
pub fn read_with_external<S: AsByteSlice>(bytes: S, files: &HashMap<String, ByteList>) -> Result<Graph, ReadError> {
    return read_model(bytes, files).map_err(|reason| ReadError { reason });
}

/// The files a model's initializers keep their data in, each named once, as
/// `read_with_external` wants them.
pub fn external_locations<S: AsByteSlice>(bytes: S) -> Result<List<String>, ReadError> {
    let model = grog::decode::<onnx::ModelProto, S>(bytes).map_err(|e| ReadError { reason: `${e}` })?;
    let mut locations: List<String> = [];
    let Some(graph) = &model.graph else {
        return Result::Ok(locations);
    };
    for let t of graph.initializer {
        if let Some(location) = external_entry(&t, "location") && !locations.contains(&location) {
            locations.push(location);
        }
    }
    return Result::Ok(locations);
}

/// The serialized `ModelProto` `bytes` with every weight's `raw_data` moved to
/// an external data file at `location`, as an exporter writes a model too large
/// for one protobuf: the model, then that file. A constant keeps its data,
/// since the build reads it.
pub fn externalize<S: AsByteSlice>(bytes: S, location: String) -> Result<[ByteList, ByteList], ReadError> {
    let mut model = grog::decode::<onnx::ModelProto, S>(bytes).map_err(|e| ReadError { reason: `${e}` })?;
    let mut data: ByteList = [];
    if let Some(graph) = &mut model.graph {
        for let t of &mut graph.initializer {
            let Some(raw) = t.raw_data else {
                continue;
            };
            let Some(dtype) = dtype_name(t.data_type.unwrap_or(0)) else {
                continue;
            };
            if is_build_time(&dtype) {
                continue;
            }
            let entry = |key: String, value: String| onnx::StringStringEntryProto {
                key: Option::Some(key),
                value: Option::Some(value),
            };
            t.external_data = [
                entry("location", location),
                entry("offset", `${data.len()}`),
                entry("length", `${raw.len()}`),
            ];
            t.data_location = Option::Some(onnx::TensorProtoDataLocation::External);
            t.raw_data = null;
            data.extend(&raw);
        }
    }
    return Result::Ok([grog::encode(&model), data]);
}

fn read_model<S: AsByteSlice>(bytes: S, files: &HashMap<String, ByteList>) -> Result<Graph, String> {
    let model = grog::decode::<onnx::ModelProto, S>(bytes).map_err(|e| `${e}`)?;
    let Some(graph) = &model.graph else {
        return Result::Err("a model without a graph");
    };
    let written = read_graph(graph, files)?;
    let imports: List<[String, i64]> = model.opset_import.into_iter().map(|o| [
        o.domain.unwrap_or(""),
        o.version.unwrap_or(0),
    ]).collect();
    let opset = default_opset(&imports);
    return Result::Ok(Graph { ..written, nodes: upgraded(written.nodes, opset)?, opset });
}

/// A `GraphProto` as written, its operators not yet read at an opset.
fn read_graph(graph: &onnx::GraphProto, files: &HashMap<String, ByteList>) -> Result<Graph, String> {
    let mut initializers: List<ValueInfo> = [];
    let mut in_place: Option<InPlace> = null;
    let mut constants = HashMap::<String, Known>::new();
    for let t of graph.initializer {
        let name = name_of(&t);
        let elem_type = t.data_type.unwrap_or(0);
        let Some(dtype) = dtype_name(elem_type) else {
            return Result::Err(`${name}: element type ${elem_type}`);
        };
        if is_build_time(&dtype) {
            let inline = if is_external(&t) {
                onnx::TensorProto { ..t, raw_data: Option::Some(external_bytes(&t, &name, files)?) };
            } else {
                t;
            };
            constants[name] = known_tensor(&inline)?.unwrap();
        } else {
            initializers.push(read_initializer(&t, name, dtype, files, &mut in_place)?);
        }
    }
    let mut declared: List<ValueInfo> = [];
    for let vi of graph.input {
        declared.push(read_value_info(&vi)?);
    }
    let inputs = parameters(declared, &initializers, &constants);
    let mut outputs: List<ValueInfo> = [];
    for let vi of graph.output {
        outputs.push(read_value_info(&vi)?);
    }
    let mut nodes: List<Node> = [];
    for let n of graph.node {
        nodes.push(read_node(&n)?);
    }
    return Result::Ok(Graph {
        name: graph.name.unwrap_or(""),
        inputs,
        outputs,
        initializers,
        constants,
        nodes,
        in_place,
    });
}
