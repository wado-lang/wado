//! The ONNX protobuf format, as much of it as Loam reads, numbered as in
//! `vendor/onnx/onnx/onnx.proto`. Protobuf omits a default, so each field has one.

use { TreeMap } from "core:collections";
use { from_bytes } from "core:protobuf";
use {
    Attr,
    Dim,
    Elements,
    Graph,
    Known,
    Node,
    Rank,
    ReadError,
    ValueInfo,
    bit_pattern,
    check_element_count,
    constant_without_values,
    default_opset,
    element_of,
    is_build_time,
    parameters,
    push_element,
    upgraded,
} from "./graph.wado";

