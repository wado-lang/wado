pub struct TensorShapeProtoDimension {
    #[wire(number = 1)]
    pub dim_value: Option<i64> = null,
    #[wire(number = 2)]
    pub dim_param: Option<String> = null,
    #[wire(number = 3)]
    pub denotation: String = "",
}

pub struct TensorShapeProto {
    #[wire(number = 1)]
    pub dim: List<TensorShapeProtoDimension> = [],
}

pub struct TypeProtoTensor {
    #[wire(number = 1)]
    pub elem_type: i32 = 0,
    #[wire(number = 2)]
    pub shape: Option<TensorShapeProto> = null,
}

/// The schema's `oneof value`, which on the wire is ordinary fields of which
/// at most one is written.
pub struct TypeProto {
    #[wire(number = 1)]
    pub tensor_type: Option<TypeProtoTensor> = null,
}

pub struct ValueInfoProto {
    #[wire(number = 1)]
    pub name: String = "",
    #[wire(number = 2)]
    pub type_: Option<TypeProto> = null,
    #[wire(number = 3)]
    pub doc_string: String = "",
}

pub struct StringStringEntryProto {
    #[wire(number = 1)]
    pub key: String = "",
    #[wire(number = 2)]
    pub value: String = "",
}

pub struct TensorProto {
    #[wire(number = 1)]
    pub dims: List<i64> = [],
    #[wire(number = 2)]
    pub data_type: i32 = 0,
    #[wire(number = 4)]
    pub float_data: List<f32> = [],
    #[wire(number = 5)]
    pub int32_data: List<i32> = [],
    #[wire(number = 7)]
    pub int64_data: List<i64> = [],
    #[wire(number = 8)]
    pub name: String = "",
    #[wire(number = 9)]
    pub raw_data: ByteList = b"",
    #[wire(number = 10)]
    pub double_data: List<f64> = [],
    #[wire(number = 11)]
    pub uint64_data: List<u64> = [],
    #[wire(number = 13)]
    pub external_data: List<StringStringEntryProto> = [],
    #[wire(number = 14)]
    pub data_location: i32 = 0,
}

/// `TensorProto.DataLocation`: `EXTERNAL` says the bytes are in a file beside
/// the model rather than in `raw_data`.
pub global DATA_LOCATION_EXTERNAL: i32 = 1;

/// An attribute without `g` and `graphs`: only control flow, which Loam does
/// not cover, carries a subgraph, and one would make the declarations recursive.
pub struct AttributeProto {
    #[wire(number = 1)]
    pub name: String = "",
    #[wire(number = 2)]
    pub f: f32 = 0.0,
    #[wire(number = 3)]
    pub i: i64 = 0,
    #[wire(number = 4)]
    pub s: ByteList = b"",
    #[wire(number = 5)]
    pub t: Option<TensorProto> = null,
    #[wire(number = 7)]
    pub floats: List<f32> = [],
    #[wire(number = 8)]
    pub ints: List<i64> = [],
    #[wire(number = 9)]
    pub strings: List<ByteList> = [],
    #[wire(number = 10)]
    pub tensors: List<TensorProto> = [],
    #[wire(number = 20)]
    pub type_: i32 = 0,
}

/// `AttributeProto.AttributeType`, the discriminator saying which payload
/// field above is in use.
pub global ATTRIBUTE_FLOAT: i32 = 1;
pub global ATTRIBUTE_INT: i32 = 2;
pub global ATTRIBUTE_STRING: i32 = 3;
pub global ATTRIBUTE_TENSOR: i32 = 4;
pub global ATTRIBUTE_FLOATS: i32 = 6;
pub global ATTRIBUTE_INTS: i32 = 7;
pub global ATTRIBUTE_STRINGS: i32 = 8;
pub global ATTRIBUTE_TENSORS: i32 = 9;

pub struct NodeProto {
    #[wire(number = 1)]
    pub input: List<String> = [],
    #[wire(number = 2)]
    pub output: List<String> = [],
    #[wire(number = 3)]
    pub name: String = "",
    #[wire(number = 4)]
    pub op_type: String = "",
    #[wire(number = 5)]
    pub attribute: List<AttributeProto> = [],
    #[wire(number = 6)]
    pub doc_string: String = "",
    #[wire(number = 7)]
    pub domain: String = "",
}

pub struct GraphProto {
    #[wire(number = 1)]
    pub node: List<NodeProto> = [],
    #[wire(number = 2)]
    pub name: String = "",
    #[wire(number = 5)]
    pub initializer: List<TensorProto> = [],
    #[wire(number = 10)]
    pub doc_string: String = "",
    #[wire(number = 11)]
    pub input: List<ValueInfoProto> = [],
    #[wire(number = 12)]
    pub output: List<ValueInfoProto> = [],
    #[wire(number = 13)]
    pub value_info: List<ValueInfoProto> = [],
}

pub struct OperatorSetIdProto {
    #[wire(number = 1)]
    pub domain: String = "",
    #[wire(number = 2)]
    pub version: i64 = 0,
}

pub struct ModelProto {
    #[wire(number = 1)]
    pub ir_version: i64 = 0,
    #[wire(number = 2)]
    pub producer_name: String = "",
    #[wire(number = 3)]
    pub producer_version: String = "",
    #[wire(number = 4)]
    pub domain: String = "",
    #[wire(number = 5)]
    pub model_version: i64 = 0,
    #[wire(number = 6)]
    pub doc_string: String = "",
    #[wire(number = 7)]
    pub graph: Option<GraphProto> = null,
    #[wire(number = 8)]
    pub opset_import: List<OperatorSetIdProto> = [],
}

/// A tensor's elements, from its typed field or the little-endian `raw_data`
/// every exporter writes. `None` for an element type not read.
pub fn known_tensor(t: &TensorProto) -> Result<Option<Known>, String> {
    let raw = &t.raw_data;
    let width = match t.data_type {
        1 | 6 => 4,
        7 => 8,
        9 => 1,
        _ => {
            return Result::Ok(null);
        },
    };
    if raw.len() % width != 0 {
        return Result::Err(`${t.name}: ${raw.len()} raw bytes is not whole elements of ${width} bytes`);
    }
    let typed = raw.is_empty();
    let elements = match t.data_type {
        1 => Elements::Floats(if typed { t.float_data } else { List::<f32>::from_le_bytes(raw) }),
        6 => {
            let values = if typed { t.int32_data } else { List::<i32>::from_le_bytes(raw) };
            Elements::Ints(values.into_iter().map(|v| v as i64).collect());
        },
        7 => Elements::Ints(if typed { t.int64_data } else { List::<i64>::from_le_bytes(raw) }),
        9 => {
            let values = if typed {
                t.int32_data;
            } else {
                List::<u8>::from_le_bytes(raw).into_iter().map(|v| v as i32).collect();
            };
            Elements::Bools(values.into_iter().map(|v| v != 0).collect());
        },
        _ => unreachable(),
    };
    let known = Known { extents: extents_of(t)?, elements };
    if known.len() == 0 && check_element_count(&t.name, 0, &known.extents).is_err() {
        return Result::Err(constant_without_values(&t.name));
    }
    check_element_count(&t.name, known.len(), &known.extents)?;
    return Result::Ok(Option::Some(known));
}

fn extents_of(t: &TensorProto) -> Result<List<i32>, String> {
    let mut extents: List<i32> = [];
    for let d of t.dims {
        extents.push(extent(d, &t.name)?);
    }
    return Result::Ok(extents);
}

/// A `TensorProto.DataType` as the textual format names it, since one `Graph`
/// serves both readers.
fn dtype_name(elem_type: i32) -> Option<String> {
    return match elem_type {
        1 => Option::Some("float"),
        2 => Option::Some("uint8"),
        3 => Option::Some("int8"),
        4 => Option::Some("uint16"),
        5 => Option::Some("int16"),
        6 => Option::Some("int32"),
        7 => Option::Some("int64"),
        8 => Option::Some("string"),
        9 => Option::Some("bool"),
        10 => Option::Some("float16"),
        11 => Option::Some("double"),
        12 => Option::Some("uint32"),
        13 => Option::Some("uint64"),
        14 => Option::Some("complex64"),
        15 => Option::Some("complex128"),
        16 => Option::Some("bfloat16"),
        _ => null,
    };
}

/// An ONNX `int64` dimension as the extent the shape algebra holds. No tensor
/// that fits in memory needs a wider one, so a file stating one is refused.
fn extent(dim: i64, tensor: &String) -> Result<i32, String> {
    if !(0 <= dim <= i32::MAX as i64) {
        return Result::Err(`${tensor}: dimension ${dim}`);
    }
    return Result::Ok(dim as i32);
}

fn read_dim(d: &TensorShapeProtoDimension, tensor: &String) -> Result<Dim, String> {
    if let Some(name) = &d.dim_param {
        return Result::Ok(Dim::Symbol(*name));
    }
    if let Some(value) = d.dim_value {
        return Result::Ok(Dim::Static(extent(value, tensor)?));
    }
    return Result::Ok(Dim::Unknown);
}

fn read_value_info(vi: &ValueInfoProto) -> Result<ValueInfo, String> {
    let Some(ty) = &vi.type_ else {
        return Result::Err(`${vi.name}: a value with no type`);
    };
    let Some(tensor) = &ty.tensor_type else {
        return Result::Err(`${vi.name}: a value that is not a tensor`);
    };
    let Some(dtype) = dtype_name(tensor.elem_type) else {
        return Result::Err(`${vi.name}: element type ${tensor.elem_type}`);
    };
    let rank = match &tensor.shape {
        Some(shape) => {
            let mut dims: List<Dim> = [];
            for let d of shape.dim {
                dims.push(read_dim(&d, &vi.name)?);
            }
            Rank::Dims(dims);
        },
        None => Rank::Unranked,
    };
    return Result::Ok(ValueInfo { name: vi.name, dtype, rank });
}

fn check_inline(t: &TensorProto) -> Result<(), String> {
    if let Some(entry) = t.external_data.first() {
        return Result::Err(`${t.name}: external data (${entry.key})`);
    }
    if t.data_location == DATA_LOCATION_EXTERNAL {
        return Result::Err(`${t.name}: external data`);
    }
    return Result::Ok(());
}

/// An initializer as a `ValueInfo`: its name, type, extents and data.
fn read_initializer(t: &TensorProto, dtype: String) -> Result<ValueInfo, String> {
    let extents = extents_of(t)?;
    let mut dims: List<Dim> = [];
    for let e of extents {
        dims.push(Dim::Static(e));
    }
    return Result::Ok(ValueInfo {
        name: t.name,
        dtype,
        rank: Rank::Dims(dims),
        data: payload(t, &dtype, &extents)?,
    });
}

/// A tensor's elements as little-endian bytes: `raw_data` as it stands, or the
/// typed field re-encoded. A 16-bit element sits in the low half of an `int32`.
fn payload(t: &TensorProto, dtype: &String, extents: &List<i32>) -> Result<Option<ByteList>, String> {
    let Some(element) = element_of(dtype) else {
        return Result::Ok(null);
    };
    let width = element.width;
    let mut bytes = t.raw_data;
    if bytes.is_empty() {
        if width == 4 {
            for let v of t.float_data {
                push_element(&mut bytes, v.to_bits(), width);
            }
        } else {
            for let v of t.int32_data {
                push_element(&mut bytes, bit_pattern(&t.name, dtype, v, width)?, width);
            }
        }
    }
    // No value field at all, on a shape that has elements: the checkpoint
    // supplies them, as a textual initializer written without `=` says.
    if bytes.is_empty() && check_element_count(&t.name, 0, extents).is_err() {
        return Result::Ok(null);
    }
    if bytes.len() % width != 0 {
        return Result::Err(`${t.name}: ${bytes.len()} raw bytes is not whole ${dtype} elements`);
    }
    check_element_count(&t.name, bytes.len() / width, extents)?;
    return Result::Ok(Option::Some(bytes));
}

/// An attribute's values as text, so the two readers hand `Attr` the same
/// thing. The declared `type` says which payload field holds them.
fn read_attr(a: &AttributeProto) -> Result<Attr, String> {
    let mut values: List<String> = [];
    let mut is_list = true;
    match a.type_ {
        ATTRIBUTE_FLOAT => {
            values.push(`${a.f}`);
            is_list = false;
        },
        ATTRIBUTE_INT => {
            values.push(`${a.i}`);
            is_list = false;
        },
        ATTRIBUTE_STRING => {
            values.push(utf8(&a.s));
            is_list = false;
        },
        ATTRIBUTE_FLOATS => {
            for let v of a.floats {
                values.push(`${v}`);
            }
        },
        ATTRIBUTE_INTS => {
            for let v of a.ints {
                values.push(`${v}`);
            }
        },
        ATTRIBUTE_STRINGS => {
            for let v of a.strings {
                values.push(utf8(&v));
            }
        },
        // A tensor has no text form, so it travels whole.
        ATTRIBUTE_TENSOR => {
            is_list = false;
            if let Some(t) = &a.t && let Some(known) = known_tensor(t)? {
                return Result::Ok(Attr {
                    name: a.name,
                    values: [],
                    is_list: false,
                    tensor: Option::Some(known),
                });
            }
        },
        // A graph or a type has no text form, so the attribute is carried with
        // no value; the operator that reads one is refused by name anyway.
        _ => {
            is_list = false;
        },
    }
    return Result::Ok(Attr { name: a.name, values, is_list });
}

/// A string attribute, which ONNX declares as UTF-8 `bytes`. Bytes that are not
/// become U+FFFD, since failing would refuse a model over an attribute unread.
fn utf8(bytes: &ByteList) -> String {
    let mut out = String::with_capacity(bytes.len());
    if let Err(_) = out.push_utf8(bytes) {
        return "\u{FFFD}";
    }
    return out;
}

fn read_node(n: &NodeProto) -> Result<Node, String> {
    let mut attrs: List<Attr> = [];
    for let a of n.attribute {
        attrs.push(read_attr(&a)?);
    }
    return Result::Ok(Node { op: n.op_type, outputs: n.output, inputs: n.input, attrs });
}

/// Read a graph out of a serialized `ModelProto`. What the subset does not
/// cover names itself, as the textual reader's errors do.
pub fn read<S: AsByteSlice>(bytes: S) -> Result<Graph, ReadError> {
    return read_model(bytes).map_err(|reason| ReadError { reason });
}

fn read_model<S: AsByteSlice>(bytes: S) -> Result<Graph, String> {
    let model = match from_bytes::<ModelProto, S>(bytes) {
        Ok(m) => m,
        Err(e) => {
            return Result::Err(`${e.message}`);
        },
    };
    let Some(graph) = &model.graph else {
        return Result::Err("a model without a graph");
    };

    let mut initializers: List<ValueInfo> = [];
    let mut constants = TreeMap::<String, Known>::new();
    for let t of graph.initializer {
        check_inline(&t)?;
        let Some(dtype) = dtype_name(t.data_type) else {
            return Result::Err(`${t.name}: element type ${t.data_type}`);
        };
        if is_build_time(&dtype) {
            constants[t.name] = known_tensor(&t)?.unwrap();
        } else {
            initializers.push(read_initializer(&t, dtype)?);
        }
    }
    let mut declared: List<ValueInfo> = [];
    for let vi of graph.input {
        declared.push(read_value_info(&vi)?);
    }
    let inputs = parameters(declared, &initializers, &constants);
    let mut outputs: List<ValueInfo> = [];
    for let vi of graph.output {
        outputs.push(read_value_info(&vi)?);
    }
    let mut nodes: List<Node> = [];
    for let n of graph.node {
        nodes.push(read_node(&n)?);
    }
    let imports: List<[String, i64]> = model.opset_import.into_iter().map(|o| [o.domain, o.version]).collect();
    let opset = default_opset(&imports);
    return Result::Ok(Graph {
        name: graph.name,
        inputs,
        outputs,
        initializers,
        constants,
        nodes: upgraded(nodes, opset)?,
        opset,
    });
}
