//! Reading a graph out of a serialized ONNX `ModelProto`. The schema is
//! `onnx.proto` as ONNX ships it, and Grog generates its types.

use { TreeMap } from "core:collections";
use grog from "lib:grog";
use onnx from "./onnx.proto"
    with {
        generator: { module: "lib:grog" },
    };
use {
    Attr,
    Dim,
    Elements,
    Graph,
    Known,
    Node,
    Rank,
    ReadError,
    ValueInfo,
    bit_pattern,
    check_element_count,
    constant_without_values,
    default_opset,
    element_of,
    is_build_time,
    parameters,
    push_element,
    upgraded,
} from "./graph.wado";

/// A bare `TensorProto`, which is how ONNX's backend test data stores one.
pub fn read_tensor<S: AsByteSlice>(bytes: S) -> Result<onnx::TensorProto, String> {
    return grog::decode::<onnx::TensorProto, S>(bytes).map_err(|e| `${e}`);
}

/// A tensor's elements, from its typed field or the little-endian `raw_data`
/// every exporter writes. `None` for an element type not read.
pub fn known_tensor(t: &onnx::TensorProto) -> Result<Option<Known>, String> {
    let name = name_of(t);
    let raw = t.raw_data.unwrap_or(b"");
    let data_type = t.data_type.unwrap_or(0);
    let width = match data_type {
        1 | 6 => 4,
        7 => 8,
        9 => 1,
        _ => {
            return Result::Ok(null);
        },
    };
    if raw.len() % width != 0 {
        return Result::Err(`${name}: ${raw.len()} raw bytes is not whole elements of ${width} bytes`);
    }
    let typed = raw.is_empty();
    let elements = match data_type {
        1 => Elements::Floats(if typed { t.float_data } else { List::<f32>::from_le_bytes(raw) }),
        6 => {
            let values = if typed { t.int32_data } else { List::<i32>::from_le_bytes(raw) };
            Elements::Ints(values.into_iter().map(|v| v as i64).collect());
        },
        7 => Elements::Ints(if typed { t.int64_data } else { List::<i64>::from_le_bytes(raw) }),
        9 => {
            let values = if typed {
                t.int32_data;
            } else {
                List::<u8>::from_le_bytes(raw).into_iter().map(|v| v as i32).collect();
            };
            Elements::Bools(values.into_iter().map(|v| v != 0).collect());
        },
        _ => unreachable(),
    };
    let known = Known { extents: extents_of(t, &name)?, elements };
    if known.len() == 0 && check_element_count(&name, 0, &known.extents).is_err() {
        return Result::Err(constant_without_values(&name));
    }
    check_element_count(&name, known.len(), &known.extents)?;
    return Result::Ok(Option::Some(known));
}

fn name_of(t: &onnx::TensorProto) -> String {
    return t.name.unwrap_or("");
}

fn extents_of(t: &onnx::TensorProto, name: &String) -> Result<List<i32>, String> {
    let mut extents: List<i32> = [];
    for let d of t.dims {
        extents.push(extent(d, name)?);
    }
    return Result::Ok(extents);
}

/// The element type name the textual format spells for a `TensorProto.DataType`.
fn dtype_name(elem_type: i32) -> Option<String> {
    return match elem_type {
        1 => Option::Some("float"),
        2 => Option::Some("uint8"),
        3 => Option::Some("int8"),
        4 => Option::Some("uint16"),
        5 => Option::Some("int16"),
        6 => Option::Some("int32"),
        7 => Option::Some("int64"),
        8 => Option::Some("string"),
        9 => Option::Some("bool"),
        10 => Option::Some("float16"),
        11 => Option::Some("double"),
        12 => Option::Some("uint32"),
        13 => Option::Some("uint64"),
        14 => Option::Some("complex64"),
        15 => Option::Some("complex128"),
        16 => Option::Some("bfloat16"),
        _ => null,
    };
}

/// An ONNX `int64` dimension as the shape algebra's `i32` extent.
fn extent(dim: i64, tensor: &String) -> Result<i32, String> {
    if !(0 <= dim <= i32::MAX as i64) {
        return Result::Err(`${tensor}: dimension ${dim}`);
    }
    return Result::Ok(dim as i32);
}

fn read_dim(d: &onnx::TensorShapeProtoDimension, tensor: &String) -> Result<Dim, String> {
    return match &d.value {
        Some(DimParam(name)) => Result::Ok(Dim::Symbol(*name)),
        Some(DimValue(value)) => Result::Ok(Dim::Static(extent(*value, tensor)?)),
        None => Result::Ok(Dim::Unknown),
    };
}

fn read_value_info(vi: &onnx::ValueInfoProto) -> Result<ValueInfo, String> {
    let name = vi.name.unwrap_or("");
    let Some(ty) = &vi.type else {
        return Result::Err(`${name}: a value with no type`);
    };
    let Some(TensorType(tensor)) = &ty.value else {
        return Result::Err(`${name}: a value that is not a tensor`);
    };
    let elem_type = tensor.elem_type.unwrap_or(0);
    let Some(dtype) = dtype_name(elem_type) else {
        return Result::Err(`${name}: element type ${elem_type}`);
    };
    let rank = match &tensor.shape {
        Some(shape) => {
            let mut dims: List<Dim> = [];
            for let d of shape.dim {
                dims.push(read_dim(&d, &name)?);
            }
            Rank::Dims(dims);
        },
        None => Rank::Unranked,
    };
    return Result::Ok(ValueInfo { name, dtype, rank });
}

fn check_inline(t: &onnx::TensorProto, name: &String) -> Result<(), String> {
    if let Some(entry) = t.external_data.first() {
        return Result::Err(`${name}: external data (${entry.key.unwrap_or("")})`);
    }
    if t.data_location matches { Some(External) } {
        return Result::Err(`${name}: external data`);
    }
    return Result::Ok(());
}

/// An initializer as a `ValueInfo`: its name, type, extents and data.
fn read_initializer(t: &onnx::TensorProto, name: String, dtype: String) -> Result<ValueInfo, String> {
    let extents = extents_of(t, &name)?;
    let mut dims: List<Dim> = [];
    for let e of extents {
        dims.push(Dim::Static(e));
    }
    return Result::Ok(ValueInfo {
        name,
        dtype,
        rank: Rank::Dims(dims),
        data: payload(t, &name, &dtype, &extents)?,
    });
}

/// A tensor's elements as little-endian bytes: `raw_data` as it stands, or the
/// typed field re-encoded. A 16-bit element sits in the low half of an `int32`.
fn payload(
    t: &onnx::TensorProto,
    name: &String,
    dtype: &String,
    extents: &List<i32>,
) -> Result<Option<ByteList>, String> {
    let Some(element) = element_of(dtype) else {
        return Result::Ok(null);
    };
    let width = element.width;
    let mut bytes = t.raw_data.unwrap_or(b"");
    if bytes.is_empty() {
        if *dtype == "float" {
            for let v of t.float_data {
                push_element(&mut bytes, v.to_bits(), width);
            }
        } else {
            for let v of t.int32_data {
                push_element(&mut bytes, bit_pattern(name, dtype, v, width)?, width);
            }
        }
    }
    // No value field at all, on a shape that has elements: the checkpoint
    // supplies them, as a textual initializer written without `=` says.
    if bytes.is_empty() && check_element_count(name, 0, extents).is_err() {
        return Result::Ok(null);
    }
    if bytes.len() % width != 0 {
        return Result::Err(`${name}: ${bytes.len()} raw bytes is not whole ${dtype} elements`);
    }
    check_element_count(name, bytes.len() / width, extents)?;
    return Result::Ok(Option::Some(bytes));
}

/// An attribute's values as text, so the two readers hand `Attr` the same
/// thing. The declared `type` says which payload field holds them.
fn read_attr(a: &onnx::AttributeProto) -> Result<Attr, String> {
    let name = a.name.unwrap_or("");
    let mut values: List<String> = [];
    match a.type {
        Some(onnx::AttributeProtoAttributeType::Float) => values.push(`${a.f.unwrap_or(0.0)}`),
        Some(onnx::AttributeProtoAttributeType::Int) => values.push(`${a.i.unwrap_or(0)}`),
        Some(onnx::AttributeProtoAttributeType::String) => values.push(String::from_utf8_lossy(a.s.unwrap_or(b""))),
        Some(onnx::AttributeProtoAttributeType::Floats) => {
            for let v of a.floats {
                values.push(`${v}`);
            }
        },
        Some(onnx::AttributeProtoAttributeType::Ints) => {
            for let v of a.ints {
                values.push(`${v}`);
            }
        },
        Some(onnx::AttributeProtoAttributeType::Strings) => {
            for let v of a.strings {
                values.push(String::from_utf8_lossy(v));
            }
        },
        // A tensor has no text form, so it travels whole.
        Some(onnx::AttributeProtoAttributeType::Tensor) => {
            if let Some(t) = &a.t && let Some(known) = known_tensor(t)? {
                return Result::Ok(Attr { name, values, tensor: Option::Some(known) });
            }
        },
        // A graph or a type has no text form, so the attribute is carried with
        // no value; the operator that reads one is refused by name anyway.
        _ => {
        },
    }
    return Result::Ok(Attr { name, values });
}

fn read_node(n: &onnx::NodeProto) -> Result<Node, String> {
    let mut attrs: List<Attr> = [];
    for let a of n.attribute {
        attrs.push(read_attr(&a)?);
    }
    return Result::Ok(Node { op: n.op_type.unwrap_or(""), outputs: n.output, inputs: n.input, attrs });
}

/// Read a graph out of a serialized `ModelProto`. What the subset does not
/// cover names itself, as the textual reader's errors do.
pub fn read<S: AsByteSlice>(bytes: S) -> Result<Graph, ReadError> {
    return read_model(bytes).map_err(|reason| ReadError { reason });
}

fn read_model<S: AsByteSlice>(bytes: S) -> Result<Graph, String> {
    let model = grog::decode::<onnx::ModelProto, S>(bytes).map_err(|e| `${e}`)?;
    let Some(graph) = &model.graph else {
        return Result::Err("a model without a graph");
    };

    let mut initializers: List<ValueInfo> = [];
    let mut constants = TreeMap::<String, Known>::new();
    for let t of graph.initializer {
        let name = name_of(&t);
        check_inline(&t, &name)?;
        let data_type = t.data_type.unwrap_or(0);
        let Some(dtype) = dtype_name(data_type) else {
            return Result::Err(`${name}: element type ${data_type}`);
        };
        if is_build_time(&dtype) {
            constants[name] = known_tensor(&t)?.unwrap();
        } else {
            initializers.push(read_initializer(&t, name, dtype)?);
        }
    }
    let mut declared: List<ValueInfo> = [];
    for let vi of graph.input {
        declared.push(read_value_info(&vi)?);
    }
    let inputs = parameters(declared, &initializers, &constants);
    let mut outputs: List<ValueInfo> = [];
    for let vi of graph.output {
        outputs.push(read_value_info(&vi)?);
    }
    let mut nodes: List<Node> = [];
    for let n of graph.node {
        nodes.push(read_node(&n)?);
    }
    let imports: List<[String, i64]> = model.opset_import.into_iter().map(|o| [
        o.domain.unwrap_or(""),
        o.version.unwrap_or(0),
    ]).collect();
    let opset = default_opset(&imports);
    return Result::Ok(Graph {
        name: graph.name.unwrap_or(""),
        inputs,
        outputs,
        initializers,
        constants,
        nodes: upgraded(nodes, opset)?,
        opset,
    });
}
