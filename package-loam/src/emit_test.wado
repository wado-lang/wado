    let source = `
g (float[1, 4, 8] X) => (float[1, 4, 16] Y)
<float[8, 16] W>
{
    Y = MatMul(X, W)
}
`;
    let layout: List<LayoutRule> = [
        rule("X", ["Batch", "Seq", "Embed"]),
        rule("W", ["Embed", "Vocab"]),
    ];
    let out = generate(source, layout).unwrap();

    assert out.contains("let Y = backend.matmul_shared(&X, &weights.W, null);");
}

test "a MatMul batch axis that stretches lowers to matmul_broadcast, the result spelled" {
    let source = `
g (float[1, 2, 3] X, float[4, 3, 5] Z) => (float[4, 2, 5] Y)
{
    Y = MatMul(X, Z)
}
`;
    let layout: List<LayoutRule> = [
        rule("X", ["Batch", "Row", "K"]),
        rule("Z", ["Batch", "K", "Col"]),
    ];
    let out = generate(source, layout).unwrap();

    assert out.contains(
        "let Y = backend.matmul_broadcast::<[Batch, Row, K], [Batch, K, Col], [Batch, Row, Col]>(&X, &Z, null);",
    );
}

test "a rank-1 MatMul operand lowers to matmul_broadcast, which drops its axis" {
    let source = `
g (float[3] X, float[3, 5] Z) => (float[5] Y)
{
    Y = MatMul(X, Z)
}
`;
    let out = generate(source, [
        rule("X", ["K"]),
        rule("Z", ["K", "Col"]),
    ]).unwrap();

    assert out.contains("let Y = backend.matmul_broadcast::<[K], [K, Col], [Col]>(&X, &Z, null);");
}

fn refused_dtype(dtype: String) -> String {
    let source = `
g (${dtype}[N, 2] X) => (${dtype}[N, 2] Y)
<>
{
    Y = Relu(X)
}
`;
    return `${generate(source, [rule("*", ["Batch", "Unit"])]).unwrap_err()}`;
}

test "an element type the kernels cannot compute in names itself" {
    assert refused_dtype("int32") == "X: no kernel holds int32";
    assert refused_dtype("uint8") == "X: no kernel holds uint8";
}

test "a half precision boundary states its own element type" {
    let out = generate(mlp("float16"), mlp_layout()).unwrap();

    assert out.contains(
        "pub fn forward<Bk: Backend>(backend: &mut Bk, X: &Tensor<f16, [Batch, In]>, weights: &Prepared<Bk>) -> Tensor<f16, [Batch, Out]> with _ {",
    );
    assert out.contains("pub W1: Tensor<f16, [In, Hidden]>,");
}

test "a half precision boundary is prepared into the f32 the kernels compute in" {
    let out = generate(mlp("float16"), mlp_layout()).unwrap();

    // A weight once, where `Prepared` is built; an input on each call.
    assert out.contains("    pub W1: Bk::Tensor<f32, [In, Hidden]>,\n");
    assert out.contains("W1: backend.prepare(&self.W1),");
    assert out.contains("let X = backend.prepare(X);");
    assert out.contains("let A = backend.matmul(&X, &weights.W1, Option::Some(Epilogue {");
    assert out.contains("return narrow(&backend.download(&Y));");
}

test "bfloat16 is the same boundary with the other primitive" {
    let out = generate(mlp("bfloat16"), mlp_layout()).unwrap();

    assert out.contains("backend: &mut Bk, X: &Tensor<bf16, [Batch, In]>");
    assert out.contains("let X = backend.prepare(X);");
    assert out.contains("return narrow(&backend.download(&Y));");
}

// The textual format carries no tensor attribute, so a `Constant` graph is
// built here rather than read.
fn constant_graph(consumer: Node, produced: Rank, value: f32) -> Graph {
    let float2 = ValueInfo {
        name: "X",
        dtype: "float",
        rank: Rank::Dims([
            Dim::Symbol("N"),
            Dim::Static(2),
        ]),
    };
    return Graph {
        name: "g",
        inputs: [float2],
        outputs: [
            ValueInfo { name: consumer.outputs[0], dtype: "float", rank: produced },
        ],
        initializers: [],
        nodes: [
            Node {
                op: "Constant",
                outputs: ["C"],
                inputs: [],
                attrs: [
                    Attr {
                        name: "value",
                        values: [],
                        is_list: false,
                        tensor: Option::Some(Known {
                            extents: [],
                            elements: Elements::Floats([value]),
                        }),
                    },
                ],
            },
            consumer,
        ],
    };
}

fn node(op: String, output: String, inputs: List<String>) -> Node {
    return Node {
        op,
        outputs: [output],
        inputs,
        attrs: [],
    };
}

fn emit_graph(graph: &Graph) -> Result<String, EmitError> {
    let checked = infer(graph, &Schema {
        layout: [rule("*", ["Batch", "Unit"])],
    }).unwrap();
    return emit(graph, &checked, &RUNTIME);
}

fn matrix_rank() -> Rank {
    return Rank::Dims([
        Dim::Symbol("N"),
        Dim::Static(2),
    ]);
}

fn folded_add(value: f32) -> Result<String, EmitError> {
    return emit_graph(&constant_graph(node("Add", "Y", ["X", "C"]), matrix_rank(), value));
}

test "a symbol is bound from the input axis carrying it, and spelled where an extent needs it" {
    let source = `g (float[N, 4] X) => (float[N, 2, 2] Y) <int64[3] S = {0, 2, 2}> {
        Y = Reshape(X, S)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Seq", "Wide"]),
        rule("Y", ["Seq", "Row", "Col"]),
    ];
    let out = generate(source, layout).unwrap();
    assert out.contains("let dim_N = X.extents[0] as i64;");
    assert out.contains("let Y = backend.reshape::<f32, [Seq, Wide], [Seq, Row, Col]>(&X, [to_extent(dim_N), 2, 2]);");
}

test "a symbol nothing spells is not bound" {
    let out = generate(mlp("float"), mlp_layout()).unwrap();
    assert !out.contains("dim_");
}

test "a Range over a symbolic length is a kernel call" {
    let source = `g (int64[N] X) => (int64[N] Y) {
        S = Shape(X)
        Z = Constant <value = int64 {0}> ()
        O = Constant <value = int64 {1}> ()
        L = Gather <axis = 0> (S, Z)
        Y = Range(Z, L, O)
    }`;
    let out = generate(source, [rule("*", ["Seq"])]).unwrap();
    assert out.contains("let Y = backend.range_i64::<Seq>(0, to_extent(dim_N), 1);");
}

test "a clamp the run computes, read as its operand, is checked before any kernel" {
    let source = `g (float[N] X, float[8] M) => (float[N] Y) <int64[1] Z = {0}> {
        S = Shape(X)
        A = Slice(M, Z, S)
        Y = Add(A, X)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Seq"]),
        rule("M", ["Pos"]),
        rule("A", ["Seq"]),
    ];
    let out = generate(source, layout).unwrap();
    let check = out.find("refuse(unmet(-dim_N + 8, \"A = Slice: N must be at most 8\"));").unwrap();
    let call = "let A = backend.slice_axis::<f32, [], Pos, Seq, []>(&M, 0, 0, to_extent(i64::min(dim_N, 8)), 1);";
    let slice = out.find(call).unwrap();
    assert check < slice;
}

test "a Reshape -1 the build rounds is checked to divide before the kernel runs" {
    let source = `g (float[N] X) => (float[?, 2] Y) <int64[2] T = {-1, 2}> {
        Y = Reshape(X, T)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Seq"]),
        rule("Y", ["Pair", "Two"]),
    ];
    let out = generate(source, layout).unwrap();
    let check = out.find("refuse(unmet(-dim_N + 2 * floor_div(dim_N, 2), ").unwrap();
    let call = "let Y = backend.reshape::<f32, [Seq], [Pair, Two]>(&X, [to_extent(floor_div(dim_N, 2)), 2]);";
    let reshape = out.find(call).unwrap();
    assert check < reshape;
}

test "a Slice by a negative step walks back from its start" {
    let source = `g (float[N] X) => (float[N] Y) <int64[1] B = {-1}, int64[1] E = {-4000000000}, int64[1] Z = {0}, int64[1] Back = {-1}> {
        Y = Slice(X, B, E, Z, Back)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Seq"]),
        rule("Y", ["Rev"]),
    ];
    let out = generate(source, layout).unwrap();
    assert out.contains("let Y = backend.slice_axis::<f32, [], Seq, Rev, []>(&X, 0, dim_N - 1, to_extent(dim_N), -1);");
}

test "an int64 input is held as i64 through the layout kernels and Cast converts it" {
    let source = `g (int64[1, 4] M) => (float[1, 1, 4] Y) {
        A = Constant<value_ints = [1]>()
        U = Unsqueeze(M, A)
        Y = Cast<to = 1>(U)
    }`;
    let layout: List<LayoutRule> = [
        rule("M", ["Batch", "Key"]),
        rule("U", ["Batch", "Head", "Key"]),
    ];
    let out = generate(source, layout).unwrap();
    assert out.contains("M: &Tensor<i64, [Batch, Key]>");
    assert !out.contains("widen(");
    assert out.contains("let U = backend.reshape::<i64, [Batch, Key], [Batch, Head, Key]>(&M, [1, 1, 4]);");
    assert out.contains("let Y = backend.cast::<i64, f32, [Batch, Head, Key]>(&U);");
}

test "an embedding lookup is a row gather, and a folded index tensor is a literal" {
    let source = `g (int64[1, 4] I) => (float[1, 4, 8] Y) <float[16, 8] W, float[4, 8] P, int64[1, 4] Q = {0, 1, 2, 3}> {
        E = Gather(W, I)
        F = Gather(P, Q)
        Y = Add(E, F)
    }`;
    let layout: List<LayoutRule> = [
        rule("I", ["Batch", "Seq"]),
        rule("Q", ["Batch", "Seq"]),
        rule("W", ["Vocab", "Hidden"]),
        rule("P", ["Seq", "Hidden"]),
    ];
    let out = generate(source, layout).unwrap();
    assert out.contains("let E = backend.gather_rows(&weights.W, &I);");
    assert out.contains(
        "let Q = backend.upload(&Tensor::<i64, [Batch, Seq]> { data: [0, 1, 2, 3], extents: [1, 4] });",
    );
    assert out.contains("let F = backend.gather_rows(&weights.P, &Q);");
}

test "Gather along any axis but the first lowers to gather, the axes spelled" {
    let source = `g (int64[2] I) => (float[16, 2] Y) <float[16, 8] W> {
        Y = Gather<axis = 1>(W, I)
    }`;
    let layout: List<LayoutRule> = [
        rule("I", ["Pick"]),
        rule("W", ["Vocab", "Hidden"]),
    ];
    let out = generate(source, layout).unwrap();
    assert out.contains("let Y = backend.gather::<f32, [Vocab], Hidden, [], [Pick]>(&weights.W, &I, 1);");
}

test "a Cast to the element a tensor already has computes nothing" {
    let source = `g (float[2] X) => (float[2] Y) {
        C = Cast<to = 1>(X)
        Y = Relu(C)
    }`;
    let out = generate(source, [rule("*", ["Feat"])]).unwrap();
    assert !out.contains("let C");
    assert out.contains("let Y = backend.fused::<[Feat]>([backend.read(&X)], &operand(0).unary(UnaryOp::Relu));");
}

test "a Cast that truncates is spelled apart from the constant it reads" {
    // Both are held in i64, but the int32 cast keeps only the low half.
    let source = `g (float[2] M) => (int64[2] Y) {
        B = Cast<to = 9>(M)
        Q = Constant<value_ints = [4294967297, 2]>()
        C = Cast<to = 6>(Q)
        Y = Where(B, Q, C)
    }`;
    let out = generate(source, [rule("*", ["Pick"])]).unwrap();
    assert out.contains("data: [4294967297, 2]");
    assert out.contains("data: [1, 2]");
}

test "Identity names its operand again and computes nothing" {
    let source = `g (float[2] X) => (float[2] Y) <float[2] W = {1.0, 2.0}> {
        V = Identity(W)
        Y = Add(X, V)
    }`;
    let out = generate(source, [rule("*", ["Feat"])]).unwrap();
    assert out.contains(
        "let Y = backend.fused::<[Feat]>([backend.read(&X), backend.read(&weights.W)], &operand(0).binary(BinaryOp::Add, &operand(1)));",
    );
    assert !out.contains("let V");
}

test "a scale the graph computes from a shape folds to a literal" {
    // Attention's `1 / sqrt(head_dim)`, as an exporter writes it.
    let source = `g (float[2, 4] X) => (float[2, 4] Y) {
        S = Shape(X)
        I = Constant<value_int = 1>()
        D = Gather(S, I)
        F = Cast<to = 1>(D)
        H = Constant<value_float = 0.5>()
        R = Pow(F, H)
        Y = Div(X, R)
    }`;
    let out = generate(source, [rule("X", ["Batch", "Feat"])]).unwrap();
    assert out.contains(
        "let Y = backend.fused::<[Batch, Feat]>([backend.read(&X)], &operand(0).binary(BinaryOp::Div, &constant(2 as f32)));",
    );
    assert !out.contains("let S");
}

test "a Cast of a length only the run knows converts it at run time" {
    let source = `g (float[N, 4] X) => (float[N, 4] Y) {
        S = Shape(X)
        I = Constant<value_int = 0>()
        D = Gather(S, I)
        F = Cast<to = 1>(D)
        Y = Div(X, F)
    }`;
    let out = generate(source, [rule("X", ["Seq", "Feat"])]).unwrap();
    assert out.contains("let D = backend.upload(&Tensor::<i64, []> { data: [dim_N], extents: [] });");
    assert out.contains("let F = backend.cast::<i64, f32, []>(&D);");
}

test "a constant folds into the operator that reads it" {
    assert folded_add(0.5).unwrap().contains(
        "let Y = backend.fused::<[Batch, Unit]>([backend.read(&X)], &operand(0).binary(BinaryOp::Add, &constant(0.5 as f32)));",
    );
}

test "a constant no Wado literal spells is written as the prelude's constant" {
    assert folded_add(-f32::INFINITY).unwrap().contains("&constant(-f32::INFINITY)");
    assert folded_add(f32::NAN).unwrap().contains("&constant(f32::NAN)");
}

test "a constant with no operator to fold into is a rank-0 literal" {
    let out = emit_graph(&constant_graph(node("Relu", "Y", ["C"]), Rank::Scalar, 0.5)).unwrap();

    assert out.contains("let C = backend.upload(&Tensor::<f32, []> { data: [0.5 as f32], extents: [] });");
    assert out.contains("let Y = backend.fused::<[]>([backend.read(&C)], &operand(0).unary(UnaryOp::Relu));");
}

test "a one-element constant that raises the output's rank is a tensor, not a folded scalar" {
    let source = `g (float[3] X) => (float[1, 3] Y) <int64[2] S = {1, 1}> {
        C = ConstantOfShape(S)
        Y = Add(X, C)
    }`;
    let out = generate(source, [
        rule("X", ["A"]),
        rule("C", ["One", "A"]),
    ]).unwrap();

    assert out.contains("let C = backend.upload(&Tensor::<f32, [One, A]> { data: [0 as f32], extents: [1, 1] });");
    assert out.contains(
        "let Y = backend.fused::<[One, A]>([backend.read_suffix::<[One], [A]>(&X), backend.read(&C)], &operand(0).binary(BinaryOp::Add, &operand(1)));",
    );
}

test "a constant an operator folds is not bound as well" {
    assert !folded_add(0.5).unwrap().contains("let C");
}

test "a folded scalar output is returned as its literal" {
    let graph = constant_graph(node("Relu", "Y", ["X"]), matrix_rank(), 0.5);
    let out = emit_graph(&Graph {
        ..graph,
        outputs: [
            ValueInfo { name: "C", dtype: "float", rank: Rank::Scalar },
        ],
    }).unwrap();

    assert out.contains("let C = backend.upload(&Tensor::<f32, []> { data: [0.5 as f32], extents: [] });");
    assert out.contains("return backend.download(&C);");
}

test "a folded output of several elements is returned as its literal" {
    let source = `g (float[2, 3] X) => (int64[2] Y) {
        Y = Shape(X)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Row", "Col"]),
        rule("Y", ["Dim"]),
    ];
    let out = generate(source, layout).unwrap();

    assert out.contains("let Y = backend.upload(&Tensor::<i64, [Dim]> { data: [2, 3], extents: [2] });");
    assert out.contains("return backend.download(&Y);");
}

test "a folded tensor a Cast names again under its own type is spelled once" {
    let source = `g (float[1, 4] X) => (float[4, 8] Y) <float[16, 8] W, int64[4] Q = {0, 1, 2, 3}> {
        C = Cast<to = 7>(Q)
        E = Gather(W, Q)
        F = Gather(W, C)
        Y = Add(E, F)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Batch", "Seq"]),
        rule("Q", ["Seq"]),
        rule("C", ["Seq"]),
        rule("W", ["Vocab", "Hidden"]),
    ];
    let out = generate(source, layout).unwrap();
    assert out.contains("let Q = backend.upload(&Tensor::<i64, [Seq]> { data: [0, 1, 2, 3], extents: [4] });");
    assert !out.contains("let C");
    assert out.contains("let F = backend.gather_rows(&weights.W, &Q);");
}

test "a constant both branches read is spelled once, around them" {
    let source = `g (bool[1] C, float[2] X) => (float[2] Y) {
        K = Constant<value_floats = [1.0, 2.0]>()
        Y = If <then_branch = t () => (float[2] A) { A = Add(X, K) }, else_branch = e () => (float[2] B) { B = Sub(X, K) }> (C)
    }`;
    let layout: List<LayoutRule> = [
        rule("C", ["One"]),
        rule("X", ["Embed"]),
        rule("K", ["Embed"]),
    ];
    let body = generate(source, layout).unwrap();
    assert body.split("let K = ").count() == 2;
    assert body.find("let K = ").unwrap() < body.find("let Y = if backend.download(&C).data[0] {").unwrap();
}

test "a name only arithmetic spells is read back from its length, after the names that length reads" {
    let source = `g (float["2 * m + n"] V, float["n + 1"] X) => (float["2 * m + n"] Z) { Z = Add(V, V) }`;
    let layout: List<LayoutRule> = [
        rule("V", ["Odd"]),
        rule("X", ["Seq"]),
    ];
    let body = generate(source, layout).unwrap();
    let n = body.find("let dim_n = to_extent((X.extents[0] as i64 - (1))) as i64;").unwrap();
    let m = body.find("let dim_m = to_extent((V.extents[0] as i64 - (dim_n)) / 2) as i64;").unwrap();
    assert n < m;
}

test "a branch reads a constant around it under the axes the branch names" {
    let source = `g (bool[1] C, float[2] X, float[2] H) => (float[2] W) {
        K = Constant<value_floats = [1.0, 2.0]>()
        Y = If <then_branch = t () => (float[2] A) { A = Add(X, K) }, else_branch = e () => (float[2] B) { Z = Mul(H, K) B = Neg(X) }> (C)
        W = Add(Y, K)
    }`;
    let layout: List<LayoutRule> = [
        rule("C", ["One"]),
        rule("X", ["Embed"]),
        rule("H", ["Hidden"]),
        LayoutRule {
            pattern: "K",
            axes: ["Hidden"],
            graph: Option::Some("e"),
        },
        rule("K", ["Embed"]),
    ];
    let body = generate(source, layout).unwrap();
    assert body.contains(
        "let Z = backend.fused::<[Hidden]>([backend.read(&H), backend.read(&backend.lift::<f32, [Embed], [Hidden]>(&K, 1))], &operand(0).binary(BinaryOp::Mul, &operand(1)));",
    );
}

test "a constant one branch folds is spelled in that branch" {
    let source = `g (bool[1] C, float[2] X) => (float[2] Y) {
        Y = If <then_branch = t () => (float[2] A) { K = Constant<value_floats = [1.0, 2.0]>() A = Add(X, K) }, else_branch = e () => (float[2] B) { B = Neg(X) }> (C)
    }`;
    let layout: List<LayoutRule> = [
        rule("C", ["One"]),
        rule("X", ["Embed"]),
        rule("K", ["Embed"]),
    ];
    let body = generate(source, layout).unwrap();
    assert body.find("let K = ").unwrap() > body.find("let Y = if backend.download(&C).data[0] {").unwrap();
    assert body.find("let K = ").unwrap() < body.find("} else {").unwrap();
}
