use { EmitError, GRAPH_BANNER, emit } from "./emit.wado";
use { Attr, ConstTensor, Dim, Graph, Node, Rank, ValueInfo } from "./graph.wado";
use { infer } from "./infer.wado";
use { read } from "./onnx_text.wado";
use { LayoutRule, Schema } from "./schema.wado";

fn rule(pattern: String, axes: List<String>) -> LayoutRule {
    return LayoutRule { pattern, axes };
}

fn generate(source: String, layout: List<LayoutRule>) -> Result<String, EmitError> {
    let graph = read(&source).unwrap();
    let shapes = infer(&graph, &Schema { layout }).unwrap();
    return emit(&graph, &shapes);
}

/// The part of the module generated from the graph, with the inlined runtime
/// cut away. Asserting that a kernel is *absent* has to say where, since the
/// runtime names every kernel.
fn emitted(out: &String) -> String {
    let start = out.find(&GRAPH_BANNER).unwrap() + GRAPH_BANNER.len();
    return out.as_str_slice().slice(start, out.len()).to_string();
}

/// The same two-layer graph at any boundary element type, which is the one
/// thing that changes between the f32 tests and the half precision ones.
fn mlp(dtype: String) -> String {
    return `
mlp (${dtype}[N, 4] X) => (${dtype}[N, 2] Y)
<${dtype}[4, 3] W1, ${dtype}[3] B1, ${dtype}[3, 2] W2, ${dtype}[2] B2>
{
    H = MatMul(X, W1)
    HB = Add(H, B1)
    A = Relu(HB)
    T = MatMul(A, W2)
    Y = Add(T, B2)
}
`;
}

global MLP: String = mlp("float");

fn mlp_layout() -> List<LayoutRule> {
    return [
        rule("X", ["Batch", "In"]),
        rule("W1", ["In", "Hidden"]),
        rule("B1", ["Hidden"]),
        rule("W2", ["Hidden", "Out"]),
        rule("B2", ["Out"]),
    ];
}

test "a banner separates the inlined runtime from the graph's own code" {
    let out = generate(MLP, mlp_layout()).unwrap();

    // The runtime is above the banner and this graph's code below it, which is
    // what lets a test say where a kernel call would have to appear.
    let body = emitted(&out);
    assert !body.contains("pub fn matmul");
    assert !body.contains("pub fn map");
    assert body.contains("pub struct Weights {");
    assert body.contains("pub fn forward(");
    assert out.contains("pub fn matmul");
}

test "the forward pass is one kernel call per operator" {
    let out = generate(MLP, mlp_layout()).unwrap();

    assert out.contains(
        "pub fn forward(X: &Tensor<f32, [Batch, In]>, weights: &Weights) -> Tensor<f32, [Batch, Out]> {",
    );
    assert out.contains("let H = matmul(X, &weights.W1);");
    assert out.contains("let HB = zip_suffix::<[Batch], [Hidden]>(&H, &weights.B1, |x, y| x + y);");
    assert out.contains("let A = map(&HB, |v| f32::max(v, 0.0));");
    assert out.contains("let T = matmul(&A, &weights.W2);");
    assert out.contains("return Y;");
}

test "the initializers become the weights struct" {
    let out = generate(MLP, mlp_layout()).unwrap();

    assert out.contains("pub struct Weights {");
    assert out.contains("pub W1: Tensor<f32, [In, Hidden]>,");
    assert out.contains("pub B2: Tensor<f32, [Out]>,");
}

test "weights the graph carries become Weights::embedded" {
    let source = `
bias (float[N, 2] X) => (float[N, 2] Y)
<float[2] B = {1.0, -2.5}>
{
    Y = Add(X, B)
}
`;
    let out = generate(source, [
        rule("X", ["Batch", "In"]),
        rule("B", ["In"]),
    ]).unwrap();

    assert out.contains("impl Weights {\n    /// The weights the graph carries.\n    pub fn embedded() -> Weights {");
    assert out.contains("B: Tensor::<f32, [In]> {");
    // 1.0 is 0x3f800000 and -2.5 is 0xc0200000, little-endian.
    assert out.contains("data: List::<f32>::from_le_bytes(b\"\\x00\\x00\\x80?\\x00\\x00 \\xc0\"),");
    assert out.contains("extents: [2],");
}

test "a graph missing any initializer's data leaves the weights to the caller" {
    let out = generate(MLP, mlp_layout()).unwrap();

    assert !out.contains("fn embedded");
}

test "every axis the graph mentions becomes a marker type" {
    let out = generate(MLP, mlp_layout()).unwrap();

    assert out.contains("pub struct Batch {}");
    assert out.contains("pub struct Hidden {}");
}

test "the kernels are inlined into the generated module" {
    let out = generate(MLP, mlp_layout()).unwrap();

    assert out.contains("pub fn matmul<..Bs, M, K, N>(");
    assert out.contains("pub fn zip_suffix<..Pre, ..Suf>(");
}

test "a name a Wado identifier cannot carry is sanitized" {
    let source = `
g (float[N, 2] "/model/input.0") => (float[N, 2] out)
<>
{
    out = Relu("/model/input.0")
}
`;
    let out = generate(source, [rule("*", ["Batch", "Unit"])]).unwrap();

    assert out.contains("pub fn forward(_model_input_0: &Tensor<f32, [Batch, Unit]>");
    assert out.contains("let out = map(_model_input_0, |v| f32::max(v, 0.0));");
}

test "a graph that returns its own input copies it out" {
    let source = `
g (float[N, 2] X) => (float[N, 2] X)
<>
{
}
`;
    let out = generate(source, [rule("X", ["Batch", "Unit"])]).unwrap();

    assert out.contains("return *X;");
}

test "two names that sanitize to one identifier stop the build" {
    let source = `
g (float[N, 2] "a.b", float[N, 2] "a/b") => (float[N, 2] out)
<>
{
    out = Add("a.b", "a/b")
}
`;
    let e = generate(source, [rule("*", ["Batch", "Unit"])]).unwrap_err();

    assert `${e}` == "a/b and a.b both name `a_b`";
}

test "Erf maps each element through the error function" {
    let source = `
g (float[N, 2] X) => (float[N, 2] Y)
<>
{
    Y = Erf(X)
}
`;
    let out = generate(source, [rule("*", ["Batch", "Unit"])]).unwrap();

    assert out.contains("map(X, |v| f32::erf(v))");
}

test "a broadcast no kernel covers names both operands" {
    let source = `
g (float[N, 1] X, float[N, 4] Z) => (float[N, 4] Y)
<>
{
    Y = Add(X, Z)
}
`;
    let layout: List<LayoutRule> = [
        rule("X", ["Batch", "One"]),
        rule("Z", ["Batch", "Wide"]),
        rule("Y", ["Batch", "Wide"]),
    ];
    let e = generate(source, layout).unwrap_err();

    assert `${e}` == "Y = Add: no kernel broadcasts [Batch, One] against [Batch, Wide]";
}

test "Gemm lowers to a matmul under its transpose flags" {
    let source = `
g (float[2, 3] A, float[4, 3] B, float[4] C) => (float[2, 4] Y)
<>
{
    Y = Gemm <transB = 1, alpha = 0.5, beta = 2.0> (A, B, C)
}
`;
    let layout: List<LayoutRule> = [
        rule("A", ["Batch", "In"]),
        rule("B", ["Out", "In"]),
        rule("C", ["Out"]),
        rule("Y", ["Batch", "Out"]),
    ];
    let out = generate(source, layout).unwrap();

    assert out.contains("transpose2(");
    assert out.contains("(0.5 as f32)");
    assert out.contains("(2 as f32)");
    assert out.contains("zip_suffix::<[Batch], [Out]>");
}

test "Gemm whose scalars are both one writes no map" {
    let source = `
g (float[2, 3] A, float[3, 4] B) => (float[2, 4] Y)
<>
{
    Y = Gemm(A, B)
}
`;
    let layout: List<LayoutRule> = [
        rule("A", ["Batch", "In"]),
        rule("B", ["In", "Out"]),
        rule("Y", ["Batch", "Out"]),
    ];
    let out = generate(source, layout).unwrap();

    assert out.contains("matmul(");
    assert !emitted(&out).contains("map(");
    assert !emitted(&out).contains("transpose2(");
}

test "a rank-2 Transpose lowers to the kernel" {
    let source = `
g (float[2, 3] X) => (float[3, 2] Y)
<>
{
    Y = Transpose <perm = [1, 0]> (X)
}
`;
    let out = generate(source, [rule("*", ["A", "B"])]).unwrap();

    assert out.contains("transpose2(");
}

test "a Transpose that moves no axis is its operand" {
    let source = `
g (float[2, 3] X) => (float[2, 3] Y)
<>
{
    Y = Transpose <perm = [0, 1]> (X)
}
`;
    let out = generate(source, [rule("*", ["A", "B"])]).unwrap();

    assert !emitted(&out).contains("transpose2(");
    // Every node result is bound as a value, so the operand is read as one.
    assert out.contains("let Y = *X;");
}

test "a Transpose no kernel covers names itself" {
    let source = `
g (float[2, 3, 4] X) => (float[4, 3, 2] Y)
<>
{
    Y = Transpose <perm = [2, 1, 0]> (X)
}
`;
    let e = generate(source, [rule("*", ["A", "B", "C"])]).unwrap_err();

    assert `${e}` == "Y = Transpose: no kernel for this operator";
}

test "a tensor named as the generated module names something is renamed" {
    let source = `
g (float[N, 2] weights, float[N, 2] map) => (float[N, 2] Tensor)
<>
{
    Tensor = Add(weights, map)
}
`;
    let out = generate(source, [rule("*", ["Batch", "Unit"])]).unwrap();

    assert out.contains("pub fn forward(weights_: &Tensor<f32, [Batch, Unit]>, map_: ");
    assert out.contains("let Tensor_ = zip(weights_, map_,");
    assert out.contains("return Tensor_;");
}

test "a tensor named as an axis is renamed too" {
    let source = `
g (float[N, 2] Batch) => (float[N, 2] Y)
<>
{
    Y = Relu(Batch)
}
`;
    let out = generate(source, [rule("*", ["Batch", "Unit"])]).unwrap();

    assert out.contains("pub struct Batch {}");
    assert out.contains("let Y = map(Batch_,");
}

test "an axis named as the generated module names something stops the build" {
    let source = `
g (float[N, 2] X) => (float[N, 2] Y)
<>
{
    Y = Relu(X)
}
`;
    let e = generate(source, [rule("*", ["Batch", "Tensor"])]).unwrap_err();

    assert `${e}` == "Tensor: an axis cannot be named as the generated module names something";

    // Every declaration keyword reserves what it names, not `fn` and `struct`
    // alone: `Held` is the runtime's trait.
    let t = generate(source, [rule("*", ["Batch", "Held"])]).unwrap_err();

    assert `${t}` == "Held: an axis cannot be named as the generated module names something";
}

test "a broadcast that stretches an extent of one names both operands" {
    let source = `
g (float[2, 1] X, float[2, 4] Z) => (float[2, 4] Y)
<>
{
    Y = Add(X, Z)
}
`;
    // One layout rule names both operands' axes, so stage 0 discharges the
    // stretch and only the extents differ.
    let e = generate(source, [rule("*", ["Batch", "Unit"])]).unwrap_err();

    assert `${e}` == "Y = Add: no kernel broadcasts [Batch, Unit] against [Batch, Unit]";
}

test "a MatMul batch axis that stretches names both operands" {
    let source = `
g (float[1, 2, 3] X, float[4, 3, 5] Z) => (float[4, 2, 5] Y)
<>
{
    Y = MatMul(X, Z)
}
`;
    let e = generate(source, [rule("*", ["Batch", "M", "K"])]).unwrap_err();

    assert `${e}` == "Y = MatMul: no kernel broadcasts [Batch, M, K] against [Batch, M, K]";
}

fn refused_dtype(dtype: String) -> String {
    let source = `
g (${dtype}[N, 2] X) => (${dtype}[N, 2] Y)
<>
{
    Y = Relu(X)
}
`;
    return `${generate(source, [rule("*", ["Batch", "Unit"])]).unwrap_err()}`;
}

test "an element type the kernels cannot compute in names itself" {
    assert refused_dtype("int32") == "X: the kernels compute in f32 and this tensor is int32";
    assert refused_dtype("uint8") == "X: the kernels compute in f32 and this tensor is uint8";
}

test "a half precision boundary states its own element type" {
    let out = generate(mlp("float16"), mlp_layout()).unwrap();

    assert out.contains(
        "pub fn forward(X: &Tensor<f16, [Batch, In]>, weights: &Weights) -> Tensor<f16, [Batch, Out]> {",
    );
    assert out.contains("pub W1: Tensor<f16, [In, Hidden]>,");
}

// The kernels compute in f32 and half precision has no arithmetic, so every
// half operand is widened on the way in and the result narrowed on the way out.
test "a half precision boundary is widened into the f32 the kernels compute in" {
    let out = generate(mlp("float16"), mlp_layout()).unwrap();

    assert out.contains("let X = widen(X);");
    assert out.contains("let W1 = widen(&weights.W1);");
    assert out.contains("let H = matmul(&X, &W1);");
    assert out.contains("return narrow(&Y);");
}

test "bfloat16 is the same boundary with the other primitive" {
    let out = generate(mlp("bfloat16"), mlp_layout()).unwrap();

    assert out.contains("pub fn forward(X: &Tensor<bf16, [Batch, In]>");
    assert out.contains("let X = widen(X);");
    assert out.contains("return narrow(&Y);");
}

// The textual format carries no tensor attribute, so a `Constant` graph is
// built here rather than read.
fn constant_graph(consumer: Node, produced: Rank, value: f32) -> Graph {
    let float2 = ValueInfo {
        name: "X",
        dtype: "float",
        rank: Rank::Dims([
            Dim::Symbol("N"),
            Dim::Static(2),
        ]),
    };
    return Graph {
        name: "g",
        inputs: [float2],
        outputs: [
            ValueInfo { name: consumer.outputs[0], dtype: "float", rank: produced },
        ],
        initializers: [],
        nodes: [
            Node {
                op: "Constant",
                outputs: ["C"],
                inputs: [],
                attrs: [
                    Attr {
                        name: "value",
                        values: [],
                        is_list: false,
                        tensor: Option::Some(ConstTensor {
                            data: [value],
                        }),
                    },
                ],
            },
            consumer,
        ],
    };
}

fn node(op: String, output: String, inputs: List<String>) -> Node {
    return Node {
        op,
        outputs: [output],
        inputs,
        attrs: [],
    };
}

fn emit_graph(graph: &Graph) -> Result<String, EmitError> {
    let shapes = infer(graph, &Schema {
        layout: [rule("*", ["Batch", "Unit"])],
    }).unwrap();
    return emit(graph, &shapes);
}

fn matrix_rank() -> Rank {
    return Rank::Dims([
        Dim::Symbol("N"),
        Dim::Static(2),
    ]);
}

fn folded_add(value: f32) -> Result<String, EmitError> {
    return emit_graph(&constant_graph(node("Add", "Y", ["X", "C"]), matrix_rank(), value));
}

test "a constant folds into the operator that reads it" {
    assert folded_add(0.5).unwrap().contains("let Y = map(X, |v| v + (0.5 as f32));");
}

test "a constant no Wado literal spells is written as the prelude's constant" {
    assert folded_add(-f32::INFINITY).unwrap().contains("let Y = map(X, |v| v + -f32::INFINITY);");
    assert folded_add(f32::NAN).unwrap().contains("v + f32::NAN");
}

test "a constant no operator can fold names the operator that reads it" {
    let graph = constant_graph(node("Relu", "Y", ["C"]), Rank::Scalar, 0.5);
    let e = emit_graph(&graph).unwrap_err();

    assert `${e}` == "Y = Relu: no kernel folds the constant C";
}

test "a constant is not a value a graph can return" {
    let graph = constant_graph(node("Relu", "Y", ["X"]), matrix_rank(), 0.5);
    let e = emit_graph(&Graph {
        ..graph,
        outputs: [
            ValueInfo { name: "C", dtype: "float", rank: Rank::Scalar },
        ],
    }).unwrap_err();

    assert `${e}` == "C: a graph cannot return a constant";
}
