use { Decode, EmitError, NameCollision, Placement, UnmappedDtype, emit, rows_judged } from "./emit.wado";
use { infer } from "./infer.wado";
use { read } from "./onnx_text.wado";
use { keep_last } from "./specialize.wado";

/// The package spec the generated module imports the runtime from.
global RUNTIME: String = "lib:loam";

/// The checkpoint `generate` reads the weights a graph lacks from.
global CHECKPOINT: Placement = Placement::File("model.safetensors");

fn generate(source: String) -> Result<String, EmitError> {
    let graph = read(&source).unwrap();
    return emit(&graph, &infer(&graph).unwrap(), &RUNTIME, CHECKPOINT);
}

test "a length the run would compute past i64 for some input stops the build" {
    let source = `g (float[N, M, 3] X) => (float[?] Y) <int64[1] Flat = {-1}> {
        Y = Reshape(X, Flat)
    }`;
    let e = generate(source).unwrap_err();
    assert `${e}` == "3 * M * N: the run computes this in i64, and some input carries it past";
}

test "two names that sanitize to one identifier stop the build" {
    let source = `
g (float[N, 2] "a.b", float[N, 2] "a/b") => (float[N, 2] out)
<>
{
    out = Add("a.b", "a/b")
}
`;
    let e = generate(source).unwrap_err();

    assert `${e}` == "a/b and a.b both name `a_b`";
}

test "a tensor named as the module or an axis is renamed past every other tensor's name" {
    let source = `
g (float[N, 2] build, float[N, 2] build_, float[N, 2] N) => (float[N, 2] out)
<>
{
    t = Add(build, build_)
    out = Add(t, N)
}
`;
    let out = generate(source).unwrap();
    assert out.contains("build__");
    assert out.contains("N_");
}

fn is_error<E: Error>() {
}

test "every error emit reports is an Error" {
    is_error::<EmitError>();
    is_error::<UnmappedDtype>();
    is_error::<NameCollision>();
}

fn refused_dtype(dtype: String) -> String {
    let source = `
g (${dtype}[N, 2] X) => (${dtype}[N, 2] Y)
<>
{
    Y = Relu(X)
}
`;
    return `${generate(source).unwrap_err()}`;
}

test "an element type the kernels cannot compute in names itself" {
    assert refused_dtype("int16") == "X: no kernel holds int16";
    assert refused_dtype("double") == "X: no kernel holds double";
}

/// Why each row of `source`'s batch shares the lengths, by the node refusing
/// its own, where one does.
fn shared_rows(source: String) -> String {
    let graph = read(&source).unwrap();
    let Err(Shared(refusal)) = rows_judged(&graph, &infer(&graph).unwrap()) else {
        return "";
    };
    return `${refusal}`;
}

test "the rows share their lengths where a node takes one length for every row" {
    let source = `g (float[B, N] X) => (float[B] Y) {
        Y = ReduceMean <axes = [-1], keepdims = 0> (X)
    }`;
    assert shared_rows(source) == "refused at Y = ReduceMean: it averages over a valid length, which takes one for every row";
}

test "the rows share their lengths where a node reads how many rows the batch holds" {
    let source = `g (float[B, N] X) => (float[B, N] Y) {
        Y = Softmax <axis = 0> (X)
    }`;
    assert shared_rows(source) == "refused at Y = Softmax: it reads how many rows B holds, which no row holds apart";
}

test "the rows share their lengths where the inputs padding one lead with two axes" {
    let source = `g (float[B, N] X, float[C, N] Z) => (float[B, N] Y, float[C, N] W) {
        Y = Softmax <axis = 1> (X)
        W = Softmax <axis = 1> (Z)
    }`;
    assert shared_rows(source) == "the inputs padding a length lead with two axes, B and C";
}

test "the rows share their lengths where a tensor each row's lengths computed meets an operation keeping no rows" {
    let source = `g (int64[B, S] I, float[B, 1, P, 8] PK) => (float[S] Y) {
        Ds = Shape(I)
        Dp = Shape(PK)
        One = Constant<value = int64 {1}>()
        Two = Constant<value = int64 {2}>()
        Past = Gather<axis = 0>(Dp, Two)
        Len = Gather<axis = 0>(Ds, One)
        Total = Add(Past, Len)
        Pos = Range(Past, Total, One)
        F = Cast<to = 1>(Pos)
        Y = Softmax <axis = 0> (F)
    }`;
    assert shared_rows(source) == "refused at Y = Softmax: it reads F, which each row's lengths computed";
}

test "the rows share their lengths where a node gathers along one" {
    let source = `g (float[B, N] X, int64[2] I) => (float[B, 2] Y) {
        Y = Gather<axis = 1>(X, I)
    }`;
    assert shared_rows(source) == "refused at Y = Gather: it gathers along a valid length, which takes one for every row";
}

test "the rows share their lengths where a node reads a valid length over no axis of the rows" {
    let source = `g (float[B, N] X, float[N] Z) => (float[B, N] W, float[N] Y) {
        W = Softmax<axis = 1>(X)
        Y = Softmax<axis = 0>(Z)
    }`;
    assert shared_rows(source) == "refused at Y = Softmax: it reads a valid length over no axis of the rows, B";
}

test "the rows share their lengths where a node reads a tensor folded from one" {
    let source = `g (float[B, N] X) => (float[2] Y) {
        S = Shape(X)
        Y = Cast<to = 1>(S)
    }`;
    assert shared_rows(source) == "refused at Y = Cast: it reads S, folded from a valid length, which takes one for every row";
}

test "the rows share their lengths where the pass returns what each row's lengths computed" {
    let source = `g (int64[B, S] I, float[B, 1, P, 8] PK) => (int64[S] Pos) {
        Ds = Shape(I)
        Dp = Shape(PK)
        One = Constant<value = int64 {1}>()
        Two = Constant<value = int64 {2}>()
        Past = Gather<axis = 0>(Dp, Two)
        Len = Gather<axis = 0>(Ds, One)
        Total = Add(Past, Len)
        Pos = Range(Past, Total, One)
    }`;
    assert shared_rows(source) == "the pass returns Pos, which each row's lengths computed";
}

global DECODER: String = #include_str("../conformance/decoder.onnxtext").replace("[B, ", "[1, ");

/// Why `source` takes no `decode` of these tensors, the output named in `last`
/// where one is, or the module where it does.
fn decoded(
    ids: String,
    mask: String,
    logits: String,
    last: Option<String> = null,
    source: String = DECODER,
) -> Result<String, EmitError> {
    let mut graph = read(&source).unwrap();
    if let Some(output) = last {
        keep_last(&mut graph, &infer(&graph).unwrap(), &output, 1).unwrap();
    }
    return emit(&graph, &infer(&graph).unwrap(), &RUNTIME, CHECKPOINT, Option::Some(Decode { ids, mask, logits }));
}

/// `decoded` of `source`, an edit of `DECODER`, by its usual tensors.
fn decoded_from(source: String) -> Result<String, EmitError> {
    return decoded("input_ids", "attention_mask", "logits", Option::Some("logits"), source);
}

fn refused_for(result: Result<String, EmitError>, reason: String) -> bool {
    return result matches { Err(Undecodable(why)) && why.contains(reason.as_str_slice()) };
}

test "decode refuses tensors a loop cannot feed" {
    let logits = Option::Some("logits") as Option<String>;
    assert refused_for(decoded("ids", "attention_mask", "logits", logits), "input_ids is an input no step");
    assert refused_for(decoded("input_ids", "mask", "logits", logits), "attention_mask is an input no step");
    assert refused_for(decoded("input_ids", "attention_mask", "out", logits), "out is no float output");
    assert refused_for(decoded("input_ids", "attention_mask", "present_key", logits), "present_key is no float output");
    assert refused_for(decoded("past_key", "attention_mask", "logits", logits), "input_ids is an input no step");
}

test "decode refuses logits of more than one position" {
    assert refused_for(decoded("input_ids", "attention_mask", "logits"), "must hold one position");
}

test "decode refuses one input as both its token and its mask" {
    assert refused_for(
        decoded("attention_mask", "attention_mask", "logits", Option::Some("logits")),
        "both the token and the mask",
    );
}

test "decode refuses ids of more than one position" {
    let two = DECODER
        .replace("int64[1, S] input_ids", "int64[1, 2] input_ids")
        .replace("float[1, S, 8] logits", "float[1, 2, 8] logits");
    assert refused_for(decoded_from(two), "must take one token");
}

test "decode refuses logits of rows other than the token's" {
    let wide = DECODER
        .replace("float[1, S, 8] logits", "float[2, S, 8] logits")
        .replace(
            "logits = Add(raw, tilt)",
            "rows = Constant <value = float[2, 1, 1] { 0.0, 0.0 }> ()\n    logits = Add(raw, rows)",
        );
    assert refused_for(decoded_from(wide), "as many rows");
}

test "decode refuses a past whose extent a pass changes uncounted" {
    assert refused_for(
        decoded_from(DECODER.replace("float[1, 1, P, 16] past", "float[1, 1, 2, 16] past")),
        "keep its extents through a step",
    );
}

test "decode refuses a graph with no cache" {
    let graph = read(
        &"<ir_version: 8, opset_import: [ \"\" : 17 ]>\nplain (int64[1, N] ids) => (float[1, N] Y)\n{\n    Y = Cast<to = 1>(ids)\n}\n",
    ).unwrap();
    let decode = Decode { ids: "ids", mask: "ids", logits: "Y" };
    assert refused_for(
        emit(&graph, &infer(&graph).unwrap(), &RUNTIME, CHECKPOINT, Option::Some(decode)),
        "no cache",
    );
}
