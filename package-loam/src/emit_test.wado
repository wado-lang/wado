use { HashMap, TreeMap } from "core:collections";
use { EmitError, NameCollision, Placement, UnmappedDtype, emit, expr_source } from "./emit.wado";
use { Attr, Dim, Elements, Graph, InPlace, Known, Node, Rank, ValueInfo } from "./graph.wado";
use { infer } from "./infer.wado";
use { read } from "./onnx_text.wado";
use { BinaryOp, Expr, RowOp, UnaryOp, constant, operand } from "./runtime/tensor.wado";

/// The source the generated module spells `e` with.
fn src(e: Expr) -> String {
    return expr_source(&e);
}

/// `src` of the commonest kernel: its first operand plus its second.
fn sum() -> String {
    return src(operand(0).binary(BinaryOp::Add, &operand(1)));
}

fn unary(op: UnaryOp) -> String {
    return src(operand(0).unary(op));
}

fn select() -> String {
    return src(operand(0).select(&operand(1), &operand(2)));
}

test "an expression is spelled as its steps, a shared step once" {
    let x = operand(0).binary(BinaryOp::Sub, &constant(2.0));
    assert src(x.binary(BinaryOp::Mul, &x).row(RowOp::Max)) == "Expr { steps: [Step::Operand(0), Step::Constant(2 as f32), Step::Binary([BinaryOp::Sub, 0, 1]), Step::Binary([BinaryOp::Mul, 2, 2]), Step::Fold([RowOp::Max, 3])] }";
}

/// The package spec the generated module imports the runtime from.
global RUNTIME: String = "lib:loam";

fn generate(source: String, fuse: bool = true) -> Result<String, EmitError> {
    let graph = read(&source).unwrap();
    return emit(&graph, &infer(&graph).unwrap(), &RUNTIME, fuse);
}

/// The kernels' entries, `pass` and `forward`, out of the module `out`.
fn kernel_entries(out: &String) -> String {
    return out.substr_bytes(out.find("pub fn pass").unwrap(), out.find("pub fn build").unwrap());
}

/// The same two-layer graph at any boundary element type, which is the one
/// thing that changes between the f32 tests and the half precision ones. Its
/// axes are `N`, the batch; `X1`, the input; `W11`, the hidden layer; and
/// `Y1`, the output.
fn mlp(dtype: String) -> String {
    return `
mlp (${dtype}[N, 4] X) => (${dtype}[N, 2] Y)
<${dtype}[4, 3] W1, ${dtype}[3] B1, ${dtype}[3, 2] W2, ${dtype}[2] B2>
{
    H = MatMul(X, W1)
    HB = Add(H, B1)
    A = Relu(HB)
    T = MatMul(A, W2)
    Y = Add(T, B2)
}
`;
}

global MLP: String = mlp("float");

test "the generated module imports the runtime from the spec it is given" {
    let out = generate(MLP).unwrap();

    assert out.contains("    Tensor,\n");
    assert out.contains("} from \"lib:loam\";\n");
    assert !out.contains("pub fn matmul");
    assert out.contains("pub struct Weights {");
    assert out.contains("pub struct Prepared<affine Bk: Backend> {");
    assert out.contains("pub fn forward<");
}

test "unfused, the forward pass is one kernel call per operator, each on the backend" {
    let out = generate(MLP, false).unwrap();

    assert out.contains(
        "pub fn forward<affine Bk: Backend>(backend: &mut Bk, X: &Tensor<f32, [N, X1]>, weights: &Prepared<Bk>) -> Tensor<f32, [N, Y1]> with _ {",
    );
    assert out.contains("let H = backend.matmul_rhs(X, &weights.W1, null);");
    assert out.contains(
        `let HB = backend.fused::<[N, W11]>([backend.read(&H), backend.read_suffix::<[N], [W11]>(&weights.B1)], &${sum()});`,
    );
    assert out.contains(`let A = backend.fused::<[N, W11]>([backend.read(&HB)], &${unary(UnaryOp::Relu)});`);
    assert out.contains("let T = backend.matmul_rhs(&A, &weights.W2, null);");
    // `pass` takes the input and leaves the output on the backend, and
    // `forward` uploads the one and reads the other back.
    assert out.contains(
        "pub fn pass<affine Bk: Backend>(backend: &mut Bk, X: &Bk::Tensor<f32, [N, X1]>, weights: &Prepared<Bk>) -> Bk::Tensor<f32, [N, Y1]> with _ {",
    );
    assert out.contains("    return Y;\n");
    assert out.contains("    return backend.download(&pass(backend, &X, weights));\n");
}

test "a product takes the elementwise operators after it as its epilogue" {
    let out = generate(MLP).unwrap();

    assert out.contains(
        `let A = backend.matmul_rhs(X, &weights.W1, Option::Some(Epilogue { operands: [backend.read_suffix::<[N], [W11]>(&weights.B1)], op: ${src(
            operand(0).binary(BinaryOp::Add, &operand(1)).unary(UnaryOp::Relu),
        )} }));`,
    );
    assert out.contains(
        `let Y = backend.matmul_rhs(&A, &weights.W2, Option::Some(Epilogue { operands: [backend.read_suffix::<[N], [Y1]>(&weights.B2)], op: ${sum()} }));`,
    );
    let kernels = kernel_entries(&out);
    assert !kernels.contains("let H ");
    assert !kernels.contains("let HB ");
}

test "an elementwise chain fuses into one kernel, an operand read twice read once" {
    let source = `
g (float[N, 4] X, float[N, 4] Z) => (float[N, 4] Y)
{
    A = Mul(X, X)
    B = Add(A, Z)
    Y = Relu(B)
}
`;
    let out = generate(source).unwrap();

    assert out.contains(
        `let Y = backend.fused::<[N, X1]>([backend.read(X), backend.read(Z)], &${src(
            operand(0).binary(BinaryOp::Mul, &operand(0)).binary(BinaryOp::Add, &operand(1)).unary(UnaryOp::Relu),
        )});`,
    );
}

test "each input is uploaded after the checks that read the host's and the pass begins, and no weight is" {
    let body = generate(MLP).unwrap();

    let upload = body.find("let X = backend.upload(X);").unwrap();
    let begun = body.find("backend.begin();").unwrap();
    assert body.find("refuse(input_mismatch(X,").unwrap() < begun < upload;
    let forward = body.find("pub fn forward").unwrap();
    assert !body.substr_bytes(forward, body.len()).contains("upload(&weights");
}

test "the weights become the backend's for every pass where they are prepared" {
    let out = generate(MLP).unwrap();

    // `W1` is read only as a product's right operand, so it is prepared as one.
    assert out.contains("    pub W1: Bk::Rhs<X1, W11>,\n");
    assert out.contains(
        "    pub fn prepare<affine Bk: Backend>(&self, backend: &mut Bk) -> Prepared<Bk> with _ {\n        return Prepared {\n            W1: backend.keep_rhs(&self.W1),\n",
    );
    assert out.contains("backend.matmul_rhs(X, &weights.W1");
}

test "the pass checks each input against the graph before any kernel, and forward its data first" {
    let out = generate(MLP).unwrap();

    let held = out.find("refuse(extents_mismatch(&backend.extents_of(X), \"X\", [\"N\", \"X1\"], [-1, 4]));").unwrap();
    assert held < out.find("matmul_rhs(").unwrap();
    let forward = out.find("pub fn forward").unwrap();
    let host = out.find("refuse(input_mismatch(X, \"X\", [\"N\", \"X1\"], [-1, 4]));").unwrap();
    assert forward < host < out.find("backend.upload(X)").unwrap();
}

test "an axis the boundary and the weights fix to one length carries it as a constant" {
    let out = generate(MLP).unwrap();

    assert out.contains("impl X1 {\n    pub const EXTENT: i32 = 4;\n}");
    assert out.contains("impl Y1 {\n    pub const EXTENT: i32 = 2;\n}");
    // Only the weights reach the hidden layer.
    assert out.contains("impl W11 {\n    pub const EXTENT: i32 = 3;\n}");
    assert !out.contains("impl N {");
}

test "an axis the boundary gives two lengths carries no constant" {
    let source = `
g (float[2, 8] X) => (float[2, 1] Y)
{
    Y = ReduceMean <axes = [-1]> (X)
}
`;
    let out = generate(source).unwrap();

    assert !out.contains("impl X1 {");
    assert out.contains("impl X0 {\n    pub const EXTENT: i32 = 2;\n}");
}

test "inputs sharing an axis the graph leaves to the run are checked against each other" {
    let source = `
pair (float[N, 2] A, float[N, 2] B) => (float[N, 2] Y)
{
    Y = Add(A, B)
}
`;
    let out = generate(source).unwrap();

    assert out.contains(
        "refuse(axis_mismatch(\"N\", \"B\", \"N\", backend.extents_of(B)[0], \"A\", backend.extents_of(A)[0]));",
    );
    assert !out.contains("axis_mismatch(\"2\"");
}

test "inputs one dim_param declares are checked against each other wherever it sits" {
    let source = `
outer (float[S, 4] A, float[4, S] B) => (float[S, S] Y)
{
    Y = MatMul(A, B)
}
`;
    let out = generate(source).unwrap();
    assert out.contains(
        "refuse(axis_mismatch(\"S\", \"B\", \"S\", backend.extents_of(B)[1], \"A\", backend.extents_of(A)[0]));",
    );
}

test "an input axis whose length the graph spells over a symbol is checked once the symbol is bound" {
    let source = `
cache (float[1, T, 8] P, float[1, 1, 8] N, int64[1, "T + 1"] M) => (float[1, U, 8] Y)
{
    Y = Concat<axis = 1>(P, N)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("refuse(extents_mismatch(&backend.extents_of(M), \"M\", [\"M0\", \"M1\"], [1, -1]));");
    let bound = out.find("let dim_T = backend.extents_of(P)[1] as i64;").unwrap();
    let check = out.find("refuse(extent_mismatch(\"M\", \"M1\", backend.extents_of(M)[1], \"T + 1\", dim_T + 1));").unwrap();
    assert bound < check && check < out.find("concat::<").unwrap();
}

test "a graph of several outputs returns each, in the order it declares them" {
    let source = `
pair (float[N, 2] A) => (float[N, 2] Z, float[N, 2] Y)
{
    Y = Relu(A)
    Z = Neg(A)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("pub struct Outputs {\n    pub Z: Tensor<f32, [N, A1]>,\n    pub Y: Tensor<f32, [N, A1]>,\n}");
    assert out.contains(
        "pub fn forward<affine Bk: Backend>(backend: &mut Bk, A: &Tensor<f32, [N, A1]>, weights: &Prepared<Bk>) -> Outputs with _ {",
    );
    assert out.contains(
        "pub struct Passed<affine Bk: Holds> {\n    pub Z: Bk::Tensor<f32, [N, A1]>,\n    pub Y: Bk::Tensor<f32, [N, A1]>,\n}",
    );
    assert out.contains("return Passed { Z: Z, Y: Y };");
    assert out.contains("let Passed { Z, Y } = pass(backend, &A, weights);");
    assert out.contains("return Outputs { Z: backend.download(&Z), Y: backend.download(&Y) };");
}

/// A decoder whose keys grow by the positions each pass computes, beside a
/// state of fixed extents, each handed from one pass to the next.
fn decoder(past_key: String, present_key: String, batch: String = "1") -> String {
    return `
decoder (float[${batch}, N, 2] X, float[${batch}, P, 2] ${past_key}, float[3] past_state) => (float[${batch}, N, 2] Y, float[${batch}, ?, 2] ${present_key}, float[3] present_state)
{
    Y = Relu(X)
    ${present_key} = Concat<axis = 1>(${past_key}, X)
    present_state = Neg(past_state)
}
`;
}

test "the pasts and the presents they pair with are one Cache, which the pass takes and returns" {
    let out = generate(decoder("past_key", "present_key")).unwrap();

    assert out.contains("pub struct Cache<affine Bk: Holds> {\n    pub past_key: Bk::Tensor<f32, [");
    assert out.contains("    pub past_state: Bk::Tensor<f32, [");
    let pass = out.substr_bytes(out.find("pub fn pass").unwrap(), out.find("pub fn forward").unwrap());
    assert pass.contains("cache: &Cache<Bk>, weights: &Prepared<Bk>) -> Passed<Bk> with _ {");
    assert !pass.contains("past_key: &Bk::Tensor");
    assert pass.contains("let past_key = &cache.past_key;");
    assert pass.contains("cache: Cache { past_key: backend.reshape::<f32, [");
    assert out.contains("pub struct Passed<affine Bk: Holds> {\n    pub Y: Bk::Tensor<f32, [");
    assert out.contains("    pub cache: Cache<Bk>,\n}");
    assert !out.contains("pub present_key");
    assert out.contains("    pub Y: Tensor<f32, [");
    assert out.contains("return Outputs { Y: backend.download(&Y), cache: cache };");
}

test "forward keeps the cache it is given through the pass it begins" {
    let out = generate(decoder("past_key", "present_key")).unwrap();

    let forward = out.substr_bytes(out.find("pub fn forward").unwrap(), out.len());
    assert forward.contains("cache: &Cache<Bk>, weights: &Prepared<Bk>) -> Outputs<Bk> with _ {");
    assert out.contains("pub struct Outputs<affine Bk: Holds> {");
    assert forward.find("cache.retain(backend);").unwrap() < forward.find("backend.begin();").unwrap();
    assert !forward.contains("input_mismatch(past_key");
    assert forward.contains("let Passed { Y, cache } = pass(backend, &X, cache, weights);");
}

test "an empty cache holds no position along the past's length, and zeros of every other state" {
    let out = generate(decoder("past_key", "present_key")).unwrap();

    assert out.contains("    pub fn empty(backend: &mut Bk) -> Cache<Bk> with _ {");
    assert out.contains("past_key: backend.upload(&Tensor::<f32, [");
    assert out.contains("]> { data: [], extents: [1, 0, 2] }),");
    assert out.contains("]> { data: List::<f32>::filled(3, 0 as f32), extents: [3] }),");
    assert out.contains(
        "    pub fn retain(&self, backend: &mut Bk) with _ {\n        backend.retain(&self.past_key);\n        backend.retain(&self.past_state);\n    }",
    );
}

test "past_key_values pairs with present, the one irregular spelling" {
    let out = generate(decoder("\"past_key_values.0.key\"", "\"present.0.key\"")).unwrap();

    assert out.contains("pub past_key_values_0_key: Bk::Tensor<f32, [");
}

test "a past no present pairs with stays an input, and the present an output" {
    let out = generate(decoder("past_key", "present_keys")).unwrap();

    assert out.contains("pub struct Cache<affine Bk: Holds> {\n    pub past_state: Bk::Tensor<f32, [");
    assert !out.contains("pub past_key:");
    let pass = out.substr_bytes(out.find("pub fn pass").unwrap(), out.find("pub fn forward").unwrap());
    assert pass.contains("past_key: &Bk::Tensor<f32, [");
    assert out.contains("pub struct Passed<affine Bk: Holds> {\n    pub Y: Bk::Tensor<f32, [");
    assert out.contains("    pub present_keys: Bk::Tensor<f32, [");
}

test "a graph that names only presents keeps them as outputs" {
    let source = `
prompt (float[1, N, 2] X) => (float[1, N, 2] Y, float[1, N, 2] present_key)
{
    Y = Relu(X)
    present_key = Neg(X)
}
`;
    let out = generate(source).unwrap();

    assert !out.contains("Cache");
    assert out.contains("pub present_key: Tensor<f32, [");
}

test "an empty cache takes the length of each axis the graph leaves open beside the past's own" {
    let source = `
decoder (float[B, N, 2] X, float[B, P, 2] past_key, float[B, 3] past_state) => (float[B, N, 2] Y, float[B, ?, 2] present_key, float[B, 3] present_state)
{
    Y = Relu(X)
    present_key = Concat<axis = 1>(past_key, X)
    present_state = Neg(past_state)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("    pub fn empty(backend: &mut Bk, dim_B: i32) -> Cache<Bk> with _ {");
    assert out.contains("]> { data: [], extents: [dim_B, 0, 2] }),");
    assert out.contains("]> { data: List::<f32>::filled(dim_B * 3, 0 as f32), extents: [dim_B, 3] }),");
}

test "an output that is a graph input is downloaded into the outputs" {
    let source = `
pass (float[N, 2] A) => (float[N, 2] A, float[N, 2] Y)
{
    Y = Relu(A)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("return Passed { A: *A, Y: Y };");
    assert out.contains("return Outputs { A: backend.download(&A), Y: backend.download(&Y) };");
}

test "the initializers become the weights struct" {
    let out = generate(MLP).unwrap();

    assert out.contains("pub struct Weights {");
    assert out.contains("pub W1: Tensor<f32, [X1, W11]>,");
    assert out.contains("pub B2: Tensor<f32, [Y1]>,");
}

test "weights the graph carries become Prepared::embedded" {
    let source = `
bias (float[N, 2] X) => (float[N, 2] Y)
<float[2] B = {1.0, -2.5}>
{
    Y = Add(X, B)
}
`;
    let out = generate(source).unwrap();

    assert out.contains(
        "impl<affine Bk: Backend> Prepared<Bk> {\n    /// The weights the graph carries.\n    pub fn embedded(backend: &mut Bk) -> Prepared<Bk> with _ {",
    );
    assert out.contains(
        "B: backend.keep(&Tensor::<f32, [X1]> { data: List::<f32>::from_le_bytes(embedded_data(0)), extents: [2] }),",
    );
    // 1.0 is 0x3f800000 and -2.5 is 0xc0200000, little-endian, held once for
    // `Prepared` and `Params` both.
    assert out.split("0 => b\"\\x00\\x00\\x80?\\x00\\x00 \\xc0\",").count() == 2;
}

test "weights the graph lacks are read from a checkpoint by Prepared::load" {
    let out = generate(MLP).unwrap();

    assert !out.contains("fn embedded");
    assert out.contains(
        "pub fn load<affine Ck: CheckpointBytes>(backend: &mut Bk, checkpoint: &Ck) -> Result<Prepared<Bk>, LoadError> with _ {",
    );
    assert out.contains("let header = read_checkpoint(checkpoint)?;");
    assert out.contains(
        "W1: backend.keep_rhs(&Tensor::<f32, [X1, W11]> { data: header.payload::<f32, Ck>(checkpoint, &Expected { tensor: \"W1\", dtype: \"F32\", axes: [\"X1\", \"W11\"], extents: [4, 3], elements: 12, width: 4 })?, extents: [4, 3] }),",
    );
}

test "a sharded checkpoint's weights are read each from the shard the index places it in" {
    let graph = read(&MLP).unwrap();
    let mut placed = HashMap::<String, String>::new();
    for let [i, name] of ["W1", "B1", "W2", "B2"].enumerate() {
        placed[name] = if i < 2 { "m-00001-of-00002.safetensors" } else { "m-00002-of-00002.safetensors" };
    }
    let out = emit(&graph, &infer(&graph).unwrap(), &RUNTIME, true, Placement::Shards(placed)).unwrap();

    assert out.contains("use { HashMap } from \"core:collections\";\n");
    assert out.contains(
        "pub fn load(backend: &mut Bk, shards: &HashMap<String, ByteList>) -> Result<Prepared<Bk>, LoadError> with _ {",
    );
    assert out.contains("let header = read_shards(shards)?;");
    assert out.contains(
        "W2: backend.keep_rhs(&Tensor::<f32, [W11, Y1]> { data: header.payload::<f32>(shards, \"m-00002-of-00002.safetensors\", &Expected { tensor: \"W2\",",
    );
}

test "weights left in place are read where the build found them" {
    let graph = read(&MLP).unwrap();
    let mut ranges = TreeMap::<String, [i32, i32]>::new();
    ranges["W1"] = [0, 48];
    ranges["B1"] = [48, 60];
    ranges["W2"] = [60, 84];
    ranges["B2"] = [84, 92];
    let in_place = InPlace { file: "model.onnx_data", ranges };
    let out = emit(&graph, &infer(&graph).unwrap(), &RUNTIME, true, Placement::InPlace(in_place)).unwrap();

    assert out.contains(
        "    /// The weights, those the graph does not carry read from model.onnx_data where the build found them.\n    pub fn load<affine Ck: CheckpointBytes>(backend: &mut Bk, checkpoint: &Ck) -> Result<Prepared<Bk>, LoadError> with _ {\n        return Result::Ok(Prepared {\n",
    );
    assert out.contains(
        "W2: backend.keep_rhs(&Tensor::<f32, [W11, Y1]> { data: payload_at::<f32, Ck>(checkpoint, \"W2\", 60, 84)?, extents: [3, 2] }),",
    );
    assert !out.contains("core:collections");
}

test "a single file's module imports no map" {
    assert !generate(MLP).unwrap().contains("core:collections");
}

test "a graph carrying some weights embeds those and loads the rest" {
    let source = `
bias (float[N, 2] X) => (float[N, 2] Y)
<float[2, 2] W, float[2] B = {1.0, -2.5}>
{
    H = MatMul(X, W)
    Y = Add(H, B)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("tensor: \"W\", dtype: \"F32\", axes: [\"X1\", \"Y1\"], extents: [2, 2], elements: 4, width: 4");
    assert out.contains("data: List::<f32>::from_le_bytes(embedded_data(1)), extents: [2] }");
    assert out.contains("1 => b\"\\x00\\x00\\x80?\\x00\\x00 \\xc0\",");
}

test "a tensor name is escaped where the loader spells it" {
    let source = `
quoted (float[2] X) => (float[2] Y)
<float[2] "a\\b">
{
    Y = Add(X, "a\\b")
}
`;
    let out = generate(source).unwrap();

    assert out.contains("tensor: \"a\\\\b\",");
}

test "every axis the graph mentions becomes a marker type" {
    let out = generate(MLP).unwrap();

    assert out.contains("pub struct N {}");
    assert out.contains("pub struct W11 {}");
}

test "an axis only a graph constant reaches becomes a marker type" {
    let source = "
g (float[N, 2] X) => (float[N, 2] Y)
<bool[1, 2] M = {1, 0}>
{
    Y = Where(M, X, X)
}
";
    let out = generate(source).unwrap();

    assert out.contains("Tensor<bool, [M0, X1]>");
    assert out.contains("pub struct M0 {}");
}

test "a name a Wado identifier cannot carry is sanitized" {
    let source = `
g (float[N, 2] "/model/input.0") => (float[N, 2] out)
<>
{
    out = Relu("/model/input.0")
}
`;
    let out = generate(source).unwrap();

    assert out.contains("backend: &mut Bk, _model_input_0: &Tensor<f32, [N, ModelInput01]>");
    // `forward` binds no name of its own, so a tensor keeps any it can spell.
    assert out.contains(`let out = backend.fused::<[N, ModelInput01]>([backend.read(_model_input_0)], &${unary(
        UnaryOp::Relu,
    )});`);
}

test "a tensor named as a method of a generated struct is renamed" {
    // A kept literal is a field of `Prepared`, whose constructor is `embedded`.
    let source = `g (float[2] X) => (float[2] Y) {
        embedded = Constant<value_floats = [1.0, 2.0]>()
        Y = Add(X, embedded)
    }`;
    let out = generate(source).unwrap();
    assert out.contains("embedded_: Kept::embedded_(backend),");
}

test "a weight a branch yields stays a tensor, though products read it too" {
    let source = `g (bool[1] C, float[2, 2] X) => (float[2, 2] Y, float[2, 2] Z) <float[2, 2] W> {
        Y = If <then_branch = t () => (float[2, 2] W) { }, else_branch = e () => (float[2, 2] W) { }> (C)
        Z = MatMul(X, W)
    }`;
    let out = generate(source).unwrap();
    assert out.contains("W: backend.keep(&self.W),");
}

test "a graph that returns its own input downloads it" {
    let source = `
g (float[N, 2] X) => (float[N, 2] X)
<>
{
}
`;
    let out = generate(source).unwrap();

    assert out.contains("    return *X;\n");
    assert out.contains("return backend.download(&pass(backend, &X, weights));");
}

test "folded tensors of one source keep their own elements, a Cast between them" {
    let source = `g (float[3] X) => (float[3] Y) <int64[3] A = {0, 1, 2}> {
        B = Cast<to = 1>(A)
        C = Identity(B)
        D = Identity(A)
        G = Gather(X, D)
        Y = Add(G, C)
    }`;
    let out = generate(source).unwrap();

    assert out.contains("return backend.keep(&Tensor::<i64, [Y0]> { data: [0, 1, 2]");
    assert out.contains("return backend.keep(&Tensor::<f32, [Y0]> { data: [0 as f32, 1 as f32, 2 as f32]");
}

test "a length the run would compute past i64 for some input stops the build" {
    let source = `g (float[N, M, 3] X) => (float[?] Y) <int64[1] Flat = {-1}> {
        Y = Reshape(X, Flat)
    }`;
    let e = generate(source).unwrap_err();
    assert `${e}` == "3 * M * N: the run computes this in i64, and some input carries it past";
}

test "two names that sanitize to one identifier stop the build" {
    let source = `
g (float[N, 2] "a.b", float[N, 2] "a/b") => (float[N, 2] out)
<>
{
    out = Add("a.b", "a/b")
}
`;
    let e = generate(source).unwrap_err();

    assert `${e}` == "a/b and a.b both name `a_b`";
}

test "Erf maps each element through the error function" {
    let source = `
g (float[N, 2] X) => (float[N, 2] Y)
<>
{
    Y = Erf(X)
}
`;
    let out = generate(source).unwrap();

    assert out.contains(`backend.fused::<[N, X1]>([backend.read(X)], &${unary(UnaryOp::Erf)})`);
}

test "an axis of 1 apart from the one it stretches over is read under the result's axes" {
    let source = `
g (float[N, 1] X, float[N, 4] Z) => (float[N, 4] Y)
<>
{
    Y = Add(X, Z)
}
`;
    let out = generate(source).unwrap();

    assert out.contains(
        `let Y = backend.fused::<[N, Z1]>([backend.read(&backend.lift::<f32, [N, X1], [N, Z1]>(X, 2)), backend.read(Z)], &${sum()});`,
    );
}

test "a Where operand whose axis of 1 is apart is read under the result's axes" {
    let source = `
g (float[N, 1] M, float[N, 4] X, float[N, 4] Z) => (float[N, 4] Y)
{
    C = Cast <to = 9> (M)
    Y = Where(C, X, Z)
}
`;
    let out = generate(source).unwrap();

    assert out.contains(
        `let Y = backend.fused::<[N, X1]>([backend.read_condition(&backend.lift::<bool, [N, M1], [N, X1]>(&C, 2)), backend.read(X), backend.read(Z)], &${select()});`,
    );
}

test "Reshape relabels the tensor under the merged axis" {
    let source = `
g (float[1, 16, 4, 4] X) => (float[1, 256] Y)
<int64[2] S = {1, 256}>
{
    Y = Reshape(X, S)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("let Y = backend.reshape::<f32, [X0, X1, X2, X3], [X0, Merged<[X1, X2, X3]>]>(X, [1, 256]);");
    assert out.contains("-> Tensor<f32, [X0, Merged<[X1, X2, X3]>]> with _ {");
    // A merged axis is spelled with its parts' markers, never declared itself.
    assert out.contains("pub struct X1 {}");
    assert !out.contains("pub struct Merged");
    // The target shape is read at build time, so no weight carries it.
    assert !out.contains("pub S:");
}

test "a shape only the build reads is bound nowhere" {
    let source = `
g (float[1, 16, 4, 4] X, float[1, 256] Z) => (float[1, 256] Y)
{
    S = Shape(Z)
    Y = Reshape(X, S)
}
`;
    let out = generate(source).unwrap();

    assert !out.contains("let S =");
}

test "a grouped Conv lowers to conv_grouped, naming the weight's channel axis" {
    let source = `
g (float[1, 4, 3, 3] X) => (float[1, 2, 2, 2] Y)
<float[2, 2, 2, 2] W>
{
    Y = Conv <group = 2> (X, W)
}
`;
    let out = generate(source).unwrap();

    assert out.contains(
        "let Y = backend.conv_grouped::<X0, X1, W1, Y1, [X2, X3], [W2, W3], [Y2, Y3]>(X, &weights.W, 2, &Window {",
    );
}

test "a grouped Conv with a bias lowers to conv_grouped_bias" {
    let source = `
g (float[1, 4, 3, 3] X) => (float[1, 2, 2, 2] Y)
<float[2, 2, 2, 2] W, float[2] B>
{
    Y = Conv <group = 2> (X, W, B)
}
`;
    let out = generate(source).unwrap();

    assert out.contains(
        "let Y = backend.conv_grouped_bias::<X0, X1, W1, Y1, [X2, X3], [W2, W3], [Y2, Y3]>(X, &weights.W, &weights.B, 2, &Window {",
    );
}

test "Conv and MaxPool lower to their kernels under the window stage 0 read" {
    let source = `
g (float[1, 1, 28, 28] X) => (float[1, 8, 14, 14] Y)
<float[8, 1, 5, 5] W, float[8] B>
{
    C = Conv <kernel_shape = [5, 5], auto_pad = "SAME_UPPER"> (X, W, B)
    Y = MaxPool <kernel_shape = [2, 2], strides = [2, 2]> (C)
}
`;
    let out = generate(source).unwrap();

    assert out.contains(
        "let C = backend.conv_bias::<X0, X1, Y1, [X2, X3], [W2, W3], [C2, C3]>(X, &weights.W, &weights.B, &Window { kernel: [5, 5], strides: [1, 1], dilations: [1, 1], pads: [2, 2, 2, 2], output: [28, 28] }, null);",
    );
    assert out.contains(
        "let Y = backend.max_pool::<X0, Y1, [C2, C3], [Y2, Y3]>(&C, &Window { kernel: [2, 2], strides: [2, 2], dilations: [1, 1], pads: [0, 0, 0, 0], output: [14, 14] });",
    );
}

test "Gemm lowers to a matmul under its transpose flags" {
    let source = `
g (float[2, 3] A, float[4, 3] B, float[4] C) => (float[2, 4] Y)
<>
{
    Y = Gemm <transB = 1, alpha = 0.5, beta = 2.0> (A, B, C)
}
`;
    let out = generate(source).unwrap();

    assert out.contains(
        `let Y = backend.matmul(A, &backend.transpose2(B), Option::Some(Epilogue { operands: [backend.read_suffix::<[A0], [B0]>(C)], op: ${src(
            operand(0).binary(BinaryOp::Mul, &constant(0.5)).binary(BinaryOp::Add, &operand(1).binary(
                BinaryOp::Mul,
                &constant(2.0),
            )),
        )} }));`,
    );
}

test "Gemm whose scalars are both one and has no bias is its product alone" {
    let source = `
g (float[2, 3] A, float[3, 4] B) => (float[2, 4] Y)
<>
{
    Y = Gemm(A, B)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("let Y = backend.matmul(A, B, null);");
}

test "a rank-2 Transpose lowers to the kernel" {
    let source = `
g (float[2, 3] X) => (float[3, 2] Y)
<>
{
    Y = Transpose <perm = [1, 0]> (X)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("let Y = backend.permute::<f32, [X0, X1], [X1, X0]>(X, [1, 0]);");
}

test "a Transpose that moves no axis is its operand" {
    let source = `
g (float[2, 3] X) => (float[2, 3] Y)
<>
{
    Y = Transpose <perm = [0, 1]> (X)
}
`;
    let out = generate(source).unwrap();

    assert !out.contains("permute");
    // Every node result is bound as a value, so the operand is read as one.
    assert out.contains("let Y = *X;");
}

test "Where over floats is a kernel's select, a lower-rank operand repeated across the output" {
    let source = `
g (float[1, 1, 4, 4] M, float[2, 3, 4, 4] X) => (float[2, 3, 4, 4] Y)
<float S>
{
    C = Cast<to = 9>(M)
    Y = Where(C, X, S)
}
`;
    let out = generate(source).unwrap();

    assert out.contains(
        `let Y = backend.fused::<[X0, X1, M2, M3]>([backend.read_condition(&backend.lift::<bool, [M0, M1, M2, M3], [X0, X1, M2, M3]>(&C, 4)), backend.read(X), backend.read_suffix::<[X0, X1, M2, M3], []>(&weights.S)], &${select()});`,
    );
}

test "a folded Where operand is read as its literal" {
    let source = `
g (float[1, 4] M, float[1, 4] X) => (float[1, 4] Y)
{
    C = Cast<to = 9>(M)
    S = Constant<value_float = -1.0>()
    Y = Where(C, S, X)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("return backend.keep(&Tensor::<f32, []> { data: [-1 as f32], extents: [] });");
    assert out.contains(
        `let Y = backend.fused::<[M0, M1]>([backend.read_condition(&C), backend.read_suffix::<[M0, M1], []>(&weights.S), backend.read(X)], &${select()});`,
    );
}

test "a weight's axis a regrouping meets is spelled with its parts' markers" {
    let source = `
g (float[4, 2, 8] X) => (float[4, 6] Y)
<float[16, 6] W, int64[2] S = {4, 16}>
{
    R = Reshape(X, S)
    Y = MatMul(R, W)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("pub W: Tensor<f32, [Merged<[X1, X2]>, Y1]>,");
    assert out.contains("pub W: Bk::Rhs<Merged<[X1, X2]>, Y1>,");
    assert out.contains("let Y = backend.matmul_rhs(&R, &weights.W, null);");
}

test "Split cuts one run along the axis for each output" {
    let source = `
g (float[1, 4, 24] X) => (float[1, 4, 8] K)
{
    S = Constant<value_ints = [8, 8, 8]>()
    Q, K, V = Split<axis = 2>(X, S)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("let Q = backend.slice_axis::<f32, [X0, X1], X2, Q2, []>(X, 2, 0, 8, 1);");
    assert out.contains("let K = backend.slice_axis::<f32, [X0, X1], X2, K2, []>(X, 2, 8, 8, 1);");
    assert out.contains("let V = backend.slice_axis::<f32, [X0, X1], X2, V2, []>(X, 2, 16, 8, 1);");
}

test "Concat joins its operands pairwise, each join naming the output's axis" {
    let source = `
g (float[1, T, 8] P, float[1, 1, 8] N) => (float[1, U, 8] Y)
{
    Y = Concat<axis = 1>(P, N, N)
}
`;
    let out = generate(source).unwrap();

    assert out.contains(
        "let Y = backend.concat::<f32, [P0], U, N1, U, [P2]>(&backend.concat::<f32, [P0], T, N1, U, [P2]>(P, N, 1), N, 1);",
    );
}

test "Softmax along the last axis lowers to a row kernel" {
    let source = `
g (float[2, 4, 8] X) => (float[2, 4, 8] Y)
{
    Y = Softmax <axis = -1> (X)
}
`;
    let out = generate(source).unwrap();

    assert out.contains(
        `let Y = backend.rows::<[X0, X1, X2], [X0, X1, X2]>([backend.read(X)], &${src(
            operand(0).row_softmax(),
        )}, 1, false);`,
    );
}

test "Softmax along another axis lowers to its kernel" {
    let source = `
g (float[2, 4, 8] X) => (float[2, 4, 8] Y)
{
    Y = Softmax <axis = 1> (X)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("let Y = backend.softmax(X, 1);");
}

test "Softmax before opset 13 lowers to the kernel over the axes from its own on" {
    let lowered = |attrs: String| -> String {
        let source = `<ir_version: 7, opset_import: ["" : 11]>
g (float[2, 4, 8] X) => (float[2, 4, 8] Y)
{
    Y = Softmax ${attrs} (X)
}
`;
        return generate(source).unwrap();
    };

    assert lowered("").contains("let Y = backend.softmax_flattened(X, 1);");
    // From the last axis on is the last axis alone, a row.
    assert lowered("<axis = 2>").contains("let Y = backend.rows::<");
}

test "arithmetic before opset 7 aligned at an axis reads the shorter operand there" {
    let source = `<ir_version: 3, opset_import: ["" : 6]>
g (float[2, 4, 8] X, float[4] B) => (float[2, 4, 8] Y)
{
    Y = Add <broadcast = 1, axis = 1> (X, B)
}
`;
    let out = generate(source).unwrap();

    assert out.contains(
        `let Y = backend.fused::<[X0, X1, X2]>([backend.read(X), backend.read_at::<[X0], [X1], [X2]>(B, 1)], &${sum()});`,
    );
}

test "arithmetic before opset 7 aligned at the axis numpy would take lowers as numpy's" {
    let source = `<ir_version: 3, opset_import: ["" : 6]>
g (float[2, 4, 8] X, float[8] B) => (float[2, 4, 8] Y)
{
    Y = Add <broadcast = 1, axis = 2> (X, B)
}
`;
    let out = generate(source).unwrap();

    assert out.contains(
        `let Y = backend.fused::<[X0, X1, X2]>([backend.read(X), backend.read_suffix::<[X0, X1], [X2]>(B)], &${sum()});`,
    );
}

test "a layer norm's mean is a fold its row kernel reads back over the row" {
    let source = `
g (float[2, 4, 8] X) => (float[2, 4, 8] Y)
{
    M = ReduceMean <axes = [-1]> (X)
    Y = Sub(X, M)
}
`;
    let out = generate(source).unwrap();

    assert out.contains(
        `let Y = backend.rows::<[X0, X1, X2], [X0, X1, X2]>([backend.read(X)], &${src(
            operand(0).binary(BinaryOp::Sub, &operand(0).row_sum(Option::Some(8.0))),
        )}, 1, false);`,
    );
}

test "a Gemm between a flattening Reshape and its restoring one reads the operand over its leading axes" {
    let source = `
lin (float[2, 4, 8] X, float[8, 6] W, float[6] B) => (float[2, 4, 6] Y)
<int64[2] Flat = {-1, 8}, int64[3] Back = {2, 4, 6}>
{
    F = Reshape(X, Flat)
    G = Gemm(F, W, B)
    R = Reshape(G, Back)
    Y = Relu(R)
}
`;
    let out = generate(source).unwrap();

    let kernels = kernel_entries(&out);
    assert !kernels.contains("let F =") && !kernels.contains("let R =");
    assert out.contains(
        `let Y = backend.matmul_shared(X, W, Option::Some(Epilogue { operands: [backend.read_suffix::<[X0, X1], [W1]>(B)], op: ${src(
            operand(0).binary(BinaryOp::Add, &operand(1)).unary(UnaryOp::Relu),
        )} }));`,
    );
}

test "a mean alone writes one value per row" {
    let source = `
g (float[2, 4, 8] X) => (float[2, 4, 1] Y)
{
    Y = ReduceMean <axes = [-1]> (X)
}
`;
    let out = generate(source).unwrap();

    // The output keeps the axis it reduced, at extent 1.
    assert out.contains(
        `let Y = backend.rows::<[X0, X1, X2], [X0, X1, X2]>([backend.read(X)], &${src(operand(0).row_sum(
            Option::Some(8.0),
        ))}, 1, true);`,
    );
}

test "ReduceSum lowers to the summing kernel" {
    let source = `
g (float[2, 4, 8] X) => (float[1, 4, 1] Y)
{
    Y = ReduceSum <axes = [0, 2]> (X)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("let Y = backend.reduce_sum(X, [0, 2]);");
}

test "a reduction that drops its axes reshapes the kept ones away" {
    let source = `
g (float[2, 4, 8] X) => (float[2, 4] Y)
{
    Y = ReduceMean <axes = [-1], keepdims = 0> (X)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("let Y = backend.reshape::<f32, [X0, X1, X2], [X0, X1]>(&backend.reduce_mean(X, [2]), [2, 4]);");
}

fn is_error<E: Error>() {
}

test "every error emit reports is an Error" {
    is_error::<EmitError>();
    is_error::<UnmappedDtype>();
    is_error::<NameCollision>();
}

test "a Transpose of any rank spells both axis orders" {
    let source = `
g (float[1, 4, 2, 3] X) => (float[1, 2, 3, 4] Y)
<>
{
    Y = Transpose <perm = [0, 2, 3, 1]> (X)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("let Y = backend.permute::<f32, [X0, X1, X2, X3], [X0, X2, X3, X1]>(X, [0, 2, 3, 1]);");
}

test "a tensor named as the generated module names something is renamed" {
    let source = `
g (float[N, 2] weights, float[N, 2] narrow) => (float[N, 2] Tensor)
<>
{
    Tensor = Add(weights, narrow)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("backend: &mut Bk, weights_: &Tensor<f32, [N, Weights1]>, narrow_: ");
    assert out.contains("let Tensor_ = backend.fused::<[N, Weights1]>([backend.read(weights_), backend.read(narrow_)],");
    assert out.contains("    return Tensor_;\n");
}

test "a weight named as a method of the weights is renamed" {
    let source = `
g (float[N, 2] X) => (float[N, 2] Y)
<float[2] prepare>
{
    Y = Add(X, prepare)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("    pub prepare_: Tensor<f32, [X1]>,\n");
    assert out.contains("pub fn prepare<affine Bk: Backend>(&self");
}

test "a tensor named as a runtime item the module does not import keeps its name" {
    let source = `
g (float[N, 2] map) => (float[N, 2] Y)
<>
{
    Y = Relu(map)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("let Y = backend.fused::<[N, Map1]>([backend.read(map)],");
}

test "a tensor named as the map a sharded load takes keeps its name where the module imports none" {
    let source = `
g (float[N, 2] HashMap) => (float[N, 2] Y)
<>
{
    Y = Relu(HashMap)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("backend.read(HashMap)");
}

test "a sharded checkpoint that supplies no weight imports no map" {
    let source = `
g (float[N, 2] X) => (float[N, 2] Y)
<float[2] B = {1.0, 2.0}>
{
    Y = Add(X, B)
}
`;
    let graph = read(&source).unwrap();
    let out = emit(&graph, &infer(&graph).unwrap(), &RUNTIME, true, Placement::Shards(HashMap::new())).unwrap();

    assert !out.contains("core:collections");
    assert out.contains("pub fn embedded(");
}

test "a renamed tensor steps past a tensor already named as the renaming would" {
    for let [first, second] of [
        ["refuse", "refuse_"],
        ["refuse_", "refuse"],
    ] as List<[String, String]> {
        let source = `
g (float[N, 2] ${first}, float[N, 2] ${second}) => (float[N, 2] Y)
<>
{
    Y = Add(refuse, refuse_)
}
`;
        let out = generate(source).unwrap();

        assert out.contains("let Y = backend.fused::<[N, Refuse1]>([backend.read(refuse__), backend.read(refuse_)],");
    }
}

test "two renamed tensors step past each other" {
    // `n` takes `N_`, as `N` has `N`.
    let source = `
g (float[N] N, float[n] N_) => (float[N] Y, float[n] Z)
<>
{
    Y = Relu(N)
    Z = Relu(N_)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("backend: &mut Bk, N__: &Tensor<f32, [N]>, N___: &Tensor<f32, [N_]>,");
}

test "a tensor named as an axis is renamed too" {
    let source = `
g (float[N, 2] N) => (float[N, 2] Y)
<>
{
    Y = Relu(N)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("pub struct N {}");
    assert out.contains("let Y = backend.fused::<[N, N1]>([backend.read(N_)],");
}

test "an axis a dim_param would name as the generated module names something takes another" {
    // Every name the module imports from the runtime is reserved, whether or
    // not this graph reads it, and so is what `forward` binds.
    for let name of ["Tensor", "Backend", "UnaryOp", "LoadError", "Bk"] {
        let source = `
g (float[${name}, 2] X) => (float[${name}, 2] Y)
<>
{
    Y = Relu(X)
}
`;
        assert generate(source).unwrap().contains(`pub struct ${name}_ {}`);
    }
}

test "a MatMul against one matrix shares it across the batch" {
    let source = `
g (float[1, 4, 8] X, float[8, 16] W) => (float[1, 4, 16] Y)
{
    Y = MatMul(X, W)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("let Y = backend.matmul_shared(X, W, null);");
}

test "a MatMul batch axis that stretches lowers to matmul_broadcast, the result spelled" {
    let source = `
g (float[1, 2, 3] X, float[4, 3, 5] Z) => (float[4, 2, 5] Y)
{
    Y = MatMul(X, Z)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("let Y = backend.matmul_broadcast::<[X0, X1, X2], [Z0, X2, Z2], [Z0, X1, Z2]>(X, Z, null);");
}

test "a rank-1 MatMul operand lowers to matmul_broadcast, which drops its axis" {
    let source = `
g (float[3] X, float[3, 5] Z) => (float[5] Y)
{
    Y = MatMul(X, Z)
}
`;
    let out = generate(source).unwrap();

    assert out.contains("let Y = backend.matmul_broadcast::<[X0], [X0, Z1], [Z1]>(X, Z, null);");
}

fn refused_dtype(dtype: String) -> String {
    let source = `
g (${dtype}[N, 2] X) => (${dtype}[N, 2] Y)
<>
{
    Y = Relu(X)
}
`;
    return `${generate(source).unwrap_err()}`;
}

test "an element type the kernels cannot compute in names itself" {
    assert refused_dtype("int32") == "X: no kernel holds int32";
    assert refused_dtype("uint8") == "X: no kernel holds uint8";
}

test "a half precision boundary states its own element type" {
    let out = generate(mlp("float16")).unwrap();

    assert out.contains(
        "pub fn forward<affine Bk: Backend>(backend: &mut Bk, X: &Tensor<f16, [N, X1]>, weights: &Prepared<Bk>) -> Tensor<f16, [N, Y1]> with _ {",
    );
    assert out.contains("pub W1: Tensor<f16, [X1, W11]>,");
}

test "a half precision boundary is prepared into the f32 the kernels compute in" {
    let out = generate(mlp("float16")).unwrap();

    // A weight once, where `Prepared` is built; an input on each call.
    assert out.contains("    pub W1: Bk::Rhs<X1, W11>,\n");
    assert out.contains("W1: backend.prepare_rhs(&self.W1),");
    assert out.contains("let X = backend.prepare(X);");
    assert out.contains("let A = backend.matmul_rhs(X, &weights.W1, Option::Some(Epilogue {");
    assert out.contains("return narrow(&backend.download(&pass(backend, &X, weights)));");
}

test "bfloat16 is the same boundary with the other primitive" {
    let out = generate(mlp("bfloat16")).unwrap();

    assert out.contains("backend: &mut Bk, X: &Tensor<bf16, [N, X1]>");
    assert out.contains("let X = backend.prepare(X);");
    assert out.contains("return narrow(&backend.download(&pass(backend, &X, weights)));");
}

// The textual format carries no tensor attribute, so a `Constant` graph is
// built here rather than read.
fn constant_graph(consumer: Node, produced: Rank, value: f32) -> Graph {
    let float2 = ValueInfo {
        name: "X",
        dtype: "float",
        rank: Rank::Dims([
            Dim::Symbol("N"),
            Dim::Static(2),
        ]),
    };
    return Graph {
        name: "g",
        inputs: [float2],
        outputs: [
            ValueInfo { name: consumer.outputs[0], dtype: "float", rank: produced },
        ],
        initializers: [],
        nodes: [
            Node {
                op: "Constant",
                outputs: ["C"],
                inputs: [],
                attrs: [
                    Attr {
                        name: "value",
                        values: [],
                        is_list: false,
                        tensor: Option::Some(Known {
                            extents: [],
                            elements: Elements::Floats([value]),
                        }),
                    },
                ],
            },
            consumer,
        ],
    };
}

fn node(op: String, output: String, inputs: List<String>) -> Node {
    return Node {
        op,
        outputs: [output],
        inputs,
        attrs: [],
    };
}

fn emit_graph(graph: &Graph) -> Result<String, EmitError> {
    return emit(graph, &infer(graph).unwrap(), &RUNTIME);
}

fn matrix_rank() -> Rank {
    return Rank::Dims([
        Dim::Symbol("N"),
        Dim::Static(2),
    ]);
}

fn folded_add(value: f32) -> Result<String, EmitError> {
    return emit_graph(&constant_graph(node("Add", "Y", ["X", "C"]), matrix_rank(), value));
}

test "a symbol is bound from the input axis carrying it, and spelled where an extent needs it" {
    let source = `g (float[N, 4] X) => (float[N, 2, 2] Y) <int64[3] S = {0, 2, 2}> {
        Y = Reshape(X, S)
    }`;
    let out = generate(source).unwrap();
    assert out.contains("let dim_N = backend.extents_of(X)[0] as i64;");
    assert out.contains("let Y = backend.reshape::<f32, [N, X1], [N, Y1, Y2]>(X, [to_extent(dim_N), 2, 2]);");
}

test "a symbol nothing spells is not bound" {
    let out = generate(mlp("float")).unwrap();
    assert !kernel_entries(&out).contains("dim_");
}

test "a build reads the valid length where it sums, normalizes, contracts or joins along a padded axis" {
    let source = `g (float[N] X, float[N, 4] P) => (float[] S, float[N] M, float[4] C, float[?] J) {
        S = ReduceSum <keepdims = 0> (X)
        M = Softmax <axis = 0> (X)
        C = MatMul(X, P)
        J = Concat <axis = 0> (X, X)
    }`;
    let out = generate(source).unwrap();
    let built = out.substr_bytes(out.find("pub fn build").unwrap(), out.len());
    assert built.contains("lengths: &Lengths<Bk>");
    assert built.contains("masked::<Bk, f32, [N]>(backend, X, 0, &lengths.dim_N, 0 as f32)");
    assert built.contains("masked::<Bk, f32, [N]>(backend, X, 0, &lengths.dim_N, -f32::INFINITY)");
    assert built.contains("masked::<Bk, f32, [N, P1]>(backend, P, 0, &lengths.dim_N, 0 as f32)");
    assert built.contains("(backend, X, X, 0, &lengths.dim_N)");
    assert built.contains("pub fn compute<");
}

test "a build takes a padded past to its attention as a buffer of fixed capacity, with its valid length" {
    let source = `g (float[1, S, 8] Q, float[1, S, 8] K, float[1, S, 8] V, float[1, 1, P, 8] PK, float[1, 1, P, 8] PV, int64[1, T] M)
        => (float[1, S, 8] Y, float[1, 1, T, 8] PY, float[1, 1, T, 8] VY) {
        Dims = Shape(M)
        One = Constant<value_ints = [1]>()
        Total = Gather(Dims, One)
        Last = Sub(Total, One)
        L = Cast<to = 6>(Last)
        TotalScalar = Squeeze(Total)
        T32 = Cast<to = 6>(TotalScalar)
        Y, PY, VY = com.microsoft.GroupQueryAttention<num_heads = 1, kv_num_heads = 1>(Q, K, V, PK, PV, L, T32)
    }`;
    let out = generate(source).unwrap();
    let built = out.substr_bytes(out.find("pub fn build").unwrap(), out.len());
    assert built.contains("(Q, K, V, PK, PV, Option::Some(&lengths.dim_P), null, null, null, &Attention {");
    assert !kernel_entries(&out).contains("lengths");
}

test "compute holds a cache at the capacity of the total, its past's length what the graph owes it" {
    let source = `g (float[1, S, 8] Q, float[1, S, 8] K, float[1, S, 8] V, float[1, 1, P, 8] "past_key_values.0.key", float[1, 1, P, 8] "past_key_values.0.value", int64[1, T] M)
        => (float[1, S, 8] Y, float[1, 1, T, 8] "present.0.key", float[1, 1, T, 8] "present.0.value") {
        Dims = Shape(M)
        One = Constant<value_ints = [1]>()
        Total = Gather(Dims, One)
        Last = Sub(Total, One)
        L = Cast<to = 6>(Last)
        TotalScalar = Squeeze(Total)
        T32 = Cast<to = 6>(TotalScalar)
        Y, "present.0.key", "present.0.value" = com.microsoft.GroupQueryAttention<num_heads = 1, kv_num_heads = 1>(Q, K, V, "past_key_values.0.key", "past_key_values.0.value", L, T32)
    }`;
    let out = generate(source).unwrap();
    let computed = out.substr_bytes(out.find("pub fn compute").unwrap(), out.len());
    assert computed.contains("cache: &Cache<Bk>, weights: &Params<Bk>) -> Outputs<Bk>");
    assert computed.contains("let dim_P = -dim_S + dim_T;");
    assert computed.contains("let capacity_P = capacity_of(to_extent(dim_P + dim_S)) as i64;");
    assert computed.contains(
        "fitted::<Bk, f32, [Q0, PastKeyValues0Key1, P, PastKeyValues0Key3]>(backend, &cache.past_key_values_0_key, 2, to_extent(capacity_P))",
    );
    // A device releases the pass before at `begin`, but for the cache it retains.
    let begun = computed.find("backend.begin();").unwrap();
    assert computed.find("cache.retain(backend);").unwrap() < begun;
    assert begun < computed.find("let Q = ").unwrap();
    assert begun < computed.find("fitted::<Bk").unwrap();
}

test "what a padded length owes is checked at the length, by compute, and not at the capacity, by build" {
    // The slice of `W` matches `X` only where N is at most 8.
    let source = `g (float[N] X) => (float[N] Y) <float[8] W> {
        S = Shape(X)
        Zero = Constant<value_ints = [0]>()
        Part = Slice(W, Zero, S)
        Y = Add(X, Part)
    }`;
    let out = generate(source).unwrap();
    let [build_at, compute_at] = [
        out.find("pub fn build").unwrap(),
        out.find("pub fn compute").unwrap(),
    ];
    assert out.substr_bytes(compute_at, out.len()).contains("refuse(unmet(");
    assert !out.substr_bytes(build_at, compute_at).contains("refuse(unmet(");
}

test "a build whose lengths enter no value takes none" {
    let out = generate(mlp("float")).unwrap();
    assert !out.contains("Lengths");
    assert out.contains("pub fn compute<");
}

test "a Range over a symbolic length is a kernel call" {
    let source = `g (int64[N] X) => (int64[N] Y) {
        S = Shape(X)
        Z = Constant <value = int64 {0}> ()
        O = Constant <value = int64 {1}> ()
        L = Gather <axis = 0> (S, Z)
        Y = Range(Z, L, O)
    }`;
    let out = generate(source).unwrap();
    assert out.contains("let Y = backend.range_i64::<N>(0, to_extent(dim_N), 1);");
}

test "a clamp the run computes, read as its operand, is checked before any kernel" {
    let source = `g (float[N] X, float[8] M) => (float[N] Y) <int64[1] Z = {0}> {
        S = Shape(X)
        A = Slice(M, Z, S)
        Y = Add(A, X)
    }`;
    let out = generate(source).unwrap();
    let check = out.find("refuse(unmet(-dim_N + 8, \"A = Slice: N must be at most 8\"));").unwrap();
    let call = "let A = backend.slice_axis::<f32, [], M0, N, []>(M, 0, 0, to_extent(i64::min(dim_N, 8)), 1);";
    let slice = out.find(call).unwrap();
    assert check < slice;
}

test "a Reshape -1 the build rounds is checked to divide before the kernel runs" {
    let source = `g (float[N] X) => (float[?, 2] Y) <int64[2] T = {-1, 2}> {
        Y = Reshape(X, T)
    }`;
    let out = generate(source).unwrap();
    let check = out.find("refuse(unmet(-dim_N + 2 * dim_N.div_floor(2), ").unwrap();
    let call = "let Y = backend.reshape::<f32, [N], [Y0, Y1]>(X, [to_extent(dim_N.div_floor(2)), 2]);";
    let reshape = out.find(call).unwrap();
    assert check < reshape;
}

test "a Slice by a negative step walks back from its start" {
    let source = `g (float[N] X) => (float[?] Y) <int64[1] B = {-1}, int64[1] E = {-4000000000}, int64[1] Z = {0}, int64[1] Back = {-1}> {
        Y = Slice(X, B, E, Z, Back)
    }`;
    let out = generate(source).unwrap();
    assert out.contains("let Y = backend.slice_axis::<f32, [], N, Y0, []>(X, 0, dim_N - 1, to_extent(dim_N), -1);");
}

test "an int64 input is held as i64 through the layout kernels and Cast converts it" {
    let source = `g (int64[1, 4] M) => (float[1, 1, 4] Y) {
        A = Constant<value_ints = [1]>()
        U = Unsqueeze(M, A)
        Y = Cast<to = 1>(U)
    }`;
    let out = generate(source).unwrap();
    assert out.contains("M: &Tensor<i64, [M0, M1]>");
    assert !out.contains("widen(");
    assert out.contains("let U = backend.reshape::<i64, [M0, M1], [M0, Y1, M1]>(M, [1, 1, 4]);");
    assert out.contains("let Y = backend.cast::<i64, f32, [M0, Y1, M1]>(&U);");
}

test "an embedding lookup is a row gather, and a folded index tensor is a literal" {
    let source = `g (int64[1, 4] I) => (float[1, 4, 8] Y) <float[16, 8] W, float[4, 8] P, int64[1, 4] Q = {0, 1, 2, 3}> {
        E = Gather(W, I)
        F = Gather(P, Q)
        Y = Add(E, F)
    }`;
    let out = generate(source).unwrap();
    assert out.contains("W: backend.keep_rhs(&self.W),");
    assert out.contains("let E = backend.gather_rhs_rows(&weights.W, I);");
    assert out.contains("return backend.keep(&Tensor::<i64, [I0, I1]> { data: [0, 1, 2, 3], extents: [1, 4] });");
    assert out.contains("let F = backend.gather_rhs_rows(&weights.P, &weights.Q);");
}

test "a weight read past a product and a gather is kept whole, one read only by products as their right operand" {
    // `W` is gathered, as an embedding is, and read whole; `V` only multiplied.
    let source = `g (int64[1, 4] I) => (float[1, 4, 8] Y, float[16, 8] Z) <float[16, 8] W, float[8, 8] V> {
        E = Gather(W, I)
        Y = MatMul(E, V)
        Z = Relu(W)
    }`;
    let out = generate(source).unwrap();
    assert out.contains("W: backend.keep(&self.W),");
    assert out.contains("V: backend.keep_rhs(&self.V),");
    assert out.contains("let Y = backend.matmul_rhs(&E, &weights.V, null);");
}

test "an embedding the head multiplies by its transpose is held once, as rows both read" {
    let source = `g (int64[1, 4] I) => (float[1, 4, 16] Y) <float[16, 8] W> {
        E = Gather(W, I)
        T = Transpose<perm = [1, 0]>(W)
        Y = MatMul(E, T)
    }`;
    let out = generate(source).unwrap();
    assert out.contains("W: backend.keep_rhs(&self.W),");
    assert out.contains("let E = backend.gather_rhs_rows(&weights.W, I);");
    assert out.contains("let Y = backend.matmul_by_rhs_transposed(&E, &weights.W, null);");
}

test "a Gemm's transposed weight is prepared transposed, so no pass transposes it" {
    let source = `g (float[2, 3] A) => (float[2, 4] Y) <float[4, 3] B> {
        Y = Gemm <transB = 1> (A, B)
    }`;
    let out = generate(source).unwrap();
    assert out.contains("    pub B: Bk::Rhs<A1, Y1>,\n");
    assert out.contains("B: backend.keep_rhs_transposed(&self.B),");
    assert out.contains("let Y = backend.matmul_rhs(A, &weights.B, null);");
    assert !out.contains("transpose2");
}

test "a weight two products read in two orientations, or one beside a vector, stays a tensor" {
    let source = `g (float[2, 3] A, float[4] V) => (float[2, 4] Y, float[3] Z) <float[4, 3] B> {
        Y = Gemm <transB = 1> (A, B)
        Z = MatMul(V, B)
    }`;
    let out = generate(source).unwrap();
    assert out.contains("B: backend.keep(&self.B),");
    assert !out.contains("matmul_rhs");
}

test "a branch multiplies by a prepared weight as the graph around it holds it" {
    let source = `g (bool[1] C, float[2, 2] X) => (float[2, 2] Y) <float[2, 2] W> {
        Y = If <then_branch = t () => (float[2, 2] A) { A = MatMul(X, W) }, else_branch = e () => (float[2, 2] B) { B = Neg(X) }> (C)
    }`;
    let out = generate(source).unwrap();
    assert out.contains("    pub W: Bk::Rhs<X1, W1>,\n");
    assert out.contains("backend.matmul_rhs(X, &weights.W, null)");
}

test "Gather along any axis but the first lowers to gather, the axes spelled" {
    let source = `g (int64[2] I) => (float[16, 2] Y) <float[16, 8] W> {
        Y = Gather<axis = 1>(W, I)
    }`;
    let out = generate(source).unwrap();
    assert out.contains("let Y = backend.gather::<f32, [Y0], W1, [], [I0]>(&weights.W, I, 1);");
}

test "a Cast to the element a tensor already has computes nothing" {
    let source = `g (float[2] X) => (float[2] Y) {
        C = Cast<to = 1>(X)
        Y = Relu(C)
    }`;
    let out = generate(source).unwrap();
    assert !out.contains("let C");
    assert out.contains(`let Y = backend.fused::<[X0]>([backend.read(X)], &${unary(UnaryOp::Relu)});`);
}

test "a Cast that truncates is spelled apart from the constant it reads" {
    // Both are held in i64, but the int32 cast keeps only the low half.
    let source = `g (float[2] M) => (int64[2] Y) {
        B = Cast<to = 9>(M)
        Q = Constant<value_ints = [4294967297, 2]>()
        C = Cast<to = 6>(Q)
        Y = Where(B, Q, C)
    }`;
    let out = generate(source).unwrap();
    assert out.contains("data: [4294967297, 2]");
    assert out.contains("data: [1, 2]");
}

test "Identity names its operand again and computes nothing" {
    let source = `g (float[2] X) => (float[2] Y) <float[2] W = {1.0, 2.0}> {
        V = Identity(W)
        Y = Add(X, V)
    }`;
    let out = generate(source).unwrap();
    assert out.contains(`let Y = backend.fused::<[X0]>([backend.read(X), backend.read(&weights.W)], &${sum()});`);
    assert !out.contains("let V");
}

test "a scale the graph computes from a shape folds to a literal" {
    // Attention's `1 / sqrt(head_dim)`, as an exporter writes it.
    let source = `g (float[2, 4] X) => (float[2, 4] Y) {
        S = Shape(X)
        I = Constant<value_int = 1>()
        D = Gather(S, I)
        F = Cast<to = 1>(D)
        H = Constant<value_float = 0.5>()
        R = Pow(F, H)
        Y = Div(X, R)
    }`;
    let out = generate(source).unwrap();
    assert out.contains(
        `let Y = backend.fused::<[X0, X1]>([backend.read(X)], &${src(operand(0).binary(BinaryOp::Div, &constant(
            2.0,
        )))});`,
    );
    assert !out.contains("let S");
}

test "a Cast of a length only the run knows converts it at run time" {
    let source = `g (float[N, 4] X) => (float[N, 4] Y) {
        S = Shape(X)
        I = Constant<value_int = 0>()
        D = Gather(S, I)
        F = Cast<to = 1>(D)
        Y = Div(X, F)
    }`;
    let out = generate(source).unwrap();
    assert out.contains("let D = backend.upload(&Tensor::<i64, []> { data: [dim_N], extents: [] });");
    assert out.contains("let F = backend.cast::<i64, f32, []>(&D);");
}

test "a constant folds into the operator that reads it" {
    assert folded_add(0.5).unwrap().contains(
        `let Y = backend.fused::<[N, X1]>([backend.read(X)], &${src(operand(0).binary(BinaryOp::Add, &constant(
            0.5,
        )))});`,
    );
}

test "a constant no Wado literal spells is written as the prelude's constant" {
    assert folded_add(-f32::INFINITY).unwrap().contains("Step::Constant(-f32::INFINITY)");
    assert folded_add(f32::NAN).unwrap().contains("Step::Constant(f32::NAN)");
}

test "a constant with no operator to fold into is a rank-0 literal" {
    let out = emit_graph(&constant_graph(node("Relu", "Y", ["C"]), Rank::Scalar, 0.5)).unwrap();

    assert out.contains("return backend.keep(&Tensor::<f32, []> { data: [0.5 as f32], extents: [] });");
    assert out.contains(`let Y = backend.fused::<[]>([backend.read(&weights.C)], &${unary(UnaryOp::Relu)});`);
    // `Weights::prepare`, `Weights::params`, `Prepared::embedded` and
    // `Params::embedded` each hold it, from one copy of its data: a mask is as
    // large as the context it covers.
    assert out.split("data: [0.5 as f32]").count() == 2;
    assert out.split("C: Kept::C(backend),").count() == 5;
}

test "a one-element constant that raises the output's rank is a tensor, not a folded scalar" {
    let source = `g (float[3] X) => (float[1, 3] Y) <int64[2] S = {1, 1}> {
        C = ConstantOfShape(S)
        Y = Add(X, C)
    }`;
    let out = generate(source).unwrap();

    assert out.contains("return backend.keep(&Tensor::<f32, [Y0, C1]> { data: [0 as f32], extents: [1, 1] });");
    assert out.contains(
        `let Y = backend.fused::<[Y0, X0]>([backend.read_suffix::<[Y0], [X0]>(X), backend.read(&backend.lift::<f32, [Y0, C1], [Y0, X0]>(&weights.C, 2))], &${sum()});`,
    );
}

test "a constant an operator folds is not bound as well" {
    assert !folded_add(0.5).unwrap().contains("let C");
}

test "a folded scalar output is returned as its literal" {
    let graph = constant_graph(node("Relu", "Y", ["X"]), matrix_rank(), 0.5);
    let out = emit_graph(&Graph {
        ..graph,
        outputs: [
            ValueInfo { name: "C", dtype: "float", rank: Rank::Scalar },
        ],
    }).unwrap();

    assert out.contains("return backend.keep(&Tensor::<f32, []> { data: [0.5 as f32], extents: [] });");
    assert out.contains("    return weights.C;\n");
}

test "a folded output of several elements is returned as its literal" {
    let source = `g (float[2, 3] X) => (int64[2] Y) {
        Y = Shape(X)
    }`;
    let out = generate(source).unwrap();

    assert out.contains("return backend.keep(&Tensor::<i64, [Y0]> { data: [2, 3], extents: [2] });");
    assert out.contains("    return weights.Y;\n");
}

test "a folded tensor a Cast names again under its own type is spelled once" {
    let source = `g (float[1, 4] X) => (float[4, 8] Y) <float[16, 8] W, int64[4] Q = {0, 1, 2, 3}> {
        C = Cast<to = 7>(Q)
        E = Gather(W, Q)
        F = Gather(W, C)
        Y = Add(E, F)
    }`;
    let out = generate(source).unwrap();
    assert out.contains("return backend.keep(&Tensor::<i64, [Y0]> { data: [0, 1, 2, 3], extents: [4] });");
    assert !out.contains("C: backend.keep");
    assert out.contains("let F = backend.gather_rhs_rows(&weights.W, &weights.Q);");
}

test "a constant both branches read is held once, where the weights are" {
    let source = `g (bool[1] C, float[2] X) => (float[2] Y) {
        K = Constant<value_floats = [1.0, 2.0]>()
        Y = If <then_branch = t () => (float[2] A) { A = Add(X, K) }, else_branch = e () => (float[2] B) { B = Sub(X, K) }> (C)
    }`;
    let body = generate(source).unwrap();
    // No symbol enters it, so `Prepared` holds it and both branches read it there.
    assert !body.contains("let K = ");
    assert body.split("backend.read(&weights.K)").count() == 3;
}

test "a name only arithmetic spells is read back from its length, after the names that length reads" {
    let source = `g (float["2 * m + n"] V, float["n + 1"] X) => (float["2 * m + n"] Z) { Z = Add(V, V) }`;
    let body = generate(source).unwrap();
    let n = body.find("let dim_n = to_extent((backend.extents_of(X)[0] as i64 - (1))) as i64;").unwrap();
    let m = body.find("let dim_m = to_extent((backend.extents_of(V)[0] as i64 - (dim_n)) / 2) as i64;").unwrap();
    assert n < m;
}

test "a built branch returns each result through yielded, kernels' as it is" {
    let source = `g (bool[1] C, float[2] X) => (float[2] Y) {
        Y = If <then_branch = t () => (float[2] A) { A = Neg(X) }, else_branch = e () => (float[2] B) { B = Relu(X) }> (C)
    }`;
    let body = generate(source).unwrap();
    assert body.contains("return backend.yielded::<f32, [X0]>(&A);");
    assert body.contains("return backend.yielded::<f32, [X0]>(&B);");
    assert body.split("yielded").count() == 3;
}

test "a constant one branch folds is spelled in that branch" {
    let source = `g (bool[1] C, float[2] X) => (float[2] Y) {
        Y = If <then_branch = t () => (float[2] A) { K = Constant<value_floats = [1.0, 2.0]>() A = Add(X, K) }, else_branch = e () => (float[2] B) { B = Neg(X) }> (C)
    }`;
    let body = generate(source).unwrap();
    assert body.find("let K = ").unwrap() > body.find("let Y = if backend.download(C).data[0] {").unwrap();
    assert body.find("let K = ").unwrap() < body.find("} else {").unwrap();
}
