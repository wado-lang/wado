use { EmitError, NameCollision, UnmappedDtype, emit } from "./emit.wado";
use { Attr, Dim, Elements, Graph, Known, Node, Rank, ValueInfo } from "./graph.wado";
use { infer } from "./infer.wado";
use { read } from "./onnx_text.wado";
use { LayoutRule, Schema } from "./schema.wado";

fn rule(pattern: String, axes: List<String>) -> LayoutRule {
    return LayoutRule { pattern, axes };
}

/// The package spec the generated module imports the runtime from.
global RUNTIME: String = "lib:loam";

fn generate(source: String, layout: List<LayoutRule>, fuse: bool = true) -> Result<String, EmitError> {
    let graph = read(&source).unwrap();
    return emit(&graph, &infer(&graph, &Schema { layout }).unwrap(), &RUNTIME, fuse);
}

/// The same two-layer graph at any boundary element type, which is the one
/// thing that changes between the f32 tests and the half precision ones.
fn mlp(dtype: String) -> String {
    return `
mlp (${dtype}[N, 4] X) => (${dtype}[N, 2] Y)
<${dtype}[4, 3] W1, ${dtype}[3] B1, ${dtype}[3, 2] W2, ${dtype}[2] B2>
{
    H = MatMul(X, W1)
    HB = Add(H, B1)
    A = Relu(HB)
    T = MatMul(A, W2)
    Y = Add(T, B2)
}
`;
}

global MLP: String = mlp("float");

fn mlp_layout() -> List<LayoutRule> {
    return [
        rule("X", ["Batch", "In"]),
        rule("W1", ["In", "Hidden"]),
        rule("B1", ["Hidden"]),
        rule("W2", ["Hidden", "Out"]),
        rule("B2", ["Out"]),
    ];
}

test "the generated module imports the runtime from the spec it is given" {
    let out = generate(MLP, mlp_layout()).unwrap();

    assert out.contains("    Tensor,\n");
    assert out.contains("} from \"lib:loam\";\n");
    assert !out.contains("pub fn matmul");
    assert out.contains("pub struct Weights {");
    assert out.contains("pub struct Prepared<Bk: Backend> {");
    assert out.contains("pub fn forward<");
}

test "unfused, the forward pass is one kernel call per operator, each on the backend" {
    let out = generate(MLP, mlp_layout(), false).unwrap();

    assert out.contains(
        "pub fn forward<Bk: Backend>(backend: &mut Bk, X: &Tensor<f32, [Batch, In]>, weights: &Prepared<Bk>) -> Tensor<f32, [Batch, Out]> with _ {",
    );
    assert out.contains("let H = backend.matmul(&X, &weights.W1, null);");
    assert out.contains(
        "let HB = backend.fused::<[Batch, Hidden]>([backend.read(&H), backend.read_suffix::<[Batch], [Hidden]>(&weights.B1)], &operand(0).binary(BinaryOp::Add, &operand(1)));",
    );
    assert out.contains(
        "let A = backend.fused::<[Batch, Hidden]>([backend.read(&HB)], &operand(0).unary(UnaryOp::Relu));",
    );
    assert out.contains("let T = backend.matmul(&A, &weights.W2, null);");
    assert out.contains("return backend.download(&Y);");
}

test "a product takes the elementwise operators after it as its epilogue" {
    let out = generate(MLP, mlp_layout()).unwrap();

    assert out.contains(
        "let A = backend.matmul(&X, &weights.W1, Option::Some(Epilogue { operands: [backend.read_suffix::<[Batch], [Hidden]>(&weights.B1)], op: operand(0).binary(BinaryOp::Add, &operand(1)).unary(UnaryOp::Relu) }));",
    );
    assert out.contains(
        "let Y = backend.matmul(&A, &weights.W2, Option::Some(Epilogue { operands: [backend.read_suffix::<[Batch], [Out]>(&weights.B2)], op: operand(0).binary(BinaryOp::Add, &operand(1)) }));",
    );
    assert !out.contains("let H ");
    assert !out.contains("let HB ");
}

test "an elementwise chain fuses into one kernel, an operand read twice read once" {
    let source = `
g (float[N, 4] X, float[N, 4] Z) => (float[N, 4] Y)
{
    A = Mul(X, X)
    B = Add(A, Z)
    Y = Relu(B)
}
`;
    let out = generate(source, [rule("*", ["Batch", "Feat"])]).unwrap();

    assert out.contains(
        "let Y = backend.fused::<[Batch, Feat]>([backend.read(&X), backend.read(&Z)], &operand(0).binary(BinaryOp::Mul, &operand(0)).binary(BinaryOp::Add, &operand(1)).unary(UnaryOp::Relu));",
    );
}

test "each input is uploaded after the checks that read the host's and the pass begins, and no weight is" {
    let body = generate(MLP, mlp_layout()).unwrap();

    let upload = body.find("let X = backend.upload(X);").unwrap();
    let begun = body.find("backend.begin();").unwrap();
    assert body.find("refuse(input_mismatch(X,").unwrap() < begun < upload;
    let forward = body.find("pub fn forward").unwrap();
    assert !body.substr_bytes(forward, body.len()).contains("upload(&weights"), body;
}

test "the weights become the backend's for every pass where they are prepared" {
    let out = generate(MLP, mlp_layout()).unwrap();

    assert out.contains("    pub W1: Bk::Tensor<f32, [In, Hidden]>,\n");
    assert out.contains(
        "    pub fn prepare<Bk: Backend>(&self, backend: &mut Bk) -> Prepared<Bk> with _ {\n        return Prepared {\n            W1: backend.keep(&self.W1),\n",
    );
}

test "the forward pass checks each input against the graph before any kernel" {
    let out = generate(MLP, mlp_layout()).unwrap();

    let body = out;
    let check = body.find("refuse(input_mismatch(X, \"X\", [\"Batch\", \"In\"], [-1, 4]));").unwrap();
    assert check < body.find("matmul(").unwrap();
}

test "an axis the boundary fixes to one length carries it as a constant" {
    let out = generate(MLP, mlp_layout()).unwrap();

    assert out.contains("impl In {\n    pub const EXTENT: i32 = 4;\n}");
    assert out.contains("impl Out {\n    pub const EXTENT: i32 = 2;\n}");
    assert !out.contains("impl Batch {");
    assert !out.contains("impl Hidden {");
}

test "an axis the boundary gives two lengths carries no constant" {
    let source = `
stretch (float[1, 2] A, float[3, 2] B) => (float[3, 2] Y)
{
    Y = Add(A, B)
}
`;
    let out = generate(source, [
        rule("A", ["Row", "Col"]),
        rule("B", ["Row", "Col"]),
    ]).unwrap();

    assert !out.contains("impl Row {");
    assert out.contains("impl Col {\n    pub const EXTENT: i32 = 2;\n}");
}

test "inputs sharing an axis the graph leaves to the run are checked against each other" {
    let source = `
pair (float[N, 2] A, float[N, 2] B) => (float[N, 2] Y)
{
    Y = Add(A, B)
}
`;
    let out = generate(source, [
        rule("A", ["Batch", "In"]),
        rule("B", ["Batch", "In"]),
    ]).unwrap();

    assert out.contains("refuse(axis_mismatch(\"N\", \"B\", \"Batch\", B.extents[0], \"A\", A.extents[0]));");
    assert !out.contains("axis_mismatch(\"2\"");
}

test "inputs are checked against each other by the symbol, not the axis name" {
    let graph = |b_cols: String| `
outer (float[S, 4] A, float[4, ${b_cols}] B) => (float[S, ${b_cols}] Y)
{
    Y = MatMul(A, B)
}
`;
    let same_symbol = generate(graph("S"), [
        rule("A", ["Row", "Inner"]),
        rule("B", ["Inner", "Col"]),
    ]).unwrap();
    assert same_symbol.contains("refuse(axis_mismatch(\"S\", \"B\", \"Col\", B.extents[1], \"A\", A.extents[0]));");

    let same_name = generate(graph("T"), [
        rule("A", ["Row", "Inner"]),
        rule("B", ["Inner", "Row"]),
    ]).unwrap();
    assert !same_name.contains("axis_mismatch(");
}

test "an input axis whose length the graph spells over a symbol is checked once the symbol is bound" {
    let source = `
cache (float[1, T, 8] P, float[1, 1, 8] N, int64[1, "T + 1"] M) => (float[1, U, 8] Y)
{
    Y = Concat<axis = 1>(P, N)
}
`;
    let out = generate(source, [
        rule("P", ["Batch", "Past", "Dim"]),
        rule("N", ["Batch", "Seq", "Dim"]),
        rule("M", ["Batch", "Total"]),
        rule("Y", ["Batch", "Total", "Dim"]),
    ]).unwrap();

    assert out.contains("refuse(input_mismatch(M, \"M\", [\"Batch\", \"Total\"], [1, -1]));");
    let bound = out.find("let dim_T = P.extents[1] as i64;").unwrap();
    let check = out.find("refuse(extent_mismatch(\"M\", \"Total\", M.extents[1], \"T + 1\", dim_T + 1));").unwrap();
    assert bound < check && check < out.find("concat::<").unwrap();
}

test "a graph of several outputs returns each, in the order it declares them" {
    let source = `
pair (float[N, 2] A) => (float[N, 2] Z, float[N, 2] Y)
{
    Y = Relu(A)
    Z = Neg(A)
}
`;
    let out = generate(source, [rule("*", ["Batch", "In"])]).unwrap();

    assert out.contains(
        "pub struct Outputs {\n    pub Z: Tensor<f32, [Batch, In]>,\n    pub Y: Tensor<f32, [Batch, In]>,\n}",
    );
    assert out.contains(
        "pub fn forward<Bk: Backend>(backend: &mut Bk, A: &Tensor<f32, [Batch, In]>, weights: &Prepared<Bk>) -> Outputs with _ {",
    );
    assert out.contains("return Outputs { Z: backend.download(&Z), Y: backend.download(&Y) };");
}

test "an output that is a graph input is downloaded into the outputs" {
    let source = `
pass (float[N, 2] A) => (float[N, 2] A, float[N, 2] Y)
{
    Y = Relu(A)
}
`;
    let out = generate(source, [rule("*", ["Batch", "In"])]).unwrap();

    assert out.contains("return Outputs { A: backend.download(&A), Y: backend.download(&Y) };");
}

test "the initializers become the weights struct" {
    let out = generate(MLP, mlp_layout()).unwrap();

    assert out.contains("pub struct Weights {");
    assert out.contains("pub W1: Tensor<f32, [In, Hidden]>,");
    assert out.contains("pub B2: Tensor<f32, [Out]>,");
}

test "weights the graph carries become Prepared::embedded" {
    let source = `
bias (float[N, 2] X) => (float[N, 2] Y)
<float[2] B = {1.0, -2.5}>
{
    Y = Add(X, B)
}
`;
    let out = generate(source, [
        rule("X", ["Batch", "In"]),
        rule("B", ["In"]),
    ]).unwrap();

    assert out.contains(
        "impl<Bk: Backend> Prepared<Bk> {\n    /// The weights the graph carries.\n    pub fn embedded(backend: &mut Bk) -> Prepared<Bk> with _ {",
    );
    // 1.0 is 0x3f800000 and -2.5 is 0xc0200000, little-endian.
    assert out.contains(
        "B: backend.keep(&Tensor::<f32, [In]> { data: List::<f32>::from_le_bytes(b\"\\x00\\x00\\x80?\\x00\\x00 \\xc0\"), extents: [2] }),",
    );
}

test "weights the graph lacks are read from a checkpoint by Prepared::load" {
    let out = generate(MLP, mlp_layout()).unwrap();

    assert !out.contains("fn embedded");
    assert out.contains(
        "pub fn load(backend: &mut Bk, checkpoint: &ByteList) -> Result<Prepared<Bk>, LoadError> with _ {",
    );
    assert out.contains("let header = read_checkpoint(checkpoint)?;");
    assert out.contains(
        "W1: backend.keep(&Tensor::<f32, [In, Hidden]> { data: List::<f32>::from_le_bytes(header.payload(checkpoint, &Expected { tensor: \"W1\", dtype: \"F32\", axes: [\"In\", \"Hidden\"], extents: [4, 3], elements: 12, width: 4 })?), extents: [4, 3] }),",
    );
}

test "a graph carrying some weights embeds those and loads the rest" {
    let source = `
bias (float[N, 2] X) => (float[N, 2] Y)
<float[2, 2] W, float[2] B = {1.0, -2.5}>
{
    H = MatMul(X, W)
    Y = Add(H, B)
}
`;
    let out = generate(source, [
        rule("X", ["Batch", "In"]),
        rule("W", ["In", "In"]),
        rule("B", ["In"]),
    ]).unwrap();

    assert out.contains("tensor: \"W\", dtype: \"F32\", axes: [\"In\", \"In\"], extents: [2, 2], elements: 4, width: 4");
    assert out.contains("data: List::<f32>::from_le_bytes(b\"\\x00\\x00\\x80?\\x00\\x00 \\xc0\"), extents: [2] }");
}

test "a tensor name is escaped where the loader spells it" {
    let source = `
quoted (float[2] X) => (float[2] Y)
<float[2] "a\\b">
{
    Y = Add(X, "a\\b")
}
`;
    let out = generate(source, [
        rule("X", ["In"]),
        rule("a\\b", ["In"]),
    ]).unwrap();

    assert out.contains("tensor: \"a\\\\b\",");
}

test "every axis the graph mentions becomes a marker type" {
    let out = generate(MLP, mlp_layout()).unwrap();

    assert out.contains("pub struct Batch {}");
    assert out.contains("pub struct Hidden {}");
}

test "a name a Wado identifier cannot carry is sanitized" {
    let source = `
g (float[N, 2] "/model/input.0") => (float[N, 2] out)
<>
{
    out = Relu("/model/input.0")
}
`;
    let out = generate(source, [rule("*", ["Batch", "Unit"])]).unwrap();

    assert out.contains("backend: &mut Bk, _model_input_0: &Tensor<f32, [Batch, Unit]>");
    assert out.contains(
        "let out = backend.fused::<[Batch, Unit]>([backend.read(&_model_input_0)], &operand(0).unary(UnaryOp::Relu));",
    );
}

test "a graph that returns its own input downloads it" {
    let source = `
g (float[N, 2] X) => (float[N, 2] X)
<>
{
}
`;
    let out = generate(source, [rule("X", ["Batch", "Unit"])]).unwrap();

    assert out.contains("return backend.download(&X);");
}

test "folded tensors of one source keep their own elements, a Cast between them" {
    let source = `g (float[3] X) => (float[3] Y) <int64[3] A = {0, 1, 2}> {
        B = Cast<to = 1>(A)
        C = Identity(B)
        D = Identity(A)
        G = Gather(X, D)
        Y = Add(G, C)
    }`;
    let out = generate(source, [rule("*", ["Item"])]).unwrap();

    assert out.contains("let D = backend.upload(&Tensor::<i64, [Item]> { data: [0, 1, 2]");
    assert out.contains("let C = backend.upload(&Tensor::<f32, [Item]> { data: [0 as f32, 1 as f32, 2 as f32]");
}

test "a length the run would compute past i64 for some input stops the build" {
    let source = `g (float[N, M, 3] X) => (float[?] Y) <int64[1] Flat = {-1}> {
        Y = Reshape(X, Flat)
    }`;
    let layout: List<LayoutRule> = [
        rule("X", ["Batch", "Seq", "Rgb"]),
        rule("Y", ["All"]),
    ];
    let e = generate(source, layout).unwrap_err();
    assert `${e}` == "3 * M * N: the run computes this in i64, and some input carries it past";
}

test "two names that sanitize to one identifier stop the build" {
    let source = `
g (float[N, 2] "a.b", float[N, 2] "a/b") => (float[N, 2] out)
<>
{
    out = Add("a.b", "a/b")
}
`;
    let e = generate(source, [rule("*", ["Batch", "Unit"])]).unwrap_err();

    assert `${e}` == "a/b and a.b both name `a_b`";
}

test "Erf maps each element through the error function" {
    let source = `
g (float[N, 2] X) => (float[N, 2] Y)
<>
{
    Y = Erf(X)
}
`;
    let out = generate(source, [rule("*", ["Batch", "Unit"])]).unwrap();

    assert out.contains("backend.fused::<[Batch, Unit]>([backend.read(&X)], &operand(0).unary(UnaryOp::Erf))");
}

test "an axis of 1 named apart from the one it stretches over is read under the result's axes" {
    let source = `
g (float[N, 1] X, float[N, 4] Z) => (float[N, 4] Y)
<>
{
    Y = Add(X, Z)
}
`;
    let layout: List<LayoutRule> = [
        rule("X", ["Batch", "One"]),
        rule("Z", ["Batch", "Wide"]),
        rule("Y", ["Batch", "Wide"]),
    ];
    let out = generate(source, layout).unwrap();

    assert out.contains(
        "let Y = backend.fused::<[Batch, Wide]>([backend.read(&backend.lift::<f32, [Batch, One], [Batch, Wide]>(&X, 2)), backend.read(&Z)], &operand(0).binary(BinaryOp::Add, &operand(1)));",
    );
}

test "a Where operand whose axis of 1 is named apart is read under the result's axes" {
    let source = `
g (float[N, 1] M, float[N, 4] X, float[N, 4] Z) => (float[N, 4] Y)
{
    C = Cast <to = 9> (M)
    Y = Where(C, X, Z)
}
`;
    let layout: List<LayoutRule> = [
        rule("M", ["Batch", "One"]),
        rule("C", ["Batch", "One"]),
        rule("*", ["Batch", "Wide"]),
    ];
    let out = generate(source, layout).unwrap();

    assert out.contains(
        "let Y = backend.fused::<[Batch, Wide]>([backend.read_condition(&backend.lift::<bool, [Batch, One], [Batch, Wide]>(&C, 2)), backend.read(&X), backend.read(&Z)], &operand(0).select(&operand(1), &operand(2)));",
    );
}

test "an extent-1 axis stretches under the name the other operand gives it" {
    let source = `
g (float[N, 8, 28, 28] X) => (float[N, 8, 28, 28] Y)
<float[8, 1, 1] B>
{
    Y = Add(X, B)
}
`;
    let layout: List<LayoutRule> = [
        rule("X", ["Batch", "Chan", "Row", "Col"]),
        rule("B", ["Chan", "Row", "Col"]),
    ];
    let out = generate(source, layout).unwrap();

    assert out.contains(
        "backend.fused::<[Batch, Chan, Row, Col]>([backend.read(&X), backend.read_suffix::<[Batch], [Chan, Row, Col]>(&weights.B)], &operand(0).binary(BinaryOp::Add, &operand(1)))",
    );
}

test "Reshape relabels the tensor under the merged axis" {
    let source = `
g (float[1, 16, 4, 4] X) => (float[1, 256] Y)
<int64[2] S = {1, 256}>
{
    Y = Reshape(X, S)
}
`;
    let out = generate(source, [rule("X", ["Batch", "Chan", "Row", "Col"])]).unwrap();

    assert out.contains(
        "let Y = backend.reshape::<f32, [Batch, Chan, Row, Col], [Batch, Merged<[Chan, Row, Col]>]>(&X, [1, 256]);",
    );
    assert out.contains("-> Tensor<f32, [Batch, Merged<[Chan, Row, Col]>]> with _ {");
    // A merged axis is spelled with its parts' markers, never declared itself.
    assert out.contains("pub struct Chan {}");
    assert !out.contains("pub struct Merged");
    // The target shape is read at build time, so no weight carries it.
    assert !out.contains("pub S:");
}

test "a shape only the build reads is bound nowhere" {
    let source = `
g (float[1, 16, 4, 4] X, float[1, 256] Z) => (float[1, 256] Y)
{
    S = Shape(Z)
    Y = Reshape(X, S)
}
`;
    let out = generate(source, [
        rule("X", ["Batch", "Chan", "Row", "Col"]),
        rule("Z", ["Batch", "Flat"]),
    ]).unwrap();

    assert !out.contains("let S =");
}

test "a grouped Conv lowers to conv_grouped, naming the weight's channel axis" {
    let source = `
g (float[1, 4, 3, 3] X) => (float[1, 2, 2, 2] Y)
<float[2, 2, 2, 2] W>
{
    Y = Conv <group = 2> (X, W)
}
`;
    let layout: List<LayoutRule> = [
        rule("X", ["Batch", "Chan", "Row", "Col"]),
        rule("W", ["Out", "Share", "KRow", "KCol"]),
        rule("Y", ["Batch", "Out", "ORow", "OCol"]),
    ];
    let out = generate(source, layout).unwrap();

    assert out.contains(
        "let Y = backend.conv_grouped::<Batch, Chan, Share, Out, [Row, Col], [KRow, KCol], [ORow, OCol]>(&X, &weights.W, 2, &Window {",
    );
}

test "a grouped Conv with a bias lowers to conv_grouped_bias" {
    let source = `
g (float[1, 4, 3, 3] X) => (float[1, 2, 2, 2] Y)
<float[2, 2, 2, 2] W, float[2] B>
{
    Y = Conv <group = 2> (X, W, B)
}
`;
    let layout: List<LayoutRule> = [
        rule("X", ["Batch", "Chan", "Row", "Col"]),
        rule("W", ["Out", "Share", "KRow", "KCol"]),
        rule("B", ["Out"]),
        rule("Y", ["Batch", "Out", "ORow", "OCol"]),
    ];
    let out = generate(source, layout).unwrap();

    assert out.contains(
        "let Y = backend.conv_grouped_bias::<Batch, Chan, Share, Out, [Row, Col], [KRow, KCol], [ORow, OCol]>(&X, &weights.W, &weights.B, 2, &Window {",
    );
}

test "Conv and MaxPool lower to their kernels under the window stage 0 read" {
    let source = `
g (float[1, 1, 28, 28] X) => (float[1, 8, 14, 14] Y)
<float[8, 1, 5, 5] W, float[8] B>
{
    C = Conv <kernel_shape = [5, 5], auto_pad = "SAME_UPPER"> (X, W, B)
    Y = MaxPool <kernel_shape = [2, 2], strides = [2, 2]> (C)
}
`;
    let layout: List<LayoutRule> = [
        rule("X", ["Batch", "Chan", "Row", "Col"]),
        rule("W", ["Out", "Chan", "KRow", "KCol"]),
        rule("B", ["Out"]),
        rule("C", ["Batch", "Out", "Row", "Col"]),
        rule("Y", ["Batch", "Out", "PRow", "PCol"]),
    ];
    let out = generate(source, layout).unwrap();

    assert out.contains(
        "let C = backend.conv_bias::<Batch, Chan, Out, [Row, Col], [KRow, KCol], [Row, Col]>(&X, &weights.W, &weights.B, &Window { kernel: [5, 5], strides: [1, 1], dilations: [1, 1], pads: [2, 2, 2, 2], output: [28, 28] }, null);",
    );
    assert out.contains(
        "let Y = backend.max_pool::<Batch, Out, [Row, Col], [PRow, PCol]>(&C, &Window { kernel: [2, 2], strides: [2, 2], dilations: [1, 1], pads: [0, 0, 0, 0], output: [14, 14] });",
    );
}

test "Gemm lowers to a matmul under its transpose flags" {
    let source = `
g (float[2, 3] A, float[4, 3] B, float[4] C) => (float[2, 4] Y)
<>
{
    Y = Gemm <transB = 1, alpha = 0.5, beta = 2.0> (A, B, C)
}
`;
    let layout: List<LayoutRule> = [
        rule("A", ["Batch", "In"]),
        rule("B", ["Out", "In"]),
        rule("C", ["Out"]),
        rule("Y", ["Batch", "Out"]),
    ];
    let out = generate(source, layout).unwrap();

    assert out.contains(
        "let Y = backend.matmul(&A, &backend.transpose2(&B), Option::Some(Epilogue { operands: [backend.read_suffix::<[Batch], [Out]>(&C)], op: operand(0).binary(BinaryOp::Mul, &constant(0.5 as f32)).binary(BinaryOp::Add, &operand(1).binary(BinaryOp::Mul, &constant(2 as f32))) }));",
    );
}

test "Gemm whose scalars are both one and has no bias is its product alone" {
    let source = `
g (float[2, 3] A, float[3, 4] B) => (float[2, 4] Y)
<>
{
    Y = Gemm(A, B)
}
`;
    let layout: List<LayoutRule> = [
        rule("A", ["Batch", "In"]),
        rule("B", ["In", "Out"]),
        rule("Y", ["Batch", "Out"]),
    ];
    let out = generate(source, layout).unwrap();

    assert out.contains("let Y = backend.matmul(&A, &B, null);");
}

test "a rank-2 Transpose lowers to the kernel" {
    let source = `
g (float[2, 3] X) => (float[3, 2] Y)
<>
{
    Y = Transpose <perm = [1, 0]> (X)
}
`;
    let out = generate(source, [rule("*", ["A", "B"])]).unwrap();

    assert out.contains("let Y = backend.permute::<f32, [A, B], [B, A]>(&X, [1, 0]);");
}

test "a Transpose that moves no axis is its operand" {
    let source = `
g (float[2, 3] X) => (float[2, 3] Y)
<>
{
    Y = Transpose <perm = [0, 1]> (X)
}
`;
    let out = generate(source, [rule("*", ["A", "B"])]).unwrap();

    assert !out.contains("permute");
    // Every node result is bound as a value, so the operand is read as one.
    assert out.contains("let Y = X;");
}

test "Where over floats is a kernel's select, a lower-rank operand repeated across the output" {
    let source = `
g (float[1, 1, 4, 4] M, float[2, 3, 4, 4] X) => (float[2, 3, 4, 4] Y)
<float S>
{
    C = Cast<to = 9>(M)
    Y = Where(C, X, S)
}
`;
    let layout: List<LayoutRule> = [
        rule("M", ["Batch", "Head", "Query", "Key"]),
        rule("X", ["Batch", "Head", "Query", "Key"]),
    ];
    let out = generate(source, layout).unwrap();

    assert out.contains(
        "let Y = backend.fused::<[Batch, Head, Query, Key]>([backend.read_condition(&C), backend.read(&X), backend.read_suffix::<[Batch, Head, Query, Key], []>(&weights.S)], &operand(0).select(&operand(1), &operand(2)));",
    );
}

test "a folded Where operand is read as its literal" {
    let source = `
g (float[1, 4] M, float[1, 4] X) => (float[1, 4] Y)
{
    C = Cast<to = 9>(M)
    S = Constant<value_float = -1.0>()
    Y = Where(C, S, X)
}
`;
    let out = generate(source, [rule("*", ["Batch", "Key"])]).unwrap();

    assert out.contains("let S = backend.upload(&Tensor::<f32, []> { data: [-1 as f32], extents: [] });");
    assert out.contains(
        "let Y = backend.fused::<[Batch, Key]>([backend.read_condition(&C), backend.read_suffix::<[Batch, Key], []>(&S), backend.read(&X)], &operand(0).select(&operand(1), &operand(2)));",
    );
}

test "a merged axis the layout writes is spelled with its parts' markers" {
    let source = `
g (float[4, 2, 8] X) => (float[4, 6] Y)
<float[16, 6] W, int64[2] S = {4, 16}>
{
    R = Reshape(X, S)
    Y = MatMul(R, W)
}
`;
    let layout: List<LayoutRule> = [
        rule("X", ["Seq", "Head", "Dim"]),
        rule("W", ["(Head Dim)", "Out"]),
    ];
    let out = generate(source, layout).unwrap();

    assert out.contains("pub W: Tensor<f32, [Merged<[Head, Dim]>, Out]>,");
    assert out.contains("let Y = backend.matmul(&R, &weights.W, null);");
}

test "Split cuts one run along the axis for each output" {
    let source = `
g (float[1, 4, 24] X) => (float[1, 4, 8] K)
{
    S = Constant<value_ints = [8, 8, 8]>()
    Q, K, V = Split<axis = 2>(X, S)
}
`;
    let layout: List<LayoutRule> = [
        rule("X", ["Batch", "Seq", "Qkv"]),
        rule("?", ["Batch", "Seq", "Embed"]),
    ];
    let out = generate(source, layout).unwrap();

    assert out.contains("let Q = backend.slice_axis::<f32, [Batch, Seq], Qkv, Embed, []>(&X, 2, 0, 8, 1);");
    assert out.contains("let K = backend.slice_axis::<f32, [Batch, Seq], Qkv, Embed, []>(&X, 2, 8, 8, 1);");
    assert out.contains("let V = backend.slice_axis::<f32, [Batch, Seq], Qkv, Embed, []>(&X, 2, 16, 8, 1);");
}

test "Concat joins its operands pairwise, each join naming the output's axis" {
    let source = `
g (float[1, T, 8] P, float[1, 1, 8] N) => (float[1, U, 8] Y)
{
    Y = Concat<axis = 1>(P, N, N)
}
`;
    let layout: List<LayoutRule> = [
        rule("P", ["Batch", "Past", "Dim"]),
        rule("N", ["Batch", "Seq", "Dim"]),
        rule("Y", ["Batch", "Total", "Dim"]),
    ];
    let out = generate(source, layout).unwrap();

    assert out.contains(
        "let Y = backend.concat::<f32, [Batch], Total, Seq, Total, [Dim]>(&backend.concat::<f32, [Batch], Past, Seq, Total, [Dim]>(&P, &N, 1), &N, 1);",
    );
}

/// What a softmax along the last axis computes, as the row kernel's `Expr`.
global ROW_SOFTMAX: String = "&operand(0).binary(BinaryOp::Sub, &operand(0).row(RowOp::Max)).unary(UnaryOp::Exp).binary(BinaryOp::Div, &operand(0).binary(BinaryOp::Sub, &operand(0).row(RowOp::Max)).unary(UnaryOp::Exp).row(RowOp::Sum))";

test "Softmax along the last axis lowers to a row kernel" {
    let source = `
g (float[2, 4, 8] X) => (float[2, 4, 8] Y)
{
    Y = Softmax <axis = -1> (X)
}
`;
    let out = generate(source, [rule("X", ["Batch", "Seq", "Embed"])]).unwrap();

    assert out.contains(
        `let Y = backend.rows::<[Batch, Seq, Embed], [Batch, Seq, Embed]>([backend.read(&X)], ${ROW_SOFTMAX}, 1, false);`,
    );
}

test "Softmax along another axis lowers to its kernel" {
    let source = `
g (float[2, 4, 8] X) => (float[2, 4, 8] Y)
{
    Y = Softmax <axis = 1> (X)
}
`;
    let out = generate(source, [rule("X", ["Batch", "Seq", "Embed"])]).unwrap();

    assert out.contains("let Y = backend.softmax(&X, 1);");
}

test "Softmax before opset 13 lowers to the kernel over the axes from its own on" {
    let lowered = |attrs: String| -> String {
        let source = `<ir_version: 7, opset_import: ["" : 11]>
g (float[2, 4, 8] X) => (float[2, 4, 8] Y)
{
    Y = Softmax ${attrs} (X)
}
`;
        return generate(source, [rule("X", ["Batch", "Seq", "Embed"])]).unwrap();
    };

    assert lowered("").contains("let Y = backend.softmax_flattened(&X, 1);");
    // From the last axis on is the last axis alone, a row.
    assert lowered("<axis = 2>").contains("let Y = backend.rows::<");
}

test "arithmetic before opset 7 aligned at an axis reads the shorter operand there" {
    let source = `<ir_version: 3, opset_import: ["" : 6]>
g (float[2, 4, 8] X, float[4] B) => (float[2, 4, 8] Y)
{
    Y = Add <broadcast = 1, axis = 1> (X, B)
}
`;
    let out = generate(source, [
        rule("X", ["Batch", "Seq", "Embed"]),
        rule("B", ["Seq"]),
    ]).unwrap();

    assert out.contains(
        "let Y = backend.fused::<[Batch, Seq, Embed]>([backend.read(&X), backend.read_at::<[Batch], [Seq], [Embed]>(&B, 1)], &operand(0).binary(BinaryOp::Add, &operand(1)));",
    );
}

test "arithmetic before opset 7 aligned at the axis numpy would take lowers as numpy's" {
    let source = `<ir_version: 3, opset_import: ["" : 6]>
g (float[2, 4, 8] X, float[8] B) => (float[2, 4, 8] Y)
{
    Y = Add <broadcast = 1, axis = 2> (X, B)
}
`;
    let out = generate(source, [
        rule("X", ["Batch", "Seq", "Embed"]),
        rule("B", ["Embed"]),
    ]).unwrap();

    assert out.contains(
        "let Y = backend.fused::<[Batch, Seq, Embed]>([backend.read(&X), backend.read_suffix::<[Batch, Seq], [Embed]>(&B)], &operand(0).binary(BinaryOp::Add, &operand(1)));",
    );
}

test "a layer norm's mean is a fold its row kernel reads back over the row" {
    let source = `
g (float[2, 4, 8] X) => (float[2, 4, 8] Y)
{
    M = ReduceMean <axes = [-1]> (X)
    Y = Sub(X, M)
}
`;
    let out = generate(source, [rule("X", ["Batch", "Seq", "Embed"])]).unwrap();

    assert out.contains(
        "let Y = backend.rows::<[Batch, Seq, Embed], [Batch, Seq, Embed]>([backend.read(&X)], &operand(0).binary(BinaryOp::Sub, &operand(0).row(RowOp::Sum).binary(BinaryOp::Div, &constant(8 as f32))), 1, false);",
    );
}

test "a mean alone writes one value per row" {
    let source = `
g (float[2, 4, 8] X) => (float[2, 4, 1] Y)
{
    Y = ReduceMean <axes = [-1]> (X)
}
`;
    let out = generate(source, [rule("X", ["Batch", "Seq", "Embed"])]).unwrap();

    // The output keeps the axis it reduced, at extent 1.
    assert out.contains(
        "let Y = backend.rows::<[Batch, Seq, Embed], [Batch, Seq, Embed]>([backend.read(&X)], &operand(0).row(RowOp::Sum).binary(BinaryOp::Div, &constant(8 as f32)), 1, true);",
    );
}

test "ReduceSum lowers to the summing kernel" {
    let source = `
g (float[2, 4, 8] X) => (float[1, 4, 1] Y)
{
    Y = ReduceSum <axes = [0, 2]> (X)
}
`;
    let out = generate(source, [rule("X", ["Batch", "Seq", "Embed"])]).unwrap();

    assert out.contains("let Y = backend.reduce_sum(&X, [0, 2]);");
}

test "a reduction that drops its axes reshapes the kept ones away" {
    let source = `
g (float[2, 4, 8] X) => (float[2, 4] Y)
{
    Y = ReduceMean <axes = [-1], keepdims = 0> (X)
}
`;
    let out = generate(source, [rule("X", ["Batch", "Seq", "Embed"])]).unwrap();

    assert out.contains(
        "let Y = backend.reshape::<f32, [Batch, Seq, Embed], [Batch, Seq]>(&backend.reduce_mean(&X, [2]), [2, 4]);",
    );
}

fn is_error<E: Error>() {
}

test "every error emit reports is an Error" {
    is_error::<EmitError>();
    is_error::<UnmappedDtype>();
    is_error::<NameCollision>();
}

test "a Transpose of any rank spells both axis orders" {
    let source = `
g (float[1, 4, 2, 3] X) => (float[1, 2, 3, 4] Y)
<>
{
    Y = Transpose <perm = [0, 2, 3, 1]> (X)
}
`;
    let out = generate(source, [rule("X", ["Batch", "Seq", "Head", "Dim"])]).unwrap();

    assert out.contains(
        "let Y = backend.permute::<f32, [Batch, Seq, Head, Dim], [Batch, Head, Dim, Seq]>(&X, [0, 2, 3, 1]);",
    );
}

test "a tensor named as the generated module names something is renamed" {
    let source = `
g (float[N, 2] weights, float[N, 2] narrow) => (float[N, 2] Tensor)
<>
{
    Tensor = Add(weights, narrow)
}
`;
    let out = generate(source, [rule("*", ["Batch", "Unit"])]).unwrap();

    assert out.contains("backend: &mut Bk, weights_: &Tensor<f32, [Batch, Unit]>, narrow_: ");
    assert out.contains(
        "let Tensor_ = backend.fused::<[Batch, Unit]>([backend.read(&weights_), backend.read(&narrow_)],",
    );
    assert out.contains("return backend.download(&Tensor_);");
}

test "a weight named as a method of the weights is renamed" {
    let source = `
g (float[N, 2] X) => (float[N, 2] Y)
<float[2] prepare>
{
    Y = Add(X, prepare)
}
`;
    let out = generate(source, [
        rule("X", ["Batch", "Unit"]),
        rule("Y", ["Batch", "Unit"]),
        rule("prepare", ["Unit"]),
    ]).unwrap();

    assert out.contains("    pub prepare_: Tensor<f32, [Unit]>,\n"), out;
    assert out.contains("pub fn prepare<Bk: Backend>(&self");
}

test "a tensor named as a runtime item the module does not import keeps its name" {
    let source = `
g (float[N, 2] map) => (float[N, 2] Y)
<>
{
    Y = Relu(map)
}
`;
    let out = generate(source, [rule("*", ["Batch", "Unit"])]).unwrap();

    assert out.contains("let Y = backend.fused::<[Batch, Unit]>([backend.read(&map)],");
}

test "a renamed tensor steps past a tensor already named as the renaming would" {
    for let [first, second] of [
        ["refuse", "refuse_"],
        ["refuse_", "refuse"],
    ] as List<[String, String]> {
        let source = `
g (float[N, 2] ${first}, float[N, 2] ${second}) => (float[N, 2] Y)
<>
{
    Y = Add(refuse, refuse_)
}
`;
        let out = generate(source, [rule("*", ["Batch", "Unit"])]).unwrap();

        assert out.contains("let Y = backend.fused::<[Batch, Unit]>([backend.read(&refuse__), backend.read(&refuse_)],");
    }
}

test "two renamed tensors step past each other" {
    let source = `
g (float[1] N, float[1] N_) => (float[1] Y)
<>
{
    Y = Add(N, N_)
}
`;
    let out = generate(source, [
        rule("N", ["N"]),
        rule("N_", ["N_"]),
    ]).unwrap();

    assert out.contains("backend: &mut Bk, N__: &Tensor<f32, [N]>, N___: &Tensor<f32, [N_]>,");
}

test "a tensor named as an axis is renamed too" {
    let source = `
g (float[N, 2] Batch) => (float[N, 2] Y)
<>
{
    Y = Relu(Batch)
}
`;
    let out = generate(source, [rule("*", ["Batch", "Unit"])]).unwrap();

    assert out.contains("pub struct Batch {}");
    assert out.contains("let Y = backend.fused::<[Batch, Unit]>([backend.read(&Batch_)],");
}

test "an axis named as the generated module names something stops the build" {
    let source = `
g (float[N, 2] X) => (float[N, 2] Y)
<>
{
    Y = Relu(X)
}
`;
    let e = generate(source, [rule("*", ["Batch", "Tensor"])]).unwrap_err();

    assert `${e}` == "Tensor: an axis cannot be named as the generated module names something";

    // Every name the module imports from the runtime is reserved, whether or
    // not this graph reads it, and so is what `forward` binds.
    for let name of ["Backend", "UnaryOp", "LoadError", "Bk"] {
        let t = generate(source, [rule("*", ["Batch", name])]).unwrap_err();
        assert `${t}` == `${name}: an axis cannot be named as the generated module names something`;
    }
}

test "a stretch between operands of one rank reads each as it is" {
    let source = `
g (float[2, 1] X, float[2, 4] Z) => (float[2, 4] Y)
<>
{
    Y = Add(X, Z)
}
`;
    let out = generate(source, [rule("*", ["Batch", "Unit"])]).unwrap();

    assert out.contains(
        "backend.fused::<[Batch, Unit]>([backend.read(&X), backend.read(&Z)], &operand(0).binary(BinaryOp::Add, &operand(1)))",
    );
}

