//! The pipeline a Hugging Face `tokenizer.json` writes down, as far as Loam
//! generates one: BPE spelled as GPT-2 spells it, byte-level, or as
//! SentencePiece does, with spaces as `▁` and bytes as `<0xXX>` tokens. Every
//! stage and setting that would change the ids is checked, and one Loam does
//! not generate names itself.

use { HashMap, TreeMap } from "core:collections";
use { from_string } from "core:json";
use { Deserialize, DeserializeError, DeserializeMap, DeserializeSeq, Deserializer, Visitor } from "core:serde";
use { TokenSpelling, byte_chars, byte_token } from "./runtime/tokenizer.wado";

/// A BPE pipeline: the vocabulary, the merges resolved to ids, the added
/// tokens, how text is spelled, and the ids an encoding starts with.
pub struct BpePipeline {
    /// Each token, its id the index.
    pub tokens: List<String>,
    /// Each merge, the lowest rank first: the two ids it joins and the id they
    /// join to.
    pub merges: List<[i32, i32, i32]>,
    /// The added tokens, matched in the text as they stand before it is split.
    pub specials: List<String>,
    pub spelling: TokenSpelling,
    /// The id a character no token or byte spells encodes as, -1 for none.
    pub unknown: i32 = -1,
    /// The ids the post-processor puts before every encoding.
    pub prefix: List<i32> = [],
}

/// Why a `tokenizer.json` is not a pipeline Loam generates.
pub struct TokenizerError {
    message: String,
}

impl Display for TokenizerError {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(&self.message);
    }
}

impl Error for TokenizerError {
}

fn refused<T>(message: String) -> Result<T, TokenizerError> {
    return Result::Err(TokenizerError { message });
}

/// A setting at `at` whose `key` holds `value`, which Loam does not generate.
fn unsupported<T>(at: String, key: String, value: String) -> Result<T, TokenizerError> {
    return refused(`${at}: ${key} ${value} is not supported`);
}

/// What Loam reads of a `tokenizer.json`. A key it names no field for is
/// skipped, and a field absent from the file holds the value that changes
/// nothing.
struct TokenizerFile {
    added_tokens: List<AddedToken> = [],
    normalizer: Option<Normalizer> = null,
    pre_tokenizer: Option<PreTokenizer> = null,
    post_processor: Option<PostProcessor> = null,
    decoder: Option<Decoder> = null,
    model: Model,
    truncation: Option<Setting> = null,
    padding: Option<Setting> = null,
}

/// A stage Loam generates nothing for, whatever it holds.
struct Setting {
}

struct AddedToken {
    id: i32,
    content: String,
    single_word: bool = false,
    lstrip: bool = false,
    rstrip: bool = false,
    normalized: bool = false,
}

struct Model {
    /// Absent from the older files, which write only BPE.
    #[wire(name = "type")]
    kind: String = "BPE",
    vocab: Option<TreeMap<String, i32>> = null,
    merges: Option<List<Merge>> = null,
    dropout: Option<f64> = null,
    continuing_subword_prefix: Option<String> = null,
    end_of_word_suffix: Option<String> = null,
    ignore_merges: bool = false,
    unk_token: Option<String> = null,
    fuse_unk: bool = false,
    byte_fallback: bool = false,
}

/// The two tokens a merge joins.
struct Merge {
    left: String,
    right: String,
}

#[wire(tag = "type")]
variant Normalizer {
    Replace(Replace),
}

#[wire(tag = "type")]
variant PreTokenizer {
    ByteLevel(ByteLevel),
}

#[wire(tag = "type")]
variant Decoder {
    ByteLevel(ByteLevel),
    Sequence(DecoderSequence),
}

#[wire(tag = "type")]
variant DecodeStep {
    Replace(Replace),
    ByteFallback,
    Fuse,
}

#[wire(tag = "type")]
variant PostProcessor {
    ByteLevel(ByteLevel),
    TemplateProcessing(Template),
}

struct ByteLevel {
    add_prefix_space: bool = false,
    use_regex: bool = true,
}

struct Replace {
    pattern: ReplacePattern,
    content: String,
}

variant ReplacePattern {
    String(String),
    Regex(String),
}

struct DecoderSequence {
    decoders: List<DecodeStep>,
}

struct Template {
    single: List<TemplatePiece> = [],
}

variant TemplatePiece {
    SpecialToken(TemplateId),
    Sequence(TemplateId),
}

struct TemplateId {
    id: String,
}

/// The pipeline `text`, a `tokenizer.json`, writes down.
pub fn read(text: &String) -> Result<BpePipeline, TokenizerError> {
    let file = match from_string::<TokenizerFile>(text) {
        Ok(file) => file,
        Err(e) => {
            return refused(`${e}`);
        },
    };
    if file.truncation matches { Some(_) } {
        return refused("truncation is not supported");
    }
    if file.padding matches { Some(_) } {
        return refused("padding is not supported");
    }
    let spelling = spelling_of(&file)?;
    let model = file.model;
    if model.kind != "BPE" {
        return refused(`model: ${model.kind} is not supported`);
    }
    if let Some(dropout) = model.dropout {
        return unsupported("model", "dropout", `${dropout}`);
    }
    for let [key, affix] of [
        ["continuing_subword_prefix", model.continuing_subword_prefix],
        ["end_of_word_suffix", model.end_of_word_suffix],
    ] as List<[String, Option<String>]> {
        // An empty string and none mean the same affix.
        if let Some(affix) = affix && affix != "" {
            return unsupported("model", key, affix);
        }
    }
    if model.ignore_merges {
        return unsupported("model", "ignore_merges", "true");
    }
    let pieces = spelling matches { Pieces };
    if !pieces {
        if let Some(unknown) = model.unk_token {
            return unsupported("model", "unk_token", unknown);
        }
        if model.fuse_unk {
            return unsupported("model", "fuse_unk", "true");
        }
        if model.byte_fallback {
            return unsupported("model", "byte_fallback", "true");
        }
    } else if !model.fuse_unk && model.unk_token matches { Some(_) } {
        return refused("model: an unknown token that does not fuse is not supported");
    }
    let Some(vocab) = model.vocab else {
        return refused("model: no vocab");
    };
    let mut tokens = tokens_of(&vocab)?;
    let specials = specials_of(&file.added_tokens, &vocab, &mut tokens, pieces)?;
    let mut ids = HashMap::<String, i32>::new();
    for let [id, token] of tokens.into_iter().enumerate() {
        ids.try_insert(token, id);
    }
    let Some(merges) = model.merges else {
        return refused("model: no merges");
    };
    let mut pipeline = BpePipeline { tokens, merges: merges_of(&merges, &ids)?, specials, spelling };
    if pieces {
        if !model.byte_fallback {
            return refused("model: SentencePiece's spelling without byte_fallback is not supported");
        }
        for let b of 0..<256 {
            id_of(&ids, &byte_token(b), "model: the byte token")?;
        }
        if let Some(unknown) = model.unk_token {
            pipeline.unknown = id_of(&ids, &unknown, "model: the unknown token")?;
        }
        pipeline.prefix = prefix_of(&file.post_processor, &ids)?;
    } else {
        spelled_in_bytes(&pipeline, &ids)?;
    }
    return Result::Ok(pipeline);
}

/// The spelling the normalizer, pre-tokenizer and decoder write down together:
/// GPT-2's byte level, or SentencePiece's spaces as `▁`.
fn spelling_of(file: &TokenizerFile) -> Result<TokenSpelling, TokenizerError> {
    let Some(normalizer) = file.normalizer else {
        let Some(ByteLevel(pre)) = file.pre_tokenizer else {
            return refused("pre_tokenizer: none is not supported");
        };
        if pre.add_prefix_space {
            return unsupported("pre_tokenizer", "add_prefix_space", "true");
        }
        if !pre.use_regex {
            return unsupported("pre_tokenizer", "use_regex", "false");
        }
        if !file.decoder matches { Some(ByteLevel(_)) } {
            return refused(`decoder: ${kind_of(&file.decoder)} is not supported`);
        }
        // Only offsets depend on it, which Loam does not compute.
        if file.post_processor matches { Some(TemplateProcessing(_)) } {
            return refused(`post_processor: ${kind_of(&file.post_processor)} is not supported`);
        }
        return Result::Ok(TokenSpelling::ByteLevel);
    };
    let Replace(replace) = normalizer;
    if !is_space_replacement(&replace, " ", "▁") {
        return refused(`normalizer: ${kind_of(&file.normalizer)} is not supported`);
    }
    if file.pre_tokenizer matches { Some(_) } {
        return refused(`pre_tokenizer: ${kind_of(&file.pre_tokenizer)} is not supported`);
    }
    let Some(Sequence(sequence)) = file.decoder else {
        return refused(`decoder: ${kind_of(&file.decoder)} is not supported`);
    };
    let steps = sequence.decoders;
    if !(steps.len() == 3
        && steps[0] matches { Replace(r) && is_space_replacement(&r, "▁", " ") }
        && steps[1] matches { ByteFallback }
        && steps[2] matches { Fuse }) {
        let kinds: List<String> = steps.into_iter().map(|s| case_name(&s)).collect();
        return refused(`decoder: ${kinds.join(", ")} is not supported`);
    }
    return Result::Ok(TokenSpelling::Pieces);
}

/// Whether `replace` replaces the string `pattern` by `content`.
fn is_space_replacement(replace: &Replace, pattern: String, content: String) -> bool {
    return replace.pattern matches { String(p) && p == pattern } && replace.content == content;
}

/// How `stage` reads in a refusal: its type, or none.
fn kind_of<V: ReflectVariant<CasePayloads = [..P]>, ..P>(stage: &Option<V>) -> String {
    return match *stage {
        Some(given) => case_name(&given),
        None => "none",
    };
}

/// The name of the case `value` holds.
fn case_name<V: ReflectVariant<CasePayloads = [..P]>, ..P>(value: &V) -> String {
    for let case of ReflectVariant::<V>::members() {
        if case.holds(value) {
            return case.name();
        }
    }
    unreachable();
}

/// That the vocabulary spells every byte and every token but an added one is
/// written in the byte alphabet: what `ByteLevel` encodes and decodes by.
fn spelled_in_bytes(pipeline: &BpePipeline, ids: &HashMap<String, i32>) -> Result<(), TokenizerError> {
    let alphabet = byte_chars();
    for let c of alphabet {
        if !ids.contains_key(String::from(c)) {
            return refused(`model: the vocabulary has no token for the byte ${c}`);
        }
    }
    for let token of pipeline.tokens {
        if pipeline.specials.contains(&token) {
            continue;
        }
        if let Some(c) = token.chars().find(|c| !alphabet.contains(&c)) {
            return refused(`model: ${token} holds ${c}, which no byte is spelled as`);
        }
    }
    return Result::Ok(());
}

/// The ids a `TemplateProcessing` puts before a single sequence. Only special
/// tokens before it are supported, as a beginning-of-sequence token is.
fn prefix_of(processor: &Option<PostProcessor>, ids: &HashMap<String, i32>) -> Result<List<i32>, TokenizerError> {
    let Some(processor) = *processor else {
        return Result::Ok([]);
    };
    let TemplateProcessing(template) = processor else {
        return refused(`post_processor: ${case_name(&processor)} is not supported`);
    };
    let mut prefix: List<i32> = [];
    for let [i, piece] of template.single.into_iter().enumerate() {
        match piece {
            Sequence(sequence) => {
                if i != template.single.len() - 1 || sequence.id != "A" {
                    return refused("post_processor: only special tokens before the sequence are supported");
                }
                return Result::Ok(prefix);
            },
            SpecialToken(special) => {
                prefix.push(id_of(ids, &special.id, "post_processor: the special token")?);
            },
        }
    }
    return refused("post_processor: the single template holds no sequence");
}

fn id_of(ids: &HashMap<String, i32>, token: &String, what: String) -> Result<i32, TokenizerError> {
    return match ids.get(*token) {
        Some(id) => Result::Ok(id),
        None => refused(`${what} ${*token} is not in the vocabulary`),
    };
}

/// The tokens of `vocab`, in id order.
fn tokens_of(vocab: &TreeMap<String, i32>) -> Result<List<String>, TokenizerError> {
    let mut tokens = List::<String>::filled(vocab.len(), "");
    let mut seen = List::<bool>::filled(vocab.len(), false);
    for let [token, id] of vocab.entries() {
        if *id < 0 || *id >= vocab.len() {
            return refused(`model: ${*token} has no id below ${vocab.len()}`);
        }
        if seen[*id] {
            return refused(`model: id ${*id} names two tokens`);
        }
        // The generated tokenizer separates its tokens by NUL.
        if token.contains("\0") {
            return refused(`model: token ${*id} holds a NUL`);
        }
        seen[*id] = true;
        tokens[*id] = *token;
    }
    return Result::Ok(tokens);
}

/// Each merge as the ids it joins and joins to.
fn merges_of(merges: &List<Merge>, ids: &HashMap<String, i32>) -> Result<List<[i32, i32, i32]>, TokenizerError> {
    let mut resolved: List<[i32, i32, i32]> = [];
    for let { left, right } of *merges {
        let mut joined: List<i32> = [];
        for let part of [left, right, `${left}${right}`] {
            let Some(id) = ids.get(part) else {
                return refused(`model: merge ${left} ${right} names ${part}, which the vocabulary lacks`);
            };
            joined.push(id);
        }
        resolved.push([joined[0], joined[1], joined[2]]);
    }
    return Result::Ok(resolved);
}

/// The added tokens, each matched as it stands, which must not wait for a
/// normalizer where `normalizes`. One past the vocabulary's end extends it;
/// any other must be the vocabulary's own token of its id.
fn specials_of(
    added: &List<AddedToken>,
    vocab: &TreeMap<String, i32>,
    tokens: &mut List<String>,
    normalizes: bool,
) -> Result<List<String>, TokenizerError> {
    let mut specials: List<String> = [];
    for let token of *added {
        let at = `added_tokens: ${token.content}`;
        for let [key, set] of [
            ["single_word", token.single_word],
            ["lstrip", token.lstrip],
            ["rstrip", token.rstrip],
        ] as List<[String, bool]> {
            if set {
                return unsupported(at, key, "true");
            }
        }
        // The runtime matches an added token against the text as written.
        if normalizes && token.normalized {
            return unsupported(at, "normalized", "true");
        }
        let own = vocab.get(token.content);
        if own matches { None } && token.id == tokens.len() {
            tokens.push(token.content);
        } else if own != Option::Some(token.id) {
            let given = match own {
                Some(id) => `${id}`,
                None => "none",
            };
            return refused(`${at} is id ${token.id}, and the vocabulary gives it ${given}`);
        }
        specials.push(token.content);
    }
    return Result::Ok(specials);
}

/// A merge, which the older files write as `"left right"` and the newer as a
/// pair.
impl Deserialize for Merge {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<Merge, DeserializeError> {
        return d.deserialize_any(&mut MergeVisitor {});
    }
}

struct MergeVisitor {
}

impl MergeVisitor {
    fn neither<T>(&self) -> Result<T, DeserializeError> {
        return Result::Err(DeserializeError::unexpected_type("a merge is a string or a pair"));
    }
}

impl Visitor for MergeVisitor {
    type Value = Merge;

    fn visit_string<S: AsStrSlice>(&mut self, v: S) -> Result<Merge, DeserializeError> {
        let merge = v.as_str_slice();
        let Some([left, right]) = merge.split_once(" ") else {
            return Result::Err(DeserializeError::invalid_value(`merge ${merge} is not two tokens`));
        };
        return Result::Ok(Merge { left: left.to_string(), right: right.to_string() });
    }

    fn visit_seq<A: DeserializeSeq>(&mut self, seq: &mut A) -> Result<Merge, DeserializeError> {
        let Some(left) = seq.next_element::<String>()? else {
            return self.neither();
        };
        let Some(right) = seq.next_element::<String>()? else {
            return self.neither();
        };
        if seq.next_element::<String>()? matches { Some(_) } {
            return self.neither();
        }
        seq.end()?;
        return Result::Ok(Merge { left, right });
    }

    fn visit_null(&mut self) -> Result<Merge, DeserializeError> {
        return self.neither();
    }

    fn visit_bool(&mut self, v: bool) -> Result<Merge, DeserializeError> {
        return self.neither();
    }

    fn visit_f64(&mut self, v: f64) -> Result<Merge, DeserializeError> {
        return self.neither();
    }

    fn visit_map<A: DeserializeMap>(&mut self, map: &mut A) -> Result<Merge, DeserializeError> {
        return self.neither();
    }
}
