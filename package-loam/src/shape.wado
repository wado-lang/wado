//! A tensor's axes as stage 0 sees them, and the extent conditions each
//! operation owes before it can emit anything.

use { Extent } from "./extent.wado";
use { Poly } from "./poly.wado";

/// Whether a regrouping that has consumed `consumed` elements per step must
/// take another part to reach `produced`: fewer, where both are numbers, and a
/// proper divisor, where a symbol leaves no order to compare by.
fn short_of(consumed: &Poly, produced: &Poly) -> bool {
    if let Some(a) = consumed.as_constant() && let Some(b) = produced.as_constant() {
        return a < b;
    }
    return *consumed != *produced && produced.divided_by(consumed) matches { Some(_) };
}

/// One axis: the identity the type layer carries, paired with the length it
/// cannot. See WEP 2026-09-20 § "Axis Identity Is a Type, Extents Are Values".
pub struct Axis {
    pub name: String,
    pub extent: Extent,
    /// The axes a merge put side by side, in order; empty for an axis of its own.
    pub parts: List<Axis> = [],
}

impl Axis {
    /// One axis standing for `parts`, named as the generated module spells it.
    /// See WEP 2026-09-20 § "A Regrouped Axis Is Named by Its Parts".
    pub fn merged(parts: List<Axis>, extent: Extent) -> Axis {
        assert parts.len() >= 2;
        let mut names: List<String> = [];
        for let p of parts {
            names.push(p.name);
        }
        return Axis {
            name: `Merged<[${names.join(", ")}]>`,
            extent,
            parts,
        };
    }

    /// The axis a layout names: a plain name, or `(A B)` for a merge of `A` and
    /// `B`, whose parts' extents the layout does not say.
    pub fn named(name: &String, extent: Extent) -> Axis {
        if !(name.starts_with("(") && name.ends_with(")")) {
            return Axis { name: *name, extent };
        }
        let inner = name.as_str_slice().slice(1, name.len() - 1);
        let mut parts: List<Axis> = [];
        for let part of inner.split_whitespace() {
            parts.push(Axis {
                name: part.to_string(),
                extent: Extent::Unstated,
            });
        }
        if parts.len() == 1 {
            return Axis { name: parts[0].name, extent };
        }
        return Axis::merged(parts, extent);
    }

    /// The extent of an axis the caller has already shown static.
    pub fn static_extent(&self) -> i32 {
        let Static(e) = self.extent else {
            unreachable();
        };
        return e;
    }
}

pub struct Shape {
    pub axes: List<Axis>,
}

/// Two axes an operation needs to be one length are not. Both extents are
/// carried, so the diagnostic names each.
pub struct ExtentConflict {
    pub op: String,
    pub axis: String,
    pub left: Extent,
    pub right: Extent,
}

impl Display for ExtentConflict {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(
            `${self.op}: axis ${self.axis} is ${self.left} on the left and ${self.right} on the right`,
        );
    }
}

impl Error for ExtentConflict {
}

impl Shape {
    pub fn rank(&self) -> i32 {
        return self.axes.len();
    }

    /// Every extent, for an operator that reads them as static. `Err` names
    /// the first axis that is not, and `reader`.
    pub fn static_extents(&self, reader: &String) -> Result<List<i32>, String> {
        let mut extents: List<i32> = [];
        for let axis of self.axes {
            let Static(e) = axis.extent else {
                return Result::Err(`axis ${axis.name} is ${axis.extent}, and ${*reader} reads static extents`);
            };
            extents.push(e);
        }
        return Result::Ok(extents);
    }

    /// Every extent, for a regrouping, which reads a merged axis's parts as
    /// well. `Err` names the first one nothing states, and `reader`.
    pub fn extents(&self, reader: &String) -> Result<List<Extent>, String> {
        let mut extents: List<Extent> = [];
        for let axis of self.axes {
            let mut read = [axis] as List<Axis>;
            read.extend(&axis.parts);
            for let a of read {
                if !a.extent.is_stated() {
                    return Result::Err(`axis ${a.name} has no stated extent, and ${*reader} reads it`);
                }
            }
            extents.push(axis.extent);
        }
        return Result::Ok(extents);
    }

    /// The same axes in the order `perm` names, as `Transpose` does.
    pub fn permute(&self, perm: &List<i32>) -> Shape {
        assert perm.len() == self.rank();
        let mut axes: List<Axis> = [];
        for let p of *perm {
            axes.push(self.axes[p]);
        }
        return Shape { axes };
    }

    /// `Reshape` onto `targets`, once `extents` has shown every part stated:
    /// each output axis is the run of parts it spans, merged where several, or
    /// `None` where no regrouping determines it.
    pub fn regroup(&self, targets: &List<Extent>) -> List<Option<Axis>> {
        let parts = self.parts();
        let mut out: List<Option<Axis>> = [];
        let mut next = 0;
        let mut consumed = Poly::constant(1);
        let mut produced = Poly::constant(1);
        for let target of *targets {
            let aligned = consumed == produced;
            produced = produced.mul(&target.poly());
            if target.is_one() {
                let takes_unit = aligned && next < parts.len() && parts[next].extent.is_one();
                out.push(if takes_unit { Option::Some(parts[next]) } else { null });
                if takes_unit {
                    next += 1;
                }
                continue;
            }
            let mut run: List<Axis> = [];
            while next < parts.len() && short_of(&consumed, &produced) {
                consumed = consumed.mul(&parts[next].extent.poly());
                if !parts[next].extent.is_one() {
                    run.push(parts[next]);
                }
                next += 1;
            }
            if !aligned || consumed != produced {
                out.push(null);
            } else if run.len() == 1 {
                out.push(Option::Some(run[0]));
            } else {
                out.push(Option::Some(Axis::merged(run, target)));
            }
        }
        return out;
    }

    /// The axes with each merged one replaced by the parts it was made of.
    /// `extents` has shown every part stated.
    fn parts(&self) -> List<Axis> {
        let mut parts: List<Axis> = [];
        for let axis of self.axes {
            if axis.parts.is_empty() {
                parts.push(axis);
            } else {
                parts.extend(&axis.parts);
            }
        }
        return parts;
    }

    /// The axis `back` positions from the end, `0` being the last.
    pub fn from_end(&self, back: i32) -> &Axis {
        assert 0 <= back < self.rank();
        return &self.axes[self.rank() - 1 - back];
    }

    /// Elementwise over two operands under ONNX's multidirectional
    /// broadcasting, which every unary operation is the one-operand case of.
    pub fn elementwise(&self, other: &Shape, op: String) -> Result<Shape, ExtentConflict> {
        let axes = Shape::broadcast(&self.axes, &other.axes, &op)?;
        return Result::Ok(Shape { axes });
    }

    /// `MatMul` as ONNX defines it, which is numpy's: the batch axes broadcast,
    /// and a rank-1 operand is a matrix whose missing axis the result drops.
    pub fn matmul(&self, rhs: &Shape, op: String) -> Result<Shape, ExtentConflict> {
        assert self.rank() >= 1 && rhs.rank() >= 1;

        let right_k = if rhs.rank() == 1 { rhs.from_end(0) } else { rhs.from_end(1) };
        Shape::agree(self.from_end(0), right_k, &op)?;

        let mut axes = Shape::broadcast(&self.batch_axes(), &rhs.batch_axes(), &op)?;
        if self.rank() >= 2 {
            axes.push(*self.from_end(1));
        }
        if rhs.rank() >= 2 {
            axes.push(*rhs.from_end(0));
        }
        return Result::Ok(Shape { axes });
    }

    /// The axes ahead of the matrix a `MatMul` operand ends in. A rank-1
    /// operand is all matrix.
    fn batch_axes(&self) -> List<Axis> {
        let mut axes: List<Axis> = [];
        for let mut i = 0; i < self.rank() - 2; i += 1 {
            axes.push(self.axes[i]);
        }
        return axes;
    }

    /// Align two axis lists from the end and take, at each position, the axis
    /// the other cannot override: a missing axis or an extent of 1 yields.
    fn broadcast(left: &List<Axis>, right: &List<Axis>, op: &String) -> Result<List<Axis>, ExtentConflict> {
        let rank = i32::max(left.len(), right.len());
        let mut axes: List<Axis> = [];
        for let mut i = 0; i < rank; i += 1 {
            let li = i - (rank - left.len());
            let ri = i - (rank - right.len());
            if li < 0 {
                axes.push(right[ri]);
            } else if ri < 0 {
                axes.push(left[li]);
            } else if left[li].extent.is_one() {
                axes.push(right[ri]);
            } else if right[ri].extent.is_one() {
                axes.push(left[li]);
            } else {
                Shape::agree(&left[li], &right[ri], op)?;
                axes.push(left[li]);
            }
        }
        return Result::Ok(axes);
    }

    /// Discharge the one condition an operation places on a pair of axes. What
    /// stage 0 cannot prove is an error, as no runtime tier re-checks it.
    pub fn agree(left: &Axis, right: &Axis, op: &String) -> Result<(), ExtentConflict> {
        if left.extent.agrees(&right.extent) {
            return Result::Ok(());
        }
        builtin::cold_path();
        return Result::Err(ExtentConflict {
            op: *op,
            axis: left.name,
            left: left.extent,
            right: right.extent,
        });
    }
}
