//! The names the generated module binds before it names anything the graph
//! brings. See WEP 2026-09-20 § "Every Name Is Minted From One Set".

use { NameRegistry } from "wado-lang:wadopoet";

/// The type parameter `build` takes its backend as.
pub global BACKEND_PARAM: String = "Bk";

/// The type parameter `load` takes its weight source as.
pub global SOURCE_PARAM: String = "Src";

/// The struct `build` returns several outputs in, as the backend holds them.
pub global PASSED: String = "Passed";

/// The struct `compute` returns several outputs in, on the host.
pub global OUTPUTS: String = "Outputs";

/// The struct `build` reads the weights from, each a tensor of the graph.
pub global PARAMS: String = "Params";

/// The struct `build` reads the valid lengths from.
pub global LENGTHS: String = "Lengths";

/// The struct `build` reads the branch each `If` takes from, where the host
/// holds its condition.
pub global CHOSEN: String = "Chosen";

/// The struct a decoder's state crosses from one pass to the next in.
pub global CACHE: String = "Cache";

/// The struct holding the weights and the programs a backend compiled.
pub global MODEL: String = "Model";

/// The function recording `build` for a backend to compile.
pub global RECORDED: String = "recorded";

/// The function giving the extents `recorded` takes at the least lengths.
pub global LEAST_EXTENTS: String = "least_extents";

/// The decoding entry, which runs `DECODED`'s program.
pub global DECODE: String = "decode";

/// `DECODE` at each row's own past.
pub global DECODE_ROWS: String = "decode_rows";

/// The requests that decode side by side, a slot each, over `DECODE_ROWS`.
pub global REQUESTS: String = "Requests";

/// What `DECODE` returns.
pub global DECODED_TYPE: String = "Decoded";

/// `build`'s steps around a sampler.
pub global DECODED: String = "decoded";

/// `DECODED` recorded for a backend to compile.
pub global RECORDED_DECODED: String = "recorded_decoded";

/// What the generated module imports from the runtime: every name its code
/// spells, whether or not one graph's code reads it.
pub global RUNTIME_NAMES: List<String> = [
    "Any", "Attention", "Backend", "Binary", "Convolution", "Cpu", "Decoding", "DotDims", "ElementKind", "Expected",
    "ExpertBytes", "ExpertLayout", "Experts", "GatherDims", "Graph", "HeldExperts", "Holds", "HostWeight", "LoadError",
    "Merged", "One", "Picks", "Programs", "Quantized", "Recorded", "Recorder", "Sampler", "Sampling", "Slots",
    "StoredExperts", "Tensor", "Unary", "Unread", "Untyped", "WeightSource", "WindowReduce", "assembled",
    "axis_mismatch", "branched", "capacity_of", "erased_fields", "expect_holds", "expect_len", "extent_mismatch",
    "extents_mismatch", "fitted", "fitted_fields", "from_end", "from_end_indices", "full", "input_mismatch", "joined_at",
    "lifted", "masked", "mixture_of_experts", "opened", "payload_at", "quotient", "range_i64", "read_headers",
    "recorded_fields", "reduce_mean", "refuse", "resized", "restored_fields", "retain_fields", "row_binary",
    "row_from_end", "row_quotient", "row_range", "scalar", "shared", "softmax", "softmax_flattened", "stepped",
    "strided_gather", "to_extent", "typed", "unmet", "written_at", "written_fields", "zeroed_fields",
];

/// A registry of the names the generated module binds beyond the language's
/// own.
pub fn module_names() -> NameRegistry {
    let mut reserved = NameRegistry::new();
    for let name of RUNTIME_NAMES {
        reserved.bind(name);
    }
    reserved.bind("build");
    reserved.bind("compute");
    reserved.bind(LENGTHS);
    reserved.bind("lengths");
    reserved.bind(CHOSEN);
    reserved.bind("chosen");
    reserved.bind(PARAMS);
    reserved.bind("params");
    reserved.bind(OUTPUTS);
    reserved.bind(PASSED);
    reserved.bind("weights");
    reserved.bind("Weights");
    reserved.bind(CACHE);
    reserved.bind("cache");
    reserved.bind(MODEL);
    reserved.bind("model");
    reserved.bind(RECORDED);
    reserved.bind(LEAST_EXTENTS);
    reserved.bind(DECODE);
    reserved.bind(DECODE_ROWS);
    reserved.bind(REQUESTS);
    reserved.bind(DECODED_TYPE);
    reserved.bind(DECODED);
    reserved.bind(RECORDED_DECODED);
    // The parameters and locals the entries and what they record bind.
    for let name of [
        "all", "at", "capacity", "decoding", "ended", "extents", "finished", "ids", "last", "mask", "moved", "next",
        "open", "passed", "past", "pasts", "presents", "recorder", "results", "returned", "room", "rows", "sampler",
        "sampling", "slot", "slots", "start", "state", "step", "steps", "token", "tokens",
    ] as List<String> {
        reserved.bind(name);
    }
    // The methods `Weights`, `Params` and `Cache` carry, which a
    // field must not share.
    reserved.bind("empty");
    reserved.bind("load");
    reserved.bind("embedded");
    reserved.bind("held");
    reserved.bind("embedded_data");
    // What a graph whose experts are pooled declares and binds besides.
    for let name of ["budget", "embedded_within", "expert_layouts", "experts", "loaded", "pools", "source"] as List<String> {
        reserved.bind(name);
    }
    reserved.bind("backend");
    reserved.bind(BACKEND_PARAM);
    reserved.bind(SOURCE_PARAM);
    return reserved;
}
