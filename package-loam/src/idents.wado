//! The names the generated module binds before it names anything the graph
//! brings. See WEP 2026-09-20 § "Every Name Is Minted From One Set".

use { HashSet } from "core:collections";
use { is_reserved } from "lib:wadopoet";

/// The type parameter `build` takes its backend as.
pub global BACKEND_PARAM: String = "Bk";

/// The type parameter `load` takes its checkpoint's bytes as.
pub global CHECKPOINT_PARAM: String = "Ck";

/// The struct `build` returns several outputs in, as the backend holds them.
pub global PASSED: String = "Passed";

/// The struct `compute` returns several outputs in, on the host.
pub global OUTPUTS: String = "Outputs";

/// The struct `build` reads the weights from, each a tensor of the graph.
pub global PARAMS: String = "Params";

/// The struct `build` reads the valid lengths from.
pub global LENGTHS: String = "Lengths";

/// The struct `build` reads the branch each `If` takes from, where the host
/// holds its condition.
pub global CHOSEN: String = "Chosen";

/// The struct a decoder's state crosses from one pass to the next in.
pub global CACHE: String = "Cache";

/// The struct holding the weights and the programs a backend compiled.
pub global MODEL: String = "Model";

/// The function recording `build` for a backend to compile.
pub global RECORDED: String = "recorded";

/// The function giving the extents `recorded` takes at the least lengths.
pub global LEAST_EXTENTS: String = "least_extents";

/// The functions the constructor of `Params` keeps each folded literal with.
pub global KEPT: String = "Kept";

/// The decoding entry, which runs `DECODED`'s program.
pub global DECODE: String = "decode";

/// What `DECODE` returns.
pub global DECODED_TYPE: String = "Decoded";

/// `build`'s steps around a sampler, for `Cpu`, which compiles no program.
pub global DECODED: String = "decoded";

/// `DECODED` recorded for a backend to compile.
pub global RECORDED_DECODED: String = "recorded_decoded";

/// The map a sharded `load` takes the shards in, keyed by file name.
pub global MAP: String = "HashMap";

/// What the generated module imports from the runtime: every name its code
/// spells, whether or not one graph's code reads it.
pub global RUNTIME_NAMES: List<String> = [
    "Any", "Attention", "Binary", "CheckpointBytes", "Convolution", "Cpu", "Decoding", "DotDims", "Expected",
    "GatherDims", "Graph", "Holds", "LoadError", "Merged", "One", "Picks", "Programs", "Recorded", "Recorder", "Sampler",
    "Sampling", "Slots", "Tensor", "Unary", "Untyped", "WindowReduce", "assembled", "axis_mismatch", "bool_host",
    "bool_of", "branched", "capacity_of", "expect_len", "extent_mismatch", "extents_mismatch", "f32_host", "f32_of",
    "fitted", "from_end", "from_end_indices", "full", "i64_host", "i64_of", "input_mismatch", "joined_at", "lifted",
    "masked", "narrow", "opened", "payload_at", "quotient", "range_i64", "read_checkpoint", "read_shards", "reduce_mean",
    "refuse", "resized", "scalar", "softmax", "softmax_flattened", "stepped", "strided_gather", "to_extent", "unmet",
    "widen", "written_at",
];

/// Whether `name` already means something in the generated module.
pub fn is_bound(module: &HashSet<String>, name: &String) -> bool {
    return module.contains(*name) || is_reserved(name);
}

/// The names the generated module binds beyond the language's own.
pub fn module_idents() -> HashSet<String> {
    let mut reserved = HashSet::<String>::new();
    for let name of RUNTIME_NAMES {
        reserved.insert(name);
    }
    reserved.insert("build");
    reserved.insert("compute");
    reserved.insert(LENGTHS);
    reserved.insert("lengths");
    reserved.insert(CHOSEN);
    reserved.insert("chosen");
    reserved.insert(PARAMS);
    reserved.insert("params");
    reserved.insert(OUTPUTS);
    reserved.insert(PASSED);
    reserved.insert("weights");
    reserved.insert("Weights");
    reserved.insert(KEPT);
    reserved.insert(CACHE);
    reserved.insert("cache");
    reserved.insert(MODEL);
    reserved.insert("model");
    reserved.insert(RECORDED);
    reserved.insert(LEAST_EXTENTS);
    reserved.insert(DECODE);
    reserved.insert(DECODED_TYPE);
    reserved.insert(DECODED);
    reserved.insert(RECORDED_DECODED);
    // The parameters and locals the entries and what they record bind.
    for let name of [
        "at", "decoding", "ended", "extents", "finished", "last", "moved", "next", "passed", "recorder", "results",
        "returned", "room", "rows", "sampler", "sampling", "start", "state", "step", "steps", "tokens",
    ] as List<String> {
        reserved.insert(name);
    }
    // The methods `Weights`, `Params` and `Cache` carry, which a
    // field must not share.
    reserved.insert("empty");
    reserved.insert("retain");
    reserved.insert("load");
    reserved.insert("embedded");
    reserved.insert("held");
    reserved.insert("embedded_data");
    reserved.insert("backend");
    reserved.insert(BACKEND_PARAM);
    reserved.insert(CHECKPOINT_PARAM);
    return reserved;
}
