//! Kiln generator entry for Loam. Reads an ONNX graph, discharges its extent
//! conditions, and emits the axis types a checked graph earns.

use {
    Request,
    Response,
    Error,
    OutputFile,
    KilnHost,
    Diagnostic as KilnDiagnostic,
    DiagnosticLevel,
    read_text,
} from "core:kiln";
use { Deserialize } from "core:serde";
use { emit } from "./emit.wado";
use { infer } from "./infer.wado";
use { read } from "./onnx_text.wado";
use { LayoutRule, Schema } from "./schema.wado";

/// Generator-side options, written at the `use ... with { generator: { options:
/// { ... } } }` site. See WEP 2026-09-20 § "The Axis Schema Is an Invocation
/// Option".
pub struct Options {
    /// Patterns naming the axes of the graph's inputs and initializers.
    pub layout: List<LayoutRule>,
}

impl Deserialize for Options;

/// Whatever the graph is wrong about, said against the file it was read from.
fn at<E: Display>(path: &String, e: &E) -> Error {
    return Error::InvalidSchema(`loam: '${path}': ${e}`);
}

export fn generate(req: Request<Options>) -> Result<Response, Error> with KilnHost {
    let path = req.primary.path;
    let source = match read_text(req.primary.content) {
        Ok(text) => text,
        Err(e) => {
            return Result::Err(Error::InvalidSchema(`loam: '${path}' is not UTF-8: ${e}`));
        },
    };
    let graph = read(&source).map_err(|e| at(&path, &e))?;
    // An extent the algebra cannot discharge stops the build here, since there
    // is no tier below this one to re-check at.
    let shapes = infer(&graph, &Schema { layout: req.options.layout }).map_err(|e| at(&path, &e))?;
    let generated = emit(&graph, &shapes).map_err(|e| at(&path, &e))?;
    KilnHost::emit_diagnostic(KilnDiagnostic {
        level: DiagnosticLevel::Hint,
        span: null,
        message: `loam: ${graph.name}: ${graph.nodes.len()} operators checked`,
    });
    let files: List<OutputFile> = [
        OutputFile {
            path: "model.wado",
            content: generated,
            is_entry: true,
        },
    ];
    return Result::Ok(Response { files });
}
