//! Kiln generator entry for Loam. Reads an ONNX graph, discharges its extent
//! conditions, and emits the axis types a checked graph earns.

use {
    Request,
    Response,
    Error as KilnError,
    OutputFile,
    KilnHost,
    Diagnostic as KilnDiagnostic,
    DiagnosticLevel,
    InputFile,
    read_all,
    read_text,
} from "core:kiln";
use { TreeMap } from "core:collections";
use { Deserialize } from "core:serde";
use { emit } from "./emit.wado";
use { Graph } from "./graph.wado";
use { infer } from "./infer.wado";
use { declared_header_end, read_checkpoint } from "./runtime/checkpoint.wado";
use { check_checkpoint } from "./safetensors.wado";
use onnx_proto from "./onnx_proto.wado";
use onnx_text from "./onnx_text.wado";
use { LayoutRule, Schema } from "./schema.wado";
use { bind_dims, keep_outputs } from "./specialize.wado";

/// The `generator.options` a `use ... with` site writes. See WEP 2026-09-20
/// § "The Axis Schema Is an Invocation Option".
pub struct Options {
    /// Patterns naming the axes of the graph's inputs and initializers.
    pub layout: List<LayoutRule>,
    /// Static extents for the graph's symbolic dimensions, keyed by `dim_param`.
    pub dims: TreeMap<String, i32>,
    /// The graph outputs `forward` returns. Empty keeps every output.
    pub outputs: List<String>,
}

impl Deserialize for Options;

/// Whatever the graph is wrong about, said against the file it was read from.
fn at<E: Error>(path: &String, e: &E) -> KilnError {
    return KilnError::InvalidSchema(`loam: '${path}': ${e}`);
}

/// The graph from either spelling: `.onnx`, which an exporter writes, or
/// `.onnxtext`, which a fixture is written in and a diff can show.
fn read_graph(path: &String, content: Stream<u8>) -> Result<Graph, KilnError> {
    if path.ends_with(".onnx") {
        return onnx_proto::read(read_all(content)).map_err(|e| at(path, &e));
    }
    let source = match read_text(content) {
        Ok(text) => text,
        Err(e) => {
            return Result::Err(KilnError::InvalidSchema(`loam: '${path}' is not UTF-8: ${e}`));
        },
    };
    return onnx_text::read(&source).map_err(|e| at(path, &e));
}

/// A checkpoint's leading bytes, through the end of its header, of the file, or
/// of a length no module can address. The payloads are the loader's to read.
fn read_header(content: Stream<u8>) -> ByteList {
    let mut prefix = ByteList::with_capacity(HEADER_CHUNK);
    loop {
        let chunk = content.read(HEADER_CHUNK);
        prefix.extend(&(chunk.items as ByteList));
        if chunk.result != CopyResult::Completed || prefix.len() >= 8 && header_read(&prefix) {
            break;
        }
    }
    content.drop();
    return prefix;
}

fn header_read(prefix: &ByteList) -> bool {
    return match declared_header_end(prefix) {
        Ok(end) => prefix.len() >= end,
        Err(_) => true,
    };
}

/// Why the invocation's inputs are not one `.safetensors` checkpoint at most.
fn input_refusal(inputs: &List<InputFile>) -> Option<String> {
    if inputs.len() > 1 {
        return Option::Some(`loam: ${inputs.len()} inputs, and a checkpoint is one file`);
    }
    for let input of *inputs {
        if !input.path.ends_with(".safetensors") {
            return Option::Some(`loam: '${input.path}': an input is a .safetensors checkpoint`);
        }
    }
    return null;
}

/// Enough for GPT-2's header in one read, which is 14 KiB.
global HEADER_CHUNK: i32 = 65536;

export fn generate(req: Request<Options>) -> Result<Response, KilnError> with KilnHost {
    // A stream is outside drop elaboration, so every one is consumed or dropped
    // before the first return that could leave it open.
    if let Some(reason) = input_refusal(&req.inputs) {
        req.primary.content.drop();
        for let input of req.inputs {
            input.content.drop();
        }
        return Result::Err(KilnError::InvalidSchema(reason));
    }
    let mut headers: List<[String, ByteList]> = [];
    for let input of req.inputs {
        headers.push([input.path, read_header(input.content)]);
    }
    let path = req.primary.path;
    let mut graph = read_graph(&path, req.primary.content)?;
    bind_dims(&mut graph, &req.options.dims).map_err(|e| at(&path, &e))?;
    keep_outputs(&mut graph, &req.options.outputs).map_err(|e| at(&path, &e))?;
    // An extent the algebra cannot discharge stops the build here, since there
    // is no tier below this one to re-check at.
    let checked = infer(&graph, &Schema { layout: req.options.layout }).map_err(|e| at(&path, &e))?;
    // Emitting first refuses an element type no kernel holds, which the check
    // below takes as given.
    let generated = emit(&graph, &checked).map_err(|e| at(&path, &e))?;
    for let [input_path, header] of headers {
        let checkpoint = read_checkpoint(&header).map_err(|e| at(&input_path, &e))?;
        check_checkpoint(&graph, &checked.shapes, &checkpoint).map_err(|e| at(&input_path, &e))?;
    }
    KilnHost::emit_diagnostic(KilnDiagnostic {
        level: DiagnosticLevel::Hint,
        span: null,
        message: `loam: ${graph.name}: ${graph.nodes.len()} operators checked`,
    });
    let files: List<OutputFile> = [
        OutputFile {
            path: "model.wado",
            content: generated,
            is_entry: true,
        },
    ];
    return Result::Ok(Response { files });
}
