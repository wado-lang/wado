//! Kiln generator entry for Loam. Reads an ONNX graph, discharges its extent
//! conditions, and emits the axis types a checked graph earns; or reads a
//! `tokenizer.json` and emits its `Tokenizer`.

use {
    Request,
    Response,
    Error as KilnError,
    OutputFile,
    KilnHost,
    Diagnostic as KilnDiagnostic,
    DiagnosticLevel,
    package_of,
    read_all,
} from "core:kiln";
use { TreeMap } from "core:collections";
use { Deserialize } from "core:serde";
use { Spelling, check, generate_model, generate_tokenizer, read_header, spelling_of } from "./compile.wado";
use { LayoutRule } from "./schema.wado";

/// The `generator.options` a `use ... with` site writes. See WEP 2026-09-20
/// § "The Axis Schema Is an Invocation Option".
pub struct Options {
    /// Patterns naming the axes of the graph's inputs and initializers.
    pub layout: List<LayoutRule>,
    /// Static extents for the graph's symbolic dimensions, keyed by `dim_param`.
    pub dims: TreeMap<String, i32>,
    /// The graph outputs `forward` returns. Empty keeps every output.
    pub outputs: List<String>,
}

impl Deserialize for Options;

/// The `type` a use site gave a file, as a refusal names it. Loam reads no file
/// without one, since nothing makes one kind the default.
fn given(use_type: &Option<String>) -> String {
    return match *use_type {
        Some(t) => `\`type: "${t}"\``,
        None => "no `type`",
    };
}

/// `error`, once every stream the request carries is dropped.
fn refused(req: Request<Options>, error: KilnError) -> Result<Response, KilnError> {
    req.primary.content.drop();
    for let input of req.inputs {
        input.content.drop();
    }
    return Result::Err(error);
}

/// The one file a generation writes.
fn entry(path: String, content: String) -> Response {
    return Response {
        files: [
            OutputFile { path, content, is_entry: true },
        ],
    };
}

// A stream is outside drop elaboration, so every one is consumed or dropped
// before the first return that could leave it open.
export fn generate(req: Request<Options>) -> Result<Response, KilnError> with KilnHost {
    let Some(runtime) = package_of(&req.module) else {
        let reason = `loam: invoked by the path ${req.module}; name it by the package spec its runtime is a dependency under`;
        return refused(req, KilnError::Unsupported(reason));
    };
    if req.primary.type matches { Some("hf-tokenizer") } {
        if !req.inputs.is_empty() {
            let reason = `loam: '${req.primary.path}': a tokenizer takes no inputs`;
            return refused(req, KilnError::InvalidSchema(reason));
        }
        let path = req.primary.path;
        let source = generate_tokenizer(&path, read_all(req.primary.content), &runtime).map_err(
            |e| KilnError::InvalidSchema(e),
        )?;
        return Result::Ok(entry("tokenizer.wado", source));
    }
    let Some(spelling) = spelling_of(&req.primary.type) else {
        let reason = `loam: '${req.primary.path}' is given ${given(&req.primary.type)}; a graph is \`type: "onnx"\` or \`type: "onnxtext"\`, and a tokenizer \`type: "hf-tokenizer"\``;
        return refused(req, KilnError::Unsupported(reason));
    };
    return generate_graph(req, spelling, &runtime);
}

/// An ONNX graph spelled as `spelling`, checked against the checkpoints in its
/// inputs, as the module its `forward` runs in.
fn generate_graph(
    req: Request<Options>,
    spelling: Spelling,
    runtime: &String,
) -> Result<Response, KilnError> with KilnHost {
    if req.inputs.len() > 1 {
        let reason = `loam: ${req.inputs.len()} inputs, and a checkpoint is one file`;
        return refused(req, KilnError::InvalidSchema(reason));
    }
    if let Some(input) = req.inputs.into_iter().find(|input| !input.type matches { Some("safetensors") }) {
        let reason = `loam: '${input.path}' is given ${given(&input.type)}; a checkpoint is \`type: "safetensors"\``;
        return refused(req, KilnError::Unsupported(reason));
    }
    let mut headers: List<[String, ByteList]> = [];
    for let input of req.inputs {
        headers.push([input.path, read_header(input.content)]);
    }
    let path = req.primary.path;
    let options = req.options;
    let model = check(&path, spelling, read_all(req.primary.content), options.layout, &options.dims, &options.outputs).map_err(
        |e| KilnError::InvalidSchema(e),
    )?;
    let source = generate_model(&model, &path, headers, runtime).map_err(|e| KilnError::InvalidSchema(e))?;
    KilnHost::emit_diagnostic(KilnDiagnostic {
        level: DiagnosticLevel::Hint,
        span: null,
        message: `loam: ${model.graph.name}: ${model.graph.nodes.len()} operators checked`,
    });
    return Result::Ok(entry("model.wado", source));
}
