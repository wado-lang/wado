//! The Wado a `tokenizer.json` becomes: a `Tokenizer` whose `encode` and
//! `decode` run the runtime's byte-level BPE over the vocabulary and merges the
//! file names, embedded as data.

use { CodeWriter, byte_string_literal, wado } from "lib:wadopoet";
use { ByteLevelBpe } from "./tokenizer_json.wado";

/// The generated module's source for `bpe`, read from `path`, importing the
/// runtime from the package spec `runtime`.
pub fn emit_tokenizer(bpe: &ByteLevelBpe, path: &String, runtime: &String) -> String {
    let specials: List<String> = bpe.specials.into_iter().map(|s| wado`"${s}"`).collect();
    let mut w = CodeWriter::with_capacity(1024);
    w.line(`//! Generated by Loam from the tokenizer \`${*path}\`.`);
    w.blank();
    w.line(wado`use { BpeTokenizer } from "${*runtime}";`);
    w.blank();
    w.line("global TOKENIZER: BpeTokenizer = BpeTokenizer::new(");
    w.line(`    &${byte_string_literal(&lines(&bpe.tokens))},`);
    w.line(`    &${byte_string_literal(&lines(&bpe.merges))},`);
    w.line(`    [${specials.join(", ")}],`);
    w.line(");");
    w.blank();
    w.line("/// GPT-2's byte-level BPE over this file's vocabulary and merges.");
    w.line("pub struct Tokenizer {");
    w.line("}");
    w.blank();
    w.line("impl Tokenizer {");
    w.line("    /// The ids `text` encodes to.");
    w.line("    pub fn encode(text: &String) -> List<i32> {");
    w.line("        return TOKENIZER.encode(text);");
    w.line("    }");
    w.blank();
    w.line("    /// The text `ids` decode to.");
    w.line("    pub fn decode(ids: &List<i32>) -> String {");
    w.line("        return TOKENIZER.decode(ids);");
    w.line("    }");
    w.line("}");
    return w.to_string();
}

/// `entries` one to a line, as `BpeTokenizer::new` reads them.
fn lines(entries: &List<String>) -> ByteList {
    return entries.join("\n").bytes().collect();
}
