//! The Wado a `tokenizer.json` becomes: a `Tokenizer` whose `encode` and
//! `decode` run the runtime's BPE over the vocabulary and merges the file
//! names, embedded as data.

use { CodeWriter, FnSpec, GlobalSpec, ImplSpec, StructSpec, Vis, byte_string_literal, wado } from "lib:wadopoet";
use { BpePipeline } from "./tokenizer_json.wado";

/// The generated module's source for `bpe`, read from `path`, importing the
/// runtime from the package spec `runtime`.
pub fn emit_tokenizer(bpe: &BpePipeline, path: &String, runtime: &String) -> String {
    let specials: List<String> = bpe.specials.into_iter().map(|s| wado`"${s}"`).collect();
    let tokens = tokens_bytes(&bpe.tokens);
    let prefix: List<String> = bpe.prefix.into_iter().map(|id| `${id}`).collect();
    let mut w = CodeWriter::with_capacity(1024);
    w.line(`//! Generated by Loam from the tokenizer \`${*path}\`.`);
    w.blank();
    w.line(wado`use { BpeTokenizer, PieceSplit, TokenSpelling } from "${*runtime}";`);
    w.blank();
    let args: List<String> = [
        `&${byte_string_literal(&tokens)}`, `&${byte_string_literal(&order_bytes(&bpe.tokens))}`,
        `&${byte_string_literal(&merges_bytes(&bpe.merges))}`, `[${specials.join(", ")}]`,
        `TokenSpelling::${bpe.spelling}`, `PieceSplit::${bpe.split}`, `${bpe.ignore_merges}`, `${bpe.unknown}`,
        `[${prefix.join(", ")}]`,
    ];
    GlobalSpec::new("TOKENIZER", "BpeTokenizer", `BpeTokenizer::new(${args.join(", ")})`).emit(&mut w);
    w.blank();
    StructSpec::new("Tokenizer", Vis::Pub).set_doc("BPE over this file's vocabulary and merges.").emit(&mut w);
    w.blank();
    ImplSpec::new("Tokenizer").emit_begin(&mut w);
    FnSpec::new("encode", Vis::Pub)
        .set_doc("The ids `text` encodes to.")
        .add_param("text", "&String")
        .set_return_type("List<i32>")
        .emit_begin(&mut w);
    w.line("return TOKENIZER.encode(text);");
    w.end();
    w.blank();
    FnSpec::new("decode", Vis::Pub)
        .set_doc("The text `ids` decode to.")
        .add_param("ids", "&List<i32>")
        .set_return_type("String")
        .emit_begin(&mut w);
    w.line("return TOKENIZER.decode(ids);");
    w.end();
    w.end();
    return w.to_string();
}

/// The tokens as `BpeTokenizer::new` reads them, separated by NUL.
pub fn tokens_bytes(tokens: &List<String>) -> ByteList {
    return tokens.join("\0").bytes().collect();
}

/// The ids ordered by their tokens as `BpeTokenizer::new` reads them, the
/// lowest of a repeated token's first: little-endian `i32`s.
pub fn order_bytes(tokens: &List<String>) -> ByteList {
    let mut ids: List<i32> = (0..<tokens.len()).collect();
    ids.sort_by(|a, b| tokens[*a].cmp(&tokens[*b]));
    let mut bytes = ByteList::with_capacity(ids.len() * 4);
    for let id of ids {
        push_le(&mut bytes, id);
    }
    return bytes;
}

/// The merges as `BpeTokenizer::new` reads them: three little-endian `i32`s each.
pub fn merges_bytes(merges: &List<[i32, i32, i32]>) -> ByteList {
    let mut bytes = ByteList::with_capacity(merges.len() * 12);
    for let [left, right, joined] of *merges {
        for let id of [left, right, joined] {
            push_le(&mut bytes, id);
        }
    }
    return bytes;
}

fn push_le(bytes: &mut ByteList, n: i32) {
    for let shift of [0, 8, 16, 24] {
        bytes.push((n >> shift & 0xff) as u8);
    }
}
