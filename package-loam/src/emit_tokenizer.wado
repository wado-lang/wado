//! The Wado a `tokenizer.json` becomes: a `Tokenizer` whose `encode` and
//! `decode` run the runtime's BPE over the vocabulary and merges the file
//! names, embedded as data.

use { CodeWriter, byte_string_literal, wado } from "lib:wadopoet";
use { BpePipeline } from "./tokenizer_json.wado";

/// The generated module's source for `bpe`, read from `path`, importing the
/// runtime from the package spec `runtime`.
pub fn emit_tokenizer(bpe: &BpePipeline, path: &String, runtime: &String) -> String {
    let specials: List<String> = bpe.specials.into_iter().map(|s| wado`"${s}"`).collect();
    let tokens: ByteList = bpe.tokens.join("\0").bytes().collect();
    let prefix: List<String> = bpe.prefix.into_iter().map(|id| `${id}`).collect();
    let mut w = CodeWriter::with_capacity(1024);
    w.line(`//! Generated by Loam from the tokenizer \`${*path}\`.`);
    w.blank();
    w.line(wado`use { BpeTokenizer, TokenSpelling } from "${*runtime}";`);
    w.blank();
    w.line("global TOKENIZER: BpeTokenizer = BpeTokenizer::new(");
    w.line(`    &${byte_string_literal(&tokens)},`);
    w.line(`    &${byte_string_literal(&merges_bytes(&bpe.merges))},`);
    w.line(`    [${specials.join(", ")}],`);
    w.line(`    TokenSpelling::${bpe.spelling},`);
    w.line(`    ${bpe.unknown},`);
    w.line(`    [${prefix.join(", ")}],`);
    w.line(");");
    w.blank();
    w.line("/// BPE over this file's vocabulary and merges.");
    w.line("pub struct Tokenizer {");
    w.line("}");
    w.blank();
    w.line("impl Tokenizer {");
    w.line("    /// The ids `text` encodes to.");
    w.line("    pub fn encode(text: &String) -> List<i32> {");
    w.line("        return TOKENIZER.encode(text);");
    w.line("    }");
    w.blank();
    w.line("    /// The text `ids` decode to.");
    w.line("    pub fn decode(ids: &List<i32>) -> String {");
    w.line("        return TOKENIZER.decode(ids);");
    w.line("    }");
    w.line("}");
    return w.to_string();
}

/// The merges as `BpeTokenizer::new` reads them: three little-endian `i32`s each.
fn merges_bytes(merges: &List<[i32, i32, i32]>) -> ByteList {
    let mut bytes = ByteList::with_capacity(merges.len() * 12);
    for let [left, right, joined] of *merges {
        for let id of [left, right, joined] {
            for let shift of [0, 8, 16, 24] {
                bytes.push((id >> shift & 0xff) as u8);
            }
        }
    }
    return bytes;
}
