//! Loam — tensor compilation for Wado: the graph it reads, the axes the schema
//! names, the extent conditions it discharges, and the module it emits.

pub use { Extent } from "./extent.wado";
pub use { Axis, ExtentConflict, Shape } from "./shape.wado";
pub use { Attr, Dim, Graph, Node, Rank, ValueInfo, read } from "./onnx_text.wado";
pub use { LayoutRule, Schema } from "./schema.wado";
pub use {
    AxisCountConflict,
    DeclaredConflict,
    DeclaredRankConflict,
    InferError,
    NodeConflict,
    OperandCountConflict,
    OutputCountConflict,
    UnnamedTensor,
    infer,
} from "./infer.wado";
pub use {
    EmitError,
    NameCollision,
    UnimplementedBroadcast,
    UnimplementedOperator,
    UnmappedDtype,
    emit,
} from "./emit.wado";
