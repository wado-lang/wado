//! Integer arithmetic over a graph's dimension symbols, which is what stage 0
//! computes when an exporter writes shape arithmetic over a length only the
//! run knows. See WEP 2026-09-20 § "Axis Identity Is a Type, Extents Are
//! Values".

use { TreeMap } from "core:collections";

/// A condition on the symbols the build relies on and cannot prove, as a
/// clamped `Slice` bound read as unclamped is: `slack` is at least 0 for every
/// input `forward` accepts, since it checks this before any kernel runs.
pub struct Condition {
    pub slack: Poly,
    /// The condition as the refusal states it, at the node that relies on it.
    pub reason: String,
}

/// One term of a `Poly`: the product of `symbols`, scaled by `coefficient`.
struct Term {
    coefficient: i64,
    /// Sorted, a symbol repeated once per power; empty for the constant term.
    symbols: List<Symbol>,
}

/// A polynomial with integer coefficients over dimension symbols, held in one
/// canonical form so that two equal polynomials are equal as values.
pub struct Poly {
    /// No two share `symbols` and none has coefficient 0, ordered by `order`.
    terms: List<Term>,
}

/// An operation no polynomial expresses, which `forward` computes a derived
/// symbol by.
enum Op {
    /// The lesser of two operands.
    Min,
    /// The greater of two operands.
    Max,
    /// The first operand divided by the second, rounded up.
    CeilDiv,
    /// `CeilDiv` rounded down.
    FloorDiv,
    /// An index into an axis of the second operand's extent, which counts from
    /// the end where negative.
    FromEnd,
    /// The operand's low 32 bits, as an int32 holds it.
    Wrap32,
}

/// How `forward` computes a derived symbol from others.
struct Derivation {
    op: Op,
    operands: List<Poly>,
    /// The node whose operator this is, which a condition reading it names.
    origin: String,
}

/// A factor a term multiplies: a length an input carries, or a value `forward`
/// derives from others by an operation no polynomial expresses.
struct Symbol {
    /// An input symbol's `dim_param`, or a derived one as a message writes it:
    /// from its operation and its operands, each in canonical form, so the name
    /// identifies it wherever it was derived.
    name: String,
    derivation: Option<Derivation>,
    /// A lower and an upper bound on the value, over every input.
    range: [i128, i128],
}

impl Eq for Symbol {
    fn eq(&self, other: &Symbol) -> bool {
        return self.name == other.name && self.is_derived() == other.is_derived();
    }
}

impl Ord for Symbol {
    fn cmp(&self, other: &Symbol) -> Ordering {
        let by_name = self.name.cmp(&other.name);
        if !by_name matches { Equal } {
            return by_name;
        }
        return (self.is_derived() as i32).cmp(&(other.is_derived() as i32));
    }
}

impl Symbol {
    fn is_derived(&self) -> bool {
        return self.derivation matches { Some(_) };
    }

    /// The symbol read as `Poly::presumed` reads it.
    fn presumed(&self, conditions: &mut List<Condition>) -> Option<Poly> {
        let Some(d) = self.derivation else {
            return Option::Some(Poly::of(*self));
        };
        let mut operands: List<Poly> = [];
        for let o of &d.operands {
            operands.push(o.presumed(conditions)?);
        }
        let a = operands[0];
        let presumed = match d.op {
            Min => owes(conditions, &d.origin, operands[1].try_sub(&a), `${a} must be at most ${operands[1]}`),
            Max => owes(conditions, &d.origin, a.try_sub(&operands[1]), `${a} must be at least ${operands[1]}`),
            FromEnd => owes(conditions, &d.origin, Option::Some(a), `${a} must not be negative`),
            Wrap32 => {
                let condition = `${a} must fit in int32`;
                owes(conditions, &d.origin, Poly::constant(i32::MAX as i64).try_sub(&a), condition)
                    && owes(conditions, &d.origin, a.try_sub(&Poly::constant(i32::MIN as i64)), condition);
            },
            CeilDiv | FloorDiv => {
                return Option::Some(Poly::quotient(d.op, &a, &operands[1], &d.origin));
            },
        };
        return if presumed { Option::Some(a) } else { null };
    }
}

/// Owe `slack >= 0` at `site`, unless every value of the symbols makes it so.
/// A slack every value makes negative is no condition on the inputs but a
/// graph wrong for every one of them, which the error says.
pub fn owe(conditions: &mut List<Condition>, site: &String, slack: &Poly, condition: String) -> Result<(), String> {
    if slack.is_nonnegative() {
        return Result::Ok(());
    }
    if slack.is_negative() {
        return Result::Err(`${condition}, and it is not`);
    }
    conditions.push(Condition { slack: *slack, reason: `${*site}: ${condition}` });
    return Result::Ok(());
}

/// `owe` for `Poly::presumed`: whether the reading holds, which it does not
/// where no input meets it or no polynomial holds the slack.
fn owes(conditions: &mut List<Condition>, origin: &String, slack: Option<Poly>, condition: String) -> bool {
    let Some(s) = slack else {
        return false;
    };
    return owe(conditions, origin, &s, condition) matches { Ok(_) };
}

impl Derivation {
    /// The derived symbol as the generated module computes it, or, where not
    /// `code`, as a message writes it.
    fn written(&self, names: &TreeMap<String, String>, code: bool) -> String {
        let args: List<String> = self.operands.into_iter().map(|o| o.written(names, code)).collect();
        return match self.op {
            Min | Max => {
                let name = if self.op matches { Min } { "min" } else { "max" };
                if code {
                    `i64::${name}(${args[0]}, ${args[1]})`;
                } else {
                    `${name}(${args[0]}, ${args[1]})`;
                }
            },
            CeilDiv | FloorDiv => {
                let rounding = if self.op matches { CeilDiv } { "ceil" } else { "floor" };
                if code {
                    `${rounding}_div(${args[0]}, ${args[1]})`;
                } else {
                    `${rounding}(${grouped(&self.operands[0], &args[0])} / ${grouped(&self.operands[1], &args[1])})`;
                }
            },
            FromEnd => `from_end(${args[0]}, ${args[1]})`,
            Wrap32 => if code { `((${args[0]}) as i32 as i64)` } else { `wrap32(${args[0]})` },
        };
    }

    /// A lower and an upper bound on the value, over every input.
    fn range(&self) -> [i128, i128] {
        let [low, high] = self.operands[0].bounds();
        return match self.op {
            Min => {
                let [l, h] = self.operands[1].bounds();
                [
                    i128::min(low, l),
                    i128::min(high, h),
                ];
            },
            Max => {
                let [l, h] = self.operands[1].bounds();
                [
                    i128::max(low, l),
                    i128::max(high, h),
                ];
            },
            // A quotient is monotonic in each operand for a positive divisor,
            // so its bounds lie at the corners.
            CeilDiv | FloorDiv => {
                let [l, h] = self.operands[1].bounds();
                let mut corners: List<i128> = [];
                for let a of [low, high] {
                    for let d of [
                        i128::max(l, 1),
                        i128::max(h, 1),
                    ] {
                        corners.push(rounded(self.op, a, d));
                    }
                }
                // A dividend without a bound on one side leaves the quotient none.
                let [q_low, q_high] = span(corners);
                [if low == -REACH_LIMIT { low } else { q_low }, if high == REACH_LIMIT { high } else { q_high }];
            },
            // The index where it is not negative, and past it the extent's reach.
            FromEnd => {
                let [l, h] = self.operands[1].bounds();
                [
                    i128::min(0, lower_sum(low, l)),
                    i128::max(high, upper_sum(h, -1)),
                ];
            },
            Wrap32 => [i32::MIN as i128, i32::MAX as i128],
        };
    }

    /// Whether every input makes the derived value at least `x`: for one of two
    /// operands, the one it takes is. `FromEnd` takes either of its index and
    /// the index past the extent, so both must be.
    fn at_least(&self, x: &Poly, budget: &mut i32) -> bool {
        let a = &self.operands[0];
        return match self.op {
            Min => x.at_most_within(a, budget) && x.at_most_within(&self.operands[1], budget),
            Max => x.at_most_within(a, budget) || x.at_most_within(&self.operands[1], budget),
            // `floor(a / d) >= x` exactly where `a >= d * x`, and the ceiling is
            // never below the floor.
            CeilDiv | FloorDiv => match x.try_mul(&self.operands[1]) {
                Some(dx) => dx.at_most_within(a, budget),
                None => false,
            },
            FromEnd => x.at_most_within(a, budget)
                && match a.try_add(&self.operands[1]) {
                    Some(past) => x.at_most_within(&past, budget),
                    None => false,
                },
            Wrap32 => false,
        };
    }

    /// `at_least`'s counterpart: every input makes the value at most `x`.
    fn at_most(&self, x: &Poly, budget: &mut i32) -> bool {
        let a = &self.operands[0];
        return match self.op {
            Min => a.at_most_within(x, budget) || self.operands[1].at_most_within(x, budget),
            Max => a.at_most_within(x, budget) && self.operands[1].at_most_within(x, budget),
            // `ceil(a / d) <= x` exactly where `a <= d * x`, for an integer `x`.
            CeilDiv => match x.try_mul(&self.operands[1]) {
                Some(dx) => a.at_most_within(&dx, budget),
                None => false,
            },
            FloorDiv => floor_at_most(a, &self.operands[1], x, budget).unwrap_or(false),
            FromEnd => a.at_most_within(x, budget)
                && match a.try_add(&self.operands[1]) {
                    Some(past) => past.at_most_within(x, budget),
                    None => false,
                },
            Wrap32 => false,
        };
    }
}

/// Whether every input makes `floor(a / d) <= x`, which holds exactly where
/// `a + 1 <= d * (x + 1)`; `None` where no polynomial holds a side.
fn floor_at_most(a: &Poly, d: &Poly, x: &Poly, budget: &mut i32) -> Option<bool> {
    let one = Poly::constant(1);
    return Option::Some(a.try_add(&one)?.at_most_within(&x.try_add(&one)?.try_mul(d)?, budget));
}

/// An input symbol's name as a message writes it: quoted unless it is an
/// identifier, since a `dim_param` is any text, so that a derived symbol's
/// name, which is its identity, reads as no other's.
fn quoted(name: &String) -> String {
    let mut chars = name.chars();
    let identifier = match chars.next() {
        Some(first) => (first.is_ascii_alphabetic() || first == '_')
            && chars.all(|c| c.is_ascii_alphanumeric() || c == '_'),
        None => false,
    };
    return if identifier { *name } else { `${*name:?}` };
}

/// `text`, spelling `p`, as a factor: in parentheses where it has more than one term.
fn grouped(p: &Poly, text: &String) -> String {
    return if p.terms.len() > 1 { `(${*text})` } else { *text };
}

impl Poly {
    /// The number `c`.
    pub fn constant(c: i64) -> Poly {
        if c == 0 {
            return Poly { terms: [] };
        }
        return Poly {
            terms: [
                Term { coefficient: c, symbols: [] },
            ],
        };
    }

    /// The length the symbol `name` stands for.
    pub fn symbol(name: &String) -> Poly {
        return Poly::of(Symbol {
            name: *name,
            derivation: null,
            range: [0, i32::MAX as i128],
        });
    }

    fn of(s: Symbol) -> Poly {
        return Poly {
            terms: [
                Term {
                    coefficient: 1,
                    symbols: [s],
                },
            ],
        };
    }

    /// The symbol `forward` computes by `op` over `operands`, for the node
    /// `origin` names.
    fn derived(op: Op, operands: List<Poly>, origin: &String) -> Poly {
        let d = Derivation { op, operands, origin: *origin };
        return Poly::of(Symbol {
            name: d.written(&TreeMap::<String, String>::new(), false),
            range: d.range(),
            derivation: Option::Some(d),
        });
    }

    /// The lesser of `a` and `b`, as the node `origin` names computes it.
    pub fn min_of(a: &Poly, b: &Poly, origin: &String) -> Poly {
        if a.at_most(b) {
            return *a;
        }
        if b.at_most(a) {
            return *b;
        }
        return Poly::derived(Op::Min, [*a, *b], origin);
    }

    /// The greater of `a` and `b`, as `min_of` computes the lesser.
    pub fn max_of(a: &Poly, b: &Poly, origin: &String) -> Poly {
        if b.at_most(a) {
            return *a;
        }
        if a.at_most(b) {
            return *b;
        }
        return Poly::derived(Op::Max, [*a, *b], origin);
    }

    /// `x` raised to `lo`, then lowered to `hi`, as ONNX clamps a `Slice` bound.
    pub fn clamped(x: &Poly, lo: &Poly, hi: &Poly, origin: &String) -> Poly {
        return Poly::min_of(&Poly::max_of(x, lo, origin), hi, origin);
    }

    /// `a / d` rounded up, for a `d` positive for every input the build
    /// accepts: a positive number, or a polynomial the caller has owed positive.
    pub fn ceil_div(a: &Poly, d: &Poly, origin: &String) -> Poly {
        return Poly::quotient(Op::CeilDiv, a, d, origin);
    }

    /// `ceil_div` rounded down.
    pub fn floor_div(a: &Poly, d: &Poly, origin: &String) -> Poly {
        return Poly::quotient(Op::FloorDiv, a, d, origin);
    }

    fn quotient(op: Op, a: &Poly, d: &Poly, origin: &String) -> Poly {
        if let Some(n) = d.as_constant() {
            assert n > 0;
            if let Some(m) = a.as_constant() {
                return Poly::constant(rounded(op, m as i128, n as i128) as i64);
            }
        }
        if let Some(q) = a.divided_by(d) {
            return q;
        }
        return Poly::derived(op, [*a, *d], origin);
    }

    /// Index `i` into an axis of `extent`, counted from the end where negative,
    /// or `None` where no polynomial holds the sum.
    pub fn from_end(i: &Poly, extent: &Poly, origin: &String) -> Option<Poly> {
        if i.is_nonnegative() {
            return Option::Some(*i);
        }
        if i.is_negative() {
            return i.try_add(extent);
        }
        return Option::Some(Poly::derived(Op::FromEnd, [*i, *extent], origin));
    }

    /// What an int32 holds of `a`: its low 32 bits.
    pub fn wrapped32(a: &Poly, origin: &String) -> Poly {
        if let Some(c) = a.as_constant() {
            return Poly::constant(c as i32 as i64);
        }
        let [low, high] = a.bounds();
        if i32::MIN as i128 <= low && high <= i32::MAX as i128 {
            return *a;
        }
        return Poly::derived(Op::Wrap32, [*a], origin);
    }

    /// The polynomial with each derived symbol read as the operand it takes
    /// unchanged: a clamp as its bound, a count clamped at none as its span, an
    /// index counted from the end as counted from the start, and a wrap as the
    /// value it wraps. `conditions` gains what each reading owes. `None` where
    /// no input meets one, or no polynomial holds the result. See WEP 2026-09-20
    /// § "Axis Identity Is a Type, Extents Are Values".
    pub fn presumed(&self, conditions: &mut List<Condition>) -> Option<Poly> {
        let mut sum = Poly::constant(0);
        for let t of &self.terms {
            let mut factors = Poly::constant(t.coefficient);
            for let s of &t.symbols {
                factors = factors.try_mul(&s.presumed(conditions)?)?;
            }
            sum = sum.try_add(&factors)?;
        }
        return Option::Some(sum);
    }

    /// The value, where no symbol remains.
    pub fn as_constant(&self) -> Option<i64> {
        if self.terms.is_empty() {
            return Option::Some(0);
        }
        if self.terms.len() == 1 && self.terms[0].symbols.is_empty() {
            return Option::Some(self.terms[0].coefficient);
        }
        return null;
    }

    /// Whether some term reads a symbol the run derives.
    pub fn is_derived(&self) -> bool {
        for let t of &self.terms {
            for let s of &t.symbols {
                if s.is_derived() {
                    return true;
                }
            }
        }
        return false;
    }

    /// Every input symbol the polynomial reads, a derived one's operands
    /// included, each once, in order.
    pub fn symbols(&self) -> List<String> {
        let mut names: List<String> = [];
        self.collect_symbols(&mut names);
        names.sort();
        return names;
    }

    fn collect_symbols(&self, names: &mut List<String>) {
        for let t of &self.terms {
            for let s of &t.symbols {
                if let Some(d) = s.derivation {
                    for let o of &d.operands {
                        o.collect_symbols(names);
                    }
                } else if !names.contains_str(s.name.as_str_slice()) {
                    names.push(s.name);
                }
            }
        }
    }

    /// The sum, or `None` where a coefficient leaves `i64`.
    pub fn try_add(&self, other: &Poly) -> Option<Poly> {
        let mut terms = self.terms;
        terms.extend(&other.terms);
        return Poly::collected(terms);
    }

    /// The difference, or `None` as for `try_add`.
    pub fn try_sub(&self, other: &Poly) -> Option<Poly> {
        let mut negated: List<Term> = [];
        for let t of &other.terms {
            negated.push(Term { coefficient: narrowed(-(t.coefficient as i128))?, symbols: t.symbols });
        }
        return self.try_add(&Poly { terms: negated });
    }

    /// The product, or `None` as for `try_add`.
    pub fn try_mul(&self, other: &Poly) -> Option<Poly> {
        let mut terms: List<Term> = [];
        for let a of &self.terms {
            for let b of &other.terms {
                let mut symbols = a.symbols;
                symbols.extend(&b.symbols);
                symbols.sort();
                let coefficient = narrowed(a.coefficient as i128 * b.coefficient as i128)?;
                terms.push(Term { coefficient, symbols });
            }
        }
        return Poly::collected(terms);
    }

    /// The quotient where `divisor` divides every term exactly, as a monomial
    /// or the polynomial itself does. `None` is a division the build cannot
    /// prove exact, which a symbol's value might still make exact at run time.
    pub fn divided_by(&self, divisor: &Poly) -> Option<Poly> {
        if *self == *divisor && !self.terms.is_empty() {
            return Option::Some(Poly::constant(1));
        }
        if divisor.terms.len() != 1 {
            return null;
        }
        let d = &divisor.terms[0];
        let mut terms: List<Term> = [];
        for let t of &self.terms {
            // `i64::MIN / -1` is the one quotient past `i64`, so it is taken wide.
            let [n, m] = [t.coefficient as i128, d.coefficient as i128];
            if n % m != 0 {
                return null;
            }
            let Some(rest) = without(&t.symbols, &d.symbols) else {
                return null;
            };
            terms.push(Term { coefficient: narrowed(n / m)?, symbols: rest });
        }
        return Poly::collected(terms);
    }

    /// Whether every input makes this at most `other`.
    fn at_most(&self, other: &Poly) -> bool {
        let mut budget = PROOF_BUDGET;
        return self.at_most_within(other, &mut budget);
    }

    /// `at_most`, spending `budget` as `nonnegative_within` does.
    fn at_most_within(&self, other: &Poly, budget: &mut i32) -> bool {
        return match other.try_sub(self) {
            Some(d) => d.nonnegative_within(budget),
            None => false,
        };
    }

    /// Whether every value of the symbols makes this at least 0. Where bounding
    /// each term apart cannot tell, a derived term is compared with the rest
    /// through the operation that derives it, as `N - max(N - 1, 0)` is
    /// compared by `N - 1` and by `0`.
    pub fn is_nonnegative(&self) -> bool {
        let mut budget = PROOF_BUDGET;
        return self.nonnegative_within(&mut budget);
    }

    /// `is_nonnegative`, answering false once `budget` comparisons through a
    /// derived term have failed. Each derived term may be compared first, so
    /// a sum of them no input keeps nonnegative is otherwise tried in every order.
    fn nonnegative_within(&self, budget: &mut i32) -> bool {
        let [low, _] = self.bounds();
        if low >= 0 {
            return true;
        }
        for let [i, t] of self.terms.into_iter().enumerate() {
            if *budget <= 0 {
                return false;
            }
            if t.symbols.len() != 1 || !(t.coefficient == 1 || t.coefficient == -1) {
                continue;
            }
            let Some(d) = t.symbols[0].derivation else {
                continue;
            };
            let mut rest = *self;
            rest.terms.remove(i);
            // `rest + v >= 0` is `v >= -rest`, and `rest - v >= 0` is `v <= rest`.
            let holds = if t.coefficient == 1 {
                match Poly::constant(0).try_sub(&rest) {
                    Some(floor) => d.at_least(&floor, budget),
                    None => false,
                }
            } else {
                d.at_most(&rest, budget);
            };
            if holds {
                return true;
            }
            *budget -= 1;
        }
        return false;
    }

    /// Whether every value of the symbols makes this below 0.
    pub fn is_negative(&self) -> bool {
        let [_, high] = self.bounds();
        if high < 0 {
            return true;
        }
        return match Poly::constant(-1).try_sub(self) {
            Some(below) => below.is_nonnegative(),
            None => false,
        };
    }

    /// A lower and an upper bound on the value, over every value of the
    /// symbols, each term bounded apart. An input symbol is an extent, within
    /// `[0, i32::MAX]`, and a derived one lies within what its operation leaves.
    fn bounds(&self) -> [i128, i128] {
        let [mut low, mut high] = [0_i128, 0_i128];
        for let t of &self.terms {
            let [l, h] = t.range();
            low = lower_sum(low, l);
            high = upper_sum(high, h);
        }
        return [low, high];
    }

    /// Whether every value of the symbols keeps this within `i64`, and every
    /// partial sum `forward` computes on the way, term by term, and every
    /// derived symbol's operands. Stage 0's own algebra is exact however large
    /// it grows; this is what a value the run computes in `i64` needs. A
    /// partial sum lies between the negative terms' sum and the positive terms'.
    pub fn fits_i64(&self) -> bool {
        let [mut low, mut high] = [0_i128, 0_i128];
        for let t of &self.terms {
            let [l, h] = t.range();
            low += i128::min(l, 0);
            high += i128::max(h, 0);
            for let s of &t.symbols {
                if let Some(d) = s.derivation {
                    for let o of &d.operands {
                        if !o.fits_i64() {
                            return false;
                        }
                    }
                }
            }
        }
        return i64::MIN as i128 <= low && high <= i64::MAX as i128;
    }

    /// `terms` summed into canonical form, or `None` where a sum leaves `i64`.
    fn collected(terms: List<Term>) -> Option<Poly> {
        let mut sorted = terms;
        sorted.sort_by(|a, b| order(a, b));
        let mut out: List<Term> = [];
        for let t of sorted {
            let last = out.len() - 1;
            if last >= 0 && out[last].symbols == t.symbols {
                out[last].coefficient = narrowed(out[last].coefficient as i128 + t.coefficient as i128)?;
            } else {
                out.push(t);
            }
        }
        let mut kept: List<Term> = [];
        for let t of out {
            if t.coefficient != 0 {
                kept.push(t);
            }
        }
        return Option::Some(Poly { terms: kept });
    }
}

impl Term {
    /// A lower and an upper bound on the term, its symbols' ranges multiplied.
    /// Held within `REACH_LIMIT` either way.
    fn range(&self) -> [i128, i128] {
        let mut range = [self.coefficient as i128, self.coefficient as i128];
        for let s of &self.symbols {
            let [low, high] = range;
            let [a, b] = s.range;
            range = span([
                product(low, a),
                product(low, b),
                product(high, a),
                product(high, b),
            ]);
        }
        return range;
    }
}

/// The least and the greatest of `corners`.
fn span(corners: List<i128>) -> [i128, i128] {
    return [
        corners.into_iter().min().unwrap(),
        corners.into_iter().max().unwrap(),
    ];
}

/// `value`, where an `i64` holds it.
fn narrowed(value: i128) -> Option<i64> {
    return match i64::try_from(value) {
        Ok(v) => Option::Some(v),
        Err(_) => null,
    };
}

/// How far a bound reaches before it is held: 2^64, past any `i64` constant a
/// sum adds it to. A bound held there on its own side, a lower one at
/// `-REACH_LIMIT` or an upper one at `REACH_LIMIT`, is no bound at all, and
/// every sum and quotient over it stays none.
global REACH_LIMIT: i128 = (i64::MAX as i128 + 1) * 2;

/// How many comparisons through a derived term may fail before a proof gives
/// up, which then owes what it could not show rather than stalling the build.
global PROOF_BUDGET: i32 = 256;

/// The sum of two lower bounds, held within `REACH_LIMIT`.
fn lower_sum(a: i128, b: i128) -> i128 {
    if a == -REACH_LIMIT || b == -REACH_LIMIT {
        return -REACH_LIMIT;
    }
    return i128::clamp(a + b, -REACH_LIMIT, REACH_LIMIT);
}

/// The sum of two upper bounds, held within `REACH_LIMIT`.
fn upper_sum(a: i128, b: i128) -> i128 {
    if a == REACH_LIMIT || b == REACH_LIMIT {
        return REACH_LIMIT;
    }
    return i128::clamp(a + b, -REACH_LIMIT, REACH_LIMIT);
}

/// `a * b`, held within `REACH_LIMIT` either way.
fn product(a: i128, b: i128) -> i128 {
    if a == 0 || b == 0 {
        return 0;
    }
    if i128::abs(a) > REACH_LIMIT / i128::abs(b) {
        return if (a < 0) == (b < 0) { REACH_LIMIT } else { -REACH_LIMIT };
    }
    return a * b;
}

/// `a / d` rounded up, for a positive `d`. Wide, since a bound on a
/// polynomial, and the span between any two `i64`, lie past `i64`.
pub fn ceiling(a: i128, d: i128) -> i128 {
    assert d > 0;
    return if a >= 0 { (a + d - 1) / d } else { a / d };
}

/// `a / d` rounded as the quotient `op` rounds it, for a positive `d`.
fn rounded(op: Op, a: i128, d: i128) -> i128 {
    return match op {
        CeilDiv => ceiling(a, d),
        FloorDiv => -ceiling(-a, d),
        _ => unreachable(),
    };
}

/// Higher degree first, then by the symbols, so the constant is last.
fn order(a: &Term, b: &Term) -> Ordering {
    if a.symbols.len() != b.symbols.len() {
        return b.symbols.len().cmp(&a.symbols.len());
    }
    return a.symbols.cmp(&b.symbols);
}

/// `whole` with each of `part` taken out once, or `None` where one is missing.
fn without(whole: &List<Symbol>, part: &List<Symbol>) -> Option<List<Symbol>> {
    let mut rest = *whole;
    for let s of *part {
        rest.remove(rest.position(|r| r == s)?);
    }
    return Option::Some(rest);
}

impl Poly {
    /// The polynomial as an arithmetic expression, each input symbol spelled as
    /// `names` maps it, which it must, and each derived one as the runtime
    /// computes it.
    pub fn spelled(&self, names: &TreeMap<String, String>) -> String {
        return self.written(names, true);
    }

    fn written(&self, names: &TreeMap<String, String>, code: bool) -> String {
        if self.terms.is_empty() {
            return "0";
        }
        let mut out = String::with_capacity(16);
        for let [i, t] of self.terms.into_iter().enumerate() {
            if i == 0 {
                out.push_str(if t.coefficient < 0 { "-" } else { "" });
            } else if t.coefficient == i64::MIN {
                // Its magnitude is past `i64`, so only a negative literal spells it.
                out.push_str(" + -");
            } else {
                out.push_str(if t.coefficient < 0 { " - " } else { " + " });
            }
            // Wide, since `i64::MIN` has no magnitude in `i64`.
            let magnitude = i128::abs(t.coefficient as i128);
            let mut factors: List<String> = [];
            if magnitude != 1 || t.symbols.is_empty() {
                factors.push(`${magnitude}`);
            }
            for let s of t.symbols {
                factors.push(match s.derivation {
                    Some(d) => d.written(names, code),
                    None => if code { names.get(s.name).unwrap() } else { quoted(&s.name) },
                });
            }
            out.push_str(&factors.join(" * "));
        }
        return out;
    }
}

impl Display for Poly {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(self.written(&TreeMap::<String, String>::new(), false));
    }
}
