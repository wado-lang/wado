//! A sliding window's geometry, which `Conv` and `MaxPool` share: the
//! attributes ONNX gives both, and the output extents they imply.

use { AttrError, Node } from "./graph.wado";
use { Condition, Poly, owe } from "./poly.wado";

/// A window as stage 0 reads it. The input's spatial extents may be symbolic,
/// and so may the padding `SAME` derives from them and the output extents.
pub struct Geometry {
    pub kernel: List<i32>,
    pub strides: List<i32>,
    pub dilations: List<i32>,
    /// Every spatial axis's leading padding, then every one's trailing.
    pub pads: List<Poly>,
    pub output: List<Poly>,
}

/// The window of `kernel` extents that `node` slides over the spatial extents
/// `input`. `ceil` rounds a partial last step up, as `MaxPool`'s `ceil_mode`
/// does. `owed` gains that the padded input holds the kernel, where only the
/// run knows.
pub fn window_over(
    node: &Node,
    input: &List<Poly>,
    kernel: List<i32>,
    ceil: bool,
    owed: &mut List<Condition>,
) -> Result<Geometry, AttrError> {
    let spatial = input.len();
    let strides = ints(node, "strides", spatial, 1)?;
    let dilations = ints(node, "dilations", spatial, 1)?;
    let mode = match node.attr("auto_pad") {
        Some(a) => a.values[0],
        None => "NOTSET",
    };
    let written = ints(node, "pads", 2 * spatial, 0)?;
    let site = node.site();
    let mut leading: List<Poly> = [];
    let mut trailing: List<Poly> = [];
    let mut output: List<Poly> = [];
    for let i of 0..<spatial {
        let x = &input[i];
        let stride = Poly::constant(strides[i] as i64);
        let reach = dilations[i] as i64 * (kernel[i] as i64 - 1) + 1;
        if mode == "SAME_UPPER" || mode == "SAME_LOWER" {
            let out = Poly::ceil_div(x, &stride, &site);
            let last_start = times(&diff(&out, &Poly::constant(1)), &stride);
            let covered = diff(&add(&last_start, &Poly::constant(reach)), x);
            let total = Poly::max_of(&covered, &Poly::constant(0), &site);
            let half = Poly::floor_div(&total, &Poly::constant(2), &site);
            let before = if mode == "SAME_UPPER" { half } else { diff(&total, &half) };
            leading.push(before);
            trailing.push(diff(&total, &before));
            output.push(out);
            continue;
        }
        let [before, after] = if mode == "VALID" {
            [0 as i64, 0 as i64];
        } else if mode == "NOTSET" {
            [written[i] as i64, written[spatial + i] as i64];
        } else {
            return Result::Err(AttrError { attr: "auto_pad", reason: `is ${mode}, which ONNX does not define` });
        };
        let padded = add(x, &Poly::constant(before + after));
        let span = diff(&padded, &Poly::constant(reach));
        owe(
            owed,
            &site,
            &span,
            `the padded input's ${padded} must hold the kernel's reach of ${reach} along spatial axis ${i}`,
        ).map_err(|reason| AttrError { attr: "kernel_shape", reason })?;
        let steps = if ceil { Poly::ceil_div(&span, &stride, &site) } else { Poly::floor_div(&span, &stride, &site) };
        let mut out = add(&steps, &Poly::constant(1));
        if ceil {
            // A last window that would start in the trailing pad covers no
            // input, and ONNX drops it: once, where it starts there.
            let starts = Poly::ceil_div(&add(x, &Poly::constant(before)), &stride, &site);
            let dropped = Poly::clamped(&diff(&out, &starts), &Poly::constant(0), &Poly::constant(1), &site);
            out = diff(&out, &dropped);
        }
        leading.push(Poly::constant(before));
        trailing.push(Poly::constant(after));
        output.push(out);
    }
    let mut pads = leading;
    pads.extend(&trailing);
    return Result::Ok(Geometry { kernel, strides, dilations, pads, output });
}

// A window's arithmetic stays within `i64`, which each helper's `unwrap`
// asserts: an extent is at most `i32::MAX`, and an attribute is an `i32`.

fn add(a: &Poly, b: &Poly) -> Poly {
    return a.try_add(b).unwrap();
}

fn diff(a: &Poly, b: &Poly) -> Poly {
    return a.try_sub(b).unwrap();
}

fn times(a: &Poly, b: &Poly) -> Poly {
    return a.try_mul(b).unwrap();
}

/// An integer list attribute of `count` entries no smaller than `least`, each
/// `least` where the attribute is absent.
pub fn ints(node: &Node, name: String, count: i32, least: i32) -> Result<List<i32>, AttrError> {
    let Some(attr) = node.attr(name) else {
        return Result::Ok(List::<i32>::filled(count, least));
    };
    if attr.values.len() != count {
        return Result::Err(AttrError {
            attr: name,
            reason: `holds ${attr.values.len()} values and the operator reads ${count}`,
        });
    }
    let mut values: List<i32> = [];
    for let v of attr.ints()? {
        if v < least as i64 {
            return Result::Err(AttrError { attr: name, reason: `holds ${v}, below ${least}` });
        }
        if v > i32::MAX as i64 {
            return Result::Err(AttrError { attr: name, reason: `holds ${v}, past i32::MAX` });
        }
        values.push(v as i32);
    }
    return Result::Ok(values);
}
