//! An axis's length as stage 0 knows it, and the one question stage 0 asks of
//! two of them.

use { TreeMap, TreeSet } from "core:collections";
use { Condition, Poly } from "./poly.wado";

/// A length the graph states, one only the run knows, or none at all.
/// See WEP 2026-09-20 § "Axis Identity Is a Type, Extents Are Values".
pub variant Extent {
    Static(i32),
    /// A polynomial over the graph's symbols. One with no symbol left is `Static`.
    Symbolic(Poly),
    /// A part of a merge the layout names, whose own length nothing states.
    Unstated,
}

impl Extent {
    /// The length a `dim_param` names.
    pub fn symbol(name: &String) -> Extent {
        return Extent::Symbolic(Poly::symbol(name));
    }

    /// The length a `dim_param` names: the polynomial it spells where it is
    /// arithmetic over names (`spelled_poly`), else one symbol of its own.
    pub fn param(text: &String) -> Extent {
        if let Some(p) = spelled_poly(text, &TreeMap::<String, i32>::new()) && let Some(e) = Extent::of(p) {
            return e;
        }
        return Extent::symbol(text);
    }

    /// The symbol the length is, where it is one symbol and nothing more.
    pub fn lone_symbol(&self) -> Option<String> {
        let Symbolic(p) = *self else {
            return null;
        };
        let read = p.symbols();
        if read.len() != 1 || p != Poly::symbol(&read[0]) {
            return null;
        }
        return Option::Some(read[0]);
    }

    /// `p` as an extent, or `None` where it is a constant no list can be long.
    pub fn of(p: Poly) -> Option<Extent> {
        let Some(c) = p.as_constant() else {
            return Option::Some(Extent::Symbolic(p));
        };
        if !(0 <= c <= i32::MAX as i64) {
            return null;
        }
        return Option::Some(Extent::Static(c as i32));
    }

    /// The length as a polynomial. The caller has shown it stated.
    pub fn poly(&self) -> Poly {
        return match self {
            Static(n) => Poly::constant(*n as i64),
            Symbolic(p) => *p,
            Unstated => unreachable(),
        };
    }

    /// Whether anything states the length, as a merge's layout-named part leaves none.
    pub fn is_stated(&self) -> bool {
        return !self matches { Unstated };
    }

    /// Whether stage 0 can prove these are the same length: the same number, or
    /// the same polynomial of the same symbols. A symbol proves nothing about a
    /// number.
    pub fn agrees(&self, other: &Extent) -> bool {
        return self.is_stated() && other.is_stated() && self.poly() == other.poly();
    }

    /// What the inputs owe for stage 0 to count these as one length: nothing
    /// where they agree, and where they agree only once each derived symbol is
    /// read as `Poly::presumed` reads it, what that reading owes. Only the
    /// difference is read, so a derived term both share owes nothing. `None`
    /// where no reading makes them one length.
    pub fn agreement(&self, other: &Extent) -> Option<List<Condition>> {
        if !self.is_stated() || !other.is_stated() {
            return null;
        }
        let mut conditions: List<Condition> = [];
        let difference = self.poly().try_sub(&other.poly())?.presumed(&mut conditions)?;
        return if difference == Poly::constant(0) { Option::Some(conditions) } else { null };
    }

    /// Whether the length reads a symbol the run derives.
    pub fn is_derived(&self) -> bool {
        return self matches { Symbolic(p) && p.is_derived() };
    }

    /// Whether this is the extent ONNX's broadcasting stretches to any other.
    pub fn is_one(&self) -> bool {
        return self matches { Static(1) };
    }

    /// `agreement` with 1, which `is_one` asks without reading anything as
    /// its operand.
    pub fn oneness(&self) -> Option<List<Condition>> {
        return self.agreement(&Extent::Static(1));
    }
}

/// A symbol the run reads back from the length at `at`, which is
/// `coefficient * symbol + rest`, `rest` reading only symbols solved before.
pub struct Solved {
    pub symbol: String,
    pub at: i32,
    pub coefficient: i64,
    pub rest: Poly,
}

/// The symbols the run can read back from `extents`, each from the first
/// extent that is it alone, then each left from the first extent linear in it
/// once those before it are solved, in the order the run solves them.
pub fn solved(extents: &List<Extent>) -> List<Solved> {
    let mut found: List<Solved> = [];
    let mut known = TreeSet::<String>::new();
    for let alone of [true, false] {
        let mut more = true;
        while more {
            more = false;
            for let [at, e] of extents.into_iter().enumerate() {
                let Symbolic(p) = *e else {
                    continue;
                };
                let open: List<String> = p.symbols().into_iter().filter(|s| !known.contains(s)).collect();
                if open.len() != 1 || alone && e.lone_symbol() matches { None } {
                    continue;
                }
                let Some([coefficient, rest]) = p.linear_in(&open[0]) else {
                    continue;
                };
                known.insert(open[0]);
                found.push(Solved { symbol: open[0], at, coefficient, rest });
                more = true;
            }
        }
    }
    return found;
}

/// `text` as the polynomial it spells, where it splits at whitespace into names
/// and integers alternating with `+`, `-` and `*`, as an exporter writes a
/// cache's length `past_sequence_length + 1`. A name `fixed` holds is read as
/// its value. `None` for any other text, a lone name included, and where no
/// polynomial holds the value. An operator is a word of its own, so a hyphen
/// inside a name stays the name's.
pub fn spelled_poly(text: &String, fixed: &TreeMap<String, i32>) -> Option<Poly> {
    let words: List<String> = text.split_whitespace().map(|w| w.to_string()).collect();
    if words.len() < 3 || words.len() % 2 == 0 {
        return null;
    }
    let mut sum = Poly::constant(0);
    let mut sign = 1 as i64;
    let mut product = operand(&words[0], fixed)?;
    for let i of (1..<words.len()).step_by(2) {
        let next = operand(&words[i + 1], fixed)?;
        let op = words[i];
        if op == "*" {
            product = product.try_mul(&next)?;
            continue;
        }
        if op != "+" && op != "-" {
            return null;
        }
        sum = sum.try_add(&product.try_mul(&Poly::constant(sign))?)?;
        sign = if op == "+" { 1 } else { -1 };
        product = next;
    }
    return sum.try_add(&product.try_mul(&Poly::constant(sign))?);
}

/// One operand of `spelled_poly`: an integer, or a name.
fn operand(word: &String, fixed: &TreeMap<String, i32>) -> Option<Poly> {
    if word.chars().all(|c| c.is_ascii_digit()) {
        return match i64::from_str(word) {
            Ok(n) => Option::Some(Poly::constant(n)),
            Err(_) => null,
        };
    }
    let mut chars = word.chars();
    let Some(first) = chars.next() else {
        return null;
    };
    if !(first.is_ascii_alphabetic() || first == '_') || !chars.all(|c| c.is_ascii_alphanumeric() || c == '_') {
        return null;
    }
    if let Some(value) = fixed.get(*word) {
        return Option::Some(Poly::constant(value as i64));
    }
    return Option::Some(Poly::symbol(word));
}

impl Display for Extent {
    fn fmt(&self, f: &mut Formatter) {
        match self {
            Static(n) => f.write_str(`${n}`),
            Symbolic(p) => p.fmt(f),
            Unstated => f.write_str("?"),
        }
    }
}
