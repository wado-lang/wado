//! What the invocation fixes before stage 0 reads a graph: extents for its
//! symbolic dimensions, the outputs `forward` returns, and the outputs it
//! returns the last position of.

use { HashMap, HashSet, TreeMap } from "core:collections";
use { Extent, spelled_poly } from "./extent.wado";
use { Attr, Dim, Graph, Node, Rank, ValueInfo, is_binary_elementwise, read_at } from "./graph.wado";
use { is_reduction, is_unary_elementwise } from "./infer.wado";
use { Shape } from "./shape.wado";

/// An invocation option the graph cannot take, and why.
pub struct OptionConflict {
    pub option: String,
    pub reason: String,
}

impl Display for OptionConflict {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(`${self.option}: ${self.reason}`);
    }
}

impl Error for OptionConflict {
}

fn conflict<T>(option: String, reason: String) -> Result<T, OptionConflict> {
    return Result::Err(OptionConflict { option, reason });
}

/// Every `dim_param` that `dims` names, made the static extent it gives. A name
/// the graph never declares fixes nothing, so it is a mistake in the option.
pub fn bind_dims(graph: &mut Graph, dims: &TreeMap<String, i32>) -> Result<(), OptionConflict> {
    for let [name, extent] of dims.entries() {
        if *extent < 0 {
            return conflict("dims", `${name} is ${extent}, and an extent is not negative`);
        }
    }
    let mut bound = HashSet::<String>::new();
    for let vi of &mut graph.inputs {
        bind(vi, dims, &mut bound)?;
    }
    for let vi of &mut graph.outputs {
        bind(vi, dims, &mut bound)?;
    }
    for let [name, _] of dims.entries() {
        if !bound.contains(*name) {
            return conflict("dims", `the graph declares no dimension ${name}`);
        }
    }
    return Result::Ok(());
}

fn bind(vi: &mut ValueInfo, dims: &TreeMap<String, i32>, bound: &mut HashSet<String>) -> Result<(), OptionConflict> {
    let Dims(written) = vi.rank else {
        return Result::Ok(());
    };
    let mut fixed: List<Dim> = [];
    for let d of written {
        let Symbol(name) = d else {
            fixed.push(d);
            continue;
        };
        if let Some(extent) = dims.get(name) {
            bound.insert(name);
            fixed.push(Dim::Static(extent));
        } else if let Some(extent) = spelled_extent(&name, dims, bound)? {
            fixed.push(Dim::Static(extent));
        } else {
            fixed.push(d);
        }
    }
    vi.rank = Rank::Dims(fixed);
    return Result::Ok(());
}

/// The extent a `dim_param` spelling arithmetic over names (`spelled_poly`)
/// takes once `dims` fixes every name it reads, or `None` where it fixes none.
fn spelled_extent(
    name: &String,
    dims: &TreeMap<String, i32>,
    bound: &mut HashSet<String>,
) -> Result<Option<i32>, OptionConflict> {
    let Some(free) = spelled_poly(name, &TreeMap::<String, i32>::new()) else {
        return Result::Ok(null);
    };
    let read = free.symbols();
    let fixing: List<String> = read.into_iter().filter(|s| dims.contains_key(s)).collect();
    if fixing.is_empty() {
        return Result::Ok(null);
    }
    let by = fixing.join(", ");
    let Some(value) = spelled_poly(name, dims) else {
        return conflict("dims", `${by} makes the dimension ${*name:?} more than i64 holds`);
    };
    let Some(n) = value.as_constant() else {
        let open: List<String> = read.into_iter().filter(|s| !dims.contains_key(s)).collect();
        return conflict("dims", `${by} fixes part of the dimension ${*name:?}, which also reads ${open.join(", ")}`);
    };
    if n < 0 {
        return conflict("dims", `${by} makes the dimension ${*name:?} ${n}, and an extent is not negative`);
    }
    if n > i32::MAX as i64 {
        return conflict("dims", `${by} makes the dimension ${*name:?} ${n}, which no list holds`);
    }
    for let s of fixing {
        bound.insert(s);
    }
    return Result::Ok(Option::Some(n as i32));
}

/// The graph cut down to what the outputs `names` lists read, which it returns
/// in that order. An empty list keeps the graph whole.
pub fn keep_outputs(graph: &mut Graph, names: &List<String>) -> Result<(), OptionConflict> {
    if names.is_empty() {
        return Result::Ok(());
    }
    let mut outputs: List<ValueInfo> = [];
    let mut needed = HashSet::<String>::new();
    for let name of *names {
        let Some(at) = graph.outputs.position(|vi| vi.name == name) else {
            return conflict("outputs", `the graph declares no output ${name}`);
        };
        outputs.push(graph.outputs[at]);
        needed.insert(name);
    }
    graph.outputs = outputs;
    let mut nodes: List<Node> = [];
    for let mut i = graph.nodes.len() - 1; i >= 0; i -= 1 {
        let node = graph.nodes[i];
        if !produces_any(&node, &needed) {
            continue;
        }
        for let input of node.reads() {
            needed.insert(input);
        }
        nodes.push(node);
    }
    nodes.reverse();
    graph.nodes = nodes;
    graph.inputs = read_of(&graph.inputs, &needed);
    graph.initializers = read_of(&graph.initializers, &needed);
    return Result::Ok(());
}

/// `output` cut to its last position along `axis`, as a language model's next
/// token reads only the last position's logits. The cut moves back through the
/// nodes that compute each position along that axis from the same position of
/// their operands, so those compute the one position kept: an elementwise
/// operator, a reduction keeping the axis, and a product along its rows.
/// `shapes` is what checking the graph as it stands found: each operand's
/// rank, and the axes that broadcast.
pub fn keep_last(
    graph: &mut Graph,
    shapes: &HashMap<String, Shape>,
    output: &String,
    axis: i32,
) -> Result<(), OptionConflict> {
    let Some(at) = graph.outputs.position(|vi| vi.name == *output) else {
        return conflict("last", `the graph declares no output ${*output}`);
    };
    let rank = shapes.get(*output).unwrap().rank();
    if axis < 0 || axis >= rank {
        return conflict("last", `${*output} has ${rank} axes, and no axis ${axis}`);
    }
    if graph.nodes.into_iter().any(|n| n.reads().contains_str(output)) {
        return conflict("last", `${*output} is read inside the graph, which needs all of it`);
    }
    cut_last(graph, shapes, output, axis - rank);
    if let Dims(written) = graph.outputs[at].rank {
        let mut declared = written;
        declared[axis] = Dim::Static(1);
        graph.outputs[at].rank = Rank::Dims(declared);
    }
    return Result::Ok(());
}

/// `output` cut to its last position along `axis`, counted from the end.
fn cut_last(graph: &mut Graph, shapes: &HashMap<String, Shape>, output: &String, axis: i32) {
    let mut readers: HashMap<String, List<i32>> = HashMap::new();
    let mut producer: HashMap<String, i32> = HashMap::new();
    for let [i, node] of graph.nodes.into_iter().enumerate() {
        for let input of node.reads() {
            read_at(&mut readers, &input, i);
        }
        for let o of node.outputs {
            producer[o] = i;
        }
    }
    // The scope reads what it returns, at no node's position, so another
    // output stays whole.
    for let vi of &graph.outputs {
        if vi.name != *output {
            read_at(&mut readers, &vi.name, -1);
        }
    }
    // A node computes one position where every value it writes is read only at
    // that position by nodes that do, or is the output itself. Readers come
    // later, so a walk from the end decides them first. Each cut node maps to
    // which of its operands it reads at that position.
    let mut cut = HashMap::<i32, List<bool>>::new();
    for let mut i = graph.nodes.len() - 1; i >= 0; i -= 1 {
        let node = &graph.nodes[i];
        let Some(positional) = positional_reads(node, shapes, axis) else {
            continue;
        };
        let kept = node.outputs.into_iter().all(|o| {
            if o == *output {
                return true;
            }
            let read = readers.get(o).unwrap_or([]);
            return !read.is_empty() && read.into_iter().all(|r| cut.get(r) matches {
                Some(p) && reads_only_at_position(&graph.nodes[r], &p, &o)
            });
        });
        if kept {
            cut[i] = positional;
        }
    }
    // A cut of another output along the same axis made these already, ahead
    // of the slices it made, so they go first again, ahead of this cut's.
    let starts = `loam.last${axis}.starts`;
    let ends = `loam.last${axis}.ends`;
    let axes = `loam.last${axis}.axes`;
    let bounds = [starts, ends, axes] as List<String>;
    let mut nodes: List<Node> = [
        ints(&starts, -1),
        ints(&ends, i64::MAX),
        ints(&axes, axis as i64),
    ];
    let sliced_name = |input: &String| `${*input}/last${axis}`;
    let slice = |input: &String, sliced: String| Node {
        op: "Slice",
        outputs: [sliced],
        inputs: [*input, starts, ends, axes],
        attrs: [],
    };
    // The cut nodes read their operands from outside the cut sliced, and each
    // slice follows what writes its operand, so it precedes every reader.
    let mut wanted = HashSet::<String>::new();
    let mut written = graph.nodes;
    for let [i, positional] of cut.entries() {
        let node = &mut written[*i];
        for let j of 0..<node.inputs.len() {
            let input = node.inputs[j];
            let from_cut = producer.get(input) matches { Some(p) && cut.contains_key(p) };
            if input == "" || from_cut || !positional[j] || !spans(&shapes.get(input).unwrap(), axis) {
                continue;
            }
            node.inputs[j] = sliced_name(&input);
            if !producer.contains_key(node.inputs[j]) {
                wanted.insert(input);
            }
        }
    }
    let mut slice_written = |into: &mut List<Node>, values: &List<String>| {
        for let v of *values {
            if wanted.remove(v) {
                into.push(slice(&v, sliced_name(&v)));
            }
        }
    };
    for let given of [&graph.inputs, &graph.initializers] {
        let names: List<String> = given.into_iter().map(|vi| vi.name).collect();
        slice_written(&mut nodes, &names);
    }
    for let [i, node] of written.into_iter().enumerate() {
        if node.op == "Constant" && bounds.contains_str(&node.outputs[0]) {
            continue;
        }
        if !cut.contains_key(i) && node.outputs.contains_str(output) {
            // The output's producer reads more than one position, so its
            // output is cut where it is written.
            let whole = `${*output}/whole`;
            let mut renamed = node;
            renamed.outputs = node.outputs.into_iter().map(|o| if o == *output { whole } else { o }).collect();
            nodes.push(renamed);
            nodes.push(slice(&whole, *output));
        } else {
            nodes.push(node);
        }
        slice_written(&mut nodes, &node.outputs);
    }
    assert wanted.is_empty();
    graph.nodes = nodes;
}

/// Where `node` computes each position along `axis`, counted from the end,
/// from its operands at that position and others read whole: whether it reads
/// each operand at that position. A product reads its right matrix whole, as
/// its rows are the inner axis, and a reduction its axes.
fn positional_reads(node: &Node, shapes: &HashMap<String, Shape>, axis: i32) -> Option<List<bool>> {
    let Some(out) = shapes.get(node.outputs[0]) else {
        return null;
    };
    if node.outputs.len() != 1 || out.rank() < -axis {
        return null;
    }
    let first_alone = || -> List<bool> { (0..<node.inputs.len()).map(|j| j == 0).collect() };
    if is_unary_elementwise(&node.op) || is_binary_elementwise(&node.op) {
        return Option::Some(node.inputs.into_iter().map(|_| true).collect());
    }
    if is_reduction(&node.op) {
        let x = shapes.get(node.inputs[0]).unwrap();
        if x.rank() == out.rank() && x.axes[x.rank() + axis].extent == out.axes[out.rank() + axis].extent {
            return Option::Some(first_alone());
        }
        return null;
    }
    let ranks = |j: i32| shapes.get(node.inputs[j]).unwrap().rank();
    if node.op == "MatMul" && axis == -2 && ranks(0) >= 2 && ranks(1) >= 2 {
        return Option::Some(first_alone());
    }
    return null;
}

/// Whether `node` reads `value` only as operands it reads at the cut
/// position, as `positional` says.
fn reads_only_at_position(node: &Node, positional: &List<bool>, value: &String) -> bool {
    for let [j, input] of node.inputs.into_iter().enumerate() {
        if input == *value && !positional[j] {
            return false;
        }
    }
    return true;
}

/// Whether `shape` has `axis`, counted from the end, at more than one
/// position: an operand that lacks it, or holds one there, broadcasts.
fn spans(shape: &Shape, axis: i32) -> bool {
    return shape.rank() >= -axis && shape.axes[shape.rank() + axis].extent != Extent::Static(1);
}

/// A `Constant` of the one `i64` `value`, named `name`.
fn ints(name: &String, value: i64) -> Node {
    return Node {
        op: "Constant",
        outputs: [*name],
        inputs: [],
        attrs: [
            Attr {
                name: "value_ints",
                values: [`${value}`],
                is_list: true,
            },
        ],
    };
}

fn produces_any(node: &Node, needed: &HashSet<String>) -> bool {
    for let output of node.outputs {
        if needed.contains(output) {
            return true;
        }
    }
    return false;
}

fn read_of(declared: &List<ValueInfo>, needed: &HashSet<String>) -> List<ValueInfo> {
    let mut kept: List<ValueInfo> = [];
    for let vi of *declared {
        if needed.contains(vi.name) {
            kept.push(vi);
        }
    }
    return kept;
}
