//! Which lengths the run may pad to a capacity, decided at build time. A padded
//! axis keeps its valid elements a prefix, so each operator keeps the padding
//! apart, reads it masked to its identity, or refuses the length. See
//! devices.md § "An extent that varies is a capacity".

use { HashMap } from "core:collections";
use { GROUP_QUERY_ATTENTION, Graph, Node, is_binary_elementwise } from "./graph.wado";
use {
    Checked,
    attention_options,
    gemm_options,
    is_unary_elementwise,
    owed_presumed,
    split_axis,
    transpose_perm,
} from "./infer.wado";
use { branches } from "./lowering.wado";
use { Poly, equalities } from "./poly.wado";
use { Shape, short_of } from "./shape.wado";

/// Why an operator keeps a length from being padded.
#[wire(name_policy = "snake_case")]
pub enum Why {
    /// A regrouping puts the length behind an axis before it, which
    /// interleaves the padding with the valid elements.
    MergedBehind,
    /// A regrouping lines its axes up with the length's at no point.
    Unaligned,
    /// A `Split` cuts along the length, so padding lands inside a part.
    SplitAlong,
    /// A window reads padding beside the valid elements.
    Window,
    /// An extent may fall as the length rises, so a capacity past the length
    /// may hold fewer elements than the length's own extent.
    Shrinks,
    /// An attention that is not causal reads the padded keys, past and new.
    Acausal,
    /// The graph owes the length equal to a sum of lengths, one of them
    /// refused, whose exact extent a capacity would not match.
    Tied,
    /// A node reads across the rows a regrouping merged the length behind,
    /// where their padding lies between them.
    ReadsMerged,
}

impl Display for Why {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(match self {
            MergedBehind => "it merges behind an axis before it",
            Unaligned => "the regrouping lines up with it at no axis",
            SplitAlong => "it splits along it",
            Window => "a window reads across it",
            Shrinks => "an extent may fall as it rises",
            Acausal => "a non-causal attention reads every key",
            Tied => "it must equal a sum of lengths, one refused there",
            ReadsMerged => "it reads rows a regrouping merged",
        });
    }
}

/// The node that keeps a length from being padded: its first output, its
/// operator, and why.
pub struct PadRefusal {
    pub node: String,
    pub op: String,
    pub why: Why,
}

/// One symbol an input's axes read, padded unless a node refused it.
pub struct Judged {
    pub symbol: String,
    pub refused: Option<PadRefusal> = null,
}

impl Display for Judged {
    fn fmt(&self, f: &mut Formatter) {
        match &self.refused {
            None => f.write_str(`${self.symbol}: padded`),
            Some(r) => f.write_str(`${self.symbol}: refused at ${r.node} = ${r.op}: ${r.why}`),
        }
    }
}

/// Each symbol an input's axes read, in the order they first read it.
pub fn padding(graph: &Graph, checked: &Checked) -> List<Judged> {
    let mut refusals = HashMap::<String, PadRefusal>::new();
    let mut ties: List<Poly> = [];
    judge_scope(graph, checked, &mut refusals, &mut ties, &mut HashMap::<String, Merges>::new());
    // A refusal spreads to every length it is owed equal to a sum with,
    // through as many equalities as link them.
    let mut spread = true;
    while spread {
        spread = false;
        for let slack of &ties {
            let read = slack.symbols();
            let Some(first) = read.into_iter().find(|s| refusals.contains_key(s)) else {
                continue;
            };
            let at = refusals[first];
            for let symbol of read {
                if !refusals.contains_key(symbol) {
                    refusals[symbol] = PadRefusal { node: at.node, op: at.op, why: Why::Tied };
                    spread = true;
                }
            }
        }
    }
    let mut symbols: List<Judged> = [];
    for let vi of &graph.inputs {
        for let axis of checked.shapes[vi.name].axes {
            for let symbol of axis.extent.poly().symbols() {
                if !symbols.into_iter().any(|j| j.symbol == symbol) {
                    symbols.push(Judged { symbol, refused: refusals.get(symbol) });
                }
            }
        }
    }
    return symbols;
}

/// What each axis of a tensor merged: the extents a regrouping merged into it,
/// the first leading, where a length may sit behind the first; none where its
/// valid elements are a prefix.
type Merges = List<Option<List<Poly>>>;

/// Each refusal the nodes of a scope make, the first one per symbol kept, and
/// each slack the scope owes to be 0. `merged` holds the tensors with an axis
/// that merged lengths behind its first extent: each row's padding lies inside
/// it, so a node may only compute each of its elements apart until a
/// regrouping splits it back.
fn judge_scope(
    graph: &Graph,
    checked: &Checked,
    refusals: &mut HashMap<String, PadRefusal>,
    ties: &mut List<Poly>,
    merged: &mut HashMap<String, Merges>,
) {
    ties.extend(&equalities(&checked.owed));
    for let node of &graph.nodes {
        let mut refuse = |read: List<String>, why: Why| {
            for let symbol of read {
                if !refusals.contains_key(symbol) {
                    refusals[symbol] = PadRefusal { node: node.outputs[0], op: node.op, why };
                }
            }
        };
        let folded = node.outputs.into_iter().all(|t| checked.known.contains_key(t));
        if !folded && let Some([read, why]) = refused_by(node, checked) {
            refuse(read, why);
        }
        if !folded {
            match carried(node, checked, merged) {
                Ok(Some(merges)) && merges.into_iter().any(|m| m matches { Some(_) }) => {
                    merged[node.outputs[0]] = merges;
                },
                Ok(_) => {
                },
                Err([read, why]) => refuse(read, why),
            }
        }
        // A folded output is spelled at the capacity too.
        refuse(shrinking(node, checked), Why::Shrinks);
        if !folded && checked.branches.contains_key(node.outputs[0]) {
            for let b of branches(node, checked) {
                judge_scope(&b.graph, &b.checked, refusals, ties, merged);
            }
        }
    }
    // Read back cut to their lengths, the outputs keep their valid elements a
    // prefix.
    for let vi of &graph.outputs {
        let Some(merges) = merged.get(vi.name) else {
            continue;
        };
        let node = graph.nodes.into_iter().find(|n| n.outputs.contains(&vi.name)).unwrap();
        for let symbol of behind(&merges) {
            if !refusals.contains_key(symbol) {
                refusals[symbol] = PadRefusal { node: vi.name, op: node.op, why: Why::MergedBehind };
            }
        }
    }
}

/// The symbols an extent behind the first of each merged axis reads.
fn behind(merges: &Merges) -> List<String> {
    let mut read: List<String> = [];
    for let m of merges {
        if let Some(extents) = m {
            for let e of extents.into_iter().skip(1) {
                read.extend(&e.symbols());
            }
        }
    }
    return read;
}

/// What `node`'s output merged, where it carries a merged axis, or why it
/// refuses the lengths an operand merged: an output axis carries one only from
/// an operand axis of the same elements, which `node` computes apart.
fn carried(
    node: &Node,
    checked: &Checked,
    merged: &HashMap<String, Merges>,
) -> Result<Option<Merges>, [List<String>, Why]> {
    let op = node.op;
    let shapes = &checked.shapes;
    if op == "Reshape" || op == "Flatten" || op == "Squeeze" || op == "Unsqueeze" {
        // A folded operand stage 0 gives no axes holds no padding.
        let Some(x) = shapes.get(node.inputs[0]) else {
            return Result::Ok(null);
        };
        return regrouped(&x, merged.get(node.inputs[0]), &shapes[node.outputs[0]]);
    }
    let mut operands: List<[i32, Merges]> = [];
    for let [at, t] of node.inputs.into_iter().enumerate() {
        if let Some(m) = merged.get(t) {
            operands.push([at, m]);
        }
    }
    if operands.is_empty() {
        return Result::Ok(null);
    }
    let reads = || {
        let mut read: List<String> = [];
        for let [_, m] of &operands {
            read.extend(&behind(m));
        }
        return Result::<Option<Merges>, [List<String>, Why]>::Err([read, Why::ReadsMerged]);
    };
    let out = shapes[node.outputs[0]];
    let mut merges = List::<Option<List<Poly>>>::filled(out.rank(), null) as Merges;
    if is_unary_elementwise(&op) {
        return Result::Ok(Option::Some(operands[0].1));
    }
    if op == "Transpose" {
        let perm = transpose_perm(node, out.rank()).unwrap();
        for let [k, from] of perm.into_iter().enumerate() {
            merges[k] = operands[0].1[from];
        }
        return Result::Ok(Option::Some(merges));
    }
    if is_binary_elementwise(&op) && node.attr("axis") matches { None } || op == "Where" {
        // Numpy's broadcast aligns the operands at their ends.
        for let k of 0..<out.rank() {
            let mut agreed: Option<Option<List<Poly>>> = null;
            for let t of &node.inputs {
                let shape = shapes[*t];
                let at = k - (out.rank() - shape.rank());
                if at < 0 || shape.axes[at].extent.is_one() {
                    continue;
                }
                let own = match merged.get(*t) {
                    Some(m) => m[at],
                    None => null,
                };
                if agreed matches { Some(a) && a != own } {
                    return reads();
                }
                agreed = Option::Some(own);
            }
            if let Some(a) = agreed {
                merges[k] = a;
            }
        }
        return Result::Ok(Option::Some(merges));
    }
    // A product keeps the rows of its left operand apart, the axes before the
    // one it contracts.
    let [a, a_rank] = [operands[0], shapes[node.inputs[0]].rank()];
    if operands.len() != 1 || a.0 != 0 || a_rank < 2 || a.1[a_rank - 1] matches { Some(_) } {
        return reads();
    }
    if op == "Gemm" {
        let [_, _, trans_a, _] = gemm_options(node).unwrap();
        if trans_a {
            return reads();
        }
        merges[0] = a.1[0];
        return Result::Ok(Option::Some(merges));
    }
    if op == "MatMul" {
        for let i of 0..<a_rank - 1 {
            merges[out.rank() - a_rank + i] = a.1[i];
        }
        return Result::Ok(Option::Some(merges));
    }
    return reads();
}

/// The symbols some extent of `node`'s outputs may fall as they rise. An
/// extent is read as presumed where the scope owes every condition that
/// presumes, so a bound a length is owed to stay within caps no extent.
fn shrinking(node: &Node, checked: &Checked) -> List<String> {
    let mut read: List<String> = [];
    for let output of node.outputs {
        let Some(shape) = checked.shapes.get(output) else {
            continue;
        };
        for let axis of shape.axes {
            let extent = owed_presumed(&axis.extent.poly(), checked).unwrap_or(axis.extent.poly());
            for let symbol of extent.symbols() {
                if !extent.grows_with(&symbol) {
                    read.push(symbol);
                }
            }
        }
    }
    return read;
}

/// The symbols `node` keeps from being padded, and why, where it keeps any.
fn refused_by(node: &Node, checked: &Checked) -> Option<[List<String>, Why]> {
    let shapes = &checked.shapes;
    let op = node.op;
    // Stage 0 read the options already.
    if op == GROUP_QUERY_ATTENTION && !attention_options(node).unwrap().causal {
        let mut read: List<String> = [];
        for let tensor of node.inputs.into_iter().chain(node.outputs.into_iter()) {
            // The lengths it is given, the mask's total among them, are values.
            if let Some(known) = checked.known.get(tensor) && let Symbolic(values) = known.elements {
                for let v of values {
                    read.extend(&v.symbols());
                }
            }
            let Some(shape) = shapes.get(tensor) else {
                continue;
            };
            // Each row of the batch attends on its own.
            for let axis of shape.axes.into_iter().skip(1) {
                read.extend(&axis.extent.poly().symbols());
            }
        }
        return refusing(read, Why::Acausal);
    }
    let windowed = op == "Conv" || op == "MaxPool";
    // A folded operand stage 0 gives no axes holds no padding.
    if !(windowed || op == "Split") || !shapes.contains_key(node.inputs[0]) {
        return null;
    }
    let x = shapes[node.inputs[0]];
    if op == "Split" {
        // Stage 0 resolved the axis already.
        let axis = split_axis(node, x.rank()).unwrap();
        return refusing(x.axes[axis].extent.poly().symbols(), Why::SplitAlong);
    }
    // A window runs over each row of the batch, axis 0, on its own.
    let mut read: List<String> = [];
    for let axis of x.axes.into_iter().skip(1) {
        read.extend(&axis.extent.poly().symbols());
    }
    return refusing(read, Why::Window);
}

fn refusing(read: List<String>, why: Why) -> Option<[List<String>, Why]> {
    return if read.is_empty() { null } else { Option::Some([read, why]) };
}

/// What a regrouping of `from`, which merged `merges`, into `to` merges, or the
/// symbols it reads behind the leading extent of some run and why. A run is the
/// fewest extents on each side holding the same elements, a merged axis read
/// as the extents it merged. Only a run's leading extent keeps its valid
/// elements a prefix: a run that merges into one axis leaves that axis merged,
/// and one that splits an extent refuses what lands behind. Extent-1 axes hold
/// no element, so they lead no run.
fn regrouped(from: &Shape, merges: Option<Merges>, to: &Shape) -> Result<Option<Merges>, [List<String>, Why]> {
    let mut ins: List<Poly> = [];
    for let [at, axis] of from.axes.into_iter().enumerate() {
        if axis.extent.is_one() {
            continue;
        }
        if let Some(m) = merges && let Some(extents) = m[at] {
            ins.extend(&extents);
        } else {
            ins.push(axis.extent.poly());
        }
    }
    let mut outs: List<[i32, Poly]> = [];
    for let [at, axis] of to.axes.into_iter().enumerate() {
        if !axis.extent.is_one() {
            outs.push([at, axis.extent.poly()]);
        }
    }
    let mut result = List::<Option<List<Poly>>>::filled(to.rank(), null) as Merges;
    let mut split: List<String> = [];
    let mut i = 0;
    let mut j = 0;
    while i < ins.len() && j < outs.len() {
        let [first_in, first_out] = [i, j];
        let mut consumed = ins[i];
        let mut produced = outs[j].1;
        i += 1;
        j += 1;
        while consumed != produced {
            if i < ins.len() && short_of(&consumed, &produced) && let Some(c) = consumed.try_mul(&ins[i]) {
                consumed = c;
                i += 1;
            } else if j < outs.len() && short_of(&produced, &consumed) && let Some(p) = produced.try_mul(&outs[j].1) {
                produced = p;
                j += 1;
            } else {
                let mut read = consumed.symbols();
                read.extend(&produced.symbols());
                for let e of ins.into_iter().skip(i) {
                    read.extend(&e.symbols());
                }
                for let [_, e] of outs.into_iter().skip(j) {
                    read.extend(&e.symbols());
                }
                return Result::Err([read, Why::Unaligned]);
            }
        }
        let taken = ins[first_in..<i].to_list();
        let behind_in = taken.into_iter().skip(1).any(|e| !e.symbols().is_empty());
        if j - first_out == 1 {
            if behind_in {
                result[outs[first_out].0] = Option::Some(taken);
            }
            continue;
        }
        for let [_, e] of outs[first_out + 1..<j].to_list() {
            split.extend(&e.symbols());
        }
        for let e of taken.into_iter().skip(1) {
            split.extend(&e.symbols());
        }
    }
    if !split.is_empty() {
        return Result::Err([split, Why::MergedBehind]);
    }
    return Result::Ok(Option::Some(result));
}
