//! What a graph or a tokenizer becomes, apart from where it was read: the Kiln
//! generator and the `loam` command both run it.

use { TreeMap } from "core:collections";
use { Deserialize } from "core:serde";
use { Placement, emit } from "./emit.wado";
use { emit_tokenizer } from "./emit_tokenizer.wado";
use { read as read_tokenizer } from "./tokenizer_json.wado";
use { Graph } from "./graph.wado";
use { Checked, infer } from "./infer.wado";
use { declared_header_end, read_checkpoint } from "./runtime/checkpoint.wado";
use { CheckpointFile, check_checkpoint, check_shards, placement, read_index } from "./safetensors.wado";
use onnx_proto from "./onnx_proto.wado";
use onnx_text from "./onnx_text.wado";
use { bind_dims, keep_last, keep_outputs } from "./specialize.wado";

/// The `generator.options` a `use ... with` site writes.
export struct Options {
    /// Static extents for the graph's symbolic dimensions, keyed by `dim_param`.
    pub dims: TreeMap<String, i32> = {},
    /// The graph outputs `forward` returns. Empty keeps every output.
    pub outputs: List<String> = [],
    /// Outputs `forward` returns only the last position of, each by the axis
    /// it is cut along. What computes each position from the same position of
    /// its operands computes the last alone; what reads across them, as
    /// attention does, still computes them all.
    pub last: TreeMap<String, i32> = {},
    /// Whether operators fuse into one kernel where the plan finds they can.
    /// Off, every kernel writes its output, which is what a fused module is
    /// compared against.
    pub fuse: bool = true,
}

impl Deserialize for Options;

/// How a graph is spelled, as a `type` names it: `"onnx"`, the protobuf an
/// exporter writes, or `"onnxtext"`, the text a fixture is written in and a
/// diff can show.
pub enum Spelling {
    Proto,
    Text,
}

/// The spelling `use_type` names, or `None` where it names no graph.
pub fn spelling_of(use_type: &Option<String>) -> Option<Spelling> {
    return match *use_type {
        Some("onnx") => Option::Some(Spelling::Proto),
        Some("onnxtext") => Option::Some(Spelling::Text),
        _ => null,
    };
}

/// Whatever the file is wrong about, said against its path.
fn at<E: Display>(path: &String, e: &E) -> String {
    return `loam: '${*path}': ${e}`;
}

/// `bytes` as UTF-8, or why the file at `path` is not.
fn text_of(path: &String, bytes: ByteList) -> Result<String, String> {
    return String::try_from_utf8(bytes).map_err(|e| `loam: '${*path}' is not UTF-8: ${e}`);
}

fn read_graph(path: &String, spelling: Spelling, bytes: ByteList) -> Result<Graph, String> {
    if spelling matches { Proto } {
        return onnx_proto::read(bytes).map_err(|e| at(path, &e));
    }
    return onnx_text::read(&text_of(path, bytes)?).map_err(|e| at(path, &e));
}

/// A graph, what checking it proved, and whether its kernels fuse.
pub struct Model {
    pub graph: Graph,
    pub checked: Checked,
    pub fuse: bool,
}

/// The graph at `path`, specialized by `options` and checked.
pub fn check(path: &String, spelling: Spelling, bytes: ByteList, options: &Options) -> Result<Model, String> {
    let mut graph = read_graph(path, spelling, bytes)?;
    bind_dims(&mut graph, &options.dims).map_err(|e| at(path, &e))?;
    keep_outputs(&mut graph, &options.outputs).map_err(|e| at(path, &e))?;
    // An extent the algebra cannot discharge stops the build here. The one
    // tier below this is `forward`, which checks only an inequality over the
    // input symbols.
    let mut checked = infer(&graph).map_err(|e| at(path, &e))?;
    // Where a cut can move depends on each operand's rank and on which axes
    // broadcast, which only a check of the graph as it stands knows.
    for let [output, axis] of options.last.entries() {
        keep_last(&mut graph, &checked, output, *axis).map_err(|e| at(path, &e))?;
        checked = infer(&graph).map_err(|e| at(path, &e))?;
    }
    return Result::Ok(Model { graph, checked, fuse: options.fuse });
}

/// What a graph's weights are checked against: nothing, one checkpoint file,
/// or the shards of one beside the index placing each tensor in its shard.
pub variant Weights {
    Unchecked,
    File(CheckpointFile),
    Shards(Sharded),
}

/// A sharded checkpoint: its index, by path and bytes, and the shards given.
pub struct Sharded {
    pub index_path: String,
    pub index: ByteList,
    pub shards: List<CheckpointFile>,
}

/// What the checkpoint files and indexes given amount to: a sharded
/// checkpoint where an index is given, and one file otherwise.
pub fn weights_of(indexes: List<[String, ByteList]>, files: List<CheckpointFile>) -> Result<Weights, String> {
    if indexes.len() > 1 {
        return Result::Err(`loam: ${indexes.len()} indexes, and a sharded checkpoint has one`);
    }
    if let Some([index_path, index]) = indexes.into_iter().next() {
        return Result::Ok(Weights::Shards(Sharded { index_path, index, shards: files }));
    }
    if files.len() > 1 {
        return Result::Err(
            `loam: ${files.len()} checkpoints and no index; the shards of one are given beside the index placing each tensor`,
        );
    }
    return Result::Ok(match files.into_iter().next() {
        Some(file) => Weights::File(file),
        None => Weights::Unchecked,
    });
}

/// The module `model`'s `forward` runs in, importing its runtime from the
/// package spec `runtime`, once `model` is checked against `weights`.
pub fn generate_model(model: &Model, path: &String, weights: Weights, runtime: &String) -> Result<String, String> {
    let graph = &model.graph;
    let shapes = &model.checked.shapes;
    // Emitting first refuses an element type no kernel holds, which the checks
    // below take as given.
    let emit_with = |weights_from: Placement| emit(graph, &model.checked, runtime, model.fuse, weights_from).map_err(
        |e| at(path, &e),
    );
    if let Some(in_place) = graph.in_place {
        if !weights matches { Unchecked } {
            return Result::Err(
                at(path, &`the weights are left in place in ${in_place.file}, so no checkpoint is given`),
            );
        }
        if let Some(vi) = graph.initializers.iter_ref().find(
            |vi| vi.data matches { None } && !in_place.ranges.contains_key(vi.name),
        ) {
            return Result::Err(at(path, &`${vi.name}: no data, and the weights left in place are in ${in_place.file}`));
        }
        return emit_with(Placement::InPlace(in_place));
    }
    return match weights {
        Unchecked => emit_with(Placement::File),
        File(file) => {
            let generated = emit_with(Placement::File)?;
            let checkpoint = read_checkpoint(&file.header).map_err(|e| at(&file.path, &e))?;
            check_checkpoint(graph, shapes, &checkpoint).map_err(|e| at(&file.path, &e))?;
            Result::Ok(generated);
        },
        Shards(sharded) => {
            let index_path = sharded.index_path;
            let index = read_index(&text_of(&index_path, sharded.index)?).map_err(|e| at(&index_path, &e))?;
            let placed = placement(graph, &index).map_err(|e| at(&index_path, &e))?;
            let generated = emit_with(Placement::Shards(placed))?;
            check_shards(graph, shapes, &index_path, &index, &placed, sharded.shards).map_err(
                |r| at(&r.path, &r.reason),
            )?;
            Result::Ok(generated);
        },
    };
}

/// The `Tokenizer` the `tokenizer.json` at `path` describes.
pub fn generate_tokenizer(path: &String, bytes: ByteList, runtime: &String) -> Result<String, String> {
    let bpe = read_tokenizer(&text_of(path, bytes)?).map_err(|e| at(path, &e))?;
    return Result::Ok(emit_tokenizer(&bpe, path, runtime));
}

/// A checkpoint's leading bytes, through the end of its header, of the file, or
/// of a length no module can address. The payloads are the loader's to read.
pub fn read_header(mut content: Stream<u8>) -> ByteList {
    let mut prefix = ByteList::with_capacity(HEADER_CHUNK);
    loop {
        let [end, chunk] = content.start_read(HEADER_CHUNK).finish();
        content = end;
        prefix.extend(&(chunk.items as ByteList));
        if chunk.result != CopyResult::Completed || holds_header(&prefix) {
            break;
        }
    }
    content.drop();
    return prefix;
}

/// Whether `prefix` reaches the header's end, or declares one no read can reach.
fn holds_header(prefix: &ByteList) -> bool {
    if prefix.len() < 8 {
        return false;
    }
    return match declared_header_end(prefix) {
        Ok(end) => prefix.len() >= end,
        Err(_) => true,
    };
}

/// Enough for GPT-2's header in one read, which is 14 KiB.
global HEADER_CHUNK: i32 = 65536;

/// How many leading bytes of a checkpoint the build depends on: through the end
/// of the header its first eight bytes declare. Those eight alone where they
/// declare a header no module can address, which the check then refuses, and
/// all of a file that ends inside them. Reads the eight bytes and no more, so a
/// build reads none of the payloads.
pub fn header_extent(mut content: Stream<u8>) -> u64 {
    let mut length = ByteList::with_capacity(8);
    loop {
        let [end, chunk] = content.start_read(8 - length.len()).finish();
        content = end;
        length.extend(&(chunk.items as ByteList));
        if chunk.result != CopyResult::Completed || length.len() == 8 {
            break;
        }
    }
    content.drop();
    if length.len() < 8 {
        return u64::MAX;
    }
    return match declared_header_end(&length) {
        Ok(end) => end as u64,
        Err(_) => 8,
    };
}
