//! `pytorch-operator/test_operator_flatten`: a `Flatten` at axis 1 over
//! `float[1, 2, 3, 4]`, checked against the output ONNX ships.

use { Cpu, Merged, Tensor } from "lib:loam";
use { assert_close, tensor_of } from "./oracle.wado";
use flatten from "../tests/onnx/pytorch-operator/test_operator_flatten/model.onnx"
    with {
        type: "onnx",
        generator: { module: "lib:loam" },
    };

test "Flatten reproduces the output ONNX ships" {
    let [x, x_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_flatten/test_data_set_0/input_0.pb"),
    );
    let [want, want_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_flatten/test_data_set_0/output_0.pb"),
    );

    let got: Tensor<f32, [flatten::Axis00, Merged<[flatten::Axis01, flatten::Axis02, flatten::Axis03]>]> = flatten::forward(
        &mut Cpu {},
        &Tensor::<f32, [flatten::Axis00, flatten::Axis01, flatten::Axis02, flatten::Axis03]> {
            data: x,
            extents: x_extents,
        },
        &flatten::Weights {}.prepare(&mut Cpu {}),
    );

    assert got.extents == want_extents;
    assert_close(&got.data, &want);
}
