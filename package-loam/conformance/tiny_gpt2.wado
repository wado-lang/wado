//! The tiny GPT-2 decoder, compiled through Loam at a fixed batch with its
//! sequence length left to the run, from its graph split off its weights. Its
//! tests and the WebGPU conformance share this one import. Every axis takes
//! the name the graph gives it.

pub use { BatchSize, Prepared, SequenceLength, forward } from "../tests/models/tiny-gpt2/model.onnxtext"
    with {
        type: "onnxtext",
        generator: {
            module: "lib:loam",
            inputs: [
                { path: "../tests/models/tiny-gpt2/model.safetensors", type: "safetensors" },
            ],
            options: {
                dims: { batch_size: 1 },
                outputs: ["logits"],
            },
        },
    };
