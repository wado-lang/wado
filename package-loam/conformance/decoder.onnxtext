# A small decoder: tokens embedded, attending over the keys and values of the
# passes before them as `attended.onnxtext` does, and read out by the embedding
# transposed, then tilted by the positions the mask holds open, so a step that
# leaves its own closed picks otherwise. Each row of the batch stays apart.
<ir_version: 8, opset_import: [ "" : 17, "com.microsoft" : 1 ]>
decoder (int64[B, S] input_ids, int64[B, T] attention_mask, float[B, 1, P, 16] past_key, float[B, 1, P, 16] past_value) => (float[B, S, 8] logits, float[B, 1, ?, 16] present_key, float[B, 1, ?, 16] present_value)
<float[8] W = {0.09, -0.07, 0.05, -0.03, -0.05, 0.03, -0.09, 0.07},float[8, 8] E = {0.9, -0.2, 0.4, 0.1, -0.7, 0.3, 0.6, -0.5, -0.3, 0.8, -0.6, 0.2, 0.5, -0.1, 0.7, 0.4, 0.2, 0.5, 0.9, -0.4, 0.1, -0.8, -0.3, 0.6, -0.6, 0.1, -0.2, 0.7, 0.3, 0.9, -0.4, -0.1, 0.4, -0.9, 0.3, 0.5, -0.2, 0.6, 0.1, 0.8, 0.7, 0.2, -0.5, -0.8, 0.6, 0.4, 0.3, -0.2, -0.1, 0.6, 0.8, 0.3, -0.9, -0.5, 0.2, 0.1, 0.5, -0.4, -0.1, 0.9, 0.7, -0.3, -0.8, 0.2}, float[16, 8] C = {1, 1, 1, 1, 1, 1, 1, 1, 0.540302, 0.731761, 0.846009, 0.912396, 0.950415, 0.972014, 0.98423, 0.991122, -0.416147, 0.070948, 0.431463, 0.664932, 0.806578, 0.889624, 0.937418, 0.964645, -0.989992, -0.627927, -0.115966, 0.300967, 0.582754, 0.757441, 0.861041, 0.921039, -0.653644, -0.989933, -0.62768, -0.11573, 0.301137, 0.582862, 0.757506, 0.861079, 0.283662, -0.820862, -0.946079, -0.51215, -0.010342, 0.375661, 0.63008, 0.785829, 0.96017, -0.211416, -0.973104, -0.818837, -0.320796, 0.147433, 0.482782, 0.696626, 0.753902, 0.511449, -0.70043, -0.982058, -0.599437, -0.089047, 0.320257, 0.595053, -0.1455, 0.959933, -0.212037, -0.973213, -0.818632, -0.320543, 0.147631, 0.482914, -0.91113, 0.893434, 0.34166, -0.793854, -0.956644, -0.534098, -0.029651, 0.3622, -0.839072, 0.347627, 0.790132, -0.475405, -0.999786, -0.717758, -0.205998, 0.235055, 0.004426, -0.384674, 0.995257, -0.073661, -0.94378, -0.861245, -0.375847, 0.103736, 0.843854, -0.910606, 0.893862, 0.340989, -0.794179, -0.956527, -0.533843, -0.029425, 0.907447, -0.948018, 0.517173, 0.695895, -0.56582, -0.998271, -0.675002, -0.162064, 0.136737, -0.476839, -0.018796, 0.928874, -0.28135, -0.984141, -0.794871, -0.291824, -0.759688, 0.250154, -0.548976, 0.999107, 0.031023, -0.914928, -0.88967, -0.416403}, float[16, 8] N = {0, 0, 0, 0, 0, 0, 0, 0, 0.841471, 0.681561, 0.533168, 0.409309, 0.310984, 0.234921, 0.176892, 0.132957, 0.909297, 0.99748, 0.902131, 0.746904, 0.591127, 0.456693, 0.348205, 0.263554, 0.14112, 0.778273, 0.993253, 0.953634, 0.812649, 0.652904, 0.508536, 0.38947, -0.756802, 0.141539, 0.778472, 0.993281, 0.953581, 0.812571, 0.652828, 0.508471, -0.958924, -0.571127, 0.323935, 0.858896, 0.999947, 0.926757, 0.77653, 0.618444, -0.279415, -0.977396, -0.230367, 0.574026, 0.947148, 0.989072, 0.875741, 0.717435, 0.656987, -0.859313, -0.713721, 0.188581, 0.800422, 0.996027, 0.947331, 0.803687, 0.989358, -0.280228, -0.977262, -0.229904, 0.574318, 0.947234, 0.989042, 0.875668, 0.412118, 0.449194, -0.939824, -0.608109, 0.291259, 0.845423, 0.99956, 0.9321, -0.544021, 0.937633, -0.612937, -0.879767, -0.020684, 0.696292, 0.978552, 0.971982, -0.99999, 0.923052, -0.097277, -0.997283, -0.330575, 0.50819, 0.926682, 0.994605, -0.536573, 0.413275, 0.448343, -0.940067, -0.607684, 0.291643, 0.845584, 0.999567, 0.420167, -0.318216, 0.855881, -0.718143, -0.824528, 0.058773, 0.737816, 0.98678, 0.990607, -0.87899, 0.999823, -0.370395, -0.959605, -0.177387, 0.606779, 0.956472, 0.650288, -0.968206, 0.835838, 0.04225, -0.999519, -0.403618, 0.456603, 0.90918}>
{
    embedded = Gather(E, input_ids)
    bent = Tanh(embedded)
    squared = Mul(embedded, bent)
    negated = Neg(embedded)
    X = Concat <axis = 2> (embedded, bent, squared, negated)
    starts = Constant <value_ints = [0]> ()
    eighth = Constant <value_ints = [8]> ()
    middle = Constant <value_ints = [16]> ()
    ends = Constant <value_ints = [32]> ()
    axes = Constant <value_ints = [2]> ()
    K = Slice(X, starts, middle, axes)
    G = Tanh(X)
    V = Slice(G, middle, ends, axes)
    one = Constant <value_ints = [1]> ()
    shape = Shape(attention_mask)
    width = Gather <axis = 0> (shape, one)
    shorter = Sub(width, one)
    L = Cast <to = 6> (shorter)
    wide = Squeeze(width)
    T32 = Cast <to = 6> (wide)
    Y, present_key, present_value = com.microsoft.GroupQueryAttention <num_heads = 2, kv_num_heads = 1, do_rotary = 1> (X, K, V, past_key, past_value, L, T32, C, N)
    read = Slice(Y, starts, eighth, axes)
    out = Transpose(E)
    raw = MatMul(read, out)
    seen = Cast <to = 1> (attention_mask)
    open = ReduceSum <keepdims = 0> (seen, one)
    beside = Constant <value_ints = [1, 2]> ()
    lifted = Unsqueeze(open, beside)
    tilt = Mul(lifted, W)
    logits = Add(raw, tilt)
}
