//! The WebGPU backend's `group_query_attention` computes what `Cpu`'s does.
//! Each case prints how far the attended rows and the present keys and values
//! sit from `Cpu`'s. `wado test` cannot reach a device, so `wado-run-webgpu`'s
//! tests run it:
//!
//!     wado run-webgpu package-loam/conformance/webgpu_attention.wado

use { println, Stdout } from "core:cli";
use {
    Webgpu,
    Gpu,
    GpuAdapter,
    GpuDevice,
    GpuQueue,
    GpuCommandEncoder,
    GpuCommandBuffer,
    GpuBuffer,
    GpuBindGroupLayout,
    GpuBindGroup,
    GpuShaderModule,
    GpuComputePipeline,
    GpuComputePassEncoder,
    GpuSupportedLimits,
    RecordOptionGpuSize64,
} from "wasi:webgpu";
use { Attention, Backend, Cpu, Placed, Tensor, WebGpuBackend, element_count } from "lib:loam";
use { deviation, noise } from "lib:loam/example/webgpu/compare.wado";

struct Batch {
}

struct Seq {
}

struct Query {
}

struct Key {
}

struct KvHead {
}

struct Past {
}

struct Total {
}

struct Dim {
}

struct Pos {
}

struct Half {
}

struct One {
}

/// The positions of a chain's cache, past and present alike, so each step's
/// presents are the next one's past.
struct Cache {
}

/// What one step of a chain left on each backend.
struct Stepped {
    on_cpu: [Tensor<f32, [Batch, KvHead, Cache, Dim]>, Tensor<f32, [Batch, KvHead, Cache, Dim]>],
    on_gpu: [Placed<f32, [Batch, KvHead, Cache, Dim]>, Placed<f32, [Batch, KvHead, Cache, Dim]>],
    deviation: f32,
    /// The bind groups the device made for the step.
    bind_groups: i32,
}

/// The operands of one case: `seq` new positions after `past`, heads of 8,
/// turned over `half` of each half where `half` is above 0.
struct Case {
    name: String,
    seq: i32,
    past: i32,
    half: i32,
    biased: bool,
    options: Attention,
}

fn tensor<Axes>(extents: List<i32>, seed: u32) -> Tensor<f32, Axes> {
    return Tensor { data: noise(element_count(&extents), seed, 1.0), extents };
}

export fn run() with (Stdout, Webgpu, Gpu, GpuAdapter, GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder, GpuSupportedLimits, RecordOptionGpuSize64) {
    let Some(mut gpu) = WebGpuBackend::new() else {
        println("no WebGPU adapter");
        return;
    };
    let cases: List<Case> = [
        Case {
            name: "prompt",
            seq: 5,
            past: 0,
            half: 4,
            biased: false,
            options: Attention { heads: 4, kv_heads: 2, scale: 0.35, softcap: -1.0, window: -1, causal: true },
        },
        Case {
            name: "cached",
            seq: 1,
            past: 6,
            half: 3,
            biased: true,
            options: Attention { heads: 4, kv_heads: 1, scale: 0.35, softcap: 2.0, window: 4, causal: true },
        },
        Case {
            name: "plain",
            seq: 3,
            past: 2,
            half: 0,
            biased: true,
            options: Attention { heads: 2, kv_heads: 2, scale: 0.5, softcap: -1.0, window: -1, causal: false },
        },
        // Past the cache's first capacity, a row's parts are many workgroups.
        Case {
            name: "long",
            seq: 3,
            past: 140,
            half: 2,
            biased: true,
            options: Attention { heads: 2, kv_heads: 1, scale: 0.35, softcap: -1.0, window: -1, causal: true },
        },
        // A window behind the first positions masks whole parts.
        Case {
            name: "windowed",
            seq: 1,
            past: 150,
            half: 0,
            biased: false,
            options: Attention { heads: 4, kv_heads: 2, scale: 0.35, softcap: 2.0, window: 40, causal: true },
        },
    ];
    for let c of cases {
        println(`${c.name} ${attended(&mut gpu, &c)}`);
    }

    // A decoder's chain through the cache. A step shaped as the one before it
    // makes no bind group, a branch from an earlier past reads that past
    // alone, and a step past what the cache holds moves it to a larger one.
    let empty: Tensor<f32, [Batch, KvHead, Cache, Dim]> = tensor([1, 1, 0, 8], 4);
    let cos: Tensor<f32, [Pos, Half]> = tensor([160, 4], 6);
    let sin: Tensor<f32, [Pos, Half]> = tensor([160, 4], 7);
    gpu.begin();
    let start = Stepped {
        on_cpu: [empty, empty],
        on_gpu: [
            gpu.upload(&empty),
            gpu.upload(&empty),
        ],
        deviation: 0.0,
        bind_groups: 0,
    };
    let prompt = step(&mut gpu, &start, 5, &cos, &sin);
    println(`chain prompt ${prompt.deviation}`);
    let first = step(&mut gpu, &prompt, 1, &cos, &sin);
    println(`chain step ${first.deviation}`);
    let second = step(&mut gpu, &first, 1, &cos, &sin);
    assert second.bind_groups == 0, "a step shaped as the one before makes no bind group";
    println(`chain repeated ${second.deviation}`);
    // The step after the branch reads this past.
    gpu.retain(&second.on_gpu.0);
    gpu.retain(&second.on_gpu.1);
    let branch = step(&mut gpu, &first, 1, &cos, &sin);
    println(`chain branched ${branch.deviation}`);
    let grown = step(&mut gpu, &second, 60, &cos, &sin);
    println(`chain grown ${grown.deviation}`);

    // A long prompt's query rows outgrow a binding of 8192 words in parts of
    // `ATTEND_PART` positions, so they attend in larger ones.
    let Some(mut bound) = WebGpuBackend::new() else {
        return;
    };
    bound.limit_binding(8192);
    let long_prompt = Case {
        name: "bound",
        seq: 64,
        past: 0,
        half: 4,
        biased: false,
        options: Attention { heads: 4, kv_heads: 1, scale: 0.35, softcap: -1.0, window: -1, causal: true },
    };
    println(`${long_prompt.name} ${attended(&mut bound, &long_prompt)}`);
}

/// How far `c` attended on the device sits from `Cpu`'s, over a batch of 2
/// and heads of 8.
fn attended(
    gpu: &mut WebGpuBackend,
    c: &Case,
) -> f32 with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let [batch, d, positions] = [2, 8, 160];
    let total = c.past + c.seq;
    let q: Tensor<f32, [Batch, Seq, Query]> = tensor([batch, c.seq, c.options.heads * d], 1);
    let k: Tensor<f32, [Batch, Seq, Key]> = tensor([batch, c.seq, c.options.kv_heads * d], 2);
    let v: Tensor<f32, [Batch, Seq, Key]> = tensor([batch, c.seq, c.options.kv_heads * d], 3);
    let past_k: Tensor<f32, [Batch, KvHead, Past, Dim]> = tensor([batch, c.options.kv_heads, c.past, d], 4);
    let past_v: Tensor<f32, [Batch, KvHead, Past, Dim]> = tensor([batch, c.options.kv_heads, c.past, d], 5);
    let cos: Tensor<f32, [Pos, Half]> = tensor([positions, c.half], 6);
    let sin: Tensor<f32, [Pos, Half]> = tensor([positions, c.half], 7);
    let bias: Tensor<f32, [One, One, Seq, Total]> = tensor([1, 1, c.seq, total], 8);
    let turned = c.half > 0;
    let on_cpu = Cpu {}.group_query_attention(
        &q,
        &k,
        &v,
        &past_k,
        &past_v,
        if turned { Option::Some(&cos) } else { null },
        if turned { Option::Some(&sin) } else { null },
        if c.biased { Option::Some(&bias) } else { null },
        &c.options,
    );
    gpu.begin();
    let [gq, gk, gv, gpk, gpv, gcos, gsin, gbias] = [
        gpu.upload(&q),
        gpu.upload(&k),
        gpu.upload(&v),
        gpu.upload(&past_k),
        gpu.upload(&past_v),
        gpu.upload(&cos),
        gpu.upload(&sin),
        gpu.upload(&bias),
    ];
    let on_gpu = gpu.group_query_attention(
        &gq,
        &gk,
        &gv,
        &gpk,
        &gpv,
        if turned { Option::Some(&gcos) } else { null },
        if turned { Option::Some(&gsin) } else { null },
        if c.biased { Option::Some(&gbias) } else { null },
        &c.options,
    );
    let reads = gpu.read_backs();
    let [out, present_k, present_v] = [
        gpu.download(&on_gpu.0),
        gpu.download(&on_gpu.1),
        gpu.download(&on_gpu.2),
    ];
    // Only the three downloads read back: the kernel ran on the device.
    assert gpu.read_backs() - reads == 3, "the attention reads nothing back";
    return furthest([out.data, present_k.data, present_v.data], [on_cpu.0.data, on_cpu.1.data, on_cpu.2.data]);
}

/// How far the attended rows and the present keys and values `got` sit from
/// `expected`, at the furthest of the three.
fn furthest(got: [List<f32>, List<f32>, List<f32>], expected: [List<f32>, List<f32>, List<f32>]) -> f32 {
    return f32::max(
        deviation(&got.0, &expected.0),
        f32::max(deviation(&got.1, &expected.1), deviation(&got.2, &expected.2)),
    );
}

/// `seq` new positions after the past `before` left, attended on both
/// backends in a pass of its own.
fn step(
    gpu: &mut WebGpuBackend,
    before: &Stepped,
    seq: i32,
    cos: &Tensor<f32, [Pos, Half]>,
    sin: &Tensor<f32, [Pos, Half]>,
) -> Stepped with (GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder) {
    let options = Attention { heads: 4, kv_heads: 1, scale: 0.35, softcap: -1.0, window: -1, causal: true };
    let [batch, d] = [1, 8];
    let seed = (before.on_cpu.0.extents[2] + seq) as u32;
    let q: Tensor<f32, [Batch, Seq, Query]> = tensor([batch, seq, options.heads * d], seed);
    let k: Tensor<f32, [Batch, Seq, Key]> = tensor([batch, seq, options.kv_heads * d], seed + 1);
    let v: Tensor<f32, [Batch, Seq, Key]> = tensor([batch, seq, options.kv_heads * d], seed + 2);
    let on_cpu = Cpu {}.group_query_attention::<Batch, Seq, Query, Key, KvHead, Cache, Cache, Dim, Pos, Half, One, One>(
        &q,
        &k,
        &v,
        &before.on_cpu.0,
        &before.on_cpu.1,
        Option::Some(cos),
        Option::Some(sin),
        null,
        &options,
    );
    gpu.retain(&before.on_gpu.0);
    gpu.retain(&before.on_gpu.1);
    gpu.begin();
    let [gq, gk, gv, gcos, gsin] = [
        gpu.upload(&q),
        gpu.upload(&k),
        gpu.upload(&v),
        gpu.upload(cos),
        gpu.upload(sin),
    ];
    // An exporter reshapes the presents before they come back as the past,
    // which rewrites the strides of the axes of extent 1.
    let extents = before.on_cpu.0.extents;
    let past_k = gpu.reshape::<f32, [Batch, KvHead, Cache, Dim], [Batch, KvHead, Cache, Dim]>(&before.on_gpu.0, extents);
    let past_v = gpu.reshape::<f32, [Batch, KvHead, Cache, Dim], [Batch, KvHead, Cache, Dim]>(&before.on_gpu.1, extents);
    let made = gpu.bind_groups();
    let on_gpu = gpu.group_query_attention::<Batch, Seq, Query, Key, KvHead, Cache, Cache, Dim, Pos, Half, One, One>(
        &gq,
        &gk,
        &gv,
        &past_k,
        &past_v,
        Option::Some(&gcos),
        Option::Some(&gsin),
        null,
        &options,
    );
    let bind_groups = gpu.bind_groups() - made;
    let [out, present_k, present_v] = [
        gpu.download(&on_gpu.0),
        gpu.download(&on_gpu.1),
        gpu.download(&on_gpu.2),
    ];
    return Stepped {
        on_cpu: [on_cpu.1, on_cpu.2],
        on_gpu: [on_gpu.1, on_gpu.2],
        deviation: furthest([out.data, present_k.data, present_v.data], [on_cpu.0.data, on_cpu.1.data, on_cpu.2.data]),
        bind_groups,
    };
}
