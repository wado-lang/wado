//! Each operator Loam lowers, over static shapes, against onnxruntime. Each
//! model under `operators/` is one case, and `operators.mjs`, which wrote it,
//! wrote beside it the inputs it fed and what onnxruntime computed from them. Here the case builds as the generator
//! would build it and runs under `eval` on the same inputs, so a refused build,
//! a trap and a wrong answer each show as a difference from onnxruntime. A case
//! Loam does not match yet is a `#[TODO]` test, so the run lists where the two
//! part.

use { read } from "lib:loam/src/onnx_proto.wado";
use { assert_close, generated, program_over, ran } from "./oracle.wado";

/// One tensor a case's text spells, each part as written: `f32` or `i64`, the
/// extents as a list literal, and the elements, a float by its bits.
struct Spelled {
    element: String,
    extents: String,
    values: List<String>,
}

impl Spelled {
    /// The last three fields of a line: the element, the extents, the elements.
    fn of(fields: &List<String>) -> Spelled {
        let n = fields.len();
        let listed = fields[n - 1].as_str_slice().slice(1, fields[n - 1].len() - 1);
        let values: List<String> = if listed.is_empty() {
            [];
        } else {
            listed.split(",").map(|v| v.to_string()).collect();
        };
        return Spelled { element: fields[n - 3], extents: fields[n - 2], values };
    }

    /// The elements as a Wado list literal.
    fn literal(&self) -> String {
        if self.element != "f32" {
            return `[${self.values.join(", ")}]`;
        }
        let bits: List<String> = self.values.into_iter().map(|b| `f32::from_bits(${b})`).collect();
        return `[${bits.join(", ")}]`;
    }

    fn floats(&self) -> List<f32> {
        return self.values.into_iter().map(|b| f32::from_bits(u32::from_str(&b).unwrap())).collect();
    }
}

/// A case as its text states it.
struct Case {
    inputs: List<Spelled>,
    output: Spelled,
}

impl Case {
    fn of(text: &String) -> Case {
        let mut inputs: List<Spelled> = [];
        let mut output: Option<Spelled> = null;
        for let line of text.lines() {
            let fields: List<String> = line.split_whitespace().map(|f| f.to_string()).collect();
            match fields[0].as_str_slice() {
                "input" => inputs.push(Spelled::of(&fields)),
                "output" => output = Option::Some(Spelled::of(&fields)),
                _ => unreachable(),
            }
        }
        return Case { inputs, output: output.unwrap() };
    }
}

/// What Loam computes from `model` on the case's inputs, as an `output` line
/// spells it, once through the kernels' `forward` and once through the graph
/// `build` adds to on `Cpu`, or why it computes nothing: the build's refusal,
/// or how the run stopped.
fn computed(model: ByteList, case: &Case) -> String {
    let graph = read(model).unwrap();
    let source = match generated(&graph) {
        Ok(source) => source,
        Err(reason) => {
            return `refused: ${reason}`;
        },
    };
    let mut args = "";
    let mut held = "";
    for let input of case.inputs {
        let host = `&Tensor { data: ${input.literal()} as List<${input.element}>, extents: ${input.extents} }`;
        args.push_str(`${host}, `);
        held.push_str(`&cpu.upload(${host}), `);
    }
    let element = case.output.element;
    let shown = if element == "f32" { "v.to_bits()" } else { "v" };
    let program = `${program_over(&source)}
export fn run() with Stdout {
    let mut opaque = Opaque::new();
    let weights = Prepared::embedded(&mut opaque);
    printed(&forward(&mut opaque, ${args}&weights));
    let mut cpu = Cpu {};
    let params = Params::embedded(&mut cpu);
    printed(&build(&mut cpu, ${held}&params));
}

fn printed<Axes>(got: &Tensor<${element}, Axes>) with Stdout {
    let extents: List<String> = got.extents.into_iter().map(|e| \`\${e}\`).collect();
    let data: List<String> = got.data.into_iter().map(|v| \`\${${shown}}\`).collect();
    println(\`output ${element} [\${extents.join(",")}] [\${data.join(",")}]\`);
}
`;
    return ran(program).trim_end().to_string();
}

/// Loam computes from `model` what onnxruntime did, which `oracle` states,
/// through `forward` and through `build` alike: the same elements, a float
/// within `TOLERANCE` of onnxruntime's.
fn assert_agrees(model: ByteList, oracle: String) {
    let case = Case::of(&oracle);
    let want = case.output;
    let got = computed(model, &case);
    let lines: List<String> = got.lines().map(|l| l.to_string()).collect();
    // A refusal or a trap is no pair of output lines, and shows as it stands.
    assert lines.len() == 2, got;
    for let line of lines {
        let fields: List<String> = line.split_whitespace().map(|f| f.to_string()).collect();
        assert fields.len() == 4 && fields[0] == "output";
        let found = Spelled::of(&fields);
        assert found.element == want.element && found.extents == want.extents;
        if want.element == "f32" {
            assert_close(&found.floats(), &want.floats());
        } else {
            assert found.values == want.values;
        }
    }
}

test "Add of two operands of one shape" {
    assert_agrees(#include_bytes("./operators/AddSame.onnx"), #include_str("./operators/AddSame.txt"));
}

