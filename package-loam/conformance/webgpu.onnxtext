# Every path the WebGPU backend takes: both products, each broadcast its
# elementwise shader reads, every unary operator, a folded constant, a negative
# base to an odd and an even power, zero to the powers 0 and -1, a kernel left
# to the CPU whose result a shader then uploads, a count past one dispatch row,
# and no elements at all.
<ir_version: 8, opset_import: [ "" : 13 ]>
kernels (float[B, M, 50] X, float[B, 50, 29] Y, float[L] V, float[E] N) => (float[B, M, 29] Z, float[B, 29, M] S, float[L] R, float[B, M, 29] O, float[E] G)
<float[50, 29] W, float[29] C>
{
    P = MatMul(X, Y)
    Q = MatMul(X, W)
    D = Sub(P, Q)
    T = Add(C, D)
    U = Mul(T, C)
    Two = Constant<value = float {2.0}>()
    H = Div(U, Two)
    E1 = Relu(H)
    E2 = Sigmoid(H)
    E3 = Tanh(H)
    E4 = Erf(H)
    E5 = Exp(E3)
    A = Abs(H)
    One = Constant<value = float {1.0}>()
    A1 = Add(A, One)
    E6 = Log(A1)
    E7 = Sqrt(A)
    E8 = Neg(H)
    Three = Constant<value = float {3.0}>()
    E9 = Pow(H, Three)
    E10 = Pow(H, Two)
    S0 = Add(E9, E10)
    S1 = Add(E1, E2)
    S2 = Add(S1, E3)
    S3 = Add(S2, E4)
    S4 = Add(S3, E5)
    S5 = Add(S4, E6)
    S6 = Add(S5, E7)
    S7 = Add(S6, E8)
    Z = Add(S7, S0)
    M1 = Softmax<axis = -1>(Z)
    M2 = Transpose<perm = [0, 2, 1]>(M1)
    S = Add(M2, M2)
    R = Relu(V)
    Zero = Constant<value = float {0.0}>()
    A0 = Mul(A, Zero)
    O0 = Pow(A0, Zero)
    MinusOne = Constant<value = float {-1.0}>()
    O1 = Pow(A0, MinusOne)
    O = Add(O0, O1)
    G = Add(N, One)
}
