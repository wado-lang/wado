# Every path the WebGPU backend takes: both products, each broadcast its
# elementwise shader reads, every unary operator, a folded constant, a negative
# base to an odd and an even power, zero to the powers 0 and -1, a kernel left
# to the CPU whose result a shader then uploads, a count past one dispatch row,
# no elements at all, products over more batch elements than one dispatch
# dimension holds, a fused kernel reading more operands than a shader binds
# buffers, a gather of rows, a product with a long inner axis, and a weight read
# back transposed.
<ir_version: 8, opset_import: [ "" : 13 ]>
kernels (float[B, M, 50] X, float[B, 50, 29] Y, float[L] V, float[E] N, float[H, 1, 2] BX, float[H, 2, 1] BY, int64[I] Ix, float[2, 300] DX) => (float[B, M, 29] Z, float[B, 29, M] S, float[L] R, float[B, M, 29] O, float[E] G, float[H, 1, 1] BZ, float[H, 1, 1] BS, float[29] K, float[I, 29] E, float[2, 3] F, float[29, 50] TW)
<float[50, 29] W, float[29] C, float[2, 1] BW, float[29] W1, float[29] W2, float[29] W3, float[29] W4, float[29] W5, float[29] W6, float[300, 3] DW, float[3] DB>
{
    P = MatMul(X, Y)
    Q = MatMul(X, W)
    D = Sub(P, Q)
    T = Add(C, D)
    U = Mul(T, C)
    Two = Constant<value = float {2.0}>()
    H = Div(U, Two)
    E1 = Relu(H)
    E2 = Sigmoid(H)
    E3 = Tanh(H)
    E4 = Erf(H)
    E5 = Exp(E3)
    A = Abs(H)
    One = Constant<value = float {1.0}>()
    A1 = Add(A, One)
    E6 = Log(A1)
    E7 = Sqrt(A)
    E8 = Neg(H)
    Three = Constant<value = float {3.0}>()
    E9 = Pow(H, Three)
    E10 = Pow(H, Two)
    S0 = Add(E9, E10)
    S1 = Add(E1, E2)
    S2 = Add(S1, E3)
    S3 = Add(S2, E4)
    S4 = Add(S3, E5)
    S5 = Add(S4, E6)
    S6 = Add(S5, E7)
    S7 = Add(S6, E8)
    Z = Add(S7, S0)
    M1 = Softmax<axis = -1>(Z)
    M2 = Transpose<perm = [0, 2, 1]>(M1)
    S = Add(M2, M2)
    R = Relu(V)
    Zero = Constant<value = float {0.0}>()
    A0 = Mul(A, Zero)
    O0 = Pow(A0, Zero)
    MinusOne = Constant<value = float {-1.0}>()
    O1 = Pow(A0, MinusOne)
    O = Add(O0, O1)
    G = Add(N, One)
    BZ = MatMul(BX, BY)
    BS = MatMul(BX, BW)
    K1 = Add(C, W1)
    K2 = Add(K1, W2)
    K3 = Add(K2, W3)
    K4 = Add(K3, W4)
    K5 = Add(K4, W5)
    K = Add(K5, W6)
    E = Gather<axis = 0>(W, Ix)
    DP = MatMul(DX, DW)
    F = Add(DP, DB)
    TW = Transpose<perm = [1, 0]>(W)
}
