// MNIST-12 from the ONNX Model Zoo, with the weights it carries, against the
// logits shipped beside it. Every axis takes the name the graph gives it.
test "MNIST-12 reproduces the logits the Model Zoo ships" {
    let [x, x_extents] = tensor_of(#include_bytes("../tests/models/mnist-12/test_data_set_0/input_0.pb"));
    let [want, want_extents] = tensor_of(#include_bytes("../tests/models/mnist-12/test_data_set_0/output_0.pb"));

    let mut cpu = Cpu {};
    let mut model = mnist::Model::new(mnist::Params::embedded(&mut cpu));
    let got = mnist::compute(
        &mut cpu,
        &Tensor::<f32, [mnist::Input30, mnist::Input31, mnist::Input32, mnist::Input33]> { data: x, extents: x_extents },
        &mut model,
    );

    assert got.extents == want_extents;
    assert_close(&got.data, &want);
}
