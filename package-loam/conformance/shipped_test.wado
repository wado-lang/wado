// `pytorch-operator/test_operator_addmm`: two `Gemm` nodes whose bias
// broadcasts across the batch axis.
test "Gemm reproduces the output ONNX ships" {
    let [a, a_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_addmm/test_data_set_0/input_0.pb"),
    );
    let [b, b_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_addmm/test_data_set_0/input_1.pb"),
    );
    let [c, c_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_addmm/test_data_set_0/input_2.pb"),
    );
    let [want, want_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_addmm/test_data_set_0/output_0.pb"),
    );

    let mut cpu = Cpu {};
    let mut model = addmm::Model::new(addmm::Params::embedded(&mut cpu));
    let got = addmm::compute(
        &mut cpu,
        &Tensor::<f32, [addmm::Axis00, addmm::Axis01]> { data: a, extents: a_extents },
        &Tensor::<f32, [addmm::Axis01, addmm::Axis11]> { data: b, extents: b_extents },
        &Tensor::<f32, [addmm::Axis11]> { data: c, extents: c_extents },
        &mut model,
    );

    assert got.extents == want_extents;
    assert_close(&got.data, &want);
}

// `pytorch-operator/test_operator_mm`: a one-element `Constant` as a `Gemm`
// bias, folded into the operator's `Expr`. Its axis is named all the same.
test "a scalar Constant folds into the Gemm bias" {
    let [a, a_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_mm/test_data_set_0/input_0.pb"),
    );
    let [b, b_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_mm/test_data_set_0/input_1.pb"),
    );
    let [want, want_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_mm/test_data_set_0/output_0.pb"),
    );

    let mut cpu = Cpu {};
    let mut model = mm::Model::new(mm::Params::embedded(&mut cpu));
    let got = mm::compute(
        &mut cpu,
        &Tensor::<f32, [mm::Axis00, mm::Axis01]> { data: a, extents: a_extents },
        &Tensor::<f32, [mm::Axis01, mm::Axis11]> { data: b, extents: b_extents },
        &mut model,
    );

    assert got.extents == want_extents;
    assert_close(&got.data, &want);
}

// `pytorch-converted/test_Linear_no_bias`: `Transpose` then `MatMul`, the only
// committed graph reaching `MatMul`. Its weight is an initializer, so ONNX
// ships one input and the weight travels in the model.
test "MatMul reproduces the output ONNX ships" {
    let [x, x_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-converted/test_Linear_no_bias/test_data_set_0/input_0.pb"),
    );
    let [want, want_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-converted/test_Linear_no_bias/test_data_set_0/output_0.pb"),
    );

    let mut cpu = Cpu {};
    let mut model = linear::Model::new(linear::Params::embedded(&mut cpu));
    let got = linear::compute(
        &mut cpu,
        &Tensor::<f32, [linear::Axis00, linear::Axis01]> { data: x, extents: x_extents },
        &mut model,
    );

    assert got.extents == want_extents;
    assert_close(&got.data, &want);
}

// `pytorch-operator/test_operator_flatten`: a `Flatten` at axis 1 over
// `float[1, 2, 3, 4]`.
test "Flatten reproduces the output ONNX ships" {
    let [x, x_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_flatten/test_data_set_0/input_0.pb"),
    );
    let [want, want_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_flatten/test_data_set_0/output_0.pb"),
    );

    let mut cpu = Cpu {};
    let mut model = flatten::Model::new(flatten::Params::embedded(&mut cpu));
    let got: Tensor<f32, [flatten::Axis00, Merged<[flatten::Axis01, flatten::Axis02, flatten::Axis03]>]> = flatten::compute(
        &mut cpu,
        &Tensor::<f32, [flatten::Axis00, flatten::Axis01, flatten::Axis02, flatten::Axis03]> {
            data: x,
            extents: x_extents,
        },
        &mut model,
    );

    assert got.extents == want_extents;
    assert_close(&got.data, &want);
}

// The window operators: `MaxPool` over one and two spatial axes, and `Conv`
// with its bias.
test "MaxPool over two padded axes reproduces the output ONNX ships" {
    let [x, x_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-converted/test_MaxPool2d/test_data_set_0/input_0.pb"),
    );
    let [want, want_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-converted/test_MaxPool2d/test_data_set_0/output_0.pb"),
    );

    let mut cpu = Cpu {};
    let mut model = pool2d::Model::new(pool2d::Params::embedded(&mut cpu));
    let got = pool2d::compute(
        &mut cpu,
        &Tensor::<f32, [pool2d::Axis00, pool2d::Axis01, pool2d::Axis02, pool2d::Axis03]> { data: x, extents: x_extents },
        &mut model,
    );

    assert got.extents == want_extents;
    assert_close(&got.data, &want);
}

