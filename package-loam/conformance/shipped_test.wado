//! Models from the ONNX backend test data and the Model Zoo, compiled through
//! Loam and checked against the outputs shipped beside them. They share one
//! file because each file compiles the runtime again.

use { Cpu, Merged, Tensor } from "lib:loam";
use { assert_close, tensor_of } from "./oracle.wado";
use basic from "../tests/onnx/pytorch-operator/test_operator_basic/model.onnx"
    with {
        type: "onnx",
        generator: { module: "lib:loam" },
    };
use params from "../tests/onnx/pytorch-operator/test_operator_params/model.onnx"
    with {
        type: "onnx",
        generator: { module: "lib:loam" },
    };
use pow from "../tests/onnx/pytorch-operator/test_operator_pow/model.onnx"
    with {
        type: "onnx",
        generator: { module: "lib:loam" },
    };
use exp from "../tests/onnx/pytorch-operator/test_operator_exp/model.onnx"
    with {
        type: "onnx",
        generator: { module: "lib:loam" },
    };
use sqrt from "../tests/onnx/pytorch-operator/test_operator_sqrt/model.onnx"
    with {
        type: "onnx",
        generator: { module: "lib:loam" },
    };
use addmm from "../tests/onnx/pytorch-operator/test_operator_addmm/model.onnx"
    with {
        type: "onnx",
        generator: { module: "lib:loam" },
    };
use mm from "../tests/onnx/pytorch-operator/test_operator_mm/model.onnx"
    with {
        type: "onnx",
        generator: { module: "lib:loam" },
    };
use linear from "../tests/onnx/pytorch-converted/test_Linear_no_bias/model.onnx"
    with {
        type: "onnx",
        generator: { module: "lib:loam" },
    };
use flatten from "../tests/onnx/pytorch-operator/test_operator_flatten/model.onnx"
    with {
        type: "onnx",
        generator: { module: "lib:loam" },
    };
use pool2d from "../tests/onnx/pytorch-converted/test_MaxPool2d/model.onnx"
    with {
        type: "onnx",
        generator: { module: "lib:loam" },
    };
use pool1d from "../tests/onnx/pytorch-operator/test_operator_maxpool/model.onnx"
    with {
        type: "onnx",
        generator: { module: "lib:loam" },
    };
use conv2d from "../tests/onnx/pytorch-converted/test_Conv2d/model.onnx"
    with {
        type: "onnx",
        generator: { module: "lib:loam" },
    };
use mnist from "../tests/models/mnist-12/model.onnx"
    with {
        type: "onnx",
        generator: { module: "lib:loam" },
    };

// `pytorch-operator/test_operator_basic`: `Add`, `Mul`, `Tanh`, `Sigmoid` and
// `Neg` over `float[1]`.
test "the generated graph reproduces the output ONNX ships" {
    let [a, a_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_basic/test_data_set_0/input_0.pb"),
    );
    let [b, b_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_basic/test_data_set_0/input_1.pb"),
    );
    let [want, want_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_basic/test_data_set_0/output_0.pb"),
    );

    let mut cpu = Cpu {};
    let mut model = basic::Model::new(basic::Params::embedded(&mut cpu));
    let got = basic::compute(
        &mut cpu,
        &Tensor::<f32, [basic::Axis00]> { data: a, extents: a_extents },
        &Tensor::<f32, [basic::Axis00]> { data: b, extents: b_extents },
        &mut model,
    );

    assert got.extents == want_extents;
    assert_close(&got.data, &want);
}

// `pytorch-operator/test_operator_params`: the same elementwise chain as
// `test_operator_basic`, with one operand an initializer. ONNX ships one input
// for it and no second, since the weight travels in the model.
test "a graph with an initializer reproduces the output ONNX ships" {
    let [x, x_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_params/test_data_set_0/input_0.pb"),
    );
    let [want, want_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_params/test_data_set_0/output_0.pb"),
    );

    let mut cpu = Cpu {};
    let mut model = params::Model::new(params::Params::embedded(&mut cpu));
    let got = params::compute(
        &mut cpu,
        &Tensor::<f32, [params::Axis00, params::Axis01]> { data: x, extents: x_extents },
        &mut model,
    );

    assert got.extents == want_extents;
    assert_close(&got.data, &want);
}

// `pytorch-operator/test_operator_pow`: one binary operator over
// `float[1, 2, 3, 4]`.
test "Pow reproduces the output ONNX ships" {
    let [x, x_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_pow/test_data_set_0/input_0.pb"),
    );
    let [y, y_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_pow/test_data_set_0/input_1.pb"),
    );
    let [want, want_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_pow/test_data_set_0/output_0.pb"),
    );

    let mut cpu = Cpu {};
    let mut model = pow::Model::new(pow::Params::embedded(&mut cpu));
    let got = pow::compute(
        &mut cpu,
        &Tensor::<f32, [pow::Axis00, pow::Axis01, pow::Axis02, pow::Axis03]> { data: x, extents: x_extents },
        &Tensor::<f32, [pow::Axis00, pow::Axis01, pow::Axis02, pow::Axis03]> { data: y, extents: y_extents },
        &mut model,
    );

    assert got.extents == want_extents;
    assert_close(&got.data, &want);
}

