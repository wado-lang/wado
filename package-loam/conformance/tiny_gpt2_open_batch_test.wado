//! The tiny GPT-2's step built with its batch left open: its empty cache takes
//! the batch, and a step from it computes a position for each row.

use { Cpu, Tensor } from "lib:loam";
use step from "../tests/models/tiny-gpt2/with-past/model.onnx"
    with {
        type: "onnx",
        generator: { module: "lib:loam" },
    };

test "a step whose batch the graph leaves open starts from an empty cache of the batch asked for" {
    let mut cpu = Cpu {};
    let cache = step::Cache::empty(&mut cpu, 2);
    assert cache.past_key_values_0_key.extents == [2, 4, 0, 8] as List<i32>;

    let o = step::forward(
        &mut cpu,
        &Tensor::<i64, [step::BatchSize, step::InputIds1]> {
            data: [11, 12],
            extents: [2, 1],
        },
        &Tensor::<i64, [step::BatchSize, step::AttentionMask1]> {
            data: [1, 1],
            extents: [2, 1],
        },
        &cache,
        &step::Prepared::embedded(&mut cpu),
    );
    assert o.logits.extents[0..<2].to_list() == [2, 1] as List<i32>;
    assert o.cache.past_key_values_4_value.extents == [2, 4, 1, 8] as List<i32>;
}
