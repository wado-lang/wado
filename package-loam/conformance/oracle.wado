//! Reading the tensors the ONNX backend test data ships beside each model.
//! One `.pb` file is one bare `TensorProto`.

use { from_bytes } from "core:protobuf";
use { TensorProto, float_tensor } from "../src/onnx_proto.wado";

/// A `.pb` file's elements and extents.
pub fn tensor_of(bytes: ByteList) -> [List<f32>, List<i32>] {
    let Ok(t) = from_bytes::<TensorProto, ByteList>(bytes) else {
        panic("the tensor did not decode");
    };
    let Ok(Some(pair)) = float_tensor(&t) else {
        panic("the tensor is not float");
    };
    return pair;
}

/// How far a generated kernel may sit from the output ONNX ships, relative to
/// the value past 1. A transcendental operator parts the two implementations,
/// and so does a long sum taken in another order, in proportion to its size.
pub global TOLERANCE: f32 = 1e-6;

/// `Sqrt` of a negative element is NaN, and the two implementations agreeing
/// means agreeing on where those sit, which `==` never reports.
pub fn assert_close(got: &List<f32>, want: &List<f32>) {
    assert got.len() == want.len();
    for let mut i = 0; i < want.len(); i += 1 {
        assert got[i].is_nan() == want[i].is_nan();
        if !want[i].is_nan() {
            assert f32::abs(got[i] - want[i]) < TOLERANCE * f32::max(1.0, f32::abs(want[i]));
        }
    }
}
