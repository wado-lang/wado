//! What the conformance tests share: building a case as the generator would
//! and running it, and reading the tensors the ONNX backend test data ships
//! beside each model, one bare `TensorProto` to a `.pb` file.

use { eval } from "core:eval";
use { emit } from "../src/emit.wado";
use { Graph, Known, Stored } from "../src/graph.wado";
use { infer } from "../src/infer.wado";
use { known_tensor, read_tensor } from "../src/onnx_proto.wado";
use { Schema } from "../src/schema.wado";

/// The backend a generated module's `forward` runs through in these tests,
/// spliced after the module; see `opaque_backend.wado`.
pub global OPAQUE_BACKEND: String = #include_str("./opaque_backend.wado");

/// The module the generator writes for `graph` under `schema`, or why the
/// build refuses it.
pub fn generated(graph: &Graph, schema: &Schema) -> Result<String, String> {
    let checked = infer(graph, schema).map_err(|e| `${e}`)?;
    return emit(graph, &checked).map_err(|e| `${e}`);
}

/// What `program` prints under `eval`, followed, where it does not exit
/// cleanly, by how it stopped.
pub fn ran(program: String) -> String {
    return match eval(program) {
        Ok(out) => if out.status matches { Exited(0) } {
            out.stdout;
        } else {
            `${out.stdout}${out.status:?}: ${out.stderr}`;
        },
        Err(e) => `${e:?}`,
    };
}

/// A `.pb` file's elements and extents.
pub fn tensor_of(bytes: ByteList) -> [List<f32>, List<i32>] {
    let Known { extents, elements: Floats(data), stored: Stored::Computed } = known_of(bytes) else {
        panic("the tensor is not float");
    };
    return [data, extents];
}

/// `tensor_of` for an int64 tensor, such as token ids.
pub fn ints_of(bytes: ByteList) -> [List<i64>, List<i32>] {
    let Known { extents, elements: Ints(data), stored: Stored::Computed } = known_of(bytes) else {
        panic("the tensor is not int64");
    };
    return [data, extents];
}

fn known_of(bytes: ByteList) -> Known {
    let Ok(t) = read_tensor(bytes) else {
        panic("the tensor did not decode");
    };
    let Ok(Some(k)) = known_tensor(&t) else {
        panic("the tensor carries no elements");
    };
    return k;
}

/// How far a kernel may sit from ONNX's output: relative above 1, absolute
/// below. A transcendental, or a long sum in another order, is where they part.
pub global TOLERANCE: f32 = 1e-6;

/// `Sqrt` of a negative element is NaN, and the two implementations agreeing
/// means agreeing on where those sit, which `==` never reports. An infinity is
/// equal or not close at all, since the difference of two is NaN.
pub fn assert_close(got: &List<f32>, want: &List<f32>) {
    assert got.len() == want.len();
    for let mut i = 0; i < want.len(); i += 1 {
        assert got[i].is_nan() == want[i].is_nan();
        if !want[i].is_nan() && got[i] != want[i] {
            assert f32::abs(got[i] - want[i]) < TOLERANCE * f32::max(1.0, f32::abs(want[i]));
        }
    }
}
