//! A tiny GPT-2 decoding one position per step against the keys and values it
//! computed before. The prompt runs through the decoder without a past, which
//! returns its keys and values beside its logits, and each step after it
//! through the decoder taking them back, whose cache grows by the position it
//! computes. Each step reproduces the logits onnxruntime computes for it.

use { Cpu, Tensor, capacity_of } from "lib:loam";
use { assert_close, ints_of, tensor_of } from "./oracle.wado";
use prompt from "../tests/models/tiny-gpt2/model.onnxtext"
    with {
        type: "onnxtext",
        generator: {
            module: "lib:loam",
            inputs: [
                { path: "../tests/models/tiny-gpt2/model.safetensors", type: "safetensors" },
            ],
            options: {
                dims: { batch_size: 1 },
            },
        },
    };
use step from "../tests/models/tiny-gpt2/with-past/model.onnx"
    with {
        type: "onnx",
        generator: {
            module: "lib:loam",
            options: {
                dims: { batch_size: 1 },
            },
        },
    };

/// The logits for `token` after the `past` positions `cache` holds, and the
/// cache grown by its position.
fn decode(
    token: i64,
    past: i32,
    cache: &step::Cache<Cpu>,
    model: &mut step::Model<Cpu>,
) -> [Tensor<f32, [step::BatchSize, step::InputIds1, step::Logits2]>, step::Cache<Cpu>] {
    let o = step::compute(
        &mut Cpu {},
        &Tensor::<i64, [step::BatchSize, step::InputIds1]> {
            data: [token],
            extents: [1, 1],
        },
        &Tensor::<i64, [step::BatchSize, step::AttentionMask1]> {
            data: List::<i64>::filled(past + 1, 1),
            extents: [1, past + 1],
        },
        cache,
        model,
    );
    return [o.logits, o.cache];
}

fn step_model() -> step::Model<Cpu> {
    return step::Model::new(step::Params::embedded(&mut Cpu {}));
}

/// `t` under the axes `B`. The prompt's module names the presents it returns
/// apart from the pasts the step's module reads.
fn relabel<A, B>(t: &Tensor<f32, A>) -> Tensor<f32, B> {
    return Tensor { data: t.data, extents: t.extents };
}

/// The prompt's logits, and the keys and values it leaves as the step's cache.
fn prefill(
    input_ids: ByteList,
) -> [Tensor<f32, [prompt::BatchSize, prompt::SequenceLength, prompt::Logits2]>, step::Cache<Cpu>] {
    let [ids, extents] = ints_of(input_ids);
    let weights = prompt::Params::load(&mut Cpu {}, &#include_bytes("../tests/models/tiny-gpt2/model.safetensors")).unwrap();
    let o = prompt::compute(
        &mut Cpu {},
        &Tensor::<i64, [prompt::BatchSize, prompt::SequenceLength]> { data: ids, extents },
        &Tensor::<i64, [prompt::BatchSize, prompt::SequenceLength]> {
            data: List::<i64>::filled(extents[1], 1),
            extents,
        },
        &mut prompt::Model::new(weights),
    );
    // A prompt's module has no past, so its presents are outputs like any.
    let cache: step::Cache<Cpu> = step::Cache {
        past_key_values_0_key: relabel(&o.present_0_key),
        past_key_values_0_value: relabel(&o.present_0_value),
        past_key_values_1_key: relabel(&o.present_1_key),
        past_key_values_1_value: relabel(&o.present_1_value),
        past_key_values_2_key: relabel(&o.present_2_key),
        past_key_values_2_value: relabel(&o.present_2_value),
        past_key_values_3_key: relabel(&o.present_3_key),
        past_key_values_3_value: relabel(&o.present_3_value),
        past_key_values_4_key: relabel(&o.present_4_key),
        past_key_values_4_value: relabel(&o.present_4_value),
    };
    return [o.logits, cache];
}

test "the prompt returns the logits it did without the cache, and a key and value per layer" {
    let [logits, c] = prefill(#include_bytes("../tests/models/tiny-gpt2/test_data_set_0/input_0.pb"));
    let [want, want_extents] = tensor_of(#include_bytes("../tests/models/tiny-gpt2/test_data_set_0/output_0.pb"));
    assert logits.extents == want_extents;
    assert_close(&logits.data, &want);
    let presents: List<List<i32>> = [
        c.past_key_values_0_key.extents, c.past_key_values_0_value.extents, c.past_key_values_1_key.extents,
        c.past_key_values_1_value.extents, c.past_key_values_2_key.extents, c.past_key_values_2_value.extents,
        c.past_key_values_3_key.extents, c.past_key_values_3_value.extents, c.past_key_values_4_key.extents,
        c.past_key_values_4_value.extents,
    ];
    for let extents of presents {
        assert extents == [1, 4, 4, 8] as List<i32>;
    }
}

test "each step after the prompt computes one position against the cache, as onnxruntime does" {
    let [_, prefilled] = prefill(#include_bytes("../tests/models/tiny-gpt2/test_data_set_0/input_0.pb"));
    let mut model = step_model();
    let mut cache = prefilled;
    let data: List<[ByteList, ByteList]> = [
        [
            #include_bytes("../tests/models/tiny-gpt2/with-past/test_data_set_0/input_0.pb"),
            #include_bytes("../tests/models/tiny-gpt2/with-past/test_data_set_0/output_0.pb"),
        ],
        [
            #include_bytes("../tests/models/tiny-gpt2/with-past/test_data_set_1/input_0.pb"),
            #include_bytes("../tests/models/tiny-gpt2/with-past/test_data_set_1/output_0.pb"),
        ],
    ];
    for let [i, pair] of data.into_iter().enumerate() {
        let [input, output] = pair;
        let [ids, _] = ints_of(input);
        let [want, want_extents] = tensor_of(output);
        let [logits, grown] = decode(ids[0], 4 + i, &cache, &mut model);
        assert logits.extents == want_extents;
        assert_close(&logits.data, &want);
        // The cache stays at the capacity the next step reads it at.
        assert grown.past_key_values_0_key.extents == [1, 4, capacity_of(5 + i), 8] as List<i32>;
        cache = grown;
    }
}

// The mask says the past is five positions long, past the four the cache holds.
#[expect_trap]
test "a mask longer than the cache's past and the step stops the step" {
    let [_, cache] = prefill(#include_bytes("../tests/models/tiny-gpt2/test_data_set_0/input_0.pb"));
    decode(11, 5, &cache, &mut step_model());
}
