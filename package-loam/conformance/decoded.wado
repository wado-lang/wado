//! A small decoder driven through `decode` and `Requests` and, for what that
//! must equal, a pass at a time through `compute`, on any backend.

use { Cpu, Graph, Sampling, Tensor } from "lib:loam";
use { B, Cache, Model, Params, Requests, S, T, compute, decode } from "./decoder.onnxtext"
    with {
        type: "onnxtext",
        generator: {
            module: "lib:loam",
            options: {
                last: { logits: 1 },
                decode: { ids: "input_ids", mask: "attention_mask", logits: "logits" },
            },
        },
    };

fn ids(data: List<i64>) -> Tensor<i64, [B, S]> {
    return Tensor {
        data,
        extents: [1, data.len()],
    };
}

fn mask(length: i32) -> Tensor<i64, [B, T]> {
    return Tensor {
        data: List::<i64>::filled(length, 1),
        extents: [1, length],
    };
}

/// What a row returns for `picked` after `tokens`: the first of the ends, once
/// one of them is among `tokens`.
fn returned(sampling: &Sampling, tokens: &List<i64>, picked: i64) -> i64 {
    return if tokens.into_iter().any(|t| sampling.ends.contains(t)) { sampling.ends[0] } else { picked };
}

/// `count` tokens after `prompt`, one pass and one host pick each.
pub fn stepped_tokens<affine Bk: Graph>(
    g: &mut Bk,
    prompt: List<i64>,
    count: i32,
    sampling: &Sampling,
) -> List<i64> with _ {
    let mut model = Model::new(Params::embedded(g));
    let mut seen = prompt.len();
    let first = compute(g, &ids(prompt), &mask(seen), &Cache::empty(g, 1), count - 1, &mut model);
    let mut tokens = sampling.first_tokens(&first.logits, seen as i64);
    let mut cache = first.cache;
    for let _ of 1..<count {
        seen += 1;
        let next = compute(g, &ids([tokens[tokens.len() - 1]]), &mask(seen), &cache, 0, &mut model);
        tokens.push(returned(sampling, &tokens, sampling.first_tokens(&next.logits, seen as i64)[0]));
        cache = next.cache;
    }
    return tokens;
}

/// The tokens after `prompt`, the first picked on the host and the rest by a
/// program for each of `calls`, how many steps it takes.
pub fn decoded_tokens<affine Bk: Graph>(
    g: &mut Bk,
    prompt: List<i64>,
    calls: List<i32>,
    sampling: &Sampling,
) -> List<i64> with _ {
    let mut model = Model::new(Params::embedded(g));
    let mut seen = prompt.len();
    let count = calls.into_iter().fold(0, |sum, steps| sum + steps);
    let first = compute(g, &ids(prompt), &mask(seen), &Cache::empty(g, 1), count, &mut model);
    let mut tokens = sampling.first_tokens(&first.logits, seen as i64);
    let mut cache = first.cache;
    for let steps of calls {
        seen += 1;
        let next = decode(g, &ids([tokens[tokens.len() - 1]]), &mask(seen), &cache, steps, sampling, &mut model);
        tokens.extend(&next.tokens.data);
        cache = next.cache;
        seen += steps - 1;
    }
    return tokens;
}

/// `count` tokens after each of `prompts`, the requests decoding side by side in
/// `slots` slots of 16 positions, `steps` at a call. A request waits for a slot
/// to come free, so each is placed at a time of its own, beside requests at
/// pasts of their own.
pub fn requested_tokens<affine Bk: Graph>(
    g: &mut Bk,
    prompts: List<List<i64>>,
    slots: i32,
    count: i32,
    steps: i32,
    sampling: &Sampling,
) -> List<List<i64>> with _ {
    assert (count - 1) % steps == 0, "a request ends at the end of a call";
    let mut model = Model::new(Params::embedded(g));
    let mut requests = Requests::new(g, slots, 16);
    let mut tokens: List<List<i64>> = [];
    let mut held = List::<i32>::filled(slots, -1);
    let mut placed = 0;
    while placed < prompts.len() || held.into_iter().any(|r| r >= 0) {
        for let slot of 0..<slots {
            if held[slot] < 0 && placed < prompts.len() {
                let prompt = prompts[placed];
                let first = requests.place(g, slot, &ids(prompt), &mask(prompt.len()), sampling, &mut model);
                tokens.push([first]);
                held[slot] = placed;
                placed += 1;
            }
        }
        let next = requests.decode(g, steps, sampling, &mut model);
        for let slot of 0..<slots {
            let request = held[slot];
            if request < 0 {
                continue;
            }
            for let step of 0..<steps {
                tokens[request].push(next.data[slot * steps + step]);
            }
            if tokens[request].len() == count {
                requests.release(slot);
                held[slot] = -1;
            }
        }
    }
    return tokens;
}

/// Prompts of lengths of their own, more of them than the slots
/// `requested_tokens` is given, so a request waits for a slot.
pub fn queued_prompts() -> List<List<i64>> {
    return [[2, 6, 1], [3, 4], [5], [1, 7, 2, 6], [4, 4]];
}

/// How many of the tokens of `queued_prompts` in `slots` slots differ from each
/// prompt's run alone on `Cpu`.
pub fn requests_apart<affine Bk: Graph>(g: &mut Bk, slots: i32, sampling: &Sampling) -> f32 with _ {
    let requested = requested_tokens(g, queued_prompts(), slots, 7, 2, sampling);
    let mut apart = 0 as f32;
    for let [i, prompt] of queued_prompts().into_iter().enumerate() {
        apart += tokens_apart(&requested[i], &stepped_tokens(&mut Cpu {}, prompt, 7, sampling));
    }
    return apart;
}

/// How many steps `decode` took from a three token past, where the prompt left
/// its cache no room.
pub fn steps_taken<affine Bk: Graph>(g: &mut Bk, steps: i32) -> i32 with _ {
    let mut model = Model::new(Params::embedded(g));
    let first = compute(g, &ids([1, 2]), &mask(2), &Cache::empty(g, 1), 0, &mut model);
    return decode(g, &ids([3]), &mask(3), &first.cache, steps, &Sampling {}, &mut model).tokens.extents[1];
}

/// A sampler of each kind a program tells apart.
pub fn samplers() -> List<Sampling> {
    return [
        Sampling {},
        Sampling { temperature: 0.8, seed: 7 },
        Sampling { temperature: 1.5, top_k: 3, seed: 11 },
        Sampling { temperature: 1.0, top_p: 0.7, seed: 13 },
        Sampling {
            temperature: 0.5,
            top_k: 4,
            top_p: 0.9,
            seed: 17,
            ends: [7, 5],
        },
    ];
}

/// How many of `a` and `b` differ.
pub fn tokens_apart(a: &List<i64>, b: &List<i64>) -> f32 {
    assert a.len() == b.len();
    let mut apart = 0;
    for let i of 0..<a.len() {
        if a[i] != b[i] {
            apart += 1;
        }
    }
    return apart as f32;
}
