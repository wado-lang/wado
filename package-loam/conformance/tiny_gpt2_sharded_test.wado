//! The tiny GPT-2 decoder of `tiny_gpt2.wado`, its checkpoint given in shards
//! beside the index placing each tensor, against the logits onnxruntime
//! computes from the single file.

use { Cpu, Tensor } from "lib:loam";
use { HashMap } from "core:collections";
use { assert_close, ints_of, tensor_of } from "./oracle.wado";
use { BatchSize, Prepared, SequenceLength, forward } from "../tests/models/tiny-gpt2/model.onnxtext"
    with {
        type: "onnxtext",
        generator: {
            module: "lib:loam",
            inputs: [
                { path: "../tests/models/tiny-gpt2/sharded/model.safetensors.index.json", type: "safetensors-index" },
                { path: "../tests/models/tiny-gpt2/sharded/model-00001-of-00003.safetensors", type: "safetensors" },
                { path: "../tests/models/tiny-gpt2/sharded/model-00002-of-00003.safetensors", type: "safetensors" },
                { path: "../tests/models/tiny-gpt2/sharded/model-00003-of-00003.safetensors", type: "safetensors" },
            ],
            options: {
                dims: { batch_size: 1 },
                outputs: ["logits"],
            },
        },
    };

/// The shards, keyed by the file names the index places tensors in.
fn every_shard() -> HashMap<String, ByteList> {
    let mut shards = HashMap::<String, ByteList>::new();
    shards["model-00001-of-00003.safetensors"] = #include_bytes("../tests/models/tiny-gpt2/sharded/model-00001-of-00003.safetensors");
    shards["model-00002-of-00003.safetensors"] = #include_bytes("../tests/models/tiny-gpt2/sharded/model-00002-of-00003.safetensors");
    shards["model-00003-of-00003.safetensors"] = #include_bytes("../tests/models/tiny-gpt2/sharded/model-00003-of-00003.safetensors");
    return shards;
}

fn reproduces(input_ids: ByteList, attention_mask: ByteList, logits: ByteList) {
    let [ids, ids_extents] = ints_of(input_ids);
    let [mask, mask_extents] = ints_of(attention_mask);
    let [want, want_extents] = tensor_of(logits);

    let weights = Prepared::load(&mut Cpu {}, &every_shard()).unwrap();
    let got = forward(
        &mut Cpu {},
        &Tensor::<i64, [BatchSize, SequenceLength]> { data: ids, extents: ids_extents },
        &Tensor::<i64, [BatchSize, SequenceLength]> { data: mask, extents: mask_extents },
        &weights,
    );

    assert got.extents == want_extents;
    assert_close(&got.data, &want);
}

test "a sharded checkpoint reproduces the logits of the single file for four tokens" {
    reproduces(
        #include_bytes("../tests/models/tiny-gpt2/test_data_set_0/input_0.pb"),
        #include_bytes("../tests/models/tiny-gpt2/test_data_set_0/input_1.pb"),
        #include_bytes("../tests/models/tiny-gpt2/test_data_set_0/output_0.pb"),
    );
}

test "and for seven" {
    reproduces(
        #include_bytes("../tests/models/tiny-gpt2/test_data_set_1/input_0.pb"),
        #include_bytes("../tests/models/tiny-gpt2/test_data_set_1/input_1.pb"),
        #include_bytes("../tests/models/tiny-gpt2/test_data_set_1/output_0.pb"),
    );
}

test "a shard left out of the load is named with a tensor it holds" {
    let mut given = every_shard();
    given.remove("model-00003-of-00003.safetensors");
    let e = Prepared::load(&mut Cpu {}, &given).unwrap_err();
    assert `${e}` == "onnx::MatMul_1588: the index places it in model-00003-of-00003.safetensors, which is not given";
}
