//! `pytorch-converted/test_Linear_no_bias`: `Transpose` then `MatMul`, the
//! only committed graph reaching `MatMul`. Its weight is an initializer, so
//! ONNX ships one input and the weight travels in the model.

use { from_bytes } from "core:protobuf";
use { ModelProto, float_tensor } from "../src/onnx_proto.wado";
use { assert_close, tensor_of } from "./oracle.wado";
use {
    Batch,
    In,
    Out,
    Tensor,
    Weights,
    forward,
} from "../../vendor/onnx/onnx/backend/test/data/pytorch-converted/test_Linear_no_bias/model.onnx"
    with {
        generator: {
            module: "../src/generator.wado",
            options: {
                layout: [
                    {
                        pattern: "0",
                        axes: ["Batch", "In"],
                    },
                    {
                        pattern: "1",
                        axes: ["Out", "In"],
                    },
                ],
            },
        },
    };

fn weights_of(model_bytes: ByteList) -> Weights {
    let Ok(model) = from_bytes::<ModelProto, ByteList>(model_bytes) else {
        panic("the model did not decode");
    };
    let Some(graph) = &model.graph else {
        panic("a model without a graph");
    };
    let Some([data, extents]) = float_tensor(&graph.initializer[0]) else {
        panic("the initializer is not float");
    };
    return Weights {
        t_1: Tensor::<f32, [Out, In]> { data, extents },
    };
}

test "MatMul reproduces the output ONNX ships" {
    let [x, x_extents] = tensor_of(
        #include_bytes("../../vendor/onnx/onnx/backend/test/data/pytorch-converted/test_Linear_no_bias/test_data_set_0/input_0.pb"),
    );
    let [want, want_extents] = tensor_of(
        #include_bytes("../../vendor/onnx/onnx/backend/test/data/pytorch-converted/test_Linear_no_bias/test_data_set_0/output_0.pb"),
    );
    let weights = weights_of(
        #include_bytes("../../vendor/onnx/onnx/backend/test/data/pytorch-converted/test_Linear_no_bias/model.onnx"),
    );

    let got = forward(&Tensor::<f32, [Batch, In]> { data: x, extents: x_extents }, &weights);

    assert got.extents == want_extents;
    assert_close(&got.data, &want);
}
