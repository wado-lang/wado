//! `pytorch-converted/test_Linear_no_bias`: `Transpose` then `MatMul`, the
//! only committed graph reaching `MatMul`. Its weight is an initializer, so
//! ONNX ships one input and the weight travels in the model.

use { assert_close, tensor_of } from "./oracle.wado";
use { Batch, In, Out, Tensor, Weights, forward } from "../tests/onnx/pytorch-converted/test_Linear_no_bias/model.onnx"
    with {
        generator: {
            module: "../src/generator.wado",
            options: {
                layout: [
                    {
                        pattern: "0",
                        axes: ["Batch", "In"],
                    },
                    {
                        pattern: "1",
                        axes: ["Out", "In"],
                    },
                ],
            },
        },
    };

test "MatMul reproduces the output ONNX ships" {
    let [x, x_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-converted/test_Linear_no_bias/test_data_set_0/input_0.pb"),
    );
    let [want, want_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-converted/test_Linear_no_bias/test_data_set_0/output_0.pb"),
    );

    let got = forward(&Tensor::<f32, [Batch, In]> { data: x, extents: x_extents }, &Weights::embedded());

    assert got.extents == want_extents;
    assert_close(&got.data, &want);
}
