//! Row gathers over an int64 input, and position ids the build folds into a
//! literal tensor.

use { Cpu, Tensor } from "lib:loam";
use { Ids0, Ids1, Prepared, Y2, forward } from "./embedding.onnxtext"
    with {
        type: "onnxtext",
        generator: { module: "lib:loam" },
    };

test "each token's row adds its position's row, and -1 names the last token" {
    let got: Tensor<f32, [Ids0, Ids1, Y2]> = forward(
        &mut Cpu {},
        &Tensor::<i64, [Ids0, Ids1]> {
            data: [3, 0, -1],
            extents: [1, 3],
        },
        &Prepared::embedded(&mut Cpu {}),
    );
    assert got.extents == [1, 3, 2];
    assert got.data == [13.0, 23.5, 30.0, 40.5, 53.0, 63.5];
}
