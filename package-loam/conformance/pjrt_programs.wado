//! The programs `PjrtBackend` compiles: each graph case, and `compute` over
//! models with a cache and an `If`. `pjrt_graph.wado` runs them on a device, and
//! `pjrt_topology.wado` compiles them for one it does not have.

use { PjrtHost } from "core:pjrt";
use { Any, Cpu, Element, Graph, Holds, Located, PjrtBackend, Tensor, Untyped } from "lib:loam";
use cases from "lib:loam/src/runtime/graph_cases.wado";
use { deviation } from "lib:loam/example/webgpu/compare.wado";
use { decoded_tokens, samplers, stepped_tokens, tokens_apart } from "./decoded.wado";
use gated from "./gated.onnxtext"
    with {
        type: "onnxtext",
        generator: { module: "lib:loam" },
    };
use projected from "./projected.onnxtext"
    with {
        type: "onnxtext",
        generator: { module: "lib:loam" },
    };
use attended from "./attended.onnxtext"
    with {
        type: "onnxtext",
        generator: { module: "lib:loam" },
    };
use merged from "../tests/models/tiny-gpt2/merged/model.onnx"
    with {
        type: "onnx",
        generator: {
            module: "lib:loam",
            options: {
                dims: { batch_size: 1 },
            },
        },
    };

/// Runs every program on `device`, and passes `note` each output's name and how
/// far it sits from `Cpu`'s.
pub fn programs(device: &mut PjrtBackend, mut note: fn mut(String, f32) with _) with (_, PjrtHost) {
    let cpu = &mut Cpu {};

    let [x, ids] = cases::mixed_inputs();
    let want = cases::mixed(cpu, &x, &ids);
    let program = device.compiled(|r| {
        let rx = r.parameter::<f32, [cases::A, cases::B]>(x.extents);
        let rids = r.parameter::<i64, [cases::C]>(ids.extents);
        let got = cases::mixed(r, &rx, &rids);
        return r.finished([got.0.id, got.1.id, got.2.id, got.3.id, got.4.id]);
    }, &[], &[]).unwrap();
    let got = device.executed(&program, &[
        Any::F32(untyped(device, &device.upload(&x))),
        Any::I64(untyped(device, &device.upload(&ids))),
    ], &[]);
    note("mixed product", apart(device, &got[0], &want.0));
    note("mixed scattered", apart(device, &got[1], &want.1));
    note("mixed converted", apart(device, &got[2], &want.2));
    note("mixed compared", apart(device, &got[3], &want.3));
    note("mixed i64", apart(device, &got[4], &want.4));

    // The same graph over a weight the device holds in bf16.
    let kept = device.kept_weights(
        |r| r.finished([]),
        0,
        1,
        |_| Result::<Any<Cpu>, ()>::Ok(Any::F32(cpu.relabeled(&x))),
    ).unwrap();
    assert device.weight_bytes()[0] == 12, "every element of the weight fits bf16";
    let over_half = device.compiled(|r| {
        let rids = r.parameter::<i64, [cases::C]>(ids.extents);
        let rx = r.parameter::<f32, [cases::A, cases::B]>(x.extents);
        let graph = cases::mixed(r, &rx, &rids);
        return r.finished([graph.0.id, graph.1.id]);
    }, &kept, &[]).unwrap();
    let halved = device.executed(&over_half, &[Any::I64(untyped(device, &device.upload(&ids)))], &kept);
    note("halved product", apart(device, &halved[0], &want.0));
    note("halved scattered", apart(device, &halved[1], &want.1));

    let [ex, ey] = cases::elementwise_inputs();
    let every = device.compiled(|r| {
        let rx = r.parameter::<f32, [cases::A]>(ex.extents);
        let ry = r.parameter::<f32, [cases::A]>(ey.extents);
        return r.finished([cases::elementwise(r, &rx, &ry).id]);
    }, &[], &[]).unwrap();
    let computed = device.executed(&every, &[
        Any::F32(untyped(device, &device.upload(&ex))),
        Any::F32(untyped(device, &device.upload(&ey))),
    ], &[]);
    note("elementwise", apart(device, &computed[0], &cases::elementwise(cpu, &ex, &ey)));

    let w = cases::windowed_input();
    let windowed = device.compiled(|r| {
        let rw = r.parameter::<f32, [cases::A, cases::B, cases::C]>(w.extents);
        return r.finished([cases::windowed(r, &rw).id]);
    }, &[], &[]).unwrap();
    let slid = device.executed(&windowed, &[Any::F32(untyped(device, &device.upload(&w)))], &[]);
    note("windowed", apart(device, &slid[0], &cases::windowed(cpu, &w)));

    for let p of [true, false] as List<bool> {
        let [pred, bx] = cases::branching_inputs(p);
        let branching = device.compiled(|r| {
            let rp = r.parameter::<bool, [cases::C]>(pred.extents);
            let rx = r.parameter::<f32, [cases::A]>(bx.extents);
            return r.finished([cases::branching(r, &rp, &rx).id]);
        }, &[], &[]).unwrap();
        let branched = device.executed(&branching, &[
            Any::Bool(untyped(device, &device.upload(&pred))),
            Any::F32(untyped(device, &device.upload(&bx))),
        ], &[]);
        note(`branching ${p}`, apart(device, &branched[0], &cases::branching(cpu, &pred, &bx)));
    }

    let ranked = Tensor::<f32, [cases::A, cases::B]> {
        data: [1.0, 3.0, 3.0, f32::NAN, 2.0, -1.0],
        extents: [2, 3],
    };
    let arg_max = device.compiled(|r| {
        let rx = r.parameter::<f32, [cases::A, cases::B]>(ranked.extents);
        return r.finished([r.arg_max(&rx, 1).id]);
    }, &[], &[]).unwrap();
    let first = device.executed(&arg_max, &[Any::F32(untyped(device, &device.upload(&ranked)))], &[]);
    note("arg max", apart(device, &first[0], &cpu.arg_max(&ranked, 1)));

    // `compute` compiles one program per shape class: 5 and 6 positions share a
    // capacity, 7 takes the next.
    let mut gated_device = gated::Model::new(gated::Params::embedded(device));
    let mut gated_cpu = gated::Model::new(gated::Params::embedded(cpu));
    for let [positions, compiled] of [
        [5, 1],
        [6, 1],
        [7, 2],
        [7, 2],
        [5, 2],
    ] as List<[i32, i32]> {
        let input = rows_of::<[gated::N, gated::S, gated::X2]>(positions);
        let on_device = gated::compute(device, &input, &mut gated_device);
        assert gated_device.programs.len() == compiled, "one program per shape class";
        let reference = gated::compute(cpu, &input, &mut gated_cpu);
        note(`compiled gated ${positions}`, deviation(&on_device.data, &reference.data));
    }

    let mut projected_device = projected::Model::new(projected::Params::embedded(device));
    let mut projected_cpu = projected::Model::new(projected::Params::embedded(cpu));
    for let positions of [1, 3, 9] as List<i32> {
        let input = rows_of::<[projected::N, projected::S, projected::X2]>(positions);
        let on_device = projected::compute(device, &input, &mut projected_device);
        let reference = projected::compute(cpu, &input, &mut projected_cpu);
        let worst = f32::max(
            deviation(&on_device.Y.data, &reference.Y.data),
            f32::max(deviation(&on_device.K.data, &reference.K.data), deviation(&on_device.Z.data, &reference.Z.data)),
        );
        note(`compiled projected ${positions}`, worst);
    }

    let mut attended_device = attended::Model::new(attended::Params::embedded(device));
    let mut attended_cpu = attended::Model::new(attended::Params::embedded(cpu));
    let mut cache_device = attended::Cache::empty(device);
    let mut cache_cpu = attended::Cache::empty(cpu);
    let mut total = 0;
    let attended_input = |positions: i32, length: i32| {
        let mut data: List<f32> = [];
        for let i of 0..<positions * 32 {
            data.push(((i + length) % 11) as f32 * 0.125 - 0.625);
        }
        return [
            Tensor::<f32, [attended::X0, attended::S, attended::X2]> {
                data,
                extents: [1, positions, 32],
            },
            Tensor::<i64, [attended::AttentionMask0, attended::T]> {
                data: List::<i64>::filled(length, 1),
                extents: [1, length],
            },
        ];
    };
    for let positions of [3, 1, 1, 1, 1, 1, 1] as List<i32> {
        total += positions;
        let [fresh, mask] = attended_input(positions, total);
        let stepped = attended::compute(device, &fresh, &mask, &cache_device, &mut attended_device);
        let wanted = attended::compute(cpu, &fresh, &mask, &cache_cpu, &mut attended_cpu);
        note(`compiled attended ${total}`, deviation(&stepped.Y.data, &wanted.Y.data));
        cache_device = stepped.cache;
        cache_cpu = wanted.cache;
    }

    // A cache a step has donated still reads as it did up to its length, and two
    // steps from one cache each keep their own positions, whichever goes first.
    let [last, last_mask] = attended_input(1, total + 1);
    let [other, other_mask] = attended_input(2, total + 2);
    let tip = attended::compute(device, &last, &last_mask, &cache_device, &mut attended_device);
    let tip_cpu = attended::compute(cpu, &last, &last_mask, &cache_cpu, &mut attended_cpu);
    note("branched first", deviation(&tip.Y.data, &tip_cpu.Y.data));
    let sibling = attended::compute(device, &other, &other_mask, &cache_device, &mut attended_device);
    let sibling_cpu = attended::compute(cpu, &other, &other_mask, &cache_cpu, &mut attended_cpu);
    note("branched second", deviation(&sibling.Y.data, &sibling_cpu.Y.data));
    let [after, after_mask] = attended_input(1, total + 2);
    let resumed = attended::compute(device, &after, &after_mask, &tip.cache, &mut attended_device);
    let resumed_cpu = attended::compute(cpu, &after, &after_mask, &tip_cpu.cache, &mut attended_cpu);
    note("branched resumed", deviation(&resumed.Y.data, &resumed_cpu.Y.data));

    // An `If` on an input: the prompt takes the branch without a past, each
    // step after it the one with.
    let mut merged_device = merged::Model::new(merged::Params::embedded(device));
    let mut merged_cpu = merged::Model::new(merged::Params::embedded(cpu));
    let mut past_device = merged::Cache::empty(device);
    let mut past_cpu = merged::Cache::empty(cpu);
    let mut length = 0;
    for let tokens of [
        [1, 5, 42, 7],
        [11],
        [13],
    ] as List<List<i64>> {
        let fresh = Tensor::<i64, [merged::BatchSize, merged::SequenceLength]> {
            data: tokens,
            extents: [1, tokens.len()],
        };
        let mask = Tensor::<i64, [merged::BatchSize, merged::SequenceLength]> {
            data: List::<i64>::filled(length + tokens.len(), 1),
            extents: [1, length + tokens.len()],
        };
        let branch = Tensor::<bool, [merged::UseCacheBranch0]> {
            data: [length > 0],
            extents: [1],
        };
        let stepped = merged::compute(device, &fresh, &mask, &branch, &past_device, &mut merged_device);
        let wanted = merged::compute(cpu, &fresh, &mask, &branch, &past_cpu, &mut merged_cpu);
        length += tokens.len();
        note(`compiled merged ${length}`, deviation(&stepped.logits.data, &wanted.logits.data));
        past_device = stepped.cache;
        past_cpu = wanted.cache;
    }

    for let times of [0, 1, 4] as List<i64> {
        let [count, xs, tallies] = cases::repeating_inputs(times);
        let repeated = device.compiled(|r| {
            let rcount = r.parameter::<i64, []>(count.extents);
            let rx = r.parameter::<f32, [cases::A]>(xs.extents);
            let rids = r.parameter::<i64, [cases::A]>(tallies.extents);
            let last = cases::repeating(r, &rcount, &rx, &rids);
            return r.finished([last.0.id, last.1.id]);
        }, &[], &[]).unwrap();
        let ran = device.executed(&repeated, &[
            Any::I64(untyped(device, &device.upload(&count))),
            Any::F32(untyped(device, &device.upload(&xs))),
            Any::I64(untyped(device, &device.upload(&tallies))),
        ], &[]);
        let want = cases::repeating(cpu, &count, &xs, &tallies);
        note(`repeated ${times} carried`, apart(device, &ran[0], &want.0));
        note(`repeated ${times} tally`, apart(device, &ran[1], &want.1));
    }

    for let [k, sampling] of samplers().into_iter().enumerate() {
        let want = stepped_tokens(cpu, [2, 6, 1], 8, &sampling);
        let read_before = device.read_backs();
        note(`decoded ${k}`, tokens_apart(&decoded_tokens(device, [2, 6, 1], [7], &sampling), &want));
        assert device.read_backs() - read_before == 2, "the prompt's logits, then every step's tokens at once";
        note(`decoded split ${k}`, tokens_apart(&decoded_tokens(device, [2, 6, 1], [3, 4], &sampling), &want));
    }
}

/// `positions` rows of two features, each a distinct value.
fn rows_of<Axes>(positions: i32) -> Tensor<f32, Axes> {
    let mut data: List<f32> = [];
    for let i of 0..<positions * 2 {
        data.push((i % 7) as f32 * 0.25 - 0.75);
    }
    return Tensor {
        data,
        extents: [1, positions, 2],
    };
}

fn untyped<E: Element, Axes>(g: &PjrtBackend, t: &Located<E, Axes>) -> Located<E, Untyped> {
    return g.relabeled(t);
}

/// How far the program's result `got` sits from `want`, each as f32.
fn apart<E: Element, Axes>(g: &mut PjrtBackend, got: &Any<PjrtBackend>, want: &Tensor<E, Axes>) -> f32 with PjrtHost {
    let cpu = &mut Cpu {};
    let read = match got {
        F32(t) => g.download(t),
        I64(t) => cpu.convert::<i64, f32, Untyped>(&g.download(t)),
        Bool(t) => cpu.convert::<bool, f32, Untyped>(&g.download(t)),
    };
    if read.extents != want.extents {
        return f32::NAN;
    }
    return deviation(&read.data, &cpu.convert::<E, f32, Axes>(want).data);
}
