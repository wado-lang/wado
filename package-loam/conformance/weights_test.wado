//! `pytorch-operator/test_operator_params`: the same elementwise chain as
//! `basic_test`, with one operand an initializer. ONNX ships one input for it
//! and no second, since the weight travels in the model.

use { from_bytes } from "core:protobuf";
use { ModelProto, float_tensor } from "../src/onnx_proto.wado";
use { assert_close, tensor_of } from "./oracle.wado";
use {
    Col,
    Row,
    Tensor,
    Weights,
    forward,
} from "../../vendor/onnx/onnx/backend/test/data/pytorch-operator/test_operator_params/model.onnx"
    with {
        generator: {
            module: "../src/generator.wado",
            options: {
                layout: [
                    {
                        pattern: "0",
                        axes: ["Row", "Col"],
                    },
                    {
                        pattern: "1",
                        axes: ["Row", "Col"],
                    },
                ],
            },
        },
    };

/// The initializer, read straight out of the model. This is the seam Loam's
/// checkpoint reader fills: what a reader produces is the `Weights` struct.
fn weights_of(model_bytes: ByteList) -> Weights {
    let Ok(model) = from_bytes::<ModelProto, ByteList>(model_bytes) else {
        panic("the model did not decode");
    };
    let Some(graph) = &model.graph else {
        panic("a model without a graph");
    };
    let Some([data, extents]) = float_tensor(&graph.initializer[0]) else {
        panic("the initializer is not float");
    };
    return Weights {
        t_1: Tensor::<f32, [Row, Col]> { data, extents },
    };
}

test "a graph with an initializer reproduces the output ONNX ships" {
    let [x, x_extents] = tensor_of(
        #include_bytes("../../vendor/onnx/onnx/backend/test/data/pytorch-operator/test_operator_params/test_data_set_0/input_0.pb"),
    );
    let [want, want_extents] = tensor_of(
        #include_bytes("../../vendor/onnx/onnx/backend/test/data/pytorch-operator/test_operator_params/test_data_set_0/output_0.pb"),
    );
    let weights = weights_of(
        #include_bytes("../../vendor/onnx/onnx/backend/test/data/pytorch-operator/test_operator_params/model.onnx"),
    );

    let got = forward(&Tensor::<f32, [Row, Col]> { data: x, extents: x_extents }, &weights);

    assert got.extents == want_extents;
    assert_close(&got.data, &want);
}
