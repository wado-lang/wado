//! Two operands' axes of 1 meeting, which is one axis: the kernel must produce
//! the output under the one name both take.

use { Cpu, Tensor } from "lib:loam";
use { Prepared, forward } from "./renamed_unit.onnxtext"
    with {
        type: "onnxtext",
        generator: { module: "lib:loam" },
    };

test "a folded scalar and a Gemm bias, folded or not, each name the axis of 1 they meet" {
    let out = forward(
        &mut Cpu {},
        &Tensor {
            data: [1.0],
            extents: [1],
        },
        &Tensor {
            data: [1.0, 2.0, 3.0],
            extents: [1, 3],
        },
        &Tensor {
            data: [1.0, 0.0, 0.0, 1.0, 1.0, 1.0],
            extents: [3, 2],
        },
        &Prepared::embedded(&mut Cpu {}),
    );

    assert out.Y.data == [3.0] as List<f32>;
    assert out.G.data == [4.5, 5.25] as List<f32>;
    assert out.H.data == [5.0, 6.0] as List<f32>;
}
