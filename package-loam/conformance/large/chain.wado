//! `chain.onnxtext` loaded from the checkpoint `write.wado` writes, a tensor
//! at a time, and run once.

use { Preopens } from "core:fs";
use { Backend, FileSource, Tensor } from "lib:loam";
use { DIR, N, WEIGHTS, moved } from "./layout.wado";
use { Model, Params, compute } from "./chain.onnxtext"
    with {
        type: "onnxtext",
        generator: {
            module: "lib:loam",
            inputs: [
                { path: "../build/large/model.safetensors.index.json", type: "safetensors-index" },
                { path: "../build/large/model-00001-of-00002.safetensors", type: "safetensors" },
                { path: "../build/large/model-00002-of-00002.safetensors", type: "safetensors" },
            ],
        },
    };

/// How many of `y`'s elements are not where the chain moves `x`'s: none, where
/// every weight came from its own range.
pub fn misplaced<affine Bk: Backend>(backend: &mut Bk) -> i32 with (_, Preopens) {
    let mut model = Model::new(Params::load(backend, &FileSource { dir: DIR }).unwrap());
    let x: List<f32> = (0..<N).map(|i| i as f32).collect();
    let y = compute(backend, &Tensor {
        data: x,
        extents: [1, N],
    }, &mut model);
    let mut off = 0;
    for let i of 0..<N {
        let mut at = i;
        for let k of 0..<WEIGHTS {
            at = moved(k, at);
        }
        if y.data[at] != x[i] {
            off += 1;
        }
    }
    return off;
}
