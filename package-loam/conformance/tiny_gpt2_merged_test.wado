//! A tiny GPT-2 exported as one graph that branches on whether it is given a
//! past, so one module holds one set of weights. The prompt runs through the
//! branch without a past, all its positions at once, and each step after it
//! through the branch with one. Each reproduces the logits onnxruntime computes.

use { Cpu, Tensor } from "lib:loam";
use { assert_close, ints_of, tensor_of } from "./oracle.wado";
use merged from "../tests/models/tiny-gpt2/merged/model.onnx"
    with {
        type: "onnx",
        generator: {
            module: "lib:loam",
            options: {
                dims: { batch_size: 1 },
            },
        },
    };

/// The keys and values so far, one `[data, extents]` per layer's key and
/// value in the order the graph names them. A present is as long as the past
/// and the step together, an axis of its own, so the cache crosses back as its
/// elements.
type Cache = List<[List<f32>, List<i32>]>;

/// Entry `i` of the cache, under the axes the input it is passed as names.
fn past<A>(cache: &Cache, i: i32) -> Tensor<f32, A> {
    let [data, extents] = cache[i];
    return Tensor { data, extents };
}

/// The logits for `ids` after the positions `cache` holds, and the cache grown
/// by theirs. An empty cache takes the branch without a past.
fn run(
    ids: List<i64>,
    cache: &Cache,
    weights: &merged::Prepared<Cpu>,
) -> [Tensor<f32, [merged::BatchSize, merged::SequenceLength, merged::Logits2]>, Cache] {
    let length = cache[0].1[2] + ids.len();
    let o = merged::forward(
        &mut Cpu {},
        &Tensor::<i64, [merged::BatchSize, merged::SequenceLength]> {
            data: ids,
            extents: [1, ids.len()],
        },
        &Tensor::<i64, [merged::BatchSize, merged::SequenceLength]> {
            data: List::<i64>::filled(length, 1),
            extents: [1, length],
        },
        &past(cache, 0),
        &past(cache, 1),
        &past(cache, 2),
        &past(cache, 3),
        &past(cache, 4),
        &past(cache, 5),
        &past(cache, 6),
        &past(cache, 7),
        &past(cache, 8),
        &past(cache, 9),
        &Tensor::<bool, [merged::UseCacheBranch0]> {
            data: [cache[0].1[2] > 0],
            extents: [1],
        },
        weights,
    );
    let grown: Cache = [
        [o.present_0_key.data, o.present_0_key.extents],
        [o.present_0_value.data, o.present_0_value.extents],
        [o.present_1_key.data, o.present_1_key.extents],
        [o.present_1_value.data, o.present_1_value.extents],
        [o.present_2_key.data, o.present_2_key.extents],
        [o.present_2_value.data, o.present_2_value.extents],
        [o.present_3_key.data, o.present_3_key.extents],
        [o.present_3_value.data, o.present_3_value.extents],
        [o.present_4_key.data, o.present_4_key.extents],
        [o.present_4_value.data, o.present_4_value.extents],
    ];
    return [o.logits, grown];
}

fn empty_cache() -> Cache {
    let mut cache: Cache = [];
    for let _ of 0..<10 {
        cache.push([
            [],
            [1, 4, 0, 8],
        ]);
    }
    return cache;
}

test "the prompt and each step after it reproduce onnxruntime's logits through one module" {
    let weights = merged::Prepared::embedded(&mut Cpu {});
    let data: List<[ByteList, ByteList]> = [
        [
            #include_bytes("../tests/models/tiny-gpt2/merged/test_data_set_0/input_0.pb"),
            #include_bytes("../tests/models/tiny-gpt2/merged/test_data_set_0/output_0.pb"),
        ],
        [
            #include_bytes("../tests/models/tiny-gpt2/merged/test_data_set_1/input_0.pb"),
            #include_bytes("../tests/models/tiny-gpt2/merged/test_data_set_1/output_0.pb"),
        ],
        [
            #include_bytes("../tests/models/tiny-gpt2/merged/test_data_set_2/input_0.pb"),
            #include_bytes("../tests/models/tiny-gpt2/merged/test_data_set_2/output_0.pb"),
        ],
    ];
    let mut cache = empty_cache();
    let mut length = 0;
    for let pair of data {
        let [input, output] = pair;
        let [ids, _] = ints_of(input);
        let [want, want_extents] = tensor_of(output);
        length += ids.len();
        let [logits, grown] = run(ids, &cache, &weights);
        assert logits.extents == want_extents;
        assert_close(&logits.data, &want);
        assert grown[0].1 == [1, 4, length, 8] as List<i32>;
        cache = grown;
    }
}

// The branch with a past reads the mask against the past and the step
// together; one only as long as the step stops it.
#[expect_trap]
test "a mask that is not as long as the past and the step stops the step" {
    let weights = merged::Prepared::embedded(&mut Cpu {});
    let [_, cache] = run([1, 5, 42, 7], &empty_cache(), &weights);
    merged::forward(
        &mut Cpu {},
        &Tensor::<i64, [merged::BatchSize, merged::SequenceLength]> {
            data: [11],
            extents: [1, 1],
        },
        &Tensor::<i64, [merged::BatchSize, merged::SequenceLength]> {
            data: [1],
            extents: [1, 1],
        },
        &past(&cache, 0),
        &past(&cache, 1),
        &past(&cache, 2),
        &past(&cache, 3),
        &past(&cache, 4),
        &past(&cache, 5),
        &past(&cache, 6),
        &past(&cache, 7),
        &past(&cache, 8),
        &past(&cache, 9),
        &Tensor::<bool, [merged::UseCacheBranch0]> {
            data: [true],
            extents: [1],
        },
        &weights,
    );
}
