//! The tiny GPT-2 decoder of `tiny_gpt2.wado` built with `embed: false`, its
//! weights read in place out of the model file itself, against the logits
//! onnxruntime computes.

use { Cpu, Tensor } from "lib:loam";
use { assert_close, ints_of, tensor_of } from "./oracle.wado";
use { BatchSize, Prepared, SequenceLength, forward } from "../tests/models/tiny-gpt2/model.onnx"
    with {
        type: "onnx",
        generator: {
            module: "lib:loam",
            options: {
                dims: { batch_size: 1 },
                outputs: ["logits"],
                embed: false,
            },
        },
    };

fn reproduces(input_ids: ByteList, attention_mask: ByteList, logits: ByteList) {
    let [ids, ids_extents] = ints_of(input_ids);
    let [mask, mask_extents] = ints_of(attention_mask);
    let [want, want_extents] = tensor_of(logits);

    let weights = Prepared::load(&mut Cpu {}, &#include_bytes("../tests/models/tiny-gpt2/model.onnx")).unwrap();
    let got = forward(
        &mut Cpu {},
        &Tensor::<i64, [BatchSize, SequenceLength]> { data: ids, extents: ids_extents },
        &Tensor::<i64, [BatchSize, SequenceLength]> { data: mask, extents: mask_extents },
        &weights,
    );

    assert got.extents == want_extents;
    assert_close(&got.data, &want);
}

test "weights read in place from the model file reproduce the logits for four tokens" {
    reproduces(
        #include_bytes("../tests/models/tiny-gpt2/test_data_set_0/input_0.pb"),
        #include_bytes("../tests/models/tiny-gpt2/test_data_set_0/input_1.pb"),
        #include_bytes("../tests/models/tiny-gpt2/test_data_set_0/output_0.pb"),
    );
}

test "and for seven" {
    reproduces(
        #include_bytes("../tests/models/tiny-gpt2/test_data_set_1/input_0.pb"),
        #include_bytes("../tests/models/tiny-gpt2/test_data_set_1/input_1.pb"),
        #include_bytes("../tests/models/tiny-gpt2/test_data_set_1/output_0.pb"),
    );
}

test "a file of another length than the model the build read is refused" {
    let model = #include_bytes("../tests/models/tiny-gpt2/model.onnx");
    let mut longer = model;
    longer.push(0);
    let e = Prepared::load(&mut Cpu {}, &longer).unwrap_err();
    assert `${e}` == `the file is ${model.len() + 1} bytes, and the build found the weights in one of ${model.len()}`;
}
