//! The tiny GPT-2 decoder of `tiny_gpt2.wado`, run from the checkpoint holding
//! its weights against the logits onnxruntime computes for two sequences of
//! different lengths.

use { Cpu, Tensor } from "lib:loam";
use { assert_close, ints_of, tensor_of } from "./oracle.wado";
use { StoredTensor, write_safetensors } from "../src/safetensors.wado";
use gpt2 from "./tiny_gpt2.wado";

/// The logits `forward` computes from one data set's inputs, against the ones
/// onnxruntime computed.
fn reproduces(input_ids: ByteList, attention_mask: ByteList, logits: ByteList) {
    let [ids, ids_extents] = ints_of(input_ids);
    let [mask, mask_extents] = ints_of(attention_mask);
    let [want, want_extents] = tensor_of(logits);

    let weights = gpt2::Prepared::load(&mut Cpu {}, &#include_bytes("../tests/models/tiny-gpt2/model.safetensors")).unwrap(
    );
    let got = gpt2::forward(
        &mut Cpu {},
        &Tensor::<i64, [gpt2::Batch, gpt2::Seq]> { data: ids, extents: ids_extents },
        &Tensor::<i64, [gpt2::Batch, gpt2::Seq]> { data: mask, extents: mask_extents },
        &weights,
    );

    assert got.extents == want_extents;
    assert_close(&got.data, &want);
}

test "a tiny GPT-2 reproduces the logits onnxruntime computes for four tokens" {
    reproduces(
        #include_bytes("../tests/models/tiny-gpt2/test_data_set_0/input_0.pb"),
        #include_bytes("../tests/models/tiny-gpt2/test_data_set_0/input_1.pb"),
        #include_bytes("../tests/models/tiny-gpt2/test_data_set_0/output_0.pb"),
    );
}

test "the same module reproduces them for seven" {
    reproduces(
        #include_bytes("../tests/models/tiny-gpt2/test_data_set_1/input_0.pb"),
        #include_bytes("../tests/models/tiny-gpt2/test_data_set_1/input_1.pb"),
        #include_bytes("../tests/models/tiny-gpt2/test_data_set_1/output_0.pb"),
    );
}

// The causal mask covers 512 positions. That the owed check traps before any
// kernel runs is `emit_test`'s to show; a trap is all this one can see.
#[expect_trap]
test "a sequence longer than the mask stops forward" {
    let ids = List::<i64>::filled(513, 0);
    let mask = List::<i64>::filled(513, 1);
    let weights = gpt2::Prepared::load(&mut Cpu {}, &#include_bytes("../tests/models/tiny-gpt2/model.safetensors")).unwrap(
    );
    gpt2::forward(
        &mut Cpu {},
        &Tensor::<i64, [gpt2::Batch, gpt2::Seq]> {
            data: ids,
            extents: [1, 513],
        },
        &Tensor::<i64, [gpt2::Batch, gpt2::Seq]> {
            data: mask,
            extents: [1, 513],
        },
        &weights,
    );
}

test "a checkpoint of another model names the axis it disagrees on" {
    let other = write_safetensors(&[
        StoredTensor {
            name: "transformer.wte.weight",
            dtype: "F32",
            shape: [1024, 64],
            data: ByteList::filled(1024 * 64 * 4, 0),
        },
    ]);
    let e = gpt2::Prepared::load(&mut Cpu {}, &other).unwrap_err();
    assert `${e}` == "transformer.wte.weight: axis Embed is 64 in the checkpoint and 32 in the graph";
}
