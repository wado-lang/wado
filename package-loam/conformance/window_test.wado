//! The window operators against the outputs ONNX ships: `MaxPool` over one and
//! two spatial axes, and `Conv` with its bias.

use { Cpu, Tensor } from "lib:loam";
use { assert_close, tensor_of } from "./oracle.wado";
use pool2d from "../tests/onnx/pytorch-converted/test_MaxPool2d/model.onnx"
    with {
        type: "onnx",
        generator: { module: "lib:loam" },
    };
use pool1d from "../tests/onnx/pytorch-operator/test_operator_maxpool/model.onnx"
    with {
        type: "onnx",
        generator: { module: "lib:loam" },
    };
use conv2d from "../tests/onnx/pytorch-converted/test_Conv2d/model.onnx"
    with {
        type: "onnx",
        generator: { module: "lib:loam" },
    };

test "MaxPool over two padded axes reproduces the output ONNX ships" {
    let [x, x_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-converted/test_MaxPool2d/test_data_set_0/input_0.pb"),
    );
    let [want, want_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-converted/test_MaxPool2d/test_data_set_0/output_0.pb"),
    );

    let got = pool2d::forward(
        &mut Cpu {},
        &Tensor::<f32, [pool2d::Axis00, pool2d::Axis01, pool2d::Axis02, pool2d::Axis03]> { data: x, extents: x_extents },
        &pool2d::Weights {}.prepare(&mut Cpu {}),
    );

    assert got.extents == want_extents;
    assert_close(&got.data, &want);
}

test "MaxPool over one axis reproduces the output ONNX ships" {
    let [x, x_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_maxpool/test_data_set_0/input_0.pb"),
    );
    let [want, want_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_maxpool/test_data_set_0/output_0.pb"),
    );

    let got = pool1d::forward(
        &mut Cpu {},
        &Tensor::<f32, [pool1d::Axis00, pool1d::Axis01, pool1d::Axis02]> { data: x, extents: x_extents },
        &pool1d::Weights {}.prepare(&mut Cpu {}),
    );

    assert got.extents == want_extents;
    assert_close(&got.data, &want);
}

test "Conv with a bias reproduces the output ONNX ships" {
    let [x, x_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-converted/test_Conv2d/test_data_set_0/input_0.pb"),
    );
    let [want, want_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-converted/test_Conv2d/test_data_set_0/output_0.pb"),
    );

    let got = conv2d::forward(
        &mut Cpu {},
        &Tensor::<f32, [conv2d::Axis00, conv2d::Axis01, conv2d::Axis02, conv2d::Axis03]> { data: x, extents: x_extents },
        &conv2d::Prepared::embedded(&mut Cpu {}),
    );

    assert got.extents == want_extents;
    assert_close(&got.data, &want);
}
