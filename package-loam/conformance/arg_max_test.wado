//! The `arg_max` option: `forward` and `compute` return the index of each
//! lane's greatest element, here at the last position `last` keeps.

use { Cpu, Tensor } from "lib:loam";
use { N, S, W1, X2, Model, Params, Weights, compute, forward } from "./ranked.onnxtext"
    with {
        type: "onnxtext",
        generator: {
            module: "lib:loam",
            options: {
                last: { Y: 1 },
                arg_max: { Y: 2 },
            },
        },
    };

global X: List<f32> = [
    0.5, -1.0, 2.0, 0.25, 1.5, 0.0, -0.5, 1.0, -2.0, 0.75, 1.25, -0.25, 1.0, 2.0, -1.5, 0.5, -0.75, 0.25, 1.75, -1.25,
    0.0, -0.5, 1.5, 2.5,
];
global W: List<f32> = [0.5, -1.0, 0.25, 1.0, 0.0, -0.5, -0.25, 1.5, 0.75, 2.0, -0.75, 1.0];

/// For each of 2 lanes of `seq` positions, the index of the greatest score
/// `ranked.onnxtext` computes at the last position.
fn ranked_by_hand(seq: i32) -> List<i64> {
    let mut indices: List<i64> = [];
    for let lane of 0..<2 {
        let row = (lane * seq + seq - 1) * 4;
        let mut scores: List<f32> = [];
        for let v of 0..<3 {
            let mut y = 0.0 as f32;
            for let e of 0..<4 {
                y += f32::max(X[row + e], 0.0) * W[e * 3 + v];
            }
            scores.push(y);
        }
        let mut best = 0;
        for let v of 1..<3 {
            if scores[v] > scores[best] {
                best = v;
            }
        }
        indices.push(best as i64);
    }
    return indices;
}

fn x(seq: i32) -> Tensor<f32, [N, S, X2]> {
    return Tensor { data: X[0..<2 * seq * 4].to_list(), extents: [2, seq, 4] };
}

fn w() -> Tensor<f32, [X2, W1]> {
    return Tensor { data: W, extents: [4, 3] };
}

test "the lanes rank different indices, so the case tells them apart" {
    let ranked = ranked_by_hand(3);
    assert ranked[0] != ranked[1];
}

test "the ranked axis keeps the extent the weight fixes" {
    assert W1::EXTENT == 3;
}

test "forward returns the index of each lane's greatest element" {
    let got = forward(&mut Cpu {}, &x(3), &w(), &Weights {}.prepare(&mut Cpu {}));
    assert got.extents == [2, 1, 1];
    assert got.data == ranked_by_hand(3);
}

test "compute returns what forward does" {
    let mut cpu = Cpu {};
    let mut model = Model::new(Params::embedded(&mut cpu));
    let got = compute(&mut cpu, &x(3), &w(), &mut model);
    assert got.extents == [2, 1, 1];
    assert got.data == ranked_by_hand(3);
}
