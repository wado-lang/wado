//! A backend whose tensor is a handle with no field a `Tensor` has: spliced
//! after a generated module, which it implements `Backend` for, a `forward`
//! reading `.data` or `.extents` past the seam does not compile. It runs the
//! CPU's kernels, so it computes what `Cpu` does.
//!
//! Not a module of its own: it reads the runtime names the generated module
//! imports, so the tests discover none of it, and `program_over` in
//! `oracle.wado` splices it.

use { Cpu, Element, Epilogue, Expr, Held, Read, widen } from "lib:loam";

/// A tensor the generated module holds but cannot open.
struct Handle<E, Axes> {
    held: Tensor<E, Axes>,
}

/// The CPU's kernels behind handles, counting the tensors that cross the seam
/// each way, and the half-precision ones converted on the way in.
struct Opaque {
    cpu: Cpu,
    uploads: i32,
    downloads: i32,
    prepared: i32,
}

impl Opaque {
    fn new() -> Opaque {
        return Opaque { cpu: Cpu {}, uploads: 0, downloads: 0, prepared: 0 };
    }

    fn reads<Axes>(&mut self, operands: &List<Handle<f32, Axes>>) -> List<Read<Axes>> {
        let mut reads: List<Read<Axes>> = [];
        for let o of *operands {
            reads.push(self.cpu.read(&o.held));
        }
        return reads;
    }
}

fn handle<E, Axes>(held: Tensor<E, Axes>) -> Handle<E, Axes> {
    return Handle { held };
}

/// `then`'s operands opened, as the CPU's kernels read them.
fn opened<Axes>(cpu: &mut Cpu, then: &Option<Epilogue<Handle<f32, Axes>>>) -> Option<Epilogue<Read<Axes>>> {
    let Some(e) = then else {
        return null;
    };
    let mut operands: List<Read<Axes>> = [];
    for let o of &e.operands {
        operands.push(cpu.read(&o.held));
    }
    return Option::Some(Epilogue { operands, op: e.op });
}

impl Backend for Opaque {
    type Tensor<E: Element, Axes> = Handle<E, Axes>;
    type Operand<Axes> = Handle<f32, Axes>;

    fn upload<E: Element, Axes>(&mut self, t: &Tensor<E, Axes>) -> Handle<E, Axes> {
        self.uploads += 1;
        return handle(*t);
    }

    fn download<E: Element, Axes>(&mut self, t: &Handle<E, Axes>) -> Tensor<E, Axes> {
        self.downloads += 1;
        return t.held;
    }

    fn prepare<E: Held, Axes>(&mut self, t: &Tensor<E, Axes>) -> Handle<f32, Axes> {
        self.prepared += 1;
        return handle(widen(t));
    }

    fn filled<E: Element, Axes>(&mut self, extents: List<i32>, value: E) -> Handle<E, Axes> {
        return handle(self.cpu.filled(extents, value));
    }

    fn range_i64<A>(&mut self, start: i64, count: i32, delta: i64) -> Handle<i64, [A]> {
        return handle(self.cpu.range_i64(start, count, delta));
    }

    fn read<Axes>(&mut self, t: &Handle<f32, Axes>) -> Handle<f32, Axes> {
        return *t;
    }

    fn read_suffix<..Pre, ..Suf>(&mut self, t: &Handle<f32, [..Suf]>) -> Handle<f32, [..Pre, ..Suf]> {
        return handle(Tensor { data: t.held.data, extents: t.held.extents });
    }

    fn read_at<..Pre, ..Mid, ..Post>(
        &mut self,
        t: &Handle<f32, [..Mid]>,
        trailing: i32,
    ) -> Handle<f32, [..Pre, ..Mid, ..Post]> {
        let mut extents = t.held.extents;
        for let _ of 0..<trailing {
            extents.push(1);
        }
        return handle(Tensor { data: t.held.data, extents });
    }

    fn read_condition<Axes>(&mut self, t: &Handle<bool, Axes>) -> Handle<f32, Axes> {
        let mut values = List::<f32>::with_capacity(t.held.data.len());
        for let b of t.held.data {
            values.push(if b { 1.0 } else { 0.0 });
        }
        return handle(Tensor { data: values, extents: t.held.extents });
    }

    fn fused<Axes>(&mut self, operands: List<Handle<f32, Axes>>, op: &Expr) -> Handle<f32, Axes> {
        return handle(self.cpu.fused(self.reads(&operands), op));
    }

    fn rows<In, Out>(
        &mut self,
        operands: List<Handle<f32, In>>,
        op: &Expr,
        row_axes: i32,
        reduced: bool,
    ) -> Handle<f32, Out> {
        return handle(self.cpu.rows::<In, Out>(self.reads(&operands), op, row_axes, reduced));
    }

    fn cast<A: Element, B: Element, Axes>(&mut self, t: &Handle<A, Axes>) -> Handle<B, Axes> {
        return handle(self.cpu.cast::<A, B, Axes>(&t.held));
    }

    fn select<E: Element, Axes>(
        &mut self,
        cond: &Handle<bool, Axes>,
        x: &Handle<E, Axes>,
        y: &Handle<E, Axes>,
    ) -> Handle<E, Axes> {
        return handle(self.cpu.select(&cond.held, &x.held, &y.held));
    }

    fn matmul<..Bs, M, K, N>(
        &mut self,
        a: &Handle<f32, [..Bs, M, K]>,
        b: &Handle<f32, [..Bs, K, N]>,
        then: Option<Epilogue<Handle<f32, [..Bs, M, N]>>>,
    ) -> Handle<f32, [..Bs, M, N]> {
        let read = opened(&mut self.cpu, &then);
        return handle(self.cpu.matmul(&a.held, &b.held, read));
    }

    fn matmul_shared<..Bs, M, K, N>(
        &mut self,
        a: &Handle<f32, [..Bs, M, K]>,
        b: &Handle<f32, [K, N]>,
        then: Option<Epilogue<Handle<f32, [..Bs, M, N]>>>,
    ) -> Handle<f32, [..Bs, M, N]> {
        let read = opened(&mut self.cpu, &then);
        return handle(self.cpu.matmul_shared(&a.held, &b.held, read));
    }

    fn matmul_broadcast<A, B, Out>(
        &mut self,
        a: &Handle<f32, A>,
        b: &Handle<f32, B>,
        then: Option<Epilogue<Handle<f32, Out>>>,
    ) -> Handle<f32, Out> {
        let read = opened(&mut self.cpu, &then);
        return handle(self.cpu.matmul_broadcast::<A, B, Out>(&a.held, &b.held, read));
    }

    fn gather_rows<E: Element, Row, ..Rest, ..Ix>(
        &mut self,
        data: &Handle<E, [Row, ..Rest]>,
        indices: &Handle<i64, [..Ix]>,
    ) -> Handle<E, [..Ix, ..Rest]> {
        return handle(self.cpu.gather_rows::<E, Row, [..Rest], [..Ix]>(&data.held, &indices.held));
    }

    fn gather<E: Element, ..Pre, Along, ..Post, ..Ix>(
        &mut self,
        data: &Handle<E, [..Pre, Along, ..Post]>,
        indices: &Handle<i64, [..Ix]>,
        axis: i32,
    ) -> Handle<E, [..Pre, ..Ix, ..Post]> {
        return handle(self.cpu.gather::<E, [..Pre], Along, [..Post], [..Ix]>(&data.held, &indices.held, axis));
    }

    fn slice_axis<E: Element, ..Pre, In, Out, ..Post>(
        &mut self,
        t: &Handle<E, [..Pre, In, ..Post]>,
        axis: i32,
        start: i64,
        length: i32,
        step: i64,
    ) -> Handle<E, [..Pre, Out, ..Post]> {
        return handle(self.cpu.slice_axis::<E, [..Pre], In, Out, [..Post]>(&t.held, axis, start, length, step));
    }

    fn concat<E: Element, ..Pre, A, B, Out, ..Post>(
        &mut self,
        a: &Handle<E, [..Pre, A, ..Post]>,
        b: &Handle<E, [..Pre, B, ..Post]>,
        axis: i32,
    ) -> Handle<E, [..Pre, Out, ..Post]> {
        return handle(self.cpu.concat::<E, [..Pre], A, B, Out, [..Post]>(&a.held, &b.held, axis));
    }

    fn lift<E: Element, In, Out>(&mut self, t: &Handle<E, In>, rank: i32) -> Handle<E, Out> {
        return handle(self.cpu.lift::<E, In, Out>(&t.held, rank));
    }

    fn reshape<E: Element, In, Out>(&mut self, t: &Handle<E, In>, extents: List<i32>) -> Handle<E, Out> {
        return handle(self.cpu.reshape::<E, In, Out>(&t.held, extents));
    }

    fn transpose2<E: Element, A, B>(&mut self, t: &Handle<E, [A, B]>) -> Handle<E, [B, A]> {
        return handle(self.cpu.transpose2(&t.held));
    }

    fn permute<E: Element, In, Out>(&mut self, t: &Handle<E, In>, perm: List<i32>) -> Handle<E, Out> {
        return handle(self.cpu.permute::<E, In, Out>(&t.held, perm));
    }

    fn max_pool<N, C, ..In, ..Out>(
        &mut self,
        x: &Handle<f32, [N, C, ..In]>,
        window: &Window,
    ) -> Handle<f32, [N, C, ..Out]> {
        return handle(self.cpu.max_pool::<N, C, [..In], [..Out]>(&x.held, window));
    }

    fn conv<N, Ci, Co, ..In, ..K, ..Out>(
        &mut self,
        x: &Handle<f32, [N, Ci, ..In]>,
        w: &Handle<f32, [Co, Ci, ..K]>,
        window: &Window,
        then: Option<Epilogue<Handle<f32, [N, Co, ..Out]>>>,
    ) -> Handle<f32, [N, Co, ..Out]> {
        let read = opened(&mut self.cpu, &then);
        return handle(self.cpu.conv::<N, Ci, Co, [..In], [..K], [..Out]>(&x.held, &w.held, window, read));
    }

    fn conv_bias<N, Ci, Co, ..In, ..K, ..Out>(
        &mut self,
        x: &Handle<f32, [N, Ci, ..In]>,
        w: &Handle<f32, [Co, Ci, ..K]>,
        b: &Handle<f32, [Co]>,
        window: &Window,
        then: Option<Epilogue<Handle<f32, [N, Co, ..Out]>>>,
    ) -> Handle<f32, [N, Co, ..Out]> {
        let read = opened(&mut self.cpu, &then);
        return handle(
            self.cpu.conv_bias::<N, Ci, Co, [..In], [..K], [..Out]>(&x.held, &w.held, &b.held, window, read),
        );
    }

    fn conv_grouped<N, Ci, Cg, Co, ..In, ..K, ..Out>(
        &mut self,
        x: &Handle<f32, [N, Ci, ..In]>,
        w: &Handle<f32, [Co, Cg, ..K]>,
        group: i32,
        window: &Window,
        then: Option<Epilogue<Handle<f32, [N, Co, ..Out]>>>,
    ) -> Handle<f32, [N, Co, ..Out]> {
        let read = opened(&mut self.cpu, &then);
        return handle(
            self.cpu.conv_grouped::<N, Ci, Cg, Co, [..In], [..K], [..Out]>(&x.held, &w.held, group, window, read),
        );
    }

    fn conv_grouped_bias<N, Ci, Cg, Co, ..In, ..K, ..Out>(
        &mut self,
        x: &Handle<f32, [N, Ci, ..In]>,
        w: &Handle<f32, [Co, Cg, ..K]>,
        b: &Handle<f32, [Co]>,
        group: i32,
        window: &Window,
        then: Option<Epilogue<Handle<f32, [N, Co, ..Out]>>>,
    ) -> Handle<f32, [N, Co, ..Out]> {
        let read = opened(&mut self.cpu, &then);
        return handle(
            self.cpu.conv_grouped_bias::<N, Ci, Cg, Co, [..In], [..K], [..Out]>(
                &x.held,
                &w.held,
                &b.held,
                group,
                window,
                read,
            ),
        );
    }

    fn softmax<Axes>(&mut self, t: &Handle<f32, Axes>, axis: i32) -> Handle<f32, Axes> {
        return handle(self.cpu.softmax(&t.held, axis));
    }

    fn softmax_flattened<Axes>(&mut self, t: &Handle<f32, Axes>, axis: i32) -> Handle<f32, Axes> {
        return handle(self.cpu.softmax_flattened(&t.held, axis));
    }

    fn reduce_sum<Axes>(&mut self, t: &Handle<f32, Axes>, axes: List<i32>) -> Handle<f32, Axes> {
        return handle(self.cpu.reduce_sum(&t.held, axes));
    }

    fn reduce_mean<Axes>(&mut self, t: &Handle<f32, Axes>, axes: List<i32>) -> Handle<f32, Axes> {
        return handle(self.cpu.reduce_mean(&t.held, axes));
    }
}
