//! ONNX's shape arithmetic over a length only the run knows, against Loam's.
//! Each model under `semantics/` is one case, and `semantics.mjs`, which wrote
//! it, wrote beside it what onnxruntime computes from it at each length of `X`.
//! Here the case builds as the generator would build it and runs under `eval`,
//! printing the same lines, so a refused build, a trap and a wrong answer each
//! show as a difference from them: once through `forward`, and once through
//! `compute`, which pads each length to a capacity past it. A case Loam does
//! not match yet is a `#[TODO]` test, so the run lists where the two part.

use { HashMap } from "core:collections";
use { Graph } from "lib:loam/src/graph.wado";
use { read } from "lib:loam/src/onnx_proto.wado";
use { TOLERANCE, generated, program_over, ran } from "./oracle.wado";

/// The lengths of `X` the oracle ran each case at.
global LENGTHS: List<i32> = [3, 10];

/// Each input a case reads, as the driver passes it at length `n`. The oracle
/// fills its own the same way.
global INPUTS: HashMap<String, String> = {
    X: "Tensor { data: iota(10.0, n), extents: [n] }",
    M: "Tensor { data: iota(0.0, 8), extents: [8] }",
    P: "Tensor { data: iota(0.0, 4 * n), extents: [n, 4] }",
    I: "Tensor { data: iota(0.0, 2 * n), extents: [1, 2, n] }",
    W: "Tensor { data: iota(0.0, 12), extents: [3, 2, 2] }",
} as HashMap<String, String>;

/// How a case's `run` calls the module at length `n`, given each input as an
/// argument: `forward` through the kernels, or `compute`, which pads every
/// length to its capacity, through the graph.
enum Entry {
    Forward,
    Compute,
}

impl Entry {
    fn call(&self, args: &String) -> String {
        return match *self {
            Forward => `let mut opaque = Opaque::new();
        let weights = Prepared::embedded(&mut opaque);
        let got = forward(&mut opaque, ${*args}&weights);`,
            Compute => `let mut cpu = Cpu {};
        let mut model = Model::new(Params::embedded(&mut cpu));
        let got = compute(&mut cpu, ${*args}&mut model);`,
        };
    }
}

/// What Loam computes from `model` through `entry` at each of `LENGTHS`, in
/// the oracle's lines, and past them why it computes nothing more: the build's
/// refusal, or how the run stopped.
fn loam(model: ByteList, entry: Entry) -> String {
    let graph = read(model).unwrap();
    return match generated(&graph) {
        Ok(source) => run(source, &graph, entry),
        Err(reason) => `refused: ${reason}`,
    };
}

/// `source` with a `run` that calls `entry` at each of `LENGTHS` and prints
/// what it returns, run under `eval`.
fn run(source: String, graph: &Graph, entry: Entry) -> String {
    let mut args = "";
    for let vi of graph.inputs {
        args.push_str(`&${INPUTS[vi.name]}, `);
    }
    let program = `${program_over(&source)}
fn iota(first: f32, count: i32) -> List<f32> {
    let mut values: List<f32> = [];
    for let i of 0..<count {
        values.push(first + i as f32);
    }
    return values;
}

fn joined<T: Display>(values: List<T>) -> String {
    let parts: List<String> = values.into_iter().map(|v| \`\${v}\`).collect();
    return parts.join(",");
}

export fn run() with Stdout {
    for let n of ${LENGTHS:?} as List<i32> {
        ${entry.call(&args)}
        println(\`N = \${n}: extents [\${joined(got.extents)}], data [\${joined(got.data)}]\`);
    }
}
`;
    return ran(program);
}

/// Loam computes from `model` what onnxruntime does, which `onnx` states,
/// through either entry.
fn assert_agrees(model: ByteList, onnx: String) {
    let [forward, compute] = [
        loam(model, Entry::Forward),
        loam(model, Entry::Compute),
    ];
    assert agrees(&forward, &onnx);
    assert agrees(&compute, &onnx);
}

/// Whether Loam's lines, `got`, say what the oracle's, `want`, do: each the
/// same but for its data, each element within `TOLERANCE` of the oracle's. The
/// oracle writes an f32 as the f64 that holds it, and Loam as the shortest
/// text that reads back as it.
fn agrees(got: &String, want: &String) -> bool {
    let [lines, wanted] = [
        got.split("\n").collect::<List<String>>(),
        want.split("\n").collect::<List<String>>(),
    ];
    if lines.len() != wanted.len() {
        return false;
    }
    for let [i, line] of lines.into_iter().enumerate() {
        if line == wanted[i] {
            continue;
        }
        let [Some([head, data]), Some([want_head, want_data])] = [
            data_of(&line),
            data_of(&wanted[i]),
        ] else {
            return false;
        };
        if head != want_head || data.len() != want_data.len() {
            return false;
        }
        for let [j, v] of data.into_iter().enumerate() {
            let w = want_data[j];
            if f64::abs(v - w) > TOLERANCE as f64 * f64::max(1.0, f64::abs(w)) {
                return false;
            }
        }
    }
    return true;
}

/// A line's text up to its data, and the data's elements.
fn data_of(line: &String) -> Option<[String, List<f64>]> {
    let marker = "data [";
    let at = line.find(marker)?;
    let head = line.substr_bytes(0, at);
    let inner = line.substr_bytes(at + marker.len(), line.len() - 1);
    let mut data: List<f64> = [];
    if inner.len() > 0 {
        for let element of inner.split(",") {
            let Ok(v) = f64::from_str(element) else {
                return null;
            };
            data.push(v);
        }
    }
    return Option::Some([head, data]);
}

test "Slice to N takes the first N, clamping to the axis's end" {
    assert_agrees(#include_bytes("./semantics/SliceToLength.onnx"), #include_str("./semantics/SliceToLength.txt"));
}

test "Slice from -N counts from the end, clamping to the start" {
    assert_agrees(
        #include_bytes("./semantics/SliceFromMinusLength.onnx"),
        #include_str("./semantics/SliceFromMinusLength.txt"),
    );
}

test "Slice from N + 8 is empty" {
    assert_agrees(#include_bytes("./semantics/SliceFromPastEnd.onnx"), #include_str("./semantics/SliceFromPastEnd.txt"));
}

test "Slice to N - 1 drops the last" {
    assert_agrees(#include_bytes("./semantics/SliceDropLast.onnx"), #include_str("./semantics/SliceDropLast.txt"));
}

test "Slice from -1 to N takes the last" {
    assert_agrees(#include_bytes("./semantics/SliceLast.onnx"), #include_str("./semantics/SliceLast.txt"));
}

test "Slice by -1 from N runs backwards" {
    assert_agrees(
        #include_bytes("./semantics/SliceBackFromLength.onnx"),
        #include_str("./semantics/SliceBackFromLength.txt"),
    );
}

test "Slice by -1 from N to past the start reaches element 0" {
    assert_agrees(#include_bytes("./semantics/SliceBackToFront.onnx"), #include_str("./semantics/SliceBackToFront.txt"));
}

test "Slice by 2 to N takes every other" {
    assert_agrees(
        #include_bytes("./semantics/SliceByTwoToLength.onnx"),
        #include_str("./semantics/SliceByTwoToLength.txt"),
    );
}

test "Slice by -1 from -1 over a symbolic axis reverses it" {
    assert_agrees(#include_bytes("./semantics/SliceReversed.onnx"), #include_str("./semantics/SliceReversed.txt"));
}

test "Range from 0 to N by 1 counts N" {
    assert_agrees(#include_bytes("./semantics/RangeToLength.onnx"), #include_str("./semantics/RangeToLength.txt"));
}

test "Range from 0 to N by 2 counts N / 2 rounded up" {
    assert_agrees(
        #include_bytes("./semantics/RangeByTwoToLength.onnx"),
        #include_str("./semantics/RangeByTwoToLength.txt"),
    );
}

test "Range from N to 0 by -1 counts down" {
    assert_agrees(
        #include_bytes("./semantics/RangeBackFromLength.onnx"),
        #include_str("./semantics/RangeBackFromLength.txt"),
    );
}

test "Range from N to 0 by -2 counts down by two" {
    assert_agrees(#include_bytes("./semantics/RangeBackByTwo.onnx"), #include_str("./semantics/RangeBackByTwo.txt"));
}

test "Range by N counts the steps of N that fit" {
    assert_agrees(#include_bytes("./semantics/RangeByLength.onnx"), #include_str("./semantics/RangeByLength.txt"));
}

test "Range back by -N counts the steps of N that fit" {
    assert_agrees(
        #include_bytes("./semantics/RangeBackByLength.onnx"),
        #include_str("./semantics/RangeBackByLength.txt"),
    );
}

test "MaxPool over N counts the windows that fit" {
    assert_agrees(
        #include_bytes("./semantics/MaxPoolOverLength.onnx"),
        #include_str("./semantics/MaxPoolOverLength.txt"),
    );
}

test "MaxPool with ceil_mode over N keeps a partial last window" {
    assert_agrees(
        #include_bytes("./semantics/MaxPoolCeilOverLength.onnx"),
        #include_str("./semantics/MaxPoolCeilOverLength.txt"),
    );
}

test "MaxPool with SAME_UPPER over N pads to cover every position" {
    assert_agrees(
        #include_bytes("./semantics/MaxPoolSameOverLength.onnx"),
        #include_str("./semantics/MaxPoolSameOverLength.txt"),
    );
}

test "Conv over N with padding and a stride" {
    assert_agrees(#include_bytes("./semantics/ConvOverLength.onnx"), #include_str("./semantics/ConvOverLength.txt"));
}

test "Split of N by sizes the graph computes from N" {
    assert_agrees(
        #include_bytes("./semantics/SplitTailOfLength.onnx"),
        #include_str("./semantics/SplitTailOfLength.txt"),
    );
}

test "ConstantOfShape of a shape holding N fills N rows" {
    assert_agrees(
        #include_bytes("./semantics/ConstantOfShapeOfLength.onnx"),
        #include_str("./semantics/ConstantOfShapeOfLength.txt"),
    );
}

test "Div of N by 2 rounds down" {
    assert_agrees(
        #include_bytes("./semantics/RangeToHalfLength.onnx"),
        #include_str("./semantics/RangeToHalfLength.txt"),
    );
}

test "Cast of a known int64 to int32 wraps" {
    assert_agrees(#include_bytes("./semantics/CastWraps.onnx"), #include_str("./semantics/CastWraps.txt"));
}

test "Cast of 3000000000 * N to int32 wraps, as onnxruntime computes it" {
    assert_agrees(#include_bytes("./semantics/CastWrapsLength.onnx"), #include_str("./semantics/CastWrapsLength.txt"));
}

test "Reshape to -1 flattens" {
    assert_agrees(#include_bytes("./semantics/ReshapeFlat.onnx"), #include_str("./semantics/ReshapeFlat.txt"));
}

test "Reshape reads 0 as the operand's extent and -1 as what remains" {
    assert_agrees(
        #include_bytes("./semantics/ReshapeKeepSplit.onnx"),
        #include_str("./semantics/ReshapeKeepSplit.txt"),
    );
}

test "ReduceSum over N sums the N rows" {
    assert_agrees(
        #include_bytes("./semantics/ReduceSumOverLength.onnx"),
        #include_str("./semantics/ReduceSumOverLength.txt"),
    );
}

test "ReduceMean over N divides by N" {
    assert_agrees(
        #include_bytes("./semantics/ReduceMeanOverLength.onnx"),
        #include_str("./semantics/ReduceMeanOverLength.txt"),
    );
}

test "Softmax over N normalizes the N elements" {
    assert_agrees(
        #include_bytes("./semantics/SoftmaxOverLength.onnx"),
        #include_str("./semantics/SoftmaxOverLength.txt"),
    );
}

test "MatMul contracting N sums N products" {
    assert_agrees(#include_bytes("./semantics/MatMulOverLength.onnx"), #include_str("./semantics/MatMulOverLength.txt"));
}

test "Concat along N puts the second part right after the first's N" {
    assert_agrees(
        #include_bytes("./semantics/ConcatAlongLength.onnx"),
        #include_str("./semantics/ConcatAlongLength.txt"),
    );
}

test "Gather of -1 along N takes the last of the N" {
    assert_agrees(#include_bytes("./semantics/GatherLast.onnx"), #include_str("./semantics/GatherLast.txt"));
}

test "Reshape reads a leading -1 as what the rest leaves" {
    assert_agrees(
        #include_bytes("./semantics/ReshapeRestFirst.onnx"),
        #include_str("./semantics/ReshapeRestFirst.txt"),
    );
}
