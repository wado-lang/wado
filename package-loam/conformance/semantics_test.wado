//! ONNX's shape arithmetic over a length only the run knows, against Loam's.
//! Each model under `semantics/` is one case, and what onnxruntime computes for
//! it at `N` = 3 and 10 is the expectation: `semantics.mjs` writes the models
//! and prints those numbers. A case Loam does not match yet is a `#[TODO]` test,
//! so the run lists where the two part.

use { TreeMap } from "core:collections";
use { infer } from "../src/infer.wado";
use { read } from "../src/onnx_proto.wado";
use { LayoutRule, Schema } from "../src/schema.wado";
use { bind_dims } from "../src/specialize.wado";
use slice_to_length from "./semantics/SliceToLength.onnx"
    with {
        generator: {
            module: "../src/generator.wado",
            options: {
                layout: [
                    {
                        pattern: "M",
                        axes: ["Pos"],
                    },
                    {
                        pattern: "X",
                        axes: ["Seq"],
                    },
                    {
                        pattern: "SliceToLength",
                        axes: ["Part"],
                    },
                ],
            },
        },
    };
use slice_from_minus_length from "./semantics/SliceFromMinusLength.onnx"
    with {
        generator: {
            module: "../src/generator.wado",
            options: {
                layout: [
                    {
                        pattern: "M",
                        axes: ["Pos"],
                    },
                    {
                        pattern: "X",
                        axes: ["Seq"],
                    },
                    {
                        pattern: "SliceFromMinusLength",
                        axes: ["Part"],
                    },
                ],
            },
        },
    };
use slice_from_past_end from "./semantics/SliceFromPastEnd.onnx"
    with {
        generator: {
            module: "../src/generator.wado",
            options: {
                layout: [
                    {
                        pattern: "M",
                        axes: ["Pos"],
                    },
                    {
                        pattern: "X",
                        axes: ["Seq"],
                    },
                    {
                        pattern: "SliceFromPastEnd",
                        axes: ["Part"],
                    },
                ],
            },
        },
    };
use slice_drop_last from "./semantics/SliceDropLast.onnx"
    with {
        generator: {
            module: "../src/generator.wado",
            options: {
                layout: [
                    {
                        pattern: "X",
                        axes: ["Seq"],
                    },
                    {
                        pattern: "SliceDropLast",
                        axes: ["Part"],
                    },
                ],
            },
        },
    };
use slice_last from "./semantics/SliceLast.onnx"
    with {
        generator: {
            module: "../src/generator.wado",
            options: {
                layout: [
                    {
                        pattern: "X",
                        axes: ["Seq"],
                    },
                    {
                        pattern: "SliceLast",
                        axes: ["Part"],
                    },
                ],
            },
        },
    };
use range_to_length from "./semantics/RangeToLength.onnx"
    with {
        generator: {
            module: "../src/generator.wado",
            options: {
                layout: [
                    {
                        pattern: "X",
                        axes: ["Seq"],
                    },
                    {
                        pattern: "RangeToLength",
                        axes: ["Part"],
                    },
                ],
            },
        },
    };
use cast_wraps from "./semantics/CastWraps.onnx"
    with {
        generator: {
            module: "../src/generator.wado",
            options: {
                layout: [
                    {
                        pattern: "CastWraps",
                        axes: ["Part"],
                    },
                ],
            },
        },
    };
use cast_wraps_length from "./semantics/CastWrapsLength.onnx"
    with {
        generator: {
            module: "../src/generator.wado",
            options: {
                layout: [
                    {
                        pattern: "X",
                        axes: ["Seq"],
                    },
                    {
                        pattern: "CastWrapsLength",
                        axes: ["Part"],
                    },
                ],
            },
        },
    };
use reshape_flat from "./semantics/ReshapeFlat.onnx"
    with {
        generator: {
            module: "../src/generator.wado",
            options: {
                layout: [
                    {
                        pattern: "P",
                        axes: ["Seq", "Wide"],
                    },
                ],
            },
        },
    };
use reshape_keep_split from "./semantics/ReshapeKeepSplit.onnx"
    with {
        generator: {
            module: "../src/generator.wado",
            options: {
                layout: [
                    {
                        pattern: "P",
                        axes: ["Seq", "Wide"],
                    },
                    {
                        pattern: "ReshapeKeepSplit",
                        axes: ["Seq", "Half", "Pair"],
                    },
                ],
            },
        },
    };
use reshape_rest_first from "./semantics/ReshapeRestFirst.onnx"
    with {
        generator: {
            module: "../src/generator.wado",
            options: {
                layout: [
                    {
                        pattern: "P",
                        axes: ["Seq", "Wide"],
                    },
                    {
                        pattern: "ReshapeRestFirst",
                        axes: ["Rows", "Pair"],
                    },
                ],
            },
        },
    };

/// The lengths of `X` the oracle ran each case at.
global LENGTHS: List<i32> = [3, 10];

/// `count` consecutive values from `first`, as the oracle fills its inputs.
fn iota(first: f32, count: i32) -> List<f32> {
    let mut values: List<f32> = [];
    for let i of 0..<count {
        values.push(first + i as f32);
    }
    return values;
}

/// `X`, of length `n`.
fn x_of(n: i32) -> List<f32> {
    return iota(10.0, n);
}

/// `M`, of the 8 elements a symbolic bound runs past.
fn m_of() -> List<f32> {
    return iota(0.0, 8);
}

/// `P`, of `n` rows of 4.
fn p_of(n: i32) -> List<f32> {
    return iota(0.0, 4 * n);
}

test "Slice to N within the axis takes the first N" {
    let got = slice_to_length::forward(
        &slice_to_length::Tensor {
            data: x_of(3),
            extents: [3],
        },
        &slice_to_length::Tensor {
            data: m_of(),
            extents: [8],
        },
        &slice_to_length::Weights {},
    );
    assert got.extents == [3];
    assert got.data == [0.0, 1.0, 2.0];
}

#[TODO]
test "Slice to N past the axis clamps to its end" {
    let got = slice_to_length::forward(
        &slice_to_length::Tensor {
            data: x_of(10),
            extents: [10],
        },
        &slice_to_length::Tensor {
            data: m_of(),
            extents: [8],
        },
        &slice_to_length::Weights {},
    );
    assert got.extents == [8];
    assert got.data == m_of();
}

#[TODO]
test "Slice from -N counts from the end" {
    let got = slice_from_minus_length::forward(
        &slice_from_minus_length::Tensor {
            data: x_of(3),
            extents: [3],
        },
        &slice_from_minus_length::Tensor {
            data: m_of(),
            extents: [8],
        },
        &slice_from_minus_length::Weights {},
    );
    assert got.extents == [3];
    assert got.data == [5.0, 6.0, 7.0];
}

#[TODO]
test "Slice from -N past the axis clamps to its start" {
    let got = slice_from_minus_length::forward(
        &slice_from_minus_length::Tensor {
            data: x_of(10),
            extents: [10],
        },
        &slice_from_minus_length::Tensor {
            data: m_of(),
            extents: [8],
        },
        &slice_from_minus_length::Weights {},
    );
    assert got.extents == [8];
    assert got.data == m_of();
}

test "Slice from N + 8 is empty" {
    for let n of LENGTHS {
        let got = slice_from_past_end::forward(
            &slice_from_past_end::Tensor {
                data: x_of(n),
                extents: [n],
            },
            &slice_from_past_end::Tensor {
                data: m_of(),
                extents: [8],
            },
            &slice_from_past_end::Weights {},
        );
        assert got.extents == [0];
        assert got.data.is_empty();
    }
}

test "Slice to N - 1 drops the last" {
    for let n of LENGTHS {
        let got = slice_drop_last::forward(
            &slice_drop_last::Tensor {
                data: x_of(n),
                extents: [n],
            },
            &slice_drop_last::Weights {},
        );
        assert got.extents == [n - 1];
        assert got.data == iota(10.0, n - 1);
    }
}

test "Slice from -1 to N takes the last" {
    for let n of LENGTHS {
        let got = slice_last::forward(
            &slice_last::Tensor {
                data: x_of(n),
                extents: [n],
            },
            &slice_last::Weights {},
        );
        assert got.extents == [1];
        assert got.data == [9.0 + n as f32];
    }
}

test "Range from 0 to N by 1 counts N" {
    for let n of LENGTHS {
        let got = range_to_length::forward(
            &range_to_length::Tensor {
                data: x_of(n),
                extents: [n],
            },
            &range_to_length::Weights {},
        );
        assert got.extents == [n];
        let want: List<i64> = (0..<n).map(|i| i as i64).collect();
        assert got.data == want;
    }
}

test "Cast of a known int64 to int32 wraps" {
    let got = cast_wraps::forward(&cast_wraps::Weights {});
    assert got.extents == [1];
    assert got.data == [-1294967296] as List<i64>;
}

#[TODO]
test "Cast of 3000000000 * N to int32 wraps, as onnxruntime computes it" {
    let three = cast_wraps_length::forward(
        &cast_wraps_length::Tensor {
            data: x_of(3),
            extents: [3],
        },
        &cast_wraps_length::Weights {},
    );
    assert three.data == [410065408] as List<i64>;
    let ten = cast_wraps_length::forward(
        &cast_wraps_length::Tensor {
            data: x_of(10),
            extents: [10],
        },
        &cast_wraps_length::Weights {},
    );
    assert ten.data == [-64771072] as List<i64>;
}

test "Reshape to -1 flattens" {
    for let n of LENGTHS {
        let got = reshape_flat::forward(
            &reshape_flat::Tensor {
                data: p_of(n),
                extents: [n, 4],
            },
            &reshape_flat::Weights {},
        );
        assert got.extents == [4 * n];
        assert got.data == p_of(n);
    }
}

test "Reshape reads 0 as the operand's extent and -1 as what remains" {
    for let n of LENGTHS {
        let got = reshape_keep_split::forward(
            &reshape_keep_split::Tensor {
                data: p_of(n),
                extents: [n, 4],
            },
            &reshape_keep_split::Weights {},
        );
        assert got.extents == [n, 2, 2];
        assert got.data == p_of(n);
    }
}

test "Reshape reads a leading -1 as what the rest leaves" {
    for let n of LENGTHS {
        let got = reshape_rest_first::forward(
            &reshape_rest_first::Tensor {
                data: p_of(n),
                extents: [n, 4],
            },
            &reshape_rest_first::Weights {},
        );
        assert got.extents == [2 * n, 2];
        assert got.data == p_of(n);
    }
}

/// The layout the imports above give a case whose one output is `output`.
fn schema(output: String) -> Schema {
    return Schema {
        layout: [
            LayoutRule {
                pattern: "M",
                axes: ["Pos"],
            },
            LayoutRule {
                pattern: "X",
                axes: ["Seq"],
            },
            LayoutRule {
                pattern: output,
                axes: ["Part"],
            },
        ],
    };
}

/// Stage 0 over the case `model` as the generator would build it: with `N`
/// left symbolic, and then fixed at each length the oracle ran, where its
/// output's extents must be what `want` lists for that length.
fn assert_builds(model: ByteList, want: List<List<i32>>) {
    let graph = read(model).unwrap();
    let output = graph.outputs[0].name;
    if let Err(e) = infer(&graph, &schema(output)) {
        panic(`${e}`);
    }
    for let [i, n] of LENGTHS.into_iter().enumerate() {
        let mut bound = graph;
        bind_dims(&mut bound, &({ N: n } as TreeMap<String, i32>)).unwrap();
        let checked = infer(&bound, &schema(output)).unwrap();
        assert checked.shapes[output].static_extents(&output).unwrap() == want[i];
    }
}

test "the build check passes a case Loam builds" {
    assert_builds(#include_bytes("./semantics/SliceDropLast.onnx"), [
        [2],
        [9],
    ]);
}

