//! ONNX's shape arithmetic over a length only the run knows, against Loam's.
//! Each model under `semantics/` is one case, and `semantics.mjs`, which wrote
//! it, wrote beside it what onnxruntime computes from it at each length of `X`.
//! Here the case builds as the generator would build it and runs under `eval`,
//! printing the same lines, so a refused build, a trap and a wrong answer each
//! show as a difference from them. A case Loam does not match yet is a
//! `#[TODO]` test, so the run lists where the two part.

use { TreeMap } from "core:collections";
use { eval } from "core:eval";
use { emit } from "../src/emit.wado";
use { Graph } from "../src/graph.wado";
use { infer } from "../src/infer.wado";
use { read } from "../src/onnx_proto.wado";
use { LayoutRule, Schema } from "../src/schema.wado";

/// The lengths of `X` the oracle ran each case at.
global LENGTHS: List<i32> = [3, 10];

/// Each input a case reads, as the driver passes it at length `n`. The oracle
/// fills its own the same way.
global INPUTS: TreeMap<String, String> = {
    X: "Tensor { data: iota(10.0, n), extents: [n] }",
    M: "Tensor { data: iota(0.0, 8), extents: [8] }",
    P: "Tensor { data: iota(0.0, 4 * n), extents: [n, 4] }",
} as TreeMap<String, String>;

/// What Loam computes from `model` at each of `lengths`, in the oracle's
/// lines, and past them why it computes nothing more: the build's refusal, or
/// how the run stopped.
fn loam(model: ByteList, output_axes: List<String>, lengths: List<i32>) -> String {
    let graph = read(model).unwrap();
    return match built(&graph, output_axes) {
        Ok(source) => run(source, &graph, lengths),
        Err(reason) => `refused: ${reason}`,
    };
}

/// The module the generator writes for `graph`, whose one output's axes are
/// `output_axes`.
fn built(graph: &Graph, output_axes: List<String>) -> Result<String, String> {
    assert graph.outputs.len() == 1;
    let output = graph.outputs[0].name;
    let schema = Schema {
        layout: [
            LayoutRule {
                pattern: "X",
                axes: ["Seq"],
            },
            LayoutRule {
                pattern: "M",
                axes: ["Pos"],
            },
            LayoutRule {
                pattern: "P",
                axes: ["Seq", "Wide"],
            },
            LayoutRule { pattern: output, axes: output_axes },
        ],
    };
    let checked = infer(graph, &schema).map_err(|e| `${e}`)?;
    return emit(graph, &checked).map_err(|e| `${e}`);
}

/// `source` with a `run` that calls its `forward` at each of `lengths` and
/// prints what it returns, run under `eval`.
fn run(source: String, graph: &Graph, lengths: List<i32>) -> String {
    let mut args = "";
    for let vi of graph.inputs {
        args.push_str(`&${INPUTS[vi.name]}, `);
    }
    let program = `${source}
use { println, Stdout } from "core:cli";

fn iota(first: f32, count: i32) -> List<f32> {
    let mut values: List<f32> = [];
    for let i of 0..<count {
        values.push(first + i as f32);
    }
    return values;
}

fn joined<T: Display>(values: List<T>) -> String {
    let parts: List<String> = values.into_iter().map(|v| \`\${v}\`).collect();
    return parts.join(",");
}

export fn run() with Stdout {
    for let n of ${lengths:?} as List<i32> {
        let got = forward(${args}&Weights {});
        println(\`N = \${n}: extents [\${joined(got.extents)}], data [\${joined(got.data)}]\`);
    }
}
`;
    return match eval(program) {
        Ok(out) => {
            if out.status matches { Exited(0) } {
                out.stdout;
            } else {
                `${out.stdout}${out.status:?}: ${out.stderr}`;
            }
        },
        Err(e) => `${e:?}`,
    };
}

/// The lines of the oracle's `onnx` for `lengths`.
fn at(onnx: String, lengths: List<i32>) -> String {
    let mut kept = "";
    for let line of onnx.lines() {
        for let n of lengths {
            if line.starts_with(`N = ${n}:`) {
                kept.push_str(`${line}\n`);
            }
        }
    }
    return kept;
}

/// Loam computes from `model` what onnxruntime does, which `onnx` states.
fn assert_agrees(model: ByteList, onnx: String, output_axes: List<String> = ["Part"], lengths: List<i32> = LENGTHS) {
    let got = loam(model, output_axes, lengths);
    let want = at(onnx, lengths);
    assert got == want;
}

test "Slice to N within the axis takes the first N" {
    assert_agrees(#include_bytes("./semantics/SliceToLength.onnx"), #include_str("./semantics/SliceToLength.txt"), [
        "Part",
    ], [3]);
}

#[TODO]
test "Slice to N past the axis clamps to its end" {
    assert_agrees(#include_bytes("./semantics/SliceToLength.onnx"), #include_str("./semantics/SliceToLength.txt"), [
        "Part",
    ], [10]);
}

#[TODO]
test "Slice from -N counts from the end, clamping to the start" {
    assert_agrees(
        #include_bytes("./semantics/SliceFromMinusLength.onnx"),
        #include_str("./semantics/SliceFromMinusLength.txt"),
    );
}

test "Slice from N + 8 is empty" {
    assert_agrees(#include_bytes("./semantics/SliceFromPastEnd.onnx"), #include_str("./semantics/SliceFromPastEnd.txt"));
}

test "Slice to N - 1 drops the last" {
    assert_agrees(#include_bytes("./semantics/SliceDropLast.onnx"), #include_str("./semantics/SliceDropLast.txt"));
}

test "Slice from -1 to N takes the last" {
    assert_agrees(#include_bytes("./semantics/SliceLast.onnx"), #include_str("./semantics/SliceLast.txt"));
}

#[TODO]
test "Slice by -1 from N runs backwards" {
    assert_agrees(
        #include_bytes("./semantics/SliceBackFromLength.onnx"),
        #include_str("./semantics/SliceBackFromLength.txt"),
    );
}

#[TODO]
test "Slice by -1 from N to past the start reaches element 0" {
