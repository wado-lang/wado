# Each input's length spells arithmetic over a name no input carries alone,
# so `forward` reads the name back out of the length.
<ir_version: 8, opset_import: [ "" : 13 ]>
spelled (float["n + 1"] X, float["2 * m + 1"] V) => (float["n + 1"] Y, float["2 * m + 1"] Z)
{
    Y = Relu(X)
    Z = Neg(V)
}
