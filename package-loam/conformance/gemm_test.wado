//! `pytorch-operator/test_operator_addmm`: two `Gemm` nodes whose bias
//! broadcasts across the batch axis, checked against the output ONNX ships.

use { Cpu, Tensor } from "lib:loam";
use { assert_close, tensor_of } from "./oracle.wado";
use { Axis00, Axis01, Axis11, Weights, forward } from "../tests/onnx/pytorch-operator/test_operator_addmm/model.onnx"
    with {
        type: "onnx",
        generator: { module: "lib:loam" },
    };

test "Gemm reproduces the output ONNX ships" {
    let [a, a_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_addmm/test_data_set_0/input_0.pb"),
    );
    let [b, b_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_addmm/test_data_set_0/input_1.pb"),
    );
    let [c, c_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_addmm/test_data_set_0/input_2.pb"),
    );
    let [want, want_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_addmm/test_data_set_0/output_0.pb"),
    );

    let got = forward(
        &mut Cpu {},
        &Tensor::<f32, [Axis00, Axis01]> { data: a, extents: a_extents },
        &Tensor::<f32, [Axis01, Axis11]> { data: b, extents: b_extents },
        &Tensor::<f32, [Axis11]> { data: c, extents: c_extents },
        &Weights {}.prepare(&mut Cpu {}),
    );

    assert got.extents == want_extents;
    assert_close(&got.data, &want);
}
