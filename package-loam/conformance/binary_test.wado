//! `pytorch-operator/test_operator_pow`: one binary operator over
//! `float[1, 2, 3, 4]`, checked against the output ONNX ships.

use { Cpu, Tensor } from "lib:loam";
use { assert_close, tensor_of } from "./oracle.wado";
use {
    Axis00,
    Axis01,
    Axis02,
    Axis03,
    Weights,
    forward,
} from "../tests/onnx/pytorch-operator/test_operator_pow/model.onnx"
    with {
        type: "onnx",
        generator: { module: "lib:loam" },
    };

test "Pow reproduces the output ONNX ships" {
    let [x, x_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_pow/test_data_set_0/input_0.pb"),
    );
    let [y, y_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_pow/test_data_set_0/input_1.pb"),
    );
    let [want, want_extents] = tensor_of(
        #include_bytes("../tests/onnx/pytorch-operator/test_operator_pow/test_data_set_0/output_0.pb"),
    );

    let got = forward(
        &mut Cpu {},
        &Tensor::<f32, [Axis00, Axis01, Axis02, Axis03]> { data: x, extents: x_extents },
        &Tensor::<f32, [Axis00, Axis01, Axis02, Axis03]> { data: y, extents: y_extents },
        &Weights {}.prepare(&mut Cpu {}),
    );

    assert got.extents == want_extents;
    assert_close(&got.data, &want);
}
