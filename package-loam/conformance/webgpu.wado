//! The WebGPU backend computes what `Cpu` computes. `forward` runs once on
//! each, and this prints how far apart their outputs are. `wado test` cannot
//! reach a device, so `wado-run-webgpu`'s tests run it:
//!
//!     wado run-webgpu package-loam/conformance/webgpu.wado

use { println, Stdout } from "core:cli";
use {
    Webgpu,
    Gpu,
    GpuAdapter,
    GpuDevice,
    GpuQueue,
    GpuCommandEncoder,
    GpuCommandBuffer,
    GpuBuffer,
    GpuBindGroupLayout,
    GpuBindGroup,
    GpuShaderModule,
    GpuComputePipeline,
    GpuComputePassEncoder,
    GpuSupportedLimits,
    RecordOptionGpuSize64,
} from "wasi:webgpu";
use {
    Backend,
    BinaryOp,
    Columns,
    Concat,
    Cpu,
    Epilogue,
    Expr,
    Prologue,
    Tensor,
    UnaryOp,
    WebGpuBackend,
    constant,
    element_count,
    operand,
} from "lib:loam";
use { deviation, noise } from "lib:loam/example/webgpu/compare.wado";
use { Pick, Picked, Weights, forward } from "./webgpu.onnxtext"
    with {
        type: "onnxtext",
        generator: {
            module: "lib:loam",
            options: {
                layout: [
                    {
                        pattern: "X",
                        axes: ["Batch", "Row", "Inner"],
                    },
                    {
                        pattern: "Y",
                        axes: ["Batch", "Inner", "Col"],
                    },
                    {
                        pattern: "W",
                        axes: ["Inner", "Col"],
                    },
                    {
                        pattern: "C",
                        axes: ["Col"],
                    },
                    {
                        pattern: "W?",
                        axes: ["Col"],
                    },
                    {
                        pattern: "K",
                        axes: ["Col"],
                    },
                    {
                        pattern: "V",
                        axes: ["Long"],
                    },
                    {
                        pattern: "Z",
                        axes: ["Batch", "Row", "Col"],
                    },
                    {
                        pattern: "S",
                        axes: ["Batch", "Col", "Row"],
                    },
                    {
                        pattern: "R",
                        axes: ["Long"],
                    },
                    {
                        pattern: "O",
                        axes: ["Batch", "Row", "Col"],
                    },
                    {
                        pattern: "N",
                        axes: ["Vacant"],
                    },
                    {
                        pattern: "G",
                        axes: ["Vacant"],
                    },
                    {
                        pattern: "BX",
                        axes: ["Many", "Single", "Pair"],
                    },
                    {
                        pattern: "BY",
                        axes: ["Many", "Pair", "Single"],
                    },
                    {
                        pattern: "BW",
                        axes: ["Pair", "Single"],
                    },
                    {
                        pattern: "B?",
                        axes: ["Many", "Single", "Single"],
                    },
                    {
                        pattern: "Ix",
                        axes: ["Pick"],
                    },
                    {
                        pattern: "E",
                        axes: ["Pick", "Col"],
                    },
                    {
                        pattern: "DX",
                        axes: ["Two", "Deep"],
                    },
                    {
                        pattern: "DW",
                        axes: ["Deep", "Three"],
                    },
                    {
                        pattern: "DB",
                        axes: ["Three"],
                    },
                    {
                        pattern: "F",
                        axes: ["Two", "Three"],
                    },
                    {
                        pattern: "TW",
                        axes: ["Col", "Inner"],
                    },
                    {
                        pattern: "N?",
                        axes: ["Vacant", "Three"],
                    },
                    {
                        pattern: "Iy",
                        axes: ["Picked"],
                    },
                    {
                        pattern: "GA",
                        axes: ["Deep", "Picked"],
                    },
                ],
            },
        },
    };

/// More elements than one row of workgroups holds, 65535 of 64 each.
global LONG: i32 = 4_200_000;

/// More batch elements than one dispatch dimension holds, 65535.
global MANY: i32 = 70_000;

/// A binding smaller than `W` and `DW` but not `DX`, so the second pass splits
/// a gather by its indices, a copy in halves, and a product along its inner
/// axis.
global SPLIT: i32 = 640;

fn tensor<Axes>(extents: List<i32>, seed: u32) -> Tensor<f32, Axes> {
    return Tensor { data: noise(element_count(&extents), seed, 1.0), extents };
}

export fn run() with (Stdout, Webgpu, Gpu, GpuAdapter, GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder, GpuSupportedLimits, RecordOptionGpuSize64) {
    // Extents no tile divides, so every product reaches a tile's edge.
    let x = tensor([3, 37, 50], 1);
    let y = tensor([3, 50, 29], 2);
    let v = tensor([LONG], 3);
    let n = tensor([0], 6);
    let bx = tensor([MANY, 1, 2], 7);
    let by = tensor([MANY, 2, 1], 8);
    let w = Weights {
        W: tensor([50, 29], 4),
        C: tensor([29], 5),
        BW: tensor([2, 1], 9),
        W1: tensor([29], 10),
        W2: tensor([29], 11),
        W3: tensor([29], 12),
        W4: tensor([29], 13),
        W5: tensor([29], 14),
        W6: tensor([29], 15),
        DW: tensor([300, 3], 16),
        DB: tensor([3], 17),
    };
    let ix: Tensor<i64, [Pick]> = {
        data: [49, 0, -1, 7, 25, 3],
        extents: [6],
    };
    let dx = tensor([2, 300], 18);
    let ne = tensor([0, 3], 19);
    let iy: Tensor<i64, [Picked]> = {
        data: [2, 0],
        extents: [2],
    };
    let on_cpu = forward(&mut Cpu {}, &x, &y, &v, &n, &bx, &by, &ix, &dx, &ne, &iy, &w.prepare(&mut Cpu {}));
    for let limit of [null, Option::Some(SPLIT)] as List<Option<i32>> {
        let Some(mut gpu) = WebGpuBackend::new() else {
            println("no WebGPU adapter");
            return;
        };
        let mut pass = "";
        if let Some(elements) = limit {
            gpu.limit_binding(elements);
            pass = "split ";
        }
        let on_gpu = forward(&mut gpu, &x, &y, &v, &n, &bx, &by, &ix, &dx, &ne, &iy, &w.prepare(&mut gpu));
        println(`${pass}Z ${on_gpu.Z.extents:?} ${deviation(&on_gpu.Z.data, &on_cpu.Z.data)}`);
        println(`${pass}S ${on_gpu.S.extents:?} ${deviation(&on_gpu.S.data, &on_cpu.S.data)}`);
        println(`${pass}R ${on_gpu.R.extents:?} ${deviation(&on_gpu.R.data, &on_cpu.R.data)}`);
        println(`${pass}O ${on_gpu.O.extents:?} ${deviation(&on_gpu.O.data, &on_cpu.O.data)}`);
        println(`${pass}G ${on_gpu.G.extents:?} ${deviation(&on_gpu.G.data, &on_cpu.G.data)}`);
        println(`${pass}BZ ${on_gpu.BZ.extents:?} ${deviation(&on_gpu.BZ.data, &on_cpu.BZ.data)}`);
        println(`${pass}BS ${on_gpu.BS.extents:?} ${deviation(&on_gpu.BS.data, &on_cpu.BS.data)}`);
        println(`${pass}K ${on_gpu.K.extents:?} ${deviation(&on_gpu.K.data, &on_cpu.K.data)}`);
        println(`${pass}E ${on_gpu.E.extents:?} ${deviation(&on_gpu.E.data, &on_cpu.E.data)}`);
        println(`${pass}F ${on_gpu.F.extents:?} ${deviation(&on_gpu.F.data, &on_cpu.F.data)}`);
        println(`${pass}TW ${on_gpu.TW.extents:?} ${deviation(&on_gpu.TW.data, &on_cpu.TW.data)}`);
        println(`${pass}NS ${on_gpu.NS.extents:?} ${deviation(&on_gpu.NS.data, &on_cpu.NS.data)}`);
        println(`${pass}GA ${on_gpu.GA.extents:?} ${deviation(&on_gpu.GA.data, &on_cpu.GA.data)}`);
    }
    arg_maxes();
    narrow_products();
    narrow_column_counts();
    half_weights();
    paired_products();
    prologue_products();
    concatenated_products();
}

/// A row of 640 over its root mean square, scaled by `operand(1)`, as a
/// decoder normalizes a layer's input.
fn rms_norm() -> Expr {
    let x = operand(0);
    let rms = x.binary(BinaryOp::Mul, &x).row_sum(Option::Some(640.0)).binary(BinaryOp::Add, &constant(0.000001)).unary(
        UnaryOp::Sqrt,
    );
    return x.binary(BinaryOp::Div, &rms).binary(BinaryOp::Mul, &operand(1));
}

/// Two products of an RMS normalization by weights of 256 and 128 columns,
/// concatenated, for a step's one row, a few rows of a batch and a tile of
/// rows, each part read as a view by a row kernel normalizing it.
fn concatenated_products() with (Stdout, Webgpu, Gpu, GpuAdapter, GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder, GpuSupportedLimits, RecordOptionGpuSize64) {
    let Some(mut gpu) = WebGpuBackend::new() else {
        return;
    };
    let norm = rms_norm();
    let x = operand(0);
    let scaled = x.binary(BinaryOp::Div, &x.binary(BinaryOp::Mul, &x).row_sum(null).unary(UnaryOp::Sqrt));
    let scale = tensor::<[Long]>([640], 48);
    let b = halved(tensor::<[Long, Col]>([640, 256], 49));
    let c = halved(tensor::<[Long, Inner]>([640, 128], 50));
    let bc = Columns::of(&b).then(&c).joined();
    for let [name, a] of [
        ["step", tensor::<[Row, Inner, Long]>([1, 1, 640], 51)],
        ["few", tensor::<[Row, Inner, Long]>([2, 3, 640], 52)],
        ["tile", tensor::<[Row, Inner, Long]>([1, 20, 640], 53)],
    ] as List<[String, Tensor<f32, [Row, Inner, Long]>]> {
        let mut cpu = Cpu {};
        let cpu_a = Prologue {
            operands: [
                cpu.read(&a),
                cpu.read_suffix::<[Row, Inner], [Long]>(&scale),
            ],
            op: norm,
        };
        let cpu_whole = cpu.matmul_rhs_from(cpu_a, &cpu.keep_rhs(&bc), null);
        let cpu_first = cpu.slice_axis::<f32, [Row, Inner], Concat<Col, Inner>, Col, []>(&cpu_whole, 2, 0, 256, 1);
        let cpu_second = cpu.slice_axis::<f32, [Row, Inner], Concat<Col, Inner>, Inner, []>(&cpu_whole, 2, 256, 128, 1);
        let first_cpu = cpu.rows::<[Row, Inner, Col], [Row, Inner, Col]>([cpu.read(&cpu_first)], &scaled, 1, false);
        let second_cpu = cpu.rows::<[Row, Inner, Inner], [Row, Inner, Inner]>(
            [cpu.read(&cpu_second)],
            &scaled,
            1,
            false,
        );
        let uploaded = gpu.upload(&a);
        let kept = gpu.keep(&scale);
        let gpu_a = Prologue {
            operands: [
                gpu.read(&uploaded),
                gpu.read_suffix::<[Row, Inner], [Long]>(&kept),
            ],
            op: norm,
        };
        let whole = gpu.matmul_rhs_from(gpu_a, &gpu.keep_rhs(&bc), null);
        let first = gpu.slice_axis::<f32, [Row, Inner], Concat<Col, Inner>, Col, []>(&whole, 2, 0, 256, 1);
        let second = gpu.slice_axis::<f32, [Row, Inner], Concat<Col, Inner>, Inner, []>(&whole, 2, 256, 128, 1);
        let first_gpu = gpu.rows::<[Row, Inner, Col], [Row, Inner, Col]>([gpu.read(&first)], &scaled, 1, false);
        let second_gpu = gpu.rows::<[Row, Inner, Inner], [Row, Inner, Inner]>([gpu.read(&second)], &scaled, 1, false);
        println(`concatenated first ${name} ${deviation(&gpu.download(&first_gpu).data, &first_cpu.data)}`);
        println(`concatenated second ${name} ${deviation(&gpu.download(&second_gpu).data, &second_cpu.data)}`);
    }
}

/// Products of an RMS normalization each workgroup computes itself, as a
/// step's one row and a few rows of a batch make them, paired and alone, and
/// for a tile of rows, which the device normalizes in a kernel of its own.
fn prologue_products() with (Stdout, Webgpu, Gpu, GpuAdapter, GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder, GpuSupportedLimits, RecordOptionGpuSize64) {
    let Some(mut gpu) = WebGpuBackend::new() else {
        return;
    };
    let norm = rms_norm();
    let scale = tensor::<[Long]>([640], 42);
    let b = halved(tensor::<[Long, Col]>([640, 256], 43));
    let c = halved(tensor::<[Long, Col]>([640, 256], 44));
    // silu(operand(0)) * operand(1)
    let gated = operand(0).binary(BinaryOp::Mul, &operand(0).unary(UnaryOp::Sigmoid)).binary(BinaryOp::Mul, &operand(1));
    let cases = [
        ["step", tensor::<[Row, Inner, Long]>([1, 1, 640], 45)],
        ["few", tensor::<[Row, Inner, Long]>([2, 3, 640], 46)],
        ["tile", tensor::<[Row, Inner, Long]>([1, 20, 640], 47)],
    ] as List<[String, Tensor<f32, [Row, Inner, Long]>]>;
    for let [name, a] of cases {
        let mut cpu = Cpu {};
        let cpu_a = Prologue {
            operands: [
                cpu.read(&a),
                cpu.read_suffix::<[Row, Inner], [Long]>(&scale),
            ],
            op: norm,
        };
        let on_cpu = cpu.matmul_rhs_paired_from(cpu_a, &cpu.keep_rhs_paired(&b, &c), Epilogue {
            operands: [],
            op: gated,
        });
        let alone_cpu = cpu.matmul_rhs_from(cpu_a, &cpu.keep_rhs(&b), null);
        let uploaded = gpu.upload(&a);
        let kept = gpu.keep(&scale);
        let gpu_a = Prologue {
            operands: [
                gpu.read(&uploaded),
                gpu.read_suffix::<[Row, Inner], [Long]>(&kept),
            ],
            op: norm,
        };
        let on_gpu = gpu.matmul_rhs_paired_from(gpu_a, &gpu.keep_rhs_paired(&b, &c), Epilogue {
            operands: [],
            op: gated,
        });
        println(`prologue paired ${name} ${deviation(&gpu.download(&on_gpu).data, &on_cpu.data)}`);
        let alone_gpu = gpu.matmul_rhs_from(gpu_a, &gpu.keep_rhs(&b), null);
        println(`prologue ${name} ${deviation(&gpu.download(&alone_gpu).data, &alone_cpu.data)}`);
    }
}

/// A gated layer's two products of one input, joined with a third operand, as
/// a step's one row and a prompt's tile of rows make them: in one dispatch
/// where the right matrices are bf16 or f32, and in two kernels for the tile.
fn paired_products() with (Stdout, Webgpu, Gpu, GpuAdapter, GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder, GpuSupportedLimits, RecordOptionGpuSize64) {
    let Some(mut gpu) = WebGpuBackend::new() else {
        return;
    };
    let one = tensor::<[Row, Inner, Long]>([1, 1, 640], 35);
    let tile = tensor::<[Row, Inner, Long]>([1, 20, 640], 36);
    // silu(operand(0)) * operand(1) + operand(2)
    let op = operand(0).binary(BinaryOp::Mul, &operand(0).unary(UnaryOp::Sigmoid)).binary(BinaryOp::Mul, &operand(1)).binary(
        BinaryOp::Add,
        &operand(2),
    );
    let exact = [
        halved(tensor::<[Long, Col]>([640, 256], 37)),
        halved(tensor::<[Long, Col]>([640, 256], 38)),
    ];
    let inexact = [
        tensor::<[Long, Col]>([640, 256], 39),
        tensor::<[Long, Col]>([640, 256], 40),
    ];
    let cases = [
        ["step", one, exact],
        ["f32", one, inexact],
        ["tile", tile, exact],
    ] as List<[String, Tensor<f32, [Row, Inner, Long]>, [Tensor<f32, [Long, Col]>, Tensor<f32, [Long, Col]>]]>;
    for let [name, a, [b, c]] of cases {
        let rows = a.extents[1];
        let bias = tensor::<[Row, Inner, Col]>([1, rows, 256], 41);
        let mut cpu = Cpu {};
        let on_cpu = cpu.matmul_rhs_paired(&a, &cpu.keep_rhs_paired(&b, &c), Epilogue {
            operands: [cpu.read(&bias)],
            op,
        });
        let bc = gpu.keep_rhs_paired(&b, &c);
        let on_gpu = gpu.matmul_rhs_paired(&gpu.upload(&a), &bc, Epilogue {
            operands: [gpu.read(&gpu.upload(&bias))],
            op,
        });
        println(`paired ${name} ${deviation(&gpu.download(&on_gpu).data, &on_cpu.data)}`);
    }
}

/// `t` with each element's low 16 bits cleared, so bf16 holds it exactly.
fn halved<Axes>(t: Tensor<f32, Axes>) -> Tensor<f32, Axes> {
    let mut data = List::<f32>::with_capacity(t.data.len());
    for let v of t.data {
        data.push(f32::from_bits(v.to_bits() & 0xFFFF_0000));
    }
    return Tensor { data, extents: t.extents };
}

/// Products and a gather by a weight kept for products alone, which the device
/// holds in bf16 where that loses nothing, and one it must keep in f32: read
/// along either axis, by a few rows, a prompt's and a tile's, whole and in
/// chunks.
fn half_weights() with (Stdout, Webgpu, Gpu, GpuAdapter, GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder, GpuSupportedLimits, RecordOptionGpuSize64) {
    let exact = halved(tensor::<[Long, Col]>([700, 300], 26));
    let inexact = tensor::<[Long, Col]>([700, 300], 27);
    let few = tensor::<[Row, Inner, Long]>([2, 3, 700], 28);
    let prompt = tensor::<[Row, Inner, Long]>([2, 6, 700], 32);
    let tile = tensor::<[Row, Inner, Long]>([1, 20, 700], 29);
    let one = tensor::<[Row, Inner, Col]>([2, 1, 300], 30);
    let ix: Tensor<i64, [Pick]> = {
        data: [699, 0, -1, 3, 350, 2],
        extents: [6],
    };
    let mut cpu = Cpu {};
    let expected = [
        cpu.matmul_shared(&few, &exact, null).data,
        cpu.matmul_shared(&prompt, &exact, null).data,
        cpu.matmul_shared(&tile, &exact, null).data,
        cpu.matmul_by_transposed(&one, &exact, null).data,
        cpu.gather_rows::<f32, Long, [Col], [Pick]>(&exact, &ix).data,
        cpu.matmul_shared(&few, &inexact, null).data,
    ] as List<List<f32>>;
    for let limit of [null, Option::Some(HALF_SPLIT)] as List<Option<i32>> {
        let Some(mut gpu) = WebGpuBackend::new() else {
            return;
        };
        let mut pass = "";
        if let Some(words) = limit {
            gpu.limit_binding(words);
            pass = "split ";
        }
        let b = gpu.keep_rhs(&exact);
        let f = gpu.keep_rhs(&inexact);
        // A word for each pair of `exact`'s 210_000 elements, and for each of
        // `inexact`'s.
        assert gpu.kept_bytes() == (105_000 + 210_000) * 4;
        let few_by_b = gpu.matmul_rhs(&gpu.upload(&few), &b, null);
        let prompt_by_b = gpu.matmul_rhs(&gpu.upload(&prompt), &b, null);
        let tile_by_b = gpu.matmul_rhs(&gpu.upload(&tile), &b, null);
        let across = gpu.matmul_by_rhs_transposed(&gpu.upload(&one), &b, null);
        let gathered = gpu.gather_rhs_rows(&b, &gpu.upload(&ix));
        let few_by_f = gpu.matmul_rhs(&gpu.upload(&few), &f, null);
        // Only the product across the rows leaves the device, reading back
        // the weight and its left operand, and only under the split.
        assert gpu.read_backs() == if limit matches { Some(_) } { 2 } else { 0 };
        let got = [
            gpu.download(&few_by_b).data,
            gpu.download(&prompt_by_b).data,
            gpu.download(&tile_by_b).data,
            gpu.download(&across).data,
            gpu.download(&gathered).data,
            gpu.download(&few_by_f).data,
        ] as List<List<f32>>;
        let names = ["few", "prompt", "tile", "across", "gather", "f32"] as List<String>;
        for let i of 0..<got.len() {
            println(`${pass}half ${names[i]} ${deviation(&got[i], &expected[i])}`);
        }
    }
}

/// A binding that holds 266 of the 700 rows of `half_weights`' weight in bf16,
/// so the weight is kept row by row, its products along the rows run in
/// chunks, its product across them on the CPU, and its gather in parts.
global HALF_SPLIT: i32 = 40_000;

/// Products of one row across a transposed weight of few columns and of many,
/// whose workgroups each take a different count of them, in bf16 as a model's
/// weights are.
fn narrow_column_counts() with (Stdout, Webgpu, Gpu, GpuAdapter, GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder, GpuSupportedLimits, RecordOptionGpuSize64) {
    let Some(mut gpu) = WebGpuBackend::new() else {
        return;
    };
    let one = tensor::<[Row, Inner, Col]>([1, 1, 640], 33);
    for let columns of [256, 2048] as List<i32> {
        let stored = halved(tensor::<[Long, Col]>([columns, 640], 34));
        let on_cpu = Cpu {}.matmul_by_transposed(&one, &stored, null);
        let across = gpu.matmul_by_rhs_transposed(&gpu.upload(&one), &gpu.keep_rhs(&stored), null);
        println(`narrow columns ${columns} ${deviation(&gpu.download(&across).data, &on_cpu.data)}`);
    }
}

/// Products of a few rows, as a model's step over one token makes, and of a
/// short prompt's, in more than one block of rows, by a matrix read along
/// either axis, whole and in chunks of its inner axis.
fn narrow_products() with (Stdout, Webgpu, Gpu, GpuAdapter, GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder, GpuSupportedLimits, RecordOptionGpuSize64) {
    let one = tensor::<[Row, Inner, Col]>([2, 1, 300], 22);
    let three = tensor::<[Row, Inner, Col]>([2, 3, 300], 23);
    let prompt = tensor::<[Row, Inner, Col]>([2, 6, 300], 31);
    let stored = tensor::<[Long, Col]>([700, 300], 24);
    let on_cpu = Cpu {}.matmul_by_transposed(&one, &stored, null);
    let prompt_on_cpu = Cpu {}.matmul_by_transposed(&prompt, &stored, null);
    let wide = tensor::<[Col, Long]>([300, 700], 25);
    let shared_on_cpu = Cpu {}.matmul_shared(&three, &wide, null);
    let prompt_shared_on_cpu = Cpu {}.matmul_shared(&prompt, &wide, null);
    for let limit of [null, Option::Some(NARROW_SPLIT)] as List<Option<i32>> {
        let Some(mut gpu) = WebGpuBackend::new() else {
            return;
        };
        let mut pass = "";
        if let Some(elements) = limit {
            gpu.limit_binding(elements);
            pass = "split ";
        }
        let b = gpu.keep(&stored);
        let w = gpu.keep(&wide);
        let across = gpu.matmul_by_transposed(&gpu.upload(&one), &b, null);
        let along = gpu.matmul_shared(&gpu.upload(&three), &w, null);
        let prompt_across = gpu.matmul_by_transposed(&gpu.upload(&prompt), &b, null);
        let prompt_along = gpu.matmul_shared(&gpu.upload(&prompt), &w, null);
        let [across, along, prompt_across, prompt_along] = [
            gpu.download(&across),
            gpu.download(&along),
            gpu.download(&prompt_across),
            gpu.download(&prompt_along),
        ];
        println(`${pass}narrow across ${across.extents:?} ${deviation(&across.data, &on_cpu.data)}`);
        println(`${pass}narrow along ${along.extents:?} ${deviation(&along.data, &shared_on_cpu.data)}`);
        println(
            `${pass}narrow prompt across ${prompt_across.extents:?} ${deviation(
                &prompt_across.data,
                &prompt_on_cpu.data,
            )}`,
        );
        println(
            `${pass}narrow prompt along ${prompt_along.extents:?} ${deviation(
                &prompt_along.data,
                &prompt_shared_on_cpu.data,
            )}`,
        );
    }
}

struct Inner {
}
struct Long {
}

/// A binding that holds 160 of the 300 rows of `narrow_products`' `wide`, so
/// its product runs in two chunks. The transposed `stored` binds no chunk, so
/// its product runs on the CPU.
global NARROW_SPLIT: i32 = 112_000;

/// `arg_max` along either axis, over a tie, a NaN, and a lane as long as a
/// vocabulary, each index printed as how far it is from `Cpu`'s.
fn arg_maxes() with (Stdout, Webgpu, Gpu, GpuAdapter, GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder, GpuSupportedLimits, RecordOptionGpuSize64) {
    let Some(mut gpu) = WebGpuBackend::new() else {
        return;
    };
    let mut short = tensor::<[Row, Col]>([5, 1000], 20);
    short.data[3] = 100.0;
    short.data[700] = 100.0;
    short.data[1500] = f32::NAN;
    short.data[1000 * 3 + 9] = 100.0;
    let long = tensor::<[Row, Col]>([1, 262_145], 21);
    for let [name, t, axis] of [
        ["rows", short, 1],
        ["columns", short, 0],
        ["long", long, 1],
    ] as List<[String, Tensor<f32, [Row, Col]>, i32]> {
        let on_cpu = Cpu {}.arg_max(&t, axis);
        gpu.begin();
        let on_device = gpu.upload(&t);
        let on_gpu = gpu.download(&gpu.arg_max(&on_device, axis));
        assert on_gpu.extents == on_cpu.extents;
        let indices = |data: List<i64>| -> List<f32> {
            return data.into_iter().map(|i| i as f32).collect();
        };
        println(`ArgMax ${name} ${on_gpu.extents:?} ${deviation(&indices(on_gpu.data), &indices(on_cpu.data))}`);
    }
}

struct Row {
}
struct Col {
}
