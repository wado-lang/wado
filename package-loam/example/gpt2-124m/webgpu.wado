//! GPT-2 (124M) on a WebGPU device. It continues each prompt `generate.json`
//! records with eight greedy tokens, on the device and then on `Cpu`, and
//! says whether the device picks the tokens onnxruntime picks. It prints each
//! backend's time per token, and the dispatches and read backs a token takes
//! on the device. `README.md` says how to run it:
//!
//!     cd package-loam/example/gpt2-124m
//!     wado run-webgpu webgpu.wado

use { eprintln, println, Stderr, Stdout } from "core:cli";
use fs from "core:fs";
use { Preopens } from "core:fs";
use { from_string } from "core:json";
use { MonotonicClock } from "wasi:clocks";
use {
    Webgpu,
    Gpu,
    GpuAdapter,
    GpuDevice,
    GpuQueue,
    GpuCommandEncoder,
    GpuCommandBuffer,
    GpuBuffer,
    GpuBindGroupLayout,
    GpuBindGroup,
    GpuShaderModule,
    GpuComputePipeline,
    GpuComputePassEncoder,
    GpuSupportedLimits,
    RecordOptionGpuSize64,
} from "wasi:webgpu";
use { Backend, Cpu, WebGpuBackend } from "lib:loam";
use { Model, Tokenizer } from "./model.wado";

/// One prompt and the tokens onnxruntime picks after it, as `generate.mjs`
/// writes them.
struct Generated {
    prompt: String,
    ids: List<i32>,
    generated: List<i32>,
    ms_per_token: f64,
    webgpu_ms_per_token: f64,
}

struct Oracle {
    generate: List<Generated>,
}

/// `ids` and the greedy token after them.
fn prompted<affine Bk: Backend>(model: &mut Model<Bk>, ids: &List<i32>) -> List<i32> with _ {
    let mut all = *ids;
    all.push(model.next_token(&all));
    return all;
}

/// `all` with `steps` more greedy tokens, and the milliseconds each took.
fn continued<affine Bk: Backend>(model: &mut Model<Bk>, all: &mut List<i32>, steps: i32) -> f64 with (MonotonicClock, _) {
    let started = MonotonicClock::now();
    for let _ of 0..<steps {
        all.push(model.next_token(all));
    }
    let elapsed = (MonotonicClock::now() - started) as u64;
    return elapsed as f64 / 1_000_000.0 / steps as f64;
}

export fn run() with (Stdout, Stderr, Preopens, MonotonicClock, Webgpu, Gpu, GpuAdapter, GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder, GpuSupportedLimits, RecordOptionGpuSize64) {
    let checkpoint = match fs::read_linear("model.onnx") {
        Ok(bytes) => bytes,
        Err(e) => {
            eprintln(`${e}; run fetch.sh first`);
            return;
        },
    };
    let Ok(text) = fs::read_to_string("generate.json") else {
        eprintln("generate.json is missing; run generate.mjs");
        return;
    };
    let oracle = from_string::<Oracle>(&text).unwrap();
    let Some(gpu) = WebGpuBackend::new() else {
        eprintln("no WebGPU adapter");
        return;
    };
    let mut on_device = Model::load(gpu, &checkpoint).unwrap();
    let mut on_cpu = Model::load(Cpu {}, &checkpoint).unwrap();
    for let g of oracle.generate {
        // Each token after the prompt's first, as onnxruntime's are timed.
        let steps = g.generated.len() - 1;
        let mut device = prompted(&mut on_device, &g.ids);
        let [read, dispatched] = [
            on_device.backend().read_backs(),
            on_device.backend().dispatches(),
        ];
        let device_ms = continued(&mut on_device, &mut device, steps);
        let reads = (on_device.backend().read_backs() - read) / steps;
        let dispatches = (on_device.backend().dispatches() - dispatched) / steps;
        let mut cpu = prompted(&mut on_cpu, &g.ids);
        let cpu_ms = continued(&mut on_cpu, &mut cpu, steps);
        let agrees = if device[g.ids.len()..<device.len()].to_list() == g.generated {
            "the tokens onnxruntime picks";
        } else {
            "NOT the tokens onnxruntime picks";
        };
        println(`${Tokenizer::decode(&device):?}: ${agrees}`);
        if cpu != device {
            println("the CPU picks other tokens");
        }
        println(
            `device ${device_ms:.1} ms a token in ${dispatches} dispatches and ${reads} read backs, cpu ${cpu_ms:.1} ms, onnxruntime ${g.ms_per_token:.1} ms on the CPU and ${g.webgpu_ms_per_token:.1} on WebGPU`,
        );
    }
}
