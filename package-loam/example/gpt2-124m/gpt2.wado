//! Text in, text out: GPT-2 (124M) continues a prompt one greedy token at a
//! time, picking the tokens onnxruntime picks. `README.md` says how to run it.

use { args, eprintln, println, Environment, Stderr, Stdout } from "core:cli";
use fs from "core:fs";
use { Preopens } from "core:fs";
use { Cpu } from "lib:loam";
use { Model, Tokenizer } from "./model.wado";

global STEPS: i32 = 8;

export fn run() with (Stdout, Stderr, Environment, Preopens) {
    let mut prompt = args().join(" ");
    if prompt.is_empty() {
        prompt = "Hello, my name is";
    }
    let mut ids = Tokenizer::encode(&prompt);
    if ids.is_empty() {
        eprintln("the prompt encodes to no token");
        return;
    }
    let checkpoint = match fs::read("gpt2.safetensors") {
        Ok(bytes) => bytes,
        Err(e) => {
            eprintln(`${e}; run fetch.sh first`);
            return;
        },
    };
    let mut model = match Model::load(Cpu {}, &checkpoint) {
        Ok(model) => model,
        Err(e) => {
            eprintln(`gpt2.safetensors: ${e}`);
            return;
        },
    };
    // The model reads at most one position per row of `wpe`, and never the
    // last token it picks.
    let longest = model.positions() - STEPS + 1;
    if ids.len() > longest {
        eprintln(`the prompt is ${ids.len()} tokens, and must be 1 to ${longest}`);
        return;
    }
    for let _ of 0..<STEPS {
        ids.push(model.next_token(&ids));
    }
    println(Tokenizer::decode(&ids));
}
