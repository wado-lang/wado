//! Times MNIST-12's `compute` on the CPU.
//!
//!     wado run package-loam/example/mnist_bench.wado

use { Stdout } from "core:cli";
use { Benchmark } from "core:benchmark";
use { MonotonicClock } from "wasi:clocks";
use { Cpu, Tensor } from "lib:loam";
use mnist from "../tests/models/mnist-12/model.onnx"
    with {
        type: "onnx",
        generator: { module: "lib:loam" },
    };

/// A digit-sized image of a fixed gradient: what the model computes is not
/// what it times.
fn image() -> Tensor<f32, [mnist::Input30, mnist::Input31, mnist::Input32, mnist::Input33]> {
    let mut data: List<f32> = [];
    for let i of 0..<784 {
        data.push((i % 7) as f32 / 7.0);
    }
    return Tensor {
        data,
        extents: [1, 1, 28, 28],
    };
}

fn embedded() -> mnist::Model<Cpu> {
    return mnist::Model::new(mnist::Params::embedded(&mut Cpu {}));
}

test "smoke" {
    let logits = mnist::compute(&mut Cpu {}, &image(), &mut embedded());
    assert logits.extents == [1, 10] as List<i32>;
}

export fn run() with (Stdout, MonotonicClock) {
    let mut model = embedded();
    let x = image();
    let mut b = Benchmark { name: "MNIST-12 compute on the CPU", work_per_iter: Option::Some(1.0), unit: "images" };
    b.run("", || mnist::compute(&mut Cpu {}, &x, &mut model).data[0]);
}
