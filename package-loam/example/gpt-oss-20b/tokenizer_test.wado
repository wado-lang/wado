//! gpt-oss's own tokenizer through Loam: each text encodes to the ids Hugging
//! Face's tokenizer gives it, recorded in `tokenize.json`, and decodes back.

use { from_string } from "core:json";
// Not through the model, whose build reads the whole graph.
use {
    Tokenizer,
} from "https://huggingface.co/onnx-community/gpt-oss-20b-ONNX/resolve/0cb2c910963421423a6011d51dd0fef9d6e99f36/tokenizer.json"
    with {
        type: "hf-tokenizer",
        integrity: "sha256:0614fe83cadab421296e664e1f48f4261fa8fef6e03e63bb75c20f38e37d07d3",
        generator: { module: "wado-lang:loam" },
    };

struct Tokenized {
    text: String,
    ids: List<i32>,
}

struct Oracle {
    tokenize: List<Tokenized>,
}

test "each text encodes to the ids Hugging Face's tokenizer gives it, and back" {
    let oracle = from_string::<Oracle>(#include_str("./tokenize.json")).unwrap();
    for let case of oracle.tokenize {
        let ids = Tokenizer::encode(&case.text);
        assert ids == case.ids;
        assert Tokenizer::decode(&ids) == case.text;
    }
}
