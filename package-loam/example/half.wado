//! A graph whose boundary is `float16`, run through the generated kernels.
//!
//! Wado's `f16` is storage only, so the weights and the boundary tensors are
//! held in it. `prepare` converts the weights once into the f32 the kernels
//! compute in, and `forward` converts each input as it arrives.
//!
//!     wado run package-loam/example/half.wado

use { println, Stdout } from "core:cli";
use { Cpu, Tensor } from "lib:loam";
use { Batch, In, Out, Weights, forward } from "./half.onnxtext"
    with {
        type: "onnxtext",
        generator: {
            module: "lib:loam",
            options: {
                layout: [
                    {
                        pattern: "X",
                        axes: ["Batch", "In"],
                    },
                    {
                        pattern: "W",
                        axes: ["In", "Out"],
                    },
                    {
                        pattern: "B",
                        axes: ["Out"],
                    },
                ],
            },
        },
    };

fn halves(count: i32, value: f32) -> List<f16> {
    return List::<f16>::filled(count, f16::from_f32(value));
}

/// Stand-ins for the weights the generator does not read yet.
fn weights() -> Weights {
    return Weights {
        W: Tensor::<f16, [In, Out]> {
            data: halves(4 * 2, 0.5),
            extents: [4, 2],
        },
        B: Tensor::<f16, [Out]> {
            data: halves(2, 1.0),
            extents: [2],
        },
    };
}

fn ones_input() -> Tensor<f16, [Batch, In]> {
    return Tensor {
        data: halves(4, 1.0),
        extents: [1, 4],
    };
}

export fn run() with Stdout {
    let mut cpu = Cpu {};
    let prepared = weights().prepare(&mut cpu);
    let y = forward(&mut cpu, &ones_input(), &prepared);
    println(`logits ${y.extents[1]}, first ${y.data[0]}`);
}

test "a float16 boundary runs through the f32 kernels and comes back half" {
    let mut cpu = Cpu {};
    let y = forward(&mut cpu, &ones_input(), &weights().prepare(&mut cpu));

    assert y.extents == [1, 2] as List<i32>;
    // Four ones at 0.5 each, plus the bias. Every value here is exact in f16.
    let expected: f32 = 4.0 * 0.5 + 1.0;
    assert f32::from(y.data[0]) == expected;
}
