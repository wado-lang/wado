//! Gemma 3 (270M) as its `q4` export stores it: each matrix, the embedding
//! table among them, in blocks of 4-bit values with a scale and a zero point,
//! which the device keeps packed. `checked` continues each prompt
//! `generate_q4.json` records on a device, and says whether it picks the tokens
//! onnxruntime picks, and how far the logits it picks the first from are from
//! onnxruntime's. `README.md` says how to run it.

use { eprintln, Stderr, Stdout } from "core:cli";
use { Preopens } from "core:fs";
use { Backend, FileSource, LoadError, Sampling, Tensor } from "wado-lang:loam";
use { deviation, recorded, reported } from "../checks.wado";
/// The graph alone: its weights are external data in `model_q4.onnx_data`.
use gemma from "https://huggingface.co/onnx-community/gemma-3-270m-it-ONNX/resolve/2dbbfdb1b59bd034eb959428c6a7da9dd7ea27f0/onnx/model_q4.onnx"
    with {
        type: "onnx",
        integrity: "sha256:cb3615746a988839308507933d4e0501ff695e747a0a0ce15c0ef53083f8ec54",
        generator: {
            module: "wado-lang:loam",
            options: {
                dims: { batch_size: 1 },
                // Only the last position ranks the next token.
                last: { logits: 1 },
                decode: { ids: "input_ids", mask: "attention_mask", logits: "logits" },
            },
        },
    };

/// Continues each prompt on `backend`, as `Q4Model::continued` does.
pub fn checked<affine Bk: Backend>(backend: Bk) with (_, Stdout, Stderr, Preopens) {
    let Some([generate, expected]) = recorded("generate_q4.json", "build/logits_q4.bin") else {
        return;
    };
    let mut loaded = match Q4Model::load(backend) {
        Ok(loaded) => loaded,
        Err(e) => {
            eprintln(`${e}; run fetch.sh first`);
            return;
        },
    };
    for let p of 0..<generate.len() {
        let g = &generate[p];
        let [generated, logits] = loaded.continued(&g.ids, g.generated.len());
        reported(g, &generated, deviation(&logits, &expected, p));
    }
}

/// The export's weights, loaded from `build/` onto a backend.
pub struct Q4Model<affine Bk: Backend> {
    on: Bk,
    model: gemma::Model<Bk>,
}

impl<affine Bk: Backend> Q4Model<Bk> {
    pub fn load(backend: Bk) -> Result<Q4Model<Bk>, LoadError> with (_, Preopens) {
        let mut on = backend;
        let model = gemma::Model::new(gemma::Params::load(&mut on, &FileSource { dir: "build" })?);
        return Ok(Q4Model { on, model });
    }

    pub fn backend_mut(&mut self) -> &mut Bk {
        return &mut self.on;
    }

    /// The `steps` tokens greedy decoding picks after `ids` from an empty
    /// cache, and the logits it picks the first from: the prompt in one pass,
    /// then every token after its first in one call.
    pub fn continued(&mut self, ids: &List<i32>, steps: i32) -> [List<i32>, List<f32>] with _ {
        let greedy = Sampling {};
        let passed = gemma::compute(
            &mut self.on,
            &token_ids(ids.into_iter().map(|id| id as i64).collect()),
            &mask_of(ids.len()),
            &gemma::Cache::empty(&mut self.on),
            steps - 1,
            &mut self.model,
        );
        let first = greedy.first_tokens(&passed.logits, ids.len() as i64)[0];
        if steps == 1 {
            return [
                [first as i32],
                passed.logits.data,
            ];
        }
        let decoded = gemma::decode(
            &mut self.on,
            &token_ids([first]),
            &mask_of(ids.len() + 1),
            &passed.cache,
            steps - 1,
            &greedy,
            &mut self.model,
        );
        let mut generated: List<i32> = [first as i32];
        generated.extend(&decoded.tokens.data.into_iter().map(|id| id as i32).collect());
        return [generated, passed.logits.data];
    }
}

fn token_ids(data: List<i64>) -> Tensor<i64, [gemma::BatchSize, gemma::SequenceLength]> {
    return Tensor {
        data,
        extents: [gemma::BatchSize::EXTENT, data.len()],
    };
}

/// A mask of `length` positions, all of them read.
fn mask_of(length: i32) -> Tensor<i64, [gemma::BatchSize, gemma::TotalSequenceLength]> {
    return Tensor {
        data: List::<i64>::filled(length, 1),
        extents: [gemma::BatchSize::EXTENT, length],
    };
}
