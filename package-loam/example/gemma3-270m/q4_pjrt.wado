//! Gemma 3 (270M)'s `q4` export on a PJRT plugin's device, checked as
//! `q4.wado` says.

use { Stderr, Stdout } from "core:cli";
use { Preopens } from "core:fs";
use { PjrtHost } from "wado-lang:pjrt";
use { PjrtBackend } from "wado-lang:loam";
use { checked } from "./q4.wado";

export fn run() with (Stdout, Stderr, Preopens, PjrtHost) {
    checked(PjrtBackend::new());
}
