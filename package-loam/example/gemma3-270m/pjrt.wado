//! Gemma 3 (270M) on a PJRT plugin's device, through the programs the plugin
//! compiled for each shape class. It continues each prompt `generate.json`
//! records with greedy tokens on the device, and says whether it picks the
//! tokens onnxruntime picks. It prints the time per token, and the programs run
//! and read backs a token takes. `README.md` says how to run it.

use { Stderr, Stdout } from "core:cli";
use { Preopens } from "core:fs";
use { PjrtHost } from "core:pjrt";
use { MonotonicClock } from "wasi:clocks";
use { PjrtBackend, Sampling } from "lib:loam";
use { continued, read_checkpoint, recorded } from "./continued.wado";
use { Model } from "./model.wado";

export fn run() with (Stdout, Stderr, Preopens, MonotonicClock, PjrtHost) {
    let Some(checkpoint) = read_checkpoint() else {
        return;
    };
    let Some(generate) = recorded() else {
        return;
    };
    let mut model = Model::load(PjrtBackend::new(), &checkpoint).unwrap();
    // The device holds the weights.
    builtin::drop(checkpoint);
    continued(generate, |ids, count, room| model.next_tokens(ids, count, &Sampling {}, room), || [
        model.backend().read_backs(),
        model.backend().executions(),
    ]);
}
