//! Gemma 3 (270M) on a WebGPU device, a token a `compute` through the program
//! the backend compiled for its shape class. It continues each prompt
//! `generate.json` records with greedy tokens on the device, and says whether
//! it picks the tokens onnxruntime picks. It prints the time per token, and the
//! dispatches and read backs a token takes. `README.md` says how to run it.

use { eprintln, Stderr, Stdout } from "core:cli";
use { Preopens } from "core:fs";
use { MonotonicClock } from "wasi:clocks";
use {
    Webgpu,
    Gpu,
    GpuAdapter,
    GpuDevice,
    GpuQueue,
    GpuCommandEncoder,
    GpuCommandBuffer,
    GpuBuffer,
    GpuBindGroupLayout,
    GpuBindGroup,
    GpuShaderModule,
    GpuComputePipeline,
    GpuComputePassEncoder,
    GpuSupportedLimits,
    RecordOptionGpuSize64,
} from "wasi:webgpu";
use { WebGpuBackend } from "lib:loam";
use { continued, read_checkpoint, recorded } from "./continued.wado";
use { Model } from "./model.wado";

export fn run() with (Stdout, Stderr, Preopens, MonotonicClock, Webgpu, Gpu, GpuAdapter, GpuDevice, GpuQueue, GpuCommandEncoder, GpuCommandBuffer, GpuBuffer, GpuBindGroupLayout, GpuBindGroup, GpuShaderModule, GpuComputePipeline, GpuComputePassEncoder, GpuSupportedLimits, RecordOptionGpuSize64) {
    let Some(checkpoint) = read_checkpoint() else {
        return;
    };
    let Some(generate) = recorded() else {
        return;
    };
    let Some(gpu) = WebGpuBackend::new() else {
        eprintln("no WebGPU adapter");
        return;
    };
    let mut model = Model::load(gpu, &checkpoint).unwrap();
    // The device holds the weights.
    builtin::drop(checkpoint);
    continued(generate, |ids| model.next_token(ids), || [
        model.backend().read_backs(),
        model.backend().dispatches(),
    ]);
}
