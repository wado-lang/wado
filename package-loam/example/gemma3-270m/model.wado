//! Gemma 3 (270M, instruction-tuned) as a library: its tokenizer, and the model
//! that picks the next token greedily, keeping the attention cache between
//! calls.

use { CheckpointBytes, Graph, LoadError, Tensor } from "lib:loam";
/// Gemma's SentencePiece-spelled BPE, which puts `<bos>` first.
pub use {
    Tokenizer,
} from "https://huggingface.co/onnx-community/gemma-3-270m-it-ONNX/resolve/2dbbfdb1b59bd034eb959428c6a7da9dd7ea27f0/tokenizer.json"
    with {
        type: "hf-tokenizer",
        integrity: "sha256:55da1312bdf1d7d8fe8d9d1b3eed04086261149e6034e0ac3f8c633b67f5aac8",
        generator: { module: "lib:loam" },
    };
/// The graph alone: its weights are external data in `model.onnx_data`.
use gemma from "https://huggingface.co/onnx-community/gemma-3-270m-it-ONNX/resolve/2dbbfdb1b59bd034eb959428c6a7da9dd7ea27f0/onnx/model.onnx"
    with {
        type: "onnx",
        integrity: "sha256:56adf096be205ed53d9a1c59180ab2bdd47649a385705c7ab6a64f12d93e06b4",
        generator: {
            module: "lib:loam",
            options: {
                dims: { batch_size: 1 },
                // Only the last position ranks the next token, and only its
                // index is read back.
                last: { logits: 1 },
                arg_max: { logits: 2 },
            },
        },
    };

/// Gemma 3 with its weights loaded where `Bk` runs each operation of the graph
/// `build` adds to, computed from inputs padded to capacities and a cache of
/// fixed capacity.
pub struct Model<affine Bk: Graph> {
    backend: Bk,
    model: gemma::Model<Bk>,
    /// The ids the cache holds the keys and values of.
    seen: List<i32>,
    cache: gemma::Cache<Bk>,
}

impl<affine Bk: Graph> Model<Bk> {
    /// Loads the weights onto `backend` from `data`, the bytes of the
    /// `model.onnx_data` beside the `model.onnx` the build read.
    pub fn load<affine Ck: CheckpointBytes>(backend: Bk, data: &Ck) -> Result<Model<Bk>, LoadError> with _ {
        let mut on = backend;
        let model = gemma::Model::new(gemma::Params::load(&mut on, data)?);
        let cache = gemma::Cache::empty(&mut on);
        return Ok(Model { backend: on, model, seen: [], cache });
    }

    /// The backend the model runs on.
    pub fn backend(&self) -> &Bk {
        return &self.backend;
    }

    /// How many positions the model reads: one per row of the rotary caches.
    pub fn positions(&self) -> i32 {
        return positions();
    }

    /// Empties the cache, so the next call reads its ids from the start.
    pub fn forget(&mut self) with _ {
        self.seen = [];
        self.cache = gemma::Cache::empty(&mut self.backend);
    }

    /// The token the model ranks first after `ids`. Where `ids` extends the
    /// ids of the last call, only the new ones run, against the cached keys
    /// and values of the rest.
    pub fn next_token(&mut self, ids: &List<i32>) -> i32 with _ {
        assert_readable(ids);
        if !extends(&self.seen, ids) {
            self.forget();
        }
        let fresh: List<i64> = ids.into_iter().skip(self.seen.len()).map(|id| id as i64).collect();
        let input_ids = Tensor::<i64, [gemma::BatchSize, gemma::SequenceLength]> {
            data: fresh,
            extents: [gemma::BatchSize::EXTENT, fresh.len()],
        };
        let mask = Tensor::<i64, [gemma::BatchSize, gemma::TotalSequenceLength]> {
            data: List::<i64>::filled(ids.len(), 1),
            extents: [gemma::BatchSize::EXTENT, ids.len()],
        };
        let passed = gemma::compute(&mut self.backend, &input_ids, &mask, &self.cache, &mut self.model);
        self.cache = passed.cache;
        self.seen = *ids;
        return passed.logits.data[0] as i32;
    }
}

fn positions() -> i32 {
    return i32::min(gemma::CosCacheLocal0::EXTENT, gemma::CosCacheGlobal0::EXTENT);
}

fn assert_readable(ids: &List<i32>) {
    assert 1 <= ids.len() <= positions(), "the model reads 1 to positions() tokens";
    for let id of ids {
        assert 0 <= *id < gemma::ModelEmbedTokensWeight0::EXTENT, "every token id is in the vocabulary";
    }
}

/// Whether `ids` starts with the ids `seen`, those the cache holds, and adds
/// some.
fn extends(seen: &List<i32>, ids: &List<i32>) -> bool {
    if ids.len() <= seen.len() {
        return false;
    }
    for let i of 0..<seen.len() {
        if ids[i] != seen[i] {
            return false;
        }
    }
    return true;
}
