//! What the programs on a device share: each prompt `generate.json` records,
//! continued with greedy tokens, and whether they are the tokens onnxruntime
//! picks, with the time, device runs and read backs a token takes.

use { eprintln, println, Stderr, Stdout } from "core:cli";
use fs from "core:fs";
use { Preopens } from "core:fs";
use { from_string } from "core:json";
use { LinearArray } from "core:linear";
use { MonotonicClock } from "wasi:clocks";

/// How many tokens a call picks on a device: a read back each, then one for all.
global EACH_CALL: List<i32> = [1, 32];

/// One prompt and the tokens onnxruntime picks after it, as `generate.mjs`
/// writes them.
pub struct Generated {
    pub prompt: String,
    pub ids: List<i32>,
    pub generated: List<i32>,
    pub ms_per_token: f64,
    pub webgpu_ms_per_token: f64,
}

struct Oracle {
    generate: List<Generated>,
}

/// The bytes of `model.onnx_data`, or `None` where it is missing.
pub fn read_checkpoint() -> Option<LinearArray<u8>> with (Stderr, Preopens) {
    return match fs::read_linear("build/model.onnx_data") {
        Ok(bytes) => Option::Some(bytes),
        Err(e) => {
            eprintln(`${e}; run fetch.sh first`);
            null;
        },
    };
}

/// The prompts `generate.json` records, or `None` where it is missing.
pub fn recorded() -> Option<List<Generated>> with (Stderr, Preopens) {
    let Ok(text) = fs::read_to_string("generate.json") else {
        eprintln("generate.json is missing; run generate.mjs");
        return null;
    };
    return Option::Some(from_string::<Oracle>(&text).unwrap().generate);
}

/// Continues each of `generate` by `next`, the prompt and its first token in a
/// call, then the tokens after it as many a call as each of `EACH_CALL` says,
/// and prints how each went. `next` takes the ids so far, how many tokens to
/// pick and how many to leave the cache room for after those. `counts` is the
/// backend's read backs and device runs so far: a compute shader's dispatches,
/// or a PJRT program's executions.
pub fn continued<effect E>(
    generate: List<Generated>,
    mut next: fn mut(&List<i32>, i32, i32) -> List<i32> with E,
    counts: fn() -> [i32, i32] with E,
) with (E, Stdout, MonotonicClock) {
    for let each_call of EACH_CALL {
        println(`${each_call} tokens a call:`);
        for let g of generate {
            let mut all = g.ids;
            let steps = g.generated.len();
            let started = MonotonicClock::now();
            all.extend(&next(&all, 1, steps - 1));
            let prompted = MonotonicClock::now();
            let [read, ran] = counts();
            while all.len() < g.ids.len() + steps {
                all.extend(&next(&all, i32::min(each_call, g.ids.len() + steps - all.len()), 0));
            }
            let ended = MonotonicClock::now();
            let [reads_now, runs_now] = counts();
            let reads = (reads_now - read) as f64 / (steps - 1) as f64;
            let runs = (runs_now - ran) as f64 / (steps - 1) as f64;
            let generated = all[g.ids.len()..<all.len()].to_list();
            let verdict = if generated == g.generated {
                "matches onnxruntime";
            } else {
                `onnxruntime picks ${g.generated:?}`;
            };
            let first = (prompted - started) as u64 as f64 / 1_000_000.0;
            let rest = (ended - prompted) as u64 as f64 / 1_000_000.0 / (steps - 1) as f64;
            println(`${g.prompt:?} -> ${generated:?}: ${verdict}`);
            println(
                `  ${first:.0} ms for the prompt, ${rest:.1} ms a token after it in ${runs:.1} device runs and ${reads:.2} read backs (onnxruntime ${g.ms_per_token:.1} on the CPU, ${g.webgpu_ms_per_token:.1} on WebGPU)`,
            );
        }
    }
}
