//! Gemma 3's own tokenizer through Loam: each text encodes to the ids Hugging
//! Face's tokenizer gives it, recorded in `tokenize.json`, and decodes back.

use { from_string } from "core:json";
// Not through `model.wado`, whose build reads the whole graph.
use {
    Tokenizer,
} from "https://huggingface.co/onnx-community/gemma-3-270m-it-ONNX/resolve/2dbbfdb1b59bd034eb959428c6a7da9dd7ea27f0/tokenizer.json"
    with {
        type: "hf-tokenizer",
        integrity: "sha256:55da1312bdf1d7d8fe8d9d1b3eed04086261149e6034e0ac3f8c633b67f5aac8",
        generator: { module: "lib:loam" },
    };

struct Tokenized {
    text: String,
    ids: List<i32>,
}

struct Oracle {
    tokenize: List<Tokenized>,
}

test "each text encodes to the ids Hugging Face's tokenizer gives it, and back" {
    let oracle = from_string::<Oracle>(#include_str("./tokenize.json")).unwrap();
    for let case of oracle.tokenize {
        let ids = Tokenizer::encode(&case.text);
        assert ids == case.ids;
        assert Tokenizer::decode(&ids) == `<bos>${case.text}`;
    }
}
