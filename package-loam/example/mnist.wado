//! MNIST-12 from the ONNX Model Zoo, compiled ahead of time with the weights it
//! carries, classifying digits drawn below as white strokes on black.
//!
//! Loam names every axis from the graph, so each convolution's channels, each
//! window's grid, and the flattened features the last layer contracts all
//! check at build time.
//!
//!     wado run package-loam/example/mnist.wado

use { println, Stdout } from "core:cli";
use { Cpu, Tensor } from "lib:loam";
use mnist from "../tests/models/mnist-12/model.onnx"
    with {
        type: "onnx",
        generator: { module: "lib:loam" },
    };

global SEVEN: List<String> = [
    "............................", "............................", "............................",
    "............................", ".......##############.......", ".......##############.......",
    "...................###......", "..................###.......", "..................###.......",
    ".................###........", ".................###........", "................###.........",
    "................###.........", "...............###..........", "...............###..........",
    "..............###...........", "..............###...........", ".............###............",
    ".............###............", "............###.............", "............###.............",
    "...........###..............", "...........###..............", "............................",
    "............................", "............................", "............................",
    "............................",
];

global ZERO: List<String> = [
    "............................", "............................", "............................",
    "............................", "..........########..........", "........############........",
    ".......####......####.......", "......####........####......", "......###..........###......",
    ".....###............###.....", ".....###............###.....", ".....###............###.....",
    ".....###............###.....", ".....###............###.....", ".....###............###.....",
    ".....###............###.....", ".....###............###.....", "......###..........###......",
    "......####........####......", ".......####......####.......", "........############........",
    "..........########..........", "............................", "............................",
    "............................", "............................", "............................",
    "............................",
];

global ONE: List<String> = [
    "............................", "............................", "............................",
    "............................", ".............###............", "............####............",
    "...........#####............", ".............###............", ".............###............",
    ".............###............", ".............###............", ".............###............",
    ".............###............", ".............###............", ".............###............",
    ".............###............", ".............###............", ".............###............",
    ".............###............", ".............###............", ".............###............",
    "...........#######..........", "............................", "............................",
    "............................", "............................", "............................",
    "............................",
];

/// A drawn digit as the model reads one: white strokes on black, in `[0, 1]`.
fn image_of(rows: &List<String>) -> Tensor<f32, [mnist::Input30, mnist::Input31, mnist::Input32, mnist::Input33]> {
    let mut data: List<f32> = [];
    for let row of *rows {
        assert row.len() == rows.len();
        for let c of row.chars() {
            data.push(if c == '#' { 1.0 } else { 0.0 });
        }
    }
    return Tensor {
        data,
        extents: [
            1,
            1,
            rows.len(),
            rows.len(),
        ],
    };
}

fn classify(
    model: &mut mnist::Model<Cpu>,
    image: &Tensor<f32, [mnist::Input30, mnist::Input31, mnist::Input32, mnist::Input33]>,
) -> i32 {
    let logits = mnist::compute(&mut Cpu {}, image, model);
    let mut best = 0;
    for let [digit, v] of logits.data.into_iter().enumerate() {
        if v > logits.data[best] {
            best = digit;
        }
    }
    return best;
}

export fn run() with Stdout {
    let mut model = embedded();
    for let digit of [&SEVEN, &ZERO, &ONE] {
        for let row of *digit {
            println(row);
        }
        println(`predicted: ${classify(&mut model, &image_of(digit))}`);
    }
}

fn embedded() -> mnist::Model<Cpu> {
    return mnist::Model::new(mnist::Params::embedded(&mut Cpu {}));
}

test "each drawn digit is classified as the digit it is" {
    let mut model = embedded();
    assert classify(&mut model, &image_of(&SEVEN)) == 7;
    assert classify(&mut model, &image_of(&ZERO)) == 0;
    assert classify(&mut model, &image_of(&ONE)) == 1;
}
