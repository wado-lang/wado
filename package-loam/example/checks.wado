//! What the examples checked against onnxruntime share: what it recorded of
//! each prompt, and the verdict on what a model computes after it.

use { eprintln, println, Stderr, Stdout } from "core:cli";
use fs from "core:fs";
use { Preopens } from "core:fs";
use { from_string } from "core:json";
use { LinearArray } from "core:linear";
use { Element } from "lib:loam";

/// One prompt and the tokens onnxruntime picks after it, as `generate.mjs`
/// writes them.
pub struct Generated {
    pub prompt: String,
    pub ids: List<i32>,
    pub generated: List<i32>,
}

struct Oracle {
    generate: List<Generated>,
}

/// The prompts `json` records, and the logits onnxruntime picks each one's
/// first token from, which `generate.mjs` writes into `logits`.
pub fn recorded(json: String, logits: String) -> Option<[List<Generated>, LinearArray<f32>]> with (Stderr, Preopens) {
    let [Ok(text), Ok(bytes)] = [
        fs::read_to_string(&json),
        fs::read_linear(&logits),
    ] else {
        eprintln(`${json} or ${logits} is missing; run generate.mjs`);
        return null;
    };
    return Option::Some([
        from_string::<Oracle>(&text).unwrap().generate,
        bytes.cast::<f32>(),
    ]);
}

/// How far `logits` sit from prompt `p`'s in `onnxruntime`'s.
pub fn deviation<E: Element>(logits: &List<E>, onnxruntime: &LinearArray<f32>, p: i32) -> f32 {
    let at = p * logits.len();
    let mut largest: f32 = 0.0;
    for let v of 0..<logits.len() {
        largest = f32::max(largest, f32::abs(logits[v].cast_to::<f32>() - onnxruntime[at + v]));
    }
    return largest;
}

/// Says whether `generated` are the tokens onnxruntime picks after `g`, and how
/// far, `apart`, the logits it picked the first from are from onnxruntime's.
pub fn reported(g: &Generated, generated: &List<i32>, apart: f32) with Stdout {
    let verdict = if *generated == g.generated { "matches onnxruntime" } else { `onnxruntime picks ${g.generated:?}` };
    println(`${g.prompt:?} -> ${generated:?}: ${verdict}`);
    println(`  the first token's logits are within ${apart} of onnxruntime's`);
}
