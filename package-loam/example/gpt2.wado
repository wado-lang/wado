//! Text in, text out: a tiny GPT-2 continues a prompt one greedy token at a
//! time. Its weights are random, so the continuation is noise, but the same
//! noise onnxruntime picks.
//!
//!     wado run package-loam/example/gpt2.wado -- "Hello, my name is"
//!
//! The decoder is one graph that branches on whether it is given a past. The
//! prompt runs through the branch without one, all its positions at once, and
//! each token after it through the branch with the keys and values computed so
//! far, so a step computes one position rather than every position so far.

use { args, eprintln, println, Environment, Stderr, Stdout } from "core:cli";
use { from_string } from "core:json";
use { Cpu, Tensor } from "lib:loam";
use { Tokenizer } from "../tests/models/tiny-gpt2/tokenizer.json"
    with {
        type: "hf-tokenizer",
        generator: { module: "lib:loam" },
    };
use gpt2 from "../tests/models/tiny-gpt2/merged/model.onnx"
    with {
        type: "onnx",
        generator: {
            module: "lib:loam",
            options: {
                dims: { batch_size: 1 },
                layout: [
                    {
                        pattern: "input_ids",
                        axes: ["Batch", "Seq"],
                    },
                    // Without a past the keys are the sequence itself, so the
                    // mask over them and the sequence share one axis.
                    {
                        pattern: "attention_mask",
                        axes: ["Batch", "Seq"],
                    },
                    {
                        pattern: "use_cache_branch",
                        axes: ["One"],
                    },
                    {
                        pattern: "past_key_values.*",
                        axes: ["Batch", "Head", "Past", "Dim"],
                    },
                    {
                        pattern: "present.*",
                        axes: ["Batch", "Head", "Seq", "Dim"],
                    },
                    {
                        pattern: "transformer.wte.weight*",
                        axes: ["Vocab", "Embed"],
                    },
                    {
                        pattern: "transformer.wpe.weight*",
                        axes: ["Pos", "Embed"],
                    },
                    {
                        pattern: "*ln_1.*",
                        axes: ["Embed"],
                    },
                    {
                        pattern: "*ln_2.*",
                        axes: ["Embed"],
                    },
                    {
                        pattern: "*c_attn.weight*",
                        axes: ["Embed", "Qkv"],
                    },
                    {
                        pattern: "*c_attn.bias*",
                        axes: ["Qkv"],
                    },
                    {
                        pattern: "*attn.c_proj.weight*",
                        axes: ["(Head Dim)", "Embed"],
                    },
                    {
                        pattern: "*mlp.c_fc.weight*",
                        axes: ["Embed", "Inner"],
                    },
                    {
                        pattern: "*mlp.c_fc.bias*",
                        axes: ["Inner"],
                    },
                    {
                        pattern: "*mlp.c_proj.weight*",
                        axes: ["Inner", "Embed"],
                    },
                    {
                        pattern: "onnx::MatMul_1588*",
                        axes: ["Embed", "Vocab"],
                    },
                    {
                        pattern: "*attn.bias*",
                        axes: ["Batch", "Head", "Pos", "Pos"],
                    },
                    {
                        pattern: "/transformer/Range_output_0",
                        axes: ["Seq"],
                    },
                    {
                        pattern: "/transformer/Unsqueeze_2_output_0",
                        axes: ["Batch", "Seq"],
                    },
                    {
                        pattern: "/transformer/Unsqueeze_4_output_0",
                        axes: ["Batch", "Head", "Seq"],
                    },
                    {
                        pattern: "/transformer/Unsqueeze_5_output_0",
                        axes: ["Batch", "Head", "Seq", "Seq"],
                    },
                    {
                        pattern: "*/c_attn/Reshape_1_output_0",
                        axes: ["Batch", "Seq", "Qkv"],
                    },
                    {
                        pattern: "*/c_proj/Reshape_1_output_0",
                        axes: ["Batch", "Seq", "Embed"],
                    },
                    {
                        pattern: "*/c_fc/Reshape_1_output_0",
                        axes: ["Batch", "Seq", "Inner"],
                    },
                    {
                        pattern: "*/attn/Split_output_*",
                        axes: ["Batch", "Seq", "Embed"],
                    },
                    {
                        pattern: "*/attn/Reshape_output_0",
                        axes: ["Batch", "Seq", "Head", "Dim"],
                    },
                    {
                        pattern: "*/attn/Reshape_1_output_0",
                        axes: ["Batch", "Seq", "Head", "Dim"],
                    },
                    {
                        pattern: "*/attn/Reshape_2_output_0",
                        axes: ["Batch", "Seq", "Head", "Dim"],
                    },
                    {
                        pattern: "*/attn/Slice_3_output_0",
                        axes: ["Batch", "Head", "Seq", "Pos"],
                    },
                    {
                        pattern: "*/attn/Slice_4_output_0",
                        axes: ["Batch", "Head", "Seq", "Seq"],
                    },
                ],
            },
        },
    };

global STEPS: i32 = 8;

/// How many tokens the model reads at most: one position per row of `wpe`.
fn positions(weights: &gpt2::Weights) -> i32 {
    return weights.transformer_wpe_weight_merged_0.extents[0];
}

/// The longest prompt `greedy` extends by `steps`. The last token it picks is
/// never read, so the model reads one fewer than it returns.
fn longest_prompt(steps: i32, weights: &gpt2::Weights) -> i32 {
    return positions(weights) - steps + 1;
}

/// The keys and values so far, one per layer's key and value in the order the
/// graph names them.
type Cache = List<Tensor<f32, [gpt2::Batch, gpt2::Head, gpt2::Past, gpt2::Dim]>>;

/// No positions yet, which takes the branch without a past.
fn empty_cache() -> Cache {
    let mut cache: Cache = [];
    for let _ of 0..<10 {
        cache.push(Tensor {
            data: [],
            extents: [gpt2::Batch::EXTENT, 4, 0, 8],
        });
    }
    return cache;
}

/// The token the logits rank first at the last position.
fn best(logits: &Tensor<f32, [gpt2::Batch, gpt2::Seq, gpt2::Vocab]>) -> i32 {
    let vocab = logits.extents[2];
    let row = (logits.extents[1] - 1) * vocab;
    let mut top = 0;
    for let v of 1..<vocab {
        if logits.data[row + v] > logits.data[row + top] {
            top = v;
        }
    }
    return top;
}

/// The token after `tokens` and the positions `cache` holds, and the cache
/// grown by `tokens`' positions.
fn decode(tokens: &List<i32>, cache: &Cache, weights: &gpt2::Weights) -> [i32, Cache] {
    let past = cache[0].extents[2];
    let length = past + tokens.len();
    let ids: List<i64> = tokens.into_iter().map(|id| id as i64).collect();
    let o = gpt2::forward(
        &mut Cpu {},
        &Tensor::<i64, [gpt2::Batch, gpt2::Seq]> {
            data: ids,
            extents: [gpt2::Batch::EXTENT, tokens.len()],
        },
        &Tensor::<i64, [gpt2::Batch, gpt2::Seq]> {
            data: List::<i64>::filled(length, 1),
            extents: [gpt2::Batch::EXTENT, length],
        },
        &cache[0],
        &cache[1],
        &cache[2],
        &cache[3],
        &cache[4],
        &cache[5],
        &cache[6],
        &cache[7],
        &cache[8],
        &cache[9],
        &Tensor::<bool, [gpt2::One]> {
            data: [past > 0],
            extents: [1],
        },
        weights,
    );
    let presents = [
        o.present_0_key, o.present_0_value, o.present_1_key, o.present_1_value, o.present_2_key, o.present_2_value,
        o.present_3_key, o.present_3_value, o.present_4_key, o.present_4_value,
    ];
    let mut grown: Cache = [];
    for let p of presents {
        grown.push(Tensor { data: p.data, extents: p.extents });
    }
    return [best(&o.logits), grown];
}

/// `prompt` extended by `steps` tokens, each the one the model ranks first.
fn greedy(prompt: &List<i32>, steps: i32, weights: &gpt2::Weights) -> List<i32> {
    assert 1 <= prompt.len() <= longest_prompt(steps, weights);
    let mut ids = *prompt;
    let [first, prefilled] = decode(prompt, &empty_cache(), weights);
    ids.push(first);
    let mut cache = prefilled;
    for let _ of 1..<steps {
        let [next, grown] = decode(&[ids[ids.len() - 1]], &cache, weights);
        ids.push(next);
        cache = grown;
    }
    return ids;
}

export fn run() with (Stdout, Stderr, Environment) {
    let mut prompt = args().join(" ");
    if prompt.is_empty() {
        prompt = "Hello, my name is";
    }
    let ids = Tokenizer::encode(&prompt);
    let weights = gpt2::Weights::embedded();
    let longest = longest_prompt(STEPS, &weights);
    if !(1 <= ids.len() <= longest) {
        eprintln(`the prompt is ${ids.len()} tokens, and must be 1 to ${longest}`);
        return;
    }
    println(Tokenizer::decode(&greedy(&ids, STEPS, &weights)));
}

struct Generated {
    prompt: String,
    ids: List<i32>,
    generated: List<i32>,
    text: String,
}

struct Oracle {
    generate: List<Generated>,
}

#[timeout_ms(30000)]
test "each prompt continues with the tokens onnxruntime picks greedily" {
    let weights = gpt2::Weights::embedded();
    let oracle = from_string::<Oracle>(#include_str("../tests/models/tiny-gpt2/generate.json")).unwrap();
    for let case of oracle.generate {
        assert Tokenizer::encode(&case.prompt) == case.ids;
        let mut want = case.ids;
        want.extend(&case.generated);
        let got = greedy(&case.ids, case.generated.len(), &weights);
        assert got == want;
        assert Tokenizer::decode(&got) == case.text;
    }
}

#[timeout_ms(30000)]
test "the longest prompt fills every position the model reads" {
    let weights = gpt2::Weights::embedded();
    let prompt = List::<i32>::filled(longest_prompt(2, &weights), 0);
    assert greedy(&prompt, 2, &weights).len() == positions(&weights) + 1;
}
