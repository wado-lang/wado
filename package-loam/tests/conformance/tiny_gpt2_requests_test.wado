//! A tiny GPT-2 decoding requests side by side in slots, and the same decoder
//! loaded from a checkpoint given in shards. They share a file because each
//! file compiles the runtime again, and Kiln reads each model file once per
//! file, so the other forms of these two models live in other files.

use { Cpu, Sampling, Tensor } from "lib:loam";
use { HashMap } from "core:collections";
use { assert_close, ints_of, tensor_of } from "./oracle.wado";
use decoding from "../models/tiny-gpt2/merged/model.onnx"
    with {
        type: "onnx",
        generator: {
            module: "lib:loam",
            options: {
                last: { logits: 1 },
                decode: { ids: "input_ids", mask: "attention_mask", logits: "logits" },
            },
        },
    };
use sharded from "../models/tiny-gpt2/model.onnxtext"
    with {
        type: "onnxtext",
        generator: {
            module: "lib:loam",
            inputs: [
                { path: "../models/tiny-gpt2/sharded/model.safetensors.index.json", type: "safetensors-index" },
                { path: "../models/tiny-gpt2/sharded/model-00001-of-00003.safetensors", type: "safetensors" },
                { path: "../models/tiny-gpt2/sharded/model-00002-of-00003.safetensors", type: "safetensors" },
                { path: "../models/tiny-gpt2/sharded/model-00003-of-00003.safetensors", type: "safetensors" },
            ],
            options: {
                dims: { batch_size: 1 },
                outputs: ["logits"],
            },
        },
    };

// The decoder that branches on whether it is given a past, as GPT-2's merged
// export does. Each request picks the tokens it picks alone: its prompt through
// `compute`, then one call of `decode`. A pass with no past owes the mask the
// prompt's length, so the prompt leaves no room, and `decode` grows the cache.

global STEPS: i32 = 6;

fn ids(tokens: List<i64>) -> Tensor<i64, [decoding::BatchSize, decoding::SequenceLength]> {
    return Tensor {
        data: tokens,
        extents: [1, tokens.len()],
    };
}

fn mask(length: i32) -> Tensor<i64, [decoding::BatchSize, decoding::SequenceLength]> {
    return Tensor {
        data: List::<i64>::filled(length, 1),
        extents: [1, length],
    };
}

fn branch(cached: bool) -> Tensor<bool, [decoding::UseCacheBranch0]> {
    return Tensor {
        data: [cached],
        extents: [1],
    };
}

fn alone(cpu: &mut Cpu, model: &mut decoding::Model<Cpu>, prompt: List<i64>, sampling: &Sampling) -> List<i64> {
    let first = decoding::compute(
        cpu,
        &ids(prompt),
        &mask(prompt.len()),
        &branch(false),
        &decoding::Cache::empty(cpu, 1),
        0,
        model,
    );
    let mut tokens = sampling.first_tokens(&first.logits, prompt.len() as i64);
    let next = decoding::decode(
        cpu,
        &ids(tokens),
        &mask(prompt.len() + 1),
        &branch(true),
        &first.cache,
        STEPS,
        sampling,
        model,
    );
    tokens.extend(&next.tokens.data);
    return tokens;
}

test "requests in slots of a branching decoder each pick the tokens they pick alone" {
    let cpu = &mut Cpu {};
    let mut model = decoding::Model::new(decoding::Params::embedded(cpu));
    let prompts: List<List<i64>> = [
        [1, 5, 42, 7, 9],
        [3, 8],
        [12, 21, 4],
    ];
    for let sampling of [
        Sampling {},
        Sampling { temperature: 0.8, seed: 7 },
    ] {
        let mut requests = decoding::Requests::new(cpu, 4, 16);
        let mut tokens: List<List<i64>> = [];
        for let [slot, prompt] of prompts.into_iter().enumerate() {
            tokens.push([
                requests.place(cpu, slot, &ids(prompt), &mask(prompt.len()), &branch(false), &sampling, &mut model),
            ]);
        }
        let next = requests.decode(cpu, &branch(true), STEPS, &sampling, &mut model);
        for let [slot, prompt] of prompts.into_iter().enumerate() {
            tokens[slot].extend(&next.data[slot * STEPS..<(slot + 1) * STEPS].to_list());
            assert tokens[slot] == alone(cpu, &mut model, prompt, &sampling);
        }
    }
}

// The decoder of `tiny_gpt2.wado`, its checkpoint given in shards beside the
// index placing each tensor, against the logits onnxruntime computes from the
// single file.

/// The shards, keyed by the file names the index places tensors in.
fn every_shard() -> HashMap<String, ByteList> {
    let mut shards = HashMap::<String, ByteList>::new();
    shards["model-00001-of-00003.safetensors"] = #include_bytes("../models/tiny-gpt2/sharded/model-00001-of-00003.safetensors");
    shards["model-00002-of-00003.safetensors"] = #include_bytes("../models/tiny-gpt2/sharded/model-00002-of-00003.safetensors");
    shards["model-00003-of-00003.safetensors"] = #include_bytes("../models/tiny-gpt2/sharded/model-00003-of-00003.safetensors");
    return shards;
}

fn reproduces(input_ids: ByteList, attention_mask: ByteList, logits: ByteList) {
    let [tokens, tokens_extents] = ints_of(input_ids);
    let [kept, kept_extents] = ints_of(attention_mask);
    let [want, want_extents] = tensor_of(logits);

    let mut cpu = Cpu {};
    let mut model = sharded::Model::new(sharded::Params::load(&mut cpu, &every_shard()).unwrap());
    let got = sharded::compute(
        &mut cpu,
        &Tensor::<i64, [sharded::BatchSize, sharded::SequenceLength]> { data: tokens, extents: tokens_extents },
        &Tensor::<i64, [sharded::BatchSize, sharded::SequenceLength]> { data: kept, extents: kept_extents },
        &mut model,
    );

    assert got.extents == want_extents;
    assert_close(&got.data, &want);
}

test "a sharded checkpoint reproduces the logits of the single file for four tokens" {
    reproduces(
        #include_bytes("../models/tiny-gpt2/test_data_set_0/input_0.pb"),
        #include_bytes("../models/tiny-gpt2/test_data_set_0/input_1.pb"),
        #include_bytes("../models/tiny-gpt2/test_data_set_0/output_0.pb"),
    );
}

test "and for seven" {
    reproduces(
        #include_bytes("../models/tiny-gpt2/test_data_set_1/input_0.pb"),
        #include_bytes("../models/tiny-gpt2/test_data_set_1/input_1.pb"),
        #include_bytes("../models/tiny-gpt2/test_data_set_1/output_0.pb"),
    );
}

test "a shard left out of the load is named before any weight is read" {
    let mut given = every_shard();
    given.remove("model-00003-of-00003.safetensors");
    let e = sharded::Params::load(&mut Cpu {}, &given).unwrap_err();
    assert `${e}` == "model-00003-of-00003.safetensors: not given";
}
