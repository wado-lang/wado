use { Case, program, read_after_program, expected } from "./generator.wado";
use { EvalError } from "core:eval";
use { eval } from "core:eval";

/// The first case whose part of `actual` differs from what it expects.
fn first_divergence(cases: &List<Case>, actual: &String) -> String {
    let mut prefix = String::new();
    for let i of 0..<cases.len() {
        let want = cases[i].expected(i);
        prefix.push_str(&want);
        if !actual.starts_with(&prefix) {
            return `${cases[i].label()}\nexpected:\n${want}actual:\n${actual}`;
        }
    }
    return "the outputs differ past the last case";
}

/// Cases per evaluated program: the compile of one holding them all runs past
/// `eval`'s time limit at `-O3`.
global CHUNK: i32 = 200;

test "every value drops once, where the model says" {
    let all = Case::all();
    for let start of (0..<all.len()).step_by(CHUNK) {
        let mut cases: List<Case> = [];
        for let i of start..<i32::min(start + CHUNK, all.len()) {
            cases.push(all[i]);
        }
        let source = program(&cases);
        let out = eval(source).unwrap();
        assert out.status matches { Exited(0) }, `${out.status:?}\n${out.stderr}\n${source}`;
        assert out.stdout == expected(&cases), first_divergence(&cases, &out.stdout);
    }
}

// One program per case: a rejection stops the whole program, so cases cannot
// share one. The producer does not decide whether the read is reachable after
// a move, so only one producer runs.
test "a read after a move is rejected, and only there" {
    for let case of Case::all() {
        if !(case.producer matches { Literal } && case.companion matches { None } && case.value matches { Tok }) {
            continue;
        }
        let result = eval(read_after_program(&case));
        if case.readable_after() {
            assert result matches { Ok(_) }, `${case.label()}: ${result:?}`;
        } else {
            let Err(EvalError::CompileFailed(failure)) = result else {
                panic(`${case.label()}: expected a rejection, got ${result:?}`);
            };
            assert failure.rendered.contains("affine value `t` used after it was moved"), `${case.label()}: ${failure.rendered}`;
        }
    }
}
