// gale-gen benchmark: `gale gen` throughput (grammar assembly + codegen) over
// the Rust grammar, as a byte rate over the input `.g4` size. Sources are
// embedded with `#include_str`, so no measured iteration touches the
// filesystem. The ANTLR4 reference over the same `.g4` (`antlr4_gen.mjs`) is a
// separate mise step.

use { Stdout } from "core:cli";
use { MonotonicClock } from "wasi:clocks";
use { Benchmark } from "core:benchmark";
use { measure } from "core:fuel";
use { assemble_grammar } from "../../package-gale/src/g4/parser.wado";
use { generate, GenerateOptions } from "../../package-gale/src/codegen.wado";
use { PredictionMode } from "../../package-gale/src/gen_settings.wado";

global RUST_LEXER: String = #include_str("../../package-gale/tests/grammars/RustLexer.g4");
global RUST_PARSER: String = #include_str("../../package-gale/tests/grammars/RustParser.g4");

fn gen(inputs: &List<[String, String]>) -> i32 {
    let mut grammar = match assemble_grammar(inputs) {
        Ok(g) => g,
        Err(_) => panic("gale-gen: assemble_grammar failed"),
    };
    let out = generate(&mut grammar, &GenerateOptions { prediction: PredictionMode::Longest });
    return out.source.len();
}

fn gen_rust() -> i32 {
    return gen(&[
        ["RustLexer.g4", RUST_LEXER],
        ["RustParser.g4", RUST_PARSER],
    ]);
}

#[workload]
test "workload" {
    assert gen(&[
        ["SQLite.g4", #include_str("../../package-gale/tests/grammars/SQLite.g4")],
    ]) > 0;
    assert gen(&[
        ["TypeScriptLexer.g4", #include_str("../../package-gale/tests/grammars/TypeScriptLexer.g4")],
        ["TypeScriptParser.g4", #include_str("../../package-gale/tests/grammars/TypeScriptParser.g4")],
    ]) > 0;
    assert gen(&[
        ["css3Lexer.g4", #include_str("../../package-gale/tests/grammars/css3Lexer.g4")],
        ["css3Parser.g4", #include_str("../../package-gale/tests/grammars/css3Parser.g4")],
    ]) > 0;
}

test "fuel" {
    assert measure("gale/generate", || gen_rust()) > 0;
}

export fn run() with (Stdout, MonotonicClock) {
    let mut b = Benchmark {
        name: "gale-gen (Rust)",
        input_size: Option::Some(RUST_LEXER.len() + RUST_PARSER.len()),
    };

    let last = b.run("", || gen_rust());
    assert last > 0;
}
