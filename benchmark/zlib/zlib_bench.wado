// zlib compression benchmark for Wado
// Compresses and decompresses twitter.json (~631KB). Each phase
// auto-calibrates its iteration count to run for about a second.
//
// How to run:
//   mise run benchmark-zlib
//
// Or manually (from benchmark/ directory):
//   cargo run --bin wado -- run -O2 --dir .::. zlib/zlib_bench.wado

use { Stdout } from "core:cli";
use { MonotonicClock } from "wasi:clocks";
use { zlib_compress, inflate_zlib } from "core:zlib";
use fs from "core:fs";
use { Preopens } from "wasi:filesystem";
use { Benchmark } from "core:benchmark";

test "smoke" {
    // Round-trip a tiny in-memory buffer; no Preopens needed.
    let data: ByteList = [
        72 as u8, 101 as u8, 108 as u8, 108 as u8, 111 as u8, 44 as u8, 32 as u8, 87 as u8, 111 as u8, 114 as u8,
        108 as u8, 100 as u8, 33 as u8,
    ];
    let compressed = zlib_compress(&data);
    let decompressed = inflate_zlib(&compressed).unwrap();
    assert decompressed.len() == data.len();
    for let mut i = 0; i < data.len(); i += 1 {
        assert decompressed[i] == data[i];
    }
}

export fn run() with (Stdout, MonotonicClock, Preopens) {
    let data = fs::read(&"json_twitter/twitter.json").unwrap();
    let mut b = Benchmark {
        name: "zlib",
        input_size: Option::Some(data.len()),
    };

    let compressed = b.run("compress", || zlib_compress(&data));
    let decompressed = b.run("decompress", || inflate_zlib(&compressed).unwrap());

    b.println(`compressed: ${data.len()} -> ${compressed.len()} bytes`);
    assert decompressed.len() == data.len(), "decompressed size mismatch";
}
