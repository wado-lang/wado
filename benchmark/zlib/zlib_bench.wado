// zlib compression benchmark for Wado
// Compresses and decompresses twitter.json (~631KB) x10 iterations
//
// How to run:
//   mise run benchmark-zlib
//
// Or manually (from benchmark/ directory):
//   cargo run --bin wado -- run -O2 --dir .::. zlib/zlib_bench.wado

use { Stdout } from "core:cli";
use { MonotonicClock } from "wasi:clocks";
use { zlib_compress, inflate_zlib } from "core:zlib";
use { Preopens, Filesize, PathFlags, OpenFlags, DescriptorFlags } from "wasi:filesystem";
use { Benchmark } from "core:benchmark";

fn read_file_bytes(path: String) -> Array<u8> with Preopens {
    let dirs = Preopens::get_directories();
    let root = dirs[0].0;
    let file = match root.open_at(PathFlags::none(), path, OpenFlags::none(), DescriptorFlags::Read).wait() {
        Ok(f) => f,
        Err(_) => panic(`failed to open {path}`),
    };
    let [stream, _done] = file.read_via_stream(0 as Filesize);
    let mut buf: Array<u8> = [];
    loop {
        let chunk = stream.read(65536);
        if chunk.len() == 0 {
            break;
        }
        for let mut i = 0; i < chunk.len(); i += 1 {
            buf.push(chunk[i]);
        }
    }
    stream.drop();
    return buf;
}

test "smoke" {
    // Round-trip a tiny in-memory buffer; no Preopens needed.
    let data: Array<u8> = [
        72 as u8, 101 as u8, 108 as u8, 108 as u8, 111 as u8,
        44 as u8, 32 as u8,
        87 as u8, 111 as u8, 114 as u8, 108 as u8, 100 as u8, 33 as u8,
    ];
    let compressed = zlib_compress(&data);
    let decompressed = inflate_zlib(&compressed).unwrap();
    assert decompressed.len() == data.len();
    for let mut i = 0; i < data.len(); i += 1 {
        assert decompressed[i] == data[i];
    }
}

export fn run() with Stdout, MonotonicClock, Preopens {
    let data = read_file_bytes("json_twitter/twitter.json");
    let mut b = Benchmark::new("zlib");
    b.iterations = 10;
    b.input_size = Option::Some(data.len());

    let compressed = b.run("compress", || zlib_compress(&data));
    let decompressed = b.run("decompress", || inflate_zlib(&compressed).unwrap());

    b.println(`compressed: {data.len()} -> {compressed.len()} bytes`);
    assert decompressed.len() == data.len(), "decompressed size mismatch";
}
