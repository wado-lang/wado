// Mandelbrot set benchmark for Wado
// Counts total iterations across a grid of points
// Real-world use case: fractal rendering, GPU benchmarks
//
// How to run:
//   mise run benchmark-mandelbrot
//
// Or manually:
//   cargo run --bin wado -- run benchmark/mandelbrot.wado

use { Stdout } from "core:cli";
use { MonotonicClock } from "wasi:clocks";
use { Benchmark } from "core:benchmark";

fn mandelbrot_iterations(cx: f64, cy: f64, max_iter: i32) -> i32 {
    let mut x = 0.0;
    let mut y = 0.0;
    let mut iter = 0;

    while iter < max_iter {
        let x2 = x * x;
        let y2 = y * y;

        if x2 + y2 > 4.0 {
            return iter;
        }

        let xy = x * y;
        x = x2 - y2 + cx;
        y = 2.0 * xy + cy;
        iter = iter + 1;
    }

    return max_iter;
}

fn mandelbrot_total(width: i32, height: i32, max_iter: i32) -> i32 {
    // Mandelbrot region: x in [-2.5, 1.0], y in [-1.0, 1.0]
    let x_min = -2.5;
    let x_max = 1.0;
    let y_min = -1.0;
    let y_max = 1.0;

    let dx = (x_max - x_min) / width as f64;
    let dy = (y_max - y_min) / height as f64;

    // Use i32 accumulator (max possible: 1024*768*256 = 201,326,592 fits in i32)
    let mut total = 0;
    let mut py = 0;
    while py < height {
        let cy = y_min + py as f64 * dy;
        let mut px = 0;
        while px < width {
            let cx = x_min + px as f64 * dx;
            total = total + mandelbrot_iterations(cx, cy, max_iter);
            px = px + 1;
        }
        py = py + 1;
    }
    return total;
}

test "smoke" {
    // tiny grid; verify the work runs and produces a sane non-zero count.
    let total = mandelbrot_total(32, 24, 32);
    assert total > 0;
}

export fn run() with Stdout, MonotonicClock {
    let width = 1024;
    let height = 768;
    let max_iter = 256;

    let mut b = Benchmark { name: `mandelbrot {width}x{height}, max_iter={max_iter}` };
    b.work_per_iter = Option::Some((width * height) as f64);
    b.unit = "px";
    let total = b.run("", || mandelbrot_total(width, height, max_iter));
    b.println(`total iterations = {total}`);
}
