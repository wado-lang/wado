// CBOR ser/de benchmark over twitter.json (core:cbor).
//
// The complete twitter.json schema (shared with the JSON benchmark, see
// `../json_twitter/twitter_schema.wado`) is modeled with typed structs, so
// every field is round-tripped. The JSON is parsed once into `TwitterResponse`
// (core:json), then encoded to a CBOR byte payload. Throughput is reported over
// the original JSON source size (shared denominator across implementations and
// with the JSON benchmark). Both phases operate on byte buffers:
//   ser: TwitterResponse -> CBOR bytes  (core:cbor to_bytes)
//   de:  CBOR bytes -> TwitterResponse  (core:cbor from_bytes)
//
// Data source: https://github.com/miloyip/nativejson-benchmark
// License: MIT

use { Stdout } from "core:cli";
use { from_bytes as json_from_bytes } from "core:json";
use { to_bytes as cbor_to_bytes, from_bytes as cbor_from_bytes } from "core:cbor";
use { TwitterResponse } from "../json_twitter/twitter_schema.wado";
use { MonotonicClock } from "wasi:clocks";
use { Preopens, Descriptor, Filesize, PathFlags, OpenFlags, DescriptorFlags } from "wasi:filesystem";
use { Benchmark } from "core:benchmark";

fn read_file_bytes(path: String) -> ByteList with Preopens {
    let dirs = Preopens::get_directories();
    let root = dirs[0].0;
    let open_result = root.open_at(PathFlags::none(), path, OpenFlags::none(), DescriptorFlags::Read).wait();
    if let Err(_) = open_result {
        panic(`failed to open {path}`);
    }
    let file = match open_result {
        Ok(f) => f,
        Err(_) => unreachable(),
    };
    let [stream, _done] = file.read_via_stream(0 as Filesize);
    let mut buf: List<u8> = [];
    loop {
        let chunk = stream.read(4096);
        if chunk.len() == 0 {
            break;
        }
        buf.extend(&chunk);
    }
    stream.drop();
    return buf as ByteList;
}

fn parse_twitter<B: AsByteSlice>(json_data: B) -> TwitterResponse {
    return match json_from_bytes::<TwitterResponse, B>(json_data) {
        Ok(r) => r,
        Err(e) => panic(`JSON parse error: {e.message}`),
    };
}

fn encode_cbor(resp: &TwitterResponse) -> ByteList {
    return match cbor_to_bytes::<TwitterResponse>(resp) {
        Ok(b) => b,
        Err(e) => panic(`CBOR encode error: {e.message}`),
    };
}

fn decode_cbor<S: AsByteSlice>(bytes: S) -> TwitterResponse {
    return match cbor_from_bytes::<TwitterResponse, S>(bytes) {
        Ok(r) => r,
        Err(e) => panic(`CBOR decode error: {e.message}`),
    };
}

test "smoke" {
    // Empty statuses keeps the input small while still exercising the round-trip.
    let json = "{\"statuses\":[],\"search_metadata\":{\"completed_in\":0.0,\"count\":0,\"max_id\":0,\"max_id_str\":\"0\",\"next_results\":\"\",\"query\":\"\",\"refresh_url\":\"\",\"since_id\":0,\"since_id_str\":\"0\"}}";
    let resp = parse_twitter(json);
    let cbor = encode_cbor(&resp);
    let back = decode_cbor(cbor);
    assert back.statuses.len() == 0;
    assert back.search_metadata.count == 0;
}

export fn run() with Stdout, MonotonicClock, Preopens {
    let json_data = read_file_bytes("json_twitter/twitter.json");
    let json_size = json_data.len();
    let resp = parse_twitter(json_data);

    // Encode once for the payload-size report and the decode input.
    let cbor = encode_cbor(&resp);

    let mut b = Benchmark {
        name: "cbor-twitter",
        input_size: Option::Some(json_size),
    };
    b.println(`{json_size} bytes JSON -> {cbor.len()} bytes CBOR payload`);

    b.run("ser", || encode_cbor(&resp).len());
    let count = b.run("de", || decode_cbor(cbor).statuses.len());
    assert count == 100;
    b.println(`round-tripped {count} total statuses`);
}
