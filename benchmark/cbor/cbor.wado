// CBOR ser/de benchmark over twitter.json (core:cbor).
//
// The complete twitter.json schema is modeled with typed structs (no dynamic
// value), so every field is round-tripped. The JSON is parsed once into
// `TwitterResponse` (core:json), then encoded to a CBOR byte payload. Throughput
// is reported over the original JSON source size (shared denominator across
// implementations). Both phases operate on byte buffers:
//   ser: TwitterResponse -> CBOR bytes  (core:cbor to_bytes)
//   de:  CBOR bytes -> TwitterResponse  (core:cbor from_bytes)
//
// Field names match the wire keys, so no `rename` is needed except for the
// reserved word `type`.
//
// Data source: https://github.com/miloyip/nativejson-benchmark
// License: MIT

use { Stdout } from "core:cli";
use { Serialize, Deserialize } from "core:serde";
use { from_bytes as json_from_bytes } from "core:json";
use { to_bytes as cbor_to_bytes, from_bytes as cbor_from_bytes } from "core:cbor";
use { MonotonicClock } from "wasi:clocks";
use { Preopens, Descriptor, Filesize, PathFlags, OpenFlags, DescriptorFlags } from "wasi:filesystem";
use { Benchmark } from "core:benchmark";

struct SearchMetadata {
    completed_in: f64,
    count: i32,
    max_id: i64,
    max_id_str: String,
    next_results: String,
    query: String,
    refresh_url: String,
    since_id: i64,
    since_id_str: String,
}
impl Serialize for SearchMetadata;
impl Deserialize for SearchMetadata;

struct Metadata {
    iso_language_code: String,
    result_type: String,
}
impl Serialize for Metadata;
impl Deserialize for Metadata;

struct Hashtag {
    text: String,
    indices: List<i32>,
}
impl Serialize for Hashtag;
impl Deserialize for Hashtag;

struct Url {
    url: String,
    expanded_url: String,
    display_url: String,
    indices: List<i32>,
}
impl Serialize for Url;
impl Deserialize for Url;

struct UserMention {
    screen_name: String,
    name: String,
    id: i64,
    id_str: String,
    indices: List<i32>,
}
impl Serialize for UserMention;
impl Deserialize for UserMention;

struct Size {
    w: i32,
    h: i32,
    resize: String,
}
impl Serialize for Size;
impl Deserialize for Size;

struct MediaSizes {
    large: Size,
    medium: Size,
    small: Size,
    thumb: Size,
}
impl Serialize for MediaSizes;
impl Deserialize for MediaSizes;

struct Media {
    id: i64,
    id_str: String,
    indices: List<i32>,
    media_url: String,
    media_url_https: String,
    url: String,
    display_url: String,
    expanded_url: String,
    #[serde(rename = "type")]
    kind: String,
    sizes: MediaSizes,
    #[serde(default)]
    source_status_id: Option<i64>,
    #[serde(default)]
    source_status_id_str: Option<String>,
}
impl Serialize for Media;
impl Deserialize for Media;

struct StatusEntities {
    hashtags: List<Hashtag>,
    symbols: List<String>,
    urls: List<Url>,
    user_mentions: List<UserMention>,
    #[serde(default)]
    media: List<Media>,
}
impl Serialize for StatusEntities;
impl Deserialize for StatusEntities;

struct UserEntityUrls {
    urls: List<Url>,
}
impl Serialize for UserEntityUrls;
impl Deserialize for UserEntityUrls;

struct UserEntities {
    description: UserEntityUrls,
    #[serde(default)]
    url: Option<UserEntityUrls>,
}
impl Serialize for UserEntities;
impl Deserialize for UserEntities;

struct User {
    id: i64,
    id_str: String,
    name: String,
    screen_name: String,
    location: String,
    description: String,
    url: Option<String>,
    entities: UserEntities,
    protected: bool,
    followers_count: i32,
    friends_count: i32,
    listed_count: i32,
    created_at: String,
    favourites_count: i32,
    utc_offset: Option<i32>,
    time_zone: Option<String>,
    geo_enabled: bool,
    verified: bool,
    statuses_count: i32,
    lang: String,
    contributors_enabled: bool,
    is_translator: bool,
    is_translation_enabled: bool,
    profile_background_color: String,
    profile_background_image_url: String,
    profile_background_image_url_https: String,
    profile_background_tile: bool,
    profile_image_url: String,
    profile_image_url_https: String,
    #[serde(default)]
    profile_banner_url: Option<String>,
    profile_link_color: String,
    profile_sidebar_border_color: String,
    profile_sidebar_fill_color: String,
    profile_text_color: String,
    profile_use_background_image: bool,
    default_profile: bool,
    default_profile_image: bool,
    following: bool,
    follow_request_sent: bool,
    notifications: bool,
}
impl Serialize for User;
impl Deserialize for User;

struct Status {
    metadata: Metadata,
    created_at: String,
    id: i64,
    id_str: String,
    text: String,
    source: String,
    truncated: bool,
    in_reply_to_status_id: Option<i64>,
    in_reply_to_status_id_str: Option<String>,
    in_reply_to_user_id: Option<i64>,
    in_reply_to_user_id_str: Option<String>,
    in_reply_to_screen_name: Option<String>,
    user: User,
    geo: Option<String>,
    coordinates: Option<String>,
    place: Option<String>,
    contributors: Option<String>,
    #[serde(default)]
    retweeted_status: Option<Status>,
    retweet_count: i32,
    favorite_count: i32,
    entities: StatusEntities,
    favorited: bool,
    retweeted: bool,
    #[serde(default)]
    possibly_sensitive: bool,
    lang: String,
}
impl Serialize for Status;
impl Deserialize for Status;

struct TwitterResponse {
    statuses: List<Status>,
    search_metadata: SearchMetadata,
}
impl Serialize for TwitterResponse;
impl Deserialize for TwitterResponse;

fn read_file_bytes(path: String) -> ByteList with Preopens {
    let dirs = Preopens::get_directories();
    let root = dirs[0].0;
    let open_result = root.open_at(PathFlags::none(), path, OpenFlags::none(), DescriptorFlags::Read).wait();
    if let Err(_) = open_result {
        panic(`failed to open {path}`);
    }
    let file = match open_result {
        Ok(f) => f,
        Err(_) => unreachable(),
    };
    let [stream, _done] = file.read_via_stream(0 as Filesize);
    let mut buf: List<u8> = [];
    loop {
        let chunk = stream.read(4096);
        if chunk.len() == 0 {
            break;
        }
        buf.extend(&chunk);
    }
    stream.drop();
    return buf as ByteList;
}

fn parse_twitter<B: AsByteSlice>(json_data: B) -> TwitterResponse {
    return match json_from_bytes::<TwitterResponse, B>(json_data) {
        Ok(r) => r,
        Err(e) => panic(`JSON parse error: {e.message}`),
    };
}

fn encode_cbor(resp: &TwitterResponse) -> ByteList {
    return match cbor_to_bytes::<TwitterResponse>(resp) {
        Ok(b) => b,
        Err(e) => panic(`CBOR encode error: {e.message}`),
    };
}

fn decode_cbor(bytes: ByteSlice) -> TwitterResponse {
    return match cbor_from_bytes::<TwitterResponse, ByteSlice>(bytes) {
        Ok(r) => r,
        Err(e) => panic(`CBOR decode error: {e.message}`),
    };
}

test "smoke" {
    // Empty statuses keeps the input small while still exercising the round-trip.
    let json = "{\"statuses\":[],\"search_metadata\":{\"completed_in\":0.0,\"count\":0,\"max_id\":0,\"max_id_str\":\"0\",\"next_results\":\"\",\"query\":\"\",\"refresh_url\":\"\",\"since_id\":0,\"since_id_str\":\"0\"}}";
    let resp = parse_twitter(json);
    let cbor = encode_cbor(&resp);
    let back = decode_cbor(cbor.as_byte_slice());
    assert back.statuses.len() == 0;
    assert back.search_metadata.count == 0;
}

export fn run() with Stdout, MonotonicClock, Preopens {
    let json_data = read_file_bytes("json_twitter/twitter.json");
    let json_size = json_data.len();
    let resp = parse_twitter(json_data);

    // Encode once for the payload-size report and the decode input.
    let cbor = encode_cbor(&resp);
    let cbor_view = cbor.as_byte_slice();

    let mut b = Benchmark {
        name: "cbor-twitter",
        input_size: Option::Some(json_size),
    };
    b.println(`{json_size} bytes JSON -> {cbor.len()} bytes CBOR payload`);

    b.run("ser", || encode_cbor(&resp).len());
    let count = b.run("de", || decode_cbor(cbor_view).statuses.len());
    assert count == 100;
    b.println(`round-tripped {count} total statuses`);
}
