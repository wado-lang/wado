// CBOR ser/de benchmark over citm_catalog.json (core:cbor).
//
// The full citm_catalog.json schema (shared with the JSON benchmark, see
// `../json_catalog/catalog_schema.wado`) is modeled, so every field
// round-trips. The JSON is parsed once into `CitmCatalog` (core:json), then
// encoded to a CBOR byte payload. Throughput is reported over the original JSON
// source size (shared denominator with the JSON benchmark). Both phases operate
// on byte buffers:
//   ser: CitmCatalog -> CBOR bytes  (core:cbor to_bytes)
//   de:  CBOR bytes -> CitmCatalog  (core:cbor from_bytes)
//
// Data source: https://github.com/miloyip/nativejson-benchmark
// License: MIT

use { Stdout } from "core:cli";
use { from_bytes as json_from_bytes } from "core:json";
use { to_bytes as cbor_to_bytes, from_bytes as cbor_from_bytes } from "core:cbor";
use { CitmCatalog, event_count, performance_count } from "../json_catalog/catalog_schema.wado";
use { MonotonicClock } from "wasi:clocks";
use { Preopens, Descriptor, Filesize, PathFlags, OpenFlags, DescriptorFlags } from "wasi:filesystem";
use { Benchmark } from "core:benchmark";

fn read_file_bytes(path: String) -> ByteList with Preopens {
    let dirs = Preopens::get_directories();
    let root = dirs[0].0;
    let open_result = root.open_at(PathFlags::none(), path, OpenFlags::none(), DescriptorFlags::Read).wait();
    if let Err(_) = open_result {
        panic(`failed to open {path}`);
    }
    let file = match open_result {
        Ok(f) => f,
        Err(_) => unreachable(),
    };
    let [stream, _done] = file.read_via_stream(0 as Filesize);
    let mut buf: List<u8> = [];
    loop {
        let chunk = stream.read(4096);
        if chunk.len() == 0 {
            break;
        }
        buf.extend(&chunk);
    }
    stream.drop();
    return buf as ByteList;
}

fn parse_catalog<B: AsByteSlice>(json_data: B) -> CitmCatalog {
    return match json_from_bytes::<CitmCatalog, B>(json_data) {
        Ok(c) => c,
        Err(e) => panic(`JSON parse error: {e.message}`),
    };
}

fn encode_cbor(catalog: &CitmCatalog) -> ByteList {
    return match cbor_to_bytes::<CitmCatalog>(catalog) {
        Ok(b) => b,
        Err(e) => panic(`CBOR encode error: {e.message}`),
    };
}

fn decode_cbor(bytes: ByteSlice) -> CitmCatalog {
    return match cbor_from_bytes::<CitmCatalog, ByteSlice>(bytes) {
        Ok(c) => c,
        Err(e) => panic(`CBOR decode error: {e.message}`),
    };
}

test "smoke" {
    let catalog = parse_catalog(
        "{\"areaNames\":{},\"audienceSubCategoryNames\":{},\"blockNames\":{},\"events\":{},\"performances\":[],\"seatCategoryNames\":{},\"subTopicNames\":{},\"subjectNames\":{},\"topicNames\":{},\"topicSubTopics\":{},\"venueNames\":{}}",
    );
    let cbor = encode_cbor(&catalog);
    let back = decode_cbor(cbor.as_byte_slice());
    assert event_count(&back) == 0;
}

export fn run() with Stdout, MonotonicClock, Preopens {
    let json_data = read_file_bytes("json_catalog/citm_catalog.json");
    let json_size = json_data.len();
    let catalog = parse_catalog(json_data);

    assert performance_count(&catalog) == 243;

    let cbor = encode_cbor(&catalog);
    let cbor_view = cbor.as_byte_slice();

    let mut b = Benchmark {
        name: "cbor-catalog",
        input_size: Option::Some(json_size),
    };
    b.println(`{json_size} bytes JSON -> {cbor.len()} bytes CBOR payload`);

    b.run("ser", || encode_cbor(&catalog).len());
    let events = b.run("de", || event_count(&decode_cbor(cbor_view)));
    assert events == 184;
    b.println(`round-tripped {events} events`);
}
