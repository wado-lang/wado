// CBOR ser/de benchmark over canada.json (core:cbor).
//
// The full canada.json schema (shared with the JSON benchmark, see
// `../json_canada/canada_schema.wado`) is modeled, so every field round-trips.
// The JSON is parsed once into `FeatureCollection` (core:json), then encoded to
// a CBOR byte payload. Throughput is reported over the original JSON source size
// (shared denominator with the JSON benchmark). Both phases operate on byte
// buffers:
//   ser: FeatureCollection -> CBOR bytes  (core:cbor to_bytes)
//   de:  CBOR bytes -> FeatureCollection  (core:cbor from_bytes)
//
// Data source: https://github.com/miloyip/nativejson-benchmark
// License: MIT

use { Stdout } from "core:cli";
use { from_bytes as json_from_bytes } from "core:json";
use { to_bytes as cbor_to_bytes, from_bytes as cbor_from_bytes } from "core:cbor";
use { FeatureCollection, count_points } from "../json_canada/canada_schema.wado";
use { MonotonicClock } from "wasi:clocks";
use fs from "core:fs";
use { Preopens } from "wasi:filesystem";
use { Benchmark } from "core:benchmark";

test "smoke" {
    let fc = json_from_bytes::<FeatureCollection, _>(
        "{\"type\":\"FeatureCollection\",\"features\":[{\"type\":\"Feature\",\"properties\":{\"name\":\"x\"},\"geometry\":{\"type\":\"Polygon\",\"coordinates\":[[[0.0,0.0],[1.0,1.0]]]}}]}",
    ).unwrap();
    let cbor = cbor_to_bytes::<FeatureCollection>(&fc).unwrap();
    let back = cbor_from_bytes::<FeatureCollection, _>(cbor).unwrap();
    assert count_points(&back) == 2;
}

export fn run() with (Stdout, MonotonicClock, Preopens) {
    let json_data = fs::read(&"json_canada/canada.json").unwrap();
    let json_size = json_data.len();
    let fc = json_from_bytes::<FeatureCollection, _>(json_data).unwrap();

    let cbor = cbor_to_bytes::<FeatureCollection>(&fc).unwrap();

    let mut b = Benchmark {
        name: "cbor-canada",
        input_size: Option::Some(json_size),
    };
    b.println(`${json_size} bytes JSON -> ${cbor.len()} bytes CBOR payload`);

    b.run("ser", || cbor_to_bytes::<FeatureCollection>(&fc).unwrap().len());
    let total_points = b.run("de", || count_points(&cbor_from_bytes::<FeatureCollection, _>(cbor).unwrap()));
    assert total_points == 55563;
    b.println(`round-tripped ${total_points} coordinate points`);
}
