// CBOR ser/de benchmark over canada.json (core:cbor).
//
// The full canada.json schema (shared with the JSON benchmark, see
// `../json_canada/canada_schema.wado`) is modeled, so every field round-trips.
// The JSON is parsed once into `FeatureCollection` (core:json), then encoded to
// a CBOR byte payload. Throughput is reported over the original JSON source size
// (shared denominator with the JSON benchmark). Both phases operate on byte
// buffers:
//   ser: FeatureCollection -> CBOR bytes  (core:cbor to_bytes)
//   de:  CBOR bytes -> FeatureCollection  (core:cbor from_bytes)
//
// Data source: https://github.com/miloyip/nativejson-benchmark
// License: MIT

use { Stdout } from "core:cli";
use { from_bytes as json_from_bytes } from "core:json";
use { to_bytes as cbor_to_bytes, from_bytes as cbor_from_bytes } from "core:cbor";
use { FeatureCollection, count_points } from "../json_canada/canada_schema.wado";
use { MonotonicClock } from "wasi:clocks";
use { Preopens, Descriptor, Filesize, PathFlags, OpenFlags, DescriptorFlags } from "wasi:filesystem";
use { Benchmark } from "core:benchmark";

fn read_file_bytes(path: String) -> ByteList with Preopens {
    let dirs = Preopens::get_directories();
    let root = dirs[0].0;
    let open_result = root.open_at(PathFlags::none(), path, OpenFlags::none(), DescriptorFlags::Read).wait();
    if let Err(_) = open_result {
        panic(`failed to open {path}`);
    }
    let file = match open_result {
        Ok(f) => f,
        Err(_) => unreachable(),
    };
    let [stream, _done] = file.read_via_stream(0 as Filesize);
    let mut buf: List<u8> = [];
    loop {
        let chunk = stream.read(65536);
        if chunk.len() == 0 {
            break;
        }
        buf.extend(&chunk);
    }
    stream.drop();
    return buf as ByteList;
}

fn parse_canada<B: AsByteSlice>(json_data: B) -> FeatureCollection {
    return match json_from_bytes::<FeatureCollection, B>(json_data) {
        Ok(fc) => fc,
        Err(e) => panic(`JSON parse error: {e.message}`),
    };
}

fn encode_cbor(fc: &FeatureCollection) -> ByteList {
    return match cbor_to_bytes::<FeatureCollection>(fc) {
        Ok(b) => b,
        Err(e) => panic(`CBOR encode error: {e.message}`),
    };
}

fn decode_cbor<S: AsByteSlice>(bytes: S) -> FeatureCollection {
    return match cbor_from_bytes::<FeatureCollection, S>(bytes) {
        Ok(fc) => fc,
        Err(e) => panic(`CBOR decode error: {e.message}`),
    };
}

test "smoke" {
    let fc = parse_canada(
        "{\"type\":\"FeatureCollection\",\"features\":[{\"type\":\"Feature\",\"properties\":{\"name\":\"x\"},\"geometry\":{\"type\":\"Polygon\",\"coordinates\":[[[0.0,0.0],[1.0,1.0]]]}}]}",
    );
    let cbor = encode_cbor(&fc);
    let back = decode_cbor(cbor);
    assert count_points(&back) == 2;
}

export fn run() with Stdout, MonotonicClock, Preopens {
    let json_data = read_file_bytes("json_canada/canada.json");
    let json_size = json_data.len();
    let fc = parse_canada(json_data);

    let cbor = encode_cbor(&fc);

    let mut b = Benchmark {
        name: "cbor-canada",
        input_size: Option::Some(json_size),
    };
    b.println(`{json_size} bytes JSON -> {cbor.len()} bytes CBOR payload`);

    b.run("ser", || encode_cbor(&fc).len());
    let total_points = b.run("de", || count_points(&decode_cbor(cbor)));
    assert total_points == 55563;
    b.println(`round-tripped {total_points} coordinate points`);
}
