// JSON ser/de benchmark over twitter.json (core:json).
//
// The complete twitter.json schema (shared with the CBOR benchmark, see
// `twitter_schema.wado`) is modeled with typed structs, so every field is
// round-tripped. Both phases operate on byte buffers:
//   ser: TwitterResponse -> JSON bytes  (core:json to_bytes)
//   de:  JSON bytes -> TwitterResponse  (core:json from_bytes)
// Throughput is reported over the original JSON source size (shared denominator
// across implementations and with the CBOR benchmark).
//
// Data source: https://github.com/miloyip/nativejson-benchmark
// License: MIT

use { Stdout } from "core:cli";
use { to_bytes, from_bytes } from "core:json";
use { TwitterResponse } from "./twitter_schema.wado";
use { MonotonicClock } from "wasi:clocks";
use fs from "core:fs";
use { Preopens } from "wasi:filesystem";
use { Benchmark } from "core:benchmark";

test "smoke" {
    // Empty statuses keeps the input small while still exercising the round-trip.
    let json = "{\"statuses\":[],\"search_metadata\":{\"completed_in\":0.0,\"count\":0,\"max_id\":0,\"max_id_str\":\"0\",\"next_results\":\"\",\"query\":\"\",\"refresh_url\":\"\",\"since_id\":0,\"since_id_str\":\"0\"}}";
    let resp = from_bytes::<TwitterResponse, _>(json).unwrap();
    let bytes = to_bytes::<TwitterResponse>(&resp).unwrap();
    let back = from_bytes::<TwitterResponse, _>(bytes).unwrap();
    assert back.statuses.len() == 0;
    assert back.search_metadata.count == 0;
}

export fn run() with (Stdout, MonotonicClock, Preopens) {
    let json_data = fs::read(&"json_twitter/twitter.json").unwrap();
    let json_size = json_data.len();
    let resp = from_bytes::<TwitterResponse, _>(json_data).unwrap();

    let mut b = Benchmark {
        name: "json-twitter",
        input_size: Option::Some(json_size),
    };

    b.run("ser", || to_bytes::<TwitterResponse>(&resp).unwrap().len());
    let count = b.run("de", || from_bytes::<TwitterResponse, _>(json_data).unwrap().statuses.len());
    assert count == 100;
    b.println(`round-tripped ${count} total statuses`);
}
