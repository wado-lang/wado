// Shared twitter.json schema for the serde benchmarks.
//
// The complete twitter.json schema is modeled with typed structs (no dynamic
// value), so every field is round-tripped. Both the JSON (`json_twitter.wado`)
// and CBOR (`cbor/cbor_twitter.wado`) benchmarks import these types, so the two codecs
// are compared over identical data types.
//
// Field names match the wire keys, so no `rename` is needed (`type` is a
// contextual keyword and works directly as a field name).
//
// Data source: https://github.com/miloyip/nativejson-benchmark
// License: MIT

use { Serialize, Deserialize } from "core:serde";

pub struct SearchMetadata {
    pub completed_in: f64,
    pub count: i32,
    pub max_id: i64,
    pub max_id_str: String,
    pub next_results: String,
    pub query: String,
    pub refresh_url: String,
    pub since_id: i64,
    pub since_id_str: String,
}
impl Serialize for SearchMetadata;
impl Deserialize for SearchMetadata;

pub struct Metadata {
    pub iso_language_code: String,
    pub result_type: String,
}
impl Serialize for Metadata;
impl Deserialize for Metadata;

pub struct Hashtag {
    pub text: String,
    pub indices: List<i32>,
}
impl Serialize for Hashtag;
impl Deserialize for Hashtag;

pub struct Url {
    pub url: String,
    pub expanded_url: String,
    pub display_url: String,
    pub indices: List<i32>,
}
impl Serialize for Url;
impl Deserialize for Url;

pub struct UserMention {
    pub screen_name: String,
    pub name: String,
    pub id: i64,
    pub id_str: String,
    pub indices: List<i32>,
}
impl Serialize for UserMention;
impl Deserialize for UserMention;

pub struct Size {
    pub w: i32,
    pub h: i32,
    pub resize: String,
}
impl Serialize for Size;
impl Deserialize for Size;

pub struct MediaSizes {
    pub large: Size,
    pub medium: Size,
    pub small: Size,
    pub thumb: Size,
}
impl Serialize for MediaSizes;
impl Deserialize for MediaSizes;

pub struct Media {
    pub id: i64,
    pub id_str: String,
    pub indices: List<i32>,
    pub media_url: String,
    pub media_url_https: String,
    pub url: String,
    pub display_url: String,
    pub expanded_url: String,
    pub type: String,
    pub sizes: MediaSizes,
    pub source_status_id: Option<i64> = null,
    pub source_status_id_str: Option<String> = null,
}
impl Serialize for Media;
impl Deserialize for Media;

pub struct StatusEntities {
    pub hashtags: List<Hashtag>,
    pub symbols: List<String>,
    pub urls: List<Url>,
    pub user_mentions: List<UserMention>,
    pub media: List<Media> = [],
}
impl Serialize for StatusEntities;
impl Deserialize for StatusEntities;

pub struct UserEntityUrls {
    pub urls: List<Url>,
}
impl Serialize for UserEntityUrls;
impl Deserialize for UserEntityUrls;

pub struct UserEntities {
    pub description: UserEntityUrls,
    pub url: Option<UserEntityUrls> = null,
}
impl Serialize for UserEntities;
impl Deserialize for UserEntities;

pub struct User {
    pub id: i64,
    pub id_str: String,
    pub name: String,
    pub screen_name: String,
    pub location: String,
    pub description: String,
    pub url: Option<String>,
    pub entities: UserEntities,
    pub protected: bool,
    pub followers_count: i32,
    pub friends_count: i32,
    pub listed_count: i32,
    pub created_at: String,
    pub favourites_count: i32,
    pub utc_offset: Option<i32>,
    pub time_zone: Option<String>,
    pub geo_enabled: bool,
    pub verified: bool,
    pub statuses_count: i32,
    pub lang: String,
    pub contributors_enabled: bool,
    pub is_translator: bool,
    pub is_translation_enabled: bool,
    pub profile_background_color: String,
    pub profile_background_image_url: String,
    pub profile_background_image_url_https: String,
    pub profile_background_tile: bool,
    pub profile_image_url: String,
    pub profile_image_url_https: String,
    pub profile_banner_url: Option<String> = null,
    pub profile_link_color: String,
    pub profile_sidebar_border_color: String,
    pub profile_sidebar_fill_color: String,
    pub profile_text_color: String,
    pub profile_use_background_image: bool,
    pub default_profile: bool,
    pub default_profile_image: bool,
    pub following: bool,
    pub follow_request_sent: bool,
    pub notifications: bool,
}
impl Serialize for User;
impl Deserialize for User;

pub struct Status {
    pub metadata: Metadata,
    pub created_at: String,
    pub id: i64,
    pub id_str: String,
    pub text: String,
    pub source: String,
    pub truncated: bool,
    pub in_reply_to_status_id: Option<i64>,
    pub in_reply_to_status_id_str: Option<String>,
    pub in_reply_to_user_id: Option<i64>,
    pub in_reply_to_user_id_str: Option<String>,
    pub in_reply_to_screen_name: Option<String>,
    pub user: User,
    pub geo: Option<String>,
    pub coordinates: Option<String>,
    pub place: Option<String>,
    pub contributors: Option<String>,
    pub retweeted_status: Option<Status> = null,
    pub retweet_count: i32,
    pub favorite_count: i32,
    pub entities: StatusEntities,
    pub favorited: bool,
    pub retweeted: bool,
    pub possibly_sensitive: bool = false,
    pub lang: String,
}
impl Serialize for Status;
impl Deserialize for Status;

pub struct TwitterResponse {
    pub statuses: List<Status>,
    pub search_metadata: SearchMetadata,
}
impl Serialize for TwitterResponse;
impl Deserialize for TwitterResponse;
