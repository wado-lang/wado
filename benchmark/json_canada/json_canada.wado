// JSON ser/de benchmark: canada.json
// Data source: https://github.com/miloyip/nativejson-benchmark
// License: MIT
//
// The full schema (shared with the CBOR benchmark, see `canada_schema.wado`)
// is modeled, so every field round-trips. Both phases operate on byte buffers,
// reported over the JSON source size:
//   ser: FeatureCollection -> JSON bytes  (core:json to_bytes)
//   de:  JSON bytes -> FeatureCollection  (core:json from_bytes)

use { Stdout } from "core:cli";
use { to_bytes, from_bytes } from "core:json";
use { FeatureCollection, count_points } from "./canada_schema.wado";
use { MonotonicClock } from "wasi:clocks";
use { Preopens, Descriptor, Filesize, PathFlags, OpenFlags, DescriptorFlags } from "wasi:filesystem";
use { Benchmark } from "core:benchmark";

fn read_file_bytes(path: String) -> ByteList with Preopens {
    let dirs = Preopens::get_directories();
    let root = dirs[0].0;
    let open_result = root.open_at(PathFlags::none(), path, OpenFlags::none(), DescriptorFlags::Read).wait();
    if let Err(_) = open_result {
        panic(`failed to open {path}`);
    }
    let file = match open_result {
        Ok(f) => f,
        Err(_) => unreachable(),
    };
    let [stream, _done] = file.read_via_stream(0 as Filesize);
    let mut buf: List<u8> = [];
    loop {
        let chunk = stream.read(65536);
        if chunk.len() == 0 {
            break;
        }
        buf.extend(&chunk);
    }
    stream.drop();
    return buf as ByteList;
}

fn parse_canada<B: AsByteSlice>(json_data: B) -> FeatureCollection {
    return match from_bytes::<FeatureCollection, B>(json_data) {
        Ok(fc) => fc,
        Err(e) => panic(`JSON parse error: {e.message}`),
    };
}

fn encode_json(fc: &FeatureCollection) -> ByteList {
    return match to_bytes::<FeatureCollection>(fc) {
        Ok(b) => b as ByteList,
        Err(e) => panic(`JSON encode error: {e.message}`),
    };
}

test "smoke" {
    // Tiny GeoJSON FeatureCollection with one feature, two coordinates.
    let fc = parse_canada(
        "{\"type\":\"FeatureCollection\",\"features\":[{\"type\":\"Feature\",\"properties\":{\"name\":\"x\"},\"geometry\":{\"type\":\"Polygon\",\"coordinates\":[[[0.0,0.0],[1.0,1.0]]]}}]}",
    );
    let bytes = encode_json(&fc);
    let back = parse_canada(bytes.as_byte_slice());
    assert count_points(&back) == 2;
}

export fn run() with Stdout, MonotonicClock, Preopens {
    let json_data = read_file_bytes("json_canada/canada.json");
    let json_size = json_data.len();
    let fc = parse_canada(json_data);

    let mut b = Benchmark {
        name: "json-canada",
        input_size: Option::Some(json_size),
    };

    b.run("ser", || encode_json(&fc).len());
    let total_points = b.run("de", || count_points(&parse_canada(json_data.as_byte_slice())));
    assert total_points == 55563;
    b.println(`round-tripped {total_points} coordinate points`);
}
