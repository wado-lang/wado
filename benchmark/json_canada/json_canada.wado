// JSON benchmark: canada.json
// Data source: https://github.com/miloyip/nativejson-benchmark
// License: MIT
//
// Parses a GeoJSON FeatureCollection with 480 polygon rings and 55,563 coordinate points.

use { Stdout } from "core:cli";
use { Serialize, Deserialize } from "core:serde";
use { from_string } from "core:json";
use { MonotonicClock } from "wasi:clocks";
use { Preopens, Descriptor, Filesize, PathFlags, OpenFlags, DescriptorFlags } from "wasi:filesystem";
use { Benchmark } from "core:benchmark";

struct Properties {
    name: String,
}
impl Deserialize for Properties;

struct Geometry {
    #[serde(rename = "type")]
    geom_type: String,
    coordinates: Array<Array<Array<f64>>>,
}
impl Deserialize for Geometry;

struct Feature {
    #[serde(rename = "type")]
    feat_type: String,
    properties: Properties,
    geometry: Geometry,
}
impl Deserialize for Feature;

struct FeatureCollection {
    #[serde(rename = "type")]
    collection_type: String,
    features: Array<Feature>,
}
impl Deserialize for FeatureCollection;

fn read_file(path: String) -> String with Preopens {
    let dirs = Preopens::get_directories();
    let root = dirs[0].0;
    let open_result = root.open_at(PathFlags::none(), path, OpenFlags::none(), DescriptorFlags::Read).wait();
    if let Err(_) = open_result {
        panic(`failed to open {path}`);
    }
    let file = match open_result {
        Ok(f) => f,
        Err(_) => unreachable(),
    };
    let [stream, _done] = file.read_via_stream(0 as Filesize);
    let mut buf = String::with_capacity(3 * 1024 * 1024);
    loop {
        let chunk = stream.read(4096);
        if chunk.len() == 0 {
            break;
        }
        let start = buf.internal_reserve_uninit(chunk.len());
        for let mut i = 0; i < chunk.len(); i += 1 {
            buf.set_byte(start + i, chunk[i]);
        }
    }
    stream.drop();
    return buf;
}

test "benchmark" {
    run();
}

fn count_points(json_data: String) -> i32 {
    let fc = match from_string::<FeatureCollection>(json_data) {
        Ok(fc) => fc,
        Err(e) => panic(`Parse error: {e.message}`),
    };
    let mut total = 0;
    for let feat of fc.features {
        for let ring of feat.geometry.coordinates {
            total = total + ring.len();
        }
    }
    return total;
}

export fn run() with Stdout, MonotonicClock, Preopens {
    let json_data = read_file("json_canada/canada.json");
    let mut b = Benchmark::new("json-canada");
    b.input_size = Option::Some(json_data.len());

    let total_points = b.run("", || count_points(json_data));
    assert total_points == 55563;
    b.println(`parsed {total_points} coordinate points`);
}
