// Prime counting benchmark for Wado
// Counts primes up to LIMIT using trial division
// Reference: π(1,000,000) = 78,498
//
// How to run:
//   mise run benchmark-count-prime
//
// Or manually:
//   cargo run --bin wado -- run benchmark/count_prime.wado

use { println, Stdout } from "core:cli";
use { MonotonicClock } from "wasi:clocks";

fn is_prime(n: i32) -> bool {
    if n < 2 {
        return false;
    }
    let mut d = 2;
    while d * d <= n {
        if n % d == 0 {
            return false;
        }
        d += 1;
    }
    return true;
}

fn count_primes(limit: i32) -> i32 {
    let mut count = 0;
    let mut n = 2;
    while n <= limit {
        if is_prime(n) {
            count += 1;
        }
        n += 1;
    }
    return count;
}

test "benchmark" {
    run();
}

export fn run() with Stdout, MonotonicClock {
    let limit = 10000000;

    let start = MonotonicClock::now();
    let count = count_primes(limit);
    let end = MonotonicClock::now();

    let elapsed_ns = (end - start) as u64;
    // Convert nanoseconds to milliseconds (integer division)
    let elapsed_ms = elapsed_ns / 1000000;

    println(`Prime count up to {limit}: {count}`);
    println(`Elapsed: {elapsed_ms} ms`);
}
