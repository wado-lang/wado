// Sieve of Eratosthenes benchmark for Wado
// Counts primes up to LIMIT using the sieve algorithm
// Reference: π(10,000,000) = 664,579
//
// How to run:
//   make benchmark-sieve
//
// Or manually:
//   cargo run --bin wado -- run benchmark/sieve.wado

use { println, Stdout } from "core:cli";
use { MonotonicClock } from "wasi:clocks";

fn sieve_count(limit: i32) -> i32 {
    // Pre-allocate sieve array filled with true
    let mut is_prime = Array::<bool>::filled(limit + 1, true);

    // 0 and 1 are not prime
    is_prime[0] = false;
    is_prime[1] = false;

    // Sieve: mark multiples of each prime as not prime
    let mut p = 2;
    while p * p <= limit {
        if is_prime[p] {
            // Mark all multiples of p starting from p*p
            for let mut multiple = p * p; multiple <= limit; multiple += p {
                is_prime[multiple] = false;
            }
        }
        p += 1;
    }

    // Count primes
    let mut count = 0;
    for let mut n = 0; n <= limit; n += 1 {
        if is_prime[n] { count += 1 }
    }

    return count;
}

test "sieve_count" {
    assert sieve_count(10) == 4;  // 2, 3, 5, 7
    assert sieve_count(100) == 25;
    assert sieve_count(1000) == 168;
}

export fn run() with Stdout, MonotonicClock {
    let limit = 10000000;

    let start = MonotonicClock::now();
    let count = sieve_count(limit);
    let end = MonotonicClock::now();

    let elapsed_ns = (end - start) as u64;
    // Convert nanoseconds to milliseconds (integer division)
    let elapsed_ms = elapsed_ns / 1000000;

    println(`Sieve prime count up to {limit}: {count}`);
    println(`Elapsed: {elapsed_ms} ms`);
}
