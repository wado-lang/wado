// JSON ser/de benchmark: citm_catalog.json
// Data source: https://github.com/miloyip/nativejson-benchmark
// License: MIT
//
// The full schema (shared with the CBOR benchmark, see `catalog_schema.wado`)
// is modeled, so every field round-trips. Both phases operate on byte buffers,
// reported over the JSON source size:
//   ser: CitmCatalog -> JSON bytes  (core:json to_bytes)
//   de:  JSON bytes -> CitmCatalog  (core:json from_bytes)

use { Stdout } from "core:cli";
use { to_bytes, from_bytes } from "core:json";
use { CitmCatalog, event_count, performance_count } from "./catalog_schema.wado";
use { MonotonicClock } from "wasi:clocks";
use { Preopens, Descriptor, Filesize, PathFlags, OpenFlags, DescriptorFlags } from "wasi:filesystem";
use { Benchmark } from "core:benchmark";

fn read_file_bytes(path: String) -> ByteList with Preopens {
    let dirs = Preopens::get_directories();
    let root = dirs[0].0;
    let open_result = root.open_at(PathFlags::none(), path, OpenFlags::none(), DescriptorFlags::Read).wait();
    if let Err(_) = open_result {
        panic(`failed to open ${path}`);
    }
    let file = match open_result {
        Ok(f) => f,
        Err(_) => unreachable(),
    };
    let [stream, _done] = file.read_via_stream(0 as Filesize);
    let mut buf: List<u8> = [];
    loop {
        let chunk = stream.read(4096);
        if chunk.len() == 0 {
            break;
        }
        buf.extend(&chunk);
    }
    stream.drop();
    return buf as ByteList;
}

test "smoke" {
    // Minimal valid CitmCatalog with empty maps and no events / performances.
    let catalog = from_bytes::<CitmCatalog, _>(
        "{\"areaNames\":{},\"audienceSubCategoryNames\":{},\"blockNames\":{},\"events\":{},\"performances\":[],\"seatCategoryNames\":{},\"subTopicNames\":{},\"subjectNames\":{},\"topicNames\":{},\"topicSubTopics\":{},\"venueNames\":{}}",
    ).unwrap();
    let bytes = to_bytes::<CitmCatalog>(&catalog).unwrap();
    let back = from_bytes::<CitmCatalog, _>(bytes).unwrap();
    assert event_count(&back) == 0;
}

export fn run() with Stdout, MonotonicClock, Preopens {
    let json_data = read_file_bytes("json_catalog/citm_catalog.json");
    let json_size = json_data.len();
    let catalog = from_bytes::<CitmCatalog, _>(json_data).unwrap();

    let mut b = Benchmark {
        name: "json-catalog",
        input_size: Option::Some(json_size),
    };

    assert performance_count(&catalog) == 243;

    b.run("ser", || to_bytes::<CitmCatalog>(&catalog).unwrap().len());
    let events = b.run("de", || event_count(&from_bytes::<CitmCatalog, _>(json_data).unwrap()));
    assert events == 184;
    b.println(`round-tripped ${events} events`);
}
