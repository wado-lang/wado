// Shared citm_catalog.json schema for the serde benchmarks.
//
// A CITM catalog with events, performances, and seat categories. The full
// schema is modeled, so every field round-trips. Both the JSON
// (`json_catalog.wado`) and CBOR (`../cbor/cbor_catalog.wado`) benchmarks
// import these types, so the two codecs are compared over identical data types.
//
// The wire keys are camelCase, so `rename_all = "camelCase"` maps every
// snake_case field name without per-field `rename` attributes.
//
// Data source: https://github.com/miloyip/nativejson-benchmark
// License: MIT

use { Serialize, Deserialize } from "core:serde";
use { TreeMap } from "core:collections";

#[wire(name_policy = "camelCase")]
pub struct Event {
    description: Option<String> = null,
    id: i64,
    logo: Option<String> = null,
    name: String,
    sub_topic_ids: List<i64>,
    subject_code: Option<String> = null,
    subtitle: Option<String> = null,
    topic_ids: List<i64>,
}
impl Serialize for Event;
impl Deserialize for Event;

#[wire(name_policy = "camelCase")]
pub struct Price {
    amount: i64,
    audience_sub_category_id: i64,
    seat_category_id: i64,
}
impl Serialize for Price;
impl Deserialize for Price;

#[wire(name_policy = "camelCase")]
pub struct Area {
    area_id: i64,
    block_ids: List<i64>,
}
impl Serialize for Area;
impl Deserialize for Area;

#[wire(name_policy = "camelCase")]
pub struct SeatCategory {
    areas: List<Area>,
    seat_category_id: i64,
}
impl Serialize for SeatCategory;
impl Deserialize for SeatCategory;

#[wire(name_policy = "camelCase")]
pub struct Performance {
    event_id: i64,
    id: i64,
    logo: Option<String> = null,
    name: Option<String> = null,
    prices: List<Price>,
    seat_categories: List<SeatCategory>,
    seat_map_image: Option<String> = null,
    start: i64,
    venue_code: String,
}
impl Serialize for Performance;
impl Deserialize for Performance;

#[wire(name_policy = "camelCase")]
pub struct CitmCatalog {
    area_names: TreeMap<String, String>,
    audience_sub_category_names: TreeMap<String, String>,
    block_names: TreeMap<String, String>,
    events: TreeMap<String, Event>,
    performances: List<Performance>,
    seat_category_names: TreeMap<String, String>,
    sub_topic_names: TreeMap<String, String>,
    subject_names: TreeMap<String, String>,
    topic_names: TreeMap<String, String>,
    topic_sub_topics: TreeMap<String, List<i64>>,
    venue_names: TreeMap<String, String>,
}
impl Serialize for CitmCatalog;
impl Deserialize for CitmCatalog;

pub fn event_count(catalog: &CitmCatalog) -> i32 {
    return catalog.events.len();
}

pub fn performance_count(catalog: &CitmCatalog) -> i32 {
    return catalog.performances.len();
}
