// SQLite parser benchmark: Gale-generated parser (from SQLite.g4)
//
// Parses a collection of realistic SQLite statements repeatedly and measures throughput.

use { Stdout } from "core:cli";
use { MonotonicClock } from "wasi:clocks";
use { Preopens, Descriptor, Filesize, PathFlags, OpenFlags, DescriptorFlags } from "wasi:filesystem";
use { Benchmark } from "core:benchmark";
use sqlite from "../../package-gale/tests/grammars/SQLite.g4"
    with {
        generator: {
            module: "../../package-gale/src/generator.wado",
            options: { highlight: false },
        },
    };

fn read_file(path: String) -> String with Preopens {
    let dirs = Preopens::get_directories();
    let root = dirs[0].0;
    let file = match root.open_at(PathFlags::none(), path, OpenFlags::none(), DescriptorFlags::Read).wait() {
        Ok(f) => f,
        Err(_) => panic(`failed to open {path}`),
    };
    let [stream, _done] = file.read_via_stream(0 as Filesize);
    let mut buf = String::with_capacity(64 * 1024);
    loop {
        let chunk = stream.read(4096);
        if chunk.len() == 0 {
            break;
        }
        buf.push_bytes_unchecked(chunk);
    }
    stream.drop();
    return buf;
}


test "smoke" {
    // Tiny inline statement; no Preopens needed.
    assert sqlite::parse(&"SELECT 1;").is_ok();
}

export fn run() with Stdout, MonotonicClock, Preopens {
    let sql = read_file("sqlite_parse/queries.sql");
    let mut b = Benchmark::new("sqlite-parse (Gale)");
    b.iterations = 100;
    b.input_size = Option::Some(sql.len());

    // FIXME: ideally `if let Err(e) = sqlite::parse(&sql) { panic(...) }`
    // inside the closure body, but that combination triggers a TIR-to-WIR
    // local-index collision when a closure's if-let lowering and a template
    // string in the same body share the parent function's allocator. Using
    // `.is_ok()` sidesteps the problematic shape until the deeper fix lands.
    // Tracked by `tests/fixtures/closure_iflet_template_collision.wado`
    // (`#![TODO]`) — when that fixture flips to passing, revert this to the
    // natural `if let Err(e)` form.
    let last_ok = b.run("", || sqlite::parse(&sql).is_ok());
    assert last_ok, "sqlite::parse failed";
}
