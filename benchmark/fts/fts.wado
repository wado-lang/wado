// Float-to-string benchmark
// Converts 1M random f64 values to decimal strings using :0.6f format.
// Uses a linear congruential generator for deterministic float sequence.
//
// How to run:
//   mise run benchmark-fts

use { Stdout } from "core:cli";
use { MonotonicClock } from "wasi:clocks";
use { Benchmark } from "core:benchmark";

struct FtsResult {
    total_bytes: u64,
    byte_sum: u64,
}

fn fts_run(n: i32) -> FtsResult {
    let mut state: u32 = 42;
    let mut total_bytes: u64 = 0;
    let mut byte_sum: u64 = 0;

    for let mut i = 0; i < n; i += 1 {
        state = state * 1103515245 + 12345 & 0x7FFFFFFF;
        let x = state as f64 / 2147483648.0;
        let s = `{x:0.6f}`;
        total_bytes += s.len() as u64;
        for let b of s.bytes() {
            byte_sum += b as u64;
        }
    }
    return FtsResult { total_bytes, byte_sum };
}

test "smoke" {
    let r = fts_run(100);
    assert r.total_bytes > 0;
    assert r.byte_sum > 0;
}

export fn run() with Stdout, MonotonicClock {
    let n = 1000000;
    let mut b = Benchmark { name: `fts: {n} f64 conversions (%.6f)` };
    b.work_per_iter = Option::Some(n as f64);
    b.unit = "conversions";
    let r = b.run("", || fts_run(n));
    b.println(`total bytes = {r.total_bytes}, byte sum = {r.byte_sum}`);
}
