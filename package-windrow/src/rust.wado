//! Rust, read through Gale's Rust grammar.

use {
    parse_rust,
    token_kind_name,
    RK_OUTER_ATTRIBUTE,
    RK_STATEMENTS,
    TK_DOT,
    TK_PATHSEP,
    TK_LPAREN,
    TK_NOT,
    TK_KW_FN,
} from "wado-lang:gale/src/rust.wado";
use { Tree, TokenClass } from "./tree.wado";
use { Language, TestMark, classify } from "./language.wado";

fn class_of(kind: i32) -> TokenClass {
    let name = token_kind_name(kind);
    if name == "NON_KEYWORD_IDENTIFIER" || name == "RAW_IDENTIFIER" || name == "LIFETIME_OR_LABEL" {
        return TokenClass::Name;
    }
    if name.ends_with("_LITERAL") {
        return TokenClass::Literal;
    }
    return TokenClass::Fixed;
}

/// `#[test]`, or a `cfg` that names `test`, marks the item it is attached to.
fn marks_test(kind: i32, text: StrSlice) -> TestMark {
    if kind != RK_OUTER_ATTRIBUTE as i32 {
        return TestMark::None;
    }
    let compact = text.to_string().replace(" ", "").replace("\n", "");
    if compact == "#[test]" || compact.starts_with("#[cfg(test") {
        return TestMark::Parent;
    }
    return TestMark::None;
}

/// The tree of a Rust file, or the first syntax error: recovery drops tokens,
/// so a shape taken from a broken tree would hide what it dropped.
pub fn read_rust(path: String, source: String) -> Result<Tree, String> {
    let result = parse_rust(&source);
    if result.diagnostics.len() > 0 {
        return Result::Err(`${result.diagnostics[0].message}`);
    }
    let cst = &result.cst;
    let toks = &result.tokens;
    let mut raw = Tree { path, source };
    for let mut i = 0; i < cst.row_count(); i += 1 {
        match cst.tag[i] {
            _::Open => {
                let span = cst.span(i);
                raw.open(cst.kind(i) as i32, span.start, span.end);
            },
            _::Close => raw.close(),
            _::Tok => {
                let t = cst.token_index(i);
                let span = toks.span_at(t);
                raw.token(toks.kind_at(t), TokenClass::Fixed, span.start, span.end);
            },
            _::Miss => {
            },
            _::Skip => {
            },
        }
    }
    let rust = Language {
        class_of,
        marks_test,
        sequence: RK_STATEMENTS as i32,
        declares: TK_KW_FN,
        member: TK_DOT,
        path: TK_PATHSEP,
        calls: [TK_LPAREN, TK_NOT],
    };
    return Result::Ok(classify(&raw, &rust));
}
