//! Rust, read through Gale's Rust grammar.

use {
    parse_rust,
    token_kind_name,
    RK_OUTER_ATTRIBUTE,
    RK_STATEMENTS,
    TK_DOT,
    TK_PATHSEP,
    TK_LPAREN,
    TK_NOT,
} from "wado-lang:gale/src/rust.wado";
use { Tree, TokenClass } from "./tree.wado";

/// Whether a name is one a reader resolves outside the code around it, read
/// off its neighbours since nothing here resolves names: a type or a variant
/// (capitalized), a field or a method (after `.`), a path segment (beside
/// `::`), or a function or macro called (before `(` or `!`). What is left is
/// mostly a local, which a copy is free to rename.
fn names_outside(source: &String, start: i32, previous: i32, next: i32) -> bool {
    let first = unchecked source.byte_at(start);
    return first >= b'A' && first <= b'Z'
        || previous == TK_DOT
        || previous == TK_PATHSEP
        || next == TK_PATHSEP
        || next == TK_LPAREN
        || next == TK_NOT;
}

/// Whether an attribute's text marks test code: `#[test]`, or a `cfg` that
/// names `test`. A copied test is a fixture's shape, not a defect.
fn marks_test(text: String) -> bool {
    let compact = text.replace(" ", "").replace("\n", "");
    return compact == "#[test]" || compact.starts_with("#[cfg(test");
}

fn class_of(kind: i32) -> TokenClass {
    let name = token_kind_name(kind);
    if name == "NON_KEYWORD_IDENTIFIER" || name == "RAW_IDENTIFIER" || name == "LIFETIME_OR_LABEL" {
        return TokenClass::Name;
    }
    if name.ends_with("_LITERAL") {
        return TokenClass::Literal;
    }
    return TokenClass::Fixed;
}

/// The tree of a Rust file, or the first syntax error: recovery drops tokens,
/// so a shape taken from a broken tree would hide what it dropped.
pub fn read_rust(path: String, source: String) -> Result<Tree, String> {
    let result = parse_rust(&source);
    if result.diagnostics.len() > 0 {
        return Result::Err(`${result.diagnostics[0].message}`);
    }
    let cst = &result.cst;
    let toks = &result.tokens;
    // The node an attribute marking test code is attached to, by its row.
    let mut test_code: List<bool> = List::filled(cst.row_count(), false);
    let mut open: List<i32> = [];
    for let mut i = 0; i < cst.row_count(); i += 1 {
        match cst.tag[i] {
            _::Open => {
                if cst.kind(i) == RK_OUTER_ATTRIBUTE && open.len() > 0 {
                    let span = cst.span(i);
                    if marks_test(source.slice(span.start, span.end).to_string()) {
                        test_code[open[open.len() - 1]] = true;
                    }
                }
                open.push(i);
            },
            _::Close => {
                open.pop();
            },
            _::Tok => {
            },
            _::Miss => {
            },
            _::Skip => {
            },
        }
    }
    let mut classes: List<TokenClass> = [];
    let mut tree = Tree { path, source };
    let mut depth = 0;
    let mut skip_until = -1;
    for let mut i = 0; i < cst.row_count(); i += 1 {
        let tag = cst.tag[i];
        if tag matches { _::Open } {
            depth += 1;
            if skip_until < 0 && test_code[i] {
                skip_until = depth;
            }
        }
        let skipping = skip_until >= 0;
        if tag matches { _::Close } {
            if skip_until == depth {
                skip_until = -1;
            }
            depth -= 1;
        }
        if skipping {
            continue;
        }
        match tag {
            _::Open => {
                let span = cst.span(i);
                tree.open(cst.kind(i) as i32, span.start, span.end);
                if cst.kind(i) == RK_STATEMENTS {
                    tree.mark_sequence();
                }
            },
            _::Close => tree.close(),
            _::Tok => {
                let t = cst.token_index(i);
                let kind = toks.kind_at(t);
                while classes.len() <= kind {
                    classes.push(class_of(classes.len()));
                }
                let span = toks.span_at(t);
                let mut class = classes[kind];
                if class matches { _::Name } {
                    let previous = if t > 0 { toks.kind_at(t - 1) } else { -1 };
                    let next = if t + 1 < toks.len() { toks.kind_at(t + 1) } else { -1 };
                    if names_outside(&tree.source, span.start, previous, next) {
                        class = TokenClass::Spelled;
                    }
                }
                tree.token(kind, class, span.start, span.end);
            },
            _::Miss => {
            },
            _::Skip => {
            },
        }
    }
    return Result::Ok(tree);
}
