//! Windrow finds code that repeats one shape: nodes of a syntax tree alike up
//! to renaming and changed constants, to a similarity the caller sets.

pub use { Tree, TokenClass, Row } from "./tree.wado";
pub use { Site, Group, Measure, find_similar } from "./similar.wado";
pub use { read_rust } from "./rust.wado";
pub use { read_wado } from "./wado.wado";

/// The tree of a file in the language its extension names: `.wado`, else Rust.
pub fn read_source(path: String, source: String) -> Result<Tree, String> {
    if path.ends_with(".wado") {
        return read_wado(path, source);
    }
    return read_rust(path, source);
}
