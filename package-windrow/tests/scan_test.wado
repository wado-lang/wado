use { read_rust, read_wado, find_similar, Tree, Measure } from "../src/lib.wado";

fn tree(path: String, source: String) -> Tree {
    return read_rust(path, source).unwrap();
}

global COPY_A: String = "fn total(items: &[Item]) -> i64 {
    let mut sum = 0;
    for item in items {
        if item.active && item.weight > 3 {
            sum += item.weight * item.count;
        }
        if item.flagged {
            sum -= item.penalty;
        }
    }
    sum
}";

global COPY_B: String = "fn weighed(rows: &[Item]) -> i64 {
    let mut acc = 0;
    for row in rows {
        if row.active && row.weight > 7 {
            acc += row.weight * row.count;
        }
        if row.flagged {
            acc -= row.penalty;
        }
    }
    acc
}";

global OTHER: String = "fn first(rows: &[Row]) -> Option<&Row> {
    let found = rows.iter().find(|r| r.enabled);
    match found {
        Some(r) => Some(r),
        None => None,
    }
}";

test "two functions equal up to names and constants are one group" {
    let trees: List<Tree> = [
        tree("a.rs", COPY_A),
        tree("b.rs", COPY_B),
        tree("c.rs", OTHER),
    ];
    let groups = find_similar(&trees, 20, 1.0);
    assert groups.len() == 1;
    assert groups[0].similarity == 1.0;
    assert groups[0].sites.len() == 2;
    assert groups[0].sites[0].tree == 0;
    assert groups[0].sites[1].tree == 1;
}

test "a group is reported at the largest node that is alike" {
    let trees: List<Tree> = [
        tree("a.rs", COPY_A),
        tree("b.rs", COPY_B),
    ];
    let groups = find_similar(&trees, 10, 0.9);
    assert groups.len() == 1;
    let site = groups[0].sites[0];
    assert trees[0].line_of(trees[0].start[site.row]) == 1;
}

test "a changed operator lowers the similarity below one" {
    let changed = COPY_B.replace("row.weight * row.count", "row.weight + row.count");
    let trees: List<Tree> = [
        tree("a.rs", COPY_A),
        tree("b.rs", changed),
    ];
    assert find_similar(&trees, 40, 1.0, Measure::Shape).is_empty();
    let groups = find_similar(&trees, 40, 0.6, Measure::Shape);
    assert groups.len() == 1;
    assert groups[0].similarity < 1.0;
}

test "a group's inner nodes join no other group together" {
    let loop_only = "fn other(xs: &[X], log: &mut Log) -> Report {
    log.start(\"other\", 1, 2, 3);
    let mut acc = 0;
    for x in xs {
        if x.active && x.weight > 1 {
            acc += x.weight * x.count;
        }
        if x.flagged {
            acc -= x.penalty;
        }
    }
    log.finish(acc, \"done\");
    Report::new(acc, log.lines(), 0, 1)
}";
    let trees: List<Tree> = [
        tree("a.rs", COPY_A),
        tree("b.rs", COPY_B),
        tree("c.rs", loop_only),
    ];
    let groups = find_similar(&trees, 20, 0.8);
    let mut joining_a_and_b = 0;
    for let g of &groups {
        let in_a = g.sites.iter_ref().any(|s| s.tree == 0);
        let in_b = g.sites.iter_ref().any(|s| s.tree == 1);
        if in_a && in_b {
            joining_a_and_b += 1;
        }
    }
    assert joining_a_and_b == 1;
    assert groups.iter_ref().any(|g| g.sites.iter_ref().any(|s| s.tree == 2));
}

test "a node repeating one small shape is not compared" {
    let a = "fn f(t: &T) { match t { A::B { .. } | A::C(_) | A::D | A::E { .. } | A::F(_) | A::G | A::H { .. } | A::I(_) | A::J => {} } }";
    let b = "fn g(u: &U) { match u { X::Y(_) | X::Z { .. } | X::W | X::V(_) | X::Q { .. } | X::R | X::S(_) | X::P { .. } | X::O => 1 } }";
    let trees: List<Tree> = [
        tree("a.rs", a),
        tree("b.rs", b),
    ];
    assert find_similar(&trees, 30, 0.5).is_empty();
}

test "a run of statements in a longer block is compared" {
    let a = "fn f(p: &P, c: &C) -> G {
    let n = p.width() * 2;
    log(n);
    let mut gen = TypeGen::with_hint(&p.path);
    register_outer_codes(&mut gen, p, c);
    gen.finish(n)
}";
    let b = "fn g(q: &P, d: &C, e: &E) -> G {
    if e.ready { return G::empty(); }
    let mut tg = TypeGen::with_hint(&q.path);
    register_outer_codes(&mut tg, q, d);
    tg.finish(e.size)
}";
    let trees: List<Tree> = [
        tree("a.rs", a),
        tree("b.rs", b),
    ];
    let groups = find_similar(&trees, 20, 0.6);
    assert groups.len() >= 1;
    let site = groups[0].sites[0];
    assert trees[0].line_of(site.start(&trees)) >= 4;
}

test "names that resolve elsewhere keep their spelling" {
    let a = "fn f(xs: &[X]) -> i64 { let mut s = 0; for x in xs { s += x.weight.total() * compute_rank(x.id); } s }";
    let b = "fn g(ys: &[Y]) -> i64 { let mut t = 0; for y in ys { t += y.height.mean() * derive_order(y.key); } t }";
    let trees: List<Tree> = [
        tree("a.rs", a),
        tree("b.rs", b),
    ];
    assert find_similar(&trees, 20, 0.9).is_empty();
}

test "one logic in two syntaxes is alike by the names it calls" {
    let a = "fn f(xs: &[Entry], table: &mut Table) {
    for x in xs {
        if x.is_visible() && x.has_owner() {
            table.insert_row(x.key_name(), x.render_cell(), Style::plain());
        }
    }
}";
    let b = "fn g(ys: &[Entry], t: &mut Table) {
    ys.iter().filter(|y| y.is_visible() && y.has_owner()).for_each(|y| t.insert_row(y.key_name(), y.render_cell(), Style::plain()));
}";
    let trees: List<Tree> = [
        tree("a.rs", a),
        tree("b.rs", b),
    ];
    let groups = find_similar(&trees, 20, 0.65);
    assert groups.len() == 1;
    assert groups[0].sites.iter_ref().all(|s| s.start(&trees) == 0);
    assert find_similar(&trees, 20, 0.65, Measure::Shape).iter_ref().all(|g| g.sites[0].start(&trees) > 0);
}

test "wado code is compared, its test blocks left out" {
    let a = "fn total(items: &List<Item>) -> i64 {
    let mut sum = 0;
    for let item of items {
        if item.active && item.weight > 3 {
            sum += item.weight * item.count;
        }
    }
    return sum;
}";
    let b = "fn weighed(rows: &List<Item>) -> i64 {
    let mut acc = 0;
    for let row of rows {
        if row.active && row.weight > 7 {
            acc += row.weight * row.count;
        }
    }
    return acc;
}";
    let trees: List<Tree> = [
        read_wado("a.wado", a).unwrap(),
        read_wado("b.wado", b).unwrap(),
        read_wado("c.wado", "test {
    let mut acc = 0;
    for let row of rows {
        if row.active && row.weight > 7 {
            acc += row.weight * row.count;
        }
    }
    assert acc == 0;
}").unwrap(),
    ];
    let groups = find_similar(&trees, 20, 1.0);
    assert groups.len() == 1;
    assert groups[0].sites.iter_ref().all(|s| s.tree < 2);
    let without_b: List<Tree> = [trees[0], trees[2]];
    assert find_similar(&without_b, 20, 0.8).is_empty();
}

test "test code is not compared" {
    let as_test = `#[cfg(test)]\nmod tests {\n${COPY_B}\n}`;
    let trees: List<Tree> = [
        tree("a.rs", COPY_A),
        tree("b.rs", as_test),
        tree("c.rs", `#[test]\n${COPY_B}`),
    ];
    assert find_similar(&trees, 20, 0.9).is_empty();
}

test "unrelated code is not alike" {
    let trees: List<Tree> = [
        tree("a.rs", COPY_A),
        tree("c.rs", OTHER),
    ];
    assert find_similar(&trees, 20, 0.5).is_empty();
}
