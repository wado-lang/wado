use { marked_generated } from "../src/generated.wado";

test "a path is generated where git check-attr reads the attribute set" {
    let records = "dom.wado\u{0}linguist-generated\u{0}true\u{0}main.wado\u{0}linguist-generated\u{0}unspecified\u{0}bare.wado\u{0}linguist-generated\u{0}set\u{0}off.wado\u{0}linguist-generated\u{0}false\u{0}";
    let generated = marked_generated(records);
    assert generated.len() == 2;
    assert generated.contains("dom.wado");
    assert generated.contains("bare.wado");
    assert marked_generated("").is_empty();
}
