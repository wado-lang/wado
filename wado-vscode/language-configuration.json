{
  "$schema": "https://raw.githubusercontent.com/SchemaStore/schemastore/master/src/schemas/json/language-configuration.json",
  "autoClosingPairs": [
    {
      "close": "}",
      "open": "{"
    },
    {
      "close": "]",
      "open": "["
    },
    {
      "close": ")",
      "open": "("
    },
    {
      "close": ">",
      "notIn": [
        "string",
        "comment"
      ],
      "open": "<"
    },
    {
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ],
      "open": "\""
    },
    {
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ],
      "open": "'"
    },
    {
      "close": "`",
      "notIn": [
        "string",
        "comment"
      ],
      "open": "`"
    },
    {
      "close": " */",
      "notIn": [
        "string"
      ],
      "open": "/*"
    }
  ],
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "<",
      ">"
    ]
  ],
  "comments": {
    "blockComment": [
      "/*",
      "*/"
    ],
    "lineComment": "//"
  },
  "folding": {
    "markers": {
      "end": "^\\s*//\\s*#?endregion\\b",
      "start": "^\\s*//\\s*#?region\\b"
    }
  },
  "indentationRules": {
    "decreaseIndentPattern": "^\\s*[}\\])]",
    "increaseIndentPattern": "^.*\\{[^}\"']*$|^.*\\([^)\"']*$|^.*\\[[^\\]\"']*$"
  },
  "onEnterRules": [
    {
      "action": {
        "appendText": "/// ",
        "indent": "none"
      },
      "beforeText": "^\\s*///.*$"
    },
    {
      "action": {
        "indent": "indentOutdent"
      },
      "afterText": "^\\s*\\}",
      "beforeText": "\\{\\s*$"
    },
    {
      "action": {
        "indent": "indent"
      },
      "beforeText": "\\{\\s*$"
    },
    {
      "action": {
        "indent": "indentOutdent"
      },
      "afterText": "^\\s*\\]",
      "beforeText": "\\[\\s*$"
    },
    {
      "action": {
        "indent": "indentOutdent"
      },
      "afterText": "^\\s*\\)",
      "beforeText": "\\(\\s*$"
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "<",
      ">"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ],
    [
      "`",
      "`"
    ]
  ],
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*"
}