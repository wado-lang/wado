{
  "name": "wado",
  "displayName": "Wado",
  "description": "Language support for the Wado programming language",
  "version": "0.0.1",
  "publisher": "wado-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wado-lang/wado"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "wado",
    "wasm",
    "webassembly",
    "wasi"
  ],
  "activationEvents": [
    "onLanguage:wado"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "wado",
        "aliases": [
          "Wado",
          "wado"
        ],
        "extensions": [
          ".wado"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "wado",
        "scopeName": "source.wado",
        "path": "./syntaxes/wado.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "test:unit": "npm run compile && mocha 'out/test/unit/**/*.test.js'"
  },
  "devDependencies": {
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.0.0",
    "glob": "^11.0.0",
    "mocha": "^10.0.0",
    "typescript": "^5.3.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.1"
  }
}
