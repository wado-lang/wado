use { Request, Response, ErrorCode, Headers, Trailers } from "wasi:http";
use { MonotonicClock } from "wasi:clocks";

// Used by the `wado serve` in-flight-slot tests. On `/park` the handler
// parks in a host call far past any test timeout, so it outlives the 504 its
// client gets; the epoch deadline cannot reclaim it, because no wasm runs
// while it is parked. Every other path answers at once, so a test can ask
// whether the worker got the slot back.
export async fn handle(request: Request) -> Result<Response, ErrorCode> with MonotonicClock {
    if let Some(path) = request.get_path_with_query() {
        if path == "/park" {
            MonotonicClock::wait_for(600_000_000_000).wait();
        }
    }

    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [body_rx, body_tx] = Stream::<u8>::new();
    let headers = Headers::new();
    let [response, _tx_future] = Response::new(headers, Option::<Stream<u8>>::Some(body_rx), trailers_future);
    response.set_status_code(200);
    task return Result::<Response, ErrorCode>::Ok(response);

    body_tx.write_all("awake\n".bytes().collect());
    body_tx.drop();
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}
