// A program that reports its own diagnostic and exits non-zero on purpose —
// the ordinary way a CLI rejects bad input. Used to pin that `wado run`
// propagates the code instead of reporting a trap.

use { eprintln, exit, Stderr, Exit } from "core:cli";

export fn run() with Stderr, Exit {
    eprintln("run_exit_code: bad input");
    exit(3);
}
