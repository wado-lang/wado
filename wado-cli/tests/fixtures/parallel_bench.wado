// Tests for parallel execution benchmarking
// Each test does heavy computation (~1s each)
// With 4 parallel workers, should complete much faster than sequential

// Compute prime numbers up to n using trial division
// This is intentionally slow to demonstrate parallelization
fn count_primes(n: i32) -> i32 {
    let mut count = 0;
    let mut num = 2;
    loop {
        if num > n {
            break;
        }
        let mut is_prime = true;
        let mut divisor = 2;
        loop {
            if divisor * divisor > num {
                break;
            }
            if num % divisor == 0 {
                is_prime = false;
                break;
            }
            divisor = divisor + 1;
        }
        if is_prime {
            count = count + 1;
        }
        num = num + 1;
    }
    return count;
}

// Each test counts primes up to 1000000 (~1s each)
test "primes_1" {
    let count = count_primes(1000000);
    assert count == 78498;
}

test "primes_2" {
    let count = count_primes(1000000);
    assert count == 78498;
}

test "primes_3" {
    let count = count_primes(1000000);
    assert count == 78498;
}

