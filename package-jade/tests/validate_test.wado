use { Uri } from "core:uri";
use {
    CompileError,
    Document,
    Number,
    Schema,
    SchemaError,
    SchemaObject,
    SchemaSet,
    ValidationError,
    Validator,
} from "../src/lib.wado";

fn errors(schema: String, data: String) -> List<ValidationError> {
    let validator = Validator::compile(&Schema::parse(schema).unwrap()).unwrap();
    let doc = Document::parse(data).unwrap();
    if let Err(found) = validator.validate(&doc.root()) {
        return found;
    }
    return [];
}

test "an error points into the instance and into the schema" {
    let found = errors(
        #"{"properties": {"a/b": {"items": {"minimum": 2}}}}"#,
        #"{"a/b": [3, 1]}"#,
    );
    assert found.len() == 1;
    assert found[0].instance == "/a~1b/1";
    assert found[0].keyword == "/properties/a~1b/items/minimum";
    assert `${found[0]}` == "/a~1b/1: must be at least 2 (/properties/a~1b/items/minimum)";
}

test "every failing keyword is reported" {
    let found = errors(#"{"type": "string", "minimum": 5, "required": ["x"]}"#, "3");
    assert found.len() == 2;
    assert found[0].message == "must be string";
    assert found[1].keyword == "/minimum";
}

test "a reference is followed to its target's keywords" {
    let found = errors(##"{"$defs": {"n": {"type": ["integer", "null"]}}, "$ref": "#/$defs/n"}"##, "1.5");
    assert found[0].keyword == "/$defs/n/type";
    assert found[0].message == "must be null or integer";
}

test "multipleOf divides the numbers as written" {
    assert errors(#"{"multipleOf": 0.1}"#, "0.3").is_empty();
    assert errors(#"{"multipleOf": 0.01}"#, "19.99").is_empty();
    assert errors(#"{"multipleOf": 3}"#, "1e300").len() == 1;
    assert errors(#"{"multipleOf": 2}"#, "1e300").is_empty();
    assert errors(#"{"multipleOf": 0.3}"#, "0.1").len() == 1;
}

test "a reference back to itself at the same instance is an error, not a loop" {
    let found = errors(##"{"$ref": "#"}"##, "1");
    assert found.len() == 1;
    assert found[0].keyword == "/$ref";
    assert found[0].message == "refers back to itself without moving into the instance";
    let mutual = errors(
        ##"{"$defs": {"a": {"$ref": "#/$defs/b"}, "b": {"allOf": [{"$ref": "#/$defs/a"}]}}, "$ref": "#/$defs/a"}"##,
        "1",
    );
    assert mutual.len() == 1;
    assert mutual[0].keyword == "/$defs/b/allOf/0/$ref";
    assert errors(##"{"items": {"$ref": "#"}}"##, "[[[1]]]").is_empty();
}

test "a dynamic reference's fragment is percent-decoded before it names an anchor" {
    let schema = ##"{
        "$id": "https://x.test/outer",
        "$ref": "inner",
        "$defs": {
            "node": {"$dynamicAnchor": "node", "type": "integer"},
            "inner": {"$id": "inner", "$dynamicRef": "#%6eode", "$defs": {"n": {"$dynamicAnchor": "node"}}}
        }
    }"##;
    let found = errors(schema, #""x""#);
    assert found.len() == 1;
    assert found[0].keyword == "/$defs/node/type";
}

/// A schema whose every level refers to the next twice, `depth` levels deep,
/// ending in `leaf`.
fn doubling(depth: i32, leaf: String) -> String {
    let mut defs: List<String> = [];
    for let i of 0..<depth {
        defs.push(`"d${i}": {"allOf": [{"$ref": "#/$defs/d${i + 1}"}, {"$ref": "#/$defs/d${i + 1}"}]}`);
    }
    defs.push(`"d${depth}": ${leaf}`);
    return `{"$ref": "#/$defs/d0", "$defs": {${defs.join(", ")}}}`;
}

test "a target many references share is evaluated once per value" {
    assert errors(doubling(40, #"{"type": "string"}"#), #""x""#).is_empty();
    let found = errors(doubling(40, #"{"type": "string"}"#), "[1]");
    assert found.len() == 1;
    assert found[0].keyword == "/$defs/d40/type";
    let deep = doubling(40, ##"{"items": {"$ref": "#/$defs/d0"}, "type": ["array", "integer"]}"##);
    assert errors(deep, "[[[1]], [2]]").is_empty();
}

test "a shared target is evaluated apart under each binding of a dynamic anchor" {
    let schema = ##"{
        "$id": "https://x.test/root",
        "anyOf": [{"$ref": "a"}, {"$ref": "b"}],
        "$defs": {
            "a": {"$id": "a", "$ref": "s", "$defs": {"t": {"$dynamicAnchor": "t", "type": "string"}}},
            "b": {"$id": "b", "$ref": "s", "$defs": {"t": {"$dynamicAnchor": "t", "type": "number"}}},
            "s": {"$id": "s", "$dynamicRef": "#t", "$defs": {"t": {"$dynamicAnchor": "t"}}}
        }
    }"##;
    assert errors(schema, "1").is_empty();
    assert errors(schema, #""x""#).is_empty();
    let found = errors(schema, "null");
    assert found.len() == 1;
    assert found[0].keyword == "/anyOf";
}

test "a reference to a document nobody supplied is unresolved at compile" {
    let e = Validator::compile(&Schema::parse(#"{"items": {"$ref": "https://x.test/other.json#/a"}}"#).unwrap()).unwrap_err();
    let Unresolved(u) = e else {
        panic(`${e}`);
    };
    assert u.uri matches { None };
    assert u.pointer == "/items/$ref";
    assert `${u.target}` == "https://x.test/other.json#/a";
}

test "a reference into a held document at a place it lacks is an error at compile" {
    let mut set = SchemaSet::new();
    set.insert(uri("https://x.test/root.json"), Schema::parse(##"{"$ref": "int.json#/nope"}"##).unwrap());
    set.insert(uri("https://x.test/int.json"), Schema::parse(#"{"type": "integer"}"#).unwrap());
    let s = invalid(Validator::compile_in(&set, &uri("https://x.test/root.json")));
    assert s.uri matches { Some(u) && `${u}` == "https://x.test/root.json" };
    assert s.pointer == "/$ref";
}

test "a set names the documents its references still need, then compiles" {
    let root = uri("https://x.test/root.json");
    let mut set = SchemaSet::new();
    set.insert(
        root,
        Schema::parse(#"{"items": {"$ref": "int.json"}, "$defs": {"m": {"$ref": "moved.json"}}}"#).unwrap(),
    );
    assert set.missing().unwrap() matches { Some(u) && `${u}` == "https://x.test/int.json" };
    set.insert(uri("https://x.test/int.json"), Schema::parse(#"{"type": "integer"}"#).unwrap());
    assert set.missing().unwrap() matches { Some(u) && `${u}` == "https://x.test/moved.json" };
    // The URI a document was retrieved from names it, whatever its `$id` says.
    set.insert(uri("https://x.test/moved.json"), Schema::parse(#"{"$id": "https://y.test/s"}"#).unwrap());
    assert set.missing().unwrap() matches { None };
    let validator = Validator::compile_in(&set, &root).unwrap();
    assert validator.validate(&Document::parse("[1, 2]").unwrap().root()) matches { Ok(_) };
    let found = validator.validate(&Document::parse(#"[1, "x"]"#).unwrap().root()).unwrap_err();
    assert found.len() == 1;
    assert found[0].uri matches { Some(u) && `${u}` == "https://x.test/int.json" };
    assert found[0].keyword == "/type";
    assert found[0].instance == "/1";
}

test "Draft 2020-12's meta-schemas are held without being supplied" {
    let schema = ##"{"$ref": "https://json-schema.org/draft/2020-12/schema"}"##;
    assert errors(schema, #"{"type": "string", "properties": {"a": {"minimum": 1}}}"#).is_empty();
    assert !errors(schema, #"{"properties": {"a": {"minimum": "1"}}}"#).is_empty();
}

fn uri(text: String) -> Uri {
    return Uri::from_str(text).unwrap();
}

test "a schema built breaking a keyword's rule is an error at compile" {
    let schema = Schema::Object(SchemaObject {
        items: Option::Some(Schema::Object(SchemaObject { multiple_of: Option::Some(Number::from(0.0)) })),
    });
    let e = invalid(Validator::compile(&schema));
    assert e.pointer == "/items/multipleOf";
    assert e.message == "must be greater than 0";
}

test "a pattern outside the supported syntax is an error at compile" {
    let e = invalid(Validator::compile(&Schema::parse(#"{"pattern": "(?<=a)b"}"#).unwrap()));
    assert e.uri matches { None };
    assert e.pointer == "/pattern";
}

fn invalid(compiled: Result<Validator, CompileError>) -> SchemaError {
    let Err(Invalid(e)) = compiled else {
        panic("compiled, or failed otherwise");
    };
    return e;
}
