    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"prefixItems":[{"type":"string"}],"unevaluatedItems":false}},"anyOf":[{"properties":{"foo":{"prefixItems":[true,{"type":"string"}]}}}]}"#,
        #"{"foo":["test","test"]}"#,
        false,
        [],
    );
}

test "unevaluatedItems depends on adjacent contains: second item is evaluated by contains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[true],"contains":{"type":"string"},"unevaluatedItems":false}"#,
        #"[1,"foo"]"#,
        true,
        [],
    );
}

test "unevaluatedItems depends on adjacent contains: contains fails, second item is not evaluated" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[true],"contains":{"type":"string"},"unevaluatedItems":false}"#,
        #"[1,2]"#,
        false,
        [],
    );
}

test "unevaluatedItems depends on adjacent contains: contains passes, second item is not evaluated" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[true],"contains":{"type":"string"},"unevaluatedItems":false}"#,
        #"[1,2,"foo"]"#,
        false,
        [],
    );
}

