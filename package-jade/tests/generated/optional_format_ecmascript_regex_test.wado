test "\\a is not an ECMA 262 control escape: when used as a pattern" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""\\a""#,
        false,
    );
}

test "Python-specific regular expression syntax is not valid ECMA 262: Python named group (?P<name>...) is not ECMA 262" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""(?P<name>x)""#,
        false,
    );
}

test "Python-specific regular expression syntax is not valid ECMA 262: Python named backreference (?P=name) is not ECMA 262" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""(?P<n>a)(?P=n)""#,
        false,
    );
}

test "Python-specific regular expression syntax is not valid ECMA 262: inline comment group (?#...) is not ECMA 262" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""(?#comment)a""#,
        false,
    );
}

test "global inline flag groups are not valid ECMA 262: a single global inline flag (?i)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""(?i)abc""#,
        false,
    );
}

test "global inline flag groups are not valid ECMA 262: multiple global inline flags (?ims)" {
    check_format(
