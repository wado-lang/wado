        #"{"prop1":"match"}"#,
        false,
    );
}

test "naive replacement of $ref with its destination is not correct: do not evaluate the $ref inside the enum, matching any string" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"a_string":{"type":"string"}},"enum":[{"$ref":"#/$defs/a_string"}]}"##,
        #""this is a string""#,
        false,
    );
}

test "naive replacement of $ref with its destination is not correct: do not evaluate the $ref inside the enum, definition exact match" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"a_string":{"type":"string"}},"enum":[{"$ref":"#/$defs/a_string"}]}"##,
        #"{"type":"string"}"#,
        false,
    );
}

test "naive replacement of $ref with its destination is not correct: match the enum exactly" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"a_string":{"type":"string"}},"enum":[{"$ref":"#/$defs/a_string"}]}"##,
