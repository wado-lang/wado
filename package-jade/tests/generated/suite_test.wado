}

test "enum with 0 does not match false: false is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[0]}"#,
        #"false"#,
        false,
    );
}

test "enum with 0 does not match false: integer zero is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[0]}"#,
        #"0"#,
        true,
    );
}

test "enum with 0 does not match false: float zero is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[0]}"#,
        #"0"#,
        true,
    );
}

test "enum with [0] does not match [false]: [false] is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[[0]]}"#,
        #"[false]"#,
        false,
    );
}

test "enum with [0] does not match [false]: [0] is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[[0]]}"#,
        #"[0]"#,
        true,
    );
}

test "enum with [0] does not match [false]: [0.0] is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[[0]]}"#,
        #"[0]"#,
        true,
    );
}

test "enum with 1 does not match true: true is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[1]}"#,
        #"true"#,
        false,
    );
}

test "enum with 1 does not match true: integer one is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[1]}"#,
        #"1"#,
        true,
    );
}

test "enum with 1 does not match true: float one is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[1]}"#,
        #"1"#,
        true,
    );
}

test "enum with [1] does not match [true]: [true] is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[[1]]}"#,
        #"[true]"#,
        false,
    );
}

test "enum with [1] does not match [true]: [1] is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[[1]]}"#,
        #"[1]"#,
        true,
    );
}

test "enum with [1] does not match [true]: [1.0] is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[[1]]}"#,
        #"[1]"#,
        true,
    );
}

test "nul characters in strings: match string with nul (2)" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":["hello\u0000there"]}"#,
        #""hello\u0000there""#,
        true,
    );
}

test "nul characters in strings: do not match string lacking nul (2)" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":["hello\u0000there"]}"#,
        #""hellothere""#,
        false,
    );
}

test "empty enum: string is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[]}"#,
        #""foo""#,
        false,
    );
}

test "empty enum: number is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[]}"#,
        #"42"#,
        false,
    );
}

test "empty enum: null is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[]}"#,
        #"null"#,
        false,
    );
}

test "empty enum: object is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[]}"#,
        #"{}"#,
        false,
    );
}

test "empty enum: array is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[]}"#,
        #"[]"#,
        false,
    );
}

test "empty enum: boolean is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[]}"#,
        #"false"#,
        false,
    );
}

test "characters with the same visual representation, but different number of codepoints: character uses the same codepoint (2)" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":["ä"],"$comment":"U+00E4"}"#,
        #""ä""#,
        true,
    );
}

test "characters with the same visual representation, but different number of codepoints: character looks the same but uses combining marks (2)" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":["ä"],"$comment":"U+00E4"}"#,
        #""ä""#,
        false,
    );
}

// exclusiveMaximum.json

test "exclusiveMaximum validation: below the exclusiveMaximum is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","exclusiveMaximum":3}"#,
        #"2.2"#,
        true,
    );
}

test "exclusiveMaximum validation: boundary point is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","exclusiveMaximum":3}"#,
        #"3"#,
        false,
    );
}

test "exclusiveMaximum validation: above the exclusiveMaximum is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","exclusiveMaximum":3}"#,
        #"3.5"#,
        false,
    );
}

test "exclusiveMaximum validation: ignores non-numbers" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","exclusiveMaximum":3}"#,
        #""x""#,
        true,
    );
}

// exclusiveMinimum.json

test "exclusiveMinimum validation: above the exclusiveMinimum is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","exclusiveMinimum":1.1}"#,
        #"1.2"#,
        true,
    );
}

test "exclusiveMinimum validation: boundary point is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","exclusiveMinimum":1.1}"#,
        #"1.1"#,
        false,
    );
}

test "exclusiveMinimum validation: below the exclusiveMinimum is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","exclusiveMinimum":1.1}"#,
        #"0.6"#,
        false,
    );
}

test "exclusiveMinimum validation: ignores non-numbers" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","exclusiveMinimum":1.1}"#,
        #""x""#,
        true,
    );
}

// format.json

test "email format: all string formats ignore integers" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"email"}"#,
        #"12"#,
        true,
    );
}

test "email format: all string formats ignore floats" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"email"}"#,
        #"13.7"#,
        true,
    );
}

test "email format: all string formats ignore objects" {
    check(
