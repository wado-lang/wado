// optional/anchor.json

test "$anchor inside an enum is not a real identifier: exact match to enum, and type matches" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"anchor_in_enum":{"enum":[{"$anchor":"my_anchor","type":"null"}]},"real_identifier_in_schema":{"$anchor":"my_anchor","type":"string"},"zzz_anchor_in_const":{"const":{"$anchor":"my_anchor","type":"null"}}},"anyOf":[{"$ref":"#/$defs/anchor_in_enum"},{"$ref":"#my_anchor"}]}"##,
        #"{"$anchor":"my_anchor","type":"null"}"#,
        true,
    );
}

test "$anchor inside an enum is not a real identifier: in implementations that strip $anchor, this may match either $def" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"anchor_in_enum":{"enum":[{"$anchor":"my_anchor","type":"null"}]},"real_identifier_in_schema":{"$anchor":"my_anchor","type":"string"},"zzz_anchor_in_const":{"const":{"$anchor":"my_anchor","type":"null"}}},"anyOf":[{"$ref":"#/$defs/anchor_in_enum"},{"$ref":"#my_anchor"}]}"##,
        #"{"type":"null"}"#,
        false,
    );
}

test "$anchor inside an enum is not a real identifier: match $ref to $anchor" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"anchor_in_enum":{"enum":[{"$anchor":"my_anchor","type":"null"}]},"real_identifier_in_schema":{"$anchor":"my_anchor","type":"string"},"zzz_anchor_in_const":{"const":{"$anchor":"my_anchor","type":"null"}}},"anyOf":[{"$ref":"#/$defs/anchor_in_enum"},{"$ref":"#my_anchor"}]}"##,
        #""a string to match #/$defs/anchor_in_enum""#,
        true,
    );
}

test "$anchor inside an enum is not a real identifier: no match on enum or $ref to $anchor" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"anchor_in_enum":{"enum":[{"$anchor":"my_anchor","type":"null"}]},"real_identifier_in_schema":{"$anchor":"my_anchor","type":"string"},"zzz_anchor_in_const":{"const":{"$anchor":"my_anchor","type":"null"}}},"anyOf":[{"$ref":"#/$defs/anchor_in_enum"},{"$ref":"#my_anchor"}]}"##,
        #"1"#,
        false,
    );
}

// optional/bignum.json

test "integer: a bignum is an integer" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"integer"}"#,
        #"1.2345678910111213141516171819202122232425262728293031e52"#,
        true,
    );
}

test "integer: a negative bignum is an integer" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"integer"}"#,
        #"-1.2345678910111213141516171819202122232425262728293031e52"#,
        true,
    );
}

test "number: a bignum is a number" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"number"}"#,
        #"9.8249283749234923498293171823948729348710298301928331e52"#,
        true,
    );
}

test "number: a negative bignum is a number" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"number"}"#,
        #"-9.8249283749234923498293171823948729348710298301928331e52"#,
        true,
    );
}

test "string: a bignum is not a string" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"string"}"#,
        #"9.8249283749234923498293171823948729348710298301928331e52"#,
        false,
    );
}

test "maximum integer comparison: comparison works for high numbers" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maximum":18446744073709551615}"#,
        #"18446744073709551600"#,
        true,
    );
}

test "float comparison with high precision: comparison works for high numbers" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","exclusiveMaximum":9.7278379818798712387987812318878137e26}"#,
        #"9.72783798187987123879878123188781371e26"#,
        false,
    );
}

test "minimum integer comparison: comparison works for very negative numbers" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minimum":-18446744073709551615}"#,
        #"-18446744073709551600"#,
        true,
    );
}

test "float comparison with high precision on negative numbers: comparison works for very negative numbers" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","exclusiveMinimum":-9.7278379818798712387987812318878137e26}"#,
        #"-9.72783798187987123879878123188781371e26"#,
        false,
    );
}

test "multipleOf with integers above 2^53: 3e20 is multiple of 3" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","multipleOf":3}"#,
        #"300000000000000000000"#,
        true,
    );
}

test "multipleOf with integers above 2^53: 1e20 is not multiple of 3" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","multipleOf":3}"#,
        #"100000000000000000000"#,
        false,
    );
}

// optional/cross-draft.json
//
// Left out:
//   refs to historic drafts are processed as historic drafts: refers to http://localhost:1234/draft2019-09/ignore-prefixItems.json, which is no Draft 2020-12 schema

// optional/dynamicRef.json

test "$dynamicRef skips over intermediate resources - pointer reference across resource boundary: integer property passes" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamic-ref-skips-intermediate-resource/optional/main","type":"object","properties":{"bar-item":{"$ref":"bar#/$defs/item"}},"$defs":{"bar":{"$id":"bar","type":"array","items":{"$ref":"item"},"$defs":{"item":{"$id":"item","type":"object","properties":{"content":{"$dynamicRef":"#content"}},"$defs":{"defaultContent":{"$dynamicAnchor":"content","type":"integer"}}},"content":{"$dynamicAnchor":"content","type":"string"}}}}}"##,
        #"{"bar-item":{"content":42}}"#,
        true,
    );
}

test "$dynamicRef skips over intermediate resources - pointer reference across resource boundary: string property fails" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamic-ref-skips-intermediate-resource/optional/main","type":"object","properties":{"bar-item":{"$ref":"bar#/$defs/item"}},"$defs":{"bar":{"$id":"bar","type":"array","items":{"$ref":"item"},"$defs":{"item":{"$id":"item","type":"object","properties":{"content":{"$dynamicRef":"#content"}},"$defs":{"defaultContent":{"$dynamicAnchor":"content","type":"integer"}}},"content":{"$dynamicAnchor":"content","type":"string"}}}}}"##,
        #"{"bar-item":{"content":"value"}}"#,
        false,
    );
}

// optional/ecmascript-regex.json

test "ECMA 262 regex $ does not match trailing newline: matches in Python, but not in ECMA 262" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"string","pattern":"^abc$"}"#,
        #""abc\\n""#,
        false,
    );
}

test "ECMA 262 regex $ does not match trailing newline: matches" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"string","pattern":"^abc$"}"#,
        #""abc""#,
        true,
    );
}

test "ECMA 262 regex converts \\t to horizontal tab: does not match" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"string","pattern":"^\\t$"}"#,
        #""\\t""#,
        false,
    );
}

test "ECMA 262 regex converts \\t to horizontal tab: matches" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"string","pattern":"^\\t$"}"#,
        #""\t""#,
        true,
    );
}

test "ECMA 262 regex escapes control codes with \\c and upper letter: does not match" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"string","pattern":"^\\cC$"}"#,
        #""\\cC""#,
        false,
    );
}

test "ECMA 262 regex escapes control codes with \\c and upper letter: matches" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"string","pattern":"^\\cC$"}"#,
        #""\u0003""#,
        true,
    );
}

test "ECMA 262 regex escapes control codes with \\c and lower letter: does not match" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"string","pattern":"^\\cc$"}"#,
        #""\\cc""#,
        false,
    );
}

test "ECMA 262 regex escapes control codes with \\c and lower letter: matches" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"string","pattern":"^\\cc$"}"#,
        #""\u0003""#,
        true,
    );
}

test "ECMA 262 \\d matches ascii digits only: ASCII zero matches" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"string","pattern":"^\\d$"}"#,
        #""0""#,
        true,
    );
}

test "ECMA 262 \\d matches ascii digits only: NKO DIGIT ZERO does not match (unlike e.g. Python)" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"string","pattern":"^\\d$"}"#,
