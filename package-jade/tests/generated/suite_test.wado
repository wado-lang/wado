    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date"}"#,
        #""2020:01:01""#,
        false,
    );
}

test "validation of date strings: invalid: dot separators" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date"}"#,
        #""2020.01.01""#,
        false,
    );
}

test "validation of date strings: invalid: space separators" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date"}"#,
        #""2020 01 01""#,
        false,
    );
}

test "validation of date strings: invalid: mixed slash and hyphen separators" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date"}"#,
        #""2020-01/01""#,
        false,
    );
}

test "validation of date strings: invalid: duplicated first hyphen" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date"}"#,
        #""2020--01-01""#,
        false,
    );
}

test "validation of date strings: invalid: duplicated second hyphen" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date"}"#,
        #""2020-01--01""#,
        false,
    );
}

test "validation of date strings: valid: date inside the Julian to Gregorian reform gap" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date"}"#,
        #""1582-10-10""#,
        true,
    );
}

test "validation of date strings: invalid: year field numerically larger than a 32-bit signed integer" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date"}"#,
        #""2147483648-01-01""#,
        false,
    );
}

test "validation of date strings: invalid: character just above '9' as the second digit of the day" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date"}"#,
        #""2020-01-0:""#,
        false,
    );
}

test "validation of date strings: invalid: non-ASCII digit leaving ten UTF-8 bytes but eight characters" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date"}"#,
        #""২0-01-01""#,
        false,
    );
}

test "validation of date strings: invalid: en dash separators instead of hyphen-minus" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date"}"#,
        #""2020–01–01""#,
        false,
    );
}

test "validation of date strings: invalid: NUL character after an otherwise valid full-date" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date"}"#,
        #""2020-01-01\u0000""#,
        false,
    );
}

// optional/format/duration.json

test "validation of duration strings: all string formats ignore integers" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #"12"#,
        true,
    );
}

test "validation of duration strings: all string formats ignore floats" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #"13.7"#,
        true,
    );
}

test "validation of duration strings: all string formats ignore objects" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #"{}"#,
        true,
    );
}

test "validation of duration strings: all string formats ignore arrays" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #"[]"#,
        true,
    );
}

test "validation of duration strings: all string formats ignore booleans" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #"false"#,
        true,
    );
}

test "validation of duration strings: all string formats ignore nulls" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #"null"#,
        true,
    );
}

test "validation of duration strings: a valid duration string" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P4DT12H30M5S""#,
        true,
    );
}

test "validation of duration strings: an invalid duration string" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""PT1D""#,
        false,
    );
}

test "validation of duration strings: must start with P" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""4DT12H30M5S""#,
        false,
    );
}

test "validation of duration strings: no elements present" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P""#,
        false,
    );
}

test "validation of duration strings: no time elements present" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P1YT""#,
        false,
    );
}

test "validation of duration strings: no date or time elements present" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""PT""#,
        false,
    );
}

test "validation of duration strings: elements out of order" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P2D1Y""#,
        false,
    );
}

test "validation of duration strings: missing time separator" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P1D2H""#,
        false,
    );
}

test "validation of duration strings: time element in the date position" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P2S""#,
        false,
    );
}

test "validation of duration strings: four years duration" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P4Y""#,
        true,
    );
}

test "validation of duration strings: zero time, in seconds" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""PT0S""#,
        true,
    );
}

test "validation of duration strings: zero time, in days" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P0D""#,
        true,
    );
}

test "validation of duration strings: one month duration" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P1M""#,
        true,
    );
}

test "validation of duration strings: one minute duration" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""PT1M""#,
        true,
    );
}

test "validation of duration strings: one and a half days, in hours" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""PT36H""#,
        true,
    );
}

test "validation of duration strings: one and a half days, in days and hours" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P1DT12H""#,
        true,
    );
}

test "validation of duration strings: two weeks" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P2W""#,
        true,
    );
}

test "validation of duration strings: weeks cannot be combined with other units" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P1Y2W""#,
        false,
    );
}

test "validation of duration strings: invalid non-ASCII '২' (a Bengali 2)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P২Y""#,
        false,
    );
}

test "validation of duration strings: element without unit" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P1""#,
        false,
    );
}

test "validation of duration strings: all date and time components" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P1Y2M3DT4H5M6S""#,
        true,
    );
}

test "validation of duration strings: date components only" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P1Y2M3D""#,
        true,
    );
}

test "validation of duration strings: time components only" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""PT1H2M3S""#,
        true,
    );
}

test "validation of duration strings: month and day" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P1M2D""#,
        true,
    );
}

test "validation of duration strings: hour and minute" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""PT1H30M""#,
        true,
    );
}

test "validation of duration strings: multi-digit values in all components" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P10Y10M10DT10H10M10S""#,
        true,
    );
}

test "validation of duration strings: fractional duration is not allowed by RFC 3339 ABNF" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""PT0.5S""#,
        false,
    );
}

test "validation of duration strings: leading whitespace is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #"" P1D""#,
        false,
    );
}

test "validation of duration strings: trailing whitespace is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P1D ""#,
        false,
    );
}

test "validation of duration strings: empty string is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""""#,
        false,
    );
}

test "validation of duration strings: years and months can appear without days" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P1Y2M""#,
        true,
    );
}

test "validation of duration strings: years and days cannot appear without months" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P1Y2D""#,
        false,
    );
}

test "validation of duration strings: hours and minutes can appear without seconds" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""PT1H2M""#,
        true,
    );
}

test "validation of duration strings: hours and seconds cannot appear without minutes" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""PT1H2S""#,
        false,
    );
}

test "validation of duration strings: minutes and seconds can appear without hour" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""PT1M2S""#,
        true,
    );
}

test "validation of duration strings: a leading sign is not allowed" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""-P1D""#,
        false,
    );
}

test "validation of duration strings: a number before the time separator has no unit" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P1D2T3H""#,
        false,
    );
}

test "validation of duration strings: exponent notation is not allowed in a component" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P1e2D""#,
        false,
    );
}

test "validation of duration strings: a trailing newline is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P1D\n""#,
        false,
    );
}

test "validation of duration strings: weeks cannot be combined with a time component" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P1WT1H""#,
        false,
    );
}

test "validation of duration strings: weeks cannot be combined with a zero-valued component" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P0Y1W""#,
        false,
    );
}

test "validation of duration strings: a leading zero in a component is valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P01D""#,
        true,
    );
}

test "validation of duration strings: a component with many digits is valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P999999999999999999999999999999999999999999999999999999999999999999999999999999D""#,
        true,
    );
}

test "validation of duration strings: a comma as the decimal separator is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""PT0,5S""#,
        false,
    );
}

test "validation of duration strings: a sign inside a component is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"duration"}"#,
        #""P-1D""#,
        false,
    );
}

// optional/format/ecmascript-regex.json

test "\\a is not an ECMA 262 control escape: when used as a pattern" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""\\a""#,
        false,
    );
}

test "Python-specific regular expression syntax is not valid ECMA 262: Python named group (?P<name>...) is not ECMA 262" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""(?P<name>x)""#,
        false,
    );
}

test "Python-specific regular expression syntax is not valid ECMA 262: Python named backreference (?P=name) is not ECMA 262" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""(?P<n>a)(?P=n)""#,
        false,
    );
}

test "Python-specific regular expression syntax is not valid ECMA 262: inline comment group (?#...) is not ECMA 262" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""(?#comment)a""#,
        false,
    );
}

test "global inline flag groups are not valid ECMA 262: a single global inline flag (?i)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""(?i)abc""#,
        false,
    );
}

test "global inline flag groups are not valid ECMA 262: multiple global inline flags (?ims)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""(?ims)abc""#,
        false,
    );
}

test "ECMA 262 named groups and backreferences are valid: an ECMA 262 named group (?<name>...)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""(?<name>x)""#,
        true,
    );
}

test "ECMA 262 named groups and backreferences are valid: an ECMA 262 named backreference \\k<name>" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""(?<n>a)\\k<n>""#,
        true,
    );
}

test "ECMA 262 lookbehind is valid, including variable width: a variable-width lookbehind (ES2018)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""(?<=a+)b""#,
        true,
    );
}

test "ECMA 262 character classes and escapes: an empty character class is valid ECMA 262" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""[]""#,
        true,
    );
}

test "ECMA 262 character classes and escapes: a negated empty character class is valid ECMA 262" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""[^]""#,
        true,
    );
}

test "ECMA 262 character classes and escapes: a control escape \\cA is valid ECMA 262" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""\\cA""#,
        true,
    );
}

