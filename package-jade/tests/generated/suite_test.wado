    );
}

test "dependentSchemas with additionalProperties: additionalProperties can't see bar" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo2":{}},"dependentSchemas":{"foo":{},"foo2":{"properties":{"bar":{}}}},"additionalProperties":false}"#,
        #"{"bar":""}"#,
        false,
    );
}

test "dependentSchemas with additionalProperties: additionalProperties can't see bar even when foo2 is present" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo2":{}},"dependentSchemas":{"foo":{},"foo2":{"properties":{"bar":{}}}},"additionalProperties":false}"#,
        #"{"foo2":"","bar":""}"#,
        false,
    );
}

