    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"integer"}"#,
        #""foo""#,
        false,
    );
}

test "integer type matches integers: a string is still not an integer, even if it looks like one" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"integer"}"#,
        #""1""#,
        false,
    );
}

test "integer type matches integers: an object is not an integer" {
