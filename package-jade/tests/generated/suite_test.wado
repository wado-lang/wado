}

test "validation of IRI References: a valid relative IRI Reference with a supplementary-plane character" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"iri-reference"}"#,
        #""/âππ/𐌀""#,
        true,
    );
}

test "validation of IRI References: a query-only IRI Reference with a supplementary private-use char" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"iri-reference"}"#,
        #""?q=󰀀""#,
        true,
    );
}

test "validation of IRI References: a trailing newline after a valid IRI Reference is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"iri-reference"}"#,
        #""/âππ\n""#,
        false,
    );
}

test "validation of IRI References: invalid percent-encoding with non-hex digits" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"iri-reference"}"#,
        #""/%6G""#,
        false,
    );
}

test "validation of IRI References: incomplete percent-encoding triplet" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"iri-reference"}"#,
        #""/%A""#,
        false,
    );
}

test "validation of IRI References: lone percent sign is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"iri-reference"}"#,
        #""/%""#,
        false,
    );
}

test "validation of IRI References: a non-numeric port in a network-path reference is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"iri-reference"}"#,
        #""//ƒøø.ßår:abc/p""#,
        false,
    );
}

