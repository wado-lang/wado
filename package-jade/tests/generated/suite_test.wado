// if-then-else.json

test "ignore if without then or else: valid when valid against lone if" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"const":0}}"#,
        #"0"#,
        true,
    );
}

test "ignore if without then or else: valid when invalid against lone if" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"const":0}}"#,
        #""hello""#,
        true,
    );
}

test "ignore then without if: valid when valid against lone then" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","then":{"const":0}}"#,
        #"0"#,
        true,
    );
}

test "ignore then without if: valid when invalid against lone then" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","then":{"const":0}}"#,
        #""hello""#,
        true,
    );
}

test "ignore else without if: valid when valid against lone else" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","else":{"const":0}}"#,
        #"0"#,
        true,
    );
}

test "ignore else without if: valid when invalid against lone else" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","else":{"const":0}}"#,
        #""hello""#,
        true,
    );
}

test "if and then without else: valid through then" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"exclusiveMaximum":0},"then":{"minimum":-10}}"#,
        #"-1"#,
        true,
    );
}

test "if and then without else: invalid through then" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"exclusiveMaximum":0},"then":{"minimum":-10}}"#,
        #"-100"#,
        false,
    );
}

test "if and then without else: valid when if test fails" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"exclusiveMaximum":0},"then":{"minimum":-10}}"#,
        #"3"#,
        true,
    );
}

test "if and else without then: valid when if test passes" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"exclusiveMaximum":0},"else":{"multipleOf":2}}"#,
        #"-1"#,
        true,
    );
}

test "if and else without then: valid through else" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"exclusiveMaximum":0},"else":{"multipleOf":2}}"#,
        #"4"#,
        true,
    );
}

test "if and else without then: invalid through else" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"exclusiveMaximum":0},"else":{"multipleOf":2}}"#,
        #"3"#,
        false,
    );
}

test "validate against correct branch, then vs else: valid through then" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"exclusiveMaximum":0},"then":{"minimum":-10},"else":{"multipleOf":2}}"#,
        #"-1"#,
        true,
    );
}

test "validate against correct branch, then vs else: invalid through then" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"exclusiveMaximum":0},"then":{"minimum":-10},"else":{"multipleOf":2}}"#,
        #"-100"#,
        false,
    );
}

test "validate against correct branch, then vs else: valid through else" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"exclusiveMaximum":0},"then":{"minimum":-10},"else":{"multipleOf":2}}"#,
        #"4"#,
        true,
    );
}

test "validate against correct branch, then vs else: invalid through else" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"exclusiveMaximum":0},"then":{"minimum":-10},"else":{"multipleOf":2}}"#,
        #"3"#,
        false,
    );
}

test "non-interference across combined schemas: valid, but would have been invalid through then" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"if":{"exclusiveMaximum":0}},{"then":{"minimum":-10}},{"else":{"multipleOf":2}}]}"#,
        #"-100"#,
        true,
    );
}

test "non-interference across combined schemas: valid, but would have been invalid through else" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"if":{"exclusiveMaximum":0}},{"then":{"minimum":-10}},{"else":{"multipleOf":2}}]}"#,
        #"3"#,
        true,
    );
}

test "if with boolean schema true: boolean schema true in if always chooses the then path (valid)" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":true,"then":{"const":"then"},"else":{"const":"else"}}"#,
        #""then""#,
        true,
    );
}

test "if with boolean schema true: boolean schema true in if always chooses the then path (invalid)" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":true,"then":{"const":"then"},"else":{"const":"else"}}"#,
        #""else""#,
        false,
    );
}

test "if with boolean schema false: boolean schema false in if always chooses the else path (invalid)" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":false,"then":{"const":"then"},"else":{"const":"else"}}"#,
        #""then""#,
        false,
    );
}

test "if with boolean schema false: boolean schema false in if always chooses the else path (valid)" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":false,"then":{"const":"then"},"else":{"const":"else"}}"#,
        #""else""#,
        true,
    );
}

test "if appears at the end when serialized (keyword processing sequence): yes redirects to then and passes" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","then":{"const":"yes"},"else":{"const":"other"},"if":{"maxLength":4}}"#,
        #""yes""#,
        true,
    );
}

test "if appears at the end when serialized (keyword processing sequence): other redirects to else and passes" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","then":{"const":"yes"},"else":{"const":"other"},"if":{"maxLength":4}}"#,
        #""other""#,
        true,
    );
}

test "if appears at the end when serialized (keyword processing sequence): no redirects to then and fails" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","then":{"const":"yes"},"else":{"const":"other"},"if":{"maxLength":4}}"#,
        #""no""#,
        false,
    );
}

test "if appears at the end when serialized (keyword processing sequence): invalid redirects to else and fails" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","then":{"const":"yes"},"else":{"const":"other"},"if":{"maxLength":4}}"#,
        #""invalid""#,
        false,
    );
}

test "then: false fails when condition matches: matches if → then=false → invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"const":1},"then":false}"#,
        #"1"#,
        false,
    );
}

test "then: false fails when condition matches: does not match if → then ignored → valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"const":1},"then":false}"#,
        #"2"#,
        true,
    );
}

test "else: false fails when condition does not match: matches if → else ignored → valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"const":1},"else":false}"#,
        #"1"#,
        true,
    );
}

test "else: false fails when condition does not match: does not match if → else executes → invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"const":1},"else":false}"#,
        #"2"#,
        false,
    );
}

// infinite-loop-detection.json

test "evaluating the same schema location against the same data location twice is not a sign of an infinite loop: passing case" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"int":{"type":"integer"}},"allOf":[{"properties":{"foo":{"$ref":"#/$defs/int"}}},{"additionalProperties":{"$ref":"#/$defs/int"}}]}"##,
        #"{"foo":1}"#,
        true,
    );
}

test "evaluating the same schema location against the same data location twice is not a sign of an infinite loop: failing case" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"int":{"type":"integer"}},"allOf":[{"properties":{"foo":{"$ref":"#/$defs/int"}}},{"additionalProperties":{"$ref":"#/$defs/int"}}]}"##,
        #"{"foo":"a string"}"#,
        false,
    );
}

// items.json

test "a schema given for items: valid items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","items":{"type":"integer"}}"#,
        #"[1,2,3]"#,
        true,
    );
}

test "a schema given for items: wrong type of items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","items":{"type":"integer"}}"#,
        #"[1,"x"]"#,
        false,
    );
}

test "a schema given for items: ignores non-arrays" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","items":{"type":"integer"}}"#,
        #"{"foo":"bar"}"#,
        true,
    );
}

test "a schema given for items: JavaScript pseudo-array is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","items":{"type":"integer"}}"#,
        #"{"0":"invalid","length":1}"#,
        true,
    );
}

test "items with boolean schema (true): any array is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","items":true}"#,
        #"[1,"foo",true]"#,
        true,
    );
}

test "items with boolean schema (true): empty array is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","items":true}"#,
        #"[]"#,
        true,
    );
}

test "items with boolean schema (false): any non-empty array is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","items":false}"#,
        #"[1,"foo",true]"#,
        false,
    );
}

test "items with boolean schema (false): empty array is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","items":false}"#,
        #"[]"#,
        true,
    );
}

test "items and subitems: valid items" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"item":{"type":"array","items":false,"prefixItems":[{"$ref":"#/$defs/sub-item"},{"$ref":"#/$defs/sub-item"}]},"sub-item":{"type":"object","required":["foo"]}},"type":"array","items":false,"prefixItems":[{"$ref":"#/$defs/item"},{"$ref":"#/$defs/item"},{"$ref":"#/$defs/item"}]}"##,
        #"[[{"foo":null},{"foo":null}],[{"foo":null},{"foo":null}],[{"foo":null},{"foo":null}]]"#,
        true,
    );
}

test "items and subitems: too many items" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"item":{"type":"array","items":false,"prefixItems":[{"$ref":"#/$defs/sub-item"},{"$ref":"#/$defs/sub-item"}]},"sub-item":{"type":"object","required":["foo"]}},"type":"array","items":false,"prefixItems":[{"$ref":"#/$defs/item"},{"$ref":"#/$defs/item"},{"$ref":"#/$defs/item"}]}"##,
        #"[[{"foo":null},{"foo":null}],[{"foo":null},{"foo":null}],[{"foo":null},{"foo":null}],[{"foo":null},{"foo":null}]]"#,
        false,
    );
}

test "items and subitems: too many sub-items" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"item":{"type":"array","items":false,"prefixItems":[{"$ref":"#/$defs/sub-item"},{"$ref":"#/$defs/sub-item"}]},"sub-item":{"type":"object","required":["foo"]}},"type":"array","items":false,"prefixItems":[{"$ref":"#/$defs/item"},{"$ref":"#/$defs/item"},{"$ref":"#/$defs/item"}]}"##,
        #"[[{"foo":null},{"foo":null},{"foo":null}],[{"foo":null},{"foo":null}],[{"foo":null},{"foo":null}]]"#,
        false,
    );
}

test "items and subitems: wrong item" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"item":{"type":"array","items":false,"prefixItems":[{"$ref":"#/$defs/sub-item"},{"$ref":"#/$defs/sub-item"}]},"sub-item":{"type":"object","required":["foo"]}},"type":"array","items":false,"prefixItems":[{"$ref":"#/$defs/item"},{"$ref":"#/$defs/item"},{"$ref":"#/$defs/item"}]}"##,
        #"[{"foo":null},[{"foo":null},{"foo":null}],[{"foo":null},{"foo":null}]]"#,
        false,
    );
}

test "items and subitems: wrong sub-item" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"item":{"type":"array","items":false,"prefixItems":[{"$ref":"#/$defs/sub-item"},{"$ref":"#/$defs/sub-item"}]},"sub-item":{"type":"object","required":["foo"]}},"type":"array","items":false,"prefixItems":[{"$ref":"#/$defs/item"},{"$ref":"#/$defs/item"},{"$ref":"#/$defs/item"}]}"##,
        #"[[{},{"foo":null}],[{"foo":null},{"foo":null}],[{"foo":null},{"foo":null}]]"#,
        false,
    );
}

test "items and subitems: fewer items is valid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"item":{"type":"array","items":false,"prefixItems":[{"$ref":"#/$defs/sub-item"},{"$ref":"#/$defs/sub-item"}]},"sub-item":{"type":"object","required":["foo"]}},"type":"array","items":false,"prefixItems":[{"$ref":"#/$defs/item"},{"$ref":"#/$defs/item"},{"$ref":"#/$defs/item"}]}"##,
        #"[[{"foo":null}],[{"foo":null}]]"#,
        true,
    );
}

test "nested items: valid nested array" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"array","items":{"type":"array","items":{"type":"array","items":{"type":"array","items":{"type":"number"}}}}}"#,
        #"[[[[1]],[[2],[3]]],[[[4],[5],[6]]]]"#,
        true,
    );
}

test "nested items: nested array with invalid type" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"array","items":{"type":"array","items":{"type":"array","items":{"type":"array","items":{"type":"number"}}}}}"#,
        #"[[[["1"]],[[2],[3]]],[[[4],[5],[6]]]]"#,
        false,
    );
}

test "nested items: not deep enough" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"array","items":{"type":"array","items":{"type":"array","items":{"type":"array","items":{"type":"number"}}}}}"#,
        #"[[[1],[2],[3]],[[4],[5],[6]]]"#,
        false,
    );
}

test "prefixItems with no additional items allowed: empty array" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{},{},{}],"items":false}"#,
        #"[]"#,
        true,
    );
}

test "prefixItems with no additional items allowed: fewer number of items present (1)" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{},{},{}],"items":false}"#,
        #"[1]"#,
        true,
    );
}

test "prefixItems with no additional items allowed: fewer number of items present (2)" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{},{},{}],"items":false}"#,
        #"[1,2]"#,
        true,
    );
}

test "prefixItems with no additional items allowed: equal number of items present" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{},{},{}],"items":false}"#,
        #"[1,2,3]"#,
        true,
    );
}

test "prefixItems with no additional items allowed: additional items are not permitted" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{},{},{}],"items":false}"#,
        #"[1,2,3,4]"#,
        false,
    );
}

test "items does not look in applicators, valid case: prefixItems in allOf does not constrain items, invalid case" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"prefixItems":[{"minimum":3}]}],"items":{"minimum":5}}"#,
        #"[3,5]"#,
        false,
    );
}

test "items does not look in applicators, valid case: prefixItems in allOf does not constrain items, valid case" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"prefixItems":[{"minimum":3}]}],"items":{"minimum":5}}"#,
        #"[5,5]"#,
        true,
    );
}

test "prefixItems validation adjusts the starting index for items: valid items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"string"}],"items":{"type":"integer"}}"#,
        #"["x",2,3]"#,
        true,
    );
}

test "prefixItems validation adjusts the starting index for items: wrong type of second item" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"string"}],"items":{"type":"integer"}}"#,
        #"["x","y"]"#,
        false,
    );
}

test "items with heterogeneous array: heterogeneous invalid instance" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{}],"items":false}"#,
        #"["foo","bar",37]"#,
        false,
    );
}

test "items with heterogeneous array: valid instance" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{}],"items":false}"#,
        #"[null]"#,
        true,
    );
}

test "items with null instance elements: allows null elements" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","items":{"type":"null"}}"#,
        #"[null]"#,
        true,
    );
}

// maxContains.json

test "maxContains without contains is ignored: one item valid against lone maxContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxContains":1}"#,
        #"[1]"#,
        true,
    );
}

test "maxContains without contains is ignored: two items still valid against lone maxContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxContains":1}"#,
        #"[1,2]"#,
        true,
    );
}

test "maxContains with contains: empty data" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"maxContains":1}"#,
        #"[]"#,
        false,
    );
}

test "maxContains with contains: all elements match, valid maxContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"maxContains":1}"#,
        #"[1]"#,
        true,
    );
}

test "maxContains with contains: all elements match, invalid maxContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"maxContains":1}"#,
        #"[1,1]"#,
        false,
    );
}

test "maxContains with contains: some elements match, valid maxContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"maxContains":1}"#,
        #"[1,2]"#,
        true,
    );
}

test "maxContains with contains: some elements match, invalid maxContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"maxContains":1}"#,
        #"[1,2,1]"#,
        false,
    );
}

test "maxContains with contains, value with a decimal: one element matches, valid maxContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"maxContains":1}"#,
        #"[1]"#,
        true,
    );
}

test "maxContains with contains, value with a decimal: too many elements match, invalid maxContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"maxContains":1}"#,
        #"[1,1]"#,
        false,
    );
}

test "minContains < maxContains: actual < minContains < maxContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":1,"maxContains":3}"#,
        #"[]"#,
        false,
    );
}

test "minContains < maxContains: minContains < actual < maxContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":1,"maxContains":3}"#,
        #"[1,1]"#,
        true,
    );
}

test "minContains < maxContains: minContains < maxContains < actual" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":1,"maxContains":3}"#,
        #"[1,1,1,1]"#,
        false,
    );
}

test "maxContains = 0 with minContains = 0: empty array" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":0,"maxContains":0}"#,
        #"[]"#,
        true,
    );
}

test "maxContains = 0 with minContains = 0: one matching item" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":0,"maxContains":0}"#,
        #"[1]"#,
        false,
    );
}

// maxItems.json

test "maxItems validation: shorter is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxItems":2}"#,
        #"[1]"#,
        true,
    );
}

test "maxItems validation: exact length is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxItems":2}"#,
        #"[1,2]"#,
        true,
    );
}

test "maxItems validation: too long is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxItems":2}"#,
        #"[1,2,3]"#,
        false,
    );
}

test "maxItems validation: ignores non-arrays" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxItems":2}"#,
        #""foobar""#,
        true,
    );
}

test "maxItems validation with a decimal: shorter is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxItems":2}"#,
        #"[1]"#,
        true,
    );
}

test "maxItems validation with a decimal: too long is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxItems":2}"#,
        #"[1,2,3]"#,
        false,
    );
}

// maxLength.json

test "maxLength validation: shorter is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxLength":2}"#,
        #""f""#,
        true,
    );
}

test "maxLength validation: exact length is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxLength":2}"#,
        #""fo""#,
        true,
    );
}

test "maxLength validation: too long is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxLength":2}"#,
        #""foo""#,
        false,
    );
}

test "maxLength validation: ignores non-strings" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxLength":2}"#,
        #"100"#,
        true,
    );
}

test "maxLength validation: two graphemes is long enough" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxLength":2}"#,
        #""💩💩""#,
        true,
    );
}

test "maxLength validation with a decimal: shorter is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxLength":2}"#,
        #""f""#,
        true,
    );
}

test "maxLength validation with a decimal: too long is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxLength":2}"#,
        #""foo""#,
        false,
    );
}

// maxProperties.json

test "maxProperties validation: shorter is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxProperties":2}"#,
        #"{"foo":1}"#,
        true,
    );
}

test "maxProperties validation: exact length is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxProperties":2}"#,
        #"{"foo":1,"bar":2}"#,
        true,
    );
}

test "maxProperties validation: too long is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxProperties":2}"#,
        #"{"foo":1,"bar":2,"baz":3}"#,
        false,
    );
}

test "maxProperties validation: ignores arrays" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxProperties":2}"#,
        #"[1,2,3]"#,
        true,
    );
}

test "maxProperties validation: ignores strings" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxProperties":2}"#,
        #""foobar""#,
        true,
    );
}

test "maxProperties validation: ignores other non-objects" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxProperties":2}"#,
        #"12"#,
        true,
    );
}

test "maxProperties validation with a decimal: shorter is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxProperties":2}"#,
        #"{"foo":1}"#,
        true,
    );
}

test "maxProperties validation with a decimal: too long is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxProperties":2}"#,
        #"{"foo":1,"bar":2,"baz":3}"#,
        false,
    );
}

test "maxProperties = 0 means the object is empty: no properties is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxProperties":0}"#,
        #"{}"#,
        true,
    );
}

test "maxProperties = 0 means the object is empty: one property is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxProperties":0}"#,
        #"{"foo":1}"#,
        false,
    );
}

// maximum.json

test "maximum validation: below the maximum is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maximum":3}"#,
        #"2.6"#,
        true,
    );
}

test "maximum validation: boundary point is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maximum":3}"#,
        #"3"#,
        true,
    );
}

test "maximum validation: above the maximum is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maximum":3}"#,
        #"3.5"#,
        false,
    );
}

test "maximum validation: ignores non-numbers" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maximum":3}"#,
        #""x""#,
        true,
    );
}

test "maximum validation with unsigned integer: below the maximum is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maximum":300}"#,
        #"299.97"#,
        true,
    );
}

test "maximum validation with unsigned integer: boundary point integer is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maximum":300}"#,
        #"300"#,
        true,
    );
}

test "maximum validation with unsigned integer: boundary point float is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maximum":300}"#,
        #"300"#,
        true,
    );
}

test "maximum validation with unsigned integer: above the maximum is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maximum":300}"#,
        #"300.5"#,
        false,
    );
}

// minContains.json

test "minContains without contains is ignored: one item valid against lone minContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minContains":1}"#,
        #"[1]"#,
        true,
    );
}

test "minContains without contains is ignored: zero items still valid against lone minContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minContains":1}"#,
        #"[]"#,
        true,
    );
}

test "minContains=1 with contains: empty data" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":1}"#,
        #"[]"#,
        false,
    );
}

test "minContains=1 with contains: no elements match" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":1}"#,
        #"[2]"#,
        false,
    );
}

test "minContains=1 with contains: single element matches, valid minContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":1}"#,
        #"[1]"#,
        true,
    );
}

test "minContains=1 with contains: some elements match, valid minContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":1}"#,
        #"[1,2]"#,
        true,
    );
}

test "minContains=1 with contains: all elements match, valid minContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":1}"#,
        #"[1,1]"#,
        true,
    );
}

test "minContains=2 with contains: empty data" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":2}"#,
        #"[]"#,
        false,
    );
}

test "minContains=2 with contains: all elements match, invalid minContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":2}"#,
        #"[1]"#,
        false,
    );
}

test "minContains=2 with contains: some elements match, invalid minContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":2}"#,
        #"[1,2]"#,
        false,
    );
}

test "minContains=2 with contains: all elements match, valid minContains (exactly as needed)" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":2}"#,
        #"[1,1]"#,
        true,
    );
}

test "minContains=2 with contains: all elements match, valid minContains (more than needed)" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":2}"#,
        #"[1,1,1]"#,
        true,
    );
}

test "minContains=2 with contains: some elements match, valid minContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":2}"#,
        #"[1,2,1]"#,
        true,
    );
}

test "minContains=2 with contains with a decimal value: one element matches, invalid minContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":2}"#,
        #"[1]"#,
        false,
    );
}

test "minContains=2 with contains with a decimal value: both elements match, valid minContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":2}"#,
        #"[1,1]"#,
        true,
    );
}

test "maxContains = minContains: empty data" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"maxContains":2,"minContains":2}"#,
        #"[]"#,
        false,
    );
}

test "maxContains = minContains: all elements match, invalid minContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"maxContains":2,"minContains":2}"#,
        #"[1]"#,
        false,
    );
}

test "maxContains = minContains: all elements match, invalid maxContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"maxContains":2,"minContains":2}"#,
        #"[1,1,1]"#,
        false,
    );
}

test "maxContains = minContains: all elements match, valid maxContains and minContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"maxContains":2,"minContains":2}"#,
        #"[1,1]"#,
        true,
    );
}

test "maxContains < minContains: empty data" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"maxContains":1,"minContains":3}"#,
        #"[]"#,
        false,
    );
}

test "maxContains < minContains: invalid minContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"maxContains":1,"minContains":3}"#,
        #"[1]"#,
        false,
    );
}

test "maxContains < minContains: invalid maxContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"maxContains":1,"minContains":3}"#,
        #"[1,1,1]"#,
        false,
    );
}

test "maxContains < minContains: invalid maxContains and minContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"maxContains":1,"minContains":3}"#,
        #"[1,1]"#,
        false,
    );
}

test "minContains = 0: empty data" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":0}"#,
        #"[]"#,
        true,
    );
}

test "minContains = 0: minContains = 0 makes contains always pass" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":0}"#,
        #"[2]"#,
        true,
    );
}

test "minContains = 0 with maxContains: empty data" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":0,"maxContains":1}"#,
        #"[]"#,
        true,
    );
}

test "minContains = 0 with maxContains: not more than maxContains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":0,"maxContains":1}"#,
        #"[1]"#,
        true,
    );
}

test "minContains = 0 with maxContains: too many" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":1},"minContains":0,"maxContains":1}"#,
        #"[1,1]"#,
        false,
    );
}

// minItems.json

test "minItems validation: longer is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minItems":1}"#,
        #"[1,2]"#,
        true,
    );
}

test "minItems validation: exact length is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minItems":1}"#,
        #"[1]"#,
        true,
    );
}

test "minItems validation: too short is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minItems":1}"#,
        #"[]"#,
        false,
    );
}

test "minItems validation: ignores non-arrays" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minItems":1}"#,
        #""""#,
        true,
    );
}

test "minItems validation with a decimal: longer is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minItems":1}"#,
        #"[1,2]"#,
        true,
    );
}

test "minItems validation with a decimal: too short is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minItems":1}"#,
        #"[]"#,
        false,
    );
}

// minLength.json

test "minLength validation: longer is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minLength":2}"#,
        #""foo""#,
        true,
    );
}

test "minLength validation: exact length is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minLength":2}"#,
        #""fo""#,
        true,
    );
}

test "minLength validation: too short is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minLength":2}"#,
        #""f""#,
        false,
    );
}

test "minLength validation: ignores non-strings" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minLength":2}"#,
        #"1"#,
        true,
    );
}

test "minLength validation: one grapheme is not long enough" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minLength":2}"#,
        #""💩""#,
        false,
    );
}

test "minLength validation with a decimal: longer is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minLength":2}"#,
        #""foo""#,
        true,
    );
}

test "minLength validation with a decimal: too short is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minLength":2}"#,
        #""f""#,
        false,
    );
}

// minProperties.json

test "minProperties validation: longer is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minProperties":1}"#,
        #"{"foo":1,"bar":2}"#,
        true,
    );
}

test "minProperties validation: exact length is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minProperties":1}"#,
        #"{"foo":1}"#,
        true,
    );
}

test "minProperties validation: too short is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minProperties":1}"#,
        #"{}"#,
        false,
    );
}

test "minProperties validation: ignores arrays" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minProperties":1}"#,
        #"[]"#,
        true,
    );
}

test "minProperties validation: ignores strings" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minProperties":1}"#,
        #""""#,
        true,
    );
}

test "minProperties validation: ignores other non-objects" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minProperties":1}"#,
        #"12"#,
        true,
    );
}

test "minProperties validation: ignores null" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minProperties":1}"#,
        #"null"#,
        true,
    );
}

test "minProperties validation: ignores booleans" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minProperties":1}"#,
        #"true"#,
        true,
    );
}

test "minProperties validation with a decimal: longer is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minProperties":1}"#,
        #"{"foo":1,"bar":2}"#,
        true,
    );
}

test "minProperties validation with a decimal: too short is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minProperties":1}"#,
        #"{}"#,
        false,
    );
}

// minimum.json

test "minimum validation: above the minimum is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minimum":1.1}"#,
        #"2.6"#,
        true,
    );
}

test "minimum validation: boundary point is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minimum":1.1}"#,
        #"1.1"#,
        true,
    );
}

test "minimum validation: below the minimum is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minimum":1.1}"#,
        #"0.6"#,
        false,
    );
}

test "minimum validation: ignores non-numbers" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minimum":1.1}"#,
        #""x""#,
        true,
    );
}

test "minimum validation with signed integer: negative above the minimum is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minimum":-2}"#,
        #"-1"#,
        true,
    );
}

test "minimum validation with signed integer: positive above the minimum is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minimum":-2}"#,
        #"0"#,
        true,
    );
}

test "minimum validation with signed integer: boundary point is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minimum":-2}"#,
        #"-2"#,
        true,
    );
}

test "minimum validation with signed integer: boundary point with float is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minimum":-2}"#,
        #"-2"#,
        true,
    );
}

test "minimum validation with signed integer: float below the minimum is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minimum":-2}"#,
        #"-2.0001"#,
        false,
    );
}

test "minimum validation with signed integer: int below the minimum is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minimum":-2}"#,
        #"-3"#,
        false,
    );
}

test "minimum validation with signed integer: ignores non-numbers" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","minimum":-2}"#,
        #""x""#,
        true,
    );
}

// multipleOf.json

test "by int: int by int" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","multipleOf":2}"#,
        #"10"#,
        true,
    );
}

test "by int: int by int fail" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","multipleOf":2}"#,
        #"7"#,
        false,
    );
}

test "by int: ignores non-numbers" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","multipleOf":2}"#,
        #""foo""#,
        true,
    );
}

test "by number: zero is multiple of anything" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","multipleOf":1.5}"#,
        #"0"#,
        true,
    );
}

test "by number: 4.5 is multiple of 1.5" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","multipleOf":1.5}"#,
        #"4.5"#,
        true,
    );
}

test "by number: -4.5 is multiple of 1.5" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","multipleOf":1.5}"#,
        #"-4.5"#,
        true,
    );
}

test "by number: 35 is not multiple of 1.5" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","multipleOf":1.5}"#,
        #"35"#,
        false,
    );
}

test "by small number: 0.0075 is multiple of 0.0001" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","multipleOf":0.0001}"#,
        #"0.0075"#,
        true,
    );
}

test "by small number: 0.00751 is not multiple of 0.0001" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","multipleOf":0.0001}"#,
        #"0.00751"#,
        false,
    );
}

test "by very small number: 4e-8 is multiple of 1e-8" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","multipleOf":0.00000001}"#,
        #"0.00000004"#,
        true,
    );
}

test "by very small number: 1.5e-8 is not multiple of 1e-8" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","multipleOf":0.00000001}"#,
        #"0.000000015"#,
        false,
    );
}

test "float division = inf: always invalid, but naive implementations may raise an overflow error" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"integer","multipleOf":0.123456789}"#,
        #""#,
        false,
    );
}

test "small multiple of large integer: any integer is a multiple of 1e-8" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"integer","multipleOf":0.00000001}"#,
        #"12391239123"#,
        true,
    );
}

// not.json

test "not: allowed" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":{"type":"integer"}}"#,
        #""foo""#,
        true,
    );
}

test "not: disallowed" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":{"type":"integer"}}"#,
        #"1"#,
        false,
    );
}

test "not multiple types: valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":{"type":["integer","boolean"]}}"#,
        #""foo""#,
        true,
    );
}

test "not multiple types: mismatch" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":{"type":["integer","boolean"]}}"#,
        #"1"#,
        false,
    );
}

test "not multiple types: other mismatch" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":{"type":["integer","boolean"]}}"#,
        #"true"#,
        false,
    );
}

test "not more complex schema: match" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":{"type":"object","properties":{"foo":{"type":"string"}}}}"#,
        #"1"#,
        true,
    );
}

test "not more complex schema: other match" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":{"type":"object","properties":{"foo":{"type":"string"}}}}"#,
        #"{"foo":1}"#,
        true,
    );
}

test "not more complex schema: mismatch" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":{"type":"object","properties":{"foo":{"type":"string"}}}}"#,
        #"{"foo":"bar"}"#,
        false,
    );
}

test "forbidden property: property present" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"not":{}}}}"#,
        #"{"foo":1,"bar":2}"#,
        false,
    );
}

test "forbidden property: property absent" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"not":{}}}}"#,
        #"{"bar":1,"baz":2}"#,
        true,
    );
}

test "forbid everything with empty schema: number is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":{}}"#,
        #"1"#,
        false,
    );
}

test "forbid everything with empty schema: string is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":{}}"#,
        #""foo""#,
        false,
    );
}

test "forbid everything with empty schema: boolean true is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":{}}"#,
        #"true"#,
        false,
    );
}

test "forbid everything with empty schema: boolean false is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":{}}"#,
        #"false"#,
        false,
    );
}

test "forbid everything with empty schema: null is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":{}}"#,
        #"null"#,
        false,
    );
}

test "forbid everything with empty schema: object is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":{}}"#,
        #"{"foo":"bar"}"#,
        false,
    );
}

test "forbid everything with empty schema: empty object is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":{}}"#,
        #"{}"#,
        false,
    );
}

test "forbid everything with empty schema: array is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":{}}"#,
        #"["foo"]"#,
        false,
    );
}

test "forbid everything with empty schema: empty array is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":{}}"#,
        #"[]"#,
        false,
    );
}

test "forbid everything with boolean schema true: number is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":true}"#,
        #"1"#,
        false,
    );
}

test "forbid everything with boolean schema true: string is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":true}"#,
        #""foo""#,
        false,
    );
}

test "forbid everything with boolean schema true: boolean true is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":true}"#,
        #"true"#,
        false,
    );
}

test "forbid everything with boolean schema true: boolean false is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":true}"#,
        #"false"#,
        false,
    );
}

test "forbid everything with boolean schema true: null is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":true}"#,
        #"null"#,
        false,
    );
}

test "forbid everything with boolean schema true: object is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":true}"#,
        #"{"foo":"bar"}"#,
        false,
    );
}

test "forbid everything with boolean schema true: empty object is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":true}"#,
        #"{}"#,
        false,
    );
}

test "forbid everything with boolean schema true: array is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":true}"#,
        #"["foo"]"#,
        false,
    );
}

test "forbid everything with boolean schema true: empty array is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":true}"#,
        #"[]"#,
        false,
    );
}

test "allow everything with boolean schema false: number is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":false}"#,
        #"1"#,
        true,
    );
}

test "allow everything with boolean schema false: string is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":false}"#,
        #""foo""#,
        true,
    );
}

test "allow everything with boolean schema false: boolean true is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":false}"#,
        #"true"#,
        true,
    );
}

test "allow everything with boolean schema false: boolean false is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":false}"#,
        #"false"#,
        true,
    );
}

test "allow everything with boolean schema false: null is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":false}"#,
        #"null"#,
        true,
    );
}

test "allow everything with boolean schema false: object is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":false}"#,
        #"{"foo":"bar"}"#,
        true,
    );
}

test "allow everything with boolean schema false: empty object is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":false}"#,
        #"{}"#,
        true,
    );
}

test "allow everything with boolean schema false: array is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":false}"#,
        #"["foo"]"#,
        true,
    );
}

test "allow everything with boolean schema false: empty array is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":false}"#,
        #"[]"#,
        true,
    );
}

test "double negation: any value is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":{"not":{}}}"#,
        #""foo""#,
        true,
    );
}

test "collect annotations inside a 'not', even if collection is disabled: unevaluated property" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":{"$comment":"this subschema must still produce annotations internally, even though the 'not' will ultimately discard them","anyOf":[true,{"properties":{"foo":true}}],"unevaluatedProperties":false}}"#,
        #"{"bar":1}"#,
        true,
    );
}

test "collect annotations inside a 'not', even if collection is disabled: annotations are still collected inside a 'not'" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","not":{"$comment":"this subschema must still produce annotations internally, even though the 'not' will ultimately discard them","anyOf":[true,{"properties":{"foo":true}}],"unevaluatedProperties":false}}"#,
        #"{"foo":1}"#,
        false,
    );
}

// oneOf.json

test "oneOf: first oneOf valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"type":"integer"},{"minimum":2}]}"#,
        #"1"#,
        true,
    );
}

test "oneOf: second oneOf valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"type":"integer"},{"minimum":2}]}"#,
        #"2.5"#,
        true,
    );
}

test "oneOf: both oneOf valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"type":"integer"},{"minimum":2}]}"#,
        #"3"#,
        false,
    );
}

test "oneOf: neither oneOf valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"type":"integer"},{"minimum":2}]}"#,
        #"1.5"#,
        false,
    );
}

test "oneOf with base schema: mismatch base schema" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"string","oneOf":[{"minLength":2},{"maxLength":4}]}"#,
        #"3"#,
        false,
    );
}

test "oneOf with base schema: one oneOf valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"string","oneOf":[{"minLength":2},{"maxLength":4}]}"#,
        #""foobar""#,
        true,
    );
}

test "oneOf with base schema: both oneOf valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"string","oneOf":[{"minLength":2},{"maxLength":4}]}"#,
        #""foo""#,
        false,
    );
}

test "oneOf with boolean schemas, all true: any value is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[true,true,true]}"#,
        #""foo""#,
        false,
    );
}

test "oneOf with boolean schemas, one true: any value is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[true,false,false]}"#,
        #""foo""#,
        true,
    );
}

test "oneOf with boolean schemas, more than one true: any value is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[true,true,false]}"#,
        #""foo""#,
        false,
    );
}

test "oneOf with boolean schemas, all false: any value is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[false,false,false]}"#,
        #""foo""#,
        false,
    );
}

test "oneOf complex types: first oneOf valid (complex)" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"properties":{"bar":{"type":"integer"}},"required":["bar"]},{"properties":{"foo":{"type":"string"}},"required":["foo"]}]}"#,
        #"{"bar":2}"#,
        true,
    );
}

test "oneOf complex types: second oneOf valid (complex)" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"properties":{"bar":{"type":"integer"}},"required":["bar"]},{"properties":{"foo":{"type":"string"}},"required":["foo"]}]}"#,
        #"{"foo":"baz"}"#,
        true,
    );
}

test "oneOf complex types: both oneOf valid (complex)" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"properties":{"bar":{"type":"integer"}},"required":["bar"]},{"properties":{"foo":{"type":"string"}},"required":["foo"]}]}"#,
        #"{"foo":"baz","bar":2}"#,
        false,
    );
}

test "oneOf complex types: neither oneOf valid (complex)" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"properties":{"bar":{"type":"integer"}},"required":["bar"]},{"properties":{"foo":{"type":"string"}},"required":["foo"]}]}"#,
        #"{"foo":2,"bar":"quux"}"#,
        false,
    );
}

test "oneOf with empty schema: one valid - valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"type":"number"},{}]}"#,
        #""foo""#,
        true,
    );
}

test "oneOf with empty schema: both valid - invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"type":"number"},{}]}"#,
        #"123"#,
        false,
    );
}

test "oneOf with required: both invalid - invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","oneOf":[{"required":["foo","bar"]},{"required":["foo","baz"]}]}"#,
        #"{"bar":2}"#,
        false,
    );
}

test "oneOf with required: first valid - valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","oneOf":[{"required":["foo","bar"]},{"required":["foo","baz"]}]}"#,
        #"{"foo":1,"bar":2}"#,
        true,
    );
}

test "oneOf with required: second valid - valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","oneOf":[{"required":["foo","bar"]},{"required":["foo","baz"]}]}"#,
        #"{"foo":1,"baz":3}"#,
        true,
    );
}

test "oneOf with required: both valid - invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","oneOf":[{"required":["foo","bar"]},{"required":["foo","baz"]}]}"#,
        #"{"foo":1,"bar":2,"baz":3}"#,
        false,
    );
}

test "oneOf with missing optional property: first oneOf valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"properties":{"bar":true,"baz":true},"required":["bar"]},{"properties":{"foo":true},"required":["foo"]}]}"#,
        #"{"bar":8}"#,
        true,
    );
}

test "oneOf with missing optional property: second oneOf valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"properties":{"bar":true,"baz":true},"required":["bar"]},{"properties":{"foo":true},"required":["foo"]}]}"#,
        #"{"foo":"foo"}"#,
        true,
    );
}

test "oneOf with missing optional property: both oneOf valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"properties":{"bar":true,"baz":true},"required":["bar"]},{"properties":{"foo":true},"required":["foo"]}]}"#,
        #"{"foo":"foo","bar":8}"#,
        false,
    );
}

test "oneOf with missing optional property: neither oneOf valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"properties":{"bar":true,"baz":true},"required":["bar"]},{"properties":{"foo":true},"required":["foo"]}]}"#,
        #"{"baz":"quux"}"#,
        false,
    );
}

test "nested oneOf, to check validation semantics: null is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"oneOf":[{"type":"null"}]}]}"#,
        #"null"#,
        true,
    );
}

test "nested oneOf, to check validation semantics: anything non-null is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"oneOf":[{"type":"null"}]}]}"#,
        #"123"#,
        false,
    );
}

// pattern.json

test "pattern validation: a matching pattern is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","pattern":"^a*$"}"#,
        #""aaa""#,
        true,
    );
}

test "pattern validation: a non-matching pattern is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","pattern":"^a*$"}"#,
        #""abc""#,
        false,
    );
}

test "pattern validation: ignores booleans" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","pattern":"^a*$"}"#,
        #"true"#,
        true,
    );
}

test "pattern validation: ignores integers" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","pattern":"^a*$"}"#,
        #"123"#,
        true,
    );
}

test "pattern validation: ignores floats" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","pattern":"^a*$"}"#,
        #"1"#,
        true,
    );
}

test "pattern validation: ignores objects" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","pattern":"^a*$"}"#,
        #"{}"#,
        true,
    );
}

test "pattern validation: ignores arrays" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","pattern":"^a*$"}"#,
        #"[]"#,
        true,
    );
}

test "pattern validation: ignores null" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","pattern":"^a*$"}"#,
        #"null"#,
        true,
    );
}

test "pattern is not anchored: matches a substring" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","pattern":"a+"}"#,
        #""xxaayy""#,
        true,
    );
}

test "pattern with Unicode property escape requires unicode mode: ASCII letters match" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"string","pattern":"^\\p{Letter}+$"}"#,
        #""Hello""#,
        true,
    );
}

test "pattern with Unicode property escape requires unicode mode: Non-ASCII letters match" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"string","pattern":"^\\p{Letter}+$"}"#,
        #""π""#,
        true,
    );
}

test "pattern with Unicode property escape requires unicode mode: Digits do not match" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"string","pattern":"^\\p{Letter}+$"}"#,
        #""123""#,
        false,
    );
}

// patternProperties.json

test "patternProperties validates properties matching a regex: a single valid match is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"f.*o":{"type":"integer"}}}"#,
        #"{"foo":1}"#,
        true,
    );
}

test "patternProperties validates properties matching a regex: multiple valid matches is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"f.*o":{"type":"integer"}}}"#,
        #"{"foo":1,"foooooo":2}"#,
        true,
    );
}

test "patternProperties validates properties matching a regex: a single invalid match is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"f.*o":{"type":"integer"}}}"#,
        #"{"foo":"bar","fooooo":2}"#,
        false,
    );
}

test "patternProperties validates properties matching a regex: multiple invalid matches is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"f.*o":{"type":"integer"}}}"#,
        #"{"foo":"bar","foooooo":"baz"}"#,
        false,
    );
}

test "patternProperties validates properties matching a regex: ignores arrays" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"f.*o":{"type":"integer"}}}"#,
        #"["foo"]"#,
        true,
    );
}

test "patternProperties validates properties matching a regex: ignores strings" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"f.*o":{"type":"integer"}}}"#,
        #""foo""#,
        true,
    );
}

test "patternProperties validates properties matching a regex: ignores other non-objects" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"f.*o":{"type":"integer"}}}"#,
        #"12"#,
        true,
    );
}

test "multiple simultaneous patternProperties are validated: a single valid match is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"a*":{"type":"integer"},"aaa*":{"maximum":20}}}"#,
        #"{"a":21}"#,
        true,
    );
}

test "multiple simultaneous patternProperties are validated: a simultaneous match is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"a*":{"type":"integer"},"aaa*":{"maximum":20}}}"#,
        #"{"aaaa":18}"#,
        true,
    );
}

test "multiple simultaneous patternProperties are validated: multiple matches is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"a*":{"type":"integer"},"aaa*":{"maximum":20}}}"#,
        #"{"a":21,"aaaa":18}"#,
        true,
    );
}

test "multiple simultaneous patternProperties are validated: an invalid due to one is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"a*":{"type":"integer"},"aaa*":{"maximum":20}}}"#,
        #"{"a":"bar"}"#,
        false,
    );
}

test "multiple simultaneous patternProperties are validated: an invalid due to the other is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"a*":{"type":"integer"},"aaa*":{"maximum":20}}}"#,
        #"{"aaaa":31}"#,
        false,
    );
}

test "multiple simultaneous patternProperties are validated: an invalid due to both is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"a*":{"type":"integer"},"aaa*":{"maximum":20}}}"#,
        #"{"aaa":"foo","aaaa":31}"#,
        false,
    );
}

test "regexes are not anchored by default and are case sensitive: non recognized members are ignored" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"[0-9]{2,}":{"type":"boolean"},"X_":{"type":"string"}}}"#,
        #"{"answer 1":"42"}"#,
        true,
    );
}

test "regexes are not anchored by default and are case sensitive: recognized members are accounted for" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"[0-9]{2,}":{"type":"boolean"},"X_":{"type":"string"}}}"#,
        #"{"a31b":null}"#,
        false,
    );
}

test "regexes are not anchored by default and are case sensitive: regexes are case sensitive" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"[0-9]{2,}":{"type":"boolean"},"X_":{"type":"string"}}}"#,
        #"{"a_x_3":3}"#,
        true,
    );
}

test "regexes are not anchored by default and are case sensitive: regexes are case sensitive, 2" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"[0-9]{2,}":{"type":"boolean"},"X_":{"type":"string"}}}"#,
        #"{"a_X_3":3}"#,
        false,
    );
}

test "patternProperties with boolean schemas: object with property matching schema true is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"f.*":true,"b.*":false}}"#,
        #"{"foo":1}"#,
        true,
    );
}

test "patternProperties with boolean schemas: object with property matching schema false is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"f.*":true,"b.*":false}}"#,
        #"{"bar":2}"#,
        false,
    );
}

test "patternProperties with boolean schemas: object with both properties is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"f.*":true,"b.*":false}}"#,
        #"{"foo":1,"bar":2}"#,
        false,
    );
}

test "patternProperties with boolean schemas: object with a property matching both true and false is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"f.*":true,"b.*":false}}"#,
        #"{"foobar":1}"#,
        false,
    );
}

test "patternProperties with boolean schemas: empty object is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"f.*":true,"b.*":false}}"#,
        #"{}"#,
        true,
    );
}

test "patternProperties with null valued instance properties: allows null values" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"^.*bar$":{"type":"null"}}}"#,
        #"{"foobar":null}"#,
        true,
    );
}

test "patternProperties with Unicode property escape: Unicode letter property name matches" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","patternProperties":{"^\\p{Letter}+$":{"type":"number"}}}"#,
        #"{"π":1}"#,
        true,
    );
}

test "patternProperties with Unicode property escape: Unicode letter property name matches but value type is incorrect" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","patternProperties":{"^\\p{Letter}+$":{"type":"number"}}}"#,
        #"{"π":"1"}"#,
        false,
    );
}

test "patternProperties with Unicode property escape: Non-letter property name does not match pattern" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","patternProperties":{"^\\p{Letter}+$":{"type":"number"}}}"#,
        #"{"123":1}"#,
        true,
    );
}

// prefixItems.json

test "a schema given for prefixItems: correct types" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"integer"},{"type":"string"}]}"#,
        #"[1,"foo"]"#,
        true,
    );
}

test "a schema given for prefixItems: wrong types" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"integer"},{"type":"string"}]}"#,
        #"["foo",1]"#,
        false,
    );
}

test "a schema given for prefixItems: incomplete array of items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"integer"},{"type":"string"}]}"#,
        #"[1]"#,
        true,
    );
}

test "a schema given for prefixItems: array with additional items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"integer"},{"type":"string"}]}"#,
        #"[1,"foo",true]"#,
        true,
    );
}

test "a schema given for prefixItems: empty array" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"integer"},{"type":"string"}]}"#,
        #"[]"#,
        true,
    );
}

test "a schema given for prefixItems: JavaScript pseudo-array is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"integer"},{"type":"string"}]}"#,
        #"{"0":"invalid","1":"valid","length":2}"#,
        true,
    );
}

test "prefixItems with boolean schemas: array with one item is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[true,false]}"#,
        #"[1]"#,
        true,
    );
}

test "prefixItems with boolean schemas: array with two items is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[true,false]}"#,
        #"[1,"foo"]"#,
        false,
    );
}

test "prefixItems with boolean schemas: empty array is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[true,false]}"#,
        #"[]"#,
        true,
    );
}

test "additional items are allowed by default: only the first item is validated" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"integer"}]}"#,
        #"[1,"foo",false]"#,
        true,
    );
}

test "prefixItems with null instance elements: allows null elements" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"null"}]}"#,
        #"[null]"#,
        true,
    );
}

// properties.json

test "object properties validation: both properties present and valid is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"integer"},"bar":{"type":"string"}}}"#,
        #"{"foo":1,"bar":"baz"}"#,
        true,
    );
}

test "object properties validation: one property invalid is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"integer"},"bar":{"type":"string"}}}"#,
        #"{"foo":1,"bar":{}}"#,
        false,
    );
}

test "object properties validation: both properties invalid is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"integer"},"bar":{"type":"string"}}}"#,
        #"{"foo":[],"bar":{}}"#,
        false,
    );
}

test "object properties validation: doesn't invalidate other properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"integer"},"bar":{"type":"string"}}}"#,
        #"{"quux":[]}"#,
        true,
    );
}

test "object properties validation: ignores arrays" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"integer"},"bar":{"type":"string"}}}"#,
        #"[]"#,
        true,
    );
}

test "object properties validation: ignores other non-objects" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"integer"},"bar":{"type":"string"}}}"#,
        #"12"#,
        true,
    );
}

test "properties, patternProperties, additionalProperties interaction: property validates property" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"array","maxItems":3},"bar":{"type":"array"}},"patternProperties":{"f.o":{"minItems":2}},"additionalProperties":{"type":"integer"}}"#,
        #"{"foo":[1,2]}"#,
        true,
    );
}

test "properties, patternProperties, additionalProperties interaction: property invalidates property" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"array","maxItems":3},"bar":{"type":"array"}},"patternProperties":{"f.o":{"minItems":2}},"additionalProperties":{"type":"integer"}}"#,
        #"{"foo":[1,2,3,4]}"#,
        false,
    );
}

test "properties, patternProperties, additionalProperties interaction: patternProperty invalidates property" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"array","maxItems":3},"bar":{"type":"array"}},"patternProperties":{"f.o":{"minItems":2}},"additionalProperties":{"type":"integer"}}"#,
        #"{"foo":[]}"#,
        false,
    );
}

test "properties, patternProperties, additionalProperties interaction: patternProperty validates nonproperty" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"array","maxItems":3},"bar":{"type":"array"}},"patternProperties":{"f.o":{"minItems":2}},"additionalProperties":{"type":"integer"}}"#,
        #"{"fxo":[1,2]}"#,
        true,
    );
}

test "properties, patternProperties, additionalProperties interaction: patternProperty invalidates nonproperty" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"array","maxItems":3},"bar":{"type":"array"}},"patternProperties":{"f.o":{"minItems":2}},"additionalProperties":{"type":"integer"}}"#,
        #"{"fxo":[]}"#,
        false,
    );
}

test "properties, patternProperties, additionalProperties interaction: additionalProperty ignores property" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"array","maxItems":3},"bar":{"type":"array"}},"patternProperties":{"f.o":{"minItems":2}},"additionalProperties":{"type":"integer"}}"#,
        #"{"bar":[]}"#,
        true,
    );
}

test "properties, patternProperties, additionalProperties interaction: additionalProperty validates others" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"array","maxItems":3},"bar":{"type":"array"}},"patternProperties":{"f.o":{"minItems":2}},"additionalProperties":{"type":"integer"}}"#,
        #"{"quux":3}"#,
        true,
    );
}

test "properties, patternProperties, additionalProperties interaction: additionalProperty invalidates others" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"array","maxItems":3},"bar":{"type":"array"}},"patternProperties":{"f.o":{"minItems":2}},"additionalProperties":{"type":"integer"}}"#,
        #"{"quux":"foo"}"#,
        false,
    );
}

test "properties with boolean schema: no property present is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":true,"bar":false}}"#,
        #"{}"#,
        true,
    );
}

test "properties with boolean schema: only 'true' property present is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":true,"bar":false}}"#,
        #"{"foo":1}"#,
        true,
    );
}

test "properties with boolean schema: only 'false' property present is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":true,"bar":false}}"#,
        #"{"bar":2}"#,
        false,
    );
}

test "properties with boolean schema: both properties present is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":true,"bar":false}}"#,
        #"{"foo":1,"bar":2}"#,
        false,
    );
}

test "properties with escaped characters: object with all numbers is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo\nbar":{"type":"number"},"foo\"bar":{"type":"number"},"foo\\bar":{"type":"number"},"foo\rbar":{"type":"number"},"foo\tbar":{"type":"number"},"foo\fbar":{"type":"number"}}}"#,
        #"{"foo\nbar":1,"foo\"bar":1,"foo\\bar":1,"foo\rbar":1,"foo\tbar":1,"foo\fbar":1}"#,
        true,
    );
}

test "properties with escaped characters: object with strings is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo\nbar":{"type":"number"},"foo\"bar":{"type":"number"},"foo\\bar":{"type":"number"},"foo\rbar":{"type":"number"},"foo\tbar":{"type":"number"},"foo\fbar":{"type":"number"}}}"#,
        #"{"foo\nbar":"1","foo\"bar":"1","foo\\bar":"1","foo\rbar":"1","foo\tbar":"1","foo\fbar":"1"}"#,
        false,
    );
}

test "properties with null valued instance properties: allows null values" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"null"}}}"#,
        #"{"foo":null}"#,
        true,
    );
}

test "properties whose names are Javascript object property names: ignores arrays" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"__proto__":{"type":"number"},"toString":{"properties":{"length":{"type":"string"}}},"constructor":{"type":"number"}}}"#,
        #"[]"#,
        true,
    );
}

test "properties whose names are Javascript object property names: ignores other non-objects" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"__proto__":{"type":"number"},"toString":{"properties":{"length":{"type":"string"}}},"constructor":{"type":"number"}}}"#,
        #"12"#,
        true,
    );
}

test "properties whose names are Javascript object property names: none of the properties mentioned" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"__proto__":{"type":"number"},"toString":{"properties":{"length":{"type":"string"}}},"constructor":{"type":"number"}}}"#,
        #"{}"#,
        true,
    );
}

test "properties whose names are Javascript object property names: __proto__ not valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"__proto__":{"type":"number"},"toString":{"properties":{"length":{"type":"string"}}},"constructor":{"type":"number"}}}"#,
        #"{"__proto__":"foo"}"#,
        false,
    );
}

test "properties whose names are Javascript object property names: toString not valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"__proto__":{"type":"number"},"toString":{"properties":{"length":{"type":"string"}}},"constructor":{"type":"number"}}}"#,
        #"{"toString":{"length":37}}"#,
        false,
    );
}

test "properties whose names are Javascript object property names: constructor not valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"__proto__":{"type":"number"},"toString":{"properties":{"length":{"type":"string"}}},"constructor":{"type":"number"}}}"#,
        #"{"constructor":{"length":37}}"#,
        false,
    );
}

test "properties whose names are Javascript object property names: all present and valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"__proto__":{"type":"number"},"toString":{"properties":{"length":{"type":"string"}}},"constructor":{"type":"number"}}}"#,
        #"{"__proto__":12,"toString":{"length":"foo"},"constructor":37}"#,
        true,
    );
}

// propertyNames.json

test "propertyNames validation: all property names valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":{"maxLength":3}}"#,
        #"{"f":{},"foo":{}}"#,
        true,
    );
}

test "propertyNames validation: some property names invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":{"maxLength":3}}"#,
        #"{"foo":{},"foobar":{}}"#,
        false,
    );
}

test "propertyNames validation: object without properties is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":{"maxLength":3}}"#,
        #"{}"#,
        true,
    );
}

test "propertyNames validation: ignores arrays" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":{"maxLength":3}}"#,
        #"[1,2,3,4]"#,
        true,
    );
}

test "propertyNames validation: ignores strings" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":{"maxLength":3}}"#,
        #""foobar""#,
        true,
    );
}

test "propertyNames validation: ignores other non-objects" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":{"maxLength":3}}"#,
        #"12"#,
        true,
    );
}

test "propertyNames validation: ignores null" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":{"maxLength":3}}"#,
        #"null"#,
        true,
    );
}

test "propertyNames validation: ignores booleans" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":{"maxLength":3}}"#,
        #"true"#,
        true,
    );
}

test "propertyNames validation with pattern: matching property names valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":{"pattern":"^a+$"}}"#,
        #"{"a":{},"aa":{},"aaa":{}}"#,
        true,
    );
}

test "propertyNames validation with pattern: non-matching property name is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":{"pattern":"^a+$"}}"#,
        #"{"aaA":{}}"#,
        false,
    );
}

test "propertyNames validation with pattern: object without properties is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":{"pattern":"^a+$"}}"#,
        #"{}"#,
        true,
    );
}

test "propertyNames with boolean schema true: object with any properties is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":true}"#,
        #"{"foo":1}"#,
        true,
    );
}

test "propertyNames with boolean schema true: empty object is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":true}"#,
        #"{}"#,
        true,
    );
}

test "propertyNames with boolean schema false: object with any properties is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":false}"#,
        #"{"foo":1}"#,
        false,
    );
}

test "propertyNames with boolean schema false: empty object is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":false}"#,
        #"{}"#,
        true,
    );
}

test "propertyNames with const: object with property foo is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":{"const":"foo"}}"#,
        #"{"foo":1}"#,
        true,
    );
}

test "propertyNames with const: object with any other property is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":{"const":"foo"}}"#,
        #"{"bar":1}"#,
        false,
    );
}

test "propertyNames with const: empty object is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":{"const":"foo"}}"#,
        #"{}"#,
        true,
    );
}

test "propertyNames with enum: object with property foo is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":{"enum":["foo","bar"]}}"#,
        #"{"foo":1}"#,
        true,
    );
}

test "propertyNames with enum: object with property foo and bar is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":{"enum":["foo","bar"]}}"#,
        #"{"foo":1,"bar":1}"#,
        true,
    );
}

test "propertyNames with enum: object with any other property is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":{"enum":["foo","bar"]}}"#,
        #"{"baz":1}"#,
        false,
    );
}

test "propertyNames with enum: empty object is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":{"enum":["foo","bar"]}}"#,
        #"{}"#,
        true,
    );
}

// ref.json

test "root pointer ref: match" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"$ref":"#"}},"additionalProperties":false}"##,
        #"{"foo":false}"#,
        true,
    );
}

test "root pointer ref: recursive match" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"$ref":"#"}},"additionalProperties":false}"##,
        #"{"foo":{"foo":false}}"#,
        true,
    );
}

test "root pointer ref: mismatch" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"$ref":"#"}},"additionalProperties":false}"##,
        #"{"bar":false}"#,
        false,
    );
}

test "root pointer ref: recursive mismatch" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"$ref":"#"}},"additionalProperties":false}"##,
        #"{"foo":{"bar":false}}"#,
        false,
    );
}

test "relative pointer ref to object: match" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"integer"},"bar":{"$ref":"#/properties/foo"}}}"##,
        #"{"bar":3}"#,
        true,
    );
}

test "relative pointer ref to object: mismatch" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"integer"},"bar":{"$ref":"#/properties/foo"}}}"##,
        #"{"bar":true}"#,
        false,
    );
}

test "relative pointer ref to array: match array" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"integer"},{"$ref":"#/prefixItems/0"}]}"##,
        #"[1,2]"#,
        true,
    );
}

test "relative pointer ref to array: mismatch array" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"integer"},{"$ref":"#/prefixItems/0"}]}"##,
        #"[1,"foo"]"#,
        false,
    );
}

test "escaped pointer ref: slash invalid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"tilde~field":{"type":"integer"},"slash/field":{"type":"integer"},"percent%field":{"type":"integer"}},"properties":{"tilde":{"$ref":"#/$defs/tilde~0field"},"slash":{"$ref":"#/$defs/slash~1field"},"percent":{"$ref":"#/$defs/percent%25field"}}}"##,
        #"{"slash":"aoeu"}"#,
        false,
    );
}

test "escaped pointer ref: tilde invalid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"tilde~field":{"type":"integer"},"slash/field":{"type":"integer"},"percent%field":{"type":"integer"}},"properties":{"tilde":{"$ref":"#/$defs/tilde~0field"},"slash":{"$ref":"#/$defs/slash~1field"},"percent":{"$ref":"#/$defs/percent%25field"}}}"##,
        #"{"tilde":"aoeu"}"#,
        false,
    );
}

test "escaped pointer ref: percent invalid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"tilde~field":{"type":"integer"},"slash/field":{"type":"integer"},"percent%field":{"type":"integer"}},"properties":{"tilde":{"$ref":"#/$defs/tilde~0field"},"slash":{"$ref":"#/$defs/slash~1field"},"percent":{"$ref":"#/$defs/percent%25field"}}}"##,
        #"{"percent":"aoeu"}"#,
        false,
    );
}

test "escaped pointer ref: slash valid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"tilde~field":{"type":"integer"},"slash/field":{"type":"integer"},"percent%field":{"type":"integer"}},"properties":{"tilde":{"$ref":"#/$defs/tilde~0field"},"slash":{"$ref":"#/$defs/slash~1field"},"percent":{"$ref":"#/$defs/percent%25field"}}}"##,
        #"{"slash":123}"#,
        true,
    );
}

test "escaped pointer ref: tilde valid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"tilde~field":{"type":"integer"},"slash/field":{"type":"integer"},"percent%field":{"type":"integer"}},"properties":{"tilde":{"$ref":"#/$defs/tilde~0field"},"slash":{"$ref":"#/$defs/slash~1field"},"percent":{"$ref":"#/$defs/percent%25field"}}}"##,
        #"{"tilde":123}"#,
        true,
    );
}

test "escaped pointer ref: percent valid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"tilde~field":{"type":"integer"},"slash/field":{"type":"integer"},"percent%field":{"type":"integer"}},"properties":{"tilde":{"$ref":"#/$defs/tilde~0field"},"slash":{"$ref":"#/$defs/slash~1field"},"percent":{"$ref":"#/$defs/percent%25field"}}}"##,
        #"{"percent":123}"#,
        true,
    );
}

test "nested refs: nested ref valid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"a":{"type":"integer"},"b":{"$ref":"#/$defs/a"},"c":{"$ref":"#/$defs/b"}},"$ref":"#/$defs/c"}"##,
        #"5"#,
        true,
    );
}

test "nested refs: nested ref invalid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"a":{"type":"integer"},"b":{"$ref":"#/$defs/a"},"c":{"$ref":"#/$defs/b"}},"$ref":"#/$defs/c"}"##,
        #""a""#,
        false,
    );
}

test "ref applies alongside sibling keywords: ref valid, maxItems valid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"reffed":{"type":"array"}},"properties":{"foo":{"$ref":"#/$defs/reffed","maxItems":2}}}"##,
        #"{"foo":[]}"#,
        true,
    );
}

test "ref applies alongside sibling keywords: ref valid, maxItems invalid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"reffed":{"type":"array"}},"properties":{"foo":{"$ref":"#/$defs/reffed","maxItems":2}}}"##,
        #"{"foo":[1,2,3]}"#,
        false,
    );
}

test "ref applies alongside sibling keywords: ref invalid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"reffed":{"type":"array"}},"properties":{"foo":{"$ref":"#/$defs/reffed","maxItems":2}}}"##,
        #"{"foo":"string"}"#,
        false,
    );
}

test "remote ref, containing refs itself: remote ref valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","$ref":"https://json-schema.org/draft/2020-12/schema"}"#,
        #"{"minLength":1}"#,
        true,
    );
}

test "remote ref, containing refs itself: remote ref invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","$ref":"https://json-schema.org/draft/2020-12/schema"}"#,
        #"{"minLength":-1}"#,
        false,
    );
}

test "property named $ref that is not a reference: property named $ref valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"$ref":{"type":"string"}}}"#,
        #"{"$ref":"a"}"#,
        true,
    );
}

test "property named $ref that is not a reference: property named $ref invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"$ref":{"type":"string"}}}"#,
        #"{"$ref":2}"#,
        false,
    );
}

test "property named $ref, containing an actual $ref: property named $ref valid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"$ref":{"$ref":"#/$defs/is-string"}},"$defs":{"is-string":{"type":"string"}}}"##,
        #"{"$ref":"a"}"#,
        true,
    );
}

test "property named $ref, containing an actual $ref: property named $ref invalid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"$ref":{"$ref":"#/$defs/is-string"}},"$defs":{"is-string":{"type":"string"}}}"##,
        #"{"$ref":2}"#,
        false,
    );
}

test "$ref to boolean schema true: any value is valid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$ref":"#/$defs/bool","$defs":{"bool":true}}"##,
        #""foo""#,
        true,
    );
}

test "$ref to boolean schema false: any value is invalid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$ref":"#/$defs/bool","$defs":{"bool":false}}"##,
        #""foo""#,
        false,
    );
}

test "Recursive references between schemas: valid tree" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"http://localhost:1234/draft2020-12/tree","description":"tree of nodes","type":"object","properties":{"meta":{"type":"string"},"nodes":{"type":"array","items":{"$ref":"node"}}},"required":["meta","nodes"],"$defs":{"node":{"$id":"http://localhost:1234/draft2020-12/node","description":"node","type":"object","properties":{"value":{"type":"number"},"subtree":{"$ref":"tree"}},"required":["value"]}}}"#,
        #"{"meta":"root","nodes":[{"value":1,"subtree":{"meta":"child","nodes":[{"value":1.1},{"value":1.2}]}},{"value":2,"subtree":{"meta":"child","nodes":[{"value":2.1},{"value":2.2}]}}]}"#,
        true,
    );
}

test "Recursive references between schemas: invalid tree" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"http://localhost:1234/draft2020-12/tree","description":"tree of nodes","type":"object","properties":{"meta":{"type":"string"},"nodes":{"type":"array","items":{"$ref":"node"}}},"required":["meta","nodes"],"$defs":{"node":{"$id":"http://localhost:1234/draft2020-12/node","description":"node","type":"object","properties":{"value":{"type":"number"},"subtree":{"$ref":"tree"}},"required":["value"]}}}"#,
        #"{"meta":"root","nodes":[{"value":1,"subtree":{"meta":"child","nodes":[{"value":"string is invalid"},{"value":1.2}]}},{"value":2,"subtree":{"meta":"child","nodes":[{"value":2.1},{"value":2.2}]}}]}"#,
        false,
    );
}

test "refs with quote: object with numbers is valid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo\"bar":{"$ref":"#/$defs/foo%22bar"}},"$defs":{"foo\"bar":{"type":"number"}}}"##,
        #"{"foo\"bar":1}"#,
        true,
    );
}

test "refs with quote: object with strings is invalid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo\"bar":{"$ref":"#/$defs/foo%22bar"}},"$defs":{"foo\"bar":{"type":"number"}}}"##,
        #"{"foo\"bar":"1"}"#,
        false,
    );
}

test "ref creates new scope when adjacent to keywords: referenced subschema doesn't see annotations from properties" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"A":{"unevaluatedProperties":false}},"properties":{"prop1":{"type":"string"}},"$ref":"#/$defs/A"}"##,
        #"{"prop1":"match"}"#,
        false,
    );
}

test "naive replacement of $ref with its destination is not correct: do not evaluate the $ref inside the enum, matching any string" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"a_string":{"type":"string"}},"enum":[{"$ref":"#/$defs/a_string"}]}"##,
        #""this is a string""#,
        false,
    );
}

test "naive replacement of $ref with its destination is not correct: do not evaluate the $ref inside the enum, definition exact match" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"a_string":{"type":"string"}},"enum":[{"$ref":"#/$defs/a_string"}]}"##,
        #"{"type":"string"}"#,
        false,
    );
}

test "naive replacement of $ref with its destination is not correct: match the enum exactly" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"a_string":{"type":"string"}},"enum":[{"$ref":"#/$defs/a_string"}]}"##,
        ##"{"$ref":"#/$defs/a_string"}"##,
        true,
    );
}

test "refs with relative uris and defs: invalid on inner field" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"http://example.com/schema-relative-uri-defs1.json","properties":{"foo":{"$id":"schema-relative-uri-defs2.json","$defs":{"inner":{"properties":{"bar":{"type":"string"}}}},"$ref":"#/$defs/inner"}},"$ref":"schema-relative-uri-defs2.json"}"##,
        #"{"foo":{"bar":1},"bar":"a"}"#,
        false,
    );
}

test "refs with relative uris and defs: invalid on outer field" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"http://example.com/schema-relative-uri-defs1.json","properties":{"foo":{"$id":"schema-relative-uri-defs2.json","$defs":{"inner":{"properties":{"bar":{"type":"string"}}}},"$ref":"#/$defs/inner"}},"$ref":"schema-relative-uri-defs2.json"}"##,
        #"{"foo":{"bar":"a"},"bar":1}"#,
        false,
    );
}

test "refs with relative uris and defs: valid on both fields" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"http://example.com/schema-relative-uri-defs1.json","properties":{"foo":{"$id":"schema-relative-uri-defs2.json","$defs":{"inner":{"properties":{"bar":{"type":"string"}}}},"$ref":"#/$defs/inner"}},"$ref":"schema-relative-uri-defs2.json"}"##,
        #"{"foo":{"bar":"a"},"bar":"a"}"#,
        true,
    );
}

test "relative refs with absolute uris and defs: invalid on inner field" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"http://example.com/schema-refs-absolute-uris-defs1.json","properties":{"foo":{"$id":"http://example.com/schema-refs-absolute-uris-defs2.json","$defs":{"inner":{"properties":{"bar":{"type":"string"}}}},"$ref":"#/$defs/inner"}},"$ref":"schema-refs-absolute-uris-defs2.json"}"##,
        #"{"foo":{"bar":1},"bar":"a"}"#,
        false,
    );
}

test "relative refs with absolute uris and defs: invalid on outer field" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"http://example.com/schema-refs-absolute-uris-defs1.json","properties":{"foo":{"$id":"http://example.com/schema-refs-absolute-uris-defs2.json","$defs":{"inner":{"properties":{"bar":{"type":"string"}}}},"$ref":"#/$defs/inner"}},"$ref":"schema-refs-absolute-uris-defs2.json"}"##,
        #"{"foo":{"bar":"a"},"bar":1}"#,
        false,
    );
}

test "relative refs with absolute uris and defs: valid on both fields" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"http://example.com/schema-refs-absolute-uris-defs1.json","properties":{"foo":{"$id":"http://example.com/schema-refs-absolute-uris-defs2.json","$defs":{"inner":{"properties":{"bar":{"type":"string"}}}},"$ref":"#/$defs/inner"}},"$ref":"schema-refs-absolute-uris-defs2.json"}"##,
        #"{"foo":{"bar":"a"},"bar":"a"}"#,
        true,
    );
}

test "$id must be resolved against nearest parent, not just immediate parent: number is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"http://example.com/a.json","$defs":{"x":{"$id":"http://example.com/b/c.json","not":{"$defs":{"y":{"$id":"d.json","type":"number"}}}}},"allOf":[{"$ref":"http://example.com/b/d.json"}]}"#,
        #"1"#,
        true,
    );
}

test "$id must be resolved against nearest parent, not just immediate parent: non-number is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"http://example.com/a.json","$defs":{"x":{"$id":"http://example.com/b/c.json","not":{"$defs":{"y":{"$id":"d.json","type":"number"}}}}},"allOf":[{"$ref":"http://example.com/b/d.json"}]}"#,
        #""a""#,
        false,
    );
}

test "order of evaluation: $id and $ref: data is valid against first definition" {
    check(
        #"{"$comment":"$id must be evaluated before $ref to get the proper $ref destination","$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://example.com/draft2020-12/ref-and-id1/base.json","$ref":"int.json","$defs":{"bigint":{"$comment":"canonical uri: https://example.com/ref-and-id1/int.json","$id":"int.json","maximum":10},"smallint":{"$comment":"canonical uri: https://example.com/ref-and-id1-int.json","$id":"/draft2020-12/ref-and-id1-int.json","maximum":2}}}"#,
        #"5"#,
        true,
    );
}

test "order of evaluation: $id and $ref: data is invalid against first definition" {
    check(
        #"{"$comment":"$id must be evaluated before $ref to get the proper $ref destination","$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://example.com/draft2020-12/ref-and-id1/base.json","$ref":"int.json","$defs":{"bigint":{"$comment":"canonical uri: https://example.com/ref-and-id1/int.json","$id":"int.json","maximum":10},"smallint":{"$comment":"canonical uri: https://example.com/ref-and-id1-int.json","$id":"/draft2020-12/ref-and-id1-int.json","maximum":2}}}"#,
        #"50"#,
        false,
    );
}

test "order of evaluation: $id and $anchor and $ref: data is valid against first definition" {
    check(
        ##"{"$comment":"$id must be evaluated before $ref to get the proper $ref destination","$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://example.com/draft2020-12/ref-and-id2/base.json","$ref":"#bigint","$defs":{"bigint":{"$comment":"canonical uri: /ref-and-id2/base.json#/$defs/bigint; another valid uri for this location: /ref-and-id2/base.json#bigint","$anchor":"bigint","maximum":10},"smallint":{"$comment":"canonical uri: https://example.com/ref-and-id2#/$defs/smallint; another valid uri for this location: https://example.com/ref-and-id2/#bigint","$id":"https://example.com/draft2020-12/ref-and-id2/","$anchor":"bigint","maximum":2}}}"##,
        #"5"#,
        true,
    );
}

test "order of evaluation: $id and $anchor and $ref: data is invalid against first definition" {
    check(
        ##"{"$comment":"$id must be evaluated before $ref to get the proper $ref destination","$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://example.com/draft2020-12/ref-and-id2/base.json","$ref":"#bigint","$defs":{"bigint":{"$comment":"canonical uri: /ref-and-id2/base.json#/$defs/bigint; another valid uri for this location: /ref-and-id2/base.json#bigint","$anchor":"bigint","maximum":10},"smallint":{"$comment":"canonical uri: https://example.com/ref-and-id2#/$defs/smallint; another valid uri for this location: https://example.com/ref-and-id2/#bigint","$id":"https://example.com/draft2020-12/ref-and-id2/","$anchor":"bigint","maximum":2}}}"##,
        #"50"#,
        false,
    );
}

test "order of evaluation: $id and $ref on nested schema: data is valid against nested sibling" {
    check(
        #"{"$comment":"$id must be evaluated before $ref to get the proper $ref destination","$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://example.com/draft2020-12/ref-and-id3/base.json","$ref":"nested/foo.json","$defs":{"foo":{"$comment":"canonical uri: https://example.com/draft2020-12/ref-and-id3/nested/foo.json","$id":"nested/foo.json","$ref":"./bar.json"},"bar":{"$comment":"canonical uri: https://example.com/draft2020-12/ref-and-id3/nested/bar.json","$id":"nested/bar.json","type":"number"}}}"#,
        #"5"#,
        true,
    );
}

test "order of evaluation: $id and $ref on nested schema: data is invalid against nested sibling" {
    check(
        #"{"$comment":"$id must be evaluated before $ref to get the proper $ref destination","$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://example.com/draft2020-12/ref-and-id3/base.json","$ref":"nested/foo.json","$defs":{"foo":{"$comment":"canonical uri: https://example.com/draft2020-12/ref-and-id3/nested/foo.json","$id":"nested/foo.json","$ref":"./bar.json"},"bar":{"$comment":"canonical uri: https://example.com/draft2020-12/ref-and-id3/nested/bar.json","$id":"nested/bar.json","type":"number"}}}"#,
        #""a""#,
        false,
    );
}

test "simple URN base URI with $ref via the URN: valid under the URN IDed schema" {
    check(
        #"{"$comment":"URIs do not have to have HTTP(s) schemes","$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:uuid:deadbeef-1234-ffff-ffff-4321feebdaed","minimum":30,"properties":{"foo":{"$ref":"urn:uuid:deadbeef-1234-ffff-ffff-4321feebdaed"}}}"#,
        #"{"foo":37}"#,
        true,
    );
}

test "simple URN base URI with $ref via the URN: invalid under the URN IDed schema" {
    check(
        #"{"$comment":"URIs do not have to have HTTP(s) schemes","$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:uuid:deadbeef-1234-ffff-ffff-4321feebdaed","minimum":30,"properties":{"foo":{"$ref":"urn:uuid:deadbeef-1234-ffff-ffff-4321feebdaed"}}}"#,
        #"{"foo":12}"#,
        false,
    );
}

test "simple URN base URI with JSON pointer: a string is valid" {
    check(
        ##"{"$comment":"URIs do not have to have HTTP(s) schemes","$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:uuid:deadbeef-1234-00ff-ff00-4321feebdaed","properties":{"foo":{"$ref":"#/$defs/bar"}},"$defs":{"bar":{"type":"string"}}}"##,
        #"{"foo":"bar"}"#,
        true,
    );
}

test "simple URN base URI with JSON pointer: a non-string is invalid" {
    check(
        ##"{"$comment":"URIs do not have to have HTTP(s) schemes","$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:uuid:deadbeef-1234-00ff-ff00-4321feebdaed","properties":{"foo":{"$ref":"#/$defs/bar"}},"$defs":{"bar":{"type":"string"}}}"##,
        #"{"foo":12}"#,
        false,
    );
}

