        false,
    );
}

test "validation of date strings: invalid: trailing whitespace is not permitted" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date"}"#,
        #""2024-01-15 ""#,
        false,
    );
}

