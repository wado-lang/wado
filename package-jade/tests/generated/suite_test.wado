test "patterns always use unicode semantics with pattern: ascii character in json string" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","pattern":"\\p{Letter}cole"}"#,
        #""Les hivers de mon enfance etaient des saisons longues, longues. Nous vivions en trois lieux: l'ecole, l'eglise et la patinoire; mais la vraie vie etait sur la patinoire.""#,
        true,
    );
}

test "patterns always use unicode semantics with pattern: literal unicode character in json string" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","pattern":"\\p{Letter}cole"}"#,
        #""Les hivers de mon enfance étaient des saisons longues, longues. Nous vivions en trois lieux: l'école, l'église et la patinoire; mais la vraie vie était sur la patinoire.""#,
        true,
    );
}

test "patterns always use unicode semantics with pattern: unicode character in hex format in string" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","pattern":"\\p{Letter}cole"}"#,
        #""Les hivers de mon enfance étaient des saisons longues, longues. Nous vivions en trois lieux: l'école, l'église et la patinoire; mais la vraie vie était sur la patinoire.""#,
        true,
    );
}

test "patterns always use unicode semantics with pattern: unicode matching is case-sensitive" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","pattern":"\\p{Letter}cole"}"#,
        #""LES HIVERS DE MON ENFANCE ÉTAIENT DES SAISONS LONGUES, LONGUES. NOUS VIVIONS EN TROIS LIEUX: L'ÉCOLE, L'ÉGLISE ET LA PATINOIRE; MAIS LA VRAIE VIE ÉTAIT SUR LA PATINOIRE.""#,
        false,
    );
}

test "\\w in patterns matches [A-Za-z0-9_], not unicode letters: ascii character in json string" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","pattern":"\\wcole"}"#,
        #""Les hivers de mon enfance etaient des saisons longues, longues. Nous vivions en trois lieux: l'ecole, l'eglise et la patinoire; mais la vraie vie etait sur la patinoire.""#,
