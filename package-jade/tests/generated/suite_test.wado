// required.json

test "required validation: present required property is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{},"bar":{}},"required":["foo"]}"#,
        #"{"foo":1}"#,
        true,
    );
}

test "required validation: non-present required property is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{},"bar":{}},"required":["foo"]}"#,
        #"{"bar":1}"#,
        false,
    );
}

test "required validation: ignores arrays" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{},"bar":{}},"required":["foo"]}"#,
        #"[]"#,
        true,
    );
}

test "required validation: ignores strings" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{},"bar":{}},"required":["foo"]}"#,
        #""""#,
        true,
    );
}

test "required validation: ignores other non-objects" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{},"bar":{}},"required":["foo"]}"#,
        #"12"#,
        true,
    );
}

test "required validation: ignores null" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{},"bar":{}},"required":["foo"]}"#,
        #"null"#,
        true,
    );
}

test "required validation: ignores boolean" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{},"bar":{}},"required":["foo"]}"#,
        #"true"#,
        true,
    );
}

test "required default validation: not required by default" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{}}}"#,
        #"{}"#,
        true,
    );
}

test "required with empty array: property not required" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{}},"required":[]}"#,
        #"{}"#,
        true,
    );
}

test "required with escaped characters: object with all properties present is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","required":["foo\nbar","foo\"bar","foo\\bar","foo\rbar","foo\tbar","foo\fbar"]}"#,
        #"{"foo\nbar":1,"foo\"bar":1,"foo\\bar":1,"foo\rbar":1,"foo\tbar":1,"foo\fbar":1}"#,
        true,
    );
}

test "required with escaped characters: object with some properties missing is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","required":["foo\nbar","foo\"bar","foo\\bar","foo\rbar","foo\tbar","foo\fbar"]}"#,
        #"{"foo\nbar":"1","foo\"bar":"1"}"#,
        false,
    );
}

test "required properties whose names are Javascript object property names: ignores arrays" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","required":["__proto__","toString","constructor"]}"#,
        #"[]"#,
        true,
    );
}

test "required properties whose names are Javascript object property names: ignores other non-objects" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","required":["__proto__","toString","constructor"]}"#,
        #"12"#,
        true,
    );
}

test "required properties whose names are Javascript object property names: none of the properties mentioned" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","required":["__proto__","toString","constructor"]}"#,
        #"{}"#,
        false,
    );
}

test "required properties whose names are Javascript object property names: __proto__ present" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","required":["__proto__","toString","constructor"]}"#,
        #"{"__proto__":"foo"}"#,
        false,
    );
}

test "required properties whose names are Javascript object property names: toString present" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","required":["__proto__","toString","constructor"]}"#,
        #"{"toString":{"length":37}}"#,
        false,
    );
}

test "required properties whose names are Javascript object property names: constructor present" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","required":["__proto__","toString","constructor"]}"#,
        #"{"constructor":{"length":37}}"#,
        false,
    );
}

test "required properties whose names are Javascript object property names: all present" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","required":["__proto__","toString","constructor"]}"#,
        #"{"__proto__":12,"toString":{"length":"foo"},"constructor":37}"#,
        true,
    );
}

// type.json

test "integer type matches integers: an integer is an integer" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"integer"}"#,
        #"1"#,
        true,
    );
}

test "integer type matches integers: a float with zero fractional part is an integer" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"integer"}"#,
        #"1"#,
        true,
    );
}

test "integer type matches integers: a float is not an integer" {
