        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","anyOf":[{"type":"number"},{}]}"#,
        #""foo""#,
        true,
    );
}

test "anyOf with one empty schema: number is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","anyOf":[{"type":"number"},{}]}"#,
        #"123"#,
        true,
    );
}

test "nested anyOf, to check validation semantics: null is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","anyOf":[{"anyOf":[{"type":"null"}]}]}"#,
        #"null"#,
        true,
    );
}

test "nested anyOf, to check validation semantics: anything non-null is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","anyOf":[{"anyOf":[{"type":"null"}]}]}"#,
        #"123"#,
        false,
    );
}

// boolean_schema.json

test "boolean schema 'true': number is valid" {
    check(
        #"true"#,
        #"1"#,
        true,
    );
}

test "boolean schema 'true': string is valid" {
    check(
        #"true"#,
        #""foo""#,
        true,
    );
}

test "boolean schema 'true': boolean true is valid" {
    check(
        #"true"#,
        #"true"#,
        true,
    );
}

test "boolean schema 'true': boolean false is valid" {
    check(
        #"true"#,
        #"false"#,
        true,
    );
}

test "boolean schema 'true': null is valid" {
    check(
        #"true"#,
        #"null"#,
        true,
    );
}

test "boolean schema 'true': object is valid" {
    check(
        #"true"#,
        #"{"foo":"bar"}"#,
        true,
    );
}

test "boolean schema 'true': empty object is valid" {
    check(
        #"true"#,
        #"{}"#,
        true,
    );
}

test "boolean schema 'true': array is valid" {
    check(
        #"true"#,
        #"["foo"]"#,
        true,
    );
}

test "boolean schema 'true': empty array is valid" {
    check(
        #"true"#,
        #"[]"#,
        true,
    );
}

test "boolean schema 'false': number is invalid" {
    check(
        #"false"#,
        #"1"#,
        false,
    );
}

test "boolean schema 'false': string is invalid" {
    check(
        #"false"#,
        #""foo""#,
        false,
    );
}

test "boolean schema 'false': boolean true is invalid" {
    check(
        #"false"#,
        #"true"#,
        false,
    );
}

test "boolean schema 'false': boolean false is invalid" {
    check(
        #"false"#,
        #"false"#,
        false,
    );
}

test "boolean schema 'false': null is invalid" {
    check(
        #"false"#,
        #"null"#,
        false,
    );
}

test "boolean schema 'false': object is invalid" {
    check(
        #"false"#,
        #"{"foo":"bar"}"#,
        false,
    );
}

test "boolean schema 'false': empty object is invalid" {
    check(
        #"false"#,
        #"{}"#,
        false,
    );
}

test "boolean schema 'false': array is invalid" {
    check(
        #"false"#,
        #"["foo"]"#,
        false,
    );
}

test "boolean schema 'false': empty array is invalid" {
    check(
        #"false"#,
        #"[]"#,
        false,
    );
}

// const.json

test "const validation: same value is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":2}"#,
        #"2"#,
        true,
    );
}

test "const validation: another value is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":2}"#,
        #"5"#,
        false,
    );
}

test "const validation: another type is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":2}"#,
        #""a""#,
        false,
    );
}

test "const with object: same object is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":{"foo":"bar","baz":"bax"}}"#,
        #"{"foo":"bar","baz":"bax"}"#,
        true,
    );
}

test "const with object: same object with different property order is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":{"foo":"bar","baz":"bax"}}"#,
        #"{"baz":"bax","foo":"bar"}"#,
        true,
    );
}

test "const with object: another object is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":{"foo":"bar","baz":"bax"}}"#,
        #"{"foo":"bar"}"#,
        false,
    );
}

test "const with object: another type is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":{"foo":"bar","baz":"bax"}}"#,
        #"[1,2]"#,
        false,
    );
}

test "const with array: same array is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":[{"foo":"bar"}]}"#,
        #"[{"foo":"bar"}]"#,
        true,
    );
}

test "const with array: another array item is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":[{"foo":"bar"}]}"#,
        #"[2]"#,
        false,
    );
}

test "const with array: array with additional items is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":[{"foo":"bar"}]}"#,
        #"[1,2,3]"#,
        false,
    );
}

test "const with null: null is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":null}"#,
        #"null"#,
        true,
    );
}

test "const with null: not null is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":null}"#,
        #"0"#,
        false,
    );
}

test "const with false does not match 0: false is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":false}"#,
        #"false"#,
        true,
    );
}

test "const with false does not match 0: integer zero is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":false}"#,
        #"0"#,
        false,
    );
}

test "const with false does not match 0: float zero is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":false}"#,
        #"0"#,
        false,
    );
}

test "const with true does not match 1: true is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":true}"#,
        #"true"#,
        true,
    );
}

test "const with true does not match 1: integer one is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":true}"#,
        #"1"#,
        false,
    );
}

test "const with true does not match 1: float one is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":true}"#,
        #"1"#,
        false,
    );
}

test "const with [false] does not match [0]: [false] is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":[false]}"#,
        #"[false]"#,
        true,
    );
}

test "const with [false] does not match [0]: [0] is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":[false]}"#,
        #"[0]"#,
        false,
    );
}

test "const with [false] does not match [0]: [0.0] is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":[false]}"#,
        #"[0]"#,
        false,
    );
}

test "const with [true] does not match [1]: [true] is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":[true]}"#,
        #"[true]"#,
        true,
    );
}

test "const with [true] does not match [1]: [1] is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":[true]}"#,
        #"[1]"#,
        false,
    );
}

test "const with [true] does not match [1]: [1.0] is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":[true]}"#,
        #"[1]"#,
        false,
    );
}

test "const with {\"a\": false} does not match {\"a\": 0}: {\"a\": false} is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":{"a":false}}"#,
        #"{"a":false}"#,
        true,
    );
}

test "const with {\"a\": false} does not match {\"a\": 0}: {\"a\": 0} is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":{"a":false}}"#,
        #"{"a":0}"#,
        false,
    );
}

test "const with {\"a\": false} does not match {\"a\": 0}: {\"a\": 0.0} is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":{"a":false}}"#,
        #"{"a":0}"#,
        false,
    );
}

test "const with {\"a\": true} does not match {\"a\": 1}: {\"a\": true} is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":{"a":true}}"#,
        #"{"a":true}"#,
        true,
    );
}

test "const with {\"a\": true} does not match {\"a\": 1}: {\"a\": 1} is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":{"a":true}}"#,
        #"{"a":1}"#,
        false,
    );
}

test "const with {\"a\": true} does not match {\"a\": 1}: {\"a\": 1.0} is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":{"a":true}}"#,
        #"{"a":1}"#,
        false,
    );
}

test "const with 0 does not match other zero-like types: false is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":0}"#,
        #"false"#,
        false,
    );
}

test "const with 0 does not match other zero-like types: integer zero is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":0}"#,
        #"0"#,
        true,
    );
}

test "const with 0 does not match other zero-like types: float zero is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":0}"#,
        #"0"#,
        true,
    );
}

test "const with 0 does not match other zero-like types: empty object is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":0}"#,
        #"{}"#,
        false,
    );
}

test "const with 0 does not match other zero-like types: empty array is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":0}"#,
        #"[]"#,
        false,
    );
}

test "const with 0 does not match other zero-like types: empty string is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":0}"#,
        #""""#,
        false,
    );
}

test "const with 1 does not match true: true is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":1}"#,
        #"true"#,
        false,
    );
}

test "const with 1 does not match true: integer one is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":1}"#,
        #"1"#,
        true,
    );
}

test "const with 1 does not match true: float one is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":1}"#,
        #"1"#,
        true,
    );
}

test "const with -2.0 matches integer and float types: integer -2 is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":-2}"#,
        #"-2"#,
        true,
    );
}

test "const with -2.0 matches integer and float types: integer 2 is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":-2}"#,
        #"2"#,
        false,
    );
}

test "const with -2.0 matches integer and float types: float -2.0 is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":-2}"#,
        #"-2"#,
        true,
    );
}

test "const with -2.0 matches integer and float types: float 2.0 is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":-2}"#,
        #"2"#,
        false,
    );
}

test "const with -2.0 matches integer and float types: float -2.00001 is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":-2}"#,
        #"-2.00001"#,
        false,
    );
}

test "float and integers are equal up to 64-bit representation limits: integer is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":9007199254740992}"#,
        #"9007199254740992"#,
        true,
    );
}

test "float and integers are equal up to 64-bit representation limits: integer minus one is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":9007199254740992}"#,
        #"9007199254740991"#,
        false,
    );
}

test "float and integers are equal up to 64-bit representation limits: float is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":9007199254740992}"#,
        #"9007199254740992"#,
        true,
    );
}

test "float and integers are equal up to 64-bit representation limits: float minus one is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":9007199254740992}"#,
        #"9007199254740991"#,
        false,
    );
}

test "nul characters in strings: match string with nul" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":"hello\u0000there"}"#,
        #""hello\u0000there""#,
        true,
    );
}

test "nul characters in strings: do not match string lacking nul" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":"hello\u0000there"}"#,
        #""hellothere""#,
        false,
    );
}

test "characters with the same visual representation but different codepoint: character uses the same codepoint" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":"μ","$comment":"U+03BC"}"#,
        #""μ""#,
        true,
    );
}

test "characters with the same visual representation but different codepoint: character looks the same but uses a different codepoint" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":"μ","$comment":"U+03BC"}"#,
        #""µ""#,
        false,
    );
}

test "characters with the same visual representation, but different number of codepoints: character uses the same codepoint" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":"ä","$comment":"U+00E4"}"#,
        #""ä""#,
        true,
    );
}

test "characters with the same visual representation, but different number of codepoints: character looks the same but uses combining marks" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","const":"ä","$comment":"U+00E4"}"#,
        #""ä""#,
        false,
    );
}

// contains.json

test "contains keyword validation: array with item matching schema (5) is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"minimum":5}}"#,
        #"[3,4,5]"#,
        true,
    );
}

test "contains keyword validation: array with item matching schema (6) is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"minimum":5}}"#,
        #"[3,4,6]"#,
        true,
    );
}

test "contains keyword validation: array with two items matching schema (5, 6) is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"minimum":5}}"#,
        #"[3,4,5,6]"#,
        true,
    );
}

test "contains keyword validation: array without items matching schema is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"minimum":5}}"#,
        #"[2,3,4]"#,
        false,
    );
}

test "contains keyword validation: empty array is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"minimum":5}}"#,
        #"[]"#,
        false,
    );
}

test "contains keyword validation: not array is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"minimum":5}}"#,
        #"{}"#,
        true,
    );
}

test "contains keyword with const keyword: array with item 5 is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":5}}"#,
        #"[3,4,5]"#,
        true,
    );
}

test "contains keyword with const keyword: array with two items 5 is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":5}}"#,
        #"[3,4,5,5]"#,
        true,
    );
}

test "contains keyword with const keyword: array without item 5 is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"const":5}}"#,
        #"[1,2,3,4]"#,
        false,
    );
}

test "contains keyword with boolean schema true: any non-empty array is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":true}"#,
        #"["foo"]"#,
        true,
    );
}

test "contains keyword with boolean schema true: empty array is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":true}"#,
        #"[]"#,
        false,
    );
}

test "contains keyword with boolean schema false: any non-empty array is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":false}"#,
        #"["foo"]"#,
        false,
    );
}

test "contains keyword with boolean schema false: empty array is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":false}"#,
        #"[]"#,
        false,
    );
}

test "contains keyword with boolean schema false: non-arrays are valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":false}"#,
        #""contains does not apply to strings""#,
        true,
    );
}

test "items + contains: matches items, does not match contains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","items":{"multipleOf":2},"contains":{"multipleOf":3}}"#,
        #"[2,4,8]"#,
        false,
    );
}

test "items + contains: does not match items, matches contains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","items":{"multipleOf":2},"contains":{"multipleOf":3}}"#,
        #"[3,6,9]"#,
        false,
    );
}

test "items + contains: matches both items and contains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","items":{"multipleOf":2},"contains":{"multipleOf":3}}"#,
        #"[6,12]"#,
        true,
    );
}

test "items + contains: matches neither items nor contains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","items":{"multipleOf":2},"contains":{"multipleOf":3}}"#,
        #"[1,5]"#,
        false,
    );
}

test "contains with false if subschema: any non-empty array is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"if":false,"else":true}}"#,
        #"["foo"]"#,
        true,
    );
}

test "contains with false if subschema: empty array is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"if":false,"else":true}}"#,
        #"[]"#,
        false,
    );
}

test "contains with null instance elements: allows null items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"type":"null"}}"#,
        #"[null]"#,
        true,
    );
}

// content.json

test "validation of string-encoded content based on media type: a valid JSON document" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contentMediaType":"application/json"}"#,
        #""{\"foo\": \"bar\"}""#,
        true,
    );
}

test "validation of string-encoded content based on media type: an invalid JSON document; validates true" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contentMediaType":"application/json"}"#,
        #""{:}""#,
        true,
    );
}

test "validation of string-encoded content based on media type: ignores non-strings" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contentMediaType":"application/json"}"#,
        #"100"#,
        true,
    );
}

test "validation of binary string-encoding: a valid base64 string" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contentEncoding":"base64"}"#,
        #""eyJmb28iOiAiYmFyIn0K""#,
        true,
    );
}

test "validation of binary string-encoding: an invalid base64 string (% is not a valid character); validates true" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contentEncoding":"base64"}"#,
        #""eyJmb28iOi%iYmFyIn0K""#,
        true,
    );
}

test "validation of binary string-encoding: ignores non-strings" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contentEncoding":"base64"}"#,
        #"100"#,
        true,
    );
}

test "validation of binary-encoded media type documents: a valid base64-encoded JSON document" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contentMediaType":"application/json","contentEncoding":"base64"}"#,
        #""eyJmb28iOiAiYmFyIn0K""#,
        true,
    );
}

test "validation of binary-encoded media type documents: a validly-encoded invalid JSON document; validates true" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contentMediaType":"application/json","contentEncoding":"base64"}"#,
        #""ezp9Cg==""#,
        true,
    );
}

test "validation of binary-encoded media type documents: an invalid base64 string that is valid JSON; validates true" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contentMediaType":"application/json","contentEncoding":"base64"}"#,
        #""{}""#,
        true,
    );
}

test "validation of binary-encoded media type documents: ignores non-strings" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contentMediaType":"application/json","contentEncoding":"base64"}"#,
        #"100"#,
        true,
    );
}

test "validation of binary-encoded media type documents with schema: a valid base64-encoded JSON document" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contentMediaType":"application/json","contentEncoding":"base64","contentSchema":{"type":"object","required":["foo"],"properties":{"foo":{"type":"string"}}}}"#,
        #""eyJmb28iOiAiYmFyIn0K""#,
        true,
    );
}

test "validation of binary-encoded media type documents with schema: another valid base64-encoded JSON document" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contentMediaType":"application/json","contentEncoding":"base64","contentSchema":{"type":"object","required":["foo"],"properties":{"foo":{"type":"string"}}}}"#,
        #""eyJib28iOiAyMCwgImZvbyI6ICJiYXoifQ==""#,
        true,
    );
}

test "validation of binary-encoded media type documents with schema: an invalid base64-encoded JSON document; validates true" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contentMediaType":"application/json","contentEncoding":"base64","contentSchema":{"type":"object","required":["foo"],"properties":{"foo":{"type":"string"}}}}"#,
        #""eyJib28iOiAyMH0=""#,
        true,
    );
}

test "validation of binary-encoded media type documents with schema: an empty object as a base64-encoded JSON document; validates true" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contentMediaType":"application/json","contentEncoding":"base64","contentSchema":{"type":"object","required":["foo"],"properties":{"foo":{"type":"string"}}}}"#,
        #""e30=""#,
        true,
    );
}

test "validation of binary-encoded media type documents with schema: an empty array as a base64-encoded JSON document" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contentMediaType":"application/json","contentEncoding":"base64","contentSchema":{"type":"object","required":["foo"],"properties":{"foo":{"type":"string"}}}}"#,
        #""W10=""#,
        true,
    );
}

test "validation of binary-encoded media type documents with schema: a validly-encoded invalid JSON document; validates true" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contentMediaType":"application/json","contentEncoding":"base64","contentSchema":{"type":"object","required":["foo"],"properties":{"foo":{"type":"string"}}}}"#,
        #""ezp9Cg==""#,
        true,
    );
}

test "validation of binary-encoded media type documents with schema: an invalid base64 string that is valid JSON; validates true" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contentMediaType":"application/json","contentEncoding":"base64","contentSchema":{"type":"object","required":["foo"],"properties":{"foo":{"type":"string"}}}}"#,
        #""{}""#,
        true,
    );
}

test "validation of binary-encoded media type documents with schema: ignores non-strings" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contentMediaType":"application/json","contentEncoding":"base64","contentSchema":{"type":"object","required":["foo"],"properties":{"foo":{"type":"string"}}}}"#,
        #"100"#,
        true,
    );
}

// default.json

test "invalid type for default: valid when property is specified" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"integer","default":[]}}}"#,
        #"{"foo":13}"#,
        true,
    );
}

test "invalid type for default: still valid when the invalid default is used" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"integer","default":[]}}}"#,
        #"{}"#,
        true,
    );
}

test "invalid string value for default: valid when property is specified" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"bar":{"type":"string","minLength":4,"default":"bad"}}}"#,
        #"{"bar":"good"}"#,
        true,
    );
}

test "invalid string value for default: still valid when the invalid default is used" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"bar":{"type":"string","minLength":4,"default":"bad"}}}"#,
        #"{}"#,
        true,
    );
}

test "the default keyword does not do anything if the property is missing: an explicit property value is checked against maximum (passing)" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"alpha":{"type":"number","maximum":3,"default":5}}}"#,
        #"{"alpha":1}"#,
        true,
    );
}

test "the default keyword does not do anything if the property is missing: an explicit property value is checked against maximum (failing)" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"alpha":{"type":"number","maximum":3,"default":5}}}"#,
        #"{"alpha":5}"#,
        false,
    );
}

test "the default keyword does not do anything if the property is missing: missing properties are not filled in with the default" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"alpha":{"type":"number","maximum":3,"default":5}}}"#,
        #"{}"#,
        true,
    );
}

// defs.json

test "validate definition against metaschema: valid definition schema" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","$ref":"https://json-schema.org/draft/2020-12/schema"}"#,
        #"{"$defs":{"foo":{"type":"integer"}}}"#,
        true,
    );
}

test "validate definition against metaschema: invalid definition schema" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","$ref":"https://json-schema.org/draft/2020-12/schema"}"#,
        #"{"$defs":{"foo":{"type":1}}}"#,
        false,
    );
}

// dependentRequired.json

test "single dependency: neither" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentRequired":{"bar":["foo"]}}"#,
        #"{}"#,
        true,
    );
}

test "single dependency: nondependant" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentRequired":{"bar":["foo"]}}"#,
        #"{"foo":1}"#,
        true,
    );
}

test "single dependency: with dependency" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentRequired":{"bar":["foo"]}}"#,
        #"{"foo":1,"bar":2}"#,
        true,
    );
}

test "single dependency: missing dependency" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentRequired":{"bar":["foo"]}}"#,
        #"{"bar":2}"#,
        false,
    );
}

test "single dependency: ignores arrays" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentRequired":{"bar":["foo"]}}"#,
        #"["bar"]"#,
        true,
    );
}

test "single dependency: ignores strings" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentRequired":{"bar":["foo"]}}"#,
        #""foobar""#,
        true,
    );
}

test "single dependency: ignores other non-objects" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentRequired":{"bar":["foo"]}}"#,
        #"12"#,
        true,
    );
}

test "empty dependents: empty object" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentRequired":{"bar":[]}}"#,
        #"{}"#,
        true,
    );
}

test "empty dependents: object with one property" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentRequired":{"bar":[]}}"#,
        #"{"bar":2}"#,
        true,
    );
}

test "empty dependents: non-object is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentRequired":{"bar":[]}}"#,
        #"1"#,
        true,
    );
}

test "multiple dependents required: neither" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentRequired":{"quux":["foo","bar"]}}"#,
        #"{}"#,
        true,
    );
}

test "multiple dependents required: nondependants" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentRequired":{"quux":["foo","bar"]}}"#,
        #"{"foo":1,"bar":2}"#,
        true,
    );
}

test "multiple dependents required: with dependencies" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentRequired":{"quux":["foo","bar"]}}"#,
        #"{"foo":1,"bar":2,"quux":3}"#,
        true,
    );
}

test "multiple dependents required: missing dependency" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentRequired":{"quux":["foo","bar"]}}"#,
        #"{"foo":1,"quux":2}"#,
        false,
    );
}

test "multiple dependents required: missing other dependency" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentRequired":{"quux":["foo","bar"]}}"#,
        #"{"bar":1,"quux":2}"#,
        false,
    );
}

test "multiple dependents required: missing both dependencies" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentRequired":{"quux":["foo","bar"]}}"#,
        #"{"quux":1}"#,
        false,
    );
}

test "dependencies with escaped characters: CRLF" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentRequired":{"foo\nbar":["foo\rbar"],"foo\"bar":["foo'bar"]}}"#,
        #"{"foo\nbar":1,"foo\rbar":2}"#,
        true,
    );
}

test "dependencies with escaped characters: quoted quotes" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentRequired":{"foo\nbar":["foo\rbar"],"foo\"bar":["foo'bar"]}}"#,
        #"{"foo'bar":1,"foo\"bar":2}"#,
        true,
    );
}

test "dependencies with escaped characters: CRLF missing dependent" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentRequired":{"foo\nbar":["foo\rbar"],"foo\"bar":["foo'bar"]}}"#,
        #"{"foo\nbar":1,"foo":2}"#,
        false,
    );
}

test "dependencies with escaped characters: quoted quotes missing dependent" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentRequired":{"foo\nbar":["foo\rbar"],"foo\"bar":["foo'bar"]}}"#,
        #"{"foo\"bar":2}"#,
        false,
    );
}

// dependentSchemas.json

test "single dependency: valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentSchemas":{"bar":{"properties":{"foo":{"type":"integer"},"bar":{"type":"integer"}}}}}"#,
        #"{"foo":1,"bar":2}"#,
        true,
    );
}

test "single dependency: no dependency" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentSchemas":{"bar":{"properties":{"foo":{"type":"integer"},"bar":{"type":"integer"}}}}}"#,
        #"{"foo":"quux"}"#,
        true,
    );
}

test "single dependency: wrong type" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentSchemas":{"bar":{"properties":{"foo":{"type":"integer"},"bar":{"type":"integer"}}}}}"#,
        #"{"foo":"quux","bar":2}"#,
        false,
    );
}

test "single dependency: wrong type other" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentSchemas":{"bar":{"properties":{"foo":{"type":"integer"},"bar":{"type":"integer"}}}}}"#,
        #"{"foo":2,"bar":"quux"}"#,
        false,
    );
}

test "single dependency: wrong type both" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentSchemas":{"bar":{"properties":{"foo":{"type":"integer"},"bar":{"type":"integer"}}}}}"#,
        #"{"foo":"quux","bar":"quux"}"#,
        false,
    );
}

test "single dependency: ignores arrays (2)" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentSchemas":{"bar":{"properties":{"foo":{"type":"integer"},"bar":{"type":"integer"}}}}}"#,
        #"["bar"]"#,
        true,
    );
}

test "single dependency: ignores strings (2)" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentSchemas":{"bar":{"properties":{"foo":{"type":"integer"},"bar":{"type":"integer"}}}}}"#,
        #""foobar""#,
        true,
    );
}

test "single dependency: ignores other non-objects (2)" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentSchemas":{"bar":{"properties":{"foo":{"type":"integer"},"bar":{"type":"integer"}}}}}"#,
        #"12"#,
        true,
    );
}

test "boolean subschemas: object with property having schema true is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentSchemas":{"foo":true,"bar":false}}"#,
        #"{"foo":1}"#,
        true,
    );
}

test "boolean subschemas: object with property having schema false is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentSchemas":{"foo":true,"bar":false}}"#,
        #"{"bar":2}"#,
        false,
    );
}

test "boolean subschemas: object with both properties is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentSchemas":{"foo":true,"bar":false}}"#,
        #"{"foo":1,"bar":2}"#,
        false,
    );
}

test "boolean subschemas: empty object is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentSchemas":{"foo":true,"bar":false}}"#,
        #"{}"#,
        true,
    );
}

test "dependencies with escaped characters: quoted tab" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentSchemas":{"foo\tbar":{"minProperties":4},"foo'bar":{"required":["foo\"bar"]}}}"#,
        #"{"foo\tbar":1,"a":2,"b":3,"c":4}"#,
        true,
    );
}

test "dependencies with escaped characters: quoted quote" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentSchemas":{"foo\tbar":{"minProperties":4},"foo'bar":{"required":["foo\"bar"]}}}"#,
        #"{"foo'bar":{"foo\"bar":1}}"#,
        false,
    );
}

test "dependencies with escaped characters: quoted tab invalid under dependent schema" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentSchemas":{"foo\tbar":{"minProperties":4},"foo'bar":{"required":["foo\"bar"]}}}"#,
        #"{"foo\tbar":1,"a":2}"#,
        false,
    );
}

test "dependencies with escaped characters: quoted quote invalid under dependent schema" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","dependentSchemas":{"foo\tbar":{"minProperties":4},"foo'bar":{"required":["foo\"bar"]}}}"#,
        #"{"foo'bar":1}"#,
        false,
    );
}

test "dependent subschema incompatible with root: matches root" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{}},"dependentSchemas":{"foo":{"properties":{"bar":{}},"additionalProperties":false}}}"#,
        #"{"foo":1}"#,
        false,
    );
}

test "dependent subschema incompatible with root: matches dependency" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{}},"dependentSchemas":{"foo":{"properties":{"bar":{}},"additionalProperties":false}}}"#,
        #"{"bar":1}"#,
        true,
    );
}

test "dependent subschema incompatible with root: matches both" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{}},"dependentSchemas":{"foo":{"properties":{"bar":{}},"additionalProperties":false}}}"#,
        #"{"foo":1,"bar":2}"#,
        false,
    );
}

test "dependent subschema incompatible with root: no dependency" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{}},"dependentSchemas":{"foo":{"properties":{"bar":{}},"additionalProperties":false}}}"#,
        #"{"baz":1}"#,
        true,
    );
}

// dynamicRef.json

test "A $dynamicRef to a $dynamicAnchor in the same schema resource behaves like a normal $ref to an $anchor: An array of strings is valid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamicRef-dynamicAnchor-same-schema/root","type":"array","items":{"$dynamicRef":"#items"},"$defs":{"foo":{"$dynamicAnchor":"items","type":"string"}}}"##,
        #"["foo","bar"]"#,
        true,
    );
}

test "A $dynamicRef to a $dynamicAnchor in the same schema resource behaves like a normal $ref to an $anchor: An array containing non-strings is invalid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamicRef-dynamicAnchor-same-schema/root","type":"array","items":{"$dynamicRef":"#items"},"$defs":{"foo":{"$dynamicAnchor":"items","type":"string"}}}"##,
        #"["foo",42]"#,
        false,
    );
}

test "A $dynamicRef to an $anchor in the same schema resource behaves like a normal $ref to an $anchor: An array of strings is valid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamicRef-anchor-same-schema/root","type":"array","items":{"$dynamicRef":"#items"},"$defs":{"foo":{"$anchor":"items","type":"string"}}}"##,
        #"["foo","bar"]"#,
        true,
    );
}

test "A $dynamicRef to an $anchor in the same schema resource behaves like a normal $ref to an $anchor: An array containing non-strings is invalid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamicRef-anchor-same-schema/root","type":"array","items":{"$dynamicRef":"#items"},"$defs":{"foo":{"$anchor":"items","type":"string"}}}"##,
        #"["foo",42]"#,
        false,
    );
}

test "A $ref to a $dynamicAnchor in the same schema resource behaves like a normal $ref to an $anchor: An array of strings is valid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/ref-dynamicAnchor-same-schema/root","type":"array","items":{"$ref":"#items"},"$defs":{"foo":{"$dynamicAnchor":"items","type":"string"}}}"##,
        #"["foo","bar"]"#,
        true,
    );
}

test "A $ref to a $dynamicAnchor in the same schema resource behaves like a normal $ref to an $anchor: An array containing non-strings is invalid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/ref-dynamicAnchor-same-schema/root","type":"array","items":{"$ref":"#items"},"$defs":{"foo":{"$dynamicAnchor":"items","type":"string"}}}"##,
        #"["foo",42]"#,
        false,
    );
}

test "A $dynamicRef resolves to the first $dynamicAnchor still in scope that is encountered when the schema is evaluated: An array of strings is valid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/typical-dynamic-resolution/root","$ref":"list","$defs":{"foo":{"$dynamicAnchor":"items","type":"string"},"list":{"$id":"list","type":"array","items":{"$dynamicRef":"#items"},"$defs":{"items":{"$comment":"This is only needed to satisfy the bookending requirement","$dynamicAnchor":"items"}}}}}"##,
        #"["foo","bar"]"#,
        true,
    );
}

test "A $dynamicRef resolves to the first $dynamicAnchor still in scope that is encountered when the schema is evaluated: An array containing non-strings is invalid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/typical-dynamic-resolution/root","$ref":"list","$defs":{"foo":{"$dynamicAnchor":"items","type":"string"},"list":{"$id":"list","type":"array","items":{"$dynamicRef":"#items"},"$defs":{"items":{"$comment":"This is only needed to satisfy the bookending requirement","$dynamicAnchor":"items"}}}}}"##,
        #"["foo",42]"#,
        false,
    );
}

test "A $dynamicRef without anchor in fragment behaves identical to $ref: An array of strings is invalid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamicRef-without-anchor/root","$ref":"list","$defs":{"foo":{"$dynamicAnchor":"items","type":"string"},"list":{"$id":"list","type":"array","items":{"$dynamicRef":"#/$defs/items"},"$defs":{"items":{"$comment":"This is only needed to satisfy the bookending requirement","$dynamicAnchor":"items","type":"number"}}}}}"##,
        #"["foo","bar"]"#,
        false,
    );
}

test "A $dynamicRef without anchor in fragment behaves identical to $ref: An array of numbers is valid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamicRef-without-anchor/root","$ref":"list","$defs":{"foo":{"$dynamicAnchor":"items","type":"string"},"list":{"$id":"list","type":"array","items":{"$dynamicRef":"#/$defs/items"},"$defs":{"items":{"$comment":"This is only needed to satisfy the bookending requirement","$dynamicAnchor":"items","type":"number"}}}}}"##,
        #"[24,42]"#,
        true,
    );
}

test "A $dynamicRef with intermediate scopes that don't include a matching $dynamicAnchor does not affect dynamic scope resolution: An array of strings is valid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamic-resolution-with-intermediate-scopes/root","$ref":"intermediate-scope","$defs":{"foo":{"$dynamicAnchor":"items","type":"string"},"intermediate-scope":{"$id":"intermediate-scope","$ref":"list"},"list":{"$id":"list","type":"array","items":{"$dynamicRef":"#items"},"$defs":{"items":{"$comment":"This is only needed to satisfy the bookending requirement","$dynamicAnchor":"items"}}}}}"##,
        #"["foo","bar"]"#,
        true,
    );
}

test "A $dynamicRef with intermediate scopes that don't include a matching $dynamicAnchor does not affect dynamic scope resolution: An array containing non-strings is invalid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamic-resolution-with-intermediate-scopes/root","$ref":"intermediate-scope","$defs":{"foo":{"$dynamicAnchor":"items","type":"string"},"intermediate-scope":{"$id":"intermediate-scope","$ref":"list"},"list":{"$id":"list","type":"array","items":{"$dynamicRef":"#items"},"$defs":{"items":{"$comment":"This is only needed to satisfy the bookending requirement","$dynamicAnchor":"items"}}}}}"##,
        #"["foo",42]"#,
        false,
    );
}

test "An $anchor with the same name as a $dynamicAnchor is not used for dynamic scope resolution: Any array is valid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamic-resolution-ignores-anchors/root","$ref":"list","$defs":{"foo":{"$anchor":"items","type":"string"},"list":{"$id":"list","type":"array","items":{"$dynamicRef":"#items"},"$defs":{"items":{"$comment":"This is only needed to satisfy the bookending requirement","$dynamicAnchor":"items"}}}}}"##,
        #"["foo",42]"#,
        true,
    );
}

test "A $dynamicRef without a matching $dynamicAnchor in the same schema resource behaves like a normal $ref to $anchor: Any array is valid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamic-resolution-without-bookend/root","$ref":"list","$defs":{"foo":{"$dynamicAnchor":"items","type":"string"},"list":{"$id":"list","type":"array","items":{"$dynamicRef":"#items"},"$defs":{"items":{"$comment":"This is only needed to give the reference somewhere to resolve to when it behaves like $ref","$anchor":"items"}}}}}"##,
        #"["foo",42]"#,
        true,
    );
}

test "A $dynamicRef with a non-matching $dynamicAnchor in the same schema resource behaves like a normal $ref to $anchor: Any array is valid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/unmatched-dynamic-anchor/root","$ref":"list","$defs":{"foo":{"$dynamicAnchor":"items","type":"string"},"list":{"$id":"list","type":"array","items":{"$dynamicRef":"#items"},"$defs":{"items":{"$comment":"This is only needed to give the reference somewhere to resolve to when it behaves like $ref","$anchor":"items","$dynamicAnchor":"foo"}}}}}"##,
        #"["foo",42]"#,
        true,
    );
}

test "A $dynamicRef that initially resolves to a schema with a matching $dynamicAnchor resolves to the first $dynamicAnchor in the dynamic scope: The recursive part is valid against the root" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/relative-dynamic-reference/root","$dynamicAnchor":"meta","type":"object","properties":{"foo":{"const":"pass"}},"$ref":"extended","$defs":{"extended":{"$id":"extended","$dynamicAnchor":"meta","type":"object","properties":{"bar":{"$ref":"bar"}}},"bar":{"$id":"bar","type":"object","properties":{"baz":{"$dynamicRef":"extended#meta"}}}}}"#,
        #"{"foo":"pass","bar":{"baz":{"foo":"pass"}}}"#,
        true,
    );
}

test "A $dynamicRef that initially resolves to a schema with a matching $dynamicAnchor resolves to the first $dynamicAnchor in the dynamic scope: The recursive part is not valid against the root" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/relative-dynamic-reference/root","$dynamicAnchor":"meta","type":"object","properties":{"foo":{"const":"pass"}},"$ref":"extended","$defs":{"extended":{"$id":"extended","$dynamicAnchor":"meta","type":"object","properties":{"bar":{"$ref":"bar"}}},"bar":{"$id":"bar","type":"object","properties":{"baz":{"$dynamicRef":"extended#meta"}}}}}"#,
        #"{"foo":"pass","bar":{"baz":{"foo":"fail"}}}"#,
        false,
    );
}

test "A $dynamicRef that initially resolves to a schema without a matching $dynamicAnchor behaves like a normal $ref to $anchor: The recursive part doesn't need to validate against the root" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/relative-dynamic-reference-without-bookend/root","$dynamicAnchor":"meta","type":"object","properties":{"foo":{"const":"pass"}},"$ref":"extended","$defs":{"extended":{"$id":"extended","$anchor":"meta","type":"object","properties":{"bar":{"$ref":"bar"}}},"bar":{"$id":"bar","type":"object","properties":{"baz":{"$dynamicRef":"extended#meta"}}}}}"#,
        #"{"foo":"pass","bar":{"baz":{"foo":"fail"}}}"#,
        true,
    );
}

test "multiple dynamic paths to the $dynamicRef keyword: number list with number values" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamic-ref-with-multiple-paths/main","if":{"properties":{"kindOfList":{"const":"numbers"}},"required":["kindOfList"]},"then":{"$ref":"numberList"},"else":{"$ref":"stringList"},"$defs":{"genericList":{"$id":"genericList","properties":{"list":{"items":{"$dynamicRef":"#itemType"}}},"$defs":{"defaultItemType":{"$comment":"Only needed to satisfy bookending requirement","$dynamicAnchor":"itemType"}}},"numberList":{"$id":"numberList","$defs":{"itemType":{"$dynamicAnchor":"itemType","type":"number"}},"$ref":"genericList"},"stringList":{"$id":"stringList","$defs":{"itemType":{"$dynamicAnchor":"itemType","type":"string"}},"$ref":"genericList"}}}"##,
        #"{"kindOfList":"numbers","list":[1.1]}"#,
        true,
    );
}

test "multiple dynamic paths to the $dynamicRef keyword: number list with string values" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamic-ref-with-multiple-paths/main","if":{"properties":{"kindOfList":{"const":"numbers"}},"required":["kindOfList"]},"then":{"$ref":"numberList"},"else":{"$ref":"stringList"},"$defs":{"genericList":{"$id":"genericList","properties":{"list":{"items":{"$dynamicRef":"#itemType"}}},"$defs":{"defaultItemType":{"$comment":"Only needed to satisfy bookending requirement","$dynamicAnchor":"itemType"}}},"numberList":{"$id":"numberList","$defs":{"itemType":{"$dynamicAnchor":"itemType","type":"number"}},"$ref":"genericList"},"stringList":{"$id":"stringList","$defs":{"itemType":{"$dynamicAnchor":"itemType","type":"string"}},"$ref":"genericList"}}}"##,
        #"{"kindOfList":"numbers","list":["foo"]}"#,
        false,
    );
}

test "multiple dynamic paths to the $dynamicRef keyword: string list with number values" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamic-ref-with-multiple-paths/main","if":{"properties":{"kindOfList":{"const":"numbers"}},"required":["kindOfList"]},"then":{"$ref":"numberList"},"else":{"$ref":"stringList"},"$defs":{"genericList":{"$id":"genericList","properties":{"list":{"items":{"$dynamicRef":"#itemType"}}},"$defs":{"defaultItemType":{"$comment":"Only needed to satisfy bookending requirement","$dynamicAnchor":"itemType"}}},"numberList":{"$id":"numberList","$defs":{"itemType":{"$dynamicAnchor":"itemType","type":"number"}},"$ref":"genericList"},"stringList":{"$id":"stringList","$defs":{"itemType":{"$dynamicAnchor":"itemType","type":"string"}},"$ref":"genericList"}}}"##,
        #"{"kindOfList":"strings","list":[1.1]}"#,
        false,
    );
}

test "multiple dynamic paths to the $dynamicRef keyword: string list with string values" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamic-ref-with-multiple-paths/main","if":{"properties":{"kindOfList":{"const":"numbers"}},"required":["kindOfList"]},"then":{"$ref":"numberList"},"else":{"$ref":"stringList"},"$defs":{"genericList":{"$id":"genericList","properties":{"list":{"items":{"$dynamicRef":"#itemType"}}},"$defs":{"defaultItemType":{"$comment":"Only needed to satisfy bookending requirement","$dynamicAnchor":"itemType"}}},"numberList":{"$id":"numberList","$defs":{"itemType":{"$dynamicAnchor":"itemType","type":"number"}},"$ref":"genericList"},"stringList":{"$id":"stringList","$defs":{"itemType":{"$dynamicAnchor":"itemType","type":"string"}},"$ref":"genericList"}}}"##,
        #"{"kindOfList":"strings","list":["foo"]}"#,
        true,
    );
}

test "after leaving a dynamic scope, it is not used by a $dynamicRef: string matches /$defs/thingy, but the $dynamicRef does not stop here" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamic-ref-leaving-dynamic-scope/main","if":{"$id":"first_scope","$defs":{"thingy":{"$comment":"this is first_scope#thingy","$dynamicAnchor":"thingy","type":"number"}}},"then":{"$id":"second_scope","$ref":"start","$defs":{"thingy":{"$comment":"this is second_scope#thingy, the final destination of the $dynamicRef","$dynamicAnchor":"thingy","type":"null"}}},"$defs":{"start":{"$comment":"this is the landing spot from $ref","$id":"start","$dynamicRef":"inner_scope#thingy"},"thingy":{"$comment":"this is the first stop for the $dynamicRef","$id":"inner_scope","$dynamicAnchor":"thingy","type":"string"}}}"#,
        #""a string""#,
        false,
    );
}

test "after leaving a dynamic scope, it is not used by a $dynamicRef: first_scope is not in dynamic scope for the $dynamicRef" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamic-ref-leaving-dynamic-scope/main","if":{"$id":"first_scope","$defs":{"thingy":{"$comment":"this is first_scope#thingy","$dynamicAnchor":"thingy","type":"number"}}},"then":{"$id":"second_scope","$ref":"start","$defs":{"thingy":{"$comment":"this is second_scope#thingy, the final destination of the $dynamicRef","$dynamicAnchor":"thingy","type":"null"}}},"$defs":{"start":{"$comment":"this is the landing spot from $ref","$id":"start","$dynamicRef":"inner_scope#thingy"},"thingy":{"$comment":"this is the first stop for the $dynamicRef","$id":"inner_scope","$dynamicAnchor":"thingy","type":"string"}}}"#,
        #"42"#,
        false,
    );
}

test "after leaving a dynamic scope, it is not used by a $dynamicRef: /then/$defs/thingy is the final stop for the $dynamicRef" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamic-ref-leaving-dynamic-scope/main","if":{"$id":"first_scope","$defs":{"thingy":{"$comment":"this is first_scope#thingy","$dynamicAnchor":"thingy","type":"number"}}},"then":{"$id":"second_scope","$ref":"start","$defs":{"thingy":{"$comment":"this is second_scope#thingy, the final destination of the $dynamicRef","$dynamicAnchor":"thingy","type":"null"}}},"$defs":{"start":{"$comment":"this is the landing spot from $ref","$id":"start","$dynamicRef":"inner_scope#thingy"},"thingy":{"$comment":"this is the first stop for the $dynamicRef","$id":"inner_scope","$dynamicAnchor":"thingy","type":"string"}}}"#,
        #"null"#,
        true,
    );
}

test "strict-tree schema, guards against misspelled properties: instance with misspelled field" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"http://localhost:1234/draft2020-12/strict-tree.json","$dynamicAnchor":"node","$ref":"tree.json","unevaluatedProperties":false}"#,
        #"{"children":[{"daat":1}]}"#,
        false,
        &REMOTES,
    );
}

test "strict-tree schema, guards against misspelled properties: instance with correct field" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"http://localhost:1234/draft2020-12/strict-tree.json","$dynamicAnchor":"node","$ref":"tree.json","unevaluatedProperties":false}"#,
        #"{"children":[{"data":1}]}"#,
        true,
        &REMOTES,
    );
}

test "tests for implementation dynamic anchor and reference link: incorrect parent schema" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"http://localhost:1234/draft2020-12/strict-extendible.json","$ref":"extendible-dynamic-ref.json","$defs":{"elements":{"$dynamicAnchor":"elements","properties":{"a":true},"required":["a"],"additionalProperties":false}}}"#,
        #"{"a":true}"#,
        false,
        &REMOTES,
    );
}

