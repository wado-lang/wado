        #"false"#,
        true,
    );
}

test "email format: all string formats ignore nulls" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"email"}"#,
        #"null"#,
        true,
    );
}

test "email format: invalid email string is only an annotation by default" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"email"}"#,
        #""2962""#,
        true,
    );
}

