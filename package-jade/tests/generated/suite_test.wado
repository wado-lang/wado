    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date"}"#,
        #""1998-01-1""#,
        false,
    );
}

test "validation of date strings: invalid month" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date"}"#,
        #""1998-13-01""#,
        false,
    );
}

