        #"{}"#,
        true,
    );
}

test "validation of IP addresses: all string formats ignore arrays" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"ipv4"}"#,
        #"[]"#,
        true,
    );
}

test "validation of IP addresses: all string formats ignore booleans" {
    check_format(
