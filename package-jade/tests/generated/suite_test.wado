    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":false}"#,
        #"[["foo"],["bar"]]"#,
        true,
    );
}

test "uniqueItems=false validation: non-unique array of arrays is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":false}"#,
        #"[["foo"],["foo"]]"#,
        true,
    );
}

test "uniqueItems=false validation: unique heterogeneous types are valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":false}"#,
        #"[{},[1],true,null,1]"#,
        true,
    );
}

test "uniqueItems=false validation: non-unique heterogeneous types are valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":false}"#,
        #"[{},[1],true,null,{},1]"#,
        true,
    );
}

