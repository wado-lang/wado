        #""2020-12-31""#,
        true,
    );
}

test "validation of date strings: a invalid date string with 32 days in December" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date"}"#,
        #""2020-12-32""#,
        false,
    );
}

test "validation of date strings: an invalid date string" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date"}"#,
        #""06/19/1963""#,
        false,
    );
}

test "validation of date strings: only RFC3339 not all of ISO 8601 are valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date"}"#,
        #""2013-350""#,
        false,
    );
}

test "validation of date strings: non-padded month dates are not valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date"}"#,
        #""1998-1-20""#,
