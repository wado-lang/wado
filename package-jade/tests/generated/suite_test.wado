test "multiple types can be specified in an array: an integer is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":["integer","string"]}"#,
        #"1"#,
        true,
    );
}

test "multiple types can be specified in an array: a string is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":["integer","string"]}"#,
        #""foo""#,
        true,
    );
}

test "multiple types can be specified in an array: a float is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":["integer","string"]}"#,
        #"1.1"#,
        false,
    );
}

test "multiple types can be specified in an array: an object is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":["integer","string"]}"#,
        #"{}"#,
        false,
    );
}

test "multiple types can be specified in an array: an array is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":["integer","string"]}"#,
        #"[]"#,
        false,
    );
}

test "multiple types can be specified in an array: a boolean is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":["integer","string"]}"#,
        #"true"#,
        false,
    );
}

test "multiple types can be specified in an array: null is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":["integer","string"]}"#,
        #"null"#,
        false,
    );
}

