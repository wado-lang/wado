    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":false}"#,
        #"[{"foo":"bar"},{"foo":"bar"}]"#,
        true,
    );
}

test "uniqueItems=false validation: unique array of nested objects is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":false}"#,
        #"[{"foo":{"bar":{"baz":true}}},{"foo":{"bar":{"baz":false}}}]"#,
        true,
    );
}

test "uniqueItems=false validation: non-unique array of nested objects is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":false}"#,
        #"[{"foo":{"bar":{"baz":true}}},{"foo":{"bar":{"baz":true}}}]"#,
        true,
    );
}

