    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"integer","multipleOf":0.5}"#,
        #""#,
        true,
    );
}

// optional/id.json

test "$id inside an enum is not a real identifier: exact match to enum, and type matches" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"id_in_enum":{"enum":[{"$id":"https://localhost:1234/draft2020-12/id/my_identifier.json","type":"null"}]},"real_id_in_schema":{"$id":"https://localhost:1234/draft2020-12/id/my_identifier.json","type":"string"},"zzz_id_in_const":{"const":{"$id":"https://localhost:1234/draft2020-12/id/my_identifier.json","type":"null"}}},"anyOf":[{"$ref":"#/$defs/id_in_enum"},{"$ref":"https://localhost:1234/draft2020-12/id/my_identifier.json"}]}"##,
        #"{"$id":"https://localhost:1234/draft2020-12/id/my_identifier.json","type":"null"}"#,
        true,
    );
}

test "$id inside an enum is not a real identifier: match $ref to $id" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"id_in_enum":{"enum":[{"$id":"https://localhost:1234/draft2020-12/id/my_identifier.json","type":"null"}]},"real_id_in_schema":{"$id":"https://localhost:1234/draft2020-12/id/my_identifier.json","type":"string"},"zzz_id_in_const":{"const":{"$id":"https://localhost:1234/draft2020-12/id/my_identifier.json","type":"null"}}},"anyOf":[{"$ref":"#/$defs/id_in_enum"},{"$ref":"https://localhost:1234/draft2020-12/id/my_identifier.json"}]}"##,
        #""a string to match #/$defs/id_in_enum""#,
        true,
    );
}

test "$id inside an enum is not a real identifier: no match on enum or $ref to $id" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"id_in_enum":{"enum":[{"$id":"https://localhost:1234/draft2020-12/id/my_identifier.json","type":"null"}]},"real_id_in_schema":{"$id":"https://localhost:1234/draft2020-12/id/my_identifier.json","type":"string"},"zzz_id_in_const":{"const":{"$id":"https://localhost:1234/draft2020-12/id/my_identifier.json","type":"null"}}},"anyOf":[{"$ref":"#/$defs/id_in_enum"},{"$ref":"https://localhost:1234/draft2020-12/id/my_identifier.json"}]}"##,
        #"1"#,
        false,
    );
}

// optional/no-schema.json

test "validation without $schema: a 3-character string is valid" {
    check(
        #"{"minLength":2}"#,
        #""foo""#,
        true,
    );
}

test "validation without $schema: a 1-character string is not valid" {
    check(
        #"{"minLength":2}"#,
        #""a""#,
        false,
    );
}

test "validation without $schema: a non-string is valid" {
    check(
        #"{"minLength":2}"#,
        #"5"#,
        true,
    );
}

// optional/non-bmp-regex.json

test "Proper UTF-16 surrogate pair handling: pattern: matches empty" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","pattern":"^🐲*$"}"#,
        #""""#,
        true,
    );
}

test "Proper UTF-16 surrogate pair handling: pattern: matches single" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","pattern":"^🐲*$"}"#,
        #""🐲""#,
        true,
    );
}

test "Proper UTF-16 surrogate pair handling: pattern: matches two" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","pattern":"^🐲*$"}"#,
        #""🐲🐲""#,
        true,
    );
}

test "Proper UTF-16 surrogate pair handling: pattern: doesn't match one" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","pattern":"^🐲*$"}"#,
        #""🐉""#,
        false,
    );
}

test "Proper UTF-16 surrogate pair handling: pattern: doesn't match two" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","pattern":"^🐲*$"}"#,
        #""🐉🐉""#,
        false,
    );
}

test "Proper UTF-16 surrogate pair handling: pattern: doesn't match one ASCII" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","pattern":"^🐲*$"}"#,
        #""D""#,
        false,
    );
}

test "Proper UTF-16 surrogate pair handling: pattern: doesn't match two ASCII" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","pattern":"^🐲*$"}"#,
        #""DD""#,
        false,
    );
}

test "Proper UTF-16 surrogate pair handling: patternProperties: matches empty" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"^🐲*$":{"type":"integer"}}}"#,
        #"{"":1}"#,
        true,
    );
}

test "Proper UTF-16 surrogate pair handling: patternProperties: matches single" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"^🐲*$":{"type":"integer"}}}"#,
        #"{"🐲":1}"#,
        true,
    );
}

test "Proper UTF-16 surrogate pair handling: patternProperties: matches two" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"^🐲*$":{"type":"integer"}}}"#,
        #"{"🐲🐲":1}"#,
        true,
    );
}

test "Proper UTF-16 surrogate pair handling: patternProperties: doesn't match one" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"^🐲*$":{"type":"integer"}}}"#,
        #"{"🐲":"hello"}"#,
        false,
    );
}

test "Proper UTF-16 surrogate pair handling: patternProperties: doesn't match two" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"^🐲*$":{"type":"integer"}}}"#,
        #"{"🐲🐲":"hello"}"#,
        false,
    );
}

// optional/unknownKeyword.json

test "$id inside an unknown keyword is not a real identifier: type matches second anyOf, which has a real schema in it" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"id_in_unknown0":{"not":{"array_of_schemas":[{"$id":"https://localhost:1234/draft2020-12/unknownKeyword/my_identifier.json","type":"null"}]}},"real_id_in_schema":{"$id":"https://localhost:1234/draft2020-12/unknownKeyword/my_identifier.json","type":"string"},"id_in_unknown1":{"not":{"object_of_schemas":{"foo":{"$id":"https://localhost:1234/draft2020-12/unknownKeyword/my_identifier.json","type":"integer"}}}}},"anyOf":[{"$ref":"#/$defs/id_in_unknown0"},{"$ref":"#/$defs/id_in_unknown1"},{"$ref":"https://localhost:1234/draft2020-12/unknownKeyword/my_identifier.json"}]}"##,
        #""a string""#,
        true,
    );
}

test "$id inside an unknown keyword is not a real identifier: type matches non-schema in first anyOf" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"id_in_unknown0":{"not":{"array_of_schemas":[{"$id":"https://localhost:1234/draft2020-12/unknownKeyword/my_identifier.json","type":"null"}]}},"real_id_in_schema":{"$id":"https://localhost:1234/draft2020-12/unknownKeyword/my_identifier.json","type":"string"},"id_in_unknown1":{"not":{"object_of_schemas":{"foo":{"$id":"https://localhost:1234/draft2020-12/unknownKeyword/my_identifier.json","type":"integer"}}}}},"anyOf":[{"$ref":"#/$defs/id_in_unknown0"},{"$ref":"#/$defs/id_in_unknown1"},{"$ref":"https://localhost:1234/draft2020-12/unknownKeyword/my_identifier.json"}]}"##,
        #"null"#,
        false,
    );
}

test "$id inside an unknown keyword is not a real identifier: type matches non-schema in third anyOf" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"id_in_unknown0":{"not":{"array_of_schemas":[{"$id":"https://localhost:1234/draft2020-12/unknownKeyword/my_identifier.json","type":"null"}]}},"real_id_in_schema":{"$id":"https://localhost:1234/draft2020-12/unknownKeyword/my_identifier.json","type":"string"},"id_in_unknown1":{"not":{"object_of_schemas":{"foo":{"$id":"https://localhost:1234/draft2020-12/unknownKeyword/my_identifier.json","type":"integer"}}}}},"anyOf":[{"$ref":"#/$defs/id_in_unknown0"},{"$ref":"#/$defs/id_in_unknown1"},{"$ref":"https://localhost:1234/draft2020-12/unknownKeyword/my_identifier.json"}]}"##,
        #"1"#,
        false,
    );
}

// optional/format/date-time.json

test "validation of date-time strings: all string formats ignore integers" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #"12"#,
        true,
    );
}

test "validation of date-time strings: all string formats ignore floats" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #"13.7"#,
        true,
    );
}

test "validation of date-time strings: all string formats ignore objects" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #"{}"#,
        true,
    );
}

test "validation of date-time strings: all string formats ignore arrays" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #"[]"#,
        true,
    );
}

test "validation of date-time strings: all string formats ignore booleans" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #"false"#,
        true,
    );
}

test "validation of date-time strings: all string formats ignore nulls" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #"null"#,
        true,
    );
}

test "validation of date-time strings: a valid date-time string" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1963-06-19T08:30:06.283185Z""#,
        true,
    );
}

test "validation of date-time strings: a valid date-time string without second fraction" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1963-06-19T08:30:06Z""#,
        true,
    );
}

test "validation of date-time strings: a valid date-time string with plus offset" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1937-01-01T12:00:27.87+00:20""#,
        true,
    );
}

test "validation of date-time strings: a valid date-time string with minus offset" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1990-12-31T15:59:50.123-08:00""#,
        true,
    );
}

test "validation of date-time strings: a valid date-time with a leap second, UTC" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1998-12-31T23:59:60Z""#,
        true,
    );
}

test "validation of date-time strings: a valid date-time with a leap second, with minus offset" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1998-12-31T15:59:60.123-08:00""#,
        true,
    );
}

test "validation of date-time strings: an invalid date-time past leap second, UTC" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1998-12-31T23:59:61Z""#,
        false,
    );
}

test "validation of date-time strings: an invalid date-time with leap second on a wrong minute, UTC" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1998-12-31T23:58:60Z""#,
        false,
    );
}

test "validation of date-time strings: an invalid date-time with leap second on a wrong hour, UTC" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1998-12-31T22:59:60Z""#,
        false,
    );
}

test "validation of date-time strings: an invalid day in date-time string" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1990-02-31T15:59:59.123-08:00""#,
        false,
    );
}

test "validation of date-time strings: an invalid offset in date-time string" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1990-12-31T15:59:59-24:00""#,
        false,
    );
}

test "validation of date-time strings: an invalid closing Z after time-zone offset" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1963-06-19T08:30:06.28123+01:00Z""#,
        false,
    );
}

test "validation of date-time strings: an invalid hour in date-time string" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1990-12-31T24:00:00Z""#,
        false,
    );
}

test "validation of date-time strings: an invalid minute in date-time string" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1990-12-31T15:60:00Z""#,
        false,
    );
}

test "validation of date-time strings: an invalid offset minute in date-time string" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1990-12-31T10:00:00+10:60""#,
        false,
    );
}

test "validation of date-time strings: an invalid date-time string" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""06/19/1963 08:30:06 PST""#,
        false,
    );
}

test "validation of date-time strings: case-insensitive T and Z" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1963-06-19t08:30:06.283185z""#,
        true,
    );
}

test "validation of date-time strings: only RFC3339 not all of ISO 8601 are valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""2013-350T01:01:01""#,
        false,
    );
}

test "validation of date-time strings: invalid non-padded month dates" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1963-6-19T08:30:06.283185Z""#,
        false,
    );
}

test "validation of date-time strings: invalid non-padded day dates" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1963-06-1T08:30:06.283185Z""#,
        false,
    );
}

test "validation of date-time strings: invalid non-ASCII '৪' (a Bengali 4) in date portion" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1963-06-1৪T00:00:00Z""#,
        false,
    );
}

test "validation of date-time strings: invalid non-ASCII '৪' (a Bengali 4) in time portion" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1963-06-11T0৪:00:00Z""#,
        false,
    );
}

test "validation of date-time strings: invalid extended year" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""+11963-06-19T08:30:06.283185Z""#,
        false,
    );
}

test "validation of date-time strings: a numeric offset without minutes is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1985-04-12T23:20:50+01""#,
        false,
    );
}

test "validation of date-time strings: hour 24 is invalid even with a leap second" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""2016-12-31T24:59:60+01:00""#,
        false,
    );
}

test "validation of date-time strings: a second fraction of fifteen nines is valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1985-04-12T00:59:59.999999999999999Z""#,
        true,
    );
}

test "validation of date-time strings: a trailing newline is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1985-04-12T23:20:50Z\n""#,
        false,
    );
}

test "validation of date-time strings: an invalid date-time string without seconds" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1985-04-12T23:20Z""#,
        false,
    );
}

test "validation of date-time strings: an invalid date-time string with trailing content after the offset" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1985-04-12T23:20:50Ztail""#,
        false,
    );
}

test "validation of date-time strings: an invalid minute in date-time string, with a numeric offset" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1985-04-12T23:60:00+00:01""#,
        false,
    );
}

test "validation of date-time strings: a valid date-time string with 28 days in February (normal)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""2021-02-28T00:00:00Z""#,
        true,
    );
}

test "validation of date-time strings: an invalid date-time string with 30 days in February (leap)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""2020-02-30T00:00:00Z""#,
        false,
    );
}

test "validation of date-time strings: 2021 is not a leap year" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""2021-02-29T00:00:00Z""#,
        false,
    );
}

test "validation of date-time strings: 2020 is a leap year" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""2020-02-29T00:00:00Z""#,
        true,
    );
}

test "validation of date-time strings: century year 0100 is not a leap year" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""0100-02-29T00:00:00Z""#,
        false,
    );
}

test "validation of date-time strings: century year 0400 is a leap year" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""0400-02-29T00:00:00Z""#,
        true,
    );
}

test "validation of date-time strings: century year 2100 is not a leap year" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""2100-02-29T00:00:00Z""#,
        false,
    );
}

test "validation of date-time strings: a second fraction with no digits" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1985-04-12T23:20:50.Z""#,
        false,
    );
}

test "validation of date-time strings: a comma decimal separator with a time-offset" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1985-04-12T23:20:50,5Z""#,
        false,
    );
}

test "validation of date-time strings: leading whitespace before a valid date-time" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #"" 1985-04-12T23:20:50Z""#,
        false,
    );
}

test "validation of date-time strings: trailing whitespace after a valid date-time" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date-time"}"#,
        #""1985-04-12T23:20:50Z ""#,
        false,
    );
}

