    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date"}"#,
        #""20230328""#,
        false,
    );
}

test "validation of date strings: ISO8601 / non-RFC3339: week number implicit day of week (2023-01-02)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"date"}"#,
        #""2023-W01""#,
        false,
