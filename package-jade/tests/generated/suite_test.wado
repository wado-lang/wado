    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[false]}"#,
        #"0"#,
        false,
    );
}

test "enum with false does not match 0: float zero is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[false]}"#,
        #"0"#,
        false,
    );
}

