test "validation of regular expressions: all string formats ignore nulls" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #"null"#,
        true,
    );
}

test "validation of regular expressions: a valid regular expression" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""([abc])+\\s+$""#,
        true,
    );
}

test "validation of regular expressions: a regular expression with unclosed parens is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""^(abc]""#,
        false,
    );
}

test "validation of regular expressions: a quantifier with nothing to repeat is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""*a""#,
        false,
    );
}

test "validation of regular expressions: a character class range in reverse order is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""[z-a]""#,
        false,
    );
}

test "validation of regular expressions: a trailing backslash is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""\\""#,
        false,
    );
}

test "validation of regular expressions: an unmatched closing parenthesis is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""a)""#,
        false,
    );
}

test "validation of regular expressions: an unterminated character class is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""[abc""#,
        false,
    );
}

test "validation of regular expressions: an empty regular expression is valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""""#,
        true,
    );
}

test "validation of regular expressions: alternation is valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""a|b""#,
        true,
    );
}

test "validation of regular expressions: a bounded quantifier is valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""a{2,3}""#,
        true,
    );
}

test "validation of regular expressions: a negated range character class is valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""[^a-z]""#,
        true,
    );
}

test "validation of regular expressions: a lazy quantifier is valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"regex"}"#,
        #""a+?""#,
        true,
    );
}

// optional/format/relative-json-pointer.json

test "validation of Relative JSON Pointers (RJP): all string formats ignore integers" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #"12"#,
        true,
    );
}

test "validation of Relative JSON Pointers (RJP): all string formats ignore floats" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #"13.7"#,
        true,
    );
}

test "validation of Relative JSON Pointers (RJP): all string formats ignore objects" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #"{}"#,
        true,
    );
}

test "validation of Relative JSON Pointers (RJP): all string formats ignore arrays" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #"[]"#,
        true,
    );
}

test "validation of Relative JSON Pointers (RJP): all string formats ignore booleans" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #"false"#,
        true,
    );
}

test "validation of Relative JSON Pointers (RJP): all string formats ignore nulls" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #"null"#,
        true,
    );
}

test "validation of Relative JSON Pointers (RJP): a valid upwards RJP" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""1""#,
        true,
    );
}

test "validation of Relative JSON Pointers (RJP): a valid downwards RJP" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""0/foo/bar""#,
        true,
    );
}

test "validation of Relative JSON Pointers (RJP): a valid up and then down RJP, with array index" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""2/0/baz/1/zip""#,
        true,
    );
}

test "validation of Relative JSON Pointers (RJP): a valid RJP taking the member or index name" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""0#""#,
        true,
    );
}

test "validation of Relative JSON Pointers (RJP): an invalid RJP that is a valid JSON Pointer" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""/foo/bar""#,
        false,
    );
}

test "validation of Relative JSON Pointers (RJP): a json-pointer part that does not start with a slash is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""1foo""#,
        false,
    );
}

test "validation of Relative JSON Pointers (RJP): negative prefix" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""-1/foo/bar""#,
        false,
    );
}

test "validation of Relative JSON Pointers (RJP): explicit positive prefix" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""+1/foo/bar""#,
        false,
    );
}

test "validation of Relative JSON Pointers (RJP): non-ASCII digit in the prefix is not allowed" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""١/foo""#,
        false,
    );
}

test "validation of Relative JSON Pointers (RJP): ## is not a valid json-pointer" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""0##""#,
        false,
    );
}

test "validation of Relative JSON Pointers (RJP): zero cannot be followed by other digits, plus json-pointer" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""01/a""#,
        false,
    );
}

test "validation of Relative JSON Pointers (RJP): zero cannot be followed by other digits, plus octothorpe" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""01#""#,
        false,
    );
}

test "validation of Relative JSON Pointers (RJP): empty string" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""""#,
        false,
    );
}

test "validation of Relative JSON Pointers (RJP): multi-digit integer prefix" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""120/foo/bar""#,
        true,
    );
}

test "validation of Relative JSON Pointers (RJP): multi-digit prefix with a zero followed by another digit" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""100""#,
        true,
    );
}

test "validation of Relative JSON Pointers (RJP): tilde not followed by 0 or 1 in the json-pointer part" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""0/~2""#,
        false,
    );
}

test "validation of Relative JSON Pointers (RJP): unescaped tilde at the end of the json-pointer part" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""0/foo/bar~""#,
        false,
    );
}

test "validation of Relative JSON Pointers (RJP): octothorpe followed by a json-pointer" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""1#/foo/bar""#,
        false,
    );
}

test "validation of Relative JSON Pointers (RJP): empty reference tokens in the json-pointer part" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""0//""#,
        true,
    );
}

test "validation of Relative JSON Pointers (RJP): valid escaped slash (~1) in the json-pointer part" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""0/a~1b""#,
        true,
    );
}

test "validation of Relative JSON Pointers (RJP): valid escaped tilde (~0) in the json-pointer part" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""0/m~0n""#,
        true,
    );
}

test "validation of Relative JSON Pointers (RJP): multiple escaped characters in the json-pointer part" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""0/~1~0~0~1~1""#,
        true,
    );
}

test "validation of Relative JSON Pointers (RJP): - used as a member name in the json-pointer part" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""1/foo/-""#,
        true,
    );
}

test "validation of Relative JSON Pointers (RJP): multiple unescaped tildes in the json-pointer part" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""0/~~""#,
        false,
    );
}

test "validation of Relative JSON Pointers (RJP): trailing newline after the non-negative integer" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"relative-json-pointer"}"#,
        #""1\n""#,
        false,
    );
}

// optional/format/time.json

test "validation of time strings: all string formats ignore integers" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #"12"#,
        true,
    );
}

test "validation of time strings: all string formats ignore floats" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #"13.7"#,
        true,
    );
}

test "validation of time strings: all string formats ignore objects" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #"{}"#,
        true,
    );
}

test "validation of time strings: all string formats ignore arrays" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #"[]"#,
        true,
    );
}

test "validation of time strings: all string formats ignore booleans" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #"false"#,
        true,
    );
}

test "validation of time strings: all string formats ignore nulls" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #"null"#,
        true,
    );
}

test "validation of time strings: a valid time string" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""08:30:06Z""#,
        true,
    );
}

test "validation of time strings: invalid time string with extra leading zeros" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""008:030:006Z""#,
        false,
    );
}

test "validation of time strings: invalid time string with no leading zero for single digit" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""8:3:6Z""#,
        false,
    );
}

test "validation of time strings: hour, minute, second must be two digits" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""8:0030:6Z""#,
        false,
    );
}

test "validation of time strings: a valid time string with leap second, Zulu" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""23:59:60Z""#,
        true,
    );
}

test "validation of time strings: invalid leap second, Zulu (wrong hour)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""22:59:60Z""#,
        false,
    );
}

test "validation of time strings: invalid leap second, Zulu (wrong minute)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""23:58:60Z""#,
        false,
    );
}

test "validation of time strings: valid leap second, zero time-offset" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""23:59:60+00:00""#,
        true,
    );
}

test "validation of time strings: invalid leap second, zero time-offset (wrong hour)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""22:59:60+00:00""#,
        false,
    );
}

test "validation of time strings: invalid leap second, zero time-offset (wrong minute)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""23:58:60+00:00""#,
        false,
    );
}

test "validation of time strings: valid leap second, positive time-offset" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""01:29:60+01:30""#,
        true,
    );
}

test "validation of time strings: valid leap second, large positive time-offset" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""23:29:60+23:30""#,
        true,
    );
}

test "validation of time strings: invalid leap second, positive time-offset (wrong hour)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""23:59:60+01:00""#,
        false,
    );
}

test "validation of time strings: invalid leap second, positive time-offset (wrong minute)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""23:59:60+00:30""#,
        false,
    );
}

test "validation of time strings: valid leap second, negative time-offset" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""15:59:60-08:00""#,
        true,
    );
}

test "validation of time strings: valid leap second, large negative time-offset" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""00:29:60-23:30""#,
        true,
    );
}

test "validation of time strings: invalid leap second, negative time-offset (wrong hour)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""23:59:60-01:00""#,
        false,
    );
}

test "validation of time strings: invalid leap second, negative time-offset (wrong minute)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""23:59:60-00:30""#,
        false,
    );
}

test "validation of time strings: a valid time string with second fraction" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""23:20:50.52Z""#,
        true,
    );
}

test "validation of time strings: a valid time string with precise second fraction" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""08:30:06.283185Z""#,
        true,
    );
}

test "validation of time strings: a valid time string with plus offset" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""08:30:06+00:20""#,
        true,
    );
}

test "validation of time strings: a valid time string with minus offset" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""08:30:06-08:00""#,
        true,
    );
}

test "validation of time strings: time with unknown local offset is valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""12:34:56-00:00""#,
        true,
    );
}

test "validation of time strings: hour, minute in time-offset must be two digits" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""08:30:06-8:000""#,
        false,
    );
}

test "validation of time strings: a valid time string with case-insensitive Z" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""08:30:06z""#,
        true,
    );
}

test "validation of time strings: an invalid time string with invalid hour" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""24:00:00Z""#,
        false,
    );
}

test "validation of time strings: an invalid time string with invalid minute" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""00:60:00Z""#,
        false,
    );
}

test "validation of time strings: an invalid time string with invalid second" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""00:00:61Z""#,
        false,
    );
}

test "validation of time strings: an invalid time string with invalid time numoffset hour" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""01:02:03+24:00""#,
        false,
    );
}

test "validation of time strings: an invalid time string with invalid time numoffset minute" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""01:02:03+00:60""#,
        false,
    );
}

test "validation of time strings: an invalid time string with invalid time with both Z and numoffset" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""01:02:03Z+00:30""#,
        false,
    );
}

test "validation of time strings: an invalid offset indicator" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""08:30:06 PST""#,
        false,
    );
}

test "validation of time strings: only RFC3339 not all of ISO 8601 are valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""01:01:01,1111""#,
        false,
    );
}

test "validation of time strings: no time offset" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""12:00:00""#,
        false,
    );
}

test "validation of time strings: no time offset with second fraction" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""12:00:00.52""#,
        false,
    );
}

test "validation of time strings: invalid non-ASCII '২' (a Bengali 2)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""1২:00:00Z""#,
        false,
    );
}

test "validation of time strings: offset not starting with plus or minus" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""08:30:06#00:20""#,
        false,
    );
}

test "validation of time strings: contains letters" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""ab:cd:ef""#,
        false,
    );
}

test "validation of time strings: an invalid time string in date-time format" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""2020-11-28T23:55:45Z""#,
        false,
    );
}

test "validation of time strings: a numeric time-offset requires the colon separator" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""08:30:06+0130""#,
        false,
    );
}

test "validation of time strings: a numeric time-offset requires the minutes component" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""08:30:06+01""#,
        false,
    );
}

test "validation of time strings: a trailing newline after a valid time" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""08:30:06Z\n""#,
        false,
    );
}

test "validation of time strings: hour 24 is invalid with a numeric time-offset" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""24:59:00+01:00""#,
        false,
    );
}

test "validation of time strings: minute 60 is invalid with a numeric time-offset" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""23:60:00+00:01""#,
        false,
    );
}

test "validation of time strings: a valid time string with a 15 digit second fraction" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""00:59:59.999999999999999Z""#,
        true,
    );
}

test "validation of time strings: a second fraction with no digits" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""08:30:06.Z""#,
        false,
    );
}

test "validation of time strings: partial-time requires the seconds component" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""12:00Z""#,
        false,
    );
}

test "validation of time strings: a comma decimal separator with a time-offset" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""08:30:06,5Z""#,
        false,
    );
}

test "validation of time strings: leading whitespace before a valid time" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #"" 08:30:06Z""#,
        false,
    );
}

test "validation of time strings: trailing whitespace after a valid time" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"time"}"#,
        #""08:30:06Z ""#,
        false,
    );
}

// optional/format/unknown.json

test "unknown format: unknown formats ignore integers" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"unknown"}"#,
        #"12"#,
        true,
    );
}

test "unknown format: unknown formats ignore floats" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"unknown"}"#,
        #"13.7"#,
        true,
    );
}

test "unknown format: unknown formats ignore objects" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"unknown"}"#,
        #"{}"#,
        true,
    );
}

test "unknown format: unknown formats ignore arrays" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"unknown"}"#,
        #"[]"#,
        true,
    );
}

test "unknown format: unknown formats ignore booleans" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"unknown"}"#,
        #"false"#,
        true,
    );
}

test "unknown format: unknown formats ignore nulls" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"unknown"}"#,
        #"null"#,
        true,
    );
}

test "unknown format: unknown formats ignore strings" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"unknown"}"#,
        #""string""#,
        true,
    );
}

// optional/format/uri-reference.json

test "validation of URI References: all string formats ignore integers" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #"12"#,
        true,
    );
}

test "validation of URI References: all string formats ignore floats" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #"13.7"#,
        true,
    );
}

test "validation of URI References: all string formats ignore objects" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #"{}"#,
        true,
    );
}

test "validation of URI References: all string formats ignore arrays" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #"[]"#,
        true,
    );
}

test "validation of URI References: all string formats ignore booleans" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #"false"#,
        true,
    );
}

test "validation of URI References: all string formats ignore nulls" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #"null"#,
        true,
    );
}

test "validation of URI References: a valid URI" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""http://foo.bar/?baz=qux#quux""#,
        true,
    );
}

test "validation of URI References: a valid protocol-relative URI Reference" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""//foo.bar/?baz=qux#quux""#,
        true,
    );
}

test "validation of URI References: a valid relative URI Reference" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""/abc""#,
        true,
    );
}

test "validation of URI References: an invalid URI Reference" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""\\\\WINDOWS\\fileshare""#,
        false,
    );
}

test "validation of URI References: a valid URI Reference" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""abc""#,
        true,
    );
}

test "validation of URI References: a valid URI fragment" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        ##""#fragment""##,
        true,
    );
}

test "validation of URI References: an invalid URI fragment" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        ##""#frag\\ment""##,
        false,
    );
}

test "validation of URI References: unescaped non US-ASCII characters" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""/foobar®.txt""#,
        false,
    );
}

test "validation of URI References: invalid backslash character" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""https://example.org/foobar\\.txt""#,
        false,
    );
}

test "validation of URI References: URI with leading-zero IPv4 is structurally valid as a reg-name" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""http://087.10.0.1/""#,
        true,
    );
}

test "validation of URI References: URI with out-of-bounds IPv4 is structurally valid as a reg-name" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""http://999.999.999.999/""#,
        true,
    );
}

test "validation of URI References: an empty URI reference" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""""#,
        true,
    );
}

test "validation of URI References: a query-only reference" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""?query=1""#,
        true,
    );
}

test "validation of URI References: a network-path reference with an empty authority" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""//""#,
        true,
    );
}

test "validation of URI References: an incomplete percent-encoding" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""/%zz""#,
        false,
    );
}

test "validation of URI References: incomplete percent-encoding triplet" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""/%A""#,
        false,
    );
}

test "validation of URI References: lone percent sign is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""/%""#,
        false,
    );
}

test "validation of URI References: a double quote in a path" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""/a\"b""#,
        false,
    );
}

test "validation of URI References: square brackets outside an authority" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""/[::1]""#,
        false,
    );
}

test "validation of URI References: a non-numeric port in a network-path reference" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""//example.com:abc/p""#,
        false,
    );
}

test "validation of URI References: more than one at-sign in the authority" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""//a@b@example.com/""#,
        false,
    );
}

test "validation of URI References: a leading zero in the IPv4 part of an IPv6 literal" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""//[::ffff:192.168.0.01]/p""#,
        false,
    );
}

test "validation of URI References: a colon in the first segment of a relative-path reference" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""1:b""#,
        false,
    );
}

test "validation of URI References: a colon in the first segment preceded by a dot-segment" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""./this:that""#,
        true,
    );
}

test "validation of URI References: a trailing line feed" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-reference"}"#,
        #""/p\n""#,
        false,
    );
}

// optional/format/uri-template.json

test "format: uri-template: all string formats ignore integers" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #"12"#,
        true,
    );
}

test "format: uri-template: all string formats ignore floats" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #"13.7"#,
        true,
    );
}

test "format: uri-template: all string formats ignore objects" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #"{}"#,
        true,
    );
}

test "format: uri-template: all string formats ignore arrays" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #"[]"#,
        true,
    );
}

test "format: uri-template: all string formats ignore booleans" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #"false"#,
        true,
    );
}

test "format: uri-template: all string formats ignore nulls" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #"null"#,
        true,
    );
}

test "format: uri-template: a valid uri-template" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""http://example.com/dictionary/{term:1}/{term}""#,
        true,
    );
}

test "format: uri-template: an invalid uri-template" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""http://example.com/dictionary/{term:1}/{term""#,
        false,
    );
}

test "format: uri-template: a valid uri-template without variables" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""http://example.com/dictionary""#,
        true,
    );
}

test "format: uri-template: a valid relative uri-template" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""dictionary/{term:1}/{term}""#,
        true,
    );
}

test "format: uri-template: an empty expression is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{}""#,
        false,
    );
}

test "format: uri-template: an empty varspec inside the variable list is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{a,,b}""#,
        false,
    );
}

test "format: uri-template: a zero prefix max-length is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{v:0}""#,
        false,
    );
}

test "format: uri-template: a five-digit prefix max-length is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{v:10000}""#,
        false,
    );
}

test "format: uri-template: an empty string is a valid uri-template" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""""#,
        true,
    );
}

test "format: uri-template: an unmatched closing brace is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""foo}bar""#,
        false,
    );
}

test "format: uri-template: a percent-encoded triplet in a literal is valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""a%41b""#,
        true,
    );
}

test "format: uri-template: a literal with a lone percent sign is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""a%""#,
        false,
    );
}

test "format: uri-template: a literal with an incomplete percent-encoded triplet is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""a%4""#,
        false,
    );
}

test "format: uri-template: a literal with non-hex percent encoding is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""a%GG""#,
        false,
    );
}

test "format: uri-template: a supplementary plane character in a literal is valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""a😀b""#,
        true,
    );
}

test "format: uri-template: a private-use character in a literal is valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""ab""#,
        true,
    );
}

test "format: uri-template: a supplementary private-use character in a literal is valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""a󰀀b""#,
        true,
    );
}

test "format: uri-template: reserved expansion operator" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{+var}""#,
        true,
    );
}

test "format: uri-template: fragment expansion operator" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{#var}""#,
        true,
    );
}

test "format: uri-template: label expansion operator" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{.var}""#,
        true,
    );
}

test "format: uri-template: path segment expansion operator" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{/var}""#,
        true,
    );
}

test "format: uri-template: path style parameter expansion operator" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{;var}""#,
        true,
    );
}

test "format: uri-template: form style query expansion operator" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{?var}""#,
        true,
    );
}

test "format: uri-template: form style query continuation operator" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{&var}""#,
        true,
    );
}

test "format: uri-template: the explode modifier is valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{var*}""#,
        true,
    );
}

test "format: uri-template: combined prefix and explode modifiers are invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{var:1*}""#,
        false,
    );
}

test "format: uri-template: a variable list with more than one varspec is valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{x,y}""#,
        true,
    );
}

test "format: uri-template: a dotted variable name is valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{a.b}""#,
        true,
    );
}

test "format: uri-template: a trailing dot in a variable name is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{a.}""#,
        false,
    );
}

test "format: uri-template: a double dot in a variable name is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{a..b}""#,
        false,
    );
}

test "format: uri-template: a variable name may start with a percent-encoded triplet" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{%41}""#,
        true,
    );
}

test "format: uri-template: a variable name with a lone percent sign is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{%}""#,
        false,
    );
}

test "format: uri-template: a variable name with an incomplete percent-encoded triplet is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{%4}""#,
        false,
    );
}

test "format: uri-template: a variable name with non-hex percent encoding is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{%GG}""#,
        false,
    );
}

test "format: uri-template: a four-digit prefix max-length is valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{v:1000}""#,
        true,
    );
}

test "format: uri-template: a leading zero in the prefix max-length is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{v:01}""#,
        false,
    );
}

test "format: uri-template: a space in a literal is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""a b""#,
        false,
    );
}

test "format: uri-template: a delete character in a literal is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""ab""#,
        false,
    );
}

test "format: uri-template: a trailing comma in the variable list is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{a,}""#,
        false,
    );
}

test "format: uri-template: a default value in a varspec is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{var=def}""#,
        false,
    );
}

test "format: uri-template: an operator in place of the first varspec is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""{,+var}""#,
        false,
    );
}

test "format: uri-template: an apostrophe in a literal is valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri-template"}"#,
        #""a'b""#,
        true,
    );
}

// optional/format/uri.json

test "validation of URIs: all string formats ignore integers" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #"12"#,
        true,
    );
}

test "validation of URIs: all string formats ignore floats" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #"13.7"#,
        true,
    );
}

test "validation of URIs: all string formats ignore objects" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #"{}"#,
        true,
    );
}

test "validation of URIs: all string formats ignore arrays" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #"[]"#,
        true,
    );
}

test "validation of URIs: all string formats ignore booleans" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #"false"#,
        true,
    );
}

test "validation of URIs: all string formats ignore nulls" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #"null"#,
        true,
    );
}

test "validation of URIs: a valid URL with anchor tag" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""http://foo.bar/?baz=qux#quux""#,
        true,
    );
}

test "validation of URIs: a valid URL with anchor tag and parentheses" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""http://foo.com/blah_(wikipedia)_blah#cite-1""#,
        true,
    );
}

test "validation of URIs: a valid URL with URL-encoded stuff" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""http://foo.bar/?q=Test%20URL-encoded%20stuff""#,
        true,
    );
}

test "validation of URIs: a valid puny-coded URL " {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""http://xn--nw2a.xn--j6w193g/""#,
        true,
    );
}

test "validation of URIs: a valid URL with many special characters" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""http://-.~_!$&'()*+,;=:%40:80%2f::::::@example.com""#,
        true,
    );
}

test "validation of URIs: a valid URL based on IPv4" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""http://223.255.255.254""#,
        true,
    );
}

test "validation of URIs: a valid URL with ftp scheme" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""ftp://ftp.is.co.za/rfc/rfc1808.txt""#,
        true,
    );
}

test "validation of URIs: a valid URL for a simple text file" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""http://www.ietf.org/rfc/rfc2396.txt""#,
        true,
    );
}

test "validation of URIs: a valid URL" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""ldap://[2001:db8::7]/c=GB?objectClass?one""#,
        true,
    );
}

test "validation of URIs: a valid mailto URI" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""mailto:John.Doe@example.com""#,
        true,
    );
}

test "validation of URIs: a valid newsgroup URI" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""news:comp.infosystems.www.servers.unix""#,
        true,
    );
}

test "validation of URIs: a valid tel URI" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""tel:+1-816-555-1212""#,
        true,
    );
}

test "validation of URIs: a valid URN" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""urn:oasis:names:specification:docbook:dtd:xml:4.1.2""#,
        true,
    );
}

test "validation of URIs: an invalid protocol-relative URI Reference" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""//foo.bar/?baz=qux#quux""#,
        false,
    );
}

test "validation of URIs: an invalid relative URI Reference" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""/abc""#,
        false,
    );
}

test "validation of URIs: an invalid URI" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""\\\\WINDOWS\\fileshare""#,
        false,
    );
}

test "validation of URIs: an invalid URI though valid URI reference" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""abc""#,
        false,
    );
}

test "validation of URIs: an invalid URI with spaces" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""http:// shouldfail.com""#,
        false,
    );
}

test "validation of URIs: an invalid URI with spaces and missing scheme" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #"":// should fail""#,
        false,
    );
}

test "validation of URIs: an invalid URI with comma in scheme" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""bar,baz:foo""#,
        false,
    );
}

test "validation of URIs: invalid userinfo" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""https://[@example.org/test.txt""#,
        false,
    );
}

test "validation of URIs: unescaped non US-ASCII characters" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""https://example.org/foobar®.txt""#,
        false,
    );
}

test "validation of URIs: invalid backslash character" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""https://example.org/foobar\\.txt""#,
        false,
    );
}

test "validation of URIs: invalid \" character" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""https://example.org/foobar\".txt""#,
        false,
    );
}

test "validation of URIs: invalid <> characters" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""https://example.org/foobar<>.txt""#,
        false,
    );
}

test "validation of URIs: invalid {} characters" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""https://example.org/foobar{}.txt""#,
        false,
    );
}

test "validation of URIs: invalid ^ character" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""https://example.org/foobar^.txt""#,
        false,
    );
}

test "validation of URIs: invalid ` character" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""https://example.org/foobar`.txt""#,
        false,
    );
}

test "validation of URIs: invalid SPACE character" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""https://example.org/foo bar.txt""#,
        false,
    );
}

test "validation of URIs: invalid | character" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""https://example.org/foobar|.txt""#,
        false,
    );
}

test "validation of URIs: URI with leading-zero IPv4 is structurally valid as a reg-name" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""http://087.10.0.1/""#,
        true,
    );
}

test "validation of URIs: URI with out-of-bounds IPv4 is structurally valid as a reg-name" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""http://999.999.999.999/""#,
        true,
    );
}

test "validation of URIs: invalid percent-encoding with non-hex digits" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""http://example.com/%6G""#,
        false,
    );
}

test "validation of URIs: incomplete percent-encoding triplet" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""http://example.com/%A""#,
        false,
    );
}

test "validation of URIs: lone percent sign is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""http://example.com/%""#,
        false,
    );
}

test "validation of URIs: scheme must start with a letter" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""1http://example.com""#,
        false,
    );
}

test "validation of URIs: invalid character in scheme" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""ht_tp://example.com""#,
        false,
    );
}

test "validation of URIs: non-numeric port is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""http://example.com:abc/path""#,
        false,
    );
}

test "validation of URIs: leading zero in an embedded IPv4 address is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""http://[::ffff:01.2.3.4]""#,
        false,
    );
}

test "validation of URIs: square brackets are not allowed in a path segment" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""http:/[::1]""#,
        false,
    );
}

test "validation of URIs: a trailing newline after a valid URI is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""http://foo.bar/\n""#,
        false,
    );
}

test "validation of URIs: an IPv6 address without enclosing brackets is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uri"}"#,
        #""http://2001:0db8:85a3:0000:0000:8a2e:0370:7334""#,
        false,
    );
}

// optional/format/uuid.json

test "uuid format: all string formats ignore integers (2)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #"12"#,
        true,
    );
}

test "uuid format: all string formats ignore floats (2)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #"13.7"#,
        true,
    );
}

test "uuid format: all string formats ignore objects (2)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #"{}"#,
        true,
    );
}

test "uuid format: all string formats ignore arrays (2)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #"[]"#,
        true,
    );
}

test "uuid format: all string formats ignore booleans (2)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #"false"#,
        true,
    );
}

test "uuid format: all string formats ignore nulls (2)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #"null"#,
        true,
    );
}

test "uuid format: all upper-case" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""2EB8AA08-AA98-11EA-B4AA-73B441D16380""#,
        true,
    );
}

test "uuid format: all lower-case" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""2eb8aa08-aa98-11ea-b4aa-73b441d16380""#,
        true,
    );
}

test "uuid format: mixed case" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""2eb8aa08-AA98-11ea-B4Aa-73B441D16380""#,
        true,
    );
}

test "uuid format: all zeroes is valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""00000000-0000-0000-0000-000000000000""#,
        true,
    );
}

test "uuid format: wrong length" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""2eb8aa08-aa98-11ea-b4aa-73b441d1638""#,
        false,
    );
}

test "uuid format: missing section" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""2eb8aa08-aa98-11ea-73b441d16380""#,
        false,
    );
}

test "uuid format: bad characters (not hex)" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""2eb8aa08-aa98-11ea-b4ga-73b441d16380""#,
        false,
    );
}

test "uuid format: no dashes" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""2eb8aa08aa9811eab4aa73b441d16380""#,
        false,
    );
}

test "uuid format: too few dashes" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""2eb8aa08aa98-11ea-b4aa73b441d16380""#,
        false,
    );
}

test "uuid format: too many dashes" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""2eb8-aa08-aa98-11ea-b4aa73b44-1d16380""#,
        false,
    );
}

test "uuid format: dashes in the wrong spot" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""2eb8aa08aa9811eab4aa73b441d16380----""#,
        false,
    );
}

test "uuid format: shifted dashes" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""2eb8aa0-8aa98-11e-ab4aa7-3b441d16380""#,
        false,
    );
}

test "uuid format: valid version 4" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""98d80576-482e-427f-8434-7f86890ab222""#,
        true,
    );
}

test "uuid format: valid version 5" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""99c17cbb-656f-564a-940f-1a4568f03487""#,
        true,
    );
}

test "uuid format: hypothetical version 6" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""99c17cbb-656f-664a-940f-1a4568f03487""#,
        true,
    );
}

test "uuid format: hypothetical version 15" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""99c17cbb-656f-f64a-940f-1a4568f03487""#,
        true,
    );
}

test "uuid format: URN prefixed UUID is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""urn:uuid:2eb8aa08-aa98-11ea-b4aa-73b441d16380""#,
        false,
    );
}

test "uuid format: a UUID wrapped in curly braces is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""{2eb8aa08-aa98-11ea-b4aa-73b441d16380}""#,
        false,
    );
}

test "uuid format: trailing hyphen after a complete UUID is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""2eb8aa08-aa98-11ea-b4aa-73b441d16380-""#,
        false,
    );
}

test "uuid format: non-ASCII digit '২' (a Bengali 2) is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""২eb8aa08-aa98-11ea-b4aa-73b441d16380""#,
        false,
    );
}

test "uuid format: an underscore in place of a hex digit is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""2eb8aa08-aa98-11ea-b4aa-73b441d1_380""#,
        false,
    );
}

test "uuid format: a trailing newline after a complete UUID is invalid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""2eb8aa08-aa98-11ea-b4aa-73b441d16380\n""#,
        false,
    );
}

test "uuid format: a variant nibble not defined by RFC 4122 is valid" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #""2eb8aa08-aa98-11ea-f4aa-73b441d16380""#,
        true,
    );
}
