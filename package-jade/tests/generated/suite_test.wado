// unevaluatedItems.json

test "unevaluatedItems true: with no unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedItems":true}"#,
        #"[]"#,
        true,
    );
}

test "unevaluatedItems true: with unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedItems":true}"#,
        #"["foo"]"#,
        true,
    );
}

test "unevaluatedItems false: with no unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedItems":false}"#,
        #"[]"#,
        true,
    );
}

test "unevaluatedItems false: with unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedItems":false}"#,
        #"["foo"]"#,
        false,
    );
}

test "unevaluatedItems as schema: with no unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedItems":{"type":"string"}}"#,
        #"[]"#,
        true,
    );
}

test "unevaluatedItems as schema: with valid unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedItems":{"type":"string"}}"#,
        #"["foo"]"#,
        true,
    );
}

test "unevaluatedItems as schema: with invalid unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedItems":{"type":"string"}}"#,
        #"[42]"#,
        false,
    );
}

test "unevaluatedItems with uniform items: unevaluatedItems doesn't apply" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","items":{"type":"string"},"unevaluatedItems":false}"#,
        #"["foo","bar"]"#,
        true,
    );
}

test "unevaluatedItems with tuple: with no unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"string"}],"unevaluatedItems":false}"#,
        #"["foo"]"#,
        true,
    );
}

test "unevaluatedItems with tuple: with unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"string"}],"unevaluatedItems":false}"#,
        #"["foo","bar"]"#,
        false,
    );
}

test "unevaluatedItems with items and prefixItems: unevaluatedItems doesn't apply" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"string"}],"items":true,"unevaluatedItems":false}"#,
        #"["foo",42]"#,
        true,
    );
}

test "unevaluatedItems with items: valid under items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","items":{"type":"number"},"unevaluatedItems":{"type":"string"}}"#,
        #"[5,6,7,8]"#,
        true,
    );
}

test "unevaluatedItems with items: invalid under items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","items":{"type":"number"},"unevaluatedItems":{"type":"string"}}"#,
        #"["foo","bar","baz"]"#,
        false,
    );
}

test "unevaluatedItems with nested tuple: with no unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"string"}],"allOf":[{"prefixItems":[true,{"type":"number"}]}],"unevaluatedItems":false}"#,
        #"["foo",42]"#,
        true,
    );
}

test "unevaluatedItems with nested tuple: with unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"string"}],"allOf":[{"prefixItems":[true,{"type":"number"}]}],"unevaluatedItems":false}"#,
        #"["foo",42,true]"#,
        false,
    );
}

test "unevaluatedItems with nested items: with only (valid) additional items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedItems":{"type":"boolean"},"anyOf":[{"items":{"type":"string"}},true]}"#,
        #"[true,false]"#,
        true,
    );
}

test "unevaluatedItems with nested items: with no additional items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedItems":{"type":"boolean"},"anyOf":[{"items":{"type":"string"}},true]}"#,
        #"["yes","no"]"#,
        true,
    );
}

test "unevaluatedItems with nested items: with invalid additional item" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedItems":{"type":"boolean"},"anyOf":[{"items":{"type":"string"}},true]}"#,
        #"["yes",false]"#,
        false,
    );
}

test "unevaluatedItems with nested prefixItems and items: with no additional items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"prefixItems":[{"type":"string"}],"items":true}],"unevaluatedItems":false}"#,
        #"["foo"]"#,
        true,
    );
}

test "unevaluatedItems with nested prefixItems and items: with additional items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"prefixItems":[{"type":"string"}],"items":true}],"unevaluatedItems":false}"#,
        #"["foo",42,true]"#,
        true,
    );
}

test "unevaluatedItems with nested unevaluatedItems: with no additional items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"prefixItems":[{"type":"string"}]},{"unevaluatedItems":true}],"unevaluatedItems":false}"#,
        #"["foo"]"#,
        true,
    );
}

test "unevaluatedItems with nested unevaluatedItems: with additional items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"prefixItems":[{"type":"string"}]},{"unevaluatedItems":true}],"unevaluatedItems":false}"#,
        #"["foo",42,true]"#,
        true,
    );
}

test "unevaluatedItems with anyOf: when one schema matches and has no unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"const":"foo"}],"anyOf":[{"prefixItems":[true,{"const":"bar"}]},{"prefixItems":[true,true,{"const":"baz"}]}],"unevaluatedItems":false}"#,
        #"["foo","bar"]"#,
        true,
    );
}

test "unevaluatedItems with anyOf: when one schema matches and has unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"const":"foo"}],"anyOf":[{"prefixItems":[true,{"const":"bar"}]},{"prefixItems":[true,true,{"const":"baz"}]}],"unevaluatedItems":false}"#,
        #"["foo","bar",42]"#,
        false,
    );
}

test "unevaluatedItems with anyOf: when two schemas match and has no unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"const":"foo"}],"anyOf":[{"prefixItems":[true,{"const":"bar"}]},{"prefixItems":[true,true,{"const":"baz"}]}],"unevaluatedItems":false}"#,
        #"["foo","bar","baz"]"#,
        true,
    );
}

test "unevaluatedItems with anyOf: when two schemas match and has unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"const":"foo"}],"anyOf":[{"prefixItems":[true,{"const":"bar"}]},{"prefixItems":[true,true,{"const":"baz"}]}],"unevaluatedItems":false}"#,
        #"["foo","bar","baz",42]"#,
        false,
    );
}

test "unevaluatedItems with oneOf: with no unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"const":"foo"}],"oneOf":[{"prefixItems":[true,{"const":"bar"}]},{"prefixItems":[true,{"const":"baz"}]}],"unevaluatedItems":false}"#,
        #"["foo","bar"]"#,
        true,
    );
}

test "unevaluatedItems with oneOf: with unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"const":"foo"}],"oneOf":[{"prefixItems":[true,{"const":"bar"}]},{"prefixItems":[true,{"const":"baz"}]}],"unevaluatedItems":false}"#,
        #"["foo","bar",42]"#,
        false,
    );
}

test "unevaluatedItems with not: with unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"const":"foo"}],"not":{"not":{"prefixItems":[true,{"const":"bar"}]}},"unevaluatedItems":false}"#,
        #"["foo","bar"]"#,
        false,
    );
}

test "unevaluatedItems with if/then/else: when if matches and it has no unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"const":"foo"}],"if":{"prefixItems":[true,{"const":"bar"}]},"then":{"prefixItems":[true,true,{"const":"then"}]},"else":{"prefixItems":[true,true,true,{"const":"else"}]},"unevaluatedItems":false}"#,
        #"["foo","bar","then"]"#,
        true,
    );
}

test "unevaluatedItems with if/then/else: when if matches and it has unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"const":"foo"}],"if":{"prefixItems":[true,{"const":"bar"}]},"then":{"prefixItems":[true,true,{"const":"then"}]},"else":{"prefixItems":[true,true,true,{"const":"else"}]},"unevaluatedItems":false}"#,
        #"["foo","bar","then","else"]"#,
        false,
    );
}

test "unevaluatedItems with if/then/else: when if doesn't match and it has no unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"const":"foo"}],"if":{"prefixItems":[true,{"const":"bar"}]},"then":{"prefixItems":[true,true,{"const":"then"}]},"else":{"prefixItems":[true,true,true,{"const":"else"}]},"unevaluatedItems":false}"#,
        #"["foo",42,42,"else"]"#,
        true,
    );
}

test "unevaluatedItems with if/then/else: when if doesn't match and it has unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"const":"foo"}],"if":{"prefixItems":[true,{"const":"bar"}]},"then":{"prefixItems":[true,true,{"const":"then"}]},"else":{"prefixItems":[true,true,true,{"const":"else"}]},"unevaluatedItems":false}"#,
        #"["foo",42,42,"else",42]"#,
        false,
    );
}

test "unevaluatedItems with boolean schemas: with no unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[true],"unevaluatedItems":false}"#,
        #"[]"#,
        true,
    );
}

test "unevaluatedItems with boolean schemas: with unevaluated items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[true],"unevaluatedItems":false}"#,
        #"["foo"]"#,
        false,
    );
}

test "unevaluatedItems with $ref: with no unevaluated items" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$ref":"#/$defs/bar","prefixItems":[{"type":"string"}],"unevaluatedItems":false,"$defs":{"bar":{"prefixItems":[true,{"type":"string"}]}}}"##,
        #"["foo","bar"]"#,
        true,
    );
}

test "unevaluatedItems with $ref: with unevaluated items" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$ref":"#/$defs/bar","prefixItems":[{"type":"string"}],"unevaluatedItems":false,"$defs":{"bar":{"prefixItems":[true,{"type":"string"}]}}}"##,
        #"["foo","bar","baz"]"#,
        false,
    );
}

test "unevaluatedItems before $ref: with no unevaluated items" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedItems":false,"prefixItems":[{"type":"string"}],"$ref":"#/$defs/bar","$defs":{"bar":{"prefixItems":[true,{"type":"string"}]}}}"##,
        #"["foo","bar"]"#,
        true,
    );
}

test "unevaluatedItems before $ref: with unevaluated items" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedItems":false,"prefixItems":[{"type":"string"}],"$ref":"#/$defs/bar","$defs":{"bar":{"prefixItems":[true,{"type":"string"}]}}}"##,
        #"["foo","bar","baz"]"#,
        false,
    );
}

test "unevaluatedItems with $dynamicRef: with no unevaluated items" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://example.com/unevaluated-items-with-dynamic-ref/derived","$ref":"./baseSchema","$defs":{"derived":{"$dynamicAnchor":"addons","prefixItems":[true,{"type":"string"}]},"baseSchema":{"$id":"./baseSchema","$comment":"unevaluatedItems comes first so it's more likely to catch bugs with implementations that are sensitive to keyword ordering","unevaluatedItems":false,"type":"array","prefixItems":[{"type":"string"}],"$dynamicRef":"#addons","$defs":{"defaultAddons":{"$comment":"Needed to satisfy the bookending requirement","$dynamicAnchor":"addons"}}}}}"##,
        #"["foo","bar"]"#,
        true,
    );
}

test "unevaluatedItems with $dynamicRef: with unevaluated items" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://example.com/unevaluated-items-with-dynamic-ref/derived","$ref":"./baseSchema","$defs":{"derived":{"$dynamicAnchor":"addons","prefixItems":[true,{"type":"string"}]},"baseSchema":{"$id":"./baseSchema","$comment":"unevaluatedItems comes first so it's more likely to catch bugs with implementations that are sensitive to keyword ordering","unevaluatedItems":false,"type":"array","prefixItems":[{"type":"string"}],"$dynamicRef":"#addons","$defs":{"defaultAddons":{"$comment":"Needed to satisfy the bookending requirement","$dynamicAnchor":"addons"}}}}}"##,
        #"["foo","bar","baz"]"#,
        false,
    );
}

test "unevaluatedItems can't see inside cousins: always fails" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"prefixItems":[true]},{"unevaluatedItems":false}]}"#,
        #"[1]"#,
        false,
    );
}

test "item is evaluated in an uncle schema to unevaluatedItems: no extra items" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"prefixItems":[{"type":"string"}],"unevaluatedItems":false}},"anyOf":[{"properties":{"foo":{"prefixItems":[true,{"type":"string"}]}}}]}"#,
        #"{"foo":["test"]}"#,
        true,
    );
}

test "item is evaluated in an uncle schema to unevaluatedItems: uncle keyword evaluation is not significant" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"prefixItems":[{"type":"string"}],"unevaluatedItems":false}},"anyOf":[{"properties":{"foo":{"prefixItems":[true,{"type":"string"}]}}}]}"#,
        #"{"foo":["test","test"]}"#,
        false,
    );
}

test "unevaluatedItems depends on adjacent contains: second item is evaluated by contains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[true],"contains":{"type":"string"},"unevaluatedItems":false}"#,
        #"[1,"foo"]"#,
        true,
    );
}

test "unevaluatedItems depends on adjacent contains: contains fails, second item is not evaluated" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[true],"contains":{"type":"string"},"unevaluatedItems":false}"#,
        #"[1,2]"#,
        false,
    );
}

test "unevaluatedItems depends on adjacent contains: contains passes, second item is not evaluated" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[true],"contains":{"type":"string"},"unevaluatedItems":false}"#,
        #"[1,2,"foo"]"#,
        false,
    );
}

test "unevaluatedItems depends on multiple nested contains: 5 not evaluated, passes unevaluatedItems" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"contains":{"multipleOf":2}},{"contains":{"multipleOf":3}}],"unevaluatedItems":{"multipleOf":5}}"#,
        #"[2,3,4,5,6]"#,
        true,
    );
}

test "unevaluatedItems depends on multiple nested contains: 7 not evaluated, fails unevaluatedItems" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"contains":{"multipleOf":2}},{"contains":{"multipleOf":3}}],"unevaluatedItems":{"multipleOf":5}}"#,
        #"[2,3,4,7,8]"#,
        false,
    );
}

test "unevaluatedItems and contains interact to control item dependency relationship: empty array is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"contains":{"const":"a"}},"then":{"if":{"contains":{"const":"b"}},"then":{"if":{"contains":{"const":"c"}}}},"unevaluatedItems":false}"#,
        #"[]"#,
        true,
    );
}

test "unevaluatedItems and contains interact to control item dependency relationship: only a's are valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"contains":{"const":"a"}},"then":{"if":{"contains":{"const":"b"}},"then":{"if":{"contains":{"const":"c"}}}},"unevaluatedItems":false}"#,
        #"["a","a"]"#,
        true,
    );
}

test "unevaluatedItems and contains interact to control item dependency relationship: a's and b's are valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"contains":{"const":"a"}},"then":{"if":{"contains":{"const":"b"}},"then":{"if":{"contains":{"const":"c"}}}},"unevaluatedItems":false}"#,
        #"["a","b","a","b","a"]"#,
        true,
    );
}

test "unevaluatedItems and contains interact to control item dependency relationship: a's, b's and c's are valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"contains":{"const":"a"}},"then":{"if":{"contains":{"const":"b"}},"then":{"if":{"contains":{"const":"c"}}}},"unevaluatedItems":false}"#,
        #"["c","a","c","c","b","a"]"#,
        true,
    );
}

test "unevaluatedItems and contains interact to control item dependency relationship: only b's are invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"contains":{"const":"a"}},"then":{"if":{"contains":{"const":"b"}},"then":{"if":{"contains":{"const":"c"}}}},"unevaluatedItems":false}"#,
        #"["b","b"]"#,
        false,
    );
}

test "unevaluatedItems and contains interact to control item dependency relationship: only c's are invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"contains":{"const":"a"}},"then":{"if":{"contains":{"const":"b"}},"then":{"if":{"contains":{"const":"c"}}}},"unevaluatedItems":false}"#,
        #"["c","c"]"#,
        false,
    );
}

test "unevaluatedItems and contains interact to control item dependency relationship: only b's and c's are invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"contains":{"const":"a"}},"then":{"if":{"contains":{"const":"b"}},"then":{"if":{"contains":{"const":"c"}}}},"unevaluatedItems":false}"#,
        #"["c","b","c","b","c"]"#,
        false,
    );
}

test "unevaluatedItems and contains interact to control item dependency relationship: only a's and c's are invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"contains":{"const":"a"}},"then":{"if":{"contains":{"const":"b"}},"then":{"if":{"contains":{"const":"c"}}}},"unevaluatedItems":false}"#,
        #"["c","a","c","a","c"]"#,
        false,
    );
}

test "unevaluatedItems with minContains = 0: empty array is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"type":"string"},"minContains":0,"unevaluatedItems":false}"#,
        #"[]"#,
        true,
    );
}

test "unevaluatedItems with minContains = 0: no items evaluated by contains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"type":"string"},"minContains":0,"unevaluatedItems":false}"#,
        #"[0]"#,
        false,
    );
}

test "unevaluatedItems with minContains = 0: some but not all items evaluated by contains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"type":"string"},"minContains":0,"unevaluatedItems":false}"#,
        #"["foo",0]"#,
        false,
    );
}

test "unevaluatedItems with minContains = 0: all items evaluated by contains" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","contains":{"type":"string"},"minContains":0,"unevaluatedItems":false}"#,
        #"["foo","bar"]"#,
        true,
    );
}

test "non-array instances are valid: ignores booleans" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedItems":false}"#,
        #"true"#,
        true,
    );
}

test "non-array instances are valid: ignores integers" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedItems":false}"#,
        #"123"#,
        true,
    );
}

test "non-array instances are valid: ignores floats" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedItems":false}"#,
        #"1"#,
        true,
    );
}

test "non-array instances are valid: ignores objects" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedItems":false}"#,
        #"{}"#,
        true,
    );
}

test "non-array instances are valid: ignores strings" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedItems":false}"#,
        #""foo""#,
        true,
    );
}

test "non-array instances are valid: ignores null" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedItems":false}"#,
        #"null"#,
        true,
    );
}

test "unevaluatedItems with null instance elements: allows null elements" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedItems":{"type":"null"}}"#,
        #"[null]"#,
        true,
    );
}

test "unevaluatedItems can see annotations from if without then and else: valid in case if is evaluated" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"prefixItems":[{"const":"a"}]},"unevaluatedItems":false}"#,
        #"["a"]"#,
        true,
    );
}

test "unevaluatedItems can see annotations from if without then and else: invalid in case if is evaluated" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"prefixItems":[{"const":"a"}]},"unevaluatedItems":false}"#,
        #"["b"]"#,
        false,
    );
}

test "Evaluated items collection needs to consider instance location: with an unevaluated item that exists at another location" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"prefixItems":[true,{"type":"string"}]}],"unevaluatedItems":false}"#,
        #"[["foo","bar"],"bar"]"#,
        false,
    );
}

// unevaluatedProperties.json

test "unevaluatedProperties true: with no unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedProperties":true}"#,
        #"{}"#,
        true,
    );
}

test "unevaluatedProperties true: with unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedProperties":true}"#,
        #"{"foo":"foo"}"#,
        true,
    );
}

test "unevaluatedProperties schema: with no unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedProperties":{"type":"string","minLength":3}}"#,
        #"{}"#,
        true,
    );
}

test "unevaluatedProperties schema: with valid unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedProperties":{"type":"string","minLength":3}}"#,
        #"{"foo":"foo"}"#,
        true,
    );
}

test "unevaluatedProperties schema: with invalid unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedProperties":{"type":"string","minLength":3}}"#,
        #"{"foo":"fo"}"#,
        false,
    );
}

test "unevaluatedProperties false: with no unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedProperties":false}"#,
        #"{}"#,
        true,
    );
}

test "unevaluatedProperties false: with unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedProperties":false}"#,
        #"{"foo":"foo"}"#,
        false,
    );
}

test "unevaluatedProperties with adjacent properties: with no unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"unevaluatedProperties":false}"#,
        #"{"foo":"foo"}"#,
        true,
    );
}

test "unevaluatedProperties with adjacent properties: with unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"unevaluatedProperties":false}"#,
        #"{"foo":"foo","bar":"bar"}"#,
        false,
    );
}

test "unevaluatedProperties with adjacent patternProperties: with no unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"^foo":{"type":"string"}},"unevaluatedProperties":false}"#,
        #"{"foo":"foo"}"#,
        true,
    );
}

test "unevaluatedProperties with adjacent patternProperties: with unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"^foo":{"type":"string"}},"unevaluatedProperties":false}"#,
        #"{"foo":"foo","bar":"bar"}"#,
        false,
    );
}

test "unevaluatedProperties with adjacent bool additionalProperties: with no additional properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"foo":{"type":"string"}},"additionalProperties":true,"unevaluatedProperties":false}"#,
        #"{"foo":"foo"}"#,
        true,
    );
}

test "unevaluatedProperties with adjacent bool additionalProperties: with additional properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"foo":{"type":"string"}},"additionalProperties":true,"unevaluatedProperties":false}"#,
        #"{"foo":"foo","bar":"bar"}"#,
        true,
    );
}

test "unevaluatedProperties with adjacent non-bool additionalProperties: with no additional properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"foo":{"type":"string"}},"additionalProperties":{"type":"string"},"unevaluatedProperties":false}"#,
        #"{"foo":"foo"}"#,
        true,
    );
}

test "unevaluatedProperties with adjacent non-bool additionalProperties: with additional properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"foo":{"type":"string"}},"additionalProperties":{"type":"string"},"unevaluatedProperties":false}"#,
        #"{"foo":"foo","bar":"bar"}"#,
        true,
    );
}

test "unevaluatedProperties with nested properties: with no additional properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"allOf":[{"properties":{"bar":{"type":"string"}}}],"unevaluatedProperties":false}"#,
        #"{"foo":"foo","bar":"bar"}"#,
        true,
    );
}

test "unevaluatedProperties with nested properties: with additional properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"allOf":[{"properties":{"bar":{"type":"string"}}}],"unevaluatedProperties":false}"#,
        #"{"foo":"foo","bar":"bar","baz":"baz"}"#,
        false,
    );
}

test "unevaluatedProperties with nested patternProperties: with no additional properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"allOf":[{"patternProperties":{"^bar":{"type":"string"}}}],"unevaluatedProperties":false}"#,
        #"{"foo":"foo","bar":"bar"}"#,
        true,
    );
}

test "unevaluatedProperties with nested patternProperties: with additional properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"allOf":[{"patternProperties":{"^bar":{"type":"string"}}}],"unevaluatedProperties":false}"#,
        #"{"foo":"foo","bar":"bar","baz":"baz"}"#,
        false,
    );
}

test "unevaluatedProperties with nested additionalProperties: with no additional properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"allOf":[{"additionalProperties":true}],"unevaluatedProperties":false}"#,
        #"{"foo":"foo"}"#,
        true,
    );
}

test "unevaluatedProperties with nested additionalProperties: with additional properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"allOf":[{"additionalProperties":true}],"unevaluatedProperties":false}"#,
        #"{"foo":"foo","bar":"bar"}"#,
        true,
    );
}

test "unevaluatedProperties with nested unevaluatedProperties: with no nested unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"allOf":[{"unevaluatedProperties":true}],"unevaluatedProperties":{"type":"string","maxLength":2}}"#,
        #"{"foo":"foo"}"#,
        true,
    );
}

test "unevaluatedProperties with nested unevaluatedProperties: with nested unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"allOf":[{"unevaluatedProperties":true}],"unevaluatedProperties":{"type":"string","maxLength":2}}"#,
        #"{"foo":"foo","bar":"bar"}"#,
        true,
    );
}

test "unevaluatedProperties with anyOf: when one matches and has no unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"anyOf":[{"properties":{"bar":{"const":"bar"}},"required":["bar"]},{"properties":{"baz":{"const":"baz"}},"required":["baz"]},{"properties":{"quux":{"const":"quux"}},"required":["quux"]}],"unevaluatedProperties":false}"#,
        #"{"foo":"foo","bar":"bar"}"#,
        true,
    );
}

test "unevaluatedProperties with anyOf: when one matches and has unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"anyOf":[{"properties":{"bar":{"const":"bar"}},"required":["bar"]},{"properties":{"baz":{"const":"baz"}},"required":["baz"]},{"properties":{"quux":{"const":"quux"}},"required":["quux"]}],"unevaluatedProperties":false}"#,
        #"{"foo":"foo","bar":"bar","baz":"not-baz"}"#,
        false,
    );
}

test "unevaluatedProperties with anyOf: when two match and has no unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"anyOf":[{"properties":{"bar":{"const":"bar"}},"required":["bar"]},{"properties":{"baz":{"const":"baz"}},"required":["baz"]},{"properties":{"quux":{"const":"quux"}},"required":["quux"]}],"unevaluatedProperties":false}"#,
        #"{"foo":"foo","bar":"bar","baz":"baz"}"#,
        true,
    );
}

test "unevaluatedProperties with anyOf: when two match and has unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"anyOf":[{"properties":{"bar":{"const":"bar"}},"required":["bar"]},{"properties":{"baz":{"const":"baz"}},"required":["baz"]},{"properties":{"quux":{"const":"quux"}},"required":["quux"]}],"unevaluatedProperties":false}"#,
        #"{"foo":"foo","bar":"bar","baz":"baz","quux":"not-quux"}"#,
        false,
    );
}

test "unevaluatedProperties with oneOf: with no unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"oneOf":[{"properties":{"bar":{"const":"bar"}},"required":["bar"]},{"properties":{"baz":{"const":"baz"}},"required":["baz"]}],"unevaluatedProperties":false}"#,
        #"{"foo":"foo","bar":"bar"}"#,
        true,
    );
}

test "unevaluatedProperties with oneOf: with unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"oneOf":[{"properties":{"bar":{"const":"bar"}},"required":["bar"]},{"properties":{"baz":{"const":"baz"}},"required":["baz"]}],"unevaluatedProperties":false}"#,
        #"{"foo":"foo","bar":"bar","quux":"quux"}"#,
        false,
    );
}

test "unevaluatedProperties with not: with unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"not":{"not":{"properties":{"bar":{"const":"bar"}},"required":["bar"]}},"unevaluatedProperties":false}"#,
        #"{"foo":"foo","bar":"bar"}"#,
        false,
    );
}

test "unevaluatedProperties with if/then/else: when if is true and has no unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"properties":{"foo":{"const":"then"}},"required":["foo"]},"then":{"properties":{"bar":{"type":"string"}},"required":["bar"]},"else":{"properties":{"baz":{"type":"string"}},"required":["baz"]},"unevaluatedProperties":false}"#,
        #"{"foo":"then","bar":"bar"}"#,
        true,
    );
}

test "unevaluatedProperties with if/then/else: when if is true and has unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"properties":{"foo":{"const":"then"}},"required":["foo"]},"then":{"properties":{"bar":{"type":"string"}},"required":["bar"]},"else":{"properties":{"baz":{"type":"string"}},"required":["baz"]},"unevaluatedProperties":false}"#,
        #"{"foo":"then","bar":"bar","baz":"baz"}"#,
        false,
    );
}

test "unevaluatedProperties with if/then/else: when if is false and has no unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"properties":{"foo":{"const":"then"}},"required":["foo"]},"then":{"properties":{"bar":{"type":"string"}},"required":["bar"]},"else":{"properties":{"baz":{"type":"string"}},"required":["baz"]},"unevaluatedProperties":false}"#,
        #"{"baz":"baz"}"#,
        true,
    );
}

test "unevaluatedProperties with if/then/else: when if is false and has unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"properties":{"foo":{"const":"then"}},"required":["foo"]},"then":{"properties":{"bar":{"type":"string"}},"required":["bar"]},"else":{"properties":{"baz":{"type":"string"}},"required":["baz"]},"unevaluatedProperties":false}"#,
        #"{"foo":"else","baz":"baz"}"#,
        false,
    );
}

test "unevaluatedProperties with if/then/else, then not defined: when if is true and has no unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"properties":{"foo":{"const":"then"}},"required":["foo"]},"else":{"properties":{"baz":{"type":"string"}},"required":["baz"]},"unevaluatedProperties":false}"#,
        #"{"foo":"then"}"#,
        true,
    );
}

test "unevaluatedProperties with if/then/else, then not defined: when if is true and has unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"properties":{"foo":{"const":"then"}},"required":["foo"]},"else":{"properties":{"baz":{"type":"string"}},"required":["baz"]},"unevaluatedProperties":false}"#,
        #"{"foo":"then","bar":"bar"}"#,
        false,
    );
}

test "unevaluatedProperties with if/then/else, then not defined: when if is false and has no unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"properties":{"foo":{"const":"then"}},"required":["foo"]},"else":{"properties":{"baz":{"type":"string"}},"required":["baz"]},"unevaluatedProperties":false}"#,
        #"{"baz":"baz"}"#,
        true,
    );
}

test "unevaluatedProperties with if/then/else, then not defined: when if is false and has unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"properties":{"foo":{"const":"then"}},"required":["foo"]},"else":{"properties":{"baz":{"type":"string"}},"required":["baz"]},"unevaluatedProperties":false}"#,
        #"{"foo":"else","baz":"baz"}"#,
        false,
    );
}

test "unevaluatedProperties with if/then/else, else not defined: when if is true and has no unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"properties":{"foo":{"const":"then"}},"required":["foo"]},"then":{"properties":{"bar":{"type":"string"}},"required":["bar"]},"unevaluatedProperties":false}"#,
        #"{"foo":"then","bar":"bar"}"#,
        true,
    );
}

test "unevaluatedProperties with if/then/else, else not defined: when if is true and has unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"properties":{"foo":{"const":"then"}},"required":["foo"]},"then":{"properties":{"bar":{"type":"string"}},"required":["bar"]},"unevaluatedProperties":false}"#,
        #"{"foo":"then","bar":"bar","baz":"baz"}"#,
        false,
    );
}

test "unevaluatedProperties with if/then/else, else not defined: when if is false and has no unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"properties":{"foo":{"const":"then"}},"required":["foo"]},"then":{"properties":{"bar":{"type":"string"}},"required":["bar"]},"unevaluatedProperties":false}"#,
        #"{"baz":"baz"}"#,
        false,
    );
}

test "unevaluatedProperties with if/then/else, else not defined: when if is false and has unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"properties":{"foo":{"const":"then"}},"required":["foo"]},"then":{"properties":{"bar":{"type":"string"}},"required":["bar"]},"unevaluatedProperties":false}"#,
        #"{"foo":"else","baz":"baz"}"#,
        false,
    );
}

test "unevaluatedProperties with dependentSchemas: with no unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"dependentSchemas":{"foo":{"properties":{"bar":{"const":"bar"}},"required":["bar"]}},"unevaluatedProperties":false}"#,
        #"{"foo":"foo","bar":"bar"}"#,
        true,
    );
}

test "unevaluatedProperties with dependentSchemas: with unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"dependentSchemas":{"foo":{"properties":{"bar":{"const":"bar"}},"required":["bar"]}},"unevaluatedProperties":false}"#,
        #"{"bar":"bar"}"#,
        false,
    );
}

test "unevaluatedProperties with boolean schemas: with no unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"allOf":[true],"unevaluatedProperties":false}"#,
        #"{"foo":"foo"}"#,
        true,
    );
}

test "unevaluatedProperties with boolean schemas: with unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"allOf":[true],"unevaluatedProperties":false}"#,
        #"{"bar":"bar"}"#,
        false,
    );
}

test "unevaluatedProperties with $ref: with no unevaluated properties" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$ref":"#/$defs/bar","properties":{"foo":{"type":"string"}},"unevaluatedProperties":false,"$defs":{"bar":{"properties":{"bar":{"type":"string"}}}}}"##,
        #"{"foo":"foo","bar":"bar"}"#,
        true,
    );
}

test "unevaluatedProperties with $ref: with unevaluated properties" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$ref":"#/$defs/bar","properties":{"foo":{"type":"string"}},"unevaluatedProperties":false,"$defs":{"bar":{"properties":{"bar":{"type":"string"}}}}}"##,
        #"{"foo":"foo","bar":"bar","baz":"baz"}"#,
        false,
    );
}

test "unevaluatedProperties before $ref: with no unevaluated properties" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedProperties":false,"properties":{"foo":{"type":"string"}},"$ref":"#/$defs/bar","$defs":{"bar":{"properties":{"bar":{"type":"string"}}}}}"##,
        #"{"foo":"foo","bar":"bar"}"#,
        true,
    );
}

test "unevaluatedProperties before $ref: with unevaluated properties" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedProperties":false,"properties":{"foo":{"type":"string"}},"$ref":"#/$defs/bar","$defs":{"bar":{"properties":{"bar":{"type":"string"}}}}}"##,
        #"{"foo":"foo","bar":"bar","baz":"baz"}"#,
        false,
    );
}

test "unevaluatedProperties with $dynamicRef: with no unevaluated properties" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://example.com/unevaluated-properties-with-dynamic-ref/derived","$ref":"./baseSchema","$defs":{"derived":{"$dynamicAnchor":"addons","properties":{"bar":{"type":"string"}}},"baseSchema":{"$id":"./baseSchema","$comment":"unevaluatedProperties comes first so it's more likely to catch bugs with implementations that are sensitive to keyword ordering","unevaluatedProperties":false,"properties":{"foo":{"type":"string"}},"$dynamicRef":"#addons","$defs":{"defaultAddons":{"$comment":"Needed to satisfy the bookending requirement","$dynamicAnchor":"addons"}}}}}"##,
        #"{"foo":"foo","bar":"bar"}"#,
        true,
    );
}

test "unevaluatedProperties with $dynamicRef: with unevaluated properties" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://example.com/unevaluated-properties-with-dynamic-ref/derived","$ref":"./baseSchema","$defs":{"derived":{"$dynamicAnchor":"addons","properties":{"bar":{"type":"string"}}},"baseSchema":{"$id":"./baseSchema","$comment":"unevaluatedProperties comes first so it's more likely to catch bugs with implementations that are sensitive to keyword ordering","unevaluatedProperties":false,"properties":{"foo":{"type":"string"}},"$dynamicRef":"#addons","$defs":{"defaultAddons":{"$comment":"Needed to satisfy the bookending requirement","$dynamicAnchor":"addons"}}}}}"##,
        #"{"foo":"foo","bar":"bar","baz":"baz"}"#,
        false,
    );
}

test "unevaluatedProperties can't see inside cousins: always fails" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"properties":{"foo":true}},{"unevaluatedProperties":false}]}"#,
        #"{"foo":1}"#,
        false,
    );
}

test "unevaluatedProperties can't see inside cousins (reverse order): always fails" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"unevaluatedProperties":false},{"properties":{"foo":true}}]}"#,
        #"{"foo":1}"#,
        false,
    );
}

test "nested unevaluatedProperties, outer false, inner true, properties outside: with no nested unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"allOf":[{"unevaluatedProperties":true}],"unevaluatedProperties":false}"#,
        #"{"foo":"foo"}"#,
        true,
    );
}

test "nested unevaluatedProperties, outer false, inner true, properties outside: with nested unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"allOf":[{"unevaluatedProperties":true}],"unevaluatedProperties":false}"#,
        #"{"foo":"foo","bar":"bar"}"#,
        true,
    );
}

test "nested unevaluatedProperties, outer false, inner true, properties inside: with no nested unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"properties":{"foo":{"type":"string"}},"unevaluatedProperties":true}],"unevaluatedProperties":false}"#,
        #"{"foo":"foo"}"#,
        true,
    );
}

test "nested unevaluatedProperties, outer false, inner true, properties inside: with nested unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"properties":{"foo":{"type":"string"}},"unevaluatedProperties":true}],"unevaluatedProperties":false}"#,
        #"{"foo":"foo","bar":"bar"}"#,
        true,
    );
}

test "nested unevaluatedProperties, outer true, inner false, properties outside: with no nested unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"allOf":[{"unevaluatedProperties":false}],"unevaluatedProperties":true}"#,
        #"{"foo":"foo"}"#,
        false,
    );
}

test "nested unevaluatedProperties, outer true, inner false, properties outside: with nested unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"string"}},"allOf":[{"unevaluatedProperties":false}],"unevaluatedProperties":true}"#,
        #"{"foo":"foo","bar":"bar"}"#,
        false,
    );
}

test "nested unevaluatedProperties, outer true, inner false, properties inside: with no nested unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"properties":{"foo":{"type":"string"}},"unevaluatedProperties":false}],"unevaluatedProperties":true}"#,
        #"{"foo":"foo"}"#,
        true,
    );
}

test "nested unevaluatedProperties, outer true, inner false, properties inside: with nested unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"properties":{"foo":{"type":"string"}},"unevaluatedProperties":false}],"unevaluatedProperties":true}"#,
        #"{"foo":"foo","bar":"bar"}"#,
        false,
    );
}

test "cousin unevaluatedProperties, true and false, true with properties: with no nested unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"properties":{"foo":{"type":"string"}},"unevaluatedProperties":true},{"unevaluatedProperties":false}]}"#,
        #"{"foo":"foo"}"#,
        false,
    );
}

test "cousin unevaluatedProperties, true and false, true with properties: with nested unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"properties":{"foo":{"type":"string"}},"unevaluatedProperties":true},{"unevaluatedProperties":false}]}"#,
        #"{"foo":"foo","bar":"bar"}"#,
        false,
    );
}

test "cousin unevaluatedProperties, true and false, false with properties: with no nested unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"unevaluatedProperties":true},{"properties":{"foo":{"type":"string"}},"unevaluatedProperties":false}]}"#,
        #"{"foo":"foo"}"#,
        true,
    );
}

test "cousin unevaluatedProperties, true and false, false with properties: with nested unevaluated properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"unevaluatedProperties":true},{"properties":{"foo":{"type":"string"}},"unevaluatedProperties":false}]}"#,
        #"{"foo":"foo","bar":"bar"}"#,
        false,
    );
}

test "property is evaluated in an uncle schema to unevaluatedProperties: no extra properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"properties":{"bar":{"type":"string"}},"unevaluatedProperties":false}},"anyOf":[{"properties":{"foo":{"properties":{"faz":{"type":"string"}}}}}]}"#,
        #"{"foo":{"bar":"test"}}"#,
        true,
    );
}

test "property is evaluated in an uncle schema to unevaluatedProperties: uncle keyword evaluation is not significant" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"properties":{"bar":{"type":"string"}},"unevaluatedProperties":false}},"anyOf":[{"properties":{"foo":{"properties":{"faz":{"type":"string"}}}}}]}"#,
        #"{"foo":{"bar":"test","faz":"test"}}"#,
        false,
    );
}

test "in-place applicator siblings, allOf has unevaluated: base case: both properties present" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"properties":{"foo":true},"unevaluatedProperties":false}],"anyOf":[{"properties":{"bar":true}}]}"#,
        #"{"foo":1,"bar":1}"#,
        false,
    );
}

test "in-place applicator siblings, allOf has unevaluated: in place applicator siblings, bar is missing" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"properties":{"foo":true},"unevaluatedProperties":false}],"anyOf":[{"properties":{"bar":true}}]}"#,
        #"{"foo":1}"#,
        true,
    );
}

test "in-place applicator siblings, allOf has unevaluated: in place applicator siblings, foo is missing" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"properties":{"foo":true},"unevaluatedProperties":false}],"anyOf":[{"properties":{"bar":true}}]}"#,
        #"{"bar":1}"#,
        false,
    );
}

test "in-place applicator siblings, anyOf has unevaluated: base case: both properties present" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"properties":{"foo":true}}],"anyOf":[{"properties":{"bar":true},"unevaluatedProperties":false}]}"#,
        #"{"foo":1,"bar":1}"#,
        false,
    );
}

test "in-place applicator siblings, anyOf has unevaluated: in place applicator siblings, bar is missing" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"properties":{"foo":true}}],"anyOf":[{"properties":{"bar":true},"unevaluatedProperties":false}]}"#,
        #"{"foo":1}"#,
        false,
    );
}

test "in-place applicator siblings, anyOf has unevaluated: in place applicator siblings, foo is missing" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"properties":{"foo":true}}],"anyOf":[{"properties":{"bar":true},"unevaluatedProperties":false}]}"#,
        #"{"bar":1}"#,
        true,
    );
}

test "unevaluatedProperties + single cyclic ref: Empty is valid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"x":{"$ref":"#"}},"unevaluatedProperties":false}"##,
        #"{}"#,
        true,
    );
}

test "unevaluatedProperties + single cyclic ref: Single is valid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"x":{"$ref":"#"}},"unevaluatedProperties":false}"##,
        #"{"x":{}}"#,
        true,
    );
}

test "unevaluatedProperties + single cyclic ref: Unevaluated on 1st level is invalid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"x":{"$ref":"#"}},"unevaluatedProperties":false}"##,
        #"{"x":{},"y":{}}"#,
        false,
    );
}

test "unevaluatedProperties + single cyclic ref: Nested is valid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"x":{"$ref":"#"}},"unevaluatedProperties":false}"##,
        #"{"x":{"x":{}}}"#,
        true,
    );
}

test "unevaluatedProperties + single cyclic ref: Unevaluated on 2nd level is invalid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"x":{"$ref":"#"}},"unevaluatedProperties":false}"##,
        #"{"x":{"x":{},"y":{}}}"#,
        false,
    );
}

test "unevaluatedProperties + single cyclic ref: Deep nested is valid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"x":{"$ref":"#"}},"unevaluatedProperties":false}"##,
        #"{"x":{"x":{"x":{}}}}"#,
        true,
    );
}

test "unevaluatedProperties + single cyclic ref: Unevaluated on 3rd level is invalid" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"x":{"$ref":"#"}},"unevaluatedProperties":false}"##,
        #"{"x":{"x":{"x":{},"y":{}}}}"#,
        false,
    );
}

test "unevaluatedProperties + ref inside allOf / oneOf: Empty is invalid (no x or y)" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"one":{"properties":{"a":true}},"two":{"required":["x"],"properties":{"x":true}}},"allOf":[{"$ref":"#/$defs/one"},{"properties":{"b":true}},{"oneOf":[{"$ref":"#/$defs/two"},{"required":["y"],"properties":{"y":true}}]}],"unevaluatedProperties":false}"##,
        #"{}"#,
        false,
    );
}

test "unevaluatedProperties + ref inside allOf / oneOf: a and b are invalid (no x or y)" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"one":{"properties":{"a":true}},"two":{"required":["x"],"properties":{"x":true}}},"allOf":[{"$ref":"#/$defs/one"},{"properties":{"b":true}},{"oneOf":[{"$ref":"#/$defs/two"},{"required":["y"],"properties":{"y":true}}]}],"unevaluatedProperties":false}"##,
        #"{"a":1,"b":1}"#,
        false,
    );
}

