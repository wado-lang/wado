test "$ref to $dynamicRef finds detached $dynamicAnchor: number is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","$ref":"http://localhost:1234/draft2020-12/detached-dynamicref.json#/$defs/foo"}"#,
        #"1"#,
        true,
        &REMOTES,
    );
}

test "$ref to $dynamicRef finds detached $dynamicAnchor: non-number is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","$ref":"http://localhost:1234/draft2020-12/detached-dynamicref.json#/$defs/foo"}"#,
        #""a""#,
        false,
        &REMOTES,
    );
}

test "$dynamicRef points to a boolean schema: follow $dynamicRef to a true schema" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"true":true,"false":false},"properties":{"true":{"$dynamicRef":"#/$defs/true"},"false":{"$dynamicRef":"#/$defs/false"}}}"##,
        #"{"true":1}"#,
        true,
    );
}

test "$dynamicRef points to a boolean schema: follow $dynamicRef to a false schema" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"true":true,"false":false},"properties":{"true":{"$dynamicRef":"#/$defs/true"},"false":{"$dynamicRef":"#/$defs/false"}}}"##,
        #"{"false":1}"#,
        false,
    );
}

test "$dynamicRef skips over intermediate resources - direct reference: integer property passes" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamic-ref-skips-intermediate-resource/main","type":"object","properties":{"bar-item":{"$ref":"item"}},"$defs":{"bar":{"$id":"bar","type":"array","items":{"$ref":"item"},"$defs":{"item":{"$id":"item","type":"object","properties":{"content":{"$dynamicRef":"#content"}},"$defs":{"defaultContent":{"$dynamicAnchor":"content","type":"integer"}}},"content":{"$dynamicAnchor":"content","type":"string"}}}}}"##,
        #"{"bar-item":{"content":42}}"#,
        true,
    );
}

test "$dynamicRef skips over intermediate resources - direct reference: string property fails" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamic-ref-skips-intermediate-resource/main","type":"object","properties":{"bar-item":{"$ref":"item"}},"$defs":{"bar":{"$id":"bar","type":"array","items":{"$ref":"item"},"$defs":{"item":{"$id":"item","type":"object","properties":{"content":{"$dynamicRef":"#content"}},"$defs":{"defaultContent":{"$dynamicAnchor":"content","type":"integer"}}},"content":{"$dynamicAnchor":"content","type":"string"}}}}}"##,
        #"{"bar-item":{"content":"value"}}"#,
        false,
    );
}

test "$dynamicRef avoids the root of each schema, but scopes are still registered: data is sufficient for schema at second#/$defs/length" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamic-ref-avoids-root-of-each-schema/base","$ref":"first#/$defs/stuff","$defs":{"first":{"$id":"first","$defs":{"stuff":{"$ref":"second#/$defs/stuff"},"length":{"$comment":"unused, because there is no $dynamicAnchor here","maxLength":1}}},"second":{"$id":"second","$defs":{"stuff":{"$ref":"third#/$defs/stuff"},"length":{"$dynamicAnchor":"length","maxLength":2}}},"third":{"$id":"third","$defs":{"stuff":{"$dynamicRef":"#length"},"length":{"$dynamicAnchor":"length","maxLength":3}}}}}"##,
        #""hi""#,
        true,
    );
}

test "$dynamicRef avoids the root of each schema, but scopes are still registered: data is not sufficient for schema at second#/$defs/length" {
    check(
        ##"{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://test.json-schema.org/dynamic-ref-avoids-root-of-each-schema/base","$ref":"first#/$defs/stuff","$defs":{"first":{"$id":"first","$defs":{"stuff":{"$ref":"second#/$defs/stuff"},"length":{"$comment":"unused, because there is no $dynamicAnchor here","maxLength":1}}},"second":{"$id":"second","$defs":{"stuff":{"$ref":"third#/$defs/stuff"},"length":{"$dynamicAnchor":"length","maxLength":2}}},"third":{"$id":"third","$defs":{"stuff":{"$dynamicRef":"#length"},"length":{"$dynamicAnchor":"length","maxLength":3}}}}}"##,
        #""hey""#,
        false,
    );
}

// enum.json

test "simple enum validation: one of the enum is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[1,2,3]}"#,
        #"1"#,
        true,
    );
}

test "simple enum validation: something else is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[1,2,3]}"#,
        #"4"#,
        false,
    );
}

test "heterogeneous enum validation: one of the enum is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[6,"foo",[],true,{"foo":12}]}"#,
        #"[]"#,
        true,
    );
}

test "heterogeneous enum validation: something else is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[6,"foo",[],true,{"foo":12}]}"#,
        #"null"#,
        false,
    );
}

test "heterogeneous enum validation: objects are deep compared" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[6,"foo",[],true,{"foo":12}]}"#,
        #"{"foo":false}"#,
        false,
    );
}

test "heterogeneous enum validation: valid object matches" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[6,"foo",[],true,{"foo":12}]}"#,
        #"{"foo":12}"#,
        true,
    );
}

test "heterogeneous enum validation: extra properties in object is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[6,"foo",[],true,{"foo":12}]}"#,
        #"{"foo":12,"boo":42}"#,
        false,
    );
}

test "heterogeneous enum-with-null validation: null is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[6,null]}"#,
        #"null"#,
        true,
    );
}

test "heterogeneous enum-with-null validation: number is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[6,null]}"#,
        #"6"#,
        true,
    );
}

test "heterogeneous enum-with-null validation: something else is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[6,null]}"#,
        #""test""#,
        false,
    );
}

test "enums in properties: both properties are valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"foo":{"enum":["foo"]},"bar":{"enum":["bar"]}},"required":["bar"]}"#,
        #"{"foo":"foo","bar":"bar"}"#,
        true,
    );
}

test "enums in properties: wrong foo value" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"foo":{"enum":["foo"]},"bar":{"enum":["bar"]}},"required":["bar"]}"#,
        #"{"foo":"foot","bar":"bar"}"#,
        false,
    );
}

test "enums in properties: wrong bar value" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"foo":{"enum":["foo"]},"bar":{"enum":["bar"]}},"required":["bar"]}"#,
        #"{"foo":"foo","bar":"bart"}"#,
        false,
    );
}

test "enums in properties: missing optional property is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"foo":{"enum":["foo"]},"bar":{"enum":["bar"]}},"required":["bar"]}"#,
        #"{"bar":"bar"}"#,
        true,
    );
}

test "enums in properties: missing required property is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"foo":{"enum":["foo"]},"bar":{"enum":["bar"]}},"required":["bar"]}"#,
        #"{"foo":"foo"}"#,
        false,
    );
}

test "enums in properties: missing all properties is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"foo":{"enum":["foo"]},"bar":{"enum":["bar"]}},"required":["bar"]}"#,
        #"{}"#,
        false,
    );
}

test "enum with escaped characters: member 1 is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":["foo\nbar","foo\rbar"]}"#,
        #""foo\nbar""#,
        true,
    );
}

test "enum with escaped characters: member 2 is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":["foo\nbar","foo\rbar"]}"#,
        #""foo\rbar""#,
        true,
    );
}

test "enum with escaped characters: another string is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":["foo\nbar","foo\rbar"]}"#,
        #""abc""#,
        false,
    );
}

test "enum with false does not match 0: false is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[false]}"#,
        #"false"#,
        true,
    );
}

