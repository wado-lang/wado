    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[true]}"#,
        #"1"#,
        false,
    );
}

test "enum with [true] does not match [1]: [true] is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[[true]]}"#,
        #"[true]"#,
        true,
    );
}

test "enum with [true] does not match [1]: [1] is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[[true]]}"#,
        #"[1]"#,
        false,
    );
}

test "enum with [true] does not match [1]: [1.0] is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","enum":[[true]]}"#,
        #"[1]"#,
        false,
