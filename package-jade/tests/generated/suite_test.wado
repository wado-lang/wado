test "non-object instances are valid: ignores booleans" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedProperties":false}"#,
        #"true"#,
        true,
    );
}

test "non-object instances are valid: ignores integers" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedProperties":false}"#,
        #"123"#,
        true,
    );
}

test "non-object instances are valid: ignores floats" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedProperties":false}"#,
        #"1"#,
        true,
    );
}

test "non-object instances are valid: ignores arrays" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedProperties":false}"#,
        #"[]"#,
        true,
    );
}

test "non-object instances are valid: ignores strings" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedProperties":false}"#,
        #""foo""#,
        true,
    );
}

test "non-object instances are valid: ignores null" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedProperties":false}"#,
        #"null"#,
        true,
    );
}

test "unevaluatedProperties with null valued instance properties: allows null valued properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","unevaluatedProperties":{"type":"null"}}"#,
        #"{"foo":null}"#,
        true,
    );
}

test "unevaluatedProperties not affected by propertyNames: allows only number properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":{"maxLength":1},"unevaluatedProperties":{"type":"number"}}"#,
        #"{"a":1}"#,
        true,
    );
}

test "unevaluatedProperties not affected by propertyNames: string property is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":{"maxLength":1},"unevaluatedProperties":{"type":"number"}}"#,
        #"{"a":"b"}"#,
        false,
    );
}

test "unevaluatedProperties can see annotations from if without then and else: valid in case if is evaluated" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"patternProperties":{"foo":{"type":"string"}}},"unevaluatedProperties":false}"#,
        #"{"foo":"a"}"#,
        true,
    );
}

test "unevaluatedProperties can see annotations from if without then and else: invalid in case if is evaluated" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","if":{"patternProperties":{"foo":{"type":"string"}}},"unevaluatedProperties":false}"#,
        #"{"bar":"a"}"#,
        false,
    );
}

test "dependentSchemas with unevaluatedProperties: unevaluatedProperties doesn't consider dependentSchemas" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo2":{}},"dependentSchemas":{"foo":{},"foo2":{"properties":{"bar":{}}}},"unevaluatedProperties":false}"#,
        #"{"foo":""}"#,
        false,
    );
}

test "dependentSchemas with unevaluatedProperties: unevaluatedProperties doesn't see bar when foo2 is absent" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo2":{}},"dependentSchemas":{"foo":{},"foo2":{"properties":{"bar":{}}}},"unevaluatedProperties":false}"#,
        #"{"bar":""}"#,
        false,
    );
}

test "dependentSchemas with unevaluatedProperties: unevaluatedProperties sees bar when foo2 is present" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo2":{}},"dependentSchemas":{"foo":{},"foo2":{"properties":{"bar":{}}}},"unevaluatedProperties":false}"#,
        #"{"foo2":"","bar":""}"#,
        true,
    );
}

test "Evaluated properties collection needs to consider instance location: with an unevaluated property that exists at another location" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"properties":{"bar":{"type":"string"}}}},"unevaluatedProperties":false}"#,
        #"{"foo":{"bar":"foo"},"bar":"bar"}"#,
        false,
    );
}

test "Evaluated properties collection needs to consider instance location with patternProperties: with only the nested evaluated property" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"patternProperties":{"^bar$":{"type":"string"}}}},"unevaluatedProperties":false}"#,
        #"{"foo":{"bar":"foo"}}"#,
        true,
    );
}

test "Evaluated properties collection needs to consider instance location with patternProperties: with an unevaluated property that exists at another location" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"patternProperties":{"^bar$":{"type":"string"}}}},"unevaluatedProperties":false}"#,
        #"{"foo":{"bar":"foo"},"bar":"bar"}"#,
        false,
    );
}

test "Evaluated properties collection needs to consider instance location with additionalProperties: with only the nested evaluated property" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"additionalProperties":{"type":"string"}}},"unevaluatedProperties":false}"#,
        #"{"foo":{"bar":"foo"}}"#,
        true,
    );
}

test "Evaluated properties collection needs to consider instance location with additionalProperties: with an unevaluated property that exists at another location" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"additionalProperties":{"type":"string"}}},"unevaluatedProperties":false}"#,
        #"{"foo":{"bar":"foo"},"bar":"bar"}"#,
        false,
    );
}

// uniqueItems.json

test "uniqueItems validation: unique array of integers is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[1,2]"#,
        true,
    );
}

test "uniqueItems validation: non-unique array of integers is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[1,1]"#,
        false,
    );
}

test "uniqueItems validation: non-unique array of more than two integers is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[1,2,1]"#,
        false,
    );
}

test "uniqueItems validation: numbers are unique if mathematically unequal" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[1,1,1]"#,
        false,
    );
}

test "uniqueItems validation: false is not equal to zero" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[0,false]"#,
        true,
    );
}

test "uniqueItems validation: true is not equal to one" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[1,true]"#,
        true,
    );
}

test "uniqueItems validation: unique array of strings is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"["foo","bar","baz"]"#,
        true,
    );
}

test "uniqueItems validation: non-unique array of strings is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"["foo","bar","foo"]"#,
        false,
    );
}

test "uniqueItems validation: unique array of objects is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[{"foo":"bar"},{"foo":"baz"}]"#,
        true,
    );
}

test "uniqueItems validation: non-unique array of objects is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[{"foo":"bar"},{"foo":"bar"}]"#,
        false,
    );
}

test "uniqueItems validation: property order of array of objects is ignored" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[{"foo":"bar","bar":"foo"},{"bar":"foo","foo":"bar"}]"#,
        false,
    );
}

test "uniqueItems validation: unique array of nested objects is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[{"foo":{"bar":{"baz":true}}},{"foo":{"bar":{"baz":false}}}]"#,
        true,
    );
}

test "uniqueItems validation: non-unique array of nested objects is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[{"foo":{"bar":{"baz":true}}},{"foo":{"bar":{"baz":true}}}]"#,
        false,
    );
}

test "uniqueItems validation: unique array of arrays is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[["foo"],["bar"]]"#,
        true,
    );
}

test "uniqueItems validation: non-unique array of arrays is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[["foo"],["foo"]]"#,
        false,
    );
}

test "uniqueItems validation: non-unique array of more than two arrays is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[["foo"],["bar"],["foo"]]"#,
        false,
    );
}

test "uniqueItems validation: [1] and [true] are unique" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[[1],[true]]"#,
        true,
    );
}

test "uniqueItems validation: [0] and [false] are unique" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[[0],[false]]"#,
        true,
    );
}

test "uniqueItems validation: nested [1] and [true] are unique" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[[[1],"foo"],[[true],"foo"]]"#,
        true,
    );
}

test "uniqueItems validation: nested [0] and [false] are unique" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[[[0],"foo"],[[false],"foo"]]"#,
        true,
    );
}

test "uniqueItems validation: unique heterogeneous types are valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[{},[1],true,null,1,"{}"]"#,
        true,
    );
}

test "uniqueItems validation: non-unique heterogeneous types are invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[{},[1],true,null,{},1]"#,
        false,
    );
}

test "uniqueItems validation: different objects are unique" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[{"a":1,"b":2},{"a":2,"b":1}]"#,
        true,
    );
}

test "uniqueItems validation: objects are non-unique despite key order" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[{"a":1,"b":2},{"b":2,"a":1}]"#,
        false,
    );
}

test "uniqueItems validation: {\"a\": false} and {\"a\": 0} are unique" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[{"a":false},{"a":0}]"#,
        true,
    );
}

test "uniqueItems validation: {\"a\": true} and {\"a\": 1} are unique" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":true}"#,
        #"[{"a":true},{"a":1}]"#,
        true,
    );
}

test "uniqueItems with an array of items: [false, true] from items array is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"boolean"},{"type":"boolean"}],"uniqueItems":true}"#,
        #"[false,true]"#,
        true,
    );
}

test "uniqueItems with an array of items: [true, false] from items array is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"boolean"},{"type":"boolean"}],"uniqueItems":true}"#,
        #"[true,false]"#,
        true,
    );
}

test "uniqueItems with an array of items: [false, false] from items array is not valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"boolean"},{"type":"boolean"}],"uniqueItems":true}"#,
        #"[false,false]"#,
        false,
    );
}

test "uniqueItems with an array of items: [true, true] from items array is not valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"boolean"},{"type":"boolean"}],"uniqueItems":true}"#,
        #"[true,true]"#,
        false,
    );
}

test "uniqueItems with an array of items: unique array extended from [false, true] is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"boolean"},{"type":"boolean"}],"uniqueItems":true}"#,
        #"[false,true,"foo","bar"]"#,
        true,
    );
}

test "uniqueItems with an array of items: unique array extended from [true, false] is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"boolean"},{"type":"boolean"}],"uniqueItems":true}"#,
        #"[true,false,"foo","bar"]"#,
        true,
    );
}

test "uniqueItems with an array of items: non-unique array extended from [false, true] is not valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"boolean"},{"type":"boolean"}],"uniqueItems":true}"#,
        #"[false,true,"foo","foo"]"#,
        false,
    );
}

test "uniqueItems with an array of items: non-unique array extended from [true, false] is not valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"boolean"},{"type":"boolean"}],"uniqueItems":true}"#,
        #"[true,false,"foo","foo"]"#,
        false,
    );
}

test "uniqueItems with an array of items and additionalItems=false: [false, true] from items array is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"boolean"},{"type":"boolean"}],"uniqueItems":true,"items":false}"#,
        #"[false,true]"#,
        true,
    );
}

test "uniqueItems with an array of items and additionalItems=false: [true, false] from items array is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"boolean"},{"type":"boolean"}],"uniqueItems":true,"items":false}"#,
        #"[true,false]"#,
        true,
    );
}

test "uniqueItems with an array of items and additionalItems=false: [false, false] from items array is not valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"boolean"},{"type":"boolean"}],"uniqueItems":true,"items":false}"#,
        #"[false,false]"#,
        false,
    );
}

test "uniqueItems with an array of items and additionalItems=false: [true, true] from items array is not valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"boolean"},{"type":"boolean"}],"uniqueItems":true,"items":false}"#,
        #"[true,true]"#,
        false,
    );
}

test "uniqueItems with an array of items and additionalItems=false: extra items are invalid even if unique" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","prefixItems":[{"type":"boolean"},{"type":"boolean"}],"uniqueItems":true,"items":false}"#,
        #"[false,true,null]"#,
        false,
    );
}

test "uniqueItems=false validation: unique array of integers is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":false}"#,
        #"[1,2]"#,
        true,
    );
}

test "uniqueItems=false validation: non-unique array of integers is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":false}"#,
        #"[1,1]"#,
        true,
    );
}

test "uniqueItems=false validation: numbers are unique if mathematically unequal" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":false}"#,
        #"[1,1,1]"#,
        true,
    );
}

test "uniqueItems=false validation: false is not equal to zero" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":false}"#,
        #"[0,false]"#,
        true,
    );
}

test "uniqueItems=false validation: true is not equal to one" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":false}"#,
        #"[1,true]"#,
        true,
    );
}

test "uniqueItems=false validation: unique array of objects is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","uniqueItems":false}"#,
        #"[{"foo":"bar"},{"foo":"baz"}]"#,
        true,
    );
}

