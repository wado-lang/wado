    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"iri-reference"}"#,
        #""//â@b@ƒøø.ßår/""#,
        false,
    );
}

test "validation of IRI References: a colon in the first segment of a relative-path reference" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"iri-reference"}"#,
        #""â:b""#,
        false,
    );
}

test "validation of IRI References: a colon in the first segment preceded by a dot-segment" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"iri-reference"}"#,
        #""./â:b""#,
        true,
    );
}

