}

test "required with escaped characters: object with some properties missing is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","required":["foo\nbar","foo\"bar","foo\\bar","foo\rbar","foo\tbar","foo\fbar"]}"#,
