// Generated by package-jade/tools/suite.wado from
// vendor/JSON-Schema-Test-Suite/tests/draft2020-12/additionalProperties.json. Regenerate with
// `mise run suite-jade`; do not edit.

use { check } from "../suite.wado";

test "additionalProperties being false does not allow other properties: no additional properties is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{},"bar":{}},"patternProperties":{"^v":{}},"additionalProperties":false}"#,
        #"{"foo":1}"#,
        true,
    );
}

test "additionalProperties being false does not allow other properties: an additional property is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{},"bar":{}},"patternProperties":{"^v":{}},"additionalProperties":false}"#,
        #"{"foo":1,"bar":2,"quux":"boom"}"#,
        false,
    );
}

test "additionalProperties being false does not allow other properties: ignores arrays" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{},"bar":{}},"patternProperties":{"^v":{}},"additionalProperties":false}"#,
        #"[1,2,3]"#,
        true,
    );
}

test "additionalProperties being false does not allow other properties: ignores strings" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{},"bar":{}},"patternProperties":{"^v":{}},"additionalProperties":false}"#,
        #""foobarbaz""#,
        true,
    );
}

test "additionalProperties being false does not allow other properties: ignores other non-objects" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{},"bar":{}},"patternProperties":{"^v":{}},"additionalProperties":false}"#,
        #"12"#,
        true,
    );
}

test "additionalProperties being false does not allow other properties: patternProperties are not additional properties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{},"bar":{}},"patternProperties":{"^v":{}},"additionalProperties":false}"#,
        #"{"foo":1,"vroom":2}"#,
        true,
    );
}

test "non-ASCII pattern with additionalProperties: matching the pattern is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"^á":{}},"additionalProperties":false}"#,
        #"{"ármányos":2}"#,
        true,
    );
}

test "non-ASCII pattern with additionalProperties: not matching the pattern is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","patternProperties":{"^á":{}},"additionalProperties":false}"#,
        #"{"élmény":2}"#,
        false,
    );
}

test "additionalProperties with schema: no additional properties is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{},"bar":{}},"additionalProperties":{"type":"boolean"}}"#,
        #"{"foo":1}"#,
        true,
    );
}

test "additionalProperties with schema: an additional valid property is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{},"bar":{}},"additionalProperties":{"type":"boolean"}}"#,
        #"{"foo":1,"bar":2,"quux":true}"#,
        true,
    );
}

test "additionalProperties with schema: an additional invalid property is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{},"bar":{}},"additionalProperties":{"type":"boolean"}}"#,
        #"{"foo":1,"bar":2,"quux":12}"#,
        false,
    );
}

test "additionalProperties can exist by itself: an additional valid property is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":{"type":"boolean"}}"#,
        #"{"foo":true}"#,
        true,
    );
}

test "additionalProperties can exist by itself: an additional invalid property is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":{"type":"boolean"}}"#,
        #"{"foo":1}"#,
        false,
    );
}

test "additionalProperties are allowed by default: additional properties are allowed" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{},"bar":{}}}"#,
        #"{"foo":1,"bar":2,"quux":true}"#,
        true,
    );
}

test "additionalProperties does not look in applicators: properties defined in allOf are not examined" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","allOf":[{"properties":{"foo":{}}}],"additionalProperties":{"type":"boolean"}}"#,
        #"{"foo":1,"bar":true}"#,
        false,
    );
}

test "additionalProperties with null valued instance properties: allows null values" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":{"type":"null"}}"#,
        #"{"foo":null}"#,
        true,
    );
}

test "additionalProperties with propertyNames: Valid against both keywords" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":{"maxLength":5},"additionalProperties":{"type":"number"}}"#,
        #"{"apple":4}"#,
        true,
    );
}

test "additionalProperties with propertyNames: Valid against propertyNames, but not additionalProperties" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","propertyNames":{"maxLength":5},"additionalProperties":{"type":"number"}}"#,
        #"{"fig":2,"pear":"available"}"#,
        false,
    );
}

test "dependentSchemas with additionalProperties: additionalProperties doesn't consider dependentSchemas" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo2":{}},"dependentSchemas":{"foo":{},"foo2":{"properties":{"bar":{}}}},"additionalProperties":false}"#,
        #"{"foo":""}"#,
        false,
    );
}

test "dependentSchemas with additionalProperties: additionalProperties can't see bar" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo2":{}},"dependentSchemas":{"foo":{},"foo2":{"properties":{"bar":{}}}},"additionalProperties":false}"#,
        #"{"bar":""}"#,
        false,
    );
}

test "dependentSchemas with additionalProperties: additionalProperties can't see bar even when foo2 is present" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo2":{}},"dependentSchemas":{"foo":{},"foo2":{"properties":{"bar":{}}}},"additionalProperties":false}"#,
        #"{"foo2":"","bar":""}"#,
        false,
    );
}
