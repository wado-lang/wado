use { check_format } from "../suite.wado";

test "uuid format: all string formats ignore integers" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #"12"#,
        true,
    );
}

test "uuid format: all string formats ignore floats" {
    check_format(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","format":"uuid"}"#,
        #"13.7"#,
        true,
    );
}

