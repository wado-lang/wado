test "object properties validation: both properties present and valid is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"integer"},"bar":{"type":"string"}}}"#,
        #"{"foo":1,"bar":"baz"}"#,
        true,
        [],
    );
}

test "object properties validation: one property invalid is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"integer"},"bar":{"type":"string"}}}"#,
        #"{"foo":1,"bar":{}}"#,
        false,
        [],
    );
}

test "object properties validation: both properties invalid is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"foo":{"type":"integer"},"bar":{"type":"string"}}}"#,
