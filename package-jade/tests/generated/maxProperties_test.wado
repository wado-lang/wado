use { check } from "../suite.wado";

test "maxProperties validation: shorter is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxProperties":2}"#,
        #"{"foo":1}"#,
        true,
    );
}

test "maxProperties validation: exact length is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxProperties":2}"#,
        #"{"foo":1,"bar":2}"#,
        true,
    );
}

test "maxProperties validation: too long is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxProperties":2}"#,
        #"{"foo":1,"bar":2,"baz":3}"#,
        false,
    );
}

test "maxProperties validation: ignores arrays" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxProperties":2}"#,
        #"[1,2,3]"#,
        true,
    );
}

test "maxProperties validation: ignores strings" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxProperties":2}"#,
        #""foobar""#,
        true,
    );
}

test "maxProperties validation: ignores other non-objects" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxProperties":2}"#,
        #"12"#,
        true,
    );
}

test "maxProperties validation with a decimal: shorter is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxProperties":2}"#,
        #"{"foo":1}"#,
        true,
    );
}

test "maxProperties validation with a decimal: too long is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxProperties":2}"#,
        #"{"foo":1,"bar":2,"baz":3}"#,
        false,
    );
}

test "maxProperties = 0 means the object is empty: no properties is valid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxProperties":0}"#,
        #"{}"#,
        true,
    );
}

test "maxProperties = 0 means the object is empty: one property is invalid" {
    check(
        #"{"$schema":"https://json-schema.org/draft/2020-12/schema","maxProperties":0}"#,
        #"{"foo":1}"#,
        false,
    );
}
