use { Json, JsonKind } from "../src/json.wado";
use { to_string } from "core:json";

fn round_trip(text: String) -> String {
    return to_string(&Json::parse(text).unwrap()).unwrap();
}

test "a document reads and writes back" {
    assert round_trip(`null`) == `null`;
    assert round_trip(` [true, false, 1.5, -0, "aé"] `) == `[true,false,1.5,-0,"aé"]`;
    assert round_trip(`{"a": {"b": [1, {}], "c": []}, "d": "x"}`) == `{"a":{"b":[1,{}],"c":[]},"d":"x"}`;
}

test "a node answers its kind, its value and its members" {
    let doc = Json::parse(`{"n": 2, "s": "hi", "l": [null, [3]], "b": true}`).unwrap();
    let root = doc.root();
    assert root.kind() == JsonKind::Object;
    assert root.len() == 4;
    assert root.get("n").unwrap().as_f64() == Option::Some(2.0);
    assert root.get("s").unwrap().as_str().unwrap() == "hi";
    assert root.get("b").unwrap().as_bool() == Option::Some(true);
    assert root.get("missing") matches { None };
    let l = root.get("l").unwrap();
    assert l.len() == 2;
    let mut kinds: List<JsonKind> = [];
    for let item of l.items() {
        kinds.push(item.kind());
    }
    assert kinds == [JsonKind::Null, JsonKind::Array];
    let mut keys: List<String> = [];
    for let [k, _] of root.entries() {
        keys.push(k.to_string());
    }
    assert keys == ["n", "s", "l", "b"];
}

test "a subtree becomes a document of its own" {
    let doc = Json::parse(`[1, {"a": ["x", 2]}, 3]`).unwrap();
    let mut items = doc.root().items();
    items.next();
    let sub = items.next().unwrap().to_json();
    assert to_string(&sub).unwrap() == `{"a":["x",2]}`;
    assert items.next().unwrap().as_f64() == Option::Some(3.0);
}

test "equality compares numbers by value and objects by members" {
    assert Json::parse(`1`).unwrap() == Json::parse(`1.0`).unwrap();
    assert Json::parse(`{"a": 1, "b": [2]}`).unwrap() == Json::parse(`{"b": [2.0], "a": 1}`).unwrap();
    assert Json::parse(`{"a": 1}`).unwrap() != Json::parse(`{"a": 1, "b": 2}`).unwrap();
    assert Json::parse(`[1, 2]`).unwrap() != Json::parse(`[2, 1]`).unwrap();
    assert Json::parse(`false`).unwrap() != Json::parse(`0`).unwrap();
    assert Json::parse(`null`).unwrap() == Json::of(&()).unwrap();
}

test "a document is built from a string or from what core:json writes" {
    assert to_string(&Json::string("a")).unwrap() == `"a"`;
    assert to_string(&Json::of(&[1, 2]).unwrap()).unwrap() == `[1,2]`;
    assert Json::of(&2.5).unwrap().root().as_f64() == Option::Some(2.5);
}

test "malformed text is an error" {
    assert Json::parse(``).is_err();
    assert Json::parse(`[1,]`).is_err();
    assert Json::parse(`[1 2]`).is_err();
    assert Json::parse(`{"a" 1}`).is_err();
    assert Json::parse(`{1: 2}`).is_err();
    assert Json::parse(`nul`).is_err();
    assert Json::parse(`1 2`).is_err();
    assert Json::parse(#`"\uD800"`#).is_err();
    assert Json::parse(`1e400`).is_err();
}

test "a repeated key is an error, in a small object and a large one" {
    assert Json::parse(`{"a": 1, "a": 2}`).is_err();
    let mut text = "{";
    for let i of 0..<20 {
        text.push_str(`"k${i}": ${i},`);
    }
    assert Json::parse(`${text}"k3": 0}`).is_err();
    assert Json::parse(`${text}"k20": 0}`).unwrap().root().len() == 21;
}

test "nesting past max_depth is an error" {
    assert Json::parse(`[[[1]]]`, 3).is_ok();
    assert Json::parse(`[[[[1]]]]`, 3).is_err();
}
