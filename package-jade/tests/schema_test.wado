use { Schema, TypeSet } from "../src/lib.wado";
use { Value } from "core:value";
use { to_string } from "core:json";

test "gale-style options object serializes to idiomatic JSON Schema" {
    // { highlight: bool (required), trace: bool = false }
    let mut root = Schema::object();
    root.as_root();
    root.property("highlight", Schema::boolean());
    let mut trace = Schema::boolean();
    trace.set_default(Value::Bool(false));
    root.property("trace", trace);
    root.require("highlight");

    let json = to_string(&root).unwrap();
    assert json == `{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"highlight":{"type":"boolean"},"trace":{"type":"boolean","default":false}},"required":["highlight"],"additionalProperties":false}`;
}

test "absent fields are omitted" {
    let json = to_string(&Schema::boolean()).unwrap();
    assert json == `{"type":"boolean"}`;
}

test "nullable string via a type union" {
    let schema = Schema {
        type: Option::Some(TypeSet::Many(["string", "null"])),
        default_: Option::Some(Value::Null),
    };
    let json = to_string(&schema).unwrap();
    assert json == `{"type":["string","null"],"default":null}`;
}
