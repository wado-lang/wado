use { Document, JsonTypes, Number, Schema, SchemaObject, pointer_token } from "../src/lib.wado";
use { to_string } from "core:json";
use { HashMap } from "core:collections";

fn reread(text: String) -> String {
    return to_string(&Schema::parse(text).unwrap()).unwrap();
}

fn error_of(text: String) -> String {
    return `${Schema::parse(text).unwrap_err()}`;
}

test "an absent keyword is left out" {
    assert to_string(&SchemaObject {}).unwrap() == "{}";
    assert to_string(&SchemaObject::constant(Document::of(&()).unwrap())).unwrap() == `{"const":null}`;
}

test "a boolean schema is a boolean" {
    assert reread("true") == "true";
    assert reread("false") == "false";
    assert to_string(&Schema::Bool(false).into_object()).unwrap() == `{"not":true}`;
    assert to_string(&Schema::Bool(true).into_object()).unwrap() == `{}`;
}

test "one type is a string, more an array" {
    assert reread(`{"type": "integer"}`) == `{"type":"integer"}`;
    assert reread(`{"type": ["string", "null"]}`) == `{"type":["null","string"]}`;
    let Schema::Object(o) = Schema::parse(`{"type": ["number", "boolean"]}`).unwrap() else {
        unreachable();
    };
    assert o.type == JsonTypes::Number | JsonTypes::Boolean;
}

test "type names at least one type" {
    assert error_of(`{"type": []}`) == "/type: must name at least one type";
    assert error_of(`{"type": 1}`) == "/type: must be a type name or an array of them";
}

test "every keyword reads and writes back" {
    let text = `{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://x.test/s","$vocabulary":{"https://v.test":true},"$anchor":"a","$dynamicAnchor":"d","$ref":"#/$defs/n","$dynamicRef":"#d","$comment":"c","title":"t","description":"d","type":"object","format":"f","contentEncoding":"base64","contentMediaType":"application/json","contentSchema":true,"const":[1,{"a":null}],"enum":[1,"x"],"allOf":[true],"anyOf":[false],"oneOf":[{}],"not":false,"if":true,"then":true,"else":false,"multipleOf":0.5,"minimum":1,"exclusiveMinimum":0,"maximum":9,"exclusiveMaximum":10,"minLength":1,"maxLength":2,"pattern":"^a","items":true,"prefixItems":[true],"contains":true,"minContains":1,"maxContains":2,"minItems":1,"maxItems":3,"uniqueItems":true,"unevaluatedItems":false,"properties":{"p":true},"patternProperties":{"^q":true},"required":["p"],"dependentRequired":{"p":["q"]},"dependentSchemas":{"p":true},"additionalProperties":false,"propertyNames":true,"minProperties":1,"maxProperties":4,"unevaluatedProperties":false,"default":{"p":1},"examples":[{"p":2}],"deprecated":true,"readOnly":true,"writeOnly":true,"$defs":{"n":true},"x-wado-format":"core:temporal#Instant","x-extension":[1]}`;
    assert reread(text) == text;
}

test "a count may be written with a zero fraction" {
    assert reread(`{"maxLength": 2.0}`) == `{"maxLength":2}`;
}

test "an empty enum is kept, as it admits nothing" {
    assert reread(`{"enum": []}`) == `{"enum":[]}`;
}

test "a keyword's value breaking its rule is an error at its pointer" {
    assert error_of(`1`) == "a schema must be an object or a boolean";
    assert error_of(`{"minLength": -1}`) == "/minLength: must be a non-negative integer";
    assert error_of(`{"minLength": 1.5}`) == "/minLength: must be a non-negative integer";
    assert error_of(`{"type": "int"}`) == `/type: names no type: "int"`;
    assert error_of(`{"type": ["string", "string"]}`) == "/type/1: repeats a type";
    assert error_of(`{"properties": {"a/b": 1}}`) == "/properties/a~1b: a schema must be an object or a boolean";
    assert error_of(`{"allOf": []}`) == "/allOf: must be a non-empty array of schemas";
    assert error_of(`{"required": ["a", "a"]}`) == "/required/1: repeats a name";
    assert error_of(`{"multipleOf": 0}`) == "/multipleOf: must be greater than 0";
    assert error_of(`{"$ref": 1}`) == "/$ref: must be a string";
    assert error_of(`{`).starts_with("unexpected end of input");
}

test "a value the meta-schema rejects is an error at its pointer" {
    assert error_of(`{"$id": "https://x.test/s#a"}`) == "/$id: must have an empty fragment or none";
    assert reread(`{"$id": "https://x.test/s#"}`) == `{"$id":"https://x.test/s#"}`;
    let anchor = "must be a letter or `_`, then letters, digits, `-`, `.` or `_`";
    assert error_of(`{"$anchor": "1a"}`) == `/$anchor: ${anchor}`;
    assert error_of(`{"$dynamicAnchor": "a b"}`) == `/$dynamicAnchor: ${anchor}`;
    assert error_of(`{"dependentRequired": {"p": ["q", "q"]}}`) == "/dependentRequired/p/1: repeats a name";
}

test "$schema names Draft 2020-12's meta-schema, at a schema resource's root" {
    let draft = "https://json-schema.org/draft/2020-12/schema";
    assert reread(`{"$schema": "${draft}#"}`) == `{"$schema":"${draft}#"}`;
    assert error_of(`{"$schema": "http://json-schema.org/draft-07/schema#"}`)
        == "/$schema: must name Draft 2020-12's meta-schema, the only one Jade can validate against";
    assert error_of(`{"items": {"$schema": "${draft}"}}`) == "/items/$schema: may appear only at a schema resource's root";
    assert reread(`{"items": {"$id": "i", "$schema": "${draft}"}}`) == `{"items":{"$schema":"${draft}","$id":"i"}}`;
}

test "x-wado-format is an annotation, read as any other" {
    assert reread(`{"x-wado-format": 1}`) == `{"x-wado-format":1}`;
}

test "a schema built breaking a keyword's rule is not written" {
    let mut extra = HashMap::<String, Document>::new();
    extra["type"] = Document::string("integer");
    let collides = to_string(&SchemaObject { extra }).unwrap_err();
    assert `${collides}` == "/type: is a keyword Draft 2020-12 defines";
    let zero = to_string(&SchemaObject { multiple_of: Option::Some(Number::from(0.0)) }).unwrap_err();
    assert `${zero}` == "/multipleOf: must be greater than 0";
    let negative = to_string(&SchemaObject { min_length: Option::Some(-1) }).unwrap_err();
    assert `${negative}` == "/minLength: must be a non-negative integer";
}

test "a pointer token escapes ~ and /" {
    assert pointer_token("a~b/c") == "a~0b~1c";
    assert pointer_token("plain") == "plain";
}
