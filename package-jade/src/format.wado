//! The `format` values a validator asserts when compiled to, each read strictly
//! by the grammar Draft 2020-12 cites for it.

use { Uri } from "core:uri";

/// A format Jade asserts.
internal enum Format {
    DateTime,
    Date,
    Time,
    Duration,
    Email,
    Ipv4,
    Ipv6,
    Uri,
    UriReference,
    Iri,
    IriReference,
    Uuid,
    UriTemplate,
    JsonPointer,
    RelativeJsonPointer,
}

impl Format {
    /// The format `name` names, or none for one Jade does not assert.
    internal fn named(name: &String) -> Option<Format> {
        return match name.as_str_slice() {
            "date-time" => Option::Some(DateTime),
            "date" => Option::Some(Date),
            "time" => Option::Some(Time),
            "duration" => Option::Some(Duration),
            "email" => Option::Some(Email),
            "ipv4" => Option::Some(Ipv4),
            "ipv6" => Option::Some(Ipv6),
            "uri" => Option::Some(Uri),
            "uri-reference" => Option::Some(UriReference),
            "iri" => Option::Some(Iri),
            "iri-reference" => Option::Some(IriReference),
            "uuid" => Option::Some(Uuid),
            "uri-template" => Option::Some(UriTemplate),
            "json-pointer" => Option::Some(JsonPointer),
            "relative-json-pointer" => Option::Some(RelativeJsonPointer),
            _ => null,
        };
    }

    internal fn name(&self) -> String {
        return match self {
            DateTime => "date-time",
            Date => "date",
            Time => "time",
            Duration => "duration",
            Email => "email",
            Ipv4 => "ipv4",
            Ipv6 => "ipv6",
            Uri => "uri",
            UriReference => "uri-reference",
            Iri => "iri",
            IriReference => "iri-reference",
            Uuid => "uuid",
            UriTemplate => "uri-template",
            JsonPointer => "json-pointer",
            RelativeJsonPointer => "relative-json-pointer",
        };
    }

    /// Whether `text` is a value of the format.
    internal fn admits(&self, text: StrSlice) -> bool {
        return match self {
            DateTime => {
                let mut s = Scan::of(text);
                full_date(&mut s) && s.eat('T') && full_time(&mut s) && s.done();
            },
            Date => {
                let mut s = Scan::of(text);
                full_date(&mut s) && s.done();
            },
            Time => {
                let mut s = Scan::of(text);
                full_time(&mut s) && s.done();
            },
            Duration => is_duration(text),
            Email => {
                let mut s = Scan::of(text);
                mailbox(&mut s) && s.done();
            },
            Ipv4 => {
                let mut s = Scan::of(text);
                dotted_quad(&mut s, Leading::Unpadded) && s.done();
            },
            Ipv6 => is_ipv6(&Scan::of(text).chars, 1, Leading::Unpadded),
            Uri => is_uri_reference(text) && has_scheme(text),
            UriReference => is_uri_reference(text),
            Iri => is_iri_reference(text) && has_scheme(text),
            IriReference => is_iri_reference(text),
            Uuid => is_uuid(text),
            UriTemplate => {
                let mut s = Scan::of(text);
                uri_template(&mut s);
            },
            JsonPointer => {
                let mut s = Scan::of(text);
                json_pointer(&mut s);
            },
            RelativeJsonPointer => {
                let mut s = Scan::of(text);
                relative_json_pointer(&mut s);
            },
        };
    }
}

/// RFC 6901's `json-pointer`, to the end: `*( "/" reference-token )`, where a
/// `~` must be `~0` or `~1`.
fn json_pointer(s: &mut Scan) -> bool {
    while s.eat('/') {
        while !s.done() && s.chars[s.at] != '/' {
            if s.eat('~') {
                if !s.eat('0') && !s.eat('1') {
                    return false;
                }
            } else {
                s.at += 1;
            }
        }
    }
    return s.done();
}

/// Relative JSON Pointer's `non-negative-integer ( json-pointer / "#" )`, in
/// the draft Draft 2020-12 cites, which has no index manipulation.
fn relative_json_pointer(s: &mut Scan) -> bool {
    if s.eat('0') {
        if !s.done() && s.chars[s.at].is_ascii_digit() {
            return false;
        }
    } else if !s.some_digits() {
        return false;
    }
    if s.eat('#') {
        return s.done();
    }
    return json_pointer(s);
}

/// RFC 6570's `URI-Template`, to the end: literals, and expressions with an
/// optional operator and a list of variables, each with an optional prefix
/// length or explode.
fn uri_template(s: &mut Scan) -> bool {
    while !s.done() {
        let c = s.chars[s.at];
        s.at += 1;
        if c == '{' {
            if !expression(s) {
                return false;
            }
        } else if c == '%' {
            if !hex_pair(s) {
                return false;
            }
        } else if !is_template_literal(c) {
            return false;
        }
    }
    return true;
}

/// An `expression` after its `{`, through its `}`.
fn expression(s: &mut Scan) -> bool {
    if !s.done() && "+#./;?&=,!@|".contains_char(s.chars[s.at]) {
        s.at += 1;
    }
    loop {
        if !varname(s) {
            return false;
        }
        if s.eat(':') {
            // max-length = %x31-39 0*3DIGIT
            if s.done() || s.chars[s.at] == '0' {
                return false;
            }
            let start = s.at;
            while s.at - start < 4 && s.digit() matches { Some(_) } {
            }
            if s.at == start {
                return false;
            }
        } else {
            s.eat('*');
        }
        if s.eat('}') {
            return true;
        }
        if !s.eat(',') {
            return false;
        }
    }
}

/// `varname = varchar *( ["."] varchar )`, each `varchar` a letter, a digit,
/// `_` or a percent-encoded octet.
fn varname(s: &mut Scan) -> bool {
    let mut after_dot = true;
    let mut any = false;
    while !s.done() {
        let c = s.chars[s.at];
        if c.is_ascii_alphanumeric() || c == '_' {
            s.at += 1;
        } else if c == '%' {
            s.at += 1;
            if !hex_pair(s) {
                return false;
            }
        } else if c == '.' && !after_dot {
            s.at += 1;
            after_dot = true;
            continue;
        } else {
            break;
        }
        after_dot = false;
        any = true;
    }
    return any && !after_dot;
}

fn hex_pair(s: &mut Scan) -> bool {
    for let _ of 0..<2 {
        if s.done() || !s.chars[s.at].is_hexdigit() {
            return false;
        }
        s.at += 1;
    }
    return true;
}

/// RFC 6570's `literals`, less `pct-encoded`: any character but a control,
/// space, `"`, `%`, `<`, `>`, `\`, `^`, `` ` ``, `{`, `|` and `}`, where one
/// outside ASCII must be a `ucschar` or an `iprivate`. `'` is admitted, as
/// verified Erratum 6937 corrects the rule to.
fn is_template_literal(c: char) -> bool {
    let n = c as u32;
    if n >= 0x80 {
        return is_ucschar(c) || is_iprivate(c);
    }
    return n > 0x20 && n != 0x7F && !"\"%<>\\^`{|}".contains_char(c);
}

/// A cursor over the characters of a format value. A letter matches in either
/// case, as an ABNF string does.
struct Scan {
    chars: List<char>,
    at: i32 = 0,
}

impl Scan {
    fn of(text: StrSlice) -> Scan {
        return Scan { chars: text.chars().collect() };
    }

    fn done(&self) -> bool {
        return self.at == self.chars.len();
    }

    /// Takes `c`, in either case, when it comes next.
    fn eat(&mut self, c: char) -> bool {
        if self.done() || self.chars[self.at].to_ascii_uppercase() != c.to_ascii_uppercase() {
            return false;
        }
        self.at += 1;
        return true;
    }

    /// Takes exactly `n` ASCII digits, as the number they spell.
    fn digits(&mut self, n: i32) -> Option<i32> {
        let mut value = 0;
        for let _ of 0..<n {
            let Some(d) = self.digit() else {
                return null;
            };
            value = value * 10 + d;
        }
        return Option::Some(value);
    }

    /// Takes one or more ASCII digits, answering whether there was one.
    fn some_digits(&mut self) -> bool {
        let start = self.at;
        while self.digit() matches { Some(_) } {
        }
        return self.at > start;
    }

    fn digit(&mut self) -> Option<i32> {
        if self.done() || !self.chars[self.at].is_ascii_digit() {
            return null;
        }
        self.at += 1;
        return Option::Some(self.chars[self.at - 1] as i32 - '0' as i32);
    }
}

/// Whether a decimal octet may start with a zero.
enum Leading {
    /// RFC 2673's `decbyte`, as the Test Suite reads it: never, since a
    /// leading zero reads as octal elsewhere.
    Unpadded,
    /// RFC 5321's `Snum = 1*3DIGIT`: always.
    Padded,
}

/// Four decimal octets, 0 to 255, joined by dots.
fn dotted_quad(s: &mut Scan, leading: Leading) -> bool {
    for let i of 0..<4 {
        if i > 0 && !s.eat('.') {
            return false;
        }
        let start = s.at;
        let mut value = 0;
        while s.at - start < 3 && let Some(d) = s.digit() {
            value = value * 10 + d;
        }
        let width = s.at - start;
        if width == 0 || value > 255 || leading matches { Unpadded } && width > 1 && s.chars[start] == '0' {
            return false;
        }
    }
    return true;
}

/// Whether `chars` is RFC 4291 2.2's text form of an IPv6 address: eight
/// groups of one to four hex digits, the last two of which may be written as a
/// dotted quad, with one `::` standing for at least `elided` groups of zeros.
fn is_ipv6(chars: &List<char>, elided: i32, leading: Leading) -> bool {
    let len = chars.len();
    let mut gap = -1;
    for let i of 0..<len - 1 {
        if chars[i] == ':' && chars[i + 1] == ':' {
            if gap >= 0 {
                return false;
            }
            gap = i;
        }
    }
    if gap < 0 {
        return groups(chars, 0, len, true, leading) == Option::Some(8);
    }
    let Some(head) = groups(chars, 0, gap, false, leading) else {
        return false;
    };
    let Some(tail) = groups(chars, gap + 2, len, true, leading) else {
        return false;
    };
    return head + tail <= 8 - elided;
}

/// How many 16-bit groups `chars[from..to]` writes, separated by colons, or
/// none when it is not such a list. Where `last`, the final group may be a
/// dotted quad, which writes two.
fn groups(chars: &List<char>, from: i32, to: i32, last: bool, leading: Leading) -> Option<i32> {
    if from == to {
        return Option::Some(0);
    }
    let mut count = 0;
    let mut start = from;
    for let i of from..=to {
        if i < to && chars[i] != ':' {
            continue;
        }
        let mut piece: List<char> = [];
        for let k of start..<i {
            piece.push(chars[k]);
        }
        if 1 <= piece.len() && piece.len() <= 4 && piece.iter_ref().all(|c| c.is_hexdigit()) {
            count += 1;
        } else {
            let mut s = Scan { chars: piece };
            if !(last && i == to && dotted_quad(&mut s, leading) && s.done()) {
                return null;
            }
            count += 2;
        }
        start = i + 1;
    }
    return Option::Some(count);
}

/// RFC 5321 4.1.2's `Mailbox`.
fn mailbox(s: &mut Scan) -> bool {
    if !local_part(s) || !s.eat('@') {
        return false;
    }
    if s.eat('[') {
        return address_literal(s);
    }
    return domain(s);
}

/// `Local-part = Dot-string / Quoted-string`.
fn local_part(s: &mut Scan) -> bool {
    if !s.eat('"') {
        return dot_string(s);
    }
    while !s.done() {
        let c = s.chars[s.at] as u32;
        s.at += 1;
        if c == 34 {
            return true;
        }
        if c == 92 {
            // quoted-pairSMTP = %d92 %d32-126
            if s.done() || !(32 <= s.chars[s.at] as u32 && s.chars[s.at] as u32 <= 126) {
                return false;
            }
            s.at += 1;
        } else if !(32 <= c && c <= 126) {
            // qtextSMTP is %d32-126 less the quote and the backslash.
            return false;
        }
    }
    return false;
}

/// `Dot-string = Atom *("." Atom)`, each `Atom` one or more of RFC 5322's
/// `atext`.
fn dot_string(s: &mut Scan) -> bool {
    loop {
        let start = s.at;
        while !s.done() && is_atext(s.chars[s.at]) {
            s.at += 1;
        }
        if s.at == start {
            return false;
        }
        if !s.eat('.') {
            return true;
        }
    }
}

fn is_atext(c: char) -> bool {
    return c.is_ascii_alphanumeric() || "!#$%&'*+-/=?^_`{|}~".contains_char(c);
}

/// `Domain = sub-domain *("." sub-domain)`, each `sub-domain` letters, digits
/// and hyphens that neither start nor end with a hyphen.
fn domain(s: &mut Scan) -> bool {
    loop {
        let start = s.at;
        while !s.done() && (s.chars[s.at].is_ascii_alphanumeric() || s.chars[s.at] == '-') {
            s.at += 1;
        }
        if s.at == start || s.chars[start] == '-' || s.chars[s.at - 1] == '-' {
            return false;
        }
        if !s.eat('.') {
            return true;
        }
    }
}

/// An `address-literal` after its `[`: an IPv4 or an IPv6 address literal. A
/// `General-address-literal` needs a tag IANA registers, and the registry
/// holds only `IPv6`.
fn address_literal(s: &mut Scan) -> bool {
    let mut inner: List<char> = [];
    while !s.done() && s.chars[s.at] != ']' {
        inner.push(s.chars[s.at]);
        s.at += 1;
    }
    if !s.eat(']') {
        return false;
    }
    let mut literal = Scan { chars: inner };
    if literal.eat('I') && literal.eat('P') && literal.eat('v') && literal.eat('6') && literal.eat(':') {
        let mut address: List<char> = [];
        for let k of literal.at..<literal.chars.len() {
            address.push(literal.chars[k]);
        }
        // RFC 5321's `IPv6-comp`: "The "::" represents at least 2 16-bit
        // groups of zeros."
        return is_ipv6(&address, 2, Leading::Padded);
    }
    literal.at = 0;
    return dotted_quad(&mut literal, Leading::Padded) && literal.done();
}

/// RFC 3339's `full-date`, its day within its month.
fn full_date(s: &mut Scan) -> bool {
    let Some(year) = s.digits(4) else {
        return false;
    };
    if !s.eat('-') {
        return false;
    }
    let Some(month) = s.digits(2) else {
        return false;
    };
    if !s.eat('-') {
        return false;
    }
    let Some(day) = s.digits(2) else {
        return false;
    };
    return 1 <= month && month <= 12 && 1 <= day && day <= days_in(year, month);
}

fn days_in(year: i32, month: i32) -> i32 {
    if month == 2 {
        let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
        return if leap { 29 } else { 28 };
    }
    return if month == 4 || month == 6 || month == 9 || month == 11 { 30 } else { 31 };
}

/// RFC 3339's `full-time`. A leap second must fall on the last minute of a UTC
/// day, once the offset is taken away.
fn full_time(s: &mut Scan) -> bool {
    let Some(hour) = s.digits(2) else {
        return false;
    };
    if !s.eat(':') {
        return false;
    }
    let Some(minute) = s.digits(2) else {
        return false;
    };
    if !s.eat(':') {
        return false;
    }
    let Some(second) = s.digits(2) else {
        return false;
    };
    if hour > 23 || minute > 59 || second > 60 {
        return false;
    }
    if s.eat('.') && !s.some_digits() {
        return false;
    }
    let mut offset = 0;
    if !s.eat('Z') {
        let sign = if s.eat('+') {
            1;
        } else if s.eat('-') {
            -1;
        } else {
            return false;
        };
        let Some(h) = s.digits(2) else {
            return false;
        };
        if !s.eat(':') {
            return false;
        }
        let Some(m) = s.digits(2) else {
            return false;
        };
        if h > 23 || m > 59 {
            return false;
        }
        offset = sign * (h * 60 + m);
    }
    let day = 24 * 60;
    return second < 60 || ((hour * 60 + minute - offset) % day + day) % day == day - 1;
}

/// RFC 3339 Appendix A's `duration`. A unit may follow only the next larger
/// one: `dur-year = 1*DIGIT "Y" [dur-month]`, and so on down to seconds.
fn is_duration(text: StrSlice) -> bool {
    let mut s = Scan::of(text);
    if !s.eat('P') {
        return false;
    }
    let date = units(&mut s);
    let timed = s.eat('T');
    let time = if timed { units(&mut s) } else { "" };
    if !s.done() || timed && time.is_empty() {
        return false;
    }
    if date == "W" {
        return !timed;
    }
    return !(date.is_empty() && time.is_empty()) && "YMD".contains(&date) && "HMS".contains(&time);
}

/// The units of the `1*DIGIT unit` elements that come next, upper-cased, in
/// order.
fn units(s: &mut Scan) -> String {
    let mut out = "";
    while s.some_digits() {
        if s.done() || !s.chars[s.at].is_ascii_alphabetic() {
            return "?";
        }
        out.push(s.chars[s.at].to_ascii_uppercase());
        s.at += 1;
    }
    return out;
}

/// Whether `text` is RFC 3986's `URI-reference`.
fn is_uri_reference(text: StrSlice) -> bool {
    return Uri::from_str(text) matches { Ok(_) };
}

/// Whether `text` begins with RFC 3986's `scheme ":"`. A `relative-ref` cannot,
/// since its first segment holds no colon, so a `URI-reference` that does is a
/// `URI`.
fn has_scheme(text: StrSlice) -> bool {
    let mut first = true;
    for let c of text.chars() {
        if c == ':' {
            return !first;
        }
        let allowed = c.is_ascii_alphabetic() || !first && (c.is_ascii_digit() || c == '+' || c == '-' || c == '.');
        if !allowed {
            return false;
        }
        first = false;
    }
    return false;
}

/// Whether `text` is RFC 3987's `IRI-reference`. RFC 3987 3.1 maps an IRI to a
/// URI by percent-encoding each character outside ASCII, and the IRI grammar
/// admits such a character exactly where the URI grammar admits a
/// percent-encoded octet, save that it must be a `ucschar`, or an `iprivate`
/// in the query.
fn is_iri_reference(text: StrSlice) -> bool {
    let mut mapped = String::with_capacity(text.len());
    let mut in_query = false;
    let mut in_fragment = false;
    for let c of text.chars() {
        if c == '#' {
            in_fragment = true;
            in_query = false;
        } else if c == '?' && !in_fragment {
            in_query = true;
        }
        if (c as u32) < 0x80 {
            mapped.push(c);
        } else if is_ucschar(c) || in_query && is_iprivate(c) {
            mapped.push_str("%00");
        } else {
            return false;
        }
    }
    return is_uri_reference(mapped.as_str_slice());
}

fn is_ucschar(c: char) -> bool {
    let n = c as u32;
    if 0xA0 <= n && n <= 0xD7FF || 0xF900 <= n && n <= 0xFDCF || 0xFDF0 <= n && n <= 0xFFEF {
        return true;
    }
    // %x10000-1FFFD through %xE1000-EFFFD: every plane from 1 to 14, less its
    // last two code points.
    return 0x10000 <= n && n < 0xF0000 && n & 0xFFFF <= 0xFFFD;
}

fn is_iprivate(c: char) -> bool {
    let n = c as u32;
    return 0xE000 <= n && n <= 0xF8FF || 0xF0000 <= n && n & 0xFFFF <= 0xFFFD;
}

/// Whether `text` is RFC 4122's `UUID`: 32 hex digits, grouped 8-4-4-4-12 by
/// hyphens. `core:uuid` reads more, such as braces and a `urn:uuid:` prefix.
fn is_uuid(text: StrSlice) -> bool {
    if text.len() != 36 {
        return false;
    }
    let mut i = 0;
    for let c of text.chars() {
        let hyphen = i == 8 || i == 13 || i == 18 || i == 23;
        if hyphen != (c == '-') || !hyphen && !c.is_hexdigit() {
            return false;
        }
        i += 1;
    }
    return true;
}
