//! Jade — JSON Schema (Draft 2020-12) for Wado: the schema model, and the
//! schema of a Wado type derived from its reflection. See
//! `docs/wep-2026-06-13-jade.md`.

use { Serialize, SerializeError, SerializeMap, Serializer, wire_name } from "core:serde";
use { Value, to_value } from "core:value";
use { TreeMap, TreeSet } from "core:collections";

/// A JSON Schema document, one field per keyword. A keyword that is `null`,
/// empty or `false` is left out of the output.
pub struct Schema {
    /// `$schema`
    pub dialect: Option<String> = null,
    /// `$ref`
    pub reference: Option<String> = null,
    pub title: Option<String> = null,
    pub description: Option<String> = null,
    pub type: Option<String> = null,
    pub format: Option<String> = null,
    pub content_encoding: Option<String> = null,
    pub const_: Option<Value> = null,
    pub enum_: List<Value> = [],
    pub any_of: List<Schema> = [],
    pub one_of: List<Schema> = [],
    pub minimum: Option<f64> = null,
    pub maximum: Option<f64> = null,
    pub min_length: Option<i32> = null,
    pub max_length: Option<i32> = null,
    pub pattern: Option<String> = null,
    pub items: Option<Schema> = null,
    pub prefix_items: List<Schema> = [],
    pub min_items: Option<i32> = null,
    pub max_items: Option<i32> = null,
    pub unique_items: bool = false,
    pub properties: TreeMap<String, Schema> = TreeMap::new(),
    pub required: List<String> = [],
    pub additional_properties: Option<Schema> = null,
    pub max_properties: Option<i32> = null,
    pub default_: Option<Value> = null,
    /// `$defs`
    pub defs: TreeMap<String, Schema> = TreeMap::new(),
}

impl Schema {
    /// The `$schema` dialect Jade emits.
    pub const DRAFT: String = "https://json-schema.org/draft/2020-12/schema";

    /// A schema admitting one JSON type: `"object"`, `"string"` and so on.
    pub fn of_type<S: AsStrSlice>(name: S) -> Schema {
        return Schema { type: Option::Some(name.to_string()) };
    }

    /// A schema admitting the single value `value`.
    pub fn constant(value: Value) -> Schema {
        return Schema { const_: Option::Some(value) };
    }

    fn each_keyword<K: Keywords>(&self, k: &mut K) -> Result<(), SerializeError> {
        k.some("$schema", &self.dialect)?;
        k.some("$ref", &self.reference)?;
        k.some("title", &self.title)?;
        k.some("description", &self.description)?;
        k.some("type", &self.type)?;
        k.some("format", &self.format)?;
        k.some("contentEncoding", &self.content_encoding)?;
        k.some("const", &self.const_)?;
        k.list("enum", &self.enum_)?;
        k.list("anyOf", &self.any_of)?;
        k.list("oneOf", &self.one_of)?;
        k.some("minimum", &self.minimum)?;
        k.some("maximum", &self.maximum)?;
        k.some("minLength", &self.min_length)?;
        k.some("maxLength", &self.max_length)?;
        k.some("pattern", &self.pattern)?;
        k.some("items", &self.items)?;
        k.list("prefixItems", &self.prefix_items)?;
        k.some("minItems", &self.min_items)?;
        k.some("maxItems", &self.max_items)?;
        if self.unique_items {
            k.put("uniqueItems", &true)?;
        }
        if !self.properties.is_empty() {
            k.put("properties", &self.properties)?;
        }
        k.list("required", &self.required)?;
        k.some("additionalProperties", &self.additional_properties)?;
        k.some("maxProperties", &self.max_properties)?;
        k.some("default", &self.default_)?;
        if !self.defs.is_empty() {
            k.put("$defs", &self.defs)?;
        }
        return Result::Ok(());
    }
}

/// Where `Schema::each_keyword` sends each keyword it writes: once to count
/// them, as a map must know its length before its first entry, and once to
/// write them.
trait Keywords with () {
    fn put<V: Serialize>(&mut self, key: String, value: &V) -> Result<(), SerializeError>;

    fn some<V: Serialize>(&mut self, key: String, value: &Option<V>) -> Result<(), SerializeError> {
        if let Some(v) = value {
            return self.put(key, v);
        }
        return Result::Ok(());
    }

    fn list<V: Serialize>(&mut self, key: String, value: &List<V>) -> Result<(), SerializeError> {
        if value.is_empty() {
            return Result::Ok(());
        }
        return self.put(key, value);
    }
}

struct KeywordCount {
    n: i32,
}

impl Keywords for KeywordCount {
    fn put<V: Serialize>(&mut self, key: String, value: &V) -> Result<(), SerializeError> {
        self.n += 1;
        return Result::Ok(());
    }
}

struct KeywordWriter<M> {
    map: M,
}

impl<M: SerializeMap> Keywords for KeywordWriter<M> {
    fn put<V: Serialize>(&mut self, key: String, value: &V) -> Result<(), SerializeError> {
        self.map.key(&key)?;
        return self.map.value(value);
    }
}

impl Serialize for Schema {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let mut count = KeywordCount { n: 0 };
        self.each_keyword(&mut count)?;
        let mut writer = KeywordWriter { map: s.begin_map(count.n)? };
        self.each_keyword(&mut writer)?;
        return writer.map.end();
    }
}

/// A type whose JSON form a schema describes. Every value `core:json` writes
/// for the type validates against the schema, and every document that
/// validates decodes into the type.
pub trait JsonSchema with () {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema;
}

/// Collects the definitions the schemas it builds refer to. A struct, a
/// variant, an enum and a flags type are each defined once and referred to by
/// `$ref` at every use, which is also how a recursive type ends.
pub struct SchemaGenerator {
    prefix: String,
    definitions: TreeMap<String, Schema>,
}

impl SchemaGenerator {
    /// Refers to definitions under the root schema's `$defs`.
    pub fn new() -> SchemaGenerator {
        return SchemaGenerator { prefix: "#/$defs/", definitions: TreeMap::new() };
    }

    /// Refers to definitions under an OpenAPI document's `components/schemas`.
    pub fn openapi() -> SchemaGenerator {
        return SchemaGenerator { prefix: "#/components/schemas/", definitions: TreeMap::new() };
    }

    /// The definitions built so far, by name.
    pub fn definitions(&self) -> TreeMap<String, Schema> {
        return self.definitions;
    }

    /// Returns a `$ref` to the definition `name`, building it by `build` the
    /// first time. An anonymous type, named `""`, is built in place instead.
    pub fn define(&mut self, name: String, build: fn(&mut SchemaGenerator) -> Schema) -> Schema {
        if name.is_empty() {
            return build(self);
        }
        if !self.definitions.contains_key(name) {
            // In place before the build, so a recursive use refers to it.
            self.definitions[name] = Schema {};
            let body = build(self);
            self.definitions[name] = body;
        }
        return Schema { reference: Option::Some(`${self.prefix}${name}`) };
    }
}

/// The standalone schema of `T`: the `$schema` dialect, with the definitions it
/// refers to under `$defs`.
pub fn schema_for<T: JsonSchema>() -> Schema {
    let mut gen = SchemaGenerator::new();
    let mut root = T::json_schema(&mut gen);
    root.dialect = Option::Some(Schema::DRAFT);
    root.defs = gen.definitions;
    return root;
}

// ── The derivation, one blanket per reflection kind ──

impl<T: ReflectStruct<FieldTypes = [..F]>, ..F: JsonSchema + Serialize> JsonSchema for T {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return gen.define(Reflect::<T>::type_name(), |g| struct_schema::<T>(g));
    }
}

fn struct_schema<T: ReflectStruct<FieldTypes = [..F]>, ..F: JsonSchema + Serialize>(gen: &mut SchemaGenerator) -> Schema {
    let policy = Reflect::<T>::wire_name_policy();
    let mut s = Schema::of_type("object");
    for let [i, f] of ReflectStruct::<T>::members().enumerate() {
        let name = wire_name(&f, policy);
        let mut field = field_schema(&f, gen);
        if let Some(fallback) = ReflectStruct::<T>::default_slot(i)[i] {
            field.default_ = Option::Some(to_value(&fallback).expect("a field's default serializes"));
        } else {
            s.required.push(name);
        }
        s.properties[name] = field;
    }
    return s;
}

fn field_schema<T, F: JsonSchema>(f: &StructField<T, F>, gen: &mut SchemaGenerator) -> Schema {
    return F::json_schema(gen);
}

impl<V: ReflectVariant<CasePayloads = [..P]>, ..P: JsonSchema> JsonSchema for V {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return gen.define(Reflect::<V>::type_name(), |g| variant_schema::<V>(g));
    }
}

fn variant_schema<V: ReflectVariant<CasePayloads = [..P]>, ..P: JsonSchema>(gen: &mut SchemaGenerator) -> Schema {
    let policy = Reflect::<V>::wire_name_policy();
    let tag = ReflectVariant::<V>::wire_tag();
    let mut s = Schema {};
    for let case of ReflectVariant::<V>::members() {
        s.one_of.push(case_schema(&case, wire_name(&case, policy), &tag, gen));
    }
    return s;
}

/// A case as the derived `Serialize` writes it: untagged, a unit case is its
/// name and a payload case an object holding the payload under the name;
/// under `#[wire(tag)]`, an object whose `tag` property holds the name, beside
/// the payload struct's fields.
fn case_schema<V, P: JsonSchema>(
    case: &VariantCase<V, P>,
    name: String,
    tag: &Option<String>,
    gen: &mut SchemaGenerator,
) -> Schema {
    if let Some(tag) = tag {
        let mut s = if case.is_unit() { Schema::of_type("object") } else { P::json_schema(gen) };
        s.properties[*tag] = Schema::constant(Value::String(name));
        s.required.push(*tag);
        return s;
    }
    if case.is_unit() {
        return Schema::constant(Value::String(name));
    }
    return one_property(name, P::json_schema(gen));
}

/// An object holding `value` under `name` and nothing else, as `core:json`
/// writes a payload case.
fn one_property(name: String, value: Schema) -> Schema {
    let mut s = Schema::of_type("object");
    s.properties[name] = value;
    s.required.push(name);
    s.max_properties = Option::Some(1);
    return s;
}

impl<E: ReflectEnum<Members = [..M]>, ..M> JsonSchema for E {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return gen.define(Reflect::<E>::type_name(), |g| enum_schema::<E>());
    }
}

fn enum_schema<E: ReflectEnum<Members = [..M]>, ..M>() -> Schema {
    let policy = Reflect::<E>::wire_name_policy();
    let mut s = Schema::of_type("string");
    for let case of ReflectEnum::<E>::members() {
        s.enum_.push(Value::String(wire_name(&case, policy)));
    }
    return s;
}

impl<L: ReflectFlags<Members = [..M]>, ..M> JsonSchema for L {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return gen.define(Reflect::<L>::type_name(), |g| flags_schema::<L>());
    }
}

fn flags_schema<L: ReflectFlags<Members = [..M]>, ..M>() -> Schema {
    let policy = Reflect::<L>::wire_name_policy();
    let mut member = Schema::of_type("string");
    for let bit of ReflectFlags::<L>::members() {
        member.enum_.push(Value::String(wire_name(&bit, policy)));
    }
    let mut s = Schema::of_type("array");
    s.items = Option::Some(member);
    s.unique_items = true;
    return s;
}

// ── The leaves ──

impl JsonSchema for bool {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return Schema::of_type("boolean");
    }
}

fn integer(minimum: f64, maximum: f64) -> Schema {
    let mut s = Schema::of_type("integer");
    s.minimum = Option::Some(minimum);
    s.maximum = Option::Some(maximum);
    return s;
}

impl JsonSchema for i8 {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return integer(i8::MIN as f64, i8::MAX as f64);
    }
}

impl JsonSchema for i16 {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return integer(i16::MIN as f64, i16::MAX as f64);
    }
}

impl JsonSchema for i32 {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return integer(i32::MIN as f64, i32::MAX as f64);
    }
}

impl JsonSchema for u8 {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return integer(0.0, u8::MAX as f64);
    }
}

impl JsonSchema for u16 {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return integer(0.0, u16::MAX as f64);
    }
}

impl JsonSchema for u32 {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return integer(0.0, u32::MAX as f64);
    }
}

// `core:json` writes a 64-bit integer as a number within ±(2^53 − 1), where a
// double holds it exactly, and as a decimal string beyond.

impl JsonSchema for i64 {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return Schema {
            any_of: [
                integer(f64::MIN_SAFE_INTEGER, f64::MAX_SAFE_INTEGER),
                signed_decimal(`${i64::MAX}`),
            ],
        };
    }
}

impl JsonSchema for u64 {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return Schema {
            any_of: [integer(0.0, f64::MAX_SAFE_INTEGER), unsigned_decimal(`${u64::MAX}`)],
        };
    }
}

impl JsonSchema for i128 {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return signed_decimal(`${i128::MAX}`);
    }
}

impl JsonSchema for u128 {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return unsigned_decimal(`${u128::MAX}`);
    }
}

fn decimal_string(pattern: String) -> Schema {
    let mut s = Schema::of_type("string");
    s.pattern = Option::Some(pattern);
    return s;
}

/// A decimal string in `0..=max`, spelled as `core:json` spells it.
fn unsigned_decimal(max: String) -> Schema {
    return decimal_string(`^(0|${one_to(max)})$`);
}

/// A decimal string in `-max - 1..=max`, spelled as `core:json` spells it.
fn signed_decimal(max: String) -> Schema {
    // A two's complement range ends one further below zero than above it, and
    // that one bound's last digit is never 9, so incrementing it carries nothing.
    let last = max.len() - 1;
    let below = `${max.substr_bytes(0, last)}${(max.byte_at(last) + 1) as char}`;
    return decimal_string(`^(0|-?${one_to(max)}|-${below})$`);
}

/// A regular expression, as a group, matching the decimal integers in
/// `1..=max` without leading zeros.
fn one_to(max: String) -> String {
    let n = max.len();
    let mut alternatives: List<String> = [];
    if n > 1 {
        alternatives.push(`[1-9]${any_digits(0, n - 2)}`);
    }
    // A number of `max`'s length is below it where it first falls below
    // `max`'s digit, after a prefix it shares.
    for let i of 0..<n {
        let lowest = if i == 0 { b'1' } else { b'0' };
        let digit = max.byte_at(i);
        if digit > lowest {
            let rest = any_digits(n - i - 1, n - i - 1);
            alternatives.push(`${max.substr_bytes(0, i)}${digit_class(lowest, digit - 1)}${rest}`);
        }
    }
    alternatives.push(max);
    return `(${alternatives.join("|")})`;
}

/// From `min` to `max` digits, written as briefly as the count allows.
fn any_digits(min: i32, max: i32) -> String {
    if max == 0 {
        return "";
    }
    if max == 1 {
        return if min == 1 { "[0-9]" } else { "[0-9]?" };
    }
    if min == max {
        return `[0-9]{${max}}`;
    }
    return `[0-9]{${min},${max}}`;
}

test "one_to matches exactly the numbers up to max" {
    assert one_to("9") == "([1-8]|9)";
    assert one_to("10") == "([1-9]|10)";
    assert one_to("255") == "([1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-4]|255)";
    assert one_to("3000") == "([1-9][0-9]{0,2}|[1-2][0-9]{3}|3000)";
}

fn digit_class(low: u8, high: u8) -> String {
    if low == high {
        return `${low as char}`;
    }
    return `[${low as char}-${high as char}]`;
}

impl JsonSchema for f32 {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return Schema::of_type("number");
    }
}

impl JsonSchema for f64 {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return Schema::of_type("number");
    }
}

impl JsonSchema for f16 {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return Schema::of_type("number");
    }
}

impl JsonSchema for bf16 {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return Schema::of_type("number");
    }
}

impl JsonSchema for char {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        let mut s = Schema::of_type("string");
        s.min_length = Option::Some(1);
        s.max_length = Option::Some(1);
        return s;
    }
}

impl JsonSchema for String {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return Schema::of_type("string");
    }
}

fn base64url() -> Schema {
    let mut s = Schema::of_type("string");
    s.content_encoding = Option::Some("base64url");
    return s;
}

impl JsonSchema for ByteList {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return base64url();
    }
}

impl JsonSchema for ByteArray {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return base64url();
    }
}

impl JsonSchema for ByteSlice {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return base64url();
    }
}

impl JsonSchema for () {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return Schema::of_type("null");
    }
}

// `anyOf` rather than `oneOf`: in `Option<Option<T>>` both branches accept null.
impl<T: JsonSchema> JsonSchema for Option<T> {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return Schema { any_of: [T::json_schema(gen), Schema::of_type("null")] };
    }
}

impl<T: JsonSchema, E: JsonSchema> JsonSchema for Result<T, E> {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        return Schema {
            one_of: [one_property("Ok", T::json_schema(gen)), one_property("Err", E::json_schema(gen))],
        };
    }
}

impl<T: JsonSchema> JsonSchema for List<T> {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        let mut s = Schema::of_type("array");
        s.items = Option::Some(T::json_schema(gen));
        return s;
    }
}

impl<T: Ord + JsonSchema> JsonSchema for TreeSet<T> {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        let mut s = Schema::of_type("array");
        s.items = Option::Some(T::json_schema(gen));
        s.unique_items = true;
        return s;
    }
}

impl<V: JsonSchema> JsonSchema for TreeMap<String, V> {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        let mut s = Schema::of_type("object");
        s.additional_properties = Option::Some(V::json_schema(gen));
        return s;
    }
}

impl<..T: JsonSchema> JsonSchema for [..T] {
    fn json_schema(gen: &mut SchemaGenerator) -> Schema {
        let mut s = Schema::of_type("array");
        for let item of [..T::json_schema(gen)] {
            s.prefix_items.push(item);
        }
        let arity = s.prefix_items.len();
        s.min_items = Option::Some(arity);
        s.max_items = Option::Some(arity);
        return s;
    }
}
