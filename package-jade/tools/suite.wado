//! Writes `tests/generated/<file>_test.wado` for each file of the JSON Schema
//! Test Suite's Draft 2020-12 tests: each test held to the validity the suite
//! gives it. A case that refers to a schema outside its own document is left
//! out, as is every case of a file that needs one, since a remote `$ref` is
//! resolved only through a loader the caller passes. The suite is read as data.
//!
//! Run from the repository root, with vendor/JSON-Schema-Test-Suite checked
//! out: `mise run suite-jade`.

use { println, Stdout } from "core:cli";
use fs from "core:fs";
use { Preopens } from "core:fs";
use { HashSet } from "core:collections";
use { to_string } from "core:json";
use { Uri } from "core:uri";
use { Document, Node } from "../src/lib.wado";

global SUITE: String = "vendor/JSON-Schema-Test-Suite/tests/draft2020-12";
global OUT: String = "package-jade/tests/generated";

/// The files left out whole, and why.
global SKIPPED_FILES: List<[String, String]> = [
    ["refRemote.json", "every case refers to a remote schema"],
    ["vocabulary.json", "every case names a remote meta-schema in `$schema`"],
];

/// The base URI of a schema that declares no `$id`.
global ROOT_BASE: String = "jade:root";

/// The keywords whose value is an instance rather than a schema, so an `$id`
/// or a `$ref` inside one is data.
global VALUE_KEYWORDS: List<String> = ["const", "enum", "default", "examples"];

export fn run() with (Stdout, Preopens) {
    fs::remove_dir_all(&OUT).unwrap();
    fs::create_dir_all(&OUT).unwrap();
    let mut files: List<String> = [];
    for let entry of fs::read_dir(&SUITE).unwrap() {
        if fs::extension(&entry.name) matches { Some("json") } {
            files.push(entry.name);
        }
    }
    files.sort();
    for let file of files {
        if let Some(why) = skip_reason(&file) {
            println(`left out ${file}: ${why}`);
            continue;
        }
        let text = fs::read_to_string(fs::join(&SUITE, &file)).unwrap();
        let doc = Document::parse(text).unwrap();
        let stem = fs::file_stem(&file).unwrap().to_string().replace("-", "_");
        fs::write(fs::join(&OUT, `${stem}_test.wado`), &test_file(&file, &doc.root())).unwrap();
    }
}

fn skip_reason(file: &String) -> Option<String> {
    for let [name, why] of SKIPPED_FILES {
        if name == *file {
            return Option::Some(why);
        }
    }
    return null;
}

/// The test file for the suite file `file`, whose cases `cases` holds.
fn test_file(file: &String, cases: &Node) -> String {
    let mut out = `// Generated by package-jade/tools/suite.wado from
// vendor/JSON-Schema-Test-Suite/tests/draft2020-12/${*file}. Regenerate with
// \`mise run suite-jade\`; do not edit.
`;
    let mut skipped: List<String> = [];
    let mut tests = "";
    let mut names = HashSet::<String>::new();
    for let c of cases.items() {
        let description = c.get("description").unwrap().as_str().unwrap();
        let schema = c.get("schema").unwrap();
        let remote = outside(&schema);
        if !remote.is_empty() {
            skipped.push(`//   ${description}: refers to ${remote.join(", ")}`);
            continue;
        }
        let schema_text = to_string(&schema).unwrap();
        for let t of c.get("tests").unwrap().items() {
            let base = `${description}: ${t.get("description").unwrap().as_str().unwrap()}`;
            let mut name = base;
            for let mut n = 2; !names.insert(name); n += 1 {
                name = `${base} (${n})`;
            }
            let data = to_string(&t.get("data").unwrap()).unwrap();
            let valid = t.get("valid").unwrap().as_bool().unwrap();
            tests.push_str(`
test ${to_string(&name).unwrap()} {
    check(
        ${raw(&schema_text)},
        ${raw(&data)},
        ${valid},
    );
}
`);
        }
    }
    if !skipped.is_empty() {
        out.push_str("//\n// Left out, as a remote `$ref` needs a loader:\n");
        out.push_str(skipped.join("\n"));
        out.push_str("\n");
    }
    out.push_str(`
use { check } from "../suite.wado";
`);
    out.push_str(tests);
    return out;
}

/// `text` as a Wado raw string. `core:json` escapes every control character,
/// so none is left for the raw string to carry unseen.
fn raw(text: &String) -> String {
    let mut hashes = "#";
    while text.contains(`"${hashes}`) {
        hashes.push_str("#");
    }
    return `${hashes}"${*text}"${hashes}`;
}

/// The `$ref` and `$dynamicRef` targets of `schema` that no `$id` in it names.
fn outside(schema: &Node) -> List<String> {
    let root = Uri::from_str(&ROOT_BASE).unwrap();
    let mut ids = HashSet::<Uri>::new();
    ids.insert(root);
    let mut refs: List<Uri> = [];
    collect(schema, &root, &mut ids, &mut refs);
    let mut out: List<String> = [];
    for let r of refs {
        if !ids.contains(r.without_fragment()) {
            out.push(r.to_string());
        }
    }
    return out;
}

fn collect(s: &Node, base: &Uri, ids: &mut HashSet<Uri>, refs: &mut List<Uri>) {
    match s.kind() {
        Array => {
            for let item of s.items() {
                collect(&item, base, ids, refs);
            }
        },
        Object => {
            let mut here = *base;
            if let Some(id) = s.get("$id") && let Some(id) = id.as_str() {
                here = base.resolve(&Uri::from_str(id).unwrap());
                ids.insert(here.without_fragment());
            }
            for let keyword of ["$ref", "$dynamicRef"] as List<String> {
                if let Some(r) = s.get(keyword) && let Some(r) = r.as_str() {
                    refs.push(here.resolve(&Uri::from_str(r).unwrap()));
                }
            }
            for let [k, v] of s.entries() {
                if !VALUE_KEYWORDS.contains_str(k) {
                    collect(&v, &here, ids, refs);
                }
            }
        },
        Null | Bool | Number | String => {
        },
    }
}
