//! Writes `tests/generated/<file>_test.wado` for each file of the JSON Schema
//! Test Suite's Draft 2020-12 tests and of those directly under `optional/`:
//! each test held to the validity the suite gives it. The suite serves the
//! documents a schema refers to from `remotes/` at `http://localhost:1234/`.
//! The ones a test loads are copied to `tests/generated/remotes/`, and the
//! test embeds them, so its result depends on nothing it reads at run time. A
//! case that refers to any other document is left out. The suite is read as
//! data.
//!
//! Run from the repository root, with vendor/JSON-Schema-Test-Suite checked
//! out: `mise run suite-jade`.

use { println, Stdout } from "core:cli";
use fs from "core:fs";
use { Preopens } from "core:fs";
use { HashSet } from "core:collections";
use { to_string } from "core:json";
use { Uri } from "core:uri";
use { Document, Node, Schema, SchemaSet } from "../src/lib.wado";
use { DEFAULT_BASE } from "../src/validate.wado";

global SUITE: String = "vendor/JSON-Schema-Test-Suite/tests/draft2020-12";
global REMOTES: String = "vendor/JSON-Schema-Test-Suite/remotes";
global REMOTE_BASE: String = "http://localhost:1234/";
global OUT: String = "package-jade/tests/generated";
global OUT_REMOTES: String = "package-jade/tests/generated/remotes";

/// The files left out whole, and why.
global SKIPPED_FILES: List<[String, String]> = [
    ["vocabulary.json", "every case names a meta-schema of its own in `$schema`"],
    ["optional/format-assertion.json", "every case names a meta-schema of its own in `$schema`"],
    [
        "optional/dependencies-compatibility.json",
        "Draft 2020-12 replaces `dependencies` with `dependentRequired` and `dependentSchemas`",
    ],
    [
        "optional/refOfUnknownKeyword.json",
        "Draft 2020-12 leaves a reference into an unknown keyword undefined (Core 9.4.2)",
    ],
];

/// The files of `optional/format/` whose format Jade does not assert yet.
global UNASSERTED_FORMATS: List<String> = [
    "ecmascript-regex", "email", "hostname", "idn-email", "idn-hostname", "ipv4", "ipv6", "json-pointer", "regex",
    "relative-json-pointer", "uri-template",
];

/// Where the files whose tests compile with `format` asserting lie.
global FORMAT_DIR: String = "optional/format";

export fn run() with (Stdout, Preopens) {
    // Read before removing, so a missing suite leaves the generated tests.
    let mut files = json_files("");
    files.extend(&json_files("optional"));
    files.extend(&json_files(FORMAT_DIR));
    fs::remove_dir_all(&OUT).unwrap();
    fs::create_dir_all(&OUT).unwrap();
    let mut copied = HashSet::<String>::new();
    for let file of files {
        if let Some(why) = skip_reason(&file) {
            println(`left out ${file}: ${why}`);
            continue;
        }
        let text = fs::read_to_string(fs::join(&SUITE, &file)).unwrap();
        let doc = Document::parse(text).unwrap();
        let stem = fs::file_stem(&file.replace("/", "_")).unwrap().to_string().replace("-", "_");
        fs::write(fs::join(&OUT, `${stem}_test.wado`), &test_file(&file, &doc.root(), &mut copied)).unwrap();
    }
}

/// The suite's JSON files directly under `dir`, as paths from the suite, sorted.
fn json_files(dir: String) -> List<String> with Preopens {
    let mut files: List<String> = [];
    for let entry of fs::read_dir(fs::join(&SUITE, &dir)).unwrap() {
        if fs::extension(&entry.name) matches { Some("json") } {
            files.push(fs::join(&dir, &entry.name));
        }
    }
    files.sort();
    return files;
}

fn skip_reason(file: &String) -> Option<String> {
    for let [name, why] of SKIPPED_FILES {
        if name == *file {
            return Option::Some(why);
        }
    }
    for let name of UNASSERTED_FORMATS {
        if *file == fs::join(&FORMAT_DIR, `${name}.json`) {
            return Option::Some("Jade does not assert this format yet");
        }
    }
    return null;
}

/// The test file for the suite file `file`, whose cases `cases` holds. The
/// remotes its tests embed are copied unless `copied` holds their paths.
fn test_file(file: &String, cases: &Node, copied: &mut HashSet<String>) -> String with Preopens {
    let mut out = `// Generated by package-jade/tools/suite.wado from
// vendor/JSON-Schema-Test-Suite/tests/draft2020-12/${*file}. Regenerate with
// \`mise run suite-jade\`; do not edit.
`;
    let harness = if file.starts_with(`${FORMAT_DIR}/`) { "check_format" } else { "check" };
    let mut skipped: List<String> = [];
    let mut tests = "";
    let mut names = HashSet::<String>::new();
    let mut embedded: List<String> = [];
    for let c of cases.items() {
        let description = c.get("description").unwrap().as_str().unwrap();
        let schema = c.get("schema").unwrap();
        let schema_text = json(&schema);
        let remotes = match remotes_of(&schema_text) {
            Ok(r) => r,
            Err(why) => {
                skipped.push(`//   ${description}: ${why}`);
                continue;
            },
        };
        for let [path, text] of remotes {
            if !embedded.contains_str(&path) {
                embedded.push(path);
            }
            if copied.insert(path) {
                let to = fs::join(&OUT_REMOTES, &path);
                fs::create_dir_all(fs::parent(&to).unwrap()).unwrap();
                fs::write(&to, &text).unwrap();
            }
        }
        let remotes_arg = if remotes.is_empty() { "" } else { "\n        &REMOTES," };
        for let t of c.get("tests").unwrap().items() {
            let base = `${description}: ${t.get("description").unwrap().as_str().unwrap()}`;
            let mut name = base;
            for let mut n = 2; !names.insert(name); n += 1 {
                name = `${base} (${n})`;
            }
            let data = json(&t.get("data").unwrap());
            let valid = t.get("valid").unwrap().as_bool().unwrap();
            tests.push_str(`
test ${to_string(&name).unwrap()} {
    ${harness}(
        ${raw(&schema_text)},
        ${raw(&data)},
        ${valid},${remotes_arg}
    );
}
`);
        }
    }
    if !skipped.is_empty() {
        out.push_str("//\n// Left out:\n");
        out.push_str(skipped.join("\n"));
        out.push_str("\n");
    }
    if !tests.is_empty() {
        out.push_str(`
use { ${harness} } from "../suite.wado";
`);
        if !embedded.is_empty() {
            out.push_str("\nglobal REMOTES: List<[String, String]> = [\n");
            for let path of embedded {
                let uri = to_string(&`${REMOTE_BASE}${path}`).unwrap();
                let include = to_string(&`./remotes/${path}`).unwrap();
                out.push_str(`    [${uri}, #include_str(${include})],\n`);
            }
            out.push_str("];\n");
        }
        out.push_str(tests);
    }
    return out;
}

/// `node` as JSON text, its numbers exact: `core:json` writes only those an
/// f64 holds.
fn json(node: &Node) -> String {
    return match node.kind() {
        Number => {
            let n = node.as_number().unwrap();
            if n.is_f64() {
                to_string(&n).unwrap();
            } else {
                `${n}`;
            }
        },
        Array => {
            let items: List<String> = node.items().map(|v| json(&v)).collect();
            `[${items.join(",")}]`;
        },
        Object => {
            let members: List<String> = node.entries().map(|m| `${to_string(&m.0).unwrap()}:${json(&m.1)}`).collect();
            `{${members.join(",")}}`;
        },
        Null | Bool | String => to_string(node).unwrap(),
    };
}

/// `text` as a Wado raw string. `core:json` escapes every control character,
/// so none is left for the raw string to carry unseen.
fn raw(text: &String) -> String {
    let mut hashes = "#";
    while text.contains(`"${hashes}`) {
        hashes.push_str("#");
    }
    return `${hashes}"${*text}"${hashes}`;
}

/// The documents the schema `text` refers to, each as its path under
/// `remotes/` and its text, as the suite serves them. Err holds why one cannot
/// be.
fn remotes_of(text: &String) -> Result<List<[String, String]>, String> with Preopens {
    // A schema Jade rejects is left to its test to report.
    let Ok(root) = Schema::parse(text) else {
        return Result::Ok([]);
    };
    let base = Uri::from_str(&DEFAULT_BASE).unwrap();
    let mut set = SchemaSet::new();
    set.insert(base, root);
    let mut remotes: List<[String, String]> = [];
    let loaded = set.load(&base, |u| {
        let unserved = `refers to ${*u}, which the suite does not serve`;
        let Some(under) = `${*u}`.strip_prefix(&REMOTE_BASE) else {
            return Result::<Schema, String>::Err(unserved);
        };
        let path = under.to_string();
        let Ok(served) = fs::read_to_string(fs::join(&REMOTES, &path)) else {
            return Result::Err(unserved);
        };
        let Ok(schema) = Schema::parse(served) else {
            return Result::Err(`refers to ${*u}, which is no Draft 2020-12 schema`);
        };
        remotes.push([path, served]);
        return Result::Ok(schema);
    });
    return match loaded {
        Err(Failed(f)) => Result::Err(f.error),
        Ok(_) | Err(Invalid(_)) => Result::Ok(remotes),
    };
}
