//! Writes `tests/generated/<file>_test.wado` for each file of the JSON Schema
//! Test Suite's Draft 2020-12 tests, and for the optional ones Jade implements:
//! each test held to the validity the suite gives it, with the remote
//! documents its schema refers to. The suite serves those from `remotes/` at
//! `http://localhost:1234/`; a case that refers to any other document is left
//! out. The suite is read as data.
//!
//! Run from the repository root, with vendor/JSON-Schema-Test-Suite checked
//! out: `mise run suite-jade`.

use { println, Stdout } from "core:cli";
use fs from "core:fs";
use { Preopens } from "core:fs";
use { HashSet } from "core:collections";
use { to_string } from "core:json";
use { Uri } from "core:uri";
use { Document, Node, Schema, SchemaSet } from "../src/lib.wado";
use { DEFAULT_BASE } from "../src/validate.wado";

global SUITE: String = "vendor/JSON-Schema-Test-Suite/tests/draft2020-12";
global REMOTES: String = "vendor/JSON-Schema-Test-Suite/remotes";
global REMOTE_BASE: String = "http://localhost:1234/";
global OUT: String = "package-jade/tests/generated";

/// The files left out whole, and why.
global SKIPPED_FILES: List<[String, String]> = [
    ["vocabulary.json", "every case names a meta-schema of its own in `$schema`"],
];

/// The files of `optional/` whose behaviour Jade implements.
global OPTIONAL_FILES: List<String> = ["optional/bignum.json", "optional/float-overflow.json"];

export fn run() with (Stdout, Preopens) {
    // Read before removing, so a missing suite leaves the generated tests.
    let entries = fs::read_dir(&SUITE).unwrap();
    fs::remove_dir_all(&OUT).unwrap();
    fs::create_dir_all(&OUT).unwrap();
    let mut files: List<String> = [];
    for let entry of entries {
        if fs::extension(&entry.name) matches { Some("json") } {
            files.push(entry.name);
        }
    }
    files.sort();
    files.extend(&OPTIONAL_FILES);
    for let file of files {
        if let Some(why) = skip_reason(&file) {
            println(`left out ${file}: ${why}`);
            continue;
        }
        let text = fs::read_to_string(fs::join(&SUITE, &file)).unwrap();
        let doc = Document::parse(text).unwrap();
        let stem = fs::file_stem(&file.replace("/", "_")).unwrap().to_string().replace("-", "_");
        fs::write(fs::join(&OUT, `${stem}_test.wado`), &test_file(&file, &doc.root())).unwrap();
    }
}

fn skip_reason(file: &String) -> Option<String> {
    for let [name, why] of SKIPPED_FILES {
        if name == *file {
            return Option::Some(why);
        }
    }
    return null;
}

/// The test file for the suite file `file`, whose cases `cases` holds.
fn test_file(file: &String, cases: &Node) -> String with Preopens {
    let mut out = `// Generated by package-jade/tools/suite.wado from
// vendor/JSON-Schema-Test-Suite/tests/draft2020-12/${*file}. Regenerate with
// \`mise run suite-jade\`; do not edit.
`;
    let mut skipped: List<String> = [];
    let mut tests = "";
    let mut names = HashSet::<String>::new();
    for let c of cases.items() {
        let description = c.get("description").unwrap().as_str().unwrap();
        let schema = c.get("schema").unwrap();
        let schema_text = json(&schema);
        let remotes = match remotes_of(&schema_text) {
            Ok(r) => r,
            Err(why) => {
                skipped.push(`//   ${description}: ${why}`);
                continue;
            },
        };
        let remote_list = remotes.iter_ref().map(|r| `[${raw(&r.0)}, ${raw(&r.1)}]`).collect().join(", ");
        for let t of c.get("tests").unwrap().items() {
            let base = `${description}: ${t.get("description").unwrap().as_str().unwrap()}`;
            let mut name = base;
            for let mut n = 2; !names.insert(name); n += 1 {
                name = `${base} (${n})`;
            }
            let data = json(&t.get("data").unwrap());
            let valid = t.get("valid").unwrap().as_bool().unwrap();
            tests.push_str(`
test ${to_string(&name).unwrap()} {
    check(
        ${raw(&schema_text)},
        ${raw(&data)},
        ${valid},
        [${remote_list}],
    );
}
`);
        }
    }
    if !skipped.is_empty() {
        out.push_str("//\n// Left out:\n");
        out.push_str(skipped.join("\n"));
        out.push_str("\n");
    }
    if !tests.is_empty() {
        out.push_str(`
use { check } from "../suite.wado";
`);
        out.push_str(tests);
    }
    return out;
}

/// `node` as JSON text, its numbers exact: `core:json` writes only those an
/// f64 holds.
fn json(node: &Node) -> String {
    return match node.kind() {
        Number => {
            let n = node.as_number().unwrap();
            if n.is_f64() {
                to_string(&n).unwrap();
            } else {
                `${n}`;
            }
        },
        Array => {
            let items: List<String> = node.items().map(|v| json(&v)).collect();
            `[${items.join(",")}]`;
        },
        Object => {
            let members: List<String> = node.entries().map(|m| `${to_string(&m.0).unwrap()}:${json(&m.1)}`).collect();
            `{${members.join(",")}}`;
        },
        Null | Bool | String => to_string(node).unwrap(),
    };
}

/// `text` as a Wado raw string. `core:json` escapes every control character,
/// so none is left for the raw string to carry unseen.
fn raw(text: &String) -> String {
    let mut hashes = "#";
    while text.contains(`"${hashes}`) {
        hashes.push_str("#");
    }
    return `${hashes}"${*text}"${hashes}`;
}

/// The documents the schema `text` refers to, each as its URI and its JSON
/// text, read from `remotes/` as the suite serves them. Err holds why one
/// cannot be.
fn remotes_of(text: &String) -> Result<List<[String, String]>, String> with Preopens {
    let mut remotes: List<[String, String]> = [];
    // A schema Jade rejects is left to its test to report.
    let Ok(root) = Schema::parse(text) else {
        return Result::Ok(remotes);
    };
    let mut set = SchemaSet::new();
    set.insert(Uri::from_str(&DEFAULT_BASE).unwrap(), root);
    while let Ok(Some(uri)) = set.missing() {
        let name = uri.to_string();
        let unserved = `refers to ${name}, which the suite does not serve`;
        if !name.starts_with(&REMOTE_BASE) {
            return Result::Err(unserved);
        }
        let Ok(served) = fs::read_to_string(fs::join(&REMOTES, name.substr_bytes(REMOTE_BASE.len(), name.len()))) else {
            return Result::Err(unserved);
        };
        let remote = json(&Document::parse(served).unwrap().root());
        let Ok(schema) = Schema::parse(&remote) else {
            return Result::Err(`refers to ${name}, which is no Draft 2020-12 schema`);
        };
        set.insert(uri, schema);
        remotes.push([name, remote]);
    }
    return Result::Ok(remotes);
}
