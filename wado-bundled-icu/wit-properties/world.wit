// The shippable `core:icu` stage-1 surface: Unicode character properties as
// code point ranges, with no `resource` anywhere, so a Wado program can import
// the component today. `wit/world.wit` keeps the full spike surface.
package wado:icu@0.1.0;

// Both operations take a binary property's name with `value` absent, and an
// enumerated one's with `value` present — `gc` (whose value may name a group
// such as `L`), `sc`, `bc`, `lb`, `wb`, `sb`, `gcb`, `incb`, `ea`, `hst`,
// `nt`, `insc`, `jt`, `jg`, `vo` or `ccc`. Names match as UAX #44 matches
// them, loosely.
//
// A name this build does not answer returns `none`, never an approximation: a
// caller complementing an approximate set admits real members of the property
// rather than missing some.
interface properties {
  /// Inclusive code point ranges of a property value, lowest first.
  ranges: func(property: string, value: option<string>) -> option<list<tuple<u32, u32>>>;

  /// Whether `ch` has that property value, without building the ranges.
  contains: func(property: string, value: option<string>, ch: char) -> option<bool>;
}

world icu-properties {
  export properties;
}
