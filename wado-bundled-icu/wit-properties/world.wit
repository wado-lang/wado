// The shippable `core:icu` surface: Unicode character properties as code point
// ranges, collation, case mapping and grapheme segmentation. `wit/world.wit`
// keeps the full spike surface. The `properties` interface is generated, into
// `properties.wit`.
//
// A locale crosses as its subtags, never as a tag to parse: each is its ASCII
// bytes in a `u32`, first byte lowest, and an absent one is 0. `core:icu` has
// already checked the tag, so a subtag ICU4X refuses traps.
package wado:icu@0.1.0;

// Comparing strings the way a locale sorts them.
interface collation {
  enum ordering {
    less,
    equal,
    greater,
  }

  resource collator {
    /// A collator for the locale. One CLDR tailors nothing for sorts as its
    /// fallback does, ending at the root collation.
    create: static func(language: u32, script: u32, region: u32) -> collator;

    /// How `left` sorts against `right`.
    compare: func(left: string, right: string) -> ordering;
  }
}

// Case mapping. In the full mappings only the language selects a tailoring
// (`tr`, `az`, `lt`, `el`, `nl`, `hy`), so it is the one subtag that crosses.
interface casemap {
  uppercase: func(text: string, language: u32) -> string;
  lowercase: func(text: string, language: u32) -> string;
  /// Full case folding, for caseless matching. `tr` and `az` fold `I` to
  /// dotless `ı` and `İ` to `i`, as Turkic does.
  fold: func(text: string, language: u32) -> string;
  /// Whether the two fold to the same text.
  eq-ignore-case: func(left: string, right: string, language: u32) -> bool;

  /// The UCD's simple mappings, one character to one. No locale tailors them.
  simple-lowercase: func(ch: char) -> char;
  simple-uppercase: func(ch: char) -> char;
  simple-titlecase: func(ch: char) -> char;
  /// `Simple_Case_Folding`: the `C` and `S` entries of `CaseFolding.txt`.
  simple-fold: func(ch: char) -> char;
  /// Every code point whose simple folding equals that of one in `ranges`,
  /// as inclusive ranges, lowest first, none touching. `ranges` may come in
  /// any order, overlap or touch.
  simple-fold-closure: func(ranges: list<tuple<u32, u32>>) -> list<tuple<u32, u32>>;
}

// Extended grapheme clusters (UAX #29), which no locale tailors.
interface segmenter {
  /// The byte offset where each cluster ends, in order.
  grapheme-ends: func(text: string) -> list<u32>;
  grapheme-count: func(text: string) -> u32;
}

world icu-properties {
  export properties;
  export collation;
  export casemap;
  export segmenter;
}
