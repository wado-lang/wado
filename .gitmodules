[submodule "vendor/wasm"]
	path = vendor/wasm
	url = https://github.com/WebAssembly/spec.git
	shallow = true
[submodule "vendor/wasi"]
	path = vendor/wasi
	url = https://github.com/WebAssembly/WASI.git
	shallow = true
[submodule "vendor/wasmtime"]
	path = vendor/wasmtime
	url = https://github.com/bytecodealliance/wasmtime.git
	shallow = true
[submodule "vendor/wasm-tools"]
	path = vendor/wasm-tools
	url = https://github.com/bytecodealliance/wasm-tools.git
	shallow = true
[submodule "vendor/component-model"]
	path = vendor/component-model
	url = https://github.com/WebAssembly/component-model.git
	shallow = true
[submodule "vendor/antlr4"]
	path = vendor/antlr4
	url = https://github.com/antlr/antlr4.git
	shallow = true
[submodule "vendor/wasi-webgpu"]
	path = vendor/wasi-webgpu
	url = https://github.com/WebAssembly/wasi-webgpu.git
	shallow = true
[submodule "vendor/protobuf-spec"]
	path = vendor/protobuf-spec
	url = https://github.com/protocolbuffers/protocolbuffers.github.io.git
	shallow = true
[submodule "vendor/onnx"]
	path = vendor/onnx
	url = https://github.com/onnx/onnx.git
	shallow = true
[submodule "vendor/protobuf"]
	path = vendor/protobuf
	url = https://github.com/protocolbuffers/protobuf.git
	shallow = true
