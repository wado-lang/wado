use { Signal, flush, on_cleanup, scope, signal } from "./signals.wado";
use { each, element, text } from "./view.wado";
use { Dom, Element, SurfaceDom } from "wado-lang:web";

fn children_text(parent: Element) -> String with Dom {
    let mut out = "";
    let mut child = parent.first_child();
    while let Some(node) = child {
        out.push_str(node.text_content().unwrap());
        child = node.next_sibling();
    }
    return out;
}

test "each follows a new order with the nodes it had" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = element("ul");
        let items: Signal<List<i32>> = signal([1, 2, 3]);
        let _dispose = scope(|| each(list, || items.get(), |item: i32| text("li", `${item}`)));
        let first = list.first_child().unwrap();
        let last = list.last_child().unwrap();

        items.set([3, 1, 2]);
        flush();
        assert children_text(list) == "312";
        assert list.first_child().unwrap() == last;
        assert list.first_child().unwrap().next_sibling().unwrap() == first;
    };
}

test "each disposes of the row of an item that left" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = element("ul");
        let items: Signal<List<i32>> = signal([1, 2, 3]);
        let mut left: List<i32> = [];
        let _dispose = scope(|| each(list, || items.get(), |item: i32| {
            on_cleanup(|| left.push(item));
            return text("li", `${item}`);
        }));

        items.set([1, 3]);
        flush();
        assert children_text(list) == "13";
        assert left == [2];
    };
}

test "each gives equal items a row each" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = element("ul");
        let items: Signal<List<i32>> = signal([1, 1]);
        let _dispose = scope(|| each(list, || items.get(), |item: i32| text("li", `${item}`)));
        assert children_text(list) == "11";

        items.set([1, 1, 1]);
        flush();
        assert children_text(list) == "111";
    };
}
