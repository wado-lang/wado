//! Flags ⇄ text, derived over `ReflectFlags`.
//!
//! Two functions serve every `flags` type: the members carry each bit and its
//! boundary-facing name, and `bits` / `from_bits` cross between a value and
//! its raw bits. Neither type below declares anything, and `..M` is inferred
//! from the argument — the bound `Members = [..M]` pins it.
//!
//!     wado run example/flags_text.wado

use { println, Stdout } from "core:cli";
use { wire_name } from "core:serde";

/// The set bits joined by `|`, or `-` when none is set.
fn render<L: ReflectFlags<Members = [..M]>, ..M>(value: &L) -> String {
    let policy = ReflectFlags::<L>::wire_name_policy();
    let mut out = "";
    for let bit of ReflectFlags::<L>::members() {
        if bit.is_set(value) {
            if !out.is_empty() {
                out.push('|');
            }
            out.push_str(&wire_name(&bit, policy));
        }
    }
    if out.is_empty() {
        return "-";
    }
    return out;
}

/// The inverse. An unknown name names the type it is missing from. `L` only
/// appears in the return type, so the caller pins it with a turbofish.
fn parse<L: ReflectFlags<Members = [..M]>, ..M>(text: String) -> Result<L, String> {
    let policy = ReflectFlags::<L>::wire_name_policy();
    let mut raw: u64 = 0;
    if text != "-" {
        for let name of text.split("|") {
            let mut found = false;
            for let bit of ReflectFlags::<L>::members() {
                if wire_name(&bit, policy) == name {
                    raw = raw | bit.bit();
                    found = true;
                }
            }
            if !found {
                return Result::Err(
                    `${ReflectFlags::<L>::type_name()} has no member \`${name}\``,
                );
            }
        }
    }
    let Some(value) = ReflectFlags::<L>::from_bits(raw) else {
        return Result::Err(`unknown bits for ${ReflectFlags::<L>::type_name()}`);
    };
    return Result::Ok(value);
}

flags Perms {
    Read,
    Write,
    Execute,
}

/// The naming policy is a member fact too, so `wire_name` applies it and both
/// directions stay in step.
#[wire(name_policy = "kebab-case")]
flags Watch {
    FileCreated,
    FileDeleted,
    DirRenamed,
}

export fn run() with Stdout {
    println(render(&(Perms::Read | Perms::Write)));
    println(render(&Perms::all()));
    println(render(&Perms::none()));
    println(render(&(Watch::FileCreated | Watch::DirRenamed)));

    match parse::<Perms>("Read|Execute") {
        Ok(p) => println(`parsed: ${render(&p)}`),
        Err(e) => println(`error: ${e}`),
    }
    match parse::<Watch>("file-created|file-moved") {
        Ok(w) => println(`parsed: ${render(&w)}`),
        Err(e) => println(`error: ${e}`),
    }
}

test "render lists the set bits in declaration order" {
    assert render(&(Perms::Write | Perms::Read)) == "Read|Write";
    assert render(&Perms::all()) == "Read|Write|Execute";
    assert render(&Perms::none()) == "-";
}

test "the naming policy reaches both directions" {
    let w = Watch::FileCreated | Watch::DirRenamed;
    assert render(&w) == "file-created|dir-renamed";
    assert parse::<Watch>("file-created|dir-renamed").unwrap() == w;
}

test "every value round-trips through its text" {
    for let mut raw = 0; raw < 8; raw += 1 {
        let value = raw as Perms;
        assert parse::<Perms>(render(&value)).unwrap() == value;
    }
}

test "an unknown name names the type it is missing from" {
    let message = parse::<Perms>("Read|Fly").unwrap_err();
    assert message == "Perms has no member `Fly`";
}
