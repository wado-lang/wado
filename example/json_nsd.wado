//! JSON NSD (Non-Self-Describing) serialization and deserialization: a demo of
//! a `core:serde` format written outside the standard library.
//!
//! Structs are encoded as positional arrays (field names omitted).
//! Unit variants (enums) are encoded as integer discriminants.
//! Payload variants are encoded as `[disc, payload]`.
//!
//! Run its tests with `wado test example/json_nsd.wado`.

use {
    Serialize,
    Deserialize,
    Serializer,
    Deserializer,
    SerializeSeq,
    SerializeMap,
    SerializeStruct,
    SerializeVariant,
    DeserializeSeq,
    DeserializeMap,
    DeserializeStruct,
    DeserializeVariant,
    FieldSchema,
    SerializeError,
    DeserializeError,
    DeserializeErrorKind,
    Visitor,
    TextKeyDeserializer,
    deeper,
    DEFAULT_MAX_DEPTH,
} from "core:serde";

use { write_escaped_string, JsonDeserializer } from "core:json";
use { TreeMap } from "core:collections";

test "a struct is a positional array" {
    assert to_string(&Point { x: 1, y: 2 }) matches { Ok(s) && s == "[1,2]" };
    assert from_string::<Point>("[1,2]") matches { Ok(p) && p.x == 1 && p.y == 2 };
}

// Sub-serializers hold `&mut String` so writes flow back to the outer buffer
// the caller owns: a `String` field would be a copy of it.
pub struct NsdSeqSerializer {
    buf: &mut String,
    count: i32,
}

pub struct NsdMapSerializer {
    buf: &mut String,
    count: i32,
}

pub struct NsdStructSerializer {
    buf: &mut String,
    count: i32,
}

pub struct NsdVariantSerializer {
    buf: &mut String,
}

pub struct NsdSerializer {
    buf: &mut String,
}

impl SerializeSeq for NsdSeqSerializer {
    fn element<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.buf.push_str(",");
        }
        let mut ser = NsdSerializer { buf: self.buf };
        let r = value.serialize::<NsdSerializer>(&mut ser);
        self.count += 1;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.buf.push_str("]");
        return Result::Ok(());
    }
}

impl SerializeMap for NsdMapSerializer {
    fn key<T: Serialize>(&mut self, key: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.buf.push_str(",");
        }
        // A JSON key is a string, so any other scalar goes in as the string of
        // its spelling, which `TextKeyDeserializer` parses back.
        let mut spelled: String = "";
        key.serialize::<NsdSerializer>(&mut NsdSerializer { buf: &mut spelled })?;
        match spelled.get_byte_unchecked(0) {
            b'"' => self.buf.push_str(&spelled),
            b'[' | b'{' | b'n' => {
                return Result::Err(SerializeError::non_scalar_key());
            },
            _ => write_escaped_string(self.buf, &spelled),
        }
        self.buf.push_str(":");
        return Result::Ok(());
    }

    fn value<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        let mut ser = NsdSerializer { buf: self.buf };
        let r = value.serialize::<NsdSerializer>(&mut ser);
        self.count += 1;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.buf.push_str("}");
        return Result::Ok(());
    }
}

impl SerializeStruct for NsdStructSerializer {
    fn field<T: Serialize, S: AsStrSlice>(&mut self, name: S, value: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.buf.push_str(",");
        }
        // NSD: omit field name, write value only
        let mut ser = NsdSerializer { buf: self.buf };
        let r = value.serialize::<NsdSerializer>(&mut ser);
        self.count += 1;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.buf.push_str("]");
        return Result::Ok(());
    }
}

impl SerializeVariant for NsdVariantSerializer {
    fn payload<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        self.buf.push_str(",");
        let mut ser = NsdSerializer { buf: self.buf };
        let r = value.serialize::<NsdSerializer>(&mut ser);
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.buf.push_str("]");
        return Result::Ok(());
    }
}

impl Serializer for NsdSerializer {
    type SeqSerializer = NsdSeqSerializer;
    type MapSerializer = NsdMapSerializer;
    type StructSerializer = NsdStructSerializer;
    type VariantSerializer = NsdVariantSerializer;

    fn serialize_i32(&mut self, v: i32) -> Result<(), SerializeError> {
        self.buf.push_str(`${v}`);
        return Result::Ok(());
    }

    fn serialize_i64(&mut self, v: i64) -> Result<(), SerializeError> {
        if v > f64::MAX_SAFE_INTEGER as i64 || v < f64::MIN_SAFE_INTEGER as i64 {
            self.buf.push_str(`"${v}"`);
        } else {
            self.buf.push_str(`${v}`);
        }
        return Result::Ok(());
    }

    fn serialize_u32(&mut self, v: u32) -> Result<(), SerializeError> {
        self.buf.push_str(`${v}`);
        return Result::Ok(());
    }

    fn serialize_u64(&mut self, v: u64) -> Result<(), SerializeError> {
        if v > f64::MAX_SAFE_INTEGER as u64 {
            self.buf.push_str(`"${v}"`);
        } else {
            self.buf.push_str(`${v}`);
        }
        return Result::Ok(());
    }

    fn serialize_i128(&mut self, v: i128) -> Result<(), SerializeError> {
        self.buf.push_str(`"${v}"`);
        return Result::Ok(());
    }

    fn serialize_u128(&mut self, v: u128) -> Result<(), SerializeError> {
        self.buf.push_str(`"${v}"`);
        return Result::Ok(());
    }

    fn serialize_f32(&mut self, v: f32) -> Result<(), SerializeError> {
        return self.serialize_f64(v as f64);
    }

    fn serialize_f64(&mut self, v: f64) -> Result<(), SerializeError> {
        if v.is_nan() {
            return Result::Err(SerializeError::unsupported_value("NaN is not allowed in JSON"));
        }
        if !v.is_finite() {
            return Result::Err(SerializeError::unsupported_value("Infinity is not allowed in JSON"));
        }
        self.buf.push_str(`${v}`);
        return Result::Ok(());
    }

    fn serialize_bool(&mut self, v: bool) -> Result<(), SerializeError> {
        if v {
            self.buf.push_str("true");
        } else {
            self.buf.push_str("false");
        }
        return Result::Ok(());
    }

    fn serialize_char(&mut self, v: char) -> Result<(), SerializeError> {
        let s = `${v}`;
        write_escaped_string(self.buf, &s);
        return Result::Ok(());
    }

    fn serialize_string<S: AsStrSlice>(&mut self, v: S) -> Result<(), SerializeError> {
        write_escaped_string(self.buf, v);
        return Result::Ok(());
    }

    fn serialize_null(&mut self) -> Result<(), SerializeError> {
        self.buf.push_str("null");
        return Result::Ok(());
    }

    fn begin_seq(&mut self, len: i32) -> Result<NsdSeqSerializer, SerializeError> {
        self.buf.push_str("[");
        return Result::Ok(NsdSeqSerializer {
            buf: self.buf,
            count: 0,
        });
    }

    fn begin_map(&mut self, len: i32) -> Result<NsdMapSerializer, SerializeError> {
        self.buf.push_str("{");
        return Result::Ok(NsdMapSerializer {
            buf: self.buf,
            count: 0,
        });
    }

    fn begin_struct<S: AsStrSlice>(&mut self, name: S, fields: i32) -> Result<NsdStructSerializer, SerializeError> {
        // NSD: struct as array
        self.buf.push_str("[");
        return Result::Ok(NsdStructSerializer {
            buf: self.buf,
            count: 0,
        });
    }

    fn serialize_unit_variant<S: AsStrSlice, S1: AsStrSlice>(
        &mut self,
        type_name: S,
        variant_name: S1,
        disc: i32,
    ) -> Result<(), SerializeError> {
        // NSD: discriminant integer
        self.buf.push_str(`${disc}`);
        return Result::Ok(());
    }

    fn begin_variant<S: AsStrSlice, S1: AsStrSlice>(
        &mut self,
        type_name: S,
        variant_name: S1,
        disc: i32,
    ) -> Result<NsdVariantSerializer, SerializeError> {
        // NSD: [disc, payload]
        self.buf.push_str(`[${disc}`);
        return Result::Ok(NsdVariantSerializer {
            buf: self.buf,
        });
    }
}

pub struct NsdSeqAccess {
    de: &mut JsonDeserializer,
    depth: i32,
    first: bool,
}

pub struct NsdMapAccess {
    de: &mut JsonDeserializer,
    depth: i32,
    first: bool,
}

pub struct NsdStructAccess {
    de: &mut JsonDeserializer,
    depth: i32,
    index: i32,
    first: bool,
}

pub struct NsdVariantAccess {
    de: &mut JsonDeserializer,
    depth: i32,
    disc: i32,
    is_unit: bool,
}

fn inner_depth(de: &JsonDeserializer) -> Result<i32, DeserializeError> {
    return deeper(de.depth, de.max_depth, de.pos as i64);
}

/// The head every container entry starts with: `close` ends the container,
/// and every entry but the first is preceded by a comma this consumes.
/// Leaves `pos` on the entry's first byte; false means the container ended.
fn entry_head(de: &mut JsonDeserializer, close: i32, first: bool) -> Result<bool, DeserializeError> {
    let b = de.peek_after_whitespace();
    if b < 0 {
        return Result::Err(DeserializeError::eof(de.pos as i64));
    }
    if b == close {
        return Result::Ok(false);
    }
    if !first {
        if b != b',' {
            return Result::Err(DeserializeError::malformed(
                `expected ',' or '${close as u8 as char}'`,
                de.pos as i64,
            ));
        }
        de.advance();
    }
    return Result::Ok(true);
}

impl DeserializeSeq for NsdSeqAccess {
    fn next_element<T: Deserialize>(&mut self) -> Result<Option<T>, DeserializeError> {
        if !entry_head(self.de, b']', self.first)? {
            return Result::Ok(null);
        }
        self.first = false;
        self.de.depth = self.depth;
        let v = T::deserialize(&mut NsdDeserializer { de: self.de })?;
        return Result::Ok(Option::Some(v));
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        return self.de.expect_char(b']');
    }
}

impl DeserializeMap for NsdMapAccess {
    fn next_key<K: Deserialize>(&mut self) -> Result<Option<K>, DeserializeError> {
        if !entry_head(self.de, b'}', self.first)? {
            return Result::Ok(null);
        }
        self.first = false;
        let offset = self.de.pos as i64;
        let key = K::deserialize(&mut TextKeyDeserializer { key: self.de.read_json_string()?, offset })?;
        self.de.expect_char(b':')?;
        return Result::Ok(Option::Some(key));
    }

    fn next_value<V: Deserialize>(&mut self) -> Result<V, DeserializeError> {
        self.de.depth = self.depth;
        return V::deserialize(&mut NsdDeserializer { de: self.de });
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        return self.de.expect_char(b'}');
    }
}

impl DeserializeStruct for NsdStructAccess {
    // NSD is positional: the field schema `S` is irrelevant here. It stays in
    // the signature to satisfy the `DeserializeStruct` trait; the same generated
    // `next_field::<StructType>()` call site drives both SD and NSD formats.
    fn next_field<S: FieldSchema>(&mut self) -> Result<Option<i32>, DeserializeError> {
        if !entry_head(self.de, b']', self.first)? {
            return Result::Ok(null);
        }
        self.first = false;
        // NSD: return sequential field index
        let idx = self.index;
        self.index += 1;
        return Result::Ok(Option::Some(idx));
    }

    fn value<T: Deserialize>(&mut self) -> Result<T, DeserializeError> {
        self.de.depth = self.depth;
        return T::deserialize(&mut NsdDeserializer { de: self.de });
    }

    fn skip(&mut self) -> Result<(), DeserializeError> {
        return self.de.skip_value(self.depth);
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        return self.de.expect_char(b']');
    }
}

impl DeserializeVariant for NsdVariantAccess {
    fn variant_name(&mut self) -> Result<String, DeserializeError> {
        return Result::Err(DeserializeError {
            kind: DeserializeErrorKind::Custom,
            message: "NSD does not encode variant names",
            offset: -1,
        });
    }

    fn disc(&mut self) -> Result<i32, DeserializeError> {
        return Result::Ok(self.disc);
    }

    fn payload<T: Deserialize>(&mut self) -> Result<T, DeserializeError> {
        self.de.depth = self.depth;
        return T::deserialize(&mut NsdDeserializer { de: self.de });
    }

    fn is_unit(&mut self) -> Result<bool, DeserializeError> {
        return Result::Ok(self.is_unit);
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        if !self.is_unit {
            return self.de.expect_char(b']');
        }
        return Result::Ok(());
    }
}

pub struct NsdDeserializer {
    de: &mut JsonDeserializer,
}

impl Deserializer for NsdDeserializer {
    type SeqAccess = NsdSeqAccess;
    type MapAccess = NsdMapAccess;
    type StructAccess = NsdStructAccess;
    type VariantAccess = NsdVariantAccess;

    fn deserialize_i32(&mut self) -> Result<i32, DeserializeError> {
        return self.de.deserialize_i32();
    }

    fn deserialize_i64(&mut self) -> Result<i64, DeserializeError> {
        return self.de.deserialize_i64();
    }

    fn deserialize_u32(&mut self) -> Result<u32, DeserializeError> {
        return self.de.deserialize_u32();
    }

    fn deserialize_u64(&mut self) -> Result<u64, DeserializeError> {
        return self.de.deserialize_u64();
    }

    fn deserialize_i128(&mut self) -> Result<i128, DeserializeError> {
        return self.de.deserialize_i128();
    }

    fn deserialize_u128(&mut self) -> Result<u128, DeserializeError> {
        return self.de.deserialize_u128();
    }

    fn deserialize_f32(&mut self) -> Result<f32, DeserializeError> {
        return self.de.deserialize_f32();
    }

    fn deserialize_f64(&mut self) -> Result<f64, DeserializeError> {
        return self.de.deserialize_f64();
    }

    fn deserialize_f16(&mut self) -> Result<f16, DeserializeError> {
        return self.de.deserialize_f16();
    }

    fn deserialize_bf16(&mut self) -> Result<bf16, DeserializeError> {
        return self.de.deserialize_bf16();
    }

    fn deserialize_bool(&mut self) -> Result<bool, DeserializeError> {
        return self.de.deserialize_bool();
    }

    fn deserialize_char(&mut self) -> Result<char, DeserializeError> {
        return self.de.deserialize_char();
    }

    fn deserialize_string(&mut self) -> Result<String, DeserializeError> {
        return self.de.deserialize_string();
    }

    fn is_null(&mut self) -> Result<bool, DeserializeError> {
        return self.de.is_null();
    }

    fn begin_seq(&mut self) -> Result<NsdSeqAccess, DeserializeError> {
        self.de.expect_char(b'[')?;
        let depth = inner_depth(self.de)?;
        return Result::Ok(NsdSeqAccess {
            de: self.de,
            depth,
            first: true,
        });
    }

    fn begin_map(&mut self) -> Result<NsdMapAccess, DeserializeError> {
        self.de.expect_char(b'{')?;
        let depth = inner_depth(self.de)?;
        return Result::Ok(NsdMapAccess {
            de: self.de,
            depth,
            first: true,
        });
    }

    fn begin_struct<S: AsStrSlice>(&mut self, name: S, num_fields: i32) -> Result<NsdStructAccess, DeserializeError> {
        // NSD: struct encoded as array
        self.de.expect_char(b'[')?;
        let depth = inner_depth(self.de)?;
        return Result::Ok(NsdStructAccess {
            de: self.de,
            depth,
            index: 0,
            first: true,
        });
    }

    fn begin_variant<S: AsStrSlice>(
        &mut self,
        type_name: S,
        num_cases: i32,
    ) -> Result<NsdVariantAccess, DeserializeError> {
        let b = self.de.peek_after_whitespace();
        if b < 0 {
            return Result::Err(DeserializeError::eof(self.de.pos as i64));
        }
        if b == b'[' {
            // Payload variant: [disc, payload]
            self.de.pos += 1;
            let depth = inner_depth(self.de)?;
            let disc = self.de.parse_i32_direct()?;
            self.de.expect_char(b',')?;
            return Result::Ok(NsdVariantAccess {
                de: self.de,
                depth,
                disc,
                is_unit: false,
            });
        }
        // Unit variant: a bare discriminant opens no container.
        let depth = self.de.depth;
        let disc = self.de.parse_i32_direct()?;
        return Result::Ok(NsdVariantAccess {
            de: self.de,
            depth,
            disc,
            is_unit: true,
        });
    }

    fn deserialize_any<V: Visitor>(&mut self, visitor: &mut V) -> Result<V::Value, DeserializeError> {
        return self.de.deserialize_any::<V>(visitor);
    }
}

/// Serializes a value to UTF-8 JSON NSD bytes — the primary entry point.
///
/// Returns a read-only `ByteSlice` over the serializer's UTF-8 buffer.
/// `trailing_char`, when `Some`, is appended after the value.
pub fn to_bytes<T: Serialize>(value: &T, trailing_char: Option<char> = null) -> Result<ByteSlice, SerializeError> {
    let mut buf: String = "";
    let mut ser = NsdSerializer { buf: &mut buf };
    value.serialize::<NsdSerializer>(&mut ser)?;
    if let Some(c) = trailing_char {
        buf.push(c);
    }
    return Result::Ok(buf.as_bytes());
}

/// Serializes a value to a JSON NSD string. Convenience over `to_bytes` for
/// text contexts; serde I/O is bytes-primary.
///
/// `trailing_char`, when `Some`, is appended after the value.
pub fn to_string<T: Serialize>(value: &T, trailing_char: Option<char> = null) -> Result<String, SerializeError> {
    let mut buf: String = "";
    let mut ser = NsdSerializer { buf: &mut buf };
    value.serialize::<NsdSerializer>(&mut ser)?;
    if let Some(c) = trailing_char {
        buf.push(c);
    }
    return Result::Ok(buf);
}

/// Deserializes a value from a JSON NSD string.
pub fn from_string<T: Deserialize, S: AsStrSlice>(
    input: S,
    max_depth: i32 = DEFAULT_MAX_DEPTH,
) -> Result<T, DeserializeError> {
    return from_bytes::<T, ByteSlice>(input.as_bytes(), max_depth);
}

/// Deserializes a value from UTF-8 JSON NSD bytes — the primary entry point.
/// Accepts any byte source via `AsByteSlice` (including a `String`).
pub fn from_bytes<T: Deserialize, S: AsByteSlice>(
    input: S,
    max_depth: i32 = DEFAULT_MAX_DEPTH,
) -> Result<T, DeserializeError> {
    let mut de = JsonDeserializer {
        input: input.as_byte_slice(),
        pos: 0,
        max_depth,
    };
    let mut nsd = NsdDeserializer { de: &mut de };
    let v = T::deserialize(&mut nsd)?;
    if de.peek_after_whitespace() >= 0 {
        return Result::Err(DeserializeError::trailing(de.pos as i64));
    }
    return Result::Ok(v);
}


// --- Primitive serialization (same as JSON) ---

test "serialize i32" {
    let n = 42;
    let r = to_string(&n);
    assert r matches { Ok(s) && s == "42" };
}

test "serialize negative i32" {
    let n = -123;
    let r = to_string(&n);
    assert r matches { Ok(s) && s == "-123" };
}

test "serialize i64" {
    let n: i64 = 1000000000000;
    let r = to_string(&n);
    assert r matches { Ok(s) && s == "1000000000000" };
}

test "serialize u32" {
    let n: u32 = 255;
    let r = to_string(&n);
    assert r matches { Ok(s) && s == "255" };
}

test "serialize f64" {
    let n = 3.14;
    let r = to_string(&n);
    assert r matches { Ok(s) && s == "3.14" };
}

test "serialize bool" {
    let v = true;
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "true" };
}

test "serialize string" {
    let v = "hello";
    let r = to_string(&v);
    assert r matches { Ok(s) && s == `"hello"` };
}

test "serialize string with escapes" {
    let v = "line1\nline2";
    let r = to_string(&v);
    assert r matches { Ok(s) && s == `"line1\\nline2"` };
}

test "serialize null" {
    let v: Option<i32> = null;
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "null" };
}

// --- Struct serialization (NSD: positional array) ---

struct Point {
    x: i32,
    y: i32,
}

impl Serialize for Point;
impl Deserialize for Point;

test "serialize struct as array" {
    let p = Point { x: 10, y: 20 };
    let r = to_string(&p);
    assert r matches { Ok(s) && s == "[10,20]" };
}

struct Person {
    name: String,
    age: i32,
    active: bool,
}

impl Serialize for Person;
impl Deserialize for Person;

test "serialize struct with mixed types" {
    let p = Person { name: "Alice", age: 30, active: true };
    let r = to_string(&p);
    assert r matches { Ok(s) && s == `["Alice",30,true]` };
}

// --- Nested struct serialization ---

struct Line {
    start: Point,
    end: Point,
}

impl Serialize for Line;
impl Deserialize for Line;

test "serialize nested struct" {
    let l = Line {
        start: Point { x: 1, y: 2 },
        end: Point { x: 3, y: 4 },
    };
    let r = to_string(&l);
    assert r matches { Ok(s) && s == "[[1,2],[3,4]]" };
}

// --- Enum (unit variant) serialization ---

enum Color {
    Red,
    Green,
    Blue,
}

impl Serialize for Color;
impl Deserialize for Color;

test "serialize unit variant as discriminant" {
    let c = Color::Red;
    let r = to_string(&c);
    assert r matches { Ok(s) && s == "0" };
}

test "serialize unit variant Green" {
    let c = Color::Green;
    let r = to_string(&c);
    assert r matches { Ok(s) && s == "1" };
}

test "serialize unit variant Blue" {
    let c = Color::Blue;
    let r = to_string(&c);
    assert r matches { Ok(s) && s == "2" };
}

// --- Variant (with payload) serialization ---

variant Shape {
    Circle(f64),
    Rectangle([f64, f64]),
    Point,
}

impl Serialize for Shape;
impl Deserialize for Shape;

test "serialize payload variant" {
    let s = Shape::Circle(5.0);
    let r = to_string(&s);
    assert r matches { Ok(v) && v == "[0,5]" };
}

test "serialize tuple-payload variant" {
    let s = Shape::Rectangle([10.0, 20.0]);
    let r = to_string(&s);
    assert r matches { Ok(v) && v == "[1,[10,20]]" };
}

test "serialize unit variant in variant type" {
    let s = Shape::Point;
    let r = to_string(&s);
    assert r matches { Ok(v) && v == "2" };
}

// --- Option serialization ---

test "serialize Option Some" {
    let v: Option<i32> = Option::Some(42);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "42" };
}

test "serialize Option None" {
    let v: Option<i32> = null;
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "null" };
}

// --- List serialization ---

test "serialize List" {
    let v: List<i32> = [1, 2, 3];
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "[1,2,3]" };
}

test "serialize List of structs" {
    let v: List<Point> = [
        Point { x: 1, y: 2 },
        Point { x: 3, y: 4 },
    ];
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "[[1,2],[3,4]]" };
}

// --- Primitive deserialization (same as JSON) ---

test "deserialize i32" {
    let r: Result<i32, DeserializeError> = from_string("42");
    assert r matches { Ok(v) && v == 42 };
}

test "deserialize f64" {
    let r: Result<f64, DeserializeError> = from_string("3.14");
    assert r matches { Ok(v) && v == 3.14 };
}

test "deserialize bool" {
    let r: Result<bool, DeserializeError> = from_string("true");
    assert r matches { Ok(v) && v == true };
}

test "deserialize string" {
    let r: Result<String, DeserializeError> = from_string(`"hello"`);
    assert r matches { Ok(v) && v == "hello" };
}

// --- Struct deserialization (NSD: from positional array) ---

test "deserialize struct from array" {
    let r: Result<Point, DeserializeError> = from_string("[10,20]");
    if let Ok(p) = r {
        assert p.x == 10;
        assert p.y == 20;
    } else {
        panic("expected Ok");
    }
}

test "deserialize struct with mixed types" {
    let r: Result<Person, DeserializeError> = from_string(`["Alice",30,true]`);
    if let Ok(p) = r {
        assert p.name == "Alice";
        assert p.age == 30;
        assert p.active == true;
    } else {
        panic("expected Ok");
    }
}

test "deserialize nested struct" {
    let r: Result<Line, DeserializeError> = from_string("[[1,2],[3,4]]");
    if let Ok(l) = r {
        assert l.start.x == 1;
        assert l.start.y == 2;
        assert l.end.x == 3;
        assert l.end.y == 4;
    } else {
        panic("expected Ok");
    }
}

// --- Enum deserialization ---

test "deserialize unit variant Red" {
    let r: Result<Color, DeserializeError> = from_string("0");
    if let Ok(c) = r {
        assert c == Color::Red;
    } else {
        panic("expected Ok");
    }
}

test "deserialize unit variant Blue" {
    let r: Result<Color, DeserializeError> = from_string("2");
    if let Ok(c) = r {
        assert c == Color::Blue;
    } else {
        panic("expected Ok");
    }
}

// --- Variant deserialization ---

test "deserialize payload variant" {
    let r: Result<Shape, DeserializeError> = from_string("[0,5.0]");
    if let Ok(s) = r {
        if let Circle(radius) = s {
            assert radius == 5.0;
        } else {
            panic("expected Circle");
        }
    } else {
        panic("expected Ok");
    }
}

test "deserialize unit variant in variant type" {
    let r: Result<Shape, DeserializeError> = from_string("2");
    if let Ok(s) = r {
        assert s matches { Point };
    } else {
        panic("expected Ok");
    }
}

// --- Round-trip tests ---

test "round-trip struct" {
    let orig = Point { x: 42, y: -7 };
    let json_r = to_string(&orig);
    if let Ok(json) = json_r {
        let parsed_r: Result<Point, DeserializeError> = from_string(json);
        if let Ok(parsed) = parsed_r {
            assert parsed.x == 42;
            assert parsed.y == -7;
        } else {
            panic("round-trip parse failed");
        }
    } else {
        panic("round-trip serialize failed");
    }
}

test "round-trip nested struct" {
    let orig = Line {
        start: Point { x: 1, y: 2 },
        end: Point { x: 3, y: 4 },
    };
    let json_r = to_string(&orig);
    if let Ok(json) = json_r {
        let parsed_r: Result<Line, DeserializeError> = from_string(json);
        if let Ok(parsed) = parsed_r {
            assert parsed.start.x == 1;
            assert parsed.start.y == 2;
            assert parsed.end.x == 3;
            assert parsed.end.y == 4;
        } else {
            panic("round-trip parse failed");
        }
    } else {
        panic("round-trip serialize failed");
    }
}

test "round-trip a map with scalar keys" {
    let mut ints = TreeMap::<i32, String>::new();
    ints[1] = "one";
    assert to_string(&ints) == Result::Ok(`{"1":"one"}`);
    let back: TreeMap<i32, String> = from_string(`{"1":"one"}`).unwrap();
    assert back[1] == "one";
    let mut names = TreeMap::<String, i32>::new();
    names["a"] = 1;
    assert to_string(&names) == Result::Ok(`{"a":1}`);
    let mut lists = TreeMap::<List<i32>, i32>::new();
    lists[[1]] = 1;
    assert to_string(&lists) matches { Err(_) };
}

test "round-trip enum" {
    let orig = Color::Green;
    let json_r = to_string(&orig);
    if let Ok(json) = json_r {
        let parsed_r: Result<Color, DeserializeError> = from_string(json);
        if let Ok(parsed) = parsed_r {
            assert parsed == Color::Green;
        } else {
            panic("round-trip parse failed");
        }
    } else {
        panic("round-trip serialize failed");
    }
}

// --- Error cases ---

test "deserialize struct wrong type" {
    let r: Result<Point, DeserializeError> = from_string("42");
    assert r matches { Err(_) };
}

test "deserialize trailing data" {
    let r: Result<i32, DeserializeError> = from_string("42 extra");
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::TrailingData };
}

variant Tree {
    Leaf(i32),
    Node(List<Tree>),
}
impl Deserialize for Tree;

fn nested_tree(depth: i32) -> String {
    // NSD variant payload form: [disc, payload]. `Node` wraps a one-element list.
    let mut s = String::new();
    for let mut i = 0; i < depth; i += 1 {
        s.push_str("[1,[");
    }
    s.push_str("[0,7]");
    for let mut i = 0; i < depth; i += 1 {
        s.push_str("]]");
    }
    return s;
}

test "a recursive type is depth-limited, not stack-exhausting" {
    let r: Result<Tree, DeserializeError> = from_string(nested_tree(400));
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::DepthLimitExceeded };
}

test "nesting within max_depth still parses" {
    let r: Result<Tree, DeserializeError> = from_string(nested_tree(3));
    assert r matches { Ok(_) };
}

test "a StrSlice parses without copying out" {
    let owner = `  [0,7]  `;
    let view = owner.as_str_slice().trim_ascii();
    let r: Result<Tree, DeserializeError> = from_string(view);
    assert r matches { Ok(Tree::Leaf(7)) };
}
