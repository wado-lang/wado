// Call OpenRouter's chat completions API with a fixed prompt.
//
// Requires OPENROUTER_API_KEY in the environment.
//
// Usage:
//   export OPENROUTER_API_KEY=sk-or-...
//   wado run example/llm.wado

use { println, env, Stdout, Stderr, Environment } from "core:cli";
use { Client } from "wasi:http";
use { to_bytes, from_bytes } from "core:json";
use { post } from "./https_post.wado";

struct ChatMessage {
    role: String,
    content: String,
}

struct ChatRequest {
    model: String,
    messages: List<ChatMessage>,
}

struct ChatChoice {
    message: ChatMessage,
}

struct ChatResponse {
    choices: List<ChatChoice>,
}

global MODEL_NAME: String = "google/gemma-4-26b-a4b-it:free";

export fn run() with (Stdout, Stderr, Environment, Client) {
    let Some(api_key) = env("OPENROUTER_API_KEY") else {
        panic("OPENROUTER_API_KEY is not set");
    };

    let request = ChatRequest {
        model: MODEL_NAME,
        messages: [
            ChatMessage { role: "user", content: "Explain WebAssembly briefly" },
        ],
    };
    let [status, body] = post("openrouter.ai", "/api/v1/chat/completions", [
        ["authorization", `Bearer ${api_key}`],
        ["content-type", "application/json"],
    ], to_bytes(&request).unwrap());

    if status != 200 {
        panic(`HTTP ${status}: ${String::from_utf8_lossy(body)}`);
    }

    let parsed = match from_bytes::<ChatResponse, ByteList>(body) {
        Ok(r) => r,
        Err(e) => panic(`failed to parse JSON response: ${e:?}`),
    };

    if parsed.choices.is_empty() {
        panic("no choices in response");
    }

    println(parsed.choices[0].message.content);
}
