// Call OpenRouter's chat completions API with a fixed prompt.
//
// Requires OPENROUTER_API_KEY in the environment. The model is a build input:
// OPENROUTER_MODEL in the environment, or `-D OPENROUTER_MODEL=...`.
//
// Usage:
//   export OPENROUTER_API_KEY=sk-or-...
//   wado run example/llm.wado
//   wado run -D OPENROUTER_MODEL=<model-id> example/llm.wado

use { println, env, Stdout, Stderr, Environment } from "core:cli";
use { Client } from "wasi:http";
use { Method } from "wasi:http";
use { to_bytes } from "core:json";
use { HttpClient, ClientInit, RequestInit } from "core:http_client";

struct ChatMessage {
    role: String,
    content: String,
}

struct ChatRequest {
    model: String,
    messages: List<ChatMessage>,
}

struct ChatChoice {
    message: ChatMessage,
}

struct ChatResponse {
    choices: List<ChatChoice>,
}

#[param(from_env = "OPENROUTER_MODEL")]
global OPENROUTER_MODEL: String = "google/gemma-4-26b-a4b-it:free";

export fn run() with (Stdout, Stderr, Environment, Client) {
    let Some(api_key) = env("OPENROUTER_API_KEY") else {
        panic("OPENROUTER_API_KEY is not set");
    };

    let request = ChatRequest {
        model: OPENROUTER_MODEL,
        messages: [
            ChatMessage { role: "user", content: "Explain WebAssembly briefly" },
        ],
    };
    let client = HttpClient::new("https://openrouter.ai/api/v1", ClientInit {
        headers: [
            ["authorization", `Bearer ${api_key}`],
            ["user-agent", #file],
        ],
    }).unwrap();
    let mut res = client
        .request("/chat/completions", RequestInit {
            method: Method::Post,
            headers: [
                ["content-type", "application/json"],
            ],
            body: Some(to_bytes(&request).unwrap()),
        })
        .unwrap();

    if !res.ok() {
        panic(`HTTP ${res.status}: ${res.text().unwrap()}`);
    }

    let parsed = match res.json::<ChatResponse>() {
        Ok(r) => r,
        Err(e) => panic(`failed to parse JSON response: ${e}`),
    };

    if parsed.choices.is_empty() {
        panic("no choices in response");
    }

    println(parsed.choices[0].message.content);
}
