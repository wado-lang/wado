// Static file server — serves the directory `wado serve --dir` grants
//
// Compile and run with wado serve:
//   cargo run --bin wado -- serve --dir example/web-browser example/static_server.wado
//
// Endpoints:
//   GET  /<path>  — the file at <path>, `index.html` for a directory
//   HEAD /<path>  — the same status and content type, without the body
//
// A path that names nothing under the directory, or climbs out of it, is 404.
// Other methods are 405. For a full-featured service, see http_bin.wado.

use { Request, Response, ErrorCode, FieldValue, Headers, Trailers, StatusCode, Method } from "wasi:http";
use { Preopens } from "core:fs";
use fs from "core:fs";
use { percent_decode } from "core:url";

struct Reply {
    status: StatusCode,
    content_type: String,
    body: ByteList,
}

export async fn handle(request: Request) -> Result<Response, ErrorCode> with Preopens {
    let method = request.get_method();
    let reply = match method {
        Get | Head => serve(request.get_path_with_query().unwrap_or("/")),
        _ => text(405, "method not allowed"),
    };

    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [body_rx, body_tx] = Stream::<u8>::new();
    let headers = Headers::new();
    headers.append("content-type", reply.content_type.bytes().collect() as FieldValue);
    let [response, _response_tx] = Response::new(headers, Option::Some(body_rx), trailers_future);
    response.set_status_code(reply.status);

    task return Result::<Response, ErrorCode>::Ok(response);

    if !method matches { Head } {
        body_tx.write_raw_all(reply.body.as_slice());
    }
    body_tx.drop();
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

fn serve(target: String) -> Reply with Preopens {
    let Some(path) = file_path(target) else {
        return text(404, "not found");
    };
    return match fs::read(&path) {
        Ok(body) => Reply { status: 200, content_type: content_type(&path), body },
        Err(e) => if e.kind matches { NotFound } { text(404, "not found") } else { text(500, `${e}`) },
    };
}

/// The file a request target names, relative to the served directory: `None`
/// where it names none there.
fn file_path(target: String) -> Option<String> {
    let path = match target.split_once("?") {
        Some([path, _]) => path.to_string(),
        None => target,
    };
    let Ok(decoded) = percent_decode(&path) else {
        return null;
    };
    let Ok(mut normalized) = fs::normalize(decoded.as_str_slice().slice(1, decoded.len())) else {
        return null;
    };
    if normalized.is_empty() || decoded.ends_with("/") {
        normalized = fs::join(&normalized, "index.html");
    }
    return Option::Some(normalized);
}

fn content_type<S: AsStrSlice>(path: S) -> String {
    return match fs::extension(path).map(|e| e.to_string()).unwrap_or("") {
        "html" => "text/html; charset=utf-8",
        "js" | "mjs" => "text/javascript; charset=utf-8",
        "css" => "text/css; charset=utf-8",
        "json" => "application/json",
        "wasm" => "application/wasm",
        "svg" => "image/svg+xml",
        "png" => "image/png",
        "txt" => "text/plain; charset=utf-8",
        _ => "application/octet-stream",
    };
}

fn text(status: StatusCode, message: String) -> Reply {
    return Reply { status, content_type: "text/plain; charset=utf-8", body: message.bytes().collect() };
}

test "a target names a file under the served directory" {
    assert file_path("/") == Option::Some("index.html");
    assert file_path("/build/app.js?v=2") == Option::Some("build/app.js");
    assert file_path("/docs/") == Option::Some("docs/index.html");
    assert file_path("/a%20b.txt") == Option::Some("a b.txt");
    assert file_path("/a/./b/../c.css") == Option::Some("a/c.css");
}

test "a target that climbs out of the served directory names nothing" {
    assert file_path("/../secret") == null;
    assert file_path("/a/%2E%2E/%2E%2E/secret") == null;
    assert file_path("/%zz") == null;
}

test "a file's type comes from its extension" {
    assert content_type("index.html") == "text/html; charset=utf-8";
    assert content_type("build/app.js") == "text/javascript; charset=utf-8";
    assert content_type("build/main.core.wasm") == "application/wasm";
    assert content_type("LICENSE") == "application/octet-stream";
}
