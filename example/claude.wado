// Call Anthropic's Messages API with a fixed prompt, printing the answer as it
// streams in as Server-Sent Events.
//
// Requires CLAUDE_API_KEY in the environment. The model is a build input:
// CLAUDE_MODEL in the environment, or `-D CLAUDE_MODEL=...`.
//
// Usage:
//   export CLAUDE_API_KEY=sk-ant-...
//   wado run example/claude.wado
//   wado run -D CLAUDE_MODEL=claude-haiku-5-5 example/claude.wado

use { print, println, env, Stdout, Stderr, Environment } from "core:cli";
use { Client, Method } from "wasi:http";
use { to_bytes, from_string } from "core:json";
use { HttpClient, ClientInit, RequestInit } from "core:http_client";

struct Message {
    role: String,
    content: String,
}

struct MessagesRequest {
    model: String,
    max_tokens: i32,
    stream: bool,
    messages: List<Message>,
}

// Only a `text_delta` carries `text`; a `thinking_delta`, say, does not.
struct Delta {
    text: Option<String> = null,
}

struct ContentBlockDelta {
    delta: Delta,
}

#[param(from_env = "CLAUDE_MODEL")]
global CLAUDE_MODEL: String = "claude-opus-5-5";

export fn run() with (Stdout, Stderr, Environment, Client) {
    let Some(api_key) = env("CLAUDE_API_KEY") else {
        panic("CLAUDE_API_KEY is not set");
    };
    let client = HttpClient::new("https://api.anthropic.com", ClientInit {
        headers: { "x-api-key": api_key, "anthropic-version": "2023-06-01", "user-agent": #file },
    }).unwrap();

    let request = MessagesRequest {
        model: CLAUDE_MODEL,
        max_tokens: 16000,
        stream: true,
        messages: [
            Message { role: "user", content: "Explain WebAssembly briefly" },
        ],
    };
    let mut res = client
        .request("/v1/messages", RequestInit {
            method: Method::Post,
            headers: { "content-type": "application/json" },
            body: Some(to_bytes(&request).unwrap()),
        })
        .unwrap();
    if !res.ok() {
        panic(`HTTP ${res.status}: ${res.text().unwrap()}`);
    }

    let mut events = res.events();
    for let event of &mut events {
        let event = event.unwrap();
        if event.event == "error" {
            panic(`the stream failed: ${event.data}`);
        }
        if event.event == "content_block_delta" {
            let Ok(block) = from_string::<ContentBlockDelta>(event.data) else {
                panic(`unparsed event: ${event.data}`);
            };
            if let Some(text) = block.delta.text {
                print(text);
            }
        }
    }
    println("");
}
