    fn finish_connect(socket: &TcpSocket) -> Result<(InputStream, OutputStream), ErrorCode>;

    #[wasi("wasi:sockets/tcp@0.2.9#[method]tcp-socket.start-listen")]
    fn start_listen(socket: &TcpSocket) -> Result<(), ErrorCode>;

    #[wasi("wasi:sockets/tcp@0.2.9#[method]tcp-socket.finish-listen")]
