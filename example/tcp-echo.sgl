    #[wasi("wasi:sockets/tcp@0.2.9#[method]tcp-socket.keep-alive-interval")]
    fn keep_alive_interval(socket: &TcpSocket) -> Result<Duration, ErrorCode>;

    #[wasi("wasi:sockets/tcp@0.2.9#[method]tcp-socket.set-keep-alive-interval")]
    fn set_keep_alive_interval(socket: &TcpSocket, value: Duration) -> Result<(), ErrorCode>;

    #[wasi("wasi:sockets/tcp@0.2.9#[method]tcp-socket.keep-alive-count")]
