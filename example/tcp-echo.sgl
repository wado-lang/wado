// Types from wasi:sockets/network@0.2.9
enum IpAddressFamily {
    Ipv4,
    Ipv6,
}

struct IpSocketAddress {
    // Implementation details omitted
}

enum ErrorCode {
    // All WASI error codes
    AccessDenied,
    WouldBlock,
    AlreadyConnected,
    ConnectionRefused,
    ConnectionReset,
    ConnectionAborted,
    NotConnected,
    AddressInUse,
    AddressNotBindable,
    RemoteUnreachable,
    Timeout,
    InvalidState,
    InvalidArgument,
    // ... more error codes
}

// Types from wasi:sockets/tcp@0.2.9
enum ShutdownType {
    Receive,
    Send,
    Both,
}

// Types from wasi:clocks/monotonic-clock@0.2.9
type Duration = u64;

// WASI resources become opaque handles
#[wasi("wasi:sockets/network@0.2.9")]
resource Network;

#[wasi("wasi:sockets/tcp@0.2.9")]
resource TcpSocket;

#[wasi("wasi:io/streams@0.2.9")]
resource InputStream;

#[wasi("wasi:io/streams@0.2.9")]
resource OutputStream;

#[wasi("wasi:io/poll@0.2.9")]
resource Pollable;

