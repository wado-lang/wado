    #[wasi("wasi:io/streams@0.2.9#[method]input-stream.blocking-read")]
    fn blocking_read(stream: &InputStream, len: u64) -> Result<List<u8>, ErrorCode>;

    #[wasi("wasi:io/streams@0.2.9#[method]input-stream.skip")]
    fn skip(stream: &InputStream, len: u64) -> Result<u64, ErrorCode>;

    #[wasi("wasi:io/streams@0.2.9#[method]input-stream.blocking-skip")]
    fn blocking_skip(stream: &InputStream, len: u64) -> Result<u64, ErrorCode>;

    #[wasi("wasi:io/streams@0.2.9#[method]input-stream.subscribe")]
    fn subscribe_input(stream: &InputStream) -> Pollable;

    // OutputStream methods
    #[wasi("wasi:io/streams@0.2.9#[method]output-stream.check-write")]
    fn check_write(stream: &OutputStream) -> Result<u64, ErrorCode>;

    #[wasi("wasi:io/streams@0.2.9#[method]output-stream.write")]
    fn write(stream: &OutputStream, contents: &List<u8>) -> Result<(), ErrorCode>;

    #[wasi("wasi:io/streams@0.2.9#[method]output-stream.blocking-write-and-flush")]
    fn blocking_write_and_flush(stream: &OutputStream, contents: &List<u8>) -> Result<(), ErrorCode>;

    #[wasi("wasi:io/streams@0.2.9#[method]output-stream.flush")]
    fn flush(stream: &OutputStream) -> Result<(), ErrorCode>;

    #[wasi("wasi:io/streams@0.2.9#[method]output-stream.blocking-flush")]
    fn blocking_flush(stream: &OutputStream) -> Result<(), ErrorCode>;

    #[wasi("wasi:io/streams@0.2.9#[method]output-stream.subscribe")]
    fn subscribe_output(stream: &OutputStream) -> Pollable;

    #[wasi("wasi:io/streams@0.2.9#[method]output-stream.write-zeroes")]
    fn write_zeroes(stream: &OutputStream, len: u64) -> Result<(), ErrorCode>;

    #[wasi("wasi:io/streams@0.2.9#[method]output-stream.blocking-write-zeroes-and-flush")]
    fn blocking_write_zeroes_and_flush(stream: &OutputStream, len: u64) -> Result<(), ErrorCode>;

    #[wasi("wasi:io/streams@0.2.9#[method]output-stream.splice")]
    fn splice(stream: &OutputStream, src: &InputStream, len: u64) -> Result<u64, ErrorCode>;

    #[wasi("wasi:io/streams@0.2.9#[method]output-stream.blocking-splice")]
    fn blocking_splice(stream: &OutputStream, src: &InputStream, len: u64) -> Result<u64, ErrorCode>;
}

// Effect interface for logging (wasi:cli/stderr@0.2.9)
effect Logging {
    #[wasi("wasi:cli/stderr@0.2.9#get-stderr")]
    fn get_stderr() -> OutputStream;

    // Helper function (not directly from WASI)
    fn log(level: string, message: string);
}

// High-level wrapper types
struct TcpStream {
    socket: TcpSocket,
    input: InputStream,
    output: OutputStream,
}

struct TcpListener {
    socket: TcpSocket,
}

// High-level TcpStream API (wrapper around socket + streams)
impl TcpStream {
    fn read(&self, len: u64) -> Result<List<u8>, ErrorCode> with Streams {
        return Streams.blocking_read(&self.input, len);
    }

    fn write(&self, data: &List<u8>) -> Result<(), ErrorCode> with Streams {
        return Streams.blocking_write_and_flush(&self.output, data);
    }

    fn shutdown(&self, shutdown_type: ShutdownType) -> Result<(), ErrorCode> with Tcp {
        return Tcp.shutdown(&self.socket, shutdown_type);
    }
}

// High-level TcpListener API
impl TcpListener {
    fn accept(&self) -> Result<TcpStream, ErrorCode> with Tcp {
        let (socket, input, output) = Tcp.accept(&self.socket)?;
        return Ok(TcpStream { socket, input, output });
    }
}

// Free function to create a listening socket
fn listen(network: &Network, addr: IpSocketAddress) -> Result<TcpListener, ErrorCode> with Tcp {
    let socket = TcpSocket::new();
    Tcp.start_bind(&socket, network, addr)?;
    Tcp.finish_bind(&socket)?;
    Tcp.start_listen(&socket)?;
    Tcp.finish_listen(&socket)?;
    return Ok(TcpListener { socket });
}

fn handle_client(stream: TcpStream) with Tcp, Streams, Logging {
    loop {
        match stream.read(1024) {
            Ok(data) => {
                if data.len() == 0 {
                    Logging.log("info", "Client disconnected");
                    break;
                }
                Logging.log("debug", "Received {data.len()} bytes");
                match stream.write(&data) {
                    Ok(_) => {
                        Logging.log("debug", "Echoed {data.len()} bytes");
                    },
                    Err(e) => {
                        Logging.log("error", "Write error: {e}");
                        break;
                    },
                }
            },
            Err(e) => {
                Logging.log("error", "Read error: {e}");
                break;
            },
        }
    }

    let _ = stream.shutdown(ShutdownType::Both);
}

fn run_server(network: &Network) with Tcp, Streams, Logging {
    let addr = parse_address("127.0.0.1:8080");

    let listener = match listen(network, addr) {
        Ok(l) => l,
        Err(e) => {
            Logging.log("error", "Failed to bind to 127.0.0.1:8080: {e}");
            return;
        },
    };

    Logging.log("info", "TCP echo server listening on 127.0.0.1:8080");

    loop {
        match listener.accept() {
            Ok(stream) => {
                Logging.log("info", "New client connected");
                handle_client(stream);
            },
            Err(e) => {
                Logging.log("warn", "Accept error: {e}");
            },
        }
    }
}

