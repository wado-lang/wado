// SIMD Color Processing
//
// RGBA color manipulation using f32x4, where each lane maps to [R, G, B, A].
// This is the canonical SIMD use case in game engines, image processing,
// and GPU shader emulation.

use { println, Stdout } from "core:cli";
use { f32x4 } from "core:simd";

// An RGBA color stored as f32x4 [R, G, B, A], each in 0.0..1.0
struct Color {
    v: f32x4,
}

impl Color {
    fn new(r: f32, g: f32, b: f32, a: f32) -> Color {
        let v: f32x4 = [r, g, b, a];
        return Color { v };
    }

    fn white() -> Color {
        return Color { v: f32x4::splat(1.0) };
    }

    fn black() -> Color {
        let v: f32x4 = [0.0, 0.0, 0.0, 1.0];
        return Color { v };
    }

    fn r(&self) -> f32 {
        return self.v.extract_lane(0);
    }

    fn g(&self) -> f32 {
        return self.v.extract_lane(1);
    }

    fn b(&self) -> f32 {
        return self.v.extract_lane(2);
    }

    fn a(&self) -> f32 {
        return self.v.extract_lane(3);
    }

    // Adjust brightness by multiplying RGB channels, preserving alpha
    fn brighten(&self, factor: f32) -> Color {
        let scale: f32x4 = [factor, factor, factor, 1.0];
        return Color { v: self.v * scale };
    }

    // Linear interpolation between two colors: self * (1-t) + other * t
    fn lerp(&self, other: &Color, t: f32) -> Color {
        let t_vec = f32x4::splat(t);
        let one = f32x4::splat(1.0);
        let inv_t = one - t_vec;
        return Color { v: self.v * inv_t + other.v * t_vec };
    }

    // Convert to grayscale using luminance weights (ITU-R BT.709)
    // Y = 0.2126*R + 0.7152*G + 0.0722*B
    fn grayscale(&self) -> Color {
        let weights: f32x4 = [0.2126, 0.7152, 0.0722, 0.0];
        let weighted = self.v * weights;
        // Sum RGB lanes manually
        let lum = weighted.extract_lane(0) + weighted.extract_lane(1) + weighted.extract_lane(2);
        let v: f32x4 = [lum, lum, lum, self.a()];
        return Color { v };
    }

    // Alpha-composite self over other (Porter-Duff "over" operator)
    // out = src * src_a + dst * dst_a * (1 - src_a)
    fn over(&self, dst: &Color) -> Color {
        let src_a = f32x4::splat(self.a());
        let dst_a = f32x4::splat(dst.a());
        let one = f32x4::splat(1.0);
        let inv_src_a = one - src_a;

        let out_rgb = self.v * src_a + dst.v * dst_a * inv_src_a;
        let out_a = self.a() + dst.a() * (1.0 - self.a());

        // Replace alpha lane
        let mask: f32x4 = [1.0, 1.0, 1.0, 0.0];
        let alpha: f32x4 = [0.0, 0.0, 0.0, out_a];
        return Color { v: out_rgb * mask + alpha };
    }

    // Clamp all channels to 0.0..1.0
    fn clamp(&self) -> Color {
        let zero = f32x4::splat(0.0);
        let one = f32x4::splat(1.0);
        return Color { v: self.v.max(&zero).min(&one) };
    }

    // Invert RGB channels: (1-R, 1-G, 1-B, A)
    fn invert(&self) -> Color {
        let one = f32x4::splat(1.0);
        let inverted = one - self.v;
        // Restore original alpha
        let rgb_mask: f32x4 = [1.0, 1.0, 1.0, 0.0];
        let alpha_only: f32x4 = [0.0, 0.0, 0.0, 1.0];
        return Color { v: inverted * rgb_mask + self.v * alpha_only };
    }

    fn to_string(&self) -> String {
        let r = (self.r() * 255.0) as i32;
        let g = (self.g() * 255.0) as i32;
        let b = (self.b() * 255.0) as i32;
        let a = (self.a() * 255.0) as i32;
        return `rgba({r}, {g}, {b}, {a})`;
    }
}

fn approx_eq(a: f32, b: f32) -> bool {
    let diff = a - b;
    let abs_diff = if diff < 0.0 { -diff } else { diff };
    return abs_diff < 0.001;
}

// --- Tests ---

test "color construction" {
    let c = Color::new(0.5, 0.25, 0.75, 1.0);
    assert approx_eq(c.r(), 0.5);
    assert approx_eq(c.g(), 0.25);
    assert approx_eq(c.b(), 0.75);
    assert approx_eq(c.a(), 1.0);
}

test "white and black" {
    let w = Color::white();
    assert approx_eq(w.r(), 1.0);
    assert approx_eq(w.g(), 1.0);
    assert approx_eq(w.b(), 1.0);

    let b = Color::black();
    assert approx_eq(b.r(), 0.0);
    assert approx_eq(b.g(), 0.0);
    assert approx_eq(b.b(), 0.0);
    assert approx_eq(b.a(), 1.0);
}

test "brighten" {
    let c = Color::new(0.5, 0.4, 0.3, 1.0);
    let bright = c.brighten(2.0);
    assert approx_eq(bright.r(), 1.0);
    assert approx_eq(bright.g(), 0.8);
    assert approx_eq(bright.b(), 0.6);
    assert approx_eq(bright.a(), 1.0);  // alpha preserved
}

test "grayscale" {
    // Pure red -> grayscale should be 0.2126
    let red = Color::new(1.0, 0.0, 0.0, 1.0);
    let gray = red.grayscale();
    assert approx_eq(gray.r(), 0.2126);
    assert approx_eq(gray.g(), 0.2126);
    assert approx_eq(gray.b(), 0.2126);

    // White -> grayscale should be ~1.0
    let w = Color::white();
    let wg = w.grayscale();
    assert approx_eq(wg.r(), 1.0);
}

test "lerp" {
    let a = Color::black();
    let b = Color::white();
    let mid = a.lerp(&b, 0.5);
    assert approx_eq(mid.r(), 0.5);
    assert approx_eq(mid.g(), 0.5);
    assert approx_eq(mid.b(), 0.5);

    // t=0 -> self, t=1 -> other
    let start = a.lerp(&b, 0.0);
    assert approx_eq(start.r(), 0.0);
    let end = a.lerp(&b, 1.0);
    assert approx_eq(end.r(), 1.0);
}

test "invert" {
    let c = Color::new(0.2, 0.4, 0.6, 1.0);
    let inv = c.invert();
    assert approx_eq(inv.r(), 0.8);
    assert approx_eq(inv.g(), 0.6);
    assert approx_eq(inv.b(), 0.4);
    assert approx_eq(inv.a(), 1.0);  // alpha preserved
}

test "clamp" {
    let c = Color::new(1.5, -0.5, 0.5, 1.0);
    let clamped = c.clamp();
    assert approx_eq(clamped.r(), 1.0);
    assert approx_eq(clamped.g(), 0.0);
    assert approx_eq(clamped.b(), 0.5);
}

test "alpha compositing" {
    // 50% transparent red over opaque blue
    let red = Color::new(1.0, 0.0, 0.0, 0.5);
    let blue = Color::new(0.0, 0.0, 1.0, 1.0);
    let result = red.over(&blue);
    assert approx_eq(result.r(), 0.5);
    assert approx_eq(result.b(), 0.5);
    assert approx_eq(result.a(), 1.0);
}

// --- Demo ---

export fn run() with Stdout {
    println("=== SIMD Color Processing ===");
    println("");

    let sky_blue = Color::new(0.53, 0.81, 0.92, 1.0);
    let sunset = Color::new(1.0, 0.55, 0.0, 1.0);

    println(`Sky blue:   {sky_blue.to_string()}`);
    println(`Sunset:     {sunset.to_string()}`);

    // Grayscale
    let gray = sky_blue.grayscale();
    println(`Grayscale:  {gray.to_string()}`);

    // Color lerp (gradient)
    println("");
    println("Gradient (sky -> sunset):");
    for let mut i = 0; i <= 4; i += 1 {
        let t = i as f32 / 4.0;
        let c = sky_blue.lerp(&sunset, t);
        println(`  t={t}: {c.to_string()}`);
    }

    // Alpha compositing
    println("");
    let overlay = Color::new(1.0, 1.0, 0.0, 0.3);
    let composited = overlay.over(&sky_blue);
    println(`Overlay yellow (30%) over sky: {composited.to_string()}`);

    // Brighten + clamp
    let bright = sky_blue.brighten(1.5).clamp();
    println(`Brightened sky (1.5x):         {bright.to_string()}`);

    // Invert
    let inv = sunset.invert();
    println(`Inverted sunset:               {inv.to_string()}`);
}
