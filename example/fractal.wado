//! Mandelbrot and Julia sets, rendered two pixels at a time with `f64x2`
//! SIMD, written as PNG, and shown inline on the terminal.
//!
//!     wado run example/fractal.wado
//!     wado run example/fractal.wado --preset seahorse --palette ocean
//!     wado run example/fractal.wado --julia-re -0.8 --julia-im 0.156 --palette neon
//!     wado run example/fractal.wado --center-x -0.7436 --center-y 0.1318 --zoom 400 --samples 3
//!
//! Options (`core:args`): `--width`, `--height`, `--center-x`, `--center-y`,
//! `--zoom`, `--iterations`, `--samples` (N×N supersampling), `--palette`
//! (fire / ocean / neon / mono), `--preset` (full / seahorse / elephant /
//! spiral / dendrite), `--julia-re` and `--julia-im`, `--out`, `--view`
//! (auto / kitty / iterm / ansi / off) and `--columns`.

use { println, eprintln, Stdout, Stderr, Environment } from "core:cli";
use { from_env } from "core:args";
use { f64x2, i64x2 } from "core:simd";
use fs from "core:fs";
use { Preopens } from "core:fs";
use { MonotonicClock, Mark } from "wasi:clocks";
use { TerminalStdout } from "wasi:cli";
use { Image, View, encode, show } from "./png.wado";

#[wire(name_policy = "kebab-case")]
enum Palette {
    Fire,
    Ocean,
    Neon,
    Mono,
}

#[wire(name_policy = "kebab-case")]
enum Preset {
    Full,
    Seahorse,
    Elephant,
    Spiral,
    Dendrite,
}

struct Options {
    width: i32 = 640,
    height: i32 = 480,
    center_x: Option<f64> = null,
    center_y: f64 = 0.0,
    zoom: f64 = 1.0,
    iterations: i32 = 600,
    samples: i32 = 2,
    palette: Palette = Palette::Fire,
    preset: Option<Preset> = null,
    julia_re: Option<f64> = null,
    julia_im: Option<f64> = null,
    out: String = "fractal.png",
    view: View = View::Auto,
    columns: i32 = 100,
}

/// The region of the plane an image covers: `zoom` 1 spans 3.2 units across.
struct Viewport {
    center_x: f64,
    center_y: f64,
    zoom: f64,
}

impl Preset {
    fn viewport(&self) -> Viewport {
        return match *self {
            Full => Viewport { center_x: -0.6, center_y: 0.0, zoom: 1.0 },
            Seahorse => Viewport { center_x: -0.7453, center_y: 0.1127, zoom: 150.0 },
            Elephant => Viewport { center_x: 0.2849, center_y: 0.0113, zoom: 120.0 },
            Spiral => Viewport { center_x: -0.761574, center_y: -0.0847596, zoom: 1800.0 },
            Dendrite => Viewport { center_x: -0.1011, center_y: 0.9563, zoom: 60.0 },
        };
    }
}

/// What gets iterated: `z ← z² + c`, with `c` the pixel (Mandelbrot) or one
/// fixed constant and `z₀` the pixel (Julia).
variant Set {
    Mandelbrot,
    Julia([f64, f64]),
}

global BAILOUT: f64 = 256.0;

/// Smooth escape time for two points at once, or -1 for a point that never
/// escaped. Lanes are frozen as they escape, so the loop runs until both have.
fn escape_time(set: &Set, x: f64x2, y: f64x2, max_iter: i32) -> [f64, f64] {
    let [mut zr, mut zi, cr, ci] = match *set {
        Mandelbrot => [
            f64x2::splat(0.0),
            f64x2::splat(0.0), x, y,
        ],
        Julia([re, im]) => [
            x, y, f64x2::splat(re),
            f64x2::splat(im),
        ],
    };
    let bailout = f64x2::splat(BAILOUT);
    let one = f64x2::splat(1.0);
    let zero = f64x2::splat(0.0);
    let two = f64x2::splat(2.0);
    let mut count = zero;
    for let _ of 0..<max_iter {
        let zr2 = zr * zr;
        let zi2 = zi * zi;
        let alive: i64x2 = (zr2 + zi2).le(&bailout);
        if alive.bitmask() == 0 {
            break;
        }
        let next_r = zr2 - zi2 + cr;
        let next_i = two * zr * zi + ci;
        zr = next_r.bitselect(&alive, &zr);
        zi = next_i.bitselect(&alive, &zi);
        count = count + one.bitselect(&alive, &zero);
    }
    let mag = zr * zr + zi * zi;
    return [
        smooth(count.extract_lane(0), mag.extract_lane(0)),
        smooth(count.extract_lane(1), mag.extract_lane(1)),
    ];
}

/// The continuous iteration count `n + 1 - log2(log|z|)`, which removes the
/// banding an integer count leaves.
fn smooth(count: f64, mag: f64) -> f64 {
    if mag <= BAILOUT {
        return -1.0;
    }
    return count + 1.0 - f64::log2(0.5 * f64::ln(mag));
}

/// A cosine gradient `a + b·cos(2π(c·t + d))` (after Inigo Quilez), from
/// smooth escape time to RGB; interior points are black.
fn colorize(palette: Palette, t: f64) -> [f64, f64, f64] {
    if t < 0.0 {
        return [0.0, 0.0, 0.0];
    }
    let s = f64::sqrt(t) * 0.18;
    let [d0, d1, d2] = match palette {
        Fire => [0.0, 0.15, 0.25],
        Ocean => [0.5, 0.6, 0.7],
        Neon => [0.8, 0.9, 0.3],
        Mono => [0.0, 0.0, 0.0],
    };
    let wave = |d: f64| 0.5 + 0.5 * f64::cos(6.283185307179586 * (s + d));
    return [
        wave(d0),
        wave(d1),
        wave(d2),
    ];
}

fn render(opts: &Options, set: &Set, view: &Viewport) -> Image {
    let mut img = Image::new(opts.width, opts.height);
    let scale = 3.2 / view.zoom / opts.width as f64;
    let left = view.center_x - scale * opts.width as f64 / 2.0;
    let top = view.center_y + scale * opts.height as f64 / 2.0;
    let n = opts.samples;
    let step = scale / n as f64;
    let weight = 1.0 / (n * n) as f64;
    // Pixel pairs go through the SIMD lanes; an odd width repeats the last column.
    for let py of 0..<opts.height {
        for let mut px = 0; px < opts.width; px += 2 {
            let px1 = i32::min(px + 1, opts.width - 1);
            let mut acc0 = [0.0, 0.0, 0.0];
            let mut acc1 = [0.0, 0.0, 0.0];
            for let sy of 0..<n {
                let y = top - py as f64 * scale - (sy as f64 + 0.5) * step;
                for let sx of 0..<n {
                    let dx = (sx as f64 + 0.5) * step;
                    let x: f64x2 = [left + px as f64 * scale + dx, left + px1 as f64 * scale + dx];
                    let [t0, t1] = escape_time(set, x, f64x2::splat(y), opts.iterations);
                    let c0 = colorize(opts.palette, t0);
                    let c1 = colorize(opts.palette, t1);
                    acc0 = [acc0.0 + c0.0 * weight, acc0.1 + c0.1 * weight, acc0.2 + c0.2 * weight];
                    acc1 = [acc1.0 + c1.0 * weight, acc1.1 + c1.1 * weight, acc1.2 + c1.2 * weight];
                }
            }
            img.set(px, py, acc0);
            img.set(px1, py, acc1);
        }
    }
    return img;
}

fn elapsed_ms(start: Mark) -> u64 with MonotonicClock {
    return (MonotonicClock::now() - start) as u64 / 1_000_000;
}

export fn run() with (Stdout, Stderr, Environment, Preopens, MonotonicClock, TerminalStdout) {
    let opts = match from_env::<Options>() {
        Ok(o) => o,
        Err(e) => {
            eprintln(`fractal: ${e}`);
            return;
        },
    };
    let set = match [opts.julia_re, opts.julia_im] {
        [Some(re), Some(im)] => Set::Julia([re, im]),
        [None, None] => Set::Mandelbrot,
        _ => {
            eprintln("fractal: --julia-re and --julia-im go together");
            return;
        },
    };
    // The Mandelbrot set leans left of the origin; a Julia set is centred on it.
    let default_x = if set matches { Mandelbrot } { -0.6 } else { 0.0 };
    let view = match opts.preset {
        Some(p) => p.viewport(),
        None => Viewport { center_x: opts.center_x.unwrap_or(default_x), center_y: opts.center_y, zoom: opts.zoom },
    };

    let start = MonotonicClock::now();
    let img = render(&opts, &set, &view);
    let render_ms = elapsed_ms(start);
    let png = encode(&img);
    if let Err(e) = fs::write(&opts.out, &png) {
        eprintln(`fractal: ${e}`);
        return;
    }
    show(&img, &png, opts.view, opts.columns);
    println(
        `${opts.width}x${opts.height} × ${opts.samples * opts.samples} samples in ${render_ms} ms → ${opts.out} (${png.len(
        )} bytes)`,
    );
}

test "points inside the set never escape" {
    let [a, b] = escape_time(&Set::Mandelbrot, [0.0, -1.0], f64x2::splat(0.0), 200);
    assert a == -1.0;
    assert b == -1.0;
}

test "points outside escape, farther ones sooner" {
    let [near, far] = escape_time(&Set::Mandelbrot, [0.3, 2.0], f64x2::splat(0.0), 200);
    assert near > far;
    assert far > 0.0;
}

test "lanes escape independently" {
    let [inside, outside] = escape_time(&Set::Mandelbrot, [0.0, 2.0], f64x2::splat(0.0), 200);
    assert inside == -1.0;
    assert outside > 0.0;
}

test "the Julia set of c = 0 is the unit disk" {
    let [inside, outside] = escape_time(&Set::Julia([0.0, 0.0]), [0.9, 1.1], f64x2::splat(0.0), 200);
    assert inside == -1.0;
    assert outside > 0.0;
}
