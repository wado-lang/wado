// HTTP GET example: fetch data from httpbin.org
//
// Usage: wado run example/http_get.wado

use { println, Stdout } from "core:cli";
use { Client } from "wasi:http";
use { HttpClient } from "core:http_client";

export fn run() with (Stdout, Client) {
    let client = HttpClient::new("https://httpbin.org", {
        headers: { "user-agent": #file },
    }).unwrap();
    let mut res = client
        .request("/get", {
            query: { greeting: "hello world" },
        })
        .unwrap();
    println(`Status: ${res.status}`);
    if let Some(kind) = res.headers().header("content-type").unwrap() {
        println(`Content-Type: ${kind}`);
    }
    println(res.text().unwrap());
}
