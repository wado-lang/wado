// Power of 10 table: 10^-348 to 10^347 (696 entries)
// Generated from rsc.io/fpfmt pow10tab.go
fn pow10_tab(idx: i32) -> PmHiLo {
    if idx < 100 { return pow10_tab_0(idx); }
    if idx < 200 { return pow10_tab_1(idx); }
    if idx < 300 { return pow10_tab_2(idx); }
    if idx < 400 { return pow10_tab_3(idx); }
    if idx < 500 { return pow10_tab_4(idx); }
    if idx < 600 { return pow10_tab_5(idx); }
    return pow10_tab_6(idx);
}


// ============================================================================
// Tests
// ============================================================================

test "log approximations" {
    assert log10_pow2(10) == 3;
    assert log10_pow2(100) == 30;
    assert log2_pow10(3) == 9;
    assert log2_pow10(10) == 33;
}

test "bit length" {
    assert i64_bit_len(0 as i64) == 0;
    assert i64_bit_len(1 as i64) == 1;
    assert i64_bit_len(2 as i64) == 2;
    assert i64_bit_len(3 as i64) == 2;
    assert i64_bit_len(255 as i64) == 8;
    assert i64_bit_len(256 as i64) == 9;
}

test "unpack64 basic" {
    let r1 = unpack64(1.0);
    assert r1.mantissa != 0 as i64;

    let r2 = unpack64(2.0);
    assert r2.mantissa != 0 as i64;
}

test "pow10 function" {
    assert pow10(0) == 1 as i64;
    assert pow10(1) == 10 as i64;
    assert pow10(2) == 100 as i64;
    assert pow10(9) == 1000000000 as i64;
}

test "digits count" {
    assert digits(1 as i64) == 1;
    assert digits(9 as i64) == 1;
    assert digits(10 as i64) == 2;
    assert digits(99 as i64) == 2;
    assert digits(100 as i64) == 3;
    assert digits(999 as i64) == 3;
}

test "unsigned comparisons" {
    // Test that u64_lt handles sign bit correctly
    let a = 0x7FFFFFFFFFFFFFFF as i64;  // Max positive i64
    let b = 0x8000000000000000 as i64;  // Min negative i64, but largest u64/2
    // As unsigned: a < b
    assert u64_lt(a, b);
    assert !u64_lt(b, a);
}

test "short formatting basic values" {
    // 1.0 should format to 1 * 10^0
    let r1 = short(1.0);
    assert r1.digits == 1 as i64;
    assert r1.exponent == 0;

    // 10.0 should format to 1 * 10^1
    let r10 = short(10.0);
    assert r10.digits == 1 as i64;
    assert r10.exponent == 1;

    // 100.0 should format to 1 * 10^2
    let r100 = short(100.0);
    assert r100.digits == 1 as i64;
    assert r100.exponent == 2;

    // 2.0 should format to 2 * 10^0
    let r2 = short(2.0);
    assert r2.digits == 2 as i64;
    assert r2.exponent == 0;
}

test "short formatting pi" {
    let pi = 3.141592653589793;
    let r = short(pi);
    // Pi should produce many digits
    assert r.digits > 0 as i64;
    // The digit count should be reasonable
    assert digits(r.digits) <= 17;
}

test "short formatting small values" {
    // 0.1 cannot be exactly represented in binary
    let r01 = short(0.1);
    assert r01.digits > 0 as i64;
    assert r01.exponent < 0;

    // 0.5 = 1/2 can be exactly represented
    let r05 = short(0.5);
    assert r05.digits == 5 as i64;
    assert r05.exponent == -1;
}

test "short formatting large values" {
    // Large power of 2
    let r = short(1048576.0);  // 2^20
    assert r.digits > 0 as i64;
}

test "fixed_width formatting" {
    // fixed_width(1.0, 1) should give 1 digit
    let r1 = fixed_width(1.0, 1);
    assert r1.digits == 1 as i64;

    // fixed_width(pi, 4) should give 4 digits
    let pi = 3.141592653589793;
    let r4 = fixed_width(pi, 4);
    // Should be 3142 (rounded)
    assert digits(r4.digits) == 4;
}

test "f64_to_string special values" {
    // Zero
    let s0 = f64_to_string(0.0);
    assert s0 == "0e+00";

    // Negative zero
    let sn0 = f64_to_string(-0.0);
    assert sn0 == "-0e+00";
}

test "f64_to_string basic" {
    // 1.0 should format to "1e+00"
    let s1 = f64_to_string(1.0);
    assert s1 == "1e+00";

    // 10.0 should format to "1e+01"
    let s10 = f64_to_string(10.0);
    assert s10 == "1e+01";

    // 100.0 should format to "1e+02"
    let s100 = f64_to_string(100.0);
    assert s100 == "1e+02";
}

test "f64_to_string small values" {
    // 0.5 should format to "5e-01"
    let s05 = f64_to_string(0.5);
    assert s05 == "5e-01";

    // 0.01 should format to "1e-02"
    let s001 = f64_to_string(0.01);
    assert s001 == "1e-02";
}

test "trim_zeros" {
    // 1000 should trim to 1 with exponent +3
    let t1 = trim_zeros(1000 as i64, 0);
    assert t1.0 == 1 as i64;
    assert t1.1 == 3;

    // 1200 should trim to 12 with exponent +2
    let t2 = trim_zeros(1200 as i64, 0);
    assert t2.0 == 12 as i64;
    assert t2.1 == 2;

    // 123 has no trailing zeros
    let t3 = trim_zeros(123 as i64, 0);
    assert t3.0 == 123 as i64;
    assert t3.1 == 0;
}

test "rotate_right" {
    // Rotate 0x80 right by 4 should give 0x08 (for 8-bit value conceptually)
    // For 64-bit: rotating 1 right by 1 puts 1 in MSB
    let r1 = rotate_right(1 as i64, 1);
    assert r1 == 0x8000000000000000 as i64;

    // Rotate 0x8000000000000000 right by 1 should give 0x4000000000000000
    let r2 = rotate_right(0x8000000000000000 as i64, 1);
    assert r2 == 0x4000000000000000 as i64;
}

test "logical_shr" {
    // Logical shift of negative number should not sign-extend
    let neg = 0x8000000000000000 as i64;  // -9223372036854775808
    let shifted = logical_shr(neg, 1);
    // Should be 0x4000000000000000, not 0xC000000000000000
    assert shifted == 0x4000000000000000 as i64;

    // Shift by 63 should leave just the sign bit
    let shifted63 = logical_shr(neg, 63);
    assert shifted63 == 1 as i64;
}

test "f64_to_string negative values" {
    // Negative 1.0
    let sn1 = f64_to_string(-1.0);
    assert sn1 == "-1e+00";

    // Negative pi
    let snpi = f64_to_string(-3.141592653589793);
    // Should start with "-"
    assert snpi.get(0) == '-' as i32;
}

test "f64_to_string powers of 10" {
    // Large powers
    let s10 = f64_to_string(10.0);
    assert s10 == "1e+01";

    let s100 = f64_to_string(100.0);
    assert s100 == "1e+02";

    let s1000 = f64_to_string(1000.0);
    assert s1000 == "1e+03";

    // Small powers
    let s01 = f64_to_string(0.01);
    assert s01 == "1e-02";

    let s001 = f64_to_string(0.001);
    assert s001 == "1e-03";
}

test "f64_to_string precision" {
    // Verify that non-round values have correct precision
    let pi = 3.141592653589793;
    let s = f64_to_string(pi);
    // Should have many digits
    assert s.len() > 10;
    // Should start with "3.14"
    assert s.get(0) == '3' as i32;
    assert s.get(1) == '.' as i32;
    assert s.get(2) == '1' as i32;
    assert s.get(3) == '4' as i32;
}

// ============================================================================
// Extended test cases ported from Go fpfmt_test.go
// ============================================================================

test "powers of 2" {
    // Test powers of 2 which have exact binary representations
    // 2^0 = 1
    let r0 = short(1.0);
    assert r0.digits == 1 as i64;
    assert r0.exponent == 0;

    // 2^1 = 2
    let r1 = short(2.0);
    assert r1.digits == 2 as i64;
    assert r1.exponent == 0;

    // 2^10 = 1024
    let r10 = short(1024.0);
    assert r10.digits > 0 as i64;

    // 2^-1 = 0.5
    let rm1 = short(0.5);
    assert rm1.digits == 5 as i64;
    assert rm1.exponent == -1;

    // 2^-2 = 0.25
    let rm2 = short(0.25);
    assert rm2.digits == 25 as i64;
    assert rm2.exponent == -2;

    // 2^-10 = 0.0009765625
    let rm10 = short(0.0009765625);
    assert rm10.digits > 0 as i64;
}

test "extended powers of 10" {
    // 10^0 = 1
    let r0 = short(1.0);
    assert r0.digits == 1 as i64;
    assert r0.exponent == 0;

    // 10^1 = 10
    let r1 = short(10.0);
    assert r1.digits == 1 as i64;
    assert r1.exponent == 1;

    // 10^2 = 100
    let r2 = short(100.0);
    assert r2.digits == 1 as i64;
    assert r2.exponent == 2;

    // 10^6 = 1000000
    let r6 = short(1000000.0);
    assert r6.digits == 1 as i64;
    assert r6.exponent == 6;

    // 10^9 = 1000000000
    let r9 = short(1000000000.0);
    assert r9.digits == 1 as i64;
    assert r9.exponent == 9;

    // 10^-1 = 0.1
    let rm1 = short(0.1);
    assert rm1.exponent < 0;

    // 10^-6 = 0.000001
    let rm6 = short(0.000001);
    assert rm6.exponent < 0;
}

test "short specific values" {
    // Test specific values that have known shortest representations
    // 1.5
    let r15 = short(1.5);
    assert r15.digits == 15 as i64;
    assert r15.exponent == -1;

    // 1.25
    let r125 = short(1.25);
    assert r125.digits == 125 as i64;
    assert r125.exponent == -2;

    // 1.125
    let r1125 = short(1.125);
    assert r1125.digits == 1125 as i64;
    assert r1125.exponent == -3;

    // 0.125 = 1/8
    let r0125 = short(0.125);
    assert r0125.digits == 125 as i64;
    assert r0125.exponent == -3;
}

test "fixed_width various digits" {
    // Test fixed_width with different digit counts
    let pi = 3.141592653589793;

    // 1 digit
    let f1 = fixed_width(pi, 1);
    assert digits(f1.digits) == 1;

    // 3 digits
    let f3 = fixed_width(pi, 3);
    assert digits(f3.digits) == 3;

    // 6 digits
    let f6 = fixed_width(pi, 6);
    assert digits(f6.digits) == 6;

    // 10 digits
    let f10 = fixed_width(pi, 10);
    assert digits(f10.digits) == 10;

    // 17 digits (max precision for f64)
    let f17 = fixed_width(pi, 17);
    assert digits(f17.digits) == 17;
}

test "negative values symmetry" {
    // Test that negative values produce same digits with negative sign
    let pos = short(123.456);
    let neg = short(-123.456);
    assert pos.digits == neg.digits;
    assert pos.exponent == neg.exponent;
}

test "f64_to_string extended" {
    // Very large value
    let large = f64_to_string(1.0e100);
    assert large.len() > 0;
    // Should contain e+100
    assert large.get(large.len() - 3) == '1' as i32;
    assert large.get(large.len() - 2) == '0' as i32;
    assert large.get(large.len() - 1) == '0' as i32;

    // Very small value
    let small = f64_to_string(1.0e-100);
    assert small.len() > 0;
    // Should contain e-100

    // Value near 1
    let near1 = f64_to_string(1.0000001);
    assert near1.len() > 0;
}

test "round trip consistency" {
    // Test that short produces consistent results for values
    // that should have short representations

    // Integers up to certain size should be exact
    let i1 = short(1.0);
    let i2 = short(2.0);
    let i3 = short(3.0);
    let i9 = short(9.0);

    assert i1.digits == 1 as i64;
    assert i2.digits == 2 as i64;
    assert i3.digits == 3 as i64;
    assert i9.digits == 9 as i64;

    assert i1.exponent == 0;
    assert i2.exponent == 0;
    assert i3.exponent == 0;
    assert i9.exponent == 0;
}

test "boundary digits" {
    // Test values at digit boundaries
    // 9, 99, 999, etc. - values just before power of 10
    let r9 = short(9.0);
    assert r9.digits == 9 as i64;
    assert r9.exponent == 0;

    let r99 = short(99.0);
    assert r99.digits == 99 as i64;
    assert r99.exponent == 0;

    let r999 = short(999.0);
    assert r999.digits == 999 as i64;
    assert r999.exponent == 0;

    // 11, 101, 1001, etc. - values just after power of 10
    let r11 = short(11.0);
    assert r11.digits == 11 as i64;
    assert r11.exponent == 0;

    let r101 = short(101.0);
    assert r101.digits == 101 as i64;
    assert r101.exponent == 0;
}

test "hard boundary cases from bits" {
    // Test specific IEEE 754 bit patterns that are known hard cases
    // These are values near rounding boundaries

    // Smallest positive normal number: 2^-1022
    // Bit pattern: 0x0010000000000000
    let min_normal_bits = 0x0010000000000000 as i64;
    let min_normal = builtin::f64_reinterpret_i64(min_normal_bits);
    let r_min = short(min_normal);
    assert r_min.digits > 0 as i64;

    // Largest positive finite number: (2-2^-52) * 2^1023
    // Bit pattern: 0x7FEFFFFFFFFFFFFF
    let max_finite_bits = 0x7FEFFFFFFFFFFFFF as i64;
    let max_finite = builtin::f64_reinterpret_i64(max_finite_bits);
    let r_max = short(max_finite);
    assert r_max.digits > 0 as i64;

    // 1.0 exactly: bit pattern 0x3FF0000000000000
    let one_bits = 0x3FF0000000000000 as i64;
    let one = builtin::f64_reinterpret_i64(one_bits);
    let r_one = short(one);
    assert r_one.digits == 1 as i64;
    assert r_one.exponent == 0;

    // 2.0 exactly: bit pattern 0x4000000000000000
    let two_bits = 0x4000000000000000 as i64;
    let two = builtin::f64_reinterpret_i64(two_bits);
    let r_two = short(two);
    assert r_two.digits == 2 as i64;
    assert r_two.exponent == 0;
}

test "nextafter boundary cases" {
    // Test values just above and below powers of 10
    // These are typically hard cases for float-to-string conversion

    // Just above 1.0: nextafter(1.0, 2.0)
    // Bit pattern: 0x3FF0000000000001
    let above_one_bits = 0x3FF0000000000001 as i64;
    let above_one = builtin::f64_reinterpret_i64(above_one_bits);
    let r_above = short(above_one);
    // Should produce more digits than just "1"
    assert r_above.digits > 1 as i64;

    // Just below 1.0: nextafter(1.0, 0.0)
    // Bit pattern: 0x3FEFFFFFFFFFFFFF
    let below_one_bits = 0x3FEFFFFFFFFFFFFF as i64;
    let below_one = builtin::f64_reinterpret_i64(below_one_bits);
    let r_below = short(below_one);
    // Should produce digits with negative exponent
    assert r_below.digits > 0 as i64;
}

test "subnormal numbers" {
    // Test subnormal (denormalized) numbers
    // Smallest positive subnormal: 2^-1074
    // Bit pattern: 0x0000000000000001
    let min_subnormal_bits = 0x0000000000000001 as i64;
    let min_subnormal = builtin::f64_reinterpret_i64(min_subnormal_bits);
    let r_min_sub = short(min_subnormal);
    assert r_min_sub.digits > 0 as i64;
    // Exponent should be very negative (around -324)
    assert r_min_sub.exponent < -300;

    // Largest subnormal: just below 2^-1022
    // Bit pattern: 0x000FFFFFFFFFFFFF
    let max_subnormal_bits = 0x000FFFFFFFFFFFFF as i64;
    let max_subnormal = builtin::f64_reinterpret_i64(max_subnormal_bits);
    let r_max_sub = short(max_subnormal);
    assert r_max_sub.digits > 0 as i64;
}

test "scientific notation extremes" {
    // Test extreme values that require large exponents
    // 1e200 (large but within range)
    let large = 1.0e200;
    let s_large = f64_to_string(large);
    assert s_large.len() > 0;

    // 1e-200 (small but within range)
    let small = 1.0e-200;
    let s_small = f64_to_string(small);
    assert s_small.len() > 0;
}

test "specific hard values from Go tests" {
    // Values extracted from Go fpfmt_test.go
    // These are at decimal rounding boundaries

    // Test value in middle range
    let val2 = 1.23456789012345678;
    let r2 = short(val2);
    // Should have approximately 17 digits of precision
    assert digits(r2.digits) <= 17;

    // Test exact power of 2
    let val3 = 1.0 / 1024.0;  // 2^-10 = 0.0009765625
    let r3 = short(val3);
    assert r3.digits > 0 as i64;
}

test "format consistency" {
    // Test that f64_to_string and short produce consistent results
    let pi = 3.141592653589793;
    let short_result = short(pi);
    let str_result = f64_to_string(pi);

    // The string should start with the digits from short
    assert str_result.len() > 0;
    // First digit should match
    let mut first_digit = short_result.digits;
    while first_digit >= 10 as i64 {
        first_digit = first_digit / 10 as i64;
    }
    assert str_result.get(0) == ('0' as i32) + (first_digit as i32);
}

// ============================================================================
// Benchmark helper functions
// ============================================================================

fn truncate_str(s: String, max_len: i32) -> String {
    if s.len() <= max_len {
        return s;
    }
    let mut result = String::with_capacity(max_len + 3);
    for let mut i = 0; i < max_len - 3; i += 1 {
        result.append(char_to_string(s.get(i) as char));
    }
    result.append("...");
    return result;
}

fn pad_right(s: String, width: i32) -> String {
    let mut result = s;
    while result.len() < width {
        result.append(" ");
    }
    return result;
}

fn i32_to_str(n: i32) -> String {
    if n == 0 { return "0"; }
    let mut result = String::with_capacity(12);
    let mut val = n;
    let is_neg = val < 0;
    if is_neg { val = -val; }

    let mut digits: Array<i32> = [];
    while val > 0 {
        digits.append(val % 10);
        val = val / 10;
    }

    if is_neg { result.append("-"); }
    let mut i = digits.len() - 1;
    while i >= 0 {
        result.append(char_to_string((('0' as i32) + digits.get(i)) as char));
        i = i - 1;
    }
    return result;
}

fn u64_to_str(n: u64) -> String {
    if n == 0 as u64 { return "0"; }
    let mut result = String::with_capacity(20);
    let mut val = n;

    let mut digits: Array<i32> = [];
    while val > 0 as u64 {
        digits.append((val % 10 as u64) as i32);
        val = val / 10 as u64;
    }

    let mut i = digits.len() - 1;
    while i >= 0 {
        result.append(char_to_string((('0' as i32) + digits.get(i)) as char));
        i = i - 1;
    }
    return result;
}

// Entry point for running
fn run() with Stdout, MonotonicClock {
    println("======================================================================");
    println("Float-to-String Benchmark: fpfmt vs ryu (internal::f64_to_string)");
    println("======================================================================");
    println("");
    println("fpfmt: Russ Cox's unrounded scaling algorithm (this file)");
    println("ryu:   Bundled ryu-based f64_to_buffer (wado-bundled)");
    println("");

    // Number of iterations per test
    let iterations = 10000;

    // Test categories
    benchmark_category("Integers", iterations, [1.0, 10.0, 100.0, 1000.0, 10000.0]);
    benchmark_category("Decimals", iterations, [0.1, 0.01, 0.001, 0.0001, 0.00001]);
    benchmark_category("Pi variants", iterations, [3.141592653589793, 31.41592653589793, 0.3141592653589793]);
    benchmark_category("Large values", iterations, [1.0e50, 1.0e100, 1.0e200]);
    benchmark_category("Small values", iterations, [1.0e-50, 1.0e-100, 1.0e-200]);
    benchmark_category("Powers of 2", iterations, [0.5, 0.25, 0.125, 1024.0, 65536.0]);
    benchmark_category("Mixed precision", iterations, [1.23456789, 9.87654321, 1.111111111111111]);

    println("");
    println("======================================================================");
    println("Benchmark complete.");
    println("======================================================================");
}

fn benchmark_category(name: String, iterations: i32, values: Array<f64>) with Stdout, MonotonicClock {
    println(`\n--- {name} ---`);
    println("Value                      fpfmt(ns)    ryu(ns)       ratio");
    println("-----------------------------------------------------------------");

    for let val of values {
        benchmark_value(val, iterations);
    }
}

fn benchmark_value(val: f64, iterations: i32) with Stdout, MonotonicClock {
    // Benchmark fpfmt (this implementation)
    let start_fpfmt = now();
    for let mut i = 0; i < iterations; i += 1 {
        let _ = f64_to_string(val);
    }
    let end_fpfmt = now();
    let fpfmt_time = (end_fpfmt - start_fpfmt) / (iterations as u64);

    // Benchmark ryu (internal::f64_to_string)
    let start_ryu = now();
    for let mut i = 0; i < iterations; i += 1 {
        let _ = ryu_f64_to_string(val);
    }
    let end_ryu = now();
    let ryu_time = (end_ryu - start_ryu) / (iterations as u64);

    // Calculate ratio (fpfmt / ryu)
    let ratio = if ryu_time > 0 as u64 {
        (fpfmt_time as f64) / (ryu_time as f64)
    } else {
        0.0
    };

    // Format value for display (use our fpfmt implementation)
    let val_str = f64_to_string(val);
    let display_val = truncate_str(val_str, 24);
    let padded_val = pad_right(display_val, 25);

    // Build output line
    let fpfmt_str = format_ns(fpfmt_time);
    let ryu_str = format_ns(ryu_time);
    let ratio_str = format_ratio(ratio);

    let mut line = String::with_capacity(80);
    line.append(padded_val);
    line.append(" ");
    line.append(fpfmt_str);
    line.append("    ");
    line.append(ryu_str);
    line.append("     ");
    line.append(ratio_str);
    println(line);
}

fn format_ns(ns: u64) -> String {
    // Format nanoseconds with padding to 8 chars
    let s = u64_to_str(ns);
    let mut result = String::with_capacity(12);
    // Pad left with spaces
    let padding = 8 - s.len();
    for let mut i = 0; i < padding; i += 1 {
        result.append(" ");
    }
    result.append(s);
    return result;
}

fn format_ratio(ratio: f64) -> String {
    // Format ratio with 2 decimal places
    if ratio < 0.01 {
        return "~0.00x";
    }
    let whole = ratio as i32;
    let frac = ((ratio - (whole as f64)) * 100.0) as i32;
    let mut result = String::with_capacity(10);
    result.append(i32_to_str(whole));
    result.append(".");
    if frac < 10 {
        result.append("0");
    }
    result.append(i32_to_str(frac));
    result.append("x");
    return result;
}

