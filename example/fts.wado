    if idx == 396 { return PmHiLo { hi: 0xaf298d050e4395d7 as i64, lo: 0x698f4ed480bf0000 as i64 }; }
    if idx == 397 { return PmHiLo { hi: 0xdaf3f04651d47b4d as i64, lo: 0xc3f32289a0eec000 as i64 }; }
    if idx == 398 { return PmHiLo { hi: 0x88d8762bf324cd10 as i64, lo: 0x5a77f59604953800 as i64 }; }

    // Fallback for out-of-range indices
    return PmHiLo { hi: 0x8000000000000000 as i64, lo: 0x0000000000000000 as i64 };
}

// ============================================================================
// Tests
// ============================================================================

test "log approximations" {
    assert log10_pow2(10) == 3;
    assert log10_pow2(100) == 30;
    assert log2_pow10(3) == 9;
    assert log2_pow10(10) == 33;
}

test "bit length" {
    assert i64_bit_len(0 as i64) == 0;
    assert i64_bit_len(1 as i64) == 1;
    assert i64_bit_len(2 as i64) == 2;
    assert i64_bit_len(3 as i64) == 2;
    assert i64_bit_len(255 as i64) == 8;
    assert i64_bit_len(256 as i64) == 9;
}

test "unpack64 basic" {
    let r1 = unpack64(1.0);
    assert r1.mantissa != 0 as i64;

    let r2 = unpack64(2.0);
    assert r2.mantissa != 0 as i64;
}

test "pow10 function" {
    assert pow10(0) == 1 as i64;
    assert pow10(1) == 10 as i64;
    assert pow10(2) == 100 as i64;
    assert pow10(9) == 1000000000 as i64;
}

test "digits count" {
    assert digits(1 as i64) == 1;
    assert digits(9 as i64) == 1;
    assert digits(10 as i64) == 2;
    assert digits(99 as i64) == 2;
    assert digits(100 as i64) == 3;
    assert digits(999 as i64) == 3;
}

test "unsigned comparisons" {
    // Test that u64_lt handles sign bit correctly
    let a = 0x7FFFFFFFFFFFFFFF as i64;  // Max positive i64
    let b = 0x8000000000000000 as i64;  // Min negative i64, but largest u64/2
    // As unsigned: a < b
    assert u64_lt(a, b);
    assert !u64_lt(b, a);
}

test "short formatting basic values" {
    // 1.0 should format to 1 * 10^0
    let r1 = short(1.0);
    assert r1.digits == 1 as i64;
    assert r1.exponent == 0;

    // 10.0 should format to 1 * 10^1
    let r10 = short(10.0);
    assert r10.digits == 1 as i64;
    assert r10.exponent == 1;

    // 100.0 should format to 1 * 10^2
    let r100 = short(100.0);
    assert r100.digits == 1 as i64;
    assert r100.exponent == 2;

    // 2.0 should format to 2 * 10^0
    let r2 = short(2.0);
    assert r2.digits == 2 as i64;
    assert r2.exponent == 0;
}

test "short formatting pi" {
    let pi = 3.141592653589793;
    let r = short(pi);
    // Pi should produce many digits
    assert r.digits > 0 as i64;
    // The digit count should be reasonable
    assert digits(r.digits) <= 17;
}

test "short formatting small values" {
    // 0.1 cannot be exactly represented in binary
    let r01 = short(0.1);
    assert r01.digits > 0 as i64;
    assert r01.exponent < 0;

    // 0.5 = 1/2 can be exactly represented
    let r05 = short(0.5);
    assert r05.digits == 5 as i64;
    assert r05.exponent == -1;
}

test "short formatting large values" {
    // Large power of 2
    let r = short(1048576.0);  // 2^20
    assert r.digits > 0 as i64;
}

test "fixed_width formatting" {
    // fixed_width(1.0, 1) should give 1 digit
    let r1 = fixed_width(1.0, 1);
    assert r1.digits == 1 as i64;

    // fixed_width(pi, 4) should give 4 digits
    let pi = 3.141592653589793;
    let r4 = fixed_width(pi, 4);
    // Should be 3142 (rounded)
    assert digits(r4.digits) == 4;
}

test "f64_to_string special values" {
    // Zero
    let s0 = f64_to_string(0.0);
    assert s0 == "0e+00";

    // Negative zero
    let sn0 = f64_to_string(-0.0);
    assert sn0 == "-0e+00";
}

test "f64_to_string basic" {
    // 1.0 should format to "1e+00"
    let s1 = f64_to_string(1.0);
    assert s1 == "1e+00";

    // 10.0 should format to "1e+01"
    let s10 = f64_to_string(10.0);
    assert s10 == "1e+01";

    // 100.0 should format to "1e+02"
    let s100 = f64_to_string(100.0);
    assert s100 == "1e+02";
}

test "f64_to_string small values" {
    // 0.5 should format to "5e-01"
    let s05 = f64_to_string(0.5);
    assert s05 == "5e-01";

    // 0.01 should format to "1e-02"
    let s001 = f64_to_string(0.01);
    assert s001 == "1e-02";
}

test "trim_zeros" {
    // 1000 should trim to 1 with exponent +3
    let t1 = trim_zeros(1000 as i64, 0);
    assert t1.0 == 1 as i64;
    assert t1.1 == 3;

    // 1200 should trim to 12 with exponent +2
    let t2 = trim_zeros(1200 as i64, 0);
    assert t2.0 == 12 as i64;
    assert t2.1 == 2;

    // 123 has no trailing zeros
    let t3 = trim_zeros(123 as i64, 0);
    assert t3.0 == 123 as i64;
    assert t3.1 == 0;
}

test "rotate_right" {
    // Rotate 0x80 right by 4 should give 0x08 (for 8-bit value conceptually)
    // For 64-bit: rotating 1 right by 1 puts 1 in MSB
    let r1 = rotate_right(1 as i64, 1);
    assert r1 == 0x8000000000000000 as i64;

    // Rotate 0x8000000000000000 right by 1 should give 0x4000000000000000
    let r2 = rotate_right(0x8000000000000000 as i64, 1);
    assert r2 == 0x4000000000000000 as i64;
}

test "logical_shr" {
    // Logical shift of negative number should not sign-extend
    let neg = 0x8000000000000000 as i64;  // -9223372036854775808
    let shifted = logical_shr(neg, 1);
    // Should be 0x4000000000000000, not 0xC000000000000000
    assert shifted == 0x4000000000000000 as i64;

    // Shift by 63 should leave just the sign bit
    let shifted63 = logical_shr(neg, 63);
    assert shifted63 == 1 as i64;
}

test "f64_to_string negative values" {
    // Negative 1.0
    let sn1 = f64_to_string(-1.0);
    assert sn1 == "-1e+00";

    // Negative pi
    let snpi = f64_to_string(-3.141592653589793);
    // Should start with "-"
    assert snpi.get(0) == '-' as i32;
}

test "f64_to_string powers of 10" {
    // Large powers
    let s10 = f64_to_string(10.0);
    assert s10 == "1e+01";

    let s100 = f64_to_string(100.0);
    assert s100 == "1e+02";

    let s1000 = f64_to_string(1000.0);
    assert s1000 == "1e+03";

    // Small powers
    let s01 = f64_to_string(0.01);
    assert s01 == "1e-02";

    let s001 = f64_to_string(0.001);
    assert s001 == "1e-03";
}

test "f64_to_string precision" {
    // Verify that non-round values have correct precision
    let pi = 3.141592653589793;
    let s = f64_to_string(pi);
    // Should have many digits
    assert s.len() > 10;
    // Should start with "3.14"
    assert s.get(0) == '3' as i32;
    assert s.get(1) == '.' as i32;
    assert s.get(2) == '1' as i32;
    assert s.get(3) == '4' as i32;
}

// Entry point for running
fn run() with Stdout {
    println("Float-to-String (fpfmt) conversion examples:");

    // Basic values
    println(`1.0 -> {f64_to_string(1.0)}`);
    println(`3.141592653589793 -> {f64_to_string(3.141592653589793)}`);
    println(`0.1 -> {f64_to_string(0.1)}`);
    println(`123.456 -> {f64_to_string(123.456)}`);

    // Special values
    println(`0.0 -> {f64_to_string(0.0)}`);
    println(`-0.0 -> {f64_to_string(-0.0)}`);

    // Powers of 10
    println(`1e10 -> {f64_to_string(10000000000.0)}`);
    println(`1e-10 -> {f64_to_string(0.0000000001)}`);

    println("All examples printed.");
}
