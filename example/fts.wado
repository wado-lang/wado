use {println, Stdout} from "core:cli";
use {now, MonotonicClock} from "core:clocks";
use {f64_to_string as ryu_f64_to_string, char_to_string} from "core:internal";

// ============================================================================
// Constants
// ============================================================================

fn POW10_MIN() -> i32 { return -348; }

// Powers of 10 from 10^0 to 10^19
fn pow10(n: i32) -> i64 {
    return match n {
        0 => 1 as i64,
        1 => 10 as i64,
        2 => 100 as i64,
        3 => 1000 as i64,
        4 => 10000 as i64,
        5 => 100000 as i64,
        6 => 1000000 as i64,
        7 => 10000000 as i64,
        8 => 100000000 as i64,
        9 => 1000000000 as i64,
        10 => 10000000000 as i64,
        11 => 100000000000 as i64,
        12 => 1000000000000 as i64,
        13 => 10000000000000 as i64,
        14 => 100000000000000 as i64,
        15 => 1000000000000000 as i64,
        16 => 10000000000000000 as i64,
        17 => 100000000000000000 as i64,
        18 => 1000000000000000000 as i64,
        _ => 0x8AC7230489E80000 as i64, // 10^19
    };
}

// ============================================================================
// Bit utilities
// ============================================================================

// Returns the bit length of x (position of highest set bit + 1)
fn i64_bit_len(x: i64) -> i32 {
    if x == 0 as i64 {
        return 0;
    }
    return 64 - (builtin::i64_clz(x) as i32);
}

fn bool2int(b: bool) -> i64 {
    if b { return 1 as i64; }
    return 0 as i64;
}

fn bool2int32(b: bool) -> i32 {
    if b { return 1; }
    return 0;
}

// ============================================================================
// Logarithm approximations
// ============================================================================

// log10_pow2(x) returns floor(log10(2^x)) = floor(x * log10(2))
fn log10_pow2(x: i32) -> i32 {
    return (x * 78913) >> 18;
}

// log2_pow10(x) returns floor(log2(10^x)) = floor(x * log2(10))
fn log2_pow10(x: i32) -> i32 {
    return (x * 108853) >> 15;
}

// ============================================================================
// Float unpacking
// ============================================================================

// Result of unpacking a float64
struct UnpackResult {
    mantissa: i64,
    exponent: i32,
}

// unpack64 returns (mantissa, exponent) such that f = mantissa * 2^exponent
fn unpack64(f: f64) -> UnpackResult {
    let bits = builtin::i64_reinterpret_f64(f);

    let mantissa_mask = 0x000FFFFFFFFFFFFF as i64;
    let exp_mask = 0x7FF as i64;
    let shift = 11;  // 64 - 53
    let min_exp = -1085;  // -(1074 + 11)

    let raw_mantissa = bits & mantissa_mask;
    let raw_exp = ((bits >> 52) & exp_mask) as i32;

    if raw_exp == 0 {
        if raw_mantissa == 0 as i64 {
            return UnpackResult { mantissa: 0 as i64, exponent: 0 };
        }
        let m = raw_mantissa << shift;
        let e = min_exp;
        let s = 64 - i64_bit_len(m);
        return UnpackResult { mantissa: m << s, exponent: e - s };
    }

    let m = (0x8000000000000000 as i64) | (raw_mantissa << shift);
    let e = (raw_exp - 1) + min_exp;
    return UnpackResult { mantissa: m, exponent: e };
}

// ============================================================================
// Unrounded arithmetic
// ============================================================================

fn unrounded_floor(u: i64) -> i64 {
    return (u + 0 as i64) >> 2;
}

fn unrounded_round(u: i64) -> i64 {
    return (u + 1 as i64 + ((u >> 2) & 1 as i64)) >> 2;
}

fn unrounded_ceil(u: i64) -> i64 {
    return (u + 3 as i64) >> 2;
}

fn unrounded_nudge(u: i64, delta: i32) -> i64 {
    return u + (delta as i64);
}

fn unrounded_div(u: i64, d: i64) -> i64 {
    let q = u / d;
    let r = u % d;
    return q | (u & 1 as i64) | bool2int(r != 0 as i64);
}

// ============================================================================
// Unsigned comparisons (treating i64 as u64)
// ============================================================================

fn u64_lt(a: i64, b: i64) -> bool {
    let sign_bit = 0x8000000000000000 as i64;
    return (a ^ sign_bit) < (b ^ sign_bit);
}

fn u64_ge(a: i64, b: i64) -> bool {
    let sign_bit = 0x8000000000000000 as i64;
    return (a ^ sign_bit) >= (b ^ sign_bit);
}

fn u64_le(a: i64, b: i64) -> bool {
    let sign_bit = 0x8000000000000000 as i64;
    return (a ^ sign_bit) <= (b ^ sign_bit);
}

// ============================================================================
// Power of 10 table entry
// ============================================================================

struct PmHiLo {
    hi: i64,
    lo: i64,
}

// ============================================================================
// Scaling
// ============================================================================

fn get_pow10(p: i32) -> PmHiLo {
    let idx = p - POW10_MIN();
    return pow10_tab(idx);
}

// uscale computes unround(x * 2^e * 10^p) using the pow10 table
fn uscale(x: i64, pm_hi: i64, pm_lo: i64, s: i32) -> i64 {
    // Note: i64_mul_wide_u returns [low, high] but Go's bits.Mul64 returns (high, low)
    let [mid, hi_tmp] = builtin::i64_mul_wide_u(x, pm_hi);
    let mut hi = hi_tmp;

    let mut sticky = 1 as i64;

    let s_mod_64 = s & 63;
    let check_mask = (1 as i64 << s_mod_64) - 1 as i64;
    if (hi & check_mask) == 0 as i64 {
        let [mid2, _] = builtin::i64_mul_wide_u(x, pm_lo);
        sticky = bool2int((mid - mid2) > 1 as i64);
        hi = hi - bool2int(u64_lt(mid, mid2));
    }

    // Use logical shift (not arithmetic) for unsigned semantics
    return logical_shr(hi, s) | sticky;
}

// ============================================================================
// Main formatting functions
// ============================================================================

// Result of formatting
struct FormatResult {
    digits: i64,
    exponent: i32,
}

// FixedWidth returns the n-digit decimal form of f
fn fixed_width(f: f64, n: i32) -> FormatResult {
    if n > 18 {
        panic("too many digits");
    }

    let unpack = unpack64(f);
    let m = unpack.mantissa;
    let e = unpack.exponent;

    let p = n - 1 - log10_pow2(e + 63);
    let lp = log2_pow10(p);
    let pm = get_pow10(p);
    let s = -(e + lp + 3);

    let u = uscale(m, pm.hi, pm.lo, s);
    let mut d = unrounded_round(u);

    if u64_ge(d, pow10(n)) {
        d = unrounded_round(unrounded_div(u, 10 as i64));
        return FormatResult { digits: d, exponent: -p + 1 };
    }

    return FormatResult { digits: d, exponent: -p };
}

// Short computes the shortest formatting of f that round-trips
fn short(f: f64) -> FormatResult {
    let min_exp = -1085;

    let unpack = unpack64(f);
    let m = unpack.mantissa;
    let e = unpack.exponent;

    let mut min_m: i64 = 0 as i64;
    let mut z = 11;
    let mut p: i32 = 0;

    let m_is_power_of_2 = m == (0x8000000000000000 as i64);
    if m_is_power_of_2 && e > min_exp {
        p = -skewed(e + z);
        min_m = m - (1 as i64 << (z - 2));
    } else {
        if e < min_exp {
            z = 11 + (min_exp - e);
        }
        p = -log10_pow2(e + z);
        min_m = m - (1 as i64 << (z - 1));
    }

    let max_m = m + (1 as i64 << (z - 1));
    let odd = ((m >> z) & 1 as i64) as i32;

    let lp = log2_pow10(p);
    let pm = get_pow10(p);
    let s = -(e + lp + 3);

    let dmin = unrounded_ceil(unrounded_nudge(uscale(min_m, pm.hi, pm.lo, s), odd));
    let dmax = unrounded_floor(unrounded_nudge(uscale(max_m, pm.hi, pm.lo, s), -odd));

    // Check if we can trim to fewer digits
    let d_div_10 = dmax / 10 as i64;
    let can_trim = d_div_10 * 10 as i64 >= dmin;

    if can_trim {
        let trimmed = trim_zeros(d_div_10, -(p - 1));
        return FormatResult { digits: trimmed.0, exponent: trimmed.1 };
    }

    let mut d = dmin;
    if dmin < dmax {
        d = unrounded_round(uscale(m, pm.hi, pm.lo, s));
    }
    return FormatResult { digits: d, exponent: -p };
}

fn skewed(e: i32) -> i32 {
    return (e * 631305 - 261663) >> 21;
}

// Unsigned multiply (low 64 bits only, modular)
fn u64_mul(a: i64, b: i64) -> i64 {
    // Use wide multiply and take the low part
    let [lo, _] = builtin::i64_mul_wide_u(a, b);
    return lo;  // Low 64 bits
}

fn trim_zeros(x: i64, p: i32) -> [i64, i32] {
    let max_u64 = 0xFFFFFFFFFFFFFFFF as i64;
    let inv5 = 0xcccccccccccccccd as i64;
    let inv5p2 = 0x8f5c28f5c28f5c29 as i64;
    let inv5p4 = 0xd288ce703afb7e91 as i64;
    let inv5p8 = 0xc767074b22e90e21 as i64;

    // Threshold values (need unsigned comparison)
    let thresh_10 = 1844674407370955161 as i64;  // maxUint64 / 10
    let thresh_100 = 184467440737095516 as i64;  // maxUint64 / 100
    let thresh_10000 = 1844674407370955 as i64;  // maxUint64 / 10000
    let thresh_1e8 = 184467440737 as i64;        // maxUint64 / 100000000

    let mut xv = x;
    let mut pv = p;

    let d1 = rotate_right(u64_mul(xv, inv5), 1);
    if u64_le(d1, thresh_10) {
        xv = d1;
        pv = pv + 1;
    } else {
        return [xv, pv];
    }

    let d8 = rotate_right(u64_mul(xv, inv5p8), 8);
    if u64_le(d8, thresh_1e8) {
        xv = d8;
        pv = pv + 8;
    }

    let d4 = rotate_right(u64_mul(xv, inv5p4), 4);
    if u64_le(d4, thresh_10000) {
        xv = d4;
        pv = pv + 4;
    }

    let d2 = rotate_right(u64_mul(xv, inv5p2), 2);
    if u64_le(d2, thresh_100) {
        xv = d2;
        pv = pv + 2;
    }

    let d1b = rotate_right(u64_mul(xv, inv5), 1);
    if u64_le(d1b, thresh_10) {
        xv = d1b;
        pv = pv + 1;
    }

    return [xv, pv];
}

// Logical right shift for unsigned semantics on i64
fn logical_shr(x: i64, n: i32) -> i64 {
    if n <= 0 { return x; }
    if n >= 64 { return 0 as i64; }
    // Use arithmetic shift, then mask off sign-extended bits
    // The mask has (64-n) ones in the low bits
    let mask = shr_mask(n);
    return (x >> n) & mask;
}

// Get mask for logical shift: (1 << (64-n)) - 1
fn shr_mask(n: i32) -> i64 {
    if n <= 0 { return 0xFFFFFFFFFFFFFFFF as i64; }
    if n >= 64 { return 0 as i64; }
    // Build the mask: all 1s in the low (64-n) bits
    // For n=1: 0x7FFFFFFFFFFFFFFF
    // For n=8: 0x00FFFFFFFFFFFFFF
    // We can compute this as: if (64-n) >= 64 then -1, else (1 << (64-n)) - 1
    let remaining = 64 - n;
    if remaining >= 63 {
        return 0x7FFFFFFFFFFFFFFF as i64;
    }
    return (1 as i64 << remaining) - 1 as i64;
}

fn rotate_right(x: i64, n: i32) -> i64 {
    return logical_shr(x, n) | (x << (64 - n));
}

// digits returns the number of decimal digits in d
fn digits(d: i64) -> i32 {
    let nd = log10_pow2(i64_bit_len(d));
    return nd + bool2int32(u64_ge(d, pow10(nd)));
}

// ============================================================================
// String formatting helpers
// ============================================================================

fn i2a_first(n: i32) -> char {
    return (('0' as i32) + n / 10) as char;
}

fn i2a_second(n: i32) -> char {
    return (('0' as i32) + n % 10) as char;
}

// Format result to exponential string
pub fn format_exp(d: i64, p: i32, nd: i32) -> String {
    let mut buf = String::with_capacity(30);

    // Format digits
    let mut val = d;
    let mut digit_chars: Array<i32> = [];
    for let mut i = 0; i < nd; i += 1 {
        digit_chars.append(0);
    }

    let mut idx = nd - 1;
    while idx >= 0 {
        digit_chars.set(idx, ('0' as i32) + ((val % 10 as i64) as i32));
        val = val / 10 as i64;
        idx = idx - 1;
    }

    // First digit
    append_char(&mut buf, digit_chars.get(0) as char);

    // Decimal point and remaining digits
    if nd > 1 {
        append_char(&mut buf, '.');
        for let mut i = 1; i < nd; i += 1 {
            append_char(&mut buf, digit_chars.get(i) as char);
        }
    }

    // Exponent
    let exp = p + nd - 1;
    append_char(&mut buf, 'e');
    if exp < 0 {
        append_char(&mut buf, '-');
    } else {
        append_char(&mut buf, '+');
    }

    let abs_exp = if exp < 0 { -exp } else { exp };
    if abs_exp < 10 {
        append_char(&mut buf, '0');
        append_char(&mut buf, (('0' as i32) + abs_exp) as char);
    } else if abs_exp < 100 {
        append_char(&mut buf, i2a_first(abs_exp));
        append_char(&mut buf, i2a_second(abs_exp));
    } else {
        append_char(&mut buf, (('0' as i32) + abs_exp / 100) as char);
        append_char(&mut buf, i2a_first(abs_exp % 100));
        append_char(&mut buf, i2a_second(abs_exp % 100));
    }

    return buf;
}

fn append_char(buf: &mut String, c: char) {
    buf.append(char_to_string(c));
}

// ============================================================================
// Public API
// ============================================================================

// Convert f64 to string using shortest representation
pub fn f64_to_string(f: f64) -> String {
    let bits = builtin::i64_reinterpret_f64(f);

    // Check for zero
    if bits == 0 as i64 {
        return "0e+00";
    }
    if bits == 0x8000000000000000 as i64 {
        return "-0e+00";
    }

    let is_neg = bits < 0 as i64;
    let abs_f = if is_neg { -f } else { f };

    // Check for infinity/NaN
    let exp_mask = 0x7FF0000000000000 as i64;
    let mantissa_mask = 0x000FFFFFFFFFFFFF as i64;
    if (bits & exp_mask) == exp_mask {
        if (bits & mantissa_mask) != 0 as i64 {
            return "NaN";
        }
        if is_neg {
            return "-Inf";
        }
        return "Inf";
    }

    let result = short(abs_f);
    let d = result.digits;
    let p = result.exponent;
    let nd = digits(d);

    let formatted = format_exp(d, p, nd);

    if is_neg {
        return String::concat("-", formatted);
    }
    return formatted;
}

// ============================================================================
// Power of 10 table
// ============================================================================


// ============================================================================
// Power of 10 table
// ============================================================================

fn pow10_tab_0(idx: i32) -> PmHiLo {
    if idx == 0 { return PmHiLo { hi: 0xfa8fd5a0081c0289 as i64, lo: 0xe8cd3796329f1bac as i64 }; }
    if idx == 1 { return PmHiLo { hi: 0x9c99e58405118196 as i64, lo: 0xf18042bddfa3714b as i64 }; }
    if idx == 2 { return PmHiLo { hi: 0xc3c05ee50655e1fb as i64, lo: 0xade0536d578c4d9e as i64 }; }
    if idx == 3 { return PmHiLo { hi: 0xf4b0769e47eb5a79 as i64, lo: 0x19586848ad6f6106 as i64 }; }
    if idx == 4 { return PmHiLo { hi: 0x98ee4a22ecf3188c as i64, lo: 0x6fd7412d6c659ca3 as i64 }; }
    if idx == 5 { return PmHiLo { hi: 0xbf29dcaba82fdeaf as i64, lo: 0x8bcd1178c77f03cc as i64 }; }
    if idx == 6 { return PmHiLo { hi: 0xeef453d6923bd65b as i64, lo: 0xeec055d6f95ec4c0 as i64 }; }
    if idx == 7 { return PmHiLo { hi: 0x9558b4661b6565f9 as i64, lo: 0xb53835a65bdb3af8 as i64 }; }
    if idx == 8 { return PmHiLo { hi: 0xbaaee17fa23ebf77 as i64, lo: 0xa286430ff2d209b6 as i64 }; }
    if idx == 9 { return PmHiLo { hi: 0xe95a99df8ace6f54 as i64, lo: 0x0b27d3d3ef868c23 as i64 }; }
    if idx == 10 { return PmHiLo { hi: 0x91d8a02bb6c10595 as i64, lo: 0x86f8e46475b41796 as i64 }; }
    if idx == 11 { return PmHiLo { hi: 0xb64ec836a47146fa as i64, lo: 0x68b71d7d93211d7b as i64 }; }
    if idx == 12 { return PmHiLo { hi: 0xe3e27a444d8d98b8 as i64, lo: 0x02e4e4dcf7e964da as i64 }; }
    if idx == 13 { return PmHiLo { hi: 0x8e6d8c6ab0787f73 as i64, lo: 0x01cf0f0a1af1df08 as i64 }; }
