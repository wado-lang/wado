// A tour of package dependencies:
//   - wado-lang:cm-catalog — a library component fetched from an OCI registry
//     and imported directly by its coordinate, resolved across the Component
//     Model boundary (the compiler fetches the component and composes it in).
//   - gale — a Kiln generator that turns `Calc.g4` into a parser at compile
//     time. Consumed from the registry via the `[build-dependencies]` entry
//     `wado-lang:gale` (the published `core:kiln/generator` world).

use { println, Stdout } from "core:cli";
use { CmCatalog } from "wado-lang:cm-catalog";
use calc from "./Calc.g4"
    with {
        generator: {
            module: "wado-lang:gale",
            options: { highlight: false, trace: false },
        },
    };
// A registry generator's options come from its component WIT, which
// carries no field defaults — so every field is supplied explicitly.


export fn run() with Stdout, CmCatalog {
    // 1. Round-trip values through the cm-catalog registry component.
    let n = CmCatalog::id_u32(42);
    let s = CmCatalog::id_string("hello");
    let bytes: List<u8> = [1, 2, 3];
    let back = CmCatalog::id_list_u8(bytes);

    println(`id_u32(42)      = {n}`);
    println(`id_string       = {s}`);
    println(`id_list_u8 len  = {back.len()}`);

    assert n == 42;
    assert s == "hello";
    assert back.len() == 3;
    println("round-trip OK");

    // 2. Parse an expression with the gale-generated calculator parser.
    let parsed = calc::parse("1 + 2 * 3");
    assert parsed.ok();
    println("gale parsed \"1 + 2 * 3\" OK");
}
