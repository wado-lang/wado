// The `__DATA__` data section is a first-class part of a module (reachable via
// `#data`), so it must be rendered — muted like a comment, not dropped.
test "highlight __DATA__ section" {
    let src = "fn f() { }\n\n__DATA__\ndata body\n";
    let html = wado::highlight(&src);
    assert html.contains("<span class=\"comment\">__DATA__"), "data section should be highlighted";
}

// Grammar-gap coverage: constructs used across the E2E fixtures that the
// example grammar did not accept until each was modeled.
test "highlight flags declaration" {
    assert_highlights(&"pub flags Perms { Read, Write }\n");
}

test "highlight unit value and type" {
    assert_highlights(&"struct S { u: () }\nfn f() -> () { let t = [1, ()]; return (); }\n");
}

test "highlight labeled block" {
    assert_highlights(&"fn f() { scope: { break scope; } let r = outer: { break outer: 5; }; }\n");
}

test "highlight mut struct destructuring" {
    assert_highlights(&"struct P { x: i32, y: i32 }\nfn f(p: P) { let mut { x: mx, y: my } = p; mx += 1; }\n");
}

test "highlight turbofish wildcard type" {
    assert_highlights(&"fn f() { let x = pick::<_, bool>(1, true); }\n");
}

test "highlight array type in variant payload" {
    assert_highlights(&"variant V { Rect([f64, f64]), Pt }\ntype T = Foo<[i32, i32], bool>;\n");
}

test "highlight chained tuple index" {
    assert_highlights(&"fn f() { let t = [[1, 2], [3, 4]]; assert t.0.0 == 1; }\n");
}

test "highlight fn-type effect before next param" {
    assert_highlights(&"fn a(f: fn() with Stdout, x: i32) with Stdout { f(); }\n");
}

test "highlight nested template string" {
    assert_highlights(&"fn f() -> String { let n = 1; return `outer {`inner {n}`}`; }\n");
}

// Stdlib coverage: representative `wado-compiler/lib` modules exercising the
// WIT-binding and stdlib syntax the grammar grew to accept (resources, worlds,
// interfaces, `#[cm]` attributes, block expressions, contextual-keyword names,
// unicode escapes, `for`-let conditions, `global mut`, `stores[self]`, …).
test "highlight stdlib core/json.wado" {
    assert_highlights(&#include_str("../wado-compiler/lib/core/json.wado"));
}

test "highlight stdlib core/serde.wado" {
    assert_highlights(&#include_str("../wado-compiler/lib/core/serde.wado"));
}

test "highlight stdlib core/prelude/types.wado" {
