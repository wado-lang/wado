// HTTP server example using wasi:http (WASI P3)
//
// Compile and run with wado serve:
//   cargo run --bin wado -- serve example/http-server.wado
//
// Test with curl:
//   curl -i http://localhost:8080/
//   curl -i http://localhost:8080/echo

use {
    Request,
    Response,
    ErrorCode,
    Fields,
    FieldName,
    FieldValue,
    Trailers,
    StatusCode,
} from "wasi:http";
use { TreeMap } from "core:collections";
use { JsonValue, stringify } from "./json.wado";

fn bytes_to_string(bytes: Array<u8>) -> String {
    let mut s = String::with_capacity(bytes.len());
    for let b of bytes {
        s.append_char(char::from_u32(b as u32).unwrap());
    }
    return s;
}

fn string_to_bytes(s: String) -> Array<u8> {
    return s.bytes().collect();
}

fn headers_to_json(headers: &Fields) -> String {
    let all = headers.copy_all();
    let mut map = TreeMap::<String, JsonValue>::new();
    for let entry of all {
        let [name, value] = entry;
        let value_str = bytes_to_string(value);
        map[name] = JsonValue::Str(value_str);
    }
    let obj = JsonValue::Obj(map);
    return stringify(&obj);
}

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    let path = request.get_path_with_query();
    let req_headers = request.get_headers();

    let mut body_str = "Not Found\n";
    let mut status: StatusCode = 404;
    if let Some(p) = path {
        if p == "/" {
            status = 200;
            body_str = "Hello, world!\n";
        } else if p == "/echo" {
            status = 200;
            body_str = headers_to_json(&req_headers);
        }
    }

    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [body_rx, body_tx] = Stream::<u8>::new();

    let headers = Fields::new();
    let [response, _tx_future] = Response::new(headers, Option::<Stream<u8>>::Some(body_rx), trailers_future);
    response.set_status_code(status);

    task return Result::<Response, ErrorCode>::Ok(response);

    body_tx.write(string_to_bytes(body_str));
    body_tx.drop();

    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}
