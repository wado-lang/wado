    //    let socket_addr = Ipv4SocketAddress { port: 8080, address: addr };
    //    let ip_addr = IpSocketAddress::Ipv4(socket_addr);
    //
    // 3. Resource instance method calls:
    //    socket.bind(ip_addr);
    //    let connections = socket.listen();
    //
    // 4. Stream<T> iteration for accepting connections:
    //    for let client of connections {
    //        handle_client(client);
    //    }
    //
    // 5. Stream<u8> for reading/writing HTTP data:
    //    let [rx_stream, rx_future] = client.receive();
