// Simple HTTP server example using wasi:http (WASI P3)
//
// Compile and run with wado serve:
//   cargo run --bin wado -- serve example/http-server.wado
//
// Test with curl:
//   curl -i http://localhost:8080/

use { Request, Response, ErrorCode, Fields, Trailers, StatusCode } from "wasi:http";

export async fn handle(request: Request) -> Result<Response, ErrorCode>
    with Request, Response, Fields, Stream, StreamWritable, Future, FutureWritable
{
    let path = request.get_path_with_query();

    let [status, body_str]: [StatusCode, String] = if path matches { Some("/") } {
        [200, "Hello, world!\n"];
    } else {
        [404, "Not Found\n"];
    };

    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [body_rx, body_tx] = Stream::<u8>::new();

    let headers = Fields::new();
    let [response, _tx_future] = Response::new(headers, Option::<Stream<u8>>::Some(body_rx), trailers_future);
    response.set_status_code(status);

    task return Result::<Response, ErrorCode>::Ok(response);

    body_tx.write(body_str.bytes().collect());
    body_tx.drop();

    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}
