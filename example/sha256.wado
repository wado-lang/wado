// SHA-256 (FIPS 180-4 / RFC 6234) implemented from the public specification.
//
// Only the algorithm description and constants from the standard are used:
// no third-party implementation was consulted. The eight initial hash values
// are the first 32 bits of the fractional parts of the square roots of the
// first 8 primes; the 64 round constants K are the first 32 bits of the
// fractional parts of the cube roots of the first 64 primes.

use { println, Stdout } from "core:cli";

// Round constants (cube roots of the first 64 primes).
global K: List<u32> = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98,
    0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786,
    0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8,
    0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819,
    0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,
    0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7,
    0xc67178f2,
];

// Rotate a 32-bit word right by `n` bits.
fn rotr(x: u32, n: u32) -> u32 {
    return x >> n | x << 32 as u32 - n;
}

// Incremental SHA-256 hasher. Feed bytes with `update`, then `finalize` once.
struct Sha256 {
    h: List<u32>,
    buffer: List<u8>,
    total_len: u64,  // total number of message bytes absorbed so far
}

impl Sha256 {
    fn new() -> Sha256 {
        return Sha256 {
            h: [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19] as List<u32>,
            buffer: [],
            total_len: 0,
        };
    }

    // Absorb message bytes, processing each full 512-bit block as it fills.
    fn update(&mut self, data: &List<u8>) {
        for let mut i = 0; i < data.len(); i += 1 {
            self.buffer.push(data[i]);
            self.total_len += 1;
            if self.buffer.len() == 64 {
                self.process();
                self.buffer.clear();
            }
        }
    }

    // Push a single padding byte (not counted in the message length) and
    // process the block when it becomes full.
    fn absorb_pad(&mut self, byte: u8) {
        self.buffer.push(byte);
        if self.buffer.len() == 64 {
            self.process();
            self.buffer.clear();
        }
    }

    // Apply the padding scheme, process the final block(s), and return the
    // 32-byte digest in big-endian order.
    fn finalize(&mut self) -> List<u8> {
        let bit_len: u64 = self.total_len * 8;

        // Append the mandatory 0x80 byte, then zeros until 56 bytes remain in
        // the block for the 64-bit length field.
        self.absorb_pad(0x80);
        while self.buffer.len() != 56 {
            self.absorb_pad(0x00);
        }

        // Append the original message length in bits as a big-endian u64.
        for let mut i = 0; i < 8; i += 1 {
            let shift = ((7 - i) * 8) as u64;
            self.absorb_pad((bit_len >> shift) as u8);
        }

        let mut out: List<u8> = [];
        for let mut i = 0; i < 8; i += 1 {
            let v = self.h[i];
            out.push((v >> 24) as u8);
            out.push((v >> 16) as u8);
            out.push((v >> 8) as u8);
            out.push(v as u8);
        }
        return out;
    }

    // Compress the 64-byte block currently held in `self.buffer`.
    fn process(&mut self) {
        // Build the 64-word message schedule.
        let mut w = List::<u32>::filled(64, 0);
        for let mut t = 0; t < 16; t += 1 {
            let j = t * 4;
            w[t] = self.buffer[j] as u32 << 24 | self.buffer[j + 1] as u32 << 16 | self.buffer[j + 2] as u32 << 8 | self.buffer[j + 3] as u32;
        }
        for let mut t = 16; t < 64; t += 1 {
            let s0 = rotr(w[t - 15], 7) ^ rotr(w[t - 15], 18) ^ w[t - 15] >> 3;
            let s1 = rotr(w[t - 2], 17) ^ rotr(w[t - 2], 19) ^ w[t - 2] >> 10;
            w[t] = w[t - 16] + s0 + w[t - 7] + s1;
        }

        let mut a = self.h[0];
        let mut b = self.h[1];
        let mut c = self.h[2];
        let mut d = self.h[3];
        let mut e = self.h[4];
        let mut f = self.h[5];
        let mut g = self.h[6];
        let mut hh = self.h[7];

        for let mut t = 0; t < 64; t += 1 {
            let big_s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
            let ch = e & f ^ ~e & g;
            let t1 = hh + big_s1 + ch + K[t] + w[t];
            let big_s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
            let maj = a & b ^ a & c ^ b & c;
            let t2 = big_s0 + maj;

            hh = g;
            g = f;
            f = e;
            e = d + t1;
            d = c;
            c = b;
            b = a;
            a = t1 + t2;
        }

        self.h[0] = self.h[0] + a;
        self.h[1] = self.h[1] + b;
        self.h[2] = self.h[2] + c;
        self.h[3] = self.h[3] + d;
        self.h[4] = self.h[4] + e;
        self.h[5] = self.h[5] + f;
        self.h[6] = self.h[6] + g;
        self.h[7] = self.h[7] + hh;
    }
}

// One-shot helper: hash a whole message and return its 32-byte digest.
fn sha256(data: &List<u8>) -> List<u8> {
    let mut hasher = Sha256::new();
    hasher.update(data);
    return hasher.finalize();
}

// Render a byte slice as a lowercase hexadecimal string.
fn to_hex(digest: &List<u8>) -> String {
    let mut s = String::with_capacity(digest.len() * 2);
    for let mut i = 0; i < digest.len(); i += 1 {
        s.push_str(&`{digest[i]:02x}`);
    }
    return s;
}

// Encode the UTF-8 bytes of a string into a List<u8>.
fn bytes_of(s: &String) -> List<u8> {
    let mut v: List<u8> = [];
    for let b of s.bytes() {
        v.push(b);
    }
    return v;
}

test "empty input" {
    let digest = sha256(&([] as List<u8>));
    assert to_hex(&digest) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
}

test "abc" {
    let digest = sha256(&bytes_of(&"abc"));
    assert to_hex(&digest) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
}

test "two-block message" {
    let msg = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
    let digest = sha256(&bytes_of(&msg));
    assert to_hex(&digest) == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1";
}

test "incremental update matches one-shot" {
    // Splitting the message across update() calls (and across a block
    // boundary) must yield the same digest as hashing it all at once.
    let mut hasher = Sha256::new();
    hasher.update(&bytes_of(&"The quick brown fox "));
    hasher.update(&bytes_of(&"jumps over the lazy dog"));
    let incremental = to_hex(&hasher.finalize());

    let oneshot = to_hex(&sha256(&bytes_of(&"The quick brown fox jumps over the lazy dog")));
    assert incremental == oneshot;
    assert oneshot == "d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592";
}

export fn run() with Stdout {
    let inputs: List<String> = ["", "abc", "hello, world"];
    println("SHA-256 (FIPS 180-4 / RFC 6234)");
    for let s of inputs {
        let digest = sha256(&bytes_of(&s));
        println(`  "{s}" -> {to_hex(&digest)}`);
    }
}
