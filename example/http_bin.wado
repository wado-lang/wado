// httpbin clone — a simple HTTP request & response inspection service
//
// Compile and run with wado serve:
//   cargo run --bin wado -- serve example/http_bin.wado
//
// Endpoints:
//   GET  /              — HTML homepage
//   GET  /get           — returns request info as JSON
//   POST /post          — returns request info + body as JSON
//   PUT  /put           — returns request info + body as JSON
//   PATCH /patch        — returns request info + body as JSON
//   DELETE /delete      — returns request info as JSON
//   GET  /headers       — returns request headers as JSON
//   GET  /ip            — returns origin IP as JSON
//   GET  /user-agent    — returns User-Agent as JSON
//   GET  /status/:code  — returns the given HTTP status code
//   GET  /base64/:val   — decodes base64-encoded value
//   GET  /gzip          — returns request info as gzip-coded JSON
//   *    /anything      — returns request info for any method (incl. custom)
//
// Any other text reply goes out gzip-coded to a client whose Accept-Encoding
// admits it. A request body in a gzip or deflate Content-Encoding is decoded;
// one in any other coding is 415.

use {
    Request,
    Response,
    ErrorCode,
    Fields,
    Headers,
    FieldName,
    FieldValue,
    Trailers,
    StatusCode,
    Method,
    Scheme,
} from "wasi:http";
use { TreeMap } from "core:collections";
use { decode } from "core:base64";
use { Serialize } from "core:serde";
use { Url } from "core:url";
use { log_stderr } from "core:cli";
use { MonotonicClock } from "wasi:clocks";
use { Router, PathParams } from "core:router";
use json from "core:json";
use { ZlibError, gzip_compress, inflate_gzip, inflate_zlib, zlib_compress } from "core:zlib";
use { field_list, request_accepts_gzip, worth_gzip } from "./http_gzip.wado";

struct RequestInfo {
    method: String,
    path: String,
    args: TreeMap<String, String>,
    headers: TreeMap<String, String>,
    origin: String,
    url: Url,
    body: Option<String>,
}
impl Serialize for RequestInfo;

struct ErrorResponse {
    error: String,
}
impl Serialize for ErrorResponse;

struct HeadersResponse {
    headers: TreeMap<String, String>,
}
impl Serialize for HeadersResponse;

struct IpResponse {
    origin: Option<String>,
}
impl Serialize for IpResponse;

struct GzipResponse {
    gzipped: bool,
    method: String,
    headers: TreeMap<String, String>,
    origin: String,
}
impl Serialize for GzipResponse;

#[wire(name_policy = "kebab-case")]
struct UserAgentResponse {
    user_agent: Option<String>,
}
impl Serialize for UserAgentResponse;

#[wire(name_policy = "kebab-case")]
struct AccessLog {
    method: String,
    path: String,
    user_agent: Option<String>,
    status: StatusCode,
    duration_us: u64,
}
impl Serialize for AccessLog;

struct RouteResponse {
    status: StatusCode,
    content_type: String,
    body: ByteList,
    headers: List<[String, String]> = [],
    gzip: bool = false,
}

variant BodyError {
    UnsupportedCoding(String),
    Corrupt(ZlibError),
}
impl From<ZlibError> for BodyError;

type Handler = fn(Request, PathParams) -> RouteResponse;

fn scheme_name(s: Option<Scheme>) -> String {
    return match s {
        Some(Http) => "http",
        Some(Https) => "https",
        Some(Other(name)) => name,
        None => "http",
    };
}

fn method_name(m: Method) -> String {
    return match m {
        Get => "GET",
        Head => "HEAD",
        Post => "POST",
        Put => "PUT",
        Delete => "DELETE",
        Connect => "CONNECT",
        Options => "OPTIONS",
        Trace => "TRACE",
        Patch => "PATCH",
        Other(s) => s,
    };
}

fn headers_to_map(headers: &Headers) -> TreeMap<String, String> {
    let mut map: TreeMap<String, String> = {};
    for let [name, value] of headers.copy_all() {
        map[name] = String::from_utf8_lossy(value);
    }
    return map;
}

/// Returns the first value for `name`, or None if the header is not set.
fn get_header(headers: &Headers, name: FieldName) -> Option<String> {
    let values = headers.get(name);
    if values.is_empty() {
        return null;
    }
    return Option::Some(String::from_utf8_lossy(values[0]));
}

/// wasmtime v43 typically leaves the authority unset for incoming HTTP/1.1
/// requests since the host travels in the Host header. Fall back to it.
fn resolve_authority(request: &Request) -> String {
    if let Some(a) = request.get_authority() && !a.is_empty() {
        return a;
    }
    let h = request.get_headers();
    return match get_header(&h, "host") {
        Some(host) => host,
        None => "",
    };
}

fn parse_url(request: &Request) -> Url {
    let scheme = scheme_name(request.get_scheme());
    let authority = resolve_authority(request);
    return Url::from_parts(scheme, authority, request.get_path_with_query(), null);
}

/// The request body, decoded from its `Content-Encoding`, or the reply refusing it.
fn read_body_from_request(request: Request) -> Result<String, RouteResponse> {
    let coding = field_list(&request.get_headers(), "content-encoding");
    let [res_future, _res_tx] = Future::<Result<(), ErrorCode>>::new();
    let [body_stream, _trailers] = Request::consume_body(request, res_future);
    let buf = body_stream.read_to_end();
    body_stream.drop();
    return match decode_content(&coding, buf as ByteList) {
        Ok(decoded) => Result::Ok(String::from_utf8(decoded).unwrap_or("")),
        Err(UnsupportedCoding(c)) => Result::Err(RouteResponse {
            ..json_response(415, json_error(`Unsupported Content-Encoding: ${c}`)),
            headers: [
                ["accept-encoding", "gzip, deflate"],
            ],
        }),
        Err(Corrupt(e)) => Result::Err(json_response(400, json_error(`Malformed request body: ${e}`))),
    };
}

/// `body` with each coding a `Content-Encoding` value lists undone, last applied first.
fn decode_content(content_encoding: &String, body: ByteList) -> Result<ByteList, BodyError> {
    let mut codings: List<String> = content_encoding.split(",").map(|c| c.trim_ascii().to_ascii_lowercase()).filter(|c| !c.is_empty()).collect();
    codings.reverse();
    let mut decoded = body;
    for let coding of codings {
        decoded = match coding {
            "gzip" | "x-gzip" => inflate_gzip(&decoded)?,
            "deflate" => inflate_zlib(&decoded)?,
            _ => {
                return Result::Err(BodyError::UnsupportedCoding(coding));
            },
        };
    }
    return Result::Ok(decoded);
}

fn parse_status_code(s: String) -> Option<u16> {
    if s.is_empty() {
        return null;
    }
    if let Ok(f) = f64::from_str(&s) {
        let code = f as i32;
        if 100 <= code <= 599 && f == code as f64 {
            return Option::Some(code as u16);
        }
    }
    return null;
}

fn build_request_json(method: Method, url: Url, headers: &Headers, body: Option<String>) -> ByteList {
    let origin = match get_header(headers, "x-forwarded-for") {
        Some(s) => s,
        None => "",
    };
    return json_line(&RequestInfo {
        method: method_name(method),
        path: url.path,
        args: url.query_params(),
        headers: headers_to_map(headers),
        origin,
        url,
        body,
    });
}

/// Serialize `value` to pretty UTF-8 JSON bytes with a trailing newline.
fn json_line<T: Serialize>(value: &T) -> ByteList {
    return json::to_bytes_pretty(value, Option::Some('\n')).unwrap().to_list() as ByteList;
}

fn json_error(msg: String) -> ByteList {
    return json_line(&ErrorResponse { error: msg });
}

fn json_response(status: StatusCode, body: ByteList) -> RouteResponse {
    return RouteResponse {
        status,
        content_type: "application/json",
        body,
    };
}

fn echo(request: Request, read_body: bool) -> RouteResponse {
    let url = parse_url(&request);
    let method = request.get_method();
    let h = request.get_headers();
    let mut body: Option<String> = null;
    if read_body {
        match read_body_from_request(request) {
            Ok(text) => body = Option::Some(text),
            Err(refusal) => {
                return refusal;
            },
        }
    }
    return json_response(200, build_request_json(method, url, &h, body));
}

fn respond_home() -> RouteResponse {
    return RouteResponse {
        status: 200,
        content_type: "text/html; charset=utf-8",
        body: HOMEPAGE,
    };
}

fn respond_headers(request: Request) -> RouteResponse {
    let h = request.get_headers();
    let body = json_line(&HeadersResponse {
        headers: headers_to_map(&h),
    });
    return json_response(200, body);
}

fn respond_ip(request: Request) -> RouteResponse {
    let h = request.get_headers();
    let body = json_line(&IpResponse {
        origin: get_header(&h, "x-forwarded-for"),
    });
    return json_response(200, body);
}

fn respond_user_agent(request: Request) -> RouteResponse {
    let h = request.get_headers();
    let body = json_line(&UserAgentResponse {
        user_agent: get_header(&h, "user-agent"),
    });
    return json_response(200, body);
}

fn respond_status(code_str: String) -> RouteResponse {
    if let Some(code) = parse_status_code(code_str) {
        return RouteResponse {
            status: code as StatusCode,
            content_type: "text/plain",
            body: [],
        };
    }
    return json_response(400, json_error("Invalid status code"));
}

fn respond_base64(encoded: String) -> RouteResponse {
    if let Some(decoded_bytes) = decode(&encoded) {
        return RouteResponse {
            status: 200,
            content_type: "text/plain",
            body: decoded_bytes,
        };
    }
    return json_response(400, json_error("Invalid base64"));
}

fn respond_gzip(request: Request) -> RouteResponse {
    let h = request.get_headers();
    let body = json_line(&GzipResponse {
        gzipped: true,
        method: method_name(request.get_method()),
        headers: headers_to_map(&h),
        origin: get_header(&h, "x-forwarded-for").unwrap_or(""),
    });
    return RouteResponse { ..json_response(200, body), gzip: true };
}

fn respond_anything(request: Request) -> RouteResponse {
    let method = request.get_method();
    return echo(request, method matches { Post | Put | Patch });
}

fn format_allow(methods: &List<Method>) -> String {
    let names: List<String> = methods.iter_value().map(|m: Method| method_name(m)).collect();
    return names.join(", ");
}

fn build_router() -> Router<Handler> {
    let mut r = Router::<Handler>::new();
    r.get("/", |_req, _p| respond_home());
    r.get("/get", |req, _p| echo(req, false));
    r.post("/post", |req, _p| echo(req, true));
    r.put("/put", |req, _p| echo(req, true));
    r.patch("/patch", |req, _p| echo(req, true));
    r.delete("/delete", |req, _p| echo(req, false));
    r.get("/headers", |req, _p| respond_headers(req));
    r.get("/ip", |req, _p| respond_ip(req));
    r.get("/user-agent", |req, _p| respond_user_agent(req));
    r.get("/status/:code", |_req, p| respond_status(p["code"]));
    r.get("/base64/:val", |_req, p| respond_base64(p["val"]));
    r.get("/gzip", |req, _p| respond_gzip(req));
    r.any("/anything", |req, _p| respond_anything(req));
    r.any("/anything/*rest", |req, _p| respond_anything(req));
    return r;
}

global HOMEPAGE: ByteList = #include_bytes("./http-bin-index.html");
global ROUTER: Router<Handler> = build_router();

export async fn handle(request: Request) -> Result<Response, ErrorCode> with MonotonicClock {
    let start_mark = MonotonicClock::now();
    let url = parse_url(&request);
    let method = request.get_method();
    let h = request.get_headers();
    let user_agent = get_header(&h, "user-agent");
    let accepts_gzip = request_accepts_gzip(&h);

    let resp = if let Some(m) = ROUTER.match_request(&request) {
        (m.handler)(request, m.params);
    } else {
        let allowed = ROUTER.allowed_methods(&url.path);
        if !allowed.is_empty() {
            RouteResponse {
                status: 405,
                content_type: "application/json",
                body: json_error("Method Not Allowed"),
                headers: [
                    ["allow", format_allow(&allowed)],
                ],
            };
        } else {
            RouteResponse {
                status: 404,
                content_type: "application/json",
                body: json_error("Not Found"),
            };
        }
    };

    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [body_rx, body_tx] = Stream::<u8>::new();

    let resp_headers = Headers::new();
    resp_headers.append("server", #file.bytes().collect() as FieldValue);
    resp_headers.append("content-type", resp.content_type.bytes().collect() as FieldValue);
    resp_headers.append("trailer", "server-timing".bytes().collect() as FieldValue);
    for let [name, value] of resp.headers {
        resp_headers.append(name as FieldName, value.bytes().collect() as FieldValue);
    }
    let codable = worth_gzip(&resp.content_type, resp.body.len() as u64);
    let gzip = resp.gzip || codable && accepts_gzip;
    if codable {
        resp_headers.append("vary", "accept-encoding".bytes().collect() as FieldValue);
    }
    if gzip {
        resp_headers.append("content-encoding", "gzip".bytes().collect() as FieldValue);
    }
    let [response, _response_tx] = Response::new(resp_headers, Option::Some(body_rx), trailers_future);
    response.set_status_code(resp.status);

    task return Result::Ok(response);

    let body = if gzip { gzip_compress(&resp.body) } else { resp.body };
    body_tx.write_raw_all(body.as_slice());
    body_tx.drop();

    // Server-Timing trailer carries the handler's wall-clock time so curious
    // clients can see it without re-running. Only delivered to clients that
    // sent `TE: trailers` per RFC 7230 §4.3.
    let elapsed = MonotonicClock::now() - start_mark;
    let elapsed_ms = elapsed as f64 / 1_000_000.0;
    let trailers = Trailers::new() as Trailers;
    trailers.append(
        "server-timing",
        `app;dur=${elapsed_ms:0.3f}`.bytes().collect() as FieldValue,
    );
    trailers_tx.write(Result::Ok(Option::Some(trailers)));

    log_stderr(json::to_string(&AccessLog {
        method: method_name(method),
        path: url.path,
        user_agent,
        status: resp.status,
        duration_us: elapsed as u64 / 1000,
    }).unwrap());
}

test "a request body is decoded from each coding, last applied first" {
    let data: ByteList = b"wado wado wado wado";
    assert decode_content(&"gzip", gzip_compress(&data)) matches { Ok(d) && d == data };
    assert decode_content(&"X-Gzip", gzip_compress(&data)) matches { Ok(d) && d == data };
    assert decode_content(&"deflate", zlib_compress(&data)) matches { Ok(d) && d == data };
    assert decode_content(&"deflate, gzip", gzip_compress(&zlib_compress(&data))) matches { Ok(d) && d == data };
    assert decode_content(&"", data) matches { Ok(d) && d == data };
}

test "a request body in an unknown or broken coding is refused" {
    let data: ByteList = b"wado wado wado wado";
    assert decode_content(&"br", data) matches { Err(UnsupportedCoding(c)) && c == "br" };
    assert decode_content(&"gzip", data) matches { Err(Corrupt(_)) };
    assert decode_content(&"gzip", zlib_compress(&data)) matches { Err(Corrupt(_)) };
}
