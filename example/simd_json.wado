// Does a SIMD string representation pay for `core:json`?
//
// `core:json` spends its string time in `scan_string_run`: walk bytes until the
// next `"`, `\`, or non-ASCII lead. This runs that loop three ways over the same
// bytes.
//
// - `scalar` reads one `array.get_u` per byte, the shape `core:json` runs today.
// - `gathered` goes through `u8x16::from_string`, sixteen `array.get_u` and
//   sixteen lane inserts per vector. It is the only bridge there is, because
//   Wasm cannot load a v128 from a GC array.
// - `packed` scans an `Array<u8x16>`, where one `array.get` yields a vector.
//   That is what `String` would become, so it is the ceiling of the change.
//
// `pack` is the one-off conversion, which a staging buffer would pay to leave
// `String` alone. `byte read` is what a packed `String` would cost every
// consumer still reading a byte at a time.
//
// Two run lengths, because the run is what SIMD amortizes over. 1024 bytes is
// the best case; 12 bytes is a JSON key or a short value.

use { println, Stdout } from "core:cli";
use { Benchmark } from "core:benchmark";
use { u8x16 } from "core:simd";
use { MonotonicClock } from "wasi:clocks";

global INPUT_BYTES: i32 = 65536;

// Scan `s[from..len)` for the first `"`, `\`, or non-ASCII byte; `len` if none.
fn scan_scalar(s: &String, from: i32, len: i32) -> i32 {
    let mut i = from;
    while i < len {
        let b = s.get_byte_unchecked(i);
        if b == b'"' || b == b'\\' || b >= 0x80 as u8 {
            return i;
        }
        i += 1;
    }
    return len;
}

// The three delimiter classes as one 16-bit mask. `bitmask` on `u8x16` takes
// the high bit of each lane, which is the non-ASCII test itself.
fn delimiters(c: &u8x16, quote: &u8x16, escape: &u8x16) -> i32 {
    return c.eq(quote).bitmask() | c.eq(escape).bitmask() | c.bitmask();
}

// `scan_scalar` over vectors gathered a byte at a time from the String.
fn scan_gathered(s: &String, from: i32, len: i32) -> i32 {
    let quote = u8x16::splat(b'"' as i32);
    let escape = u8x16::splat(b'\\' as i32);

    let mut i = from;
    while i + 16 <= len {
        let m = delimiters(&u8x16::from_string(s, i), &quote, &escape);
        if m != 0 {
            return i + i32::ctz(m);
        }
        i += 16;
    }
    return scan_scalar(s, i, len);
}

// `scan_scalar` over an already-packed `Array<u8x16>`: one `array.get` per
// vector. `from` need not be vector-aligned, so the lanes before it are masked
// out of the first vector's answer. Every lane holds a real byte (`pack`
// asserts it), so a hit is always below `len`.
fn scan_packed(chunks: &Array<u8x16>, from: i32, len: i32) -> i32 {
    let quote = u8x16::splat(b'"' as i32);
    let escape = u8x16::splat(b'\\' as i32);

    let mut chunk = from >> 4;
    let mut skip = from & 15;
    while chunk << 4 < len {
        let m = delimiters(&chunks.get_unchecked(chunk), &quote, &escape) >> skip << skip;
        if m != 0 {
            return (chunk << 4) + i32::ctz(m);
        }
        skip = 0;
        chunk += 1;
    }
    return len;
}

// A partial last vector would need `replace_lane`, whose const index Wado
// cannot yet write, so the length has to come out even.
fn pack(s: &String) -> Array<u8x16> {
    let len = s.len();
    assert len % 16 == 0, "pack needs a whole number of vectors";
    let mut out = Array::<u8x16>::new(len / 16);
    let mut i = 0;
    while i < len {
        out.set(i >> 4, u8x16::from_string(s, i));
        i += 16;
    }
    return out;
}

// What every byte-at-a-time consumer would pay under a packed `String`: a
// vector load, a swizzle to bring the byte to lane 0, and a lane read, where
// today it reads one `array.get_u`.
fn byte_at_packed(chunks: &Array<u8x16>, i: i32) -> u8 {
    let v = chunks.get_unchecked(i >> 4).swizzle(&u8x16::splat(i & 15));
    return v.extract_lane(0) as u8;
}

// These two share a loop, but hoisting it behind a `fn(i32) -> u8` costs the
// packed arm 18% and the scalar arm nothing, which is the difference being
// measured. `count_runs` calls its parameter once per run and specializes
// cleanly; once per byte, it does not.
fn sum_bytes_scalar(s: &String, len: i32) -> i32 {
    let mut total = 0;
    let mut i = 0;
    while i < len {
        total += s.get_byte_unchecked(i) as i32;
        i += 1;
    }
    return total;
}

fn sum_bytes_packed(chunks: &Array<u8x16>, len: i32) -> i32 {
    let mut total = 0;
    let mut i = 0;
    while i < len {
        total += byte_at_packed(chunks, i) as i32;
        i += 1;
    }
    return total;
}

// One scan per run, as `core:json` does: stop at the quote, step over it, scan
// the next value. Returns the number of runs, so nothing here is dead.
fn count_runs(len: i32, scan: fn(i32) -> i32) -> i32 {
    let mut runs = 0;
    let mut i = 0;
    while i < len {
        let end = scan(i);
        if end >= len {
            break;
        }
        runs += 1;
        i = end + 1;
    }
    return runs;
}

// These three exist because a closure nested in a closure cannot capture the
// enclosing function's local, so `bench.run(|| count_runs(len, |from| ...))`
// does not compile — `closure_nested_transitive_capture_todo`. Named, they keep
// the inner closure one level deep.
fn count_runs_scalar(s: &String, len: i32) -> i32 {
    return count_runs(len, |from| scan_scalar(s, from, len));
}

fn count_runs_gathered(s: &String, len: i32) -> i32 {
    return count_runs(len, |from| scan_gathered(s, from, len));
}

fn count_runs_packed(chunks: &Array<u8x16>, len: i32) -> i32 {
    return count_runs(len, |from| scan_packed(chunks, from, len));
}

fn make_input(total: i32, run_len: i32) -> String {
    let mut s = String::with_capacity(total);
    let mut i = 0;
    while i < total {
        if i % (run_len + 1) == run_len {
            s.push('"');
        } else {
            s.push(char::from_u32_unchecked((b'a' + (i % 26) as u8) as u32));
        }
        i += 1;
    }
    return s;
}

test "the three scans agree" {
    let cases: List<String> = [
        "", "plain", "\"", "a\"b", "sixteen bytes...\"tail",
        "a long run with no delimiter at all until the very end of it\\here", "non-ascii é lead stops the run",
    ];
    for let c of cases {
        let len = c.len();
        assert scan_gathered(&c, 0, len) == scan_scalar(&c, 0, len);
    }
}

test "the packed scan agrees, from every offset" {
    let s = make_input(64, 12);
    let chunks = pack(&s);
    let len = s.len();
    for let from of 0..<len {
        assert scan_packed(&chunks, from, len) == scan_scalar(&s, from, len);
    }
}

test "the two byte reads agree" {
    let s = make_input(64, 12);
    let chunks = pack(&s);
    let len = s.len();
    for let i of 0..<len {
        assert byte_at_packed(&chunks, i) == s.get_byte_unchecked(i);
    }
    assert sum_bytes_packed(&chunks, len) == sum_bytes_scalar(&s, len);
}

test "run counts agree" {
    let s = make_input(1024, 12);
    let chunks = pack(&s);
    let len = s.len();
    let runs = count_runs_scalar(&s, len);
    assert runs > 0;
    assert count_runs_gathered(&s, len) == runs;
    assert count_runs_packed(&chunks, len) == runs;
}

fn measure(bench: &mut Benchmark, run_len: i32) with (Stdout, MonotonicClock) {
    let s = make_input(INPUT_BYTES, run_len);
    let chunks = pack(&s);
    let len = s.len();

    let runs = bench.run(`scalar, run=${run_len}`, || count_runs_scalar(&s, len));
    let gathered = bench.run(`gathered, run=${run_len}`, || count_runs_gathered(&s, len));
    let packed = bench.run(`packed, run=${run_len}`, || count_runs_packed(&chunks, len));

    assert gathered == runs;
    assert packed == runs;
}

export fn run() with (Stdout, MonotonicClock) {
    let mut bench = Benchmark {
        name: `json string scan, ${INPUT_BYTES} bytes`,
        input_size: Option::Some(INPUT_BYTES),
    };

    measure(&mut bench, 1024);
    measure(&mut bench, 12);

    let s = make_input(INPUT_BYTES, 1024);
    let chunks = pack(&s);
    let len = s.len();

    let vectors = bench.run("pack String -> Array<u8x16>", || pack(&s).len());
    assert vectors == INPUT_BYTES / 16;

    let total = bench.run("byte read, scalar", || sum_bytes_scalar(&s, len));
    let packed_total = bench.run("byte read, packed", || sum_bytes_packed(&chunks, len));
    assert packed_total == total;

    println("");
    println("`packed` is the ceiling of an Array<v128> String, `scalar` what");
    println("core:json runs today, and `byte read` the price every consumer");
    println("that was not rewritten would pay. `pack` below `scalar` means a");
    println("staging buffer costs more than scanning without one.");
}
