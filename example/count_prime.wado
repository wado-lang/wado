//! Count the primes below a million by trial division, and report the rate.
//!
//! π(1,000,000) = 78,498.
//!
//!     wado run example/count_prime.wado

use { Stdout } from "core:cli";
use { Benchmark, MonotonicClock } from "core:benchmark";

fn is_prime(n: i32) -> bool {
    if n < 2 {
        return false;
    }
    let mut d = 2;
    while d * d <= n {
        if n % d == 0 {
            return false;
        }
        d += 1;
    }
    return true;
}

fn count_primes(limit: i32) -> i32 {
    let mut count = 0;
    let mut n = 2;
    while n <= limit {
        if is_prime(n) {
            count += 1;
        }
        n += 1;
    }
    return count;
}

test "smoke" {
    assert count_primes(100) == 25;
}

export fn run() with (Stdout, MonotonicClock) {
    let limit = 1000000;
    let mut b = Benchmark {
        name: `count-prime up to ${limit}`,
        work_per_iter: Option::Some(limit as f64),
        unit: "numbers",
    };
    let count = b.run("", || count_primes(limit));
    b.println(`count = ${count}`);
}
