// Brotli compression via the `mizchi:brotli` Wasm component from wa.dev.
//
// The component is fetched with `wkg` into ../build (gitignored):
//   wkg get mizchi:brotli --registry wa.dev -o example/brotli/build/
//
// Wado imports the `.wasm` component directly: each exported CM interface
// becomes a Wado `interface`, and its functions are called like WASI methods.

use { println, Stdout } from "core:cli";
use { Compress } from "../build/mizchi_brotli@0.2.0.wasm" with { type: "wasm" };
use { Decompress } from "../build/mizchi_brotli@0.2.0.wasm" with { type: "wasm" };

export fn run() with Stdout, Compress, Decompress {
    let original = "Hello, Brotli! Hello, Brotli! Hello, Brotli!";
    let input: List<u8> = original.bytes().collect();

    let compressed = Compress::compress(input);
    println(`original:   {input.len()} bytes`);
    println(`compressed: {compressed.len()} bytes`);

    let stronger = Compress::compress_with_quality(input, 11);
    println(`quality 11: {stronger.len()} bytes`);

    match Decompress::decompress(compressed) {
        Ok(bytes) => {
            assert bytes == input, "roundtrip must restore the original bytes";
            println(`decompressed: {bytes.len()} bytes (roundtrip OK)`);
        },
        Err(e) => println(`decompress failed: {e}`),
    }
}
