#!/usr/bin/env wado
// A simple cat(1) implementation in Wado
//
// Usage: wado run example/cat.wado <file>...
//
// By default, wado run preopens the current directory as '.'.
// Files are opened relative to that preopened directory.
//
// Example:
//   wado run example/cat.wado README.md
//   wado run example/cat.wado example/cat.wado example/hello.wado

use { args, eprintln, Stdout, Stderr, Environment } from "core:cli";
use { Preopens, Descriptor, Filesize, PathFlags, OpenFlags, DescriptorFlags } from "wasi:filesystem";

export fn run() with Stdout, Stderr, Environment, Preopens {
    let arguments = args();

    if arguments.len() == 0 {
        eprintln("cat: usage: cat <file>...");
        return;
    }

    // Use the first preopened directory as the root for relative paths.
    let dirs = Preopens::get_directories();
    if dirs.len() == 0 {
        eprintln("cat: no preopened directories available (try without --no-dir)");
        return;
    }
    let root = dirs[0].0;

    for let mut i = 0; i < arguments.len(); i = i + 1 {
        cat_file(&root, arguments[i]);
    }
}

fn cat_file(dir: &Descriptor, path: String) with Stdout, Stderr {
    let open_result = dir.open_at(
        PathFlags::none(),
        path,
        OpenFlags::none(),
        DescriptorFlags::Read,
    );

    if let Ok(file) = open_result {
        let [read_stream, _done] = file.read_via_stream(0 as Filesize);
        Stdout::write_via_stream(read_stream);
    } else {
        eprintln(`cat: {path}: cannot open file`);
    }
}
