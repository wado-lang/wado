// A simple cat(1) implementation in Wado
//
// Usage: wado run --dir . example/cat.wado <file>...
//
// This demonstrates WASI P3 filesystem operations:
// - Getting preopened directories
// - Opening files
// - Reading file streams and writing to stdout
//
// Current Status: The wasi:filesystem module is fully generated with all
// Descriptor methods (open_at, read_via_stream, stat, etc.), but resource
// type codegen is not yet implemented. This file documents the intended API.

use {eprintln, args, Stdout, Stderr, Environment} from "core:cli";

// These imports work but Descriptor resource codegen is not yet implemented:
// use {
//     Preopens,
//     Descriptor,
//     PathFlags,
//     OpenFlags,
//     DescriptorFlags,
//     ErrorCode,
// } from "wasi:filesystem";

fn run() with Stdout, Stderr, Environment {
    let arguments = args();

    if arguments.len() <= 1 {
        eprintln("cat: usage: cat <file>...");
        eprintln("cat: note: filesystem resource codegen not yet implemented");
        return;
    }

    // When resource codegen is implemented, the following will work:
    //
    // // Get preopened directories
    // let preopens = Preopens::get_directories();
    // if preopens.len() == 0 {
    //     eprintln("cat: no preopened directories available");
    //     return;
    // }
    //
    // // Use first preopened directory as base
    // let root_entry = preopens[0];
    // let root_dir = root_entry.0;
    //
    // // Process each file argument
    // for let mut i = 1; i < arguments.len(); i = i + 1 {
    //     let path = arguments[i];
    //     cat_file(&root_dir, path);
    // }

    // Temporary: Show what files were requested
    eprintln("cat: file reading not yet implemented (resource codegen needed)");
    for let mut i = 1; i < arguments.len(); i = i + 1 {
        eprintln(`cat: would read: {arguments[i]}`);
    }
}

