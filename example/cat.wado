// A simple cat(1) placeholder in Wado
//
// Note: Full cat functionality (reading files) requires:
// 1. Filesystem stdlib to be fixed (uses unsupported tuple destructuring)
// 2. Stdin stream support (currently has codegen issues)
//
// This placeholder demonstrates the intended usage pattern.

use {println, eprintln, args, Stdout, Stderr, Environment} from "core:cli";

fn run() with Stdout, Stderr, Environment {
    let arguments = args();

    if arguments.len() <= 1 {
        // No files specified - would read from stdin
        eprintln("cat: reading from stdin not yet implemented");
        eprintln("cat: usage: cat <file>...");
    } else {
        // File arguments provided
        eprintln("cat: file reading not yet implemented");
        eprintln("cat: (filesystem stdlib uses unsupported syntax)");

        // Show what files were requested
        for (let mut i = 1; i < arguments.len(); i = i + 1) {
            eprintln(`cat: would read: {arguments[i]}`);
        }
    }
}
