//! Logger PoC — validates the `core:log` WEP design against the real compiler.
//! Shaped as `core:log` will be, so what compiles here is what the module can
//! be written from. See `docs/wep-2026-06-25-core-log.md`.
//!
//! Two things the WEP specifies are not reproduced here, both waiting on the
//! optimizer items the WEP lists:
//!
//! - Tier 1 is a run-time read, not a fold. `LOG_STATIC_LEVEL` derives from a
//!   `#[param]` `String` through `level_from_str`, and a `String` binding is a
//!   deep copy no pass removes, so the parameter never reaches the comparison.
//!   The compiler says so rather than staying silent:
//!   `wado check --world test --log-level info example/logger_poc.wado`
//!   reports the surviving gate as a `remark:`.
//! - The arguments of a dropped event are still built in front of the gate,
//!   which is what sinking pure definitions into a branch would fix.
//!
//! `-D log.level=<level>` does take effect — at run time — so the whole suite
//! below assumes the default `trace`.

use { Serialize } from "core:serde";
use { Value, to_value } from "core:value";
use { TreeMap } from "core:collections";
use { to_string } from "core:json";

pub enum Level {
    Trace,
    Debug,
    Info,
    Warn,
    Error,
}

pub type SpanId = u64;

// Serializes to `{}`; the default field payload, so `info(msg)` needs no second
// argument and the default type parameter supplies its type.
pub struct NoFields {
}

pub struct Metadata {
    pub level: Level,
    pub target: String,
    pub name: String = "",
    pub file: String,
    pub line: i32,
}

pub struct Event {
    pub meta: Metadata,
    pub message: String,
    pub fields: Value = Value::Null,
    pub parent: Option<SpanId> = null,
}

pub struct SpanAttrs {
    pub meta: Metadata,
    pub fields: Value = Value::Null,
}

// Tier 1: the build-time threshold. `-D log.level=info` settles it, and
// `from_env` reads the build environment rather than the run-time one.
#[param(name = "log.level", from_env = "WADO_LOG_LEVEL")]
global LOG_LEVEL: String = "trace";

global LOG_STATIC_LEVEL: Level = level_from_str(LOG_LEVEL);

// Tier 2: the process-wide threshold, owned here rather than by the installed
// sink, so there is no sink contract and no cache to invalidate.
global mut RUNTIME_LEVEL: Level = Level::Trace;

pub fn level_from_str(s: String) -> Level {
    return match s {
        "trace" => Level::Trace,
        "debug" => Level::Debug,
        "info" => Level::Info,
        "warn" => Level::Warn,
        "error" => Level::Error,
        _ => Level::Trace,
    };
}

pub fn set_log_level(level: Level) {
    RUNTIME_LEVEL = level;
}

pub fn log_level() -> Level {
    return RUNTIME_LEVEL;
}

fn box_fields<T: Serialize>(fields: T) -> Value {
    return match to_value(&fields) {
        Ok(v) => v,
        Err(_) => Value::Null,
    };
}

// The subscriber. Sinks and layers are handlers of it, so composition is
// handler nesting and dispatch stays static.
interface Log {
    fn enabled(level: Level) -> bool;
    fn current_span() -> Option<SpanId>;
    fn new_span(attrs: SpanAttrs) -> SpanId;
    fn record_fields(span: SpanId, fields: Value);
    fn follows_from(span: SpanId, cause: SpanId);
    fn enter(span: SpanId);
    fn exit(span: SpanId);
    fn close(span: SpanId);
    fn event(event: Event);
}

// The three tiers, cheapest first, each narrowing what the one before admitted.
// Exposed as a predicate too, for guarding fields too expensive to build.
#[ambient]
pub fn enabled(level: Level) -> bool {
    if level < LOG_STATIC_LEVEL {
        return false;
    }
    if level < RUNTIME_LEVEL {
        return false;
    }
    return Log::enabled(level);
}

// Facade; location defaults resolve at the call site. `#[ambient]` (like
// `log_stdout`) lets it perform `Log` without `with Log` infecting callers.
#[ambient]
pub fn event<T: Serialize = NoFields>(
    level: Level,
    message: String,
    fields: T = NoFields {},
    target: String = #function,
    file: String = #file,
    line: i32 = #line,
) {
    Log::event(Event {
        meta: Metadata { level, target, file, line },
        message,
        fields: box_fields(fields),
        parent: Log::current_span(),
    });
}

// One wrapper per level: each knows its level as a literal, which is what lets
// tier 1 fold the comparison away once a parameter reaches it.
#[ambient]
pub fn trace<T: Serialize = NoFields>(
    message: String,
    fields: T = NoFields {},
    target: String = #function,
    file: String = #file,
    line: i32 = #line,
) {
    if !enabled(Level::Trace) {
        return;
    }
    event(Level::Trace, message, fields, target, file, line);
}

#[ambient]
pub fn debug<T: Serialize = NoFields>(
    message: String,
    fields: T = NoFields {},
    target: String = #function,
    file: String = #file,
    line: i32 = #line,
) {
    if !enabled(Level::Debug) {
        return;
    }
    event(Level::Debug, message, fields, target, file, line);
}

#[ambient]
pub fn info<T: Serialize = NoFields>(
    message: String,
    fields: T = NoFields {},
    target: String = #function,
    file: String = #file,
    line: i32 = #line,
) {
    if !enabled(Level::Info) {
        return;
    }
    event(Level::Info, message, fields, target, file, line);
}

#[ambient]
pub fn warn<T: Serialize = NoFields>(
    message: String,
    fields: T = NoFields {},
    target: String = #function,
    file: String = #file,
    line: i32 = #line,
) {
    if !enabled(Level::Warn) {
        return;
    }
    event(Level::Warn, message, fields, target, file, line);
}

#[ambient]
pub fn error<T: Serialize = NoFields>(
    message: String,
    fields: T = NoFields {},
    target: String = #function,
    file: String = #file,
    line: i32 = #line,
) {
    if !enabled(Level::Error) {
        return;
    }
    event(Level::Error, message, fields, target, file, line);
}

// A span is a first-class value, so a caller can carry one and re-enter it.
pub struct Span {
    id: SpanId,
}

impl Span {
    pub fn id(&self) -> SpanId {
        return self.id;
    }

    pub fn record<T: Serialize>(&self, fields: T) {
        Log::record_fields(self.id, box_fields(fields));
    }

    pub fn follows_from(&self, cause: &Span) {
        Log::follows_from(self.id, cause.id);
    }
}

#[ambient]
pub fn span<T: Serialize = NoFields>(
    level: Level,
    name: String,
    fields: T = NoFields {},
    target: String = #function,
    file: String = #file,
    line: i32 = #line,
) -> Span {
    let id = Log::new_span(SpanAttrs {
        meta: Metadata { level, target, name, file, line },
        fields: box_fields(fields),
    });
    return Span { id };
}

#[ambient]
pub fn current() -> Option<Span> {
    return match Log::current_span() {
        Some(id) => Option::<Span>::Some(Span { id }),
        None => null,
    };
}

// A closure can't skip the exit/close calls, so they run on every body exit path.
#[ambient]
pub fn in_span<T, effect E>(s: &Span, body: fn() -> T with E) -> T with E {
    Log::enter(s.id());
    let r = body();
    Log::exit(s.id());
    Log::close(s.id());
    return r;
}

// A sink terminates the chain: it implements every operation, so an operation
// forwarded from an inner layer ends here instead of trapping.
struct CaptureSink {
    min: Level = Level::Trace,
    next_id: u64 = 0,
    stack: List<SpanId> = [],
    events: List<Event> = [],
    trace: List<String> = [],
    recorded: List<String> = [],
    links: List<String> = [],
}

impl Log for CaptureSink {
    fn enabled(&self, level: Level) -> bool {
        resume level >= self.min;
    }

    fn new_span(&mut self, attrs: SpanAttrs) -> SpanId {
        self.next_id += 1;
        let id = self.next_id as SpanId;
        self.trace.push(`new:${attrs.meta.name}#${id}`);
        resume id;
    }

    fn enter(&mut self, span: SpanId) {
        self.stack.push(span);
        self.trace.push(`enter:${span}`);
    }

    fn exit(&mut self, span: SpanId) {
        self.stack.pop();
        self.trace.push(`exit:${span}`);
    }

    fn close(&mut self, span: SpanId) {
        self.trace.push(`close:${span}`);
    }

    fn current_span(&self) -> Option<SpanId> {
        resume self.stack.last();
    }

    fn record_fields(&mut self, span: SpanId, fields: Value) {
        if let Object(map) = fields {
            for let [key, _] of map.entries() {
                self.recorded.push(`record:${span}:${key}`);
            }
        }
    }

    fn follows_from(&mut self, span: SpanId, cause: SpanId) {
        self.links.push(`${span}<-${cause}`);
    }

    fn event(&mut self, event: Event) {
        self.events.push(event);
    }
}

// A JSON sink, likewise terminal: one line per event.
struct JsonSink {
    lines: List<String> = [],
}

impl Log for JsonSink {
    fn enabled(&self, level: Level) -> bool {
        resume true;
    }

    fn new_span(&self, attrs: SpanAttrs) -> SpanId {
        resume 0 as SpanId;
    }

    fn enter(&self, span: SpanId) {
    }

    fn exit(&self, span: SpanId) {
    }

    fn close(&self, span: SpanId) {
    }

    fn current_span(&self) -> Option<SpanId> {
        resume null;
    }

    fn record_fields(&self, span: SpanId, fields: Value) {
    }

    fn follows_from(&self, span: SpanId, cause: SpanId) {
    }

    fn event(&mut self, event: Event) {
        match to_string(&event) {
            Ok(s) => self.lines.push(s),
            Err(_) => {
            },
        }
    }
}

// A layer implements only what it changes. `..forward` is what makes that
// possible: without it each of these restates all nine operations to pass
// them through.
struct Context<T: Serialize> {
    fields: T,
}

impl<T: Serialize> Log for Context<T> {
    fn event(&self, event: Event) {
        let mut merged = TreeMap::<String, Value>::new();
        if let Object(base) = box_fields(self.fields) {
            for let [key, value] of base.entries() {
                merged[key] = value;
            }
        }
        if let Object(extra) = event.fields {
            for let [key, value] of extra.entries() {
                merged[key] = value;
            }
        }
        Log::event(Event {
            meta: event.meta,
            message: event.message,
            fields: Value::Object(merged),
            parent: event.parent,
        });
    }

    ..forward
}

struct Filter {
    min: Level,
}

impl Log for Filter {
    fn enabled(&self, level: Level) -> bool {
        resume level >= self.min && Log::enabled(level);
    }

    fn event(&self, event: Event) {
        if event.meta.level >= self.min {
            Log::event(event);
        }
    }

    ..forward
}

// A layer that changes nothing at all: the shape with no method for the
// dispatch synthesis to discover it by.
struct Passthrough {
}

impl Log for Passthrough {
    ..forward
}

test "captures message, level, and caller location" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        let expected_line = #line + 1;
        info(`hello`);
        assert sink.events.len() == 1;
        let e = sink.events[0];
        assert e.message == "hello";
        assert e.meta.level matches { Info };
        assert e.meta.line == expected_line;
        assert e.meta.file.contains("logger_poc.wado");

        warn(`heads up`, { code: 1 });
        assert sink.events.len() == 2;
        assert sink.events[1].meta.level matches { Warn };
    };
}

test "every level wrapper reaches the sink" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        trace(`t`);
        debug(`d`);
        info(`i`);
        warn(`w`);
        error(`e`);
    };
    assert sink.events.len() == 5;
    assert sink.events[0].meta.level matches { Trace };
    assert sink.events[4].meta.level matches { Error };
}

test "generic field accepts any Serialize value, preserving the data model" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        info(`with fields`, { user: "alice", n: 42 });
        let e = sink.events[0];
        if let Object(map) = e.fields {
            assert map.len() == 2;
            assert map.get("user") matches { Some(String(_)) };
            // Real to_value preserves Int (a JSON round-trip would give Float).
            assert map.get("n") matches { Some(Int(42)) };
        } else {
            panic("expected Object fields");
        }
    };
}

test "span lifecycle fires and events parent to the current span" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        let s = span(Level::Info, `request`);
        in_span(&s, || {
            info(`inside`);
        });
        info(`outside`);
    };
    let trace: List<String> = ["new:request#1", "enter:1", "exit:1", "close:1"];
    assert sink.trace == trace;
    assert sink.events.len() == 2;
    assert sink.events[0].message == "inside";
    assert sink.events[0].parent matches { Some(1) };
    assert sink.events[1].message == "outside";
    assert sink.events[1].parent matches { None };
}

test "tier 3 drops events below the sink's minimum level" {
    let mut sink = CaptureSink { min: Level::Warn };
    with Log => &mut sink do {
        info(`dropped`);
        warn(`kept`);
    };
    assert sink.events.len() == 1;
    assert sink.events[0].message == "kept";
}

test "tier 2 drops events below the process-wide level" {
    let mut sink = CaptureSink {};
    set_log_level(Level::Warn);
    assert log_level() matches { Warn };
    with Log => &mut sink do {
        info(`dropped`);
        warn(`kept`);
    };
    set_log_level(Level::Trace);
    assert sink.events.len() == 1;
    assert sink.events[0].message == "kept";
}

test "enabled guards fields too expensive to build" {
    let mut sink = CaptureSink { min: Level::Warn };
    let mut built = 0;
    with Log => &mut sink do {
        if enabled(Level::Debug) {
            built += 1;
            info(`never`);
        }
        if enabled(Level::Error) {
            built += 1;
            error(`always`);
        }
    };
    assert built == 1;
    assert sink.events.len() == 1;
}

test "context layer prepends fields and forwards the rest" {
    let mut sink = CaptureSink {};
    let ctx = Context {
        fields: { request_id: "abc" },
    };
    with Log => &mut sink do {
        with Log => &ctx do {
            info(`x`, { k: "v" });
        };
    };
    assert sink.events.len() == 1;
    let e = sink.events[0];
    if let Object(map) = e.fields {
        assert map.len() == 2;
        let entries = map.entries();
        assert entries[0][0] == "request_id";
        assert entries[1][0] == "k";
    } else {
        panic("expected Object fields");
    }
}

test "a forwarding layer passes span operations through untouched" {
    let mut sink = CaptureSink {};
    let ctx = Context {
        fields: { request_id: "abc" },
    };
    with Log => &mut sink do {
        with Log => &ctx do {
            let s = span(Level::Info, `request`);
            in_span(&s, || {
                s.record({ user: "alice" });
                info(`inside`);
            });
        };
    };
    let trace: List<String> = ["new:request#1", "enter:1", "exit:1", "close:1"];
    let recorded: List<String> = ["record:1:user"];
    assert sink.trace == trace;
    assert sink.recorded == recorded;
    assert sink.events[0].parent matches { Some(1) };
}

test "a layer implementing nothing is still a handler" {
    let mut sink = CaptureSink {};
    let pass = Passthrough {};
    with Log => &mut sink do {
        with Log => &pass do {
            info(`through`);
        };
    };
    assert sink.events.len() == 1;
    assert sink.events[0].message == "through";
}

test "json sink serializes whole events to one line each" {
    let mut sink = JsonSink {};
    with Log => &mut sink do {
        info(`hi`, { k: "v" });
    };
    assert sink.lines.len() == 1;
    assert sink.lines[0].contains("message");
    assert sink.lines[0].contains("hi");
}

test "effect-polymorphic in_span returns the body value" {
    let mut sink = CaptureSink {};
    let n = with Log => &mut sink do {
        in_span(&span(Level::Info, `compute`), || {
            info(`working`);
            return 42;
        });
    };
    assert n == 42;
    assert sink.events[0].message == "working";
}

test "in_span runs exit and close even when the body returns early" {
    let mut sink = CaptureSink {};
    let n = with Log => &mut sink do {
        in_span(&span(Level::Info, `early`), || {
            if true {
                return 7;
            }
            info(`unreachable`);
            return 0;
        });
    };
    assert n == 7;
    // exit/close still fired despite the early return inside the closure.
    let trace: List<String> = ["new:early#1", "enter:1", "exit:1", "close:1"];
    assert sink.trace == trace;
    assert sink.events.is_empty();
}

test "nested spans parent to the innermost span" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        let outer = span(Level::Info, `outer`);
        in_span(&outer, || {
            info(`in outer`);
            let inner = span(Level::Info, `inner`);
            in_span(&inner, || {
                info(`in inner`);
            });
            info(`back in outer`);
        });
    };
    assert sink.events[0].parent matches { Some(1) };
    assert sink.events[1].parent matches { Some(2) };
    assert sink.events[2].parent matches { Some(1) };
}

test "current() reports the active span and null outside" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        assert current() matches { None };
        in_span(&span(Level::Info, `s`), || {
            assert current() matches { Some(_) };
        });
        assert current() matches { None };
    };
}

test "record and follows_from reach the subscriber" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        let a = span(Level::Info, `a`);
        let b = span(Level::Info, `b`);
        a.record({ user: "alice", ip: "127.0.0.1" });
        b.follows_from(&a);
    };
    let recorded: List<String> = ["record:1:user", "record:1:ip"];
    let links: List<String> = ["2<-1"];
    assert sink.recorded == recorded;
    assert sink.links == links;
}

test "a filter layer composes over a sink" {
    let mut sink = CaptureSink {};  // passes everything
    let filt = Filter { min: Level::Warn };
    with Log => &mut sink do {
        with Log => &filt do {
            info(`drop`);
            warn(`keep`);
        };
    };
    assert sink.events.len() == 1;
    assert sink.events[0].message == "keep";
}
