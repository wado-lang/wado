//! Logger PoC — validates the `core:log` WEP design against the real compiler.
//!
//! The facade functions are `#[ambient]` (like `log_stdout`), so they perform
//! `Log` without `with Log` infecting callers and are callable anywhere —
//! modelling the ambient-effect ergonomics. The level wrappers (`info`, `warn`)
//! gate on `Log::enabled` and forward to `event`. A handler must still be
//! installed (`with Log => &sink do`), else `Log::*` traps; the ambient-effect
//! extension adds the default-handler fallback that removes that requirement.
//!
//! Fields are passed as an anonymous struct bounded by `Serialize`
//! (`info(msg, { user_id, ip })`) and boxed into a single `core:value::Value`
//! at the ambient facade, before the effect boundary — so the `Log` effect
//! itself stays non-generic. This retires the `Field` / `List<Field>` design.
//! The field parameter defaults to an empty struct, so `info(msg)` logs with
//! no fields; the default type param (`T: Serialize = NoFields`) supplies the
//! type for the omitted argument.

use { Serialize } from "core:serde";
use { Value, to_value } from "core:value";
use { TreeMap } from "core:collections";
use { to_string } from "core:json";

// Default field payload: serializes to an empty object `{}`.
pub struct NoFields {}

pub enum Level {
    Trace,
    Debug,
    Info,
    Warn,
    Error,
}

pub struct Metadata {
    pub level: Level,
    pub target: String,
    pub file: String,
    pub line: i32,
}

pub struct Event {
    pub meta: Metadata,
    pub message: String,
    pub fields: Value = Value::Null,
    pub parent: u64 = 0,  // 0 = no current span
}

fn box_fields<T: Serialize>(fields: T) -> Value {
    return match to_value(&fields) {
        Ok(v) => v,
        Err(_) => Value::Null,
    };
}

// The subscriber, as an effect (an `#[ambient]` effect in the real design).
interface Log {
    fn enabled(level: Level) -> bool;
    fn new_span(name: String) -> u64;
    fn enter(id: u64);
    fn exit(id: u64);
    fn close(id: u64);
    fn current_span() -> u64;
    fn record_fields(id: u64, fields: Value);
    fn follows_from(id: u64, cause: u64);
    fn event(event: Event);
}

// Facade; location defaults resolve at the call site. `#[ambient]` (like
// `log_stdout`) lets it perform `Log` without `with Log` infecting callers.
#[ambient]
pub fn event<T: Serialize = NoFields>(
    level: Level,
    message: String,
    fields: T = NoFields {},
    target: String = #function,
    file: String = #file,
    line: i32 = #line,
) {
    let parent = Log::current_span();
    Log::event(Event {
        meta: Metadata { level, target, file, line },
        message,
        fields: box_fields(fields),
        parent,
    });
}

#[ambient]
pub fn info<T: Serialize = NoFields>(
    message: String,
    fields: T = NoFields {},
    target: String = #function,
    file: String = #file,
    line: i32 = #line,
) {
    if !Log::enabled(Level::Info) {
        return;
    }
    event(Level::Info, message, fields, target, file, line);
}

#[ambient]
pub fn warn<T: Serialize = NoFields>(
    message: String,
    fields: T = NoFields {},
    target: String = #function,
    file: String = #file,
    line: i32 = #line,
) {
    if !Log::enabled(Level::Warn) {
        return;
    }
    event(Level::Warn, message, fields, target, file, line);
}

#[ambient]
pub fn span(name: String) -> u64 {
    return Log::new_span(name);
}

#[ambient]
pub fn record<T: Serialize = NoFields>(id: u64, fields: T = NoFields {}) {
    Log::record_fields(id, box_fields(fields));
}

#[ambient]
pub fn follows(id: u64, cause: u64) {
    Log::follows_from(id, cause);
}

#[ambient]
pub fn current() -> u64 {
    return Log::current_span();
}

// A closure can't skip the exit/close calls, so they run on every body exit path.
#[ambient]
fn in_span<T, effect E>(id: u64, body: fn() -> T with E) -> T with E {
    Log::enter(id);
    let r = body();
    Log::exit(id);
    Log::close(id);
    return r;
}

// Capturing subscriber: span stack, event parenting, lifecycle trace, level filter.
struct CaptureSink {
    min: Level = Level::Trace,
    next_id: u64 = 0,
    stack: List<u64> = [],
    events: List<Event> = [],
    trace: List<String> = [],
    recorded: List<String> = [],
    links: List<String> = [],
}

impl Log for CaptureSink {
    fn enabled(&self, level: Level) -> bool {
        resume level as i32 >= self.min as i32;
    }

    fn new_span(&mut self, name: String) -> u64 {
        self.next_id += 1;
        let id = self.next_id;
        self.trace.push(`new:{name}#{id}`);
        resume id;
    }

    fn enter(&mut self, id: u64) {
        self.stack.push(id);
        self.trace.push(`enter:{id}`);
    }

    fn exit(&mut self, id: u64) {
        self.stack.pop();
        self.trace.push(`exit:{id}`);
    }

    fn close(&mut self, id: u64) {
        self.trace.push(`close:{id}`);
    }

    fn current_span(&self) -> u64 {
        let top = match self.stack.last() {
            Some(id) => id,
            None => 0,
        };
        resume top;
    }

    fn record_fields(&mut self, id: u64, fields: Value) {
        if let Object(map) = fields {
            for let [key, _] of map.entries() {
                self.recorded.push(`record:{id}:{key}`);
            }
        }
    }

    fn follows_from(&mut self, id: u64, cause: u64) {
        self.links.push(`{id}<-{cause}`);
    }

    fn event(&mut self, event: Event) {
        self.events.push(event);
    }
}

// Contextual layer: prepend fixed fields, forward the rest. Generic over the
// field payload — a `Serialize`-bounded anonymous struct — installed directly
// as a handler via the generic `impl<T> Log for Context<T>`.
struct Context<T: Serialize> {
    fields: T,
}

impl<T: Serialize> Log for Context<T> {
    fn enabled(&self, level: Level) -> bool {
        resume Log::enabled(level);
    }

    fn new_span(&self, name: String) -> u64 {
        resume Log::new_span(name);
    }

    fn enter(&self, id: u64) {
        Log::enter(id);
    }

    fn exit(&self, id: u64) {
        Log::exit(id);
    }

    fn close(&self, id: u64) {
        Log::close(id);
    }

    fn current_span(&self) -> u64 {
        resume Log::current_span();
    }

    fn record_fields(&self, id: u64, fields: Value) {
        Log::record_fields(id, fields);
    }

    fn follows_from(&self, id: u64, cause: u64) {
        Log::follows_from(id, cause);
    }

    fn event(&self, event: Event) {
        let mut merged = TreeMap::<String, Value>::new();
        if let Object(base) = box_fields(self.fields) {
            for let [key, value] of base.entries() {
                merged[key] = value;
            }
        }
        if let Object(extra) = event.fields {
            for let [key, value] of extra.entries() {
                merged[key] = value;
            }
        }
        Log::event(Event {
            meta: event.meta,
            message: event.message,
            fields: Value::Object(merged),
            parent: event.parent,
        });
    }
}

// JSON sink: one line per event.
struct JsonSink {
    lines: List<String>,
}

impl Log for JsonSink {
    fn enabled(&self, level: Level) -> bool {
        resume true;
    }

    fn new_span(&self, name: String) -> u64 {
        resume 0;
    }

    fn enter(&self, id: u64) {
    }

    fn exit(&self, id: u64) {
    }

    fn close(&self, id: u64) {
    }

    fn current_span(&self) -> u64 {
        resume 0;
    }

    fn record_fields(&self, id: u64, fields: Value) {
    }

    fn follows_from(&self, id: u64, cause: u64) {
    }

    fn event(&mut self, event: Event) {
        match to_string(&event) {
            Ok(s) => self.lines.push(s),
            Err(_) => {
            },
        }
    }
}

// Standalone filter layer: drop below `min`, forward the rest.
struct Filter {
    min: Level,
}

impl Log for Filter {
    fn enabled(&self, level: Level) -> bool {
        resume level as i32 >= self.min as i32 && Log::enabled(level);
    }

    fn new_span(&self, name: String) -> u64 {
        resume Log::new_span(name);
    }

    fn enter(&self, id: u64) {
        Log::enter(id);
    }

    fn exit(&self, id: u64) {
        Log::exit(id);
    }

    fn close(&self, id: u64) {
        Log::close(id);
    }

    fn current_span(&self) -> u64 {
        resume Log::current_span();
    }

    fn record_fields(&self, id: u64, fields: Value) {
        Log::record_fields(id, fields);
    }

    fn follows_from(&self, id: u64, cause: u64) {
        Log::follows_from(id, cause);
    }

    fn event(&self, event: Event) {
        if event.meta.level as i32 >= self.min as i32 {
            Log::event(event);
        }
    }
}

test "captures message, level, and caller location" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        let expected_line = #line + 1;
        info(`hello`);
        assert sink.events.len() == 1;
        let e = sink.events[0];
        assert e.message == "hello";
        assert e.meta.level matches { Info };
        assert e.meta.line == expected_line;
        assert e.meta.file.contains("logger_poc.wado");

        warn(`heads up`, { code: 1 });
        assert sink.events.len() == 2;
        assert sink.events[1].meta.level matches { Warn };
    };
}

test "generic field accepts any Serialize value, preserving the data model" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        info(`with fields`, { user: "alice", n: 42 });
        let e = sink.events[0];
        if let Object(map) = e.fields {
            assert map.len() == 2;
            assert map.get("user") matches { Some(String(_)) };
            // Real to_value preserves Int (a JSON round-trip would give Float).
            assert map.get("n") matches { Some(Int(42)) };
        } else {
            panic("expected Object fields");
        }
    };
}

test "span lifecycle fires and events parent to the current span" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        let sid = span(`request`);
        in_span(sid, || {
            info(`inside`);
        });
        info(`outside`);
    };
    let trace: List<String> = ["new:request#1", "enter:1", "exit:1", "close:1"];
    assert sink.trace == trace;
    assert sink.events.len() == 2;
    assert sink.events[0].message == "inside";
    assert sink.events[0].parent == 1;  // parented to the span
    assert sink.events[1].message == "outside";
    assert sink.events[1].parent == 0;  // no current span
}

test "enabled gate drops events below the sink's minimum level" {
    let mut sink = CaptureSink { min: Level::Warn };
    with Log => &mut sink do {
        info(`dropped`);
        warn(`kept`);
    };
    assert sink.events.len() == 1;
    assert sink.events[0].message == "kept";
}

test "context layer prepends fields and forwards to outer sink" {
    let mut sink = CaptureSink {};
    let ctx = Context { fields: { request_id: "abc" } };
    with Log => &mut sink do {
        with Log => &ctx do {
            info(`x`, { k: "v" });
        };
    };
    assert sink.events.len() == 1;
    let e = sink.events[0];
    if let Object(map) = e.fields {
        assert map.len() == 2;
        let entries = map.entries();
        assert entries[0][0] == "request_id";
        assert entries[1][0] == "k";
    } else {
        panic("expected Object fields");
    }
}

test "json sink serializes whole events to one line each" {
    let mut sink = JsonSink { lines: [] };
    with Log => &mut sink do {
        info(`hi`, { k: "v" });
    };
    assert sink.lines.len() == 1;
    assert sink.lines[0].contains("message");
    assert sink.lines[0].contains("hi");
}

test "effect-polymorphic in_span returns the body value" {
    let mut sink = CaptureSink {};
    let n = with Log => &mut sink do {
        in_span(span(`compute`), || {
            info(`working`);
            return 42;
        });
    };
    assert n == 42;
    assert sink.events[0].message == "working";
}

test "in_span runs exit and close even when the body returns early" {
    let mut sink = CaptureSink {};
    let n = with Log => &mut sink do {
        in_span(span(`early`), || {
            if true {
                return 7;
            }
            info(`unreachable`);
            return 0;
        });
    };
    assert n == 7;
    // exit/close still fired despite the early return inside the closure.
    let trace: List<String> = ["new:early#1", "enter:1", "exit:1", "close:1"];
    assert sink.trace == trace;
    assert sink.events.is_empty();
}

test "nested spans parent to the innermost span" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        let outer = span(`outer`);
        in_span(outer, || {
            info(`in outer`);
            let inner = span(`inner`);
            in_span(inner, || {
                info(`in inner`);
            });
            info(`back in outer`);
        });
    };
    assert sink.events[0].parent == 1;  // in outer
    assert sink.events[1].parent == 2;  // in inner (innermost)
    assert sink.events[2].parent == 1;  // back in outer
}

test "current() reports the active span and 0 outside" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        assert current() == 0;
        in_span(span(`s`), || {
            assert current() == 1;
        });
        assert current() == 0;
    };
}

test "record_fields and follows_from reach the subscriber" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        let a = span(`a`);
        let b = span(`b`);
        record(a, { user: "alice", ip: "127.0.0.1" });
        follows(b, a);
    };
    let recorded: List<String> = ["record:1:user", "record:1:ip"];
    let links: List<String> = ["2<-1"];
    assert sink.recorded == recorded;
    assert sink.links == links;
}

test "a filter layer composes over a sink" {
    let mut sink = CaptureSink {};  // passes everything
    let filt = Filter { min: Level::Warn };
    with Log => &mut sink do {
        with Log => &filt do {
            info(`drop`);
            warn(`keep`);
        };
    };
    assert sink.events.len() == 1;
    assert sink.events[0].message == "keep";
}
