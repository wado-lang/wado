//! Logger PoC — technical validation for the `core:log` WEP.
//!
//! Validates against the real compiler, NOT the eventual API:
//! - `Log` is a plain effect here (ambient effects are not implemented yet),
//!   so every logging function carries `with Log`. This is the infectiousness
//!   that motivates the ambient-effect extension.
//!
//! Proven on today's Wado (see the test blocks below):
//! - default args capturing CALLER `#file`/`#line`/`#function`,
//! - the full Subscriber-as-effect surface: events + span lifecycle
//!   (new/enter/exit/close) + current-span parenting,
//! - effect-handler nesting + forwarding (the `Context` layer),
//! - the `enabled` gate (compile-time-style + runtime filtering),
//! - generic `field<T: Serialize>` over the real `core:value::to_value`,
//! - a JSON sink serializing whole events via `core:json`,
//! - effect-polymorphic `in_span` that brackets enter/exit/close.

use { Serialize } from "core:serde";
use { Value, to_value } from "core:value";
use { to_string } from "core:json";

pub enum Level { Trace, Debug, Info, Warn, Error }

pub struct Metadata {
    pub level: Level,
    pub target: String,
    pub file: String,
    pub line: i32,
}

pub struct Field {
    pub key: String,
    pub value: Value,
}

pub struct Event {
    pub meta: Metadata,
    pub message: String,
    pub fields: List<Field> = [],
    pub parent: u64 = 0,   // 0 = no current span
}

// Serde "derive" in Wado is an empty compiler-synthesized impl.
impl Serialize for Level;
impl Serialize for Metadata;
impl Serialize for Field;
impl Serialize for Event;

// Uses the real `core:value::to_value` (preserves the data model).
pub fn field<T: Serialize>(key: String, value: T) -> Field {
    let v = match to_value(&value) {
        Ok(v) => v,
        Err(_) => Value::Null,
    };
    return Field { key, value: v };
}

// The Subscriber-as-effect surface (would be `#[ambient]` in the real design).
interface Log {
    fn enabled(level: Level) -> bool;
    fn new_span(name: String) -> u64;
    fn enter(id: u64);
    fn exit(id: u64);
    fn close(id: u64);
    fn current_span() -> u64;
    fn record_fields(id: u64, fields: List<Field>);
    fn follows_from(id: u64, cause: u64);
    fn event(event: Event);
}

// Facade. Location defaults resolve at the CALLER (post-rebase behavior).
pub fn event(
    level: Level,
    message: String,
    fields: List<Field> = [],
    target: String = #function,
    file: String = #file,
    line: i32 = #line,
) with Log {
    if !Log::enabled(level) { return; }
    let parent = Log::current_span();
    Log::event(Event {
        meta: Metadata { level, target, file, line },
        message,
        fields,
        parent,
    });
}

pub fn info(
    message: String,
    fields: List<Field> = [],
    target: String = #function,
    file: String = #file,
    line: i32 = #line,
) with Log {
    event(Level::Info, message, fields, target, file, line);
}

pub fn warn(
    message: String,
    fields: List<Field> = [],
    target: String = #function,
    file: String = #file,
    line: i32 = #line,
) with Log {
    event(Level::Warn, message, fields, target, file, line);
}

pub fn span(name: String) -> u64 with Log {
    return Log::new_span(name);
}

pub fn record(id: u64, fields: List<Field>) with Log {
    Log::record_fields(id, fields);
}

pub fn follows(id: u64, cause: u64) with Log {
    Log::follows_from(id, cause);
}

pub fn current() -> u64 with Log {
    return Log::current_span();
}

// Effect-polymorphic scope: brackets enter/exit/close around the body. A closure
// cannot skip past the exit/close calls, so they run on every body exit path.
fn in_span<T, effect E>(id: u64, body: fn() -> T with E) -> T with E, Log {
    Log::enter(id);
    let r = body();
    Log::exit(id);
    Log::close(id);
    return r;
}

// A full capturing subscriber: tracks the span stack, parents events, records a
// lifecycle trace, and filters by a minimum level.
struct CaptureSink {
    min: Level = Level::Trace,
    next_id: u64 = 0,
    stack: List<u64> = [],
    events: List<Event> = [],
    trace: List<String> = [],
    recorded: List<String> = [],
    links: List<String> = [],
}

impl Log for CaptureSink {
    fn enabled(&self, level: Level) -> bool {
        resume (level as i32) >= (self.min as i32)
    }
    fn new_span(&mut self, name: String) -> u64 {
        self.next_id += 1;
        let id = self.next_id;
        self.trace.push(`new:{name}#{id}`);
        resume id
    }
    fn enter(&mut self, id: u64) {
        self.stack.push(id);
        self.trace.push(`enter:{id}`);
        resume ()
    }
    fn exit(&mut self, id: u64) {
        self.stack.pop();
        self.trace.push(`exit:{id}`);
        resume ()
    }
    fn close(&mut self, id: u64) {
        self.trace.push(`close:{id}`);
        resume ()
    }
    fn current_span(&self) -> u64 {
        let top: u64 = match self.stack.last() {
            Some(id) => id,
            None => 0,
        };
        resume top
    }
    fn record_fields(&mut self, id: u64, fields: List<Field>) {
        for let f of fields {
            self.recorded.push(`record:{id}:{f.key}`);
        }
        resume ()
    }
    fn follows_from(&mut self, id: u64, cause: u64) {
        self.links.push(`{id}<-{cause}`);
        resume ()
    }
    fn event(&mut self, event: Event) {
        self.events.push(event);
        resume ()
    }
}

// A contextual layer: prepends fixed fields, forwards everything to the outer
// subscriber (validates handler nesting + forwarding with the full op set).
struct Context {
    fields: List<Field>,
}

impl Log for Context {
    fn enabled(&self, level: Level) -> bool {
        resume Log::enabled(level)
    }
    fn new_span(&self, name: String) -> u64 {
        resume Log::new_span(name)
    }
    fn enter(&self, id: u64) {
        Log::enter(id);
        resume ()
    }
    fn exit(&self, id: u64) {
        Log::exit(id);
        resume ()
    }
    fn close(&self, id: u64) {
        Log::close(id);
        resume ()
    }
    fn current_span(&self) -> u64 {
        resume Log::current_span()
    }
    fn record_fields(&self, id: u64, fields: List<Field>) {
        Log::record_fields(id, fields);
        resume ()
    }
    fn follows_from(&self, id: u64, cause: u64) {
        Log::follows_from(id, cause);
        resume ()
    }
    fn event(&self, event: Event) {
        let mut merged = self.fields;
        merged.extend(&event.fields);
        Log::event(Event {
            meta: event.meta,
            message: event.message,
            fields: merged,
            parent: event.parent,
        });
        resume ()
    }
}

// A production-style sink: serialize each event to a JSON line.
struct JsonSink {
    lines: List<String>,
}

impl Log for JsonSink {
    fn enabled(&self, level: Level) -> bool {
        resume true
    }
    fn new_span(&self, name: String) -> u64 {
        resume 0 as u64
    }
    fn enter(&self, id: u64) {
        resume ()
    }
    fn exit(&self, id: u64) {
        resume ()
    }
    fn close(&self, id: u64) {
        resume ()
    }
    fn current_span(&self) -> u64 {
        resume 0 as u64
    }
    fn record_fields(&self, id: u64, fields: List<Field>) {
        resume ()
    }
    fn follows_from(&self, id: u64, cause: u64) {
        resume ()
    }
    fn event(&mut self, event: Event) {
        match to_string(&event) {
            Ok(s) => self.lines.push(s),
            Err(_) => {},
        }
        resume ()
    }
}

// A standalone filter layer (EnvFilter-style): drops below `min`, forwards the
// rest to the outer subscriber. Validates composing two real layers.
struct Filter {
    min: Level,
}

impl Log for Filter {
    fn enabled(&self, level: Level) -> bool {
        resume (level as i32) >= (self.min as i32) && Log::enabled(level)
    }
    fn new_span(&self, name: String) -> u64 {
        resume Log::new_span(name)
    }
    fn enter(&self, id: u64) {
        Log::enter(id);
        resume ()
    }
    fn exit(&self, id: u64) {
        Log::exit(id);
        resume ()
    }
    fn close(&self, id: u64) {
        Log::close(id);
        resume ()
    }
    fn current_span(&self) -> u64 {
        resume Log::current_span()
    }
    fn record_fields(&self, id: u64, fields: List<Field>) {
        Log::record_fields(id, fields);
        resume ()
    }
    fn follows_from(&self, id: u64, cause: u64) {
        Log::follows_from(id, cause);
        resume ()
    }
    fn event(&self, event: Event) {
        if (event.meta.level as i32) >= (self.min as i32) {
            Log::event(event);
        }
        resume ()
    }
}

test "captures message, level, and caller location" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        let expected_line = #line + 1;
        info(`hello`);
        assert sink.events.len() == 1;
        let e = sink.events[0];
        assert e.message == "hello";
        assert e.meta.level matches { Info };
        assert e.meta.line == expected_line;
        assert e.meta.file.contains("logger_poc.wado");

        warn(`heads up`, [field("code", 1)]);
        assert sink.events.len() == 2;
        assert sink.events[1].meta.level matches { Warn };
    }
}

test "generic field accepts any Serialize value, preserving the data model" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        info(`with fields`, [field("user", "alice"), field("n", 42)]);
        let e = sink.events[0];
        assert e.fields.len() == 2;
        assert e.fields[0].value matches { String(_) };
        // Real to_value preserves Int (a JSON round-trip would give Float).
        assert e.fields[1].value matches { Int(42) };
    }
}

test "span lifecycle fires and events parent to the current span" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        let sid = span(`request`);
        in_span(sid, || {
            info(`inside`);
        });
        info(`outside`);
    }
    let trace: List<String> = ["new:request#1", "enter:1", "exit:1", "close:1"];
    assert sink.trace == trace;
    assert sink.events.len() == 2;
    assert sink.events[0].message == "inside";
    assert sink.events[0].parent == 1;   // parented to the span
    assert sink.events[1].message == "outside";
    assert sink.events[1].parent == 0;   // no current span
}

test "enabled gate drops events below the sink's minimum level" {
    let mut sink = CaptureSink { min: Level::Warn };
    with Log => &mut sink do {
        info(`dropped`);
        warn(`kept`);
    }
    assert sink.events.len() == 1;
    assert sink.events[0].message == "kept";
}

test "context layer prepends fields and forwards to outer sink" {
    let mut sink = CaptureSink {};
    let ctx = Context { fields: [field("request_id", "abc")] };
    with Log => &mut sink do {
        with Log => &ctx do {
            info(`x`, [field("k", "v")]);
        }
    }
    assert sink.events.len() == 1;
    let e = sink.events[0];
    assert e.fields.len() == 2;
    assert e.fields[0].key == "request_id";
    assert e.fields[1].key == "k";
}

test "json sink serializes whole events to one line each" {
    let mut sink = JsonSink { lines: [] };
    with Log => &mut sink do {
        info(`hi`, [field("k", "v")]);
    }
    assert sink.lines.len() == 1;
    assert sink.lines[0].contains("message");
    assert sink.lines[0].contains("hi");
}

test "effect-polymorphic in_span returns the body value" {
    let mut sink = CaptureSink {};
    let n = with Log => &mut sink do {
        in_span(span(`compute`), || {
            info(`working`);
            return 42;
        })
    };
    assert n == 42;
    assert sink.events[0].message == "working";
}

test "in_span runs exit and close even when the body returns early" {
    let mut sink = CaptureSink {};
    let n = with Log => &mut sink do {
        in_span(span(`early`), || {
            if true {
                return 7;
            }
            info(`unreachable`);
            return 0;
        })
    };
    assert n == 7;
    // exit/close still fired despite the early return inside the closure.
    let trace: List<String> = ["new:early#1", "enter:1", "exit:1", "close:1"];
    assert sink.trace == trace;
    assert sink.events.is_empty();
}

test "nested spans parent to the innermost span" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        let outer = span(`outer`);
        in_span(outer, || {
            info(`in outer`);
            let inner = span(`inner`);
            in_span(inner, || {
                info(`in inner`);
            });
            info(`back in outer`);
        });
    }
    assert sink.events[0].parent == 1;   // in outer
    assert sink.events[1].parent == 2;   // in inner (innermost)
    assert sink.events[2].parent == 1;   // back in outer
}

test "current() reports the active span and 0 outside" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        assert current() == 0;
        in_span(span(`s`), || {
            assert current() == 1;
        });
        assert current() == 0;
    }
}

test "record_fields and follows_from reach the subscriber" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        let a = span(`a`);
        let b = span(`b`);
        record(a, [field("user", "alice"), field("ip", "127.0.0.1")]);
        follows(b, a);
    }
    let recorded: List<String> = ["record:1:user", "record:1:ip"];
    let links: List<String> = ["2<-1"];
    assert sink.recorded == recorded;
    assert sink.links == links;
}

test "a filter layer composes over a sink" {
    let mut sink = CaptureSink {};            // passes everything
    let filt = Filter { min: Level::Warn };
    with Log => &mut sink do {
        with Log => &filt do {
            info(`drop`);
            warn(`keep`);
        }
    }
    assert sink.events.len() == 1;
    assert sink.events[0].message == "keep";
}
