#!/usr/bin/env wado
// A minimal tree(1) clone in Wado.
//
// Prints a directory listing as an indented tree, much like the POSIX
// `tree` utility. Paths are resolved under the first preopened directory
// (by default `.`, the cwd of `wado run`).
//
// Usage:
//   wado run example/tree.wado [options] [path]
//
// Options:
//   -L N    descend at most N levels deep (N >= 0)
//   -a      include hidden entries (names starting with `.`)
//   -d      list directories only
//   -h      show this help
//
// Examples:
//   wado run example/tree.wado
//   wado run example/tree.wado example
//   wado run example/tree.wado -L 2 -a .

use { args, println, eprintln, Stdout, Stderr, Environment } from "core:cli";
use fs from "core:fs";
use { DirEntry, FsError } from "core:fs";
use { Preopens } from "wasi:filesystem";

struct Options {
    max_depth: i32,  // -1 = unlimited
    show_hidden: bool,
    dirs_only: bool,
    path: String,  // "" means "use the preopened root directly"
}

struct Stats {
    dirs: i32,
    files: i32,
}

fn parse_args(arguments: List<String>) -> Result<Options, String> {
    let mut opts = Options {
        max_depth: -1,
        show_hidden: false,
        dirs_only: false,
        path: "",
    };

    for let mut i = 0; i < arguments.len(); i += 1 {
        let a = arguments[i];
        if a == "-L" {
            if i + 1 >= arguments.len() {
                return Result::Err("tree: option -L requires a numeric argument");
            }
            match i32::from_str(&arguments[i + 1]) {
                Ok(n) && n >= 0 => {
                    opts.max_depth = n;
                },
                _ => {
                    return Result::Err(`tree: invalid depth: ${arguments[i + 1]}`);
                },
            }
            i += 1;  // consume the value; the loop step skips the flag
        } else if a == "-a" {
            opts.show_hidden = true;
        } else if a == "-d" {
            opts.dirs_only = true;
        } else if a == "-h" || a == "--help" {
            return Result::Err("__help__");
        } else if a.starts_with("-") {
            return Result::Err(`tree: unknown option: ${a}`);
        } else {
            if !opts.path.is_empty() {
                return Result::Err("tree: only one starting path is supported");
            }
            opts.path = a;
        }
    }
    return Result::Ok(opts);
}

fn print_help() with Stdout {
    println("Usage: tree [options] [path]");
    println("");
    println("Options:");
    println("  -L N    descend at most N levels deep");
    println("  -a      include hidden entries");
    println("  -d      list directories only");
    println("  -h      show this help");
}

/// The entries of `dir` the options keep, sorted by name. A directory that
/// cannot be read lists nothing; `walk` prints the reason.
fn collect_entries(dir: &String, opts: &Options) -> Result<List<DirEntry>, FsError> with Preopens {
    let mut out: List<DirEntry> = [];
    for let e of fs::read_dir(dir)? {
        if !opts.show_hidden && e.name.starts_with(".") {
            continue;
        }
        if opts.dirs_only && !e.type matches { Directory } {
            continue;
        }
        out.push(e);
    }
    out.sort_by(|a: &DirEntry, b: &DirEntry| a.name.cmp(&b.name));
    return Result::Ok(out);
}

/// List `dir` and print it, or print why it could not be listed in place of
/// its contents.
fn enter(dir: &String, depth: i32, prefix: String, opts: &Options, stats: &mut Stats) with (Stdout, Stderr, Preopens) {
    match collect_entries(dir, opts) {
        Ok(entries) => walk(dir, &entries, depth, prefix, opts, stats),
        Err(e) => println(`${prefix}[${e}]`),
    }
}

fn walk(
    dir: &String,
    entries: &List<DirEntry>,
    depth: i32,
    prefix: String,
    opts: &Options,
    stats: &mut Stats,
) with (Stdout, Stderr, Preopens) {
    let n = entries.len();
    for let mut i = 0; i < n; i += 1 {
        let entry = &entries[i];
        let is_last = i == n - 1;
        let connector = if is_last { "└── " } else { "├── " };
        let next_prefix_fragment = if is_last { "    " } else { "│   " };

        let is_dir = entry.type matches { Directory };
        let suffix = if is_dir { "/" } else { "" };

        println(`${prefix}${connector}${entry.name}${suffix}`);

        if is_dir {
            stats.dirs += 1;
            let can_recurse = opts.max_depth < 0 || depth < opts.max_depth;
            if can_recurse {
                let mut child_prefix = String::with_capacity(prefix.len() + 4);
                child_prefix.push_str(&prefix);
                child_prefix.push_str(&next_prefix_fragment);
                enter(&join_path(dir, &entry.name), depth + 1, child_prefix, opts, stats);
            }
        } else {
            stats.files += 1;
        }
    }
}

/// `name` under `dir`, which is empty at the preopened directory itself.
fn join_path(dir: &String, name: &String) -> String {
    if dir.is_empty() {
        return *name;
    }
    return `${dir}/${name}`;
}

export fn run() with (Stdout, Stderr, Environment, Preopens) {
    let opts = match parse_args(args()) {
        Ok(o) => o,
        Err(msg) => {
            if msg == "__help__" {
                print_help();
                return;
            }
            eprintln(msg);
            return;
        },
    };

    // The empty path is the preopened directory itself, which `core:fs`
    // resolves; only the label printed on the first line differs.
    let label = if opts.path.is_empty() { "." } else { opts.path };

    // The starting directory is listed here rather than in `enter`, so a path
    // that cannot be listed reports itself instead of printing a header.
    let entries = match collect_entries(&opts.path, &opts) {
        Ok(list) => list,
        Err(e) => {
            eprintln(`tree: ${e}`);
            return;
        },
    };

    let mut stats = Stats { dirs: 0, files: 0 };
    println(label);
    if opts.max_depth != 0 {
        walk(&opts.path, &entries, 1, "", &opts, &mut stats);
    }

    println("");
    let dir_word = if stats.dirs == 1 { "directory" } else { "directories" };
    let file_word = if stats.files == 1 { "file" } else { "files" };
    if opts.dirs_only {
        println(`${stats.dirs} ${dir_word}`);
    } else {
        println(`${stats.dirs} ${dir_word}, ${stats.files} ${file_word}`);
    }
}
