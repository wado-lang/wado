// httpbin clone — a simple HTTP request & response inspection service
//
// Compile and run with wado serve:
//   cargo run --bin wado -- serve example/http-bin.wado
//
// Endpoints:
//   GET  /              — HTML homepage
//   GET  /get           — returns request info as JSON
//   POST /post          — returns request info + body as JSON
//   PUT  /put           — returns request info + body as JSON
//   PATCH /patch        — returns request info + body as JSON
//   DELETE /delete      — returns request info as JSON
//   GET  /headers       — returns request headers as JSON
//   GET  /ip            — returns origin IP as JSON
//   GET  /user-agent    — returns User-Agent as JSON
//   GET  /status/:code  — returns the given HTTP status code
//   GET  /base64/:val   — decodes base64-encoded value
//   *    /anything      — returns request info for any method

use { Request, Response, ErrorCode, Fields, FieldName, FieldValue, Trailers, StatusCode, Method, Scheme } from "wasi:http";
use { TreeMap } from "core:collections";
use { decode } from "core:base64";
use { Serialize } from "core:serde";
use { Url } from "core:url";
use { log_stderr } from "core:cli";
use { MonotonicClock } from "wasi:clocks";
use json from "core:json";

struct RequestInfo {
    method: String,
    path: String,
    args: TreeMap<String, String>,
    headers: TreeMap<String, String>,
    origin: String,
    url: String,
    data: Option<String>,
}
impl Serialize for RequestInfo;

struct ErrorResponse {
    error: String,
}
impl Serialize for ErrorResponse;

struct HeadersResponse {
    headers: TreeMap<String, String>,
}
impl Serialize for HeadersResponse;

struct IpResponse {
    origin: Option<String>,
}
impl Serialize for IpResponse;

#[serde(rename_all = "kebab-case")]
struct UserAgentResponse {
    user_agent: Option<String>,
}
impl Serialize for UserAgentResponse;

#[serde(rename_all = "kebab-case")]
struct AccessLog {
    method: String,
    path: String,
    user_agent: Option<String>,
    status: StatusCode,
    duration_us: u64,
}
impl Serialize for AccessLog;

fn scheme_name(s: Option<Scheme>) -> String {
    return match s {
        Some(Http) => "http",
        Some(Https) => "https",
        Some(Other(name)) => name,
        None => "http",
    };
}

/// Returns the substring after `prefix` if `s` starts with it, else None.
fn strip_prefix(s: String, prefix: String) -> Option<String> {
    if s.starts_with(prefix) {
        return Option::Some(s.substr_bytes(prefix.len(), s.len()));
    }
    return null;
}

fn method_name(m: Method) -> String {
    return match m {
        Get => "GET",
        Head => "HEAD",
        Post => "POST",
        Put => "PUT",
        Delete => "DELETE",
        Connect => "CONNECT",
        Options => "OPTIONS",
        Trace => "TRACE",
        Patch => "PATCH",
        Other(s) => s,
    };
}

fn headers_to_map(headers: &Headers) -> TreeMap<String, String> {
    let mut map: TreeMap<String, String> = {};
    for let [name, value] of headers.copy_all() {
        map[name] = String::from_utf8_lossy(value);
    }
    return map;
}

/// Returns the first value for `name`, or None if the header is not set.
fn get_header(headers: &Headers, name: FieldName) -> Option<String> {
    let values = headers.get(name);
    if values.is_empty() {
        return null;
    }
    return Option::Some(String::from_utf8_lossy(values[0]));
}

/// wasmtime v43 typically leaves the authority unset for incoming HTTP/1.1
/// requests since the host travels in the Host header. Fall back to it.
fn resolve_authority(request: &Request) -> String {
    if let Some(a) = request.get_authority() && !a.is_empty() {
        return a;
    }
    let h = request.get_headers();
    return match get_header(&h, "host") {
        Some(host) => host,
        None => "",
    };
}

fn read_body_from_request(request: Request) -> String {
    let [res_future, _res_tx] = Future::<Result<(), ErrorCode>>::new();
    let [body_stream, _trailers] = Request::consume_body(request, res_future);
    // Accumulate raw bytes first — a multi-byte UTF-8 scalar may straddle
    // chunk boundaries, so we can't decode chunk-by-chunk.
    let mut buf: Array<u8> = [];
    loop {
        let chunk = body_stream.read(4096);
        if chunk.len() == 0 {
            break;
        }
        buf.extend(&chunk);
    }
    body_stream.drop();
    return match String::from_utf8(buf) {
        Ok(s) => s,
        Err(_) => "",
    };
}

fn parse_status_code(s: String) -> Option<u16> {
    if s.is_empty() {
        return null;
    }
    if let Some(f) = f64::parse(s) {
        let code = f as i32;
        if 100 <= code <= 599 && f == code as f64 {
            return Option::Some(code as u16);
        }
    }
    return null;
}

fn build_request_json(
    method: Method,
    url: String,
    path: String,
    args: TreeMap<String, String>,
    headers: &Headers,
    body: Option<String>,
) -> String {
    let origin = match get_header(headers, "x-forwarded-for") {
        Some(s) => s,
        None => "",
    };
    return json::to_string_pretty(&RequestInfo {
        method: method_name(method),
        path,
        args,
        headers: headers_to_map(headers),
        origin,
        url,
        data: body,
    }).unwrap() + "\n";
}

fn json_error(msg: String) -> String {
    return json::to_string_pretty(&ErrorResponse { error: msg }).unwrap() + "\n";
}

fn handle_fallback(
    request: Request,
    method: Method,
    url: String,
    path: String,
    args: TreeMap<String, String>,
) -> [StatusCode, String, String] {
    if let Some(code_str) = strip_prefix(path, "/status/") {
        if let Some(code) = parse_status_code(code_str) {
            return [code as StatusCode, "text/plain", ""];
        }
        return [400, "application/json", json_error("Invalid status code") + "\n"];
    }
    if let Some(encoded) = strip_prefix(path, "/base64/") {
        if let Some(decoded_bytes) = decode(encoded) {
            return [200, "text/plain", String::from_utf8_lossy(decoded_bytes)];
        }
        return [400, "application/json", json_error("Invalid base64") + "\n"];
    }
    if path == "/anything" || path.starts_with("/anything/") {
        let h = request.get_headers();
        if method matches { Post | Put | Patch } {
            let data = read_body_from_request(request);
            return [
                200,
                "application/json",
                build_request_json(method, url, path, args, &h, Option::Some(data)) + "\n",
            ];
        }
        return [
            200,
            "application/json",
            build_request_json(method, url, path, args, &h, null) + "\n",
        ];
    }
    return [404, "application/json", json_error("Not Found")];
}

fn echo_if_method(
    request: Request,
    method: Method,
    expected: Method,
    label: String,
    read_body: bool,
    url: String,
    path: String,
    args: TreeMap<String, String>,
) -> [StatusCode, String, Option<String>] {
    if method != expected {
        return [
            405,
            json_error(`Method Not Allowed. Use {label}.`),
            Option::Some(label),
        ];
    }
    let h = request.get_headers();
    if read_body {
        let data = read_body_from_request(request);
        return [
            200,
            build_request_json(method, url, path, args, &h, Option::Some(data)),
            null,
        ];
    }
    return [
        200,
        build_request_json(method, url, path, args, &h, null),
        null,
    ];
}

global HOMEPAGE: String = #include_str("./http-bin-index.html");

export async fn handle(request: Request) -> Result<Response, ErrorCode> with MonotonicClock {
    let start_mark = MonotonicClock::now();
    let method = request.get_method();
    let scheme = scheme_name(request.get_scheme());
    let authority = resolve_authority(&request);
    let request_url = Url::from_parts(scheme, authority, request.get_path_with_query(), null);
    let url = request_url.to_string();
    let path = request_url.path;
    let args = request_url.query_params();
    let h = request.get_headers();
    let user_agent = get_header(&h, "user-agent");

    let mut status: StatusCode = 200;
    let mut content_type = "application/json";
    let mut body_str: String;
    let mut allow: Option<String> = null;

    match path {
        "/" => {
            content_type = "text/html; charset=utf-8";
            body_str = HOMEPAGE;
        },
        "/get" => {
            let [s, b, a] = echo_if_method(request, method, Method::Get, "GET", false, url, path, args);
            status = s;
            body_str = b;
            allow = a;
        },
        "/post" => {
            let [s, b, a] = echo_if_method(request, method, Method::Post, "POST", true, url, path, args);
            status = s;
            body_str = b;
            allow = a;
       },
        "/put" => {
            let [s, b, a] = echo_if_method(request, method, Method::Put, "PUT", true, url, path, args);
            status = s;
            body_str = b;
            allow = a;
        },
        "/patch" => {
            let [s, b, a] = echo_if_method(request, method, Method::Patch, "PATCH", true, url, path, args);
            status = s;
            body_str = b;
            allow = a;
        },
        "/delete" => {
            let [s, b, a] = echo_if_method(request, method, Method::Delete, "DELETE", false, url, path, args);
            status = s;
            body_str = b;
            allow = a;
        },
        "/headers" => {
            body_str = json::to_string_pretty(&HeadersResponse { headers: headers_to_map(&h) }).unwrap() + "\n";
        },
        "/ip" => {
            let origin = get_header(&h, "x-forwarded-for");
            body_str = json::to_string_pretty(&IpResponse { origin }).unwrap() + "\n";
        },
        "/user-agent" => {
            body_str = json::to_string_pretty(&UserAgentResponse { user_agent }).unwrap() + "\n";
        },
        _ => {
            let [s, c, b] = handle_fallback(request, method, url, path, args);
            status = s;
            content_type = c;
            body_str = b;
        },
    };

    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [body_rx, body_tx] = Stream::<u8>::new();

    let resp_headers = Fields::new();
    resp_headers.append("server", #file.as_bytes() as FieldValue);
    resp_headers.append("content-type", content_type.as_bytes() as FieldValue);
    resp_headers.append("trailer", "server-timing".as_bytes() as FieldValue);
    if let Some(a) = allow {
        resp_headers.append("allow", a.as_bytes() as FieldValue);
    }
    let [response, _response_tx] = Response::new(resp_headers, Option::Some(body_rx), trailers_future);
    response.set_status_code(status);

    task return Result::Ok(response);

    body_tx.write(body_str.as_bytes());
    body_tx.drop();

    // Server-Timing trailer carries the handler's wall-clock time so curious
    // clients can see it without re-running. Only delivered to clients that
    // sent `TE: trailers` per RFC 7230 §4.3.
    let elapsed = MonotonicClock::now() - start_mark;
    let elapsed_ms = (elapsed as f64) / 1_000_000.0;
    let trailers = Trailers::new();
    trailers.append(
        "server-timing",
        `app;dur={elapsed_ms:0.3f}`.as_bytes() as FieldValue,
    );
    trailers_tx.write(Result::Ok(Option::Some(trailers as Trailers)));

    // Access log: emit request summary as JSON to stderr after the
    // response body has been written out. `log_stderr` appends its own
    // newline so we don't add one here.
    log_stderr(json::to_string(&AccessLog {
        method: method_name(method),
        path,
        user_agent,
        status,
        duration_us: (elapsed as u64) / 1000,
    }).unwrap());
}
