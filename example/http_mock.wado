//! Standalone tests for a wasi:http service, with both directions mocked by
//! effect handlers — no network, no host-side mocks:
//!
//! - serve: construct real `Request` values and call the handler logic
//!   directly, instead of waiting for the host to deliver one.
//! - send: handle the async `Client::send` effect; the handler resumes with
//!   an already-resolved `Result<Response, ErrorCode>` and the caller's
//!   `.wait()` proceeds as if the call had completed synchronously.
//!
//! Mocked responses carry data in the status code and headers only: a body
//! stream needs a concurrent reader (the host), which a same-task mock
//! cannot provide. For the same reason a test ends each trailers future itself,
//! once nothing reads the message it belongs to.
//!
//! Run the tests with `wado test example/http_mock.wado`, or serve for real
//! with `wado serve example/http_mock.wado`.

use { Request, Response, ErrorCode, Headers, FieldName, FieldValue, Trailers, StatusCode } from "wasi:http";
use { Client } from "wasi:http";

// Ends a message's trailers. An end dropped unwritten traps, and a write waits
// for its reader, so it is written once the message is done.
fn end_trailers(end: FutureWritable<Result<Option<Trailers>, ErrorCode>>) {
    end.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

// A tiny gateway: `/status` reports the upstream health-check status in an
// `x-upstream-status` response header, mapping upstream failures to 502.
fn gateway(req: Request) -> [Response, FutureWritable<Result<Option<Trailers>, ErrorCode>>] with Client {
    let path = match req.get_path_with_query() {
        Some(p) => p,
        None => "/",
    };
    if path != "/status" {
        return respond(404, []);
    }

    let [trailers_rx, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [out_req, _req_future] = Request::new(Headers::new(), null, trailers_rx, null);
    out_req.set_authority(Option::<String>::Some("upstream.internal"));
    out_req.set_path_with_query(Option::<String>::Some("/health"));

    let sent = Client::send(out_req).wait();
    end_trailers(trailers_tx);
    return match sent {
        Ok(upstream) => {
            let status = upstream.get_status_code() as i32;
            respond(200, [
                ["x-upstream-status", `${status}`],
            ]);
        },
        Err(_) => respond(502, []),
    };
}

fn respond(
    status: StatusCode,
    headers: List<[String, String]>,
) -> [Response, FutureWritable<Result<Option<Trailers>, ErrorCode>>] {
    let fields = Headers::new();
    for let [name, value] of headers {
        let _ = fields.append(name as FieldName, value.bytes().collect() as FieldValue);
    }
    let [trailers_rx, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [resp, _tx_future] = Response::new(fields, null, trailers_rx);
    let _ = resp.set_status_code(status);
    return [resp, trailers_tx];
}

// A Wado call runs the handler to its end, where it writes the trailers nothing
// reads yet, so the tests call `gateway` rather than this.
export async fn handle(request: Request) -> Result<Response, ErrorCode> with Client {
    let [response, trailers] = gateway(request);
    task return Result::<Response, ErrorCode>::Ok(response);
    end_trailers(trailers);
}

// Send-side mock: records every outgoing request path and replays a canned
// status. Installed with `with Client => &mut mock do { ... }`. It keeps the
// trailers end of each response it makes, for `end_writes`.
affine struct MockUpstream {
    hits: List<String> = [],
    status: StatusCode = 200,
    ends: List<FutureWritable<Result<Option<Trailers>, ErrorCode>>> = [],
}

impl MockUpstream {
    fn end_writes(&mut self) {
        while let Some(end) = self.ends.pop() {
            end_trailers(end);
        }
    }
}

impl Client for MockUpstream {
    fn send(&mut self, request: Request) -> Result<Response, ErrorCode> {
        let path = match request.get_path_with_query() {
            Some(p) => p,
            None => "",
        };
        self.hits.push(path);
        let [resp, end] = respond(self.status, []);
        self.ends.push(end);
        resume Result::<Response, ErrorCode>::Ok(resp);
    }
}

// Failure-mode mock: every send is refused at the connection level.
struct DeadUpstream {
}

impl Client for DeadUpstream {
    fn send(&self, request: Request) -> Result<Response, ErrorCode> {
        let _ = request;
        resume Result::<Response, ErrorCode>::Err(ErrorCode::ConnectionRefused);
    }
}

// Serve-side mock: a real `Request` resource, constructed instead of
// received from the network.
fn get(path: String) -> [Request, FutureWritable<Result<Option<Trailers>, ErrorCode>>] {
    let [trailers_rx, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [req, _req_future] = Request::new(Headers::new(), null, trailers_rx, null);
    req.set_path_with_query(Option::<String>::Some(path));
    return [req, trailers_tx];
}

// Drops a response the gateway answered, then ends what nothing reads any more.
fn finish(
    answer: [Response, FutureWritable<Result<Option<Trailers>, ErrorCode>>],
    request_end: FutureWritable<Result<Option<Trailers>, ErrorCode>>,
) {
    let [response, response_end] = answer;
    builtin::drop(response);
    end_trailers(response_end);
    end_trailers(request_end);
}

fn header_text(resp: &Response, name: String) -> String {
    let values = resp.get_headers().get(name as FieldName);
    assert values.len() == 1;
    return String::from_utf8_lossy(values[0]);
}

test "/status pings the upstream and reports its status" {
    let mut upstream = MockUpstream { status: 204 };
    let [req, req_end] = get("/status");
    let answer = with Client => &mut upstream do {
        gateway(req);
    };
    assert answer.0.get_status_code() == 200;
    assert header_text(&answer.0, "x-upstream-status") == "204";
    let hits: List<String> = ["/health"];
    assert upstream.hits == hits;
    finish(answer, req_end);
    upstream.end_writes();
}

test "unknown path is 404 and never touches the upstream" {
    let mut upstream = MockUpstream {};
    let [req, req_end] = get("/nope");
    let answer = with Client => &mut upstream do {
        gateway(req);
    };
    assert answer.0.get_status_code() == 404;
    assert upstream.hits.is_empty();
    finish(answer, req_end);
}

test "upstream connection failure maps to 502" {
    let dead = DeadUpstream {};
    let [req, req_end] = get("/status");
    let answer = with Client => &dead do {
        gateway(req);
    };
    assert answer.0.get_status_code() == 502;
    finish(answer, req_end);
}

test "each request hits the upstream once" {
    let mut upstream = MockUpstream {};
    with Client => &mut upstream do {
        for let _ of 0..<2 {
            let [req, req_end] = get("/status");
            finish(gateway(req), req_end);
        }
    };
    let hits: List<String> = ["/health", "/health"];
    assert upstream.hits == hits;
    upstream.end_writes();
}
