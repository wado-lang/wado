fn escape_json_string(s: &String) -> String {
    let mut result = String::with_capacity(s.len() + 2);
    result.push('"');
    for let c of s.chars() {
        let code = c as u32;
        if c == '"' {
            result.push_str("\\\"");
        } else if c == '\\' {
            result.push_str("\\\\");
        } else if c == '\n' {
            result.push_str("\\n");
        } else if c == '\r' {
            result.push_str("\\r");
        } else if c == '\t' {
            result.push_str("\\t");
        } else if code == 0x08 {
            result.push_str("\\b");
        } else if code == 0x0C {
            result.push_str("\\f");
        } else if code < 0x20 {
            // Other control characters → \u00XX
            result.push_str("\\u00");
            let hi = code >> 4 & 0x0F;
            let lo = code & 0x0F;
            if hi < 10 {
                result.push(char::from_u32_unchecked('0' as u32 + hi));
            } else {
                result.push(char::from_u32_unchecked('a' as u32 + hi - 10));
            }
            if lo < 10 {
                result.push(char::from_u32_unchecked('0' as u32 + lo));
            } else {
                result.push(char::from_u32_unchecked('a' as u32 + lo - 10));
            }
        } else {
            result.push(c);
        }
    }
    result.push('"');
    return result;
}

fn format_number(n: f64) -> String {
    if !n.is_nan() && n.is_finite() && n == f64::floor(n) && f64::abs(n) < 9007199254740992.0 {
        let i = n as i64;
        return `{i}`;
    }
    return `{n}`;
}

pub fn stringify(value: &JsonValue) -> String {
    return match *value {
        Null => "null",
        Bool(b) => if b { "true" } else { "false" },
        Number(n) => format_number(n),
        Str(s) => escape_json_string(&s),
        Arr(items) => {
            let mut result = String::with_capacity(32);
            result.push('[');
            for let mut i = 0; i < items.len(); i += 1 {
                if i > 0 {
                    result.push(',');
                }
                result.push_str(stringify(&items[i]));
            }
            result.push(']');
            result;
        },
        Obj(map) => {
            let mut result = String::with_capacity(32);
            result.push('{');
            let entries = map.entries();
            for let mut i = 0; i < entries.len(); i += 1 {
                if i > 0 {
                    result.push(',');
                }
                let [key, val] = entries[i];
                result.push_str(escape_json_string(&key));
                result.push(':');
                result.push_str(stringify(&val));
            }
            result.push('}');
            result;
        },
    };
}

fn make_indent(level: i32, size: i32) -> String {
    let total = level * size;
    let mut s = String::with_capacity(total);
    for let mut i = 0; i < total; i += 1 {
        s.push(' ');
    }
    return s;
}

fn stringify_at_level(value: &JsonValue, level: i32, indent_size: i32) -> String {
    return match *value {
        Null => "null",
        Bool(b) => if b { "true" } else { "false" },
        Number(n) => format_number(n),
        Str(s) => escape_json_string(&s),
        Arr(items) => {
            if items.len() == 0 {
                "[]";
            } else {
                let mut result = String::with_capacity(64);
                result.push_str("[\n");
                for let mut i = 0; i < items.len(); i += 1 {
                    result.push_str(make_indent(level + 1, indent_size));
                    result.push_str(stringify_at_level(&items[i], level + 1, indent_size));
                    if i < items.len() - 1 {
                        result.push(',');
                    }
                    result.push('\n');
                }
                result.push_str(make_indent(level, indent_size));
                result.push(']');
                result;
            }
        },
        Obj(map) => {
            let entries = map.entries();
            if entries.len() == 0 {
                "{}";
            } else {
                let mut result = String::with_capacity(64);
                result.push_str("{\n");
                for let mut i = 0; i < entries.len(); i += 1 {
                    let [key, val] = entries[i];
                    result.push_str(make_indent(level + 1, indent_size));
                    result.push_str(escape_json_string(&key));
                    result.push_str(": ");
                    result.push_str(stringify_at_level(&val, level + 1, indent_size));
                    if i < entries.len() - 1 {
                        result.push(',');
                    }
                    result.push('\n');
                }
                result.push_str(make_indent(level, indent_size));
                result.push('}');
                result;
            }
        },
    };
}

fn stringify_pretty(value: &JsonValue) -> String {
    return stringify_at_level(value, 0, 2);
}


test "stringify-null" {
    let v = JsonValue::Null;
    assert stringify(&v) == "null";
}

test "stringify-bool" {
    let t = JsonValue::Bool(true);
    let f = JsonValue::Bool(false);
    assert stringify(&t) == "true";
    assert stringify(&f) == "false";
}

test "stringify-number-integer" {
    let v = JsonValue::Number(42.0);
    assert stringify(&v) == "42";
}

test "stringify-number-float" {
    let v = JsonValue::Number(3.14);
    let s = stringify(&v);
    assert s == "3.14";
}

test "stringify-string" {
    let v = JsonValue::Str("hello");
    assert stringify(&v) == "\"hello\"";
}

test "stringify-string-with-escapes" {
    let v = JsonValue::Str("a\nb");
    assert stringify(&v) == "\"a\\nb\"";
}

test "stringify-empty-array" {
    let empty: Array<JsonValue> = [];
    let v = JsonValue::Arr(empty);
    assert stringify(&v) == "[]";
}

test "stringify-array" {
    let mut items: Array<JsonValue> = [];
    items.push(JsonValue::Number(1.0));
    items.push(JsonValue::Number(2.0));
    items.push(JsonValue::Number(3.0));
    let v = JsonValue::Arr(items);
    assert stringify(&v) == "[1,2,3]";
}

test "stringify-empty-object" {
    let v = JsonValue::Obj(TreeMap::<String, JsonValue>::new());
    assert stringify(&v) == "{}";
}

test "stringify-object" {
    let mut map = TreeMap::<String, JsonValue>::new();
    map["name"] = JsonValue::Str("Alice");
    map["age"] = JsonValue::Number(30.0);
    let v = JsonValue::Obj(map);
    let s = stringify(&v);
    assert s == "{\"name\":\"Alice\",\"age\":30}";
}

test "roundtrip-complex" {
    let input = "{\"name\":\"test\",\"values\":[1,2,3],\"active\":true,\"data\":null}";
    if let Some(parsed) = parse_json(input) {
        let output = stringify(&parsed);
        // Parse again and stringify to verify stability
        if let Some(reparsed) = parse_json(output) {
            let output2 = stringify(&reparsed);
            assert output == output2;
        } else {
            assert false;
        }
    } else {
        assert false;
    }
}

test "roundtrip-unicode" {
    let input = "{\"greeting\":\"こんにちは\",\"emoji\":\"😀\"}";
    if let Some(parsed) = parse_json(input) {
        let output = stringify(&parsed);
        if let Some(reparsed) = parse_json(output) {
            let output2 = stringify(&reparsed);
            assert output == output2;
        } else {
            assert false;
        }
    } else {
        assert false;
    }
}

test "format-number-integers" {
    assert format_number(42.0) == "42";
    assert format_number(-7.0) == "-7";
    assert format_number(0.0) == "0";
    assert format_number(1000000.0) == "1000000";
}

test "format-number-floats" {
    assert format_number(3.14) == "3.14";
    assert format_number(-0.5) == "-0.5";
}

test "stringify-pretty-empty" {
    let empty_arr: Array<JsonValue> = [];
    let v = JsonValue::Arr(empty_arr);
    assert stringify_pretty(&v) == "[]";

    let v2 = JsonValue::Obj(TreeMap::<String, JsonValue>::new());
    assert stringify_pretty(&v2) == "{}";
}

test "stringify-pretty-array" {
    let mut items: Array<JsonValue> = [];
    items.push(JsonValue::Number(1.0));
    items.push(JsonValue::Number(2.0));
    items.push(JsonValue::Number(3.0));
    let v = JsonValue::Arr(items);
    assert stringify_pretty(&v) == "[\n  1,\n  2,\n  3\n]";
}

test "stringify-pretty-object" {
    let mut map = TreeMap::<String, JsonValue>::new();
    map["name"] = JsonValue::Str("Alice");
    map["age"] = JsonValue::Number(30.0);
    let v = JsonValue::Obj(map);
    let s = stringify_pretty(&v);
    assert s == "{\n  \"name\": \"Alice\",\n  \"age\": 30\n}";
}

test "stringify-pretty-nested" {
    let mut inner = TreeMap::<String, JsonValue>::new();
    inner["x"] = JsonValue::Number(1.0);
    let mut outer = TreeMap::<String, JsonValue>::new();
    outer["obj"] = JsonValue::Obj(inner);
    let v = JsonValue::Obj(outer);
    let s = stringify_pretty(&v);
    assert s == "{\n  \"obj\": {\n    \"x\": 1\n  }\n}";
}

test "roundtrip-pretty" {
    let input = "{\"a\":1,\"b\":[2,3],\"c\":{\"d\":true}}";
    if let Some(parsed) = parse_json(input) {
        let pretty = stringify_pretty(&parsed);
        if let Some(reparsed) = parse_json(pretty) {
            let compact = stringify(&reparsed);
            assert compact == input;
        } else {
            assert false;
        }
    } else {
        assert false;
    }
}


export fn run() with Stdout {
    let input = "{\"name\":\"Wado\",\"version\":1,\"features\":[\"JSON\",\"UTF-8\",\"Unicode\"],\"emoji\":\"🎉\",\"nested\":{\"language\":\"日本語\",\"ok\":true},\"nothing\":null}";

    if let Some(parsed) = parse_json(input) {
        println("Parsed successfully!");
        let output = stringify(&parsed);
        println(output);

        // Verify round-trip
        if let Some(reparsed) = parse_json(output) {
            let output2 = stringify(&reparsed);
            assert output == output2;
            println("Round-trip OK");
        }
    } else {
        println("Parse failed!");
    }
}

__DATA__
{"test": {}, "stdout": "Parsed successfully!\n{\"name\":\"Wado\",\"version\":1,\"features\":[\"JSON\",\"UTF-8\",\"Unicode\"],\"emoji\":\"🎉\",\"nested\":{\"language\":\"日本語\",\"ok\":true},\"nothing\":null}\nRound-trip OK\n"}
