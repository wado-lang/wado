impl Parser {
    fn parse_string_value(&mut self) -> Option<String> {
        self.skip_whitespace();

        if !self.expect_byte('"' as u8) {
            return null;
        }

        let mut result = String::with_capacity(16);

        loop {
            if self.is_eof() {
                return null;
            }

            let b = self.bytes[self.pos];

            // End of string
            if b == '"' as u8 {
                self.advance();
                return Option::<String>::Some(result);
            }

            // Escape sequence
            if b == '\\' as u8 {
                self.advance();
                if self.is_eof() {
                    return null;
                }
                let esc = self.bytes[self.pos];
                self.advance();

                if esc == '"' as u8 {
                    result.push('"');
                } else if esc == '\\' as u8 {
                    result.push('\\');
                } else if esc == '/' as u8 {
                    result.push('/');
                } else if esc == 'b' as u8 {
                    result.push(char::from_u32_unchecked(0x08 as u32));
                } else if esc == 'f' as u8 {
                    result.push(char::from_u32_unchecked(0x0C as u32));
                } else if esc == 'n' as u8 {
                    result.push('\n');
                } else if esc == 'r' as u8 {
                    result.push('\r');
                } else if esc == 't' as u8 {
                    result.push('\t');
                } else if esc == 'u' as u8 {
                    let cp = self.parse_unicode_escape();
                    if cp < 0 {
                        return null;
                    }

                    if is_high_surrogate(cp) {
                        // Expect \uXXXX for low surrogate
                        if !self.expect_byte('\\' as u8) {
                            return null;
                        }
                        if !self.expect_byte('u' as u8) {
                            return null;
                        }
                        let low = self.parse_unicode_escape();
                        if low < 0 || !is_low_surrogate(low) {
                            return null;
                        }
                        let full_cp = surrogate_to_codepoint(cp, low);
                        if let Some(c) = char::from_i32(full_cp) {
                            result.push(c);
                        } else {
                            return null;
                        }
                    } else if is_low_surrogate(cp) {
                        return null;
                    } else if let Some(c) = char::from_i32(cp) {
                        result.push(c);
                    } else {
                        return null;
                    }
                } else {
                    return null;
                }
            } else {
                // Raw UTF-8 byte: decode and validate
                let cp = self.decode_utf8();
                if cp < 0 {
                    return null;
                }
                result.push(char::from_u32_unchecked(cp as u32));
            }
        }
    }

    fn parse_string(&mut self) -> Option<JsonValue> {
        if let Some(s) = self.parse_string_value() {
            return Option::<JsonValue>::Some(JsonValue::Str(s));
        }
        return null;
    }
}

test "parse-string-simple" {
    let mut p = Parser::new("\"hello\"");
    if let Some(v) = p.parse_string() {
        if let Str(s) = v {
            assert s == "hello";
        } else {
            assert false;
        }
    } else {
        assert false;
    }
}

