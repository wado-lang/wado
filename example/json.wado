impl Parser {
    fn parse_object(&mut self) -> Option<JsonValue> {
        self.skip_whitespace();

        if !self.expect_byte('{' as u8) {
            return null;
        }
        self.skip_whitespace();

        if self.expect_byte('}' as u8) {
            return Option::<JsonValue>::Some(JsonValue::Obj(TreeMap::<String, JsonValue>::new()));
        }

        let mut map = TreeMap::<String, JsonValue>::new();
        loop {
            self.skip_whitespace();
            let key_opt = self.parse_string_value();
            if let Some(key) = key_opt {
                self.skip_whitespace();
                if !self.expect_byte(':' as u8) {
                    return null;
                }

                if let Some(val) = self.parse_value() {
                    map[key] = val;
                } else {
                    return null;
                }
            } else {
                return null;
            }

            self.skip_whitespace();
            if self.expect_byte('}' as u8) {
                return Option::<JsonValue>::Some(JsonValue::Obj(map));
            }
            if !self.expect_byte(',' as u8) {
                return null;
            }
        }
    }
}

