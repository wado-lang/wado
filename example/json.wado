// JSON Parser and Stringifier in Wado
//
// A complete JSON parser that:
// - Operates on byte arrays for proper UTF-8 validation
// - Builds a JsonValue tree (recursive variant)
// - Supports all JSON types: null, bool, number, string, array, object
// - Handles escape sequences including \uXXXX and surrogate pairs
// - Validates UTF-8 byte sequences with precise error detection
// - Stringifies JsonValue back to JSON text

use { println, Stdout } from "core:cli";
use { TreeMap } from "core:collections";


pub variant JsonValue {
    Null,
    Bool(bool),
    Number(f64),
    Str(String),
    Arr(Array<JsonValue>),
    Obj(TreeMap<String, JsonValue>),
}


fn is_digit(b: u8) -> bool {
    return b >= '0' as u8 && b <= '9' as u8;
}

fn is_hex_digit(b: u8) -> bool {
    return b >= '0' as u8 && b <= '9' as u8 || b >= 'A' as u8 && b <= 'F' as u8 || b >= 'a' as u8 && b <= 'f' as u8;
}

fn hex_to_i32(b: u8) -> i32 {
    if b >= '0' as u8 && b <= '9' as u8 {
        return b as i32 - '0' as i32;
    }
    if b >= 'A' as u8 && b <= 'F' as u8 {
        return b as i32 - 'A' as i32 + 10;
    }
    if b >= 'a' as u8 && b <= 'f' as u8 {
        return b as i32 - 'a' as i32 + 10;
    }
    return -1;
}

fn is_high_surrogate(cp: i32) -> bool {
    return cp >= 0xD800 && cp <= 0xDBFF;
}

fn is_low_surrogate(cp: i32) -> bool {
    return cp >= 0xDC00 && cp <= 0xDFFF;
}

fn surrogate_to_codepoint(high: i32, low: i32) -> i32 {
    return (high - 0xD800) * 0x400 + (low - 0xDC00) + 0x10000;
}


test "hex-digit-check" {
    assert is_hex_digit('0' as u8);
    assert is_hex_digit('9' as u8);
    assert is_hex_digit('A' as u8);
    assert is_hex_digit('F' as u8);
    assert is_hex_digit('a' as u8);
    assert is_hex_digit('f' as u8);
    assert !is_hex_digit('G' as u8);
    assert !is_hex_digit('g' as u8);
    assert !is_hex_digit('/' as u8);
}

test "hex-to-value" {
    assert hex_to_i32('0' as u8) == 0;
    assert hex_to_i32('9' as u8) == 9;
    assert hex_to_i32('A' as u8) == 10;
    assert hex_to_i32('F' as u8) == 15;
    assert hex_to_i32('a' as u8) == 10;
    assert hex_to_i32('f' as u8) == 15;
}

test "surrogate-detection" {
    assert is_high_surrogate(0xD800);
    assert is_high_surrogate(0xDBFF);
    assert !is_high_surrogate(0xDC00);
    assert is_low_surrogate(0xDC00);
    assert is_low_surrogate(0xDFFF);
    assert !is_low_surrogate(0xD800);
}

test "surrogate-pair-to-codepoint" {
    let high = 0xD83D;
    let low = 0xDE00;
    let cp = surrogate_to_codepoint(high, low);
    assert cp == 0x1F600;
}


struct Parser {
    bytes: Array<u8>,
    pos: i32,
}

impl Parser {
    fn new(input: String) -> Parser {
        let mut bytes = input.bytes().collect();
        return Parser { bytes, pos: 0 };
    }

    fn from_bytes(bytes: Array<u8>) -> Parser {
        return Parser { bytes, pos: 0 };
    }

    fn peek(&self) -> Option<u8> {
        return self.bytes.get(self.pos);
    }

    fn advance(&mut self) {
        self.pos += 1;
    }

    fn expect_byte(&mut self, expected: u8) -> bool {
        if let Some(b) = self.peek() {
            if b == expected {
                self.advance();
                return true;
            }
        }
        return false;
    }

    fn skip_whitespace(&mut self) {
        while let Some(b) = self.peek() {
            if b == ' ' as u8 || b == '\t' as u8 || b == '\n' as u8 || b == '\r' as u8 {
                self.advance();
            } else {
                break;
            }
        }
    }

    fn is_eof(&self) -> bool {
        return self.pos >= self.bytes.len();
    }
}


test "parser-from-bytes" {
    let bytes: Array<u8> = ['{' as u8, '}' as u8];
    let mut p = Parser::from_bytes(bytes);
    assert p.peek() matches { Some(b) && b == '{' as u8 };
    p.advance();
    assert p.peek() matches { Some(b) && b == '}' as u8 };
}

test "parser-peek-and-advance" {
    let mut p = Parser::new("abc");
    assert p.peek() matches { Some(b) && b == 'a' as u8 };
    p.advance();
    assert p.peek() matches { Some(b) && b == 'b' as u8 };
    p.advance();
    assert p.peek() matches { Some(b) && b == 'c' as u8 };
    p.advance();
    assert p.peek() matches { None };
}

test "parser-skip-whitespace" {
    let mut p = Parser::new("  \t\nabc");
    p.skip_whitespace();
    assert p.peek() matches { Some(b) && b == 'a' as u8 };
}

test "parser-is-eof" {
    let mut p = Parser::new("a");
    assert !p.is_eof();
    p.advance();
    assert p.is_eof();
}


impl Parser {
    fn match_literal(&mut self, lit: String) -> bool {
        let start = self.pos;
        let lit_bytes = lit.bytes().collect();
        for let mut i = 0; i < lit_bytes.len(); i += 1 {
            if self.is_eof() || self.bytes[self.pos] != lit_bytes[i] {
                self.pos = start;
                return false;
            }
            self.advance();
        }
        return true;
    }

    // Parse \uXXXX and return the code point, or -1 on failure
    fn parse_unicode_escape(&mut self) -> i32 {
        let mut value = 0;
        for let mut i = 0; i < 4; i += 1 {
            if let Some(b) = self.peek() {
                if !is_hex_digit(b) {
                    return -1;
                }
                value = value * 16 + hex_to_i32(b);
                self.advance();
            } else {
                return -1;
            }
        }
        return value;
    }

    // Decode a UTF-8 byte sequence at the current position.
    // Returns the Unicode codepoint as i32, or -1 on invalid UTF-8.
    // Advances pos past the decoded bytes.
    fn decode_utf8(&mut self) -> i32 {
        let b0 = self.bytes[self.pos] as i32;

        // ASCII
        if b0 < 0x80 {
            self.pos += 1;
            return b0;
        }

        // Invalid: continuation byte without lead
        if b0 < 0xC0 {
            return -1;
        }

        // 2-byte: 110xxxxx 10xxxxxx
        if b0 < 0xE0 {
            if self.pos + 1 >= self.bytes.len() {
                return -1;
            }
            let b1 = self.bytes[self.pos + 1] as i32;
            if b1 & 0xC0 != 0x80 {
                return -1;
            }
            let cp = (b0 & 0x1F) << 6 | b1 & 0x3F;
            if cp < 0x80 {
                return -1;
            }
            self.pos += 2;
            return cp;
        }

        // 3-byte: 1110xxxx 10xxxxxx 10xxxxxx
        if b0 < 0xF0 {
            if self.pos + 2 >= self.bytes.len() {
                return -1;
            }
            let b1 = self.bytes[self.pos + 1] as i32;
            let b2 = self.bytes[self.pos + 2] as i32;
            if b1 & 0xC0 != 0x80 {
                return -1;
            }
            if b2 & 0xC0 != 0x80 {
                return -1;
            }
            let cp = (b0 & 0x0F) << 12 | (b1 & 0x3F) << 6 | b2 & 0x3F;
            if cp < 0x800 {
                return -1;
            }
            if cp >= 0xD800 && cp <= 0xDFFF {
                return -1;
            }
            self.pos += 3;
            return cp;
        }

        // 4-byte: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
        if b0 < 0xF8 {
            if self.pos + 3 >= self.bytes.len() {
                return -1;
            }
            let b1 = self.bytes[self.pos + 1] as i32;
            let b2 = self.bytes[self.pos + 2] as i32;
            let b3 = self.bytes[self.pos + 3] as i32;
            if b1 & 0xC0 != 0x80 {
                return -1;
            }
            if b2 & 0xC0 != 0x80 {
                return -1;
            }
            if b3 & 0xC0 != 0x80 {
                return -1;
            }
            let cp = (b0 & 0x07) << 18 | (b1 & 0x3F) << 12 | (b2 & 0x3F) << 6 | b3 & 0x3F;
            if cp < 0x10000 || cp > 0x10FFFF {
                return -1;
            }
            self.pos += 4;
            return cp;
        }

        return -1;
    }
}

test "parse-unicode-escape" {
    let mut p = Parser::new("0041");
    let cp = p.parse_unicode_escape();
    assert cp == 65;
}

test "parse-unicode-escape-japanese" {
    let mut p = Parser::new("3042");
    let cp = p.parse_unicode_escape();
    assert cp == 12354;
}


impl Parser {
    fn parse_null(&mut self) -> Option<JsonValue> {
        self.skip_whitespace();
        if self.match_literal("null") {
            return Option::<JsonValue>::Some(JsonValue::Null);
        }
        return null;
    }
}

test "parse-null-valid" {
    let mut p = Parser::new("null");
    if let Some(v) = p.parse_null() {
        assert v matches { Null };
    } else {
        assert false;
    }
}

test "parse-null-with-whitespace" {
    let mut p = Parser::new("  null");
    if let Some(v) = p.parse_null() {
        assert v matches { Null };
    } else {
        assert false;
    }
}

test "parse-null-invalid" {
    let mut p = Parser::new("nul");
    assert p.parse_null() matches { None };
}


impl Parser {
    fn parse_bool(&mut self) -> Option<JsonValue> {
        self.skip_whitespace();
        if self.match_literal("true") {
            return Option::<JsonValue>::Some(JsonValue::Bool(true));
        }
        if self.match_literal("false") {
            return Option::<JsonValue>::Some(JsonValue::Bool(false));
        }
        return null;
    }
}

test "parse-bool-true" {
    let mut p = Parser::new("true");
    if let Some(v) = p.parse_bool() {
        if let Bool(b) = v {
            assert b;
        } else {
            assert false;
        }
    } else {
        assert false;
    }
}

test "parse-bool-false" {
    let mut p = Parser::new("false");
    if let Some(v) = p.parse_bool() {
        if let Bool(b) = v {
            assert !b;
        } else {
            assert false;
        }
    } else {
        assert false;
    }
}

test "parse-bool-invalid" {
    let mut p = Parser::new("tru");
    assert p.parse_bool() matches { None };
}


impl Parser {
    fn parse_number(&mut self) -> Option<JsonValue> {
        self.skip_whitespace();
        let start = self.pos;

        // Handle negative
        if let Some(b) = self.peek() {
            if b == '-' as u8 {
                self.advance();
            }
        }

        // Must have at least one digit
        if let Some(b) = self.peek() {
            if !is_digit(b) {
                self.pos = start;
                return null;
            }
        } else {
            self.pos = start;
            return null;
        }

        // Integer part
        while let Some(b) = self.peek() {
            if !is_digit(b) {
                break;
            }
            self.advance();
        }

        // Fractional part
        if self.peek() matches { Some(b) && b == '.' as u8 } {
            self.advance();
            while let Some(b) = self.peek() {
                if !is_digit(b) {
                    break;
                }
                self.advance();
            }
        }

        // Exponent
        if let Some(e) = self.peek() {
            if e == 'e' as u8 || e == 'E' as u8 {
                self.advance();
                if let Some(sign) = self.peek() {
                    if sign == '-' as u8 || sign == '+' as u8 {
                        self.advance();
                    }
                }
                while let Some(b) = self.peek() {
                    if !is_digit(b) {
                        break;
                    }
                    self.advance();
                }
            }
        }

        // Extract byte range and convert to string for f64::from_str
        let end = self.pos;
        let mut num_str = String::with_capacity(end - start);
        for let mut i = start; i < end; i += 1 {
            num_str.push(char::from_u32_unchecked(self.bytes[i] as u32));
        }

        if let Ok(n) = f64::from_str(num_str) {
            return Option::<JsonValue>::Some(JsonValue::Number(n));
        }
        self.pos = start;
        return null;
    }
}

test "parse-number-integer" {
    let mut p = Parser::new("42");
    if let Some(v) = p.parse_number() {
        if let Number(n) = v {
            assert n == 42.0;
        } else {
            assert false;
        }
    } else {
        assert false;
    }
}

