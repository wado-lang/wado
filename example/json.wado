impl Parser {
    fn parse_array(&mut self) -> Option<JsonValue> {
        self.skip_whitespace();

        if !self.expect_byte('[' as u8) {
            return null;
        }
        self.skip_whitespace();

        if self.expect_byte(']' as u8) {
            let empty: Array<JsonValue> = [];
            return Option::<JsonValue>::Some(JsonValue::Arr(empty));
        }

        let mut items: Array<JsonValue> = [];
        loop {
            if let Some(v) = self.parse_value() {
                items.push(v);
            } else {
                return null;
            }

            self.skip_whitespace();
            if self.expect_byte(']' as u8) {
                return Option::<JsonValue>::Some(JsonValue::Arr(items));
            }
            if !self.expect_byte(',' as u8) {
                return null;
            }
            self.skip_whitespace();
        }
    }
}

test "parse-array-empty" {
    let mut p = Parser::new("[]");
    if let Some(v) = p.parse_array() {
        if let Arr(items) = v {
            assert items.len() == 0;
        } else {
            assert false;
        }
    } else {
        assert false;
    }
}

test "parse-array-single" {
    let mut p = Parser::new("[42]");
    if let Some(v) = p.parse_array() {
        if let Arr(items) = v {
            assert items.len() == 1;
        } else {
            assert false;
        }
    } else {
        assert false;
    }
}

test "parse-array-multiple" {
    let mut p = Parser::new("[1, 2, 3]");
    if let Some(v) = p.parse_array() {
        if let Arr(items) = v {
            assert items.len() == 3;
        } else {
            assert false;
        }
    } else {
        assert false;
    }
}

