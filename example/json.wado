    // Japanese keys: {"名前": "太郎", "年齢": 25}
    let mut p = Parser::new("{\"名前\": \"太郎\", \"年齢\": 25}");
    let r = p.parse_value();
    if let Obj(count) = r {
        assert count == 2;
    } else {
        assert false;
