    // Multiple languages: {"english": "hello", "日本語": "こんにちは", "한국어": "안녕"}
    let mut p = Parser::new("{\"english\": \"hello\", \"日本語\": \"こんにちは\", \"한국어\": \"안녕\"}");
    let r = p.parse_value();
    if let Obj(count) = r {
        assert count == 3;
    } else {
