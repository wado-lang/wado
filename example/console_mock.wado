//! Mock and capture the real `core:cli` stdin / stdout / stderr with effect
//! handlers. Application code uses ordinary `println` / `eprintln` / `print`
//! and reads stdin through `wasi:cli`; one `MockStdio` handles every stdio
//! resource those helpers touch, installed together via `with &mut mock do`.

use { println, eprintln, print, Stdout, Stderr } from "core:cli";
use { Stdin, ErrorCode } from "wasi:cli";

// `write_via_stream` records which of the two streams the next write belongs to,
// since one handler answers for both. It keeps each future's writable end for
// `end_writes`: a handler runs only until its `resume`, and a write inside it
// would block on a reader nobody runs.
affine struct MockStdio {
    to_stderr: bool = false,
    out: List<u8> = [],
    err: List<u8> = [],
    input: List<u8> = [],
    input_pos: i32 = 0,
    ends: List<FutureWritable<Result<(), ErrorCode>>> = [],
}

impl MockStdio {
    fn stdout_text(&self) -> String {
        return String::from_utf8_lossy(self.out as ByteList);
    }

    fn stderr_text(&self) -> String {
        return String::from_utf8_lossy(self.err as ByteList);
    }

    /// Ends each future a handler handed out, since an end dropped unwritten traps.
    fn end_writes(&mut self) {
        while let Some(end) = self.ends.pop() {
            end.write(Result::Ok(()));
        }
    }

    fn pending(&mut self) -> Future<Result<(), ErrorCode>> {
        let [future, end] = Future::<Result<(), ErrorCode>>::new();
        self.ends.push(end);
        return future;
    }
}

impl Stdout for MockStdio {
    fn write_via_stream(&mut self, data: Stream<u8>) -> Future<Result<(), ErrorCode>> {
        self.to_stderr = false;
        resume self.pending();
    }
}

impl Stderr for MockStdio {
    fn write_via_stream(&mut self, data: Stream<u8>) -> Future<Result<(), ErrorCode>> {
        self.to_stderr = true;
        resume self.pending();
    }
}

impl Stdin for MockStdio {
    fn read_via_stream(&mut self) -> [Stream<u8>, Future<Result<(), ErrorCode>>] {
        let [rx, tx] = Stream::<u8>::new();
        tx.drop();
        resume [rx, self.pending()];
    }
}

// Reads replay `input`; the stream itself is a real one.
impl Stream<u8> for MockStdio {
    fn begin_read(&mut self, this: &Stream<u8>, max: i32) -> StartedRead<u8> {
        let end = i32::min(self.input_pos + max, self.input.len());
        let mut chunk: List<u8> = [];
        chunk.extend_from_slice(self.input.slice(self.input_pos, end));
        let at_end = self.input_pos == end;
        self.input_pos = end;
        resume StartedRead::settled(StreamChunk {
            items: chunk,
            result: if at_end { CopyResult::Dropped } else { CopyResult::Completed },
        });
    }

    ..forward
}

impl StreamWritable<u8> for MockStdio {
    fn begin_write(&mut self, this: &StreamWritable<u8>, data: List<u8>) -> StartedWrite<u8> {
        if self.to_stderr {
            self.err.extend(&data);
        } else {
            self.out.extend(&data);
        }
        resume StartedWrite::settled(StreamWrite { rest: [], result: CopyResult::Completed });
    }

    fn write_raw_all(&mut self, this: &StreamWritable<u8>, data: Slice<u8>) -> CopyResult {
        if self.to_stderr {
            self.err.extend_from_slice(data);
        } else {
            self.out.extend_from_slice(data);
        }
        resume CopyResult::Completed;
    }

    ..forward
}

fn greet(name: String) with (Stdout, Stderr) {
    if name.is_empty() {
        eprintln("warning: empty name");
        return;
    }
    println(`Hello, ${name}!`);
}

fn read_all_stdin() -> String with Stdin {
    let [rx, done] = Stdin::read_via_stream();
    let buf = rx.read_to_end_bytes();
    rx.drop();
    done.drop();
    return String::from_utf8_lossy(buf);
}

export fn run() with (Stdout, Stderr) {
    let mut mock = MockStdio {
        input: b"Ada\nTuring\n",
    };
    with &mut mock do {
        print("prompt> ");
        greet("Ada");
        greet("");
        let echoed = read_all_stdin();
        eprintln(`read ${echoed.len()} bytes of stdin`);
    };
    mock.end_writes();

    println("=== captured stdout ===");
    print(mock.stdout_text());
    println("=== captured stderr ===");
    print(mock.stderr_text());
}

test "captures stdout written through println/print" {
    let mut mock = MockStdio {};
    with &mut mock do {
        print("a");
        println("b");
        greet("Ada");
    };
    mock.end_writes();
    assert mock.stdout_text() == "ab\nHello, Ada!\n";
    assert mock.stderr_text() == "";
}

test "captures stderr independently from stdout" {
    let mut mock = MockStdio {};
    with &mut mock do {
        greet("Ada");
        greet("");
    };
    mock.end_writes();
    assert mock.stdout_text() == "Hello, Ada!\n";
    assert mock.stderr_text() == "warning: empty name\n";
}

test "scripted stdin is replayed to the guest reader" {
    let mut mock = MockStdio {
        input: b"hello\nstdin",
    };
    mock.end_writes();
    let got = with &mut mock do {
        read_all_stdin();
    };
    mock.end_writes();
    assert got == "hello\nstdin";
}

test "empty stdin reads as end-of-stream immediately" {
    let mut mock = MockStdio {};
    let got = with &mut mock do {
        read_all_stdin();
    };
    mock.end_writes();
    assert got == "";
}

test "unicode round-trips through the byte buffers" {
    let mut mock = MockStdio {};
    with &mut mock do {
        println("こんにちは 🌍");
    };
    mock.end_writes();
    assert mock.stdout_text() == "こんにちは 🌍\n";
}
