//! Mock and capture the real `core:cli` stdin / stdout / stderr.
//!
//! Unlike a hand-rolled `Console` abstraction, application code here uses the
//! ordinary `println` / `eprintln` / `print` and reads stdin through the real
//! `wasi:cli` interfaces — no seam is added for testing. Capture happens one
//! layer below, at the Component Model boundary those helpers desugar to.
//!
//! `println(msg)` expands to roughly:
//!
//!     let [rx, tx] = Stream::<u8>::new();          // stream pair
//!     let fut = Stdout::write_via_stream(rx);       // hand the reader to WASI
//!     tx.write_raw(msg_bytes, len); tx.drop();      // push the bytes
//!     fut.drop();                                    // signal completion
//!
//! So a full mock must handle every resource in that dance — `Stdout`,
//! `Stderr`, `Stdin`, the `Stream<u8>` / `StreamWritable<u8>` pair, and the
//! completion `Future` — routing all of it to in-memory buffers. The bundled
//! `with &mut mock do { ... }` form installs the whole set at once, since one
//! `MockStdio` value implements all of them.

use { println, eprintln, print, Stdout, Stderr } from "core:cli";
use { Stdin, ErrorCode } from "wasi:cli";

// In-memory stand-in for the three standard streams. `to_stderr` records which
// sink the currently-open write stream targets, set when the guest calls
// `Stdout`/`Stderr::write_via_stream` and read back when bytes arrive on the
// writable end — safe because each `println` runs that open→write→drop dance to
// completion before the next one starts.
struct MockStdio {
    to_stderr: bool = false,
    out: List<u8> = [],
    err: List<u8> = [],
    input: List<u8> = [],
    input_pos: i32 = 0,
}

impl MockStdio {
    fn stdout_text(&self) -> String {
        return decode(self.out);
    }

    fn stderr_text(&self) -> String {
        return decode(self.err);
    }
}

// The captured bytes always originate from valid UTF-8 (Wado string writes and
// string-literal stdin scripts), so skip the checked `from_utf8` here.
fn decode(bytes: List<u8>) -> String {
    return String::from_utf8_unchecked(bytes);
}

// --- WASI stdio effects: pick the sink, hand back a fake completion future ---

impl Stdout for MockStdio {
    fn write_via_stream(&mut self, data: Stream<u8>) -> Future<Result<(), ErrorCode>> {
        let _ = data;
        self.to_stderr = false;
        let done: Future<Result<(), ErrorCode>> = 0 as Future<Result<(), ErrorCode>>;
        resume done;
    }
}

impl Stderr for MockStdio {
    fn write_via_stream(&mut self, data: Stream<u8>) -> Future<Result<(), ErrorCode>> {
        let _ = data;
        self.to_stderr = true;
        let done: Future<Result<(), ErrorCode>> = 0 as Future<Result<(), ErrorCode>>;
        resume done;
    }
}

impl Stdin for MockStdio {
    fn read_via_stream(&mut self) -> [Stream<u8>, Future<Result<(), ErrorCode>>] {
        let rx: Stream<u8> = 0 as Stream<u8>;
        let done: Future<Result<(), ErrorCode>> = 0 as Future<Result<(), ErrorCode>>;
        resume [rx, done];
    }
}

// --- The stream pair: writes append to a sink, reads replay scripted stdin ---

impl Stream<u8> for MockStdio {
    fn new(&mut self) -> [Stream<u8>, StreamWritable<u8>] {
        let rx: Stream<u8> = 0 as Stream<u8>;
        let tx: StreamWritable<u8> = 0 as StreamWritable<u8>;
        resume [rx, tx];
    }

    fn read(&mut self, this: &Stream<u8>, max: i32) -> List<u8> {
        let _ = this;
        let mut chunk: List<u8> = [];
        let mut n = 0;
        while self.input_pos < self.input.len() && n < max {
            chunk.push(self.input[self.input_pos]);
            self.input_pos += 1;
            n += 1;
        }
        resume chunk;
    }

    fn drop(&mut self, this: &Stream<u8>) {
        let _ = this;
        resume ();
    }

    ..trap
}

impl StreamWritable<u8> for MockStdio {
    fn write(&mut self, this: &StreamWritable<u8>, data: List<u8>) {
        let _ = this;
        for let b of data {
            if self.to_stderr {
                self.err.push(b);
            } else {
                self.out.push(b);
            }
        }
        resume ();
    }

    fn write_raw(&mut self, this: &StreamWritable<u8>, data: &Array<u8>, len: i32) {
        let _ = this;
        for let mut i = 0; i < len; i += 1 {
            let b = data.get(i);
            if self.to_stderr {
                self.err.push(b);
            } else {
                self.out.push(b);
            }
        }
        resume ();
    }

    fn drop(&mut self, this: &StreamWritable<u8>) {
        let _ = this;
        resume ();
    }

    ..trap
}

impl Future<Result<(), ErrorCode>> for MockStdio {
    fn drop(&mut self, this: &Future<Result<(), ErrorCode>>) {
        let _ = this;
        resume ();
    }

    ..trap
}

// Ordinary application code — no test seam, just the real stdio helpers.
fn greet(name: String) with Stdout, Stderr {
    if name.is_empty() {
        eprintln("warning: empty name");
        return;
    }
    println(`Hello, {name}!`);
}

fn read_all_stdin() -> String with Stdin {
    let [rx, _done] = Stdin::read_via_stream();
    let mut buf: List<u8> = [];
    loop {
        let chunk = rx.read(1024);
        if chunk.is_empty() {
            break;
        }
        for let b of chunk {
            buf.push(b);
        }
    }
    rx.drop();
    return decode(buf);
}

export fn run() with Stdout, Stderr {
    let mut mock = MockStdio {
        input: "Ada\nTuring\n".as_bytes().to_array().into_iter().collect(),
    };
    with &mut mock do {
        print("prompt> ");
        greet("Ada");
        greet("");
        let echoed = read_all_stdin();
        eprintln(`read {echoed.len()} bytes of stdin`);
    };

    // Reveal the captured buffers on the real terminal.
    println("=== captured stdout ===");
    print(mock.stdout_text());
    println("=== captured stderr ===");
    print(mock.stderr_text());
}

test "captures stdout written through println/print" {
    let mut mock = MockStdio {};
    with &mut mock do {
        print("a");
        println("b");
        greet("Ada");
    };
    assert mock.stdout_text() == "ab\nHello, Ada!\n";
    assert mock.stderr_text() == "";
}

test "captures stderr independently from stdout" {
    let mut mock = MockStdio {};
    with &mut mock do {
        greet("Ada");
        greet("");
    };
    assert mock.stdout_text() == "Hello, Ada!\n";
    assert mock.stderr_text() == "warning: empty name\n";
}

test "scripted stdin is replayed to the guest reader" {
    let mut mock = MockStdio {
        input: "hello\nstdin".as_bytes().to_array().into_iter().collect(),
    };
    let got = with &mut mock do {
        read_all_stdin();
    };
    assert got == "hello\nstdin";
}

test "empty stdin reads as end-of-stream immediately" {
    let mut mock = MockStdio {};
    let got = with &mut mock do {
        read_all_stdin();
    };
    assert got == "";
}

test "unicode round-trips through the byte buffers" {
    let mut mock = MockStdio {};
    with &mut mock do {
        println("こんにちは 🌍");
    };
    assert mock.stdout_text() == "こんにちは 🌍\n";
}
