// Print the current time in ISO 8601 format (UTC and local time).
//
// Usage:
//   wado run example/iso8601.wado
//
// Output example (in Asia/Tokyo):
//   IANA:  Asia/Tokyo
//   UTC:   2026-05-07T12:34:56.789Z
//   Local: 2026-05-07T21:34:56.789+09:00
//
// `wasi:clocks/timezone` is not implemented by upstream wasmtime, so
// `wado run` / `wado serve` provide their own host (see
// `wado_cli::timezone_host`) backed by `localtime_r` and the
// `iana-time-zone` crate. Hosts that do not expose a real timezone may
// return `None` from `Timezone::utc_offset` — in that case we fall back to
// printing UTC for the local line.
//
// All the calendar math (epoch seconds → civil date, offset rendering) lives
// in `core:temporal`; here we just copy the `wasi:clocks` instant into a
// `core:temporal` `Instant` and let `ZonedDateTime` format it. The `{x:#}`
// format prints milliseconds (`DisplayAlt`).

use { println, Stdout } from "core:cli";
use { SystemClock, Instant as ClockInstant, Timezone } from "wasi:clocks";
use { Instant, ZonedDateTime } from "core:temporal";

export fn run() with Stdout, SystemClock, Timezone {
    let now: ClockInstant = SystemClock::now();

    // `core:temporal` bridges the two `Instant` types with `From`, so a
    // `wasi:clocks` reading converts directly.
    let instant = Instant::from(now);

    if let Some(name) = Timezone::iana_id() {
        println(`IANA:  {name}`);
    }

    let utc = ZonedDateTime { instant, time_zone: "UTC" };
    println(`UTC:   {utc:#}`);

    let zone = match Timezone::utc_offset(now) {
        Some(ns) => offset_zone(ns / 1_000_000_000),
        None => "UTC",
    };
    let local = ZonedDateTime { instant, time_zone: zone };
    println(`Local: {local:#}`);
}

// Format a UTC offset in whole seconds as a fixed-offset zone string
// (`±HH:MM`) that `ZonedDateTime` can interpret. A zero offset renders as
// `+00:00`, which `core:temporal` normalizes to the `Z` suffix.
fn offset_zone(offset_secs: i64) -> String {
    let sign = if offset_secs < 0 { "-" } else { "+" };
    let abs = if offset_secs < 0 { -offset_secs } else { offset_secs };
    let h = abs / 3600;
    let m = abs % 3600 / 60;
    return `{sign}{h:02}:{m:02}`;
}
