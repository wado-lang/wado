#!/usr/bin/env wado run
// Everyday closures: the iterator combinators take one closure per element.
// This is the common case where a closure replaces a hand-written loop.
//
//   wado run example/closure_iterators.wado

use { println, Stdout } from "core:cli";

struct Player {
    name: String,
    score: i32,
}

export fn run() with Stdout {
    let players: List<Player> = [
        Player { name: "Ada", score: 88 },
        Player { name: "Bjarne", score: 61 },
        Player { name: "Carmack", score: 95 },
        Player { name: "Dijkstra", score: 73 },
    ];

    // filter -> map -> collect: scores of players who passed (>= 70).
    let passing: List<i32> = players.iter().copied().filter(|p: Player| p.score >= 70).map(|p: Player| p.score).collect(
    );

    // fold the survivors into a sum, then average.
    let total = passing.iter().copied().fold(0, |acc: i32, s: i32| acc + s);
    println(`{passing.len()} passed, average {total / passing.len()}`);

    // any / all take a predicate closure, here written inline in the template.
    println(`all passed? {players.iter().copied().all(|p: Player| p.score >= 70)}`);
    println(`any perfect? {players.iter().copied().any(|p: Player| p.score == 100)}`);

    // sort_by takes a comparator closure: rank by score, descending.
    let mut ranked = players;
    ranked.sort_by(|a: &Player, b: &Player| b.score.cmp(&a.score));

    let mut rank = 1;
    for let p of ranked.iter().copied() {
        println(`{rank}. {p.name} ({p.score})`);
        rank += 1;
    }
}

test "filter/map/fold pipeline" {
    let scores: List<i32> = [88, 61, 95, 73];
    let passing: List<i32> = scores.into_iter().filter(|s: i32| s >= 70).collect();
    let total = passing.iter().copied().fold(0, |acc: i32, s: i32| acc + s);
    assert passing.len() == 3;
    assert total == 88 + 95 + 73;
}

test "sort_by orders descending" {
    let mut xs: List<i32> = [3, 1, 2];
    xs.sort_by(|a: &i32, b: &i32| b.cmp(a));
    assert xs == [3, 2, 1] as List<i32>;
}
