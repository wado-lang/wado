// Demonstration of Effect function import feature
// Shows how to use imported effect functions without Effect. prefix

use core::cli::Stdout::{write_via_stream};
use core::cli::Stderr::{write_via_stream as stderr_write};
use core::cli::Environment::{get_arguments};

// Helper function using imported effect functions
pub fn my_println(message: string) with Stdout {
    let stream = string_to_stream(`{message}\n`);
    // Can call write_via_stream directly without Stdout. prefix!
    let _ = write_via_stream(stream);
}

pub fn my_eprintln(message: string) with Stderr {
    let stream = string_to_stream(`{message}\n`);
    // Using the renamed import
    let _ = stderr_write(stream);
}

fn main() with Stdout, Stderr, Environment {
    my_println("Hello from imported Stdout!");
    my_eprintln("This is stderr");

    // Can also use imported functions directly
    let args = get_arguments();
}

// Placeholder for string_to_stream (would be a compiler intrinsic)
fn string_to_stream(s: string) -> Stream<u8> {
    // Compiler intrinsic
}
