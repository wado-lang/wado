// Throughput of the `core:prng` generators, in u64 per second, against the
// candidates that did not ship.
//
// The engines under test are the library's: `Xoshiro256pp` through `Rng`, and
// `XoshiroSimd` and `Shishua` through `VectorRng`. What is written here is the
// consumer side — a per-draw cursor over a batch, a buffer fill — which is what
// the two-trait split in `docs/wep-2026-09-18-core-prng.md` is a decision about.
//
// - RomuTrio — https://www.romu-random.org/, Mark A. Overton's paper. A scalar
//   candidate that did not ship.
// - xoshiro256++ — https://prng.di.unimi.it/, Blackman & Vigna.
// - SHISHUA — https://github.com/espadrine/shishua.
//
// The last section measures the other question a consumer can ask: not "the
// next value" but "the value at this key", which is what terrain regenerated on
// a revisit and an entity keyed by its id need. `Squares64` shipped; Threefry
// and Philox are kept here as the comparison it was chosen against.

use { Stdout } from "core:cli";
use { Benchmark } from "core:benchmark";
use { i64x2, u32x4, u64x2 } from "core:simd";
use { Seed, Seedable, Rng, VectorRng, Xoshiro256pp, XoshiroSimd, Shishua, Squares64 } from "core:prng";
use { MonotonicClock } from "wasi:clocks";

global SPLITMIX_GAMMA: u64 = 0x9E3779B97F4A7C15;

// A seed generator in its own right, and what RomuTrio's state starts from, so
// the comparison is of the generator and not of its initialization.
struct SplitMix64 {
    state: u64,
}

impl SplitMix64 {
    fn new(seed: u64) -> SplitMix64 {
        return SplitMix64 { state: seed };
    }

    fn next(&mut self) -> u64 {
        self.state = self.state + SPLITMIX_GAMMA;
        return mix64(self.state);
    }
}

fn rotl(x: u64, n: u64) -> u64 {
    return x << n | x >> 64 - n;
}

// RomuTrio: three words, one multiply and two rotates per output. Faster than
// xoshiro256++ per word and with no proven stream separation, which is why the
// library ships the one and not the other.
struct RomuTrio {
    x: u64,
    y: u64,
    z: u64,
}

impl RomuTrio {
    fn new(seed: u64) -> RomuTrio {
        let mut seeder = SplitMix64::new(seed);
        return RomuTrio {
            x: seeder.next(),
            y: seeder.next(),
            z: seeder.next(),
        };
    }
}

impl Rng for RomuTrio {
    fn next_u64(&mut self) -> u64 {
        let xp = self.x;
        let yp = self.y;
        let zp = self.z;
        self.x = zp * 0xD3833E804F4C574B;
        self.y = rotl(yp - xp, 12);
        self.z = rotl(zp - yp, 44);
        return xp;
    }
}

global BATCH_WORDS: i32 = 16;

// The batch is sixteen words wide, so a consumer that wants one pays a cursor
// and a branch for it. That cost is the whole reason `Rng` and `VectorRng` are
// separate traits, and this is where it is measured.
struct BatchCursor<R: VectorRng> {
    engine: R,
    words: List<u64> = List::<u64>::filled(BATCH_WORDS, 0),
    pos: i32 = BATCH_WORDS,
}

impl<R: VectorRng> Rng for BatchCursor<R> {
    fn next_u64(&mut self) -> u64 {
        if self.pos == BATCH_WORDS {
            spill_batch(&mut self.words, 0, self.engine.next_batch());
            self.pos = 0;
        }
        let value = self.words[self.pos];
        self.pos += 1;
        return value;
    }
}

fn spill_lanes(out: &mut List<u64>, at: i32, v: u64x2) {
    out[at] = v.extract_lane(0) as u64;
    out[at + 1] = v.extract_lane(1) as u64;
}

fn spill_batch(out: &mut List<u64>, at: i32, batch: [u64x2, u64x2, u64x2, u64x2, u64x2, u64x2, u64x2, u64x2]) {
    let [a, b, c, d, e, f, g, h] = batch;
    spill_lanes(out, at, a);
    spill_lanes(out, at + 2, b);
    spill_lanes(out, at + 4, c);
    spill_lanes(out, at + 6, d);
    spill_lanes(out, at + 8, e);
    spill_lanes(out, at + 10, f);
    spill_lanes(out, at + 12, g);
    spill_lanes(out, at + 14, h);
}

// A generator that repeats a value, or returns zero throughout, would win this
// benchmark. Fold the whole run and require the fold to move.
fn drain_scalar<R: Rng>(rng: &mut R, n: i32) -> u64 {
    let mut acc: u64 = 0;
    for let mut i = 0; i < n; i += 1 {
        acc = acc ^ rng.next_u64();
    }
    return acc;
}

// What the vector trait is for: a consumer that takes a batch at a time never
// lands a word in memory, and extracts two lanes per run rather than two per
// word. The gap between this and `drain_scalar` over a `BatchCursor` is what
// the per-draw API costs.
fn drain_by_batch<R: VectorRng>(rng: &mut R, n: i32) -> u64 {
    let mut acc: u64x2 = [0, 0];
    for let mut i = 0; i < n; i += BATCH_WORDS {
        let [a, b, c, d, e, f, g, h] = rng.next_batch();
        acc = acc ^ a ^ b ^ c ^ d;
        acc = acc ^ e ^ f ^ g ^ h;
    }
    return acc.extract_lane(0) as u64 ^ acc.extract_lane(1) as u64;
}

// The middle road: the caller still gets plain u64, but pays one array write
// per word rather than a write, a read and a cursor. Against `drain_scalar`
// over a scalar engine, this separates what the generator costs from what
// landing a u64 in memory costs.
fn drain_scalar_fill<R: Rng>(rng: &mut R, buffer: &mut List<u64>, n: i32) -> u64 {
    assert !buffer.is_empty(), "an empty buffer would not advance the loop";
    let mut acc: u64 = 0;
    for let mut i = 0; i < n; i += buffer.len() {
        for let mut k = 0; k < buffer.len(); k += 1 {
            buffer[k] = rng.next_u64();
        }
        for let mut k = 0; k < buffer.len(); k += 1 {
            acc = acc ^ buffer[k];
        }
    }
    return acc;
}

fn drain_batch_fill<R: VectorRng>(rng: &mut R, buffer: &mut List<u64>, n: i32) -> u64 {
    assert !buffer.is_empty(), "an empty buffer would not advance the loop";
    assert buffer.len() % BATCH_WORDS == 0, "the buffer must hold whole batches";
    let mut acc: u64 = 0;
    for let mut i = 0; i < n; i += buffer.len() {
        for let mut at = 0; at < buffer.len(); at += BATCH_WORDS {
            spill_batch(buffer, at, rng.next_batch());
        }
        for let mut k = 0; k < buffer.len(); k += 1 {
            acc = acc ^ buffer[k];
        }
    }
    return acc;
}

// A stream answers "the next value". A keyed function answers "the value at
// this key", so the draw order belongs to the consumer and there is no state to
// carry: a chunk regenerates identically on a revisit, and no two consumers
// have to agree on who draws first.
//
// Two ends of one trade. `mix64` is SplitMix64's finalizer cut loose from its
// state, which is what a noise library hashes a coordinate with. Philox4x32 is
// a counter-based PRF (Random123; JAX's default Threefry is its cousin), ten
// rounds for the statistical claims. The Philox and Threefry constants are the
// references' and nothing here checks a known-answer vector.
global MIX_C1: u64 = 0xBF58476D1CE4E5B9;

global MIX_C2: u64 = 0x94D049BB133111EB;

fn mix64(key: u64) -> u64 {
    let mut z = key;
    z = (z ^ z >> 30) * MIX_C1;
    z = (z ^ z >> 27) * MIX_C2;
    return z ^ z >> 31;
}

fn mix64x2(key: u64x2) -> u64x2 {
    let c1: u64x2 = [MIX_C1 as i64, MIX_C1 as i64];
    let c2: u64x2 = [MIX_C2 as i64, MIX_C2 as i64];
    let mut z = key;
    z = (z ^ z >> 30) * c1;
    z = (z ^ z >> 27) * c2;
    return z ^ z >> 31;
}

fn value_at(seed: u64, x: i32, y: i32) -> u64 {
    return mix64(seed ^ coord_key(x, y));
}

global PHILOX_M0: u64 = 0xD2511F53;

global PHILOX_M1: u64 = 0xCD9E8D57;

global PHILOX_W0: u32 = 0x9E3779B9;

global PHILOX_W1: u32 = 0xBB67AE85;

global PHILOX_ROUNDS: i32 = 10;

#[inline(always)]
fn philox4x32(key0: u32, key1: u32, counter: u32) -> [u32, u32, u32, u32] {
    let mut x0 = counter;
    let mut x1: u32 = 0;
    let mut x2: u32 = 0;
    let mut x3: u32 = 0;
    let mut k0 = key0;
    let mut k1 = key1;
    for let mut round = 0; round < PHILOX_ROUNDS; round += 1 {
        let p0 = PHILOX_M0 * x0 as u64;
        let p1 = PHILOX_M1 * x2 as u64;
        x0 = (p1 >> 32) as u32 ^ x1 ^ k0;
        x1 = p1 as u32;
        x2 = (p0 >> 32) as u32 ^ x3 ^ k1;
        x3 = p0 as u32;
        k0 = k0 + PHILOX_W0;
        k1 = k1 + PHILOX_W1;
    }
    return [x0, x1, x2, x3];
}

// Wasm has no vector rotate, so each one is a shift pair and an or.
fn vrotl(v: u64x2, n: u32) -> u64x2 {
    return v << n | v >> 64 - n;
}

global THREEFRY_PARITY: u64 = 0x1BD11BDAA9FC1A22;

// Thirteen rounds, unrolled so each rotation is an immediate. The rotation
// table is Threefish-256's for the 2x64 word size, and a key is injected after
// every fourth round.
#[inline(always)]
fn threefry2x64(key0: u64, key1: u64, ctr0: u64, ctr1: u64) -> [u64, u64] {
    let ks2 = key0 ^ key1 ^ THREEFRY_PARITY;
    let mut x0 = ctr0 + key0;
    let mut x1 = ctr1 + key1;

    x0 = x0 + x1;
    x1 = rotl(x1, 16) ^ x0;
    x0 = x0 + x1;
    x1 = rotl(x1, 42) ^ x0;
    x0 = x0 + x1;
    x1 = rotl(x1, 12) ^ x0;
    x0 = x0 + x1;
    x1 = rotl(x1, 31) ^ x0;
    x0 = x0 + key1;
    x1 = x1 + ks2 + 1;

    x0 = x0 + x1;
    x1 = rotl(x1, 16) ^ x0;
    x0 = x0 + x1;
    x1 = rotl(x1, 32) ^ x0;
    x0 = x0 + x1;
    x1 = rotl(x1, 24) ^ x0;
    x0 = x0 + x1;
    x1 = rotl(x1, 21) ^ x0;
    x0 = x0 + ks2;
    x1 = x1 + key0 + 2;

    x0 = x0 + x1;
    x1 = rotl(x1, 16) ^ x0;
    x0 = x0 + x1;
    x1 = rotl(x1, 42) ^ x0;
    x0 = x0 + x1;
    x1 = rotl(x1, 12) ^ x0;
    x0 = x0 + x1;
    x1 = rotl(x1, 31) ^ x0;
    x0 = x0 + key0;
    x1 = x1 + key1 + 3;

    x0 = x0 + x1;
    x1 = rotl(x1, 16) ^ x0;
    return [x0, x1];
}

// Two counters at once: every word of the scalar form becomes a lane, so the
// instruction count per call is the scalar one and the output is twice as wide.
#[inline(always)]
fn threefry2x64x2(key0: u64x2, key1: u64x2, ctr0: u64x2, ctr1: u64x2) -> [u64x2, u64x2] {
    let parity = u64x2::splat(THREEFRY_PARITY as i64);
    let one = u64x2::splat(1);
    let two = u64x2::splat(2);
    let three = u64x2::splat(3);
    let ks2 = key0 ^ key1 ^ parity;
    let mut x0 = ctr0 + key0;
    let mut x1 = ctr1 + key1;

    x0 = x0 + x1;
    x1 = vrotl(x1, 16) ^ x0;
    x0 = x0 + x1;
    x1 = vrotl(x1, 42) ^ x0;
    x0 = x0 + x1;
    x1 = vrotl(x1, 12) ^ x0;
    x0 = x0 + x1;
    x1 = vrotl(x1, 31) ^ x0;
    x0 = x0 + key1;
    x1 = x1 + ks2 + one;

    x0 = x0 + x1;
    x1 = vrotl(x1, 16) ^ x0;
    x0 = x0 + x1;
    x1 = vrotl(x1, 32) ^ x0;
    x0 = x0 + x1;
    x1 = vrotl(x1, 24) ^ x0;
    x0 = x0 + x1;
    x1 = vrotl(x1, 21) ^ x0;
    x0 = x0 + ks2;
    x1 = x1 + key0 + two;

    x0 = x0 + x1;
    x1 = vrotl(x1, 16) ^ x0;
    x0 = x0 + x1;
    x1 = vrotl(x1, 42) ^ x0;
    x0 = x0 + x1;
    x1 = vrotl(x1, 12) ^ x0;
    x0 = x0 + x1;
    x1 = vrotl(x1, 31) ^ x0;
    x0 = x0 + key0;
    x1 = x1 + key1 + three;

    x0 = x0 + x1;
    x1 = vrotl(x1, 16) ^ x0;
    return [x0, x1];
}

// The high half of four 32x32 products, which is the only part of Philox's
// round Wasm cannot spell directly: two widening multiplies and one shuffle
// that takes the upper four bytes of each 64-bit product.
#[inline(always)]
fn mulhi_u32x4(a: u32x4, b: u32x4) -> u32x4 {
    let av = a as v128 as i64x2;
    let bv = b as v128 as i64x2;
    let lo = av.extmul_low_i32x4_u(&bv);
    let hi = av.extmul_high_i32x4_u(&bv);
    return builtin::i8x16_shuffle(
        4,
        5,
        6,
        7,
        12,
        13,
        14,
        15,
        20,
        21,
        22,
        23,
        28,
        29,
        30,
        31,
        lo as v128,
        hi as v128,
    ) as u32x4;
}

// Four counters at once, one per 32-bit lane.
#[inline(always)]
fn philox4x32x4(key0: u32, key1: u32, counter: u32x4) -> [u32x4, u32x4, u32x4, u32x4] {
    let m0 = u32x4::splat(PHILOX_M0 as i32);
    let m1 = u32x4::splat(PHILOX_M1 as i32);
    let w0 = u32x4::splat(PHILOX_W0 as i32);
    let w1 = u32x4::splat(PHILOX_W1 as i32);
    let zero = u32x4::splat(0);
    let mut x0 = counter;
    let mut x1 = zero;
    let mut x2 = zero;
    let mut x3 = zero;
    let mut k0 = u32x4::splat(key0 as i32);
    let mut k1 = u32x4::splat(key1 as i32);
    for let mut round = 0; round < PHILOX_ROUNDS; round += 1 {
        let hi0 = mulhi_u32x4(x0, m0);
        let lo0 = x0 * m0;
        let hi1 = mulhi_u32x4(x2, m1);
        let lo1 = x2 * m1;
        x0 = hi1 ^ x1 ^ k0;
        x1 = lo1;
        x2 = hi0 ^ x3 ^ k1;
        x3 = lo0;
        k0 = k0 + w0;
        k1 = k1 + w1;
    }
    return [x0, x1, x2, x3];
}

fn drain_mix(n: i32) -> u64 {
    let mut acc: u64 = 0;
    for let mut i = 0; i < n; i += 1 {
        acc = acc ^ mix64(i as i64 as u64);
    }
    return acc;
}

fn drain_mix_simd(n: i32) -> u64 {
    let step: u64x2 = [2, 2];
    let mut key: u64x2 = [0, 1];
    let mut acc: u64x2 = [0, 0];
    for let mut i = 0; i < n; i += 2 {
        acc = acc ^ mix64x2(key);
        key = key + step;
    }
    return acc.extract_lane(0) as u64 ^ acc.extract_lane(1) as u64;
}

// The shape the terrain case actually has: two coordinates mixed into a key,
// walked in the consumer's order.
fn drain_value_at(side: i32) -> u64 {
    assert side * side == DRAW_COUNT, "the grid must hold one iteration's work";
    let mut acc: u64 = 0;
    for let mut y = 0; y < side; y += 1 {
        for let mut x = 0; x < side; x += 1 {
            acc = acc ^ value_at(0x5EED, x, y);
        }
    }
    return acc;
}

fn drain_philox(n: i32) -> u64 {
    let mut acc: u64 = 0;
    for let mut i = 0; i < n; i += 2 {
        let [a, b, c, d] = philox4x32(0x5EED, 0, i as u32);
        acc = acc ^ (b as u64 << 32 | a as u64) ^ (d as u64 << 32 | c as u64);
    }
    return acc;
}

fn drain_squares(keyed: &Squares64, n: i32) -> u64 {
    let mut acc: u64 = 0;
    for let mut i = 0; i < n; i += 1 {
        acc = acc ^ keyed.at(i as i64 as u64);
    }
    return acc;
}

fn drain_threefry(n: i32) -> u64 {
    let mut acc: u64 = 0;
    for let mut i = 0; i < n; i += 2 {
        let [a, b] = threefry2x64(0x5EED, 0, i as i64 as u64, 0);
        acc = acc ^ a ^ b;
    }
    return acc;
}

fn drain_threefry_simd(n: i32) -> u64 {
    let key0 = u64x2::splat(0x5EED);
    let key1 = u64x2::splat(0);
    let step = u64x2::splat(2);
    let zero = u64x2::splat(0);
    let mut ctr: u64x2 = [0, 1];
    let mut acc = u64x2::splat(0);
    for let mut i = 0; i < n; i += 4 {
        let [a, b] = threefry2x64x2(key0, key1, ctr, zero);
        acc = acc ^ a ^ b;
        ctr = ctr + step;
    }
    return acc.extract_lane(0) as u64 ^ acc.extract_lane(1) as u64;
}

fn drain_philox_simd(n: i32) -> u64 {
    let step = u32x4::splat(4);
    let mut ctr: u32x4 = [0, 1, 2, 3];
    let mut acc = u32x4::splat(0);
    for let mut i = 0; i < n; i += 8 {
        let [a, b, c, d] = philox4x32x4(0x5EED, 0, ctr);
        acc = acc ^ a ^ b ^ c ^ d;
        ctr = ctr + step;
    }
    let mut out: u64 = 0;
    for let mut lane = 0; lane < 4; lane += 1 {
        out = out ^ acc.extract_lane(lane) as i64 as u64;
    }
    return out;
}

global COORD_X: u64 = 0x9E3779B97F4A7C15;

global COORD_Y: u64 = 0xC2B2AE3D27D4EB4F;

// The terrain shape: the counter is two coordinates folded into one word, and
// the key is the world seed. Every candidate folds the same way, so the gap
// between these and the counter drains above is the fold and nothing else.
#[inline(always)]
fn coord_key(x: i32, y: i32) -> u64 {
    return x as i64 as u64 * COORD_X ^ y as i64 as u64 * COORD_Y;
}

fn drain_squares_grid(keyed: &Squares64, side: i32) -> u64 {
    assert side * side == DRAW_COUNT, "the grid must hold one iteration's work";
    let mut acc: u64 = 0;
    for let mut y = 0; y < side; y += 1 {
        for let mut x = 0; x < side; x += 1 {
            acc = acc ^ keyed.at(coord_key(x, y));
        }
    }
    return acc;
}

fn drain_threefry_grid(side: i32) -> u64 {
    assert side * side == DRAW_COUNT, "the grid must hold one iteration's work";
    let mut acc: u64 = 0;
    for let mut y = 0; y < side; y += 1 {
        for let mut x = 0; x < side; x += 1 {
            let [a, _] = threefry2x64(0x5EED, 0, coord_key(x, y), 0);
            acc = acc ^ a;
        }
    }
    return acc;
}

fn drain_philox_grid(side: i32) -> u64 {
    assert side * side == DRAW_COUNT, "the grid must hold one iteration's work";
    let mut acc: u64 = 0;
    for let mut y = 0; y < side; y += 1 {
        for let mut x = 0; x < side; x += 1 {
            let [a, b, _, _] = philox4x32(0x5EED, 0, coord_key(x, y) as u32);
            acc = acc ^ (b as u64 << 32 | a as u64);
        }
    }
    return acc;
}

global DRAW_COUNT: i32 = 1 << 16;

global GRID_SIDE: i32 = 1 << 8;

// Long enough to cross every boundary in the file several times, short enough
// that a failure prints a stream a reader can scan.
#[allow(dead_code)]
global STREAM_WORDS: i32 = 128;

// A drain folds its batch into one word, which a benchmark wants and an
// equivalence must not rest on: a fold agrees across a reordering of the batch
// or a swap of two lanes. The collector below keeps the emission order, which
// is what two paths agreeing means.
#[allow(dead_code)]
fn collect_by_batch<R: VectorRng>(rng: &mut R, n: i32) -> List<u64> {
    let mut out = List::<u64>::filled(n, 0);
    for let mut at = 0; at < n; at += BATCH_WORDS {
        spill_batch(&mut out, at, rng.next_batch());
    }
    return out;
}

#[allow(dead_code)]
fn collect_scalar<R: Rng>(rng: &mut R, n: i32) -> List<u64> {
    let mut out: List<u64> = [];
    for let mut i = 0; i < n; i += 1 {
        out.push(rng.next_u64());
    }
    return out;
}

test "a per-draw cursor hands back the batch in order" {
    let mut batched = Shishua::from_seed(Seed::from_u64(5));
    let mut cursor = BatchCursor { engine: Shishua::from_seed(Seed::from_u64(5)) };
    assert collect_scalar(&mut cursor, STREAM_WORDS) == collect_by_batch(&mut batched, STREAM_WORDS);

    let mut simd_batched = XoshiroSimd::from_seed(Seed::from_u64(5));
    let mut simd_cursor = BatchCursor { engine: XoshiroSimd::from_seed(Seed::from_u64(5)) };
    assert collect_scalar(&mut simd_cursor, STREAM_WORDS) == collect_by_batch(&mut simd_batched, STREAM_WORDS);
}

test "filling a buffer hands back the same stream as draining one" {
    let mut direct = XoshiroSimd::from_seed(Seed::from_u64(6));
    let expected = collect_by_batch(&mut direct, BATCH_WORDS * 4);

    let mut filled = XoshiroSimd::from_seed(Seed::from_u64(6));
    let mut buffer = List::<u64>::filled(BATCH_WORDS * 4, 0);
    drain_batch_fill(&mut filled, &mut buffer, BATCH_WORDS * 4);
    assert buffer == expected;
}

test "each keyed vector form answers what its scalar form does" {
    for let mut i = 0; i < 8; i += 2 {
        let pair: u64x2 = [i as i64, i as i64 + 1];

        let [sa0, sa1] = threefry2x64(0x5EED, 0, i as i64 as u64, 0);
        let [sb0, sb1] = threefry2x64(0x5EED, 0, i as i64 as u64 + 1, 0);
        let [v0, v1] = threefry2x64x2(
            u64x2::splat(0x5EED),
            u64x2::splat(0),
            pair,
            u64x2::splat(0),
        );
        assert v0.extract_lane(0) as u64 == sa0;
        assert v1.extract_lane(0) as u64 == sa1;
        assert v0.extract_lane(1) as u64 == sb0;
        assert v1.extract_lane(1) as u64 == sb1;
    }

    let ctr: u32x4 = [0, 1, 2, 3];
    let [p0, p1, p2, p3] = philox4x32x4(0x5EED, 0, ctr);
    for let mut lane = 0; lane < 4; lane += 1 {
        let [s0, s1, s2, s3] = philox4x32(0x5EED, 0, lane as u32);
        assert p0.extract_lane(lane) as u32 == s0;
        assert p1.extract_lane(lane) as u32 == s1;
        assert p2.extract_lane(lane) as u32 == s2;
        assert p3.extract_lane(lane) as u32 == s3;
    }
}

test "a keyed draw depends on its key and nothing else" {
    let keyed = Squares64::from_seed(Seed::from_u64(1));
    assert keyed.at(coord_key(3, 7)) == keyed.at(coord_key(3, 7));
    assert keyed.at(coord_key(3, 7)) != keyed.at(coord_key(7, 3));

    // Between the two reads above, other keys were drawn; a stream would have
    // moved on.
    let mut seen: List<u64> = [];
    for let mut i = 0; i < 1000; i += 1 {
        seen.push(keyed.at(i as i64 as u64));
    }
    assert keyed.at(coord_key(3, 7)) == keyed.at(coord_key(3, 7));
    for let mut i = 0; i < seen.len(); i += 1 {
        assert seen[i] == keyed.at(i as i64 as u64);
    }
}

test "the traversal order does not change a cell's value" {
    let keyed = Squares64::from_seed(Seed::from_u64(9));
    let mut row_major: List<u64> = [];
    for let mut y = 0; y < 8; y += 1 {
        for let mut x = 0; x < 8; x += 1 {
            row_major.push(keyed.at(coord_key(x, y)));
        }
    }
    for let mut x = 0; x < 8; x += 1 {
        for let mut y = 0; y < 8; y += 1 {
            assert row_major[y * 8 + x] == keyed.at(coord_key(x, y));
        }
    }
}

test "the vector mixer hands back what the scalar one does" {
    for let mut i = 0; i < 64; i += 2 {
        let v = mix64x2([i as i64, (i + 1) as i64]);
        assert v.extract_lane(0) as u64 == mix64(i as i64 as u64);
        assert v.extract_lane(1) as u64 == mix64((i + 1) as i64 as u64);
    }
}

test "philox moves with its counter and its key" {
    let [a0, a1, a2, a3] = philox4x32(5, 0, 1);
    let [b0, b1, b2, b3] = philox4x32(5, 0, 1);
    assert a0 == b0 && a1 == b1 && a2 == b2 && a3 == b3;

    let [c0, c1, c2, c3] = philox4x32(5, 0, 2);
    assert a0 != c0 || a1 != c1 || a2 != c2 || a3 != c3;

    let [d0, d1, d2, d3] = philox4x32(6, 0, 1);
    assert a0 != d0 || a1 != d1 || a2 != d2 || a3 != d3;

    let drawn: List<u32> = [a0, a1, a2, a3];
    for let mut i = 0; i < drawn.len(); i += 1 {
        assert drawn[i] != 0;
    }
}

test "each generator moves, and no two agree" {
    let mut romu = RomuTrio::new(1);
    let mut xoshiro = Xoshiro256pp::from_seed(Seed::from_u64(1));
    let mut xoshiro_simd = XoshiroSimd::from_seed(Seed::from_u64(1));
    let mut shishua = Shishua::from_seed(Seed::from_u64(1));

    let a = drain_scalar(&mut romu, 64);
    let b = drain_scalar(&mut xoshiro, 64);
    let c = drain_by_batch(&mut xoshiro_simd, 64);
    let d = drain_by_batch(&mut shishua, 64);

    let drawn: List<u64> = [a, b, c, d];
    for let mut i = 0; i < drawn.len(); i += 1 {
        assert drawn[i] != 0;
        for let mut j = i + 1; j < drawn.len(); j += 1 {
            assert drawn[i] != drawn[j];
        }
    }
}

export fn run() with (Stdout, MonotonicClock) {
    let mut bench = Benchmark {
        name: `prng, ${DRAW_COUNT} draws per iteration`,
        work_per_iter: Option::Some(DRAW_COUNT as f64),
        unit: "u64",
    };

    let mut romu = RomuTrio::new(12345);
    let romu_acc = bench.run("RomuTrio", || drain_scalar(&mut romu, DRAW_COUNT));

    let mut xoshiro = Xoshiro256pp::from_seed(Seed::from_u64(12345));
    let xoshiro_acc = bench.run("xoshiro256++", || {
        return drain_scalar(&mut xoshiro, DRAW_COUNT);
    });

    let mut simd_cursor = BatchCursor { engine: XoshiroSimd::from_seed(Seed::from_u64(12345)) };
    let simd_draw_acc = bench.run("xoshiro256++ x8, per draw", || {
        return drain_scalar(&mut simd_cursor, DRAW_COUNT);
    });

    let mut shishua_cursor = BatchCursor { engine: Shishua::from_seed(Seed::from_u64(12345)) };
    let shishua_draw_acc = bench.run("SHISHUA, per draw", || {
        return drain_scalar(&mut shishua_cursor, DRAW_COUNT);
    });

    let mut simd_batched = XoshiroSimd::from_seed(Seed::from_u64(12345));
    let simd_batch_acc = bench.run("xoshiro256++ x8, a batch through VectorRng", || {
        return drain_by_batch(&mut simd_batched, DRAW_COUNT);
    });

    let mut shishua_batched = Shishua::from_seed(Seed::from_u64(12345));
    let shishua_batch_acc = bench.run("SHISHUA, a batch through VectorRng", || {
        return drain_by_batch(&mut shishua_batched, DRAW_COUNT);
    });

    let mut buffer = List::<u64>::filled(1024, 0);

    let mut romu_filler = RomuTrio::new(12345);
    let romu_fill_acc = bench.run("RomuTrio, filling a buffer", || {
        return drain_scalar_fill(&mut romu_filler, &mut buffer, DRAW_COUNT);
    });

    let mut simd_filler = XoshiroSimd::from_seed(Seed::from_u64(12345));
    let simd_fill_acc = bench.run("xoshiro256++ x8, filling a buffer", || {
        return drain_batch_fill(&mut simd_filler, &mut buffer, DRAW_COUNT);
    });

    let mut shishua_filler = Shishua::from_seed(Seed::from_u64(12345));
    let shishua_fill_acc = bench.run("SHISHUA, filling a buffer", || {
        return drain_batch_fill(&mut shishua_filler, &mut buffer, DRAW_COUNT);
    });

    bench.println(
        `stream checksums: ${romu_acc} ${xoshiro_acc} ${simd_draw_acc} ${shishua_draw_acc}`,
    );
    bench.println(
        `batch checksums: ${simd_batch_acc} ${shishua_batch_acc}`,
    );
    bench.println(
        `fill checksums: ${romu_fill_acc} ${simd_fill_acc} ${shishua_fill_acc}`,
    );

    let mix_acc = bench.run("mix64, keyed by an index", || drain_mix(DRAW_COUNT));
    let mix_simd_acc = bench.run("mix64 x2, keyed by an index", || {
        return drain_mix_simd(DRAW_COUNT);
    });
    let grid_acc = bench.run("mix64, keyed by two coordinates", || {
        return drain_value_at(GRID_SIDE);
    });
    let philox_acc = bench.run("Philox4x32-10, keyed by a counter", || {
        return drain_philox(DRAW_COUNT);
    });

    bench.println(
        `keyed checksums: ${mix_acc} ${mix_simd_acc} ${grid_acc} ${philox_acc}`,
    );

    let keyed = Squares64::from_seed(Seed::from_u64(0x5EED));
    let squares_acc = bench.run("Squares64, keyed by a counter", || {
        return drain_squares(&keyed, DRAW_COUNT);
    });
    let threefry_acc = bench.run("Threefry-2x64-13, keyed by a counter", || {
        return drain_threefry(DRAW_COUNT);
    });
    let threefry_simd_acc = bench.run("Threefry-2x64-13 x2, keyed by a counter", || {
        return drain_threefry_simd(DRAW_COUNT);
    });
    let philox_simd_acc = bench.run("Philox4x32-10 x4, keyed by a counter", || {
        return drain_philox_simd(DRAW_COUNT);
    });

    let squares_grid_acc = bench.run("Squares64, keyed by two coordinates", || {
        return drain_squares_grid(&keyed, GRID_SIDE);
    });
    let threefry_grid_acc = bench.run("Threefry-2x64-13, keyed by two coordinates", || {
        return drain_threefry_grid(GRID_SIDE);
    });
    let philox_grid_acc = bench.run("Philox4x32-10, keyed by two coordinates", || {
        return drain_philox_grid(GRID_SIDE);
    });

    bench.println(
        `candidate checksums: ${squares_acc} ${threefry_acc} ${threefry_simd_acc} ${philox_simd_acc}`,
    );
    bench.println(
        `grid checksums: ${squares_grid_acc} ${threefry_grid_acc} ${philox_grid_acc}`,
    );
}
