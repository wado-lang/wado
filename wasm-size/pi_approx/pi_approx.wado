use { println, Stdout } from "core:cli";

test "pi approximation" {
    let mut pi = 0.0;
    let mut sign = 1.0;
    for let mut i = 0; i < 1000; i += 1 {
        pi += sign / (2.0 * i as f64 + 1.0);
        sign = -sign;
    }
    pi *= 4.0;
    // After 1000 terms, should be close to 3.14
    assert pi > 3.14;
    assert pi < 3.15;
}

// Leibniz formula: π/4 = 1 - 1/3 + 1/5 - 1/7 + ...
export fn run() with Stdout {
    let mut pi = 0.0;
    let mut sign = 1.0;
    for let mut i = 0; i < 1000000; i += 1 {
        pi += sign / (2.0 * i as f64 + 1.0);
        sign = -sign;
    }
    pi *= 4.0;
    println(`pi = ${pi}`);
}
