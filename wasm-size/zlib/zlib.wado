export fn run() with Stdout {
    let compressed = compressed_data();

    // Decompress
    let decompressed = inflate_zlib(&compressed);

    // Verify: check first few bytes of pattern
    assert decompressed.len() == 1024;
    assert decompressed[0] == 0;
    assert decompressed[1] == 1;
    assert decompressed[255] == 255;

    println(`wado core:zlib: {compressed.len()} -> {decompressed.len()}`);
}
