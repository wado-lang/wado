use { Stdout } from "core:cli";
use { Stdin } from "wasi:cli";
use { inflate_gzip, gzip_compress } from "core:zlib";
use { wait_for_subtask } from "core:internal";

test "gzip round-trip" {
    let mut original: Array<u8> = [];
    for (let mut i = 0; i < 1024; i = i + 1) {
        original.append((i % 256) as u8);
    }
    let compressed = gzip_compress(&original);
    let decompressed = inflate_gzip(&compressed).unwrap();
    assert decompressed.len() == 1024;
    assert decompressed[0] == 0;
    assert decompressed[1] == 1;
    assert decompressed[255] == 255;
}

export fn run() with Stdout, Stdin {
    let [stdin_stream, _done] = Stdin::read_via_stream();

    // Read all gzip data from stdin
    let mut data: Array<u8> = [];
    loop {
        let chunk = stdin_stream.read(4096);
        if chunk.len() == 0 {
            break;
        }
        for let b of chunk {
            data.append(b);
        }
    }
    stdin_stream.drop();

    // Decompress gzip and write to stdout
    let decompressed = inflate_gzip(&data).unwrap();
    let handles = builtin::stream_new();
    let rx = handles as i32;
    let tx = (handles >> 32) as i32;
    let subtask = builtin::call_indirect_stdout_write_via_stream(rx);
    let len = decompressed.len();
    let ptr = builtin::realloc(0, 0, 1, len);
    for (let mut i = 0; i < len; i = i + 1) {
        builtin::i32_store8(ptr + i, decompressed[i] as i32);
    }
    builtin::stream_write(tx, ptr, len);
    builtin::stream_drop_writable(tx);
    wait_for_subtask(subtask);
}
