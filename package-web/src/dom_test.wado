// No host implements `web:dom` here: a handler answers what the program calls,
// and the host fills every import with a trap for what it does not.
use {
    Document,
    Dom,
    Element,
    HtmlElement,
    HtmlInputElement,
    Node,
    DOCUMENT_CLASS,
    HANDLE_CLASS_STRIDE,
    HTML_ELEMENT_CLASS,
    HTML_INPUT_ELEMENT_CLASS,
} from "./dom.wado";

struct FakeDom {
    texts: List<String>,
}

fn handle(class: f64, index: i32) -> f64 {
    return class * HANDLE_CLASS_STRIDE + index as f64;
}

fn index_of(this: &Node) -> i32 {
    return f64::fmod(*this as f64, HANDLE_CLASS_STRIDE) as i32;
}

impl Dom for FakeDom {
    fn document(&mut self) -> Document {
        resume handle(DOCUMENT_CLASS, 0) as Document;
    }

    ..trap
}

impl Document for FakeDom {
    fn create_element(&mut self, this: &Document, local_name: String, options: Option<String>) -> Element {
        self.texts.push("");
        let class = if local_name == "input" { HTML_INPUT_ELEMENT_CLASS } else { HTML_ELEMENT_CLASS };
        resume handle(class, self.texts.len()) as Element;
    }

    ..trap
}

impl Node for FakeDom {
    fn set_text_content(&mut self, this: &Node, value: Option<String>) {
        self.texts[index_of(this) - 1] = value.unwrap_or("");
        resume ();
    }

    fn text_content(&mut self, this: &Node) -> Option<String> {
        resume Option::Some(self.texts[index_of(this) - 1]);
    }

    ..trap
}

test "a handler serves every call" {
    let mut dom = FakeDom { texts: [] };
    with &mut dom do {
        let el = Dom::document().create_element("div", null);
        el.set_text_content(Option::Some("hello"));
        assert el.text_content() == Option::Some("hello");
    };
    assert dom.texts == ["hello"];
}

test "a type pattern reads the class the handle carries" {
    let mut dom = FakeDom { texts: [] };
    with &mut dom do {
        let doc = Dom::document();
        let input = doc.create_element("input", null);
        let div = doc.create_element("div", null);
        assert input matches { _: HtmlInputElement };
        assert !div matches { _: HtmlInputElement };
        assert div matches { _: HtmlElement };
        let node: Node = doc;
        assert !node matches { _: Element };
        assert node matches { _: Document };
    };
}

test "handles compare equal when they name one object" {
    let mut dom = FakeDom { texts: [] };
    with &mut dom do {
        let doc = Dom::document();
        let div = doc.create_element("div", null);
        assert `${div:?}` == "Element#412316860417.0";
        let as_node: Node = div;
        assert as_node == div;
        assert div != doc.create_element("div", null);
        assert Dom::document() == doc;
    };
}

#[expect_trap]
test "a call no handler answers traps" {
    let _ = Dom::window();
}
