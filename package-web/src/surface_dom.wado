//! The DOM's API surface without a browser engine behind it, answering the
//! calls where no browser runs: `with &mut dom do { app(); }`.

use { HashMap } from "core:collections";
use {
    AddEventListenerOptionsOrBool,
    BoolOrScrollIntoViewOptions,
    CharacterData,
    Document,
    DocumentReadyState,
    DocumentVisibilityState,
    Dom,
    Element,
    Event,
    EventInit,
    EventListener,
    EventTarget,
    FullscreenOptions,
    GetHtmlOptions,
    HtmlElement,
    HtmlInputElement,
    Node,
    Rejection,
    StringOrElementCreationOptions,
    Text,
    Window,
} from "./dom.wado";

variant Content {
    Document,
    Window,
    Doctype,
    Element(String),
    Text(String),
}

struct Listener {
    type: String,
    capture: bool,
    once: bool,
    callback: EventListener,
}

// Linked as the DOM standard models the tree. A node lives in its handle, and
// the links are handles, so the tree alone keeps a node alive: one that is
// detached and that the program dropped is collected.
struct SurfaceNode {
    content: Content,
    // The DOM standard's node document, `None` on the document itself.
    document: Option<Document>,
    attributes: HashMap<String, String>,
    // The elements a reflected element reference was set to, by its attribute.
    referenced: HashMap<String, List<Element>>,
    value: String,
    listeners: List<Listener>,
    parent: Option<Node>,
    first_child: Option<Node>,
    last_child: Option<Node>,
    previous_sibling: Option<Node>,
    next_sibling: Option<Node>,
}

struct SurfaceEvent {
    type: String,
    bubbles: bool,
    cancelable: bool,
    composed: bool,
    target: Option<EventTarget>,
    // Empty unless the event is being dispatched.
    path: List<EventTarget>,
}

struct SurfaceRejection {
    name: String,
    message: String,
}

// The Fullscreen standard rejects with a `TypeError` where fullscreen is not
// supported, and no screen shows this document.
fn fullscreen_unsupported() -> Rejection {
    return Rejection::backed_by(SurfaceRejection { name: "TypeError", message: "fullscreen is not supported" });
}

fn surface_rejection(rejection: Rejection) -> &mut SurfaceRejection {
    return rejection.backing::<SurfaceRejection>().expect("a rejection of a SurfaceDom backs the handle");
}

fn surface_event(event: Event) -> &mut SurfaceEvent {
    return event.backing::<SurfaceEvent>().expect("an event of a SurfaceDom backs the handle");
}

// Every event target is a node here, the window included.
fn surface_node(target: EventTarget) -> &mut SurfaceNode {
    return target.backing::<SurfaceNode>().expect("a node of a SurfaceDom backs the handle");
}

fn detached(content: Content, document: Option<Document>) -> SurfaceNode {
    return SurfaceNode {
        content,
        document,
        attributes: HashMap::new(),
        referenced: HashMap::new(),
        value: "",
        listeners: [],
        parent: null,
        first_child: null,
        last_child: null,
        previous_sibling: null,
        next_sibling: null,
    };
}

struct Children {
    at: Option<Node>,
}

impl Iterator for Children {
    type Item = Node;

    fn next(&mut self) -> Option<Node> {
        let child = self.at;
        if let Some(node) = child {
            self.at = surface_node(node).next_sibling;
        }
        return child;
    }
}

fn children(parent: Node) -> Children {
    return Children { at: surface_node(parent).first_child };
}

fn child_where(parent: Node, accept: fn(&SurfaceNode) -> bool) -> Option<Node> {
    return children(parent).find(|child| accept(surface_node(child)));
}

fn child_named(parent: Node, local_name: String) -> Option<Node> {
    return child_where(parent, |n| n.content matches { Element(name) && name == local_name });
}

fn first_inclusive_descendant_where(node: Node, accept: fn(&SurfaceNode) -> bool) -> Option<Node> {
    if accept(surface_node(node)) {
        return Option::Some(node);
    }
    for let child of children(node) {
        let found = first_inclusive_descendant_where(child, accept);
        if found != null {
            return found;
        }
    }
    return null;
}

fn element_of(node: Option<Node>) -> Option<Element> {
    return match node {
        Some(element: Element) => Option::Some(element),
        _ => null,
    };
}

fn is_inclusive_ancestor(ancestor: Node, node: Node) -> bool {
    let mut at = Option::Some(node);
    while let Some(here) = at {
        if here == ancestor {
            return true;
        }
        at = surface_node(here).parent;
    }
    return false;
}

fn root_of(node: Node) -> Node {
    let mut at = node;
    while let Some(parent) = surface_node(at).parent {
        at = parent;
    }
    return at;
}

fn detach(child: Node) {
    let node = surface_node(child);
    let Some(parent) = node.parent else {
        return;
    };
    let previous = node.previous_sibling;
    let next = node.next_sibling;
    if let Some(before) = previous {
        surface_node(before).next_sibling = next;
    } else {
        surface_node(parent).first_child = next;
    }
    if let Some(after) = next {
        surface_node(after).previous_sibling = previous;
    } else {
        surface_node(parent).last_child = previous;
    }
    node.parent = null;
    node.previous_sibling = null;
    node.next_sibling = null;
}

fn insert(parent: Node, child: Node, next: Option<Node>) {
    detach(child);
    let into = surface_node(parent);
    let previous = match next {
        Some(after) => surface_node(after).previous_sibling,
        null => into.last_child,
    };
    if let Some(before) = previous {
        surface_node(before).next_sibling = Option::Some(child);
    } else {
        into.first_child = Option::Some(child);
    }
    if let Some(after) = next {
        surface_node(after).previous_sibling = Option::Some(child);
    } else {
        into.last_child = Option::Some(child);
    }
    let node = surface_node(child);
    node.previous_sibling = previous;
    node.next_sibling = next;
    node.parent = Option::Some(parent);
}

fn append(parent: Node, child: Node) {
    insert(parent, child, null);
}

fn remove_children(parent: Node) {
    while let Some(child) = surface_node(parent).first_child {
        detach(child);
    }
}

fn text_of(node: Node, out: &mut String) {
    if let Text(text) = surface_node(node).content {
        out.push_str(&text);
    }
    for let child of children(node) {
        text_of(child, out);
    }
}

fn is_element(node: &SurfaceNode) -> bool {
    return node.content matches { Element(_) };
}

fn is_doctype(node: &SurfaceNode) -> bool {
    return node.content matches { _::Doctype };
}

fn any_sibling(start: Option<Node>, step: fn(&SurfaceNode) -> Option<Node>, accept: fn(&SurfaceNode) -> bool) -> bool {
    let mut at = start;
    while let Some(here) = at {
        let node = surface_node(here);
        if accept(node) {
            return true;
        }
        at = step(node);
    }
    return false;
}

// The DOM standard's validity checks, its steps in order, for inserting `node`
// before `child`, or for replacing `child` with it where `replacing`: the child
// replaced counts for neither the one element nor the one doctype a document
// holds. A DOM exception traps (Web WEP, Exceptions).
fn assert_insertable(parent: Node, node: Node, child: Option<Node>, replacing: bool) {
    let replaced = if replacing { child } else { null };
    let other_child = |accept: fn(&SurfaceNode) -> bool| children(parent).find(
        |c| Option::Some(c) != replaced && accept(surface_node(c)),
    );
    let into_document = surface_node(parent).content matches { _::Document };
    assert into_document || is_element(surface_node(parent)), "HierarchyRequestError: only a document or an element holds children";
    assert !is_inclusive_ancestor(node, parent), "HierarchyRequestError: a node cannot be inserted into itself or its descendant";
    if let Some(reference) = child {
        assert surface_node(reference).parent == Option::Some(parent), "NotFoundError: the reference node is a child";
    }
    match surface_node(node).content {
        _::Document | _::Window => panic("HierarchyRequestError: a document or a window is never a child"),
        Text(_) => {
            assert !into_document, "HierarchyRequestError: a document holds no text";
        },
        _::Doctype => {
            assert into_document, "HierarchyRequestError: only a document holds a doctype";
        },
        Element(_) => {
        },
    }
    if !into_document {
        return;
    }
    if is_element(surface_node(node)) {
        assert other_child(is_element) == null, "HierarchyRequestError: a document holds one element";
        if let Some(reference) = child {
            let after = if replacing { surface_node(reference).next_sibling } else { child };
            assert !any_sibling(after, |n| n.next_sibling, is_doctype), "HierarchyRequestError: the element follows the doctype";
        }
    } else {
        assert other_child(is_doctype) == null, "HierarchyRequestError: a document holds one doctype";
        let ahead = match child {
            Some(reference) => surface_node(reference).previous_sibling,
            null => surface_node(parent).last_child,
        };
        assert !any_sibling(ahead, |n| n.previous_sibling, is_element), "HierarchyRequestError: the doctype precedes the element";
    }
}

// The DOM standard's pre-insert.
fn pre_insert(parent: Node, node: Node, child: Option<Node>) {
    assert_insertable(parent, node, child, false);
    let next = if child == Option::Some(node) { surface_node(node).next_sibling } else { child };
    insert(parent, node, next);
}

// Writes an element's attribute, or removes it for `null`. Either forgets
// the elements a reference was set to under that name.
fn write_attribute(node: &mut SurfaceNode, name: String, value: Option<String>) {
    node.referenced.remove(name);
    if let Some(value) = value {
        node.attributes[name] = value;
    } else {
        node.attributes.remove(name);
    }
}

fn serialize_children(parent: Node, out: &mut String) {
    let holder = surface_node(parent);
    if holder.content matches { Element(name) && is_void(&name) } {
        return;
    }
    let raw_text = holder.content matches { Element(name) && is_raw_text(&name) };
    for let child of children(parent) {
        let node = surface_node(child);
        match node.content {
            _::Document | _::Window => unreachable(),
            _::Doctype => out.push_str("<!DOCTYPE html>"),
            Text(text) => {
                if raw_text {
                    out.push_str(&text);
                } else {
                    escape(&text, false, out);
                }
            },
            Element(name) => {
                out.push_str(`<${name}`);
                for let [key, value] of node.attributes.entries() {
                    out.push_str(` ${key}="`);
                    escape(value, true, out);
                    out.push('"');
                }
                out.push('>');
                serialize_children(child, out);
                if !is_void(&name) {
                    out.push_str(`</${name}>`);
                }
            },
        }
    }
}

// Infra's ASCII whitespace leaves out the VT that `char::is_ascii_whitespace` counts.
fn is_infra_whitespace(c: char) -> bool {
    return c matches { '\t' | '\n' | '\u{C}' | '\r' | ' ' };
}

fn is_valid_element_local_name(name: &String) -> bool {
    let mut chars = name.chars();
    let Some(first) = chars.next() else {
        return false;
    };
    if first.is_ascii_alphabetic() {
        return !chars.any(|c| is_infra_whitespace(c) || c matches { '\0' | '/' | '>' });
    }
    let in_name = |c: char| c matches { ':' | '_' } || c as u32 >= 0x80;
    return in_name(first) && chars.all(|c| in_name(c) || c.is_ascii_alphanumeric() || c matches { '-' | '.' });
}

fn is_valid_attribute_local_name(name: &String) -> bool {
    return !name.is_empty() && !name.chars().any(|c| is_infra_whitespace(c) || c matches { '\0' | '/' | '=' | '>' });
}

fn is_void(local_name: &String) -> bool {
    return *local_name matches { "area" | "base" | "basefont" | "bgsound" | "br" | "col" | "embed" | "frame" | "hr" | "img" | "input" | "keygen" | "link" | "meta" | "param" | "source" | "track" | "wbr" };
}

// Scripting is disabled where no browser runs, so `noscript` is escaped.
fn is_raw_text(local_name: &String) -> bool {
    return *local_name matches { "style" | "script" | "xmp" | "iframe" | "noembed" | "noframes" | "plaintext" };
}

// The Infra standard's "split on ASCII whitespace".
fn split_on_ascii_whitespace(text: &String) -> List<String> {
    let mut tokens: List<String> = [];
    let mut token = "";
    for let c of text.chars() {
        if !is_infra_whitespace(c) {
            token.push(c);
        } else if !token.is_empty() {
            tokens.push(token);
            token = "";
        }
    }
    if !token.is_empty() {
        tokens.push(token);
    }
    return tokens;
}

// The HTML standard's "escaping a string".
fn escape(text: &String, in_attribute: bool, out: &mut String) {
    for let c of text.chars() {
        match c {
            '&' => out.push_str("&amp;"),
            '\u{A0}' => out.push_str("&nbsp;"),
            '<' => out.push_str("&lt;"),
            '>' => out.push_str("&gt;"),
            '"' && in_attribute => out.push_str("&quot;"),
            _ => out.push(c),
        }
    }
}

fn strip_and_collapse_ascii_whitespace(text: &String) -> String {
    let mut out = "";
    let mut gap = false;
    for let c of text.chars() {
        if is_infra_whitespace(c) {
            gap = !out.is_empty();
        } else {
            if gap {
                out.push(' ');
                gap = false;
            }
            out.push(c);
        }
    }
    return out;
}

/// A document of `<!DOCTYPE html><html><head></head><body></body></html>`, as
/// `createHTMLDocument()` makes, and the window holding it. A copy of one is
/// the same document, since its nodes live in the handles both hold.
pub struct SurfaceDom {
    document: Document,
    window: Window,
}

impl SurfaceDom {
    pub fn new() -> SurfaceDom {
        let document = Document::backed_by(detached(Content::Document, null));
        let dom = SurfaceDom {
            document,
            window: Window::backed_by(detached(Content::Window, Option::Some(document))),
        };
        append(document, dom.new_doctype());
        let html = dom.new_element("html");
        append(document, html);
        append(html, dom.new_element("head"));
        append(html, dom.new_element("body"));
        return dom;
    }

    /// The document as HTML, doctype included.
    pub fn to_html(&self) -> String {
        let mut html = "";
        serialize_children(self.document, &mut html);
        return html;
    }

    fn detached(&self, content: Content) -> SurfaceNode {
        return detached(content, Option::Some(self.document));
    }

    // The slice has no `DocumentType`, so a doctype carries `Node`'s class.
    fn new_doctype(&self) -> Node {
        return Node::backed_by(self.detached(Content::Doctype));
    }

    fn new_text(&self, data: String) -> Text {
        return Text::backed_by(self.detached(Content::Text(data)));
    }

    fn new_element(&self, local_name: String) -> HtmlElement {
        let node = self.detached(Content::Element(local_name));
        if local_name == "input" {
            return HtmlInputElement::backed_by(node);
        }
        return HtmlElement::backed_by(node);
    }

    fn own(&self, target: EventTarget) -> &mut SurfaceNode {
        let node = surface_node(target);
        assert target == self.document || node.document == Option::Some(self.document), "the handle is of this SurfaceDom";
        return node;
    }

    // The DOM standard's event path, which reaches the window from the document.
    fn event_path(&self, target: EventTarget) -> List<EventTarget> {
        let mut path: List<EventTarget> = [target];
        let mut at = target;
        loop {
            if at == self.document {
                at = self.window;
            } else if let Some(parent) = surface_node(at).parent {
                at = parent;
            } else {
                return path;
            }
            path.push(at);
        }
    }

    // Runs with this DOM reinstalled, since a listener is a program calling back
    // into it. A listener added meanwhile waits for the next dispatch, and one
    // added with `once` is gone before it runs, as the DOM standard removes it.
    fn invoke(&mut self, target: EventTarget, event: Event, capture: bool) {
        let type = &surface_event(event).type;
        let node = surface_node(target);
        let mut callbacks: List<EventListener> = [];
        let mut kept: List<Listener> = [];
        for let listener of node.listeners {
            let heard = listener.capture == capture && listener.type == *type;
            if heard {
                callbacks.push(listener.callback);
            }
            if !(heard && listener.once) {
                kept.push(listener);
            }
        }
        node.listeners = kept;
        for let mut callback of callbacks {
            with &mut *self do {
                callback(event);
            };
        }
    }

    fn local_name_of(&self, element: Element) -> String {
        let Element(name) = self.own(element).content else {
            unreachable();
        };
        return name;
    }

    // The HTML standard's attr-associated elements of a reflected element
    // reference: the elements set, or else those its attribute names by id.
    fn referenced_elements(&self, element: Element, attribute: String) -> Option<List<Element>> {
        let node = self.own(element);
        let root = root_of(element);
        let mut found: List<Element> = [];
        if let Some(targets) = node.referenced.get(attribute) {
            // Only a descendant of one of the element's ancestors counts.
            for let target of targets {
                if root != element && target != root && root_of(target) == root {
                    found.push(target);
                }
            }
            return Option::Some(found);
        }
        let Some(ids) = node.attributes.get(attribute) else {
            return null;
        };
        for let id of split_on_ascii_whitespace(&ids) {
            let target = first_inclusive_descendant_where(
                root,
                |n| n.content matches { Element(_) } && n.attributes.get("id") == Option::Some(id),
            );
            if let Some(named) = element_of(target) {
                found.push(named);
            }
        }
        return Option::Some(found);
    }

    fn set_referenced_elements(&self, element: Element, attribute: String, elements: Option<List<Element>>) {
        let node = self.own(element);
        let Some(elements) = elements else {
            write_attribute(node, attribute, null);
            return;
        };
        for let target of elements {
            self.own(target);
        }
        write_attribute(node, attribute, Option::Some(""));
        node.referenced[attribute] = elements;
    }

    fn title_element(&self) -> Option<Node> {
        return first_inclusive_descendant_where(
            self.document,
            |n| n.content matches { Element(name) && name == "title" },
        );
    }

    fn replace_all_text(&self, node: Node, text: String) {
        remove_children(node);
        if !text.is_empty() {
            append(node, self.new_text(text));
        }
    }

    fn html_child(&self, local_name: String) -> Option<Node> {
        let Some(html) = child_named(self.document, "html") else {
            return null;
        };
        return child_named(html, local_name);
    }
}

impl Dom for SurfaceDom {
    fn window(&mut self) -> Window {
        resume self.window;
    }

    fn document(&mut self) -> Document {
        resume self.document;
    }
}

impl Window for SurfaceDom {
    fn document(&mut self, this: &Window) -> Document {
        self.own(*this);
        resume self.document;
    }

    ..trap
}

impl EventTarget for SurfaceDom {
    fn add_event_listener(
        &mut self,
        this: &EventTarget,
        type: String,
        callback: EventListener,
        options: Option<AddEventListenerOptionsOrBool>,
    ) {
        let [capture, once] = match options {
            Some(AsBool(capture)) => [capture, false],
            Some(AsAddEventListenerOptions(options)) => [
                options.capture.unwrap_or(false),
                options.once.unwrap_or(false),
            ],
            null => [false, false],
        };
        self.own(*this).listeners.push(Listener { type, capture, once, callback });
        resume ();
    }

    fn dispatch_event(&mut self, this: &EventTarget, event: Event) -> bool {
        let target = *this;
        self.own(target);
        let path = self.event_path(target);
        let dispatched = surface_event(event);
        dispatched.target = Option::Some(target);
        dispatched.path = path;
        for let mut i = path.len() - 1; i >= 0; i -= 1 {
            self.invoke(path[i], event, true);
        }
        self.invoke(target, event, false);
        if dispatched.bubbles {
            for let i of 1..<path.len() {
                self.invoke(path[i], event, false);
            }
        }
        dispatched.path = [];
        resume true;
    }

    ..trap
}

impl Event for SurfaceDom {
    fn new(&mut self, type: String, event_init_dict: Option<EventInit>) -> Event {
        let init = event_init_dict.unwrap_or(EventInit {});
        resume Event::backed_by(SurfaceEvent {
            type,
            bubbles: init.bubbles.unwrap_or(false),
            cancelable: init.cancelable.unwrap_or(false),
            composed: init.composed.unwrap_or(false),
            target: null,
            path: [],
        });
    }

    fn bubbles(&mut self, this: &Event) -> bool {
        resume surface_event(*this).bubbles;
    }

    fn cancelable(&mut self, this: &Event) -> bool {
        resume surface_event(*this).cancelable;
    }

    fn composed(&mut self, this: &Event) -> bool {
        resume surface_event(*this).composed;
    }

    fn composed_path(&mut self, this: &Event) -> List<EventTarget> {
        resume surface_event(*this).path;
    }

    fn type(&mut self, this: &Event) -> String {
        resume surface_event(*this).type;
    }

    fn target(&mut self, this: &Event) -> Option<EventTarget> {
        resume surface_event(*this).target;
    }

    ..trap
}

impl Document for SurfaceDom {
    fn create_element(
        &mut self,
        this: &Document,
        local_name: String,
        options: Option<StringOrElementCreationOptions>,
    ) -> Element {
        self.own(*this);
        assert is_valid_element_local_name(&local_name), "InvalidCharacterError: not a valid element name";
        resume self.new_element(local_name.to_ascii_lowercase());
    }

    fn create_text_node(&mut self, this: &Document, data: String) -> Text {
        self.own(*this);
        resume self.new_text(data);
    }

    fn document_element(&mut self, this: &Document) -> Option<Element> {
        self.own(*this);
        resume element_of(child_named(self.document, "html"));
    }

    fn body(&mut self, this: &Document) -> Option<HtmlElement> {
        self.own(*this);
        resume match self.html_child("body") {
            Some(body: HtmlElement) => Option::Some(body),
            _ => null,
        };
    }

    fn get_element_by_id(&mut self, this: &Document, element_id: String) -> Option<Element> {
        self.own(*this);
        resume element_of(first_inclusive_descendant_where(
            self.document,
            |n| !element_id.is_empty() && n.attributes.get("id") == Option::Some(element_id),
        ));
    }

    fn title(&mut self, this: &Document) -> String {
        self.own(*this);
        let mut text = "";
        if let Some(title) = self.title_element() {
            for let child of children(title) {
                if let Text(data) = surface_node(child).content {
                    text.push_str(&data);
                }
            }
        }
        resume strip_and_collapse_ascii_whitespace(&text);
    }

    fn set_title(&mut self, this: &Document, value: String) {
        self.own(*this);
        let mut title = self.title_element();
        if title == null && let Some(head) = self.html_child("head") {
            let made = self.new_element("title");
            append(head, made);
            title = Option::Some(made);
        }
        if let Some(title) = title {
            self.replace_all_text(title, value);
        }
        resume ();
    }

    // Nothing loads the document: it is whole from the start.
    fn ready_state(&mut self, this: &Document) -> DocumentReadyState {
        self.own(*this);
        resume DocumentReadyState::Complete;
    }

    // Nothing shows it either.
    fn visibility_state(&mut self, this: &Document) -> DocumentVisibilityState {
        self.own(*this);
        resume DocumentVisibilityState::Hidden;
    }

    fn exit_fullscreen(&mut self, this: &Document) -> Result<(), Rejection> {
        self.own(*this);
        resume Result::Err(fullscreen_unsupported());
    }

    ..trap
}

impl Rejection for SurfaceDom {
    fn name(&mut self, this: &Rejection) -> String {
        resume surface_rejection(*this).name;
    }

    fn message(&mut self, this: &Rejection) -> String {
        resume surface_rejection(*this).message;
    }

    ..trap
}

impl Node for SurfaceDom {
    fn node_type(&mut self, this: &Node) -> u16 {
        resume match self.own(*this).content {
            Element(_) => 1,
            Text(_) => 3,
            _::Document => 9,
            _::Doctype => 10,
            _::Window => unreachable(),
        };
    }

    fn node_name(&mut self, this: &Node) -> String {
        resume match self.own(*this).content {
            Element(name) => name.to_ascii_uppercase(),
            Text(_) => "#text",
            _::Document => "#document",
            _::Doctype => "html",
            _::Window => unreachable(),
        };
    }

    fn parent_node(&mut self, this: &Node) -> Option<Node> {
        resume self.own(*this).parent;
    }

    fn parent_element(&mut self, this: &Node) -> Option<Element> {
        resume element_of(self.own(*this).parent);
    }

    fn has_child_nodes(&mut self, this: &Node) -> bool {
        resume self.own(*this).first_child != null;
    }

    fn first_child(&mut self, this: &Node) -> Option<Node> {
        resume self.own(*this).first_child;
    }

    fn last_child(&mut self, this: &Node) -> Option<Node> {
        resume self.own(*this).last_child;
    }

    fn previous_sibling(&mut self, this: &Node) -> Option<Node> {
        resume self.own(*this).previous_sibling;
    }

    fn next_sibling(&mut self, this: &Node) -> Option<Node> {
        resume self.own(*this).next_sibling;
    }

    fn text_content(&mut self, this: &Node) -> Option<String> {
        if self.own(*this).content matches { _::Document | _::Doctype } {
            resume null;
        } else {
            let mut text = "";
            text_of(*this, &mut text);
            resume Option::Some(text);
        }
    }

    fn set_text_content(&mut self, this: &Node, value: Option<String>) {
        let node = self.own(*this);
        let text = value.unwrap_or("");
        match node.content {
            _::Document | _::Window | _::Doctype => {
            },
            Text(_) => node.content = Content::Text(text),
            Element(_) => self.replace_all_text(*this, text),
        }
        resume ();
    }

    fn contains(&mut self, this: &Node, other: Option<Node>) -> bool {
        self.own(*this);
        let Some(other) = other else {
            resume false;
        };
        self.own(other);
        resume is_inclusive_ancestor(*this, other);
    }

    fn append_child(&mut self, this: &Node, node: Node) -> Node {
        self.own(*this);
        self.own(node);
        pre_insert(*this, node, null);
        resume node;
    }

    fn insert_before(&mut self, this: &Node, node: Node, child: Option<Node>) -> Node {
        self.own(*this);
        self.own(node);
        if let Some(reference) = child {
            self.own(reference);
        }
        pre_insert(*this, node, child);
        resume node;
    }

    fn remove_child(&mut self, this: &Node, child: Node) -> Node {
        self.own(*this);
        assert self.own(child).parent == Option::Some(*this), "NotFoundError: the node to remove is a child";
        detach(child);
        resume child;
    }

    fn replace_child(&mut self, this: &Node, node: Node, child: Node) -> Node {
        self.own(*this);
        self.own(node);
        self.own(child);
        assert_insertable(*this, node, Option::Some(child), true);
        let mut next = surface_node(child).next_sibling;
        if next == Option::Some(node) {
            next = surface_node(node).next_sibling;
        }
        detach(child);
        insert(*this, node, next);
        resume child;
    }

    ..trap
}

impl CharacterData for SurfaceDom {
    fn data(&mut self, this: &CharacterData) -> String {
        let Text(data) = self.own(*this).content else {
            unreachable();
        };
        resume data;
    }

    fn set_data(&mut self, this: &CharacterData, value: String) {
        self.own(*this).content = Content::Text(value);
        resume ();
    }

    ..trap
}

impl Text for SurfaceDom {
    fn new(&mut self, data: String) -> Text {
        resume self.new_text(data);
    }

    ..trap
}

impl Element for SurfaceDom {
    fn local_name(&mut self, this: &Element) -> String {
        resume self.local_name_of(*this);
    }

    fn tag_name(&mut self, this: &Element) -> String {
        resume self.local_name_of(*this).to_ascii_uppercase();
    }

    fn id(&mut self, this: &Element) -> String {
        resume self.own(*this).attributes.get("id").unwrap_or("");
    }

    fn set_id(&mut self, this: &Element, value: String) {
        self.own(*this).attributes["id"] = value;
        resume ();
    }

    fn get_attribute(&mut self, this: &Element, qualified_name: String) -> Option<String> {
        resume self.own(*this).attributes.get(qualified_name.to_ascii_lowercase());
    }

    fn set_attribute(&mut self, this: &Element, qualified_name: String, value: String) {
        assert is_valid_attribute_local_name(&qualified_name), "InvalidCharacterError: not a valid attribute name";
        write_attribute(self.own(*this), qualified_name.to_ascii_lowercase(), Option::Some(value));
        resume ();
    }

    fn get_attribute_names(&mut self, this: &Element) -> List<String> {
        resume self.own(*this).attributes.keys().map(|name| *name).collect();
    }

    fn has_attribute(&mut self, this: &Element, qualified_name: String) -> bool {
        resume self.own(*this).attributes.contains_key(qualified_name.to_ascii_lowercase());
    }

    fn remove_attribute(&mut self, this: &Element, qualified_name: String) {
        write_attribute(self.own(*this), qualified_name.to_ascii_lowercase(), null);
        resume ();
    }

    fn get_html(&mut self, this: &Element, options: Option<GetHtmlOptions>) -> String {
        self.own(*this);
        let mut html = "";
        serialize_children(*this, &mut html);
        resume html;
    }

    // Nothing is laid out, so there is nowhere to scroll.
    fn scroll_into_view(&mut self, this: &Element, arg: Option<BoolOrScrollIntoViewOptions>) -> Result<(), Rejection> {
        self.own(*this);
        resume Result::Ok(());
    }

    fn request_fullscreen(&mut self, this: &Element, options: Option<FullscreenOptions>) -> Result<(), Rejection> {
        self.own(*this);
        resume Result::Err(fullscreen_unsupported());
    }

    fn aria_controls_elements(&mut self, this: &Element) -> Option<List<Element>> {
        resume self.referenced_elements(*this, "aria-controls");
    }

    fn set_aria_controls_elements(&mut self, this: &Element, value: Option<List<Element>>) {
        self.set_referenced_elements(*this, "aria-controls", value);
        resume ();
    }

    fn aria_described_by_elements(&mut self, this: &Element) -> Option<List<Element>> {
        resume self.referenced_elements(*this, "aria-describedby");
    }

    fn set_aria_described_by_elements(&mut self, this: &Element, value: Option<List<Element>>) {
        self.set_referenced_elements(*this, "aria-describedby", value);
        resume ();
    }

    fn aria_details_elements(&mut self, this: &Element) -> Option<List<Element>> {
        resume self.referenced_elements(*this, "aria-details");
    }

    fn set_aria_details_elements(&mut self, this: &Element, value: Option<List<Element>>) {
        self.set_referenced_elements(*this, "aria-details", value);
        resume ();
    }

    fn aria_error_message_elements(&mut self, this: &Element) -> Option<List<Element>> {
        resume self.referenced_elements(*this, "aria-errormessage");
    }

    fn set_aria_error_message_elements(&mut self, this: &Element, value: Option<List<Element>>) {
        self.set_referenced_elements(*this, "aria-errormessage", value);
        resume ();
    }

    fn aria_flow_to_elements(&mut self, this: &Element) -> Option<List<Element>> {
        resume self.referenced_elements(*this, "aria-flowto");
    }

    fn set_aria_flow_to_elements(&mut self, this: &Element, value: Option<List<Element>>) {
        self.set_referenced_elements(*this, "aria-flowto", value);
        resume ();
    }

    fn aria_labelled_by_elements(&mut self, this: &Element) -> Option<List<Element>> {
        resume self.referenced_elements(*this, "aria-labelledby");
    }

    fn set_aria_labelled_by_elements(&mut self, this: &Element, value: Option<List<Element>>) {
        self.set_referenced_elements(*this, "aria-labelledby", value);
        resume ();
    }

    fn aria_owns_elements(&mut self, this: &Element) -> Option<List<Element>> {
        resume self.referenced_elements(*this, "aria-owns");
    }

    fn set_aria_owns_elements(&mut self, this: &Element, value: Option<List<Element>>) {
        self.set_referenced_elements(*this, "aria-owns", value);
        resume ();
    }

    ..trap
}

impl HtmlInputElement for SurfaceDom {
    fn value(&mut self, this: &HtmlInputElement) -> String {
        resume self.own(*this).value;
    }

    fn set_value(&mut self, this: &HtmlInputElement, value: String) {
        self.own(*this).value = value;
        resume ();
    }

    ..trap
}
