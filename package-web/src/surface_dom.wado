//! The DOM's API surface without a browser engine behind it, answering the
//! calls where no browser runs: `with &mut dom do { app(); }`.

use { TreeMap } from "core:collections";
use {
    Document,
    Dom,
    Element,
    Event,
    EventTarget,
    HtmlElement,
    HtmlInputElement,
    Node,
    Rejection,
    Window,
} from "./dom.wado";

global NO_NODE: i32 = -1;
global DOCUMENT_INDEX: i32 = 0;
global WINDOW_INDEX: i32 = 1;

variant Content {
    Document,
    Window,
    Doctype,
    Element(String),
    Text(String),
}

// Linked as the DOM standard models the tree. A node lives in its handle, and
// `index` is where the handle is kept.
struct SurfaceNode {
    index: i32,
    content: Content,
    attributes: TreeMap<String, String>,
    // The elements a reflected element reference was set to, by its attribute.
    referenced: TreeMap<String, List<i32>>,
    value: String,
    parent: i32,
    first_child: i32,
    last_child: i32,
    previous_sibling: i32,
    next_sibling: i32,
}

struct SurfaceEvent {
    type: String,
    target: i32,
    // Empty unless the event is being dispatched.
    path: List<i32>,
}

struct SurfaceRejection {
    name: String,
    message: String,
}

// The Fullscreen standard rejects with a `TypeError` where fullscreen is not
// supported, and no screen shows this document.
fn fullscreen_unsupported() -> Rejection {
    return Rejection::backed_by(SurfaceRejection { name: "TypeError", message: "fullscreen is not supported" });
}

fn surface_node(target: EventTarget) -> &mut SurfaceNode {
    return target.backing::<SurfaceNode>().expect("a node of a SurfaceDom backs the handle");
}

// The handle of each node, made once with the class of what the node is.
// `nodes[i]` is the node the handle holds.
struct SurfaceNodes {
    handles: List<EventTarget>,
}

impl SurfaceNodes {
    fn len(&self) -> i32 {
        return self.handles.len();
    }
}

impl IndexRef<i32> for SurfaceNodes {
    type Output = SurfaceNode;

    fn index_ref(&self, index: i32) -> &SurfaceNode {
        return surface_node(self.handles[index]);
    }
}

impl IndexRefMut<i32> for SurfaceNodes {
    type Output = SurfaceNode;

    fn index_ref_mut(&mut self, index: i32) -> &mut SurfaceNode {
        return surface_node(self.handles[index]);
    }
}

fn handle_holding(node: SurfaceNode) -> EventTarget {
    match node.content {
        Document => {
            return Document::backed_by(node);
        },
        Window => {
            return Window::backed_by(node);
        },
        Element(name) && name == "input" => {
            return HtmlInputElement::backed_by(node);
        },
        Element(_) => {
            return HtmlElement::backed_by(node);
        },
        // The slice has neither `DocumentType` nor `Text`, so these carry `Node`'s class.
        Doctype | Text(_) => {
            return Node::backed_by(node);
        },
    }
}

fn surface_rejection(rejection: Rejection) -> &mut SurfaceRejection {
    return rejection.backing::<SurfaceRejection>().expect("a rejection of a SurfaceDom backs the handle");
}

struct Listener {
    target: i32,
    type: String,
    capture: bool,
    callback: fn mut(Event) with Dom,
}

struct Children {
    nodes: &SurfaceNodes,
    at: i32,
}

impl Iterator for Children {
    type Item = i32;

    fn next(&mut self) -> Option<i32> {
        if self.at == NO_NODE {
            return null;
        }
        let child = self.at;
        self.at = self.nodes[child].next_sibling;
        return Option::Some(child);
    }
}

// Infra's ASCII whitespace leaves out the VT that `char::is_ascii_whitespace` counts.
fn is_infra_whitespace(c: char) -> bool {
    return c matches { '\t' | '\n' | '\u{C}' | '\r' | ' ' };
}

fn is_valid_element_local_name(name: &String) -> bool {
    let mut chars = name.chars();
    let Some(first) = chars.next() else {
        return false;
    };
    if first.is_ascii_alphabetic() {
        return !chars.any(|c| is_infra_whitespace(c) || c matches { '\0' | '/' | '>' });
    }
    let in_name = |c: char| c matches { ':' | '_' } || c as u32 >= 0x80;
    return in_name(first) && chars.all(|c| in_name(c) || c.is_ascii_alphanumeric() || c matches { '-' | '.' });
}

fn is_valid_attribute_local_name(name: &String) -> bool {
    return !name.is_empty() && !name.chars().any(|c| is_infra_whitespace(c) || c matches { '\0' | '/' | '=' | '>' });
}

fn is_void(local_name: &String) -> bool {
    return *local_name matches { "area" | "base" | "basefont" | "bgsound" | "br" | "col" | "embed" | "frame" | "hr" | "img" | "input" | "keygen" | "link" | "meta" | "param" | "source" | "track" | "wbr" };
}

// Scripting is disabled where no browser runs, so `noscript` is escaped.
fn is_raw_text(local_name: &String) -> bool {
    return *local_name matches { "style" | "script" | "xmp" | "iframe" | "noembed" | "noframes" | "plaintext" };
}

// The Infra standard's "split on ASCII whitespace".
fn split_on_ascii_whitespace(text: &String) -> List<String> {
    let mut tokens: List<String> = [];
    let mut token = "";
    for let c of text.chars() {
        if !is_infra_whitespace(c) {
            token.push(c);
        } else if !token.is_empty() {
            tokens.push(token);
            token = "";
        }
    }
    if !token.is_empty() {
        tokens.push(token);
    }
    return tokens;
}

// The HTML standard's "escaping a string".
fn escape(text: &String, in_attribute: bool, out: &mut String) {
    for let c of text.chars() {
        match c {
            '&' => out.push_str("&amp;"),
            '\u{A0}' => out.push_str("&nbsp;"),
            '<' => out.push_str("&lt;"),
            '>' => out.push_str("&gt;"),
            '"' && in_attribute => out.push_str("&quot;"),
            _ => out.push(c),
        }
    }
}

fn strip_and_collapse_ascii_whitespace(text: &String) -> String {
    let mut out = "";
    let mut gap = false;
    for let c of text.chars() {
        if is_infra_whitespace(c) {
            gap = !out.is_empty();
        } else {
            if gap {
                out.push(' ');
                gap = false;
            }
            out.push(c);
        }
    }
    return out;
}

/// A document of `<!DOCTYPE html><html><head></head><body></body></html>`, as
/// `createHTMLDocument()` makes, and the window holding it.
pub struct SurfaceDom {
    nodes: SurfaceNodes,
    listeners: List<Listener>,
}

impl SurfaceDom {
    pub fn new() -> SurfaceDom {
        let mut dom = SurfaceDom { nodes: SurfaceNodes { handles: [] }, listeners: [] };
        dom.push(Content::Document);
        dom.push(Content::Window);
        dom.append(DOCUMENT_INDEX, dom.push(Content::Doctype));
        let html = dom.create("html");
        dom.append(DOCUMENT_INDEX, html);
        dom.append(html, dom.create("head"));
        dom.append(html, dom.create("body"));
        return dom;
    }

    /// The document as HTML, doctype included.
    pub fn to_html(&self) -> String {
        let mut html = "";
        self.serialize_children(DOCUMENT_INDEX, &mut html);
        return html;
    }

    fn push(&mut self, content: Content) -> i32 {
        let index = self.nodes.len();
        self.nodes.handles.push(handle_holding(SurfaceNode {
            index,
            content,
            attributes: TreeMap::new(),
            referenced: TreeMap::new(),
            value: "",
            parent: NO_NODE,
            first_child: NO_NODE,
            last_child: NO_NODE,
            previous_sibling: NO_NODE,
            next_sibling: NO_NODE,
        }));
        return index;
    }

    fn create(&mut self, local_name: String) -> i32 {
        return self.push(Content::Element(local_name));
    }

    // Every event target is a node here, the window included.
    fn target_handle(&self, index: i32) -> EventTarget {
        return self.nodes.handles[index];
    }

    fn node_handle(&self, index: i32) -> Node {
        let node: Node = self.target_handle(index) else {
            panic("the window is no node");
        };
        return node;
    }

    fn element_handle(&self, index: i32) -> HtmlElement {
        let element: HtmlElement = self.target_handle(index) else {
            panic("the node is an element");
        };
        return element;
    }

    fn document_handle(&self) -> Document {
        let document: Document = self.target_handle(DOCUMENT_INDEX) else {
            unreachable();
        };
        return document;
    }

    fn index(&self, target: EventTarget) -> i32 {
        let index = surface_node(target).index;
        assert index < self.nodes.len() && self.target_handle(index) == target, "the handle is of this SurfaceDom";
        return index;
    }

    fn surface_event(&self, event: Event) -> &mut SurfaceEvent {
        return event.backing::<SurfaceEvent>().expect("an event of a SurfaceDom backs the handle");
    }

    // The DOM standard's event path, which reaches the window from the document.
    fn event_path(&self, target: i32) -> List<i32> {
        let mut path: List<i32> = [];
        let mut at = target;
        while at != NO_NODE {
            path.push(at);
            at = if at == DOCUMENT_INDEX { WINDOW_INDEX } else { self.nodes[at].parent };
        }
        return path;
    }

    // Runs with this DOM reinstalled, since a listener is a program calling back
    // into it. A listener added meanwhile waits for the next dispatch.
    fn invoke(&mut self, target: i32, event: Event, capture: bool) {
        let type = &self.surface_event(event).type;
        let mut callbacks: List<fn mut(Event) with Dom> = [];
        for let listener of &self.listeners {
            if listener.target == target && listener.capture == capture && listener.type == *type {
                callbacks.push(listener.callback);
            }
        }
        for let mut callback of callbacks {
            with &mut *self do {
                callback(event);
            };
        }
    }

    fn node(&self, index: i32) -> Option<Node> {
        if index == NO_NODE {
            return null;
        }
        return Option::Some(self.node_handle(index));
    }

    fn local_name_of(&self, element: Element) -> String {
        let Element(name) = self.nodes[self.index(element)].content else {
            unreachable();
        };
        return name;
    }

    fn element(&self, index: i32) -> Option<Element> {
        if index == NO_NODE || !self.nodes[index].content matches { Element(_) } {
            return null;
        }
        return Option::Some(self.element_handle(index));
    }

    fn is_inclusive_ancestor(&self, ancestor: i32, index: i32) -> bool {
        let mut at = index;
        while at != NO_NODE && at != ancestor {
            at = self.nodes[at].parent;
        }
        return at == ancestor;
    }

    fn root_of(&self, index: i32) -> i32 {
        let mut at = index;
        while self.nodes[at].parent != NO_NODE {
            at = self.nodes[at].parent;
        }
        return at;
    }

    // Writes an element's attribute, or removes it for `null`. Either forgets
    // the elements a reference was set to under that name.
    fn write_attribute(&mut self, index: i32, name: String, value: Option<String>) {
        let node = &mut self.nodes[index];
        node.referenced.remove(name);
        if let Some(value) = value {
            node.attributes[name] = value;
        } else {
            node.attributes.remove(name);
        }
    }

    // The HTML standard's attr-associated elements of a reflected element
    // reference: the elements set, or else those its attribute names by id.
    fn referenced_elements(&self, index: i32, attribute: String) -> Option<List<Element>> {
        let node = &self.nodes[index];
        let root = self.root_of(index);
        let mut found: List<Element> = [];
        if let Some(targets) = node.referenced.get(attribute) {
            // Only a descendant of one of the element's ancestors counts.
            for let target of targets {
                if root != index && target != root && self.root_of(target) == root {
                    found.push(self.element_handle(target));
                }
            }
            return Option::Some(found);
        }
        let Some(ids) = node.attributes.get(attribute) else {
            return null;
        };
        for let id of split_on_ascii_whitespace(&ids) {
            let target = self.first_inclusive_descendant_where(root, |n| n.content matches { Element(_) }
                && n.attributes.get("id") == Option::Some(id));
            if target != NO_NODE {
                found.push(self.element_handle(target));
            }
        }
        return Option::Some(found);
    }

    fn set_referenced_elements(&mut self, index: i32, attribute: String, elements: Option<List<Element>>) {
        let Some(elements) = elements else {
            self.write_attribute(index, attribute, null);
            return;
        };
        self.write_attribute(index, attribute, Option::Some(""));
        let mut targets: List<i32> = [];
        for let element of elements {
            targets.push(self.index(element));
        }
        self.nodes[index].referenced[attribute] = targets;
    }

    fn children(&self, parent: i32) -> Children {
        return Children { nodes: &self.nodes, at: self.nodes[parent].first_child };
    }

    fn child_where(&self, parent: i32, accept: fn(&SurfaceNode) -> bool) -> i32 {
        return self.children(parent).find(|child| accept(&self.nodes[child])).unwrap_or(NO_NODE);
    }

    fn first_inclusive_descendant_where(&self, index: i32, accept: fn(&SurfaceNode) -> bool) -> i32 {
        if accept(&self.nodes[index]) {
            return index;
        }
        for let child of self.children(index) {
            let found = self.first_inclusive_descendant_where(child, accept);
            if found != NO_NODE {
                return found;
            }
        }
        return NO_NODE;
    }

    // The DOM standard's pre-insertion validity; a DOM exception traps (Web WEP, Exceptions).
    fn assert_insertable(&self, parent: i32, node: i32) {
        let into_document = self.nodes[parent].content matches { Document };
        assert into_document || self.nodes[parent].content matches { Element(_) }, "HierarchyRequestError: only a document or an element holds children";
        assert !self.is_inclusive_ancestor(node, parent), "HierarchyRequestError: a node cannot be inserted into itself or its descendant";
        match self.nodes[node].content {
            Document | Window => panic("HierarchyRequestError: a document or a window is never a child"),
            Doctype => {
                assert into_document, "HierarchyRequestError: only a document holds a doctype";
                assert self.child_where(parent, |n| n.content matches { Doctype }) == NO_NODE, "HierarchyRequestError: a document holds one doctype";
                assert self.child_where(parent, |n| n.content matches { Element(_) }) == NO_NODE, "HierarchyRequestError: a doctype precedes the element";
            },
            Text(_) => {
                assert !into_document, "HierarchyRequestError: a document holds no text";
            },
            Element(_) => {
                assert !into_document || self.child_where(parent, |n| n.content matches { Element(_) }) == NO_NODE, "HierarchyRequestError: a document holds one element";
            },
        }
    }

    fn serialize_children(&self, parent: i32, out: &mut String) {
        if self.nodes[parent].content matches { Element(name) && is_void(&name) } {
            return;
        }
        let raw_text = self.nodes[parent].content matches { Element(name) && is_raw_text(&name) };
        for let child of self.children(parent) {
            match self.nodes[child].content {
                Document | Window => unreachable(),
                Doctype => out.push_str("<!DOCTYPE html>"),
                Text(text) => {
                    if raw_text {
                        out.push_str(&text);
                    } else {
                        escape(&text, false, out);
                    }
                },
                Element(name) => {
                    out.push_str(`<${name}`);
                    for let [key, value] of self.nodes[child].attributes.entries() {
                        out.push_str(` ${key}="`);
                        escape(value, true, out);
                        out.push('"');
                    }
                    out.push('>');
                    self.serialize_children(child, out);
                    if !is_void(&name) {
                        out.push_str(`</${name}>`);
                    }
                },
            }
        }
    }

    fn detach(&mut self, child: i32) {
        let parent = self.nodes[child].parent;
        if parent == NO_NODE {
            return;
        }
        let previous = self.nodes[child].previous_sibling;
        let next = self.nodes[child].next_sibling;
        if previous == NO_NODE {
            self.nodes[parent].first_child = next;
        } else {
            self.nodes[previous].next_sibling = next;
        }
        if next == NO_NODE {
            self.nodes[parent].last_child = previous;
        } else {
            self.nodes[next].previous_sibling = previous;
        }
        self.nodes[child].parent = NO_NODE;
        self.nodes[child].previous_sibling = NO_NODE;
        self.nodes[child].next_sibling = NO_NODE;
    }

    fn append(&mut self, parent: i32, child: i32) {
        self.detach(child);
        let last = self.nodes[parent].last_child;
        if last == NO_NODE {
            self.nodes[parent].first_child = child;
        } else {
            self.nodes[last].next_sibling = child;
        }
        self.nodes[child].previous_sibling = last;
        self.nodes[parent].last_child = child;
        self.nodes[child].parent = parent;
    }

    fn remove_children(&mut self, parent: i32) {
        while self.nodes[parent].first_child != NO_NODE {
            self.detach(self.nodes[parent].first_child);
        }
    }

    fn text_of(&self, index: i32, out: &mut String) {
        if let Text(text) = self.nodes[index].content {
            out.push_str(&text);
        }
        for let child of self.children(index) {
            self.text_of(child, out);
        }
    }

    fn title_index(&self) -> i32 {
        return self.first_inclusive_descendant_where(
            DOCUMENT_INDEX,
            |n| n.content matches { Element(name) && name == "title" },
        );
    }

    fn replace_all_text(&mut self, index: i32, text: String) {
        self.remove_children(index);
        if !text.is_empty() {
            self.append(index, self.push(Content::Text(text)));
        }
    }

    fn child_named(&self, parent: i32, local_name: String) -> i32 {
        return self.child_where(parent, |n| n.content matches { Element(name) && name == local_name });
    }

    fn html_child(&self, local_name: String) -> i32 {
        let html = self.child_named(DOCUMENT_INDEX, "html");
        if html == NO_NODE {
            return NO_NODE;
        }
        return self.child_named(html, local_name);
    }
}

impl Dom for SurfaceDom {
    fn window(&mut self) -> Window {
        let window: Window = self.target_handle(WINDOW_INDEX) else {
            unreachable();
        };
        resume window;
    }

    fn document(&mut self) -> Document {
        resume self.document_handle();
    }
}

impl Window for SurfaceDom {
    fn document(&mut self, this: &Window) -> Document {
        resume self.document_handle();
    }

    ..trap
}

// No event bubbles: `bubbles` is set only through `EventInit`, which the slice
// leaves out.
impl EventTarget for SurfaceDom {
    fn add_event_listener(
        &mut self,
        this: &EventTarget,
        type: String,
        callback: fn mut(Event) with Dom,
        options: Option<bool>,
    ) {
        self.listeners.push(Listener {
            target: self.index(*this),
            type,
            capture: options.unwrap_or(false),
            callback,
        });
        resume ();
    }

    fn dispatch_event(&mut self, this: &EventTarget, event: Event) -> bool {
        let target = self.index(*this);
        let path = self.event_path(target);
        let dispatched = self.surface_event(event);
        dispatched.target = target;
        dispatched.path = path;
        for let mut i = path.len() - 1; i >= 0; i -= 1 {
            self.invoke(path[i], event, true);
        }
        self.invoke(target, event, false);
        dispatched.path = [];
        resume true;
    }

    ..trap
}

impl Event for SurfaceDom {
    fn new(&mut self, type: String) -> Event {
        resume Event::backed_by(SurfaceEvent { type, target: NO_NODE, path: [] });
    }

    fn composed_path(&mut self, this: &Event) -> List<EventTarget> {
        let mut path: List<EventTarget> = [];
        for let index of self.surface_event(*this).path {
            path.push(self.target_handle(index));
        }
        resume path;
    }

    fn type(&mut self, this: &Event) -> String {
        resume self.surface_event(*this).type;
    }

    fn target(&mut self, this: &Event) -> Option<EventTarget> {
        let target = self.surface_event(*this).target;
        if target == NO_NODE {
            resume null;
        } else {
            resume Option::Some(self.target_handle(target));
        }
    }

    ..trap
}

impl Document for SurfaceDom {
    fn create_element(&mut self, this: &Document, local_name: String, options: Option<String>) -> Element {
        assert is_valid_element_local_name(&local_name), "InvalidCharacterError: not a valid element name";
        resume self.element_handle(self.create(local_name.to_ascii_lowercase()));
    }

    fn document_element(&mut self, this: &Document) -> Option<Element> {
        resume self.element(self.child_named(DOCUMENT_INDEX, "html"));
    }

    fn body(&mut self, this: &Document) -> Option<HtmlElement> {
        let body = self.html_child("body");
        if body == NO_NODE {
            resume null;
        } else {
            resume Option::Some(self.element_handle(body));
        }
    }

    fn get_element_by_id(&mut self, this: &Document, element_id: String) -> Option<Element> {
        resume self.element(self.first_inclusive_descendant_where(DOCUMENT_INDEX, |n| !element_id.is_empty()
            && n.attributes.get("id") == Option::Some(element_id)));
    }

    fn title(&mut self, this: &Document) -> String {
        let title = self.title_index();
        let mut text = "";
        if title != NO_NODE {
            for let child of self.children(title) {
                if let Text(data) = self.nodes[child].content {
                    text.push_str(&data);
                }
            }
        }
        resume strip_and_collapse_ascii_whitespace(&text);
    }

    fn set_title(&mut self, this: &Document, value: String) {
        let mut title = self.title_index();
        let head = self.html_child("head");
        if title == NO_NODE && head != NO_NODE {
            title = self.create("title");
            self.append(head, title);
        }
        if title != NO_NODE {
            self.replace_all_text(title, value);
        }
        resume ();
    }

    fn exit_fullscreen(&mut self, this: &Document) -> Result<(), Rejection> {
        resume Result::Err(fullscreen_unsupported());
    }

    ..trap
}

impl Rejection for SurfaceDom {
    fn name(&mut self, this: &Rejection) -> String {
        resume surface_rejection(*this).name;
    }

    fn message(&mut self, this: &Rejection) -> String {
        resume surface_rejection(*this).message;
    }

    ..trap
}

impl Node for SurfaceDom {
    fn node_type(&mut self, this: &Node) -> u16 {
        resume match self.nodes[self.index(*this)].content {
            Element(_) => 1,
            Text(_) => 3,
            Document => 9,
            Doctype => 10,
            Window => unreachable(),
        };
    }

    fn node_name(&mut self, this: &Node) -> String {
        resume match self.nodes[self.index(*this)].content {
            Element(name) => name.to_ascii_uppercase(),
            Text(_) => "#text",
            Document => "#document",
            Doctype => "html",
            Window => unreachable(),
        };
    }

    fn parent_node(&mut self, this: &Node) -> Option<Node> {
        resume self.node(self.nodes[self.index(*this)].parent);
    }

    fn parent_element(&mut self, this: &Node) -> Option<Element> {
        resume self.element(self.nodes[self.index(*this)].parent);
    }

    fn has_child_nodes(&mut self, this: &Node) -> bool {
        resume self.nodes[self.index(*this)].first_child != NO_NODE;
    }

    fn first_child(&mut self, this: &Node) -> Option<Node> {
        resume self.node(self.nodes[self.index(*this)].first_child);
    }

    fn last_child(&mut self, this: &Node) -> Option<Node> {
        resume self.node(self.nodes[self.index(*this)].last_child);
    }

    fn previous_sibling(&mut self, this: &Node) -> Option<Node> {
        resume self.node(self.nodes[self.index(*this)].previous_sibling);
    }

    fn next_sibling(&mut self, this: &Node) -> Option<Node> {
        resume self.node(self.nodes[self.index(*this)].next_sibling);
    }

    fn text_content(&mut self, this: &Node) -> Option<String> {
        let index = self.index(*this);
        if self.nodes[index].content matches { Document | Doctype } {
            resume null;
        } else {
            let mut text = "";
            self.text_of(index, &mut text);
            resume Option::Some(text);
        }
    }

    fn set_text_content(&mut self, this: &Node, value: Option<String>) {
        let index = self.index(*this);
        let text = value.unwrap_or("");
        match self.nodes[index].content {
            Document | Window | Doctype => {
            },
            Text(_) => self.nodes[index].content = Content::Text(text),
            Element(_) => self.replace_all_text(index, text),
        }
        resume ();
    }

    fn contains(&mut self, this: &Node, other: Option<Node>) -> bool {
        let Some(other) = other else {
            resume false;
        };
        resume self.is_inclusive_ancestor(self.index(*this), self.index(other));
    }

    fn append_child(&mut self, this: &Node, node: Node) -> Node {
        let parent = self.index(*this);
        let child = self.index(node);
        self.assert_insertable(parent, child);
        self.append(parent, child);
        resume node;
    }

    fn remove_child(&mut self, this: &Node, child: Node) -> Node {
        let index = self.index(child);
        assert self.nodes[index].parent == self.index(*this), "NotFoundError: the node to remove is a child";
        self.detach(index);
        resume child;
    }

    ..trap
}

impl Element for SurfaceDom {
    fn local_name(&mut self, this: &Element) -> String {
        resume self.local_name_of(*this);
    }

    fn tag_name(&mut self, this: &Element) -> String {
        resume self.local_name_of(*this).to_ascii_uppercase();
    }

    fn id(&mut self, this: &Element) -> String {
        resume self.nodes[self.index(*this)].attributes.get("id").unwrap_or("");
    }

    fn set_id(&mut self, this: &Element, value: String) {
        let index = self.index(*this);
        self.nodes[index].attributes["id"] = value;
        resume ();
    }

    fn get_attribute(&mut self, this: &Element, qualified_name: String) -> Option<String> {
        resume self.nodes[self.index(*this)].attributes.get(qualified_name.to_ascii_lowercase());
    }

    fn set_attribute(&mut self, this: &Element, qualified_name: String, value: String) {
        assert is_valid_attribute_local_name(&qualified_name), "InvalidCharacterError: not a valid attribute name";
        self.write_attribute(self.index(*this), qualified_name.to_ascii_lowercase(), Option::Some(value));
        resume ();
    }

    fn get_attribute_names(&mut self, this: &Element) -> List<String> {
        resume self.nodes[self.index(*this)].attributes.keys().map(|name| *name).collect();
    }

    fn has_attribute(&mut self, this: &Element, qualified_name: String) -> bool {
        resume self.nodes[self.index(*this)].attributes.contains_key(qualified_name.to_ascii_lowercase());
    }

    fn remove_attribute(&mut self, this: &Element, qualified_name: String) {
        self.write_attribute(self.index(*this), qualified_name.to_ascii_lowercase(), null);
        resume ();
    }

    fn get_html(&mut self, this: &Element) -> String {
        let mut html = "";
        self.serialize_children(self.index(*this), &mut html);
        resume html;
    }

    // Nothing is laid out, so there is nowhere to scroll.
    fn scroll_into_view(&mut self, this: &Element, arg: Option<bool>) -> Result<(), Rejection> {
        resume Result::Ok(());
    }

    fn request_fullscreen(&mut self, this: &Element) -> Result<(), Rejection> {
        resume Result::Err(fullscreen_unsupported());
    }

    fn aria_controls_elements(&mut self, this: &Element) -> Option<List<Element>> {
        resume self.referenced_elements(self.index(*this), "aria-controls");
    }

    fn set_aria_controls_elements(&mut self, this: &Element, value: Option<List<Element>>) {
        self.set_referenced_elements(self.index(*this), "aria-controls", value);
        resume ();
    }

    fn aria_described_by_elements(&mut self, this: &Element) -> Option<List<Element>> {
        resume self.referenced_elements(self.index(*this), "aria-describedby");
    }

    fn set_aria_described_by_elements(&mut self, this: &Element, value: Option<List<Element>>) {
        self.set_referenced_elements(self.index(*this), "aria-describedby", value);
        resume ();
    }

    fn aria_details_elements(&mut self, this: &Element) -> Option<List<Element>> {
        resume self.referenced_elements(self.index(*this), "aria-details");
    }

    fn set_aria_details_elements(&mut self, this: &Element, value: Option<List<Element>>) {
        self.set_referenced_elements(self.index(*this), "aria-details", value);
        resume ();
    }

    fn aria_error_message_elements(&mut self, this: &Element) -> Option<List<Element>> {
        resume self.referenced_elements(self.index(*this), "aria-errormessage");
    }

    fn set_aria_error_message_elements(&mut self, this: &Element, value: Option<List<Element>>) {
        self.set_referenced_elements(self.index(*this), "aria-errormessage", value);
        resume ();
    }

    fn aria_flow_to_elements(&mut self, this: &Element) -> Option<List<Element>> {
        resume self.referenced_elements(self.index(*this), "aria-flowto");
    }

    fn set_aria_flow_to_elements(&mut self, this: &Element, value: Option<List<Element>>) {
        self.set_referenced_elements(self.index(*this), "aria-flowto", value);
        resume ();
    }

    fn aria_labelled_by_elements(&mut self, this: &Element) -> Option<List<Element>> {
        resume self.referenced_elements(self.index(*this), "aria-labelledby");
    }

    fn set_aria_labelled_by_elements(&mut self, this: &Element, value: Option<List<Element>>) {
        self.set_referenced_elements(self.index(*this), "aria-labelledby", value);
        resume ();
    }

    fn aria_owns_elements(&mut self, this: &Element) -> Option<List<Element>> {
        resume self.referenced_elements(self.index(*this), "aria-owns");
    }

    fn set_aria_owns_elements(&mut self, this: &Element, value: Option<List<Element>>) {
        self.set_referenced_elements(self.index(*this), "aria-owns", value);
        resume ();
    }

    ..trap
}

impl HtmlInputElement for SurfaceDom {
    fn value(&mut self, this: &HtmlInputElement) -> String {
        resume self.nodes[self.index(*this)].value;
    }

    fn set_value(&mut self, this: &HtmlInputElement, value: String) {
        let index = self.index(*this);
        self.nodes[index].value = value;
        resume ();
    }

    ..trap
}
