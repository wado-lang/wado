//! Web platform bindings, and a DOM for where no browser runs.

pub use {
    AddEventListenerOptions,
    AddEventListenerOptionsOrBool,
    AriaNotificationOptions,
    AriaNotifyPriority,
    BoolOrF64OrString,
    BoolOrImportNodeOptions,
    BoolOrScrollIntoViewOptions,
    CharacterData,
    CheckVisibilityOptions,
    Document,
    DocumentReadyState,
    DocumentVisibilityState,
    Dom,
    Element,
    ElementCreationOptions,
    Event,
    EventInit,
    EventListener,
    EventListenerOptions,
    EventListenerOptionsOrBool,
    EventTarget,
    FocusOptions,
    FocusableAreaSearchMode,
    FocusableAreasOption,
    FullscreenKeyboardLock,
    FullscreenNavigationUi,
    FullscreenOptions,
    GetHtmlOptions,
    GetRootNodeOptions,
    HtmlElement,
    HtmlInputElement,
    ImportNodeOptions,
    Node,
    NodeFilter,
    NodeOrString,
    PointerLockOptions,
    Rejection,
    ScrollBehavior,
    ScrollIntoViewContainer,
    ScrollIntoViewOptions,
    ScrollLogicalPosition,
    SetHtmlUnsafeOptions,
    ShowPopoverOptions,
    SpatialNavigationDirection,
    SpatialNavigationSearchOptions,
    StringOrElementCreationOptions,
    Text,
    TogglePopoverOptions,
    TogglePopoverOptionsOrBool,
    Window,
} from "./dom.wado";
pub use { SurfaceDom } from "./surface_dom.wado";

#[synopsis]
test {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let greeting = doc.create_element("p");
        greeting.set_text_content(Option::Some("Hello, Wado!"));
        doc.body().unwrap().append_child(greeting);
        assert doc.body().unwrap().text_content() == Option::Some("Hello, Wado!");
    };
}
