//! A DOM held in memory, which answers the `web:dom` calls a program makes where
//! no browser does: `with &mut dom do { app(); }`.

use { TreeMap } from "core:collections";
use { Document, Dom, Element, HtmlElement, HtmlInputElement, Node, Window } from "./dom.wado";

// The classes `dom.wado` numbers. A text node has no class of its own in the
// slice, so it carries `Node`'s.
global NODE: f64 = 1.0;
global HTML_ELEMENT: f64 = 3.0;
global HTML_INPUT_ELEMENT: f64 = 4.0;
global DOCUMENT: f64 = 5.0;
global WINDOW: f64 = 6.0;
global CLASS_STRIDE: f64 = 137438953472.0;

global NO_PARENT: i32 = -1;
global DOCUMENT_INDEX: i32 = 0;
global WINDOW_INDEX: i32 = 1;

variant Content {
    Document,
    Window,
    Element(String),
    Text(String),
}

struct FakeNode {
    class: f64,
    content: Content,
    attributes: TreeMap<String, String>,
    value: String,
    parent: i32,
    children: List<i32>,
}

/// A document of `<html><head></head><body></body></html>`, and the window
/// holding it.
pub struct FakeDom {
    nodes: List<FakeNode>,
}

impl FakeDom {
    pub fn new() -> FakeDom {
        let mut dom = FakeDom { nodes: [] };
        dom.push(DOCUMENT, Content::Document);
        dom.push(WINDOW, Content::Window);
        let html = dom.create("html");
        dom.append(DOCUMENT_INDEX, html);
        dom.append(html, dom.create("head"));
        dom.append(html, dom.create("body"));
        return dom;
    }

    fn push(&mut self, class: f64, content: Content) -> i32 {
        self.nodes.push(FakeNode {
            class,
            content,
            attributes: TreeMap::new(),
            value: "",
            parent: NO_PARENT,
            children: [],
        });
        return self.nodes.len() - 1;
    }

    fn create(&mut self, local_name: String) -> i32 {
        let class = if local_name == "input" { HTML_INPUT_ELEMENT } else { HTML_ELEMENT };
        return self.push(class, Content::Element(local_name));
    }

    fn handle(&self, index: i32) -> f64 {
        return self.nodes[index].class * CLASS_STRIDE + index as f64;
    }

    fn index(&self, handle: f64) -> i32 {
        let index = f64::fmod(handle, CLASS_STRIDE) as i32;
        assert index < self.nodes.len() && self.handle(index) == handle;
        return index;
    }

    fn node(&self, index: i32) -> Option<Node> {
        if index == NO_PARENT {
            return null;
        }
        return Option::Some(self.handle(index) as Node);
    }

    fn element(&self, index: i32) -> Option<Element> {
        if index == NO_PARENT || !self.nodes[index].content matches { Element(_) } {
            return null;
        }
        return Option::Some(self.handle(index) as Element);
    }

    fn detach(&mut self, child: i32) {
        let parent = self.nodes[child].parent;
        if parent == NO_PARENT {
            return;
        }
        let at = self.position(parent, child);
        self.nodes[parent].children.remove(at);
        self.nodes[child].parent = NO_PARENT;
    }

    fn append(&mut self, parent: i32, child: i32) {
        self.detach(child);
        self.nodes[parent].children.push(child);
        self.nodes[child].parent = parent;
    }

    fn position(&self, parent: i32, child: i32) -> i32 {
        let siblings = self.nodes[parent].children;
        for let i of 0..<siblings.len() {
            if siblings[i] == child {
                return i;
            }
        }
        panic("a child is among its parent's children");
    }

    fn sibling(&self, index: i32, offset: i32) -> Option<Node> {
        let parent = self.nodes[index].parent;
        if parent == NO_PARENT {
            return null;
        }
        let siblings = self.nodes[parent].children;
        let at = self.position(parent, index) + offset;
        if at < 0 || at >= siblings.len() {
            return null;
        }
        return self.node(siblings[at]);
    }

    fn text_of(&self, index: i32, out: &mut String) {
        if let Text(text) = self.nodes[index].content {
            out.push_str(&text);
        }
        for let child of self.nodes[index].children {
            self.text_of(child, out);
        }
    }

    fn find_id(&self, index: i32, id: &String) -> i32 {
        if self.nodes[index].attributes.get("id") == Option::Some(*id) {
            return index;
        }
        for let child of self.nodes[index].children {
            let found = self.find_id(child, id);
            if found != NO_PARENT {
                return found;
            }
        }
        return NO_PARENT;
    }

    fn child_named(&self, parent: i32, local_name: String) -> i32 {
        for let child of self.nodes[parent].children {
            if let Element(name) = self.nodes[child].content && name == local_name {
                return child;
            }
        }
        return NO_PARENT;
    }

    fn body_index(&self) -> i32 {
        let html = self.child_named(DOCUMENT_INDEX, "html");
        if html == NO_PARENT {
            return NO_PARENT;
        }
        return self.child_named(html, "body");
    }
}

impl Dom for FakeDom {
    fn window(&mut self) -> Window {
        resume self.handle(WINDOW_INDEX) as Window;
    }

    fn document(&mut self) -> Document {
        resume self.handle(DOCUMENT_INDEX) as Document;
    }
}

impl Window for FakeDom {
    fn document(&mut self, this: &Window) -> Document {
        resume self.handle(DOCUMENT_INDEX) as Document;
    }

    ..trap
}

impl Document for FakeDom {
    fn create_element(&mut self, this: &Document, local_name: String, options: Option<String>) -> Element {
        resume self.handle(self.create(local_name.to_ascii_lowercase())) as Element;
    }

    fn document_element(&mut self, this: &Document) -> Option<Element> {
        resume self.element(self.child_named(DOCUMENT_INDEX, "html"));
    }

    fn body(&mut self, this: &Document) -> Option<HtmlElement> {
        let body = self.body_index();
        if body == NO_PARENT {
            resume null;
        } else {
            resume Option::Some(self.handle(body) as HtmlElement);
        }
    }

    fn get_element_by_id(&mut self, this: &Document, element_id: String) -> Option<Element> {
        resume self.element(self.find_id(DOCUMENT_INDEX, &element_id));
    }

    ..trap
}

impl Node for FakeDom {
    fn node_type(&mut self, this: &Node) -> u16 {
        resume match self.nodes[self.index(*this as f64)].content {
            Element(_) => 1,
            Text(_) => 3,
            Document => 9,
            Window => unreachable(),
        };
    }

    fn node_name(&mut self, this: &Node) -> String {
        resume match self.nodes[self.index(*this as f64)].content {
            Element(name) => name.to_ascii_uppercase(),
            Text(_) => "#text",
            Document => "#document",
            Window => unreachable(),
        };
    }

    fn parent_node(&mut self, this: &Node) -> Option<Node> {
        resume self.node(self.nodes[self.index(*this as f64)].parent);
    }

    fn parent_element(&mut self, this: &Node) -> Option<Element> {
        resume self.element(self.nodes[self.index(*this as f64)].parent);
    }

    fn has_child_nodes(&mut self, this: &Node) -> bool {
        resume !self.nodes[self.index(*this as f64)].children.is_empty();
    }

    fn first_child(&mut self, this: &Node) -> Option<Node> {
        let children = self.nodes[self.index(*this as f64)].children;
        if children.is_empty() {
            resume null;
        } else {
            resume self.node(children[0]);
        }
    }

    fn last_child(&mut self, this: &Node) -> Option<Node> {
        let children = self.nodes[self.index(*this as f64)].children;
        if children.is_empty() {
            resume null;
        } else {
            resume self.node(children[children.len() - 1]);
        }
    }

    fn previous_sibling(&mut self, this: &Node) -> Option<Node> {
        resume self.sibling(self.index(*this as f64), -1);
    }

    fn next_sibling(&mut self, this: &Node) -> Option<Node> {
        resume self.sibling(self.index(*this as f64), 1);
    }

    fn text_content(&mut self, this: &Node) -> Option<String> {
        let index = self.index(*this as f64);
        if self.nodes[index].content matches { Document } {
            resume null;
        } else {
            let mut text = "";
            self.text_of(index, &mut text);
            resume Option::Some(text);
        }
    }

    fn set_text_content(&mut self, this: &Node, value: Option<String>) {
        let index = self.index(*this as f64);
        let text = value.unwrap_or("");
        if self.nodes[index].content matches { Text(_) } {
            self.nodes[index].content = Content::Text(text);
        } else {
            for let child of self.nodes[index].children {
                self.nodes[child].parent = NO_PARENT;
            }
            self.nodes[index].children.clear();
            if !text.is_empty() {
                let node = self.push(NODE, Content::Text(text));
                self.append(index, node);
            }
        }
        resume ();
    }

    fn contains(&mut self, this: &Node, other: Option<Node>) -> bool {
        let Some(other) = other else {
            resume false;
        };
        let ancestor = self.index(*this as f64);
        let mut at = self.index(other as f64);
        while at != NO_PARENT && at != ancestor {
            at = self.nodes[at].parent;
        }
        resume at == ancestor;
    }

    fn append_child(&mut self, this: &Node, node: Node) -> Node {
        self.append(self.index(*this as f64), self.index(node as f64));
        resume node;
    }

    fn remove_child(&mut self, this: &Node, child: Node) -> Node {
        let index = self.index(child as f64);
        assert self.nodes[index].parent == self.index(*this as f64), "the node to remove is a child";
        self.detach(index);
        resume child;
    }

    ..trap
}

impl Element for FakeDom {
    fn local_name(&mut self, this: &Element) -> String {
        let Element(name) = self.nodes[self.index(*this as f64)].content else {
            unreachable();
        };
        resume name;
    }

    fn tag_name(&mut self, this: &Element) -> String {
        let Element(name) = self.nodes[self.index(*this as f64)].content else {
            unreachable();
        };
        resume name.to_ascii_uppercase();
    }

    fn id(&mut self, this: &Element) -> String {
        resume self.nodes[self.index(*this as f64)].attributes.get("id").unwrap_or("");
    }

    fn set_id(&mut self, this: &Element, value: String) {
        let index = self.index(*this as f64);
        self.nodes[index].attributes["id"] = value;
        resume ();
    }

    fn get_attribute(&mut self, this: &Element, qualified_name: String) -> Option<String> {
        resume self.nodes[self.index(*this as f64)].attributes.get(qualified_name);
    }

    fn set_attribute(&mut self, this: &Element, qualified_name: String, value: String) {
        let index = self.index(*this as f64);
        self.nodes[index].attributes[qualified_name] = value;
        resume ();
    }

    fn has_attribute(&mut self, this: &Element, qualified_name: String) -> bool {
        resume self.nodes[self.index(*this as f64)].attributes.contains_key(qualified_name);
    }

    fn remove_attribute(&mut self, this: &Element, qualified_name: String) {
        let index = self.index(*this as f64);
        self.nodes[index].attributes.remove(qualified_name);
        resume ();
    }

    ..trap
}

impl HtmlInputElement for FakeDom {
    fn value(&mut self, this: &HtmlInputElement) -> String {
        resume self.nodes[self.index(*this as f64)].value;
    }

    fn set_value(&mut self, this: &HtmlInputElement, value: String) {
        let index = self.index(*this as f64);
        self.nodes[index].value = value;
        resume ();
    }

    ..trap
}
