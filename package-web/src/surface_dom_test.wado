use { Document, Dom, Element, Event, EventTarget, HtmlElement, HtmlInputElement, Node } from "./dom.wado";
use { SurfaceDom } from "./surface_dom.wado";

test "a fresh document has a body" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let body = doc.body().unwrap();
        assert body.tag_name() == "BODY";
        let html = doc.document_element().unwrap();
        assert html.tag_name() == "HTML";
        assert body.parent_element() == Option::Some(html);
        assert Dom::window().document() == doc;
    };
}

test "a fresh document starts with its doctype" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let doctype = doc.first_child().unwrap();
        assert doctype.node_type() == 10;
        assert doctype.node_name() == "html";
        assert doctype.text_content() == null;
        assert doctype.next_sibling() == Option::Some(doc.document_element().unwrap() as Node);
    };
}

#[expect_trap]
test "a doctype is never an element's child" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        doc.body().unwrap().append_child(doc.first_child().unwrap());
    };
}

#[expect_trap]
test "the document holds one doctype" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        doc.append_child(doc.first_child().unwrap());
    };
}

test "the handles carry the classes dom.wado numbers" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let input = doc.create_element("input", null);
        let div = doc.create_element("div", null);
        assert input matches { _: HtmlInputElement };
        assert div matches { _: HtmlElement };
        assert !div matches { _: HtmlInputElement };
        let node: Node = doc;
        assert node matches { _: Document };
        assert !node matches { _: Element };
        div.set_text_content(Option::Some("hi"));
        let text = div.first_child().unwrap();
        assert !text matches { _: Element };
        assert text.node_name() == "#text";
    };
}

test "a handle inspects as the type its class names" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let node: Node = Dom::document().create_element("div", null);
        assert `${node:?}` == "HtmlElement { type_id: 3, object_id: 6 }";
    };
}

test "handles compare equal when they name one object" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let div = doc.create_element("div", null);
        let as_node: Node = div;
        assert as_node == div;
        assert div != doc.create_element("div", null);
        assert Dom::document() == doc;
    };
}

test "a tree is built by appending" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let body = doc.body().unwrap();
        let list = doc.create_element("ul", null);
        let first = doc.create_element("li", null);
        let second = doc.create_element("li", null);
        body.append_child(list);
        list.append_child(first);
        list.append_child(second);
        assert list.first_child() == Option::Some(first as Node);
        assert list.last_child() == Option::Some(second as Node);
        assert first.next_sibling() == Option::Some(second as Node);
        assert second.previous_sibling() == Option::Some(first as Node);
        assert first.previous_sibling() == null;
        assert body.contains(Option::Some(second as Node));
        assert !first.contains(Option::Some(second as Node));

        body.append_child(first);
        assert list.first_child() == Option::Some(second as Node);
        assert first.parent_node() == Option::Some(body as Node);

        list.remove_child(second);
        assert !list.has_child_nodes();
        assert second.parent_node() == null;
    };
}

test "text content concatenates the descendants' text" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let p = doc.create_element("p", null);
        let b = doc.create_element("b", null);
        p.set_text_content(Option::Some("Hello, "));
        b.set_text_content(Option::Some("Wado"));
        p.append_child(b);
        assert p.text_content() == Option::Some("Hello, Wado");
        assert doc.text_content() == null;

        p.set_text_content(Option::Some("replaced"));
        assert p.text_content() == Option::Some("replaced");
        assert b.parent_node() == null;
    };
}

test "setting a document's text content changes nothing" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        doc.set_text_content(Option::Some("x"));
        assert doc.text_content() == null;
        assert doc.body() != null;
    };
}

#[expect_trap]
test "a node appended into itself is a hierarchy error" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let div = Dom::document().create_element("div", null);
        div.append_child(div);
    };
}

#[expect_trap]
test "an ancestor appended into its descendant is a hierarchy error" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let outer = doc.create_element("div", null);
        let inner = doc.create_element("div", null);
        outer.append_child(inner);
        inner.append_child(outer);
    };
}

#[expect_trap]
test "the document is never a child" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        doc.create_element("div", null).append_child(doc);
    };
}

#[expect_trap]
test "the document holds one element" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        doc.append_child(doc.create_element("html", null));
    };
}

#[expect_trap]
test "a text node holds no children" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let p = doc.create_element("p", null);
        p.set_text_content(Option::Some("text"));
        p.first_child().unwrap().append_child(doc.create_element("b", null));
    };
}

test "an element is found by id once it is in the document" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let el = doc.create_element("div", null);
        el.set_id("app");
        assert el.id() == "app";
        assert el.get_attribute("id") == Option::Some("app");
        assert doc.get_element_by_id("app") == null;
        doc.body().unwrap().append_child(el);
        assert doc.get_element_by_id("app") == Option::Some(el);
    };
}

test "attributes are set, read and removed" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let el = Dom::document().create_element("a", null);
        assert !el.has_attribute("href");
        el.set_attribute("href", "/home");
        assert el.get_attribute("href") == Option::Some("/home");
        el.remove_attribute("href");
        assert el.get_attribute("href") == null;
    };
}

test "get_html serializes an element's children" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let list = doc.create_element("ul", null);
        list.set_attribute("class", "menu");
        list.set_id("nav");
        let item = doc.create_element("li", null);
        item.set_text_content(Option::Some("One"));
        list.append_child(item);
        let body = doc.body().unwrap();
        body.append_child(list);
        assert body.get_html() == "<ul class=\"menu\" id=\"nav\"><li>One</li></ul>";
        assert item.get_html() == "One";
    };
}

test "text and attribute values are escaped" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let div = doc.create_element("div", null);
        let p = doc.create_element("p", null);
        p.set_attribute("title", "\"q\" & <x>");
        p.set_text_content(Option::Some("a < b & \"c\" > d\u{A0}"));
        div.append_child(p);
        assert div.get_html() == "<p title=\"&quot;q&quot; &amp; &lt;x&gt;\">a &lt; b &amp; \"c\" &gt; d&nbsp;</p>";
    };
}

test "a void element has no end tag, and an input's value is no attribute" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let form = doc.create_element("form", null);
        let input = doc.create_element("input", null);
        input.set_attribute("type", "text");
        let input: HtmlInputElement = input else {
            unreachable();
        };
        input.set_value("typed");
        form.append_child(input);
        form.append_child(doc.create_element("br", null));
        assert form.get_html() == "<input type=\"text\"><br>";
    };
}

test "a script's text is not escaped" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let head = doc.create_element("head", null);
        let script = doc.create_element("script", null);
        script.set_text_content(Option::Some("if (a < b && c) {}"));
        head.append_child(script);
        assert head.get_html() == "<script>if (a < b && c) {}</script>";
    };
}

test "a document's title is a title element in the head" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        assert doc.title() == "";
        doc.set_title("  Hello \n  Wado ");
        assert doc.title() == "Hello Wado";
        doc.set_title("Again");
        assert doc.title() == "Again";
    };
    assert dom.to_html() == "<!DOCTYPE html><html><head><title>Again</title></head><body></body></html>";
}

test "a title set without a head is dropped" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let html = doc.document_element().unwrap();
        html.remove_child(html.first_child().unwrap());
        doc.set_title("Lost");
        assert doc.title() == "";
    };
}

test "the document serializes with its doctype" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let p = doc.create_element("p", null);
        p.set_text_content(Option::Some("Hi"));
        doc.body().unwrap().append_child(p);
    };
    assert dom.to_html() == "<!DOCTYPE html><html><head></head><body><p>Hi</p></body></html>";
}

#[expect_trap]
test "an element name holding a space is an InvalidCharacterError" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        Dom::document().create_element("div onclick=x", null);
    };
}

#[expect_trap]
test "an element name not starting with a letter is an InvalidCharacterError" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        Dom::document().create_element("1div", null);
    };
}

#[expect_trap]
test "an attribute name holding `=` is an InvalidCharacterError" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        Dom::document().create_element("div", null).set_attribute("a=b", "");
    };
}

test "a name the DOM accepts is kept" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let el = doc.create_element("my-el.x", null);
        el.set_attribute("data-a:b", "1");
        let div = doc.create_element("div", null);
        div.append_child(el);
        assert div.get_html() == "<my-el.x data-a:b=\"1\"></my-el.x>";
    };
}

test "an attribute name is lowercased" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let div = doc.create_element("div", null);
        let p = doc.create_element("p", null);
        p.set_attribute("Class", "x");
        assert p.get_attribute("CLASS") == Option::Some("x");
        assert p.has_attribute("class");
        div.append_child(p);
        assert div.get_html() == "<p class=\"x\"></p>";
        p.remove_attribute("CLass");
        assert !p.has_attribute("class");
    };
}

test "a void element's get_html is empty, whatever it holds" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let input = doc.create_element("input", null);
        input.append_child(doc.create_element("span", null));
        assert input.get_html() == "";
    };
}

test "an empty id is no id" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let div = doc.create_element("div", null);
        div.set_attribute("id", "");
        doc.body().unwrap().append_child(div);
        assert doc.get_element_by_id("") == null;
    };
}

test "an input holds its value" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let input = Dom::document().create_element("input", null);
        let input: HtmlInputElement = input else {
            unreachable();
        };
        assert input.value() == "";
        input.set_value("typed");
        assert input.value() == "typed";
    };
}

test "an event reaches capturing ancestors first, then the target" {
    let mut dom = SurfaceDom::new();
    let mut order: List<String> = [];
    with &mut dom do {
        let doc = Dom::document();
        let body = doc.body().unwrap();
        let button = doc.create_element("button", null);
        body.append_child(button);
        button.add_event_listener("click", |_: Event| order.push("target"), null);
        body.add_event_listener("click", |_: Event| order.push("body, bubbling"), null);
        body.add_event_listener("click", |_: Event| order.push("body"), Option::Some(true));
        Dom::window().add_event_listener("click", |_: Event| order.push("window"), Option::Some(true));
        button.add_event_listener("focus", |_: Event| order.push("other type"), null);
        assert button.dispatch_event(Event::new("click"));
    };
    assert order == ["window", "body", "target"];
}

test "a listener sees the event and may call the DOM" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let body = doc.body().unwrap();
        body.add_event_listener("ping", |e: Event| {
            assert e.type() == "ping";
            assert e.target() == Option::Some(Dom::document().body().unwrap() as EventTarget);
            Dom::document().body().unwrap().set_id("pinged");
        }, null);
        let event = Event::new("ping");
        assert event.target() == null;
        body.dispatch_event(event);
        assert body.id() == "pinged";
    };
}
