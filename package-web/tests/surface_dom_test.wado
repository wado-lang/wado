use {
    AddEventListenerOptions,
    AddEventListenerOptionsOrBool,
    BoolOrF64OrString,
    Document,
    DocumentReadyState,
    DocumentVisibilityState,
    Dom,
    Element,
    Event,
    EventInit,
    EventTarget,
    HtmlElement,
    HtmlInputElement,
    Node,
    NodeFilter,
    NodeIterator,
    Text,
    TreeWalker,
    Window,
} from "../src/dom.wado";
use { SurfaceDom } from "../src/surface_dom.wado";

test "a callback interface holds its constants" {
    assert NodeFilter::SHOW_ALL == 0xFFFFFFFF;
    assert NodeFilter::SHOW_ELEMENT == 1;
    assert NodeFilter::FILTER_REJECT == 2;
}

// <body><div><p></p><span>hi</span></div><em></em></body>, by tag name.

fn traversal_tree(doc: Document) -> Node with Dom {
    let body = doc.body().unwrap();
    let div = doc.create_element("div");
    div.append_child(doc.create_element("p"));
    let span = doc.create_element("span");
    span.append_child(doc.create_text_node("hi"));
    div.append_child(span);
    body.append_child(div);
    body.append_child(doc.create_element("em"));
    return body;
}

fn name(node: Option<Node>) -> String with Dom {
    return match node {
        Some(found) => found.node_name(),
        null => "-",
    };
}

fn walk_forward(walker: TreeWalker) -> String with Dom {
    let mut names = "";
    while let Some(node) = walker.next_node() {
        names.push_str(&node.node_name());
        names.push_str(" ");
    }
    return names;
}

test "a tree walker goes through the nodes its filter accepts, in tree order" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let body = traversal_tree(doc);
        let all = doc.create_tree_walker(body, NodeFilter::SHOW_ALL, |_| NodeFilter::FILTER_ACCEPT);
        assert walk_forward(all) == "DIV P SPAN #text EM ";
        assert name(all.previous_node()) == "#text";
        assert name(all.parent_node()) == "SPAN";
        assert name(all.parent_node()) == "DIV";
        assert name(all.parent_node()) == "BODY";
        assert all.parent_node() == null;
        assert all.current_node() == body;
        let elements = doc.create_tree_walker(body, NodeFilter::SHOW_ELEMENT, |_| NodeFilter::FILTER_ACCEPT);
        assert walk_forward(elements) == "DIV P SPAN EM ";
        assert elements.what_to_show() == NodeFilter::SHOW_ELEMENT;
        assert elements.root() == body;
    };
}

test "a tree walker skips a node but not its children, and rejects a subtree" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let body = traversal_tree(doc);
        let skipping = doc.create_tree_walker(body, NodeFilter::SHOW_ELEMENT, |node| {
            return if node.node_name() == "DIV" { NodeFilter::FILTER_SKIP } else { NodeFilter::FILTER_ACCEPT };
        });
        assert walk_forward(skipping) == "P SPAN EM ";
        let rejecting = doc.create_tree_walker(body, NodeFilter::SHOW_ELEMENT, |node| {
            return if node.node_name() == "DIV" { NodeFilter::FILTER_REJECT } else { NodeFilter::FILTER_ACCEPT };
        });
        assert walk_forward(rejecting) == "EM ";
        assert name(rejecting.previous_node()) == "BODY";
        skipping.set_current_node(body);
        assert name(skipping.first_child()) == "P";
    };
}

test "a tree walker moves among children and siblings" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let body = traversal_tree(doc);
        let walker = doc.create_tree_walker(body, NodeFilter::SHOW_ELEMENT, |_| NodeFilter::FILTER_ACCEPT);
        assert name(walker.last_child()) == "EM";
        assert name(walker.previous_sibling()) == "DIV";
        assert walker.previous_sibling() == null;
        assert name(walker.last_child()) == "SPAN";
        assert walker.first_child() == null;
        assert name(walker.previous_sibling()) == "P";
        assert name(walker.next_sibling()) == "SPAN";
        walker.set_current_node(body);
        assert walker.next_sibling() == null;
    };
}

test "a tree walker never steps back past its root" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let body = traversal_tree(doc);
        let div = body.first_child().unwrap();
        let walker = doc.create_tree_walker(div, NodeFilter::SHOW_ELEMENT, |node| {
            return if node.node_name() == "DIV" { NodeFilter::FILTER_REJECT } else { NodeFilter::FILTER_ACCEPT };
        });
        walker.set_current_node(div.next_sibling().unwrap());
        assert walker.previous_node() == null;
    };
}

test "a node iterator answers the node it passes, either way" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let body = traversal_tree(doc);
        let iterator = doc.create_node_iterator(body, NodeFilter::SHOW_ELEMENT, |_| NodeFilter::FILTER_ACCEPT);
        assert iterator.reference_node() == body;
        assert iterator.pointer_before_reference_node();
        assert name(iterator.next_node()) == "BODY";
        assert name(iterator.next_node()) == "DIV";
        assert !iterator.pointer_before_reference_node();
        assert name(iterator.previous_node()) == "DIV";
        assert iterator.pointer_before_reference_node();
        assert name(iterator.previous_node()) == "BODY";
        assert iterator.previous_node() == null;
        iterator.detach();
        let texts = doc.create_node_iterator(body, NodeFilter::SHOW_TEXT, |_| NodeFilter::FILTER_ACCEPT);
        assert name(texts.next_node()) == "#text";
        assert texts.next_node() == null;
    };
}

// <body><div><p></p><span>hi</span></div><em></em></body>, and an iterator over
// its elements whose reference is `SPAN`, the pointer on the side `before` says.

fn at_span(doc: Document, before: bool) -> NodeIterator with Dom {
    let iterator = doc.create_node_iterator(
        traversal_tree(doc),
        NodeFilter::SHOW_ELEMENT,
        |_| NodeFilter::FILTER_ACCEPT,
    );
    while iterator.next_node().unwrap().node_name() != "SPAN" {
    }
    if before {
        iterator.previous_node();
    }
    assert iterator.reference_node().node_name() == "SPAN";
    return iterator;
}

test "a node iterator before a removed reference moves to the node after the subtree" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let before = at_span(Dom::document(), true);
        let div = before.root().first_child().unwrap();
        before.root().remove_child(div);
        assert before.reference_node().node_name() == "EM";
        assert before.pointer_before_reference_node();
        assert name(before.next_node()) == "EM";
    };
}

test "a node iterator after a removed reference moves to the node before the subtree" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let after = at_span(Dom::document(), false);
        let span = after.root().first_child().unwrap().last_child().unwrap();
        span.parent_node().unwrap().remove_child(span);
        assert after.reference_node().node_name() == "P";
        assert !after.pointer_before_reference_node();
        assert name(after.next_node()) == "EM";
    };
}

test "a node iterator before a reference nothing follows turns to the one before it" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let iterator = at_span(Dom::document(), true);
        let em = iterator.root().last_child().unwrap();
        while iterator.reference_node() != em {
            iterator.next_node();
        }
        iterator.previous_node();
        em.parent_node().unwrap().remove_child(em);
        assert iterator.reference_node().node_name() == "#text";
        assert !iterator.pointer_before_reference_node();
        assert iterator.next_node() == null;
    };
}

test "a node iterator stays where an ancestor of its root is removed" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let body = traversal_tree(doc);
        let div = body.first_child().unwrap();
        let iterator = doc.create_node_iterator(div, NodeFilter::SHOW_ELEMENT, |_| NodeFilter::FILTER_ACCEPT);
        iterator.next_node();
        assert name(iterator.next_node()) == "P";
        body.parent_node().unwrap().remove_child(body);
        assert iterator.reference_node().node_name() == "P";
        assert name(iterator.next_node()) == "SPAN";
    };
}

test "a removal its filter makes moves the node a traversal has reached" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let iterator = doc.create_node_iterator(traversal_tree(doc), NodeFilter::SHOW_ELEMENT, |node| {
            if node.node_name() != "P" {
                return NodeFilter::FILTER_ACCEPT;
            }
            node.parent_node().unwrap().remove_child(node);
            return NodeFilter::FILTER_SKIP;
        });
        let mut names = "";
        while let Some(node) = iterator.next_node() {
            names.push_str(&node.node_name());
            names.push_str(" ");
        }
        assert names == "BODY DIV SPAN EM ";
    };
}

test "removing a node iterator's root leaves it, and moving its reference moves it" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let iterator = at_span(Dom::document(), false);
        let root = iterator.root();
        root.remove_child(root.last_child().unwrap());
        root.parent_node().unwrap().remove_child(root);
        assert iterator.reference_node().node_name() == "SPAN";
        root.append_child(iterator.reference_node());
        assert iterator.reference_node().node_name() == "P";
    };
}

#[expect_trap]
test "a filter reentering its traverser traps" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let body = traversal_tree(doc);
        let mut walker: Option<TreeWalker> = null;
        // Once, so a missing guard returns rather than overflowing the stack.
        let mut reentered = false;
        let reentering = doc.create_tree_walker(body, NodeFilter::SHOW_ALL, |_| {
            if !reentered {
                reentered = true;
                walker.unwrap().next_node();
            }
            return NodeFilter::FILTER_ACCEPT;
        });
        walker = Option::Some(reentering);
        reentering.next_node();
    };
}

test "a fresh document has a body" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let body = doc.body().unwrap();
        assert body.tag_name() == "BODY";
        let html = doc.document_element().unwrap();
        assert html.tag_name() == "HTML";
        assert body.parent_element() == Option::Some(html);
        assert Dom::window().document() == doc;
    };
}

test "a document nothing loads or shows is complete and hidden" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        assert doc.ready_state() == DocumentReadyState::Complete;
        assert doc.visibility_state() == DocumentVisibilityState::Hidden;
    };
}

test "hidden answers a boolean, or the string of the hidden-until-found state" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let body = Dom::document().body().unwrap();
        assert body.hidden() == Option::Some(BoolOrF64OrString::AsBool(false));
        body.set_attribute("hidden", "bogus");
        assert body.hidden() == Option::Some(BoolOrF64OrString::AsBool(true));
        body.set_attribute("hidden", "Until-Found");
        assert body.hidden() == Option::Some(BoolOrF64OrString::AsString("until-found"));
    };
}

test "setting hidden keeps the attribute unless the value is falsy" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let body = Dom::document().body().unwrap();
        body.set_hidden(Option::Some(BoolOrF64OrString::AsString("UNTIL-FOUND")));
        assert body.get_attribute("hidden") == Option::Some("until-found");
        body.set_hidden(Option::Some(BoolOrF64OrString::AsF64(2.0)));
        assert body.get_attribute("hidden") == Option::Some("");
        for let falsy of [
            Option::Some(BoolOrF64OrString::AsBool(false)),
            Option::Some(BoolOrF64OrString::AsString("")),
            null,
            Option::Some(BoolOrF64OrString::AsF64(-0.0)),
            Option::Some(BoolOrF64OrString::AsF64(f64::NAN)),
        ] as List<Option<BoolOrF64OrString>> {
            body.set_hidden(Option::Some(BoolOrF64OrString::AsBool(true)));
            body.set_hidden(falsy);
            assert !body.has_attribute("hidden");
        }
    };
}

test "a fresh document starts with its doctype" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let doctype = doc.first_child().unwrap();
        assert doctype.node_type() == Node::DOCUMENT_TYPE_NODE;
        assert Node::DOCUMENT_TYPE_NODE == 10;
        assert doctype.node_name() == "html";
        assert doctype.text_content() == null;
        assert doctype.next_sibling() == Option::Some(doc.document_element().unwrap() as Node);
    };
}

#[expect_trap]
test "a doctype is never an element's child" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        doc.body().unwrap().append_child(doc.first_child().unwrap());
    };
}

test "a doctype goes back ahead of the document's element" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let doctype = doc.remove_child(doc.first_child().unwrap());
        let html = doc.document_element().unwrap();
        doc.insert_before(doctype, Option::Some(html as Node));
        assert doc.first_child() == Option::Some(doctype);
        assert doctype.next_sibling() == Option::Some(html as Node);
    };
}

#[expect_trap]
test "an element never goes ahead of the doctype" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        doc.remove_child(doc.document_element().unwrap());
        doc.insert_before(doc.create_element("html"), doc.first_child());
    };
}

#[expect_trap]
test "a doctype never goes after the document's element" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let doctype = doc.remove_child(doc.first_child().unwrap());
        doc.insert_before(doctype, null);
    };
}

#[expect_trap]
test "the document holds one doctype" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        doc.append_child(doc.first_child().unwrap());
    };
}

test "the handles carry the classes dom.wado numbers" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let input = doc.create_element("input");
        let div = doc.create_element("div");
        assert input matches { _: HtmlInputElement };
        assert div matches { _: HtmlElement };
        assert !div matches { _: HtmlInputElement };
        let node: Node = doc;
        assert node matches { _: Document };
        assert !node matches { _: Element };
        div.set_text_content(Option::Some("hi"));
        let text = div.first_child().unwrap();
        assert !text matches { _: Element };
        assert text matches { _: Text };
        assert text.node_name() == "#text";
    };
}

test "a handle inspects as the type its class names" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let node: Node = Dom::document().create_element("div");
        assert `${node:?}` == "HtmlElement";
    };
}

test "handles compare equal when they name one object" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let div = doc.create_element("div");
        let as_node: Node = div;
        assert as_node == div;
        assert div != doc.create_element("div");
        assert Dom::document() == doc;
    };
}

test "a tree is built by appending" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let body = doc.body().unwrap();
        let list = doc.create_element("ul");
        let first = doc.create_element("li");
        let second = doc.create_element("li");
        body.append_child(list);
        list.append_child(first);
        list.append_child(second);
        assert list.first_child() == Option::Some(first as Node);
        assert list.last_child() == Option::Some(second as Node);
        assert first.next_sibling() == Option::Some(second as Node);
        assert second.previous_sibling() == Option::Some(first as Node);
        assert first.previous_sibling() == null;
        assert body.contains(Option::Some(second as Node));
        assert !first.contains(Option::Some(second as Node));

        body.append_child(first);
        assert list.first_child() == Option::Some(second as Node);
        assert first.parent_node() == Option::Some(body as Node);

        list.remove_child(second);
        assert !list.has_child_nodes();
        assert second.parent_node() == null;
    };
}

test "replace_child puts a node where the child stood, and takes the child out" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let list = doc.create_element("ul");
        let a = doc.create_element("li");
        let b = doc.create_element("li");
        let c = doc.create_element("li");
        list.append_child(a);
        list.append_child(b);
        assert list.replace_child(c, a) == a as Node;
        assert list.first_child() == Option::Some(c as Node);
        assert c.next_sibling() == Option::Some(b as Node);
        assert a.parent_node() == null;

        // The node may be the child's next sibling already.
        list.replace_child(b, c);
        assert list.first_child() == Option::Some(b as Node);
        assert list.last_child() == Option::Some(b as Node);

        assert list.replace_child(b, b) == b as Node;
        assert list.first_child() == Option::Some(b as Node);
    };
}

test "replace_child lets a document's element be replaced by another" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let html = doc.create_element("html");
        doc.replace_child(html, doc.document_element().unwrap());
        assert doc.document_element() == Option::Some(html);
    };
}

#[expect_trap]
test "replace_child keeps a document to one element" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        doc.replace_child(doc.create_element("p"), doc.first_child().unwrap());
    };
}

test "insert_before places a node ahead of a child, or last for null" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let list = doc.create_element("ul");
        let a = doc.create_element("li");
        let b = doc.create_element("li");
        let c = doc.create_element("li");
        list.append_child(c);
        assert list.insert_before(a, Option::Some(c as Node)) == a as Node;
        list.insert_before(b, Option::Some(c as Node));
        assert list.first_child() == Option::Some(a as Node);
        assert a.next_sibling() == Option::Some(b as Node);
        assert b.next_sibling() == Option::Some(c as Node);
        assert c.previous_sibling() == Option::Some(b as Node);

        // A node already in the list moves.
        list.insert_before(c, Option::Some(a as Node));
        assert list.first_child() == Option::Some(c as Node);
        assert list.last_child() == Option::Some(b as Node);
        list.insert_before(c, null);
        assert list.last_child() == Option::Some(c as Node);
        assert b.next_sibling() == Option::Some(c as Node);

        // Before itself, a node stays where it is.
        list.insert_before(b, Option::Some(b as Node));
        assert a.next_sibling() == Option::Some(b as Node);
        assert b.next_sibling() == Option::Some(c as Node);
    };
}

#[expect_trap]
test "insert_before a node that is not a child is a not-found error" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let list = doc.create_element("ul");
        list.insert_before(doc.create_element("li"), Option::Some(doc.create_element("li") as Node));
    };
}

#[expect_trap]
test "insert_before checks the hierarchy as append_child does" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let outer = doc.create_element("div");
        let inner = doc.create_element("div");
        outer.append_child(inner);
        inner.insert_before(outer, null);
    };
}

test "text content concatenates the descendants' text" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let p = doc.create_element("p");
        let b = doc.create_element("b");
        p.set_text_content(Option::Some("Hello, "));
        b.set_text_content(Option::Some("Wado"));
        p.append_child(b);
        assert p.text_content() == Option::Some("Hello, Wado");
        assert doc.text_content() == null;

        p.set_text_content(Option::Some("replaced"));
        assert p.text_content() == Option::Some("replaced");
        assert b.parent_node() == null;
    };
}

test "a text node's data is its content, and changes in place" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let p = doc.create_element("p");
        let text = doc.create_text_node("a < b");
        assert text.data() == "a < b";
        assert text.node_type() == Text::TEXT_NODE;
        assert Text::TEXT_NODE == 3;
        assert text.text_content() == Option::Some("a < b");
        p.append_child(doc.create_element("b"));
        p.insert_before(text, p.first_child());
        assert p.get_html() == "a &lt; b<b></b>";

        text.set_data("c");
        assert p.first_child() == Option::Some(text as Node);
        assert p.text_content() == Option::Some("c");
        text.set_text_content(Option::Some("d"));
        assert text.data() == "d";

        assert Text::new("e").data() == "e";
        assert Text::new().data() == "";
    };
}

test "setting a document's text content changes nothing" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        doc.set_text_content(Option::Some("x"));
        assert doc.text_content() == null;
        assert doc.body() != null;
    };
}

