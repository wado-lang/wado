test "an element is found by id once it is in the document" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let el = doc.create_element("div");
        el.set_id("app");
        assert el.id() == "app";
        assert el.get_attribute("id") == Option::Some("app");
        assert doc.get_element_by_id("app") == null;
        doc.body().unwrap().append_child(el);
        assert doc.get_element_by_id("app") == Option::Some(el);
    };
}

test "attributes are set, read and removed" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let el = Dom::document().create_element("a");
        assert !el.has_attribute("href");
        el.set_attribute("href", "/home");
        assert el.get_attribute("href") == Option::Some("/home");
        el.remove_attribute("href");
        assert el.get_attribute("href") == null;
    };
}

test "get_html serializes an element's children" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let list = doc.create_element("ul");
        list.set_attribute("class", "menu");
        list.set_id("nav");
        let item = doc.create_element("li");
        item.set_text_content(Option::Some("One"));
        list.append_child(item);
        let body = doc.body().unwrap();
        body.append_child(list);
        assert body.get_html() == "<ul class=\"menu\" id=\"nav\"><li>One</li></ul>";
        assert item.get_html() == "One";
    };
}

test "text and attribute values are escaped" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let div = doc.create_element("div");
        let p = doc.create_element("p");
        p.set_attribute("title", "\"q\" & <x>");
        p.set_text_content(Option::Some("a < b & \"c\" > d\u{A0}"));
        div.append_child(p);
        assert div.get_html() == "<p title=\"&quot;q&quot; &amp; &lt;x&gt;\">a &lt; b &amp; \"c\" &gt; d&nbsp;</p>";
    };
}

test "a void element has no end tag, and an input's value is no attribute" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let form = doc.create_element("form");
        let input = doc.create_element("input");
        input.set_attribute("type", "text");
        let input: HtmlInputElement = input else {
            unreachable();
        };
        input.set_value("typed");
        form.append_child(input);
        form.append_child(doc.create_element("br"));
        assert form.get_html() == "<input type=\"text\"><br>";
    };
}

test "a script's text is not escaped" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let head = doc.create_element("head");
        let script = doc.create_element("script");
        script.set_text_content(Option::Some("if (a < b && c) {}"));
        head.append_child(script);
        assert head.get_html() == "<script>if (a < b && c) {}</script>";
    };
}

test "a document's title is a title element in the head" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        assert doc.title() == "";
        doc.set_title("  Hello \n  Wado ");
        assert doc.title() == "Hello Wado";
        doc.set_title("Again");
        assert doc.title() == "Again";
    };
    assert dom.to_html() == "<!DOCTYPE html><html><head><title>Again</title></head><body></body></html>";
}

test "a title set without a head is dropped" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let html = doc.document_element().unwrap();
        html.remove_child(html.first_child().unwrap());
        doc.set_title("Lost");
        assert doc.title() == "";
    };
}

test "the document serializes with its doctype" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let p = doc.create_element("p");
        p.set_text_content(Option::Some("Hi"));
        doc.body().unwrap().append_child(p);
    };
    assert dom.to_html() == "<!DOCTYPE html><html><head></head><body><p>Hi</p></body></html>";
}

#[expect_trap]
test "an element name holding a space is an InvalidCharacterError" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        Dom::document().create_element("div onclick=x");
    };
}

#[expect_trap]
test "an element name not starting with a letter is an InvalidCharacterError" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        Dom::document().create_element("1div");
    };
}

#[expect_trap]
test "an attribute name holding `=` is an InvalidCharacterError" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        Dom::document().create_element("div").set_attribute("a=b", "");
    };
}

test "a name the DOM accepts is kept" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let el = doc.create_element("my-el.x");
        el.set_attribute("data-a:b", "1");
        let div = doc.create_element("div");
        div.append_child(el);
        assert div.get_html() == "<my-el.x data-a:b=\"1\"></my-el.x>";
    };
}

test "an attribute name is lowercased" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let div = doc.create_element("div");
        let p = doc.create_element("p");
        p.set_attribute("Class", "x");
        assert p.get_attribute("CLASS") == Option::Some("x");
        assert p.has_attribute("class");
        div.append_child(p);
        assert div.get_html() == "<p class=\"x\"></p>";
        p.remove_attribute("CLass");
        assert !p.has_attribute("class");
    };
}

test "a void element's get_html is empty, whatever it holds" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let input = doc.create_element("input");
        input.append_child(doc.create_element("span"));
        assert input.get_html() == "";
    };
}

test "an empty id is no id" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let div = doc.create_element("div");
        div.set_attribute("id", "");
        doc.body().unwrap().append_child(div);
        assert doc.get_element_by_id("") == null;
    };
}

test "an input holds its value" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let input = Dom::document().create_element("input");
        let input: HtmlInputElement = input else {
            unreachable();
        };
        assert input.value() == "";
        input.set_value("typed");
        assert input.value() == "typed";
    };
}

test "an event reaches capturing ancestors first, then the target" {
    let mut dom = SurfaceDom::new();
    let mut order: List<String> = [];
    with &mut dom do {
        let doc = Dom::document();
        let body = doc.body().unwrap();
        let button = doc.create_element("button");
        body.append_child(button);
        button.add_event_listener("click", |_: Event| order.push("target"));
        body.add_event_listener("click", |_: Event| order.push("body, bubbling"));
        // `capture` is a boolean, or a member of the options.
        body.add_event_listener(
            "click",
            |_: Event| order.push("body"),
            Option::Some(AddEventListenerOptionsOrBool::AsBool(true)),
        );
        Dom::window().add_event_listener(
            "click",
            |_: Event| order.push("window"),
            Option::Some(AddEventListenerOptionsOrBool::AsAddEventListenerOptions(AddEventListenerOptions {
                capture: Option::Some(true),
            })),
        );
        button.add_event_listener("focus", |_: Event| order.push("other type"));
        assert button.dispatch_event(Event::new("click"));
    };
    assert order == ["window", "body", "target"];
}

test "an event made with `bubbles` goes back up from the target" {
    let mut dom = SurfaceDom::new();
    let mut order: List<String> = [];
    let mut flags: List<bool> = [];
    with &mut dom do {
        let doc = Dom::document();
        let body = doc.body().unwrap();
        let button = doc.create_element("button");
        body.append_child(button);
        Dom::window().add_event_listener("click", |_: Event| order.push("window"));
        body.add_event_listener("click", |_: Event| order.push("body"));
        body.add_event_listener(
            "click",
            |_: Event| order.push("body, capturing"),
            Option::Some(AddEventListenerOptionsOrBool::AsBool(true)),
        );
        button.add_event_listener("click", |_: Event| order.push("target"));
        let event = Event::new("click", Option::Some(EventInit { bubbles: Option::Some(true) }));
        flags = [
            event.bubbles(),
            event.cancelable(),
            event.composed(),
            Event::new("click").bubbles(),
        ];
        button.dispatch_event(event);
    };
    assert order == ["body, capturing", "target", "body", "window"];
    assert flags == [true, false, false, false];
}

test "a listener added with `once` hears one event" {
    let mut dom = SurfaceDom::new();
    let mut heard = 0;
    let mut always = 0;
    with &mut dom do {
        let body = Dom::document().body().unwrap();
        body.add_event_listener(
            "ping",
            |_: Event| heard += 1,
            Option::Some(AddEventListenerOptionsOrBool::AsAddEventListenerOptions(AddEventListenerOptions {
                once: Option::Some(true),
            })),
        );
        body.add_event_listener("ping", |_: Event| always += 1);
        body.dispatch_event(Event::new("ping"));
        body.dispatch_event(Event::new("ping"));
    };
    assert heard == 1;
    assert always == 2;
}

test "a listener sees the event and may call the DOM" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let body = doc.body().unwrap();
        body.add_event_listener("ping", |e: Event| {
            assert e.type() == "ping";
            assert e.target() == Option::Some(Dom::document().body().unwrap() as EventTarget);
            Dom::document().body().unwrap().set_id("pinged");
        });
        let event = Event::new("ping");
        assert event.target() == null;
        body.dispatch_event(event);
        assert body.id() == "pinged";
    };
}

test "a member answering a promise is a call that has settled" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let body = Dom::document().body().unwrap();
        assert body.scroll_into_view().wait() matches { Ok(_) };
    };
}

test "nothing is fullscreen where no screen is" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let Err(refused) = doc.body().unwrap().request_fullscreen().wait() else {
            panic("no screen shows the element");
        };
        assert refused.name() == "TypeError";
        assert refused.message() == "fullscreen is not supported";
        let Err(nothing) = doc.exit_fullscreen().wait() else {
            panic("no element is fullscreen");
        };
        assert nothing.name() == "TypeError";
        // A call nobody waits on drops like any other.
        let _ = doc.exit_fullscreen();
    };
}

test "an event's path is its targets while it is dispatched" {
    let mut dom = SurfaceDom::new();
    let mut seen: List<i32> = [];
    with &mut dom do {
        let doc = Dom::document();
        let body = doc.body().unwrap();
        let event = Event::new("ping");
        assert event.composed_path().is_empty();
        body.add_event_listener("ping", |e: Event| {
            let path = e.composed_path();
            seen.push(path.len());
            assert path[0] == Dom::document().body().unwrap() as EventTarget;
            assert path[path.len() - 1] == Dom::window() as EventTarget;
        });
        body.dispatch_event(event);
        assert event.composed_path().is_empty();
    };
    // `<body>`, `<html>`, the document and the window.
    assert seen == [4];
}

test "the attribute names come in the order they were set" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let div = Dom::document().create_element("div");
        assert div.get_attribute_names().is_empty();
        div.set_attribute("Title", "t");
        div.set_id("d");
        div.set_attribute("class", "c");
        assert div.get_attribute_names() == ["title", "id", "class"];
        div.remove_attribute("id");
        assert div.get_attribute_names() == ["title", "class"];
    };
}

test "an element reference names the elements set, while they share its tree" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let body = doc.body().unwrap();
        let field = doc.create_element("input");
        let label = doc.create_element("span");
        let away = doc.create_element("span");
        body.append_child(field);
        body.append_child(label);
        assert field.aria_labelled_by_elements() == null;

        field.set_aria_labelled_by_elements(Option::Some([label, away]));
        assert field.get_attribute("aria-labelledby") == Option::Some("");
        // A detached element is in another tree.
        assert field.aria_labelled_by_elements() == Option::Some([label]);
        body.append_child(away);
        assert field.aria_labelled_by_elements() == Option::Some([label, away]);

        field.set_aria_labelled_by_elements(null);
        assert !field.has_attribute("aria-labelledby");
        assert field.aria_labelled_by_elements() == null;
    };
}

test "an element reference reads the ids its attribute lists" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let body = doc.body().unwrap();
        let field = doc.create_element("input");
        let first = doc.create_element("span");
        let second = doc.create_element("span");
        first.set_id("a");
        second.set_id("b");
        body.append_child(field);
        body.append_child(first);
        body.append_child(second);

        field.set_attribute("aria-describedby", " b missing\ta ");
        assert field.aria_described_by_elements() == Option::Some([second, first]);
        // Each reference keeps its own list.
        assert field.aria_controls_elements() == null;

        // Writing the attribute forgets the elements set before it.
        field.set_aria_described_by_elements(Option::Some([first]));
        field.set_attribute("aria-describedby", "b");
        assert field.aria_described_by_elements() == Option::Some([second]);
    };
}

#[expect_trap]
test "a node of another document is refused" {
    let mut first = SurfaceDom::new();
    let mut second = SurfaceDom::new();
    let mut stray: Option<Element> = null;
    with &mut first do {
        stray = Option::Some(Dom::document().create_element("div"));
    };
    with &mut second do {
        Dom::document().body().unwrap().append_child(stray.unwrap());
    };
}

#[expect_trap]
test "a document of another SurfaceDom is refused" {
    let mut first = SurfaceDom::new();
    let mut second = SurfaceDom::new();
    let mut stray: Option<Document> = null;
    with &mut first do {
        stray = Option::Some(Dom::document());
    };
    with &mut second do {
        stray.unwrap().set_title("stray");
    };
}

#[expect_trap]
test "a window of another SurfaceDom is refused" {
    let mut first = SurfaceDom::new();
    let mut second = SurfaceDom::new();
    let mut stray: Option<Window> = null;
    with &mut first do {
        stray = Option::Some(Dom::window());
    };
    with &mut second do {
        stray.unwrap().document();
    };
}

test "a removed subtree stays a tree, and its listeners stay with it" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let body = doc.body().unwrap();
        let list = doc.create_element("ul");
        let item = doc.create_element("li");
        list.append_child(item);
        body.append_child(list);
        let mut paths: List<List<EventTarget>> = [];
        item.add_event_listener("ping", |event| paths.push(event.composed_path()), null);
        body.remove_child(list);

        assert list.parent_node() == null;
        assert item.parent_element() == Option::Some(list as Element);
        assert !body.has_child_nodes();
        item.dispatch_event(Event::new("ping"));
        // Off the document, the path stops at the subtree's root.
        assert paths == [
            [item as EventTarget, list as EventTarget],
        ];
    };
}

// What a node the program dropped costs is what the collector copies of it:
// kept alive, each of these would be copied at every collection after it.

#[timeout(seconds = 10)]
test "a node the program dropped is collected" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        let body = doc.body().unwrap();
        for let i of 0..<300000 {
            let div = doc.create_element("div");
            div.set_attribute("id", `n${i}`);
            body.append_child(div);
            div.set_text_content(Option::Some("x"));
            body.remove_child(div);
        }
        assert !body.has_child_nodes();
    };
}
