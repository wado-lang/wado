# `-diff` keeps a regenerated file out of `git diff`, `git show` and `git log -p`,
# so a generator change does not bury the sources that caused it. `git diff
# --text` prints one when you do want to read it.
wado-compiler/tests/generated/** linguist-generated=true -diff
wado-compiler/lib/core/*.wat linguist-generated=true -diff
wado-compiler/lib/wasi/** linguist-generated=true -diff
wado-compiler/lib/core/kiln/*.wado linguist-generated=true -diff
wado-compiler/lib/core/eval/*.wado linguist-generated=true -diff
package-gale/tests/generated/** linguist-generated=true -diff
*.kiln.json linguist-generated=true -diff
docs/stdlib-*.md linguist-generated=true -diff
scripts/rust-inline-paths.json linguist-generated=true -diff
package-wadopoet/src/vocabulary.wado linguist-generated=true -diff
package-web/src/dom.wado linguist-generated=true -diff
package-web/glue/dom.js linguist-generated=true -diff
package-web/idl/*.webidl.json linguist-generated=true -diff
package-loam/tests/models/tiny-gpt2/generate.json linguist-generated=true -diff
package-loam/tests/models/tiny-gpt2/model.onnxtext linguist-generated=true -diff
package-loam/tests/models/tiny-gpt2/model.safetensors linguist-generated=true -diff
package-loam/example/gpt2-124m/gpt2.onnxtext linguist-generated=true -diff
package-loam/example/gpt2-124m/gpt2-header.safetensors linguist-generated=true -diff

# Vendored, not generated: third-party models and tensors, each directory with
# its provenance. `linguist-vendored` keeps them out of the language statistics.
package-loam/tests/**/*.onnx linguist-vendored=true -diff
package-loam/tests/**/*.pb linguist-vendored=true -diff
package-loam/tests/models/tiny-gpt2/vocab.json linguist-vendored=true -diff
package-loam/tests/models/tiny-gpt2/merges.txt linguist-vendored=true -diff
package-loam/example/gpt2-124m/vocab.json linguist-vendored=true -diff
package-loam/example/gpt2-124m/merges.txt linguist-vendored=true -diff
# The schemas Grog parses, copied from protobuf and ONNX for the same reason.
package-grog/tests/proto/**/*.proto linguist-vendored=true -diff
package-loam/src/onnx.proto linguist-vendored=true -diff
