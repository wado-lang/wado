# `-diff` keeps a regenerated file out of `git diff`, `git show` and `git log -p`,
# so a generator change does not bury the sources that caused it. `git diff
# --text` prints one when you do want to read it.
wado-compiler/tests/generated/** linguist-generated=true -diff
wado-compiler/lib/core/*.wat linguist-generated=true -diff
wado-compiler/lib/wasi/** linguist-generated=true -diff
package-gale/tests/generated/** linguist-generated=true -diff
*.kiln.json linguist-generated=true -diff
docs/stdlib-*.md linguist-generated=true -diff
scripts/rust-inline-paths.json linguist-generated=true -diff

# Vendored, not generated: ONNX's own models and tensors, copied rather than
# read out of the submodule. `linguist-vendored` keeps them out of the language
# statistics.
package-loam/tests/onnx/**/*.onnx linguist-vendored=true -diff
package-loam/tests/onnx/**/*.pb linguist-vendored=true -diff
