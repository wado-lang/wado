//! A rendered post: front-matter metadata plus the Marl-rendered body.

use { render } from "../../package-marl/src/lib.wado";
use { parse } from "./front_matter.wado";

pub struct Post {
    pub slug: String,
    pub title: String,
    pub date: String,
    pub body_html: String,
    pub index: bool,
}

/// Build a post from its slug (typically the file stem) and source document.
pub fn build(slug: String, source: &String) -> Result<Post, String> {
    let [fm, body] = parse(source)?;
    return Result::Ok(Post {
        slug,
        title: fm.title,
        date: fm.date,
        body_html: render(&body),
        index: fm.index,
    });
}
