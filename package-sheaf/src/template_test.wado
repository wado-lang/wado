use { render_page, render_index } from "./template.wado";
use { Post } from "./post.wado";

test "render_page emits a full page and escapes the title" {
    let post = Post {
        slug: "hello",
        title: "Hi & Co",
        date: "2026-07-05",
        body_html: "<p>x</p>",
        index: true,
    };
    let expected = "<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\" />\n<title>Hi &amp; Co</title>\n</head>\n<body>\n<article>\n<h1>Hi &amp; Co</h1>\n<time>2026-07-05</time>\n<p>x</p>\n</article>\n</body>\n</html>\n";
    assert render_page(&post) == expected;
}

test "render_page adds a noindex meta for unlisted posts" {
    let post = Post {
        slug: "draft",
        title: "Draft",
        date: "d",
        body_html: "<p>y</p>",
        index: false,
    };
    assert render_page(&post).contains("<meta name=\"robots\" content=\"noindex, nofollow\" />");
}

test "render_index lists published posts newest-first and omits unlisted" {
    let posts: List<Post> = [
        Post { slug: "b", title: "B", date: "2026-02-01", body_html: "", index: true },
        Post { slug: "a", title: "A", date: "2026-03-01", body_html: "", index: true },
        Post { slug: "d", title: "Draft", date: "2026-04-01", body_html: "", index: false },
    ];
    let expected = "<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\" />\n<title>Blog</title>\n</head>\n<body>\n<ul>\n<li><a href=\"a.html\">A</a> <time>2026-03-01</time></li>\n<li><a href=\"b.html\">B</a> <time>2026-02-01</time></li>\n</ul>\n</body>\n</html>\n";
    assert render_index(&posts) == expected;
}
