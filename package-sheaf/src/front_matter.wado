//! Front matter: a leading `---json` … `---` block followed by the post body.

use { from_string } from "core:json";
use { Deserialize } from "core:serde";

pub struct FrontMatter {
    pub title: String,
    pub date: String,
    pub tags: List<String> = [],
    pub index: bool = true,
}

impl Deserialize for FrontMatter;

/// Split a document into `[front_matter_json, body]`, or `None` when it does
/// not open with a `---json` fence.
pub fn split(source: &String) -> Option<[String, String]> {
    let normalized = source.replace("\r\n", "\n");
    let mut lines: List<String> = [];
    for let line of normalized.split("\n") {
        lines.push(line);
    }
    if lines.is_empty() || lines[0].trim() != "---json" {
        return null;
    }
    let mut close = -1;
    let mut i = 1;
    while i < lines.len() {
        if lines[i].trim() == "---" {
            close = i;
            break;
        }
        i += 1;
    }
    if close < 0 {
        return null;
    }
    let json = join_range(&lines, 1, close);
    let body = join_range(&lines, close + 1, lines.len());
    return Option::Some([json, body]);
}

fn join_range(lines: &List<String>, s: i32, e: i32) -> String {
    let mut out: List<String> = [];
    let mut k = s;
    while k < e {
        out.push(lines[k]);
        k += 1;
    }
    return out.join("\n");
}

/// Parse a document into its `FrontMatter` and body text.
pub fn parse(source: &String) -> Result<[FrontMatter, String], String> {
    match split(source) {
        Some([json, body]) => {
            match from_string::<FrontMatter>(json) {
                Ok(fm) => {
                    return Result::Ok([fm, body]);
                },
                Err(e) => {
                    return Result::Err(`invalid front matter: {e:?}`);
                },
            }
        },
        None => {
            return Result::Err("missing ---json front matter");
        },
    }
}
