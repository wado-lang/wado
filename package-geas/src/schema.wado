//! The axis schema: what turns a graph's positional shapes into named axes.
//!
//! See WEP 2026-09-20 § "The Axis Schema Is an Invocation Option". A rule's
//! patterns are consulted in order and the first match wins, so one pattern
//! overrides an architecture table's entry without restating the rest of it.

pub struct LayoutRule {
    pub pattern: String,
    pub axes: List<String>,
}

pub struct Schema {
    pub layout: List<LayoutRule>,
}

impl Schema {
    /// The axis names for a tensor, or `None` where no pattern reaches it.
    /// Geas does not fall back to positional axes, so `None` is a build error
    /// at the caller.
    pub fn axes_for<S: AsStrSlice>(&self, tensor: S) -> Option<List<String>> {
        let name = chars_of(tensor);
        for let rule of &self.layout {
            if match_from(&chars_of(&rule.pattern), 0, &name, 0) {
                return Option::Some(rule.axes);
            }
        }
        return null;
    }
}

/// A shell wildcard over a tensor name: `*` spans any run of characters, `?`
/// exactly one.
pub fn glob_match<P: AsStrSlice, T: AsStrSlice>(pattern: P, text: T) -> bool {
    return match_from(&chars_of(pattern), 0, &chars_of(text), 0);
}

fn chars_of<S: AsStrSlice>(s: S) -> List<char> {
    let mut out: List<char> = [];
    for let c of s.as_str_slice().chars() {
        out.push(c);
    }
    return out;
}

fn match_from(pattern: &List<char>, p0: i32, text: &List<char>, t0: i32) -> bool {
    let mut p = p0;
    let mut t = t0;
    // Where to resume when the tail fails: the last `*` and how much text it
    // had let through. One pair suffices, since an earlier `*` can absorb
    // whatever a later one gives back.
    let mut star = -1;
    let mut star_t = 0;
    while t < text.len() {
        if p < pattern.len() && pattern[p] == '*' {
            star = p;
            star_t = t;
            p += 1;
        } else if p < pattern.len() && (pattern[p] == '?' || pattern[p] == text[t]) {
            p += 1;
            t += 1;
        } else if star >= 0 {
            star_t += 1;
            p = star + 1;
            t = star_t;
        } else {
            return false;
        }
    }
    while p < pattern.len() && pattern[p] == '*' {
        p += 1;
    }
    return p == pattern.len();
}
