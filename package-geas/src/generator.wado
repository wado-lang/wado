//! Kiln generator entry for Geas. Reads an ONNX graph, discharges its extent
//! conditions, and emits the axis types a checked graph earns.

use {
    Request,
    Response,
    Error,
    OutputFile,
    KilnHost,
    Diagnostic as KilnDiagnostic,
    DiagnosticLevel,
    read_text,
} from "core:kiln";
use { Deserialize } from "core:serde";
use { emit } from "./emit.wado";
use { infer } from "./infer.wado";
use { read } from "./onnx_text.wado";
use { LayoutRule, Schema } from "./schema.wado";

/// One pattern and the axis names it gives a tensor. Consulted in order, and
/// the first that matches wins.
pub struct AxisPattern {
    pub pattern: String,
    pub axes: List<String>,
}

impl Deserialize for AxisPattern;

/// Generator-side options, written at the `use ... with { generator: { options:
/// { ... } } }` site. See WEP 2026-09-20 § "The Axis Schema Is an Invocation
/// Option".
pub struct Options {
    /// Patterns consulted ahead of the architecture's table.
    pub layout: List<AxisPattern>,
}

impl Deserialize for Options;

export fn generate(req: Request<Options>) -> Result<Response, Error> with KilnHost {
    let path = req.primary.path;
    let source = match read_text(req.primary.content) {
        Ok(text) => text,
        Err(e) => {
            return Result::Err(Error::InvalidSchema(`geas: '${path}' is not UTF-8: ${e}`));
        },
    };
    let graph = match read(&source) {
        Ok(g) => g,
        Err(message) => {
            return Result::Err(Error::InvalidSchema(`geas: '${path}': ${message}`));
        },
    };

    let mut layout: List<LayoutRule> = [];
    for let rule of req.options.layout {
        layout.push(LayoutRule { pattern: rule.pattern, axes: rule.axes });
    }
    let shapes = match infer(&graph, &Schema { layout }) {
        Ok(s) => s,
        Err(e) => {
            // The build stops here rather than emitting a module that computes
            // the wrong thing, which is what having one tier means.
            return Result::Err(Error::InvalidSchema(`geas: '${path}': ${e}`));
        },
    };

    let generated = match emit(&graph, &shapes) {
        Ok(s) => s,
        Err(e) => {
            return Result::Err(Error::InvalidSchema(`geas: '${path}': ${e}`));
        },
    };
    KilnHost::emit_diagnostic(KilnDiagnostic {
        level: DiagnosticLevel::Hint,
        span: null,
        message: `geas: ${graph.name}: ${graph.nodes.len()} operators checked`,
    });
    let files: List<OutputFile> = [
        OutputFile {
            path: "model.wado",
            content: generated,
            is_entry: true,
        },
    ];
    return Result::Ok(Response { files });
}
