//! The Wado a checked graph becomes: one marker type per axis, and the
//! boundary's tensor types written in terms of them.

use { TreeMap, TreeSet } from "core:collections";
use { Shape } from "./shape.wado";
use { Graph, ValueInfo } from "./onnx_text.wado";

/// The generated module's source. Every axis the graph mentions becomes a
/// marker type, so two tensors sharing an axis share one type.
pub fn emit(graph: &Graph, shapes: &TreeMap<String, Shape>) -> Result<String, UnmappedDtype> {
    let mut out = String::with_capacity(1024);
    out.push_str(`//! Generated by Geas from the ONNX graph \`${graph.name}\`.\n`);
    out.push_str("//! Each axis is a marker type, so two tensors that share an axis\n");
    out.push_str("//! share the type that names it.\n\n");

    for let axis of axis_names(graph, shapes) {
        out.push_str(`pub struct ${axis} {}\n`);
    }
    out.push_str("\npub struct Tensor<E, Axes> {\n    pub data: List<E>,\n");
    out.push_str("    pub extents: List<i32>,\n}\n");

    // The boundary is written as types rather than aliases: an alias would be
    // a newtype, which needs an `as` at every construction and duplicates the
    // identity the axis list already carries.
    out.push_str("\n/// The graph's boundary, as this module's types name it.\n");
    for let vi of &graph.inputs {
        emit_boundary(&mut out, vi, shapes, "input")?;
    }
    for let vi of &graph.outputs {
        emit_boundary(&mut out, vi, shapes, "output")?;
    }
    return Result::Ok(out);
}

/// A boundary tensor whose element type Wado has no name for.
pub struct UnmappedDtype {
    pub tensor: String,
    pub dtype: String,
}

impl Display for UnmappedDtype {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(`${self.tensor}: no Wado type for the element type ${self.dtype}`);
    }
}

/// One boundary tensor, as the type a caller writes for it. A graph output the
/// nodes never produced has no shape, and the caller reports that first.
fn emit_boundary(
    out: &mut String,
    vi: &ValueInfo,
    shapes: &TreeMap<String, Shape>,
    role: String,
) -> Result<(), UnmappedDtype> {
    let Some(shape) = shapes.get(vi.name) else {
        return Result::Ok(());
    };
    let Some(element) = element_type(&vi.dtype) else {
        builtin::cold_path();
        return Result::Err(UnmappedDtype { tensor: vi.name, dtype: vi.dtype });
    };
    let mut axes = "";
    for let mut i = 0; i < shape.axes.len(); i += 1 {
        if i > 0 {
            axes.push_str(", ");
        }
        axes.push_str(&shape.axes[i].name);
    }
    out.push_str(`/// ${role} \`${vi.name}\`: \`Tensor<${element}, [${axes}]>\`\n`);
    return Result::Ok(());
}

/// Every axis name the checked graph uses, in first-seen order so the emitted
/// module is stable across runs.
fn axis_names(graph: &Graph, shapes: &TreeMap<String, Shape>) -> List<String> {
    let mut seen = TreeSet::<String>::new();
    let mut names: List<String> = [];
    for let vi of &graph.inputs {
        push_axes(&mut names, &mut seen, shapes, &vi.name);
    }
    for let vi of &graph.initializers {
        push_axes(&mut names, &mut seen, shapes, &vi.name);
    }
    for let node of &graph.nodes {
        // `infer` succeeded, and it refuses a node that names any other number.
        assert node.outputs.len() == 1;
        push_axes(&mut names, &mut seen, shapes, &node.outputs[0]);
    }
    return names;
}

fn push_axes(names: &mut List<String>, seen: &mut TreeSet<String>, shapes: &TreeMap<String, Shape>, tensor: &String) {
    let Some(shape) = shapes.get(*tensor) else {
        return;
    };
    for let axis of &shape.axes {
        if seen.insert(axis.name) {
            names.push(axis.name);
        }
    }
}

/// ONNX's element type as Wado's, for a tensor that crosses the generated
/// module's boundary. `None` is a build error naming the type.
fn element_type(dtype: &String) -> Option<String> {
    if *dtype == "float" {
        return Option::Some("f32");
    }
    if *dtype == "double" {
        return Option::Some("f64");
    }
    if *dtype == "int32" {
        return Option::Some("i32");
    }
    if *dtype == "int64" {
        return Option::Some("i64");
    }
    if *dtype == "bool" {
        return Option::Some("bool");
    }
    return null;
}
