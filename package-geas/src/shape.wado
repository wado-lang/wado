//! A tensor's axes as stage 0 sees them, and the extent conditions each
//! operation owes before it can emit anything.

use { Extent } from "./extent.wado";

/// One axis: the identity the type layer carries, paired with the length it
/// cannot. See WEP 2026-09-20 § "Axis Identity Is a Type, Extents Are Values".
pub struct Axis {
    pub name: String,
    pub extent: Extent,
}

pub struct Shape {
    pub axes: List<Axis>,
}

/// Two axes that must be one length are not, at an operation that cannot
/// proceed without them being one. Carries both, since a diagnostic that names
/// only the expected one leaves the reader to find the other.
pub struct ExtentConflict {
    pub op: String,
    pub axis: String,
    pub left: Extent,
    pub right: Extent,
}

pub struct RankConflict {
    pub op: String,
    pub left: i32,
    pub right: i32,
}

pub variant ShapeError {
    Extents(ExtentConflict),
    Rank(RankConflict),
}

impl Display for ExtentConflict {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(
            `${self.op}: axis ${self.axis} is ${self.left} on the left and ${self.right} on the right`,
        );
    }
}

impl Display for RankConflict {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(`${self.op}: rank ${self.left} on the left and ${self.right} on the right`);
    }
}

impl Display for ShapeError {
    fn fmt(&self, f: &mut Formatter) {
        match self {
            Extents(c) => c.fmt(f),
            Rank(c) => c.fmt(f),
        }
    }
}

impl Shape {
    pub fn rank(&self) -> i32 {
        return self.axes.len();
    }

    /// The axis `back` positions from the end, `0` being the last.
    pub fn from_end(&self, back: i32) -> &Axis {
        assert 0 <= back < self.rank();
        return &self.axes[self.rank() - 1 - back];
    }

    /// Elementwise over two operands of one shape, which every unary operation
    /// is the one-operand case of.
    pub fn elementwise(&self, other: &Shape, op: String) -> Result<Shape, ShapeError> {
        Shape::same_rank(self, other, &op)?;
        for let mut i = 0; i < self.rank(); i += 1 {
            Shape::agree(&self.axes[i], &other.axes[i], &op)?;
        }
        return Result::Ok(*self);
    }

    /// Contract the trailing axis of `self` with the leading matrix axis of
    /// `rhs`, batching over everything ahead of both: `[..Bs, M, K] x
    /// [..Bs, K, N] -> [..Bs, M, N]`.
    pub fn matmul(&self, rhs: &Shape) -> Result<Shape, ShapeError> {
        let op = "matmul";
        Shape::same_rank(self, rhs, &op)?;
        assert self.rank() >= 2;

        for let mut i = 0; i < self.rank() - 2; i += 1 {
            Shape::agree(&self.axes[i], &rhs.axes[i], &op)?;
        }
        Shape::agree(self.from_end(0), rhs.from_end(1), &op)?;

        let mut axes: List<Axis> = [];
        for let mut i = 0; i < self.rank() - 2; i += 1 {
            axes.push(self.axes[i]);
        }
        axes.push(*self.from_end(1));
        axes.push(*rhs.from_end(0));
        return Result::Ok(Shape { axes });
    }

    fn same_rank(left: &Shape, right: &Shape, op: &String) -> Result<(), ShapeError> {
        if left.rank() != right.rank() {
            return Result::Err(ShapeError::Rank(RankConflict {
                op: *op,
                left: left.rank(),
                right: right.rank(),
            }));
        }
        return Result::Ok(());
    }

    /// Discharge the one condition an operation places on a pair of axes. What
    /// stage 0 cannot prove is an error here, since there is no runtime tier
    /// below it to re-check at.
    fn agree(left: &Axis, right: &Axis, op: &String) -> Result<(), ShapeError> {
        if left.extent.agrees(&right.extent) {
            return Result::Ok(());
        }
        builtin::cold_path();
        return Result::Err(ShapeError::Extents(ExtentConflict {
            op: *op,
            axis: left.name,
            left: left.extent,
            right: right.extent,
        }));
    }
}
