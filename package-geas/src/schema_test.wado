//! The wildcard a layout pattern is, and the order the schema consults them in.

use { LayoutRule, Schema } from "./schema.wado";

/// Whether a lone pattern reaches a tensor name, which is all a one-rule
/// schema answers.
fn reaches(pattern: String, tensor: String) -> bool {
    let schema = Schema {
        layout: [
            LayoutRule {
                pattern,
                axes: ["A"],
            },
        ],
    };
    return schema.axes_for(tensor) matches { Some(_) };
}

test "a pattern with no wildcard matches only itself" {
    assert reaches("W1", "W1");
    assert !reaches("W1", "W2");
    assert !reaches("W1", "W11");
    assert !reaches("W11", "W1");
}

test "a star spans any run, including an empty one" {
    assert reaches("*", "");
    assert reaches("*", "anything");
    assert reaches("layers.*.weight", "layers.0.weight");
    assert reaches("layers.*.weight", "layers..weight");
    assert reaches("*.weight", "layers.0.self_attn.q_proj.weight");
    assert !reaches("*.weight", "layers.0.weight.bias");
}

test "a question mark spans exactly one" {
    assert reaches("W?", "W1");
    assert !reaches("W?", "W");
    assert !reaches("W?", "W12");
}

test "a star backtracks when the tail first fails" {
    // The star takes `aa` on its first try, leaving `b` against `ab`; matching
    // needs it to give one character back.
    assert reaches("*ab", "aaab");
    assert reaches("*a*b", "xaybzb");
    assert !reaches("*ab", "aaba");
}

test "trailing stars absorb nothing at the end" {
    assert reaches("abc***", "abc");
    assert !reaches("abc*d", "abc");
}

test "a pattern is matched by character, not by byte" {
    assert reaches("層?", "層数");
    assert reaches("*数", "層数");
}

test "the first rule that matches wins" {
    let schema = Schema {
        layout: [
            LayoutRule {
                pattern: "*.q_proj.weight",
                axes: ["Hidden", "Head"],
            },
            LayoutRule {
                pattern: "*.weight",
                axes: ["In", "Out"],
            },
        ],
    };
    assert schema.axes_for("layers.0.q_proj.weight").unwrap() == ["Hidden", "Head"];
    assert schema.axes_for("layers.0.k_proj.weight").unwrap() == ["In", "Out"];
}

test "a tensor no rule reaches gets no axes" {
    let schema = Schema {
        layout: [
            LayoutRule {
                pattern: "*.weight",
                axes: ["In", "Out"],
            },
        ],
    };
    assert schema.axes_for("layers.0.bias") matches { None };
}

test "an empty layout reaches nothing" {
    let schema = Schema { layout: [] };
    assert schema.axes_for("W1") matches { None };
}
