// TreeMap implementation using B-tree
// This is a pseudo-Wado draft (not meant to compile yet)
// Deletion uses lazy deletion (tombstone marking)

// B-tree node
struct BTreeNode<K, V> {
    keys: Array<K>,
    values: Array<V>,
    deleted: Array<bool>,  // Tombstone flags for lazy deletion
    children: Array<&mut BTreeNode<K, V>>,  // Child nodes (empty for leaf)
    is_leaf: bool,
}

impl BTreeNode<K, V> {
    // Create a new leaf node
    fn new_leaf() -> BTreeNode<K, V> {
        return BTreeNode {
            keys: [],
            values: [],
            deleted: [],
            children: [],
            is_leaf: true,
        };
    }

    // Create a new internal node
    fn new_internal() -> BTreeNode<K, V> {
        return BTreeNode {
            keys: [],
            values: [],
            deleted: [],
            children: [],
            is_leaf: false,
        };
    }

    // Find index where key should be inserted
    fn find_key_index(&self, key: &K) -> i32 {
        let mut i = 0;
        while i < self.keys.len() && self.keys[i] < *key {
            i += 1;
        }
        return i;
    }

    // Check if node is full (needs splitting)
    fn is_full(&self, max_keys: i32) -> bool {
        // Count non-deleted keys
        let mut count = 0;
        for let mut i = 0; i < self.keys.len(); i += 1 {
            if !self.deleted[i] {
                count += 1;
            }
        }
        return count >= max_keys;
    }

    // Compact this node (remove deleted entries)
    fn compact(&mut self) {
        let new_keys: Array<K> = [];
        let new_values: Array<V> = [];
        let new_deleted: Array<bool> = [];

        for let mut i = 0; i < self.keys.len(); i += 1 {
            if !self.deleted[i] {
                new_keys.append(self.keys[i]);
                new_values.append(self.values[i]);
                new_deleted.append(false);
            }
        }

        self.keys = new_keys;
        self.values = new_values;
        self.deleted = new_deleted;

        // Recursively compact children
        if !self.is_leaf {
            for let mut i = 0; i < self.children.len(); i += 1 {
                self.children[i].compact();
            }
        }
    }
}

// TreeMap using B-tree
struct TreeMap<K, V> {
    root: Option<&mut BTreeNode<K, V>>,
    t: i32,  // Minimum degree (t >= 2)
             // Each node can have at most 2t-1 keys
             // Each node (except root) must have at least t-1 keys
    size: i32,
    deleted_count: i32,  // Number of tombstone entries
}

impl TreeMap<K, V> {
    // Create a new TreeMap with specified minimum degree
    fn new(t: i32) -> TreeMap<K, V> {
        return TreeMap {
            root: null,
            t: t,
            size: 0,
            deleted_count: 0,
        };
    }

    // Create a TreeMap with default degree (t=3)
    fn with_default_degree() -> TreeMap<K, V> {
        return TreeMap::new(3);
    }

    // Get the maximum number of keys per node
    fn max_keys(&self) -> i32 {
        return 2 * self.t - 1;
    }

    // Get the minimum number of keys per node (except root)
    fn min_keys(&self) -> i32 {
        return self.t - 1;
    }

    // Search for a key
    fn get(&self, key: &K) -> Option<V> {
        if let Some(root) = self.root {
            return self.search_in_node(root, key);
        }
        return null;
    }

    // Search in a specific node
    fn search_in_node(&self, node: &BTreeNode<K, V>, key: &K) -> Option<V> {
        let mut i = 0;

        // Find the first key greater than or equal to the search key
        while i < node.keys.len() && *key > node.keys[i] {
            i += 1;
        }

        // Check if we found the key
        if i < node.keys.len() && *key == node.keys[i] {
            if !node.deleted[i] {
                return Option::<V>::Some(node.values[i]);
            }
            return null;  // Key was deleted
        }

        // If this is a leaf, the key doesn't exist
        if node.is_leaf {
            return null;
        }

        // Recurse to the appropriate child
        return self.search_in_node(node.children[i], key);
    }

    // Insert a key-value pair
    fn insert(&mut self, key: K, value: V) {
        // If root is null, create a new root
        if let None = self.root {
            let mut new_root = BTreeNode::<K, V>::new_leaf();
            new_root.keys.append(key);
            new_root.values.append(value);
            new_root.deleted.append(false);
            self.root = Option::Some(&mut new_root);
            self.size = 1;
            return;
        }

        // If root exists, get it
        if let Some(root) = self.root {
            // If root is full, split it
            if root.is_full(self.max_keys()) {
                let mut new_root = BTreeNode::<K, V>::new_internal();
                new_root.children.append(root);
                self.split_child(&mut new_root, 0);
                self.root = Option::Some(&mut new_root);
            }

            // Insert into the (possibly new) root
            if let Some(r) = self.root {
                self.insert_non_full(r, key, value);
            }
        }
    }

    // Insert into a node that is not full
    fn insert_non_full(&mut self, node: &mut BTreeNode<K, V>, key: K, value: V) {
        let mut i = node.keys.len() as i32 - 1;

        if node.is_leaf {
            // Find position and check if key already exists
            let mut pos = 0;
            while pos < node.keys.len() && node.keys[pos] < key {
                pos += 1;
            }

            // If key exists, update it
            if pos < node.keys.len() && node.keys[pos] == key {
                node.values[pos] = value;
                if node.deleted[pos] {
                    node.deleted[pos] = false;
                    self.deleted_count -= 1;
                }
                return;
            }

            // Insert new key-value pair
            node.keys.append(key);
            node.values.append(value);
            node.deleted.append(false);

            // Sort the arrays (simple insertion sort for now)
            self.sort_node_entries(node);
            self.size += 1;
        } else {
            // Find child to insert into
            let mut pos = 0;
            while pos < node.keys.len() && key > node.keys[pos] {
                pos += 1;
            }

            // Check if child is full
            if node.children[pos].is_full(self.max_keys()) {
                self.split_child(node, pos);

                // After split, determine which child to use
                if key > node.keys[pos] {
                    pos += 1;
                }
            }

            self.insert_non_full(node.children[pos], key, value);
        }
    }

    // Split a full child
    fn split_child(&mut self, parent: &mut BTreeNode<K, V>, child_index: i32) {
        let full_child = parent.children[child_index];
        let mut new_sibling = if full_child.is_leaf {
            BTreeNode::<K, V>::new_leaf()
        } else {
            BTreeNode::<K, V>::new_internal()
        };

        let mid = self.t - 1;

        // Move upper half of keys to new sibling
        for let mut i = mid + 1; i < full_child.keys.len(); i += 1 {
            new_sibling.keys.append(full_child.keys[i]);
            new_sibling.values.append(full_child.values[i]);
            new_sibling.deleted.append(full_child.deleted[i]);
        }

        // If not a leaf, move children too
        if !full_child.is_leaf {
            for let mut i = mid + 1; i < full_child.children.len(); i += 1 {
                new_sibling.children.append(full_child.children[i]);
            }
        }

        // Promote middle key to parent
        let promoted_key = full_child.keys[mid];
        let promoted_value = full_child.values[mid];
        let promoted_deleted = full_child.deleted[mid];

        // Insert promoted key into parent
        parent.keys.append(promoted_key);
        parent.values.append(promoted_value);
        parent.deleted.append(promoted_deleted);
        parent.children.append(&mut new_sibling);

        // Sort parent entries
        self.sort_node_entries(parent);

        // Truncate the full child
        // (In real implementation, we'd properly resize the arrays)
        // full_child.keys.truncate(mid);
        // full_child.values.truncate(mid);
        // full_child.deleted.truncate(mid);
    }

    // Sort node entries (helper for maintaining order)
    fn sort_node_entries(&self, node: &mut BTreeNode<K, V>) {
        // Bubble sort for simplicity (pseudo-code)
        for let mut i = 0; i < node.keys.len(); i += 1 {
            for let mut j = i + 1; j < node.keys.len(); j += 1 {
                if node.keys[i] > node.keys[j] {
                    // Swap keys
                    let temp_k = node.keys[i];
                    node.keys[i] = node.keys[j];
                    node.keys[j] = temp_k;

                    // Swap values
                    let temp_v = node.values[i];
                    node.values[i] = node.values[j];
                    node.values[j] = temp_v;

                    // Swap deleted flags
                    let temp_d = node.deleted[i];
                    node.deleted[i] = node.deleted[j];
                    node.deleted[j] = temp_d;
                }
            }
        }
    }

    // Lazy delete (mark as deleted)
    fn delete(&mut self, key: &K) -> bool {
        if let Some(root) = self.root {
            return self.delete_in_node(root, key);
        }
        return false;
    }

    // Delete in a specific node (lazy deletion)
    fn delete_in_node(&mut self, node: &mut BTreeNode<K, V>, key: &K) -> bool {
        let mut i = 0;

        // Find the key
        while i < node.keys.len() && *key > node.keys[i] {
            i += 1;
        }

        // Check if we found the key in this node
        if i < node.keys.len() && *key == node.keys[i] {
            if !node.deleted[i] {
                node.deleted[i] = true;
                self.deleted_count += 1;
                self.size -= 1;
                return true;
            }
            return false;  // Already deleted
        }

        // If leaf, key doesn't exist
        if node.is_leaf {
            return false;
        }

        // Recurse to child
        return self.delete_in_node(node.children[i], key);
    }

    // Compact the tree (remove tombstones)
    fn compact(&mut self) {
        if let Some(root) = self.root {
            root.compact();
            self.deleted_count = 0;
        }
    }

    // Check if compaction is needed
    fn needs_compaction(&self) -> bool {
        // Compact if more than 25% of entries are deleted
        return self.deleted_count > 0 &&
               self.deleted_count * 4 > self.size + self.deleted_count;
    }

    // Get the number of active entries
    fn len(&self) -> i32 {
        return self.size;
    }

    // Check if empty
    fn is_empty(&self) -> bool {
        return self.size == 0;
    }

    // Iterator (collect all non-deleted key-value pairs in order)
    fn iter(&self) -> Array<[K, V]> {
        let result: Array<[K, V]> = [];
        if let Some(root) = self.root {
            self.collect_entries(root, &mut result);
        }
        return result;
    }

    // Collect entries from a node (in-order traversal)
    fn collect_entries(&self, node: &BTreeNode<K, V>, result: &mut Array<[K, V]>) {
        let mut i = 0;

        while i < node.keys.len() {
            // Visit left child if not a leaf
            if !node.is_leaf && i < node.children.len() {
                self.collect_entries(node.children[i], result);
            }

            // Add current key-value if not deleted
            if !node.deleted[i] {
                result.append([node.keys[i], node.values[i]]);
            }

            i += 1;
        }

        // Visit rightmost child if not a leaf
        if !node.is_leaf && node.children.len() > i {
            self.collect_entries(node.children[i], result);
        }
    }
}

// Example usage
fn example() {
    let mut map = TreeMap::<String, i32>::with_default_degree();

    // Insert some entries
    map.insert("apple", 1);
    map.insert("banana", 2);
    map.insert("cherry", 3);
    map.insert("date", 4);

    // Get a value
    if let Some(val) = map.get(&"banana") {
        println(`banana: {val}`);
    }

    // Delete an entry (lazy)
    map.delete(&"banana");

    // Check if compaction is needed
    if map.needs_compaction() {
        map.compact();
    }

    // Iterate over entries
    let entries = map.iter();
    for let entry of entries {
        let key = entry[0];
        let value = entry[1];
        println(`{key}: {value}`);
    }
}
