//! The capture every grammar's highlight is reduced to, and the renderer that
//! turns a merged list of them into HTML.

/// One highlighted run: bytes `[start, end)` of the source carry `class`.
pub struct Highlight {
    pub start: i32,
    pub end: i32,
    pub class: String,
}

/// Shifts `captures` by `offset` bytes and appends them to `out`, so a region
/// highlighted on its own lands where it sits in the whole page.
pub fn push_shifted(out: &mut List<Highlight>, captures: &List<Highlight>, offset: i32) {
    for let c of captures {
        out.push(Highlight { start: c.start + offset, end: c.end + offset, class: c.class });
    }
}

fn push_escaped_upto(out: &mut String, source: &StrSlice, at: &mut i32, end: i32) {
    let mut run = *at;
    for let mut i = *at; i < end; i += 1 {
        let b = unchecked source.byte_at(i);
        if b matches { b'&' | b'<' | b'>' | b'"' } {
            out.push_str(unchecked source.slice(run, i));
            out.push_str(match b {
                b'&' => "&amp;",
                b'<' => "&lt;",
                b'>' => "&gt;",
                _ => "&quot;",
            });
            run = i + 1;
        }
    }
    out.push_str(unchecked source.slice(run, end));
    *at = end;
}

/// Renders `source` as HTML: each capture becomes a `<span class="...">`, the
/// text between them is escaped. `captures` are in source order and disjoint.
/// Captures of one class that touch share a span: a template literal is a
/// token per character.
pub fn render_html(source: &String, captures: &List<Highlight>) -> String {
    let src = &source.as_str_slice();
    let mut out = String::with_capacity(source.len() * 5);
    let mut at = 0;
    let mut open: Option<String> = null;
    for let cap of captures {
        assert cap.start >= at, "captures overlap";
        let extends = cap.start == at && open matches { Some(class) && class == cap.class };
        if !extends {
            if open matches { Some(_) } {
                out.push_str("</span>");
            }
            push_escaped_upto(&mut out, src, &mut at, cap.start);
            out.push_str("<span class=\"");
            out.push_str(&cap.class);
            out.push_str("\">");
            open = Option::Some(cap.class);
        }
        push_escaped_upto(&mut out, src, &mut at, cap.end);
    }
    if open matches { Some(_) } {
        out.push_str("</span>");
    }
    push_escaped_upto(&mut out, src, &mut at, src.len());
    return out;
}
