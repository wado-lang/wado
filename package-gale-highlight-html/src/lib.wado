//! Syntax highlighter for HTML that highlights what is embedded in it as the
//! language it is written in.
//!
//! The HTML grammar lexes a `<script>` or `<style>` body as one token, the way
//! a browser's tokenizer does. Each such body is handed to the parser of its
//! language, chosen by the element and its `type` attribute, and so is the
//! value of a `style` or `on*` attribute. Their captures are shifted to where
//! the text sits in the page and merged with the markup's own.
//!
//!     use { highlight } from "wado-lang:gale-highlight-html";
//!     let html = highlight(src);

use html from "../grammar/HTMLLexer.g4"
    with {
        generator: {
            module: "lib:gale",
            inputs: [
                "../grammar/HTMLParser.g4",
                { path: "../grammar/HTML.highlights.scm", type: "tree-sitter-highlights" },
            ],
        },
    };
use { Highlight, push_shifted, render_html } from "./highlight.wado";
use { javascript_highlights } from "./javascript.wado";
use { stylesheet_highlights, declarations_highlights } from "./css.wado";
use { json_highlights } from "./json.wado";

/// The language a region of the page is written in.
enum Language {
    JavaScript,
    Json,
    Css,
    CssDeclarations,
    /// A script type no grammar here reads, such as a template: left plain.
    Opaque,
}

fn highlights_in(language: Language, source: &String) -> List<Highlight> {
    return match language {
        JavaScript => javascript_highlights(source),
        Json => json_highlights(source),
        Css => stylesheet_highlights(source),
        CssDeclarations => declarations_highlights(source),
        Opaque => [],
    };
}

/// An attribute whose value is a token of its own: the value spans bytes
/// `[start, end)`, with any leading spaces and quotes.
struct Attribute {
    name: String,
    start: i32,
    end: i32,
}

fn text_of(src: &StrSlice, start: i32, end: i32) -> String {
    return src.slice(start, end).to_string();
}

/// The attributes `name=value` in `tokens`, in source order. Whitespace is a
/// hidden token, so the three are adjacent in the stream.
fn attributes(tokens: &html::TokenStream, src: &StrSlice) -> List<Attribute> {
    let mut out: List<Attribute> = [];
    for let i of 2..<tokens.len() {
        if tokens.kind_at(i - 2) == html::TK_TAG_NAME
            && tokens.kind_at(i - 1) == html::TK_TAG_EQUALS
            && tokens.kind_at(i) == html::TK_ATTVALUE_VALUE {
            let name = tokens.span_at(i - 2);
            let value = tokens.span_at(i);
            out.push(Attribute {
                name: text_of(src, name.start, name.end).to_ascii_lowercase(),
                start: value.start,
                end: value.end,
            });
        }
    }
    return out;
}

/// The interior of an attribute value: past leading spaces and inside its
/// quotes, if it has them.
fn unquoted(src: &StrSlice, attr: &Attribute) -> [i32, i32] {
    let mut start = attr.start;
    while start < attr.end && src.byte_at(start) == b' ' {
        start += 1;
    }
    let mut end = attr.end;
    if end - start >= 2 && src.byte_at(start) matches { b'"' | b'\'' } && src.byte_at(end - 1) == src.byte_at(start) {
        start += 1;
        end -= 1;
    }
    return [start, end];
}

/// The language of a `<script>` by its `type`, as the HTML standard reads it:
/// absent, empty, `module` or a JavaScript MIME type runs as JavaScript.
fn script_language(src: &StrSlice, attrs: &List<Attribute>) -> Language {
    for let attr of attrs {
        if attr.name != "type" {
            continue;
        }
        let [start, end] = unquoted(src, attr);
        let ty = text_of(src, start, end).trim().to_string().to_ascii_lowercase();
        let essence = match ty.split_once(";") {
            Some([head, _]) => head.trim().to_string(),
            None => ty,
        };
        return match essence.as_str_slice() {
            "" | "module" | "text/javascript" | "application/javascript" | "text/ecmascript" | "application/ecmascript" | "application/x-javascript" | "application/x-ecmascript" | "text/jscript" | "text/livescript" | "text/x-javascript" | "text/x-ecmascript" => Language::JavaScript,
            "importmap" | "speculationrules" => Language::Json,
            _ => if essence.ends_with("+json") || essence.ends_with("/json") {
                Language::Json;
            } else {
                Language::Opaque;
            },
        };
    }
    return Language::JavaScript;
}

/// The language an attribute's value is written in, if not plain text.
fn attribute_language(attr: &Attribute) -> Option<Language> {
    if attr.name == "style" {
        return Option::Some(Language::CssDeclarations);
    }
    if attr.name.starts_with("on") && attr.name.len() > 2 {
        return Option::Some(Language::JavaScript);
    }
    return null;
}

/// The highlights of an opening `<script ...>` / `<style ...>` tag, and its
/// attributes. The grammar lexes the whole tag as one token, so it is lexed
/// again with the element name masked: then it is an ordinary tag, its name and
/// attributes captured like any other.
fn open_tag(src: &StrSlice, start: i32, end: i32) -> [List<Highlight>, List<Attribute>] {
    let mut masked = String::with_capacity(end - start);
    masked.push('<');
    let mut i = start + 1;
    while i < end && src.byte_at(i).is_ascii_alphabetic() {
        masked.push('x');
        i += 1;
    }
    masked.push_str(src.slice(i, end));
    let [highlights, attrs] = markup(&masked);
    let mut shifted_attrs: List<Attribute> = [];
    for let attr of &attrs {
        shifted_attrs.push(Attribute { name: attr.name, start: attr.start + start, end: attr.end + start });
    }
    let mut out: List<Highlight> = [];
    push_shifted(&mut out, &highlights, start);
    return [out, shifted_attrs];
}

/// The highlights of an HTML text and the attributes it carries, embedded
/// languages included.
fn markup(source: &String) -> [List<Highlight>, List<Attribute>] {
    let src = &source.as_str_slice();
    let result = html::parse_html_document(source);
    let tokens = &result.tokens;
    let mut visitor = html::HighlightVisitor::new(&html::HIGHLIGHT_MAPPING);
    html::highlight_walk(&mut visitor, tokens, &result.cst);
    visitor.hl_cover_unvisited(tokens);
    let mut out: List<Highlight> = [];
    let attrs = attributes(tokens, src);
    // A capture an embedded language replaces, by its start.
    let mut replaced: List<i32> = [];
    for let attr of &attrs {
        let Some(language) = attribute_language(attr) else {
            continue;
        };
        let [start, end] = unquoted(src, attr);
        replaced.push(attr.start);
        if start > attr.start {
            out.push(Highlight { start: attr.start, end: start, class: "string" });
        }
        push_shifted(&mut out, &highlights_in(language, &text_of(src, start, end)), start);
        if end < attr.end {
            out.push(Highlight { start: end, end: attr.end, class: "string" });
        }
    }
    for let c of &visitor.captures {
        if !replaced.contains(&c.start) {
            out.push(Highlight {
                start: c.start,
                end: c.end,
                class: html::HIGHLIGHT_MAPPING.capture_classes[c.capture_id],
            });
        }
    }
    let mut body_language = Language::Opaque;
    for let i of 0..<tokens.len() {
        let span = tokens.span_at(i);
        let kind = tokens.kind_at(i);
        if kind == html::TK_SCRIPT_OPEN || kind == html::TK_STYLE_OPEN {
            let [tag, tag_attrs] = open_tag(src, span.start, span.end);
            out.extend(&tag);
            body_language = if kind == html::TK_STYLE_OPEN { Language::Css } else { script_language(src, &tag_attrs) };
        } else if kind matches { html::TK_SCRIPT_BODY | html::TK_SCRIPT_SHORT_BODY | html::TK_STYLE_BODY | html::TK_STYLE_SHORT_BODY } {
            out.extend(&embedded(src, span.start, span.end, body_language));
        }
    }
    out.sort_by(|a: &Highlight, b: &Highlight| a.start.cmp(&b.start));
    return [out, attrs];
}

/// The highlights of a `<script>` / `<style>` body token: the text up to the
/// closing tag in `language`, the closing tag as markup.
fn embedded(src: &StrSlice, start: i32, end: i32, language: Language) -> List<Highlight> {
    let mut close = end;
    while close > start && src.byte_at(close - 1) != b'<' {
        close -= 1;
    }
    close -= 1;
    assert close >= start, "a body token ends with its closing tag";
    let mut out: List<Highlight> = [];
    push_shifted(&mut out, &highlights_in(language, &text_of(src, start, close)), start);
    let [close_tag, _] = markup(&text_of(src, close, end));
    push_shifted(&mut out, &close_tag, close);
    return out;
}

/// Renders HTML `source` to an HTML fragment of `<span class="...">` nodes,
/// using the tree-sitter capture vocabulary. Never fails: an unparsable region
/// is highlighted best-effort.
export fn highlight(source: String) -> String {
    let [highlights, _] = markup(&source);
    return render_html(&source, &highlights);
}
