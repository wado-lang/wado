// Float-to-String conversion using Russ Cox's unrounded scaling algorithm
// Ported from rsc.io/fpfmt (https://research.swtch.com/fp)
//
// Copyright 2025 The Go Authors. All rights reserved.
// Use of this source code is governed by a BSD-style license.
// See https://github.com/rsc/fpfmt/blob/main/LICENSE


global POW10_MIN: i32 = -348;

// Powers of 10 from 10^0 to 10^19
global POW10: Array<u64> = [
    1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000,
    10000000000, 100000000000, 1000000000000, 10000000000000, 100000000000000,
    1000000000000000, 10000000000000000, 100000000000000000, 1000000000000000000,
    10000000000000000000,
];

pub fn pow10(n: i32) -> u64 {
    assert n >= 0 && n <= 19, "pow10: n must be in range 0..19";
    return POW10[n];
}

// Returns the bit length of x (position of highest set bit + 1)
pub fn u64_bit_len(x: u64) -> i32 {
    if x == 0 {
        return 0;
    }
    return 64 - (builtin::i64_clz(x as i64) as i32);
}

// log10_pow2(x) returns floor(log10(2^x)) = floor(x * log10(2))
pub fn log10_pow2(x: i32) -> i32 {
    return (x * 78913) >> 18;
}

// log2_pow10(x) returns floor(log2(10^x)) = floor(x * log2(10))
pub fn log2_pow10(x: i32) -> i32 {
    return (x * 108853) >> 15;
}

// Result of unpacking a float64
pub struct UnpackResult {
    mantissa: u64,
    exponent: i32,
}

// unpack64 returns (mantissa, exponent) such that f = mantissa * 2^exponent
pub fn unpack64(f: f64) -> UnpackResult {
    let bits = builtin::i64_reinterpret_f64(f) as u64;

    let mantissa_mask = 0x000FFFFFFFFFFFFF as u64;
    let exp_mask = 0x7FF as u64;
    let shift = 64 - 53;
    let min_exp = -(1074 + shift);

    let raw_mantissa = bits & mantissa_mask;
    let raw_exp = ((bits >> 52) & exp_mask) as i32;

    if raw_exp == 0 {
        if raw_mantissa == 0 {
            return UnpackResult { mantissa: 0, exponent: 0 };
        }
        let m = raw_mantissa << shift;
        let e = min_exp;
        let s = 64 - u64_bit_len(m);
        return UnpackResult { mantissa: m << s, exponent: e - s };
    }

    let m = (0x8000000000000000 as u64) | (raw_mantissa << shift);
    let e = (raw_exp - 1) + min_exp;
    return UnpackResult { mantissa: m, exponent: e };
}

pub fn unrounded_floor(u: u64) -> u64 {
    return (u + 0) >> 2;
}

pub fn unrounded_round(u: u64) -> u64 {
    return (u + 1 + ((u >> 2) & 1)) >> 2;
}

pub fn unrounded_ceil(u: u64) -> u64 {
    return (u + 3) >> 2;
}

pub fn unrounded_nudge(u: u64, delta: i32) -> u64 {
    return (u as i64 + (delta as i64)) as u64;
}

pub fn unrounded_div(u: u64, d: u64) -> u64 {
    let q = u / d;
    let r = u % d;
    return q | (u & 1) | ((r != 0) as u64);
}

pub struct PmHiLo {
    hi: u64,
    lo: u64,
}

pub fn get_pow10(p: i32) -> PmHiLo {
    let idx = p - POW10_MIN;
    assert idx >= 0 && idx < 696, "get_pow10: p must be in range -348..347";
    return POW10_TAB[idx];
}

// uscale computes unround(x * 2^e * 10^p) using the pow10 table
pub fn uscale(x: u64, pm_hi: u64, pm_lo: u64, s: i32) -> u64 {
    // Note: i64_mul_wide_u returns [low, high] but Go's bits.Mul64 returns (high, low)
    let [mid_i64, hi_tmp] = builtin::i64_mul_wide_u(x as i64, pm_hi as i64);
    let mid = mid_i64 as u64;
    let mut hi = hi_tmp as u64;

    let mut sticky = 1 as u64;

    let s_mod_64 = s & 63;
    let check_mask = (1 as u64 << s_mod_64) - 1;
    if (hi & check_mask) == 0 {
        // Go: mid2, _ := bits.Mul64(x, pm_lo) → mid2=high part, _=low part
        // Wado: [_, mid2] = i64_mul_wide_u(x, pm_lo) → _=low part, mid2=high part
        let [_, mid2_i64] = builtin::i64_mul_wide_u(x as i64, pm_lo as i64);
        let mid2 = mid2_i64 as u64;
        sticky = (mid - mid2 > 1) as u64;
        hi = hi - (mid < mid2) as u64;
    }

    return (hi >> s) | sticky;
}

// Result of formatting
pub struct FormatResult {
    digits: u64,
    exponent: i32,
}

// FixedWidth returns the n-digit decimal form of f
pub fn fixed_width(f: f64, n: i32) -> FormatResult {
    assert n <= 18, "digits must be <= 18";

    let unpack = unpack64(f);
    let m = unpack.mantissa;
    let e = unpack.exponent;

    let p = n - 1 - log10_pow2(e + 63);
    let lp = log2_pow10(p);
    let pm = get_pow10(p);
    let s = -(e + lp + 3);

    let u = uscale(m, pm.hi, pm.lo, s);
    let mut d = unrounded_round(u);

    if d >= pow10(n) {
        d = unrounded_round(unrounded_div(u, 10));
        return FormatResult { digits: d, exponent: -p + 1 };
    }

    return FormatResult { digits: d, exponent: -p };
}

// Short computes the shortest formatting of f that round-trips
pub fn short(f: f64) -> FormatResult {
    let min_exp = -1085;

    let unpack = unpack64(f);
    let m = unpack.mantissa;
    let e = unpack.exponent;

    let mut min_m: u64 = 0;
    let mut z = 11;
    let mut p: i32 = 0;

    let m_is_power_of_2 = m == (0x8000000000000000 as u64);
    if m_is_power_of_2 && e > min_exp {
        p = -skewed(e + z);
        min_m = m - (1 as u64 << (z - 2));
    } else {
        if e < min_exp {
            z = 11 + (min_exp - e);
        }
        p = -log10_pow2(e + z);
        min_m = m - (1 as u64 << (z - 1));
    }

    let max_m = m + (1 as u64 << (z - 1));
    let odd = ((m >> z) & 1) as i32;

    let lp = log2_pow10(p);
    let pm = get_pow10(p);
    let s = -(e + lp + 3);

    let dmin = unrounded_ceil(unrounded_nudge(uscale(min_m, pm.hi, pm.lo, s), odd));
    let dmax = unrounded_floor(unrounded_nudge(uscale(max_m, pm.hi, pm.lo, s), -odd));

    // Check if we can trim to fewer digits
    let d_div_10 = dmax / 10;
    let can_trim = d_div_10 * 10 >= dmin;

    if can_trim {
        let [digits, exponent] = trim_zeros(d_div_10, -(p - 1));
        return FormatResult { digits, exponent };
    }

    let mut d = dmin;
    if dmin < dmax {
        d = unrounded_round(uscale(m, pm.hi, pm.lo, s));
    }
    return FormatResult { digits: d, exponent: -p };
}

pub fn skewed(e: i32) -> i32 {
    return (e * 631305 - 261663) >> 21;
}

// Unsigned multiply (low 64 bits only, modular)
pub fn u64_mul(a: u64, b: u64) -> u64 {
    // Use wide multiply and take the low part
    let [lo, _] = builtin::i64_mul_wide_u(a as i64, b as i64);
    return lo as u64;  // Low 64 bits
}

pub fn trim_zeros(x: u64, p: i32) -> [u64, i32] {
    let inv5 = 0xcccccccccccccccd as u64;
    let inv5p2 = 0x8f5c28f5c28f5c29 as u64;
    let inv5p4 = 0xd288ce703afb7e91 as u64;
    let inv5p8 = 0xc767074b22e90e21 as u64;

    // Threshold values
    let thresh_10 = 1844674407370955161 as u64;  // maxUint64 / 10
    let thresh_100 = 184467440737095516 as u64;  // maxUint64 / 100
    let thresh_10000 = 1844674407370955 as u64;  // maxUint64 / 10000
    let thresh_1e8 = 184467440737 as u64;        // maxUint64 / 100000000

    let mut xv = x;
    let mut pv = p;

    let d1 = rotate_right(u64_mul(xv, inv5), 1);
    if d1 <= thresh_10 {
        xv = d1;
        pv = pv + 1;
    } else {
        return [xv, pv];
    }

    let d8 = rotate_right(u64_mul(xv, inv5p8), 8);
    if d8 <= thresh_1e8 {
        xv = d8;
        pv = pv + 8;
    }

    let d4 = rotate_right(u64_mul(xv, inv5p4), 4);
    if d4 <= thresh_10000 {
        xv = d4;
        pv = pv + 4;
    }

    let d2 = rotate_right(u64_mul(xv, inv5p2), 2);
    if d2 <= thresh_100 {
        xv = d2;
        pv = pv + 2;
    }

    let d1b = rotate_right(u64_mul(xv, inv5), 1);
    if d1b <= thresh_10 {
        xv = d1b;
        pv = pv + 1;
    }

    return [xv, pv];
}

pub fn rotate_right(x: u64, n: i32) -> u64 {
    return (x >> n) | (x << (64 - n));
}

// digits returns the number of decimal digits in d
pub fn digits(d: u64) -> i32 {
    let nd = log10_pow2(u64_bit_len(d));
    return nd + (d >= pow10(nd)) as i32;
}

fn i2a_first(n: i32) -> char {
    return (('0' as i32) + n / 10) as char;
}

fn i2a_second(n: i32) -> char {
    return (('0' as i32) + n % 10) as char;
}

// Format result to decimal string (no exponent)
pub fn format_decimal(d: u64, p: i32, nd: i32) -> String {
    let mut buf = String::with_capacity(30);

    // Convert digits to character array
    let mut val = d;
    let mut digit_chars: Array<i32> = [];
    for let mut i = 0; i < nd; i += 1 {
        digit_chars.append(0);
    }

    let mut idx = nd - 1;
    while idx >= 0 {
        digit_chars.set(idx, ('0' as i32) + ((val % 10) as i32));
        val = val / 10;
        idx = idx - 1;
    }

    // decimal_pos is where the decimal point goes (0-indexed from left)
    // e.g., digits=314, p=-2, nd=3 → decimal_pos = 3 + (-2) = 1 → "3.14"
    let decimal_pos = nd + p;

    if decimal_pos <= 0 {
        // Need leading zeros: 0.00...digits
        buf.append("0.");
        for let mut i = 0; i < -decimal_pos; i += 1 {
            buf.append_char('0');
        }
        for let mut i = 0; i < nd; i += 1 {
            buf.append_char(digit_chars.get(i) as char);
        }
    } else if decimal_pos >= nd {
        // Integer with trailing zeros: digits000...
        for let mut i = 0; i < nd; i += 1 {
            buf.append_char(digit_chars.get(i) as char);
        }
        for let mut i = 0; i < decimal_pos - nd; i += 1 {
            buf.append_char('0');
        }
    } else {
        // Decimal point in the middle: dig.its
        for let mut i = 0; i < decimal_pos; i += 1 {
            buf.append_char(digit_chars.get(i) as char);
        }
        buf.append_char('.');
        for let mut i = decimal_pos; i < nd; i += 1 {
            buf.append_char(digit_chars.get(i) as char);
        }
    }

    return buf;
}

// Format result to exponential string (upper: true for 'E', false for 'e')
pub fn format_exp(d: u64, p: i32, nd: i32, upper: bool) -> String {
    let mut buf = String::with_capacity(30);

    // Format digits
    let mut val = d;
    let mut digit_chars: Array<i32> = [];
    for let mut i = 0; i < nd; i += 1 {
        digit_chars.append(0);
    }

    let mut idx = nd - 1;
    while idx >= 0 {
        digit_chars.set(idx, ('0' as i32) + ((val % 10) as i32));
        val = val / 10;
        idx = idx - 1;
    }

    // First digit
    buf.append_char(digit_chars.get(0) as char);

    // Decimal point and remaining digits
    if nd > 1 {
        buf.append_char('.');
        for let mut i = 1; i < nd; i += 1 {
            buf.append_char(digit_chars.get(i) as char);
        }
    }

    // Exponent
    let exp = p + nd - 1;
    buf.append_char(if upper { 'E' } else { 'e' });
    if exp < 0 {
        buf.append_char('-');
    } else {
        buf.append_char('+');
    }

    let abs_exp = if exp < 0 { -exp } else { exp };
    if abs_exp < 10 {
        buf.append_char('0');
        buf.append_char((('0' as i32) + abs_exp) as char);
    } else if abs_exp < 100 {
        buf.append_char(i2a_first(abs_exp));
        buf.append_char(i2a_second(abs_exp));
    } else {
        buf.append_char((('0' as i32) + abs_exp / 100) as char);
        buf.append_char(i2a_first(abs_exp % 100));
        buf.append_char(i2a_second(abs_exp % 100));
    }

    return buf;
}

// ============================================================================
// Format Specifier Types (Rust-compatible)
// ============================================================================

/// Alignment mode for formatted output
pub variant Align {
    Left,    // '<' - left-aligned
    Center,  // '^' - center-aligned
    Right,   // '>' - right-aligned (default for numbers)
}

/// Sign display mode
pub variant Sign {
    Minus,   // (default) only show minus sign for negative
    Plus,    // '+' always show sign
    Space,   // ' ' space for positive, minus for negative
}

/// Format type for floating-point numbers
pub variant FormatType {
    Default,   // default decimal notation
    LowerExp,  // 'e' - lowercase exponential (1.23e+04)
    UpperExp,  // 'E' - uppercase exponential (1.23E+04)
}

/// Format specification for floating-point formatting
/// Matches Rust's format syntax: [[fill]align][sign][#][0][width][.precision]type
pub struct FormatSpec {
    fill: char,          // fill character (default ' ')
    align: Align,        // alignment mode
    sign: Sign,          // sign display mode
    zero_pad: bool,      // '0' flag - zero padding
    width: i32,          // minimum width (-1 for none)
    precision: i32,      // precision (-1 for default/shortest)
    format_type: FormatType, // format type
}

impl FormatSpec {
    /// Create default format spec (no special formatting)
    pub fn default() -> FormatSpec {
        return FormatSpec {
            fill: ' ',
            align: Align::Right,
            sign: Sign::Minus,
            zero_pad: false,
            width: -1,
            precision: -1,
            format_type: FormatType::Default,
        };
    }

    /// Create format spec for exponential notation
    pub fn exp(upper: bool) -> FormatSpec {
        return FormatSpec {
            fill: ' ',
            align: Align::Right,
            sign: Sign::Minus,
            zero_pad: false,
            width: -1,
            precision: -1,
            format_type: if upper { FormatType::UpperExp } else { FormatType::LowerExp },
        };
    }

    /// Create format spec with precision
    pub fn with_precision(prec: i32) -> FormatSpec {
        return FormatSpec {
            fill: ' ',
            align: Align::Right,
            sign: Sign::Minus,
            zero_pad: false,
            width: -1,
            precision: prec,
            format_type: FormatType::Default,
        };
    }

    /// Create format spec with width
    pub fn with_width(w: i32) -> FormatSpec {
        return FormatSpec {
            fill: ' ',
            align: Align::Right,
            sign: Sign::Minus,
            zero_pad: false,
            width: w,
            precision: -1,
            format_type: FormatType::Default,
        };
    }

    /// Create format spec with width and precision
    pub fn with_width_precision(w: i32, prec: i32) -> FormatSpec {
        return FormatSpec {
            fill: ' ',
            align: Align::Right,
            sign: Sign::Minus,
            zero_pad: false,
            width: w,
            precision: prec,
            format_type: FormatType::Default,
        };
    }
}

// ============================================================================
// Format with Precision (core implementation)
// ============================================================================

/// Format f64 to decimal string with specified precision (digits after decimal point)
/// precision < 0 means use shortest representation
pub fn format_decimal_prec(d: i64, p: i32, nd: i32, precision: i32) -> String {
    if precision < 0 {
        // Use shortest representation
        return format_decimal(d, p, nd);
    }

    // precision specifies digits after decimal point
    let mut buf = String::with_capacity(30);

    // Convert digits to character array
    let mut val = d;
    let mut digit_chars: Array<i32> = [];
    for let mut i = 0; i < nd; i += 1 {
        digit_chars.append(0);
    }

    let mut idx = nd - 1;
    while idx >= 0 {
        digit_chars.set(idx, ('0' as i32) + ((val % 10 as i64) as i32));
        val = val / 10 as i64;
        idx = idx - 1;
    }

    // decimal_pos is where the decimal point goes (0-indexed from left)
    let decimal_pos = nd + p;

    // Calculate how many digits we have after the decimal point
    let digits_after_decimal = if decimal_pos <= 0 {
        nd + (-decimal_pos)  // leading zeros + all digits
    } else if decimal_pos >= nd {
        0  // all digits before decimal
    } else {
        nd - decimal_pos  // digits after decimal point
    };

    if decimal_pos <= 0 {
        // Need leading zeros: 0.00...digits
        buf.append("0.");
        // Leading zeros before digits
        let leading_zeros = -decimal_pos;
        if precision <= leading_zeros {
            // Precision is less than leading zeros - output 0.000...
            for let mut i = 0; i < precision; i += 1 {
                buf.append_char('0');
            }
        } else {
            // Output leading zeros then digits
            for let mut i = 0; i < leading_zeros; i += 1 {
                buf.append_char('0');
            }
            // How many digits to output
            let remaining_prec = precision - leading_zeros;
            let digits_to_output = if remaining_prec < nd { remaining_prec } else { nd };
            for let mut i = 0; i < digits_to_output; i += 1 {
                buf.append_char(digit_chars.get(i) as char);
            }
            // Trailing zeros if needed
            let trailing = precision - leading_zeros - digits_to_output;
            for let mut i = 0; i < trailing; i += 1 {
                buf.append_char('0');
            }
        }
    } else if decimal_pos >= nd {
        // Integer part only: digits000...
        for let mut i = 0; i < nd; i += 1 {
            buf.append_char(digit_chars.get(i) as char);
        }
        for let mut i = 0; i < decimal_pos - nd; i += 1 {
            buf.append_char('0');
        }
        if precision > 0 {
            buf.append_char('.');
            for let mut i = 0; i < precision; i += 1 {
                buf.append_char('0');
            }
        }
    } else {
        // Decimal point in the middle: dig.its
        for let mut i = 0; i < decimal_pos; i += 1 {
            buf.append_char(digit_chars.get(i) as char);
        }
        buf.append_char('.');
        // How many digits after decimal
        let after_decimal = nd - decimal_pos;
        if precision <= after_decimal {
            // Only output precision digits
            for let mut i = decimal_pos; i < decimal_pos + precision; i += 1 {
                buf.append_char(digit_chars.get(i) as char);
            }
        } else {
            // Output all digits then trailing zeros
            for let mut i = decimal_pos; i < nd; i += 1 {
                buf.append_char(digit_chars.get(i) as char);
            }
            let trailing = precision - after_decimal;
            for let mut i = 0; i < trailing; i += 1 {
                buf.append_char('0');
            }
        }
    }

    return buf;
}

/// Format f64 to exponential string with specified precision (digits after decimal point)
/// precision < 0 means use shortest representation
pub fn format_exp_prec(d: i64, p: i32, nd: i32, precision: i32, upper: bool) -> String {
    if precision < 0 {
        // Use shortest representation
        return format_exp(d, p, nd, upper);
    }

    let mut buf = String::with_capacity(30);

    // Convert digits to character array
    let mut val = d;
    let mut digit_chars: Array<i32> = [];
    for let mut i = 0; i < nd; i += 1 {
        digit_chars.append(0);
    }

    let mut idx = nd - 1;
    while idx >= 0 {
        digit_chars.set(idx, ('0' as i32) + ((val % 10 as i64) as i32));
        val = val / 10 as i64;
        idx = idx - 1;
    }

    // First digit
    buf.append_char(digit_chars.get(0) as char);

    // Decimal point and remaining digits based on precision
    if precision > 0 {
        buf.append_char('.');
        // Output digits after first (up to precision)
        let available = nd - 1;
        let to_output = if precision < available { precision } else { available };
        for let mut i = 1; i <= to_output; i += 1 {
            buf.append_char(digit_chars.get(i) as char);
        }
        // Trailing zeros if needed
        let trailing = precision - to_output;
        for let mut i = 0; i < trailing; i += 1 {
            buf.append_char('0');
        }
    }

    // Exponent
    let exp = p + nd - 1;
    buf.append_char(if upper { 'E' } else { 'e' });
    if exp < 0 {
        buf.append_char('-');
    } else {
        buf.append_char('+');
    }

    let abs_exp = if exp < 0 { -exp } else { exp };
    if abs_exp < 10 {
        buf.append_char('0');
        buf.append_char((('0' as i32) + abs_exp) as char);
    } else if abs_exp < 100 {
        buf.append_char(i2a_first(abs_exp));
        buf.append_char(i2a_second(abs_exp));
    } else {
        buf.append_char((('0' as i32) + abs_exp / 100) as char);
        buf.append_char(i2a_first(abs_exp % 100));
        buf.append_char(i2a_second(abs_exp % 100));
    }

    return buf;
}

// ============================================================================
// Padding and Alignment
// ============================================================================

/// Apply padding and alignment to a string
pub fn apply_padding(s: String, spec: FormatSpec, is_neg: bool) -> String {
    let width = spec.width;
    if width <= 0 || s.len() >= width {
        return s;
    }

    let fill = spec.fill;
    let pad_len = width - s.len();

    // Handle sign prefix for zero-padding
    if spec.zero_pad {
        // Zero-padding: sign goes before zeros
        let mut result = String::with_capacity(width);

        // Add sign prefix if present in original string
        let mut start_idx = 0;
        if s.len() > 0 && (s.get_byte(0) == '-' as i32 || s.get_byte(0) == '+' as i32) {
            result.append_char(s.get_byte(0) as char);
            start_idx = 1;
        }

        // Add zeros
        for let mut i = 0; i < pad_len; i += 1 {
            result.append_char('0');
        }

        // Add rest of string
        for let mut i = start_idx; i < s.len(); i += 1 {
            result.append_char(s.get_byte(i) as char);
        }

        return result;
    }

    // Normal padding based on alignment
    let mut result = String::with_capacity(width);

    return match spec.align {
        Left => {
            // String first, then padding
            result.append(s);
            for let mut i = 0; i < pad_len; i += 1 {
                result.append_char(fill);
            }
            result
        },
        Center => {
            // Padding split around string
            let left_pad = pad_len / 2;
            let right_pad = pad_len - left_pad;
            for let mut i = 0; i < left_pad; i += 1 {
                result.append_char(fill);
            }
            result.append(s);
            for let mut i = 0; i < right_pad; i += 1 {
                result.append_char(fill);
            }
            result
        },
        Right => {
            // Padding first, then string
            for let mut i = 0; i < pad_len; i += 1 {
                result.append_char(fill);
            }
            result.append(s);
            result
        },
    };
}

/// Add sign prefix to a string
pub fn add_sign_prefix(s: String, is_neg: bool, sign: Sign) -> String {
    if is_neg {
        return String::concat("-", s);
    }

    return match sign {
        Minus => s,
        Plus => String::concat("+", s),
        Space => String::concat(" ", s),
    };
}

// ============================================================================
// Main Format Function with FormatSpec
// ============================================================================

/// Format f64 with full format specification
pub fn format_f64(f: f64, spec: FormatSpec) -> String {
    let [is_special, is_neg, special_str] = check_special(f);
    if is_special {
        // Special value (zero, inf, NaN)
        let base_str = if is_neg && special_str != "NaN" && special_str != "Inf" && special_str != "-Inf" {
            // Negative zero
            let is_exp = match spec.format_type {
                LowerExp => true,
                UpperExp => true,
                Default => false,
            };
            if is_exp {
                let upper = match spec.format_type {
                    UpperExp => true,
                    _ => false,
                };
                if spec.precision > 0 {
                    // Build -0.00...e+00 with correct precision
                    let mut result = String::with_capacity(10 + spec.precision);
                    result.append("-0.");
                    for let mut i = 0; i < spec.precision; i += 1 {
                        result.append_char('0');
                    }
                    if upper { result.append("E+00"); } else { result.append("e+00"); }
                    result
                } else {
                    if upper { "-0E+00" } else { "-0e+00" }
                }
            } else {
                // Decimal format for negative zero
                if spec.precision > 0 {
                    let mut result = String::with_capacity(4 + spec.precision);
                    result.append("-0.");
                    for let mut i = 0; i < spec.precision; i += 1 {
                        result.append_char('0');
                    }
                    result
                } else {
                    "-0"
                }
            }
        } else if special_str == "0" {
            // Positive zero
            let is_exp = match spec.format_type {
                LowerExp => true,
                UpperExp => true,
                Default => false,
            };
            if is_exp {
                let upper = match spec.format_type {
                    UpperExp => true,
                    _ => false,
                };
                if spec.precision > 0 {
                    // Build 0.00...e+00 with correct precision
                    let mut result = String::with_capacity(8 + spec.precision);
                    result.append("0.");
                    for let mut i = 0; i < spec.precision; i += 1 {
                        result.append_char('0');
                    }
                    if upper { result.append("E+00"); } else { result.append("e+00"); }
                    result
                } else {
                    if upper { "0E+00" } else { "0e+00" }
                }
            } else {
                // Decimal format for positive zero
                if spec.precision > 0 {
                    let mut result = String::with_capacity(3 + spec.precision);
                    result.append("0.");
                    for let mut i = 0; i < spec.precision; i += 1 {
                        result.append_char('0');
                    }
                    result
                } else {
                    "0"
                }
            }
        } else {
            special_str
        };
        return apply_padding(base_str, spec, is_neg);
    }
    let abs_f = if is_neg { -f } else { f };

    // Get the raw digits and exponent
    let result = if spec.precision >= 0 {
        // Fixed precision - first get shortest to know exponent, then compute needed digits
        let short_result = short(abs_f);
        let short_nd = digits(short_result.digits);
        let decimal_pos = short_nd + short_result.exponent;

        // For decimal format, we need integer_part_digits + precision
        // For exponential format, we need 1 (integer) + precision
        let is_exp = match spec.format_type {
            LowerExp => true,
            UpperExp => true,
            Default => false,
        };

        let total_digits = if is_exp {
            // Exponential: 1 digit before decimal + precision after
            spec.precision + 1
        } else {
            // Decimal: all integer digits + precision decimal digits
            let int_digits = if decimal_pos > 0 { decimal_pos } else { 1 };
            int_digits + spec.precision
        };

        let clamped = if total_digits > 18 { 18 } else if total_digits < 1 { 1 } else { total_digits };
        fixed_width(abs_f, clamped)
    } else {
        // Shortest representation
        short(abs_f)
    };

    let d = result.digits;
    let p = result.exponent;
    let nd = digits(d);

    // Format based on type
    let formatted = match spec.format_type {
        Default => format_decimal_prec(d, p, nd, spec.precision),
        LowerExp => format_exp_prec(d, p, nd, spec.precision, false),
        UpperExp => format_exp_prec(d, p, nd, spec.precision, true),
    };

    // Add sign
    let with_sign = add_sign_prefix(formatted, is_neg, spec.sign);

    // Apply padding
    return apply_padding(with_sign, spec, is_neg);
}

// ============================================================================
// Convenience Functions with Format Spec
// ============================================================================

/// Format f64 with precision only
pub fn f64_to_string_prec(f: f64, precision: i32) -> String {
    let mut spec = FormatSpec::default();
    spec.precision = precision;
    return format_f64(f, spec);
}

/// Format f64 exponential with precision
pub fn f64_to_string_exp_prec(f: f64, precision: i32, upper: bool) -> String {
    let mut spec = FormatSpec::exp(upper);
    spec.precision = precision;
    return format_f64(f, spec);
}

/// Format f64 with width and precision
pub fn f64_to_string_width_prec(f: f64, width: i32, precision: i32) -> String {
    let mut spec = FormatSpec::with_width_precision(width, precision);
    return format_f64(f, spec);
}

/// Format f64 with sign always shown
pub fn f64_to_string_signed(f: f64) -> String {
    let mut spec = FormatSpec::default();
    spec.sign = Sign::Plus;
    return format_f64(f, spec);
}

/// Format f64 with sign and precision
pub fn f64_to_string_signed_prec(f: f64, precision: i32) -> String {
    let mut spec = FormatSpec::default();
    spec.sign = Sign::Plus;
    spec.precision = precision;
    return format_f64(f, spec);
}

/// Format f64 with zero padding
pub fn f64_to_string_zero_pad(f: f64, width: i32) -> String {
    let mut spec = FormatSpec::with_width(width);
    spec.zero_pad = true;
    return format_f64(f, spec);
}

/// Format f64 with zero padding and precision
pub fn f64_to_string_zero_pad_prec(f: f64, width: i32, precision: i32) -> String {
    let mut spec = FormatSpec::with_width_precision(width, precision);
    spec.zero_pad = true;
    return format_f64(f, spec);
}

/// Format f64 left-aligned with width
pub fn f64_to_string_left(f: f64, width: i32) -> String {
    let mut spec = FormatSpec::with_width(width);
    spec.align = Align::Left;
    return format_f64(f, spec);
}

/// Format f64 center-aligned with width
pub fn f64_to_string_center(f: f64, width: i32) -> String {
    let mut spec = FormatSpec::with_width(width);
    spec.align = Align::Center;
    return format_f64(f, spec);
}

/// Format f64 with custom fill character
pub fn f64_to_string_fill(f: f64, width: i32, fill: char, align: Align) -> String {
    let mut spec = FormatSpec::with_width(width);
    spec.fill = fill;
    spec.align = align;
    return format_f64(f, spec);
}

// ============================================================================
// Public API
// ============================================================================

// Helper: check for special values (zero, infinity, NaN)
// Returns: [is_special, is_neg, special_string_or_empty]
pub fn check_special(f: f64) -> [bool, bool, String] {
    let bits = builtin::i64_reinterpret_f64(f);

    // Check for zero
    if bits == 0 as i64 {
        return [true, false, "0"];
    }
    if bits == 0x8000000000000000 as i64 {
        return [true, true, "0"];
    }

    let is_neg = bits < 0 as i64;

    // Check for infinity/NaN
    let exp_mask = 0x7FF0000000000000 as i64;
    let mantissa_mask = 0x000FFFFFFFFFFFFF as i64;
    if (bits & exp_mask) == exp_mask {
        if (bits & mantissa_mask) != 0 as i64 {
            return [true, false, "NaN"];
        }
        if is_neg {
            return [true, false, "-Inf"];
        }
        return [true, false, "Inf"];
    }

    return [false, is_neg, ""];
}

// Convert f64 to decimal string (no exponent, e.g., "3.14", "0.001", "12345")
pub fn f64_to_string(f: f64) -> String {
    let [is_special, is_neg, special_str] = check_special(f);
    if is_special {
        if is_neg {
            return String::concat("-", special_str);
        }
        return special_str;
    }
    let abs_f = if is_neg { -f } else { f };

    let result = short(abs_f);
    let d = result.digits;
    let p = result.exponent;
    let nd = digits(d);

    let formatted = format_decimal(d, p, nd);

    if is_neg {
        return String::concat("-", formatted);
    }
    return formatted;
}

// Convert f64 to exponential string (e.g., "3.14e+00" or "3.14E+00")
// upper: true for 'E', false for 'e'
pub fn f64_to_string_exp(f: f64, upper: bool) -> String {
    let [is_special, is_neg, special_str] = check_special(f);
    if is_special {
        // For exponential format, zero is "0e+00" or "0E+00"
        if special_str == "0" {
            if is_neg {
                return if upper { "-0E+00" } else { "-0e+00" };
            }
            return if upper { "0E+00" } else { "0e+00" };
        }
        return special_str;
    }
    let abs_f = if is_neg { -f } else { f };

    let result = short(abs_f);
    let d = result.digits;
    let p = result.exponent;
    let nd = digits(d);

    let formatted = format_exp(d, p, nd, upper);

    if is_neg {
        return String::concat("-", formatted);
    }
    return formatted;
}

// Convert f64 to string, choosing decimal or exponential based on magnitude
// Similar to Rust's Debug: uses exponential if exponent < -4 or >= 16
pub fn f64_to_string_auto(f: f64) -> String {
    let [is_special, is_neg, special_str] = check_special(f);
    if is_special {
        if is_neg {
            return String::concat("-", special_str);
        }
        return special_str;
    }
    let abs_f = if is_neg { -f } else { f };

    let result = short(abs_f);
    let d = result.digits;
    let p = result.exponent;
    let nd = digits(d);

    // Actual exponent in scientific notation: p + nd - 1
    // e.g., digits=314, p=-2, nd=3 → exp = -2 + 3 - 1 = 0 (3.14e+00)
    let exp = p + nd - 1;

    // Use exponential format for cleaner representation in edge cases:
    // - exp < -4: very small numbers with many leading zeros (e.g., 0.00001 -> 1e-05)
    // - exp >= 16: very large numbers where decimal would be unwieldy
    // This provides user-friendly output similar to Rust's Debug format
    let formatted = if exp < -4 || exp >= 16 {
        format_exp(d, p, nd, false)
    } else {
        format_decimal(d, p, nd)
    };

    if is_neg {
        return String::concat("-", formatted);
    }
    return formatted;
}

// ============================================================================
// f32 wrappers (cast to f64)
// ============================================================================

// Convert f32 to decimal string
pub fn f32_to_string(f: f32) -> String {
    return f64_to_string(f as f64);
}

// Convert f32 to exponential string
pub fn f32_to_string_exp(f: f32, upper: bool) -> String {
    return f64_to_string_exp(f as f64, upper);
}

// Convert f32 to string with auto mode
pub fn f32_to_string_auto(f: f32) -> String {
    return f64_to_string_auto(f as f64);
}


