{
  "env": {
    "PATH": "$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH",
    "MISE_YES": "true",
    "MISE_TRUSTED_CONFIG_PATHS": "$HOME:$PWD"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/mise-setup.sh"
          }
        ]
      }
    ]
  }
}
