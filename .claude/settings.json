{
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "AskUserQuestion",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(nohup:*)",
      "Bash(setsid:*)",
      "Bash(disown:*)",
      "Read(vendor/antlr4/tool/**/*.java)",
      "Read(vendor/antlr4/tool/**/*.g)",
      "Read(vendor/antlr4/runtime/**/*.java)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/mise-setup.sh"
          },
          {
            "type": "command",
            "command": "./.claude/hooks/cargo-cache-restore.mts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/incremental-gc.sh"
          },
          {
            "type": "command",
            "command": "./.claude/hooks/bash-pipefail.sh"
          },
          {
            "type": "command",
            "command": "./.claude/hooks/antlr4-license-guard.sh"
          },
          {
            "type": "command",
            "command": "./.claude/hooks/forbidden-commands.mts"
          }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/pr-conventions.sh"
          }
        ]
      }
    ]
  }
}
