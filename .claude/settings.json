{
  "outputStyle": "Concise",
  "autoMemoryEnabled": false,
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Agent",
      "AskUserQuestion",
      "mcp__Claude_Code_Remote__create_session",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(perl:*)",
      "Bash(nohup:*)",
      "Bash(setsid:*)",
      "Bash(disown:*)",
      "Read(vendor/antlr4/tool/**/*.java)",
      "Read(vendor/antlr4/tool/**/*.g)",
      "Read(vendor/antlr4/runtime/**/*.java)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/mise-setup.sh"
          },
          {
            "type": "command",
            "command": "./.claude/hooks/cargo-cache-restore.mts"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/code-review-followup.mts"
          },
          {
            "type": "command",
            "command": "./.claude/hooks/distill-reminder.mts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/code-review-followup.mts"
          },
          {
            "type": "command",
            "command": "./.claude/hooks/distill-reminder.mts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/distill-reminder.mts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/incremental-gc.sh"
          },
          {
            "type": "command",
            "command": "./.claude/hooks/bash-rewrite.mts"
          },
          {
            "type": "command",
            "command": "./.claude/hooks/antlr4-license-guard.sh"
          },
          {
            "type": "command",
            "command": "./.claude/hooks/forbidden-commands.mts"
          },
          {
            "type": "command",
            "command": "./.claude/hooks/pr-conventions.mts"
          }
        ]
      },
      {
        "matcher": "mcp__github__(create|update)_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/pr-conventions.mts"
          }
        ]
      }
    ]
  }
}
