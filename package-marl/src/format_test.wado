use { format } from "./format.wado";

test "format is idempotent" {
    let source = "# Title\n\nSome *text* with a [link](https://example.com).\n\n- a\n- b\n";
    let once = format(source);
    let twice = format(once);
    assert once == twice;
}

test "format normalizes a heading and collapses inline whitespace runs" {
    assert format("#   Title   \n\nhello   world") == "# Title\n\nhello world\n";
}

test "format keeps a list item that only looks like a reference definition" {
    let source = "- [a]: Who Verifies the Tools? How Warped\n  Formatters Mislead (2026)\n\n[a]: https://example.com\n";
    assert format(source) == source;
}

test "format keeps an inline link whose title is malformed as text" {
    let source = "see [x](https://example.com not a title) here\n";
    assert format(source) == source;
}

test "format reprints a title holding a double quote so that it parses back" {
    assert format("[a]: /url 'say \"hi\"'\n\n[a]\n") == "[a]: /url \"say \\\"hi\\\"\"\n\n[a]\n";
    assert format("![i](/p 'q \"r\"')\n") == "![i](/p \"q \\\"r\\\"\")\n";
}

test "format keeps a destination with a space in angle brackets" {
    assert format("[a]: <x y> 't'\n\n[a]\n") == "[a]: <x y> \"t\"\n\n[a]\n";
}

test "format joins a title on the next line to its link" {
    assert format("[x](https://e.com\n\"t\")\n") == "[x](https://e.com \"t\")\n";
}

test "format leaves a bare url as plain text" {
    assert format("see https://example.com/x here\n") == "see https://example.com/x here\n";
}

test "format keeps a bare url in parentheses intact" {
    assert format("a port of zlib (https://github.com/madler/zlib).\n") == "a port of zlib (https://github.com/madler/zlib).\n";
}

test "format preserves an angle-bracketed autolink" {
    assert format("<https://example.com>\n") == "<https://example.com>\n";
}

test "format keeps a wrapped line starting with a number and a parenthesis in its paragraph" {
    assert format("a (SAC\n2010) b\n") == "a (SAC\n2010) b\n";
}

test "format keeps a lazy continuation line in its blockquote" {
    assert format("> a\nb\n") == format("> a\n> b\n");
}

test "format keeps a continuation line that would start a block in its paragraph" {
    assert format("a\n    - b\n") == "a\n    - b\n";
    assert format("a\n    # h\n") == "a\n    # h\n";
    assert format("> a\n    - b\n") == "> a\n>     - b\n";
    assert format("- [ ] outer\n      - inner\n") == "- [ ] outer\n      - inner\n";
}

test "format keeps an all-same ordered list numbering" {
    assert format("1. a\n1. b\n1. c\n") == "1. a\n1. b\n1. c\n";
}

test "format renumbers an incrementing ordered list sequentially" {
    assert format("1. a\n2. b\n3. c\n") == "1. a\n2. b\n3. c\n";
}

test "format renumbers sequentially from a non-one start when items differ" {
    assert format("3. a\n1. b\n1. c\n") == "3. a\n4. b\n5. c\n";
}

test "format keeps a code span that wraps a soft line break intact" {
    // A tag-like `<n>` at the start of the code span's second line must not
    // split the paragraph; the code span is joined with its newline as a
    // single space and its internal spacing preserved.
    let src = "x `<r> <u>/s   (<m> ms,\n<n> it)` y\n";
    assert format(src) == "x `<r> <u>/s   (<m> ms, <n> it)` y\n";
}
