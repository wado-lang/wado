//! Marl Format's standalone CLI — a `wasi:cli/command` program (`wado run`,
//! or compiled and run with any Component-Model runtime).
//! See `docs/wep-2026-07-05-marl.md`, "A standalone CLI".

use { println, eprintln, exit_error, Stdout, Stderr, Environment, Exit } from "core:cli";
use { from_env } from "core:args";
use { Deserialize } from "core:serde";
use { TreeSet } from "core:collections";
use fs from "core:fs";
use { Preopens } from "core:fs";
use { format } from "./format.wado";

struct Cli {
    /// Files or directories to format; empty means the whole preopened tree.
    #[wire(positional)]
    paths: List<String> = [],
    check: bool = false,
}
impl Deserialize for Cli;

global EXCLUDED_DIRS: List<String> = [".vscode-test", "vendor", "target", "node_modules", ".git"];

export fn run() with (Stdout, Stderr, Environment, Preopens, Exit) {
    let cli = match from_env::<Cli>() {
        Ok(c) => c,
        Err(e) => {
            eprintln(`marl-format: ${e.message}`);
            exit_error();
        },
    };
    // No path argument walks the whole preopened tree, which is the root path.
    let roots: List<String> = if cli.paths.is_empty() { [""] } else { cli.paths };
    let files = match resolve_paths(&roots) {
        Ok(f) => f,
        Err(e) => {
            eprintln(`marl-format: cannot read directory ${e}`);
            exit_error();
        },
    };

    let mut had_changes = false;
    let mut had_errors = false;
    for let path of files {
        let original = match fs::read_to_string(&path) {
            Ok(s) => s,
            Err(e) => {
                eprintln(`marl-format: cannot read ${e}`);
                had_errors = true;
                continue;
            },
        };
        let formatted = format(original);
        if formatted == original {
            continue;
        }
        had_changes = true;
        if cli.check {
            println(`would reformat: ${path}`);
        } else {
            match fs::write(&path, &formatted) {
                Ok(_) => println(`formatted: ${path}`),
                Err(e) => {
                    eprintln(`marl-format: cannot write ${e}`);
                    had_errors = true;
                },
            }
        }
    }

    if had_errors || cli.check && had_changes {
        exit_error();
    }
}

/// Collects `*.md` files under `dir`, skipping `EXCLUDED_DIRS`. `dir` is the
/// path from the preopened root, empty at the root itself.
fn collect_md_files<S: AsStrSlice>(dir: S) -> Result<List<String>, fs::FsError> with Preopens {
    let mut out: List<String> = [];
    for let entry of fs::walk_dir(dir, |found| !is_excluded_dir(found))? {
        if entry.type matches { File } && entry.path.ends_with(".md") {
            out.push(entry.path);
        }
    }
    return Result::Ok(out);
}

fn is_excluded_dir(entry: &fs::WalkEntry) -> bool {
    let Some(name) = fs::file_name(&entry.path) else {
        return false;
    };
    for let excluded of EXCLUDED_DIRS {
        if name == excluded {
            return true;
        }
    }
    return false;
}

/// Resolves explicit CLI path arguments: a directory is walked, anything else
/// is taken as one file.
fn resolve_paths(paths: &List<String>) -> Result<List<String>, fs::FsError> with Preopens {
    let mut out: List<String> = [];
    for let path of paths {
        // A path the host will not stat is taken as a file, so the loop that
        // reads each one reports it and the rest are still formatted.
        let walk = match fs::metadata(path) {
            Ok(found) => found.type matches { Directory },
            Err(_) => false,
        };
        if !walk {
            out.push(*path);
            continue;
        }
        let walked = collect_md_files(path)?;
        out.extend(&walked);
    }
    return Result::Ok(unique_sorted(out));
}

/// Returns the paths in sorted order with duplicates removed, so overlapping
/// arguments (a directory plus a file inside it, or the same path twice) don't
/// format or report the same file more than once. `seen` drops a path the
/// first time it recurs.
fn unique_sorted(items: List<String>) -> List<String> {
    let mut seen: TreeSet<String> = TreeSet::new();
    let mut out: List<String> = [];
    for let item of items {
        if seen.insert(item) {
            out.push(item);
        }
    }
    out.sort();
    return out;
}

test "a path that names nothing is left for the caller to report" {
    // The loop that reads each file names the one that is missing, so a single
    // bad argument no longer aborts a run that also has good ones.
    let paths: List<String> = ["no-such-directory", "also-missing.md"];
    assert resolve_paths(&paths).unwrap() == ["also-missing.md", "no-such-directory"];
}

test "unique_sorted removes duplicates and sorts" {
    let items: List<String> = ["sub/c.md", "a.md", "a.md", "b.md", "sub/c.md"];
    assert unique_sorted(items) == ["a.md", "b.md", "sub/c.md"];
}

test "unique_sorted leaves a distinct list sorted" {
    let items: List<String> = ["b.md", "a.md", "c.md"];
    assert unique_sorted(items) == ["a.md", "b.md", "c.md"];
}
