//! Marl — Markdown Adaptive Rendering Layer.
//!
//! A Markdown-to-HTML renderer (`render`) and a Markdown-to-Markdown
//! formatter (`format`), sharing one parser and AST (`fmt_*.wado`): `render`
//! walks the tree to safe HTML, `format` prints it back to canonical
//! Markdown. See `docs/wep-2026-07-10-marl-format.md`.

pub use { render } from "./fmt_html.wado";
pub use { escape_text, escape_attr } from "./html.wado";
pub use { format } from "./format.wado";
