//! Marl — Markdown Adaptive Rendering Layer.
//!
//! A GFM-subset Markdown-to-HTML renderer (`render`) plus a standalone
//! Markdown-to-Markdown formatter (`format`, see
//! `docs/wep-2026-07-10-marl-format.md`) — two independent pipelines over
//! the same source language, sharing no code (see the WEP's "A separate AST
//! and pipeline").

pub use { render } from "./marl.wado";
pub use { escape_text, escape_attr } from "./html.wado";
pub use { format } from "./format.wado";
