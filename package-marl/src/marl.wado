//! Block-level rendering.
//!
//! v0.1 blocks: fenced code, ATX headings, thematic breaks, blockquotes, and
//! paragraphs. Inline content is rendered by `inline.wado`. Blocks are parsed
//! from a line array with an explicit index so multi-line blocks (fences,
//! blockquotes) can consume ahead and blockquotes can recurse.

use { render_inline } from "./inline.wado";
use { escape_attr } from "./html.wado";

pub fn render(source: &String) -> String {
    let normalized = source.replace("\r\n", "\n");
    let mut lines: List<String> = [];
    for let line of normalized.split("\n") {
        lines.push(line);
    }
    return render_blocks(&lines, 0, lines.len());
}

fn render_blocks(lines: &List<String>, start: i32, end: i32) -> String {
    let mut out: List<String> = [];
    let mut para: List<String> = [];
    let mut i = start;
    while i < end {
        let line = lines[i];
        if is_blank(&line) {
            flush_paragraph(&mut out, &mut para);
            i += 1;
            continue;
        }
        match fence_marker(&line) {
            Some([ch, fence_len, info]) => {
                flush_paragraph(&mut out, &mut para);
                i = render_fenced_code(lines, i, end, ch, fence_len, &info, &mut out);
                continue;
            },
            None => {
            },
        }
        let level = heading_level(&line);
        if level > 0 {
            flush_paragraph(&mut out, &mut para);
            let content = heading_content(&line, level);
            out.push(`<h{level}>{render_inline(&content)}</h{level}>`);
            i += 1;
            continue;
        }
        if is_thematic_break(&line) {
            flush_paragraph(&mut out, &mut para);
            out.push("<hr />");
            i += 1;
            continue;
        }
        if is_blockquote(&line) {
            flush_paragraph(&mut out, &mut para);
            i = render_blockquote(lines, i, end, &mut out);
            continue;
        }
        if is_list_marker(&line) {
            flush_paragraph(&mut out, &mut para);
            i = render_list(lines, i, end, &mut out);
            continue;
        }
        if i + 1 < end && line_has_pipe(&line) && line_has_pipe(&lines[i + 1]) && is_delimiter_row(&lines[i + 1]) {
            flush_paragraph(&mut out, &mut para);
            i = render_table(lines, i, end, &mut out);
            continue;
        }
        para.push(line);
        i += 1;
    }
    flush_paragraph(&mut out, &mut para);
    return out.join("\n");
}

fn flush_paragraph(out: &mut List<String>, para: &mut List<String>) {
    if para.is_empty() {
        return;
    }
    let joined = para.join("\n");
    out.push(`<p>{render_inline(&joined)}</p>`);
    para.clear();
}

fn render_fenced_code(
    lines: &List<String>,
    open: i32,
    end: i32,
    ch: char,
    fence_len: i32,
    info: &String,
    out: &mut List<String>,
) -> i32 {
    let lang = first_word(info);
    let mut buf = String::new();
    buf.push_str(&"<pre><code");
    if lang.len() > 0 {
        let cls = escape_attr(&lang);
        buf.push_str(&` class="language-{cls}"`);
    }
    buf.push_str(&">");

    let mut k = open + 1;
    while k < end {
        let line = lines[k];
        if is_code_fence_close(&line, ch, fence_len) {
            k += 1;
            break;
        }
        buf.push_str(&escape_block_text(&line));
        buf.push('\n');
        k += 1;
    }
    buf.push_str(&"</code></pre>");
    out.push(buf);
    return k;
}

fn render_blockquote(lines: &List<String>, start: i32, end: i32, out: &mut List<String>) -> i32 {
    let mut inner: List<String> = [];
    let mut k = start;
    while k < end && is_blockquote(&lines[k]) {
        inner.push(strip_blockquote_marker(&lines[k]));
        k += 1;
    }
    let body = render_blocks(&inner, 0, inner.len());
    out.push(`<blockquote>\n{body}\n</blockquote>`);
    return k;
}

fn is_blank(line: &String) -> bool {
    return line.trim().len() == 0;
}

fn heading_level(line: &String) -> i32 {
    let mut hashes = 0;
    let mut saw_non_hash = false;
    let mut next_is_space = false;
    for let c of line.chars() {
        if c == '#' && !saw_non_hash {
            hashes += 1;
        } else {
            saw_non_hash = true;
            next_is_space = c == ' ' || c == '\t';
            break;
        }
    }
    if 1 <= hashes <= 6 && (!saw_non_hash || next_is_space) {
        return hashes;
    }
    return 0;
}

fn heading_content(line: &String, level: i32) -> String {
    let mut out = String::new();
    let mut skipped = 0;
    for let c of line.chars() {
        if skipped < level {
            skipped += 1;
            continue;
        }
        out.push(c);
    }
    return out.trim();
}

fn is_thematic_break(line: &String) -> bool {
    let trimmed = line.trim();
    if trimmed.len() < 3 {
        return false;
    }
    let mut marker = '-';
    let mut has_marker = false;
    let mut count = 0;
    for let c of trimmed.chars() {
        if c == ' ' || c == '\t' {
            continue;
        }
        if c == '-' || c == '*' || c == '_' {
            if !has_marker {
                marker = c;
                has_marker = true;
            } else if c != marker {
                return false;
            }
            count += 1;
        } else {
            return false;
        }
    }
    return count >= 3;
}

fn fence_marker(line: &String) -> Option<[char, i32, String]> {
    let chars = to_chars(line);
    let len = chars.len();
    let mut p = 0;
    while p < len && p < 3 && chars[p] == ' ' {
        p += 1;
    }
    if p >= len {
        return null;
    }
    let ch = chars[p];
    if ch != '`' && ch != '~' {
        return null;
    }
    let mut run = 0;
    while p < len && chars[p] == ch {
        run += 1;
        p += 1;
    }
    if run < 3 {
        return null;
    }
    let info = substr(&chars, p, len).trim();
    if ch == '`' && info.contains("`") {
        return null;
    }
    return Option::Some([ch, run, info]);
}

fn is_code_fence_close(line: &String, ch: char, fence_len: i32) -> bool {
    let chars = to_chars(line);
    let len = chars.len();
    let mut p = 0;
    while p < len && p < 3 && chars[p] == ' ' {
        p += 1;
    }
    let mut run = 0;
    while p < len && chars[p] == ch {
        run += 1;
        p += 1;
    }
    if run < fence_len {
        return false;
    }
    while p < len {
        if chars[p] != ' ' && chars[p] != '\t' {
            return false;
        }
        p += 1;
    }
    return true;
}

fn is_blockquote(line: &String) -> bool {
    let chars = to_chars(line);
    let len = chars.len();
    let mut p = 0;
    while p < len && p < 3 && chars[p] == ' ' {
        p += 1;
    }
    return p < len && chars[p] == '>';
}

fn strip_blockquote_marker(line: &String) -> String {
    let chars = to_chars(line);
    let len = chars.len();
    let mut p = 0;
    while p < len && p < 3 && chars[p] == ' ' {
        p += 1;
    }
    if p < len && chars[p] == '>' {
        p += 1;
        if p < len && chars[p] == ' ' {
            p += 1;
        }
    }
    return substr(&chars, p, len);
}

fn line_has_pipe(line: &String) -> bool {
    return line.contains("|");
}

fn is_delimiter_row(line: &String) -> bool {
    let cells = split_row(line);
    if cells.is_empty() {
        return false;
    }
    for let cell of cells {
        if !is_delim_cell(&cell) {
            return false;
        }
    }
    return true;
}

fn is_delim_cell(cell: &String) -> bool {
    let chars = to_chars(cell);
    let len = chars.len();
    if len == 0 {
        return false;
    }
    let mut p = 0;
    if chars[p] == ':' {
        p += 1;
    }
    let mut dashes = 0;
    while p < len && chars[p] == '-' {
        dashes += 1;
        p += 1;
    }
    if dashes == 0 {
        return false;
    }
    if p < len && chars[p] == ':' {
        p += 1;
    }
    return p == len;
}

fn alignment(cell: &String) -> String {
    let left = cell.starts_with(":");
    let right = cell.ends_with(":");
    return match [left, right] {
        [true, true] => "center",
        [true, false] => "left",
        [false, true] => "right",
        [false, false] => "",
    };
}

fn split_row(line: &String) -> List<String> {
    let chars = to_chars(line);
    let len = chars.len();
    let mut s = 0;
    let mut e = len;
    while s < e && (chars[s] == ' ' || chars[s] == '\t') {
        s += 1;
    }
    while e > s && (chars[e - 1] == ' ' || chars[e - 1] == '\t') {
        e -= 1;
    }
    if s < e && chars[s] == '|' {
        s += 1;
    }
    if e > s && chars[e - 1] == '|' {
        e -= 1;
    }
    let mut cells: List<String> = [];
    let mut cur = String::new();
    let mut k = s;
    while k < e {
        let c = chars[k];
        if c == '\\' && k + 1 < e && chars[k + 1] == '|' {
            cur.push('|');
            k += 2;
            continue;
        }
        if c == '|' {
            cells.push(cur.trim());
            cur = String::new();
            k += 1;
            continue;
        }
        cur.push(c);
        k += 1;
    }
    cells.push(cur.trim());
    return cells;
}

fn render_table(lines: &List<String>, start: i32, end: i32, out: &mut List<String>) -> i32 {
    let header = split_row(&lines[start]);
    let delims = split_row(&lines[start + 1]);
    let mut aligns: List<String> = [];
    for let d of delims {
        aligns.push(alignment(&d));
    }
    let ncol = header.len();

    let mut buf = String::new();
    buf.push_str(&"<table>\n<thead>\n<tr>\n");
    for let mut idx = 0; idx < ncol; idx += 1 {
        buf.push_str(&cell_html(&"th", &cell_at(&header, idx), &align_at(&aligns, idx)));
        buf.push('\n');
    }
    buf.push_str(&"</tr>\n</thead>\n<tbody>\n");

    let mut k = start + 2;
    while k < end && !is_blank(&lines[k]) && line_has_pipe(&lines[k]) {
        let row = split_row(&lines[k]);
        buf.push_str(&"<tr>\n");
        for let mut idx = 0; idx < ncol; idx += 1 {
            buf.push_str(&cell_html(&"td", &cell_at(&row, idx), &align_at(&aligns, idx)));
            buf.push('\n');
        }
        buf.push_str(&"</tr>\n");
        k += 1;
    }
    buf.push_str(&"</tbody>\n</table>");
    out.push(buf);
    return k;
}

fn cell_html(tag: &String, cell: &String, align: &String) -> String {
    let inner = render_inline(cell);
    if align.len() > 0 {
        return `<{tag} align="{align}">{inner}</{tag}>`;
    }
    return `<{tag}>{inner}</{tag}>`;
}

fn cell_at(cells: &List<String>, idx: i32) -> String {
    return match cells.get(idx) {
        Some(c) => c,
        None => "",
    };
}

fn align_at(aligns: &List<String>, idx: i32) -> String {
    return match aligns.get(idx) {
        Some(a) => a,
        None => "",
    };
}

fn is_list_marker(line: &String) -> bool {
    return parse_list_marker(line) matches { Some(_) };
}

/// Returns `[indent, content_col, is_ordered]` for a list-item line.
fn parse_list_marker(line: &String) -> Option<[i32, i32, bool]> {
    let chars = to_chars(line);
    let len = chars.len();
    let mut p = 0;
    let mut indent = 0;
    while p < len && chars[p] == ' ' {
        indent += 1;
        p += 1;
    }
    if p >= len {
        return null;
    }
    let c = chars[p];
    let mut is_ordered = false;
    if c == '-' || c == '+' || c == '*' {
        p += 1;
    } else if is_digit(c) {
        let mut q = p;
        while q < len && is_digit(chars[q]) {
            q += 1;
        }
        if q < len && (chars[q] == '.' || chars[q] == ')') {
            is_ordered = true;
            p = q + 1;
        } else {
            return null;
        }
    } else {
        return null;
    }
    if p < len && chars[p] != ' ' && chars[p] != '\t' {
        return null;
    }
    let mut content_col = p;
    if content_col < len && (chars[content_col] == ' ' || chars[content_col] == '\t') {
        content_col += 1;
    }
    return Option::Some([indent, content_col, is_ordered]);
}

fn render_list(lines: &List<String>, start: i32, end: i32, out: &mut List<String>) -> i32 {
    let mut base_indent = 0;
    let mut is_ordered = false;
    match parse_list_marker(&lines[start]) {
        Some([ind, _, ord]) => {
            base_indent = ind;
            is_ordered = ord;
        },
        None => {
            return start;
        },
    }

    let mut items: List<String> = [];
    let mut k = start;
    loop {
        if k >= end || is_blank(&lines[k]) {
            break;
        }
        let mut content_col = -1;
        match parse_list_marker(&lines[k]) {
            Some([ind, cc, ord]) => {
                if ind == base_indent && ord == is_ordered {
                    content_col = cc;
                }
            },
            None => {
            },
        }
        if content_col < 0 {
            break;
        }

        let mut inner: List<String> = [];
        inner.push(cut_prefix(&lines[k], content_col));
        k += 1;
        while k < end && !is_blank(&lines[k]) && line_indent(&lines[k]) >= content_col {
            inner.push(dedent(&lines[k], content_col));
            k += 1;
        }

        let body = render_blocks(&inner, 0, inner.len());
        let tight = tighten(&body);
        if tight == body {
            items.push(`<li>\n{body}\n</li>`);
        } else {
            items.push(`<li>{tight}</li>`);
        }
    }

    let tag = if is_ordered { "ol" } else { "ul" };
    let joined = items.join("\n");
    out.push(`<{tag}>\n{joined}\n</{tag}>`);
    return k;
}

fn tighten(html: &String) -> String {
    if html.starts_with("<p>") && html.ends_with("</p>") {
        let chars = to_chars(html);
        let inner = substr(&chars, 3, chars.len() - 4);
        if !inner.contains("<p>") {
            return inner;
        }
    }
    return *html;
}

fn cut_prefix(line: &String, n: i32) -> String {
    let chars = to_chars(line);
    return substr(&chars, n, chars.len());
}

fn dedent(line: &String, n: i32) -> String {
    let chars = to_chars(line);
    let len = chars.len();
    let mut p = 0;
    while p < len && p < n && chars[p] == ' ' {
        p += 1;
    }
    return substr(&chars, p, len);
}

fn line_indent(line: &String) -> i32 {
    let mut n = 0;
    for let c of line.chars() {
        if c == ' ' {
            n += 1;
        } else {
            break;
        }
    }
    return n;
}

fn is_digit(c: char) -> bool {
    let v = c as i32;
    return 48 <= v <= 57;
}

fn to_chars(line: &String) -> List<char> {
    let mut chars: List<char> = [];
    for let c of line.chars() {
        chars.push(c);
    }
    return chars;
}

fn substr(chars: &List<char>, s: i32, e: i32) -> String {
    let mut out = String::new();
    let mut k = s;
    while k < e {
        out.push(chars[k]);
        k += 1;
    }
    return out;
}

fn first_word(s: &String) -> String {
    let mut out = String::new();
    for let c of s.chars() {
        if c == ' ' || c == '\t' {
            break;
        }
        out.push(c);
    }
    return out;
}

fn escape_block_text(line: &String) -> String {
    let mut out = String::new();
    for let c of line.chars() {
        match c {
            '&' => out.push_str(&"&amp;"),
            '<' => out.push_str(&"&lt;"),
            '>' => out.push_str(&"&gt;"),
            _ => out.push(c),
        }
    }
    return out;
}
