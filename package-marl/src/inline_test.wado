use { render_inline } from "./inline.wado";

test "render_inline emits strong and emphasis" {
    assert render_inline(&"**bold**") == "<strong>bold</strong>";
    assert render_inline(&"*em*") == "<em>em</em>";
    assert render_inline(&"_em_") == "<em>em</em>";
}

test "render_inline emits strikethrough for double tilde only" {
    assert render_inline(&"~~gone~~") == "<del>gone</del>";
    assert render_inline(&"a ~ b") == "a ~ b";
}

test "render_inline nests emphasis inside strong" {
    assert render_inline(&"**a *b* c**") == "<strong>a <em>b</em> c</strong>";
}

test "render_inline renders inline code and escapes within it" {
    assert render_inline(&"`code`") == "<code>code</code>";
    assert render_inline(&"`a<b & c>`") == "<code>a&lt;b &amp; c&gt;</code>";
}

test "render_inline matches code span by backtick run length" {
    assert render_inline(&"`` a`b ``") == "<code>a`b</code>";
}

test "render_inline renders links with escaped href" {
    assert render_inline(&"[home](http://example.com)") == "<a href=\"http://example.com\">home</a>";
}

test "render_inline renders images" {
    assert render_inline(&"![a cat](cat.png)") == "<img src=\"cat.png\" alt=\"a cat\" />";
}

test "render_inline renders inline markup inside link text" {
    assert render_inline(&"[**bold**](/x)") == "<a href=\"/x\"><strong>bold</strong></a>";
}

test "render_inline honors backslash escapes" {
    assert render_inline(&"\\*not em\\*") == "*not em*";
    assert render_inline(&"a \\& b") == "a &amp; b";
}

test "render_inline leaves unmatched delimiters literal" {
    assert render_inline(&"a * b") == "a * b";
    assert render_inline(&"unclosed `code") == "unclosed `code";
}

test "render_inline escapes plain angle brackets" {
    assert render_inline(&"1 < 2 && 3 > 2") == "1 &lt; 2 &amp;&amp; 3 &gt; 2";
}

test "render_inline autolinks bare http urls" {
    assert render_inline(&"see https://wado.example/docs here") == "see <a href=\"https://wado.example/docs\">https://wado.example/docs</a> here";
}

test "render_inline trims trailing punctuation from autolinks" {
    assert render_inline(&"visit http://a.example.") == "visit <a href=\"http://a.example\">http://a.example</a>.";
}

test "render_inline ignores trailing-space hard breaks (non-goal)" {
    assert render_inline(&"a  \nb") == "a  \nb";
}

test "render_inline makes a hard break on a trailing backslash" {
    assert render_inline(&"a\\
b") == "a<br />
b";
}

test "render_inline keeps a single trailing space as a soft break" {
    assert render_inline(&"a \nb") == "a \nb";
}

test "render_inline does not emphasize intraword underscores" {
    assert render_inline(&"foo_bar_baz") == "foo_bar_baz";
    assert render_inline(&"5_6_78") == "5_6_78";
}

test "render_inline emphasizes intraword asterisks" {
    assert render_inline(&"foo**bar**baz") == "foo<strong>bar</strong>baz";
}

test "render_inline opens underscore emphasis next to punctuation" {
    assert render_inline(&"_(foo)_") == "<em>(foo)</em>";
}

test "render_inline rejects emphasis with inner flanking whitespace" {
    assert render_inline(&"** notbold **") == "** notbold **";
    assert render_inline(&"a * b * c") == "a * b * c";
}

test "render_inline still emphasizes plain underscore words" {
    assert render_inline(&"_emph_ and _two words_") == "<em>emph</em> and <em>two words</em>";
}

test "render_inline emits link and image titles" {
    assert render_inline(&"[home](http://x.test \"Home\")") == "<a href=\"http://x.test\" title=\"Home\">home</a>";
    assert render_inline(&"![cat](cat.png \"A cat\")") == "<img src=\"cat.png\" alt=\"cat\" title=\"A cat\" />";
}

test "render_inline nests strong inside emphasis for triple markers" {
    assert render_inline(&"***bi***") == "<em><strong>bi</strong></em>";
    assert render_inline(&"a ***b*** c") == "a <em><strong>b</strong></em> c";
}

test "render_inline resolves adjacent emphasis runs" {
    assert render_inline(&"**a**b**c**") == "<strong>a</strong>b<strong>c</strong>";
}

test "render_inline handles strong wrapping emphasis" {
    assert render_inline(&"**a _b_ c**") == "<strong>a <em>b</em> c</strong>";
}

test "render_inline leaves an unmatched opener literal" {
    assert render_inline(&"**bold") == "**bold";
    assert render_inline(&"foo * bar") == "foo * bar";
}

test "render_inline neutralizes unsafe URL schemes" {
    assert render_inline(&"[x](javascript:alert(1))") == "<a href=\"\">x</a>";
    assert render_inline(&"![x](data:text/html,evil)") == "<img src=\"\" alt=\"x\" />";
    assert render_inline(&"[x](vbscript:foo)") == "<a href=\"\">x</a>";
}

test "render_inline keeps safe and relative URLs" {
    assert render_inline(&"[x](http://example.com)") == "<a href=\"http://example.com\">x</a>";
    assert render_inline(&"[x](mailto:a@b.com)") == "<a href=\"mailto:a@b.com\">x</a>";
    assert render_inline(&"[x](./page.html)") == "<a href=\"./page.html\">x</a>";
    assert render_inline(&"[x](#anchor)") == "<a href=\"#anchor\">x</a>";
}

test "render_inline unwraps an angle-bracketed destination" {
    assert render_inline(&"[a](<http://example.com/x>)") == "<a href=\"http://example.com/x\">a</a>";
}

test "render_inline requires a boundary before a bare autolink" {
    assert render_inline(&"foohttp://example.com") == "foohttp://example.com";
    assert render_inline(&"see http://example.com now") == "see <a href=\"http://example.com\">http://example.com</a> now";
}

test "render_inline treats an escaped backslash before a newline as a soft break" {
    assert !render_inline(&"a\\\\
b").contains("<br");
    assert render_inline(&"a\\
b").contains("<br");
}
