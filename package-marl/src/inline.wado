//! Inline rendering: code spans, emphasis/strong, strikethrough, links,
//! images, autolinks, hard breaks, and backslash escapes.
//!
//! The text is scanned through a `StrCursor` and tokenized into literal-text,
//! final-HTML, and delimiter-run tokens; emphasis is then resolved by the
//! CommonMark "process emphasis" delimiter-stack procedure (flanking rules, the
//! rule of three, and nested `*`/`**`/`***`). Strikethrough (`~`) reuses the
//! same machinery.

use { escape_attr, escape_text, sanitize_url } from "./html.wado";
use { StrCursor, chars_of } from "./str_cursor.wado";

pub fn render_inline(text: &String) -> String {
    let chars = chars_of(text);
    return render_range(StrCursor::over(&chars));
}

/// An inline token kind.
enum TokKind {
    /// Literal text, HTML-escaped on serialize.
    Text,
    /// Final HTML emitted verbatim.
    Html,
    /// A `*`/`_`/`~` delimiter run.
    Delim,
}

struct Tok {
    kind: TokKind,
    text: String,
    ch: char,
    count: i32,
    orig: i32,
    open: bool,
    close: bool,
}

fn render_range(cursor: StrCursor) -> String {
    let mut toks: List<Tok> = [];
    tokenize(cursor, &mut toks);
    process_emphasis(&mut toks);
    return serialize(&toks);
}

fn tokenize(cursor: StrCursor, toks: &mut List<Tok>) {
    let mut cur = cursor;
    let mut buf = String::new();
    while !cur.eof() {
        let i = cur.position();
        let c = char_at(&cur, i);
        match c {
            '\\' && is_escapable(&cur, i + 1) => {
                buf.push(char_at(&cur, i + 1));
                cur.set_position(i + 2);
            },
            '\\' && cur.is_at(i + 1, '\n') => {
                flush_text(&mut buf, toks);
                push_raw("<br />\n", toks);
                cur.set_position(i + 2);
            },
            '\n' => {
                buf.push('\n');
                cur.set_position(i + 1);
            },
            'h' => {
                cur.set_position(push_construct(try_autolink(&cur, i), c, i, &mut buf, toks));
            },
            '`' => {
                cur.set_position(push_construct(try_code_span(&cur, i), c, i, &mut buf, toks));
            },
            '!' && cur.is_at(i + 1, '[') => {
                cur.set_position(push_construct(try_link(&cur, i + 1, true), c, i, &mut buf, toks));
            },
            '[' => {
                cur.set_position(push_construct(try_link(&cur, i, false), c, i, &mut buf, toks));
            },
            '*' | '_' | '~' => {
                flush_text(&mut buf, toks);
                cur.set_position(push_delim(&cur, i, c, toks));
            },
            _ => {
                buf.push(c);
                cur.bump();
            },
        }
    }
    flush_text(&mut buf, toks);
}

fn char_at(cur: &StrCursor, idx: i32) -> char {
    return match cur.at(idx) {
        Some(c) => c,
        None => ' ',
    };
}

fn is_escapable(cur: &StrCursor, idx: i32) -> bool {
    return match cur.at(idx) {
        Some(c) => is_ascii_punct(c),
        None => false,
    };
}

fn flush_text(buf: &mut String, toks: &mut List<Tok>) {
    if buf.len() == 0 {
        return;
    }
    // Copy via push_str + clear rather than `let t = *buf; *buf = String::new()`:
    // the latter is miscompiled at -O1+ (wado-lang/wado#1522; see the TODO fixture
    // opt_move_out_string_reset_1522_todo.wado).
    let mut text = String::new();
    text.push_str(buf);
    toks.push(Tok { kind: TokKind::Text, text, ch: ' ', count: 0, orig: 0, open: false, close: false });
    buf.clear();
}

fn push_raw(html: String, toks: &mut List<Tok>) {
    toks.push(raw_tok(html));
}

fn push_construct(result: Option<[String, i32]>, c: char, i: i32, buf: &mut String, toks: &mut List<Tok>) -> i32 {
    match result {
        Some([html, next]) => {
            flush_text(buf, toks);
            push_raw(html, toks);
            return next;
        },
        None => {
            buf.push(c);
            return i + 1;
        },
    }
}

fn push_delim(cur: &StrCursor, i: i32, d: char, toks: &mut List<Tok>) -> i32 {
    let n = run_length(cur, i, d);
    let prev = cur.at(i - 1);
    let next = cur.at(i + n);
    toks.push(Tok {
        kind: TokKind::Delim,
        text: "",
        ch: d,
        count: n,
        orig: n,
        open: can_open(d, prev, next),
        close: can_close(d, prev, next),
    });
    return i + n;
}

/// Resolve `*`/`_`/`~` delimiter pairs into emphasis, following the CommonMark
/// "process emphasis" procedure: scan closers left to right, match each to the
/// nearest compatible opener (honoring flanking and the rule of three), and
/// wrap the span in `<em>`/`<strong>` (or `<del>` for `~`).
fn process_emphasis(toks: &mut List<Tok>) {
    let mut ci = 0;
    while ci < toks.len() {
        let closer = toks[ci];
        if closer.kind matches { Delim } && closer.close && closer.count > 0 {
            match find_opener(toks, ci) {
                Some(oi) => ci = resolve_pair(toks, oi, ci),
                None => ci += 1,
            }
        } else {
            ci += 1;
        }
    }
}

fn find_opener(toks: &List<Tok>, ci: i32) -> Option<i32> {
    let closer = toks[ci];
    for let mut oi = ci - 1; oi >= 0; oi -= 1 {
        let opener = toks[oi];
        let ok = opener.kind matches { Delim } && opener.open && opener.count > 0 && opener.ch == closer.ch;
        if ok && rule_of_three(&opener, &closer) {
            return Option::Some(oi);
        }
    }
    return null;
}

fn rule_of_three(opener: &Tok, closer: &Tok) -> bool {
    let both = opener.open && opener.close || closer.open && closer.close;
    let sum = opener.orig + closer.orig;
    if both && sum % 3 == 0 && !(opener.orig % 3 == 0 && closer.orig % 3 == 0) {
        return false;
    }
    return true;
}

fn resolve_pair(toks: &mut List<Tok>, oi: i32, ci: i32) -> i32 {
    let opener = toks[oi];
    let closer = toks[ci];
    let strong = opener.count >= 2 && closer.count >= 2;
    let use_n = if strong { 2 } else { 1 };
    let tag = match closer.ch {
        '~' => "del",
        _ => if strong { "strong" } else { "em" },
    };

    for let bi of oi + 1..<ci {
        let mut between = toks[bi];
        if between.kind matches { Delim } {
            between.open = false;
            between.close = false;
            toks[bi] = between;
        }
    }

    toks.insert(ci, raw_tok(`</{tag}>`));
    toks.insert(oi + 1, raw_tok(`<{tag}>`));
    let closer_idx = ci + 2;

    let mut op = toks[oi];
    op.count -= use_n;
    toks[oi] = op;
    let mut cl = toks[closer_idx];
    cl.count -= use_n;
    toks[closer_idx] = cl;

    return closer_idx;
}

fn raw_tok(html: String) -> Tok {
    return Tok { kind: TokKind::Html, text: html, ch: ' ', count: 0, orig: 0, open: false, close: false };
}

fn serialize(toks: &List<Tok>) -> String {
    let mut out = String::new();
    for let t of toks {
        match t.kind {
            Text => out.push_str(&escape_text(&t.text)),
            Html => out.push_str(&t.text),
            Delim => {
                for let _ of 0..<t.count {
                    out.push(t.ch);
                }
            },
        }
    }
    return out;
}

fn try_code_span(cur: &StrCursor, i: i32) -> Option<[String, i32]> {
    let n = run_length(cur, i, '`');
    let end = cur.end();
    let mut j = i + n;
    while j < end {
        if cur.is_at(j, '`') {
            let m = run_length(cur, j, '`');
            if m == n {
                let content = code_content(cur, i + n, j);
                return Option::Some([`<code>{content}</code>`, j + n]);
            }
            j += m;
        } else {
            j += 1;
        }
    }
    return null;
}

fn code_content(cur: &StrCursor, s: i32, e: i32) -> String {
    let mut a = s;
    let mut b = e;
    if b - a >= 2 && cur.is_at(a, ' ') && cur.is_at(b - 1, ' ') && !all_spaces(cur, a, b) {
        a += 1;
        b -= 1;
    }
    let mut raw = String::new();
    for let k of a..<b {
        let c = char_at(cur, k);
        raw.push(if c == '\n' { ' ' } else { c });
    }
    return escape_text(&raw);
}

fn try_link(cur: &StrCursor, open: i32, is_image: bool) -> Option<[String, i32]> {
    let end = cur.end();
    let mut depth = 0;
    let mut j = open;
    let mut close = -1;
    while j < end {
        if cur.is_at(j, '\\') {
            j += 2;
            continue;
        }
        if cur.is_at(j, '[') {
            depth += 1;
        } else if cur.is_at(j, ']') {
            depth -= 1;
            if depth == 0 {
                close = j;
                break;
            }
        }
        j += 1;
    }
    if close < 0 || close + 1 >= end || !cur.is_at(close + 1, '(') {
        return null;
    }
    let mut k = close + 2;
    let mut pdepth = 1;
    let mut pclose = -1;
    while k < end {
        if cur.is_at(k, '\\') {
            k += 2;
            continue;
        }
        if cur.is_at(k, '(') {
            pdepth += 1;
        } else if cur.is_at(k, ')') {
            pdepth -= 1;
            if pdepth == 0 {
                pclose = k;
                break;
            }
        }
        k += 1;
    }
    if pclose < 0 {
        return null;
    }
    let dest_raw = cur.slice(close + 2, pclose);
    let [dest, title] = parse_dest_title(&dest_raw);
    let href = escape_attr(&sanitize_url(&dest));
    let title_attr = title_attribute(&title);
    if is_image {
        let alt = escape_attr(&cur.slice(open + 1, close));
        return Option::Some([`<img src="{href}" alt="{alt}"{title_attr} />`, pclose + 1]);
    }
    let text_html = render_range(cur.sub(open + 1, close));
    return Option::Some([`<a href="{href}"{title_attr}>{text_html}</a>`, pclose + 1]);
}

/// Split a link destination field into `[dest, title]`. The destination is
/// either a bare run up to the first space or an angle-bracketed `<...>` that
/// may contain spaces; the title is an optional `"..."`, `'...'`, or `(...)`
/// string after it.
fn parse_dest_title(raw: &String) -> [String, String] {
    let chars = chars_of(&raw.trim());
    let len = chars.len();
    let mut dest = String::new();
    let mut p = 0;
    if p < len && chars[p] == '<' {
        p += 1;
        while p < len && chars[p] != '>' {
            dest.push(chars[p]);
            p += 1;
        }
        if p < len {
            p += 1;
        }
    } else {
        while p < len && !chars[p] matches { ' ' | '\t' } {
            dest.push(chars[p]);
            p += 1;
        }
    }
    while p < len && chars[p] matches { ' ' | '\t' } {
        p += 1;
    }
    let title = if p < len { read_title(&chars, p) } else { "" };
    return [dest, title];
}

fn read_title(chars: &List<char>, start: i32) -> String {
    let closing = match chars[start] {
        '"' => '"',
        '\'' => '\'',
        '(' => ')',
        _ => {
            return "";
        },
    };
    let mut title = String::new();
    let mut p = start + 1;
    while p < chars.len() && chars[p] != closing {
        title.push(chars[p]);
        p += 1;
    }
    return title;
}

fn title_attribute(title: &String) -> String {
    if title.len() == 0 {
        return "";
    }
    return ` title="{escape_attr(title)}"`;
}

fn try_autolink(cur: &StrCursor, i: i32) -> Option<[String, i32]> {
    if opt_is_alnum(cur.at(i - 1)) {
        return null;
    }
    if !starts_with_at(cur, i, "http://") && !starts_with_at(cur, i, "https://") {
        return null;
    }
    let mut j = url_run_end(cur, i);
    while j > i && is_trailing_punct(char_at(cur, j - 1)) {
        j -= 1;
    }
    if j <= i {
        return null;
    }
    let url = cur.slice(i, j);
    let href = escape_attr(&url);
    let text = escape_text(&url);
    return Option::Some([`<a href="{href}">{text}</a>`, j]);
}

/// The index just past a bare URL run starting at `start`, stopping at
/// whitespace or `<`/`>`.
fn url_run_end(cur: &StrCursor, start: i32) -> i32 {
    let end = cur.end();
    for let j of start..<end {
        let c = char_at(cur, j);
        if is_space(c) || c matches { '<' | '>' } {
            return j;
        }
    }
    return end;
}

fn starts_with_at(cur: &StrCursor, i: i32, pat: String) -> bool {
    let mut k = 0;
    for let pc of pat.chars() {
        if !cur.is_at(i + k, pc) {
            return false;
        }
        k += 1;
    }
    return true;
}

/// A delimiter run of `d` bounded by `prev`/`next` can open emphasis when it is
/// left-flanking (with the `_` intraword restriction). See the CommonMark spec,
/// "Emphasis and strong emphasis".
fn can_open(d: char, prev: Option<char>, next: Option<char>) -> bool {
    let lf = left_flanking(prev, next);
    return match d {
        '_' => lf && (!right_flanking(prev, next) || opt_is_punct(prev)),
        _ => lf,
    };
}

fn can_close(d: char, prev: Option<char>, next: Option<char>) -> bool {
    let rf = right_flanking(prev, next);
    return match d {
        '_' => rf && (!left_flanking(prev, next) || opt_is_punct(next)),
        _ => rf,
    };
}

fn left_flanking(prev: Option<char>, next: Option<char>) -> bool {
    return !opt_is_ws(next) && (!opt_is_punct(next) || opt_is_ws(prev) || opt_is_punct(prev));
}

fn right_flanking(prev: Option<char>, next: Option<char>) -> bool {
    return !opt_is_ws(prev) && (!opt_is_punct(prev) || opt_is_ws(next) || opt_is_punct(next));
}

fn opt_is_ws(o: Option<char>) -> bool {
    return match o {
        Some(c) => is_space(c),
        None => true,
    };
}

fn opt_is_punct(o: Option<char>) -> bool {
    return match o {
        Some(c) => is_ascii_punct(c),
        None => false,
    };
}

fn opt_is_alnum(o: Option<char>) -> bool {
    return match o {
        Some(c) => is_ascii_alnum(c),
        None => false,
    };
}

fn is_ascii_alnum(c: char) -> bool {
    let v = c as i32;
    return 48 <= v <= 57 || 65 <= v <= 90 || 97 <= v <= 122;
}

fn run_length(cur: &StrCursor, from: i32, d: char) -> i32 {
    let mut n = 0;
    let mut i = from;
    while cur.is_at(i, d) {
        n += 1;
        i += 1;
    }
    return n;
}

fn all_spaces(cur: &StrCursor, s: i32, e: i32) -> bool {
    for let k of s..<e {
        if !cur.is_at(k, ' ') {
            return false;
        }
    }
    return true;
}

fn is_trailing_punct(c: char) -> bool {
    return c matches { '.' | ',' | ';' | ':' | '!' | '?' };
}

fn is_space(c: char) -> bool {
    return c matches { ' ' | '\t' | '\n' };
}

fn is_ascii_punct(c: char) -> bool {
    let v = c as i32;
    return 33 <= v <= 47 || 58 <= v <= 64 || 91 <= v <= 96 || 123 <= v <= 126;
}
