//! Inline rendering: code spans, emphasis/strong, strikethrough, links,
//! images, autolinks, hard breaks, and backslash escapes.
//!
//! The text is tokenized into literal text, final-HTML, and delimiter-run
//! tokens; emphasis is then resolved by the CommonMark "process emphasis"
//! delimiter-stack procedure (flanking rules, the rule of three, and nested
//! `*`/`**`/`***`). Strikethrough (`~`) reuses the same machinery.

use { escape_attr, escape_text } from "./html.wado";

pub fn render_inline(text: &String) -> String {
    let mut chars: List<char> = [];
    for let c of text.chars() {
        chars.push(c);
    }
    return render_range(&chars, 0, chars.len());
}

/// An inline token. `kind` is 0 for literal text (escaped on serialize), 1 for
/// final HTML emitted verbatim, and 2 for a `*`/`_`/`~` delimiter run.
struct Tok {
    kind: i32,
    text: String,
    ch: char,
    count: i32,
    orig: i32,
    open: bool,
    close: bool,
}

fn render_range(chars: &List<char>, start: i32, end: i32) -> String {
    let mut toks: List<Tok> = [];
    tokenize(chars, start, end, &mut toks);
    process_emphasis(&mut toks);
    return serialize(&toks);
}

fn tokenize(chars: &List<char>, start: i32, end: i32, toks: &mut List<Tok>) {
    let mut cur = String::new();
    let mut i = start;
    while i < end {
        let c = chars[i];
        match c {
            '\\' && i + 1 < end && is_ascii_punct(chars[i + 1]) => {
                cur.push(chars[i + 1]);
                i += 2;
            },
            '\n' => {
                i = push_line_break(&mut cur, chars, i, start, toks);
            },
            'h' => {
                i = push_construct(try_autolink(chars, i, end), c, i, &mut cur, toks);
            },
            '`' => {
                i = push_construct(try_code_span(chars, i, end), c, i, &mut cur, toks);
            },
            '!' && i + 1 < end && chars[i + 1] == '[' => {
                i = push_construct(try_link(chars, i + 1, end, true), c, i, &mut cur, toks);
            },
            '[' => {
                i = push_construct(try_link(chars, i, end, false), c, i, &mut cur, toks);
            },
            '*' | '_' | '~' => {
                flush_text(&mut cur, toks);
                i = push_delim(chars, start, i, end, c, toks);
            },
            _ => {
                cur.push(c);
                i += 1;
            },
        }
    }
    flush_text(&mut cur, toks);
}

fn flush_text(cur: &mut String, toks: &mut List<Tok>) {
    if cur.len() == 0 {
        return;
    }
    let text = *cur;
    toks.push(Tok { kind: 0, text, ch: ' ', count: 0, orig: 0, open: false, close: false });
    *cur = String::new();
}

fn push_raw(html: String, toks: &mut List<Tok>) {
    toks.push(Tok { kind: 1, text: html, ch: ' ', count: 0, orig: 0, open: false, close: false });
}

fn push_construct(result: Option<[String, i32]>, c: char, i: i32, cur: &mut String, toks: &mut List<Tok>) -> i32 {
    match result {
        Some([html, next]) => {
            flush_text(cur, toks);
            push_raw(html, toks);
            return next;
        },
        None => {
            cur.push(c);
            return i + 1;
        },
    }
}

fn push_line_break(cur: &mut String, chars: &List<char>, i: i32, start: i32, toks: &mut List<Tok>) -> i32 {
    // A trailing backslash is a hard break. Trailing-space hard breaks are an
    // intentional non-goal (invisible whitespace footgun); such lines fold as
    // an ordinary soft break.
    if i > start && chars[i - 1] == '\\' {
        cur.pop();
        flush_text(cur, toks);
        push_raw("<br />\n", toks);
    } else {
        cur.push('\n');
    }
    return i + 1;
}

fn push_delim(chars: &List<char>, start: i32, i: i32, end: i32, d: char, toks: &mut List<Tok>) -> i32 {
    let n = run_length(chars, i, d);
    let prev = opt_char(chars, i - 1, start, end);
    let next = opt_char(chars, i + n, start, end);
    toks.push(Tok {
        kind: 2,
        text: "",
        ch: d,
        count: n,
        orig: n,
        open: can_open(d, prev, next),
        close: can_close(d, prev, next),
    });
    return i + n;
}

/// Resolve `*`/`_`/`~` delimiter pairs into emphasis, following the CommonMark
/// "process emphasis" procedure: scan closers left to right, match each to the
/// nearest compatible opener (honoring flanking and the rule of three), and
/// wrap the span in `<em>`/`<strong>` (or `<del>` for `~`).
fn process_emphasis(toks: &mut List<Tok>) {
    let mut ci = 0;
    while ci < toks.len() {
        let closer = toks[ci];
        if closer.kind == 2 && closer.close && closer.count > 0 {
            let oi = find_opener(toks, ci);
            if oi >= 0 {
                ci = resolve_pair(toks, oi, ci);
            } else {
                ci += 1;
            }
        } else {
            ci += 1;
        }
    }
}

fn find_opener(toks: &List<Tok>, ci: i32) -> i32 {
    let closer = toks[ci];
    let mut oi = ci - 1;
    while oi >= 0 {
        let opener = toks[oi];
        let ok = opener.kind == 2 && opener.open && opener.count > 0 && opener.ch == closer.ch;
        if ok && rule_of_three(&opener, &closer) {
            return oi;
        }
        oi -= 1;
    }
    return -1;
}

fn rule_of_three(opener: &Tok, closer: &Tok) -> bool {
    let both = opener.open && opener.close || closer.open && closer.close;
    let sum = opener.orig + closer.orig;
    if both && sum % 3 == 0 && !(opener.orig % 3 == 0 && closer.orig % 3 == 0) {
        return false;
    }
    return true;
}

fn resolve_pair(toks: &mut List<Tok>, oi: i32, ci: i32) -> i32 {
    let opener = toks[oi];
    let closer = toks[ci];
    let strong = opener.count >= 2 && closer.count >= 2;
    let use_n = if strong { 2 } else { 1 };
    let tag = match closer.ch {
        '~' => "del",
        _ => if strong { "strong" } else { "em" },
    };

    let mut bi = oi + 1;
    while bi < ci {
        let mut between = toks[bi];
        if between.kind == 2 {
            between.open = false;
            between.close = false;
            toks[bi] = between;
        }
        bi += 1;
    }

    toks.insert(ci, raw_tok(`</{tag}>`));
    toks.insert(oi + 1, raw_tok(`<{tag}>`));
    let closer_idx = ci + 2;

    let mut op = toks[oi];
    op.count -= use_n;
    toks[oi] = op;
    let mut cl = toks[closer_idx];
    cl.count -= use_n;
    toks[closer_idx] = cl;

    return closer_idx;
}

fn raw_tok(html: String) -> Tok {
    return Tok { kind: 1, text: html, ch: ' ', count: 0, orig: 0, open: false, close: false };
}

fn serialize(toks: &List<Tok>) -> String {
    let mut out = String::new();
    for let t of toks {
        match t.kind {
            0 => out.push_str(&escape_text(&t.text)),
            1 => out.push_str(&t.text),
            _ => {
                let mut r = 0;
                while r < t.count {
                    out.push(t.ch);
                    r += 1;
                }
            },
        }
    }
    return out;
}

fn try_code_span(chars: &List<char>, i: i32, end: i32) -> Option<[String, i32]> {
    let n = run_length(chars, i, '`');
    let mut j = i + n;
    while j < end {
        if chars[j] == '`' {
            let m = run_length(chars, j, '`');
            if m == n {
                let content = code_content(chars, i + n, j);
                return Option::Some([`<code>{content}</code>`, j + n]);
            }
            j += m;
        } else {
            j += 1;
        }
    }
    return null;
}

fn code_content(chars: &List<char>, s: i32, e: i32) -> String {
    let mut a = s;
    let mut b = e;
    if b - a >= 2 && chars[a] == ' ' && chars[b - 1] == ' ' && !all_spaces(chars, a, b) {
        a += 1;
        b -= 1;
    }
    let mut out = String::new();
    let mut k = a;
    while k < b {
        push_code_char(&mut out, chars[k]);
        k += 1;
    }
    return out;
}

fn try_link(chars: &List<char>, open: i32, end: i32, is_image: bool) -> Option<[String, i32]> {
    let mut depth = 0;
    let mut j = open;
    let mut close = -1;
    while j < end {
        let c = chars[j];
        if c == '\\' {
            j += 2;
            continue;
        }
        if c == '[' {
            depth += 1;
        } else if c == ']' {
            depth -= 1;
            if depth == 0 {
                close = j;
                break;
            }
        }
        j += 1;
    }
    if close < 0 || close + 1 >= end || chars[close + 1] != '(' {
        return null;
    }
    let mut k = close + 2;
    let mut pdepth = 1;
    let mut pclose = -1;
    while k < end {
        let c = chars[k];
        if c == '\\' {
            k += 2;
            continue;
        }
        if c == '(' {
            pdepth += 1;
        } else if c == ')' {
            pdepth -= 1;
            if pdepth == 0 {
                pclose = k;
                break;
            }
        }
        k += 1;
    }
    if pclose < 0 {
        return null;
    }
    let dest_raw = raw_string(chars, close + 2, pclose);
    let [dest, title] = parse_dest_title(&dest_raw);
    let href = escape_attr(&dest);
    let title_attr = title_attribute(&title);
    if is_image {
        let alt = escape_attr(&raw_string(chars, open + 1, close));
        return Option::Some([`<img src="{href}" alt="{alt}"{title_attr} />`, pclose + 1]);
    }
    let text_html = render_range(chars, open + 1, close);
    return Option::Some([`<a href="{href}"{title_attr}>{text_html}</a>`, pclose + 1]);
}

/// Split a link destination field into `[dest, title]`. The title is an
/// optional `"..."`, `'...'`, or `(...)` string after the destination.
fn parse_dest_title(raw: &String) -> [String, String] {
    let mut dest = String::new();
    let mut title = String::new();
    let mut phase = 0;
    let mut closing = ' ';
    for let c of raw.trim().chars() {
        match phase {
            0 => if c == ' ' || c == '\t' { phase = 1 } else { dest.push(c) },
            1 => match c {
                ' ' | '\t' => {
                },
                '"' => {
                    closing = '"';
                    phase = 2;
                },
                '\'' => {
                    closing = '\'';
                    phase = 2;
                },
                '(' => {
                    closing = ')';
                    phase = 2;
                },
                _ => {
                    phase = 3;
                },
            },
            _ => if phase == 2 && c != closing { title.push(c) } else { phase = 3 },
        }
    }
    return [dest, title];
}

fn title_attribute(title: &String) -> String {
    if title.len() == 0 {
        return "";
    }
    return ` title="{escape_attr(title)}"`;
}

/// A delimiter run of `d` bounded by `prev`/`next` can open emphasis when it is
/// left-flanking (with the `_` intraword restriction). See the CommonMark spec,
/// "Emphasis and strong emphasis".
fn can_open(d: char, prev: Option<char>, next: Option<char>) -> bool {
    let lf = left_flanking(prev, next);
    return match d {
        '_' => lf && (!right_flanking(prev, next) || opt_is_punct(prev)),
        _ => lf,
    };
}

fn can_close(d: char, prev: Option<char>, next: Option<char>) -> bool {
    let rf = right_flanking(prev, next);
    return match d {
        '_' => rf && (!left_flanking(prev, next) || opt_is_punct(next)),
        _ => rf,
    };
}

fn left_flanking(prev: Option<char>, next: Option<char>) -> bool {
    return !opt_is_ws(next) && (!opt_is_punct(next) || opt_is_ws(prev) || opt_is_punct(prev));
}

fn right_flanking(prev: Option<char>, next: Option<char>) -> bool {
    return !opt_is_ws(prev) && (!opt_is_punct(prev) || opt_is_ws(next) || opt_is_punct(next));
}

fn opt_char(chars: &List<char>, idx: i32, start: i32, end: i32) -> Option<char> {
    if start <= idx < end {
        return Option::Some(chars[idx]);
    }
    return null;
}

fn opt_is_ws(o: Option<char>) -> bool {
    return match o {
        Some(c) => is_space(c),
        None => true,
    };
}

fn opt_is_punct(o: Option<char>) -> bool {
    return match o {
        Some(c) => is_ascii_punct(c),
        None => false,
    };
}

fn run_length(chars: &List<char>, start: i32, d: char) -> i32 {
    let mut n = 0;
    let mut i = start;
    let len = chars.len();
    while i < len && chars[i] == d {
        n += 1;
        i += 1;
    }
    return n;
}

fn raw_string(chars: &List<char>, s: i32, e: i32) -> String {
    let mut out = String::new();
    let mut k = s;
    while k < e {
        out.push(chars[k]);
        k += 1;
    }
    return out;
}

fn all_spaces(chars: &List<char>, s: i32, e: i32) -> bool {
    let mut k = s;
    while k < e {
        if chars[k] != ' ' {
            return false;
        }
        k += 1;
    }
    return true;
}

fn try_autolink(chars: &List<char>, i: i32, end: i32) -> Option<[String, i32]> {
    if !starts_with_at(chars, i, "http://") && !starts_with_at(chars, i, "https://") {
        return null;
    }
    let mut j = i;
    while j < end {
        let c = chars[j];
        if is_space(c) || c == '<' || c == '>' {
            break;
        }
        j += 1;
    }
    while j > i && is_trailing_punct(chars[j - 1]) {
        j -= 1;
    }
    if j <= i {
        return null;
    }
    let url = raw_string(chars, i, j);
    let href = escape_attr(&url);
    let text = escape_text(&url);
    return Option::Some([`<a href="{href}">{text}</a>`, j]);
}

fn starts_with_at(chars: &List<char>, i: i32, pat: String) -> bool {
    let len = chars.len();
    let mut k = 0;
    for let pc of pat.chars() {
        if i + k >= len || chars[i + k] != pc {
            return false;
        }
        k += 1;
    }
    return true;
}

fn is_trailing_punct(c: char) -> bool {
    return c == '.' || c == ',' || c == ';' || c == ':' || c == '!' || c == '?';
}


fn is_space(c: char) -> bool {
    return c == ' ' || c == '\t' || c == '\n';
}

fn is_ascii_punct(c: char) -> bool {
    let v = c as i32;
    return 33 <= v <= 47 || 58 <= v <= 64 || 91 <= v <= 96 || 123 <= v <= 126;
}

fn push_code_char(out: &mut String, c: char) {
    match c {
        '&' => out.push_str(&"&amp;"),
        '<' => out.push_str(&"&lt;"),
        '>' => out.push_str(&"&gt;"),
        '\n' => out.push(' '),
        _ => out.push(c),
    }
}
