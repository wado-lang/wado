//! Inline rendering: code spans, emphasis/strong, strikethrough, links,
//! images, and backslash escapes.
//!
//! Emphasis matching uses a pragmatic forward search rather than the full
//! CommonMark delimiter stack: an opener is matched to the next same-character
//! run that is right-flanking. This resolves the common and cross-delimiter
//! nested cases; some same-character nesting and flanking edge cases diverge
//! from CommonMark, which is acceptable for the v0.1 subset.

use { escape_attr, escape_text } from "./html.wado";

pub fn render_inline(text: &String) -> String {
    let mut chars: List<char> = [];
    for let c of text.chars() {
        chars.push(c);
    }
    return render_range(&chars, 0, chars.len());
}

fn render_range(chars: &List<char>, start: i32, end: i32) -> String {
    let mut out = String::new();
    let mut i = start;
    while i < end {
        let c = chars[i];
        if c == '\\' && i + 1 < end && is_ascii_punct(chars[i + 1]) {
            push_escaped(&mut out, chars[i + 1]);
            i += 2;
            continue;
        }
        if c == '\n' {
            if i > start && chars[i - 1] == '\\' {
                out.pop();
                out.push_str(&"<br />\n");
            } else if i - 2 >= start && chars[i - 1] == ' ' && chars[i - 2] == ' ' {
                trim_trailing_spaces(&mut out);
                out.push_str(&"<br />\n");
            } else {
                out.push('\n');
            }
            i += 1;
            continue;
        }
        if c == 'h' {
            match try_autolink(chars, i, end) {
                Some([html, next]) => {
                    out.push_str(&html);
                    i = next;
                    continue;
                },
                None => {
                },
            }
        }
        if c == '`' {
            match try_code_span(chars, i, end) {
                Some([html, next]) => {
                    out.push_str(&html);
                    i = next;
                    continue;
                },
                None => {
                },
            }
        }
        if c == '!' && i + 1 < end && chars[i + 1] == '[' {
            match try_link(chars, i + 1, end, true) {
                Some([html, next]) => {
                    out.push_str(&html);
                    i = next;
                    continue;
                },
                None => {
                },
            }
        }
        if c == '[' {
            match try_link(chars, i, end, false) {
                Some([html, next]) => {
                    out.push_str(&html);
                    i = next;
                    continue;
                },
                None => {
                },
            }
        }
        if c == '*' || c == '_' || c == '~' {
            match try_emphasis(chars, i, end, c) {
                Some([html, next]) => {
                    out.push_str(&html);
                    i = next;
                    continue;
                },
                None => {
                },
            }
        }
        push_escaped(&mut out, c);
        i += 1;
    }
    return out;
}

fn try_code_span(chars: &List<char>, i: i32, end: i32) -> Option<[String, i32]> {
    let n = run_length(chars, i, '`');
    let mut j = i + n;
    while j < end {
        if chars[j] == '`' {
            let m = run_length(chars, j, '`');
            if m == n {
                let content = code_content(chars, i + n, j);
                return Option::Some([`<code>{content}</code>`, j + n]);
            }
            j += m;
        } else {
            j += 1;
        }
    }
    return null;
}

fn code_content(chars: &List<char>, s: i32, e: i32) -> String {
    let mut a = s;
    let mut b = e;
    if b - a >= 2 && chars[a] == ' ' && chars[b - 1] == ' ' && !all_spaces(chars, a, b) {
        a += 1;
        b -= 1;
    }
    let mut out = String::new();
    let mut k = a;
    while k < b {
        push_code_char(&mut out, chars[k]);
        k += 1;
    }
    return out;
}

fn try_link(chars: &List<char>, open: i32, end: i32, is_image: bool) -> Option<[String, i32]> {
    let mut depth = 0;
    let mut j = open;
    let mut close = -1;
    while j < end {
        let c = chars[j];
        if c == '\\' {
            j += 2;
            continue;
        }
        if c == '[' {
            depth += 1;
        } else if c == ']' {
            depth -= 1;
            if depth == 0 {
                close = j;
                break;
            }
        }
        j += 1;
    }
    if close < 0 || close + 1 >= end || chars[close + 1] != '(' {
        return null;
    }
    let mut k = close + 2;
    let mut pdepth = 1;
    let mut pclose = -1;
    while k < end {
        let c = chars[k];
        if c == '\\' {
            k += 2;
            continue;
        }
        if c == '(' {
            pdepth += 1;
        } else if c == ')' {
            pdepth -= 1;
            if pdepth == 0 {
                pclose = k;
                break;
            }
        }
        k += 1;
    }
    if pclose < 0 {
        return null;
    }
    let dest_raw = raw_string(chars, close + 2, pclose);
    let dest_trimmed = dest_raw.trim();
    let dest = first_field(&dest_trimmed);
    let href = escape_attr(&dest);
    if is_image {
        let alt_raw = raw_string(chars, open + 1, close);
        let alt = escape_attr(&alt_raw);
        return Option::Some([`<img src="{href}" alt="{alt}" />`, pclose + 1]);
    }
    let text_html = render_range(chars, open + 1, close);
    return Option::Some([`<a href="{href}">{text_html}</a>`, pclose + 1]);
}

fn try_emphasis(chars: &List<char>, i: i32, end: i32, d: char) -> Option<[String, i32]> {
    let n = run_length(chars, i, d);
    if d == '~' && n < 2 {
        return null;
    }
    let want = if d == '~' {
        2;
    } else if n >= 2 {
        2;
    } else {
        1;
    };
    let after = i + n;
    if after >= end || is_space(chars[after]) {
        return null;
    }
    let mut j = after;
    while j < end {
        if chars[j] == d {
            let m = run_length(chars, j, d);
            if m >= want && !is_space(chars[j - 1]) {
                let inner = render_range(chars, after, j);
                let tag = if d == '~' {
                    "del";
                } else if want == 2 {
                    "strong";
                } else {
                    "em";
                };
                return Option::Some([`<{tag}>{inner}</{tag}>`, j + want]);
            }
            j += m;
        } else {
            j += 1;
        }
    }
    return null;
}

fn run_length(chars: &List<char>, start: i32, d: char) -> i32 {
    let mut n = 0;
    let mut i = start;
    let len = chars.len();
    while i < len && chars[i] == d {
        n += 1;
        i += 1;
    }
    return n;
}

fn raw_string(chars: &List<char>, s: i32, e: i32) -> String {
    let mut out = String::new();
    let mut k = s;
    while k < e {
        out.push(chars[k]);
        k += 1;
    }
    return out;
}

fn first_field(s: &String) -> String {
    let mut out = String::new();
    for let c of s.chars() {
        if c == ' ' || c == '\t' {
            break;
        }
        out.push(c);
    }
    return out;
}

fn all_spaces(chars: &List<char>, s: i32, e: i32) -> bool {
    let mut k = s;
    while k < e {
        if chars[k] != ' ' {
            return false;
        }
        k += 1;
    }
    return true;
}

fn try_autolink(chars: &List<char>, i: i32, end: i32) -> Option<[String, i32]> {
    if !starts_with_at(chars, i, "http://") && !starts_with_at(chars, i, "https://") {
        return null;
    }
    let mut j = i;
    while j < end {
        let c = chars[j];
        if is_space(c) || c == '<' || c == '>' {
            break;
        }
        j += 1;
    }
    while j > i && is_trailing_punct(chars[j - 1]) {
        j -= 1;
    }
    if j <= i {
        return null;
    }
    let url = raw_string(chars, i, j);
    let href = escape_attr(&url);
    let text = escape_text(&url);
    return Option::Some([`<a href="{href}">{text}</a>`, j]);
}

fn starts_with_at(chars: &List<char>, i: i32, pat: String) -> bool {
    let len = chars.len();
    let mut k = 0;
    for let pc of pat.chars() {
        if i + k >= len || chars[i + k] != pc {
            return false;
        }
        k += 1;
    }
    return true;
}

fn is_trailing_punct(c: char) -> bool {
    return c == '.' || c == ',' || c == ';' || c == ':' || c == '!' || c == '?';
}

fn trim_trailing_spaces(out: &mut String) {
    loop {
        match out.pop() {
            Some(ch) => {
                if ch != ' ' {
                    out.push(ch);
                    break;
                }
            },
            None => {
                break;
            },
        }
    }
}

fn is_space(c: char) -> bool {
    return c == ' ' || c == '\t' || c == '\n';
}

fn is_ascii_punct(c: char) -> bool {
    let v = c as i32;
    return v >= 33 && v <= 47 || v >= 58 && v <= 64 || v >= 91 && v <= 96 || v >= 123 && v <= 126;
}

fn push_escaped(out: &mut String, c: char) {
    match c {
        '&' => out.push_str(&"&amp;"),
        '<' => out.push_str(&"&lt;"),
        '>' => out.push_str(&"&gt;"),
        _ => out.push(c),
    }
}

fn push_code_char(out: &mut String, c: char) {
    match c {
        '&' => out.push_str(&"&amp;"),
        '<' => out.push_str(&"&lt;"),
        '>' => out.push_str(&"&gt;"),
        '\n' => out.push(' '),
        _ => out.push(c),
    }
}
