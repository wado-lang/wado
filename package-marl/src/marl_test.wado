use { render } from "./marl.wado";

test "render wraps a single line in a paragraph" {
    assert render(&"hello world") == "<p>hello world</p>";
}

test "render emits ATX headings by level" {
    assert render(&"# Title") == "<h1>Title</h1>";
    assert render(&"### Deep") == "<h3>Deep</h3>";
    assert render(&"###### Six") == "<h6>Six</h6>";
}

test "render rejects seven hashes as a heading" {
    assert render(&"####### too deep") == "<p>####### too deep</p>";
}

test "render requires a space after the hashes" {
    assert render(&"#notitle") == "<p>#notitle</p>";
}

test "render escapes inline HTML in text and headings" {
    assert render(&"# a < b & c") == "<h1>a &lt; b &amp; c</h1>";
    assert render(&"x < y & z") == "<p>x &lt; y &amp; z</p>";
}

test "render joins consecutive lines into one paragraph" {
    assert render(&"line one
line two") == "<p>line one
line two</p>";
}

test "render separates paragraphs on a blank line" {
    assert render(&"first

second") == "<p>first</p>
<p>second</p>";
}

test "render emits a thematic break" {
    assert render(&"---") == "<hr />";
    assert render(&"***") == "<hr />";
    assert render(&"- - -") == "<hr />";
}

test "render mixes headings, paragraphs, and breaks" {
    let input = "# Heading

A paragraph.

---

Another.";
    let expected = "<h1>Heading</h1>
<p>A paragraph.</p>
<hr />
<p>Another.</p>";
    assert render(&input) == expected;
}

test "render trims a closing-space heading" {
    assert render(&"##   Spaced   ") == "<h2>Spaced</h2>";
}

test "render emits a fenced code block" {
    assert render(&"```
code
```") == "<pre><code>code
</code></pre>";
}

test "render tags a fenced code block with its language" {
    assert render(&"```wado
let x = 1;
```") == "<pre><code class=\"language-wado\">let x = 1;
</code></pre>";
}

test "render escapes html inside a code fence but not markdown" {
    assert render(&"```
a < b & *c*
```") == "<pre><code>a &lt; b &amp; *c*
</code></pre>";
}

test "render accepts tilde fences" {
    assert render(&"~~~
x
~~~") == "<pre><code>x
</code></pre>";
}

test "render wraps shorter fences inside a longer fence" {
    assert render(&"````
```
inner
```
````") == "<pre><code>```
inner
```
</code></pre>";
}

test "render closes an unterminated fence at end of input" {
    assert render(&"```
abc") == "<pre><code>abc
</code></pre>";
}

test "render emits a blockquote" {
    assert render(&"> quote") == "<blockquote>
<p>quote</p>
</blockquote>";
}

test "render joins blockquote lines" {
    assert render(&"> a
> b") == "<blockquote>
<p>a
b</p>
</blockquote>";
}

test "render renders block structure inside a blockquote" {
    assert render(&"> # Title") == "<blockquote>
<h1>Title</h1>
</blockquote>";
}

test "render emits an unordered list" {
    assert render(&"- a
- b
- c") == "<ul>
<li>a</li>
<li>b</li>
<li>c</li>
</ul>";
}

test "render emits an ordered list" {
    assert render(&"1. one
2. two") == "<ol>
<li>one</li>
<li>two</li>
</ol>";
}

test "render renders inline markup in list items" {
    assert render(&"- **bold** item") == "<ul>
<li><strong>bold</strong> item</li>
</ul>";
}

test "render ends a list at a blank line" {
    assert render(&"- a

text") == "<ul>
<li>a</li>
</ul>
<p>text</p>";
}

test "render nests a list under an item" {
    assert render(&"- parent
  - child") == "<ul>
<li>
<p>parent</p>
<ul>
<li>child</li>
</ul>
</li>
</ul>";
}

test "render emits a GFM table" {
    let input = "| a | b |
| --- | --- |
| 1 | 2 |";
    let expected = "<table>
<thead>
<tr>
<th>a</th>
<th>b</th>
</tr>
</thead>
<tbody>
<tr>
<td>1</td>
<td>2</td>
</tr>
</tbody>
</table>";
    assert render(&input) == expected;
}

test "render applies table column alignment" {
    let input = "| L | C | R |
| :-- | :-: | --: |
| a | b | c |";
    let expected = "<table>
<thead>
<tr>
<th align=\"left\">L</th>
<th align=\"center\">C</th>
<th align=\"right\">R</th>
</tr>
</thead>
<tbody>
<tr>
<td align=\"left\">a</td>
<td align=\"center\">b</td>
<td align=\"right\">c</td>
</tr>
</tbody>
</table>";
    assert render(&input) == expected;
}

test "render treats a pipe line without a delimiter row as a paragraph" {
    assert render(&"a | b") == "<p>a | b</p>";
}

test "render accepts a tab after the hashes" {
    assert render(&"#\ttitle") == "<h1>title</h1>";
}

test "render treats an all-hash line as an empty heading" {
    assert render(&"###") == "<h3></h3>";
}

test "render strips an ATX closing sequence" {
    assert render(&"## foo ##") == "<h2>foo</h2>";
    assert render(&"# foo #########") == "<h1>foo</h1>";
    assert render(&"### bar ###") == "<h3>bar</h3>";
}

test "render keeps hashes that are not a closing sequence" {
    assert render(&"# foo#") == "<h1>foo#</h1>";
    assert render(&"### foo ### b") == "<h3>foo ### b</h3>";
}

test "render splits lists when the bullet marker changes" {
    assert render(&"- a
* b") == "<ul>
<li>a</li>
</ul>
<ul>
<li>b</li>
</ul>";
}

test "render emits an ol start attribute for non-1 first number" {
    assert render(&"3. three
4. four") == "<ol start=\"3\">
<li>three</li>
<li>four</li>
</ol>";
}

test "render treats a tab like a space in list and quote markers" {
    assert render(&"-\titem") == "<ul>
<li>item</li>
</ul>";
    assert render(&">\tquoted") == "<blockquote>
<p>quoted</p>
</blockquote>";
}

test "render preserves tabs inside code content" {
    assert render(&"```
\tcode
```") == "<pre><code>\tcode
</code></pre>";
}
