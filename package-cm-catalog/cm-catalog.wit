package root:component;

interface cm-catalog {
  enum color {
    red,
    green,
    blue,
  }
  record future-cell {
    value: future<u32>,
  }
  type meters = f64;
  variant mixed {
    as-int(u32),
    as-float(f32),
  }
  flags perms {
    read,
    write,
    execute,
  }
  record point {
    x: f64,
    y: f64,
  }
  variant shape {
    circle(f64),
    rect(tuple<f64, f64>),
    nothing,
  }
  id-bool: func(v: bool) -> bool;
  id-u8: func(v: u8) -> u8;
  id-u16: func(v: u16) -> u16;
  id-u32: func(v: u32) -> u32;
  id-u64: func(v: u64) -> u64;
  id-s8: func(v: s8) -> s8;
  id-s16: func(v: s16) -> s16;
  id-s32: func(v: s32) -> s32;
  id-s64: func(v: s64) -> s64;
  id-f32: func(v: f32) -> f32;
  id-f64: func(v: f64) -> f64;
  id-char: func(v: char) -> char;
  id-string: func(v: string) -> string;
  id-list-u8: func(v: list<u8>) -> list<u8>;
  id-list-string: func(v: list<string>) -> list<string>;
  id-tuple-pair: func(v: tuple<u32, string>) -> tuple<u32, string>;
  id-tuple-triple: func(v: tuple<u8, bool, char>) -> tuple<u8, bool, char>;
  id-option-u32: func(v: option<u32>) -> option<u32>;
  id-option-string: func(v: option<string>) -> option<string>;
  id-result-both: func(v: result<u32, string>) -> result<u32, string>;
  id-result-ok: func(v: result<u32>) -> result<u32>;
  id-result-err: func(v: result<_, string>) -> result<_, string>;
  id-result-unit: func(v: result) -> result;
  id-record: func(v: point) -> point;
  id-enum: func(v: color) -> color;
  id-variant: func(v: shape) -> shape;
  id-flags: func(v: perms) -> perms;
  id-newtype: func(v: meters) -> meters;
  id-mixed: func(v: mixed) -> mixed;
  id-result-fu: func(v: result<f32, u32>) -> result<f32, u32>;
  id-list-option: func(v: list<option<u32>>) -> list<option<u32>>;
  id-option-list: func(v: option<list<u8>>) -> option<list<u8>>;
  id-list-record: func(v: list<point>) -> list<point>;
  id-option-record: func(v: option<point>) -> option<point>;
  id-list-tuple: func(v: list<tuple<u32, string>>) -> list<tuple<u32, string>>;
  id-result-list: func(v: result<list<point>, string>) -> result<list<point>, string>;
  id-assoc-array: func(v: list<tuple<string, u32>>) -> list<tuple<string, u32>>;
  id-tuple-record: func(v: tuple<point, u32>) -> tuple<point, u32>;
  id-tuple-option: func(v: tuple<option<u32>, u8>) -> tuple<option<u32>, u8>;
  id-tuple-list: func(v: tuple<list<string>, u32>) -> tuple<list<string>, u32>;
  id-list-tuple-record: func(v: list<tuple<point, u32>>) -> list<tuple<point, u32>>;
  id-future-bool: func(v: future<bool>) -> future<bool>;
  id-future-u8: func(v: future<u8>) -> future<u8>;
  id-future-u16: func(v: future<u16>) -> future<u16>;
  id-future-u32: func(v: future<u32>) -> future<u32>;
  id-future-u64: func(v: future<u64>) -> future<u64>;
  id-future-s8: func(v: future<s8>) -> future<s8>;
  id-future-s16: func(v: future<s16>) -> future<s16>;
  id-future-s32: func(v: future<s32>) -> future<s32>;
  id-future-s64: func(v: future<s64>) -> future<s64>;
  id-future-f32: func(v: future<f32>) -> future<f32>;
  id-future-f64: func(v: future<f64>) -> future<f64>;
  id-future-char: func(v: future<char>) -> future<char>;
  id-future-string: async func(v: future<string>) -> future<string>;
  id-future-option: async func(v: future<option<u32>>) -> future<option<u32>>;
  id-future-result: async func(v: future<result<u32, string>>) -> future<result<u32, string>>;
  id-future-list: async func(v: future<list<u32>>) -> future<list<u32>>;
  id-future-tuple: async func(v: future<tuple<u32, string>>) -> future<tuple<u32, string>>;
  id-future-record: async func(v: future<point>) -> future<point>;
  id-stream-u8: func(v: stream<u8>) -> stream<u8>;
  id-stream-u32: async func(v: stream<u32>) -> stream<u32>;
  id-stream-string: async func(v: stream<string>) -> stream<string>;
  id-stream-record: async func(v: stream<point>) -> stream<point>;
  id-option-future: func(v: option<future<u32>>) -> option<future<u32>>;
  id-result-future: func(v: result<future<u32>, string>) -> result<future<u32>, string>;
  id-list-future: func(v: list<future<u32>>) -> list<future<u32>>;
  id-list-stream: func(v: list<stream<u8>>) -> list<stream<u8>>;
  id-tuple-future: func(v: tuple<future<u32>, u32>) -> tuple<future<u32>, u32>;
  id-record-future: func(v: future-cell) -> future-cell;
}

world command {
  export cm-catalog;
}
