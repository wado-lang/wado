    let value = v.read();
    v.drop();
    let [rx, tx] = Future::<i32>::new();
    if let Some(x) = value {
        tx.write(x);
    }
    return rx;
}
export fn id_future_s64(v: Future<i64>) -> Future<i64> {
    let value = v.read();
    v.drop();
    let [rx, tx] = Future::<i64>::new();
    if let Some(x) = value {
        tx.write(x);
    }
    return rx;
}
export fn id_future_f32(v: Future<f32>) -> Future<f32> {
    let value = v.read();
    v.drop();
    let [rx, tx] = Future::<f32>::new();
    if let Some(x) = value {
        tx.write(x);
    }
    return rx;
}
export fn id_future_f64(v: Future<f64>) -> Future<f64> {
    let value = v.read();
    v.drop();
    let [rx, tx] = Future::<f64>::new();
    if let Some(x) = value {
        tx.write(x);
    }
    return rx;
}
export fn id_future_char(v: Future<char>) -> Future<char> {
    let value = v.read();
    v.drop();
    let [rx, tx] = Future::<char>::new();
    if let Some(x) = value {
        tx.write(x);
    }
    return rx;
}

// --- Future consume/produce with aggregate payloads ---
// The payload itself round-trips through CM linear memory (lower + lift), not
// just the handle. A scalar future read completes synchronously via the CM
// number-type guard, but an aggregate read blocks, so these are `async`: the
// readable end is delivered with `task return` and the payload written after.
export async fn id_future_string(v: Future<String>) -> Future<String> {
    let value = v.read();
    v.drop();
    let [rx, tx] = Future::<String>::new();
    task return rx;
    if let Some(x) = value {
        tx.write(x);
    }
}
export async fn id_future_option(v: Future<Option<u32>>) -> Future<Option<u32>> {
    let value = v.read();
    v.drop();
    let [rx, tx] = Future::<Option<u32>>::new();
    task return rx;
    if let Some(x) = value {
        tx.write(x);
    }
}
export async fn id_future_result(v: Future<Result<u32, String>>) -> Future<Result<u32, String>> {
    let value = v.read();
    v.drop();
    let [rx, tx] = Future::<Result<u32, String>>::new();
    task return rx;
    if let Some(x) = value {
        tx.write(x);
    }
}
export async fn id_future_list(v: Future<List<u32>>) -> Future<List<u32>> {
    let value = v.read();
    v.drop();
    let [rx, tx] = Future::<List<u32>>::new();
    task return rx;
    if let Some(x) = value {
        tx.write(x);
    }
}
export async fn id_future_tuple(v: Future<[u32, String]>) -> Future<[u32, String]> {
    let value = v.read();
    v.drop();
    let [rx, tx] = Future::<[u32, String]>::new();
    task return rx;
    if let Some(x) = value {
        tx.write(x);
    }
}

// `stream<u8>` pass-through: the readable end crosses the boundary unchanged.
export fn id_stream_u8(v: Stream<u8>) -> Stream<u8> {
    return v;
}

// --- Stream consume/produce ---
// Unlike the pass-through above, these read every element off the input stream
// and write it into a fresh `stream<T>`, so each element round-trips through CM
// linear memory (lift on read, lower on write). `async` because both halves
// block until the peer makes progress; the readable end is delivered with
// `task return` and the copy loop runs after.
export async fn id_stream_u32(v: Stream<u32>) -> Stream<u32> {
    let [rx, tx] = Stream::<u32>::new();
    task return rx;
    loop {
        let chunk = v.read(16);
        if chunk.len() == 0 {
            break;
        }
        tx.write(chunk);
    }
    v.drop();
    tx.drop();
}
export async fn id_stream_string(v: Stream<String>) -> Stream<String> {
    let [rx, tx] = Stream::<String>::new();
    task return rx;
    loop {
        let chunk = v.read(16);
        if chunk.len() == 0 {
            break;
        }
        tx.write(chunk);
    }
    v.drop();
    tx.drop();
}

// Handles embedded in aggregates: lift/lower of a handle at a composite offset.
export fn id_option_future(v: Option<Future<u32>>) -> Option<Future<u32>> {
    return v;
}
export fn id_result_future(v: Result<Future<u32>, String>) -> Result<Future<u32>, String> {
    return v;
}
export fn id_list_future(v: List<Future<u32>>) -> List<Future<u32>> {
    return v;
}
export fn id_list_stream(v: List<Stream<u8>>) -> List<Stream<u8>> {
    return v;
}
export fn id_tuple_future(v: [Future<u32>, u32]) -> [Future<u32>, u32] {
    return v;
}
export fn id_record_future(v: FutureCell) -> FutureCell {
    return v;
}

// The empty test block makes `e2e.rs` accept this as a test-world fixture: it
// confirms a library-shaped source compiles and instantiates under the test
// world. The lift/lower round-trip lives in `cm_catalog.rs`.
test "library shape compiles under the test world" {
}
