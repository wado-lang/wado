    v.drop();
    let [rx, tx] = Future::<i16>::new();
    if let Some(x) = value {
        tx.write(x);
    }
    return rx;
}
export fn id_future_s32(v: Future<i32>) -> Future<i32> {
    let value = v.read();
    v.drop();
    let [rx, tx] = Future::<i32>::new();
    if let Some(x) = value {
        tx.write(x);
    }
