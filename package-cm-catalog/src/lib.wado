// `stream<u8>` identity pass-through. (The streaming consume/produce path needs
// concurrent host driving plus element-type codegen; tracked as follow-up.)
export fn id_stream_u8(v: Stream<u8>) -> Stream<u8> {
    return v;
}

// Handles embedded in aggregates: the handle sits at a computed slot/offset
// inside the composite, so these exercise lift/lower offset arithmetic that the
// bare cases above do not. One per aggregate kind.
export fn id_option_future(v: Option<Future<u32>>) -> Option<Future<u32>> {
    return v;
}
export fn id_result_future(v: Result<Future<u32>, String>) -> Result<Future<u32>, String> {
    return v;
}
export fn id_list_future(v: List<Future<u32>>) -> List<Future<u32>> {
    return v;
}
export fn id_list_stream(v: List<Stream<u8>>) -> List<Stream<u8>> {
    return v;
}
export fn id_tuple_future(v: [Future<u32>, u32]) -> [Future<u32>, u32] {
    return v;
}
export fn id_record_future(v: FutureCell) -> FutureCell {
    return v;
}
