    let value = v.read();
    v.drop();
    let [rx, tx] = Future::<u64>::new();
    if let Some(x) = value {
        tx.write(x);
    }
    return rx;
}
export fn id_future_s8(v: Future<i8>) -> Future<i8> {
    let value = v.read();
    v.drop();
    let [rx, tx] = Future::<i8>::new();
    if let Some(x) = value {
        tx.write(x);
    }
    return rx;
}
