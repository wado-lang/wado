//! CM type catalog: one `identity` export per Component Model value type.
//!
//! Each function returns its argument unchanged, so the export exercises both
//! lowering (the parameter) and lifting (the result) for that exact type. The
//! function name encodes the type so the generated WIT is a self-describing
//! enumeration of the value-type ABI surface.
//!
//! Scope: value types plus the async handle types `future` and `stream`. A
//! future/stream identity moves the readable end across the boundary unchanged,
//! so it still exercises lowering (the parameter) and lifting (the result) for
//! that exact handle — `cm_catalog.rs` round-trips it functionally rather than
//! by handle equality, since the handle is single-use.
//!
//! Still TODO in this catalog: handles (`own`/`borrow` of resources), whose
//! non-duplicable boundary semantics differ from the value types above.
//!
//! This file is the published package source, reused verbatim as a compiler
//! test fixture (`wado-compiler/tests/fixtures/cm_catalog.wado` must stay
//! byte-identical):
//! - `cm_catalog.rs` compiles it as a `--lib` (library world) and round-trips a
//!   crafted Component Model value through each `id_*` export, asserting
//!   `lift(lower(x)) == x` — the real lift/lower test.
//! - `e2e.rs` discovers it as a test-world fixture (the `test` block below, no
//!   `__DATA__` section) to confirm a library-shaped source compiles and
//!   instantiates; the `export fn`s are dropped in the test world, so that run
//!   does not exercise lift/lower.

// --- Named types referenced by the identity exports below ---

pub struct Point {
    x: f64,
    y: f64,
}

pub enum Color {
    Red,
    Green,
    Blue,
}

pub variant Shape {
    Circle(f64),
    Rect([f64, f64]),
    Nothing,
}

pub flags Perms {
    Read,
    Write,
    Execute,
}

pub type Meters = f64;

// A variant whose cases flatten to the same slot size but different core
// classes (`u32`→i32 vs `f32`→f32). The CM flat-ABI join widens the shared
// slot to one class, so the other case's payload is bit-reinterpreted.
pub variant Mixed {
    AsInt(u32),
    AsFloat(f32),
}

pub struct FutureCell {
    value: Future<u32>,
}

// --- Primitives ---

export fn id_bool(v: bool) -> bool {
    return v;
}
export fn id_u8(v: u8) -> u8 {
    return v;
}
export fn id_u16(v: u16) -> u16 {
    return v;
}
export fn id_u32(v: u32) -> u32 {
    return v;
}
export fn id_u64(v: u64) -> u64 {
    return v;
}
export fn id_s8(v: i8) -> i8 {
    return v;
}
export fn id_s16(v: i16) -> i16 {
    return v;
}
export fn id_s32(v: i32) -> i32 {
    return v;
}
export fn id_s64(v: i64) -> i64 {
    return v;
}
export fn id_f32(v: f32) -> f32 {
    return v;
}
export fn id_f64(v: f64) -> f64 {
    return v;
}
export fn id_char(v: char) -> char {
    return v;
}
export fn id_string(v: String) -> String {
    return v;
}

// --- Built-in containers ---

export fn id_list_u8(v: List<u8>) -> List<u8> {
    return v;
}
export fn id_list_string(v: List<String>) -> List<String> {
    return v;
}
export fn id_tuple_pair(v: [u32, String]) -> [u32, String] {
    return v;
}
export fn id_tuple_triple(v: [u8, bool, char]) -> [u8, bool, char] {
    return v;
}
export fn id_option_u32(v: Option<u32>) -> Option<u32> {
    return v;
}
export fn id_option_string(v: Option<String>) -> Option<String> {
    return v;
}

// `result` in all four WIT forms: both arms, ok-only, err-only, neither.
export fn id_result_both(v: Result<u32, String>) -> Result<u32, String> {
    return v;
}
export fn id_result_ok(v: Result<u32, ()>) -> Result<u32, ()> {
    return v;
}
export fn id_result_err(v: Result<(), String>) -> Result<(), String> {
    return v;
}
export fn id_result_unit(v: Result<(), ()>) -> Result<(), ()> {
    return v;
}

// --- Named value types ---

export fn id_record(v: Point) -> Point {
    return v;
}
export fn id_enum(v: Color) -> Color {
    return v;
}
export fn id_variant(v: Shape) -> Shape {
    return v;
}
export fn id_flags(v: Perms) -> Perms {
    return v;
}
export fn id_newtype(v: Meters) -> Meters {
    return v;
}
export fn id_mixed(v: Mixed) -> Mixed {
    return v;
}
// `result` whose Ok/Err arms flatten to the same slot size but different core
// classes (`f32` vs `u32`); exercises the join reinterpret on the Err arm.
export fn id_result_fu(v: Result<f32, u32>) -> Result<f32, u32> {
    return v;
}

// --- Nested compositions ---

export fn id_list_option(v: List<Option<u32>>) -> List<Option<u32>> {
    return v;
}
export fn id_option_list(v: Option<List<u8>>) -> Option<List<u8>> {
    return v;
}
export fn id_list_record(v: List<Point>) -> List<Point> {
    return v;
}
export fn id_option_record(v: Option<Point>) -> Option<Point> {
    return v;
}
export fn id_list_tuple(v: List<[u32, String]>) -> List<[u32, String]> {
    return v;
}
export fn id_result_list(v: Result<List<Point>, String>) -> Result<List<Point>, String> {
    return v;
}

// --- Association list (the CM map idiom: `list<tuple<k, v>>`) ---

export fn id_assoc_array(v: List<[String, u32]>) -> List<[String, u32]> {
    return v;
}

// --- Tuples carrying aggregate (non-primitive) elements ---

export fn id_tuple_record(v: [Point, u32]) -> [Point, u32] {
    return v;
}
export fn id_tuple_option(v: [Option<u32>, u8]) -> [Option<u32>, u8] {
    return v;
}
export fn id_tuple_list(v: [List<String>, u32]) -> [List<String>, u32] {
    return v;
}
export fn id_list_tuple_record(v: List<[Point, u32]>) -> List<[Point, u32]> {
    return v;
}

// --- Async handle types (CM `future` / `stream`) ---
export fn id_future_bool(v: Future<bool>) -> Future<bool> {
    let value = v.read();
    v.drop();
    let [rx, tx] = Future::<bool>::new();
    if let Some(x) = value {
        tx.write(x);
    }
    return rx;
}
export fn id_future_u8(v: Future<u8>) -> Future<u8> {
    let value = v.read();
    v.drop();
    let [rx, tx] = Future::<u8>::new();
    if let Some(x) = value {
        tx.write(x);
    }
    return rx;
}
export fn id_future_u16(v: Future<u16>) -> Future<u16> {
    let value = v.read();
    v.drop();
    let [rx, tx] = Future::<u16>::new();
    if let Some(x) = value {
        tx.write(x);
    }
    return rx;
}
