//! The Wado language: `parse` reads Wado source with the parser Gale generates
//! from `assets/grammar/Wado.g4`, the grammar of Wado's whole syntax.
//!
//!     use { parse } from "wado-lang:wado";
//!     let result = parse(&src);

pub use {
    parse,
    ParseResult,
    Diagnostic,
    token_kind_name,
    RK_BLOCK,
    RK_TEST_DECL,
    TK_LIT_DOT,
    TK_LIT_COLONCOLON,
    TK_LPAREN,
    TK_LIT_fn,
} from "../assets/grammar/Wado.g4"
    with {
        generator: {
            module: "wado-lang:gale",
            options: {
                fragment_entries: ["statement"],
                prediction: "longest",
            },
        },
    };

/// The syntax errors in Wado `source`, one rendered message each; empty when
/// it parses. The component's public entry point.
export fn diagnose(source: String) -> List<String> {
    return parse(source).diagnostics.into_iter().map(|d| `${d}`).collect();
}
