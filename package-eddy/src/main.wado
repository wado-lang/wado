//! Eddy's CLI: reviews what a branch changes, prints the findings as JSON, and
//! adds the review to the record of its head commit.
//!
//! Up to `--reviewers` (20) reviewers each search a batch of the definitions
//! the change from the merge base of `--base` (`origin/main`) to `--head`
//! (`HEAD`) touched, read whole from a checkout of the head under
//! `scratchpad/`, which they read further through Read, Grep and Glob. One
//! call merges what they found and keeps the most severe. A reproducer per
//! candidate kept then writes a test into that checkout and runs it through
//! Write and Run, with `cargo`, and where `mise` is set up, with it and each
//! tool it installed for the project. That needs `--process-read` on the
//! `cargo` and `rustup` homes, and for `mise` on its binary and its data
//! directory; `--no-run` reports the candidates unreproduced.
//!
//! A second model, `--reporter` (`claude-haiku-5-5`), then reads what each
//! reproducer did and gives its finding its line and the test that reproduced
//! it, which is tried again alone. Only a finding that test reproduces alone
//! is reported, whether the change brought it in or left it in place; the
//! record keeps the rest.
//! `--report-again` reports the last recorded review of the head once more,
//! with no new review, to try another reporter on the same findings.
//!
//! The record of a head is `<--reviews>/<head>/`, one file per review; the
//! default is a clone of the repository's wiki, which keeps them. Under `<--out>/<head>/`
//! (`scratchpad/eddy`) go `review.md`, one pull request comment for the whole
//! review and its cost, written even when the review fails, and for each
//! finding `<n>.md`, the body of a comment that reproduces it from one pasted
//! block, and `<n>.patch` for `git apply`.
//!
//! Run it from the repository root, every commit to review made. The reviewer
//! is a build input: `CLAUDE_MODEL` in the environment, or
//! `-D CLAUDE_MODEL=...`. Both models must take structured outputs
//! (`output_config.format`): every request holds its reply to a schema, and
//! the API refuses one for a model that does not.
//!
//! ```sh
//! CLAUDE_API_KEY=... wado run --process-read ~/.cargo --process-read ~/.rustup \
//!     package-eddy/src/main.wado
//! ```

use { from_env } from "core:args";
use { eprintln, println, exit_error, Environment, Exit, Stderr, Stdout } from "core:cli";
use fs from "core:fs";
use { Preopens } from "core:fs";
use { to_bytes_pretty, from_string } from "core:json";
use { Process } from "core:process";
use { Deserialize } from "core:serde";
use { Instant } from "core:temporal";
use { token_hex } from "core:secure_random";
use { Client } from "wasi:http";
use { MonotonicClock, SystemClock } from "wasi:clocks";
use { Random } from "wasi:random";
use { git, try_git, paths_between, diff_between } from "./git.wado";
use { Credential, Usage } from "./anthropic.wado";
use { comment, finding_id, review_comment } from "./comment.wado";
use { cost_summary } from "./cost.wado";
use { report_all } from "./report.wado";
use { spend_report, spends } from "./spend.wado";
use { review, Submission, Finding, Reviewed, MAX_REVIEWERS } from "./review.wado";
use { hold_tree, home_runner, with_mise_tools } from "./snapshot.wado";
use { Runner, Workspace } from "./tools.wado";

#[param(from_env = "CLAUDE_MODEL")]
global CLAUDE_MODEL: String = "claude-opus-5-5";

#[param(name = "diff_limit")]
global LIMIT: i32 = 2_000_000;

global USAGE: String = "usage: eddy [--base <rev>] [--head <rev>] [--no-run] [--reporter <model>] [--report-again] [--reviewers <n>] [--max-turns <n>] [--effort <level>] [--reviews <dir>] [--out <dir>]";

struct Options {
    base: String = "origin/main",
    head: String = "HEAD",
    no_run: bool = false,
    reporter: String = "claude-haiku-5-5",
    report_again: bool = false,
    reviewers: i32 = MAX_REVIEWERS,
    max_turns: i32 = 40,
    effort: String = "medium",
    reviews: String = "scratchpad/wiki/reviews",
    out: String = "scratchpad/eddy",
}
impl Deserialize for Options;

/// One review of a head commit, recorded as `<--reviews>/<head>/<name>.json`.
struct Attempt {
    /// The merge base the diff was taken from, which moves with `--base`.
    base: String,
    reviewer: String,
    /// Empty in a record written before a second model reported.
    reporter: String = "",
    run: bool,
    /// 0 in a record written before reviews were split: one reviewer searched
    /// and reproduced alone.
    reviewers: i32 = 0,
    max_turns: i32,
    /// Empty in a record written before it was sent: the API's default.
    effort: String = "",
    result: Reviewed,
    /// What the reporter took. Absent in a record written before it was kept.
    report_usage: Option<Usage> = null,
    report_error: Option<String> = null,
}

struct Report {
    findings: List<Finding>,
}

export fn run() with (Stdout, Stderr, Environment, Exit, Preopens, Process, Client, MonotonicClock, SystemClock, Random) {
    let options = match from_env::<Options>() {
        Ok(options) => options,
        Err(e) => fail(`${e}\n${USAGE}`),
    };
    if options.max_turns < 1 {
        fail(`--max-turns must be at least 1\n${USAGE}`);
    }
    if !(1 <= options.reviewers <= MAX_REVIEWERS) {
        fail(`--reviewers must be from 1 to ${MAX_REVIEWERS}\n${USAGE}`);
    }
    let mut credential = match Credential::from_env() {
        Ok(credential) => credential,
        Err(e) => fail(e),
    };
    let Some(head) = try_git(["rev-parse", "--verify", `${options.head}^{commit}`]) else {
        fail(
            `git finds no commit ${options.head} here. Run from the root of the main checkout: a linked worktree keeps its git directory where a child of wado run cannot reach`,
        );
    };
    let head = head.trim().to_string();
    let base = git(["merge-base", options.base, head]).trim().to_string();
    // Before the review, so one that cannot be recorded is not paid for.
    let records = fs::join(&options.reviews, &head);
    if let Err(e) = fs::create_dir_all(&records) {
        fail(`${e}`);
    }
    let earlier: Option<Attempt> = if options.report_again { Some(last_attempt(&records)) } else { null };
    let changed = paths_between(&base, &head);
    let diff = match diff_between(&base, &head, &changed, "branch", LIMIT) {
        Ok(diff) => diff,
        Err(e) => fail(e),
    };
    // Nothing else says what the change means to do before it has a pull
    // request to describe it.
    let commits = git(["log", "--reverse", "--no-merges", "--format=%B", `${base}..${head}`]);
    let heading = `PULL REQUEST, not opened yet. Its commit messages, oldest first:

${commits.trim()}`;

    // Held to the end, since the reporter reads the tree too.
    let tree = match hold_tree() {
        Ok(tree) => tree,
        Err(e) => fail(e),
    };
    let root = tree.check_out(&head, !options.no_run);
    let runner: Option<Runner> = if options.no_run { null } else { Some(with_mise_tools(home_runner(), &root)) };
    let w = Workspace { root, runner };
    let change = Submission { heading, diff };
    let mut result = if let Some(earlier) = &earlier {
        reviewed_again(&earlier.result);
    } else {
        if w.runner matches { Some(_) } {
            w.prebuild(&changed);
        }
        review(
            &mut credential,
            CLAUDE_MODEL,
            &change,
            &Some(w),
            &head,
            options.reviewers,
            options.max_turns,
            options.effort,
        );
    };
    // A report that fails leaves the findings as the reviewer worded them.
    let mut report_usage = Usage {};
    let report_error: Option<String> = match &result.error {
        Some(_) => null,
        null => match report_all(
            &mut credential,
            options.reporter,
            &change,
            &w,
            &head,
            &mut result,
            &mut report_usage,
        ) {
            Ok(_) => null,
            Err(e) => Some(e),
        },
    };
    if let Some(e) = &report_error {
        eprintln(`eddy: the findings are not placed or reproduced: ${*e}`);
    }

    let attempt = Attempt {
        base,
        reviewer: CLAUDE_MODEL,
        reporter: options.reporter,
        run: !options.no_run,
        reviewers: match &earlier {
            Some(e) => e.reviewers,
            null => options.reviewers,
        },
        max_turns: options.max_turns,
        effort: options.effort,
        result,
        report_usage: Some(report_usage),
        report_error,
    };
    // Each review is a file of its own, so writers of one head's record only
    // ever add files. The name sorts by when the review ended.
    let path = fs::join(&records, `${Instant::now().epoch_milliseconds()}-${token_hex(4)}.json`);
    fs::write(&path, &to_bytes_pretty(&attempt).unwrap()).unwrap();
    eprintln(
        `recorded in ${path}: ${result.searches.len()} searches, ${result.candidates.len()} candidates kept, ${result.reproductions.len()} tried, ${result.findings.len()} reproduced alone, ${result.total_turns()} turns`,
    );
    // Computed here rather than recorded: a price changes, and the tokens a
    // review took do not.
    let cost = cost_summary(&[
        [CLAUDE_MODEL, result.spent()],
        [options.reporter, report_usage],
    ]);
    eprintln(cost);
    if let Some(s) = spends(&CLAUDE_MODEL, &result) {
        eprintln(spend_report(&s));
    }

    let dir = fs::join(&options.out, &head);
    write_findings(&dir, &head, &result.findings);
    fs::write(
        fs::join(&dir, "review.md"),
        &review_comment(&result.findings, &head, &cost, &result.error, &report_error),
    ).unwrap();
    if let Some(e) = &result.error {
        fail(*e);
    }
    eprintln(`the review's comment, each finding's, and the patch that reproduces it, in ${dir}`);
    println(String::from_utf8_lossy(to_bytes_pretty(&Report { findings: result.findings }).unwrap()));
}

/// The review of a head that `records` holds last.
fn last_attempt(records: &String) -> Attempt with (Stderr, Exit, Preopens) {
    let mut names: List<String> = [];
    for let entry of fs::read_dir(records).unwrap() {
        names.push(entry.name);
    }
    if names.is_empty() {
        fail(`--report-again reports a recorded review, and ${*records} holds none`);
    }
    names.sort();
    let path = fs::join(records, &names[names.len() - 1]);
    return match from_string::<Attempt, String>(fs::read_to_string(&path).unwrap()) {
        Ok(attempt) => attempt,
        Err(e) => fail(`${path} is not a recorded review: ${e:?}`),
    };
}

/// `earlier`, a recorded review, as its reviewers left it: the findings in
/// their words, before any was placed or reproduced. Reporting it again tries
/// another reporter on one review, where a second review would find other
/// things.
fn reviewed_again(earlier: &Reviewed) -> Reviewed {
    let mut again = unreported(earlier);
    again.searches = [];
    for let r of &mut again.reproductions {
        *r = unreported(r);
    }
    return again;
}

/// `step` with nothing a report added, and nothing spent: the earlier attempt
/// holds what the review took.
fn unreported(step: &Reviewed) -> Reviewed {
    let mut again = *step;
    again.usage = null;
    again.requests = [];
    for let f of &mut again.findings {
        f.line = 0;
        f.repro = null;
    }
    return again;
}

/// Writes finding `n`, from 1, of a review of `head` into `dir` as `<n>.md`,
/// the pull request comment for it, and `<n>.patch` where it has one, for
/// `git apply`. An earlier review's files there are removed first.
fn write_findings(dir: &String, head: &String, findings: &List<Finding>) with Preopens {
    fs::remove_dir_all(dir).unwrap();
    fs::create_dir_all(dir).unwrap();
    for let [i, f] of findings.into_iter().enumerate() {
        let n = i + 1;
        fs::write(fs::join(dir, `${n}.md`), &comment(f, head, &finding_id(head, n))).unwrap();
        if let Some(r) = &f.repro && !r.patch.is_empty() {
            fs::write(fs::join(dir, `${n}.patch`), &r.patch).unwrap();
        }
    }
}

fn fail(message: String) -> ! with (Stderr, Exit) {
    eprintln(`eddy: ${message}`);
    exit_error();
}
