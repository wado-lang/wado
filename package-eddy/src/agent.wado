//! A model working a task with the repository tools until it answers.

use { Preopens } from "core:fs";
use { Process } from "core:process";
use { Client } from "wasi:http";
use { MonotonicClock } from "wasi:clocks";
use { Value } from "core:value";
use { to_string } from "core:json";
use { converse, message, Credential, Format, Message, Usage } from "./anthropic.wado";
use { Workspace } from "./tools.wado";

/// What an agent did. A run that failed keeps what it spent before the error.
pub struct AgentRun {
    pub answer: Result<String, String>,
    pub turns: i32,
    pub calls: List<Call>,
    pub usage: Usage,
    pub requests: List<Request>,
}

/// One request of a conversation: when it started and what it took. A cache
/// entry lives five minutes from the last request that read it, so the gaps
/// between starts say which requests found the conversation cached.
pub struct Request {
    /// Seconds from the conversation's first request.
    pub started: f64,
    pub usage: Usage,
}

/// A tool call the model made, kept to see how it read.
pub struct Call {
    pub name: String,
    pub input: Value,
    pub is_error: bool,
    /// What the call returned, where `Workspace::observes` keeps it.
    pub output: Option<String> = null,
    /// The turn that made it, from 1; 0 in a record written before it was
    /// kept.
    pub turn: i32 = 0,
    /// The length of what it returned, in bytes.
    pub bytes: i32 = 0,
}

struct TextBlock {
    #[wire(name = "type")]
    kind: String = "text",
    text: String,
}

struct ToolResult {
    #[wire(name = "type")]
    kind: String = "tool_result",
    tool_use_id: String,
    content: String,
    is_error: bool,
}

struct Blocks {
    role: String,
    content: List<Value>,
}

/// A text block the cache keeps an entry at the end of.
struct CachedText {
    #[wire(name = "type")]
    kind: String = "text",
    text: String,
    cache_control: Ephemeral,
}

struct Ephemeral {
    #[wire(name = "type")]
    kind: String = "ephemeral",
}

/// What an agent is first asked: `shared`, which other agents are asked too,
/// and then `own`, its part alone. The cache keeps an entry at the end of
/// `shared`, so another agent under the same system prompt and tools reads it
/// from the cache rather than writing it again.
pub struct Task {
    pub shared: String,
    pub own: String = "",
}

impl Task {
    /// The task as one text, for a request that is not a conversation.
    pub fn text(&self) -> String {
        return if self.own.is_empty() { self.shared } else { `${self.shared}\n\n${self.own}` };
    }

    fn opening(&self) -> Value {
        if self.own.is_empty() {
            return message(&Message { role: "user", content: self.shared });
        }
        return message(&Blocks {
            role: "user",
            content: [
                message(&CachedText { text: self.shared, cache_control: Ephemeral {} }),
                message(&TextBlock { text: self.own }),
            ],
        });
    }
}

/// The answer `model` gives to `task` after reading `ws` with the tools, in at
/// most `max_turns` turns, at `effort`, held to `format`. The last turn takes
/// no tool call.
pub fn run_agent(
    credential: &mut Credential,
    model: String,
    system: String,
    task: &Task,
    ws: &Workspace,
    max_turns: i32,
    max_tokens: i32,
    effort: String,
    format: Format,
) -> AgentRun with (Client, Preopens, Process, MonotonicClock) {
    assert max_turns >= 1;
    let declared = ws.tools();
    let mut messages = [task.opening()] as List<Value>;
    let [mut turns, mut calls, mut usage] = [0, [] as List<Call>, Usage {}];
    let mut requests: List<Request> = [];
    let first = MonotonicClock::now();
    loop {
        turns += 1;
        let last = turns == max_turns;
        let started = (MonotonicClock::now() - first) as f64 / 1e9;
        let turn = match converse(
            credential,
            model,
            system,
            &declared,
            !last,
            &messages,
            max_tokens,
            effort,
            &format,
        ) {
            Ok(turn) => turn,
            Err(e) => {
                return AgentRun { answer: Err(e), turns, calls, usage, requests };
            },
        };
        usage.add_request(&turn.usage);
        requests.push(Request { started, usage: turn.usage });
        if turn.stop_reason != "tool_use" {
            let answer: Result<String, String> = if turn.stop_reason == "end_turn" {
                Ok(turn.text());
            } else {
                Err(`stopped on ${turn.stop_reason}`);
            };
            return AgentRun { answer, turns, calls, usage, requests };
        }
        let mut results: List<Value> = [];
        for let b of turn.blocks() {
            if b.kind != "tool_use" {
                continue;
            }
            let name = b.name.unwrap();
            let result: Result<String, String> = match ws.call_limit(&name) {
                Some(limit) && count_of(&calls, &name) >= limit => Err(
                    `all ${limit} calls of ${name} are spent; answer from what you have`,
                ),
                _ => ws.call(&name, &b.input),
            };
            let [content, is_error] = match result {
                Ok(out) => [out, false],
                Err(e) => [e, true],
            };
            let output: Option<String> = if ws.observes(&name) && !is_error { Some(content) } else { null };
            calls.push(Call { name, input: b.input, is_error, output, turn: turns, bytes: content.len() });
            results.push(message(&ToolResult { tool_use_id: b.id.unwrap(), content, is_error }));
        }
        if turns + 1 == max_turns {
            results.push(message(
                &TextBlock { text: "This is your last turn: tools are no longer available. Give your answer now." },
            ));
        }
        messages.push(message(&Blocks { role: "assistant", content: turn.content }));
        messages.push(message(&Blocks { role: "user", content: results }));
    }
}

/// How many of `calls` called tool `name` and got an answer: a call refused
/// for its input did nothing, so it spends nothing.
fn count_of(calls: &List<Call>, name: &String) -> i32 {
    let mut n = 0;
    for let c of calls {
        if c.name == *name && !c.is_error {
            n += 1;
        }
    }
    return n;
}

test "an agent's own part follows the shared one, which the cache keeps an entry at the end of" {
    let alone = to_string(&Task { shared: "diff" }.opening()).unwrap();
    assert alone == #"{"role":"user","content":"diff"}"#;
    let split = to_string(&Task { shared: "diff", own: "focus" }.opening()).unwrap();
    assert split == #"{"role":"user","content":[{"type":"text","text":"diff","cache_control":{"type":"ephemeral"}},{"type":"text","text":"focus"}]}"#;
    assert Task { shared: "diff", own: "focus" }.text() == "diff\n\nfocus";
}
