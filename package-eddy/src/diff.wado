//! Reading a unified diff by the lines the change leaves.

/// The parts of `diff` for `files`, each line of the new side led by its
/// number in the file. A reader cannot count lines from a hunk header
/// reliably, and a model less so.
pub fn numbered(diff: &String, files: &List<String>) -> String {
    let [mut out, mut wanted, mut n] = ["", false, 0];
    for let l of diff.lines() {
        if l.starts_with("diff --git ") {
            wanted = false;
        } else if let Some(path) = l.strip_prefix("+++ b/") {
            wanted = files.contains_str(path);
            if wanted {
                out.push_str(`${l}\n`);
            }
        } else if !wanted {
            continue;
        } else if let Some(hunk) = l.strip_prefix("@@ ") {
            n = new_side(hunk.to_string())[0];
            out.push_str(`${l}\n`);
        } else if l.starts_with("+") || l.starts_with(" ") {
            out.push_str(`${n:>6} ${l}\n`);
            n += 1;
        } else {
            // A line the old side alone has, or git's note that a side ends
            // without a newline.
            out.push_str(`       ${l}\n`);
        }
    }
    return out;
}

/// Whether `diff` shows `line` of `file` as the change leaves it, as a line
/// it adds or one of a hunk's context.
pub fn shows(diff: &String, file: &String, line: i32) -> bool {
    let mut in_file = false;
    for let l of diff.lines() {
        if let Some(path) = l.strip_prefix("+++ ") {
            in_file = path == `b/${*file}`;
        } else if in_file && let Some(hunk) = l.strip_prefix("@@ ") {
            let [start, count] = new_side(hunk.to_string());
            if start <= line && line < start + count {
                return true;
            }
        }
    }
    return false;
}

/// The first line and the line count of the new side of a hunk header's
/// ranges, `-a,b +c,d @@ …`. A count left out is 1.
fn new_side(ranges: String) -> [i32, i32] {
    let new = ranges.split(" ").collect()[1];
    let numbers: List<String> = new.trim_prefix("+").split(",").map(|n| n.to_string()).collect();
    let count = if numbers.len() > 1 { i32::from_str(&numbers[1]).unwrap() } else { 1 };
    return [i32::from_str(&numbers[0]).unwrap(), count];
}

test "a diff's new lines are numbered, and a line placed must be one of them" {
    let diff = "diff --git a/src/a.rs b/src/a.rs
--- a/src/a.rs
+++ b/src/a.rs
@@ -10,3 +12,4 @@ fn f() {
 context
-gone
+added
@@ -40 +43 @@
-old
+new
diff --git a/src/b.rs b/src/b.rs
--- a/src/b.rs
+++ b/src/b.rs
@@ -1,2 +1,2 @@
 kept
";
    assert shows(&diff, &"src/a.rs", 12) && shows(&diff, &"src/a.rs", 15) && shows(&diff, &"src/a.rs", 43);
    assert !shows(&diff, &"src/a.rs", 11) && !shows(&diff, &"src/a.rs", 16) && !shows(&diff, &"src/a.rs", 0);
    assert shows(&diff, &"src/b.rs", 2) && !shows(&diff, &"src/b.rs", 12);
    assert !shows(&diff, &"src/c.rs", 1);

    assert numbered(&diff, &["src/c.rs"]) == "";
    assert numbered(&diff, &["src/a.rs"]) == "+++ b/src/a.rs
@@ -10,3 +12,4 @@ fn f() {
    12  context
       -gone
    13 +added
@@ -40 +43 @@
       -old
    43 +new
";
}

test "git's marker of a missing final newline is not a line of the file" {
    let diff = "diff --git a/f b/f
--- a/f
+++ b/f
@@ -1 +1,2 @@
-a
\\ No newline at end of file
+a
+b
";
    assert numbered(&diff, &["f"]) == "+++ b/f
@@ -1 +1,2 @@
       -a
       \\ No newline at end of file
     1 +a
     2 +b
";
}
