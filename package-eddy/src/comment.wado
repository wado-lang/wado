//! A finding as the body of a pull request comment, Markdown that stands
//! alone: a reader with the repository and nothing else of Eddy's reproduces
//! the finding by pasting one block into a shell.

use { Finding, Repro } from "./review.wado";

/// GitHub refuses a comment past 65,536 characters; a byte is at most one.
global BODY_LIMIT: i32 = 60_000;

/// The most of a finding's summary and of its detail a comment holds, in
/// bytes, so that a comment without its reproduction is always within
/// `BODY_LIMIT`.
global SUMMARY_LIMIT: i32 = 2_000;
global DETAIL_LIMIT: i32 = 30_000;

/// The most of a summary one row of the review's table holds, in bytes.
global CELL_LIMIT: i32 = 200;

/// How many lines of a run's output a comment shows on each side of the text
/// that was expected.
global EXCERPT_REACH: i32 = 12;

/// The comment for `f`, found in a review of `commit`. `id` names the finding
/// in a marker a reader does not see, which is all a later run may take from
/// the comment: anyone can write one, so the rest is read from Eddy's record.
pub fn comment(f: &Finding, commit: &String, id: &String) -> String {
    let whole = body(f, commit, id, true);
    return if whole.len() <= BODY_LIMIT { whole } else { body(f, commit, id, false) };
}

fn body(f: &Finding, commit: &String, id: &String, with_steps: bool) -> String {
    let short = commit.substr_bytes(0, i32::min(commit.len(), 9));
    let status = match &f.repro {
        Some(r) && r.verified => `reproduced on \`${short}\``,
        Some(r) && r.patch.is_empty() => `not reproduced: the reviewer's test could not be tried alone, since ${shortened(
            &r.output,
            SUMMARY_LIMIT,
        )}`,
        Some(_) => "not reproduced: the reviewer's test did not fail this way when tried alone",
        None => "not reproduced",
    };
    let mut out = `**${shortened(&f.summary, SUMMARY_LIMIT)}** — ${status}\n\n${shortened(&f.detail, DETAIL_LIMIT)}\n\n`;
    if let Some(r) = &f.repro && !r.patch.is_empty() {
        out.push_str(if with_steps { steps(r, commit) } else { "The reproduction is too large for a comment.\n\n" });
    }
    out.push_str(`<!-- eddy ${*id} -->\n`);
    return out;
}

/// The one pull request comment for a review of `commit`: a table of the
/// findings and what the review cost, then each finding's comment folded, as
/// many as fit in a comment.
pub fn review_comment(findings: &List<Finding>, commit: &String, cost: &String, error: &Option<String>) -> String {
    let short = commit.substr_bytes(0, i32::min(commit.len(), 9));
    if let Some(e) = error {
        return `## Eddy\n\nThe review of \`${short}\` failed: ${shortened(e, SUMMARY_LIMIT)}\n\n${*cost}\n`;
    }
    if findings.is_empty() {
        return `## Eddy\n\nReviewed \`${short}\`. No findings; ${*cost}\n`;
    }
    let noun = if findings.len() == 1 { "finding" } else { "findings" };
    let mut out = `## Eddy\n\nReviewed \`${short}\`. ${findings.len()} ${noun}; ${*cost}\n\n| # | Where | Finding | Reproduced |\n| - | - | - | - |\n`;
    for let [i, f] of findings.into_iter().enumerate() {
        let place = if f.line > 0 { `${f.file}:${f.line}` } else { f.file };
        let reproduced = if f.repro matches { Some(r) && r.verified } { "yes" } else { "no" };
        out.push_str(`| ${i + 1} | ${code_span(&place)} | ${cell(&f.summary)} | ${reproduced} |\n`);
    }
    out.push_str("\n");
    for let [i, f] of findings.into_iter().enumerate() {
        let n = i + 1;
        let folded = `<details><summary>${n}. ${cell(&f.summary)}</summary>\n\n${comment(f, commit, &`${short}-${n}`)}\n</details>\n\n`;
        let rest = `Finding ${n} on is in the run's artifact.\n`;
        if out.len() + folded.len() + rest.len() > BODY_LIMIT {
            out.push_str(rest);
            break;
        }
        out.push_str(folded);
    }
    return out;
}

/// `text` as one cell of a Markdown table: on one line, and no `|` ending it.
fn cell(text: &String) -> String {
    return shortened(&text.replace("\n", " ").replace("|", "\\|"), CELL_LIMIT);
}

/// `text`, or its first `limit` bytes and a mark that more followed.
fn shortened(text: &String, limit: i32) -> String {
    return if text.len() <= limit { *text } else { `${text.substr_bytes(0, text.floor_char_boundary(limit))}…` };
}

/// The block that reproduces `r`, and what its run printed. Each step runs
/// only if the one before it succeeded, so a checkout or a patch that fails
/// does not leave the test to pass or fail on another tree.
fn steps(r: &Repro, commit: &String) -> String {
    let mut end = "EDDY";
    while r.patch.lines().any(|l| l == end) {
        end.push_str("_");
    }
    assert !r.run.is_empty(), "a reproduction with a patch names its command";
    let command = r.run.into_iter().map(|word| shell_word(&word)).collect().join(" ");
    let script = `git checkout ${*commit} &&
git apply <<'${end}' &&
${r.patch.trim_suffix("\n")}
${end}
${command}
`;
    let shown = excerpt(&r.output, &r.expect);
    let lead = if r.verified {
        `Fails with ${code_span(&r.expect)}:`;
    } else {
        `It was to fail with ${code_span(&r.expect)}. Tried alone, it gave:`;
    };
    return `<details><summary>Reproduce</summary>

${fenced(&script, "sh")}

${lead}

${fenced(&shown, "")}

</details>

`;
}

/// `text` in a code fence longer than any run of backticks in it.
fn fenced(text: &String, language: String) -> String {
    let fence = "`".repeat(i32::max(3, longest_backticks(text) + 1));
    return `${fence}${language}\n${text.trim_suffix("\n")}\n${fence}`;
}

fn code_span(text: &String) -> String {
    let ticks = "`".repeat(longest_backticks(text) + 1);
    return `${ticks} ${*text} ${ticks}`;
}

fn longest_backticks(text: &String) -> i32 {
    let [mut longest, mut run] = [0, 0];
    for let c of text.chars() {
        run = if c == '`' { run + 1 } else { 0 };
        longest = i32::max(longest, run);
    }
    return longest;
}

/// The lines of `output` around the first `expect`, or its last lines where
/// `expect` is not in it.
fn excerpt(output: &String, expect: &String) -> String {
    let lines: List<String> = output.lines().map(|l| l.to_string()).collect();
    let hit = match output.find(expect) {
        Some(at) && !expect.is_empty() => output.substr_bytes(0, at).split("\n").count() - 1,
        _ => lines.len() - 1,
    };
    let first = i32::max(0, hit - EXCERPT_REACH);
    let last = i32::min(lines.len(), hit + EXCERPT_REACH + 1);
    let mut out = if first > 0 { "…\n" } else { "" };
    for let i of first..<last {
        out.push_str(`${lines[i]}\n`);
    }
    if last < lines.len() {
        out.push_str("…\n");
    }
    return out;
}

/// `arg` as one word of a POSIX shell.
fn shell_word(arg: &String) -> String {
    let plain = !arg.is_empty() && arg.chars().all(|c| c.is_ascii_alphanumeric() || "_-./:=@%+,".contains(`${c}`));
    return if plain { *arg } else { `'${arg.replace("'", "'\\''")}'` };
}

test "a reproduced finding's comment holds one block that reproduces it" {
    let f = Finding {
        file: "src/a.rs",
        summary: "S",
        detail: "D",
        repro: Some(Repro {
            patch: "diff --git a/t.rs b/t.rs\n+x\n",
            run: ["cargo", "test", "--test", "t", "a b"],
            expect: "left: 1",
            verified: true,
            output: "exit code 101\nleft: 1\n",
        }),
    };
    let text = comment(&f, &"0123456789abcdef", &"012345678-1");
    assert text.starts_with("**S** — reproduced on `012345678`\n\nD\n\n");
    assert text.contains(
        "```sh\ngit checkout 0123456789abcdef &&\ngit apply <<'EDDY' &&\ndiff --git a/t.rs b/t.rs\n+x\nEDDY\ncargo test --test t 'a b'\n```",
    );
    assert text.contains("Fails with ` left: 1 `:\n\n```\nexit code 101\nleft: 1\n```");
    assert text.ends_with("<!-- eddy 012345678-1 -->\n");
}

test "a comment says which findings were not reproduced" {
    let mut f = Finding { file: "a", summary: "S", detail: "D" };
    assert comment(&f, &"0123456789", &"i").starts_with("**S** — not reproduced\n");
    assert !comment(&f, &"0123456789", &"i").contains("<details>");
    f.repro = Some(Repro {
        patch: "p\n",
        run: ["cargo", "test"],
        expect: "e",
        verified: false,
        output: "ok\n",
    });
    let text = comment(&f, &"0123456789", &"i");
    assert text.contains("did not fail this way") && text.contains("It was to fail with ` e `. Tried alone, it gave:");
    f.repro = Some(Repro {
        patch: "",
        run: [],
        expect: "e",
        verified: false,
        output: "the reproduction names no command",
    });
    let untried = comment(&f, &"0123456789", &"i");
    assert untried.starts_with(
        "**S** — not reproduced: the reviewer's test could not be tried alone, since the reproduction names no command\n",
    );
    assert !untried.contains("<details>");
}

test "what a patch holds cannot close the block around it" {
    let patch = "+let s = ```;\nEDDY\n";
    let f = Finding {
        file: "a",
        summary: "S",
        detail: "D",
        repro: Some(Repro {
            patch,
            run: ["mise", "run", "t"],
            expect: "`e`",
            verified: true,
            output: "`e`\n",
        }),
    };
    let text = comment(&f, &"0123456789", &"i");
    assert text.contains("````sh\n")
        && text.contains("git apply <<'EDDY_' &&\n")
        && text.contains("\nEDDY_\nmise run t\n````");
    assert text.contains("Fails with `` `e` ``:");
}

test "a reproduction too large for a comment is named, not cut" {
    let f = Finding {
        file: "a",
        summary: "S",
        detail: "D",
        repro: Some(Repro {
            patch: "+x\n".repeat(30_000),
            run: ["cargo", "test"],
            expect: "e",
            verified: true,
            output: "e",
        }),
    };
    let text = comment(&f, &"0123456789", &"i");
    assert text.len() < BODY_LIMIT && text.contains("too large for a comment") && !text.contains("git apply");

    let wordy = Finding {
        file: "a",
        summary: "S".repeat(40_000),
        detail: "é".repeat(40_000),
    };
    let cut = comment(&wordy, &"0123456789", &"i");
    assert cut.len() < BODY_LIMIT && cut.ends_with("…\n\n<!-- eddy i -->\n");
}

test "an excerpt is the lines around what was expected" {
    let mut output = "";
    for let i of 0..<100 {
        output.push_str(`line ${i}\n`);
    }
    let shown = excerpt(&output, &"line 50\n");
    assert shown.starts_with("…\nline 38\n") && shown.ends_with("line 62\n…\n");
    assert excerpt(&output, &"absent").ends_with("line 99\n")
        && excerpt(&output, &"absent").starts_with("…\nline 87\n");
    assert excerpt(&"one\n", &"one") == "one\n";
}

test "a review's comment tables the findings above each one's comment" {
    let findings: List<Finding> = [
        Finding { file: "src/a.rs", line: 7, summary: "a | b\nc", detail: "D" },
        Finding {
            file: "src/b.rs",
            summary: "S",
            detail: "D",
            repro: Some(Repro {
                patch: "p\n",
                run: ["cargo", "test"],
                expect: "e",
                verified: true,
                output: "e\n",
            }),
        },
    ];
    let text = review_comment(&findings, &"0123456789abcdef", &"cost: $0.6000 (m $0.6000)", &null);
    assert text.starts_with("## Eddy\n\nReviewed `012345678`. 2 findings; cost: $0.6000 (m $0.6000)\n\n");
    assert text.contains(
        "| # | Where | Finding | Reproduced |\n| - | - | - | - |\n| 1 | ` src/a.rs:7 ` | a \\| b c | no |\n| 2 | ` src/b.rs ` | S | yes |\n",
    );
    assert text.contains("<details><summary>1. a \\| b c</summary>\n\n**a | b\nc** — not reproduced");
    assert text.contains("<!-- eddy 012345678-2 -->\n");
}

test "a review's comment with nothing found, or nothing finished, says so" {
    let none = review_comment(&[], &"0123456789", &"cost: $0.1000 (m $0.1000)", &null);
    assert none == "## Eddy\n\nReviewed `012345678`. No findings; cost: $0.1000 (m $0.1000)\n";
    let failed = review_comment(&[], &"0123456789", &"cost: $0.1000 (m $0.1000)", &Some("the API refused"));
    assert failed == "## Eddy\n\nThe review of `012345678` failed: the API refused\n\ncost: $0.1000 (m $0.1000)\n";
}

test "a review's comment stops listing details at GitHub's limit" {
    let findings: List<Finding> = [
        Finding { file: "a", summary: "S", detail: "é".repeat(15_000) },
        Finding { file: "a", summary: "S", detail: "é".repeat(15_000) },
    ];
    let text = review_comment(&findings, &"0123456789", &"cost: $0", &null);
    assert text.len() <= BODY_LIMIT && text.contains("<!-- eddy 012345678-1 -->");
    assert !text.contains("<!-- eddy 012345678-2 -->") && text.ends_with("Finding 2 on is in the run's artifact.\n");
}

test "a shell word is quoted where the shell would read it otherwise" {
    assert shell_word(&"--test=a/b.rs") == "--test=a/b.rs";
    assert shell_word(&"a b") == "'a b'" && shell_word(&"") == "''" && shell_word(&"it's") == "'it'\\''s'";
}
