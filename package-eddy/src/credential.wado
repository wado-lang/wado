//! What a Claude API request authenticates with: an API key, or a short-lived
//! token minted under Workload Identity Federation, where a workload proves
//! who it is with an identity token from GitHub Actions, so no API key is
//! stored.

use { Method } from "wasi:http";
use { Client } from "wasi:http";
use { Duration, Mark, MonotonicClock } from "wasi:clocks";
use { env, Environment } from "core:cli";
use base64 from "core:base64";
use { to_bytes, from_bytes, to_string } from "core:json";
use { Url } from "core:url";
use { fetch } from "./http.wado";

/// An API key, or a token minted under a federation and renewed before it
/// expires.
pub struct Credential {
    key: String,
    federation: Option<Federation>,
    /// The `MonotonicClock` marks the key is renewed at, and expires at.
    renew_at: Mark,
    expires_at: Mark,
}

/// A minted token is renewed after half its life, and at least every ten
/// minutes.
fn renewal_delay(lifetime: i64) -> Mark {
    return (i64::min(lifetime / 2, 600) * 1_000_000_000) as u64 as Mark;
}

test "a token is renewed after half its life, and at least every ten minutes" {
    assert renewal_delay(1_440) == 600_000_000_000;
    assert renewal_delay(300) == 150_000_000_000;
}

impl Credential {
    /// A token minted under the federation `ANTHROPIC_FEDERATION_RULE_ID`
    /// names, or else `CLAUDE_API_KEY`; an empty one is unset.
    pub fn from_env() -> Result<Credential, String> with (Environment, Client, MonotonicClock) {
        if let Some(federation) = Federation::from_env()? {
            let mut credential = Credential { key: "", federation: Some(federation), renew_at: 0, expires_at: 0 };
            credential.renew()?;
            return Ok(credential);
        }
        return match env("CLAUDE_API_KEY") {
            Some(key) && !key.is_empty() => Ok(Credential {
                key,
                federation: null,
                renew_at: u64::MAX as Mark,
                expires_at: u64::MAX as Mark,
            }),
            _ => Err("neither ANTHROPIC_FEDERATION_RULE_ID nor CLAUDE_API_KEY is set"),
        };
    }

    /// The key to send, renewed first when it is due. A renewal that fails
    /// is tried again at the next request while the key still lives.
    internal fn key(&mut self) -> Result<String, String> with (Client, MonotonicClock) {
        let now = MonotonicClock::now();
        if now >= self.renew_at && let Err(e) = self.renew() && now >= self.expires_at {
            return Err(e);
        }
        return Ok(self.key);
    }

    /// Mints the next key; false for a key that cannot be renewed.
    internal fn renew(&mut self) -> Result<bool, String> with (Client, MonotonicClock) {
        let Some(federation) = &self.federation else {
            return Ok(false);
        };
        let minted = federation.mint()?;
        let now = MonotonicClock::now();
        self.key = minted.token;
        self.renew_at = now + renewal_delay(minted.lifetime);
        self.expires_at = now + (minted.lifetime * 1_000_000_000) as u64 as Mark;
        return Ok(true);
    }
}

test "a token that fails to renew is sent until it expires" {
    // Nothing listens on the discard port, so every mint fails at once.
    let refused = Federation {
        rule_id: "fdrl",
        organization_id: "org",
        service_account_id: "svac",
        workspace_id: "wrkspc",
        request_url: Url::from_str("https://127.0.0.1:9/token?api-version=2.0").unwrap(),
        request_token: "request",
    };
    let mut credential = Credential {
        key: "minted",
        federation: Some(refused),
        renew_at: 0,
        expires_at: u64::MAX as Mark,
    };
    assert credential.key() == Ok("minted");
    credential.expires_at = 0;
    assert credential.key() matches { Err(_) };
}

/// A federation rule and the service account it mints for, named in the
/// environment as the Anthropic SDKs name them, and the means to request an
/// identity token, which GitHub Actions gives a job granted `id-token: write`.
struct Federation {
    rule_id: String,
    organization_id: String,
    service_account_id: String,
    workspace_id: String,
    request_url: Url,
    request_token: String,
}

/// An access token, and how many seconds it lives from when it was minted.
struct Minted {
    token: String,
    lifetime: i64,
}

/// What the exchange takes.
struct Exchange {
    grant_type: String,
    assertion: String,
    federation_rule_id: String,
    organization_id: String,
    service_account_id: String,
    workspace_id: String,
}

/// What the exchange answers.
struct Exchanged {
    access_token: Option<String> = null,
    expires_in: Option<f64> = null,
}

/// The fields of an OAuth error answer (RFC 6749 §5.2), the only ones of a
/// refusal that are shown: no field of the exchange's answer is trusted to
/// hold no credential.
struct Refusal {
    error: String = "",
    error_description: String = "",
}

/// What a refusal of the exchange says, read from `body`.
fn refusal(status: i32, body: ByteList) -> String {
    return match from_bytes::<Refusal, ByteList>(body) {
        Ok(r) => `${status} ${r.error}: ${r.error_description}`,
        Err(_) => `${status} with an answer that is no OAuth error`,
    };
}

test "a refusal shows only the OAuth error fields" {
    let body = `{"error":"invalid_grant","error_description":"Authentication failed","access_token":"leaked"}`;
    assert refusal(401, body.bytes().collect()) == "401 invalid_grant: Authentication failed";
    assert refusal(502, "access_token=leaked".bytes().collect()) == "502 with an answer that is no OAuth error";
}

struct IdentityToken {
    value: String,
}

/// The claims a federation rule matches on, none of them secret: the exchange
/// answers a mismatch with no more than "Authentication failed".
struct Claims {
    iss: Option<String> = null,
    aud: Option<String> = null,
    sub: Option<String> = null,
    ref: Option<String> = null,
    event_name: Option<String> = null,
    repository_owner_id: Option<String> = null,
    repository_id: Option<String> = null,
    job_workflow_ref: Option<String> = null,
}

/// The audience the Claude API accepts an identity token for.
global AUDIENCE: String = "https%3A%2F%2Fapi.anthropic.com";

/// A token too short-lived to finish one request is refused as no token.
global SHORTEST_LIFETIME: i64 = 120;

/// Each wait of a mint's transfers, so one that stalls fails while the key it
/// would renew still lives, and the next request tries again.
global MINT_TIMEOUT: Duration = 15_000_000_000;

impl Federation {
    /// The federation `ANTHROPIC_FEDERATION_RULE_ID` names, or none when it is
    /// unset or empty.
    fn from_env() -> Result<Option<Federation>, String> with Environment {
        let rule_id = match env("ANTHROPIC_FEDERATION_RULE_ID") {
            Some(id) && !id.is_empty() => id,
            _ => {
                return Ok(null);
            },
        };
        let request_url = required("ACTIONS_ID_TOKEN_REQUEST_URL")?;
        return Ok(Some(Federation {
            rule_id,
            organization_id: required("ANTHROPIC_ORGANIZATION_ID")?,
            service_account_id: required("ANTHROPIC_SERVICE_ACCOUNT_ID")?,
            workspace_id: required("ANTHROPIC_WORKSPACE_ID")?,
            request_url: Url::from_str(&request_url).map_err(|e| `ACTIONS_ID_TOKEN_REQUEST_URL: ${e}`)?,
            request_token: required("ACTIONS_ID_TOKEN_REQUEST_TOKEN")?,
        }));
    }

    /// A fresh access token, traded for a fresh identity token.
    fn mint(&self) -> Result<Minted, String> with Client {
        let identity = self.identity_token()?;
        let exchange = Exchange {
            grant_type: "urn:ietf:params:oauth:grant-type:jwt-bearer",
            assertion: identity,
            federation_rule_id: self.rule_id,
            organization_id: self.organization_id,
            service_account_id: self.service_account_id,
            workspace_id: self.workspace_id,
        };
        let [status, body] = fetch(Method::Post, "api.anthropic.com", "/v1/oauth/token", [
            ["content-type", "application/json"],
        ], to_bytes(&exchange).unwrap(), Some(MINT_TIMEOUT))?;
        if status != 200 {
            return Err(`the token exchange answered ${refusal(status, body)}; the identity token claims ${claims(
                &identity,
            )}`);
        }
        let Ok(Exchanged { access_token: Some(token), expires_in: Some(lifetime) }) = from_bytes::<Exchanged, ByteList>(
            body,
        ) else {
            return Err("the token exchange answered 200 without a token and its lifetime");
        };
        if (lifetime as i64) < SHORTEST_LIFETIME {
            return Err(`the token exchange minted a token that lives ${lifetime}s`);
        }
        return Ok(Minted { token, lifetime: lifetime as i64 });
    }

    fn identity_token(&self) -> Result<String, String> with Client {
        let url = &self.request_url;
        let separator = if url.query matches { Some(_) } { "&" } else { "?" };
        let [status, body] = fetch(
            Method::Get,
            url.authority(),
            `${url.path_with_query()}${separator}audience=${AUDIENCE}`,
            [
                ["authorization", `bearer ${self.request_token}`],
            ],
            "",
            Some(MINT_TIMEOUT),
        )?;
        if status != 200 {
            return Err(`GitHub Actions answered ${status} for an identity token`);
        }
        return match from_bytes::<IdentityToken, ByteList>(body) {
            Ok(t) => Ok(t.value),
            Err(e) => Err(`GitHub Actions answered no identity token: ${e:?}`),
        };
    }
}

fn required(name: String) -> Result<String, String> with Environment {
    return match env(name) {
        Some(value) && !value.is_empty() => Ok(value),
        _ => Err(`ANTHROPIC_FEDERATION_RULE_ID is set, but ${name} is not`),
    };
}

/// The claims of `jwt` a federation rule matches on, as JSON.
fn claims(jwt: &String) -> String {
    let parts = jwt.split(".").collect();
    if parts.len() == 3
        && let Some(payload) = base64::decode(&parts[1])
        && let Ok(c) = from_bytes::<Claims, ByteList>(payload) {
        return to_string(&c).unwrap();
    }
    return "nothing readable";
}

test "an identity token shows only the claims a rule matches on" {
    let payload = base64::encode_url(
        &`{"sub":"repo:o/r:ref:refs/heads/main","ref":"refs/heads/main","jti":"secret-ish"}`,
    );
    let shown = claims(&`header.${payload}.signature`);
    assert shown.contains("\"sub\":\"repo:o/r:ref:refs/heads/main\"");
    assert !shown.contains("jti");
    assert claims(&"not a jwt") == "nothing readable";
}
