//! The parts of a tree a review reads: each definition a change touched,
//! whole, with the lines the change added and removed marked in it, and the
//! definitions it calls in the same file. A reviewer reads a definition's
//! logic as it stands, so it finds a defect the change brought in and one it
//! left in place alike, where a diff shows only what moved.
//!
//! Definitions are found by layout, which `rustfmt` and `wado format` fix: a
//! header line starts an item, together with the comments and attributes
//! right above it, and the brackets after it end it, at the `}` that closes
//! its body or a `;` outside every bracket. A scan of the strings and comments
//! keeps the text in them from reading as code.

use { HashMap } from "core:collections";
use { diff_lines, DiffLine } from "./diff.wado";

/// The most lines one unit shows; a longer definition shows the window of its
/// changed lines.
global MAX_UNIT_LINES: i32 = 400;

/// The lines a window shows on each side of a changed line.
global WINDOW: i32 = 30;

/// The most bytes of called definitions one unit shows.
global CALLED_BYTES: i32 = 24_000;

/// The most bytes of one unit: a search reads no more at once. Its lines come
/// first, then what it calls as far as it fits.
pub global MAX_UNIT_BYTES: i32 = 30_000;

/// What a change did to one file, by the line numbers of the file it leaves,
/// from 1: the lines it added, and the lines it removed just before each line.
struct Touched {
    added: List<i32>,
    removed: HashMap<i32, List<String>>,
    /// Whether the change deleted the file, which it leaves empty.
    deleted: bool = false,
}

impl Touched {
    fn touches(&self, line: i32) -> bool {
        return self.added.contains(&line) || self.removed.contains_key(line);
    }
}

/// An item in a source file, by its lines from 1.
struct Item {
    name: String,
    start: i32,
    end: i32,
    is_fn: bool,
    /// A test, or a module of them: the lines it holds are test code.
    is_test: bool = false,
}

/// One part of a file to review.
pub struct Unit {
    pub file: String,
    /// The definition, as `fn name` or `struct Name`, or empty for a window
    /// outside any.
    pub name: String,
    pub start: i32,
    pub end: i32,
    /// How many of its lines the change added, or removed lines before.
    pub changed: i32,
    /// The lines, numbered, those the change added marked `+` and those it
    /// removed shown unnumbered as `-`, then the definitions it calls.
    pub text: String,
    /// Whether a test or a module of tests holds it.
    pub in_test: bool = false,
}

impl Unit {
    /// Whether the unit is a test, which a review reads after the code.
    pub fn is_test(&self) -> bool {
        return self.in_test
            || self.file.starts_with("tests/")
            || self.file.contains("/tests/")
            || self.file.ends_with("_test.wado")
            || self.file.ends_with("_test.rs");
    }
}

/// The units of `diff`'s files, the definitions it touched in `sources` (each
/// file's text as the change leaves it, by path): the code before the tests,
/// and the most changed first in each.
pub fn units(diff: &String, sources: &HashMap<String, String>) -> List<Unit> {
    let mut out: List<Unit> = [];
    for let [file, touched] of touched_files(diff).entries() {
        if !touched.deleted && !sources.contains_key(*file) {
            continue;
        }
        let source = sources.get(*file).unwrap_or("");
        let lines: List<String> = source.lines().map(|l| l.to_string()).collect();
        let items = items_of(&lines, file.ends_with(".rs"));
        let mut spans: List<[i32, i32]> = [];
        // Past the last line: what the change removed at the end of the file.
        for let line of 1..=lines.len() + 1 {
            if !touched.touches(line) {
                continue;
            }
            let at = i32::min(line, lines.len());
            if line == at && lines[line - 1].trim().is_empty() && !touched.removed.contains_key(line) {
                continue;
            }
            if spans.into_iter().any(|s| s[0] <= at && at <= s[1]) {
                continue;
            }
            let [name, start, end] = span_of(&items, at, lines.len());
            spans.push([start, end]);
            let in_test = items.into_iter().any(|it| it.is_test && it.start <= at && at <= it.end);
            out.push(Unit { ..unit(file, &name, start, end, &lines, &items, touched), in_test });
        }
    }
    out.sort_by(|a, b| if a.is_test() != b.is_test() {
        a.is_test().cmp(&b.is_test());
    } else {
        b.changed.cmp(&a.changed);
    });
    return out;
}

fn unit(
    file: &String,
    name: &String,
    start: i32,
    end: i32,
    lines: &List<String>,
    items: &List<Item>,
    touched: &Touched,
) -> Unit {
    let mut text = "";
    let mut changed = 0;
    let tail = if end == lines.len() { 1 } else { 0 };
    for let n of start..=end + tail {
        if touched.touches(n) {
            changed += 1;
        }
        for let l of touched.removed.get(n).unwrap_or([]) {
            text.push_str(`       -${l}\n`);
        }
        if n <= lines.len() {
            let mark = if touched.added.contains(&n) { "+" } else { " " };
            text.push_str(`${n:>6}${mark}${lines[n - 1]}\n`);
        }
    }
    if text.len() > MAX_UNIT_BYTES {
        text = `${text.substr_bytes(0, text.floor_char_boundary(MAX_UNIT_BYTES - CUT.len()))}${CUT}`;
    }
    let heading = "\nIt calls, in this file:\n";
    let room = MAX_UNIT_BYTES - text.len() - heading.len();
    let called = called_text(lines, items, start, end, i32::min(CALLED_BYTES, room));
    if !called.is_empty() {
        text.push_str(`${heading}${called}`);
    }
    return Unit { file: *file, name: *name, start, end, changed, text };
}

/// What ends a unit's lines cut short at `MAX_UNIT_BYTES`.
global CUT: String = "\n[cut short]\n";

/// The definitions of the functions lines `start..=end` call by name, in the
/// file of `lines`, up to `budget` bytes.
fn called_text(lines: &List<String>, items: &List<Item>, start: i32, end: i32, budget: i32) -> String {
    let mut names: List<String> = [];
    for let n of start..=end {
        for let name of called_names(&lines[n - 1]) {
            if !names.contains(&name) {
                names.push(name);
            }
        }
    }
    let mut out = "";
    for let it of items {
        let outside = it.end < start || end < it.start;
        if !it.is_fn || !outside || !names.contains(&it.name.trim_prefix("fn ").to_string()) {
            continue;
        }
        let mut body = "";
        for let n of it.start..=i32::min(it.end, it.start + MAX_UNIT_LINES - 1) {
            body.push_str(`${n:>6} ${lines[n - 1]}\n`);
        }
        if out.len() + body.len() > budget {
            continue;
        }
        out.push_str(&body);
    }
    return out;
}

/// The names `line` calls: an identifier right before `(`.
fn called_names(line: &String) -> List<String> {
    let mut out: List<String> = [];
    let mut word = "";
    for let c of line.chars() {
        if c.is_ascii_alphanumeric() || c == '_' {
            word.push(c);
            continue;
        }
        if c == '(' && !word.is_empty() && !word.chars().next().unwrap().is_ascii_digit() {
            out.push(word);
        }
        word = "";
    }
    return out;
}

/// The unit that holds line `line` of a file of `count` lines: the innermost
/// function around it, or the innermost item, or a window, each held to
/// `MAX_UNIT_LINES`.
fn span_of(items: &List<Item>, line: i32, count: i32) -> [String, i32, i32] {
    let mut best: Option<Item> = null;
    for let it of items {
        if !(it.start <= line && line <= it.end) {
            continue;
        }
        let better = match &best {
            null => true,
            Some(b) => it.is_fn && !b.is_fn || it.is_fn == b.is_fn && it.start >= b.start,
        };
        if better {
            best = Some(*it);
        }
    }
    if let Some(it) = best && it.end - it.start < MAX_UNIT_LINES {
        return [it.name, it.start, it.end];
    }
    let name = match best {
        Some(it) => it.name,
        null => "",
    };
    return [
        name,
        i32::max(1, line - WINDOW),
        i32::min(count, line + WINDOW),
    ];
}

/// The items of a formatted Rust or Wado file of `lines`.
fn items_of(lines: &List<String>, nests: bool) -> List<Item> {
    let mut scan = Scan { nests };
    let mut starts_in_code: List<bool> = [];
    let mut marks: List<List<char>> = [];
    for let l of lines {
        starts_in_code.push(scan.in_code());
        marks.push(scan.marks(l));
    }
    let mut out: List<Item> = [];
    for let i of 0..<lines.len() {
        if !starts_in_code[i] {
            continue;
        }
        let Some(name) = item_name(&lines[i].trim_start().to_string()) else {
            continue;
        };
        let mut start = i;
        let mut tested = name.starts_with("test") || name == "mod tests";
        while let Some(above) = preamble_above(lines, &starts_in_code, &marks, start) {
            start = above;
            let t = lines[start].trim();
            tested = tested || t.starts_with("#[") && (t.ends_with("test]") || t == "#[cfg(test)]");
        }
        out.push(Item {
            is_fn: name.starts_with("fn ") || name.starts_with("test"),
            is_test: tested,
            name,
            start: start + 1,
            end: item_end(&marks, i) + 1,
        });
    }
    return out;
}

/// The line, from 0, that ends the item whose header is line `header`: the
/// `}` that closes a brace opened outside every bracket, or a `;` outside
/// every bracket.
fn item_end(marks: &List<List<char>>, header: i32) -> i32 {
    let mut depth = 0;
    let mut braced = false;
    for let j of header..<marks.len() {
        for let m of &marks[j] {
            if *m == ';' {
                if depth == 0 {
                    return j;
                }
            } else if *m == '(' || *m == '[' || *m == '{' {
                if depth == 0 {
                    braced = *m == '{';
                }
                depth += 1;
            } else {
                depth -= 1;
                if depth <= 0 && braced || depth < 0 {
                    return j;
                }
            }
        }
    }
    return marks.len() - 1;
}

/// Where a scan of source text stands between lines: in code, in a string
/// `close` ends, where a backslash escapes unless the string is raw, or in
/// `comments` block comments.
struct Scan {
    close: String = "",
    raw: bool = false,
    comments: i32 = 0,
    /// Whether a block comment holds others, as in Rust; in Wado one does not.
    nests: bool = false,
}

impl Scan {
    fn in_code(&self) -> bool {
        return self.close.is_empty() && self.comments == 0;
    }

    /// The brackets and semicolons of `line` that are code, read from where
    /// the lines before it left the scan; the scan moves past the line.
    fn marks(&mut self, line: &String) -> List<char> {
        let cs: List<char> = line.chars().collect();
        let mut out: List<char> = [];
        let mut i = 0;
        while i < cs.len() {
            let c = cs[i];
            if self.comments > 0 {
                if c == '*' && i + 1 < cs.len() && cs[i + 1] == '/' {
                    self.comments -= 1;
                    i += 1;
                } else if self.nests && c == '/' && i + 1 < cs.len() && cs[i + 1] == '*' {
                    self.comments += 1;
                    i += 1;
                }
            } else if !self.close.is_empty() {
                if c == '\\' && !self.raw {
                    i += 1;
                } else if closes_at(&cs, i, &self.close) {
                    i += self.close.len() - 1;
                    self.close = "";
                }
            } else if c == '/' && i + 1 < cs.len() && cs[i + 1] == '/' {
                break;
            } else if c == '/' && i + 1 < cs.len() && cs[i + 1] == '*' {
                self.comments = 1;
                i += 1;
            } else if c == '"' || c == '`' {
                let mut hashes = 0;
                while hashes < i && cs[i - 1 - hashes] == '#' {
                    hashes += 1;
                }
                let before = i - hashes;
                let r_prefix = before > 0
                    && cs[before - 1] == 'r'
                    && (before == 1 || !is_word(cs[before - 2]) || cs[before - 2] == 'b');
                self.raw = hashes > 0 || r_prefix;
                self.close = `${c}`;
                for let _ of 0..<hashes {
                    self.close.push('#');
                }
            } else if c == '\'' {
                // A char literal; a lifetime has no closing quote right after.
                if i + 1 < cs.len() && cs[i + 1] == '\\' {
                    i += 3;
                    while i < cs.len() && cs[i] != '\'' {
                        i += 1;
                    }
                } else if i + 2 < cs.len() && cs[i + 2] == '\'' {
                    i += 2;
                }
            } else if c == '(' || c == '[' || c == '{' || c == ')' || c == ']' || c == '}' || c == ';' {
                out.push(c);
            }
            i += 1;
        }
        return out;
    }
}

fn is_word(c: char) -> bool {
    return c.is_ascii_alphanumeric() || c == '_';
}

/// Whether `cs` holds `close` at `i`.
fn closes_at(cs: &List<char>, i: i32, close: &String) -> bool {
    let mut k = i;
    for let c of close.chars() {
        if k >= cs.len() || cs[k] != c {
            return false;
        }
        k += 1;
    }
    return true;
}

/// The first line, from 0, of the comment or attribute that ends right above
/// line `below`, or none. An attribute may span lines, `#[` to the `]` that
/// closes it.
fn preamble_above(lines: &List<String>, starts_in_code: &List<bool>, marks: &List<List<char>>, below: i32) -> Option<i32> {
    let mut balance = 0;
    let mut k = below - 1;
    while k >= 0 && starts_in_code[k] {
        let t = lines[k].trim_start();
        if t.starts_with("//") && k == below - 1 {
            return Some(k);
        }
        if t.trim().is_empty() || t.starts_with("//") {
            return null;
        }
        for let m of &marks[k] {
            balance += if *m == ']' { 1 } else if *m == '[' { -1 } else { 0 };
        }
        if t.starts_with("#[") && balance == 0 {
            return Some(k);
        }
        if balance <= 0 {
            return null;
        }
        k -= 1;
    }
    return null;
}

/// The kind and name of the item a line `body`, without its indent, starts,
/// as `fn name`, or none.
fn item_name(body: &String) -> Option<String> {
    let mut rest = body.as_str_slice();
    loop {
        let before = rest.len();
        for let m of ["internal ", "export ", "async ", "const ", "unsafe ", "default ", "extern \"C\" ", "affine "] {
            rest = rest.trim_prefix(m);
        }
        for let m of ["pub(", "export("] {
            if rest.starts_with(m) && let Some([_, after]) = rest.split_once(") ") {
                rest = after;
            }
        }
        rest = rest.trim_prefix("pub ");
        if rest.len() == before {
            break;
        }
    }
    if rest.starts_with("test ") || rest.starts_with("test{") {
        return Some(rest.to_string().trim_suffix("{").trim_end().to_string());
    }
    if rest.starts_with("impl ") || rest.starts_with("impl<") {
        return Some(rest.to_string().trim_suffix("{").trim_end().to_string());
    }
    for let kind of [
        "fn", "struct", "enum", "variant", "flags", "trait", "mod", "interface", "resource", "type", "global",
        "macro_rules!",
    ] {
        if let Some(after) = rest.strip_prefix(`${kind} `) {
            let mut name = "";
            for let c of after.chars() {
                if !(c.is_ascii_alphanumeric() || c == '_') {
                    break;
                }
                name.push(c);
            }
            return Some(`${kind} ${name}`);
        }
    }
    return null;
}

/// What `diff` did to each file it shows, by the path the change leaves.
fn touched_files(diff: &String) -> HashMap<String, Touched> {
    let mut out = HashMap::<String, Touched>::new();
    let [mut file, mut n] = ["", 0];
    let mut pending: List<String> = [];
    for let [l, kind] of diff_lines(diff) {
        match kind {
            _::Start => {
                removed_before(&mut out, &file, n, &mut pending);
                file = "";
            },
            _::File(path) | _::Deleted(path) => {
                file = path;
                out.try_insert(file, Touched {
                    added: [],
                    removed: HashMap::<i32, List<String>>::new(),
                    deleted: kind matches { _::Deleted(_) },
                });
            },
            _ && file.is_empty() => {
            },
            // A hunk that leaves no lines names the line before what it removed.
            _::Hunk([start, count]) => {
                removed_before(&mut out, &file, n, &mut pending);
                n = if count == 0 { start + 1 } else { start };
            },
            _::Removed => pending.push(l.substr_bytes(1, l.len())),
            _::Added | _::Context => {
                removed_before(&mut out, &file, n, &mut pending);
                if kind == DiffLine::Added {
                    out[file].added.push(n);
                }
                n += 1;
            },
            _::Other => {
            },
        }
    }
    removed_before(&mut out, &file, n, &mut pending);
    return out;
}

/// Records `pending`, the lines removed just before line `n` of `file`, and
/// empties it.
fn removed_before(out: &mut HashMap<String, Touched>, file: &String, n: i32, pending: &mut List<String>) {
    if !pending.is_empty() {
        out[*file].removed.try_insert(n, *pending);
        *pending = [];
    }
}

test "a change is read by the definitions it touched, whole, with what it added and removed marked" {
    let source = "use x;

/// Adds one.
pub fn small(a: i32) -> i32 {
    let b = helper(a);
    return b + 1;
}

fn helper(a: i32) -> i32 {
    return a;
}

impl Thing {
    pub(crate) async fn method(&self) {
        go();
    }
}

test \"t\" {
    assert small(1) == 2;
}
";
    let diff = "diff --git a/f.rs b/f.rs
--- a/f.rs
+++ b/f.rs
@@ -3,5 +3,5 @@
-/// Adds.
+/// Adds one.
 pub fn small(a: i32) -> i32 {
-    let b = a;
+    let b = helper(a);
     return b + 1;
 }
@@ -15 +15 @@
-        stop();
+        go();
@@ -20 +20 @@
-    assert small(1) == 1;
+    assert small(1) == 2;
";
    let mut sources = HashMap::<String, String>::new();
    sources["f.rs"] = source;
    let found = units(&diff, &sources);
    assert found.len() == 3;
    let small = &found[0];
    assert small.name == "fn small" && small.start == 3 && small.end == 7 && small.changed == 2;
    assert small.text.contains("       -    let b = a;\n     5+    let b = helper(a);\n");
    assert small.text.contains("It calls, in this file:\n     9 fn helper(a: i32) -> i32 {\n");
    assert found[1].name == "fn method" && found[1].start == 14 && found[1].end == 16;
    assert found[2].name == "test \"t\"" && found[2].is_test();
}

test "an item header is read past its modifiers, and a line holding a whole item ends it" {
    assert item_name(&"pub(crate) async fn go<T>(x: T) {") == Some("fn go");
    assert item_name(&"export(Command::run) fn main() with Stdout {") == Some("fn main");
    assert item_name(&"impl<T: Ord> Display for List<T> {") == Some("impl<T: Ord> Display for List<T>");
    assert item_name(&"test \"adds\" {") == Some("test \"adds\"");
    assert item_name(&"let fn_x = 1;") matches { null };
}

test "an item ends at the brace closing its body or a semicolon outside every bracket, and text in a string or comment is not code" {
    let source = "global PROMPT: String = \"Read this.
fn not_an_item() {
}
\";

struct A;

fn f(a: [u8; 4]) -> char {
    let s = r#\"}\"#; // }
    /* /* } */ } */
    return '}';
}

#[cfg(test)]
mod tests {
    #[cfg_attr(
        x,
        test
    )]
    fn checks() {}
}
";
    let lines: List<String> = source.lines().map(|l| l.to_string()).collect();
    let spans = |nests: bool| items_of(&lines, nests).into_iter().map(|it| `${it.name} ${it.start}-${it.end} ${it.is_test}`).collect();
    assert spans(true) == [
        "global PROMPT 1-4 false", "struct A 6-6 false", "fn f 8-12 false", "mod tests 14-21 true",
        "fn checks 16-20 false",
    ];
    // A comment that holds no other ends at its first `*/`, so the `}` after
    // it closes `f`.
    assert spans(false)[2] == "fn f 8-10 false";
}

test "lines removed at a hunk's end, at the file's end, and ones that read as a header are kept" {
    let diff = "diff --git a/f.rs b/f.rs
--- a/f.rs
+++ b/f.rs
@@ -1,3 +1,1 @@
 fn a() {}
--- gone
-fn b() {}
";
    let t = touched_files(&diff);
    assert t["f.rs"].removed.get(2) == Some(["-- gone", "fn b() {}"]);
    let mut sources = HashMap::<String, String>::new();
    sources["f.rs"] = "fn a() {}\n";
    let found = units(&diff, &sources);
    assert found.len() == 1 && found[0].text.contains("     1 fn a() {}\n       --- gone\n       -fn b() {}\n");
}

test "a unit is cut short where it would not fit in a search" {
    let line = "x".repeat(MAX_UNIT_BYTES);
    let mut sources = HashMap::<String, String>::new();
    sources["f.rs"] = `fn f() {\n    ${line}\n}\n`;
    let diff = "diff --git a/f.rs b/f.rs\n--- a/f.rs\n+++ b/f.rs\n@@ -2 +2 @@\n-y\n+    x\n";
    let text = units(&diff, &sources)[0].text;
    assert text.len() <= MAX_UNIT_BYTES && text.ends_with("\n[cut short]\n");
}

test "a file the change deleted is read as what it removed, and a hunk that leaves nothing removes after its line" {
    let diff = "diff --git a/gone.rs b/gone.rs
--- a/gone.rs
+++ /dev/null
@@ -1,2 +0,0 @@
-fn a() {}
-fn b() {}
diff --git a/f.rs b/f.rs
--- a/f.rs
+++ b/f.rs
@@ -2 +1,0 @@
-x
";
    let mut sources = HashMap::<String, String>::new();
    sources["f.rs"] = "kept\n";
    let found = units(&diff, &sources);
    let gone = found.into_iter().filter(|u| u.file == "gone.rs").collect();
    assert gone.len() == 1 && gone[0].text == "       -fn a() {}\n       -fn b() {}\n";
    assert touched_files(&diff)["f.rs"].removed.get(2) == Some(["x"]);
}

test "a line outside every definition, or in one too long, is read in a window" {
    let items: List<Item> = [
        Item { name: "impl X", start: 1, end: 1000, is_fn: false },
    ];
    assert span_of(&items, 500, 1000) == ["impl X", 470, 530];
    assert span_of(&[], 5, 20) == ["", 1, 20];
}
