//! Anthropic's Messages API: one text reply, or one turn of a conversation
//! that uses tools.

use { Request, Response, ErrorCode, Headers, FieldName, FieldValue, Method, Scheme, Trailers } from "wasi:http";
use { Client } from "wasi:http";
use { DescriptorFlags, Filesize, OpenFlags, PathFlags } from "wasi:filesystem";
use { env, Environment } from "core:cli";
use fs from "core:fs";
use { Preopens } from "core:fs";
use { to_bytes, from_bytes, from_string } from "core:json";
use { Serialize, Deserialize } from "core:serde";
use { Value, to_value, from_value } from "core:value";

/// What a request authenticates with: an API key, or the file a federated
/// token is kept in. Such a token expires within a review, so whoever minted
/// it writes the next one to the file, and each request reads the file again.
pub variant Credential {
    Key(String),
    /// A path whose directory is a preopen of its own, not under the first:
    /// the reviewed code reads everything there.
    File(String),
}

impl Credential {
    /// `CLAUDE_API_KEY_FILE`, or else `CLAUDE_API_KEY`; an empty one is unset.
    /// The file is named by an absolute path in plain form, since its
    /// directory is granted by that text and looked up by it.
    pub fn from_env() -> Result<Credential, String> with Environment {
        if let Some(path) = env("CLAUDE_API_KEY_FILE") && !path.is_empty() {
            if !grantable(&path) {
                return Err(`CLAUDE_API_KEY_FILE must be an absolute path in plain form, outside /: ${path}`);
            }
            return Ok(File(path));
        }
        return match env("CLAUDE_API_KEY") {
            Some(key) && !key.is_empty() => Ok(Key(key)),
            _ => Err("neither CLAUDE_API_KEY_FILE nor CLAUDE_API_KEY is set"),
        };
    }

    fn current(&self) -> Result<String, String> with Preopens {
        return match self {
            Key(key) => Ok(*key),
            File(path) => read_preopened(path),
        };
    }
}

fn grantable(path: &String) -> bool {
    return path.starts_with("/") && !path.ends_with("/") && !path.contains("//") && !path.contains("/./")
        && !path.contains("/../") && path.rfind("/") matches { Some(last) && last > 0 };
}

test "a key file is named by an absolute path in plain form, outside /" {
    assert grantable(&"/home/runner/work/_temp/claude-api-key/token");
    assert !grantable(&"token") && !grantable(&"./token") && !grantable(&"/token");
    assert !grantable(&"/a//token") && !grantable(&"/a/./token") && !grantable(&"/a/../token") && !grantable(&"/a/");
}

/// The text of the file at `path`, read in the preopen named by its directory.
fn read_preopened(path: &String) -> Result<String, String> with Preopens {
    let [Some(dir), Some(name)] = [
        fs::parent(path),
        fs::file_name(path),
    ] else {
        return Err(`${*path} names no file in a directory`);
    };
    for let [preopen, preopen_name] of Preopens::get_directories() {
        if preopen_name != dir {
            continue;
        }
        let file = match preopen.open_at(PathFlags::none(), name.to_string(), OpenFlags::none(), DescriptorFlags::Read).wait() {
            Ok(file) => file,
            Err(e) => {
                return Err(`${*path}: ${e:?}`);
            },
        };
        let [stream, transfer] = file.read_via_stream(0 as Filesize);
        let bytes = stream.read_to_end_bytes();
        stream.drop();
        if let Some(Err(e)) = transfer.read() {
            return Err(`${*path}: ${e:?}`);
        }
        return Ok(String::from_utf8_lossy(bytes).trim().to_string());
    }
    return Err(`no directory ${dir} is granted; \`wado run --dir . --dir ${dir}\` grants it`);
}

test "a file credential is read again each time" {
    fs::write("credential-test", &"one\n").unwrap();
    let mut root = "";
    for let [_, name] of Preopens::get_directories() {
        root = name;
        break;
    }
    let credential = Credential::File(fs::join(&root, "credential-test"));
    assert credential.current() == Ok("one");
    fs::write("credential-test", &"two").unwrap();
    assert credential.current() == Ok("two");
    fs::remove_file("credential-test").unwrap();
    assert Credential::File("/nowhere/token").current() == Err("no directory /nowhere is granted; `wado run --dir . --dir /nowhere` grants it");
}

pub struct Message {
    pub role: String,
    pub content: String,
}

struct MessagesRequest {
    model: String,
    max_tokens: i32,
    system: String,
    messages: List<Message>,
}

/// One block of a reply. Only the fields of the block's `type` are present.
pub struct ContentBlock {
    #[wire(name = "type")]
    pub kind: String,
    pub text: Option<String> = null,
    pub id: Option<String> = null,
    pub name: Option<String> = null,
    pub input: Value = Value::Null,
}

struct MessagesResponse {
    content: List<ContentBlock>,
    usage: Usage,
}

/// The prompt size past which some models price a whole request higher, in
/// tokens.
pub global LONG_PROMPT: i64 = 100_000;

/// The tokens one request took, as the API reports them, or the sum over
/// several. A sum over an evaluation's runs passes `i32::MAX` in cache reads.
pub struct Usage {
    pub input_tokens: i64 = 0,
    pub output_tokens: i64 = 0,
    pub cache_creation_input_tokens: i64 = 0,
    pub cache_read_input_tokens: i64 = 0,
    /// The part of a sum that requests with a prompt past `LONG_PROMPT` took.
    /// A sum alone cannot be priced without it: the price is per request.
    pub long_prompts: Option<Usage> = null,
}

impl Usage {
    /// Adds `other`, itself a sum.
    pub fn add(&mut self, other: &Usage) {
        self.input_tokens += other.input_tokens;
        self.output_tokens += other.output_tokens;
        self.cache_creation_input_tokens += other.cache_creation_input_tokens;
        self.cache_read_input_tokens += other.cache_read_input_tokens;
        if let Some(theirs) = &other.long_prompts {
            let mut long = self.long_prompts.unwrap_or(Usage {});
            long.add(theirs);
            self.long_prompts = Some(long);
        }
    }

    /// Adds `one`, the usage of one request.
    pub fn add_request(&mut self, one: &Usage) {
        assert one.long_prompts matches { None }, "the API reports one request's usage";
        let prompt = one.input_tokens + one.cache_creation_input_tokens + one.cache_read_input_tokens;
        self.add(&Usage { ..*one, long_prompts: if prompt > LONG_PROMPT { Some(*one) } else { null } });
    }
}

test "a sum keeps apart what its long prompts took" {
    let mut sum = Usage {};
    sum.add_request(&Usage { input_tokens: 10, output_tokens: 1 });
    sum.add_request(&Usage { input_tokens: 5, cache_read_input_tokens: LONG_PROMPT, output_tokens: 2 });
    assert sum.input_tokens == 15 && sum.output_tokens == 3 && sum.cache_read_input_tokens == LONG_PROMPT;
    let long = sum.long_prompts.unwrap();
    assert long.input_tokens == 5 && long.output_tokens == 2 && long.long_prompts matches { None };

    let mut both = Usage { input_tokens: 1 };
    both.add(&sum);
    both.add(&sum);
    assert both.input_tokens == 31 && both.long_prompts.unwrap().output_tokens == 4;

    let mut eval = Usage {};
    for let _ of 0..<3 {
        eval.add(&Usage { cache_read_input_tokens: i32::MAX as i64 });
    }
    assert eval.cache_read_input_tokens == 3 * i32::MAX as i64;
}

/// A tool the model may call, as the API declares one.
pub struct Tool {
    pub name: String,
    pub description: String,
    pub input_schema: Value,
}

struct Kind {
    #[wire(name = "type")]
    kind: String,
}

struct ConverseRequest {
    model: String,
    max_tokens: i32,
    system: String,
    tools: List<Tool>,
    tool_choice: Kind,
    messages: List<Value>,
    // The whole conversation is resent each turn; caching its prefix keeps
    // the diff at the head from being billed in full again.
    cache_control: Kind,
    output_config: OutputConfig,
}

struct OutputConfig {
    /// How much the model spends thinking and calling tools: `low`, `medium`,
    /// `high`, `xhigh` or `max`.
    effort: String,
}

/// One reply in a conversation. `content` is kept as the API wrote it: a
/// thinking block must go back unchanged in the next request.
pub struct Turn {
    pub content: List<Value>,
    pub stop_reason: String,
    pub usage: Usage,
}

impl Turn {
    pub fn blocks(&self) -> List<ContentBlock> {
        let mut blocks: List<ContentBlock> = [];
        for let v of &self.content {
            blocks.push(from_value::<ContentBlock>(v).unwrap());
        }
        return blocks;
    }

    pub fn text(&self) -> String {
        return text_of(&self.blocks());
    }
}

fn text_of(blocks: &List<ContentBlock>) -> String {
    let mut text = "";
    for let b of blocks {
        if let Some(t) = &b.text {
            text.push_str(t);
        }
    }
    return text;
}

/// `value` as a message in a conversation.
pub fn message<T: Serialize>(value: &T) -> Value {
    return to_value(value).unwrap();
}

/// The text of `model`'s reply to `user` under `system`, or the error the API
/// returned. What the reply took is added to `spent`.
pub fn ask(
    credential: &Credential,
    model: String,
    system: String,
    user: String,
    max_tokens: i32,
    spent: &mut Usage,
) -> Result<String, String> with (Client, Preopens) {
    let request = MessagesRequest {
        model,
        max_tokens,
        system,
        messages: [
            Message { role: "user", content: user },
        ],
    };
    let parsed = post::<MessagesResponse>(credential, to_bytes(&request).unwrap())?;
    spent.add_request(&parsed.usage);
    return Ok(text_of(&parsed.content));
}

/// `model`'s reply to `user`, read as the one JSON object it holds. What the
/// reply took is added to `spent`.
pub fn ask_json<T: Deserialize>(
    credential: &Credential,
    model: String,
    system: String,
    user: String,
    max_tokens: i32,
    spent: &mut Usage,
) -> Result<T, String> with (Client, Preopens) {
    let text = ask(credential, model, system, user, max_tokens, spent)?;
    return json_object::<T>(&text);
}

/// The one JSON object in a model's reply, from its first `{` to its last `}`.
pub fn json_object<T: Deserialize>(text: &String) -> Result<T, String> {
    if let [Some(start), Some(end)] = [
        text.find("{"),
        text.rfind("}"),
    ]
        && start < end {
        return match from_string::<T, String>(text.substr_bytes(start, end + 1)) {
            Ok(v) => Ok(v),
            Err(e) => Err(`unparsed: ${e:?}: ${*text}`),
        };
    }
    return Err(`unparsed: ${*text}`);
}

/// `model`'s next turn in `messages`. With `use_tools` false the model must
/// answer in text, though the conversation may hold earlier tool calls.
pub fn converse(
    credential: &Credential,
    model: String,
    system: String,
    tools: &List<Tool>,
    use_tools: bool,
    messages: &List<Value>,
    max_tokens: i32,
    effort: String,
) -> Result<Turn, String> with (Client, Preopens) {
    let request = ConverseRequest {
        model,
        max_tokens,
        system,
        tools: *tools,
        tool_choice: Kind { kind: if use_tools { "auto" } else { "none" } },
        messages: *messages,
        cache_control: Kind { kind: "ephemeral" },
        output_config: OutputConfig { effort },
    };
    return post::<Turn>(credential, to_bytes(&request).unwrap());
}

/// A request refused for its key is sent once more if the credential holds
/// another key by then: a federated token expires mid-review.
fn post<T: Deserialize>(credential: &Credential, request: ByteSlice) -> Result<T, String> with (Client, Preopens) {
    let mut key = credential.current()?;
    loop {
        let resp = send("api.anthropic.com", "/v1/messages", [
            ["authorization", `Bearer ${key}`],
            ["anthropic-version", "2023-06-01"],
            ["content-type", "application/json"],
        ], request)?;
        let status = resp.get_status_code() as i32;
        let body = read_body(resp)?;
        if status == 401 {
            let next = credential.current()?;
            if next != key {
                key = next;
                continue;
            }
        }
        if status != 200 {
            return Err(`HTTP ${status}: ${String::from_utf8_lossy(body)}`);
        }
        return match from_bytes::<T, ByteList>(body) {
            Ok(r) => Ok(r),
            Err(e) => Err(`unparsed response: ${e:?}`),
        };
    }
}

fn send<B: AsByteSlice>(
    authority: String,
    path: String,
    headers: List<[String, String]>,
    body: B,
) -> Result<Response, String> with Client {
    let [body_rx, body_tx] = Stream::<u8>::new();
    let [trailers_rx, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let fields = Headers::new();
    for let [name, value] of headers {
        fields.append(name as FieldName, value.bytes().collect() as FieldValue);
    }
    let [req, sent] = Request::new(fields, Option::<Stream<u8>>::Some(body_rx), trailers_rx, null);
    req.set_method(Method::Post);
    req.set_scheme(Option::<Scheme>::Some(Scheme::Https));
    req.set_authority(Option::<String>::Some(authority));
    req.set_path_with_query(Option::<String>::Some(path));

    // The host consumes the body stream once the send starts, so the writes
    // below rendezvous with it rather than deadlock.
    let subtask = Client::send(req);
    body_tx.write_raw_all(body.as_byte_slice() as Slice<u8>);
    body_tx.drop();
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
    let resp = match subtask.wait() {
        Ok(resp) => resp,
        Err(e) => {
            return Err(`HTTP request failed: ${e:?}`);
        },
    };
    done(sent, "HTTP request")?;
    return Ok(resp);
}

fn read_body(resp: Response) -> Result<ByteList, String> {
    let [res_rx, res_tx] = Future::<Result<(), ErrorCode>>::new();
    let [body_stream_rx, received] = Response::consume_body(resp, res_rx);
    let buf = body_stream_rx.read_to_end_bytes();
    body_stream_rx.drop();
    res_tx.write(Result::Ok(()));
    done(received, "HTTP response body")?;
    return Ok(buf);
}

/// Whether `transfer`, the future a `wasi:http` transfer resolves once it
/// ends, reports success.
fn done<affine T>(transfer: Future<Result<T, ErrorCode>>, what: String) -> Result<(), String> {
    let outcome = transfer.read();
    if !outcome matches { Some(Ok(_)) } {
        return Err(`${what} failed: ${outcome:?}`);
    }
    return Ok(());
}
