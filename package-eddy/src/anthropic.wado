//! Anthropic's Messages API: one text reply, or one turn of a conversation
//! that uses tools.

use { Request, Response, ErrorCode, Headers, FieldName, FieldValue, Method, Scheme, Trailers } from "wasi:http";
use { Client } from "wasi:http";
use { to_bytes, from_bytes } from "core:json";
use { Serialize, Deserialize } from "core:serde";
use { Value, to_value, from_value } from "core:value";

pub struct Message {
    pub role: String,
    pub content: String,
}

struct MessagesRequest {
    model: String,
    max_tokens: i32,
    system: String,
    messages: List<Message>,
}

/// One block of a reply. Only the fields of the block's `type` are present.
pub struct ContentBlock {
    #[wire(name = "type")]
    pub kind: String,
    pub text: Option<String> = null,
    pub id: Option<String> = null,
    pub name: Option<String> = null,
    pub input: Value = Value::Null,
}

struct MessagesResponse {
    content: List<ContentBlock>,
}

pub struct Usage {
    pub input_tokens: i32 = 0,
    pub output_tokens: i32 = 0,
    pub cache_creation_input_tokens: i32 = 0,
    pub cache_read_input_tokens: i32 = 0,
}

impl Usage {
    pub fn add(&mut self, other: &Usage) {
        self.input_tokens += other.input_tokens;
        self.output_tokens += other.output_tokens;
        self.cache_creation_input_tokens += other.cache_creation_input_tokens;
        self.cache_read_input_tokens += other.cache_read_input_tokens;
    }
}

/// A tool the model may call, as the API declares one.
pub struct Tool {
    pub name: String,
    pub description: String,
    pub input_schema: Value,
}

struct Kind {
    #[wire(name = "type")]
    kind: String,
}

struct ConverseRequest {
    model: String,
    max_tokens: i32,
    system: String,
    tools: List<Tool>,
    tool_choice: Kind,
    messages: List<Value>,
    // The whole conversation is resent each turn; caching its prefix keeps
    // the diff at the head from being billed in full again.
    cache_control: Kind,
}

/// One reply in a conversation. `content` is kept as the API wrote it: a
/// thinking block must go back unchanged in the next request.
pub struct Turn {
    pub content: List<Value>,
    pub stop_reason: String,
    pub usage: Usage,
}

impl Turn {
    pub fn blocks(&self) -> List<ContentBlock> {
        let mut blocks: List<ContentBlock> = [];
        for let v of &self.content {
            blocks.push(from_value::<ContentBlock>(v).unwrap());
        }
        return blocks;
    }

    pub fn text(&self) -> String {
        return text_of(&self.blocks());
    }
}

fn text_of(blocks: &List<ContentBlock>) -> String {
    let mut text = "";
    for let b of blocks {
        if let Some(t) = &b.text {
            text.push_str(t);
        }
    }
    return text;
}

/// `value` as a message in a conversation.
pub fn message<T: Serialize>(value: &T) -> Value {
    return to_value(value).unwrap();
}

/// The text of `model`'s reply to `user` under `system`, or the error the API
/// returned.
pub fn ask(
    api_key: String,
    model: String,
    system: String,
    user: String,
    max_tokens: i32,
) -> Result<String, String> with Client {
    let request = MessagesRequest {
        model,
        max_tokens,
        system,
        messages: [
            Message { role: "user", content: user },
        ],
    };
    let parsed = post::<MessagesResponse>(api_key, to_bytes(&request).unwrap())?;
    return Ok(text_of(&parsed.content));
}

/// `model`'s next turn in `messages`. With `use_tools` false the model must
/// answer in text, though the conversation may hold earlier tool calls.
pub fn converse(
    api_key: String,
    model: String,
    system: String,
    tools: &List<Tool>,
    use_tools: bool,
    messages: &List<Value>,
    max_tokens: i32,
) -> Result<Turn, String> with Client {
    let request = ConverseRequest {
        model,
        max_tokens,
        system,
        tools: *tools,
        tool_choice: Kind { kind: if use_tools { "auto" } else { "none" } },
        messages: *messages,
        cache_control: Kind { kind: "ephemeral" },
    };
    return post::<Turn>(api_key, to_bytes(&request).unwrap());
}

fn post<T: Deserialize>(api_key: String, request: ByteSlice) -> Result<T, String> with Client {
    let resp = send("api.anthropic.com", "/v1/messages", [
        ["x-api-key", api_key],
        ["anthropic-version", "2023-06-01"],
        ["content-type", "application/json"],
    ], request)?;
    let status = resp.get_status_code() as i32;
    let body = read_body(resp)?;
    if status != 200 {
        return Err(`HTTP ${status}: ${String::from_utf8_lossy(body)}`);
    }
    return match from_bytes::<T, ByteList>(body) {
        Ok(r) => Ok(r),
        Err(e) => Err(`unparsed response: ${e:?}`),
    };
}

fn send<B: AsByteSlice>(
    authority: String,
    path: String,
    headers: List<[String, String]>,
    body: B,
) -> Result<Response, String> with Client {
    let [body_rx, body_tx] = Stream::<u8>::new();
    let [trailers_rx, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let fields = Headers::new();
    for let [name, value] of headers {
        fields.append(name as FieldName, value.bytes().collect() as FieldValue);
    }
    let [req, sent] = Request::new(fields, Option::<Stream<u8>>::Some(body_rx), trailers_rx, null);
    req.set_method(Method::Post);
    req.set_scheme(Option::<Scheme>::Some(Scheme::Https));
    req.set_authority(Option::<String>::Some(authority));
    req.set_path_with_query(Option::<String>::Some(path));

    // The host consumes the body stream once the send starts, so the writes
    // below rendezvous with it rather than deadlock.
    let subtask = Client::send(req);
    body_tx.write_raw_all(body.as_byte_slice() as Slice<u8>);
    body_tx.drop();
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
    let resp = match subtask.wait() {
        Ok(resp) => resp,
        Err(e) => {
            return Err(`HTTP request failed: ${e:?}`);
        },
    };
    done(sent, "HTTP request")?;
    return Ok(resp);
}

fn read_body(resp: Response) -> Result<ByteList, String> {
    let [res_rx, res_tx] = Future::<Result<(), ErrorCode>>::new();
    let [body_stream_rx, received] = Response::consume_body(resp, res_rx);
    let buf = body_stream_rx.read_to_end_bytes();
    body_stream_rx.drop();
    res_tx.write(Result::Ok(()));
    done(received, "HTTP response body")?;
    return Ok(buf);
}

/// Whether `transfer`, the future a `wasi:http` transfer resolves once it
/// ends, reports success.
fn done<affine T>(transfer: Future<Result<T, ErrorCode>>, what: String) -> Result<(), String> {
    let outcome = transfer.read();
    if !outcome matches { Some(Ok(_)) } {
        return Err(`${what} failed: ${outcome:?}`);
    }
    return Ok(());
}
