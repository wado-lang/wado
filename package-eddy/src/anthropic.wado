//! Anthropic's Messages API: one text reply, or one turn of a conversation
//! that uses tools.

use { Method } from "wasi:http";
use { Client } from "wasi:http";
use { MonotonicClock } from "wasi:clocks";
use { HashMap, HashSet } from "core:collections";
use { to_bytes, from_bytes, from_string } from "core:json";
use { Serialize, SerializeError, Serializer, Deserialize } from "core:serde";
use { Value, to_value, from_value } from "core:value";
use { HttpClient } from "core:http_client";
use { JsonSchema, JsonTypes, Schema, schema_for } from "wado-lang:jade";

pub use { Credential } from "./credential.wado";

pub struct Message {
    pub role: String,
    pub content: String,
}

struct MessagesRequest {
    model: String,
    max_tokens: i32,
    system: String,
    messages: List<Message>,
    output_config: Shaped,
}

struct Shaped {
    format: Format,
}

/// The shape of a reply: the API holds the reply's text to `schema`, so the
/// text is one JSON value and nothing else. Only `Format::of` makes one, which
/// is what keeps `schema` to what the API takes.
pub struct Format {
    schema: Schema,
}

struct FormatWire {
    #[wire(name = "type")]
    kind: String = "json_schema",
    schema: Schema,
}

impl Serialize for Format {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return FormatWire { schema: self.schema }.serialize(s);
    }
}

impl Format {
    /// The JSON form of `T`. The doc comments of `T`, of the types it holds
    /// and of their fields reach the model as the schema's descriptions, so
    /// they are part of the prompt.
    pub fn of<T: JsonSchema>() -> Format {
        return Format { schema: accepted(schema_for::<T>()) };
    }
}

/// `schema` as the API takes one: every object closed to properties it does
/// not name, and no number bounded.
fn accepted(schema: Schema) -> Schema {
    return match schema {
        Bool(_) => schema,
        Object(mut s) => {
            assert s.one_of.is_empty()
                && s.prefix_items.is_empty()
                && s.additional_properties matches { null }
                && !s.unique_items, "a reply type must hold only structs, lists, options and scalars";
            if s.type & JsonTypes::Object != JsonTypes::none() {
                s.additional_properties = Some(Schema::Bool(false));
            }
            s.minimum = null;
            s.maximum = null;
            s.items = s.items.map(|item: Schema| accepted(item));
            s.any_of = s.any_of.into_iter().map(|one| accepted(one)).collect();
            s.properties = each_accepted(s.properties);
            s.defs = each_accepted(s.defs);
            Schema::Object(s);
        },
    };
}

fn each_accepted(schemas: HashMap<String, Schema>) -> HashMap<String, Schema> {
    let mut accepted_by_name = HashMap::<String, Schema>::new();
    for let [name, schema] of schemas.entries() {
        accepted_by_name[*name] = accepted(*schema);
    }
    return accepted_by_name;
}

test "a format closes every object and bounds no number, however deep" {
    struct Inner {
        n: i32,
    }

    struct Outer {
        one: Option<Inner>,
        many: List<Inner>,
    }

    let root = Format::of::<Outer>().schema.into_object();
    assert root.defs.len() == 2;
    for let [_, definition] of root.defs.entries() {
        assert definition.into_object().additional_properties matches { Some(Bool(false)) };
    }
    let n = root.defs["Inner"].into_object().properties["n"].into_object();
    assert n.type == JsonTypes::Integer && n.minimum matches { null } && n.maximum matches { null };
}

#[expect_trap]
test "a set is no reply type: the API takes no `uniqueItems`" {
    struct Tagged {
        tags: HashSet<String>,
    }

    Format::of::<Tagged>();
}

/// One block of a reply. Only the fields of the block's `type` are present.
pub struct ContentBlock {
    #[wire(name = "type")]
    pub kind: String,
    pub text: Option<String> = null,
    pub id: Option<String> = null,
    pub name: Option<String> = null,
    pub input: Value = Value::Null,
}

struct MessagesResponse {
    content: List<ContentBlock>,
    stop_reason: String,
    usage: Usage,
}

/// The prompt size past which some models price a whole request higher, in
/// tokens.
pub global LONG_PROMPT: i64 = 100_000;

/// The tokens one request took, as the API reports them, or the sum over
/// several. A sum over an evaluation's runs passes `i32::MAX` in cache reads.
pub struct Usage {
    pub input_tokens: i64 = 0,
    pub output_tokens: i64 = 0,
    pub cache_creation_input_tokens: i64 = 0,
    pub cache_read_input_tokens: i64 = 0,
    /// The part of a sum that requests with a prompt past `LONG_PROMPT` took.
    /// A sum alone cannot be priced without it: the price is per request.
    pub long_prompts: Option<Usage> = null,
}

impl Usage {
    /// Adds `other`, itself a sum.
    pub fn add(&mut self, other: &Usage) {
        self.input_tokens += other.input_tokens;
        self.output_tokens += other.output_tokens;
        self.cache_creation_input_tokens += other.cache_creation_input_tokens;
        self.cache_read_input_tokens += other.cache_read_input_tokens;
        if let Some(theirs) = &other.long_prompts {
            let mut long = self.long_prompts.unwrap_or(Usage {});
            long.add(theirs);
            self.long_prompts = Some(long);
        }
    }

    /// Adds `one`, the usage of one request.
    pub fn add_request(&mut self, one: &Usage) {
        assert one.long_prompts matches { null }, "the API reports one request's usage";
        let prompt = one.input_tokens + one.cache_creation_input_tokens + one.cache_read_input_tokens;
        self.add(&Usage { ..*one, long_prompts: if prompt > LONG_PROMPT { Some(*one) } else { null } });
    }
}

test "a sum keeps apart what its long prompts took" {
    let mut sum = Usage {};
    sum.add_request(&Usage { input_tokens: 10, output_tokens: 1 });
    sum.add_request(&Usage { input_tokens: 5, cache_read_input_tokens: LONG_PROMPT, output_tokens: 2 });
    assert sum.input_tokens == 15 && sum.output_tokens == 3 && sum.cache_read_input_tokens == LONG_PROMPT;
    let long = sum.long_prompts.unwrap();
    assert long.input_tokens == 5 && long.output_tokens == 2 && long.long_prompts matches { null };

    let mut both = Usage { input_tokens: 1 };
    both.add(&sum);
    both.add(&sum);
    assert both.input_tokens == 31 && both.long_prompts.unwrap().output_tokens == 4;

    let mut eval = Usage {};
    for let _ of 0..<3 {
        eval.add(&Usage { cache_read_input_tokens: i32::MAX as i64 });
    }
    assert eval.cache_read_input_tokens == 3 * i32::MAX as i64;
}

/// A tool the model may call, as the API declares one.
pub struct Tool {
    pub name: String,
    pub description: String,
    pub input_schema: Value,
}

struct Kind {
    #[wire(name = "type")]
    kind: String,
}

struct ConverseRequest {
    model: String,
    max_tokens: i32,
    system: String,
    tools: List<Tool>,
    tool_choice: Kind,
    messages: List<Value>,
    /// The whole conversation is resent each turn; caching its prefix keeps
    /// the diff at the head from being billed in full again.
    cache_control: Kind,
    output_config: OutputConfig,
}

struct OutputConfig {
    /// How much the model spends thinking and calling tools: `low`, `medium`,
    /// `high`, `xhigh` or `max`.
    effort: String,
    format: Format,
}

/// One reply in a conversation. `content` is kept as the API wrote it: a
/// thinking block must go back unchanged in the next request.
pub struct Turn {
    pub content: List<Value>,
    pub stop_reason: String,
    pub usage: Usage,
}

impl Turn {
    pub fn blocks(&self) -> List<ContentBlock> {
        let mut blocks: List<ContentBlock> = [];
        for let v of &self.content {
            blocks.push(from_value::<ContentBlock>(v).unwrap());
        }
        return blocks;
    }

    pub fn text(&self) -> String {
        return text_of(&self.blocks());
    }
}

fn text_of(blocks: &List<ContentBlock>) -> String {
    let mut text = "";
    for let b of blocks {
        if let Some(t) = &b.text {
            text.push_str(t);
        }
    }
    return text;
}

/// `value` as a message in a conversation.
pub fn message<T: Serialize>(value: &T) -> Value {
    return to_value(value).unwrap();
}

/// `model`'s reply to `user` under `system`, which the API holds to the JSON
/// form of `T`. What the reply took is added to `spent`.
pub fn ask_json<T: Deserialize + JsonSchema>(
    credential: &mut Credential,
    model: String,
    system: String,
    user: String,
    max_tokens: i32,
    spent: &mut Usage,
) -> Result<T, String> with (Client, MonotonicClock) {
    let request = MessagesRequest {
        model,
        max_tokens,
        system,
        messages: [
            Message { role: "user", content: user },
        ],
        output_config: Shaped { format: Format::of::<T>() },
    };
    let parsed = post::<MessagesResponse>(credential, to_bytes(&request).unwrap())?;
    spent.add_request(&parsed.usage);
    // A reply cut short or refused is not held to the format.
    if parsed.stop_reason != "end_turn" {
        return Err(`stopped on ${parsed.stop_reason}`);
    }
    return shaped::<T>(&text_of(&parsed.content));
}

/// A reply the API held to the JSON form of `T`, read as one.
pub fn shaped<T: Deserialize>(text: &String) -> Result<T, String> {
    return from_string::<T, &String>(text).map_err(|e| `unparsed: ${e:?}: ${*text}`);
}

/// `model`'s next turn in `messages`, its text held to `format`. With
/// `use_tools` false the model must answer in text, though the conversation
/// may hold earlier tool calls.
pub fn converse(
    credential: &mut Credential,
    model: String,
    system: String,
    tools: &List<Tool>,
    use_tools: bool,
    messages: &List<Value>,
    max_tokens: i32,
    effort: String,
    format: &Format,
) -> Result<Turn, String> with (Client, MonotonicClock) {
    let request = ConverseRequest {
        model,
        max_tokens,
        system,
        tools: *tools,
        tool_choice: Kind { kind: if use_tools { "auto" } else { "none" } },
        messages: *messages,
        cache_control: Kind { kind: "ephemeral" },
        // On every turn, not the last alone: the format is part of what the
        // cache keys a conversation by.
        output_config: OutputConfig { effort, format: *format },
    };
    return post::<Turn>(credential, to_bytes(&request).unwrap());
}

/// A request refused for its key is sent once more with a renewed one, where
/// the credential can renew it.
fn post<T: Deserialize>(
    credential: &mut Credential,
    request: ByteSlice,
) -> Result<T, String> with (Client, MonotonicClock) {
    let client = HttpClient::new("https://api.anthropic.com", {
        headers: { "anthropic-version": "2023-06-01", "content-type": "application/json" },
    }).unwrap();
    let mut renewed = false;
    loop {
        let mut res = client
            .request("/v1/messages", {
                method: Method::Post,
                headers: { authorization: `Bearer ${credential.key()?}` },
                body: Some(request),
            })
            .map_err(|e| `${e}`)?;
        if res.status == 401 && !renewed && credential.renew()? {
            renewed = true;
            continue;
        }
        let body = res.bytes().map_err(|e| `${e}`)?;
        if res.status != 200 {
            return Err(`HTTP ${res.status}: ${String::from_utf8_lossy(body)}`);
        }
        return match from_bytes::<T, ByteList>(body) {
            Ok(r) => Ok(r),
            Err(e) => Err(`unparsed response: ${e:?}`),
        };
    }
}
