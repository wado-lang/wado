//! One review of a change, in three steps. Reviewers each search the diff for
//! one focus, reading the tree it leaves where a workspace gives one and
//! running nothing, and report candidates. One call merges the candidates that
//! name one defect and keeps the most severe. Then, where the workspace runs
//! code, a reproducer tries each kept candidate with a test, and only one a run
//! shows is a finding. The reviewers are asked for nothing else: what a report
//! needs beyond a finding's words is drawn from it afterwards, in
//! `report.wado`.
//!
//! Reading settles nothing: a finding nobody reproduced costs whoever reads it
//! the reproduction it skipped, so a run decides each candidate, and each
//! candidate gets runs of its own rather than the leftovers of the first.

use { Preopens } from "core:fs";
use { to_string } from "core:json";
use { Process } from "core:process";
use { Deserialize } from "core:serde";
use { Client } from "wasi:http";
use { MonotonicClock } from "wasi:clocks";
use { JsonSchema } from "wado-lang:jade";
use { ask_json, shaped, Credential, Format, Usage } from "./anthropic.wado";
use { run_agent, Call, Request, Task } from "./agent.wado";
use { numbered } from "./diff.wado";
use { reset_snapshot } from "./snapshot.wado";
use { empty_index } from "./symbols.wado";
use { Runner, Workspace } from "./tools.wado";

global ROLE: String = "You review a pull request to wado-lang/wado, the toolchain of the Wado programming language: a compiler written in Rust that targets WebAssembly, its standard library and packages written in Wado (a language with Rust-like syntax), and their tooling.
Report the defects the change introduces: wrong behaviour such as a crash, a wrong result, a missed diagnostic, a hang, lost data or a security hole. Do not report style, naming or missing documentation.";

/// The most findings one answer holds, and so the most candidates a review
/// tries to reproduce.
global MAX_FINDINGS: i32 = 10;

global ANSWER: String = `Report at most ${MAX_FINDINGS} findings, the most severe first. An empty list is a valid answer.`;

global SEARCH: String = "Several reviewers search this change, each for what one focus covers, and a later step tries to reproduce what they report. Your focus follows the diff. Report every defect your focus covers that you find, one you are not sure of included, and say in its detail what would show it. Report a defect outside your focus only if it is severe. You run nothing.";

global TRIAGE: String = "Reviewers searched this change, each for one focus, reading without running anything, and reported the CANDIDATES below. Two may name the same defect, and some are wrong.
Merge the candidates that name one defect into one, worded as the clearest of them and holding what each adds. Do not judge whether a candidate is right: a later step tries each with a test, and only one a run shows is reported. Leave out only a candidate that names no wrong behaviour, such as one on style, naming or documentation.";

global REPRODUCE: String = "A reviewer reported the CANDIDATE after the diff from reading the change, without running anything. Settle it with a run: write a test that asserts the right behaviour, so that it fails now and would pass once the defect is fixed, and run it. Reading settles nothing either way: a candidate the code seems to make certain is still one to run, and so is one it seems to refute.
A defect that depends on timing, such as a race with another process, is reproduced by making the interleaving happen in the test, for example by deleting a file between the two steps the race separates, never by running it again in the hope of hitting it.
Answer reproduced true only when a run failed showing the defect, and give the defect as that run showed it. Answer false when a run passed where the candidate says it fails, or when no run showed the defect.";

global READING: String = "You can read the repository as it stood once this pull request merged, with the tools Read, Grep and Glob. Before you answer, read what the diff alone does not show: the callers of what changed, the definitions it relies on, the rest of a file. Write your answer only once you have finished with the tools.";

global SYMBOL_READING: String = "FindSymbol and FindReferences answer from the compiler's index of the Rust and Wado code: use them to find a definition and the uses of a function, type or field, and Grep for other text.";

global RUNNING: String = "You can also run the code: Write a test or a small program into the tree, and build and run it with Run, which runs cargo and the other programs it names.";

/// The Runs one reproducer has; it also gets one turn more per run.
global RUNS_PER_FINDING: i32 = 3;

/// What one searching reviewer looks for. The foci part the defects a change
/// can introduce so that reviewers of one change overlap little.
struct Focus {
    name: String,
    covers: String,
}

global FOCI: List<Focus> = [
    Focus {
        name: "code",
        covers: "the changed code itself: each branch, boundary and error path of what was added or rewritten, conversions, sizes and indices, and the result it gives on the inputs its own tests do not try",
    },
    Focus {
        name: "callers",
        covers: "what the change breaks elsewhere: each caller of a function, type or field it changed, each invariant or contract it moved, and what must agree with it by text, such as a generated file, its generator, a spec example or a test's expectation",
    },
    Focus {
        name: "state",
        covers: "state and time: what is cached, shared or kept between calls and goes stale, the order things happen in, a resource left open or released twice, processes and files, hangs, and input from outside the program that it trusts",
    },
    Focus {
        name: "users",
        covers: "the toolchain as its users see it: a Wado program the compiler now accepts that it should reject or rejects that it should accept, code it generates wrong, a diagnostic missed or misplaced, and a command or option that now behaves otherwise than its documentation says",
    },
];

/// How many reviewers search a change at most: one per focus.
pub global MAX_REVIEWERS: i32 = FOCI.len();

pub struct Finding {
    pub file: String,
    pub summary: String,
    pub detail: String,
    /// A line of `file` as the change leaves it that the diff shows, which is
    /// where a pull request takes a comment on a line, or 0 where none was
    /// placed.
    pub line: i32 = 0,
    /// Absent where no test of the reviewer's was found to reproduce it.
    pub repro: Option<Repro> = null,
}

impl Finding {
    /// The finding in its reviewer's words alone.
    internal fn told(&self) -> Told {
        return Told { file: self.file, summary: self.summary, detail: self.detail };
    }
}

/// What shows a finding: `git apply` the patch to the reviewed commit and run
/// the command `run`, a program Run runs and its arguments, and it fails
/// printing `expect`.
pub struct Repro {
    pub patch: String,
    pub run: List<String>,
    pub expect: String,
    /// Whether it did so here, tried alone in a clean tree after the review.
    pub verified: bool,
    /// What that run reported, or why there was none.
    pub output: String,
}

/// What one step of a review reported and what it took. A whole review is
/// its triage, with the searches before it and the reproductions after; a
/// record written before the steps split holds one reviewer. A step that
/// failed keeps what it spent before the error.
pub struct Reviewed {
    pub findings: List<Finding> = [],
    pub turns: i32 = 0,
    pub calls: List<Call> = [],
    pub usage: Option<Usage> = null,
    /// Each request of an agent's review, in order.
    pub requests: List<Request> = [],
    pub error: Option<String> = null,
    /// The focus of a search; empty elsewhere.
    pub focus: String = "",
    /// The searches whose candidates the triage read.
    pub searches: List<Reviewed> = [],
    /// What the triage kept, or the one candidate a reproduction tried.
    pub candidates: List<Finding> = [],
    /// One per candidate kept, where the workspace runs code. Its findings
    /// are the candidate as a run showed it, or none.
    pub reproductions: List<Reviewed> = [],
}

impl Reviewed {
    /// What this step and the steps it holds took.
    pub fn spent(&self) -> Usage {
        let mut total = self.usage.unwrap_or(Usage {});
        for let s of self.steps() {
            total.add(&s.spent());
        }
        return total;
    }

    pub fn total_turns(&self) -> i32 {
        let mut total = self.turns;
        for let s of self.steps() {
            total += s.total_turns();
        }
        return total;
    }

    fn steps(&self) -> List<&Reviewed> {
        let mut steps: List<&Reviewed> = [];
        for let s of &self.searches {
            steps.push(s);
        }
        for let r of &self.reproductions {
            steps.push(r);
        }
        return steps;
    }
}

/// What a reviewer says of one defect.
internal struct Told {
    /// The path of the file the defect is in.
    internal file: String,
    /// The defect, in one sentence.
    internal summary: String,
    /// Why it is wrong, and when it goes wrong.
    internal detail: String,
}

impl Told {
    fn finding(&self) -> Finding {
        return Finding { file: self.file, summary: self.summary, detail: self.detail };
    }
}

/// What a step answers, as the findings it reports.
trait Answered with () {
    fn findings(&self) -> List<Finding>;
}

struct Answer {
    findings: List<Told>,
}

impl Answered for Answer {
    fn findings(&self) -> List<Finding> {
        return self.findings.into_iter().map(|t| t.finding()).collect();
    }
}

/// What a reproducer answers of the candidate it tried.
struct Verdict {
    /// Whether a run failed showing the defect.
    reproduced: bool,
    /// The defect as the run showed it, which may be worded otherwise than the
    /// candidate.
    defect: Told,
}

impl Answered for Verdict {
    fn findings(&self) -> List<Finding> {
        return if self.reproduced { [self.defect.finding()] } else { [] };
    }
}

/// The change a reviewer is asked about: what it is, in `heading`, and its
/// diff.
pub struct Submission {
    pub heading: String,
    pub diff: String,
}

impl Submission {
    fn task(&self) -> String {
        return `${self.heading}

<diff>
${self.diff}
</diff>`;
    }

    /// What a search for `focus` is asked: the change, which every search
    /// shares, and then its focus.
    fn searched_for(&self, focus: &Focus) -> Task {
        return Task { shared: self.task(), own: `Your focus is ${focus.covers}.` };
    }

    /// What the triage is asked: what the change is and the candidates, in
    /// their reviewers' words. The diff is left out, since it judges nothing.
    fn triaged_from(&self, candidates: &List<Finding>) -> String {
        return `${self.heading}

${candidates_shown("candidates", candidates)}`;
    }

    /// What a reproducer of `candidate` is asked: the diff of its file, with
    /// its lines numbered, or the whole diff where its file is not in it, and
    /// then the candidate. Reproducers of one file share the diff in the
    /// cache.
    fn reproduced_from(&self, candidate: &Finding) -> Task {
        let shown = numbered(&self.diff, &[candidate.file]);
        let diff = if shown.is_empty() { self.diff } else { shown };
        return Task {
            shared: `${self.heading}

<diff>
${diff}
</diff>`,
            own: candidates_shown("candidate", &[*candidate]),
        };
    }
}

fn candidates_shown(tag: String, candidates: &List<Finding>) -> String {
    let told: List<Told> = candidates.into_iter().map(|f| f.told()).collect();
    return `<${tag}>
${to_string(&told).unwrap()}
</${tag}>`;
}

/// What a reviewer with `ws` is told of each kind of tool it offers.
fn tools_told(ws: &Option<Workspace>) -> String {
    let Some(w) = ws else {
        return "";
    };
    let mut told = `\n${READING}`;
    if w.symbols matches { Some(_) } {
        told.push_str(`\n${SYMBOL_READING}`);
    }
    if w.runner matches { Some(_) } {
        told.push_str(`\n${RUNNING}`);
    }
    return told;
}

/// What every search is told. It names no focus, so that the searches share
/// it and the diff after it in the cache.
fn searching(ws: &Option<Workspace>) -> String {
    return `${ROLE}\n${SEARCH}\n${ANSWER}${tools_told(ws)}`;
}

fn reproducing(ws: &Option<Workspace>) -> String {
    return `${ROLE}\n${REPRODUCE}${tools_told(ws)}`;
}

/// `model`'s review of `change`, in the tree at `ws` checked out at `commit`:
/// `reviewers` searches, one per focus, the triage of what they found, and a
/// reproducer per candidate it keeps where `ws` runs code. Each search and
/// reproducer reads `ws` for up to `max_turns` turns at `effort`; only a
/// reproducer writes and runs. Without a workspace each search is one call.
pub fn review(
    credential: &mut Credential,
    model: String,
    change: &Submission,
    ws: &Option<Workspace>,
    commit: &String,
    reviewers: i32,
    max_turns: i32,
    effort: String,
) -> Reviewed with (Client, Preopens, Process, MonotonicClock) {
    assert 1 <= reviewers <= MAX_REVIEWERS;
    let reading: Option<Workspace> = match ws {
        Some(w) => Some(Workspace { ..*w, runner: null }),
        null => null,
    };
    let mut searches: List<Reviewed> = [];
    let mut candidates: List<Finding> = [];
    for let i of 0..<reviewers {
        let focus = &FOCI[i];
        let mut search = ask::<Answer>(
            credential,
            model,
            searching(&reading),
            &change.searched_for(focus),
            &reading,
            max_turns,
            effort,
        );
        search.focus = focus.name;
        let failed = search.error;
        candidates.extend(&search.findings);
        searches.push(search);
        if let Some(e) = failed {
            return Reviewed { searches, error: Some(`the search for ${focus.name} failed: ${e}`) };
        }
    }
    if candidates.is_empty() {
        return Reviewed { searches };
    }
    let mut triage = triaged(credential, model, change, &candidates);
    triage.searches = searches;
    triage.candidates.truncate(MAX_FINDINGS);
    let [w, runner] = match ws {
        Some(w) && w.runner matches { Some(_) } => [w, w.runner.unwrap()],
        _ => {
            triage.findings = triage.candidates;
            return triage;
        },
    };
    let reproducer: Option<Workspace> = Some(Workspace {
        ..*w,
        runner: Some(Runner { ..runner, runs: RUNS_PER_FINDING }),
    });
    for let candidate of &triage.candidates {
        reset_snapshot(&w.repo, &w.root, commit);
        let mut tried = ask::<Verdict>(
            credential,
            model,
            reproducing(&reproducer),
            &change.reproduced_from(candidate),
            &reproducer,
            max_turns + RUNS_PER_FINDING,
            effort,
        );
        tried.candidates = [*candidate];
        triage.findings.extend(&tried.findings);
        triage.reproductions.push(tried);
    }
    return triage;
}

/// The `candidates` merged and ordered by `model` in one call, kept in the
/// returned step's `candidates`.
fn triaged(
    credential: &mut Credential,
    model: String,
    change: &Submission,
    candidates: &List<Finding>,
) -> Reviewed with (Client, MonotonicClock) {
    let mut usage = Usage {};
    let system = `${ROLE}\n${TRIAGE}\n${ANSWER}`;
    return match ask_json::<Answer>(credential, model, system, change.triaged_from(candidates), 32_000, &mut usage) {
        Ok(a) => Reviewed {
            turns: 1,
            candidates: a.findings(),
            usage: Some(usage),
        },
        Err(e) => Reviewed {
            turns: 1,
            error: Some(`the triage failed: ${e}`),
            usage: Some(usage),
        },
    };
}

/// `model`'s findings on `task` as `system` asks for them, answered as a `T`:
/// in one call, or by an agent that reads `ws` for up to `max_turns` turns at
/// `effort` with every tool `ws` offers.
fn ask<T: Deserialize + JsonSchema + Answered>(
    credential: &mut Credential,
    model: String,
    system: String,
    task: &Task,
    ws: &Option<Workspace>,
    max_turns: i32,
    effort: String,
) -> Reviewed with (Client, Preopens, Process, MonotonicClock) {
    // Thinking spends from the same budget as the answer.
    let Some(w) = ws else {
        let mut usage = Usage {};
        return match ask_json::<T>(credential, model, system, task.text(), 32_000, &mut usage) {
            Ok(a) => Reviewed {
                findings: a.findings(),
                usage: Some(usage),
            },
            Err(e) => Reviewed {
                error: Some(e),
                usage: Some(usage),
            },
        };
    };
    let agent = run_agent(credential, model, system, task, w, max_turns, 32_000, effort, Format::of::<T>());
    let mut reviewed = Reviewed {
        turns: agent.turns,
        calls: agent.calls,
        usage: Some(agent.usage),
        requests: agent.requests,
    };
    match agent.answer {
        Ok(answer) => match shaped::<T>(&answer) {
            Ok(a) => reviewed.findings = a.findings(),
            Err(e) => reviewed.error = Some(e),
        },
        Err(e) => reviewed.error = Some(e),
    }
    return reviewed;
}

test "an answer is read whole, and a brace in its text is text" {
    let answer = shaped::<Answer>(
        &#"{"findings": [{"file": "a.wado", "summary": "s", "detail": "`a{13}` gives up"}]}"#,
    ).unwrap();
    assert answer.findings()[0].detail == "`a{13}` gives up";
    assert shaped::<Answer>(&"No defects. {\"findings\": []}").unwrap_err().starts_with("unparsed: ");
}

test "a reproducer's verdict is a finding only when a run showed it" {
    let defect = Told { file: "a.rs", summary: "s", detail: "d" };
    assert Verdict { reproduced: true, defect }.findings()[0].summary == "s";
    assert Verdict { reproduced: false, defect }.findings().is_empty();
}

test "a reviewer is told of the tools its workspace offers, and no others" {
    let reading = searching(&Some(Workspace { root: "src" }));
    assert reading.contains("Read, Grep and Glob");
    assert !reading.contains("FindSymbol") && !reading.contains("Write a test");
    assert !searching(&null).contains("Read, Grep and Glob");

    let runner = Runner { target_dir: "build/target", cargo_home: "", rustup_home: "", mise_data_dir: "" };
    let running = reproducing(&Some(Workspace {
        root: "src",
        symbols: Some(empty_index()),
        runner: Some(runner),
    }));
    assert running.contains("FindSymbol") && running.contains("Write a test");
}

test "a reviewer is asked for a finding's words and nothing a report adds" {
    let runner = Runner { target_dir: "build/target", cargo_home: "", rustup_home: "", mise_data_dir: "" };
    let ws: Option<Workspace> = Some(Workspace { root: "src", runner: Some(runner) });
    for let told of [
        reproducing(&ws),
        searching(&ws),
        TRIAGE,
    ] {
        assert !told.contains(#""line""#) && !told.contains(#""repro""#) && !told.contains(#""paths""#);
    }
    for let format of [
        to_string(&Format::of::<Answer>()).unwrap(),
        to_string(&Format::of::<Verdict>()).unwrap(),
    ] {
        assert format.contains(#""description":"Why it is wrong, and when it goes wrong.""#);
        assert !format.contains(#""line""#) && !format.contains(#""repro""#) && !format.contains(#""paths""#);
    }
}

test "the searches share the system prompt and the diff, and each is told its own focus after them" {
    let change = Submission { heading: "PULL REQUEST #1: t", diff: "+a" };
    for let f of &FOCI {
        let task = change.searched_for(f);
        assert task.shared == change.task() && task.own.contains(f.covers);
        assert !searching(&null).contains(f.covers);
        for let other of &FOCI {
            assert other.name == f.name || !task.own.contains(other.covers);
        }
    }
}

test "a reproducer reads its candidate's file of the diff, or all of it where the file is not in it" {
    let diff = "diff --git a/a.rs b/a.rs
--- a/a.rs
+++ b/a.rs
@@ -1 +1 @@
-x
+y
diff --git a/b.rs b/b.rs
--- a/b.rs
+++ b/b.rs
@@ -1 +1 @@
-p
+q
";
    let change = Submission { heading: "PULL REQUEST #1: t", diff };
    let in_a = change.reproduced_from(&Finding { file: "a.rs", summary: "s", detail: "d" });
    assert in_a.shared.contains("     1 +y") && !in_a.shared.contains("+q");
    assert in_a.own.starts_with("<candidate>\n[{\"file\":\"a.rs\"");
    let elsewhere = change.reproduced_from(&Finding { file: "c.rs", summary: "s", detail: "d" });
    assert elsewhere.shared == change.task();
    assert !change
        .triaged_from(&[
            Finding { file: "a.rs", summary: "s", detail: "d" },
        ])
        .contains("<diff>");
}

test "the review's cost and turns add its searches' and its reproductions'" {
    let r = Reviewed {
        turns: 2,
        usage: Some(Usage { input_tokens: 10 }),
        searches: [
            Reviewed { turns: 3, usage: Some(Usage { input_tokens: 5 }) },
            Reviewed { turns: 1 },
        ],
        reproductions: [
            Reviewed { turns: 4, usage: Some(Usage { input_tokens: 7 }) },
        ],
    };
    assert r.total_turns() == 10 && r.spent().input_tokens == 22;
}

test "a change is its heading and then its diff" {
    assert Submission { heading: "PULL REQUEST #1: t", diff: "+a" }.task() == "PULL REQUEST #1: t\n\n<diff>\n+a\n</diff>";
}
