use { from_string } from "core:json";
use { Value } from "core:value";
use scip from "./scip.proto"
    with {
        generator: { module: "lib:grog" },
    };
use { empty_index } from "./symbols.wado";
use { Workspace } from "./tools.wado";

global CRATE: String = "rust-analyzer cargo shapes 0.1.0 ";

/// `testdata/shapes.rs` as rust-analyzer indexes it: a definition carries the
/// declaration's range, legacy-packed.
fn shapes() -> scip::Index {
    let def = |line: i32, col: i32, len: i32, symbol: String, enclosing: List<i32>| scip::Occurrence {
        range: [line, col, col + len],
        symbol: `${CRATE}${symbol}`,
        symbol_roles: 1,
        enclosing_range: enclosing,
    };
    let reference = |line: i32, col: i32, len: i32, symbol: String| scip::Occurrence {
        range: [line, col, col + len],
        symbol: `${CRATE}${symbol}`,
        symbol_roles: 8,
    };
    let info = |symbol: String, name: String, kind: scip::SymbolInformationKind, signature: String, enclosing: String| scip::SymbolInformation {
        symbol: `${CRATE}${symbol}`,
        display_name: name,
        kind,
        signature_documentation: Some(scip::Signature { language: "rust", text: signature }),
        enclosing_symbol: if enclosing.is_empty() { "" } else { `${CRATE}${enclosing}` },
    };
    return scip::Index {
        documents: [
            scip::Document {
                relative_path: "testdata/shapes.rs",
                occurrences: [
                    def(0, 11, 6, "Circle#", [0, 0, 2, 1]),
                    def(1, 8, 6, "Circle#radius.", [1, 4, 1, 15]),
                    reference(4, 5, 6, "Circle#"),
                    def(5, 11, 4, "impl#[Circle]area().", [5, 4, 7, 5]),
                    reference(6, 20, 6, "Circle#radius."),
                    reference(6, 34, 6, "Circle#radius."),
                    def(10, 7, 5, "total().", [10, 0, 12, 1]),
                    reference(10, 23, 6, "Circle#"),
                    reference(11, 29, 4, "impl#[Circle]area()."),
                    scip::Occurrence {
                        range: [10, 13, 19],
                        symbol: "local 0",
                        symbol_roles: 1,
                    },
                ],
                symbols: [
                    info("Circle#", "Circle", Struct, "pub struct Circle", ""),
                    info("Circle#radius.", "radius", Field, "pub radius: f64", "Circle#"),
                    info("impl#[Circle]area().", "area", Method, "pub fn area(&self) -> f64", ""),
                    info("total().", "total", Function, "pub fn total(shapes: &[Circle]) -> f64", ""),
                    scip::SymbolInformation { symbol: "local 0", display_name: "shapes" },
                ],
            },
        ],
    };
}

fn workspace() -> Workspace {
    let mut symbols = empty_index();
    symbols.add(&shapes());
    return Workspace { root: "src", symbols: Some(symbols) };
}

fn tool_input(json: String) -> Value {
    return from_string::<Value, String>(json).unwrap();
}

test "FindSymbol gives each definition its range and signature" {
    let ws = workspace();
    let out = ws.call(&"FindSymbol", &tool_input(`{"name": "area"}`)).unwrap();
    assert out == "testdata/shapes.rs:6-8: method Circle::area\n    pub fn area(&self) -> f64\n";
    assert ws.call(&"FindSymbol", &tool_input(`{"name": "Circle::area"}`)).unwrap() == out;
    assert ws.call(&"FindSymbol", &tool_input(`{"name": "Circle.area"}`)).unwrap() == out;
    assert ws.call(&"FindSymbol", &tool_input(`{"name": "Square::area"}`)).unwrap() == "No symbols found";
    assert ws.call(&"FindSymbol", &tool_input(`{"name": "shapes"}`)).unwrap() == "No symbols found";
}

test "FindReferences names the declaration each reference sits in" {
    let ws = workspace();
    let out = ws.call(&"FindReferences", &tool_input(`{"name": "area"}`)).unwrap();
    assert out == "method Circle::area (testdata/shapes.rs:6): 1 references\ntestdata/shapes.rs:12 in total: shapes.iter().map(|c| c.area()).sum()\n";
}

test "FindReferences lists a line once" {
    let ws = workspace();
    let out = ws.call(&"FindReferences", &tool_input(`{"name": "radius"}`)).unwrap();
    assert out == "field Circle::radius (testdata/shapes.rs:2): 2 references\ntestdata/shapes.rs:7 in Circle::area: 3.14 * self.radius * self.radius\n";
}

test "FindReferences keeps the references under a path" {
    let ws = workspace();
    let refs = |path: String| ws.call(&"FindReferences", &tool_input(`{"name": "Circle", "path": "${path}"}`)).unwrap();
    assert refs("other") == "struct Circle (testdata/shapes.rs:1): 0 references\n";
    // A path is a directory, not a prefix of the name.
    assert refs("test") == "struct Circle (testdata/shapes.rs:1): 0 references\n";
    assert refs("testdata/").starts_with("struct Circle (testdata/shapes.rs:1): 2 references\n");
    assert ws.call(&"FindSymbol", &tool_input(`{"name": "Circle", "path": "test"}`)).unwrap() == "No symbols found";
}

test "FindReferences tells declarations on one line apart" {
    let occ = |col: i32, len: i32, symbol: String, roles: i32, enclosing: List<i32>| scip::Occurrence {
        range: [0, col, col + len],
        symbol: `${CRATE}${symbol}`,
        symbol_roles: roles,
        enclosing_range: enclosing,
    };
    let info = |symbol: String, name: String| scip::SymbolInformation {
        symbol: `${CRATE}${symbol}`,
        display_name: name,
        kind: Function,
    };
    // fn one() -> i32 { return 1; } fn two() -> i32 { return one(); } fn three() -> i32 { return one(); }
    let mut symbols = empty_index();
    symbols.add(&scip::Index {
        documents: [
            scip::Document {
                relative_path: "oneline.rs",
                occurrences: [
                    occ(3, 3, "one().", 1, [0, 0, 29]),
                    occ(33, 3, "two().", 1, [0, 30, 63]),
                    occ(55, 3, "one().", 8, []),
                    occ(67, 5, "three().", 1, [0, 64, 99]),
                    occ(91, 3, "one().", 8, []),
                ],
                symbols: [
                    info("one().", "one"),
                    info("two().", "two"),
                    info("three().", "three"),
                ],
            },
        ],
    });
    let ws = Workspace { root: "src", symbols: Some(symbols) };
    let out = ws.call(&"FindReferences", &tool_input(`{"name": "one"}`)).unwrap();
    assert out == "function one (oneline.rs:1): 2 references\noneline.rs:1 in two: \noneline.rs:1 in three: \n";
}

test "the symbol tools read a path and a page as the other tools do" {
    let ws = workspace();
    let all = ws.call(&"FindSymbol", &tool_input(`{"name": "area"}`)).unwrap();
    assert ws.call(&"FindSymbol", &tool_input(`{"name": "area", "path": "."}`)).unwrap() == all;
    assert ws.call(&"FindSymbol", &tool_input(`{"name": "area", "path": "../x"}`)).is_err();
    assert ws.call(&"FindSymbol", &tool_input(`{"name": "nothing", "offset": -1}`)).is_err();
}

test "the symbol tools are offered only with an index" {
    assert !Workspace { root: "src" }.tools().into_iter().any(|t| t.name == "FindSymbol");
    assert workspace().tools().into_iter().any(|t| t.name == "FindSymbol");
}

test "typed ranges take precedence over packed ranges" {
    let mut symbols = empty_index();
    symbols.add(&scip::Index {
        documents: [
            scip::Document {
                relative_path: "typed.rs",
                occurrences: [
                    scip::Occurrence {
                        range: [20, 0, 1],
                        typed_range: Some(scip::OccurrenceTypedRange::SingleLineRange(scip::SingleLineRange { line: 1, start_character: 3, end_character: 9 })),
                        symbol: `${CRATE}target().`,
                        symbol_roles: 1,
                        enclosing_range: [20, 0, 21, 0],
                        typed_enclosing_range: Some(scip::OccurrenceTypedEnclosingRange::MultiLineEnclosingRange(scip::MultiLineRange { start_line: 0, start_character: 0, end_line: 3, end_character: 1 })),
                    },
                    scip::Occurrence {
                        typed_range: Some(scip::OccurrenceTypedRange::MultiLineRange(scip::MultiLineRange { start_line: 2, start_character: 4, end_line: 2, end_character: 10 })),
                        symbol: `${CRATE}target().`,
                        symbol_roles: 8,
                    },
                    scip::Occurrence {
                        typed_range: Some(scip::OccurrenceTypedRange::MultiLineRange(scip::MultiLineRange { start_line: 5, start_character: 3, end_line: 5, end_character: 8 })),
                        symbol: `${CRATE}other().`,
                        symbol_roles: 1,
                        typed_enclosing_range: Some(scip::OccurrenceTypedEnclosingRange::SingleLineEnclosingRange(scip::SingleLineRange { line: 5, start_character: 0, end_character: 20 })),
                    },
                ],
                symbols: [
                    scip::SymbolInformation { symbol: `${CRATE}target().`, display_name: "target", kind: Function },
                    scip::SymbolInformation { symbol: `${CRATE}other().`, display_name: "other", kind: Function },
                ],
            },
        ],
    });
    let ws = Workspace { root: "src", symbols: Some(symbols) };
    assert ws.call(&"FindSymbol", &tool_input(`{"name": "target"}`)).unwrap() == "typed.rs:2-4: function target\n";
    assert ws.call(&"FindSymbol", &tool_input(`{"name": "other"}`)).unwrap() == "typed.rs:6-6: function other\n";
    assert ws.call(&"FindReferences", &tool_input(`{"name": "target"}`)).unwrap() == "function target (typed.rs:2): 1 references\ntyped.rs:3 in target: \n";
}

test "indexes merge references with definitions by symbol, not display name" {
    let mut symbols = empty_index();
    symbols.add(&scip::Index {
        documents: [
            scip::Document {
                relative_path: "uses/calls.rs",
                occurrences: [
                    scip::Occurrence { range: [0, 0, 3], symbol: `${CRATE}A#run().`, symbol_roles: 8 },
                    scip::Occurrence { range: [1, 0, 3], symbol: `${CRATE}B#run().`, symbol_roles: 8 },
                    scip::Occurrence { range: [2, 0, 3], symbol: "local 0", symbol_roles: 8 },
                ],
            },
        ],
    });
    symbols.add(&scip::Index {
        documents: [
            scip::Document {
                relative_path: "defs/items.rs",
                occurrences: [
                    scip::Occurrence { range: [0, 3, 6], symbol: `${CRATE}A#run().`, symbol_roles: 1 },
                    scip::Occurrence { range: [1, 3, 6], symbol: `${CRATE}B#run().`, symbol_roles: 1 },
                    scip::Occurrence { range: [2, 3, 6], symbol: "local 0", symbol_roles: 1 },
                ],
                symbols: [
                    scip::SymbolInformation { symbol: `${CRATE}A#run().`, display_name: "run", kind: Method },
                    scip::SymbolInformation { symbol: `${CRATE}B#run().`, display_name: "run", kind: Method },
                    scip::SymbolInformation { symbol: "local 0", display_name: "run" },
                ],
            },
        ],
    });
    let ws = Workspace { root: "src", symbols: Some(symbols) };
    assert ws.call(&"FindSymbol", &tool_input(`{"name": "run"}`)).unwrap() == "defs/items.rs:1-1: method A::run\ndefs/items.rs:2-2: method B::run\n";
    assert ws.call(&"FindSymbol", &tool_input(`{"name": "B.run", "path": "defs/items.rs"}`)).unwrap() == "defs/items.rs:2-2: method B::run\n";
    assert ws.call(&"FindSymbol", &tool_input(`{"name": "run", "path": "uses"}`)).unwrap() == "No symbols found";
    assert ws.call(&"FindReferences", &tool_input(`{"name": "A::run", "path": "uses"}`)).unwrap() == "method A::run (defs/items.rs:1): 1 references\nuses/calls.rs:1: \n";
    assert ws.call(&"FindReferences", &tool_input(`{"name": "B::run", "path": "defs"}`)).unwrap() == "method B::run (defs/items.rs:2): 0 references\n";
}

test "symbol tools validate and paginate output lines" {
    let ws = workspace();
    assert ws.call(&"FindSymbol", &tool_input(`{"name": "area", "head_limit": 1}`)).unwrap() == "testdata/shapes.rs:6-8: method Circle::area\n";
    assert ws.call(&"FindSymbol", &tool_input(`{"name": "area", "offset": 1, "head_limit": 0}`)).unwrap() == "    pub fn area(&self) -> f64\n";
    assert ws.call(&"FindSymbol", &tool_input(`{"name": "area", "offset": 2}`)).unwrap() == "";
    assert ws.call(&"FindReferences", &tool_input(`{"name": "radius", "head_limit": -1}`)).is_err();
    assert Workspace { root: "src" }.call(&"FindReferences", &tool_input(`{"name": "area"}`)).is_err();
}

test "references use the innermost enclosing declaration" {
    let mut symbols = empty_index();
    symbols.add(&scip::Index {
        documents: [
            scip::Document {
                relative_path: "nested.rs",
                occurrences: [
                    scip::Occurrence { range: [0, 3, 9], symbol: `${CRATE}target().`, symbol_roles: 1 },
                    scip::Occurrence { range: [1, 3, 8], symbol: `${CRATE}outer().`, symbol_roles: 1, enclosing_range: [1, 0, 5, 1] },
                    scip::Occurrence { range: [2, 4, 10], symbol: `${CRATE}target().`, symbol_roles: 8 },
                    scip::Occurrence { range: [3, 7, 12], symbol: `${CRATE}inner().`, symbol_roles: 1, enclosing_range: [3, 4, 35] },
                    scip::Occurrence { range: [3, 20, 26], symbol: `${CRATE}target().`, symbol_roles: 8 },
                    scip::Occurrence { range: [4, 4, 10], symbol: `${CRATE}target().`, symbol_roles: 8 },
                    scip::Occurrence { range: [6, 0, 6], symbol: `${CRATE}target().`, symbol_roles: 8 },
                ],
                symbols: [
                    scip::SymbolInformation { symbol: `${CRATE}target().`, display_name: "target", kind: Function },
                    scip::SymbolInformation { symbol: `${CRATE}outer().`, display_name: "outer", kind: Function },
                    scip::SymbolInformation { symbol: `${CRATE}inner().`, display_name: "inner", kind: Function },
                ],
            },
        ],
    });
    let ws = Workspace { root: "src", symbols: Some(symbols) };
    assert ws.call(&"FindReferences", &tool_input(`{"name": "target"}`)).unwrap() == "function target (nested.rs:1): 4 references\nnested.rs:3 in outer: \nnested.rs:4 in inner: \nnested.rs:5 in outer: \nnested.rs:7: \n";
}

test "owner metadata and definition paths disambiguate names" {
    let mut symbols = empty_index();
    symbols.add(&scip::Index {
        documents: [
            scip::Document {
                relative_path: "pkg/item.rs",
                occurrences: [
                    scip::Occurrence { range: [0, 0, 5], symbol: `${CRATE}Owner#`, symbol_roles: 1 },
                    scip::Occurrence { range: [1, 0, 3], symbol: `${CRATE}opaque().`, symbol_roles: 9 },
                ],
                symbols: [
                    scip::SymbolInformation { symbol: `${CRATE}Owner#`, display_name: "Owner", kind: Struct },
                    scip::SymbolInformation {
                        symbol: `${CRATE}opaque().`,
                        display_name: "run",
                        kind: Method,
                        enclosing_symbol: `${CRATE}Owner#`,
                        signature_documentation: Some(scip::Signature { language: "rust", text: "fn run(\n    x: i32,\n)" }),
                    },
                ],
            },
            scip::Document {
                relative_path: "pkg-extra/item.rs",
                occurrences: [
                    scip::Occurrence { range: [0, 0, 3], symbol: `${CRATE}Other#run().`, symbol_roles: 1 },
                    scip::Occurrence { range: [1, 0, 3], symbol: `${CRATE}opaque().`, symbol_roles: 8 },
                ],
                symbols: [
                    scip::SymbolInformation { symbol: `${CRATE}Other#run().`, display_name: "run", kind: Method },
                ],
            },
        ],
    });
    let ws = Workspace { root: "src", symbols: Some(symbols) };
    assert ws.call(&"FindSymbol", &tool_input(`{"name": "Owner.run", "path": "pkg"}`)).unwrap() == "pkg/item.rs:2-2: method Owner::run\n    fn run(\n        x: i32,\n    )\n";
    assert ws.call(&"FindSymbol", &tool_input(`{"name": "run", "path": "pkg"}`)).unwrap().starts_with("pkg/item.rs:2-2: method Owner::run\n");
    assert ws.call(&"FindReferences", &tool_input(`{"name": "Owner::run", "path": "pkg"}`)).unwrap() == "method Owner::run (pkg/item.rs:2): 0 references\n";
    assert ws.call(&"FindReferences", &tool_input(`{"name": "Owner::run", "path": "pkg-extra"}`)).unwrap() == "method Owner::run (pkg/item.rs:2): 1 references\npkg-extra/item.rs:2: \n";
}

test "symbol tools reject invalid inputs and page reference results" {
    let ws = workspace();
    for let name of ["FindSymbol", "FindReferences"] {
        assert ws.call(&name, &tool_input(`{}`)).is_err();
        assert ws.call(&name, &tool_input(`{"name": 12}`)).is_err();
        assert ws.call(&name, &tool_input(`{"name": "area", "path": "../outside"}`)).is_err();
        assert ws.call(&name, &tool_input(`{"name": "area", "offset": -1}`)).is_err();
    }
    assert ws.call(&"FindReferences", &tool_input(`{"name": "area", "offset": 1, "head_limit": 1}`)).unwrap() == "testdata/shapes.rs:12 in total: shapes.iter().map(|c| c.area()).sum()\n";
    assert ws.call(&"FindReferences", &tool_input(`{"name": "absent"}`)).unwrap() == "No symbols found";
}
