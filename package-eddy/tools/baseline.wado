//! Measures a review on the evaluation set: a model reviews each culprit pull
//! request's whole diff, and a grader asks whether any finding names the defect
//! the fix pull request later corrected. Each entry is reviewed `RUNS` times,
//! since one review is not repeatable.
//!
//! With `-D tools=true` the reviewer also reads the repository as it stood
//! once the culprit merged, through Read, Grep and Glob, for up to
//! `max_turns` turns. The tree is a `git worktree` under `scratchpad/`, so
//! nothing the reviewer reads postdates the merge. `-D symbols=true` adds
//! FindSymbol and FindReferences over SCIP indexes of that tree, which
//! rust-analyzer and `-D wado=<path>` (`target/debug/wado` by default) write.
//! rust-analyzer runs only with `--process-read` on `~/.cargo` and
//! `~/.rustup`. `-D run=true` adds Write and Run, which build and run the
//! tree with `cargo` into `scratchpad/eddy-target`; each run starts from the
//! tree as checked out. Run needs the tree's toolchain installed and its crates
//! fetched, since a child cannot write `~/.cargo` or `~/.rustup`.
//! `-D reviewers=<n>` (20) searches at most that many batches of the units
//! the culprit touched before the triage, as `review` does. With `run`, the
//! reporter `-D reporter=<model>` (`claude-haiku-5-5`) then reports each
//! reproduction as `main.wado` does, and the findings graded are those
//! reproduced alone; the candidates are graded too. `-D only=<fix>` reviews that entry alone, and keeps what the output
//! file holds for the others.
//!
//! Run it from the repository root. The reviewer is a build input:
//! `CLAUDE_MODEL` in the environment, or `-D CLAUDE_MODEL=...`.
//!
//! ```sh
//! CLAUDE_API_KEY=... wado run package-eddy/tools/baseline.wado -- \
//!     package-eddy/eval/szz.json package-eddy/eval/checked.json \
//!     package-eddy/eval/judged.json package-eddy/eval/baseline.json
//! ```

use { args, eprintln, Stderr, Environment } from "core:cli";
use fs from "core:fs";
use { Preopens } from "core:fs";
use { Process } from "core:process";
use { Client } from "wasi:http";
use { MonotonicClock } from "wasi:clocks";
use { to_bytes_pretty, to_string, from_string } from "core:json";
use { HashMap } from "core:collections";
use {
    changed_paths,
    source_diff,
    merge_title,
    Baseline,
    Census,
    Checked,
    Entry,
    FixResult,
    Grade,
    Judged,
    Run,
} from "./eval.wado";
use { ask_json, Credential, Usage } from "../src/anthropic.wado";
use { cost_summary } from "../src/cost.wado";
use { report_all } from "../src/report.wado";
use { review, Finding, Submission, MAX_REVIEWERS } from "../src/review.wado";
use { hold_tree, Tree, home_runner, with_mise_tools, reset_snapshot, index } from "../src/snapshot.wado";
use { Runner, Workspace } from "../src/tools.wado";
use { load, SymbolIndex } from "../src/symbols.wado";

#[param(from_env = "CLAUDE_MODEL")]
global CLAUDE_MODEL: String = "claude-opus-5-5";

#[param(name = "grader")]
global GRADER: String = "claude-opus-5-5";

/// The model that places and cuts each finding's reproduction, as `--reporter`
/// does for `main.wado`.
#[param(name = "reporter")]
global REPORTER: String = "claude-haiku-5-5";

#[param(name = "runs")]
global RUNS: i32 = 3;

#[param(name = "diff_limit")]
global LIMIT: i32 = 2_000_000;

#[param(name = "tools")]
global TOOLS: bool = false;

#[param(name = "symbols")]
global SYMBOLS: bool = false;

#[param(name = "run")]
global RUN: bool = false;

/// The one fix to review, or 0 for every usable entry.
#[param(name = "only")]
global ONLY: i32 = 0;

/// The `wado` that indexes the Wado source of each tree.
#[param(name = "wado")]
global WADO: String = "target/debug/wado";

#[param(name = "reviewers")]
global REVIEWERS: i32 = MAX_REVIEWERS;

#[param(name = "max_turns")]
global MAX_TURNS: i32 = 40;

#[param(name = "effort")]
global EFFORT: String = "medium";

global GRADE: String = "You grade a code review against one known defect.
The KNOWN DEFECT is what a later pull request had to fix in the reviewed change. The FINDINGS are what the reviewer reported on the change.
A finding is a hit when it points at the same root cause: the same code and the same wrong behaviour, even if worded differently or only partly explained. A finding about something else in the same area is not a hit.
Answer with one JSON object and nothing else:
{\"hit\": bool, \"finding\": <the index of the hit, or -1>, \"reason\": \"<one sentence>\"}";

export fn run() with (Stderr, Environment, Preopens, Process, Client, MonotonicClock) {
    let arguments = args();
    assert !SYMBOLS || TOOLS, "the symbol tools read the tree that tools=true checks out";
    assert !RUN || TOOLS, "Run builds the tree that tools=true checks out";
    assert arguments.len() == 4, "usage: baseline.wado <szz.json> <checked.json> <judged.json> <out.json>";
    let mut credential = Credential::from_env().unwrap();
    let census = from_string::<Census, String>(fs::read_to_string(&arguments[0]).unwrap()).unwrap();
    let checked = from_string::<Checked, String>(fs::read_to_string(&arguments[1]).unwrap()).unwrap();
    let judged = from_string::<Judged, String>(fs::read_to_string(&arguments[2]).unwrap()).unwrap();
    let out_path = arguments[3];
    let earlier = earlier_entries(&out_path);

    // Every entry is in `out` before any run, so the file written after each
    // run keeps the earlier runs of entries not reached yet.
    let mut out = Baseline {
        reviewer: CLAUDE_MODEL,
        grader: GRADER,
        reporter: if RUN { REPORTER } else { "" },
        tools: TOOLS,
        symbols: SYMBOLS,
        run: RUN,
        reviewers: REVIEWERS,
        max_turns: MAX_TURNS,
        effort: if TOOLS { EFFORT } else { "" },
        diff_limit: LIMIT,
        entries: [],
    };
    for let c of &checked.pairs {
        if !c.usable() {
            continue;
        }
        assert fix_result(&census, c.fix).blamed[0].pr == c.culprit, "the census must still blame the checked culprit";
        if ONLY != 0 && c.fix != ONLY && let Some(e) = earlier.get(c.fix) {
            out.entries.push(e);
            continue;
        }
        let mut entry = Entry { fix: c.fix, culprit: c.culprit, defect: judged_defect(&judged, c.fix), runs: [] };
        if let Some(e) = earlier.get(c.fix) && e.culprit == entry.culprit && e.defect == entry.defect {
            for let graded of e.runs {
                if graded.grade matches { Some(_) } && entry.runs.len() < RUNS {
                    entry.runs.push(graded);
                }
            }
        }
        out.entries.push(entry);
    }
    let tree: Option<Tree> = if TOOLS { Some(hold_tree().unwrap()) } else { null };
    let [mut reviewing, mut reporting, mut grading] = [Usage {}, Usage {}, Usage {}];
    for let i of 0..<out.entries.len() {
        if out.entries[i].runs.len() >= RUNS || ONLY != 0 && out.entries[i].fix != ONLY {
            continue;
        }
        let fix = out.entries[i].fix;
        let r = fix_result(&census, fix);
        let culprit = &r.blamed[0];
        let review_prompt = match source_diff(&culprit.sha, &changed_paths(&culprit.sha), "culprit", LIMIT) {
            Ok(diff) => Submission { heading: `PULL REQUEST #${culprit.pr}: ${merge_title(&culprit.sha)}`, diff },
            Err(e) => panic(`#${fix}: ${e}`),
        };
        let fix_diff = source_diff(&r.sha, &changed_paths(&r.sha), "fix", LIMIT).unwrap();
        let known = `KNOWN DEFECT, fixed by #${fix}: ${r.title}
${out.entries[i].defect}

<fix_diff>
${fix_diff}
</fix_diff>`;

        let ws: Option<Workspace> = if let Some(t) = &tree {
            Some(workspace(t, &culprit.sha));
        } else {
            null;
        };
        if RUN && let Some(w) = &ws {
            w.prebuild(&changed_paths(&culprit.sha));
        }
        while out.entries[i].runs.len() < RUNS {
            if RUN && let Some(w) = &ws {
                reset_snapshot(&w.repo, &w.root, &culprit.sha);
            }
            let graded = review_once(&mut credential, &review_prompt, &culprit.sha, &known, &ws, &mut grading);
            reviewing.add(&graded.review().spent());
            reporting.add(&graded.report_usage.unwrap_or(Usage {}));
            out.entries[i].runs.push(graded);
            // Written after every run, so a run that dies keeps what it paid for.
            fs::write(&out_path, &to_bytes_pretty(&out).unwrap()).unwrap();
            eprintln(`#${fix} run ${out.entries[i].runs.len()}`);
        }
    }
    fs::write(&out_path, &to_bytes_pretty(&out).unwrap()).unwrap();
    report(&out);
    // Of the runs made now; a run an earlier invocation left is not paid again.
    eprintln(cost_summary(&[
        [CLAUDE_MODEL, reviewing],
        [REPORTER, reporting],
        [GRADER, grading],
    ]));
}

/// The tree as merge `sha` left it, indexed when `symbols` is set and ready to
/// build when `run` is.
fn workspace(tree: &Tree, sha: &String) -> Workspace with (Process, Preopens, Environment) {
    // With its submodules before indexing, so the index sees the tree Run
    // builds.
    let root = tree.check_out(sha, RUN);
    let symbols: Option<SymbolIndex> = if SYMBOLS { Some(load(&index(&root, &WADO)).unwrap()) } else { null };
    let runner: Option<Runner> = if RUN { Some(with_mise_tools(home_runner(), &root)) } else { null };
    return Workspace { root, symbols, runner };
}

fn fix_result(census: &Census, fix: i32) -> FixResult {
    for let r of &census.results {
        if r.pr == fix {
            return *r;
        }
    }
    panic(`#${fix} is not in the census`);
}

/// The defect the judge named for `fix`'s pair.
fn judged_defect(judged: &Judged, fix: i32) -> String {
    for let p of &judged.pairs {
        if p.fix == fix && let Some(v) = &p.verdict {
            return v.defect;
        }
    }
    panic(`#${fix} has no verdict to name its defect`);
}

/// One review of the culprit, graded against the known defect. A failed
/// review keeps what it spent. What the grader took is added to `grading`.
fn review_once(
    credential: &mut Credential,
    review_prompt: &Submission,
    commit: &String,
    known: &String,
    ws: &Option<Workspace>,
    grading: &mut Usage,
) -> Run with (Client, Preopens, Process, MonotonicClock) {
    let mut r = review(credential, CLAUDE_MODEL, review_prompt, ws, commit, REVIEWERS, MAX_TURNS, EFFORT);
    let mut report_usage = Usage {};
    let report_error: Option<String> = match ws {
        Some(w) && r.error matches { null } => match report_all(
            credential,
            REPORTER,
            review_prompt,
            w,
            commit,
            &mut r,
            &mut report_usage,
        ) {
            Ok(_) => null,
            Err(e) => Some(e),
        },
        _ => null,
    };
    let mut reviewed = Run {
        ..Run::of(r),
        report_usage: Some(report_usage),
        report_error,
    };
    // A report that failed leaves findings unreported, which would grade as
    // a miss.
    if reviewed.error matches { null } && let Some(e) = &reviewed.report_error {
        reviewed.error = Some(`the report failed: ${*e}`);
    }
    if reviewed.error matches { Some(_) } {
        return reviewed;
    }
    match grade_of(credential, known, &reviewed.findings, grading) {
        Ok(g) => reviewed.grade = Some(g),
        Err(e) => reviewed.error = Some(e),
    }
    if !reviewed.reproductions.is_empty() {
        match grade_of(credential, known, &reviewed.candidates, grading) {
            Ok(g) => reviewed.candidate_grade = Some(g),
            Err(e) => reviewed.error = Some(e),
        }
    }
    return reviewed;
}

/// Whether one of `findings` names the `known` defect, as the grader answers.
/// What it took is added to `grading`.
fn grade_of(
    credential: &mut Credential,
    known: &String,
    findings: &List<Finding>,
    grading: &mut Usage,
) -> Result<Grade, String> with (Client, MonotonicClock) {
    let grade_prompt = `${*known}

<findings>
${to_string(findings).unwrap()}
</findings>`;
    let g = ask_json::<Grade>(credential, GRADER, GRADE, grade_prompt, 16_000, grading)?;
    if g.hit && !(0 <= g.finding < findings.len()) {
        return Err(`the grader's hit names finding ${g.finding} of ${findings.len()}`);
    }
    return Ok(g);
}

/// The entries an earlier run with these settings left at `path`, by fix. A
/// rerun only tops each entry up to `RUNS`.
fn earlier_entries(path: &String) -> HashMap<i32, Entry> with Preopens {
    let mut by_fix = HashMap::<i32, Entry>::new();
    let Ok(text) = fs::read_to_string(path) else {
        return by_fix;
    };
    let earlier = from_string::<Baseline, String>(text).unwrap();
    if earlier.reviewer != CLAUDE_MODEL
        || earlier.grader != GRADER
        || earlier.tools != TOOLS
        || earlier.symbols != SYMBOLS
        || earlier.run != RUN
        || RUN && earlier.reporter != REPORTER
        || earlier.reviewers != REVIEWERS
        || earlier.diff_limit != LIMIT
        || TOOLS && (earlier.max_turns != MAX_TURNS || earlier.effort != EFFORT) {
        assert ONLY == 0, `only= keeps the other entries of ${*path}, so it must hold runs with these settings`;
        return by_fix;
    }
    // A run that failed measured nothing, so it is made again.
    for let e of earlier.entries {
        by_fix[e.fix] = Entry { ..e, runs: e.runs.into_iter().filter(|r| r.error matches { null }).collect() };
    }
    return by_fix;
}

fn report(out: &Baseline) with Stderr {
    let [mut hits, mut graded, mut any_hit, mut findings, mut candidate_hits, mut candidates] = [0, 0, 0, 0, 0, 0];
    for let e of &out.entries {
        let mut hits_here = 0;
        for let r of &e.runs {
            if let Some(g) = &r.grade {
                graded += 1;
                findings += r.findings.len();
                candidates += r.candidates.len();
                if g.hit {
                    hits_here += 1;
                }
                if r.candidate_grade matches { Some(c) && c.hit } {
                    candidate_hits += 1;
                }
            }
        }
        hits += hits_here;
        if hits_here > 0 {
            any_hit += 1;
        }
        eprintln(`#${e.fix}: ${hits_here}/${e.runs.len()}`);
    }
    eprintln(
        `hits: ${hits}/${graded} runs; entries hit at least once: ${any_hit}/${out.entries.len()}; findings: ${findings}; candidates: ${candidates}, a hit among them in ${candidate_hits} runs`,
    );
}
