//! What the evaluation-set tools share: running `git`, the pull requests merged
//! into `main`, and the census they exchange as JSON.

use { Command, Process, ProcessError } from "core:process";
use { Deserialize } from "core:serde";
use { from_string } from "core:json";
use { Client } from "wasi:http";
use { ask } from "../src/anthropic.wado";

/// One pull request, as the merge commit that landed it on `main` records it.
pub struct Merge {
    pub sha: String,
    pub date: String,
    pub num: i32,
    pub title: String,
}

pub struct Blamed {
    pub pr: i32,
    /// The merge that landed it, empty for pull request 0.
    pub sha: String,
    pub n: i32,
    /// The names the lines had in it: blame follows a rename the fix's own
    /// paths do not.
    pub paths: List<String>,
}

/// One `fix` pull request: the pull requests that last wrote the lines it
/// changed, most lines first. Pull request 0 stands for a commit that no merge
/// brought in.
#[wire(name_policy = "camelCase")]
pub struct FixResult {
    pub pr: i32,
    pub sha: String,
    pub date: String,
    pub title: String,
    pub adds_test: bool,
    pub old_lines: i32,
    pub blamed: List<Blamed>,
}

pub struct Census {
    pub prs: i32,
    pub results: List<FixResult>,
}

/// A judge's answer on one pair.
pub struct Verdict {
    pub is_defect_fix: bool,
    pub introduced_by_culprit: bool,
    pub visible_in_diff: bool,
    pub defect: String,
    pub reason: String,
}

pub struct Pair {
    pub fix: i32,
    pub culprit: i32,
    pub share: f64,
    pub lines: i32,
    #[wire(name = "addsTest")]
    pub adds_test: bool,
    pub title: String,
    pub verdict: Option<Verdict> = null,
    pub error: Option<String> = null,
}

/// What a judge run writes.
pub struct Judged {
    pub model: String,
    pub min_share: f64,
    pub pairs: List<Pair>,
}

/// One answer in `checked.json`: `yes`, `no`, `unsure` or `na`.
pub struct CheckedPair {
    pub fix: i32,
    pub culprit: i32,
    pub defect: String,
    pub introduced: String,
    pub visible: String,
    pub ask: Option<String> = null,
    pub reason: String,
}

pub struct Checked {
    pub checker: String,
    pub scope: String,
    pub pairs: List<CheckedPair>,
}

impl CheckedPair {
    /// An entry of the evaluation set: every answer is `yes`.
    pub fn usable(&self) -> bool {
        return self.defect == "yes" && self.introduced == "yes" && self.visible == "yes";
    }
}

/// `git`'s stdout, or `null` when it exits other than 0.
pub fn try_git(args: List<String>) -> Option<String> with Process {
    return match run_git(args) {
        Ok(out) => Some(out),
        Err(_) => null,
    };
}

pub fn git(args: List<String>) -> String with Process {
    return match run_git(args) {
        Ok(out) => out,
        Err(e) => panic(`${e}`),
    };
}

fn run_git(args: List<String>) -> Result<String, ProcessError> with Process {
    // Unquoted, a non-ASCII path reads back as the name `git` takes.
    let mut full = ["-c", "core.quotePath=false"] as List<String>;
    full.extend(&args);
    return Command::new("git").args(full).capture_limit(i32::MAX).read().map(|out| String::from_utf8_lossy(out));
}

/// The paths `.gitattributes` marked generated or vendored at `rev`.
pub fn generated(rev: &String, paths: &List<String>) -> List<String> with Process {
    let mut marked: List<String> = [];
    if paths.is_empty() {
        return marked;
    }
    let mut check = ["check-attr", "--source", *rev, "linguist-generated", "linguist-vendored", "--"] as List<String>;
    check.extend(paths);
    for let line of git(check).lines() {
        if !(line.ends_with(": set") || line.ends_with(": true")) {
            continue;
        }
        if let Some(at) = line.find(": linguist-") {
            marked.push(line.slice(0, at).to_string());
        }
    }
    return marked;
}

/// A checkout of `sha` for a reviewer to read, and its directory. It is a
/// worktree, so it shares the repository's objects, later commits included:
/// only the tools' refusal to leave the tree keeps them out of reach. A
/// symbolic link is checked out as a file holding its target, so no path
/// resolves out of the tree through one. A tree an interrupted run left is
/// checked out again rather than trusted.
pub fn snapshot(sha: &String) -> String with Process {
    let root = `scratchpad/eddy-trees/${*sha}`;
    try_git(["worktree", "remove", "--force", root]);
    git(["-c", "core.symlinks=false", "worktree", "add", "--force", "--detach", root, *sha]);
    return root;
}

pub fn drop_snapshot(root: &String) with Process {
    git(["worktree", "remove", "--force", *root]);
}

/// The paths merge `sha` changed, both sides of a rename: a diff given only
/// the new path shows the renamed file as wholly added.
pub fn changed_paths(sha: &String) -> List<String> with Process {
    let mut paths: List<String> = [];
    for let f of git(["diff", "--name-only", "--no-renames", `${*sha}^1`, *sha]).lines() {
        paths.push(f.to_string());
    }
    return paths;
}

/// What merge `sha` changed in `paths`, generated, vendored and Markdown files
/// left out. A diff past `limit` bytes is an error rather than clipped: the
/// part left out may be the one that matters.
pub fn source_diff(sha: &String, paths: &List<String>, what: String, limit: i32) -> Result<String, String> with Process {
    let base = `${*sha}^1`;
    let gen = generated(&base, paths);
    let mut diff_args = ["diff", base, *sha, "--"] as List<String>;
    let mut any = false;
    for let p of paths {
        if !gen.contains_str(p) && !p.ends_with(".md") {
            diff_args.push(*p);
            any = true;
        }
    }
    // With no path, `git diff` would show the whole merge.
    let diff = if any { git(diff_args) } else { "" };
    if diff.is_empty() {
        return Err(`the ${what} diff is empty`);
    }
    if diff.len() > limit {
        return Err(`the ${what} diff is ${diff.len()} bytes, over ${limit}`);
    }
    return Ok(diff);
}

/// `model`'s reply to `user`, read as the one JSON object it holds.
pub fn ask_json<T: Deserialize>(
    api_key: &String,
    model: String,
    system: String,
    user: String,
    max_tokens: i32,
) -> Result<T, String> with Client {
    let text = ask(*api_key, model, system, user, max_tokens)?;
    return json_object::<T>(&text);
}

/// The one JSON object in a model's reply, from its first `{` to its last `}`.
pub fn json_object<T: Deserialize>(text: &String) -> Result<T, String> {
    if let [Some(start), Some(end)] = [
        text.find("{"),
        text.rfind("}"),
    ]
        && start < end {
        return match from_string::<T, String>(text.substr_bytes(start, end + 1)) {
            Ok(v) => Ok(v),
            Err(e) => Err(`unparsed: ${e:?}: ${*text}`),
        };
    }
    return Err(`unparsed: ${*text}`);
}

/// The pull requests merged into `origin/main`, oldest first. A merge's
/// subject names the number (`Merge pull request #12 from …`), and the first
/// line of its body is the pull request's title.
pub fn merged_prs() -> List<Merge> with Process {
    // A shallow clone hides the merges past its depth, and blame credits their
    // lines to the boundary commit.
    assert git(["rev-parse", "--is-shallow-repository"]).trim() == "false", "main's whole history must be here: git fetch --unshallow origin main";
    let log = git([
        "log", "--first-parent", "--merges", "--reverse", "--date=short", "--format=%H%x00%ad%x00%s%x00%b%x1e",
        "origin/main",
    ]);
    let mut merges: List<Merge> = [];
    for let record of log.split("\u{1E}") {
        let record = record.trim();
        if record.is_empty() {
            continue;
        }
        let fields: List<String> = record.split("\u{0}").map(|f| f.to_string()).collect();
        merges.push(Merge {
            sha: fields[0],
            date: fields[1],
            num: pr_number(&fields[2]),
            title: first_line(&fields[3]),
        });
    }
    return merges;
}

/// The title of the pull request `sha` merged.
pub fn merge_title(sha: &String) -> String with Process {
    return first_line(&git(["log", "-1", "--format=%b", *sha]));
}

fn first_line(body: &String) -> String {
    return match body.lines().next() {
        Some(line) => line.trim().to_string(),
        None => "",
    };
}

/// The digits after the first `#`, or 0 without one.
fn pr_number(subject: &String) -> i32 {
    let Some(hash) = subject.find("#") else {
        return 0;
    };
    let mut num = 0;
    for let c of subject.substr_bytes(hash + 1, subject.len()).chars() {
        if !c.is_ascii_digit() {
            break;
        }
        num = num * 10 + (c as i32 - '0' as i32);
    }
    return num;
}

test "a merge subject names its pull request" {
    assert pr_number(&"Merge pull request #2464 from wado-lang/x") == 2464;
    assert pr_number(&"Merge branch 'main'") == 0;
}
