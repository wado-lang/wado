//! Asks a model whether each SZZ pair is real: the fix pull request corrects a
//! defect that the culprit introduced, visible in the culprit's diff. Judges
//! each pair whose culprit wrote at least `min-share` of the blamed lines.
//!
//! Run it from the repository root. The model is a build input:
//! `CLAUDE_MODEL` in the environment, or `-D CLAUDE_MODEL=...`.
//!
//! ```sh
//! CLAUDE_API_KEY=... wado run package-eddy/tools/judge.wado -- \
//!     package-eddy/eval/szz.json 0.5 package-eddy/eval/judged.json
//! ```

use { args, env, eprintln, Stderr, Environment } from "core:cli";
use fs from "core:fs";
use { Preopens } from "core:fs";
use { Process } from "core:process";
use { Client } from "wasi:http";
use { to_bytes_pretty, from_string } from "core:json";
use { git, merged_prs, merges_by_pr, Census, FixResult } from "./eval.wado";
use { ask } from "../src/anthropic.wado";

#[param(from_env = "CLAUDE_MODEL")]
global CLAUDE_MODEL: String = "claude-opus-5-5";

/// How much of each diff the model reads, in bytes.
global LIMIT: i32 = 60_000;

global SYSTEM: String = "You audit candidate entries for a code-review evaluation set built with the SZZ method.
Each entry pairs a FIX pull request with the CULPRIT pull request that git blame says last wrote most of the lines the fix changed.
Judge from the diffs alone. Answer with one JSON object and nothing else:
{\"is_defect_fix\": bool, \"introduced_by_culprit\": bool, \"visible_in_diff\": bool, \"defect\": \"<one sentence: what was wrong>\", \"reason\": \"<one or two sentences>\"}
- is_defect_fix: the fix corrects wrong behaviour (a crash, a wrong result, a missed diagnostic, a hang), not a refactor, a feature, a rename or a doc change.
- introduced_by_culprit: the wrong behaviour the fix corrects was introduced by lines the culprit added or changed, not merely moved or reformatted there.
- visible_in_diff: a careful reviewer reading only the culprit's diff could have pointed at the defect.";

struct Verdict {
    is_defect_fix: bool,
    introduced_by_culprit: bool,
    visible_in_diff: bool,
    defect: String,
    reason: String,
}

struct Pair {
    fix: i32,
    culprit: i32,
    share: f64,
    lines: i32,
    #[wire(name = "addsTest")]
    adds_test: bool,
    title: String,
    verdict: Option<Verdict> = null,
    error: Option<String> = null,
}

struct Judged {
    model: String,
    min_share: f64,
    pairs: List<Pair>,
}

fn clip(s: String) -> String {
    if s.len() <= LIMIT {
        return s;
    }
    return `${s.substr_bytes(0, s.floor_char_boundary(LIMIT))}\n[... truncated]`;
}

/// The diffs the model reads: the whole fix, Markdown aside, and the culprit
/// restricted to the files the fix touched.
fn prompt(r: &FixResult, fix_sha: &String, culprit_sha: &String, culprit_title: &String) -> String with Process {
    let files = git(["diff", "--name-only", `${fix_sha}^1`, *fix_sha]);
    let mut fix_args = ["diff", "-w", `${fix_sha}^1`, *fix_sha, "--"] as List<String>;
    let mut culprit_args = ["diff", "-w", `${culprit_sha}^1`, *culprit_sha, "--"] as List<String>;
    for let f of files.lines() {
        let f = f.to_string();
        if !f.ends_with(".md") {
            fix_args.push(f);
        }
        culprit_args.push(f);
    }
    let fix_diff = clip(git(fix_args));
    let culprit_diff = clip(git(culprit_args));
    return `FIX PR #${r.pr}: ${r.title}

<fix_diff>
${fix_diff}
</fix_diff>

CULPRIT PR #${r.blamed[0].pr}: ${culprit_title}
(diff restricted to the files the fix touched)

<culprit_diff>
${culprit_diff}
</culprit_diff>`;
}

/// The one JSON object in `text`, from its first `{` to its last `}`.
fn verdict_of(text: &String) -> Result<Verdict, String> {
    let [Some(start), Some(end)] = [text.find("{"), text.rfind("}")] else {
        return Err(`unparsed: ${text}`);
    };
    return match from_string::<Verdict, String>(text.substr_bytes(start, end + 1)) {
        Ok(v) => Ok(v),
        Err(e) => Err(`unparsed: ${e:?}: ${text}`),
    };
}

export fn run() with (Stderr, Environment, Preopens, Process, Client) {
    let arguments = args();
    assert arguments.len() == 3, "usage: judge.wado <szz.json> <min-share> <out.json>";
    let Some(api_key) = env("CLAUDE_API_KEY") else {
        panic("CLAUDE_API_KEY is not set");
    };
    let census = from_string::<Census, String>(fs::read_to_string(&arguments[0]).unwrap()).unwrap();
    let min_share = f64::from_str(&arguments[1]).unwrap();
    let merges = merges_by_pr(&merged_prs());

    let mut pairs: List<Pair> = [];
    for let r of &census.results {
        if r.old_lines == 0 || r.blamed[0].pr == 0 {
            continue;
        }
        let share = r.blamed[0].n as f64 / r.old_lines as f64;
        if share < min_share {
            continue;
        }
        let mut pair = Pair {
            fix: r.pr,
            culprit: r.blamed[0].pr,
            share: f64::round(share * 100.0) / 100.0,
            lines: r.old_lines,
            adds_test: r.adds_test,
            title: r.title,
        };
        match [merges.get(r.pr), merges.get(r.blamed[0].pr)] {
            [Some(fix), Some(culprit)] => {
                let user = prompt(r, &fix.sha, &culprit.sha, &culprit.title);
                match ask(api_key, CLAUDE_MODEL, SYSTEM, user, 2000) {
                    Ok(text) => match verdict_of(&text) {
                        Ok(v) => pair.verdict = Some(v),
                        Err(e) => pair.error = Some(e),
                    },
                    Err(e) => pair.error = Some(e),
                }
            },
            _ => pair.error = Some("merge not found"),
        }
        pairs.push(pair);
        eprintln(`${pairs.len()} #${r.pr}`);
    }
    let out = Judged { model: CLAUDE_MODEL, min_share, pairs };
    fs::write(&arguments[2], &to_bytes_pretty(&out).unwrap()).unwrap();
}

test "the verdict is the object in the reply" {
    let v = verdict_of(&"Sure.\n{\"is_defect_fix\": true, \"introduced_by_culprit\": false, \"visible_in_diff\": false, \"defect\": \"d\", \"reason\": \"r\"}\n").unwrap();
    assert v.is_defect_fix && !v.introduced_by_culprit;
    assert verdict_of(&"no json").is_err();
}
