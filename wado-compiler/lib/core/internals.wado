// Wado Core Internals Module
//
// This module provides internal functions used by the compiler for
// operations like template string interpolation. These functions are
// implemented in Wado itself rather than as inline Wasm instructions,
// making the codegen simpler and the compiler more maintainable.

/// Concatenate two strings into a new string
/// This is the core operation for template string building
pub fn string_concat(a: String, b: String) -> String {
    let len_a = builtin::array_len(a);
    let len_b = builtin::array_len(b);
    let total = len_a + len_b;

    // Create new array with total length
    let result = builtin::string_new(total);

    // Copy bytes from a
    for (let mut i = 0; i < len_a; i = i + 1) {
        let byte = builtin::array_get_u8(a, i);
        builtin::array_set_u8(result, i, byte);
    }

    // Copy bytes from b
    for (let mut i = 0; i < len_b; i = i + 1) {
        let byte = builtin::array_get_u8(b, i);
        builtin::array_set_u8(result, len_a + i, byte);
    }

    return result;
}

/// Convert f64 to String using the bundled float-to-string algorithm
pub fn f64_to_string(value: f64) -> String {
    // Allocate linear memory buffer (24 bytes max for f64)
    let ptr = builtin::realloc(0, 0, 1, 24);

    // Convert float to bytes in linear memory
    let len = builtin::f64_to_buffer(value, ptr);

    // Create GC array and copy from linear memory
    let result = builtin::string_new(len);
    for (let mut i = 0; i < len; i = i + 1) {
        let byte = builtin::memory_load8_u(ptr + i);
        builtin::array_set_u8(result, i, byte);
    }

    return result;
}

/// Convert f32 to String using the bundled float-to-string algorithm
pub fn f32_to_string(value: f32) -> String {
    // Allocate linear memory buffer (16 bytes max for f32)
    let ptr = builtin::realloc(0, 0, 1, 16);

    // Convert float to bytes in linear memory
    let len = builtin::f32_to_buffer(value, ptr);

    // Create GC array and copy from linear memory
    let result = builtin::string_new(len);
    for (let mut i = 0; i < len; i = i + 1) {
        let byte = builtin::memory_load8_u(ptr + i);
        builtin::array_set_u8(result, i, byte);
    }

    return result;
}

/// Convert i32 to String
/// Maximum i32 value is 2147483647 (10 digits) + optional minus sign = 11 chars max
pub fn i32_to_string(value: i32) -> String {
    // Handle zero case
    if value == 0 {
        let result = builtin::string_new(1);
        builtin::array_set_u8(result, 0, '0' as i32);
        return result;
    }

    // Determine sign and work with absolute value
    let is_negative = value < 0;

    // We'll convert to positive, but handle MIN specially since -MIN overflows
    // For i32::MIN (-2147483648), we need special handling
    let mut abs_value = value;
    if is_negative {
        // For most negative numbers, negate
        // But for i32::MIN, we handle it specially below
        if value != -2147483648 {
            abs_value = 0 - value;
        }
    }

    // Count digits - max 10 for i32
    // Allocate buffer in linear memory (12 bytes max: sign + 10 digits + safety)
    let ptr = builtin::realloc(0, 0, 1, 12);

    // Special case for i32::MIN which cannot be negated
    if value == -2147483648 {
        // "-2147483648" is 11 characters
        builtin::memory_store8(ptr, '-' as i32);
        builtin::memory_store8(ptr + 1, '2' as i32);
        builtin::memory_store8(ptr + 2, '1' as i32);
        builtin::memory_store8(ptr + 3, '4' as i32);
        builtin::memory_store8(ptr + 4, '7' as i32);
        builtin::memory_store8(ptr + 5, '4' as i32);
        builtin::memory_store8(ptr + 6, '8' as i32);
        builtin::memory_store8(ptr + 7, '3' as i32);
        builtin::memory_store8(ptr + 8, '6' as i32);
        builtin::memory_store8(ptr + 9, '4' as i32);
        builtin::memory_store8(ptr + 10, '8' as i32);
        let result = builtin::string_new(11);
        for (let mut i = 0; i < 11; i = i + 1) {
            let byte = builtin::memory_load8_u(ptr + i);
            builtin::array_set_u8(result, i, byte);
        }
        return result;
    }

    // Convert digits in reverse order
    let mut pos = 11; // Start from end of buffer
    let mut temp = abs_value;
    while temp > 0 {
        pos = pos - 1;
        let digit = temp % 10;
        builtin::memory_store8(ptr + pos, ('0' as i32) + digit);
        temp = temp / 10;
    }

    // Add sign if negative
    if is_negative {
        pos = pos - 1;
        builtin::memory_store8(ptr + pos, '-' as i32);
    }

    // Calculate length and copy to GC string
    let len = 11 - pos;
    let result = builtin::string_new(len);
    for (let mut i = 0; i < len; i = i + 1) {
        let byte = builtin::memory_load8_u(ptr + pos + i);
        builtin::array_set_u8(result, i, byte);
    }

    return result;
}

/// Convert i64 to String
/// Maximum i64 value is 9223372036854775807 (19 digits) + optional minus sign = 20 chars max
pub fn i64_to_string(value: i64) -> String {
    // Handle zero case
    let zero_i64: i64 = 0 as i64;
    if value == zero_i64 {
        let result = builtin::string_new(1);
        builtin::array_set_u8(result, 0, '0' as i32);
        return result;
    }

    // Determine sign and work with absolute value
    let is_negative = value < zero_i64;

    let mut abs_value: i64 = value;
    // i64::MIN = 0x8000000000000000 = -9223372036854775808
    // We can't negate it, so we use a trick: check if value == -1 - 9223372036854775807
    let i64_max: i64 = 9223372036854775807 as i64;
    let one_i64: i64 = 1 as i64;
    let i64_min: i64 = zero_i64 - i64_max - one_i64;
    if is_negative {
        // For most negative numbers, negate
        // But for i64::MIN, we handle it specially below
        if value != i64_min {
            abs_value = zero_i64 - value;
        }
    }

    // Allocate buffer in linear memory (21 bytes max: sign + 19 digits + safety)
    let ptr: i32 = builtin::realloc(0, 0, 1, 21);

    // Special case for i64::MIN which cannot be negated
    if value == i64_min {
        // "-9223372036854775808" is 20 characters
        builtin::memory_store8(ptr, '-' as i32);
        builtin::memory_store8(ptr + 1, '9' as i32);
        builtin::memory_store8(ptr + 2, '2' as i32);
        builtin::memory_store8(ptr + 3, '2' as i32);
        builtin::memory_store8(ptr + 4, '3' as i32);
        builtin::memory_store8(ptr + 5, '3' as i32);
        builtin::memory_store8(ptr + 6, '7' as i32);
        builtin::memory_store8(ptr + 7, '2' as i32);
        builtin::memory_store8(ptr + 8, '0' as i32);
        builtin::memory_store8(ptr + 9, '3' as i32);
        builtin::memory_store8(ptr + 10, '6' as i32);
        builtin::memory_store8(ptr + 11, '8' as i32);
        builtin::memory_store8(ptr + 12, '5' as i32);
        builtin::memory_store8(ptr + 13, '4' as i32);
        builtin::memory_store8(ptr + 14, '7' as i32);
        builtin::memory_store8(ptr + 15, '7' as i32);
        builtin::memory_store8(ptr + 16, '5' as i32);
        builtin::memory_store8(ptr + 17, '8' as i32);
        builtin::memory_store8(ptr + 18, '0' as i32);
        builtin::memory_store8(ptr + 19, '8' as i32);
        let result = builtin::string_new(20);
        for (let mut i: i32 = 0; i < 20; i = i + 1) {
            let byte: i32 = builtin::memory_load8_u(ptr + i);
            builtin::array_set_u8(result, i, byte);
        }
        return result;
    }

    // Convert digits in reverse order
    let mut pos: i32 = 20; // Start from end of buffer
    let mut temp: i64 = abs_value;
    let ten_i64: i64 = 10 as i64;
    while temp > zero_i64 {
        pos = pos - 1;
        let digit: i32 = (temp % ten_i64) as i32;
        builtin::memory_store8(ptr + pos, ('0' as i32) + digit);
        temp = temp / ten_i64;
    }

    // Add sign if negative
    if is_negative {
        pos = pos - 1;
        builtin::memory_store8(ptr + pos, '-' as i32);
    }

    // Calculate length and copy to GC string
    let len: i32 = 20 - pos;
    let result = builtin::string_new(len);
    for (let mut i: i32 = 0; i < len; i = i + 1) {
        let byte: i32 = builtin::memory_load8_u(ptr + pos + i);
        builtin::array_set_u8(result, i, byte);
    }

    return result;
}

/// Convert bool to String ("true" or "false")
pub fn bool_to_string(value: bool) -> String {
    if value {
        return "true";
    }
    return "false";
}

/// Convert char to String (single character)
pub fn char_to_string(value: char) -> String {
    // char is a Unicode scalar value (u32), we need to encode as UTF-8
    let code = value as i32;

    if code < 0x80 {
        // ASCII: single byte
        let result = builtin::string_new(1);
        builtin::array_set_u8(result, 0, code);
        return result;
    }

    if code < 0x800 {
        // 2-byte UTF-8: 110xxxxx 10xxxxxx
        let result = builtin::string_new(2);
        builtin::array_set_u8(result, 0, 0xC0 | (code >> 6));
        builtin::array_set_u8(result, 1, 0x80 | (code & 0x3F));
        return result;
    }

    if code < 0x10000 {
        // 3-byte UTF-8: 1110xxxx 10xxxxxx 10xxxxxx
        let result = builtin::string_new(3);
        builtin::array_set_u8(result, 0, 0xE0 | (code >> 12));
        builtin::array_set_u8(result, 1, 0x80 | ((code >> 6) & 0x3F));
        builtin::array_set_u8(result, 2, 0x80 | (code & 0x3F));
        return result;
    }

    // 4-byte UTF-8: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
    let result = builtin::string_new(4);
    builtin::array_set_u8(result, 0, 0xF0 | (code >> 18));
    builtin::array_set_u8(result, 1, 0x80 | ((code >> 12) & 0x3F));
    builtin::array_set_u8(result, 2, 0x80 | ((code >> 6) & 0x3F));
    builtin::array_set_u8(result, 3, 0x80 | (code & 0x3F));
    return result;
}
