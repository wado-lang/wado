use { Value, to_value, from_value, merge } from "core:value";
use { to_string, from_string } from "core:json";
use {
    Serialize,
    Serializer,
    SerializeMap,
    SerializeError,
    SerializeErrorKind,
    Deserialize,
    Deserializer,
    DeserializeMap,
    DeserializeVariant,
    DeserializeError,
    DeserializeErrorKind,
    DuplicateFieldPolicy,
    IgnoredAny,
    Visitor,
} from "core:serde";
use { TreeMap } from "core:collections";

fn obj(entries: List<[String, Value]>) -> TreeMap<String, Value> {
    let mut m: TreeMap<String, Value> = TreeMap::new();
    for let e of entries {
        m[e.0] = e.1;
    }
    return m;
}

/// Whether reading `v` as `T` fails with exactly `kind`.
fn fails_with<T: Deserialize>(v: &Value, kind: DeserializeErrorKind) -> bool {
    return from_value::<T>(v) matches { Err(e) && e.kind == kind };
}

fn every_arm() -> List<Value> {
    let bytes: ByteList = [1, 0xab];
    let raw: ByteList = [0xf7];
    return [
        Value::Null,
        Value::Bool(true),
        Value::Int(-3),
        Value::UInt(u64::MAX),
        Value::Int128(i128::MIN),
        Value::UInt128(u128::MAX),
        Value::Float(1.5),
        Value::String("s"),
        Value::Bytes(bytes),
        Value::List([Value::Int(1)]),
        { a: 1 },
        Value::Undefined,
        Value::Unknown(raw),
    ];
}

test "Value::Null serialize" {
    let v = Value::Null;
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "null" };
}

test "Value::Bool true serialize" {
    let v = Value::Bool(true);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "true" };
}

test "Value::Bool false serialize" {
    let v = Value::Bool(false);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "false" };
}

test "Value::Float integer serialize" {
    let v = Value::Float(42.0);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "42" };
}

test "Value::Float float serialize" {
    let v = Value::Float(3.14);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "3.14" };
}

test "Value::Float negative serialize" {
    let v = Value::Float(-7.0);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "-7" };
}

test "Value::String serialize" {
    let v = Value::String("hello");
    let r = to_string(&v);
    assert r matches { Ok(s) && s == `"hello"` };
}

test "Value::String with escapes serialize" {
    let v = Value::String("say \"hi\"");
    let r = to_string(&v);
    assert r matches { Ok(s) && s == `"say \\"hi\\""` };
}

test "Value::List empty serialize" {
    let v = Value::List([]);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "[]" };
}

test "Value::List serialize" {
    let v = Value::List([
        Value::Float(1.0),
        Value::Float(2.0),
        Value::Float(3.0),
    ]);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "[1,2,3]" };
}

test "Value::List mixed serialize" {
    let v = Value::List([
        Value::Null,
        Value::Bool(true),
        Value::String("x"),
    ]);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == `[null,true,"x"]` };
}

test "Value::Object empty serialize" {
    let v = Value::Object(obj([]));
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "{}" };
}

test "Value::Object serialize" {
    let v = Value::Object(obj([
        ["key", Value::String("value")],
    ]));
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "{\"key\":\"value\"}" };
}

test "Value::Object multiple keys serialize" {
    let v = Value::Object(obj([
        ["a", Value::Float(1.0)],
        ["b", Value::Bool(false)],
    ]));
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "{\"a\":1,\"b\":false}" };
}

test "Value::Null deserialize" {
    let r: Result<Value, DeserializeError> = from_string("null");
    assert r matches { Ok(v) && v == Value::Null };
}

test "Value::Bool true deserialize" {
    let r: Result<Value, DeserializeError> = from_string("true");
    assert r matches { Ok(v) && v == Value::Bool(true) };
}

test "Value::Bool false deserialize" {
    let r: Result<Value, DeserializeError> = from_string("false");
    assert r matches { Ok(v) && v == Value::Bool(false) };
}

test "Value::Float integer deserialize" {
    let r: Result<Value, DeserializeError> = from_string("42");
    assert r matches { Ok(v) && v == Value::Float(42.0) };
}

test "Value::Float float deserialize" {
    let r: Result<Value, DeserializeError> = from_string("3.14");
    assert r matches { Ok(v) && v == Value::Float(3.14) };
}

test "Value::Float negative deserialize" {
    let r: Result<Value, DeserializeError> = from_string("-7");
    assert r matches { Ok(v) && v == Value::Float(-7.0) };
}

test "Value::String deserialize" {
    let r: Result<Value, DeserializeError> = from_string(`"hello"`);
    assert r matches { Ok(v) && v == Value::String("hello") };
}

test "Value::String with escapes deserialize" {
    let r: Result<Value, DeserializeError> = from_string(`"line\\nbreak"`);
    assert r matches { Ok(v) && v == Value::String("line\nbreak") };
}

test "Value::List empty deserialize" {
    let r: Result<Value, DeserializeError> = from_string("[]");
    assert r matches { Ok(v) && v == Value::List([]) };
}

test "Value::List deserialize" {
    let r: Result<Value, DeserializeError> = from_string("[1,2,3]");
    assert r matches { Ok(v) && v == Value::List([
        Value::Float(1.0),
        Value::Float(2.0),
        Value::Float(3.0),
    ]) };
}

test "Value::Object empty deserialize" {
    let r: Result<Value, DeserializeError> = from_string("{}");
    assert r matches { Ok(v) && v == Value::Object(obj([])) };
}

test "Value::Object deserialize" {
    let r: Result<Value, DeserializeError> = from_string("{\"key\":\"value\"}");
    assert r matches { Ok(v) && v == Value::Object(obj([
        ["key", Value::String("value")],
    ])) };
}

test "Value nested object with array deserialize" {
    let r: Result<Value, DeserializeError> = from_string("{\"nums\":[1,2],\"flag\":true}");
    let expected = Value::Object(obj([
        [
            "nums",
            Value::List([
                Value::Float(1.0),
                Value::Float(2.0),
            ]),
        ],
        ["flag", Value::Bool(true)],
    ]));
    assert r matches { Ok(v) && v == expected };
}

test "Value round-trip null" {
    let parsed: Result<Value, DeserializeError> = from_string(to_string(&Value::Null).unwrap());
    assert parsed matches { Ok(v) && v == Value::Null };
}

test "Value round-trip nested" {
    let original = Value::Object(obj([
        ["name", Value::String("Alice")],
        ["age", Value::Float(30.0)],
        [
            "tags",
            Value::List([
                Value::String("admin"),
                Value::String("user"),
            ]),
        ],
        ["active", Value::Bool(true)],
        ["notes", Value::Null],
    ]));
    let parsed: Result<Value, DeserializeError> = from_string(to_string(&original).unwrap());
    assert parsed matches { Ok(v) && v == original };
}

test "Value whitespace tolerance" {
    let r: Result<Value, DeserializeError> = from_string("  {  \"x\"  :  1  }  ");
    assert r matches { Ok(v) && v == Value::Object(obj([
        ["x", Value::Float(1.0)],
    ])) };
}

test "a Value read from malformed JSON fails at the bad byte inside the container" {
    let fails_at = |json: String, offset: i64| {
        let r: Result<Value, DeserializeError> = from_string(json);
        return r matches { Err(e) && e.offset == offset };
    };
    assert fails_at("[1,}", 3);
    assert fails_at("{1:2}", 1);
    assert fails_at(`{"a":}`, 5);
}

// --- inspect ---

test "inspect null" {
    assert `${Value::Null:?}` == "null";
}

test "inspect bool" {
    assert `${Value::Bool(true):?}` == "true";
    assert `${Value::Bool(false):?}` == "false";
}

test "inspect float" {
    assert `${Value::Float(42.0):?}` == "42.0";
    assert `${Value::Float(3.14):?}` == "3.14";
}

test "inspect string" {
    assert `${Value::String("hello"):?}` == "\"hello\"";
}

test "inspect array" {
    let v = Value::List([
        Value::Float(1.0),
        Value::Bool(true),
        Value::Null,
    ]);
    assert `${v:?}` == "[1.0, true, null]";
}

test "inspect empty array" {
    assert `${Value::List([]):?}` == "[]";
}

test "inspect object" {
    let v = Value::Object(obj([
        ["a", Value::Float(1.0)],
    ]));
    assert `${v:?}` == "{\"a\": 1.0}";
}

test "inspect empty object" {
    assert `${Value::Object(obj([])):?}` == "{}";
}

test "pretty-print object" {
    let v = Value::Object(obj([
        ["name", Value::String("Alice")],
        ["age", Value::Float(30.0)],
    ]));
    assert `${v:#?}` == "{
  \"name\": \"Alice\",
  \"age\": 30.0,
}";
}

test "pretty-print nested" {
    let v = Value::Object(obj([
        [
            "items",
            Value::List([
                Value::Float(1.0),
                Value::Float(2.0),
            ]),
        ],
    ]));
    assert `${v:#?}` == "{
  \"items\": [
    1.0,
    2.0,
  ],
}";
}

test "inspect renders the binary-format arms" {
    let bytes: ByteList = [1, 0xab];
    let raw: ByteList = [0xf7];
    assert `${Value::Int(-3):?}` == "-3";
    assert `${Value::UInt(7):?}` == "7";
    assert `${Value::Int128(-5):?}` == "-5";
    assert `${Value::UInt128(5):?}` == "5";
    assert `${Value::Bytes(bytes):?}` == "0x01ab";
    assert `${Value::Undefined:?}` == "undefined";
    assert `${Value::Unknown(raw):?}` == "unknown(0xf7)";
}

test "inspect separates object entries with a comma" {
    let v: Value = { a: 1, b: null };
    assert `${v:?}` == "{\"a\": 1, \"b\": null}";
}

test "pretty-print renders scalars as inspect does" {
    let bytes: ByteList = [1, 0xab];
    let raw: ByteList = [0xf7];
    let scalars: List<Value> = [
        Value::Null,
        Value::Bool(true),
        Value::Bool(false),
        Value::Int(-3),
        Value::UInt(7),
        Value::Int128(-5),
        Value::UInt128(5),
        Value::Float(1.5),
        Value::String("s"),
        Value::Bytes(bytes),
        Value::Undefined,
        Value::Unknown(raw),
    ];
    for let v of scalars {
        assert `${v:#?}` == `${v:?}`;
    }
}

test "pretty-print keeps empty containers on one line" {
    let v: Value = {
        list: Value::List([]),
        object: Value::Object(obj([])),
    };
    assert `${v:#?}` == "{
  \"list\": [],
  \"object\": {},
}";
}

// --- equality ---

test "Value eq null" {
    assert Value::Null == Value::Null;
    assert !(Value::Null == Value::Bool(false));
}

test "Value eq bool" {
    assert Value::Bool(true) == Value::Bool(true);
    assert !(Value::Bool(true) == Value::Bool(false));
    assert !(Value::Bool(true) == Value::Null);
}

test "Value eq float" {
    assert Value::Float(1.0) == Value::Float(1.0);
    assert !(Value::Float(1.0) == Value::Float(2.0));
}

test "Value eq string" {
    assert Value::String("a") == Value::String("a");
    assert !(Value::String("a") == Value::String("b"));
}

test "Value eq array" {
    assert Value::List([]) == Value::List([]);
    assert Value::List([Value::Float(1.0)]) == Value::List([Value::Float(1.0)]);
    assert !(Value::List([Value::Float(1.0)]) == Value::List([Value::Float(2.0)]));
    assert !(Value::List([Value::Float(1.0)]) == Value::List([]));
}

test "Value eq object" {
    assert Value::Object(obj([])) == Value::Object(obj([]));
    assert Value::Object(obj([
        ["k", Value::Null],
    ])) == Value::Object(obj([
        ["k", Value::Null],
    ]));
    assert !(Value::Object(obj([
        ["k", Value::Null],
    ])) == Value::Object(obj([
        ["k", Value::Bool(false)],
    ])));
}

test "Value equality compares each arm by payload" {
    let arms = every_arm();
    for let a of 0..<arms.len() {
        for let b of 0..<arms.len() {
            assert (arms[a] == arms[b]) == (a == b);
        }
    }
    assert Value::UInt128(1) != Value::UInt128(2);
    let one: ByteList = [1];
    assert Value::Unknown(one) != Value::Bytes(one);
    assert Value::Int(1) != Value::UInt(1);
}

test "Value equality of objects ignores key order but not keys" {
    let ab: Value = { a: 1, b: 2 };
    let ba: Value = { b: 2, a: 1 };
    let ac: Value = { a: 1, c: 2 };
    let a: Value = { a: 1 };
    assert ab == ba;
    assert ab != ac;
    assert ab != a;
}

// --- to_value ---

struct ToValuePoint {
    x: i32,
    y: i32,
}

impl Serialize for ToValuePoint;

variant ToValueShape {
    Dot,
    Circle(i32),
}

impl Serialize for ToValueShape;

test "to_value keeps each primitive's width" {
    // A text round-trip (JSON) would collapse 42 to a Float; the direct
    // Value-building serializer keeps it an Int.
    assert to_value(&42) matches { Ok(Int(42)) };
    assert to_value(&-5_i64) matches { Ok(v) && v == Value::Int(-5) };
    assert to_value(&7_u64) matches { Ok(UInt(7)) };
    assert to_value(&7_u32) matches { Ok(v) && v == Value::UInt(7) };
    assert to_value(&i128::MIN) matches { Ok(v) && v == Value::Int128(i128::MIN) };
    assert to_value(&u128::MAX) matches { Ok(v) && v == Value::UInt128(u128::MAX) };
    assert to_value(&3.5) matches { Ok(Float(_)) };
    assert to_value(&1.5_f32) matches { Ok(v) && v == Value::Float(1.5) };
    assert to_value(&'é') matches { Ok(v) && v == Value::String("é") };
}

test "to_value on scalars" {
    assert to_value(&true) matches { Ok(Bool(true)) };
    assert to_value(&"hi") matches { Ok(String(_)) };
    let n: Option<i32> = null;
    assert to_value(&n) matches { Ok(Null) };
}

test "to_value on a list" {
    let xs: List<i32> = [1, 2, 3];
    assert to_value(&xs) matches { Ok(List(_)) };
}

test "to_value on a struct yields an object" {
    let r = to_value(&ToValuePoint { x: 1, y: 2 });
    if let Ok(Object(m)) = r {
        assert m.get("x") matches { Some(Int(1)) };
        assert m.get("y") matches { Some(Int(2)) };
    } else {
        panic("expected object");
    }
}

test "to_value on a unit variant yields its name" {
    assert to_value(&ToValueShape::Dot) matches { Ok(String(_)) };
}

test "to_value on a payload variant yields an object" {
    assert to_value(&ToValueShape::Circle(5)) matches { Ok(Object(_)) };
}

test "Value::from picks the arm of the source type" {
    assert Value::from(-5_i64) == Value::Int(-5);
    assert Value::from(7_u32) == Value::UInt(7);
    assert Value::from(u64::MAX) == Value::UInt(u64::MAX);
}

test "to_value of a Value returns every representable arm unchanged" {
    for let v of every_arm() {
        if v matches { Undefined | Unknown(_) } {
            continue;
        }
        assert to_value(&v) matches { Ok(back) && back == v };
    }
}

struct ValueHolder {
    v: Value,
}

variant ValueCase {
    Wrap(Value),
}

test "to_value refuses Undefined and Unknown, however deep" {
    let raw: ByteList = [0xf7];
    let unsupported = |r: Result<Value, SerializeError>| r matches { Err(e) && e.kind == SerializeErrorKind::UnsupportedValue };
    assert unsupported(to_value(&Value::Undefined));
    assert unsupported(to_value(&Value::Unknown(raw)));
    assert unsupported(to_value(&Value::List([Value::Undefined])));
    let in_object: Value = { a: Value::Undefined };
    assert unsupported(to_value(&in_object));
    assert unsupported(to_value(&ValueHolder { v: Value::Undefined }));
    assert unsupported(to_value(&ValueCase::Wrap(Value::Undefined)));
}

// --- from_value ---

struct Endpoint {
    host: String,
    port: i32 = 80,
    tags: List<String> = [],
    timeout: Option<f64> = null,
}

struct Service {
    name: String,
    endpoint: Endpoint,
    shape: ToValueShape = ToValueShape::Dot,
}

test "from_value reads a struct" {
    let v: Value = {
        host: "h",
        port: 8080,
        tags: ["a", "b"],
        timeout: 1.5,
    };
    let r: Result<Endpoint, DeserializeError> = from_value(&v);
    assert r matches { Ok(e) && e.host == "h"
        && e.port == 8080
        && e.tags.len() == 2
        && e.timeout matches { Some(t) && t == 1.5 } };
}

test "from_value fills field defaults" {
    let v: Value = { host: "h" };
    let r: Result<Endpoint, DeserializeError> = from_value(&v);
    assert r matches { Ok(e) && e.port == 80 && e.tags.is_empty() && e.timeout matches { None } };
}

test "from_value reports a missing field" {
    let v: Value = { port: 1 };
    assert fails_with::<Endpoint>(&v, MissingField);
}

test "from_value ignores unknown fields" {
    let v: Value = {
        host: "h",
        extra: [1, 2],
    };
    let r: Result<Endpoint, DeserializeError> = from_value(&v);
    assert r matches { Ok(e) && e.host == "h" };
}

test "from_value reads nested structs and variants" {
    let v: Value = {
        name: "svc",
        endpoint: { host: "h" },
        shape: { Circle: 3 },
    };
    let r: Result<Service, DeserializeError> = from_value(&v);
    assert r matches { Ok(s) && s.endpoint.host == "h" && s.shape matches { Circle(3) } };
}

test "from_value reads a unit variant from its name" {
    let v = Value::String("Dot");
    let r: Result<ToValueShape, DeserializeError> = from_value(&v);
    assert r matches { Ok(Dot) };
}

test "from_value reads what core:json produced" {
    // JSON yields every number as a Float.
    let v: Value = from_string(`{"host":"h","port":443}`).unwrap();
    let r: Result<Endpoint, DeserializeError> = from_value(&v);
    assert r matches { Ok(e) && e.port == 443 };
}

test "from_value round-trips to_value" {
    let s = Service {
        name: "n",
        endpoint: Endpoint {
            host: "h",
            port: 1,
            tags: ["t"],
        },
        shape: ToValueShape::Circle(2),
    };
    let r: Result<Service, DeserializeError> = from_value(&to_value(&s).unwrap());
    assert r matches { Ok(back) && back.name == "n" && back.endpoint.tags[0] == "t" && back.shape matches { Circle(2) } };
}

test "from_value reads a map" {
    let v: Value = { a: 1, b: 2 };
    let r: Result<TreeMap<String, i64>, DeserializeError> = from_value(&v);
    assert r matches { Ok(m) && m["b"] == 2 };
}

test "from_value reads Value itself" {
    let v: Value = {
        a: [1, null],
    };
    let r: Result<Value, DeserializeError> = from_value(&v);
    assert r matches { Ok(back) && back == v };
}

test "from_value into Value returns every arm unchanged" {
    for let v of every_arm() {
        assert from_value::<Value>(&v) matches { Ok(back) && back == v };
    }
}

test "from_value reads bool" {
    assert from_value::<bool>(&Value::Bool(true)) matches { Ok(true) };
}

test "from_value narrows integers with a range check" {
    assert from_value::<u8>(&Value::Int(255)) matches { Ok(255) };
    assert fails_with::<u8>(&Value::Int(256), Overflow);
    assert fails_with::<u32>(&Value::Int(-1), Overflow);
    assert fails_with::<u64>(&Value::Int(-1), Overflow);
    assert from_value::<u64>(&Value::UInt(u64::MAX)) matches { Ok(v) && v == u64::MAX };
    assert fails_with::<i64>(&Value::UInt(u64::MAX), Overflow);
    assert from_value::<i128>(&Value::Int128(-5)) matches { Ok(-5) };
    assert from_value::<i32>(&Value::UInt128(5)) matches { Ok(5) };
}

test "from_value reads u128 from every integer spelling" {
    assert from_value::<u128>(&Value::UInt128(u128::MAX)) matches { Ok(n) && n == u128::MAX };
    assert from_value::<u128>(&Value::String("340282366920938463463374607431768211455")) matches { Ok(n) && n == u128::MAX };
    assert from_value::<u128>(&Value::Int(7)) matches { Ok(7) };
    assert fails_with::<u128>(&Value::Int(-1), Overflow);
}

test "from_value reads a whole float as an integer" {
    assert from_value::<i32>(&Value::Float(42.0)) matches { Ok(42) };
    assert fails_with::<i32>(&Value::Float(4.5), UnexpectedType);
}

test "from_value reads a whole float past 64 bits into a wide integer" {
    assert from_value::<i128>(&Value::Float(1.0e20)) matches { Ok(n) && n == 100000000000000000000 };
    let two_pow_127: u128 = 170141183460469231731687303715884105728;
    assert from_value::<u128>(&Value::Float(1.7014118346046923e38)) matches { Ok(n) && n == two_pow_127 };
}

test "an out-of-range error names the target type" {
    let for_u32 = |e: &DeserializeError| e.kind == DeserializeErrorKind::Overflow
        && e.message == "value out of range for u32";
    assert from_value::<u32>(&Value::UInt128(u128::MAX)) matches { Err(e) && for_u32(&e) };
    assert from_value::<u32>(&Value::Float(1.0e30)) matches { Err(e) && for_u32(&e) };
    assert from_value::<i128>(&Value::Float(1.0e40)) matches { Err(e) && e.message == "value out of range for i128" };
    assert from_value::<u128>(&Value::Float(-1.0)) matches { Err(e) && e.message == "value out of range for u128" };
}

test "from_value reads a string-encoded integer, as core:json writes one" {
    assert from_value::<i64>(&Value::String("9007199254740993")) matches { Ok(9007199254740993) };
}

test "from_value rejects a non-number for an integer" {
    assert fails_with::<i32>(&Value::Bool(true), UnexpectedType);
    assert fails_with::<i32>(&Value::String("12x"), InvalidValue);
}

test "from_value widens every integer arm to a float" {
    assert from_value::<f64>(&Value::Int(3)) matches { Ok(f) && f == 3.0 };
    assert from_value::<f64>(&Value::UInt(3)) matches { Ok(f) && f == 3.0 };
    assert from_value::<f64>(&Value::Int128(-2)) matches { Ok(f) && f == -2.0 };
    assert from_value::<f64>(&Value::UInt128(4)) matches { Ok(f) && f == 4.0 };
}

test "from_value reads narrow floats" {
    assert from_value::<f32>(&Value::Float(1.5)) matches { Ok(f) && f == 1.5 };
    let half: f16 = 0.5;
    assert from_value::<f16>(&Value::Float(0.5)) matches { Ok(f) && f == half };
    let brain: bf16 = -2.0;
    assert from_value::<bf16>(&Value::Int(-2)) matches { Ok(f) && f == brain };
}

test "from_value rejects a non-number for a float" {
    assert fails_with::<f64>(&Value::String("1"), UnexpectedType);
    assert fails_with::<f32>(&Value::Null, UnexpectedType);
    assert fails_with::<f16>(&Value::Null, UnexpectedType);
    assert fails_with::<bf16>(&Value::Null, UnexpectedType);
}

test "from_value rejects a type mismatch" {
    assert fails_with::<String>(&Value::Int(1), UnexpectedType);
    assert fails_with::<bool>(&Value::Null, UnexpectedType);
    assert fails_with::<List<i32>>(&Value::String("x"), UnexpectedType);
    assert fails_with::<Endpoint>(&Value::List([]), UnexpectedType);
    assert fails_with::<TreeMap<String, i64>>(&Value::Int(1), UnexpectedType);
}

test "from_value reads a char and bytes" {
    assert from_value::<char>(&Value::String("x")) matches { Ok('x') };
    let bytes: ByteList = [1, 2];
    assert from_value::<ByteList>(&Value::Bytes(bytes)) matches { Ok(b) && b.len() == 2 };
    // core:json writes bytes as base64.
    assert from_value::<ByteList>(&Value::String("AQI=")) matches { Ok(b) && b.len() == 2 && b[1] == 2 };
}

test "from_value rejects a char that is not exactly one character" {
    assert fails_with::<char>(&Value::String(""), InvalidValue);
    assert fails_with::<char>(&Value::String("xy"), InvalidValue);
    assert fails_with::<char>(&Value::Int(120), UnexpectedType);
}

test "from_value rejects bytes that are neither Bytes nor base64" {
    assert fails_with::<ByteList>(&Value::String("!!"), InvalidValue);
    assert fails_with::<ByteList>(&Value::Int(1), UnexpectedType);
}

test "from_value reads Null and Undefined as an absent Option" {
    assert from_value::<Option<i32>>(&Value::Null) matches { Ok(None) };
    assert from_value::<Option<i32>>(&Value::Undefined) matches { Ok(None) };
    assert from_value::<Option<i32>>(&Value::Int(3)) matches { Ok(Some(3)) };
}

test "from_value reports a bad list element" {
    let v = Value::List([
        Value::Int(1),
        Value::Bool(true),
    ]);
    assert fails_with::<List<i32>>(&v, UnexpectedType);
}

test "from_value rejects a list longer than the tuple" {
    let v = Value::List([
        Value::Int(1),
        Value::Int(2),
        Value::Int(3),
    ]);
    assert fails_with::<[i32, i32]>(&v, InvalidValue);
}

test "from_value rejects a payload case named without its payload" {
    assert from_value::<ToValueShape>(&Value::String("Circle")) matches { Err(e) && e.kind == DeserializeErrorKind::UnexpectedType
        && e.message == "expected a payload for Circle" };
}

test "from_value reads a variant only from a name or a one-key object" {
    let two_keys: Value = { Circle: 1, Dot: null };
    assert fails_with::<ToValueShape>(&Value::Int(1), UnexpectedType);
    assert fails_with::<ToValueShape>(&Value::Object(obj([])), UnexpectedType);
    assert fails_with::<ToValueShape>(&two_keys, UnexpectedType);
}

/// Records whether the wire's variant case carried a payload.
struct CaseShape {
    unit: bool,
}

impl Deserialize for CaseShape {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<CaseShape, DeserializeError> {
        let mut va = d.begin_variant("CaseShape", 2)?;
        return va.is_unit().map(|unit| CaseShape { unit });
    }
}

test "a variant read from a Value tells a unit case from a payload case" {
    let payload: Value = { Circle: 1 };
    assert from_value::<CaseShape>(&Value::String("Dot")) matches { Ok(c) && c.unit };
    assert from_value::<CaseShape>(&payload) matches { Ok(c) && !c.unit };
    assert fails_with::<CaseShape>(&Value::Int(1), UnexpectedType);
}

// --- merge ---

test "merge overlays objects key by key, recursively" {
    let base: Value = {
        server: { host: "localhost", port: 80 },
        debug: false,
    };
    let overlay: Value = {
        server: { port: 8080 },
        debug: true,
    };
    let expected: Value = {
        server: { host: "localhost", port: 8080 },
        debug: true,
    };
    assert merge(base, overlay) == expected;
}

test "merge adds keys the base lacks, after its own" {
    let base: Value = { a: 1 };
    let overlay: Value = { b: 2 };
    let merged = merge(base, overlay);
    let expected: Value = { a: 1, b: 2 };
    assert merged == expected;
    assert to_string(&merged) matches { Ok(s) && s == "{\"a\":1,\"b\":2}" };
}

test "merge takes an object the base lacks whole" {
    let base: Value = { a: 1 };
    let overlay: Value = {
        b: { c: 2 },
    };
    let expected: Value = {
        a: 1,
        b: { c: 2 },
    };
    assert merge(base, overlay) == expected;
}

test "merge replaces a list rather than concatenating" {
    let base: Value = {
        tags: ["a", "b"],
    };
    let overlay: Value = {
        tags: ["c"],
    };
    let expected: Value = {
        tags: ["c"],
    };
    assert merge(base, overlay) == expected;
}

test "merge replaces when either side is not an object" {
    let base: Value = {
        a: { b: 1 },
    };
    let overlay: Value = { a: 5 };
    let expected: Value = { a: 5 };
    assert merge(base, overlay) == expected;
    assert merge(Value::Int(1), Value::String("x")) == Value::String("x");
    assert merge(overlay, Value::Int(5)) == Value::Int(5);
    let nested: Value = {
        a: { b: 2 },
    };
    assert merge(overlay, nested) == nested;
}

test "merge takes an explicit null from the overlay" {
    let base: Value = { a: 1 };
    let overlay: Value = { a: null };
    let expected: Value = { a: null };
    assert merge(base, overlay) == expected;
}

// --- map keys ---

test "to_value writes a string-keyed map as an object in key order" {
    let mut m = TreeMap::<String, i32>::new();
    m["z"] = 1;
    m["a"] = 2;
    let expected: Value = { z: 1, a: 2 };
    assert to_value(&m) matches { Ok(v) && v == expected };
}

/// A hand-written map whose keys are not strings.
struct ScalarKeys {
}

// Its `?`s forward errors `to_value` never raises for these keys and values.
#[coverage(off)]
impl Serialize for ScalarKeys {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let mut m = s.begin_map(3)?;
        m.key(&-1)?;
        m.value(&"int")?;
        m.key(&2_u64)?;
        m.value(&"uint")?;
        m.key(&true)?;
        m.value(&"bool")?;
        return m.end();
    }
}

test "to_value spells integer and bool map keys as strings" {
    let expected: Value = {
        "-1": "int",
        "2": "uint",
        true: "bool",
    };
    assert to_value(&ScalarKeys {}) matches { Ok(v) && v == expected };
}

test "a scalar map key round-trips through its object spelling" {
    let mut wide = TreeMap::<i128, String>::new();
    wide[1] = "one";
    wide[-2] = "minus two";
    let v = to_value(&wide).unwrap();
    assert `${v:?}` == "{\"1\": \"one\", \"-2\": \"minus two\"}";
    let back = from_value::<TreeMap<i128, String>>(&v).unwrap();
    assert back.len() == 2 && back.get(-2_i128) == Option::Some("minus two");
    let mut floats = TreeMap::<f64, i32>::new();
    floats[0.5] = 1;
    assert `${to_value(&floats).unwrap():?}` == "{\"0.5\": 1}";
}

/// Asserts a one-entry map keyed by `key` spells it `spelling` and reads that
/// back.
fn assert_key_round_trips<K: Ord + Serialize + Deserialize + Inspect>(key: K, spelling: String) {
    let mut m = TreeMap::<K, i32>::new();
    m[key] = 1;
    let v = to_value(&m).unwrap();
    assert `${v:?}` == `{"${spelling}": 1}`;
    assert from_value::<TreeMap<K, i32>>(&v) matches { Ok(back) && back.get(key) == Option::Some(1) };
}

test "every scalar key width round-trips through its spelling" {
    assert_key_round_trips(i64::MIN, "-9223372036854775808");
    assert_key_round_trips(u32::MAX, "4294967295");
    assert_key_round_trips(u64::MAX, "18446744073709551615");
    assert_key_round_trips(u128::MAX, "340282366920938463463374607431768211455");
    let single: f32 = 1.5;
    assert_key_round_trips(single, "1.5");
    assert_key_round_trips(-0.25, "-0.25");
    let half: f16 = 2.5;
    assert_key_round_trips(half, "2.5");
    let brain: bf16 = -3.0;
    assert_key_round_trips(brain, "-3");
    assert_key_round_trips(true, "true");
    assert_key_round_trips('x', "x");
}

/// The first key of a map, read as a `K` no `TreeMap` could order.
struct FirstKey<K> {
    key: K,
}

// Only a key the map refuses reaches this, so nothing after it runs.
#[coverage(off)]
impl<K: Deserialize> Deserialize for FirstKey<K> {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<FirstKey<K>, DeserializeError> {
        let mut m = d.begin_map()?;
        let key = m.next_key::<K>()?;
        return Result::Ok(FirstKey { key: key.unwrap() });
    }
}

test "a compound map key is refused both ways" {
    let mut lists = TreeMap::<List<i32>, i32>::new();
    lists[[1]] = 1;
    assert to_value(&lists) matches { Err(e) && e.kind == SerializeErrorKind::UnsupportedValue };
    let v: Value = { a: 1 };
    assert fails_with::<TreeMap<List<i32>, i32>>(&v, UnexpectedType);
    assert fails_with::<TreeMap<i32, i32>>(&v, InvalidValue);
    assert fails_with::<FirstKey<TreeMap<String, i32>>>(&v, UnexpectedType);
    assert fails_with::<FirstKey<ToValuePoint>>(&v, UnexpectedType);
    assert fails_with::<FirstKey<ToValueShape>>(&v, UnexpectedType);
    assert fails_with::<FirstKey<()>>(&v, UnexpectedType);
}

enum KeyHue {
    Red,
    Blue,
}

test "a unit-case map key is refused on writing, as on reading" {
    let mut hues = TreeMap::<KeyHue, i32>::new();
    hues[KeyHue::Red] = 1;
    assert to_value(&hues) matches { Err(e) && e.kind == SerializeErrorKind::UnsupportedValue };
    let mut units = TreeMap::<(), i32>::new();
    units[()] = 1;
    assert to_value(&units) matches { Err(e) && e.kind == SerializeErrorKind::UnsupportedValue };
}

test "an ignored map reads each key as a string" {
    let v: Value = { a: 1 };
    assert from_value::<IgnoredAny>(&v) matches { Ok(_) };
}

// --- repeated keys ---

/// `D` with its `DuplicateFieldPolicy` relaxed to `PassThru`.
struct LastWins<D: Deserializer> {
    inner: &mut D,
}

// The trait asks for every method, but reading a `Value` or a map reaches only
// `on_duplicate_field` and `deserialize_any` or `begin_map`.
#[coverage(off)]
impl<D: Deserializer> Deserializer for LastWins<D> {
    type SeqAccess = D::SeqAccess;
    type MapAccess = D::MapAccess;
    type StructAccess = D::StructAccess;
    type VariantAccess = D::VariantAccess;

    fn on_duplicate_field(&self) -> DuplicateFieldPolicy {
        return DuplicateFieldPolicy::PassThru;
    }

    fn deserialize_i32(&mut self) -> Result<i32, DeserializeError> {
        return self.inner.deserialize_i32();
    }

    fn deserialize_i64(&mut self) -> Result<i64, DeserializeError> {
        return self.inner.deserialize_i64();
    }

    fn deserialize_u32(&mut self) -> Result<u32, DeserializeError> {
        return self.inner.deserialize_u32();
    }

    fn deserialize_u64(&mut self) -> Result<u64, DeserializeError> {
        return self.inner.deserialize_u64();
    }

    fn deserialize_i128(&mut self) -> Result<i128, DeserializeError> {
        return self.inner.deserialize_i128();
    }

    fn deserialize_u128(&mut self) -> Result<u128, DeserializeError> {
        return self.inner.deserialize_u128();
    }

    fn deserialize_f32(&mut self) -> Result<f32, DeserializeError> {
        return self.inner.deserialize_f32();
    }

    fn deserialize_f64(&mut self) -> Result<f64, DeserializeError> {
        return self.inner.deserialize_f64();
    }

    fn deserialize_f16(&mut self) -> Result<f16, DeserializeError> {
        return self.inner.deserialize_f16();
    }

    fn deserialize_bf16(&mut self) -> Result<bf16, DeserializeError> {
        return self.inner.deserialize_bf16();
    }

    fn deserialize_bool(&mut self) -> Result<bool, DeserializeError> {
        return self.inner.deserialize_bool();
    }

    fn deserialize_char(&mut self) -> Result<char, DeserializeError> {
        return self.inner.deserialize_char();
    }

    fn deserialize_string(&mut self) -> Result<String, DeserializeError> {
        return self.inner.deserialize_string();
    }

    fn is_null(&mut self) -> Result<bool, DeserializeError> {
        return self.inner.is_null();
    }

    fn begin_seq(&mut self) -> Result<D::SeqAccess, DeserializeError> {
        return self.inner.begin_seq();
    }

    fn begin_map(&mut self) -> Result<D::MapAccess, DeserializeError> {
        return self.inner.begin_map();
    }

    fn begin_struct<S: AsStrSlice>(&mut self, name: S, num_fields: i32) -> Result<D::StructAccess, DeserializeError> {
        return self.inner.begin_struct(name, num_fields);
    }

    fn begin_variant<S: AsStrSlice>(
        &mut self,
        type_name: S,
        num_cases: i32,
    ) -> Result<D::VariantAccess, DeserializeError> {
        return self.inner.begin_variant(type_name, num_cases);
    }

    fn deserialize_any<V: Visitor>(&mut self, visitor: &mut V) -> Result<V::Value, DeserializeError> {
        return self.inner.deserialize_any(visitor);
    }
}

/// A `T` read under a last-wins policy.
struct ReadLastWins<T> {
    value: T,
}

impl<T: Deserialize> Deserialize for ReadLastWins<T> {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<ReadLastWins<T>, DeserializeError> {
        let mut relaxed = LastWins { inner: d };
        return T::deserialize(&mut relaxed).map(|value| ReadLastWins { value });
    }
}

test "a TreeMap read under a last-wins policy keeps the last repeated key" {
    let r: Result<ReadLastWins<TreeMap<String, i32>>, DeserializeError> = from_string(`{"a":1,"b":2,"a":3}`);
    assert r matches { Ok(m) && m.value.len() == 2 && m.value["a"] == 3 };
}

test "a Value read under a last-wins policy keeps the last repeated key" {
    let r: Result<ReadLastWins<Value>, DeserializeError> = from_string(`{"a":1,"b":2,"a":3}`);
    let expected: Value = { a: 3.0, b: 2.0 };
    assert r matches { Ok(v) && v.value == expected };
}
