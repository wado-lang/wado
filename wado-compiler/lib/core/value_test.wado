use { Value, to_value, from_value, merge } from "core:value";
use { to_string, from_string } from "core:json";
use { Serialize, DeserializeError, DeserializeErrorKind } from "core:serde";
use { TreeMap } from "core:collections";

fn obj(entries: List<[String, Value]>) -> TreeMap<String, Value> {
    let mut m: TreeMap<String, Value> = TreeMap::new();
    for let e of entries {
        m[e.0] = e.1;
    }
    return m;
}

test "Value::Null serialize" {
    let v = Value::Null;
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "null" };
}

test "Value::Bool true serialize" {
    let v = Value::Bool(true);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "true" };
}

test "Value::Bool false serialize" {
    let v = Value::Bool(false);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "false" };
}

test "Value::Float integer serialize" {
    let v = Value::Float(42.0);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "42" };
}

test "Value::Float float serialize" {
    let v = Value::Float(3.14);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "3.14" };
}

test "Value::Float negative serialize" {
    let v = Value::Float(-7.0);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "-7" };
}

test "Value::String serialize" {
    let v = Value::String("hello");
    let r = to_string(&v);
    assert r matches { Ok(s) && s == `"hello"` };
}

test "Value::String with escapes serialize" {
    let v = Value::String("say \"hi\"");
    let r = to_string(&v);
    assert r matches { Ok(s) && s == `"say \\"hi\\""` };
}

test "Value::List empty serialize" {
    let v = Value::List([]);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "[]" };
}

test "Value::List serialize" {
    let v = Value::List([
        Value::Float(1.0),
        Value::Float(2.0),
        Value::Float(3.0),
    ]);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "[1,2,3]" };
}

test "Value::List mixed serialize" {
    let v = Value::List([
        Value::Null, Value::Bool(true),
        Value::String("x"),
    ]);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == `[null,true,"x"]` };
}

test "Value::Object empty serialize" {
    let v = Value::Object(obj([]));
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "{}" };
}

test "Value::Object serialize" {
    let v = Value::Object(obj([
        ["key", Value::String("value")],
    ]));
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "{\"key\":\"value\"}" };
}

test "Value::Object multiple keys serialize" {
    let v = Value::Object(obj([
        ["a", Value::Float(1.0)],
        ["b", Value::Bool(false)],
    ]));
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "{\"a\":1,\"b\":false}" };
}

test "Value::Null deserialize" {
    let r: Result<Value, DeserializeError> = from_string("null");
    assert r matches { Ok(v) && v == Value::Null };
}

test "Value::Bool true deserialize" {
    let r: Result<Value, DeserializeError> = from_string("true");
    assert r matches { Ok(v) && v == Value::Bool(true) };
}

test "Value::Bool false deserialize" {
    let r: Result<Value, DeserializeError> = from_string("false");
    assert r matches { Ok(v) && v == Value::Bool(false) };
}

test "Value::Float integer deserialize" {
    let r: Result<Value, DeserializeError> = from_string("42");
    assert r matches { Ok(v) && v == Value::Float(42.0) };
}

test "Value::Float float deserialize" {
    let r: Result<Value, DeserializeError> = from_string("3.14");
    assert r matches { Ok(v) && v == Value::Float(3.14) };
}

test "Value::Float negative deserialize" {
    let r: Result<Value, DeserializeError> = from_string("-7");
    assert r matches { Ok(v) && v == Value::Float(-7.0) };
}

test "Value::String deserialize" {
    let r: Result<Value, DeserializeError> = from_string(`"hello"`);
    assert r matches { Ok(v) && v == Value::String("hello") };
}

test "Value::String with escapes deserialize" {
    let r: Result<Value, DeserializeError> = from_string(`"line\\nbreak"`);
    assert r matches { Ok(v) && v == Value::String("line\nbreak") };
}

test "Value::List empty deserialize" {
    let r: Result<Value, DeserializeError> = from_string("[]");
    assert r matches { Ok(v) && v == Value::List([]) };
}

test "Value::List deserialize" {
    let r: Result<Value, DeserializeError> = from_string("[1,2,3]");
    assert r matches { Ok(v) && v == Value::List([
        Value::Float(1.0),
        Value::Float(2.0),
        Value::Float(3.0),
    ]) };
}

test "Value::Object empty deserialize" {
    let r: Result<Value, DeserializeError> = from_string("{}");
    assert r matches { Ok(v) && v == Value::Object(obj([])) };
}

test "Value::Object deserialize" {
    let r: Result<Value, DeserializeError> = from_string("{\"key\":\"value\"}");
    assert r matches { Ok(v) && v == Value::Object(obj([
        ["key", Value::String("value")],
    ])) };
}

test "Value nested object with array deserialize" {
    let r: Result<Value, DeserializeError> = from_string("{\"nums\":[1,2],\"flag\":true}");
    if let Ok(v) = r {
        let expected = Value::Object(obj([
            [
                "nums", Value::List([
                    Value::Float(1.0),
                    Value::Float(2.0),
                ]),
            ],
            ["flag", Value::Bool(true)],
        ]));
        assert v == expected;
    }
}

test "Value round-trip null" {
    let original = Value::Null;
    let json_r = to_string(&original);
    if let Ok(json) = json_r {
        let parsed_r: Result<Value, DeserializeError> = from_string(json);
        assert parsed_r matches { Ok(v) && v == Value::Null };
    }
}

test "Value round-trip nested" {
    let original = Value::Object(obj([
        ["name", Value::String("Alice")],
        ["age", Value::Float(30.0)],
        [
            "tags", Value::List([
                Value::String("admin"),
                Value::String("user"),
            ]),
        ],
        ["active", Value::Bool(true)],
        ["notes", Value::Null],
    ]));
    let json_r = to_string(&original);
    if let Ok(json) = json_r {
        let parsed_r: Result<Value, DeserializeError> = from_string(json);
        if let Ok(parsed) = parsed_r {
            assert parsed == original;
        }
    }
}

test "Value whitespace tolerance" {
    let r: Result<Value, DeserializeError> = from_string("  {  \"x\"  :  1  }  ");
    assert r matches { Ok(v) && v == Value::Object(obj([
        ["x", Value::Float(1.0)],
    ])) };
}

test "inspect null" {
    assert `${Value::Null:?}` == "null";
}

test "inspect bool" {
    assert `${Value::Bool(true):?}` == "true";
    assert `${Value::Bool(false):?}` == "false";
}

test "inspect float" {
    assert `${Value::Float(42.0):?}` == "42.0";
    assert `${Value::Float(3.14):?}` == "3.14";
}

test "inspect string" {
    assert `${Value::String("hello"):?}` == "\"hello\"";
}

test "inspect array" {
    let v = Value::List([
        Value::Float(1.0),
        Value::Bool(true), Value::Null,
    ]);
    assert `${v:?}` == "[1.0, true, null]";
}

test "inspect empty array" {
    assert `${Value::List([]):?}` == "[]";
}

test "inspect object" {
    let v = Value::Object(obj([
        ["a", Value::Float(1.0)],
    ]));
    assert `${v:?}` == "{\"a\": 1.0}";
}

test "inspect empty object" {
    assert `${Value::Object(obj([])):?}` == "{}";
}

test "pretty-print object" {
    let v = Value::Object(obj([
        ["name", Value::String("Alice")],
        ["age", Value::Float(30.0)],
    ]));
    assert `${v:#?}` == "{
  \"name\": \"Alice\",
  \"age\": 30.0,
}";
}

test "pretty-print nested" {
    let v = Value::Object(obj([
        [
            "items", Value::List([
                Value::Float(1.0),
                Value::Float(2.0),
            ]),
        ],
    ]));
    assert `${v:#?}` == "{
  \"items\": [
    1.0,
    2.0,
  ],
}";
}

test "Value eq null" {
    assert Value::Null == Value::Null;
    assert !(Value::Null == Value::Bool(false));
}

test "Value eq bool" {
    assert Value::Bool(true) == Value::Bool(true);
    assert !(Value::Bool(true) == Value::Bool(false));
    assert !(Value::Bool(true) == Value::Null);
}

test "Value eq float" {
    assert Value::Float(1.0) == Value::Float(1.0);
    assert !(Value::Float(1.0) == Value::Float(2.0));
}

test "Value eq string" {
    assert Value::String("a") == Value::String("a");
    assert !(Value::String("a") == Value::String("b"));
}

test "Value eq array" {
    assert Value::List([]) == Value::List([]);
    assert Value::List([Value::Float(1.0)]) == Value::List([Value::Float(1.0)]);
    assert !(Value::List([Value::Float(1.0)]) == Value::List([Value::Float(2.0)]));
    assert !(Value::List([Value::Float(1.0)]) == Value::List([]));
}

test "Value eq object" {
    assert Value::Object(obj([])) == Value::Object(obj([]));
    assert Value::Object(obj([
        ["k", Value::Null],
    ])) == Value::Object(obj([
        ["k", Value::Null],
    ]));
    assert !(Value::Object(obj([
        ["k", Value::Null],
    ])) == Value::Object(obj([
        ["k", Value::Bool(false)],
    ])));
}

struct ToValuePoint {
    x: i32,
    y: i32,
}

impl Serialize for ToValuePoint;

variant ToValueShape {
    Dot,
    Circle(i32),
}

impl Serialize for ToValueShape;

test "to_value preserves the integer/float distinction" {
    // A text round-trip (JSON) would collapse 42 to a Float; the direct
    // Value-building serializer keeps it an Int.
    assert to_value(&42) matches { Ok(Int(42)) };
    assert to_value(&(7 as u64)) matches { Ok(UInt(7)) };
    assert to_value(&3.5) matches { Ok(Float(_)) };
}

test "to_value on scalars" {
    assert to_value(&true) matches { Ok(Bool(true)) };
    assert to_value(&"hi") matches { Ok(String(_)) };
    let n: Option<i32> = null;
    assert to_value(&n) matches { Ok(Null) };
}

test "to_value on a list" {
    let xs: List<i32> = [1, 2, 3];
    assert to_value(&xs) matches { Ok(List(_)) };
}

test "to_value on a struct yields an object" {
    let r = to_value(&ToValuePoint { x: 1, y: 2 });
    if let Ok(Object(m)) = r {
        assert m.get("x") matches { Some(Int(1)) };
        assert m.get("y") matches { Some(Int(2)) };
    } else {
        panic("expected object");
    }
}

test "to_value on a unit variant yields its name" {
    assert to_value(&ToValueShape::Dot) matches { Ok(String(_)) };
}

test "to_value on a payload variant yields an object" {
    assert to_value(&ToValueShape::Circle(5)) matches { Ok(Object(_)) };
}

// --- from_value ---

struct Endpoint {
    host: String,
    port: i32 = 80,
    tags: List<String> = [],
    timeout: Option<f64> = null,
}

struct Service {
    name: String,
    endpoint: Endpoint,
    shape: ToValueShape = ToValueShape::Dot,
}

test "from_value reads a struct" {
    let v: Value = {
        host: "h",
        port: 8080,
        tags: ["a", "b"],
        timeout: 1.5,
    };
    let r: Result<Endpoint, DeserializeError> = from_value(&v);
    assert r matches { Ok(e) && e.host == "h"
        && e.port == 8080
        && e.tags.len() == 2
        && e.timeout matches { Some(t) && t == 1.5 } };
}

test "from_value fills field defaults" {
    let v: Value = { host: "h" };
    let r: Result<Endpoint, DeserializeError> = from_value(&v);
    assert r matches { Ok(e) && e.port == 80 && e.tags.is_empty() && e.timeout matches { None } };
}

test "from_value reports a missing field" {
    let v: Value = { port: 1 };
    let r: Result<Endpoint, DeserializeError> = from_value(&v);
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::MissingField };
}

test "from_value ignores unknown fields" {
    let v: Value = {
        host: "h",
        extra: [1, 2],
    };
    let r: Result<Endpoint, DeserializeError> = from_value(&v);
    assert r matches { Ok(e) && e.host == "h" };
}

test "from_value reads nested structs and variants" {
    let v: Value = {
        name: "svc",
        endpoint: { host: "h" },
        shape: { Circle: 3 },
    };
    let r: Result<Service, DeserializeError> = from_value(&v);
    assert r matches { Ok(s) && s.endpoint.host == "h" && s.shape matches { Circle(3) } };
}

test "from_value reads a unit variant from its name" {
    let v = Value::String("Dot");
    let r: Result<ToValueShape, DeserializeError> = from_value(&v);
    assert r matches { Ok(Dot) };
}

test "from_value reads what core:json produced" {
    // JSON yields every number as a Float.
    let v: Value = from_string(`{"host":"h","port":443}`).unwrap();
    let r: Result<Endpoint, DeserializeError> = from_value(&v);
    assert r matches { Ok(e) && e.port == 443 };
}

test "from_value round-trips to_value" {
    let s = Service {
        name: "n",
        endpoint: Endpoint {
            host: "h",
            port: 1,
            tags: ["t"],
        },
        shape: ToValueShape::Circle(2),
    };
    let r: Result<Service, DeserializeError> = from_value(&to_value(&s).unwrap());
    assert r matches { Ok(back) && back.name == "n" && back.endpoint.tags[0] == "t" && back.shape matches { Circle(2) } };
}

test "from_value reads a map" {
    let v: Value = { a: 1, b: 2 };
    let r: Result<TreeMap<String, i64>, DeserializeError> = from_value(&v);
    assert r matches { Ok(m) && m["b"] == 2 };
}

test "from_value reads Value itself" {
    let v: Value = {
        a: [1, null],
    };
    let r: Result<Value, DeserializeError> = from_value(&v);
    assert r matches { Ok(back) && back == v };
}

test "from_value narrows integers with a range check" {
    assert from_value::<u8>(&Value::Int(255)) matches { Ok(255) };
    assert from_value::<u8>(&Value::Int(256)) matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    assert from_value::<u32>(&Value::Int(-1)) matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    assert from_value::<u64>(&Value::UInt(u64::MAX)) matches { Ok(v) && v == u64::MAX };
    assert from_value::<i64>(&Value::UInt(u64::MAX)) matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    assert from_value::<i128>(&Value::Int128(-5)) matches { Ok(-5) };
}

test "from_value reads a whole float as an integer" {
    assert from_value::<i32>(&Value::Float(42.0)) matches { Ok(42) };
    assert from_value::<i32>(&Value::Float(4.5)) matches { Err(e) && e.kind == DeserializeErrorKind::UnexpectedType };
}

test "from_value reads a whole float past 64 bits into a wide integer" {
    assert from_value::<i128>(&Value::Float(1.0e20)) matches { Ok(n) && n == 100000000000000000000 };
    let two_pow_127: u128 = 170141183460469231731687303715884105728;
    assert from_value::<u128>(&Value::Float(1.7014118346046923e38)) matches { Ok(n) && n == two_pow_127 };
}

test "an out-of-range error names the target type" {
    let for_u32 = |e: &DeserializeError| e.kind == DeserializeErrorKind::Overflow
        && e.message == "value out of range for u32";
    assert from_value::<u32>(&Value::UInt128(u128::MAX)) matches { Err(e) && for_u32(&e) };
    assert from_value::<u32>(&Value::Float(1.0e30)) matches { Err(e) && for_u32(&e) };
    assert from_value::<i128>(&Value::Float(1.0e40)) matches { Err(e) && e.message == "value out of range for i128" };
    assert from_value::<u128>(&Value::Float(-1.0)) matches { Err(e) && e.message == "value out of range for u128" };
}

test "from_value reads a string-encoded integer, as core:json writes one" {
    assert from_value::<i64>(&Value::String("9007199254740993")) matches { Ok(9007199254740993) };
}

test "from_value widens integers to floats" {
    assert from_value::<f64>(&Value::Int(3)) matches { Ok(f) && f == 3.0 };
}

test "from_value rejects a type mismatch" {
    assert from_value::<String>(&Value::Int(1)) matches { Err(e) && e.kind == DeserializeErrorKind::UnexpectedType };
    assert from_value::<bool>(&Value::Null) matches { Err(e) && e.kind == DeserializeErrorKind::UnexpectedType };
    assert from_value::<List<i32>>(&Value::String("x")) matches { Err(e) && e.kind == DeserializeErrorKind::UnexpectedType };
}

test "from_value reads a char and bytes" {
    assert from_value::<char>(&Value::String("x")) matches { Ok('x') };
    assert from_value::<char>(&Value::String("xy")) matches { Err(_) };
    let bytes: ByteList = [1, 2];
    assert from_value::<ByteList>(&Value::Bytes(bytes)) matches { Ok(b) && b.len() == 2 };
    // core:json writes bytes as base64.
    assert from_value::<ByteList>(&Value::String("AQI=")) matches { Ok(b) && b.len() == 2 && b[1] == 2 };
}

// --- merge ---

test "merge overlays objects key by key, recursively" {
    let base: Value = {
        server: { host: "localhost", port: 80 },
        debug: false,
    };
    let overlay: Value = {
        server: { port: 8080 },
        debug: true,
    };
    let expected: Value = {
        server: { host: "localhost", port: 8080 },
        debug: true,
    };
    assert merge(base, overlay) == expected;
}

test "merge adds keys the base lacks, after its own" {
    let base: Value = { a: 1 };
    let overlay: Value = { b: 2 };
    let merged = merge(base, overlay);
    let expected: Value = { a: 1, b: 2 };
    assert merged == expected;
    assert to_string(&merged) matches { Ok(s) && s == "{\"a\":1,\"b\":2}" };
}

test "merge replaces a list rather than concatenating" {
    let base: Value = {
        tags: ["a", "b"],
    };
    let overlay: Value = {
        tags: ["c"],
    };
    let expected: Value = {
        tags: ["c"],
    };
    assert merge(base, overlay) == expected;
}

test "merge replaces when either side is not an object" {
    let base: Value = {
        a: { b: 1 },
    };
    let overlay: Value = { a: 5 };
    let expected: Value = { a: 5 };
    assert merge(base, overlay) == expected;
    assert merge(Value::Int(1), Value::String("x")) == Value::String("x");
}

test "merge takes an explicit null from the overlay" {
    let base: Value = { a: 1 };
    let overlay: Value = { a: null };
    let expected: Value = { a: null };
    assert merge(base, overlay) == expected;
}

test "to_value preserves byte strings as Value::Bytes" {
    let bytes: ByteList = [1, 2, 3];
    let v = Value::Bytes(bytes);
    if let Ok(Bytes(b)) = to_value(&v) {
        assert b.len() == 3;
        assert b[0] == 1;
        assert b[2] == 3;
    } else {
        panic("expected Value::Bytes");
    }
}
