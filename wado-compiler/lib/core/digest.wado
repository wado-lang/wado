#![stdlib("core:digest")]
//! Cryptographic hash functions.
//!
//! This module provides the [`Digest`] trait — a common interface for
//! incremental hashing — and concrete implementations. Currently only
//! [`Sha256`] (SHA-256, FIPS 180-4 / RFC 6234) is provided; the trait keeps
//! the module name stable as more algorithms are added.
//!
//! Usage:
//!
//! ```wado
//! use { sha256 } from "core:digest";
//!
//! let digest = sha256(&data);          // one-shot, returns ByteList
//! let hex = digest.to_hex();           // lowercase hex String
//! ```
//!
//! Incremental hashing via the trait:
//!
//! ```wado
//! use { Sha256, Digest } from "core:digest";
//!
//! let mut h = Sha256::new();
//! h.update(&first_chunk);
//! h.update(&second_chunk);
//! let digest = h.finalize();
//! ```
//!
//! Message bytes are accepted from any `AsByteSlice` source: a `ByteSlice`,
//! `ByteList`, `ByteArray`, plain `List<u8>`, or a `String` (its UTF-8 bytes).

/// A streaming message-digest algorithm.
///
/// Feed message bytes with [`update`](Digest::update) (any number of times),
/// then call [`finalize`](Digest::finalize) exactly once to obtain the digest.
/// A value must not be used after `finalize`.
pub trait Digest {
    /// Absorb `data` into the running hash state.
    fn update<S: AsByteSlice>(&mut self, data: &S);

    /// Consume the buffered padding, returning the digest as raw bytes.
    fn finalize(&mut self) -> ByteList;
}

// SHA-256 round constants: the first 32 bits of the fractional parts of the
// cube roots of the first 64 primes (FIPS 180-4, section 4.2.2).
global K: List<u32> = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98,
    0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786,
    0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8,
    0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819,
    0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,
    0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7,
    0xc67178f2,
];

// Rotate a 32-bit word right by `n` bits.
fn rotr(x: u32, n: u32) -> u32 {
    return x >> n | x << 32 as u32 - n;
}

/// Incremental SHA-256 hasher (FIPS 180-4 / RFC 6234).
///
/// Produces a 32-byte digest. Use [`Sha256::new`] then the [`Digest`] trait
/// methods, or the free [`sha256`] helper for one-shot hashing.
pub struct Sha256 {
    h: List<u32>,
    buffer: List<u8>,
    total_len: u64,  // total number of message bytes absorbed so far
}

impl Sha256 {
    /// Create a fresh SHA-256 state initialized with the standard IV.
    pub fn new() -> Sha256 {
        // Initial hash values: the first 32 bits of the fractional parts of
        // the square roots of the first 8 primes (FIPS 180-4, section 5.3.3).
        return Sha256 {
            h: [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19] as List<u32>,
            buffer: [],
            total_len: 0,
        };
    }

    // Push a single byte that is not counted in the message length (padding),
    // processing the block once it becomes full.
    fn absorb_pad(&mut self, byte: u8) {
        self.buffer.push(byte);
        if self.buffer.len() == 64 {
            self.process();
            self.buffer.clear();
        }
    }

    // Absorb message bytes, compressing each 64-byte block as it fills.
    fn absorb(&mut self, data: ByteSlice) {
        for let mut i = 0; i < data.len(); i += 1 {
            self.buffer.push(data[i]);
            self.total_len += 1;
            if self.buffer.len() == 64 {
                self.process();
                self.buffer.clear();
            }
        }
    }

    // Compress the 64-byte block currently held in `self.buffer`.
    fn process(&mut self) {
        // Build the 64-word message schedule.
        let mut w = List::<u32>::filled(64, 0);
        for let mut t = 0; t < 16; t += 1 {
            let j = t * 4;
            w[t] = self.buffer[j] as u32 << 24 | self.buffer[j + 1] as u32 << 16 | self.buffer[j + 2] as u32 << 8 | self.buffer[j + 3] as u32;
        }
        for let mut t = 16; t < 64; t += 1 {
            let s0 = rotr(w[t - 15], 7) ^ rotr(w[t - 15], 18) ^ w[t - 15] >> 3;
            let s1 = rotr(w[t - 2], 17) ^ rotr(w[t - 2], 19) ^ w[t - 2] >> 10;
            w[t] = w[t - 16] + s0 + w[t - 7] + s1;
        }

        let mut a = self.h[0];
        let mut b = self.h[1];
        let mut c = self.h[2];
        let mut d = self.h[3];
        let mut e = self.h[4];
        let mut f = self.h[5];
        let mut g = self.h[6];
        let mut hh = self.h[7];

        for let mut t = 0; t < 64; t += 1 {
            let big_s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
            let ch = e & f ^ ~e & g;
            let t1 = hh + big_s1 + ch + K[t] + w[t];
            let big_s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
            let maj = a & b ^ a & c ^ b & c;
            let t2 = big_s0 + maj;

            hh = g;
            g = f;
            f = e;
            e = d + t1;
            d = c;
            c = b;
            b = a;
            a = t1 + t2;
        }

        self.h[0] = self.h[0] + a;
        self.h[1] = self.h[1] + b;
        self.h[2] = self.h[2] + c;
        self.h[3] = self.h[3] + d;
        self.h[4] = self.h[4] + e;
        self.h[5] = self.h[5] + f;
        self.h[6] = self.h[6] + g;
        self.h[7] = self.h[7] + hh;
    }
}

impl Digest for Sha256 {
    fn update<S: AsByteSlice>(&mut self, data: &S) {
        self.absorb(data.as_byte_slice());
    }

    fn finalize(&mut self) -> ByteList {
        let bit_len: u64 = self.total_len * 8;

        // Append the mandatory 0x80 byte, then zeros until 56 bytes remain in
        // the block for the 64-bit length field.
        self.absorb_pad(0x80);
        while self.buffer.len() != 56 {
            self.absorb_pad(0x00);
        }

        // Append the original message length in bits as a big-endian u64.
        for let mut i = 0; i < 8; i += 1 {
            let shift = ((7 - i) * 8) as u64;
            self.absorb_pad((bit_len >> shift) as u8);
        }

        let mut out: List<u8> = [];
        for let mut i = 0; i < 8; i += 1 {
            let v = self.h[i];
            out.push((v >> 24) as u8);
            out.push((v >> 16) as u8);
            out.push((v >> 8) as u8);
            out.push(v as u8);
        }
        return out as ByteList;
    }
}

/// Hash a complete message with SHA-256, returning the 32-byte digest.
///
/// Accepts any byte source via `AsByteSlice` (a `String` hashes its UTF-8
/// bytes). Render the result as hex with `to_hex`, e.g. `sha256(&data).to_hex()`.
pub fn sha256<S: AsByteSlice>(data: &S) -> ByteList {
    let mut hasher = Sha256::new();
    hasher.update(data);
    return hasher.finalize();
}
