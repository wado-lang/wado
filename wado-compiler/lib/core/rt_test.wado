//! Tests for `core:rt`.

use { i64_add128_soft, i64_sub128_soft, i64_mul_wide_u_soft, i64_mul_wide_s_soft, log_stdout } from "core:rt";
use { MonotonicClock } from "wasi:clocks";

#[expect_trap]
test "a read with negative room is a defect" {
    let [rx, tx] = Stream::<u8>::new();
    rx.start_read(builtin::black_box(-1));
}

test "a write to a stream whose reader is gone reports the drop" {
    let [rx, tx] = Stream::<u8>::new();
    rx.drop();
    let [tx, written] = tx.start_write([1, 2]).finish();
    assert written.rest == [1, 2];
    assert written.result == CopyResult::Dropped;
    assert tx.write_raw_all(([] as List<u8>).as_slice()) == CopyResult::Completed;
    tx.drop();
}

test "a future whose reader is gone hands its value back" {
    let [rx, tx] = Future::<i32>::new();
    rx.drop();
    let written = tx.write(1);
    assert written.rest == Option::Some(1);
    assert written.result == FutureWriteResult::Dropped;
}

test "a future write the reader has not read yet is pending" {
    let [rx, tx] = Future::<i32>::new();
    let written = tx.write(1);
    assert written.rest matches { None };
    assert written.result == FutureWriteResult::Pending;
    assert rx.read() == Option::Some(1);
}

affine variant Raced {
    Value(FutureReadCopy<i32>),
    Timer(AsyncCall<()>),
}

impl Waitable for Raced;

test "a started future read waits in a set beside a timer" {
    let [rx, tx] = Future::<i32>::new();
    let mut set = WaitableSet::<Raced>::new();
    set.insert(Raced::Value(rx.start_read()));
    set.insert(Raced::Timer(MonotonicClock::wait_for(1_000_000)));
    let Timer(timer) = set.wait().member else {
        unreachable();
    };
    timer.wait();
    assert tx.write(7).result == FutureWriteResult::Completed;
    let Value(read) = set.wait().member else {
        unreachable();
    };
    assert read.finish() == Option::Some(7);
}

test "a started future read finishes without a set" {
    let [rx, tx] = Future::<i32>::new();
    assert tx.write(3).result == FutureWriteResult::Pending;
    assert rx.start_read().finish() == Option::Some(3);
}

test "a started future read dropped in flight cancels it" {
    let [rx, tx] = Future::<i32>::new();
    builtin::drop(rx.start_read());
    assert tx.write(1).result == FutureWriteResult::Dropped;
}

test "a started future read dropped once it read drops the value" {
    let [rx, tx] = Future::<i32>::new();
    assert tx.write(2).result == FutureWriteResult::Pending;
    builtin::drop(rx.start_read());
}

test "poll reports a host member once the host resolved it" {
    let [rx, tx] = Future::<i32>::new();
    let mut set = WaitableSet::<Raced>::new();
    set.insert(Raced::Value(rx.start_read()));
    assert set.poll() matches { None };
    assert tx.write(4).result == FutureWriteResult::Completed;
    let Value(read) = set.poll().unwrap().member else {
        unreachable();
    };
    assert read.finish() == Option::Some(4);
}

test "an empty waitable set has nothing to poll" {
    let mut ws = WaitableSet::<Subtask>::new();
    assert ws.poll() matches { None };
}

/// Members the host does not know, so each is ready the moment it is inserted.
variant Settled {
    First,
    Second,
}

impl Waitable for Settled;

test "a member ready without the host comes back in insertion order" {
    let mut ws = WaitableSet::<Settled>::new();
    assert ws.is_empty();
    ws.insert(Settled::First);
    ws.insert(Settled::Second);
    assert ws.len() == 2;
    let first = ws.poll().unwrap();
    assert first.member matches { First } && first.event matches { Unreported };
    assert ws.wait().member matches { Second };
    assert ws.is_empty();
}

test "a drained set hands back every member, the ready ones first" {
    let mut ws = WaitableSet::<Raced>::new();
    ws.insert(Raced::Timer(MonotonicClock::wait_for(60_000_000_000)));
    let [rx, tx] = Future::<i32>::new();
    assert tx.write(1).result == FutureWriteResult::Pending;
    ws.insert(Raced::Value(rx.start_read()));
    let mut drained = ws.drain();
    assert ws.is_empty();
    let Some(Timer(_)) = drained.pop() else {
        unreachable();
    };
    let Some(Value(read)) = drained.pop() else {
        unreachable();
    };
    assert read.finish() == Option::Some(1);
}

/// A call the host resolves after it starts, handed back by the set that
/// delivered its resolution.
fn delivered_call() -> AsyncCall<()> with MonotonicClock {
    let mut set = WaitableSet::<AsyncCall<()>>::new();
    set.insert(MonotonicClock::wait_for(1_000_000));
    let ready = set.wait();
    assert ready.event matches { Call(Returned) };
    return ready.member;
}

test "a call a set delivered ends by a wait, a drop, or another set" {
    delivered_call().wait();
    let first = delivered_call();
    let second = delivered_call();
    builtin::drop(second);
    builtin::drop(first);
    let mut again = WaitableSet::<AsyncCall<()>>::new();
    again.insert(delivered_call());
    let ready = again.wait();
    assert ready.event matches { Call(Returned) };
    ready.member.wait();
}

test "a set hands back the call that resolved and cancels the rest as it drops" {
    let mut set = WaitableSet::<AsyncCall<()>>::new();
    set.insert(MonotonicClock::wait_for(60_000_000_000));
    set.insert(MonotonicClock::wait_for(1_000_000));
    set.wait().member.wait();
    assert set.len() == 1;
}

test "log_stdout writes without an effect" {
    log_stdout("");
}

/// Operands at every carry, borrow and sign edge of a 32-bit limb.
global EDGES: List<i64> = [
    0, 1, -1, 2, -2, 0x7fff_ffff, 0x8000_0000, 0xffff_ffff, 0x1_0000_0000, 0x1234_5678_9abc_def0, i64::MAX, i64::MIN,
    i64::MIN + 1,
];

test "the software wide multiplies match the native ones" {
    for let a of EDGES {
        for let b of EDGES {
            assert i64_mul_wide_u_soft(a, b) == builtin::i64_mul_wide_u(a, b);
            assert i64_mul_wide_s_soft(a, b) == builtin::i64_mul_wide_s(a, b);
        }
    }
}

test "a half widens exactly and narrows from f64 rounded once" {
    assert builtin::black_box(1.5) as f16 as f32 == 1.5;
    assert builtin::black_box(-2.25) as bf16 as f64 == -2.25;
    assert builtin::black_box(3 as i32) as bf16 == bf16::from_f64(3.0);
}

// 2^60 + 2^52 + 1 lies just past the midpoint of bf16's neighbours 2^60 and
// 2^60 + 2^53. Rounding it to f64 first lands on that midpoint, whose tie goes
// down; rounding to odd keeps it above, so it rounds up as the integer does.
test "a 64-bit integer narrows to bf16 rounded once" {
    assert builtin::black_box(1157425104234217473 as u64) as bf16 == bf16::from_f64(1161928703861587968.0);
    assert builtin::black_box(-1157425104234217473 as i64) as bf16 == bf16::from_f64(-1161928703861587968.0);
    assert builtin::black_box(1157425104234217473 as i64) as bf16 == bf16::from_f64(1161928703861587968.0);
    // Exact in f64, then inexact with an odd and an even nearest neighbour.
    assert builtin::black_box(1152921504606846976 as u64) as bf16 == bf16::from_f64(1152921504606846976.0);
    assert builtin::black_box(1152921504606847233 as u64) as bf16 == bf16::from_f64(1152921504606846976.0);
    assert builtin::black_box(1152921504606846977 as u64) as bf16 == bf16::from_f64(1152921504606846976.0);
    // Past every f64 below 2^64.
    assert builtin::black_box(u64::MAX) as bf16 == bf16::from_f64(18446744073709551616.0);
}

test "a 128-bit integer narrows to bf16 rounded once" {
    assert builtin::black_box(1272602360385370922596299702273 as u128) as bf16 == bf16::from_f64(
        1277554120542512443695896199168.0,
    );
    assert builtin::black_box(-1272602360385370922596299702273 as i128) as bf16 == bf16::from_f64(
        -1277554120542512443695896199168.0,
    );
    assert builtin::black_box(1267650600228229401496703205376 as u128) as bf16 == bf16::from_f64(
        1267650600228229401496703205376.0,
    );
    assert builtin::black_box(5 as i128) as bf16 == bf16::from_f64(5.0);
    assert builtin::black_box(u128::MAX) as bf16 == bf16::INFINITY;
}

test "the software 128-bit add and sub match the native ones" {
    for let a_lo of EDGES {
        for let b_lo of EDGES {
            for let [a_hi, b_hi] of [
                [0, 0],
                [-1, 1],
                [i64::MAX, i64::MIN],
            ] as List<[i64, i64]> {
                assert i64_add128_soft(a_lo, a_hi, b_lo, b_hi) == builtin::i64_add128(a_lo, a_hi, b_lo, b_hi);
                assert i64_sub128_soft(a_lo, a_hi, b_lo, b_hi) == builtin::i64_sub128(a_lo, a_hi, b_lo, b_hi);
            }
        }
    }
}
