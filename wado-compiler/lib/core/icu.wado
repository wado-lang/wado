#![stdlib("core:icu")]
//! Unicode character properties and locale-aware collation, from the ICU4X
//! component bundled with the toolchain. A property name it does not answer is
//! `null`, never an approximate set: `Block`, `Decomposition_Type` and the
//! contributory `Other_*` are withheld.

pub use { Properties } from "./icu.wat" with { type: "wat" };
use { Collation } from "./icu.wat" with { type: "wat" };

#[synopsis]
test {
    assert has(Properties::BinaryProperty::Uppercase, 'À');
    assert value_contains("sc", "Hiragana", 'あ') == Option::Some(true);

    let swedish = Collator::new("sv").unwrap();
    let mut words: List<String> = ["ö", "z", "a"];
    words.sort_by(|a, b| swedish.compare(a, b));
    assert words == ["a", "z", "ö"];
}

/// Why a locale was refused: the tag does not parse as BCP 47.
pub struct LocaleError {
    message: String,
}

impl Display for LocaleError {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(&self.message);
    }
}

impl Error for LocaleError {
}

/// Compares strings the way a locale sorts them.
pub affine struct Collator {
    inner: Collation::Collator,
}

impl Collator {
    /// A collator for the BCP 47 tag `locale`. A locale CLDR tailors nothing for
    /// sorts as its fallback does, ending at the root collation.
    pub fn new(locale: String) -> Result<Collator, LocaleError> {
        return match Collation::Collator::create(locale) {
            Ok(inner) => Ok(Collator { inner }),
            Err(message) => Err(LocaleError { message }),
        };
    }

    /// How `left` sorts against `right`.
    pub fn compare(&self, left: &String, right: &String) -> Ordering {
        return match self.inner.compare(*left, *right) {
            Less => Ordering::Less,
            Equal => Ordering::Equal,
            Greater => Ordering::Greater,
        };
    }
}

/// Whether `ch` has the property. Total, and the name costs nothing at run
/// time: an enum case is a number, and ICU4X bakes each property as a static.
pub fn has(property: Properties::BinaryProperty, ch: char) -> bool {
    return Properties::has(property, ch);
}

/// The property's inclusive code point ranges, lowest first.
pub fn set(property: Properties::BinaryProperty) -> List<[u32, u32]> {
    return Properties::set(property);
}

/// Inclusive code point ranges of a binary property named at run time, lowest
/// first. Prefer [`set`] for a name written into the source.
pub fn ranges(property: String) -> Option<List<[u32, u32]>> {
    return Properties::ranges(property, null);
}

/// Inclusive code point ranges of an enumerated property's value, lowest
/// first. A `gc` value may name a group (`L`) as well as a category (`Lu`).
pub fn value_ranges(property: String, value: String) -> Option<List<[u32, u32]>> {
    return Properties::ranges(property, Option::Some(value));
}

/// Whether `ch` has the binary property named at run time. Prefer [`has`] for a
/// name written into the source.
pub fn contains(property: String, ch: char) -> Option<bool> {
    return Properties::contains(property, null, ch);
}

/// Whether `ch` has that enumerated property value, without building the
/// ranges.
pub fn value_contains(property: String, value: String, ch: char) -> Option<bool> {
    return Properties::contains(property, Option::Some(value), ch);
}
