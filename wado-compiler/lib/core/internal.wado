// Wado Core Internal Module
//
// This module provides internal functions used by the compiler for
// operations like template string interpolation. These functions are
// implemented in Wado itself rather than as inline Wasm instructions,
// making the codegen simpler and the compiler more maintainable.

/// Convert f64 to String using the bundled float-to-string algorithm
pub fn f64_to_string(value: f64) -> String {
    // Allocate linear memory buffer (24 bytes max for f64)
    let ptr = builtin::realloc(0, 0, 1, 24);

    // Convert float to bytes in linear memory
    let len = builtin::f64_to_buffer(value, ptr);

    // Create GC array and copy from linear memory
    let arr = builtin::array_new::<u8>(len);
    for (let mut i = 0; i < len; i += 1) {
        let byte = builtin::memory_load8_u(ptr + i);
        builtin::array_set_u8(arr, i, byte);
    }

    // Free linear memory buffer
    builtin::realloc(ptr, 24, 1, 0);

    return String::internal_from_utf8_raw(arr, len);
}

/// Convert f32 to String using the bundled float-to-string algorithm
pub fn f32_to_string(value: f32) -> String {
    // Allocate linear memory buffer (16 bytes max for f32)
    let ptr = builtin::realloc(0, 0, 1, 16);

    // Convert float to bytes in linear memory
    let len = builtin::f32_to_buffer(value, ptr);

    // Create GC array and copy from linear memory
    let arr = builtin::array_new::<u8>(len);
    for (let mut i = 0; i < len; i += 1) {
        let byte = builtin::memory_load8_u(ptr + i);
        builtin::array_set_u8(arr, i, byte);
    }

    // Free linear memory buffer
    builtin::realloc(ptr, 16, 1, 0);

    return String::internal_from_utf8_raw(arr, len);
}

/// Convert i32 to String
/// Maximum i32 value is 2147483647 (10 digits) + optional minus sign = 11 chars max
pub fn i32_to_string(value: i32) -> String {
    // Handle zero case
    if value == 0 {
        return "0";
    }

    // Special case for i32::MIN: In two's complement, negating MIN overflows
    // because -(-2147483648) = 2147483648 which exceeds i32::MAX (2147483647).
    // This is a well-known edge case in systems programming.
    if value == -2147483648 {
        return "-2147483648";
    }

    // Determine sign and work with absolute value
    let is_negative = value < 0;
    let abs_value = if is_negative { 0 - value } else { value };

    // Allocate buffer in linear memory (12 bytes max: sign + 10 digits + safety)
    let ptr = builtin::realloc(0, 0, 1, 12);

    // Convert digits in reverse order
    let mut pos = 11; // Start from end of buffer
    for (let mut temp = abs_value; temp > 0; temp = temp / 10) {
        pos -= 1;
        let digit = temp % 10;
        builtin::memory_store8(ptr + pos, ('0' as i32) + digit);
    }

    // Add sign if negative
    if is_negative {
        pos -= 1;
        builtin::memory_store8(ptr + pos, '-' as i32);
    }

    // Calculate length and copy to GC array
    let len = 11 - pos;
    let arr = builtin::array_new::<u8>(len);
    for (let mut i = 0; i < len; i += 1) {
        let byte = builtin::memory_load8_u(ptr + pos + i);
        builtin::array_set_u8(arr, i, byte);
    }

    // Free linear memory buffer
    builtin::realloc(ptr, 12, 1, 0);

    return String::internal_from_utf8_raw(arr, len);
}

/// Convert u32 to String (unsigned)
/// Maximum u32 value is 4294967295 (10 digits)
/// Takes i32 (Wasm type) but interprets as unsigned
pub fn u32_to_string(value: i32) -> String {
    // Handle zero case
    if value == 0 {
        return "0";
    }

    // Convert to i64 for unsigned arithmetic
    // If value is negative as i32, it means the u32 value is >= 2^31
    // We need to interpret it as unsigned by adding 2^32
    let unsigned_val: i64 = if value < 0 {
        (value as i64) + 4294967296 as i64
    } else {
        value as i64
    };

    // Allocate buffer in linear memory (11 bytes max: 10 digits + safety)
    let ptr = builtin::realloc(0, 0, 1, 11);

    // Convert digits in reverse order using i64 arithmetic
    let mut pos: i32 = 10;
    let ten: i64 = 10 as i64;
    let zero: i64 = 0 as i64;
    for (let mut temp: i64 = unsigned_val; temp > zero; temp = temp / ten) {
        pos -= 1;
        let digit: i32 = (temp % ten) as i32;
        builtin::memory_store8(ptr + pos, ('0' as i32) + digit);
    }

    // Calculate length and copy to GC array
    let len: i32 = 10 - pos;
    let arr = builtin::array_new::<u8>(len);
    for (let mut i: i32 = 0; i < len; i += 1) {
        let byte = builtin::memory_load8_u(ptr + pos + i);
        builtin::array_set_u8(arr, i, byte);
    }

    // Free linear memory buffer
    builtin::realloc(ptr, 11, 1, 0);

    return String::internal_from_utf8_raw(arr, len);
}

/// Convert i64 to String
/// Maximum i64 value is 9223372036854775807 (19 digits) + optional minus sign = 20 chars max
pub fn i64_to_string(value: i64) -> String {
    // Handle zero case
    let zero_i64: i64 = 0 as i64;
    if value == zero_i64 {
        return "0";
    }

    // Special case for i64::MIN: In two's complement, negating MIN overflows
    // because -(-9223372036854775808) = 9223372036854775808 which exceeds i64::MAX.
    // This is a well-known edge case in systems programming.
    let i64_max: i64 = 9223372036854775807 as i64;
    let one_i64: i64 = 1 as i64;
    let i64_min: i64 = zero_i64 - i64_max - one_i64;
    if value == i64_min {
        return "-9223372036854775808";
    }

    // Determine sign and work with absolute value
    let is_negative = value < zero_i64;
    let abs_value: i64 = if is_negative { zero_i64 - value } else { value };

    // Allocate buffer in linear memory (21 bytes max: sign + 19 digits + safety)
    let ptr: i32 = builtin::realloc(0, 0, 1, 21);

    // Convert digits in reverse order
    let mut pos: i32 = 20; // Start from end of buffer
    let ten_i64: i64 = 10 as i64;
    for (let mut temp: i64 = abs_value; temp > zero_i64; temp = temp / ten_i64) {
        pos -= 1;
        let digit: i32 = (temp % ten_i64) as i32;
        builtin::memory_store8(ptr + pos, ('0' as i32) + digit);
    }

    // Add sign if negative
    if is_negative {
        pos -= 1;
        builtin::memory_store8(ptr + pos, '-' as i32);
    }

    // Calculate length and copy to GC array
    let len: i32 = 20 - pos;
    let arr = builtin::array_new::<u8>(len);
    for (let mut i: i32 = 0; i < len; i += 1) {
        let byte: i32 = builtin::memory_load8_u(ptr + pos + i);
        builtin::array_set_u8(arr, i, byte);
    }

    // Free linear memory buffer
    builtin::realloc(ptr, 21, 1, 0);

    return String::internal_from_utf8_raw(arr, len);
}

/// Convert u64 to String (unsigned)
/// Maximum u64 value is 18446744073709551615 (20 digits)
/// Takes i64 (Wasm type) but interprets as unsigned
pub fn u64_to_string(value: i64) -> String {
    // Handle zero case
    let zero: i64 = 0 as i64;
    if value == zero {
        return "0";
    }

    // Allocate buffer in linear memory (21 bytes max: 20 digits + safety)
    let ptr: i32 = builtin::realloc(0, 0, 1, 21);

    // Convert digits in reverse order
    let mut pos: i32 = 20;
    let mut temp: i64 = value;
    let ten: i64 = 10 as i64;
    let offset_div: i64 = 1844674407370955161 as i64; // 2^64 / 10

    // Loop until temp is zero
    // We check the sign on each iteration because temp transitions from negative to positive
    while temp != zero {
        pos -= 1;
        let mut digit: i32 = 0;

        if temp >= zero {
            // Positive temp: normal signed arithmetic works correctly
            digit = (temp % ten) as i32;
            temp = temp / ten;
        } else {
            // Negative temp: need unsigned semantics
            // For unsigned modulo: (v + 2^64) % 10 = ((v % 10) + 6) adjusted to [0,9]
            // For unsigned division: (v + 2^64) / 10 = v/10 + 2^64/10 + carry
            // where carry = -1 if (v%10 + 6) < 0, else 0
            let signed_rem: i64 = temp % ten;
            let rem_adjusted: i64 = signed_rem + 6 as i64;

            // Get digit in range [0, 9]
            if rem_adjusted >= zero {
                digit = rem_adjusted as i32;
            } else {
                digit = (rem_adjusted + ten) as i32;
            }

            // Calculate unsigned quotient
            let signed_quot: i64 = temp / ten;
            let mut carry: i64 = 0 as i64;
            if rem_adjusted < zero {
                carry = 0 - 1 as i64;
            }
            temp = signed_quot + offset_div + carry;
        }

        builtin::memory_store8(ptr + pos, ('0' as i32) + digit);
    }

    // Calculate length and copy to GC array
    let len: i32 = 20 - pos;
    let arr = builtin::array_new::<u8>(len);
    for (let mut i: i32 = 0; i < len; i += 1) {
        let byte: i32 = builtin::memory_load8_u(ptr + pos + i);
        builtin::array_set_u8(arr, i, byte);
    }

    // Free linear memory buffer
    builtin::realloc(ptr, 21, 1, 0);

    return String::internal_from_utf8_raw(arr, len);
}

/// Convert u128 to String (unsigned)
/// Maximum u128 value is 340282366920938463463374607431768211455 (39 digits)
pub fn u128_to_string(value: u128) -> String {
    // Handle zero case
    if value == u128::zero() {
        return "0";
    }

    // Allocate buffer in linear memory (40 bytes max: 39 digits + safety)
    let ptr: i32 = builtin::realloc(0, 0, 1, 40);

    // Convert digits in reverse order by repeatedly dividing by 10
    let mut pos: i32 = 39;
    let mut temp = value;
    let ten = u128::from_u64(10 as u64);

    while temp > u128::zero() {
        pos -= 1;
        let result = temp.div_rem(&ten);
        let rem: u128 = result[1];
        let digit_u64: u64 = rem.low();
        let digit: i32 = (digit_u64 as i64) as i32;
        builtin::memory_store8(ptr + pos, ('0' as i32) + digit);
        temp = result[0];
    }

    // Calculate length and copy to GC array
    let len: i32 = 39 - pos;
    let arr = builtin::array_new::<u8>(len);
    for (let mut i: i32 = 0; i < len; i += 1) {
        let byte: i32 = builtin::memory_load8_u(ptr + pos + i);
        builtin::array_set_u8(arr, i, byte);
    }

    // Free linear memory buffer
    builtin::realloc(ptr, 40, 1, 0);

    return String::internal_from_utf8_raw(arr, len);
}

/// Convert i128 to String (signed)
/// Maximum i128 value is 170141183460469231731687303715884105727 (39 digits)
/// Minimum i128 value is -170141183460469231731687303715884105728 (40 chars with sign)
pub fn i128_to_string(value: i128) -> String {
    // Handle zero case
    if value == i128::zero() {
        return "0";
    }

    // Check for negative
    let is_negative = value.is_negative();

    // Get absolute value as u128
    let abs_value = value.abs_u128();

    // Convert absolute value to string
    let abs_str = u128_to_string(abs_value);

    // Prepend minus sign if negative
    if is_negative {
        let len = abs_str.len();
        let abs_bytes = abs_str.internal_raw_bytes();
        let arr = builtin::array_new::<u8>(len + 1);
        builtin::array_set_u8(arr, 0, '-' as i32);
        for (let mut i = 0; i < len; i += 1) {
            builtin::array_set_u8(arr, i + 1, builtin::array_get_u8(abs_bytes, i));
        }
        return String::internal_from_utf8_raw(arr, len + 1);
    }

    return abs_str;
}

/// Convert bool to String ("true" or "false")
pub fn bool_to_string(value: bool) -> String {
    return if value { "true" } else { "false" };
}

/// Convert char to String (single character)
pub fn char_to_string(value: char) -> String {
    // char is a Unicode scalar value, we need to encode as UTF-8
    let code = value as u32;

    if code < 0x80 {
        // ASCII: always valid, single byte
        let arr = builtin::array_new::<u8>(1);
        builtin::array_set_u8(arr, 0, code);
        return String::internal_from_utf8_raw(arr, 1);
    } else if code < 0x800 {
        // 2-byte UTF-8: always valid (surrogates start at 0xD800)
        let arr = builtin::array_new::<u8>(2);
        builtin::array_set_u8(arr, 0, 0xC0 | (code >> 6));
        builtin::array_set_u8(arr, 1, 0x80 | (code & 0x3F));
        return String::internal_from_utf8_raw(arr, 2);
    } else if code < 0x10000 {
        // 3-byte UTF-8: check for surrogates (0xD800-0xDFFF)
        assert code < 0xD800 || code > 0xDFFF, "invalid Unicode scalar value: surrogate code point";
        let arr = builtin::array_new::<u8>(3);
        builtin::array_set_u8(arr, 0, 0xE0 | (code >> 12));
        builtin::array_set_u8(arr, 1, 0x80 | ((code >> 6) & 0x3F));
        builtin::array_set_u8(arr, 2, 0x80 | (code & 0x3F));
        return String::internal_from_utf8_raw(arr, 3);
    } else {
        // 4-byte UTF-8: check for valid range (max 0x10FFFF)
        assert code <= 0x10FFFF, "invalid Unicode scalar value: out of range";
        let arr = builtin::array_new::<u8>(4);
        builtin::array_set_u8(arr, 0, 0xF0 | (code >> 18));
        builtin::array_set_u8(arr, 1, 0x80 | ((code >> 12) & 0x3F));
        builtin::array_set_u8(arr, 2, 0x80 | ((code >> 6) & 0x3F));
        builtin::array_set_u8(arr, 3, 0x80 | (code & 0x3F));
        return String::internal_from_utf8_raw(arr, 4);
    }
}

/// Write a string to a stream handle with an optional newline
/// Internal helper for log_stdout and log_stderr.
pub fn write_string_to_stream(tx: i32, message: String, add_newline: bool) {
    let len = message.len();
    let msg_bytes = message.internal_raw_bytes();
    let alloc_size = if add_newline { len + 1 } else { len };
    let ptr = builtin::realloc(0, 0, 1, alloc_size);
    for (let mut i = 0; i < len; i += 1) {
        let byte = builtin::array_get_u8(msg_bytes, i);
        builtin::memory_store8(ptr + i, byte);
    }
    if add_newline {
        builtin::memory_store8(ptr + len, '\n');
    }
    builtin::stream_write(tx, ptr, alloc_size);

    // Free linear memory buffer
    builtin::realloc(ptr, alloc_size, 1, 0);

    builtin::stream_drop_writable(tx);
}

/// Best-effort logging to stdout (ambient, no effect required)
/// Writes message with newline to stdout. Waits for completion.
pub fn log_stdout(message: String) {
    let handles = builtin::stream_new();
    let rx = handles as i32;
    let tx = (handles >> 32) as i32;

    builtin::call_indirect_stdout_write_via_stream(rx);
    write_string_to_stream(tx, message, true);
    builtin::effect_wait();
}

/// Best-effort logging to stderr (ambient, no effect required)
/// Writes message with newline to stderr. Waits for completion.
pub fn log_stderr(message: String) {
    let handles = builtin::stream_new();
    let rx = handles as i32;
    let tx = (handles >> 32) as i32;

    builtin::call_indirect_stderr_write_via_stream(rx);
    write_string_to_stream(tx, message, true);
    builtin::effect_wait();
}

/// Convert a Component Model list<string> to a GC Array<String>
/// The outptr points to the CM list representation in linear memory:
///   outptr[0..4]: base_ptr - pointer to array of (ptr, len) pairs
///   outptr[4..8]: count - number of strings
/// Each string in the array is represented as:
///   base_ptr[i*8+0..i*8+4]: str_ptr - pointer to UTF-8 bytes
///   base_ptr[i*8+4..i*8+8]: str_len - length in bytes
pub fn cm_list_string_to_array(outptr: i32) -> Array<String> {
    let base_ptr = builtin::memory_load32(outptr);
    let count = builtin::memory_load32(outptr + 4);

    // Create Array<String> with capacity
    let mut result = Array::<String>::with_capacity(count);

    // Convert each CM string to a GC string
    for (let mut i = 0; i < count; i += 1) {
        let str_ptr = builtin::memory_load32(base_ptr + i * 8);
        let str_len = builtin::memory_load32(base_ptr + i * 8 + 4);

        // Create GC array and copy bytes from linear memory
        let arr = builtin::array_new::<u8>(str_len);
        for (let mut j = 0; j < str_len; j += 1) {
            let byte = builtin::memory_load8_u(str_ptr + j);
            builtin::array_set_u8(arr, j, byte);
        }

        result.append(String::internal_from_utf8_raw(arr, str_len));
    }

    return result;
}

/// Convert a Component Model option<string> to a GC Option<String>
/// The outptr points to the CM option representation in linear memory:
///   outptr[0..3]: discriminant (0 = none, 1 = some)
///   outptr[4..7]: str_ptr (if some)
///   outptr[8..11]: str_len (if some)
pub fn cm_option_string_to_option(outptr: i32) -> Option<String> {
    let discriminant = builtin::memory_load8_u(outptr);

    if discriminant == 0 {
        // None
        return null;
    }

    // Some - read string pointer and length
    let str_ptr = builtin::memory_load32(outptr + 4);
    let str_len = builtin::memory_load32(outptr + 8);

    // Create GC array and copy bytes from linear memory
    let arr = builtin::array_new::<u8>(str_len);
    for (let mut i = 0; i < str_len; i += 1) {
        let byte = builtin::memory_load8_u(str_ptr + i);
        builtin::array_set_u8(arr, i, byte);
    }

    return String::internal_from_utf8_raw(arr, str_len);
}

/// Convert a Component Model list<tuple<string, string>> to a GC Array<[String, String]>
/// The outptr points to the CM list representation in linear memory:
///   outptr[0..4]: base_ptr - pointer to array of tuples
///   outptr[4..8]: count - number of tuples
/// Each tuple is 16 bytes:
///   base_ptr[i*16+0..i*16+4]: str1_ptr
///   base_ptr[i*16+4..i*16+8]: str1_len
///   base_ptr[i*16+8..i*16+12]: str2_ptr
///   base_ptr[i*16+12..i*16+16]: str2_len
pub fn cm_list_tuple_string_string_to_array(outptr: i32) -> Array<[String, String]> {
    let base_ptr = builtin::memory_load32(outptr);
    let count = builtin::memory_load32(outptr + 4);

    // Create Array<[String, String]> with capacity
    let mut result = Array::<[String, String]>::with_capacity(count);

    // Convert each CM tuple to a GC tuple
    for (let mut i = 0; i < count; i += 1) {
        let tuple_offset = base_ptr + i * 16;

        // Read first string
        let str1_ptr = builtin::memory_load32(tuple_offset);
        let str1_len = builtin::memory_load32(tuple_offset + 4);
        let arr1 = builtin::array_new::<u8>(str1_len);
        for (let mut j = 0; j < str1_len; j += 1) {
            let byte = builtin::memory_load8_u(str1_ptr + j);
            builtin::array_set_u8(arr1, j, byte);
        }

        // Read second string
        let str2_ptr = builtin::memory_load32(tuple_offset + 8);
        let str2_len = builtin::memory_load32(tuple_offset + 12);
        let arr2 = builtin::array_new::<u8>(str2_len);
        for (let mut j = 0; j < str2_len; j += 1) {
            let byte = builtin::memory_load8_u(str2_ptr + j);
            builtin::array_set_u8(arr2, j, byte);
        }

        result.append([String::internal_from_utf8_raw(arr1, str1_len), String::internal_from_utf8_raw(arr2, str2_len)]);
    }

    return result;
}

