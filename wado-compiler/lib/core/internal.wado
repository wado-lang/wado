// Wado Core Internal Module
//
// This module provides internal functions used by the compiler for
// operations like template string interpolation. These functions are
// implemented in Wado itself rather than as inline Wasm instructions,
// making the codegen simpler and the compiler more maintainable.

// Box<T> wraps a value on the GC heap, enabling references to primitives.
// The lower phase generates Box<T> struct instances synthetically (not from this source).
// Do NOT define Box<T> here — the monomorphizer would create user-type instances
// in core:internal, conflicting with entry module types.

/// Copy bytes from linear memory to a new GC array
pub fn memory_to_gc_array(ptr: i32, len: i32) -> builtin::array<u8> {
    let arr = builtin::array_new::<u8>(len);
    for (let mut i = 0; i < len; i += 1) {
        builtin::array_set_u8(arr, i, builtin::memory_load8_u(ptr + i));
    }
    return arr;
}

/// Copy bytes from a GC array to linear memory
pub fn gc_array_to_memory(arr: builtin::array<u8>, ptr: i32, len: i32) {
    for (let mut i = 0; i < len; i += 1) {
        builtin::memory_store8(ptr + i, builtin::array_get_u8(arr, i));
    }
}

/// Write a string to a stream handle with an optional newline
/// Internal helper for log_stdout and log_stderr.
pub fn write_string_to_stream(tx: i32, message: String, add_newline: bool) {
    let len = message.len();
    let msg_bytes = message.internal_raw_bytes();
    let alloc_size = if add_newline { len + 1 } else { len };
    let ptr = builtin::realloc(0, 0, 1, alloc_size);
    gc_array_to_memory(msg_bytes, ptr, len);
    if add_newline {
        builtin::memory_store8(ptr + len, '\n');
    }
    builtin::stream_write(tx, ptr, alloc_size);

    // Free linear memory buffer
    builtin::realloc(ptr, alloc_size, 1, 0);

    builtin::stream_drop_writable(tx);
}

/// Wait for a pending async subtask to complete.
/// If the subtask is still pending (status bit 0 == 0), creates a waitable set,
/// joins the subtask, waits for completion, and drops the subtask handle.
pub fn effect_wait(subtask: i32) {
    if (subtask & 1) == 0 {
        let ws = builtin::waitable_set_new();
        builtin::waitable_join(ws, subtask);
        let ptr = builtin::realloc(0, 0, 4, 4);
        builtin::waitable_set_wait(ws, ptr);
        builtin::realloc(ptr, 4, 4, 0);
        builtin::subtask_drop(subtask);
    }
}

/// Best-effort logging to stdout (ambient, no effect required)
/// Writes message with newline to stdout. Waits for completion.
pub fn log_stdout(message: String) {
    let handles = builtin::stream_new();
    let rx = handles as i32;
    let tx = (handles >> 32) as i32;

    let subtask = builtin::call_indirect_stdout_write_via_stream(rx);
    write_string_to_stream(tx, message, true);
    effect_wait(subtask);
}

/// Best-effort logging to stderr (ambient, no effect required)
/// Writes message with newline to stderr. Waits for completion.
pub fn log_stderr(message: String) {
    let handles = builtin::stream_new();
    let rx = handles as i32;
    let tx = (handles >> 32) as i32;

    let subtask = builtin::call_indirect_stderr_write_via_stream(rx);
    write_string_to_stream(tx, message, true);
    effect_wait(subtask);
}

/// Convert a Component Model list<string> to a GC Array<String>
/// The outptr points to the CM list representation in linear memory:
///   outptr[0..4]: base_ptr - pointer to array of (ptr, len) pairs
///   outptr[4..8]: count - number of strings
/// Each string in the array is represented as:
///   base_ptr[i*8+0..i*8+4]: str_ptr - pointer to UTF-8 bytes
///   base_ptr[i*8+4..i*8+8]: str_len - length in bytes
pub fn cm_list_string_to_array(outptr: i32) -> Array<String> {
    let base_ptr = builtin::memory_load32(outptr);
    let count = builtin::memory_load32(outptr + 4);

    // Create Array<String> with capacity
    let mut result = Array::<String>::with_capacity(count);

    // Convert each CM string to a GC string
    for (let mut i = 0; i < count; i += 1) {
        let str_ptr = builtin::memory_load32(base_ptr + i * 8);
        let str_len = builtin::memory_load32(base_ptr + i * 8 + 4);

        let arr = memory_to_gc_array(str_ptr, str_len);

        result.append(String::internal_from_utf8_raw(arr, str_len));
    }

    return result;
}

/// Convert a Component Model option<string> to a GC Option<String>
/// The outptr points to the CM option representation in linear memory:
///   outptr[0..3]: discriminant (0 = none, 1 = some)
///   outptr[4..7]: str_ptr (if some)
///   outptr[8..11]: str_len (if some)
pub fn cm_option_string_to_option(outptr: i32) -> Option<String> {
    let discriminant = builtin::memory_load8_u(outptr);

    if discriminant == 0 {
        // None
        return null;
    }

    // Some - read string pointer and length
    let str_ptr = builtin::memory_load32(outptr + 4);
    let str_len = builtin::memory_load32(outptr + 8);
    let arr = memory_to_gc_array(str_ptr, str_len);

    return String::internal_from_utf8_raw(arr, str_len);
}

/// Convert a Component Model option<own<resource>> to a GC Option<i32>
/// The outptr points to the CM option representation in linear memory:
///   outptr[0]: discriminant (0 = none, 1 = some)
///   outptr[4..7]: handle (i32, if some)
pub fn cm_option_own_resource_to_option(outptr: i32) -> Option<i32> {
    let discriminant = builtin::memory_load8_u(outptr);

    if discriminant == 0 {
        return null;
    }

    let handle = builtin::memory_load32(outptr + 4);
    return Option::<i32>::Some(handle);
}
pub fn panic(message: String) -> ! {
    log_stderr(message);
    builtin::unreachable();
}

pub fn unreachable() -> ! {
    builtin::unreachable();
}

/// Lower a GC String to CM linear memory representation.
/// Returns (ptr | (len << 32)) as i64.
/// The caller must free the allocated memory after the CM call.
pub fn cm_lower_string(s: String) -> i64 {
    let len = s.len();
    let bytes = s.internal_raw_bytes();
    let ptr = builtin::realloc(0, 0, 1, len);
    gc_array_to_memory(bytes, ptr, len);
    return (ptr as i64) | ((len as i64) << 32);
}

/// Lower a GC Array<u8> to CM linear memory representation.
/// Returns (ptr | (len << 32)) as i64.
/// The caller must free the allocated memory after the CM call.
pub fn cm_lower_list_u8(data: builtin::array<u8>, len: i32) -> i64 {
    let ptr = builtin::realloc(0, 0, 1, len);
    gc_array_to_memory(data, ptr, len);
    return (ptr as i64) | ((len as i64) << 32);
}

/// Lower a GC Array<u8> (e.g., FieldValue) to CM linear memory representation.
/// Returns (ptr | (len << 32)) as i64.
pub fn cm_lower_array_u8(arr: Array<u8>) -> i64 {
    let data = arr.internal_raw_data();
    let len = arr.len();
    return cm_lower_list_u8(data, len);
}

/// Convert a Component Model list<tuple<string, string>> to a GC Array<[String, String]>
/// The outptr points to the CM list representation in linear memory:
///   outptr[0..4]: base_ptr - pointer to array of tuples
///   outptr[4..8]: count - number of tuples
/// Each tuple is 16 bytes:
///   base_ptr[i*16+0..i*16+4]: str1_ptr
///   base_ptr[i*16+4..i*16+8]: str1_len
///   base_ptr[i*16+8..i*16+12]: str2_ptr
///   base_ptr[i*16+12..i*16+16]: str2_len
pub fn cm_list_tuple_string_string_to_array(outptr: i32) -> Array<[String, String]> {
    let base_ptr = builtin::memory_load32(outptr);
    let count = builtin::memory_load32(outptr + 4);

    // Create Array<[String, String]> with capacity
    let mut result = Array::<[String, String]>::with_capacity(count);

    // Convert each CM tuple to a GC tuple
    for (let mut i = 0; i < count; i += 1) {
        let tuple_offset = base_ptr + i * 16;

        // Read first string
        let str1_ptr = builtin::memory_load32(tuple_offset);
        let str1_len = builtin::memory_load32(tuple_offset + 4);
        let arr1 = memory_to_gc_array(str1_ptr, str1_len);

        // Read second string
        let str2_ptr = builtin::memory_load32(tuple_offset + 8);
        let str2_len = builtin::memory_load32(tuple_offset + 12);
        let arr2 = memory_to_gc_array(str2_ptr, str2_len);

        result.append([String::internal_from_utf8_raw(arr1, str1_len), String::internal_from_utf8_raw(arr2, str2_len)]);
    }

    return result;
}

