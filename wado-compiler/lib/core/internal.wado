// Wado Core Internal Module
//
// This module provides internal functions used by the compiler for
// operations like template string interpolation. These functions are
// implemented in Wado itself rather than as inline Wasm instructions,
// making the codegen simpler and the compiler more maintainable.

// Box<T> wraps a value on the GC heap, enabling references to primitives.
// The lower phase generates Box<T> struct instances synthetically (not from this source).
// Do NOT define Box<T> here — the monomorphizer would create user-type instances
// in core:internal, conflicting with entry module types.

/// Bump allocator heap pointer. Starts at byte 1024 (leaving space for stack).
global mut __heap_offset: i32 = 1024;

/// Allocates or reallocates memory in linear memory.
/// This bump allocator simply advances a pointer with alignment.
/// The #[allocator("bump")] attribute marks this as the active allocator
/// implementation. The compiler compiles it into the memory module.
#[allocator("bump")]
pub export fn realloc(oldptr: i32, oldsize: i32, align: i32, newsize: i32) -> i32 {
    let aligned = builtin::i32_and(__heap_offset + align - 1, 0 - align);
    __heap_offset = aligned + newsize;
    return aligned;
}

/// Copies bytes from linear memory to a new GC array.
pub fn memory_to_gc_array(ptr: i32, len: i32) -> builtin::array<u8> {
    let arr = builtin::array_new::<u8>(len);
    for let mut i = 0; i < len; i += 1 {
        builtin::array_set_u8(arr, i, builtin::i32_load8_u(ptr + i) as u8);
    }
    return arr;
}

/// Copies bytes from linear memory to a new GC String.
pub fn memory_to_gc_string(ptr: i32, len: i32) -> String {
    let arr = memory_to_gc_array(ptr, len);
    return String::internal_from_utf8_raw(arr, len);
}

/// Copies bytes from a GC array to linear memory.
pub fn gc_array_to_memory(arr: builtin::array<u8>, ptr: i32, len: i32) {
    for let mut i = 0; i < len; i += 1 {
        builtin::i32_store8(ptr + i, builtin::array_get_u8(arr, i));
    }
}

/// Writes a string to a stream handle with an optional newline.
/// Internal helper for log_stdout and log_stderr.
pub fn write_string_to_stream(tx: i32, message: String, add_newline: bool) {
    let len = message.len();
    let msg_bytes = message.internal_raw_bytes();
    let alloc_size = if add_newline { len + 1 } else { len };
    let ptr = builtin::realloc(0, 0, 1, alloc_size);
    gc_array_to_memory(msg_bytes, ptr, len);
    if add_newline {
        builtin::i32_store8(ptr + len, '\n');
    }
    builtin::stream_write(tx, ptr, alloc_size);

    // Free linear memory buffer
    builtin::realloc(ptr, alloc_size, 1, 0);

    builtin::stream_drop_writable(tx);
}

/// Waits for a pending async subtask to complete.
/// In WASI P3 async calling convention, canon lower async returns (handle << 4) | status:
///   status = 0 (Starting): async guest task in flight, handle is nonzero
///   status = 1 (Started):  async host task in flight, handle is nonzero
///   status = 2 (Returned): sync completion, packed value = 2, handle = 0
/// If the upper 28 bits (handle) are nonzero, an async task is in flight.
pub fn wait_for_subtask(packed: i32) {
    let handle = packed >> 4;
    if handle != 0 {
        let ws = builtin::waitable_set_new();
        builtin::waitable_join(handle, ws);
        let ptr = builtin::realloc(0, 0, 4, 8);
        builtin::waitable_set_wait(ws, ptr);
        builtin::realloc(ptr, 8, 4, 0);
        builtin::subtask_drop(handle);
    }
}

/// Logs a message with newline to stdout (ambient, no effect required).
/// Waits for completion.
pub fn log_stdout(message: String) {
    let handles = builtin::stream_new();
    let rx = handles as i32;
    let tx = (handles >> 32) as i32;

    let subtask = builtin::call_indirect_stdout_write_via_stream(rx);
    write_string_to_stream(tx, message, true);
    wait_for_subtask(subtask);
}

/// Logs a message with newline to stderr (ambient, no effect required).
/// Waits for completion.
pub fn log_stderr(message: String) {
    let handles = builtin::stream_new();
    let rx = handles as i32;
    let tx = (handles >> 32) as i32;

    let subtask = builtin::call_indirect_stderr_write_via_stream(rx);
    write_string_to_stream(tx, message, true);
    wait_for_subtask(subtask);
}

/// Logs a message to stderr and traps.
pub fn panic(message: String) -> ! {
    log_stderr(message);
    builtin::unreachable();
}

/// Traps unconditionally, marking unreachable code.
pub fn unreachable() -> ! {
    builtin::unreachable();
}

/// Lowers a GC String to CM linear memory representation.
/// Returns (ptr | (len << 32)) as i64.
/// The caller must free the allocated memory after the CM call.
pub fn cm_lower_string(s: String) -> i64 {
    let len = s.len();
    let bytes = s.internal_raw_bytes();
    let ptr = builtin::realloc(0, 0, 1, len);
    gc_array_to_memory(bytes, ptr, len);
    return ptr as i64 | len as i64 << 32;
}

/// Lowers a GC Array<u8> to CM linear memory representation.
/// Returns (ptr | (len << 32)) as i64.
/// The caller must free the allocated memory after the CM call.
pub fn cm_lower_list_u8(data: builtin::array<u8>, len: i32) -> i64 {
    let ptr = builtin::realloc(0, 0, 1, len);
    gc_array_to_memory(data, ptr, len);
    return ptr as i64 | len as i64 << 32;
}

/// Lowers a GC Array<u8> (e.g., FieldValue) to CM linear memory representation.
/// Returns (ptr | (len << 32)) as i64.
pub fn cm_lower_array_u8(arr: Array<u8>) -> i64 {
    let data = arr.internal_raw_data();
    let len = arr.len();
    return cm_lower_list_u8(data, len);
}

/// Writes escaped string content to a Formatter (for inspect/debug output).
/// Escapes: " → \", \ → \\, \n → \n, \t → \t, \r → \r.
/// Does NOT write the surrounding quotes — caller is responsible for those.
pub fn write_escaped_string(s: String, f: &mut Formatter) {
    for let c of s.chars() {
        match c {
            '"' => f.write_str("\\\""),
            '\\' => f.write_str("\\\\"),
            '\n' => f.write_str("\\n"),
            '\t' => f.write_str("\\t"),
            '\r' => f.write_str("\\r"),
            _ => f.write_char(c),
        };
    }
}
