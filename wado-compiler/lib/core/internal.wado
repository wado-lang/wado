// Wado Core Internal Module
//
// This module provides internal functions used by the compiler for
// operations like template string interpolation. These functions are
// implemented in Wado itself rather than as inline Wasm instructions,
// making the codegen simpler and the compiler more maintainable.

/// Copies bytes from linear memory to a new GC array.
pub fn memory_to_gc_array(ptr: i32, len: i32) -> builtin::array<u8> {
    let arr: builtin::array<u8> = builtin::array_new(len);
    for let mut i = 0; i < len; i += 1 {
        builtin::array_set_u8(arr, i, builtin::i32_load8_u(ptr + i) as u8);
    }
    return arr;
}

/// Copies bytes from linear memory to a new GC String.
pub fn memory_to_gc_string(ptr: i32, len: i32) -> String {
    let arr = memory_to_gc_array(ptr, len);
    return String::internal_from_utf8_raw(arr, len);
}

/// Copies bytes from a GC array to linear memory.
pub fn gc_array_to_memory(arr: builtin::array<u8>, ptr: i32, len: i32) {
    for let mut i = 0; i < len; i += 1 {
        builtin::i32_store8(ptr + i, builtin::array_get_u8(arr, i));
    }
}

/// Writes a string to a StreamWritable<u8> with an optional newline, then drops it.
/// Internal helper for log_stdout and log_stderr.
///
/// Uses write_raw to pass String's internal GC array directly to the stream,
/// avoiding the intermediate String → Array<u8> byte-by-byte copy.
pub fn write_string_to_stream(tx: StreamWritable<u8>, message: String, add_newline: bool) {
    let bytes = message.internal_raw_bytes();
    let len = message.len();
    if add_newline {
        let new_repr: builtin::array<u8> = builtin::array_new(len + 1);
        builtin::array_copy(new_repr, 0, bytes, 0, len);
        builtin::array_set_u8(new_repr, len, 10);
        tx.write_raw(new_repr, len + 1);
    } else {
        tx.write_raw(bytes, len);
    }
    tx.drop();
}

/// Waits for a pending async subtask to complete (reach RETURNED state).
/// In WASI P3 async calling convention, canon lower async returns (handle << 4) | status:
///   status = 0 (Starting): async guest task in flight, handle is nonzero
///   status = 1 (Started):  async host task in flight, handle is nonzero
///   status = 2 (Returned): sync completion, packed value = 2, handle = 0
/// If the upper 28 bits (handle) are nonzero, an async task is in flight.
/// A subtask transitions through Starting → Started → Returned. Each call to
/// waitable-set.wait delivers one transition, so we must loop until RETURNED.
pub fn wait_for_subtask(packed: i32) {
    let handle = packed >> 4;
    if handle != 0 {
        let subtask = handle as Subtask;
        let ws = WaitableSet::new();
        subtask.join(&ws);
        loop {
            let event = ws.wait();
            // payload == 2 means the subtask reached RETURNED state
            if event.payload == 2 {
                break;
            }
        }
        subtask.drop();
        ws.drop();
    }
}

/// Drop a write_via_stream Future handle to signal completion.
/// Uses CLI ErrorCode type for the Future parameterization.
use { ErrorCode as CliErrorCode } from "wasi:cli/types.wado";
pub fn drop_cli_write_future(future: Future<Result<(), CliErrorCode>>) {
    future.drop();
}

/// Logs a message with newline to stdout (ambient, no effect required).
/// Uses builtin::call_indirect_* to bypass the effect system — this is
/// intentional for logging/debugging which must work without effects.
pub fn log_stdout(message: String) {
    let [rx, tx] = Stream::<u8>::new();

    let future_handle = builtin::call_indirect_stdout_write_via_stream(rx as i32);
    write_string_to_stream(tx, message, true);
    drop_cli_write_future(future_handle as Future<Result<(), CliErrorCode>>);
}

/// Logs a message with newline to stderr (ambient, no effect required).
/// Uses builtin::call_indirect_* to bypass the effect system — this is
/// intentional for logging/debugging which must work without effects.
pub fn log_stderr(message: String) {
    let [rx, tx] = Stream::<u8>::new();

    let future_handle = builtin::call_indirect_stderr_write_via_stream(rx as i32);
    write_string_to_stream(tx, message, true);
    drop_cli_write_future(future_handle as Future<Result<(), CliErrorCode>>);
}

/// Logs a message to stderr and traps.
pub fn panic(message: String) -> ! {
    log_stderr(message);
    builtin::unreachable();
}

/// Traps unconditionally, marking unreachable code.
pub fn unreachable() -> ! {
    builtin::unreachable();
}

/// Lowers a GC String to CM linear memory representation.
/// Returns (ptr | (len << 32)) as i64.
/// The caller must free the allocated memory after the CM call.
pub fn cm_lower_string(s: String) -> i64 {
    let len = s.len();
    let bytes = s.internal_raw_bytes();
    let ptr = builtin::realloc(0, 0, 1, len);
    gc_array_to_memory(bytes, ptr, len);
    return ptr as i64 | len as i64 << 32;
}

/// Lowers a GC Array<u8> to CM linear memory representation.
/// Returns (ptr | (len << 32)) as i64.
/// The caller must free the allocated memory after the CM call.
pub fn cm_lower_list_u8(data: builtin::array<u8>, len: i32) -> i64 {
    let ptr = builtin::realloc(0, 0, 1, len);
    gc_array_to_memory(data, ptr, len);
    return ptr as i64 | len as i64 << 32;
}

/// Lowers a GC Array<u8> (e.g., FieldValue) to CM linear memory representation.
/// Returns (ptr | (len << 32)) as i64.
pub fn cm_lower_array_u8(arr: Array<u8>) -> i64 {
    let data = arr.internal_raw_data();
    let len = arr.len();
    return cm_lower_list_u8(data, len);
}

/// Writes escaped string content to a Formatter (for inspect/debug output).
/// Escapes: " → \", \ → \\, \n → \n, \t → \t, \r → \r.
/// Does NOT write the surrounding quotes — caller is responsible for those.
pub fn write_escaped_string(s: String, f: &mut Formatter) {
    for let c of s.chars() {
        match c {
            '"' => f.write_str("\\\""),
            '\\' => f.write_str("\\\\"),
            '\n' => f.write_str("\\n"),
            '\t' => f.write_str("\\t"),
            '\r' => f.write_str("\\r"),
            _ => f.write_char(c),
        }
    }
}

// === CM Resource Method Adapters ===
//
// These functions implement the Component Model ABI for resource operations.
// Synthesis rewrites #[cm("...")] method calls to call these adapters.

/// Waits for a BLOCKED stream/future handle to become ready.
/// When a canonical stream/future operation returns BLOCKED (0xFFFF_FFFF),
/// this creates a temporary WaitableSet, joins the handle, and waits.
/// Returns the event payload (same format as the original return value).
pub fn wait_for_blocked(handle: i32) -> i32 {
    let ws = builtin::waitable_set_new();
    builtin::waitable_join(handle, ws);
    let evt_ptr = builtin::realloc(0, 0, 4, 8);
    let code = builtin::waitable_set_wait(ws, evt_ptr);
    let payload = builtin::i32_load(evt_ptr + 4);
    let freed = builtin::realloc(evt_ptr, 8, 4, 0);
    builtin::waitable_set_drop(ws);
    return payload;
}

/// CM adapter for stream.read(max) on Stream<u8>.
/// Allocates linear memory, calls stream-read, handles BLOCKED,
/// lifts bytes to GC array, constructs Array<u8>.
pub fn cm_stream_read_u8(handle: i32, max: i32) -> Array<u8> {
    let ptr = builtin::realloc(0, 0, 1, max);
    let mut result = builtin::stream_read(handle, ptr, max);
    if result == -1 {
        result = wait_for_blocked(handle);
    }
    let count = result >> 4;
    let arr = memory_to_gc_array(ptr, count);
    let freed = builtin::realloc(ptr, max, 1, 0);
    return Array::internal_from_raw(arr, count);
}

/// CM adapter for stream.read(max) on Stream<T> where T is a CM record.
/// Allocates a linear memory buffer sized for max*element_size bytes,
/// calls stream-read, handles BLOCKED, and returns [ptr, count].
/// The caller must decode each record from the buffer.
pub fn cm_stream_read_raw(handle: i32, max: i32, element_size: i32, element_align: i32) -> [i32, i32] {
    let byte_count = max * element_size;
    let ptr = builtin::realloc(0, 0, element_align, byte_count);
    let mut result = builtin::stream_read(handle, ptr, max);
    if result == -1 {
        result = wait_for_blocked(handle);
    }
    let count = result >> 4;
    return [ptr, count];
}

/// Create a new empty Array<u8> with the given capacity.
/// Used by synthesized stream-read binding functions for non-u8 types.
/// The type parameter is monomorphized away during compilation.
pub fn array_new_empty(capacity: i32) -> Array<u8> {
    return Array::with_capacity(capacity);
}

/// Free a buffer previously allocated by cm_stream_read_raw.
pub fn cm_stream_read_raw_free(ptr: i32, byte_count: i32, element_align: i32) {
    let freed = builtin::realloc(ptr, byte_count, element_align, 0);
}

/// CM adapter for stream.write(data) on Stream<u8>.
/// Lowers Array<u8> to linear memory, calls stream-write, handles BLOCKED.
pub fn cm_stream_write_u8(handle: i32, data: Array<u8>) {
    let packed = cm_lower_array_u8(data);
    let ptr = packed as i32;
    let len = (packed >> 32) as i32;
    let result = builtin::stream_write(handle, ptr, len);
    if result == -1 {
        let payload = wait_for_blocked(handle);
    }
    let freed = builtin::realloc(ptr, len, 1, 0);
}

/// CM adapter for stream.write_raw(data, len) on Stream<u8>.
/// Lowers raw GC array to linear memory, calls stream-write, handles BLOCKED.
pub fn cm_stream_write_raw_u8(handle: i32, data: builtin::array<u8>, len: i32) {
    let packed = cm_lower_list_u8(data, len);
    let ptr = packed as i32;
    let raw_len = (packed >> 32) as i32;
    let result = builtin::stream_write(handle, ptr, raw_len);
    if result == -1 {
        let payload = wait_for_blocked(handle);
    }
    let freed = builtin::realloc(ptr, raw_len, 1, 0);
}

/// CM adapter for ErrorContext::new(msg).
/// Lowers String to linear memory, calls error-context-new, frees buffer.
pub fn cm_error_context_new(msg: String) -> i32 {
    let packed = cm_lower_string(msg);
    let ptr = packed as i32;
    let len = (packed >> 32) as i32;
    let handle = builtin::error_context_new(ptr, len);
    let freed = builtin::realloc(ptr, len, 1, 0);
    return handle;
}

/// CM adapter for error_context.debug_message().
/// Calls error-context-debug-message, lifts result from linear memory to String.
pub fn cm_error_context_debug_message(handle: i32) -> String {
    let out_ptr = builtin::realloc(0, 0, 4, 8);
    builtin::error_context_debug_message(handle, out_ptr);
    let ptr = builtin::i32_load(out_ptr);
    let len = builtin::i32_load(out_ptr + 4);
    let freed_out = builtin::realloc(out_ptr, 8, 4, 0);
    let result = memory_to_gc_string(ptr, len);
    let freed_data = builtin::realloc(ptr, len, 1, 0);
    return result;
}

/// CM adapter for waitable_set.wait().
/// Allocates output buffer, calls waitable-set-wait, constructs WaitEvent.
pub fn cm_waitable_set_wait(ws: i32) -> WaitEvent {
    let out_ptr = builtin::realloc(0, 0, 4, 8);
    let code = builtin::waitable_set_wait(ws, out_ptr);
    let evt_handle = builtin::i32_load(out_ptr);
    let payload = builtin::i32_load(out_ptr + 4);
    let freed = builtin::realloc(out_ptr, 8, 4, 0);
    return WaitEvent { code, handle: evt_handle as Waitable, payload: payload as u32 };
}

pub fn cm_waitable_join(handle: i32, ws: i32) -> i32 {
    builtin::waitable_join(handle, ws);
    return handle;
}

pub fn cm_waitable_set_poll(ws: i32) -> Option<WaitEvent> {
    let out_ptr = builtin::realloc(0, 0, 4, 8);
    let code = builtin::waitable_set_poll(ws, out_ptr);
    if code == 0 {
        let freed = builtin::realloc(out_ptr, 8, 4, 0);
        return null;
    }
    let evt_handle = builtin::i32_load(out_ptr);
    let payload = builtin::i32_load(out_ptr + 4);
    let freed = builtin::realloc(out_ptr, 8, 4, 0);
    return Option::Some(WaitEvent { code, handle: evt_handle as Waitable, payload: payload as u32 });
}
