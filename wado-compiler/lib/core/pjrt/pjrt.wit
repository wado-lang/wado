package core:pjrt@0.1.0;

/// A device behind a PJRT plugin, the only public way to run a program on a
/// TPU. It mirrors the calls of PJRT's C API a program needs. A plugin compiles
/// StableHLO, so nothing here says what a tensor means.
interface pjrt-host {
    /// What a buffer's elements are.
    enum element-type {
        pred,
        int8,
        int16,
        int32,
        int64,
        uint8,
        uint16,
        uint32,
        uint64,
        float16,
        bfloat16,
        float32,
        float64,
    }

    /// A tensor on the device.
    resource buffer {
        /// The elements, little-endian, in row-major order.
        to-host: func() -> result<list<u8>, string>;
    }

    /// A program compiled for this device.
    resource executable {
        /// Runs the program. An argument the program updates in place is
        /// donated to its result, and using such a buffer afterwards is an
        /// error, unless `kept` holds its index, which copies it instead.
        execute: func(arguments: list<borrow<buffer>>, kept: list<s64>) -> result<list<buffer>, string>;

        /// What the plugin reports of the compiled program.
        analysis: func() -> result<analysis, string>;
    }

    /// One figure of a plugin's cost model, such as TPU's `optimal_seconds`.
    record cost {
        name: string,
        value: f64,
    }

    /// The device memory a compiled program needs, and what it costs to run.
    record analysis {
        argument-bytes: s64,
        output-bytes: s64,
        /// How much of the arguments the outputs reuse.
        alias-bytes: s64,
        temporary-bytes: s64,
        costs: list<cost>,
    }

    /// The plugin's name for its platform, such as `cpu` or `tpu`.
    platform: func() -> string;

    /// Compiles a StableHLO module, in MLIR's text form.
    compile: func(module: string) -> result<executable, string>;

    /// Compiles a StableHLO module for `topology`, such as `v5e:1x1`, which
    /// needs no device: what the plugin reports of it. A plugin that runs no
    /// program here may still compile for a device it names.
    analyzed: func(module: string, topology: string) -> result<analysis, string>;

    /// A buffer of the `elements` given little-endian, in row-major order.
    upload: func(
        element: element-type,
        extents: list<s64>,
        elements: list<u8>,
    ) -> result<buffer, string>;
}
