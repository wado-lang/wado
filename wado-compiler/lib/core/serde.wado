impl<T: Deserialize> Deserialize for Option<T> {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<Option<T>, DeserializeError> {
        let null_check = d.is_null();
        if let Ok(is_null) = null_check {
            if is_null {
                return Result::<Option<T>, DeserializeError>::Ok(null);
            }
            let inner = T::deserialize::<D>(d);
            if let Ok(v) = inner {
                return Result::<Option<T>, DeserializeError>::Ok(Option::<T>::Some(v));
            }
            if let Err(e) = inner {
                return Result::<Option<T>, DeserializeError>::Err(e);
            }
        }
        if let Err(e) = null_check {
            return Result::<Option<T>, DeserializeError>::Err(e);
        }
        unreachable();
    }
}

impl<T: Deserialize> Deserialize for Array<T> {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<Array<T>, DeserializeError> {
        let seq_result = d.begin_seq();
        if let Ok(mut seq) = seq_result {
            let mut items: Array<T> = [];
            loop {
                let next = seq.next_element::<T>();
                if let Ok(opt) = next {
                    if let Some(item) = opt {
                        items.append(item);
                    } else {
                        let end_result = seq.end();
                        if let Err(e) = end_result {
                            return Result::<Array<T>, DeserializeError>::Err(e);
                        }
                        return Result::<Array<T>, DeserializeError>::Ok(items);
                    }
                }
                if let Err(e) = next {
                    return Result::<Array<T>, DeserializeError>::Err(e);
                }
            }
        }
        if let Err(e) = seq_result {
            return Result::<Array<T>, DeserializeError>::Err(e);
        }
        unreachable();
    }
}

impl<T: Deserialize, E: Deserialize> Deserialize for Result<T, E> {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<Result<T, E>, DeserializeError> {
        let va_r = d.begin_variant(&"Result", 2);
        if let Ok(mut va) = va_r {
            let name_r = va.variant_name();
            if let Ok(name) = name_r {
                if name == "Ok" {
                    let val_r = va.payload::<T>();
                    if let Ok(val) = val_r {
                        let end_r = va.end();
                        if let Err(e) = end_r {
                            return Result::<Result<T, E>, DeserializeError>::Err(e);
                        }
                        return Result::<Result<T, E>, DeserializeError>::Ok(Result::<T, E>::Ok(val));
                    }
                    if let Err(e) = val_r {
                        return Result::<Result<T, E>, DeserializeError>::Err(e);
                    }
                }
                if name == "Err" {
                    let val_r = va.payload::<E>();
                    if let Ok(val) = val_r {
                        let end_r = va.end();
                        if let Err(e) = end_r {
                            return Result::<Result<T, E>, DeserializeError>::Err(e);
                        }
                        return Result::<Result<T, E>, DeserializeError>::Ok(Result::<T, E>::Err(val));
                    }
                    if let Err(e) = val_r {
                        return Result::<Result<T, E>, DeserializeError>::Err(e);
                    }
                }
                return Result::<Result<T, E>, DeserializeError>::Err(
                    DeserializeError { kind: DeserializeErrorKind::UnknownVariant, message: `unknown Result variant: {name}`, offset: -1 as i64 }
                );
            }
            if let Err(e) = name_r {
                return Result::<Result<T, E>, DeserializeError>::Err(e);
            }
        }
        if let Err(e) = va_r {
            return Result::<Result<T, E>, DeserializeError>::Err(e);
        }
        unreachable();
    }
}

impl<T: Serialize, V: Serialize> Serialize for TreeMap<String, V> {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let entries = self.entries();
        let map_r = s.begin_map(entries.len());
        if let Ok(mut m) = map_r {
            for let entry of entries {
                let k = entry.0;
                let v = entry.1;
                let kr = m.key::<String>(&k);
                if let Err(e) = kr {
                    return Result::<(), SerializeError>::Err(e);
                }
                let vr = m.value::<V>(&v);
                if let Err(e) = vr {
                    return Result::<(), SerializeError>::Err(e);
                }
            }
            return m.end();
        }
        if let Err(e) = map_r {
            return Result::<(), SerializeError>::Err(e);
        }
        unreachable();
    }
}

impl<V: Deserialize> Deserialize for TreeMap<String, V> {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<TreeMap<String, V>, DeserializeError> {
        let map_r = d.begin_map();
        if let Ok(mut ma) = map_r {
            let mut result = TreeMap::<String, V>::new();
            loop {
                let key_r = ma.next_key_string();
                if let Ok(key_opt) = key_r {
                    if let Some(key) = key_opt {
                        let val_r = ma.next_value::<V>();
                        if let Ok(val) = val_r {
                            result.insert(key, val);
                        }
                        if let Err(e) = val_r {
                            return Result::<TreeMap<String, V>, DeserializeError>::Err(e);
                        }
                    } else {
                        let end_r = ma.end();
                        if let Err(e) = end_r {
                            return Result::<TreeMap<String, V>, DeserializeError>::Err(e);
                        }
                        return Result::<TreeMap<String, V>, DeserializeError>::Ok(result);
                    }
                }
                if let Err(e) = key_r {
                    return Result::<TreeMap<String, V>, DeserializeError>::Err(e);
                }
            }
        }
        if let Err(e) = map_r {
            return Result::<TreeMap<String, V>, DeserializeError>::Err(e);
        }
        unreachable();
    }
}
