#![stdlib("core:serde")]
//! Serialization and deserialization framework.
//!
//! Provides format-agnostic `Serialize` and `Deserialize` traits with a 17-method
//! data model optimized for JSON and CBOR. Format implementations (e.g., `core:json`)
//! implement `Serializer` and `Deserializer` to support specific wire formats.
//!
//! ```wado
//! use { Serialize, Deserialize, SerializeError, DeserializeError } from "core:serde";
//! ```
//!
//! ## Deriving `Serialize` / `Deserialize`
//!
//! `impl Serialize for T;` / `impl Deserialize for T;` (empty body — the
//! compiler fills it in) is optional: a `T: Serialize` bound is satisfied
//! structurally once every field or case of `T` implements the trait — how
//! an anonymous struct, which has no name for a marker, becomes serializable.
//! Write the marker to force the impl with no bound present, or alongside
//! `#[wire(...)]` customization.
//!
//! ```wado
//! struct Point { x: i32, y: i32 }               // no marker needed
//! let json = to_string(&Point { x: 1, y: 2 });  // Ok("{\"x\":1,\"y\":2}")
//! ```
//!
//! ## Field naming on the wire
//!
//! By default the wire-form key is the Wado source field name verbatim
//! (identity): `user_name` stays `"user_name"`, `userId` stays `"userId"`.
//! The field name as written is the single source of truth. Override per
//! struct with `#[wire(name_policy = "...")]`, or per field with
//! `#[wire(name = "...")]` (which takes precedence).
//!
//! `name_policy` strategies: `"camelCase"`, `"snake_case"`, `"PascalCase"`,
//! `"SCREAMING_SNAKE_CASE"`, `"kebab-case"`, `"SCREAMING-KEBAB-CASE"`.
//!
//! The same `name` / `name_policy` overrides apply to `enum` and `variant`
//! case names (default: the `PascalCase` name verbatim), e.g.
//! `#[wire(name_policy = "kebab-case")]` makes `AddRemote` serialize as
//! `"add-remote"`.
//!
//! ```wado
//! // Default — wire keys are the field names as written
//! struct User {
//!     user_name: String,        // wire key: "user_name"
//!     account_id: i64,          // wire key: "account_id"
//! }
//!
//! // Per-struct convention (e.g. camelCase for a JS-facing API)
//! #[wire(name_policy = "camelCase")]
//! struct Event {
//!     created_at: String,       // wire key: "createdAt"
//!     event_type: String,       // wire key: "eventType"
//! }
//!
//! // Per-field override (wins over name_policy)
//! #[wire(name_policy = "kebab-case")]
//! struct Header {
//!     content_type: String,     // wire key: "content-type"
//!     #[wire(name = "X-Trace-Id")]
//!     trace_id: String,         // wire key: "X-Trace-Id"
//! }
//! ```
//!
//! ## Missing fields on deserialization
//!
//! A missing required field produces `DeserializeError` with kind
//! `MissingField`. A field with a default value (`f: T = expr`) is optional:
//! when absent it falls back to that expression. This is the single mechanism
//! for an optional field — for a zero-value fallback, write the zero literal
//! (`= 0`, `= ""`, `= false`, `= []`, `= null`).
//!
//! ```wado
//! struct Config {
//!     host: String,             // required - error if missing
//!     port: i32 = 0,            // missing -> 0
//!     timeout: i32 = 30,        // missing -> 30
//! }
//! impl Deserialize for Config;
//!
//! // {"host":"localhost"}
//! //   -> Config { host: "localhost", port: 0, timeout: 30 }
//! ```


#[compiler_item("serialize_error_kind")]
pub enum SerializeErrorKind {
    UnsupportedValue,
    #[compiler_item("serialize_error_kind_custom")]
    Custom,
}

#[compiler_item("serialize_error")]
pub struct SerializeError {
    pub kind: SerializeErrorKind,
    pub message: String,
}

#[compiler_item("deserialize_error_kind")]
pub enum DeserializeErrorKind {
    UnexpectedType,
    #[compiler_item("deserialize_error_kind_missing_field")]
    MissingField,
    #[compiler_item("deserialize_error_kind_unknown_variant")]
    UnknownVariant,
    DuplicateField,
    #[compiler_item("deserialize_error_kind_invalid_value")]
    InvalidValue,
    Overflow,
    MalformedInput,
    TrailingData,
    Eof,
    Custom,
}

#[compiler_item("deserialize_error")]
pub struct DeserializeError {
    pub kind: DeserializeErrorKind,
    pub message: String,
    pub offset: i64,
}

impl DeserializeError {
    pub fn unexpected_type(msg: String, offset: i64) -> DeserializeError {
        return DeserializeError { kind: DeserializeErrorKind::UnexpectedType, message: msg, offset };
    }

    pub fn missing_field(name: String) -> DeserializeError {
        return DeserializeError { kind: DeserializeErrorKind::MissingField, message: name, offset: -1 };
    }

    pub fn invalid_value(msg: String, offset: i64) -> DeserializeError {
        return DeserializeError { kind: DeserializeErrorKind::InvalidValue, message: msg, offset };
    }

    pub fn malformed(msg: String, offset: i64) -> DeserializeError {
        return DeserializeError { kind: DeserializeErrorKind::MalformedInput, message: msg, offset };
    }

    pub fn eof(offset: i64) -> DeserializeError {
        return DeserializeError { kind: DeserializeErrorKind::Eof, message: "unexpected end of input", offset };
    }

    pub fn trailing(offset: i64) -> DeserializeError {
        return DeserializeError {
            kind: DeserializeErrorKind::TrailingData,
            message: "trailing data after value",
            offset,
        };
    }

    pub fn overflow(msg: String, offset: i64) -> DeserializeError {
        return DeserializeError { kind: DeserializeErrorKind::Overflow, message: msg, offset };
    }
}

#[compiler_item("serialize_seq")]
pub trait SerializeSeq {


    #[compiler_item("serialize_seq_element")]
    fn element<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError>;


    #[compiler_item("serialize_seq_end")]
    fn end(&mut self) -> Result<(), SerializeError>;
}

pub trait SerializeMap {
    fn key<T: Serialize>(&mut self, key: &T) -> Result<(), SerializeError>;
    fn value<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError>;
    fn end(&mut self) -> Result<(), SerializeError>;
}

#[compiler_item("serialize_struct")]
pub trait SerializeStruct {


    #[compiler_item("serialize_struct_field")]
    fn field<T: Serialize>(&mut self, name: &String, value: &T) -> Result<(), SerializeError>;


    #[compiler_item("serialize_struct_end")]
    fn end(&mut self) -> Result<(), SerializeError>;
}

#[compiler_item("serialize_variant")]
pub trait SerializeVariant {


    #[compiler_item("serialize_variant_payload")]
    fn payload<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError>;


    #[compiler_item("serialize_variant_end")]
    fn end(&mut self) -> Result<(), SerializeError>;
}


#[compiler_item("serializer")]
pub trait Serializer {
    type SeqSerializer: SerializeSeq;
    type MapSerializer: SerializeMap;
    type StructSerializer: SerializeStruct;
    type VariantSerializer: SerializeVariant;

    fn serialize_i32(&mut self, v: i32) -> Result<(), SerializeError>;
    fn serialize_i64(&mut self, v: i64) -> Result<(), SerializeError>;
    fn serialize_u32(&mut self, v: u32) -> Result<(), SerializeError>;
    fn serialize_u64(&mut self, v: u64) -> Result<(), SerializeError>;
    fn serialize_i128(&mut self, v: i128) -> Result<(), SerializeError>;
    fn serialize_u128(&mut self, v: u128) -> Result<(), SerializeError>;
    fn serialize_f32(&mut self, v: f32) -> Result<(), SerializeError>;
    fn serialize_f64(&mut self, v: f64) -> Result<(), SerializeError>;
    fn serialize_bool(&mut self, v: bool) -> Result<(), SerializeError>;
    fn serialize_char(&mut self, v: char) -> Result<(), SerializeError>;
    fn serialize_string(&mut self, v: &String) -> Result<(), SerializeError>;
    /// Tag the next value with a CBOR semantic tag (major type 6, RFC 8949
    /// §3.4). Formats with no tag concept ignore it; the default no-op means
    /// only tag-aware serializers (CBOR) need to implement it.
    fn serialize_tag(&mut self, _tag: u64) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
    /// Serialize a byte string. Self-describing binary formats (CBOR) emit a
    /// native byte string; JSON emits base64. The default falls back to a
    /// sequence of `u8` (the historical `List<u8>` behaviour), so a format
    /// with no distinct byte-string form keeps working unchanged.
    fn serialize_bytes(&mut self, v: ByteSlice) -> Result<(), SerializeError> {
        let mut seq = self.begin_seq(v.len())?;
        let mut i = 0;
        while i < v.len() {
            let b = v[i];
            seq.element(&b)?;
            i += 1;
        }
        return seq.end();
    }
    fn serialize_null(&mut self) -> Result<(), SerializeError>;


    #[compiler_item("serializer_begin_seq")]
    fn begin_seq(&mut self, len: i32) -> Result<Self::SeqSerializer, SerializeError> with stores[self];
    fn begin_map(&mut self, len: i32) -> Result<Self::MapSerializer, SerializeError> with stores[self];


    #[compiler_item("serializer_begin_struct")]
    fn begin_struct(
        &mut self,
        name: &String,
        fields: i32,
    ) -> Result<Self::StructSerializer, SerializeError> with stores[self];


    #[compiler_item("serializer_serialize_unit_variant")]
    fn serialize_unit_variant(
        &mut self,
        type_name: &String,
        variant_name: &String,
        disc: i32,
    ) -> Result<(), SerializeError>;


    #[compiler_item("serializer_begin_variant")]
    fn begin_variant(
        &mut self,
        type_name: &String,
        variant_name: &String,
        disc: i32,
    ) -> Result<Self::VariantSerializer, SerializeError> with stores[self];
}


#[compiler_item("serialize")]
pub trait Serialize {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError>;
}


#[compiler_item("deserialize_seq")]
pub trait DeserializeSeq {


    #[compiler_item("deserialize_seq_next_element")]
    fn next_element<T: Deserialize>(&mut self) -> Result<Option<T>, DeserializeError>;


    #[compiler_item("deserialize_seq_end")]
    fn end(&mut self) -> Result<(), DeserializeError>;
}

pub trait DeserializeMap {
    fn next_key_string(&mut self) -> Result<Option<String>, DeserializeError>;
    fn next_value<V: Deserialize>(&mut self) -> Result<V, DeserializeError>;
    fn end(&mut self) -> Result<(), DeserializeError>;
}

/// Static, per-type, format-agnostic field-name → index mapping.
///
/// The struct-deserialize synthesiser implements `FieldSchema` for every
/// deserializable struct, generating a `lookup` that byte-compares the wire
/// key against the wire-form field names. Self-describing formats invoke it
/// from `DeserializeStruct::next_field` with the key's bytes; non-self-describing
/// formats ignore the schema and stay positional.
///
/// The key is a borrowed byte view (`ArraySlice<u8>`, i.e. `ByteSlice`), not a
/// `String`: deserializer input is bytes (UTF-8 for JSON, a byte string for
/// CBOR), so a bytes key avoids a `String` round-trip and is shared identically
/// by every format.
///
/// `lookup` is a static method resolved at monomorphization, so the call is
/// direct and inlinable — no closure value, no per-decode allocation.
///
/// A field marked `#[wire(positional)]` is ordinal, not nominal: `lookup`
/// omits it (it is never matched by name) and `positional_at` enumerates the
/// positional fields in declaration order. Name-only and sequence-only formats
/// ignore `positional_at` and stay backward compatible; `core:args` consults it
/// to bind bare tokens to positional fields.
#[compiler_item("field_schema")]
pub trait FieldSchema {
    fn lookup(key: ByteSlice) -> Option<i32>;

    /// Field index of the `rank`-th `#[wire(positional)]` field (in
    /// declaration order), or `null` when `rank` is out of range. Returns
    /// `null` for every `rank` when the type has no positional fields.
    fn positional_at(rank: i32) -> Option<i32>;
}

#[compiler_item("deserialize_struct")]
pub trait DeserializeStruct {


    #[compiler_item("deserialize_struct_next_field")]
    fn next_field<S: FieldSchema>(&mut self) -> Result<Option<i32>, DeserializeError>;


    #[compiler_item("deserialize_struct_value")]
    fn value<T: Deserialize>(&mut self) -> Result<T, DeserializeError>;


    #[compiler_item("deserialize_struct_skip")]
    fn skip(&mut self) -> Result<(), DeserializeError>;


    #[compiler_item("deserialize_struct_end")]
    fn end(&mut self) -> Result<(), DeserializeError>;
}

#[compiler_item("deserialize_variant")]
pub trait DeserializeVariant {


    #[compiler_item("deserialize_variant_variant_name")]
    fn variant_name(&mut self) -> Result<String, DeserializeError>;


    #[compiler_item("deserialize_variant_disc")]
    fn disc(&mut self) -> Result<i32, DeserializeError>;


    #[compiler_item("deserialize_variant_payload")]
    fn payload<T: Deserialize>(&mut self) -> Result<T, DeserializeError>;
    fn is_unit(&mut self) -> Result<bool, DeserializeError>;


    #[compiler_item("deserialize_variant_end")]
    fn end(&mut self) -> Result<(), DeserializeError>;
}


pub trait Visitor {
    type Value;

    fn visit_null(&mut self) -> Result<Self::Value, DeserializeError>;
    fn visit_bool(&mut self, v: bool) -> Result<Self::Value, DeserializeError>;
    fn visit_f64(&mut self, v: f64) -> Result<Self::Value, DeserializeError>;
    /// Integer visits. Self-describing binary formats (CBOR) call these to
    /// preserve full integer precision; the defaults widen to `f64` so a
    /// visitor that only cares about JSON-style numbers keeps working.
    fn visit_i64(&mut self, v: i64) -> Result<Self::Value, DeserializeError> {
        return self.visit_f64(v as f64);
    }
    fn visit_u64(&mut self, v: u64) -> Result<Self::Value, DeserializeError> {
        return self.visit_f64(v as f64);
    }
    fn visit_i128(&mut self, v: i128) -> Result<Self::Value, DeserializeError> {
        return self.visit_f64(v as f64);
    }
    fn visit_u128(&mut self, v: u128) -> Result<Self::Value, DeserializeError> {
        return self.visit_f64(v as f64);
    }
    fn visit_string(&mut self, v: String) -> Result<Self::Value, DeserializeError>;
    /// Byte-string visit (CBOR major type 2; JSON base64). Defaults to an
    /// `UnexpectedType` error so text-only visitors are unaffected.
    fn visit_bytes(&mut self, _v: ByteList) -> Result<Self::Value, DeserializeError> {
        return Result::Err(DeserializeError::unexpected_type("unexpected byte string", -1));
    }
    fn visit_seq<A: DeserializeSeq>(&mut self, seq: &mut A) -> Result<Self::Value, DeserializeError>;
    fn visit_map<A: DeserializeMap>(&mut self, map: &mut A) -> Result<Self::Value, DeserializeError>;
    /// Opaque passthrough for a format item the value model cannot represent
    /// (e.g. an unassigned CBOR simple value or an uninterpreted tag). Only
    /// self-describing binary formats call this; defaults to an error.
    fn visit_unknown(&mut self, _raw: ByteList) -> Result<Self::Value, DeserializeError> {
        return Result::Err(DeserializeError::unexpected_type("unexpected opaque value", -1));
    }
    /// The CBOR `undefined` simple value (major 7, value 23). Distinct from
    /// `null`: a dynamic value model (`core:value`) keeps its own `Undefined`
    /// arm. The default collapses it to `null` so visitors that do not model
    /// the distinction (e.g. JSON) keep working.
    fn visit_undefined(&mut self) -> Result<Self::Value, DeserializeError> {
        return self.visit_null();
    }
}

#[compiler_item("deserializer")]
pub trait Deserializer {
    type SeqAccess: DeserializeSeq;
    type MapAccess: DeserializeMap;
    type StructAccess: DeserializeStruct;
    type VariantAccess: DeserializeVariant;

    fn deserialize_i32(&mut self) -> Result<i32, DeserializeError>;
    fn deserialize_i64(&mut self) -> Result<i64, DeserializeError>;
    fn deserialize_u32(&mut self) -> Result<u32, DeserializeError>;
    fn deserialize_u64(&mut self) -> Result<u64, DeserializeError>;
    fn deserialize_i128(&mut self) -> Result<i128, DeserializeError>;
    fn deserialize_u128(&mut self) -> Result<u128, DeserializeError>;
    fn deserialize_f32(&mut self) -> Result<f32, DeserializeError>;
    fn deserialize_f64(&mut self) -> Result<f64, DeserializeError>;
    fn deserialize_bool(&mut self) -> Result<bool, DeserializeError>;
    fn deserialize_char(&mut self) -> Result<char, DeserializeError>;
    fn deserialize_string(&mut self) -> Result<String, DeserializeError>;
    /// Deserialize a byte string. Self-describing binary formats read a native
    /// byte string; JSON reads base64. The default reads a sequence of `u8`.
    fn deserialize_bytes(&mut self) -> Result<ByteList, DeserializeError> {
        let mut seq = self.begin_seq()?;
        let mut out: ByteList = [];
        loop {
            let opt = seq.next_element()?;
            if let Some(b) = opt {
                out.push(b);
            } else {
                seq.end()?;
                return Result::Ok(out);
            }
        }
    }
    fn is_null(&mut self) -> Result<bool, DeserializeError>;


    #[compiler_item("deserializer_begin_seq")]
    fn begin_seq(&mut self) -> Result<Self::SeqAccess, DeserializeError> with stores[self];
    fn begin_map(&mut self) -> Result<Self::MapAccess, DeserializeError> with stores[self];


    #[compiler_item("deserializer_begin_struct")]
    fn begin_struct(
        &mut self,
        name: &String,
        num_fields: i32,
    ) -> Result<Self::StructAccess, DeserializeError> with stores[self];


    #[compiler_item("deserializer_begin_variant")]
    fn begin_variant(
        &mut self,
        type_name: &String,
        num_cases: i32,
    ) -> Result<Self::VariantAccess, DeserializeError> with stores[self];
    fn deserialize_any<V: Visitor>(&mut self, visitor: &mut V) -> Result<V::Value, DeserializeError>;
}


#[compiler_item("deserialize")]
pub trait Deserialize {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<Self, DeserializeError>;

    /// Deserialize the next element from a sequence access.
    /// Used by variadic tuple deserialization via type pack expansion.
    fn deserialize_next_element_from_seq<S: DeserializeSeq>(seq: &mut S) -> Result<Self, DeserializeError> {
        let opt = seq.next_element()?;
        if let Some(v) = opt {
            return Result::Ok(v);
        }
        return Result::Err(DeserializeError::eof(-1));
    }
}


impl Serialize for i8 {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_i32(*self as i32);
    }
}

impl Serialize for i16 {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_i32(*self as i32);
    }
}

impl Serialize for i32 {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_i32(*self);
    }
}

impl Serialize for i64 {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_i64(*self);
    }
}

impl Serialize for u8 {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_u32(*self as u32);
    }
}

impl Serialize for u16 {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_u32(*self as u32);
    }
}

impl Serialize for u32 {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_u32(*self);
    }
}

impl Serialize for u64 {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_u64(*self);
    }
}

impl Serialize for i128 {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_i128(*self);
    }
}

impl Serialize for u128 {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_u128(*self);
    }
}

impl Serialize for f32 {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_f32(*self);
    }
}

impl Serialize for f64 {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_f64(*self);
    }
}

impl Serialize for bool {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_bool(*self);
    }
}

impl Serialize for char {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_char(*self);
    }
}

impl Serialize for String {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_string(self);
    }
}

/// Writes null, which `Deserialize for ()` reads back. A unit variant case
/// carries `()` and so needs this impl to satisfy its payload-pack bound, but
/// never reaches it: the derived paths answer `is_unit()` and write a bare tag.
impl Serialize for () {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_null();
    }
}

impl<T: Serialize> Serialize for Option<T> {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        if let Some(v) = self {
            return v.serialize(s);
        }
        return s.serialize_null();
    }
}

impl<T: Serialize> Serialize for List<T> {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let mut seq = s.begin_seq(self.len())?;
        for let item of self {
            seq.element(item)?;
        }
        return seq.end();
    }
}

// Byte buffers serialize as a byte string (`serialize_bytes`), not as a
// sequence of integers. These explicit impls override the `List<u8>` /
// `Array<u8>` / `ArraySlice<u8>` sequence impls that the newtypes would
// otherwise inherit.
impl Serialize for ByteList {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_bytes(self.as_byte_slice());
    }
}

impl Serialize for ByteArray {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_bytes(self.as_byte_slice());
    }
}

impl Serialize for ByteSlice {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_bytes(self.as_byte_slice());
    }
}


impl<T: Serialize, E: Serialize> Serialize for Result<T, E> {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        match self {
            Ok(v) => {
                let mut var = s.begin_variant(&"Result", &"Ok", 0)?;
                var.payload(v)?;
                return var.end();
            },
            Err(v) => {
                let mut var = s.begin_variant(&"Result", &"Err", 1)?;
                var.payload(v)?;
                return var.end();
            },
        }
    }
}

impl Deserialize for i8 {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<i8, DeserializeError> {
        let v = d.deserialize_i32()?;
        if v < -128 || v > 127 {
            return Result::Err(DeserializeError::overflow("value out of range for i8", -1));
        }
        return Result::Ok(v as i8);
    }
}

impl Deserialize for i16 {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<i16, DeserializeError> {
        let v = d.deserialize_i32()?;
        if v < -32768 || v > 32767 {
            return Result::Err(
                DeserializeError::overflow("value out of range for i16", -1),
            );
        }
        return Result::Ok(v as i16);
    }
}

impl Deserialize for i32 {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<i32, DeserializeError> {
        return d.deserialize_i32();
    }
}

impl Deserialize for i64 {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<i64, DeserializeError> {
        return d.deserialize_i64();
    }
}

impl Deserialize for u8 {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<u8, DeserializeError> {
        let v = d.deserialize_u32()?;
        if v > 255 {
            return Result::Err(DeserializeError::overflow("value out of range for u8", -1));
        }
        return Result::Ok(v as u8);
    }
}

impl Deserialize for u16 {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<u16, DeserializeError> {
        let v = d.deserialize_u32()?;
        if v > 65535 {
            return Result::Err(
                DeserializeError::overflow("value out of range for u16", -1),
            );
        }
        return Result::Ok(v as u16);
    }
}

impl Deserialize for u32 {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<u32, DeserializeError> {
        return d.deserialize_u32();
    }
}

impl Deserialize for u64 {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<u64, DeserializeError> {
        return d.deserialize_u64();
    }
}

impl Deserialize for i128 {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<i128, DeserializeError> {
        return d.deserialize_i128();
    }
}

impl Deserialize for u128 {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<u128, DeserializeError> {
        return d.deserialize_u128();
    }
}

impl Deserialize for f32 {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<f32, DeserializeError> {
        return d.deserialize_f32();
    }
}

impl Deserialize for f64 {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<f64, DeserializeError> {
        return d.deserialize_f64();
    }
}

impl Deserialize for bool {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<bool, DeserializeError> {
        return d.deserialize_bool();
    }
}

impl Deserialize for char {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<char, DeserializeError> {
        return d.deserialize_char();
    }
}

impl Deserialize for String {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<String, DeserializeError> {
        return d.deserialize_string();
    }
}

impl<T: Deserialize> Deserialize for Option<T> {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<Option<T>, DeserializeError> {
        let is_null = d.is_null()?;
        if is_null {
            return Result::Ok(null);
        }
        let v = T::deserialize(d)?;
        return Result::Ok(Option::Some(v));
    }
}

impl<T: Deserialize> Deserialize for List<T> {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<List<T>, DeserializeError> {
        let mut seq = d.begin_seq()?;
        // Peek at the first element before allocating backing storage.
        // Empty arrays (very common in practice) avoid any capacity allocation.
        // Non-empty arrays start at capacity 4, covering 1–4 elements without a grow.
        let first_opt = seq.next_element()?;
        if let Some(first_elem) = first_opt {
            let mut items: List<T> = List::with_capacity(2);
            items.push(first_elem);
            loop {
                let next_opt = seq.next_element()?;
                if let Some(item) = next_opt {
                    items.push(item);
                } else {
                    seq.end()?;
                    return Result::Ok(items);
                }
            }
        } else {
            seq.end()?;
            return Result::Ok([] as List<T>);
        }
    }
}

// Byte buffer (owned, growable) deserializes from a byte string, overriding
// the inherited `List<u8>` sequence impl.
impl Deserialize for ByteList {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<ByteList, DeserializeError> {
        return d.deserialize_bytes();
    }
}

// Owned, fixed-length byte buffer. Deserializes from a byte string into an
// `Array<u8>` whose length is the decoded byte count (a fixed-length array's
// length is a runtime value, so there is no compile-time length to enforce).
impl Deserialize for ByteArray {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<ByteArray, DeserializeError> {
        let bytes = d.deserialize_bytes()?;
        return Result::Ok(bytes.as_slice().to_array() as ByteArray);
    }
}

impl<T: Deserialize, E: Deserialize> Deserialize for Result<T, E> {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<Result<T, E>, DeserializeError> {
        let mut va = d.begin_variant(&"Result", 2)?;
        let name = va.variant_name()?;
        if name == "Ok" {
            let val = va.payload()?;
            va.end()?;
            return Result::Ok(Result::Ok(val));
        } else if name == "Err" {
            let val = va.payload()?;
            va.end()?;
            return Result::Ok(Result::Err(val));
        }
        return Result::Err(DeserializeError {
            kind: DeserializeErrorKind::UnknownVariant,
            message: `unknown Result variant: ${name}`,
            offset: -1,
        });
    }
}

// ── Derivations over the reflection API (WEP 2026-06-13) ──

/// Struct serialization derived over `ReflectStruct`: walk the field members,
/// writing each field under its resolved wire name.
impl<T: ReflectStruct<FieldTypes = [..F]>, ..F: Serialize> Serialize for T {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let members = ReflectStruct::<T>::members();
        let policy = ReflectStruct::<T>::wire_name_policy();
        let mut st = s.begin_struct(&ReflectStruct::<T>::type_name(), members.len())?;
        for let f of members {
            let name = wire_name(&f, policy);
            let value = f.get(self);
            st.field(&name, &value)?;
        }
        return st.end();
    }
}

/// Variant serialization derived over `ReflectVariant`: find the live case and
/// write it as a unit tag, or as a tagged payload.
impl<V: ReflectVariant<CasePayloads = [..P]>, ..P: Serialize> Serialize for V {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let policy = ReflectVariant::<V>::wire_name_policy();
        let type_name = ReflectVariant::<V>::type_name();
        for let case of ReflectVariant::<V>::members() {
            if case.holds(self) {
                let name = wire_name(&case, policy);
                if case.is_unit() {
                    return s.serialize_unit_variant(&type_name, &name, case.discriminant());
                }
                let mut var = s.begin_variant(&type_name, &name, case.discriminant())?;
                let payload = case.extract(self);
                var.payload(&payload)?;
                return var.end();
            }
        }
        return Result::Err(SerializeError {
            kind: SerializeErrorKind::UnsupportedValue,
            message: `unknown case of ${type_name}`,
        });
    }
}

/// Enum serialization derived over `ReflectEnum`: the live case as a unit tag.
impl<E: ReflectEnum<Members = [..M]>, ..M> Serialize for E {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let policy = ReflectEnum::<E>::wire_name_policy();
        for let case of ReflectEnum::<E>::members() {
            if case.holds(self) {
                let name = wire_name(&case, policy);
                return s.serialize_unit_variant(
                    &ReflectEnum::<E>::type_name(),
                    &name,
                    case.discriminant(),
                );
            }
        }
        return Result::Err(SerializeError {
            kind: SerializeErrorKind::UnsupportedValue,
            message: `unknown discriminant of ${ReflectEnum::<E>::type_name()}`,
        });
    }
}

/// Flags serialization derived over `ReflectFlags`: the set bits as an array of
/// their wire names.
impl<L: ReflectFlags<Members = [..M]>, ..M> Serialize for L {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let policy = ReflectFlags::<L>::wire_name_policy();
        let members = ReflectFlags::<L>::members();
        let mut count = 0;
        for let bit of members {
            if bit.is_set(self) {
                count += 1;
            }
        }
        let mut seq = s.begin_seq(count)?;
        for let bit of members {
            if bit.is_set(self) {
                let name = wire_name(&bit, policy);
                seq.element(&name)?;
            }
        }
        return seq.end();
    }
}

/// Serialize for tuples: `[1, "hello", true]` → `[1,"hello",true]`
impl<..T: Serialize> Serialize for [..T] {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let mut seq = s.begin_seq(self.len())?;
        for let v of self {
            seq.element(v)?;
        }
        return seq.end();
    }
}

/// The case a variant / enum deserialization landed on: by discriminant when
/// the format carries one (NSD), else by wire name (SD).
variant CaseKey {
    Disc(i32),
    Name(String),
}

/// Read the incoming case key: the discriminant path first, the name path as
/// the fallback.
fn case_key<A: DeserializeVariant>(va: &mut A) -> Result<CaseKey, DeserializeError> {
    if let Ok(disc) = va.disc() {
        return Result::Ok(CaseKey::Disc(disc));
    }
    let name = va.variant_name()?;
    return Result::Ok(CaseKey::Name(name));
}

fn unknown_case_error(key: &CaseKey) -> DeserializeError {
    return DeserializeError {
        kind: DeserializeErrorKind::UnknownVariant,
        message: match key {
            CaseKey::Disc(_) => "unknown variant discriminant",
            CaseKey::Name(_) => "unknown variant",
        },
        offset: -1,
    };
}

/// Variant deserialization derived over `ReflectVariant`: find the case the
/// wire names, then read its payload.
impl<V: ReflectVariant<CasePayloads = [..P]>, ..P: Deserialize> Deserialize for V {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<V, DeserializeError> {
        let members = ReflectVariant::<V>::members();
        let mut va = d.begin_variant(&ReflectVariant::<V>::type_name(), members.len())?;
        let policy = ReflectVariant::<V>::wire_name_policy();
        let key = case_key(&mut va)?;
        for let case of members {
            // `wire_name` resolves at the use site, where the member and the
            // policy are both compile-time facts and it folds to a literal.
            // Behind a helper taking the run-time key it would not.
            let matched = match &key {
                CaseKey::Disc(d) => *d == case.discriminant(),
                CaseKey::Name(n) => wire_name(&case, policy) == *n,
            };
            if matched {
                if case.is_unit() {
                    va.end()?;
                    return Result::Ok(case.make());
                }
                let payload: P = va.payload()?;
                va.end()?;
                return Result::Ok(case.construct(payload));
            }
        }
        return Result::Err(unknown_case_error(&key));
    }
}

/// Enum deserialization derived over `ReflectEnum`: the case the wire names.
impl<E: ReflectEnum<Members = [..M]>, ..M> Deserialize for E {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<E, DeserializeError> {
        let members = ReflectEnum::<E>::members();
        let mut va = d.begin_variant(&ReflectEnum::<E>::type_name(), members.len())?;
        let policy = ReflectEnum::<E>::wire_name_policy();
        let key = case_key(&mut va)?;
        for let case of members {
            // `wire_name` resolves at the use site, where the member and the
            // policy are both compile-time facts and it folds to a literal.
            // Behind a helper taking the run-time key it would not.
            let matched = match &key {
                CaseKey::Disc(d) => *d == case.discriminant(),
                CaseKey::Name(n) => wire_name(&case, policy) == *n,
            };
            if matched {
                va.end()?;
                return Result::Ok(case.make());
            }
        }
        return Result::Err(unknown_case_error(&key));
    }
}

/// Flags deserialization derived over `ReflectFlags`: an array of the set bits'
/// wire names.
impl<L: ReflectFlags<Members = [..M]>, ..M> Deserialize for L {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<L, DeserializeError> {
        let policy = ReflectFlags::<L>::wire_name_policy();
        let mut seq = d.begin_seq()?;
        let mut raw: u64 = 0;
        loop {
            let opt: Option<String> = seq.next_element()?;
            if let Some(name) = opt {
                let mut found = false;
                for let bit of ReflectFlags::<L>::members() {
                    if wire_name(&bit, policy) == name {
                        raw = raw | bit.bit();
                        found = true;
                    }
                }
                if !found {
                    return Result::Err(DeserializeError {
                        kind: DeserializeErrorKind::UnknownVariant,
                        message: `unknown flag: ${name}`,
                        offset: -1,
                    });
                }
            } else {
                seq.end()?;
                if let Some(v) = ReflectFlags::<L>::from_bits(raw) {
                    return Result::Ok(v);
                }
                return Result::Err(DeserializeError::invalid_value(
                    `unknown bits of ${ReflectFlags::<L>::type_name()}`,
                    -1,
                ));
            }
        }
    }
}

/// Reads back the null `Serialize for ()` wrote. A `()` anywhere but a unit
/// variant case — a struct field, a `Result<(), E>` payload — is on the wire,
/// and leaving it there would fail the next token.
impl Deserialize for () {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<(), DeserializeError> {
        if d.is_null()? {
            return Result::Ok(());
        }
        return Result::Err(DeserializeError::unexpected_type("null", -1));
    }
}

/// Deserialize for tuples: `[1,"hello",true]` → `[1, "hello", true]`
impl<..T: Deserialize> Deserialize for [..T] {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<[..T], DeserializeError> {
        let mut seq = d.begin_seq()?;
        let tuple = [..T::deserialize_next_element_from_seq(&mut seq)?];
        seq.end()?;
        return Result::Ok(tuple);
    }
}


// ── Wire naming: the compiler exposes naming facts, casing lives here ──

fn is_separator_byte(b: u8) -> bool {
    return b == 95 || b == 45 || b == 32;
}

fn is_upper_byte(b: u8) -> bool {
    return b >= 65 && b <= 90;
}

fn is_lower_byte(b: u8) -> bool {
    return b >= 97 && b <= 122;
}

fn to_lower_byte(b: u8) -> u8 {
    return if is_upper_byte(b) { b + 32 } else { b };
}

fn to_upper_byte(b: u8) -> u8 {
    return if is_lower_byte(b) { b - 32 } else { b };
}

/// The byte `style` joins words with, or `0` when it concatenates them.
fn case_separator(style: CaseStyle) -> u8 {
    return match style {
        Snake => 95,
        ScreamingSnake => 95,
        Kebab => 45,
        ScreamingKebab => 45,
        Identity => 0,
        Camel => 0,
        Pascal => 0,
    };
}

/// Apply a `CaseStyle` to an identifier. `Identity` returns `s` unchanged.
///
/// Word boundaries follow `heck`, so a policy resolves the same name here as
/// in the compiler's `apply_name_policy`: `_`/`-`/space delimit and are
/// dropped; a lower/digit → upper transition starts a word; inside an
/// uppercase run, an uppercase directly before a lowercase starts one. Digits
/// attach to the current word.
pub fn apply_case(style: CaseStyle, s: String) -> String {
    if style matches { Identity } {
        return s;
    }
    // Bytes, not chars: every rule above is ASCII, and a multi-byte sequence's
    // bytes are all >= 0x80, so they are neither separators nor case
    // transitions and stay in the word they sit in.
    let separator = case_separator(style);
    let upper_all = style matches { ScreamingSnake | ScreamingKebab };
    let upper_word_head = style matches { Camel | Pascal };
    let lower_first_word = style matches { Camel };

    let n = s.len();
    let mut out = String::with_capacity(n + 4);
    let mut word = -1;
    let mut at_head = true;
    let mut prev: u8 = 0;
    for let mut i = 0; i < n; i += 1 {
        let b = s.get_byte_unchecked(i);
        if is_separator_byte(b) {
            at_head = true;
            prev = b;
            continue;
        }
        if word >= 0 && !at_head {
            let opens_upper_run = !is_upper_byte(prev) && is_upper_byte(b);
            let closes_upper_run = is_upper_byte(prev)
                && is_upper_byte(b)
                && i + 1 < n
                && is_lower_byte(s.get_byte_unchecked(i + 1));
            at_head = opens_upper_run || closes_upper_run;
        }
        if at_head {
            word += 1;
            if word > 0 && separator != 0 {
                out.push_ascii_unchecked(separator);
            }
        }
        let head_of_capitalized_word =
            at_head && upper_word_head && !(lower_first_word && word == 0);
        if upper_all || head_of_capitalized_word {
            out.push_ascii_unchecked(to_upper_byte(b));
        } else {
            out.push_ascii_unchecked(to_lower_byte(b));
        }
        at_head = false;
        prev = b;
    }
    return out;
}

/// Resolve a member's wire name: its `#[wire(name)]` override wins,
/// else the type's `name_policy` applies, else identity.
pub fn wire_name<M: Member>(m: &M, policy: CaseStyle) -> String {
    return match m.wire_name_override() {
        Option::Some(o) => o,
        Option::None => apply_case(policy, m.name()),
    };
}
