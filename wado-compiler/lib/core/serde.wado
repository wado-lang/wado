impl<T: Deserialize> Deserialize for Option<T> {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<Option<T>, DeserializeError> {
        let null_check = d.is_null();
        if let Ok(is_null) = null_check {
            if is_null {
                return Result::Ok(null);
            }
            let inner = T::deserialize(d);
            if let Ok(v) = inner {
                return Result::Ok(Option::Some(v));
            }
            if let Err(e) = inner {
                return Result::Err(e);
            }
        }
        if let Err(e) = null_check {
            return Result::Err(e);
        }
        unreachable();
    }
}

impl<T: Deserialize> Deserialize for Array<T> {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<Array<T>, DeserializeError> {
        let seq_result = d.begin_seq();
        if let Ok(mut seq) = seq_result {
            // Peek at the first element before allocating backing storage.
            // Empty arrays (very common in practice) avoid any capacity allocation.
            // Non-empty arrays start at capacity 4, covering 1–4 elements without a grow.
            let first = seq.next_element::<T>();
            if let Ok(first_opt) = first {
                if let Some(first_elem) = first_opt {
                    let mut items = Array::<T>::with_capacity(2);
                    items.push(first_elem);
                    loop {
                        let next = seq.next_element::<T>();
                        if let Ok(next_opt) = next {
                            if let Some(item) = next_opt {
                                items.push(item);
                            } else {
                                let end_result = seq.end();
                                if let Err(e) = end_result {
                                    return Result::Err(e);
                                }
                                return Result::Ok(items);
                            }
                        }
                        if let Err(e) = next {
                            return Result::Err(e);
                        }
                    }
                } else {
                    let end_result = seq.end();
                    if let Err(e) = end_result {
                        return Result::Err(e);
                    }
                    return Result::Ok([] as Array<T>);
                }
            }
            if let Err(e) = first {
                return Result::Err(e);
            }
            unreachable();
        }
        if let Err(e) = seq_result {
            return Result::Err(e);
        }
        unreachable();
    }
}

impl<T: Deserialize, E: Deserialize> Deserialize for Result<T, E> {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<Result<T, E>, DeserializeError> {
        let va_r = d.begin_variant(&"Result", 2);
        if let Ok(mut va) = va_r {
            let name_r = va.variant_name();
            if let Ok(name) = name_r {
                if name == "Ok" {
                    let val_r = va.payload::<T>();
                    if let Ok(val) = val_r {
                        let end_r = va.end();
                        if let Err(e) = end_r {
                            return Result::Err(e);
                        }
                        return Result::Ok(Result::Ok(val));
                    }
                    if let Err(e) = val_r {
                        return Result::Err(e);
                    }
                }
                if name == "Err" {
                    let val_r = va.payload::<E>();
                    if let Ok(val) = val_r {
                        let end_r = va.end();
                        if let Err(e) = end_r {
                            return Result::Err(e);
                        }
                        return Result::Ok(Result::Err(val));
                    }
                    if let Err(e) = val_r {
                        return Result::Err(e);
                    }
                }
                return Result::Err(DeserializeError {
                    kind: DeserializeErrorKind::UnknownVariant,
                    message: `unknown Result variant: {name}`,
                    offset: -1,
                });
            }
            if let Err(e) = name_r {
                return Result::Err(e);
            }
        }
        if let Err(e) = va_r {
            return Result::Err(e);
        }
        unreachable();
    }
}

/// Serialize for tuples: `[1, "hello", true]` → `[1,"hello",true]`
impl<..T: Serialize> Serialize for [..T] {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let mut seq = s.begin_seq((*self).len())?;
        for let v of *self {
            seq.element(&v);
        }
        return seq.end();
    }
}

/// Deserialize for tuples: `[1,"hello",true]` → `[1, "hello", true]`
impl<..T: Deserialize> Deserialize for [..T] {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<[..T], DeserializeError> {
        let mut seq = d.begin_seq()?;
        let tuple = [..T::deserialize_next_element_from_seq(&mut seq)?];
        seq.end()?;
        return Result::Ok(tuple);
    }
}
