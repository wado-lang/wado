    fn deserialize<D: Deserializer>(d: &mut D) -> Result<u16, DeserializeError> {
        let r = d.deserialize_u32();
        if let Ok(v) = r {
            if v > 65535 {
                return Result::Err(
                    DeserializeError::overflow("value out of range for u16", -1),
                );
            }
            return Result::Ok(v as u16);
        }
        if let Err(e) = r {
            return Result::Err(e);
        }
        unreachable();
    }
}

