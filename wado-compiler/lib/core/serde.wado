    }
}

impl Serialize for String {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_string(self);
    }
}

impl<T: Serialize> Serialize for Option<T> {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        if let Some(v) = self {
            return v.serialize::<S>(s);
        }
        return s.serialize_null();
    }
}

impl<T: Serialize> Serialize for Array<T> {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let seq = s.begin_seq(self.len());
        if let Ok(mut seq) = seq {
            for let item of *self {
                let r = seq.element::<T>(&item);
                if let Err(e) = r {
                    return Result::Err(e);
                }
            }
            return seq.end();
        }
        if let Err(e) = seq {
            return Result::Err(e);
        }
        return Result::Err(SerializeError {
            kind: SerializeErrorKind::Custom,
            message: "begin_seq failed",
        });
    }
}


impl<T: Serialize, E: Serialize> Serialize for Result<T, E> {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        if let Ok(v) = self {
            let var = s.begin_variant(&"Result", &"Ok", 0);
            if let Ok(mut vs) = var {
                let r = vs.payload::<T>(v);
                if let Err(e) = r {
                    return Result::Err(e);
                }
                return vs.end();
            }
            if let Err(e) = var {
                return Result::Err(e);
            }
        }
        if let Err(v) = self {
            let var = s.begin_variant(&"Result", &"Err", 1);
            if let Ok(mut vs) = var {
                let r = vs.payload::<E>(v);
                if let Err(e) = r {
                    return Result::Err(e);
                }
                return vs.end();
            }
            if let Err(e) = var {
                return Result::Err(e);
            }
        }
        unreachable();
    }
}

impl Deserialize for i8 {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<i8, DeserializeError> {
        let r = d.deserialize_i32();
        if let Ok(v) = r {
            if v < -128 || v > 127 {
                return Result::Err(DeserializeError::overflow("value out of range for i8", -1));
            }
            return Result::Ok(v as i8);
        }
        if let Err(e) = r {
            return Result::Err(e);
        }
        unreachable();
    }
}

impl Deserialize for i16 {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<i16, DeserializeError> {
        let r = d.deserialize_i32();
        if let Ok(v) = r {
            if v < -32768 || v > 32767 {
                return Result::Err(
                    DeserializeError::overflow("value out of range for i16", -1),
                );
            }
            return Result::Ok(v as i16);
        }
        if let Err(e) = r {
            return Result::Err(e);
        }
        unreachable();
    }
}

impl Deserialize for i32 {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<i32, DeserializeError> {
        return d.deserialize_i32();
    }
}

impl Deserialize for i64 {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<i64, DeserializeError> {
        return d.deserialize_i64();
    }
}

impl Deserialize for u8 {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<u8, DeserializeError> {
        let r = d.deserialize_u32();
        if let Ok(v) = r {
            if v > 255 {
                return Result::Err(DeserializeError::overflow("value out of range for u8", -1));
            }
            return Result::Ok(v as u8);
        }
        if let Err(e) = r {
            return Result::Err(e);
        }
        unreachable();
    }
}

