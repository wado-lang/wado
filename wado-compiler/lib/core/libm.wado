//! Deterministic math functions imported from `./libm.wat`.
//!
//! `libm.wat` is hand-rolled WAT compiled from the Rust `libm` crate and
//! provides platform-deterministic floating-point math functions used by
//! the prelude's primitive impls (see `core:prelude/primitive.wado`).
//! Phase 1 of the wasm-import support (see
//! `docs/wep-2026-01-10-wasm-import.md`) lets us name-import the wat
//! module's exports here and re-export them under their Wado-side names.

pub use {
    libm_sin as f64_sin, libm_cos as f64_cos, libm_tan as f64_tan,
    libm_asin as f64_asin, libm_acos as f64_acos, libm_atan as f64_atan,
    libm_atan2 as f64_atan2,
    libm_sinh as f64_sinh, libm_cosh as f64_cosh, libm_tanh as f64_tanh,
    libm_asinh as f64_asinh, libm_acosh as f64_acosh, libm_atanh as f64_atanh,
    libm_exp as f64_exp, libm_exp2 as f64_exp2, libm_expm1 as f64_expm1,
    libm_log as f64_ln, libm_log2 as f64_log2, libm_log10 as f64_log10,
    libm_log1p as f64_ln1p,
    libm_pow as f64_pow, libm_cbrt as f64_cbrt,
    libm_hypot as f64_hypot, libm_fmod as f64_fmod,
    libm_sinf as f32_sin, libm_cosf as f32_cos, libm_tanf as f32_tan,
    libm_asinf as f32_asin, libm_acosf as f32_acos, libm_atanf as f32_atan,
    libm_atan2f as f32_atan2,
    libm_sinhf as f32_sinh, libm_coshf as f32_cosh, libm_tanhf as f32_tanh,
    libm_asinhf as f32_asinh, libm_acoshf as f32_acosh, libm_atanhf as f32_atanh,
    libm_expf as f32_exp, libm_exp2f as f32_exp2, libm_expm1f as f32_expm1,
    libm_logf as f32_ln, libm_log2f as f32_log2, libm_log10f as f32_log10,
    libm_log1pf as f32_ln1p,
    libm_powf as f32_pow, libm_cbrtf as f32_cbrt,
    libm_hypotf as f32_hypot, libm_fmodf as f32_fmod
} from "./libm.wat" with { type: "wat" };
