// String Type Module
// Separated from prelude to allow other stdlib modules to depend on String
// without creating circular dependencies.

#![no_prelude]

use {Eq, Ord, Iterator} from "core:prelude/traits";
use {Option} from "core:prelude/types";

// ============================================================================
// String Type
// ============================================================================

/// UTF-8 encoded string type with O(1) amortized append
pub struct String {
    repr: builtin::array<u8>,
    used: i32,
}

impl String {
    /// Create a new empty string with the specified capacity
    /// The string starts empty but has space for `capacity` bytes
    pub fn with_capacity(capacity: i32) -> String {
        return String {
            repr: builtin::array_new::<u8>(capacity),
            used: 0,
        };
    }

    /// Get the length of the string in bytes
    pub fn len(&self) -> i32 {
        return self.used;
    }

    /// Check if the string is empty
    pub fn is_empty(&self) -> bool {
        return self.used == 0;
    }

    /// Get a byte at the given index (low-level - prefer bytes() iterator)
    pub fn get_byte(&self, index: i32) -> i32 {
        return builtin::array_get_u8(self.repr, index);
    }

    /// Set a byte at the given index (low-level)
    pub fn set_byte(&mut self, index: i32, value: i32) {
        builtin::array_set_u8(self.repr, index, value);
    }

    // =========================================================================
    // Internal methods for stdlib use only
    // =========================================================================

    /// Internal: Get raw bytes array (stdlib use only)
    /// Returns the underlying byte array. Caller must respect `len()` boundary.
    pub fn internal_raw_bytes(&self) -> builtin::array<u8> {
        return self.repr;
    }

    /// Internal: Get used length (stdlib use only)
    /// Returns the number of valid bytes in the raw bytes array.
    pub fn internal_len(&self) -> i32 {
        return self.used;
    }

    /// Internal: Create String from raw UTF-8 bytes (stdlib use only)
    /// The bytes must be valid UTF-8. No validation is performed.
    pub fn internal_from_utf8_raw(bytes: builtin::array<u8>, len: i32) -> String {
        return String { repr: bytes, used: len };
    }

    /// Ensure the string has capacity for at least `min_capacity` bytes.
    /// If the current capacity is less than `min_capacity`, grows the buffer.
    /// Uses amortized doubling strategy for efficiency.
    pub fn grow(&mut self, min_capacity: i32) {
        let capacity = builtin::array_len(self.repr);
        if min_capacity <= capacity {
            return;
        }

        // Calculate new capacity: double or at least min_capacity
        let mut new_capacity = capacity * 2;
        if new_capacity < min_capacity {
            new_capacity = min_capacity;
        }
        if new_capacity < 8 {
            new_capacity = 8;
        }

        // Create new array and copy existing bytes
        let new_repr = builtin::array_new::<u8>(new_capacity);
        for let mut i = 0; i < self.used; i += 1 {
            let byte = builtin::array_get_u8(self.repr, i);
            builtin::array_set_u8(new_repr, i, byte);
        }
        self.repr = new_repr;
    }

    /// Append another string to this string
    /// Grows the string if necessary (O(1) amortized)
    pub fn append(&mut self, other: String) {
        let other_len = other.len();
        if other_len == 0 {
            return;
        }

        let new_used = self.used + other_len;
        if builtin::unlikely(new_used > builtin::array_len(self.repr)) {
            self.grow(new_used);
        }

        // Copy bytes from other
        let other_repr = other.internal_raw_bytes();
        for let mut i = 0; i < other_len; i += 1 {
            let byte = builtin::array_get_u8(other_repr, i);
            builtin::array_set_u8(self.repr, self.used + i, byte);
        }
        self.used = new_used;
    }

    /// Concatenate two strings into a new string
    /// This is a static method: String::concat(a, b)
    pub fn concat(a: String, b: String) -> String {
        let len_a = a.len();
        let len_b = b.len();
        let total = len_a + len_b;

        // Create new string with exact capacity needed
        let repr = builtin::array_new::<u8>(total);

        // Copy bytes from a
        let a_repr = a.internal_raw_bytes();
        for let mut i = 0; i < len_a; i += 1 {
            let byte = builtin::array_get_u8(a_repr, i);
            builtin::array_set_u8(repr, i, byte);
        }

        // Copy bytes from b
        let b_repr = b.internal_raw_bytes();
        for let mut i = 0; i < len_b; i += 1 {
            let byte = builtin::array_get_u8(b_repr, i);
            builtin::array_set_u8(repr, len_a + i, byte);
        }

        return String { repr, used: total };
    }
}

// Eq implementation for String - lexicographic equality
impl Eq for String {
    pub fn eq(&self, other: &Self) -> bool {
        let len_a = self.len();
        let len_b = other.len();

        if len_a != len_b {
            return false;
        }

        let a_repr = self.internal_raw_bytes();
        let b_repr = other.internal_raw_bytes();
        for let mut i = 0; i < len_a; i += 1 {
            if builtin::array_get_u8(a_repr, i) != builtin::array_get_u8(b_repr, i) {
                return false;
            }
        }

        return true;
    }
}

// Ord implementation for String - lexicographic ordering
impl Ord for String {
    pub fn lt(&self, other: &Self) -> bool {
        let len_a = self.len();
        let len_b = other.len();
        let min_len = if len_b < len_a { len_b } else { len_a };

        let a_repr = self.internal_raw_bytes();
        let b_repr = other.internal_raw_bytes();
        for let mut i = 0; i < min_len; i += 1 {
            let a_byte = builtin::array_get_u8(a_repr, i);
            let b_byte = builtin::array_get_u8(b_repr, i);
            if a_byte < b_byte {
                return true;
            }
            if a_byte > b_byte {
                return false;
            }
        }

        // All compared bytes are equal, shorter string is less
        return len_a < len_b;
    }
}

// ============================================================================
// String Iterators
// ============================================================================

/// Iterator over UTF-8 bytes of a String.
/// Yields each byte as u8.
pub struct StrUtf8ByteIter {
    repr: builtin::array<u8>,
    used: i32,
    index: i32,
}

impl Iterator for StrUtf8ByteIter {
    type Item = u8;

    pub fn next(&mut self) -> Option<Self::Item> {
        if self.index >= self.used {
            return null;
        }
        let byte = builtin::array_get_u8(self.repr, self.index);
        self.index += 1;
        return Option::<u8>::Some(byte as u8);
    }
}

impl StrUtf8ByteIter {
    /// Collects iterator elements into an Array.
    pub fn collect(&mut self) -> Array<u8> {
        let mut result: Array<u8> = [];
        loop {
            if let Some(item) = self.next() {
                result.append(item);
            } else {
                break;
            }
        }
        return result;
    }

    /// Counts the number of remaining elements in the iterator.
    pub fn count(&mut self) -> i32 {
        let mut n = 0;
        loop {
            if let Some(_) = self.next() {
                n += 1;
            } else {
                break;
            }
        }
        return n;
    }
}

/// Iterator over Unicode scalar values (chars) of a String.
/// Decodes UTF-8 and yields each character.
pub struct StrCharIter {
    repr: builtin::array<u8>,
    used: i32,
    byte_index: i32,
}

impl Iterator for StrCharIter {
    type Item = char;

    pub fn next(&mut self) -> Option<Self::Item> {
        if self.byte_index >= self.used {
            return null;
        }

        let b0 = builtin::array_get_u8(self.repr, self.byte_index);
        self.byte_index += 1;

        // Single byte (ASCII): 0xxxxxxx
        if b0 < 0x80 {
            return Option::<char>::Some(b0 as char);
        }

        // Two bytes: 110xxxxx 10xxxxxx
        if b0 < 0xE0 {
            let b1 = builtin::array_get_u8(self.repr, self.byte_index);
            self.byte_index += 1;
            let code = ((b0 & 0x1F) << 6) | (b1 & 0x3F);
            return Option::<char>::Some(code as char);
        }

        // Three bytes: 1110xxxx 10xxxxxx 10xxxxxx
        if b0 < 0xF0 {
            let b1 = builtin::array_get_u8(self.repr, self.byte_index);
            let b2 = builtin::array_get_u8(self.repr, self.byte_index + 1);
            self.byte_index += 2;
            let code = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F);
            return Option::<char>::Some(code as char);
        }

        // Four bytes: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
        let b1 = builtin::array_get_u8(self.repr, self.byte_index);
        let b2 = builtin::array_get_u8(self.repr, self.byte_index + 1);
        let b3 = builtin::array_get_u8(self.repr, self.byte_index + 2);
        self.byte_index += 3;
        let code = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F);
        return Option::<char>::Some(code as char);
    }
}

impl StrCharIter {
    /// Collects iterator elements into an Array.
    pub fn collect(&mut self) -> Array<char> {
        let mut result: Array<char> = [];
        loop {
            if let Some(item) = self.next() {
                result.append(item);
            } else {
                break;
            }
        }
        return result;
    }

    /// Counts the number of remaining elements (Unicode scalar values) in the iterator.
    pub fn count(&mut self) -> i32 {
        let mut n = 0;
        loop {
            if let Some(_) = self.next() {
                n += 1;
            } else {
                break;
            }
        }
        return n;
    }
}

impl String {
    /// Returns an iterator over the UTF-8 bytes of the string.
    pub fn bytes(&self) -> StrUtf8ByteIter {
        return StrUtf8ByteIter {
            repr: self.repr,
            used: self.used,
            index: 0,
        };
    }

    /// Returns an iterator over the Unicode scalar values (chars) of the string.
    pub fn chars(&self) -> StrCharIter {
        return StrCharIter {
            repr: self.repr,
            used: self.used,
            byte_index: 0,
        };
    }

    /// Append a Unicode scalar value (char) to this string.
    /// Panics if the char is not a valid Unicode scalar value (surrogates 0xD800-0xDFFF).
    pub fn append_char(&mut self, c: char) {
        let code = c as i32;

        // Validate Unicode scalar value (reject surrogates and out-of-range)
        assert code < 0xD800 || code > 0xDFFF, "invalid Unicode scalar value: surrogate code point";
        assert code >= 0 && code <= 0x10FFFF, "invalid Unicode scalar value: out of range";

        // Calculate UTF-8 byte length
        let byte_len = if code < 0x80 {
            1
        } else if code < 0x800 {
            2
        } else if code < 0x10000 {
            3
        } else {
            4
        };

        let new_used = self.used + byte_len;
        if builtin::unlikely(new_used > builtin::array_len(self.repr)) {
            self.grow(new_used);
        }

        // Encode UTF-8
        if code < 0x80 {
            builtin::array_set_u8(self.repr, self.used, code);
        } else if code < 0x800 {
            builtin::array_set_u8(self.repr, self.used, 0xC0 | (code >> 6));
            builtin::array_set_u8(self.repr, self.used + 1, 0x80 | (code & 0x3F));
        } else if code < 0x10000 {
            builtin::array_set_u8(self.repr, self.used, 0xE0 | (code >> 12));
            builtin::array_set_u8(self.repr, self.used + 1, 0x80 | ((code >> 6) & 0x3F));
            builtin::array_set_u8(self.repr, self.used + 2, 0x80 | (code & 0x3F));
        } else {
            builtin::array_set_u8(self.repr, self.used, 0xF0 | (code >> 18));
            builtin::array_set_u8(self.repr, self.used + 1, 0x80 | ((code >> 12) & 0x3F));
            builtin::array_set_u8(self.repr, self.used + 2, 0x80 | ((code >> 6) & 0x3F));
            builtin::array_set_u8(self.repr, self.used + 3, 0x80 | (code & 0x3F));
        }

        self.used = new_used;
    }
}
