pub struct F32x4Builder {
    vec: v128,
    index: i32,
}

impl SequenceLiteralBuilder for F32x4Builder {
    type Element = f32;
    type Output = f32x4;

    fn new_literal(capacity: i32) -> F32x4Builder {
        return F32x4Builder { vec: builtin::f32x4_splat(0.0 as f32), index: 0 };
    }

    fn push_literal(&mut self, value: f32) {
        let i = self.index;
        if i == 0 { self.vec = builtin::f32x4_replace_lane(0, self.vec, value); }
        else if i == 1 { self.vec = builtin::f32x4_replace_lane(1, self.vec, value); }
        else if i == 2 { self.vec = builtin::f32x4_replace_lane(2, self.vec, value); }
        else { self.vec = builtin::f32x4_replace_lane(3, self.vec, value); }
        self.index = i + 1;
    }

    fn build(&self) -> f32x4 {
        return self.vec as f32x4;
    }
}

