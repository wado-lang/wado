impl Shl for i8x16 {
    type Output = i8x16;

    fn shl(&self, rhs: u32) -> i8x16 {
        return builtin::i8x16_shl(*self as v128, rhs as i32) as i8x16;
    }
}

impl Shr for i8x16 {
    type Output = i8x16;

    fn shr(&self, rhs: u32) -> i8x16 {
        return builtin::i8x16_shr_s(*self as v128, rhs as i32) as i8x16;
    }
}

pub struct I8x16Builder {
    vec: v128,
    index: i32,
}

impl SequenceLiteralBuilder for I8x16Builder {
    type Element = i32;
    type Output = i8x16;

    fn new_literal(capacity: i32) -> I8x16Builder {
        return I8x16Builder { vec: builtin::i8x16_splat(0), index: 0 };
    }

    fn push_literal(&mut self, value: i32) {
        let i = self.index;
        self.vec = match i {
            0 => builtin::i8x16_replace_lane(0, self.vec, value),
            1 => builtin::i8x16_replace_lane(1, self.vec, value),
            2 => builtin::i8x16_replace_lane(2, self.vec, value),
            3 => builtin::i8x16_replace_lane(3, self.vec, value),
            4 => builtin::i8x16_replace_lane(4, self.vec, value),
            5 => builtin::i8x16_replace_lane(5, self.vec, value),
            6 => builtin::i8x16_replace_lane(6, self.vec, value),
            7 => builtin::i8x16_replace_lane(7, self.vec, value),
            8 => builtin::i8x16_replace_lane(8, self.vec, value),
            9 => builtin::i8x16_replace_lane(9, self.vec, value),
            10 => builtin::i8x16_replace_lane(10, self.vec, value),
            11 => builtin::i8x16_replace_lane(11, self.vec, value),
            12 => builtin::i8x16_replace_lane(12, self.vec, value),
            13 => builtin::i8x16_replace_lane(13, self.vec, value),
            14 => builtin::i8x16_replace_lane(14, self.vec, value),
            _ => builtin::i8x16_replace_lane(15, self.vec, value),
        };
        self.index = i + 1;
    }

    fn build(&self) -> i8x16 {
        return self.vec as i8x16;
    }
}

impl SequenceLiteral for i8x16 {
    type Element = i32;
    type Builder = I8x16Builder;
}

impl i16x8 {
    pub fn splat(a: i32) -> i16x8 {
        return builtin::i16x8_splat(a) as i16x8;
    }

    pub fn extract_lane_s(&self, lane: i32) -> i32 {
        return match lane {
            0 => builtin::i16x8_extract_lane_s(0, *self as v128),
            1 => builtin::i16x8_extract_lane_s(1, *self as v128),
            2 => builtin::i16x8_extract_lane_s(2, *self as v128),
            3 => builtin::i16x8_extract_lane_s(3, *self as v128),
            4 => builtin::i16x8_extract_lane_s(4, *self as v128),
            5 => builtin::i16x8_extract_lane_s(5, *self as v128),
            6 => builtin::i16x8_extract_lane_s(6, *self as v128),
            _ => builtin::i16x8_extract_lane_s(7, *self as v128),
        };
    }

    pub fn extract_lane_u(&self, lane: i32) -> i32 {
        return match lane {
            0 => builtin::i16x8_extract_lane_u(0, *self as v128),
            1 => builtin::i16x8_extract_lane_u(1, *self as v128),
            2 => builtin::i16x8_extract_lane_u(2, *self as v128),
            3 => builtin::i16x8_extract_lane_u(3, *self as v128),
            4 => builtin::i16x8_extract_lane_u(4, *self as v128),
            5 => builtin::i16x8_extract_lane_u(5, *self as v128),
            6 => builtin::i16x8_extract_lane_u(6, *self as v128),
            _ => builtin::i16x8_extract_lane_u(7, *self as v128),
        };
    }

    pub fn eq(&self, other: &i16x8) -> i16x8 {
        return builtin::i16x8_eq(*self as v128, *other as v128) as i16x8;
    }

    pub fn ne(&self, other: &i16x8) -> i16x8 {
        return builtin::i16x8_ne(*self as v128, *other as v128) as i16x8;
    }

    pub fn lt(&self, other: &i16x8) -> i16x8 {
