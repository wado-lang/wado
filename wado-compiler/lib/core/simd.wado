pub struct I64x2Builder {
    vec: v128,
    index: i32,
}

impl SequenceLiteralBuilder for I64x2Builder {
    type Element = i64;
    type Output = i64x2;

    fn new_literal(capacity: i32) -> I64x2Builder {
        return I64x2Builder { vec: builtin::i64x2_splat(0 as i64), index: 0 };
    }

    fn push_literal(&mut self, value: i64) {
        let i = self.index;
        if i == 0 { self.vec = builtin::i64x2_replace_lane(0, self.vec, value); }
        else { self.vec = builtin::i64x2_replace_lane(1, self.vec, value); }
        self.index = i + 1;
    }

    fn build(&self) -> i64x2 {
        return self.vec as i64x2;
    }
}

