impl SequenceLiteralBuilder for I16x8Builder {
    type Element = i32;
    type Output = i16x8;

    fn new_literal(capacity: i32) -> I16x8Builder {
        return I16x8Builder { vec: builtin::i16x8_splat(0), index: 0 };
    }

    fn push_literal(&mut self, value: i32) {
        let i = self.index;
        self.vec = match i {
            0 => builtin::i16x8_replace_lane(0, self.vec, value),
            1 => builtin::i16x8_replace_lane(1, self.vec, value),
            2 => builtin::i16x8_replace_lane(2, self.vec, value),
            3 => builtin::i16x8_replace_lane(3, self.vec, value),
            4 => builtin::i16x8_replace_lane(4, self.vec, value),
            5 => builtin::i16x8_replace_lane(5, self.vec, value),
            6 => builtin::i16x8_replace_lane(6, self.vec, value),
            _ => builtin::i16x8_replace_lane(7, self.vec, value),
        };
        self.index = i + 1;
    }

    fn build(&self) -> i16x8 {
        return self.vec as i16x8;
    }
}

