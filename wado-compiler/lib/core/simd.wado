pub struct F64x2Builder {
    vec: v128,
    index: i32,
}

impl SequenceLiteralBuilder for F64x2Builder {
    type Element = f64;
    type Output = f64x2;

    fn new_literal(capacity: i32) -> F64x2Builder {
        return F64x2Builder { vec: builtin::f64x2_splat(0.0), index: 0 };
    }

    fn push_literal(&mut self, value: f64) {
        let i = self.index;
        if i == 0 { self.vec = builtin::f64x2_replace_lane(0, self.vec, value); }
        else { self.vec = builtin::f64x2_replace_lane(1, self.vec, value); }
        self.index = i + 1;
    }

    fn build(&self) -> f64x2 {
        return self.vec as f64x2;
    }
}

impl SequenceLiteral for f64x2 {
    type Element = f64;
    type Builder = F64x2Builder;
}
