pub type i8x16 = v128;
pub type i16x8 = v128;
pub type i32x4 = v128;
pub type i64x2 = v128;

pub type u8x16 = v128;
pub type u16x8 = v128;
pub type u32x4 = v128;
pub type u64x2 = v128;

pub type f32x4 = v128;
pub type f64x2 = v128;

impl i8x16 {
    pub fn splat(a: i32) -> i8x16 {
        return builtin::i8x16_splat(a) as i8x16;
    }

    pub fn extract_lane_s(&self, lane: i32) -> i32 {
        if lane == 0 { return builtin::i8x16_extract_lane_s(0, *self as v128); }
        if lane == 1 { return builtin::i8x16_extract_lane_s(1, *self as v128); }
        if lane == 2 { return builtin::i8x16_extract_lane_s(2, *self as v128); }
        if lane == 3 { return builtin::i8x16_extract_lane_s(3, *self as v128); }
        if lane == 4 { return builtin::i8x16_extract_lane_s(4, *self as v128); }
        if lane == 5 { return builtin::i8x16_extract_lane_s(5, *self as v128); }
        if lane == 6 { return builtin::i8x16_extract_lane_s(6, *self as v128); }
        if lane == 7 { return builtin::i8x16_extract_lane_s(7, *self as v128); }
        if lane == 8 { return builtin::i8x16_extract_lane_s(8, *self as v128); }
        if lane == 9 { return builtin::i8x16_extract_lane_s(9, *self as v128); }
        if lane == 10 { return builtin::i8x16_extract_lane_s(10, *self as v128); }
        if lane == 11 { return builtin::i8x16_extract_lane_s(11, *self as v128); }
        if lane == 12 { return builtin::i8x16_extract_lane_s(12, *self as v128); }
        if lane == 13 { return builtin::i8x16_extract_lane_s(13, *self as v128); }
        if lane == 14 { return builtin::i8x16_extract_lane_s(14, *self as v128); }
        return builtin::i8x16_extract_lane_s(15, *self as v128);
    }

    pub fn extract_lane_u(&self, lane: i32) -> i32 {
        if lane == 0 { return builtin::i8x16_extract_lane_u(0, *self as v128); }
        if lane == 1 { return builtin::i8x16_extract_lane_u(1, *self as v128); }
        if lane == 2 { return builtin::i8x16_extract_lane_u(2, *self as v128); }
        if lane == 3 { return builtin::i8x16_extract_lane_u(3, *self as v128); }
        if lane == 4 { return builtin::i8x16_extract_lane_u(4, *self as v128); }
        if lane == 5 { return builtin::i8x16_extract_lane_u(5, *self as v128); }
        if lane == 6 { return builtin::i8x16_extract_lane_u(6, *self as v128); }
        if lane == 7 { return builtin::i8x16_extract_lane_u(7, *self as v128); }
        if lane == 8 { return builtin::i8x16_extract_lane_u(8, *self as v128); }
        if lane == 9 { return builtin::i8x16_extract_lane_u(9, *self as v128); }
        if lane == 10 { return builtin::i8x16_extract_lane_u(10, *self as v128); }
        if lane == 11 { return builtin::i8x16_extract_lane_u(11, *self as v128); }
        if lane == 12 { return builtin::i8x16_extract_lane_u(12, *self as v128); }
        if lane == 13 { return builtin::i8x16_extract_lane_u(13, *self as v128); }
        if lane == 14 { return builtin::i8x16_extract_lane_u(14, *self as v128); }
        return builtin::i8x16_extract_lane_u(15, *self as v128);
    }

    pub fn eq(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_eq(*self as v128, *other as v128) as i8x16;
    }

    pub fn ne(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_ne(*self as v128, *other as v128) as i8x16;
    }

    pub fn lt(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_lt_s(*self as v128, *other as v128) as i8x16;
    }

    pub fn gt(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_gt_s(*self as v128, *other as v128) as i8x16;
    }

    pub fn le(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_le_s(*self as v128, *other as v128) as i8x16;
    }

    pub fn ge(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_ge_s(*self as v128, *other as v128) as i8x16;
    }

    pub fn swizzle(&self, indices: &i8x16) -> i8x16 {
        return builtin::i8x16_swizzle(*self as v128, *indices as v128) as i8x16;
    }

    pub fn select(&self, mask: &i8x16, other: &i8x16) -> i8x16 {
        return builtin::v128_bitselect(*self as v128, *other as v128, *mask as v128) as i8x16;
    }
}

