#![stdlib("core:simd")]
//! # SIMD v128 Types
//!
//! This module provides type-safe wrappers over the WebAssembly 128-bit SIMD instruction set.
//! All types are newtypes of the primitive `v128` and can be freely reinterpreted via `as` cast.
//!
//! ## Types
//!
//! | Category | Types |
//! |----------|-------|
//! | Signed integer | `i8x16`, `i16x8`, `i32x4`, `i64x2` |
//! | Unsigned integer | `u8x16`, `u16x8`, `u32x4`, `u64x2` |
//! | Floating-point | `f32x4`, `f64x2` |
//!
//! ## Construction
//!
//! - `T::splat(value)` — broadcast a scalar to all lanes
//! - Tuple literal coercion — `let v: i32x4 = [1, 2, 3, 4];`
//! - Bitwise reinterpret — `let u = signed as u32x4;`
//!
//! ## Lane Access
//!
//! - `extract_lane(index)` — returns the lane value (i32/i64/f32/f64 depending on type)
//! - `extract_lane_s(index)` / `extract_lane_u(index)` — sign/zero-extended extraction for sub-32-bit types (i8x16, i16x8)
//!
//! ## Operators
//!
//! All types support `+`, `-`, `*`, `&`, `|`, `^`, `~`, `<<`, `>>`, and unary `-`.
//! Floating-point types additionally support `/`. Integer types do not support `/`.
//!
//! ## Comparison Methods
//!
//! All types provide `eq`, `ne`, `lt`, `gt`, `le`, `ge`.
//! These return a mask vector (all-1s or all-0s per lane), not `bool`.
//! Floating-point comparisons return the corresponding integer mask type (`f32x4` -> `i32x4`).
//!
//! ## Signed Integer Types (i8x16, i16x8, i32x4, i64x2)
//!
//! Common methods: `abs`, `all_true`, `bitmask`, `bitselect`.
//!
//! **i8x16 specific:** `swizzle`, `add_sat_s/u`, `sub_sat_s/u`, `min_s/u`, `max_s/u`,
//! `avgr_u`, `narrow_i16x8_s/u`, `popcnt`, `any_true`, `andnot`.
//!
//! **i16x8 specific:** `add_sat_s/u`, `sub_sat_s/u`, `min_s/u`, `max_s/u`, `avgr_u`,
//! `narrow_i32x4_s/u`, `extend_low/high_i8x16_s/u`, `extmul_low/high_i8x16_s/u`,
//! `extadd_pairwise_i8x16_s/u`, `q15mulr_sat_s`.
//!
//! **i32x4 specific:** `min_s/u`, `max_s/u`, `dot_i16x8_s`,
//! `extend_low/high_i16x8_s/u`, `extmul_low/high_i16x8_s/u`,
//! `extadd_pairwise_i16x8_s/u`, `trunc_sat_f32x4_s/u`, `trunc_sat_f64x2_s/u_zero`.
//!
//! **i64x2 specific:** `extend_low/high_i32x4_s/u`, `extmul_low/high_i32x4_s/u`.
//!
//! ## Unsigned Integer Types (u8x16, u16x8, u32x4, u64x2)
//!
//! **u8x16:** `abs`, `add_sat`, `sub_sat`, `min`, `max`, `avgr`,
//! `all_true`, `bitmask`, `popcnt`, `bitselect`.
//!
//! **u16x8:** `abs`, `add_sat`, `sub_sat`, `min`, `max`, `avgr`,
//! `all_true`, `bitmask`, `bitselect`.
//!
//! **u32x4:** `min`, `max`, `all_true`, `bitmask`, `bitselect`.
//!
//! **u64x2:** `all_true`, `bitmask`, `bitselect`.
//!
//! ## Floating-Point Types (f32x4, f64x2)
//!
//! `sqrt`, `abs`, `min`, `max`, `ceil`, `floor`, `trunc`, `nearest`, `pmin`, `pmax`, `bitselect`.
//!
//! **f32x4 specific:** `convert_i32x4_s/u`, `demote_f64x2_zero`.
//!
//! **f64x2 specific:** `convert_low_i32x4_s/u`, `promote_low_f32x4`.
//!
//! ## Relaxed SIMD
//!
//! Relaxed SIMD operations trade strict determinism for performance.
//! Edge-case behavior (NaN, out-of-range) is implementation-defined but consistent within a runtime.
//! Methods use the `relaxed_` prefix.
//!
//! - **FMA:** `f32x4/f64x2.relaxed_madd(b, c)` (a*b+c), `relaxed_nmadd(b, c)` (-(a*b)+c)
//! - **Min/Max:** `f32x4/f64x2.relaxed_min/max` (faster, NaN behavior varies)
//! - **Truncation:** `i32x4::relaxed_trunc_f32x4_s/u`, `relaxed_trunc_f64x2_s/u_zero`
//! - **Lane select:** `i8x16/i16x8/i32x4/i64x2.relaxed_laneselect`
//! - **Swizzle:** `i8x16.relaxed_swizzle` (out-of-range indices implementation-defined)
//! - **Q15 multiply:** `i16x8.relaxed_q15mulr_s`
//! - **Dot product:** `i16x8.relaxed_dot_i8x16_i7x16_s`, `i32x4.relaxed_dot_i8x16_i7x16_add_s`


pub type i8x16 = v128;
pub type i16x8 = v128;
pub type i32x4 = v128;
pub type i64x2 = v128;

pub type u8x16 = v128;
pub type u16x8 = v128;
pub type u32x4 = v128;
pub type u64x2 = v128;

pub type f32x4 = v128;
pub type f64x2 = v128;

impl i8x16 {
    pub fn splat(a: i32) -> i8x16 {
        return builtin::i8x16_splat(a) as i8x16;
    }

    pub fn extract_lane_s(&self, lane: i32) -> i32 {
        return match lane {
            0 => builtin::i8x16_extract_lane_s(0, *self as v128),
            1 => builtin::i8x16_extract_lane_s(1, *self as v128),
            2 => builtin::i8x16_extract_lane_s(2, *self as v128),
            3 => builtin::i8x16_extract_lane_s(3, *self as v128),
            4 => builtin::i8x16_extract_lane_s(4, *self as v128),
            5 => builtin::i8x16_extract_lane_s(5, *self as v128),
            6 => builtin::i8x16_extract_lane_s(6, *self as v128),
            7 => builtin::i8x16_extract_lane_s(7, *self as v128),
            8 => builtin::i8x16_extract_lane_s(8, *self as v128),
            9 => builtin::i8x16_extract_lane_s(9, *self as v128),
            10 => builtin::i8x16_extract_lane_s(10, *self as v128),
            11 => builtin::i8x16_extract_lane_s(11, *self as v128),
            12 => builtin::i8x16_extract_lane_s(12, *self as v128),
            13 => builtin::i8x16_extract_lane_s(13, *self as v128),
            14 => builtin::i8x16_extract_lane_s(14, *self as v128),
            _ => builtin::i8x16_extract_lane_s(15, *self as v128),
        };
    }

    pub fn extract_lane_u(&self, lane: i32) -> i32 {
        return match lane {
            0 => builtin::i8x16_extract_lane_u(0, *self as v128),
            1 => builtin::i8x16_extract_lane_u(1, *self as v128),
            2 => builtin::i8x16_extract_lane_u(2, *self as v128),
            3 => builtin::i8x16_extract_lane_u(3, *self as v128),
            4 => builtin::i8x16_extract_lane_u(4, *self as v128),
            5 => builtin::i8x16_extract_lane_u(5, *self as v128),
            6 => builtin::i8x16_extract_lane_u(6, *self as v128),
            7 => builtin::i8x16_extract_lane_u(7, *self as v128),
            8 => builtin::i8x16_extract_lane_u(8, *self as v128),
            9 => builtin::i8x16_extract_lane_u(9, *self as v128),
            10 => builtin::i8x16_extract_lane_u(10, *self as v128),
            11 => builtin::i8x16_extract_lane_u(11, *self as v128),
            12 => builtin::i8x16_extract_lane_u(12, *self as v128),
            13 => builtin::i8x16_extract_lane_u(13, *self as v128),
            14 => builtin::i8x16_extract_lane_u(14, *self as v128),
            _ => builtin::i8x16_extract_lane_u(15, *self as v128),
        };
    }

    pub fn eq(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_eq(*self as v128, *other as v128) as i8x16;
    }

    pub fn ne(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_ne(*self as v128, *other as v128) as i8x16;
    }

    pub fn lt(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_lt_s(*self as v128, *other as v128) as i8x16;
    }

    pub fn gt(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_gt_s(*self as v128, *other as v128) as i8x16;
    }

    pub fn le(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_le_s(*self as v128, *other as v128) as i8x16;
    }

    pub fn ge(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_ge_s(*self as v128, *other as v128) as i8x16;
    }

    pub fn swizzle(&self, indices: &i8x16) -> i8x16 {
        return builtin::i8x16_swizzle(*self as v128, *indices as v128) as i8x16;
    }

    pub fn abs(&self) -> i8x16 {
        return builtin::i8x16_abs(*self as v128) as i8x16;
    }

    pub fn add_sat_s(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_add_sat_s(*self as v128, *other as v128) as i8x16;
    }

    pub fn add_sat_u(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_add_sat_u(*self as v128, *other as v128) as i8x16;
    }

    pub fn sub_sat_s(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_sub_sat_s(*self as v128, *other as v128) as i8x16;
    }

    pub fn sub_sat_u(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_sub_sat_u(*self as v128, *other as v128) as i8x16;
    }

    pub fn min_s(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_min_s(*self as v128, *other as v128) as i8x16;
    }

    pub fn min_u(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_min_u(*self as v128, *other as v128) as i8x16;
    }

    pub fn max_s(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_max_s(*self as v128, *other as v128) as i8x16;
    }

    pub fn max_u(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_max_u(*self as v128, *other as v128) as i8x16;
    }

    pub fn avgr_u(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_avgr_u(*self as v128, *other as v128) as i8x16;
    }

    pub fn all_true(&self) -> bool {
        return builtin::i8x16_all_true(*self as v128);
    }

    pub fn bitmask(&self) -> i32 {
        return builtin::i8x16_bitmask(*self as v128);
    }

    pub fn narrow_i16x8_s(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_narrow_i16x8_s(*self as v128, *other as v128) as i8x16;
    }

    pub fn narrow_i16x8_u(&self, other: &i8x16) -> i8x16 {
        return builtin::i8x16_narrow_i16x8_u(*self as v128, *other as v128) as i8x16;
    }

    pub fn popcnt(&self) -> i8x16 {
        return builtin::i8x16_popcnt(*self as v128) as i8x16;
    }

    pub fn any_true(&self) -> bool {
        return builtin::v128_any_true(*self as v128);
    }

    pub fn andnot(&self, other: &i8x16) -> i8x16 {
        return builtin::v128_andnot(*self as v128, *other as v128) as i8x16;
    }

    pub fn bitselect(&self, mask: &i8x16, other: &i8x16) -> i8x16 {
        return builtin::v128_bitselect(*self as v128, *other as v128, *mask as v128) as i8x16;
    }

    pub fn relaxed_swizzle(&self, indices: &i8x16) -> i8x16 {
        return builtin::i8x16_relaxed_swizzle(*self as v128, *indices as v128) as i8x16;
    }

    pub fn relaxed_laneselect(&self, other: &i8x16, mask: &i8x16) -> i8x16 {
        return builtin::i8x16_relaxed_laneselect(*self as v128, *other as v128, *mask as v128) as i8x16;
    }
}

impl Add for i8x16 {
    type Output = i8x16;

    fn add(&self, rhs: &i8x16) -> i8x16 {
        return builtin::i8x16_add(*self as v128, *rhs as v128) as i8x16;
    }
}

impl Sub for i8x16 {
    type Output = i8x16;

    fn sub(&self, rhs: &i8x16) -> i8x16 {
        return builtin::i8x16_sub(*self as v128, *rhs as v128) as i8x16;
    }
}

impl Neg for i8x16 {
    type Output = i8x16;

    fn neg(&self) -> i8x16 {
        return builtin::i8x16_neg(*self as v128) as i8x16;
    }
}

impl BitAnd for i8x16 {
    type Output = i8x16;

    fn bitand(&self, rhs: &i8x16) -> i8x16 {
        return builtin::v128_and(*self as v128, *rhs as v128) as i8x16;
