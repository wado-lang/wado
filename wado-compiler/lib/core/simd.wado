pub struct I8x16Builder {
    vec: v128,
    index: i32,
}

impl SequenceLiteralBuilder for I8x16Builder {
    type Element = i32;
    type Output = i8x16;

    fn new_literal(capacity: i32) -> I8x16Builder {
        return I8x16Builder { vec: builtin::i8x16_splat(0), index: 0 };
    }

    fn push_literal(&mut self, value: i32) {
        let i = self.index;
        if i == 0 { self.vec = builtin::i8x16_replace_lane(0, self.vec, value); }
        else if i == 1 { self.vec = builtin::i8x16_replace_lane(1, self.vec, value); }
        else if i == 2 { self.vec = builtin::i8x16_replace_lane(2, self.vec, value); }
        else if i == 3 { self.vec = builtin::i8x16_replace_lane(3, self.vec, value); }
        else if i == 4 { self.vec = builtin::i8x16_replace_lane(4, self.vec, value); }
        else if i == 5 { self.vec = builtin::i8x16_replace_lane(5, self.vec, value); }
        else if i == 6 { self.vec = builtin::i8x16_replace_lane(6, self.vec, value); }
        else if i == 7 { self.vec = builtin::i8x16_replace_lane(7, self.vec, value); }
        else if i == 8 { self.vec = builtin::i8x16_replace_lane(8, self.vec, value); }
        else if i == 9 { self.vec = builtin::i8x16_replace_lane(9, self.vec, value); }
        else if i == 10 { self.vec = builtin::i8x16_replace_lane(10, self.vec, value); }
        else if i == 11 { self.vec = builtin::i8x16_replace_lane(11, self.vec, value); }
        else if i == 12 { self.vec = builtin::i8x16_replace_lane(12, self.vec, value); }
        else if i == 13 { self.vec = builtin::i8x16_replace_lane(13, self.vec, value); }
        else if i == 14 { self.vec = builtin::i8x16_replace_lane(14, self.vec, value); }
        else { self.vec = builtin::i8x16_replace_lane(15, self.vec, value); }
        self.index = i + 1;
    }

    fn build(&self) -> i8x16 {
        return self.vec as i8x16;
    }
}

impl SequenceLiteral for i8x16 {
    type Element = i32;
    type Builder = I8x16Builder;
}

