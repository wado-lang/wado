        return builtin::f64x2_abs(*self as v128) as f64x2;
    }

    pub fn min(&self, other: &f64x2) -> f64x2 {
        return builtin::f64x2_min(*self as v128, *other as v128) as f64x2;
    }

    pub fn max(&self, other: &f64x2) -> f64x2 {
        return builtin::f64x2_max(*self as v128, *other as v128) as f64x2;
    }

    pub fn eq(&self, other: &f64x2) -> i64x2 {
        return builtin::f64x2_eq(*self as v128, *other as v128) as i64x2;
    }

    pub fn ne(&self, other: &f64x2) -> i64x2 {
        return builtin::f64x2_ne(*self as v128, *other as v128) as i64x2;
    }

    pub fn lt(&self, other: &f64x2) -> i64x2 {
        return builtin::f64x2_lt(*self as v128, *other as v128) as i64x2;
    }

    pub fn gt(&self, other: &f64x2) -> i64x2 {
        return builtin::f64x2_gt(*self as v128, *other as v128) as i64x2;
    }

    pub fn le(&self, other: &f64x2) -> i64x2 {
        return builtin::f64x2_le(*self as v128, *other as v128) as i64x2;
    }

    pub fn ge(&self, other: &f64x2) -> i64x2 {
        return builtin::f64x2_ge(*self as v128, *other as v128) as i64x2;
    }

    pub fn select(&self, mask: &i64x2, other: &f64x2) -> f64x2 {
        return builtin::v128_bitselect(*self as v128, *other as v128, *mask as v128) as f64x2;
    }
}

