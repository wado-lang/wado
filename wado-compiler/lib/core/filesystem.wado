// Wado Filesystem Module
// High-level filesystem helpers built on top of wasi:filesystem
//
// This module provides convenient functions like read_file(), write_file(), exists(), etc.
// For raw WASI filesystem interfaces, use "wasi:filesystem" instead.

use {
    Descriptor,
    ErrorCode,
    OpenFlags,
    DescriptorFlags,
    DescriptorType,
    DescriptorStat,
    DirectoryEntry,
    FileSystem,
    Preopens,
} from "wasi:filesystem";

// Re-export types and effects for convenience
pub use {
    Descriptor,
    ErrorCode,
    OpenFlags,
    DescriptorFlags,
    DescriptorType,
    DescriptorStat,
    DirectoryEntry,
    FileSystem,
    Preopens,
} from "wasi:filesystem";

// ============================================================================
// High-level File Operations
// ============================================================================

/// Open a file for reading
pub fn open_read(path: String) -> Result<Descriptor, ErrorCode> with Preopens, FileSystem {
    let preopens = Preopens::get_directories();

    if preopens.len() == 0 {
        return Err(ErrorCode::Access);
    }

    let (root_dir, _) = preopens[0];

    return FileSystem::open_at(
        &root_dir,
        0,  // path_flags
        path,
        OpenFlags::none(),
        DescriptorFlags::Read,
    );
}

/// Open a file for writing (create if doesn't exist, truncate if exists)
pub fn open_write(path: String) -> Result<Descriptor, ErrorCode> with Preopens, FileSystem {
    let preopens = Preopens::get_directories();

    if preopens.len() == 0 {
        return Err(ErrorCode::Access);
    }

    let (root_dir, _) = preopens[0];

    return FileSystem::open_at(
        &root_dir,
        0,  // path_flags
        path,
        OpenFlags::Create | OpenFlags::Truncate,
        DescriptorFlags::Write,
    );
}

/// Open a file for appending (create if doesn't exist)
pub fn open_append(path: String) -> Result<Descriptor, ErrorCode> with Preopens, FileSystem {
    let preopens = Preopens::get_directories();

    if preopens.len() == 0 {
        return Err(ErrorCode::Access);
    }

    let (root_dir, _) = preopens[0];

    return FileSystem::open_at(
        &root_dir,
        0,  // path_flags
        path,
        OpenFlags::Create,
        DescriptorFlags::Write | DescriptorFlags::Append,
    );
}

/// Read entire file contents as stream
pub fn read_file(path: String) -> Result<Stream<u8>, ErrorCode> with Preopens, FileSystem {
    let descriptor = open_read(path)?;
    return FileSystem::read_via_stream(&descriptor, 0);
}

/// Write stream to file
pub fn write_file(path: String, data: Stream<u8>) -> Result<(), ErrorCode> with Preopens, FileSystem {
    let descriptor = open_write(path)?;
    let output_stream = FileSystem::write_via_stream(&descriptor, 0)?;

    // Copy data from input to output stream
    // (This would require stream operations not yet defined)

    return Ok(());
}

// ============================================================================
// File Information Functions
// ============================================================================

/// Check if file exists
pub fn exists(path: String) -> bool with Preopens, FileSystem {
    let preopens = Preopens::get_directories();

    if preopens.len() == 0 {
        return false;
    }

    let (root_dir, _) = preopens[0];

    match FileSystem::stat_at(&root_dir, 0, path) {
        Ok(_) => true,
        Err(_) => false,
    }
}

/// Check if path is a directory
pub fn is_directory(path: String) -> bool with Preopens, FileSystem {
    let preopens = Preopens::get_directories();

    if preopens.len() == 0 {
        return false;
    }

    let (root_dir, _) = preopens[0];

    match FileSystem::stat_at(&root_dir, 0, path) {
        Ok(stat) => stat.type == DescriptorType::Directory,
        Err(_) => false,
    }
}

/// Check if path is a regular file
pub fn is_file(path: String) -> bool with Preopens, FileSystem {
    let preopens = Preopens::get_directories();

    if preopens.len() == 0 {
        return false;
    }

    let (root_dir, _) = preopens[0];

    match FileSystem::stat_at(&root_dir, 0, path) {
        Ok(stat) => stat.type == DescriptorType::RegularFile,
        Err(_) => false,
    }
}

/// Get file size in bytes
pub fn file_size(path: String) -> Result<u64, ErrorCode> with Preopens, FileSystem {
    let preopens = Preopens::get_directories();

    if preopens.len() == 0 {
        return Err(ErrorCode::Access);
    }

    let (root_dir, _) = preopens[0];
    let stat = FileSystem::stat_at(&root_dir, 0, path)?;
    return Ok(stat.size);
}

// ============================================================================
// Directory Operations
// ============================================================================

/// List directory contents
pub fn read_dir(path: String) -> Result<Array<DirectoryEntry>, ErrorCode> with Preopens, FileSystem {
    let preopens = Preopens::get_directories();

    if preopens.len() == 0 {
        return Err(ErrorCode::Access);
    }

    let (root_dir, _) = preopens[0];
    let descriptor = FileSystem::open_at(
        &root_dir,
        0,
        path,
        OpenFlags::Directory,
        DescriptorFlags::Read,
    )?;

    return FileSystem::read_directory(&descriptor);
}

/// Create a directory
pub fn create_dir(path: String) -> Result<(), ErrorCode> with Preopens, FileSystem {
    let preopens = Preopens::get_directories();

    if preopens.len() == 0 {
        return Err(ErrorCode::Access);
    }

    let (root_dir, _) = preopens[0];
    return FileSystem::create_directory_at(&root_dir, path);
}

/// Remove a directory (must be empty)
pub fn remove_dir(path: String) -> Result<(), ErrorCode> with Preopens, FileSystem {
    let preopens = Preopens::get_directories();

    if preopens.len() == 0 {
        return Err(ErrorCode::Access);
    }

    let (root_dir, _) = preopens[0];
    return FileSystem::remove_directory_at(&root_dir, path);
}

/// Remove a file
pub fn remove_file(path: String) -> Result<(), ErrorCode> with Preopens, FileSystem {
    let preopens = Preopens::get_directories();

    if preopens.len() == 0 {
        return Err(ErrorCode::Access);
    }

    let (root_dir, _) = preopens[0];
    return FileSystem::unlink_file_at(&root_dir, path);
}

/// Rename a file or directory
pub fn rename(old_path: String, new_path: String) -> Result<(), ErrorCode> with Preopens, FileSystem {
    let preopens = Preopens::get_directories();

    if preopens.len() == 0 {
        return Err(ErrorCode::Access);
    }

    let (root_dir, _) = preopens[0];
    return FileSystem::rename_at(&root_dir, old_path, &root_dir, new_path);
}
