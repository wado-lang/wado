#![no_prelude]
#![stdlib("core:rt")]
// Wado Core Runtime Support Module (core:rt)
//
// Runtime helpers the compiler lowers to (panic, assert, CM ABI glue,
// ambient logging). Implemented in Wado itself rather than as inline Wasm
// instructions, keeping codegen simpler and the compiler more maintainable.

use { String } from "core:prelude/string.wado";
use { Array } from "core:prelude/array.wado";
use { Slice } from "core:prelude/slice.wado";
use { List } from "core:prelude/list.wado";
use { Formatter } from "core:prelude/format.wado";
use {
    Option,
    Result,
    CopyResult,
    Future,
    FutureWritable,
    Stream,
    StreamChunk,
    StreamWrite,
    StreamWritable,
    Subtask,
    WaitEvent,
    Waitable,
    WaitableSet,
    cm_subtask_settled,
} from "core:prelude/types.wado";

/// Split a packed `future.new` result (`readable | writable << 32`) into the
/// `[Future<T>, FutureWritable<T>]` pair. The parameterized canonical call is
/// emitted by CM-binding synthesis; this is the Wado-level handle split.
#[compiler_item("cm_future_pair")]
internal fn cm_future_pair<T>(packed: i64) -> [Future<T>, FutureWritable<T>] {
    let rx = packed as i32;
    let tx = (packed >> 32) as i32;
    return [rx as Future<T>, tx as FutureWritable<T>];
}

/// Split a packed `stream.new` result into the `[Stream<T>, StreamWritable<T>]`
/// pair. See [`cm_future_pair`].
#[compiler_item("cm_stream_pair")]
internal fn cm_stream_pair<T>(packed: i64) -> [Stream<T>, StreamWritable<T>] {
    let rx = packed as i32;
    let tx = (packed >> 32) as i32;
    return [rx as Stream<T>, tx as StreamWritable<T>];
}

/// Copies bytes from linear memory to a new GC array.
internal fn memory_to_gc_array(ptr: i32, len: i32) -> Array<u8> {
    let mut arr: Array<u8> = builtin::array_new(len);
    for let mut i = 0; i < len; i += 1 {
        builtin::array_set_u8(&mut arr, i, builtin::i32_load8_u(ptr + i) as u8);
    }
    return arr;
}

/// Copies bytes from linear memory to a new GC String.
#[compiler_item("memory_to_gc_string")]
internal fn memory_to_gc_string(ptr: i32, len: i32) -> String {
    let arr = memory_to_gc_array(ptr, len);
    return String::internal_from_utf8_raw(arr, len);
}

/// Copies `arr[src_start..<src_start + len]` from a GC array to linear memory.
internal fn gc_array_to_memory(arr: &Array<u8>, src_start: i32, ptr: i32, len: i32) {
    for let mut i = 0; i < len; i += 1 {
        builtin::i32_store8(ptr + i, builtin::array_get_value_u8(arr, src_start + i));
    }
}

/// Writes a string to a StreamWritable<u8> with an optional newline, then drops it.
/// Internal helper for log_stdout and log_stderr.
///
/// Uses write_raw to pass String's internal GC array directly to the stream,
/// avoiding the intermediate String → List<u8> byte-by-byte copy.
internal fn write_string_to_stream(tx: StreamWritable<u8>, message: String, add_newline: bool) {
    let len = message.len();
    if add_newline {
        let mut new_repr: Array<u8> = builtin::array_new(len + 1);
        builtin::array_copy(&mut new_repr, 0, message.internal_raw_bytes(), 0, len);
        builtin::array_set_u8(&mut new_repr, len, 10);
        tx.write_raw_all(Slice::internal_new(&new_repr, 0, len + 1));
    } else {
        tx.write_raw_all(Slice::internal_new(message.internal_raw_bytes(), 0, len));
    }
    tx.drop();
}

/// Waits for a pending async subtask to settle.
/// In WASI P3 async calling convention, canon lower async returns (handle << 4) | status:
///   status = 0 (Starting): async guest task in flight, handle is nonzero
///   status = 1 (Started):  async host task in flight, handle is nonzero
///   status = 2 (Returned): sync completion, packed value = 2, handle = 0
/// If the upper 28 bits (handle) are nonzero, an async task is in flight.
/// Each call to waitable-set.wait delivers one transition, so we loop until
/// the subtask leaves the in-flight states.
internal fn wait_for_subtask(packed: i32) with (WaitableSet, Subtask) {
    let handle = packed >> 4;
    if handle != 0 {
        let subtask = handle as Subtask;
        let ws = WaitableSet::new();
        subtask.join(&ws);
        loop {
            let event = ws.wait();
            if cm_subtask_settled(event) {
                break;
            }
        }
        subtask.drop();
        ws.drop();
    }
}

/// Drop a write_via_stream Future handle to signal completion.
/// Uses CLI ErrorCode type for the Future parameterization.
use { ErrorCode as CliErrorCode } from "wasi:cli/types.wado";
internal fn drop_cli_write_future(future: Future<Result<(), CliErrorCode>>) {
    future.drop();
}

/// Logs a message with newline to stdout (ambient, no effect required).
/// Uses builtin::call_indirect_* to bypass the effect system — this is
/// intentional for logging/debugging which must work without effects.
#[ambient]
pub fn log_stdout(message: String) {
    let [rx, tx] = Stream::<u8>::new();

    let future_handle = builtin::call_indirect_stdout_write_via_stream(rx as i32);
    write_string_to_stream(tx, message, true);
    drop_cli_write_future(future_handle as Future<Result<(), CliErrorCode>>);
}

/// Logs a message with newline to stderr (ambient, no effect required).
/// Uses builtin::call_indirect_* to bypass the effect system — this is
/// intentional for logging/debugging which must work without effects.
#[ambient]
pub fn log_stderr(message: String) {
    let [rx, tx] = Stream::<u8>::new();

    let future_handle = builtin::call_indirect_stderr_write_via_stream(rx as i32);
    write_string_to_stream(tx, message, true);
    drop_cli_write_future(future_handle as Future<Result<(), CliErrorCode>>);
}

/// Logs a message to stderr and traps.
pub fn panic(message: String) -> ! {
    log_stderr(message);
    builtin::unreachable();
}

/// Assert-failure trap. Behaves exactly like `panic`, but is a distinct callee
/// so the `-f bare-asserts` lowering can replace assertion failures with a bare
/// `unreachable` trap (dropping the diagnostic) while leaving explicit
/// `panic(...)` calls untouched. The `assert` desugar emits this, never `panic`.
#[compiler_item("assert_failed")]
internal fn assert_failed(message: String) -> ! {
    panic(message);
}

/// Traps unconditionally, marking unreachable code.
pub fn unreachable() -> ! {
    builtin::unreachable();
}

/// Lowers a GC String to CM linear memory representation.
/// Returns (ptr | (len << 32)) as i64.
/// The caller must free the allocated memory after the CM call.
#[compiler_item("cm_lower_string")]
internal fn cm_lower_string(s: String) -> i64 {
    let len = s.len();
    let bytes = s.internal_raw_bytes();
    let ptr = builtin::realloc(0, 0, 1, len);
    gc_array_to_memory(bytes, 0, ptr, len);
    return ptr as i64 | len as i64 << 32;
}

/// Lowers `data[start..<start + len]` of a GC array to CM linear memory.
/// Returns (ptr | (len << 32)) as i64.
/// The caller must free the allocated memory after the CM call.
internal fn cm_lower_list_u8(data: &Array<u8>, start: i32, len: i32) -> i64 {
    let ptr = builtin::realloc(0, 0, 1, len);
    gc_array_to_memory(data, start, ptr, len);
    return ptr as i64 | len as i64 << 32;
}

/// Lowers a GC List<u8> (e.g., FieldValue) to CM linear memory representation.
/// Returns (ptr | (len << 32)) as i64.
#[compiler_item("cm_lower_array_u8")]
internal fn cm_lower_array_u8(arr: List<u8>) -> i64 {
    let len = arr.len();
    return cm_lower_list_u8(arr.internal_raw_data_ref(), 0, len);
}

/// Writes escaped string content to a Formatter (for inspect/debug output).
/// Escapes: " → \", \ → \\, \n → \n, \t → \t, \r → \r.
/// Does NOT write the surrounding quotes — caller is responsible for those.
internal fn write_escaped_string(s: String, f: &mut Formatter) {
    for let c of s.chars() {
        match c {
            '"' => f.write_str(&"\\\""),
            '\\' => f.write_str(&"\\\\"),
            '\n' => f.write_str(&"\\n"),
            '\t' => f.write_str(&"\\t"),
            '\r' => f.write_str(&"\\r"),
            _ => f.write_char(c),
        }
    }
}

// === CM Resource Method Adapters ===
//
// These functions implement the Component Model ABI for resource operations.
// Synthesis rewrites #[cm("...")] method calls to call these adapters.

/// Await a BLOCKED stream or future copy. Returns the copy result in the same
/// `(count << 4) | status` packing the canonical returns directly, so callers
/// read the blocked and non-blocked paths identically.
///
/// The handle must be unjoined before the set is dropped; a set still holding a
/// waitable cannot be deleted.
#[compiler_item("cm_await_blocked")]
internal fn cm_await_blocked(handle: i32) -> i32 {
    let ws = builtin::waitable_set_new();
    builtin::waitable_join(handle, ws);
    let evt_ptr = builtin::realloc(0, 0, 4, 8);
    let code = builtin::waitable_set_wait(ws, evt_ptr);
    let status = builtin::i32_load(evt_ptr + 4);
    let freed = builtin::realloc(evt_ptr, 8, 4, 0);
    builtin::waitable_join(handle, 0);
    builtin::waitable_set_drop(ws);
    return status;
}

/// The `CopyResult` a packed CM copy reports (`CanonicalABI.md`): the low
/// nibble of `(count << 4) | status`.
#[compiler_item("cm_copy_result")]
internal fn cm_copy_result(packed: i32) -> CopyResult {
    let status = packed & 0xf;
    if status == 0 {
        return CopyResult::Completed;
    }
    if status == 1 {
        return CopyResult::Dropped;
    }
    return CopyResult::Cancelled;
}

/// CM adapter for stream.read(max) on Stream<u8>, awaiting a BLOCKED copy.
#[compiler_item("cm_stream_read_u8")]
internal fn cm_stream_read_u8(handle: i32, max: i32) -> StreamChunk<u8> {
    let ptr = builtin::realloc(0, 0, 1, max);
    let mut result = builtin::stream_read(handle, ptr, max);
    if result == -1 {
        result = cm_await_blocked(handle);
    }
    let count = result >> 4;
    let arr = memory_to_gc_array(ptr, count);
    let freed = builtin::realloc(ptr, max, 1, 0);
    return StreamChunk {
        items: List::internal_from_raw(arr, count),
        result: cm_copy_result(result),
    };
}

/// CM adapter for stream.write(data) on Stream<u8>: one copy, reporting what
/// the reader took. `StreamWritable::write_all` is the loop over it.
#[compiler_item("cm_stream_write_u8")]
internal fn cm_stream_write_u8(handle: i32, data: List<u8>) -> StreamWrite {
    let packed = cm_lower_array_u8(data);
    let ptr = packed as i32;
    let len = (packed >> 32) as i32;
    let written = cm_stream_write_once(handle, ptr, len);
    let freed = builtin::realloc(ptr, len, 1, 0);
    return written;
}

/// One `stream.write` of `count` elements from `ptr`, awaiting a BLOCKED copy.
internal fn cm_stream_write_once(handle: i32, ptr: i32, count: i32) -> StreamWrite {
    let mut result = builtin::stream_write(handle, ptr, count);
    if result == -1 {
        result = cm_await_blocked(handle);
    }
    return StreamWrite {
        count: result >> 4,
        result: cm_copy_result(result),
    };
}

/// CM adapter for stream.write_raw(slice) on Stream<u8>.
/// Lowers the slice's byte window to linear memory, calls stream-write, handles BLOCKED.
/// `#[inline(always)]` so the caller's `Slice` argument is scalarized away
/// (no intermediate slice `struct.new`) rather than crossing the call boundary.
#[inline(always)]
#[compiler_item("cm_stream_write_raw_u8")]
internal fn cm_stream_write_raw_u8(handle: i32, data: Slice<u8>) -> StreamWrite {
    let packed = cm_lower_list_u8(data.internal_repr(), data.internal_start(), data.len());
    let ptr = packed as i32;
    let raw_len = (packed >> 32) as i32;
    let written = cm_stream_write_once(handle, ptr, raw_len);
    let freed = builtin::realloc(ptr, raw_len, 1, 0);
    return written;
}

/// CM adapter for ErrorContext::new(msg).
/// Lowers String to linear memory, calls error-context-new, frees buffer.
#[compiler_item("cm_error_context_new")]
internal fn cm_error_context_new(msg: String) -> i32 {
    let packed = cm_lower_string(msg);
    let ptr = packed as i32;
    let len = (packed >> 32) as i32;
    let handle = builtin::error_context_new(ptr, len);
    let freed = builtin::realloc(ptr, len, 1, 0);
    return handle;
}

/// CM adapter for error_context.debug_message().
/// Calls error-context-debug-message, lifts result from linear memory to String.
#[compiler_item("cm_error_context_debug_message")]
internal fn cm_error_context_debug_message(handle: i32) -> String {
    let out_ptr = builtin::realloc(0, 0, 4, 8);
    builtin::error_context_debug_message(handle, out_ptr);
    let ptr = builtin::i32_load(out_ptr);
    let len = builtin::i32_load(out_ptr + 4);
    let freed_out = builtin::realloc(out_ptr, 8, 4, 0);
    let result = memory_to_gc_string(ptr, len);
    let freed_data = builtin::realloc(ptr, len, 1, 0);
    return result;
}

/// CM adapter for waitable_set.wait().
/// Allocates output buffer, calls waitable-set-wait, constructs WaitEvent.
#[compiler_item("cm_waitable_set_wait")]
internal fn cm_waitable_set_wait(ws: i32) -> WaitEvent {
    let out_ptr = builtin::realloc(0, 0, 4, 8);
    let code = builtin::waitable_set_wait(ws, out_ptr);
    let evt_handle = builtin::i32_load(out_ptr);
    let payload = builtin::i32_load(out_ptr + 4);
    let freed = builtin::realloc(out_ptr, 8, 4, 0);
    return WaitEvent { code, handle: evt_handle as Waitable, payload: payload as u32 };
}

#[compiler_item("cm_waitable_join")]
internal fn cm_waitable_join(handle: i32, ws: i32) -> i32 {
    builtin::waitable_join(handle, ws);
    return handle;
}

#[compiler_item("cm_waitable_set_poll")]
internal fn cm_waitable_set_poll(ws: i32) -> Option<WaitEvent> {
    let out_ptr = builtin::realloc(0, 0, 4, 8);
    let code = builtin::waitable_set_poll(ws, out_ptr);
    if code == 0 {
        let freed = builtin::realloc(out_ptr, 8, 4, 0);
        return null;
    }
    let evt_handle = builtin::i32_load(out_ptr);
    let payload = builtin::i32_load(out_ptr + 4);
    let freed = builtin::realloc(out_ptr, 8, 4, 0);
    return Option::Some(WaitEvent { code, handle: evt_handle as Waitable, payload: payload as u32 });
}
