#![no_prelude]
#![stdlib("core:rt")]
// Wado Core Runtime Support Module (core:rt)
//
// Runtime helpers the compiler lowers to (panic, assert, CM ABI glue,
// ambient logging). Implemented in Wado itself rather than as inline Wasm
// instructions, keeping codegen simpler and the compiler more maintainable.

use { String } from "core:prelude/string.wado";
use { Array } from "core:prelude/array.wado";
use { Slice } from "core:prelude/slice.wado";
use { List } from "core:prelude/list.wado";
use { Formatter } from "core:prelude/format.wado";
use { u64_bit_len } from "core:prelude/fpfmt.wado";
use { i128, u128 } from "core:prelude/int128.wado";
use { From, Inspect, struct_close, struct_field, struct_field_end, struct_open } from "core:prelude/traits.wado";
use {
    Option,
    Result,
    CopyResult,
    Future,
    FutureWritable,
    FutureWriteResult,
    Stream,
    StreamWritable,
    ReadyEvent,
    CopyBuffer,
    StartedRead,
    StartedWrite,
    WaitEvent,
    CM_BLOCKED,
    call_state,
    cm_await_copy,
    cm_packed_upper,
    copy_result,
    write_copy_is_final,
} from "core:prelude/types.wado";

/// Copies bytes from linear memory to a new GC array.
internal fn memory_to_gc_array(ptr: i32, len: i32) -> Array<u8> {
    let mut arr: Array<u8> = builtin::array_new(len);
    memory_into_gc_array(&mut arr, 0, ptr, len);
    return arr;
}

/// Copies `len` bytes from linear memory at `ptr` into `arr[at..<at + len]`.
///
/// Wasm has no copy from linear memory into a GC array, so each byte is its
/// own `array.set`. One load feeding eight of them halves the guest's cost per
/// byte, which every lift of bytes or a string pays.
internal fn memory_into_gc_array(arr: &mut Array<u8>, at: i32, ptr: i32, len: i32) {
    let mut i = 0;
    while i <= len - 8 {
        let w = builtin::i64_load(ptr + i);
        let to = at + i;
        builtin::array_set_u8(arr, to, w as u8);
        builtin::array_set_u8(arr, to + 1, (w >> 8) as u8);
        builtin::array_set_u8(arr, to + 2, (w >> 16) as u8);
        builtin::array_set_u8(arr, to + 3, (w >> 24) as u8);
        builtin::array_set_u8(arr, to + 4, (w >> 32) as u8);
        builtin::array_set_u8(arr, to + 5, (w >> 40) as u8);
        builtin::array_set_u8(arr, to + 6, (w >> 48) as u8);
        builtin::array_set_u8(arr, to + 7, (w >> 56) as u8);
        i += 8;
    }
    for ; i < len; i += 1 {
        builtin::array_set_u8(arr, at + i, builtin::i32_load8_u(ptr + i));
    }
}

/// Copies bytes from linear memory to a new GC String.
#[compiler_item("memory_to_gc_string")]
internal fn memory_to_gc_string(ptr: i32, len: i32) -> String {
    let arr = memory_to_gc_array(ptr, len);
    return String::internal_from_utf8_raw(arr, len);
}

/// Copies `arr[src_start..<src_start + len]` from a GC array to linear memory.
///
/// `array.get`s in one block share part of their bounds checks, and one store
/// writes the eight bytes they read, which every lower of bytes or a string
/// pays. Four per store measures the same.
internal fn gc_array_to_memory(arr: &Array<u8>, src_start: i32, ptr: i32, len: i32) {
    let mut i = 0;
    while i <= len - 8 {
        let at = src_start + i;
        let w = builtin::array_get_value_u8(arr, at) as i64 | builtin::array_get_value_u8(arr, at + 1) as i64 << 8 | builtin::array_get_value_u8(
            arr,
            at + 2,
        ) as i64 << 16 | builtin::array_get_value_u8(arr, at + 3) as i64 << 24 | builtin::array_get_value_u8(
            arr,
            at + 4,
        ) as i64 << 32 | builtin::array_get_value_u8(arr, at + 5) as i64 << 40 | builtin::array_get_value_u8(
            arr,
            at + 6,
        ) as i64 << 48 | builtin::array_get_value_u8(arr, at + 7) as i64 << 56;
        builtin::i64_store(ptr + i, w);
        i += 8;
    }
    for ; i < len; i += 1 {
        builtin::i32_store8(ptr + i, builtin::array_get_value_u8(arr, src_start + i));
    }
}

/// Writes a string to a StreamWritable<u8> with an optional newline, then drops it.
/// Internal helper for log_stdout and log_stderr.
///
/// Uses write_raw_all to pass String's internal GC array directly to the stream,
/// avoiding the intermediate String → List<u8> byte-by-byte copy.
internal fn write_string_to_stream(tx: StreamWritable<u8>, message: String, add_newline: bool) {
    let len = message.len();
    if add_newline {
        let mut new_repr: Array<u8> = builtin::array_new(len + 1);
        builtin::array_copy(&mut new_repr, 0, message.internal_raw_bytes(), 0, len);
        builtin::array_set_u8(&mut new_repr, len, 10);
        tx.write_raw_all(Slice::internal_new(&new_repr, 0, len + 1));
    } else {
        tx.write_raw_all(Slice::internal_new(message.internal_raw_bytes(), 0, len));
    }
    tx.drop();
}

use { ErrorCode as CliErrorCode } from "wasi:cli/types.wado";

/// Logs a message with newline to stdout (ambient, no effect required).
/// Uses builtin::call_indirect_* to bypass the effect system — this is
/// intentional for logging/debugging which must work without effects.
/// A component with no stdout drops the message: logging is best-effort.
#[ambient]
pub fn log_stdout(message: String) {
    if !builtin::ambient_stdout_available() {
        return;
    }
    let [rx, tx] = Stream::<u8>::new();

    let written = builtin::call_indirect_stdout_write_via_stream::<Result<(), CliErrorCode>>(rx);
    write_string_to_stream(tx, message, true);
    written.drop();
}

/// Logs a message with newline to stderr (ambient, no effect required).
/// Uses builtin::call_indirect_* to bypass the effect system — this is
/// intentional for logging/debugging which must work without effects.
/// A component with no stderr drops the message: logging is best-effort.
#[ambient]
pub fn log_stderr(message: String) {
    if !builtin::ambient_stderr_available() {
        return;
    }
    let [rx, tx] = Stream::<u8>::new();

    let written = builtin::call_indirect_stderr_write_via_stream::<Result<(), CliErrorCode>>(rx);
    write_string_to_stream(tx, message, true);
    written.drop();
}

/// Logs a message to stderr and traps.
pub fn panic(message: String) -> ! {
    log_stderr(message);
    builtin::unreachable();
}

/// Assert-failure trap. Behaves exactly like `panic`, but is a distinct callee
/// so the `-f bare-asserts` lowering can replace assertion failures with a bare
/// `unreachable` trap (dropping the diagnostic) while leaving explicit
/// `panic(...)` calls untouched. The `assert` desugar emits this, never `panic`.
/// `lower::bare_asserts` rewrites every call, so this body never runs.
#[compiler_item("assert_failed")]
#[coverage(off)]
internal fn assert_failed(message: String) -> ! {
    panic(message);
}

/// `builtin::i64_add128` for `-f no-wide-arithmetic`, which V8 lacks: the
/// carry out of the low word is an unsigned compare.
#[compiler_item("i64_add128_soft")]
internal fn i64_add128_soft(a_lo: i64, a_hi: i64, b_lo: i64, b_hi: i64) -> [i64, i64] {
    let lo = a_lo + b_lo;
    let carry: i64 = if (lo as u64) < a_lo as u64 { 1 } else { 0 };
    return [lo, a_hi + b_hi + carry];
}

/// `builtin::i64_sub128` for `-f no-wide-arithmetic`: the borrow out of the
/// low word is an unsigned compare.
#[compiler_item("i64_sub128_soft")]
internal fn i64_sub128_soft(a_lo: i64, a_hi: i64, b_lo: i64, b_hi: i64) -> [i64, i64] {
    let borrow: i64 = if (a_lo as u64) < b_lo as u64 { 1 } else { 0 };
    return [a_lo - b_lo, a_hi - b_hi - borrow];
}

/// `builtin::i64_mul_wide_u` for `-f no-wide-arithmetic`: the 128-bit product
/// summed from 32-bit limbs.
#[compiler_item("i64_mul_wide_u_soft")]
internal fn i64_mul_wide_u_soft(a: i64, b: i64) -> [i64, i64] {
    let low32: u64 = 0xffff_ffff;
    let [ua, ub] = [a as u64, b as u64];
    let [al, ah, bl, bh] = [ua & low32, ua >> 32, ub & low32, ub >> 32];
    let [ll, m1, m2] = [al * bl, ah * bl, al * bh];
    let carry = (ll >> 32) + (m1 & low32) + (m2 & low32);
    let low = carry << 32 | ll & low32;
    let high = ah * bh + (m1 >> 32) + (m2 >> 32) + (carry >> 32);
    return [low as i64, high as i64];
}

/// `builtin::i64_mul_wide_s` for `-f no-wide-arithmetic`: the unsigned
/// product, its high word less `b` where `a < 0` and `a` where `b < 0`.
#[compiler_item("i64_mul_wide_s_soft")]
internal fn i64_mul_wide_s_soft(a: i64, b: i64) -> [i64, i64] {
    let [low, high] = i64_mul_wide_u_soft(a, b);
    return [low, high - (b & a >> 63) - (a & b >> 63)];
}

use { CoverageHost } from "core:coverage/coverage_host.wado";

/// Whether this instance has reported each coverage region, one byte per id.
global mut COVERAGE_SEEN: Array<u8> = builtin::array_new::<u8>(0);

/// The probe `wado test --coverage` puts at the start of every region: tells
/// the host the first time region `id` runs in this instance. The host hears a
/// hit as it happens, since a test that traps cannot be entered again.
// Kept a call: inlined into every region, its fast path doubles what the
// optimizer walks under `--coverage-include=stdlib`, to speed a test run that
// spends a fraction of the compile.
#[compiler_item("coverage_probe")]
#[coverage(off)]
#[benign(CoverageHost)]
#[inline(never)]
internal fn coverage_probe(id: i32) {
    let len = builtin::array_len(&COVERAGE_SEEN);
    if id < len && builtin::array_get_value_u8(&COVERAGE_SEEN, id) != 0 {
        return;
    }
    builtin::cold_path();
    if id >= len {
        let mut grown = builtin::array_new::<u8>(if id < len * 2 { len * 2 } else { id + 1 });
        builtin::array_copy(&mut grown, 0, &COVERAGE_SEEN, 0, len);
        COVERAGE_SEEN = grown;
    }
    builtin::array_set_u8(&mut COVERAGE_SEEN, id, 1);
    CoverageHost::hit(id as u32);
}

/// Traps unconditionally, marking code no run reaches: no input, not even one
/// that breaks a contract, leads here, so reaching it is a bug in the code
/// around it. Test coverage plans no region that leads only here. Where a
/// caller can lead the run here, check the contract with `panic` or `assert`.
pub fn unreachable() -> ! {
    builtin::unreachable();
}

/// Lowers a GC String to CM linear memory representation.
/// Returns (ptr | (len << 32)) as i64.
/// The caller must free the allocated memory after the CM call.
#[compiler_item("cm_lower_string")]
internal fn cm_lower_string(s: String) -> i64 {
    let len = s.len();
    let bytes = s.internal_raw_bytes();
    let ptr = builtin::realloc(0, 0, 1, len);
    gc_array_to_memory(bytes, 0, ptr, len);
    return pack_ptr_len(ptr, len);
}

/// `(ptr | (len << 32))`, the pointer taken unsigned: one past 2 GiB would
/// otherwise sign-extend over the length.
internal fn pack_ptr_len(ptr: i32, len: i32) -> i64 {
    return ptr as u32 as i64 | len as i64 << 32;
}

/// Lowers `data[start..<start + len]` of a GC array to CM linear memory.
/// Returns (ptr | (len << 32)) as i64.
/// The caller must free the allocated memory after the CM call.
internal fn cm_lower_list_u8(data: &Array<u8>, start: i32, len: i32) -> i64 {
    let ptr = builtin::realloc(0, 0, 1, len);
    gc_array_to_memory(data, start, ptr, len);
    return pack_ptr_len(ptr, len);
}

/// Lowers a GC List<u8> (e.g., FieldValue) to CM linear memory representation.
/// Returns (ptr | (len << 32)) as i64.
#[compiler_item("cm_lower_array_u8")]
internal fn cm_lower_array_u8(arr: List<u8>) -> i64 {
    let len = arr.len();
    return cm_lower_list_u8(arr.internal_raw_data_ref(), 0, len);
}

global mut CM_CALLBACKS: List<fn()> = [];

/// The `u32` a closure crosses the Component Model boundary as: one key per
/// closure, held for the life of the instance.
#[compiler_item("cm_callback_key")]
internal fn cm_callback_key(callback: fn()) -> u32 {
    for let mut i = 0; i < CM_CALLBACKS.len(); i += 1 {
        if builtin::ref_eq(CM_CALLBACKS[i], callback) {
            return i as u32;
        }
    }
    CM_CALLBACKS.push(callback);
    return (CM_CALLBACKS.len() - 1) as u32;
}

/// The closure `key` stands for.
#[compiler_item("cm_callback")]
internal fn cm_callback(key: u32) -> fn() {
    return CM_CALLBACKS[key as i32];
}

global HANDLE_LIMIT: f64 = 9007199254740992.0;

/// The class a host-minted unrestricted handle carries, `class * stride + index`,
/// or -1 for an `f64` no host mints.
#[compiler_item("handle_class")]
internal fn handle_class(handle: f64, stride: f64) -> i32 {
    let sign_clear = builtin::i64_reinterpret_f64(handle) >= 0;
    if !(sign_clear && handle < HANDLE_LIMIT && builtin::f64_floor(handle) == handle) {
        return -1;
    }
    return builtin::f64_floor(handle / stride) as i32;
}

/// Writes an unrestricted handle as `name { type_id, object_id }`, or as
/// `name { handle }` where `class` is -1.
#[compiler_item("inspect_handle")]
internal fn inspect_handle(f: &mut Formatter, name: String, handle: f64, class: i32, stride: f64) {
    struct_open(f, name);
    if class < 0 {
        struct_field(f, "handle", true);
        handle.inspect(f);
    } else {
        struct_field(f, "type_id", true);
        class.inspect(f);
        struct_field_end(f);
        struct_field(f, "object_id", false);
        let object_id = (handle - class as f64 * stride) as i64;
        object_id.inspect(f);
    }
    struct_field_end(f);
    struct_close(f);
}

// === CM Resource Method Adapters ===
//
// These functions implement the Component Model ABI for resource operations.
// Synthesis rewrites #[cm("...")] method calls to call these adapters.

/// The packed result of a copy that answered `packed`, awaited first if it
/// answered BLOCKED. Every caller starts the copy and waits on it at once, so no
/// set can have reported it: `SETTLED_COPIES` never holds it.
#[compiler_item("cm_await_blocked")]
internal fn cm_await_blocked(handle: i32, packed: i32) -> i32 {
    if packed != CM_BLOCKED {
        return packed;
    }
    return cm_await_copy(handle);
}

/// How a future write whose packed result is `packed` ended, a BLOCKED one
/// pending. Cancellation is unreachable: no binding cancels a write.
#[compiler_item("cm_future_write_result")]
internal fn cm_future_write_result(packed: i32) -> FutureWriteResult {
    if packed == CM_BLOCKED {
        return FutureWriteResult::Pending;
    }
    return match copy_result(packed) {
        Completed => FutureWriteResult::Completed,
        Dropped => FutureWriteResult::Dropped,
        Cancelled => unreachable(),
    };
}

/// The most elements one Canonical ABI copy moves (`CanonicalABI.md`, `MAX_LENGTH`).
global CM_COPY_MAX: i32 = (1 << 28) - 1;

/// The part of `count` elements one copy may move, since a longer copy traps.
#[compiler_item("cm_copy_count")]
internal fn cm_copy_count(count: i32) -> i32 {
    return i32::min(count, CM_COPY_MAX);
}

/// The bytes `count` elements of `elem_size` take in linear memory, which an
/// `i32` must be able to count.
#[compiler_item("cm_buffer_bytes")]
internal fn cm_buffer_bytes(count: i32, elem_size: i32) -> i32 {
    // A panic rather than an assert: every program reaches this, and an assert
    // would pull the formatting of its operands into each one.
    if count < 0 || count > i32::MAX / elem_size {
        builtin::cold_path();
        panic("a buffer's length is negative or past what linear memory can address");
    }
    return count * elem_size;
}

/// CM adapter for stream.read(max) on Stream<u8>: one copy, started.
#[compiler_item("cm_stream_read_u8")]
internal fn cm_stream_read_u8(handle: i32, max: i32) -> StartedRead<u8> {
    let room = cm_buffer_bytes(cm_copy_count(max), 1);
    let ptr = builtin::realloc(0, 0, 1, room);
    let packed = builtin::stream_read(handle, ptr, room);
    return StartedRead {
        buffer: CopyBuffer { handle, packed, ptr, size: room, align: 1 },
        items: [],
    };
}

/// CM adapter for lifting the `count` bytes a read on Stream<u8> copied to
/// `ptr`.
#[compiler_item("cm_stream_lift_u8")]
internal fn cm_stream_lift_u8(handle: i32, ptr: i32, count: i32) -> List<u8> {
    return List::internal_from_raw(memory_to_gc_array(ptr, count), count);
}

/// CM adapter for stream.write(data) on Stream<u8>: one copy, started.
#[compiler_item("cm_stream_write_u8")]
internal fn cm_stream_write_u8(handle: i32, data: List<u8>) -> StartedWrite<u8> {
    let len = data.len();
    let ptr = cm_lower_list_u8(data.internal_raw_data_ref(), 0, len) as i32;
    let packed = builtin::stream_write(handle, ptr, cm_copy_count(len));
    return StartedWrite {
        buffer: CopyBuffer { handle, packed, ptr, size: len, align: 1 },
        data,
    };
}

/// One `stream.write` of up to `count` elements from `ptr`, awaiting a BLOCKED
/// copy. Returns the packed result.
internal fn cm_stream_write_once(handle: i32, ptr: i32, count: i32) -> i32 {
    return cm_await_blocked(handle, builtin::stream_write(handle, ptr, cm_copy_count(count)));
}

/// CM adapter for stream.write_raw_all(slice) on Stream<u8>. The slice is
/// lowered once, since a reader may take a short prefix of each copy.
#[compiler_item("cm_stream_write_raw_all_u8")]
internal fn cm_stream_write_raw_all_u8(handle: i32, data: Slice<u8>) -> CopyResult {
    let len = data.len();
    if len == 0 {
        return CopyResult::Completed;
    }
    let ptr = cm_lower_list_u8(data.internal_repr(), data.internal_start(), len) as i32;
    let mut taken = 0;
    loop {
        let written = cm_stream_write_once(handle, ptr + taken, len - taken);
        let delivered = cm_packed_upper(written);
        let result = copy_result(written);
        taken += delivered;
        if write_copy_is_final(result, delivered) || taken >= len {
            let freed = builtin::realloc(ptr, len, 1, 0);
            return result;
        }
    }
}

/// CM adapter for ErrorContext::new(msg).
/// Lowers String to linear memory, calls error-context-new, frees buffer.
#[compiler_item("cm_error_context_new")]
internal fn cm_error_context_new(msg: String) -> i32 {
    let packed = cm_lower_string(msg);
    let ptr = packed as i32;
    let len = (packed >> 32) as i32;
    let handle = builtin::error_context_new(ptr, len);
    let freed = builtin::realloc(ptr, len, 1, 0);
    return handle;
}

/// CM adapter for error_context.debug_message().
/// Calls error-context-debug-message, lifts result from linear memory to String.
#[compiler_item("cm_error_context_debug_message")]
internal fn cm_error_context_debug_message(handle: i32) -> String {
    let out_ptr = builtin::realloc(0, 0, 4, 8);
    builtin::error_context_debug_message(handle, out_ptr);
    let ptr = builtin::i32_load(out_ptr);
    let len = builtin::i32_load(out_ptr + 4);
    let freed_out = builtin::realloc(out_ptr, 8, 4, 0);
    let result = memory_to_gc_string(ptr, len);
    let freed_data = builtin::realloc(ptr, len, 1, 0);
    return result;
}

/// CM adapter for waitable_set.wait().
#[compiler_item("cm_waitable_set_wait")]
internal fn cm_waitable_set_wait(ws: i32) -> WaitEvent {
    let out_ptr = builtin::realloc(0, 0, 4, 8);
    let code = builtin::waitable_set_wait(ws, out_ptr);
    return cm_wait_event(code, out_ptr);
}

#[compiler_item("cm_waitable_set_poll")]
internal fn cm_waitable_set_poll(ws: i32) -> Option<WaitEvent> {
    let out_ptr = builtin::realloc(0, 0, 4, 8);
    let code = builtin::waitable_set_poll(ws, out_ptr);
    if code == 0 {
        let freed = builtin::realloc(out_ptr, 8, 4, 0);
        return null;
    }
    return Option::Some(cm_wait_event(code, out_ptr));
}

/// The event of `code` whose handle and payload the host wrote at `out_ptr`,
/// which this frees. A set holds subtasks and stream ends only, so no future
/// event arrives, and `waitable-set.wait` is lowered with `cancellable = 0`, so
/// no `TASK_CANCELLED` does.
fn cm_wait_event(code: i32, out_ptr: i32) -> WaitEvent {
    let handle = builtin::i32_load(out_ptr);
    let payload = builtin::i32_load(out_ptr + 4);
    let freed = builtin::realloc(out_ptr, 8, 4, 0);
    let event = match code {
        1 => ReadyEvent::Call(call_state(payload as u32)),
        2 | 3 => ReadyEvent::Copied(copy_result(payload)),
        _ => unreachable(),
    };
    return WaitEvent { handle, event, payload };
}

// `as` with a half on either side. No instruction converts a half, so a half
// widens to its exact `f32`, and a number reaches a half rounded once.

#[compiler_item("f16_widen")]
internal fn f16_widen(v: f16) -> f32 {
    return f32::from(v);
}

#[compiler_item("bf16_widen")]
internal fn bf16_widen(v: bf16) -> f32 {
    return f32::from(v);
}

/// Also lowers `as f16` from an integer: `f64` holds every one up to 2^53
/// exactly, and f16's range ends far below that.
#[compiler_item("f16_from_f64")]
internal fn f16_from_f64(v: f64) -> f16 {
    return f16::from_f64(v);
}

/// Also lowers `as bf16` from an integer of 32 bits or fewer, which `f64`
/// holds exactly.
#[compiler_item("bf16_from_f64")]
internal fn bf16_from_f64(v: f64) -> bf16 {
    return bf16::from_f64(v);
}

#[compiler_item("bf16_from_i64")]
internal fn bf16_from_i64(v: i64) -> bf16 {
    let magnitude = if v < 0 { 0 - v as u64 } else { v as u64 };
    return bf16::from_f64(with_sign(v < 0, round_to_odd_f64(magnitude)));
}

#[compiler_item("bf16_from_u64")]
internal fn bf16_from_u64(v: u64) -> bf16 {
    return bf16::from_f64(round_to_odd_f64(v));
}

#[compiler_item("bf16_from_i128")]
internal fn bf16_from_i128(v: i128) -> bf16 {
    let negative = v < 0;
    let magnitude = u128::from_i128(if negative { -v } else { v });
    return bf16::from_f64(with_sign(negative, round_to_odd_f64_wide(magnitude)));
}

#[compiler_item("bf16_from_u128")]
internal fn bf16_from_u128(v: u128) -> bf16 {
    return bf16::from_f64(round_to_odd_f64_wide(v));
}

/// `m` as the f64 neighbour with an odd last bit where it is inexact, so that
/// narrowing it again rounds as narrowing `m` itself would.
fn round_to_odd_f64(m: u64) -> f64 {
    let near = m as f64;
    // 2^64 is the one neighbour past u64's range, and `as u64` saturates it.
    let beyond = near >= 18446744073709551616.0 || near as u64 > m;
    let bits = near.to_bits();
    if !beyond && near as u64 == m || bits & 1 == 1 {
        return near;
    }
    return f64::from_bits(if beyond { bits - 1 } else { bits + 1 });
}

/// `m` rounded to odd as [`round_to_odd_f64`] does, for a magnitude past 64
/// bits: the top 64 keep a sticky bit for the rest, and scaling by a power of
/// two is exact.
fn round_to_odd_f64_wide(m: u128) -> f64 {
    let high = m.high();
    let low = m.low();
    if high == 0 {
        return round_to_odd_f64(low);
    }
    let n = u64_bit_len(high) as u64;
    let [top, rest] = if n == 64 { [high, low] } else { [high << 64 - n | low >> n, low << 64 - n] };
    let sticky: u64 = if rest == 0 { 0 } else { 1 };
    let scale = f64::from_bits(1023 + n << 52);
    return round_to_odd_f64(top | sticky) * scale;
}

fn with_sign(negative: bool, magnitude: f64) -> f64 {
    return if negative { -magnitude } else { magnitude };
}
