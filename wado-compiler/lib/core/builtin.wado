// Wado Core Builtin Module
//
// This module declares compiler intrinsics that are translated directly
// to Wasm instructions or imported Component Model functions.
// These are NOT regular functions - they are recognized specially by the compiler.
//
// Usage: builtin::function_name(args)
// These functions cannot be imported or called without the builtin:: prefix.
//
// Functions with #[canonical("namespace", "name")] are imported as CM canonical built-ins.
// Functions without #[canonical(...)] compile to Wasm instructions directly.

// Register libm.wat as a wasm asset for codegen. The libm functions below
// carry #[canonical("wasm:core:libm.wat", "<export>")] attributes that
// reference this asset's exports. Phase 1 of the wasm-import support
// (see docs/wep-2026-01-10-wasm-import.md) requires this `use _`
// declaration so the loader knows to embed libm.wat into the component.
use _ from "./libm.wat" with { type: "wat" };

/// Signals task completion with a result value.
/// Used internally by the compiler to complete async exports.
#[canonical("wasi", "task-return")]
fn task_return(result: i32);

/// Reinterprets an i32 value as a char (no validation, no-op at Wasm level).
/// Used internally by the stdlib for trusted conversions (e.g., UTF-8 decoding).
/// User code should use char::from_u32() or char::from_i32() instead.
fn i32_as_char(value: i32) -> char;

/// Returns the bitwise AND of two i32 values.
fn i32_and(a: i32, b: i32) -> i32;

/// Checks if an i32 is zero (returns 1 if zero, 0 otherwise).
fn i32_eqz(a: i32) -> i32;
/// Selects between two values based on a condition, without branching.
/// Returns if_true when cond is true, if_false when cond is false.
/// Both operands are evaluated eagerly.
fn select<T>(cond: bool, if_true: T, if_false: T) -> T;

/// Deep-copies a value to preserve value semantics on assignment and
/// parameter passing. Inserted at TIR build for value-semantic composite
/// types (structs, variants, tuples). The synthesis phase replaces each
/// monomorphized instance with a concrete per-type copy function tagged
/// `FunctionKind::ValueCopy`, and the TIR optimizer elides calls whose
/// argument is provably fresh.
fn copy_value<T>(value: T) -> T;
/// Returns the length of a GC array.
fn array_len(arr: builtin::array<u8>) -> i32;

/// Returns a byte from a u8 array at the given index.
fn array_get_u8(arr: builtin::array<u8>, idx: i32) -> u8;

/// Sets a byte in a u8 array at the given index.
fn array_set_u8(arr: builtin::array<u8>, idx: i32, value: u8);

/// Creates a new builtin::array<T> with given length, initialized to default values.
fn array_new<T>(len: i32) -> builtin::array<T>;

/// Returns an element from a builtin::array<T> at the given index.
fn array_get<T>(arr: builtin::array<T>, idx: i32) -> T;

/// Sets an element in a builtin::array<T> at the given index.
fn array_set<T>(arr: builtin::array<T>, idx: i32, value: T);

/// Copies elements between builtin::arrays.
/// Copies `len` elements from src[src_offset..] to dst[dst_offset..].
fn array_copy<T>(dst: builtin::array<T>, dst_offset: i32, src: builtin::array<T>, src_offset: i32, len: i32);

/// Allocates a new builtin::array<T> and copies every element of `src` into
/// it. Used by the synthesized `$value_copy$` functions to deep-copy raw
/// array fields of value-semantic structs.
fn array_clone<T>(src: builtin::array<T>) -> builtin::array<T>;

/// Fills a builtin::array<T> with a value.
/// Fills `len` elements starting at `offset` with `value`.
fn array_fill<T>(arr: builtin::array<T>, offset: i32, value: T, len: i32);
/// Loads an i32 from linear memory (Wasm i32.load).
fn i32_load(addr: i32) -> i32;

/// Stores an i32 to linear memory (Wasm i32.store).
fn i32_store(addr: i32, value: i32);

/// Loads an i64 from linear memory (Wasm i64.load).
fn i64_load(addr: i32) -> i64;

/// Stores an i64 to linear memory (Wasm i64.store).
fn i64_store(addr: i32, value: i64);

/// Loads an f32 from linear memory (Wasm f32.load).
fn f32_load(addr: i32) -> f32;

/// Stores an f32 to linear memory (Wasm f32.store).
fn f32_store(addr: i32, value: f32);

/// Loads an f64 from linear memory (Wasm f64.load).
fn f64_load(addr: i32) -> f64;

/// Stores an f64 to linear memory (Wasm f64.store).
fn f64_store(addr: i32, value: f64);

/// Loads a byte from linear memory (Wasm i32.load8_u).
fn i32_load8_u(addr: i32) -> u8;

/// Loads a u16 from linear memory (Wasm i32.load16_u).
fn i32_load16_u(addr: i32) -> u16;

/// Stores a byte to linear memory (Wasm i32.store8).
fn i32_store8(addr: i32, value: u8);

/// Stores a u16 to linear memory (Wasm i32.store16).
fn i32_store16(addr: i32, value: u16);

/// Allocates or reallocates memory in linear memory.
/// Standard WASI realloc signature.
/// The implementation is provided by bump_realloc in core:allocator.
#[canonical("mem", "realloc")]
fn realloc(oldptr: i32, oldsize: i32, align: i32, newsize: i32) -> i32;

/// Grows linear memory by delta pages, returns previous page count or -1 on failure.
/// Maps to Wasm memory.grow instruction.
fn memory_grow(delta: i32) -> i32;

/// Returns the current linear memory size in pages.
/// Maps to Wasm memory.size instruction.
fn memory_size() -> i32;

/// Fills a region of linear memory with a byte value.
/// Maps to Wasm memory.fill instruction.
fn memory_fill(dst: i32, value: u8, len: i32);
/// Sine of x (in radians)
#[canonical("wasm:core:libm.wat", "libm_sin")]
fn f64_sin(x: f64) -> f64;

/// Cosine of x (in radians)
#[canonical("wasm:core:libm.wat", "libm_cos")]
fn f64_cos(x: f64) -> f64;

/// Tangent of x (in radians)
#[canonical("wasm:core:libm.wat", "libm_tan")]
fn f64_tan(x: f64) -> f64;

/// Arc sine of x (returns radians)
#[canonical("wasm:core:libm.wat", "libm_asin")]
fn f64_asin(x: f64) -> f64;

/// Arc cosine of x (returns radians)
#[canonical("wasm:core:libm.wat", "libm_acos")]
fn f64_acos(x: f64) -> f64;

/// Arc tangent of x (returns radians)
#[canonical("wasm:core:libm.wat", "libm_atan")]
fn f64_atan(x: f64) -> f64;

/// Arc tangent of y/x, using signs to determine quadrant (returns radians)
#[canonical("wasm:core:libm.wat", "libm_atan2")]
fn f64_atan2(y: f64, x: f64) -> f64;

/// Hyperbolic sine of x
#[canonical("wasm:core:libm.wat", "libm_sinh")]
fn f64_sinh(x: f64) -> f64;

/// Hyperbolic cosine of x
#[canonical("wasm:core:libm.wat", "libm_cosh")]
fn f64_cosh(x: f64) -> f64;

/// Hyperbolic tangent of x
#[canonical("wasm:core:libm.wat", "libm_tanh")]
fn f64_tanh(x: f64) -> f64;

/// Inverse hyperbolic sine of x
#[canonical("wasm:core:libm.wat", "libm_asinh")]
fn f64_asinh(x: f64) -> f64;

/// Inverse hyperbolic cosine of x
#[canonical("wasm:core:libm.wat", "libm_acosh")]
fn f64_acosh(x: f64) -> f64;

/// Inverse hyperbolic tangent of x
#[canonical("wasm:core:libm.wat", "libm_atanh")]
fn f64_atanh(x: f64) -> f64;

/// e raised to the power x
#[canonical("wasm:core:libm.wat", "libm_exp")]
fn f64_exp(x: f64) -> f64;

/// 2 raised to the power x
#[canonical("wasm:core:libm.wat", "libm_exp2")]
fn f64_exp2(x: f64) -> f64;

/// e^x - 1 (more accurate for small x)
#[canonical("wasm:core:libm.wat", "libm_expm1")]
fn f64_expm1(x: f64) -> f64;

/// Natural logarithm (base e)
#[canonical("wasm:core:libm.wat", "libm_log")]
fn f64_ln(x: f64) -> f64;

/// Logarithm base 2
#[canonical("wasm:core:libm.wat", "libm_log2")]
fn f64_log2(x: f64) -> f64;

/// Logarithm base 10
#[canonical("wasm:core:libm.wat", "libm_log10")]
fn f64_log10(x: f64) -> f64;

/// ln(1 + x) (more accurate for small x)
#[canonical("wasm:core:libm.wat", "libm_log1p")]
fn f64_ln1p(x: f64) -> f64;

/// x raised to the power y
#[canonical("wasm:core:libm.wat", "libm_pow")]
fn f64_pow(x: f64, y: f64) -> f64;

/// Cube root of x
#[canonical("wasm:core:libm.wat", "libm_cbrt")]
fn f64_cbrt(x: f64) -> f64;

/// Euclidean distance: sqrt(x^2 + y^2)
#[canonical("wasm:core:libm.wat", "libm_hypot")]
fn f64_hypot(x: f64, y: f64) -> f64;

/// Floating-point remainder of x/y
#[canonical("wasm:core:libm.wat", "libm_fmod")]
fn f64_fmod(x: f64, y: f64) -> f64;

/// Sine of x (in radians)
#[canonical("wasm:core:libm.wat", "libm_sinf")]
fn f32_sin(x: f32) -> f32;

/// Cosine of x (in radians)
#[canonical("wasm:core:libm.wat", "libm_cosf")]
fn f32_cos(x: f32) -> f32;

/// Tangent of x (in radians)
#[canonical("wasm:core:libm.wat", "libm_tanf")]
fn f32_tan(x: f32) -> f32;

/// Arc sine of x (returns radians)
#[canonical("wasm:core:libm.wat", "libm_asinf")]
fn f32_asin(x: f32) -> f32;

/// Arc cosine of x (returns radians)
#[canonical("wasm:core:libm.wat", "libm_acosf")]
fn f32_acos(x: f32) -> f32;

/// Arc tangent of x (returns radians)
#[canonical("wasm:core:libm.wat", "libm_atanf")]
fn f32_atan(x: f32) -> f32;

/// Arc tangent of y/x, using signs to determine quadrant (returns radians)
#[canonical("wasm:core:libm.wat", "libm_atan2f")]
fn f32_atan2(y: f32, x: f32) -> f32;

/// Hyperbolic sine of x
#[canonical("wasm:core:libm.wat", "libm_sinhf")]
fn f32_sinh(x: f32) -> f32;

/// Hyperbolic cosine of x
#[canonical("wasm:core:libm.wat", "libm_coshf")]
fn f32_cosh(x: f32) -> f32;

/// Hyperbolic tangent of x
#[canonical("wasm:core:libm.wat", "libm_tanhf")]
fn f32_tanh(x: f32) -> f32;

/// Inverse hyperbolic sine of x
#[canonical("wasm:core:libm.wat", "libm_asinhf")]
fn f32_asinh(x: f32) -> f32;

/// Inverse hyperbolic cosine of x
#[canonical("wasm:core:libm.wat", "libm_acoshf")]
fn f32_acosh(x: f32) -> f32;

/// Inverse hyperbolic tangent of x
#[canonical("wasm:core:libm.wat", "libm_atanhf")]
fn f32_atanh(x: f32) -> f32;

/// e raised to the power x
#[canonical("wasm:core:libm.wat", "libm_expf")]
fn f32_exp(x: f32) -> f32;

/// 2 raised to the power x
#[canonical("wasm:core:libm.wat", "libm_exp2f")]
fn f32_exp2(x: f32) -> f32;

/// e^x - 1 (more accurate for small x)
#[canonical("wasm:core:libm.wat", "libm_expm1f")]
fn f32_expm1(x: f32) -> f32;

/// Natural logarithm (base e)
#[canonical("wasm:core:libm.wat", "libm_logf")]
fn f32_ln(x: f32) -> f32;

/// Logarithm base 2
#[canonical("wasm:core:libm.wat", "libm_log2f")]
fn f32_log2(x: f32) -> f32;

/// Logarithm base 10
#[canonical("wasm:core:libm.wat", "libm_log10f")]
fn f32_log10(x: f32) -> f32;

/// ln(1 + x) (more accurate for small x)
#[canonical("wasm:core:libm.wat", "libm_log1pf")]
fn f32_ln1p(x: f32) -> f32;

/// x raised to the power y
#[canonical("wasm:core:libm.wat", "libm_powf")]
fn f32_pow(x: f32, y: f32) -> f32;

/// Cube root of x
#[canonical("wasm:core:libm.wat", "libm_cbrtf")]
fn f32_cbrt(x: f32) -> f32;

/// Euclidean distance: sqrt(x^2 + y^2)
#[canonical("wasm:core:libm.wat", "libm_hypotf")]
fn f32_hypot(x: f32, y: f32) -> f32;

/// Floating-point remainder of x/y
#[canonical("wasm:core:libm.wat", "libm_fmodf")]
fn f32_fmod(x: f32, y: f32) -> f32;
/// Performs 128-bit addition: (a_lo, a_hi) + (b_lo, b_hi) = (result_lo, result_hi).
/// Maps to Wasm i64.add128 instruction.
fn i64_add128(a_lo: i64, a_hi: i64, b_lo: i64, b_hi: i64) -> [i64, i64];

/// Performs 128-bit subtraction: (a_lo, a_hi) - (b_lo, b_hi) = (result_lo, result_hi).
/// Maps to Wasm i64.sub128 instruction.
fn i64_sub128(a_lo: i64, a_hi: i64, b_lo: i64, b_hi: i64) -> [i64, i64];

/// Performs 64x64 unsigned multiplication producing a 128-bit result.
/// Maps to Wasm i64.mul_wide_u instruction.
fn i64_mul_wide_u(a: i64, b: i64) -> [i64, i64];

/// Performs 64x64 signed multiplication producing a 128-bit result.
/// Maps to Wasm i64.mul_wide_s instruction.
fn i64_mul_wide_s(a: i64, b: i64) -> [i64, i64];
/// Counts the leading zeros in a 32-bit integer.
/// Maps to Wasm i32.clz instruction.
fn i32_clz(x: i32) -> i32;

/// Counts the trailing zeros in a 32-bit integer.
/// Maps to Wasm i32.ctz instruction.
fn i32_ctz(x: i32) -> i32;

/// Counts the number of set bits (population count) in a 32-bit integer.
/// Maps to Wasm i32.popcnt instruction.
fn i32_popcnt(x: i32) -> i32;

/// Counts the leading zeros in a 64-bit integer.
/// Maps to Wasm i64.clz instruction.
fn i64_clz(x: i64) -> i64;

/// Counts the trailing zeros in a 64-bit integer.
/// Maps to Wasm i64.ctz instruction.
fn i64_ctz(x: i64) -> i64;

/// Counts the number of set bits (population count) in a 64-bit integer.
/// Maps to Wasm i64.popcnt instruction.
fn i64_popcnt(x: i64) -> i64;
/// Reinterprets the bits of an f64 as an i64 (no conversion, just bit cast).
/// Maps to Wasm i64.reinterpret_f64 instruction.
fn i64_reinterpret_f64(f: f64) -> i64;

/// Reinterprets the bits of an i64 as an f64 (no conversion, just bit cast).
/// Maps to Wasm f64.reinterpret_i64 instruction.
fn f64_reinterpret_i64(i: i64) -> f64;

/// Reinterprets the bits of an f32 as an i32 (no conversion, just bit cast).
/// Maps to Wasm i32.reinterpret_f32 instruction.
fn i32_reinterpret_f32(f: f32) -> i32;

/// Reinterprets the bits of an i32 as an f32 (no conversion, just bit cast).
/// Maps to Wasm f32.reinterpret_i32 instruction.
fn f32_reinterpret_i32(i: i32) -> f32;
/// Traps unconditionally, marking unreachable code.
fn unreachable() -> !;

// =========================================================================
// CM canonical intrinsics (raw flat ABI signatures)
//
// These are the low-level canonical built-in functions imported from the
// Component Model runtime.  Each maps 1:1 to a `canon` instruction.
// Higher-level Wado APIs (Stream, Future, WaitableSet, …) are implemented
// as adapter functions in core:internal that call these builtins.
// =========================================================================

// --- Stream ---

/// Create a new stream pair.  Returns packed (readable | writable << 32).
#[canonical("wasi", "stream-new")]
fn stream_new() -> i64;

/// Read up to `max` bytes from a readable stream into linear memory at `ptr`.
/// Returns packed (count << 4 | status), or -1 if BLOCKED.
#[canonical("wasi", "stream-read")]
fn stream_read(handle: i32, ptr: i32, max: i32) -> i32;

/// Write `len` bytes from linear memory at `ptr` to a writable stream.
/// Returns packed status, or -1 if BLOCKED.
#[canonical("wasi", "stream-write")]
fn stream_write(handle: i32, ptr: i32, len: i32) -> i32;

/// Cancel an in-progress read on a readable stream.
#[canonical("wasi", "stream-cancel-read")]
fn stream_cancel_read(handle: i32) -> i32;

/// Cancel an in-progress write on a writable stream.
#[canonical("wasi", "stream-cancel-write")]
fn stream_cancel_write(handle: i32) -> i32;

/// Drop a readable stream handle.
#[canonical("wasi", "stream-drop-readable")]
fn stream_drop_readable(handle: i32);

/// Drop a writable stream handle.
#[canonical("wasi", "stream-drop-writable")]
fn stream_drop_writable(handle: i32);

// --- Future ---

/// Create a new future pair.  Returns packed (readable | writable << 32).
/// Import name is parameterised by payload type (e.g. "future-new:s32").
#[canonical("wasi", "future-new")]
fn future_new() -> i64;

/// Read the value from a future.  `ptr` points to an output buffer.
/// Returns packed status, or -1 if BLOCKED.
#[canonical("wasi", "future-read")]
fn future_read(handle: i32, ptr: i32) -> i32;

/// Write a value into a future.  `ptr` points to the value in linear memory.
/// Returns packed status, or -1 if BLOCKED.
#[canonical("wasi", "future-write")]
fn future_write(handle: i32, ptr: i32) -> i32;

/// Cancel an in-progress read on a future.
#[canonical("wasi", "future-cancel-read")]
fn future_cancel_read(handle: i32) -> i32;

/// Cancel an in-progress write on a future.
#[canonical("wasi", "future-cancel-write")]
fn future_cancel_write(handle: i32) -> i32;

/// Drop a readable future handle.
#[canonical("wasi", "future-drop-readable")]
fn future_drop_readable(handle: i32);

/// Drop a writable future handle.
#[canonical("wasi", "future-drop-writable")]
fn future_drop_writable(handle: i32);

// --- WaitableSet ---

/// Create a new waitable set.  Returns a handle (i32).
#[canonical("wasi", "waitable-set-new")]
fn waitable_set_new() -> i32;

/// Block until an event fires.  Writes (handle, payload) to `outptr`.
/// Returns the event code (i32).
#[canonical("wasi", "waitable-set-wait")]
fn waitable_set_wait(ws: i32, outptr: i32) -> i32;

/// Non-blocking poll.  Writes (handle, payload) to `outptr`.
/// Returns the event code, or 0 if no event is ready.
#[canonical("wasi", "waitable-set-poll")]
fn waitable_set_poll(ws: i32, outptr: i32) -> i32;

/// Drop a waitable set.
#[canonical("wasi", "waitable-set-drop")]
fn waitable_set_drop(ws: i32);

// --- Subtask / Waitable ---

/// Compiler intrinsic: lift a CM async result of type `T` from the linear
/// memory buffer at `outptr`. Expanded by the `lower` phase into an
/// inline [`synthesize_lift_with_context`] invocation once `T` is
/// resolved to a concrete type.
///
/// Used internally by `AsyncCall<T>::wait` to materialise the async
/// result. Should not be called from user code; there is no protection
/// against invoking it on an uninitialised buffer.
fn cm_lift_async_result<T>(outptr: i32) -> T;

/// Drop a completed subtask.
#[canonical("wasi", "subtask-drop")]
fn subtask_drop(handle: i32);

/// Cancel an in-progress subtask.
#[canonical("wasi", "subtask-cancel")]
fn subtask_cancel(handle: i32);

/// Join a waitable (subtask/stream/future) to a waitable set.
/// Returns a Waitable token.  The canonical returns void; we return
/// the original handle so callers can use it as the Waitable identity.
#[canonical("wasi", "waitable-join")]
fn waitable_join(handle: i32, ws: i32);

// --- ErrorContext ---

/// Create a new error context from a string in linear memory.
#[canonical("wasi", "error-context-new")]
fn error_context_new(ptr: i32, len: i32) -> i32;

/// Read the debug message into an (ptr, len) pair at `outptr`.
#[canonical("wasi", "error-context-debug-message")]
fn error_context_debug_message(handle: i32, outptr: i32);

/// Drop an error context handle.
#[canonical("wasi", "error-context-drop")]
fn error_context_drop(handle: i32);

// --- Backpressure ---

/// Increment the backpressure counter.
#[canonical("wasi", "backpressure-inc")]
fn backpressure_inc();

/// Decrement the backpressure counter.
#[canonical("wasi", "backpressure-dec")]
fn backpressure_dec();

// --- Context ---

/// Get the value of a task-local context slot.
#[canonical("wasi", "context-get")]
fn context_get(slot: i32) -> i32;

/// Set the value of a task-local context slot.
#[canonical("wasi", "context-set")]
fn context_set(slot: i32, value: i32);

// --- Task ---

/// Acknowledge cancellation of the current task.
#[canonical("wasi", "task-cancel")]
fn task_cancel();

// --- Thread ---

/// Yield control to other threads.
#[canonical("wasi", "thread-yield")]
fn thread_yield(cancellable: i32);

/// Returns the index of the current thread.
#[canonical("wasi", "thread-index")]
fn thread_index() -> i32;

/// Create a new thread via indirect call.
#[canonical("wasi", "thread-new-indirect")]
fn thread_new_indirect(func_type_index: i32, table_index: i32);

/// Suspend and switch to a suspended thread.
#[canonical("wasi", "thread-suspend-to-suspended")]
fn thread_suspend_to_suspended(target: i32, cancellable: i32);

/// Suspend the current thread.
#[canonical("wasi", "thread-suspend")]
fn thread_suspend(cancellable: i32) -> i32;

/// Suspend and switch to another thread.
#[canonical("wasi", "thread-suspend-to")]
fn thread_suspend_to(target: i32, cancellable: i32) -> i32;

/// Schedule a suspended thread to resume.
#[canonical("wasi", "thread-unsuspend")]
fn thread_unsuspend(target: i32);

/// Yield to a suspended thread and resume when done.
#[canonical("wasi", "thread-yield-to-suspended")]
fn thread_yield_to_suspended(target: i32, cancellable: i32);

/// Calls stdout's write_via_stream indirectly (ambient, no effect required).
/// Returns the subtask handle for the async operation.
/// Internal only: used by core:internal for ambient logging (panic, assert).
/// Public API should use Stdout::write_via_stream() through the effect system.
fn call_indirect_stdout_write_via_stream(rx: i32) -> i32;

/// Calls stderr's write_via_stream indirectly (ambient, no effect required).
/// Returns the subtask handle for the async operation.
/// Internal only: used by core:internal for ambient logging (panic, assert).
/// Public API should use Stderr::write_via_stream() through the effect system.
fn call_indirect_stderr_write_via_stream(rx: i32) -> i32;
/// Absolute value of f32
/// Maps to Wasm f32.abs instruction
fn f32_abs(x: f32) -> f32;

/// Absolute value of f64
/// Maps to Wasm f64.abs instruction
fn f64_abs(x: f64) -> f64;

/// Ceiling of f32 (round toward +infinity)
/// Maps to Wasm f32.ceil instruction
fn f32_ceil(x: f32) -> f32;

/// Ceiling of f64 (round toward +infinity)
/// Maps to Wasm f64.ceil instruction
fn f64_ceil(x: f64) -> f64;

/// Floor of f32 (round toward -infinity)
/// Maps to Wasm f32.floor instruction
fn f32_floor(x: f32) -> f32;

/// Floor of f64 (round toward -infinity)
/// Maps to Wasm f64.floor instruction
fn f64_floor(x: f64) -> f64;

/// Truncate f32 toward zero
/// Maps to Wasm f32.trunc instruction
fn f32_trunc(x: f32) -> f32;

/// Truncate f64 toward zero
/// Maps to Wasm f64.trunc instruction
fn f64_trunc(x: f64) -> f64;

/// Round f32 to nearest even
/// Maps to Wasm f32.nearest instruction
fn f32_nearest(x: f32) -> f32;

/// Round f64 to nearest even
/// Maps to Wasm f64.nearest instruction
fn f64_nearest(x: f64) -> f64;

/// Square root of f32
/// Maps to Wasm f32.sqrt instruction
fn f32_sqrt(x: f32) -> f32;

/// Square root of f64
/// Maps to Wasm f64.sqrt instruction
fn f64_sqrt(x: f64) -> f64;

/// Minimum of two f32 values
/// Maps to Wasm f32.min instruction
fn f32_min(a: f32, b: f32) -> f32;

/// Minimum of two f64 values
