fn i64x2_extmul_high_i32x4_s(a: v128, b: v128) -> v128;
/// Extended multiply (low half, unsigned) of i32x4 to i64x2.
fn i64x2_extmul_low_i32x4_u(a: v128, b: v128) -> v128;
/// Extended multiply (high half, unsigned) of i32x4 to i64x2.
fn i64x2_extmul_high_i32x4_u(a: v128, b: v128) -> v128;
/// Ceiling of f32x4 lanes.
fn f32x4_ceil(a: v128) -> v128;
/// Floor of f32x4 lanes.
fn f32x4_floor(a: v128) -> v128;
/// Truncate f32x4 lanes toward zero.
fn f32x4_trunc(a: v128) -> v128;
/// Round f32x4 lanes to nearest even.
fn f32x4_nearest(a: v128) -> v128;
/// Pseudo-minimum of f32x4 lanes (returns b if a > b, else a).
fn f32x4_pmin(a: v128, b: v128) -> v128;
/// Pseudo-maximum of f32x4 lanes (returns b if b > a, else a).
fn f32x4_pmax(a: v128, b: v128) -> v128;
/// Convert i32x4 (signed) to f32x4.
fn f32x4_convert_i32x4_s(a: v128) -> v128;
/// Convert i32x4 (unsigned) to f32x4.
fn f32x4_convert_i32x4_u(a: v128) -> v128;
/// Demote f64x2 to f32x4 with zero-extended low lanes.
fn f32x4_demote_f64x2_zero(a: v128) -> v128;
/// Ceiling of f64x2 lanes.
fn f64x2_ceil(a: v128) -> v128;
/// Floor of f64x2 lanes.
fn f64x2_floor(a: v128) -> v128;
/// Truncate f64x2 lanes toward zero.
fn f64x2_trunc(a: v128) -> v128;
/// Round f64x2 lanes to nearest even.
fn f64x2_nearest(a: v128) -> v128;
/// Pseudo-minimum of f64x2 lanes (returns b if a > b, else a).
fn f64x2_pmin(a: v128, b: v128) -> v128;
/// Pseudo-maximum of f64x2 lanes (returns b if b > a, else a).
fn f64x2_pmax(a: v128, b: v128) -> v128;
/// Convert low i32x4 lanes (signed) to f64x2.
fn f64x2_convert_low_i32x4_s(a: v128) -> v128;
/// Convert low i32x4 lanes (unsigned) to f64x2.
fn f64x2_convert_low_i32x4_u(a: v128) -> v128;
/// Promote low f32x4 lanes to f64x2.
fn f64x2_promote_low_f32x4(a: v128) -> v128;
/// Relaxed swizzle of i8x16 lanes (out-of-range indices are implementation-defined).
fn i8x16_relaxed_swizzle(a: v128, indices: v128) -> v128;
/// Relaxed lane select for i8x16 (implementation-defined whether bitselect or lane-wise).
fn i8x16_relaxed_laneselect(a: v128, b: v128, mask: v128) -> v128;
/// Relaxed lane select for i16x8.
fn i16x8_relaxed_laneselect(a: v128, b: v128, mask: v128) -> v128;
/// Relaxed lane select for i32x4.
fn i32x4_relaxed_laneselect(a: v128, b: v128, mask: v128) -> v128;
/// Relaxed lane select for i64x2.
fn i64x2_relaxed_laneselect(a: v128, b: v128, mask: v128) -> v128;
/// Relaxed fused multiply-add for f32x4: a * b + c (implementation-defined precision).
fn f32x4_relaxed_madd(a: v128, b: v128, c: v128) -> v128;
/// Relaxed fused negative multiply-add for f32x4: -(a * b) + c.
fn f32x4_relaxed_nmadd(a: v128, b: v128, c: v128) -> v128;
/// Relaxed fused multiply-add for f64x2: a * b + c (implementation-defined precision).
fn f64x2_relaxed_madd(a: v128, b: v128, c: v128) -> v128;
/// Relaxed fused negative multiply-add for f64x2: -(a * b) + c.
fn f64x2_relaxed_nmadd(a: v128, b: v128, c: v128) -> v128;
/// Relaxed minimum of f32x4 lanes (NaN handling is implementation-defined).
fn f32x4_relaxed_min(a: v128, b: v128) -> v128;
/// Relaxed maximum of f32x4 lanes (NaN handling is implementation-defined).
fn f32x4_relaxed_max(a: v128, b: v128) -> v128;
/// Relaxed minimum of f64x2 lanes (NaN handling is implementation-defined).
fn f64x2_relaxed_min(a: v128, b: v128) -> v128;
/// Relaxed maximum of f64x2 lanes (NaN handling is implementation-defined).
fn f64x2_relaxed_max(a: v128, b: v128) -> v128;
/// Relaxed truncation of f32x4 to i32x4 (signed, out-of-range is implementation-defined).
fn i32x4_relaxed_trunc_f32x4_s(a: v128) -> v128;
/// Relaxed truncation of f32x4 to i32x4 (unsigned, out-of-range is implementation-defined).
fn i32x4_relaxed_trunc_f32x4_u(a: v128) -> v128;
/// Relaxed truncation of f64x2 to i32x4 (signed, zero-extended, out-of-range is implementation-defined).
fn i32x4_relaxed_trunc_f64x2_s_zero(a: v128) -> v128;
/// Relaxed truncation of f64x2 to i32x4 (unsigned, zero-extended, out-of-range is implementation-defined).
fn i32x4_relaxed_trunc_f64x2_u_zero(a: v128) -> v128;
