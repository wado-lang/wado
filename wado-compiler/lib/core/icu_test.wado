use icu from "core:icu";
use { Properties } from "core:icu";

test "a property named in the source needs no name lookup" {
    assert icu::has(Properties::BinaryProperty::Uppercase, 'À');
    assert !icu::has(Properties::BinaryProperty::Uppercase, 'à');
    assert icu::set(Properties::BinaryProperty::WhiteSpace)[0] == [9, 13];
    assert icu::set(Properties::BinaryProperty::HexDigit)[0] == [48, 57];
}

test "the two paths answer with the same set" {
    assert icu::set(Properties::BinaryProperty::WhiteSpace) == icu::ranges("White_Space").unwrap();
    assert icu::set(Properties::BinaryProperty::HexDigit) == icu::ranges("Hex_Digit").unwrap();
    assert icu::has(Properties::BinaryProperty::Math, '+') == icu::contains("Math", '+').unwrap();
}

test "an enumerated property takes its value" {
    assert icu::value_ranges("gc", "Lu").unwrap()[0] == [65, 90];
    assert icu::value_ranges("sc", "Hiragana").unwrap()[0] == [12353, 12438];
}

test "a General_Category value may name a group" {
    let group = icu::value_ranges("gc", "L").unwrap();
    assert group[0] == [65, 90];
    assert group[1] == [97, 122];
}

test "a name matches as UAX 44 matches it" {
    assert icu::ranges("white space") == icu::ranges("WSpace");
    assert icu::value_ranges("General_Category", "uppercase letter") == icu::value_ranges("gc", "Lu");
}

test "one character is answered without building the ranges" {
    assert icu::contains("Uppercase", 'À').unwrap();
    assert !icu::contains("Uppercase", 'à').unwrap();
    assert icu::value_contains("gcb", "Regional_Indicator", '\u{1F1EF}').unwrap();
}

// A caller complementing an approximate set would admit real members of the
// property, which is the failure that matters for a `\P{...}` in a grammar.
test "a name this build does not answer is null, not an empty set" {
    assert icu::ranges("Other_ID_Start") matches { None };
    assert icu::ranges("Other_Alphabetic") matches { None };
    assert icu::value_ranges("blk", "Greek") matches { None };
    assert icu::value_ranges("dt", "Font") matches { None };
    assert icu::contains("Other_Math", 'x') matches { None };
}

test "a collator sorts as its locale does" {
    let german = icu::Collator::new("de").unwrap();
    let swedish = icu::Collator::new("sv").unwrap();
    // German sorts `ä` with `a`; Swedish sorts it after `z`.
    assert german.compare(&"ä", &"z") matches { Less };
    assert swedish.compare(&"ä", &"z") matches { Greater };
    assert german.compare(&"a", &"a") matches { Equal };
}

test "a locale CLDR tailors nothing for falls back to the root collation" {
    let root = icu::Collator::new("und").unwrap();
    let english = icu::Collator::new("en").unwrap();
    assert root.compare(&"e", &"é") matches { Less };
    assert english.compare(&"e", &"é") matches { Less };
}

test "a tag that does not parse is refused" {
    let refused = icu::Collator::new("not a tag!");
    assert refused matches { Err(_) };
}
