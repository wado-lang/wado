use icu from "core:icu";
use { BinaryProperty, GeneralCategoryGroup, GraphemeClusterBreak, Locale, Property, Script } from "core:icu";

test "a binary property answers its set" {
    assert icu::contains(BinaryProperty::Uppercase, 'À');
    assert !icu::contains(BinaryProperty::Uppercase, 'à');
    assert icu::ranges(BinaryProperty::WhiteSpace)[0] == [9, 13];
    assert icu::ranges(BinaryProperty::HexDigit)[0] == [48, 57];
}

test "an enumerated property answers the set of one value" {
    assert icu::ranges(GeneralCategoryGroup::UppercaseLetter)[0] == [65, 90];
    assert icu::ranges(Script::Hiragana)[0] == [12353, 12438];
    assert icu::contains(GraphemeClusterBreak::RegionalIndicator, '\u{1F1EF}');
    assert !icu::contains(Script::Hiragana, 'ア');
}

test "a General_Category group spans its categories" {
    let group = icu::ranges(GeneralCategoryGroup::Letter);
    assert group[0] == [65, 90];
    assert group[1] == [97, 122];
    assert icu::contains(GeneralCategoryGroup::Letter, 'a');
    assert !icu::contains(GeneralCategoryGroup::Letter, '1');
}

test "a strict name is spelled as UCD spells it" {
    assert BinaryProperty::from_str("White_Space") == Result::Ok(BinaryProperty::WhiteSpace);
    assert BinaryProperty::from_str("WSpace") == Result::Ok(BinaryProperty::WhiteSpace);
    assert Script::from_str("Hira") == Result::Ok(Script::Hiragana);
    assert BinaryProperty::from_str("white space") matches { Err(_) };
    assert Script::from_str("hiragana") matches { Err(_) };
}

test "a lenient name matches as UAX 44 matches it" {
    assert BinaryProperty::from_str_lenient("white space") == Result::Ok(BinaryProperty::WhiteSpace);
    assert Script::from_str_lenient("HIRAGANA") == Result::Ok(Script::Hiragana);
    assert GeneralCategoryGroup::from_str_lenient("uppercase letter") == Result::Ok(
        GeneralCategoryGroup::UppercaseLetter,
    );
    assert GeneralCategoryGroup::from_str_lenient("l") == Result::Ok(GeneralCategoryGroup::Letter);
}

test "a property takes a value after `=`, or is binary without one" {
    assert Property::from_str("sc=Hira") == Result::Ok(Property::Script(Script::Hiragana));
    assert Property::from_str("General_Category=Lu") == Result::Ok(Property::GeneralCategoryGroup(
        GeneralCategoryGroup::UppercaseLetter,
    ));
    assert Property::from_str("Math") == Result::Ok(Property::BinaryProperty(BinaryProperty::Math));
    assert Property::from_str_lenient("gcb = regional indicator") == Result::Ok(Property::GraphemeClusterBreak(
        GraphemeClusterBreak::RegionalIndicator,
    ));
    assert Property::from_str_lenient("white space") == Result::Ok(Property::BinaryProperty(BinaryProperty::WhiteSpace));
    assert icu::contains(Property::from_str("sc=Hira").unwrap(), 'あ');
    assert icu::ranges(Property::from_str("WSpace").unwrap())[0] == [9, 13];
}

// Each property has its own exports and its own generated impls, so each is
// asked once: its strict and lenient names, its refusal, and its set.
test "every property answers through its own exports" {
    let cases: List<[String, String, char]> = [
        ["gc=Lu", "general category = uppercase letter", 'A'],
        ["bc=L", "bidi_class=left to right", 'A'],
        ["ccc=NR", "canonical combining class=not reordered", 'A'],
        ["ea=Na", "east asian width=narrow", 'A'],
        ["GCB=CR", "grapheme cluster break=cr", '\r'],
        ["hst=L", "hangul syllable type=leading jamo", '\u{1100}'],
        ["InCB=None", "indic conjunct break=none", 'A'],
        ["InSC=Other", "indic syllabic category=other", 'A'],
        ["jg=No_Joining_Group", "joining group=no joining group", 'A'],
        ["jt=U", "joining type=non joining", 'A'],
        ["lb=AL", "line break=alphabetic", 'A'],
        ["nt=De", "numeric type=decimal", '1'],
        ["sc=Latn", "script=latin", 'A'],
        ["SB=UP", "sentence break=upper", 'A'],
        ["vo=R", "vertical orientation=rotated", 'A'],
        ["WB=LE", "word break=aletter", 'A'],
    ];
    assert icu::contains(Property::from_str("Alpha").unwrap(), 'A');
    assert Property::from_str("Nope") matches { Err(_) };
    assert Property::from_str_lenient("nope") matches { Err(_) };
    for let [strict, lenient, member] of cases {
        let property = Property::from_str(&strict).unwrap();
        assert Property::from_str_lenient(&lenient) == Result::Ok(property), lenient;
        assert icu::contains(property, member), strict;
        assert icu::ranges(property).len() > 0, strict;
        let [name, _] = strict.split_once("=").unwrap();
        assert Property::from_str(`${name}=Nope`) matches { Err(_) }, strict;
        assert Property::from_str_lenient(`${name}=Nope`) matches { Err(_) }, strict;
    }
}

// A caller complementing an approximate set would admit real members of the
// property, which is the failure that matters for a `\P{...}` in a grammar.
test "a name this build does not answer is refused, not an empty set" {
    assert BinaryProperty::from_str_lenient("Other_ID_Start") matches { Err(_) };
    assert BinaryProperty::from_str_lenient("Other_Alphabetic") matches { Err(_) };
    assert Property::from_str_lenient("blk=Greek") matches { Err(_) };
    assert Property::from_str_lenient("dt=Font") matches { Err(_) };
    assert Property::from_str_lenient("sc=Klingon") matches { Err(_) };
    let Err(property) = Property::from_str("blk=Greek") else {
        panic("a property this build lacks must be refused");
    };
    assert `${property}` == "\"blk=Greek\" is not a property=value pair";
    let Err(script) = Script::from_str("Klingon") else {
        panic("a script this build lacks must be refused");
    };
    assert `${script}` == "\"Klingon\" is not a value of Script";
}

test "a locale keeps the language, script and region, in canonical case" {
    assert `${Locale::from("sR-latn-rs")}` == "sr-Latn-RS";
    assert `${Locale::from("zh-Hant")}` == "zh-Hant";
    assert `${Locale::from("es-419")}` == "es-419";
    assert `${Locale::from("und")}` == "und";
    assert Locale::from("EN-us") == Locale::from("en-US");
}

test "a locale drops variants and extensions" {
    assert `${Locale::from("de-DE-1996-u-co-phonebk-x-private")}` == "de-DE";
    assert `${Locale::from("sl-rozaj-biske")}` == "sl";
    assert `${Locale::from("ca-ES-valencia")}` == "ca-ES";
    assert `${Locale::from("ja-t-it-m0-xxx")}` == "ja";
}

test "a well-formed tag is accepted" {
    for let tag of [
        "en",
        "haw-US",
        "en-1994",
        "en-u-ca-gregory-nu-latn",
        "en-u-attr-ca-gregory",
        "und-t-en-h0-hybrid",
        "en-t-k0-qwerty",
        "en-a-bbb-x-a-b",
        "en-x-1",
        "sl-rozaj-biske",
        "en-a-bbb-b-ccc",
        // A repeated `u` key is allowed; the first is the one that counts.
        "en-u-ca-gregory-ca-buddhist",
    ] {
        assert Locale::is_well_formed(tag), tag;
    }
}

test "a tag that is not well-formed is refused" {
    for let tag of [
        "",
        "e",
        "en-",
        "-en",
        "en--US",
        "en_US",
        "root",
        "x-private",
        "1en",
        "en-USA",
        "en-u",
        "en-u-a1",
        "en-t",
        "en-t-k0",
        "en-a",
        "en-a-b",
        "en-x",
        "en-x-toolongsub",
        "en-ü",
        // UTS #35 forbids a repeated variant or extension singleton, which the
        // grammar alone admits.
        "en-1994-1994",
        "sl-rozaj-ROZAJ",
        "en-t-sl-rozaj-rozaj",
        "en-a-bbb-a-ccc",
        "de-u-co-phonebk-U-kn",
    ] {
        assert !Locale::is_well_formed(tag), tag;
        assert Locale::try_from(tag) matches { Err(_) }, tag;
    }
    let Err(e) = Locale::try_from("en_US") else {
        panic("an ill-formed tag must be refused");
    };
    assert `${e}` == "\"en_US\" is not a well-formed BCP 47 language tag";
}

// No language has a subtag of 5 to 8 letters: BCP 47 reserves the length for
// registration, and ICU4X stores a language in 3 bytes.
test "a reserved language length is refused" {
    assert !Locale::is_well_formed("abcde");
}

#[expect_trap]
test "from traps on a tag that is not well-formed" {
    let _ = Locale::from("not a tag!");
}

test "case mapping follows the language" {
    let en = Locale::from("en");
    let tr = Locale::from("tr-TR");
    assert en.uppercase("istanbul") == "ISTANBUL";
    assert tr.uppercase("istanbul") == "İSTANBUL";
    assert en.lowercase("DIYARBAKIR") == "diyarbakir";
    assert tr.lowercase("DIYARBAKIR") == "dıyarbakır";
    // Greek drops the accent that the root mapping keeps.
    assert Locale::from("und").uppercase("άδεια") == "ΆΔΕΙΑ";
    assert Locale::from("el").uppercase("άδεια") == "ΑΔΕΙΑ";
}

test "folding is full, and Turkic in tr and az" {
    let en = Locale::from("en");
    assert en.fold("Straße") == "strasse";
    assert en.fold("I") == "i";
    assert Locale::from("tr").fold("I") == "ı";
    assert Locale::from("az").fold("İ") == "i";
    assert en.eq_ignore_case("STRASSE", "straße");
    assert en.eq_ignore_case("I", "i");
    assert !Locale::from("tr").eq_ignore_case("I", "i");
    assert !en.eq_ignore_case("a", "b");
}

test "graphemes are what a reader counts as characters" {
    let text = "e\u{301}👨‍👩‍👧🇯🇵!";
    let mut clusters: List<String> = [];
    for let g of icu::graphemes(text) {
        clusters.push(g.to_string());
    }
    assert clusters == ["e\u{301}", "👨‍👩‍👧", "🇯🇵", "!"];
    assert icu::grapheme_count(text) == 4;
}

test "an empty string has no graphemes" {
    let mut none = icu::graphemes("");
    assert none.next() matches { None };
    assert icu::grapheme_count("") == 0;
}

test "a collator sorts as its locale does" {
    let german = icu::Collator::new(&Locale::from("de"));
    let swedish = icu::Collator::new(&Locale::from("sv"));
    // German sorts `ä` with `a`; Swedish sorts it after `z`.
    assert german.compare("ä", "z") matches { Less };
    assert swedish.compare("ä", "z") matches { Greater };
    assert german.compare("a", "a") matches { Equal };
}

test "a locale CLDR tailors nothing for sorts as its fallback does" {
    // Root sorts `ä` with `a`, Swedish after `z`: each tag below lands on one.
    let cases: List<[String, bool]> = [
        ["und", false],
        ["sv-FI", true],
        ["sv-Latn", true],
        ["zz", false],
    ];
    for let [tag, sorts_after_z] of cases {
        let collator = icu::Collator::new(&Locale::from(tag));
        assert collator.compare("ä", "z") matches { Greater } == sorts_after_z, tag;
    }
}
