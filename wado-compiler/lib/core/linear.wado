#![stdlib("core:linear")]
//! Arrays of plain data in linear memory, outside the GC heap.
//!
//! A `LinearArray<T>` owns one block from the program's allocator and gives it
//! back when it drops. An element is any `AnyBits` type: an integer, a float,
//! `v128` or a newtype over one, which every byte pattern is a value of. The
//! engine checks no element access against the array, since linear memory has
//! no per-allocation bounds; each access states its range as a `contract`
//! instead, which `loop_version_bce` deletes in a loop that keeps the index in
//! range.
//!
//! The array is affine, so one block has one owner, and no reference into it
//! outlives that owner. Its address is never handed out, and every element is
//! written before anything reads it. It crosses a component boundary only as a
//! `ListView<T>`, which a synchronous import's `list<T>` parameter takes and any
//! `ListArg` converts to: there it lends its own block for the call. See WEP:
//! Linear Arrays.

#[synopsis]
test {
    let mut weights = LinearArray::<f32>::filled(4, 0.0);
    weights[2] = 1.5;
    assert weights[2] == 1.5;
    assert weights.to_list() == [0.0, 0.0, 1.5, 0.0];
}

use { CopyResult } from "core:prelude/types.wado";
use { copy_result, cm_packed_upper, STREAM_CHUNK_ELEMENTS } from "core:prelude/types.wado";
use { cm_lower_list_u8, gc_array_to_memory } from "core:rt";

/// What converts to a `&ListView<T>` argument: `List<T>` by copying its
/// elements into a block of the view's own, `&LinearArray<T>` by lending its
/// block.
#[compiler_item("list_arg")]
pub affine trait ListArg<T: AnyBits> with () {
    fn lowered(&self) -> ListView<T>;
}

/// `T`s lying in linear memory in the layout the Canonical ABI gives a
/// `list<T>`, read-only. A call argument converts to a `&ListView<T>`
/// parameter from any `ListArg<T>`, and the view drops when the statement
/// holding the call ends. Only `core:*` writes one, so a view frees no block it
/// did not allocate.
#[compiler_item("list_view")]
pub affine struct ListView<T: AnyBits> {
    internal ptr: i32,
    internal len: i32,
    /// What dropping the view frees; 0 for a block it borrows.
    internal owned_bytes: i32,
    /// Set where the view drops, so a reference kept past it traps on a read.
    /// A cell rather than a field, since `drop` takes the view by value.
    internal released: &mut bool,
    /// The array a borrowed view reads: `ptr` alone is a number, and a
    /// reference is what holds the view to the array that owns the block.
    internal owner: Option<&LinearArray<T>>,
}

impl<T: AnyBits> ListView<T> {
    pub fn len(&self) -> i32 {
        return self.len;
    }

    pub fn is_empty(&self) -> bool {
        return self.len == 0;
    }

    /// The element at `index`.
    pub fn at(&self, index: i32) -> T
        contract 0 <= index < self.len
    {
        assert !*self.released, "a view is read only while it lives";
        return builtin::load::<T>(self.ptr + index * builtin::size_of::<T>());
    }

    /// The elements, copied into a `List`.
    pub fn to_list(&self) -> List<T> {
        assert !*self.released, "a view is read only while it lives";
        return List::<T>::internal_loaded(self.ptr, self.len);
    }
}

impl<T: AnyBits> Drop for ListView<T> {
    fn drop(self) {
        *self.released = true;
        if self.owned_bytes > 0 {
            let _ = builtin::realloc(self.ptr, self.owned_bytes, builtin::size_of::<T>(), 0);
        }
    }
}

impl<T: AnyBits> IndexValue<i32> for ListView<T> {
    type Output = T;

    fn index_value(&self, index: i32) -> Self::Output
        contract 0 <= index < self.len
    {
        return self.at(index);
    }
}

/// A live view of `len` `T`s at `ptr`, freeing `owned_bytes` where it drops.
/// An owned block is aligned to one `T`, as the view frees it.
fn view_of<T: AnyBits>(ptr: i32, len: i32, owned_bytes: i32, owner: Option<&LinearArray<T>>) -> ListView<T> {
    let mut released = false;
    return ListView::<T> { ptr, len, owned_bytes, released: &mut released, owner };
}

impl<T: AnyBits> ListArg<T> for List<T> {
    /// The elements, copied into a block of the view's own.
    fn lowered(&self) -> ListView<T> {
        let width = builtin::size_of::<T>();
        assert self.len() <= i32::MAX / width, "a list argument fits in linear memory";
        let bytes = self.len() * width;
        let ptr = builtin::realloc(0, 0, width, bytes);
        for let i of 0..<self.len() {
            builtin::store(ptr + i * width, self[i]);
        }
        return view_of(ptr, self.len(), bytes, null);
    }
}

impl ListArg<u8> for List<u8> {
    /// The bytes, copied eight to a store.
    fn lowered(&self) -> ListView<u8> {
        let len = self.len();
        let ptr = cm_lower_list_u8(self.internal_raw_data_ref(), 0, len) as i32;
        return view_of(ptr, len, len, null);
    }
}

impl<T: AnyBits> ListArg<T> for &LinearArray<T> {
    fn lowered(&self) -> ListView<T> {
        return view_of(self.block.ptr, self.len, 0, Option::Some(*self));
    }
}

/// The allocator's alignment for every block, whatever the element type, so a
/// `cast` keeps any element aligned.
global ALIGN: i32 = 16;

/// One block of linear memory, `bytes` long, given back where it drops. An
/// array may use less of it than it holds.
affine struct Block {
    ptr: i32,
    bytes: i32,
}

impl Drop for Block {
    fn drop(self) {
        let _ = builtin::realloc(self.ptr, self.bytes, ALIGN, 0);
    }
}

/// A fixed-length array of `T` in linear memory.
pub affine struct LinearArray<T: AnyBits> {
    block: Block,
    len: i32,
}

impl<T: AnyBits> LinearArray<T> {
    /// An array of `len` elements whose bytes the caller writes before any
    /// read.
    fn unwritten(len: i32) -> LinearArray<T>
        contract 0 <= len <= i32::MAX / builtin::size_of::<T>()
    {
        let bytes = len * builtin::size_of::<T>();
        let block = Block { ptr: builtin::realloc(0, 0, ALIGN, bytes), bytes };
        return LinearArray::<T> { block, len };
    }

    /// An array of `len` elements, each `value`.
    pub fn filled(len: i32, value: T) -> LinearArray<T>
        contract 0 <= len <= i32::MAX / builtin::size_of::<T>()
    {
        let mut array = unchecked LinearArray::<T>::unwritten(len);
        for let i of 0..<len {
            unchecked array.set(i, value);
        }
        return array;
    }

    /// An array holding a copy of each element of `source`.
    pub fn from_slice<S: AsSlice<Elem = T>>(source: &S) -> LinearArray<T> {
        let mut array = LinearArray::<T>::unwritten(source.len());
        for let i of 0..<source.len() {
            unchecked array.set(i, unchecked source.at(i));
        }
        return array;
    }

    pub fn len(&self) -> i32 {
        return self.len;
    }

    pub fn is_empty(&self) -> bool {
        return self.len == 0;
    }

    /// The element at `index`.
    pub fn at(&self, index: i32) -> T
        contract 0 <= index < self.len()
    {
        return builtin::load::<T>(self.block.ptr + index * builtin::size_of::<T>());
    }

    /// Writes `value` at `index`.
    pub fn set(&mut self, index: i32, value: T)
        contract 0 <= index < self.len()
    {
        builtin::store(self.block.ptr + index * builtin::size_of::<T>(), value);
    }

    /// A second array holding the same elements.
    pub fn duplicate(&self) -> LinearArray<T> {
        let copy = unchecked LinearArray::<T>::unwritten(self.len);
        builtin::memory_copy(copy.block.ptr, self.block.ptr, copy.block.bytes);
        return copy;
    }

    /// The elements, copied into a `List`.
    pub fn to_list(&self) -> List<T> {
        return List::<T>::internal_loaded(self.block.ptr, self.len);
    }

    /// The same bytes as an array of `U`, read little-endian, with no element
    /// copied. The array moves, so its bytes are never seen as two types at once.
    pub fn cast<U: AnyBits>(self) -> LinearArray<U>
        contract self.len() * builtin::size_of::<T>() % builtin::size_of::<U>() == 0
    {
        let LinearArray { block, len } = self;
        let cast_len = len * builtin::size_of::<T>() / builtin::size_of::<U>();
        return LinearArray::<U> { block, len: cast_len };
    }
}

impl LinearArray<u8> {
    /// The bytes from `start` to `end` as `U`s, read little-endian at any
    /// alignment, copied into a `List`: a part of a file `read_linear` read,
    /// decoded with no copy of the bytes before it.
    pub fn to_list_of<U: AnyBits>(&self, start: i32, end: i32) -> List<U>
        contract 0 <= start <= end <= self.len()
        contract (end - start) % builtin::size_of::<U>() == 0
    {
        return List::<U>::internal_loaded(self.block.ptr + start, (end - start) / builtin::size_of::<U>());
    }

    /// The bytes from `start` to `end` as text, copied once into a `String`.
    pub fn to_string_of(&self, start: i32, end: i32) -> Result<String, Utf8Error>
        contract 0 <= start <= end <= self.len()
    {
        let mut text = String::with_capacity(end - start);
        text.internal_append_from_memory(self.block.ptr + start, end - start);
        let bytes = text.as_byte_slice();
        let prefix = String::utf8_valid_prefix(&bytes);
        if prefix != bytes.len() {
            builtin::cold_path();
            return Result::Err(String::utf8_error_at(&bytes, prefix));
        }
        return Result::Ok(text);
    }

    /// Every byte `stream` delivers until its writer drops. A host copy lands
    /// in the array's own block, so no byte passes through the GC heap; a
    /// handler's items are copied in. The block takes `expected` bytes up
    /// front and grows only for a stream that runs past them.
    pub fn read_stream(stream: &Stream<u8>, expected: i32 = 0) -> LinearArray<u8>
        contract expected >= 0
    {
        let mut array = LinearArray::<u8> {
            block: Block { ptr: builtin::realloc(0, 0, ALIGN, expected), bytes: expected },
            len: 0,
        };
        while array.read_more(stream) == CopyResult::Completed {
        }
        return array;
    }

    /// One copy of what `stream` delivers next, appended. A host copy lands in
    /// the block's room. A full block reads into memory of the copy's own, so a
    /// stream exactly as long as the block ends without growing it.
    fn read_more(&mut self, stream: &Stream<u8>) -> CopyResult {
        let full = self.len == self.block.bytes;
        let room = if full { STREAM_CHUNK_ELEMENTS } else { self.block.bytes - self.len };
        let mut lending = !full;
        let into = if full { ReadInto::fresh() } else { ReadInto::lent(self.block.ptr + self.len, room, &mut lending) };
        let mut started = stream.begin_read(room, into);
        let packed = started.buffer.settle();
        lending = false;
        let landed = cm_packed_upper(packed);
        let items = &started.items;
        if landed > 0 {
            if full {
                self.block = grown(&self.block, self.len, landed);
                builtin::memory_copy(self.block.ptr + self.len, started.buffer.ptr, landed);
            }
            self.len += landed;
        } else if !items.is_empty() {
            let count = items.len();
            if count > self.block.bytes - self.len {
                self.block = grown(&self.block, self.len, count);
            }
            gc_array_to_memory(items.internal_raw_data_ref(), 0, self.block.ptr + self.len, count);
            self.len += count;
        }
        return copy_result(packed);
    }
}

/// A block holding the `len` bytes `block` starts with and room for `more`
/// after them, at least twice as large, so a stream of unknown length copies
/// each byte a bounded number of times.
fn grown(block: &Block, len: i32, more: i32) -> Block {
    if more > i32::MAX - len {
        builtin::cold_path();
        panic("a stream runs past what linear memory can address");
    }
    let bytes = if block.bytes > i32::MAX / 2 { i32::MAX } else { i32::max(block.bytes * 2, len + more) };
    let moved = Block { ptr: builtin::realloc(0, 0, ALIGN, bytes), bytes };
    builtin::memory_copy(moved.ptr, block.ptr, len);
    return moved;
}

/// The room a buffer reading a stream takes at least, so a stream of small
/// copies is read in few of them.
global BUFFER_ROOM: i32 = 65536;

/// Bytes in linear memory, read from a stream a part at a time, or held whole:
/// what a parser reads a stream through with no byte lifted into the GC heap.
/// `bytes()` holds what was read, and the part not yet consumed begins at
/// `start()`. Both change only where `fill` reads more or `consume` drops some.
pub affine struct LinearBuffer {
    bytes: LinearArray<u8>,
    start: i32,
    /// The stream still to read; `None` once it ended, or for bytes held whole.
    source: Option<Stream<u8>>,
    /// The bytes dropped from the front of `bytes`.
    dropped: i64,
}

impl LinearBuffer {
    /// A buffer holding `bytes` and nothing more to read.
    pub fn of(bytes: LinearArray<u8>) -> LinearBuffer {
        return LinearBuffer { bytes, start: 0, source: null, dropped: 0 };
    }

    /// A buffer reading `stream`, which it drops once the stream ends or the
    /// buffer drops.
    pub fn of_stream(stream: Stream<u8>) -> LinearBuffer {
        let bytes = LinearArray::<u8> { block: Block { ptr: builtin::realloc(0, 0, ALIGN, 0), bytes: 0 }, len: 0 };
        return LinearBuffer { bytes, start: 0, source: Option::Some(stream), dropped: 0 };
    }

    /// What was read, from `start()` on not yet consumed.
    pub fn bytes(&self) -> &LinearArray<u8> {
        return &self.bytes;
    }

    /// Where in `bytes()` the part not yet consumed begins.
    pub fn start(&self) -> i32 {
        return self.start;
    }

    /// The bytes read and not yet consumed.
    pub fn len(&self) -> i32 {
        return self.bytes.len - self.start;
    }

    /// How far into the stream `start()` is.
    pub fn position(&self) -> i64 {
        return self.dropped + self.start as i64;
    }

    /// Read until `n` bytes are not yet consumed, or the stream ends. Answers
    /// whether `n` are.
    pub fn fill(&mut self, n: i32) -> bool
        contract n >= 0
    {
        while self.len() < n && let Some(stream) = &self.source {
            self.make_room(n);
            if self.bytes.read_more(stream) != CopyResult::Completed {
                self.source = null;
            }
        }
        return self.len() >= n;
    }

    /// Drop the next `n` bytes.
    pub fn consume(&mut self, n: i32)
        contract 0 <= n <= self.bytes.len - self.start
    {
        self.start += n;
    }

    /// Move the bytes not yet consumed to the front of the block, and grow it to
    /// hold `n` of them.
    fn make_room(&mut self, n: i32) {
        let kept = self.len();
        if self.start > 0 {
            builtin::memory_copy(self.bytes.block.ptr, self.bytes.block.ptr + self.start, kept);
            self.dropped += self.start as i64;
            self.start = 0;
            self.bytes.len = kept;
        }
        if n > self.bytes.block.bytes {
            self.bytes.block = grown(&self.bytes.block, kept, i32::max(n, BUFFER_ROOM) - kept);
        }
    }
}

impl<T: AnyBits> IndexValue<i32> for LinearArray<T> {
    type Output = T;

    fn index_value(&self, index: i32) -> Self::Output
        contract 0 <= index < self.len()
    {
        return self.at(index);
    }
}

impl<T: AnyBits> IndexAssign<i32> for LinearArray<T> {
    type Output = T;

    fn index_assign(&mut self, index: i32, value: Self::Output)
        contract 0 <= index < self.len()
    {
        self.set(index, value);
    }
}
