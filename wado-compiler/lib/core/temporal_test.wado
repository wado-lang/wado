test "the plain family goes over the wire as its ISO 8601 form" {
    let date = PlainDate::new(2023, 11, 14);
    assert to_string(&date) matches { Ok(json) && json == `"2023-11-14"` };
    assert from_string::<PlainDate>(`"2023-11-14"`) matches { Ok(back) && back == date };

    let time = PlainTime::new(22, 13, 20, 500);
    assert to_string(&time) matches { Ok(json) && json == `"22:13:20.5"` };
    assert from_string::<PlainTime>(`"22:13:20.5"`) matches { Ok(back) && back == time };

    let dt = PlainDateTime::new(date, time);
    assert to_string(&dt) matches { Ok(json) && json == `"2023-11-14T22:13:20.5"` };
    assert from_string::<PlainDateTime>(`"2023-11-14T22:13:20.5"`) matches { Ok(back) && back == dt };

    assert to_string(&PlainYearMonth::new(2024, 2)) matches { Ok(json) && json == `"2024-02"` };
    assert to_string(&PlainMonthDay::new(2, 29)) matches { Ok(json) && json == `"02-29"` };
    assert from_string::<PlainMonthDay>(`"--02-29"`) matches { Ok(back) && back == PlainMonthDay::new(2, 29) };

    // A structurally-shaped value is refused, not read field by field.
    assert from_string::<PlainDate>(`{"year":2023,"month":11,"day":14}`) matches { Err(_) };
    assert from_string::<PlainDate>(`"nope"`) matches { Err(_) };
}

test "the plain family parses through FromStr" {
    assert PlainDate::from_str("2023-11-14") matches { Ok(d) && d == PlainDate::new(2023, 11, 14) };
    assert PlainTime::from_str("22:13") matches { Ok(t) && t == PlainTime { hour: 22, minute: 13 } };
    assert PlainYearMonth::from_str("2024-02") matches { Ok(m) && m == PlainYearMonth::new(2024, 2) };
    assert PlainMonthDay::from_str("--02-29") matches { Ok(m) && m == PlainMonthDay::new(2, 29) };
    assert PlainDateTime::from_str("2023-11-14T22:13") matches { Ok(_) };
}

test "Instant serializes as its Temporal string" {
    let whole = Instant { seconds: 1_700_000_000, nanoseconds: 0 };
    assert to_string(&whole) matches { Ok(s) && s == `"2023-11-14T22:13:20Z"` };

    let millis = Instant { seconds: 1_700_000_000, nanoseconds: 120_000_000 };
    assert to_string(&millis) matches { Ok(s) && s == `"2023-11-14T22:13:20.12Z"` };

    let nanos = Instant { seconds: 1_700_000_000, nanoseconds: 123_456_789 };
    assert to_string(&nanos) matches { Ok(s) && s == `"2023-11-14T22:13:20.123456789Z"` };
}

test "Instant round-trips through JSON serde" {
    let t = Instant { seconds: 1_700_000_000, nanoseconds: 123_456_789 };
    let json = to_string(&t).unwrap();
    let back = from_string::<Instant>(json).unwrap();
    assert back == t;
}

test "ZonedDateTime round-trips through JSON serde, keeping its zone" {
    let zdt = ZonedDateTime::from_str("2023-11-15T07:13:20.5+09:00[+09:00]").unwrap();
    let json = to_string(&zdt).unwrap();
    assert json == `"2023-11-15T07:13:20.5+09:00[+09:00]"`;
    let back = from_string::<ZonedDateTime>(json).unwrap();
    assert back == zdt;
}

test "Instant deserializes from any offset, normalizing to the instant" {
    // A non-UTC string still decodes to the correct absolute Instant.
    let t = from_string::<Instant>(`"2023-11-15T07:13:20+09:00"`).unwrap();
    assert t == Instant { seconds: 1_700_000_000, nanoseconds: 0 };
}

test "Deserializing a malformed timestamp surfaces a DeserializeError" {
    assert from_string::<Instant>(`"2023-13-01T00:00:00Z"`) matches { Err(_) };
}

test "Instant converts to and from the wasi:clocks instant" {
    let clock = ClockInstant { seconds: 1_700_000_000, nanoseconds: 123_456_789 };

    // wasi:clocks reading -> core:temporal Instant (field-for-field copy).
    let t = Instant::from(clock);
    assert t == Instant { seconds: 1_700_000_000, nanoseconds: 123_456_789 };

    // core:temporal Instant -> wasi:clocks reading; round-trips exactly.
    // This compares the clock record with `==` (its own auto-derived equality)
    // in the same module that uses `Instant`'s same-named equality — the two no
    // longer collide.
    let back = ClockInstant::from(t);
    assert back == clock;

    // The pre-epoch boundary copies field-for-field too.
    let before = Instant::from(ClockInstant { seconds: -1, nanoseconds: 999_999_999 });
    assert before == Instant { seconds: -1, nanoseconds: 999_999_999 };
}

test "Instant serializes under CBOR datetime tag 0 and round-trips" {
    let inst = Instant::from_str("2023-11-14T22:13:20Z").unwrap();
    let bytes = to_bytes::<Instant>(&inst).expect("serialize Instant to CBOR");
    // Standard date/time string tag (RFC 8949 §3.4.1).
    assert bytes[0] == 0xc0;
    let back = from_bytes::<Instant, ByteList>(bytes).expect("decode Instant from CBOR");
    assert back == inst;
}

test "ZonedDateTime round-trips through CBOR keeping its zone" {
    let zdt = ZonedDateTime::from_str("2023-11-15T07:13:20+09:00[+09:00]").unwrap();
    let bytes = to_bytes::<ZonedDateTime>(&zdt).expect("serialize ZonedDateTime to CBOR");
    // An RFC 9557 string is not the RFC 3339 tag 0 names, so it goes untagged.
    assert bytes[0] != 0xc0;
    let back = from_bytes::<ZonedDateTime, ByteList>(bytes).expect("decode ZonedDateTime from CBOR");
    assert back == zdt;
}

test "Instant decodes a CBOR epoch-seconds tag 1 number as UTC" {
    // tag 1 (0xc1) wrapping the unsigned integer 1700000000.
    let bytes: List<u8> = [0xc1, 0x1a, 0x65, 0x53, 0xf1, 0x00];
    let inst = from_bytes::<Instant, ByteList>(bytes as ByteList).expect("decode epoch");
    assert inst == Instant { seconds: 1_700_000_000, nanoseconds: 0 };
}

test "Instant decoded from a zoned string collapses to the same instant" {
    let utc = Instant::from_str("2023-11-14T22:13:20Z").unwrap();
    let zdt = ZonedDateTime::from_str("2023-11-15T07:13:20+09:00[+09:00]").unwrap();
    let bytes = to_bytes::<ZonedDateTime>(&zdt).expect("serialize ZonedDateTime");
    let inst = from_bytes::<Instant, ByteList>(bytes).expect("decode Instant from a zoned string");
    assert inst == utc;
}

test "Instant decodes a negative epoch number (before 1970)" {
    let inst = from_string::<Instant>("-5").expect("decode negative epoch");
    assert inst == Instant { seconds: -5, nanoseconds: 0 };
}

test "Instant decodes a fractional epoch number" {
    let inst = from_string::<Instant>("1700000000.5").expect("decode fractional epoch");
    assert inst == Instant { seconds: 1_700_000_000, nanoseconds: 500_000_000 };
    let tenth = from_string::<Instant>("0.3").expect("decode a tenth");
    assert tenth.nanoseconds == 300_000_000;
}

test "Instant decodes a negative fractional epoch with a forward-moving borrow" {
    // -1.5s before the epoch is seconds:-2 plus 0.5s, since nanoseconds always
    // move time forward.
    let inst = from_string::<Instant>("-1.5").expect("decode negative fractional epoch");
    assert inst == Instant { seconds: -2, nanoseconds: 500_000_000 };
}

test "Instant rejects an epoch number outside the Temporal range" {
    // 2^53 + 1 seconds: exact in a CBOR integer, but 285 million years out.
    let bytes: List<u8> = [0xc1, 0x1b, 0x00, 0x20, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01];
    let r = from_bytes::<Instant, ByteList>(bytes as ByteList);
    assert r matches { Err(e) && e.kind matches { DeserializeErrorKind::Overflow } };
    assert from_string::<Instant>("18446744073709551615") matches { Err(_) };
    assert from_string::<Instant>("8640000000001") matches { Err(_) };
    assert from_string::<Instant>("8640000000000") matches { Ok(_) };
}

test "Instant rejects an epoch bignum beyond i64/u64 instead of truncating" {
    // CBOR tag 2 (positive bignum) wrapping 2^64.
    let bytes: List<u8> = [0xc2, 0x49, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00];
    let r = from_bytes::<Instant, ByteList>(bytes as ByteList);
    match r {
        Err(e) => {
            assert e.kind matches { DeserializeErrorKind::Overflow };
        },
        Ok(_) => {
            assert false;
        },
    }
}

test "a backwards until anchors at the receiver, so add round-trips it" {
    let from = PlainDate::new(1959, 1, 19);
    let to = PlainDate::new(1957, 6, 27);
    let span = from.until(&to, Unit::Month);
    assert span == Duration { months: -18, days: -22 };
    assert from.add(&span) == to;

    let years = from.until(&to, Unit::Year);
    assert years == Duration { years: -1, months: -6, days: -22 };
    assert from.add(&years) == to;
}

test "a backwards ZonedDateTime until round-trips through add" {
    let from = ZonedDateTime::parse_rfc3339("1966-10-31T23:13:20+09:00").unwrap();
    let to = ZonedDateTime::parse_rfc3339("1966-02-10T01:53:34+09:00").unwrap();
    let span = from.until(&to, Unit::Month);
    assert from.add(&span) == to;
}

test "ISO week numbering floors the leap-year terms, so BCE years count 53 weeks" {
    let d = PlainDate::new(-396, 12, 28);
    assert d.week_of_year() == 53;
    assert d.year_of_week() == -396;
}

fn lcg(state: i64) -> i64 {
    return (state * 6_364_136_223_846_793_005 + 1_442_695_040_888_963_407) % 4_611_686_018_427_387_904;
}

test "until round-trips through add for every date unit, in both directions" {
    let units = [Unit::Year, Unit::Month, Unit::Week, Unit::Day];
    let mut s: i64 = 12_345;
    for let mut i = 0; i < 400; i += 1 {
        s = lcg(s);
        let a = PlainDate::from_epoch_days(s % 40_000 - 20_000);
        s = lcg(s);
        let b = PlainDate::from_epoch_days(s % 40_000 - 20_000);
        for let u of units {
            assert a.add(&a.until(&b, u)) == b;
            assert b.add(&b.until(&a, u)) == a;
        }
    }
}

test "PlainDateTime until round-trips through add, in both directions" {
    let units = [Unit::Year, Unit::Month, Unit::Week, Unit::Day, Unit::Hour];
    let mut s: i64 = 999;
    for let mut i = 0; i < 150; i += 1 {
        s = lcg(s);
        let a = sample_date_time(s);
        s = lcg(s);
        let b = sample_date_time(s);
        for let u of units {
            assert a.add(&a.until(&b, u)) == b;
            assert b.add(&b.until(&a, u)) == a;
        }
    }
}

test "ZonedDateTime until round-trips through add, in both directions" {
    let units = [Unit::Year, Unit::Month, Unit::Week, Unit::Day, Unit::Hour];
    let mut s: i64 = 4242;
    for let mut i = 0; i < 100; i += 1 {
        s = lcg(s);
        let a = sample_date_time(s).to_zoned_date_time("-03:30");
        s = lcg(s);
        let b = sample_date_time(s).to_zoned_date_time("-03:30");
        for let u of units {
            assert a.add(&a.until(&b, u)) == b;
            assert b.add(&b.until(&a, u)) == a;
        }
    }
}

fn sample_date_time(s: i64) -> PlainDateTime {
    let t = i64::abs(s);
    return PlainDateTime::new(
        PlainDate::from_epoch_days(s % 20_000 - 10_000),
        PlainTime::new((t / 7 % 24) as i32, (t / 11 % 60) as i32, (t / 13 % 60) as i32),
    );
}

test "ISO week numbering keeps its anchor days across -400..=400" {
    // 4 January always falls in week 1 of its own year, 28 December in the last.
    for let mut y: i32 = -400; y <= 400; y += 1 {
        let jan4 = PlainDate::new(y, 1, 4);
        assert jan4.week_of_year() == 1 && jan4.year_of_week() == y;

        let dec28 = PlainDate::new(y, 12, 28);
        let weeks = dec28.week_of_year();
        assert dec28.year_of_week() == y;
        assert weeks == 52 || weeks == 53;

        // Every ISO year runs a whole number of weeks, so week 1 plus that count
        // lands in the next week-year and not a week sooner.
        assert jan4.add(&Duration { weeks: (weeks - 1) as i64 }).year_of_week() == y;
        assert jan4.add(&Duration { weeks: weeks as i64 }).year_of_week() == y + 1;
    }
}

test "from_epoch_nanoseconds round-trips the whole Instant range" {
    let bounds: List<i64> = [-8_640_000_000_000, -8_639_999_999_999, -1, 0, 1, 8_639_999_999_999];
    // A zero sub-second is the case a truncating division cannot walk back
    // from, so both spellings of each bound have to round-trip.
    let fractions: List<u32> = [0, 500_000_000, 999_999_999];
    for let seconds of bounds {
        for let nanoseconds of fractions {
            let i = Instant { seconds: seconds, nanoseconds: nanoseconds };
            assert Instant::from_epoch_nanoseconds(i.epoch_nanoseconds()) == i;
        }
    }
    let latest = Instant::from_epoch_seconds(8_640_000_000_000);
    assert Instant::from_epoch_nanoseconds(latest.epoch_nanoseconds()) == latest;
}

#[expect_trap]
test "from_epoch_nanoseconds traps past the Instant range" {
    let _ = Instant::from_epoch_nanoseconds(8_640_000_000_000_000_000_001);
}

#[expect_trap]
test "from_epoch_nanoseconds traps a whole second count past the range" {
    let _ = Instant::from_epoch_nanoseconds(-8_640_000_000_001_000_000_000);
}

test "parsing refuses what lands outside the range" {
    assert Instant::from_str("+999999-01-01T00:00:00Z") matches { Err(_) };
    assert ZonedDateTime::parse_rfc3339("+275760-09-14T00:00:00Z") matches { Err(_) };
    assert ZonedDateTime::from_str("+275760-09-14T00:00+00:00[+00:00]") matches { Err(_) };
    assert ZonedDateTime::from_str("+275760-09-14T00:00Z[UTC]") matches { Err(_) };
    assert PlainDateTime::from_str("+275760-09-14T00:00") matches { Err(_) };
    assert PlainYearMonth::from_str("+300000-01") matches { Err(_) };
}

test "operations that change nothing answer the receiver" {
    let i = Instant::from_epoch_seconds(3600);
    assert i.round(Unit::Hour) == i;
    let z = i.to_zoned_date_time("+09:00");
    assert z.round(Unit::Nanosecond) == z;
    assert z.until(&z, Unit::Day) == Duration {};
    assert PlainTime { hour: 9 }.round(Unit::Hour) == PlainTime { hour: 9 };
    let d = PlainDate::new(2024, 2, 29);
    assert d.until(&d) == Duration {};
    let dt = d.to_plain_date_time();
    assert dt.until(&dt) == Duration {};
    let ym = PlainYearMonth::new(2024, 2);
    assert ym.until(&ym) == Duration {};
    assert Duration { hours: 1 }.abs() == Duration { hours: 1 };
}

test "the inverse operations of the plain types" {
    let t = PlainTime { hour: 9 };
    assert t.since(&PlainTime { hour: 7 }) == Duration { hours: 2 };
    let dt = PlainDate::new(2024, 3, 1).to_plain_date_time();
    assert dt.subtract(&Duration { days: 1 }) == PlainDate::new(2024, 2, 29).to_plain_date_time();
    assert dt.since(&PlainDate::new(2024, 2, 29).to_plain_date_time()) == Duration { days: 1 };
    let ym = PlainYearMonth::new(2024, 3);
    assert ym.days_in_year() == 366;
    assert PlainYearMonth::new(2023, 3).days_in_year() == 365;
    assert PlainMonthDay::from_str("2020-12-25") matches { Ok(md) && md == PlainMonthDay::new(12, 25) };
    assert ym.months_in_year() == 12;
    assert ym.month_code() == "M03";
    assert ym.subtract(&Duration { months: 3 }) == PlainYearMonth::new(2023, 12);
    assert ym.since(&PlainYearMonth::new(2023, 12)) == Duration { months: 3 };
    assert PlainMonthDay::new(12, 25).month_code() == "M12";
}

test "a zone string carrying a minute offset names that offset zone" {
    assert Instant::EPOCH.to_zoned_date_time("2020-01-01T00:00+05:30").time_zone == "+05:30";
}

test "zone annotations follow the TimeZoneIANAName grammar" {
    // Well-formed names that no database here can resolve.
    assert ZonedDateTime::from_str("2020-01-01T00:00Z[Etc/GMT-1]") matches { Err(_) };
    assert ZonedDateTime::from_str("2020-01-01T00:00Z[Etc/GMT+1]") matches { Err(_) };
    assert ZonedDateTime::from_str("2020-01-01T00:00Z[a1]") matches { Err(_) };
    // Malformed names.
    assert ZonedDateTime::from_str("2020-01-01T00:00Z[a//b]") matches { Err(_) };
    assert ZonedDateTime::from_str("2020-01-01T00:00Z[Europe/Par~is]") matches { Err(_) };
}

test "annotations follow the AnnotationKey and AnnotationValue grammar" {
    let bad: List<String> = [
        "2020-01-01T00:00Z[UTC", "2020-01-01T00:00Z[UTC][u-ca=]", "2020-01-01T00:00Z[UTC][=x]",
        "2020-01-01T00:00Z[UTC][a.b=x]", "2020-01-01T00:00Z[UTC][u-ca=a--b]", "2020-01-01T00:00Z[UTC][u-ca=a_b]",
        "2020-01-01T00:00Z[UTC][u-ca=a-]", "2020-01-01T00:00Z[UTC][u-ca=iso8601][!u-ca=iso8601]",
        "2020-01-01T00:00Z[UTC][u-ca=gregory]", "nope",
    ];
    for let s of bad {
        assert ZonedDateTime::from_str(s) matches { Err(_) };
    }
    assert ZonedDateTime::from_str("2020-01-01T00:00Z[UTC][x-y=a-b]") matches { Ok(_) };
    // A second calendar is ignored unless either one is critical.
    assert ZonedDateTime::from_str("2020-01-01T00:00Z[UTC][u-ca=iso8601][u-ca=gregory]") matches { Ok(_) };
    assert ZonedDateTime::from_str("2020-01-01T00:00Z[UTC][!u-ca=iso8601][u-ca=iso8601]") matches { Err(_) };
}

test "the plain types refuse a calendar other than ISO 8601 and malformed text" {
    assert PlainTime::from_str("12:00[u-ca=gregory]") matches { Err(_) };
    assert PlainDateTime::from_str("2020-01-01T12:00[u-ca=gregory]") matches { Err(_) };
    assert PlainYearMonth::from_str("2020-01[u-ca=gregory]") matches { Err(_) };
    assert PlainMonthDay::from_str("12-25[u-ca=gregory]") matches { Err(_) };
    let bad_times: List<String> = ["x", "12:x0", "12:30:x0", "12:30:00.", "12:30:00.0000000001", "T12:00["];
    for let s of bad_times {
        assert PlainTime::from_str(s) matches { Err(_) };
    }
    assert PlainDateTime::from_str("x") matches { Err(_) };
    assert PlainDate::from_str("2020-01-x1") matches { Err(_) };
    assert PlainMonthDay::from_str("12-x1") matches { Err(_) };
    assert PlainYearMonth::from_str("2020-01[") matches { Err(_) };
    assert PlainMonthDay::from_str("12-25[") matches { Err(_) };
    assert Instant::from_str("2020-01-01T00:00+x") matches { Err(_) };
}

test "serde refuses a non-string for the string-only types" {
    assert from_string::<Duration>("1") matches { Err(_) };
    assert from_string::<PlainTime>("1") matches { Err(_) };
    assert from_string::<PlainDateTime>("1") matches { Err(_) };
    assert from_string::<PlainYearMonth>("1") matches { Err(_) };
    assert from_string::<PlainMonthDay>("1") matches { Err(_) };
    assert from_string::<PlainYearMonth>(`"2020-01"`) matches { Ok(ym) && ym == PlainYearMonth::new(2020, 1) };
    assert from_string::<ZonedDateTime>("1e300") matches { Err(_) };
}

test "duration strings follow the ISO 8601 duration grammar" {
    let bad: List<String> = [
        "P", "PT", "1Y", "P1X", "PT1X", "P1YxD", "P1D1Y", "PT1S1H", "P1.5Y", "PT1.5H30M", "P1YT",
        "P99999999999999999999Y",
    ];
    for let s of bad {
        assert Duration::parse(s) matches { Err(_) };
    }
}

test "Duration rounding modes turn on the sign" {
    let up = Duration { seconds: 90 };
    let down = Duration { seconds: -90 };
    assert up.round(Unit::Minute, Unit::Hour, 1, RoundingMode::Ceil) == Duration { minutes: 2 };
    assert down.round(Unit::Minute, Unit::Hour, 1, RoundingMode::Ceil) == Duration { minutes: -1 };
    assert up.round(Unit::Minute, Unit::Hour, 1, RoundingMode::HalfCeil) == Duration { minutes: 2 };
    assert down.round(Unit::Minute, Unit::Hour, 1, RoundingMode::HalfCeil) == Duration { minutes: -1 };
    assert up.round(Unit::Minute, Unit::Hour, 1, RoundingMode::HalfFloor) == Duration { minutes: 1 };
    assert down.round(Unit::Minute, Unit::Hour, 1, RoundingMode::HalfFloor) == Duration { minutes: -2 };
    // A sub-second part decides a tie at the whole-second step.
    assert Duration { seconds: 90, milliseconds: 1 }.round(Unit::Minute, Unit::Hour, 1, RoundingMode::HalfTrunc) == Duration { minutes: 2 };
    assert Duration { seconds: 1 }.round(Unit::Microsecond, Unit::Microsecond) == Duration { microseconds: 1_000_000 };
}

test "Duration addition normalizes across the second" {
    assert Duration { seconds: 1 }.add(&Duration { milliseconds: -500 }) == Duration { milliseconds: 500 };
    assert Duration { seconds: -1 }.add(&Duration { milliseconds: 500 }) == Duration { milliseconds: -500 };
}

test "Duration::total answers the float nearest the exact quotient" {
    assert Duration {}.total(Unit::Second) == 0.0;
    assert Duration { days: 100_000 }.total(Unit::Nanosecond) == 8640000000000000000.0;
    assert Duration { nanoseconds: 1 }.total(Unit::Hour) == 1.0 / 3600000000000.0;
    // 2^54 - 1 rounds up to 2^54, carrying out of the 53-bit mantissa.
    assert Duration { nanoseconds: 18_014_398_509_481_983 }.total(Unit::Nanosecond) == 18014398509481984.0;
}

test "PlainTime rounds to every sub-second unit" {
    let t = PlainTime { hour: 1, millisecond: 1, microsecond: 1, nanosecond: 501 };
    assert t.round(Unit::Microsecond) == PlainTime { hour: 1, millisecond: 1, microsecond: 2 };
    assert t.round(Unit::Nanosecond, 10) == PlainTime { hour: 1, millisecond: 1, microsecond: 1, nanosecond: 500 };
}

test "to_http_date names every weekday" {
    let names: List<String> = ["Thu", "Fri", "Sat", "Sun", "Mon", "Tue", "Wed"];
    for let mut i = 0; i < 7; i += 1 {
        let date = Instant::from_epoch_seconds(i as i64 * 86_400).to_http_date();
        assert date.substr_bytes(0, 3) == names[i];
    }
}

test "HTTP-date parsing refuses each malformed part" {
    let bad: List<String> = [
        "Sun,06 Nov 1994 08:49:37 GMT", "Sun, x6 Nov 1994 08:49:37 GMT", "Sun, 06xNov 1994 08:49:37 GMT",
        "Sun, 06 Xov 1994 08:49:37 GMT", "Sun, 06 Nov-1994 08:49:37 GMT", "Sun, 06 Nov 19x4 08:49:37 GMT",
        "Sun, 06 Nov 1994-08:49:37 GMT", "Sun, 06 Nov 1994 x8:49:37 GMT", "Sun, 06 Nov 1994 08-49:37 GMT",
        "Sun, 06 Nov 1994 08:x9:37 GMT", "Sun, 06 Nov 1994 08:49-37 GMT", "Sun, 06 Nov 1994 08:49:x7 GMT",
        "Sun, 06 Nov 1994 24:49:37 GMT", "Sun, 06 Nov 1994 08:49:37GMT", "Sun, 06 Nov 1994 08:49:37 XMT",
        "Sun, 06 Nov 1994 08:49:37 GXT", "Sun, 06 Nov 1994 08:49:37 GMX", "Sun, 06 No", "Sunday,x06-Nov-94 08:49:37 GMT",
        "Sunday, x6-Nov-94 08:49:37 GMT", "Sunday, 06-Xov-94 08:49:37 GMT", "Sunday, 06-Nov 94 08:49:37 GMT",
        "Sunday, 06-Nov-x4 08:49:37 GMT", "Sunday, 06-Nov-94-08:49:37 GMT", "Sunday, 06-Nov-94 x8:49:37 GMT",
        "Sunday, 06-Nov-94 08:49:37 UTC", "SunxNov  6 08:49:37 1994", "Sun Xov  6 08:49:37 1994",
        "Sun Nov- 6 08:49:37 1994", "Sun Nov x6 08:49:37 1994", "Sun Nov 06x08:49:37 1994", "Sun Nov 06 x8:49:37 1994",
        "Sun Nov 06 08:49:37x1994", "Sun Nov 06 08:49:37 19x4",
    ];
    for let s of bad {
        assert Instant::parse_http_date(s) matches { Err(_) };
    }
    assert Instant::parse_http_date("Sun, 06 Nov 1994 08:49:60 GMT") matches { Ok(i) && i.seconds == 784111799 };
    assert Instant::parse_http_date("Sat, 06-Nov-04 08:49:37 GMT") matches { Err(_) };
    assert Instant::parse_http_date("Saturday, 06-Nov-04 08:49:37 GMT") matches { Ok(i) && i.to_http_date() == "Sat, 06 Nov 2004 08:49:37 GMT" };
    assert Instant::parse_http_date("Sun Nov 06 08:49:37 1994") matches { Ok(i) && i.seconds == 784111777 };
}

struct FixedClock {
    reading: ClockInstant,
}

impl SystemClock for FixedClock {
    fn now(&self) -> ClockInstant {
        resume self.reading;
    }

    ..trap
}

test "Instant::now clamps a clock reading to the range" {
    let late = FixedClock {
        reading: ClockInstant { seconds: 9_000_000_000_000, nanoseconds: 0 },
    };
    with SystemClock => &late do {
        assert Instant::now() == Instant::from_epoch_seconds(8_640_000_000_000);
    };
    let early = FixedClock {
        reading: ClockInstant { seconds: -9_000_000_000_000, nanoseconds: 5 },
    };
    with SystemClock => &early do {
        assert Instant::now() == Instant::from_epoch_seconds(-8_640_000_000_000);
    };
}

test "ZonedDateTime deserializes a number through the Instant visitor, in UTC" {
    assert from_string::<ZonedDateTime>("1") matches { Ok(z) && z == Instant::from_epoch_seconds(1).to_zoned_date_time(
        "UTC",
    ) };
    assert from_string::<ZonedDateTime>("null") matches { Err(_) };
    assert from_string::<ZonedDateTime>("true") matches { Err(_) };
    assert from_string::<ZonedDateTime>("[]") matches { Err(_) };
    assert from_string::<ZonedDateTime>("{}") matches { Err(_) };
}

test "a duration led by microseconds renders from the seconds component" {
    assert `${Duration { microseconds: 5 }}` == "PT0.000005S";
}

#[expect_trap]
test "ZonedDateTime::new refuses text that is no zone identifier" {
    let _ = ZonedDateTime::new(Instant::EPOCH, "!");
}

#[expect_trap]
test "a duration component of i64::MIN, which has no negation, traps" {
    let _ = Duration { nanoseconds: i64::MIN }.negated();
}

#[expect_trap]
test "a precision past nine digits traps" {
    let _ = `${Instant::EPOCH:.10}`;
}

#[expect_trap]
test "an HTTP-date needs a four-digit year" {
    let _ = Instant::from_epoch_seconds(253_402_300_800).to_http_date();
}

#[expect_trap]
test "a sub-second part of a second or more traps" {
    let _ = Instant { seconds: 0, nanoseconds: 1_000_000_000 }.epoch_milliseconds();
}

#[expect_trap]
test "a local reading past the range traps when it becomes an instant" {
    let last = PlainDateTime::new(PlainDate::new(275760, 9, 13), PlainTime { hour: 12 });
    let _ = last.to_zoned_date_time("+00:00");
}

#[expect_trap]
test "rounding a local reading past the date range traps" {
    let latest = Instant::from_epoch_seconds(8_640_000_000_000).to_zoned_date_time("+23:59");
    let _ = latest.round(Unit::Hour);
}

#[expect_trap]
test "a zone string that parses as nothing traps" {
    let _ = Instant::EPOCH.to_zoned_date_time("nope!");
}

#[expect_trap]
test "a zone string with a seconds offset traps" {
    let _ = Instant::EPOCH.to_zoned_date_time("2020-01-01T00:00+01:00:30");
}

#[expect_trap]
test "a date-time string without a zone names none" {
    let _ = Instant::EPOCH.to_zoned_date_time("2020-01-01T00:00");
}

#[expect_trap]
test "a time string names no zone" {
    let _ = Instant::EPOCH.to_zoned_date_time("T12:00");
}

#[expect_trap]
test "a month-day string names no zone" {
    let _ = Instant::EPOCH.to_zoned_date_time("12-25");
}

#[expect_trap]
test "a year-month string names no zone" {
    let _ = Instant::EPOCH.to_zoned_date_time("+002020-01");
}

#[expect_trap]
test "a stored zone that is no offset traps" {
    let _ = ZonedDateTime { instant: Instant::EPOCH, time_zone: "+1a:00" }.hour();
}

#[expect_trap]
test "a total in a calendar unit traps" {
    let _ = Duration { hours: 1 }.total(Unit::Year);
}

#[expect_trap]
test "a rounding increment below one traps" {
    let _ = Duration { hours: 1 }.round(Unit::Day, Unit::Day, 0);
}

#[expect_trap]
test "a PlainDateTime rounds to no calendar unit" {
    let _ = PlainDate::new(2024, 1, 1).to_plain_date_time().round(Unit::Week);
}

#[expect_trap]
test "a PlainTime rounds to no date unit" {
    let _ = PlainTime { hour: 1 }.round(Unit::Day);
}

#[expect_trap]
test "a PlainDate from an epoch day past the range traps" {
    let _ = PlainDate::from_epoch_days(100_000_001);
}

#[expect_trap]
test "a PlainDate difference takes no time unit" {
    let d = PlainDate::new(2024, 1, 1);
    let _ = d.until(&d, Unit::Hour);
}

#[expect_trap]
test "a PlainTime literal out of range traps" {
    let _ = PlainTime { hour: 24 }.to_iso8601();
}

#[expect_trap]
test "a PlainYearMonth whose first day is before the range traps in arithmetic" {
    let _ = PlainYearMonth::new(-271821, 4).add(&Duration { months: 1 });
}

#[expect_trap]
test "a PlainMonthDay literal that names no day traps" {
    let _ = PlainMonthDay { month: 2, day: 30 }.to_iso8601();
}
