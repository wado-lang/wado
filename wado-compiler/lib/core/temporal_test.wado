use {
    Instant,
    ZonedDateTime,
    Duration,
    Unit,
    RoundingMode,
    PlainDate,
    PlainTime,
    PlainDateTime,
    PlainYearMonth,
    PlainMonthDay,
} from "core:temporal";
use { Instant as ClockInstant, SystemClock } from "wasi:clocks";
use { to_string, from_string } from "core:json";
use { to_bytes, from_bytes } from "core:cbor";
use { DeserializeErrorKind } from "core:serde";

test "Instant construction and field access" {
    let i = Instant { seconds: 1_700_000_000, nanoseconds: 123_456_789 };
    assert i.seconds == 1_700_000_000;
    assert i.nanoseconds == 123_456_789;
}

test "Instant auto-derives Eq" {
    let a = Instant { seconds: 5, nanoseconds: 7 };
    let b = Instant { seconds: 5, nanoseconds: 7 };
    let c = Instant { seconds: 5, nanoseconds: 8 };
    assert a == b;
    assert a != c;
}

test "Instant Ord is chronological, including before the epoch" {
    // One nanosecond before the epoch is { -1, 999_999_999 }; incrementing
    // nanoseconds always moves forward in time.
    let one_ns_before = Instant { seconds: -1, nanoseconds: 999_999_999 };
    let one_sec_before = Instant { seconds: -1, nanoseconds: 0 };
    let epoch = Instant { seconds: 0, nanoseconds: 0 };
    assert one_sec_before < one_ns_before;
    assert one_ns_before < epoch;
}

test "Instant sorts chronologically" {
    let mut xs: List<Instant> = [
        Instant { seconds: 1, nanoseconds: 0 },
        Instant { seconds: -1, nanoseconds: 999_999_999 },
        Instant { seconds: 0, nanoseconds: 0 },
        Instant { seconds: -1, nanoseconds: 0 },
    ];
    xs.sort();
    assert xs[0] == Instant { seconds: -1, nanoseconds: 0 };
    assert xs[1] == Instant { seconds: -1, nanoseconds: 999_999_999 };
    assert xs[2] == Instant { seconds: 0, nanoseconds: 0 };
    assert xs[3] == Instant { seconds: 1, nanoseconds: 0 };
}

test "Instant auto-derives Inspect" {
    let i = Instant { seconds: 5, nanoseconds: 7 };
    assert `${i:?}` == "Instant { seconds: 5, nanoseconds: 7 }";
}

test "ZonedDateTime construction and nested field access" {
    let zdt = ZonedDateTime {
        instant: Instant { seconds: 1_700_000_000, nanoseconds: 0 },
        time_zone: "America/New_York",
    };
    assert zdt.instant.seconds == 1_700_000_000;
    assert zdt.time_zone == "America/New_York";
}

test "ZonedDateTime auto-derives Eq" {
    let i = Instant { seconds: 0, nanoseconds: 0 };
    let a = ZonedDateTime { instant: i, time_zone: "UTC" };
    let b = ZonedDateTime { instant: i, time_zone: "UTC" };
    let c = ZonedDateTime { instant: i, time_zone: "+00:00" };
    assert a == b;
    // Temporal's TimeZoneEquals: UTC and the zero offset are different zones.
    assert a != c;
}

test "ZonedDateTime Ord compares instant first, then time zone" {
    let earlier = Instant { seconds: 0, nanoseconds: 0 };
    let later = Instant { seconds: 1, nanoseconds: 0 };

    // Different instants order by instant regardless of zone.
    let a = ZonedDateTime { instant: earlier, time_zone: "UTC" };
    let b = ZonedDateTime { instant: later, time_zone: "+09:00" };
    assert a < b;

    // Same instant orders by time zone lexically ("+09:00" < "UTC").
    let c = ZonedDateTime { instant: earlier, time_zone: "+09:00" };
    let d = ZonedDateTime { instant: earlier, time_zone: "UTC" };
    assert c < d;
}

test "Instant Display is Temporal's toString, trimming the fraction" {
    let epoch = Instant { seconds: 0, nanoseconds: 0 };
    assert `${epoch}` == "1970-01-01T00:00:00Z";

    let t = Instant { seconds: 1_700_000_000, nanoseconds: 123_456_789 };
    assert `${t}` == "2023-11-14T22:13:20.123456789Z";
    assert `${Instant { seconds: 1_700_000_000, nanoseconds: 500_000_000 }}` == "2023-11-14T22:13:20.5Z";
    assert t.to_iso8601() == `${t}`;
}

test "Instant Display precision selects sub-second digits, truncating" {
    let t = Instant { seconds: 1_700_000_000, nanoseconds: 123_456_789 };
    assert `${t:.0}` == "2023-11-14T22:13:20Z";
    assert `${t:.3}` == "2023-11-14T22:13:20.123Z";
    assert `${t:.6}` == "2023-11-14T22:13:20.123456Z";
    assert `${t:.9}` == "2023-11-14T22:13:20.123456789Z";
    assert `${Instant::EPOCH:.2}` == "1970-01-01T00:00:00.00Z";
}

test "Instant Display pads sub-second digits with leading zeros" {
    let t = Instant { seconds: 0, nanoseconds: 5 };
    assert `${t:.9}` == "1970-01-01T00:00:00.000000005Z";
    assert `${t:.3}` == "1970-01-01T00:00:00.000Z";
    assert `${t}` == "1970-01-01T00:00:00.000000005Z";
}

test "Instant Display handles instants before the epoch" {
    // One nanosecond before the epoch.
    let t = Instant { seconds: -1, nanoseconds: 999_999_999 };
    assert `${t}` == "1969-12-31T23:59:59.999999999Z";
    assert `${t:.0}` == "1969-12-31T23:59:59Z";
}

test "Instant spans exactly 10^8 days either side of the epoch" {
    let latest = Instant::from_epoch_seconds(8_640_000_000_000);
    assert `${latest}` == "+275760-09-13T00:00:00Z";
    let earliest = Instant::from_epoch_seconds(-8_640_000_000_000);
    assert `${earliest}` == "-271821-04-20T00:00:00Z";
    assert Instant::from_str("+275760-09-13T00:00:00Z") matches { Ok(t) && t == latest };
    assert Instant::from_str("+275760-09-13T00:00:00.000000001Z") matches { Err(_) };
    assert Instant::from_str("-271821-04-19T23:59:59.999999999Z") matches { Err(_) };
}

#[expect_trap]
test "an Instant past the range traps" {
    let _ = Instant::new(8_640_000_000_000, 1);
}

#[expect_trap]
test "arithmetic past the Instant range traps" {
    let _ = Instant::from_epoch_seconds(8_640_000_000_000).add(&Duration { nanoseconds: 1 });
}

#[expect_trap]
test "an out-of-range Instant literal traps when it is used" {
    let _ = `${Instant { seconds: 9_000_000_000_000, nanoseconds: 0 }}`;
}

test "ZonedDateTime Display carries the offset and the zone annotation" {
    let i = Instant { seconds: 1_700_000_000, nanoseconds: 0 };
    // 22:13:20Z + 09:00 rolls over to the next civil day.
    assert `${ZonedDateTime { instant: i, time_zone: "+09:00" }}` == "2023-11-15T07:13:20+09:00[+09:00]";
    assert `${ZonedDateTime { instant: i, time_zone: "-05:00" }}` == "2023-11-14T17:13:20-05:00[-05:00]";
    assert `${ZonedDateTime { instant: i, time_zone: "UTC" }}` == "2023-11-14T22:13:20+00:00[UTC]";
    assert `${ZonedDateTime { instant: i, time_zone: "+00:00" }}` == "2023-11-14T22:13:20+00:00[+00:00]";

    let precise = ZonedDateTime {
        instant: Instant { seconds: 0, nanoseconds: 120_000_000 },
        time_zone: "UTC",
    };
    assert `${precise}` == "1970-01-01T00:00:00.12+00:00[UTC]";
    assert `${precise:.0}` == "1970-01-01T00:00:00+00:00[UTC]";
}

#[expect_trap]
test "ZonedDateTime Display traps on an IANA zone name" {
    let zdt = ZonedDateTime {
        instant: Instant { seconds: 1_700_000_000, nanoseconds: 0 },
        time_zone: "America/New_York",
    };
    // Resolving an IANA offset needs a tz database this module does not bundle.
    let _ = `${zdt}`;
}

test "ZonedDateTime exposes clock-field accessors" {
    let zdt = ZonedDateTime {
        instant: Instant { seconds: 1_700_000_000, nanoseconds: 123_456_789 },
        time_zone: "UTC",
    };
    assert zdt.year() == 2023;
    assert zdt.month() == 11;
    assert zdt.day() == 14;
    assert zdt.hour() == 22;
    assert zdt.minute() == 13;
    assert zdt.second() == 20;
    assert zdt.millisecond() == 123;
    assert zdt.microsecond() == 456;
    assert zdt.nanosecond() == 789;
}

test "ZonedDateTime accessors apply the fixed offset" {
    let zdt = ZonedDateTime {
        instant: Instant { seconds: 1_700_000_000, nanoseconds: 0 },
        time_zone: "+09:00",
    };
    // 2023-11-14T22:13:20Z is 2023-11-15T07:13:20+09:00.
    assert zdt.year() == 2023;
    assert zdt.month() == 11;
    assert zdt.day() == 15;
    assert zdt.hour() == 7;
    assert zdt.day_of_week() == 3;
}

test "ZonedDateTime calendar-derived accessors" {
    let zdt = ZonedDateTime {
        instant: Instant { seconds: 1_700_000_000, nanoseconds: 0 },
        time_zone: "UTC",
    };
    assert zdt.day_of_week() == 2;
    assert zdt.day_of_year() == 318;
    assert zdt.days_in_month() == 30;
    assert zdt.days_in_year() == 365;
    assert !zdt.in_leap_year();
    assert zdt.months_in_year() == 12;
}

test "ZonedDateTime accessors handle leap years" {
    // 2024-01-01T00:00:00Z (a Monday).
    let jan1 = ZonedDateTime {
        instant: Instant { seconds: 1_704_067_200, nanoseconds: 0 },
        time_zone: "UTC",
    };
    assert jan1.year() == 2024;
    assert jan1.month() == 1;
    assert jan1.day() == 1;
    assert jan1.day_of_week() == 1;
    assert jan1.in_leap_year();
    assert jan1.days_in_year() == 366;

    // 2024-02-29T00:00:00Z exists only in a leap year.
    let leap_day = ZonedDateTime {
        instant: Instant { seconds: 1_709_164_800, nanoseconds: 0 },
        time_zone: "UTC",
    };
    assert leap_day.month() == 2;
    assert leap_day.day() == 29;
    assert leap_day.days_in_month() == 29;
    assert leap_day.day_of_year() == 60;
}

test "ZonedDateTime accessors handle instants before the epoch" {
    // 1969-12-31T23:59:59Z (a Wednesday).
    let zdt = ZonedDateTime {
        instant: Instant { seconds: -1, nanoseconds: 0 },
        time_zone: "UTC",
    };
    assert zdt.year() == 1969;
    assert zdt.month() == 12;
    assert zdt.day() == 31;
    assert zdt.hour() == 23;
    assert zdt.minute() == 59;
    assert zdt.second() == 59;
    assert zdt.day_of_week() == 3;
}

#[expect_trap]
test "ZonedDateTime accessors trap on an IANA zone name" {
    let zdt = ZonedDateTime {
        instant: Instant { seconds: 0, nanoseconds: 0 },
        time_zone: "Asia/Tokyo",
    };
    let _ = zdt.year();
}

#[expect_trap]
test "the sub-second accessors trap on an IANA zone name too" {
    // Their answer does not depend on the offset, but a zone the rest of the
    // type cannot read is not one to answer from either.
    let zdt = ZonedDateTime {
        instant: Instant { seconds: 0, nanoseconds: 123_456_789 },
        time_zone: "Asia/Tokyo",
    };
    let _ = zdt.millisecond();
}

#[expect_trap]
test "ZonedDateTime::months_in_year also traps on an IANA zone name" {
    let zdt = ZonedDateTime {
        instant: Instant { seconds: 0, nanoseconds: 0 },
        time_zone: "Asia/Tokyo",
    };
    let _ = zdt.months_in_year();
}

test "Instant exposes epoch convenience accessors" {
    let t = Instant { seconds: 1_700_000_000, nanoseconds: 123_456_789 };
    assert t.epoch_milliseconds() == 1_700_000_000_123;
    assert t.epoch_nanoseconds() == 1_700_000_000_123_456_789;

    // One nanosecond before the epoch.
    let before = Instant { seconds: -1, nanoseconds: 999_999_999 };
    assert before.epoch_milliseconds() == -1;
    assert before.epoch_nanoseconds() == -1;
}

test "Instant::new normalizes the sub-second part" {
    // Carry an overflowing nanosecond count into seconds.
    assert Instant::new(10, 2_500_000_000) == Instant { seconds: 12, nanoseconds: 500_000_000 };
    // Borrow for a negative nanosecond count.
    assert Instant::new(0, -1) == Instant { seconds: -1, nanoseconds: 999_999_999 };
    assert Instant::new(5, 0) == Instant { seconds: 5, nanoseconds: 0 };
}

test "Instant epoch constructors invert the epoch accessors" {
    assert Instant::from_epoch_seconds(1_700_000_000) == Instant { seconds: 1_700_000_000, nanoseconds: 0 };

    let from_ms = Instant::from_epoch_milliseconds(1_700_000_000_123);
    assert from_ms == Instant { seconds: 1_700_000_000, nanoseconds: 123_000_000 };
    assert from_ms.epoch_milliseconds() == 1_700_000_000_123;

    let from_ns = Instant::from_epoch_nanoseconds(1_700_000_000_123_456_789);
    assert from_ns == Instant { seconds: 1_700_000_000, nanoseconds: 123_456_789 };
    assert from_ns.epoch_nanoseconds() == 1_700_000_000_123_456_789;

    // Negative milliseconds floor toward the epoch's past.
    assert Instant::from_epoch_milliseconds(-1) == Instant { seconds: -1, nanoseconds: 999_000_000 };
}

test "Instant::from_unix_seconds splits fractional seconds" {
    assert Instant::from_unix_seconds(1_700_000_000.5) == Instant { seconds: 1_700_000_000, nanoseconds: 500_000_000 };
    assert Instant::from_unix_seconds(0.0) == Instant { seconds: 0, nanoseconds: 0 };
    // Half a second before the epoch.
    assert Instant::from_unix_seconds(-0.5) == Instant { seconds: -1, nanoseconds: 500_000_000 };
}

#[expect_trap]
test "Instant::from_unix_seconds traps on NaN" {
    let _ = Instant::from_unix_seconds(f64::NAN);
}

test "ZonedDateTime::parse_rfc3339 parses a UTC timestamp into the UTC zone" {
    let zdt = ZonedDateTime::parse_rfc3339("2023-11-14T22:13:20Z").unwrap();
    assert zdt.instant == Instant { seconds: 1_700_000_000, nanoseconds: 0 };
    assert zdt.year() == 2023;
    assert zdt.month() == 11;
    assert zdt.day() == 14;
    assert zdt.hour() == 22;
    assert zdt.minute() == 13;
    assert zdt.second() == 20;
    assert zdt.time_zone == "UTC";
}

test "ZonedDateTime::parse_rfc3339 keeps a numeric offset as an offset zone" {
    let zdt = ZonedDateTime::parse_rfc3339("2023-11-15T07:13:20+09:00").unwrap();
    // Same instant as 2023-11-14T22:13:20Z.
    assert zdt.instant == Instant { seconds: 1_700_000_000, nanoseconds: 0 };
    assert zdt.time_zone == "+09:00";
    // Local wall-clock fields reflect the offset.
    assert zdt.day() == 15;
    assert zdt.hour() == 7;
    assert ZonedDateTime::parse_rfc3339("2023-11-14T22:13:20+00:00") matches { Ok(z) && z.time_zone == "+00:00" };
}

test "ZonedDateTime::parse_rfc3339 reads up to nine fractional digits" {
    let zdt = ZonedDateTime::parse_rfc3339("1970-01-01T00:00:00.123456789Z").unwrap();
    assert zdt.instant == Instant { seconds: 0, nanoseconds: 123_456_789 };

    // A short fraction is padded; a tenth digit is outside the grammar.
    let half = ZonedDateTime::parse_rfc3339("1970-01-01T00:00:00.5Z").unwrap();
    assert half.instant == Instant { seconds: 0, nanoseconds: 500_000_000 };
    assert ZonedDateTime::parse_rfc3339("1970-01-01T00:00:00.1234567899Z") matches { Err(_) };
    assert ZonedDateTime::parse_rfc3339("2023-01-01T00:00:00.1234567891234Z") matches { Err(_) };
}

test "ZonedDateTime::parse_rfc3339 accepts a negative offset and lowercase separators" {
    let zdt = ZonedDateTime::parse_rfc3339("2023-11-14t17:13:20-05:00").unwrap();
    assert zdt.instant == Instant { seconds: 1_700_000_000, nanoseconds: 0 };
    assert zdt.time_zone == "-05:00";
}

test "ZonedDateTime::parse_rfc3339 round-trips through to_rfc3339" {
    let original = "2023-11-15T07:13:20+09:00";
    let zdt = ZonedDateTime::parse_rfc3339(original).unwrap();
    assert zdt.to_rfc3339() == original;

    // A negative pre-epoch instant also round-trips; UTC spells its offset.
    let pre = ZonedDateTime::parse_rfc3339("1969-12-31T23:59:59Z").unwrap();
    assert pre.instant == Instant { seconds: -1, nanoseconds: 0 };
    assert pre.to_rfc3339() == "1969-12-31T23:59:59+00:00";
}

test "ZonedDateTime::parse_rfc3339 parses extended ISO 8601 years" {
    let big = ZonedDateTime::parse_rfc3339("+012023-11-14T22:13:20Z").unwrap();
    assert big.year() == 12023;

    let neg = ZonedDateTime::parse_rfc3339("-000001-01-01T00:00:00Z").unwrap();
    assert neg.year() == -1;
}

test "ZonedDateTime::parse_rfc3339 returns Err without an offset or on malformed input" {
    assert ZonedDateTime::parse_rfc3339("2023-11-14T22:13:20") matches { Err(_) };
    assert ZonedDateTime::parse_rfc3339("2023/11/14 22:13:20Z") matches { Err(_) };
    assert ZonedDateTime::parse_rfc3339("not-a-timestamp") matches { Err(_) };
    // An annotation is RFC 9557, not RFC 3339, and a sub-minute offset names no zone.
    assert ZonedDateTime::parse_rfc3339("2023-11-14T22:13:20Z[UTC]") matches { Err(_) };
    assert ZonedDateTime::parse_rfc3339("2023-11-14T22:13:20+00:00:30") matches { Err(_) };
}

test "ZonedDateTime::parse_rfc3339 range-checks the calendar fields" {
    assert ZonedDateTime::parse_rfc3339("2023-13-01T00:00:00Z") matches { Err(_) };
    assert ZonedDateTime::parse_rfc3339("2023-02-30T00:00:00Z") matches { Err(_) };
    assert ZonedDateTime::parse_rfc3339("2023-01-01T24:00:00Z") matches { Err(_) };
    assert ZonedDateTime::parse_rfc3339("2023-01-01T00:60:00Z") matches { Err(_) };
    assert ZonedDateTime::parse_rfc3339("2023-01-01T00:00:00+24:00") matches { Err(_) };

    // Feb 29 is valid only in a leap year.
    assert ZonedDateTime::parse_rfc3339("2024-02-29T00:00:00Z") matches { Ok(_) };
    assert ZonedDateTime::parse_rfc3339("2023-02-29T00:00:00Z") matches { Err(_) };
}

test "ISO strings require a four-digit year or a signed six-digit one" {
    // ISO 8601 fixes the year at four digits, or a sign plus exactly six.
    assert Instant::from_str("1-01-01T00:00:00Z") matches { Err(_) };
    assert Instant::from_str("999-01-01T00:00:00Z") matches { Err(_) };
    assert Instant::from_str("12023-11-14T22:13:20Z") matches { Err(_) };

    // A sign demands the six-digit expanded form, not four digits.
    assert Instant::from_str("+2023-11-14T22:13:20Z") matches { Err(_) };
    assert Instant::from_str("+002023-11-14T22:13:20Z") matches { Ok(t) && t.seconds == 1_700_000_000 };

    // `-000000` is the one expanded year ISO 8601 forbids: negative zero.
    assert PlainDate::from_str("-000000-01-01") matches { Err(_) };
    assert PlainDate::from_str("+000000-01-01") matches { Ok(d) && d.year == 0 };
}

test "a leap second is constrained to 59" {
    // RFC 3339 permits :60; Temporal reads it and clamps, since the ISO
    // calendar has no 61st second to represent.
    let leap = ZonedDateTime::parse_rfc3339("2016-12-31T23:59:60Z").unwrap();
    assert leap.second() == 59;
    assert leap.instant == ZonedDateTime::parse_rfc3339("2016-12-31T23:59:59Z").unwrap().instant;

    // :61 is not a leap second and stays rejected.
    assert ZonedDateTime::parse_rfc3339("2016-12-31T23:59:61Z") matches { Err(_) };
}

test "Instant::from_str reads any offset, keeping only the exact instant" {
    assert Instant::from_str("2023-11-15T07:13:20+09:00") matches { Ok(t) && t == Instant {
        seconds: 1_700_000_000,
        nanoseconds: 0,
    } };
    assert Instant::from_str("2023-11-14T22:13:20Z") matches { Ok(t) && t == Instant {
        seconds: 1_700_000_000,
        nanoseconds: 0,
    } };
    // An exact time needs Z or an offset, and a time.
    assert Instant::from_str("2023-11-14T22:13:20") matches { Err(_) };
    assert Instant::from_str("2023-11-14") matches { Err(_) };
    assert Instant::from_str("nope") matches { Err(_) };
}

test "Instant::from_str reads the whole RFC 9557 grammar" {
    let expected = Instant { seconds: 1_700_000_000, nanoseconds: 0 };
    // Basic format, lowercase designators, and a space separator.
    assert Instant::from_str("20231114T221320Z") matches { Ok(t) && t == expected };
    assert Instant::from_str("2023-11-14 22:13:20z") matches { Ok(t) && t == expected };
    // Hour-only and minute-precision times.
    assert Instant::from_str("2023-11-14T22Z") matches { Ok(t) && t.seconds == 1_699_999_200 };
    assert Instant::from_str("2023-11-14T22:13Z") matches { Ok(t) && t.seconds == 1_699_999_980 };
    // A comma separates the fraction as well as a period.
    assert Instant::from_str("2023-11-14T22:13:20,5Z") matches { Ok(t) && t.nanoseconds == 500_000_000 };
    // An offset may carry seconds and a fraction, and -00:00 means +00:00.
    assert Instant::from_str("2023-11-14T22:13:50+00:00:30") matches { Ok(t) && t == expected };
    assert Instant::from_str("2023-11-14T22:13:20-00:00") matches { Ok(t) && t == expected };
    assert Instant::from_str("2023-11-15T07:13:20+0900") matches { Ok(t) && t == expected };
    assert Instant::from_str("2023-11-15T07:13:20+09") matches { Ok(t) && t == expected };
    // Annotations are read and set aside; an unknown critical one is refused.
    assert Instant::from_str("2023-11-14T22:13:20Z[Asia/Tokyo][u-ca=iso8601][foo=bar]") matches { Ok(t) && t == expected };
    assert Instant::from_str("2023-11-14T22:13:20Z[!foo=bar]") matches { Err(_) };
    // An instant has no calendar, so it never reads the u-ca value, but two
    // calendars where either is critical are still refused.
    assert Instant::from_str("2023-11-14T22:13:20Z[u-ca=gregory]") matches { Ok(t) && t == expected };
    assert Instant::from_str("2023-11-14T22:13:20Z[u-ca=iso8601][!u-ca=iso8601]") matches { Err(_) };
    // A zone annotation comes before every other annotation.
    assert Instant::from_str("2023-11-14T22:13:20Z[u-ca=iso8601][UTC]") matches { Err(_) };
    // Mixing basic and extended format within one part is not allowed.
    assert Instant::from_str("2023-1114T22:13:20Z") matches { Err(_) };
    assert Instant::from_str("2023-11-14T22:1320Z") matches { Err(_) };
}

test "Instant and ZonedDateTime parse through FromStr" {
    assert Instant::from_str("2023-11-14T22:13:20Z") matches { Ok(t) && t == Instant {
        seconds: 1_700_000_000,
        nanoseconds: 0,
    } };
    assert ZonedDateTime::from_str("2023-11-15T07:13:20+09:00[+09:00]") matches { Ok(zdt) && zdt.time_zone == "+09:00"
        && zdt.instant.seconds == 1_700_000_000 };
}

test "ZonedDateTime::from_str requires and checks the zone annotation" {
    // RFC 3339 alone names an offset, not a zone.
    assert ZonedDateTime::from_str("2023-11-15T07:13:20+09:00") matches { Err(_) };
    // The offset must agree with the zone.
    assert ZonedDateTime::from_str("2023-11-15T07:13:20+09:00[UTC]") matches { Err(_) };
    // Z marks the exact time, read in the annotated zone.
    assert ZonedDateTime::from_str("2023-11-14T22:13:20Z[+09:00]") matches { Ok(z) && z.hour() == 7
        && z.instant.seconds == 1_700_000_000 };
    // No offset reads the wall clock in the zone; no time is the start of day.
    assert ZonedDateTime::from_str("2023-11-15T07:13:20[+09:00]") matches { Ok(z) && z.instant.seconds == 1_700_000_000 };
    assert ZonedDateTime::from_str("2023-11-15[utc]") matches { Ok(z) && z.time_zone == "UTC" && z.hour() == 0 };
    // Only UTC and offsets are available without a time zone database.
    assert ZonedDateTime::from_str("2023-11-15T07:13:20+09:00[Asia/Tokyo]") matches { Err(_) };
    assert ZonedDateTime::from_str("2023-11-15T07:13:20+09:00[!u-ca=iso8601]") matches { Err(_) };
}

test "Instant exposes microsecond and full-range nanosecond epochs" {
    let t = Instant { seconds: 1_700_000_000, nanoseconds: 123_456_789 };
    assert t.epoch_microseconds() == 1_700_000_000_123_456;
    assert t.epoch_nanoseconds() == 1_700_000_000_123_456_789;
    assert Instant::from_epoch_microseconds(1_700_000_000_123_456) == Instant {
        seconds: 1_700_000_000,
        nanoseconds: 123_456_000,
    };

    // i128 nanoseconds reach far beyond the ±292 years an i64 count spans.
    let far = Instant { seconds: 253_402_300_799, nanoseconds: 0 };
    assert far.epoch_nanoseconds() == 253_402_300_799_000_000_000;
    assert Instant::from_epoch_nanoseconds(far.epoch_nanoseconds()) == far;

    // Before the epoch, the nanosecond field still moves time forward.
    let before = Instant { seconds: -1, nanoseconds: 999_999_999 };
    assert before.epoch_nanoseconds() == -1;
    assert before.epoch_microseconds() == -1;
}

test "Instant::EPOCH is the Unix epoch" {
    assert Instant::EPOCH == Instant { seconds: 0, nanoseconds: 0 };
    assert `${Instant::EPOCH}` == "1970-01-01T00:00:00Z";
}

test "Instant projects into a zone and back" {
    let t = Instant { seconds: 1_700_000_000, nanoseconds: 0 };
    let zdt = t.to_zoned_date_time("+09:00");
    assert zdt.hour() == 7 && zdt.day() == 15;
    assert zdt.to_instant() == t;
    // A zone may also be named by an ISO string that carries one.
    assert t.to_zoned_date_time("2020-01-01T00:00+05:30").time_zone == "+05:30";
    assert t.to_zoned_date_time("2020-01-01T00:00Z").time_zone == "UTC";
    assert t.to_zoned_date_time("2020-01-01T00:00+01:00[-02:00]").time_zone == "-02:00";
}

test "ZonedDateTime::new canonicalizes the time zone identifier" {
    let t = Instant::EPOCH;
    assert ZonedDateTime::new(t, "UTC").time_zone == "UTC";
    assert ZonedDateTime::new(t, "utc").time_zone == "UTC";
    assert ZonedDateTime::new(t, "+00:00").time_zone == "+00:00";
    assert ZonedDateTime::new(t, "-00:00").time_zone == "+00:00";
    assert ZonedDateTime::new(t, "+0930").time_zone == "+09:30";
    assert ZonedDateTime::new(t, "-05").time_zone == "-05:00";
    assert ZonedDateTime::new(t, "+23:59").time_zone == "+23:59";
}

#[expect_trap]
test "ZonedDateTime::new rejects Z, which is a designator rather than a zone" {
    let _ = ZonedDateTime::new(Instant::EPOCH, "Z");
}

#[expect_trap]
test "ZonedDateTime::new rejects a zone it has no rules for" {
    let _ = ZonedDateTime::new(Instant::EPOCH, "Asia/Tokyo");
}

#[expect_trap]
test "ZonedDateTime::new rejects an out-of-range offset" {
    let _ = ZonedDateTime::new(Instant::EPOCH, "+24:00");
}

#[expect_trap]
test "ZonedDateTime::new rejects a sub-minute offset" {
    let _ = ZonedDateTime::new(Instant::EPOCH, "+00:00:30");
}

test "ZonedDateTime exposes its epoch and offset views" {
    let zdt = ZonedDateTime::from_str("2023-11-15T07:13:20.5+09:00[+09:00]").unwrap();
    assert zdt.to_instant() == Instant { seconds: 1_700_000_000, nanoseconds: 500_000_000 };
    assert zdt.epoch_milliseconds() == 1_700_000_000_500;
    assert zdt.epoch_nanoseconds() == 1_700_000_000_500_000_000;
    assert zdt.offset() == "+09:00";
    assert zdt.offset_nanoseconds() == 32_400_000_000_000;

    let utc = ZonedDateTime::new(Instant::EPOCH, "UTC");
    assert utc.offset() == "+00:00";
    assert utc.offset_nanoseconds() == 0;
}

test "ZonedDateTime::with_time_zone keeps the instant and moves the wall clock" {
    let utc = ZonedDateTime::parse_rfc3339("2023-11-14T22:13:20Z").unwrap();
    let tokyo = utc.with_time_zone("+09:00");
    assert tokyo.to_instant() == utc.to_instant();
    assert tokyo.hour() == 7 && tokyo.day() == 15;
}

test "ZonedDateTime::start_of_day snaps to local midnight" {
    let zdt = ZonedDateTime::from_str("2023-11-15T07:13:20.5+09:00[+09:00]").unwrap();
    let start = zdt.start_of_day();
    assert `${start}` == "2023-11-15T00:00:00+09:00[+09:00]";
    assert start.start_of_day() == start;

    // A fixed offset has no DST, so every day is 24 hours long.
    assert zdt.hours_in_day() == 24;

    // Before the epoch the floor still lands on the correct civil day.
    let pre = ZonedDateTime::parse_rfc3339("1969-12-31T23:59:59Z").unwrap();
    assert `${pre.start_of_day()}` == "1969-12-31T00:00:00+00:00[UTC]";
}

test "ZonedDateTime exposes the ISO week date" {
    let zdt = ZonedDateTime::parse_rfc3339("2023-11-14T22:13:20Z").unwrap();
    assert zdt.week_of_year() == 46;
    assert zdt.year_of_week() == 2023;
    assert zdt.days_in_week() == 7;

    // 2021-01-01 is a Friday, in ISO week 53 of 2020.
    let early = ZonedDateTime::parse_rfc3339("2021-01-01T00:00:00Z").unwrap();
    assert early.week_of_year() == 53;
    assert early.year_of_week() == 2020;

    // 2019-12-30 is a Monday, already in ISO week 1 of 2020.
    let late = ZonedDateTime::parse_rfc3339("2019-12-30T00:00:00Z").unwrap();
    assert late.week_of_year() == 1;
    assert late.year_of_week() == 2020;
}

test "ZonedDateTime::month_code names the ISO month" {
    assert ZonedDateTime::parse_rfc3339("2023-01-14T00:00:00Z").unwrap().month_code() == "M01";
    assert ZonedDateTime::parse_rfc3339("2023-11-14T00:00:00Z").unwrap().month_code() == "M11";
}

test "Duration defaults every field to zero" {
    let d = Duration { hours: 1, minutes: 30 };
    assert d.hours == 1 && d.minutes == 30;
    assert d.years == 0 && d.days == 0 && d.nanoseconds == 0;
    assert Duration {}.is_zero();
    assert !d.is_zero();
}

test "Duration sign follows its largest non-zero field" {
    assert Duration {}.sign() == 0;
    assert Duration { days: 3 }.sign() == 1;
    assert Duration { days: -3 }.sign() == -1;
    assert Duration { years: 1, nanoseconds: 5 }.sign() == 1;
}

#[expect_trap]
test "a duration whose components disagree in sign traps when used" {
    // Temporal's constructor rejects it; a Wado literal cannot, so every
    // operation does.
    let _ = `${Duration { years: 1, nanoseconds: -5 }}`;
}

#[expect_trap]
test "a duration with 2^32 years is not a valid duration" {
    let _ = Duration { years: 4_294_967_296 }.negated();
}

#[expect_trap]
test "a duration of 2^53 seconds is not a valid duration" {
    let _ = Duration { seconds: 9_007_199_254_740_992 }.abs();
}

test "a decoded epoch number lands on the UTC zone" {
    let zdt = from_string::<ZonedDateTime>("1700000000").expect("decode epoch");
    assert zdt.time_zone == "UTC";
    assert zdt == ZonedDateTime::parse_rfc3339("2023-11-14T22:13:20Z").unwrap();
}

test "Duration negated and abs flip every field together" {
    let d = Duration { years: 1, days: 2, seconds: 3 };
    assert d.negated() == Duration { years: -1, days: -2, seconds: -3 };
    assert Duration { days: -2, seconds: -3 }.abs() == Duration { days: 2, seconds: 3 };
    assert d.negated().negated() == d;
}

test "Duration arithmetic balances into a uniformly signed result" {
    let a = Duration { days: 1, hours: 2 };
    let b = Duration { hours: 3, minutes: 4 };
    assert a.add(&b) == Duration { days: 1, hours: 5, minutes: 4 };

    // A component-wise difference would leave `{ days: 1, hours: -1 }`, which
    // is not a valid duration.
    assert a.subtract(&b) == Duration { hours: 22, minutes: 56 };
    assert `${a.subtract(&b)}` == "PT22H56M";
    assert `${Duration { hours: 1 }.subtract(&Duration { minutes: 30 })}` == "PT30M";

    // The result is expressed at the coarser of the two operands' top units.
    assert Duration { minutes: 30 }.add(&Duration { minutes: 45 }) == Duration { minutes: 75 };
    assert Duration { hours: 1 }.add(&Duration { minutes: 30 }) == Duration { hours: 1, minutes: 30 };
    assert Duration { days: 1 }.subtract(&Duration { hours: 1 }) == Duration { hours: 23 };
}

#[expect_trap]
test "Duration arithmetic rejects a calendar component" {
    // A month has no length to add without knowing where on the calendar it
    // starts, so Temporal demands a relativeTo this module does not take yet.
    let _ = Duration { months: 1 }.add(&Duration { days: 1 });
}

#[expect_trap]
test "Duration arithmetic past the time duration limit traps" {
    let _ = Duration { seconds: 9_007_199_254_740_991 }.add(&Duration { seconds: 1 });
}

#[expect_trap]
test "an out-of-range offset literal traps on use, like an IANA name" {
    let _ = `${ZonedDateTime { instant: Instant::EPOCH, time_zone: "+99:99" }}`;
}

#[expect_trap]
test "a nanosecond span beyond the i64 range traps rather than wrapping" {
    // ~400 years in nanoseconds overflows the i64 a component is stored in.
    let far = Instant::from_epoch_seconds(400 * 365 * 86400);
    let _ = Instant::EPOCH.until(&far, Unit::Nanosecond);
}

test "Duration renders as an ISO 8601 duration" {
    assert `${Duration {}}` == "PT0S";
    assert `${Duration { years: 1, months: 2, weeks: 3, days: 4 }}` == "P1Y2M3W4D";
    assert `${Duration { hours: 1, minutes: 30 }}` == "PT1H30M";
    assert `${Duration { seconds: 1, milliseconds: 500 }}` == "PT1.5S";
    assert `${Duration { nanoseconds: 1 }}` == "PT0.000000001S";
    assert `${Duration { days: -1, hours: -2 }}` == "-P1DT2H";
    assert `${Duration { weeks: 2 }}` == "P2W";
    // Sub-second components fold into the seconds, however large they are.
    assert `${Duration { milliseconds: 9_000_000_000_000 }}` == "PT9000000000S";
    assert `${Duration { milliseconds: 1500, microseconds: 2 }}` == "PT1.500002S";
    // A zero seconds part is written only when nothing larger is.
    assert `${Duration { minutes: 1, seconds: 0 }}` == "PT1M";
    assert Duration { hours: 1 }.to_iso8601() == "PT1H";
}

test "Duration Display precision fixes the fraction, truncating" {
    let d = Duration { seconds: 1, milliseconds: 987 };
    assert `${d:.0}` == "PT1S";
    assert `${d:.1}` == "PT1.9S";
    assert `${d:.5}` == "PT1.98700S";
    // A fixed precision always writes the seconds.
    assert `${Duration { hours: 1 }:.2}` == "PT1H0.00S";
    assert `${Duration {}:.3}` == "PT0.000S";
    assert `${Duration { milliseconds: -1500 }:.0}` == "-PT1S";
}

test "Duration parses an ISO 8601 duration" {
    assert Duration::parse("P1Y2M3W4DT5H6M7S") matches { Ok(d) && d == Duration {
        years: 1,
        months: 2,
        weeks: 3,
        days: 4,
        hours: 5,
        minutes: 6,
        seconds: 7,
    } };
    assert Duration::parse("PT0S") matches { Ok(d) && d.is_zero() };
    assert Duration::parse("-P1D") matches { Ok(d) && d == Duration { days: -1 } };
    assert Duration::parse("+PT1H") matches { Ok(d) && d == Duration { hours: 1 } };
    // Weeks combine with any other unit, and designators may be lowercase.
    assert Duration::parse("P1M1W1D") matches { Ok(d) && d == Duration { months: 1, weeks: 1, days: 1 } };
    assert Duration::parse("pt1m") matches { Ok(d) && d == Duration { minutes: 1 } };

    // A fraction spills into the units below it, as Temporal balances it.
    assert Duration::parse("PT1.5H") matches { Ok(d) && d == Duration { hours: 1, minutes: 30 } };
    assert Duration::parse("PT1,5H") matches { Ok(d) && d == Duration { hours: 1, minutes: 30 } };
    assert Duration::parse("PT1.5M") matches { Ok(d) && d == Duration { minutes: 1, seconds: 30 } };
    assert Duration::parse("PT1.5S") matches { Ok(d) && d == Duration { seconds: 1, milliseconds: 500 } };
    assert Duration::parse("PT0.000000001H") matches { Ok(d) && d == Duration { microseconds: 3, nanoseconds: 600 } };
}

test "Duration rejects malformed ISO 8601 durations" {
    assert Duration::parse("") matches { Err(_) };
    assert Duration::parse("P") matches { Err(_) };
    assert Duration::parse("1D") matches { Err(_) };
    assert Duration::parse("P1D2H") matches { Err(_) };
    assert Duration::parse("PT1H2Y") matches { Err(_) };
    assert Duration::parse("P1DT") matches { Err(_) };
    // A fraction must be on the last component present, and a date part takes none.
    assert Duration::parse("PT1.5H30M") matches { Err(_) };
    assert Duration::parse("P1.5D") matches { Err(_) };
    // At most nine fractional digits.
    assert Duration::parse("PT1.0000000001S") matches { Err(_) };
}

test "Duration parsing rejects what is not a valid duration" {
    // Digits that overflow are an error, not a wrapped value.
    assert Duration::parse("PT99999999999999999999S") matches { Err(_) };
    assert Duration::parse("P4294967296Y") matches { Err(_) };
    assert Duration::parse("P4294967295Y") matches { Ok(_) };
    assert Duration::parse("PT9007199254740992S") matches { Err(_) };
    assert Duration::parse("PT9007199254740991.999999999S") matches { Ok(_) };
    assert Duration::parse("P104249991375D") matches { Err(_) };
}

test "Duration round-trips through its ISO 8601 form" {
    for let text of ["P1Y2M3W4DT5H6M7.5S", "-P1DT2H", "PT0S", "PT0.000000001S"] {
        let parsed = Duration::parse(text).expect(`parse ${text}`);
        assert `${parsed}` == text;
    }
}

test "Instant adds and subtracts an exact duration" {
    let t = Instant { seconds: 1_700_000_000, nanoseconds: 0 };
    assert t.add(&Duration { hours: 1 }) == Instant { seconds: 1_700_003_600, nanoseconds: 0 };
    assert t.subtract(&Duration { hours: 1 }) == Instant { seconds: 1_699_996_400, nanoseconds: 0 };
    assert t.add(&Duration { nanoseconds: -1 }) == Instant { seconds: 1_699_999_999, nanoseconds: 999_999_999 };
    assert t.add(&Duration { hours: 1 }).subtract(&Duration { hours: 1 }) == t;
    assert t.add(&Duration { hours: 48 }) == Instant { seconds: 1_700_172_800, nanoseconds: 0 };
}

#[expect_trap]
test "Instant arithmetic rejects a calendar unit" {
    // A day is not a fixed length once a calendar is involved, so Temporal
    // admits only hours and below on an instant.
    let _ = Instant::EPOCH.add(&Duration { days: 1 });
}

test "Instant::until and since measure the span between two instants" {
    let a = Instant { seconds: 1_700_000_000, nanoseconds: 0 };
    let b = Instant { seconds: 1_700_003_661, nanoseconds: 500_000_000 };

    // The default largest unit is the second, as in Temporal.
    assert a.until(&b) == Duration { seconds: 3661, milliseconds: 500 };
    assert a.until(&b, Unit::Hour) == Duration { hours: 1, minutes: 1, seconds: 1, milliseconds: 500 };
    assert a.until(&b, Unit::Millisecond) == Duration { milliseconds: 3_661_500 };
    assert a.since(&b) == a.until(&b).negated();
    assert b.until(&a) == a.until(&b).negated();
    assert a.until(&a).is_zero();
}

#[expect_trap]
test "Instant::until rejects a date unit" {
    let _ = Instant::EPOCH.until(&Instant::EPOCH, Unit::Day);
}

test "ZonedDateTime adds calendar units in local time" {
    let zdt = ZonedDateTime::from_str("2023-11-14T22:13:20+09:00[+09:00]").unwrap();
    assert `${zdt.add(&Duration { days: 1 })}` == "2023-11-15T22:13:20+09:00[+09:00]";
    assert `${zdt.add(&Duration { months: 1 })}` == "2023-12-14T22:13:20+09:00[+09:00]";
    assert `${zdt.add(&Duration { years: 1 })}` == "2024-11-14T22:13:20+09:00[+09:00]";
    assert `${zdt.add(&Duration { weeks: 2 })}` == "2023-11-28T22:13:20+09:00[+09:00]";
    assert `${zdt.add(&Duration { hours: 2 })}` == "2023-11-15T00:13:20+09:00[+09:00]";
    assert zdt.subtract(&Duration { months: 1 }) == ZonedDateTime::from_str("2023-10-14T22:13:20+09:00[+09:00]").unwrap(
    );
}

test "ZonedDateTime constrains a month-end overflow to the last valid day" {
    let end = ZonedDateTime::from_str("2023-01-31T00:00:00Z[UTC]").unwrap();
    assert end.add(&Duration { months: 1 }).to_rfc3339() == "2023-02-28T00:00:00+00:00";
    assert end.add(&Duration { months: 13 }).to_rfc3339() == "2024-02-29T00:00:00+00:00";

    // Constraining is lossy, so adding a month is not invertible.
    assert end.add(&Duration { months: 1 }).subtract(&Duration { months: 1 }).to_rfc3339() == "2023-01-28T00:00:00+00:00";
}

test "ZonedDateTime::until walks the calendar for a date-unit largest unit" {
    let a = ZonedDateTime::parse_rfc3339("2023-01-31T00:00:00Z").unwrap();
    let b = ZonedDateTime::parse_rfc3339("2024-03-01T12:00:00Z").unwrap();

    // 2023-01-31 + 1y1m lands on 2024-02-29 (constrained), one day short of b.
    assert a.until(&b, Unit::Year) == Duration { years: 1, months: 1, days: 1, hours: 12 };
    assert a.until(&b, Unit::Month) == Duration { months: 13, days: 1, hours: 12 };
    assert a.until(&b, Unit::Week) == Duration { weeks: 56, days: 3, hours: 12 };
    assert a.until(&b, Unit::Day) == Duration { days: 395, hours: 12 };

    // The default largest unit is the hour, as in Temporal.
    assert a.until(&b) == Duration { hours: 9492 };
    assert a.since(&b, Unit::Year) == a.until(&b, Unit::Year).negated();
    assert b.until(&a, Unit::Month) == a.until(&b, Unit::Month).negated();
}

test "ZonedDateTime::until reads the span in the receiver's zone" {
    let a = ZonedDateTime::parse_rfc3339("2023-11-14T22:13:20Z").unwrap();
    let b = a.add(&Duration { days: 1, minutes: 30 });
    assert a.until(&b, Unit::Day) == Duration { days: 1, minutes: 30 };
    assert a.until(&b) == Duration { hours: 24, minutes: 30 };
}

test "ZonedDateTime::until across zones is measured in exact time" {
    let a = ZonedDateTime::from_str("2023-11-14T00:00:00Z[UTC]").unwrap();
    let b = ZonedDateTime::from_str("2023-11-15T09:00:00+09:00[+09:00]").unwrap();
    assert a.until(&b) == Duration { hours: 24 };
}

#[expect_trap]
test "ZonedDateTime::until across zones rejects a date unit" {
    let a = ZonedDateTime::from_str("2023-11-14T00:00:00Z[UTC]").unwrap();
    let b = ZonedDateTime::from_str("2023-11-15T09:00:00+09:00[+09:00]").unwrap();
    let _ = a.until(&b, Unit::Day);
}

test "Duration serializes as its ISO 8601 string" {
    let d = Duration { hours: 1, minutes: 30 };
    assert to_string(&d) matches { Ok(json) && json == `"PT1H30M"` };
    assert from_string::<Duration>(`"PT1H30M"`) matches { Ok(back) && back == d };
    assert from_string::<Duration>(`"nope"`) matches { Err(_) };
}

test "Instant::now reads the system clock" {
    // Any real reading is well past 2020 and well short of 2100. `SystemClock`
    // is a wall clock, so two reads carry no ordering a host correction cannot
    // undo — only the range holds.
    let low = Instant::from_str("2020-01-01T00:00:00Z").unwrap();
    let high = Instant::from_str("2100-01-01T00:00:00Z").unwrap();
    let t = Instant::now();
    assert t > low && t < high;

    // The zoned reading is a reading of the same clock, in the caller's zone.
    let zoned = ZonedDateTime::now("+09:00");
    assert zoned.time_zone == "+09:00";
    assert zoned.to_instant() > low && zoned.to_instant() < high;
}

test "RoundingMode directs and breaks ties" {
    let t = Instant { seconds: 90, nanoseconds: 0 };
    assert t.round(Unit::Minute) == Instant { seconds: 120, nanoseconds: 0 };
    assert t.round(Unit::Minute, 1, RoundingMode::Floor) == Instant { seconds: 60, nanoseconds: 0 };
    assert t.round(Unit::Minute, 1, RoundingMode::Ceil) == Instant { seconds: 120, nanoseconds: 0 };
    assert t.round(Unit::Minute, 1, RoundingMode::Trunc) == Instant { seconds: 60, nanoseconds: 0 };
    assert t.round(Unit::Minute, 1, RoundingMode::HalfEven) == Instant { seconds: 120, nanoseconds: 0 };
    assert t.round(Unit::Minute, 1, RoundingMode::HalfTrunc) == Instant { seconds: 60, nanoseconds: 0 };
}

test "Instant rounds as if positive, so time before the epoch rounds toward the past" {
    // RoundNumberToIncrementAsIfPositive: Trunc is Floor and Expand is Ceil.
    let before = Instant { seconds: -90, nanoseconds: 0 };
    assert before.round(Unit::Minute, 1, RoundingMode::Floor) == Instant { seconds: -120, nanoseconds: 0 };
    assert before.round(Unit::Minute, 1, RoundingMode::Trunc) == Instant { seconds: -120, nanoseconds: 0 };
    assert before.round(Unit::Minute, 1, RoundingMode::Expand) == Instant { seconds: -60, nanoseconds: 0 };
    assert before.round(Unit::Minute, 1, RoundingMode::HalfTrunc) == Instant { seconds: -120, nanoseconds: 0 };
    assert before.round(Unit::Minute, 1, RoundingMode::HalfExpand) == Instant { seconds: -60, nanoseconds: 0 };

    let t = Instant::new(-2, 500_000_000);
    assert t.round(Unit::Second, 1, RoundingMode::Trunc) == Instant::from_epoch_seconds(-2);
}

test "Instant::round takes an increment that divides the day" {
    let t = Instant::from_str("2023-11-14T22:13:20Z").unwrap();
    assert `${t.round(Unit::Minute, 15)}` == "2023-11-14T22:15:00Z";
    assert `${t.round(Unit::Hour, 6, RoundingMode::Floor)}` == "2023-11-14T18:00:00Z";
    // The whole day is an increment of its own for an Instant.
    assert `${t.round(Unit::Hour, 24)}` == "2023-11-15T00:00:00Z";
    assert `${t.round(Unit::Millisecond, 1_800_000, RoundingMode::Floor)}` == "2023-11-14T22:00:00Z";
}

test "Instant::round breaks a half-even tie on the multiple counted from the epoch" {
    // 01:02 is 15.5 four-minute steps after the epoch, and 15 is odd.
    let t = Instant::from_str("1970-01-01T01:02:00Z").unwrap();
    assert `${t.round(Unit::Minute, 4, RoundingMode::HalfEven)}` == "1970-01-01T01:04:00Z";
}

#[expect_trap]
test "rounding rejects a step that does not divide the day" {
    // A 7-hour bucket has no consistent place to start from, so Temporal
    // rejects the increment rather than counting from an arbitrary origin.
    let _ = Instant::EPOCH.round(Unit::Hour, 7);
}

#[expect_trap]
test "Instant::round rejects an increment past a day" {
    let _ = Instant::EPOCH.round(Unit::Hour, 48);
}

#[expect_trap]
test "Instant::round rejects a calendar unit" {
    let _ = Instant::EPOCH.round(Unit::Day);
}

test "ZonedDateTime::round counts from local midnight" {
    let zdt = ZonedDateTime::from_str("2023-11-15T07:13:20+09:00[+09:00]").unwrap();
    assert `${zdt.round(Unit::Hour)}` == "2023-11-15T07:00:00+09:00[+09:00]";
    assert `${zdt.round(Unit::Day)}` == "2023-11-15T00:00:00+09:00[+09:00]";
    assert `${zdt.round(Unit::Minute, 15)}` == "2023-11-15T07:15:00+09:00[+09:00]";

    // Rounding up past the end of the day carries into the next one.
    let late = ZonedDateTime::from_str("2023-11-15T23:59:59Z[UTC]").unwrap();
    assert `${late.round(Unit::Day)}` == "2023-11-16T00:00:00+00:00[UTC]";
}

test "ZonedDateTime::round breaks a half-even tie within the next larger unit" {
    // RoundTime measures minutes within the hour: 01:02 is half of the first
    // four-minute step, and 0 is even.
    let zdt = ZonedDateTime::from_str("1970-01-01T01:02:00Z[UTC]").unwrap();
    assert `${zdt.round(Unit::Minute, 4, RoundingMode::HalfEven)}` == "1970-01-01T01:00:00+00:00[UTC]";
}

#[expect_trap]
test "ZonedDateTime::round takes an hour increment below a whole day" {
    let _ = ZonedDateTime::new(Instant::EPOCH, "UTC").round(Unit::Hour, 24);
}

#[expect_trap]
test "ZonedDateTime::round takes no day increment" {
    let _ = ZonedDateTime::new(Instant::EPOCH, "UTC").round(Unit::Day, 2);
}

test "Duration totals and rounds its exact part" {
    let d = Duration { hours: 1, minutes: 30 };
    assert d.total(Unit::Minute) == 90.0;
    assert d.total(Unit::Hour) == 1.5;
    assert Duration { days: 1 }.total(Unit::Hour) == 24.0;
    assert Duration { milliseconds: 1500 }.total(Unit::Microsecond) == 1_500_000.0;
    assert Duration { seconds: -90 }.total(Unit::Minute) == -1.5;

    assert Duration { minutes: 100 }.round(Unit::Hour, Unit::Hour) == Duration { hours: 2 };
    assert Duration { minutes: 100 }.round(Unit::Hour, Unit::Hour, 1, RoundingMode::Floor) == Duration { hours: 1 };
}

test "Duration::round rounds with the sign, unlike an Instant" {
    let d = Duration { minutes: -90 };
    assert d.round(Unit::Hour, Unit::Hour, 1, RoundingMode::Floor) == Duration { hours: -2 };
    assert d.round(Unit::Hour, Unit::Hour, 1, RoundingMode::Trunc) == Duration { hours: -1 };
    assert d.round(Unit::Hour, Unit::Hour, 1, RoundingMode::HalfExpand) == Duration { hours: -2 };
    assert d.round(Unit::Hour, Unit::Hour, 1, RoundingMode::HalfCeil) == Duration { hours: -1 };
    assert Duration { minutes: 150 }.round(Unit::Hour, Unit::Hour, 1, RoundingMode::HalfEven) == Duration { hours: 2 };
    assert Duration { milliseconds: 1250 }.round(Unit::Millisecond, Unit::Second, 500) == Duration {
        seconds: 1,
        milliseconds: 500,
    };
}

test "Duration::round to days counts a day as 24 hours" {
    assert Duration { hours: 36 }.round(Unit::Day, Unit::Day) == Duration { days: 2 };
    assert Duration { hours: 12 }.round(Unit::Day, Unit::Day, 1, RoundingMode::HalfEven) == Duration {};
    assert Duration { days: 5 }.round(Unit::Day, Unit::Day, 2, RoundingMode::Floor) == Duration { days: 4 };
    assert Duration { hours: 25 }.round(Unit::Hour, Unit::Day) == Duration { days: 1, hours: 1 };
}

#[expect_trap]
test "Duration::round rejects a largest unit below the smallest" {
    let _ = Duration { hours: 2 }.round(Unit::Hour, Unit::Minute);
}

#[expect_trap]
test "Duration::round rejects an increment that does not divide the next unit" {
    let _ = Duration { minutes: 10 }.round(Unit::Minute, Unit::Hour, 7);
}

#[expect_trap]
test "Duration::round rejects an increment of a whole next unit" {
    let _ = Duration { hours: 10 }.round(Unit::Hour, Unit::Day, 24);
}

#[expect_trap]
test "Duration::round rejects a calendar component" {
    let _ = Duration { weeks: 1 }.round(Unit::Day, Unit::Day);
}

#[expect_trap]
test "Duration::total rejects a calendar component" {
    let _ = Duration { months: 1 }.total(Unit::Day);
}

#[expect_trap]
test "Duration::total counts weeks as a calendar unit too" {
    let _ = Duration { weeks: 1 }.total(Unit::Day);
}

test "Instant renders and reads an HTTP-date" {
    // The example RFC 7231 gives for all three forms.
    let expected = Instant { seconds: 784_111_777, nanoseconds: 0 };
    assert expected.to_http_date() == "Sun, 06 Nov 1994 08:49:37 GMT";

    assert Instant::parse_http_date("Sun, 06 Nov 1994 08:49:37 GMT") matches { Ok(t) && t == expected };
    assert Instant::parse_http_date("Sunday, 06-Nov-94 08:49:37 GMT") matches { Ok(t) && t == expected };
    assert Instant::parse_http_date("Sun Nov  6 08:49:37 1994") matches { Ok(t) && t == expected };

    // The epoch itself, and a two-digit day in the asctime form.
    assert Instant::EPOCH.to_http_date() == "Thu, 01 Jan 1970 00:00:00 GMT";
    assert Instant::parse_http_date("Sun Nov 16 08:49:37 1994") matches { Ok(t) && t == Instant {
        seconds: 784_975_777,
        nanoseconds: 0,
    } };
}

test "Instant::parse_http_date rejects malformed input" {
    assert Instant::parse_http_date("") matches { Err(_) };
    assert Instant::parse_http_date("Sun, 06 Nov 1994 08:49:37 UTC") matches { Err(_) };
    assert Instant::parse_http_date("Sun, 06 Xxx 1994 08:49:37 GMT") matches { Err(_) };
    assert Instant::parse_http_date("Sun, 31 Nov 1994 08:49:37 GMT") matches { Err(_) };
    assert Instant::parse_http_date("Sun, 06 Nov 1994 08:49:37 GMT trailing") matches { Err(_) };
    // The weekday is advisory, but it has to be a weekday name.
    assert Instant::parse_http_date("Garbage, 06 Nov 1994 08:49:37 GMT") matches { Err(_) };
    assert Instant::parse_http_date("Xyz, 06 Nov 1994 08:49:37 GMT") matches { Err(_) };
    assert Instant::parse_http_date("Sun, 06-Nov-94 08:49:37 GMT") matches { Err(_) };
    assert Instant::parse_http_date("Xyz Nov  6 08:49:37 1994") matches { Err(_) };
    assert Instant::parse_http_date("Mon, 06 Nov 1994 08:49:37 GMT") matches { Ok(_) };
}

test "PlainDate constructs, parses, and renders" {
    let d = PlainDate::new(2023, 11, 14);
    assert `${d}` == "2023-11-14";
    assert PlainDate::from_str("2023-11-14") matches { Ok(p) && p == d };
    assert PlainDate::from_str("2023-02-29") matches { Err(_) };

    // `constrain` clamps a day past the month's end; `..base` is Temporal's `with`.
    assert PlainDate::constrain(2023, 2, 31) == PlainDate::new(2023, 2, 28);
    assert PlainDate { ..d, day: 1 } == PlainDate::new(2023, 11, 1);
}

test "PlainDate::from_str reads any date-time string without a Z" {
    let d = PlainDate::new(2023, 11, 14);
    assert PlainDate::from_str("20231114") matches { Ok(p) && p == d };
    assert PlainDate::from_str("2023-11-14T23:59:59.9+09:00[Asia/Tokyo]") matches { Ok(p) && p == d };
    assert PlainDate::from_str("2023-11-14[u-ca=iso8601]") matches { Ok(p) && p == d };
    // Z names an exact time, which a plain date has no reading of.
    assert PlainDate::from_str("2023-11-14T00:00:00Z") matches { Err(_) };
    assert PlainDate::from_str("2023-11-14[u-ca=japanese]") matches { Err(_) };
    assert PlainDate::from_str("2023-11-14 ") matches { Err(_) };
}

#[expect_trap]
test "PlainDate::new asserts the day exists" {
    let _ = PlainDate::new(2023, 2, 29);
}

test "PlainDate spans -271821-04-19 through +275760-09-13" {
    assert `${PlainDate::new(-271821, 4, 19)}` == "-271821-04-19";
    assert `${PlainDate::new(275760, 9, 13)}` == "+275760-09-13";
    assert PlainDate::from_str("-271821-04-18") matches { Err(_) };
    assert PlainDate::from_str("+275760-09-14") matches { Err(_) };
}

#[expect_trap]
test "a PlainDate before the range traps" {
    let _ = PlainDate::new(-271821, 4, 18);
}

#[expect_trap]
test "PlainDate arithmetic past the range traps" {
    let _ = PlainDate::new(275760, 9, 13).add(&Duration { days: 1 });
}

test "PlainDate exposes the ISO calendar" {
    let d = PlainDate::new(2023, 11, 14);
    assert d.day_of_week() == 2;
    assert d.day_of_year() == 318;
    assert d.week_of_year() == 46 && d.year_of_week() == 2023;
    assert d.days_in_month() == 30 && d.days_in_year() == 365;
    assert d.months_in_year() == 12 && d.days_in_week() == 7;
    assert !d.in_leap_year();
    assert d.month_code() == "M11";
    assert PlainDate::new(2024, 2, 29).in_leap_year();
}

test "PlainDate does calendar arithmetic" {
    let d = PlainDate::new(2023, 1, 31);
    assert d.add(&Duration { months: 1 }) == PlainDate::new(2023, 2, 28);
    assert d.add(&Duration { days: 1 }) == PlainDate::new(2023, 2, 1);
    assert d.add(&Duration { years: 1, weeks: 1 }) == PlainDate::new(2024, 2, 7);
    assert d.subtract(&Duration { days: 31 }) == PlainDate::new(2022, 12, 31);

    let later = PlainDate::new(2024, 3, 1);
    assert d.until(&later) == Duration { days: 395 };
    assert d.until(&later, Unit::Year) == Duration { years: 1, months: 1, days: 1 };
    assert d.until(&later, Unit::Week) == Duration { weeks: 56, days: 3 };
    assert later.since(&d) == d.until(&later);
}

test "PlainDate::add folds whole days of time into the date and drops the rest" {
    let d = PlainDate::new(2023, 1, 31);
    assert d.add(&Duration { hours: 25 }) == PlainDate::new(2023, 2, 1);
    assert d.add(&Duration { hours: 23, minutes: 59 }) == d;
    assert d.add(&Duration { hours: -25 }) == PlainDate::new(2023, 1, 30);
    assert d.add(&Duration { days: 1, hours: 24 }) == PlainDate::new(2023, 2, 2);
}

test "a month difference never overshoots the target day" {
    // 01-31 plus a month is 02-28, so 01-31 to 02-28 is not a whole month.
    let end_of_january = PlainDate::new(2023, 1, 31);
    assert end_of_january.until(&PlainDate::new(2023, 2, 28), Unit::Month) == Duration { days: 28 };
    assert end_of_january.until(&PlainDate::new(2023, 3, 1), Unit::Month) == Duration { months: 1, days: 1 };
    assert end_of_january.until(&PlainDate::new(2023, 3, 31), Unit::Month) == Duration { months: 2 };
    assert PlainDate::new(2024, 2, 29).until(&PlainDate::new(2025, 2, 28), Unit::Year) == Duration {
        months: 11,
        days: 30,
    };
    // Backwards, 03-31 less a month is 02-31, which has not yet reached 02-28.
    assert PlainDate::new(2023, 3, 31).until(&PlainDate::new(2023, 2, 28), Unit::Month) == Duration { months: -1 };
}

test "PlainTime constructs, parses, and renders" {
    assert `${PlainTime { hour: 9 }}` == "09:00:00";
    assert `${PlainTime::new(22, 13, 20, 500)}` == "22:13:20.5";
    assert `${PlainTime::new(22, 13, 20, 500):.3}` == "22:13:20.500";
    assert `${PlainTime::new(22, 13, 20, 500, 6, 7):.4}` == "22:13:20.5000";
    assert PlainTime::from_str("22:13") matches { Ok(t) && t == PlainTime { hour: 22, minute: 13 } };
    assert PlainTime::from_str("22:13:20.5") matches { Ok(t) && t == PlainTime {
        hour: 22,
        minute: 13,
        second: 20,
        millisecond: 500,
    } };
    assert PlainTime::from_str("24:00") matches { Err(_) };
    assert PlainTime { hour: 9 } < PlainTime { hour: 9, minute: 1 };
}

test "PlainTime::from_str reads the TemporalTimeString grammar" {
    let t = PlainTime { hour: 22, minute: 13 };
    assert PlainTime::from_str("T22:13") matches { Ok(p) && p == t };
    assert PlainTime::from_str("t2213") matches { Ok(p) && p == t };
    assert PlainTime::from_str("2213") matches { Ok(p) && p == t };
    assert PlainTime::from_str("22") matches { Ok(p) && p == PlainTime { hour: 22 } };
    assert PlainTime::from_str("22:13+09:00[Asia/Tokyo]") matches { Ok(p) && p == t };
    assert PlainTime::from_str("2023-11-14T22:13") matches { Ok(p) && p == t };
    // A time is required, and Z names an exact time.
    assert PlainTime::from_str("2023-11-14") matches { Err(_) };
    assert PlainTime::from_str("22:13Z") matches { Err(_) };
    // Text that also reads as a month-day or a year-month needs the T.
    assert PlainTime::from_str("1214") matches { Err(_) };
    assert PlainTime::from_str("T1214") matches { Ok(p) && p == PlainTime { hour: 12, minute: 14 } };
    assert PlainTime::from_str("2021-12") matches { Err(_) };
    assert PlainTime::from_str("T2021-12") matches { Ok(p) && p == PlainTime { hour: 20, minute: 21 } };
}

test "PlainTime wraps around midnight" {
    let t = PlainTime { hour: 23, minute: 30 };
    assert t.add(&Duration { hours: 1 }) == PlainTime { hour: 0, minute: 30 };
    assert t.subtract(&Duration { hours: 24 }) == t;
    assert PlainTime {}.subtract(&Duration { nanoseconds: 1 }) == PlainTime {
        hour: 23,
        minute: 59,
        second: 59,
        millisecond: 999,
        microsecond: 999,
        nanosecond: 999,
    };
    assert t.until(&PlainTime { hour: 23, minute: 45 }) == Duration { minutes: 15 };
    assert t.round(Unit::Hour) == PlainTime {};
}

test "PlainTime::add ignores days and wraps any amount of time" {
    let t = PlainTime { hour: 23, minute: 30 };
    assert t.add(&Duration { days: 1, hours: 1 }) == PlainTime { hour: 0, minute: 30 };
    assert t.add(&Duration { weeks: 3 }) == t;
    assert PlainTime {}.add(&Duration { hours: 3_000_000_000 }) == PlainTime {};
    assert PlainTime {}.add(&Duration { hours: 3_000_000_001 }) == PlainTime { hour: 1 };
}

test "PlainTime::round measures the quantity within the next larger unit" {
    assert PlainTime { hour: 1, minute: 2 }.round(Unit::Minute, 4, RoundingMode::HalfEven) == PlainTime { hour: 1 };
    assert PlainTime { hour: 23, minute: 59, second: 59, millisecond: 600 }.round(Unit::Second) == PlainTime {};
    assert PlainTime { hour: 13 }.round(Unit::Hour, 12, RoundingMode::Floor) == PlainTime { hour: 12 };
}

#[expect_trap]
test "PlainTime::round takes an hour increment below a whole day" {
    let _ = PlainTime { hour: 13 }.round(Unit::Hour, 24);
}

#[expect_trap]
test "PlainTime::until rejects a date unit" {
    let _ = PlainTime {}.until(&PlainTime {}, Unit::Day);
}

test "PlainDateTime pairs a date with a clock and carries into the date" {
    let dt = PlainDateTime::new(PlainDate::new(2023, 11, 14), PlainTime { hour: 23, minute: 30 });
    assert `${dt}` == "2023-11-14T23:30:00";
    assert PlainDateTime::from_str("2023-11-14T23:30:00") matches { Ok(p) && p == dt };
    assert PlainDateTime::from_str("2023-11-14 23:30") matches { Ok(p) && p == dt };
    // A date alone reads as its midnight.
    assert PlainDateTime::from_str("2023-11-14") matches { Ok(p) && p == PlainDateTime::new(
        PlainDate::new(2023, 11, 14),
    ) };

    // An hour past 23:30 rolls the date over.
    assert dt.add(&Duration { hours: 1 }) == PlainDateTime::new(PlainDate::new(2023, 11, 15), PlainTime {
        hour: 0,
        minute: 30,
    });
    // The default largest unit is the day, as in Temporal.
    assert dt.until(&dt.add(&Duration { days: 1, hours: 1 })) == Duration { days: 1, hours: 1 };
    assert dt.until(&dt.add(&Duration { days: 1, hours: 1 }), Unit::Hour) == Duration { hours: 25 };
}

test "PlainDateTime::round rounds the clock and carries into the date" {
    let dt = PlainDateTime::new(PlainDate::new(2023, 11, 14), PlainTime {
        hour: 23,
        minute: 59,
        second: 59,
        millisecond: 600,
    });
    assert `${dt.round(Unit::Second)}` == "2023-11-15T00:00:00";
    assert `${dt.round(Unit::Day)}` == "2023-11-15T00:00:00";
    assert `${dt.round(Unit::Hour, 6, RoundingMode::Floor)}` == "2023-11-14T18:00:00";
    assert `${dt:.0}` == "2023-11-14T23:59:59";
}

#[expect_trap]
test "PlainDateTime before the range traps" {
    let _ = PlainDateTime::new(PlainDate::new(-271821, 4, 19));
}

test "PlainDateTime spans the instant range widened by a day" {
    let earliest = PlainDateTime::new(PlainDate::new(-271821, 4, 19), PlainTime { nanosecond: 1 });
    assert `${earliest}` == "-271821-04-19T00:00:00.000000001";
    assert PlainDateTime::from_str("-271821-04-19T00:00") matches { Err(_) };
    assert PlainDateTime::from_str("+275760-09-13T23:59:59.999999999") matches { Ok(_) };
}

test "PlainDateTime resolves against a zone, and a ZonedDateTime drops back" {
    let dt = PlainDateTime::new(PlainDate::new(2023, 11, 15), PlainTime { hour: 7, minute: 13, second: 20 });
    let zdt = dt.to_zoned_date_time("+09:00");
    assert `${zdt}` == "2023-11-15T07:13:20+09:00[+09:00]";
    assert zdt.to_instant() == Instant { seconds: 1_700_000_000, nanoseconds: 0 };
    assert zdt.to_plain_date_time() == dt;
    assert zdt.to_plain_date() == dt.date;
    assert zdt.to_plain_time() == dt.time;

    // A date lands on a zone through its midnight by default.
    assert `${PlainDate::new(2023, 11, 15).to_zoned_date_time("+09:00")}` == "2023-11-15T00:00:00+09:00[+09:00]";
}

test "PlainYearMonth and PlainMonthDay carry the partial dates" {
    let ym = PlainYearMonth::new(2024, 2);
    assert `${ym}` == "2024-02";
    assert PlainYearMonth::from_str("2024-02") matches { Ok(p) && p == ym };
    assert ym.days_in_month() == 29 && ym.in_leap_year();
    assert ym.add(&Duration { months: 11 }) == PlainYearMonth::new(2025, 1);
    assert ym.until(&PlainYearMonth::new(2025, 4)) == Duration { years: 1, months: 2 };
    assert ym.until(&PlainYearMonth::new(2025, 4), Unit::Month) == Duration { months: 14 };
    assert ym.to_plain_date(31) == PlainDate::new(2024, 2, 29);

    let leap_day = PlainMonthDay::new(2, 29);
    assert `${leap_day}` == "02-29";
    assert PlainMonthDay::from_str("--02-29") matches { Ok(p) && p == leap_day };
    assert PlainMonthDay::from_str("02-29") matches { Ok(p) && p == leap_day };
    assert leap_day.to_plain_date(2024) == PlainDate::new(2024, 2, 29);
    assert leap_day.to_plain_date(2023) == PlainDate::new(2023, 2, 28);
    assert PlainDate::new(2024, 2, 29).to_plain_month_day() == leap_day;
    assert PlainDate::new(2024, 2, 29).to_plain_year_month() == ym;
}

test "PlainYearMonth and PlainMonthDay read their alternative spellings" {
    let ym = PlainYearMonth::new(2024, 2);
    assert PlainYearMonth::from_str("202402") matches { Ok(p) && p == ym };
    assert PlainYearMonth::from_str("2024-02-15T10:00") matches { Ok(p) && p == ym };
    assert PlainYearMonth::from_str("2024-02[u-ca=iso8601]") matches { Ok(p) && p == ym };
    assert PlainYearMonth::from_str("2024-13") matches { Err(_) };
    assert PlainYearMonth::from_str("-271821-03") matches { Err(_) };
    assert PlainYearMonth::from_str("-271821-04") matches { Ok(_) };

    let md = PlainMonthDay::new(2, 28);
    assert PlainMonthDay::from_str("0228") matches { Ok(p) && p == md };
    assert PlainMonthDay::from_str("--0228") matches { Ok(p) && p == md };
    assert PlainMonthDay::from_str("2023-02-28") matches { Ok(p) && p == md };
    assert PlainMonthDay::from_str("02-30") matches { Err(_) };
}

