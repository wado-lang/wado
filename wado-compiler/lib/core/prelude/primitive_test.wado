// Tests for primitive type methods (f64, f32, etc.).

test "f64::parse basic" {
    if let Some(v) = f64::parse("3.14") {
        assert v == 3.14;
    } else {
        panic("f64::parse failed for 3.14");
    }

    if let Some(v) = f64::parse("0.5") {
        assert v == 0.5;
    } else {
        panic("f64::parse failed for 0.5");
    }

    if let Some(v) = f64::parse("123") {
        assert v == 123.0;
    } else {
        panic("f64::parse failed for 123");
    }

    if let Some(v) = f64::parse("0") {
        assert v == 0.0;
    } else {
        panic("f64::parse failed for 0");
    }
}

test "f64::parse with exponent" {
    if let Some(v) = f64::parse("1e2") {
        assert v == 100.0;
    } else {
        panic("f64::parse failed for 1e2");
    }

    if let Some(v) = f64::parse("1.5e-3") {
        assert v == 0.0015;
    } else {
        panic("f64::parse failed for 1.5e-3");
    }

    if let Some(v) = f64::parse("25E+2") {
        assert v == 2500.0;
    } else {
        panic("f64::parse failed for 25E+2");
    }
}

test "f64::parse with sign" {
    if let Some(v) = f64::parse("-42") {
        assert v == -42.0;
    } else {
        panic("f64::parse failed for -42");
    }

    if let Some(v) = f64::parse("+3.14") {
        assert v == 3.14;
    } else {
        panic("f64::parse failed for +3.14");
    }

    if let Some(v) = f64::parse("-0.5e2") {
        assert v == -50.0;
    } else {
        panic("f64::parse failed for -0.5e2");
    }
}

test "f64::parse infinity" {
    if let Some(v) = f64::parse("inf") {
        assert v == f64::INFINITY;
    } else {
        panic("f64::parse failed for inf");
    }

    if let Some(v) = f64::parse("-inf") {
        assert v == f64::NEG_INFINITY;
    } else {
        panic("f64::parse failed for -inf");
    }

    if let Some(v) = f64::parse("+infinity") {
        assert v == f64::INFINITY;
    } else {
        panic("f64::parse failed for +infinity");
    }

    if let Some(v) = f64::parse("-Infinity") {
        assert v == f64::NEG_INFINITY;
    } else {
        panic("f64::parse failed for -Infinity");
    }

    if let Some(v) = f64::parse("INF") {
        assert v == f64::INFINITY;
    } else {
        panic("f64::parse failed for INF");
    }

    if let Some(v) = f64::parse("INFINITY") {
        assert v == f64::INFINITY;
    } else {
        panic("f64::parse failed for INFINITY");
    }
}

test "f64::parse nan" {
    assert f64::parse("nan") matches { Some(_) };
    assert f64::parse("NaN") matches { Some(_) };
    assert f64::parse("NAN") matches { Some(_) };
}

test "f64::parse negative zero" {
    if let Some(v) = f64::parse("-0") {
        assert v == 0.0;
    } else {
        panic("f64::parse failed for -0");
    }
}

test "f64::parse overflow underflow" {
    if let Some(v) = f64::parse("1e999") {
        assert v == f64::INFINITY;
    } else {
        panic("f64::parse failed for 1e999");
    }

    if let Some(v) = f64::parse("-1e999") {
        assert v == f64::NEG_INFINITY;
    } else {
        panic("f64::parse failed for -1e999");
    }

    if let Some(v) = f64::parse("1e-999") {
        assert v == 0.0;
    } else {
        panic("f64::parse failed for 1e-999");
    }
}

test "f64::parse malformed" {
    assert f64::parse("") matches { None };
    assert f64::parse("abc") matches { None };
    assert f64::parse(".5") matches { None };
    assert f64::parse("5.") matches { None };
    assert f64::parse("+") matches { None };
    assert f64::parse("-") matches { None };
    assert f64::parse("1.2.3") matches { None };
    assert f64::parse("e5") matches { None };
    assert f64::parse("1e") matches { None };
    assert f64::parse("infi") matches { None };
    assert f64::parse("nana") matches { None };
}

test "f32::parse basic" {
    if let Some(v) = f32::parse("3.14") {
        assert v == 3.14 as f32;
    } else {
        panic("f32::parse failed for 3.14");
    }

    if let Some(v) = f32::parse("-42") {
        assert v == -42.0 as f32;
    } else {
        panic("f32::parse failed for -42");
    }

    if let Some(v) = f32::parse("inf") {
        assert v == f32::INFINITY;
    } else {
        panic("f32::parse failed for inf");
    }

    assert f32::parse("") matches { None };
    assert f32::parse(".5") matches { None };
}
