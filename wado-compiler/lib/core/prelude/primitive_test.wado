// Tests for primitive type methods (f64, f32, etc.).

test "f64::from_str basic" {
    assert f64::from_str(&"3.14") matches { Ok(v) && v == 3.14 };
    assert f64::from_str(&"0.5") matches { Ok(v) && v == 0.5 };
    assert f64::from_str(&"123") matches { Ok(v) && v == 123.0 };
    assert f64::from_str(&"0") matches { Ok(v) && v == 0.0 };
}

test "f64::from_str with exponent" {
    assert f64::from_str(&"1e2") matches { Ok(v) && v == 100.0 };
    assert f64::from_str(&"1.5e-3") matches { Ok(v) && v == 0.0015 };
    assert f64::from_str(&"25E+2") matches { Ok(v) && v == 2500.0 };
}

test "f64::from_str with sign" {
    assert f64::from_str(&"-42") matches { Ok(v) && v == -42.0 };
    assert f64::from_str(&"+3.14") matches { Ok(v) && v == 3.14 };
    assert f64::from_str(&"-0.5e2") matches { Ok(v) && v == -50.0 };
}

test "f64::from_str infinity" {
    assert f64::from_str(&"inf") matches { Ok(v) && v == f64::INFINITY };
    assert f64::from_str(&"-inf") matches { Ok(v) && v == f64::NEG_INFINITY };
    assert f64::from_str(&"+infinity") matches { Ok(v) && v == f64::INFINITY };
    assert f64::from_str(&"-Infinity") matches { Ok(v) && v == f64::NEG_INFINITY };
    assert f64::from_str(&"INF") matches { Ok(v) && v == f64::INFINITY };
    assert f64::from_str(&"INFINITY") matches { Ok(v) && v == f64::INFINITY };
}

test "f64::from_str nan" {
    assert f64::from_str(&"nan") matches { Ok(v) && v.is_nan() };
    assert f64::from_str(&"NaN") matches { Ok(v) && v.is_nan() };
    assert f64::from_str(&"NAN") matches { Ok(v) && v.is_nan() };
}

test "f64::from_str negative zero" {
    assert f64::from_str(&"-0") matches { Ok(v) && v == 0.0 };
}

test "f64::from_str overflow underflow" {
    assert f64::from_str(&"1e999") matches { Ok(v) && v == f64::INFINITY };
    assert f64::from_str(&"-1e999") matches { Ok(v) && v == f64::NEG_INFINITY };
    assert f64::from_str(&"1e-999") matches { Ok(v) && v == 0.0 };

    // Boundary: eff_p 350 is within table, 351 overflows
    assert f64::from_str(&"1e350") matches { Ok(v) && v.is_finite() };
    assert f64::from_str(&"1e351") matches { Ok(v) && v == f64::INFINITY };
    assert f64::from_str(&"-1e351") matches { Ok(v) && v == f64::NEG_INFINITY };

    // Boundary: eff_p -351 is within table (subnormal), -352 underflows to zero
    assert f64::from_str(&"1e-351") matches { Ok(v) && v.is_finite() && v > 0.0 };
    assert f64::from_str(&"1e-352") matches { Ok(v) && v == 0.0 };
}

test "f64::from_str malformed" {
    assert f64::from_str(&"") matches { Err(e) && e.kind() == FloatErrorKind::Empty };
    assert f64::from_str(&"abc") matches { Err(e) && e.kind() == FloatErrorKind::Invalid };
    assert f64::from_str(&".5") matches { Err(_) };
    assert f64::from_str(&"5.") matches { Err(_) };
    assert f64::from_str(&"+") matches { Err(_) };
    assert f64::from_str(&"-") matches { Err(_) };
    assert f64::from_str(&"1.2.3") matches { Err(_) };
    assert f64::from_str(&"e5") matches { Err(_) };
    assert f64::from_str(&"1e") matches { Err(_) };
    assert f64::from_str(&"infi") matches { Err(_) };
    assert f64::from_str(&"nana") matches { Err(_) };
}

test "f32::from_str basic" {
    assert f32::from_str(&"3.14") matches { Ok(v) && v == 3.14 };
    assert f32::from_str(&"-42") matches { Ok(v) && v == -42.0 };
    assert f32::from_str(&"inf") matches { Ok(v) && v == f32::INFINITY };
    assert f32::from_str(&"") matches { Err(e) && e.kind() == FloatErrorKind::Empty };
    assert f32::from_str(&".5") matches { Err(e) && e.kind() == FloatErrorKind::Invalid };
}

test "i32::from_str basic" {
    assert i32::from_str(&"0") matches { Ok(0) };
    assert i32::from_str(&"42") matches { Ok(42) };
    assert i32::from_str(&"+42") matches { Ok(42) };
    assert i32::from_str(&"-42") matches { Ok(-42) };
    assert i32::from_str(&"2147483647") matches { Ok(v) && v == i32::MAX };
    assert i32::from_str(&"-2147483648") matches { Ok(v) && v == i32::MIN };
}

test "i32::from_str errors" {
    assert i32::from_str(&"") matches { Err(e) && e.kind() == IntErrorKind::Empty };
    assert i32::from_str(&"+") matches { Err(e) && e.kind() == IntErrorKind::InvalidDigit };
    assert i32::from_str(&"-") matches { Err(e) && e.kind() == IntErrorKind::InvalidDigit };
    assert i32::from_str(&"abc") matches { Err(e) && e.kind() == IntErrorKind::InvalidDigit };
    assert i32::from_str(&"12x") matches { Err(e) && e.kind() == IntErrorKind::InvalidDigit };
    assert i32::from_str(&"2147483648") matches { Err(e) && e.kind() == IntErrorKind::PosOverflow };
    assert i32::from_str(&"-2147483649") matches { Err(e) && e.kind() == IntErrorKind::NegOverflow };
}

test "u32::from_str basic" {
    assert u32::from_str(&"0") matches { Ok(0) };
    assert u32::from_str(&"42") matches { Ok(42) };
    assert u32::from_str(&"+42") matches { Ok(42) };
    assert u32::from_str(&"4294967295") matches { Ok(v) && v == u32::MAX };
}

test "u32::from_str errors" {
    assert u32::from_str(&"") matches { Err(e) && e.kind() == IntErrorKind::Empty };
    assert u32::from_str(&"-0") matches { Err(e) && e.kind() == IntErrorKind::InvalidDigit };
    assert u32::from_str(&"-1") matches { Err(e) && e.kind() == IntErrorKind::InvalidDigit };
    assert u32::from_str(&"4294967296") matches { Err(e) && e.kind() == IntErrorKind::PosOverflow };
}

test "i32::from_str_radix" {
    assert i32::from_str_radix("1010", 2) matches { Ok(10) };
    assert i32::from_str_radix("777", 8) matches { Ok(v) && v == 511 };
    assert i32::from_str_radix("ff", 16) matches { Ok(255) };
    assert i32::from_str_radix("FF", 16) matches { Ok(255) };
    assert i32::from_str_radix("-ff", 16) matches { Ok(-255) };
    assert i32::from_str_radix("z", 36) matches { Ok(35) };
    assert i32::from_str_radix("2", 2) matches { Err(e) && e.kind() == IntErrorKind::InvalidDigit };
    assert i32::from_str_radix("g", 16) matches { Err(e) && e.kind() == IntErrorKind::InvalidDigit };
}

test "u32::from_str_hex" {
    assert u32::from_str_hex("0") matches { Ok(0) };
    assert u32::from_str_hex("ff") matches { Ok(255) };
    assert u32::from_str_hex("FF") matches { Ok(255) };
    assert u32::from_str_hex("DeadBeef") matches { Ok(v) && v == 3735928559 };
    assert u32::from_str_hex("ffffffff") matches { Ok(v) && v == u32::MAX };
    assert u32::from_str_hex("") matches { Err(e) && e.kind() == IntErrorKind::Empty };
    assert u32::from_str_hex("zz") matches { Err(e) && e.kind() == IntErrorKind::InvalidDigit };
    assert u32::from_str_hex("100000000") matches { Err(e) && e.kind() == IntErrorKind::PosOverflow };
}

test "i64::from_str bounds" {
    assert i64::from_str(&"9223372036854775807") matches { Ok(v) && v == i64::MAX };
    assert i64::from_str(&"-9223372036854775808") matches { Ok(v) && v == i64::MIN };
    assert i64::from_str(&"9223372036854775808") matches { Err(e) && e.kind() == IntErrorKind::PosOverflow };
    assert i64::from_str(&"-9223372036854775809") matches { Err(e) && e.kind() == IntErrorKind::NegOverflow };
}

test "u64::from_str bounds" {
    assert u64::from_str(&"18446744073709551615") matches { Ok(v) && v == u64::MAX };
    assert u64::from_str(&"18446744073709551616") matches { Err(e) && e.kind() == IntErrorKind::PosOverflow };
}

test "u64::from_str_hex" {
    assert u64::from_str_hex("ffffffffffffffff") matches { Ok(v) && v == u64::MAX };
    assert u64::from_str_hex("10000000000000000") matches { Err(e) && e.kind() == IntErrorKind::PosOverflow };
}

test "i8 u8 i16 u16 from_str bounds" {
    assert i8::from_str(&"127") matches { Ok(127) };
    assert i8::from_str(&"-128") matches { Ok(-128) };
    assert i8::from_str(&"128") matches { Err(e) && e.kind() == IntErrorKind::PosOverflow };
    assert i8::from_str(&"-129") matches { Err(e) && e.kind() == IntErrorKind::NegOverflow };

    assert u8::from_str(&"255") matches { Ok(255) };
    assert u8::from_str(&"256") matches { Err(e) && e.kind() == IntErrorKind::PosOverflow };

    assert i16::from_str(&"32767") matches { Ok(32767) };
    assert i16::from_str(&"-32768") matches { Ok(-32768) };
    assert i16::from_str(&"32768") matches { Err(e) && e.kind() == IntErrorKind::PosOverflow };

    assert u16::from_str(&"65535") matches { Ok(65535) };
    assert u16::from_str(&"65536") matches { Err(e) && e.kind() == IntErrorKind::PosOverflow };
}

test "i8 from_str_hex common cases" {
    assert u8::from_str_hex("ff") matches { Ok(255) };
    assert u8::from_str_hex("100") matches { Err(e) && e.kind() == IntErrorKind::PosOverflow };
    assert i16::from_str_hex("7fff") matches { Ok(32767) };
    assert i16::from_str_hex("8000") matches { Err(e) && e.kind() == IntErrorKind::PosOverflow };
    assert i16::from_str_hex("-8000") matches { Ok(-32768) };
}

test "f64 wasm instruction math" {
    assert f64::abs(-3.5) == 3.5;
    assert f64::abs(2.0) == 2.0;
    assert f64::ceil(2.3) == 3.0;
    assert f64::ceil(-2.3) == -2.0;
    assert f64::floor(2.7) == 2.0;
    assert f64::floor(-2.7) == -3.0;
    assert f64::trunc(2.9) == 2.0;
    assert f64::trunc(-2.9) == -2.0;
    assert f64::round(2.5) == 2.0;
    assert f64::round(3.5) == 4.0;
    assert f64::sqrt(4.0) == 2.0;
    assert f64::min(3.0, 5.0) == 3.0;
    assert f64::max(3.0, 5.0) == 5.0;
    assert f64::copysign(5.0, -1.0) == -5.0;
    assert f64::copysign(-5.0, 1.0) == 5.0;
}

test "f64 trigonometric" {
    assert f64::sin(0.0) == 0.0;
    assert 0.99 < f64::sin(f64::PI / 2.0) < 1.01;

    assert f64::cos(0.0) == 1.0;
    assert -0.01 < f64::cos(f64::PI / 2.0) < 0.01;

    assert f64::tan(0.0) == 0.0;

    assert f64::asin(0.0) == 0.0;
    assert 1.57 < f64::asin(1.0) < 1.58;

    assert f64::acos(1.0) == 0.0;
    assert 1.57 < f64::acos(0.0) < 1.58;

    assert f64::atan(0.0) == 0.0;
    assert 0.78 < f64::atan(1.0) < 0.79;

    assert 0.78 < f64::atan2(1.0, 1.0) < 0.79;
}

test "f64 hyperbolic" {
    assert f64::sinh(0.0) == 0.0;
    assert f64::cosh(0.0) == 1.0;
    assert f64::tanh(0.0) == 0.0;
    assert f64::asinh(0.0) == 0.0;
    assert f64::acosh(1.0) == 0.0;
    assert f64::atanh(0.0) == 0.0;
}

test "f64 exponential and logarithmic" {
    assert f64::exp(0.0) == 1.0;
    assert 2.71 < f64::exp(1.0) < 2.72;

    assert f64::exp2(0.0) == 1.0;
    assert f64::exp2(3.0) == 8.0;

    assert f64::expm1(0.0) == 0.0;

    assert f64::ln(1.0) == 0.0;
    assert 0.99 < f64::ln(f64::E) < 1.01;

    assert f64::log2(1.0) == 0.0;
    assert f64::log2(8.0) == 3.0;

    assert f64::log10(1.0) == 0.0;
    assert f64::log10(100.0) == 2.0;

    assert f64::ln1p(0.0) == 0.0;
}

test "f64 power functions" {
    assert f64::pow(2.0, 3.0) == 8.0;
    assert f64::cbrt(8.0) == 2.0;
    assert f64::cbrt(27.0) == 3.0;
    assert f64::hypot(3.0, 4.0) == 5.0;
    assert f64::fmod(7.0, 3.0) == 1.0;
}

test "f32 wasm instruction math" {
    assert f32::abs(-3.5) == 3.5;
    assert f32::abs(2.0) == 2.0;
    assert f32::ceil(2.3) == 3.0;
    assert f32::ceil(-2.3) == -2.0;
    assert f32::floor(2.7) == 2.0;
    assert f32::floor(-2.7) == -3.0;
    assert f32::trunc(2.9) == 2.0;
    assert f32::trunc(-2.9) == -2.0;
    assert f32::round(2.5) == 2.0;
    assert f32::round(3.5) == 4.0;
    assert f32::sqrt(4.0) == 2.0;
    assert f32::min(3.0, 5.0) == 3.0;
    assert f32::max(3.0, 5.0) == 5.0;
    assert f32::copysign(5.0, -1.0) == -5.0;
    assert f32::copysign(-5.0, 1.0) == 5.0;
}

test "f32 trigonometric" {
    assert f32::sin(0.0) == 0.0;
    assert f32::cos(0.0) == 1.0;
    assert f32::tan(0.0) == 0.0;
    assert f32::acos(1.0) == 0.0;
    assert f32::atan(0.0) == 0.0;
}

test "f32 hyperbolic" {
    assert f32::sinh(0.0) == 0.0;
    assert f32::cosh(0.0) == 1.0;
    assert f32::tanh(0.0) == 0.0;
    assert f32::asinh(0.0) == 0.0;
    assert f32::acosh(1.0) == 0.0;
    assert f32::atanh(0.0) == 0.0;
}

test "f32 exponential and logarithmic" {
    assert f32::exp(0.0) == 1.0;
    assert f32::exp2(3.0) == 8.0;
    assert f32::expm1(0.0) == 0.0;
    assert f32::ln(1.0) == 0.0;
    assert f32::log2(8.0) == 3.0;
    assert f32::log10(1000.0) == 3.0;
    assert f32::ln1p(0.0) == 0.0;
}

test "f32 power functions" {
    assert f32::pow(2.0, 10.0) == 1024.0;
    assert f32::pow(3.0, 3.0) == 27.0;
    assert f32::cbrt(27.0) == 3.0;
    assert f32::hypot(3.0, 4.0) == 5.0;
    assert f32::fmod(7.0, 3.0) == 1.0;
}

test "f64 constants" {
    assert 3.14159 < f64::PI < 3.14160;
    assert f64::TAU == f64::PI * 2.0;
    assert 2.71828 < f64::E < 2.71829;
    assert f64::FRAC_PI_2 == f64::PI / 2.0;
    assert f64::FRAC_PI_4 == f64::PI / 4.0;
}

test "f32 constants" {
    assert 3.14 < f32::PI < 3.15;
    assert f32::TAU == f32::PI * 2.0;
    assert 2.71 < f32::E < 2.72;
    assert f32::FRAC_PI_2 == f32::PI / 2.0;
    assert f32::FRAC_PI_4 == f32::PI / 4.0;
}

test "f64.is_nan and f64.is_finite" {
    assert f64::NAN.is_nan();
    assert !0.0.is_nan();
    assert !f64::INFINITY.is_nan();
    assert !f64::NEG_INFINITY.is_nan();
    assert (0.0 / 0.0).is_nan();

    assert 1.0.is_finite();
    assert 0.0.is_finite();
    assert (-42.5).is_finite();
    assert !f64::INFINITY.is_finite();
    assert !f64::NEG_INFINITY.is_finite();
    assert !f64::NAN.is_finite();
}

test "f32.is_nan and f32.is_finite" {
    assert f32::NAN.is_nan();
    assert !(0.0 as f32).is_nan();
    assert !f32::INFINITY.is_nan();

    assert (1.0 as f32).is_finite();
    assert !f32::INFINITY.is_finite();
    assert !f32::NAN.is_finite();
}

test "f64::NAN and f32::NAN" {
    // NAN != NAN (IEEE 754)
    let nan = f64::NAN;
    assert !(nan == nan);
    assert !(nan < 0.0);
    assert !(nan > 0.0);

    let nan32 = f32::NAN;
    assert !(nan32 == nan32);
}

test "i32::clz" {
    assert i32::clz(0) == 32;
    assert i32::clz(1) == 31;
    assert i32::clz(0xFF) == 24;
    assert i32::clz(-1) == 0;
    assert i32::clz(0x80000000 as i32) == 0;
    assert i32::clz(0x00010000) == 15;
}

test "i32::ctz" {
    assert i32::ctz(1) == 0;
    assert i32::ctz(8) == 3;
    assert i32::ctz(0) == 32;
    assert i32::ctz(0x80000000 as i32) == 31;
}

test "i32::popcnt" {
    assert i32::popcnt(0) == 0;
    assert i32::popcnt(1) == 1;
    assert i32::popcnt(0xFF) == 8;
    assert i32::popcnt(-1) == 32;
}

test "i64::clz" {
    assert i64::clz(0) == 64;
    assert i64::clz(1) == 63;
    assert i64::clz(0x8000000000000000 as i64) == 0;
}

test "i64::ctz" {
    assert i64::ctz(1) == 0;
    assert i64::ctz(0) == 64;
    assert i64::ctz(0x8000000000000000 as i64) == 63;
}

test "i64::popcnt" {
    assert i64::popcnt(0) == 0;
    assert i64::popcnt(1) == 1;
    assert i64::popcnt(-1) == 64;
    assert i64::popcnt(0xFF) == 8;
}

test "f64::to_bits and f64::from_bits" {
    let pi = 3.141592653589793;
    let pi_bits = pi.to_bits();
    assert pi_bits == 4614256656552045848;

    let back_to_pi = f64::from_bits(pi_bits);
    assert back_to_pi == 3.141592653589793;

    let zero_bits = 0.0.to_bits();
    assert zero_bits == 0;

    let neg_zero_bits = (-0.0).to_bits();
    assert neg_zero_bits == -9223372036854775808;
}

test "f32::to_bits and f32::from_bits" {
    let pi32 = 3.14159265 as f32;
    let pi32_bits = pi32.to_bits();
    assert pi32_bits == 1078530011;

    let back_to_pi32 = f32::from_bits(pi32_bits);
    assert back_to_pi32 == pi32;

    let zero32_bits = (0.0 as f32).to_bits();
    assert zero32_bits == 0;
}

test "char::eq_ignore_ascii_case same case" {
    assert 'A'.eq_ignore_ascii_case(&'A');
    assert 'a'.eq_ignore_ascii_case(&'a');
    assert 'z'.eq_ignore_ascii_case(&'z');
}

test "char::eq_ignore_ascii_case different case" {
    assert 'A'.eq_ignore_ascii_case(&'a');
    assert 'a'.eq_ignore_ascii_case(&'A');
    assert 'Z'.eq_ignore_ascii_case(&'z');
    assert 'z'.eq_ignore_ascii_case(&'Z');
}

test "char::eq_ignore_ascii_case non-alpha exact match" {
    assert '0'.eq_ignore_ascii_case(&'0');
    assert !'0'.eq_ignore_ascii_case(&'1');
    assert ' '.eq_ignore_ascii_case(&' ');
    assert !' '.eq_ignore_ascii_case(&'!');
}

test "char::eq_ignore_ascii_case different letters" {
    assert !'A'.eq_ignore_ascii_case(&'B');
    assert !'a'.eq_ignore_ascii_case(&'b');
    assert !'A'.eq_ignore_ascii_case(&'z');
}

test "char::eq_ignore_ascii_case non-alpha with same bit pattern" {
    // '@' (0x40) | 0x20 == '`' (0x60), but neither is a letter
    assert !'@'.eq_ignore_ascii_case(&'`');
    // '[' (0x5B) | 0x20 == '{' (0x7B), but neither is a letter
    assert !'['.eq_ignore_ascii_case(&'{');
}
