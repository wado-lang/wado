test "push to empty array" {
    let arr: List<i32> = [];
    arr.push(10);
    arr.push(20);
    arr.push(30);
    assert arr.len() == 3;
    assert arr[0] == 10;
    assert arr[1] == 20;
    assert arr[2] == 30;
}

test "push triggers growth" {
    let arr: List<i32> = [];
    arr.push(10);
    arr.push(20);
    arr.push(30);
    arr.push(40);
    arr.push(50);  // should trigger resize (capacity 4 -> 8)
    arr.push(60);
    assert arr.len() == 6;
    assert arr[3] == 40;
    assert arr[4] == 50;
    assert arr[5] == 60;
}

test "filled creates array with repeated value" {
    let arr = List::filled(5, 42);
    assert arr.len() == 5;
    assert arr[0] == 42;
    assert arr[4] == 42;
}

test "filled with booleans" {
    let arr = List::filled(3, true);
    assert arr.len() == 3;
    assert arr[0];
    assert arr[1];
    assert arr[2];
}

test "filled with zero length" {
    let arr = List::filled(0, 99);
    assert arr.len() == 0;
    assert arr.is_empty();
}

test "is_empty on empty array" {
    let arr: List<i32> = [];
    assert arr.is_empty();
}

test "is_empty on nonempty array" {
    let arr: List<i32> = [1, 2, 3];
    assert !arr.is_empty();
}

test "is_empty after push" {
    let arr: List<i32> = [];
    assert arr.is_empty();
    arr.push(1);
    assert !arr.is_empty();
}

test "get returns Some for in-bounds" {
    let arr: List<i32> = [10, 20, 30];
    assert arr.get(0) matches { Some(v) && v == 10 };
    assert arr.get(2) matches { Some(v) && v == 30 };
}

test "get returns None for out-of-bounds" {
    let arr: List<i32> = [10, 20, 30];
    assert arr.get(3) matches { None };
    assert arr.get(-1) matches { None };
}

test "get on empty array" {
    let arr: List<i32> = [];
    assert arr.get(0) matches { None };
}

test "basic slice" {
    let arr: List<i32> = [10, 20, 30, 40, 50];
    let s = arr.slice(1, 4);
    assert s.len() == 3;
    assert s[0] == 20;
    assert s[1] == 30;
    assert s[2] == 40;
}

test "slice get with bounds check" {
    let arr: List<i32> = [10, 20, 30, 40, 50];
    let s = arr.slice(1, 4);
    assert s.get(0) matches { Some(v) && v == 20 };
    assert s.get(3) matches { None };
    assert s.get(-1) matches { None };
}

test "sub-slice" {
    let arr: List<i32> = [10, 20, 30, 40, 50];
    let s = arr.slice(1, 4);
    let ss = s.slice(1, 2);
    assert ss.len() == 1;
    assert ss[0] == 30;
}

test "empty slice" {
    let arr: List<i32> = [10, 20, 30, 40, 50];
    let empty = arr.slice(3, 3);
    assert empty.len() == 0;
    assert empty.is_empty();
}

test "slice clamping" {
    let arr: List<i32> = [10, 20, 30, 40, 50];
    let clamped = arr.slice(0, 100);
    assert clamped.len() == 5;
    let clamped2 = arr.slice(-5, 3);
    assert clamped2.len() == 3;
}

test "slice to_array" {
    let arr: List<i32> = [10, 20, 30, 40, 50];
    let s = arr.slice(1, 4);
    let copied = s.to_array();
    assert copied.len() == 3;
    assert copied[0] == 20;
    assert copied[2] == 40;
}

test "slice iteration" {
    let arr: List<i32> = [10, 20, 30, 40, 50];
    let s = arr.slice(1, 4);
    let mut sum = 0;
    for let x of s {
        sum += x;
    }
    assert sum == 90;
}

test "slice iterator combinators" {
    let arr: List<i32> = [10, 20, 30, 40, 50];
    let s = arr.slice(1, 4);

    let doubled = s.iter().map(|x: i32| x * 2).collect();
    assert doubled.len() == 3;
    assert doubled[0] == 40;
    assert doubled[1] == 60;
    assert doubled[2] == 80;

    let total = s.iter().fold(0, |acc: i32, x: i32| acc + x);
    assert total == 90;
}

test "sort ascending" {
    let mut arr: List<i32> = [42, 17, 99, 3, 55, 1];
    arr.sort();
    assert arr[0] == 1;
    assert arr[1] == 3;
    assert arr[2] == 17;
    assert arr[3] == 42;
    assert arr[4] == 55;
    assert arr[5] == 99;
}

test "sort_by ascending" {
    let mut a: List<i32> = [5, 3, 8, 1, 9, 2, 7, 4, 6];
    a.sort_by(|x: &i32, y: &i32| {
        if *x < *y {
            return Ordering::Less;
        }
        if *x > *y {
            return Ordering::Greater;
        }
        return Ordering::Equal;
    });
    assert a[0] == 1;
    assert a[8] == 9;
}

test "sort_by descending" {
    let mut a: List<i32> = [5, 3, 8, 1, 9, 2, 7, 4, 6];
    a.sort_by(|x: &i32, y: &i32| {
        if *x > *y {
            return Ordering::Less;
        }
        if *x < *y {
            return Ordering::Greater;
        }
        return Ordering::Equal;
    });
    assert a[0] == 9;
    assert a[8] == 1;
}

test "sorted returns new array" {
    let orig: List<i32> = [7, 2, 5, 1, 8, 3];
    let sorted = orig.sorted();
    // original unchanged
    assert orig[0] == 7;
    assert orig[1] == 2;
    // sorted array is in order
    assert sorted[0] == 1;
    assert sorted[1] == 2;
    assert sorted[2] == 3;
    assert sorted[3] == 5;
    assert sorted[4] == 7;
    assert sorted[5] == 8;
}

test "sorted_by returns new array" {
    let c: List<i32> = [10, 30, 20, 50, 40];
    let d = c.sorted_by(|x: &i32, y: &i32| {
        if *x < *y {
            return Ordering::Less;
        }
        if *x > *y {
            return Ordering::Greater;
        }
        return Ordering::Equal;
    });
    // original unchanged
    assert c[0] == 10;
    assert c[1] == 30;
    // sorted result
    assert d[0] == 10;
    assert d[1] == 20;
    assert d[2] == 30;
    assert d[3] == 40;
    assert d[4] == 50;
}

test "sort empty array" {
    let mut empty: List<i32> = [];
    empty.sort();
    assert empty.len() == 0;
}

test "sort single element" {
    let mut single: List<i32> = [42];
    single.sort();
    assert single[0] == 42;
}

test "sort two elements" {
    let mut two: List<i32> = [2, 1];
    two.sort();
    assert two[0] == 1;
    assert two[1] == 2;
}

struct ListTestPoint {
    x: i32,
    y: i32,
}

test "inspect empty array" {
    let arr: List<i32> = [];
    assert `{arr:?}` == "[]";
}

test "inspect array" {
    let arr: List<i32> = [1, 2, 3];
    assert `{arr:?}` == "[1, 2, 3]";
}

test "pretty-print empty array" {
    let arr: List<i32> = [];
    assert `{arr:#?}` == "[]";
}

test "pretty-print array" {
    let arr: List<i32> = [1, 2, 3];
    assert `{arr:#?}` == "[
  1,
  2,
  3,
]";
}

test "pretty-print nested structs" {
    let points: List<ListTestPoint> = [
        ListTestPoint { x: 1, y: 2 },
        ListTestPoint { x: 3, y: 4 },
    ] as List<ListTestPoint>;
    assert `{points:#?}` == "[
  ListTestPoint {
    x: 1,
    y: 2,
  },
  ListTestPoint {
    x: 3,
    y: 4,
  },
]";
}

test "sort stability" {
    // Sort by absolute value; -1 and 1 should keep relative order
    let mut g: List<i32> = [3, -1, -3, 2, -2, 1];
    g.sort_by(|a: &i32, b: &i32| {
        let va = if *a < 0 { 0 - *a } else { *a };
        let vb = if *b < 0 { 0 - *b } else { *b };
        if va < vb {
            return Ordering::Less;
        }
        if va > vb {
            return Ordering::Greater;
        }
        return Ordering::Equal;
    });
    // -1 comes before 1 in original, so after stable sort by abs value:
    assert g[0] == -1;
    assert g[1] == 1;
    assert g[2] == 2;
    assert g[3] == -2;
    assert g[4] == 3;
    assert g[5] == -3;
}

test "pop from non-empty array" {
    let mut arr: List<i32> = [10, 20, 30];
    let v = arr.pop();
    assert v == Option::Some(30);
    assert arr.len() == 2;
    let v2 = arr.pop();
    assert v2 == Option::Some(20);
    assert arr.len() == 1;
}

test "pop from empty array" {
    let mut arr: List<i32> = [];
    let v = arr.pop();
    assert v matches { None };
    assert arr.len() == 0;
}

test "last on non-empty array" {
    let arr: List<i32> = [10, 20, 30];
    let v = arr.last();
    assert v == Option::Some(30);
    assert arr.len() == 3;
}

test "last on empty array" {
    let arr: List<i32> = [];
    let v = arr.last();
    assert v matches { None };
}

test "truncate" {
    let mut arr: List<i32> = [10, 20, 30, 40, 50];
    arr.truncate(3);
    assert arr.len() == 3;
    assert arr[0] == 10;
    assert arr[2] == 30;
}

test "truncate larger than len is no-op" {
    let mut arr: List<i32> = [1, 2];
    arr.truncate(10);
    assert arr.len() == 2;
}

test "push to empty array" {
    let arr: List<i32> = [];
    arr.push(10);
    arr.push(20);
    assert arr.len() == 2;
    assert arr[0] == 10;
    assert arr[1] == 20;
}

test "first on non-empty array" {
    let arr: List<i32> = [10, 20, 30];
    assert arr.first() == Option::Some(10);
}

test "first on empty array" {
    let arr: List<i32> = [];
    assert arr.first() matches { None };
}

test "clear" {
    let mut arr: List<i32> = [1, 2, 3];
    arr.clear();
    assert arr.len() == 0;
    assert arr.is_empty();
}

test "capacity and reserve" {
    let mut arr: List<i32> = List::with_capacity(2);
    assert arr.capacity() >= 2;
    arr.push(1);
    arr.push(2);
    arr.reserve(10);
    assert arr.capacity() >= 12;
    assert arr.len() == 2;
    assert arr[0] == 1;
}

test "shrink_to_fit" {
    let mut arr: List<i32> = List::with_capacity(100);
    arr.push(1);
    arr.push(2);
    arr.shrink_to_fit();
    assert arr.capacity() == 2;
    assert arr.len() == 2;
    assert arr[0] == 1;
    assert arr[1] == 2;
}

test "insert at beginning" {
    let mut arr: List<i32> = [20, 30];
    arr.insert(0, 10);
    assert arr.len() == 3;
    assert arr[0] == 10;
    assert arr[1] == 20;
    assert arr[2] == 30;
}

test "insert at middle" {
    let mut arr: List<i32> = [10, 30];
    arr.insert(1, 20);
    assert arr.len() == 3;
    assert arr[0] == 10;
    assert arr[1] == 20;
    assert arr[2] == 30;
}

test "insert at end" {
    let mut arr: List<i32> = [10, 20];
    arr.insert(2, 30);
    assert arr.len() == 3;
    assert arr[2] == 30;
}

test "remove from beginning" {
    let mut arr: List<i32> = [10, 20, 30];
    let v = arr.remove(0);
    assert v == 10;
    assert arr.len() == 2;
    assert arr[0] == 20;
    assert arr[1] == 30;
}

test "remove from middle" {
    let mut arr: List<i32> = [10, 20, 30];
    let v = arr.remove(1);
    assert v == 20;
    assert arr.len() == 2;
    assert arr[0] == 10;
    assert arr[1] == 30;
}

test "swap" {
    let mut arr: List<i32> = [10, 20, 30];
    arr.swap(0, 2);
    assert arr[0] == 30;
    assert arr[2] == 10;
}

test "reverse" {
    let mut arr: List<i32> = [1, 2, 3, 4, 5];
    arr.reverse();
    assert arr[0] == 5;
    assert arr[1] == 4;
    assert arr[2] == 3;
    assert arr[3] == 2;
    assert arr[4] == 1;
}

test "reverse empty and single" {
    let mut empty: List<i32> = [];
    empty.reverse();
    assert empty.len() == 0;

    let mut single: List<i32> = [42];
    single.reverse();
    assert single[0] == 42;
}

test "extend" {
    let mut arr: List<i32> = [1, 2];
    let other: List<i32> = [3, 4, 5];
    arr.extend(&other);
    assert arr.len() == 5;
    assert arr[2] == 3;
    assert arr[4] == 5;
}

test "contains" {
    let arr: List<i32> = [10, 20, 30];
    assert arr.contains(&20);
    assert !arr.contains(&99);
}

test "contains empty" {
    let arr: List<i32> = [];
    assert !arr.contains(&1);
}

test "repeat" {
    let arr: List<i32> = [1, 2];
    let repeated = arr.repeat(3);
    assert repeated.len() == 6;
    assert repeated[0] == 1;
    assert repeated[1] == 2;
    assert repeated[2] == 1;
    assert repeated[3] == 2;
    assert repeated[4] == 1;
    assert repeated[5] == 2;
}

test "repeat zero" {
    let arr: List<i32> = [1, 2, 3];
    let empty = arr.repeat(0);
    assert empty.len() == 0;
}

test "join" {
    let arr: List<i32> = [1, 2, 3];
    assert arr.join(", ") == "1, 2, 3";
}

test "join single element" {
    let arr: List<i32> = [42];
    assert arr.join(", ") == "42";
}

test "join empty" {
    let arr: List<i32> = [];
    assert arr.join(", ") == "";
}

test "join strings" {
    let arr: List<String> = ["hello", "world"];
    assert arr.join(" ") == "hello world";
}

test "windows" {
    let arr: List<i32> = [1, 2, 3, 4, 5];
    let mut wins = arr.windows(3);
    let w0 = wins.next();
    assert w0 matches { Some(_) };
    if let Some(s) = w0 {
        assert s.len() == 3;
        assert s[0] == 1;
        assert s[1] == 2;
        assert s[2] == 3;
    }
    let w1 = wins.next();
    if let Some(s) = w1 {
        assert s[0] == 2;
        assert s[2] == 4;
    }
    let w2 = wins.next();
    if let Some(s) = w2 {
        assert s[0] == 3;
        assert s[2] == 5;
    }
    assert wins.next() matches { None };
}

test "chunks" {
    let arr: List<i32> = [1, 2, 3, 4, 5];
    let mut chs = arr.chunks(2);
    let c0 = chs.next();
    if let Some(s) = c0 {
        assert s.len() == 2;
        assert s[0] == 1;
        assert s[1] == 2;
    }
    let c1 = chs.next();
    if let Some(s) = c1 {
        assert s.len() == 2;
        assert s[0] == 3;
        assert s[1] == 4;
    }
    let c2 = chs.next();
    if let Some(s) = c2 {
        assert s.len() == 1;
        assert s[0] == 5;
    }
    assert chs.next() matches { None };
}

test "List<u8> to_hex renders lowercase hex" {
    let bytes: List<u8> = [0x00, 0x0f, 0xa0, 0xff] as List<u8>;
    assert bytes.to_hex() == "000fa0ff";
}

test "List<u8> to_hex on empty list" {
    let bytes: List<u8> = [];
    assert bytes.to_hex() == "";
}
