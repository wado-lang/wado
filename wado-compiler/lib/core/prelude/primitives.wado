// Primitive Type Methods
//
// This module provides methods for primitive types (i32, i64, f32, f64, etc.)
// through impl blocks. These are automatically available for all primitive values.
//
// This module intentionally does NOT depend on core:internal to keep the
// dependency structure simple.

use {
    check_special, SpecialKind,
    short, short32, fixed_width, digits,
    format_decimal, format_exp,
    format_decimal_prec, format_exp_prec,
    parse_text,
} from "core:prelude/fpfmt.wado";

/// Copy bytes from linear memory to a new GC array (internal helper)
fn memory_to_gc_array(ptr: i32, len: i32) -> builtin::array<u8> {
    let arr = builtin::array_new::<u8>(len);
    for let mut i = 0; i < len; i += 1 {
        builtin::array_set_u8(arr, i, builtin::i32_load8_u(ptr + i) as u8);
    }
    return arr;
}

// These write formatted values directly to a Formatter's buffer,
// avoiding intermediate GC String allocations in the common case.

/// Count decimal digits of a non-negative i64 value.
fn count_digits_i64(val: i64) -> i32 {
    let zero: i64 = 0;
    if val == zero { return 1; }
    let ten: i64 = 10;
    let mut n: i32 = 0;
    for let mut t: i64 = val; t > zero; t = t / ten {
        n += 1;
    }
    return n;
}

/// Write `digit_count` decimal digits of `abs_val` backwards into `arr` starting at `offset`.
fn write_decimal_digits(arr: builtin::array<u8>, offset: i32, abs_val: i64, digit_count: i32) {
    let zero: i64 = 0;
    let ten: i64 = 10;
    let mut pos = offset + digit_count;
    if abs_val == zero {
        builtin::array_set_u8(arr, offset, '0' as u8);
    } else {
        for let mut temp: i64 = abs_val; temp > zero; temp = temp / ten {
            pos -= 1;
            builtin::array_set_u8(arr, pos, (('0' as i32) + ((temp % ten) as i32)) as u8);
        }
    }
}

/// Write `digit_count` digits of `abs_val` in given base backwards into `arr` at `offset`.
fn write_base_digits(arr: builtin::array<u8>, offset: i32, abs_val: i64, digit_count: i32, base: i32, upper: bool) {
    let zero: i64 = 0;
    let base64: i64 = base as i64;
    let mut pos = offset + digit_count;
    if abs_val == zero {
        builtin::array_set_u8(arr, offset, '0' as u8);
    } else {
        for let mut temp: i64 = abs_val; temp > zero; temp = temp / base64 {
            pos -= 1;
            let digit: i32 = (temp % base64) as i32;
            let ch = if digit < 10 {
                ('0' as i32) + digit
            } else if upper {
                ('A' as i32) + digit - 10
            } else {
                ('a' as i32) + digit - 10
            };
            builtin::array_set_u8(arr, pos, ch as u8);
        }
    }
}

/// Count digits of a non-negative i64 value in the given base.
fn count_digits_base(val: i64, base: i32) -> i32 {
    let zero: i64 = 0;
    if val == zero { return 1; }
    let base64: i64 = base as i64;
    let mut n: i32 = 0;
    for let mut t: i64 = val; t > zero; t = t / base64 {
        n += 1;
    }
    return n;
}

/// Count digits of a u64 value (as raw i64 bits) in the given power-of-2 base.
/// `bits_per_digit` is log2(base): 1 for binary, 3 for octal, 4 for hex.
fn count_digits_u64_base(val_i64: i64, bits_per_digit: i32) -> i32 {
    let zero: i64 = 0;
    if val_i64 == zero { return 1; }
    // Count leading zeros manually: find highest set bit
    let mut highest_bit: i32 = 0;
    // Check high 32 bits
    let high32: i64 = (val_i64 >> 32) & 0xFFFFFFFF;
    if high32 != zero {
        // Bit is somewhere in bits 32..63
        let mut b: i32 = 63;
        while b >= 32 {
            let one: i64 = 1;
            if (val_i64 >> (b as i64)) & one != zero {
                highest_bit = b;
                break;
            }
            b -= 1;
        }
    } else {
        // Bit is somewhere in bits 0..31
        let mut b: i32 = 31;
        while b >= 0 {
            let one: i64 = 1;
            if (val_i64 >> (b as i64)) & one != zero {
                highest_bit = b;
                break;
            }
            b -= 1;
        }
    }
    return (highest_bit / bits_per_digit) + 1;
}

/// Write digits of a u64 value (as raw i64 bits) in a power-of-2 base.
fn write_u64_base_digits(arr: builtin::array<u8>, offset: i32, val_i64: i64, digit_count: i32, bits_per_digit: i32, mask: i32, upper: bool) {
    let zero: i64 = 0;
    let mask64: i64 = mask as i64;
    let mut pos = offset + digit_count;
    if val_i64 == zero {
        builtin::array_set_u8(arr, offset, '0' as u8);
    } else {
        let mut temp: i64 = val_i64;
        while temp != zero {
            pos -= 1;
            let digit: i32 = (temp & mask64) as i32;
            let ch = if digit < 10 {
                ('0' as i32) + digit
            } else if upper {
                ('A' as i32) + digit - 10
            } else {
                ('a' as i32) + digit - 10
            };
            builtin::array_set_u8(arr, pos, ch as u8);
            // Unsigned right shift: use Wasm's i64.shr_u semantics
            // In Wado, >> on i64 is arithmetic shift. For unsigned shift we need:
            // (val as u64 >> bits) as i64
            let shift_u64: u64 = bits_per_digit as u64;
            temp = ((temp as u64) >> shift_u64) as i64;
        }
    }
}

/// Write a u64 value in the given power-of-2 base (2, 8, or 16) into the Formatter's output buffer.
fn fmt_u64_base(val_i64: i64, f: &mut Formatter, base: i32, upper: bool) {
    let bits_per_digit = if base == 2 { 1 } else if base == 8 { 3 } else { 4 };
    let mask = base - 1;
    let prefix = if f.alternate() {
        if base == 2 {
            "0b"
        } else if base == 8 {
            "0o"
        } else if upper {
            "0X"
        } else {
            "0x"
        }
    } else {
        ""
    };
    let digit_count = count_digits_u64_base(val_i64, bits_per_digit);
    let offset = f.prepare_int_write(false, prefix, digit_count);
    write_u64_base_digits(f.buf.internal_raw_bytes(), offset, val_i64, digit_count, bits_per_digit, mask, upper);
}

/// Write i32 as decimal directly into the Formatter's output buffer.
fn fmt_i32_decimal(value: i32, f: &mut Formatter) {
    let is_negative = value < 0;
    let abs_val: i64 = if is_negative { 0 - (value as i64) } else { value as i64 };
    let digit_count = count_digits_i64(abs_val);
    let offset = f.prepare_int_write(is_negative, "", digit_count);
    write_decimal_digits(f.buf.internal_raw_bytes(), offset, abs_val, digit_count);
}

/// Write u32 as decimal directly into the Formatter's output buffer.
fn fmt_u32_decimal(value: u32, f: &mut Formatter) {
    let val_i32 = (value) as i32;
    let abs_val: i64 = if val_i32 < 0 {
        (val_i32 as i64) + 4294967296
    } else {
        val_i32 as i64
    };
    let digit_count = count_digits_i64(abs_val);
    let offset = f.prepare_int_write(false, "", digit_count);
    write_decimal_digits(f.buf.internal_raw_bytes(), offset, abs_val, digit_count);
}

/// Write i64 as decimal directly into the Formatter's output buffer.
/// Handles i64::MIN specially.
fn fmt_i64_decimal(value: i64, f: &mut Formatter) {
    let zero_i64: i64 = 0;
    let is_negative = value < zero_i64;
    let i64_max: i64 = 9223372036854775807;
    let one_i64: i64 = 1;
    let i64_min: i64 = zero_i64 - i64_max - one_i64;
    let ten_i64: i64 = 10;

    if value == i64_min {
        // i64::MIN = -9223372036854775808: last digit '8', remaining 922337203685477580
        let remaining: i64 = 922337203685477580;
        let remaining_digits = count_digits_i64(remaining);
        let digit_count = remaining_digits + 1;
        let offset = f.prepare_int_write(true, "", digit_count);
        let repr = f.buf.internal_raw_bytes();
        // Write the remaining digits, then the last '8'
        write_decimal_digits(repr, offset, remaining, remaining_digits);
        builtin::array_set_u8(repr, offset + remaining_digits, '8' as u8);
    } else {
        let abs_val: i64 = if is_negative { zero_i64 - value } else { value };
        let digit_count = count_digits_i64(abs_val);
        let offset = f.prepare_int_write(is_negative, "", digit_count);
        write_decimal_digits(f.buf.internal_raw_bytes(), offset, abs_val, digit_count);
    }
}

/// Write u64 as decimal directly into the Formatter's output buffer.
/// Uses special unsigned division for values > i64::MAX.
fn fmt_u64_decimal(value: u64, f: &mut Formatter) {
    let val_i64 = (value) as i64;
    let zero: i64 = 0;
    let ten: i64 = 10;

    if val_i64 == zero {
        let offset = f.prepare_int_write(false, "", 1);
        builtin::array_set_u8(f.buf.internal_raw_bytes(), offset, '0' as u8);
        return;
    }

    // Count digits using unsigned division
    let mut digit_count: i32 = 0;
    let offset_div: i64 = 1844674407370955161;
    let mut temp: i64 = val_i64;
    while temp != zero {
        digit_count += 1;
        if temp >= zero {
            temp = temp / ten;
        } else {
            let signed_rem: i64 = temp % ten;
            let rem_adjusted: i64 = signed_rem + 6;
            let signed_quot: i64 = temp / ten;
            let mut carry: i64 = 0;
            if rem_adjusted < zero {
                carry = 0 - 1;
            }
            temp = signed_quot + offset_div + carry;
        }
    }

    let offset = f.prepare_int_write(false, "", digit_count);
    let repr = f.buf.internal_raw_bytes();

    // Write digits using unsigned division (backwards)
    let mut pos = offset + digit_count;
    temp = val_i64;
    while temp != zero {
        pos -= 1;
        let mut digit: i32 = 0;
        if temp >= zero {
            digit = (temp % ten) as i32;
            temp = temp / ten;
        } else {
            let signed_rem: i64 = temp % ten;
            let rem_adjusted: i64 = signed_rem + 6;
            if rem_adjusted >= zero {
                digit = rem_adjusted as i32;
            } else {
                digit = (rem_adjusted + ten) as i32;
            }
            let signed_quot: i64 = temp / ten;
            let mut carry: i64 = 0;
            if rem_adjusted < zero {
                carry = 0 - 1;
            }
            temp = signed_quot + offset_div + carry;
        }
        builtin::array_set_u8(repr, pos, (('0' as i32) + digit) as u8);
    }
}

/// Write f64 shortest representation to formatter (auto decimal/exponential).
fn fmt_f64(value: f64, f: &mut Formatter) {
    let [is_special, is_neg, kind] = check_special(value);
    if is_special {
        if kind matches { NaN } {
            f.pad("NaN");
        } else if kind matches { Inf } {
            f.pad(if is_neg { "-inf" } else { "inf" });
        } else {
            f.pad(if is_neg { "-0.0" } else { "0.0" });
        }
        return;
    }
    let abs_f = if is_neg { -value } else { value };
    let result = short(abs_f);
    let d = result.digits;
    let p = result.exponent;
    let nd = digits(d);
    let exp = p + nd - 1;
    let formatted = if exp < -4 || exp >= 16 {
        format_exp(d, p, nd, false)
    } else if p >= 0 {
        String::concat(format_decimal(d, p, nd), ".0")
    } else {
        format_decimal(d, p, nd)
    };
    if is_neg {
        f.pad(String::concat("-", formatted));
    } else {
        f.pad(formatted);
    }
}

/// Write f32 shortest representation to formatter.
/// Uses short32 which finds the shortest decimal that round-trips through f32.
fn fmt_f32(value: f32, f: &mut Formatter) {
    let f64_val = value as f64;
    let [is_special, is_neg, kind] = check_special(f64_val);
    if is_special {
        if kind matches { NaN } {
            f.pad("NaN");
        } else if kind matches { Inf } {
            f.pad(if is_neg { "-inf" } else { "inf" });
        } else {
            f.pad(if is_neg { "-0.0" } else { "0.0" });
        }
        return;
    }
    let abs_f = if is_neg { -value } else { value };
    let result = short32(abs_f);
    let d = result.digits;
    let p = result.exponent;
    let nd = digits(d);
    let exp = p + nd - 1;
    let formatted = if exp < -4 || exp >= 16 {
        format_exp(d, p, nd, false)
    } else if p >= 0 {
        String::concat(format_decimal(d, p, nd), ".0")
    } else {
        format_decimal(d, p, nd)
    };
    if is_neg {
        f.pad(String::concat("-", formatted));
    } else {
        f.pad(formatted);
    }
}

/// Write f64 with fixed-point precision to formatter.
fn fmt_f64_fixed(value: f64, precision: i32, f: &mut Formatter) {
    let [is_special, is_neg, kind] = check_special(value);
    if is_special {
        if kind matches { NaN } {
            f.pad("NaN");
        } else if kind matches { Inf } {
            f.pad(if is_neg { "-inf" } else { "inf" });
        } else {
            // Zero with precision
            let mut s = String::with_capacity(4 + precision);
            if is_neg { s.append("-"); }
            s.append("0");
            if precision > 0 {
                s.append(".");
                for let mut i = 0; i < precision; i += 1 {
                    s.append_char('0');
                }
            }
            f.pad(s);
        }
        return;
    }
    let abs_f = if is_neg { -value } else { value };
    let short_result = short(abs_f);
    let short_nd = digits(short_result.digits);
    let decimal_pos = short_nd + short_result.exponent;
    let int_digits = if decimal_pos > 0 { decimal_pos } else { 1 };
    let total_digits = int_digits + precision;
    let clamped = if total_digits > 18 { 18 } else if total_digits < 1 { 1 } else { total_digits };
    let result = fixed_width(abs_f, clamped);
    let d = result.digits;
    let p = result.exponent;
    let nd = digits(d);
    let formatted = format_decimal_prec(d as i64, p, nd, precision);
    if is_neg {
        f.pad(String::concat("-", formatted));
    } else {
        f.pad(formatted);
    }
}

/// Write f32 with fixed-point precision to formatter.
fn fmt_f32_fixed(value: f32, precision: i32, f: &mut Formatter) {
    fmt_f64_fixed(value as f64, precision, f);
}

/// Write f64 in exponential notation.
fn fmt_f64_exp(value: f64, precision: i32, upper: i32, f: &mut Formatter) {
    let upper_bool = upper != 0;
    let [is_special, is_neg, kind] = check_special(value);
    if is_special {
        if kind matches { NaN } {
            f.pad("NaN");
        } else if kind matches { Inf } {
            f.pad(if is_neg { "-inf" } else { "inf" });
        } else {
            // Zero in exponential
            let mut s = String::with_capacity(10 + precision);
            if is_neg { s.append("-"); }
            s.append("0");
            if precision > 0 {
                s.append(".");
                for let mut i = 0; i < precision; i += 1 {
                    s.append_char('0');
                }
            }
            s.append_char(if upper_bool { 'E' } else { 'e' });
            s.append_char('0');
            f.pad(s);
        }
        return;
    }
    let abs_f = if is_neg { -value } else { value };
    if precision >= 0 {
        let total_digits = precision + 1;
        let clamped = if total_digits > 18 { 18 } else if total_digits < 1 { 1 } else { total_digits };
        let result = fixed_width(abs_f, clamped);
        let d = result.digits;
        let p = result.exponent;
        let nd = digits(d);
        let formatted = format_exp_prec(d as i64, p, nd, precision, upper_bool);
        if is_neg {
            f.pad(String::concat("-", formatted));
        } else {
            f.pad(formatted);
        }
    } else {
        let result = short(abs_f);
        let d = result.digits;
        let p = result.exponent;
        let nd = digits(d);
        let formatted = format_exp(d, p, nd, upper_bool);
        if is_neg {
            f.pad(String::concat("-", formatted));
        } else {
            f.pad(formatted);
        }
    }
}

/// Write f32 in exponential notation.
fn fmt_f32_exp(value: f32, precision: i32, upper: i32, f: &mut Formatter) {
    fmt_f64_exp(value as f64, precision, upper, f);
}

/// Write an integer (as i64 absolute value) in the given base (2, 8, or 16)
/// directly into the Formatter's output buffer.
fn fmt_int_base(abs_val: i64, is_negative: bool, f: &mut Formatter, base: i32, upper: bool) {
    let prefix = if f.alternate() {
        if base == 2 {
            "0b"
        } else if base == 8 {
            "0o"
        } else if upper {
            "0X"
        } else {
            "0x"
        }
    } else {
        ""
    };
    let digit_count = count_digits_base(abs_val, base);
    let offset = f.prepare_int_write(is_negative, prefix, digit_count);
    write_base_digits(f.buf.internal_raw_bytes(), offset, abs_val, digit_count, base, upper);
}


impl bool {
    pub fn to_string(&self) -> String {
        let mut buf = String::with_capacity(5);
        let mut f = Formatter::new(&mut buf);
        f.pad(if *self { "true" } else { "false" });
        return buf;
    }
}

impl char {
    /// Converts a Unicode scalar value (u32) to a char.
    /// Returns null if the value is not a valid Unicode scalar value
    /// (i.e., surrogates 0xD800..0xDFFF or values > 0x10FFFF).
    pub fn from_u32(value: u32) -> Option<char> {
        if value > 0x10FFFF {
            return null;
        }
        if value >= 0xD800 && value <= 0xDFFF {
            return null;
        }
        return Option::<char>::Some(char::from_u32_unchecked(value));
    }

    /// Converts a signed integer to a char.
    /// Returns null if the value is negative or not a valid Unicode scalar value.
    pub fn from_i32(value: i32) -> Option<char> {
        if value < 0 {
            return null;
        }
        return char::from_u32(value as u32);
    }

    /// Converts a u32 to a char without validation.
    /// The caller must ensure the value is a valid Unicode scalar value
    /// (0..=0xD7FF or 0xE000..=0x10FFFF). Passing an invalid value
    /// results in an invalid char, which may cause incorrect behavior
    /// in string operations.
    pub fn from_u32_unchecked(value: u32) -> char {
        return builtin::i32_as_char(value as i32);
    }

    pub fn to_string(&self) -> String {
        let mut buf = String::with_capacity(4);
        buf.append_char(*self);
        return buf;
    }

    /// Returns true if the character is an ASCII whitespace character:
    /// SP (0x20), HT (0x09), LF (0x0A), VT (0x0B), FF (0x0C), CR (0x0D).
    /// Matches POSIX isspace() for the ASCII range.
    pub fn is_ascii_whitespace(&self) -> bool {
        return match *self {
            ' ' => true,
            '\t' => true,
            '\n' => true,
            '\r' => true,
            '\u{0B}' => true,
            '\u{0C}' => true,
            _ => false,
        };
    }

    /// Returns true if the character is a Unicode whitespace character.
    /// Covers ASCII whitespace plus Unicode general category Zs/Zl/Zp code points.
    pub fn is_whitespace(&self) -> bool {
        return match *self {
            ' ' => true,              // SP
            '\t' => true,             // HT
            '\n' => true,             // LF
            '\r' => true,             // CR
            '\u{0B}' => true,         // VT
            '\u{0C}' => true,         // FF
            '\u{85}' => true,         // NEXT LINE
            '\u{A0}' => true,         // NO-BREAK SPACE
            '\u{1680}' => true,       // OGHAM SPACE MARK
            '\u{2000}' => true,       // EN QUAD
            '\u{2001}' => true,       // EM QUAD
            '\u{2002}' => true,       // EN SPACE
            '\u{2003}' => true,       // EM SPACE
            '\u{2004}' => true,       // THREE-PER-EM SPACE
            '\u{2005}' => true,       // FOUR-PER-EM SPACE
            '\u{2006}' => true,       // SIX-PER-EM SPACE
            '\u{2007}' => true,       // FIGURE SPACE
            '\u{2008}' => true,       // PUNCTUATION SPACE
            '\u{2009}' => true,       // THIN SPACE
            '\u{200A}' => true,       // HAIR SPACE
            '\u{2028}' => true,       // LINE SEPARATOR
            '\u{2029}' => true,       // PARAGRAPH SEPARATOR
            '\u{202F}' => true,       // NARROW NO-BREAK SPACE
            '\u{205F}' => true,       // MEDIUM MATHEMATICAL SPACE
            '\u{3000}' => true,       // IDEOGRAPHIC SPACE
            _ => false,
        };
    }
}

impl i8 {
    pub const MAX: i8 = 127;
    pub const MIN: i8 = -128;

    pub fn max(a: i8, b: i8) -> i8 { return builtin::select::<i8>(a > b, a, b); }

    pub fn min(a: i8, b: i8) -> i8 { return builtin::select::<i8>(a < b, a, b); }

    pub fn to_string(&self) -> String {
        return ((*self) as i32).to_string();
    }
}

impl u8 {
    pub const MAX: u8 = 255;
    pub const MIN: u8 = 0;

    pub fn max(a: u8, b: u8) -> u8 { return builtin::select::<u8>(a > b, a, b); }

    pub fn min(a: u8, b: u8) -> u8 { return builtin::select::<u8>(a < b, a, b); }

    pub fn to_string(&self) -> String {
        return ((*self) as i32).to_string();
    }
}

impl i16 {
    pub const MAX: i16 = 32767;
    pub const MIN: i16 = -32768;

    pub fn max(a: i16, b: i16) -> i16 { return builtin::select::<i16>(a > b, a, b); }

    pub fn min(a: i16, b: i16) -> i16 { return builtin::select::<i16>(a < b, a, b); }

    pub fn to_string(&self) -> String {
        return ((*self) as i32).to_string();
    }
}

impl u16 {
    pub const MAX: u16 = 65535;
    pub const MIN: u16 = 0;

    pub fn max(a: u16, b: u16) -> u16 { return builtin::select::<u16>(a > b, a, b); }

    pub fn min(a: u16, b: u16) -> u16 { return builtin::select::<u16>(a < b, a, b); }

    pub fn to_string(&self) -> String {
        return ((*self) as i32).to_string();
    }
}

impl i32 {
    pub const MAX: i32 = 2147483647;
    pub const MIN: i32 = -2147483648;

    pub fn max(a: i32, b: i32) -> i32 { return builtin::select::<i32>(a > b, a, b); }

    pub fn min(a: i32, b: i32) -> i32 { return builtin::select::<i32>(a < b, a, b); }

    pub fn to_string(&self) -> String {
        let mut buf = String::with_capacity(12);
        let mut f = Formatter::new(&mut buf);
        fmt_i32_decimal(*self, &mut f);
        return buf;
    }
}

impl u32 {
    pub const MAX: u32 = 4294967295;
    pub const MIN: u32 = 0;

    pub fn max(a: u32, b: u32) -> u32 { return builtin::select::<u32>(a > b, a, b); }

    pub fn min(a: u32, b: u32) -> u32 { return builtin::select::<u32>(a < b, a, b); }

    pub fn to_string(&self) -> String {
        let mut buf = String::with_capacity(11);
