impl Ord for bool {
    pub fn cmp(&self, other: &Self) -> Ordering {
        let a = (*self) as i32;
        let b = (*other) as i32;
        if a < b { return Ordering::Less; }
        if a > b { return Ordering::Greater; }
        return Ordering::Equal;
    }
}
