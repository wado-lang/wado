// Primitive Type Methods
//
// This module provides methods for primitive types (i32, i64, f32, f64, etc.)
// through impl blocks. These are automatically available for all primitive values.
//
// This module intentionally does NOT depend on core:internal to keep the
// dependency structure simple.

// Marker to trigger module loading from prelude.wado
pub global __PRIMITIVES_MODULE_LOADED: bool = true;

/// Copy bytes from linear memory to a new GC array (internal helper)
fn memory_to_gc_array(ptr: i32, len: i32) -> builtin::array<u8> {
    let arr = builtin::array_new::<u8>(len);
    for let mut i = 0; i < len; i += 1 {
        builtin::array_set_u8(arr, i, builtin::memory_load8_u(ptr + i));
    }
    return arr;
}

impl bool {
    /// Convert bool to String ("true" or "false")
    pub fn to_string(self) -> String {
        return if self { "true" } else { "false" };
    }
}

impl char {
    /// Convert char to String (single character as UTF-8)
    pub fn to_string(self) -> String {
        let code = (self) as u32;

        if code < 0x80 {
            // ASCII: single byte
            let arr = builtin::array_new::<u8>(1);
            builtin::array_set_u8(arr, 0, code);
            return String::internal_from_utf8_raw(arr, 1);
        } else if code < 0x800 {
            // 2-byte UTF-8
            let arr = builtin::array_new::<u8>(2);
            builtin::array_set_u8(arr, 0, 0xC0 | (code >> 6));
            builtin::array_set_u8(arr, 1, 0x80 | (code & 0x3F));
            return String::internal_from_utf8_raw(arr, 2);
        } else if code < 0x10000 {
            // 3-byte UTF-8: check for surrogates (0xD800-0xDFFF)
            assert code < 0xD800 || code > 0xDFFF, "invalid Unicode scalar value: surrogate code point";
            let arr = builtin::array_new::<u8>(3);
            builtin::array_set_u8(arr, 0, 0xE0 | (code >> 12));
            builtin::array_set_u8(arr, 1, 0x80 | ((code >> 6) & 0x3F));
            builtin::array_set_u8(arr, 2, 0x80 | (code & 0x3F));
            return String::internal_from_utf8_raw(arr, 3);
        } else {
            // 4-byte UTF-8: check for valid range (max 0x10FFFF)
            assert code <= 0x10FFFF, "invalid Unicode scalar value: out of range";
            let arr = builtin::array_new::<u8>(4);
            builtin::array_set_u8(arr, 0, 0xF0 | (code >> 18));
            builtin::array_set_u8(arr, 1, 0x80 | ((code >> 12) & 0x3F));
            builtin::array_set_u8(arr, 2, 0x80 | ((code >> 6) & 0x3F));
            builtin::array_set_u8(arr, 3, 0x80 | (code & 0x3F));
            return String::internal_from_utf8_raw(arr, 4);
        }
    }
}

impl i8 {
    pub const MAX: i8 = 127 as i8;
    pub const MIN: i8 = -128 as i8;

    /// Convert i8 to String
    pub fn to_string(self) -> String {
        // Cast to i32 and use i32's algorithm
        return ((self) as i32).to_string();
    }
}

impl u8 {
    pub const MAX: u8 = 255 as u8;
    pub const MIN: u8 = 0 as u8;

    /// Convert u8 to String
    pub fn to_string(self) -> String {
        // Cast to i32 and use i32's algorithm (u8 fits in positive i32)
        return ((self) as i32).to_string();
    }
}

