    pub fn fmt(&self, f: &mut Formatter) {
        let v = *self;
        let zero_i64: i64 = 0;
        let is_neg = v < zero_i64;
        let i64_max: i64 = 9223372036854775807;
        let one_i64: i64 = 1;
        let i64_min: i64 = zero_i64 - i64_max - one_i64;
        if v == i64_min {
            let half: i64 = 4611686018427387904;
            fmt_int_base(half, true, f, 16, true);
        } else {
            let abs_val: i64 = if is_neg { zero_i64 - v } else { v };
            fmt_int_base(abs_val, is_neg, f, 16, true);
        }
    }
}


impl Binary for u64 {
    pub fn fmt(&self, f: &mut Formatter) {
        fmt_u64_base((*self) as i64, f, 2, false);
    }
}

impl Octal for u64 {
    pub fn fmt(&self, f: &mut Formatter) {
        fmt_u64_base((*self) as i64, f, 8, false);
    }
}

impl LowerHex for u64 {
    pub fn fmt(&self, f: &mut Formatter) {
        fmt_u64_base((*self) as i64, f, 16, false);
    }
}

impl UpperHex for u64 {
    pub fn fmt(&self, f: &mut Formatter) {
        fmt_u64_base((*self) as i64, f, 16, true);
    }
}

// These enable calling Ord::cmp on primitives when T: Ord bounds are used.

impl Ord for i8 {
    pub fn cmp(&self, other: &Self) -> Ordering {
        if *self < *other { return Ordering::Less; }
        if *self > *other { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

impl Ord for u8 {
    pub fn cmp(&self, other: &Self) -> Ordering {
        if *self < *other { return Ordering::Less; }
        if *self > *other { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

