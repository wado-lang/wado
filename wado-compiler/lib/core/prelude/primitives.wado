    }
}

impl i32 {
    pub const MAX: i32 = 2147483647;
    pub const MIN: i32 = -2147483648;

    /// Convert i32 to String
    /// Maximum i32 value is 2147483647 (10 digits) + optional minus sign = 11 chars max
    pub fn to_string(self) -> String {
        let value = self;

        // Handle zero case
        if value == 0 {
            return "0";
        }

        // Special case for i32::MIN: In two's complement, negating MIN overflows
        // because -(-2147483648) = 2147483648 which exceeds i32::MAX (2147483647).
        if value == -2147483648 {
            return "-2147483648";
        }

        // Determine sign and work with absolute value
        let is_negative = value < 0;
        let abs_value = if is_negative { 0 - value } else { value };

        // Allocate buffer in linear memory (12 bytes max: sign + 10 digits + safety)
        let ptr = builtin::realloc(0, 0, 1, 12);

        // Convert digits in reverse order
        let mut pos = 11; // Start from end of buffer
        for let mut temp = abs_value; temp > 0; temp = temp / 10 {
            pos -= 1;
            let digit = temp % 10;
            builtin::memory_store8(ptr + pos, ('0' as i32) + digit);
        }

        // Add sign if negative
        if is_negative {
            pos -= 1;
            builtin::memory_store8(ptr + pos, '-' as i32);
        }

        // Calculate length and copy to GC array
        let len = 11 - pos;
        let arr = memory_to_gc_array(ptr + pos, len);

        // Free linear memory buffer
        builtin::realloc(ptr, 12, 1, 0);

        return String::internal_from_utf8_raw(arr, len);
    }
}

impl u32 {
    pub const MAX: u32 = 4294967295 as u32;
    pub const MIN: u32 = 0 as u32;

    /// Convert u32 to String (unsigned)
    /// Maximum u32 value is 4294967295 (10 digits)
    pub fn to_string(self) -> String {
        // u32 is represented as i32 in Wasm, interpret as unsigned
        let value = (self) as i32;

        // Handle zero case
        if value == 0 {
            return "0";
        }

        // Convert to i64 for unsigned arithmetic
        // If value is negative as i32, it means the u32 value is >= 2^31
        let unsigned_val: i64 = if value < 0 {
            (value as i64) + 4294967296 as i64
        } else {
            value as i64
        };

        // Allocate buffer in linear memory (11 bytes max: 10 digits + safety)
        let ptr = builtin::realloc(0, 0, 1, 11);

        // Convert digits in reverse order using i64 arithmetic
        let mut pos: i32 = 10;
        let ten: i64 = 10 as i64;
        let zero: i64 = 0 as i64;
        for let mut temp: i64 = unsigned_val; temp > zero; temp = temp / ten {
            pos -= 1;
            let digit: i32 = (temp % ten) as i32;
            builtin::memory_store8(ptr + pos, ('0' as i32) + digit);
        }

        // Calculate length and copy to GC array
        let len: i32 = 10 - pos;
        let arr = memory_to_gc_array(ptr + pos, len);

        // Free linear memory buffer
        builtin::realloc(ptr, 11, 1, 0);

        return String::internal_from_utf8_raw(arr, len);
    }
}

impl i64 {
    pub const MAX: i64 = 9223372036854775807 as i64;
    pub const MIN: i64 = -9223372036854775808 as i64;

    /// Convert i64 to String
    /// Maximum i64 value is 9223372036854775807 (19 digits) + optional minus sign = 20 chars max
    pub fn to_string(self) -> String {
        let value = self;

        // Handle zero case
        let zero_i64: i64 = 0 as i64;
        if value == zero_i64 {
            return "0";
        }

        // Special case for i64::MIN: In two's complement, negating MIN overflows
        let i64_max: i64 = 9223372036854775807 as i64;
        let one_i64: i64 = 1 as i64;
        let i64_min: i64 = zero_i64 - i64_max - one_i64;
        if value == i64_min {
            return "-9223372036854775808";
        }

        // Determine sign and work with absolute value
        let is_negative = value < zero_i64;
        let abs_value: i64 = if is_negative { zero_i64 - value } else { value };

        // Allocate buffer in linear memory (21 bytes max: sign + 19 digits + safety)
        let ptr: i32 = builtin::realloc(0, 0, 1, 21);

        // Convert digits in reverse order
        let mut pos: i32 = 20; // Start from end of buffer
        let ten_i64: i64 = 10 as i64;
        for let mut temp: i64 = abs_value; temp > zero_i64; temp = temp / ten_i64 {
            pos -= 1;
            let digit: i32 = (temp % ten_i64) as i32;
            builtin::memory_store8(ptr + pos, ('0' as i32) + digit);
        }

        // Add sign if negative
        if is_negative {
            pos -= 1;
            builtin::memory_store8(ptr + pos, '-' as i32);
        }

        // Calculate length and copy to GC array
        let len: i32 = 20 - pos;
        let arr = memory_to_gc_array(ptr + pos, len);

        // Free linear memory buffer
        builtin::realloc(ptr, 21, 1, 0);

        return String::internal_from_utf8_raw(arr, len);
    }
}

impl u64 {
    pub const MAX: u64 = 18446744073709551615 as u64;
    pub const MIN: u64 = 0 as u64;

    /// Convert u64 to String (unsigned)
    /// Maximum u64 value is 18446744073709551615 (20 digits)
    pub fn to_string(self) -> String {
        // u64 is represented as i64 in Wasm, interpret as unsigned
        let value = (self) as i64;

        // Handle zero case
        let zero: i64 = 0 as i64;
        if value == zero {
            return "0";
        }

        // Allocate buffer in linear memory (21 bytes max: 20 digits + safety)
        let ptr: i32 = builtin::realloc(0, 0, 1, 21);

        // Convert digits in reverse order
        let mut pos: i32 = 20;
        let mut temp: i64 = value;
        let ten: i64 = 10 as i64;
        let offset_div: i64 = 1844674407370955161 as i64; // 2^64 / 10

        // Loop until temp is zero
        while temp != zero {
            pos -= 1;
            let mut digit: i32 = 0;

            if temp >= zero {
                // Positive temp: normal signed arithmetic works correctly
                digit = (temp % ten) as i32;
                temp = temp / ten;
            } else {
                // Negative temp: need unsigned semantics
                let signed_rem: i64 = temp % ten;
                let rem_adjusted: i64 = signed_rem + 6 as i64;

                // Get digit in range [0, 9]
                if rem_adjusted >= zero {
                    digit = rem_adjusted as i32;
                } else {
                    digit = (rem_adjusted + ten) as i32;
                }

                // Calculate unsigned quotient
                let signed_quot: i64 = temp / ten;
                let mut carry: i64 = 0 as i64;
                if rem_adjusted < zero {
                    carry = 0 - 1 as i64;
                }
                temp = signed_quot + offset_div + carry;
            }

            builtin::memory_store8(ptr + pos, ('0' as i32) + digit);
        }

        // Calculate length and copy to GC array
        let len: i32 = 20 - pos;
        let arr = memory_to_gc_array(ptr + pos, len);

        // Free linear memory buffer
        builtin::realloc(ptr, 21, 1, 0);

        return String::internal_from_utf8_raw(arr, len);
    }
}

impl f32 {
    // Constants
    pub const PI: f32 = 3.14159265358979323846 as f32;
    pub const TAU: f32 = 6.28318530717958647692 as f32;
    pub const E: f32 = 2.71828182845904523536 as f32;
    pub const LN2: f32 = 0.69314718055994530942 as f32;
    pub const LN10: f32 = 2.30258509299404568402 as f32;
    pub const LOG2_E: f32 = 1.44269504088896340736 as f32;
    pub const LOG10_E: f32 = 0.43429448190325182765 as f32;
    pub const SQRT2: f32 = 1.41421356237309504880 as f32;
    pub const FRAC_1_SQRT2: f32 = 0.70710678118654752440 as f32;
    pub const FRAC_PI_2: f32 = 1.57079632679489661923 as f32;
    pub const FRAC_PI_4: f32 = 0.78539816339744830962 as f32;
    pub const INFINITY: f32 = (1.0 as f32) / (0.0 as f32);
    pub const NEG_INFINITY: f32 = (-1.0 as f32) / (0.0 as f32);

    /// Convert f32 to String using the bundled float-to-string algorithm
    pub fn to_string(self) -> String {
        let value = self;

        // Allocate linear memory buffer (16 bytes max for f32)
        let ptr = builtin::realloc(0, 0, 1, 16);

        // Convert float to bytes in linear memory
        let len = builtin::f32_to_buffer(value, ptr);

        let arr = memory_to_gc_array(ptr, len);

        // Free linear memory buffer
        builtin::realloc(ptr, 16, 1, 0);

        return String::internal_from_utf8_raw(arr, len);
    }

    // Wasm instruction math (direct)

    /// Absolute value
    pub fn abs(x: f32) -> f32 { return builtin::f32_abs(x); }

    /// Ceiling (round toward +infinity)
    pub fn ceil(x: f32) -> f32 { return builtin::f32_ceil(x); }

    /// Floor (round toward -infinity)
    pub fn floor(x: f32) -> f32 { return builtin::f32_floor(x); }

    /// Truncate toward zero
    pub fn trunc(x: f32) -> f32 { return builtin::f32_trunc(x); }

    /// Round to nearest even
    pub fn round(x: f32) -> f32 { return builtin::f32_nearest(x); }

    /// Square root
    pub fn sqrt(x: f32) -> f32 { return builtin::f32_sqrt(x); }

    /// Minimum of two values
    pub fn min(x: f32, y: f32) -> f32 { return builtin::f32_min(x, y); }

    /// Maximum of two values
    pub fn max(x: f32, y: f32) -> f32 { return builtin::f32_max(x, y); }

    /// Copy sign from y to x
    pub fn copysign(x: f32, y: f32) -> f32 { return builtin::f32_copysign(x, y); }

    // Transcendental math (bundled libm)

    /// Sine (in radians)
    pub fn sin(x: f32) -> f32 { return builtin::f32_sin(x); }

    /// Cosine (in radians)
    pub fn cos(x: f32) -> f32 { return builtin::f32_cos(x); }

    /// Tangent (in radians)
    pub fn tan(x: f32) -> f32 { return builtin::f32_tan(x); }

    /// Arc sine (returns radians)
    pub fn asin(x: f32) -> f32 { return builtin::f32_asin(x); }

    /// Arc cosine (returns radians)
    pub fn acos(x: f32) -> f32 { return builtin::f32_acos(x); }

    /// Arc tangent (returns radians)
    pub fn atan(x: f32) -> f32 { return builtin::f32_atan(x); }

    /// Arc tangent of y/x (returns radians)
    pub fn atan2(y: f32, x: f32) -> f32 { return builtin::f32_atan2(y, x); }

    /// Hyperbolic sine
    pub fn sinh(x: f32) -> f32 { return builtin::f32_sinh(x); }

    /// Hyperbolic cosine
    pub fn cosh(x: f32) -> f32 { return builtin::f32_cosh(x); }

    /// Hyperbolic tangent
    pub fn tanh(x: f32) -> f32 { return builtin::f32_tanh(x); }

    /// Inverse hyperbolic sine
    pub fn asinh(x: f32) -> f32 { return builtin::f32_asinh(x); }

    /// Inverse hyperbolic cosine
    pub fn acosh(x: f32) -> f32 { return builtin::f32_acosh(x); }

    /// Inverse hyperbolic tangent
    pub fn atanh(x: f32) -> f32 { return builtin::f32_atanh(x); }

    /// e raised to the power x
    pub fn exp(x: f32) -> f32 { return builtin::f32_exp(x); }

    /// 2 raised to the power x
    pub fn exp2(x: f32) -> f32 { return builtin::f32_exp2(x); }

    /// e^x - 1 (more accurate for small x)
    pub fn expm1(x: f32) -> f32 { return builtin::f32_expm1(x); }

    /// Natural logarithm (base e)
    pub fn ln(x: f32) -> f32 { return builtin::f32_ln(x); }

    /// Logarithm base 2
    pub fn log2(x: f32) -> f32 { return builtin::f32_log2(x); }

    /// Logarithm base 10
    pub fn log10(x: f32) -> f32 { return builtin::f32_log10(x); }

    /// ln(1 + x) (more accurate for small x)
    pub fn ln1p(x: f32) -> f32 { return builtin::f32_ln1p(x); }

    /// x raised to the power y
    pub fn pow(x: f32, y: f32) -> f32 { return builtin::f32_pow(x, y); }

    /// Cube root
    pub fn cbrt(x: f32) -> f32 { return builtin::f32_cbrt(x); }

    /// Euclidean distance: sqrt(x^2 + y^2)
    pub fn hypot(x: f32, y: f32) -> f32 { return builtin::f32_hypot(x, y); }

    /// Floating-point remainder of x/y
    pub fn fmod(x: f32, y: f32) -> f32 { return builtin::f32_fmod(x, y); }
}

impl f64 {
    // Constants
    pub const PI: f64 = 3.14159265358979323846;
    pub const TAU: f64 = 6.28318530717958647692;
    pub const E: f64 = 2.71828182845904523536;
    pub const LN2: f64 = 0.69314718055994530942;
    pub const LN10: f64 = 2.30258509299404568402;
    pub const LOG2_E: f64 = 1.44269504088896340736;
    pub const LOG10_E: f64 = 0.43429448190325182765;
    pub const SQRT2: f64 = 1.41421356237309504880;
    pub const FRAC_1_SQRT2: f64 = 0.70710678118654752440;
    pub const FRAC_PI_2: f64 = 1.57079632679489661923;
    pub const FRAC_PI_4: f64 = 0.78539816339744830962;
    pub const INFINITY: f64 = 1.0 / 0.0;
    pub const NEG_INFINITY: f64 = -1.0 / 0.0;

    /// Convert f64 to String using the bundled float-to-string algorithm
    pub fn to_string(self) -> String {
        let value = self;

        // Allocate linear memory buffer (24 bytes max for f64)
        let ptr = builtin::realloc(0, 0, 1, 24);

        // Convert float to bytes in linear memory
        let len = builtin::f64_to_buffer(value, ptr);

        let arr = memory_to_gc_array(ptr, len);

        // Free linear memory buffer
        builtin::realloc(ptr, 24, 1, 0);

        return String::internal_from_utf8_raw(arr, len);
    }

