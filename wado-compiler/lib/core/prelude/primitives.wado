impl Binary for i8 {
    pub fn fmt(&self, f: &mut Formatter) {
        let v = (*self) as i32;
        let is_neg = v < 0;
        let abs_val: i64 = if is_neg { 0 - (v as i64) } else { v as i64 };
        fmt_int_base(abs_val, is_neg, f, 2, false);
    }
}

impl Binary for u8 {
    pub fn fmt(&self, f: &mut Formatter) {
        fmt_int_base(((*self) as i32) as i64, false, f, 2, false);
    }
}

impl Binary for i16 {
    pub fn fmt(&self, f: &mut Formatter) {
        let v = (*self) as i32;
        let is_neg = v < 0;
        let abs_val: i64 = if is_neg { 0 - (v as i64) } else { v as i64 };
        fmt_int_base(abs_val, is_neg, f, 2, false);
    }
}

impl Binary for u16 {
    pub fn fmt(&self, f: &mut Formatter) {
        fmt_int_base(((*self) as i32) as i64, false, f, 2, false);
    }
}

impl Binary for i32 {
    pub fn fmt(&self, f: &mut Formatter) {
        let v = *self;
        let is_neg = v < 0;
        let abs_val: i64 = if is_neg { 0 - (v as i64) } else { v as i64 };
        fmt_int_base(abs_val, is_neg, f, 2, false);
    }
}

impl Binary for u32 {
    pub fn fmt(&self, f: &mut Formatter) {
        let val_i32 = (*self) as i32;
        let abs_val: i64 = if val_i32 < 0 {
            (val_i32 as i64) + 4294967296
        } else {
            val_i32 as i64
        };
        fmt_int_base(abs_val, false, f, 2, false);
    }
}

impl Binary for i64 {
    pub fn fmt(&self, f: &mut Formatter) {
        let v = *self;
        let zero_i64: i64 = 0;
        let is_neg = v < zero_i64;
        let i64_max: i64 = 9223372036854775807;
        let one_i64: i64 = 1;
        let i64_min: i64 = zero_i64 - i64_max - one_i64;
        if v == i64_min {
            // 2^63 = 9223372036854775808, handle by splitting: first bit + rest
            // 9223372036854775808 / 2 = 4611686018427387904, remainder 0
            let half: i64 = 4611686018427387904;
            fmt_int_base(half, true, f, 2, false);
        } else {
            let abs_val: i64 = if is_neg { zero_i64 - v } else { v };
            fmt_int_base(abs_val, is_neg, f, 2, false);
        }
    }
}


