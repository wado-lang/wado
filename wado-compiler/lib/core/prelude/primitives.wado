impl Ord for f32 {
    pub fn cmp(&self, other: &Self) -> Ordering {
        if *self < *other { return Ordering::Less; }
        if *self > *other { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

impl Ord for f64 {
    pub fn cmp(&self, other: &Self) -> Ordering {
        if *self < *other { return Ordering::Less; }
        if *self > *other { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

impl Ord for char {
    pub fn cmp(&self, other: &Self) -> Ordering {
        if *self < *other { return Ordering::Less; }
        if *self > *other { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

impl Ord for bool {
    pub fn cmp(&self, other: &Self) -> Ordering {
        let a = (*self) as i32;
        let b = (*other) as i32;
        if a < b { return Ordering::Less; }
        if a > b { return Ordering::Greater; }
        return Ordering::Equal;
    }
}
