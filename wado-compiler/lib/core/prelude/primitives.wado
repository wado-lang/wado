// Primitive Type Methods
//
// This module provides methods for primitive types (i32, i64, f32, f64, etc.)
// through impl blocks. These are automatically available for all primitive values.
//
// This module intentionally does NOT depend on core:internal to keep the
// dependency structure simple.

// Marker to trigger module loading from prelude.wado
pub global __PRIMITIVES_MODULE_LOADED: bool = true;

/// Copy bytes from linear memory to a new GC array (internal helper)
fn memory_to_gc_array(ptr: i32, len: i32) -> builtin::array<u8> {
    let arr = builtin::array_new::<u8>(len);
    for let mut i = 0; i < len; i += 1 {
        builtin::array_set_u8(arr, i, builtin::memory_load8_u(ptr + i));
    }
    return arr;
}

// ============================================================
// Format helper functions
// ============================================================
// These write formatted values directly to a Formatter's buffer,
// avoiding intermediate GC String allocations in the common case.

/// Count decimal digits of a non-negative i64 value.
fn count_digits_i64(val: i64) -> i32 {
    let zero: i64 = 0;
    if val == zero { return 1; }
    let ten: i64 = 10;
    let mut n: i32 = 0;
    for let mut t: i64 = val; t > zero; t = t / ten {
        n += 1;
    }
    return n;
}

/// Write `digit_count` decimal digits of `abs_val` backwards into `arr` starting at `offset`.
fn write_decimal_digits(arr: builtin::array<u8>, offset: i32, abs_val: i64, digit_count: i32) {
    let zero: i64 = 0;
    let ten: i64 = 10;
    let mut pos = offset + digit_count;
    if abs_val == zero {
        builtin::array_set_u8(arr, offset, '0' as i32);
    } else {
        for let mut temp: i64 = abs_val; temp > zero; temp = temp / ten {
            pos -= 1;
            builtin::array_set_u8(arr, pos, ('0' as i32) + ((temp % ten) as i32));
        }
    }
}

/// Write `digit_count` digits of `abs_val` in given base backwards into `arr` at `offset`.
fn write_base_digits(arr: builtin::array<u8>, offset: i32, abs_val: i64, digit_count: i32, base: i32, upper: bool) {
    let zero: i64 = 0;
    let base64: i64 = base as i64;
    let mut pos = offset + digit_count;
    if abs_val == zero {
        builtin::array_set_u8(arr, offset, '0' as i32);
    } else {
        for let mut temp: i64 = abs_val; temp > zero; temp = temp / base64 {
            pos -= 1;
            let digit: i32 = (temp % base64) as i32;
            let ch = if digit < 10 {
                ('0' as i32) + digit
            } else if upper {
                ('A' as i32) + digit - 10
            } else {
                ('a' as i32) + digit - 10
            };
            builtin::array_set_u8(arr, pos, ch);
        }
    }
}

/// Count digits of a non-negative i64 value in the given base.
fn count_digits_base(val: i64, base: i32) -> i32 {
    let zero: i64 = 0;
    if val == zero { return 1; }
    let base64: i64 = base as i64;
    let mut n: i32 = 0;
    for let mut t: i64 = val; t > zero; t = t / base64 {
        n += 1;
    }
    return n;
}

/// Count digits of a u64 value (as raw i64 bits) in the given power-of-2 base.
/// `bits_per_digit` is log2(base): 1 for binary, 3 for octal, 4 for hex.
fn count_digits_u64_base(val_i64: i64, bits_per_digit: i32) -> i32 {
    let zero: i64 = 0;
    if val_i64 == zero { return 1; }
    // Count leading zeros manually: find highest set bit
    let mut highest_bit: i32 = 0;
    // Check high 32 bits
    let high32: i64 = (val_i64 >> 32) & 0xFFFFFFFF;
    if high32 != zero {
        // Bit is somewhere in bits 32..63
        let mut b: i32 = 63;
        while b >= 32 {
            let one: i64 = 1;
            if (val_i64 >> (b as i64)) & one != zero {
                highest_bit = b;
                break;
            }
            b -= 1;
        }
    } else {
        // Bit is somewhere in bits 0..31
        let mut b: i32 = 31;
        while b >= 0 {
            let one: i64 = 1;
            if (val_i64 >> (b as i64)) & one != zero {
                highest_bit = b;
                break;
            }
            b -= 1;
        }
    }
    return (highest_bit / bits_per_digit) + 1;
}

/// Write digits of a u64 value (as raw i64 bits) in a power-of-2 base.
fn write_u64_base_digits(arr: builtin::array<u8>, offset: i32, val_i64: i64, digit_count: i32, bits_per_digit: i32, mask: i32, upper: bool) {
    let zero: i64 = 0;
    let mask64: i64 = mask as i64;
    let mut pos = offset + digit_count;
    if val_i64 == zero {
        builtin::array_set_u8(arr, offset, '0' as i32);
    } else {
        let mut temp: i64 = val_i64;
        while temp != zero {
            pos -= 1;
            let digit: i32 = (temp & mask64) as i32;
            let ch = if digit < 10 {
                ('0' as i32) + digit
            } else if upper {
                ('A' as i32) + digit - 10
            } else {
                ('a' as i32) + digit - 10
            };
            builtin::array_set_u8(arr, pos, ch);
            // Unsigned right shift: use Wasm's i64.shr_u semantics
            // In Wado, >> on i64 is arithmetic shift. For unsigned shift we need:
            // (val as u64 >> bits) as i64
            let shift_u64: u64 = bits_per_digit as u64;
            temp = ((temp as u64) >> shift_u64) as i64;
        }
    }
}

/// Write a u64 value in the given power-of-2 base (2, 8, or 16) into the Formatter's output buffer.
fn fmt_u64_base(val_i64: i64, f: &mut Formatter, base: i32, upper: bool) {
    let bits_per_digit = if base == 2 { 1 } else if base == 8 { 3 } else { 4 };
    let mask = base - 1;
    let prefix = if f.alternate() {
        if base == 2 {
            "0b"
        } else if base == 8 {
            "0o"
        } else if upper {
            "0X"
        } else {
            "0x"
        }
    } else {
        ""
    };
    let digit_count = count_digits_u64_base(val_i64, bits_per_digit);
    let offset = f.prepare_int_write(false, prefix, digit_count);
    write_u64_base_digits(f.buf.internal_raw_bytes(), offset, val_i64, digit_count, bits_per_digit, mask, upper);
}

/// Write i32 as decimal directly into the Formatter's output buffer.
fn fmt_i32_decimal(value: i32, f: &mut Formatter) {
    let is_negative = value < 0;
    let abs_val: i64 = if is_negative { 0 - (value as i64) } else { value as i64 };
    let digit_count = count_digits_i64(abs_val);
    let offset = f.prepare_int_write(is_negative, "", digit_count);
    write_decimal_digits(f.buf.internal_raw_bytes(), offset, abs_val, digit_count);
}

/// Write u32 as decimal directly into the Formatter's output buffer.
fn fmt_u32_decimal(value: u32, f: &mut Formatter) {
    let val_i32 = (value) as i32;
    let abs_val: i64 = if val_i32 < 0 {
        (val_i32 as i64) + 4294967296
    } else {
        val_i32 as i64
    };
    let digit_count = count_digits_i64(abs_val);
    let offset = f.prepare_int_write(false, "", digit_count);
    write_decimal_digits(f.buf.internal_raw_bytes(), offset, abs_val, digit_count);
}

/// Write i64 as decimal directly into the Formatter's output buffer.
/// Handles i64::MIN specially.
fn fmt_i64_decimal(value: i64, f: &mut Formatter) {
    let zero_i64: i64 = 0;
    let is_negative = value < zero_i64;
    let i64_max: i64 = 9223372036854775807;
    let one_i64: i64 = 1;
    let i64_min: i64 = zero_i64 - i64_max - one_i64;
    let ten_i64: i64 = 10;

    if value == i64_min {
        // i64::MIN = -9223372036854775808: last digit '8', remaining 922337203685477580
        let remaining: i64 = 922337203685477580;
        let remaining_digits = count_digits_i64(remaining);
        let digit_count = remaining_digits + 1;
        let offset = f.prepare_int_write(true, "", digit_count);
        let repr = f.buf.internal_raw_bytes();
        // Write the remaining digits, then the last '8'
        write_decimal_digits(repr, offset, remaining, remaining_digits);
        builtin::array_set_u8(repr, offset + remaining_digits, '8' as i32);
    } else {
        let abs_val: i64 = if is_negative { zero_i64 - value } else { value };
        let digit_count = count_digits_i64(abs_val);
        let offset = f.prepare_int_write(is_negative, "", digit_count);
        write_decimal_digits(f.buf.internal_raw_bytes(), offset, abs_val, digit_count);
    }
}

/// Write u64 as decimal directly into the Formatter's output buffer.
/// Uses special unsigned division for values > i64::MAX.
fn fmt_u64_decimal(value: u64, f: &mut Formatter) {
    let val_i64 = (value) as i64;
    let zero: i64 = 0;
    let ten: i64 = 10;

    if val_i64 == zero {
        let offset = f.prepare_int_write(false, "", 1);
        builtin::array_set_u8(f.buf.internal_raw_bytes(), offset, '0' as i32);
        return;
    }

    // Count digits using unsigned division
    let mut digit_count: i32 = 0;
    let offset_div: i64 = 1844674407370955161;
    let mut temp: i64 = val_i64;
    while temp != zero {
        digit_count += 1;
        if temp >= zero {
            temp = temp / ten;
        } else {
            let signed_rem: i64 = temp % ten;
            let rem_adjusted: i64 = signed_rem + 6;
            let signed_quot: i64 = temp / ten;
            let mut carry: i64 = 0;
            if rem_adjusted < zero {
                carry = 0 - 1;
            }
            temp = signed_quot + offset_div + carry;
        }
    }

    let offset = f.prepare_int_write(false, "", digit_count);
    let repr = f.buf.internal_raw_bytes();

    // Write digits using unsigned division (backwards)
    let mut pos = offset + digit_count;
    temp = val_i64;
    while temp != zero {
        pos -= 1;
        let mut digit: i32 = 0;
        if temp >= zero {
            digit = (temp % ten) as i32;
            temp = temp / ten;
        } else {
            let signed_rem: i64 = temp % ten;
            let rem_adjusted: i64 = signed_rem + 6;
            if rem_adjusted >= zero {
                digit = rem_adjusted as i32;
            } else {
                digit = (rem_adjusted + ten) as i32;
            }
            let signed_quot: i64 = temp / ten;
            let mut carry: i64 = 0;
            if rem_adjusted < zero {
                carry = 0 - 1;
            }
            temp = signed_quot + offset_div + carry;
        }
        builtin::array_set_u8(repr, pos, ('0' as i32) + digit);
    }
}

/// Write f32 to formatter using bundled float-to-string algorithm.
/// (f32_to_buffer writes to linear memory — unavoidable for the bundled Wasm library.)
fn fmt_f32_display(value: f32, f: &mut Formatter) {
    let ptr = builtin::realloc(0, 0, 1, 24);
    let len = builtin::f32_to_buffer(value, ptr);
    f.write_from_memory(ptr, len);
    builtin::realloc(ptr, 24, 1, 0);
}

/// Write f64 to formatter using bundled float-to-string algorithm.
/// (f64_to_buffer writes to linear memory — unavoidable for the bundled Wasm library.)
fn fmt_f64_display(value: f64, f: &mut Formatter) {
    let ptr = builtin::realloc(0, 0, 1, 32);
    let len = builtin::f64_to_buffer(value, ptr);
    f.write_from_memory(ptr, len);
    builtin::realloc(ptr, 32, 1, 0);
}

/// Write f32 with fixed-point precision.
fn fmt_f32_fixed(value: f32, precision: i32, f: &mut Formatter) {
    let buf_size = 64;
    let ptr = builtin::realloc(0, 0, 1, buf_size);
    let len = builtin::f32_to_buffer_fixed(value, precision, ptr);
    f.write_from_memory(ptr, len);
    builtin::realloc(ptr, buf_size, 1, 0);
}

/// Write f64 with fixed-point precision.
fn fmt_f64_fixed(value: f64, precision: i32, f: &mut Formatter) {
    let buf_size = 400;
    let ptr = builtin::realloc(0, 0, 1, buf_size);
    let len = builtin::f64_to_buffer_fixed(value, precision, ptr);
    f.write_from_memory(ptr, len);
    builtin::realloc(ptr, buf_size, 1, 0);
}

/// Write f32 in exponential notation (lowercase 'e').
fn fmt_f32_exp(value: f32, precision: i32, f: &mut Formatter) {
    let ptr = builtin::realloc(0, 0, 1, 32);
    let len = builtin::f32_to_buffer_exp(value, precision, ptr);
    f.write_from_memory(ptr, len);
    builtin::realloc(ptr, 32, 1, 0);
}

/// Write f64 in exponential notation (lowercase 'e').
fn fmt_f64_exp(value: f64, precision: i32, f: &mut Formatter) {
    let ptr = builtin::realloc(0, 0, 1, 32);
    let len = builtin::f64_to_buffer_exp(value, precision, ptr);
    f.write_from_memory(ptr, len);
    builtin::realloc(ptr, 32, 1, 0);
}

/// Write f32 in uppercase exponential notation.
/// Formats using lowercase 'e', then replaces with 'E' in the output buffer.
fn fmt_f32_upper_exp(value: f32, precision: i32, f: &mut Formatter) {
    // Format with lowercase first, then uppercase the 'e' in the String
    let mut tmp = String::with_capacity(32);
    let mut tmp_fmt = Formatter::new(&mut tmp);
    fmt_f32_exp(value, precision, &mut tmp_fmt);
    // Replace 'e' with 'E' by scanning and rewriting bytes
    let len = tmp.len();
    for let mut i = 0; i < len; i += 1 {
        let b = tmp.get_byte(i);
        if b == 101 {
            tmp.set_byte(i, 69);
        }
    }
    f.write_str(tmp);
}

/// Write f64 in uppercase exponential notation.
/// Formats using lowercase 'e', then replaces with 'E' in the output buffer.
fn fmt_f64_upper_exp(value: f64, precision: i32, f: &mut Formatter) {
    // Format with lowercase first, then uppercase the 'e' in the String
    let mut tmp = String::with_capacity(32);
    let mut tmp_fmt = Formatter::new(&mut tmp);
    fmt_f64_exp(value, precision, &mut tmp_fmt);
    // Replace 'e' with 'E' by scanning and rewriting bytes
    let len = tmp.len();
    for let mut i = 0; i < len; i += 1 {
        let b = tmp.get_byte(i);
        if b == 101 {
            tmp.set_byte(i, 69);
        }
    }
    f.write_str(tmp);
}

/// Write an integer (as i64 absolute value) in the given base (2, 8, or 16)
/// directly into the Formatter's output buffer.
fn fmt_int_base(abs_val: i64, is_negative: bool, f: &mut Formatter, base: i32, upper: bool) {
    let prefix = if f.alternate() {
        if base == 2 {
            "0b"
        } else if base == 8 {
            "0o"
        } else if upper {
            "0X"
        } else {
            "0x"
        }
    } else {
        ""
    };
    let digit_count = count_digits_base(abs_val, base);
    let offset = f.prepare_int_write(is_negative, prefix, digit_count);
    write_base_digits(f.buf.internal_raw_bytes(), offset, abs_val, digit_count, base, upper);
}

// ============================================================
// Primitive type methods
// ============================================================

impl bool {
    pub fn to_string(self) -> String {
        let mut buf = String::with_capacity(5);
        let mut f = Formatter::new(&mut buf);
        f.pad(if self { "true" } else { "false" });
        return buf;
    }
}

impl char {
    pub fn to_string(self) -> String {
        let mut buf = String::with_capacity(4);
        buf.append_char(self);
        return buf;
    }
}

impl i8 {
    pub const MAX: i8 = 127;
    pub const MIN: i8 = -128;

    pub fn to_string(self) -> String {
        return ((self) as i32).to_string();
    }
}

impl u8 {
    pub const MAX: u8 = 255;
    pub const MIN: u8 = 0;

    pub fn to_string(self) -> String {
        return ((self) as i32).to_string();
    }
}

impl i16 {
    pub const MAX: i16 = 32767;
    pub const MIN: i16 = -32768;

    pub fn to_string(self) -> String {
        return ((self) as i32).to_string();
    }
}

impl u16 {
    pub const MAX: u16 = 65535;
    pub const MIN: u16 = 0;

    pub fn to_string(self) -> String {
        return ((self) as i32).to_string();
    }
}

impl i32 {
    pub const MAX: i32 = 2147483647;
    pub const MIN: i32 = -2147483648;

    pub fn to_string(self) -> String {
        let mut buf = String::with_capacity(12);
        let mut f = Formatter::new(&mut buf);
        fmt_i32_decimal(self, &mut f);
        return buf;
    }
}

impl u32 {
    pub const MAX: u32 = 4294967295;
    pub const MIN: u32 = 0;

    pub fn to_string(self) -> String {
        let mut buf = String::with_capacity(11);
        let mut f = Formatter::new(&mut buf);
        fmt_u32_decimal(self, &mut f);
        return buf;
    }
}

impl i64 {
    pub const MAX: i64 = 9223372036854775807;
    pub const MIN: i64 = -9223372036854775808;

    pub fn to_string(self) -> String {
        let mut buf = String::with_capacity(21);
        let mut f = Formatter::new(&mut buf);
        fmt_i64_decimal(self, &mut f);
        return buf;
    }
}

impl u64 {
    pub const MAX: u64 = 18446744073709551615;
    pub const MIN: u64 = 0;

    pub fn to_string(self) -> String {
        let mut buf = String::with_capacity(21);
        let mut f = Formatter::new(&mut buf);
        fmt_u64_decimal(self, &mut f);
        return buf;
    }
}

impl f32 {
    // Constants
    pub const PI: f32 = 3.14159265358979323846;
    pub const TAU: f32 = 6.28318530717958647692;
    pub const E: f32 = 2.71828182845904523536;
    pub const LN2: f32 = 0.69314718055994530942;
    pub const LN10: f32 = 2.30258509299404568402;
    pub const LOG2_E: f32 = 1.44269504088896340736;
    pub const LOG10_E: f32 = 0.43429448190325182765;
    pub const SQRT2: f32 = 1.41421356237309504880;
    pub const FRAC_1_SQRT2: f32 = 0.70710678118654752440;
    pub const FRAC_PI_2: f32 = 1.57079632679489661923;
    pub const FRAC_PI_4: f32 = 0.78539816339744830962;
    pub const INFINITY: f32 = 1.0 / 0.0;
    pub const NEG_INFINITY: f32 = -1.0 / 0.0;

    pub fn to_string(self) -> String {
        let mut buf = String::with_capacity(16);
        let mut f = Formatter::new(&mut buf);
        fmt_f32_display(self, &mut f);
        return buf;
    }

    // Wasm instruction math (direct)

    /// Absolute value
    pub fn abs(x: f32) -> f32 { return builtin::f32_abs(x); }

    /// Ceiling (round toward +infinity)
    pub fn ceil(x: f32) -> f32 { return builtin::f32_ceil(x); }

    /// Floor (round toward -infinity)
    pub fn floor(x: f32) -> f32 { return builtin::f32_floor(x); }

    /// Truncate toward zero
    pub fn trunc(x: f32) -> f32 { return builtin::f32_trunc(x); }

    /// Round to nearest even
    pub fn round(x: f32) -> f32 { return builtin::f32_nearest(x); }

    /// Square root
    pub fn sqrt(x: f32) -> f32 { return builtin::f32_sqrt(x); }

    /// Minimum of two values
    pub fn min(x: f32, y: f32) -> f32 { return builtin::f32_min(x, y); }

    /// Maximum of two values
    pub fn max(x: f32, y: f32) -> f32 { return builtin::f32_max(x, y); }

    /// Copy sign from y to x
    pub fn copysign(x: f32, y: f32) -> f32 { return builtin::f32_copysign(x, y); }

    // Transcendental math (bundled libm)

    /// Sine (in radians)
    pub fn sin(x: f32) -> f32 { return builtin::f32_sin(x); }

    /// Cosine (in radians)
    pub fn cos(x: f32) -> f32 { return builtin::f32_cos(x); }

    /// Tangent (in radians)
    pub fn tan(x: f32) -> f32 { return builtin::f32_tan(x); }

    /// Arc sine (returns radians)
    pub fn asin(x: f32) -> f32 { return builtin::f32_asin(x); }

    /// Arc cosine (returns radians)
    pub fn acos(x: f32) -> f32 { return builtin::f32_acos(x); }

    /// Arc tangent (returns radians)
    pub fn atan(x: f32) -> f32 { return builtin::f32_atan(x); }

    /// Arc tangent of y/x (returns radians)
    pub fn atan2(y: f32, x: f32) -> f32 { return builtin::f32_atan2(y, x); }

    /// Hyperbolic sine
    pub fn sinh(x: f32) -> f32 { return builtin::f32_sinh(x); }

    /// Hyperbolic cosine
    pub fn cosh(x: f32) -> f32 { return builtin::f32_cosh(x); }

    /// Hyperbolic tangent
    pub fn tanh(x: f32) -> f32 { return builtin::f32_tanh(x); }

    /// Inverse hyperbolic sine
    pub fn asinh(x: f32) -> f32 { return builtin::f32_asinh(x); }

    /// Inverse hyperbolic cosine
    pub fn acosh(x: f32) -> f32 { return builtin::f32_acosh(x); }

    /// Inverse hyperbolic tangent
    pub fn atanh(x: f32) -> f32 { return builtin::f32_atanh(x); }

    /// e raised to the power x
    pub fn exp(x: f32) -> f32 { return builtin::f32_exp(x); }

    /// 2 raised to the power x
    pub fn exp2(x: f32) -> f32 { return builtin::f32_exp2(x); }

    /// e^x - 1 (more accurate for small x)
    pub fn expm1(x: f32) -> f32 { return builtin::f32_expm1(x); }

    /// Natural logarithm (base e)
    pub fn ln(x: f32) -> f32 { return builtin::f32_ln(x); }

    /// Logarithm base 2
    pub fn log2(x: f32) -> f32 { return builtin::f32_log2(x); }

    /// Logarithm base 10
    pub fn log10(x: f32) -> f32 { return builtin::f32_log10(x); }

    /// ln(1 + x) (more accurate for small x)
    pub fn ln1p(x: f32) -> f32 { return builtin::f32_ln1p(x); }

    /// x raised to the power y
    pub fn pow(x: f32, y: f32) -> f32 { return builtin::f32_pow(x, y); }

    /// Cube root
    pub fn cbrt(x: f32) -> f32 { return builtin::f32_cbrt(x); }

    /// Euclidean distance: sqrt(x^2 + y^2)
    pub fn hypot(x: f32, y: f32) -> f32 { return builtin::f32_hypot(x, y); }

    /// Floating-point remainder of x/y
    pub fn fmod(x: f32, y: f32) -> f32 { return builtin::f32_fmod(x, y); }
}

impl f64 {
    // Constants
    pub const PI: f64 = 3.14159265358979323846;
    pub const TAU: f64 = 6.28318530717958647692;
    pub const E: f64 = 2.71828182845904523536;
    pub const LN2: f64 = 0.69314718055994530942;
    pub const LN10: f64 = 2.30258509299404568402;
    pub const LOG2_E: f64 = 1.44269504088896340736;
    pub const LOG10_E: f64 = 0.43429448190325182765;
    pub const SQRT2: f64 = 1.41421356237309504880;
    pub const FRAC_1_SQRT2: f64 = 0.70710678118654752440;
    pub const FRAC_PI_2: f64 = 1.57079632679489661923;
    pub const FRAC_PI_4: f64 = 0.78539816339744830962;
    pub const INFINITY: f64 = 1.0 / 0.0;
    pub const NEG_INFINITY: f64 = -1.0 / 0.0;

    pub fn to_string(self) -> String {
        let mut buf = String::with_capacity(24);
        let mut f = Formatter::new(&mut buf);
        fmt_f64_display(self, &mut f);
        return buf;
    }

    // Wasm instruction math (direct)

    /// Absolute value
    pub fn abs(x: f64) -> f64 { return builtin::f64_abs(x); }

    /// Ceiling (round toward +infinity)
    pub fn ceil(x: f64) -> f64 { return builtin::f64_ceil(x); }

    /// Floor (round toward -infinity)
    pub fn floor(x: f64) -> f64 { return builtin::f64_floor(x); }

    /// Truncate toward zero
    pub fn trunc(x: f64) -> f64 { return builtin::f64_trunc(x); }

    /// Round to nearest even
    pub fn round(x: f64) -> f64 { return builtin::f64_nearest(x); }

    /// Square root
    pub fn sqrt(x: f64) -> f64 { return builtin::f64_sqrt(x); }

    /// Minimum of two values
    pub fn min(x: f64, y: f64) -> f64 { return builtin::f64_min(x, y); }

    /// Maximum of two values
    pub fn max(x: f64, y: f64) -> f64 { return builtin::f64_max(x, y); }

    /// Copy sign from y to x
    pub fn copysign(x: f64, y: f64) -> f64 { return builtin::f64_copysign(x, y); }

    // Transcendental math (bundled libm)

    /// Sine (in radians)
    pub fn sin(x: f64) -> f64 { return builtin::f64_sin(x); }

    /// Cosine (in radians)
    pub fn cos(x: f64) -> f64 { return builtin::f64_cos(x); }

    /// Tangent (in radians)
    pub fn tan(x: f64) -> f64 { return builtin::f64_tan(x); }

    /// Arc sine (returns radians)
    pub fn asin(x: f64) -> f64 { return builtin::f64_asin(x); }

    /// Arc cosine (returns radians)
    pub fn acos(x: f64) -> f64 { return builtin::f64_acos(x); }

    /// Arc tangent (returns radians)
    pub fn atan(x: f64) -> f64 { return builtin::f64_atan(x); }

    /// Arc tangent of y/x (returns radians)
    pub fn atan2(y: f64, x: f64) -> f64 { return builtin::f64_atan2(y, x); }

    /// Hyperbolic sine
    pub fn sinh(x: f64) -> f64 { return builtin::f64_sinh(x); }

    /// Hyperbolic cosine
    pub fn cosh(x: f64) -> f64 { return builtin::f64_cosh(x); }

    /// Hyperbolic tangent
    pub fn tanh(x: f64) -> f64 { return builtin::f64_tanh(x); }

    /// Inverse hyperbolic sine
    pub fn asinh(x: f64) -> f64 { return builtin::f64_asinh(x); }

    /// Inverse hyperbolic cosine
    pub fn acosh(x: f64) -> f64 { return builtin::f64_acosh(x); }

    /// Inverse hyperbolic tangent
    pub fn atanh(x: f64) -> f64 { return builtin::f64_atanh(x); }

    /// e raised to the power x
    pub fn exp(x: f64) -> f64 { return builtin::f64_exp(x); }

    /// 2 raised to the power x
    pub fn exp2(x: f64) -> f64 { return builtin::f64_exp2(x); }

    /// e^x - 1 (more accurate for small x)
    pub fn expm1(x: f64) -> f64 { return builtin::f64_expm1(x); }

    /// Natural logarithm (base e)
    pub fn ln(x: f64) -> f64 { return builtin::f64_ln(x); }

    /// Logarithm base 2
    pub fn log2(x: f64) -> f64 { return builtin::f64_log2(x); }

    /// Logarithm base 10
    pub fn log10(x: f64) -> f64 { return builtin::f64_log10(x); }

    /// ln(1 + x) (more accurate for small x)
    pub fn ln1p(x: f64) -> f64 { return builtin::f64_ln1p(x); }

    /// x raised to the power y
    pub fn pow(x: f64, y: f64) -> f64 { return builtin::f64_pow(x, y); }

    /// Cube root
    pub fn cbrt(x: f64) -> f64 { return builtin::f64_cbrt(x); }

    /// Euclidean distance: sqrt(x^2 + y^2)
    pub fn hypot(x: f64, y: f64) -> f64 { return builtin::f64_hypot(x, y); }

    /// Floating-point remainder of x/y
    pub fn fmod(x: f64, y: f64) -> f64 { return builtin::f64_fmod(x, y); }
}
// ============================================================
// Display trait implementations
// ============================================================

impl Display for bool {
    pub fn fmt(&self, f: &mut Formatter) {
        f.pad(if *self { "true" } else { "false" });
    }
}

impl Display for char {
    pub fn fmt(&self, f: &mut Formatter) {
        if f.width() <= 0 {
            f.write_char(*self);
        } else {
            let mut s = String::with_capacity(4);
            s.append_char(*self);
            f.pad(s);
        }
    }
}

impl Display for i8 {
    pub fn fmt(&self, f: &mut Formatter) {
        fmt_i32_decimal((*self) as i32, f);
    }
}

impl Display for u8 {
    pub fn fmt(&self, f: &mut Formatter) {
        fmt_i32_decimal((*self) as i32, f);
    }
}

impl Display for i16 {
    pub fn fmt(&self, f: &mut Formatter) {
        fmt_i32_decimal((*self) as i32, f);
    }
}

impl Display for u16 {
    pub fn fmt(&self, f: &mut Formatter) {
        fmt_i32_decimal((*self) as i32, f);
    }
}

impl Display for i32 {
    pub fn fmt(&self, f: &mut Formatter) {
        fmt_i32_decimal(*self, f);
    }
}

impl Display for u32 {
    pub fn fmt(&self, f: &mut Formatter) {
        fmt_u32_decimal(*self, f);
    }
}

impl Display for i64 {
    pub fn fmt(&self, f: &mut Formatter) {
        fmt_i64_decimal(*self, f);
    }
}

impl Display for u64 {
    pub fn fmt(&self, f: &mut Formatter) {
        fmt_u64_decimal(*self, f);
    }
}

impl Display for f32 {
    pub fn fmt(&self, f: &mut Formatter) {
        let prec = f.precision();
        if prec >= 0 {
            fmt_f32_fixed(*self, prec, f);
        } else {
            fmt_f32_display(*self, f);
        }
    }
}

impl Display for f64 {
    pub fn fmt(&self, f: &mut Formatter) {
        let prec = f.precision();
        if prec >= 0 {
            fmt_f64_fixed(*self, prec, f);
        } else {
            fmt_f64_display(*self, f);
        }
    }
}

