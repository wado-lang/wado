    pub const MAX: u16 = 65535 as u16;
    pub const MIN: u16 = 0 as u16;

    /// Convert u16 to String
    pub fn to_string(self) -> String {
        // Cast to i32 and use i32's algorithm (u16 fits in positive i32)
