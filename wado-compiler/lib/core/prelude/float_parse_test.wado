    ["222822399.9999999999", 0x4d54],
    ["0.00000000000000000000336827945431592869207637619410888873971998691558837890625", 0x1d7e],
    ["0.000000000000000000003368279454315928692076376194108888739719986915588378906250000000001", 0x1d7f],
    ["0.000000000000000000003368279454315928692076376194108888739719986915588378906249999999999", 0x1d7e],
    ["2089072092774400", 0x58ee],
    ["2089072092774400.0000000001", 0x58ee],
    ["2089072092774399.9999999999", 0x58ed],
    ["65929216", 0x4c7c],
    ["65929216.0000000001", 0x4c7c],
    ["65929215.9999999999", 0x4c7b],
    ["61432774449536996141869039616", 0x6f46],
    ["61432774449536996141869039616.0000000001", 0x6f47],
    ["61432774449536996141869039615.9999999999", 0x6f46],
    ["4814600203238192971776", 0x6382],
    ["4814600203238192971776.0000000001", 0x6383],
    ["4814600203238192971775.9999999999", 0x6382],
    ["0.00000000000000000000003029548993475463859216534334706238951184786856174468994140625", 0x1a12],
    ["0.000000000000000000000030295489934754638592165343347062389511847868561744689941406250000000001", 0x1a13],
    ["0.000000000000000000000030295489934754638592165343347062389511847868561744689941406249999999999", 0x1a12],
    ["234608741256037651567521946139480817664", 0x7f30],
    ["234608741256037651567521946139480817664.0000000001", 0x7f31],
    ["234608741256037651567521946139480817663.9999999999", 0x7f30],
    ["0.00000000000000000000000000001", 0xf4b],
    ["000000000000000000000012.5e-1", 0x3fa0],
    ["1e0001", 0x4120],
    ["1e99999", 0x7f80],
    ["-1e-99999", 0x8000],
];

test "f64::from_str rounds once" {
    for let [text, bits] of F64 {
        assert f64::from_str(&text).unwrap().to_bits() == bits, text;
    }
}

test "f32::from_str rounds once" {
    for let [text, bits] of F32 {
        assert f32::from_str(&text).unwrap().to_bits() == bits, text;
    }
}

test "f16::from_str rounds once" {
    for let [text, bits] of F16 {
        assert f16::from_str(&text).unwrap().to_bits() == bits, text;
    }
}

test "bf16::from_str rounds once" {
    for let [text, bits] of BF16 {
        assert bf16::from_str(&text).unwrap().to_bits() == bits, text;
    }
}

fn zeros(n: i32) -> String {
    let mut s = String::with_capacity(n);
    for let mut i = 0; i < n; i += 1 {
        s.push('0');
    }
    return s;
}

test "an exponent past any saturation still cancels the digits' own scale" {
    let run = zeros(2000000);
    assert f64::from_str(`0.${run}1e2000001`).unwrap() == 1.0;
    assert f64::from_str(`1${run}e-2000000`).unwrap() == 1.0;
    assert f32::from_str(`0.${run}25e2000001`).unwrap() == 2.5;
}

test "a half parses NaN, infinity and a malformed string as f32 does" {
    assert f16::from_str("nan").unwrap().is_nan();
    assert bf16::from_str("-inf").unwrap().to_bits() == 0xff80;
    assert f16::from_str("inf").unwrap().to_bits() == 0x7c00;
    assert f16::from_str("1.") matches { Err(_) };
    assert bf16::from_str("") matches { Err(_) };
}
