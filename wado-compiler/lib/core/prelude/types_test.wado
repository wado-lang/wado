test "Option::unwrap on Some" {
    let x: Option<i32> = Option::Some(42);
    assert x.unwrap() == 42;
}


#[expect_trap]
test "Option::unwrap on None traps" {
    let x: Option<i32> = null;
    x.unwrap();
}

test "Result::unwrap on Ok" {
    let x: Result<i32, String> = Result::Ok(42);
    assert x.unwrap() == 42;
}


#[expect_trap]
test "Result::unwrap on Err traps" {
    let x: Result<i32, String> = Result::Err("error");
    x.unwrap();
}

test "Result::is_ok" {
    let ok: Result<i32, String> = Result::Ok(1);
    let err: Result<i32, String> = Result::Err("e");
    assert ok.is_ok();
    assert !ok.is_err();
    assert err.is_err();
    assert !err.is_ok();
}

test "Option::expect on Some" {
    let x: Option<i32> = Option::Some(42);
    assert x.expect("must be present") == 42;
}

#[expect_trap]
test "Option::expect on None traps" {
    let x: Option<i32> = null;
    x.expect("must be present");
}

test "Result::expect on Ok" {
    let x: Result<i32, String> = Result::Ok(42);
    assert x.expect("must be ok") == 42;
}

#[expect_trap]
test "Result::expect on Err traps" {
    let x: Result<i32, String> = Result::Err("error");
    x.expect("must be ok");
}

test "Result::unwrap_err on Err" {
    let x: Result<i32, String> = Result::Err("boom");
    assert x.unwrap_err() == "boom";
}

#[expect_trap]
test "Result::unwrap_err on Ok traps" {
    let x: Result<i32, String> = Result::Ok(7);
    x.unwrap_err();
}

test "Result::expect_err on Err" {
    let x: Result<i32, String> = Result::Err("boom");
    assert x.expect_err("must be err") == "boom";
}

#[expect_trap]
test "Result::expect_err on Ok traps" {
    let x: Result<i32, String> = Result::Ok(7);
    x.expect_err("must be err");
}

test "Option::unwrap_or" {
    let some: Option<i32> = Option::Some(42);
    let none: Option<i32> = null;
    assert some.unwrap_or(0) == 42;
    assert none.unwrap_or(0) == 0;
}

test "Option::unwrap_or_else" {
    let some: Option<i32> = Option::Some(42);
    let none: Option<i32> = null;
    assert some.unwrap_or_else(|| 0) == 42;
    assert none.unwrap_or_else(|| 7) == 7;
}

test "Option::unwrap_or_else runs the fallback only for None" {
    let mut calls = 0;
    let some: Option<i32> = Option::Some(42);
    let none: Option<i32> = null;
    assert some.unwrap_or_else(|| {
        calls += 1;
        return 0;
    }) == 42;
    assert none.unwrap_or_else(|| {
        calls += 1;
        return 0;
    }) == 0;
    assert calls == 1;
}

test "Option::map" {
    let some: Option<i32> = Option::Some(21);
    let none: Option<i32> = null;
    assert some.map(|v: i32| v * 2) == Option::Some(42);
    assert none.map(|v: i32| v * 2) == Option::<i32>::None;
}

test "Option::map changes the type" {
    let some: Option<i32> = Option::Some(7);
    assert some.map(|v: i32| `${v}`) == Option::Some("7");
}

test "Option::map over a mutating capture" {
    let mut calls = 0;
    let some: Option<i32> = Option::Some(1);
    let none: Option<i32> = null;
    assert some.map(|v: i32| {
        calls += 1;
        return v;
    }) == Option::Some(1);
    assert none.map(|v: i32| {
        calls += 1;
        return v;
    }) == Option::<i32>::None;
    assert calls == 1;
}

test "Option::ok_or" {
    let some: Option<i32> = Option::Some(42);
    let none: Option<i32> = null;
    assert some.ok_or("missing") == Result::<i32, String>::Ok(42);
    assert none.ok_or("missing") == Result::<i32, String>::Err("missing");
}

test "Option::ok_or_else" {
    let some: Option<i32> = Option::Some(42);
    let none: Option<i32> = null;
    assert some.ok_or_else(|| "missing") == Result::<i32, String>::Ok(42);
    assert none.ok_or_else(|| "missing") == Result::<i32, String>::Err("missing");
}

test "Option::ok_or_else builds the error only for None" {
    let mut calls = 0;
    let some: Option<i32> = Option::Some(42);
    let none: Option<i32> = null;
    assert some.ok_or_else(|| {
        calls += 1;
        return "missing";
    }) == Result::<i32, String>::Ok(42);
    assert none.ok_or_else(|| {
        calls += 1;
        return "missing";
    }) == Result::<i32, String>::Err("missing");
    assert calls == 1;
}

test "Result::unwrap_or" {
    let ok: Result<i32, String> = Result::Ok(42);
    let err: Result<i32, String> = Result::Err("boom");
    assert ok.unwrap_or(0) == 42;
    assert err.unwrap_or(0) == 0;
}

test "Result::unwrap_or_else reads the Err payload" {
    let ok: Result<i32, String> = Result::Ok(42);
    let err: Result<i32, String> = Result::Err("boom");
    assert ok.unwrap_or_else(|e: String| e.len() as i32) == 42;
    assert err.unwrap_or_else(|e: String| e.len() as i32) == 4;
}

test "Result::map" {
    let ok: Result<i32, String> = Result::Ok(21);
    let err: Result<i32, String> = Result::Err("boom");
    assert ok.map(|v: i32| v * 2) == Result::<i32, String>::Ok(42);
    assert err.map(|v: i32| v * 2) == Result::<i32, String>::Err("boom");
}

test "Result::map_err" {
    let ok: Result<i32, String> = Result::Ok(42);
    let err: Result<i32, String> = Result::Err("boom");
    assert ok.map_err(|e: String| e.len()) == Result::<i32, i32>::Ok(42);
    assert err.map_err(|e: String| e.len()) == Result::<i32, i32>::Err(4);
}
