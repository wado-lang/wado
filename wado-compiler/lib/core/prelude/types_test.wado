test "Option::unwrap on Some" {
    let x: Option<i32> = Option::Some(42);
    assert x.unwrap() == 42;
}


#[expect_trap]
test "Option::unwrap on None traps" {
    let x: Option<i32> = null;
    x.unwrap();
}

test "Result::unwrap on Ok" {
    let x: Result<i32, String> = Result::Ok(42);
    assert x.unwrap() == 42;
}


#[expect_trap]
test "Result::unwrap on Err traps" {
    let x: Result<i32, String> = Result::Err("error");
    x.unwrap();
}

test "Result::is_ok" {
    let ok: Result<i32, String> = Result::Ok(1);
    let err: Result<i32, String> = Result::Err("e");
    assert ok.is_ok();
    assert !ok.is_err();
    assert err.is_err();
    assert !err.is_ok();
}
