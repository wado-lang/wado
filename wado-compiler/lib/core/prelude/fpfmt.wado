#![no_prelude]
#![stdlib("core:prelude/fpfmt.wado")]
// Float-to-String conversion using Russ Cox's unrounded scaling algorithm
// Ported from rsc.io/fpfmt (https://research.swtch.com/fp)
//
// Copyright 2025 The Go Authors. All rights reserved.
// Use of this source code is governed by a BSD-style license.
// See https://github.com/rsc/fpfmt/blob/main/LICENSE


// Powers of 10 from 10^0 to 10^19
global POW10: Array<u64> = [1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000, 10000000000,
    100000000000, 1000000000000, 10000000000000, 100000000000000, 1000000000000000, 10000000000000000,
    100000000000000000, 1000000000000000000, 10000000000000000000];

pub fn pow10(n: i32) -> u64 {
    return POW10[n];
}

// Returns the bit length of x (position of highest set bit + 1)
pub fn u64_bit_len(x: u64) -> i32 {
    return 64 - builtin::i64_clz(x as i64) as i32;
}

// log10_pow2(x) returns floor(log10(2^x)) = floor(x * log10(2))
pub fn log10_pow2(x: i32) -> i32 {
    return x * 78913 >> 18;
}

// log2_pow10(x) returns floor(log2(10^x)) = floor(x * log2(10))
pub fn log2_pow10(x: i32) -> i32 {
    return x * 108853 >> 15;
}

// Result of unpacking a float64
pub struct UnpackResult {
    pub mantissa: u64,
    pub exponent: i32,
}

// unpack64 returns (mantissa, exponent) such that f = mantissa * 2^exponent
pub fn unpack64(f: f64) -> UnpackResult {
    let bits = f.to_bits() as u64;

    let mantissa_mask: u64 = 0x000FFFFFFFFFFFFF;
    let exp_mask: u64 = 0x7FF;
    let shift = 64 - 53;
    let shift_u64 = shift as u64;
    let min_exp = -(1074 + shift);

    let raw_mantissa = bits & mantissa_mask;
    let raw_exp = (bits >> 52 & exp_mask) as i32;

    if raw_exp == 0 {
        if raw_mantissa == 0 {
            return UnpackResult { mantissa: 0, exponent: 0 };
        }
        let m = raw_mantissa << shift_u64;
        let e = min_exp;
        let s = (64 - u64_bit_len(m)) as u64;
        return UnpackResult { mantissa: m << s, exponent: e - s as i32 };
    }

    let m = 0x8000000000000000 | raw_mantissa << shift_u64;
    let e = raw_exp - 1 + min_exp;
    return UnpackResult { mantissa: m, exponent: e };
}

// unpack32 returns (mantissa, exponent) such that f = mantissa * 2^exponent
// The mantissa is left-aligned in 64 bits (top 24 bits significant).
pub fn unpack32(f: f32) -> UnpackResult {
    let bits = f.to_bits() as u32;

    let mantissa_mask: u32 = 0x007FFFFF;
    let exp_mask: u32 = 0xFF;
    let shift = 64 - 24;
    let shift_u64 = shift as u64;
    let min_exp = -(149 + shift);

    let raw_mantissa = (bits & mantissa_mask) as u64;
    let raw_exp = (bits >> 23 & exp_mask) as i32;

    if raw_exp == 0 {
        if raw_mantissa == 0 {
            return UnpackResult { mantissa: 0, exponent: 0 };
        }
        let m = raw_mantissa << shift_u64;
        let e = min_exp;
        let s = (64 - u64_bit_len(m)) as u64;
        return UnpackResult { mantissa: m << s, exponent: e - s as i32 };
    }

    let m = 0x8000000000000000 | raw_mantissa << shift_u64;
    let e = raw_exp - 1 + min_exp;
    return UnpackResult { mantissa: m, exponent: e };
}

pub fn unrounded_floor(u: u64) -> u64 {
    return u + 0 >> 2;
}

pub fn unrounded_round(u: u64) -> u64 {
    return u + 1 + (u >> 2 & 1) >> 2;
}

pub fn unrounded_ceil(u: u64) -> u64 {
    return u + 3 >> 2;
}

pub fn unrounded_nudge(u: u64, delta: i32) -> u64 {
    return (u as i64 + delta as i64) as u64;
}

pub fn unrounded_div(u: u64, d: u64) -> u64 {
    let q = u / d;
    let r = u % d;
    return q | u & 1 | (r != 0) as u64;
}

pub struct PmHiLo {
    pub hi: u64,
    pub lo: u64,
}

// Small pow10 tables: decompose 10^p into coarse (every 27th power) * fine (0..26)
// This replaces the large 696-entry table with 26+27 entries + runtime multiplication.
// Tables are implemented as functions for better Wasm optimization.

fn pow10_coarse(i: i32) -> PmHiLo {
    return match i {
        0 => PmHiLo { hi: 0x8049a4ac0c5811af, lo: 0xdfa4769288829d87 },
        1 => PmHiLo { hi: 0xcf42894a5dce35eb, lo: 0xadf9b3537d798a46 },
        2 => PmHiLo { hi: 0xa76c582338ed2622, lo: 0x50d50d47f5090db1 },
        3 => PmHiLo { hi: 0x873e4f75e2224e69, lo: 0xa588bb5917fb5d6e },
        4 => PmHiLo { hi: 0xda7f5bf590966849, lo: 0x50c65b8aaf957661 },
        5 => PmHiLo { hi: 0xb080392cc4349ded, lo: 0x427286b26955304c },
        6 => PmHiLo { hi: 0x8e938662882af53f, lo: 0xab814b848d7d1163 },
        7 => PmHiLo { hi: 0xe65829b3046b0afb, lo: 0xf34b5a5ceed5aeed },
        8 => PmHiLo { hi: 0xba121a4650e4ddec, lo: 0x6d0cb29d9e931bec },
        9 => PmHiLo { hi: 0x964e858c91ba2656, lo: 0xc595f8072aef0790 },
        10 => PmHiLo { hi: 0xf2d56790ab41c2a3, lo: 0x051d8d66bdc0463c },
        11 => PmHiLo { hi: 0xc428d05aa4751e4d, lo: 0x55681eb3c3d94779 },
        12 => PmHiLo { hi: 0x9e74d1b791e07e49, lo: 0x88a15d9b30aacb82 },
        13 => PmHiLo { hi: 0x8000000000000000, lo: 0x0000000000000000 },
        14 => PmHiLo { hi: 0xcecb8f27f4200f3a, lo: 0x0000000000000000 },
        15 => PmHiLo { hi: 0xa70c3c40a64e6c52, lo: 0x666f6f49a09826dc },
        16 => PmHiLo { hi: 0x86f0ac99b4e8dafe, lo: 0x965fd744c2128e5c },
        17 => PmHiLo { hi: 0xda01ee641a708dea, lo: 0x17f190b7df336b6a },
        18 => PmHiLo { hi: 0xb01ae745b101e9e5, lo: 0xa13fa23008d18070 },
        19 => PmHiLo { hi: 0x8e41ade9fbebc27e, lo: 0xeba770ec417b8cf8 },
        20 => PmHiLo { hi: 0xe5d3ef282a242e82, lo: 0x70e9973757925a05 },
        21 => PmHiLo { hi: 0xb9a74a0637ce2ee2, lo: 0x926ac1d428e8c96d },
        22 => PmHiLo { hi: 0x95f83d0a1fb69cda, lo: 0xb54250efea9b0671 },
        23 => PmHiLo { hi: 0xf24a01a73cf2dcd0, lo: 0x439cc4c698c37313 },
        24 => PmHiLo { hi: 0xc3b8358109e84f08, lo: 0xf579d07f13b8ff37 },
        25 => PmHiLo { hi: 0x9e19db92b4e31baa, lo: 0x93f85d3d957cb92e },
        _ => unreachable(),
    };
}

fn pow10_fine(i: i32) -> u64 {
    return match i {
        0 => 0x8000000000000000,
        1 => 0xa000000000000000,
        2 => 0xc800000000000000,
        3 => 0xfa00000000000000,
        4 => 0x9c40000000000000,
        5 => 0xc350000000000000,
        6 => 0xf424000000000000,
        7 => 0x9896800000000000,
        8 => 0xbebc200000000000,
        9 => 0xee6b280000000000,
        10 => 0x9502f90000000000,
        11 => 0xba43b74000000000,
        12 => 0xe8d4a51000000000,
        13 => 0x9184e72a00000000,
        14 => 0xb5e620f480000000,
        15 => 0xe35fa931a0000000,
        16 => 0x8e1bc9bf04000000,
        17 => 0xb1a2bc2ec5000000,
        18 => 0xde0b6b3a76400000,
        19 => 0x8ac7230489e80000,
        20 => 0xad78ebc5ac620000,
        21 => 0xd8d726b7177a8000,
        22 => 0x878678326eac9000,
        23 => 0xa968163f0a57b400,
        24 => 0xd3c21bcecceda100,
        25 => 0x84595161401484a0,
        26 => 0xa56fa5b99019a5c8,
        _ => unreachable(),
    };
}

// mul_pow10 computes the PmHiLo representation of 10^p by decomposing
// p = q*K + r (where K=27) and multiplying coarse[q] * fine[r].
fn mul_pow10(p: i32) -> PmHiLo {
    let K = 27;
    let Q_MIN = -13;

    // Euclidean division: q and r such that p = q*K + r, 0 <= r < K
    let mut q = p / K;
    let mut r = p % K;
    if r < 0 {
        q = q - 1;
        r = r + K;
    }

    let c = pow10_coarse(q - Q_MIN);
    let f = pow10_fine(r);

    // Convert PmHiLo to raw u128 value: val = c.hi * 2^64 - c.lo
    // Represented as two u64 words [c_lo_raw, c_hi_raw]
    let borrow = (c.lo != 0) as u64;
    let c_hi_raw = c.hi - borrow;
    let c_lo_raw = 0 as u64 - c.lo;

    // Product = (c_hi_raw * 2^64 + c_lo_raw) * f
    // a1 = c_hi_raw * f → [lo, hi]
    let [a1_lo_i, a1_hi_i] = builtin::i64_mul_wide_u(c_hi_raw as i64, f as i64);
    let a1_lo = a1_lo_i as u64;
    let a1_hi = a1_hi_i as u64;

    // a0 = c_lo_raw * f → [lo, hi]
    let [a0_lo_i, a0_hi_i] = builtin::i64_mul_wide_u(c_lo_raw as i64, f as i64);
    let a0_lo = a0_lo_i as u64;
    let a0_hi = a0_hi_i as u64;

    // top_128 = a1 + (a0 >> 64) = a1 + a0_hi
    let sum_lo = a1_lo + a0_hi;
    let carry1 = (sum_lo < a1_lo) as u64;
    let mut top_lo = sum_lo;
    let mut top_hi = a1_hi + carry1;

    // Round up if not exact (matching generator convention)
    if a0_lo != 0 {
        top_lo = top_lo + 1;
        if top_lo == 0 {
            top_hi = top_hi + 1;
        }
    }

    // Normalize: ensure bit 127 is set (top_hi bit 63)
    if top_hi >> 63 == 0 {
        top_hi = top_hi << 1 | top_lo >> 63;
        top_lo = top_lo << 1;
    }

    // Convert back to PmHiLo (hi<<64 - lo)
    if top_lo != 0 {
        return PmHiLo { hi: top_hi + 1, lo: 0 as u64 - top_lo };
    }
    return PmHiLo { hi: top_hi, lo: 0 };
}

pub fn get_pow10(p: i32) -> PmHiLo {
    return mul_pow10(p);
}

// uscale computes unround(x * 2^e * 10^p) using the pow10 table
pub fn uscale(x: u64, pm_hi: u64, pm_lo: u64, s: i32) -> u64 {
    // Note: i64_mul_wide_u returns [low, high] but Go's bits.Mul64 returns (high, low)
    let [mid_i64, hi_tmp] = builtin::i64_mul_wide_u(x as i64, pm_hi as i64);
    let mid = mid_i64 as u64;
    let mut hi = hi_tmp as u64;

    let mut sticky = 1 as u64;

    let s_mod_64 = (s & 63) as u64;
    let check_mask = (1 as u64 << s_mod_64) - 1;
    if hi & check_mask == 0 {
        // Go: mid2, _ := bits.Mul64(x, pm_lo) → mid2=high part, _=low part
        // Wado: [_, mid2] = i64_mul_wide_u(x, pm_lo) → _=low part, mid2=high part
        let [_, mid2_i64] = builtin::i64_mul_wide_u(x as i64, pm_lo as i64);
        let mid2 = mid2_i64 as u64;
        sticky = (mid - mid2 > 1) as u64;
        hi = hi - (mid < mid2) as u64;
    }

    return hi >> s as u64 | sticky;
}

// Result of formatting
pub struct FormatResult {
    pub digits: u64,
    pub exponent: i32,
}

// FixedWidth returns the n-digit decimal form of f
pub fn fixed_width(f: f64, n: i32) -> FormatResult {
    assert n <= 18, "digits must be <= 18";

    let unpack = unpack64(f);
    let m = unpack.mantissa;
    let e = unpack.exponent;

    let p = n - 1 - log10_pow2(e + 63);
    let lp = log2_pow10(p);
    let pm = get_pow10(p);
    let s = -(e + lp + 3);

    let u = uscale(m, pm.hi, pm.lo, s);
    let mut d = unrounded_round(u);

    if d >= pow10(n) {
        d = unrounded_round(unrounded_div(u, 10));
        return FormatResult { digits: d, exponent: -p + 1 };
    }

    return FormatResult { digits: d, exponent: -p };
}

// Compute fixed_width result for fixed-point formatting with given precision.
// Combines decimal position estimation and digit computation in a single function,
// sharing the unpack64 call. This avoids the expensive short() + fixed_width() two-pass.
// Cost: 1×unpack64 + 2×get_pow10 + 2×uscale (vs 2×unpack64 + 2×get_pow10 + 3-4×uscale)
pub fn fixed_width_for_prec(f: f64, precision: i32) -> FormatResult {
    let unpack = unpack64(f);
    let m = unpack.mantissa;
    let e = unpack.exponent;

    // Phase 1: Determine exact decimal position using floor of 1-digit scaling.
    // log10_pow2(e+63) approximates floor(log10(f)) but may underestimate by 1.
    // One uscale + floor check resolves the ambiguity exactly.
    let log10_e63 = log10_pow2(e + 63);
    let p1 = -log10_e63;
    let lp1 = log2_pow10(p1);
    let pm1 = get_pow10(p1);
    let s1 = -(e + lp1 + 3);
    let u1 = uscale(m, pm1.hi, pm1.lo, s1);
    let d1_floor = unrounded_floor(u1);
    let decimal_pos = if d1_floor >= 10 { 2 - p1 } else { 1 - p1 };

    // Phase 2: Compute fixed_width(f, n) reusing the unpacked mantissa and exponent.
    // Use decimal_pos directly: for numbers < 1.0 (decimal_pos <= 0), the leading "0."
    // is not a significant digit, so we need exactly (decimal_pos + precision) digits.
    let total_digits = decimal_pos + precision;
    let n = if total_digits > 18 {
        18;
    } else if total_digits < 1 {
        1;
    } else {
        total_digits;
    };

    let p = n - 1 - log10_e63;
    let lp = log2_pow10(p);
    let pm = get_pow10(p);
    let s = -(e + lp + 3);
    let u = uscale(m, pm.hi, pm.lo, s);
    let mut d = unrounded_round(u);
    if d >= pow10(n) {
        d = unrounded_round(unrounded_div(u, 10));
        return FormatResult { digits: d, exponent: -p + 1 };
    }
    return FormatResult { digits: d, exponent: -p };
}

// Short computes the shortest formatting of f that round-trips
pub fn short(f: f64) -> FormatResult {
    let min_exp = -1085;

    let unpack = unpack64(f);
    let m = unpack.mantissa;
    let e = unpack.exponent;

    let mut min_m: u64 = 0;
    let mut z = 11;
    let mut p: i32 = 0;

    let m_is_power_of_2 = m == 0x8000000000000000;
    if m_is_power_of_2 && e > min_exp {
        p = -skewed(e + z);
        min_m = m - (1 as u64 << (z - 2) as u64);
    } else {
        if e < min_exp {
            z = 11 + (min_exp - e);
        }
        p = -log10_pow2(e + z);
        min_m = m - (1 as u64 << (z - 1) as u64);
    }

    let max_m = m + (1 as u64 << (z - 1) as u64);
    let odd = (m >> z as u64 & 1) as i32;

    let lp = log2_pow10(p);
    let pm = get_pow10(p);
    let s = -(e + lp + 3);

    let dmin = unrounded_ceil(unrounded_nudge(uscale(min_m, pm.hi, pm.lo, s), odd));
    let dmax = unrounded_floor(unrounded_nudge(uscale(max_m, pm.hi, pm.lo, s), -odd));

    // Check if we can trim to fewer digits
    let d_div_10 = dmax / 10;
    let can_trim = d_div_10 * 10 >= dmin;

    if can_trim {
        let [digits, exponent] = trim_zeros(d_div_10, -(p - 1));
        return FormatResult { digits, exponent };
    }

    let mut d = dmin;
    if dmin < dmax {
        d = unrounded_round(uscale(m, pm.hi, pm.lo, s));
    }
    return FormatResult { digits: d, exponent: -p };
}

// short32 computes the shortest formatting of f32 that round-trips through f32.
// Uses f32's 24-bit mantissa (z=40) instead of f64's 53-bit mantissa (z=11).
pub fn short32(f: f32) -> FormatResult {
    let min_exp = -189;

    let unpack = unpack32(f);
    let m = unpack.mantissa;
    let e = unpack.exponent;

    let mut min_m: u64 = 0;
    let mut z = 40;
    let mut p: i32 = 0;

    let m_is_power_of_2 = m == 0x8000000000000000;
    if m_is_power_of_2 && e > min_exp {
        p = -skewed(e + z);
        min_m = m - (1 as u64 << (z - 2) as u64);
    } else {
        if e < min_exp {
            z = 40 + (min_exp - e);
        }
        p = -log10_pow2(e + z);
        min_m = m - (1 as u64 << (z - 1) as u64);
    }

    let max_m = m + (1 as u64 << (z - 1) as u64);
    let odd = (m >> z as u64 & 1) as i32;

    let lp = log2_pow10(p);
    let pm = get_pow10(p);
    let s = -(e + lp + 3);

    let dmin = unrounded_ceil(unrounded_nudge(uscale(min_m, pm.hi, pm.lo, s), odd));
    let dmax = unrounded_floor(unrounded_nudge(uscale(max_m, pm.hi, pm.lo, s), -odd));

    let d_div_10 = dmax / 10;
    let can_trim = d_div_10 * 10 >= dmin;

    if can_trim {
        let [digits, exponent] = trim_zeros(d_div_10, -(p - 1));
        return FormatResult { digits, exponent };
    }

    let mut d = dmin;
    if dmin < dmax {
        d = unrounded_round(uscale(m, pm.hi, pm.lo, s));
    }
    return FormatResult { digits: d, exponent: -p };
}

pub fn skewed(e: i32) -> i32 {
    return e * 631305 - 261663 >> 21;
}

// Unsigned multiply (low 64 bits only, modular)
pub fn u64_mul(a: u64, b: u64) -> u64 {
    // Use wide multiply and take the low part
    let [lo, _] = builtin::i64_mul_wide_u(a as i64, b as i64);
    return lo as u64;  // Low 64 bits
}

pub fn trim_zeros(x: u64, p: i32) -> [u64, i32] {
    let inv5: u64 = 0xcccccccccccccccd;
    let inv5p2: u64 = 0x8f5c28f5c28f5c29;
    let inv5p4: u64 = 0xd288ce703afb7e91;
    let inv5p8: u64 = 0xc767074b22e90e21;

    // Threshold values
    let thresh_10: u64 = 1844674407370955161;  // maxUint64 / 10
    let thresh_100: u64 = 184467440737095516;  // maxUint64 / 100
    let thresh_10000: u64 = 1844674407370955;  // maxUint64 / 10000
    let thresh_1e8: u64 = 184467440737;  // maxUint64 / 100000000

    let mut xv = x;
    let mut pv = p;

    let d1 = rotate_right(u64_mul(xv, inv5), 1);
    if d1 <= thresh_10 {
        xv = d1;
        pv = pv + 1;
    } else {
        return [xv, pv];
    }

    let d8 = rotate_right(u64_mul(xv, inv5p8), 8);
    if d8 <= thresh_1e8 {
        xv = d8;
        pv = pv + 8;
    }

    let d4 = rotate_right(u64_mul(xv, inv5p4), 4);
    if d4 <= thresh_10000 {
        xv = d4;
        pv = pv + 4;
    }

    let d2 = rotate_right(u64_mul(xv, inv5p2), 2);
    if d2 <= thresh_100 {
        xv = d2;
        pv = pv + 2;
    }

    let d1b = rotate_right(u64_mul(xv, inv5), 1);
    if d1b <= thresh_10 {
        xv = d1b;
        pv = pv + 1;
    }

    return [xv, pv];
}

pub fn rotate_right(x: u64, n: u64) -> u64 {
    return x >> n | x << 64 - n;
}

// digits returns the number of decimal digits in d
pub fn digits(d: u64) -> i32 {
    let nd = log10_pow2(u64_bit_len(d));
    return nd + (d >= pow10(nd)) as i32;
}

fn i2a_first(n: i32) -> char {
    return char::from_u32_unchecked('0' as u32 + (n / 10) as u32);
}

fn i2a_second(n: i32) -> char {
    return char::from_u32_unchecked('0' as u32 + (n % 10) as u32);
}

// Write nd decimal digits of val into buf at offset, right-to-left using set_byte.
// buf must already have space (pre-filled with '0' chars).
fn write_digits_at(buf: &mut String, offset: i32, val: u64, nd: i32) {
    let mut v = val;
    let mut idx = offset + nd - 1;
    while idx >= offset {
        buf.set_byte(idx, '0' as u8 + (v % 10) as u8);
        v = v / 10;
        idx = idx - 1;
    }
}

// Pre-fill n characters of '0' into buf using array.fill (fast bulk operation)
fn fill_zeros(buf: &mut String, n: i32) {
    buf.append_byte_filled('0' as u8, n);
}

// Write decimal representation directly into buf (appends to existing content).
pub fn write_decimal(buf: &mut String, d: u64, p: i32, nd: i32) {
    let decimal_pos = nd + p;

    if decimal_pos <= 0 {
        // Need leading zeros: 0.00...digits
        buf.push_str("0.");
        fill_zeros(buf, -decimal_pos);
        let digit_offset = buf.len();
        fill_zeros(buf, nd);
        write_digits_at(buf, digit_offset, d, nd);
    } else if decimal_pos >= nd {
        // Integer with trailing zeros: digits000...
        let start = buf.len();
        fill_zeros(buf, nd);
        write_digits_at(buf, start, d, nd);
        fill_zeros(buf, decimal_pos - nd);
    } else {
        // Decimal point in the middle: dig.its
        let start = buf.len();
        fill_zeros(buf, nd + 1);
        write_digits_at(buf, start, d, nd);
        // Shift fractional part right by 1 and insert '.'
        let raw = buf.internal_raw_bytes();
        builtin::array_copy(raw, start + decimal_pos + 1, raw, start + decimal_pos, nd - decimal_pos);
        buf.set_byte(start + decimal_pos, '.' as u8);
    }
}

// Format result to decimal string (no exponent)
pub fn format_decimal(d: u64, p: i32, nd: i32) -> String {
    let decimal_pos = nd + p;
    let total = if decimal_pos <= 0 {
        2 + -decimal_pos + nd;
    } else if decimal_pos >= nd {
        decimal_pos;
    } else {
        nd + 1;
    };
    let mut buf = String::with_capacity(total);
    write_decimal(&mut buf, d, p, nd);
    return buf;
}

// Write exponential representation directly into buf (appends to existing content).
pub fn write_exp(buf: &mut String, d: u64, p: i32, nd: i32, upper: bool) {
    let exp = p + nd - 1;

    // Write digits: first digit, then '.' and rest
    if nd > 1 {
        let start = buf.len();
        fill_zeros(buf, nd + 1);
        write_digits_at(buf, start, d, nd);
        let raw = buf.internal_raw_bytes();
        builtin::array_copy(raw, start + 2, raw, start + 1, nd - 1);
        buf.set_byte(start + 1, '.' as u8);
    } else {
        let start = buf.len();
        fill_zeros(buf, 1);
        write_digits_at(buf, start, d, 1);
    }

    // Exponent
    buf.push_str(if upper { "E" } else { "e" });
    if exp < 0 {
        buf.push_str("-");
    }

    let abs_exp = if exp < 0 { -exp } else { exp };
    if abs_exp < 10 {
        buf.push(char::from_u32_unchecked('0' as u32 + abs_exp as u32));
    } else if abs_exp < 100 {
        buf.push(i2a_first(abs_exp));
        buf.push(i2a_second(abs_exp));
    } else {
        buf.push(char::from_u32_unchecked('0' as u32 + (abs_exp / 100) as u32));
        buf.push(i2a_first(abs_exp % 100));
        buf.push(i2a_second(abs_exp % 100));
    }
}

// Format result to exponential string (upper: true for 'E', false for 'e')
pub fn format_exp(d: u64, p: i32, nd: i32, upper: bool) -> String {
    let mut buf = String::with_capacity(30);
    write_exp(&mut buf, d, p, nd, upper);
    return buf;
}


// Write decimal with specified precision directly into buf (appends to existing content).
pub fn write_decimal_prec(buf: &mut String, d: u64, p: i32, nd: i32, precision: i32) {
    if precision < 0 {
        write_decimal(buf, d, p, nd);
        return;
    }

    let decimal_pos = nd + p;

    if decimal_pos <= 0 {
        let leading_zeros = -decimal_pos;
        buf.push_str("0.");
        if precision <= leading_zeros {
            fill_zeros(buf, precision);
            return;
        }
        fill_zeros(buf, leading_zeros);
        let remaining_prec = precision - leading_zeros;
        let digits_to_output = if remaining_prec < nd { remaining_prec } else { nd };
        let trailing = precision - leading_zeros - digits_to_output;
        let mut trim_d = d;
        let mut skip = nd - digits_to_output;
        while skip > 0 {
            trim_d = trim_d / 10;
            skip = skip - 1;
        }
        let digit_offset = buf.len();
        fill_zeros(buf, digits_to_output);
        write_digits_at(buf, digit_offset, trim_d, digits_to_output);
        fill_zeros(buf, trailing);
    } else if decimal_pos >= nd {
        let start = buf.len();
        fill_zeros(buf, nd);
        write_digits_at(buf, start, d, nd);
        fill_zeros(buf, decimal_pos - nd);
        if precision > 0 {
            buf.push_str(".");
            fill_zeros(buf, precision);
        }
    } else {
        let after_decimal = nd - decimal_pos;
        if precision <= after_decimal {
            let output_nd = decimal_pos + precision;
            let mut trim_d = d;
            let mut skip = nd - output_nd;
            while skip > 0 {
                trim_d = trim_d / 10;
                skip = skip - 1;
            }
            let total = output_nd + 1;
            let start = buf.len();
            fill_zeros(buf, total);
            write_digits_at(buf, start, trim_d, output_nd);
            let raw = buf.internal_raw_bytes();
            builtin::array_copy(raw, start + decimal_pos + 1, raw, start + decimal_pos, output_nd - decimal_pos);
            buf.set_byte(start + decimal_pos, '.' as u8);
            return;
        }
        let trailing = precision - after_decimal;
        let start = buf.len();
        fill_zeros(buf, nd + 1);
        write_digits_at(buf, start, d, nd);
        let raw = buf.internal_raw_bytes();
        builtin::array_copy(raw, start + decimal_pos + 1, raw, start + decimal_pos, nd - decimal_pos);
        buf.set_byte(start + decimal_pos, '.' as u8);
        fill_zeros(buf, trailing);
    }
}

/// Format f64 to decimal string with specified precision (digits after decimal point)
/// precision < 0 means use shortest representation
pub fn format_decimal_prec(d: u64, p: i32, nd: i32, precision: i32) -> String {
    let mut buf = String::with_capacity(30);
    write_decimal_prec(&mut buf, d, p, nd, precision);
    return buf;
}

// Write exponential with precision directly into buf (appends to existing content).
pub fn write_exp_prec(buf: &mut String, d: u64, p: i32, nd: i32, precision: i32, upper: bool) {
    if precision < 0 {
        write_exp(buf, d, p, nd, upper);
        return;
    }

    if precision > 0 {
        let available = nd - 1;
        let to_output = if precision < available { precision } else { available };
        let trailing = precision - to_output;
        let digit_count = 1 + to_output;
        let start = buf.len();
        fill_zeros(buf, digit_count + 1);
        let mut trim_d = d;
        let mut skip = nd - digit_count;
        while skip > 0 {
            trim_d = trim_d / 10;
            skip = skip - 1;
        }
        write_digits_at(buf, start, trim_d, digit_count);
        let raw = buf.internal_raw_bytes();
        builtin::array_copy(raw, start + 2, raw, start + 1, digit_count - 1);
        buf.set_byte(start + 1, '.' as u8);
        fill_zeros(buf, trailing);
    } else {
        let start = buf.len();
        fill_zeros(buf, 1);
        let mut first_d = d;
        let mut skip = nd - 1;
        while skip > 0 {
            first_d = first_d / 10;
            skip = skip - 1;
        }
        write_digits_at(buf, start, first_d, 1);
    }

    let exp = p + nd - 1;
    buf.push_str(if upper { "E" } else { "e" });
    if exp < 0 {
        buf.push_str("-");
    }

    let abs_exp = if exp < 0 { -exp } else { exp };
    if abs_exp < 10 {
        buf.push(char::from_u32_unchecked('0' as u32 + abs_exp as u32));
    } else if abs_exp < 100 {
        buf.push(i2a_first(abs_exp));
        buf.push(i2a_second(abs_exp));
    } else {
        buf.push(char::from_u32_unchecked('0' as u32 + (abs_exp / 100) as u32));
        buf.push(i2a_first(abs_exp % 100));
        buf.push(i2a_second(abs_exp % 100));
    }
}

/// Format f64 to exponential string with specified precision (digits after decimal point)
/// precision < 0 means use shortest representation
pub fn format_exp_prec(d: u64, p: i32, nd: i32, precision: i32, upper: bool) -> String {
    let mut buf = String::with_capacity(30);
    write_exp_prec(&mut buf, d, p, nd, precision, upper);
    return buf;
}

// Encodes the kind of special floating-point value detected by check_special.
pub enum SpecialKind {
    NotSpecial,
    Zero,
    Inf,
    NaN,
}

// Check for special floating-point values (zero, infinity, NaN).
// Returns [is_special, is_neg, kind]:
//   is_special: true if f is a special value
//   is_neg:     true if f is negative (for use on either the special or non-special path)
//   kind:       SpecialKind enum (NotSpecial, Zero, Inf, or NaN)
// On the non-special path (is_special=false), kind is SpecialKind::NotSpecial.
pub fn check_special(f: f64) -> [bool, bool, SpecialKind] {
    let bits = f.to_bits();

    // Check for zero
    if bits == 0 {
        return [true, false, SpecialKind::Zero];
    }
    if bits == 0x8000000000000000 as i64 {
        return [true, true, SpecialKind::Zero];
    }

    let is_neg = bits < 0;

    // Check for infinity/NaN
    let exp_mask: i64 = 0x7FF0000000000000;
    if bits & exp_mask == exp_mask {
        let mantissa_mask: i64 = 0x000FFFFFFFFFFFFF;
        if bits & mantissa_mask != 0 {
            return [true, false, SpecialKind::NaN];
        }
        return [true, is_neg, SpecialKind::Inf];
    }

    return [false, is_neg, SpecialKind::NotSpecial];
}

// Convert a SpecialKind to its display string.
// For Inf: returns "Inf" (caller should prepend "-" if is_neg).
// For NaN: returns "NaN".
// For Zero: returns "0".
// pack64 takes (m, e) and returns f = m * 2^e.
// It assumes the caller has provided a 53-bit mantissa m
// and an exponent that is in range for the mantissa.
fn pack64(m: u64, e: i32) -> f64 {
    let bit52 = 1 as u64 << 52;
    if m & bit52 == 0 {
        return f64::from_bits(m as i64);
    }
    let mantissa_bits = m & ~bit52;
    let exp_bits = (1075 + e) as u64 << 52;
    return f64::from_bits((mantissa_bits | exp_bits) as i64);
}

// parse rounds d * 10^p to the nearest f64.
// d must have at most 19 digits.
pub fn parse(d: u64, p: i32) -> f64 {
    let b = u64_bit_len(d);
    let lp = log2_pow10(p);
    let mut e = i32::min(1074, 53 - b - lp);
    let x = d << (64 - b) as u64;
    let pm = get_pow10(p);
    let s_val = -(e - (64 - b) + lp + 3);
    let mut u = uscale(x, pm.hi, pm.lo, s_val);

    // Branch-free: if round(u) >= 1<<53, shift right by 1
    let unmin_val = (1 as u64 << 55) - 2;
    let shift = (u >= unmin_val) as u64;
    u = u >> shift | u & 1;
    e = e - shift as i32;

    return pack64(unrounded_round(u), -e);
}

// parse_text_range parses a decimal string slice and returns the nearest
// f64. Parses `s[start..end)` without allocating a substring.
// Returns null if the input is malformed or the range is out of bounds.
// Accepts: optional sign, decimal digits, optional fractional part, optional exponent,
//          "inf"/"infinity" (case-insensitive), "nan" (case-insensitive).
// Rejects: leading dot (".5"), trailing dot ("5."), empty input.
// Examples: "3.14", "1e2", "0.5", "123", "+1.5e-3", "-42", "inf", "NaN"
pub fn parse_text_range(s: &String, start: i32, end: i32) -> Option<f64> {
    // Bounds check keeps the public surface total: an out-of-range slice
    // is treated the same as malformed input.
    if start < 0 || end > s.len() || start >= end {
        return null;
    }
    let len = end;

    // Parse optional sign
    let mut sign = 1.0;
    let mut i = start;
    let first = s.get_byte(start);
    if first == '-' as u8 {
        sign = -1.0;
        i = start + 1;
    } else if first == '+' as u8 {
        i = start + 1;
    }

    if i >= len {
        return null;
    }

    // Check for special values (case-insensitive)
    let remaining = len - i;
    let c0 = s.get_byte(i);

    // "inf" or "infinity"
    if (c0 == 'i' as u8 || c0 == 'I' as u8) && remaining >= 3 {
        let c1 = s.get_byte(i + 1);
        let c2 = s.get_byte(i + 2);
        if (c1 == 'n' as u8 || c1 == 'N' as u8) && (c2 == 'f' as u8 || c2 == 'F' as u8) {
            if remaining == 3 {
                return Option::Some(builtin::f64_copysign(f64::INFINITY, sign));
            }
            if remaining == 8 {
                let c3 = s.get_byte(i + 3);
                let c4 = s.get_byte(i + 4);
                let c5 = s.get_byte(i + 5);
                let c6 = s.get_byte(i + 6);
                let c7 = s.get_byte(i + 7);
                if (c3 == 'i' as u8 || c3 == 'I' as u8)
                    && (c4 == 'n' as u8 || c4 == 'N' as u8)
                    && (c5 == 'i' as u8 || c5 == 'I' as u8)
                    && (c6 == 't' as u8 || c6 == 'T' as u8)
                    && (c7 == 'y' as u8 || c7 == 'Y' as u8) {
                    return Option::Some(builtin::f64_copysign(f64::INFINITY, sign));
                }
            }
        }
        return null;
    }

    // "nan" (sign is ignored for NaN)
    if (c0 == 'n' as u8 || c0 == 'N' as u8) && remaining == 3 {
        let c1 = s.get_byte(i + 1);
        let c2 = s.get_byte(i + 2);
        if (c1 == 'a' as u8 || c1 == 'A' as u8) && (c2 == 'n' as u8 || c2 == 'N' as u8) {
            return Option::Some(f64::NAN);
        }
        return null;
    }

    // Parse decimal number
    let MAX_DIGITS = 19;
    let mut d: u64 = 0;
    let mut frac = 0;
    let digit_start = i;

    // Read integer digits
    for ; i < len && s.get_byte(i) >= '0' as u8 && s.get_byte(i) <= '9' as u8; i += 1 {
        d = d * 10 + (s.get_byte(i) - '0' as u8) as u64;
    }
    let int_digits = i - digit_start;

    // Read fractional digits
    if i < len && s.get_byte(i) == '.' as u8 {
        if int_digits == 0 {
            return null;  // leading dot not allowed
        }
        i += 1;
        let frac_start = i;
        for ; i < len && s.get_byte(i) >= '0' as u8 && s.get_byte(i) <= '9' as u8; i += 1 {
            d = d * 10 + (s.get_byte(i) - '0' as u8) as u64;
            frac += 1;
        }
        if i == frac_start {
            return null;  // trailing dot not allowed
        }
    }

    let total_digits = int_digits + frac;
    if total_digits == 0 || total_digits > MAX_DIGITS {
        return null;
    }

    // Read exponent
    let mut p = 0;
    if i < len && (s.get_byte(i) == 'e' as u8 || s.get_byte(i) == 'E' as u8) {
        i += 1;
        let mut exp_sign = 1;
        if i < len {
            if s.get_byte(i) == '-' as u8 {
                exp_sign = -1;
                i += 1;
            } else if s.get_byte(i) == '+' as u8 {
                i += 1;
            }
        }
        let exp_start = i;
        if i >= len || len - i > 3 {
            return null;
        }
        for ; i < len && s.get_byte(i) >= '0' as u8 && s.get_byte(i) <= '9' as u8; i += 1 {
            p = p * 10 + (s.get_byte(i) - '0' as u8) as i32;
        }
        if i == exp_start {
            return null;
        }
        p = p * exp_sign;
    }

    if i != len {
        return null;
    }

    // Handle d == 0 (preserve negative zero)
    if d == 0 {
        return Option::Some(builtin::f64_copysign(0.0, sign));
    }

    // Handle overflow/underflow for extreme exponents.
    // The pow10 table supports [-351, 350]; beyond that, result is definitely inf or 0.
    let eff_p = p - frac;
    if eff_p > 350 {
        return Option::Some(builtin::f64_copysign(f64::INFINITY, sign));
    }
    if eff_p < -351 {
        return Option::Some(builtin::f64_copysign(0.0, sign));
    }

    let val = parse(d, eff_p);
    return Option::Some(builtin::f64_copysign(val, sign));
}
