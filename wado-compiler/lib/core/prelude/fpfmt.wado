#![no_prelude]
#![stdlib("core:prelude/fpfmt.wado")]
// Float-to-String conversion using Russ Cox's unrounded scaling algorithm
// Ported from rsc.io/fpfmt (https://research.swtch.com/fp)
//
// Copyright 2025 The Go Authors. All rights reserved.
// Use of this source code is governed by a BSD-style license.
// See https://github.com/rsc/fpfmt/blob/main/LICENSE
//
// Functions stay `pub` (not `internal` like the other prelude submodules)
// because fpfmt_test.wado / fpfmt_comprehensive_test.wado are white-box test
// entry modules in the Root package that import these helpers directly across
// the package boundary.

use { String, StrSlice } from "core:prelude/string.wado";
use { List } from "core:prelude/list.wado";
use { Option } from "core:prelude/types.wado";
use { ByteSlice } from "core:prelude/bytes.wado";


// The f64 bit pattern of -0.0: the sign bit alone.
global NEG_ZERO_BITS: u64 = 0x8000000000000000;

// Powers of 10 from 10^0 to 10^19
global POW10: List<u64> = [
    1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000, 10000000000, 100000000000, 1000000000000,
    10000000000000, 100000000000000, 1000000000000000, 10000000000000000, 100000000000000000, 1000000000000000000,
    10000000000000000000,
];

pub fn pow10(n: i32) -> u64 {
    return POW10[n];
}

// Returns the bit length of x (position of highest set bit + 1)
pub fn u64_bit_len(x: u64) -> i32 {
    return 64 - builtin::i64_clz(x as i64) as i32;
}

// log10_pow2(x) returns floor(log10(2^x)) = floor(x * log10(2))
pub fn log10_pow2(x: i32) -> i32 {
    return x * 78913 >> 18;
}

// log2_pow10(x) returns floor(log2(10^x)) = floor(x * log2(10))
pub fn log2_pow10(x: i32) -> i32 {
    return x * 108853 >> 15;
}

// Result of unpacking a float64
pub struct UnpackResult {
    pub mantissa: u64,
    pub exponent: i32,
}

// unpack64 returns (mantissa, exponent) such that f = mantissa * 2^exponent
pub fn unpack64(f: f64) -> UnpackResult {
    let bits = f.to_bits();

    let mantissa_mask: u64 = 0x000FFFFFFFFFFFFF;
    let exp_mask: u64 = 0x7FF;
    let shift = 64 - 53;
    let shift_u64 = shift as u64;
    let min_exp = -(1074 + shift);

    let raw_mantissa = bits & mantissa_mask;
    let raw_exp = (bits >> 52 & exp_mask) as i32;

    if raw_exp == 0 {
        if raw_mantissa == 0 {
            return UnpackResult { mantissa: 0, exponent: 0 };
        }
        let m = raw_mantissa << shift_u64;
        let e = min_exp;
        let s = (64 - u64_bit_len(m)) as u64;
        return UnpackResult { mantissa: m << s, exponent: e - s as i32 };
    }

    let m = 0x8000000000000000 | raw_mantissa << shift_u64;
    let e = raw_exp - 1 + min_exp;
    return UnpackResult { mantissa: m, exponent: e };
}

// unpack32 returns (mantissa, exponent) such that f = mantissa * 2^exponent
// The mantissa is left-aligned in 64 bits (top 24 bits significant).
pub fn unpack32(f: f32) -> UnpackResult {
    let bits = f.to_bits();

    let mantissa_mask: u32 = 0x007FFFFF;
    let exp_mask: u32 = 0xFF;
    let shift = 64 - 24;
    let shift_u64 = shift as u64;
    let min_exp = -(149 + shift);

    let raw_mantissa = (bits & mantissa_mask) as u64;
    let raw_exp = (bits >> 23 & exp_mask) as i32;

    if raw_exp == 0 {
        if raw_mantissa == 0 {
            return UnpackResult { mantissa: 0, exponent: 0 };
        }
        let m = raw_mantissa << shift_u64;
        let e = min_exp;
        let s = (64 - u64_bit_len(m)) as u64;
        return UnpackResult { mantissa: m << s, exponent: e - s as i32 };
    }

    let m = 0x8000000000000000 | raw_mantissa << shift_u64;
    let e = raw_exp - 1 + min_exp;
    return UnpackResult { mantissa: m, exponent: e };
}

pub fn unrounded_floor(u: u64) -> u64 {
    return u + 0 >> 2;
}

pub fn unrounded_round(u: u64) -> u64 {
    return u + 1 + (u >> 2 & 1) >> 2;
}

pub fn unrounded_ceil(u: u64) -> u64 {
    return u + 3 >> 2;
}

pub fn unrounded_nudge(u: u64, delta: i32) -> u64 {
    return (u as i64 + delta as i64) as u64;
}

pub fn unrounded_div(u: u64, d: u64) -> u64 {
    let q = u / d;
    let r = u % d;
    return q | u & 1 | (r != 0) as u64;
}

pub struct PmHiLo {
    pub hi: u64,
    pub lo: u64,
}

// Small pow10 tables: decompose 10^p into coarse (every 27th power) * fine (0..=26)
// in place of a 696-entry table of 128-bit values.

// The coarse factors, 192 bits each, most significant word first, rounded up:
// at 128 bits the product lands up to 3 units above ⌈10^p⌉, `uscale` takes 1.
global POW10_COARSE: List<u64> = [
    0x8049a4ac0c5811ae, 0x205b896d777d6278, 0xac261e9f5141430c, 0xcf42894a5dce35ea, 0x52064cac828675b9,
    0x475f2b7d7df1ad7b, 0xa76c582338ed2621, 0xaf2af2b80af6f24e, 0x657c8f4d43323a37, 0x873e4f75e2224e68,
    0x5a7744a6e804a291, 0xcc35eddfcf0996d8, 0xda7f5bf590966848, 0xaf39a475506a899e, 0xa30294cc2934e663,
    0xb080392cc4349dec, 0xbd8d794d96aacfb3, 0xfe13a5c86af64419, 0x8e938662882af53e, 0x547eb47b7282ee9c,
    0x41b0230e1421487e, 0xe65829b3046b0afa, 0x0cb4a5a3112a5112, 0xa3b561b1cb208397, 0xba121a4650e4ddeb,
    0x92f34d62616ce413, 0x21a0183e10583cd4, 0x964e858c91ba2655, 0x3a6a07f8d510f86f, 0xe9082f25e9c5e9ed,
    0xf2d56790ab41c2a2, 0xfae27299423fb9c3, 0x3695dad7e8858902, 0xc428d05aa4751e4c, 0xaa97e14c3c26b886,
    0x96842dc95323f5a9, 0x9e74d1b791e07e48, 0x775ea264cf55347d, 0xca49f1c05120c9c8, 0x8000000000000000,
    0x0000000000000000, 0x0000000000000000, 0xcecb8f27f4200f3a, 0x0000000000000000, 0x0000000000000000,
    0xa70c3c40a64e6c51, 0x999090b65f67d924, 0x0000000000000000, 0x86f0ac99b4e8dafd, 0x69a028bb3ded71a3,
    0xdf9f915627c04e28, 0xda01ee641a708de9, 0xe80e6f4820cc9495, 0xd74baad03bc1d8d4, 0xb01ae745b101e9e4,
    0x5ec05dcff72e7f8f, 0xc04c79ffe3243020, 0x8e41ade9fbebc27d, 0x14588f13be847307, 0x23bd6a2059c002f6,
    0xe5d3ef282a242e81, 0x8f1668c8a86da5fa, 0xf0b5ccf5176ecc7d, 0xb9a74a0637ce2ee1, 0x6d953e2bd7173692,
    0x88efb0037ac08bdf, 0x95f83d0a1fb69cd9, 0x4abdaf101564f98e, 0x0d5a4af7b3a98e48, 0xf24a01a73cf2dccf,
    0xbc633b39673c8cec, 0x3d9c44cd2f36917d, 0xc3b8358109e84f07, 0x0a862f80ec4700c8, 0x02606ea01029dc38,
    0x9e19db92b4e31ba9, 0x6c07a2c26a8346d1, 0x4944d9f52cd0dec3,
];

// The fine factors are an indexed load, not a `match`: the jump table a 27-arm
// match lowers to costs an unpredictable indirect branch on the hot path.
global POW10_FINE: List<u64> = [
    0x8000000000000000, 0xa000000000000000, 0xc800000000000000, 0xfa00000000000000, 0x9c40000000000000,
    0xc350000000000000, 0xf424000000000000, 0x9896800000000000, 0xbebc200000000000, 0xee6b280000000000,
    0x9502f90000000000, 0xba43b74000000000, 0xe8d4a51000000000, 0x9184e72a00000000, 0xb5e620f480000000,
    0xe35fa931a0000000, 0x8e1bc9bf04000000, 0xb1a2bc2ec5000000, 0xde0b6b3a76400000, 0x8ac7230489e80000,
    0xad78ebc5ac620000, 0xd8d726b7177a8000, 0x878678326eac9000, 0xa968163f0a57b400, 0xd3c21bcecceda100,
    0x84595161401484a0, 0xa56fa5b99019a5c8,
];

fn pow10_fine(i: i32) -> u64 {
    return POW10_FINE[i];
}

// Coarse/fine split of the pow10 decomposition; see mul_pow10.
global POW10_K: i32 = 27;

// mul_pow10 computes the PmHiLo representation of ceil(10^p), normalized to
// 128 bits, by decomposing p = q*K + r (where K=27) into coarse[q] * fine[r].
pub fn mul_pow10(p: i32) -> PmHiLo {
    let K = POW10_K;
    let Q_MIN = -13;

    // Euclidean division: q and r such that p = q*K + r, 0 <= r < K
    let mut q = p / K;
    let mut r = p % K;
    if r < 0 {
        q = q - 1;
        r = r + K;
    }

    let at = (q - Q_MIN) * 3;
    let f = pow10_fine(r) as i64;
    let [p2_lo, p2_hi] = builtin::i64_mul_wide_u(POW10_COARSE[at] as i64, f);
    let [p1_lo, p1_hi] = builtin::i64_mul_wide_u(POW10_COARSE[at + 1] as i64, f);
    let [p0_lo, p0_hi] = builtin::i64_mul_wide_u(POW10_COARSE[at + 2] as i64, f);

    // The 256-bit product, least significant word first.
    let w0 = p0_lo as u64;
    let w1 = p1_lo as u64 + p0_hi as u64;
    let c1 = (w1 < p1_lo as u64) as u64;
    let s2 = p2_lo as u64 + p1_hi as u64;
    let w2 = s2 + c1;
    let c2 = (s2 < p2_lo as u64) as u64 + (w2 < s2) as u64;
    let mut w3 = p2_hi as u64 + c2;
    let mut top_lo = w2;
    let mut below = w1 | w0;

    // Normalize: ensure bit 255 is set, pulling the next bit up from below.
    if w3 >> 63 == 0 {
        w3 = w3 << 1 | w2 >> 63;
        top_lo = w2 << 1 | w1 >> 63;
        below = w1 << 1 | w0;
    }

    // Round the top 128 bits up where anything below them is set.
    let mut top_hi = w3;
    if below != 0 {
        top_lo = top_lo + 1;
        if top_lo == 0 {
            top_hi = top_hi + 1;
        }
    }

    // Convert back to PmHiLo (hi<<64 - lo)
    if top_lo != 0 {
        return PmHiLo { hi: top_hi + 1, lo: 0 as u64 - top_lo };
    }
    return PmHiLo { hi: top_hi, lo: 0 };
}

pub fn get_pow10(p: i32) -> PmHiLo {
    // For 0 <= p < K the coarse factor is 10^0, so mul_pow10's 128-bit product
    // reduces to the fine entry itself. Formatting a value with a precision
    // takes this path twice per conversion, so the shortcut is the hot one.
    if p >= 0 && p < POW10_K {
        return PmHiLo { hi: pow10_fine(p), lo: 0 };
    }
    return mul_pow10(p);
}

// uscale computes unround(x * 2^e * 10^p) using the pow10 table
pub fn uscale(x: u64, pm_hi: u64, pm_lo: u64, s: i32) -> u64 {
    // Note: i64_mul_wide_u returns [low, high] but Go's bits.Mul64 returns (high, low)
    let [mid_i64, hi_tmp] = builtin::i64_mul_wide_u(x as i64, pm_hi as i64);
    let mid = mid_i64 as u64;
    let mut hi = hi_tmp as u64;

    let mut sticky = 1 as u64;

    let s_mod_64 = (s & 63) as u64;
    let check_mask = (1 as u64 << s_mod_64) - 1;
    if hi & check_mask == 0 {
        // Go: mid2, _ := bits.Mul64(x, pm_lo) → mid2=high part, _=low part
        // Wado: [_, mid2] = i64_mul_wide_u(x, pm_lo) → _=low part, mid2=high part
        let [_, mid2_i64] = builtin::i64_mul_wide_u(x as i64, pm_lo as i64);
        let mid2 = mid2_i64 as u64;
        sticky = (mid - mid2 > 1) as u64;
        hi = hi - (mid < mid2) as u64;
    }

    return hi >> s as u64 | sticky;
}

// Result of formatting
pub struct FormatResult {
    pub digits: u64,
    pub exponent: i32,
    pub n_digits: i32,
}

// FixedWidth returns the n-digit decimal form of f
pub fn fixed_width(f: f64, n: i32) -> FormatResult {
    assert n <= 18, "digits must be <= 18";

    let unpack = unpack64(f);
    let m = unpack.mantissa;
    let e = unpack.exponent;

    let p = n - 1 - log10_pow2(e + 63);
    let lp = log2_pow10(p);
    let pm = get_pow10(p);
    let s = -(e + lp + 3);

    let u = uscale(m, pm.hi, pm.lo, s);
    let mut d = unrounded_round(u);
    if d >= pow10(n) {
        d = unrounded_round(unrounded_div(u, 10));
        return FormatResult { digits: d, exponent: -p + 1, n_digits: n };
    }

    return FormatResult { digits: d, exponent: -p, n_digits: n };
}

// Fixed-point form of f at the given precision: 1×unpack64 + 1×uscale, against
// the short() + fixed_width() two-pass this replaced.
pub fn fixed_width_for_prec(f: f64, precision: i32) -> FormatResult {
    let unpack = unpack64(f);
    let m = unpack.mantissa;
    let e = unpack.exponent;

    let log10_e63 = log10_pow2(e + 63);

    // Scaling by exactly 10^precision puts the digits at the 10^-precision
    // place, which is what a fixed-point format asks for. The digit count is
    // then only needed to bound the result. log10_pow2 is floor(log10 f) or one
    // less, so the true count is `n_est` or `n_est + 1`, and one more again on a
    // rounding carry. Reading it back off `d` needs no second scaling.
    let n_est = 1 + log10_e63 + precision;
    if n_est < 1 || n_est > 17 {
        builtin::cold_path();
        return fixed_width_out_of_range(m, e, log10_e63, precision);
    }

    let lp = log2_pow10(precision);
    let pm = get_pow10(precision);
    let s = -(e + lp + 3);
    let d = unrounded_round(uscale(m, pm.hi, pm.lo, s));
    return FormatResult { digits: d, exponent: -precision, n_digits: digits(d) };
}

// `fixed_width_for_prec` where scaling by 10^precision alone would not land the
// digits in a u64: the value is below the last printed place, or wider than 17
// digits. Split out so the conversion path above stays one scaling long.
fn fixed_width_out_of_range(m: u64, e: i32, log10_e63: i32, precision: i32) -> FormatResult {
    // Phase 1: Determine exact decimal position using floor of 1-digit scaling.
    // One uscale + floor check resolves the ambiguity exactly.
    let p1 = -log10_e63;
    let lp1 = log2_pow10(p1);
    let pm1 = get_pow10(p1);
    let s1 = -(e + lp1 + 3);
    let u1 = uscale(m, pm1.hi, pm1.lo, s1);
    let d1_floor = unrounded_floor(u1);
    // log10_pow2 underestimates floor(log10(f)) by one exactly when the
    // one-digit floor reaches 10, in which case the decimal position is one
    // larger than the first estimate.
    let decimal_pos = if d1_floor >= 10 { 2 - p1 } else { 1 - p1 };

    // Phase 2: Compute fixed_width(f, n) reusing the unpacked mantissa and exponent.
    // Use decimal_pos directly: for numbers < 1.0 (decimal_pos <= 0), the leading "0."
    // is not a significant digit, so we need exactly (decimal_pos + precision) digits.
    let total_digits = decimal_pos + precision;

    if total_digits <= 0 {
        // f lies below the last printed place (10^-precision), so it rounds to
        // either 0 or a single 1 in that place. total_digits < 0 means
        // f < 0.5 * 10^-precision, which always rounds down to zero.
        if total_digits < 0 {
            return FormatResult { digits: 0, exponent: -precision, n_digits: 0 };
        }
        // total_digits == 0: f is in [10^(-precision-1), 10^-precision), one
        // decade below the last printed place. Scale for a single significant
        // digit (p = -log10_e63, which fpfmt keeps well-conditioned for any
        // magnitude — unlike scaling for 0 digits, where the shift would reach
        // 64), then divide down to the 10^-precision place and round to nearest.
        // The gap p - precision is 1, or 2 when log10_pow2 underestimated the
        // exponent. The result is 0 or 1.
        let p = -log10_e63;
        let lp = log2_pow10(p);
        let pm = get_pow10(p);
        let s = -(e + lp + 3);
        let u = uscale(m, pm.hi, pm.lo, s);
        let d = unrounded_round(unrounded_div(u, pow10(p - precision)));
        return FormatResult { digits: d, exponent: -precision, n_digits: d as i32 };
    }

    let n = if total_digits > 18 { 18 } else { total_digits };

    let p = n - 1 - log10_e63;
    let lp = log2_pow10(p);
    let pm = get_pow10(p);
    let s = -(e + lp + 3);
    let u = uscale(m, pm.hi, pm.lo, s);
    let mut d = unrounded_round(u);
    if d >= pow10(n) {
        d = unrounded_round(unrounded_div(u, 10));
        return FormatResult { digits: d, exponent: -p + 1, n_digits: n };
    }
    return FormatResult { digits: d, exponent: -p, n_digits: n };
}

// Short computes the shortest formatting of f that round-trips
pub fn short(f: f64) -> FormatResult {
    let min_exp = -1085;

    let unpack = unpack64(f);
    let m = unpack.mantissa;
    let e = unpack.exponent;

    let mut min_m: u64 = 0;
    let mut z = 11;
    let mut p: i32 = 0;

    let m_is_power_of_2 = m == 0x8000000000000000;
    if m_is_power_of_2 && e > min_exp {
        p = -skewed(e + z);
        min_m = m - (1 as u64 << (z - 2) as u64);
    } else {
        if e < min_exp {
            z = 11 + (min_exp - e);
        }
        p = -log10_pow2(e + z);
        min_m = m - (1 as u64 << (z - 1) as u64);
    }

    let max_m = m + (1 as u64 << (z - 1) as u64);
    let odd = (m >> z as u64 & 1) as i32;

    let lp = log2_pow10(p);
    let pm = get_pow10(p);
    let s = -(e + lp + 3);

    let dmin = unrounded_ceil(unrounded_nudge(uscale(min_m, pm.hi, pm.lo, s), odd));
    let dmax = unrounded_floor(unrounded_nudge(uscale(max_m, pm.hi, pm.lo, s), -odd));

    // Check if we can trim to fewer digits
    let d_div_10 = dmax / 10;
    let can_trim = d_div_10 * 10 >= dmin;

    if can_trim {
        let [trimmed, exponent] = trim_zeros(d_div_10, -(p - 1));
        return FormatResult { digits: trimmed, exponent, n_digits: digits(trimmed) };
    }

    let mut d = dmin;
    if dmin < dmax {
        d = unrounded_round(uscale(m, pm.hi, pm.lo, s));
    }
    return FormatResult { digits: d, exponent: -p, n_digits: digits(d) };
}

// short32 computes the shortest formatting of f32 that round-trips through f32.
// Uses f32's 24-bit mantissa (z=40) instead of f64's 53-bit mantissa (z=11).
pub fn short32(f: f32) -> FormatResult {
    let min_exp = -189;

    let unpack = unpack32(f);
    let m = unpack.mantissa;
    let e = unpack.exponent;

    let mut min_m: u64 = 0;
    let mut z = 40;
    let mut p: i32 = 0;

    let m_is_power_of_2 = m == 0x8000000000000000;
    if m_is_power_of_2 && e > min_exp {
        p = -skewed(e + z);
        min_m = m - (1 as u64 << (z - 2) as u64);
    } else {
        if e < min_exp {
            z = 40 + (min_exp - e);
        }
        p = -log10_pow2(e + z);
        min_m = m - (1 as u64 << (z - 1) as u64);
    }

    let max_m = m + (1 as u64 << (z - 1) as u64);
    let odd = (m >> z as u64 & 1) as i32;

    let lp = log2_pow10(p);
    let pm = get_pow10(p);
    let s = -(e + lp + 3);

    let dmin = unrounded_ceil(unrounded_nudge(uscale(min_m, pm.hi, pm.lo, s), odd));
    let dmax = unrounded_floor(unrounded_nudge(uscale(max_m, pm.hi, pm.lo, s), -odd));

    let d_div_10 = dmax / 10;
    let can_trim = d_div_10 * 10 >= dmin;

    if can_trim {
        let [trimmed, exponent] = trim_zeros(d_div_10, -(p - 1));
        return FormatResult { digits: trimmed, exponent, n_digits: digits(trimmed) };
    }

    let mut d = dmin;
    if dmin < dmax {
        d = unrounded_round(uscale(m, pm.hi, pm.lo, s));
    }
    return FormatResult { digits: d, exponent: -p, n_digits: digits(d) };
}

pub fn skewed(e: i32) -> i32 {
    return e * 631305 - 261663 >> 21;
}

// Unsigned multiply (low 64 bits only, modular)
pub fn u64_mul(a: u64, b: u64) -> u64 {
    // Use wide multiply and take the low part
    let [lo, _] = builtin::i64_mul_wide_u(a as i64, b as i64);
    return lo as u64;  // Low 64 bits
}

pub fn trim_zeros(x: u64, p: i32) -> [u64, i32] {
    let inv5: u64 = 0xcccccccccccccccd;
    let inv5p2: u64 = 0x8f5c28f5c28f5c29;
    let inv5p4: u64 = 0xd288ce703afb7e91;
    let inv5p8: u64 = 0xc767074b22e90e21;

    // Threshold values
    let thresh_10: u64 = 1844674407370955161;  // maxUint64 / 10
    let thresh_100: u64 = 184467440737095516;  // maxUint64 / 100
    let thresh_10000: u64 = 1844674407370955;  // maxUint64 / 10000
    let thresh_1e8: u64 = 184467440737;  // maxUint64 / 100000000

    let mut xv = x;
    let mut pv = p;

    let d1 = rotate_right(u64_mul(xv, inv5), 1);
    if d1 <= thresh_10 {
        xv = d1;
        pv = pv + 1;
    } else {
        return [xv, pv];
    }

    let d8 = rotate_right(u64_mul(xv, inv5p8), 8);
    if d8 <= thresh_1e8 {
        xv = d8;
        pv = pv + 8;
    }

    let d4 = rotate_right(u64_mul(xv, inv5p4), 4);
    if d4 <= thresh_10000 {
        xv = d4;
        pv = pv + 4;
    }

    let d2 = rotate_right(u64_mul(xv, inv5p2), 2);
    if d2 <= thresh_100 {
        xv = d2;
        pv = pv + 2;
    }

    let d1b = rotate_right(u64_mul(xv, inv5), 1);
    if d1b <= thresh_10 {
        xv = d1b;
        pv = pv + 1;
    }

    return [xv, pv];
}

pub fn rotate_right(x: u64, n: u64) -> u64 {
    return x >> n | x << 64 - n;
}

// digits returns the number of decimal digits in d
pub fn digits(d: u64) -> i32 {
    let nd = log10_pow2(u64_bit_len(d));
    return nd + (d >= pow10(nd)) as i32;
}

fn i2a_first(n: i32) -> char {
    return char::from_u32_unchecked('0' as u32 + (n / 10) as u32);
}

fn i2a_second(n: i32) -> char {
    return char::from_u32_unchecked('0' as u32 + (n % 10) as u32);
}

// Write nd decimal digits of val into buf at offset, right-to-left using set_byte_unchecked.
// buf must already have space (pre-filled with '0' chars).
fn write_digits_at(buf: &mut String, offset: i32, val: u64, nd: i32) {
    let mut v = val;
    let mut idx = offset + nd - 1;
    while idx >= offset {
        buf.set_byte_unchecked(idx, b'0' + (v % 10) as u8);
        v = v / 10;
        idx = idx - 1;
    }
}

// Fill n bytes of '0' at `offset`. The span must already be reserved.
fn zeros_at(buf: &mut String, offset: i32, n: i32) {
    if n <= 0 {
        return;
    }
    let raw = buf.internal_raw_bytes_mut();
    builtin::array_fill(raw, offset, b'0', n);
}

// Reserve n uninitialized bytes at the end and return their start offset.
// Every writer below reserves its whole output in one call and then fills the
// span in place: a reserve per fragment costs a capacity check and a non-inlined
// call each, and the no-op fills (a zero-length run) are the common case.
fn reserve_uninit(buf: &mut String, n: i32) -> i32 {
    return buf.internal_reserve_uninit(n);
}

// Write decimal representation directly into buf (appends to existing content).
pub fn write_decimal(buf: &mut String, d: u64, p: i32, nd: i32) {
    let decimal_pos = nd + p;

    if decimal_pos <= 0 {
        // Need leading zeros: 0.00...digits
        let leading = -decimal_pos;
        let start = reserve_uninit(buf, 2 + leading + nd);
        buf.set_byte_unchecked(start, b'0');
        buf.set_byte_unchecked(start + 1, b'.');
        zeros_at(buf, start + 2, leading);
        write_digits_at(buf, start + 2 + leading, d, nd);
    } else if decimal_pos >= nd {
        // Integer with trailing zeros: digits000...
        let start = reserve_uninit(buf, decimal_pos);
        write_digits_at(buf, start, d, nd);
        zeros_at(buf, start + nd, decimal_pos - nd);
    } else {
        // Decimal point in the middle: dig.its
        let start = reserve_uninit(buf, nd + 1);
        write_digits_at(buf, start, d, nd);
        // Shift fractional part right by 1 and insert '.'
        let raw = buf.internal_raw_bytes_mut();
        builtin::array_copy(raw, start + decimal_pos + 1, raw, start + decimal_pos, nd - decimal_pos);
        buf.set_byte_unchecked(start + decimal_pos, b'.');
    }
}

// Format result to decimal string (no exponent)
pub fn format_decimal(d: u64, p: i32, nd: i32) -> String {
    let decimal_pos = nd + p;
    let total = if decimal_pos <= 0 {
        2 + -decimal_pos + nd;
    } else if decimal_pos >= nd {
        decimal_pos;
    } else {
        nd + 1;
    };
    let mut buf = String::with_capacity(total);
    write_decimal(&mut buf, d, p, nd);
    return buf;
}

// Write exponential representation directly into buf (appends to existing content).
pub fn write_exp(buf: &mut String, d: u64, p: i32, nd: i32, upper: bool) {
    let exp = p + nd - 1;

    // Write digits: first digit, then '.' and rest
    if nd > 1 {
        let start = reserve_uninit(buf, nd + 1);
        write_digits_at(buf, start, d, nd);
        let raw = buf.internal_raw_bytes_mut();
        builtin::array_copy(raw, start + 2, raw, start + 1, nd - 1);
        buf.set_byte_unchecked(start + 1, b'.');
    } else {
        let start = reserve_uninit(buf, 1);
        write_digits_at(buf, start, d, 1);
    }

    // Exponent
    buf.push_str(&if upper { "E" } else { "e" });
    if exp < 0 {
        buf.push_str("-");
    }

    let abs_exp = if exp < 0 { -exp } else { exp };
    if abs_exp < 10 {
        buf.push(char::from_u32_unchecked('0' as u32 + abs_exp as u32));
    } else if abs_exp < 100 {
        buf.push(i2a_first(abs_exp));
        buf.push(i2a_second(abs_exp));
    } else {
        buf.push(char::from_u32_unchecked('0' as u32 + (abs_exp / 100) as u32));
        buf.push(i2a_first(abs_exp % 100));
        buf.push(i2a_second(abs_exp % 100));
    }
}

// Format result to exponential string (upper: true for 'E', false for 'e')
pub fn format_exp(d: u64, p: i32, nd: i32, upper: bool) -> String {
    let mut buf = String::with_capacity(30);
    write_exp(&mut buf, d, p, nd, upper);
    return buf;
}


// Write decimal with specified precision directly into buf (appends to existing content).
pub fn write_decimal_prec(buf: &mut String, d: u64, p: i32, nd: i32, precision: i32) {
    if precision < 0 {
        write_decimal(buf, d, p, nd);
        return;
    }

    let decimal_pos = nd + p;

    if decimal_pos <= 0 {
        let leading_zeros = -decimal_pos;
        // value < 1, so the integer part is "0"; with no precision there is no
        // fractional part and hence no decimal point (e.g. `{0.4:.0f}` -> "0").
        if precision == 0 {
            buf.push_str("0");
            return;
        }
        // "0." plus exactly `precision` fractional bytes.
        let start = reserve_uninit(buf, 2 + precision);
        buf.set_byte_unchecked(start, b'0');
        buf.set_byte_unchecked(start + 1, b'.');
        let frac = start + 2;
        if precision <= leading_zeros {
            zeros_at(buf, frac, precision);
            return;
        }
        zeros_at(buf, frac, leading_zeros);
        let remaining_prec = precision - leading_zeros;
        let digits_to_output = if remaining_prec < nd { remaining_prec } else { nd };
        let mut trim_d = d;
        let mut skip = nd - digits_to_output;
        while skip > 0 {
            trim_d = trim_d / 10;
            skip = skip - 1;
        }
        write_digits_at(buf, frac + leading_zeros, trim_d, digits_to_output);
        zeros_at(buf, frac + leading_zeros + digits_to_output, remaining_prec - digits_to_output);
    } else if decimal_pos >= nd {
        let point = if precision > 0 { 1 + precision } else { 0 };
        let start = reserve_uninit(buf, decimal_pos + point);
        write_digits_at(buf, start, d, nd);
        zeros_at(buf, start + nd, decimal_pos - nd);
        if precision > 0 {
            buf.set_byte_unchecked(start + decimal_pos, b'.');
            zeros_at(buf, start + decimal_pos + 1, precision);
        }
    } else {
        let after_decimal = nd - decimal_pos;
        if precision <= after_decimal {
            let output_nd = decimal_pos + precision;
            let mut trim_d = d;
            let mut skip = nd - output_nd;
            while skip > 0 {
                trim_d = trim_d / 10;
                skip = skip - 1;
            }
            let start = reserve_uninit(buf, output_nd + 1);
            write_digits_at(buf, start, trim_d, output_nd);
            let raw = buf.internal_raw_bytes_mut();
            builtin::array_copy(raw, start + decimal_pos + 1, raw, start + decimal_pos, output_nd - decimal_pos);
            buf.set_byte_unchecked(start + decimal_pos, b'.');
            return;
        }
        let trailing = precision - after_decimal;
        let start = reserve_uninit(buf, nd + 1 + trailing);
        write_digits_at(buf, start, d, nd);
        let raw = buf.internal_raw_bytes_mut();
        builtin::array_copy(raw, start + decimal_pos + 1, raw, start + decimal_pos, nd - decimal_pos);
        buf.set_byte_unchecked(start + decimal_pos, b'.');
        zeros_at(buf, start + nd + 1, trailing);
    }
}

/// Format f64 to decimal string with specified precision (digits after decimal point)
/// precision < 0 means use shortest representation
pub fn format_decimal_prec(d: u64, p: i32, nd: i32, precision: i32) -> String {
    let mut buf = String::with_capacity(30);
    write_decimal_prec(&mut buf, d, p, nd, precision);
    return buf;
}

// Write exponential with precision directly into buf (appends to existing content).
pub fn write_exp_prec(buf: &mut String, d: u64, p: i32, nd: i32, precision: i32, upper: bool) {
    if precision < 0 {
        write_exp(buf, d, p, nd, upper);
        return;
    }

    if precision > 0 {
        let available = nd - 1;
        let to_output = if precision < available { precision } else { available };
        let trailing = precision - to_output;
        let digit_count = 1 + to_output;
        let start = reserve_uninit(buf, digit_count + 1 + trailing);
        let mut trim_d = d;
        let mut skip = nd - digit_count;
        while skip > 0 {
            trim_d = trim_d / 10;
            skip = skip - 1;
        }
        write_digits_at(buf, start, trim_d, digit_count);
        let raw = buf.internal_raw_bytes_mut();
        builtin::array_copy(raw, start + 2, raw, start + 1, digit_count - 1);
        buf.set_byte_unchecked(start + 1, b'.');
        zeros_at(buf, start + digit_count + 1, trailing);
    } else {
        let start = reserve_uninit(buf, 1);
        let mut first_d = d;
        let mut skip = nd - 1;
        while skip > 0 {
            first_d = first_d / 10;
            skip = skip - 1;
        }
        write_digits_at(buf, start, first_d, 1);
    }

    let exp = p + nd - 1;
    buf.push_str(&if upper { "E" } else { "e" });
    if exp < 0 {
        buf.push_str("-");
    }

    let abs_exp = if exp < 0 { -exp } else { exp };
    if abs_exp < 10 {
        buf.push(char::from_u32_unchecked('0' as u32 + abs_exp as u32));
    } else if abs_exp < 100 {
        buf.push(i2a_first(abs_exp));
        buf.push(i2a_second(abs_exp));
    } else {
        buf.push(char::from_u32_unchecked('0' as u32 + (abs_exp / 100) as u32));
        buf.push(i2a_first(abs_exp % 100));
        buf.push(i2a_second(abs_exp % 100));
    }
}

/// Format f64 to exponential string with specified precision (digits after decimal point)
/// precision < 0 means use shortest representation
pub fn format_exp_prec(d: u64, p: i32, nd: i32, precision: i32, upper: bool) -> String {
    let mut buf = String::with_capacity(30);
    write_exp_prec(&mut buf, d, p, nd, precision, upper);
    return buf;
}

// Encodes the kind of special floating-point value detected by check_special.
pub enum SpecialKind {
    NotSpecial,
    Zero,
    Inf,
    NaN,
}

// Check for special floating-point values (zero, infinity, NaN).
// Returns [is_special, is_neg, kind]:
//   is_special: true if f is a special value
//   is_neg:     true if f is negative (for use on either the special or non-special path)
//   kind:       SpecialKind enum (NotSpecial, Zero, Inf, or NaN)
// On the non-special path (is_special=false), kind is SpecialKind::NotSpecial.
pub fn check_special(f: f64) -> [bool, bool, SpecialKind] {
    let bits = f.to_bits();

    // Check for zero
    if bits == 0 {
        return [true, false, SpecialKind::Zero];
    }
    if bits == NEG_ZERO_BITS {
        return [true, true, SpecialKind::Zero];
    }

    let is_neg = bits & NEG_ZERO_BITS != 0;

    // Check for infinity/NaN
    let exp_mask: u64 = 0x7FF0000000000000;
    if bits & exp_mask == exp_mask {
        builtin::cold_path();
        let mantissa_mask: u64 = 0x000FFFFFFFFFFFFF;
        if bits & mantissa_mask != 0 {
            return [true, false, SpecialKind::NaN];
        }
        return [true, is_neg, SpecialKind::Inf];
    }

    return [false, is_neg, SpecialKind::NotSpecial];
}

/// An IEEE 754 binary interchange format, as `parse_bits` rounds into it.
pub struct BinaryFormat {
    /// Significand bits, the implicit leading one included.
    pub precision: i32,
    pub exponent_bits: i32,
}

pub global BINARY64: BinaryFormat = BinaryFormat { precision: 53, exponent_bits: 11 };
pub global BINARY32: BinaryFormat = BinaryFormat { precision: 24, exponent_bits: 8 };
pub global BINARY16: BinaryFormat = BinaryFormat { precision: 11, exponent_bits: 5 };
pub global BFLOAT16: BinaryFormat = BinaryFormat { precision: 8, exponent_bits: 8 };

impl BinaryFormat {
    fn fraction_bits(&self) -> u64 {
        return (self.precision - 1) as u64;
    }

    /// The negated exponent of the smallest subnormal's unit.
    fn tiny(&self) -> i32 {
        let bias = (1 << self.exponent_bits - 1) - 1;
        return bias + self.precision - 2;
    }

    pub fn infinity_bits(&self) -> u64 {
        return (1 as u64 << self.exponent_bits as u64) - 1 << self.fraction_bits();
    }

    fn quiet_nan_bits(&self) -> u64 {
        return self.infinity_bits() | 1 as u64 << self.fraction_bits() - 1;
    }

    pub fn sign_bit(&self) -> u64 {
        return 1 as u64 << (self.exponent_bits + self.precision - 1) as u64;
    }
}

/// `parse` accepts at most this many decimal digits in `d` — the most that
/// always fit a u64 (u64::MAX has 20 digits).
pub global PARSE_DIGITS_MAX: i32 = 19;

/// Exponent domain of `parse`'s pow10 table. Outside it the result is
/// definitely ±infinity (above) or ±0 (below).
pub global PARSE_EXP_MAX: i32 = 350;
pub global PARSE_EXP_MIN: i32 = -351;

/// `d * 10^p` rounded once, ties to even, into `format`, as its bits with the
/// sign clear. `d` is nonzero with at most `PARSE_DIGITS_MAX` digits.
pub fn parse_bits(d: u64, p: i32, format: &BinaryFormat) -> u64 {
    assert d != 0;
    let precision = format.precision;
    let tiny = format.tiny();
    let b = u64_bit_len(d);
    let lp = log2_pow10(p);
    let mut e = i32::min(tiny, precision - b - lp);
    let s = -(e - (64 - b) + lp + 3);
    // Every bit `uscale` would keep is shifted out: the value is below a
    // quarter of the smallest subnormal.
    if s >= 64 {
        return 0;
    }
    let pm = get_pow10(p);
    let mut u = uscale(d << (64 - b) as u64, pm.hi, pm.lo, s);

    // Branch-free: if round(u) >= 1<<precision, shift right by 1
    let unmin = (1 as u64 << (precision + 2) as u64) - 2;
    let shift = (u >= unmin) as u64;
    u = u >> shift | u & 1;
    e = e - shift as i32;

    let m = unrounded_round(u);
    let hidden = 1 as u64 << format.fraction_bits();
    if m & hidden == 0 {
        return m;
    }
    let biased = tiny + 1 - e;
    if biased >= (1 << format.exponent_bits) - 1 {
        return format.infinity_bits();
    }
    return m & ~hidden | biased as u64 << format.fraction_bits();
}

// parse rounds d * 10^p to the nearest f64.
// d must have at most PARSE_DIGITS_MAX digits.
pub fn parse(d: u64, p: i32) -> f64 {
    return f64::from_bits(parse_bits(d, p, &BINARY64));
}

/// The decimal text `s` rounded once into `format`, as its bits; `None` where it
/// is malformed. Takes a sign, `inf`/`infinity`/`nan` in any case, and no bare dot.
pub fn parse_text_bits(s: &StrSlice, format: &BinaryFormat) -> Option<u64> {
    let len = s.len();
    if len == 0 {
        return null;
    }

    // Parse optional sign
    let mut sign: u64 = 0;
    let mut i = 0;
    let first = s.get_byte_unchecked(0);
    if first == b'-' {
        sign = format.sign_bit();
        i = 1;
    } else if first == b'+' {
        i = 1;
    }

    if i >= len {
        return null;
    }

    // Check for special values (case-insensitive)
    let remaining = len - i;
    let c0 = s.get_byte_unchecked(i);

    // "inf" or "infinity"
    if c0.eq_ignore_ascii_case(&b'i') && remaining >= 3 {
        builtin::cold_path();

        let c1 = s.get_byte_unchecked(i + 1);
        let c2 = s.get_byte_unchecked(i + 2);
        if c1.eq_ignore_ascii_case(&b'n') && c2.eq_ignore_ascii_case(&b'f') {
            if remaining == 3 {
                return Option::Some(sign | format.infinity_bits());
            }
            if remaining == 8 {
                let c3 = s.get_byte_unchecked(i + 3);
                let c4 = s.get_byte_unchecked(i + 4);
                let c5 = s.get_byte_unchecked(i + 5);
                let c6 = s.get_byte_unchecked(i + 6);
                let c7 = s.get_byte_unchecked(i + 7);
                if c3.eq_ignore_ascii_case(&b'i')
                    && c4.eq_ignore_ascii_case(&b'n')
                    && c5.eq_ignore_ascii_case(&b'i')
                    && c6.eq_ignore_ascii_case(&b't')
                    && c7.eq_ignore_ascii_case(&b'y') {
                    return Option::Some(sign | format.infinity_bits());
                }
            }
        }
        return null;
    }

    // "nan" (sign is ignored for NaN)
    if c0.eq_ignore_ascii_case(&b'n') && remaining == 3 {
        builtin::cold_path();

        let c1 = s.get_byte_unchecked(i + 1);
        let c2 = s.get_byte_unchecked(i + 2);
        if c1.eq_ignore_ascii_case(&b'a') && c2.eq_ignore_ascii_case(&b'n') {
            return Option::Some(format.quiet_nan_bits());
        }
        return null;
    }

    // The first PARSE_DIGITS_MAX significant digits accumulate into `d`, and
    // `scale` places them. A nonzero digit past them makes the value `inexact`.
    let mantissa_start = i;
    let mut d: u64 = 0;
    let mut kept = 0;
    let mut scale = 0;
    let mut inexact = false;
    let int_start = i;
    for ; i < len && s.get_byte_unchecked(i).is_ascii_digit(); i += 1 {
        let digit = (s.get_byte_unchecked(i) - b'0') as u64;
        if kept == PARSE_DIGITS_MAX {
            scale += 1;
            inexact = inexact || digit != 0;
        } else if d != 0 || digit != 0 {
            d = d * 10 + digit;
            kept += 1;
        }
    }
    // A leading dot, and a string with no digits, are both refused here.
    if i == int_start {
        return null;
    }
    if i < len && s.get_byte_unchecked(i) == b'.' {
        i += 1;
        let frac_start = i;
        for ; i < len && s.get_byte_unchecked(i).is_ascii_digit(); i += 1 {
            let digit = (s.get_byte_unchecked(i) - b'0') as u64;
            if kept == PARSE_DIGITS_MAX {
                inexact = inexact || digit != 0;
            } else {
                if d != 0 || digit != 0 {
                    d = d * 10 + digit;
                    kept += 1;
                }
                scale -= 1;
            }
        }
        if i == frac_start {
            return null;  // trailing dot not allowed
        }
    }
    let mantissa_end = i;

    let mut written: i64 = 0;
    if i < len && (s.get_byte_unchecked(i) == b'e' || s.get_byte_unchecked(i) == b'E') {
        i += 1;
        let mut negative = false;
        if i < len {
            if s.get_byte_unchecked(i) == b'-' {
                negative = true;
                i += 1;
            } else if s.get_byte_unchecked(i) == b'+' {
                i += 1;
            }
        }
        let exp_start = i;
        for ; i < len && s.get_byte_unchecked(i).is_ascii_digit(); i += 1 {
            written = push_exponent_digit(written, (s.get_byte_unchecked(i) - b'0') as i32);
        }
        if i == exp_start {
            return null;
        }
        if negative {
            written = -written;
        }
    }

    if i != len {
        return null;
    }

    // Handle d == 0 (preserve negative zero)
    if d == 0 {
        return Option::Some(sign);
    }
    let p = decimal_scale(written, scale);
    if !inexact {
        return Option::Some(sign | round_decimal(d, p, format));
    }
    let digits = s.as_bytes().slice(mantissa_start, mantissa_end);
    return Option::Some(sign | round_truncated_decimal(d, p, digits, format));
}

/// An exponent's digits stop accumulating here, far past what any run of
/// mantissa digits an input can hold would take to bring it back into range.
global EXPONENT_SATURATION: i64 = 1000000000000000;

/// `exponent` with one more decimal digit written after it, saturating.
pub fn push_exponent_digit(exponent: i64, digit: i32) -> i64 {
    if exponent >= EXPONENT_SATURATION {
        return exponent;
    }
    return exponent * 10 + digit as i64;
}

/// The power of ten placing a decimal's kept digits: the `written` exponent
/// plus their `offset`, pinned just outside the pow10 table's domain.
pub fn decimal_scale(written: i64, offset: i32) -> i32 {
    let p = written + offset as i64;
    return i64::clamp(p, (PARSE_EXP_MIN - 20) as i64, (PARSE_EXP_MAX + 20) as i64) as i32;
}

/// `d * 10^p` rounded once into `format`, as its bits with the sign clear; an
/// infinity or zero where `p` is past the pow10 table's domain.
pub fn round_decimal(d: u64, p: i32, format: &BinaryFormat) -> u64 {
    if p > PARSE_EXP_MAX {
        return format.infinity_bits();
    }
    if p < PARSE_EXP_MIN {
        return 0;
    }
    return parse_bits(d, p, format);
}

/// `round_decimal` where `d` holds the first `PARSE_DIGITS_MAX` significant
/// digits of `digits`, as written, and a nonzero one follows them.
pub fn round_truncated_decimal(d: u64, p: i32, digits: ByteSlice, format: &BinaryFormat) -> u64 {
    let lo = round_decimal(d, p, format);
    // The value lies strictly between d and d + 1 at this scale, so only a
    // rounding boundary between their two results needs the digits dropped.
    let hi = if d == 9999999999999999999 {
        round_decimal(1000000000000000000, p + 1, format);
    } else {
        round_decimal(d + 1, p, format);
    };
    if lo == hi {
        return lo;
    }
    assert hi == lo + 1;
    let order = compare_to_midpoint(digits, p, lo, format);
    return if order < 0 || order == 0 && lo & 1 == 0 { lo } else { hi };
}

/// The exact sign of the decimal `digits` spell, its first `PARSE_DIGITS_MAX`
/// significant digits scaled by `10^p`, less the midpoint just above `below`.
fn compare_to_midpoint(digits: ByteSlice, p: i32, below: u64, format: &BinaryFormat) -> i32 {
    let mut decimal: List<u32> = [];
    let mut kept = 0;
    let mut sticky = false;
    for let mut k = 0; k < digits.len(); k += 1 {
        let c = digits.get_unchecked(k);
        if c == b'.' {
            continue;
        }
        let digit = (c - b'0') as u32;
        if kept == MIDPOINT_DIGITS_MAX {
            sticky = sticky || digit != 0;
        } else if kept > 0 || digit != 0 {
            big_mul_add(&mut decimal, 10, digit);
            kept += 1;
        }
    }
    let e10 = p - (kept - PARSE_DIGITS_MAX);

    // The midpoint is (2m + 1) * 2^(q - 1), where `below` is m * 2^q.
    let tiny = format.tiny();
    let fraction = below & (1 as u64 << format.fraction_bits()) - 1;
    let biased = (below >> format.fraction_bits()) as i32;
    let m = if biased == 0 { fraction } else { fraction | 1 as u64 << format.fraction_bits() };
    let q = if biased == 0 { -tiny } else { biased - tiny - 1 };
    let odd = 2 * m + 1;
    let mut midpoint: List<u32> = [odd as u32, (odd >> 32) as u32];

    // decimal * 5^e10 * 2^e10 against midpoint * 2^(q - 1), with the power of
    // five moved to whichever side keeps both integers.
    let mut decimal_twos = 0;
    let mut midpoint_twos = q - 1;
    if e10 >= 0 {
        big_mul_pow5(&mut decimal, e10);
        decimal_twos = e10;
    } else {
        big_mul_pow5(&mut midpoint, -e10);
        midpoint_twos -= e10;
    }
    if decimal_twos > midpoint_twos {
        big_shl(&mut decimal, decimal_twos - midpoint_twos);
    } else {
        big_shl(&mut midpoint, midpoint_twos - decimal_twos);
    }
    let order = big_cmp(&decimal, &midpoint);
    if order == 0 && sticky {
        return 1;
    }
    return order;
}

/// More significant digits than any midpoint of the formats `parse_bits`
/// serves has: binary64's smallest carries 767.
global MIDPOINT_DIGITS_MAX: i32 = 800;

/// A little-endian unsigned big integer, times `factor` plus `addend`.
fn big_mul_add(n: &mut List<u32>, factor: u32, addend: u32) {
    let mut carry = addend as u64;
    for let mut k = 0; k < n.len(); k += 1 {
        let v = n[k] as u64 * factor as u64 + carry;
        n[k] = v as u32;
        carry = v >> 32;
    }
    if carry != 0 {
        n.push(carry as u32);
    }
}

/// 5^13, the largest power of five a `u32` holds.
global POW5_13: u32 = 1220703125;

fn big_mul_pow5(n: &mut List<u32>, e: i32) {
    let mut left = e;
    while left >= 13 {
        big_mul_add(n, POW5_13, 0);
        left -= 13;
    }
    let mut last: u32 = 1;
    for let mut k = 0; k < left; k += 1 {
        last *= 5;
    }
    big_mul_add(n, last, 0);
}

fn big_shl(n: &mut List<u32>, bits: i32) {
    let words = bits / 32;
    let rest = (bits % 32) as u32;
    if rest != 0 {
        big_mul_add(n, 1 as u32 << rest, 0);
    }
    if words > 0 {
        let mut shifted: List<u32> = List::with_capacity(n.len() + words);
        for let mut k = 0; k < words; k += 1 {
            shifted.push(0);
        }
        for let w of *n {
            shifted.push(w);
        }
        *n = shifted;
    }
}

/// The sign of `a - b`, ignoring high zero words.
fn big_cmp(a: &List<u32>, b: &List<u32>) -> i32 {
    let la = significant_words(a);
    let lb = significant_words(b);
    if la != lb {
        return if la < lb { -1 } else { 1 };
    }
    for let mut k = la - 1; k >= 0; k -= 1 {
        if a[k] != b[k] {
            return if a[k] < b[k] { -1 } else { 1 };
        }
    }
    return 0;
}

fn significant_words(n: &List<u32>) -> i32 {
    let mut len = n.len();
    while len > 0 && n[len - 1] == 0 {
        len -= 1;
    }
    return len;
}
