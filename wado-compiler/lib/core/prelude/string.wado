#![no_prelude]
#![stdlib("core:prelude/string.wado")]
// Split from the prelude so other stdlib modules can depend on String without a cycle.


use { Eq, Ord, Iterator, IntoIterator, Add, Default, From, Ordering } from "core:prelude/traits.wado";
use { LenientFromStr, LenientParseError } from "core:prelude/traits.wado";
use { IterMap, IterFilter, IterEnumerate, IterTake, IterSkip, IterChain, IterZip } from "core:prelude/traits.wado";
use { Option, Result } from "core:prelude/types.wado";
use { ArraySlice } from "core:prelude/slice.wado";
use { Array } from "core:prelude/array.wado";
use { List } from "core:prelude/list.wado";
use { ByteSlice, ByteList, ByteArray, AsByteSlice } from "core:prelude/bytes.wado";
use { i32_min, i32_max } from "core:rt";

fn byte_to_ascii_lowercase(b: u8) -> u8 {
    return b | (b >= b'A' && b <= b'Z') as u8 * (b'A' ^ b'a');
}

fn is_ascii_whitespace_byte(b: u8) -> bool {
    return (b as char).is_ascii_whitespace();
}

/// Byte length (1–4) of the UTF-8 sequence led by `b0`, assuming valid UTF-8.
#[inline]
fn utf8_seq_len(b0: u8) -> i32 {
    if b0 < 0x80 {
        return 1;
    }
    if b0 < 0xE0 {
        return 2;
    }
    if b0 < 0xF0 {
        return 3;
    }
    return 4;
}

/// Decode the UTF-8 scalar at byte offset `pos`, returning `[code_point, byte_length]`.
/// Assumes valid UTF-8 with the full sequence in range.
#[inline]
fn decode_char_at(repr: &Array<u8>, pos: i32) -> [u32, i32] {
    let b0 = repr[pos] as u32;
    if b0 < 0x80 {
        return [b0, 1];
    }
    if b0 < 0xE0 {
        let b1 = repr[pos + 1] as u32;
        return [(b0 & 0x1F) << 6 | b1 & 0x3F, 2];
    }
    if b0 < 0xF0 {
        let b1 = repr[pos + 1] as u32;
        let b2 = repr[pos + 2] as u32;
        return [(b0 & 0x0F) << 12 | (b1 & 0x3F) << 6 | b2 & 0x3F, 3];
    }
    let b1 = repr[pos + 1] as u32;
    let b2 = repr[pos + 2] as u32;
    let b3 = repr[pos + 3] as u32;
    return [(b0 & 0x07) << 18 | (b1 & 0x3F) << 12 | (b2 & 0x3F) << 6 | b3 & 0x3F, 4];
}

/// Encode `code` as UTF-8 at byte offset `pos`, returning the byte length (1–4).
/// `[pos, pos + len)` must be in bounds.
#[inline]
fn encode_char(repr: &mut Array<u8>, pos: i32, code: u32) -> i32 {
    if code < 0x80 {
        repr[pos] = code as u8;
        return 1;
    }
    if code < 0x800 {
        repr[pos] = (0xC0 | code >> 6) as u8;
        repr[pos + 1] = (0x80 | code & 0x3F) as u8;
        return 2;
    }
    if code < 0x10000 {
        repr[pos] = (0xE0 | code >> 12) as u8;
        repr[pos + 1] = (0x80 | code >> 6 & 0x3F) as u8;
        repr[pos + 2] = (0x80 | code & 0x3F) as u8;
        return 3;
    }
    repr[pos] = (0xF0 | code >> 18) as u8;
    repr[pos + 1] = (0x80 | code >> 12 & 0x3F) as u8;
    repr[pos + 2] = (0x80 | code >> 6 & 0x3F) as u8;
    repr[pos + 3] = (0x80 | code & 0x3F) as u8;
    return 4;
}

/// Return the start offset of the UTF-8 sequence containing byte `pos`.
fn char_start_backward(repr: &Array<u8>, pos: i32) -> i32 {
    let mut p = pos;
    while p > 0 {
        let b = repr[p];
        if b >= 0x80 && b < 0xC0 {
            p -= 1;
        } else {
            break;
        }
    }
    return p;
}

/// True if `needle[0..needle_len)` equals `haystack[pos..pos+needle_len)`.
/// Caller ensures `pos + needle_len <= haystack.len()`.
#[inline]
fn bytes_match_at(haystack: &Array<u8>, pos: i32, needle: &Array<u8>, needle_len: i32) -> bool {
    for let mut j = 0; j < needle_len; j += 1 {
        if haystack[pos + j] != needle[j] {
            return false;
        }
    }
    return true;
}

/// One UTF-8 scalar decoded from a byte slice.
struct Utf8Scalar {
    /// Decoded code point; meaningful only when `valid`.
    code: u32,
    /// Bytes advanced: when `valid`, the sequence length (1–4); when invalid,
    /// the prefix (>= 1) to skip before resuming.
    advance: i32,
    valid: bool,
}

/// Decode and validate the UTF-8 scalar at `bytes[start..len)`.
fn decode_utf8_scalar(bytes: ByteSlice, start: i32, len: i32) -> Utf8Scalar {
    let b0 = bytes.get_unchecked(start);
    if b0 < 0x80 {
        return Utf8Scalar { code: b0 as u32, advance: 1, valid: true };
    }
    if b0 < 0xC2 {
        // Bare continuation byte (0x80–0xBF) or overlong 2-byte lead (0xC0, 0xC1)
        builtin::cold_path();
        return Utf8Scalar { code: 0, advance: 1, valid: false };
    }
    if b0 < 0xE0 {
        if start + 1 >= len {
            builtin::cold_path();
            return Utf8Scalar { code: 0, advance: 1, valid: false };
        }
        let b1 = bytes.get_unchecked(start + 1);
        if b1 < 0x80 || b1 > 0xBF {
            builtin::cold_path();
            return Utf8Scalar { code: 0, advance: 1, valid: false };
        }
        let code = (b0 as u32 & 0x1F) << 6 | b1 as u32 & 0x3F;
        return Utf8Scalar { code, advance: 2, valid: true };
    }
    if b0 < 0xF0 {
        if start + 1 >= len {
            builtin::cold_path();
            return Utf8Scalar { code: 0, advance: 1, valid: false };
        }
        let b1 = bytes.get_unchecked(start + 1);
        // Reject bad continuation, overlong (E0 < A0), and surrogates (ED >= A0)
        if b1 < 0x80 || b1 > 0xBF || b0 == 0xE0 && b1 < 0xA0 || b0 == 0xED && b1 >= 0xA0 {
            builtin::cold_path();
            return Utf8Scalar { code: 0, advance: 1, valid: false };
        }
        if start + 2 >= len {
            builtin::cold_path();
            return Utf8Scalar { code: 0, advance: 2, valid: false };
        }
        let b2 = bytes.get_unchecked(start + 2);
        if b2 < 0x80 || b2 > 0xBF {
            builtin::cold_path();
            return Utf8Scalar { code: 0, advance: 2, valid: false };
        }
        let code = (b0 as u32 & 0x0F) << 12 | (b1 as u32 & 0x3F) << 6 | b2 as u32 & 0x3F;
        return Utf8Scalar { code, advance: 3, valid: true };
    }
    if b0 < 0xF5 {
        if start + 1 >= len {
            builtin::cold_path();
            return Utf8Scalar { code: 0, advance: 1, valid: false };
        }
        let b1 = bytes.get_unchecked(start + 1);
        // Reject bad continuation, overlong (F0 < 90), and out-of-range (F4 > 8F)
        if b1 < 0x80 || b1 > 0xBF || b0 == 0xF0 && b1 < 0x90 || b0 == 0xF4 && b1 > 0x8F {
            builtin::cold_path();
            return Utf8Scalar { code: 0, advance: 1, valid: false };
        }
        if start + 2 >= len {
            builtin::cold_path();
            return Utf8Scalar { code: 0, advance: 2, valid: false };
        }
        let b2 = bytes.get_unchecked(start + 2);
        if b2 < 0x80 || b2 > 0xBF {
            builtin::cold_path();
            return Utf8Scalar { code: 0, advance: 2, valid: false };
        }
        if start + 3 >= len {
            builtin::cold_path();
            return Utf8Scalar { code: 0, advance: 3, valid: false };
        }
        let b3 = bytes.get_unchecked(start + 3);
        if b3 < 0x80 || b3 > 0xBF {
            builtin::cold_path();
            return Utf8Scalar { code: 0, advance: 3, valid: false };
        }
        let code = (b0 as u32 & 0x07) << 18 | (b1 as u32 & 0x3F) << 12 | (b2 as u32 & 0x3F) << 6 | b3 as u32 & 0x3F;
        return Utf8Scalar { code, advance: 4, valid: true };
    }
    builtin::cold_path();
    return Utf8Scalar { code: 0, advance: 1, valid: false };
}

/// A UTF-8 encoded, growable string.
#[compiler_item("string")]
internal struct String {
    repr: ByteArray,
    used: i32,
}

/// Copy `len` bytes from offset `start` into a fresh `String` (bytes assumed valid UTF-8).
fn substring(repr: &Array<u8>, start: i32, len: i32) -> String {
    let mut part: Array<u8> = builtin::array_new(len);
    builtin::array_copy(&mut part, 0, repr, start, len);
    return String { repr: part as ByteArray, used: len };
}

/// Iterator over the raw UTF-8 bytes of a String, yielding each as `u8`.
internal struct StrUtf8ByteIter {
    repr: &Array<u8>,
    used: i32,
    index: i32,
}

impl Iterator for StrUtf8ByteIter {
    type Item = u8;

    #[inline]
    pub fn next(&mut self) -> Option<Self::Item> {
        if self.index >= self.used {
            return null;
        }
        let byte = self.repr[self.index];
        self.index += 1;
        return Option::Some(byte);
    }
}

/// Iterator over the Unicode scalar values (chars) of a String.
internal struct StrCharIter {
    repr: &Array<u8>,
    used: i32,
    byte_index: i32,
}

impl Iterator for StrCharIter {
    type Item = char;

    pub fn next(&mut self) -> Option<Self::Item> {
        if self.byte_index >= self.used {
            return null;
        }
        let [code, len] = decode_char_at(self.repr, self.byte_index);
        self.byte_index += len;
        return Option::Some(char::from_u32_unchecked(code));
    }
}

/// Iterator over characters paired with their byte indices.
internal struct StrCharIndicesIter {
    repr: &Array<u8>,
    used: i32,
    byte_index: i32,
}

impl Iterator for StrCharIndicesIter {
    type Item = [i32, char];

    pub fn next(&mut self) -> Option<Self::Item> {
        if self.byte_index >= self.used {
            return null;
        }
        let idx = self.byte_index;
        let [code, len] = decode_char_at(self.repr, self.byte_index);
        self.byte_index += len;
        return Option::Some([idx, char::from_u32_unchecked(code)]);
    }
}

/// Iterator over substrings split by a separator.
internal struct StrSplitIter {
    repr: &Array<u8>,
    used: i32,
    pos: i32,
    sep_repr: Array<u8>,
    sep_len: i32,
    finished: bool,
}

impl Iterator for StrSplitIter {
    type Item = String;

    pub fn next(&mut self) -> Option<Self::Item> {
        if self.finished {
            return null;
        }
        let sep = &self.sep_repr as &Array<u8>;
        let limit = self.used - self.sep_len;
        for let mut i = self.pos; i <= limit; i += 1 {
            if self.sep_len > 0 && bytes_match_at(self.repr, i, sep, self.sep_len) {
                let part = substring(self.repr, self.pos, i - self.pos);
                self.pos = i + self.sep_len;
                return Option::Some(part);
            }
        }
        self.finished = true;
        return Option::Some(substring(self.repr, self.pos, self.used - self.pos));
    }
}

/// Iterator over substrings split by a separator, limited to `n` parts.
internal struct StrSplitNIter {
    repr: &Array<u8>,
    used: i32,
    pos: i32,
    sep_repr: Array<u8>,
    sep_len: i32,
    remaining: i32,
    finished: bool,
}

impl Iterator for StrSplitNIter {
    type Item = String;

    pub fn next(&mut self) -> Option<Self::Item> {
        if self.finished {
            return null;
        }
        if self.remaining <= 1 {
            self.finished = true;
            return Option::Some(substring(self.repr, self.pos, self.used - self.pos));
        }
        let sep = &self.sep_repr as &Array<u8>;
        let limit = self.used - self.sep_len;
        for let mut i = self.pos; i <= limit; i += 1 {
            if self.sep_len > 0 && bytes_match_at(self.repr, i, sep, self.sep_len) {
                let part = substring(self.repr, self.pos, i - self.pos);
                self.pos = i + self.sep_len;
                self.remaining -= 1;
                return Option::Some(part);
            }
        }
        self.finished = true;
        return Option::Some(substring(self.repr, self.pos, self.used - self.pos));
    }
}

/// Iterator over whitespace-separated substrings.
internal struct StrSplitWhitespaceIter {
    repr: &Array<u8>,
    used: i32,
    pos: i32,
}

impl Iterator for StrSplitWhitespaceIter {
    type Item = String;

    pub fn next(&mut self) -> Option<Self::Item> {
        while self.pos < self.used && is_ascii_whitespace_byte(self.repr[self.pos]) {
            self.pos += 1;
        }
        if self.pos >= self.used {
            return null;
        }
        let start = self.pos;
        while self.pos < self.used && !is_ascii_whitespace_byte(self.repr[self.pos]) {
            self.pos += 1;
        }
        return Option::Some(substring(self.repr, start, self.pos - start));
    }
}

/// Iterator over the lines of a string (split on `\n` or `\r\n`).
internal struct StrLinesIter {
    repr: &Array<u8>,
    used: i32,
    pos: i32,
    finished: bool,
}

impl Iterator for StrLinesIter {
    type Item = String;

    pub fn next(&mut self) -> Option<Self::Item> {
        if self.finished {
            return null;
        }
        if self.pos >= self.used {
            self.finished = true;
            return null;
        }
        let start = self.pos;
        while self.pos < self.used {
            let b = self.repr[self.pos];
            if b == 0x0A {
                let part = substring(self.repr, start, self.pos - start);
                self.pos += 1;
                return Option::Some(part);
            }
            if b == 0x0D {
                let part = substring(self.repr, start, self.pos - start);
                self.pos += 1;
                if self.pos < self.used && self.repr[self.pos] == 0x0A {
                    self.pos += 1;
                }
                return Option::Some(part);
            }
            self.pos += 1;
        }
        self.finished = true;
        if self.pos > start {
            return Option::Some(substring(self.repr, start, self.pos - start));
        }
        return null;
    }
}

impl String {
    /// Create a new empty string.
    pub fn new() -> String {
        return String::with_capacity(0);
    }

    /// Create an empty string with space for `capacity` bytes.
    pub fn with_capacity(capacity: i32) -> String {
        return String { repr: builtin::array_new::<u8>(capacity) as ByteArray, used: 0 };
    }

    /// Get the length of the string in bytes
    pub fn len(&self) -> i32 {
        return self.used;
    }

    /// Check if the string is empty
    pub fn is_empty(&self) -> bool {
        return self.used == 0;
    }

    /// Read the byte at `index` without bounds checks. For safe access use `bytes()`.
    ///
    /// # Safety (caller-side preconditions)
    /// - `0 <= index < self.len()`.
    #[compiler_item("string_get_byte_unchecked")]
    pub fn get_byte_unchecked(&self, index: i32) -> u8 {
        return self.repr[index];
    }

    /// Write the byte at `index` without bounds or UTF-8 checks.
    ///
    /// # Safety (caller-side preconditions)
    /// - `0 <= index < self.len()`.
    /// - The resulting byte sequence must remain valid UTF-8.
    pub fn set_byte_unchecked(&mut self, index: i32, value: u8) {
        self.repr[index] = value;
    }

    /// Read-only view of the string's UTF-8 bytes as an `ArraySlice<u8>` over `[0, len())`.
    pub fn as_bytes(&self) -> ByteSlice with stores[self] {
        return ArraySlice::internal_new(&self.repr as &Array<u8>, 0, self.used) as ByteSlice;
    }

    /// Internal: shared reference to the string's bytes (stdlib use only).
    /// Caller must respect the `len()` boundary.
    internal fn internal_raw_bytes(&self) -> &Array<u8> {
        return &self.repr as &Array<u8>;
    }

    /// Internal: mutable reference to the string's bytes (stdlib use only).
    /// Caller must respect the `len()` boundary.
    internal fn internal_raw_bytes_mut(&mut self) -> &mut Array<u8> {
        return &mut self.repr as &mut Array<u8>;
    }

    /// Internal: wrap already-valid UTF-8 bytes as a `String` (stdlib use only).
    /// No validation is performed.
    internal fn internal_from_utf8_raw(bytes: Array<u8>, len: i32) -> String {
        return String { repr: bytes as ByteArray, used: len };
    }

    /// Reallocate to exactly `new_capacity` bytes, preserving the current contents.
    fn realloc_to(&mut self, new_capacity: i32) {
        let mut new_repr: Array<u8> = builtin::array_new(new_capacity);
        builtin::array_copy(&mut new_repr, 0, &self.repr as &Array<u8>, 0, self.used);
        self.repr = new_repr as ByteArray;
    }

    /// Ensure capacity for at least `min_capacity` bytes.
    pub fn grow(&mut self, min_capacity: i32) {
        let capacity = self.repr.len();
        if min_capacity <= capacity {
            return;
        }
        self.realloc_to(i32_max(i32_max(capacity * 2, min_capacity), 8));
    }

    /// Internal: reserve `n` uninitialised bytes at the end and return their offset
    /// (stdlib use only). The length is advanced immediately, so the caller MUST fill
    /// all `n` bytes.
    internal fn internal_reserve_uninit(&mut self, n: i32) -> i32 {
        let new_used = self.used + n;
        if new_used > self.repr.len() {
            builtin::cold_path();
            self.grow(new_used);
        }
        let start = self.used;
        self.used = new_used;
        return start;
    }

    /// Internal: Append `len` bytes from linear memory at `ptr` (stdlib use only).
    /// The bytes must be valid UTF-8. No validation is performed.
    internal fn internal_append_from_memory(&mut self, ptr: i32, len: i32) {
        if len == 0 {
            return;
        }
        let start = self.internal_reserve_uninit(len);
        for let mut i = 0; i < len; i += 1 {
            self.set_byte_unchecked(start + i, builtin::i32_load8_u(ptr + i));
        }
    }

    /// Append `n` copies of `byte` to this string.
    pub fn append_byte_filled(&mut self, byte: u8, n: i32) {
        if n <= 0 {
            return;
        }
        let start = self.internal_reserve_uninit(n);
        builtin::array_fill(&mut self.repr as &mut Array<u8>, start, byte, n);
    }

    /// Append another string to this one.
    #[compiler_item("string_push_str")]
    pub fn push_str(&mut self, other: &String) {
        let other_len = other.len();
        if other_len == 0 {
            return;
        }
        let start = self.internal_reserve_uninit(other_len);
        builtin::array_copy(&mut self.repr as &mut Array<u8>, start, &other.repr as &Array<u8>, 0, other_len);
    }

    /// Append the bytes of any `AsByteSlice` source (`ByteList`, `ByteArray`,
    /// `ByteSlice`, or a `String`).
    ///
    /// # Safety (caller-side preconditions)
    /// - The resulting byte sequence must remain valid UTF-8.
    pub fn push_bytes_unchecked<S: AsByteSlice>(&mut self, bytes: &S) {
        let slice = bytes.as_byte_slice();
        let n = slice.len();
        if n == 0 {
            return;
        }
        let start = self.internal_reserve_uninit(n);
        builtin::array_copy(&mut self.repr as &mut Array<u8>, start, slice.internal_repr(), slice.internal_start(), n);
    }

    /// Append the byte range `[start, end)` of `s` to this string.
    ///
    /// # Safety (caller-side preconditions)
    /// - `0 <= start <= end <= s.len()`.
    /// - `start` and `end` must lie on UTF-8 character boundaries of `s`.
    /// - The resulting byte sequence must remain valid UTF-8.
    pub fn push_str_range_unchecked(&mut self, s: &String, start: i32, end: i32) {
        let n = end - start;
        if n <= 0 {
            return;
        }
        let dst = self.internal_reserve_uninit(n);
        builtin::array_copy(&mut self.repr as &mut Array<u8>, dst, &s.repr as &Array<u8>, start, n);
    }

    /// Returns an iterator over the UTF-8 bytes of the string.
    pub fn bytes(&self) -> StrUtf8ByteIter with stores[self] {
        return StrUtf8ByteIter { repr: &self.repr as &Array<u8>, used: self.used, index: 0 };
    }

    /// Returns an iterator over the Unicode scalar values (chars) of the string.
    pub fn chars(&self) -> StrCharIter with stores[self] {
        return StrCharIter { repr: &self.repr as &Array<u8>, used: self.used, byte_index: 0 };
    }

    /// Returns an iterator over characters with their byte indices.
    pub fn char_indices(&self) -> StrCharIndicesIter with stores[self] {
        return StrCharIndicesIter { repr: &self.repr as &Array<u8>, used: self.used, byte_index: 0 };
    }

    /// Decode the whole string into a `List<char>`.
    pub fn to_chars(&self) -> List<char> {
        let bytes = self.as_bytes();
        let len = self.used;
        let mut chars: List<char> = List::with_capacity(len);
        let mut i = 0;
        while i < len {
            let b0 = bytes.get_unchecked(i);
            if b0 < 0x80 {
                chars.push(char::from_u32_unchecked(b0 as u32));
                i += 1;
                continue;
            }
            let scalar = decode_utf8_scalar(bytes, i, len);
            chars.push(char::from_u32_unchecked(scalar.code));
            i += scalar.advance;
        }
        return chars;
    }

    /// Decodes the UTF-8 character starting at the given byte index.
    /// Returns None if `byte_index` is past the end of the string or there
    /// aren't enough bytes to form a full UTF-8 sequence.
    /// Assumes `byte_index` is on a character boundary (the string is valid UTF-8).
    pub fn char_at_byte(&self, byte_index: i32) -> Option<char> {
        if byte_index >= self.used {
            return null;
        }
        if byte_index + utf8_seq_len(self.repr[byte_index]) > self.used {
            return null;
        }
        return Option::Some(self.char_at_byte_unchecked(byte_index));
    }

    /// Decodes the UTF-8 character starting at `byte_index` without bounds checks.
    ///
    /// # Safety (caller-side preconditions)
    /// - `byte_index` lies on a UTF-8 character boundary.
    /// - The full multi-byte sequence (1–4 bytes) starting at `byte_index`
    ///   is in range `[0, self.len())`.
    pub fn char_at_byte_unchecked(&self, byte_index: i32) -> char {
        return char::from_u32_unchecked(decode_char_at(&self.repr as &Array<u8>, byte_index).0);
    }

    /// Appends a Unicode scalar value (char) to this string.
    #[compiler_item("string_push_char")]
    pub fn push(&mut self, c: char) {
        let code = c as u32;
        if code < 0x80 {
            self.push_ascii_unchecked(code as u8);
            return;
        }
        if self.used + 4 > self.repr.len() {
            builtin::cold_path();
            self.grow(self.used + 4);
        }
        self.used += encode_char(&mut self.repr as &mut Array<u8>, self.used, code);
    }

    /// Appends a single byte, assumed to be a complete one-byte UTF-8 sequence
    /// (`byte < 0x80`). A larger byte breaks the String's UTF-8 invariant — the
    /// `_unchecked` contract.
    ///
    /// `push` routes its ASCII fast path here, and the optimizer's
    /// `nir/const_ascii_push` rewrite retargets `push(<const char < 0x80>)`
    /// here directly, skipping `encode_char`'s width dispatch.
    #[compiler_item("string_push_ascii")]
    pub fn push_ascii_unchecked(&mut self, byte: u8) {
        let start = self.internal_reserve_uninit(1);
        self.set_byte_unchecked(start, byte);
    }

    /// Truncates the string to the given byte length.
    /// Panics if `byte_len` is negative or not on a UTF-8 character boundary.
    pub fn truncate(&mut self, byte_len: i32) {
        if byte_len >= self.used {
            return;
        }
        assert byte_len >= 0, "negative length";
        assert self.is_char_boundary(byte_len), "not on a UTF-8 character boundary";
        self.truncate_unchecked(byte_len);
    }

    /// Truncate without bounds or UTF-8 boundary checks.
    ///
    /// # Safety (caller-side preconditions)
    /// - `0 <= byte_len <= self.len()`.
    /// - `byte_len` lies on a UTF-8 character boundary.
    pub fn truncate_unchecked(&mut self, byte_len: i32) {
        self.used = byte_len;
    }

    /// Truncate the string to the given number of characters.
    /// If `char_count` >= number of characters, the string is unchanged.
    pub fn truncate_chars(&mut self, char_count: i32) {
        let mut byte_pos = 0;
        let mut chars_seen = 0;
        while byte_pos < self.used && chars_seen < char_count {
            byte_pos += utf8_seq_len(self.repr[byte_pos]);
            chars_seen += 1;
        }
        self.used = byte_pos;
    }

    /// Returns true if `byte_index` is 0, `self.len()`, or the start of a
    /// UTF-8 character in this string.
    pub fn is_char_boundary(&self, byte_index: i32) -> bool {
        if byte_index == 0 || byte_index == self.used {
            return true;
        }
        if byte_index < 0 || byte_index > self.used {
            return false;
        }
        // A continuation byte has the form 10xxxxxx (0x80..=0xBF).
        let b = self.repr[byte_index];
        return b < 0x80 || b >= 0xC0;
    }

    /// Removes and returns the last character, or None if empty.
    pub fn pop(&mut self) -> Option<char> {
        if self.used == 0 {
            return null;
        }
        let pos = char_start_backward(&self.repr as &Array<u8>, self.used - 1);
        let code = decode_char_at(&self.repr as &Array<u8>, pos).0;
        self.used = pos;
        return Option::Some(char::from_u32_unchecked(code));
    }

    /// Removes all contents, making the string empty.
    pub fn clear(&mut self) {
        self.used = 0;
    }

    /// Returns the total capacity in bytes.
    pub fn capacity(&self) -> i32 {
        return self.repr.len();
    }

    /// Reserves capacity for at least `additional` more bytes.
    pub fn reserve(&mut self, additional: i32) {
        let required = self.used + additional;
        if required > self.repr.len() {
            self.grow(required);
        }
    }

    /// Shrinks the capacity to match the current byte length.
    pub fn shrink_to_fit(&mut self) {
        if self.repr.len() > self.used {
            self.realloc_to(self.used);
        }
    }

    /// Returns a new string with leading ASCII whitespace removed.
    pub fn trim_ascii_start(&self) -> String {
        let mut start = 0;
        while start < self.used && is_ascii_whitespace_byte(self.repr[start]) {
            start += 1;
        }
        return self.substr_bytes(start, self.used);
    }

    /// Returns a new string with trailing ASCII whitespace removed.
    pub fn trim_ascii_end(&self) -> String {
        let mut end = self.used;
        while end > 0 && is_ascii_whitespace_byte(self.repr[end - 1]) {
            end -= 1;
        }
        return self.substr_bytes(0, end);
    }

    /// Returns a new string with leading and trailing ASCII whitespace removed.
    pub fn trim_ascii(&self) -> String {
        return self.trim_ascii_start().trim_ascii_end();
    }

    /// Returns a new string with leading Unicode whitespace removed.
    pub fn trim_start(&self) -> String {
        let mut iter = self.chars();
        let mut start = 0;
        while let Some(c) = iter.next() {
            if !c.is_whitespace() {
                break;
            }
            start += c.len_utf8();
        }
        return self.substr_bytes(start, self.used);
    }

    /// Returns a new string with trailing Unicode whitespace removed.
    pub fn trim_end(&self) -> String {
        let repr = &self.repr as &Array<u8>;
        let mut end = self.used;
        while end > 0 {
            let pos = char_start_backward(repr, end - 1);
            let ch = char::from_u32_unchecked(decode_char_at(repr, pos).0);
            if !ch.is_whitespace() {
                break;
            }
            end = pos;
        }
        return self.substr_bytes(0, end);
    }

    /// Returns a new string with leading and trailing Unicode whitespace removed.
    pub fn trim(&self) -> String {
        return self.trim_start().trim_end();
    }

    /// Returns a new string with all ASCII uppercase letters converted to lowercase.
    /// Non-ASCII bytes are left unchanged.
    pub fn to_ascii_lowercase(&self) -> String {
        return String::from_iter(self.chars().map(|c: char| c.to_ascii_lowercase()));
    }

    /// Returns a new string with all ASCII lowercase letters converted to uppercase.
    /// Non-ASCII bytes are left unchanged.
    pub fn to_ascii_uppercase(&self) -> String {
        return String::from_iter(self.chars().map(|c: char| c.to_ascii_uppercase()));
    }

    /// Checks that two strings are an ASCII case-insensitive match.
    /// Non-ASCII bytes are compared exactly.
    pub fn eq_ignore_ascii_case(&self, other: String) -> bool {
        let len = self.len();
        if len != other.len() {
            return false;
        }
        let a = &self.repr as &Array<u8>;
        let b = &other.repr as &Array<u8>;
        for let mut i = 0; i < len; i += 1 {
            if byte_to_ascii_lowercase(a[i]) != byte_to_ascii_lowercase(b[i]) {
                return false;
            }
        }
        return true;
    }

    /// Extract a substring by byte range `[start, end)`.
    /// Panics if the range is out of bounds or either end is not on a UTF-8 boundary.
    pub fn substr_bytes(&self, start: i32, end: i32) -> String {
        assert 0 <= start && start <= end && end <= self.used, "byte range out of bounds";
        assert self.is_char_boundary(start) && self.is_char_boundary(end), "byte range not on UTF-8 character boundaries";
        return self.substr_bytes_unchecked(start, end);
    }

    /// Extract a substring by byte range `[start, end)` without bounds or
    /// UTF-8 boundary checks.
    ///
    /// # Safety (caller-side preconditions)
    /// - `0 <= start <= end <= self.len()`.
    /// - `start` and `end` lie on UTF-8 character boundaries.
    pub fn substr_bytes_unchecked(&self, start: i32, end: i32) -> String {
        if end <= start {
            return String::with_capacity(0);
        }
        return substring(&self.repr as &Array<u8>, start, end - start);
    }

    /// Returns true if this string contains the given substring.
    pub fn contains(&self, pat: String) -> bool {
        return self.find(pat) matches { Some(_) };
    }

    /// Returns true if this string starts with the given prefix.
    pub fn starts_with(&self, pat: String) -> bool {
        let pat_len = pat.len();
        if pat_len > self.used {
            return false;
        }
        return bytes_match_at(&self.repr as &Array<u8>, 0, &pat.repr as &Array<u8>, pat_len);
    }

    /// Returns true if this string ends with the given suffix.
    pub fn ends_with(&self, pat: String) -> bool {
        let pat_len = pat.len();
        if pat_len > self.used {
            return false;
        }
        return bytes_match_at(&self.repr as &Array<u8>, self.used - pat_len, &pat.repr as &Array<u8>, pat_len);
    }

    /// Returns the string with `prefix` removed from the front, or None when it
    /// does not start with `prefix`.
    pub fn strip_prefix(&self, prefix: String) -> Option<String> {
        if !self.starts_with(prefix) {
            return null;
        }
        let start = prefix.len();
        return Option::Some(substring(&self.repr as &Array<u8>, start, self.used - start));
    }

    /// Returns the string with `suffix` removed from the end, or None when it
    /// does not end with `suffix`.
    pub fn strip_suffix(&self, suffix: String) -> Option<String> {
        if !self.ends_with(suffix) {
            return null;
        }
        return Option::Some(substring(&self.repr as &Array<u8>, 0, self.used - suffix.len()));
    }

    /// Returns the byte index of the first occurrence of `pat`, or None.
    pub fn find(&self, pat: String) -> Option<i32> {
        let pat_len = pat.len();
        if pat_len == 0 {
            return Option::Some(0);
        }
        if pat_len > self.used {
            return null;
        }
        let self_repr = &self.repr as &Array<u8>;
        let pat_repr = &pat.repr as &Array<u8>;
        let limit = self.used - pat_len;
        for let mut i = 0; i <= limit; i += 1 {
            if bytes_match_at(self_repr, i, pat_repr, pat_len) {
                return Option::Some(i);
            }
        }
        return null;
    }

    /// Returns the byte index of the last occurrence of `pat`, or None.
    pub fn rfind(&self, pat: String) -> Option<i32> {
        let pat_len = pat.len();
        if pat_len == 0 {
            return Option::Some(self.used);
        }
        if pat_len > self.used {
            return null;
        }
        let self_repr = &self.repr as &Array<u8>;
        let pat_repr = &pat.repr as &Array<u8>;
        let mut i = self.used - pat_len;
        loop {
            if bytes_match_at(self_repr, i, pat_repr, pat_len) {
                return Option::Some(i);
            }
            if i == 0 {
                break;
            }
            i -= 1;
        }
        return null;
    }

    /// Returns true if the string contains the given character.
    pub fn contains_char(&self, ch: char) -> bool {
        for let c of self.chars() {
            if c == ch {
                return true;
            }
        }
        return false;
    }

    /// Returns the byte index of the first character matching the predicate, or None.
    pub fn find_char(&self, mut pred: fn mut(char) -> bool) -> Option<i32> {
        let mut iter = self.chars();
        for let mut byte_index = 0; let Some(c) = iter.next(); byte_index += c.len_utf8() {
            if pred(c) {
                return Option::Some(byte_index);
            }
        }
        return null;
    }

    /// Grow if needed and shift the bytes from `byte_index` onward right by `width`,
    /// leaving an uninitialised gap `[byte_index, byte_index + width)`. Advances the
    /// length.
    fn make_gap(&mut self, byte_index: i32, width: i32) {
        let new_used = self.used + width;
        if new_used > self.repr.len() {
            self.grow(new_used);
        }
        builtin::array_copy(
            &mut self.repr as &mut Array<u8>,
            byte_index + width,
            &self.repr as &Array<u8>,
            byte_index,
            self.used - byte_index,
        );
        self.used = new_used;
    }

    /// Inserts a character at the given byte index.
    /// Panics if `byte_index` is out of bounds or not on a UTF-8 character boundary.
    pub fn insert(&mut self, byte_index: i32, ch: char) {
        assert self.is_char_boundary(byte_index), "insert index not on UTF-8 character boundary";
        self.insert_unchecked(byte_index, ch);
    }

    /// Inserts a character at `byte_index` without bounds or UTF-8 boundary checks.
    ///
    /// # Safety (caller-side preconditions)
    /// - `0 <= byte_index <= self.len()`.
    /// - `byte_index` lies on a UTF-8 character boundary.
    pub fn insert_unchecked(&mut self, byte_index: i32, ch: char) {
        self.make_gap(byte_index, ch.len_utf8());
        encode_char(&mut self.repr as &mut Array<u8>, byte_index, ch as u32);
    }

    /// Inserts a string at the given byte index.
    /// Panics if `byte_index` is out of bounds or not on a UTF-8 character boundary.
    pub fn insert_str(&mut self, byte_index: i32, s: String) {
        assert self.is_char_boundary(byte_index), "insert_str index not on UTF-8 character boundary";
        self.insert_str_unchecked(byte_index, s);
    }

    /// Inserts a string at `byte_index` without bounds or UTF-8 boundary checks.
    ///
    /// # Safety (caller-side preconditions)
    /// - `0 <= byte_index <= self.len()`.
    /// - `byte_index` lies on a UTF-8 character boundary.
    pub fn insert_str_unchecked(&mut self, byte_index: i32, s: String) {
        let s_len = s.len();
        if s_len == 0 {
            return;
        }
        self.make_gap(byte_index, s_len);
        builtin::array_copy(&mut self.repr as &mut Array<u8>, byte_index, &s.repr as &Array<u8>, 0, s_len);
    }

    /// Removes and returns the character at the given byte index.
    /// Panics if the index is out of bounds or not on a UTF-8 character boundary.
    pub fn remove(&mut self, byte_index: i32) -> char {
        assert byte_index >= 0 && byte_index < self.used, "index out of bounds";
        assert self.is_char_boundary(byte_index), "remove index not on UTF-8 character boundary";
        return self.remove_unchecked(byte_index);
    }

    /// Removes and returns the character at `byte_index` without bounds or
    /// UTF-8 boundary checks.
    ///
    /// # Safety (caller-side preconditions)
    /// - `0 <= byte_index < self.len()`.
    /// - `byte_index` lies on a UTF-8 character boundary.
    pub fn remove_unchecked(&mut self, byte_index: i32) -> char {
        let [code, char_len] = decode_char_at(&self.repr as &Array<u8>, byte_index);
        builtin::array_copy(
            &mut self.repr as &mut Array<u8>,
            byte_index,
            &self.repr as &Array<u8>,
            byte_index + char_len,
            self.used - byte_index - char_len,
        );
        self.used -= char_len;
        return char::from_u32_unchecked(code);
    }

    /// Returns this string repeated `n` times.
    pub fn repeat(&self, n: i32) -> String {
        if n <= 0 || self.used == 0 {
            return String::with_capacity(0);
        }
        let total = self.used * n;
        let src = &self.repr as &Array<u8>;
        let mut repr: Array<u8> = builtin::array_new(total);
        for let mut r = 0; r < n; r += 1 {
            builtin::array_copy(&mut repr, r * self.used, src, 0, self.used);
        }
        return String { repr: repr as ByteArray, used: total };
    }

    /// Replaces all occurrences of `from` with `to`.
    pub fn replace(&self, from: String, to: String) -> String {
        return self.replacen(from, to, -1);
    }

    /// Replaces the first `count` occurrences of `from` with `to`.
    /// If `count` is negative, replaces all occurrences.
    pub fn replacen(&self, from: String, to: String, count: i32) -> String {
        let from_len = from.len();
        if from_len == 0 {
            return *self;
        }
        let self_repr = &self.repr as &Array<u8>;
        let from_repr = &from.repr as &Array<u8>;
        let mut result = String::with_capacity(self.used);
        let mut pos = 0;
        let mut replacements = 0;
        let limit = self.used - from_len;
        while pos <= limit {
            if count >= 0 && replacements >= count {
                break;
            }
            if bytes_match_at(self_repr, pos, from_repr, from_len) {
                result.push_str(&to);
                pos += from_len;
                replacements += 1;
            } else {
                let dst = result.internal_reserve_uninit(1);
                result.set_byte_unchecked(dst, self.repr[pos]);
                pos += 1;
            }
        }
        if pos < self.used {
            result.push_str_range_unchecked(self, pos, self.used);
        }
        return result;
    }

    /// Build a `String` from an iterable of chars.
    pub fn from_iter<I: IntoIterator<Item = char>>(iter: I) -> String {
        let mut s = String::with_capacity(8);
        for let c of iter {
            s.push(c);
        }
        return s;
    }

    /// Build a `String` from an iterable of bytes, validating UTF-8.
    /// `Ok(String)` on success, `Err(message)` on invalid UTF-8.
    pub fn from_utf8<I: IntoIterator<Item = u8>>(bytes: I) -> Result<String, String> {
        let collected: List<u8> = bytes.into_iter().collect();
        return String::from_utf8_slice(collected.as_slice());
    }

    /// Validate a contiguous byte slice as UTF-8 and wrap it as a `String`.
    pub fn from_utf8_slice(bytes: ByteSlice) -> Result<String, String> {
        let len = bytes.len();
        let mut i = 0;
        while i < len {
            let scalar = decode_utf8_scalar(bytes, i, len);
            if !scalar.valid {
                builtin::cold_path();
                return Result::Err(`invalid UTF-8 at byte ${i}`);
            }
            i += scalar.advance;
        }
        return Result::Ok(String {
            repr: bytes.to_array() as ByteArray,
            used: bytes.len(),
        });
    }

    /// Whether `bytes` is well-formed UTF-8.
    pub fn is_valid_utf8(bytes: ByteSlice) -> bool {
        let len = bytes.len();
        let mut i = 0;
        while i < len {
            let scalar = decode_utf8_scalar(bytes, i, len);
            if !scalar.valid {
                builtin::cold_path();
                return false;
            }
            i += scalar.advance;
        }
        return true;
    }

    /// Build a `String` from an iterable of bytes, replacing invalid UTF-8 with U+FFFD.
    pub fn from_utf8_lossy<I: IntoIterator<Item = u8>>(bytes: I) -> String {
        let collected: List<u8> = bytes.into_iter().collect();
        let slice = collected.as_slice() as ByteSlice;
        if let Ok(s) = String::from_utf8_slice(slice) {
            return s;
        }
        builtin::cold_path();
        let len = slice.len();
        let mut builder = String::with_capacity(len);
        let mut i = 0;
        while i < len {
            let scalar = decode_utf8_scalar(slice, i, len);
            if scalar.valid {
                builder.push(char::from_u32_unchecked(scalar.code));
            } else {
                builder.push('\uFFFD');
            }
            i += scalar.advance;
        }
        return builder;
    }

    /// Build a `String` from an iterable of bytes without UTF-8 validation.
    ///
    /// # Safety
    /// The caller must ensure the bytes form valid UTF-8.
    pub fn from_utf8_unchecked<I: IntoIterator<Item = u8>>(bytes: I) -> String {
        let mut builder = String::with_capacity(8);
        for let b of bytes {
            let idx = builder.internal_reserve_uninit(1);
            builder.set_byte_unchecked(idx, b);
        }
        return builder;
    }

    /// Returns an iterator over substrings split by the given separator.
    pub fn split(&self, sep: String) -> StrSplitIter with stores[self] {
        let sep_len = sep.len();
        return StrSplitIter {
            repr: &self.repr as &Array<u8>,
            used: self.used,
            pos: 0,
            sep_repr: sep.repr as Array<u8>,
            sep_len,
            finished: false,
        };
    }

    /// Returns an iterator over at most `n` substrings split by the given separator.
    pub fn splitn(&self, n: i32, sep: String) -> StrSplitNIter with stores[self] {
        let sep_len = sep.len();
        return StrSplitNIter {
            repr: &self.repr as &Array<u8>,
            used: self.used,
            pos: 0,
            sep_repr: sep.repr as Array<u8>,
            sep_len,
            remaining: n,
            finished: n <= 0,
        };
    }

    /// Returns an iterator over whitespace-separated substrings.
    pub fn split_whitespace(&self) -> StrSplitWhitespaceIter with stores[self] {
        return StrSplitWhitespaceIter { repr: &self.repr as &Array<u8>, used: self.used, pos: 0 };
    }

    /// Returns an iterator over the lines of this string.
    pub fn lines(&self) -> StrLinesIter with stores[self] {
        return StrLinesIter { repr: &self.repr as &Array<u8>, used: self.used, pos: 0, finished: false };
    }
}

impl Add for String {
    type Output = String;

    pub fn add(&self, other: &Self) -> Self::Output {
        let mut result = String::with_capacity(self.len() + other.len());
        result.push_str(self);
        result.push_str(other);
        return result;
    }
}

impl Eq for String {
    pub fn eq(&self, other: &Self) -> bool {
        let len = self.len();
        if len != other.len() {
            return false;
        }
        return bytes_match_at(&self.repr as &Array<u8>, 0, &other.repr as &Array<u8>, len);
    }
}

impl LenientFromStr for String {
    type Err = LenientParseError;

    /// Identity: any string parses to itself. Never fails.
    fn from_str_lenient(s: &String) -> Result<String, LenientParseError> {
        return Result::Ok(*s);
    }
}

impl Ord for String {
    pub fn cmp(&self, other: &Self) -> Ordering {
        let len_a = self.len();
        let len_b = other.len();
        let min_len = i32_min(len_a, len_b);

        let a_repr = &self.repr as &Array<u8>;
        let b_repr = &other.repr as &Array<u8>;
        for let mut i = 0; i < min_len; i += 1 {
            let a_byte = a_repr[i];
            let b_byte = b_repr[i];
            if a_byte < b_byte {
                return Ordering::Less;
            }
            if a_byte > b_byte {
                return Ordering::Greater;
            }
        }

        if len_a < len_b {
            return Ordering::Less;
        }
        if len_a > len_b {
            return Ordering::Greater;
        }
        return Ordering::Equal;
    }
}

impl Default for String {
    pub fn default() -> String {
        return "";
    }
}

impl From<char> for String {
    pub fn from(value: char) -> String {
        let mut s = String::with_capacity(4);
        s.push(value);
        return s;
    }
}
