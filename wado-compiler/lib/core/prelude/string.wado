#![no_prelude]
#![stdlib("core:prelude/string.wado")]
// Split from the prelude so other stdlib modules can depend on String without a cycle.


use { Eq, Ord, Iterator, IntoIterator, Add, Default, Display, Error, From, Ordering } from "core:prelude/traits.wado";
use { LenientFromStr, LenientParseError } from "core:prelude/traits.wado";
use { IterMap, IterFilter, IterEnumerate, IterTake, IterSkip, IterChain, IterZip } from "core:prelude/traits.wado";
use { ReflectTemplate } from "core:prelude/traits.wado";
use { Formatter } from "core:prelude/format.wado";
use { Option, Result } from "core:prelude/types.wado";
use { Slice } from "core:prelude/slice.wado";
use { Array, seq_eq, seq_cmp } from "core:prelude/array.wado";
use { List } from "core:prelude/list.wado";
use { ByteSlice, ByteList, ByteArray, AsByteSlice } from "core:prelude/bytes.wado";

/// Why a byte sequence is not valid UTF-8: where the valid part ends, and
/// whether what follows is malformed or merely cut short.
pub struct Utf8Error {
    valid_up_to: i32,
    error_len: Option<i32>,
}

impl Utf8Error {
    /// A sequence no further byte could complete, `len` bytes long.
    pub fn invalid(valid_up_to: i32, len: i32) -> Utf8Error {
        assert len >= 1 && len <= 3;
        return Utf8Error { valid_up_to, error_len: Option::Some(len) };
    }

    /// A sequence the input ends in the middle of.
    pub fn incomplete(valid_up_to: i32) -> Utf8Error {
        return Utf8Error { valid_up_to, error_len: Option::None };
    }

    /// Byte offset at which the first invalid sequence begins.
    pub fn valid_up_to(&self) -> i32 {
        return self.valid_up_to;
    }

    /// Length of the invalid sequence, or `None` when the input just ends short
    /// and more bytes could still complete it.
    pub fn error_len(&self) -> Option<i32> {
        return self.error_len;
    }

    /// The same failure, with its offset read from `base` instead of from the
    /// start of the decoded buffer. A caller decoding a stream in pieces owes
    /// this, or it reports a position into a buffer its own caller never saw.
    pub fn rebased(&self, base: i32) -> Utf8Error {
        return Utf8Error { ..*self, valid_up_to: base + self.valid_up_to };
    }
}

impl Display for Utf8Error {
    fn fmt(&self, f: &mut Formatter) {
        match self.error_len {
            Some(n) => f.write_str(`invalid utf-8 sequence of ${n} bytes from index ${self.valid_up_to}`),
            None => f.write_str(`incomplete utf-8 byte sequence from index ${self.valid_up_to}`),
        }
    }
}

impl Error for Utf8Error {
}

/// Byte length (1–4) of the UTF-8 sequence led by `b0`, assuming valid UTF-8.
#[inline]
fn utf8_seq_len(b0: u8) -> i32 {
    if b0 < 0x80 {
        return 1;
    }
    if b0 < 0xE0 {
        return 2;
    }
    if b0 < 0xF0 {
        return 3;
    }
    return 4;
}

/// Decode the UTF-8 scalar at byte offset `pos`, returning `[code_point, byte_length]`.
/// Assumes valid UTF-8 with the full sequence in range.
#[inline]
fn decode_char_at(repr: &Array<u8>, pos: i32) -> [u32, i32] {
    let b0 = repr[pos] as u32;
    if b0 < 0x80 {
        return [b0, 1];
    }
    if b0 < 0xE0 {
        let b1 = repr[pos + 1] as u32;
        return [(b0 & 0x1F) << 6 | b1 & 0x3F, 2];
    }
    if b0 < 0xF0 {
        let b1 = repr[pos + 1] as u32;
        let b2 = repr[pos + 2] as u32;
        return [(b0 & 0x0F) << 12 | (b1 & 0x3F) << 6 | b2 & 0x3F, 3];
    }
    let b1 = repr[pos + 1] as u32;
    let b2 = repr[pos + 2] as u32;
    let b3 = repr[pos + 3] as u32;
    return [(b0 & 0x07) << 18 | (b1 & 0x3F) << 12 | (b2 & 0x3F) << 6 | b3 & 0x3F, 4];
}

/// Encode `code` as UTF-8 at byte offset `pos`, returning the byte length (1–4).
/// `[pos, pos + len)` must be in bounds.
#[inline]
fn encode_char(repr: &mut Array<u8>, pos: i32, code: u32) -> i32 {
    if code < 0x80 {
        repr[pos] = code as u8;
        return 1;
    }
    if code < 0x800 {
        repr[pos] = (0xC0 | code >> 6) as u8;
        repr[pos + 1] = (0x80 | code & 0x3F) as u8;
        return 2;
    }
    if code < 0x10000 {
        repr[pos] = (0xE0 | code >> 12) as u8;
        repr[pos + 1] = (0x80 | code >> 6 & 0x3F) as u8;
        repr[pos + 2] = (0x80 | code & 0x3F) as u8;
        return 3;
    }
    repr[pos] = (0xF0 | code >> 18) as u8;
    repr[pos + 1] = (0x80 | code >> 12 & 0x3F) as u8;
    repr[pos + 2] = (0x80 | code >> 6 & 0x3F) as u8;
    repr[pos + 3] = (0x80 | code & 0x3F) as u8;
    return 4;
}

/// True when `b` opens a UTF-8 sequence rather than continuing one. A
/// continuation byte has the form 10xxxxxx (0x80..=0xBF).
#[inline]
internal fn is_char_start(b: u8) -> bool {
    return b & 0xC0 != 0x80;
}

/// True when `b1` may follow the lead byte `b0`: a continuation byte, within
/// the narrower range that rules out an overlong form, a surrogate, or a scalar
/// above U+10FFFF.
#[inline]
fn utf8_second_byte_ok(b0: u8, b1: u8) -> bool {
    if is_char_start(b1) {
        return false;
    }
    return match b0 {
        0xE0 => b1 >= 0xA0,
        0xED => b1 < 0xA0,
        0xF0 => b1 >= 0x90,
        0xF4 => b1 <= 0x8F,
        _ => true,
    };
}

/// Return the start offset of the UTF-8 sequence containing byte `pos`.
fn char_start_backward(repr: &Array<u8>, pos: i32) -> i32 {
    let mut p = pos;
    while p > 0 && !is_char_start(repr[p]) {
        p -= 1;
    }
    return p;
}

/// Byte end, counted from `start`, of the leading `char_count` characters of
/// `repr[start..start + len)`, or `len` when it holds fewer.
fn utf8_prefix_end(repr: &Array<u8>, start: i32, len: i32, char_count: i32) -> i32 {
    let mut end = 0;
    let mut seen = 0;
    while end < len && seen < char_count {
        end += utf8_seq_len(repr[start + end]);
        seen += 1;
    }
    if end > len {
        return len;
    }
    return end;
}

/// True when `index`, counted from `start`, is 0, `len`, or the start of a
/// UTF-8 character.
fn boundary_at(repr: &Array<u8>, start: i32, len: i32, index: i32) -> bool {
    if index == 0 || index == len {
        return true;
    }
    if index < 0 || index > len {
        return false;
    }
    return is_char_start(repr[start + index]);
}

/// The nearest character boundary at or below `index`, counted from `start`;
/// `len` when `index >= len`. Panics if `index` is negative.
fn floor_boundary(repr: &Array<u8>, start: i32, len: i32, index: i32) -> i32 {
    if index as u32 >= len as u32 {
        builtin::cold_path();
        assert index >= 0, "negative byte index";
        return len;
    }
    return char_start_backward(repr, start + index) - start;
}

/// The nearest character boundary at or above `index`, counted from `start`;
/// `len` when `index >= len`. Panics if `index` is negative.
fn ceil_boundary(repr: &Array<u8>, start: i32, len: i32, index: i32) -> i32 {
    if index as u32 >= len as u32 {
        builtin::cold_path();
        assert index >= 0, "negative byte index";
        return len;
    }
    let mut p = index;
    while p < len && !is_char_start(repr[start + p]) {
        p += 1;
    }
    return p;
}

/// True if `needle[0..needle_len)` equals `haystack[pos..pos+needle_len)`.
/// Caller ensures `pos + needle_len <= haystack.len()`.
#[inline]
fn bytes_match_at(haystack: &Array<u8>, pos: i32, needle: &Array<u8>, needle_at: i32, needle_len: i32) -> bool {
    for let mut j = 0; j < needle_len; j += 1 {
        if haystack[pos + j] != needle[needle_at + j] {
            return false;
        }
    }
    return true;
}

/// One UTF-8 scalar decoded from a byte slice.
struct Utf8Scalar {
    /// Decoded code point; meaningful only when `valid`.
    code: u32,
    /// Bytes advanced: when `valid`, the sequence length (1–4); when invalid,
    /// the prefix (>= 1) to skip before resuming.
    advance: i32,
    valid: bool,
}

/// Decode and validate the UTF-8 scalar at `bytes[start..len)`.
fn decode_utf8_scalar(bytes: ByteSlice, start: i32, len: i32) -> Utf8Scalar {
    let n = String::utf8_sequence_len(&bytes, start, len);
    if n <= 0 {
        builtin::cold_path();
        // A malformed sequence skips the prefix that was accepted; a truncated
        // one skips what the input holds, since no further byte will arrive.
        let advance = if n == 0 { String::utf8_invalid_len(&bytes, start) } else { len - start };
        return Utf8Scalar { code: 0, advance, valid: false };
    }
    let b0 = bytes.get_unchecked(start) as u32;
    if n == 1 {
        return Utf8Scalar { code: b0, advance: 1, valid: true };
    }
    assert n >= 2 && n <= 4;
    let lead_mask: u32 = match n {
        2 => 0x1F,
        3 => 0x0F,
        _ => 0x07,
    };
    let mut code = b0 & lead_mask;
    for let mut i = 1; i < n; i += 1 {
        code = code << 6 | bytes.get_unchecked(start + i) as u32 & 0x3F;
    }
    return Utf8Scalar { code, advance: n, valid: true };
}

/// A UTF-8 encoded, growable string.
#[compiler_item("string")]
pub struct String {
    repr: ByteArray,
    used: i32,
}

/// Copy `len` bytes from offset `start` into a fresh `String` (bytes assumed valid UTF-8).
fn substring(repr: &Array<u8>, start: i32, len: i32) -> String {
    let mut part: Array<u8> = builtin::array_new(len);
    builtin::array_copy(&mut part, 0, repr, start, len);
    return String { repr: part as ByteArray, used: len };
}

/// Iterator over the raw UTF-8 bytes of a String, yielding each as `u8`.
pub struct StrUtf8ByteIter {
    repr: &Array<u8>,
    used: i32,
    index: i32,
}

impl Iterator for StrUtf8ByteIter {
    type Item = u8;

    #[inline]
    pub fn next(&mut self) -> Option<Self::Item> {
        if self.index >= self.used {
            return null;
        }
        let byte = self.repr[self.index];
        self.index += 1;
        return Option::Some(byte);
    }
}

/// Iterator over the Unicode scalar values (chars) of a String.
pub struct StrCharIter {
    repr: &Array<u8>,
    used: i32,
    byte_index: i32,
}

impl Iterator for StrCharIter {
    type Item = char;

    pub fn next(&mut self) -> Option<Self::Item> {
        if self.byte_index >= self.used {
            return null;
        }
        let [code, len] = decode_char_at(self.repr, self.byte_index);
        self.byte_index += len;
        return Option::Some(char::from_u32_unchecked(code));
    }
}

/// Iterator over characters paired with their byte indices.
pub struct StrCharIndicesIter {
    repr: &Array<u8>,
    used: i32,
    byte_index: i32,
    /// Where the viewed text starts in `repr`. Yielded indices count from it,
    /// as every other `StrSlice` index does.
    base: i32,
}

impl Iterator for StrCharIndicesIter {
    type Item = [i32, char];

    pub fn next(&mut self) -> Option<Self::Item> {
        if self.byte_index >= self.used {
            return null;
        }
        let idx = self.byte_index - self.base;
        let [code, len] = decode_char_at(self.repr, self.byte_index);
        self.byte_index += len;
        return Option::Some([idx, char::from_u32_unchecked(code)]);
    }
}

/// Iterator over substrings split by a separator.
pub struct StrSplitIter {
    repr: &Array<u8>,
    used: i32,
    pos: i32,
    sep_repr: &Array<u8>,
    sep_at: i32,
    sep_len: i32,
    finished: bool,
}

impl Iterator for StrSplitIter {
    type Item = String;

    pub fn next(&mut self) -> Option<Self::Item> {
        if self.finished {
            return null;
        }
        let limit = self.used - self.sep_len;
        for let mut i = self.pos; i <= limit; i += 1 {
            if self.sep_len > 0 && bytes_match_at(self.repr, i, self.sep_repr, self.sep_at, self.sep_len) {
                let part = substring(self.repr, self.pos, i - self.pos);
                self.pos = i + self.sep_len;
                return Option::Some(part);
            }
        }
        self.finished = true;
        return Option::Some(substring(self.repr, self.pos, self.used - self.pos));
    }
}

/// Iterator over substrings split by a separator, limited to `n` parts.
pub struct StrSplitNIter {
    repr: &Array<u8>,
    used: i32,
    pos: i32,
    sep_repr: &Array<u8>,
    sep_at: i32,
    sep_len: i32,
    remaining: i32,
    finished: bool,
}

impl Iterator for StrSplitNIter {
    type Item = String;

    pub fn next(&mut self) -> Option<Self::Item> {
        if self.finished {
            return null;
        }
        if self.remaining <= 1 {
            self.finished = true;
            return Option::Some(substring(self.repr, self.pos, self.used - self.pos));
        }
        let limit = self.used - self.sep_len;
        for let mut i = self.pos; i <= limit; i += 1 {
            if self.sep_len > 0 && bytes_match_at(self.repr, i, self.sep_repr, self.sep_at, self.sep_len) {
                let part = substring(self.repr, self.pos, i - self.pos);
                self.pos = i + self.sep_len;
                self.remaining -= 1;
                return Option::Some(part);
            }
        }
        self.finished = true;
        return Option::Some(substring(self.repr, self.pos, self.used - self.pos));
    }
}

/// Iterator over whitespace-separated substrings.
pub struct StrSplitWhitespaceIter {
    repr: &Array<u8>,
    used: i32,
    pos: i32,
}

impl Iterator for StrSplitWhitespaceIter {
    type Item = String;

    pub fn next(&mut self) -> Option<Self::Item> {
        while self.pos < self.used && self.repr[self.pos].is_ascii_whitespace() {
            self.pos += 1;
        }
        if self.pos >= self.used {
            return null;
        }
        let start = self.pos;
        while self.pos < self.used && !self.repr[self.pos].is_ascii_whitespace() {
            self.pos += 1;
        }
        return Option::Some(substring(self.repr, start, self.pos - start));
    }
}

/// Iterator over the lines of a string (split on `\n` or `\r\n`).
pub struct StrLinesIter {
    repr: &Array<u8>,
    used: i32,
    pos: i32,
    finished: bool,
}

impl Iterator for StrLinesIter {
    type Item = String;

    pub fn next(&mut self) -> Option<Self::Item> {
        if self.finished {
            return null;
        }
        if self.pos >= self.used {
            self.finished = true;
            return null;
        }
        let start = self.pos;
        while self.pos < self.used {
            let b = self.repr[self.pos];
            if b == 0x0A {
                let part = substring(self.repr, start, self.pos - start);
                self.pos += 1;
                return Option::Some(part);
            }
            if b == 0x0D {
                let part = substring(self.repr, start, self.pos - start);
                self.pos += 1;
                if self.pos < self.used && self.repr[self.pos] == 0x0A {
                    self.pos += 1;
                }
                return Option::Some(part);
            }
            self.pos += 1;
        }
        self.finished = true;
        if self.pos > start {
            return Option::Some(substring(self.repr, start, self.pos - start));
        }
        return null;
    }
}

impl String {
    /// Create a new empty string.
    pub fn new() -> String {
        return String::with_capacity(0);
    }

    /// The tag keeping a template's escapes as written: `` String::raw`a\nb` ``
    /// is `"a\\nb"`, its holes rendered as the untagged template renders
    /// them. See WEP 2026-01-10.
    pub fn raw<T: ReflectTemplate<Holes = [..V]>, ..V>(t: T) -> String {
        let mut out = "";
        for let h of ReflectTemplate::<T>::members() {
            out.push_str(&h.raw());
            h.fmt(&t, &mut Formatter::new(&mut out));
        }
        out.push_str(&ReflectTemplate::<T>::raw_tail());
        return out;
    }

    /// Create an empty string with space for `capacity` bytes.
    #[compiler_item("string_with_capacity")]
    pub fn with_capacity(capacity: i32) -> String {
        return String { repr: builtin::array_new::<u8>(capacity) as ByteArray, used: 0 };
    }

    /// Get the length of the string in bytes
    #[compiler_item("string_len")]
    pub fn len(&self) -> i32 {
        return self.used;
    }

    /// Check if the string is empty
    pub fn is_empty(&self) -> bool {
        return self.used == 0;
    }

    /// Read the byte at `index` without bounds checks. For safe access use `bytes()`.
    ///
    /// # Safety (caller-side preconditions)
    /// - `0 <= index < self.len()`.
    #[compiler_item("string_get_byte_unchecked")]
    pub fn get_byte_unchecked(&self, index: i32) -> u8 {
        return self.repr[index];
    }

    /// Write the byte at `index` without bounds or UTF-8 checks.
    ///
    /// # Safety (caller-side preconditions)
    /// - `0 <= index < self.len()`.
    /// - The resulting byte sequence must remain valid UTF-8.
    #[compiler_item("string_set_byte_unchecked")]
    pub fn set_byte_unchecked(&mut self, index: i32, value: u8) {
        self.repr[index] = value;
    }

    /// Read-only view of the string's UTF-8 bytes as an `Slice<u8>` over `[0, len())`.
    pub fn as_bytes(&self) -> ByteSlice {
        return Slice::internal_new(&self.repr as &Array<u8>, 0, self.used) as ByteSlice;
    }

    /// Internal: shared reference to the string's bytes (stdlib use only).
    /// Caller must respect the `len()` boundary.
    internal fn internal_raw_bytes(&self) -> &Array<u8> {
        return &self.repr as &Array<u8>;
    }

    /// Internal: mutable reference to the string's bytes (stdlib use only).
    /// Caller must respect the `len()` boundary.
    internal fn internal_raw_bytes_mut(&mut self) -> &mut Array<u8> {
        return &mut self.repr as &mut Array<u8>;
    }

    /// Internal: wrap already-valid UTF-8 bytes as a `String` (stdlib use only).
    /// No validation is performed.
    internal fn internal_from_utf8_raw(bytes: Array<u8>, len: i32) -> String {
        return String { repr: bytes as ByteArray, used: len };
    }

    /// Reallocate to exactly `new_capacity` bytes, preserving the current contents.
    fn realloc_to(&mut self, new_capacity: i32) {
        let mut new_repr: Array<u8> = builtin::array_new(new_capacity);
        builtin::array_copy(&mut new_repr, 0, &self.repr as &Array<u8>, 0, self.used);
        self.repr = new_repr as ByteArray;
    }

    /// Ensure capacity for at least `min_capacity` bytes.
    pub fn grow(&mut self, min_capacity: i32) {
        let capacity = self.repr.len();
        if min_capacity <= capacity {
            return;
        }
        self.realloc_to(i32::max(i32::max(capacity * 2, min_capacity), 8));
    }

    /// Internal: reserve `n` uninitialised bytes at the end and return their offset
    /// (stdlib use only). The length is advanced immediately, so the caller MUST fill
    /// all `n` bytes.
    #[compiler_item("string_reserve_uninit")]
    internal fn internal_reserve_uninit(&mut self, n: i32) -> i32 {
        let new_used = self.used + n;
        if new_used > self.repr.len() {
            builtin::cold_path();
            self.grow(new_used);
        }
        let start = self.used;
        self.used = new_used;
        return start;
    }

    /// Internal: copy `s`'s first `n` bytes into `[offset, offset + n)` (stdlib
    /// use only). The destination must already be reserved by
    /// `internal_reserve_uninit`, so a writer emitting several pieces pays one
    /// capacity check for all of them. `n` is the caller's because `s` may be
    /// `self`, whose length the reservation has already advanced.
    #[compiler_item("string_write_str_at")]
    internal fn internal_write_str_at(&mut self, offset: i32, s: &String, n: i32) {
        builtin::array_copy(&mut self.repr as &mut Array<u8>, offset, &s.repr as &Array<u8>, 0, n);
    }

    /// Internal: Append `len` bytes from linear memory at `ptr` (stdlib use only).
    /// The bytes must be valid UTF-8. No validation is performed.
    internal fn internal_append_from_memory(&mut self, ptr: i32, len: i32) {
        if len == 0 {
            return;
        }
        let start = self.internal_reserve_uninit(len);
        for let mut i = 0; i < len; i += 1 {
            self.set_byte_unchecked(start + i, builtin::i32_load8_u(ptr + i));
        }
    }

    /// Append `n` copies of `byte` to this string.
    pub fn append_byte_filled(&mut self, byte: u8, n: i32) {
        if n <= 0 {
            return;
        }
        let start = self.internal_reserve_uninit(n);
        builtin::array_fill(&mut self.repr as &mut Array<u8>, start, byte, n);
    }

    /// Append any `AsStrSlice` text to this one.
    #[compiler_item("string_push_str")]
    pub fn push_str<S: AsStrSlice>(&mut self, other: S) {
        other.internal_append_to(self);
    }

    /// Internal: the whole-string append, the shape the append fusion and the
    /// constant-folding frame both read (stdlib use only).
    internal fn internal_push_string(&mut self, other: &String) {
        let n = other.used;
        if n == 0 {
            return;
        }
        let start = self.internal_reserve_uninit(n);
        builtin::array_copy(&mut self.repr as &mut Array<u8>, start, &other.repr as &Array<u8>, 0, n);
    }

    /// Internal: the view append, for a source that is not a whole string
    /// (stdlib use only).
    internal fn internal_push_view(&mut self, view: &StrSlice) {
        let n = view.len();
        if n == 0 {
            return;
        }
        let start = self.internal_reserve_uninit(n);
        builtin::array_copy(&mut self.repr as &mut Array<u8>, start, view.repr, view.start, n);
    }

    /// Append the bytes of any `AsByteSlice` source (`ByteList`, `ByteArray`,
    /// `ByteSlice`, or a `String`).
    ///
    /// # Safety (caller-side preconditions)
    /// - The resulting byte sequence must remain valid UTF-8.
    pub fn push_bytes_unchecked<S: AsByteSlice>(&mut self, bytes: &S) {
        let slice = bytes.as_byte_slice();
        let n = slice.len();
        if n == 0 {
            return;
        }
        let start = self.internal_reserve_uninit(n);
        builtin::array_copy(&mut self.repr as &mut Array<u8>, start, slice.internal_repr(), slice.internal_start(), n);
    }

    /// Append the byte range `[start, end)` of `s` to this string.
    ///
    /// # Safety (caller-side preconditions)
    /// - `0 <= start <= end <= s.len()`.
    /// - `start` and `end` must lie on UTF-8 character boundaries of `s`.
    /// - The resulting byte sequence must remain valid UTF-8.
    pub fn push_str_range_unchecked<S: AsStrSlice>(&mut self, s: S, start: i32, end: i32) {
        if end <= start {
            return;
        }
        self.push_str(s.as_str_slice().slice_unchecked(start, end));
    }

    /// Returns an iterator over the UTF-8 bytes of the string.
    pub fn bytes(&self) -> StrUtf8ByteIter {
        return StrUtf8ByteIter { repr: &self.repr as &Array<u8>, used: self.used, index: 0 };
    }

    /// Returns an iterator over the Unicode scalar values (chars) of the string.
    pub fn chars(&self) -> StrCharIter {
        return StrCharIter { repr: &self.repr as &Array<u8>, used: self.used, byte_index: 0 };
    }

    /// Returns an iterator over characters with their byte indices.
    pub fn char_indices(&self) -> StrCharIndicesIter {
        return self.as_str_slice().char_indices();
    }

    /// Decode the whole string into a `List<char>`.
    pub fn to_chars(&self) -> List<char> {
        return self.as_str_slice().to_chars();
    }

    /// Decodes the UTF-8 character starting at the given byte index.
    /// Returns None if `byte_index` is past the end of the string or there
    /// aren't enough bytes to form a full UTF-8 sequence.
    /// Assumes `byte_index` is on a character boundary (the string is valid UTF-8).
    pub fn char_at_byte(&self, byte_index: i32) -> Option<char> {
        return self.as_str_slice().char_at_byte(byte_index);
    }

    /// Decodes the UTF-8 character starting at `byte_index` without bounds checks.
    ///
    /// # Safety (caller-side preconditions)
    /// - `byte_index` lies on a UTF-8 character boundary.
    /// - The full multi-byte sequence (1–4 bytes) starting at `byte_index`
    ///   is in range `[0, self.len())`.
    pub fn char_at_byte_unchecked(&self, byte_index: i32) -> char {
        return self.as_str_slice().char_at_byte_unchecked(byte_index);
    }

    /// Appends a Unicode scalar value (char) to this string.
    #[compiler_item("string_push_char")]
    pub fn push(&mut self, c: char) {
        let code = c as u32;
        if code < 0x80 {
            self.push_ascii_unchecked(code as u8);
            return;
        }
        if self.used + 4 > self.repr.len() {
            builtin::cold_path();
            self.grow(self.used + 4);
        }
        self.used += encode_char(&mut self.repr as &mut Array<u8>, self.used, code);
    }

    /// Appends a single byte, assumed to be a complete one-byte UTF-8 sequence
    /// (`byte < 0x80`). A larger byte breaks the String's UTF-8 invariant — the
    /// `_unchecked` contract.
    ///
    /// `push` routes its ASCII fast path here, and the optimizer's
    /// `nir/const_ascii_push` rewrite retargets `push(<const char < 0x80>)`
    /// here directly, skipping `encode_char`'s width dispatch.
    #[compiler_item("string_push_ascii")]
    pub fn push_ascii_unchecked(&mut self, byte: u8) {
        let start = self.internal_reserve_uninit(1);
        self.set_byte_unchecked(start, byte);
    }

    /// Truncates the string to the given byte length. Panics if `byte_len` is
    /// negative or off a character boundary; round a budget with `floor_char_boundary`.
    pub fn truncate(&mut self, byte_len: i32) {
        if byte_len >= self.used {
            return;
        }
        assert byte_len >= 0, "negative length";
        assert self.is_char_boundary(byte_len), "not on a UTF-8 character boundary";
        self.truncate_unchecked(byte_len);
    }

    /// Truncate without bounds or UTF-8 boundary checks.
    ///
    /// # Safety (caller-side preconditions)
    /// - `0 <= byte_len <= self.len()`.
    /// - `byte_len` lies on a UTF-8 character boundary.
    pub fn truncate_unchecked(&mut self, byte_len: i32) {
        self.used = byte_len;
    }

    /// Truncate the string to the given number of characters.
    /// If `char_count` >= number of characters, the string is unchanged.
    pub fn truncate_chars(&mut self, char_count: i32) {
        self.used = utf8_prefix_end(&self.repr as &Array<u8>, 0, self.used, char_count);
    }

    /// Returns true if `byte_index` is 0, `self.len()`, or the start of a
    /// UTF-8 character in this string.
    pub fn is_char_boundary(&self, byte_index: i32) -> bool {
        return boundary_at(&self.repr as &Array<u8>, 0, self.used, byte_index);
    }

    /// The largest character boundary `<= byte_index`, or `len()` beyond it:
    /// cuts to a byte budget with `truncate` or `substr_bytes`. Panics if negative.
    pub fn floor_char_boundary(&self, byte_index: i32) -> i32 {
        return floor_boundary(&self.repr as &Array<u8>, 0, self.used, byte_index);
    }

    /// The smallest character boundary `>= byte_index`, or `len()` beyond it.
    /// Panics if `byte_index` is negative.
    pub fn ceil_char_boundary(&self, byte_index: i32) -> i32 {
        return ceil_boundary(&self.repr as &Array<u8>, 0, self.used, byte_index);
    }

    /// Removes and returns the last character, or None if empty.
    pub fn pop(&mut self) -> Option<char> {
        if self.used == 0 {
            return null;
        }
        let pos = char_start_backward(&self.repr as &Array<u8>, self.used - 1);
        let code = decode_char_at(&self.repr as &Array<u8>, pos).0;
        self.used = pos;
        return Option::Some(char::from_u32_unchecked(code));
    }

    /// Removes all contents, making the string empty.
    pub fn clear(&mut self) {
        self.used = 0;
    }

    /// Returns the total capacity in bytes.
    pub fn capacity(&self) -> i32 {
        return self.repr.len();
    }

    /// Reserves capacity for at least `additional` more bytes.
    pub fn reserve(&mut self, additional: i32) {
        let required = self.used + additional;
        if required > self.repr.len() {
            self.grow(required);
        }
    }

    /// Shrinks the capacity to match the current byte length.
    pub fn shrink_to_fit(&mut self) {
        if self.repr.len() > self.used {
            self.realloc_to(self.used);
        }
    }

    /// Returns a new string with all ASCII uppercase letters converted to lowercase.
    /// Non-ASCII bytes are left unchanged.
    pub fn to_ascii_lowercase(&self) -> String {
        return self.as_str_slice().to_ascii_lowercase();
    }

    /// Returns a new string with all ASCII lowercase letters converted to uppercase.
    /// Non-ASCII bytes are left unchanged.
    pub fn to_ascii_uppercase(&self) -> String {
        return self.as_str_slice().to_ascii_uppercase();
    }

    /// Checks that two strings are an ASCII case-insensitive match.
    /// Non-ASCII bytes are compared exactly.
    pub fn eq_ignore_ascii_case<S: AsStrSlice>(&self, other: S) -> bool {
        return self.as_str_slice().eq_ignore_ascii_case(other);
    }

    /// Extract a substring by byte range `[start, end)`. Panics if the range is out
    /// of bounds or off a character boundary; round a budget with `floor_char_boundary`.
    pub fn substr_bytes(&self, start: i32, end: i32) -> String {
        return self.as_str_slice().substr_bytes(start, end);
    }

    /// Extract a substring by byte range `[start, end)` without bounds or
    /// UTF-8 boundary checks.
    ///
    /// # Safety (caller-side preconditions)
    /// - `0 <= start <= end <= self.len()`.
    /// - `start` and `end` lie on UTF-8 character boundaries.
    pub fn substr_bytes_unchecked(&self, start: i32, end: i32) -> String {
        return self.as_str_slice().substr_bytes_unchecked(start, end);
    }

    /// Returns true if this string contains the given substring.
    pub fn contains<S: AsStrSlice>(&self, pat: S) -> bool {
        return self.as_str_slice().contains(pat);
    }

    /// Returns true if this string starts with the given prefix.
    pub fn starts_with<S: AsStrSlice>(&self, pat: S) -> bool {
        return self.as_str_slice().starts_with(pat);
    }

    /// Returns true if this string ends with the given suffix.
    pub fn ends_with<S: AsStrSlice>(&self, pat: S) -> bool {
        return self.as_str_slice().ends_with(pat);
    }

    /// Returns the byte index of the first occurrence of `pat`, or None.
    pub fn find<S: AsStrSlice>(&self, pat: S) -> Option<i32> {
        return self.as_str_slice().find(pat);
    }

    /// Returns the byte index of the last occurrence of `pat`, or None.
    pub fn rfind<S: AsStrSlice>(&self, pat: S) -> Option<i32> {
        return self.as_str_slice().rfind(pat);
    }

    /// Returns true if the string contains the given character.
    pub fn contains_char(&self, ch: char) -> bool {
        return self.as_str_slice().contains_char(ch);
    }

    /// Returns the byte index of the first character matching the predicate, or None.
    pub fn find_char(&self, pred: fn mut(char) -> bool) -> Option<i32> {
        return self.as_str_slice().find_char(pred);
    }

    /// Grow if needed and shift the bytes from `byte_index` onward right by `width`,
    /// leaving an uninitialised gap `[byte_index, byte_index + width)`. Advances the
    /// length.
    fn make_gap(&mut self, byte_index: i32, width: i32) {
        let new_used = self.used + width;
        if new_used > self.repr.len() {
            self.grow(new_used);
        }
        builtin::array_copy(
            &mut self.repr as &mut Array<u8>,
            byte_index + width,
            &self.repr as &Array<u8>,
            byte_index,
            self.used - byte_index,
        );
        self.used = new_used;
    }

    /// Inserts a character at the given byte index.
    /// Panics if `byte_index` is out of bounds or not on a UTF-8 character boundary.
    pub fn insert(&mut self, byte_index: i32, ch: char) {
        assert self.is_char_boundary(byte_index), "insert index not on UTF-8 character boundary";
        self.insert_unchecked(byte_index, ch);
    }

    /// Inserts a character at `byte_index` without bounds or UTF-8 boundary checks.
    ///
    /// # Safety (caller-side preconditions)
    /// - `0 <= byte_index <= self.len()`.
    /// - `byte_index` lies on a UTF-8 character boundary.
    pub fn insert_unchecked(&mut self, byte_index: i32, ch: char) {
        self.make_gap(byte_index, ch.len_utf8());
        encode_char(&mut self.repr as &mut Array<u8>, byte_index, ch as u32);
    }

    /// Inserts a string at the given byte index.
    /// Panics if `byte_index` is out of bounds or not on a UTF-8 character boundary.
    pub fn insert_str<S: AsStrSlice>(&mut self, byte_index: i32, s: S) {
        assert self.is_char_boundary(byte_index), "insert_str index not on UTF-8 character boundary";
        self.insert_str_unchecked(byte_index, s);
    }

    /// Inserts a string at `byte_index` without bounds or UTF-8 boundary checks.
    ///
    /// # Safety (caller-side preconditions)
    /// - `0 <= byte_index <= self.len()`.
    /// - `byte_index` lies on a UTF-8 character boundary.
    pub fn insert_str_unchecked<S: AsStrSlice>(&mut self, byte_index: i32, s: S) {
        let view = s.as_str_slice();
        let s_len = view.len();
        if s_len == 0 {
            return;
        }
        self.make_gap(byte_index, s_len);
        builtin::array_copy(&mut self.repr as &mut Array<u8>, byte_index, view.repr, view.start, s_len);
    }

    /// Removes and returns the character at the given byte index.
    /// Panics if the index is out of bounds or not on a UTF-8 character boundary.
    pub fn remove(&mut self, byte_index: i32) -> char {
        assert 0 <= byte_index < self.used, "index out of bounds";
        assert self.is_char_boundary(byte_index), "remove index not on UTF-8 character boundary";
        return self.remove_unchecked(byte_index);
    }

    /// Removes and returns the character at `byte_index` without bounds or
    /// UTF-8 boundary checks.
    ///
    /// # Safety (caller-side preconditions)
    /// - `0 <= byte_index < self.len()`.
    /// - `byte_index` lies on a UTF-8 character boundary.
    pub fn remove_unchecked(&mut self, byte_index: i32) -> char {
        let [code, char_len] = decode_char_at(&self.repr as &Array<u8>, byte_index);
        builtin::array_copy(
            &mut self.repr as &mut Array<u8>,
            byte_index,
            &self.repr as &Array<u8>,
            byte_index + char_len,
            self.used - byte_index - char_len,
        );
        self.used -= char_len;
        return char::from_u32_unchecked(code);
    }

    /// Returns this string repeated `n` times.
    pub fn repeat(&self, n: i32) -> String {
        return self.as_str_slice().repeat(n);
    }

    /// Replaces all occurrences of `from` with `to`.
    pub fn replace<F: AsStrSlice, T: AsStrSlice>(&self, from: F, to: T) -> String {
        return self.as_str_slice().replace(from, to);
    }

    /// Replaces the first `count` occurrences of `from` with `to`.
    /// If `count` is negative, replaces all occurrences.
    pub fn replacen<F: AsStrSlice, T: AsStrSlice>(&self, from: F, to: T, count: i32) -> String {
        return self.as_str_slice().replacen(from, to, count);
    }

    /// Build a `String` from an iterable of chars.
    pub fn from_iter<I: IntoIterator<Item = char>>(iter: I) -> String {
        let mut s = String::with_capacity(8);
        for let c of iter {
            s.push(c);
        }
        return s;
    }

    /// Build a `String` from an iterable of bytes, validating UTF-8.
    pub fn from_utf8<I: IntoIterator<Item = u8>>(bytes: I) -> Result<String, Utf8Error> {
        let collected: List<u8> = bytes.into_iter().collect();
        return String::from_utf8_slice(collected.as_slice() as ByteSlice);
    }

    /// Validate a contiguous byte slice as UTF-8 and wrap it as a `String`. A
    /// sequence cut short at the end fails too, with `error_len() == None`.
    pub fn from_utf8_slice(bytes: ByteSlice) -> Result<String, Utf8Error> {
        let prefix = String::utf8_valid_prefix(&bytes);
        if prefix != bytes.len() {
            builtin::cold_path();
            return Result::Err(String::utf8_error_at(&bytes, prefix));
        }
        return Result::Ok(String {
            repr: bytes.to_array() as ByteArray,
            used: bytes.len(),
        });
    }

    /// Append the longest prefix of `bytes` that is complete, valid UTF-8, and
    /// answer how many bytes that was. A trailing sequence cut short is left
    /// behind rather than rejected, so a caller decoding a stream carries those
    /// bytes into its next chunk.
    ///
    /// `Err` names a sequence no further byte could complete, offset from the
    /// start of `bytes` — a stream decoder owes it `Utf8Error::rebased`. This
    /// string is untouched: the prefix is validated before any of it is appended.
    pub fn push_utf8<S: AsByteSlice>(&mut self, bytes: &S) -> Result<i32, Utf8Error> {
        let slice = bytes.as_byte_slice();
        let taken = String::utf8_valid_prefix(&slice);
        if taken < 0 {
            builtin::cold_path();
            return Result::Err(String::utf8_error_at(&slice, taken));
        }
        self.push_bytes_unchecked(&slice.slice(0, taken));
        return Result::Ok(taken);
    }

    /// Length of the longest prefix of `bytes` that is complete, valid UTF-8,
    /// or `-1 - i` where `i` is the offset of a sequence no further byte could
    /// complete. ASCII is tested here, `utf8_sequence_len` being a call.
    internal fn utf8_valid_prefix(bytes: &ByteSlice) -> i32 {
        let len = bytes.len();
        let mut i = 0;
        while i < len {
            let mut advance = 1;
            if bytes.get_unchecked(i) >= 0x80 {
                advance = String::utf8_sequence_len(bytes, i, len);
                if advance <= 0 {
                    builtin::cold_path();
                    // A short sequence ends the prefix; a malformed one is an
                    // offset only the sign distinguishes.
                    return if advance < 0 { i } else { -1 - i };
                }
            }
            i += advance;
        }
        return len;
    }

    /// The failure a `utf8_valid_prefix` answer other than `len` stands for.
    /// Measured here rather than in the scan, being off the hot path.
    internal fn utf8_error_at(bytes: &ByteSlice, prefix: i32) -> Utf8Error {
        assert prefix != bytes.len();
        if prefix >= 0 {
            return Utf8Error::incomplete(prefix);
        }
        let start = -1 - prefix;
        return Utf8Error::invalid(start, String::utf8_invalid_len(bytes, start));
    }

    /// Length (1–3) of the malformed sequence at `start`: how many of its bytes
    /// `utf8_sequence_len` accepted before the one nothing could rescue.
    internal fn utf8_invalid_len(bytes: &ByteSlice, start: i32) -> i32 {
        let b0 = bytes.get_unchecked(start);
        if b0 < 0xC2 || b0 >= 0xF5 {
            return 1;
        }
        if !utf8_second_byte_ok(b0, bytes.get_unchecked(start + 1)) {
            return 1;
        }
        if is_char_start(bytes.get_unchecked(start + 2)) {
            return 2;
        }
        return 3;
    }

    /// Length (1–4) of the valid UTF-8 sequence at `bytes[start..len)`, `0` when
    /// it is malformed, and `-1` when it is merely cut short by `len`.
    ///
    /// `0` and `-1` are separate because only the caller knows whether more
    /// bytes can arrive. Each continuation byte present is checked before the
    /// length is, so a sequence no further byte could rescue answers `0` even
    /// when short.
    internal fn utf8_sequence_len(bytes: &ByteSlice, start: i32, len: i32) -> i32 {
        let b0 = bytes.get_unchecked(start);
        if b0 < 0x80 {
            return 1;
        }
        if b0 < 0xC2 {
            // Bare continuation byte (0x80–0xBF) or overlong 2-byte lead (0xC0, 0xC1)
            builtin::cold_path();
            return 0;
        }
        let available = len - start;
        if b0 < 0xE0 {
            if available < 2 {
                builtin::cold_path();
                return -1;
            }
            if !utf8_second_byte_ok(b0, bytes.get_unchecked(start + 1)) {
                builtin::cold_path();
                return 0;
            }
            return 2;
        }
        if b0 < 0xF0 {
            if available >= 2 && !utf8_second_byte_ok(b0, bytes.get_unchecked(start + 1)) {
                builtin::cold_path();
                return 0;
            }
            if available < 3 {
                builtin::cold_path();
                return -1;
            }
            if is_char_start(bytes.get_unchecked(start + 2)) {
                builtin::cold_path();
                return 0;
            }
            return 3;
        }
        if b0 < 0xF5 {
            if available >= 2 && !utf8_second_byte_ok(b0, bytes.get_unchecked(start + 1)) {
                builtin::cold_path();
                return 0;
            }
            if available >= 3 && is_char_start(bytes.get_unchecked(start + 2)) {
                builtin::cold_path();
                return 0;
            }
            if available < 4 {
                builtin::cold_path();
                return -1;
            }
            if is_char_start(bytes.get_unchecked(start + 3)) {
                builtin::cold_path();
                return 0;
            }
            return 4;
        }
        builtin::cold_path();
        return 0;
    }

    /// Whether `bytes` is well-formed UTF-8.
    pub fn is_valid_utf8(bytes: ByteSlice) -> bool {
        return String::utf8_valid_prefix(&bytes) == bytes.len();
    }

    /// Build a `String` from an iterable of bytes, replacing invalid UTF-8 with U+FFFD.
    pub fn from_utf8_lossy<I: IntoIterator<Item = u8>>(bytes: I) -> String {
        let collected: List<u8> = bytes.into_iter().collect();
        let slice = collected.as_slice() as ByteSlice;
        if let Ok(s) = String::from_utf8_slice(slice) {
            return s;
        }
        builtin::cold_path();
        let len = slice.len();
        let mut builder = String::with_capacity(len);
        let mut i = 0;
        while i < len {
            let scalar = decode_utf8_scalar(slice, i, len);
            if scalar.valid {
                builder.push(char::from_u32_unchecked(scalar.code));
            } else {
                builder.push('\uFFFD');
            }
            i += scalar.advance;
        }
        return builder;
    }

    /// Build a `String` from an iterable of bytes without UTF-8 validation.
    ///
    /// # Safety
    /// The caller must ensure the bytes form valid UTF-8.
    pub fn from_utf8_unchecked<I: IntoIterator<Item = u8>>(bytes: I) -> String {
        let mut builder = String::with_capacity(8);
        for let b of bytes {
            let idx = builder.internal_reserve_uninit(1);
            builder.set_byte_unchecked(idx, b);
        }
        return builder;
    }

    /// Returns an iterator over substrings split by the given separator.
    pub fn split<S: AsStrSlice>(&self, sep: S) -> StrSplitIter {
        return self.as_str_slice().split(sep);
    }

    /// Returns an iterator over at most `n` substrings split by the given separator.
    pub fn splitn<S: AsStrSlice>(&self, n: i32, sep: S) -> StrSplitNIter {
        return self.as_str_slice().splitn(n, sep);
    }

    /// Splits at the first `sep` into the parts before and after it, or None
    /// when `sep` does not occur.
    pub fn split_once<S: AsStrSlice>(&self, sep: S) -> Option<[StrSlice, StrSlice]> {
        return self.as_str_slice().split_once(sep);
    }

    /// Splits at the last `sep` into the parts before and after it, or None
    /// when `sep` does not occur.
    pub fn rsplit_once<S: AsStrSlice>(&self, sep: S) -> Option<[StrSlice, StrSlice]> {
        return self.as_str_slice().rsplit_once(sep);
    }

    /// Returns an iterator over whitespace-separated substrings.
    pub fn split_whitespace(&self) -> StrSplitWhitespaceIter {
        return self.as_str_slice().split_whitespace();
    }

    /// Returns an iterator over the lines of this string.
    pub fn lines(&self) -> StrLinesIter {
        return self.as_str_slice().lines();
    }
}

impl Add for String {
    type Output = String;

    pub fn add(&self, other: &Self) -> Self::Output {
        let mut result = String::with_capacity(self.len() + other.len());
        result.push_str(self);
        result.push_str(other);
        return result;
    }
}

impl Eq for String {
    pub fn eq(&self, other: &Self) -> bool {
        return seq_eq(
            &self.repr as &Array<u8>,
            0,
            self.used,
            &other.repr as &Array<u8>,
            0,
            other.used,
        );
    }
}

impl LenientFromStr for String {
    type Err = LenientParseError;

    /// Identity: any text parses to the string it spells. Never fails.
    fn from_str_lenient<S: AsStrSlice>(s: S) -> Result<String, LenientParseError> {
        return Result::Ok(s.as_str_slice().to_string());
    }
}

impl Ord for String {
    pub fn cmp(&self, other: &Self) -> Ordering {
        return seq_cmp(
            &self.repr as &Array<u8>,
            0,
            self.used,
            &other.repr as &Array<u8>,
            0,
            other.used,
        );
    }
}

impl Default for String {
    pub fn default() -> String {
        return "";
    }
}

impl From<char> for String {
    pub fn from(value: char) -> String {
        let mut s = String::with_capacity(4);
        s.push(value);
        return s;
    }
}

/// A view of part of a string, its ends on UTF-8 character boundaries.
/// Creating one copies nothing.
pub struct StrSlice {
    repr: &Array<u8>,
    start: i32,
    end: i32,
}

impl StrSlice {
    /// Wrap a byte range already known to be on character boundaries
    /// (stdlib use only).
    internal fn internal_new(repr: &Array<u8>, start: i32, end: i32) -> StrSlice {
        return StrSlice { repr, start, end };
    }

    /// Length in bytes.
    pub fn len(&self) -> i32 {
        return self.end - self.start;
    }

    pub fn is_empty(&self) -> bool {
        return self.end == self.start;
    }

    /// Read the byte at `index`, counted from the view's start, without bounds
    /// checks.
    ///
    /// # Safety (caller-side preconditions)
    /// - `0 <= index < self.len()`.
    #[inline]
    pub fn get_byte_unchecked(&self, index: i32) -> u8 {
        return self.repr[self.start + index];
    }

    /// Returns true if `index`, counted from the view's start, is 0, `len()`,
    /// or the start of a character.
    pub fn is_char_boundary(&self, index: i32) -> bool {
        return boundary_at(self.repr, self.start, self.len(), index);
    }

    /// The largest character boundary `<= index`, or `len()` beyond it.
    /// Panics if `index` is negative.
    pub fn floor_char_boundary(&self, index: i32) -> i32 {
        return floor_boundary(self.repr, self.start, self.len(), index);
    }

    /// The smallest character boundary `>= index`, or `len()` beyond it.
    /// Panics if `index` is negative.
    pub fn ceil_char_boundary(&self, index: i32) -> i32 {
        return ceil_boundary(self.repr, self.start, self.len(), index);
    }

    /// Byte end of the leading `char_count` characters, or `len()` when the
    /// view holds fewer.
    internal fn char_prefix_end(&self, char_count: i32) -> i32 {
        return utf8_prefix_end(self.repr, self.start, self.len(), char_count);
    }

    /// A sub-view over `[start, end)`, counted from this view's start.
    /// Panics if the range is out of bounds or either end is off a character
    /// boundary.
    pub fn slice(&self, start: i32, end: i32) -> StrSlice {
        assert 0 <= start <= end <= self.len(), "byte range out of bounds";
        assert self.is_char_boundary(start) && self.is_char_boundary(end), "byte range not on UTF-8 character boundaries";
        return self.slice_unchecked(start, end);
    }

    /// A sub-view without bounds or UTF-8 boundary checks.
    ///
    /// # Safety (caller-side preconditions)
    /// - `0 <= start <= end <= self.len()`.
    /// - `start` and `end` lie on UTF-8 character boundaries.
    #[inline]
    pub fn slice_unchecked(&self, start: i32, end: i32) -> StrSlice {
        return StrSlice { repr: self.repr, start: self.start + start, end: self.start + end };
    }

    /// The backing array and this view's offset into it (stdlib use only):
    /// what a byte-at-a-time reader needs to index without a bounds check.
    internal fn internal_raw_bytes(&self) -> &Array<u8> {
        return self.repr;
    }

    internal fn internal_byte_offset(&self) -> i32 {
        return self.start;
    }

    /// The view's UTF-8 bytes.
    pub fn as_bytes(&self) -> ByteSlice {
        return Slice::internal_new(self.repr, self.start, self.end) as ByteSlice;
    }

    /// Returns an iterator over the Unicode scalar values (chars) of the view.
    pub fn chars(&self) -> StrCharIter {
        return StrCharIter { repr: self.repr, used: self.end, byte_index: self.start };
    }

    /// Returns an iterator over the UTF-8 bytes of the view.
    pub fn bytes(&self) -> StrUtf8ByteIter {
        return StrUtf8ByteIter { repr: self.repr, used: self.end, index: self.start };
    }

    /// Copy the view into an owned `String`.
    pub fn to_string(&self) -> String {
        return substring(self.repr, self.start, self.len());
    }

    /// Returns true if the view starts with `pat`.
    pub fn starts_with<S: AsStrSlice>(&self, pat: S) -> bool {
        let p = pat.as_str_slice();
        let pat_len = p.len();
        if pat_len > self.len() {
            return false;
        }
        return bytes_match_at(self.repr, self.start, p.repr, p.start, pat_len);
    }

    /// Returns true if the view ends with `pat`.
    pub fn ends_with<S: AsStrSlice>(&self, pat: S) -> bool {
        let p = pat.as_str_slice();
        let pat_len = p.len();
        if pat_len > self.len() {
            return false;
        }
        return bytes_match_at(self.repr, self.end - pat_len, p.repr, p.start, pat_len);
    }

    /// Returns true if the view contains `pat`.
    pub fn contains<S: AsStrSlice>(&self, pat: S) -> bool {
        return self.find(pat) matches { Some(_) };
    }

    /// The byte index of the first occurrence of `pat`, counted from the view's
    /// start, or None.
    pub fn find<S: AsStrSlice>(&self, pat: S) -> Option<i32> {
        let p = pat.as_str_slice();
        let pat_len = p.len();
        if pat_len == 0 {
            return Option::Some(0);
        }
        let limit = self.len() - pat_len;
        for let mut i = 0; i <= limit; i += 1 {
            if bytes_match_at(self.repr, self.start + i, p.repr, p.start, pat_len) {
                return Option::Some(i);
            }
        }
        return null;
    }

    /// The byte index of the last occurrence of `pat`, counted from the view's
    /// start, or None.
    pub fn rfind<S: AsStrSlice>(&self, pat: S) -> Option<i32> {
        let p = pat.as_str_slice();
        let pat_len = p.len();
        if pat_len == 0 {
            return Option::Some(self.len());
        }
        let mut i = self.len() - pat_len;
        while i >= 0 {
            if bytes_match_at(self.repr, self.start + i, p.repr, p.start, pat_len) {
                return Option::Some(i);
            }
            i -= 1;
        }
        return null;
    }

    /// The view with `prefix` removed from the front, or None when it does not
    /// start with `prefix`.
    pub fn strip_prefix<S: AsStrSlice>(&self, prefix: S) -> Option<StrSlice> {
        let start = prefix.as_str_slice().len();
        if !self.starts_with(prefix) {
            return null;
        }
        return Option::Some(self.slice_unchecked(start, self.len()));
    }

    /// The view with `suffix` removed from the end, or None when it does not
    /// end with `suffix`.
    pub fn strip_suffix<S: AsStrSlice>(&self, suffix: S) -> Option<StrSlice> {
        let suffix_len = suffix.as_str_slice().len();
        if !self.ends_with(suffix) {
            return null;
        }
        return Option::Some(self.slice_unchecked(0, self.len() - suffix_len));
    }

    /// Byte order against any text, the `cmp` a generic body cannot reach:
    /// `Ord` compares two `StrSlice`s, and a type parameter is neither.
    pub fn cmp_str<S: AsStrSlice>(&self, other: S) -> Ordering {
        let o = other.as_str_slice();
        return seq_cmp(self.repr, self.start, self.end, o.repr, o.start, o.end);
    }

    /// Byte equality against any text. `==` reaches a `String` and another
    /// `StrSlice`; this reaches whatever a type parameter turns out to be.
    pub fn eq_str<S: AsStrSlice>(&self, other: S) -> bool {
        let len = self.len();
        let b = other.as_str_slice();
        if len != b.len() {
            return false;
        }
        for let mut i = 0; i < len; i += 1 {
            if self.repr[self.start + i] != b.repr[b.start + i] {
                return false;
            }
        }
        return true;
    }

    /// Checks that two views are an ASCII case-insensitive match.
    /// Non-ASCII bytes are compared exactly.
    pub fn eq_ignore_ascii_case<S: AsStrSlice>(&self, other: S) -> bool {
        let len = self.len();
        let b = other.as_str_slice();
        if len != b.len() {
            return false;
        }
        for let mut i = 0; i < len; i += 1 {
            if !self.repr[self.start + i].eq_ignore_ascii_case(&b.repr[b.start + i]) {
                return false;
            }
        }
        return true;
    }

    /// The character starting at `byte_index`, counted from the view's start,
    /// or None past the end.
    pub fn char_at_byte(&self, byte_index: i32) -> Option<char> {
        let at = self.start + byte_index;
        if at >= self.end || at + utf8_seq_len(self.repr[at]) > self.end {
            return null;
        }
        return Option::Some(char::from_u32_unchecked(decode_char_at(self.repr, at).0));
    }

    /// The view with leading ASCII whitespace removed.
    pub fn trim_ascii_start(&self) -> StrSlice {
        let mut start = self.start;
        while start < self.end && self.repr[start].is_ascii_whitespace() {
            start += 1;
        }
        return StrSlice { repr: self.repr, start, end: self.end };
    }

    /// The view with trailing ASCII whitespace removed.
    pub fn trim_ascii_end(&self) -> StrSlice {
        let mut end = self.end;
        while end > self.start && self.repr[end - 1].is_ascii_whitespace() {
            end -= 1;
        }
        return StrSlice { repr: self.repr, start: self.start, end };
    }

    /// The view with leading and trailing ASCII whitespace removed.
    pub fn trim_ascii(&self) -> StrSlice {
        return self.trim_ascii_start().trim_ascii_end();
    }

    /// The view with leading Unicode whitespace removed.
    pub fn trim_start(&self) -> StrSlice {
        let mut start = self.start;
        while start < self.end {
            let [code, len] = decode_char_at(self.repr, start);
            if !char::from_u32_unchecked(code).is_whitespace() {
                break;
            }
            start += len;
        }
        return StrSlice { repr: self.repr, start, end: self.end };
    }

    /// The view with trailing Unicode whitespace removed.
    pub fn trim_end(&self) -> StrSlice {
        let mut end = self.end;
        while end > self.start {
            let pos = char_start_backward(self.repr, end - 1);
            if !char::from_u32_unchecked(decode_char_at(self.repr, pos).0).is_whitespace() {
                break;
            }
            end = pos;
        }
        return StrSlice { repr: self.repr, start: self.start, end };
    }

    /// The view with leading and trailing Unicode whitespace removed.
    pub fn trim(&self) -> StrSlice {
        return self.trim_start().trim_end();
    }

    pub fn split<P: AsStrSlice>(&self, sep: P) -> StrSplitIter {
        let s = sep.as_str_slice();
        return StrSplitIter {
            repr: self.repr,
            used: self.end,
            pos: self.start,
            sep_repr: s.repr,
            sep_at: s.start,
            sep_len: s.len(),
            finished: false,
        };
    }

    pub fn splitn<P: AsStrSlice>(&self, n: i32, sep: P) -> StrSplitNIter {
        let s = sep.as_str_slice();
        return StrSplitNIter {
            repr: self.repr,
            used: self.end,
            pos: self.start,
            sep_repr: s.repr,
            sep_at: s.start,
            sep_len: s.len(),
            remaining: n,
            finished: n <= 0,
        };
    }

    pub fn split_whitespace(&self) -> StrSplitWhitespaceIter {
        return StrSplitWhitespaceIter { repr: self.repr, used: self.end, pos: self.start };
    }

    pub fn lines(&self) -> StrLinesIter {
        return StrLinesIter { repr: self.repr, used: self.end, pos: self.start, finished: false };
    }

    /// The parts either side of the first `sep`, or None when it does not
    /// occur. Both parts view this one; `to_string` copies whichever is kept.
    pub fn split_once<P: AsStrSlice>(&self, sep: P) -> Option<[StrSlice, StrSlice]> {
        let sep_len = sep.as_str_slice().len();
        let Some(at) = self.find(sep) else {
            return null;
        };
        return Option::Some(self.cut_at(at, sep_len));
    }

    pub fn rsplit_once<P: AsStrSlice>(&self, sep: P) -> Option<[StrSlice, StrSlice]> {
        let sep_len = sep.as_str_slice().len();
        let Some(at) = self.rfind(sep) else {
            return null;
        };
        return Option::Some(self.cut_at(at, sep_len));
    }

    fn cut_at(&self, at: i32, sep_len: i32) -> [StrSlice, StrSlice] {
        return [
            self.slice_unchecked(0, at),
            self.slice_unchecked(at + sep_len, self.len()),
        ];
    }

    pub fn char_indices(&self) -> StrCharIndicesIter {
        return StrCharIndicesIter { repr: self.repr, used: self.end, byte_index: self.start, base: self.start };
    }

    pub fn to_chars(&self) -> List<char> {
        let mut chars: List<char> = List::with_capacity(self.len());
        for let c of self.chars() {
            chars.push(c);
        }
        return chars;
    }

    pub fn char_at_byte_unchecked(&self, byte_index: i32) -> char {
        return char::from_u32_unchecked(decode_char_at(self.repr, self.start + byte_index).0);
    }

    pub fn to_ascii_lowercase(&self) -> String {
        return String::from_iter(self.chars().map(|c: char| c.to_ascii_lowercase()));
    }

    pub fn to_ascii_uppercase(&self) -> String {
        return String::from_iter(self.chars().map(|c: char| c.to_ascii_uppercase()));
    }

    pub fn substr_bytes(&self, start: i32, end: i32) -> String {
        return self.slice(start, end).to_string();
    }

    pub fn substr_bytes_unchecked(&self, start: i32, end: i32) -> String {
        return self.slice_unchecked(start, end).to_string();
    }

    pub fn contains_char(&self, ch: char) -> bool {
        for let c of self.chars() {
            if c == ch {
                return true;
            }
        }
        return false;
    }

    pub fn find_char(&self, mut pred: fn mut(char) -> bool) -> Option<i32> {
        let mut iter = self.chars();
        for let mut byte_index = 0; let Some(c) = iter.next(); byte_index += c.len_utf8() {
            if pred(c) {
                return Option::Some(byte_index);
            }
        }
        return null;
    }

    pub fn repeat(&self, n: i32) -> String {
        let len = self.len();
        if n <= 0 || len == 0 {
            return String::with_capacity(0);
        }
        let mut result = String::with_capacity(len * n);
        for let mut r = 0; r < n; r += 1 {
            result.push_str(*self);
        }
        return result;
    }

    /// Replaces all occurrences of `from` with `to`.
    pub fn replace<F: AsStrSlice, T: AsStrSlice>(&self, from: F, to: T) -> String {
        return self.replacen(from, to, -1);
    }

    /// Replaces the first `count` occurrences of `from` with `to`.
    /// If `count` is negative, replaces all occurrences.
    pub fn replacen<F: AsStrSlice, T: AsStrSlice>(&self, from: F, to: T, count: i32) -> String {
        let pat = from.as_str_slice();
        let from_len = pat.len();
        let len = self.len();
        if from_len == 0 {
            return self.to_string();
        }
        let mut result = String::with_capacity(len);
        let mut pos = 0;
        let mut replacements = 0;
        let limit = len - from_len;
        while pos <= limit {
            if count >= 0 && replacements >= count {
                break;
            }
            if bytes_match_at(self.repr, self.start + pos, pat.repr, pat.start, from_len) {
                result.push_str(to);
                pos += from_len;
                replacements += 1;
            } else {
                let dst = result.internal_reserve_uninit(1);
                result.set_byte_unchecked(dst, self.get_byte_unchecked(pos));
                pos += 1;
            }
        }
        if pos < len {
            result.push_str(self.slice_unchecked(pos, len));
        }
        return result;
    }
}

/// Conversion to a `StrSlice` that copies no bytes, so one signature takes an
/// owned string, a reference to one, or a view of part of one.
pub trait AsStrSlice: Eq<String> with () {
    fn as_str_slice(&self) -> StrSlice;

    /// Append this text to `out`. `String` overrides it to copy straight out of
    /// its own backing array: the view the default builds hides the append's
    /// operands from the constant-folding frame, which is how a template of
    /// literals stops folding to one.
    fn internal_append_to(&self, out: &mut String) {
        let view = self.as_str_slice();
        out.internal_push_view(&view);
    }

    fn len(&self) -> i32 {
        return self.as_str_slice().len();
    }

    fn is_empty(&self) -> bool {
        return self.as_str_slice().is_empty();
    }

    fn get_byte_unchecked(&self, index: i32) -> u8 {
        return self.as_str_slice().get_byte_unchecked(index);
    }

    fn is_char_boundary(&self, index: i32) -> bool {
        return self.as_str_slice().is_char_boundary(index);
    }

    fn floor_char_boundary(&self, index: i32) -> i32 {
        return self.as_str_slice().floor_char_boundary(index);
    }

    fn ceil_char_boundary(&self, index: i32) -> i32 {
        return self.as_str_slice().ceil_char_boundary(index);
    }

    fn slice(&self, start: i32, end: i32) -> StrSlice {
        return self.as_str_slice().slice(start, end);
    }

    fn slice_unchecked(&self, start: i32, end: i32) -> StrSlice {
        return self.as_str_slice().slice_unchecked(start, end);
    }

    fn as_bytes(&self) -> ByteSlice {
        return self.as_str_slice().as_bytes();
    }

    fn chars(&self) -> StrCharIter {
        return self.as_str_slice().chars();
    }

    fn bytes(&self) -> StrUtf8ByteIter {
        return self.as_str_slice().bytes();
    }

    fn to_string(&self) -> String {
        return self.as_str_slice().to_string();
    }

    fn starts_with<P: AsStrSlice>(&self, pat: P) -> bool {
        return self.as_str_slice().starts_with(pat);
    }

    fn ends_with<P: AsStrSlice>(&self, pat: P) -> bool {
        return self.as_str_slice().ends_with(pat);
    }

    fn contains<P: AsStrSlice>(&self, pat: P) -> bool {
        return self.as_str_slice().contains(pat);
    }

    fn find<P: AsStrSlice>(&self, pat: P) -> Option<i32> {
        return self.as_str_slice().find(pat);
    }

    fn rfind<P: AsStrSlice>(&self, pat: P) -> Option<i32> {
        return self.as_str_slice().rfind(pat);
    }

    fn strip_prefix<P: AsStrSlice>(&self, prefix: P) -> Option<StrSlice> {
        return self.as_str_slice().strip_prefix(prefix);
    }

    fn strip_suffix<P: AsStrSlice>(&self, suffix: P) -> Option<StrSlice> {
        return self.as_str_slice().strip_suffix(suffix);
    }

    fn cmp_str<P: AsStrSlice>(&self, other: P) -> Ordering {
        return self.as_str_slice().cmp_str(other);
    }

    fn eq_str<P: AsStrSlice>(&self, other: P) -> bool {
        return self.as_str_slice().eq_str(other);
    }

    fn eq_ignore_ascii_case<P: AsStrSlice>(&self, other: P) -> bool {
        return self.as_str_slice().eq_ignore_ascii_case(other);
    }

    fn char_at_byte(&self, byte_index: i32) -> Option<char> {
        return self.as_str_slice().char_at_byte(byte_index);
    }

    fn trim_ascii_start(&self) -> StrSlice {
        return self.as_str_slice().trim_ascii_start();
    }

    fn trim_ascii_end(&self) -> StrSlice {
        return self.as_str_slice().trim_ascii_end();
    }

    fn trim_ascii(&self) -> StrSlice {
        return self.as_str_slice().trim_ascii();
    }

    fn trim_start(&self) -> StrSlice {
        return self.as_str_slice().trim_start();
    }

    fn trim_end(&self) -> StrSlice {
        return self.as_str_slice().trim_end();
    }

    fn trim(&self) -> StrSlice {
        return self.as_str_slice().trim();
    }

    fn split<P: AsStrSlice>(&self, sep: P) -> StrSplitIter {
        return self.as_str_slice().split(sep);
    }

    fn splitn<P: AsStrSlice>(&self, n: i32, sep: P) -> StrSplitNIter {
        return self.as_str_slice().splitn(n, sep);
    }

    fn split_whitespace(&self) -> StrSplitWhitespaceIter {
        return self.as_str_slice().split_whitespace();
    }

    fn lines(&self) -> StrLinesIter {
        return self.as_str_slice().lines();
    }

    fn split_once<P: AsStrSlice>(&self, sep: P) -> Option<[StrSlice, StrSlice]> {
        return self.as_str_slice().split_once(sep);
    }

    fn rsplit_once<P: AsStrSlice>(&self, sep: P) -> Option<[StrSlice, StrSlice]> {
        return self.as_str_slice().rsplit_once(sep);
    }

    fn char_indices(&self) -> StrCharIndicesIter {
        return self.as_str_slice().char_indices();
    }

    fn to_chars(&self) -> List<char> {
        return self.as_str_slice().to_chars();
    }

    fn char_at_byte_unchecked(&self, byte_index: i32) -> char {
        return self.as_str_slice().char_at_byte_unchecked(byte_index);
    }

    fn to_ascii_lowercase(&self) -> String {
        return self.as_str_slice().to_ascii_lowercase();
    }

    fn to_ascii_uppercase(&self) -> String {
        return self.as_str_slice().to_ascii_uppercase();
    }

    fn substr_bytes(&self, start: i32, end: i32) -> String {
        return self.as_str_slice().substr_bytes(start, end);
    }

    fn substr_bytes_unchecked(&self, start: i32, end: i32) -> String {
        return self.as_str_slice().substr_bytes_unchecked(start, end);
    }

    fn contains_char(&self, ch: char) -> bool {
        return self.as_str_slice().contains_char(ch);
    }

    fn find_char(&self, pred: fn mut(char) -> bool) -> Option<i32> {
        return self.as_str_slice().find_char(pred);
    }

    fn repeat(&self, n: i32) -> String {
        return self.as_str_slice().repeat(n);
    }

    fn replace<F: AsStrSlice, T: AsStrSlice>(&self, from: F, to: T) -> String {
        return self.as_str_slice().replace(from, to);
    }

    fn replacen<F: AsStrSlice, T: AsStrSlice>(&self, from: F, to: T, count: i32) -> String {
        return self.as_str_slice().replacen(from, to, count);
    }
}

impl AsStrSlice for String {
    fn as_str_slice(&self) -> StrSlice {
        return StrSlice::internal_new(&self.repr as &Array<u8>, 0, self.used);
    }

    fn internal_append_to(&self, out: &mut String) {
        out.internal_push_string(self);
    }

    /// The byte accessors read the backing array directly. The default builds a
    /// view per call, which a scan over a generic body's text pays per byte.
    fn len(&self) -> i32 {
        return self.used;
    }

    fn is_empty(&self) -> bool {
        return self.used == 0;
    }

    fn get_byte_unchecked(&self, index: i32) -> u8 {
        return self.repr[index];
    }

    /// Already a `String`: the default would rebuild one byte by byte, which a
    /// per-field wire name pays on every serialization.
    fn to_string(&self) -> String {
        return *self;
    }
}

impl<T: AsStrSlice> AsStrSlice for &T {
    fn as_str_slice(&self) -> StrSlice {
        return (*self).as_str_slice();
    }

    fn internal_append_to(&self, out: &mut String) {
        (*self).internal_append_to(out);
    }

    /// Forwarded, so a reference reaches `T`'s own overrides instead of the
    /// defaults, which answer through a view built on every call.
    fn len(&self) -> i32 {
        return (*self).len();
    }

    fn is_empty(&self) -> bool {
        return (*self).is_empty();
    }

    fn get_byte_unchecked(&self, index: i32) -> u8 {
        return (*self).get_byte_unchecked(index);
    }

    fn is_char_boundary(&self, index: i32) -> bool {
        return (*self).is_char_boundary(index);
    }

    fn floor_char_boundary(&self, index: i32) -> i32 {
        return (*self).floor_char_boundary(index);
    }

    fn ceil_char_boundary(&self, index: i32) -> i32 {
        return (*self).ceil_char_boundary(index);
    }

    fn char_at_byte_unchecked(&self, byte_index: i32) -> char {
        return (*self).char_at_byte_unchecked(byte_index);
    }

    fn to_string(&self) -> String {
        return (*self).to_string();
    }
}

/// What `AsStrSlice` requires of a reference to one. The blanket `Eq for &T`
/// beside it compares two references, which is a different question.
impl<T: AsStrSlice> Eq<String> for &T {
    pub fn eq(&self, other: &String) -> bool {
        return (*self).eq_str(other);
    }
}

impl AsStrSlice for StrSlice {
    fn as_str_slice(&self) -> StrSlice {
        return *self;
    }
}

impl Eq for StrSlice {
    pub fn eq(&self, other: &Self) -> bool {
        return seq_eq(self.repr, self.start, self.end, other.repr, other.start, other.end);
    }
}

impl Ord for StrSlice {
    pub fn cmp(&self, other: &Self) -> Ordering {
        return seq_cmp(self.repr, self.start, self.end, other.repr, other.start, other.end);
    }
}

/// A view and an owned string are the same text when their bytes are, so `==`
/// spans the two rather than asking the caller which side to copy.
impl Eq<String> for StrSlice {
    pub fn eq(&self, other: &String) -> bool {
        return self.eq_str(other);
    }
}

impl Eq<StrSlice> for String {
    pub fn eq(&self, other: &StrSlice) -> bool {
        return other.eq_str(self);
    }
}
