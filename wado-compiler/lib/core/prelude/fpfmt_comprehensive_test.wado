// Comprehensive Float-to-String Conversion Tests
// Ported from rsc.io/fpfmt/fpfmt_test.go
//
// This file contains data-driven tests with 8548 test cases:
// - 8180 testFloats (powers of 2, powers of 10, and nextafter values)
// - 368 hardFloats (boundary values from hard table)
//
// Copyright 2025 The Go Authors. All rights reserved.
// Use of this source code is governed by a BSD-style license.

use { short, digits, check_special, SpecialKind, parse_text } from "./fpfmt.wado";
use { println, Stdout } from "core:cli";

// format_exp with '+' sign and zero-padded exponent (matching Go %e style)
fn format_exp_padded(d: u64, p: i32, nd: i32) -> String {
    let mut buf = String::with_capacity(30);
    let exp = p + nd - 1;

    // Write digits
    let mut val = d;
    let mut digit_chars: Array<u8> = [];
    for let mut i = 0; i < nd; i += 1 {
        digit_chars.push(0 as u8);
    }
    let mut idx = nd - 1;
    while idx >= 0 {
        digit_chars[idx] = '0' as u8 + (val % 10) as u8;
        val = val / 10;
        idx -= 1;
    }

    buf.push(digit_chars[0] as char);
    if nd > 1 {
        buf.push('.');
        for let mut i = 1; i < nd; i += 1 {
            buf.push(digit_chars[i] as char);
        }
    }

    buf.push('e');
    if exp < 0 {
        buf.push('-');
    } else {
        buf.push('+');
    }

    let abs_exp = if exp < 0 { -exp } else { exp };
    if abs_exp < 10 {
        buf.push('0');
        buf.push(char::from_u32_unchecked('0' as u32 + abs_exp as u32));
    } else if abs_exp < 100 {
        buf.push(char::from_u32_unchecked('0' as u32 + (abs_exp / 10) as u32));
        buf.push(char::from_u32_unchecked('0' as u32 + (abs_exp % 10) as u32));
    } else {
        buf.push(char::from_u32_unchecked('0' as u32 + (abs_exp / 100) as u32));
        buf.push(char::from_u32_unchecked('0' as u32 + (abs_exp / 10 % 10) as u32));
        buf.push(char::from_u32_unchecked('0' as u32 + (abs_exp % 10) as u32));
    }

    return buf;
}

fn f64_to_string_exp(f: f64, upper: bool) -> String {
    let [is_special, is_neg, kind] = check_special(f);
    if is_special {
        if kind matches { Zero } {
            if is_neg {
                return "-0e+00";
            }
            return "0e+00";
        }
        if kind matches { Inf } {
            if is_neg {
                return "-Inf";
            }
            return "Inf";
        }
        return "NaN";
    }
    let abs_f = if is_neg { -f } else { f };
    let result = short(abs_f);
    let d = result.digits;
    let p = result.exponent;
    let nd = digits(d);
    let formatted = format_exp_padded(d, p, nd);
    if is_neg {
        return "-" + formatted;
    }
    return formatted;
}


fn run_batch(bits: &Array<i64>, expected: &Array<String>, batch_name: String) -> i32 with Stdout {
    let mut failures = 0;
    let n = bits.len();

    for let mut i = 0; i < n; i += 1 {
        let f = f64::from_bits(bits[i]);
        let actual = f64_to_string_exp(f, false);
        let exp = expected[i];

        if actual != exp {
            failures = failures + 1;
            if failures <= 10 {
                println(`FAIL [{batch_name}][{i}]: expected="{exp}", got="{actual}"`);
            }
        }

        let parsed = parse_text(&actual);
        if !parsed matches { Some(v) && v == f } {
            failures = failures + 1;
            if failures <= 10 {
                println(`FAIL [{batch_name}][{i}]: parse_text("{actual}") did not round-trip`);
            }
        }
    }

    return failures;
}


test "comprehensive testFloats" {
    let bits = test_floats_bits();
    let expected = test_floats_expected();
    let failures = run_batch(&bits, &expected, "testFloats");
    assert failures == 0, `testFloats: {failures} failures`;
}

test "comprehensive hardFloats" {
    let bits = hard_floats_bits();
    let expected = hard_floats_expected();
    let failures = run_batch(&bits, &expected, "hardFloats");
    assert failures == 0, `hardFloats: {failures} failures`;
}


