use { println } from "core:cli";

// contains and is_empty

test "exclusive range contains" {
    let r = 0..<10;
    assert r.contains(&5);
    assert !r.contains(&10);
    assert !r.contains(&-1);
}

test "inclusive range contains" {
    let r = 0..=10;
    assert r.contains(&5);
    assert r.contains(&10);
    assert !r.contains(&11);
}

test "exclusive range is_empty" {
    assert (5..<5).is_empty();
    let a = 5;
    let b = 3;
    assert (a..<b).is_empty();
    assert !(0..<1).is_empty();
}

test "inclusive range is_empty" {
    assert !(5..=5).is_empty();
    let a = 5;
    let b = 3;
    assert (a..=b).is_empty();
    assert !(0..=0).is_empty();
}

test "float range contains" {
    let r = 0.0..<1.0;
    assert r.contains(&0.5);
    assert !r.contains(&1.0);
}

// Display and Eq

test "exclusive range display" {
    let r = 0..<10;
    println(`{r}`);
    assert `{r}` == "0..<10";
}

test "inclusive range display" {
    let r = 1..=5;
    println(`{r}`);
    assert `{r}` == "1..=5";
}

test "exclusive range eq" {
    assert (0..<10) == (0..<10);
    assert !((0..<10) == (0..<5));
}

test "inclusive range eq" {
    assert (0..=10) == (0..=10);
    assert !((0..=10) == (0..=5));
}

// for-of iteration

test "exclusive for-of" {
    let mut sum = 0;
    for let i of 0..<5 {
        sum += i;
    }
    assert sum == 10;
}

test "inclusive for-of" {
    let mut sum = 0;
    for let i of 1..=5 {
        sum += i;
    }
    assert sum == 15;
}

test "empty range does not iterate" {
    let mut count = 0;
    for let _i of 5..<5 {
        count += 1;
    }
    let a = 5;
    let b = 3;
    for let _i of a..<b {
        count += 1;
    }
    assert count == 0;
}

test "char range for-of" {
    let mut s = "";
    for let c of 'a'..='e' {
        s = `{s}{c}`;
    }
    assert s == "abcde";
}

// i128/u128 Step

test "i128 range iteration" {
    let mut sum: i128 = 0 as i128;
    for let i of 1 as i128..=5 as i128 {
        sum = sum + i;
    }
    assert sum == 15 as i128;
}

test "u128 range iteration" {
    let mut sum: u128 = 0 as u128;
    for let i of 0 as u128..<5 as u128 {
        sum = sum + i;
    }
    assert sum == 10 as u128;
}

// Iterator combinators

test "range collect" {
    let arr = (0..<5).collect();
    assert arr.len() == 5;
    assert arr[0] == 0;
    assert arr[4] == 4;
}

test "range fold" {
    let sum = (1..=100).fold(0, |acc: i32, x: i32| acc + x);
    assert sum == 5050;
}

test "range filter collect" {
    let evens = (0..<10).filter(|x: i32| x % 2 == 0).collect();
    assert evens.len() == 5;
    assert evens[0] == 0;
    assert evens[4] == 8;
}

test "range map collect" {
    let doubled = (1..=3).map(|x: i32| x * 2).collect();
    assert doubled.len() == 3;
    assert doubled[0] == 2;
    assert doubled[1] == 4;
    assert doubled[2] == 6;
}

// List range slicing

test "exclusive range slice" {
    let arr: List<i32> = [10, 20, 30, 40, 50];
    let slice = arr[1..<4];
    assert slice.len() == 3;
    assert slice[0] == 20;
    assert slice[1] == 30;
    assert slice[2] == 40;
}

test "inclusive range slice" {
    let arr: List<i32> = [10, 20, 30, 40, 50];
    let slice = arr[2..=4];
    assert slice.len() == 3;
    assert slice[0] == 30;
    assert slice[1] == 40;
    assert slice[2] == 50;
}
