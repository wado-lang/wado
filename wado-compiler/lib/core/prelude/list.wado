#![no_prelude]
#![stdlib("core:prelude/list.wado")]
// List type for Wado: a growable sequence backed by an `Array<T>`. Its views
// and iterators (`ArraySlice`, `ArrayIter`, `ArrayRefIter`, `ArrayWindows`, `ArrayChunks`) are
// the shared types from `core:prelude/slice.wado`.


use { Ordering, Eq, Ord, IndexValue, IndexAssign, IntoIterator, FromIterator, Display } from "core:prelude/traits.wado";
use { Option } from "core:prelude/types.wado";
use { Formatter } from "core:prelude/format.wado";
use { RangeExclusive, RangeInclusive } from "core:prelude/range.wado";
use { ArraySlice, ArrayIter, ArrayRefIter, ArrayWindows, ArrayChunks } from "core:prelude/slice.wado";
use { panic, i32_min, i32_max, i32_clamp } from "core:internal";

#[compiler_item("list")]
pub struct List<T> {
    repr: Array<T>,
    used: i32,
}

impl List<T> {
    pub fn with_capacity(capacity: i32) -> List<T> {
        return List { repr: builtin::array_new(capacity), used: 0 };
    }

    pub fn grow(&mut self) {
        let capacity = builtin::array_len(&self.repr);
        let new_capacity = i32_max(capacity * 2, 4);
        let mut new_repr: Array<T> = builtin::array_new(new_capacity);
        builtin::array_copy(&mut new_repr, 0, &self.repr, 0, self.used);
        self.repr = new_repr;
    }

    fn grow_to(&mut self, min_capacity: i32) {
        let capacity = builtin::array_len(&self.repr);
        if min_capacity <= capacity {
            return;
        }
        let new_capacity = i32_max(i32_max(capacity * 2, min_capacity), 4);
        let mut new_repr: Array<T> = builtin::array_new(new_capacity);
        builtin::array_copy(&mut new_repr, 0, &self.repr, 0, self.used);
        self.repr = new_repr;
    }

    pub fn filled(n: i32, element: T) -> List<T> {
        let mut repr: Array<T> = builtin::array_new(n);
        builtin::array_fill(&mut repr, 0, element, n);
        return List { repr, used: n };
    }

    pub fn len(&self) -> i32 {
        return self.used;
    }

    pub fn is_empty(&self) -> bool {
        return self.used == 0;
    }

    /// Returns the total number of elements the list can hold without reallocating.
    pub fn capacity(&self) -> i32 {
        return builtin::array_len(&self.repr);
    }

    pub fn internal_raw_data(&self) -> Array<T> {
        return self.repr;
    }

    pub fn internal_from_raw(repr: Array<T>, used: i32) -> List<T> {
        return List { repr, used };
    }

    /// Appends a single element to the end.
    #[compiler_item("list_push")]
    pub fn push(&mut self, value: T) with stores[value] {
        let used = self.used;
        if builtin::unlikely(used >= builtin::array_len(&self.repr)) {
            self.grow();
        }
        builtin::array_set(&mut self.repr, used, value);
        self.used = used + 1;
    }

    pub fn pop(&mut self) -> Option<T> {
        if self.used == 0 {
            return null;
        }
        self.used -= 1;
        return Option::Some(builtin::array_get(&self.repr, self.used));
    }

    /// Returns the first element, or None if empty.
    pub fn first(&self) -> Option<T> {
        if self.used == 0 {
            return null;
        }
        return Option::Some(builtin::array_get(&self.repr, 0));
    }

    pub fn last(&self) -> Option<T> {
        if self.used == 0 {
            return null;
        }
        return Option::Some(builtin::array_get(&self.repr, self.used - 1));
    }

    pub fn get(&self, index: i32) -> Option<T> {
        if index < 0 || index >= self.used {
            return null;
        }
        return Option::Some(builtin::array_get(&self.repr, index));
    }

    /// Inserts an element at the given index, shifting all elements after it to the right.
    /// Panics if `index > len()`.
    pub fn insert(&mut self, index: i32, value: T) with stores[value] {
        assert index >= 0 && index <= self.used, "index out of bounds";
        if builtin::unlikely(self.used >= builtin::array_len(&self.repr)) {
            self.grow();
        }
        // Shift elements right
        builtin::array_copy(&mut self.repr, index + 1, &self.repr, index, self.used - index);
        builtin::array_set(&mut self.repr, index, value);
        self.used += 1;
    }

    /// Removes and returns the element at the given index, shifting all elements after it to the left.
    /// Panics if `index >= len()`.
    pub fn remove(&mut self, index: i32) -> T {
        assert index >= 0 && index < self.used, "index out of bounds";
        let value = builtin::array_get(&self.repr, index);
        // Shift elements left
        builtin::array_copy(&mut self.repr, index, &self.repr, index + 1, self.used - 1 - index);
        self.used -= 1;
        return value;
    }

    /// Swaps two elements by index.
    /// Panics if either index is out of bounds.
    pub fn swap(&mut self, a: i32, b: i32) {
        assert a >= 0 && a < self.used, "index out of bounds";
        assert b >= 0 && b < self.used, "index out of bounds";
        let tmp = builtin::array_get(&self.repr, a);
        builtin::array_set(&mut self.repr, a, builtin::array_get(&self.repr, b));
        builtin::array_set(&mut self.repr, b, tmp);
    }

    pub fn truncate(&mut self, len: i32) {
        if len < self.used {
            self.used = len;
        }
    }

    /// Removes all elements.
    pub fn clear(&mut self) {
        self.used = 0;
    }

    /// Reserves capacity for at least `additional` more elements.
    pub fn reserve(&mut self, additional: i32) {
        let required = self.used + additional;
        if builtin::unlikely(required > builtin::array_len(&self.repr)) {
            self.grow_to(required);
        }
    }

    /// Shrinks the capacity to match the current length.
    pub fn shrink_to_fit(&mut self) {
        let capacity = builtin::array_len(&self.repr);
        if capacity > self.used {
            let mut new_repr: Array<T> = builtin::array_new(self.used);
            builtin::array_copy(&mut new_repr, 0, &self.repr, 0, self.used);
            self.repr = new_repr;
        }
    }

    /// Extends this list with elements from another list.
    pub fn extend(&mut self, other: &List<T>) {
        let other_len = other.used;
        if other_len == 0 {
            return;
        }
        let new_used = self.used + other_len;
        if builtin::unlikely(new_used > builtin::array_len(&self.repr)) {
            self.grow_to(new_used);
        }
        builtin::array_copy(&mut self.repr, self.used, &other.repr, 0, other_len);
        self.used = new_used;
    }

    /// Reverses the elements in place.
    pub fn reverse(&mut self) {
        let mut lo = 0;
        let mut hi = self.used - 1;
        while lo < hi {
            let tmp = builtin::array_get(&self.repr, lo);
            builtin::array_set(&mut self.repr, lo, builtin::array_get(&self.repr, hi));
            builtin::array_set(&mut self.repr, hi, tmp);
            lo += 1;
            hi -= 1;
        }
    }

    /// Returns a new list containing this list's elements repeated `n` times.
    pub fn repeat(&self, n: i32) -> List<T> {
        let total = self.used * n;
        let mut new_repr: Array<T> = builtin::array_new(total);
        for let mut r = 0; r < n; r += 1 {
            builtin::array_copy(&mut new_repr, r * self.used, &self.repr, 0, self.used);
        }
        return List { repr: new_repr, used: total };
    }

    /// Copies `count` elements from `self[src_start..]` and appends them.
    /// Handles overlapping regions correctly for both non-overlapping and DEFLATE-style
    /// run-length expansion (where src < dst). Forward order is correct in both cases.
    #[inline(always)]
    pub fn copy_within_append(&mut self, src_start: i32, count: i32) {
        let new_used = self.used + count;
        let capacity = builtin::array_len(&self.repr);
        if builtin::unlikely(new_used > capacity) {
            let new_capacity = i32_max(new_used, capacity * 2);
            let mut new_repr: Array<T> = builtin::array_new(new_capacity);
            builtin::array_copy(&mut new_repr, 0, &self.repr, 0, self.used);
            self.repr = new_repr;
        }
        let base = self.used;
        if src_start + count <= base {
            // Non-overlapping source and destination: a single bulk copy is
            // safe and much faster than element-by-element.
            builtin::array_copy(&mut self.repr, base, &self.repr, src_start, count);
        } else {
            // Overlapping (DEFLATE-style run-length back-reference, src < dst):
            // forward element-by-element copy intentionally propagates
            // just-written values. `builtin::array_copy` uses copy-as-if-buffered
            // semantics, so it cannot replace this loop.
            for let mut i = 0; i < count; i += 1 {
                builtin::array_set(&mut self.repr, base + i, builtin::array_get(&self.repr, src_start + i));
            }
        }
        self.used = new_used;
    }
}

impl<T: Eq> List<T> {
    /// Returns true if the list contains the given value.
    pub fn contains(&self, value: &T) -> bool {
        for let mut i = 0; i < self.used; i += 1 {
            if builtin::array_get(&self.repr, i) == *value {
                return true;
            }
        }
        return false;
    }
}

impl IndexValue<i32> for List<T> {
    type Output = T;

    fn index_value(&self, index: i32) -> Self::Output {
        if builtin::unlikely(index >= self.used) {
            panic("index out of bounds");
        }
        return builtin::array_get(&self.repr, index);
    }
}

impl IndexAssign<i32> for List<T> {
    type Input = T;

    fn index_assign(&mut self, index: i32, value: Self::Input) with stores[value] {
        if builtin::unlikely(index >= self.used) {
            panic("index out of bounds");
        }
        builtin::array_set(&mut self.repr, index, value);
    }
}

impl<T: Eq> Eq for List<T> {
    pub fn eq(&self, other: &Self) -> bool {
        if self.used != other.used {
            return false;
        }
        for let mut i = 0; i < self.used; i += 1 {
            if builtin::array_get(&self.repr, i) != builtin::array_get(&other.repr, i) {
                return false;
            }
        }
        return true;
    }
}

impl<T: Ord> Ord for List<T> {
    pub fn cmp(&self, other: &Self) -> Ordering {
        let min_len = i32_min(self.used, other.used);
        for let mut i = 0; i < min_len; i += 1 {
            let a = builtin::array_get(&self.repr, i);
            let b = builtin::array_get(&other.repr, i);
            if a < b {
                return Ordering::Less;
            }
            if a > b {
                return Ordering::Greater;
            }
        }
        if self.used < other.used {
            return Ordering::Less;
        }
        if self.used > other.used {
            return Ordering::Greater;
        }
        return Ordering::Equal;
    }
}

impl List<T> {
    /// Returns a zero-copy view over `[start, end)`, clamped to `[0, len())`.
    pub fn slice(&self, start: i32, end: i32) -> ArraySlice<T> {
        let s = i32_clamp(start, 0, self.used);
        let e = i32_clamp(end, s, self.used);
        return ArraySlice::internal_new(&self.repr, s, e);
    }

    /// Returns a view over the whole list.
    pub fn as_slice(&self) -> ArraySlice<T> {
        return ArraySlice::internal_new(&self.repr, 0, self.used);
    }

    /// Returns a by-value iterator over the list's elements.
    pub fn iter(&self) -> ArrayIter<T> {
        return ArrayIter::internal_new(&self.repr, 0, self.used);
    }

    /// Returns an iterator over overlapping windows of `size` consecutive
    /// elements. Panics if `size` is not positive.
    pub fn windows(&self, size: i32) -> ArrayWindows<T> {
        return ArrayWindows::internal_new(&self.repr, 0, self.used, size);
    }

    /// Returns an iterator over non-overlapping chunks of up to `size`
    /// elements. The last chunk may be shorter. Panics if `size` is not
    /// positive.
    pub fn chunks(&self, size: i32) -> ArrayChunks<T> {
        return ArrayChunks::internal_new(&self.repr, 0, self.used, size);
    }

    /// In-place sort with comparator. Stable, O(n log n) worst case.
    pub fn sort_by(&mut self, mut cmp: fn mut(&T, &T) -> Ordering) {
        let n = self.used;
        if n <= 1 {
            return;
        }
        let mut buf: Array<T> = builtin::array_new(n);
        let mut width = 1;
        for ; width < n; width = width * 2 {
            for let mut start = 0; start < n; start += width * 2 {
                let mid = start + width;
                if mid < n {
                    let end = i32_min(start + width * 2, n);
                    let mut i = start;
                    let mut j = mid;
                    for let mut k = start; k < end; k += 1 {
                        if i < mid {
                            if j < end {
                                let a = builtin::array_get(&self.repr, i);
                                let b = builtin::array_get(&self.repr, j);
                                if let Greater = cmp(&a, &b) {
                                    builtin::array_set(&mut buf, k, b);
                                    j += 1;
                                } else {
                                    builtin::array_set(&mut buf, k, a);
                                    i += 1;
                                }
                            } else {
                                builtin::array_set(&mut buf, k, builtin::array_get(&self.repr, i));
                                i += 1;
                            }
                        } else {
                            builtin::array_set(&mut buf, k, builtin::array_get(&self.repr, j));
                            j += 1;
                        }
                    }
                    builtin::array_copy(&mut self.repr, start, &buf, start, end - start);
                }
            }
        }
    }

    pub fn sorted_by(&self, cmp: fn mut(&T, &T) -> Ordering) -> List<T> {
        let n = self.used;
        let mut new_repr: Array<T> = builtin::array_new(n);
        builtin::array_copy(&mut new_repr, 0, &self.repr, 0, n);
        let mut copy = List { repr: new_repr, used: n };
        copy.sort_by(cmp);
        return copy;
    }
}

impl IndexValue<RangeExclusive<i32>> for List<T> {
    type Output = ArraySlice<T>;

    fn index_value(&self, range: RangeExclusive<i32>) -> ArraySlice<T> {
        return self.slice(range.start, range.end);
    }
}

impl IndexValue<RangeInclusive<i32>> for List<T> {
    type Output = ArraySlice<T>;

    fn index_value(&self, range: RangeInclusive<i32>) -> ArraySlice<T> {
        return self.slice(range.start, range.end + 1);
    }
}

impl<T> IntoIterator for List<T> {
    type Item = T;
    type Iter = ArrayIter<T>;

    fn into_iter(&self) -> Self::Iter {
        return ArrayIter::internal_new(&self.repr, 0, self.used);
    }
}

impl<T> IntoIterator for &List<T> {
    type Item = &T;
    type Iter = ArrayRefIter<T>;

    fn into_iter(&self) -> Self::Iter {
        let list = *self;
        return ArrayRefIter::internal_new(&list.repr, 0, list.used);
    }
}

impl<T> IntoIterator for &mut List<T> {
    type Item = &T;
    type Iter = ArrayRefIter<T>;

    fn into_iter(&self) -> Self::Iter {
        let list = *self;
        return ArrayRefIter::internal_new(&list.repr, 0, list.used);
    }
}

// sort/sorted require T: Ord (elements must be comparable via Ord::cmp)
impl<T: Ord> List<T> {
    pub fn sort(&mut self) {
        self.sort_by(|a: &T, b: &T| {
            return a.cmp(b);
        });
    }

    pub fn sorted(&self) -> List<T> {
        let n = self.used;
        let mut new_repr: Array<T> = builtin::array_new(n);
        builtin::array_copy(&mut new_repr, 0, &self.repr, 0, n);
        let mut copy = List { repr: new_repr, used: n };
        copy.sort();
        return copy;
    }
}

impl<T: Display> List<T> {
    /// Joins elements into a string with the given separator.
    pub fn join(&self, separator: String) -> String {
        let mut buf = String::with_capacity(self.used * 8);
        let mut f = Formatter::new(&mut buf);
        for let mut i = 0; i < self.used; i += 1 {
            if i > 0 {
                f.write_str(&separator);
            }
            let item = builtin::array_get(&self.repr, i);
            item.fmt(&mut f);
        }
        return buf;
    }
}

impl List<u8> {
    /// Returns the byte at `index` without bounds checking — the `List<u8>`
    /// parallel to `String::get_byte_unchecked`.
    ///
    /// The caller must guarantee `0 <= index < len()`; an out-of-range `index`
    /// reads past the buffer or traps. Intended for hot byte-scanning loops that
    /// have already range-checked `index` (e.g. a forthcoming `core:cbor`
    /// decoder over an owned `ByteList`).
    pub fn get_byte_unchecked(&self, index: i32) -> u8 {
        return builtin::array_get(&self.repr, index);
    }

    /// Renders the bytes as a lowercase hexadecimal string, two digits per
    /// byte (e.g. `[0x0f, 0xa0]` -> `"0fa0"`).
    pub fn to_hex(&self) -> String {
        let mut s = String::with_capacity(self.used * 2);
        for let mut i = 0; i < self.used; i += 1 {
            let byte = builtin::array_get(&self.repr, i);
            s.push_str(&`{byte:02x}`);
        }
        return s;
    }
}

impl FromIterator<T> for List<T> {
    type Iter = ArrayIter<T>;

    fn from_iter(iter: ArrayIter<T>) -> List<T> {
        let mut result: List<T> = [];
        for let item of iter {
            result.push(item);
        }
        return result;
    }
}

// SequenceLiteralBuilder for [e0, e1, ...] -> List<T>
// The blanket impl in core:prelude automatically provides SequenceLiteral for List<T>.
impl SequenceLiteralBuilder for List<T> {
    type Element = T;
    type Output = List<T>;

    fn new_literal(capacity: i32) -> List<T> {
        return List::with_capacity(capacity);
    }

    fn push_literal(&mut self, value: T) with stores[value] {
        self.push(value);
    }

    fn build(&self) -> List<T> {
        return *self;
    }
}

impl Default for List<T> {
    pub fn default() -> List<T> {
        return [] as List<T>;
    }
}
