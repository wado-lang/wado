#![no_prelude]
#![stdlib("core:prelude/tuple.wado")]
// Variadic trait implementations for tuple types.
//
// These implementations use compile-time tuple enumeration (for let v of *self)
// which is expanded at monomorphization time.

use { Formatter } from "core:prelude/format.wado";
use { Ordering } from "core:prelude/traits.wado";

/// The alternate (`#`) rendering the tuple `Inspect` hands off to: one element
/// per indented line.
fn inspect_tuple_alternate<..T: Inspect>(t: &[..T], f: &mut Formatter) {
    // An empty tuple has no element to indent, so it writes the two characters
    // rather than a brace it immediately closes. `len()` is a compile-time
    // constant, so the arm not taken folds away.
    if t.len() == 0 {
        f.write_str(&"[]");
        return;
    }
    f.open_brace("[");
    for let v of *t {
        f.write_newline_indent();
        v.inspect(f);
        f.write_str(&",");
    }
    f.close_brace("]");
}

/// Inspect for tuples: `[1, "hello", true]`, or one indented element per line
/// under the alternate (`#`) form.
impl<..T: Inspect> Inspect for [..T] {
    fn inspect(&self, f: &mut Formatter) {
        if f.alternate {
            inspect_tuple_alternate(self, f);
            return;
        }
        f.write_str(&"[");
        let mut first = true;
        for let v of *self {
            if !first {
                f.write_str(&", ");
            }
            first = false;
            v.inspect(f);
        }
        f.write_str(&"]");
    }
}

/// Eq for tuples: element-wise equality.
impl<..T: Eq> Eq for [..T] {
    fn eq(&self, other: &Self) -> bool {
        for let [a, b] of [*self, *other].zip() {
            if a != b {
                return false;
            }
        }
        return true;
    }
}

/// Ord for tuples: lexicographic comparison.
impl<..T: Ord> Ord for [..T] {
    fn cmp(&self, other: &Self) -> Ordering {
        for let [a, b] of [*self, *other].zip() {
            let ord = a.cmp(&b);
            if ord != Ordering::Equal {
                return ord;
            }
        }
        return Ordering::Equal;
    }
}

/// The alternate (`#`) rendering the tuple `Display` hands off to: one element
/// per indented line.
fn display_tuple_alternate<..T: Display>(t: &[..T], f: &mut Formatter) {
    if t.len() == 0 {
        f.write_str(&"[]");
        return;
    }
    f.open_brace("[");
    for let v of *t {
        f.write_newline_indent();
        v.fmt(f);
        f.write_str(&",");
    }
    f.close_brace("]");
}

/// Display for tuples: same as Inspect (tuples have no user-facing format).
impl<..T: Display> Display for [..T] {
    fn fmt(&self, f: &mut Formatter) {
        if f.alternate {
            display_tuple_alternate(self, f);
            return;
        }
        f.write_str(&"[");
        let mut first = true;
        for let v of *self {
            if !first {
                f.write_str(&", ");
            }
            first = false;
            v.fmt(f);
        }
        f.write_str(&"]");
    }
}
