// Variadic trait implementations for tuple types.
//
// These implementations use compile-time tuple enumeration (for let v of *self)
// which is expanded at monomorphization time.
#![no_prelude]
#![stdlib("core:prelude/tuple.wado")]

use { Formatter } from "core:prelude/format.wado";

/// Inspect for tuples: `[1, "hello", true]`
impl<..T: Inspect> Inspect for [..T] {
    fn inspect(&self, f: &mut Formatter) {
        f.write_str("[");
        let mut first = true;
        for let v of *self {
            if !first {
                f.write_str(", ");
            }
            first = false;
            v.inspect(f);
        }
        f.write_str("]");
    }
}

/// InspectAlt (pretty-print) for tuples:
/// ```
/// [
///   1,
///   "hello",
///   true,
/// ]
/// ```
impl<..T: InspectAlt> InspectAlt for [..T] {
    fn inspect_alt(&self, f: &mut Formatter) {
        f.open_brace("[");
        for let v of *self {
            f.write_newline_indent();
            v.inspect_alt(f);
            f.write_str(",");
        }
        f.close_brace("]");
    }
}

/// Eq for tuples: element-wise equality.
impl<..T: Eq> Eq for [..T] {
    fn eq(&self, other: &Self) -> bool {
        for let [a, b] of [*self, *other].zip() {
            if a != b {
                return false;
            }
        }
        return true;
    }
}

/// Ord for tuples: lexicographic comparison.
impl<..T: Ord> Ord for [..T] {
    fn cmp(&self, other: &Self) -> Ordering {
        for let [a, b] of [*self, *other].zip() {
            let ord = a.cmp(&b);
            if ord != Ordering::Equal {
                return ord;
            }
        }
        return Ordering::Equal;
    }
}

/// Display for tuples: same as Inspect (tuples have no user-facing format).
impl<..T: Display> Display for [..T] {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str("[");
        let mut first = true;
        for let v of *self {
            if !first {
                f.write_str(", ");
            }
            first = false;
            v.fmt(f);
        }
        f.write_str("]");
    }
}

/// DisplayAlt for tuples: same as InspectAlt.
impl<..T: DisplayAlt> DisplayAlt for [..T] {
    fn fmt_alt(&self, f: &mut Formatter) {
        f.open_brace("[");
        for let v of *self {
            f.write_newline_indent();
            v.fmt_alt(f);
            f.write_str(",");
        }
        f.close_brace("]");
    }
}
