// One Component Model copy moves at most 2^28 - 1 elements, and a longer one traps.
test "a read offering more room than one copy moves does not trap" {
    let [rx, tx] = Stream::<u8>::new();
    tx.drop();
    let [rx, chunk] = rx.start_read(1 << 28).finish();
    rx.drop();
    assert chunk.items.is_empty();
    assert chunk.result == CopyResult::Dropped;
}
