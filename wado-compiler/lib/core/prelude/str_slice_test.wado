//! Tests for `StrSlice` and the `AsStrSlice` conversion.

test "a view of a whole string sees its bytes" {
    let s = "banana";
    let v = s.as_str_slice();
    assert v.len() == 6;
    assert !v.is_empty();
    assert v.get_byte_unchecked(0) == b'b';
    assert v.to_string() == "banana";
}

test "sub takes a byte range counted from the view's start" {
    let v = "banana".as_str_slice();
    assert v.sub(1, 4).to_string() == "ana";
    assert v.sub(1, 4).sub(1, 3).to_string() == "na";
    assert v.sub(2, 2).is_empty();
}

#[expect_trap]
test "sub rejects a range out of bounds" {
    let v = "abc".as_str_slice();
    v.sub(0, 4);
}

#[expect_trap]
test "sub rejects an end off a character boundary" {
    let v = "日本語".as_str_slice();
    v.sub(0, 1);
}

test "a view's ends are character boundaries" {
    let v = "日本語".as_str_slice();
    assert v.len() == 9;
    assert v.is_char_boundary(0);
    assert v.is_char_boundary(3);
    assert v.is_char_boundary(9);
    assert !v.is_char_boundary(1);
    assert !v.is_char_boundary(2);
}

test "a view iterates by character, not by byte" {
    let v = "日本語".as_str_slice();
    let mut count = 0;
    for let _ of v.chars() {
        count += 1;
    }
    assert count == 3;

    let mut first = ' ';
    for let c of v.sub(3, 9).chars() {
        first = c;
        break;
    }
    assert first == '本';
}

test "a view compares as the text it views" {
    let v = "banana".as_str_slice();
    assert v.sub(1, 4) == "xanax".as_str_slice().sub(1, 4);
    assert v.sub(0, 3) != v.sub(3, 6);
    assert v.sub(1, 2) < v.sub(0, 1);
    assert v.sub(0, 3) < v.sub(0, 4);
}

test "a view prints as the text it views" {
    let v = "banana".as_str_slice();
    assert `${v.sub(1, 4)}` == "ana";
    assert `${v.sub(1, 4):?}` == "\"ana\"";
}

test "a view's bytes reach the byte APIs" {
    let v = "banana".as_str_slice().sub(1, 4);
    assert v.as_bytes().len() == 3;
    let mut n = 0;
    for let b of v.bytes() {
        if b == b'a' {
            n += 1;
        }
    }
    assert n == 2;
}

/// One signature takes an owned string, a reference to one, or a view of one.
fn first_byte<S: AsStrSlice>(s: &S) -> u8 {
    return s.as_str_slice().get_byte_unchecked(0);
}

test "AsStrSlice spans owned strings, references, and views" {
    let owned = "banana";
    assert first_byte(&owned) == b'b';
    assert first_byte(&"banana") == b'b';
    assert first_byte(&owned.as_str_slice().sub(1, 4)) == b'a';
}
