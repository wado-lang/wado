#![no_prelude]
#![stdlib("core:prelude/intparse.wado")]
// Integer and float parsing from strings.
//
// Provides shared `ParseIntError` / `ParseFloatError` error types and the
// core digit-parsing routines used by the `from_str_radix`, `from_str`, and
// `from_str_hex` methods on primitive numeric types (see `primitive.wado`
// and `int128.wado`).

use { String, StrSlice, AsStrSlice } from "core:prelude/string.wado";
use { Formatter } from "core:prelude/format.wado";
use { Option, Result } from "core:prelude/types.wado";
use { u128 } from "core:prelude/int128.wado";
use { Display, Error, From, LenientParseError } from "core:prelude/traits.wado";


use { BinaryFormat, parse_text_bits } from "core:prelude/fpfmt.wado";

/// Preprocess a human-supplied integer string for a lenient parse: split off
/// an optional leading sign, detect an optional radix prefix (`0x`/`0X`,
/// `0o`/`0O`, `0b`/`0B`; default radix 10), and strip `_` separators from the
/// digit body. Returns the cleaned string (sign re-attached, prefix removed,
/// underscores stripped) paired with the radix, ready for `from_str_radix`.
///
/// Whitespace is not touched. An empty input, a lone sign, a lone radix
/// prefix, or a stray underscore-only body yields `Err`.
internal fn lenient_int_preprocess<T: AsStrSlice>(text: T) -> Result<[String, u32], LenientParseError> {
    let s = text.as_str_slice();
    let len = s.len();
    if len == 0 {
        return Result::Err(LenientParseError::new("empty integer string"));
    }
    let first = s.get_byte_unchecked(0);
    let is_negative = first == b'-';
    let has_sign = is_negative || first == b'+';
    let mut i = if has_sign { 1 } else { 0 };
    if i >= len {
        return Result::Err(LenientParseError::new("integer string has a sign but no digits"));
    }
    let mut radix: u32 = 10;
    if s.get_byte_unchecked(i) == b'0' && i + 2 <= len {
        let marker = s.get_byte_unchecked(i + 1);
        if marker == b'x' || marker == b'X' {
            radix = 16;
            i += 2;
        } else if marker == b'o' || marker == b'O' {
            radix = 8;
            i += 2;
        } else if marker == b'b' || marker == b'B' {
            radix = 2;
            i += 2;
        }
    }
    let mut cleaned = String::with_capacity(len);
    if is_negative {
        cleaned.push('-');
    }
    let mut digit_count = 0;
    for let mut j = i; j < len; j += 1 {
        let b = s.get_byte_unchecked(j);
        if b == b'_' {
            continue;
        }
        cleaned.push(char::from_u32_unchecked(b as u32));
        digit_count += 1;
    }
    if digit_count == 0 {
        return Result::Err(LenientParseError::new("integer string has no digits"));
    }
    return Result::Ok([cleaned, radix]);
}

impl From<ParseIntError> for LenientParseError {
    fn from(e: ParseIntError) -> LenientParseError {
        let reason: String = match e.kind() {
            Empty => "empty integer string",
            InvalidDigit => "invalid digit in integer string",
            PosOverflow => "integer string overflows the target type",
            NegOverflow => "integer string underflows the target type",
        };
        return LenientParseError::new(reason);
    }
}

impl From<ParseFloatError> for LenientParseError {
    fn from(e: ParseFloatError) -> LenientParseError {
        let reason: String = match e.kind() {
            Empty => "empty float string",
            Invalid => "invalid float string",
        };
        return LenientParseError::new(reason);
    }
}

/// Strip `_` separators from the digit body of a human-supplied float string
/// for a lenient parse. Whitespace is not touched; the result is handed to the
/// float `FromStr` (which already accepts `nan`/`inf`/`infinity`
/// case-insensitively).
///
/// `_` is only a digit-grouping separator, so it is stripped only when the
/// token is numeric (starts, after an optional sign, with a digit or `.`).
/// A special word like `inf` / `nan` starts with a letter and is handed
/// through unchanged, so a `_` inside it (`i_nf`) stays invalid.
internal fn lenient_float_preprocess<T: AsStrSlice>(text: T) -> String {
    let s = text.as_str_slice();
    let len = s.len();
    let head = if len > 0 && (s.get_byte_unchecked(0) == b'+' || s.get_byte_unchecked(0) == b'-') { 1 } else { 0 };
    if head >= len {
        return s.to_string();
    }
    let first = s.get_byte_unchecked(head);
    let is_numeric = first.is_ascii_digit() || first == b'.';
    if !is_numeric {
        return s.to_string();
    }
    let mut cleaned = String::with_capacity(len);
    for let mut j = 0; j < len; j += 1 {
        let b = s.get_byte_unchecked(j);
        if b == b'_' {
            continue;
        }
        cleaned.push(char::from_u32_unchecked(b as u32));
    }
    return cleaned;
}

/// Kind of failure returned by integer parsing.
pub enum IntErrorKind {
    /// The input string was empty.
    Empty,
    /// The input contained a character that is not a valid digit in the radix.
    InvalidDigit,
    /// The value was greater than the maximum representable in the target type.
    PosOverflow,
    /// The value was less than the minimum representable in the target type.
    NegOverflow,
}

/// Error returned by integer parsing.
pub struct ParseIntError {
    pub kind: IntErrorKind,
}

impl ParseIntError {
    pub fn new(kind: IntErrorKind) -> ParseIntError {
        return ParseIntError { kind };
    }

    pub fn kind(&self) -> IntErrorKind {
        return self.kind;
    }
}

impl Display for ParseIntError {
    fn fmt(&self, f: &mut Formatter) {
        let message: String = match self.kind {
            Empty => "cannot parse integer from empty string",
            InvalidDigit => "invalid digit found in string",
            PosOverflow => "number too large to fit in target type",
            NegOverflow => "number too small to fit in target type",
        };
        f.write_str(&message);
    }
}

impl Error for ParseIntError {
}

/// Kind of failure returned by float parsing.
pub enum FloatErrorKind {
    /// The input string was empty.
    Empty,
    /// The input was malformed.
    Invalid,
}

/// Error returned by float parsing.
pub struct ParseFloatError {
    pub kind: FloatErrorKind,
}

impl ParseFloatError {
    pub fn new(kind: FloatErrorKind) -> ParseFloatError {
        return ParseFloatError { kind };
    }

    pub fn kind(&self) -> FloatErrorKind {
        return self.kind;
    }
}

impl Display for ParseFloatError {
    fn fmt(&self, f: &mut Formatter) {
        let message: String = match self.kind {
            Empty => "cannot parse float from empty string",
            Invalid => "invalid float literal",
        };
        f.write_str(&message);
    }
}

impl Error for ParseFloatError {
}

/// Translate an ASCII byte into a digit value in the range [0, 36).
/// Returns -1 if the byte is not a valid alphanumeric digit.
fn digit_value(b: u8) -> i32 {
    let c = b as i32;
    if c >= '0' as i32 && c <= '9' as i32 {
        return c - '0' as i32;
    }
    if c >= 'a' as i32 && c <= 'z' as i32 {
        return c - 'a' as i32 + 10;
    }
    if c >= 'A' as i32 && c <= 'Z' as i32 {
        return c - 'A' as i32 + 10;
    }
    return -1;
}

/// Parse the view as an unsigned integer in the given radix. Caller is
/// responsible for stripping any sign. `radix` must be in 2..=36.
///
/// Returns `Err(Empty)` if the view is empty, `Err(InvalidDigit)` on bad
/// characters, or `Err(PosOverflow)` if the accumulator exceeds `u64::MAX`.
internal fn parse_u64_digits(s: &StrSlice, radix: u32) -> Result<u64, IntErrorKind> {
    let len = s.len();
    if len == 0 {
        return Result::Err(IntErrorKind::Empty);
    }
    let r = radix as u64;
    let max_before_mul: u64 = u64::MAX / r;
    let max_digit_for_overflow: u64 = u64::MAX - max_before_mul * r;
    let mut acc: u64 = 0;
    for let mut i = 0; i < len; i += 1 {
        let d = digit_value(s.get_byte_unchecked(i));
        if d < 0 || d >= radix as i32 {
            return Result::Err(IntErrorKind::InvalidDigit);
        }
        let d64 = d as u64;
        if acc > max_before_mul || acc == max_before_mul && d64 > max_digit_for_overflow {
            return Result::Err(IntErrorKind::PosOverflow);
        }
        acc = acc * r + d64;
    }
    return Result::Ok(acc);
}

/// Parse the view as an unsigned integer in the given radix, accumulating into
/// a `u128`. Caller strips any sign.
internal fn parse_u128_digits(s: &StrSlice, radix: u32) -> Result<u128, IntErrorKind> {
    let len = s.len();
    if len == 0 {
        return Result::Err(IntErrorKind::Empty);
    }
    let r: u128 = radix as u128;
    let max128 = u128::from_pair(u64::MAX, u64::MAX);
    let divmod = max128.div_rem(&r);
    let max_before_mul: u128 = divmod[0];
    let max_digit_for_overflow: u128 = divmod[1];
    let mut acc: u128 = 0;
    for let mut i = 0; i < len; i += 1 {
        let d = digit_value(s.get_byte_unchecked(i));
        if d < 0 || d >= radix as i32 {
            return Result::Err(IntErrorKind::InvalidDigit);
        }
        let d128: u128 = d as u128;
        if acc > max_before_mul || acc == max_before_mul && d128 > max_digit_for_overflow {
            return Result::Err(IntErrorKind::PosOverflow);
        }
        acc = acc * r + d128;
    }
    return Result::Ok(acc);
}

/// Split a leading `+`/`-` off the view, returning whether it was `-` and the
/// digits after it.
///
/// Rejects an empty view as `Empty` and a sign with no following digits (e.g.
/// lone `"+"` or `"-"`) as `InvalidDigit`. Per-type bound checks are reserved
/// for the caller.
internal fn split_sign(s: &StrSlice) -> Result<[bool, StrSlice], IntErrorKind> {
    let len = s.len();
    if len == 0 {
        return Result::Err(IntErrorKind::Empty);
    }
    let first = s.get_byte_unchecked(0);
    let is_negative = first == b'-';
    let has_sign = is_negative || first == b'+';
    if has_sign && len == 1 {
        return Result::Err(IntErrorKind::InvalidDigit);
    }
    return Result::Ok([is_negative, s.sub_unchecked(if has_sign { 1 } else { 0 }, len)]);
}

/// Split a leading `+` (if any) off the view, returning the digits after it.
///
/// Rejects an empty view as `Empty` and `-`-prefixed input as `InvalidDigit`
/// per Rust's behaviour.
internal fn split_plus(s: &StrSlice) -> Result<StrSlice, IntErrorKind> {
    let len = s.len();
    if len == 0 {
        return Result::Err(IntErrorKind::Empty);
    }
    if s.get_byte_unchecked(0) == b'+' {
        if len == 1 {
            return Result::Err(IntErrorKind::InvalidDigit);
        }
        return Result::Ok(s.sub_unchecked(1, len));
    }
    return Result::Ok(*s);
}

/// Check that the radix is supported (2..=36); panic otherwise.
internal fn assert_radix(radix: u32) {
    if radix < 2 || radix > 36 {
        panic("from_str_radix: radix must be in 2..=36");
    }
}

/// Parse a signed integer in the given radix from the view, clamped to
/// `[-min_abs, max]`. `max` is the largest positive value; `min_abs` is the
/// absolute value of the most negative representable value (e.g. for i32,
/// `max = 2147483647`, `min_abs = 2147483648`). Handles the optional leading
/// `+`/`-` sign.
internal fn parse_i64_radix(s: &StrSlice, radix: u32, max: i64, min_abs: u64) -> Result<i64, ParseIntError> {
    assert_radix(radix);
    let [is_negative, digits] = match split_sign(s) {
        Ok(p) => p,
        Err(k) => {
            return Result::Err(ParseIntError::new(k));
        },
    };
    return match parse_u64_digits(&digits, radix) {
        Ok(v) => if is_negative {
            if v > min_abs {
                Result::Err(ParseIntError::new(IntErrorKind::NegOverflow));
            } else {
                // (0 - v) as i64 wraps correctly, including at i64::MIN.
                Result::Ok((0 - v) as i64);
            }
        } else if v > max as u64 {
            Result::Err(ParseIntError::new(IntErrorKind::PosOverflow));
        } else {
            Result::Ok(v as i64);
        },
        Err(k) => {
            let kind = if is_negative && k == IntErrorKind::PosOverflow { IntErrorKind::NegOverflow } else { k };
            Result::Err(ParseIntError::new(kind));
        },
    };
}

/// Parse an unsigned integer in the given radix from the view, clamped to
/// `[0, max]`.
internal fn parse_u64_radix(s: &StrSlice, radix: u32, max: u64) -> Result<u64, ParseIntError> {
    assert_radix(radix);
    let digits = match split_plus(s) {
        Ok(v) => v,
        Err(k) => {
            return Result::Err(ParseIntError::new(k));
        },
    };
    return match parse_u64_digits(&digits, radix) {
        Ok(v) => if v > max { Result::Err(ParseIntError::new(IntErrorKind::PosOverflow)) } else { Result::Ok(v) },
        Err(k) => Result::Err(ParseIntError::new(k)),
    };
}

/// Parse a float of `format` from the view, as its bits, without allocating a
/// substring. An empty view returns `Err(Empty)` so the public surface stays total.
internal fn parse_float_bits(s: &StrSlice, format: &BinaryFormat) -> Result<u64, ParseFloatError> {
    if s.is_empty() {
        return Result::Err(ParseFloatError::new(FloatErrorKind::Empty));
    }
    return match parse_text_bits(s, format) {
        Some(bits) => Result::Ok(bits),
        None => Result::Err(ParseFloatError::new(FloatErrorKind::Invalid)),
    };
}
