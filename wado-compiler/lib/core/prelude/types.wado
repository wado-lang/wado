#![no_prelude]
#![stdlib("core:prelude/types.wado")]
// Core variant types for the Wado Prelude.
//
// This module defines fundamental sum types that are used throughout Wado programs.

use { String } from "core:prelude/string.wado";
use { List } from "core:prelude/list.wado";
use { Slice } from "core:prelude/slice.wado";
use { ByteList } from "core:prelude/bytes.wado";
use { AffineResource } from "core:prelude/traits.wado";


/// Tuple type family declaration — establishes `core:prelude` as the owner of all tuple types.
#[compiler_item("tuple")]
internal type [..T];

/// Box wraps a value on the GC heap, enabling references to primitives.
#[compiler_item("box")]
internal struct Box<T> {
    pub value: T,
}

/// Optional value - either None or Some(T). The derived order puts None first,
/// as Rust's does.
#[compiler_item("option")]
pub variant Option<affine T> {
    #[compiler_item("option_none")]
    None,
    #[compiler_item("option_some")]
    Some(T),
}

/// Result type - either Ok(T) or Err(E)
#[compiler_item("result")]
pub variant Result<affine T, affine E> {
    #[compiler_item("result_ok")]
    Ok(T),
    #[compiler_item("result_err")]
    Err(E),
}
impl<affine T> Option<T> {
    /// Takes the value out, leaving None in its place.
    pub fn take(&mut self) -> Option<T> {
        return builtin::replace(self, null);
    }

    /// Puts `value` in, returning what was there.
    pub fn replace(&mut self, value: T) -> Option<T> {
        return builtin::replace(self, Option::Some(value));
    }

    /// Returns the contained value, panicking if None.
    pub fn unwrap(self) -> T {
        if let Some(v) = self {
            return v;
        }
        panic("called Option::unwrap() on a None value");
    }

    /// Returns the contained value, panicking with `msg` if None.
    pub fn expect(self, msg: String) -> T {
        if let Some(v) = self {
            return v;
        }
        panic(msg);
    }

    /// Returns the contained value, or `default` if None.
    pub fn unwrap_or(self, default: T) -> T {
        return match self {
            Some(v) => v,
            None => default,
        };
    }

    /// Applies `f` to the contained value, leaving None untouched.
    pub fn map<affine U>(self, mut f: fn mut(T) -> U with _) -> Option<U> with _ {
        return match self {
            Some(v) => Option::<U>::Some(f(v)),
            None => Option::<U>::None,
        };
    }

    /// Converts to a Result, mapping None to `Err(err)`.
    pub fn ok_or<affine E>(self, err: E) -> Result<T, E> {
        return match self {
            Some(v) => Result::<T, E>::Ok(v),
            None => Result::<T, E>::Err(err),
        };
    }

    #[unavailable("a closure hides its cost at the call site; write `match` when the fallback must not be evaluated")]
    pub fn unwrap_or_else(&self);

    #[unavailable("a closure hides its cost at the call site; write `match` when the error must not be built")]
    pub fn ok_or_else(&self);

    #[unavailable("the name reads as map-then-fallback while the signature takes the fallback first; write `map(f).unwrap_or(v)`")]
    pub fn map_or(&self);

    #[unavailable("the argument order traps the same way `map_or` does; write `map(f)` and match on the result")]
    pub fn map_or_else(&self);
}

/// Cold slow path for `unwrap`/`expect` failures: traps with `${msg}: ${value:?}`.
internal fn unwrap_failed<affine V>(msg: String, value: V) -> ! {
    panic(`${msg}: ${value:?}`);
}

impl<affine T, affine E> Result<T, E> {
    /// Returns the contained Ok value, panicking (with the Err value) if Err.
    pub fn unwrap(self) -> T {
        return match self {
            Ok(v) => v,
            Err(e) => unwrap_failed("called Result::unwrap() on an Err value", e),
        };
    }

    /// Returns true if this is an Ok value.
    pub fn is_ok(&self) -> bool {
        return self matches { Ok(_) };
    }

    /// Returns true if this is an Err value.
    pub fn is_err(&self) -> bool {
        return !self.is_ok();
    }

    /// Returns the contained Ok value, panicking with `msg` (and the Err value) if Err.
    pub fn expect(self, msg: String) -> T {
        return match self {
            Ok(v) => v,
            Err(e) => unwrap_failed(msg, e),
        };
    }

    /// Returns the contained Err value, panicking (with the Ok value) if Ok.
    pub fn unwrap_err(self) -> E {
        return match self {
            Err(e) => e,
            Ok(v) => unwrap_failed("called Result::unwrap_err() on an Ok value", v),
        };
    }

    /// Returns the contained Err value, panicking with `msg` (and the Ok value) if Ok.
    pub fn expect_err(self, msg: String) -> E {
        return match self {
            Err(e) => e,
            Ok(v) => unwrap_failed(msg, v),
        };
    }

    /// Returns the contained Ok value, or `default` if Err.
    pub fn unwrap_or(self, default: T) -> T {
        return match self {
            Ok(v) => v,
            Err(_) => default,
        };
    }

    /// Applies `f` to the contained Ok value, leaving an Err untouched.
    pub fn map<affine U>(self, mut f: fn mut(T) -> U with _) -> Result<U, E> with _ {
        return match self {
            Ok(v) => Result::<U, E>::Ok(f(v)),
            Err(e) => Result::<U, E>::Err(e),
        };
    }

    /// Applies `f` to the contained Err value, leaving an Ok untouched.
    pub fn map_err<affine F>(self, mut f: fn mut(E) -> F with _) -> Result<T, F> with _ {
        return match self {
            Ok(v) => Result::<T, F>::Ok(v),
            Err(e) => Result::<T, F>::Err(f(e)),
        };
    }

    #[unavailable("a closure hides its cost at the call site; write `match` to read the `Err` value or to skip building a fallback")]
    pub fn unwrap_or_else(&self);
}

impl<affine T> Default for Option<T> {
    pub fn default() -> Option<T> {
        return null;
    }
}

/// The identity of a live affine resource, which owns nothing. A dropped
/// resource's identity may come back for a later one, since the host reuses a
/// freed handle index. Nothing converts it back into a resource.
pub struct ResourceId {
    handle: i32,
}

impl ResourceId {
    /// The identity of `r`. A static function rather than a method, so it
    /// takes no name from any resource.
    pub fn of<affine R: AffineResource>(r: &R) -> ResourceId {
        return ResourceId { handle: builtin::resource_handle(r) };
    }
}

/// Readable end of an async value (WASI Component Model future).
/// Opaque i32 handle managed by the runtime.
///
/// Use `Future::<T>::new()` to create a `[Future<T>, FutureWritable<T>]` pair.
/// The readable end is passed to consumers; the writable end fulfills the future.
#[compiler_item("future")]
pub resource Future<T> {
    /// Create a new future pair: [Future<T>, FutureWritable<T>].
    #[cm("future-new")]
    fn new() -> [Future<T>, FutureWritable<T>];

    /// Read the value from the future: Some(value) when fulfilled, None if the
    /// writer dropped without writing. A readable end is read once, so the read
    /// consumes it.
    #[cm("future-read")]
    fn read(self) -> Option<T>;

    /// Cancel an in-progress read. Blocks until cancellation completes.
    #[cm("future-cancel-read")]
    fn cancel_read(&self);

    /// Drop the readable end of the future.
    #[cm("future-drop-readable")]
    fn drop(self);
}

/// Writable end of an async value (WASI Component Model future).
/// Opaque i32 handle managed by the runtime.
#[compiler_item("future_writable")]
pub resource FutureWritable<T> {
    /// Fulfill the future with a value. A writable end is written once, so the
    /// write consumes it. A reader that dropped first leaves the value in
    /// `rest`.
    #[cm("future-write")]
    fn write(self, value: T) -> FutureWrite<T>;

    /// Cancel an in-progress write. Blocks until cancellation completes.
    #[cm("future-cancel-write")]
    fn cancel_write(&self);

    /// Drop this writable end handle. Traps if no value has been written yet.
    #[cm("future-drop-writable")]
    fn drop(self);
}

/// How one Component Model copy ended (`CanonicalABI.md`, `CopyResult`).
/// It describes that copy, not the stream: only `Dropped` ends the stream.
#[compiler_item("copy_result")]
pub enum CopyResult {
    /// The copy finished.
    Completed,
    /// The peer end is gone; no further copy is possible on this end.
    Dropped,
    /// A cancel finished and returned the buffer; the end stays usable.
    Cancelled,
}

/// What one read copy moved, and how that copy ended. A copy carries elements
/// and the peer's drop together, so `result` is what says more follows.
pub struct StreamChunk<affine T> {
    pub items: List<T>,
    pub result: CopyResult,
}

/// What one write copy did not deliver, and how it ended. A reader may take a
/// prefix, and the elements it left come back in `rest`.
pub struct StreamWrite<affine T> {
    pub rest: List<T>,
    pub result: CopyResult,
}

/// How a `FutureWritable::write` ended.
#[compiler_item("future_write_result")]
pub enum FutureWriteResult {
    /// The reader took the value.
    Completed,
    /// The reader dropped first, and the value came back.
    Dropped,
    /// The reader has not read yet. The host holds the value and hands it to
    /// the reader, so it is no longer the writer's.
    Pending,
}

/// What `FutureWritable::write` did not deliver, and how its copy ended: the
/// value comes back in `rest` where the reader dropped first.
#[compiler_item("future_write")]
pub struct FutureWrite<affine T> {
    pub rest: Option<T>,
    pub result: FutureWriteResult,
}

/// Readable end of an async sequence (WASI Component Model stream).
/// `Stream::<T>::new()` creates the `[Stream<T>, StreamWritable<T>]` pair.
#[compiler_item("stream")]
pub resource Stream<T> {
    #[cm("stream-new")]
    fn new() -> [Stream<T>, StreamWritable<T>];

    /// One Component Model copy of up to `max` elements, started and not
    /// waited for. It is the operation a handler answers, with
    /// `StartedRead::settled`. A program calls `start_read`, which holds the
    /// end for the copy: a second copy on an end that is copying traps, and
    /// a `StartedRead` dropped in flight waits for its copy where a
    /// `ReadCopy` cancels it.
    #[cm("stream-read")]
    fn begin_read(&self, max: i32) -> StartedRead<T>;

    /// Cancel the copy in flight, blocking until it settles, and return the
    /// packed word the Component Model answers: the count the copy moved
    /// shifted left by four, over its `CopyResult`. A `ReadCopy` dropped in
    /// flight calls it, so a handler that started the copy on another end
    /// answers it by cancelling there. It traps on an end with no copy in
    /// flight.
    #[cm("stream-cancel-read")]
    fn cancel_read(&self) -> u32;

    /// Drop the readable end of the stream.
    #[cm("stream-drop-readable")]
    fn drop(self);
}

impl<affine T> Stream<T> {
    /// The `count` elements a read on this end copied to `ptr`, lifted.
    #[cm("stream-lift")]
    internal fn lift_copied(&self, ptr: i32, count: i32) -> List<T>;

    /// Start one copy of up to `max` elements without waiting for it. The end
    /// moves into the copy, and `ReadCopy::finish` hands it back.
    pub fn start_read(self, max: i32) -> ReadCopy<T> {
        let started = self.begin_read(max);
        return ReadCopy { copy: Option::Some([self, started]) };
    }
}

impl<T> Stream<T> {
    /// Read until the writable end drops, and return everything it wrote.
    /// Only the result stops it: an empty `Completed` copy is the writer
    /// offering nothing this time, and more can still follow.
    pub fn read_to_end(&self) -> List<T> {
        return self.read_to_end_sized(0);
    }

    /// `read_to_end` into a buffer made for `expected` elements up front, so a
    /// stream whose length is known is never copied into a doubled buffer. A
    /// doubling past half the address space is what a large file cannot afford.
    pub fn read_to_end_sized(&self, expected: i32) -> List<T> {
        let mut all = List::<T>::with_capacity(expected);
        loop {
            let chunk = self.begin_read(STREAM_CHUNK_ELEMENTS).settle(self);
            all.extend(&chunk.items);
            if chunk.result != CopyResult::Completed {
                return all;
            }
        }
    }
}

impl Stream<u8> {
    /// `read_to_end`, as the byte buffer a byte stream carries.
    pub fn read_to_end_bytes(&self) -> ByteList {
        return self.read_to_end() as ByteList;
    }
}

/// Elements per copy in the read loop the stdlib runs. A copy blocks
/// until the peer moves, so this bounds the buffer, not the throughput.
internal global STREAM_CHUNK_ELEMENTS: i32 = 4096;

/// A read copy as `Stream::begin_read` started it: one the host may still be
/// copying into `buffer`, or one a handler settled with its `items`.
#[compiler_item("started_read")]
pub affine struct StartedRead<affine T> {
    internal buffer: CopyBuffer,
    internal items: List<T>,
}

impl<affine T> StartedRead<T> {
    /// A copy that already moved `chunk`, for a handler to answer
    /// `Stream::begin_read` with.
    pub fn settled(chunk: StreamChunk<T>) -> StartedRead<T> {
        return StartedRead {
            buffer: CopyBuffer::settled(copy_status(chunk.result)),
            items: chunk.items,
        };
    }

    /// What the copy moved, once it has settled, lifted as `end`'s elements.
    /// The buffer frees as this returns.
    internal fn settle(self, end: &Stream<T>) -> StreamChunk<T> {
        let mut started = self;
        let packed = started.buffer.settle();
        let count = cm_packed_upper(packed);
        // A settled copy's count is zero, as it moved nothing through `buffer`.
        let items = if count == 0 { started.items } else { end.lift_copied(started.buffer.ptr, count) };
        return StreamChunk { items, result: copy_result(packed) };
    }
}

/// One copy started on a stream end, holding the end until it is finished.
/// Dropping one in flight cancels it, and drops what it had copied.
pub affine struct ReadCopy<affine T> {
    copy: Option<[Stream<T>, StartedRead<T>]>,
}

impl<affine T> ReadCopy<T> {
    /// The end and what the copy moved. Waits for a copy that has not settled,
    /// so a copy that never joined a set finishes as well.
    pub fn finish(self) -> [Stream<T>, StreamChunk<T>] {
        let mut copy = self;
        let [end, started] = copy.copy.take().unwrap();
        let chunk = started.settle(&end);
        return [end, chunk];
    }
}

impl<affine T> Drop for ReadCopy<T> {
    fn drop(self) {
        let Some([end, mut started]) = self.copy else {
            return;
        };
        if started.buffer.ready_cancel() {
            started.buffer.packed = end.cancel_read() as i32;
        }
        // Lifting what the copy moved is what frees the memory and handles the
        // host lowered for it; the chunk then drops them.
        let _ = started.settle(&end);
    }
}

impl<affine T> Waitable for ReadCopy<T> {
    fn wait_on(&self) -> WaitOn {
        let Some([_, started]) = &self.copy else {
            unreachable();
        };
        return started.buffer.wait_on();
    }
}

/// Writable end of an async sequence (WASI Component Model stream).
#[compiler_item("stream_writable")]
pub resource StreamWritable<T> {
    /// One Component Model copy of `data`, started and not waited for. An
    /// empty `data` is the CM's readiness signal: it settles once a reader
    /// rendezvouses, having written nothing. It is the operation a handler
    /// answers, with `StartedWrite::settled`. A program calls `start_write`,
    /// which holds the end for the copy: a second copy on an end that is
    /// copying traps, and a `StartedWrite` dropped in flight waits for its
    /// copy where a `WriteCopy` cancels it.
    #[cm("stream-write")]
    fn begin_write(&self, data: List<T>) -> StartedWrite<T>;

    /// Cancel the copy in flight, as `Stream::cancel_read` does, for a
    /// `WriteCopy` dropped in flight.
    #[cm("stream-cancel-write")]
    fn cancel_write(&self) -> u32;

    /// `write_all` for a byte view, lowered once with no value-semantics copy.
    /// Any element type but a byte is a compile error.
    #[cm("stream-write-raw-all")]
    fn write_raw_all(&self, data: Slice<T>) -> CopyResult;

    /// Drop the writable end, signaling end-of-stream.
    #[cm("stream-drop-writable")]
    fn drop(self);
}

/// Whether a copy ends a write loop: the peer stopped, or it moved nothing and
/// retrying the same buffer would be a hang rather than a write.
internal fn write_copy_is_final(result: CopyResult, delivered: i32) -> bool {
    return result != CopyResult::Completed || delivered <= 0;
}

impl<affine T> StreamWritable<T> {
    /// Start one copy of `data` without waiting for it. The end moves into the
    /// copy, and `WriteCopy::finish` hands it back.
    pub fn start_write(self, data: List<T>) -> WriteCopy<T> {
        let started = self.begin_write(data);
        return WriteCopy { copy: Option::Some([self, started]) };
    }

    /// Write every element, or stop early when the readable end drops.
    /// Returns the result of the copy that ended the loop.
    pub fn write_all(&self, data: List<T>) -> CopyResult {
        if data.is_empty() {
            return CopyResult::Completed;
        }
        let mut pending = data;
        loop {
            let offered = pending.len();
            let written = self.begin_write(pending).settle();
            let delivered = offered - written.rest.len();
            if write_copy_is_final(written.result, delivered) || written.rest.is_empty() {
                return written.result;
            }
            pending = written.rest;
        }
    }
}

/// A write copy as `StreamWritable::begin_write` started it: one the host may
/// still be copying out of `buffer`, which holds `data` lowered, or one a
/// handler settled.
#[compiler_item("started_write")]
pub affine struct StartedWrite<affine T> {
    internal buffer: CopyBuffer,
    internal data: List<T>,
}

impl<affine T> StartedWrite<T> {
    /// A copy that already ended as `written` says, for a handler to answer
    /// `StreamWritable::begin_write` with.
    pub fn settled(written: StreamWrite<T>) -> StartedWrite<T> {
        return StartedWrite {
            buffer: CopyBuffer::settled(copy_status(written.result)),
            data: written.rest,
        };
    }

    /// What the copy left of `data`, once it has settled. The buffer frees as
    /// this returns.
    internal fn settle(self) -> StreamWrite<T> {
        let mut started = self;
        return take_written(&mut started.buffer, &mut started.data);
    }
}

impl<affine T> Drop for StartedWrite<T> {
    /// What the copy did not deliver is still the writer's, so it drops here.
    fn drop(self) {
        let mut StartedWrite { buffer, data } = self;
        let _ = take_written(&mut buffer, &mut data);
    }
}

/// What the copy `buffer` holds left of `data`, once it has settled. What it
/// delivered is the reader's, so it is forgotten rather than dropped, and the
/// copy then counts none: taking it again finds nothing left.
fn take_written<affine T>(buffer: &mut CopyBuffer, data: &mut List<T>) -> StreamWrite<T> {
    let packed = buffer.settle();
    let mut delivered = builtin::replace(data, []);
    let rest = delivered.split_off(cm_packed_upper(packed));
    builtin::forget(delivered);
    let result = copy_result(packed);
    buffer.packed = copy_status(result);
    return StreamWrite { rest, result };
}

/// One copy started on a writable end, holding the end until it is finished.
/// Dropping one in flight cancels it.
pub affine struct WriteCopy<affine T> {
    copy: Option<[StreamWritable<T>, StartedWrite<T>]>,
}

impl<affine T> WriteCopy<T> {
    /// The end and what the copy left of its data. Waits for a copy that has
    /// not settled, so a copy that never joined a set finishes as well.
    pub fn finish(self) -> [StreamWritable<T>, StreamWrite<T>] {
        let mut copy = self;
        let [end, started] = copy.copy.take().unwrap();
        return [end, started.settle()];
    }
}

impl<affine T> Drop for WriteCopy<T> {
    fn drop(self) {
        let Some([end, mut started]) = self.copy else {
            return;
        };
        if started.buffer.ready_cancel() {
            started.buffer.packed = end.cancel_write() as i32;
        }
    }
}

impl<affine T> Waitable for WriteCopy<T> {
    fn wait_on(&self) -> WaitOn {
        let Some([_, started]) = &self.copy else {
            unreachable();
        };
        return started.buffer.wait_on();
    }
}

/// What a stream or future copy answers when it must wait for the other end.
internal global CM_BLOCKED: i32 = -1;

/// The `CopyResult` a packed CM copy reports (`CanonicalABI.md`): the low
/// nibble of `(count << 4) | status`.
internal fn copy_result(packed: i32) -> CopyResult {
    return match packed & 0xf {
        0 => CopyResult::Completed,
        1 => CopyResult::Dropped,
        2 => CopyResult::Cancelled,
        _ => unreachable(),
    };
}

/// The packed word of a copy that moved nothing and ended as `result`.
fn copy_status(result: CopyResult) -> i32 {
    return match result {
        Completed => 0,
        Dropped => 1,
        Cancelled => 2,
    };
}

/// A copy a set reported, by its end's handle, with the packed result the host
/// reported it on.
struct CopySettlement {
    handle: i32,
    packed: i32,
}

/// The copies sets reported that no `finish` or drop has taken yet. The host
/// reports a copy once, so waiting on it again would block for good, and
/// cancelling it traps. The end stays alive inside its copy until the entry is
/// taken, so the host cannot reuse the handle meanwhile.
global mut SETTLED_COPIES: List<CopySettlement> = [];

fn settled_copy_at(handle: i32) -> Option<i32> {
    for let mut at = 0; at < SETTLED_COPIES.len(); at += 1 {
        if SETTLED_COPIES[at].handle == handle {
            return Option::Some(at);
        }
    }
    return null;
}

/// The linear memory a stream copy moves elements through, and the copy on
/// `handle` it belongs to: `packed` is what the canonical answered, BLOCKED
/// until the copy settles. The host may write the memory until then, so a
/// buffer dropped with its copy in flight waits for the copy before it frees.
#[compiler_item("copy_buffer")]
internal affine struct CopyBuffer {
    internal handle: i32,
    internal packed: i32,
    internal ptr: i32,
    internal size: i32,
    internal align: i32,
}

impl CopyBuffer {
    /// The buffer of a copy that ended as `packed` without the host, holding
    /// no memory.
    fn settled(packed: i32) -> CopyBuffer {
        return CopyBuffer { handle: 0, packed, ptr: 0, size: 0, align: 1 };
    }

    /// The packed result the copy settled on, waiting for it where it has not.
    fn settle(&mut self) -> i32 {
        self.packed = settled_copy(self.handle, self.packed);
        return self.packed;
    }

    /// Ready the copy for a cancel, and say whether it needs one: the host may
    /// still be copying.
    fn ready_cancel(&self) -> bool {
        if self.wait_on() matches { Settled(_) } {
            return false;
        }
        // A synchronous cancel traps on an end still in a set. Joining set 0
        // leaves whatever set it is in.
        builtin::waitable_join(self.handle, 0);
        return true;
    }

    /// The host reports a copy that blocked, once: a set that took the report
    /// recorded it in `SETTLED_COPIES`.
    fn wait_on(&self) -> WaitOn {
        let packed = if self.packed != CM_BLOCKED {
            self.packed;
        } else if let Some(at) = settled_copy_at(self.handle) {
            SETTLED_COPIES[at].packed;
        } else {
            return WaitOn::Host(ResourceId { handle: self.handle });
        };
        return WaitOn::Settled(ReadyEvent::Copied(copy_result(packed)));
    }
}

impl Drop for CopyBuffer {
    fn drop(self) {
        let _ = settled_copy(self.handle, self.packed);
        let _ = builtin::realloc(self.ptr, self.size, self.align, 0);
    }
}

/// The packed result of the copy on `handle` that answered `packed`: that
/// answer, the one a set reported, or the one the host reports once this
/// waits for it.
fn settled_copy(handle: i32, packed: i32) -> i32 {
    if packed != CM_BLOCKED {
        return packed;
    }
    if let Some(at) = settled_copy_at(handle) {
        return SETTLED_COPIES.remove(at).packed;
    }
    return cm_await_copy(handle);
}

/// The packed result of the BLOCKED copy on `handle`, once the host reports it.
///
/// The handle must be unjoined before the set is dropped; a set still holding a
/// waitable cannot be deleted.
internal fn cm_await_copy(handle: i32) -> i32 {
    let ws = builtin::waitable_set_new();
    builtin::waitable_join(handle, ws);
    let evt_ptr = builtin::realloc(0, 0, 4, 8);
    let code = builtin::waitable_set_wait(ws, evt_ptr);
    let status = builtin::i32_load(evt_ptr + 4);
    let freed = builtin::realloc(evt_ptr, 8, 4, 0);
    builtin::waitable_join(handle, 0);
    builtin::waitable_set_drop(ws);
    return status;
}

/// What a `WaitableSet` waits on: a value the host reports events for by its
/// handle. It is sealed, so a set joins only what it can account for: the
/// standard library implements it on the calls, and a variant whose cases each
/// hold one derives it with `impl Waitable for V;`. A bare stream or future end
/// is none, since no copy on it is in flight: a copy started on a stream end,
/// `ReadCopy` or `WriteCopy`, is one.
#[compiler_item("waitable")]
pub affine trait Waitable with () {
    fn wait_on(&self) -> WaitOn;
}

/// How a `WaitableSet` learns that a `Waitable` is ready.
pub variant WaitOn {
    /// The host reports its event by this handle.
    Host(ResourceId),
    /// It is ready already, with this event: the host has none left to report.
    Settled(ReadyEvent),
}

/// The state an async call moved to (`CanonicalABI.md`, `Subtask.State`).
pub enum CallState {
    Starting,
    Started,
    Returned,
    CancelledBeforeStarted,
    CancelledBeforeReturned,
}

impl CallState {
    /// Whether the call resolved, by returning or by a cancel. Only a resolved
    /// call's subtask may drop: the Component Model traps on one in flight.
    pub fn is_resolved(&self) -> bool {
        return !*self matches { Starting | Started };
    }
}

/// The `CallState` the Component Model numbers `raw`.
internal fn call_state(raw: u32) -> CallState {
    return match raw {
        0 => CallState::Starting,
        1 => CallState::Started,
        2 => CallState::Returned,
        3 => CallState::CancelledBeforeStarted,
        4 => CallState::CancelledBeforeReturned,
        _ => unreachable(),
    };
}

/// What the host reported for a `WaitableSet` member.
pub variant ReadyEvent {
    /// The member has no handle for the host to report and no event of its
    /// own, so it is ready without one.
    Unreported,
    Call(CallState),
    /// A started stream copy settled, ending as this says.
    Copied(CopyResult),
}

/// An event the host reports for a waitable handle.
internal struct WaitEvent {
    internal handle: i32,
    internal event: ReadyEvent,
    /// What the host reported with the event: a copy's packed result, or a
    /// subtask's state.
    internal payload: i32,
}

/// A subtask whose resolution a set delivered, by its handle, with the state it
/// resolved in.
struct Resolution {
    handle: i32,
    state: CallState,
}

/// The resolutions sets delivered for subtasks not yet dropped. The Component
/// Model delivers one once, so the call holding the subtask learns of it here:
/// waiting on it again would block for good, and cancelling it traps. A
/// subtask's drop removes its entry, before the host reuses the handle.
global mut DELIVERED: List<Resolution> = [];

/// Where `DELIVERED` holds `handle`'s resolution.
fn delivered_at(handle: i32) -> Option<i32> {
    for let mut at = 0; at < DELIVERED.len(); at += 1 {
        if DELIVERED[at].handle == handle {
            return Option::Some(at);
        }
    }
    return null;
}

/// The state `handle`'s subtask resolved in, where a set delivered it.
fn delivered_state(handle: i32) -> Option<CallState> {
    return delivered_at(handle).map(|at: i32| DELIVERED[at].state);
}

/// Drops `subtask`, resolved, and forgets its delivered resolution.
fn drop_resolved(subtask: Subtask) {
    if let Some(at) = delivered_at(builtin::resource_handle(&subtask)) {
        let _ = DELIVERED.remove(at);
    }
    subtask.drop();
}

/// The upper 28 bits of a packed CM word: a copy's count, or a subtask's
/// handle. The word is unsigned, so bit 31 is part of the value.
internal fn cm_packed_upper(packed: i32) -> i32 {
    return (packed as u32 >> 4) as i32;
}

/// The host's waitable set, which holds handles. `WaitableSet` wraps one and
/// holds the values behind them. Waiting on one is benign in it: the set
/// observes nothing outside the values its owner joined.
internal resource RawWaitableSet {
    #[cm("waitable-set-new")]
    fn new() -> RawWaitableSet;

    /// Blocks until a joined handle has an event.
    #[cm("waitable-set-wait")]
    fn wait(&self) -> WaitEvent;

    /// The event a joined handle has, or None where none has one yet.
    #[cm("waitable-set-poll")]
    fn poll(&self) -> Option<WaitEvent>;

    /// Traps where a handle is still joined.
    #[cm("waitable-set-drop")]
    fn drop(self);
}

/// A set of values the host reports events for, owning each while it waits.
/// A wait moves the member that is ready back out. Dropping the set drops the
/// members it still holds.
///
/// A set has one member type. A loop waiting on several kinds declares a
/// variant of its own and derives `Waitable` on it with `impl Waitable for V;`.
pub affine struct WaitableSet<affine W: Waitable> {
    raw: RawWaitableSet,
    /// The members joined to `raw`, which the host reports events for.
    members: List<W>,
    /// The members the host has no event left to report for, in join order:
    /// one it does not know, `Unreported`, or a subtask whose resolution a set
    /// already delivered, reported again.
    ready: List<Ready<W>>,
}

/// A member of a `WaitableSet` that has an event, moved out of the set with
/// the event.
pub struct Ready<affine W> {
    pub member: W,
    pub event: ReadyEvent,
}

impl<affine W: Waitable> WaitableSet<W> {
    #[benign(RawWaitableSet)]
    pub fn new() -> WaitableSet<W> {
        return WaitableSet { raw: RawWaitableSet::new(), members: [], ready: [] };
    }

    /// Moves `member` into the set. A member joins one set at a time, so
    /// whether the host has an event left for it is settled here.
    pub fn join(&mut self, member: W) {
        match member.wait_on() {
            Host(id) => {
                builtin::waitable_join(id.handle, builtin::resource_handle(&self.raw));
                self.members.push(member);
            },
            Settled(event) => self.ready.push(Ready { member, event }),
        }
    }

    /// Blocks until a member has an event, and moves it out. A member ready
    /// without the host comes first. Traps on an empty set.
    #[benign(RawWaitableSet)]
    pub fn wait(&mut self) -> Ready<W> {
        assert !self.is_empty(), "a set waits on a member";
        if !self.ready.is_empty() {
            return self.ready.remove(0);
        }
        let event = self.raw.wait();
        return self.take_reported(event);
    }

    /// The member that has an event, moved out, or None where none has one
    /// yet.
    #[benign(RawWaitableSet)]
    pub fn poll(&mut self) -> Option<Ready<W>> {
        if !self.ready.is_empty() {
            return Option::Some(self.ready.remove(0));
        }
        let Some(event) = self.raw.poll() else {
            return null;
        };
        return Option::Some(self.take_reported(event));
    }

    pub fn len(&self) -> i32 {
        return self.members.len() + self.ready.len();
    }

    pub fn is_empty(&self) -> bool {
        return self.len() == 0;
    }

    fn take_reported(&mut self, reported: WaitEvent) -> Ready<W> {
        builtin::waitable_join(reported.handle, 0);
        // Found before the event is recorded, which settles the member.
        let at = self.member_at(reported.handle);
        match reported.event {
            Call(state) => {
                if state.is_resolved() {
                    DELIVERED.push(Resolution { handle: reported.handle, state });
                }
            },
            Copied(_) => SETTLED_COPIES.push(CopySettlement { handle: reported.handle, packed: reported.payload }),
            Unreported => unreachable(),
        }
        return Ready { member: self.members.remove(at), event: reported.event };
    }

    fn member_at(&self, handle: i32) -> i32 {
        let mut at = 0;
        for let member of self.members.iter_ref() {
            if member.wait_on() matches { Host(id) && id.handle == handle } {
                return at;
            }
            at += 1;
        }
        unreachable();
    }
}

impl<affine W: Waitable> Drop for WaitableSet<W> {
    /// Drops the members first, each leaving the host's set as it drops: the
    /// host traps on dropping a set that still has one.
    #[benign(RawWaitableSet)]
    fn drop(self) {
        builtin::drop(self.members);
        builtin::drop(self.ready);
        self.raw.drop();
    }
}

/// A raw CM subtask handle. `AsyncCall<T>` holds one, with its result buffer.
/// Dropping a subtask leaves the set it is joined to.
#[compiler_item("subtask")]
pub resource Subtask {
    /// Drop a completed subtask. Traps if the subtask has not yet resolved.
    #[cm("subtask-drop")]
    fn drop(self);

    /// Cancel this in-progress subtask, blocking until it resolves, and return
    /// the state it resolved in.
    #[cm("subtask-cancel")]
    fn cancel(&self) -> u32;
}

impl Waitable for Subtask {
    fn wait_on(&self) -> WaitOn {
        let id = ResourceId::of(self);
        if let Some(state) = delivered_state(id.handle) {
            return WaitOn::Settled(ReadyEvent::Call(state));
        }
        return WaitOn::Host(id);
    }
}

/// A handle to an in-flight CM async import call, parameterised by the
/// result type `T`. Returned by the synthesised adapter for a WIT
/// `async func` import.
///
/// `AsyncCall<T>` holds the CM subtask with the linear-memory buffer into
/// which the host writes the async result. `wait` blocks until the call
/// returns and takes the lifted result; `cancel` aborts the in-flight call.
/// Either one consumes the call, and dropping a call cancels it.
///
/// The subtask begins running the moment the adapter returns, so writes to
/// stream parameters (e.g. a request body) made after the adapter call and
/// before `wait` / `cancel` are rendezvoused with the host subtask.
///
/// Example (HTTP POST body):
/// ```wado
/// let [body_rx, body_tx] = Stream::<u8>::new();
/// let [req, _tx_future] = Request::new(headers, Option::Some(body_rx), ...);
/// let task = Client::send(req);       // host subtask starts
/// body_tx.write_all(body_bytes);      // rendezvous with host read
/// body_tx.drop();
/// let resp = task.wait();             // block for response
/// ```
///
/// The synthesized adapter builds one with a literal, which reaches the
/// private fields, so user code can neither peek nor forge one.
#[compiler_item("async_call")]
pub affine struct AsyncCall<affine T> {
    /// The subtask the call runs as, or None where it completed synchronously.
    subtask: Option<Subtask>,
    /// The buffer the result is lifted from, or None for a call returning
    /// nothing or one whose result was taken.
    buffer: Option<ResultBuffer>,
    /// Reads the CM-ABI bytes at the buffer and materializes them as `T`.
    lift: fn(i32) -> T,
}

impl<affine T> AsyncCall<T> {
    /// Wait for the subtask to complete and return the lifted result.
    pub fn wait(self) -> T with Subtask {
        let mut call = self;
        if let Some(subtask) = call.subtask.take() {
            let mut set = WaitableSet::<Subtask>::new();
            set.join(subtask);
            loop {
                let ready = set.wait();
                if ready.event matches { Call(state) && state.is_resolved() } {
                    drop_resolved(ready.member);
                    break;
                }
                set.join(ready.member);
            }
        }
        // The buffer drops, freed, once the lift has read it.
        return match call.buffer.take() {
            Some(buffer) => (call.lift)(buffer.ptr),
            None => (call.lift)(0),
        };
    }

    /// Cancel the in-flight subtask. A result it returned before the cancel
    /// is lifted and dropped, since it may own handles.
    pub fn cancel(self) with Subtask {
        builtin::drop(self);
    }
}

impl<affine T> Drop for AsyncCall<T> {
    /// Cancels a call nobody waited on, and drops a result the callee
    /// returned, which owns handles only a lift reaches.
    #[benign(Subtask)]
    fn drop(self) {
        let mut returned = true;
        if let Some(subtask) = self.subtask {
            let handle = builtin::resource_handle(&subtask);
            let state = if let Some(state) = delivered_state(handle) {
                state;
            } else {
                // `subtask.cancel` traps on a waitable still in a set. Joining
                // set 0 leaves whatever set it is in.
                builtin::waitable_join(handle, 0);
                call_state(subtask.cancel());
            };
            returned = state == CallState::Returned;
            drop_resolved(subtask);
        }
        if returned && let Some(buffer) = self.buffer {
            let _ = (self.lift)(buffer.ptr);
        }
    }
}

impl<affine T> Waitable for AsyncCall<T> {
    fn wait_on(&self) -> WaitOn {
        return match &self.subtask {
            Some(subtask) => subtask.wait_on(),
            None => WaitOn::Settled(ReadyEvent::Call(CallState::Returned)),
        };
    }
}

/// The linear memory an async call's result is lifted from, freed when it
/// drops.
#[compiler_item("result_buffer")]
internal affine struct ResultBuffer {
    internal ptr: i32,
    internal size: i32,
    internal align: i32,
}

impl Drop for ResultBuffer {
    fn drop(self) {
        let _ = builtin::realloc(self.ptr, self.size, self.align, 0);
    }
}

/// An error context carrying a debug message across component boundaries.
pub resource ErrorContext {
    /// Create a new error context with the given message.
    #[cm("error-context-new")]
    fn new(message: String) -> ErrorContext;

    /// Get the debug message from this error context.
    #[cm("error-context-debug-message")]
    fn debug_message(&self) -> String;

    /// Drop the error context.
    #[cm("error-context-drop")]
    fn drop(self);
}
