// Core variant types for the Wado Prelude.
//
// This module defines fundamental sum types that are used throughout Wado programs.
/// Optional value - either Some(T) or None
pub variant Option<T> {
    Some(T),
    None,
}

/// Result type - either Ok(T) or Err(E)
pub variant Result<T, E> {
    Ok(T),
    Err(E),
}
/// Future type - readable end of an async value (WASI Component Model primitive).
/// This is an opaque i32 handle managed by the runtime.
///
/// Use `Future::<T>::new()` to create a new future pair `[Future<T>, FutureWritable<T>]`.
/// The readable end (`Future<T>`) is passed to consumers; the writable end (`FutureWritable<T>`)
/// is used by the producer to fulfill the future.
pub resource Future<T> {
    fn new() -> [Future<T>, FutureWritable<T>];
}

/// FutureWritable type - writable end of an async value (WASI Component Model primitive).
/// This is an opaque i32 handle managed by the runtime.
///
/// Obtained from `Future::<T>::new()`. Call `write(value)` to fulfill the future,
/// or `drop()` to cancel it without fulfilling (maps to `future.drop-writable`).
pub resource FutureWritable<T> {
    /// Resolve the future with a value.
    /// Currently supports writing Result<Option<Trailers>, ErrorCode>::Ok(null) (HTTP trailers).
    fn write(&self, value: T);
    /// Drop the writable end without resolving the future (cancels the future).
    fn drop(&self);
}

/// Stream type - readable end of an async sequence (WASI Component Model primitive).
/// This is an opaque i32 handle managed by the runtime.
///
/// Use `Stream::<T>::new()` to create a new stream pair `[Stream<T>, i32]`
/// where the second element is the writable handle (tx).
pub resource Stream<T> {
    fn new() -> [Stream<T>, i32];
}
