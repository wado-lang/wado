#![no_prelude]
#![stdlib("core:prelude/types.wado")]
// Core variant types for the Wado Prelude.
//
// This module defines fundamental sum types that are used throughout Wado programs.

use { String } from "core:prelude/string.wado";
use { List } from "core:prelude/list.wado";
use { Slice } from "core:prelude/slice.wado";


/// Tuple type family declaration — establishes `core:prelude` as the owner of all tuple types.
#[compiler_item("tuple")]
internal type [..T];

/// Box wraps a value on the GC heap, enabling references to primitives.
#[compiler_item("box")]
internal struct Box<T> {
    pub value: T,
}

/// Optional value - either Some(T) or None
#[compiler_item("option")]
pub variant Option<T> {
    #[compiler_item("option_some")]
    Some(T),
    #[compiler_item("option_none")]
    None,
}

/// Result type - either Ok(T) or Err(E)
#[compiler_item("result")]
pub variant Result<T, E> {
    #[compiler_item("result_ok")]
    Ok(T),
    #[compiler_item("result_err")]
    Err(E),
}
impl<T: Eq> Eq for Option<T> {
    pub fn eq(&self, other: &Self) -> bool {
        return match *self {
            Some(a) => match *other {
                Some(b) => a == b,
                None => false,
            },
            None => match *other {
                Some(_) => false,
                None => true,
            },
        };
    }
}

impl<T: Eq, E: Eq> Eq for Result<T, E> {
    pub fn eq(&self, other: &Self) -> bool {
        return match *self {
            Ok(a) => match *other {
                Ok(b) => a == b,
                Err(_) => false,
            },
            Err(a) => match *other {
                Ok(_) => false,
                Err(b) => a == b,
            },
        };
    }
}

impl Option<T> {
    /// Returns the contained value, panicking if None.
    pub fn unwrap(self) -> T {
        if let Some(v) = self {
            return v;
        }
        panic("called Option::unwrap() on a None value");
    }

    /// Returns the contained value, panicking with `msg` if None.
    pub fn expect(self, msg: String) -> T {
        if let Some(v) = self {
            return v;
        }
        panic(msg);
    }
}

/// Cold slow path for `unwrap`/`expect` failures: traps with `${msg}: ${value:?}`.
#[inline(never)]
internal fn unwrap_failed<V>(msg: String, value: V) -> ! {
    panic(`${msg}: ${value:?}`);
}

impl Result<T, E> {
    /// Returns the contained Ok value, panicking (with the Err value) if Err.
    pub fn unwrap(self) -> T {
        return match self {
            Ok(v) => v,
            Err(e) => unwrap_failed("called Result::unwrap() on an Err value", e),
        };
    }

    /// Returns true if this is an Ok value.
    pub fn is_ok(&self) -> bool {
        if let Ok(_) = *self {
            return true;
        }
        return false;
    }

    /// Returns true if this is an Err value.
    pub fn is_err(&self) -> bool {
        if let Err(_) = *self {
            return true;
        }
        return false;
    }

    /// Returns the contained Ok value, panicking with `msg` (and the Err value) if Err.
    pub fn expect(self, msg: String) -> T {
        return match self {
            Ok(v) => v,
            Err(e) => unwrap_failed(msg, e),
        };
    }

    /// Returns the contained Err value, panicking (with the Ok value) if Ok.
    pub fn unwrap_err(self) -> E {
        return match self {
            Err(e) => e,
            Ok(v) => unwrap_failed("called Result::unwrap_err() on an Ok value", v),
        };
    }

    /// Returns the contained Err value, panicking with `msg` (and the Ok value) if Ok.
    pub fn expect_err(self, msg: String) -> E {
        return match self {
            Err(e) => e,
            Ok(v) => unwrap_failed(msg, v),
        };
    }
}

impl Default for Option<T> {
    pub fn default() -> Option<T> {
        return null;
    }
}

/// Readable end of an async value (WASI Component Model future).
/// Opaque i32 handle managed by the runtime.
///
/// Use `Future::<T>::new()` to create a `[Future<T>, FutureWritable<T>]` pair.
/// The readable end is passed to consumers; the writable end fulfills the future.
#[compiler_item("future")]
pub resource Future<T> {
    /// Create a new future pair: [Future<T>, FutureWritable<T>].
    #[cm("future-new")]
    fn new() -> [Future<T>, FutureWritable<T>];

    /// Read the value from the future.
    /// Returns Some(value) when fulfilled, None if the writer dropped without writing.
    #[cm("future-read")]
    fn read(&self) -> Option<T>;

    /// Cancel an in-progress read. Blocks until cancellation completes.
    #[cm("future-cancel-read")]
    fn cancel_read(&self);

    /// Drop the readable end of the future.
    #[cm("future-drop-readable")]
    fn drop(self);
}

/// Writable end of an async value (WASI Component Model future).
/// Opaque i32 handle managed by the runtime.
#[compiler_item("future_writable")]
pub resource FutureWritable<T> {
    /// Fulfill the future with a value.
    #[cm("future-write")]
    fn write(&self, value: T);

    /// Cancel an in-progress write. Blocks until cancellation completes.
    #[cm("future-cancel-write")]
    fn cancel_write(&self);

    /// Drop this writable end handle. Traps if no value has been written yet.
    #[cm("future-drop-writable")]
    fn drop(self);
}

/// How one Component Model copy ended (`CanonicalABI.md`, `CopyResult`).
///
/// It describes the copy that just happened, not the stream: `Completed` says
/// nothing about whether the peer is still there, and only `Dropped` ends the
/// stream.
#[compiler_item("copy_result")]
pub enum CopyResult {
    /// The copy finished.
    Completed,
    /// The peer end is gone; no further copy is possible on this end.
    Dropped,
    /// A cancel finished and returned the buffer; the end stays usable.
    Cancelled,
}

/// What one `Stream::read` copied, and how that copy ended.
///
/// A copy can carry elements and the peer's drop together, so `items` being
/// non-empty does not mean more will follow: read `result` to know.
#[compiler_item("stream_chunk")]
pub struct StreamChunk<T> {
    pub items: List<T>,
    pub result: CopyResult,
}

/// What one `StreamWritable::write` copied, and how that copy ended.
///
/// A reader may take a prefix, so `count` can be short of what was offered.
#[compiler_item("stream_write")]
pub struct StreamWrite {
    pub count: i32,
    pub result: CopyResult,
}

/// Readable end of an async sequence (WASI Component Model stream).
/// Opaque i32 handle managed by the runtime.
///
/// Use `Stream::<T>::new()` to create a `[Stream<T>, StreamWritable<T>]` pair.
#[compiler_item("stream")]
pub resource Stream<T> {
    /// Create a new stream pair: [Stream<T>, StreamWritable<T>].
    #[cm("stream-new")]
    fn new() -> [Stream<T>, StreamWritable<T>];

    /// Copy up to `max` elements out of the stream, blocking until at least one
    /// arrives or the writable end drops.
    ///
    /// One Component Model copy: it can return fewer elements than asked for,
    /// and a `Dropped` result can carry elements of its own. Reading an end
    /// whose result was `Dropped` traps, so a loop breaks on the result, not on
    /// an empty chunk. `read_to_end` is that loop.
    #[cm("stream-read")]
    fn read(&self, max: i32) -> StreamChunk<T>;

    /// Cancel an in-progress read. Blocks until cancellation completes.
    #[cm("stream-cancel-read")]
    fn cancel_read(&self);

    /// Drop the readable end of the stream.
    #[cm("stream-drop-readable")]
    fn drop(self);
}

impl Stream<T> {
    /// Read until the writable end drops, and return everything it wrote.
    pub fn read_to_end(&self) -> List<T> {
        let mut all: List<T> = [];
        loop {
            let chunk = self.read(STREAM_CHUNK_ELEMENTS);
            all.extend(&chunk.items);
            if chunk.result != CopyResult::Completed {
                return all;
            }
        }
    }
}

/// Elements per copy in the read/write loops the stdlib runs. A copy blocks
/// until the peer moves, so this bounds the buffer, not the throughput.
internal global STREAM_CHUNK_ELEMENTS: i32 = 4096;

/// Writable end of an async sequence (WASI Component Model stream).
/// Opaque i32 handle managed by the runtime.
#[compiler_item("stream_writable")]
pub resource StreamWritable<T> {
    /// Copy `data` into the stream, blocking until the reader takes at least
    /// one element or drops.
    ///
    /// One Component Model copy: the reader may take a prefix, so the returned
    /// count can be short of `data.len()`. Writing to an end whose result was
    /// `Dropped` traps. `write_all` is the loop that finishes the buffer.
    #[cm("stream-write")]
    fn write(&self, data: List<T>) -> StreamWrite;

    /// Write a byte view directly to the stream, without the deep copy that
    /// value-semantics `write` makes. The slice references its backing array
    /// (`list.as_slice()`, `array.slice(start, end)`, `string.as_bytes()`), so
    /// only the CM lowering copy remains.
    #[cm("stream-write-raw")]
    fn write_raw(&self, data: Slice<T>) -> StreamWrite;

    /// Cancel an in-progress write. Blocks until cancellation completes.
    #[cm("stream-cancel-write")]
    fn cancel_write(&self);

    /// Drop the writable end, signaling end-of-stream.
    #[cm("stream-drop-writable")]
    fn drop(self);
}

impl StreamWritable<T> {
    /// Write every element, or stop early when the readable end drops.
    /// Returns the result of the copy that ended the loop.
    pub fn write_all(&self, data: List<T>) -> CopyResult {
        let mut rest = data;
        loop {
            let written = self.write(rest);
            if written.result != CopyResult::Completed || written.count >= rest.len() {
                return written.result;
            }
            let mut remainder: List<T> = [];
            remainder.extend_from_slice(rest.as_slice().slice(written.count, rest.len()));
            rest = remainder;
        }
    }

    /// Write every element the slice views, or stop when the readable end
    /// drops. Keeps `write_all`'s value-semantics copy out of the paths that
    /// already hold their elements in one array.
    ///
    /// The tail view is built from the backing array rather than through
    /// `Slice::slice`, whose clamp these offsets cannot need — and which every
    /// program that prints would otherwise pay for.
    pub fn write_raw_all(&self, data: Slice<T>) -> CopyResult {
        let repr = data.internal_repr();
        let end = data.internal_start() + data.len();
        let mut offset = data.internal_start();
        loop {
            let written = self.write_raw(Slice::internal_new(repr, offset, end));
            offset += written.count;
            if written.result != CopyResult::Completed || offset >= end {
                return written.result;
            }
        }
    }
}

/// Opaque token identifying a waitable handle within a WaitableSet.
/// Obtained from `Subtask::join`. Compared by handle identity (`==`).
///
/// A newtype over the raw `i32` handle: copyable, with `Eq` inherited from
/// `i32`. It is an identity token with no lifecycle of its own — the joined
/// `Subtask` / `AsyncCall` owns the actual handle lifecycle.
pub type Waitable = i32;

/// Event returned by `WaitableSet::wait` or `WaitableSet::poll`.
pub struct WaitEvent {
    /// CM event code:
    ///   1 = subtask, 2 = stream-read, 3 = stream-write, 4 = future-read, 5 = future-write, 6 = cancelled
    pub code: i32,
    /// Which waitable handle triggered the event.
    pub handle: Waitable,
    /// Event-specific data (e.g. count|status for streams).
    pub payload: u32,
}

/// `WaitEvent::code` for a subtask transition (CM `EventCode.SUBTASK`).
internal global CM_EVENT_SUBTASK: i32 = 1;

/// The last in-flight state of the CM subtask state machine: `STARTING`
/// precedes it, and `RETURNED` and the two `CANCELLED_*` states sit above it.
/// Settling is a comparison against this, not an equality with `RETURNED`.
internal global CM_SUBTASK_STARTED: u32 = 1;

/// True once the subtask `event` names has resolved, which is what makes
/// `subtask.drop` legal — the CM traps a drop of one still in flight.
///
/// `waitable-set.wait` is lowered with `cancellable = 0`, so `TASK_CANCELLED`
/// cannot arrive; settling on it would drop a subtask still in flight.
internal fn cm_subtask_settled(event: WaitEvent) -> bool {
    assert event.code == CM_EVENT_SUBTASK;
    return event.payload > CM_SUBTASK_STARTED;
}

/// A set of waitable handles used for async task coordination.
///
/// Lifecycle: create with `new()`, join waitables into the set, wait/poll for
/// events, then drop. A WaitableSet can only be dropped when it has no joined
/// children — `Subtask::drop()` automatically removes the subtask from its
/// joined set (via the CM spec's `Waitable.join(None)` semantics), so always
/// drop subtasks before dropping the set.
pub resource WaitableSet {
    /// Create a new waitable set.
    #[cm("waitable-set-new")]
    fn new() -> WaitableSet;

    /// Block until an event occurs. Returns the event details.
    #[cm("waitable-set-wait")]
    fn wait(&self) -> WaitEvent;

    /// Non-blocking poll. Returns Some(event) if ready, None otherwise.
    #[cm("waitable-set-poll")]
    fn poll(&self) -> Option<WaitEvent>;

    /// Drop the waitable set. Traps if waitables are still joined to this set.
    #[cm("waitable-set-drop")]
    fn drop(self);
}

/// A raw CM subtask handle. Prefer `AsyncCall<T>` (see below), which pairs the
/// handle with its result buffer.
///
/// `Subtask` extends `Waitable` in the CM spec. When dropped, it
/// automatically removes itself from any joined `WaitableSet` (the CM
/// runtime calls `Waitable.join(None)` internally), so `WaitableSet::drop`
/// can succeed.
///
/// Correct lifecycle:
///   let subtask = handle as Subtask;
///   subtask.join(&ws);
///   ws.wait();
///   subtask.drop();  // removes from ws
///   ws.drop();       // safe — no children
pub resource Subtask {
    /// Drop a completed subtask. Automatically unjoins from its WaitableSet.
    /// Traps if the subtask has not yet resolved.
    #[cm("subtask-drop")]
    fn drop(self);

    /// Cancel this in-progress subtask. Blocks until cancellation completes.
    #[cm("subtask-cancel")]
    fn cancel(&self);

    /// Join this subtask to a waitable set for monitoring.
    /// Returns a Waitable token identifying this subtask in wait results.
    #[cm("waitable-join")]
    fn join(&self, set: &WaitableSet) -> Waitable;
}

/// A handle to an in-flight CM async import call, parameterised by the
/// result type `T`. Returned by the synthesised adapter for a WIT
/// `async func` import.
///
/// `AsyncCall<T>` pairs the raw CM subtask handle with the linear-memory
/// buffer into which the host writes the async result. Use `wait(self)` to
/// block until the call returns and take the lifted result; use
/// `cancel(self)` to abort the in-flight call.
///
/// The subtask begins running the moment the adapter returns, so writes to
/// stream parameters (e.g. a request body) made after the adapter call and
/// before `wait` / `cancel` are rendezvoused with the host subtask.
///
/// Example (HTTP POST body):
/// ```wado
/// let [body_rx, body_tx] = Stream::<u8>::new();
/// let [req, _tx_future] = Request::new(headers, Option::Some(body_rx), ...);
/// let task = Client::send(req);       // host subtask starts
/// body_tx.write(body_bytes);          // rendezvous with host read
/// body_tx.drop();
/// let resp = task.wait();             // block for response
/// ```
#[compiler_item("async_call")]
pub struct AsyncCall<T> {
    // CM-ABI plumbing populated by the synthesised `__cm_binding__*`
    // adapter via a TIR-level `StructLiteral` (which bypasses field
    // visibility); kept non-`pub` so user code cannot peek or forge.
    /// Raw CM subtask handle packed as `(subtask_handle << 4) | status`.
    __cm_packed: i32,
    /// Pointer to the linear-memory buffer holding the async result.
    __cm_outptr: i32,
    /// Size of the result buffer (for realloc-based free).
    __cm_size: i32,
    /// Alignment of the result buffer (for realloc-based free).
    __cm_align: i32,
    /// Per-import lift function — reads CM-ABI bytes at `__cm_outptr`
    /// and materialises them as `T`.
    __cm_lift: fn(i32) -> T,
}

impl AsyncCall<T> {
    /// Wait for the subtask to complete and return the lifted result.
    /// Drops the CM subtask handle and frees the result buffer before
    /// returning. After `wait` returns, the `AsyncCall<T>` value must not be
    /// used again — doing so is a use-after-free (the backing buffer has
    /// been released).
    pub fn wait(&self) -> T {
        let handle = self.__cm_packed >> 4;
        if handle != 0 {
            let raw = handle as Subtask;
            let ws = WaitableSet::new();
            raw.join(&ws);
            loop {
                let event = ws.wait();
                if cm_subtask_settled(event) {
                    break;
                }
            }
            raw.drop();
            ws.drop();
        }
        let result = (self.__cm_lift)(self.__cm_outptr);
        let _ = builtin::realloc(self.__cm_outptr, self.__cm_size, self.__cm_align, 0);
        return result;
    }

    /// Cancel the in-flight subtask and free the result buffer. Any
    /// partially-written result is discarded. Same single-use contract as
    /// `wait` — the `AsyncCall<T>` must not be used again after `cancel`.
    pub fn cancel(&self) {
        let handle = self.__cm_packed >> 4;
        if handle != 0 {
            let raw = handle as Subtask;
            raw.cancel();
            raw.drop();
        }
        let _ = builtin::realloc(self.__cm_outptr, self.__cm_size, self.__cm_align, 0);
    }

    /// Join this subtask to a waitable set for manual polling (use when
    /// the caller wants to wait on multiple subtasks and/or streams
    /// simultaneously). Returns a `Waitable` token identifying this
    /// subtask in wait events. The caller remains responsible for eventual
    /// `wait`/`cancel` on this `AsyncCall<T>`.
    pub fn join(&self, set: &WaitableSet) -> Waitable {
        let handle = self.__cm_packed >> 4;
        let raw = handle as Subtask;
        return raw.join(set);
    }
}

/// An error context carrying a debug message across component boundaries.
pub resource ErrorContext {
    /// Create a new error context with the given message.
    #[cm("error-context-new")]
    fn new(message: String) -> ErrorContext;

    /// Get the debug message from this error context.
    #[cm("error-context-debug-message")]
    fn debug_message(&self) -> String;

    /// Drop the error context.
    #[cm("error-context-drop")]
    fn drop(self);
}

/// Backpressure control for the current component instance.
///
/// Signals to the host that this component is under load.
/// Increment to enable backpressure; decrement to release it.
/// The host will stop dispatching new calls when the counter is non-zero.
internal resource Backpressure {
    /// Increment the backpressure counter by 1.
    /// The host applies backpressure when the counter is non-zero.
    #[cm("backpressure-inc")]
    fn inc();

    /// Decrement the backpressure counter by 1.
    #[cm("backpressure-dec")]
    fn dec();
}

/// Task-local context storage for the current async task.
///
/// Provides typed slots (u32) for passing context values across component
/// boundaries without threading them through call arguments.
/// The slot index must be a compile-time constant.
internal resource Context {
    /// Get the value of task-local context slot `slot`.
    /// `slot` must be a compile-time constant.
    #[cm("context-get")]
    fn get(slot: u32) -> u32;

    /// Set the value of task-local context slot `slot` to `value`.
    /// `slot` must be a compile-time constant.
    #[cm("context-set")]
    fn set(slot: u32, value: u32);
}

/// The current async task handle.
///
/// Provides operations that apply to the currently executing async task.
pub resource Task {
    /// Acknowledge cancellation of the current task.
    ///
    /// Call this in response to a cancellation signal (e.g. after receiving
    /// `WaitEvent { code: 6 }` from `WaitableSet::wait`). Signals to the CM
    /// runtime that the task accepts being cancelled and will clean up.
    #[cm("task-cancel")]
    fn cancel();
}
