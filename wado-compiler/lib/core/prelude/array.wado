#![no_prelude]
#![stdlib("core:prelude/array.wado")]
// The fixed-length GC array behind `String` and `List<T>`, and a value type in
// its own right: assignment deep-copies it, and its length is a runtime value
// (`array.len`), not part of the type. See WEP-2026-06-02.

use {
    Ordering,
    Default,
    Eq,
    Ord,
    Ref,
    RefMut,
    IndexValue,
    IndexAssign,
    IndexRef,
    IndexRefMut,
    IntoIterator,
    Display,
    DisplayAlt,
    Inspect,
    InspectAlt,
} from "core:prelude/traits.wado";
use {
    AsSlice,
    Sequence,
    Slice,
    SliceValueIter,
    SliceRefIter,
    SliceRefMutIter,
    SliceWindows,
    SliceChunks,
} from "core:prelude/slice.wado";
use { RangeExclusive, RangeInclusive } from "core:prelude/range.wado";
use { Formatter } from "core:prelude/format.wado";
use { i32_clamp, i32_min } from "core:rt";

/// Fixed-length GC array — the builtin storage primitive. Declared
/// definition-less; its storage and instructions live in the compiler.
#[compiler_item("array")]
internal type Array<T>;

impl Array<T> {
    /// Creates a new array of `len` elements, each initialised to the
    /// default value of `T` (`array.new_default`).
    pub fn new(len: i32) -> Array<T> {
        return builtin::array_new(len);
    }

    /// Creates a new array of `len` elements, each set to `value`.
    pub fn filled(len: i32, value: T) -> Array<T> {
        let mut a: Array<T> = builtin::array_new(len);
        builtin::array_fill(&mut a, 0, value, len);
        return a;
    }

    /// Returns the number of elements (`array.len`).
    pub fn len(&self) -> i32 {
        return builtin::array_len(self);
    }

    /// Sets the element at `index` to `value` (`array.set`).
    /// Traps if `index` is out of bounds.
    pub fn set(&mut self, index: i32, value: T) with stores[value] {
        builtin::array_set(self, index, value);
    }

    /// Sets every element to `value` (`array.fill`).
    pub fn fill(&mut self, value: T) with stores[value] {
        builtin::array_fill(self, 0, value, builtin::array_len(self));
    }

    /// Copies `len` elements of `src` starting at `src_off` into self
    /// starting at `dst` (`array.copy`).
    pub fn copy_from(&mut self, dst: i32, src: &Array<T>, src_off: i32, len: i32) {
        builtin::array_copy(self, dst, src, src_off, len);
    }

    /// Yields `&mut T` only where `T: RefMut`: a scalar element has no
    /// addressable cell, so a write through the reference would be lost.
    pub fn iter_ref_mut(&mut self) -> SliceRefMutIter<T> with stores[self] {
        return SliceRefMutIter::internal_new(self, 0, builtin::array_len(self));
    }
}

impl Default for Array<T> {
    pub fn default() -> Array<T> {
        return builtin::array_new(0);
    }
}

// No `From<Array<T>>` here: a `[e0, e1, …]` literal already denotes an
// `Array<T>` of exactly its length (WEP 2026-08-24).

impl<T> Sequence for Array<T> {
    type Elem = T;

    fn len(&self) -> i32 {
        return builtin::array_len(self);
    }

    fn get_unchecked(&self, index: i32) -> T {
        return builtin::array_get_value(self, index);
    }
}

impl<T> AsSlice for Array<T> {
    fn as_slice(&self) -> Slice<T> with stores[self] {
        return Slice::internal_new(self, 0, builtin::array_len(self));
    }
}

impl<T: Eq> Array<T> {
    pub fn contains(&self, value: &T) -> bool {
        return self.as_slice().contains(value);
    }
}

impl<T> IntoIterator for Array<T> {
    type Item = T;
    type Iter = SliceValueIter<T>;

    fn into_iter(&self) -> Self::Iter with stores[self] {
        return SliceValueIter::internal_new(self, 0, builtin::array_len(self));
    }
}

impl<T> IntoIterator for &Array<T> {
    type Item = &T;
    type Iter = SliceRefIter<T>;

    fn into_iter(&self) -> Self::Iter {
        let arr = *self;
        return SliceRefIter::internal_new(arr, 0, builtin::array_len(arr));
    }
}

impl IndexValue<i32> for Array<T> {
    type Output = T;

    fn index_value(&self, index: i32) -> Self::Output {
        return builtin::array_get_value(self, index);
    }
}

impl IndexAssign<i32> for Array<T> {
    type Output = T;

    fn index_assign(&mut self, index: i32, value: Self::Output) with stores[value] {
        builtin::array_set(self, index, value);
    }
}

impl<T: Ref> IndexRef<i32> for Array<T> {
    type Output = T;

    fn index_ref(&self, index: i32) -> &T {
        return builtin::array_get_ref(self, index);
    }
}

impl<T: RefMut> IndexRefMut<i32> for Array<T> {
    type Output = T;

    fn index_ref_mut(&mut self, index: i32) -> &mut T {
        return builtin::array_get_ref_mut(self, index);
    }
}

impl IndexValue<RangeExclusive<i32>> for Array<T> {
    type Output = Slice<T>;

    fn index_value(&self, range: RangeExclusive<i32>) -> Slice<T> with stores[self] {
        return self.slice(range.start, range.end);
    }
}

impl IndexValue<RangeInclusive<i32>> for Array<T> {
    type Output = Slice<T>;

    fn index_value(&self, range: RangeInclusive<i32>) -> Slice<T> with stores[self] {
        return self.slice(range.start, range.end + 1);
    }
}

impl<T: Eq> Eq for Array<T> {
    pub fn eq(&self, other: &Self) -> bool {
        let len = builtin::array_len(self);
        if len != builtin::array_len(other) {
            return false;
        }
        for let mut i = 0; i < len; i += 1 {
            if builtin::array_get_value(self, i) != builtin::array_get_value(other, i) {
                return false;
            }
        }
        return true;
    }
}

impl<T: Ord> Ord for Array<T> {
    pub fn cmp(&self, other: &Self) -> Ordering {
        let len = builtin::array_len(self);
        let other_len = builtin::array_len(other);
        let min_len = i32_min(len, other_len);
        for let mut i = 0; i < min_len; i += 1 {
            let a = builtin::array_get_value(self, i);
            let b = builtin::array_get_value(other, i);
            if a < b {
                return Ordering::Less;
            }
            if a > b {
                return Ordering::Greater;
            }
        }
        if len < other_len {
            return Ordering::Less;
        }
        if len > other_len {
            return Ordering::Greater;
        }
        return Ordering::Equal;
    }
}

// Shared `[a, b, …]` Inspect/Display rendering for the GC-array-backed
// sequences (`Array<T>` itself; `List<T>` over its used prefix). `limit` is the
// resolved element cap (negative = none); `marker` appends `, ...` when
// elements are dropped.
internal fn write_seq_inspect<T: Inspect>(
    repr: &Array<T>,
    start: i32,
    end: i32,
    f: &mut Formatter,
    marker: bool,
    limit: i32,
) {
    f.write_char('[');
    let mut shown = 0;
    let mut truncated = false;
    for let mut i = start; i < end; i += 1 {
        if limit >= 0 && shown >= limit {
            truncated = true;
            break;
        }
        if shown > 0 {
            f.write_str(&", ");
        }
        repr[i].inspect(f);
        shown += 1;
    }
    if marker && truncated {
        if shown > 0 {
            f.write_str(&", ...");
        } else {
            f.write_str(&"...");
        }
    }
    f.write_char(']');
}

/// Pretty-printed counterpart of [`write_seq_inspect`]: each element on its own
/// indented line; `marker` appends a `...` line when elements are dropped.
internal fn write_seq_inspect_alt<T: InspectAlt>(
    repr: &Array<T>,
    start: i32,
    end: i32,
    f: &mut Formatter,
    marker: bool,
    limit: i32,
) {
    if start >= end {
        f.write_str(&"[]");
        return;
    }
    f.open_brace("[");
    let mut shown = 0;
    let mut truncated = false;
    for let mut i = start; i < end; i += 1 {
        if limit >= 0 && shown >= limit {
            truncated = true;
            break;
        }
        f.write_newline_indent();
        repr[i].inspect_alt(f);
        f.write_char(',');
        shown += 1;
    }
    if marker && truncated {
        f.write_newline_indent();
        f.write_str(&"...");
    }
    f.close_brace("]");
}

impl<T: Inspect> Inspect for Array<T> {
    pub fn inspect(&self, f: &mut Formatter) {
        write_seq_inspect(self, 0, builtin::array_len(self), f, true, f.resolved_seq_limit());
    }
}

impl<T: Inspect> Display for Array<T> {
    pub fn fmt(&self, f: &mut Formatter) {
        // Display never applies the default cap; raw precision caps only if >= 0.
        write_seq_inspect(self, 0, builtin::array_len(self), f, false, f.precision);
    }
}

impl<T: InspectAlt> InspectAlt for Array<T> {
    pub fn inspect_alt(&self, f: &mut Formatter) {
        write_seq_inspect_alt(self, 0, builtin::array_len(self), f, true, f.resolved_seq_limit());
    }
}

impl<T: InspectAlt> DisplayAlt for Array<T> {
    pub fn fmt_alt(&self, f: &mut Formatter) {
        // DisplayAlt never applies the default sequence cap (see Display).
        write_seq_inspect_alt(self, 0, builtin::array_len(self), f, false, f.precision);
    }
}
