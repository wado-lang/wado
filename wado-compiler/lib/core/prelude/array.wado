#![no_prelude]
// Array type and iterators for Wado.
// Provides Array<T>, ArrayIter<T>, and iterator combinators.


use { Ordering, Eq, Ord, IndexValue, IndexAssign, Iterator, IntoIterator, FromIterator } from "core:prelude/traits.wado";
use { Option } from "core:prelude/types.wado";
use { panic } from "core:internal";

fn i32_min(a: i32, b: i32) -> i32 {
    return builtin::select::<i32>(a < b, a, b);
}
fn i32_max(a: i32, b: i32) -> i32 {
    return builtin::select::<i32>(a > b, a, b);
}

pub struct Array<T> {
    repr: builtin::array<T>,
    used: i32,
}

impl Array<T> {
    pub fn with_capacity(capacity: i32) -> Array<T> {
        return Array {
            repr: builtin::array_new::<T>(capacity),
            used: 0,
        };
    }

    pub fn filled(n: i32, element: T) -> Array<T> {
        let repr = builtin::array_new::<T>(n);
        builtin::array_fill::<T>(repr, 0, element, n);
        return Array { repr, used: n };
    }

    #[inline]
    pub fn len(&self) -> i32 {
        return self.used;
    }

    #[inline]
    pub fn is_empty(&self) -> bool {
        return self.used == 0;
    }

    pub fn internal_raw_data(&self) -> builtin::array<T> {
        return self.repr;
    }

    #[inline(always)]
    pub fn internal_get_unchecked(&self, index: i32) -> T {
        return builtin::array_get::<T>(self.repr, index);
    }

    #[inline(always)]
    pub fn internal_ensure_capacity(&mut self, min_capacity: i32) {
        let capacity = builtin::array_len(self.repr);
        if min_capacity > capacity {
            let new_capacity = i32_max(capacity * 2, min_capacity);
            let new_repr = builtin::array_new::<T>(new_capacity);
            builtin::array_copy::<T>(new_repr, 0, self.repr, 0, self.used);
            self.repr = new_repr;
        }
    }

    #[inline(always)]
    pub fn internal_append_unchecked(&mut self, value: T) {
        builtin::array_set::<T>(self.repr, self.used, value);
        self.used += 1;
    }

    pub fn internal_extend_from_self(&mut self, src_start: i32, count: i32) {
        if count <= 0 {
            return;
        }
        self.internal_ensure_capacity(self.used + count);
        let dist = self.used - src_start;
        if dist >= count {
            builtin::array_copy::<T>(self.repr, self.used, self.repr, src_start, count);
            self.used += count;
        } else {
            for let mut i = 0; i < count; i += 1 {
                builtin::array_set::<T>(self.repr, self.used, builtin::array_get::<T>(self.repr, src_start + i));
                self.used += 1;
            }
        }
    }

    pub fn internal_extend_from(&mut self, src: &Array<T>, src_start: i32, count: i32) {
        if count <= 0 {
            return;
        }
        self.internal_ensure_capacity(self.used + count);
        builtin::array_copy::<T>(self.repr, self.used, src.repr, src_start, count);
        self.used += count;
    }

    #[comp_feature("array_append")]
    #[inline]
    pub fn append(&mut self, value: T) {
        let used = self.used;
        let capacity = builtin::array_len(self.repr);
        if builtin::unlikely(used >= capacity) {
            let new_capacity = i32_max(capacity * 2, 4);
            let new_repr = builtin::array_new::<T>(new_capacity);
            builtin::array_copy::<T>(new_repr, 0, self.repr, 0, used);
            self.repr = new_repr;
        }
        builtin::array_set::<T>(self.repr, used, value);
        self.used = used + 1;
    }

    pub fn get(&self, index: i32) -> Option<T> {
        if index < 0 || index >= self.used {
            return null;
        }
        return Option::Some(builtin::array_get::<T>(self.repr, index));
    }
}

impl IndexValue<i32> for Array<T> {
    type Output = T;

    #[inline]
    fn index_value(&self, index: i32) -> Self::Output {
        if index >= self.used {
            panic("index out of bounds");
        }
        return builtin::array_get::<T>(self.repr, index);
    }
}

impl IndexAssign<i32> for Array<T> {
    type Input = T;

    #[inline]
    fn index_assign(&mut self, index: i32, value: Self::Input) {
        if index >= self.used {
            panic("index out of bounds");
        }
        builtin::array_set::<T>(self.repr, index, value);
    }
}

impl<T: Eq> Eq for Array<T> {
    pub fn eq(&self, other: &Self) -> bool {
        if self.used != other.used {
            return false;
        }
        for let mut i = 0; i < self.used; i += 1 {
            if builtin::array_get::<T>(self.repr, i) != builtin::array_get::<T>(other.repr, i) {
                return false;
            }
        }
        return true;
    }
}

impl<T: Ord> Ord for Array<T> {
    pub fn cmp(&self, other: &Self) -> Ordering {
        let min_len = i32_min(self.used, other.used);
        for let mut i = 0; i < min_len; i += 1 {
            let a = builtin::array_get::<T>(self.repr, i);
            let b = builtin::array_get::<T>(other.repr, i);
            if a < b {
                return Ordering::Less;
            }
            if a > b {
                return Ordering::Greater;
            }
        }
        if self.used < other.used {
            return Ordering::Less;
        }
        if self.used > other.used {
            return Ordering::Greater;
        }
        return Ordering::Equal;
    }
}
pub struct ArraySlice<T> {
    repr: builtin::array<T>,
    start: i32,
    end: i32,
}

impl ArraySlice<T> {
    pub fn len(&self) -> i32 {
        return self.end - self.start;
    }

    pub fn is_empty(&self) -> bool {
        return self.start >= self.end;
    }

    pub fn get(&self, index: i32) -> Option<T> {
        if index < 0 || index >= self.end - self.start {
            return null;
        }
        return Option::Some(builtin::array_get::<T>(self.repr, self.start + index));
    }

    pub fn slice(&self, start: i32, end: i32) -> ArraySlice<T> {
        let abs_start = self.start + i32_max(start, 0);
        let abs_end = self.start + i32_min(end, self.end - self.start);
        return ArraySlice {
            repr: self.repr,
            start: i32_min(abs_start, self.end),
            end: i32_max(abs_start, i32_min(abs_end, self.end)),
        };
    }

    pub fn to_array(&self) -> Array<T> {
        let len = self.end - self.start;
        if len <= 0 {
            return Array::<T>::with_capacity(0);
        }
        let new_repr = builtin::array_new::<T>(len);
        builtin::array_copy::<T>(new_repr, 0, self.repr, self.start, len);
        return Array { repr: new_repr, used: len };
    }

    pub fn iter(&self) -> ArrayIter<T> {
        return ArrayIter {
            repr: self.repr,
            used: self.end,
            index: self.start,
        };
    }
}

impl IndexValue<i32> for ArraySlice<T> {
    type Output = T;

    fn index_value(&self, index: i32) -> Self::Output {
        if index < 0 || index >= self.end - self.start {
            panic("index out of bounds");
        }
        return builtin::array_get::<T>(self.repr, self.start + index);
    }
}

impl IntoIterator for ArraySlice<T> {
    type Item = T;
    type Iter = ArrayIter<T>;

    fn into_iter(&self) -> Self::Iter {
        return self.iter();
    }
}

impl Array<T> {
    pub fn slice(&self, start: i32, end: i32) -> ArraySlice<T> {
        let s = i32_max(start, 0);
        let e = i32_min(end, self.used);
        return ArraySlice {
            repr: self.repr,
            start: i32_min(s, self.used),
            end: i32_max(s, e),
        };
    }
}

pub struct ArrayIter<T> {
    repr: builtin::array<T>,
    used: i32,
    index: i32,
}

impl Iterator for ArrayIter<T> {
    type Item = T;

    fn next(&mut self) -> Option<Self::Item> {
        if self.index >= self.used {
            return null;
        }
        let item = builtin::array_get::<T>(self.repr, self.index);
        self.index += 1;
        return Option::Some(item);
    }
}

impl IntoIterator for Array<T> {
    type Item = T;
    type Iter = ArrayIter<T>;

    fn into_iter(&self) -> Self::Iter {
        return ArrayIter {
            repr: self.repr,
            used: self.used,
            index: 0,
        };
    }
}
impl Array<T> {
    pub fn iter(&self) -> ArrayIter<T> {
        return self.into_iter();
    }

    /// In-place sort with comparator. Stable, O(n log n) worst case.
    pub fn sort_by(&mut self, cmp: fn(&T, &T) -> Ordering) {
        let n = self.used;
        if n <= 1 {
            return;
        }
        let src = self.repr;
        let buf = builtin::array_new::<T>(n);
        let mut width = 1;
        for ; width < n; width = width * 2 {
            for let mut start = 0; start < n; start += width * 2 {
                let mid = start + width;
                if mid < n {
                    let end = i32_min(start + width * 2, n);
                    let mut i = start;
                    let mut j = mid;
                    for let mut k = start; k < end; k += 1 {
                        if i < mid {
                            if j < end {
                                let a = builtin::array_get::<T>(src, i);
                                let b = builtin::array_get::<T>(src, j);
                                if let Greater = cmp(&a, &b) {
                                    builtin::array_set::<T>(buf, k, b);
                                    j += 1;
                                } else {
                                    builtin::array_set::<T>(buf, k, a);
                                    i += 1;
                                }
                            } else {
                                builtin::array_set::<T>(buf, k, builtin::array_get::<T>(src, i));
                                i += 1;
                            }
                        } else {
                            builtin::array_set::<T>(buf, k, builtin::array_get::<T>(src, j));
                            j += 1;
                        }
                    }
                    builtin::array_copy::<T>(src, start, buf, start, end - start);
                }
            }
        }
    }

    pub fn sorted_by(&self, cmp: fn(&T, &T) -> Ordering) -> Array<T> {
        let n = self.used;
        let new_repr = builtin::array_new::<T>(n);
        builtin::array_copy::<T>(new_repr, 0, self.repr, 0, n);
        let mut copy = Array { repr: new_repr, used: n };
        copy.sort_by(cmp);
        return copy;
    }
}

// sort/sorted require T: Ord (elements must be comparable via Ord::cmp)
impl Array<T: Ord> {
    pub fn sort(&mut self) {
        self.sort_by(|a: &T, b: &T| {
            return a.cmp(b);
        });
    }

    pub fn sorted(&self) -> Array<T> {
        let n = self.used;
        let new_repr = builtin::array_new::<T>(n);
        builtin::array_copy::<T>(new_repr, 0, self.repr, 0, n);
        let mut copy = Array { repr: new_repr, used: n };
        copy.sort();
        return copy;
    }
}

impl FromIterator<T> for Array<T> {
    type Iter = ArrayIter<T>;

    fn from_iter(iter: ArrayIter<T>) -> Array<T> {
        let mut result: Array<T> = [];
        for let item of iter {
            result.append(item);
        }
        return result;
    }
}

// SequenceLiteralBuilder for [e0, e1, ...] -> Array<T>
// The blanket impl in core:prelude automatically provides SequenceLiteral for Array<T>.
impl SequenceLiteralBuilder for Array<T> {
    type Element = T;
    type Output = Array<T>;

    fn new_literal(capacity: i32) -> Array<T> {
        return Array::<T>::with_capacity(capacity);
    }

    fn push_literal(&mut self, value: T) {
        self.append(value);
    }

    fn build(&self) -> Array<T> {
        return *self;
    }
}

impl ArrayIter<T> {
    pub fn collect(&mut self) -> Array<T> {
        let remaining = self.used - self.index;
        let mut repr = builtin::array_new::<T>(remaining);
        let mut result_used = 0;
        for let mut i = self.index; i < self.used; i += 1 {
            let item = builtin::array_get::<T>(self.repr, i);
            builtin::array_set::<T>(repr, result_used, item);
            result_used += 1;
        }
        self.index = self.used;
        return Array { repr, used: result_used };
    }

    pub fn fold<Acc>(&mut self, init: Acc, f: fn(Acc, T) -> Acc) -> Acc {
        let mut acc = init;
        for let item of *self {
            acc = f(acc, item);
        }
        return acc;
    }

    pub fn enumerate(&self) -> EnumerateIter<T> {
        return EnumerateIter {
            repr: self.repr,
            used: self.used,
            index: self.index,
            count: 0,
        };
    }

    pub fn map<U>(&self, f: fn(T) -> U) -> MapIter<T, U> {
        return MapIter {
            repr: self.repr,
            used: self.used,
            index: self.index,
            f,
        };
    }

    pub fn filter(&self, pred: fn(T) -> bool) -> FilterIter<T> {
        return FilterIter {
            repr: self.repr,
            used: self.used,
            index: self.index,
            pred,
        };
    }

    pub fn find(&mut self, pred: fn(T) -> bool) -> Option<T> {
        for let item of *self {
            if pred(item) {
                return Option::Some(item);
            }
        }
        return null;
    }

    pub fn any(&mut self, pred: fn(T) -> bool) -> bool {
        for let item of *self {
            if pred(item) {
                return true;
            }
        }
        return false;
    }

    pub fn all(&mut self, pred: fn(T) -> bool) -> bool {
        for let item of *self {
            if !pred(item) {
                return false;
            }
        }
        return true;
    }

    pub fn last(&mut self) -> Option<T> {
        let mut result: Option<T> = null;
        for let item of *self {
            result = Option::Some(item);
        }
        return result;
    }

    pub fn nth(&mut self, n: i32) -> Option<T> {
        let mut remaining = n;
        for let item of *self {
            if remaining <= 0 {
                return Option::Some(item);
            }
            remaining -= 1;
        }
        return null;
    }

    pub fn position(&mut self, pred: fn(T) -> bool) -> Option<i32> {
        let mut idx = 0;
        for let item of *self {
            if pred(item) {
                return Option::Some(idx);
            }
            idx += 1;
        }
        return null;
    }

    pub fn reduce(&mut self, f: fn(T, T) -> T) -> Option<T> {
        if let Some(first) = self.next() {
            let mut acc = first;
            for let item of *self {
                acc = f(acc, item);
            }
            return Option::Some(acc);
        } else {
            return null;
        }
    }

    pub fn take(&self, n: i32) -> TakeIter<T> {
        return TakeIter {
            repr: self.repr,
            used: self.used,
            index: self.index,
            remaining: n,
        };
    }

    pub fn skip(&self, n: i32) -> ArrayIter<T> {
        let new_index = i32_min(self.index + i32_max(n, 0), self.used);
        return ArrayIter {
            repr: self.repr,
            used: self.used,
            index: new_index,
        };
    }

    pub fn chain(&self, other: ArrayIter<T>) -> ChainIter<T> {
        return ChainIter {
            repr1: self.repr,
            used1: self.used,
            index1: self.index,
            repr2: other.repr,
            used2: other.used,
            index2: other.index,
        };
    }

    pub fn zip<U>(&self, other: ArrayIter<U>) -> ZipIter<T, U> {
        return ZipIter {
            repr1: self.repr,
            used1: self.used,
            index1: self.index,
            repr2: other.repr,
            used2: other.used,
            index2: other.index,
        };
    }
}
pub struct EnumerateIter<T> {
    repr: builtin::array<T>,
    used: i32,
    index: i32,
    count: i32,
}

impl Iterator for EnumerateIter<T> {
    type Item = [i32, T];

    fn next(&mut self) -> Option<Self::Item> {
        if self.index >= self.used {
            return null;
        }
        let item = builtin::array_get::<T>(self.repr, self.index);
        let idx = self.count;
        self.index += 1;
        self.count += 1;
        return Option::Some([idx, item]);
    }
}

// EnumerateIter uses Iterator::collect() default method
pub struct MapIter<T, U> {
    repr: builtin::array<T>,
    used: i32,
    index: i32,
    f: fn(T) -> U,
}

impl Iterator for MapIter<T, U> {
    type Item = U;

    fn next(&mut self) -> Option<Self::Item> {
        if self.index >= self.used {
            return null;
        }
        let item = builtin::array_get::<T>(self.repr, self.index);
        self.index += 1;
        return Option::Some((self.f)(item));
    }
}

impl MapIter<T, U> {
    // collect() uses Iterator::collect() default method
    pub fn fold<Acc>(&mut self, init: Acc, f: fn(Acc, U) -> Acc) -> Acc {
        let mut acc = init;
        for let item of *self {
            acc = f(acc, item);
        }
        return acc;
    }
}
pub struct FilterIter<T> {
    repr: builtin::array<T>,
    used: i32,
    index: i32,
    pred: fn(T) -> bool,
}

impl Iterator for FilterIter<T> {
    type Item = T;

    fn next(&mut self) -> Option<Self::Item> {
        loop {
            if self.index >= self.used {
                return null;
            }
            let item = builtin::array_get::<T>(self.repr, self.index);
            self.index += 1;
            if (self.pred)(item) {
                return Option::Some(item);
            }
        }
    }
}

impl FilterIter<T> {
    // collect() uses Iterator::collect() default method
    pub fn fold<Acc>(&mut self, init: Acc, f: fn(Acc, T) -> Acc) -> Acc {
        let mut acc = init;
        for let item of *self {
            acc = f(acc, item);
        }
        return acc;
    }

    pub fn map<U>(&self, f: fn(T) -> U) -> FilterMapIter<T, U> {
        return FilterMapIter {
            repr: self.repr,
            used: self.used,
            index: self.index,
            pred: self.pred,
            f,
        };
    }
}

pub struct FilterMapIter<T, U> {
    repr: builtin::array<T>,
    used: i32,
    index: i32,
    pred: fn(T) -> bool,
    f: fn(T) -> U,
}

impl Iterator for FilterMapIter<T, U> {
    type Item = U;

    fn next(&mut self) -> Option<Self::Item> {
        loop {
            if self.index >= self.used {
                return null;
            }
            let item = builtin::array_get::<T>(self.repr, self.index);
            self.index += 1;
            if (self.pred)(item) {
                return Option::Some((self.f)(item));
            }
        }
    }
}

impl FilterMapIter<T, U> {
    // collect() uses Iterator::collect() default method
    pub fn fold<Acc>(&mut self, init: Acc, f: fn(Acc, U) -> Acc) -> Acc {
        let mut acc = init;
        for let item of *self {
            acc = f(acc, item);
        }
        return acc;
    }
}

pub struct TakeIter<T> {
    repr: builtin::array<T>,
    used: i32,
    index: i32,
    remaining: i32,
}

impl Iterator for TakeIter<T> {
    type Item = T;

    fn next(&mut self) -> Option<Self::Item> {
        if self.remaining <= 0 || self.index >= self.used {
            return null;
        }
        let item = builtin::array_get::<T>(self.repr, self.index);
        self.index += 1;
        self.remaining -= 1;
        return Option::Some(item);
    }
}

// TakeIter uses Iterator::collect() and Iterator::count() default methods

pub struct ChainIter<T> {
    repr1: builtin::array<T>,
    used1: i32,
    index1: i32,
    repr2: builtin::array<T>,
    used2: i32,
    index2: i32,
}

impl Iterator for ChainIter<T> {
    type Item = T;

    fn next(&mut self) -> Option<Self::Item> {
        if self.index1 < self.used1 {
            let item = builtin::array_get::<T>(self.repr1, self.index1);
            self.index1 += 1;
            return Option::Some(item);
        }
        if self.index2 < self.used2 {
            let item = builtin::array_get::<T>(self.repr2, self.index2);
            self.index2 += 1;
            return Option::Some(item);
        }
        return null;
    }
}

// ChainIter uses Iterator::collect() and Iterator::count() default methods

pub struct ZipIter<T, U> {
    repr1: builtin::array<T>,
    used1: i32,
    index1: i32,
    repr2: builtin::array<U>,
    used2: i32,
    index2: i32,
}

impl Iterator for ZipIter<T, U> {
    type Item = [T, U];

    fn next(&mut self) -> Option<Self::Item> {
        if self.index1 >= self.used1 || self.index2 >= self.used2 {
            return null;
        }
        let a = builtin::array_get::<T>(self.repr1, self.index1);
        let b = builtin::array_get::<U>(self.repr2, self.index2);
        self.index1 += 1;
        self.index2 += 1;
        return Option::Some([a, b]);
    }
}

// ZipIter uses Iterator::collect() and Iterator::count() default methods

use { Add } from "core:prelude/traits.wado";

impl ArrayIter<T: Add> {
    pub fn sum(&mut self) -> Option<T> {
        return self.reduce(|a: T, b: T| a + b);
    }
}

impl ArrayIter<T: Ord> {
    pub fn min(&mut self) -> Option<T> {
        if let Some(first) = self.next() {
            let mut result = first;
            for let item of *self {
                if let Less = item.cmp(&result) {
                    result = item;
                }
            }
            return Option::Some(result);
        } else {
            return null;
        }
    }

    pub fn max(&mut self) -> Option<T> {
        if let Some(first) = self.next() {
            let mut result = first;
            for let item of *self {
                if let Greater = item.cmp(&result) {
                    result = item;
                }
            }
            return Option::Some(result);
        } else {
            return null;
        }
    }
}
