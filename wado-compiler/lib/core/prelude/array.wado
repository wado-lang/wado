#![no_prelude]
#![stdlib("core:prelude/array.wado")]
// The raw fixed-length GC array `Array<T>` — the builtin storage primitive
// behind `String` and `List<T>`, now exposed as a first-class value type.
//
// `Array<T>` is a value type: assigning it, passing it by value, or
// returning it deep-copies the backing GC array (see WEP-2026-06-02). Its
// length is a runtime value (`array.len`), not part of the type. `arr[i]`
// copies (`T`, via the direct `array.get` path); in-place mutation goes through
// `set` / `[i] = v`. Array is the generic backing store every `self.repr[i]`
// indexes, so it does not carry the `IndexRef` / `IndexMutRef` *trait* impls
// (those live on the higher-level containers); element references come from the
// `builtin::array_get_ref` / `array_get_mut_ref` intrinsics instead.
//
// Every method is a thin wrapper over a `builtin::array_*` intrinsic, which
// lowers directly to the matching `array.*` instruction.

use { IndexValue, IndexAssign, IntoIterator, Display, DisplayAlt, Inspect, InspectAlt } from "core:prelude/traits.wado";
use { ArraySlice, ArrayIter, ArrayRefIter, ArrayWindows, ArrayChunks } from "core:prelude/slice.wado";
use { RangeExclusive, RangeInclusive } from "core:prelude/range.wado";
use { Formatter } from "core:prelude/format.wado";
use { i32_clamp } from "core:rt";

/// Fixed-length GC array — the builtin storage primitive. Declared
/// definition-less; its storage and instructions live in the compiler.
#[compiler_item("array")]
internal type Array<T>;

impl Array<T> {
    /// Creates a new array of `len` elements, each initialised to the
    /// default value of `T` (`array.new_default`).
    pub fn new(len: i32) -> Array<T> {
        return builtin::array_new(len);
    }

    /// Creates a new array of `len` elements, each set to `value`.
    pub fn filled(len: i32, value: T) -> Array<T> {
        let mut a: Array<T> = builtin::array_new(len);
        builtin::array_fill(&mut a, 0, value, len);
        return a;
    }

    /// Returns the number of elements (`array.len`).
    pub fn len(&self) -> i32 {
        return builtin::array_len(self);
    }

    /// Returns a copy of the element at `index` (`array.get`).
    /// Traps if `index` is out of bounds.
    pub fn get(&self, index: i32) -> T {
        return builtin::array_get(self, index);
    }

    /// Sets the element at `index` to `value` (`array.set`).
    /// Traps if `index` is out of bounds.
    pub fn set(&mut self, index: i32, value: T) with stores[value] {
        builtin::array_set(self, index, value);
    }

    /// Sets every element to `value` (`array.fill`).
    pub fn fill(&mut self, value: T) with stores[value] {
        builtin::array_fill(self, 0, value, builtin::array_len(self));
    }

    /// Copies `len` elements of `src` starting at `src_off` into self
    /// starting at `dst` (`array.copy`).
    pub fn copy_from(&mut self, dst: i32, src: &Array<T>, src_off: i32, len: i32) {
        builtin::array_copy(self, dst, src, src_off, len);
    }

    /// Returns a zero-copy view over `[start, end)`, clamped to the array's
    /// bounds.
    pub fn slice(&self, start: i32, end: i32) -> ArraySlice<T> with stores[self] {
        let len = builtin::array_len(self);
        let s = i32_clamp(start, 0, len);
        let e = i32_clamp(end, s, len);
        return ArraySlice::internal_new(self, s, e);
    }

    /// Returns a by-value iterator over the array's elements.
    pub fn iter(&self) -> ArrayIter<T> with stores[self] {
        return ArrayIter::internal_new(self, 0, builtin::array_len(self));
    }

    /// Returns an iterator over overlapping windows of `size` consecutive
    /// elements. Panics if `size` is not positive.
    pub fn windows(&self, size: i32) -> ArrayWindows<T> with stores[self] {
        return ArrayWindows::internal_new(self, 0, builtin::array_len(self), size);
    }

    /// Returns an iterator over non-overlapping chunks of up to `size`
    /// elements. The last chunk may be shorter. Panics if `size` is not
    /// positive.
    pub fn chunks(&self, size: i32) -> ArrayChunks<T> with stores[self] {
        return ArrayChunks::internal_new(self, 0, builtin::array_len(self), size);
    }
}

impl<T> IntoIterator for Array<T> {
    type Item = T;
    type Iter = ArrayIter<T>;

    fn into_iter(&self) -> Self::Iter with stores[self] {
        return ArrayIter::internal_new(self, 0, builtin::array_len(self));
    }
}

impl<T> IntoIterator for &Array<T> {
    type Item = &T;
    type Iter = ArrayRefIter<T>;

    fn into_iter(&self) -> Self::Iter {
        let arr = *self;
        return ArrayRefIter::internal_new(arr, 0, builtin::array_len(arr));
    }
}

impl IndexValue<i32> for Array<T> {
    type Output = T;

    fn index_value(&self, index: i32) -> Self::Output {
        return builtin::array_get(self, index);
    }
}

impl IndexAssign<i32> for Array<T> {
    type Input = T;

    fn index_assign(&mut self, index: i32, value: Self::Input) with stores[value] {
        builtin::array_set(self, index, value);
    }
}

impl IndexValue<RangeExclusive<i32>> for Array<T> {
    type Output = ArraySlice<T>;

    fn index_value(&self, range: RangeExclusive<i32>) -> ArraySlice<T> with stores[self] {
        return self.slice(range.start, range.end);
    }
}

impl IndexValue<RangeInclusive<i32>> for Array<T> {
    type Output = ArraySlice<T>;

    fn index_value(&self, range: RangeInclusive<i32>) -> ArraySlice<T> with stores[self] {
        return self.slice(range.start, range.end + 1);
    }
}

// Shared `[a, b, …]` Inspect/Display rendering for the GC-array-backed
// sequences (`Array<T>` itself; `List<T>` over its used prefix). `limit` is the
// resolved element cap (negative = none); `marker` appends `, ...` when
// elements are dropped.
internal fn write_seq_inspect<T: Inspect>(repr: &Array<T>, len: i32, f: &mut Formatter, marker: bool, limit: i32) {
    f.write_char('[');
    let mut shown = 0;
    let mut truncated = false;
    for let mut i = 0; i < len; i += 1 {
        if limit >= 0 && shown >= limit {
            truncated = true;
            break;
        }
        if shown > 0 {
            f.write_str(&", ");
        }
        repr[i].inspect(f);
        shown += 1;
    }
    if marker && truncated {
        if shown > 0 {
            f.write_str(&", ...");
        } else {
            f.write_str(&"...");
        }
    }
    f.write_char(']');
}

/// Pretty-printed counterpart of [`write_seq_inspect`]: each element on its own
/// indented line; `marker` appends a `...` line when elements are dropped.
internal fn write_seq_inspect_alt<T: InspectAlt>(repr: &Array<T>, len: i32, f: &mut Formatter, marker: bool, limit: i32) {
    if len == 0 {
        f.write_str(&"[]");
        return;
    }
    f.open_brace("[");
    let mut shown = 0;
    let mut truncated = false;
    for let mut i = 0; i < len; i += 1 {
        if limit >= 0 && shown >= limit {
            truncated = true;
            break;
        }
        f.write_newline_indent();
        repr[i].inspect_alt(f);
        f.write_char(',');
        shown += 1;
    }
    if marker && truncated {
        f.write_newline_indent();
        f.write_str(&"...");
    }
    f.close_brace("]");
}

impl<T: Inspect> Inspect for Array<T> {
    pub fn inspect(&self, f: &mut Formatter) {
        write_seq_inspect(self, builtin::array_len(self), f, true, f.resolved_seq_limit());
    }
}

impl<T: Inspect> Display for Array<T> {
    pub fn fmt(&self, f: &mut Formatter) {
        // Display never applies the default cap; raw precision caps only if >= 0.
        write_seq_inspect(self, builtin::array_len(self), f, false, f.precision);
    }
}

impl<T: InspectAlt> InspectAlt for Array<T> {
    pub fn inspect_alt(&self, f: &mut Formatter) {
        write_seq_inspect_alt(self, builtin::array_len(self), f, true, f.resolved_seq_limit());
    }
}

impl<T: InspectAlt> DisplayAlt for Array<T> {
    pub fn fmt_alt(&self, f: &mut Formatter) {
        // DisplayAlt never applies the default sequence cap (see Display).
        write_seq_inspect_alt(self, builtin::array_len(self), f, false, f.precision);
    }
}
