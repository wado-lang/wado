#![no_prelude]
// Array type and iterators for Wado.
// Provides Array<T>, ArrayIter<T>, and iterator combinators.


use { Ordering, Eq, Ord, IndexValue, IndexAssign, Iterator, IntoIterator, FromIterator } from "core:prelude/traits.wado";
use { Option } from "core:prelude/types.wado";
use { panic } from "core:internal";

fn i32_min(a: i32, b: i32) -> i32 {
    return builtin::select::<i32>(a < b, a, b);
}
fn i32_max(a: i32, b: i32) -> i32 {
    return builtin::select::<i32>(a > b, a, b);
}

pub struct Array<T> {
    repr: builtin::array<T>,
    used: i32,
}

impl Array<T> {
    pub fn with_capacity(capacity: i32) -> Array<T> {
        return Array {
            repr: builtin::array_new::<T>(capacity),
            used: 0,
        };
    }

    pub fn grow(&mut self) {
        let capacity = builtin::array_len(self.repr);
        let new_capacity = i32_max(capacity * 2, 4);
        let new_repr = builtin::array_new::<T>(new_capacity);
        let old_repr = self.repr;
        let used = self.used;
        for let mut i = 0; i < used; i += 1 {
            builtin::array_set::<T>(new_repr, i, builtin::array_get::<T>(old_repr, i));
        }
        self.repr = new_repr;
    }

    pub fn filled(n: i32, element: T) -> Array<T> {
        let repr = builtin::array_new::<T>(n);
        builtin::array_fill::<T>(repr, 0, element, n);
        return Array { repr, used: n };
    }

    pub fn len(&self) -> i32 {
        return self.used;
    }

    pub fn is_empty(&self) -> bool {
        return self.used == 0;
    }

    pub fn internal_raw_data(&self) -> builtin::array<T> {
        return self.repr;
    }

    pub fn internal_from_raw(repr: builtin::array<T>, used: i32) -> Array<T> {
        return Array { repr, used };
    }

    #[comp_feature("array_append")]
    pub fn append(&mut self, value: T) with stores[value] {
        let used = self.used;
        if builtin::unlikely(used >= builtin::array_len(self.repr)) {
            self.grow();
        }
        builtin::array_set::<T>(self.repr, used, value);
        self.used = used + 1;
    }

    pub fn pop(&mut self) -> Option<T> {
        if self.used == 0 {
            return null;
        }
        self.used -= 1;
        return Option::Some(builtin::array_get::<T>(self.repr, self.used));
    }

    pub fn truncate(&mut self, len: i32) {
        if len < self.used {
            self.used = len;
        }
    }

    pub fn last(&self) -> Option<T> {
        if self.used == 0 {
            return null;
        }
        return Option::Some(builtin::array_get::<T>(self.repr, self.used - 1));
    }

    pub fn get(&self, index: i32) -> Option<T> {
        if index < 0 || index >= self.used {
            return null;
        }
        return Option::Some(builtin::array_get::<T>(self.repr, index));
    }

    /// Copies `count` elements from `self[src_start..]` and appends them.
    /// Handles overlapping regions correctly for both non-overlapping and DEFLATE-style
    /// run-length expansion (where src < dst). Forward order is correct in both cases.
    #[inline(always)]
    pub fn copy_within_append(&mut self, src_start: i32, count: i32) {
        let new_used = self.used + count;
        let capacity = builtin::array_len(self.repr);
        if builtin::unlikely(new_used > capacity) {
            let new_capacity = i32_max(new_used, capacity * 2);
            let new_repr = builtin::array_new::<T>(new_capacity);
            // Use element-by-element loop: Wasm array.copy is a libcall in wasmtime
            // (~3μs/element), while a JIT-compiled loop runs at ~1ns/element.
            let old_repr = self.repr;
            let old_used = self.used;
            for let mut i = 0; i < old_used; i += 1 {
                builtin::array_set::<T>(new_repr, i, builtin::array_get::<T>(old_repr, i));
            }
            self.repr = new_repr;
        }
        let raw = self.repr;
        let base = self.used;
        // Forward copy is correct for non-overlapping (any order works) and for
        // overlapping back-references where src < dst (DEFLATE run-length expansion).
        for let mut i = 0; i < count; i += 1 {
            builtin::array_set::<T>(raw, base + i, builtin::array_get::<T>(raw, src_start + i));
        }
        self.used = new_used;
    }
}

impl IndexValue<i32> for Array<T> {
    type Output = T;

    fn index_value(&self, index: i32) -> Self::Output {
        if index >= self.used {
            panic("index out of bounds");
        }
        return builtin::array_get::<T>(self.repr, index);
    }
}

impl IndexAssign<i32> for Array<T> {
    type Input = T;

    fn index_assign(&mut self, index: i32, value: Self::Input) with stores[value] {
        if index >= self.used {
            panic("index out of bounds");
        }
        builtin::array_set::<T>(self.repr, index, value);
    }
}

impl<T: Eq> Eq for Array<T> {
    pub fn eq(&self, other: &Self) -> bool {
        if self.used != other.used {
            return false;
        }
        for let mut i = 0; i < self.used; i += 1 {
            if builtin::array_get::<T>(self.repr, i) != builtin::array_get::<T>(other.repr, i) {
                return false;
            }
        }
        return true;
    }
}

impl<T: Ord> Ord for Array<T> {
    pub fn cmp(&self, other: &Self) -> Ordering {
        let min_len = i32_min(self.used, other.used);
        for let mut i = 0; i < min_len; i += 1 {
            let a = builtin::array_get::<T>(self.repr, i);
            let b = builtin::array_get::<T>(other.repr, i);
            if a < b {
                return Ordering::Less;
            }
            if a > b {
                return Ordering::Greater;
            }
        }
        if self.used < other.used {
            return Ordering::Less;
        }
        if self.used > other.used {
            return Ordering::Greater;
        }
        return Ordering::Equal;
    }
}
pub struct ArraySlice<T> {
    repr: builtin::array<T>,
    start: i32,
    end: i32,
}

impl ArraySlice<T> {
    pub fn len(&self) -> i32 {
        return self.end - self.start;
    }

    pub fn is_empty(&self) -> bool {
        return self.start >= self.end;
    }

    pub fn get(&self, index: i32) -> Option<T> {
        if index < 0 || index >= self.end - self.start {
            return null;
        }
        return Option::Some(builtin::array_get::<T>(self.repr, self.start + index));
    }

    pub fn slice(&self, start: i32, end: i32) -> ArraySlice<T> {
        let abs_start = self.start + i32_max(start, 0);
        let abs_end = self.start + i32_min(end, self.end - self.start);
        return ArraySlice {
            repr: self.repr,
            start: i32_min(abs_start, self.end),
            end: i32_max(abs_start, i32_min(abs_end, self.end)),
        };
    }

    pub fn to_array(&self) -> Array<T> {
        let len = self.end - self.start;
        if len <= 0 {
            return Array::<T>::with_capacity(0);
        }
        let new_repr = builtin::array_new::<T>(len);
        builtin::array_copy::<T>(new_repr, 0, self.repr, self.start, len);
        return Array { repr: new_repr, used: len };
    }

    pub fn iter(&self) -> ArrayIter<T> {
        return ArrayIter {
            repr: self.repr,
            used: self.end,
            index: self.start,
        };
    }
}

impl IndexValue<i32> for ArraySlice<T> {
    type Output = T;

    fn index_value(&self, index: i32) -> Self::Output {
        if index < 0 || index >= self.end - self.start {
            panic("index out of bounds");
        }
        return builtin::array_get::<T>(self.repr, self.start + index);
    }
}

impl<T> IntoIterator for ArraySlice<T> {
    type Item = T;
    type Iter = ArrayIter<T>;

    fn into_iter(&self) -> Self::Iter {
        return self.iter();
    }
}

impl Array<T> {
    pub fn slice(&self, start: i32, end: i32) -> ArraySlice<T> {
        let s = i32_max(start, 0);
        let e = i32_min(end, self.used);
        return ArraySlice {
            repr: self.repr,
            start: i32_min(s, self.used),
            end: i32_max(s, e),
        };
    }
}

pub struct ArrayIter<T> {
    repr: builtin::array<T>,
    used: i32,
    index: i32,
}

impl<T> Iterator for ArrayIter<T> {
    type Item = T;

    fn next(&mut self) -> Option<Self::Item> {
        if self.index >= self.used {
            return null;
        }
        let item = builtin::array_get::<T>(self.repr, self.index);
        self.index += 1;
        return Option::Some(item);
    }
}

impl<T> IntoIterator for Array<T> {
    type Item = T;
    type Iter = ArrayIter<T>;

    fn into_iter(&self) -> Self::Iter {
        return ArrayIter {
            repr: self.repr,
            used: self.used,
            index: 0,
        };
    }
}
pub struct ArrayRefIter<T> {
    repr: builtin::array<T>,
    used: i32,
    index: i32,
}

impl<T> Iterator for ArrayRefIter<T> {
    type Item = &T;

    fn next(&mut self) -> Option<Self::Item> {
        if self.index >= self.used {
            return null;
        }
        let val = builtin::array_get::<T>(self.repr, self.index);
        let ref_val = &val;
        self.index += 1;
        return Option::Some(ref_val);
    }
}

impl<T> IntoIterator for &Array<T> {
    type Item = &T;
    type Iter = ArrayRefIter<T>;

    fn into_iter(&self) -> Self::Iter {
        let arr = *self;
        return ArrayRefIter {
            repr: arr.repr,
            used: arr.used,
            index: 0,
        };
    }
}

impl<T> IntoIterator for &mut Array<T> {
    type Item = &T;
    type Iter = ArrayRefIter<T>;

    fn into_iter(&self) -> Self::Iter {
        let arr = *self;
        return ArrayRefIter {
            repr: arr.repr,
            used: arr.used,
            index: 0,
        };
    }
}

impl Array<T> {
    pub fn iter(&self) -> ArrayIter<T> {
        return self.into_iter();
    }

    /// In-place sort with comparator. Stable, O(n log n) worst case.
    pub fn sort_by(&mut self, cmp: fn(&T, &T) -> Ordering) {
        let n = self.used;
        if n <= 1 {
            return;
        }
        let src = self.repr;
        let buf = builtin::array_new::<T>(n);
        let mut width = 1;
        for ; width < n; width = width * 2 {
            for let mut start = 0; start < n; start += width * 2 {
                let mid = start + width;
                if mid < n {
                    let end = i32_min(start + width * 2, n);
                    let mut i = start;
                    let mut j = mid;
                    for let mut k = start; k < end; k += 1 {
                        if i < mid {
                            if j < end {
                                let a = builtin::array_get::<T>(src, i);
                                let b = builtin::array_get::<T>(src, j);
                                if let Greater = cmp(&a, &b) {
                                    builtin::array_set::<T>(buf, k, b);
                                    j += 1;
                                } else {
                                    builtin::array_set::<T>(buf, k, a);
                                    i += 1;
                                }
                            } else {
                                builtin::array_set::<T>(buf, k, builtin::array_get::<T>(src, i));
                                i += 1;
                            }
                        } else {
                            builtin::array_set::<T>(buf, k, builtin::array_get::<T>(src, j));
                            j += 1;
                        }
                    }
                    builtin::array_copy::<T>(src, start, buf, start, end - start);
                }
            }
        }
    }

    pub fn sorted_by(&self, cmp: fn(&T, &T) -> Ordering) -> Array<T> {
        let n = self.used;
        let new_repr = builtin::array_new::<T>(n);
        builtin::array_copy::<T>(new_repr, 0, self.repr, 0, n);
        let mut copy = Array { repr: new_repr, used: n };
        copy.sort_by(cmp);
        return copy;
    }
}

// sort/sorted require T: Ord (elements must be comparable via Ord::cmp)
impl<T: Ord> Array<T> {
    pub fn sort(&mut self) {
        self.sort_by(|a: &T, b: &T| {
            return a.cmp(b);
        });
    }

    pub fn sorted(&self) -> Array<T> {
        let n = self.used;
        let new_repr = builtin::array_new::<T>(n);
        builtin::array_copy::<T>(new_repr, 0, self.repr, 0, n);
        let mut copy = Array { repr: new_repr, used: n };
        copy.sort();
        return copy;
    }
}

impl FromIterator<T> for Array<T> {
    type Iter = ArrayIter<T>;

    fn from_iter(iter: ArrayIter<T>) -> Array<T> {
        let mut result: Array<T> = [];
        for let item of iter {
            result.append(item);
        }
        return result;
    }
}

// SequenceLiteralBuilder for [e0, e1, ...] -> Array<T>
// The blanket impl in core:prelude automatically provides SequenceLiteral for Array<T>.
impl SequenceLiteralBuilder for Array<T> {
    type Element = T;
    type Output = Array<T>;

    fn new_literal(capacity: i32) -> Array<T> {
        return Array::<T>::with_capacity(capacity);
    }

    fn push_literal(&mut self, value: T) with stores[value] {
        self.append(value);
    }

    fn build(&self) -> Array<T> {
        return *self;
    }
}

impl ArrayIter<T> {
    pub fn collect(&mut self) -> Array<T> {
        let remaining = self.used - self.index;
        let mut repr = builtin::array_new::<T>(remaining);
        let mut result_used = 0;
        for let mut i = self.index; i < self.used; i += 1 {
            let item = builtin::array_get::<T>(self.repr, i);
            builtin::array_set::<T>(repr, result_used, item);
            result_used += 1;
        }
        self.index = self.used;
        return Array { repr, used: result_used };
    }
}

use { Add } from "core:prelude/traits.wado";

impl<T: Add> ArrayIter<T> {
    pub fn sum(&mut self) -> Option<T> {
        return self.reduce(|a: T, b: T| a + b);
    }
}

impl<T: Ord> ArrayIter<T> {
    pub fn min(&mut self) -> Option<T> {
        if let Some(first) = self.next() {
            let mut result = first;
            for let item of *self {
                if let Less = item.cmp(&result) {
                    result = item;
                }
            }
            return Option::Some(result);
        } else {
            return null;
        }
    }

    pub fn max(&mut self) -> Option<T> {
        if let Some(first) = self.next() {
            let mut result = first;
            for let item of *self {
                if let Greater = item.cmp(&result) {
                    result = item;
                }
            }
            return Option::Some(result);
        } else {
            return null;
        }
    }
}

impl Default for Array<T> {
    pub fn default() -> Array<T> {
        return [] as Array<T>;
    }
}
