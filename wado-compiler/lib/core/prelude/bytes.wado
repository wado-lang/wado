#![no_prelude]
#![stdlib("core:prelude/bytes.wado")]
//! Byte-buffer newtypes and the `AsByteSlice` conversion.
//!
//! A byte sequence is a first-class concept across the ecosystem, not an
//! incidental `List<u8>`. These newtypes give the serde data model a real
//! byte-string type (`core:cbor` byte strings; `core:json` base64) and let
//! byte-reading APIs accept an owned byte buffer or a view of one, uncopied.


use { Array } from "core:prelude/array.wado";
use { List } from "core:prelude/list.wado";
use { Slice } from "core:prelude/slice.wado";
use { String } from "core:prelude/string.wado";

/// An owned, fixed-length byte buffer.
pub type ByteArray = Array<u8>;

/// An owned, growable byte buffer.
#[compiler_item("byte_list")]
pub type ByteList = List<u8>;

/// A view referencing a byte buffer.
#[compiler_item("byte_slice")]
pub type ByteSlice = Slice<u8>;

/// Conversion to a `ByteSlice` that copies no bytes.
///
/// Implemented by `ByteArray`, `ByteList`, and `ByteSlice` (and `String`, whose
/// UTF-8 bytes view directly), so byte-reading APIs (e.g. `core:cbor` /
/// `core:json` `from_bytes`) accept any of them.
pub trait AsByteSlice {
    fn as_byte_slice(&self) -> ByteSlice with stores[self];
}

impl AsByteSlice for ByteSlice {
    fn as_byte_slice(&self) -> ByteSlice with stores[self] {
        return *self;
    }
}

impl AsByteSlice for ByteList {
    fn as_byte_slice(&self) -> ByteSlice with stores[self] {
        return self.as_slice() as ByteSlice;
    }
}

impl AsByteSlice for ByteArray {
    fn as_byte_slice(&self) -> ByteSlice with stores[self] {
        return self.as_slice() as ByteSlice;
    }
}

/// Byte-buffer methods specific to `ByteList` (not on a generic `List<T>`):
/// they are what make a byte list first-class rather than an incidental
/// `List<u8>`.
impl ByteList {
    /// Byte at `index` without bounds checking — the `ByteList` parallel to
    /// `String::get_byte_unchecked`.
    ///
    /// The caller must guarantee `0 <= index < len()`; an out-of-range `index`
    /// reads past the buffer or traps. Intended for hot byte-scanning loops
    /// that have already range-checked `index`.
    pub fn get_byte_unchecked(&self, index: i32) -> u8 {
        return self.get_unchecked(index);
    }

    /// Renders the bytes as a lowercase hexadecimal string, two digits per
    /// byte (e.g. `[0x0f, 0xa0]` -> `"0fa0"`).
    pub fn to_hex(&self) -> String {
        let mut s = String::with_capacity(self.len() * 2);
        for let mut i = 0; i < self.len(); i += 1 {
            let byte = self.get_unchecked(i);
            s.push_str(&`${byte:02x}`);
        }
        return s;
    }
}

/// Whether two byte strings are equal, in time that does not depend on where
/// they first differ.
///
/// Use it whenever one side is a secret — a MAC, a token, an API key.
/// `==` stops at the first differing byte, so how long it took says how much
/// of a guess was right, and a secret falls one byte at a time. Everything
/// else should keep using `==`, which is faster.
///
/// A length difference is still answered immediately: a MAC and a digest have
/// public lengths, and only their contents are hidden. Neither the optimizer
/// nor Wasm promises constant-time execution, so this takes the care it can
/// rather than making a guarantee.
pub fn eq_constant_time<A: AsByteSlice, B: AsByteSlice>(a: &A, b: &B) -> bool {
    let left = a.as_byte_slice();
    let right = b.as_byte_slice();
    if left.len() != right.len() {
        return false;
    }
    let mut diff: u8 = 0;
    for let mut i = 0; i < left.len(); i += 1 {
        diff = diff | left[i] ^ right[i];
    }
    return diff == 0;
}

// A `String` is a UTF-8 byte buffer, so it views as a `ByteSlice` directly.
// This lets `from_bytes("...")` accept a string literal with no copy, even
// though `String` still serializes as text (`serialize_string`), not bytes.
impl AsByteSlice for String {
    fn as_byte_slice(&self) -> ByteSlice with stores[self] {
        return self.as_bytes();
    }
}
