#![no_prelude]
#![stdlib("core:prelude/shared.wado")]

use { Default, Eq, Inspect } from "core:prelude/traits.wado";
use { Formatter } from "core:prelude/format.wado";

/// A value that is one object under every copy. `*c` is the place it holds,
/// written through a `&` and without `mut`.
#[compiler_item("shared")]
pub type Shared<T>;

impl<T> Shared<T> {
    /// Puts `value` into a new cell. Nothing else makes one, so no cell
    /// aliases a variable or a field.
    pub fn new(value: T) -> Shared<T> {
        let mut held = value;
        return &mut held as Shared<T>;
    }
}

impl<T: Eq> Eq for Shared<T> {
    pub fn eq(&self, other: &Self) -> bool {
        return **self == **other;
    }
}

impl<T: Default> Default for Shared<T> {
    pub fn default() -> Shared<T> {
        return Shared::new(T::default());
    }
}

impl<T: Inspect> Inspect for Shared<T> {
    pub fn inspect(&self, f: &mut Formatter) {
        f.write_str("Shared(");
        (**self).inspect(f);
        f.write_str(")");
    }
}
