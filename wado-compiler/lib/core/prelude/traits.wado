}

/// Generic take iterator adapter that limits elements from any Iterator.
pub struct IterTake<affine I: Iterator> {
    pub inner: I,
    pub remaining: i32,
}

impl<affine I: Iterator> Iterator for IterTake<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<Self::Item> with _ {
        if self.remaining <= 0 {
            return null;
        }
        if let Some(item) = self.inner.next() {
            self.remaining -= 1;
            return Option::Some(item);
        }
        self.remaining = 0;
        return null;
    }
}

/// Generic skip iterator adapter that skips elements from any Iterator.
pub struct IterSkip<affine I: Iterator> {
    pub inner: I,
    pub remaining: i32,
}

impl<affine I: Iterator> Iterator for IterSkip<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<Self::Item> with _ {
        while self.remaining > 0 {
            if let Some(_) = self.inner.next() {
                self.remaining -= 1;
            } else {
                return null;
            }
        }
        return self.inner.next();
    }
}

/// Generic step iterator adapter that yields every `gap + 1`-th element of any Iterator.
pub struct IterStepBy<affine I: Iterator> {
    pub inner: I,
    pub gap: i32,
    pub started: bool,
}

impl<affine I: Iterator> Iterator for IterStepBy<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<Self::Item> with _ {
        if self.started {
            return self.inner.nth(self.gap);
        }
        self.started = true;
        return self.inner.next();
    }
}

/// Generic chain iterator adapter that chains two iterators of the same item type.
pub struct IterChain<affine I: Iterator, affine J: Iterator> {
    pub first: I,
    pub second: J,
    pub first_done: bool,
}

impl<affine I: Iterator, affine J: Iterator<Item = I::Item>> Iterator for IterChain<I, J> {
    type Item = I::Item;

    fn next(&mut self) -> Option<Self::Item> with _ {
        if !self.first_done {
            if let Some(item) = self.first.next() {
                return Option::Some(item);
            }
            self.first_done = true;
        }
        return self.second.next();
    }
}

/// Generic zip iterator adapter that pairs elements from two iterators.
pub struct IterZip<affine I: Iterator, affine J: Iterator> {
    pub first: I,
    pub second: J,
}

impl<affine I: Iterator, affine J: Iterator> Iterator for IterZip<I, J> {
    type Item = [I::Item, J::Item];

    fn next(&mut self) -> Option<Self::Item> with _ {
        if let Some(a) = self.first.next() {
            if let Some(b) = self.second.next() {
                return Option::Some([a, b]);
            }
        }
        return null;
    }
}

/// Conversion into an Iterator.
/// Types implementing this trait can be used in `for-of` loops directly.
#[compiler_item("into_iterator")]
pub affine trait IntoIterator with _ {
    type Item;
    type Iter: Iterator<Item = Self::Item>;

    /// Creates an iterator from a value.
    fn into_iter(&self) -> Self::Iter;
}

/// Every Iterator is also an IntoIterator (returns a copy of itself).
/// This allows `for let x of iter` to work directly on any iterator.
impl<I: Iterator> IntoIterator for I {
    type Item = I::Item;
    type Iter = I;

    fn into_iter(&self) -> I {
        return *self;
    }
}

/// An iterator walked through a reference, so what takes from it leaves the
/// iterator itself advanced: what `for let x of &mut iter` walks.
pub struct IterRefMut<affine I: Iterator> {
    internal inner: &mut I,
}

impl<affine I: Iterator> Iterator for IterRefMut<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<I::Item> with _ {
        return self.inner.next();
    }
}

/// What `for let x of e` walks when `e` is a value of a type implementing it:
/// the loop passes `e` to `start` and calls the state's
/// `next(&mut self) -> Option<Item>` until it answers `None`. The loop owns
/// what it walks, so an affine element moves into the binding once. Any other
/// iterable is walked through its `IntoIterator`.
#[compiler_item("for_of")]
pub affine trait ForOf with _ {
    affine type Item;
    affine type State;

    fn start(self) -> Self::State;
}

impl<affine I: Iterator> ForOf for I {
    type Item = I::Item;
    type State = I;

    fn start(self) -> I {
        return self;
    }
}

