    /// adapter over it leaves this iterator advanced. An adapter called on the
    /// iterator itself takes a copy and leaves it where it was.
    fn by_ref(&mut self) -> &mut Self with () {
        return self;
    }

    /// Returns an adapter that skips elements for which `pred` returns false.
    fn filter<effect E, F: fn mut(Self::Item) -> bool with E>(self, pred: F) -> IterFilter<Self, F> with () {
        return IterFilter { inner: self, pred };
    }

    /// Returns an adapter that yields `[i, element]` tuples, where `i` starts at 0.
    fn enumerate(self) -> IterEnumerate<Self> with () {
        return IterEnumerate { inner: self, count: 0 };
    }

    /// Returns an adapter that stops after yielding at most `n` elements.
    fn take(self, n: i32) -> IterTake<Self> with () {
        return IterTake { inner: self, remaining: n };
    }

    /// Returns an adapter that discards the first `n` elements before yielding the rest.
    fn skip(self, n: i32) -> IterSkip<Self> with () {
        return IterSkip { inner: self, remaining: n };
    }

    /// Returns an adapter that yields the first element, then every `step`-th after it.
    fn step_by(self, step: i32) -> IterStepBy<Self> with ()
        contract step > 0
    {
        return IterStepBy { inner: self, gap: step - 1, started: false };
    }

    /// Returns an adapter that yields all elements of `self`, then all elements of `other`.
    fn chain<affine J: Iterator<Item = Self::Item>>(self, other: J) -> IterChain<Self, J> with () {
        return IterChain { first: self, second: other, first_done: false };
    }

    /// Returns an adapter that yields `[a, b]` pairs, stopping when either iterator is exhausted.
    fn zip<affine J: Iterator>(self, other: J) -> IterZip<Self, J> with () {
        return IterZip { first: self, second: other };
    }

    /// Adds the remaining elements. None for an empty iterator.
    fn sum<S: Sum<Elem = Self::Item> = Self::Item>(&mut self) -> Option<S> {
        return S::sum_iter(self);
    }

    /// Multiplies the remaining elements. None for an empty iterator.
    fn product<P: Product<Elem = Self::Item> = Self::Item>(&mut self) -> Option<P> {
        return P::product_iter(self);
    }

    /// The smallest remaining element, the first on ties. None for an empty iterator.
    fn min<E: Extremum<Elem = Self::Item> = Self::Item>(&mut self) -> Option<E> {
        return E::min_iter(self);
    }

    /// The largest remaining element, the last on ties. None for an empty iterator.
    fn max<E: Extremum<Elem = Self::Item> = Self::Item>(&mut self) -> Option<E> {
        return E::max_iter(self);
    }

    /// The smallest remaining element under `cmp`, the first on ties.
    fn min_by(&mut self, mut cmp: fn mut(&Self::Item, &Self::Item) -> Ordering with _) -> Option<Self::Item> with _ {
        if let Some(first) = self.next() {
            let mut best = first;
            while let Some(item) = self.next() {
                if let _::Less = cmp(&item, &best) {
                    best = item;
                }
            }
            return Option::Some(best);
        }
        return null;
    }

    /// The largest remaining element under `cmp`, the last on ties.
    fn max_by(&mut self, mut cmp: fn mut(&Self::Item, &Self::Item) -> Ordering with _) -> Option<Self::Item> with _ {
        if let Some(first) = self.next() {
            let mut best = first;
            while let Some(item) = self.next() {
                if cmp(&best, &item) != Ordering::Greater {
                    best = item;
                }
            }
            return Option::Some(best);
        }
        return null;
    }

    /// The remaining element with the smallest `key`, the first on ties.
    fn min_by_key<K: Ord>(&mut self, mut key: fn mut(Self::Item) -> K with _) -> Option<Self::Item> with _ {
        if let Some(first) = self.next() {
            let mut best = first;
            let mut best_key = key(first);
            while let Some(item) = self.next() {
                let item_key = key(item);
                if let _::Less = item_key.cmp(&best_key) {
                    best = item;
                    best_key = item_key;
                }
            }
            return Option::Some(best);
        }
        return null;
    }

    /// The remaining element with the largest `key`, the last on ties.
    fn max_by_key<K: Ord>(&mut self, mut key: fn mut(Self::Item) -> K with _) -> Option<Self::Item> with _ {
        if let Some(first) = self.next() {
            let mut best = first;
            let mut best_key = key(first);
            while let Some(item) = self.next() {
                let item_key = key(item);
                if best_key.cmp(&item_key) != Ordering::Greater {
                    best = item;
                    best_key = item_key;
                }
            }
            return Option::Some(best);
        }
        return null;
    }
}

/// Generic map iterator adapter that wraps any Iterator. Its type carries the
/// function's, so advancing it performs what the function does.
pub struct IterMap<affine I: Iterator, F> {
    pub inner: I,
    pub f: F,
}

impl<affine I: Iterator, U, effect E, F: fn mut(I::Item) -> U with E> Iterator for IterMap<I, F> {
    type Item = U;

    fn next(&mut self) -> Option<Self::Item> with E {
        if let Some(item) = self.inner.next() {
            return Option::Some((self.f)(item));
        }
        return null;
    }
}

// Its own impl: through the blanket one over `Iterator`, `into_iter` is
// charged the effects of the function the adapter holds.
impl<I: Iterator, U, effect E, F: fn mut(I::Item) -> U with E> IntoIterator for IterMap<I, F> {
    type Item = U;
    type Iter = IterMap<I, F>;

    fn into_iter(&self) -> IterMap<I, F> {
        return *self;
    }
}

/// Generic filter iterator adapter that wraps any Iterator. Its type carries
/// the predicate's, so advancing it performs what the predicate does.
pub struct IterFilter<affine I: Iterator, F> {
    pub inner: I,
    pub pred: F,
}

impl<affine I: Iterator, effect E, F: fn mut(I::Item) -> bool with E> Iterator for IterFilter<I, F> {
    type Item = I::Item;

    fn next(&mut self) -> Option<Self::Item> with E {
        loop {
            if let Some(item) = self.inner.next() {
                if (self.pred)(item) {
                    return Option::Some(item);
                }
            } else {
                return null;
            }
        }
    }
}

// Its own impl, as `IterMap`'s is.
impl<I: Iterator, effect E, F: fn mut(I::Item) -> bool with E> IntoIterator for IterFilter<I, F> {
    type Item = I::Item;
    type Iter = IterFilter<I, F>;

    fn into_iter(&self) -> IterFilter<I, F> {
        return *self;
    }
}

/// Generic enumerate iterator adapter that yields (index, element) pairs.
pub struct IterEnumerate<affine I: Iterator> {
    pub inner: I,
    pub count: i32,
}

impl<affine I: Iterator> Iterator for IterEnumerate<I> {
    type Item = [i32, I::Item];

    fn next(&mut self) -> Option<Self::Item> with _ {
        if let Some(item) = self.inner.next() {
            let idx = self.count;
            self.count += 1;
            return Option::Some([idx, item]);
        }
        return null;
    }
}

/// Generic take iterator adapter that limits elements from any Iterator.
pub struct IterTake<affine I: Iterator> {
    pub inner: I,
    pub remaining: i32,
}

impl<affine I: Iterator> Iterator for IterTake<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<Self::Item> with _ {
        if self.remaining <= 0 {
            return null;
        }
        if let Some(item) = self.inner.next() {
            self.remaining -= 1;
            return Option::Some(item);
        }
        self.remaining = 0;
        return null;
    }
}

/// Generic skip iterator adapter that skips elements from any Iterator.
pub struct IterSkip<affine I: Iterator> {
    pub inner: I,
    pub remaining: i32,
}

impl<affine I: Iterator> Iterator for IterSkip<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<Self::Item> with _ {
        while self.remaining > 0 {
            if let Some(_) = self.inner.next() {
                self.remaining -= 1;
            } else {
                return null;
            }
        }
        return self.inner.next();
    }
}

/// Generic step iterator adapter that yields every `gap + 1`-th element of any Iterator.
pub struct IterStepBy<affine I: Iterator> {
    pub inner: I,
    pub gap: i32,
    pub started: bool,
}

impl<affine I: Iterator> Iterator for IterStepBy<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<Self::Item> with _ {
        if self.started {
            return self.inner.nth(self.gap);
        }
        self.started = true;
        return self.inner.next();
    }
}

/// Generic chain iterator adapter that chains two iterators of the same item type.
pub struct IterChain<affine I: Iterator, affine J: Iterator> {
    pub first: I,
    pub second: J,
    pub first_done: bool,
}

impl<affine I: Iterator, affine J: Iterator<Item = I::Item>> Iterator for IterChain<I, J> {
    type Item = I::Item;

    fn next(&mut self) -> Option<Self::Item> with _ {
        if !self.first_done {
            if let Some(item) = self.first.next() {
                return Option::Some(item);
            }
            self.first_done = true;
        }
        return self.second.next();
    }
}

/// Generic zip iterator adapter that pairs elements from two iterators.
pub struct IterZip<affine I: Iterator, affine J: Iterator> {
    pub first: I,
    pub second: J,
}

impl<affine I: Iterator, affine J: Iterator> Iterator for IterZip<I, J> {
    type Item = [I::Item, J::Item];

    fn next(&mut self) -> Option<Self::Item> with _ {
        if let Some(a) = self.first.next() {
            if let Some(b) = self.second.next() {
                return Option::Some([a, b]);
            }
        }
        return null;
    }
}

/// Conversion into an Iterator.
/// Types implementing this trait can be used in `for-of` loops directly.
#[compiler_item("into_iterator")]
pub affine trait IntoIterator with _ {
    type Item;
    type Iter: Iterator<Item = Self::Item>;

    /// Creates an iterator from a value.
    fn into_iter(&self) -> Self::Iter;
}

/// Every Iterator is also an IntoIterator (returns a copy of itself).
/// This allows `for let x of iter` to work directly on any iterator.
impl<I: Iterator> IntoIterator for I {
    type Item = I::Item;
    type Iter = I;

    fn into_iter(&self) -> I {
        return *self;
    }
}

/// A `&mut` to an iterator is an iterator that advances the one it points to,
/// so a loop, an adapter or a consumer bounded by `Iterator`, handed
/// `&mut iter`, leaves `iter` where it stopped. One bounded by `IntoIterator`
/// walks a copy.
impl<affine I: Iterator> Iterator for &mut I {
    type Item = I::Item;

    fn next(&mut self) -> Option<I::Item> with _ {
        return (**self).next();
    }
}

/// What `for let x of e` walks when `e` is a value of a type implementing it:
/// the loop passes `e` to `start` and calls the state's
/// `next(&mut self) -> Option<Item>` until it answers `None`. The loop owns
/// what it walks, so an affine element moves into the binding once. Any other
/// iterable is walked through its `IntoIterator`.
#[compiler_item("for_of")]
pub affine trait ForOf with _ {
    affine type Item;
    affine type State;

    fn start(self) -> Self::State;
}

impl<affine I: Iterator> ForOf for I {
    type Item = I::Item;
    type State = I;

    fn start(self) -> I {
        return self;
    }
}

