#![no_prelude]
#![stdlib("core:prelude/traits.wado")]
// Prelude Traits
// This module defines all traits that are automatically available in every Wado module.

use { Option, Result } from "core:prelude/types.wado";
use { Formatter } from "core:prelude/format.wado";
use { String } from "core:prelude/string.wado";
use { List } from "core:prelude/list.wado";


/// Result of a comparison between two values.
#[compiler_item("ordering")]
internal enum Ordering {
    /// The first value is less than the second.
    #[compiler_item("ordering_less")]
    Less,
    /// The two values are equal.
    #[compiler_item("ordering_equal")]
    Equal,
    /// The first value is greater than the second.
    #[compiler_item("ordering_greater")]
    Greater,
}

/// Trait for equality comparisons.
/// Types implementing this trait can be compared with `==` and `!=` operators.
#[compiler_item("eq")]
internal trait Eq {
    /// Returns true if self equals other.
    fn eq(&self, other: &Self) -> bool;
}

impl<T> Eq for &T {
    pub fn eq(&self, other: &Self) -> bool {
        return *self == *other;
    }
}

impl<T> Eq for &mut T {
    pub fn eq(&self, other: &Self) -> bool {
        return *self == *other;
    }
}

/// Trait for ordering comparisons.
/// Types implementing this trait can be compared with `<`, `<=`, `>`, `>=` operators.
#[compiler_item("ord")]
internal trait Ord {
    /// Compares self with other and returns an Ordering.
    fn cmp(&self, other: &Self) -> Ordering;
}
/// Trait for providing a default value for a type.
/// Types implementing this trait can produce a sensible "zero" or "empty" value.
#[compiler_item("default")]
internal trait Default {
    /// Returns the default value for this type.
    fn default() -> Self;
}

/// Compile-time struct introspection. The compiler synthesizes an impl for
/// every struct; it cannot be implemented in user code and is callable only in
/// monomorphized contexts (`T` a concrete struct).
/// See WEP 2026-06-13.
#[compiler_item("reflect_struct")]
internal trait ReflectStruct {
    /// The field types as a tuple `[F_0, F_1, ...]`.
    type FieldTypes;

    /// The per-field member tuple `[StructField<Self, F_0>, ...]`.
    type Members;

    /// Returns the struct name.
    #[compiler_item("reflect_struct_type_name")]
    fn type_name() -> String;

    /// Returns the per-field members.
    #[compiler_item("reflect_struct_members")]
    fn members() -> Self::Members;

    /// The struct's `#[wire(name_policy)]` (`Identity` if none).
    #[compiler_item("reflect_struct_wire_name_policy")]
    fn wire_name_policy() -> CaseStyle;
}

/// The wire-naming policy declared by `#[wire(name_policy = "...")]` (casing
/// not applied here — `core:serde::wire_name` resolves it). See WEP 2026-06-13.
#[compiler_item("case_style")]
pub enum CaseStyle {
    Identity,
    Camel,
    Snake,
    ScreamingSnake,
    Pascal,
    Kebab,
    ScreamingKebab,
}

/// The attr-reading face of a reflected member. Sealed and
/// compiler-synthesized; user impls are rejected. See WEP 2026-06-13.
#[compiler_item("member")]
internal trait Member {
    /// The source field name.
    #[compiler_item("member_name")]
    fn name(&self) -> String;

    /// The raw `#[wire(name)]` value (casing not applied), or `None`.
    #[compiler_item("member_wire_name_override")]
    fn wire_name_override(&self) -> Option<String>;
}

/// Compile-time variant introspection. The compiler synthesizes an impl for
/// every variant; it cannot be implemented in user code and is callable only
/// in monomorphized contexts (`T` a concrete variant).
/// See WEP 2026-06-13 §3.
#[compiler_item("reflect_variant")]
internal trait ReflectVariant {
    /// The per-case payload tuple `[P_0, P_1, ...]`; unit cases are `()`.
    type CasePayloads;

    /// The per-case member tuple `[VariantCase<Self, P_0>, ...]`.
    type Members;

    /// Returns the variant name.
    #[compiler_item("reflect_variant_type_name")]
    fn type_name() -> String;

    /// Returns the live case's tag.
    #[compiler_item("reflect_variant_discriminant")]
    fn discriminant(&self) -> i32;

    /// Returns the per-case members.
    #[compiler_item("reflect_variant_members")]
    fn members() -> Self::Members;

    /// The variant's `#[wire(name_policy)]` (`Identity` if none).
    #[compiler_item("reflect_variant_wire_name_policy")]
    fn wire_name_policy() -> CaseStyle;
}

/// Compile-time enum introspection. The compiler synthesizes an impl for
/// every enum; it cannot be implemented in user code and is callable only
/// in monomorphized contexts (`T` a concrete enum).
/// See WEP 2026-06-13 §3b.
#[compiler_item("reflect_enum")]
internal trait ReflectEnum {
    /// The per-case member tuple `[EnumCase<Self>, ...]`.
    type Members;

    /// Returns the enum name.
    #[compiler_item("reflect_enum_type_name")]
    fn type_name() -> String;

    /// Returns the value's tag.
    #[compiler_item("reflect_enum_discriminant")]
    fn discriminant(&self) -> i32;

    /// Returns the case with the given tag; `None` for an unknown tag.
    #[compiler_item("reflect_enum_from_discriminant")]
    fn from_discriminant(disc: i32) -> Option<Self>;

    /// Returns the per-case members.
    #[compiler_item("reflect_enum_members")]
    fn members() -> Self::Members;

    /// The enum's `#[wire(name_policy)]` (`Identity` if none).
    #[compiler_item("reflect_enum_wire_name_policy")]
    fn wire_name_policy() -> CaseStyle;
}

/// Compile-time flags introspection. The compiler synthesizes an impl for
/// every flags type; it cannot be implemented in user code and is callable
/// only in monomorphized contexts (`T` a concrete flags type).
/// See WEP 2026-06-13 §3c.
#[compiler_item("reflect_flags")]
internal trait ReflectFlags {
    /// The per-bit member tuple `[FlagsBit<Self>, ...]`.
    type Members;

    /// Returns the flags type name.
    #[compiler_item("reflect_flags_type_name")]
    fn type_name() -> String;

    /// Returns the value's bits, u64-normalized.
    #[compiler_item("reflect_flags_bits")]
    fn bits(&self) -> u64;

    /// Returns the value with the given bits; `None` when unknown bits
    /// are set.
    #[compiler_item("reflect_flags_from_bits")]
    fn from_bits(raw: u64) -> Option<Self>;

    /// Returns the per-bit members.
    #[compiler_item("reflect_flags_members")]
    fn members() -> Self::Members;

    /// The flags type's `#[wire(name_policy)]` (`Identity` if none).
    #[compiler_item("reflect_flags_wire_name_policy")]
    fn wire_name_policy() -> CaseStyle;
}

/// A case handle minted by `ReflectVariant::members()`: the payload type `P`
/// is static, the case index is a value. `extract` / `construct` bridge a
/// variant value and its payload in both directions.
/// See WEP 2026-06-13 §3e.
#[compiler_item("variant_case")]
pub struct VariantCase<T, P> {
    index: i32,
    case_name: String,
    wire_override: Option<String>,
    is_unit: bool,
}

impl<T, P> VariantCase<T, P> {
    /// The case's tag.
    pub fn discriminant(&self) -> i32 {
        return self.index;
    }

    /// Whether the case carries no payload.
    pub fn is_unit(&self) -> bool {
        return self.is_unit;
    }

    /// Whether `v`'s live case is this case.
    pub fn holds(&self, v: &T) -> bool {
        return builtin::variant_tag(v) == self.index;
    }

    /// The payload of this case in `v`. Traps unless `holds(v)`.
    pub fn extract(&self, v: &T) -> P {
        return builtin::variant_case_extract(v, self.index);
    }

    /// Builds this case around `payload`.
    pub fn construct(&self, payload: P) -> T {
        return builtin::variant_case_construct(payload, self.index);
    }
}

impl<T, P> Member for VariantCase<T, P> {
    fn name(&self) -> String {
        return self.case_name;
    }

    fn wire_name_override(&self) -> Option<String> {
        return self.wire_override;
    }
}

/// A case handle minted by `ReflectEnum::members()`: an enum case carries
/// no payload, so the member holds the case value itself. `make` mints it and
/// `holds` tests a value's live case. See WEP 2026-06-13 §3b.
#[compiler_item("enum_case")]
pub struct EnumCase<T> {
    discriminant: i32,
    value: T,
    case_name: String,
    wire_override: Option<String>,
}

impl<T: ReflectEnum> EnumCase<T> {
    /// The case's discriminant.
    pub fn discriminant(&self) -> i32 {
        return self.discriminant;
    }

    /// Whether `v` is this case.
    pub fn holds(&self, v: &T) -> bool {
        return ReflectEnum::<T>::discriminant(v) == self.discriminant;
    }

    /// The enum value for this case.
    pub fn make(&self) -> T {
        return self.value;
    }
}

impl<T> Member for EnumCase<T> {
    fn name(&self) -> String {
        return self.case_name;
    }

    fn wire_name_override(&self) -> Option<String> {
        return self.wire_override;
    }
}

/// A bit handle minted by `ReflectFlags::members()`: the member holds the
/// single-bit flags value. `set` mints it and `is_set` tests a value for the
/// bit. See WEP 2026-06-13 §3c.
#[compiler_item("flags_bit")]
pub struct FlagsBit<T> {
    bit: u64,
    value: T,
    member_name: String,
}

impl<T: ReflectFlags> FlagsBit<T> {
    /// The member's bitmask, u64-normalized.
    pub fn bit(&self) -> u64 {
        return self.bit;
    }

    /// Whether `v` has this bit set.
    pub fn is_set(&self, v: &T) -> bool {
        return ReflectFlags::<T>::bits(v) & self.bit != 0;
    }

    /// The flags value with only this bit set.
    pub fn set(&self) -> T {
        return self.value;
    }
}

impl<T> Member for FlagsBit<T> {
    fn name(&self) -> String {
        return self.member_name;
    }

    fn wire_name_override(&self) -> Option<String> {
        return Option::None;
    }
}

/// A field handle minted by `ReflectStruct::members()`: the field type `F` is
/// static, and `get` reads the field's value out of a struct. See WEP 2026-06-13.
#[compiler_item("struct_field")]
pub struct StructField<T, F> {
    index: i32,
    field_name: String,
    wire_override: Option<String>,
    has_default: bool,
    is_secret: bool,
}

impl<T, F> StructField<T, F> {
    /// The field's declaration index.
    pub fn index(&self) -> i32 {
        return self.index;
    }

    /// Whether the field declares a default value.
    pub fn has_default(&self) -> bool {
        return self.has_default;
    }

    /// Whether the field is marked `#[secret]`.
    pub fn is_secret(&self) -> bool {
        return self.is_secret;
    }

    /// The value of this field in `v`.
    pub fn get(&self, v: &T) -> F {
        return builtin::struct_field_get(v, self.index);
    }
}

impl<T, F> Member for StructField<T, F> {
    fn name(&self) -> String {
        return self.field_name;
    }

    fn wire_name_override(&self) -> Option<String> {
        return self.wire_override;
    }
}

// The four member handles format themselves. The derivations below are written
// over `ReflectStruct`, and a handle is sealed against reflection — its own
// `Members` would mention `StructField<Self, …>` and grow `Self` without bound —
// so a handle takes the escape hatch any undrivable type has and writes its own
// impl. The output matches what a derived struct produces.

// `Option<String>`'s own `Inspect` is synthesized for the variant in
// `prelude/types.wado`, which is not yet resolvable while this module is
// elaborated — the derivations above reach field types through a bound, this
// module reaches a concrete one. Render the two cases directly, matching what
// the variant derive emits.
internal fn inspect_wire_override(v: &Option<String>, f: &mut Formatter) {
    match v {
        Option::Some(s) => {
            f.write_str(&"Option::Some(");
            s.inspect(f);
            f.write_str(&")");
        }
        Option::None => {
            f.write_str(&"Option::None");
        }
    }
}

impl<T, F> Inspect for StructField<T, F> {
    fn inspect(&self, f: &mut Formatter) {
        f.write_str(&"StructField { index: ");
        self.index.inspect(f);
        f.write_str(&", field_name: ");
        self.field_name.inspect(f);
        f.write_str(&", wire_override: ");
        inspect_wire_override(&self.wire_override, f);
        f.write_str(&", has_default: ");
        self.has_default.inspect(f);
        f.write_str(&", is_secret: ");
        self.is_secret.inspect(f);
        f.write_str(&" }");
    }
}

impl<T, F> InspectAlt for StructField<T, F> {
    fn inspect_alt(&self, f: &mut Formatter) {
        f.open_brace("StructField {");
        f.write_newline_indent();
        f.write_str(&"index: ");
        self.index.inspect_alt(f);
        f.write_str(&",");
        f.write_newline_indent();
        f.write_str(&"field_name: ");
        self.field_name.inspect_alt(f);
        f.write_str(&",");
        f.write_newline_indent();
        f.write_str(&"wire_override: ");
        inspect_wire_override(&self.wire_override, f);
        f.write_str(&",");
        f.write_newline_indent();
        f.write_str(&"has_default: ");
        self.has_default.inspect_alt(f);
        f.write_str(&",");
        f.write_newline_indent();
        f.write_str(&"is_secret: ");
        self.is_secret.inspect_alt(f);
        f.write_str(&",");
        f.close_brace("}");
    }
}

impl<T, P> Inspect for VariantCase<T, P> {
    fn inspect(&self, f: &mut Formatter) {
        f.write_str(&"VariantCase { index: ");
        self.index.inspect(f);
        f.write_str(&", case_name: ");
        self.case_name.inspect(f);
        f.write_str(&", wire_override: ");
        inspect_wire_override(&self.wire_override, f);
        f.write_str(&", is_unit: ");
        self.is_unit.inspect(f);
        f.write_str(&" }");
    }
}

impl<T, P> InspectAlt for VariantCase<T, P> {
    fn inspect_alt(&self, f: &mut Formatter) {
        f.open_brace("VariantCase {");
        f.write_newline_indent();
        f.write_str(&"index: ");
        self.index.inspect_alt(f);
        f.write_str(&",");
        f.write_newline_indent();
        f.write_str(&"case_name: ");
        self.case_name.inspect_alt(f);
        f.write_str(&",");
        f.write_newline_indent();
        f.write_str(&"wire_override: ");
        inspect_wire_override(&self.wire_override, f);
        f.write_str(&",");
        f.write_newline_indent();
        f.write_str(&"is_unit: ");
        self.is_unit.inspect_alt(f);
        f.write_str(&",");
        f.close_brace("}");
    }
}

impl<T: Inspect> Inspect for EnumCase<T> {
    fn inspect(&self, f: &mut Formatter) {
        f.write_str(&"EnumCase { discriminant: ");
        self.discriminant.inspect(f);
        f.write_str(&", value: ");
        self.value.inspect(f);
        f.write_str(&", case_name: ");
        self.case_name.inspect(f);
        f.write_str(&", wire_override: ");
        inspect_wire_override(&self.wire_override, f);
        f.write_str(&" }");
    }
}

impl<T: InspectAlt> InspectAlt for EnumCase<T> {
    fn inspect_alt(&self, f: &mut Formatter) {
        f.open_brace("EnumCase {");
        f.write_newline_indent();
        f.write_str(&"discriminant: ");
        self.discriminant.inspect_alt(f);
        f.write_str(&",");
        f.write_newline_indent();
        f.write_str(&"value: ");
        self.value.inspect_alt(f);
        f.write_str(&",");
        f.write_newline_indent();
        f.write_str(&"case_name: ");
        self.case_name.inspect_alt(f);
        f.write_str(&",");
        f.write_newline_indent();
        f.write_str(&"wire_override: ");
        inspect_wire_override(&self.wire_override, f);
        f.write_str(&",");
        f.close_brace("}");
    }
}

impl<T: Inspect> Inspect for FlagsBit<T> {
    fn inspect(&self, f: &mut Formatter) {
        f.write_str(&"FlagsBit { bit: ");
        self.bit.inspect(f);
        f.write_str(&", value: ");
        self.value.inspect(f);
        f.write_str(&", member_name: ");
        self.member_name.inspect(f);
        f.write_str(&" }");
    }
}

impl<T: InspectAlt> InspectAlt for FlagsBit<T> {
    fn inspect_alt(&self, f: &mut Formatter) {
        f.open_brace("FlagsBit {");
        f.write_newline_indent();
        f.write_str(&"bit: ");
        self.bit.inspect_alt(f);
        f.write_str(&",");
        f.write_newline_indent();
        f.write_str(&"value: ");
        self.value.inspect_alt(f);
        f.write_str(&",");
        f.write_newline_indent();
        f.write_str(&"member_name: ");
        self.member_name.inspect_alt(f);
        f.write_str(&",");
        f.close_brace("}");
    }
}

/// Marker for reference-identity types: those whose value is a Wasm GC
/// reference. Sealed and compiler-synthesized; user impls are rejected.
/// See WEP 2026-01-20.
#[compiler_item("ref")]
internal trait Ref {
}

/// Marker for in-place-mutable reference types: `Ref` minus the replace-on-assign
/// ones (`variant`, `fn`). A `&mut` to one of these writes through to the stored
/// value. Sealed and compiler-synthesized; user impls are rejected.
/// See WEP 2026-01-20.
#[compiler_item("ref_mut")]
internal trait RefMut {
}

/// Immutable reference indexing: `&container[i]` reads through this.
/// `Output: Ref` — only a reference element can be handed out by reference; a
/// value element is read through `IndexValue`.
internal trait IndexRef<IndexType> {
    type Output: Ref;

    /// Returns a reference to the element at the given index.
    fn index_ref(&self, index: IndexType) -> &Self::Output;
}

/// Mutable reference indexing: `container[i].mutating_method()`.
/// `Output: RefMut` — the element must be mutated in place, so a replace-on-assign
/// element (`variant`, `fn`) cannot be handed out mutably by reference.
internal trait IndexMutRef<IndexType> {
    type Output: RefMut;

    /// Returns a mutable reference to the element at the given index.
    fn index_mut_ref(&mut self, index: IndexType) -> &mut Self::Output;
}

/// Value-assignment indexing: `container[i] = value`.
/// Separate from `IndexMutRef`: a scalar element has no addressable cell, so
/// writing it by value is a distinct operation from handing out a `&mut`.
internal trait IndexAssign<IndexType> {
    type Input;

    /// Assigns a value to the element at the given index.
    fn index_assign(&mut self, index: IndexType, value: Self::Input);
}

/// Value-copy indexing: `container[i]` yields a copy of the element.
/// The value-semantics counterpart to `IndexRef` for elements that cannot be
/// aliased by reference (scalars, resources).
internal trait IndexValue<IndexType> {
    type Output;

    /// Returns a copy of the element at the given index.
    fn index_value(&self, index: IndexType) -> Self::Output;
}
/// Trait for the `+` operator.
/// Types implementing this trait can use the `+` operator for addition.
internal trait Add {
    type Output;

    /// Adds two values and returns the result.
    fn add(&self, rhs: &Self) -> Self::Output;
}

/// Trait for the `-` operator (binary subtraction).
/// Types implementing this trait can use the `-` operator for subtraction.
internal trait Sub {
    type Output;

    /// Subtracts rhs from self and returns the result.
    fn sub(&self, rhs: &Self) -> Self::Output;
}

/// Trait for the `*` operator.
/// Types implementing this trait can use the `*` operator for multiplication.
internal trait Mul {
    type Output;

    /// Multiplies two values and returns the result.
    fn mul(&self, rhs: &Self) -> Self::Output;
}

/// Trait for the `/` operator.
/// Types implementing this trait can use the `/` operator for division.
internal trait Div {
    type Output;

    /// Divides self by rhs and returns the result.
    fn div(&self, rhs: &Self) -> Self::Output;
}

/// Trait for the `%` operator.
/// Types implementing this trait can use the `%` operator for remainder.
internal trait Rem {
    type Output;

    /// Returns the remainder of dividing self by rhs.
    fn rem(&self, rhs: &Self) -> Self::Output;
}

/// Trait for the unary `-` operator (negation).
/// Types implementing this trait can use the `-` prefix operator.
internal trait Neg {
    type Output;

    /// Returns the negation of self.
    fn neg(&self) -> Self::Output;
}
/// Trait for the `&` operator (bitwise AND).
internal trait BitAnd {
    type Output;

    /// Returns the bitwise AND of self and rhs.
    fn bitand(&self, rhs: &Self) -> Self::Output;
}

/// Trait for the `|` operator (bitwise OR).
internal trait BitOr {
    type Output;

    /// Returns the bitwise OR of self and rhs.
    fn bitor(&self, rhs: &Self) -> Self::Output;
}

/// Trait for the `^` operator (bitwise XOR).
internal trait BitXor {
    type Output;

    /// Returns the bitwise XOR of self and rhs.
    fn bitxor(&self, rhs: &Self) -> Self::Output;
}

/// Trait for the `~` operator (bitwise NOT).
internal trait BitNot {
    type Output;

    /// Returns the bitwise NOT of self.
    fn bitnot(&self) -> Self::Output;
}

/// Trait for the `<<` operator (left shift).
internal trait Shl {
    type Output;

    /// Returns self shifted left by rhs bits.
    fn shl(&self, rhs: u32) -> Self::Output;
}

/// Trait for the `>>` operator (right shift).
internal trait Shr {
    type Output;

    /// Returns self shifted right by rhs bits.
    fn shr(&self, rhs: u32) -> Self::Output;
}
/// Trait for user-facing display formatting.
/// Types implementing this trait can be formatted with `${x}` in template strings.
/// All format traits write to a `Formatter` that wraps `&mut String`.
#[compiler_item("display")]
internal trait Display {
    /// Formats the value and writes to the given formatter.
    fn fmt(&self, f: &mut Formatter);
}

/// Trait for debug/inspect formatting.
/// Types implementing this trait can be formatted with `${x:?}` in template strings.
/// Unlike Display, Inspect always shows the "raw" debug representation:
/// - Strings are quoted: `"hello"`
/// - Chars are quoted: `'A'`
/// - Structs show field names: `Point { x: 10, y: 20 }`
/// - Enums/Variants show type-qualified names: `Color::Red`
#[compiler_item("inspect")]
internal trait Inspect {
    /// Formats the value as a debug representation and writes to the given formatter.
    fn inspect(&self, f: &mut Formatter);
}

/// Struct debug formatting derived over `ReflectStruct` (WEP 2026-06-13): walk
/// the field members, writing `Name { field: value, ... }`. Secret fields are
/// elided and reported with a trailing `, ..`.
impl<T: ReflectStruct<FieldTypes = [..F]>, ..F: Inspect> Inspect for T {
    fn inspect(&self, f: &mut Formatter) {
        f.write_str(&ReflectStruct::<T>::type_name());
        let mut wrote_field = false;
        let mut has_secret = false;
        for let field of ReflectStruct::<T>::members() {
            if field.is_secret() {
                has_secret = true;
            } else {
                if wrote_field {
                    f.write_str(&", ");
                } else {
                    f.write_str(&" { ");
                    wrote_field = true;
                }
                f.write_str(&field.name());
                f.write_str(&": ");
                field.get(self).inspect(f);
            }
        }
        if wrote_field {
            if has_secret {
                f.write_str(&", ..");
            }
            f.write_str(&" }");
        } else if has_secret {
            f.write_str(&" { .. }");
        } else {
            f.write_str(&" {}");
        }
    }
}

/// Trait for formatting values as binary integers.
/// Used with the `${x:b}` format specifier.
#[compiler_item("binary")]
internal trait Binary {
    /// Formats the value as binary and writes to the given formatter.
    fn fmt(&self, f: &mut Formatter);
}

/// Trait for formatting values as octal integers.
/// Used with the `${x:o}` format specifier.
#[compiler_item("octal")]
internal trait Octal {
    /// Formats the value as octal and writes to the given formatter.
    fn fmt(&self, f: &mut Formatter);
}

/// Trait for formatting values as lowercase hexadecimal.
/// Used with the `${x:x}` format specifier.
#[compiler_item("lower_hex")]
internal trait LowerHex {
    /// Formats the value as lowercase hex and writes to the given formatter.
    fn fmt(&self, f: &mut Formatter);
}

/// Trait for formatting values as uppercase hexadecimal.
/// Used with the `${x:X}` format specifier.
#[compiler_item("upper_hex")]
internal trait UpperHex {
    /// Formats the value as uppercase hex and writes to the given formatter.
    fn fmt(&self, f: &mut Formatter);
}

/// Trait for formatting values in lowercase exponential notation.
/// Used with the `${x:e}` format specifier.
#[compiler_item("lower_exp")]
internal trait LowerExp {
    /// Formats the value in lowercase exponential notation and writes to the given formatter.
    fn fmt(&self, f: &mut Formatter);
}

/// Trait for formatting values in uppercase exponential notation.
/// Used with the `${x:E}` format specifier.
#[compiler_item("upper_exp")]
internal trait UpperExp {
    /// Formats the value in uppercase exponential notation and writes to the given formatter.
    fn fmt(&self, f: &mut Formatter);
}

/// Trait for alternate (pretty-print) inspect formatting.
/// Used with the `${x:#?}` format specifier.
/// Produces multi-line indented output for composite types.
/// Primitive types delegate to `Inspect::inspect`.
#[compiler_item("inspect_alt")]
internal trait InspectAlt {
    fn inspect_alt(&self, f: &mut Formatter);
}

/// Trait for alternate display formatting.
/// Used with the `${x:#}` format specifier.
/// If not explicitly implemented, auto-generated to delegate to `Display::fmt`
/// (which in turn falls back to `Inspect`). Pretty-printing lives on the
/// inspect side via `InspectAlt`.
#[compiler_item("display_alt")]
internal trait DisplayAlt {
    fn fmt_alt(&self, f: &mut Formatter);
}

/// Trait for alternate binary formatting (with `0b` prefix).
/// Used with the `${x:#b}` format specifier.
#[compiler_item("binary_alt")]
internal trait BinaryAlt {
    fn fmt_alt(&self, f: &mut Formatter);
}

/// Trait for alternate octal formatting (with `0o` prefix).
/// Used with the `${x:#o}` format specifier.
#[compiler_item("octal_alt")]
internal trait OctalAlt {
    fn fmt_alt(&self, f: &mut Formatter);
}

/// Trait for alternate lowercase hex formatting (with `0x` prefix).
/// Used with the `${x:#x}` format specifier.
#[compiler_item("lower_hex_alt")]
internal trait LowerHexAlt {
    fn fmt_alt(&self, f: &mut Formatter);
}

/// Trait for alternate uppercase hex formatting (with `0X` prefix).
/// Used with the `${x:#X}` format specifier.
#[compiler_item("upper_hex_alt")]
internal trait UpperHexAlt {
    fn fmt_alt(&self, f: &mut Formatter);
}
/// The core iterator trait for sequences of values.
/// Types implementing this trait can be iterated over using `for-of` loops.
internal trait Iterator {
    type Item;

    /// Advances the iterator and returns the next value.
    /// Returns None when iteration is complete.
    fn next(&mut self) -> Option<Self::Item>;

    /// Collects the remaining elements into any `FromIterator` target,
    /// defaulting to `List<Self::Item>`.
    fn collect<C: FromIterator<Elem = Self::Item> = List<Self::Item>>(&mut self) -> C {
        return C::from_iter(self);
    }

    /// Counts the number of remaining elements in the iterator.
    fn count(&mut self) -> i32 {
        let mut n = 0;
        while let Some(_) = self.next() {
            n += 1;
        }
        return n;
    }

    /// Transforms each element using a function.
    fn map<U>(&self, f: fn mut(Self::Item) -> U) -> IterMap<Self, U> {
        return IterMap { inner: *self, f };
    }

    /// Like `reduce`, but takes an explicit initial accumulator instead of using the first element.
    /// Always returns a value (unlike `reduce`, which returns None for empty iterators).
    fn fold<Acc>(&mut self, init: Acc, mut f: fn mut(Acc, Self::Item) -> Acc) -> Acc {
        let mut acc = init;
        while let Some(item) = self.next() {
            acc = f(acc, item);
        }
        return acc;
    }

    /// Calls `f` for every remaining element. Consumes the iterator.
    fn for_each(&mut self, mut f: fn mut(Self::Item)) {
        while let Some(item) = self.next() {
            f(item);
        }
    }

    /// Returns the first element for which `pred` returns true, advancing the iterator up to that point.
    fn find(&mut self, mut pred: fn mut(Self::Item) -> bool) -> Option<Self::Item> {
        while let Some(item) = self.next() {
            if pred(item) {
                return Option::Some(item);
            }
        }
        return null;
    }

    /// Returns true if `pred` returns true for at least one element (∃). False for empty iterators.
    /// Short-circuits: stops advancing the iterator as soon as a matching element is found.
    fn any(&mut self, mut pred: fn mut(Self::Item) -> bool) -> bool {
        while let Some(item) = self.next() {
            if pred(item) {
                return true;
            }
        }
        return false;
    }

    /// Returns true if `pred` returns true for every element (∀). True for empty iterators.
    /// Short-circuits: stops advancing the iterator as soon as a non-matching element is found.
    fn all(&mut self, mut pred: fn mut(Self::Item) -> bool) -> bool {
        while let Some(item) = self.next() {
            if !pred(item) {
                return false;
            }
        }
        return true;
    }

    /// Advances the entire iterator and returns the last element, or None if empty.
    fn last(&mut self) -> Option<Self::Item> {
        let mut result: Option<Self::Item> = null;
        while let Some(item) = self.next() {
            result = Option::Some(item);
        }
        return result;
    }

    /// Returns the nth element (0-indexed), advancing the iterator up to and including it.
    fn nth(&mut self, n: i32) -> Option<Self::Item> {
        let mut remaining = n;
        while let Some(item) = self.next() {
            if remaining <= 0 {
                return Option::Some(item);
            }
            remaining -= 1;
        }
        return null;
    }

    /// Returns the 0-based index of the first element for which `pred` returns true, or None.
    fn position(&mut self, mut pred: fn mut(Self::Item) -> bool) -> Option<i32> {
        let mut idx = 0;
        while let Some(item) = self.next() {
            if pred(item) {
                return Option::Some(idx);
            }
            idx += 1;
        }
        return null;
    }

    /// Reduces elements to a single value without an initial accumulator.
    /// Returns None if the iterator is empty.
    fn reduce(&mut self, mut f: fn mut(Self::Item, Self::Item) -> Self::Item) -> Option<Self::Item> {
        if let Some(first) = self.next() {
            let mut acc = first;
            while let Some(item) = self.next() {
                acc = f(acc, item);
            }
            return Option::Some(acc);
        }
        return null;
    }

    /// Returns an adapter that skips elements for which `pred` returns false.
    fn filter(&self, pred: fn mut(Self::Item) -> bool) -> IterFilter<Self> {
        return IterFilter { inner: *self, pred };
    }

    /// Returns an adapter that yields `[i, element]` tuples, where `i` starts at 0.
    fn enumerate(&self) -> IterEnumerate<Self> {
        return IterEnumerate { inner: *self, count: 0 };
    }

    /// Returns an adapter that stops after yielding at most `n` elements.
    fn take(&self, n: i32) -> IterTake<Self> {
        return IterTake { inner: *self, remaining: n };
    }

    /// Returns an adapter that discards the first `n` elements before yielding the rest.
    fn skip(&self, n: i32) -> IterSkip<Self> {
        return IterSkip { inner: *self, remaining: n };
    }

    /// Returns an adapter that yields all elements of `self`, then all elements of `other`.
    fn chain<J: Iterator<Item = Self::Item>>(&self, other: J) -> IterChain<Self, J> {
        return IterChain { first: *self, second: other, first_done: false };
    }

    /// Returns an adapter that yields `[a, b]` pairs, stopping when either iterator is exhausted.
    fn zip<J: Iterator>(&self, other: J) -> IterZip<Self, J> {
        return IterZip { first: *self, second: other };
    }
}

/// Generic map iterator adapter that wraps any Iterator.
internal struct IterMap<I: Iterator, U> {
    pub inner: I,
    pub f: fn mut(I::Item) -> U,
}

impl<I: Iterator, U> Iterator for IterMap<I, U> {
    type Item = U;

    fn next(&mut self) -> Option<Self::Item> {
        if let Some(item) = self.inner.next() {
            return Option::Some((self.f)(item));
        }
        return null;
    }
}

impl<I: Iterator, U> IntoIterator for IterMap<I, U> {
    type Item = U;
    type Iter = IterMap<I, U>;

    fn into_iter(&self) -> IterMap<I, U> {
        return *self;
    }
}

/// Generic filter iterator adapter that wraps any Iterator.
internal struct IterFilter<I: Iterator> {
    pub inner: I,
    pub pred: fn mut(I::Item) -> bool,
}

impl<I: Iterator> Iterator for IterFilter<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<Self::Item> {
        loop {
            if let Some(item) = self.inner.next() {
                if (self.pred)(item) {
                    return Option::Some(item);
                }
            } else {
                return null;
            }
        }
    }
}

impl<I: Iterator> IntoIterator for IterFilter<I> {
    type Item = I::Item;
    type Iter = IterFilter<I>;

    fn into_iter(&self) -> IterFilter<I> {
        return *self;
    }
}

/// Generic enumerate iterator adapter that yields (index, element) pairs.
internal struct IterEnumerate<I: Iterator> {
    pub inner: I,
    pub count: i32,
}

impl<I: Iterator> Iterator for IterEnumerate<I> {
    type Item = [i32, I::Item];

    fn next(&mut self) -> Option<Self::Item> {
        if let Some(item) = self.inner.next() {
            let idx = self.count;
            self.count += 1;
            return Option::Some([idx, item]);
        }
        return null;
    }
}

impl<I: Iterator> IntoIterator for IterEnumerate<I> {
    type Item = [i32, I::Item];
    type Iter = IterEnumerate<I>;

    fn into_iter(&self) -> IterEnumerate<I> {
        return *self;
    }
}

/// Generic take iterator adapter that limits elements from any Iterator.
internal struct IterTake<I: Iterator> {
    pub inner: I,
    pub remaining: i32,
}

impl<I: Iterator> Iterator for IterTake<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<Self::Item> {
        if self.remaining <= 0 {
            return null;
        }
        if let Some(item) = self.inner.next() {
            self.remaining -= 1;
            return Option::Some(item);
        }
        self.remaining = 0;
        return null;
    }
}

impl<I: Iterator> IntoIterator for IterTake<I> {
    type Item = I::Item;
    type Iter = IterTake<I>;

    fn into_iter(&self) -> IterTake<I> {
        return *self;
    }
}

/// Generic skip iterator adapter that skips elements from any Iterator.
internal struct IterSkip<I: Iterator> {
    pub inner: I,
    pub remaining: i32,
}

impl<I: Iterator> Iterator for IterSkip<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<Self::Item> {
        while self.remaining > 0 {
            if let Some(_) = self.inner.next() {
                self.remaining -= 1;
            } else {
                return null;
            }
        }
        return self.inner.next();
    }
}

impl<I: Iterator> IntoIterator for IterSkip<I> {
    type Item = I::Item;
    type Iter = IterSkip<I>;

    fn into_iter(&self) -> IterSkip<I> {
        return *self;
    }
}

/// Generic chain iterator adapter that chains two iterators of the same item type.
internal struct IterChain<I: Iterator, J: Iterator> {
    pub first: I,
    pub second: J,
    pub first_done: bool,
}

impl<I: Iterator, J: Iterator<Item = I::Item>> Iterator for IterChain<I, J> {
    type Item = I::Item;

    fn next(&mut self) -> Option<Self::Item> {
        if !self.first_done {
            if let Some(item) = self.first.next() {
                return Option::Some(item);
            }
            self.first_done = true;
        }
        return self.second.next();
    }
}

impl<I: Iterator, J: Iterator<Item = I::Item>> IntoIterator for IterChain<I, J> {
    type Item = I::Item;
    type Iter = IterChain<I, J>;

    fn into_iter(&self) -> IterChain<I, J> {
        return *self;
    }
}

/// Generic zip iterator adapter that pairs elements from two iterators.
internal struct IterZip<I: Iterator, J: Iterator> {
    pub first: I,
    pub second: J,
}

impl<I: Iterator, J: Iterator> Iterator for IterZip<I, J> {
    type Item = [I::Item, J::Item];

    fn next(&mut self) -> Option<Self::Item> {
        if let Some(a) = self.first.next() {
            if let Some(b) = self.second.next() {
                return Option::Some([a, b]);
            }
        }
        return null;
    }
}

impl<I: Iterator, J: Iterator> IntoIterator for IterZip<I, J> {
    type Item = [I::Item, J::Item];
    type Iter = IterZip<I, J>;

    fn into_iter(&self) -> IterZip<I, J> {
        return *self;
    }
}

/// Conversion into an Iterator.
/// Types implementing this trait can be used in `for-of` loops directly.
internal trait IntoIterator {
    type Item;
    type Iter: Iterator<Item = Self::Item>;

    /// Creates an iterator from a value.
    /// Note: Uses &self due to parser limitation (self by value not yet supported in traits).
    fn into_iter(&self) -> Self::Iter;
}

/// Every Iterator is also an IntoIterator (returns a copy of itself).
/// This allows `for let x of iter` to work directly on any iterator.
impl<I: Iterator> IntoIterator for I {
    type Item = I::Item;
    type Iter = I;

    fn into_iter(&self) -> I {
        return *self;
    }
}

/// Infallible conversion trait.
/// Implement this to define how to convert from type `T` into `Self`.
/// Usage: `TargetType::from(value)` — the target type is always explicit.
///
/// The compiler provides a reflexive blanket impl `From<T> for T` for all types.
#[compiler_item("from")]
internal trait From<T> {
    /// Converts a value of type `T` into `Self`.
    fn from(value: T) -> Self;
}

/// Fallible conversion trait.
/// Returns `Result<Self, Self::Error>` so callers can handle conversion failures.
internal trait TryFrom<T> {
    type Error;

    /// Attempts to convert a value of type `T` into `Self`.
    fn try_from(value: T) -> Result<Self, Self::Error>;
}

/// Error type returned by fallible conversions.
internal struct ConvertError {
    pub message: String,
}

impl ConvertError {
    pub fn new(message: String) -> ConvertError {
        return ConvertError { message };
    }
}


/// Trait for creating a collection from any iterator of `Elem`.
internal trait FromIterator {
    type Elem;
    fn from_iter<I: Iterator<Item = Self::Elem>>(iter: &mut I) -> Self;
}

/// Builder trait for constructing a value from a key-value literal `{ key: value, ... }`.
/// Implement this to make a type constructible from `{ key: value, ... }` literals.
/// Keys are always String (from field names); `Value` is the element type.
/// `Output` is the finished value (often `Self` for mutable types).
internal trait KeyValueLiteralBuilder {
    type Value;
    type Output;
    /// Create an empty builder pre-allocated for `capacity` entries.
    fn new_literal(capacity: i32) -> Self;
    /// Record one field from the literal.
    fn insert_literal(&mut self, key: String, value: Self::Value);
    /// Seed the builder with every entry of `base`, for a `{ ..base, … }` spread.
    /// Explicit `insert_literal` calls run after the seed, so they override.
    fn insert_all(&mut self, base: Self::Output);
    /// Consume the builder and return the finished value.
    fn build(&self) -> Self::Output;
}

/// Marker trait for types constructible from a key-value literal.
/// Implemented automatically for any `T: KeyValueLiteralBuilder<Output = T>`.
/// For immutable output types, implement this explicitly and set `type Builder`
/// to the mutable builder struct that builds this type.
internal trait KeyValueLiteral {
    type Value;
    type Builder;
}

/// Blanket implementation: any self-as-builder type satisfies KeyValueLiteral.
impl<T: KeyValueLiteralBuilder<Output = T>> KeyValueLiteral for T {
    type Value = T::Value;
    type Builder = T;
}

/// Builder trait for constructing a value from a sequence literal `[e0, e1, ...]`.
/// Implement this to make a type constructible from sequence literals.
/// `Element` is the element type; `Output` is the finished value.
internal trait SequenceLiteralBuilder {
    type Element;
    type Output;
    /// Create an empty builder pre-allocated for `capacity` elements.
    fn new_literal(capacity: i32) -> Self;
    /// Append one element from the literal.
    fn push_literal(&mut self, value: Self::Element);
    /// Consume the builder and return the finished value.
    fn build(&self) -> Self::Output;
}

/// Marker trait for types constructible from a sequence literal.
/// Implemented automatically for any `T: SequenceLiteralBuilder<Output = T>`.
/// For immutable output types, implement this explicitly and set `type Builder`
/// to the mutable builder struct that builds this type.
internal trait SequenceLiteral {
    type Element;
    type Builder;
}

/// Blanket implementation: any self-as-builder type satisfies SequenceLiteral.
impl<T: SequenceLiteralBuilder<Output = T>> SequenceLiteral for T {
    type Element = T::Element;
    type Builder = T;
}

/// Parse a value from a string.
///
/// `from_str_range` is the fundamental operation: it parses `s[start..end)`
/// without allocating a substring. Implementors must provide it. The
/// `from_str` convenience method is a thin wrapper that parses the entire
/// string and is provided as a default.
internal trait FromStr {
    type Err;

    /// Parse the byte range `s[start..end)` as `Self`. Takes `s` by
    /// reference because the function only reads and the call site
    /// (often the router's per-request path) is a hot path where a
    /// `String` value copy would dominate the work.
    fn from_str_range(s: &String, start: i32, end: i32) -> Result<Self, Self::Err>;

    /// Parse the entire string as `Self`. Delegates to `from_str_range`.
    /// Takes `&String` for the same reason `from_str_range` does — callers
    /// already holding a `&String` (e.g. the JSON deserializer threading
    /// the input buffer through) should not have to dereference and copy.
    fn from_str(s: &String) -> Result<Self, Self::Err> {
        return Self::from_str_range(s, 0, s.len());
    }
}

/// Error returned by the lenient string parsers (`LenientFromStr`). All
/// built-in impls share this single type, carrying a short human-readable
/// reason. See `docs/wep-2026-06-22-lenient-from-str.md`.
internal struct LenientParseError {
    reason: String,
}

impl LenientParseError {
    pub fn new(reason: String) -> LenientParseError {
        return LenientParseError { reason };
    }

    /// A short description of why parsing failed.
    pub fn reason(&self) -> String {
        return self.reason;
    }
}

/// Forgiving sibling of `FromStr`: parse a human-supplied string, accepting
/// the common spelling variations for the type (casing, radix prefixes,
/// digit separators, alternate boolean words). Leniency widens accepted
/// spellings only — an undenotable value still yields `Err`, and whitespace
/// is never trimmed (that is the caller's concern). See
/// `docs/wep-2026-06-22-lenient-from-str.md`.
internal trait LenientFromStr {
    type Err;

    /// Parse the entire string as `Self`, accepting forgiving spellings.
    fn from_str_lenient(s: &String) -> Result<Self, Self::Err>;
}
