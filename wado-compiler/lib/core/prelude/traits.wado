#![no_prelude]
#![stdlib("core:prelude/traits.wado")]
//! The traits the language itself reads: comparison, hashing, defaults,
//! markers, indexing, operators, conversion and formatting.

use { Option, Result } from "core:prelude/option.wado";
use { Formatter } from "core:prelude/format.wado";
use { String, AsStrSlice } from "core:prelude/string.wado";
use { ByteSlice } from "core:prelude/bytes.wado";
use {
    Reflect,
    ReflectStruct,
    ReflectVariant,
    ReflectEnum,
    ReflectFlags,
    ReflectNewtype,
    ReflectTemplate,
} from "core:prelude/reflect.wado";

/// Result of a comparison between two values.
#[compiler_item("ordering")]
pub enum Ordering {
    /// The first value is less than the second.
    #[compiler_item("ordering_less")]
    Less,
    /// The two values are equal.
    #[compiler_item("ordering_equal")]
    Equal,
    /// The first value is greater than the second.
    #[compiler_item("ordering_greater")]
    Greater,
}

/// Trait for equality comparisons.
/// Types implementing this trait can be compared with `==` and `!=` operators.
#[compiler_item("eq")]
pub affine trait Eq<Rhs = Self> with () {
    /// Returns true if self equals other.
    fn eq(&self, other: &Rhs) -> bool;
}

impl<T: Eq> Eq for &T {
    pub fn eq(&self, other: &Self) -> bool {
        return **self == **other;
    }
}

impl<T: Eq> Eq for &mut T {
    pub fn eq(&self, other: &Self) -> bool {
        return **self == **other;
    }
}

/// Whether `a` and `b` point to one place, not merely to equal values. `==`
/// on references compares the values.
pub fn ref_eq<affine T>(a: &T, b: &T) -> bool {
    return builtin::ref_eq(a, b);
}

/// A total order over the type: what `<`, `sort`, `TreeMap` and a `T: Ord`
/// bound read. A float's puts every NaN last, as one value, and `-0.0` equal to
/// `0.0`.
#[compiler_item("ord")]
pub affine trait Ord: Eq with () {
    /// Compares self with other and returns an Ordering.
    fn cmp(&self, other: &Self) -> Ordering;
}

/// What a `Hash` impl feeds its value into. The hasher owns the algorithm and
/// its seed; an impl only says which words and bytes make up the value.
pub trait Hasher with () {
    fn write_u64(&mut self, x: u64);
    /// Takes the length too, so consecutive byte runs never run together.
    fn write_bytes(&mut self, bytes: ByteSlice);
}

/// A value a hash table can key on. Values that are `==` feed a hasher alike.
#[compiler_item("hash")]
pub affine trait Hash: Eq with () {
    fn hash<H: Hasher>(&self, h: &mut H);
}

/// A struct feeds its fields in declaration order, as its derived `Eq`
/// compares them.
impl<T: ReflectStruct<FieldTypes = [..F]> + Eq, ..F: Hash> Hash for T {
    fn hash<H: Hasher>(&self, h: &mut H) {
        for let f of ReflectStruct::<T>::members() {
            f.get_ref(self).hash(h);
        }
    }
}

/// A variant feeds its live case's tag, then the payload a payload case
/// carries, as its derived `Eq` compares them.
impl<V: ReflectVariant<CasePayloads = [..P]> + Eq, ..P: Hash> Hash for V {
    fn hash<H: Hasher>(&self, h: &mut H) {
        for let case of ReflectVariant::<V>::members() {
            if case.holds(self) {
                h.write_u64(case.discriminant() as u64);
                if !case.is_unit() {
                    case.extract(self).hash(h);
                }
                return;
            }
        }
        unreachable();
    }
}

impl<E: ReflectEnum + Eq> Hash for E {
    fn hash<H: Hasher>(&self, h: &mut H) {
        h.write_u64(ReflectEnum::discriminant(self) as u64);
    }
}

impl<L: ReflectFlags + Eq> Hash for L {
    fn hash<H: Hasher>(&self, h: &mut H) {
        h.write_u64(ReflectFlags::bits(self));
    }
}

/// Trait for providing a default value for a type.
/// Types implementing this trait can produce a sensible "zero" or "empty" value.
#[compiler_item("default")]
pub affine trait Default with () {
    /// Returns the default value for this type.
    fn default() -> Self;
}

/// What a drop of an affine value runs: at scope exit, at a store over it, for
/// a value nothing keeps, and by name. A type without an impl drops its fields
/// one by one. What `drop` leaves in `self` drops field by field after it, and
/// only an affine type implements it.
#[compiler_item("drop")]
pub affine trait Drop with () {
    #[ambient(_)]
    fn drop(self);
}

/// Marker for reference-identity types: those whose value is a Wasm GC
/// reference. Sealed and compiler-synthesized; user impls are rejected.
/// See WEP 2026-01-20.
#[compiler_item("ref")]
pub trait Ref with () {
}

/// Marker for in-place-mutable reference types: `Ref` minus the replace-on-assign
/// ones (`variant`, `fn`). A `&mut` to one of these writes through to the stored
/// value. Sealed and compiler-synthesized; user impls are rejected.
/// See WEP 2026-01-20.
#[compiler_item("ref_mut")]
pub trait RefMut with () {
}

/// Marker every resource holds, and nothing else. A resource names an object
/// rather than holding a value, so a `&R` to one promises nothing about the
/// object. Sealed and compiler-stated; user impls are rejected.
#[compiler_item("resource")]
pub trait Resource with () {
}

/// Marker every affine resource holds, and nothing else. Sealed and
/// compiler-stated; user impls are rejected. See WEP: Affine Types.
#[compiler_item("affine_resource")]
pub trait AffineResource: Resource with () {
}

/// Marker of an extern handle: a resource declared `repr = "externref"`.
/// Sealed and compiler-stated; user impls are rejected. See WEP: Extern
/// Handles.
#[compiler_item("extern_handle")]
pub trait ExternHandle: Resource with () {
}

/// What every resource offers: a handle is the host's object, or backed by a
/// value of the guest. Only a `RefMut` type backs one: a reference to any other
/// is a cell, which carries neither the value's identity nor its type. See WEP:
/// Guest-Backed Resources.
pub affine trait Backing with () {
    /// A new handle holding `value`, which only the handle reaches from here
    /// on. Each call makes a handle equal to no other.
    fn backed_by<T: RefMut>(value: T) -> Self;

    /// The value this handle holds, in place: `None` for the host's object,
    /// and for a handle holding a value of another type. It is `&mut` under
    /// `&self` because a resource is the object it names, not a place.
    fn backing<T: RefMut>(&self) -> Option<&mut T>;
}

impl<affine R: Resource> Backing for R {
    fn backed_by<T: RefMut>(value: T) -> R {
        return builtin::resource_backed_by::<R, T>(value);
    }

    fn backing<T: RefMut>(&self) -> Option<&mut T> {
        if builtin::resource_is_backed_by::<R, T>(self) {
            return Option::Some(builtin::resource_backing::<R, T>(self));
        }
        return null;
    }
}

/// Marker of a type every bit pattern of its width is a value of: the
/// fixed-width integers, the floats, `v128`, and a newtype or `flags` type over
/// one. `builtin::load` reads one from any bytes. Sealed and compiler-stated;
/// user impls are rejected. See WEP: Linear Arrays.
#[compiler_item("any_bits")]
pub trait AnyBits with () {
}

/// Marker of a type no value of which is affine, so a copy of one is sound:
/// what an `impl`'s parameter not declared `affine` admits. The compiler
/// states it of primitives, function values and every declaration not
/// declared `affine`; the prelude states it of `Array` and tuples. See WEP:
/// Affine Types.
#[compiler_item("copyable")]
internal trait Copyable with () {
}

/// Immutable reference indexing: `&container[i]` reads through this.
/// `Output: Ref` — only a reference element can be handed out by reference; a
/// value element is read through `IndexValue`.
#[compiler_item("index_ref")]
pub affine trait IndexRef<IndexType> with () {
    affine type Output: Ref;

    /// Returns a reference to the element at the given index.
    fn index_ref(&self, index: IndexType) -> &Self::Output;
}

/// Mutable reference indexing: `container[i].mutating_method()`.
/// `Output: RefMut` — the element must be mutated in place, so a replace-on-assign
/// element (`variant`, `fn`) cannot be handed out mutably by reference.
#[compiler_item("index_ref_mut")]
pub affine trait IndexRefMut<IndexType> with () {
    affine type Output: RefMut;

    /// Returns a mutable reference to the element at the given index.
    fn index_ref_mut(&mut self, index: IndexType) -> &mut Self::Output;
}

/// Value-assignment indexing: `container[i] = value`.
/// Separate from `IndexRefMut`: a scalar element has no addressable cell, so
/// writing it by value is a distinct operation from handing out a `&mut`.
#[compiler_item("index_assign")]
pub affine trait IndexAssign<IndexType> with () {
    affine type Output;

    /// Assigns a value to the element at the given index.
    fn index_assign(&mut self, index: IndexType, value: Self::Output);
}

/// Element exchange: `c.index_swap(a, b)` does what `[c[a], c[b]] = [c[b], c[a]]`
/// does, moving the two elements rather than copying them, so it serves an
/// affine element too. Like that assignment it checks `b` before `a`, and
/// `a == b` leaves the container as it was.
#[compiler_item("index_swap")]
pub affine trait IndexSwap<IndexType> with () {
    fn index_swap(&mut self, a: IndexType, b: IndexType);
}

/// Value-copy indexing: `container[i]` yields a copy of the element.
/// The value-semantics counterpart to `IndexRef` for elements that cannot be
/// aliased by reference (scalars, resources). An affine container hands out
/// copyable elements by value too (`LinearArray`).
#[compiler_item("index_value")]
pub affine trait IndexValue<IndexType> with () {
    type Output;

    /// Returns a copy of the element at the given index.
    fn index_value(&self, index: IndexType) -> Self::Output;
}

/// Trait for the `+` operator.
/// Types implementing this trait can use the `+` operator for addition.
#[compiler_item("add")]
pub trait Add<Rhs = Self> with () {
    type Output;

    /// Adds two values and returns the result.
    fn add(&self, rhs: &Rhs) -> Self::Output;
}

/// Trait for the `-` operator (binary subtraction).
/// Types implementing this trait can use the `-` operator for subtraction.
#[compiler_item("sub")]
pub trait Sub<Rhs = Self> with () {
    type Output;

    /// Subtracts rhs from self and returns the result.
    fn sub(&self, rhs: &Rhs) -> Self::Output;
}

/// Trait for the `*` operator.
/// Types implementing this trait can use the `*` operator for multiplication.
#[compiler_item("mul")]
pub trait Mul<Rhs = Self> with () {
    type Output;

    /// Multiplies two values and returns the result.
    fn mul(&self, rhs: &Rhs) -> Self::Output;
}

/// Trait for the `/` operator.
/// Types implementing this trait can use the `/` operator for division.
#[compiler_item("div")]
pub trait Div<Rhs = Self> with () {
    type Output;

    /// Divides self by rhs and returns the result.
    fn div(&self, rhs: &Rhs) -> Self::Output;
}

/// Trait for the `%` operator.
/// Types implementing this trait can use the `%` operator for remainder.
#[compiler_item("rem")]
pub trait Rem<Rhs = Self> with () {
    type Output;

    /// Returns the remainder of dividing self by rhs.
    fn rem(&self, rhs: &Rhs) -> Self::Output;
}

/// Trait for the unary `-` operator (negation).
/// Types implementing this trait can use the `-` prefix operator.
#[compiler_item("neg")]
pub trait Neg with () {
    type Output;

    /// Returns the negation of self.
    fn neg(&self) -> Self::Output;
}

/// Trait for the `&` operator (bitwise AND).
#[compiler_item("bit_and")]
pub trait BitAnd<Rhs = Self> with () {
    type Output;

    /// Returns the bitwise AND of self and rhs.
    fn bitand(&self, rhs: &Rhs) -> Self::Output;
}

/// Trait for the `|` operator (bitwise OR).
#[compiler_item("bit_or")]
pub trait BitOr<Rhs = Self> with () {
    type Output;

    /// Returns the bitwise OR of self and rhs.
    fn bitor(&self, rhs: &Rhs) -> Self::Output;
}

/// Trait for the `^` operator (bitwise XOR).
#[compiler_item("bit_xor")]
pub trait BitXor<Rhs = Self> with () {
    type Output;

    /// Returns the bitwise XOR of self and rhs.
    fn bitxor(&self, rhs: &Rhs) -> Self::Output;
}

/// Trait for the `~` operator (bitwise NOT).
#[compiler_item("bit_not")]
pub trait BitNot with () {
    type Output;

    /// Returns the bitwise NOT of self.
    fn bitnot(&self) -> Self::Output;
}

/// Trait for the `<<` operator (left shift).
#[compiler_item("shl")]
pub trait Shl<Rhs = Self> with () {
    type Output;

    /// Returns self shifted left by rhs bits.
    fn shl(&self, rhs: &Rhs) -> Self::Output;
}

/// Trait for the `>>` operator (right shift).
#[compiler_item("shr")]
pub trait Shr<Rhs = Self> with () {
    type Output;

    /// Returns self shifted right by rhs bits.
    fn shr(&self, rhs: &Rhs) -> Self::Output;
}

/// Trait for user-facing display formatting.
/// Types implementing this trait can be formatted with `${x}` in template strings.
/// All format traits write to a `Formatter` that wraps `&mut String`.
#[compiler_item("display")]
pub affine trait Display with () {
    /// Formats the value and writes to the given formatter.
    fn fmt(&self, f: &mut Formatter);
}

/// What every standard library error type is: a failure carrying a reason a
/// person can read. It adds nothing to `Display`, so a bound on it says only that.
pub affine trait Error: Display with () {
}

/// Trait for debug/inspect formatting.
/// Types implementing this trait can be formatted with `${x:?}` in template strings.
/// Unlike Display, Inspect always shows the "raw" debug representation:
/// - Strings are quoted: `"hello"`
/// - Chars are quoted: `'A'`
/// - Structs show field names: `Point { x: 10, y: 20 }`
/// - Enums/Variants show type-qualified names: `Color::Red`
#[compiler_item("inspect")]
pub affine trait Inspect with () {
    /// Formats the value as a debug representation and writes to the given formatter.
    fn inspect(&self, f: &mut Formatter);
}

/// Struct debug formatting derived over `ReflectStruct` (WEP 2026-06-13): walk
/// the field members, writing `Name { field: value, ... }`. Secret fields are
/// elided and reported with a trailing `, ..`.
/// The alternate (`#`) rendering the struct `Inspect` hands off to:
/// `Name {\n  field: value,\n}`, one field per indented line.
fn inspect_struct_alternate<affine S: ReflectStruct<FieldTypes = [..F]>, affine ..F: Inspect>(v: &S, f: &mut Formatter) {
    let mut wrote_field = false;
    let mut has_secret = false;
    for let field of ReflectStruct::<S>::members() {
        if field.is_secret() {
            has_secret = true;
        } else {
            if !wrote_field {
                write_struct_head::<S>(f);
                f.open_brace("{");
                wrote_field = true;
            }
            f.write_newline_indent();
            f.write_str(&field.name());
            f.write_str(": ");
            field.get_ref(v).inspect(f);
            f.write_str(",");
        }
    }
    if wrote_field {
        if has_secret {
            f.write_newline_indent();
            f.write_str("..");
        }
        f.close_brace("}");
        return;
    }
    write_struct_head::<S>(f);
    if has_secret {
        f.write_str("{ .. }");
        return;
    }
    f.write_str("{}");
}

/// The name a struct's debug form opens with, and the space after it. An
/// anonymous struct has none, so it reads as the literal that built it.
fn write_struct_head<affine S: Reflect>(f: &mut Formatter) {
    let name = Reflect::<S>::decl_name();
    if !name.is_empty() {
        f.write_str(&name);
        f.write_str(" ");
    }
}

impl<affine S: ReflectStruct<FieldTypes = [..F]>, affine ..F: Inspect> Inspect for S {
    fn inspect(&self, f: &mut Formatter) {
        if f.alternate {
            inspect_struct_alternate(self, f);
            return;
        }
        write_struct_head::<S>(f);
        let mut wrote_field = false;
        let mut has_secret = false;
        for let field of ReflectStruct::<S>::members() {
            if field.is_secret() {
                has_secret = true;
            } else {
                if wrote_field {
                    f.write_str(", ");
                } else {
                    f.write_str("{ ");
                    wrote_field = true;
                }
                f.write_str(&field.name());
                f.write_str(": ");
                field.get_ref(self).inspect(f);
            }
        }
        if wrote_field {
            if has_secret {
                f.write_str(", ..");
            }
            f.write_str(" }");
        } else if has_secret {
            f.write_str("{ .. }");
        } else {
            f.write_str("{}");
        }
    }
}

/// Enum debug formatting derived over `ReflectEnum` (WEP 2026-06-13): find the
/// live case and write `Name::Case`.
impl<E: ReflectEnum<Members = [..M]>, ..M> Inspect for E {
    fn inspect(&self, f: &mut Formatter) {
        for let case of ReflectEnum::<E>::members() {
            if case.holds(self) {
                f.write_str(&Reflect::<E>::decl_name());
                f.write_str("::");
                f.write_str(&case.name());
            }
        }
    }
}

/// A non-unit case's payload in parens; the alternate (`#`) form puts it on its
/// own indented line.
fn inspect_variant_payload<affine P: Inspect>(payload: &P, f: &mut Formatter) {
    if f.alternate {
        f.open_brace("(");
        f.write_newline_indent();
        payload.inspect(f);
        f.write_str(",");
        f.close_brace(")");
        return;
    }
    f.write_str("(");
    payload.inspect(f);
    f.write_str(")");
}

/// Variant debug formatting derived over `ReflectVariant` (WEP 2026-06-13):
/// write `Name::Case`, then the payload in parens unless the case is unit.
impl<affine V: ReflectVariant<CasePayloads = [..P]>, affine ..P: Inspect> Inspect for V {
    fn inspect(&self, f: &mut Formatter) {
        for let case of ReflectVariant::<V>::members() {
            if case.holds(self) {
                f.write_str(&Reflect::<V>::decl_name());
                f.write_str("::");
                f.write_str(&case.name());
                if !case.is_unit() {
                    inspect_variant_payload(case.extract_ref(self), f);
                }
            }
        }
    }
}

/// Flags debug formatting derived over `ReflectFlags` (WEP 2026-06-13): the set
/// bits joined by ` | `, or `Name::none()` when no bit is set.
impl<L: ReflectFlags<Members = [..M]>, ..M> Inspect for L {
    fn inspect(&self, f: &mut Formatter) {
        let mut wrote_bit = false;
        for let bit of ReflectFlags::<L>::members() {
            if bit.is_set(self) {
                if wrote_bit {
                    f.write_str(" | ");
                }
                f.write_str(&Reflect::<L>::decl_name());
                f.write_str("::");
                f.write_str(&bit.name());
                wrote_bit = true;
            }
        }
        if !wrote_bit {
            f.write_str(&Reflect::<L>::decl_name());
            f.write_str("::none()");
        }
    }
}

/// Newtype debug formatting derived over `ReflectNewtype` (WEP 2026-06-13): the
/// base's own rendering, tagged with the newtype's name. A newtype is a type
/// distinct from its base, so `Inspect` is the one derivation that says which
/// of the two it is looking at; every other kind's blanket holds for a newtype
/// only after peeling to that base, and rank 1 of WEP 2026-09-01 puts this one
/// first. A chain renders a link per instance: `7 as A as B`.
impl<affine N: ReflectNewtype<Base = B>, affine B: Inspect> Inspect for N {
    fn inspect(&self, f: &mut Formatter) {
        (self as &B).inspect(f);
        f.write_str(" as ");
        f.write_str(&Reflect::<N>::decl_name());
    }
}

/// Template debug formatting derived over `ReflectTemplate` (WEP 2026-01-10):
/// the template as written, its delimiters and text raw and each hole's value
/// inspected with its specifier. `==` compares the delimiters and the text, so
/// the form shows them.
impl<T: ReflectTemplate<Holes = [..V]>, affine ..V: Inspect> Inspect for T {
    fn inspect(&self, f: &mut Formatter) {
        let hashes = ReflectTemplate::<T>::hashes();
        f.write_char_n('#', hashes);
        f.write_char('`');
        for let h of ReflectTemplate::<T>::members() {
            f.write_str(h.raw(self));
            f.write_str("${");
            h.get_ref(self).inspect(f);
            if let Some(spec) = h.spec() {
                f.write_char(':');
                f.write_str(&spec);
            }
            f.write_char('}');
        }
        f.write_str(ReflectTemplate::<T>::raw_tail(self));
        f.write_char('`');
        f.write_char_n('#', hashes);
    }
}

/// Trait for formatting values as binary integers.
/// Used with the `${x:b}` format specifier.
#[compiler_item("binary")]
pub trait Binary with () {
    /// Formats the value as binary and writes to the given formatter.
    fn fmt_binary(&self, f: &mut Formatter);
}

/// Trait for formatting values as octal integers.
/// Used with the `${x:o}` format specifier.
#[compiler_item("octal")]
pub trait Octal with () {
    /// Formats the value as octal and writes to the given formatter.
    fn fmt_octal(&self, f: &mut Formatter);
}

/// Trait for formatting values as lowercase hexadecimal.
/// Used with the `${x:x}` format specifier.
#[compiler_item("lower_hex")]
pub trait LowerHex with () {
    /// Formats the value as lowercase hex and writes to the given formatter.
    fn fmt_lower_hex(&self, f: &mut Formatter);
}

/// Trait for formatting values as uppercase hexadecimal.
/// Used with the `${x:X}` format specifier.
#[compiler_item("upper_hex")]
pub trait UpperHex with () {
    /// Formats the value as uppercase hex and writes to the given formatter.
    fn fmt_upper_hex(&self, f: &mut Formatter);
}

/// Trait for formatting values in lowercase exponential notation.
/// Used with the `${x:e}` format specifier.
#[compiler_item("lower_exp")]
pub trait LowerExp with () {
    /// Formats the value in lowercase exponential notation and writes to the given formatter.
    fn fmt_lower_exp(&self, f: &mut Formatter);
}

/// Trait for formatting values in uppercase exponential notation.
/// Used with the `${x:E}` format specifier.
#[compiler_item("upper_exp")]
pub trait UpperExp with () {
    /// Formats the value in uppercase exponential notation and writes to the given formatter.
    fn fmt_upper_exp(&self, f: &mut Formatter);
}

/// Infallible conversion trait.
/// Implement this to define how to convert from type `T` into `Self`.
/// Usage: `TargetType::from(value)` — the target type is always explicit.
///
/// The compiler provides a reflexive blanket impl `From<T> for T` for all types.
#[compiler_item("from")]
pub affine trait From<affine T> with () {
    /// Converts a value of type `T` into `Self`.
    fn from(value: T) -> Self;
}

/// Fallible conversion trait. `Err: Error`, so a caller reaching the failure
/// through the bound can always report its reason.
pub affine trait TryFrom<affine T> with () {
    type Err: Error;

    /// Attempts to convert a value of type `T` into `Self`.
    fn try_from(value: T) -> Result<Self, Self::Err>;
}

/// Error type returned by fallible conversions.
pub struct ConvertError {
    pub message: String,
}

impl ConvertError {
    pub fn new(message: String) -> ConvertError {
        return ConvertError { message };
    }
}

impl Display for ConvertError {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(&self.message);
    }
}

impl Error for ConvertError {
}

/// `..base` inside a `{ … }` literal: merge `base` into `self`, last write
/// wins. A target without this impl rejects `..base` where it is written.
#[compiler_item("literal_spread")]
pub trait LiteralSpread with () {
    fn spread_literal(&mut self, base: Self);
}

/// Parse a value from text that may not denote one, where `From<String>` is
/// for text that always does. The parameter takes a `StrSlice` among the rest,
/// so a field is parsed out of a larger buffer with no substring allocation.
pub trait FromStr with () {
    type Err: Error;

    /// Parse the whole of any `AsStrSlice` text as `Self`.
    fn from_str<S: AsStrSlice>(s: S) -> Result<Self, Self::Err>;
}

/// Error returned by the lenient string parsers (`LenientFromStr`). All
/// built-in impls share this single type, carrying a short human-readable
/// reason. See `docs/wep-2026-06-22-lenient-from-str.md`.
pub struct LenientParseError {
    reason: String,
}

impl LenientParseError {
    pub fn new(reason: String) -> LenientParseError {
        return LenientParseError { reason };
    }

    /// A short description of why parsing failed.
    pub fn reason(&self) -> String {
        return self.reason;
    }
}

impl Display for LenientParseError {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(&self.reason);
    }
}

impl Error for LenientParseError {
}

/// Forgiving sibling of `FromStr`: parse a human-supplied string, accepting
/// the common spelling variations for the type (casing, radix prefixes,
/// digit separators, alternate boolean words). Leniency widens accepted
/// spellings only — an undenotable value still yields `Err`, and whitespace
/// is never trimmed (that is the caller's concern). See
/// `docs/wep-2026-06-22-lenient-from-str.md`.
pub trait LenientFromStr with () {
    type Err: Error;

    /// Parse the entire string as `Self`, accepting forgiving spellings.
    fn from_str_lenient<S: AsStrSlice>(s: S) -> Result<Self, Self::Err>;
}
