// Tests for From and TryFrom conversion traits.

// ── User-defined From ──────────────────────────────────────────────────────

struct Celsius {
    degrees: f64,
}

struct Fahrenheit {
    degrees: f64,
}

impl From<Celsius> for Fahrenheit {
    fn from(value: Celsius) -> Fahrenheit {
        return Fahrenheit { degrees: value.degrees * 9.0 / 5.0 + 32.0 };
    }
}

test "user-defined From" {
    let c = Celsius { degrees: 100.0 };
    let f = Fahrenheit::from(c);
    assert f.degrees == 212.0;
}

test "user-defined From: 0°C → 32°F" {
    let f = Fahrenheit::from(Celsius { degrees: 0.0 });
    assert f.degrees == 32.0;
}

// ── Reflexive From (identity) ──────────────────────────────────────────────

test "From<i32> for i32 is identity" {
    assert i32::from(42 as i32) == 42;
}

test "From<bool> for bool is identity" {
    assert bool::from(true) == true;
    assert bool::from(false) == false;
}

test "From<String> for String is identity" {
    let s = "hello";
    assert String::from(s) == "hello";
}

// ── Numeric widening From ──────────────────────────────────────────────────

test "From<i8> for i16" {
    assert i16::from(127 as i8) == 127 as i16;
    assert i16::from(-128 as i8) == -128 as i16;
}

test "From<i8> for i32" {
    assert i32::from(42 as i8) == 42;
    assert i32::from(-1 as i8) == -1;
}

test "From<i8> for i64" {
    assert i64::from(100 as i8) == 100 as i64;
}

test "From<i16> for i32" {
    assert i32::from(1000 as i16) == 1000;
}

test "From<i16> for i64" {
    assert i64::from(1000 as i16) == 1000 as i64;
}

test "From<i32> for i64" {
    assert i64::from(2147483647 as i32) == 2147483647 as i64;
    assert i64::from(-2147483648 as i32) == -2147483648 as i64;
}

test "From<u8> for u16" {
    assert u16::from(255 as u8) == 255 as u16;
}

test "From<u8> for u32" {
    assert u32::from(255 as u8) == 255 as u32;
}

test "From<u8> for u64" {
    assert u64::from(255 as u8) == 255 as u64;
}

test "From<u8> for i16" {
    assert i16::from(200 as u8) == 200 as i16;
}

test "From<u8> for i32" {
    assert i32::from(200 as u8) == 200;
}

test "From<u8> for i64" {
    assert i64::from(200 as u8) == 200 as i64;
}

test "From<u16> for u32" {
    assert u32::from(65535 as u16) == 65535 as u32;
}

test "From<u16> for u64" {
    assert u64::from(65535 as u16) == 65535 as u64;
}

test "From<u16> for i32" {
    assert i32::from(65535 as u16) == 65535;
}

test "From<u16> for i64" {
    assert i64::from(65535 as u16) == 65535 as i64;
}

test "From<u32> for u64" {
    assert u64::from(4294967295 as u32) == 4294967295 as u64;
}

test "From<u32> for i64" {
    assert i64::from(4294967295 as u32) == 4294967295 as i64;
}

test "From<f32> for f64" {
    let v = f64::from(1.0 as f32);
    assert v == 1.0;
}

// ── From<char> for String ──────────────────────────────────────────────────

test "From<char> for String: ASCII" {
    assert String::from('A') == "A";
    assert String::from('z') == "z";
    assert String::from('0') == "0";
}

test "From<char> for String: special chars" {
    assert String::from('\n') == "\n";
    assert String::from(' ') == " ";
}

// ── From<bool> for i32 ────────────────────────────────────────────────────

test "From<bool> for i32: true → 1" {
    assert i32::from(true) == 1;
}

test "From<bool> for i32: false → 0" {
    assert i32::from(false) == 0;
}

// ── User-defined TryFrom ──────────────────────────────────────────────────

struct EvenNumber {
    value: i32,
}

impl TryFrom<i32> for EvenNumber {
    type Error = String;
    fn try_from(value: i32) -> Result<EvenNumber, String> {
        if value % 2 != 0 {
            return Result::<EvenNumber, String>::Err(`{value} is not even`);
        }
        return Result::<EvenNumber, String>::Ok(EvenNumber { value });
    }
}

test "user-defined TryFrom: Ok" {
    assert EvenNumber::try_from(4) matches { Ok(n) && n.value == 4 };
    assert EvenNumber::try_from(0) matches { Ok(n) && n.value == 0 };
}

test "user-defined TryFrom: Err" {
    assert EvenNumber::try_from(3) matches { Err(_) };
    assert EvenNumber::try_from(-1) matches { Err(_) };
}

// ── Stdlib TryFrom: narrowing i64 → i32 ───────────────────────────────────

test "TryFrom<i64> for i32: in range" {
    assert i32::try_from(42 as i64) matches { Ok(n) && n == 42 };
    assert i32::try_from(2147483647 as i64) matches { Ok(n) && n == 2147483647 };
    assert i32::try_from(-2147483648 as i64) matches { Ok(n) && n == -2147483648 };
}

test "TryFrom<i64> for i32: out of range" {
    assert i32::try_from(2147483648 as i64) matches { Err(_) };
    assert i32::try_from(-2147483649 as i64) matches { Err(_) };
}

// ── Stdlib TryFrom: i32 → u32 ─────────────────────────────────────────────

test "TryFrom<i32> for u32: non-negative" {
    assert u32::try_from(0) matches { Ok(n) && n == 0 as u32 };
    assert u32::try_from(2147483647) matches { Ok(n) && n == 2147483647 as u32 };
}

test "TryFrom<i32> for u32: negative fails" {
    assert u32::try_from(-1) matches { Err(_) };
    assert u32::try_from(-100) matches { Err(_) };
}

// ── Variant auto-derive From ──────────────────────────────────────────────

struct NetworkError { code: i32 }
struct TimeoutError { seconds: i32 }

variant ServiceError {
    Network(NetworkError),
    Timeout(TimeoutError),
    Unknown(String),
}

impl From<NetworkError> for ServiceError;
impl From<TimeoutError> for ServiceError;
impl From<String> for ServiceError;

test "variant auto-derive From: wraps into correct case" {
    let ne = ServiceError::from(NetworkError { code: 404 });
    assert ne matches { Network(e) && e.code == 404 };

    let te = ServiceError::from(TimeoutError { seconds: 30 });
    assert te matches { Timeout(e) && e.seconds == 30 };

    let ue = ServiceError::from("unexpected");
    assert ue matches { Unknown(msg) && msg == "unexpected" };
}

// ── Newtype auto-generated From ────────────────────────────────────────────

type UserId = u64;
type ProductId = u64;

test "newtype From: base → newtype" {
    let id = UserId::from(42 as u64);
    assert id as u64 == 42 as u64;
}

test "newtype From: newtype → base" {
    let raw: UserId = 99 as UserId;
    let base = u64::from(raw);
    assert base == 99 as u64;
}

test "newtype From is type-safe: distinct newtypes do not convert" {
    let uid = UserId::from(1 as u64);
    // u64::from(uid) yields u64; can then build ProductId from that u64
    let pid = ProductId::from(u64::from(uid));
    assert pid as u64 == 1 as u64;
}

// ── JsonValue-like variant: From for ergonomic tree construction ───────────
//
// A common pattern: build a dynamically-typed tree (JSON, config, AST node)
// by converting native types via From rather than writing out constructor calls.

variant JsonLike {
    Null,
    Bool(bool),
    Number(f64),
    Str(String),
    Arr(Array<JsonLike>),
}

impl From<bool> for JsonLike {
    fn from(v: bool) -> JsonLike {
        return JsonLike::Bool(v);
    }
}

impl From<f64> for JsonLike {
    fn from(v: f64) -> JsonLike {
        return JsonLike::Number(v);
    }
}

impl From<i32> for JsonLike {
    fn from(v: i32) -> JsonLike {
        return JsonLike::Number(v as f64);
    }
}

impl From<String> for JsonLike {
    fn from(v: String) -> JsonLike {
        return JsonLike::Str(v);
    }
}

test "JsonLike: From<bool>" {
    assert JsonLike::from(true) matches { Bool(b) && b };
    assert JsonLike::from(false) matches { Bool(b) && !b };
}

test "JsonLike: From<f64>" {
    assert JsonLike::from(3.14) matches { Number(n) && n == 3.14 };
    assert JsonLike::from(0.0) matches { Number(n) && n == 0.0 };
}

test "JsonLike: From<i32> widens to f64" {
    assert JsonLike::from(42) matches { Number(n) && n == 42.0 };
    assert JsonLike::from(-1) matches { Number(n) && n == -1.0 };
}

test "JsonLike: From<String>" {
    assert JsonLike::from("hello") matches { Str(s) && s == "hello" };
    assert JsonLike::from("") matches { Str(s) && s == "" };
}

test "JsonLike: building a mixed array via From" {
    let mut items: Array<JsonLike> = [];
    items.append(JsonLike::from(1));
    items.append(JsonLike::from(true));
    items.append(JsonLike::from("ok"));
    let arr = JsonLike::Arr(items);
    assert arr matches { Arr(a) && a.len() == 3 };
}

// ── enum: TryFrom<i32> for discriminant parsing ────────────────────────────
//
// Realistic use case: decode a network protocol enum from its wire integer,
// returning Err for unknown values rather than panicking.

enum Direction {
    North,
    East,
    South,
    West,
}

impl TryFrom<i32> for Direction {
    type Error = String;
    fn try_from(value: i32) -> Result<Direction, String> {
        return match value {
            0 => Result::<Direction, String>::Ok(Direction::North),
            1 => Result::<Direction, String>::Ok(Direction::East),
            2 => Result::<Direction, String>::Ok(Direction::South),
            3 => Result::<Direction, String>::Ok(Direction::West),
            _ => Result::<Direction, String>::Err(`unknown direction code: {value}`),
        };
    }
}

impl From<Direction> for i32 {
    fn from(d: Direction) -> i32 {
        return d as i32;
    }
}

test "enum TryFrom<i32>: valid discriminants" {
    assert Direction::try_from(0) matches { Ok(North) };
    assert Direction::try_from(1) matches { Ok(East) };
    assert Direction::try_from(2) matches { Ok(South) };
    assert Direction::try_from(3) matches { Ok(West) };
}

test "enum TryFrom<i32>: invalid discriminant" {
    assert Direction::try_from(4) matches { Err(_) };
    assert Direction::try_from(-1) matches { Err(_) };
    assert Direction::try_from(100) matches { Err(e) && e == "unknown direction code: 100" };
}

test "enum From<Direction> for i32: discriminant round-trip" {
    assert i32::from(Direction::North) == 0;
    assert i32::from(Direction::East) == 1;
    assert i32::from(Direction::South) == 2;
    assert i32::from(Direction::West) == 3;
}

test "enum TryFrom + From: round-trip" {
    let d = Direction::try_from(2).unwrap();
    assert i32::from(d) == 2;
}

// ── flags: From / TryFrom with u32 ────────────────────────────────────────
//
// Realistic use case: serialize flags to wire format (u32) and parse them
// back with validation, rejecting bit patterns that set undefined bits.

flags AccessFlags {
    Read,
    Write,
    Execute,
}

impl From<AccessFlags> for u32 {
    fn from(f: AccessFlags) -> u32 {
        return f as u32;
    }
}

impl TryFrom<u32> for AccessFlags {
    type Error = String;
    fn try_from(value: u32) -> Result<AccessFlags, String> {
        // Only bits 0–2 are defined; reject anything with higher bits set
        if value > 7 as u32 {
            return Result::<AccessFlags, String>::Err(`invalid flags: {value as i32}`);
        }
        return Result::<AccessFlags, String>::Ok(value as AccessFlags);
    }
}

test "flags From<AccessFlags> for u32: individual bits" {
    assert u32::from(AccessFlags::Read) == 1 as u32;
    assert u32::from(AccessFlags::Write) == 2 as u32;
    assert u32::from(AccessFlags::Execute) == 4 as u32;
}

test "flags From<AccessFlags> for u32: combined and edge values" {
    assert u32::from(AccessFlags::Read | AccessFlags::Write) == 3 as u32;
    assert u32::from(AccessFlags::all()) == 7 as u32;
    assert u32::from(AccessFlags::none()) == 0 as u32;
}

test "flags TryFrom<u32> for AccessFlags: valid bit patterns" {
    assert AccessFlags::try_from(0 as u32) matches { Ok(f) && f == AccessFlags::none() };
    assert AccessFlags::try_from(1 as u32) matches { Ok(f) && f == AccessFlags::Read };
    assert AccessFlags::try_from(7 as u32) matches { Ok(f) && f == AccessFlags::all() };
}

test "flags TryFrom<u32> for AccessFlags: invalid bit patterns" {
    assert AccessFlags::try_from(8 as u32) matches { Err(_) };
    assert AccessFlags::try_from(255 as u32) matches { Err(_) };
}

test "flags From + TryFrom: serialization round-trip" {
    let original = AccessFlags::Read | AccessFlags::Execute;
    let wire = u32::from(original);
    let restored = AccessFlags::try_from(wire).unwrap();
    assert restored == original;
}

// ── i128 / u128: widening From and narrowing TryFrom ──────────────────────
//
// Realistic use case: accumulating small integers into a 128-bit counter for
// overflow-safe summation, then safely extracting the result back.

test "From<u64> for u128: widening is lossless" {
    let small = 42 as u64;
    let wide = u128::from(small);
    assert wide == 42 as u128;
}

test "From<u64> for u128: max u64 value fits" {
    let max_u64 = u64::MAX;
    let wide = u128::from(max_u64);
    assert wide == u64::MAX as u128;
}

test "From<i64> for i128: widening preserves sign" {
    assert i128::from(100 as i64) == 100 as i128;
    assert i128::from(-100 as i64) == -100 as i128;
    assert i128::from(i64::MIN) == i64::MIN as i128;
    assert i128::from(i64::MAX) == i64::MAX as i128;
}

test "TryFrom<u128> for u64: in range" {
    assert u64::try_from(0 as u128) matches { Ok(n) && n == 0 as u64 };
    assert u64::try_from(42 as u128) matches { Ok(n) && n == 42 as u64 };
    assert u64::try_from(u64::MAX as u128) matches { Ok(n) && n == u64::MAX };
}

test "TryFrom<u128> for u64: out of range" {
    // u64::MAX + 1 as u128
    let too_big = u64::MAX as u128 + 1 as u128;
    assert u64::try_from(too_big) matches { Err(_) };
}

test "TryFrom<i128> for i64: in range" {
    assert i64::try_from(0 as i128) matches { Ok(n) && n == 0 as i64 };
    assert i64::try_from(i64::MAX as i128) matches { Ok(n) && n == i64::MAX };
    assert i64::try_from(i64::MIN as i128) matches { Ok(n) && n == i64::MIN };
}

test "TryFrom<i128> for i64: out of range" {
    let too_big: i128 = i64::MAX as i128 + 1 as i128;
    assert i64::try_from(too_big) matches { Err(_) };
    let too_small: i128 = i64::MIN as i128 - 1 as i128;
    assert i64::try_from(too_small) matches { Err(_) };
}

// ── Integer-to-float TryFrom: lossless precision check ────────────────────
//
// f32 has a 24-bit mantissa: integers outside (-2^24, 2^24) may be rounded.
// f64 has a 53-bit mantissa: integers outside (-2^53, 2^53) may be rounded.
//
// TryFrom succeeds iff `(value as float) as integer == value`.
// This is the same contract as Rust's experimental exact_size_is_power_of_two,
// and mirrors what a "lossless cast" library would provide.

test "TryFrom<i64> for f64: small values are exact" {
    assert f64::try_from(0 as i64) matches { Ok(n) && n == 0.0 };
    assert f64::try_from(1 as i64) matches { Ok(n) && n == 1.0 };
    assert f64::try_from(-1 as i64) matches { Ok(n) && n == -1.0 };
    assert f64::try_from(1_000_000 as i64) matches { Ok(n) && n == 1_000_000.0 };
}

test "TryFrom<i64> for f64: boundary at ±2^53" {
    // 2^53 = 9_007_199_254_740_992: last integer exactly representable in f64
    assert f64::try_from(9_007_199_254_740_992 as i64) matches { Ok(n) && n == 9_007_199_254_740_992.0 };
    assert f64::try_from(-9_007_199_254_740_992 as i64) matches { Ok(n) && n == -9_007_199_254_740_992.0 };
    // 2^53 + 1: rounds to 2^53 when cast to f64 → roundtrip fails → Err
    assert f64::try_from(9_007_199_254_740_993 as i64) matches { Err(_) };
    assert f64::try_from(-9_007_199_254_740_993 as i64) matches { Err(_) };
}

test "TryFrom<i64> for f32: boundary at ±2^24" {
    // 2^24 = 16_777_216: last integer exactly representable in f32
    assert f32::try_from(16_777_216 as i64) matches { Ok(n) && n == 16_777_216.0 as f32 };
    assert f32::try_from(-16_777_216 as i64) matches { Ok(n) && n == -16_777_216.0 as f32 };
    // 2^24 + 1: rounds to 2^24 when cast to f32 → roundtrip fails → Err
    assert f32::try_from(16_777_217 as i64) matches { Err(_) };
    assert f32::try_from(-16_777_217 as i64) matches { Err(_) };
}

test "TryFrom<u64> for f64: boundary at 2^53" {
    assert f64::try_from(9_007_199_254_740_992 as u64) matches { Ok(n) && n == 9_007_199_254_740_992.0 };
    assert f64::try_from(9_007_199_254_740_993 as u64) matches { Err(_) };
    assert f64::try_from(u64::MAX) matches { Err(_) };
}

test "TryFrom<u64> for f32: boundary at 2^24" {
    assert f32::try_from(0 as u64) matches { Ok(n) && n == 0.0 as f32 };
    assert f32::try_from(16_777_216 as u64) matches { Ok(n) && n == 16_777_216.0 as f32 };
    assert f32::try_from(16_777_217 as u64) matches { Err(_) };
}

test "TryFrom<i128> for f64: boundary at ±2^53" {
    assert f64::try_from(9_007_199_254_740_992 as i128) matches { Ok(n) && n == 9_007_199_254_740_992.0 };
    assert f64::try_from(-9_007_199_254_740_992 as i128) matches { Ok(n) && n == -9_007_199_254_740_992.0 };
    assert f64::try_from(9_007_199_254_740_993 as i128) matches { Err(_) };
    // Far out of range: large i128 values are nowhere near exact
    assert f64::try_from(i64::MAX as i128 + 1 as i128) matches { Err(_) };
}

test "TryFrom<i128> for f32: boundary at ±2^24" {
    assert f32::try_from(16_777_216 as i128) matches { Ok(n) && n == 16_777_216.0 as f32 };
    assert f32::try_from(-16_777_216 as i128) matches { Ok(n) && n == -16_777_216.0 as f32 };
    assert f32::try_from(16_777_217 as i128) matches { Err(_) };
}

test "TryFrom<u128> for f64: boundary at 2^53" {
    assert f64::try_from(9_007_199_254_740_992 as u128) matches { Ok(n) && n == 9_007_199_254_740_992.0 };
    assert f64::try_from(9_007_199_254_740_993 as u128) matches { Err(_) };
}

test "TryFrom<u128> for f32: boundary at 2^24" {
    assert f32::try_from(16_777_216 as u128) matches { Ok(n) && n == 16_777_216.0 as f32 };
    assert f32::try_from(16_777_217 as u128) matches { Err(_) };
}

test "int-to-float TryFrom: illustrate the precision loss semantics" {
    // 2^53 + 1 cast to f64 silently rounds to 2^53; TryFrom surfaces this.
    let lossy = 9_007_199_254_740_993 as i64 as f64;
    assert lossy == 9_007_199_254_740_992.0;          // silent rounding with `as`
    assert f64::try_from(9_007_199_254_740_993 as i64) matches { Err(_) };  // TryFrom rejects it
}

test "u128 accumulation round-trip via From / TryFrom" {
    // Sum 1000 × u32::MAX safely in u128, then recover the u64 partial sum
    let chunk = u32::MAX as u64;
    let mut acc = 0 as u128;
    let mut i = 0;
    while i < 4 {
        acc = acc + u128::from(chunk);
        i += 1;
    }
    // 4 × (2^32 - 1) = 4 × 4294967295 = 17179869180, which fits in u64
    assert u64::try_from(acc) matches { Ok(n) && n == 17179869180 as u64 };
}
