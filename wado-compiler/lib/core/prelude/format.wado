#![no_prelude]
#![stdlib("core:prelude/format.wado")]
// Format Infrastructure
//
// This module defines the Formatter and Alignment types that
// back template string format specifiers (`{x:spec}`).
//
// See WEP: Format Traits (wep-2026-02-01-format-traits.md)


use { Display, DisplayAlt, Inspect, InspectAlt } from "core:prelude/traits.wado";
/// Text alignment for padding.
pub enum Alignment {
    /// Left-aligned: `{x:<5}` -> "42   "
    Left,
    /// Center-aligned: `{x:^5}` -> " 42  "
    Center,
    /// Right-aligned (default for numbers): `{x:>5}` -> "   42"
    Right,
}
/// Formatter that writes directly into a referenced output buffer.
/// The Formatter does not own its buffer; it writes into the caller's `&mut String`.
/// This avoids intermediate allocations.
///
/// Format specification fields match Rust's format syntax:
/// `[[fill]align][sign][#][0][width][.precision]type`
///
/// Width and precision use -1 as sentinel for "not specified".
pub struct Formatter {
    /// Fill character for padding (default: ' ')
    pub fill: char,
    /// Text alignment mode
    pub align: Alignment,
    /// Whether to always show `+` sign for positive numbers
    pub sign_plus: bool,
    /// Whether to use zero-padding (`0` flag)
    pub zero_pad: bool,
    /// Minimum field width (-1 = no minimum)
    pub width: i32,
    /// Precision for floats (decimal places) or strings (max width) (-1 = default)
    pub precision: i32,
    /// Current indentation level for pretty-printing (used by InspectAlt)
    pub indent: i32,
    /// Reference to the output buffer
    pub buf: &mut String,
}

impl Formatter {
    /// Create a new Formatter with default format spec that writes into the given buffer.
    pub fn new(buf: &mut String) -> Formatter with stores[buf] {
        return Formatter {
            fill: ' ',
            align: Alignment::Right,
            sign_plus: false,
            zero_pad: false,
            width: -1,
            precision: -1,
            indent: 0,
            buf,
        };
    }

    /// Write a string to the output buffer.
    pub fn write_str(&mut self, s: &String) {
        self.buf.push_str(s);
    }

    /// Write a single character to the output buffer.
    pub fn write_char(&mut self, c: char) {
        self.buf.push(c);
    }

    /// Write `n` copies of a character to the output buffer.
    pub fn write_char_n(&mut self, c: char, n: i32) {
        for let mut i = 0; i < n; i += 1 {
            self.buf.push(c);
        }
    }

    /// Pad a pre-formatted content string to the configured width.
    /// If no width is set or content is already at least as wide, writes content as-is.
    pub fn pad(&mut self, content: String) {
        let content_len = content.len();
        if self.width <= 0 || content_len >= self.width {
            self.buf.push_str(&content);
            return;
        }
        let padding = self.width - content_len;
        let align = self.align;
        if align matches { Left } {
            self.buf.push_str(&content);
            self.write_char_n(self.fill, padding);
        } else if align matches { Center } {
            let left_pad = padding / 2;
            let right_pad = padding - left_pad;
            self.write_char_n(self.fill, left_pad);
            self.buf.push_str(&content);
            self.write_char_n(self.fill, right_pad);
        } else {
            // Right (default)
            self.write_char_n(self.fill, padding);
            self.buf.push_str(&content);
        }
    }

    /// Return the current byte position in the output buffer.
    /// Used with `apply_padding` for the speculative-write pattern:
    /// 1. Call `mark()` to record the start position
    /// 2. Write content directly to `buf_mut()`
    /// 3. Call `apply_padding(mark)` to insert padding if needed
    pub fn mark(&self) -> i32 {
        return self.buf.len();
    }

    /// Apply width/alignment padding to content already written at `start_pos`.
    /// Content bytes in `buf[start_pos..]` are shifted in-place if padding is needed.
    /// The fill character must be ASCII (single byte); non-ASCII fill is not supported.
    pub fn apply_padding(&mut self, start_pos: i32) {
        let content_len = self.buf.len() - start_pos;
        if self.width <= 0 || content_len >= self.width {
            return;
        }
        let padding = self.width - content_len;
        let fill_byte = self.fill as u8;
        let align = self.align;
        if align matches { Left } {
            self.buf.append_byte_filled(fill_byte, padding);
        } else if align matches { Center } {
            let left_pad = padding / 2;
            let right_pad = padding - left_pad;
            // Extend buffer, shift content right, fill left
            self.buf.append_byte_filled(fill_byte, left_pad);
            let mut i = content_len - 1;
            while i >= 0 {
                self.buf.set_byte_unchecked(start_pos + left_pad + i, self.buf.get_byte_unchecked(start_pos + i));
                i = i - 1;
            }
            for let mut j = 0; j < left_pad; j += 1 {
                self.buf.set_byte_unchecked(start_pos + j, fill_byte);
            }
            self.buf.append_byte_filled(fill_byte, right_pad);
        } else {
            // Right (default): extend buffer, shift content right, fill left
            self.buf.append_byte_filled(fill_byte, padding);
            let mut i = content_len - 1;
            while i >= 0 {
                self.buf.set_byte_unchecked(start_pos + padding + i, self.buf.get_byte_unchecked(start_pos + i));
                i = i - 1;
            }
            for let mut j = 0; j < padding; j += 1 {
                self.buf.set_byte_unchecked(start_pos + j, fill_byte);
            }
        }
    }

    /// Write raw bytes from linear memory, applying width/alignment padding.
    /// Used only for values produced by bundled Wasm functions (e.g., f64_to_buffer).
    pub fn write_from_memory(&mut self, ptr: i32, len: i32) {
        if self.width <= 0 || len >= self.width {
            self.buf.internal_append_from_memory(ptr, len);
            return;
        }
        // Padding needed — create temporary string for alignment
        let arr: builtin::array<u8> = builtin::array_new(len);
        for let mut i = 0; i < len; i += 1 {
            builtin::array_set_u8(arr, i, builtin::i32_load8_u(ptr + i));
        }
        let s = String::internal_from_utf8_raw(arr, len);
        self.pad(s);
    }

    /// Prepare the output buffer for integer digits.
    ///
    /// Writes sign, prefix, and any padding/fill, then reserves `digit_count`
    /// uninitialised bytes and returns their byte-offset inside `buf`.
    /// The caller **must** fill exactly `digit_count` bytes (backwards) via
    /// `buf.internal_raw_bytes()` at the returned offset.
    pub fn prepare_int_write(&mut self, is_negative: bool, prefix: String, digit_count: i32) -> i32 {
        let mut sign = "";
        if is_negative {
            sign = "-";
        } else if self.sign_plus {
            sign = "+";
        }

        let sign_len = sign.len();
        let prefix_len = prefix.len();
        let content_len = sign_len + prefix_len + digit_count;

        if self.width <= 0 || content_len >= self.width {
            // No padding — write sign/prefix, reserve digit area
            if sign_len > 0 {
                self.buf.push_str(&sign);
            }
            if prefix_len > 0 {
                self.buf.push_str(&prefix);
            }
            return self.buf.internal_reserve_uninit(digit_count);
        }

        let padding = self.width - content_len;

        if self.zero_pad {
            // sign + prefix + zeros + [digits]
            if sign_len > 0 {
                self.buf.push_str(&sign);
            }
            if prefix_len > 0 {
                self.buf.push_str(&prefix);
            }
            self.write_char_n('0', padding);
            return self.buf.internal_reserve_uninit(digit_count);
        }

        let align = self.align;
        if align matches { Left } {
            // [sign prefix digits] [fill...]
            if sign_len > 0 {
                self.buf.push_str(&sign);
            }
            if prefix_len > 0 {
                self.buf.push_str(&prefix);
            }
            let offset = self.buf.internal_reserve_uninit(digit_count);
            self.write_char_n(self.fill, padding);
            return offset;
        } else if align matches { Center } {
            // [fill...] [sign prefix digits] [fill...]
            let left_pad = padding / 2;
            let right_pad = padding - left_pad;
            self.write_char_n(self.fill, left_pad);
            if sign_len > 0 {
                self.buf.push_str(&sign);
            }
            if prefix_len > 0 {
                self.buf.push_str(&prefix);
            }
            let offset = self.buf.internal_reserve_uninit(digit_count);
            self.write_char_n(self.fill, right_pad);
            return offset;
        } else {
            // Right: [fill...] [sign prefix digits]
            self.write_char_n(self.fill, padding);
            if sign_len > 0 {
                self.buf.push_str(&sign);
            }
            if prefix_len > 0 {
                self.buf.push_str(&prefix);
            }
            return self.buf.internal_reserve_uninit(digit_count);
        }
    }

    /// Write indentation (2 spaces per level) for pretty-printing.
    pub fn write_indent(&mut self) {
        for let mut i = 0; i < self.indent; i += 1 {
            self.write_str(&"  ");
        }
    }

    /// Write a newline followed by indentation for pretty-printing.
    pub fn write_newline_indent(&mut self) {
        self.write_char('\n');
        self.write_indent();
    }

    /// Open a pretty-printed brace: write opening delimiter, increase indent.
    pub fn open_brace(&mut self, open: String) {
        self.write_str(&open);
        self.indent += 1;
    }

    /// Close a pretty-printed brace: decrease indent, write newline+indent, write closing delimiter.
    pub fn close_brace(&mut self, close: String) {
        self.indent -= 1;
        self.write_newline_indent();
        self.write_str(&close);
    }
}
// Defined here (not in string.wado) to avoid string.wado depending on format.wado,
// which would cause codegen struct registration order issues.

impl Display for String {
    pub fn fmt(&self, f: &mut Formatter) {
        f.pad(*self);
    }
}

impl Inspect for String {
    pub fn inspect(&self, f: &mut Formatter) {
        f.write_char('"');
        for let c of (*self).chars() {
            if c == '"' {
                f.write_char('\\');
                f.write_char('"');
            } else if c == '\\' {
                f.write_char('\\');
                f.write_char('\\');
            } else if c == '\n' {
                f.write_char('\\');
                f.write_char('n');
            } else if c == '\r' {
                f.write_char('\\');
                f.write_char('r');
            } else if c == '\t' {
                f.write_char('\\');
                f.write_char('t');
            } else {
                f.write_char(c);
            }
        }
        f.write_char('"');
    }
}

impl<T: Inspect> Inspect for Array<T> {
    pub fn inspect(&self, f: &mut Formatter) {
        f.write_char('[');
        for let mut i = 0; i < self.len(); i += 1 {
            if i > 0 {
                f.write_str(&", ");
            }
            self[i].inspect(f);
        }
        f.write_char(']');
    }
}

impl<T: Inspect> Display for Array<T> {
    pub fn fmt(&self, f: &mut Formatter) {
        self.inspect(f);
    }
}

impl<T: Inspect> Inspect for &T {
    pub fn inspect(&self, f: &mut Formatter) {
        f.write_str(&"&");
        let inner: &T = *self;
        (*inner).inspect(f);
    }
}

impl<T: Inspect> Inspect for &mut T {
    pub fn inspect(&mut self, f: &mut Formatter) {
        f.write_str(&"&mut ");
        let inner: &mut T = *self;
        (*inner).inspect(f);
    }
}

impl InspectAlt for String {
    pub fn inspect_alt(&self, f: &mut Formatter) {
        self.inspect(f);
    }
}

impl<T: InspectAlt> InspectAlt for Array<T> {
    pub fn inspect_alt(&self, f: &mut Formatter) {
        if self.is_empty() {
            f.write_str(&"[]");
            return;
        }
        f.open_brace("[");
        for let mut i = 0; i < self.len(); i += 1 {
            f.write_newline_indent();
            self[i].inspect_alt(f);
            f.write_char(',');
        }
        f.close_brace("]");
    }
}

impl<T: InspectAlt> DisplayAlt for Array<T> {
    pub fn fmt_alt(&self, f: &mut Formatter) {
        self.inspect_alt(f);
    }
}

impl<T: InspectAlt> InspectAlt for &T {
    pub fn inspect_alt(&self, f: &mut Formatter) {
        f.write_str(&"&");
        let inner: &T = *self;
        (*inner).inspect_alt(f);
    }
}

impl<T: InspectAlt> InspectAlt for &mut T {
    pub fn inspect_alt(&mut self, f: &mut Formatter) {
        f.write_str(&"&mut ");
        let inner: &mut T = *self;
        (*inner).inspect_alt(f);
    }
}
