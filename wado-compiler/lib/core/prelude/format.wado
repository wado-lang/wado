#![no_prelude]
#![stdlib("core:prelude/format.wado")]
// Format Infrastructure
//
// This module defines the Formatter and Alignment types that
// back template string format specifiers (`${x:spec}`).
//
// See WEP: Format Traits (wep-2026-02-01-format-traits.md)

use { Display, Inspect } from "core:prelude/traits.wado";
use { String, StrCharIter } from "core:prelude/string.wado";
use { Option } from "core:prelude/types.wado";
use { unreachable } from "core:rt";

/// Bytes the leading sign occupies in the `len` bytes at `at` — where zero
/// padding starts, so `-42` pads to `-0042` and not `00-42`.
fn leading_sign_byte_len(s: &String, at: i32, len: i32) -> i32 {
    if len == 0 {
        return 0;
    }
    let first = s.get_byte_unchecked(at);
    if first == b'-' || first == b'+' {
        return 1;
    }
    return 0;
}

/// Text alignment for padding.
#[compiler_item("alignment")]
pub enum Alignment {
    /// Left-aligned: `${x:<5}` -> "42   "
    #[compiler_item("alignment_left")]
    Left,
    /// Center-aligned: `${x:^5}` -> " 42  "
    #[compiler_item("alignment_center")]
    Center,
    /// Right-aligned (default for numbers): `${x:>5}` -> "   42"
    #[compiler_item("alignment_right")]
    Right,
}
/// Formatter that writes directly into a referenced output buffer.
/// The Formatter does not own its buffer; it writes into the caller's `&mut String`.
/// This avoids intermediate allocations.
///
/// Format specification fields match Rust's format syntax:
/// `[[fill]align][sign][#][0][width][.precision]type`
///
/// Unset width and precision use the sentinels on `impl Formatter`.
#[compiler_item("formatter")]
pub struct Formatter {
    /// Fill character for padding (default: ' ')
    pub fill: char,
    /// Text alignment mode
    pub align: Alignment,
    /// Whether to always show `+` sign for positive numbers
    pub sign_plus: bool,
    /// Whether the spec asked for the alternate form (`#` flag): a radix
    /// prefix, or the indented multi-line `Inspect`.
    pub alternate: bool,
    /// Whether to use zero-padding (`0` flag)
    pub zero_pad: bool,
    /// Minimum field width in characters; `NO_WIDTH` for none
    pub width: i32,
    /// Decimal places for floats; max rendered length for sequences (chars /
    /// elements). Negative values are the sentinels below.
    pub precision: i32,
    /// Current indentation level for the alternate (`#`) `Inspect`
    pub indent: i32,
    /// Reference to the output buffer
    pub buf: &mut String,
}

// `synthesis::template` writes `Formatter` literals directly rather than
// calling `Formatter::new`, so it repeats these sentinels as
// `compiler_item::FormatterField`'s constants. The e2e fixture
// `template_formatter_sentinels.wado` fails if the copies drift.
impl Formatter {
    /// No width given: every padding path is a no-op.
    pub const NO_WIDTH: i32 = -1;
    /// No precision given: sequence Inspect uses `DEFAULT_SEQ_LIMIT`, others ignore.
    pub const PRECISION_DEFAULT: i32 = -2;
    /// Render uncapped: sequence Inspect skips truncation.
    pub const PRECISION_INFINITE: i32 = -1;
    /// Default sequence Inspect cap: chars for `String`, elements for `List`.
    pub const DEFAULT_SEQ_LIMIT: i32 = 256;

    /// The element/char cap a sequence Inspect should apply: the explicit
    /// precision when given, else `DEFAULT_SEQ_LIMIT`. A negative result
    /// (`PRECISION_INFINITE`) means uncapped.
    pub fn resolved_seq_limit(&self) -> i32 {
        if self.precision == Formatter::PRECISION_DEFAULT {
            return Formatter::DEFAULT_SEQ_LIMIT;
        }
        return self.precision;
    }

    /// Create a Formatter with the default spec, writing into the given buffer.
    #[compiler_item("formatter_new")]
    pub fn new(buf: &mut String) -> Formatter with stores[buf] {
        return Formatter {
            fill: ' ',
            align: Alignment::Right,
            sign_plus: false,
            alternate: false,
            zero_pad: false,
            width: Formatter::NO_WIDTH,
            precision: Formatter::PRECISION_DEFAULT,
            indent: 0,
            buf,
        };
    }

    /// Write a string to the output buffer.
    pub fn write_str(&mut self, s: &String) {
        self.buf.push_str(s);
    }

    /// Write a single character to the output buffer.
    pub fn write_char(&mut self, c: char) {
        self.buf.push(c);
    }

    /// Write `n` copies of a character to the output buffer.
    pub fn write_char_n(&mut self, c: char, n: i32) {
        for let mut i = 0; i < n; i += 1 {
            self.buf.push(c);
        }
    }

    /// Pad a pre-formatted content string to the configured width.
    /// If no width is set or content is already as wide, writes content as-is.
    /// Width counts characters, so a multi-byte content pads by what it renders.
    pub fn pad(&mut self, content: String) {
        if self.width <= 0 {
            self.buf.push_str(&content);
            return;
        }
        let content_len = content.chars().count();
        if content_len >= self.width {
            self.buf.push_str(&content);
            return;
        }
        let padding = self.width - content_len;
        if self.zero_pad {
            // Zero padding goes after the sign, so the value reads as one
            // figure: `-0000042`, never `0000-42`.
            let sign_len = leading_sign_byte_len(&content, 0, content.len());
            self.buf.push_str_range_unchecked(&content, 0, sign_len);
            self.write_char_n('0', padding);
            self.buf.push_str_range_unchecked(&content, sign_len, content.len());
            return;
        }
        let align = self.align;
        if align matches { Left } {
            self.buf.push_str(&content);
            self.write_char_n(self.fill, padding);
        } else if align matches { Center } {
            let left_pad = padding / 2;
            let right_pad = padding - left_pad;
            self.write_char_n(self.fill, left_pad);
            self.buf.push_str(&content);
            self.write_char_n(self.fill, right_pad);
        } else {
            // Right (default)
            self.write_char_n(self.fill, padding);
            self.buf.push_str(&content);
        }
    }

    /// Return the current byte position in the output buffer.
    /// Used with `apply_padding` for the speculative-write pattern:
    /// 1. Call `mark()` to record the start position
    /// 2. Write content directly to `buf_mut()`
    /// 3. Call `apply_padding(mark)` to insert padding if needed
    pub fn mark(&self) -> i32 {
        return self.buf.len();
    }

    /// Apply width/alignment padding to content already written at `start_pos`.
    /// Content bytes in `buf[start_pos..]` are shifted in-place if padding is needed.
    pub fn apply_padding(&mut self, start_pos: i32) {
        // No width set is the default and covers every JSON/CBOR/plain `${x}`
        // value, so this wrapper stays tiny and inlines to one field compare.
        // When a width IS set the slow path runs every time — it is not a cold
        // branch — so the padding logic is merely kept out-of-line via
        // `#[inline(never)]` rather than hinted cold.
        if self.width > 0 {
            self.apply_padding_slow(start_pos);
        }
    }

    #[inline(never)]
    fn apply_padding_slow(&mut self, start_pos: i32) {
        let content_bytes = self.buf.len() - start_pos;
        let content_len = self.count_chars_from(start_pos);
        if content_len >= self.width {
            return;
        }
        let padding = self.width - content_len;
        if self.zero_pad {
            // Zero padding goes after the sign, so the value reads as one
            // figure: `-0000042`, never `0000-42`.
            let sign_len = leading_sign_byte_len(self.buf, start_pos, content_bytes);
            let at = start_pos + sign_len;
            self.shift_right(at, content_bytes - sign_len, padding);
            self.write_fill_at(at, padding, '0');
            return;
        }
        let align = self.align;
        let fill = self.fill;
        if align matches { Left } {
            self.write_char_n(fill, padding);
        } else if align matches { Center } {
            let left_pad = padding / 2;
            let right_pad = padding - left_pad;
            self.shift_right(start_pos, content_bytes, left_pad * fill.len_utf8());
            self.write_fill_at(start_pos, left_pad, fill);
            self.write_char_n(fill, right_pad);
        } else {
            // Right (default)
            self.shift_right(start_pos, content_bytes, padding * fill.len_utf8());
            self.write_fill_at(start_pos, padding, fill);
        }
    }

    /// Characters — not bytes — in `buf[start_pos..]`: every byte that is not a
    /// UTF-8 continuation byte starts one.
    fn count_chars_from(&self, start_pos: i32) -> i32 {
        let end = self.buf.len();
        let mut count = 0;
        for let mut i = start_pos; i < end; i += 1 {
            if self.buf.get_byte_unchecked(i) & 0xc0 != 0x80 {
                count += 1;
            }
        }
        return count;
    }

    /// Open a `gap`-byte hole at `start_pos` by extending the buffer and
    /// shifting the `content_bytes` bytes there to the right. The hole holds
    /// whatever the extension left behind until `write_fill_at` fills it.
    fn shift_right(&mut self, start_pos: i32, content_bytes: i32, gap: i32) {
        self.buf.append_byte_filled(0, gap);
        let mut i = content_bytes - 1;
        while i >= 0 {
            self.buf.set_byte_unchecked(start_pos + gap + i, self.buf.get_byte_unchecked(start_pos + i));
            i = i - 1;
        }
    }

    /// Write `n` copies of `c` into the hole `shift_right` opened at `at`.
    fn write_fill_at(&mut self, at: i32, n: i32, c: char) {
        let fill_len = c.len_utf8();
        if fill_len == 1 {
            let fill_byte = c as u8;
            for let mut j = 0; j < n; j += 1 {
                self.buf.set_byte_unchecked(at + j, fill_byte);
            }
            return;
        }
        let mut encoded = String::with_capacity(4);
        encoded.push(c);
        for let mut j = 0; j < n; j += 1 {
            for let mut k = 0; k < fill_len; k += 1 {
                self.buf.set_byte_unchecked(at + j * fill_len + k, encoded.get_byte_unchecked(k));
            }
        }
    }

    /// Write raw bytes from linear memory, applying width/alignment padding.
    /// Used only for values produced by bundled Wasm functions (e.g., f64_to_buffer).
    pub fn write_from_memory(&mut self, ptr: i32, len: i32) {
        if self.width <= 0 || len >= self.width {
            self.buf.internal_append_from_memory(ptr, len);
            return;
        }
        // Padding needed — create temporary string for alignment
        let mut arr: Array<u8> = builtin::array_new(len);
        for let mut i = 0; i < len; i += 1 {
            builtin::array_set_u8(&mut arr, i, builtin::i32_load8_u(ptr + i));
        }
        let s = String::internal_from_utf8_raw(arr, len);
        self.pad(s);
    }

    /// Write the sign character, if this value carries one.
    fn write_sign(&mut self, is_negative: bool) {
        if is_negative {
            self.buf.push('-');
        } else if self.sign_plus {
            self.buf.push('+');
        }
    }

    /// Prepare the output buffer for integer digits.
    ///
    /// Writes sign, prefix, and any padding/fill, then reserves `digit_count`
    /// uninitialised bytes and returns their byte-offset inside `buf`.
    /// The caller **must** fill exactly `digit_count` bytes (backwards) via
    /// `buf.internal_raw_bytes()` at the returned offset.
<<<<<<< HEAD
