>>>>>>> origin/main
        let content_len = sign_len + prefix_len + digit_count;

        if self.width <= 0 || content_len >= self.width {
            // No padding — write sign/prefix, reserve digit area
            self.write_sign(is_negative);
            if prefix_len > 0 {
                self.buf.push_str(&alt_prefix);
            }
            return self.buf.internal_reserve_uninit(digit_count);
        }

        let padding = self.width - content_len;

        if self.zero_pad {
            // sign + prefix + zeros + [digits]
            self.write_sign(is_negative);
            if prefix_len > 0 {
                self.buf.push_str(&alt_prefix);
            }
            self.write_char_n('0', padding);
            return self.buf.internal_reserve_uninit(digit_count);
        }

        let align = self.align;
        if align matches { Left } {
            // [sign prefix digits] [fill...]
            self.write_sign(is_negative);
            if prefix_len > 0 {
                self.buf.push_str(&alt_prefix);
            }
            let offset = self.buf.internal_reserve_uninit(digit_count);
            self.write_char_n(self.fill, padding);
            return offset;
        } else if align matches { Center } {
            // [fill...] [sign prefix digits] [fill...]
            let left_pad = padding / 2;
            let right_pad = padding - left_pad;
            self.write_char_n(self.fill, left_pad);
            self.write_sign(is_negative);
            if prefix_len > 0 {
                self.buf.push_str(&alt_prefix);
            }
            let offset = self.buf.internal_reserve_uninit(digit_count);
            self.write_char_n(self.fill, right_pad);
            return offset;
        } else {
            // Right: [fill...] [sign prefix digits]
            self.write_char_n(self.fill, padding);
            self.write_sign(is_negative);
            if prefix_len > 0 {
                self.buf.push_str(&alt_prefix);
            }
            return self.buf.internal_reserve_uninit(digit_count);
        }
    }

    /// Write indentation (2 spaces per level) for pretty-printing.
    pub fn write_indent(&mut self) {
        for let mut i = 0; i < self.indent; i += 1 {
            self.write_str(&"  ");
        }
    }

    /// Write a newline followed by indentation for pretty-printing.
    pub fn write_newline_indent(&mut self) {
        self.write_char('\n');
        self.write_indent();
    }

    /// Open a pretty-printed brace: write opening delimiter, increase indent.
    pub fn open_brace(&mut self, open: String) {
        self.write_str(&open);
        self.indent += 1;
    }

    /// Close a pretty-printed brace: decrease indent, write newline+indent, write closing delimiter.
    pub fn close_brace(&mut self, close: String) {
        self.indent -= 1;
        self.write_newline_indent();
        self.write_str(&close);
    }
}
// Defined here (not in string.wado) to avoid string.wado depending on format.wado,
// which would cause codegen struct registration order issues.

impl Display for String {
    pub fn fmt(&self, f: &mut Formatter) {
        // Precision caps the length in characters (Rust's `{:.N}`); no marker.
        if f.precision >= 0 {
            let mut capped = *self;
            capped.truncate_chars(f.precision);
            f.pad(capped);
        } else {
            f.pad(*self);
        }
    }
}

/// Writes a `Display` value into a `String` in place, skipping the temporary
/// `String` that a `` `${value}` `` template allocates before copying it in. The
/// alloc-free counterpart to `buf.push_str(&`${value}`)` for a single value with
/// no format spec — the hot path in the serde numeric encoders.
///
/// A trait (not an inherent `impl String`, which the coherence rules forbid on a
/// foreign type) and placed here, not in string.wado, so `String` stays a leaf
/// that `Formatter` depends on — mirroring `impl Display for String` above.
pub trait PushDisplay {
    fn push_display<T: Display>(&mut self, value: &T);
}

impl PushDisplay for String {
    fn push_display<T: Display>(&mut self, value: &T) {
        let mut f = Formatter::new(self);
        value.fmt(&mut f);
    }
}

impl Inspect for String {
    pub fn inspect(&self, f: &mut Formatter) {
        // The escape policy below is mirrored by `write_literal_char` in
        // package-gale's wadopoet.wado (it emits Wado source literals). Keep
        // the two in lockstep — same escaped set.
        //
        // Caps to N chars and appends `...` outside the quotes when truncated
        // (the marker doesn't count toward N). PRECISION_DEFAULT uses the
        // default cap; negatives below it mean no cap.
        let limit = f.resolved_seq_limit();
        f.write_char('"');
        let mut count = 0;
        let mut truncated = false;
        for let c of (*self).chars() {
            if limit >= 0 && count >= limit {
                truncated = true;
                break;
            }
            if c == '"' {
                f.write_char('\\');
                f.write_char('"');
            } else if c == '\\' {
                f.write_char('\\');
                f.write_char('\\');
            } else if c == '\n' {
                f.write_char('\\');
                f.write_char('n');
            } else if c == '\r' {
                f.write_char('\\');
                f.write_char('r');
            } else if c == '\t' {
                f.write_char('\\');
                f.write_char('t');
            } else {
                let code = c as i32;
                if code < 0x20 || code == 0x7f {
                    // Control char with no named escape: `\u{HEX}`, never raw.
                    f.write_str(&"\\u{");
                    f.write_str(&`${code:x}`);
                    f.write_char('}');
                } else {
                    f.write_char(c);
                }
            }
            count += 1;
        }
        f.write_char('"');
        if truncated {
            f.write_str(&"...");
        }
    }
}

impl Inspect for ! {
    pub fn inspect(&self, f: &mut Formatter) {
        unreachable();
    }
}

impl<T: Inspect> Inspect for &T {
    pub fn inspect(&self, f: &mut Formatter) {
        f.write_str(&"&");
        let inner: &T = *self;
        (*inner).inspect(f);
    }
}

impl<T: Inspect> Inspect for &mut T {
    pub fn inspect(&mut self, f: &mut Formatter) {
        f.write_str(&"&mut ");
        let inner: &mut T = *self;
        (*inner).inspect(f);
    }
}
