impl Inspect for () {
    pub fn inspect(&self, f: &mut Formatter) {
        f.write_str(&"()");
    }
}

impl Inspect for bool {
    pub fn inspect(&self, f: &mut Formatter) {
        self.fmt_into(f);
    }
}

impl Inspect for char {
    pub fn inspect(&self, f: &mut Formatter) {
        f.write_char('\'');
        let c = *self;
        if c == '\'' {
            f.write_char('\\');
            f.write_char('\'');
        } else if c == '\\' {
            f.write_char('\\');
            f.write_char('\\');
        } else if c == '\n' {
            f.write_char('\\');
            f.write_char('n');
        } else if c == '\r' {
            f.write_char('\\');
            f.write_char('r');
        } else if c == '\t' {
            f.write_char('\\');
            f.write_char('t');
        } else {
            f.write_char(c);
        }
        f.write_char('\'');
    }
}

