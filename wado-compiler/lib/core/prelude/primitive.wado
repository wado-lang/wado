#![no_prelude]
#![stdlib("core:prelude/primitive.wado")]
//! The builtin type names, and the methods of `()`, `bool` and `char`. The
//! numeric types' are in `numeric.wado`.

use { String, AsStrSlice } from "core:prelude/string.wado";
use { ByteList } from "core:prelude/bytes.wado";
use { Formatter } from "core:prelude/format.wado";
use {
    Ordering,
    Eq,
    Ord,
    Hash,
    Hasher,
    Default,
    Display,
    Inspect,
    FromStr,
    LenientFromStr,
    LenientParseError,
    ConvertError,
} from "core:prelude/traits.wado";
use { Option, Result } from "core:prelude/option.wado";

// A builtin type name is in scope in every module of every package, so `pub`
// is the reach it already has.

pub type i8;
pub type i16;
pub type i32;
pub type i64;
pub type u8;
pub type u16;
pub type u32;
pub type u64;
pub type f32;
pub type f64;
pub type f16;
pub type bf16;
pub type v128;
pub type bool;
pub type char;
pub type ();
pub type !;

impl () {
    pub fn to_string(&self) -> String {
        return "()";
    }
}

impl bool {
    fn fmt_into(&self, f: &mut Formatter) {
        let text: String = if *self { "true" } else { "false" };
        f.pad(text);
    }

    pub fn to_string(&self) -> String {
        let mut buf = String::with_capacity(5);
        let mut f = Formatter::new(&mut buf);
        self.fmt_into(&mut f);
        return buf;
    }
}

/// Error returned by `bool::from_str`, which takes `true` and `false` alone.
pub struct ParseBoolError {
}

impl Display for ParseBoolError {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str("provided string was not `true` or `false`");
    }
}

impl Error for ParseBoolError {
}

impl FromStr for bool {
    type Err = ParseBoolError;

    fn from_str<S: AsStrSlice>(s: S) -> Result<bool, ParseBoolError> {
        return match s.as_str_slice() {
            "true" => Result::Ok(true),
            "false" => Result::Ok(false),
            _ => {
                builtin::cold_path();
                Result::Err(ParseBoolError {});
            },
        };
    }
}

impl LenientFromStr for bool {
    type Err = LenientParseError;

    fn from_str_lenient<S: AsStrSlice>(s: S) -> Result<bool, LenientParseError> {
        let text = s.as_str_slice();
        if text.eq_ignore_ascii_case("true") || text == "1" {
            return Result::Ok(true);
        }
        if text.eq_ignore_ascii_case("false") || text == "0" {
            return Result::Ok(false);
        }
        builtin::cold_path();
        return Result::Err(LenientParseError::new("invalid boolean string"));
    }
}

impl char {
    /// The char whose scalar value is `value`. `char::try_from` answers for a
    /// value that may not be one.
    pub fn from_u32(value: u32) -> char
        contract char::is_scalar_value(value)
    {
        return builtin::i32_as_char(value as i32);
    }

    /// The char whose scalar value is `value`. `char::try_from(value as u32)`
    /// answers for a value that may not be one.
    pub fn from_i32(value: i32) -> char
        contract value >= 0 && char::is_scalar_value(value as u32)
    {
        return unchecked char::from_u32(value as u32);
    }

    #[unavailable("write `unchecked char::from_u32(value)`")]
    pub fn from_u32_unchecked(value: u32);

    /// Whether `value` is a Unicode scalar value: in `0..=0x10FFFF` and not a
    /// surrogate.
    pub fn is_scalar_value(value: u32) -> bool {
        return value < 0xD800 || 0xE000 <= value <= 0x10FFFF;
    }

    pub fn to_string(&self) -> String {
        let mut buf = String::with_capacity(4);
        buf.push(*self);
        return buf;
    }

    /// Returns true if the character is ASCII whitespace, as POSIX `isspace()`
    /// has it: SP, HT, LF, VT, FF, CR.
    pub fn is_ascii_whitespace(&self) -> bool {
        return match *self {
            ' ' | '\t' | '\n' | '\r' => true,
            '\u{0B}' | '\u{0C}' => true,  // VT, FF
            _ => false,
        };
    }

    /// Returns true if the character is Unicode whitespace: ASCII whitespace,
    /// U+0085 (NEXT LINE), and the Zs/Zl/Zp code points.
    pub fn is_whitespace(&self) -> bool {
        if self.is_ascii_whitespace() {
            return true;
        }
        return match *self {
            '\u{85}' => true,  // NEXT LINE
            '\u{A0}' => true,  // NO-BREAK SPACE
            '\u{1680}' => true,  // OGHAM SPACE MARK
            '\u{2000}' => true,  // EN QUAD
            '\u{2001}' => true,  // EM QUAD
            '\u{2002}' => true,  // EN SPACE
            '\u{2003}' => true,  // EM SPACE
            '\u{2004}' => true,  // THREE-PER-EM SPACE
            '\u{2005}' => true,  // FOUR-PER-EM SPACE
            '\u{2006}' => true,  // SIX-PER-EM SPACE
            '\u{2007}' => true,  // FIGURE SPACE
            '\u{2008}' => true,  // PUNCTUATION SPACE
            '\u{2009}' => true,  // THIN SPACE
            '\u{200A}' => true,  // HAIR SPACE
            '\u{2028}' => true,  // LINE SEPARATOR
            '\u{2029}' => true,  // PARAGRAPH SEPARATOR
            '\u{202F}' => true,  // NARROW NO-BREAK SPACE
            '\u{205F}' => true,  // MEDIUM MATHEMATICAL SPACE
            '\u{3000}' => true,  // IDEOGRAPHIC SPACE
            _ => false,
        };
    }

    /// Returns true if the character is an ASCII lowercase letter: a-z.
    pub fn is_ascii_lowercase(&self) -> bool {
        // Branchless: `c - 'a'` wraps for `c < 'a'`, so a single unsigned
        // compare covers both bounds — no short-circuit `&&` control-flow
        // diamond (fewer Wasm instructions in `to_ascii_*` and their callers).
        return (*self as u32 - 'a' as u32) < 26;
    }

    /// Returns true if the character is an ASCII uppercase letter: A-Z.
    pub fn is_ascii_uppercase(&self) -> bool {
        return (*self as u32 - 'A' as u32) < 26;
    }

    /// Converts an ASCII uppercase letter to lowercase. Non-ASCII and
    /// non-uppercase characters are returned unchanged.
    pub fn to_ascii_lowercase(&self) -> char {
        let c = *self as u32;
        return unchecked char::from_u32(c | self.is_ascii_uppercase() as u32 * ('A' as u32 ^ 'a' as u32));
    }

    /// Converts an ASCII lowercase letter to uppercase. Non-ASCII and
    /// non-lowercase characters are returned unchanged.
    pub fn to_ascii_uppercase(&self) -> char {
        let c = *self as u32;
        return unchecked char::from_u32(c ^ self.is_ascii_lowercase() as u32 * ('A' as u32 ^ 'a' as u32));
    }

    /// Checks that two characters are an ASCII case-insensitive match.
    pub fn eq_ignore_ascii_case(&self, other: &char) -> bool {
        return self.to_ascii_lowercase() == other.to_ascii_lowercase();
    }

    /// Returns true if the character is an ASCII digit: 0-9.
    pub fn is_ascii_digit(&self) -> bool {
        return (*self as u32 - '0' as u32) < 10;
    }

    /// Returns true if the character is an ASCII letter: a-z or A-Z.
    pub fn is_ascii_alphabetic(&self) -> bool {
        return self.is_ascii_lowercase() || self.is_ascii_uppercase();
    }

    /// Returns true if the character is an ASCII letter or digit: a-z, A-Z, 0-9.
    pub fn is_ascii_alphanumeric(&self) -> bool {
        return self.is_ascii_alphabetic() || self.is_ascii_digit();
    }

    /// Returns true if the character is a hexadecimal digit: 0-9, a-f, A-F.
    pub fn is_hexdigit(&self) -> bool {
        let c = *self;
        return c.is_ascii_digit() || 'a' <= c <= 'f' || 'A' <= c <= 'F';
    }

    /// Returns the numeric value of an ASCII hexadecimal digit (0–15).
    pub fn hex_digit_value(&self) -> i32
        contract self.is_hexdigit()
    {
        let c = *self;
        if c.is_ascii_digit() {
            return c as i32 - '0' as i32;
        }
        if 'a' <= c <= 'f' {
            return c as i32 - 'a' as i32 + 10;
        }
        if 'A' <= c <= 'F' {
            return c as i32 - 'A' as i32 + 10;
        }
        unreachable();
    }

    /// Returns the number of bytes this character needs in UTF-8 encoding.
    pub fn len_utf8(&self) -> i32 {
        let cp = *self as i32;
        if cp < 0x80 {
            return 1;
        }
        if cp < 0x800 {
            return 2;
        }
        if cp < 0x10000 {
            return 3;
        }
        return 4;
    }

    /// Encodes this character as UTF-8, returning the bytes.
    pub fn encode_utf8(&self) -> ByteList {
        let cp = *self as i32;
        if cp < 0x80 {
            return [cp as u8] as ByteList;
        }
        if cp < 0x800 {
            let mut buf = ByteList::with_capacity(2);
            buf.push((0xC0 | cp >> 6) as u8);
            buf.push((0x80 | cp & 0x3F) as u8);
            return buf;
        }
        if cp < 0x10000 {
            let mut buf = ByteList::with_capacity(3);
            buf.push((0xE0 | cp >> 12) as u8);
            buf.push((0x80 | cp >> 6 & 0x3F) as u8);
            buf.push((0x80 | cp & 0x3F) as u8);
            return buf;
        }
        let mut buf = ByteList::with_capacity(4);
        buf.push((0xF0 | cp >> 18) as u8);
        buf.push((0x80 | cp >> 12 & 0x3F) as u8);
        buf.push((0x80 | cp >> 6 & 0x3F) as u8);
        buf.push((0x80 | cp & 0x3F) as u8);
        return buf;
    }
}

/// Kind of failure returned by char parsing.
pub enum CharErrorKind {
    /// The input string was empty.
    Empty,
    /// The input held more than one Unicode scalar.
    TooManyChars,
}

/// Error returned by char parsing.
pub struct ParseCharError {
    pub kind: CharErrorKind,
}

impl ParseCharError {
    pub fn new(kind: CharErrorKind) -> ParseCharError {
        return ParseCharError { kind };
    }

    pub fn kind(&self) -> CharErrorKind {
        return self.kind;
    }
}

impl Display for ParseCharError {
    fn fmt(&self, f: &mut Formatter) {
        let message: String = match self.kind {
            _::Empty => "cannot parse char from empty string",
            _::TooManyChars => "too many characters in string",
        };
        f.write_str(&message);
    }
}

impl Error for ParseCharError {
}

impl From<ParseCharError> for LenientParseError {
    fn from(e: ParseCharError) -> LenientParseError {
        let reason: String = match e.kind() {
            _::Empty => "empty char string",
            _::TooManyChars => "char string holds more than one character",
        };
        return LenientParseError::new(reason);
    }
}

impl FromStr for char {
    type Err = ParseCharError;

    fn from_str<S: AsStrSlice>(s: S) -> Result<char, ParseCharError> {
        let mut iter = s.as_str_slice().chars();
        let Some(first) = iter.next() else {
            builtin::cold_path();
            return Result::Err(ParseCharError::new(CharErrorKind::Empty));
        };
        if iter.next() matches { Some(_) } {
            builtin::cold_path();
            return Result::Err(ParseCharError::new(CharErrorKind::TooManyChars));
        }
        return Result::Ok(first);
    }
}

/// Leniency adds nothing here: one Unicode scalar has one spelling.
impl LenientFromStr for char {
    type Err = LenientParseError;

    fn from_str_lenient<S: AsStrSlice>(s: S) -> Result<char, LenientParseError> {
        return Result::Ok(char::from_str(s)?);
    }
}

impl TryFrom<u32> for char {
    type Err = ConvertError;

    pub fn try_from(value: u32) -> Result<char, ConvertError> {
        if !char::is_scalar_value(value) {
            builtin::cold_path();
            return Result::Err(ConvertError::new(`${value:#x} is not a Unicode scalar value`));
        }
        return Result::Ok(unchecked char::from_u32(value));
    }
}

impl Display for () {
    pub fn fmt(&self, f: &mut Formatter) {
        f.write_str("()");
    }
}

impl Display for bool {
    pub fn fmt(&self, f: &mut Formatter) {
        self.fmt_into(f);
    }
}

impl Display for char {
    pub fn fmt(&self, f: &mut Formatter) {
        if f.width <= 0 {
            f.write_char(*self);
        } else {
            let mut s = String::with_capacity(4);
            s.push(*self);
            f.pad(s);
        }
    }
}

impl Inspect for () {
    pub fn inspect(&self, f: &mut Formatter) {
        f.write_str("()");
    }
}

impl Inspect for bool {
    pub fn inspect(&self, f: &mut Formatter) {
        self.fmt_into(f);
    }
}

impl Inspect for char {
    pub fn inspect(&self, f: &mut Formatter) {
        f.write_char('\'');
        let c = *self;
        if c == '\'' {
            f.write_char('\\');
            f.write_char('\'');
        } else if c == '\\' {
            f.write_char('\\');
            f.write_char('\\');
        } else if c == '\n' {
            f.write_char('\\');
            f.write_char('n');
        } else if c == '\r' {
            f.write_char('\\');
            f.write_char('r');
        } else if c == '\t' {
            f.write_char('\\');
            f.write_char('t');
        } else {
            f.write_char(c);
        }
        f.write_char('\'');
    }
}

/// `()` is the unit type, not the empty tuple `[]`, so the tuple impls do not
/// answer for it: it has one value, equal to and ordered with itself.
impl Eq for () {
    pub fn eq(&self, other: &Self) -> bool {
        return true;
    }
}

impl Eq for char {
    pub fn eq(&self, other: &Self) -> bool {
        return *self == *other;
    }
}

impl Eq for bool {
    pub fn eq(&self, other: &Self) -> bool {
        return *self == *other;
    }
}

impl Ord for () {
    pub fn cmp(&self, other: &Self) -> Ordering {
        return Ordering::Equal;
    }
}

impl Ord for char {
    pub fn cmp(&self, other: &Self) -> Ordering {
        if *self < *other {
            return Ordering::Less;
        }
        if *self > *other {
            return Ordering::Greater;
        }
        return Ordering::Equal;
    }
}

impl Ord for bool {
    pub fn cmp(&self, other: &Self) -> Ordering {
        let a = *self as i32;
        let b = *other as i32;
        if a < b {
            return Ordering::Less;
        }
        if a > b {
            return Ordering::Greater;
        }
        return Ordering::Equal;
    }
}

/// The one value feeds nothing, as an empty tuple does.
impl Hash for () {
    pub fn hash<H: Hasher>(&self, h: &mut H) {
    }
}

impl Hash for char {
    pub fn hash<H: Hasher>(&self, h: &mut H) {
        h.write_u64(*self as u64);
    }
}

impl Hash for bool {
    pub fn hash<H: Hasher>(&self, h: &mut H) {
        h.write_u64(*self as u64);
    }
}

impl Default for bool {
    pub fn default() -> bool {
        return false;
    }
}

impl Default for char {
    pub fn default() -> char {
        return '\0';
    }
}
