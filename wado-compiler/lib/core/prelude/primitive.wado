impl Binary for i8 {
    pub fn fmt(&self, f: &mut Formatter) {
        let v = *self as i32;
        let is_neg = v < 0;
        let abs_val: i64 = if is_neg { 0 - v as i64 } else { v as i64 };
        abs_val.fmt_base(is_neg, f, 2, false, "");
    }
}

impl Binary for u8 {
    pub fn fmt(&self, f: &mut Formatter) {
        (*self as i32 as i64).fmt_base(false, f, 2, false, "");
    }
}

impl Binary for i16 {
    pub fn fmt(&self, f: &mut Formatter) {
        let v = *self as i32;
        let is_neg = v < 0;
