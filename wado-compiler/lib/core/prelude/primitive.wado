impl Binary for u32 {
    pub fn fmt(&self, f: &mut Formatter) {
        let val_i32 = *self as i32;
        let abs_val: i64 = if val_i32 < 0 { val_i32 as i64 + 4294967296 } else { val_i32 as i64 };
        abs_val.fmt_base(false, f, 2, false, "");
    }
}

impl Binary for i64 {
    pub fn fmt(&self, f: &mut Formatter) {
        let v = *self;
        let is_neg = v < 0;
        if v == i64::MIN {
            let half: i64 = 4611686018427387904;
            half.fmt_base(true, f, 2, false, "");
        } else {
            let abs_val = if is_neg { 0 - v } else { v };
            abs_val.fmt_base(is_neg, f, 2, false, "");
        }
    }
}


