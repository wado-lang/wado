// These enable calling Ord::cmp on primitives when T: Ord bounds are used.

impl Ord for i8 {
    pub fn cmp(&self, other: &Self) -> Ordering {
        if *self < *other {
            return Ordering::Less;
        }
        if *self > *other {
            return Ordering::Greater;
        }
        return Ordering::Equal;
    }
}

impl Ord for u8 {
    pub fn cmp(&self, other: &Self) -> Ordering {
        if *self < *other {
            return Ordering::Less;
        }
        if *self > *other {
            return Ordering::Greater;
        }
        return Ordering::Equal;
    }
}

