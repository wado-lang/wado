    type Error = ConvertError;

    pub fn try_from(value: u64) -> Result<f64, ConvertError> {
        if value > 9007199254740992 as u64 {
            return Result::Err(ConvertError::new(`{value} cannot be exactly represented as f64`));
        }
        return Result::Ok(value as f64);
    }
