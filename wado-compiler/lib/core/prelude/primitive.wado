impl i32 {
    pub const MAX: i32 = 2147483647;
    pub const MIN: i32 = -2147483648;

    pub fn max(a: i32, b: i32) -> i32 {
        return builtin::select(a > b, a, b);
    }

    pub fn min(a: i32, b: i32) -> i32 {
        return builtin::select(a < b, a, b);
    }

    /// Counts the leading zeros in this integer.
    pub fn clz(x: i32) -> i32 {
        return builtin::i32_clz(x);
    }

    /// Counts the trailing zeros in this integer.
    pub fn ctz(x: i32) -> i32 {
        return builtin::i32_ctz(x);
    }

    /// Counts the number of set bits (population count).
    pub fn popcnt(x: i32) -> i32 {
        return builtin::i32_popcnt(x);
    }

    fn fmt_decimal(&self, f: &mut Formatter) {
        let is_negative = *self < 0;
        let abs_val: i64 = if is_negative { 0 - *self as i64 } else { *self as i64 };
        let digit_count = count_digits_i64(abs_val);
        let offset = f.prepare_int_write(is_negative, "", digit_count);
        write_decimal_digits(f.buf.internal_raw_bytes(), offset, abs_val, digit_count);
    }

    fn fmt_into(&self, f: &mut Formatter) {
        self.fmt_decimal(f);
    }

    pub fn to_string(&self) -> String {
        let mut buf = String::with_capacity(12);
        let mut f = Formatter::new(&mut buf);
        self.fmt_into(&mut f);
        return buf;
    }

    pub fn from_str_hex(s: &String) -> Result<i32, ParseIntError> {
        return i32::from_str_radix(s, 16);
    }

    pub fn from_str_radix(s: &String, radix: u32) -> Result<i32, ParseIntError> {
        return match parse_i64_radix(s, radix, 2147483647, 2147483648) {
            Ok(v) => Result::Ok(v as i32),
            Err(e) => Result::Err(e),
        };
    }
}

impl FromStr for i32 {
    type Err = ParseIntError;

    fn from_str_range(s: &String, start: i32, end: i32) -> Result<i32, ParseIntError> {
        return match parse_i64_radix_range(s, start, end, 10, 2147483647, 2147483648) {
            Ok(v) => Result::Ok(v as i32),
            Err(e) => Result::Err(e),
        };
    }
}

impl u32 {
    pub const MAX: u32 = 4294967295;
    pub const MIN: u32 = 0;

    pub fn max(a: u32, b: u32) -> u32 {
        return builtin::select(a > b, a, b);
    }

    pub fn min(a: u32, b: u32) -> u32 {
        return builtin::select(a < b, a, b);
    }

    fn fmt_decimal(&self, f: &mut Formatter) {
        let val_i32 = *self as i32;
        let abs_val: i64 = if val_i32 < 0 { val_i32 as i64 + 4294967296 } else { val_i32 as i64 };
        let digit_count = count_digits_i64(abs_val);
        let offset = f.prepare_int_write(false, "", digit_count);
        write_decimal_digits(f.buf.internal_raw_bytes(), offset, abs_val, digit_count);
    }

    fn fmt_into(&self, f: &mut Formatter) {
        self.fmt_decimal(f);
    }

    pub fn to_string(&self) -> String {
        let mut buf = String::with_capacity(11);
        let mut f = Formatter::new(&mut buf);
        self.fmt_into(&mut f);
        return buf;
    }

    pub fn from_str_hex(s: &String) -> Result<u32, ParseIntError> {
        return u32::from_str_radix(s, 16);
    }

    pub fn from_str_radix(s: &String, radix: u32) -> Result<u32, ParseIntError> {
        return match parse_u64_radix(s, radix, 4294967295) {
            Ok(v) => Result::Ok(v as u32),
            Err(e) => Result::Err(e),
        };
    }
}

impl FromStr for u32 {
    type Err = ParseIntError;

    fn from_str_range(s: &String, start: i32, end: i32) -> Result<u32, ParseIntError> {
        return match parse_u64_radix_range(s, start, end, 10, 4294967295) {
            Ok(v) => Result::Ok(v as u32),
            Err(e) => Result::Err(e),
        };
    }
}

impl i64 {
    pub const MAX: i64 = 9223372036854775807;
    pub const MIN: i64 = -9223372036854775808;

    pub fn max(a: i64, b: i64) -> i64 {
        return builtin::select(a > b, a, b);
    }

    pub fn min(a: i64, b: i64) -> i64 {
        return builtin::select(a < b, a, b);
    }

    /// Counts the leading zeros in this integer.
    pub fn clz(x: i64) -> i64 {
        return builtin::i64_clz(x);
    }

    /// Counts the trailing zeros in this integer.
    pub fn ctz(x: i64) -> i64 {
        return builtin::i64_ctz(x);
    }

    /// Counts the number of set bits (population count).
    pub fn popcnt(x: i64) -> i64 {
        return builtin::i64_popcnt(x);
    }

    fn fmt_decimal(&self, f: &mut Formatter) {
        let value = *self;
        let is_negative = value < 0;

        if value == i64::MIN {
            // i64::MIN = -9223372036854775808: last digit '8', remaining 922337203685477580
            let remaining: i64 = 922337203685477580;
            let remaining_digits = count_digits_i64(remaining);
            let digit_count = remaining_digits + 1;
            let offset = f.prepare_int_write(true, "", digit_count);
            let repr = f.buf.internal_raw_bytes();
            write_decimal_digits(repr, offset, remaining, remaining_digits);
            builtin::array_set_u8(repr, offset + remaining_digits, '8' as u8);
        } else {
            let abs_val = if is_negative { 0 - value } else { value };
            let digit_count = count_digits_i64(abs_val);
            let offset = f.prepare_int_write(is_negative, "", digit_count);
            write_decimal_digits(f.buf.internal_raw_bytes(), offset, abs_val, digit_count);
        }
    }

    fn fmt_base(&self, is_negative: bool, f: &mut Formatter, base: i32, upper: bool, prefix: String) {
        let abs_val = *self;
        let digit_count = count_digits_base(abs_val, base);
        let offset = f.prepare_int_write(is_negative, prefix, digit_count);
        write_base_digits(f.buf.internal_raw_bytes(), offset, abs_val, digit_count, base, upper);
    }

    fn fmt_into(&self, f: &mut Formatter) {
        self.fmt_decimal(f);
    }

    pub fn to_string(&self) -> String {
        let mut buf = String::with_capacity(21);
        let mut f = Formatter::new(&mut buf);
        self.fmt_into(&mut f);
        return buf;
    }

    pub fn from_str_hex(s: &String) -> Result<i64, ParseIntError> {
        return i64::from_str_radix(s, 16);
    }

    pub fn from_str_radix(s: &String, radix: u32) -> Result<i64, ParseIntError> {
        return parse_i64_radix(s, radix, 9223372036854775807, 9223372036854775808);
    }
}

impl FromStr for i64 {
    type Err = ParseIntError;

    fn from_str_range(s: &String, start: i32, end: i32) -> Result<i64, ParseIntError> {
        return parse_i64_radix_range(s, start, end, 10, 9223372036854775807, 9223372036854775808);
    }
}

impl u64 {
    pub const MAX: u64 = 18446744073709551615;
    pub const MIN: u64 = 0;

    pub fn max(a: u64, b: u64) -> u64 {
        return builtin::select(a > b, a, b);
    }

    pub fn min(a: u64, b: u64) -> u64 {
        return builtin::select(a < b, a, b);
    }

    fn fmt_decimal(&self, f: &mut Formatter) {
        let val_i64 = *self as i64;

        if val_i64 == 0 {
            let offset = f.prepare_int_write(false, "", 1);
            builtin::array_set_u8(f.buf.internal_raw_bytes(), offset, '0' as u8);
            return;
        }

        // Count digits using unsigned division
        let mut digit_count: i32 = 0;
        let offset_div: i64 = 1844674407370955161;
        let mut temp = val_i64;
        while temp != 0 {
            digit_count += 1;
            if temp >= 0 {
                temp = temp / 10;
            } else {
                let signed_rem = temp % 10;
                let rem_adjusted = signed_rem + 6;
                let signed_quot = temp / 10;
                let mut carry: i64 = 0;
                if rem_adjusted < 0 {
                    carry = -1;
                }
                temp = signed_quot + offset_div + carry;
            }
        }

        let offset = f.prepare_int_write(false, "", digit_count);
        let repr = f.buf.internal_raw_bytes();

        // Write digits using unsigned division (backwards)
        let mut pos = offset + digit_count;
        temp = val_i64;
        while temp != 0 {
            pos -= 1;
            let mut digit: i32 = 0;
            if temp >= 0 {
                digit = (temp % 10) as i32;
                temp = temp / 10;
            } else {
                let signed_rem = temp % 10;
                let rem_adjusted = signed_rem + 6;
                if rem_adjusted >= 0 {
                    digit = rem_adjusted as i32;
                } else {
                    digit = (rem_adjusted + 10) as i32;
                }
                let signed_quot = temp / 10;
                let mut carry: i64 = 0;
                if rem_adjusted < 0 {
                    carry = -1;
                }
                temp = signed_quot + offset_div + carry;
            }
            builtin::array_set_u8(repr, pos, ('0' as i32 + digit) as u8);
        }
    }

    fn fmt_base(&self, f: &mut Formatter, base: i32, upper: bool, prefix: String) {
        let val_i64 = *self as i64;
        let bits_per_digit = if base == 2 {
            1;
        } else if base == 8 {
            3;
        } else {
            4;
        };
        let mask = base - 1;
        let digit_count = count_digits_u64_base(val_i64, bits_per_digit);
        let offset = f.prepare_int_write(false, prefix, digit_count);
        write_u64_base_digits(f.buf.internal_raw_bytes(), offset, val_i64, digit_count, bits_per_digit, mask, upper);
    }

    fn fmt_into(&self, f: &mut Formatter) {
        self.fmt_decimal(f);
    }

    pub fn to_string(&self) -> String {
        let mut buf = String::with_capacity(21);
        let mut f = Formatter::new(&mut buf);
        self.fmt_into(&mut f);
        return buf;
    }

    pub fn from_str_hex(s: &String) -> Result<u64, ParseIntError> {
        return u64::from_str_radix(s, 16);
    }

    pub fn from_str_radix(s: &String, radix: u32) -> Result<u64, ParseIntError> {
        return parse_u64_radix(s, radix, u64::MAX);
    }
}

impl FromStr for u64 {
    type Err = ParseIntError;

    fn from_str_range(s: &String, start: i32, end: i32) -> Result<u64, ParseIntError> {
        return parse_u64_radix_range(s, start, end, 10, u64::MAX);
    }
}

/// Format a special float (NaN, Inf, or zero) with padding.
fn fmt_float_special(f: &mut Formatter, is_neg: bool, kind: SpecialKind, zero_repr: String) {
    let mark = f.mark();
    if kind matches { NaN } {
        f.buf.push_str(&"NaN");
    } else if kind matches { Inf } {
        f.buf.push_str(&if is_neg { "-inf" } else { "inf" });
    } else {
        f.buf.push_str(&if is_neg { "-" } else { "" });
        f.buf.push_str(&zero_repr);
    }
    f.apply_padding(mark);
}

/// Write sign prefix ("-" or "+").
fn fmt_float_sign(f: &mut Formatter, is_neg: bool) {
    if is_neg {
        f.buf.push_str(&"-");
    } else if f.sign_plus {
        f.buf.push_str(&"+");
    }
}

impl f32 {
    pub const PI: f32 = 3.14159265358979323846;
    pub const TAU: f32 = 6.28318530717958647692;
    pub const E: f32 = 2.71828182845904523536;
    pub const LN2: f32 = 0.69314718055994530942;
    pub const LN10: f32 = 2.30258509299404568402;
    pub const LOG2_E: f32 = 1.44269504088896340736;
    pub const LOG10_E: f32 = 0.43429448190325182765;
    pub const SQRT2: f32 = 1.41421356237309504880;
    pub const FRAC_1_SQRT2: f32 = 0.70710678118654752440;
    pub const FRAC_PI_2: f32 = 1.57079632679489661923;
    pub const FRAC_PI_4: f32 = 0.78539816339744830962;
    pub const INFINITY: f32 = 1.0 / 0.0;
    pub const NEG_INFINITY: f32 = -1.0 / 0.0;
    pub const NAN: f32 = 0.0 / 0.0;

    fn fmt_into(&self, f: &mut Formatter) {
        if f.precision >= 0 {
            self.fmt_fixed(f.precision, f);
            return;
        }
        let [is_special, is_neg, kind] = check_special(*self as f64);
        if is_special {
            fmt_float_special(f, is_neg, kind, "0");
            return;
        }
        let abs_f = if is_neg { -*self } else { *self };
        let result = short32(abs_f);
        let d = result.digits;
        let p = result.exponent;
        let nd = digits(d);
        let mark = f.mark();
        fmt_float_sign(f, is_neg);
        write_decimal(f.buf, d, p, nd);
        f.apply_padding(mark);
    }

    fn inspect_into(&self, f: &mut Formatter) {
        if f.precision >= 0 {
            self.fmt_fixed(f.precision, f);
            return;
        }
        let [is_special, is_neg, kind] = check_special(*self as f64);
        if is_special {
            fmt_float_special(f, is_neg, kind, "0.0");
            return;
        }
        let abs_f = if is_neg { -*self } else { *self };
        let result = short32(abs_f);
        let d = result.digits;
        let p = result.exponent;
        let nd = digits(d);
        let exp = p + nd - 1;
        let mark = f.mark();
        fmt_float_sign(f, is_neg);
        if exp < -4 || exp >= 16 {
            write_exp(f.buf, d, p, nd, false);
        } else if p >= 0 {
            write_decimal(f.buf, d, p, nd);
            f.buf.push_str(&".0");
        } else {
            write_decimal(f.buf, d, p, nd);
        }
        f.apply_padding(mark);
    }

    fn fmt_fixed(&self, precision: i32, f: &mut Formatter) {
        let v64 = *self as f64;
        v64.fmt_fixed(precision, f);
    }

    fn fmt_exp(&self, precision: i32, upper: i32, f: &mut Formatter) {
        let v64 = *self as f64;
        v64.fmt_exp(precision, upper, f);
    }

    pub fn to_string(&self) -> String {
        let mut buf = String::with_capacity(16);
        let mut f = Formatter::new(&mut buf);
        self.fmt_into(&mut f);
        return buf;
    }

    /// Absolute value
    pub fn abs(x: f32) -> f32 {
        return builtin::f32_abs(x);
    }

    /// Ceiling (round toward +infinity)
    pub fn ceil(x: f32) -> f32 {
        return builtin::f32_ceil(x);
    }

    /// Floor (round toward -infinity)
    pub fn floor(x: f32) -> f32 {
        return builtin::f32_floor(x);
    }

    /// Truncate toward zero
    pub fn trunc(x: f32) -> f32 {
        return builtin::f32_trunc(x);
    }

    /// Round to nearest even
    pub fn round(x: f32) -> f32 {
        return builtin::f32_nearest(x);
    }

    /// Square root
    pub fn sqrt(x: f32) -> f32 {
        return builtin::f32_sqrt(x);
    }

    /// Minimum of two values
    pub fn min(x: f32, y: f32) -> f32 {
        return builtin::f32_min(x, y);
    }

    /// Maximum of two values
    pub fn max(x: f32, y: f32) -> f32 {
        return builtin::f32_max(x, y);
    }

    /// Copy sign from y to x
    pub fn copysign(x: f32, y: f32) -> f32 {
        return builtin::f32_copysign(x, y);
    }

    /// Sine (in radians)
    pub fn sin(x: f32) -> f32 {
        return f32_sin(x);
    }

    /// Cosine (in radians)
    pub fn cos(x: f32) -> f32 {
        return f32_cos(x);
    }

    /// Tangent (in radians)
    pub fn tan(x: f32) -> f32 {
        return f32_tan(x);
    }

    /// Arc sine (returns radians)
    pub fn asin(x: f32) -> f32 {
        return f32_asin(x);
    }

    /// Arc cosine (returns radians)
    pub fn acos(x: f32) -> f32 {
        return f32_acos(x);
    }

    /// Arc tangent (returns radians)
    pub fn atan(x: f32) -> f32 {
        return f32_atan(x);
    }

    /// Arc tangent of y/x (returns radians)
    pub fn atan2(y: f32, x: f32) -> f32 {
        return f32_atan2(y, x);
    }

    /// Hyperbolic sine
    pub fn sinh(x: f32) -> f32 {
        return f32_sinh(x);
    }

    /// Hyperbolic cosine
    pub fn cosh(x: f32) -> f32 {
        return f32_cosh(x);
    }

    /// Hyperbolic tangent
    pub fn tanh(x: f32) -> f32 {
        return f32_tanh(x);
    }

    /// Inverse hyperbolic sine
    pub fn asinh(x: f32) -> f32 {
        return f32_asinh(x);
    }

    /// Inverse hyperbolic cosine
    pub fn acosh(x: f32) -> f32 {
        return f32_acosh(x);
    }

    /// Inverse hyperbolic tangent
    pub fn atanh(x: f32) -> f32 {
        return f32_atanh(x);
    }

    /// e raised to the power x
    pub fn exp(x: f32) -> f32 {
        return f32_exp(x);
    }

    /// 2 raised to the power x
    pub fn exp2(x: f32) -> f32 {
        return f32_exp2(x);
    }

    /// e^x - 1 (more accurate for small x)
    pub fn expm1(x: f32) -> f32 {
        return f32_expm1(x);
    }

    /// Natural logarithm (base e)
    pub fn ln(x: f32) -> f32 {
        return f32_ln(x);
    }

    /// Logarithm base 2
    pub fn log2(x: f32) -> f32 {
        return f32_log2(x);
    }

    /// Logarithm base 10
    pub fn log10(x: f32) -> f32 {
        return f32_log10(x);
    }

    /// ln(1 + x) (more accurate for small x)
    pub fn ln1p(x: f32) -> f32 {
        return f32_ln1p(x);
    }

    /// x raised to the power y
    pub fn pow(x: f32, y: f32) -> f32 {
        return f32_pow(x, y);
    }

    /// Cube root
    pub fn cbrt(x: f32) -> f32 {
        return f32_cbrt(x);
    }

    /// Euclidean distance: sqrt(x^2 + y^2)
    pub fn hypot(x: f32, y: f32) -> f32 {
        return f32_hypot(x, y);
    }

    /// Floating-point remainder of x/y
    pub fn fmod(x: f32, y: f32) -> f32 {
        return f32_fmod(x, y);
    }

    pub fn is_nan(&self) -> bool {
        return *self != *self;
    }

    pub fn is_finite(&self) -> bool {
        return *self - *self == 0.0;
    }

    /// Reinterprets the bits of this f32 as an i32.
    pub fn to_bits(&self) -> i32 {
        return builtin::i32_reinterpret_f32(*self);
    }

    /// Creates an f32 from its bit representation.
    pub fn from_bits(bits: i32) -> f32 {
        return builtin::f32_reinterpret_i32(bits);
    }
}

impl FromStr for f32 {
    type Err = ParseFloatError;

    fn from_str_range(s: &String, start: i32, end: i32) -> Result<f32, ParseFloatError> {
        return match parse_f64_from_str_range(s, start, end) {
            Ok(v) => Result::Ok(v as f32),
            Err(e) => Result::Err(e),
        };
    }
}

impl f64 {
    pub const PI: f64 = 3.14159265358979323846;
    pub const TAU: f64 = 6.28318530717958647692;
    pub const E: f64 = 2.71828182845904523536;
    pub const LN2: f64 = 0.69314718055994530942;
    pub const LN10: f64 = 2.30258509299404568402;
    pub const LOG2_E: f64 = 1.44269504088896340736;
    pub const LOG10_E: f64 = 0.43429448190325182765;
    pub const SQRT2: f64 = 1.41421356237309504880;
    pub const FRAC_1_SQRT2: f64 = 0.70710678118654752440;
    pub const FRAC_PI_2: f64 = 1.57079632679489661923;
    pub const FRAC_PI_4: f64 = 0.78539816339744830962;
    pub const INFINITY: f64 = 1.0 / 0.0;
    pub const NEG_INFINITY: f64 = -1.0 / 0.0;
    pub const NAN: f64 = 0.0 / 0.0;

    fn fmt_into(&self, f: &mut Formatter) {
        if f.precision >= 0 {
            self.fmt_fixed(f.precision, f);
            return;
        }
        let value = *self;
        let [is_special, is_neg, kind] = check_special(value);
        if is_special {
            fmt_float_special(f, is_neg, kind, "0");
            return;
        }
        let abs_f = if is_neg { -value } else { value };
        let result = short(abs_f);
        let d = result.digits;
        let p = result.exponent;
        let nd = digits(d);
        let mark = f.mark();
        fmt_float_sign(f, is_neg);
        write_decimal(f.buf, d, p, nd);
        f.apply_padding(mark);
    }

    fn inspect_into(&self, f: &mut Formatter) {
        if f.precision >= 0 {
            self.fmt_fixed(f.precision, f);
            return;
        }
        let value = *self;
        let [is_special, is_neg, kind] = check_special(value);
        if is_special {
            fmt_float_special(f, is_neg, kind, "0.0");
            return;
        }
        let abs_f = if is_neg { -value } else { value };
        let result = short(abs_f);
        let d = result.digits;
        let p = result.exponent;
        let nd = digits(d);
        let exp = p + nd - 1;
        let mark = f.mark();
        fmt_float_sign(f, is_neg);
        if exp < -4 || exp >= 16 {
            write_exp(f.buf, d, p, nd, false);
        } else if p >= 0 {
            write_decimal(f.buf, d, p, nd);
            f.buf.push_str(&".0");
        } else {
            write_decimal(f.buf, d, p, nd);
        }
        f.apply_padding(mark);
    }

    fn fmt_fixed(&self, precision: i32, f: &mut Formatter) {
        let value = *self;
        let [is_special, is_neg, kind] = check_special(value);
        if is_special {
            if kind matches { NaN } || kind matches { Inf } {
                fmt_float_special(f, is_neg, kind, "0");
                return;
            }
            let mark = f.mark();
            fmt_float_sign(f, is_neg);
            f.buf.push_str(&"0");
            if precision > 0 {
                f.buf.push_str(&".");
                f.buf.append_byte_filled('0' as u8, precision);
            }
            f.apply_padding(mark);
            return;
        }
        let abs_f = if is_neg { -value } else { value };
        let result = fixed_width_for_prec(abs_f, precision);
        let d = result.digits;
        let p = result.exponent;
        let nd = digits(d);
        let mark = f.mark();
        fmt_float_sign(f, is_neg);
        write_decimal_prec(f.buf, d, p, nd, precision);
        f.apply_padding(mark);
    }

    fn fmt_exp(&self, precision: i32, upper: i32, f: &mut Formatter) {
        let value = *self;
        let upper_bool = upper != 0;
        let [is_special, is_neg, kind] = check_special(value);
        if is_special {
            if kind matches { NaN } || kind matches { Inf } {
                fmt_float_special(f, is_neg, kind, "0");
                return;
            }
            let mark = f.mark();
            fmt_float_sign(f, is_neg);
            f.buf.push_str(&"0");
            if precision > 0 {
                f.buf.push_str(&".");
                f.buf.append_byte_filled('0' as u8, precision);
            }
            f.buf.push_str(&if upper_bool { "E" } else { "e" });
            f.buf.push_str(&"0");
            f.apply_padding(mark);
            return;
        }
        let abs_f = if is_neg { -value } else { value };
        let mark = f.mark();
        fmt_float_sign(f, is_neg);
        if precision >= 0 {
            let total_digits = precision + 1;
            let clamped = if total_digits > 18 {
                18;
            } else if total_digits < 1 {
                1;
            } else {
                total_digits;
            };
            let result = fixed_width(abs_f, clamped);
            let d = result.digits;
            let p = result.exponent;
            let nd = digits(d);
            write_exp_prec(f.buf, d, p, nd, precision, upper_bool);
        } else {
            let result = short(abs_f);
            let d = result.digits;
            let p = result.exponent;
            let nd = digits(d);
            write_exp(f.buf, d, p, nd, upper_bool);
        }
        f.apply_padding(mark);
    }

    pub fn to_string(&self) -> String {
        let mut buf = String::with_capacity(24);
        let mut f = Formatter::new(&mut buf);
        self.fmt_into(&mut f);
        return buf;
    }

    /// Absolute value
    pub fn abs(x: f64) -> f64 {
        return builtin::f64_abs(x);
    }

    /// Ceiling (round toward +infinity)
    pub fn ceil(x: f64) -> f64 {
        return builtin::f64_ceil(x);
    }

    /// Floor (round toward -infinity)
    pub fn floor(x: f64) -> f64 {
        return builtin::f64_floor(x);
    }

    /// Truncate toward zero
    pub fn trunc(x: f64) -> f64 {
        return builtin::f64_trunc(x);
    }

    /// Round to nearest even
    pub fn round(x: f64) -> f64 {
        return builtin::f64_nearest(x);
    }

    /// Square root
    pub fn sqrt(x: f64) -> f64 {
        return builtin::f64_sqrt(x);
    }

    /// Minimum of two values
    pub fn min(x: f64, y: f64) -> f64 {
        return builtin::f64_min(x, y);
    }

    /// Maximum of two values
    pub fn max(x: f64, y: f64) -> f64 {
        return builtin::f64_max(x, y);
    }

    /// Copy sign from y to x
    pub fn copysign(x: f64, y: f64) -> f64 {
        return builtin::f64_copysign(x, y);
    }

    /// Sine (in radians)
    pub fn sin(x: f64) -> f64 {
        return f64_sin(x);
    }

    /// Cosine (in radians)
    pub fn cos(x: f64) -> f64 {
        return f64_cos(x);
    }

    /// Tangent (in radians)
    pub fn tan(x: f64) -> f64 {
        return f64_tan(x);
    }

    /// Arc sine (returns radians)
    pub fn asin(x: f64) -> f64 {
        return f64_asin(x);
    }

    /// Arc cosine (returns radians)
    pub fn acos(x: f64) -> f64 {
        return f64_acos(x);
    }

    /// Arc tangent (returns radians)
    pub fn atan(x: f64) -> f64 {
        return f64_atan(x);
    }

    /// Arc tangent of y/x (returns radians)
    pub fn atan2(y: f64, x: f64) -> f64 {
        return f64_atan2(y, x);
    }

    /// Hyperbolic sine
    pub fn sinh(x: f64) -> f64 {
        return f64_sinh(x);
    }

    /// Hyperbolic cosine
    pub fn cosh(x: f64) -> f64 {
        return f64_cosh(x);
    }

    /// Hyperbolic tangent
    pub fn tanh(x: f64) -> f64 {
        return f64_tanh(x);
    }

    /// Inverse hyperbolic sine
    pub fn asinh(x: f64) -> f64 {
        return f64_asinh(x);
    }

    /// Inverse hyperbolic cosine
    pub fn acosh(x: f64) -> f64 {
        return f64_acosh(x);
    }

    /// Inverse hyperbolic tangent
    pub fn atanh(x: f64) -> f64 {
        return f64_atanh(x);
    }

    /// e raised to the power x
    pub fn exp(x: f64) -> f64 {
        return f64_exp(x);
    }

    /// 2 raised to the power x
    pub fn exp2(x: f64) -> f64 {
        return f64_exp2(x);
    }

    /// e^x - 1 (more accurate for small x)
    pub fn expm1(x: f64) -> f64 {
        return f64_expm1(x);
    }

    /// Natural logarithm (base e)
    pub fn ln(x: f64) -> f64 {
        return f64_ln(x);
    }

    /// Logarithm base 2
    pub fn log2(x: f64) -> f64 {
        return f64_log2(x);
    }

    /// Logarithm base 10
    pub fn log10(x: f64) -> f64 {
        return f64_log10(x);
    }

    /// ln(1 + x) (more accurate for small x)
    pub fn ln1p(x: f64) -> f64 {
        return f64_ln1p(x);
    }

    /// x raised to the power y
    pub fn pow(x: f64, y: f64) -> f64 {
        return f64_pow(x, y);
    }

    /// Cube root
    pub fn cbrt(x: f64) -> f64 {
        return f64_cbrt(x);
    }

    /// Euclidean distance: sqrt(x^2 + y^2)
    pub fn hypot(x: f64, y: f64) -> f64 {
        return f64_hypot(x, y);
    }

    /// Floating-point remainder of x/y
    pub fn fmod(x: f64, y: f64) -> f64 {
        return f64_fmod(x, y);
    }

    pub fn is_nan(&self) -> bool {
        return *self != *self;
    }

    pub fn is_finite(&self) -> bool {
        return *self - *self == 0.0;
    }

    /// Reinterprets the bits of this f64 as an i64.
    pub fn to_bits(&self) -> i64 {
        return builtin::i64_reinterpret_f64(*self);
    }

    /// Creates an f64 from its bit representation.
    pub fn from_bits(bits: i64) -> f64 {
        return builtin::f64_reinterpret_i64(bits);
    }
}

impl FromStr for f64 {
    type Err = ParseFloatError;

    fn from_str_range(s: &String, start: i32, end: i32) -> Result<f64, ParseFloatError> {
        return parse_f64_from_str_range(s, start, end);
    }
}

impl Display for () {
    pub fn fmt(&self, f: &mut Formatter) {
        f.write_str(&"()");
    }
}

