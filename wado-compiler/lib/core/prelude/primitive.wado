impl OctalAlt for i64 {
    pub fn fmt_alt(&self, f: &mut Formatter) {
        let v = *self;
        let is_neg = v < 0;
        if v == i64::MIN {
            let half: i64 = 4611686018427387904;
            half.fmt_base(true, f, 8, false, "0o");
        } else {
            let abs_val = if is_neg { 0 - v } else { v };
            abs_val.fmt_base(is_neg, f, 8, false, "0o");
        }
    }
