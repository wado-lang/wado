#![no_prelude]
#![stdlib("core:prelude/primitive.wado")]
// Primitive Type Methods
//
// This module provides methods for primitive types (i32, i64, f32, f64, etc.)
// through impl blocks. These are automatically available for all primitive values.
//
// This module intentionally does NOT depend on core:internal to keep the
// dependency structure simple.


use {
    check_special,
    SpecialKind,
    short,
    short32,
    fixed_width,
    fixed_width_for_prec,
    digits,
    format_decimal,
    format_exp,
    format_decimal_prec,
    format_exp_prec,
    write_decimal,
    write_exp,
    write_decimal_prec,
    write_exp_prec,
} from "core:prelude/fpfmt.wado";

// Deterministic math functions imported directly from the bundled
// `core:libm.wat` asset (compiled from the Rust `libm` crate). The
// loader synthesises Wado bindings from the wat module's exports — see
// `docs/wep-2026-01-10-wasm-import.md`. Names are remapped onto the
// Wado-side identifiers used by the impl blocks below
// (`libm_log` → `f64_ln`, etc.).
use {
    libm_sin as f64_sin,
    libm_cos as f64_cos,
    libm_tan as f64_tan,
    libm_asin as f64_asin,
    libm_acos as f64_acos,
    libm_atan as f64_atan,
    libm_atan2 as f64_atan2,
    libm_sinh as f64_sinh,
    libm_cosh as f64_cosh,
    libm_tanh as f64_tanh,
    libm_asinh as f64_asinh,
    libm_acosh as f64_acosh,
    libm_atanh as f64_atanh,
    libm_exp as f64_exp,
    libm_exp2 as f64_exp2,
    libm_expm1 as f64_expm1,
    libm_log as f64_ln,
    libm_log2 as f64_log2,
    libm_log10 as f64_log10,
    libm_log1p as f64_ln1p,
    libm_pow as f64_pow,
    libm_cbrt as f64_cbrt,
    libm_hypot as f64_hypot,
    libm_fmod as f64_fmod,
    libm_sinf as f32_sin,
    libm_cosf as f32_cos,
    libm_tanf as f32_tan,
    libm_asinf as f32_asin,
    libm_acosf as f32_acos,
    libm_atanf as f32_atan,
    libm_atan2f as f32_atan2,
    libm_sinhf as f32_sinh,
    libm_coshf as f32_cosh,
    libm_tanhf as f32_tanh,
    libm_asinhf as f32_asinh,
    libm_acoshf as f32_acosh,
    libm_atanhf as f32_atanh,
    libm_expf as f32_exp,
    libm_exp2f as f32_exp2,
    libm_expm1f as f32_expm1,
    libm_logf as f32_ln,
    libm_log2f as f32_log2,
    libm_log10f as f32_log10,
    libm_log1pf as f32_ln1p,
    libm_powf as f32_pow,
    libm_cbrtf as f32_cbrt,
    libm_hypotf as f32_hypot,
    libm_fmodf as f32_fmod,
} from "../libm.wat" with { type: "wat" };

use {
    IntErrorKind,
    ParseIntError,
    ParseFloatError,
    parse_i64_radix,
    parse_u64_radix,
    parse_i64_radix_range,
    parse_u64_radix_range,
    parse_f64_from_str_range,
} from "core:prelude/intparse.wado";

/// Copy bytes from linear memory to a new GC array (internal helper)
fn memory_to_gc_array(ptr: i32, len: i32) -> builtin::array<u8> {
    let arr: builtin::array<u8> = builtin::array_new(len);
    for let mut i = 0; i < len; i += 1 {
        builtin::array_set_u8(arr, i, builtin::i32_load8_u(ptr + i) as u8);
    }
    return arr;
}

// These write formatted values directly to a Formatter's buffer,
// avoiding intermediate GC String allocations in the common case.

/// Count decimal digits of a non-negative i64 value.
fn count_digits_i64(val: i64) -> i32 {
    if val == 0 {
        return 1;
    }
    let mut n: i32 = 0;
    for let mut t = val; t > 0; t = t / 10 {
        n += 1;
    }
    return n;
}

/// Write `digit_count` decimal digits of `abs_val` backwards into `arr` starting at `offset`.
fn write_decimal_digits(arr: builtin::array<u8>, offset: i32, abs_val: i64, digit_count: i32) {
    let mut pos = offset + digit_count;
    if abs_val == 0 {
        builtin::array_set_u8(arr, offset, '0' as u8);
    } else {
        for let mut temp = abs_val; temp > 0; temp = temp / 10 {
            pos -= 1;
            builtin::array_set_u8(arr, pos, ('0' as i32 + (temp % 10) as i32) as u8);
        }
    }
}

/// Write `digit_count` digits of `abs_val` in given base backwards into `arr` at `offset`.
fn write_base_digits(arr: builtin::array<u8>, offset: i32, abs_val: i64, digit_count: i32, base: i32, upper: bool) {
    let base64 = base as i64;
    let mut pos = offset + digit_count;
    if abs_val == 0 {
        builtin::array_set_u8(arr, offset, '0' as u8);
    } else {
        for let mut temp = abs_val; temp > 0; temp = temp / base64 {
            pos -= 1;
            let digit: i32 = (temp % base64) as i32;
            let ch = if digit < 10 {
                '0' as i32 + digit;
            } else if upper {
                'A' as i32 + digit - 10;
            } else {
                'a' as i32 + digit - 10;
            };
            builtin::array_set_u8(arr, pos, ch as u8);
        }
    }
}

/// Count digits of a non-negative i64 value in the given base.
fn count_digits_base(val: i64, base: i32) -> i32 {
    if val == 0 {
        return 1;
    }
    let base64 = base as i64;
    let mut n: i32 = 0;
    for let mut t = val; t > 0; t = t / base64 {
        n += 1;
    }
    return n;
}

/// Count digits of a u64 value (as raw i64 bits) in the given power-of-2 base.
/// `bits_per_digit` is log2(base): 1 for binary, 3 for octal, 4 for hex.
fn count_digits_u64_base(val_i64: i64, bits_per_digit: i32) -> i32 {
    if val_i64 == 0 {
        return 1;
    }
    // Count leading zeros manually: find highest set bit
    let mut highest_bit: i32 = 0;
    // Check high 32 bits
    let high32: i64 = val_i64 >> 32 & 0xFFFFFFFF;
    if high32 != 0 {
        // Bit is somewhere in bits 32..63
        let mut b: i32 = 63;
        while b >= 32 {
            if val_i64 >> b as i64 & 1 != 0 {
                highest_bit = b;
                break;
            }
            b -= 1;
        }
    } else {
        // Bit is somewhere in bits 0..31
        let mut b: i32 = 31;
        while b >= 0 {
            if val_i64 >> b as i64 & 1 != 0 {
                highest_bit = b;
                break;
            }
            b -= 1;
        }
    }
    return highest_bit / bits_per_digit + 1;
}

/// Write digits of a u64 value (as raw i64 bits) in a power-of-2 base.
fn write_u64_base_digits(arr: builtin::array<u8>, offset: i32, val_i64: i64, digit_count: i32, bits_per_digit: i32, mask: i32, upper: bool) {
    let mask64 = mask as i64;
    let mut pos = offset + digit_count;
    if val_i64 == 0 {
        builtin::array_set_u8(arr, offset, '0' as u8);
    } else {
        let mut temp: i64 = val_i64;
        while temp != 0 {
            pos -= 1;
            let digit: i32 = (temp & mask64) as i32;
            let ch = if digit < 10 {
                '0' as i32 + digit;
            } else if upper {
                'A' as i32 + digit - 10;
            } else {
                'a' as i32 + digit - 10;
            };
            builtin::array_set_u8(arr, pos, ch as u8);
            // Unsigned right shift: use Wasm's i64.shr_u semantics
            // In Wado, >> on i64 is arithmetic shift. For unsigned shift we need:
            // (val as u64 >> bits) as i64
            let shift_u64: u64 = bits_per_digit as u64;
            temp = (temp as u64 >> shift_u64) as i64;
        }
    }
}


impl () {
    pub fn to_string(&self) -> String {
        return "()";
    }
}

impl bool {
    fn fmt_into(&self, f: &mut Formatter) {
        f.pad(if *self { "true" } else { "false" });
    }

    pub fn to_string(&self) -> String {
        let mut buf = String::with_capacity(5);
        let mut f = Formatter::new(&mut buf);
        self.fmt_into(&mut f);
        return buf;
    }
}

impl char {
    /// Converts a Unicode scalar value (u32) to a char.
    /// Returns null if the value is not a valid Unicode scalar value
    /// (i.e., surrogates 0xD800..0xDFFF or values > 0x10FFFF).
    pub fn from_u32(value: u32) -> Option<char> {
        if value > 0x10FFFF {
            return null;
        }
        if value >= 0xD800 && value <= 0xDFFF {
            return null;
        }
        return Option::Some(char::from_u32_unchecked(value));
    }

    /// Converts a signed integer to a char.
    /// Returns null if the value is negative or not a valid Unicode scalar value.
    pub fn from_i32(value: i32) -> Option<char> {
        if value < 0 {
            return null;
        }
        return char::from_u32(value as u32);
    }

    /// Converts a u32 to a char without validation.
    /// The caller must ensure the value is a valid Unicode scalar value
    /// (0..=0xD7FF or 0xE000..=0x10FFFF). Passing an invalid value
    /// results in an invalid char, which may cause incorrect behavior
    /// in string operations.
    pub fn from_u32_unchecked(value: u32) -> char {
        return builtin::i32_as_char(value as i32);
    }

    pub fn to_string(&self) -> String {
        let mut buf = String::with_capacity(4);
        buf.push(*self);
        return buf;
    }

    /// Returns true if the character is an ASCII whitespace character:
    /// SP (0x20), HT (0x09), LF (0x0A), VT (0x0B), FF (0x0C), CR (0x0D).
    /// Matches POSIX isspace() for the ASCII range.
    pub fn is_ascii_whitespace(&self) -> bool {
        return match *self {
            ' ' => true,
            '\t' => true,
            '\n' => true,
            '\r' => true,
            '\u{0B}' => true,
            '\u{0C}' => true,
            _ => false,
        };
    }

    /// Returns true if the character is a Unicode whitespace character.
    /// Covers ASCII whitespace plus Unicode general category Zs/Zl/Zp code points.
    pub fn is_whitespace(&self) -> bool {
        return match *self {
            ' ' => true,  // SP
            '\t' => true,  // HT
            '\n' => true,  // LF
            '\r' => true,  // CR
            '\u{0B}' => true,  // VT
            '\u{0C}' => true,  // FF
            '\u{85}' => true,  // NEXT LINE
            '\u{A0}' => true,  // NO-BREAK SPACE
            '\u{1680}' => true,  // OGHAM SPACE MARK
            '\u{2000}' => true,  // EN QUAD
            '\u{2001}' => true,  // EM QUAD
            '\u{2002}' => true,  // EN SPACE
            '\u{2003}' => true,  // EM SPACE
            '\u{2004}' => true,  // THREE-PER-EM SPACE
            '\u{2005}' => true,  // FOUR-PER-EM SPACE
            '\u{2006}' => true,  // SIX-PER-EM SPACE
            '\u{2007}' => true,  // FIGURE SPACE
            '\u{2008}' => true,  // PUNCTUATION SPACE
            '\u{2009}' => true,  // THIN SPACE
            '\u{200A}' => true,  // HAIR SPACE
            '\u{2028}' => true,  // LINE SEPARATOR
            '\u{2029}' => true,  // PARAGRAPH SEPARATOR
            '\u{202F}' => true,  // NARROW NO-BREAK SPACE
            '\u{205F}' => true,  // MEDIUM MATHEMATICAL SPACE
            '\u{3000}' => true,  // IDEOGRAPHIC SPACE
            _ => false,
        };
    }

    /// Returns true if the character is an ASCII lowercase letter: a-z.
    pub fn is_ascii_lowercase(&self) -> bool {
        return *self >= 'a' && *self <= 'z';
    }

    /// Returns true if the character is an ASCII uppercase letter: A-Z.
    pub fn is_ascii_uppercase(&self) -> bool {
        return *self >= 'A' && *self <= 'Z';
    }

    /// Converts an ASCII uppercase letter to lowercase. Non-ASCII and
    /// non-uppercase characters are returned unchanged.
    pub fn to_ascii_lowercase(&self) -> char {
        let c = *self as u32;
        return char::from_u32_unchecked(c | self.is_ascii_uppercase() as u32 * ('A' as u32 ^ 'a' as u32));
    }

    /// Converts an ASCII lowercase letter to uppercase. Non-ASCII and
    /// non-lowercase characters are returned unchanged.
    pub fn to_ascii_uppercase(&self) -> char {
        let c = *self as u32;
        return char::from_u32_unchecked(c ^ self.is_ascii_lowercase() as u32 * ('A' as u32 ^ 'a' as u32));
    }

    /// Checks that two characters are an ASCII case-insensitive match.
    ///
    /// Equivalent to `to_ascii_lowercase() == other.to_ascii_lowercase()`,
    /// but implemented branchlessly.
    pub fn eq_ignore_ascii_case(&self, other: &char) -> bool {
        return self.to_ascii_lowercase() == other.to_ascii_lowercase();
    }

    /// Returns true if the character is a hexadecimal digit: 0-9, a-f, A-F.
    pub fn is_hexdigit(&self) -> bool {
        let c = *self;
        return c >= '0' && c <= '9' || c >= 'a' && c <= 'f' || c >= 'A' && c <= 'F';
    }

    /// Returns the numeric value of an ASCII hexadecimal digit (0–15).
    /// Panics if the character is not a valid hex digit.
    pub fn hex_digit_value(&self) -> i32 {
        let c = *self;
        if c >= '0' && c <= '9' {
            return c as i32 - '0' as i32;
        }
        if c >= 'a' && c <= 'f' {
            return c as i32 - 'a' as i32 + 10;
        }
        if c >= 'A' && c <= 'F' {
            return c as i32 - 'A' as i32 + 10;
        }
        panic("char::hex_digit_value: not a hex digit");
    }

    /// Returns the number of bytes this character needs in UTF-8 encoding.
    pub fn len_utf8(&self) -> i32 {
        let cp = *self as i32;
        if cp < 0x80 {
            return 1;
        }
        if cp < 0x800 {
            return 2;
        }
        if cp < 0x10000 {
            return 3;
        }
        return 4;
    }

    /// Encodes this character as UTF-8, returning the bytes.
    pub fn encode_utf8(&self) -> Array<u8> {
        let cp = *self as i32;
        if cp < 0x80 {
            return [cp as u8] as Array<u8>;
        }
        if cp < 0x800 {
            let mut buf: Array<u8> = Array::with_capacity(2);
            buf.push((0xC0 | cp >> 6) as u8);
            buf.push((0x80 | cp & 0x3F) as u8);
            return buf;
        }
        if cp < 0x10000 {
            let mut buf: Array<u8> = Array::with_capacity(3);
            buf.push((0xE0 | cp >> 12) as u8);
            buf.push((0x80 | cp >> 6 & 0x3F) as u8);
            buf.push((0x80 | cp & 0x3F) as u8);
            return buf;
        }
        let mut buf: Array<u8> = Array::with_capacity(4);
        buf.push((0xF0 | cp >> 18) as u8);
        buf.push((0x80 | cp >> 12 & 0x3F) as u8);
        buf.push((0x80 | cp >> 6 & 0x3F) as u8);
        buf.push((0x80 | cp & 0x3F) as u8);
        return buf;
    }
}

impl i8 {
    pub const MAX: i8 = 127;
    pub const MIN: i8 = -128;

    pub fn max(a: i8, b: i8) -> i8 {
        return builtin::select(a > b, a, b);
    }

    pub fn min(a: i8, b: i8) -> i8 {
        return builtin::select(a < b, a, b);
    }

    fn fmt_into(&self, f: &mut Formatter) {
        (*self as i32).fmt_decimal(f);
    }

    pub fn to_string(&self) -> String {
        let mut buf = String::with_capacity(5);
        let mut f = Formatter::new(&mut buf);
        self.fmt_into(&mut f);
        return buf;
    }

    pub fn from_str_hex(s: &String) -> Result<i8, ParseIntError> {
        return i8::from_str_radix(s, 16);
    }

    pub fn from_str_radix(s: &String, radix: u32) -> Result<i8, ParseIntError> {
        return match parse_i64_radix(s, radix, 127, 128) {
            Ok(v) => Result::Ok(v as i8),
            Err(e) => Result::Err(e),
        };
    }
}

impl FromStr for i8 {
    type Err = ParseIntError;

    fn from_str_range(s: &String, start: i32, end: i32) -> Result<i8, ParseIntError> {
        return match parse_i64_radix_range(s, start, end, 10, 127, 128) {
            Ok(v) => Result::Ok(v as i8),
            Err(e) => Result::Err(e),
        };
    }
}

