impl TryFrom<i64> for f32 {
    type Error = ConvertError;

    pub fn try_from(value: i64) -> Result<f32, ConvertError> {
        let f = value as f32;
        if f as i64 != value {
            return Result::Err(ConvertError::new(`{value} cannot be exactly represented as f32`));
        }
        return Result::Ok(f);
    }
}

impl TryFrom<i64> for f64 {
    type Error = ConvertError;

    pub fn try_from(value: i64) -> Result<f64, ConvertError> {
        let f = value as f64;
        if f as i64 != value {
            return Result::Err(ConvertError::new(`{value} cannot be exactly represented as f64`));
        }
        return Result::Ok(f);
    }
}

