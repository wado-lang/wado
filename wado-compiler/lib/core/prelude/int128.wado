// 128-bit Integer Types
// Implemented as structs wrapping two 64-bit values, using Wasm Wide Arithmetic instructions.

/// Unsigned 128-bit integer
/// Stored as two 64-bit parts: low (bits 0-63) and high (bits 64-127)
pub struct u128 {
    low: u64,
    high: u64,
}

impl u128 {
    /// Create a u128 from a u64 value (zero-extended)
    pub fn from_u64(value: u64) -> u128 {
        return u128 { low: value, high: 0 };
    }

    /// Create a u128 from a string (decimal representation)
    /// Used for literal coercion: `let x: u128 = "12345678901234567890"`
    pub fn from_string(s: String) -> u128 {
        let mut result = u128::zero();
        let mut i = 0;
        let len = s.len();
        while i < len {
            let byte = s.get(i);
            let digit = byte - ('0' as i32);
            if 0 <= digit && digit <= 9 {
                let digit_u64: u64 = digit as u64;
                result = result.mul_u64(10 as u64).add(&u128::from_u64(digit_u64));
            }
            i += 1;
        }
        return result;
    }

    /// Create a zero u128
    pub fn zero() -> u128 {
        return u128 { low: 0, high: 0 };
    }

    /// Create a u128 with value 1
    pub fn one() -> u128 {
        return u128 { low: 1, high: 0 };
    }

    /// Get the low 64 bits
    pub fn low(&self) -> u64 {
        return self.low;
    }

    /// Get the high 64 bits
    pub fn high(&self) -> u64 {
        return self.high;
    }

    /// Multiply u128 by a u64 value
    pub fn mul_u64(&self, multiplier: u64) -> u128 {
        // (high, low) * multiplier
        // = low * multiplier + (high * multiplier) << 64
        let low_prod = builtin::i64_mul_wide_u(self.low as i64, multiplier as i64);
        let high_prod = builtin::i64_mul_wide_u(self.high as i64, multiplier as i64);
        // result.low = low_prod.0
        // result.high = low_prod.1 + high_prod.0 (ignore overflow)
        let result_high = (low_prod.1 as u64) + (high_prod.0 as u64);
        return u128 {
            low: low_prod.0 as u64,
            high: result_high,
        };
    }

    /// Add two u128 values
    pub fn add(&self, other: &u128) -> u128 {
        let result = builtin::i64_add128(
            self.low as i64,
            self.high as i64,
            other.low as i64,
            other.high as i64,
        );
        return u128 {
            low: result.0 as u64,
            high: result.1 as u64,
        };
    }

    /// Subtract two u128 values (self - other)
    pub fn sub(&self, other: &u128) -> u128 {
        let result = builtin::i64_sub128(
            self.low as i64,
            self.high as i64,
            other.low as i64,
            other.high as i64,
        );
        return u128 {
            low: result.0 as u64,
            high: result.1 as u64,
        };
    }

    /// Divide self by divisor, returning (quotient, remainder)
    /// Uses binary long division algorithm (shift-subtract)
    /// Panics if divisor is zero
    pub fn div_rem(&self, divisor: &u128) -> [u128, u128] {
        // Check for division by zero
        if divisor.low == (0 as u64) && divisor.high == (0 as u64) {
            panic("division by zero");
        }

        // Quick return if dividend < divisor
        if *self < *divisor {
            return [u128::zero(), *self];
        }

        // Quick return if dividend == divisor
        if *self == *divisor {
            return [u128::one(), u128::zero()];
        }

        // Binary long division
        let mut quotient = u128::zero();
        let mut remainder = u128::zero();
        let one = u128::one();

        // Process each bit from high to low (bit 127 down to bit 0)
        let mut i: i32 = 127;
        while i >= 0 {
            // remainder = remainder << 1
            remainder = remainder << (1 as u32);

            // Get bit i of dividend and set bit 0 of remainder
            let bit = self.get_bit(i);
            if bit {
                remainder = remainder | one;
            }

            // If remainder >= divisor, subtract and set quotient bit
            if remainder >= *divisor {
                remainder = remainder - *divisor;
                quotient = quotient.set_bit(i);
            }

            i -= 1;
        }

        return [quotient, remainder];
    }

    /// Get the bit at position i (0 = LSB, 127 = MSB)
    pub fn get_bit(&self, i: i32) -> bool {
        let shift: i64 = i as i64;
        if i < 64 {
            return ((self.low >> (shift as u64)) & (1 as u64)) != (0 as u64);
        } else {
            let s: i64 = (i - 64) as i64;
            return ((self.high >> (s as u64)) & (1 as u64)) != (0 as u64);
        }
    }

    /// Set the bit at position i to 1, returning a new u128
    pub fn set_bit(&self, i: i32) -> u128 {
        let shift: i64 = i as i64;
        if i < 64 {
            return u128 {
                low: self.low | ((1 as u64) << (shift as u64)),
                high: self.high,
            };
        } else {
            let s: i64 = (i - 64) as i64;
            return u128 {
                low: self.low,
                high: self.high | ((1 as u64) << (s as u64)),
            };
        }
    }

    /// Convert u128 to String (for template string interpolation)
    pub fn to_string(&self) -> String {
        // Handle zero case
        if *self == u128::zero() {
            return "0";
        }

        // Allocate buffer in linear memory (40 bytes max: 39 digits + safety)
        let ptr: i32 = builtin::realloc(0, 0, 1, 40);

        // Convert digits in reverse order by repeatedly dividing by 10
        let mut pos: i32 = 39;
        let mut temp = *self;
        let ten = u128::from_u64(10 as u64);

        while temp > u128::zero() {
            pos -= 1;
            let result = temp.div_rem(&ten);
            let rem: u128 = result[1];
            let digit_u64: u64 = rem.low();
            let digit: i32 = (digit_u64 as i64) as i32;
            builtin::memory_store8(ptr + pos, ('0' as i32) + digit);
            temp = result[0];
        }

        // Calculate length and copy to GC string
        let len: i32 = 39 - pos;
        let result = builtin::string_new(len);
        for (let mut i: i32 = 0; i < len; i += 1) {
            let byte: i32 = builtin::memory_load8_u(ptr + pos + i);
            result.set(i, byte);
        }

        // Free linear memory buffer
        builtin::realloc(ptr, 40, 1, 0);

        return result;
    }
}

// Eq implementation for u128
impl Eq for u128 {
    pub fn eq(&self, other: &Self) -> bool {
        return self.low == other.low && self.high == other.high;
    }
}

// Ord implementation for u128
impl Ord for u128 {
    pub fn lt(&self, other: &Self) -> bool {
        if self.high < other.high {
            return true;
        }
        if self.high > other.high {
            return false;
        }
        return self.low < other.low;
    }
}

// Add implementation for u128
impl Add for u128 {
    type Output = u128;

    pub fn add(&self, other: &Self) -> Self::Output {
        let result = builtin::i64_add128(
            self.low as i64,
            self.high as i64,
            other.low as i64,
            other.high as i64,
        );
        return u128 {
            low: result.0 as u64,
            high: result.1 as u64,
        };
    }
}

// Sub implementation for u128
impl Sub for u128 {
    type Output = u128;

    pub fn sub(&self, other: &Self) -> Self::Output {
        let result = builtin::i64_sub128(
            self.low as i64,
            self.high as i64,
            other.low as i64,
            other.high as i64,
        );
        return u128 {
            low: result.0 as u64,
            high: result.1 as u64,
        };
    }
}

// Mul implementation for u128
impl Mul for u128 {
    type Output = u128;

    pub fn mul(&self, other: &Self) -> Self::Output {
        // (aH, aL) * (bH, bL) = aL*bL + (aL*bH + aH*bL) << 64 + (aH*bH) << 128
        // Since we only keep lower 128 bits, aH*bH is ignored (overflow)
        // aL*bL gives full 128 bits via mul_wide_u
        // aL*bH and aH*bL only contribute their low 64 bits to result.high

        // aL * bL -> 128-bit result (p0_low, p0_high)
        let p0 = builtin::i64_mul_wide_u(self.low as i64, other.low as i64);
        let p0_low = p0.0 as u64;
        let p0_high = p0.1 as u64;

        // aL * bH -> only need low 64 bits (will be added to high)
        let p1_low = self.low * other.high;

        // aH * bL -> only need low 64 bits (will be added to high)
        let p2_low = self.high * other.low;

        // result.low = p0_low
        // result.high = p0_high + p1_low + p2_low (overflow ignored)
        return u128 {
            low: p0_low,
            high: p0_high + p1_low + p2_low,
        };
    }
}

// BitAnd implementation for u128
impl BitAnd for u128 {
    type Output = u128;

    pub fn bitand(&self, other: &Self) -> Self::Output {
        return u128 {
            low: self.low & other.low,
            high: self.high & other.high,
        };
    }
}

// BitOr implementation for u128
impl BitOr for u128 {
    type Output = u128;

    pub fn bitor(&self, other: &Self) -> Self::Output {
        return u128 {
            low: self.low | other.low,
            high: self.high | other.high,
        };
    }
}

// BitXor implementation for u128
impl BitXor for u128 {
    type Output = u128;

    pub fn bitxor(&self, other: &Self) -> Self::Output {
        return u128 {
            low: self.low ^ other.low,
            high: self.high ^ other.high,
        };
    }
}

// BitNot implementation for u128
impl BitNot for u128 {
    type Output = u128;

    pub fn bitnot(&self) -> Self::Output {
        return u128 {
            low: ~self.low,
            high: ~self.high,
        };
    }
}

// Shl implementation for u128
impl Shl for u128 {
    type Output = u128;

    pub fn shl(&self, rhs: u32) -> Self::Output {
        let shift = rhs as i32;
        if shift >= 128 {
            return u128::zero();
        }
        if shift >= 64 {
            // All low bits shift into high, low becomes 0
            let s = (shift - 64) as u64;
            return u128 {
                low: 0,
                high: self.low << s,
            };
        }
        if shift == 0 {
            return *self;
        }
        // 0 < shift < 64
        let s = shift as u64;
        let inv_s = (64 - shift) as u64;
        return u128 {
            low: self.low << s,
            high: (self.high << s) | (self.low >> inv_s),
        };
    }
}

// Shr implementation for u128 (logical/unsigned shift)
impl Shr for u128 {
    type Output = u128;

    pub fn shr(&self, rhs: u32) -> Self::Output {
        let shift = rhs as i32;
        if shift >= 128 {
            return u128::zero();
        }
        if shift >= 64 {
            // All high bits shift into low, high becomes 0
            let s = (shift - 64) as u64;
            return u128 {
                low: self.high >> s,
                high: 0,
            };
        }
        if shift == 0 {
            return *self;
        }
        // 0 < shift < 64
        let s = shift as u64;
        let inv_s = (64 - shift) as u64;
        return u128 {
            low: (self.low >> s) | (self.high << inv_s),
            high: self.high >> s,
        };
    }
}

// Div implementation for u128
impl Div for u128 {
    type Output = u128;

    pub fn div(&self, other: &Self) -> Self::Output {
        let result = self.div_rem(other);
        return result[0];
    }
}

// Rem implementation for u128
impl Rem for u128 {
    type Output = u128;

    pub fn rem(&self, other: &Self) -> Self::Output {
        let result = self.div_rem(other);
        return result[1];
    }
}

/// Signed 128-bit integer
/// Stored as two 64-bit parts: low (bits 0-63, unsigned) and high (bits 64-127, signed)
pub struct i128 {
    low: u64,
    high: i64,
}

impl i128 {
    /// Create an i128 from an i64 value (sign-extended)
    pub fn from_i64(value: i64) -> i128 {
        // Sign extend: if value is negative, high bits are all 1s (-1)
        let high: i64 = if value < (0 as i64) { -1 as i64 } else { 0 as i64 };
        return i128 { low: value as u64, high };
    }

    /// Create an i128 from a string (decimal representation, optionally prefixed with '-')
    /// Used for literal coercion: `let x: i128 = "-12345678901234567890"`
    pub fn from_string(s: String) -> i128 {
        let len = s.len();
        if len == 0 {
            return i128::zero();
        }

        // Check for negative sign
        let first_byte = s.get(0);
        let is_negative = first_byte == ('-' as i32);
        let start_idx = if is_negative { 1 } else { 0 };

        // Parse the absolute value as u128
        let mut abs_value = u128::zero();
        let mut i = start_idx;
        while i < len {
            let byte = s.get(i);
            let digit = byte - ('0' as i32);
            if 0 <= digit && digit <= 9 {
                abs_value = abs_value.mul_u64(10 as u64).add(&u128::from_u64(digit as u64));
            }
            i += 1;
        }

        // Convert to i128
        let result = i128 { low: abs_value.low, high: abs_value.high as i64 };
        if is_negative {
            return result.neg();
        }
        return result;
    }

    /// Create a zero i128
    pub fn zero() -> i128 {
        return i128 { low: 0, high: 0 };
    }

    /// Create an i128 with value 1
    pub fn one() -> i128 {
        return i128 { low: 1, high: 0 };
    }

    /// Get the low 64 bits (unsigned)
    pub fn low(&self) -> u64 {
        return self.low;
    }

    /// Get the high 64 bits (signed)
    pub fn high(&self) -> i64 {
        return self.high;
    }

    /// Check if this i128 is negative
    pub fn is_negative(&self) -> bool {
        return self.high < (0 as i64);
    }

    /// Add two i128 values
    pub fn add(&self, other: &i128) -> i128 {
        let result = builtin::i64_add128(
            self.low as i64,
            self.high,
            other.low as i64,
            other.high,
        );
        return i128 {
            low: result.0 as u64,
            high: result.1,
        };
    }

    /// Subtract two i128 values (self - other)
    pub fn sub(&self, other: &i128) -> i128 {
        let result = builtin::i64_sub128(
            self.low as i64,
            self.high,
            other.low as i64,
            other.high,
        );
        return i128 {
            low: result.0 as u64,
            high: result.1,
        };
    }

    /// Negate this i128 value
    pub fn neg(&self) -> i128 {
        // -x = ~x + 1 = 0 - x
        let zero = i128::zero();
        return zero.sub(self);
    }

    /// Get absolute value as u128
    pub fn abs_u128(&self) -> u128 {
        if self.is_negative() {
            let neg = self.neg();
            return u128 { low: neg.low, high: neg.high as u64 };
        }
        return u128 { low: self.low, high: self.high as u64 };
    }

    /// Create i128 from u128 (reinterpret bits)
    pub fn from_u128(val: u128) -> i128 {
        return i128 { low: val.low, high: val.high as i64 };
    }

    /// Divide self by divisor, returning (quotient, remainder)
    /// Uses signed division semantics:
    /// - quotient is negative if signs differ
    /// - remainder has the same sign as dividend
    /// Panics if divisor is zero
    pub fn div_rem(&self, divisor: &i128) -> [i128, i128] {
        // Check for division by zero
        if divisor.low == (0 as u64) && divisor.high == (0 as i64) {
            panic("division by zero");
        }

        let dividend_neg = self.is_negative();
        let divisor_neg = divisor.is_negative();

        // Get absolute values as u128
        let abs_dividend = self.abs_u128();
        let abs_divisor = divisor.abs_u128();

        // Perform unsigned division
        let result = abs_dividend.div_rem(&abs_divisor);
        let abs_quotient = result[0];
        let abs_remainder = result[1];

        // Apply signs
        // Quotient: negative if signs differ
        let mut quotient = i128::from_u128(abs_quotient);
        if dividend_neg != divisor_neg {
            quotient = quotient.neg();
        }

        // Remainder: same sign as dividend
        let mut remainder = i128::from_u128(abs_remainder);
        if dividend_neg {
            remainder = remainder.neg();
        }

        return [quotient, remainder];
    }

    /// Convert i128 to String (for template string interpolation)
    pub fn to_string(&self) -> String {
        // Handle zero case
        if *self == i128::zero() {
            return "0";
        }

        // Check for negative
        let is_negative = self.is_negative();

        // Get absolute value as u128 and convert to string
        let abs_value = self.abs_u128();
        let abs_str = abs_value.to_string();

        // Prepend minus sign if negative
        if is_negative {
            let len = abs_str.len();
            let result = builtin::string_new(len + 1);
            result.set(0, '-' as i32);
            for (let mut i = 0; i < len; i += 1) {
                result.set(i + 1, abs_str.get(i));
            }
            return result;
        }

        return abs_str;
    }
}

// Eq implementation for i128
impl Eq for i128 {
    pub fn eq(&self, other: &Self) -> bool {
        return self.low == other.low && self.high == other.high;
    }
}

// Ord implementation for i128 (signed comparison)
impl Ord for i128 {
    pub fn lt(&self, other: &Self) -> bool {
        // For signed comparison:
        // 1. Compare high parts as signed
        // 2. If equal, compare low parts as unsigned
        if self.high < other.high {
            return true;
        }
        if self.high > other.high {
            return false;
        }
        return self.low < other.low;
    }
}

// Add implementation for i128
impl Add for i128 {
    type Output = i128;

    pub fn add(&self, other: &Self) -> Self::Output {
        let result = builtin::i64_add128(
            self.low as i64,
            self.high,
            other.low as i64,
            other.high,
        );
        return i128 {
            low: result.0 as u64,
            high: result.1,
        };
    }
}

// Sub implementation for i128
impl Sub for i128 {
    type Output = i128;

    pub fn sub(&self, other: &Self) -> Self::Output {
        let result = builtin::i64_sub128(
            self.low as i64,
            self.high,
            other.low as i64,
            other.high,
        );
        return i128 {
            low: result.0 as u64,
            high: result.1,
        };
    }
}

// Mul implementation for i128
impl Mul for i128 {
    type Output = i128;

    pub fn mul(&self, other: &Self) -> Self::Output {
        // Two's complement multiplication: lower 128 bits are the same as unsigned
        // (aH, aL) * (bH, bL) = aL*bL + (aL*bH + aH*bL) << 64 + (aH*bH) << 128
        // Since we only keep lower 128 bits, aH*bH is ignored (overflow)

        // aL * bL -> 128-bit result (p0_low, p0_high)
        let p0 = builtin::i64_mul_wide_u(self.low as i64, other.low as i64);
        let p0_low = p0.0 as u64;
        let p0_high = p0.1 as u64;

        // aL * bH -> only need low 64 bits (will be added to high)
        // Treat as unsigned multiplication (low bits are the same)
        let p1_low = self.low * (other.high as u64);

        // aH * bL -> only need low 64 bits (will be added to high)
        let p2_low = (self.high as u64) * other.low;

        // result.low = p0_low
        // result.high = p0_high + p1_low + p2_low (overflow ignored)
        return i128 {
            low: p0_low,
            high: (p0_high + p1_low + p2_low) as i64,
        };
    }
}

// Neg implementation for i128
impl Neg for i128 {
    type Output = i128;

    pub fn neg(&self) -> Self::Output {
        // -x = ~x + 1 = 0 - x
        let zero = i128::zero();
        return zero.sub(self);
    }
}

// BitAnd implementation for i128
impl BitAnd for i128 {
    type Output = i128;

    pub fn bitand(&self, other: &Self) -> Self::Output {
        return i128 {
            low: self.low & other.low,
            high: self.high & other.high,
        };
    }
}

// BitOr implementation for i128
impl BitOr for i128 {
    type Output = i128;

    pub fn bitor(&self, other: &Self) -> Self::Output {
        return i128 {
            low: self.low | other.low,
            high: self.high | other.high,
        };
    }
}

// BitXor implementation for i128
impl BitXor for i128 {
    type Output = i128;

    pub fn bitxor(&self, other: &Self) -> Self::Output {
        return i128 {
            low: self.low ^ other.low,
            high: self.high ^ other.high,
        };
    }
}

// BitNot implementation for i128
impl BitNot for i128 {
    type Output = i128;

    pub fn bitnot(&self) -> Self::Output {
        return i128 {
            low: ~self.low,
            high: ~self.high,
        };
    }
}

// Shl implementation for i128
impl Shl for i128 {
    type Output = i128;

    pub fn shl(&self, rhs: u32) -> Self::Output {
        let shift = rhs as i32;
        if shift >= 128 {
            return i128::zero();
        }
        if shift >= 64 {
            // All low bits shift into high, low becomes 0
            let s = (shift - 64) as u64;
            return i128 {
                low: 0,
                high: (self.low << s) as i64,
            };
        }
        if shift == 0 {
            return *self;
        }
        // 0 < shift < 64
        let s = shift as u64;
        let inv_s = (64 - shift) as u64;
        return i128 {
            low: self.low << s,
            high: ((self.high as u64) << s | (self.low >> inv_s)) as i64,
        };
    }
}

// Shr implementation for i128 (arithmetic/signed shift)
impl Shr for i128 {
    type Output = i128;

    pub fn shr(&self, rhs: u32) -> Self::Output {
        let shift = rhs as i32;
        if shift >= 128 {
            // Fill with sign bit
            if self.high < (0 as i64) {
                return i128 {
                    low: 0xFFFFFFFFFFFFFFFF as u64,
                    high: -1 as i64,
                };
            } else {
                return i128::zero();
            }
        }
        if shift >= 64 {
            // All high bits shift into low, high becomes sign extension
            let s = (shift - 64) as i64;
            let sign_ext: i64 = if self.high < (0 as i64) { -1 as i64 } else { 0 as i64 };
            return i128 {
                low: (self.high >> s) as u64,
                high: sign_ext,
            };
        }
        if shift == 0 {
            return *self;
        }
        // 0 < shift < 64
        let s = shift as u64;
        let inv_s = (64 - shift) as u64;
        return i128 {
            low: (self.low >> s) | ((self.high as u64) << inv_s),
            high: self.high >> (s as i64),
        };
    }
}

// Div implementation for i128
impl Div for i128 {
    type Output = i128;

    pub fn div(&self, other: &Self) -> Self::Output {
        let result = self.div_rem(other);
        return result[0];
    }
}

// Rem implementation for i128
impl Rem for i128 {
    type Output = i128;

    pub fn rem(&self, other: &Self) -> Self::Output {
        let result = self.div_rem(other);
        return result[1];
    }
}
