impl TryFrom<u128> for u64 {
    type Error = ConvertError;

    pub fn try_from(value: u128) -> Result<u64, ConvertError> {
        if value.high() != 0 {
            return Result::Err(ConvertError::new("value out of range for u64"));
        }
        return Result::Ok(value.low());
    }
}

impl TryFrom<i128> for i64 {
    type Error = ConvertError;

    pub fn try_from(value: i128) -> Result<i64, ConvertError> {
        let min: i128 = i64::MIN as i128;
        let max: i128 = i64::MAX as i128;
        if value < min || value > max {
            return Result::Err(ConvertError::new("value out of range for i64"));
        }
        return Result::Ok(value.low() as i64);
    }
}

impl TryFrom<i128> for f64 {
    type Error = ConvertError;

    pub fn try_from(value: i128) -> Result<f64, ConvertError> {
        let max: i128 = 9007199254740992;
        let min: i128 = -9007199254740992;
        if value < min || value > max {
            return Result::Err(ConvertError::new("value out of range for f64"));
        }
        return Result::Ok(value.low() as i64 as f64);
    }
}

impl TryFrom<i128> for f32 {
    type Error = ConvertError;

    pub fn try_from(value: i128) -> Result<f32, ConvertError> {
        let max: i128 = 16777216;
        let min: i128 = -16777216;
        if value < min || value > max {
            return Result::Err(ConvertError::new("value out of range for f32"));
        }
        return Result::Ok(value.low() as i64 as f32);
    }
}

