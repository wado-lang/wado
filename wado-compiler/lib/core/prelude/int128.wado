#![no_prelude]
#![stdlib("core:prelude/int128.wado")]
// 128-bit Integer Types
// Implemented as structs wrapping two 64-bit values, using Wasm Wide Arithmetic instructions.

use {
    IntErrorKind,
    ParseIntError,
    parse_u128_digits,
    parse_signed_prefix_range,
    parse_unsigned_prefix_range,
    assert_radix,
    lenient_int_preprocess,
    lenient_int_error,
} from "core:prelude/intparse.wado";
use { Array } from "core:prelude/array.wado";
use { String } from "core:prelude/string.wado";
use { Formatter } from "core:prelude/format.wado";
use { Option, Result } from "core:prelude/types.wado";
use { Step } from "core:prelude/range.wado";
use {
    Add,
    Sub,
    Mul,
    Div,
    Rem,
    Neg,
    BitAnd,
    BitOr,
    BitXor,
    BitNot,
    Shl,
    Shr,
    Eq,
    Ord,
    Ordering,
    Default,
    FromStr,
    LenientFromStr,
    LenientParseError,
    ConvertError,
    Display,
    Inspect,
    LowerExp,
    UpperExp,
    Binary,
    Octal,
    LowerHex,
    UpperHex,
} from "core:prelude/traits.wado";

/// Unsigned 128-bit integer
/// Stored as two 64-bit parts: low (bits 0-63) and high (bits 64-127)
#[compiler_item("u128")]
pub struct u128 {
    low: u64,
    high: u64,
}

impl u128 {
    /// Create a u128 from a u64 value (zero-extended)
    #[compiler_item("u128_from_u64")]
    pub fn from_u64(value: u64) -> u128 {
        return u128 { low: value, high: 0 };
    }

    /// Create a u128 from low and high 64-bit parts
    /// Used by the compiler for efficient large literal construction
    #[compiler_item("u128_from_pair")]
    pub fn from_pair(low: u64, high: u64) -> u128 {
        return u128 { low, high };
    }

    /// Parse a hexadecimal `u128` from a string (equivalent to `from_str_radix(s, 16)`).
    pub fn from_str_hex(s: &String) -> Result<u128, ParseIntError> {
        return u128::from_str_radix(s, 16);
    }

    /// Parse a `u128` from a string in the given radix. `radix` must be in 2..=36.
    pub fn from_str_radix(s: &String, radix: u32) -> Result<u128, ParseIntError> {
        return u128::from_str_radix_range(s, 0, s.len(), radix);
    }

    /// Range variant of `from_str_radix`. Parses `s[start..end)` as a `u128`
    /// in the given radix without allocating a substring.
    pub fn from_str_radix_range(s: &String, start: i32, end: i32, radix: u32) -> Result<u128, ParseIntError> {
        assert_radix(radix);
        let prefix = parse_unsigned_prefix_range(s, start, end);
        if let Err(k) = prefix {
            return Result::Err(ParseIntError::new(k));
        }
        let digit_start = prefix.unwrap();
        return match parse_u128_digits(s, digit_start, end, radix) {
            Ok(v) => Result::Ok(v),
            Err(k) => Result::Err(ParseIntError::new(k)),
        };
    }

    /// Creates a zero u128
    pub fn zero() -> u128 {
        return u128 { low: 0, high: 0 };
    }

    /// Creates a u128 with value 1
    pub fn one() -> u128 {
        return u128 { low: 1, high: 0 };
    }

    /// Gets the low 64 bits
    /// Used by the compiler to lower truncating `u128 as <int>` casts.
    #[compiler_item("u128_low")]
    pub fn low(&self) -> u64 {
        return self.low;
    }

    /// Gets the high 64 bits
    pub fn high(&self) -> u64 {
        return self.high;
    }

    /// Create a u128 from an i128 (reinterpret bits)
    /// Used by the compiler to lower `i128 as u128` casts.
    #[compiler_item("u128_from_i128")]
    pub fn from_i128(val: i128) -> u128 {
        return u128 { low: val.low, high: val.high as u64 };
    }

    /// Fold a value with more than 64 significant bits (`high != 0`) into
    /// a `mant_bits`-bit mantissa rounded to nearest with ties to even,
    /// plus the exponent of the value's leading bit. Shared core of the
    /// float conversions; mirrors compiler-rt's `__floatuntidf`.
    fn round_to_mantissa(&self, mant_bits: i32) -> [u64, i64] {
        assert self.high != 0;
        let hbits = 64 - builtin::i64_clz(self.high as i64);  // 1..=64
        // Shift down to mant_bits + 2 bits: the mantissa, a guard bit,
        // and one bit for the rest.
        let shift = hbits + (62 - mant_bits) as i64;
        let mut a: u64 = 0;
        let mut sticky: u64 = 0;
        if shift >= 64 {
            let t = (shift - 64) as u64;
            a = self.high >> t;
            if self.low != 0 || self.high & (1 << t) - 1 != 0 {
                sticky = 1;
            }
        } else {
            let sh = shift as u64;
            a = self.low >> sh | self.high << 64 - sh;
            if self.low & (1 << sh) - 1 != 0 {
                sticky = 1;
            }
        }
        // Bit 1 of `a` is the guard bit and bit 0 the rest; fold sticky
        // into bit 0, then round half-to-even: copying the mantissa LSB
        // (bit 2) into bit 0 makes the +1 below carry into the mantissa
        // exactly when guard && (sticky || odd).
        a = a | sticky;
        if a & 4 != 0 {
            a = a | 1;
        }
        a += 1;
        a = a >> 2;
        let mut exp = 64 + hbits - 1;  // exponent of the leading bit, 64..=127
        if a >> mant_bits as u64 != 0 {
            // Rounding overflowed the mantissa.
            a = a >> 1;
            exp += 1;
        }
        assert a >> (mant_bits - 1) as u64 == 1;
        return [a, exp];
    }

    /// Convert to `f64`, rounding to the nearest representable value with
    /// ties to even — the same semantics as Rust's `value as f64` cast.
    /// Used by the compiler to lower `u128 as f64` casts.
    #[compiler_item("u128_as_f64")]
    pub fn as_f64(&self) -> f64 {
        if self.high == 0 {
            // The native u64 → f64 conversion is correctly rounded.
            return self.low as f64;
        }
        let [m, exp] = self.round_to_mantissa(53);
        // Assemble the IEEE-754 double directly: biased exponent in bits
        // 62..=52, the 52-bit mantissa (the leading 1 is implicit) in bits
        // 51..=0. `exp` is 64..=128 (128 when rounding overflowed the
        // mantissa, e.g. u128::MAX → 2^128), biasing to 1087..=1151 — far
        // below the infinity pattern (2047), so the result is always a
        // finite normal and no special-casing is needed.
        let biased = (exp + 1023) as u64;
        let mantissa: u64 = m & (1 << 52) - 1;
        let bits: u64 = biased << 52 | mantissa;
        return builtin::f64_reinterpret_i64(bits as i64);
    }

    /// Convert to `f32`, rounding to the nearest representable value with
    /// ties to even; values above `f32::MAX` become infinity — the same
    /// semantics as Rust's `value as f32` cast.
    /// Used by the compiler to lower `u128 as f32` casts.
    #[compiler_item("u128_as_f32")]
    pub fn as_f32(&self) -> f32 {
        if self.high == 0 {
            // The native u64 → f32 conversion is correctly rounded.
            return self.low as f32;
        }
        let [m, exp] = self.round_to_mantissa(24);
        // Assemble the IEEE-754 single directly. `exp` is 64..=127, biasing
        // to 191..=254; a mantissa that rounded up to exp 128 biases to 255,
        // which is exactly the +infinity pattern (mantissa field 0) — so
        // values above f32::MAX saturate to infinity for free, matching
        // Rust's cast semantics.
        let biased = (exp + 127) as u32;
        let mantissa: u32 = m as u32 & (1 << 23) - 1;
        let bits: u32 = biased << 23 | mantissa;
        return builtin::f32_reinterpret_i32(bits as i32);
    }

    /// Divide `[hi, lo]` by `d`, returning (quotient, remainder). Knuth
    /// Algorithm D over 32-bit limbs: the 128÷64 step Wasm has no instruction
    /// for. `hi < d` is what keeps the quotient inside 64 bits.
    fn div_rem_wide(hi: u64, lo: u64, d: u64) -> [u64, u64] {
        assert hi < d;
        if hi == 0 {
            return [lo / d, lo % d];
        }
        let low32: u64 = 0xFFFFFFFF;

        // Normalize: shift the divisor until its leading limb has bit 31 set,
        // which bounds each trial quotient below to within 2 of the true one.
        let s = builtin::i64_clz(d as i64) as u64;
        let dn = d << s;
        let dn1 = dn >> 32;
        let dn0 = dn & low32;
        let mut un32 = hi << s;
        if s != 0 {
            un32 = un32 | lo >> 64 - s;
        }
        let un10 = lo << s;
        let un1 = un10 >> 32;
        let un0 = un10 & low32;

        // Each half-quotient: divide the top three limbs by the top divisor
        // limb, then walk the estimate down until the next limb also fits.
        let mut q1 = un32 / dn1;
        let mut rhat = un32 - q1 * dn1;
        while q1 > low32 || q1 * dn0 > rhat << 32 | un1 {
            q1 -= 1;
            rhat += dn1;
            if rhat > low32 {
                break;
            }
        }
        // The partial remainders wrap out of 64 bits on the way but land
        // below `dn`, so the truncated result is exact.
        let un21 = (un32 << 32) + un1 - q1 * dn;

        let mut q0 = un21 / dn1;
        rhat = un21 - q0 * dn1;
        while q0 > low32 || q0 * dn0 > rhat << 32 | un0 {
            q0 -= 1;
            rhat += dn1;
            if rhat > low32 {
                break;
            }
        }
        let r = (un21 << 32) + un0 - q0 * dn >> s;
        return [q1 << 32 | q0, r];
    }

    /// Divide self by divisor, returning (quotient, remainder). One native
    /// division when both fit in 64 bits, otherwise one or two Algorithm D
    /// passes over 32-bit limbs.
    pub fn div_rem(&self, divisor: &u128) -> [u128, u128] {
        if divisor.low == 0 && divisor.high == 0 {
            panic("u128 division by zero");
        }

        if divisor.high == 0 {
            if self.high == 0 {
                // Both operands inside 64 bits is the common case — a unit
                // conversion by a small constant — and one native division
                // answers it.
                return [
                    u128::from_u64(self.low / divisor.low),
                    u128::from_u64(self.low % divisor.low),
                ];
            } else {
                // 128 ÷ 64: the high limb natively, then one wide step whose
                // dividend is the leftover remainder, below the divisor.
                let d = divisor.low;
                let [q_low, r] = u128::div_rem_wide(self.high % d, self.low, d);
                return [
                    u128::from_pair(q_low, self.high / d),
                    u128::from_u64(r),
                ];
            }
        } else if *self < *divisor {
            return [u128::zero(), *self];
        } else {
            // The divisor needs more than 64 bits, so the quotient fits in
            // one word. Estimate it from the normalized leading divisor limb
            // over a halved dividend — halving is what keeps the wide step's
            // dividend below its divisor — then correct the estimate, which
            // this leaves either exact or one too small.
            let n = builtin::i64_clz(divisor.high as i64) as u64;
            let mut dn = divisor.high << n;
            if n != 0 {
                dn = dn | divisor.low >> 64 - n;
            }
            let half_high = self.high >> 1;
            let half_low = self.low >> 1 | self.high << 63;
            let [estimate, _] = u128::div_rem_wide(half_high, half_low, dn);
            let mut q = estimate >> 63 - n;
            if q != 0 {
                q -= 1;
            }
            let mut rem = *self - u128::from_u64(q) * *divisor;
            if rem >= *divisor {
                q += 1;
                rem = rem - *divisor;
            }
            return [u128::from_u64(q), rem];
        }
    }

    /// Get the bit at position i (0 = LSB, 127 = MSB)
    pub fn get_bit(&self, i: i32) -> bool {
        let shift: i64 = i as i64;
        if i < 64 {
            return self.low >> shift as u64 & 1 != 0;
        } else {
            let s: i64 = (i - 64) as i64;
            return self.high >> s as u64 & 1 != 0;
        }
    }

    /// Set the bit at position i to 1, returning a new u128
    pub fn set_bit(&self, i: i32) -> u128 {
        let shift: i64 = i as i64;
        if i < 64 {
            return u128 {
                low: self.low | 1 << shift as u64,
                high: self.high,
            };
        } else {
            let s: i64 = (i - 64) as i64;
            return u128 {
                low: self.low,
                high: self.high | 1 << s as u64,
            };
        }
    }

    fn fmt_into(&self, f: &mut Formatter) {
        self.fmt_decimal(f);
    }

    /// Convert u128 to String (for template string interpolation)
    pub fn to_string(&self) -> String {
        let mut buf = String::with_capacity(40);
        let mut f = Formatter::new(&mut buf);
        self.fmt_into(&mut f);
        return buf;
    }

    fn fmt_decimal(&self, f: &mut Formatter) {
        self.fmt_decimal_magnitude(f, false);
    }

    /// Decimal digits of `self` with an optional sign, shared by the
    /// u128 Display path and the i128 one (which passes its magnitude).
    fn fmt_decimal_magnitude(&self, f: &mut Formatter, is_neg: bool) {
        // Peel 19 digits per division — 10^19 is the largest power of ten
        // inside a u64 — so a full-width value costs two 128-bit divisions
        // rather than one per digit, counted and written.
        let chunk: u128 = 10000000000000000000;
        let mut top = self.low;
        let mut mid: u64 = 0;
        let mut bottom: u64 = 0;
        let mut chunks: i32 = 1;
        if self.high != 0 {
            let [q, r] = self.div_rem(&chunk);
            bottom = r.low;
            top = q.low;
            chunks = 2;
            if q >= chunk {
                let [q2, r2] = q.div_rem(&chunk);
                mid = r2.low;
                top = q2.low;
                chunks = 3;
            }
        }

        let top_digits = count_digits_u64(top);
        let digit_count = top_digits + (chunks - 1) * 19;
        let offset = f.prepare_int_write(is_neg, "", digit_count);
        let arr = f.buf.internal_raw_bytes_mut();

        let mut pos = offset + digit_count;
        if chunks == 3 {
            write_u64_digits(arr, pos, bottom, 19);
            pos -= 19;
            write_u64_digits(arr, pos, mid, 19);
            pos -= 19;
        } else if chunks == 2 {
            write_u64_digits(arr, pos, bottom, 19);
            pos -= 19;
        }
        write_u64_digits(arr, pos, top, top_digits);
        assert pos - top_digits == offset;
    }

    /// `alt_prefix` is written only when the spec asked for the alternate form
    /// (`${x:#x}`); `prepare_int_write` drops it for a plain `${x:x}`.
    fn fmt_base(&self, f: &mut Formatter, base: i32, upper: bool, alt_prefix: String) {
        let bits_per_digit = if base == 2 {
            1;
        } else if base == 8 {
            3;
        } else {
            4;
        };
        let mask: u64 = (base - 1) as u64;

        // Count digits
        let is_zero = self.low == 0 && self.high == 0;
        let digit_count = if is_zero {
            1;
        } else {
            let highest_bit = if self.high != 0 {
                127 - builtin::i64_clz(self.high as i64) as i32;
            } else {
                63 - builtin::i64_clz(self.low as i64) as i32;
            };
            highest_bit / bits_per_digit + 1;
        };

        let offset = f.prepare_int_write(false, alt_prefix, digit_count);
        let arr = f.buf.internal_raw_bytes_mut();

        if is_zero {
            builtin::array_set_u8(arr, offset, b'0');
        } else {
            let mut pos = offset + digit_count;
            let mut lo: u64 = self.low;
            let mut hi: u64 = self.high;
            let shift_u64: u64 = bits_per_digit as u64;
            while lo != 0 || hi != 0 {
                pos -= 1;
                let digit: i32 = (lo & mask) as i32;
                let ch = if digit < 10 {
                    '0' as i32 + digit;
                } else if upper {
                    'A' as i32 + digit - 10;
                } else {
                    'a' as i32 + digit - 10;
                };
                builtin::array_set_u8(arr, pos, ch as u8);
                // Shift right: move bits from hi into lo
                // For shift amounts 1,3,4 this works correctly
                let hi_bits = hi << 64 - shift_u64;
                lo = lo >> shift_u64 | hi_bits;
                hi = hi >> shift_u64;
            }
            assert pos == offset;
        }
    }
}

impl FromStr for u128 {
    type Err = ParseIntError;

    fn from_str_range(s: &String, start: i32, end: i32) -> Result<u128, ParseIntError> {
        return u128::from_str_radix_range(s, start, end, 10);
    }
}

impl LenientFromStr for u128 {
    type Err = LenientParseError;

    fn from_str_lenient(s: &String) -> Result<u128, LenientParseError> {
        let [cleaned, radix] = match lenient_int_preprocess(s) {
            Ok(p) => p,
            Err(e) => {
                return Result::Err(e);
            },
        };
        return match u128::from_str_radix(&cleaned, radix) {
            Ok(v) => Result::Ok(v),
            Err(e) => Result::Err(lenient_int_error(e)),
        };
    }
}

/// Count decimal digits of a u64 value.
fn count_digits_u64(val: u64) -> i32 {
    let mut n: i32 = 1;
    for let mut t = val; t >= 10; t = t / 10 {
        n += 1;
    }
    return n;
}

/// Write exactly `count` decimal digits of `val` backwards, ending at `end`.
fn write_u64_digits(arr: &mut Array<u8>, end: i32, val: u64, count: i32) {
    let mut pos = end;
    let mut t = val;
    for let mut i = 0; i < count; i += 1 {
        pos -= 1;
        builtin::array_set_u8(arr, pos, ('0' as i32 + (t % 10) as i32) as u8);
        t = t / 10;
    }
    assert t == 0;
}

/// Count decimal digits of a u128 value.
fn count_digits_u128(val: u128) -> i32 {
    let chunk: u128 = 10000000000000000000;
    if val < chunk {
        return count_digits_u64(val.low());
    }
    let q = val / chunk;
    if q < chunk {
        return count_digits_u64(q.low()) + 19;
    }
    return count_digits_u64((q / chunk).low()) + 38;
}

/// Drop the last `drop` decimal digits of `val`, rounding half to even.
fn round_off_digits_u128(val: u128, drop: i32) -> u128 {
    let mut divisor: u128 = 1;
    for let mut i = 0; i < drop; i += 1 {
        divisor = divisor * 10;
    }
    let quotient = val / divisor;
    let remainder = val - quotient * divisor;
    let half = divisor / 2;
    if remainder > half || remainder == half && quotient % 2 == 1 {
        return quotient + 1;
    }
    return quotient;
}

/// The 128-bit counterpart of `write_int_exp` in `core:prelude/primitive.wado`:
/// a mantissa of `precision + 1` digits, or the digits with trailing zeros
/// stripped, then `e`/`E` and the decimal exponent.
fn write_int_exp_128(f: &mut Formatter, is_negative: bool, abs_value: u128, upper: bool) {
    let precision = f.precision;
    let mut value = abs_value;
    let mut exponent = count_digits_u128(value) - 1;
    if precision >= 0 {
        let total = precision + 1;
        let drop = exponent + 1 - total;
        if drop > 0 {
            value = round_off_digits_u128(value, drop);
            if count_digits_u128(value) > total {
                // The rounding carried: 999 became 1000, one decade up.
                value = value / 10;
                exponent += 1;
            }
        }
    } else {
        while value >= 10 && value % 10 == 0 {
            value = value / 10;
        }
    }

    let digits = value.to_string();
    let fraction_len = digits.len() - 1;
    let mark = f.mark();
    if is_negative {
        f.write_char('-');
    } else if f.sign_plus {
        f.write_char('+');
    }
    f.write_char(digits.char_at_byte_unchecked(0));
    if precision > 0 || precision < 0 && fraction_len > 0 {
        f.write_char('.');
        f.buf.push_str_range_unchecked(&digits, 1, digits.len());
        for let mut i = fraction_len; i < precision; i += 1 {
            f.write_char('0');
        }
    }
    f.write_char(if upper { 'E' } else { 'e' });
    f.write_str(&exponent.to_string());
    f.apply_padding(mark);
}

/// The magnitude of an i128, `MIN` included — `-MIN` does not fit i128, so it
/// is stepped through `MIN + 1`.
fn abs_to_u128(val: i128) -> u128 {
    if val >= 0 {
        return u128::from_i128(val);
    }
    return u128::from_i128(-(val + 1)) + 1;
}

impl Display for u128 {
    pub fn fmt(&self, f: &mut Formatter) {
        self.fmt_into(f);
    }
}

impl LowerExp for u128 {
    pub fn fmt_lower_exp(&self, f: &mut Formatter) {
        write_int_exp_128(f, false, *self, false);
    }
}

impl UpperExp for u128 {
    pub fn fmt_upper_exp(&self, f: &mut Formatter) {
        write_int_exp_128(f, false, *self, true);
    }
}

impl Inspect for u128 {
    pub fn inspect(&self, f: &mut Formatter) {
        self.fmt_into(f);
    }
}

impl Binary for u128 {
    pub fn fmt_binary(&self, f: &mut Formatter) {
        self.fmt_base(f, 2, false, "0b");
    }
}

impl Octal for u128 {
    pub fn fmt_octal(&self, f: &mut Formatter) {
        self.fmt_base(f, 8, false, "0o");
    }
}

impl LowerHex for u128 {
    pub fn fmt_lower_hex(&self, f: &mut Formatter) {
        self.fmt_base(f, 16, false, "0x");
    }
}

impl UpperHex for u128 {
    pub fn fmt_upper_hex(&self, f: &mut Formatter) {
        self.fmt_base(f, 16, true, "0x");
    }
}

// Eq implementation for u128
impl Eq for u128 {
    pub fn eq(&self, other: &Self) -> bool {
        return self.low == other.low && self.high == other.high;
    }
}

// Ord implementation for u128
impl Ord for u128 {
    pub fn cmp(&self, other: &Self) -> Ordering {
        if self.high < other.high {
            return Ordering::Less;
        }
        if self.high > other.high {
            return Ordering::Greater;
        }
        if self.low < other.low {
            return Ordering::Less;
        }
        if self.low > other.low {
            return Ordering::Greater;
        }
        return Ordering::Equal;
    }
}

// Add implementation for u128
impl Add for u128 {
    type Output = u128;

    pub fn add(&self, other: &Self) -> Self::Output {
        let [lo, hi] = builtin::i64_add128(
            self.low as i64,
            self.high as i64,
            other.low as i64,
            other.high as i64,
        );
        return u128 {
            low: lo as u64,
            high: hi as u64,
        };
    }
}

// Sub implementation for u128
impl Sub for u128 {
    type Output = u128;

    pub fn sub(&self, other: &Self) -> Self::Output {
        let [lo, hi] = builtin::i64_sub128(
            self.low as i64,
            self.high as i64,
            other.low as i64,
            other.high as i64,
        );
        return u128 {
            low: lo as u64,
            high: hi as u64,
        };
    }
}

// Mul implementation for u128
impl Mul for u128 {
    type Output = u128;

    pub fn mul(&self, other: &Self) -> Self::Output {
        // (aH, aL) * (bH, bL) = aL*bL + (aL*bH + aH*bL) << 64 + (aH*bH) << 128
        // Since we only keep lower 128 bits, aH*bH is ignored (overflow)
        // aL*bL gives full 128 bits via mul_wide_u
        // aL*bH and aH*bL only contribute their low 64 bits to result.high

        // aL * bL -> 128-bit result (p0_low, p0_high)
        let [p0_lo, p0_hi] = builtin::i64_mul_wide_u(self.low as i64, other.low as i64);
        let p0_low = p0_lo as u64;
        let p0_high = p0_hi as u64;

        // aL * bH -> only need low 64 bits (will be added to high)
        let p1_low = self.low * other.high;

        // aH * bL -> only need low 64 bits (will be added to high)
        let p2_low = self.high * other.low;

        // result.low = p0_low
        // result.high = p0_high + p1_low + p2_low (overflow ignored)
        return u128 {
            low: p0_low,
            high: p0_high + p1_low + p2_low,
        };
    }
}

// BitAnd implementation for u128
impl BitAnd for u128 {
    type Output = u128;

    pub fn bitand(&self, other: &Self) -> Self::Output {
        return u128 {
            low: self.low & other.low,
            high: self.high & other.high,
        };
    }
}

// BitOr implementation for u128
impl BitOr for u128 {
    type Output = u128;

    pub fn bitor(&self, other: &Self) -> Self::Output {
        return u128 {
            low: self.low | other.low,
            high: self.high | other.high,
        };
    }
}

// BitXor implementation for u128
impl BitXor for u128 {
    type Output = u128;

    pub fn bitxor(&self, other: &Self) -> Self::Output {
        return u128 {
            low: self.low ^ other.low,
            high: self.high ^ other.high,
        };
    }
}

// BitNot implementation for u128
impl BitNot for u128 {
    type Output = u128;

    pub fn bitnot(&self) -> Self::Output {
        return u128 {
            low: ~self.low,
            high: ~self.high,
        };
    }
}

// Shl implementation for u128
impl Shl for u128 {
    type Output = u128;

    pub fn shl(&self, rhs: u32) -> Self::Output {
        let shift = rhs as i32;
        if shift >= 128 {
            return u128::zero();
        }
        if shift >= 64 {
            // All low bits shift into high, low becomes 0
            let s = (shift - 64) as u64;
            return u128 {
                low: 0,
                high: self.low << s,
            };
        }
        if shift == 0 {
            return *self;
        }
        // 0 < shift < 64
        let s = shift as u64;
        let inv_s = (64 - shift) as u64;
        return u128 {
            low: self.low << s,
            high: self.high << s | self.low >> inv_s,
        };
    }
}

// Shr implementation for u128 (logical/unsigned shift)
impl Shr for u128 {
    type Output = u128;

    pub fn shr(&self, rhs: u32) -> Self::Output {
        let shift = rhs as i32;
        if shift >= 128 {
            return u128::zero();
        }
        if shift >= 64 {
            // All high bits shift into low, high becomes 0
            let s = (shift - 64) as u64;
            return u128 {
                low: self.high >> s,
                high: 0,
            };
        }
        if shift == 0 {
            return *self;
        }
        // 0 < shift < 64
        let s = shift as u64;
        let inv_s = (64 - shift) as u64;
        return u128 {
            low: self.low >> s | self.high << inv_s,
            high: self.high >> s,
        };
    }
}

// Div implementation for u128
impl Div for u128 {
    type Output = u128;

    pub fn div(&self, other: &Self) -> Self::Output {
        let result = self.div_rem(other);
        return result[0];
    }
}

// Rem implementation for u128
impl Rem for u128 {
    type Output = u128;

    pub fn rem(&self, other: &Self) -> Self::Output {
        let result = self.div_rem(other);
        return result[1];
    }
}

/// Signed 128-bit integer
/// Stored as two 64-bit parts: low (bits 0-63, unsigned) and high (bits 64-127, signed)
#[compiler_item("i128")]
pub struct i128 {
    low: u64,
    high: i64,
}

impl i128 {
    /// Create an i128 from an i64 value (sign-extended)
    #[compiler_item("i128_from_i64")]
    pub fn from_i64(value: i64) -> i128 {
        // Sign extend: if value is negative, high bits are all 1s (-1)
        let high: i64 = if value < 0 { -1 } else { 0 };
        return i128 { low: value as u64, high };
    }

    /// Create an i128 from low and high 64-bit parts
    /// Used by the compiler for efficient large literal construction
    #[compiler_item("i128_from_pair")]
    pub fn from_pair(low: u64, high: i64) -> i128 {
        return i128 { low, high };
    }

    /// Parse a hexadecimal `i128` from a string (equivalent to `from_str_radix(s, 16)`).
    pub fn from_str_hex(s: &String) -> Result<i128, ParseIntError> {
        return i128::from_str_radix(s, 16);
    }

    /// Parse an `i128` from a string in the given radix. `radix` must be in 2..=36.
    pub fn from_str_radix(s: &String, radix: u32) -> Result<i128, ParseIntError> {
        return i128::from_str_radix_range(s, 0, s.len(), radix);
    }

    /// Range variant of `from_str_radix`. Parses `s[start..end)` as an `i128`
    /// in the given radix without allocating a substring.
    pub fn from_str_radix_range(s: &String, start: i32, end: i32, radix: u32) -> Result<i128, ParseIntError> {
        assert_radix(radix);
        let [is_negative, digit_start] = match parse_signed_prefix_range(s, start, end) {
            Ok(p) => p,
            Err(k) => {
                return Result::Err(ParseIntError::new(k));
            },
        };
        // i128::MAX = (u64::MAX, i64::MAX as u64) in (low, high).
        // |i128::MIN| = 2^127 = (0, 1 << 63).
        let max_pos = u128::from_pair(u64::MAX, i64::MAX as u64);
        let max_neg_abs = u128::from_pair(0, 9223372036854775808);
        return match parse_u128_digits(s, digit_start, end, radix) {
            Ok(v) => if is_negative {
                if v > max_neg_abs {
                    Result::Err(ParseIntError::new(IntErrorKind::NegOverflow));
                } else {
                    Result::Ok(-i128::from_u128(v));
                }
            } else if v > max_pos {
                Result::Err(ParseIntError::new(IntErrorKind::PosOverflow));
            } else {
                Result::Ok(i128::from_u128(v));
            },
            Err(k) => {
                let kind = if is_negative && k == IntErrorKind::PosOverflow { IntErrorKind::NegOverflow } else { k };
                Result::Err(ParseIntError::new(kind));
            },
        };
    }

    /// Creates a zero i128
    pub fn zero() -> i128 {
        return i128 { low: 0, high: 0 };
    }

    /// Creates an i128 with value 1
    pub fn one() -> i128 {
        return i128 { low: 1, high: 0 };
    }

    /// Gets the low 64 bits (unsigned)
    /// Used by the compiler to lower truncating `i128 as <int>` casts.
    #[compiler_item("i128_low")]
    pub fn low(&self) -> u64 {
        return self.low;
    }

    /// Gets the high 64 bits (signed)
    pub fn high(&self) -> i64 {
        return self.high;
    }

    /// Checks if this i128 is negative
    pub fn is_negative(&self) -> bool {
        return self.high < 0;
    }

    /// Get absolute value as u128
    pub fn abs_u128(&self) -> u128 {
        if self.is_negative() {
            // i128::MIN wraps to itself under negation; the reinterpret
            // still yields the correct magnitude 2^127.
            return u128::from_i128(-*self);
        }
        return u128::from_i128(*self);
    }

    /// Create i128 from u128 (reinterpret bits)
    /// Used by the compiler to lower `u128 as i128` casts.
    #[compiler_item("i128_from_u128")]
    pub fn from_u128(val: u128) -> i128 {
        return i128 { low: val.low, high: val.high as i64 };
    }

    /// Convert to `f64`, rounding to the nearest representable value with
    /// ties to even — the same semantics as Rust's `value as f64` cast.
    /// Used by the compiler to lower `i128 as f64` casts.
    #[compiler_item("i128_as_f64")]
    pub fn as_f64(&self) -> f64 {
        let magnitude = self.abs_u128().as_f64();
        if self.is_negative() {
            // Negation of an f64 is exact, so the result stays correctly
            // rounded.
            return -magnitude;
        }
        return magnitude;
    }

    /// Convert to `f32`, rounding to the nearest representable value with
    /// ties to even — the same semantics as Rust's `value as f32` cast.
    /// Used by the compiler to lower `i128 as f32` casts.
    #[compiler_item("i128_as_f32")]
    pub fn as_f32(&self) -> f32 {
        let magnitude = self.abs_u128().as_f32();
        if self.is_negative() {
            return -magnitude;
        }
        return magnitude;
    }

    /// Divide self by divisor, returning (quotient, remainder)
    /// Uses signed division semantics:
    /// - quotient is negative if signs differ
    /// - remainder has the same sign as dividend
    /// Panics if divisor is zero
    pub fn div_rem(&self, divisor: &i128) -> [i128, i128] {
        // Check for division by zero
        if divisor.low == 0 && divisor.high == 0 {
            panic("i128 division by zero");
        }

        let dividend_neg = self.is_negative();
        let divisor_neg = divisor.is_negative();

        // Get absolute values as u128
        let abs_dividend = self.abs_u128();
        let abs_divisor = divisor.abs_u128();

        // Perform unsigned division
        let result = abs_dividend.div_rem(&abs_divisor);
        let abs_quotient = result[0];
        let abs_remainder = result[1];

        // Apply signs
        // Quotient: negative if signs differ
        let mut quotient = i128::from_u128(abs_quotient);
        if dividend_neg != divisor_neg {
            quotient = -quotient;
        }

        // Remainder: same sign as dividend
        let mut remainder = i128::from_u128(abs_remainder);
        if dividend_neg {
            remainder = -remainder;
        }

        return [quotient, remainder];
    }

    fn fmt_into(&self, f: &mut Formatter) {
        self.fmt_decimal(f);
    }

    /// Convert i128 to String (for template string interpolation)
    pub fn to_string(&self) -> String {
        let mut buf = String::with_capacity(41);
        let mut f = Formatter::new(&mut buf);
        self.fmt_into(&mut f);
        return buf;
    }

    fn fmt_decimal(&self, f: &mut Formatter) {
        self.abs_u128().fmt_decimal_magnitude(f, self.is_negative());
    }
}

impl FromStr for i128 {
    type Err = ParseIntError;

    fn from_str_range(s: &String, start: i32, end: i32) -> Result<i128, ParseIntError> {
        return i128::from_str_radix_range(s, start, end, 10);
    }
}

impl LenientFromStr for i128 {
    type Err = LenientParseError;

    fn from_str_lenient(s: &String) -> Result<i128, LenientParseError> {
        let [cleaned, radix] = match lenient_int_preprocess(s) {
            Ok(p) => p,
            Err(e) => {
                return Result::Err(e);
            },
        };
        return match i128::from_str_radix(&cleaned, radix) {
            Ok(v) => Result::Ok(v),
            Err(e) => Result::Err(lenient_int_error(e)),
        };
    }
}

impl Display for i128 {
    pub fn fmt(&self, f: &mut Formatter) {
        self.fmt_into(f);
    }
}

impl LowerExp for i128 {
    pub fn fmt_lower_exp(&self, f: &mut Formatter) {
        write_int_exp_128(f, *self < 0, abs_to_u128(*self), false);
    }
}

impl UpperExp for i128 {
    pub fn fmt_upper_exp(&self, f: &mut Formatter) {
        write_int_exp_128(f, *self < 0, abs_to_u128(*self), true);
    }
}

impl Inspect for i128 {
    pub fn inspect(&self, f: &mut Formatter) {
        self.fmt_into(f);
    }
}

impl Binary for i128 {
    pub fn fmt_binary(&self, f: &mut Formatter) {
        // Negative values print their 128-bit two's complement
        // pattern, matching Rust.
        u128::from_i128(*self).fmt_base(f, 2, false, "0b");
    }
}

impl Octal for i128 {
    pub fn fmt_octal(&self, f: &mut Formatter) {
        u128::from_i128(*self).fmt_base(f, 8, false, "0o");
    }
}

impl LowerHex for i128 {
    pub fn fmt_lower_hex(&self, f: &mut Formatter) {
        u128::from_i128(*self).fmt_base(f, 16, false, "0x");
    }
}

impl UpperHex for i128 {
    pub fn fmt_upper_hex(&self, f: &mut Formatter) {
        u128::from_i128(*self).fmt_base(f, 16, true, "0x");
    }
}

// Eq implementation for i128
impl Eq for i128 {
    pub fn eq(&self, other: &Self) -> bool {
        return self.low == other.low && self.high == other.high;
    }
}

// Ord implementation for i128 (signed comparison)
impl Ord for i128 {
    pub fn cmp(&self, other: &Self) -> Ordering {
        // For signed comparison:
        // 1. Compare high parts as signed
        // 2. If equal, compare low parts as unsigned
        if self.high < other.high {
            return Ordering::Less;
        }
        if self.high > other.high {
            return Ordering::Greater;
        }
        if self.low < other.low {
            return Ordering::Less;
        }
        if self.low > other.low {
            return Ordering::Greater;
        }
        return Ordering::Equal;
    }
}

// Add implementation for i128
impl Add for i128 {
    type Output = i128;

    pub fn add(&self, other: &Self) -> Self::Output {
        let [lo, hi] = builtin::i64_add128(
            self.low as i64,
            self.high,
            other.low as i64,
            other.high,
        );
        return i128 {
            low: lo as u64,
            high: hi,
        };
    }
}

// Sub implementation for i128
impl Sub for i128 {
    type Output = i128;

    pub fn sub(&self, other: &Self) -> Self::Output {
        let [lo, hi] = builtin::i64_sub128(
            self.low as i64,
            self.high,
            other.low as i64,
            other.high,
        );
        return i128 {
            low: lo as u64,
            high: hi,
        };
    }
}

// Mul implementation for i128
impl Mul for i128 {
    type Output = i128;

    pub fn mul(&self, other: &Self) -> Self::Output {
        // Two's complement multiplication: lower 128 bits are the same as unsigned
        // (aH, aL) * (bH, bL) = aL*bL + (aL*bH + aH*bL) << 64 + (aH*bH) << 128
        // Since we only keep lower 128 bits, aH*bH is ignored (overflow)

        // aL * bL -> 128-bit result (p0_low, p0_high)
        let [p0_lo, p0_hi] = builtin::i64_mul_wide_u(self.low as i64, other.low as i64);
        let p0_low = p0_lo as u64;
        let p0_high = p0_hi as u64;

        // aL * bH -> only need low 64 bits (will be added to high)
        // Treat as unsigned multiplication (low bits are the same)
        let p1_low = self.low * other.high as u64;

        // aH * bL -> only need low 64 bits (will be added to high)
        let p2_low = self.high as u64 * other.low;

        // result.low = p0_low
        // result.high = p0_high + p1_low + p2_low (overflow ignored)
        return i128 {
            low: p0_low,
            high: (p0_high + p1_low + p2_low) as i64,
        };
    }
}

// Neg implementation for i128
impl Neg for i128 {
    type Output = i128;

    pub fn neg(&self) -> Self::Output {
        // -x = ~x + 1 = 0 - x
        return i128::zero() - *self;
    }
}

// BitAnd implementation for i128
impl BitAnd for i128 {
    type Output = i128;

    pub fn bitand(&self, other: &Self) -> Self::Output {
        return i128 {
            low: self.low & other.low,
            high: self.high & other.high,
        };
    }
}

// BitOr implementation for i128
impl BitOr for i128 {
    type Output = i128;

    pub fn bitor(&self, other: &Self) -> Self::Output {
        return i128 {
            low: self.low | other.low,
            high: self.high | other.high,
        };
    }
}

// BitXor implementation for i128
impl BitXor for i128 {
    type Output = i128;

    pub fn bitxor(&self, other: &Self) -> Self::Output {
        return i128 {
            low: self.low ^ other.low,
            high: self.high ^ other.high,
        };
    }
}

// BitNot implementation for i128
impl BitNot for i128 {
    type Output = i128;

    pub fn bitnot(&self) -> Self::Output {
        return i128 {
            low: ~self.low,
            high: ~self.high,
        };
    }
}

// Shl implementation for i128
impl Shl for i128 {
    type Output = i128;

    pub fn shl(&self, rhs: u32) -> Self::Output {
        let shift = rhs as i32;
        if shift >= 128 {
            return 0;
        }
        if shift >= 64 {
            // All low bits shift into high, low becomes 0
            let s = (shift - 64) as u64;
            return i128 {
                low: 0,
                high: (self.low << s) as i64,
            };
        }
        if shift == 0 {
            return *self;
        }
        // 0 < shift < 64
        let s = shift as u64;
        let inv_s = (64 - shift) as u64;
        return i128 {
            low: self.low << s,
            high: (self.high as u64 << s | self.low >> inv_s) as i64,
        };
    }
}

// Shr implementation for i128 (arithmetic/signed shift)
impl Shr for i128 {
    type Output = i128;

    pub fn shr(&self, rhs: u32) -> Self::Output {
        let shift = rhs as i32;
        if shift >= 128 {
            // Fill with sign bit
            if self.high < 0 {
                return i128 {
                    low: 0xFFFFFFFFFFFFFFFF,
                    high: -1,
                };
            } else {
                return 0;
            }
        }
        if shift >= 64 {
            // All high bits shift into low, high becomes sign extension
            let s = (shift - 64) as i64;
            let sign_ext: i64 = if self.high < 0 { -1 } else { 0 };
            return i128 {
                low: (self.high >> s) as u64,
                high: sign_ext,
            };
        }
        if shift == 0 {
            return *self;
        }
        // 0 < shift < 64
        let s = shift as u64;
        let inv_s = (64 - shift) as u64;
        return i128 {
            low: self.low >> s | self.high as u64 << inv_s,
            high: self.high >> s as i64,
        };
    }
}

// Div implementation for i128
impl Div for i128 {
    type Output = i128;

    pub fn div(&self, other: &Self) -> Self::Output {
        let result = self.div_rem(other);
        return result[0];
    }
}

// Rem implementation for i128
impl Rem for i128 {
    type Output = i128;

    pub fn rem(&self, other: &Self) -> Self::Output {
        let result = self.div_rem(other);
        return result[1];
    }
}

impl Default for u128 {
    pub fn default() -> u128 {
        return u128::from_u64(0);
    }
}

impl Default for i128 {
    pub fn default() -> i128 {
        return i128::from_i64(0);
    }
}

impl From<u8> for u128 {
    pub fn from(value: u8) -> u128 {
        return value as u128;
    }
}
impl From<u16> for u128 {
    pub fn from(value: u16) -> u128 {
        return value as u128;
    }
}
impl From<u32> for u128 {
    pub fn from(value: u32) -> u128 {
        return value as u128;
    }
}
impl From<u64> for u128 {
    pub fn from(value: u64) -> u128 {
        return value as u128;
    }
}
impl From<i8> for i128 {
    pub fn from(value: i8) -> i128 {
        return value as i128;
    }
}
impl From<i16> for i128 {
    pub fn from(value: i16) -> i128 {
        return value as i128;
    }
}
impl From<i32> for i128 {
    pub fn from(value: i32) -> i128 {
        return value as i128;
    }
}
impl From<i64> for i128 {
    pub fn from(value: i64) -> i128 {
        return value as i128;
    }
}

impl TryFrom<u128> for u64 {
    type Error = ConvertError;

    pub fn try_from(value: u128) -> Result<u64, ConvertError> {
        if value.high() != 0 {
            return Result::Err(ConvertError::new("value out of range for u64"));
        }
        return Result::Ok(value.low());
    }
}

impl TryFrom<u128> for i64 {
    type Error = ConvertError;

    pub fn try_from(value: u128) -> Result<i64, ConvertError> {
        if value.high() != 0 || value.low() > i64::MAX as u64 {
            return Result::Err(ConvertError::new("value out of range for i64"));
        }
        return Result::Ok(value.low() as i64);
    }
}

impl TryFrom<u128> for i128 {
    type Error = ConvertError;

    pub fn try_from(value: u128) -> Result<i128, ConvertError> {
        if value.high() > i64::MAX as u64 {
            return Result::Err(ConvertError::new("value out of range for i128"));
        }
        return Result::Ok(i128::from_u128(value));
    }
}

impl TryFrom<i128> for i64 {
    type Error = ConvertError;

    pub fn try_from(value: i128) -> Result<i64, ConvertError> {
        let min: i128 = i64::MIN as i128;
        let max: i128 = i64::MAX as i128;
        if !(min <= value <= max) {
            return Result::Err(ConvertError::new("value out of range for i64"));
        }
        return Result::Ok(value.low() as i64);
    }
}

impl TryFrom<i128> for u64 {
    type Error = ConvertError;

    pub fn try_from(value: i128) -> Result<u64, ConvertError> {
        // In range exactly when the value is in [0, 2^64): the high half
        // is zero (negative values have a sign-extended, non-zero high).
        if value.high() != 0 {
            return Result::Err(ConvertError::new("value out of range for u64"));
        }
        return Result::Ok(value.low());
    }
}

impl TryFrom<i128> for u128 {
    type Error = ConvertError;

    pub fn try_from(value: i128) -> Result<u128, ConvertError> {
        if value.is_negative() {
            return Result::Err(ConvertError::new("value out of range for u128"));
        }
        return Result::Ok(u128::from_i128(value));
    }
}

impl TryFrom<i128> for f64 {
    type Error = ConvertError;

    pub fn try_from(value: i128) -> Result<f64, ConvertError> {
        let max: i128 = 9007199254740992;
        let min: i128 = -9007199254740992;
        if !(min <= value <= max) {
            return Result::Err(ConvertError::new("value out of range for f64"));
        }
        return Result::Ok(value.low() as i64 as f64);
    }
}

impl TryFrom<i128> for f32 {
    type Error = ConvertError;

    pub fn try_from(value: i128) -> Result<f32, ConvertError> {
        let max: i128 = 16777216;
        let min: i128 = -16777216;
        if !(min <= value <= max) {
            return Result::Err(ConvertError::new("value out of range for f32"));
        }
        return Result::Ok(value.low() as i64 as f32);
    }
}

impl TryFrom<u128> for f64 {
    type Error = ConvertError;

    pub fn try_from(value: u128) -> Result<f64, ConvertError> {
        let max: u128 = 9007199254740992;
        if value > max {
            return Result::Err(ConvertError::new("value out of range for f64"));
        }
        return Result::Ok(value.low() as f64);
    }
}

impl TryFrom<u128> for f32 {
    type Error = ConvertError;

    pub fn try_from(value: u128) -> Result<f32, ConvertError> {
        let max: u128 = 16777216;
        if value > max {
            return Result::Err(ConvertError::new("value out of range for f32"));
        }
        return Result::Ok(value.low() as f32);
    }
}

impl Step for u128 {
    fn next_step(&self) -> Option<u128> {
        let max = u128::from_pair(u64::MAX, u64::MAX);
        if *self == max {
            return null;
        }
        return Option::Some(*self + 1 as u128);
    }
}

impl Step for i128 {
    fn next_step(&self) -> Option<i128> {
        let max = i128::from_pair(u64::MAX, i64::MAX);
        if *self == max {
            return null;
        }
        return Option::Some(*self + 1 as i128);
    }
}
