// 128-bit Integer Types
// Implemented as structs wrapping two 64-bit values, using Wasm Wide Arithmetic instructions.
#![no_prelude]
#![stdlib("core:prelude/int128.wado")]

use {
    IntErrorKind,
    ParseIntError,
    parse_u128_digits,
    parse_signed_prefix_range,
    parse_unsigned_prefix_range,
    assert_radix,
} from "core:prelude/intparse.wado";

/// Unsigned 128-bit integer
/// Stored as two 64-bit parts: low (bits 0-63) and high (bits 64-127)
pub struct u128 {
    low: u64,
    high: u64,
}

impl u128 {
    /// Create a u128 from a u64 value (zero-extended)
    pub fn from_u64(value: u64) -> u128 {
        return u128 { low: value, high: 0 };
    }

    /// Create a u128 from low and high 64-bit parts
    /// Used by the compiler for efficient large literal construction
    pub fn from_pair(low: u64, high: u64) -> u128 {
        return u128 { low, high };
    }

    /// Create a u128 from a string (decimal representation)
    /// Used for literal coercion: `let x: u128 = "12345678901234567890"`
    pub fn from_string(s: String) -> u128 {
        let mut result = u128::zero();
        let mut i = 0;
        let len = s.len();
        let bytes = s.internal_raw_bytes();
        let ten: u128 = 10;
        while i < len {
            let byte = builtin::array_get_u8(bytes, i);
            let digit = byte as i32 - '0' as i32;
            if 0 <= digit && digit <= 9 {
                result = result * ten + u128::from_u64(digit as u64);
            }
            i += 1;
        }
        return result;
    }

    /// Parse a hexadecimal `u128` from a string (equivalent to `from_str_radix(s, 16)`).
    pub fn from_str_hex(s: String) -> Result<u128, ParseIntError> {
        return u128::from_str_radix(s, 16);
    }

    /// Parse a `u128` from a string in the given radix. `radix` must be in 2..=36.
    pub fn from_str_radix(s: String, radix: u32) -> Result<u128, ParseIntError> {
        return u128::from_str_radix_range(&s, 0, s.len(), radix);
    }

    /// Range variant of `from_str_radix`. Parses `s[start..end)` as a `u128`
    /// in the given radix without allocating a substring.
    pub fn from_str_radix_range(s: &String, start: i32, end: i32, radix: u32) -> Result<u128, ParseIntError> {
        assert_radix(radix);
        let prefix = parse_unsigned_prefix_range(s, start, end);
        if let Err(k) = prefix {
            return Result::Err(ParseIntError::new(k));
        }
        let digit_start = prefix.unwrap();
        return match parse_u128_digits(s, digit_start, end, radix) {
            Ok(v) => Result::Ok(v),
            Err(k) => Result::Err(ParseIntError::new(k)),
        };
    }

    /// Creates a zero u128
    pub fn zero() -> u128 {
        return u128 { low: 0, high: 0 };
    }

    /// Creates a u128 with value 1
    pub fn one() -> u128 {
        return u128 { low: 1, high: 0 };
    }

    /// Gets the low 64 bits
    pub fn low(&self) -> u64 {
        return self.low;
    }

    /// Gets the high 64 bits
    pub fn high(&self) -> u64 {
        return self.high;
    }

    /// Add two u128 values
    pub fn add(&self, other: &u128) -> u128 {
        let [lo, hi] = builtin::i64_add128(
            self.low as i64,
            self.high as i64,
            other.low as i64,
            other.high as i64,
        );
        return u128 {
            low: lo as u64,
            high: hi as u64,
        };
    }

    /// Subtract two u128 values (self - other)
    pub fn sub(&self, other: &u128) -> u128 {
        let [lo, hi] = builtin::i64_sub128(
            self.low as i64,
            self.high as i64,
            other.low as i64,
            other.high as i64,
        );
        return u128 {
            low: lo as u64,
            high: hi as u64,
        };
    }

    /// Divide self by divisor, returning (quotient, remainder)
    /// Uses binary long division algorithm (shift-subtract)
    /// Panics if divisor is zero
    pub fn div_rem(&self, divisor: &u128) -> [u128, u128] {
        // Check for division by zero
        if divisor.low == 0 && divisor.high == 0 {
            panic("u128 division by zero");
        }

        // Quick return if dividend < divisor
        if *self < *divisor {
            return [u128::zero(), *self];
        }

        // Quick return if dividend == divisor
        if *self == *divisor {
            return [u128::one(), u128::zero()];
        }

        // Binary long division
        let mut quotient = u128::zero();
        let mut remainder = u128::zero();
        let one = u128::one();

        // Process each bit from high to low (bit 127 down to bit 0)
        let mut i: i32 = 127;
        while i >= 0 {
            // remainder = remainder << 1
            remainder = remainder << 1;

            // Get bit i of dividend and set bit 0 of remainder
            let bit = self.get_bit(i);
            if bit {
                remainder = remainder | one;
            }

            // If remainder >= divisor, subtract and set quotient bit
            if remainder >= *divisor {
                remainder = remainder - *divisor;
                quotient = quotient.set_bit(i);
            }

            i -= 1;
        }

        return [quotient, remainder];
    }

    /// Get the bit at position i (0 = LSB, 127 = MSB)
    pub fn get_bit(&self, i: i32) -> bool {
        let shift: i64 = i as i64;
        if i < 64 {
            return self.low >> shift as u64 & 1 != 0;
        } else {
            let s: i64 = (i - 64) as i64;
            return self.high >> s as u64 & 1 != 0;
        }
    }

    /// Set the bit at position i to 1, returning a new u128
    pub fn set_bit(&self, i: i32) -> u128 {
        let shift: i64 = i as i64;
        if i < 64 {
            return u128 {
                low: self.low | 1 << shift as u64,
                high: self.high,
            };
        } else {
            let s: i64 = (i - 64) as i64;
            return u128 {
                low: self.low,
                high: self.high | 1 << s as u64,
            };
        }
    }

    fn fmt_into(&self, f: &mut Formatter) {
        self.fmt_decimal(f);
    }

    /// Convert u128 to String (for template string interpolation)
    pub fn to_string(&self) -> String {
        let mut buf = String::with_capacity(40);
        let mut f = Formatter::new(&mut buf);
        self.fmt_into(&mut f);
        return buf;
    }

    fn fmt_decimal(&self, f: &mut Formatter) {
        if *self == 0 {
            let offset = f.prepare_int_write(false, "", 1);
            let arr = f.buf.internal_raw_bytes();
            builtin::array_set_u8(arr, offset, '0' as u8);
            return;
        }

        let ten: u128 = 10;

        // Count digits first
        let mut temp = *self;
        let mut digit_count = 0;
        for let mut temp = *self; temp > 0; temp /= ten {
            digit_count += 1;
        }

        let offset = f.prepare_int_write(false, "", digit_count);
        let arr = f.buf.internal_raw_bytes();

        // Write digits in reverse order
        let mut pos = offset + digit_count;
        for let mut temp = *self; temp > 0; temp /= ten {
            pos -= 1;
            let digit: i32 = (temp % ten).low() as i64 as i32;
            builtin::array_set_u8(arr, pos, ('0' as i32 + digit) as u8);
        }
    }

    fn fmt_base(&self, f: &mut Formatter, base: i32, upper: bool, prefix: String) {
        let bits_per_digit = if base == 2 {
            1;
        } else if base == 8 {
            3;
        } else {
            4;
        };
        let mask: u64 = (base - 1) as u64;

        // Count digits
        let is_zero = self.low == 0 && self.high == 0;
        let digit_count = if is_zero {
            1;
        } else {
            // Find highest set bit across both halves
            let mut highest_bit: i32 = 0;
            let h: i64 = self.high as i64;
            let l: i64 = self.low as i64;
            let zero: i64 = 0;
            if h != zero {
                let mut b: i32 = 63;
                while b >= 0 {
                    let one: i64 = 1;
                    if h >> b as i64 & one != zero {
                        highest_bit = 64 + b;
                        break;
                    }
                    b -= 1;
                }
            } else {
                let mut b: i32 = 63;
                while b >= 0 {
                    let one: i64 = 1;
                    if l >> b as i64 & one != zero {
                        highest_bit = b;
                        break;
                    }
                    b -= 1;
                }
            }
            highest_bit / bits_per_digit + 1;
        };

        let offset = f.prepare_int_write(false, prefix, digit_count);
        let arr = f.buf.internal_raw_bytes();

        if is_zero {
            builtin::array_set_u8(arr, offset, '0' as u8);
        } else {
            let mut pos = offset + digit_count;
            let mut lo: u64 = self.low;
            let mut hi: u64 = self.high;
            let shift_u64: u64 = bits_per_digit as u64;
            while lo != 0 || hi != 0 {
                pos -= 1;
                let digit: i32 = (lo & mask) as i32;
                let ch = if digit < 10 {
                    '0' as i32 + digit;
                } else if upper {
                    'A' as i32 + digit - 10;
                } else {
                    'a' as i32 + digit - 10;
                };
                builtin::array_set_u8(arr, pos, ch as u8);
                // Shift right: move bits from hi into lo
                // For shift amounts 1,3,4 this works correctly
                let hi_bits = hi << 64 - shift_u64;
                lo = lo >> shift_u64 | hi_bits;
                hi = hi >> shift_u64;
            }
        }
    }
}

impl FromStr for u128 {
    type Err = ParseIntError;
    fn from_str_range(s: &String, start: i32, end: i32) -> Result<u128, ParseIntError> {
        return u128::from_str_radix_range(s, start, end, 10);
    }
}

impl Display for u128 {
    pub fn fmt(&self, f: &mut Formatter) {
        self.fmt_into(f);
    }
}

impl Inspect for u128 {
    pub fn inspect(&self, f: &mut Formatter) {
        self.fmt_into(f);
    }
}

impl InspectAlt for u128 {
    pub fn inspect_alt(&self, f: &mut Formatter) {
        self.inspect(f);
    }
}

impl Binary for u128 {
    pub fn fmt(&self, f: &mut Formatter) {
        self.fmt_base(f, 2, false, "");
    }
}

impl Octal for u128 {
    pub fn fmt(&self, f: &mut Formatter) {
        self.fmt_base(f, 8, false, "");
    }
}

impl LowerHex for u128 {
    pub fn fmt(&self, f: &mut Formatter) {
        self.fmt_base(f, 16, false, "");
    }
}

impl UpperHex for u128 {
    pub fn fmt(&self, f: &mut Formatter) {
        self.fmt_base(f, 16, true, "");
    }
}

impl BinaryAlt for u128 {
    pub fn fmt_alt(&self, f: &mut Formatter) {
        self.fmt_base(f, 2, false, "0b");
    }
}
impl OctalAlt for u128 {
    pub fn fmt_alt(&self, f: &mut Formatter) {
        self.fmt_base(f, 8, false, "0o");
    }
}
impl LowerHexAlt for u128 {
    pub fn fmt_alt(&self, f: &mut Formatter) {
        self.fmt_base(f, 16, false, "0x");
    }
}
impl UpperHexAlt for u128 {
    pub fn fmt_alt(&self, f: &mut Formatter) {
        self.fmt_base(f, 16, true, "0X");
    }
}

// Eq implementation for u128
impl Eq for u128 {
    pub fn eq(&self, other: &Self) -> bool {
        return self.low == other.low && self.high == other.high;
    }
}

// Ord implementation for u128
impl Ord for u128 {
    pub fn cmp(&self, other: &Self) -> Ordering {
        if self.high < other.high {
            return Ordering::Less;
        }
        if self.high > other.high {
            return Ordering::Greater;
        }
        if self.low < other.low {
            return Ordering::Less;
        }
        if self.low > other.low {
            return Ordering::Greater;
        }
        return Ordering::Equal;
    }
}

// Add implementation for u128
impl Add for u128 {
    type Output = u128;

    pub fn add(&self, other: &Self) -> Self::Output {
        let [lo, hi] = builtin::i64_add128(
            self.low as i64,
            self.high as i64,
            other.low as i64,
            other.high as i64,
        );
        return u128 {
            low: lo as u64,
            high: hi as u64,
        };
    }
}

// Sub implementation for u128
impl Sub for u128 {
    type Output = u128;

    pub fn sub(&self, other: &Self) -> Self::Output {
        let [lo, hi] = builtin::i64_sub128(
            self.low as i64,
            self.high as i64,
            other.low as i64,
            other.high as i64,
        );
        return u128 {
            low: lo as u64,
            high: hi as u64,
        };
    }
}

// Mul implementation for u128
impl Mul for u128 {
    type Output = u128;

    pub fn mul(&self, other: &Self) -> Self::Output {
        // (aH, aL) * (bH, bL) = aL*bL + (aL*bH + aH*bL) << 64 + (aH*bH) << 128
        // Since we only keep lower 128 bits, aH*bH is ignored (overflow)
        // aL*bL gives full 128 bits via mul_wide_u
        // aL*bH and aH*bL only contribute their low 64 bits to result.high

        // aL * bL -> 128-bit result (p0_low, p0_high)
        let [p0_lo, p0_hi] = builtin::i64_mul_wide_u(self.low as i64, other.low as i64);
        let p0_low = p0_lo as u64;
        let p0_high = p0_hi as u64;

        // aL * bH -> only need low 64 bits (will be added to high)
        let p1_low = self.low * other.high;

        // aH * bL -> only need low 64 bits (will be added to high)
        let p2_low = self.high * other.low;

        // result.low = p0_low
        // result.high = p0_high + p1_low + p2_low (overflow ignored)
        return u128 {
            low: p0_low,
            high: p0_high + p1_low + p2_low,
        };
    }
}

// BitAnd implementation for u128
impl BitAnd for u128 {
    type Output = u128;

    pub fn bitand(&self, other: &Self) -> Self::Output {
        return u128 {
            low: self.low & other.low,
            high: self.high & other.high,
        };
    }
}

// BitOr implementation for u128
impl BitOr for u128 {
    type Output = u128;

    pub fn bitor(&self, other: &Self) -> Self::Output {
        return u128 {
            low: self.low | other.low,
            high: self.high | other.high,
        };
    }
}

// BitXor implementation for u128
impl BitXor for u128 {
    type Output = u128;

    pub fn bitxor(&self, other: &Self) -> Self::Output {
        return u128 {
            low: self.low ^ other.low,
            high: self.high ^ other.high,
        };
    }
}

// BitNot implementation for u128
impl BitNot for u128 {
    type Output = u128;

    pub fn bitnot(&self) -> Self::Output {
        return u128 {
            low: ~self.low,
            high: ~self.high,
        };
    }
}

// Shl implementation for u128
impl Shl for u128 {
    type Output = u128;

    pub fn shl(&self, rhs: u32) -> Self::Output {
        let shift = rhs as i32;
        if shift >= 128 {
            return u128::zero();
        }
        if shift >= 64 {
            // All low bits shift into high, low becomes 0
            let s = (shift - 64) as u64;
            return u128 {
                low: 0,
                high: self.low << s,
            };
        }
        if shift == 0 {
            return *self;
        }
        // 0 < shift < 64
        let s = shift as u64;
        let inv_s = (64 - shift) as u64;
        return u128 {
            low: self.low << s,
            high: self.high << s | self.low >> inv_s,
        };
    }
}

// Shr implementation for u128 (logical/unsigned shift)
impl Shr for u128 {
    type Output = u128;

    pub fn shr(&self, rhs: u32) -> Self::Output {
        let shift = rhs as i32;
        if shift >= 128 {
            return u128::zero();
        }
        if shift >= 64 {
            // All high bits shift into low, high becomes 0
            let s = (shift - 64) as u64;
            return u128 {
                low: self.high >> s,
                high: 0,
            };
        }
        if shift == 0 {
            return *self;
        }
        // 0 < shift < 64
        let s = shift as u64;
        let inv_s = (64 - shift) as u64;
        return u128 {
            low: self.low >> s | self.high << inv_s,
            high: self.high >> s,
        };
    }
}

// Div implementation for u128
impl Div for u128 {
    type Output = u128;

    pub fn div(&self, other: &Self) -> Self::Output {
        let result = self.div_rem(other);
        return result[0];
    }
}

// Rem implementation for u128
impl Rem for u128 {
    type Output = u128;

    pub fn rem(&self, other: &Self) -> Self::Output {
        let result = self.div_rem(other);
        return result[1];
    }
}

/// Signed 128-bit integer
/// Stored as two 64-bit parts: low (bits 0-63, unsigned) and high (bits 64-127, signed)
pub struct i128 {
    low: u64,
    high: i64,
}

impl i128 {
    /// Create an i128 from an i64 value (sign-extended)
    pub fn from_i64(value: i64) -> i128 {
        // Sign extend: if value is negative, high bits are all 1s (-1)
        let high: i64 = if value < 0 { -1 } else { 0 };
        return i128 { low: value as u64, high };
    }

    /// Create an i128 from low and high 64-bit parts
    /// Used by the compiler for efficient large literal construction
    pub fn from_pair(low: u64, high: i64) -> i128 {
        return i128 { low, high };
    }

    /// Create an i128 from a string (decimal representation, optionally prefixed with '-')
    /// Used for literal coercion: `let x: i128 = "-12345678901234567890"`
    pub fn from_string(s: String) -> i128 {
        let len = s.len();
        if len == 0 {
            return i128::zero();
        }

        let bytes = s.internal_raw_bytes();

        // Check for negative sign
        let first_byte = builtin::array_get_u8(bytes, 0);
        let is_negative = first_byte == '-' as u8;
        let start_idx = if is_negative { 1 } else { 0 };

        // Parse the absolute value as u128
        let mut abs_value = u128::zero();
        let mut i = start_idx;
        let ten: u128 = 10;
        while i < len {
            let byte = builtin::array_get_u8(bytes, i);
            let digit = byte as i32 - '0' as i32;
            if 0 <= digit && digit <= 9 {
                abs_value = abs_value * ten + u128::from_u64(digit as u64);
            }
            i += 1;
        }

        // Convert to i128
        let result = i128 { low: abs_value.low, high: abs_value.high as i64 };
        if is_negative {
            return result.neg();
        }
        return result;
    }

    /// Parse a hexadecimal `i128` from a string (equivalent to `from_str_radix(s, 16)`).
    pub fn from_str_hex(s: String) -> Result<i128, ParseIntError> {
        return i128::from_str_radix(s, 16);
    }

    /// Parse an `i128` from a string in the given radix. `radix` must be in 2..=36.
    pub fn from_str_radix(s: String, radix: u32) -> Result<i128, ParseIntError> {
        return i128::from_str_radix_range(&s, 0, s.len(), radix);
    }

    /// Range variant of `from_str_radix`. Parses `s[start..end)` as an `i128`
    /// in the given radix without allocating a substring.
    pub fn from_str_radix_range(s: &String, start: i32, end: i32, radix: u32) -> Result<i128, ParseIntError> {
        assert_radix(radix);
        let [is_negative, digit_start] = match parse_signed_prefix_range(s, start, end) {
            Ok(p) => p,
            Err(k) => {
                return Result::Err(ParseIntError::new(k));
            },
        };
        // i128::MAX = (u64::MAX, i64::MAX as u64) in (low, high).
        // |i128::MIN| = 2^127 = (0, 1 << 63).
        let max_pos = u128::from_pair(u64::MAX, i64::MAX as u64);
        let max_neg_abs = u128::from_pair(0, 9223372036854775808);
        return match parse_u128_digits(s, digit_start, end, radix) {
            Ok(v) => if is_negative {
                if v > max_neg_abs {
                    Result::Err(ParseIntError::new(IntErrorKind::NegOverflow));
                } else {
                    let pos = i128 { low: v.low(), high: v.high() as i64 };
                    Result::Ok(pos.neg());
                }
            } else if v > max_pos {
                Result::Err(ParseIntError::new(IntErrorKind::PosOverflow));
            } else {
                Result::Ok(i128 { low: v.low(), high: v.high() as i64 });
            },
            Err(k) => {
                let kind = if is_negative && k == IntErrorKind::PosOverflow { IntErrorKind::NegOverflow } else { k };
                Result::Err(ParseIntError::new(kind));
            },
        };
    }

    /// Creates a zero i128
    pub fn zero() -> i128 {
        return i128 { low: 0, high: 0 };
    }

    /// Creates an i128 with value 1
    pub fn one() -> i128 {
        return i128 { low: 1, high: 0 };
    }

    /// Gets the low 64 bits (unsigned)
    pub fn low(&self) -> u64 {
        return self.low;
    }

    /// Gets the high 64 bits (signed)
    pub fn high(&self) -> i64 {
        return self.high;
    }

    /// Checks if this i128 is negative
    pub fn is_negative(&self) -> bool {
        return self.high < 0;
    }

    /// Adds two i128 values
    pub fn add(&self, other: &i128) -> i128 {
        let [lo, hi] = builtin::i64_add128(
            self.low as i64,
            self.high,
            other.low as i64,
            other.high,
        );
        return i128 {
            low: lo as u64,
            high: hi,
        };
    }

    /// Subtract two i128 values (self - other)
    pub fn sub(&self, other: &i128) -> i128 {
        let [lo, hi] = builtin::i64_sub128(
            self.low as i64,
            self.high,
            other.low as i64,
            other.high,
        );
        return i128 {
            low: lo as u64,
            high: hi,
        };
    }

    /// Negate this i128 value
    pub fn neg(&self) -> i128 {
        // -x = ~x + 1 = 0 - x
        return i128::zero().sub(self);
    }

    /// Get absolute value as u128
    pub fn abs_u128(&self) -> u128 {
        if self.is_negative() {
            let neg = self.neg();
            return u128 { low: neg.low, high: neg.high as u64 };
        }
        return u128 { low: self.low, high: self.high as u64 };
    }

    /// Create i128 from u128 (reinterpret bits)
    pub fn from_u128(val: u128) -> i128 {
        return i128 { low: val.low, high: val.high as i64 };
    }

    /// Divide self by divisor, returning (quotient, remainder)
    /// Uses signed division semantics:
    /// - quotient is negative if signs differ
    /// - remainder has the same sign as dividend
    /// Panics if divisor is zero
    pub fn div_rem(&self, divisor: &i128) -> [i128, i128] {
        // Check for division by zero
        if divisor.low == 0 && divisor.high == 0 {
            panic("i128 division by zero");
        }

        let dividend_neg = self.is_negative();
        let divisor_neg = divisor.is_negative();

        // Get absolute values as u128
        let abs_dividend = self.abs_u128();
        let abs_divisor = divisor.abs_u128();

        // Perform unsigned division
        let result = abs_dividend.div_rem(&abs_divisor);
        let abs_quotient = result[0];
        let abs_remainder = result[1];

        // Apply signs
        // Quotient: negative if signs differ
        let mut quotient = i128::from_u128(abs_quotient);
        if dividend_neg != divisor_neg {
            quotient = quotient.neg();
        }

        // Remainder: same sign as dividend
        let mut remainder = i128::from_u128(abs_remainder);
        if dividend_neg {
            remainder = remainder.neg();
        }

        return [quotient, remainder];
    }

    fn fmt_into(&self, f: &mut Formatter) {
        self.fmt_decimal(f);
    }

    /// Convert i128 to String (for template string interpolation)
    pub fn to_string(&self) -> String {
        let mut buf = String::with_capacity(41);
        let mut f = Formatter::new(&mut buf);
        self.fmt_into(&mut f);
        return buf;
    }

    fn fmt_decimal(&self, f: &mut Formatter) {
        let is_neg = self.is_negative();
        let abs_val = self.abs_u128();
        if abs_val.low == 0 && abs_val.high == 0 {
            let offset = f.prepare_int_write(false, "", 1);
            let arr = f.buf.internal_raw_bytes();
            builtin::array_set_u8(arr, offset, '0' as u8);
            return;
        }

        let ten: u128 = 10;
        let mut temp = abs_val;
        let mut digit_count: i32 = 0;
        for let mut temp = abs_val; temp > 0; temp /= ten {
            digit_count += 1;
        }

        let offset = f.prepare_int_write(is_neg, "", digit_count);
        let arr = f.buf.internal_raw_bytes();

        let mut pos = offset + digit_count;
        temp = abs_val;
        for let mut temp = abs_val; temp > 0; temp /= ten {
            pos -= 1;
            let digit = (temp % ten).low() as i64 as i32;
            builtin::array_set_u8(arr, pos, ('0' as i32 + digit) as u8);
        }
    }

    fn fmt_base(&self, f: &mut Formatter, base: i32, upper: bool, prefix: String) {
        let is_neg = self.is_negative();
        let abs_val = self.abs_u128();
        let bits_per_digit = if base == 2 {
            1;
        } else if base == 8 {
            3;
        } else {
            4;
        };
        let mask: u64 = (base - 1) as u64;

        let is_zero = abs_val == 0;
        let digit_count = if is_zero {
            1;
        } else {
            let mut highest_bit: i32 = 0;
            let h: i64 = abs_val.high as i64;
            let l: i64 = abs_val.low as i64;
            if h != 0 {
                let mut b: i32 = 63;
                while b >= 0 {
                    let one: i64 = 1;
                    if h >> b as i64 & one != 0 {
                        highest_bit = 64 + b;
                        break;
                    }
                    b -= 1;
                }
            } else {
                let mut b: i32 = 63;
                while b >= 0 {
                    let one: i64 = 1;
                    if l >> b as i64 & one != 0 {
                        highest_bit = b;
                        break;
                    }
                    b -= 1;
                }
            }
            highest_bit / bits_per_digit + 1;
        };

        let offset = f.prepare_int_write(is_neg, prefix, digit_count);
        let arr = f.buf.internal_raw_bytes();

        if is_zero {
            builtin::array_set_u8(arr, offset, '0' as u8);
        } else {
            let mut pos = offset + digit_count;
            let mut lo: u64 = abs_val.low;
            let mut hi: u64 = abs_val.high;
            let shift_u64: u64 = bits_per_digit as u64;
            while lo != 0 || hi != 0 {
                pos -= 1;
                let digit: i32 = (lo & mask) as i32;
                let ch = if digit < 10 {
                    '0' as i32 + digit;
                } else if upper {
                    'A' as i32 + digit - 10;
                } else {
                    'a' as i32 + digit - 10;
                };
                builtin::array_set_u8(arr, pos, ch as u8);
                let hi_bits = hi << 64 - shift_u64;
                lo = lo >> shift_u64 | hi_bits;
                hi = hi >> shift_u64;
            }
        }
    }
}

impl FromStr for i128 {
    type Err = ParseIntError;
    fn from_str_range(s: &String, start: i32, end: i32) -> Result<i128, ParseIntError> {
        return i128::from_str_radix_range(s, start, end, 10);
    }
}

