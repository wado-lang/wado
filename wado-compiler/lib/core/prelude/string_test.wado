test "chars iter ASCII" {
    let chars: Array<char> = "ABC".chars().collect();
    assert chars.len() == 3;
    assert chars[0] == 'A';
    assert chars[1] == 'B';
    assert chars[2] == 'C';
}

test "chars iter 2-byte UTF-8" {
    let chars: Array<char> = "ñé".chars().collect();
    assert chars.len() == 2;
    assert chars[0] as i32 == 0x00F1;
    assert chars[1] as i32 == 0x00E9;
}

test "chars iter 3-byte UTF-8" {
    let chars: Array<char> = "日本".chars().collect();
    assert chars.len() == 2;
    assert chars[0] as i32 == 0x65E5;
    assert chars[1] as i32 == 0x672C;
}

test "chars iter 4-byte UTF-8" {
    let chars: Array<char> = "😀".chars().collect();
    assert chars.len() == 1;
    assert chars[0] as i32 == 0x1F600;
}

test "chars iter empty string" {
    assert "".chars().count() == 0;
    let chars: Array<char> = "".chars().collect();
    assert chars.len() == 0;
}

test "chars iter mixed encoding" {
    let chars: Array<char> = "Aéï日😀".chars().collect();
    assert chars.len() == 5;
    assert chars[0] == 'A';
    assert chars[1] as i32 == 0x00E9;
    assert chars[2] as i32 == 0x00EF;
    assert chars[3] as i32 == 0x65E5;
    assert chars[4] as i32 == 0x1F600;
}

test "chars iter single char" {
    let chars: Array<char> = "X".chars().collect();
    assert chars.len() == 1;
    assert chars[0] == 'X';
}

test "chars iter for-of" {
    let mut count = 0;
    let mut last = ' ';
    for let c of "Hi!".chars() {
        count += 1;
        last = c;
    }
    assert count == 3;
    assert last == '!';
}

test "bytes iter ASCII" {
    let bytes: Array<u8> = "Hello".bytes().collect();
    assert bytes.len() == 5;
    assert bytes[0] == 'H' as u8;
    assert bytes[1] == 'e' as u8;
    assert bytes[2] == 'l' as u8;
    assert bytes[3] == 'l' as u8;
    assert bytes[4] == 'o' as u8;
}

test "bytes iter empty string" {
    assert "".bytes().count() == 0;
    let bytes: Array<u8> = "".bytes().collect();
    assert bytes.len() == 0;
}

test "bytes iter 3-byte UTF-8" {
    let bytes: Array<u8> = "日".bytes().collect();
    assert bytes.len() == 3;
    assert bytes[0] == 0xE6;
    assert bytes[1] == 0x97;
    assert bytes[2] == 0xA5;
}

test "bytes iter 2-byte UTF-8" {
    let bytes: Array<u8> = "ñ".bytes().collect();
    assert bytes.len() == 2;
    assert bytes[0] == 0xC3;
    assert bytes[1] == 0xB1;
}

test "bytes iter 4-byte UTF-8" {
    let bytes: Array<u8> = "😀".bytes().collect();
    assert bytes.len() == 4;
    assert bytes[0] == 0xF0;
    assert bytes[1] == 0x9F;
    assert bytes[2] == 0x98;
    assert bytes[3] == 0x80;
}

test "bytes iter for-of" {
    let mut sum: i32 = 0;
    for let b of "AB".bytes() {
        sum += b as i32;
    }
    assert sum == 65 + 66;
}

test "char count vs byte length ASCII" {
    let s = "Hello";
    assert s.len() == 5;
    assert s.chars().count() == 5;
}

test "char count vs byte length 3-byte" {
    let s = "日本";
    assert s.len() == 6;
    assert s.chars().count() == 2;
}

test "char count vs byte length 4-byte" {
    let s = "😀";
    assert s.len() == 4;
    assert s.chars().count() == 1;
}

test "char count vs byte length 2-byte" {
    let s = "ñé";
    assert s.len() == 4;
    assert s.chars().count() == 2;
}

test "char count vs byte length mixed" {
    let s = "Aéï日😀";
    assert s.len() == 12;
    assert s.chars().count() == 5;
}

test "char count empty" {
    assert "".len() == 0;
    assert "".chars().count() == 0;
}

test "bytes count equals len" {
    let s = "Aéï日😀";
    assert s.bytes().count() == s.len();
}

test "collect bytes then chars" {
    let s = "Hi!";
    let bytes: Array<u8> = s.bytes().collect();
    assert bytes.len() == 3;
    assert bytes[0] == 'H' as u8;
    assert bytes[1] == 'i' as u8;
    assert bytes[2] == '!' as u8;

    let chars: Array<char> = s.chars().collect();
    assert chars.len() == 3;
    assert chars[0] == 'H';
    assert chars[1] == 'i';
    assert chars[2] == '!';
}

test "collect multibyte chars" {
    let s = "日😀";
    let chars: Array<char> = s.chars().collect();
    assert chars.len() == 2;
    assert chars[0] as i32 == 0x65E5;
    assert chars[1] as i32 == 0x1F600;

    let bytes: Array<u8> = s.bytes().collect();
    assert bytes.len() == 7;
}

test "truncate_bytes ASCII" {
    let mut s = "hello world";
    s.truncate_bytes(5);
    assert s == "hello";
}

test "truncate_bytes no-op when len >= current" {
    let mut s = "hi";
    s.truncate_bytes(10);
    assert s == "hi";
}

test "truncate_bytes to zero" {
    let mut s = "abc";
    s.truncate_bytes(0);
    assert s == "";
}

test "truncate_bytes UTF-8 3-byte boundary" {
    let mut s = "日本語";
    s.truncate_bytes(6);
    assert s == "日本";
}

test "truncate_bytes exact length" {
    let mut s = "hello";
    s.truncate_bytes(5);
    assert s == "hello";
}

test "truncate_bytes UTF-8 2-byte boundary" {
    let mut s = "ñé";
    s.truncate_bytes(2);
    assert s == "ñ";
}

test "truncate_bytes UTF-8 4-byte boundary" {
    let mut s = "😀😃";
    s.truncate_bytes(4);
    assert s == "😀";
}

test "truncate_chars ASCII" {
    let mut s = "hello world";
    s.truncate_chars(5);
    assert s == "hello";
}

test "truncate_chars no-op" {
    let mut s = "hi";
    s.truncate_chars(100);
    assert s == "hi";
}

test "truncate_chars to zero" {
    let mut s = "abc";
    s.truncate_chars(0);
    assert s == "";
}

test "truncate_chars multibyte" {
    let mut s = "日本語";
    s.truncate_chars(2);
    assert s == "日本";
}

test "truncate_chars mixed ASCII and multibyte" {
    let mut s = "A日B本C";
    s.truncate_chars(3);
    assert s == "A日B";
}

test "truncate_chars emoji" {
    let mut s = "😀😃😎";
    s.truncate_chars(2);
    assert s == "😀😃";
}

test "truncate_chars single" {
    let mut s = "hello";
    s.truncate_chars(1);
    assert s == "h";
}

test "truncate_chars exact count" {
    let mut s = "abc";
    s.truncate_chars(3);
    assert s == "abc";
}

test "is_ascii_whitespace true cases" {
    assert ' '.is_ascii_whitespace();
    assert '\t'.is_ascii_whitespace();
    assert '\n'.is_ascii_whitespace();
    assert '\r'.is_ascii_whitespace();
    assert '\u{0B}'.is_ascii_whitespace();  // VT
    assert '\u{0C}'.is_ascii_whitespace();  // FF
}

test "is_ascii_whitespace false cases" {
    assert !'a'.is_ascii_whitespace();
    assert !'0'.is_ascii_whitespace();
    assert !'\0'.is_ascii_whitespace();
    assert !'\u{08}'.is_ascii_whitespace();  // BS (adjacent to range)
    assert !'\u{0E}'.is_ascii_whitespace();  // SO (adjacent to range)
}

test "is_whitespace covers ASCII" {
    assert ' '.is_whitespace();
    assert '\t'.is_whitespace();
    assert '\n'.is_whitespace();
    assert '\r'.is_whitespace();
    assert '\u{0B}'.is_whitespace();
    assert '\u{0C}'.is_whitespace();
}

test "is_whitespace non-ASCII spaces" {
    assert '\u{85}'.is_whitespace();  // NEXT LINE
    assert '\u{A0}'.is_whitespace();  // NO-BREAK SPACE
    assert '\u{1680}'.is_whitespace();  // OGHAM SPACE MARK
    assert '\u{2000}'.is_whitespace();  // EN QUAD
    assert '\u{200A}'.is_whitespace();  // HAIR SPACE
    assert '\u{2028}'.is_whitespace();  // LINE SEPARATOR
    assert '\u{2029}'.is_whitespace();  // PARAGRAPH SEPARATOR
    assert '\u{202F}'.is_whitespace();  // NARROW NO-BREAK SPACE
    assert '\u{205F}'.is_whitespace();  // MEDIUM MATHEMATICAL SPACE
    assert '\u{3000}'.is_whitespace();  // IDEOGRAPHIC SPACE
}

test "is_whitespace false for non-space" {
    assert !'A'.is_whitespace();
    assert !'あ'.is_whitespace();
    assert !'\u{200B}'.is_whitespace();  // ZERO WIDTH SPACE is NOT whitespace
}

test "trim_ascii both sides" {
    assert "  hello  ".trim_ascii() == "hello";
    assert "\t\nhello\r\n".trim_ascii() == "hello";
    assert "hello".trim_ascii() == "hello";
    assert "   ".trim_ascii() == "";
    assert "".trim_ascii() == "";
}

test "trim_ascii_start" {
    assert "  hello  ".trim_ascii_start() == "hello  ";
    assert "\t\nhello".trim_ascii_start() == "hello";
    assert "hello".trim_ascii_start() == "hello";
    assert "   ".trim_ascii_start() == "";
}

test "trim_ascii_end" {
    assert "  hello  ".trim_ascii_end() == "  hello";
    assert "hello\t\n".trim_ascii_end() == "hello";
    assert "hello".trim_ascii_end() == "hello";
    assert "   ".trim_ascii_end() == "";
}

test "trim_ascii preserves non-ASCII" {
    // NO-BREAK SPACE (U+00A0) is not ASCII whitespace
    let s = String::concat('\u{A0}'.to_string(), "hello");
    assert s.trim_ascii() == s;
}

test "trim both sides" {
    assert "  hello  ".trim() == "hello";
    assert "\t\nhello\r\n".trim() == "hello";
    assert "hello".trim() == "hello";
    assert "   ".trim() == "";
    assert "".trim() == "";
}

test "trim_start" {
    assert "  hello  ".trim_start() == "hello  ";
    assert "\t\nhello".trim_start() == "hello";
    assert "hello".trim_start() == "hello";
    assert "   ".trim_start() == "";
}

test "trim_end" {
    assert "  hello  ".trim_end() == "  hello";
    assert "hello\t\n".trim_end() == "hello";
    assert "hello".trim_end() == "hello";
    assert "   ".trim_end() == "";
}

test "trim Unicode whitespace" {
    let nbsp = '\u{A0}'.to_string();
    let s = String::concat(String::concat(nbsp, "hello"), nbsp);
    assert s.trim() == "hello";
}

test "trim IDEOGRAPHIC SPACE" {
    let ideographic = '\u{3000}'.to_string();
    let s = String::concat(String::concat(ideographic, "日本語"), ideographic);
    assert s.trim() == "日本語";
}

test "trim mixed ASCII and Unicode whitespace" {
    let nbsp = '\u{A0}'.to_string();
    let s = String::concat(String::concat(" ", String::concat(nbsp, "hello")), " ");
    assert s.trim() == "hello";
}

test "String::concat" {
    let combined = String::concat(String::concat("Hello", ", "), "World!");
    assert combined == "Hello, World!";
}

test "String::append" {
    let mut builder = String::with_capacity(20);
    builder.append("Hello");
    builder.append(", ");
    builder.append("World!");
    assert builder == "Hello, World!";
}

test "String::with_capacity starts empty" {
    let s = String::with_capacity(10);
    assert s.len() == 0;
    assert s.is_empty();
}

test "append updates len" {
    let mut s = String::with_capacity(10);
    assert s.len() == 0;
    s.append("Hi");
    assert s.len() == 2;
}

test "is_empty on empty string" {
    let empty = String::with_capacity(0);
    assert empty.is_empty();
}

test "is_empty on nonempty string" {
    assert !"test".is_empty();
}

test "equal strings" {
    let a = "hello";
    let b = "hello";
    assert a == b;
}

test "not equal strings" {
    let a = "hello";
    let c = "world";
    assert a != c;
    assert !(a == c);
}

test "empty strings equal" {
    assert "" == "";
}

test "different lengths not equal" {
    assert "hi" != "hello";
}

test "same prefix different suffix" {
    assert "hello1" != "hello2";
}

test "String::from_utf8 empty" {
    assert String::from_utf8([] as Array<u8>) matches { Ok(s) && s == "" };
}

test "String::from_utf8 ASCII" {
    assert String::from_utf8([72, 101, 108, 108, 111] as Array<u8>) matches { Ok(s) && s == "Hello" };
}

test "String::from_utf8 2-byte UTF-8" {
    // ñ = 0xC3 0xB1
    assert String::from_utf8([0xC3, 0xB1] as Array<u8>) matches { Ok(s) && s == "ñ" };
}

test "String::from_utf8 3-byte UTF-8" {
    // 日 = 0xE6 0x97 0xA5
    assert String::from_utf8([0xE6, 0x97, 0xA5] as Array<u8>) matches { Ok(s) && s == "日" };
}

test "String::from_utf8 4-byte UTF-8" {
    // 😀 = 0xF0 0x9F 0x98 0x80
    assert String::from_utf8([0xF0, 0x9F, 0x98, 0x80] as Array<u8>) matches { Ok(s) && s == "😀" };
}

test "String::from_utf8 mixed valid UTF-8" {
    // "Aéï日😀" = 12 bytes
    assert String::from_utf8([0x41, 0xC3, 0xA9, 0xC3, 0xAF, 0xE6, 0x97, 0xA5, 0xF0, 0x9F, 0x98, 0x80] as Array<u8>) matches { Ok(s) && s == "Aéï日😀" };
}

test "String::from_utf8 roundtrip" {
    let original = "Hello, 世界! 😀";
    let bytes: Array<u8> = original.bytes().collect();
    assert String::from_utf8(bytes) matches { Ok(s) && s == original };
}

test "String::from_utf8 from bytes iter" {
    // Accepts any IntoIterator<Item = u8>: pass a bytes iterator directly
    assert String::from_utf8("日本語".bytes()) matches { Ok(s) && s == "日本語" };
}

test "String::from_utf8 lonely continuation byte" {
    assert String::from_utf8([0x80] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 overlong 2-byte 0xC0" {
    assert String::from_utf8([0xC0, 0x80] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 overlong 2-byte 0xC1" {
    assert String::from_utf8([0xC1, 0xBF] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 bad continuation byte in 2-byte" {
    // 0xC3 should be followed by 0x80-0xBF; 0x41 ('A') is invalid
    assert String::from_utf8([0xC3, 0x41] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 truncated 2-byte" {
    assert String::from_utf8([0xC3] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 truncated 3-byte" {
    assert String::from_utf8([0xE6, 0x97] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 truncated 4-byte" {
    assert String::from_utf8([0xF0, 0x9F, 0x98] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 overlong 3-byte" {
    // 0xE0 followed by < 0xA0 is overlong
    assert String::from_utf8([0xE0, 0x80, 0x80] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 surrogate" {
    // U+D800 encoded as UTF-8: 0xED 0xA0 0x80
    assert String::from_utf8([0xED, 0xA0, 0x80] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 overlong 4-byte" {
    // 0xF0 followed by < 0x90 is overlong
    assert String::from_utf8([0xF0, 0x80, 0x80, 0x80] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 out of range 4-byte" {
    // 0xF4 followed by > 0x8F encodes > U+10FFFF
    assert String::from_utf8([0xF4, 0x90, 0x80, 0x80] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 invalid byte 0xF5" {
    assert String::from_utf8([0xF5, 0x80, 0x80, 0x80] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 invalid byte 0xFF" {
    assert String::from_utf8([0xFF] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8_lossy empty" {
    assert String::from_utf8_lossy([] as Array<u8>) == "";
}

test "String::from_utf8_lossy ASCII passthrough" {
    assert String::from_utf8_lossy([72, 101, 108, 108, 111] as Array<u8>) == "Hello";
}

test "String::from_utf8_lossy valid multibyte passthrough" {
    // "日" = 0xE6 0x97 0xA5, "😀" = 0xF0 0x9F 0x98 0x80
    assert String::from_utf8_lossy([0xE6, 0x97, 0xA5, 0xF0, 0x9F, 0x98, 0x80] as Array<u8>) == "日😀";
}

test "String::from_utf8_lossy lone continuation byte" {
    // 0x80 → U+FFFD
    assert String::from_utf8_lossy([0x80] as Array<u8>) == "\uFFFD";
}

test "String::from_utf8_lossy invalid byte 0xFF" {
    assert String::from_utf8_lossy([0xFF] as Array<u8>) == "\uFFFD";
}

test "String::from_utf8_lossy truncated 2-byte" {
    // 0xC3 alone → U+FFFD
    assert String::from_utf8_lossy([0xC3] as Array<u8>) == "\uFFFD";
}

test "String::from_utf8_lossy truncated 3-byte" {
    // 0xE6 0x97 alone → U+FFFD
    assert String::from_utf8_lossy([0xE6, 0x97] as Array<u8>) == "\uFFFD";
}

test "String::from_utf8_lossy truncated 4-byte" {
    // 0xF0 0x9F 0x98 alone → U+FFFD
    assert String::from_utf8_lossy([0xF0, 0x9F, 0x98] as Array<u8>) == "\uFFFD";
}

test "String::from_utf8_lossy bad continuation replaced then ASCII continues" {
    // 0xC3 (2-byte lead) followed by 0x41 ('A', not a continuation) → FFFD + 'A'
    assert String::from_utf8_lossy([0xC3, 0x41] as Array<u8>) == "\uFFFDA";
}

test "String::from_utf8_lossy overlong 2-byte" {
    // 0xC0, 0x80 → FFFD, FFFD
    assert String::from_utf8_lossy([0xC0, 0x80] as Array<u8>) == "\uFFFD\uFFFD";
}

test "String::from_utf8_lossy overlong 3-byte" {
    // 0xE0, 0x80, 0x80 → FFFD, FFFD, FFFD
    assert String::from_utf8_lossy([0xE0, 0x80, 0x80] as Array<u8>) == "\uFFFD\uFFFD\uFFFD";
}

test "String::from_utf8_lossy surrogate" {
    // U+D800 = 0xED, 0xA0, 0x80 → FFFD, FFFD, FFFD
    assert String::from_utf8_lossy([0xED, 0xA0, 0x80] as Array<u8>) == "\uFFFD\uFFFD\uFFFD";
}

test "String::from_utf8_lossy mixed valid and invalid" {
    // 'A' + 0xFF (invalid) + 'B' → "A" + FFFD + "B"
    assert String::from_utf8_lossy([0x41, 0xFF, 0x42] as Array<u8>) == "A\uFFFDB";
}

test "String::from_utf8_lossy roundtrip valid" {
    let original = "Hello, 世界! 😀";
    let bytes: Array<u8> = original.bytes().collect();
    assert String::from_utf8_lossy(bytes) == original;
}

test "String::from_utf8_unchecked empty" {
    assert String::from_utf8_unchecked([] as Array<u8>) == "";
}

test "String::from_utf8_unchecked ASCII" {
    assert String::from_utf8_unchecked([72, 101, 108, 108, 111] as Array<u8>) == "Hello";
}

test "String::from_utf8_unchecked multibyte" {
    // "日" = 0xE6 0x97 0xA5
    assert String::from_utf8_unchecked([0xE6, 0x97, 0xA5] as Array<u8>) == "日";
}

test "String::from_utf8_unchecked roundtrip" {
    let original = "Hello, 世界! 😀";
    let bytes: Array<u8> = original.bytes().collect();
    assert String::from_utf8_unchecked(bytes) == original;
}

test "String::from_utf8_unchecked from bytes iter" {
    assert String::from_utf8_unchecked("日本語".bytes()) == "日本語";
}
