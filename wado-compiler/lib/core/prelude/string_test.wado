test "chars iter ASCII" {
    let chars: Array<char> = "ABC".chars().collect();
    assert chars.len() == 3;
    assert chars[0] == 'A';
    assert chars[1] == 'B';
    assert chars[2] == 'C';
}

test "chars iter 2-byte UTF-8" {
    let chars: Array<char> = "ñé".chars().collect();
    assert chars.len() == 2;
    assert chars[0] as i32 == 0x00F1;
    assert chars[1] as i32 == 0x00E9;
}

test "chars iter 3-byte UTF-8" {
    let chars: Array<char> = "日本".chars().collect();
    assert chars.len() == 2;
    assert chars[0] as i32 == 0x65E5;
    assert chars[1] as i32 == 0x672C;
}

test "chars iter 4-byte UTF-8" {
    let chars: Array<char> = "😀".chars().collect();
    assert chars.len() == 1;
    assert chars[0] as i32 == 0x1F600;
}

test "chars iter empty string" {
    assert "".chars().count() == 0;
    let chars: Array<char> = "".chars().collect();
    assert chars.len() == 0;
}

test "chars iter mixed encoding" {
    let chars: Array<char> = "Aéï日😀".chars().collect();
    assert chars.len() == 5;
    assert chars[0] == 'A';
    assert chars[1] as i32 == 0x00E9;
    assert chars[2] as i32 == 0x00EF;
    assert chars[3] as i32 == 0x65E5;
    assert chars[4] as i32 == 0x1F600;
}

test "chars iter single char" {
    let chars: Array<char> = "X".chars().collect();
    assert chars.len() == 1;
    assert chars[0] == 'X';
}

test "chars iter for-of" {
    let mut count = 0;
    let mut last = ' ';
    for let c of "Hi!".chars() {
        count += 1;
        last = c;
    }
    assert count == 3;
    assert last == '!';
}

test "bytes iter ASCII" {
    let bytes: Array<u8> = "Hello".bytes().collect();
    assert bytes.len() == 5;
    assert bytes[0] == 'H' as u8;
    assert bytes[1] == 'e' as u8;
    assert bytes[2] == 'l' as u8;
    assert bytes[3] == 'l' as u8;
    assert bytes[4] == 'o' as u8;
}

test "bytes iter empty string" {
    assert "".bytes().count() == 0;
    let bytes: Array<u8> = "".bytes().collect();
    assert bytes.len() == 0;
}

test "bytes iter 3-byte UTF-8" {
    let bytes: Array<u8> = "日".bytes().collect();
    assert bytes.len() == 3;
    assert bytes[0] == 0xE6;
    assert bytes[1] == 0x97;
    assert bytes[2] == 0xA5;
}

test "bytes iter 2-byte UTF-8" {
    let bytes: Array<u8> = "ñ".bytes().collect();
    assert bytes.len() == 2;
    assert bytes[0] == 0xC3;
    assert bytes[1] == 0xB1;
}

test "bytes iter 4-byte UTF-8" {
    let bytes: Array<u8> = "😀".bytes().collect();
    assert bytes.len() == 4;
    assert bytes[0] == 0xF0;
    assert bytes[1] == 0x9F;
    assert bytes[2] == 0x98;
    assert bytes[3] == 0x80;
}

test "bytes iter for-of" {
    let mut sum: i32 = 0;
    for let b of "AB".bytes() {
        sum += b as i32;
    }
    assert sum == 65 + 66;
}

test "char count vs byte length ASCII" {
    let s = "Hello";
    assert s.len() == 5;
    assert s.chars().count() == 5;
}

test "char count vs byte length 3-byte" {
    let s = "日本";
    assert s.len() == 6;
    assert s.chars().count() == 2;
}

test "char count vs byte length 4-byte" {
    let s = "😀";
    assert s.len() == 4;
    assert s.chars().count() == 1;
}

test "char count vs byte length 2-byte" {
    let s = "ñé";
    assert s.len() == 4;
    assert s.chars().count() == 2;
}

test "char count vs byte length mixed" {
    let s = "Aéï日😀";
    assert s.len() == 12;
    assert s.chars().count() == 5;
}

test "char count empty" {
    assert "".len() == 0;
    assert "".chars().count() == 0;
}

test "bytes count equals len" {
    let s = "Aéï日😀";
    assert s.bytes().count() == s.len();
}

test "collect bytes then chars" {
    let s = "Hi!";
    let bytes: Array<u8> = s.bytes().collect();
    assert bytes.len() == 3;
    assert bytes[0] == 'H' as u8;
    assert bytes[1] == 'i' as u8;
    assert bytes[2] == '!' as u8;

    let chars: Array<char> = s.chars().collect();
    assert chars.len() == 3;
    assert chars[0] == 'H';
    assert chars[1] == 'i';
    assert chars[2] == '!';
}

test "collect multibyte chars" {
    let s = "日😀";
    let chars: Array<char> = s.chars().collect();
    assert chars.len() == 2;
    assert chars[0] as i32 == 0x65E5;
    assert chars[1] as i32 == 0x1F600;

    let bytes: Array<u8> = s.bytes().collect();
    assert bytes.len() == 7;
}

test "truncate ASCII" {
    let mut s = "hello world";
    s.truncate(5);
    assert s == "hello";
}

test "truncate no-op when len >= current" {
    let mut s = "hi";
    s.truncate(10);
    assert s == "hi";
}

test "truncate to zero" {
    let mut s = "abc";
    s.truncate(0);
    assert s == "";
}

test "truncate UTF-8 3-byte boundary" {
    let mut s = "日本語";
    s.truncate(6);
    assert s == "日本";
}

test "truncate exact length" {
    let mut s = "hello";
    s.truncate(5);
    assert s == "hello";
}

test "truncate UTF-8 2-byte boundary" {
    let mut s = "ñé";
    s.truncate(2);
    assert s == "ñ";
}

test "truncate UTF-8 4-byte boundary" {
    let mut s = "😀😃";
    s.truncate(4);
    assert s == "😀";
}

test "truncate_chars ASCII" {
    let mut s = "hello world";
    s.truncate_chars(5);
    assert s == "hello";
}

test "truncate_chars no-op" {
    let mut s = "hi";
    s.truncate_chars(100);
    assert s == "hi";
}

test "truncate_chars to zero" {
    let mut s = "abc";
    s.truncate_chars(0);
    assert s == "";
}

test "truncate_chars multibyte" {
    let mut s = "日本語";
    s.truncate_chars(2);
    assert s == "日本";
}

test "truncate_chars mixed ASCII and multibyte" {
    let mut s = "A日B本C";
    s.truncate_chars(3);
    assert s == "A日B";
}

test "truncate_chars emoji" {
    let mut s = "😀😃😎";
    s.truncate_chars(2);
    assert s == "😀😃";
}

test "truncate_chars single" {
    let mut s = "hello";
    s.truncate_chars(1);
    assert s == "h";
}

test "truncate_chars exact count" {
    let mut s = "abc";
    s.truncate_chars(3);
    assert s == "abc";
}

test "is_ascii_whitespace true cases" {
    assert ' '.is_ascii_whitespace();
    assert '\t'.is_ascii_whitespace();
    assert '\n'.is_ascii_whitespace();
    assert '\r'.is_ascii_whitespace();
    assert '\u{0B}'.is_ascii_whitespace();  // VT
    assert '\u{0C}'.is_ascii_whitespace();  // FF
}

test "is_ascii_whitespace false cases" {
    assert !'a'.is_ascii_whitespace();
    assert !'0'.is_ascii_whitespace();
    assert !'\0'.is_ascii_whitespace();
    assert !'\u{08}'.is_ascii_whitespace();  // BS (adjacent to range)
    assert !'\u{0E}'.is_ascii_whitespace();  // SO (adjacent to range)
}

test "is_whitespace covers ASCII" {
    assert ' '.is_whitespace();
    assert '\t'.is_whitespace();
    assert '\n'.is_whitespace();
    assert '\r'.is_whitespace();
    assert '\u{0B}'.is_whitespace();
    assert '\u{0C}'.is_whitespace();
}

test "is_whitespace non-ASCII spaces" {
    assert '\u{85}'.is_whitespace();  // NEXT LINE
    assert '\u{A0}'.is_whitespace();  // NO-BREAK SPACE
    assert '\u{1680}'.is_whitespace();  // OGHAM SPACE MARK
    assert '\u{2000}'.is_whitespace();  // EN QUAD
    assert '\u{200A}'.is_whitespace();  // HAIR SPACE
    assert '\u{2028}'.is_whitespace();  // LINE SEPARATOR
    assert '\u{2029}'.is_whitespace();  // PARAGRAPH SEPARATOR
    assert '\u{202F}'.is_whitespace();  // NARROW NO-BREAK SPACE
    assert '\u{205F}'.is_whitespace();  // MEDIUM MATHEMATICAL SPACE
    assert '\u{3000}'.is_whitespace();  // IDEOGRAPHIC SPACE
}

test "is_whitespace false for non-space" {
    assert !'A'.is_whitespace();
    assert !'あ'.is_whitespace();
    assert !'\u{200B}'.is_whitespace();  // ZERO WIDTH SPACE is NOT whitespace
}

test "is_hexdigit true cases" {
    assert '0'.is_hexdigit();
    assert '9'.is_hexdigit();
    assert 'a'.is_hexdigit();
    assert 'f'.is_hexdigit();
    assert 'A'.is_hexdigit();
    assert 'F'.is_hexdigit();
}

test "is_hexdigit false cases" {
    assert !'g'.is_hexdigit();
    assert !'G'.is_hexdigit();
    assert !' '.is_hexdigit();
    assert !'z'.is_hexdigit();
}

test "hex_digit_value" {
    assert '0'.hex_digit_value() == 0;
    assert '9'.hex_digit_value() == 9;
    assert 'a'.hex_digit_value() == 10;
    assert 'f'.hex_digit_value() == 15;
    assert 'A'.hex_digit_value() == 10;
    assert 'F'.hex_digit_value() == 15;
}

test "is_ascii_lowercase" {
    assert 'a'.is_ascii_lowercase();
    assert 'z'.is_ascii_lowercase();
    assert !'A'.is_ascii_lowercase();
    assert !'0'.is_ascii_lowercase();
    assert !'é'.is_ascii_lowercase();
}

test "is_ascii_uppercase" {
    assert 'A'.is_ascii_uppercase();
    assert 'Z'.is_ascii_uppercase();
    assert !'a'.is_ascii_uppercase();
    assert !'0'.is_ascii_uppercase();
    assert !'É'.is_ascii_uppercase();
}

test "char to_ascii_lowercase" {
    assert 'A'.to_ascii_lowercase() == 'a';
    assert 'Z'.to_ascii_lowercase() == 'z';
    assert 'a'.to_ascii_lowercase() == 'a';
    assert '0'.to_ascii_lowercase() == '0';
    assert 'é'.to_ascii_lowercase() == 'é';
}

test "char to_ascii_uppercase" {
    assert 'a'.to_ascii_uppercase() == 'A';
    assert 'z'.to_ascii_uppercase() == 'Z';
    assert 'A'.to_ascii_uppercase() == 'A';
    assert '0'.to_ascii_uppercase() == '0';
    assert 'é'.to_ascii_uppercase() == 'é';
}

test "String from_iter" {
    let s = String::from_iter("hello".chars());
    assert s == "hello";
    let empty = String::from_iter("".chars());
    assert empty == "";
    // Multi-byte chars
    let utf8 = String::from_iter("café".chars());
    assert utf8 == "café";
}

test "String to_ascii_lowercase" {
    assert "Hello, World!".to_ascii_lowercase() == "hello, world!";
    assert "ABC".to_ascii_lowercase() == "abc";
    assert "abc".to_ascii_lowercase() == "abc";
    assert "123".to_ascii_lowercase() == "123";
    assert "".to_ascii_lowercase() == "";
    assert "Héllo".to_ascii_lowercase() == "héllo";
}

test "String to_ascii_uppercase" {
    assert "Hello, World!".to_ascii_uppercase() == "HELLO, WORLD!";
    assert "abc".to_ascii_uppercase() == "ABC";
    assert "ABC".to_ascii_uppercase() == "ABC";
    assert "123".to_ascii_uppercase() == "123";
    assert "".to_ascii_uppercase() == "";
    assert "héllo".to_ascii_uppercase() == "HéLLO";
}

test "trim_ascii both sides" {
    assert "  hello  ".trim_ascii() == "hello";
    assert "\t\nhello\r\n".trim_ascii() == "hello";
    assert "hello".trim_ascii() == "hello";
    assert "   ".trim_ascii() == "";
    assert "".trim_ascii() == "";
}

test "trim_ascii_start" {
    assert "  hello  ".trim_ascii_start() == "hello  ";
    assert "\t\nhello".trim_ascii_start() == "hello";
    assert "hello".trim_ascii_start() == "hello";
    assert "   ".trim_ascii_start() == "";
}

test "trim_ascii_end" {
    assert "  hello  ".trim_ascii_end() == "  hello";
    assert "hello\t\n".trim_ascii_end() == "hello";
    assert "hello".trim_ascii_end() == "hello";
    assert "   ".trim_ascii_end() == "";
}

test "trim_ascii preserves non-ASCII" {
    // NO-BREAK SPACE (U+00A0) is not ASCII whitespace
    let s = '\u{A0}'.to_string() + "hello";
    assert s.trim_ascii() == s;
}

test "trim both sides" {
    assert "  hello  ".trim() == "hello";
    assert "\t\nhello\r\n".trim() == "hello";
    assert "hello".trim() == "hello";
    assert "   ".trim() == "";
    assert "".trim() == "";
}

test "trim_start" {
    assert "  hello  ".trim_start() == "hello  ";
    assert "\t\nhello".trim_start() == "hello";
    assert "hello".trim_start() == "hello";
    assert "   ".trim_start() == "";
}

test "trim_end" {
    assert "  hello  ".trim_end() == "  hello";
    assert "hello\t\n".trim_end() == "hello";
    assert "hello".trim_end() == "hello";
    assert "   ".trim_end() == "";
}

test "trim Unicode whitespace" {
    let nbsp = '\u{A0}'.to_string();
    let s = nbsp + "hello" + nbsp;
    assert s.trim() == "hello";
}

test "trim IDEOGRAPHIC SPACE" {
    let ideographic = '\u{3000}'.to_string();
    let s = ideographic + "日本語" + ideographic;
    assert s.trim() == "日本語";
}

test "trim mixed ASCII and Unicode whitespace" {
    let nbsp = '\u{A0}'.to_string();
    let s = " " + nbsp + "hello" + " ";
    assert s.trim() == "hello";
}

test "string addition" {
    let combined = "Hello" + ", " + "World!";
    assert combined == "Hello, World!";
}

test "String::push_str" {
    let mut builder = String::with_capacity(20);
    builder.push_str(&"Hello");
    builder.push_str(&", ");
    builder.push_str(&"World!");
    assert builder == "Hello, World!";
}

// Issue #1105: push_str accepts &String to align with Rust's `&str` borrow
// and avoid the per-call deep copy of a `String` argument.
test "String::push_str accepts &String" {
    let mut builder = String::with_capacity(20);
    let greeting: String = "Hello, ";
    let target: String = "World!";
    builder.push_str(&greeting);
    builder.push_str(&target);
    assert builder == "Hello, World!";
}

test "String::with_capacity starts empty" {
    let s = String::with_capacity(10);
    assert s.len() == 0;
    assert s.is_empty();
}

test "String::new starts empty" {
    let s = String::new();
    assert s.len() == 0;
    assert s.is_empty();
    assert s.capacity() == 0;
}

test "String::new is usable as a growable buffer" {
    let mut s = String::new();
    s.push_str("Hello");
    s.push(',');
    s.push(' ');
    s.push_str("World!");
    assert s == "Hello, World!";
}

test "push_str updates len" {
    let mut s = String::with_capacity(10);
    assert s.len() == 0;
    s.push_str(&"Hi");
    assert s.len() == 2;
}

test "is_empty on empty string" {
    let empty = String::with_capacity(0);
    assert empty.is_empty();
}

test "is_empty on nonempty string" {
    assert !"test".is_empty();
}

test "equal strings" {
    let a = "hello";
    let b = "hello";
    assert a == b;
}

test "not equal strings" {
    let a = "hello";
    let c = "world";
    assert a != c;
    assert !(a == c);
}

test "empty strings equal" {
    assert "" == "";
}

test "different lengths not equal" {
    assert "hi" != "hello";
}

test "same prefix different suffix" {
    assert "hello1" != "hello2";
}

test "String::from_utf8 empty" {
    assert String::from_utf8([] as Array<u8>) matches { Ok(s) && s == "" };
}

test "String::from_utf8 ASCII" {
    assert String::from_utf8([72, 101, 108, 108, 111] as Array<u8>) matches { Ok(s) && s == "Hello" };
}

test "String::from_utf8 2-byte UTF-8" {
    // ñ = 0xC3 0xB1
    assert String::from_utf8([0xC3, 0xB1] as Array<u8>) matches { Ok(s) && s == "ñ" };
}

test "String::from_utf8 3-byte UTF-8" {
    // 日 = 0xE6 0x97 0xA5
    assert String::from_utf8([0xE6, 0x97, 0xA5] as Array<u8>) matches { Ok(s) && s == "日" };
}

test "String::from_utf8 4-byte UTF-8" {
    // 😀 = 0xF0 0x9F 0x98 0x80
    assert String::from_utf8([0xF0, 0x9F, 0x98, 0x80] as Array<u8>) matches { Ok(s) && s == "😀" };
}

test "String::from_utf8 mixed valid UTF-8" {
    // "Aéï日😀" = 12 bytes
    assert String::from_utf8([0x41, 0xC3, 0xA9, 0xC3, 0xAF, 0xE6, 0x97, 0xA5, 0xF0, 0x9F, 0x98, 0x80] as Array<u8>) matches { Ok(s) && s == "Aéï日😀" };
}

test "String::from_utf8 roundtrip" {
    let original = "Hello, 世界! 😀";
    let bytes: Array<u8> = original.bytes().collect();
    assert String::from_utf8(bytes) matches { Ok(s) && s == original };
}

test "String::from_utf8 from bytes iter" {
    // Accepts any IntoIterator<Item = u8>: pass a bytes iterator directly
    assert String::from_utf8("日本語".bytes()) matches { Ok(s) && s == "日本語" };
}

test "String::from_utf8 lonely continuation byte" {
    assert String::from_utf8([0x80] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 overlong 2-byte 0xC0" {
    assert String::from_utf8([0xC0, 0x80] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 overlong 2-byte 0xC1" {
    assert String::from_utf8([0xC1, 0xBF] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 bad continuation byte in 2-byte" {
    // 0xC3 should be followed by 0x80-0xBF; 0x41 ('A') is invalid
    assert String::from_utf8([0xC3, 0x41] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 truncated 2-byte" {
    assert String::from_utf8([0xC3] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 truncated 3-byte" {
    assert String::from_utf8([0xE6, 0x97] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 truncated 4-byte" {
    assert String::from_utf8([0xF0, 0x9F, 0x98] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 overlong 3-byte" {
    // 0xE0 followed by < 0xA0 is overlong
    assert String::from_utf8([0xE0, 0x80, 0x80] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 surrogate" {
    // U+D800 encoded as UTF-8: 0xED 0xA0 0x80
    assert String::from_utf8([0xED, 0xA0, 0x80] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 overlong 4-byte" {
    // 0xF0 followed by < 0x90 is overlong
    assert String::from_utf8([0xF0, 0x80, 0x80, 0x80] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 out of range 4-byte" {
    // 0xF4 followed by > 0x8F encodes > U+10FFFF
    assert String::from_utf8([0xF4, 0x90, 0x80, 0x80] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 invalid byte 0xF5" {
    assert String::from_utf8([0xF5, 0x80, 0x80, 0x80] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8 invalid byte 0xFF" {
    assert String::from_utf8([0xFF] as Array<u8>) matches { Err(_) };
}

test "String::from_utf8_lossy empty" {
    assert String::from_utf8_lossy([] as Array<u8>) == "";
}

test "String::from_utf8_lossy ASCII passthrough" {
    assert String::from_utf8_lossy([72, 101, 108, 108, 111] as Array<u8>) == "Hello";
}

test "String::from_utf8_lossy valid multibyte passthrough" {
    // "日" = 0xE6 0x97 0xA5, "😀" = 0xF0 0x9F 0x98 0x80
    assert String::from_utf8_lossy([0xE6, 0x97, 0xA5, 0xF0, 0x9F, 0x98, 0x80] as Array<u8>) == "日😀";
}

test "String::from_utf8_lossy lone continuation byte" {
    // 0x80 → U+FFFD
    assert String::from_utf8_lossy([0x80] as Array<u8>) == "\uFFFD";
}

test "String::from_utf8_lossy invalid byte 0xFF" {
    assert String::from_utf8_lossy([0xFF] as Array<u8>) == "\uFFFD";
}

test "String::from_utf8_lossy truncated 2-byte" {
    // 0xC3 alone → U+FFFD
    assert String::from_utf8_lossy([0xC3] as Array<u8>) == "\uFFFD";
}

test "String::from_utf8_lossy truncated 3-byte" {
    // 0xE6 0x97 alone → U+FFFD
    assert String::from_utf8_lossy([0xE6, 0x97] as Array<u8>) == "\uFFFD";
}

test "String::from_utf8_lossy truncated 4-byte" {
    // 0xF0 0x9F 0x98 alone → U+FFFD
    assert String::from_utf8_lossy([0xF0, 0x9F, 0x98] as Array<u8>) == "\uFFFD";
}

test "String::from_utf8_lossy bad continuation replaced then ASCII continues" {
    // 0xC3 (2-byte lead) followed by 0x41 ('A', not a continuation) → FFFD + 'A'
    assert String::from_utf8_lossy([0xC3, 0x41] as Array<u8>) == "\uFFFDA";
}

test "String::from_utf8_lossy overlong 2-byte" {
    // 0xC0, 0x80 → FFFD, FFFD
    assert String::from_utf8_lossy([0xC0, 0x80] as Array<u8>) == "\uFFFD\uFFFD";
}

test "String::from_utf8_lossy overlong 3-byte" {
    // 0xE0, 0x80, 0x80 → FFFD, FFFD, FFFD
    assert String::from_utf8_lossy([0xE0, 0x80, 0x80] as Array<u8>) == "\uFFFD\uFFFD\uFFFD";
}

test "String::from_utf8_lossy surrogate" {
    // U+D800 = 0xED, 0xA0, 0x80 → FFFD, FFFD, FFFD
    assert String::from_utf8_lossy([0xED, 0xA0, 0x80] as Array<u8>) == "\uFFFD\uFFFD\uFFFD";
}

test "String::from_utf8_lossy mixed valid and invalid" {
    // 'A' + 0xFF (invalid) + 'B' → "A" + FFFD + "B"
    assert String::from_utf8_lossy([0x41, 0xFF, 0x42] as Array<u8>) == "A\uFFFDB";
}

test "String::from_utf8_lossy roundtrip valid" {
    let original = "Hello, 世界! 😀";
    let bytes: Array<u8> = original.bytes().collect();
    assert String::from_utf8_lossy(bytes) == original;
}

test "String::from_utf8_unchecked empty" {
    assert String::from_utf8_unchecked([] as Array<u8>) == "";
}

test "String::from_utf8_unchecked ASCII" {
    assert String::from_utf8_unchecked([72, 101, 108, 108, 111] as Array<u8>) == "Hello";
}

test "String::from_utf8_unchecked multibyte" {
    // "日" = 0xE6 0x97 0xA5
    assert String::from_utf8_unchecked([0xE6, 0x97, 0xA5] as Array<u8>) == "日";
}

test "String::from_utf8_unchecked roundtrip" {
    let original = "Hello, 世界! 😀";
    let bytes: Array<u8> = original.bytes().collect();
    assert String::from_utf8_unchecked(bytes) == original;
}

test "String::from_utf8_unchecked from bytes iter" {
    assert String::from_utf8_unchecked("日本語".bytes()) == "日本語";
}

// --- New API tests ---

test "push_str" {
    let mut s = String::with_capacity(20);
    s.push_str(&"Hello");
    s.push_str(&", ");
    s.push_str(&"World!");
    assert s == "Hello, World!";
}

test "push" {
    let mut s = String::with_capacity(10);
    s.push('H');
    s.push('i');
    s.push('!');
    assert s == "Hi!";
}

test "push multibyte" {
    let mut s = String::with_capacity(20);
    s.push('日');
    s.push('本');
    assert s == "日本";
}

test "pop ASCII" {
    let mut s = "hello";
    let c = s.pop();
    assert c matches { Some(ch) && ch == 'o' };
    assert s == "hell";
}

test "pop multibyte" {
    let mut s = "日本";
    let c = s.pop();
    assert c matches { Some(ch) && ch as i32 == 0x672C };
    assert s == "日";
}

test "pop empty" {
    let mut s = "";
    assert s.pop() matches { None };
}

test "clear" {
    let mut s = "hello";
    s.clear();
    assert s == "";
    assert s.is_empty();
}

test "capacity and reserve" {
    let mut s = String::with_capacity(10);
    assert s.capacity() >= 10;
    s.push_str(&"hi");
    s.reserve(100);
    assert s.capacity() >= 102;
    assert s == "hi";
}

test "shrink_to_fit" {
    let mut s = String::with_capacity(1000);
    s.push_str(&"hi");
    s.shrink_to_fit();
    assert s.capacity() == 2;
    assert s == "hi";
}

test "bytes collect" {
    let bytes: Array<u8> = "Hello".bytes().collect();
    assert bytes.len() == 5;
    assert bytes[0] == 72;
    assert bytes[4] == 111;
}

test "bytes collect multibyte" {
    let bytes: Array<u8> = "日".bytes().collect();
    assert bytes.len() == 3;
    assert bytes[0] == 0xE6;
    assert bytes[1] == 0x97;
    assert bytes[2] == 0xA5;
}

test "contains" {
    assert "hello world".contains("world");
    assert "hello world".contains("hello");
    assert "hello world".contains(" ");
    assert !"hello world".contains("xyz");
    assert "hello".contains("");
}

test "starts_with" {
    assert "hello world".starts_with("hello");
    assert !"hello world".starts_with("world");
    assert "hello".starts_with("");
    assert "hello".starts_with("hello");
}

test "ends_with" {
    assert "hello world".ends_with("world");
    assert !"hello world".ends_with("hello");
    assert "hello".ends_with("");
    assert "hello".ends_with("hello");
}

test "find" {
    assert "hello world".find("world") matches { Some(idx) && idx == 6 };
    assert "hello world".find("hello") matches { Some(idx) && idx == 0 };
    assert "hello world".find("xyz") matches { None };
    assert "abcabc".find("bc") matches { Some(idx) && idx == 1 };
}

test "rfind" {
    assert "abcabc".rfind("bc") matches { Some(idx) && idx == 4 };
    assert "hello".rfind("xyz") matches { None };
    assert "hello".rfind("hello") matches { Some(idx) && idx == 0 };
}

test "contains_char" {
    assert "hello".contains_char('h');
    assert "hello".contains_char('o');
    assert !"hello".contains_char('x');
}

test "find_char" {
    assert "hello".find_char(|c: char| c == 'l') matches { Some(idx) && idx == 2 };
    assert "hello".find_char(|c: char| c == 'x') matches { None };
}

test "truncate" {
    let mut s = "hello world";
    s.truncate(5);
    assert s == "hello";
}

test "truncate no-op" {
    let mut s = "hi";
    s.truncate(10);
    assert s == "hi";
}

test "insert char" {
    let mut s = "hllo";
    s.insert(1, 'e');
    assert s == "hello";
}

test "insert char at start" {
    let mut s = "ello";
    s.insert(0, 'h');
    assert s == "hello";
}

test "insert char at end" {
    let mut s = "hell";
    s.insert(4, 'o');
    assert s == "hello";
}

test "insert_str" {
    let mut s = "hd";
    s.insert_str(1, "ello worl");
    assert s == "hello world";
}

test "remove" {
    let mut s = "hello";
    let c = s.remove(0);
    assert c == 'h';
    assert s == "ello";
}

test "remove middle" {
    let mut s = "hello";
    let c = s.remove(2);
    assert c == 'l';
    assert s == "helo";
}

test "repeat" {
    assert "ab".repeat(3) == "ababab";
    assert "x".repeat(0) == "";
    assert "hi".repeat(1) == "hi";
}

test "replace" {
    assert "hello world".replace("world", "earth") == "hello earth";
    assert "aaa".replace("a", "bb") == "bbbbbb";
    assert "hello".replace("xyz", "abc") == "hello";
}

test "replacen" {
    assert "aaa".replacen("a", "bb", 2) == "bbbba";
    assert "aaa".replacen("a", "bb", 0) == "aaa";
}

test "split" {
    let parts: Array<String> = "a,b,c".split(",").collect();
    assert parts.len() == 3;
    assert parts[0] == "a";
    assert parts[1] == "b";
    assert parts[2] == "c";
}

test "split no match" {
    let parts: Array<String> = "hello".split(",").collect();
    assert parts.len() == 1;
    assert parts[0] == "hello";
}

test "splitn" {
    let parts: Array<String> = "a,b,c,d".splitn(3, ",").collect();
    assert parts.len() == 3;
    assert parts[0] == "a";
    assert parts[1] == "b";
    assert parts[2] == "c,d";
}

test "split_whitespace" {
    let parts: Array<String> = "  hello   world  ".split_whitespace().collect();
    assert parts.len() == 2;
    assert parts[0] == "hello";
    assert parts[1] == "world";
}

test "split_whitespace empty" {
    let parts: Array<String> = "   ".split_whitespace().collect();
    assert parts.len() == 0;
}

test "lines" {
    let ls: Array<String> = "hello\nworld\n".lines().collect();
    assert ls.len() == 2;
    assert ls[0] == "hello";
    assert ls[1] == "world";
}

test "lines CRLF" {
    let ls: Array<String> = "a\r\nb\r\n".lines().collect();
    assert ls.len() == 2;
    assert ls[0] == "a";
    assert ls[1] == "b";
}

test "lines no trailing newline" {
    let ls: Array<String> = "a\nb".lines().collect();
    assert ls.len() == 2;
    assert ls[0] == "a";
    assert ls[1] == "b";
}

test "char_indices" {
    let indices: Array<[i32, char]> = "Aé".char_indices().collect();
    assert indices.len() == 2;
    assert indices[0].0 == 0;
    assert indices[0].1 == 'A';
    assert indices[1].0 == 1;
    assert indices[1].1 as i32 == 0xE9;
}

test "char_indices multibyte" {
    let indices: Array<[i32, char]> = "日本".char_indices().collect();
    assert indices.len() == 2;
    assert indices[0].0 == 0;
    assert indices[1].0 == 3;
}

test "eq_ignore_ascii_case same case" {
    assert "hello".eq_ignore_ascii_case("hello");
    assert "HELLO".eq_ignore_ascii_case("HELLO");
}

test "eq_ignore_ascii_case different case" {
    assert "Hello".eq_ignore_ascii_case("hello");
    assert "hello".eq_ignore_ascii_case("HELLO");
    assert "HeLLo WoRLd".eq_ignore_ascii_case("hello world");
}

test "eq_ignore_ascii_case non-alpha" {
    assert "123!@#".eq_ignore_ascii_case("123!@#");
    assert !"123".eq_ignore_ascii_case("456");
}

test "eq_ignore_ascii_case different lengths" {
    assert !"hello".eq_ignore_ascii_case("hell");
    assert !"hell".eq_ignore_ascii_case("hello");
}

test "eq_ignore_ascii_case empty" {
    assert "".eq_ignore_ascii_case("");
    assert !"".eq_ignore_ascii_case("a");
}

test "eq_ignore_ascii_case non-ASCII unchanged" {
    assert "café".eq_ignore_ascii_case("café");
    assert !"café".eq_ignore_ascii_case("CAFÉ");
}

test "is_char_boundary at start and end" {
    let s = "hello";
    assert s.is_char_boundary(0);
    assert s.is_char_boundary(5);
}

test "is_char_boundary ASCII" {
    let s = "hello";
    for let mut i = 0; i <= 5; i += 1 {
        assert s.is_char_boundary(i);
    }
}

test "is_char_boundary multibyte" {
    // "日本" — 6 bytes, 3 bytes each
    let s = "日本";
    assert s.is_char_boundary(0);
    assert !s.is_char_boundary(1);
    assert !s.is_char_boundary(2);
    assert s.is_char_boundary(3);
    assert !s.is_char_boundary(4);
    assert !s.is_char_boundary(5);
    assert s.is_char_boundary(6);
}

test "is_char_boundary out of range" {
    let s = "hi";
    assert !s.is_char_boundary(-1);
    assert !s.is_char_boundary(3);
}

test "char_at_byte_unchecked ASCII" {
    let s = "hi";
    assert s.char_at_byte_unchecked(0) == 'h';
    assert s.char_at_byte_unchecked(1) == 'i';
}

test "char_at_byte_unchecked multibyte" {
    let s = "日本";
    assert s.char_at_byte_unchecked(0) == '日';
    assert s.char_at_byte_unchecked(3) == '本';
}

test "push_bytes_unchecked ASCII" {
    let mut s = String::with_capacity(0);
    let bytes: Array<u8> = ['h' as u8, 'i' as u8];
    s.push_bytes_unchecked(bytes);
    assert s == "hi";
}

test "push_bytes_unchecked empty" {
    let mut s = "abc";
    let bytes: Array<u8> = [];
    s.push_bytes_unchecked(bytes);
    assert s == "abc";
}

test "push_bytes_unchecked multibyte" {
    let mut s = "x";
    let bytes: Array<u8> = [0xE6, 0x97, 0xA5];  // "日"
    s.push_bytes_unchecked(bytes);
    assert s == "x日";
}

test "push_str_range_unchecked ASCII" {
    let mut dst = "[";
    let src = "hello";
    dst.push_str_range_unchecked(src, 1, 4);
    dst.push_str(&"]");
    assert dst == "[ell]";
}

test "push_str_range_unchecked full range" {
    let mut dst = String::with_capacity(0);
    dst.push_str_range_unchecked("abcd", 0, 4);
    assert dst == "abcd";
}

test "push_str_range_unchecked empty range" {
    let mut dst = "x";
    dst.push_str_range_unchecked("hello", 2, 2);
    assert dst == "x";
}

test "push_str_range_unchecked multibyte" {
    let mut dst = String::with_capacity(0);
    let src = "日本語";
    dst.push_str_range_unchecked(src, 3, 6);  // "本"
    assert dst == "本";
}

test "substr_bytes_unchecked basic" {
    let s = "hello";
    assert s.substr_bytes_unchecked(1, 4) == "ell";
}

test "truncate_unchecked basic" {
    let mut s = "hello";
    s.truncate_unchecked(3);
    assert s == "hel";
}

test "insert_unchecked ASCII" {
    let mut s = "ac";
    s.insert_unchecked(1, 'b');
    assert s == "abc";
}

test "insert_str_unchecked ASCII" {
    let mut s = "<>";
    s.insert_str_unchecked(1, "x");
    assert s == "<x>";
}

test "remove_unchecked ASCII" {
    let mut s = "abc";
    let c = s.remove_unchecked(1);
    assert c == 'b';
    assert s == "ac";
}
