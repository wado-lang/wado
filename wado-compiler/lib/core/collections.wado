// Collections module for Wado.
//
// This module provides collection types beyond the built-in Array.//
// TreeMap uses a two-part data structure inspired by Rust's indexmap crate:
// 1. A self-balancing binary search tree (AA tree) for O(log n) key lookups
// 2. A dense array (entries) for O(1) insertion-order iteration
//
// The tree nodes store indices pointing into the entries array, allowing
// fast key-based lookups while maintaining insertion order for iteration.

// An entry in the map (key-value pair with deletion flag)
struct TreeMapEntry<K, V> {
    key: K,
    value: V,
    deleted: bool,
}

// A node in the tree (stores key and index into entries array)
struct TreeMapNode<K> {
    key: K,
    index: i32,
    level: i32,
    left: Option<&mut TreeMapNode<K>>,
    right: Option<&mut TreeMapNode<K>>,
}

/// A map that iterates in insertion order.
///
/// Keys are stored in a tree for O(log n) lookups, while key-value pairs
/// are stored in a dense array for fast, insertion-order iteration.
///
/// This is similar to Rust's `indexmap::IndexMap` but uses a tree instead
/// of a hash table for key lookups.
pub struct TreeMap<K, V> {
    root: Option<&mut TreeMapNode<K>>,
    entries: Array<TreeMapEntry<K, V>>,
    size: i32,
    deleted_count: i32,
}

impl TreeMap<K, V> {
    /// Creates a new empty TreeMap
    pub fn new() -> TreeMap<K, V> {
        return TreeMap {
            root: null,
            entries: [],
            size: 0,
            deleted_count: 0,
        };
    }

    /// Returns the number of key-value pairs in the map
    pub fn len(&self) -> i32 { return self.size; }

    /// Returns true if the map contains no elements
    pub fn is_empty(&self) -> bool { return self.size == 0; }

    // Skew: right rotation to fix left horizontal link
    fn skew(&mut self, node: Option<&mut TreeMapNode<K>>) -> Option<&mut TreeMapNode<K>> {
        if let Some(n) = node {
            if let Some(left) = n.left {
                if left.level == n.level {
                    n.left = left.right;
                    left.right = Option::Some(n);
                    return Option::Some(left);
                }
            }
            return Option::Some(n);
        }
        return null;
    }

    // Split: left rotation to fix consecutive right horizontal links
    fn split(&mut self, node: Option<&mut TreeMapNode<K>>) -> Option<&mut TreeMapNode<K>> {
        if let Some(n) = node {
            if let Some(right) = n.right {
                if let Some(rr) = right.right {
                    if rr.level == n.level {
                        n.right = right.left;
                        right.left = Option::Some(n);
                        right.level = right.level + 1;
                        return Option::Some(right);
                    }
                }
            }
            return Option::Some(n);
        }
        return null;
    }

    // Find node in tree and return its index, or -1 if not found
    fn find_index(&self, key: K) -> i32 {
        let mut current = self.root;
        while let Some(n) = current {
            if key == n.key {
                // Check if the entry is deleted
                let entry = &self.entries[n.index];
                if entry.deleted {
                    return -1;
                }
                return n.index;
            }
            if key < n.key {
                current = n.left;
            } else {
                current = n.right;
            }
        }
        return -1;
    }

    // Find node in tree and return mutable reference to it
    fn find_node_mut(&mut self, key: K) -> Option<&mut TreeMapNode<K>> {
        let mut current = self.root;
        while let Some(n) = current {
            if key == n.key {
                return Option::Some(n);
            }
            if key < n.key {
                current = n.left;
            } else {
                current = n.right;
            }
        }
        return null;
    }

    fn insert_node(
        &mut self,
        node: Option<&mut TreeMapNode<K>>,
        key: K,
        index: i32,
    ) -> Option<&mut TreeMapNode<K>> {
        if let Some(n) = node {
            if key == n.key {
                // Key already exists, just update the index
                n.index = index;
                return Option::Some(n);
            }

            if key < n.key {
                n.left = self.insert_node(n.left, key, index);
            } else {
                n.right = self.insert_node(n.right, key, index);
            }

            let after_skew = self.skew(Option::Some(n));
            return self.split(after_skew);
        }

        let mut new_node: TreeMapNode<K> = TreeMapNode {
            key,
            index,
            level: 1,
            left: null,
            right: null,
        };
        return Option::Some(&mut new_node);
    }

    /// Inserts a key-value pair into the map.
    /// If the key already exists, the value is updated (preserving insertion order).
    /// If the key was previously removed, it is re-inserted at the end.
    fn insert(&mut self, key: K, value: V) {
        // Check if key already exists (non-deleted)
        let existing_index = self.find_index(key);
        if existing_index >= 0 {
            // Update existing entry (preserves insertion order)
            self.entries[existing_index].value = value;
            return;
        }

        // New key or reinsertion: always append to end for insertion-order semantics
        let new_index = self.entries.len();
        let entry = TreeMapEntry {
            key,
            value,
            deleted: false,
        };
        self.entries.append(entry);
        // insert_node will update the index if the key already exists in tree
        self.root = self.insert_node(self.root, key, new_index);
        self.size = self.size + 1;
    }

    /// Returns true if the map contains a value for the specified key
    pub fn contains_key(&self, key: K) -> bool {
        return self.find_index(key) >= 0;
    }

    /// Returns the value corresponding to the key, or null if not found
    fn get(&self, key: K) -> Option<V> {
        let index = self.find_index(key);
        if index >= 0 {
            return Option::Some(self.entries[index].value);
        }
        return null;
    }

    /// Removes a key from the map. Returns true if the key was present.
    /// This is a "shift remove" that preserves insertion order of remaining elements.
    pub fn remove(&mut self, key: K) -> bool {
        let index = self.find_index(key);
        if index < 0 {
            return false;
        }

        // Mark entry as deleted
        self.entries[index].deleted = true;
        self.deleted_count = self.deleted_count + 1;
        self.size = self.size - 1;

        // Compact if too many deleted entries
        if self.deleted_count > self.size && self.deleted_count > 4 {
            self.compact();
        }

        return true;
    }

    // Rebuild the tree and entries array, removing deleted entries
    fn compact(&mut self) {
        if self.deleted_count == 0 { return; }

        // Collect non-deleted entries in insertion order
        let mut new_entries: Array<TreeMapEntry<K, V>> = [];
        for let entry of self.entries {
            if !entry.deleted {
                new_entries.append(TreeMapEntry {
                    key: entry.key,
                    value: entry.value,
                    deleted: false,
                });
            }
        }

        // Rebuild tree with new indices
        self.root = null;
        self.entries = new_entries;
        self.deleted_count = 0;

        let mut i = 0;
        while i < self.entries.len() {
            let entry = &self.entries[i];
            self.root = self.insert_node(self.root, entry.key, i);
            i = i + 1;
        }
    }

    /// Returns all keys in insertion order
    pub fn keys(&self) -> Array<K> {
        let mut result: Array<K> = [];
        for let entry of self.entries {
            if !entry.deleted {
                result.append(entry.key);
            }
        }
        return result;
    }

    /// Returns all values in insertion order
    pub fn values(&self) -> Array<V> {
        let mut result: Array<V> = [];
        for let entry of self.entries {
            if !entry.deleted {
                result.append(entry.value);
            }
        }
        return result;
    }

    /// Returns all key-value pairs in insertion order
    pub fn entries(&self) -> Array<[K, V]> {
        let mut result: Array<[K, V]> = [];
        for let entry of self.entries {
            if !entry.deleted {
                result.append([entry.key, entry.value]);
            }
        }
        return result;
    }

    /// Removes all key-value pairs from the map
    pub fn clear(&mut self) {
        self.root = null;
        self.entries = [];
        self.size = 0;
        self.deleted_count = 0;
    }
}

// IndexAssign for map[key] = value
impl IndexAssign<K> for TreeMap<K, V> {
    type Input = V;
    fn index_assign(&mut self, key: K, value: Self::Input) {
        self.insert(key, value);
    }
}

// IndexValue for map[key] -> Option<V>
impl IndexValue<K> for TreeMap<K, V> {
    type Output = Option<V>;
    fn index_value(&self, key: K) -> Self::Output {
        return self.get(key);
    }
}

// KeyValueLiteral for { key: value, ... } -> TreeMap<String, V>
impl KeyValueLiteral for TreeMap<String, V> {
    type Value = V;
    fn new_literal() -> TreeMap<String, V> {
        return TreeMap::<String, V>::new();
    }
    fn insert_literal(&mut self, key: String, value: Self::Value) {
        self.insert(key, value);
    }
}
