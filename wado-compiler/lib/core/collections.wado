#![stdlib("core:collections")]
//! Collection types: `TreeMap<K, V>` and `TreeSet<T>`, both iterating in
//! insertion order. `map[key] = value` overwrites; `try_insert` /
//! `get_or_insert` insert only when the key is absent.


use {
    Serialize,
    Deserialize,
    Serializer,
    Deserializer,
    SerializeError,
    DeserializeError,
    DeserializeErrorKind,
    SerializeErrorKind,
    report_duplicate_key,
} from "core:serde";

#[synopsis]
test {
    let mut sizes = { small: 1, medium: 2, large: 3 } as TreeMap<String, i32>;
    assert sizes.len() == 3;
    assert sizes["medium"] == 2;
    assert sizes.get("small") matches { Some(v) && v == 1 };
    sizes["xlarge"] = 4;
    assert sizes.len() == 4;

    let primes = [7, 2, 5, 2, 3] as TreeSet<i32>;
    assert primes.len() == 4;
    assert primes.contains(5);
    assert !primes.contains(4);
}

// TreeMap uses a two-part data structure inspired by Rust's indexmap crate:
// 1. A self-balancing binary search tree (AA tree) for O(log n) key lookups
// 2. A dense array (entries) for O(1) insertion-order iteration
//
// Both the tree nodes and the entries array are owned by the `TreeMap`
// directly — tree pointers (`root`, `left`, `right`) are `Option<i32>`
// indices into `nodes`, not `&mut` references. This keeps the entire
// data structure value-semantic: a single Wado `let b = a;` produces a
// fully independent copy via the synthesized `$value_copy$TreeMap` —
// every shared `&mut` would be aliased on copy, which would break the
// `b[key] = ...` ⇏ `a.contains_key(key)` invariant. Index-based pointers
// also have no rotation-time aliasing concerns: every `self.nodes[i]`
// access goes through the same array and Wado has no borrow checker
// to refuse two concurrent mutable handles to it.

// An entry in the map (key-value pair with deletion flag)
struct TreeMapEntry<K, V> {
    key: K,
    value: V,
    deleted: bool,
}

// A node in the tree. `left` / `right` are `Option<i32>` indices into
// the parent `TreeMap`'s `nodes` array; `index` is into `entries`.
struct TreeMapNode<K> {
    key: K,
    index: i32,
    level: i32,
    left: Option<i32>,
    right: Option<i32>,
}

/// A map that iterates in insertion order.
///
/// Keys are stored in a tree for O(log n) lookups, while key-value pairs
/// are stored in a dense array for fast, insertion-order iteration.
///
/// This is similar to Rust's `indexmap::IndexMap` but uses a tree instead
/// of a hash table for key lookups.
pub struct TreeMap<K, V> {
    root: Option<i32>,
    nodes: List<TreeMapNode<K>>,
    entries: List<TreeMapEntry<K, V>>,
    size: i32,
    deleted_count: i32,
}

impl<K: Ord> TreeMap<K, V> {
    /// Creates a new empty TreeMap.
    pub fn new() -> TreeMap<K, V> {
        return TreeMap {
            root: null,
            nodes: [],
            entries: [],
            size: 0,
            deleted_count: 0,
        };
    }

    /// Returns the number of key-value pairs in the map.
    pub fn len(&self) -> i32 {
        return self.size;
    }

    /// Returns true if the map contains no elements.
    pub fn is_empty(&self) -> bool {
        return self.size == 0;
    }

    // Skew: right rotation to fix left horizontal link.
    // Reads through `self.nodes[...]` so rotations stay inside the
    // single owning array — see the module-level comment for why.
    fn skew(&mut self, node: Option<i32>) -> Option<i32> {
        if let Some(n_idx) = node {
            if let Some(left_idx) = self.nodes[n_idx].left {
                if self.nodes[left_idx].level == self.nodes[n_idx].level {
                    self.nodes[n_idx].left = self.nodes[left_idx].right;
                    self.nodes[left_idx].right = Option::Some(n_idx);
                    return Option::Some(left_idx);
                }
            }
            return Option::Some(n_idx);
        }
        return null;
    }

    // Split: left rotation to fix consecutive right horizontal links.
    fn split(&mut self, node: Option<i32>) -> Option<i32> {
        if let Some(n_idx) = node {
            if let Some(right_idx) = self.nodes[n_idx].right {
                if let Some(rr_idx) = self.nodes[right_idx].right {
                    if self.nodes[rr_idx].level == self.nodes[n_idx].level {
                        self.nodes[n_idx].right = self.nodes[right_idx].left;
                        self.nodes[right_idx].left = Option::Some(n_idx);
                        self.nodes[right_idx].level = self.nodes[right_idx].level + 1;
                        return Option::Some(right_idx);
                    }
                }
            }
            return Option::Some(n_idx);
        }
        return null;
    }

    // Find node in tree and return its `entries` index, or -1 if the
    // key is missing or its entry is tomb-stoned.
    fn find_index(&self, key: K) -> i32 {
        let mut current = self.root;
        while let Some(n_idx) = current {
            let n = &self.nodes[n_idx];
            // `==` then `<` compares the keys twice at every node walked past.
            match key.cmp(&n.key) {
                Ordering::Equal => {
                    let entry = &self.entries[n.index];
                    if entry.deleted {
                        return -1;
                    }
                    return n.index;
                },
                Ordering::Less => current = n.left,
                Ordering::Greater => current = n.right,
            }
        }
        return -1;
    }

    // Recursive AA-tree insert. Returns the (possibly rotated) subtree
    // root index. Allocates a fresh entry in `self.nodes` when the key
    // is not yet present in the subtree.
    fn insert_node(&mut self, node: Option<i32>, key: K, index: i32) -> Option<i32> {
        if let Some(n_idx) = node {
            match key.cmp(&self.nodes[n_idx].key) {
                Ordering::Equal => {
                    self.nodes[n_idx].index = index;
                    return Option::Some(n_idx);
                },
                Ordering::Less => {
                    let left = self.nodes[n_idx].left;
                    let new_left = self.insert_node(left, key, index);
                    self.nodes[n_idx].left = new_left;
                },
                Ordering::Greater => {
                    let right = self.nodes[n_idx].right;
                    let new_right = self.insert_node(right, key, index);
                    self.nodes[n_idx].right = new_right;
                },
            }

            let after_skew = self.skew(Option::Some(n_idx));
            return self.split(after_skew);
        }

        let new_idx = self.nodes.len();
        self.nodes.push(TreeMapNode {
            key,
            index,
            level: 1,
            left: null,
            right: null,
        });
        return Option::Some(new_idx);
    }

    /// Appends `key` as a new entry; the caller has established it is absent.
    /// A previously removed key re-enters at the end.
    fn append_entry(&mut self, key: K, value: V) with stores[key, value] {
        let new_index = self.entries.len();
        self.entries.push(TreeMapEntry {
            key,
            value,
            deleted: false,
        });
        self.root = self.insert_node(self.root, key, new_index);
        self.size = self.size + 1;
    }

    /// The implementation behind `map[key] = value`; the public API is index
    /// assignment, `try_insert`, and `get_or_insert`. Updates in place when the
    /// key exists (keeping its order), else appends.
    fn insert(&mut self, key: K, value: V) with stores[key, value] {
        let existing_index = self.find_index(key);
        if existing_index >= 0 {
            self.entries[existing_index].value = value;
            return;
        }
        self.append_entry(key, value);
    }

    /// Inserts only if `key` is absent, and reports whether it was inserted.
    /// The losing insert keeps the existing value, unlike `map[key] = value`.
    pub fn try_insert(&mut self, key: K, value: V) -> bool with stores[key, value] {
        if self.find_index(key) >= 0 {
            return false;
        }
        self.append_entry(key, value);
        return true;
    }

    /// The value already stored under `key`, or `value` inserted and returned.
    /// The shape of TC39's `Map.prototype.getOrInsert`; for whether it
    /// inserted, use `try_insert`.
    pub fn get_or_insert(&mut self, key: K, value: V) -> V with stores[key, value] {
        let existing_index = self.find_index(key);
        if existing_index >= 0 {
            return self.entries[existing_index].value;
        }
        self.append_entry(key, value);
        return value;
    }

    /// Returns true if the map contains a value for the specified key.
    pub fn contains_key(&self, key: K) -> bool {
        return self.find_index(key) >= 0;
    }

    /// Returns the value corresponding to the key, or null if not found.
    pub fn get(&self, key: K) -> Option<V> {
        let index = self.find_index(key);
        if index >= 0 {
            return Option::Some(self.entries[index].value);
        }
        return null;
    }

    /// Removes a key from the map and returns true if the key was present.
    /// Preserves insertion order of remaining elements.
    pub fn remove(&mut self, key: K) -> bool {
        let index = self.find_index(key);
        if index < 0 {
            return false;
        }

        // Mark entry as deleted
        self.entries[index].deleted = true;
        self.deleted_count = self.deleted_count + 1;
        self.size = self.size - 1;

        // Compact if too many deleted entries
        if self.deleted_count > self.size && self.deleted_count > 4 {
            self.compact();
        }

        return true;
    }

    // Rebuild the tree and entries array, removing deleted entries
    fn compact(&mut self) {
        if self.deleted_count == 0 {
            return;
        }

        // Collect non-deleted entries in insertion order
        let mut new_entries: List<TreeMapEntry<K, V>> = [];
        for let entry of self.entries {
            if !entry.deleted {
                new_entries.push(TreeMapEntry {
                    key: entry.key,
                    value: entry.value,
                    deleted: false,
                });
            }
        }

        // Rebuild tree with new indices. Both `nodes` and `entries`
        // get fresh empty arrays; `insert_node` repopulates `nodes`
        // as it inserts each key.
        self.root = null;
        self.nodes = [];
        self.entries = new_entries;
        self.deleted_count = 0;

        for let mut i = 0; i < self.entries.len(); i += 1 {
            let entry = &self.entries[i];
            self.root = self.insert_node(self.root, entry.key, i);
        }
    }

    /// The keys, in insertion order. A map traversal yields references and
    /// carries no axis suffix: `keys` already says what it yields, and a
    /// caller wanting owned keys takes `iter_value()` off the result.
    pub fn keys(&self) -> TreeMapKeysRefIter<K, V> with stores[self] {
        return TreeMapKeysRefIter { entries: &self.entries, index: 0 };
    }

    /// The values, in insertion order.
    pub fn values(&self) -> TreeMapValuesRefIter<K, V> with stores[self] {
        return TreeMapValuesRefIter { entries: &self.entries, index: 0 };
    }

    /// The key-value pairs, in insertion order.
    pub fn entries(&self) -> TreeMapEntriesRefIter<K, V> with stores[self] {
        return TreeMapEntriesRefIter { entries: &self.entries, index: 0 };
    }

    /// Removes all key-value pairs from the map.
    pub fn clear(&mut self) {
        self.root = null;
        self.nodes = [];
        self.entries = [];
        self.size = 0;
        self.deleted_count = 0;
    }
}

// IndexAssign for map[key] = value
impl<K: Ord> IndexAssign<K> for TreeMap<K, V> {
    type Output = V;

    fn index_assign(&mut self, key: K, value: Self::Output) {
        self.insert(key, value);
    }
}

// IndexValue for map[key] -> V (panics if key not found)
impl<K: Ord> IndexValue<K> for TreeMap<K, V> {
    type Output = V;

    fn index_value(&self, key: K) -> Self::Output {
        let index = self.find_index(key);
        if index < 0 {
            panic(`key not found: ${key:?}`);
        }
        return self.entries[index].value;
    }
}

// IndexRef for &map[key] -> &V (panics if key not found)
impl<K: Ord, V: Ref> IndexRef<K> for TreeMap<K, V> {
    type Output = V;

    fn index_ref(&self, key: K) -> &V {
        let index = self.find_index(key);
        if index < 0 {
            panic(`key not found: ${key:?}`);
        }
        return &self.entries[index].value;
    }
}

// IndexRefMut for map[key].mutating_method() -> &mut V (panics if key not found)
impl<K: Ord, V: RefMut> IndexRefMut<K> for TreeMap<K, V> {
    type Output = V;

    fn index_ref_mut(&mut self, key: K) -> &mut V {
        let index = self.find_index(key);
        if index < 0 {
            panic(`key not found: ${key:?}`);
        }
        return &mut self.entries[index].value;
    }
}

// KeyValueLiteralBuilder for { key: value, ... } -> TreeMap<String, V>
// The blanket impl in core:prelude automatically provides KeyValueLiteral for TreeMap.
impl KeyValueLiteralBuilder for TreeMap<String, V> {
    type Value = V;
    type Output = TreeMap<String, V>;

    fn new_literal(capacity: i32) -> TreeMap<String, V> {
        return TreeMap::new();
    }

    fn insert_literal(&mut self, key: String, value: Self::Value) with stores[value] {
        self.insert(key, value);
    }

    fn insert_all(&mut self, base: TreeMap<String, V>) {
        for let [k, v] of base.entries() {
            self.insert(*k, *v);
        }
    }

    fn build(&self) -> TreeMap<String, V> {
        return *self;
    }
}

// Every traversal below yields in insertion order, views the backing entry list
// rather than copying it, and skips the tombstones a removal leaves behind.
// Holding the `List` by value would deep-copy every entry at construction.
//
// Viewing means a traversal sees later writes: inserting or removing while one
// is live can skip or repeat an entry, since `compact` reindexes. Collect first
// (`iter_value().collect()`) to traverse a snapshot.

struct TreeSetRefIter<T> {
    entries: &List<TreeMapEntry<T, ()>>,
    index: i32,
}

impl<T> Iterator for TreeSetRefIter<T> {
    type Item = &T;

    fn next(&mut self) -> Option<&T> with stores[self] {
        while self.index < self.entries.len() {
            let i = self.index;
            self.index += 1;
            if !self.entries[i].deleted {
                return Option::Some(&self.entries[i].key);
            }
        }
        return null;
    }
}

impl TreeSetRefIter<T> {
    pub fn iter_value(&self) -> TreeSetValueIter<T> with stores[self] {
        return TreeSetValueIter { entries: self.entries, index: self.index };
    }
}

struct TreeSetValueIter<T> {
    entries: &List<TreeMapEntry<T, ()>>,
    index: i32,
}

impl<T> Iterator for TreeSetValueIter<T> {
    type Item = T;

    fn next(&mut self) -> Option<T> {
        while self.index < self.entries.len() {
            let i = self.index;
            self.index += 1;
            if !self.entries[i].deleted {
                return Option::Some(self.entries[i].key);
            }
        }
        return null;
    }
}

struct TreeMapKeysRefIter<K, V> {
    entries: &List<TreeMapEntry<K, V>>,
    index: i32,
}

impl<K, V> Iterator for TreeMapKeysRefIter<K, V> {
    type Item = &K;

    fn next(&mut self) -> Option<&K> with stores[self] {
        while self.index < self.entries.len() {
            let i = self.index;
            self.index += 1;
            if !self.entries[i].deleted {
                return Option::Some(&self.entries[i].key);
            }
        }
        return null;
    }
}

impl TreeMapKeysRefIter<K, V> {
    pub fn iter_value(&self) -> TreeMapKeysValueIter<K, V> with stores[self] {
        return TreeMapKeysValueIter { entries: self.entries, index: self.index };
    }
}

struct TreeMapKeysValueIter<K, V> {
    entries: &List<TreeMapEntry<K, V>>,
    index: i32,
}

impl<K, V> Iterator for TreeMapKeysValueIter<K, V> {
    type Item = K;

    fn next(&mut self) -> Option<K> {
        while self.index < self.entries.len() {
            let i = self.index;
            self.index += 1;
            if !self.entries[i].deleted {
                return Option::Some(self.entries[i].key);
            }
        }
        return null;
    }
}

struct TreeMapValuesRefIter<K, V> {
    entries: &List<TreeMapEntry<K, V>>,
    index: i32,
}

impl<K, V> Iterator for TreeMapValuesRefIter<K, V> {
    type Item = &V;

    fn next(&mut self) -> Option<&V> with stores[self] {
        while self.index < self.entries.len() {
            let i = self.index;
            self.index += 1;
            if !self.entries[i].deleted {
                return Option::Some(&self.entries[i].value);
            }
        }
        return null;
    }
}

impl TreeMapValuesRefIter<K, V> {
    pub fn iter_value(&self) -> TreeMapValuesValueIter<K, V> with stores[self] {
        return TreeMapValuesValueIter { entries: self.entries, index: self.index };
    }
}

/// The doubled word is the axis meeting a projection already named `values`:
/// the map's *values*, yielded by *value*.
struct TreeMapValuesValueIter<K, V> {
    entries: &List<TreeMapEntry<K, V>>,
    index: i32,
}

impl<K, V> Iterator for TreeMapValuesValueIter<K, V> {
    type Item = V;

    fn next(&mut self) -> Option<V> {
        while self.index < self.entries.len() {
            let i = self.index;
            self.index += 1;
            if !self.entries[i].deleted {
                return Option::Some(self.entries[i].value);
            }
        }
        return null;
    }
}

struct TreeMapEntriesRefIter<K, V> {
    entries: &List<TreeMapEntry<K, V>>,
    index: i32,
}

impl<K, V> Iterator for TreeMapEntriesRefIter<K, V> {
    type Item = [&K, &V];

    fn next(&mut self) -> Option<[&K, &V]> with stores[self] {
        while self.index < self.entries.len() {
            let i = self.index;
            self.index += 1;
            if !self.entries[i].deleted {
                return Option::Some([&self.entries[i].key, &self.entries[i].value]);
            }
        }
        return null;
    }
}

impl TreeMapEntriesRefIter<K, V> {
    pub fn iter_value(&self) -> TreeMapEntriesValueIter<K, V> with stores[self] {
        return TreeMapEntriesValueIter { entries: self.entries, index: self.index };
    }
}

struct TreeMapEntriesValueIter<K, V> {
    entries: &List<TreeMapEntry<K, V>>,
    index: i32,
}

impl<K, V> Iterator for TreeMapEntriesValueIter<K, V> {
    type Item = [K, V];

    fn next(&mut self) -> Option<[K, V]> {
        while self.index < self.entries.len() {
            let i = self.index;
            self.index += 1;
            if !self.entries[i].deleted {
                return Option::Some([self.entries[i].key, self.entries[i].value]);
            }
        }
        return null;
    }
}

/// A set that iterates in insertion order.
///
/// Backed by a `TreeMap<T, ()>` which uses a balanced binary search tree for
/// O(log n) membership tests and a dense array for O(1) insertion-order iteration.
///
/// Duplicate inserts are silently ignored (preserving the original position).
/// Removing an element and re-inserting it appends it at the end.
///
/// `T` must implement `Ord` to use any of the methods.
pub struct TreeSet<T> {
    inner: TreeMap<T, ()>,
}

impl<T: Ord> TreeSet<T> {
    /// Creates a new empty TreeSet.
    pub fn new() -> TreeSet<T> {
        return TreeSet { inner: TreeMap::new() };
    }

    /// Returns the number of elements in the set.
    pub fn len(&self) -> i32 {
        return self.inner.len();
    }

    /// Returns true if the set contains no elements.
    pub fn is_empty(&self) -> bool {
        return self.inner.is_empty();
    }

    /// Inserts a value into the set.
    ///
    /// Returns true if the value was newly inserted, false if it was already present.
    pub fn insert(&mut self, value: T) -> bool with stores[value] {
        return self.inner.try_insert(value, ());
    }

    /// Returns true if the set contains the given value.
    pub fn contains(&self, value: T) -> bool {
        return self.inner.contains_key(value);
    }

    /// Removes a value from the set.
    ///
    /// Returns true if the value was present, false otherwise.
    pub fn remove(&mut self, value: T) -> bool {
        return self.inner.remove(value);
    }

    /// Removes all elements from the set.
    pub fn clear(&mut self) {
        self.inner.clear();
    }

    /// The elements, in insertion order.
    pub fn iter_ref(&self) -> TreeSetRefIter<T> with stores[self] {
        return TreeSetRefIter { entries: &self.inner.entries, index: 0 };
    }

    /// The elements, in insertion order.
    pub fn iter_value(&self) -> TreeSetValueIter<T> with stores[self] {
        return TreeSetValueIter { entries: &self.inner.entries, index: 0 };
    }
}

impl<T: Ord> IntoIterator for TreeSet<T> {
    type Item = T;
    type Iter = TreeSetValueIter<T>;

    fn into_iter(&self) -> TreeSetValueIter<T> with stores[self] {
        return TreeSetValueIter { entries: &self.inner.entries, index: 0 };
    }
}

// SequenceLiteralBuilder for [e0, e1, ...] as TreeSet<T>
// The blanket impl in core:prelude automatically provides SequenceLiteral for TreeSet<T>.
impl<T: Ord> SequenceLiteralBuilder for TreeSet<T> {
    type Element = T;
    type Output = TreeSet<T>;

    fn new_literal(capacity: i32) -> TreeSet<T> {
        return TreeSet::new();
    }

    fn push_literal(&mut self, value: T) {
        self.inner.insert(value, ());
    }

    fn build(&self) -> TreeSet<T> {
        return *self;
    }
}

impl<V: Serialize> Serialize for TreeMap<String, V> {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let mut m = s.begin_map(self.len())?;
        for let entry of &self.entries {
            if !entry.deleted {
                m.key(&entry.key)?;
                m.value(&entry.value)?;
            }
        }
        return m.end();
    }
}

impl<V: Deserialize> Deserialize for TreeMap<String, V> {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<TreeMap<String, V>, DeserializeError> {
        let on_duplicate = d.on_duplicate_key();
        let mut map = d.begin_map()?;
        let mut result: TreeMap<String, V> = {};
        loop {
            let key_opt = map.next_key_string()?;
            if let Some(key) = key_opt {
                let val = map.next_value::<V>()?;
                // The losing insert keeps the first value, so a lenient
                // policy re-assigns to take the last.
                if !result.try_insert(key, val) {
                    report_duplicate_key(on_duplicate, &key)?;
                    result[key] = val;
                }
            } else {
                map.end()?;
                return Result::Ok(result);
            }
        }
        unreachable();
    }
}

impl<K: Ord + Inspect, V: Inspect> Inspect for TreeMap<K, V> {
    pub fn inspect(&self, f: &mut Formatter) {
        f.write_char('{');
        let mut first = true;
        for let entry of self.entries {
            if !entry.deleted {
                if !first {
                    f.write_str(&", ");
                }
                first = false;
                entry.key.inspect(f);
                f.write_str(&": ");
                entry.value.inspect(f);
            }
        }
        f.write_char('}');
    }
}

impl<K: Ord + InspectAlt, V: InspectAlt> InspectAlt for TreeMap<K, V> {
    pub fn inspect_alt(&self, f: &mut Formatter) {
        if self.is_empty() {
            f.write_str(&"{}");
            return;
        }
        f.open_brace("{");
        for let entry of self.entries {
            if !entry.deleted {
                f.write_newline_indent();
                entry.key.inspect_alt(f);
                f.write_str(&": ");
                entry.value.inspect_alt(f);
                f.write_char(',');
            }
        }
        f.close_brace("}");
    }
}

impl<T: Inspect + Ord> Inspect for TreeSet<T> {
    pub fn inspect(&self, f: &mut Formatter) {
        f.write_char('{');
        let mut first = true;
        for let entry of self.inner.entries {
            if !entry.deleted {
                if !first {
                    f.write_str(&", ");
                }
                first = false;
                entry.key.inspect(f);
            }
        }
        f.write_char('}');
    }
}

impl<T: InspectAlt + Ord> InspectAlt for TreeSet<T> {
    pub fn inspect_alt(&self, f: &mut Formatter) {
        if self.inner.is_empty() {
            f.write_str(&"{}");
            return;
        }
        f.open_brace("{");
        for let entry of self.inner.entries {
            if !entry.deleted {
                f.write_newline_indent();
                entry.key.inspect_alt(f);
                f.write_char(',');
            }
        }
        f.close_brace("}");
    }
}

impl<K: Ord, V> Default for TreeMap<K, V> {
    pub fn default() -> TreeMap<K, V> {
        return TreeMap::new();
    }
}

impl<T: Ord> Default for TreeSet<T> {
    pub fn default() -> TreeSet<T> {
        return TreeSet::new();
    }
}
