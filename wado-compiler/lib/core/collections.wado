#![stdlib("core:collections")]
//! Collection types: `TreeMap<K, V>` and `TreeSet<T>` (insertion-order preserved).


use {
    Serialize,
    Deserialize,
    Serializer,
    Deserializer,
    SerializeError,
    DeserializeError,
    DeserializeErrorKind,
    SerializeErrorKind,
} from "core:serde";

// Collections module for Wado.
//
// This module provides collection types beyond the built-in List.//
// TreeMap uses a two-part data structure inspired by Rust's indexmap crate:
// 1. A self-balancing binary search tree (AA tree) for O(log n) key lookups
// 2. A dense array (entries) for O(1) insertion-order iteration
//
// Both the tree nodes and the entries array are owned by the `TreeMap`
// directly — tree pointers (`root`, `left`, `right`) are `Option<i32>`
// indices into `nodes`, not `&mut` references. This keeps the entire
// data structure value-semantic: a single Wado `let b = a;` produces a
// fully independent copy via the synthesized `$value_copy$TreeMap` —
// every shared `&mut` would be aliased on copy, which would break the
// `b.insert(...)` ⇏ `a.contains(...)` invariant. Index-based pointers
// also have no rotation-time aliasing concerns: every `self.nodes[i]`
// access goes through the same array and Wado has no borrow checker
// to refuse two concurrent mutable handles to it.

// An entry in the map (key-value pair with deletion flag)
struct TreeMapEntry<K, V> {
    key: K,
    value: V,
    deleted: bool,
}

// A node in the tree. `left` / `right` are `Option<i32>` indices into
// the parent `TreeMap`'s `nodes` array; `index` is into `entries`.
struct TreeMapNode<K> {
    key: K,
    index: i32,
    level: i32,
    left: Option<i32>,
    right: Option<i32>,
}

/// A map that iterates in insertion order.
///
/// Keys are stored in a tree for O(log n) lookups, while key-value pairs
/// are stored in a dense array for fast, insertion-order iteration.
///
/// This is similar to Rust's `indexmap::IndexMap` but uses a tree instead
/// of a hash table for key lookups.
pub struct TreeMap<K, V> {
    root: Option<i32>,
    nodes: List<TreeMapNode<K>>,
    entries: List<TreeMapEntry<K, V>>,
    size: i32,
    deleted_count: i32,
}

impl<K: Ord> TreeMap<K, V> {
    /// Creates a new empty TreeMap.
    pub fn new() -> TreeMap<K, V> {
        return TreeMap {
            root: null,
            nodes: [],
            entries: [],
            size: 0,
            deleted_count: 0,
        };
    }

    /// Returns the number of key-value pairs in the map.
    pub fn len(&self) -> i32 {
        return self.size;
    }

    /// Returns true if the map contains no elements.
    pub fn is_empty(&self) -> bool {
        return self.size == 0;
    }

    // Skew: right rotation to fix left horizontal link.
    // Reads through `self.nodes[...]` so rotations stay inside the
    // single owning array — see the module-level comment for why.
    fn skew(&mut self, node: Option<i32>) -> Option<i32> {
        if let Some(n_idx) = node {
            if let Some(left_idx) = self.nodes[n_idx].left {
                if self.nodes[left_idx].level == self.nodes[n_idx].level {
                    self.nodes[n_idx].left = self.nodes[left_idx].right;
                    self.nodes[left_idx].right = Option::Some(n_idx);
                    return Option::Some(left_idx);
                }
            }
            return Option::Some(n_idx);
        }
        return null;
    }

    // Split: left rotation to fix consecutive right horizontal links.
    fn split(&mut self, node: Option<i32>) -> Option<i32> {
        if let Some(n_idx) = node {
            if let Some(right_idx) = self.nodes[n_idx].right {
                if let Some(rr_idx) = self.nodes[right_idx].right {
                    if self.nodes[rr_idx].level == self.nodes[n_idx].level {
                        self.nodes[n_idx].right = self.nodes[right_idx].left;
                        self.nodes[right_idx].left = Option::Some(n_idx);
                        self.nodes[right_idx].level = self.nodes[right_idx].level + 1;
                        return Option::Some(right_idx);
                    }
                }
            }
            return Option::Some(n_idx);
        }
        return null;
    }

    // Find node in tree and return its `entries` index, or -1 if the
    // key is missing or its entry is tomb-stoned.
    fn find_index(&self, key: K) -> i32 {
        let mut current = self.root;
        while let Some(n_idx) = current {
            let n = &self.nodes[n_idx];
            if key == n.key {
                let entry = &self.entries[n.index];
                if entry.deleted {
                    return -1;
                }
                return n.index;
            }
            if key < n.key {
                current = n.left;
            } else {
                current = n.right;
            }
        }
        return -1;
    }

    // Recursive AA-tree insert. Returns the (possibly rotated) subtree
    // root index. Allocates a fresh entry in `self.nodes` when the key
    // is not yet present in the subtree.
    fn insert_node(&mut self, node: Option<i32>, key: K, index: i32) -> Option<i32> {
        if let Some(n_idx) = node {
            if key == self.nodes[n_idx].key {
                // Key already exists, just update the entries index.
                self.nodes[n_idx].index = index;
                return Option::Some(n_idx);
            }

            if key < self.nodes[n_idx].key {
                let left = self.nodes[n_idx].left;
                let new_left = self.insert_node(left, key, index);
                self.nodes[n_idx].left = new_left;
            } else {
                let right = self.nodes[n_idx].right;
                let new_right = self.insert_node(right, key, index);
                self.nodes[n_idx].right = new_right;
            }

            let after_skew = self.skew(Option::Some(n_idx));
            return self.split(after_skew);
        }

        let new_idx = self.nodes.len();
        self.nodes.push(TreeMapNode {
            key,
            index,
            level: 1,
            left: null,
            right: null,
        });
        return Option::Some(new_idx);
    }

    /// Inserts a key-value pair into the map.
    /// If the key already exists, updates the value (preserving insertion order).
    /// If the key was previously removed, re-inserts it at the end.
    fn insert(&mut self, key: K, value: V) with stores[key, value] {
        // Check if key already exists (non-deleted)
        let existing_index = self.find_index(key);
        if existing_index >= 0 {
            // Update existing entry (preserves insertion order)
            self.entries[existing_index].value = value;
            return;
        }

        // New key or reinsertion: always append to end for insertion-order semantics
        let new_index = self.entries.len();
        let entry = TreeMapEntry {
            key,
            value,
            deleted: false,
        };
        self.entries.push(entry);
        // insert_node will update the index if the key already exists in tree
        self.root = self.insert_node(self.root, key, new_index);
        self.size = self.size + 1;
    }

    /// Returns true if the map contains a value for the specified key.
    pub fn contains_key(&self, key: K) -> bool {
        return self.find_index(key) >= 0;
    }

    /// Returns the value corresponding to the key, or null if not found.
    pub fn get(&self, key: K) -> Option<V> {
        let index = self.find_index(key);
        if index >= 0 {
            return Option::Some(self.entries[index].value);
        }
        return null;
    }

    /// Removes a key from the map and returns true if the key was present.
    /// Preserves insertion order of remaining elements.
    pub fn remove(&mut self, key: K) -> bool {
        let index = self.find_index(key);
        if index < 0 {
            return false;
        }

        // Mark entry as deleted
        self.entries[index].deleted = true;
        self.deleted_count = self.deleted_count + 1;
        self.size = self.size - 1;

        // Compact if too many deleted entries
        if self.deleted_count > self.size && self.deleted_count > 4 {
            self.compact();
        }

        return true;
    }

    // Rebuild the tree and entries array, removing deleted entries
    fn compact(&mut self) {
        if self.deleted_count == 0 {
            return;
        }

        // Collect non-deleted entries in insertion order
        let mut new_entries: List<TreeMapEntry<K, V>> = [];
        for let entry of self.entries {
            if !entry.deleted {
                new_entries.push(TreeMapEntry {
                    key: entry.key,
                    value: entry.value,
                    deleted: false,
                });
            }
        }

        // Rebuild tree with new indices. Both `nodes` and `entries`
        // get fresh empty arrays; `insert_node` repopulates `nodes`
        // as it inserts each key.
        self.root = null;
        self.nodes = [];
        self.entries = new_entries;
        self.deleted_count = 0;

        for let mut i = 0; i < self.entries.len(); i += 1 {
            let entry = &self.entries[i];
            self.root = self.insert_node(self.root, entry.key, i);
        }
    }

    /// Returns all keys in insertion order.
    pub fn keys(&self) -> List<K> {
        let mut result: List<K> = [];
        for let entry of self.entries {
            if !entry.deleted {
                result.push(entry.key);
            }
        }
        return result;
    }

    /// Returns all values in insertion order.
    pub fn values(&self) -> List<V> {
        let mut result: List<V> = [];
        for let entry of self.entries {
            if !entry.deleted {
                result.push(entry.value);
            }
        }
        return result;
    }

    /// Returns all key-value pairs in insertion order.
    pub fn entries(&self) -> List<[K, V]> {
        let mut result: List<[K, V]> = [];
        for let entry of self.entries {
            if !entry.deleted {
                result.push([entry.key, entry.value]);
            }
        }
        return result;
    }

    /// Removes all key-value pairs from the map.
    pub fn clear(&mut self) {
        self.root = null;
        self.nodes = [];
        self.entries = [];
        self.size = 0;
        self.deleted_count = 0;
    }
}

// IndexAssign for map[key] = value
impl<K: Ord> IndexAssign<K> for TreeMap<K, V> {
    type Input = V;

    fn index_assign(&mut self, key: K, value: Self::Input) {
        self.insert(key, value);
    }
}

// IndexValue for map[key] -> V (panics if key not found)
impl<K: Ord> IndexValue<K> for TreeMap<K, V> {
    type Output = V;

    fn index_value(&self, key: K) -> Self::Output {
        let index = self.find_index(key);
        if index < 0 {
            panic(`key not found: {key:?}`);
        }
        return self.entries[index].value;
    }
}

// KeyValueLiteralBuilder for { key: value, ... } -> TreeMap<String, V>
// The blanket impl in core:prelude automatically provides KeyValueLiteral for TreeMap.
impl KeyValueLiteralBuilder for TreeMap<String, V> {
    type Value = V;
    type Output = TreeMap<String, V>;

    fn new_literal(capacity: i32) -> TreeMap<String, V> {
        return TreeMap::new();
    }

    fn insert_literal(&mut self, key: String, value: Self::Value) with stores[value] {
        self.insert(key, value);
    }

    fn build(&self) -> TreeMap<String, V> {
        return *self;
    }
}

/// An iterator over the elements of a `TreeSet<T>`, in insertion order.
struct TreeSetIter<T> {
    entries: List<TreeMapEntry<T, ()>>,
    index: i32,
}

impl<T> Iterator for TreeSetIter<T> {
    type Item = T;

    fn next(&mut self) -> Option<Self::Item> {
        while self.index < self.entries.len() {
            let entry = &self.entries[self.index];
            self.index = self.index + 1;
            if !entry.deleted {
                return Option::Some(entry.key);
            }
        }
        return null;
    }
}

/// A set that iterates in insertion order.
///
/// Backed by a `TreeMap<T, ()>` which uses a balanced binary search tree for
/// O(log n) membership tests and a dense array for O(1) insertion-order iteration.
///
/// Duplicate inserts are silently ignored (preserving the original position).
/// Removing an element and re-inserting it appends it at the end.
///
/// `T` must implement `Ord` to use any of the methods.
pub struct TreeSet<T> {
    inner: TreeMap<T, ()>,
}

impl<T: Ord> TreeSet<T> {
    /// Creates a new empty TreeSet.
    pub fn new() -> TreeSet<T> {
        return TreeSet { inner: TreeMap::new() };
    }

    /// Returns the number of elements in the set.
    pub fn len(&self) -> i32 {
        return self.inner.len();
    }

    /// Returns true if the set contains no elements.
    pub fn is_empty(&self) -> bool {
        return self.inner.is_empty();
    }

    /// Inserts a value into the set.
    ///
    /// Returns true if the value was newly inserted, false if it was already present.
    pub fn insert(&mut self, value: T) -> bool with stores[value] {
        let before = self.inner.len();
        self.inner.insert(value, ());
        return self.inner.len() > before;
    }

    /// Returns true if the set contains the given value.
    pub fn contains(&self, value: T) -> bool {
        return self.inner.contains_key(value);
    }

    /// Removes a value from the set.
    ///
    /// Returns true if the value was present, false otherwise.
    pub fn remove(&mut self, value: T) -> bool {
        return self.inner.remove(value);
    }

    /// Removes all elements from the set.
    pub fn clear(&mut self) {
        self.inner.clear();
    }

    /// Returns an iterator over the elements in insertion order.
    pub fn iter(&self) -> TreeSetIter<T> {
        return TreeSetIter {
            entries: self.inner.entries,
            index: 0,
        };
    }
}

impl<T: Ord> IntoIterator for TreeSet<T> {
    type Item = T;
    type Iter = TreeSetIter<T>;

    fn into_iter(&self) -> TreeSetIter<T> {
        return TreeSetIter {
            entries: self.inner.entries,
            index: 0,
        };
    }
}

// SequenceLiteralBuilder for [e0, e1, ...] as TreeSet<T>
// The blanket impl in core:prelude automatically provides SequenceLiteral for TreeSet<T>.
impl<T: Ord> SequenceLiteralBuilder for TreeSet<T> {
    type Element = T;
    type Output = TreeSet<T>;

    fn new_literal(capacity: i32) -> TreeSet<T> {
        return TreeSet::new();
    }

    fn push_literal(&mut self, value: T) {
        self.inner.insert(value, ());
    }

    fn build(&self) -> TreeSet<T> {
        return *self;
    }
}

impl<V: Serialize> Serialize for TreeMap<String, V> {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let entries = self.entries();
        let mut m = s.begin_map(entries.len())?;
        for let [k, v] of entries {
            m.key(&k)?;
            m.value(&v)?;
        }
        return m.end();
    }
}

impl<V: Deserialize> Deserialize for TreeMap<String, V> {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<TreeMap<String, V>, DeserializeError> {
        let map = d.begin_map()?;
        let mut result: TreeMap<String, V> = {};
        loop {
            let key_opt = map.next_key_string()?;
            if let Some(key) = key_opt {
                let val = map.next_value::<V>()?;
                result.insert(key, val);
            } else {
                map.end()?;
                return Result::Ok(result);
            }
        }
        unreachable();
    }
}

impl<K: Inspect, V: Inspect> Inspect for TreeMap<K, V> {
    pub fn inspect(&self, f: &mut Formatter) {
        f.write_char('{');
        let mut first = true;
        for let entry of self.entries {
            if !entry.deleted {
                if !first {
                    f.write_str(&", ");
                }
                first = false;
                entry.key.inspect(f);
                f.write_str(&": ");
                entry.value.inspect(f);
            }
        }
        f.write_char('}');
    }
}

impl<K: InspectAlt, V: InspectAlt> InspectAlt for TreeMap<K, V> {
    pub fn inspect_alt(&self, f: &mut Formatter) {
        if self.is_empty() {
            f.write_str(&"{}");
            return;
        }
        f.open_brace("{");
        for let entry of self.entries {
            if !entry.deleted {
                f.write_newline_indent();
                entry.key.inspect_alt(f);
                f.write_str(&": ");
                entry.value.inspect_alt(f);
                f.write_char(',');
            }
        }
        f.close_brace("}");
    }
}

impl<T: Inspect + Ord> Inspect for TreeSet<T> {
    pub fn inspect(&self, f: &mut Formatter) {
        f.write_char('{');
        let mut first = true;
        for let entry of self.inner.entries {
            if !entry.deleted {
                if !first {
                    f.write_str(&", ");
                }
                first = false;
                entry.key.inspect(f);
            }
        }
        f.write_char('}');
    }
}

impl<T: InspectAlt + Ord> InspectAlt for TreeSet<T> {
    pub fn inspect_alt(&self, f: &mut Formatter) {
        if self.inner.is_empty() {
            f.write_str(&"{}");
            return;
        }
        f.open_brace("{");
        for let entry of self.inner.entries {
            if !entry.deleted {
                f.write_newline_indent();
                entry.key.inspect_alt(f);
                f.write_char(',');
            }
        }
        f.close_brace("}");
    }
}

impl<K: Ord, V> Default for TreeMap<K, V> {
    pub fn default() -> TreeMap<K, V> {
        return TreeMap::new();
    }
}

impl<T: Ord> Default for TreeSet<T> {
    pub fn default() -> TreeSet<T> {
        return TreeSet::new();
    }
}
