use {
    Serialize,
    Deserialize,
    Serializer,
    Deserializer,
    SerializeSeq,
    SerializeStruct,
    SerializeMap,
    SerializeVariant,
    DeserializeSeq,
    DeserializeStruct,
    DeserializeMap,
    DeserializeVariant,
    SerializeError,
    SerializeErrorKind,
    DeserializeError,
    DeserializeErrorKind,
    apply_case,
    DuplicateFieldPolicy,
    report_duplicate_field,
    TextKeySerializer,
    Visitor,
    FieldSchema,
    IgnoredAny,
} from "core:serde";
use { TreeMap } from "core:collections";
use json from "core:json";
use cbor from "core:cbor";
use { Value } from "core:value";
use { Uuid } from "core:uuid";
use { Instant } from "core:temporal";

struct MockWriter {
    buf: String,
}

struct MockSeqSerializer {
    w: &mut MockWriter,
    count: i32,
}

struct MockMapSerializer {
    w: &mut MockWriter,
    count: i32,
}

struct MockStructSerializer {
    w: &mut MockWriter,
    count: i32,
}

struct MockVariantSerializer {
    w: &mut MockWriter,
}

struct MockSerializer {
    w: &mut MockWriter,
}

impl SerializeSeq for MockSeqSerializer {
    fn element<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.w.buf.push_str(",");
        }
        let mut ser = MockSerializer { w: self.w };
        let r = value.serialize::<MockSerializer>(&mut ser);
        self.count += 1;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.w.buf.push_str("]");
        return Result::Ok(());
    }
}

impl SerializeMap for MockMapSerializer {
    fn key<T: Serialize>(&mut self, key: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.w.buf.push_str(",");
        }
        let mut ser = MockSerializer { w: self.w };
        let r = key.serialize::<MockSerializer>(&mut ser);
        self.w.buf.push_str(":");
        return r;
    }

    fn value<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        let mut ser = MockSerializer { w: self.w };
        let r = value.serialize::<MockSerializer>(&mut ser);
        self.count += 1;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.w.buf.push_str("}");
        return Result::Ok(());
    }
}

impl SerializeStruct for MockStructSerializer {
    fn field<T: Serialize, S: AsStrSlice>(&mut self, name: S, value: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.w.buf.push_str(",");
        }
        self.w.buf.push_str(`"${name}":`);
        let mut ser = MockSerializer { w: self.w };
        let r = value.serialize::<MockSerializer>(&mut ser);
        self.count += 1;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.w.buf.push_str("}");
        return Result::Ok(());
    }
}

impl SerializeVariant for MockVariantSerializer {
    fn payload<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        let mut ser = MockSerializer { w: self.w };
        let r = value.serialize::<MockSerializer>(&mut ser);
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.w.buf.push_str("}");
        return Result::Ok(());
    }
}

impl Serializer for MockSerializer {
    type SeqSerializer = MockSeqSerializer;
    type MapSerializer = MockMapSerializer;
    type StructSerializer = MockStructSerializer;
    type VariantSerializer = MockVariantSerializer;

    fn serialize_i32(&mut self, v: i32) -> Result<(), SerializeError> {
        self.w.buf.push_str(`${v}`);
        return Result::Ok(());
    }

    fn serialize_i64(&mut self, v: i64) -> Result<(), SerializeError> {
        self.w.buf.push_str(`${v}`);
        return Result::Ok(());
    }

    fn serialize_u32(&mut self, v: u32) -> Result<(), SerializeError> {
        self.w.buf.push_str(`${v}`);
        return Result::Ok(());
    }

    fn serialize_u64(&mut self, v: u64) -> Result<(), SerializeError> {
        self.w.buf.push_str(`${v}`);
        return Result::Ok(());
    }

    fn serialize_i128(&mut self, v: i128) -> Result<(), SerializeError> {
        self.w.buf.push_str(`${v}`);
        return Result::Ok(());
    }

    fn serialize_u128(&mut self, v: u128) -> Result<(), SerializeError> {
        self.w.buf.push_str(`${v}`);
        return Result::Ok(());
    }

    fn serialize_f32(&mut self, v: f32) -> Result<(), SerializeError> {
        self.w.buf.push_str(`${v as f64}`);
        return Result::Ok(());
    }

    fn serialize_f64(&mut self, v: f64) -> Result<(), SerializeError> {
        self.w.buf.push_str(`${v}`);
        return Result::Ok(());
    }

    fn serialize_bool(&mut self, v: bool) -> Result<(), SerializeError> {
        if v {
            self.w.buf.push_str("true");
        } else {
            self.w.buf.push_str("false");
        }
        return Result::Ok(());
    }

    fn serialize_char(&mut self, v: char) -> Result<(), SerializeError> {
        self.w.buf.push_str(`"${v}"`);
        return Result::Ok(());
    }

    fn serialize_string<S: AsStrSlice>(&mut self, v: S) -> Result<(), SerializeError> {
        self.w.buf.push_str(`"${v}"`);
        return Result::Ok(());
    }

    fn serialize_null(&mut self) -> Result<(), SerializeError> {
        self.w.buf.push_str("null");
        return Result::Ok(());
    }

    fn begin_seq(&mut self, len: i32) -> Result<MockSeqSerializer, SerializeError> {
        self.w.buf.push_str("[");
        return Result::Ok(MockSeqSerializer { w: self.w, count: 0 });
    }

    fn begin_map(&mut self, len: i32) -> Result<MockMapSerializer, SerializeError> {
        self.w.buf.push_str("{");
        return Result::Ok(MockMapSerializer { w: self.w, count: 0 });
    }

    fn begin_struct<S: AsStrSlice>(&mut self, name: S, fields: i32) -> Result<MockStructSerializer, SerializeError> {
        self.w.buf.push_str("{");
        return Result::Ok(MockStructSerializer { w: self.w, count: 0 });
    }

    fn serialize_unit_variant<S: AsStrSlice, S1: AsStrSlice>(
        &mut self,
        type_name: S,
        variant_name: S1,
        disc: i32,
    ) -> Result<(), SerializeError> {
        self.w.buf.push_str(`"${variant_name}"`);
        return Result::Ok(());
    }

    fn begin_variant<S: AsStrSlice, S1: AsStrSlice>(
        &mut self,
        type_name: S,
        variant_name: S1,
        disc: i32,
    ) -> Result<MockVariantSerializer, SerializeError> {
        self.w.buf.push_str(`{"${variant_name}":`);
        return Result::Ok(MockVariantSerializer { w: self.w });
    }
}

fn mock_serialize<T: Serialize>(value: &T) -> String {
    let mut writer = MockWriter { buf: "" };
    let mut ser = MockSerializer { w: &mut writer };
    value.serialize::<MockSerializer>(&mut ser);
    return writer.buf;
}

test "error type construction" {
    let se = SerializeError {
        kind: SerializeErrorKind::Custom,
        message: "test",
    };
    assert se.message == "test";

    let de = DeserializeError::missing_field("name");
    assert de.message == "missing field: name";
    assert de.offset == -1;

    let de2 = DeserializeError::malformed("bad json", 10);
    assert de2.offset == 10;
}

test "a positionless DeserializeError omits the offset rather than saying 0" {
    assert DeserializeError::malformed("bad json").offset == -1;
    assert DeserializeError::invalid_value("bad value").offset == -1;
    assert `${DeserializeError::malformed("bad json")}` == "bad json";
    assert `${DeserializeError::malformed("bad json", 0)}` == "bad json at offset 0";
}

test "serialize i32" {
    let n = 42;
    assert mock_serialize(&n) == "42";
}

test "serialize negative i32" {
    let n = -7;
    assert mock_serialize(&n) == "-7";
}

test "serialize i64" {
    let n: i64 = 1000000000000;
    assert mock_serialize(&n) == "1000000000000";
}

test "serialize u32" {
    let n: u32 = 100;
    assert mock_serialize(&n) == "100";
}

test "serialize u64" {
    let n: u64 = 42;
    assert mock_serialize(&n) == "42";
}

test "serialize f64" {
    let n = 3.14;
    assert mock_serialize(&n) == "3.14";
}

test "serialize bool true" {
    let v = true;
    assert mock_serialize(&v) == "true";
}

test "serialize bool false" {
    let v = false;
    assert mock_serialize(&v) == "false";
}

test "serialize string" {
    let s = "hello";
    assert mock_serialize(&s) == `"hello"`;
}

test "serialize Option Some" {
    let opt: Option<i32> = Option::Some(42);
    assert mock_serialize(&opt) == "42";
}

test "serialize Option None" {
    let opt: Option<i32> = null;
    assert mock_serialize(&opt) == "null";
}

test "serialize List<i32>" {
    let arr: List<i32> = [1, 2, 3];
    assert mock_serialize(&arr) == "[1,2,3]";
}

test "serialize empty List" {
    let arr: List<i32> = [];
    assert mock_serialize(&arr) == "[]";
}

test "serialize List<String>" {
    let arr: List<String> = ["a", "b"];
    assert mock_serialize(&arr) == `["a","b"]`;
}

test "serialize nested Option<List>" {
    let arr: List<i32> = [10, 20];
    let opt: Option<List<i32>> = Option::Some(arr);
    assert mock_serialize(&opt) == "[10,20]";
}

// heck-parity contract for `apply_case` (Stage C, WEP 2026-06-13). These
// vectors must match Rust's `heck` (the compiler's `apply_rename_all`).

test "apply_case user_id" {
    assert apply_case(CaseStyle::Camel, "user_id") == "userId";
    assert apply_case(CaseStyle::Snake, "user_id") == "user_id";
    assert apply_case(CaseStyle::ScreamingSnake, "user_id") == "USER_ID";
    assert apply_case(CaseStyle::Pascal, "user_id") == "UserId";
    assert apply_case(CaseStyle::Kebab, "user_id") == "user-id";
    assert apply_case(CaseStyle::ScreamingKebab, "user_id") == "USER-ID";
    assert apply_case(CaseStyle::Identity, "user_id") == "user_id";
}

test "apply_case userName" {
    assert apply_case(CaseStyle::Snake, "userName") == "user_name";
    assert apply_case(CaseStyle::Camel, "userName") == "userName";
    assert apply_case(CaseStyle::Pascal, "userName") == "UserName";
    assert apply_case(CaseStyle::Kebab, "userName") == "user-name";
}

test "apply_case HTTPServer" {
    assert apply_case(CaseStyle::Snake, "HTTPServer") == "http_server";
    assert apply_case(CaseStyle::Camel, "HTTPServer") == "httpServer";
    assert apply_case(CaseStyle::Pascal, "HTTPServer") == "HttpServer";
    assert apply_case(CaseStyle::Kebab, "HTTPServer") == "http-server";
}

test "apply_case XMLHttpRequest" {
    assert apply_case(CaseStyle::Snake, "XMLHttpRequest") == "xml_http_request";
    assert apply_case(CaseStyle::Camel, "XMLHttpRequest") == "xmlHttpRequest";
    assert apply_case(CaseStyle::Pascal, "XMLHttpRequest") == "XmlHttpRequest";
}

test "apply_case id" {
    assert apply_case(CaseStyle::Camel, "id") == "id";
    assert apply_case(CaseStyle::Pascal, "id") == "Id";
    assert apply_case(CaseStyle::Snake, "id") == "id";
}

test "apply_case field2" {
    assert apply_case(CaseStyle::Snake, "field2") == "field2";
    assert apply_case(CaseStyle::Camel, "field2") == "field2";
}

test "apply_case already_snake_case" {
    assert apply_case(CaseStyle::Camel, "already_snake_case") == "alreadySnakeCase";
    assert apply_case(CaseStyle::Pascal, "already_snake_case") == "AlreadySnakeCase";
}

// Heck-parity contract: these vectors mirror
// `serde_synth::tests::rename_all_edge_corpus_locks_heck_output` exactly, so the
// library port and the compiler's `apply_rename_all` (heck) stay in lock-step.
test "apply_case heck-parity edge corpus" {
    assert apply_case(CaseStyle::Snake, "userID") == "user_id";
    assert apply_case(CaseStyle::Snake, "HTTPStatus") == "http_status";
    assert apply_case(CaseStyle::Snake, "parseHTTP") == "parse_http";
    assert apply_case(CaseStyle::Snake, "IOError") == "io_error";
    assert apply_case(CaseStyle::Snake, "iOS") == "i_os";
    assert apply_case(CaseStyle::Snake, "field2Name") == "field2_name";
    assert apply_case(CaseStyle::Snake, "Apple2Banana") == "apple2_banana";
    assert apply_case(CaseStyle::Camel, "HTTPStatus") == "httpStatus";
    assert apply_case(CaseStyle::Pascal, "userID") == "UserId";
    // A bare all-caps token collapses to one lowercase word.
    assert apply_case(CaseStyle::Snake, "ID") == "id";
    assert apply_case(CaseStyle::Pascal, "ID") == "Id";
    assert apply_case(CaseStyle::Camel, "userID") == "userId";
}

test "report_duplicate_field rejects under Error, naming the key as Inspect does" {
    let role: String = "role";
    let e = report_duplicate_field(DuplicateFieldPolicy::Error, &role).unwrap_err();
    assert e.kind == DeserializeErrorKind::DuplicateField && e.message == `duplicate field: "role"`;
    assert report_duplicate_field(DuplicateFieldPolicy::Error, &7) matches { Err(int_key) && int_key.message == "duplicate field: 7" };
}

test "report_duplicate_field continues under Warn" {
    assert report_duplicate_field(DuplicateFieldPolicy::Warn, &7) matches { Ok };
}

test "report_duplicate_field continues under PassThru" {
    assert report_duplicate_field(DuplicateFieldPolicy::PassThru, &7) matches { Ok };
}

struct KeyPair {
    a: i32,
}

variant KeyShape {
    Dot(i32),
}

fn key_text<T: Serialize>(key: &T) -> Result<String, SerializeError> {
    let mut out = String::new();
    key.serialize(&mut TextKeySerializer { out: &mut out })?;
    return Result::Ok(out);
}

fn key_refused<T: Serialize>(key: &T) -> bool {
    return key_text(key) matches { Err(e) && e.kind == SerializeErrorKind::UnsupportedValue };
}

test "TextKeySerializer spells a scalar and refuses every other shape" {
    assert key_text(&-7) matches { Ok(s) && s == "-7" };
    assert key_text(&'k') matches { Ok(s) && s == "k" };
    let none: Option<i32> = null;
    assert key_refused(&none);
    let list: List<i32> = [1];
    assert key_refused(&list);
    let mut map = TreeMap::<String, i32>::new();
    map["a"] = 1;
    assert key_refused(&map);
    assert key_refused(&KeyPair { a: 1 });
    assert key_refused(&KeyShape::Dot(1));
}

// --- a case read by discriminant ---

/// `D`, with each variant's case named by its discriminant: JSON's
/// `{"1": 5}` reads as case 1 with payload 5. No stdlib format encodes one,
/// and a non-self-describing format is what would.
struct ByDisc<D: Deserializer> {
    inner: &mut D,
}

struct ByDiscAccess<A: DeserializeVariant> {
    inner: A,
}

#[coverage(off)]
impl<A: DeserializeVariant> DeserializeVariant for ByDiscAccess<A> {
    fn variant_name(&mut self) -> Result<String, DeserializeError> {
        return self.inner.variant_name();
    }

    fn disc(&mut self) -> Result<i32, DeserializeError> {
        return Result::Ok(i32::from_str(self.inner.variant_name()?).unwrap());
    }

    fn payload<T: Deserialize>(&mut self) -> Result<T, DeserializeError> {
        return self.inner.payload();
    }

    fn is_unit(&mut self) -> Result<bool, DeserializeError> {
        return self.inner.is_unit();
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        return self.inner.end();
    }
}

// A variant reaches only `begin_variant` and the payload's own read.
#[coverage(off)]
impl<D: Deserializer> Deserializer for ByDisc<D> {
    type SeqAccess = D::SeqAccess;
    type MapAccess = D::MapAccess;
    type StructAccess = D::StructAccess;
    type VariantAccess = ByDiscAccess<D::VariantAccess>;

    fn deserialize_i32(&mut self) -> Result<i32, DeserializeError> {
        return self.inner.deserialize_i32();
    }

    fn deserialize_i64(&mut self) -> Result<i64, DeserializeError> {
        return self.inner.deserialize_i64();
    }

    fn deserialize_u32(&mut self) -> Result<u32, DeserializeError> {
        return self.inner.deserialize_u32();
    }

    fn deserialize_u64(&mut self) -> Result<u64, DeserializeError> {
        return self.inner.deserialize_u64();
    }

    fn deserialize_i128(&mut self) -> Result<i128, DeserializeError> {
        return self.inner.deserialize_i128();
    }

    fn deserialize_u128(&mut self) -> Result<u128, DeserializeError> {
        return self.inner.deserialize_u128();
    }

    fn deserialize_f32(&mut self) -> Result<f32, DeserializeError> {
        return self.inner.deserialize_f32();
    }

    fn deserialize_f64(&mut self) -> Result<f64, DeserializeError> {
        return self.inner.deserialize_f64();
    }

    fn deserialize_f16(&mut self) -> Result<f16, DeserializeError> {
        return self.inner.deserialize_f16();
    }

    fn deserialize_bf16(&mut self) -> Result<bf16, DeserializeError> {
        return self.inner.deserialize_bf16();
    }

    fn deserialize_bool(&mut self) -> Result<bool, DeserializeError> {
        return self.inner.deserialize_bool();
    }

    fn deserialize_char(&mut self) -> Result<char, DeserializeError> {
        return self.inner.deserialize_char();
    }

    fn deserialize_string(&mut self) -> Result<String, DeserializeError> {
        return self.inner.deserialize_string();
    }

    fn is_null(&mut self) -> Result<bool, DeserializeError> {
        return self.inner.is_null();
    }

    fn begin_seq(&mut self) -> Result<D::SeqAccess, DeserializeError> {
        return self.inner.begin_seq();
    }

    fn begin_map(&mut self) -> Result<D::MapAccess, DeserializeError> {
        return self.inner.begin_map();
    }

    fn begin_struct<S: AsStrSlice>(&mut self, name: S, num_fields: i32) -> Result<D::StructAccess, DeserializeError> {
        return self.inner.begin_struct(name, num_fields);
    }

    fn begin_variant<S: AsStrSlice>(
        &mut self,
        type_name: S,
        num_cases: i32,
    ) -> Result<ByDiscAccess<D::VariantAccess>, DeserializeError> {
        return Result::Ok(ByDiscAccess { inner: self.inner.begin_variant(type_name, num_cases)? });
    }

    fn deserialize_any<V: Visitor>(&mut self, visitor: &mut V) -> Result<V::Value, DeserializeError> {
        return self.inner.deserialize_any(visitor);
    }
}

/// A `T` whose cases are read by discriminant.
struct ReadByDisc<T> {
    value: T,
}

impl<T: Deserialize> Deserialize for ReadByDisc<T> {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<ReadByDisc<T>, DeserializeError> {
        let mut by_disc = ByDisc { inner: d };
        return T::deserialize(&mut by_disc).map(|value| ReadByDisc { value });
    }
}

enum Light {
    Red,
    Green,
}

variant Reading {
    Missing,
    Level(i32),
}

test "an enum or a variant reads its case by discriminant" {
    assert json::from_string::<ReadByDisc<Light>>(`"1"`) matches { Ok(r) && r.value == Light::Green };
    assert json::from_string::<ReadByDisc<Reading>>(`{"1":5}`) matches { Ok(r) && r.value matches { Level(5) } };
    assert json::from_string::<ReadByDisc<Reading>>(`"0"`) matches { Ok(r) && r.value matches { Missing } };
}

// --- every fallible step, failed in turn ---
//
// `Flaky<T>` reads or writes `T` through wrappers that let `BUDGET` calls
// through and fail the next, so stepping the budget up from zero fails each call
// a derivation makes, one at a time. The wrappers reach the format only at the
// top level: a nested value is read by the format's own access.

global mut BUDGET: i32 = -1;

fn spend() -> bool {
    if BUDGET == 0 {
        return false;
    }
    BUDGET -= 1;
    return true;
}

fn gate() -> Result<(), DeserializeError> {
    if spend() {
        return Result::Ok(());
    }
    return Result::Err(DeserializeError::malformed("injected"));
}

fn sgate() -> Result<(), SerializeError> {
    if spend() {
        return Result::Ok(());
    }
    return Result::Err(SerializeError::unsupported_value("injected"));
}

struct Flaky<T> {
    value: T,
}

impl<T: Deserialize> Deserialize for Flaky<T> {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<Flaky<T>, DeserializeError> {
        return T::deserialize(&mut FlakyDe { inner: d }).map(|value| Flaky { value });
    }
}

impl<T: Serialize> Serialize for Flaky<T> {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return self.value.serialize(&mut FlakySer { inner: s });
    }
}

/// How many of the calls reading `input` as `T` fail it, each failed in turn.
fn failures_reading<T: Deserialize>(input: String) -> i32 {
    let mut n = 0;
    loop {
        BUDGET = n;
        let r = json::from_string::<Flaky<T>>(input);
        BUDGET = -1;
        if r matches { Ok(_) } {
            return n;
        }
        n += 1;
    }
}

/// How many of the calls writing `value` as CBOR fail it, each failed in turn.
fn failures_writing<T: Serialize>(value: T) -> i32 {
    let mut n = 0;
    loop {
        BUDGET = n;
        let r = cbor::to_bytes(&Flaky { value });
        BUDGET = -1;
        if r matches { Ok(_) } {
            return n;
        }
        n += 1;
    }
}

struct FlakyDe<D: Deserializer> {
    inner: &mut D,
}

struct FlakySeq<A: DeserializeSeq> {
    inner: A,
}

struct FlakySeqRef<A: DeserializeSeq> {
    inner: &mut A,
}

struct FlakyMap<A: DeserializeMap> {
    inner: A,
}

struct FlakyMapRef<A: DeserializeMap> {
    inner: &mut A,
}

struct FlakyStruct<A: DeserializeStruct> {
    inner: A,
}

struct FlakyVariant<A: DeserializeVariant> {
    inner: A,
}

struct FlakyVisitor<V: Visitor> {
    inner: &mut V,
}

#[coverage(off)]
impl<A: DeserializeSeq> DeserializeSeq for FlakySeq<A> {
    fn next_element<T: Deserialize>(&mut self) -> Result<Option<T>, DeserializeError> {
        gate()?;
        return self.inner.next_element();
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        gate()?;
        return self.inner.end();
    }
}

#[coverage(off)]
impl<A: DeserializeSeq> DeserializeSeq for FlakySeqRef<A> {
    fn next_element<T: Deserialize>(&mut self) -> Result<Option<T>, DeserializeError> {
        gate()?;
        return self.inner.next_element();
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        gate()?;
        return self.inner.end();
    }
}

#[coverage(off)]
impl<A: DeserializeMap> DeserializeMap for FlakyMap<A> {
    fn next_key<K: Deserialize>(&mut self) -> Result<Option<K>, DeserializeError> {
        gate()?;
        return self.inner.next_key();
    }

    fn next_value<V: Deserialize>(&mut self) -> Result<V, DeserializeError> {
        gate()?;
        return self.inner.next_value();
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        gate()?;
        return self.inner.end();
    }
}

#[coverage(off)]
impl<A: DeserializeMap> DeserializeMap for FlakyMapRef<A> {
    fn next_key<K: Deserialize>(&mut self) -> Result<Option<K>, DeserializeError> {
        gate()?;
        return self.inner.next_key();
    }

    fn next_value<V: Deserialize>(&mut self) -> Result<V, DeserializeError> {
        gate()?;
        return self.inner.next_value();
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        gate()?;
        return self.inner.end();
    }
}

#[coverage(off)]
impl<A: DeserializeStruct> DeserializeStruct for FlakyStruct<A> {
    fn next_field<S: FieldSchema>(&mut self) -> Result<Option<i32>, DeserializeError> {
        gate()?;
        return self.inner.next_field::<S>();
    }

    fn value<T: Deserialize>(&mut self) -> Result<T, DeserializeError> {
        gate()?;
        return self.inner.value();
    }

    fn skip(&mut self) -> Result<(), DeserializeError> {
        gate()?;
        return self.inner.skip();
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        gate()?;
        return self.inner.end();
    }
}

