#![stdlib("core:url")]
//! URL parsing and construction for special schemes (WHATWG URL Standard).
//!
//! Supports `http`, `https`, `ws`, and `wss` schemes.


use { TreeMap } from "core:collections";
use { Serialize, Serializer, SerializeError, Deserialize, Deserializer, DeserializeError } from "core:serde";

// The largest port a URL may name (WHATWG URL Standard, "port state").
global PORT_MAX: i32 = 65535;

#[synopsis]
test {
    assert Url::from_str("https://wado.dev/docs?q=synopsis") matches { Ok(url) && url.scheme == "https"
        && url.host == "wado.dev"
        && url.path == "/docs"
        && url.query_get("q") matches { Some(v) && v == "synopsis" } };
}

/// Error type for URL parsing failures.
pub variant ParseError {
    EmptyInput,
    InvalidScheme,
    MissingHost,
    InvalidHost,
    InvalidPort,
    InvalidPath,
    InvalidPercentEncoding,
    /// The percent-decoded bytes are not UTF-8.
    InvalidUtf8(Utf8Error),
}

impl Display for ParseError {
    fn fmt(&self, f: &mut Formatter) {
        let message: String = match *self {
            EmptyInput => "empty input",
            InvalidScheme => "invalid scheme",
            MissingHost => "missing host",
            InvalidHost => "invalid host",
            InvalidPort => "invalid port",
            InvalidPath => "invalid path",
            InvalidPercentEncoding => "invalid percent-encoding",
            InvalidUtf8(e) => `invalid UTF-8: ${e}`,
        };
        f.write_str(&message);
    }
}

impl Error for ParseError {
}

impl From<Utf8Error> for ParseError;

impl Eq for ParseError {
    fn eq(&self, other: &Self) -> bool {
        return match [*self, *other] {
            [EmptyInput, EmptyInput] => true,
            [InvalidScheme, InvalidScheme] => true,
            [MissingHost, MissingHost] => true,
            [InvalidHost, InvalidHost] => true,
            [InvalidPort, InvalidPort] => true,
            [InvalidPath, InvalidPath] => true,
            [InvalidPercentEncoding, InvalidPercentEncoding] => true,
            [InvalidUtf8(a), InvalidUtf8(b)] => a == b,
            _ => false,
        };
    }
}

/// A parsed URL with a special scheme (http, https, ws, wss).
///
/// Fields store raw (percent-encoded) values. Use `percent_decode` to get
/// decoded forms where needed.
pub struct Url {
    /// The scheme, lowercase. One of: "http", "https", "ws", "wss".
    pub scheme: String,
    /// The username component. Empty string if absent.
    pub username: String,
    /// The password component. Empty string if absent.
    pub password: String,
    /// The host. Always present for special schemes.
    /// IPv6 addresses are stored without brackets (e.g., "::1" not "[::1]").
    pub host: String,
    /// The port number. None means the default port for the scheme.
    pub port: Option<u16>,
    /// The path component. Always starts with "/". At minimum "/".
    pub path: String,
    /// The query string without the leading "?". None if absent.
    pub query: Option<String>,
    /// The fragment without the leading "#". None if absent.
    pub fragment: Option<String>,
}

impl Eq for Url;

fn default_port_for_scheme<S: AsStrSlice>(scheme: S) -> u16 {
    if scheme == "http" || scheme == "ws" {
        return 80;
    }
    return 443;
}

/// Peels `#fragment` then `?query` off `input`, as `[rest, query, fragment]`.
/// The fragment goes first, so a `?` inside it stays part of the fragment.
fn split_off_query_and_fragment<S: AsStrSlice>(input: S) -> [String, Option<String>, Option<String>] {
    let mut rest = input.as_str_slice();

    let mut fragment: Option<String> = null;
    if let Some([before, after]) = rest.split_once("#") {
        fragment = Option::Some(after.to_string());
        rest = before;
    }

    let mut query: Option<String> = null;
    if let Some([before, after]) = rest.split_once("?") {
        query = Option::Some(after.to_string());
        rest = before;
    }

    return [rest.to_string(), query, fragment];
}

fn is_special_scheme<S: AsStrSlice>(s: S) -> bool {
    return s matches { "http" | "https" | "ws" | "wss" };
}

fn is_unreserved_char(c: char) -> bool {
    if 'A' <= c <= 'Z' {
        return true;
    }
    if 'a' <= c <= 'z' {
        return true;
    }
    if '0' <= c <= '9' {
        return true;
    }
    return c == '-' || c == '.' || c == '_' || c == '~';
}

/// Appends `c` as the `%XX` of each of its UTF-8 bytes.
fn push_percent_encoded(c: char, out: &mut String) {
    for let b of c.encode_utf8() {
        let n = b as i32;
        out.push_str(`%${n:02X}`);
    }
}

fn percent_encode_char(c: char, out: &mut String) {
    if is_unreserved_char(c) {
        out.push(c);
    } else {
        push_percent_encoded(c, out);
    }
}

/// Whether WHATWG percent-encodes `c` in user info: everything but the
/// characters below, so every delimiter, control and non-ASCII code point.
/// `%` is kept, which is what lets an existing `%HH` pass through.
fn is_userinfo_encoded_char(c: char) -> bool {
    return match c {
        'a'..='z' | 'A'..='Z' | '0'..='9' => false,
        '!' | '$' | '%' | '&' | '\'' | '(' | ')' | '*' | '+' | ',' | '-' | '.' | '_' | '~' => false,
        _ => true,
    };
}

/// One credential, spelled as WHATWG stores it.
fn percent_encode_userinfo<S: AsStrSlice>(input: S) -> String {
    let mut out = String::with_capacity(input.len());
    for let c of input.chars() {
        if is_userinfo_encoded_char(c) {
            push_percent_encoded(c, &mut out);
        } else {
            out.push(c);
        }
    }
    return out;
}

/// Percent-encodes a string. Encodes all characters except unreserved
/// characters (A-Z, a-z, 0-9, '-', '.', '_', '~') per RFC 3986 §2.3.
pub fn percent_encode<S: AsStrSlice>(input: S) -> String {
    let mut out = String::with_capacity(input.len());
    for let c of input.chars() {
        percent_encode_char(c, &mut out);
    }
    return out;
}

/// Decodes percent-encoded sequences (%XX).
/// Returns Err if the input contains invalid percent-encoding or invalid UTF-8.
pub fn percent_decode<S: AsStrSlice>(input: S) -> Result<String, ParseError> {
    let len = input.len();
    let mut bytes = ByteList::with_capacity(len);
    let mut i = 0;
    while i < len {
        let c = input.get_byte_unchecked(i) as char;
        if c == '%' {
            if i + 2 >= len {
                return Result::Err(ParseError::InvalidPercentEncoding);
            }
            let hi = input.get_byte_unchecked(i + 1) as char;
            let lo = input.get_byte_unchecked(i + 2) as char;
            if !hi.is_hexdigit() || !lo.is_hexdigit() {
                return Result::Err(ParseError::InvalidPercentEncoding);
            }
            bytes.push((hi.hex_digit_value() << 4 | lo.hex_digit_value()) as u8);
            i += 3;
        } else {
            bytes.push(input.get_byte_unchecked(i));
            i += 1;
        }
    }
    return Result::Ok(String::from_utf8(bytes)?);
}

fn percent_encode_query_component<S: AsStrSlice>(input: S) -> String {
    let mut out = String::with_capacity(input.len());
    for let c of input.chars() {
        if c == ' ' {
            out.push('+');
        } else if is_unreserved_char(c) {
            out.push(c);
        } else {
            push_percent_encoded(c, &mut out);
        }
    }
    return out;
}

fn percent_decode_query_component<S: AsStrSlice>(input: S) -> String {
    let len = input.len();
    let mut bytes = ByteList::with_capacity(len);
    let mut i = 0;
    while i < len {
        let c = input.get_byte_unchecked(i) as char;
        if c == '+' {
            bytes.push(b' ');
            i += 1;
        } else if c == '%' && i + 2 < len {
            let hi = input.get_byte_unchecked(i + 1) as char;
            let lo = input.get_byte_unchecked(i + 2) as char;
            if hi.is_hexdigit() && lo.is_hexdigit() {
                bytes.push((hi.hex_digit_value() << 4 | lo.hex_digit_value()) as u8);
                i += 3;
            } else {
                bytes.push(b'%');
                i += 1;
            }
        } else {
            bytes.push(input.get_byte_unchecked(i));
            i += 1;
        }
    }
    if let Ok(s) = String::from_utf8(bytes) {
        return s;
    }
    return input.to_string();
}

/// The still-encoded key and value of one `key=value` query part. A part
/// carrying no `=` is all key, with an empty value.
fn split_query_part<S: AsStrSlice>(part: S) -> [StrSlice, StrSlice] {
    if let Some([key, val]) = part.split_once("=") {
        return [key, val];
    }
    return [
        part.as_str_slice(),
        "".as_str_slice(),
    ];
}

/// Parses a query string into key-value pairs (insertion-order preserved).
/// Input should not include the leading "?".
/// Handles "+" as space and decodes percent-encoding.
/// Duplicate keys use last-value-wins semantics.
pub fn parse_query<S: AsStrSlice>(query: S) -> TreeMap<String, String> {
    let mut result: TreeMap<String, String> = TreeMap::new();
    if query.is_empty() {
        return result;
    }
    for let part of query.split("&") {
        if part.is_empty() {
            continue;
        }
        let [key, val] = split_query_part(part);
        result[percent_decode_query_component(&key)] = percent_decode_query_component(&val);
    }
    return result;
}

/// Formats key-value pairs into a query string (insertion-order preserved).
/// Output does not include the leading "?".
/// Keys and values are percent-encoded; spaces become "+".
pub fn format_query(params: TreeMap<String, String>) -> String {
    let mut out = String::with_capacity(64);
    let entries = params.entries().iter_value().collect();
    for let mut i = 0; i < entries.len(); i += 1 {
        if i > 0 {
            out.push('&');
        }
        let entry = entries[i];
        out.push_str(&percent_encode_query_component(&entry.0));
        out.push('=');
        out.push_str(&percent_encode_query_component(&entry.1));
    }
    return out;
}

fn remove_dot_segments<S: AsStrSlice>(path: S) -> String {
    let segments = path.split("/");
    let mut stack: List<String> = [];
    for let seg of segments {
        if seg == ".." {
            if stack.len() > 1 {
                stack.pop();
            }
        } else if seg != "." {
            stack.push(seg);
        }
    }
    if stack.is_empty() {
        return "";
    }
    if stack.len() == 1 && stack[0] == "" {
        return "/";
    }
    let mut result = String::with_capacity(64);
    for let mut i = 0; i < stack.len(); i += 1 {
        if i > 0 {
            result.push('/');
        }
        result.push_str(&stack[i]);
    }
    return result;
}

fn parse_port_str<S: AsStrSlice>(s: S) -> Result<u16, ParseError> {
    if s.is_empty() {
        return Result::Err(ParseError::InvalidPort);
    }
    let mut val: i32 = 0;
    for let c of s.chars() {
        if !('0' <= c <= '9') {
            return Result::Err(ParseError::InvalidPort);
        }
        val = val * 10 + (c as i32 - '0' as i32);
        if val > PORT_MAX {
            return Result::Err(ParseError::InvalidPort);
        }
    }
    return Result::Ok(val as u16);
}

fn apply_port(url: &mut Url, port_val: u16) {
    if port_val == default_port_for_scheme(&url.scheme) {
        url.port = null;
    } else {
        url.port = Option::Some(port_val);
    }
}

fn parse_authority<S: AsStrSlice>(authority: S, url: &mut Url) -> Result<(), ParseError> {
    let input = authority.as_str_slice();
    let mut rest = input;

    // User info runs to the last `@` and its password starts at the first `:`,
    // so both delimiters are read before either credential is encoded.
    if let Some([userinfo, after_at]) = input.rsplit_once("@") {
        rest = after_at;
        if let Some([user, password]) = userinfo.split_once(":") {
            url.username = percent_encode_userinfo(user);
            url.password = percent_encode_userinfo(password);
        } else {
            url.username = percent_encode_userinfo(userinfo);
        }
    }

    if rest.is_empty() {
        return Result::Err(ParseError::MissingHost);
    }

    if rest.starts_with("[") {
        if let Some(bracket_end) = rest.find("]") {
            url.host = rest.substr_bytes(1, bracket_end);
            let after = rest.substr_bytes(bracket_end + 1, rest.len());
            if !after.is_empty() {
                if after.starts_with(":") {
                    let port_str = after.substr_bytes(1, after.len());
                    apply_port(url, parse_port_str(&port_str)?);
                } else {
                    return Result::Err(ParseError::InvalidHost);
                }
            }
        } else {
            return Result::Err(ParseError::InvalidHost);
        }
        return Result::Ok(());
    }

    if let Some([host_part, port_str]) = rest.rsplit_once(":") {
        if port_str.is_empty() {
            if host_part.is_empty() {
                return Result::Err(ParseError::MissingHost);
            }
            url.host = host_part.to_ascii_lowercase();
            return Result::Ok(());
        }
        if host_part.is_empty() {
            return Result::Err(ParseError::MissingHost);
        }
        let port_val = parse_port_str(&port_str)?;
        url.host = host_part.to_ascii_lowercase();
        apply_port(url, port_val);
        return Result::Ok(());
    }

    url.host = rest.to_ascii_lowercase();
    return Result::Ok(());
}

/// Reads an absolute URL. Only special schemes (http, https, ws, wss) are
/// accepted; a relative reference goes through `Url::resolve`.
impl FromStr for Url {
    type Err = ParseError;

    fn from_str<S: AsStrSlice>(input: S) -> Result<Url, ParseError> {
        if input.is_empty() {
            return Result::Err(ParseError::EmptyInput);
        }

        let Some([before_colon, after_colon]) = input.split_once(":") else {
            return Result::Err(ParseError::InvalidScheme);
        };
        let scheme = before_colon.to_ascii_lowercase();
        if !is_special_scheme(&scheme) {
            return Result::Err(ParseError::InvalidScheme);
        }

        let Some(after_slashes) = after_colon.strip_prefix("//") else {
            return Result::Err(ParseError::MissingHost);
        };

        let [rest, query, fragment] = split_off_query_and_fragment(after_slashes);

        let mut authority_str = rest;
        let mut path = "/";
        if let Some(slash_pos) = rest.find("/") {
            authority_str = rest.substr_bytes(0, slash_pos);
            path = rest.substr_bytes(slash_pos, rest.len());
        }

        let normalized_path = normalize_percent_encoding(&remove_dot_segments(path));

        let mut url = Url {
            scheme: scheme,
            username: "",
            password: "",
            host: "",
            port: null,
            path: normalized_path,
            query: query,
            fragment: fragment,
        };

        parse_authority(&authority_str, &mut url)?;

        if url.host.is_empty() {
            return Result::Err(ParseError::MissingHost);
        }

        return Result::Ok(url);
    }
}

impl Url {
    /// Constructs a Url from its scheme, authority, path-with-query, and
    /// fragment. This constructor is infallible: any scheme is accepted,
    /// a malformed authority is stored as-is in `host`, and missing or
    /// empty paths default to "/".
    ///
    /// Use `to_string()` to obtain the serialized URL.
    pub fn from_parts<S: AsStrSlice, S1: AsStrSlice>(
        scheme: S,
        authority: S1,
        path_with_query: Option<String>,
        fragment: Option<String>,
    ) -> Url {
        let mut url = Url {
            scheme: scheme.to_ascii_lowercase(),
            username: "",
            password: "",
            host: "",
            port: null,
            path: "/",
            query: null,
            fragment: fragment,
        };
        if !authority.is_empty() {
            if parse_authority(&authority, &mut url).is_err() {
                url.host = authority.to_string();
            }
        }
        let pwq = if let Some(p) = path_with_query && !p.is_empty() {
            p;
        } else {
            "/";
        };
        let mut path_part = pwq.as_str_slice();
        if let Some([before, after]) = pwq.split_once("?") {
            path_part = before;
            url.query = Option::Some(after.to_string());
        }
        if path_part.is_empty() {
            url.path = "/";
        } else if !path_part.starts_with("/") {
            let mut p = String::with_capacity(path_part.len() + 1);
            p.push('/');
            p.push_str(&path_part);
            url.path = p;
        } else {
            url.path = path_part.to_string();
        }
        return url;
    }

    /// Returns the query parameters as a `TreeMap`. Percent-encoded values
    /// are decoded; "+" becomes " ". Returns an empty map if there is no
    /// query component.
    pub fn query_params(&self) -> TreeMap<String, String> {
        if let Some(q) = self.query {
            return parse_query(q);
        }
        return TreeMap::new();
    }

    /// Serializes the URL back to a string.
    pub fn to_string(&self) -> String {
        let mut out = String::with_capacity(64);
        self.write_to(&mut out);
        return out;
    }

    /// Append the serialized form. Every part writes into the caller's buffer,
    /// so serializing a URL allocates the one string it returns.
    fn write_to(&self, out: &mut String) {
        out.push_str(&self.scheme);
        out.push_str("://");
        self.write_authority(out);
        self.write_path_with_query(out);
        if let Some(f) = self.fragment {
            out.push('#');
            out.push_str(&f);
        }
    }

    /// Returns the authority: [userinfo@]host[:port].
    pub fn authority(&self) -> String {
        let mut out = String::with_capacity(32);
        self.write_authority(&mut out);
        return out;
    }

    fn write_authority(&self, out: &mut String) {
        if !self.username.is_empty() {
            out.push_str(&self.username);
            if !self.password.is_empty() {
                out.push(':');
                out.push_str(&self.password);
            }
            out.push('@');
        }
        self.write_host_port(out);
    }

    fn write_host_port(&self, out: &mut String) {
        if self.host.contains(":") {
            out.push('[');
            out.push_str(&self.host);
            out.push(']');
        } else {
            out.push_str(&self.host);
        }
        if let Some(p) = self.port {
            out.push(':');
            out.push_display(&p);
        }
    }

    /// Returns the origin: scheme://host[:port] (excludes credentials).
    pub fn origin(&self) -> String {
        let mut out = String::with_capacity(32);
        out.push_str(&self.scheme);
        out.push_str("://");
        self.write_host_port(&mut out);
        return out;
    }

    /// Returns path with query: /path[?query]. Matches wasi:http path_with_query.
    pub fn path_with_query(&self) -> String {
        let Some(q) = self.query else {
            return self.path;
        };
        let mut out = String::with_capacity(self.path.len() + 1 + q.len());
        self.write_path_with_query(&mut out);
        return out;
    }

    fn write_path_with_query(&self, out: &mut String) {
        out.push_str(&self.path);
        if let Some(q) = self.query {
            out.push('?');
            out.push_str(&q);
        }
    }

    /// Returns the effective port (explicit port or default for the scheme).
    pub fn effective_port(&self) -> u16 {
        return match self.port {
            Some(p) => p,
            None => default_port_for_scheme(&self.scheme),
        };
    }

    /// Resolves a relative URL reference against this URL as the base.
    /// Follows RFC 3986 §5.
    pub fn resolve<S: AsStrSlice>(&self, reference: S) -> Result<Url, ParseError> {
        if let Some(colon) = reference.find(":") {
            if colon > 0 {
                let ref_scheme = reference.substr_bytes(0, colon).to_ascii_lowercase();
                if is_special_scheme(&ref_scheme) {
                    return Url::from_str(reference);
                }
            }
        }

        let mut r_authority = "";
        let mut r_path = "";

        let [rest, r_query, r_fragment] = split_off_query_and_fragment(reference);

        if let Some(after_slashes) = rest.strip_prefix("//") {
            if let Some(slash_pos) = after_slashes.find("/") {
                r_authority = after_slashes.substr_bytes(0, slash_pos);
                r_path = after_slashes.substr_bytes(slash_pos, after_slashes.len());
            } else {
                r_authority = after_slashes.to_string();
                r_path = "/";
            }

            let mut result = Url {
                scheme: self.scheme,
                username: "",
                password: "",
                host: "",
                port: null,
                path: normalize_percent_encoding(&remove_dot_segments(r_path)),
                query: r_query,
                fragment: r_fragment,
            };
            parse_authority(&r_authority, &mut result)?;
            return Result::Ok(result);
        }

        r_path = rest;

        if r_path.is_empty() {
            let resolved_query = if r_query matches { Some(_) } { r_query } else { self.query };
            return Result::Ok(Url {
                scheme: self.scheme,
                username: self.username,
                password: self.password,
                host: self.host,
                port: self.port,
                path: self.path,
                query: resolved_query,
                fragment: r_fragment,
            });
        }

        let resolved_path = if r_path.starts_with("/") {
            normalize_percent_encoding(&remove_dot_segments(r_path));
        } else {
            let base = self.path;
            let merged = if let Some(last_slash) = base.rfind("/") {
                let mut m = String::with_capacity(last_slash + 1 + r_path.len());
                m.push_str(&base.substr_bytes(0, last_slash + 1));
                m.push_str(&r_path);
                m;
            } else {
                r_path;
            };
            normalize_percent_encoding(&remove_dot_segments(merged));
        };

        return Result::Ok(Url {
            scheme: self.scheme,
            username: self.username,
            password: self.password,
            host: self.host,
            port: self.port,
            path: resolved_path,
            query: r_query,
            fragment: r_fragment,
        });
    }

    /// Parses the query string into a TreeMap (insertion-order preserved).
    pub fn query_pairs(&self) -> TreeMap<String, String> {
        return match self.query {
            Some(q) => parse_query(q),
            None => TreeMap::new(),
        };
    }

    /// Returns the value for the given query parameter key.
    pub fn query_get<S: AsStrSlice>(&self, key: S) -> Option<String> {
        return self.query_pairs().get_str(key);
    }

    /// Returns all values for the given query parameter key.
    /// Computed from the raw query string to preserve duplicate keys.
    pub fn query_get_all<S: AsStrSlice>(&self, key: S) -> List<String> {
        let mut result: List<String> = [];
        if let Some(q) = self.query {
            for let part of q.split("&") {
                if part.is_empty() {
                    continue;
                }
                let [k, v] = split_query_part(part);
                if key == percent_decode_query_component(&k) {
                    result.push(percent_decode_query_component(&v));
                }
            }
        }
        return result;
    }

    /// Returns a new Url with the query string replaced by the given params.
    pub fn with_query_pairs(&self, params: TreeMap<String, String>) -> Url {
        let mut q: Option<String> = null;
        if !params.is_empty() {
            q = Option::Some(format_query(params));
        }
        return Url {
            scheme: self.scheme,
            username: self.username,
            password: self.password,
            host: self.host,
            port: self.port,
            path: self.path,
            query: q,
            fragment: self.fragment,
        };
    }
}

fn normalize_percent_encoding<S: AsStrSlice>(input: S) -> String {
    let len = input.len();
    let mut out = String::with_capacity(len);
    let mut i = 0;
    while i < len {
        let c = input.get_byte_unchecked(i) as char;
        if c == '%' && i + 2 < len {
            let hi = input.get_byte_unchecked(i + 1) as char;
            let lo = input.get_byte_unchecked(i + 2) as char;
            if hi.is_hexdigit() && lo.is_hexdigit() {
                let decoded = hi.hex_digit_value() << 4 | lo.hex_digit_value();
                if is_unreserved_char(decoded as u8 as char) {
                    out.push(decoded as u8 as char);
                } else {
                    out.push_str(`%${decoded:02X}`);
                }
                i += 3;
                continue;
            }
        }
        out.push(c);
        i += 1;
    }
    return out;
}

impl Display for Url {
    fn fmt(&self, f: &mut Formatter) {
        self.write_to(f.buf);
    }
}

impl Serialize for Url {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let str = self.to_string();
        return s.serialize_string(&str);
    }
}

impl Deserialize for Url {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<Url, DeserializeError> {
        let str = d.deserialize_string()?;
        return match Url::from_str(str) {
            Ok(url) => Result::Ok(url),
            Err(e) => Result::Err(DeserializeError::invalid_value(`invalid URL: ${e}`)),
        };
    }
}
