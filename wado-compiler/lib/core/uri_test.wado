use { Uri, UriError, UriReference } from "core:uri";
use { HashMap } from "core:collections";
use { from_string, to_string } from "core:json";

fn uri(text: String) -> Uri {
    return Uri::from_str(text).unwrap();
}

fn reference(text: String) -> UriReference {
    return UriReference::from_str(text).unwrap();
}

fn resolved(r: String) -> String {
    return uri("http://a/b/c/d;p?q").resolve(&reference(r)).to_string();
}

test "a URI has a scheme, and a reference need not" {
    assert reference("../x").to_string() == "../x";
    let e = Uri::from_str("../x").unwrap_err();
    assert e.offset == 0;
    assert e.message == "a URI must have a scheme";
    assert Uri::from_str("a b") matches { Err(UriError { offset: 1, .. }) };
}

test "a reference writes back as it was read" {
    for let text of [
        "http://user@example.com:8080/a/b?q=1#frag", "urn:uuid:deadbeef-1234-ffff-ffff-4321feebdaed",
        "urn:example:weather?=op=map&lat=39.56&lon=-104.85&datetime=1969-07-21T02:56:15Z", "file:///c:/folder/file.json",
        "http://[::1]:80/", "mailto:a@b.c", "#/$defs/a%25b", "?", "#", "", "../x", "//host",
    ] as List<String> {
        assert reference(text).to_string() == text;
    }
}

test "the scheme is folded to lowercase" {
    assert uri("HTTP://a/B").to_string() == "http://a/B";
}

test "a fragment is read apart from the rest" {
    assert uri("http://a/b#c").fragment() matches { Some("c") };
    assert uri("http://a/b#").fragment() matches { Some("") };
    assert uri("http://a/b").fragment() matches { None };
    assert uri("http://a/b?q#c").without_fragment().to_string() == "http://a/b?q";
}

test "the normal examples of RFC 3986 section 5.4.1" {
    assert resolved("g:h") == "g:h";
    assert resolved("g") == "http://a/b/c/g";
    assert resolved("./g") == "http://a/b/c/g";
    assert resolved("g/") == "http://a/b/c/g/";
    assert resolved("/g") == "http://a/g";
    assert resolved("//g") == "http://g";
    assert resolved("?y") == "http://a/b/c/d;p?y";
    assert resolved("?") == "http://a/b/c/d;p?";
    assert resolved("g?y") == "http://a/b/c/g?y";
    assert resolved("#s") == "http://a/b/c/d;p?q#s";
    assert resolved("g#s") == "http://a/b/c/g#s";
    assert resolved("g?y#s") == "http://a/b/c/g?y#s";
    assert resolved(";x") == "http://a/b/c/;x";
    assert resolved("g;x") == "http://a/b/c/g;x";
    assert resolved("g;x?y#s") == "http://a/b/c/g;x?y#s";
    assert resolved("") == "http://a/b/c/d;p?q";
    assert resolved(".") == "http://a/b/c/";
    assert resolved("./") == "http://a/b/c/";
    assert resolved("..") == "http://a/b/";
    assert resolved("../") == "http://a/b/";
    assert resolved("../g") == "http://a/b/g";
    assert resolved("../..") == "http://a/";
    assert resolved("../../") == "http://a/";
    assert resolved("../../g") == "http://a/g";
}

test "the abnormal examples of RFC 3986 section 5.4.2" {
    assert resolved("../../../g") == "http://a/g";
    assert resolved("../../../../g") == "http://a/g";
    assert resolved("/./g") == "http://a/g";
    assert resolved("/../g") == "http://a/g";
    assert resolved("g.") == "http://a/b/c/g.";
    assert resolved(".g") == "http://a/b/c/.g";
    assert resolved("g..") == "http://a/b/c/g..";
    assert resolved("..g") == "http://a/b/c/..g";
    assert resolved("./../g") == "http://a/b/g";
    assert resolved("./g/.") == "http://a/b/c/g/";
    assert resolved("g/./h") == "http://a/b/c/g/h";
    assert resolved("g/../h") == "http://a/b/c/h";
    assert resolved("g;x=1/./y") == "http://a/b/c/g;x=1/y";
    assert resolved("g;x=1/../y") == "http://a/b/c/y";
    assert resolved("g?y/./x") == "http://a/b/c/g?y/./x";
    assert resolved("g?y/../x") == "http://a/b/c/g?y/../x";
    assert resolved("g#s/./x") == "http://a/b/c/g#s/./x";
    assert resolved("g#s/../x") == "http://a/b/c/g#s/../x";
    assert resolved("http:g") == "http:g";
}

test "a base with an authority and an empty path merges under the root" {
    assert uri("http://a").resolve(&reference("b")).to_string() == "http://a/b";
}

test "a base path with no slash gives way to the reference's whole path" {
    let base = uri("urn:x");
    assert base.resolve(&reference("y")).to_string() == "urn:y";
    assert base.resolve(&reference("../g")).to_string() == "urn:g";
    assert base.resolve(&reference("./g")).to_string() == "urn:g";
    assert base.resolve(&reference(".")).to_string() == "urn:";
}

test "a path resolved to start with two slashes keeps them out of the authority" {
    let r = uri("foo:").resolve(&reference("/.//bar"));
    assert r.to_string() == "foo:/.//bar";
    assert uri(r.to_string()) == r;
}

test "an IP literal is an IPv6 address or an IPvFuture" {
    for let text of [
        "http://[::1]/", "http://[::]/", "http://[1:2:3:4:5:6:7:8]/", "http://[1::8]/", "http://[2001:db8::7]/",
        "http://[::ffff:192.0.2.1]/", "http://[1:2:3:4:5:6:1.2.3.4]/", "http://[v1.fe:x]/", "http://[V1F.a]/",
    ] as List<String> {
        assert Uri::from_str(text) matches { Ok(_) }, text;
    }
    for let text of [
        "http://[]/", "http://[zz]/", "http://[v.]/", "http://[v1.]/", "http://[1:2:3:4:5:6:7:8:9]/",
        "http://[1:2:3:4:5:6:7]/", "http://[1::2::3]/", "http://[12345::]/", "http://[:1::]/", "http://[1::2:]/",
        "http://[::1.2.3]/", "http://[::256.0.0.1]/", "http://[::01.2.3.4]/", "http://[1.2.3.4::]/",
        "http://[::zz:1.2.3.4]/", "http://[zz:2:3:4:5:6:1.2.3.4]/",
    ] as List<String> {
        assert Uri::from_str(text).unwrap_err().message == "invalid IP literal", text;
    }
}

test "a base without an authority merges into its path" {
    let base = uri("urn:uuid:deadbeef");
    assert base.resolve(&reference("#/$defs/a")).to_string() == "urn:uuid:deadbeef#/$defs/a";
    assert uri("file:///folder/file.json").resolve(&reference("#foo")).to_string() == "file:///folder/file.json#foo";
}

test "text outside the grammar is an error at its offset" {
    for let [text, offset] of [
        ["a b", 1],
        ["http://a/%zz", 9],
        ["http://a/%2", 9],
        ["1http:x", 0],
        ["a b:x", 1],
        [":x", 0],
        ["a?b c", 3],
        ["http://a b@c/", 8],
        ["http://a b/", 8],
        ["http://[a%b]/", 7],
        ["http://[::1]x/", 12],
        ["a#b#c", 3],
        ["http://a:8x/", 10],
        ["http://[::1/", 7],
        ["http://a/é", 9],
        ["%", 0],
    ] as List<[String, i32]> {
        assert UriReference::from_str(text).unwrap_err().offset == offset, text;
    }
    assert `${UriReference::from_str("a b").unwrap_err()}` == "invalid character in path at offset 1";
}

test "a URI or a reference keys a map by its components" {
    let mut names = HashMap::<Uri, i32>::new();
    names[uri("http://a/b")] = 1;
    assert names.get(uri("http://a/b")) matches { Some(1) };
    assert names.get(uri("http://a/b#")) matches { None };
    assert uri("HTTP://a/b") == uri("http://a/b");
    let mut refs = HashMap::<UriReference, i32>::new();
    refs[reference("../b")] = 1;
    assert refs.get(reference("../b")) matches { Some(1) };
}

test "a URI or a reference goes over the wire as its text" {
    assert to_string(&uri("HTTP://a/b#c")).unwrap() == #""http://a/b#c""#;
    assert from_string::<Uri>(#""../x""#).unwrap_err().message == "invalid URI: a URI must have a scheme at offset 0";
    assert to_string(&reference("../x")).unwrap() == #""../x""#;
    assert from_string::<UriReference>(#""../x""#).unwrap() == reference("../x");
    assert from_string::<UriReference>(#""a b""#).unwrap_err().message == "invalid URI reference: invalid character in path at offset 1";
    assert from_string::<UriReference>("1") matches { Err(_) };
}
