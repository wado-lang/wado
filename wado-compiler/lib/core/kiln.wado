#![stdlib("core:kiln")]
//! Kiln stdlib entry point.
//!
//! Import the user-facing Kiln types and the `KilnHost` effect via
//! `use { ... } from "core:kiln"`. This facade re-exports the WIT-generated
//! submodules under `lib/core/kiln/` and adds the Wado-only `Request<T>`
//! wrapper that generator authors write against.
//!
//! See WEP 2026-04-12 (Kiln) §"The generator contract" and §"Options are a
//! typed argument in each generator's own world".


use { Deserialize } from "core:serde";
use { Error as CoreError } from "core:prelude/traits.wado";

pub use { KilnHost, Diagnostic, DiagnosticLevel, SourceSpan } from "core:kiln/kiln_host.wado";

pub use { InputFile, OutputFile, Response, Error } from "core:kiln/types.wado";

/// Placed here rather than beside the type: `kiln/types.wado` is generated
/// from WIT, so a hand-written impl there would not survive regeneration.
impl Display for Error {
    fn fmt(&self, f: &mut Formatter) {
        let message: String = match *self {
            InvalidSchema(m) => `invalid schema: ${m}`,
            Unsupported(m) => `unsupported: ${m}`,
            Other(m) => m,
        };
        f.write_str(&message);
    }
}

impl CoreError for Error {
}

/// How many bytes each `read` asks for while draining an input. Large enough
/// that a schema-sized file costs a handful of reads, small enough that the
/// guest never holds a second copy of anything big.
global READ_CHUNK: i32 = 65536;

/// Read an input file's content to the end. A generator that needs the whole
/// file calls this; one that needs a prefix reads `content` itself and drops
/// it early.
pub fn read_all(content: Stream<u8>) -> ByteList {
    let mut out = List::<u8>::with_capacity(READ_CHUNK);
    loop {
        let chunk = content.read(READ_CHUNK);
        out.extend(&chunk.items);
        if chunk.result != CopyResult::Completed {
            break;
        }
    }
    content.drop();
    return out as ByteList;
}

fn decode_to_end(content: &Stream<u8>) -> Result<String, Utf8Error> {
    let mut out = String::with_capacity(READ_CHUNK);
    let mut pending: List<u8> = [];
    loop {
        let chunk = content.read(READ_CHUNK);
        pending.extend(&chunk.items);
        let pending_at = out.len();
        let taken = out.push_utf8(&(pending as ByteList)).map_err(|e| e.rebased(pending_at))?;
        pending = pending.as_slice().slice(taken, pending.len()).to_list();
        assert pending.len() <= 3;
        if chunk.result != CopyResult::Completed {
            break;
        }
    }
    if !pending.is_empty() {
        return Result::Err(Utf8Error::incomplete(out.len()));
    }
    return Result::Ok(out);
}

/// Read an input file's content to the end as text, decoding as it goes so no
/// second copy of the file exists. `Err` is a malformed input, not a bug.
pub fn read_text(content: Stream<u8>) -> Result<String, Utf8Error> {
    // A `Stream` handle is outside the compiler's drop elaboration. The decode
    // borrows it, so no early return can leave this body before the drop.
    let decoded = decode_to_end(&content);
    content.drop();
    return decoded;
}

/// The options type of a generator that takes no configuration. It is the
/// default type argument of `Request`, so a generator with no `Options`
/// struct writes `fn generate(req: Request)` and never mentions options.
/// Its CBOR wire form is the empty map, which decodes back into `NoOptions`.
pub struct NoOptions {
}

impl Deserialize for NoOptions;

/// The typed request a Kiln generator receives. Generator authors write
/// `export fn generate(req: Request<Options>) -> Result<Response, Error>`
/// (or `Request` for a no-options generator).
///
/// `Request<T>` is Wado-only sugar and never crosses the WIT boundary as a
/// single record: a generic cannot be expressed in a fixed WIT world (that is
/// why generators do not share one world). The compiler rewrites
/// `fn generate(req: Request<T>)` into flat, typed parameters
/// `(primary: InputFile, inputs: List<InputFile>, module: String, options: T)` in the
/// generator's own synthesized world, then rebinds them into a `Request<T>`
/// value so the author's body sees `req` unchanged. `options` crosses as a
/// typed WIT argument, not a serialized blob. The `#[compiler_item("kiln_request")]`
/// attribute is that rewrite's lookup anchor. `T` defaults to `NoOptions`, so
/// a generator that takes no options writes `fn generate(req: Request)`.
/// See WEP 2026-04-12 §"Options are a typed argument in each generator's own world".
#[compiler_item("kiln_request")]
pub struct Request<T = NoOptions> {
    pub primary: InputFile,
    pub inputs: List<InputFile>,
    /// How the use site named this generator: its `module:` specifier as
    /// written, or for a path, that path from the project root.
    pub module: String,
    pub options: T,
}
