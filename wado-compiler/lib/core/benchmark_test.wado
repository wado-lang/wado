use { Benchmark, format_rate } from "core:benchmark";

test "Benchmark literal defaults" {
    let b = Benchmark { name: "smoke" };
    assert b.iterations == 0;
    assert b.target_ms == 1000;
    assert b.warmup == -1;
    assert b.input_size matches { None };
    assert b.work_per_iter matches { None };
    assert b.unit == "ops";
}

test "format_rate falls back to ops/s" {
    // 10 ops over 2 s → 5 ops/s.
    assert format_rate(10.0, 2_000_000_000, "ops") == "5.00 ops/s";
}

test "format_rate scales custom units with SI prefixes" {
    // 3,000,000 numbers over 1 s → 3.00 M numbers/s.
    assert format_rate(3_000_000.0, 1_000_000_000, "numbers") == "3.00 M numbers/s";
    // 6,000 conversions over 1 s → 6.00 k conversions/s.
    assert format_rate(6_000.0, 1_000_000_000, "conversions") == "6.00 k conversions/s";
    // 2,000,000,000 px over 1 s → 2.00 G px/s.
    assert format_rate(2_000_000_000.0, 1_000_000_000, "px") == "2.00 G px/s";
}

test "format_rate scales the byte unit as KB/MB/GB" {
    assert format_rate(500.0, 1_000_000_000, "B") == "500.00 B/s";
    assert format_rate(50_000.0, 1_000_000_000, "B") == "50.00 KB/s";
    assert format_rate(7_000_000.0, 1_000_000_000, "B") == "7.00 MB/s";
    assert format_rate(4_000_000_000.0, 1_000_000_000, "B") == "4.00 GB/s";
}

test "format_rate guards against zero elapsed" {
    assert format_rate(1_000.0, 0, "ops") == "0.00 ops/s";
}

test "run returns the closure's value" {
    let mut b = Benchmark { name: "returns-value" };
    b.target_ms = 0;  // one calibration iteration, keeps the test fast
    let answer = b.run("", || 42);
    assert answer == 42;
}

test "auto mode runs a warmup plus at least one measured iteration" {
    let mut calls = 0;
    let mut b = Benchmark { name: "auto" };
    b.target_ms = 0;  // exactly one measured iteration after warmup
    let last = b.run("", || {
        calls += 1;
        return calls;
    });
    // 1 warmup + 1 measured = 2 invocations; the returned value is the last.
    assert calls == 2;
    assert last == 2;
}

test "negative target_ms is clamped to a single iteration" {
    // A stray negative budget must not wrap to a huge u64 and spin the loop;
    // it is clamped to 0, behaving like a single measured iteration.
    let mut calls = 0;
    let mut b = Benchmark { name: "neg-budget" };
    b.target_ms = -100;
    let last = b.run("", || {
        calls += 1;
        return calls;
    });
    assert calls == 2;
    assert last == 2;
}

test "iterations runs the closure N times and returns the last value" {
    let mut b = Benchmark { name: "iter-last" };
    b.iterations = 5;
    let last = b.run("", || 7 * 3);
    assert last == 21;
}

test "phase labels are accepted and value flows through" {
    let mut b = Benchmark { name: "phases" };
    b.iterations = 2;
    let a = b.run("first", || 1);
    let c = b.run("second", || 2);
    assert a == 1;
    assert c == 2;
}

test "input_size and explicit warmup do not affect the return value" {
    let mut b = Benchmark { name: "with-config" };
    b.iterations = 3;
    b.warmup = 1;
    b.input_size = Option::Some(1024);
    let v = b.run("", || -5);
    assert v == -5;
}

test "println does not affect benchmark state" {
    let mut b = Benchmark { name: "with-note" };
    b.target_ms = 0;
    b.println("note before run");
    let v = b.run("", || 99);
    b.println(`v = {v}`);
    assert v == 99;
}

test "warmup auto-derives to 0 for fixed single iteration" {
    let mut b = Benchmark { name: "auto-warmup-single" };
    b.iterations = 1;  // fixed mode, single iteration
    // warmup=-1 (auto) → effective warmup is 0 because iterations < 2;
    // surface this through the field invariants the API guarantees.
    assert b.iterations == 1;
    assert b.warmup == -1;
}
