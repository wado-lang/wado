use { println, eprintln, print, eprint, print_bytes, args, program_name, cwd, env } from "core:cli";
use { Stdout, Stderr } from "core:cli";
use { ErrorCode } from "wasi:cli";
use { eval, Status } from "core:eval";

// Captures what the helpers write. `write_via_stream` records which of the two
// streams the next write belongs to, since one handler answers for both. It
// keeps each future's writable end for `end_writes`: a handler runs only until
// its `resume`, and a write inside it would block on a reader nobody runs.
affine struct MockStdio {
    to_stderr: bool = false,
    out: List<u8> = [],
    err: List<u8> = [],
    ends: List<FutureWritable<Result<(), ErrorCode>>> = [],
}

impl MockStdio {
    fn stdout_text(&self) -> String {
        return String::from_utf8_lossy(self.out as ByteList);
    }

    fn stderr_text(&self) -> String {
        return String::from_utf8_lossy(self.err as ByteList);
    }

    /// Ends each future a write handed out, since an end dropped unwritten traps.
    fn end_writes(&mut self) {
        while let Some(end) = self.ends.pop() {
            end.write(Result::Ok(()));
        }
    }

    fn written(&mut self, to_stderr: bool) -> Future<Result<(), ErrorCode>> {
        self.to_stderr = to_stderr;
        let [future, end] = Future::<Result<(), ErrorCode>>::new();
        self.ends.push(end);
        return future;
    }
}

impl Stdout for MockStdio {
    fn write_via_stream(&mut self, data: Stream<u8>) -> Future<Result<(), ErrorCode>> {
        resume self.written(false);
    }
}

impl Stderr for MockStdio {
    fn write_via_stream(&mut self, data: Stream<u8>) -> Future<Result<(), ErrorCode>> {
        resume self.written(true);
    }
}

impl StreamWritable<u8> for MockStdio {
    fn write(&mut self, this: &StreamWritable<u8>, data: List<u8>) -> StreamWrite<u8> {
        if self.to_stderr {
            self.err.extend(&data);
        } else {
            self.out.extend(&data);
        }
        resume StreamWrite { rest: [], result: CopyResult::Completed };
    }

    fn write_raw_all(&mut self, this: &StreamWritable<u8>, data: Slice<u8>) -> CopyResult {
        if self.to_stderr {
            self.err.extend_from_slice(data);
        } else {
            self.out.extend_from_slice(data);
        }
        resume CopyResult::Completed;
    }

    fn drop(&mut self, this: &StreamWritable<u8>) {
        resume ();
    }

    ..trap
}

test "println ends a line and print does not" {
    let mut io = MockStdio {};
    with &mut io do {
        print("one");
        print(" two");
        println("");
        println("three");
    };
    io.end_writes();
    assert io.stdout_text() == "one two\nthree\n";
}

test "eprintln writes to stderr, leaving stdout empty" {
    let mut io = MockStdio {};
    with &mut io do {
        eprint("warn");
        eprintln(": disk full");
    };
    io.end_writes();
    assert io.stderr_text() == "warn: disk full\n";
    assert io.out.is_empty();
}

test "the two streams stay apart" {
    let mut io = MockStdio {};
    with &mut io do {
        println("out");
        eprintln("err");
    };
    io.end_writes();
    assert io.stdout_text() == "out\n";
    assert io.stderr_text() == "err\n";
}

test "print_bytes writes the bytes as given" {
    let mut io = MockStdio {};
    with &mut io do {
        print_bytes([0x89, 0x50, 0x4E, 0x47]);
    };
    io.end_writes();
    assert io.out == [0x89, 0x50, 0x4E, 0x47] as List<u8>;
}

// A name no environment sets, so the answer is the absent one either way.
test "env answers None for a name nothing sets" {
    assert env("WADO_CLI_TEST_UNSET_0f3a9c") matches { None };
}

test "the program name is this file, and args holds nothing after it" {
    assert program_name() matches { Some(p) && p.ends_with("cli_test.wado") };
    assert args().is_empty();
}

test "cwd answers without trapping" {
    let _ = cwd();
}

// An exit never returns, so only a host that runs the program sees its status.
fn exit_status(call: String) -> Status {
    return eval(`use { exit, exit_error, exit_success, Exit } from "core:cli";
export fn run() with Exit { ${call}; }`).unwrap().status;
}

test "each exit helper hands the host its status" {
    assert exit_status("exit_success()") matches { Exited(0) };
    assert exit_status("exit_error()") matches { Exited(1) };
    assert exit_status("exit(3)") matches { Exited(3) };
}
