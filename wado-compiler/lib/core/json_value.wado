#![stdlib("core:json_value")]
//! Dynamically-typed JSON value type.
//!
//! Represents any JSON value: null, boolean, number (as f64), string,
//! array, or object. Implements `Serialize` and `Deserialize` so it
//! works transparently with `core:json`'s `to_string` / `from_string`.
//!
//! Usage:
//!   use { Value } from "core:json_value";
//!   use { to_string, from_string } from "core:json";
//!
//!   let v = from_string::<Value>(`{"x": 1, "y": [true, null]}`);
//!   let s = to_string::<Value>(&v);


use {
    Serialize,
    Deserialize,
    Serializer,
    Deserializer,
    DeserializeSeq,
    DeserializeMap,
    SerializeError,
    DeserializeError,
    Visitor,
} from "core:serde";

use { TreeMap } from "core:collections";

/// A dynamically-typed JSON value, analogous to serde_json::Value.
pub variant Value {
    Null,
    Bool(bool),
    Number(f64),
    String(String),
    List(List<Value>),
    Object(TreeMap<String, Value>),
}

impl Eq for Value {
    fn eq(&self, other: &Value) -> bool {
        return match [*self, *other] {
            [Null, Null] => true,
            [Bool(a), Bool(b)] => a == b,
            [Number(a), Number(b)] => a == b,
            [String(a), String(b)] => a == b,
            [List(a), List(b)] => {
                if a.len() != b.len() {
                    return false;
                }
                let mut i = 0;
                while i < a.len() {
                    if !(a[i] == b[i]) {
                        return false;
                    }
                    i += 1;
                }
                true;
            },
            [Object(a), Object(b)] => {
                if a.len() != b.len() {
                    return false;
                }
                for let [k, v] of a.entries() {
                    if let Some(other_v) = b.get(k) {
                        if !(v == other_v) {
                            return false;
                        }
                    } else {
                        return false;
                    }
                }
                true;
            },
            _ => false,
        };
    }
}

impl Serialize for Value {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return match self {
            Null => s.serialize_null(),
            Bool(b) => s.serialize_bool(*b),
            Number(n) => s.serialize_f64(*n),
            String(str_val) => s.serialize_string(str_val),
            List(arr) => {
                let seq = s.begin_seq(arr.len())?;
                for let item of *arr {
                    seq.element(&item)?;
                }
                seq.end();
            },
            Object(map) => {
                let m = s.begin_map(map.len())?;
                for let [key, val] of map.entries() {
                    m.key(&key)?;
                    m.value(&val)?;
                }
                m.end();
            },
        };
    }
}

struct ValueVisitor {
}

impl Visitor for ValueVisitor {
    type Value = Value;

    fn visit_null(&mut self) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::Null);
    }

    fn visit_bool(&mut self, v: bool) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::Bool(v));
    }

    fn visit_f64(&mut self, v: f64) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::Number(v));
    }

    fn visit_string(&mut self, v: String) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::String(v));
    }

    fn visit_seq<A: DeserializeSeq>(&mut self, seq: &mut A) -> Result<Value, DeserializeError> {
        let mut items: List<Value> = [];
        loop {
            let next_opt = seq.next_element::<Value>()?;
            match next_opt {
                Some(item) => {
                    items.push(item);
                },
                None => {
                    seq.end()?;
                    return Result::Ok(Value::List(items));
                },
            }
        }
    }

    fn visit_map<A: DeserializeMap>(&mut self, map: &mut A) -> Result<Value, DeserializeError> {
        let mut obj: TreeMap<String, Value> = TreeMap::new();
        loop {
            match map.next_key_string()? {
                Some(key) => {
                    obj[key] = map.next_value::<Value>()?;
                },
                None => {
                    map.end()?;
                    return Result::Ok(Value::Object(obj));
                },
            }
        }
    }
}

impl Inspect for Value {
    pub fn inspect(&self, f: &mut Formatter) {
        match self {
            Null => f.write_str(&"null"),
            Bool(b) => f.write_str(&if *b { "true" } else { "false" }),
            Number(n) => (*n).inspect(f),
            String(s) => (*s).inspect(f),
            List(arr) => {
                f.write_char('[');
                for let mut i = 0; i < arr.len(); i += 1 {
                    if i > 0 {
                        f.write_str(&", ");
                    }
                    arr[i].inspect(f);
                }
                f.write_char(']');
            },
            Object(map) => {
                f.write_char('{');
                let mut first = true;
                for let [k, v] of map.entries() {
                    if !first {
                        f.write_str(&", ");
                    }
                    first = false;
                    k.inspect(f);
                    f.write_str(&": ");
                    v.inspect(f);
                }
                f.write_char('}');
            },
        }
    }
}

impl InspectAlt for Value {
    pub fn inspect_alt(&self, f: &mut Formatter) {
        match self {
            Null => f.write_str(&"null"),
            Bool(b) => f.write_str(&if *b { "true" } else { "false" }),
            Number(n) => (*n).inspect_alt(f),
            String(s) => (*s).inspect_alt(f),
            List(arr) => {
                if arr.is_empty() {
                    f.write_str(&"[]");
                    return;
                }
                f.open_brace("[");
                for let mut i = 0; i < arr.len(); i += 1 {
                    f.write_newline_indent();
                    arr[i].inspect_alt(f);
                    f.write_char(',');
                }
                f.close_brace("]");
            },
            Object(map) => {
                if map.is_empty() {
                    f.write_str(&"{}");
                    return;
                }
                f.open_brace("{");
                for let [k, v] of map.entries() {
                    f.write_newline_indent();
                    k.inspect_alt(f);
                    f.write_str(&": ");
                    v.inspect_alt(f);
                    f.write_char(',');
                }
                f.close_brace("}");
            },
        }
    }
}

impl Deserialize for Value {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<Value, DeserializeError> {
        let mut visitor = ValueVisitor {};
        return d.deserialize_any::<ValueVisitor>(&mut visitor);
    }
}
