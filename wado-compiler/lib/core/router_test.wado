    let mut r = Router::<i32>::new();
    r.get("/foo/", 1);
}


#[expect_trap]
test "router: panic on doubled slash in pattern" {
    let mut r = Router::<i32>::new();
    r.get("/a//b", 1);
}


#[expect_trap]
test "router: panic on conflicting param names at same node" {
    let mut r = Router::<i32>::new();
    r.get("/users/:id", 1);
    r.get("/users/:name/profile", 2);
}


#[expect_trap]
test "router: panic on conflicting wildcard names at same node" {
    let mut r = Router::<i32>::new();
    r.get("/static/*path", 1);
    r.post("/static/*tail", 2);
}

struct GetUserParams {
    id: u64,
}
impl Deserialize for GetUserParams;

struct PostParams {
    user_id: i32,
    post_id: u32,
}
impl Deserialize for PostParams;

struct StaticOnly {
}
impl Deserialize for StaticOnly;

struct StringParam {
    slug: String,
}
impl Deserialize for StringParam;

struct InnerParam {
    id: u64,
}
impl Deserialize for InnerParam;

struct NestedParam {
    inner: InnerParam,
}
impl Deserialize for NestedParam;

struct UuidParam {
    id: Uuid,
}
impl Deserialize for UuidParam;

struct InstantParam {
    at: Instant,
}
impl Deserialize for InstantParam;

struct FlagParams {
    on: bool,
    grade: char,
}
impl Deserialize for FlagParams;

struct HalfParams {
    scale: f16,
    gain: bf16,
}
impl Deserialize for HalfParams;

test "router: deserialize a half param rounds its text once" {
    let mut r = Router::<i32>::new();
    r.get("/mix/:scale/:gain", 1);

    let m = r.match_path(Method::Get, &"/mix/1.00048828125000000000000001/1.00390625000000000000000001").unwrap();
    let p = m.params.deserialize::<HalfParams>().unwrap();
    assert p.scale.to_bits() == 0x3c01;
    assert p.gain.to_bits() == 0x3f81;
}

test "router: deserialize a param type that asks for any" {
    let mut r = Router::<i32>::new();
    r.get("/users/:id", 1);
    r.get("/events/:at", 2);

    let m = r.match_path(Method::Get, &"/users/00010203-0405-4607-8809-0a0b0c0d0e0f").unwrap();
    let p = m.params.deserialize::<UuidParam>().unwrap();
    assert p.id.to_string() == "00010203-0405-4607-8809-0a0b0c0d0e0f";

    let e = r.match_path(Method::Get, &"/events/2026-08-21T00:00:00Z").unwrap();
    let q = e.params.deserialize::<InstantParam>().unwrap();
    assert q.at.seconds == 1787270400;
}

test "router: deserialize rejects a malformed any-shaped param" {
    let mut r = Router::<i32>::new();
    r.get("/users/:id", 1);

    let m = r.match_path(Method::Get, &"/users/nope").unwrap();
    assert m.params.deserialize::<UuidParam>() matches { Err(_) };
}

test "router: deserialize params into struct" {
    let mut r = Router::<i32>::new();
    r.get("/users/:id", 1);

    let m = r.match_path(Method::Get, &"/users/42").unwrap();
    let p = m.params.deserialize::<GetUserParams>().unwrap();
    assert p.id == 42_u64;
}

test "router: deserialize multiple snake_case params" {
    let mut r = Router::<i32>::new();
    // Path parameter names are matched against the Wado source field names
    // verbatim (identity), so multi-word `:user_id` binds to field `user_id`.
    r.get("/users/:user_id/posts/:post_id", 1);

    let m = r.match_path(Method::Get, &"/users/7/posts/99").unwrap();
    let p = m.params.deserialize::<PostParams>().unwrap();
    assert p.user_id == 7;
    assert p.post_id == 99_u32;
}

test "router: deserialize string param" {
    let mut r = Router::<i32>::new();
    r.get("/articles/:slug", 1);

    let m = r.match_path(Method::Get, &"/articles/hello-world").unwrap();
    let p = m.params.deserialize::<StringParam>().unwrap();
    assert p.slug == "hello-world";
}

test "router: deserialize empty params on static route" {
    let mut r = Router::<i32>::new();
    r.get("/health", 1);

    let m = r.match_path(Method::Get, &"/health").unwrap();
    assert m.params.is_empty();
    // Deserialize into an empty struct must succeed without scanning any
    // ranges (cursor stays at 0).
    assert m.params.deserialize::<StaticOnly>() matches { Ok(_) };
}

test "router: deserialize fails on invalid integer" {
    let mut r = Router::<i32>::new();
    r.get("/users/:id", 1);

    let m = r.match_path(Method::Get, &"/users/notanumber").unwrap();
    let result: Result<GetUserParams, DeserializeError> = m.params.deserialize();
    assert result matches { Err(e) && e.kind == DeserializeErrorKind::InvalidValue };
    assert `${result.unwrap_err()}`.starts_with(
        "path param 'id' is not a valid u64: 'notanumber' (invalid digit found in string)",
    );
}

test "router: deserialize bool and char params" {
    let mut r = Router::<i32>::new();
    r.get("/flags/:on/:grade", 1);

    let m = r.match_path(Method::Get, &"/flags/true/A").unwrap();
    let p = m.params.deserialize::<FlagParams>().unwrap();
    assert p.on == true;
    assert p.grade == 'A';

    let multibyte = r.match_path(Method::Get, &"/flags/false/あ").unwrap();
    let q = multibyte.params.deserialize::<FlagParams>().unwrap();
    assert q.on == false;
    assert q.grade == 'あ';
}

test "router: deserialize fails on a bool or char param it cannot parse" {
    let mut r = Router::<i32>::new();
    r.get("/flags/:on/:grade", 1);

    let bad_bool = r.match_path(Method::Get, &"/flags/TRUE/A").unwrap();
    let e: Result<FlagParams, DeserializeError> = bad_bool.params.deserialize();
    assert `${e.unwrap_err()}`.starts_with(
        "path param 'on' is not a valid bool: 'TRUE' (provided string was not `true` or `false`)",
    );

    let long_char = r.match_path(Method::Get, &"/flags/true/AB").unwrap();
    let f: Result<FlagParams, DeserializeError> = long_char.params.deserialize();
    assert `${f.unwrap_err()}`.starts_with(
        "path param 'grade' is not a valid char: 'AB' (too many characters in string)",
    );
}

test "router: params.get returns Option" {
    let mut r = Router::<i32>::new();
    r.get("/users/:id", 1);

    let m = r.match_path(Method::Get, &"/users/abc").unwrap();
    assert m.params.get("id") matches { Some(v) && v == "abc" };
    assert m.params.get("missing") matches { None };
}

test "router: deserialize rejects nested struct field" {
    let mut r = Router::<i32>::new();
    r.get("/items/:inner", 1);

    let m = r.match_path(Method::Get, &"/items/42").unwrap();
    let result: Result<NestedParam, DeserializeError> = m.params.deserialize();
    assert result matches { Err(e) && e.kind == DeserializeErrorKind::UnexpectedType };
}

test "router: params index by name (IndexValue)" {
    let mut r = Router::<i32>::new();
    r.get("/users/:id/posts/:pid", 1);

    let m = r.match_path(Method::Get, &"/users/42/posts/9").unwrap();
    assert m.params["id"] == "42";
    assert m.params["pid"] == "9";
    assert m.params.len() == 2;
}

#[expect_trap]
test "router: indexing a missing param panics" {
    let mut r = Router::<i32>::new();
    r.get("/users/:id", 1);
    let _ = r.match_path(Method::Get, &"/users/42").unwrap().params["missing"];
}

struct WideParams {
    a: i64,
    b: u128,
    c: i128,
    d: f32,
    e: f64,
    f: Option<i32>,
}
impl Deserialize for WideParams;

test "router: deserialize every numeric param type" {
    let mut r = Router::<i32>::new();
    r.get("/w/:a/:b/:c/:d/:e/:f", 1);
    let m = r.match_path(Method::Get, &"/w/-1/2/-3/1.5/2.5/6").unwrap();
    let p = m.params.deserialize::<WideParams>().unwrap();
    assert p.a == -1 && p.b == 2 && p.c == -3 && p.d == 1.5 && p.e == 2.5 && p.f == Option::Some(6);
}

test "router: deserialize skips a param the struct does not name" {
    let mut r = Router::<i32>::new();
    r.get("/users/:id/posts/:pid", 1);
    let m = r.match_path(Method::Get, &"/users/42/posts/9").unwrap();
    assert m.params.deserialize::<GetUserParams>() matches { Ok(p) && p.id == 42 };
}

struct ListParam {
    id: List<i32>,
}
impl Deserialize for ListParam;

struct MapParam {
    id: TreeMap<String, i32>,
}
impl Deserialize for MapParam;

struct VariantParam {
    id: Option<Result<i32, i32>>,
}
impl Deserialize for VariantParam;

test "router: deserialize rejects compound param types" {
    let mut r = Router::<i32>::new();
    r.get("/users/:id", 1);
    let m = r.match_path(Method::Get, &"/users/42").unwrap();
    assert m.params.deserialize::<ListParam>() matches { Err(e) && e.kind == DeserializeErrorKind::UnexpectedType };
    assert m.params.deserialize::<MapParam>() matches { Err(e) && e.kind == DeserializeErrorKind::UnexpectedType };
    assert m.params.deserialize::<VariantParam>() matches { Err(e) && e.kind == DeserializeErrorKind::UnexpectedType };
}

test "router: deserialize rejects a scalar root" {
    let mut r = Router::<i32>::new();
    r.get("/users/:id", 1);
    let m = r.match_path(Method::Get, &"/users/42").unwrap();
    assert m.params.deserialize::<u64>() matches { Err(e) && e.kind == DeserializeErrorKind::UnexpectedType };
    assert m.params.deserialize::<String>() matches { Err(e) && e.kind == DeserializeErrorKind::UnexpectedType };
    assert m.params.deserialize::<Uuid>() matches { Err(e) && e.kind == DeserializeErrorKind::UnexpectedType };
}

test "router: a path without a leading slash or with an empty segment" {
    let mut r = Router::<i32>::new();
    r.get("/users/:id", 1);
    assert r.match_path(Method::Get, &"users/42") matches { Some(m) && m.handler == 1 };
    assert r.match_path(Method::Get, &"/users//42") matches { None };
    assert r.allowed_methods("users/42") == [Method::Get];
    assert r.allowed_methods("/users//42").is_empty();
}

test "router: a wildcard or terminal that lacks the method" {
    let mut r = Router::<i32>::new();
    r.post("/files/*rest", 1);
    r.post("/users/:id", 2);
    r.put("/users/:id", 3);
    assert r.match_path(Method::Get, &"/files/a/b") matches { None };
    assert r.match_path(Method::Get, &"/files/") matches { None };
    assert r.match_path(Method::Get, &"/users/1") matches { None };
    assert r.match_path(Method::Put, &"/users/1") matches { Some(m) && m.handler == 3 };
    assert r.match_path(Method::Get, &"/users/") matches { None };
    assert r.allowed_methods("/files/a/b") == [Method::Post];
    assert r.allowed_methods("/files/") == [Method::Post];
    assert r.allowed_methods("/users/").is_empty();
}

test "router: re-registering a dynamic route" {
    let mut r = Router::<i32>::new();
    r.get("/a/:id/*rest", 1);
    r.post("/a/:id/*rest", 2);
    r.get("/a/:id/*rest", 3);
    r.get("/u/:id", 4);
    r.get("/u/:id", 5);
    r.any("/u/:id", 6);
    r.any("/s", 7);
    r.any("/s", 8);
    assert r.match_path(Method::Get, &"/a/1/x") matches { Some(m) && m.handler == 3 && m.params["rest"] == "x" };
    assert r.match_path(Method::Post, &"/a/1/x") matches { Some(m) && m.handler == 2 && m.params["id"] == "1" };
    assert r.match_path(Method::Get, &"/u/1") matches { Some(m) && m.handler == 5 };
    assert r.match_path(Method::Put, &"/u/1") matches { Some(m) && m.handler == 6 };
    assert r.match_path(Method::Put, &"/s") matches { Some(m) && m.handler == 8 };
}

test "router: match a wasi:http request, ignoring its query and fragment" {
    let mut r = Router::<i32>::new();
    r.get("/users/:id", 1);
    r.get("/", 2);
    let request = |path: Option<String>| {
        let [trailers, _tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
        let [req, _] = Request::new(Headers::new(), null, trailers, null);
        req.set_path_with_query(path);
        return req;
    };
    assert r.match_request(&request(Option::Some("/users/7?x=1"))) matches { Some(m) && m.params["id"] == "7" };
    assert r.match_request(&request(Option::Some("/users/8#top"))) matches { Some(m) && m.params["id"] == "8" };
    assert r.match_request(&request(Option::Some("/users/9"))) matches { Some(m) && m.params["id"] == "9" };
    assert r.match_request(&request(null)) matches { Some(m) && m.handler == 2 };
}
