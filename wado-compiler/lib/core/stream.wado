// Stream module - Component Model stream intrinsics and helpers
//
// This module provides low-level stream operations that map to Component Model
// canonical intrinsics. These are used to implement higher-level I/O functions.
//
// Note on String representation:
// - `String` and `Array<u8>` have the same Wasm-level representation: builtin::array<u8>
// - A String is a single reference value (not a ptr+len pair)
// - Use `builtin::array_len` to get the length of a String or Array

// ============================================================================
// Stream Intrinsics (wrappers around builtin::)
// ============================================================================

/// Create a new stream, returns i64 with rx in low 32 bits, tx in high 32 bits
pub fn stream_new() -> i64 {
    return builtin::stream_new();
}

/// Write bytes to stream from linear memory, returns status
pub fn stream_write(tx: i32, ptr: i32, len: i32) -> i32 {
    return builtin::stream_write(tx, ptr, len);
}

/// Close the writable end of the stream
pub fn stream_drop_writable(tx: i32) {
    builtin::stream_drop_writable(tx);
}

/// Close the readable end of the stream
pub fn stream_drop_readable(rx: i32) {
    builtin::stream_drop_readable(rx);
}

// ============================================================================
// Bit Manipulation (wrappers around builtin::)
// ============================================================================

/// Extract low 32 bits from i64
pub fn i64_low32(value: i64) -> i32 {
    return builtin::i64_low32(value);
}

/// Extract high 32 bits from i64
pub fn i64_high32(value: i64) -> i32 {
    return builtin::i64_high32(value);
}

// ============================================================================
// Array/String Intrinsics (wrappers around builtin::)
// ============================================================================

/// Get length of an array
/// Maps to Wasm GC `array.len` instruction
pub fn array_len<T>(arr: Array<T>) -> i32 {
    return builtin::array_len(arr);
}

/// Get length of a String in bytes (UTF-8)
/// Maps to Wasm GC `array.len` instruction
pub fn string_len(s: String) -> i32 {
    return builtin::array_len(s);
}

// ============================================================================
// Async Task Intrinsics (wrappers around builtin::)
// ============================================================================

/// Create a new waitable set for async task management
pub fn waitable_set_new() -> i32 {
    return builtin::waitable_set_new();
}

/// Join a subtask to a waitable set
pub fn waitable_join(set: i32, subtask: i32) {
    builtin::waitable_join(set, subtask);
}

/// Wait for events on a waitable set
pub fn waitable_set_wait(set: i32, out_addr: i32) -> i32 {
    return builtin::waitable_set_wait(set, out_addr);
}

/// Drop a subtask handle
pub fn subtask_drop(subtask: i32) {
    builtin::subtask_drop(subtask);
}

// ============================================================================
// Async Wait Helper
// ============================================================================

/// Wait for a write-via-stream subtask to complete if pending
/// This is used after calling Stdout::write_via_stream or similar effect functions
/// The subtask parameter is the return value from write-via-stream
/// Scratch memory address (2048) is used for waitable-set-wait output
pub fn wait_for_subtask(subtask: i32) {
    // Check if subtask is pending: (status & 1) == 0
    if builtin::i32_eqz(builtin::i32_and(subtask, 1)) {
        let waitable_set = builtin::waitable_set_new();
        builtin::waitable_join(waitable_set, subtask);
        builtin::waitable_set_wait(waitable_set, 2048);
        builtin::subtask_drop(subtask);
    }
}
