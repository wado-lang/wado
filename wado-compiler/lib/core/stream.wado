// Stream module - Component Model stream intrinsics and helpers
//
// This module provides low-level stream operations that map to Component Model
// canonical intrinsics. These are used to implement higher-level I/O functions.
//
// Note on String representation:
// - `String` and `Array<u8>` have the same Wasm-level representation: builtin::array<u8>
// - A String is a single reference value (not a ptr+len pair)
// - Use `builtin::array_len` to get the length of a String or Array
/// Creates a new stream, returning i64 with rx in low 32 bits, tx in high 32 bits.
pub fn stream_new() -> i64 {
    return builtin::stream_new();
}

/// Writes bytes to a stream from linear memory and returns the status.
pub fn stream_write(tx: i32, ptr: i32, len: i32) -> i32 {
    return builtin::stream_write(tx, ptr, len);
}

/// Closes the writable end of the stream.
pub fn stream_drop_writable(tx: i32) {
    builtin::stream_drop_writable(tx);
}

/// Closes the readable end of the stream.
pub fn stream_drop_readable(rx: i32) {
    builtin::stream_drop_readable(rx);
}

/// Returns the length of an array.
/// Maps to Wasm GC `array.len` instruction.
pub fn array_len<T>(arr: Array<T>) -> i32 {
    return builtin::array_len(arr);
}

/// Returns the length of a String in bytes (UTF-8).
/// Maps to Wasm GC `array.len` instruction.
pub fn string_len(s: String) -> i32 {
    return builtin::array_len(s);
}

/// Creates a new waitable set for async task management.
pub fn waitable_set_new() -> i32 {
    return builtin::waitable_set_new();
}

/// Joins a subtask to a waitable set.
pub fn waitable_join(set: i32, subtask: i32) {
    builtin::waitable_join(set, subtask);
}

/// Waits for events on a waitable set.
pub fn waitable_set_wait(set: i32, out_addr: i32) -> i32 {
    return builtin::waitable_set_wait(set, out_addr);
}

/// Drops a subtask handle.
pub fn subtask_drop(subtask: i32) {
    builtin::subtask_drop(subtask);
}
