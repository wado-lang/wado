#![stdlib("core:process")]
//! Run a host program as a child of the guest.
//!
//! A host offers spawning or not, and [`availability`] says which, with an
//! answer fixed for the guest's lifetime. Every other function requires it to
//! answer `Available`, and traps otherwise.
//!
//! ## Children
//!
//! - `program` holding a `/` is a path, relative to where the child starts.
//!   Any other is a name the host looks up.
//! - A child starts in the guest's first preopened directory, the one `core:fs`
//!   resolves paths against.
//! - A child's environment is what the host gives every child, with
//!   [`Command::env`] laid over it. The guest's own is never passed on.
//! - A child gets no stream of the guest's unless asked: stdin reads nothing,
//!   and stdout and stderr go nowhere. `inherit_*` passes on a stream the guest
//!   holds, so each declares that stream's effect.
//! - [`Child`] is `affine`. Dropping it, or [`Child::kill`], ends the child and
//!   every process it started, and the host ends every child when the guest
//!   exits, so none outlives the guest. [`Child::terminate`] asks instead, and
//!   the child may ignore it.
//! - A timeout is the guest's: [`Child::wait_timeout`] waits a bounded time,
//!   and [`Child::stop`] asks, waits a grace period, then kills.
//! - A child's output is bytes, so it comes back as a `ByteList`, never decoded.
//!
//! ## Errors
//!
//! [`ProcessError`] names the program, as `FsError` names its path. The host
//! reports why a child did not run as an [`ErrorCode`]. Only `read` fails on
//! how the child ended, since it returns stdout alone and has nowhere else to
//! report it: `output` and `status` return the [`ExitStatus`] as a value.
//!
//! ## The `wado` Host
//!
//! `wado run`, `wado serve` and `wado test` offer spawning, and confine each
//! child so that spawning never extends the guest's authority.
//!
//! - A child reads and writes only beneath the directories the guest was
//!   granted, plus a fixed system baseline: the loader, shared libraries,
//!   installed programs and the system configuration. It reaches the network
//!   only where the guest does.
//! - `--process-read <path>` lets a child read and execute `path` as well, and
//!   so does `read` under `[process]` in the user config. The guest itself
//!   gains nothing.
//! - `--deny-process` turns spawning off (`Denied`). A host whose OS cannot
//!   confine a child answers `Unsupported`: Linux needs Landlock ABI 6 (Linux
//!   6.12), and macOS confines through `sandbox-exec`.
//! - A name is looked up on the host's `PATH`, skipping empty and relative
//!   entries.
//! - Every child gets `PATH`, a private `HOME` and `TMPDIR` removed once it
//!   exits, `LANG` and `LC_*`, and `TERM` where it inherits a stream.
//! - `terminate` sends the child's process group `SIGTERM`, and `kill`
//!   `SIGKILL`.
//! - A child that fails after the sandbox refused it something is reported on
//!   `wado`'s stderr, with the grant that would allow it. `--process-trace`
//!   also names each file refused, on Linux.

use types from "core:process/types.wado";
use { Child as ChildResource, Input, Spawned } from "core:process/types.wado";
use { Stdin, Stdout, Stderr } from "wasi:cli";
use { Duration, MonotonicClock } from "wasi:clocks";

pub use { Process } from "core:process/process.wado";
pub use { Availability, ErrorCode, ExitStatus } from "core:process/types.wado";

#[synopsis]
test {
    if availability() != Availability::Available {
        return;
    }
    let out = cmd`echo hello`.read().unwrap();
    assert out == b"hello\n";
}

/// How many bytes `output` and `read` keep of each stream unless a
/// [`Command::capture_limit`] says otherwise.
pub global DEFAULT_CAPTURE_LIMIT: i32 = 64 << 20;

/// Whether this host spawns. The answer is fixed for the guest's lifetime.
pub fn availability() -> Availability with Process {
    return Process::get_availability();
}

/// Where one of a child's standard streams goes.
enum Stdio {
    Null,
    Inherit,
    Piped,
}

/// A program to run and how: its arguments, environment and streams.
/// `output` and `read` pipe what they read themselves.
pub struct Command {
    internal program: String,
    internal args: List<String>,
    env: List<[String, String]>,
    stdin: Stdio,
    stdout: Stdio,
    stderr: Stdio,
    capture_limit: i32,
}

impl Command {
    pub fn new(program: String) -> Command {
        return Command {
            program,
            args: [],
            env: [],
            stdin: Stdio::Null,
            stdout: Stdio::Null,
            stderr: Stdio::Null,
            capture_limit: DEFAULT_CAPTURE_LIMIT,
        };
    }

    pub fn arg(&self, arg: String) -> Command {
        let mut command = *self;
        command.args.push(arg);
        return command;
    }

    pub fn args(&self, args: List<String>) -> Command {
        let mut command = *self;
        command.args.extend(&args);
        return command;
    }

    /// Set `key` in the child's environment, over what the host gives it.
    pub fn env(&self, key: String, value: String) -> Command {
        let mut command = *self;
        command.env.push([key, value]);
        return command;
    }

    /// `spawn` hands the guest the child's stdin as `Child::stdin`.
    pub fn stdin_piped(&self) -> Command {
        let mut command = *self;
        command.stdin = Stdio::Piped;
        return command;
    }

    /// `spawn` hands the guest the child's stdout as `Child::stdout`.
    pub fn stdout_piped(&self) -> Command {
        let mut command = *self;
        command.stdout = Stdio::Piped;
        return command;
    }

    /// `spawn` hands the guest the child's stderr as `Child::stderr`.
    pub fn stderr_piped(&self) -> Command {
        let mut command = *self;
        command.stderr = Stdio::Piped;
        return command;
    }

    /// The child reads the guest's own stdin, which the guest passes on only
    /// where it holds it.
    pub fn inherit_stdin(&self) -> Command with Stdin {
        let mut command = *self;
        command.stdin = Stdio::Inherit;
        return command;
    }

    /// The child writes to the guest's own stdout.
    pub fn inherit_stdout(&self) -> Command with Stdout {
        let mut command = *self;
        command.stdout = Stdio::Inherit;
        return command;
    }

    /// The child writes to the guest's own stderr.
    pub fn inherit_stderr(&self) -> Command with Stderr {
        let mut command = *self;
        command.stderr = Stdio::Inherit;
        return command;
    }

    /// All three of the guest's own streams.
    pub fn inherit_stdio(&self) -> Command with (Stdin, Stdout, Stderr) {
        return self.inherit_stdin().inherit_stdout().inherit_stderr();
    }

    /// The bytes `output` and `read` keep of each stream. Past it, stderr
    /// keeps its tail, and stdout is an `OutputTooLarge` error, since output
    /// with its middle cut out is wrong rather than short: the child is
    /// killed the moment stdout passes it.
    pub fn capture_limit(&self, bytes: i32) -> Command
        contract bytes >= 0
    {
        let mut command = *self;
        command.capture_limit = bytes;
        return command;
    }

    /// Start the child and hand back its piped streams.
    pub fn spawn(&self) -> Result<Child, ProcessError> with Process {
        return self.start(self.stdin, self.stdout, self.stderr);
    }

    /// Run the child to its end, reading stdout and stderr together, so a
    /// child filling one pipe never blocks against a guest reading the other.
    pub fn output(&self) -> Result<Output, ProcessError> with Process {
        let limit = self.capture_limit;
        let mut child = self.start(unhanded(self.stdin), Stdio::Piped, Stdio::Piped)?;
        let captured = capture(&mut child, limit);
        let status = child.wait()?;
        if captured.too_large {
            return Result::Err(child_error(&self.program, ProcessErrorKind::OutputTooLarge));
        }
        return Result::Ok(Output { status, stdout: captured.stdout, stderr: captured.stderr });
    }

    /// Run the child to its end and return how it ended.
    pub fn status(&self) -> Result<ExitStatus, ProcessError> with Process {
        let child = self.start(unhanded(self.stdin), unhanded(self.stdout), unhanded(self.stderr))?;
        return child.wait();
    }

    /// Run the child to its end and return its stdout. Any end but
    /// `Exited(0)` is `Failed`, with the stderr read beside it.
    pub fn read(&self) -> Result<ByteList, ProcessError> with Process {
        let program = self.program;
        let out = self.output()?;
        if out.status != ExitStatus::Exited(0) {
            return Result::Err(child_error(&program, ProcessErrorKind::Failed([out.status, out.stderr])));
        }
        return Result::Ok(out.stdout);
    }

    fn start(&self, stdin: Stdio, out: Stdio, err: Stdio) -> Result<Child, ProcessError> with Process {
        let mut writer: Option<StreamWritable<u8>> = null;
        let input = match stdin {
            Null => Input::Null,
            Inherit => Input::Inherit,
            Piped => {
                let [rx, tx] = Stream::<u8>::new();
                writer = Option::Some(tx);
                Input::Piped(rx);
            },
        };
        let spec = types::Command {
            program: self.program,
            args: self.args,
            env: self.env,
            stdin: input,
            stdout: output_mode(out),
            stderr: output_mode(err),
        };
        let Spawned { child, stdout, stderr, exit } = match Process::spawn(spec, null) {
            Ok(spawned) => spawned,
            Err(code) => {
                return Result::Err(child_error(&self.program, ProcessErrorKind::Spawn(code)));
            },
        };
        return Result::Ok(Child {
            stdin: writer,
            stdout,
            stderr,
            program: self.program,
            exit: Option::Some(exit.start_read()),
            ended: null,
            resource: child,
        });
    }
}

/// `stdio` where the guest gets no `Child` to reach a pipe through, as under
/// `output` and `status`: a pipe nobody reads or writes would block the child.
fn unhanded(stdio: Stdio) -> Stdio {
    return match stdio {
        Piped => Stdio::Null,
        other => other,
    };
}

fn output_mode(stdio: Stdio) -> types::Output {
    return match stdio {
        Null => types::Output::Null,
        Inherit => types::Output::Inherit,
        Piped => types::Output::Piped,
    };
}

fn child_error(program: &String, kind: ProcessErrorKind) -> ProcessError {
    return ProcessError { program: *program, kind };
}

/// A running child.
pub affine struct Child {
    /// Where `Command::stdin_piped` asked for it. Dropping it closes the
    /// child's stdin.
    pub stdin: Option<StreamWritable<u8>>,
    /// Where `Command::stdout_piped` asked for it.
    pub stdout: Option<Stream<u8>>,
    /// Where `Command::stderr_piped` asked for it.
    pub stderr: Option<Stream<u8>>,
    program: String,
    /// The read of how the child ended, until `wait_timeout` sees it end.
    exit: Option<FutureReadCopy<Result<ExitStatus, ErrorCode>>>,
    /// How the child ended, once `wait_timeout` has seen it.
    ended: Option<Result<ExitStatus, ErrorCode>>,
    resource: ChildResource,
}

affine variant Race {
    Exit(FutureReadCopy<Result<ExitStatus, ErrorCode>>),
    Timer(AsyncCall<()>),
}

impl Waitable for Race;

impl Child {
    /// Wait for the child to end. Nothing can reach a stream still left in the
    /// `Child` once it is waited on, so `wait` closes each first: take a piped
    /// stream out to use it.
    pub fn wait(self) -> Result<ExitStatus, ProcessError> {
        let mut child = self;
        builtin::drop(child.stdin.take());
        builtin::drop(child.stdout.take());
        builtin::drop(child.stderr.take());
        if child.ended matches { None } {
            child.ended = child.exit.take().unwrap().finish();
        }
        return child.status();
    }

    /// Wait at most `how_long` for the child to end: `None` where it has not.
    /// The streams stay open, so a child blocked on a pipe nobody reads waits
    /// out the time.
    pub fn wait_timeout(&mut self, how_long: Duration) -> Result<Option<ExitStatus>, ProcessError> with MonotonicClock {
        if self.ended matches { None } {
            let mut set = WaitableSet::<Race>::new();
            set.insert(Race::Exit(self.exit.take().unwrap()));
            set.insert(Race::Timer(MonotonicClock::wait_for(how_long)));
            if let Exit(read) = set.wait().member {
                self.ended = read.finish();
            } else {
                let Exit(read) = set.drain().pop().unwrap() else {
                    unreachable();
                };
                self.exit = Option::Some(read);
                return Result::Ok(null);
            }
        }
        return Result::Ok(Option::Some(self.status()?));
    }

    /// Ask the child and every process it started to end. A child may ignore
    /// it, so [`Child::stop`] follows it with a kill.
    pub fn terminate(&self) {
        self.resource.terminate();
    }

    /// End the child and every process it started, now.
    pub fn kill(&self) {
        self.resource.kill();
    }

    /// Ask the child to end, and end it if it has not after `grace`.
    pub fn stop(self, grace: Duration) -> Result<ExitStatus, ProcessError> with MonotonicClock {
        let mut child = self;
        child.terminate();
        if let Some(status) = child.wait_timeout(grace)? {
            return Result::Ok(status);
        }
        child.kill();
        return child.wait();
    }

    fn status(&self) -> Result<ExitStatus, ProcessError> {
        return match self.ended.unwrap() {
            Ok(status) => Result::Ok(status),
            Err(code) => Result::Err(child_error(&self.program, ProcessErrorKind::Spawn(code))),
        };
    }
}

/// What `Command::output` read, and how the child ended.
pub struct Output {
    pub status: ExitStatus,
    pub stdout: ByteList,
    pub stderr: ByteList,
}

struct Captured {
    stdout: ByteList,
    stderr: ByteList,
    too_large: bool,
}

affine variant Pipe {
    Out(ReadCopy<u8>),
    Err(ReadCopy<u8>),
}

impl Waitable for Pipe;

/// Read `child`'s stdout and stderr, both piped, together until both end, so a child
/// filling one pipe never blocks against a parent reading the other.
fn capture(child: &mut Child, limit: i32) -> Captured {
    let mut captured = Captured { stdout: [], stderr: [], too_large: false };
    let mut set = WaitableSet::<Pipe>::new();
    set.insert(Pipe::Out(child.stdout.take().unwrap().start_read(CAPTURE_CHUNK)));
    set.insert(Pipe::Err(child.stderr.take().unwrap().start_read(CAPTURE_CHUNK)));
    while !set.is_empty() {
        match set.wait().member {
            Out(copy) => {
                let [end, chunk] = copy.finish();
                captured.stdout.extend(&(chunk.items as ByteList));
                if captured.stdout.len() > limit {
                    captured.too_large = true;
                    captured.stdout = [];
                    child.kill();
                } else if chunk.result == CopyResult::Completed {
                    set.insert(Pipe::Out(end.start_read(CAPTURE_CHUNK)));
                }
            },
            Err(copy) => {
                let [end, chunk] = copy.finish();
                captured.stderr.extend(&(chunk.items as ByteList));
                // Trimming copies the tail, so it waits for a second limit's worth.
                if captured.stderr.len() - limit > limit {
                    keep_tail(&mut captured.stderr, limit);
                }
                if chunk.result == CopyResult::Completed {
                    set.insert(Pipe::Err(end.start_read(CAPTURE_CHUNK)));
                }
            },
        }
    }
    keep_tail(&mut captured.stderr, limit);
    return captured;
}

fn keep_tail(bytes: &mut ByteList, limit: i32) {
    if bytes.len() > limit {
        *bytes = bytes.split_off(bytes.len() - limit);
    }
}

global CAPTURE_CHUNK: i32 = 65536;

/// Why a program did not run, or did not run as asked. Names the program, as
/// `FsError` names its path.
pub struct ProcessError {
    pub program: String,
    pub kind: ProcessErrorKind,
}

pub variant ProcessErrorKind {
    /// The host did not run the child, or lost it, for this reason.
    Spawn(ErrorCode),
    /// `read` only: the child ended other than `Exited(0)`, with what it
    /// wrote to stderr.
    Failed([ExitStatus, ByteList]),
    /// Stdout passed the capture limit, and the child was killed.
    OutputTooLarge,
}

impl Display for ProcessError {
    fn fmt(&self, f: &mut Formatter) {
        let reason: String = match self.kind {
            Spawn(code) => spawn_reason(code),
            Failed([status, stderr]) => `${status:?}: ${String::from_utf8_lossy(stderr)}`,
            OutputTooLarge => "its stdout passed the capture limit",
        };
        f.write_str(`${self.program}: ${reason}`);
    }
}

impl Error for ProcessError {
}

fn spawn_reason(code: ErrorCode) -> String {
    return match code {
        NotFound => "no such program",
        NotPermitted => "the host does not let a child run it",
        NotExecutable => "not a program the host can run",
        InvalidArgument => "an argument or environment variable the host cannot pass",
        ArgumentListTooLong => "the arguments and environment are too long",
        NotDirectory => "the directory to start in is not one",
        ResourceExhausted => "the host is out of the resources a child takes",
        Other(Some(message)) => message,
        Other(None) => "the host failed to run it",
    };
}

/// One hole of a [`cmd`] template: one argument, or one per element.
pub variant CmdArgs {
    One(String),
    Each(List<String>),
}

/// What a value is as a [`cmd`] hole.
pub trait CmdArg with () {
    fn cmd_args(&self) -> CmdArgs;
}

impl CmdArg for String {
    fn cmd_args(&self) -> CmdArgs {
        return CmdArgs::One(*self);
    }
}

impl CmdArg for List<String> {
    fn cmd_args(&self) -> CmdArgs {
        return CmdArgs::Each(*self);
    }
}

impl CmdArg for i32 {
    fn cmd_args(&self) -> CmdArgs {
        return CmdArgs::One(`${*self}`);
    }
}

impl CmdArg for i64 {
    fn cmd_args(&self) -> CmdArgs {
        return CmdArgs::One(`${*self}`);
    }
}

impl CmdArg for u32 {
    fn cmd_args(&self) -> CmdArgs {
        return CmdArgs::One(`${*self}`);
    }
}

impl CmdArg for u64 {
    fn cmd_args(&self) -> CmdArgs {
        return CmdArgs::One(`${*self}`);
    }
}

/// A `Command` from an argument vector, built without a shell.
///
/// Literal text splits on whitespace. A hole is exactly one argument, whatever
/// it holds, and a `List<String>` hole one per element. Parts with no
/// whitespace between them join into one argument; a `List<String>` hole
/// joined to anything is a contract violation. So is literal text holding a
/// character a shell would treat specially (quotes, `\`, `|`, `&`, `;`, `<`,
/// `>`, parentheses, braces, `$`, a backtick, `~`, `*`, `?`, brackets, `#`):
/// here it would mean nothing. A value holding one goes through a hole.
pub fn cmd<T: ReflectTemplate<Holes = [..V]>, ..V: CmdArg>(t: T) -> Command {
    let mut words = Words { done: [], word: null, list: null };
    for let h of ReflectTemplate::<T>::members() {
        words.literal(h.lit(&t));
        match h.get(&t).cmd_args() {
            One(arg) => words.join(&arg),
            Each(args) => words.each(args),
        }
    }
    words.literal(ReflectTemplate::<T>::tail(&t));
    let mut args = words.finish();
    assert !args.is_empty(), "a cmd template names a program";
    let program = args.remove(0);
    return Command::new(program).args(args);
}

/// A `cmd` template split into arguments as it is read.
struct Words {
    done: List<String>,
    /// The argument being built, where one is.
    word: Option<String>,
    /// A `List<String>` hole read last, which nothing may join.
    list: Option<List<String>>,
}

impl Words {
    fn literal(&mut self, text: StrSlice) {
        for let c of text.chars() {
            if c.is_whitespace() {
                self.end();
                continue;
            }
            assert !is_shell_special(c), "a cmd template's literal text holds a shell metacharacter; pass the value through a hole";
            self.join(&`${c}`);
        }
    }

    fn join(&mut self, part: &String) {
        assert self.list matches { None }, "a List<String> hole in a cmd template must stand alone";
        let mut word = self.word.take().unwrap_or("");
        word.push_str(part);
        self.word = Option::Some(word);
    }

    fn each(&mut self, args: List<String>) {
        assert self.word matches { None } && self.list matches { None }, "a List<String> hole in a cmd template must stand alone";
        self.list = Option::Some(args);
    }

    fn end(&mut self) {
        if let Some(word) = self.word.take() {
            self.done.push(word);
        }
        if let Some(list) = self.list.take() {
            self.done.extend(&list);
        }
    }

    fn finish(&mut self) -> List<String> {
        self.end();
        return self.done;
    }
}

fn is_shell_special(c: char) -> bool {
    return match c {
        '"' | '\'' | '\\' | '|' | '&' | ';' | '<' | '>' | '(' | ')' | '{' | '}' | '$' | '`' | '~' | '*' | '?' | '[' | ']' | '#' => true,
        _ => false,
    };
}
