use { BufferedRandom, bytes, seed, token_base64url, token_from, token_hex, with_buffered } from "core:secure_random";
use { Random } from "wasi:random";
use { Seedable, Rng, Xoshiro256pp } from "core:prng";

// Counts host calls and hands out a known stream: what the buffer served, and
// how often it reached past itself to get it. `chunk` makes it answer short
// and `overrun` makes it answer long, neither of which a caller may rely on.
struct CountingRandom {
    next: u8 = 0,
    calls: i32 = 0,
    chunk: i32 = 0,
    overrun: i32 = 1,
}

impl Random for CountingRandom {
    fn get_random_bytes(&mut self, max_len: u64) -> List<u8> {
        self.calls += 1;
        let mut n = if max_len > 65536 { 65536 } else { max_len as i32 };
        if self.chunk > 0 && self.chunk < n {
            n = self.chunk;
        }
        n *= self.overrun;
        let mut out: List<u8> = [];
        for let mut i = 0; i < n; i += 1 {
            out.push(self.next);
            self.next = (self.next as i32 + 1 & 0xFF) as u8;
        }
        resume out;
    }

    ..trap
}

test "one host call serves many reads" {
    let mut host = CountingRandom {};
    with Random => &mut host do {
        let mut rng = BufferedRandom {};
        with Random => &mut rng do {
            for let mut i = 0; i < 100; i += 1 {
                assert Random::get_random_bytes(16).len() == 16;
            }
        };
    };
    assert host.calls == 1;
}

test "the buffer serves the host's byte stream unchanged" {
    let mut direct = CountingRandom {};
    let expected = with Random => &mut direct do {
        Random::get_random_bytes(48);
    };

    let mut host = CountingRandom {};
    let mut served: List<u8> = [];
    with Random => &mut host do {
        let mut rng = BufferedRandom {};
        with Random => &mut rng do {
            for let mut i = 0; i < 3; i += 1 {
                for let byte of Random::get_random_bytes(16) {
                    served.push(byte);
                }
            }
        };
    };
    assert served == expected;
}

test "a short read from the host is tolerated" {
    // The host hands back 10 bytes however many are asked for.
    let mut host = CountingRandom { chunk: 10 };
    with Random => &mut host do {
        let mut rng = BufferedRandom {};
        with Random => &mut rng do {
            let first = Random::get_random_bytes(16);
            assert first.len() == 10;
            assert first[0] == 0;
            let second = Random::get_random_bytes(16);
            assert second.len() == 10;
            assert second[0] == 10;
        };
    };
    assert host.calls == 2;
}

test "get_random_u64 assembles from the buffer" {
    let mut host = CountingRandom {};
    with Random => &mut host do {
        let mut rng = BufferedRandom {};
        with Random => &mut rng do {
            // Bytes 00..=07, little-endian.
            assert Random::get_random_u64() == 0x0706050403020100;
            assert Random::get_random_u64() == 0x0f0e0d0c0b0a0908;
        };
    };
    assert host.calls == 1;
}

test "get_random_u64 spans a refill" {
    let mut host = CountingRandom { chunk: 4 };
    with Random => &mut host do {
        let mut rng = BufferedRandom {};
        with Random => &mut rng do {
            assert Random::get_random_u64() == 0x0706050403020100;
        };
    };
    assert host.calls == 2;
}

test "a read larger than the block goes straight to the host" {
    let mut host = CountingRandom {};
    with Random => &mut host do {
        let mut rng = BufferedRandom {};
        with Random => &mut rng do {
            assert Random::get_random_bytes(8192).len() == 8192;
        };
    };
    assert host.calls == 1;
}

test "a read too large for an i32 goes straight to the host" {
    let mut host = CountingRandom { chunk: 16 };
    with Random => &mut host do {
        let mut rng = BufferedRandom {};
        with Random => &mut rng do {
            assert Random::get_random_bytes(2147483664).len() == 16;
            // The block is untouched, so the stream continues where it was.
            assert Random::get_random_bytes(4)[0] == 16;
        };
    };
}

test "leftover bytes survive a refill" {
    let mut host = CountingRandom {};
    with Random => &mut host do {
        let mut rng = BufferedRandom {};
        with Random => &mut rng do {
            // Drain all but 3 bytes of the block, then ask for 8.
            assert Random::get_random_bytes(4093).len() == 4093;
            let spanning = Random::get_random_bytes(8);
            assert spanning.len() == 8;
            assert spanning[0] == (4093 & 0xFF) as u8;
        };
    };
    assert host.calls == 2;
}

test "seed draws 32 bytes and starts a stream" {
    let mut host = CountingRandom {};
    let first = with Random => &mut host do {
        seed();
    };
    assert host.calls == 1;

    // The same host stream replays, so the crossing itself is deterministic.
    let mut replay = CountingRandom {};
    let again = with Random => &mut replay do {
        seed();
    };
    assert first == again;

    // A different host stream gives a different seed, and a different stream.
    let mut moved = CountingRandom { next: 1 };
    let other = with Random => &mut moved do {
        seed();
    };
    assert other != first;

    // Outside the handler, so the crossing is where `Random` ends.
    assert Xoshiro256pp::from_seed(first).next_u64() != Xoshiro256pp::from_seed(other).next_u64();
}

test "bytes returns exactly what was asked for" {
    let mut host = CountingRandom {};
    with Random => &mut host do {
        assert bytes(0).is_empty();
        assert bytes(16).len() == 16;
        assert bytes(100).len() == 100;
    };
}

test "bytes loops over a short read" {
    let mut host = CountingRandom { chunk: 10 };
    with Random => &mut host do {
        let out = bytes(25);
        assert out.len() == 25;
        // The host's stream, unbroken across the three calls it took.
        for let mut i = 0; i < 25; i += 1 {
            assert out[i] == i as u8;
        }
    };
    assert host.calls == 3;
}

test "an over-delivering host cannot lengthen what was asked for" {
    let mut host = CountingRandom { overrun: 3 };
    with Random => &mut host do {
        assert bytes(4).len() == 4;
        assert token_hex(4).len() == 8;
        assert token_base64url(3).len() == 4;
        assert token_from(&b"abcdef", 5).len() == 5;
    };
}

test "token_hex is two hex digits per byte" {
    let mut host = CountingRandom {};
    with Random => &mut host do {
        assert token_hex(4) == "00010203";
        assert token_hex().len() == 64;
    };
}

test "token_base64url is url-safe and unpadded" {
    let mut host = CountingRandom {};
    with Random => &mut host do {
        let t = token_base64url();
        assert t.len() == 43;
        for let c of t.chars() {
            assert c.is_ascii_alphanumeric() || c == '-' || c == '_';
        }
    };
}

test "token_from draws from the alphabet" {
    let mut host = CountingRandom {};
    with Random => &mut host do {
        // The host counts up, so each byte lands on the next digit.
        assert token_from(&b"0123456789", 12) == "012345678901";
        assert token_from(&"abc", 0) == "";
    };
}

// Serves a fixed byte sequence, cycling, so a draw that must be rejected can
// be placed exactly where the test wants it.
struct ScriptedRandom {
    script: List<u8> = [],
    pos: i32 = 0,
}

impl Random for ScriptedRandom {
    fn get_random_bytes(&mut self, max_len: u64) -> List<u8> {
        let mut out: List<u8> = [];
        for let mut i = 0; i < max_len as i32; i += 1 {
            out.push(self.script[self.pos]);
            self.pos = (self.pos + 1) % self.script.len();
        }
        resume out;
    }

    ..trap
}

test "token_from rejects the bytes that would bias it" {
    // An alphabet of six: 256 is not a multiple of it, so 252..=255 must be
    // thrown away rather than folded back onto the first four letters.
    let mut host = ScriptedRandom {
        script: [250, 251, 252, 253, 254, 255, 0],
    };
    with Random => &mut host do {
        assert token_from(&b"abcdef", 3) == "efa";
    };
}

test "with_buffered installs a block for the body" {
    let mut host = CountingRandom {};
    let n = with Random => &mut host do {
        with_buffered(|| {
            let mut total = 0;
            for let mut i = 0; i < 50; i += 1 {
                total += bytes(16).len();
            }
            return total;
        });
    };
    assert n == 800;
    assert host.calls == 1;
}

interface Tally {
    fn bump() -> i32;
}

struct Counter {
    n: i32 = 0,
}

impl Tally for Counter {
    fn bump(&mut self) -> i32 {
        self.n += 1;
        resume self.n;
    }
}

test "with_buffered passes the body's own effects through" {
    let mut host = CountingRandom {};
    let mut tally = Counter {};
    let last = with Tally => &mut tally, Random => &mut host do {
        with_buffered(|| {
            assert bytes(4).len() == 4;
            return Tally::bump();
        });
    };
    assert last == 1;
    assert tally.n == 1;
}

test "with_buffered takes the block size" {
    let mut host = CountingRandom {};
    with Random => &mut host do {
        with_buffered(|| {
            for let mut i = 0; i < 8; i += 1 {
                assert Random::get_random_bytes(16).len() == 16;
            }
        }, 32);
    };
    assert host.calls == 4;
}
