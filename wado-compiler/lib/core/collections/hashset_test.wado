use { HashSet } from "core:collections";

test "a set iterates in insertion order" {
    let mut set = HashSet::<String>::new();
    assert set.insert("c");
    assert set.insert("a");
    assert !set.insert("c");
    assert set.insert("b");
    assert set.remove("a");
    assert !set.remove("a");
    assert set.insert("a");
    let mut got: List<String> = [];
    for let v of set {
        got.push(v);
    }
    assert got == ["c", "b", "a"];
    assert set.iter_ref().iter_value().collect() == got;
    assert set.contains("b") && !set.contains("z");
    assert set.len() == 3;
}

test "contains_str finds a String element by a view of its text" {
    let mut set = HashSet::<String>::new();
    set.insert("alpha");
    set.insert("beta");
    let text = "xbetax";
    assert set.contains_str(text.as_str_slice().slice(1, 5));
    assert set.contains_str("alpha");
    assert !set.contains_str("gamma");
    set.remove("beta");
    assert !set.contains_str("beta");
}

test "clear empties the set" {
    let mut set = HashSet::<i32>::new();
    assert set.insert(1);
    set.clear();
    assert set.is_empty();
    assert !set.contains(1);
}
