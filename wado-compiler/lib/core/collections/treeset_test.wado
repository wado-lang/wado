use { TreeSet } from "core:collections";

test "empty set" {
    let s: TreeSet<i32> = TreeSet::new();
    assert s.is_empty();
    assert s.len() == 0;
    assert !s.contains(1);
}

test "insert single element" {
    let mut s: TreeSet<i32> = TreeSet::new();
    let inserted = s.insert(42);
    assert inserted;
    assert s.len() == 1;
    assert !s.is_empty();
    assert s.contains(42);
}

test "insert returns false for duplicate" {
    let mut s: TreeSet<i32> = TreeSet::new();
    assert s.insert(10);
    assert !s.insert(10);
    assert s.len() == 1;
}

test "insert multiple elements" {
    let mut s: TreeSet<i32> = TreeSet::new();
    s.insert(1);
    s.insert(2);
    s.insert(3);
    assert s.len() == 3;
    assert s.contains(1);
    assert s.contains(2);
    assert s.contains(3);
    assert !s.contains(4);
}

test "contains returns false for absent element" {
    let mut s: TreeSet<i32> = TreeSet::new();
    s.insert(1);
    assert !s.contains(0);
    assert !s.contains(2);
    assert !s.contains(-1);
}

test "remove returns true if present" {
    let mut s: TreeSet<i32> = TreeSet::new();
    s.insert(5);
    assert s.remove(5);
    assert s.len() == 0;
    assert !s.contains(5);
}

test "remove returns false if absent" {
    let mut s: TreeSet<i32> = TreeSet::new();
    s.insert(5);
    assert !s.remove(99);
    assert s.len() == 1;
}

test "remove from empty set returns false" {
    let mut s: TreeSet<i32> = TreeSet::new();
    assert !s.remove(1);
}

test "remove preserves other elements" {
    let mut s: TreeSet<i32> = TreeSet::new();
    s.insert(1);
    s.insert(2);
    s.insert(3);
    s.remove(2);
    assert s.len() == 2;
    assert s.contains(1);
    assert !s.contains(2);
    assert s.contains(3);
}

test "clear empties the set" {
    let mut s: TreeSet<i32> = TreeSet::new();
    s.insert(1);
    s.insert(2);
    s.insert(3);
    s.clear();
    assert s.is_empty();
    assert s.len() == 0;
    assert !s.contains(1);
}

test "insert after clear" {
    let mut s: TreeSet<i32> = TreeSet::new();
    s.insert(1);
    s.clear();
    s.insert(2);
    assert s.len() == 1;
    assert !s.contains(1);
    assert s.contains(2);
}

test "iterates in insertion order" {
    let mut s: TreeSet<i32> = TreeSet::new();
    s.insert(30);
    s.insert(10);
    s.insert(20);
    let mut result: Array<i32> = [];
    for let x of s {
        result.push(x);
    }
    assert result.len() == 3;
    assert result[0] == 30;
    assert result[1] == 10;
    assert result[2] == 20;
}

test "duplicate insert does not change order" {
    let mut s: TreeSet<i32> = TreeSet::new();
    s.insert(3);
    s.insert(1);
    s.insert(2);
    s.insert(1);
    let mut result: Array<i32> = [];
    for let x of s {
        result.push(x);
    }
    assert result.len() == 3;
    assert result[0] == 3;
    assert result[1] == 1;
    assert result[2] == 2;
}

test "remove and re-insert appends to end" {
    let mut s: TreeSet<i32> = TreeSet::new();
    s.insert(1);
    s.insert(2);
    s.insert(3);
    s.remove(1);
    assert s.insert(1);
    let mut result: Array<i32> = [];
    for let x of s {
        result.push(x);
    }
    assert result.len() == 3;
    assert result[0] == 2;
    assert result[1] == 3;
    assert result[2] == 1;
}

test "iteration skips removed elements" {
    let mut s: TreeSet<i32> = TreeSet::new();
    s.insert(10);
    s.insert(20);
    s.insert(30);
    s.remove(20);
    let mut result: Array<i32> = [];
    for let x of s {
        result.push(x);
    }
    assert result.len() == 2;
    assert result[0] == 10;
    assert result[1] == 30;
}

test "for-of loop" {
    let mut s: TreeSet<i32> = TreeSet::new();
    s.insert(5);
    s.insert(3);
    s.insert(7);
    let mut sum = 0;
    for let x of s {
        sum = sum + x;
    }
    assert sum == 15;
}

test "iter matches for-of" {
    let mut s: TreeSet<i32> = TreeSet::new();
    s.insert(100);
    s.insert(200);
    let mut iter = s.iter();
    assert iter.next() matches { Some(v) && v == 100 };
    assert iter.next() matches { Some(v) && v == 200 };
    assert iter.next() matches { None };
}

test "iterate same set twice" {
    let mut s: TreeSet<i32> = TreeSet::new();
    s.insert(1);
    s.insert(2);
    s.insert(3);
    let mut first: Array<i32> = [];
    for let x of s {
        first.push(x);
    }
    let mut second: Array<i32> = [];
    for let x of s {
        second.push(x);
    }
    assert first.len() == 3;
    assert second.len() == 3;
    assert first[0] == second[0];
    assert first[1] == second[1];
    assert first[2] == second[2];
}

test "empty set iteration yields nothing" {
    let s: TreeSet<i32> = TreeSet::new();
    let mut count = 0;
    for let _ of s {
        count = count + 1;
    }
    assert count == 0;
}

test "negative integers" {
    let mut s: TreeSet<i32> = TreeSet::new();
    s.insert(-3);
    s.insert(-1);
    s.insert(-2);
    assert s.len() == 3;
    assert s.contains(-1);
    assert s.contains(-2);
    assert s.contains(-3);
    assert !s.contains(0);
    let mut result: Array<i32> = [];
    for let x of s {
        result.push(x);
    }
    assert result[0] == -3;
    assert result[1] == -1;
    assert result[2] == -2;
}

test "sequence literal coercion preserves insertion order" {
    let s = [30, 10, 20] as TreeSet<i32>;
    assert s.len() == 3;
    assert s.contains(10);
    assert s.contains(20);
    assert s.contains(30);
    let mut result: Array<i32> = [];
    for let x of s {
        result.push(x);
    }
    assert result[0] == 30;
    assert result[1] == 10;
    assert result[2] == 20;
}

test "sequence literal coercion deduplicates" {
    let s = [1, 2, 1, 3, 2] as TreeSet<i32>;
    assert s.len() == 3;
    let mut result: Array<i32> = [];
    for let x of s {
        result.push(x);
    }
    assert result[0] == 1;
    assert result[1] == 2;
    assert result[2] == 3;
}

test "empty sequence literal" {
    let s: TreeSet<i32> = [] as TreeSet<i32>;
    assert s.is_empty();
}

test "string set basic operations" {
    let mut s: TreeSet<String> = TreeSet::new();
    s.insert("banana");
    s.insert("apple");
    s.insert("cherry");
    assert s.len() == 3;
    assert s.contains("apple");
    assert !s.contains("date");
    s.remove("apple");
    assert !s.contains("apple");
    assert s.len() == 2;
}

test "string set insertion order" {
    let mut s: TreeSet<String> = TreeSet::new();
    s.insert("c");
    s.insert("a");
    s.insert("b");
    let mut result: Array<String> = [];
    for let x of s {
        result.push(x);
    }
    assert result[0] == "c";
    assert result[1] == "a";
    assert result[2] == "b";
}

test "large set insert and lookup" {
    let mut s: TreeSet<i32> = TreeSet::new();
    let mut i = 0;
    while i < 100 {
        s.insert(i);
        i = i + 1;
    }
    assert s.len() == 100;
    assert s.contains(0);
    assert s.contains(50);
    assert s.contains(99);
    assert !s.contains(100);
}

test "inspect empty set" {
    let s: TreeSet<i32> = TreeSet::new();
    assert `{s:?}` == "{}";
}

test "inspect i32 set" {
    let mut s: TreeSet<i32> = TreeSet::new();
    s.insert(10);
    s.insert(20);
    s.insert(30);
    assert `{s:?}` == "{10, 20, 30}";
}

test "inspect string set" {
    let mut s: TreeSet<String> = TreeSet::new();
    s.insert("a");
    s.insert("b");
    assert `{s:?}` == "{\"a\", \"b\"}";
}

test "pretty-print empty set" {
    let s: TreeSet<i32> = TreeSet::new();
    assert `{s:#?}` == "{}";
}

test "pretty-print i32 set" {
    let mut s: TreeSet<i32> = TreeSet::new();
    s.insert(10);
    s.insert(20);
    s.insert(30);
    assert `{s:#?}` == "{
  10,
  20,
  30,
}";
}

test "compaction after many removals" {
    let mut s: TreeSet<i32> = TreeSet::new();
    let mut i = 0;
    while i < 50 {
        s.insert(i);
        i = i + 1;
    }
    i = 0;
    while i < 40 {
        s.remove(i);
        i = i + 1;
    }
    assert s.len() == 10;
    assert s.contains(40);
    assert s.contains(49);
    assert !s.contains(0);
    assert !s.contains(39);
    let mut result: Array<i32> = [];
    for let x of s {
        result.push(x);
    }
    assert result.len() == 10;
    assert result[0] == 40;
    assert result[9] == 49;
}
