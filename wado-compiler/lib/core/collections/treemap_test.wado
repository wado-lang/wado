use { HashMap, HashSet, TreeMap, TreeSet } from "core:collections";
use { to_string, from_string } from "core:json";
use {
    SerializeError,
    Deserialize,
    Deserializer,
    DeserializeError,
    DeserializeMap,
    DeserializeSeq,
    NoCompound,
    Visitor,
} from "core:serde";

test "empty map" {
    let map: TreeMap<String, i32> = TreeMap::new();
    assert map.is_empty();
    assert map.len() == 0;
    assert !map.contains_key("key");
}

test "insert and get" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["one"] = 1;
    assert map.len() == 1;
    assert map.contains_key("one");
    assert map["one"] == 1;
}

test "update existing key" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["one"] = 1;
    map["one"] = 100;
    assert map.len() == 1;
    assert map["one"] == 100;
}

test "multiple inserts" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["one"] = 1;
    map["two"] = 2;
    map["three"] = 3;
    assert map.len() == 3;
}

test "get returns Some for existing key" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["key"] = 42;
    assert map.get("key") matches { Some(v) && v == 42 };
}

test "get returns None for missing key" {
    let map: TreeMap<String, i32> = TreeMap::new();
    assert map.get("missing") matches { None };
}

test "clear empties map" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["a"] = 1;
    map["b"] = 2;
    map["c"] = 3;
    assert map.len() == 3;
    map.clear();
    assert map.is_empty();
    assert map.len() == 0;
    assert !map.contains_key("a");
    assert !map.contains_key("b");
    assert !map.contains_key("c");
}

test "insert after clear" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["a"] = 1;
    map.clear();
    map["new"] = 42;
    assert map.len() == 1;
    assert map.contains_key("new");
}

test "entries returns key-value pairs in insertion order" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["first"] = 1;
    map["second"] = 2;
    map["third"] = 3;
    let pairs = map.entries().iter_value().collect();
    assert pairs.len() == 3;
    assert pairs[0].0 == "first";
    assert pairs[0].1 == 1;
    assert pairs[1].0 == "second";
    assert pairs[1].1 == 2;
    assert pairs[2].0 == "third";
    assert pairs[2].1 == 3;
}

test "entries after update" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["first"] = 1;
    map["second"] = 2;
    map["third"] = 3;
    map["second"] = 200;
    let pairs = map.entries().iter_value().collect();
    assert pairs[1].0 == "second";
    assert pairs[1].1 == 200;
}

test "entries after remove" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["first"] = 1;
    map["second"] = 2;
    map["third"] = 3;
    map.remove("second");
    let pairs = map.entries().iter_value().collect();
    assert pairs.len() == 2;
    assert pairs[0].0 == "first";
    assert pairs[1].0 == "third";
}

test "keys in insertion order" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["echo"] = 5;
    map["charlie"] = 3;
    map["golf"] = 7;
    map["alpha"] = 1;
    map["india"] = 9;
    map["delta"] = 4;
    map["foxtrot"] = 6;
    map["bravo"] = 2;
    map["hotel"] = 8;
    let keys = map.keys().iter_value().collect();
    assert keys[0] == "echo";
    assert keys[1] == "charlie";
    assert keys[2] == "golf";
    assert keys[3] == "alpha";
    assert keys[4] == "india";
    assert keys[5] == "delta";
    assert keys[6] == "foxtrot";
    assert keys[7] == "bravo";
    assert keys[8] == "hotel";
}

test "values in insertion order" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["echo"] = 5;
    map["charlie"] = 3;
    map["golf"] = 7;
    map["alpha"] = 1;
    map["india"] = 9;
    let values = map.values().iter_value().collect();
    assert values[0] == 5;
    assert values[1] == 3;
    assert values[2] == 7;
    assert values[3] == 1;
    assert values[4] == 9;
}

test "sum, min and max over values" {
    let map: TreeMap<String, i32> = { a: 1, b: 5, c: 3 };
    assert map.values().iter_value().sum() matches { Some(v) && v == 9 };
    assert map.values().iter_value().min() matches { Some(v) && v == 1 };
    assert map.values().iter_value().max() matches { Some(v) && v == 5 };
    assert map.keys().iter_value().max() matches { Some(k) && k == "c" };
}

test "remove existing key" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["a"] = 1;
    map["b"] = 2;
    map["c"] = 3;
    assert map.remove("b");
    assert !map.contains_key("b");
    assert map.len() == 2;
    assert map.contains_key("a");
    assert map.contains_key("c");
}

test "remove nonexistent key" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["a"] = 1;
    map["b"] = 2;
    assert !map.remove("z");
    assert map.len() == 2;
}

test "remove from empty map returns false" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    assert !map.remove("anything");
}

test "reinsert after remove" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["a"] = 1;
    map["b"] = 2;
    map["c"] = 3;
    assert map.remove("b");
    map["b"] = 999;
    assert map.contains_key("b");
    assert map["b"] == 999;
    assert map.len() == 3;
}

test "remove from middle preserves order" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["first"] = 1;
    map["second"] = 2;
    map["third"] = 3;
    map["fourth"] = 4;
    map["fifth"] = 5;
    assert map.remove("third");
    let keys = map.keys().iter_value().collect();
    assert keys.len() == 4;
    assert keys[0] == "first";
    assert keys[1] == "second";
    assert keys[2] == "fourth";
    assert keys[3] == "fifth";
}

test "remove from beginning preserves order" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["first"] = 1;
    map["second"] = 2;
    map["third"] = 3;
    assert map.remove("first");
    let keys = map.keys().iter_value().collect();
    assert keys[0] == "second";
    assert keys[1] == "third";
}

test "remove from end preserves order" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["first"] = 1;
    map["second"] = 2;
    map["third"] = 3;
    assert map.remove("third");
    let keys = map.keys().iter_value().collect();
    assert keys.len() == 2;
    assert keys[0] == "first";
    assert keys[1] == "second";
}

test "reinsert goes to end" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["a"] = 1;
    map["b"] = 2;
    map["c"] = 3;
    assert map.remove("b");
    map["b"] = 999;
    let keys = map.keys().iter_value().collect();
    assert keys.len() == 3;
    assert keys[0] == "a";
    assert keys[1] == "c";
    assert keys[2] == "b";
}

test "multiple removes and reinserts" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["a"] = 1;
    map["b"] = 2;
    map["c"] = 3;
    map.remove("b");
    map["b"] = 999;
    map.remove("a");
    map["a"] = 111;
    let keys = map.keys().iter_value().collect();
    assert keys[0] == "c";
    assert keys[1] == "b";
    assert keys[2] == "a";
}

test "update does not change position" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["a"] = 1;
    map["b"] = 2;
    map["c"] = 3;
    map["a"] = 100;
    map["b"] = 200;
    let keys = map.keys().iter_value().collect();
    assert keys[0] == "a";
    assert keys[1] == "b";
    assert keys[2] == "c";
    let values = map.values().iter_value().collect();
    assert values[0] == 100;
    assert values[1] == 200;
    assert values[2] == 3;
}

test "compact after many deletions preserves order" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["a"] = 1;
    map["b"] = 2;
    map["c"] = 3;
    map["d"] = 4;
    map["e"] = 5;
    map["f"] = 6;
    map["g"] = 7;
    map["h"] = 8;
    map["i"] = 9;
    map["j"] = 10;
    assert map.len() == 10;
    map.remove("b");
    map.remove("c");
    map.remove("e");
    map.remove("g");
    map.remove("h");
    map.remove("i");
    assert map.len() == 4;
    let keys = map.keys().iter_value().collect();
    assert keys.len() == 4;
    assert keys[0] == "a";
    assert keys[1] == "d";
    assert keys[2] == "f";
    assert keys[3] == "j";
    let values = map.values().iter_value().collect();
    assert values[0] == 1;
    assert values[1] == 4;
    assert values[2] == 6;
    assert values[3] == 10;
}

test "insert after compact" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["a"] = 1;
    map["b"] = 2;
    map["c"] = 3;
    map["d"] = 4;
    map["e"] = 5;
    map["f"] = 6;
    map["g"] = 7;
    map["h"] = 8;
    map["i"] = 9;
    map["j"] = 10;
    map.remove("b");
    map.remove("c");
    map.remove("e");
    map.remove("g");
    map.remove("h");
    map.remove("i");
    map["new"] = 100;
    let keys = map.keys().iter_value().collect();
    assert keys.len() == 5;
    assert keys[4] == "new";
    assert map["d"] == 4;
    assert map["new"] == 100;
}

test "50 items insert and partial remove" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    for let mut i = 0; i < 50; i += 1 {
        map[`item${i}`] = i;
    }
    assert map.len() == 50;
    assert map["item0"] == 0;
    assert map["item49"] == 49;
    for let mut i = 0; i < 50; i += 2 {
        map.remove(`item${i}`);
    }
    assert map.len() == 25;
    assert map.contains_key("item1");
    assert map.contains_key("item3");
    assert !map.contains_key("item0");
    assert !map.contains_key("item2");
}

/// `0..n` scattered: `i * 7919 % n` visits each once while `n` is no multiple
/// of 7919.
fn scattered(n: i32) -> List<i32> {
    let mut out: List<i32> = [];
    for let i of 0..<n {
        out.push(i * 7919 % n);
    }
    return out;
}

/// A map from each of `keys` to its position in it.
fn positions(keys: &List<i32>) -> TreeMap<i32, i32> {
    let mut map = TreeMap::<i32, i32>::new();
    for let i of 0..<keys.len() {
        map[keys[i]] = i;
    }
    return map;
}

test "a map many levels deep finds every key it holds and none it lacks" {
    let ascending: List<i32> = (0..<5000).collect();
    let descending: List<i32> = ascending.iter_ref().map(|k| 4999 - *k).collect();
    for let keys of [scattered(5000), ascending, descending] {
        let map = positions(&keys);
        assert map.len() == 5000;
        for let i of 0..<keys.len() {
            assert map.get(keys[i]) matches { Some(p) && p == i };
            assert !map.contains_key(keys[i] + 5000);
            assert !map.contains_key(-1 - keys[i]);
        }
        let mut position = 0;
        for let [k, p] of map.entries() {
            assert *k == keys[position] && *p == position;
            position += 1;
        }
        assert position == 5000;
    }
}

test "a deep map compacts its removals and appends what returns" {
    let keys = scattered(3000);
    let mut map = positions(&keys);
    for let i of 0..<3000 {
        if i % 10 != 0 {
            assert map.remove(keys[i]);
        }
    }
    assert map.len() == 300;
    for let i of 0..<3000 {
        assert map.contains_key(keys[i]) == (i % 10 == 0);
    }
    for let i of 0..<3000 {
        if i % 10 == 1 {
            map[keys[i]] = i;
        }
    }
    assert map.len() == 600;
    let order: List<i32> = map.values().iter_value().collect();
    for let j of 0..<300 {
        assert order[j] == j * 10;
        assert order[300 + j] == j * 10 + 1;
    }
    for let i of 0..<3000 {
        assert map.contains_key(keys[i]) == (i % 10 <= 1);
    }
}

test "a copy of a deep map is its own" {
    let keys = scattered(2000);
    let original = positions(&keys);
    let mut copy = original;
    for let i of 0..<1000 {
        copy.remove(keys[i]);
    }
    copy[-1] = -1;
    assert original.len() == 2000 && copy.len() == 1001;
    assert original.contains_key(keys[0]) && !copy.contains_key(keys[0]);
    assert !original.contains_key(-1) && copy.contains_key(-1);
}

test "get_str finds every key of a deep map" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    for let k of scattered(2000) {
        map[`key${k}`] = k;
    }
    for let k of 0..<2000 {
        assert map.get_str(`key${k}`.as_str_slice()) matches { Some(v) && v == k };
    }
    assert !map.contains_key_str("key2000");
}

test "key-value literal coercion" {
    let m: TreeMap<String, i32> = { a: 1, b: 2, c: 3 };
    assert m.len() == 3;
    assert m["a"] == 1;
    assert m["b"] == 2;
    assert m["c"] == 3;
}

test "key-value literal preserves insertion order" {
    let m: TreeMap<String, i32> = { echo: 5, charlie: 3, alpha: 1 };
    let keys = m.keys().iter_value().collect();
    assert keys[0] == "echo";
    assert keys[1] == "charlie";
    assert keys[2] == "alpha";
}

fn make_literal_map() -> TreeMap<String, i32> {
    return { x: 10, y: 20 };
}

test "key-value literal coercion in return position" {
    let m = make_literal_map();
    assert m.len() == 2;
    assert m["x"] == 10;
    assert m["y"] == 20;
}

test "empty key-value literal" {
    let m: TreeMap<String, i32> = {};
    assert m.is_empty();
}


#[expect_trap]
test "index access panics for missing key" {
    let map: TreeMap<String, i32> = TreeMap::new();
    let _ = map["missing"];
}

#[expect_trap]
test "borrowing a missing key panics" {
    let map: TreeMap<String, List<i32>> = TreeMap::new();
    let _ = &map["missing"];
}

test "maps are equal when they hold equal entries in the same order" {
    let mut a: TreeMap<String, i32> = TreeMap::new();
    let mut b: TreeMap<String, i32> = TreeMap::new();
    assert a == b;
    a["x"] = 1;
    a["gone"] = 0;
    a["y"] = 2;
    assert a.remove("gone");
    b["x"] = 1;
    b["y"] = 2;
    assert a == b;
    b["y"] = 3;
    assert a != b;
    let c: TreeMap<String, i32> = { y: 2, x: 1 };
    assert a != c;
    let s = [1, 2] as TreeSet<i32>;
    assert s == [1, 2] as TreeSet<i32> && s != [2, 1] as TreeSet<i32>;
}

test "maps order by their entries in insertion order, then by length" {
    let a: TreeMap<String, i32> = { x: 1, y: 2 };
    let mut b: TreeMap<String, i32> = { x: 1, gone: 0, y: 2 };
    assert b.remove("gone");
    assert a.cmp(&b) == Ordering::Equal;
    assert a < { x: 1, y: 3 } as TreeMap<String, i32>;
    assert a < { y: 0 } as TreeMap<String, i32>;
    assert a > { x: 1 } as TreeMap<String, i32>;
    let mut maps: List<TreeMap<String, i32>> = [
        { y: 0 },
        a,
        { x: 1 },
    ];
    maps.sort();
    assert maps == [
        { x: 1 },
        a,
        { y: 0 },
    ];
    assert [2] as TreeSet<i32> > [1, 5] as TreeSet<i32>;
}

#[expect_trap]
test "mutating a missing key panics" {
    let mut map: TreeMap<String, List<i32>> = TreeMap::new();
    map["missing"].push(1);
}

test "overwriting the median of a full child keeps one entry" {
    // 0..<31 fill the root, 31 splits it, and 32..<47 fill its right child to
    // [16, 46], whose median 31 the next descent promotes.
    let mut map: TreeMap<i32, i32> = TreeMap::new();
    for let i of 0..<47 {
        map[i] = i;
    }
    map[31] = -1;
    assert map.len() == 47 && map[31] == -1 && map[30] == 30 && map[32] == 32;
}

test "a value mutates in place through its key" {
    let mut map: TreeMap<String, List<i32>> = TreeMap::new();
    map["a"] = [];
    map["a"].push(1);
    map["a"].push(2);
    assert map["a"] == [1, 2];
}

test "a spread literal merges into a map" {
    let base: TreeMap<String, i32> = { a: 1, b: 2 };
    let merged: TreeMap<String, i32> = { ..base, b: 20, c: 3 };
    assert merged.len() == 3 && merged["a"] == 1 && merged["b"] == 20 && merged["c"] == 3;
}

test "a text lookup on an empty map finds nothing" {
    let map: TreeMap<String, i32> = TreeMap::new();
    assert map.get_str("a") == null;
}

test "re-inserting every key of a deep tree keeps one entry each" {
    let mut map: TreeMap<i32, i32> = TreeMap::new();
    for let i of 0..<2000 {
        map[i * 7919 % 2000] = i;
    }
    for let i of 0..<2000 {
        map[i] = -i;
    }
    assert map.len() == 2000;
    for let i of 0..<2000 {
        assert map[i] == -i;
    }
}

test "for-of over entries" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["a"] = 1;
    map["b"] = 2;
    map["c"] = 3;
    let mut ks: List<String> = [];
    let mut vs: List<i32> = [];
    for let [k, v] of map.entries() {
        ks.push(*k);
        vs.push(*v);
    }
    assert ks.len() == 3;
    assert ks[0] == "a" && vs[0] == 1;
    assert ks[1] == "b" && vs[1] == 2;
    assert ks[2] == "c" && vs[2] == 3;
}

test "for-of over keys" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["x"] = 10;
    map["y"] = 20;
    let mut result: List<String> = [];
    for let k of map.keys() {
        result.push(*k);
    }
    assert result.len() == 2;
    assert result[0] == "x";
    assert result[1] == "y";
}

test "for-of over values" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["x"] = 10;
    map["y"] = 20;
    let mut sum = 0;
    for let v of map.values() {
        sum += *v;
    }
    assert sum == 30;
}

test "i32 key insert and get" {
    let mut map: TreeMap<i32, String> = TreeMap::new();
    map[1] = "one";
    map[2] = "two";
    map[3] = "three";
    assert map.len() == 3;
    assert map[1] == "one";
    assert map[2] == "two";
    assert map[3] == "three";
}

test "i32 key insertion order" {
    let mut map: TreeMap<i32, i32> = TreeMap::new();
    map[30] = 300;
    map[10] = 100;
    map[20] = 200;
    let keys = map.keys().iter_value().collect();
    assert keys[0] == 30;
    assert keys[1] == 10;
    assert keys[2] == 20;
}

test "inspect empty map" {
    let map: TreeMap<String, i32> = TreeMap::new();
    assert `${map:?}` == "{}";
}

test "inspect string keys" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["a"] = 1;
    map["b"] = 2;
    assert `${map:?}` == "{\"a\": 1, \"b\": 2}";
}

test "inspect i32 keys" {
    let mut map: TreeMap<i32, String> = TreeMap::new();
    map[1] = "one";
    map[2] = "two";
    assert `${map:?}` == "{1: \"one\", 2: \"two\"}";
}

test "pretty-print empty map" {
    let map: TreeMap<String, i32> = TreeMap::new();
    assert `${map:#?}` == "{}";
}

test "pretty-print string keys" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["a"] = 1;
    map["b"] = 2;
    assert `${map:#?}` == "{
  \"a\": 1,
  \"b\": 2,
}";
}

test "pretty-print single entry" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["key"] = 42;
    assert `${map:#?}` == "{
  \"key\": 42,
}";
}

test "i32 key remove" {
    let mut map: TreeMap<i32, String> = TreeMap::new();
    map[1] = "a";
    map[2] = "b";
    map[3] = "c";
    assert map.remove(2);
    assert !map.contains_key(2);
    assert map.len() == 2;
    assert map.get(2) matches { None };
}

test "serde Serializer" {
    let map: TreeMap<String, String> = {
        foo: "1",
        bar: "2",
        baz: "3",
    };

    let result: Result<String, SerializeError> = to_string(&map);
    assert result matches { Ok(s) && s == `{"foo":"1","bar":"2","baz":"3"}` };
}

/// An empty map or sequence whose close fails. No stdlib format's does once
/// its entries are drained, but a format may.
struct FailingClose {
}

impl DeserializeMap for FailingClose {
    fn next_key<K: Deserialize>(&mut self) -> Result<Option<K>, DeserializeError> {
        return Result::Ok(null);
    }

    fn next_value<V: Deserialize>(&mut self) -> Result<V, DeserializeError> {
        return unreachable();
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        return Result::Err(DeserializeError::invalid_value("unclosed"));
    }
}

impl DeserializeSeq for FailingClose {
    fn next_element<T: Deserialize>(&mut self) -> Result<Option<T>, DeserializeError> {
        return Result::Ok(null);
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        return Result::Err(DeserializeError::invalid_value("unclosed"));
    }
}

// The trait asks for every method, but a collection reaches only `begin_map`
// or `begin_seq`.
impl Deserializer for FailingClose {
    type SeqAccess = FailingClose;
    type MapAccess = FailingClose;
    type StructAccess = NoCompound;
    type VariantAccess = NoCompound;

    fn deserialize_i32(&mut self) -> Result<i32, DeserializeError> {
        return unreachable();
    }

    fn deserialize_i64(&mut self) -> Result<i64, DeserializeError> {
        return unreachable();
    }

    fn deserialize_u32(&mut self) -> Result<u32, DeserializeError> {
        return unreachable();
    }

    fn deserialize_u64(&mut self) -> Result<u64, DeserializeError> {
        return unreachable();
    }

    fn deserialize_i128(&mut self) -> Result<i128, DeserializeError> {
        return unreachable();
    }

    fn deserialize_u128(&mut self) -> Result<u128, DeserializeError> {
        return unreachable();
    }

    fn deserialize_f32(&mut self) -> Result<f32, DeserializeError> {
        return unreachable();
    }

    fn deserialize_f64(&mut self) -> Result<f64, DeserializeError> {
        return unreachable();
    }

    fn deserialize_f16(&mut self) -> Result<f16, DeserializeError> {
        return unreachable();
    }

    fn deserialize_bf16(&mut self) -> Result<bf16, DeserializeError> {
        return unreachable();
    }

    fn deserialize_bool(&mut self) -> Result<bool, DeserializeError> {
        return unreachable();
    }

    fn deserialize_char(&mut self) -> Result<char, DeserializeError> {
        return unreachable();
    }

    fn deserialize_string(&mut self) -> Result<String, DeserializeError> {
        return unreachable();
    }

    fn is_null(&mut self) -> Result<bool, DeserializeError> {
        return unreachable();
    }

    fn begin_seq(&mut self) -> Result<FailingClose, DeserializeError> {
        return Result::Ok(FailingClose {});
    }

    fn begin_map(&mut self) -> Result<FailingClose, DeserializeError> {
        return Result::Ok(FailingClose {});
    }

    fn begin_struct<S: AsStrSlice>(&mut self, name: S, num_fields: i32) -> Result<NoCompound, DeserializeError> {
        return unreachable();
    }

    fn begin_variant<S: AsStrSlice>(&mut self, type_name: S, num_cases: i32) -> Result<NoCompound, DeserializeError> {
        return unreachable();
    }

    fn deserialize_any<V: Visitor>(&mut self, visitor: &mut V) -> Result<V::Value, DeserializeError> {
        return unreachable();
    }
}

test "a map or a set passes on the error its close raises" {
    let unclosed = DeserializeError::invalid_value("unclosed");
    assert TreeMap::<String, i32>::deserialize(&mut FailingClose {}).unwrap_err() == unclosed;
    assert TreeSet::<i32>::deserialize(&mut FailingClose {}).unwrap_err() == unclosed;
    assert HashMap::<String, i32>::deserialize(&mut FailingClose {}).unwrap_err() == unclosed;
    assert HashSet::<i32>::deserialize(&mut FailingClose {}).unwrap_err() == unclosed;
}

test "try_insert reports whether the key was new" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    assert map.try_insert("a", 1);
    assert !map.try_insert("a", 2);
    assert map.len() == 1;
}

test "try_insert leaves the existing value alone" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map.try_insert("a", 1);
    map.try_insert("a", 99);
    assert map.get("a") matches { Some(v) && v == 1 };
}

test "a losing try_insert keeps insertion order" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map.try_insert("a", 1);
    map.try_insert("b", 2);
    map.try_insert("a", 3);
    let keys: List<String> = map.keys().iter_value().collect();
    assert keys.len() == 2;
    assert keys[0] == "a";
    assert keys[1] == "b";
}

test "try_insert after remove re-appends at the end" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map.try_insert("a", 1);
    map.try_insert("b", 2);
    assert map.remove("a");
    assert map.try_insert("a", 3);
    let keys: List<String> = map.keys().iter_value().collect();
    assert keys[0] == "b";
    assert keys[1] == "a";
    assert map.get("a") matches { Some(v) && v == 3 };
}

test "get_or_insert returns the existing value without overwriting" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map.try_insert("a", 1);
    assert map.get_or_insert("a", 99) == 1;
    assert map.get("a") matches { Some(v) && v == 1 };
}

test "get_or_insert inserts and returns when absent" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    assert map.get_or_insert("a", 7) == 7;
    assert map.len() == 1;
    assert map.get("a") matches { Some(v) && v == 7 };
}

test "index assignment still overwrites" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["a"] = 1;
    map["a"] = 2;
    assert map.get("a") matches { Some(v) && v == 2 };
}

test "get_str and contains_key_str look up by a view" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["alpha"] = 1;
    map["beta"] = 2;

    let text = "xx-beta-xx".as_str_slice();
    assert map.contains_key_str(text.slice(3, 7));
    assert map.get_str(text.slice(3, 7)) matches { Some(v) && v == 2 };

    assert !map.contains_key_str(text.slice(0, 2));
    assert map.get_str(text.slice(0, 2)) matches { None };

    assert map.get_str("alpha") matches { Some(v) && v == 1 };
}

test "get_str sees a removed key as absent" {
    let mut map: TreeMap<String, i32> = TreeMap::new();
    map["alpha"] = 1;
    map.remove("alpha");
    assert !map.contains_key_str("alpha".as_str_slice());
    assert map.get_str("alpha".as_str_slice()) matches { None };
}

test "get_ref_str borrows the stored value" {
    let mut map: TreeMap<String, List<i32>> = TreeMap::new();
    map["alpha"] = [1, 2];

    let text = "xx-alpha-xx".as_str_slice();
    assert map.get_ref_str(text.slice(3, 8)) matches { Some(v) && v.len() == 2 };
    assert map.get_ref_str("beta") matches { None };

    map.remove("alpha");
    assert map.get_ref_str("alpha") matches { None };
}
