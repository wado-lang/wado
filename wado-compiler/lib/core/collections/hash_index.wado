global EMPTY: i64 = -1;
global MIN_SLOTS: i32 = 8;

/// `clear` cuts a table with more than this many slots per row.
global SPARSE_TABLE: i32 = 16;

/// An index over rows the caller keeps elsewhere: it holds a row number per
/// key and never the key. The caller hashes a key and says which row equals
/// it. It keeps no order and removes nothing but everything.
///
/// A hash is the caller's, used as it comes: its top bits pick the slot, so
/// they must differ between keys. A multiply carries a difference only
/// upward, so a hash built of them alone leaves its top bits blind to the low
/// bits of the last word; fold the high half into the low and multiply once
/// more.
pub struct HashIndex {
    /// A row under the top half of its key's hash, `EMPTY` where there is
    /// none; a power of two long, at least twice the row count.
    slots: Array<i64>,
    count: i32,
    /// A hash's bits above this are its home slot.
    shift: i64,
}

fn shift_for(slots: i32) -> i64 {
    return (64 - i32::ctz(slots)) as i64;
}

impl HashIndex {
    /// An empty index.
    pub fn new() -> HashIndex {
        return HashIndex {
            slots: Array::<i64>::filled(MIN_SLOTS, EMPTY),
            count: 0,
            shift: shift_for(MIN_SLOTS),
        };
    }

    /// The number of rows indexed.
    pub fn len(&self) -> i32 {
        return self.count;
    }

    /// The row `is_row` accepts among those indexed under `hash`, or `-1`.
    pub fn find(&self, hash: u64, is_row: fn(i32) -> bool) -> i32 {
        let mask = self.slots.len() - 1;
        let tag = (hash >> 32) as i64;
        let mut s = (hash >> self.shift as u64) as i32;
        loop {
            let slot = self.slots[s];
            if slot == EMPTY {
                return -1;
            }
            if slot as u64 >> 32 == tag as u64 && is_row(slot as i32) {
                return slot as i32;
            }
            s = s + 1 & mask;
        }
    }

    /// The row `is_row` accepts among those indexed under `hash`, or `row`
    /// once it is indexed there.
    pub fn find_or_insert(&mut self, hash: u64, is_row: fn(i32) -> bool, row: i32) -> i32
        contract row >= 0
    {
        let mask = self.slots.len() - 1;
        let tag = (hash >> 32) as i64;
        let mut s = (hash >> self.shift as u64) as i32;
        loop {
            let slot = self.slots[s];
            if slot == EMPTY {
                break;
            }
            if slot as u64 >> 32 == tag as u64 && is_row(slot as i32) {
                return slot as i32;
            }
            s = s + 1 & mask;
        }
        self.put(s, tag << 32 | row as i64);
        return row;
    }

    /// Indexes `row` under `hash`. No row indexed there may equal it.
    pub fn insert(&mut self, hash: u64, row: i32)
        contract row >= 0
    {
        let slot = (hash >> 32 << 32) as i64 | row as i64;
        self.put(self.empty_slot(slot), slot);
    }

    fn put(&mut self, empty: i32, slot: i64) {
        let mut s = empty;
        if (self.count + 1) * 2 > self.slots.len() {
            self.resize(self.slots.len() * 2);
            s = self.empty_slot(slot);
        }
        self.slots[s] = slot;
        self.count += 1;
    }

    fn empty_slot(&self, slot: i64) -> i32 {
        let mask = self.slots.len() - 1;
        let mut s = (slot as u64 >> self.shift as u64) as i32;
        while self.slots[s] != EMPTY {
            s = s + 1 & mask;
        }
        return s;
    }

    fn resize(&mut self, slots: i32)
        contract slots & slots - 1 == 0, "slots must be a power of two"
    {
        let old = self.slots;
        self.slots = Array::<i64>::filled(slots, EMPTY);
        self.shift = shift_for(slots);
        for let s of 0..<old.len() {
            if old[s] != EMPTY {
                self.slots[self.empty_slot(old[s])] = old[s];
            }
        }
    }

    /// Forgets every row. A table far wider than what it held is cut to fit
    /// that, so one large fill does not make every later `clear` pay for its
    /// width.
    pub fn clear(&mut self) {
        if self.count == 0 {
            return;
        }
        if self.slots.len() > self.count * SPARSE_TABLE {
            let mut slots = MIN_SLOTS;
            while slots < self.count * 2 {
                slots *= 2;
            }
            self.slots = Array::<i64>::filled(slots, EMPTY);
            self.shift = shift_for(slots);
        } else {
            self.slots.fill(EMPTY);
        }
        self.count = 0;
    }
}
