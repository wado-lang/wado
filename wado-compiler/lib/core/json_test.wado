    let r = to_string_pretty(&f64::NAN);
    assert r matches { Err(e) && e.kind == SerializeErrorKind::UnsupportedValue };
}

test "write_escaped_string helper" {
    let mut buf = "";
    write_escaped_string(&mut buf, "hello");
    assert buf == `"hello"`;

    buf = "";
    write_escaped_string(&mut buf, "a\"b");
    assert buf == `"a\\"b"`;

    // Control chars below 0x20 (other than \n\r\t) use the \u00xx form.
    buf = "";
    write_escaped_string(&mut buf, "a\u{01}b\u{1f}c");
    assert buf == `"a\\u0001b\\u001fc"`;

    // Multibyte UTF-8 passes through the bulk-copy path untouched.
    buf = "";
    write_escaped_string(&mut buf, "a日本b");
    assert buf == `"a日本b"`;

    // Escapes interleaved with runs on both sides.
    buf = "";
    write_escaped_string(&mut buf, "pre\tmid\\end");
    assert buf == `"pre\\tmid\\\\end"`;
}

test "write_escaped_string finds an escape at every offset of a four-byte block" {
    let specials: List<[String, String]> = [
        ["\"", "\\\""],
        ["\\", "\\\\"],
        ["\u{1f}", "\\u001f"],
        ["日", "日"],
    ];
    for let [raw, escaped] of specials {
        for let at of 0..<9 {
            let mut s = "";
            let mut want = "\"";
            for let k of 0..<9 {
                if k == at {
                    s.push_str(&raw);
                    want.push_str(&escaped);
                } else {
                    s.push('x');
                    want.push('x');
                }
            }
            want.push('"');
            let mut buf = "";
            write_escaped_string(&mut buf, &s);
            assert buf == want;
        }
    }
}

test "deserialize i32" {
    let r: Result<i32, DeserializeError> = from_string("42");
    assert r matches { Ok(v) && v == 42 };
}

test "deserialize negative i32" {
    let r: Result<i32, DeserializeError> = from_string("-7");
    assert r matches { Ok(v) && v == -7 };
}

test "deserialize i32 with whitespace" {
    let r: Result<i32, DeserializeError> = from_string("  42  ");
    assert r matches { Ok(v) && v == 42 };
}

test "deserialize i64" {
    let r: Result<i64, DeserializeError> = from_string("1000000000000");
    assert r matches { Ok(v) && v == 1000000000000 };
}

test "deserialize u32" {
    let r: Result<u32, DeserializeError> = from_string("255");
    assert r matches { Ok(v) && v == 255 };
}

test "deserialize f64" {
    let r: Result<f64, DeserializeError> = from_string("3.14");
    assert r matches { Ok(v) && v == 3.14 };
}

test "deserialize f32 rounds the decimal once" {
    // Just above the midpoint between 1 and the next f32: through f64 it lands
    // on the midpoint and ties to even, down to 1.
    let r: Result<f32, DeserializeError> = from_string("1.000000059604644776");
    assert r matches { Ok(v) && v.to_bits() == 0x3f800001 };
}

test "an f32 is written in its own shortest form, not widened" {
    let tenth: f32 = 0.1;
    assert to_string(&tenth) == Result::Ok("0.1");
    assert_bytes_eq_string(&to_bytes_canonical(&tenth).unwrap(), &"0.1");
    assert_bytes_eq_string(&to_bytes_pretty(&tenth).unwrap(), &"0.1");
    let mut keyed = TreeMap::<f32, i32>::new();
    keyed[tenth] = 1;
    assert to_string(&keyed) == Result::Ok(`{"0.1":1}`);
}

test "every f32 round-trips through its shortest form" {
    let mut state: u32 = 0x9e3779b9;
    for let _ of 0..<20000 {
        state ^= state << 13;
        state ^= state >> 17;
        state ^= state << 5;
        let v = f32::from_bits(state);
        if !v.is_finite() {
            continue;
        }
        let back: f32 = from_string(to_string(&v).unwrap()).unwrap();
        assert back.to_bits() == v.to_bits();
    }
}

test "deserialize f16 and bf16 round the decimal once" {
    // Just above a midpoint that f32 holds exactly: through f32 it ties to even.
    let h: Result<f16, DeserializeError> = from_string("1.00048828125000000000000001");
    assert h matches { Ok(v) && v.to_bits() == 0x3c01 };
    let b: Result<bf16, DeserializeError> = from_string("1.00390625000000000000000001");
    assert b matches { Ok(v) && v.to_bits() == 0x3f81 };
}

test "deserialize f64 cancels a large exponent against the digits' scale" {
    let mut run = String::with_capacity(4000);
    for let mut i = 0; i < 4000; i += 1 {
        run.push('0');
    }
    let small: Result<f64, DeserializeError> = from_string(`0.${run}1e4000`);
    assert small matches { Ok(v) && v == 0.1 };
    let large: Result<f64, DeserializeError> = from_string(`1${run}e-4000`);
    assert large matches { Ok(v) && v == 1.0 };
}

test "deserialize a float past the format's range errors rather than reading infinity" {
    let over: Result<f64, DeserializeError> = from_string("1e400");
    assert over matches { Err(e) && e.kind == DeserializeErrorKind::Overflow && e.offset == 0 };
    let under: Result<f64, DeserializeError> = from_string(" -1e400");
    assert under matches { Err(e) && e.kind == DeserializeErrorKind::Overflow && e.offset == 1 };
    let narrow: Result<f32, DeserializeError> = from_string("3.5e38");
    assert narrow matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    let half: Result<f16, DeserializeError> = from_string("65520");
    assert half matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    let brain: Result<bf16, DeserializeError> = from_string("3.4e39");
    assert brain matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    let dynamic: Result<Value, DeserializeError> = from_string("[1e400]");
    assert dynamic matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    // The largest finite value of each format still reads.
    let max: Result<f64, DeserializeError> = from_string("1.7976931348623157e308");
    assert max matches { Ok(v) && v == f64::MAX };
    let half_max: Result<f16, DeserializeError> = from_string("65519");
    assert half_max matches { Ok(v) && v == f16::MAX };
    // Underflow is no error: it reads as a zero of its sign.
    let tiny: Result<f64, DeserializeError> = from_string("-1e-400");
    assert tiny matches { Ok(v) && v.to_bits() == 0x8000000000000000 };
}

test "deserialize f64 reads digits past the nineteenth" {
    // 1 + 2^-53 exactly is the midpoint and ties to even; one more digit is above it.
    let tie: Result<f64, DeserializeError> = from_string("1.00000000000000011102230246251565404236316680908203125");
    assert tie matches { Ok(v) && v.to_bits() == 0x3ff0000000000000 };
    let above: Result<f64, DeserializeError> = from_string("1.000000000000000111022302462515654042363166809082031251");
    assert above matches { Ok(v) && v.to_bits() == 0x3ff0000000000001 };
}

