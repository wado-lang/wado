// Non-ASCII content takes the UTF-8 validation branch, escape-free and split by `\/`.
test "deserialize raw multibyte string value" {
    let r: Result<String, DeserializeError> = from_string(`"café 日本 🦀"`);
    assert r matches { Ok(v) && v == "café 日本 🦀" };

    let split: Result<String, DeserializeError> = from_string(`"日本\/語"`);
    assert split matches { Ok(v) && v == "日本/語" };
}

test "deserialize string with unicode" {
    let r: Result<String, DeserializeError> = from_string(`"\\u0041"`);
    assert r matches { Ok(v) && v == "A" };
}

