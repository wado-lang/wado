use {
    Serialize,
    Deserialize,
    Serializer,
    Deserializer,
    SerializeStruct,
    DeserializeStruct,
    SerializeError,
    SerializeErrorKind,
    DeserializeError,
    DeserializeErrorKind,
} from "core:serde";
use { TreeMap } from "core:collections";

use { to_string, to_string_pretty, to_bytes, from_string, write_escaped_string, PrettyJsonSerializer } from "core:json";

fn assert_bytes_eq_string(bytes: &Array<u8>, s: &String) {
    let expected: Array<u8> = s.bytes().collect();
    assert bytes.len() == expected.len();
    for let mut i = 0; i < bytes.len(); i += 1 {
        assert bytes[i] == expected[i];
    }
}

struct PrettyUser {
    first_name: String,
    age: i32,
}

impl Serialize for PrettyUser;

enum PrettyColor {
    Red,
    Green,
}

impl Serialize for PrettyColor;

variant PrettyShape {
    Circle(f64),
    Point,
}

impl Serialize for PrettyShape;

test "serialize i32" {
    let n = 42;
    let r = to_string(&n);
    assert r matches { Ok(s) && s == "42" };
}

test "serialize negative i32" {
    let n = -123;
    let r = to_string(&n);
    assert r matches { Ok(s) && s == "-123" };
}

test "serialize i64" {
    let n: i64 = 1000000000000;
    let r = to_string(&n);
    assert r matches { Ok(s) && s == "1000000000000" };
}

test "serialize u32" {
    let n: u32 = 255;
    let r = to_string(&n);
    assert r matches { Ok(s) && s == "255" };
}

test "serialize f64" {
    let n = 3.14;
    let r = to_string(&n);
    assert r matches { Ok(s) && s == "3.14" };
}

test "serialize bool true" {
    let v = true;
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "true" };
}

test "serialize bool false" {
    let v = false;
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "false" };
}

test "serialize string" {
    let v = "hello world";
    let r = to_string(&v);
    assert r matches { Ok(s) && s == `"hello world"` };
}

test "serialize string with escapes" {
    let v = "line1\nline2\ttab";
    let r = to_string(&v);
    assert r matches { Ok(s) && s == `"line1\\nline2\\ttab"` };
}

test "serialize string with quotes" {
    let v = `say "hi"`;
    let r = to_string(&v);
    assert r matches { Ok(s) && s == `"say \\"hi\\""` };
}

test "serialize Option Some" {
    let v: Option<i32> = Option::Some(42);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "42" };
}

test "serialize Option None" {
    let v: Option<i32> = null;
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "null" };
}

test "serialize Array<i32>" {
    let v: Array<i32> = [1, 2, 3];
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "[1,2,3]" };
}

test "serialize empty Array" {
    let v: Array<i32> = [];
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "[]" };
}

test "serialize Array<String>" {
    let v: Array<String> = ["hello", "world"];
    let r = to_string(&v);
    assert r matches { Ok(s) && s == `["hello","world"]` };
}

test "serialize nested Array" {
    let v: Option<Array<i32>> = Option::Some([10, 20]);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "[10,20]" };
}

test "to_bytes scalar matches to_string" {
    let n = 42;
    let bytes = to_bytes(&n).unwrap();
    assert_bytes_eq_string(&bytes, &to_string(&n).unwrap());
}

test "to_bytes struct matches to_string" {
    let user = PrettyUser { first_name: "Alice", age: 30 };
    let bytes = to_bytes(&user).unwrap();
    assert_bytes_eq_string(&bytes, &to_string(&user).unwrap());
}

test "to_bytes string with escapes matches to_string" {
    let v = "line1\nline2\t\"quoted\"";
    let bytes = to_bytes(&v).unwrap();
    assert_bytes_eq_string(&bytes, &to_string(&v).unwrap());
}

test "to_bytes Array<String> matches to_string" {
    let v: Array<String> = ["hello", "世界"];
    let bytes = to_bytes(&v).unwrap();
    assert_bytes_eq_string(&bytes, &to_string(&v).unwrap());
}

test "to_bytes empty string" {
    let v = "";
    let bytes = to_bytes(&v).unwrap();
    assert bytes.len() == 2;
    assert bytes[0] == 34;
    assert bytes[1] == 34;
}

test "serialize pretty struct with default indent" {
    let user = PrettyUser {
        first_name: "Alice",
        age: 30,
    };
    let r = to_string_pretty(&user);
    assert r matches { Ok(s) && s == "{
  \"firstName\": \"Alice\",
  \"age\": 30
}" };
}

test "serialize pretty with custom indent field" {
    let v: Array<Array<i32>> = [[1], [2, 3]];
    let indent = "    ";
    let mut buf = "";
    let mut ser = PrettyJsonSerializer {
        buf: &mut buf,
        indent: &indent,
        depth: 0,
    };
    let r = v.serialize::<PrettyJsonSerializer>(&mut ser);
    assert r matches { Ok };
    assert buf == "[
    [
        1
    ],
    [
        2,
        3
    ]
]";
}

test "serialize pretty empty array" {
    let v: Array<i32> = [];
    let r = to_string_pretty(&v);
    assert r matches { Ok(s) && s == "[]" };
}

test "serialize pretty map" {
    let mut m: TreeMap<String, i32> = TreeMap::new();
    m.insert("a", 1);
    m.insert("b", 2);
    let r = to_string_pretty(&m);
    assert r matches { Ok(s) && s == "{
  \"a\": 1,
  \"b\": 2
}" };
}

test "serialize pretty empty map" {
    let m: TreeMap<String, i32> = TreeMap::new();
    let r = to_string_pretty(&m);
    assert r matches { Ok(s) && s == "{}" };
}

test "serialize pretty unit variant" {
    let c = PrettyColor::Red;
    let r = to_string_pretty(&c);
    assert r matches { Ok(s) && s == `"Red"` };
}

test "serialize pretty payload variant" {
    let s = PrettyShape::Circle(5.0);
    let r = to_string_pretty(&s);
    assert r matches { Ok(v) && v == "{
  \"Circle\": 5
}" };
}

test "serialize pretty f64 nan error" {
    let r = to_string_pretty(&f64::NAN);
    assert r matches { Err(e) && e.kind == SerializeErrorKind::UnsupportedValue };
}

test "write_escaped_string helper" {
    let mut buf = "";
    write_escaped_string(&mut buf, &"hello");
    assert buf == `"hello"`;

    buf = "";
    write_escaped_string(&mut buf, &"a\"b");
    assert buf == `"a\\"b"`;
}

test "deserialize i32" {
    let r: Result<i32, DeserializeError> = from_string("42");
    assert r matches { Ok(v) && v == 42 };
}

test "deserialize negative i32" {
    let r: Result<i32, DeserializeError> = from_string("-7");
    assert r matches { Ok(v) && v == -7 };
}

test "deserialize i32 with whitespace" {
    let r: Result<i32, DeserializeError> = from_string("  42  ");
    assert r matches { Ok(v) && v == 42 };
}

test "deserialize i64" {
    let r: Result<i64, DeserializeError> = from_string("1000000000000");
    assert r matches { Ok(v) && v == 1000000000000 };
}

test "deserialize u32" {
    let r: Result<u32, DeserializeError> = from_string("255");
    assert r matches { Ok(v) && v == 255 };
}

test "deserialize f64" {
    let r: Result<f64, DeserializeError> = from_string("3.14");
    assert r matches { Ok(v) && v == 3.14 };
}

test "deserialize f64 integer" {
    let r: Result<f64, DeserializeError> = from_string("42");
    assert r matches { Ok(v) && v == 42.0 };
}

test "deserialize bool true" {
    let r: Result<bool, DeserializeError> = from_string("true");
    assert r matches { Ok(v) && v == true };
}

test "deserialize bool false" {
    let r: Result<bool, DeserializeError> = from_string("false");
    assert r matches { Ok(v) && v == false };
}

test "deserialize string" {
    let r: Result<String, DeserializeError> = from_string(`"hello"`);
    assert r matches { Ok(v) && v == "hello" };
}

test "deserialize string with escapes" {
    let r: Result<String, DeserializeError> = from_string(`"line1\\nline2"`);
    assert r matches { Ok(v) && v == "line1\nline2" };
}

test "deserialize string with unicode" {
    let r: Result<String, DeserializeError> = from_string(`"\\u0041"`);
    assert r matches { Ok(v) && v == "A" };
}

test "deserialize trailing data error" {
    let r: Result<i32, DeserializeError> = from_string("42 extra");
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::TrailingData };
}

test "deserialize malformed error" {
    let r: Result<i32, DeserializeError> = from_string("abc");
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::UnexpectedType };
}

test "deserialize eof error" {
    let r: Result<String, DeserializeError> = from_string(`"`);
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::Eof };
}
