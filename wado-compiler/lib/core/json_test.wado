use {
    Serialize,
    Deserialize,
    Serializer,
    Deserializer,
    SerializeStruct,
    DeserializeStruct,
    SerializeError,
    DeserializeError,
    DeserializeErrorKind,
} from "core:serde";

use { to_string, from_string, write_escaped_string } from "core:json";

test "serialize i32" {
    let n = 42;
    let r = to_string::<i32>(&n);
    assert r matches { Ok(_) };
    if let Ok(s) = r {
        assert s == "42";
    }
}

test "serialize negative i32" {
    let n = -123;
    let r = to_string::<i32>(&n);
    assert r matches { Ok(_) };
    if let Ok(s) = r {
        assert s == "-123";
    }
}

test "serialize i64" {
    let n = 1000000000000 as i64;
    let r = to_string::<i64>(&n);
    assert r matches { Ok(_) };
    if let Ok(s) = r {
        assert s == "1000000000000";
    }
}

test "serialize u32" {
    let n = 255 as u32;
    let r = to_string::<u32>(&n);
    assert r matches { Ok(_) };
    if let Ok(s) = r {
        assert s == "255";
    }
}

test "serialize f64" {
    let n = 3.14;
    let r = to_string::<f64>(&n);
    assert r matches { Ok(_) };
    if let Ok(s) = r {
        assert s == "3.14";
    }
}

test "serialize bool true" {
    let v = true;
    let r = to_string::<bool>(&v);
    assert r matches { Ok(_) };
    if let Ok(s) = r {
        assert s == "true";
    }
}

test "serialize bool false" {
    let v = false;
    let r = to_string::<bool>(&v);
    assert r matches { Ok(_) };
    if let Ok(s) = r {
        assert s == "false";
    }
}

test "serialize string" {
    let v = "hello world";
    let r = to_string::<String>(&v);
    assert r matches { Ok(_) };
    if let Ok(s) = r {
        assert s == `"hello world"`;
    }
}

test "serialize string with escapes" {
    let v = "line1\nline2\ttab";
    let r = to_string::<String>(&v);
    assert r matches { Ok(_) };
    if let Ok(s) = r {
        assert s == `"line1\\nline2\\ttab"`;
    }
}

test "serialize string with quotes" {
    let v = `say "hi"`;
    let r = to_string::<String>(&v);
    assert r matches { Ok(_) };
    if let Ok(s) = r {
        assert s == `"say \\"hi\\""`;
    }
}

test "serialize Option Some" {
    let v = Option::<i32>::Some(42);
    let r = to_string::<Option<i32>>(&v);
    assert r matches { Ok(_) };
    if let Ok(s) = r {
        assert s == "42";
    }
}

test "serialize Option None" {
    let v: Option<i32> = null;
    let r = to_string::<Option<i32>>(&v);
    assert r matches { Ok(_) };
    if let Ok(s) = r {
        assert s == "null";
    }
}

test "serialize Array<i32>" {
    let v: Array<i32> = [1, 2, 3];
    let r = to_string::<Array<i32>>(&v);
    assert r matches { Ok(_) };
    if let Ok(s) = r {
        assert s == "[1,2,3]";
    }
}

test "serialize empty Array" {
    let v: Array<i32> = [];
    let r = to_string::<Array<i32>>(&v);
    assert r matches { Ok(_) };
    if let Ok(s) = r {
        assert s == "[]";
    }
}

test "serialize Array<String>" {
    let v: Array<String> = ["hello", "world"];
    let r = to_string::<Array<String>>(&v);
    assert r matches { Ok(_) };
    if let Ok(s) = r {
        assert s == `["hello","world"]`;
    }
}

test "serialize nested Array" {
    let v = Option::<Array<i32>>::Some([10, 20]);
    let r = to_string::<Option<Array<i32>>>(&v);
    assert r matches { Ok(_) };
    if let Ok(s) = r {
        assert s == "[10,20]";
    }
}

test "write_escaped_string helper" {
    let mut buf = "";
    write_escaped_string(&mut buf, &"hello");
    assert buf == `"hello"`;

    buf = "";
    write_escaped_string(&mut buf, &"a\"b");
    assert buf == `"a\\"b"`;
}

test "deserialize i32" {
    let r = from_string::<i32>("42");
    assert r matches { Ok(_) };
    if let Ok(v) = r {
        assert v == 42;
    }
}

test "deserialize negative i32" {
    let r = from_string::<i32>("-7");
    assert r matches { Ok(_) };
    if let Ok(v) = r {
        assert v == -7;
    }
}

test "deserialize i32 with whitespace" {
    let r = from_string::<i32>("  42  ");
    assert r matches { Ok(_) };
    if let Ok(v) = r {
        assert v == 42;
    }
}

test "deserialize i64" {
    let r = from_string::<i64>("1000000000000");
    assert r matches { Ok(_) };
    if let Ok(v) = r {
        assert v == 1000000000000 as i64;
    }
}

test "deserialize u32" {
    let r = from_string::<u32>("255");
    assert r matches { Ok(_) };
    if let Ok(v) = r {
        assert v == 255 as u32;
    }
}

test "deserialize f64" {
    let r = from_string::<f64>("3.14");
    assert r matches { Ok(_) };
    if let Ok(v) = r {
        assert v == 3.14;
    }
}

test "deserialize f64 integer" {
    let r = from_string::<f64>("42");
    assert r matches { Ok(_) };
    if let Ok(v) = r {
        assert v == 42.0;
    }
}

test "deserialize bool true" {
    let r = from_string::<bool>("true");
    assert r matches { Ok(_) };
    if let Ok(v) = r {
        assert v == true;
    }
}

test "deserialize bool false" {
    let r = from_string::<bool>("false");
    assert r matches { Ok(_) };
    if let Ok(v) = r {
        assert v == false;
    }
}

test "deserialize string" {
    let r = from_string::<String>(`"hello"`);
    assert r matches { Ok(_) };
    if let Ok(v) = r {
        assert v == "hello";
    }
}

test "deserialize string with escapes" {
    let r = from_string::<String>(`"line1\\nline2"`);
    assert r matches { Ok(_) };
    if let Ok(v) = r {
        assert v == "line1\nline2";
    }
}

test "deserialize string with unicode" {
    let r = from_string::<String>(`"\\u0041"`);
    assert r matches { Ok(_) };
    if let Ok(v) = r {
        assert v == "A";
    }
}

test "deserialize trailing data error" {
    let r: Result<i32, DeserializeError> = from_string::<i32>("42 extra");
    assert r matches { Err(_) };
    if let Err(e) = r {
        let kind: DeserializeErrorKind = e.kind;
        assert kind == DeserializeErrorKind::TrailingData;
    }
}

test "deserialize malformed error" {
    let r: Result<i32, DeserializeError> = from_string::<i32>("abc");
    assert r matches { Err(_) };
    if let Err(e) = r {
        let kind: DeserializeErrorKind = e.kind;
        assert kind == DeserializeErrorKind::UnexpectedType;
    }
}

test "deserialize eof error" {
    let r: Result<String, DeserializeError> = from_string::<String>(`"`);
    assert r matches { Err(_) };
    if let Err(e) = r {
        let kind: DeserializeErrorKind = e.kind;
        assert kind == DeserializeErrorKind::Eof;
    }
}
