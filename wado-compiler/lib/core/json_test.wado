use {
    Serialize,
    Deserialize,
    Serializer,
    Deserializer,
    SerializeStruct,
    SerializeMap,
    DeserializeStruct,
    DeserializeMap,
    DeserializeVariant,
    IgnoredAny,
    SerializeError,
    SerializeErrorKind,
    DeserializeError,
    DeserializeErrorKind,
    DEFAULT_MAX_DEPTH,
} from "core:serde";
use { TreeMap, TreeSet } from "core:collections";

use {
    to_string,
    to_string_pretty,
    to_bytes,
    to_bytes_canonical,
    to_bytes_pretty,
    from_string,
    from_bytes,
    write_escaped_string,
    PrettyJsonSerializer,
    JsonDeserializer,
} from "core:json";
use { Value, to_value } from "core:value";

fn assert_bytes_eq_string<B: AsByteSlice>(bytes: &B, s: &String) {
    let actual = bytes.as_byte_slice();
    let expected: List<u8> = s.bytes().collect();
    assert actual.len() == expected.len();
    for let mut i = 0; i < actual.len(); i += 1 {
        assert actual.get_unchecked(i) == expected[i];
    }
}

struct Utf8Rec {
    a: String,
}
impl Deserialize for Utf8Rec;

#[wire(name_policy = "camelCase")]
struct PrettyUser {
    first_name: String,
    age: i32,
}

impl Serialize for PrettyUser;

enum PrettyColor {
    Red,
    Green,
}

impl Serialize for PrettyColor;

variant PrettyShape {
    Circle(f64),
    Point,
}

impl Serialize for PrettyShape;
impl Deserialize for PrettyShape;

test "serialize i32" {
    let n = 42;
    let r = to_string(&n);
    assert r matches { Ok(s) && s == "42" };
}

test "serialize negative i32" {
    let n = -123;
    let r = to_string(&n);
    assert r matches { Ok(s) && s == "-123" };
}

test "serialize i64" {
    let n: i64 = 1000000000000;
    let r = to_string(&n);
    assert r matches { Ok(s) && s == "1000000000000" };
}

test "serialize u32" {
    let n: u32 = 255;
    let r = to_string(&n);
    assert r matches { Ok(s) && s == "255" };
}

test "serialize f64" {
    let n = 3.14;
    let r = to_string(&n);
    assert r matches { Ok(s) && s == "3.14" };
}

test "serialize bool true" {
    let v = true;
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "true" };
}

test "serialize bool false" {
    let v = false;
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "false" };
}

test "serialize string" {
    let v = "hello world";
    let r = to_string(&v);
    assert r matches { Ok(s) && s == `"hello world"` };
}

test "serialize string with escapes" {
    let v = "line1\nline2\ttab";
    let r = to_string(&v);
    assert r matches { Ok(s) && s == `"line1\\nline2\\ttab"` };
}

test "serialize string with quotes" {
    let v = `say "hi"`;
    let r = to_string(&v);
    assert r matches { Ok(s) && s == `"say \\"hi\\""` };
}

test "serialize Option Some" {
    let v: Option<i32> = Option::Some(42);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "42" };
}

test "serialize Option None" {
    let v: Option<i32> = null;
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "null" };
}

test "serialize List<i32>" {
    let v: List<i32> = [1, 2, 3];
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "[1,2,3]" };
}

test "serialize empty List" {
    let v: List<i32> = [];
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "[]" };
}

test "serialize List<String>" {
    let v: List<String> = ["hello", "world"];
    let r = to_string(&v);
    assert r matches { Ok(s) && s == `["hello","world"]` };
}

test "serialize nested List" {
    let v: Option<List<i32>> = Option::Some([10, 20]);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "[10,20]" };
}

test "to_bytes scalar matches to_string" {
    let n = 42;
    let bytes = to_bytes(&n).unwrap();
    assert_bytes_eq_string(&bytes, &to_string(&n).unwrap());
}

test "to_bytes struct matches to_string" {
    let user = PrettyUser { first_name: "Alice", age: 30 };
    let bytes = to_bytes(&user).unwrap();
    assert_bytes_eq_string(&bytes, &to_string(&user).unwrap());
}

test "to_bytes string with escapes matches to_string" {
    let v = "line1\nline2\t\"quoted\"";
    let bytes = to_bytes(&v).unwrap();
    assert_bytes_eq_string(&bytes, &to_string(&v).unwrap());
}

test "to_bytes List<String> matches to_string" {
    let v: List<String> = ["hello", "世界"];
    let bytes = to_bytes(&v).unwrap();
    assert_bytes_eq_string(&bytes, &to_string(&v).unwrap());
}

test "to_bytes empty string" {
    let v = "";
    let bytes = to_bytes(&v).unwrap();
    assert bytes.len() == 2;
    assert bytes[0] == 34;
    assert bytes[1] == 34;
}

test "to_string default appends no trailing char" {
    let v: List<i32> = [1, 2];
    assert to_string(&v).unwrap() == "[1,2]";
}

test "to_string trailing_char emits JSON Lines" {
    let v: List<i32> = [1, 2];
    assert to_string(&v, Option::Some('\n')).unwrap() == "[1,2]\n";
}

test "to_bytes trailing_char appends to the byte view" {
    let bytes = to_bytes(&42, Option::Some('\n')).unwrap();
    assert_bytes_eq_string(&bytes, &"42\n");
    assert bytes[bytes.len() - 1] == 10;
}

test "serialize pretty struct with default indent" {
    let user = PrettyUser {
        first_name: "Alice",
        age: 30,
    };
    let r = to_string_pretty(&user);
    assert r matches { Ok(s) && s == "{
  \"firstName\": \"Alice\",
  \"age\": 30
}" };
}

test "serialize pretty with custom indent field" {
    let v: List<List<i32>> = [
        [1],
        [2, 3],
    ];
    let indent = "    ";
    let mut buf = "";
    let mut ser = PrettyJsonSerializer {
        buf: &mut buf,
        indent: &indent,
        depth: 0,
    };
    let r = v.serialize::<PrettyJsonSerializer>(&mut ser);
    assert r matches { Ok };
    assert buf == "[
    [
        1
    ],
    [
        2,
        3
    ]
]";
}

test "serialize pretty empty array" {
    let v: List<i32> = [];
    let r = to_string_pretty(&v);
    assert r matches { Ok(s) && s == "[]" };
}

test "serialize pretty map" {
    let mut m: TreeMap<String, i32> = TreeMap::new();
    m["a"] = 1;
    m["b"] = 2;
    let r = to_string_pretty(&m);
    assert r matches { Ok(s) && s == "{
  \"a\": 1,
  \"b\": 2
}" };
}

test "serialize pretty empty map" {
    let m: TreeMap<String, i32> = TreeMap::new();
    let r = to_string_pretty(&m);
    assert r matches { Ok(s) && s == "{}" };
}

test "serialize pretty unit variant" {
    let c = PrettyColor::Red;
    let r = to_string_pretty(&c);
