test "deserialize integer from scientific notation" {
    let a: Result<i32, DeserializeError> = from_string("1e2");
    assert a matches { Ok(v) && v == 100 };
    let b: Result<i64, DeserializeError> = from_string("1.5e3");
    assert b matches { Ok(v) && v == 1500 };
}

test "deserialize scientific notation overflow errors" {
    let a: Result<i32, DeserializeError> = from_string("3e9");
    assert a matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    let b: Result<i64, DeserializeError> = from_string("1e30");
    assert b matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    let c: Result<u64, DeserializeError> = from_string("1e30");
    assert c matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
}

test "deserialize string-encoded scientific overflow errors" {
    let a: Result<i64, DeserializeError> = from_string(`"1e30"`);
    assert a matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    let b: Result<u64, DeserializeError> = from_string(`"1e30"`);
    assert b matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
}

test "deserialize surrogate pair" {
    let emoji: Result<String, DeserializeError> = from_string(`"\\uD83D\\uDE00"`);
    assert emoji matches { Ok(v) && v == "😀" };
    let clef: Result<String, DeserializeError> = from_string(`"\\uD834\\uDD1E"`);
    assert clef matches { Ok(v) && v == "𝄞" };
}

test "deserialize unpaired surrogate errors" {
    let lone_high: Result<String, DeserializeError> = from_string(`"\\uD800"`);
    assert lone_high matches { Err(e) && e.kind == DeserializeErrorKind::MalformedInput };
    let lone_low: Result<String, DeserializeError> = from_string(`"\\uDC00"`);
    assert lone_low matches { Err(e) && e.kind == DeserializeErrorKind::MalformedInput };
    let no_pair: Result<String, DeserializeError> = from_string(`"\\uD800x"`);
    assert no_pair matches { Err(e) && e.kind == DeserializeErrorKind::MalformedInput };
}

test "every integer type reads a number by one rule" {
    // The string form, at every width.
    assert from_string::<i32>(`"5"`) matches { Ok(5) };
    assert from_string::<u32>(`"5"`) matches { Ok(5) };
    // A fraction or an exponent, at every width.
    assert from_string::<i128>("1e2") matches { Ok(100) };
    assert from_string::<u128>("2.5e1") matches { Ok(25) };
    assert from_string::<i64>("0.5e1") matches { Ok(5) };
    assert from_string::<i64>("-150e-1") matches { Ok(-15) };
    let half: Result<i128, DeserializeError> = from_string("1.5");
    assert half matches { Err(e) && e.kind == DeserializeErrorKind::UnexpectedType };
    // A negative zero is zero, unsigned or not; any other negative is not.
    assert from_string::<u64>("-0") matches { Ok(0) };
    assert from_string::<u128>(`"-0.0e5"`) matches { Ok(0) };
    let neg: Result<u64, DeserializeError> = from_string("-1e0");
    assert neg matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    // Exact past 2^53, where a detour through f64 would round.
    assert from_string::<i64>("1234567890123456789e0") matches { Ok(1234567890123456789) };
    assert from_string::<i64>(`"1.234567890123456789e18"`) matches { Ok(1234567890123456789) };
    assert from_string::<u128>("3.40282366920938463463374607431768211455e38") matches { Ok(v) && v == u128::MAX };
    // An exponent far out of range costs nothing to reject.
    let huge: Result<i64, DeserializeError> = from_string("1e999999999");
    assert huge matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    let tiny: Result<i64, DeserializeError> = from_string("1e-999999999");
    assert tiny matches { Err(e) && e.kind == DeserializeErrorKind::UnexpectedType };
    assert from_string::<i64>("0e999999999") matches { Ok(0) };
}

test "serialize i128 and u128 as a string whatever the value" {
    assert to_string(&5_i128) matches { Ok(s) && s == `"5"` };
    assert to_string(&5_u128) matches { Ok(s) && s == `"5"` };
}

test "deserialize i128 range limits" {
    let max: Result<i128, DeserializeError> = from_string("170141183460469231731687303715884105727");
    assert max matches { Ok(_) };
    if let Ok(v) = max {
        assert to_string(&v) matches { Ok(s) && s == `"170141183460469231731687303715884105727"` };
    }
    let min: Result<i128, DeserializeError> = from_string("-170141183460469231731687303715884105728");
    assert min matches { Ok(_) };
    if let Ok(v) = min {
        assert to_string(&v) matches { Ok(s) && s == `"-170141183460469231731687303715884105728"` };
    }
}

test "deserialize i128 overflow errors" {
    let over: Result<i128, DeserializeError> = from_string("170141183460469231731687303715884105728");
    assert over matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    let under: Result<i128, DeserializeError> = from_string("-170141183460469231731687303715884105729");
    assert under matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    let str_over: Result<i128, DeserializeError> = from_string(`"170141183460469231731687303715884105728"`);
    assert str_over matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
}

test "deserialize i128 rejects non-numeric input" {
    let arr: Result<i128, DeserializeError> = from_string("[]");
    assert arr matches { Err(e) && e.kind == DeserializeErrorKind::UnexpectedType };
    let dash: Result<i128, DeserializeError> = from_string(`"-"`);
    assert dash matches { Err(e) && e.kind == DeserializeErrorKind::UnexpectedType };
    let empty: Result<i128, DeserializeError> = from_string(`""`);
    assert empty matches { Err(e) && e.kind == DeserializeErrorKind::UnexpectedType };
}

test "deserialize u128 full range" {
    let max: Result<u128, DeserializeError> = from_string("340282366920938463463374607431768211455");
    assert max matches { Ok(_) };
    if let Ok(v) = max {
        assert to_string(&v) matches { Ok(s) && s == `"340282366920938463463374607431768211455"` };
    }
}

test "deserialize u128 overflow and negative errors" {
    let over: Result<u128, DeserializeError> = from_string("340282366920938463463374607431768211456");
    assert over matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    let neg: Result<u128, DeserializeError> = from_string("-1");
    assert neg matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
}

test "deserialize f64 keeps scale when dropping excess fraction digits" {
    let r: Result<f64, DeserializeError> = from_string("1234567890.12345678901234567890");
    assert r matches { Ok(v) && 1234567890.0 < v < 1234567891.0 };
}

test "deserialize f64 long integer part with fraction" {
    let r: Result<f64, DeserializeError> = from_string("12345678901234567890123.5");
    assert r matches { Ok(v) && 12000000000000000000000.0 < v < 13000000000000000000000.0 };
}

test "deserialize f64 with many leading fraction zeros" {
    // Leading zeros must shift the scale, not consume the 19-digit mantissa
    // budget — otherwise the lone significant digit is lost and the value
    // collapses to 0.
    let tiny: Result<f64, DeserializeError> = from_string("0.0000000000000000000001");
    assert tiny matches { Ok(v) && 0.9e-22 < v < 1.1e-22 };
    let small: Result<f64, DeserializeError> = from_string("0.00000000000000000012345");
    assert small matches { Ok(v) && 1.0e-19 < v < 1.5e-19 };
    let mixed: Result<f64, DeserializeError> = from_string("0.0105");
    assert mixed matches { Ok(v) && 0.01049 < v < 0.01051 };
}

test "serialize i64 beyond safe integer range as string" {
    let big: i64 = 9007199254740993;
    assert to_string(&big) matches { Ok(s) && s == `"9007199254740993"` };
    let neg: i64 = -9007199254740993;
    assert to_string(&neg) matches { Ok(s) && s == `"-9007199254740993"` };
    let safe: i64 = 9007199254740991;
    assert to_string(&safe) matches { Ok(s) && s == "9007199254740991" };
}

test "deserialize variant object with extra pair errors" {
    // External tagging is a single-pair object; the access's end() reports the
    // unbalanced '}' and the synthesized impl must propagate that error
    // (its Result used to be discarded).
    let ok: Result<PrettyShape, DeserializeError> = from_string(`{"Circle":1.5}`);
    assert ok matches { Ok(v) && v == PrettyShape::Circle(1.5) };
    let extra: Result<PrettyShape, DeserializeError> = from_string(`{"Circle":1.5,"Point":null}`);
    assert extra matches { Err(e) && e.kind == DeserializeErrorKind::MalformedInput };
}

test "serialize u64 beyond safe integer range as string" {
    let big: u64 = 18446744073709551615;
    assert to_string(&big) matches { Ok(s) && s == `"18446744073709551615"` };
    let safe: u64 = 9007199254740991;
    assert to_string(&safe) matches { Ok(s) && s == "9007199254740991" };
}

struct CanonInner {
    z: i32,
    a: i32,
}

impl Serialize for CanonInner;

struct CanonOuter {
    m: CanonInner,
}

impl Serialize for CanonOuter;

test "from_bytes accepts a String via AsByteSlice" {
    let r: Result<TreeMap<String, i32>, DeserializeError> = from_bytes("{\"y\":2}");
    assert r matches { Ok(_) };
    if let Ok(m) = r {
        assert m["y"] == 2;
    }
}

test "from_bytes parses a ByteList" {
    let bytes: ByteList = [0x7b, 0x22, 0x78, 0x22, 0x3a, 0x31, 0x7d];  // {"x":1}
    let r: Result<TreeMap<String, i32>, DeserializeError> = from_bytes(bytes);
    assert r matches { Ok(_) };
    if let Ok(m) = r {
        assert m["x"] == 1;
    }
}

test "from_bytes rejects invalid UTF-8" {
    let bytes: ByteList = [0x7b, 0x22, 0xff, 0x22, 0x7d];  // {"<0xff>"}
    let r: Result<TreeMap<String, i32>, DeserializeError> = from_bytes(bytes);
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::MalformedInput };
}

test "from_bytes rejects invalid UTF-8 after ASCII prefix" {
    let bytes: ByteList = [0x22, 0x61, 0x62, 0xff, 0x22];  // "ab<0xff>"
    let r: Result<String, DeserializeError> = from_bytes(bytes);
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::MalformedInput };

    let bytes2: ByteList = [0x22, 0x78, 0xc3, 0x22];  // "x<0xc3>" truncated lead
    let r2: Result<String, DeserializeError> = from_bytes(bytes2);
    assert r2 matches { Err(e) && e.kind == DeserializeErrorKind::MalformedInput };
}

// Encoding rules that only apply to a whole sequence must still reject.
test "from_bytes validates multibyte sequences during the scan" {
    // A 4-byte scalar immediately before the closing quote.
    let emoji: Result<String, DeserializeError> = from_string(`"🦀"`);
    assert emoji matches { Ok(v) && v == "🦀" };

    // Overlong 2-byte encoding of NUL (C0 80).
    let overlong: ByteList = [0x22, 0xc0, 0x80, 0x22];
    let r1: Result<String, DeserializeError> = from_bytes(overlong);
    assert r1 matches { Err(e) && e.kind == DeserializeErrorKind::MalformedInput };

    // UTF-16 surrogate half (ED A0 80).
    let surrogate: ByteList = [0x22, 0xed, 0xa0, 0x80, 0x22];
    let r2: Result<String, DeserializeError> = from_bytes(surrogate);
    assert r2 matches { Err(e) && e.kind == DeserializeErrorKind::MalformedInput };

    // Beyond U+10FFFF (F5 80 80 80).
    let too_big: ByteList = [0x22, 0xf5, 0x80, 0x80, 0x80, 0x22];
    let r3: Result<String, DeserializeError> = from_bytes(too_big);
    assert r3 matches { Err(e) && e.kind == DeserializeErrorKind::MalformedInput };

    // A bad byte directly before an escape must not swallow the escape.
    let before_escape: ByteList = [0x22, 0xff, 0x5c, 0x6e, 0x22];  // "<0xff>\n"
    let r4: Result<String, DeserializeError> = from_bytes(before_escape);
    assert r4 matches { Err(e) && e.kind == DeserializeErrorKind::MalformedInput };

    // Multibyte content on both sides of an escape (the chunked slow path).
    let around: Result<String, DeserializeError> = from_string(`"日\\n本"`);
    assert around matches { Ok(v) && v == "日\n本" };
}

// UTF-8 validity must not depend on whether the schema names the field: a
// skipped value and a key are string tokens too.
test "from_bytes rejects invalid UTF-8 outside materialized values" {
    // {"b":"<0xff>","a":"x"} -- bad byte inside a field `Rec` does not declare
    let skipped: ByteList = [
        0x7b, 0x22, 0x62, 0x22, 0x3a, 0x22, 0xff, 0x22, 0x2c, 0x22, 0x61, 0x22, 0x3a, 0x22, 0x78, 0x22, 0x7d,
    ];
    let r: Result<Utf8Rec, DeserializeError> = from_bytes(skipped);
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::MalformedInput };

    // {"<0xff>":"x","a":"y"} -- bad byte inside a key
    let key: ByteList = [
        0x7b, 0x22, 0xff, 0x22, 0x3a, 0x22, 0x78, 0x22, 0x2c, 0x22, 0x61, 0x22, 0x3a, 0x22, 0x79, 0x22, 0x7d,
    ];
    let r2: Result<Utf8Rec, DeserializeError> = from_bytes(key);
    assert r2 matches { Err(e) && e.kind == DeserializeErrorKind::MalformedInput };

    // A skipped field with valid multibyte content still round-trips.
    let ok: Result<Utf8Rec, DeserializeError> = from_string(`{"b":"\u65e5\u672c","a":"x"}`);
    assert ok matches { Ok(v) && v.a == "x" };
}

test "to_bytes_canonical sorts map keys" {
    let mut m: TreeMap<String, i32> = TreeMap::new();
    m["banana"] = 2;
    m["apple"] = 1;
    m["cherry"] = 3;
    let r = to_bytes_canonical(&m);
    assert r matches { Ok(_) };
    if let Ok(b) = r {
        assert_bytes_eq_string(&b, &"{\"apple\":1,\"banana\":2,\"cherry\":3}");
    }
}

test "to_bytes_canonical sorts struct fields" {
    let u = PrettyUser { first_name: "Ann", age: 30 };
    let r = to_bytes_canonical(&u);
    assert r matches { Ok(_) };
    if let Ok(b) = r {
        assert_bytes_eq_string(&b, &"{\"age\":30,\"firstName\":\"Ann\"}");
    }
}

test "to_bytes_canonical sorts nested struct fields recursively" {
    let o = CanonOuter {
        m: CanonInner { z: 1, a: 2 },
    };
    let r = to_bytes_canonical(&o);
    assert r matches { Ok(_) };
    if let Ok(b) = r {
        assert_bytes_eq_string(&b, &"{\"m\":{\"a\":2,\"z\":1}}");
    }
}

fn canonical_text<T: Serialize>(value: &T) -> String {
    return String::from_utf8_slice(to_bytes_canonical(value).unwrap()).unwrap();
}

fn canonical_of_text(json: String) -> String {
    return canonical_text(&from_string::<Value>(json).unwrap());
}

// RFC 8785 §3.2.4.
test "to_bytes_canonical writes the RFC 8785 example" {
    let input = `{"numbers":[333333333.33333329,1E30,4.50,2e-3,0.000000000000000000000000001],"string":"\\u20ac$\\u000F\\u000aA'\\u0042\\u0022\\u005c\\\\\\"\\/","literals":[null,true,false]}`;
    assert canonical_of_text(input) == `{"literals":[null,true,false],"numbers":[333333333.3333333,1e+30,4.5,0.002,1e-27],"string":"€$\\u000f\\nA'B\\"\\\\\\\\\\"/"}`;
}

// RFC 8785 §3.2.3: keys sort by their UTF-16 code units, unescaped.
test "to_bytes_canonical sorts keys by UTF-16 code units" {
    let input = `{"\\u20ac":"Euro Sign","\\r":"Carriage Return","\\ufb33":"Hebrew Letter Dalet With Dagesh","1":"One","\\ud83d\\ude00":"Emoji: Grinning Face","\\u0080":"Control","\\u00f6":"Latin Small Letter O With Diaeresis"}`;
    assert canonical_of_text(input) == `{"\\r":"Carriage Return","1":"One","\u{80}":"Control","ö":"Latin Small Letter O With Diaeresis","€":"Euro Sign","😀":"Emoji: Grinning Face","\u{fb33}":"Hebrew Letter Dalet With Dagesh"}`;
    assert canonical_of_text(`{"a\\u0001":1,"a\\"":2,"a#":3,"a":4}`) == `{"a":4,"a\\u0001":1,"a\\"":2,"a#":3}`;
}

// RFC 8785 §3.2.2.3: a number is written as ECMAScript's `Number.prototype.toString`.
test "to_bytes_canonical writes numbers in the ECMAScript form" {
    let cases: List<[f64, String]> = [
        [0.0, "0"],
        [-0.0, "0"],
        [1.0e21, "1e+21"],
        [1.0e20, "100000000000000000000"],
        [1.0e23, "1e+23"],
        [1.0e-7, "1e-7"],
        [0.000001, "0.000001"],
        [1.23e-18, "1.23e-18"],
        [-1.5e-9, "-1.5e-9"],
        [5e-324, "5e-324"],
        [f64::MAX, "1.7976931348623157e+308"],
        [4.5, "4.5"],
        [-12.0, "-12"],
    ];
    for let [v, text] of cases {
        assert canonical_text(&v) == text;
    }
    assert canonical_text(&f32::MAX) == "3.4028235e+38";
    assert canonical_text(&1.0e-7_f32) == "1e-7";
    assert canonical_text(&-0.0_f32) == "0";
    assert canonical_text(&-2.5_f32) == "-2.5";
    assert to_bytes_canonical(&f32::INFINITY).unwrap_err() == SerializeError::unsupported_value(
        "Infinity is not allowed in JSON",
    );
}

test "every writer escapes as ECMAScript's JSON.stringify" {
    let text = "\u{8}\u{c}\u{1f}\u{7f}";
    let escaped = `"\\b\\f\\u001f\u{7f}"`;
    assert to_string(&text) == Result::Ok(escaped);
    assert to_string_pretty(&text) == Result::Ok(escaped);
    assert canonical_text(&text) == escaped;
}

test "to_bytes_canonical sorts keys past U+FFFF by their surrogates" {
    let mut m: TreeMap<String, i32> = TreeMap::new();
    m["\u{ffff}"] = 1;
    m["\u{1f601}"] = 2;
    m["\u{e000}"] = 3;
    m["\u{1f600}"] = 4;
    m["\u{10000}"] = 5;
    m["\u{1f600}a"] = 6;
    assert canonical_text(&m) == `{"\u{10000}":5,"\u{1f600}":4,"\u{1f600}a":6,"\u{1f601}":2,"\u{e000}":3,"\u{ffff}":1}`;
}

test "to_bytes_canonical sorts a scalar key by its text" {
    let mut m: TreeMap<char, i32> = TreeMap::new();
    m['b'] = 1;
    m['"'] = 2;
    m['\u{1}'] = 3;
    assert canonical_text(&m) == `{"\\u0001":3,"\\"":2,"b":1}`;
}

test "to_bytes_pretty matches to_string_pretty" {
    let u = PrettyUser { first_name: "Bo", age: 5 };
    let pretty = to_bytes_pretty(&u);
    assert pretty matches { Ok(_) };
    if let Ok(b) = pretty {
        if let Ok(s) = to_string_pretty(&u) {
            assert_bytes_eq_string(&b, &s);
        }
    }
}

test "to_bytes_pretty trailing_char appends" {
    let u = PrettyUser { first_name: "Bo", age: 5 };
    let b = to_bytes_pretty(&u, Option::Some('\n')).unwrap();
    assert b[b.len() - 1] == 10;
    if let Ok(s) = to_string_pretty(&u, Option::Some('\n')) {
        assert_bytes_eq_string(&b, &s);
    }
}

test "to_bytes_canonical default omits trailing char (signing-safe)" {
    let u = PrettyUser { first_name: "Ann", age: 30 };
    let b = to_bytes_canonical(&u).unwrap();
    assert_bytes_eq_string(&b, &"{\"age\":30,\"firstName\":\"Ann\"}");
}

test "to_bytes_canonical trailing_char appends" {
    let u = PrettyUser { first_name: "Ann", age: 30 };
    let b = to_bytes_canonical(&u, Option::Some('\n')).unwrap();
    assert_bytes_eq_string(&b, &"{\"age\":30,\"firstName\":\"Ann\"}\n");
}

struct Ack {
    id: i32,
    ok: (),
}

test "a unit payload round-trips through the null it wrote" {
    let value: Result<(), DeserializeErrorKind> = Result::Ok(());
    let text = to_string(&value).unwrap();
    assert text == `{"Ok":null}`;
    let back: Result<Result<(), DeserializeErrorKind>, DeserializeError> = from_string(text);
    assert back matches { Ok(Ok(_)) };
}

test "a unit struct field round-trips" {
    let a = Ack { id: 7, ok: () };
    let text = to_string(&a).unwrap();
    assert text == `{"id":7,"ok":null}`;
    let back: Result<Ack, DeserializeError> = from_string(text);
    assert back matches { Ok(_) };
    if let Ok(v) = back {
        assert v.id == 7;
    }
}

test "Option<()> collapses, as it does in Rust serde" {
    // `()` and `None` are both null on the wire, so the pair carries nothing.
    let some_unit = to_string(&Option::Some(())).unwrap();
    let none_unit: Option<()> = Option::None;
    assert some_unit == `null`;
    assert to_string(&none_unit).unwrap() == `null`;

    let back: Result<Option<()>, DeserializeError> = from_string(some_unit);
    assert back matches { Ok(None) };
}

fn nested(depth: i32, open: char, close: char) -> String {
    let mut s = String::new();
    for let mut i = 0; i < depth; i += 1 {
        s.push(open);
    }
    for let mut i = 0; i < depth; i += 1 {
        s.push(close);
    }
    return s;
}

test "nesting up to the default depth limit is accepted" {
    let text = nested(DEFAULT_MAX_DEPTH, '[', ']');
    let r: Result<Value, DeserializeError> = from_string(text);
    assert r matches { Ok(_) };
}

test "nesting past the default depth limit is an error, not a trap" {
    let text = nested(DEFAULT_MAX_DEPTH + 1, '[', ']');
    let r: Result<Value, DeserializeError> = from_string(text);
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::DepthLimitExceeded };
}

test "an object nests as deeply as an array" {
    let mut deep = String::new();
    for let mut i = 0; i < DEFAULT_MAX_DEPTH + 1; i += 1 {
        deep.push_str(`{"a":`);
    }
    deep.push('1');
    for let mut i = 0; i < DEFAULT_MAX_DEPTH + 1; i += 1 {
        deep.push('}');
    }
    let r: Result<Value, DeserializeError> = from_string(deep);
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::DepthLimitExceeded };
}

test "a skipped unknown member is depth-limited too" {
    let mut text = String::new();
    text.push_str(`{"unknown":`);
    text.push_str(&nested(DEFAULT_MAX_DEPTH + 1, '[', ']'));
    text.push_str(`,"a":"x"}`);
    let r: Result<Utf8Rec, DeserializeError> = from_string(text);
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::DepthLimitExceeded };
}

test "max_depth is caller-tunable" {
    let text = nested(8, '[', ']');
    assert from_bytes::<Value, String>(text, 8) matches { Ok(_) };
    assert from_bytes::<Value, String>(text, 7) matches { Err(_) };
    assert from_string::<Value>(text, 7) matches { Err(_) };
}

test "sibling containers do not accumulate depth" {
    let mut text = String::new();
    text.push('[');
    for let mut i = 0; i < 200; i += 1 {
        if i > 0 {
            text.push(',');
        }
        text.push_str("[1]");
    }
    text.push(']');
    let r: Result<Value, DeserializeError> = from_string(text);
    assert r matches { Ok(_) };
}

struct Dup {
    a: i32,
    b: i32 = 9,
}
impl Deserialize for Dup;

test "a repeated field is rejected by default" {
    let r: Result<Dup, DeserializeError> = from_string(`{"a":1,"b":2,"a":3}`);
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::DuplicateField };
}

test "a field repeated onto its declared default is still a duplicate" {
    let r: Result<Dup, DeserializeError> = from_string(`{"a":1,"b":2,"b":3}`);
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::DuplicateField };
}

test "distinct fields are not duplicates" {
    let r: Result<Dup, DeserializeError> = from_string(`{"a":1,"b":2}`);
    assert r matches { Ok(d) && d.a == 1 && d.b == 2 };
}

test "an omitted field keeps its declared default" {
    let r: Result<Dup, DeserializeError> = from_string(`{"a":1}`);
    assert r matches { Ok(d) && d.b == 9 };
}

test "a repeated unknown member is not a duplicate" {
    let r: Result<Dup, DeserializeError> = from_string(`{"a":1,"z":1,"z":2}`);
    assert r matches { Ok(d) && d.a == 1 };
}

test "the duplicate error names the wire key alike for a struct, a map and a Value" {
    let input = `{"a":1,"a":2}`;
    assert from_string::<Dup>(input) matches { Err(e) && e.message == `duplicate field: "a"` };
    assert from_string::<TreeMap<String, i32>>(input) matches { Err(e) && e.message == `duplicate field: "a"` };
    assert from_string::<Value>(input) matches { Err(e) && e.message == `duplicate field: "a"` };
    assert from_string::<TreeMap<i32, i32>>(`{"1":1,"1":2}`) matches { Err(e) && e.message == "duplicate field: 1" };
}

test "a repeated map key is rejected by default" {
    let r: Result<TreeMap<String, i32>, DeserializeError> = from_string(`{"a":1,"a":2}`);
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::DuplicateField };
}

test "a repeated Value key is rejected by default" {
    let r: Result<Value, DeserializeError> = from_string(`{"role":"user","role":"admin"}`);
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::DuplicateField };
}

test "a repeated key nested inside a Value is rejected" {
    let r: Result<Value, DeserializeError> = from_string(`{"outer":{"a":1,"a":2}}`);
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::DuplicateField };
}

test "distinct map keys still parse" {
    let r: Result<TreeMap<String, i32>, DeserializeError> = from_string(`{"a":1,"b":2}`);
    assert r matches { Ok(m) && m.len() == 2 };
}

test "a repeated key in a nested map is rejected" {
    let r: Result<TreeMap<String, Value>, DeserializeError> = from_string(`{"a":{"b":1,"b":2}}`);
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::DuplicateField };
}

test "a scalar map key is written as the string of its spelling" {
    let mut ints = TreeMap::<i32, String>::new();
    ints[2] = "two";
    ints[-10] = "minus ten";
    assert to_string(&ints) == Result::Ok(`{"2":"two","-10":"minus ten"}`);
    assert to_string_pretty(&ints) == Result::Ok("{\n  \"2\": \"two\",\n  \"-10\": \"minus ten\"\n}");
    let mut wide = TreeMap::<u64, i32>::new();
    wide[u64::MAX] = 1;
    assert to_string(&wide) == Result::Ok(`{"18446744073709551615":1}`);
    let mut flags = TreeMap::<bool, i32>::new();
    flags[true] = 1;
    flags[false] = 0;
    assert to_string(&flags) == Result::Ok(`{"true":1,"false":0}`);
    let mut chars = TreeMap::<char, i32>::new();
    chars['"'] = 1;
    assert to_string(&chars) == Result::Ok(`{"\\"":1}`);
    let mut floats = TreeMap::<f64, i32>::new();
    floats[1.5] = 1;
    assert to_string(&floats) == Result::Ok(`{"1.5":1}`);
}

test "a scalar map key reads back from its string" {
    let ints: TreeMap<i32, String> = from_string(`{"2":"two","-10":"minus ten"}`).unwrap();
    assert ints.len() == 2 && ints[2] == "two" && ints[-10] == "minus ten";
    let wide: TreeMap<u128, i32> = from_string(`{"340282366920938463463374607431768211455":1}`).unwrap();
    assert wide[u128::MAX] == 1;
    let flags: TreeMap<bool, i32> = from_string(`{"true":1}`).unwrap();
    assert flags[true] == 1;
    let chars: TreeMap<char, i32> = from_string(`{"\\u00e9":1}`).unwrap();
    assert chars['é'] == 1;
}

/// Asserts a one-entry map keyed by `key` spells it `spelling`, reads that
/// back, and refuses a key that is not a string.
fn assert_key_round_trips<K: Ord + Serialize + Deserialize + Inspect>(key: K, spelling: String) {
    let mut m = TreeMap::<K, i32>::new();
    m[key] = 1;
    let text = `{"${spelling}":1}`;
    assert to_string(&m) == Result::Ok(text);
    assert from_string::<TreeMap<K, i32>>(text) matches { Ok(back) && back.get(key) == Option::Some(1) };
    assert de_err::<TreeMap<K, i32>>("{1:1}").kind == DeserializeErrorKind::UnexpectedType;
}

test "every scalar key width round-trips through its spelling" {
    assert_key_round_trips(i64::MIN, "-9223372036854775808");
    assert_key_round_trips(u32::MAX, "4294967295");
    assert_key_round_trips(u64::MAX, "18446744073709551615");
    assert_key_round_trips(i128::MIN, "-170141183460469231731687303715884105728");
    assert_key_round_trips(u128::MAX, "340282366920938463463374607431768211455");
    let single: f32 = 1.5;
    assert_key_round_trips(single, "1.5");
    assert_key_round_trips(-0.25, "-0.25");
    let half: f16 = 2.5;
    assert_key_round_trips(half, "2.5");
    let brain: bf16 = -3.0;
    assert_key_round_trips(brain, "-3");
    assert_key_round_trips(true, "true");
    assert_key_round_trips('x', "x");
}

test "a numeric map key holds a number by the rules a bare one is" {
    // As serde_json reads and writes one.
    assert key_write_error(f64::NAN) == SerializeErrorKind::UnsupportedValue;
    assert key_write_error(f64::INFINITY) == SerializeErrorKind::UnsupportedValue;
    assert key_write_error(f32::NEG_INFINITY) == SerializeErrorKind::UnsupportedValue;
    assert de_err::<TreeMap<f64, i32>>(`{"NaN":1}`).kind == DeserializeErrorKind::InvalidValue;
    assert de_err::<TreeMap<f64, i32>>(`{"inf":1}`).kind == DeserializeErrorKind::InvalidValue;
    let over = de_err::<TreeMap<f64, i32>>(`{"1e400":1}`);
    assert over.kind == DeserializeErrorKind::Overflow && over.offset == 1;
    assert de_err::<TreeMap<i32, i32>>(`{"+5":1}`).kind == DeserializeErrorKind::InvalidValue;
    assert de_err::<TreeMap<i32, i32>>(`{"5 ":1}`).kind == DeserializeErrorKind::InvalidValue;
    assert de_err::<TreeMap<i32, i32>>(`{"1.5":1}`).kind == DeserializeErrorKind::UnexpectedType;
    assert from_string::<TreeMap<i32, i32>>(`{"1e2":1}`) matches { Ok(m) && m.get(100) == Option::Some(1) };
    // core:value has no number rules to hold a key to, so it keeps the spelling.
    let mut keyed = TreeMap::<f64, i32>::new();
    keyed[f64::NAN] = 1;
    assert to_value(&keyed) matches { Ok(Object(o)) && o.contains_key("NaN") };
}

test "a map key that does not parse as its type names the key" {
    let e = de_err::<TreeMap<i32, i32>>(`{"x":1}`);
    assert e.kind == DeserializeErrorKind::InvalidValue && e.offset == 1;
    assert e.message.contains("\"x\"") && e.message.contains("i32");
    let chars = de_err::<TreeMap<char, i32>>(`{"ab":1}`);
    assert chars.kind == DeserializeErrorKind::InvalidValue && chars.message.contains("\"ab\"");
    assert de_err::<TreeMap<i32, i32>>(`{1:1}`).kind == DeserializeErrorKind::UnexpectedType;
}

test "a repeated scalar key is rejected like a string one" {
    let e = de_err::<TreeMap<i32, i32>>(`{"1":1,"1.0":2}`);
    assert e.kind == DeserializeErrorKind::DuplicateField;
}

struct Pair {
    a: i32,
    b: i32,
}

/// A one-entry map whose key need not be `Ord`, as a `TreeMap`'s must.
struct OneEntry<K> {
    key: K,
}

// Only a key the map refuses reaches these, so nothing after it runs.
#[coverage(off)]
impl<K: Serialize> Serialize for OneEntry<K> {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let mut m = s.begin_map(1)?;
        m.key(&self.key)?;
        m.value(&0)?;
        return m.end();
    }
}

#[coverage(off)]
impl<K: Deserialize> Deserialize for OneEntry<K> {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<OneEntry<K>, DeserializeError> {
        let mut m = d.begin_map()?;
        let key = m.next_key::<K>()?;
        return Result::Ok(OneEntry { key: key.unwrap() });
    }
}

/// What writing a one-entry map keyed by `key` fails with.
fn key_write_error<K: Serialize>(key: K) -> SerializeErrorKind {
    return to_string(&OneEntry { key }).unwrap_err().kind;
}

/// What reading `{"a":1}` with its key as `K` fails with.
fn key_read_error<K: Deserialize>() -> DeserializeErrorKind {
    return de_err::<OneEntry<K>>(`{"a":1}`).kind;
}

test "a compound map key is refused both ways" {
    let mut pairs = TreeMap::<Pair, i32>::new();
    pairs[Pair { a: 1, b: 2 }] = 3;
    assert to_string(&pairs) matches { Err(e) && e.kind == SerializeErrorKind::UnsupportedValue };
    assert to_bytes_canonical(&pairs) matches { Err(e) && e.kind == SerializeErrorKind::UnsupportedValue };
    assert to_string_pretty(&pairs) matches { Err(e) && e.kind == SerializeErrorKind::UnsupportedValue };
    assert key_write_error([1] as List<i32>) == SerializeErrorKind::UnsupportedValue;
    assert key_write_error([1] as TreeSet<i32>) == SerializeErrorKind::UnsupportedValue;
    assert key_write_error(TreeMap::<String, i32>::new()) == SerializeErrorKind::UnsupportedValue;
    assert key_write_error(PrettyShape::Point) == SerializeErrorKind::UnsupportedValue;
    assert key_write_error(PrettyShape::Circle(1.0)) == SerializeErrorKind::UnsupportedValue;
    assert key_write_error(()) == SerializeErrorKind::UnsupportedValue;
    assert key_read_error::<List<i32>>() == DeserializeErrorKind::UnexpectedType;
    assert key_read_error::<TreeMap<String, i32>>() == DeserializeErrorKind::UnexpectedType;
    assert key_read_error::<Pair>() == DeserializeErrorKind::UnexpectedType;
    assert key_read_error::<PrettyColor>() == DeserializeErrorKind::UnexpectedType;
    assert key_read_error::<()>() == DeserializeErrorKind::UnexpectedType;
}

test "an ignored map reads each key as a string" {
    assert from_string::<IgnoredAny>(`{"a":1}`) matches { Ok(_) };
    assert de_err::<IgnoredAny>("{1:1}").kind == DeserializeErrorKind::UnexpectedType;
}

test "a canonical map sorts scalar keys by their spelling" {
    let mut ints = TreeMap::<i32, i32>::new();
    ints[10] = 1;
    ints[9] = 2;
    assert_bytes_eq_string(&to_bytes_canonical(&ints).unwrap(), &"{\"10\":1,\"9\":2}");
}

test "a StrSlice parses without copying out" {
    let owner = `  {"a":1,"b":2}  `;
    let view = owner.as_str_slice().trim_ascii();
    let r: Result<TreeMap<String, i32>, DeserializeError> = from_string(view);
    assert r matches { Ok(m) && m.len() == 2 };
}

test "DeserializeError renders its message and offset" {
    assert `${from_string::<Utf8Rec>("{}").unwrap_err()}` == "missing field: a";
    assert `${from_string::<Utf8Rec>("nope").unwrap_err()}`.contains(" at offset ");
}

fn de_err<T: Deserialize>(text: String) -> DeserializeError {
    return from_string::<T>(text).unwrap_err();
}

// One field per scalar the serializers write. The integers sit past the f64
// safe range where they have one, so each takes its string form.
struct Scalars {
    i: i64,
    u: u32,
    big: u64,
    wide: i128,
    uwide: u128,
    f: f32,
    b: bool,
    c: char,
    n: Option<i32>,
    bytes: ByteList,
}

fn sample_scalars() -> Scalars {
    return Scalars {
        i: -9007199254740993,
        u: u32::MAX,
        big: u64::MAX,
        wide: -1,
        uwide: u128::MAX,
        f: 0.5,
        b: true,
        c: '"',
        n: null,
        bytes: [0xfb, 0xff],
    };
}

test "every scalar round-trips through the compact form" {
    let text = to_string(&sample_scalars()).unwrap();
    assert text == `{"i":"-9007199254740993","u":4294967295,"big":"18446744073709551615","wide":"-1","uwide":"340282366920938463463374607431768211455","f":0.5,"b":true,"c":"\\"","n":null,"bytes":"-_8"}`;
    assert from_string::<Scalars>(text) == Result::Ok(sample_scalars());
}

test "every scalar has the same form when pretty-printed" {
    assert to_string_pretty(&sample_scalars()).unwrap() == `{
  "i": "-9007199254740993",
  "u": 4294967295,
  "big": "18446744073709551615",
  "wide": "-1",
  "uwide": "340282366920938463463374607431768211455",
  "f": 0.5,
  "b": true,
  "c": "\\"",
  "n": null,
  "bytes": "-_8"
}`;
}

test "every scalar but a float has the same form in the canonical encoding" {
    let b = to_bytes_canonical(&sample_scalars()).unwrap();
    assert_bytes_eq_string(
        &b,
        &`{"b":true,"big":"18446744073709551615","bytes":"-_8","c":"\\"","f":0.5,"i":"-9007199254740993","n":null,"u":4294967295,"uwide":"340282366920938463463374607431768211455","wide":"-1"}`,
    );
}

struct NoFields {
}

test "an empty struct is an empty object in every form" {
    assert to_string(&NoFields {}) == Result::Ok("{}");
    assert to_string_pretty(&NoFields {}) == Result::Ok("{}");
    assert_bytes_eq_string(&to_bytes_canonical(&NoFields {}).unwrap(), &"{}");
}

test "a lone char serializes as an escaped one-character string" {
    assert to_string(&'日') == Result::Ok(`"日"`);
    assert to_string(&'\u{1}') == Result::Ok(`"\\u0001"`);
    assert to_string(&"a\rb") == Result::Ok(`"a\\rb"`);
}

struct OddKeys {
    #[wire(name = "say \"hi\"")]
    quoted: i32,
    #[wire(name = "tab\there")]
    tabbed: i32,
}

test "a field name JSON must escape is escaped as a key, and read back" {
    let v = OddKeys { quoted: 1, tabbed: 2 };
    let text = to_string(&v).unwrap();
    assert text == `{"say \\"hi\\"":1,"tab\\there":2}`;
    assert to_string_pretty(&v).unwrap() == `{
  "say \\"hi\\"": 1,
  "tab\\there": 2
}`;
    assert_bytes_eq_string(&to_bytes_canonical(&v).unwrap(), &text);
    assert from_string::<OddKeys>(text) == Result::Ok(v);
}

test "an escaped key names the field its decoding spells" {
    assert from_string::<Utf8Rec>(`{"\\u0061":"x"}`) == Result::Ok(Utf8Rec { a: "x" });
    assert from_string::<Utf8Rec>(`{"\\u0061" "x"}`).unwrap_err() == DeserializeError::malformed(
        "expected ':', found '\"'",
        10,
    );
    assert from_string::<Utf8Rec>(`{"\\u00"}`).unwrap_err() == DeserializeError::malformed("invalid unicode escape", 4);
}

test "a map keeps its insertion order in the compact form" {
    let mut m: TreeMap<String, i32> = TreeMap::new();
    m["b"] = 2;
    m["a"] = 1;
    assert to_string(&m) == Result::Ok(`{"b":2,"a":1}`);
    assert to_string(&TreeMap::<String, i32>::new()) == Result::Ok("{}");
}

test "variants write a bare tag or a one-pair object in every form" {
    let shapes: List<PrettyShape> = [PrettyShape::Point, PrettyShape::Circle(2.5)];
    let compact = `["Point",{"Circle":2.5}]`;
    assert to_string(&shapes) == Result::Ok(compact);
    assert_bytes_eq_string(&to_bytes_canonical(&shapes).unwrap(), &compact);
    assert to_string(&PrettyColor::Green) == Result::Ok(`"Green"`);
    assert from_string::<List<PrettyShape>>(compact) == Result::Ok(shapes);
}

test "the canonical form keeps sequence order and sorts only keys" {
    let v: List<List<i32>> = [
        [3, 1],
        [],
        [2],
    ];
    assert_bytes_eq_string(&to_bytes_canonical(&v).unwrap(), &"[[3,1],[],[2]]");
}

struct Reading {
    label: String,
    value: f64,
}

test "a non-finite float fails every serializer, however deeply it sits" {
    let inf = SerializeError::unsupported_value("Infinity is not allowed in JSON");
    let nan = SerializeError::unsupported_value("NaN is not allowed in JSON");
    let r = Reading { label: "x", value: f64::INFINITY };
    assert to_string(&r).unwrap_err() == inf;
    assert to_bytes(&r).unwrap_err() == inf;
    assert to_string_pretty(&r).unwrap_err() == inf;
    assert to_bytes_pretty(&r).unwrap_err() == inf;
    assert to_bytes_canonical(&r).unwrap_err() == inf;

    let seq: List<f64> = [1.0, -f64::INFINITY];
    assert to_bytes_canonical(&seq).unwrap_err() == inf;
    assert to_string(&f32::NAN).unwrap_err() == nan;

    let mut m: TreeMap<String, f32> = TreeMap::new();
    m["k"] = f32::NAN;
    assert to_string(&m).unwrap_err() == nan;
    assert to_bytes_canonical(&m).unwrap_err() == nan;
}

test "whitespace of every JSON kind and any run length surrounds tokens" {
    let ws: List<String> = [" ", "\t", "\n", "\r"];
    for let n of 0..<10 {
        let mut pad = String::new();
        for let i of 0..<n {
            pad.push_str(&ws[i % 4]);
        }
        let list: Result<List<i32>, DeserializeError> = from_string(`${pad}[${pad}1${pad},${pad}2${pad}]${pad}`);
        assert list == Result::Ok([1, 2]);
        assert from_string::<i32>(`${pad}7`) == Result::Ok(7);
        assert from_string::<i32>(`7${pad}`) == Result::Ok(7);
    }
}

test "a control byte outside JSON's four is not whitespace" {
    assert de_err::<i32>("\u{b}1") == DeserializeError::unexpected_type("expected number", 0);
    assert de_err::<i32>("\u{c}1") == DeserializeError::unexpected_type("expected number", 0);
    assert de_err::<i32>("1\u{0}") == DeserializeError::trailing(1);
}

test "a container reports a bad separator or a missing end where it stops" {
    assert de_err::<List<i32>>("[1 2]") == DeserializeError::malformed("expected ',' or ']'", 3);
    assert de_err::<List<i32>>("[1") == DeserializeError::eof(2);
    assert de_err::<List<i32>>("[") == DeserializeError::eof(1);
    assert de_err::<List<i32>>("{}") == DeserializeError::malformed("expected '[', found '{'", 0);

    assert de_err::<TreeMap<String, i32>>(`{"a":1 "b":2}`) == DeserializeError::malformed("expected ',' or '}'", 7);
    assert de_err::<TreeMap<String, i32>>(`{1:2}`) == DeserializeError::unexpected_type("expected string", 1);
    assert de_err::<TreeMap<String, i32>>(`{"a" 1}`) == DeserializeError::malformed("expected ':', found '1'", 5);
    assert de_err::<TreeMap<String, i32>>(`{"a"`) == DeserializeError::eof(4);
    assert de_err::<TreeMap<String, i32>>(`{"a":1,`) == DeserializeError::eof(7);
    assert de_err::<TreeMap<String, i32>>("[]") == DeserializeError::malformed("expected '{', found '['", 0);
}

test "a struct reports a bad separator, key, or end where it stops" {
    assert de_err::<Utf8Rec>("{") == DeserializeError::eof(1);
    assert de_err::<Utf8Rec>(`{"a":"x" "b":1}`) == DeserializeError::malformed("expected ',' or '}'", 9);
    assert de_err::<Utf8Rec>(`{a:1}`) == DeserializeError::unexpected_type("expected string key", 1);
    assert de_err::<Utf8Rec>(`{"a":"x",`) == DeserializeError::eof(9);
    assert de_err::<Utf8Rec>(`{"a" "x"}`) == DeserializeError::malformed("expected ':', found '\"'", 5);
    assert de_err::<Utf8Rec>("[]") == DeserializeError::malformed("expected '{', found '['", 0);
    assert de_err::<Utf8Rec>("") == DeserializeError::eof(0);
}

test "an unknown member of any shape is skipped" {
    let text = `{"skip":[1,-2.5e+3,0.25E-1,7e2,true,false,null,"q\\"\\/\\u0041",{"k":[]},{},[]],"a":"x"}`;
    assert from_string::<Utf8Rec>(text) == Result::Ok(Utf8Rec { a: "x" });
    assert from_string::<Utf8Rec>(`{"skip":-5,"a":"x"}`) == Result::Ok(Utf8Rec { a: "x" });
    assert from_string::<Utf8Rec>(`{"\\u0062":1,"a":"x"}`) == Result::Ok(Utf8Rec { a: "x" });
}

test "a skipped object is depth-limited like a skipped array" {
    let mut text = String::new();
    text.push_str(`{"unknown":`);
    for let mut i = 0; i < DEFAULT_MAX_DEPTH + 1; i += 1 {
        text.push_str(`{"a":`);
    }
    text.push('1');
    for let mut i = 0; i < DEFAULT_MAX_DEPTH + 1; i += 1 {
        text.push('}');
    }
    text.push_str(`,"a":"x"}`);
    assert de_err::<Utf8Rec>(text).kind == DeserializeErrorKind::DepthLimitExceeded;
}

test "max_depth bounds a map, a struct and a variant object too" {
    assert from_string::<TreeMap<String, i32>>("{}", 0).unwrap_err().kind == DeserializeErrorKind::DepthLimitExceeded;
    assert from_string::<Utf8Rec>(`{"a":"x"}`, 0).unwrap_err().kind == DeserializeErrorKind::DepthLimitExceeded;
    assert from_string::<PrettyShape>(`{"Circle":1}`, 0).unwrap_err().kind == DeserializeErrorKind::DepthLimitExceeded;
    assert from_string::<PrettyShape>(`"Point"`, 0) == Result::Ok(PrettyShape::Point);
}

test "a skipped member is held to the same syntax as a read one" {
    assert de_err::<Utf8Rec>(`{"skip":[1 2],"a":"x"}`) == DeserializeError::malformed("expected ',' or ']'", 11);
    assert de_err::<Utf8Rec>(`{"skip":[1`) == DeserializeError::eof(10);
    assert de_err::<Utf8Rec>(`{"skip":[`) == DeserializeError::eof(9);
    assert de_err::<Utf8Rec>(`{"skip":{"k":1 "j":2}}`) == DeserializeError::malformed("expected ',' or '}'", 15);
    assert de_err::<Utf8Rec>(`{"skip":{"k":1,`) == DeserializeError::eof(15);
    assert de_err::<Utf8Rec>(`{"skip":{"k":1`) == DeserializeError::eof(14);
    assert de_err::<Utf8Rec>(`{"skip":{1:2}}`) == DeserializeError::unexpected_type("expected string key", 9);
    assert de_err::<Utf8Rec>(`{"skip":{"k" 1}}`) == DeserializeError::malformed("expected ':', found '1'", 13);
    assert de_err::<Utf8Rec>(`{"skip":{"a`) == DeserializeError::eof(11);
    assert de_err::<Utf8Rec>(`{"skip":{"k":@}}`) == DeserializeError::malformed(
        "unexpected character in JSON value",
        13,
    );
    assert de_err::<Utf8Rec>(`{"skip":tru}`) == DeserializeError::malformed("expected 'true'", 8);
    assert de_err::<Utf8Rec>(`{"skip":fals}`) == DeserializeError::malformed("expected 'false'", 8);
    assert de_err::<Utf8Rec>(`{"skip":nul}`) == DeserializeError::malformed("expected 'null'", 8);
    assert de_err::<Utf8Rec>(`{"skip":`) == DeserializeError::eof(8);
    assert de_err::<Utf8Rec>(`{"skip":@}`) == DeserializeError::malformed("unexpected character in JSON value", 8);
    assert de_err::<Utf8Rec>(`{"skip":"abc`) == DeserializeError::eof(12);
    assert de_err::<Utf8Rec>("{\"skip\":\"ab\\") == DeserializeError::eof(12);
}

test "every short escape decodes" {
    let r: Result<String, DeserializeError> = from_string(String::raw`"\"\\\/\b\f\n\r\t"`);
    assert r == Result::Ok("\"\\/\u{8}\u{c}\n\r\t");
}

test "a malformed escape is an error at the escape" {
    assert de_err::<String>(`"\\x"`) == DeserializeError::malformed("invalid escape '\\x'", 2);
    assert de_err::<String>("\"ab\\") == DeserializeError::eof(4);
    assert de_err::<String>(`"\\u12`) == DeserializeError::eof(3);
    assert de_err::<String>(`"\\u12G4"`) == DeserializeError::malformed("invalid unicode escape", 3);
    assert de_err::<String>(`"\\uD800\\u12"`) == DeserializeError::eof(9);

    let after_escape: ByteList = [0x22, 0x5c, 0x6e, 0xff, 0x22];  // "\n<0xff>"
    assert from_bytes::<String, ByteList>(after_escape).unwrap_err() == DeserializeError::malformed(
        "invalid UTF-8 in string",
        3,
    );
}

test "a string is required where one is expected" {
    assert de_err::<String>("42") == DeserializeError::unexpected_type("expected string", 0);
    assert de_err::<String>("   ") == DeserializeError::eof(3);
}

test "negative zero keeps its sign" {
    assert from_string::<f64>("-0").unwrap().to_bits() == 0x8000000000000000;
    assert from_string::<f64>("-0.0").unwrap().to_bits() == 0x8000000000000000;
    assert from_string::<f64>("0").unwrap().to_bits() == 0;
}

test "an exponent takes an optional sign and ends at the first non-digit" {
    assert from_string::<f64>("1e+2") == Result::Ok(100.0);
    let r: Result<List<f64>, DeserializeError> = from_string("[1e5,2E-1]");
    assert r == Result::Ok([100000.0, 0.2]);
}

test "a float read reports a missing or malformed number" {
    assert de_err::<f64>("") == DeserializeError::eof(0);
    assert de_err::<f64>("-") == DeserializeError::eof(1);
    assert de_err::<f64>("-x") == DeserializeError::unexpected_type("expected number", 1);
    assert de_err::<f32>("x") == DeserializeError::unexpected_type("expected number", 0);
    assert de_err::<f16>("x") == DeserializeError::unexpected_type("expected number", 0);
    assert de_err::<bf16>("x") == DeserializeError::unexpected_type("expected number", 0);
}

test "an integer read rejects a fraction" {
    let got_float = DeserializeError::unexpected_type("expected integer, got float", 0);
    assert de_err::<i32>("1.5") == got_float;
    assert de_err::<i64>("1.5") == got_float;
    assert de_err::<u64>("2.5") == got_float;
}

test "i64 and u64 read every sign and length" {
    assert from_string::<i64>("-5") == Result::Ok(-5);
    assert from_string::<i64>("-1234567890123456789") == Result::Ok(-1234567890123456789);
    assert de_err::<i64>("-x") == DeserializeError::unexpected_type("expected number", 1);
    assert from_string::<u64>("5") == Result::Ok(5);
    assert from_string::<u64>("1e3") == Result::Ok(1000);
    assert de_err::<u64>("-1") == DeserializeError::overflow("negative value for u64", 0);
    assert de_err::<u64>("x") == DeserializeError::unexpected_type("expected number", 0);
    assert de_err::<u32>("-1") == DeserializeError::overflow("value out of range for u32", 0);
}

test "i64 and u64 read their string form" {
    assert from_string::<i64>(`"123"`) == Result::Ok(123);
    assert from_string::<i64>(`"1e2"`) == Result::Ok(100);
    assert de_err::<i64>(`"abc"`) == DeserializeError::unexpected_type("expected number", 0);
    assert de_err::<i64>(`"99999999999999999999"`) == DeserializeError::overflow("value out of range for i64", 0);
    assert de_err::<i64>(`"1.x"`).kind == DeserializeErrorKind::UnexpectedType;
    assert de_err::<i64>(`"12`) == DeserializeError::eof(3);

    assert from_string::<u64>(`"42"`) == Result::Ok(42);
    assert from_string::<u64>(`"1e3"`) == Result::Ok(1000);
    assert de_err::<u64>(`"-1"`) == DeserializeError::overflow("negative value for u64", 0);
    assert de_err::<u64>(`"x"`) == DeserializeError::unexpected_type("expected number", 0);
    assert de_err::<u64>(`"1.x"`).kind == DeserializeErrorKind::UnexpectedType;
    assert de_err::<u64>(`"12`) == DeserializeError::eof(3);
}

test "a float reads its string form as an integer does" {
    assert from_string::<f64>(`"1.5"`) == Result::Ok(1.5);
    assert from_string::<f64>(`"-2e-3"`) == Result::Ok(-0.002);
    assert from_string::<f32>(`"0.1"`) == Result::Ok(0.1_f32);
    assert from_string::<f16>(`"1.5"`) == Result::Ok(1.5_f16);
    assert from_string::<bf16>(`"1.5"`) == Result::Ok(1.5_bf16);
    assert de_err::<f64>(`"1e400"`) == DeserializeError::overflow("value out of range for f64", 0);
    assert de_err::<f64>(`"NaN"`) == DeserializeError::unexpected_type("expected number", 0);
    assert de_err::<f64>(`" 1.5"`) == DeserializeError::unexpected_type("expected number", 0);
    assert de_err::<f64>(`"1.5 "`) == DeserializeError::unexpected_type("expected number", 0);
    assert de_err::<f32>(`"12`) == DeserializeError::eof(3);
}

test "i128 and u128 report a truncated token" {
    assert de_err::<i128>("-") == DeserializeError::eof(1);
    assert de_err::<u128>("-") == DeserializeError::eof(1);
    assert de_err::<i128>(`"12`) == DeserializeError::eof(3);
    assert de_err::<u128>(`"12`) == DeserializeError::eof(3);
}

test "a bool is exactly true or false" {
    assert de_err::<bool>("") == DeserializeError::eof(0);
    assert de_err::<bool>("1") == DeserializeError::unexpected_type("expected bool", 0);
    assert de_err::<bool>("tru") == DeserializeError::malformed("expected 'true'", 0);
    assert de_err::<bool>("fals") == DeserializeError::malformed("expected 'false'", 0);
}

test "an Option reads null as None and anything else as the value" {
    assert from_string::<Option<i32>>("5") == Result::Ok(Option::Some(5));
    assert from_string::<Option<i32>>(" null") == Result::Ok(Option::<i32>::None);
    assert de_err::<Option<i32>>("nul") == DeserializeError::malformed("expected 'null'", 0);
}

test "a char is a string of exactly one character" {
    assert from_string::<char>(`"a"`) == Result::Ok('a');
    assert from_string::<char>(`"é"`) == Result::Ok('é');
    assert de_err::<char>(`"ab"`) == DeserializeError::invalid_value("expected single char", 4);
    assert de_err::<char>(`""`) == DeserializeError::invalid_value("empty string for char", 2);
    assert de_err::<char>("5") == DeserializeError::unexpected_type("expected string", 0);
}

test "bytes read either base64 alphabet, padded or not" {
    let want: ByteList = [0xfb, 0xff];
    assert from_string::<ByteList>(`"-_8"`) == Result::Ok(want);
    assert from_string::<ByteList>(`"+/8="`) == Result::Ok(want);
    assert de_err::<ByteList>(`"!!"`) == DeserializeError::invalid_value("invalid base64 byte string", 4);
    assert de_err::<ByteList>("5") == DeserializeError::unexpected_type("expected string", 0);
}

test "a variant reads a bare tag or a one-pair object" {
    assert from_string::<PrettyShape>(`"Point"`) == Result::Ok(PrettyShape::Point);
    assert de_err::<PrettyShape>("5") == DeserializeError::unexpected_type("expected string or object for variant", 0);
    assert de_err::<PrettyShape>("") == DeserializeError::eof(0);
    assert de_err::<PrettyShape>(`"Point`) == DeserializeError::eof(6);
    assert de_err::<PrettyShape>(`{5:1}`) == DeserializeError::unexpected_type("expected string", 1);
    assert de_err::<PrettyShape>(`{"Circle"`) == DeserializeError::eof(9);
    assert de_err::<PrettyShape>(`{"Circle":1.5`) == DeserializeError::eof(13);
}

variant Signal {
    Stop,
    Go(i32),
}

// Reads the tag shape through `is_unit` rather than by name, as a hand-written
// impl for a format-agnostic variant may.
impl Deserialize for Signal {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<Signal, DeserializeError> {
        let mut access = d.begin_variant("Signal", 2)?;
        let signal = if access.is_unit()? { Signal::Stop } else { Signal::Go(access.payload::<i32>()?) };
        access.end()?;
        return Result::Ok(signal);
    }
}

test "is_unit tells a bare tag from a tag with a payload" {
    assert from_string::<Signal>(`"Stop"`) == Result::Ok(Signal::Stop);
    assert from_string::<Signal>(`{"Go":3}`) == Result::Ok(Signal::Go(3));
}

test "a Value reads every JSON value kind" {
    let r: Result<Value, DeserializeError> = from_string(`[null,true,false,"s",-1.5,{"k":[]}]`);
    let object = { k: Value::List([]) } as TreeMap<String, Value>;
    assert r == Result::Ok(Value::List([
        Value::Null,
        Value::Bool(true),
        Value::Bool(false),
        Value::String("s"),
        Value::Float(-1.5),
        Value::Object(object),
    ]));
}

test "a Value read reports a missing or malformed token" {
    assert de_err::<Value>("") == DeserializeError::eof(0);
    assert de_err::<Value>("x") == DeserializeError::unexpected_type("unexpected byte in JSON value", 0);
    assert de_err::<Value>("nul") == DeserializeError::malformed("expected 'null'", 0);
    assert de_err::<Value>("tru") == DeserializeError::malformed("expected 'true'", 0);
    assert de_err::<Value>(`"ab`) == DeserializeError::eof(3);
    assert de_err::<Value>("-") == DeserializeError::eof(1);
    assert de_err::<Value>("[1") == DeserializeError::eof(2);
    assert de_err::<Value>("{") == DeserializeError::eof(1);
}

test "JsonDeserializer reads a token stream by hand" {
    let text = ` [-2147483648, 18446744073709551615, -9223372036854775808, -1.5e+3, {"k": [true]}]`;
    let mut de = JsonDeserializer { input: text.as_bytes(), pos: 0 };
    assert de.peek() == b' ';
    assert de.peek_after_whitespace() == b'[';
    de.advance();
    assert de.parse_i32_direct() == Result::Ok(i32::MIN);
    assert de.expect_char(b',') matches { Ok };
    assert de.parse_u64_direct() == Result::Ok(u64::MAX);
    assert de.expect_char(b',') matches { Ok };
    assert de.parse_i64_direct() == Result::Ok(i64::MIN);
    assert de.expect_char(b',') matches { Ok };
    assert de.parse_f64_direct() == Result::Ok(-1500.0);
    assert de.expect_char(b',') matches { Ok };
    assert de.skip_value(0) matches { Ok };
    assert de.expect_char(b']') matches { Ok };
    assert de.peek() == -1;
}

test "an integer part is a lone zero or starts with a nonzero digit" {
    let at_start = DeserializeError::malformed("leading zero in number", 0);
    assert de_err::<i32>("007") == at_start;
    assert de_err::<i64>("007") == at_start;
    assert de_err::<u32>("007") == at_start;
    assert de_err::<u64>("007") == at_start;
    assert de_err::<i128>("00") == at_start;
    assert de_err::<f64>("01.5") == at_start;
    assert de_err::<i64>("-01") == DeserializeError::malformed("leading zero in number", 1);

    assert from_string::<i64>("0") == Result::Ok(0);
    assert from_string::<i32>("0e0") == Result::Ok(0);
    assert from_string::<f64>("-0.5") == Result::Ok(-0.5);
    assert from_string::<List<i64>>("[0,10,-0]") == Result::Ok([0, 10, 0]);
}

test "a point or an exponent needs a digit after it" {
    assert de_err::<f64>("1.") == DeserializeError::eof(2);
    assert de_err::<f64>("1e") == DeserializeError::eof(2);
    assert de_err::<f64>("1e+") == DeserializeError::eof(3);

    let point = DeserializeError::malformed("expected digit after '.'", 3);
    let exponent = DeserializeError::malformed("expected digit in exponent", 3);
    assert de_err::<List<f64>>("[1.e5]") == point;
    assert de_err::<List<i32>>("[1.]") == point;
    assert de_err::<List<i64>>("[1.]") == point;
    assert de_err::<List<u64>>("[1.]") == point;
    assert de_err::<List<i128>>("[1.]") == point;
    assert de_err::<List<i64>>("[1e]") == exponent;
    assert de_err::<List<u32>>("[2E]") == exponent;
    assert de_err::<List<f64>>("[1E-]") == DeserializeError::malformed("expected digit in exponent", 4);
}

test "a string rejects an unescaped control character" {
    let unescaped = "unescaped control character in string";
    assert de_err::<String>("\"a\tb\"") == DeserializeError::malformed(unescaped, 2);
    assert de_err::<String>("\"\\n\nb\"") == DeserializeError::malformed(unescaped, 3);
    let nul: ByteList = [0x22, 0x61, 0x00, 0x22];
    assert from_bytes::<String, ByteList>(nul).unwrap_err() == DeserializeError::malformed(unescaped, 2);
    let unit_separator: ByteList = [0x22, 0x1f, 0x22];
    assert from_bytes::<String, ByteList>(unit_separator).unwrap_err() == DeserializeError::malformed(unescaped, 1);

    assert de_err::<Utf8Rec>("{\"a\tb\":1}") == DeserializeError::malformed(unescaped, 3);
    assert de_err::<TreeMap<String, i32>>("{\"a\tb\":1}") == DeserializeError::malformed(unescaped, 3);
    assert de_err::<Utf8Rec>("{\"skip\":\"a\tb\",\"a\":\"x\"}") == DeserializeError::malformed(unescaped, 10);
    assert de_err::<Utf8Rec>("{\"skip\":{\"k\t\":1},\"a\":\"x\"}") == DeserializeError::malformed(unescaped, 11);

    // A space and DEL are not controls JSON must escape.
    let printable: ByteList = [0x22, 0x20, 0x7f, 0x22];
    assert from_bytes::<String, ByteList>(printable) matches { Ok(s) && s.len() == 2 };
}

test "an unterminated key ends where the input does" {
    assert de_err::<Utf8Rec>(`{"a`) == DeserializeError::eof(3);
    assert de_err::<Utf8Rec>(`{"a\\`) == DeserializeError::eof(4);
}

test "a skipped string is held to the read path's escape rules" {
    assert de_err::<Utf8Rec>(`{"skip":"\\x","a":"x"}`) == DeserializeError::malformed("invalid escape '\\x'", 10);
    assert de_err::<Utf8Rec>(`{"skip":"\\uZZZZ","a":"x"}`) == DeserializeError::malformed(
        "invalid unicode escape",
        11,
    );
    assert de_err::<Utf8Rec>(`{"skip":"\\uDC00","a":"x"}`) == DeserializeError::malformed("unpaired low surrogate", 11);
    assert de_err::<Utf8Rec>(`{"skip":"\\uD800","a":"x"}`) == DeserializeError::malformed(
        "unpaired high surrogate",
        11,
    );
    assert de_err::<Utf8Rec>(`{"skip":"\\u12`) == DeserializeError::eof(11);
    assert de_err::<Utf8Rec>(`{"skip":{"\\q":1},"a":"x"}`) == DeserializeError::malformed("invalid escape '\\q'", 11);

    let paired = `{"skip":"\\uD83D\\uDE00\\t","a":"x"}`;
    assert from_string::<Utf8Rec>(paired) == Result::Ok(Utf8Rec { a: "x" });
}

test "a skipped number is held to the read path's grammar" {
    assert de_err::<Utf8Rec>(`{"skip":007,"a":"x"}`) == DeserializeError::malformed("leading zero in number", 8);
    assert de_err::<Utf8Rec>(`{"skip":1.,"a":"x"}`) == DeserializeError::malformed("expected digit after '.'", 10);
    assert de_err::<Utf8Rec>(`{"skip":[1e],"a":"x"}`) == DeserializeError::malformed(
        "expected digit in exponent",
        11,
    );
    assert de_err::<Utf8Rec>(`{"skip":-,"a":"x"}`) == DeserializeError::unexpected_type("expected number", 9);

    let mut number = JsonDeserializer { input: "-1.5e+3,".as_bytes(), pos: 0 };
    assert number.skip_number() matches { Ok };
    assert number.pos == 7;
    let mut zeros = JsonDeserializer { input: "00".as_bytes(), pos: 0 };
    assert zeros.skip_number().unwrap_err() == DeserializeError::malformed("leading zero in number", 0);
    let mut point = JsonDeserializer { input: " 1.e5".as_bytes(), pos: 0 };
    assert point.skip_value(0).unwrap_err() == DeserializeError::malformed("expected digit after '.'", 3);
    let mut exponent = JsonDeserializer { input: "[1e+]".as_bytes(), pos: 1 };
    assert exponent.skip_number().unwrap_err() == DeserializeError::malformed("expected digit in exponent", 4);
}
