use {
    Serialize,
    Deserialize,
    Serializer,
    Deserializer,
    SerializeStruct,
    DeserializeStruct,
    SerializeError,
    SerializeErrorKind,
    DeserializeError,
    DeserializeErrorKind,
} from "core:serde";
use { TreeMap } from "core:collections";

use {
    to_string,
    to_string_pretty,
    to_bytes,
    to_bytes_canonical,
    to_bytes_pretty,
    from_string,
    from_bytes,
    write_escaped_string,
    PrettyJsonSerializer,
} from "core:json";

fn assert_bytes_eq_string(bytes: &List<u8>, s: &String) {
    let expected: List<u8> = s.bytes().collect();
    assert bytes.len() == expected.len();
    for let mut i = 0; i < bytes.len(); i += 1 {
        assert bytes[i] == expected[i];
    }
}

#[serde(rename_all = "camelCase")]
struct PrettyUser {
    first_name: String,
    age: i32,
}

impl Serialize for PrettyUser;

enum PrettyColor {
    Red,
    Green,
}

impl Serialize for PrettyColor;

variant PrettyShape {
    Circle(f64),
    Point,
}

impl Serialize for PrettyShape;
impl Deserialize for PrettyShape;

test "serialize i32" {
    let n = 42;
    let r = to_string(&n);
    assert r matches { Ok(s) && s == "42" };
}

test "serialize negative i32" {
    let n = -123;
    let r = to_string(&n);
    assert r matches { Ok(s) && s == "-123" };
}

test "serialize i64" {
    let n: i64 = 1000000000000;
    let r = to_string(&n);
    assert r matches { Ok(s) && s == "1000000000000" };
}

test "serialize u32" {
    let n: u32 = 255;
    let r = to_string(&n);
    assert r matches { Ok(s) && s == "255" };
}

test "serialize f64" {
    let n = 3.14;
    let r = to_string(&n);
    assert r matches { Ok(s) && s == "3.14" };
}

test "serialize bool true" {
    let v = true;
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "true" };
}

test "serialize bool false" {
    let v = false;
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "false" };
}

test "serialize string" {
    let v = "hello world";
    let r = to_string(&v);
    assert r matches { Ok(s) && s == `"hello world"` };
}

test "serialize string with escapes" {
    let v = "line1\nline2\ttab";
    let r = to_string(&v);
    assert r matches { Ok(s) && s == `"line1\\nline2\\ttab"` };
}

test "serialize string with quotes" {
    let v = `say "hi"`;
    let r = to_string(&v);
    assert r matches { Ok(s) && s == `"say \\"hi\\""` };
}

test "serialize Option Some" {
    let v: Option<i32> = Option::Some(42);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "42" };
}

test "serialize Option None" {
    let v: Option<i32> = null;
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "null" };
}

test "serialize List<i32>" {
    let v: List<i32> = [1, 2, 3];
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "[1,2,3]" };
}

test "serialize empty List" {
    let v: List<i32> = [];
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "[]" };
}

test "serialize List<String>" {
    let v: List<String> = ["hello", "world"];
    let r = to_string(&v);
    assert r matches { Ok(s) && s == `["hello","world"]` };
}

test "serialize nested List" {
    let v: Option<List<i32>> = Option::Some([10, 20]);
    let r = to_string(&v);
    assert r matches { Ok(s) && s == "[10,20]" };
}

test "to_bytes scalar matches to_string" {
    let n = 42;
    let bytes = to_bytes(&n).unwrap();
    assert_bytes_eq_string(&bytes, &to_string(&n).unwrap());
}

test "to_bytes struct matches to_string" {
    let user = PrettyUser { first_name: "Alice", age: 30 };
    let bytes = to_bytes(&user).unwrap();
    assert_bytes_eq_string(&bytes, &to_string(&user).unwrap());
}

test "to_bytes string with escapes matches to_string" {
    let v = "line1\nline2\t\"quoted\"";
    let bytes = to_bytes(&v).unwrap();
    assert_bytes_eq_string(&bytes, &to_string(&v).unwrap());
}

test "to_bytes List<String> matches to_string" {
    let v: List<String> = ["hello", "世界"];
    let bytes = to_bytes(&v).unwrap();
    assert_bytes_eq_string(&bytes, &to_string(&v).unwrap());
}

test "to_bytes empty string" {
    let v = "";
    let bytes = to_bytes(&v).unwrap();
    assert bytes.len() == 2;
    assert bytes[0] == 34;
    assert bytes[1] == 34;
}

test "serialize pretty struct with default indent" {
    let user = PrettyUser {
        first_name: "Alice",
        age: 30,
    };
    let r = to_string_pretty(&user);
    assert r matches { Ok(s) && s == "{
  \"firstName\": \"Alice\",
  \"age\": 30
}" };
}

test "serialize pretty with custom indent field" {
    let v: List<List<i32>> = [
        [1],
        [2, 3],
    ];
    let indent = "    ";
    let mut buf = "";
    let mut ser = PrettyJsonSerializer {
        buf: &mut buf,
        indent: &indent,
        depth: 0,
    };
    let r = v.serialize::<PrettyJsonSerializer>(&mut ser);
    assert r matches { Ok };
    assert buf == "[
    [
        1
    ],
    [
        2,
        3
    ]
]";
}

test "serialize pretty empty array" {
    let v: List<i32> = [];
    let r = to_string_pretty(&v);
    assert r matches { Ok(s) && s == "[]" };
}

test "serialize pretty map" {
    let mut m: TreeMap<String, i32> = TreeMap::new();
    m.insert("a", 1);
    m.insert("b", 2);
    let r = to_string_pretty(&m);
    assert r matches { Ok(s) && s == "{
  \"a\": 1,
  \"b\": 2
}" };
}

test "serialize pretty empty map" {
    let m: TreeMap<String, i32> = TreeMap::new();
    let r = to_string_pretty(&m);
    assert r matches { Ok(s) && s == "{}" };
}

test "serialize pretty unit variant" {
    let c = PrettyColor::Red;
    let r = to_string_pretty(&c);
    assert r matches { Ok(s) && s == `"Red"` };
}

test "serialize pretty payload variant" {
    let s = PrettyShape::Circle(5.0);
    let r = to_string_pretty(&s);
    assert r matches { Ok(v) && v == "{
  \"Circle\": 5
}" };
}

test "serialize pretty f64 nan error" {
    let r = to_string_pretty(&f64::NAN);
    assert r matches { Err(e) && e.kind == SerializeErrorKind::UnsupportedValue };
}

test "write_escaped_string helper" {
    let mut buf = "";
    write_escaped_string(&mut buf, &"hello");
    assert buf == `"hello"`;

    buf = "";
    write_escaped_string(&mut buf, &"a\"b");
    assert buf == `"a\\"b"`;
}

test "deserialize i32" {
    let r: Result<i32, DeserializeError> = from_string("42");
    assert r matches { Ok(v) && v == 42 };
}

test "deserialize negative i32" {
    let r: Result<i32, DeserializeError> = from_string("-7");
    assert r matches { Ok(v) && v == -7 };
}

test "deserialize i32 with whitespace" {
    let r: Result<i32, DeserializeError> = from_string("  42  ");
    assert r matches { Ok(v) && v == 42 };
}

test "deserialize i64" {
    let r: Result<i64, DeserializeError> = from_string("1000000000000");
    assert r matches { Ok(v) && v == 1000000000000 };
}

test "deserialize u32" {
    let r: Result<u32, DeserializeError> = from_string("255");
    assert r matches { Ok(v) && v == 255 };
}

test "deserialize f64" {
    let r: Result<f64, DeserializeError> = from_string("3.14");
    assert r matches { Ok(v) && v == 3.14 };
}

test "deserialize f64 integer" {
    let r: Result<f64, DeserializeError> = from_string("42");
    assert r matches { Ok(v) && v == 42.0 };
}

test "deserialize bool true" {
    let r: Result<bool, DeserializeError> = from_string("true");
    assert r matches { Ok(v) && v == true };
}

test "deserialize bool false" {
    let r: Result<bool, DeserializeError> = from_string("false");
    assert r matches { Ok(v) && v == false };
}

test "deserialize string" {
    let r: Result<String, DeserializeError> = from_string(`"hello"`);
    assert r matches { Ok(v) && v == "hello" };
}

test "deserialize string with escapes" {
    let r: Result<String, DeserializeError> = from_string(`"line1\\nline2"`);
    assert r matches { Ok(v) && v == "line1\nline2" };
}

test "deserialize string with unicode" {
    let r: Result<String, DeserializeError> = from_string(`"\\u0041"`);
    assert r matches { Ok(v) && v == "A" };
}

test "deserialize trailing data error" {
    let r: Result<i32, DeserializeError> = from_string("42 extra");
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::TrailingData };
}

test "deserialize malformed error" {
    let r: Result<i32, DeserializeError> = from_string("abc");
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::UnexpectedType };
}

test "deserialize eof error" {
    let r: Result<String, DeserializeError> = from_string(`"`);
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::Eof };
}

test "deserialize i32 range limits" {
    let max: Result<i32, DeserializeError> = from_string("2147483647");
    assert max matches { Ok(v) && v == i32::MAX };
    let min: Result<i32, DeserializeError> = from_string("-2147483648");
    assert min matches { Ok(v) && v == i32::MIN };
}

test "deserialize i32 overflow errors" {
    let over: Result<i32, DeserializeError> = from_string("2147483648");
    assert over matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    let under: Result<i32, DeserializeError> = from_string("-2147483649");
    assert under matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    let wide: Result<i32, DeserializeError> = from_string("99999999999999999999999");
    assert wide matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
}

test "deserialize i64 range limits" {
    let max: Result<i64, DeserializeError> = from_string("9223372036854775807");
    assert max matches { Ok(v) && v == i64::MAX };
    let min: Result<i64, DeserializeError> = from_string("-9223372036854775808");
    assert min matches { Ok(v) && v == i64::MIN };
}

test "deserialize i64 overflow errors" {
    let over: Result<i64, DeserializeError> = from_string("9223372036854775808");
    assert over matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    let under: Result<i64, DeserializeError> = from_string("-9223372036854775809");
    assert under matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    let wide: Result<i64, DeserializeError> = from_string("92233720368547758080");
    assert wide matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
}

test "deserialize u64 full range" {
    let max: Result<u64, DeserializeError> = from_string("18446744073709551615");
    assert max matches { Ok(v) && v == u64::MAX };
}

test "deserialize u64 overflow errors" {
    let over: Result<u64, DeserializeError> = from_string("18446744073709551616");
    assert over matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    let wide: Result<u64, DeserializeError> = from_string("184467440737095516150");
    assert wide matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
}

test "deserialize u32 overflow errors" {
    let over: Result<u32, DeserializeError> = from_string("4294967296");
    assert over matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    let wide: Result<u32, DeserializeError> = from_string("99999999999999999999");
    assert wide matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
}

test "deserialize integer from scientific notation" {
    let a: Result<i32, DeserializeError> = from_string("1e2");
    assert a matches { Ok(v) && v == 100 };
    let b: Result<i64, DeserializeError> = from_string("1.5e3");
    assert b matches { Ok(v) && v == 1500 };
}

test "deserialize scientific notation overflow errors" {
    let a: Result<i32, DeserializeError> = from_string("3e9");
    assert a matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    let b: Result<i64, DeserializeError> = from_string("1e30");
    assert b matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    let c: Result<u64, DeserializeError> = from_string("1e30");
    assert c matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
}

test "deserialize string-encoded scientific overflow errors" {
    let a: Result<i64, DeserializeError> = from_string(`"1e30"`);
    assert a matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    let b: Result<u64, DeserializeError> = from_string(`"1e30"`);
    assert b matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
}

test "deserialize surrogate pair" {
    let emoji: Result<String, DeserializeError> = from_string(`"\\uD83D\\uDE00"`);
    assert emoji matches { Ok(v) && v == "😀" };
    let clef: Result<String, DeserializeError> = from_string(`"\\uD834\\uDD1E"`);
    assert clef matches { Ok(v) && v == "𝄞" };
}

test "deserialize unpaired surrogate errors" {
    let lone_high: Result<String, DeserializeError> = from_string(`"\\uD800"`);
    assert lone_high matches { Err(e) && e.kind == DeserializeErrorKind::MalformedInput };
    let lone_low: Result<String, DeserializeError> = from_string(`"\\uDC00"`);
    assert lone_low matches { Err(e) && e.kind == DeserializeErrorKind::MalformedInput };
    let no_pair: Result<String, DeserializeError> = from_string(`"\\uD800x"`);
    assert no_pair matches { Err(e) && e.kind == DeserializeErrorKind::MalformedInput };
}

test "deserialize i128 range limits" {
    let max: Result<i128, DeserializeError> = from_string("170141183460469231731687303715884105727");
    assert max matches { Ok(_) };
    if let Ok(v) = max {
        assert to_string(&v) matches { Ok(s) && s == `"170141183460469231731687303715884105727"` };
    }
    let min: Result<i128, DeserializeError> = from_string("-170141183460469231731687303715884105728");
    assert min matches { Ok(_) };
    if let Ok(v) = min {
        assert to_string(&v) matches { Ok(s) && s == `"-170141183460469231731687303715884105728"` };
    }
}

test "deserialize i128 overflow errors" {
    let over: Result<i128, DeserializeError> = from_string("170141183460469231731687303715884105728");
    assert over matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    let under: Result<i128, DeserializeError> = from_string("-170141183460469231731687303715884105729");
    assert under matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    let str_over: Result<i128, DeserializeError> = from_string(`"170141183460469231731687303715884105728"`);
    assert str_over matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
}

test "deserialize i128 rejects non-numeric input" {
    let arr: Result<i128, DeserializeError> = from_string("[]");
    assert arr matches { Err(e) && e.kind == DeserializeErrorKind::UnexpectedType };
    let dash: Result<i128, DeserializeError> = from_string(`"-"`);
    assert dash matches { Err(e) && e.kind == DeserializeErrorKind::InvalidValue };
    let empty: Result<i128, DeserializeError> = from_string(`""`);
    assert empty matches { Err(e) && e.kind == DeserializeErrorKind::InvalidValue };
}

test "deserialize u128 full range" {
    let max: Result<u128, DeserializeError> = from_string("340282366920938463463374607431768211455");
    assert max matches { Ok(_) };
    if let Ok(v) = max {
        assert to_string(&v) matches { Ok(s) && s == `"340282366920938463463374607431768211455"` };
    }
}

test "deserialize u128 overflow and negative errors" {
    let over: Result<u128, DeserializeError> = from_string("340282366920938463463374607431768211456");
    assert over matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
    let neg: Result<u128, DeserializeError> = from_string("-1");
    assert neg matches { Err(e) && e.kind == DeserializeErrorKind::Overflow };
}

test "deserialize f64 keeps scale when dropping excess fraction digits" {
    let r: Result<f64, DeserializeError> = from_string("1234567890.12345678901234567890");
    assert r matches { Ok(v) && 1234567890.0 < v < 1234567891.0 };
}

test "deserialize f64 long integer part with fraction" {
    let r: Result<f64, DeserializeError> = from_string("12345678901234567890123.5");
    assert r matches { Ok(v) && 12000000000000000000000.0 < v < 13000000000000000000000.0 };
}

test "serialize i64 beyond safe integer range as string" {
    let big: i64 = 9007199254740993;
    assert to_string(&big) matches { Ok(s) && s == `"9007199254740993"` };
    let neg: i64 = -9007199254740993;
    assert to_string(&neg) matches { Ok(s) && s == `"-9007199254740993"` };
    let safe: i64 = 9007199254740991;
    assert to_string(&safe) matches { Ok(s) && s == "9007199254740991" };
}

test "deserialize variant object with extra pair errors" {
    // External tagging is a single-pair object; the access's end() reports the
    // unbalanced '}' and the synthesized impl must propagate that error
    // (its Result used to be discarded).
    let ok: Result<PrettyShape, DeserializeError> = from_string(`\{"Circle":1.5\}`);
    assert ok matches { Ok(v) && v == PrettyShape::Circle(1.5) };
    let extra: Result<PrettyShape, DeserializeError> = from_string(`\{"Circle":1.5,"Point":null\}`);
    assert extra matches { Err(e) && e.kind == DeserializeErrorKind::MalformedInput };
}

test "serialize u64 beyond safe integer range as string" {
    let big: u64 = 18446744073709551615;
    assert to_string(&big) matches { Ok(s) && s == `"18446744073709551615"` };
    let safe: u64 = 9007199254740991;
    assert to_string(&safe) matches { Ok(s) && s == "9007199254740991" };
}

struct CanonInner {
    z: i32,
    a: i32,
}

impl Serialize for CanonInner;

struct CanonOuter {
    m: CanonInner,
}

impl Serialize for CanonOuter;

test "from_bytes accepts a String via AsByteSlice" {
    let r: Result<TreeMap<String, i32>, DeserializeError> = from_bytes("{\"y\":2}");
    assert r matches { Ok(_) };
    if let Ok(m) = r {
        assert m["y"] == 2;
    }
}

test "from_bytes parses a ByteList" {
    let bytes: ByteList = [0x7b, 0x22, 0x78, 0x22, 0x3a, 0x31, 0x7d];  // {"x":1}
    let r: Result<TreeMap<String, i32>, DeserializeError> = from_bytes(bytes);
    assert r matches { Ok(_) };
    if let Ok(m) = r {
        assert m["x"] == 1;
    }
}

test "from_bytes rejects invalid UTF-8" {
    let bytes: ByteList = [0x7b, 0x22, 0xff, 0x22, 0x7d];  // {"<0xff>"}
    let r: Result<TreeMap<String, i32>, DeserializeError> = from_bytes(bytes);
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::MalformedInput };
}

test "to_bytes_canonical sorts map keys" {
    let mut m: TreeMap<String, i32> = TreeMap::new();
    m["banana"] = 2;
    m["apple"] = 1;
    m["cherry"] = 3;
    let r = to_bytes_canonical(&m);
    assert r matches { Ok(_) };
    if let Ok(b) = r {
        assert_bytes_eq_string(&b, &"{\"apple\":1,\"banana\":2,\"cherry\":3}");
    }
}

test "to_bytes_canonical sorts struct fields" {
    let u = PrettyUser { first_name: "Ann", age: 30 };
    let r = to_bytes_canonical(&u);
    assert r matches { Ok(_) };
    if let Ok(b) = r {
        assert_bytes_eq_string(&b, &"{\"age\":30,\"firstName\":\"Ann\"}");
    }
}

test "to_bytes_canonical sorts nested struct fields recursively" {
    let o = CanonOuter {
        m: CanonInner { z: 1, a: 2 },
    };
    let r = to_bytes_canonical(&o);
    assert r matches { Ok(_) };
    if let Ok(b) = r {
        assert_bytes_eq_string(&b, &"{\"m\":{\"a\":2,\"z\":1}}");
    }
}

test "to_bytes_pretty matches to_string_pretty" {
    let u = PrettyUser { first_name: "Bo", age: 5 };
    let pretty = to_bytes_pretty(&u);
    assert pretty matches { Ok(_) };
    if let Ok(b) = pretty {
        if let Ok(s) = to_string_pretty(&u) {
            assert_bytes_eq_string(&b, &s);
        }
    }
}
