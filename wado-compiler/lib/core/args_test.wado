//! Tests for `core:args` — argv parsing via `core:serde`.
//!
//! These exercise serde's per-field positional resolution end to end: the
//! synthesized `FieldSchema::lookup` (for `--options`) and `positional_at` (for
//! bare tokens), through the `ArgvDeserializer`.

use { Deserialize } from "core:serde";
use { parse, ArgsError, ArgsErrorKind } from "core:args";

struct Cli {
    #[wire(positional)]
    input: String,
    #[wire(positional)]
    out: String = "out.txt",
    #[wire(positional)]
    rest: List<String> = [],
    jobs: i32 = 1,
    verbose: bool = false,
    output: Option<String> = null,
}
impl Deserialize for Cli;

fn cli(r: Result<Cli, ArgsError>) -> Cli {
    if let Ok(c) = r {
        return c;
    }
    if let Err(e) = r {
        panic(`parse failed: ${e.message}`);
    }
    unreachable();
}

test "positionals and options mixed" {
    let c = cli(parse::<Cli>(["in.txt", "out.bin", "a", "b", "--jobs", "4", "--verbose"]));
    assert c.input == "in.txt";
    assert c.out == "out.bin";
    assert c.rest.len() == 2;
    assert c.rest[0] == "a";
    assert c.rest[1] == "b";
    assert c.jobs == 4;
    assert c.verbose == true;
    assert c.output matches { None };
}

test "options may precede positionals" {
    let c = cli(parse::<Cli>(["--jobs", "7", "in.txt"]));
    assert c.input == "in.txt";
    assert c.jobs == 7;
}

test "defaults fill omitted optional fields" {
    let c = cli(parse::<Cli>(["only.txt"]));
    assert c.input == "only.txt";
    assert c.out == "out.txt";
    assert c.rest.len() == 0;
    assert c.jobs == 1;
    assert c.verbose == false;
    assert c.output matches { None };
}

test "inline --name=value and Option option" {
    let c = cli(parse::<Cli>(["x", "--jobs=8", "--output", "log.txt"]));
    assert c.jobs == 8;
    assert c.output matches { Some(s) && s == "log.txt" };
}

test "bare flag is true, inline flag is converted" {
    let on = cli(parse::<Cli>(["x", "--verbose"]));
    assert on.verbose == true;
    let off = cli(parse::<Cli>(["x", "--verbose=0"]));
    assert off.verbose == false;
}

test "lenient scalar conversion" {
    let c = cli(parse::<Cli>(["x", "--jobs", "0x10"]));
    assert c.jobs == 16;
}

test "missing required positional reports MissingArgument" {
    let r = parse::<Cli>(["--jobs", "2"]);
    assert r matches { Err(e) && e.kind == ArgsErrorKind::MissingArgument };
}

test "unknown option reports UnknownOption" {
    let r = parse::<Cli>(["in.txt", "--nope"]);
    assert r matches { Err(e) && e.kind == ArgsErrorKind::UnknownOption };
}

test "missing option value reports MissingValue" {
    let r = parse::<Cli>(["in.txt", "--jobs"]);
    assert r matches { Err(e) && e.kind == ArgsErrorKind::MissingValue };
}

test "invalid scalar reports InvalidValue" {
    let r = parse::<Cli>(["in.txt", "--jobs", "abc"]);
    assert r matches { Err(e) && e.kind == ArgsErrorKind::InvalidValue };
}

test "option value missing before a flag reports MissingValue, not a silent steal" {
    // `--output` needs a value; the next token `--verbose` is an option, so the
    // value is missing rather than `--verbose` being swallowed as the value.
    let r = parse::<Cli>(["in.txt", "--output", "--verbose"]);
    assert r matches { Err(e) && e.kind == ArgsErrorKind::MissingValue };
}

test "negative number is a valid option value (single dash, not an option)" {
    let c = cli(parse::<Cli>(["in.txt", "--jobs", "-5"]));
    assert c.jobs == -5;
}

test "malformed empty option name reports a clear error" {
    let r = parse::<Cli>(["in.txt", "--=x"]);
    assert r matches { Err(e) && e.kind == ArgsErrorKind::UnknownOption && e.message == "malformed option: --=x" };
}

// Positional fields need not be contiguous in declaration order: `positional_at`
// maps the rank-th positional to its field index across the option fields.
struct Mixed {
    jobs: i32 = 1,  // field 0 (option)
    #[wire(positional)]
    a: String,  // field 1 (positional rank 0)
    dry_run: bool = false,  // field 2 (option, dash-folded)
    #[wire(positional)]
    b: String,  // field 3 (positional rank 1)
}
impl Deserialize for Mixed;

fn mixed(r: Result<Mixed, ArgsError>) -> Mixed {
    if let Ok(c) = r {
        return c;
    }
    if let Err(e) = r {
        panic(`parse failed: ${e.message}`);
    }
    unreachable();
}

test "non-contiguous positionals map by rank" {
    let c = mixed(parse::<Mixed>(["--jobs", "5", "first", "--dry-run", "second"]));
    assert c.a == "first";
    assert c.b == "second";
    assert c.jobs == 5;
    assert c.dry_run == true;
}

test "dash and underscore fold in option names" {
    let c = mixed(parse::<Mixed>(["one", "two", "--dry-run"]));
    assert c.dry_run == true;
}

test "too many positionals reports TooManyPositionals" {
    let r = parse::<Mixed>(["one", "two", "three"]);
    assert r matches { Err(e) && e.kind == ArgsErrorKind::TooManyPositionals };
}

struct Variadic {
    #[wire(positional)]
    first: String,
    #[wire(positional)]
    rest: List<String> = [],
}
impl Deserialize for Variadic;

fn variadic(r: Result<Variadic, ArgsError>) -> Variadic {
    if let Ok(c) = r {
        return c;
    }
    if let Err(e) = r {
        panic(`parse failed: ${e.message}`);
    }
    unreachable();
}

test "variadic positional with no extra tokens is empty" {
    let c = variadic(parse::<Variadic>(["solo"]));
    assert c.first == "solo";
    assert c.rest.len() == 0;
}

test "variadic positional collects the rest" {
    let c = variadic(parse::<Variadic>(["a", "b", "c", "d"]));
    assert c.first == "a";
    assert c.rest.len() == 3;
    assert c.rest[2] == "d";
}

test "double dash forces remaining tokens positional" {
    let c = variadic(parse::<Variadic>(["a", "--", "--weird", "-x"]));
    assert c.first == "a";
    assert c.rest.len() == 2;
    assert c.rest[0] == "--weird";
    assert c.rest[1] == "-x";
}

// Repeatable `List<T>` options: each `--name v` appends; occurrences may be
// interspersed with other options.
struct Repeatable {
    #[wire(positional)]
    input: String,
    include: List<String> = [],  // repeatable, optional (>=0)
    n: List<i32> = [],  // repeatable, typed
    jobs: i32 = 1,
}
impl Deserialize for Repeatable;

fn repeatable(r: Result<Repeatable, ArgsError>) -> Repeatable {
    if let Ok(c) = r {
        return c;
    }
    if let Err(e) = r {
        panic(`parse failed: ${e.message}`);
    }
    unreachable();
}

test "repeatable option appends across occurrences" {
    let c = repeatable(parse::<Repeatable>(["in", "--include", "a", "--include", "b"]));
    assert c.include.len() == 2;
    assert c.include[0] == "a";
    assert c.include[1] == "b";
}

test "repeatable option interspersed with other options" {
    let c = repeatable(parse::<Repeatable>(["in", "--include", "a", "--jobs", "4", "--include=b", "--include", "c"]));
    assert c.jobs == 4;
    assert c.include.len() == 3;
    assert c.include[2] == "c";
}

test "repeatable typed values convert leniently" {
    let c = repeatable(parse::<Repeatable>(["in", "--n", "1", "--n", "0x10"]));
    assert c.n.len() == 2;
    assert c.n[0] == 1;
    assert c.n[1] == 16;
}

test "repeatable option absent yields empty default" {
    let c = repeatable(parse::<Repeatable>(["in"]));
    assert c.include.len() == 0;
}

struct Required {
    define: List<String>,  // repeatable, required (>=1)
}
impl Deserialize for Required;

test "required repeatable present" {
    let r = parse::<Required>(["--define", "X", "--define", "Y"]);
    if let Ok(c) = r {
        assert c.define.len() == 2;
    } else {
        panic("expected Ok");
    }
}

test "required repeatable absent reports MissingArgument" {
    let r = parse::<Required>([]);
    assert r matches { Err(e) && e.kind == ArgsErrorKind::MissingArgument };
}

// Subcommands: a `#[wire(positional)]` variant field. The leading bare token
// selects the case (externally tagged); the payload parses from the rest.
struct AddArgs {
    #[wire(positional)]
    path: String,
    all: bool = false,
}
impl Deserialize for AddArgs;

variant RemoteCmd {
    AddRemote(AddRemoteArgs),
    List,
}
struct AddRemoteArgs {
    #[wire(positional)]
    name: String,
}
impl Deserialize for AddRemoteArgs;
impl Deserialize for RemoteCmd;

variant Command {
    Add(AddArgs),
    Remote(RemoteCmd),
    Status,
}
impl Deserialize for Command;

struct App {
    verbose: bool = false,
    jobs: i32 = 1,
    #[wire(positional)]
    command: Command,
}
impl Deserialize for App;

fn app(r: Result<App, ArgsError>) -> App {
    if let Ok(c) = r {
        return c;
    }
    if let Err(e) = r {
        panic(`parse failed: ${e.message}`);
    }
    unreachable();
}

test "global options precede subcommand, then sub-options" {
    let c = app(parse::<App>(["--verbose", "--jobs", "4", "Add", "p.txt", "--all"]));
    assert c.verbose == true;
    assert c.jobs == 4;
    assert c.command matches { Add(a) && a.path == "p.txt" && a.all == true };
}

test "unit subcommand" {
    let c = app(parse::<App>(["Status"]));
    assert c.command matches { Status };
}

test "subcommand payload defaults" {
    let c = app(parse::<App>(["Add", "only.txt"]));
    assert c.command matches { Add(a) && a.path == "only.txt" && a.all == false };
}

test "nested subcommands" {
    let c = app(parse::<App>(["Remote", "AddRemote", "origin"]));
    assert c.command matches { Remote(r) && r matches { AddRemote(a) && a.name == "origin" } };
}

test "unknown subcommand reports UnknownSubcommand" {
    let r = parse::<App>(["Bogus"]);
    assert r matches { Err(e) && e.kind == ArgsErrorKind::UnknownSubcommand };
}

// `#[wire(name_policy)]` on the subcommand variant gives idiomatic lowercase /
// kebab tags while the cases stay PascalCase — serde-general, no args support.
#[wire(name_policy = "kebab-case")]
variant KebabCmd {
    AddRemote(AddRemoteArgs),
    List,
}
impl Deserialize for KebabCmd;

struct KebabApp {
    #[wire(positional)]
    command: KebabCmd,
}
impl Deserialize for KebabApp;

test "kebab subcommand tag from rename_all" {
    let r = parse::<KebabApp>(["add-remote", "origin"]);
    if let Ok(c) = r {
        assert c.command matches { AddRemote(a) && a.name == "origin" };
    } else {
        panic("expected Ok");
    }
}
