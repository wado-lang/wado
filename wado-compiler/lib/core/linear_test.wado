use { LinearArray, LinearBuffer, ListArg } from "core:linear";
use { f32x4 } from "core:simd";

type Meters = f64;

/// `n` bytes counting up from `from`, wrapping at a prime so no run repeats in
/// step with a read.
fn counting(from: i32, n: i32) -> List<u8> {
    let mut bytes: List<u8> = [];
    for let i of from..<from + n {
        bytes.push((i % 251) as u8);
    }
    return bytes;
}

/// Serves `content` at most `step` bytes a read, the last read ending the stream.
struct Trickle {
    content: List<u8>,
    at: i32,
    step: i32,
}

impl Stream<u8> for Trickle {
    fn begin_read(&mut self, this: &Stream<u8>, max: i32, into: ReadInto) -> StartedRead<u8> {
        let _ = [this, into];
        let end = i32::min(self.content.len(), self.at + i32::min(max, self.step));
        let items = self.content[self.at..<end].to_list() as List<u8>;
        self.at = end;
        let result = if end == self.content.len() { CopyResult::Dropped } else { CopyResult::Completed };
        resume StartedRead::settled(StreamChunk { items, result });
    }

    ..forward
}

test "read_stream reads a stream to its end" {
    let [rx, tx] = Stream::<u8>::new();
    tx.drop();
    let mut source = Trickle { content: counting(0, 10000), at: 0, step: 3000 };
    let array = with &mut source do {
        LinearArray::<u8>::read_stream(&rx, 4096);
    };
    rx.drop();
    assert array.to_list() == counting(0, 10000);
}

test "lengthen keeps the bytes, in the block or past it" {
    // Lengthening to 3 doubles the 2-byte block to 4, which 4 then fits.
    let mut array = LinearArray::<u8>::filled(2, 1);
    array.lengthen(3);
    array.set(2, 7);
    array.lengthen(4);
    array.set(3, 9);
    assert array.to_list() == [1, 1, 7, 9];
}

test "of_bytes copies a range and pads it with zeros" {
    let source: ByteList = [1, 2, 3, 4, 5];
    assert LinearArray::<u8>::of_bytes(&source, 1, 3).to_list() == [2, 3, 4];
    assert LinearArray::<u8>::of_bytes(&source, 3, 2, 2).to_list() == [4, 5, 0, 0];
}

test "to_byte_list copies the first bytes" {
    let source: ByteList = [1, 2, 3];
    assert LinearArray::<u8>::of_bytes(&source, 0, 3).to_byte_list(2) == [1, 2];
}

test "load_at and store_at move a value little-endian at any offset" {
    let mut bytes = LinearArray::<u8>::filled(7, 0);
    bytes.store_at::<u32>(1, 0x04030201);
    assert bytes.to_list() == [0, 1, 2, 3, 4, 0, 0];
    assert bytes.load_at::<u16>(2) == 0x0302;
    assert bytes.load_at::<u32>(3) == 0x0403;
}

test "copy_from copies a range, overlapping its source or not" {
    let source: ByteList = [1, 2, 3, 4, 5, 6];
    let mut bytes = LinearArray::<u8>::of_bytes(&source, 0, 6);
    let whole = &bytes;
    bytes.copy_from(2, whole, 0, 3);
    assert bytes.to_list() == [1, 2, 1, 2, 3, 6];
    let other = LinearArray::<u8>::filled(2, 9);
    bytes.copy_from(4, &other, 0, 2);
    assert bytes.to_list() == [1, 2, 1, 2, 9, 9];
}

#[expect_trap]
test "load_at traps where the value runs past the end" {
    let bytes = LinearArray::<u8>::filled(4, 0);
    let _ = bytes.load_at::<u32>(1);
}

test "a buffer of an array holds its bytes and reads no more" {
    let bytes: List<u8> = [1, 2, 3, 4];
    let mut buffer = LinearBuffer::of(LinearArray::from_slice(&bytes));
    assert buffer.fill(4);
    assert !buffer.fill(5);
    buffer.consume(3);
    assert buffer.len() == 1;
    assert buffer.bytes().at(buffer.start()) == 4;
    assert buffer.position() == 3;
}

test "a buffer reads a stream a part at a time, wherever its reads fall" {
    let [rx, tx] = Stream::<u8>::new();
    tx.drop();
    let mut source = Trickle { content: counting(0, 200500), at: 0, step: 7000 };
    with &mut source do {
        let mut buffer = LinearBuffer::of_stream(rx);
        let mut seen = 0;
        while buffer.fill(1000) {
            let start = buffer.start();
            assert buffer.bytes().to_list_of::<u8>(start, start + 1000) == counting(seen, 1000);
            assert buffer.position() == seen as i64;
            buffer.consume(1000);
            seen += 1000;
        }
        assert seen == 200000;
        assert buffer.len() == 500;
        assert buffer.bytes().to_list_of::<u8>(buffer.start(), buffer.start() + 500) == counting(seen, 500);
    };
}

test "a fill past the buffer's room grows it" {
    let [rx, tx] = Stream::<u8>::new();
    tx.drop();
    let mut source = Trickle { content: counting(0, 150000), at: 0, step: 50000 };
    with &mut source do {
        let mut buffer = LinearBuffer::of_stream(rx);
        assert buffer.fill(10);
        buffer.consume(10);
        assert buffer.fill(149990);
        assert buffer.bytes().to_list_of::<u8>(buffer.start(), buffer.start() + 149990) == counting(10, 149990);
    };
}

test "a fill takes memory for what the stream delivers, not for what it asks" {
    // Three asks for 2 GiB at once would not fit the 4 GiB a memory addresses.
    let mut held: List<LinearBuffer> = [];
    for let _ of 0..<3 {
        let [rx, tx] = Stream::<u8>::new();
        tx.drop();
        let mut source = Trickle { content: counting(0, 5), at: 0, step: 5 };
        with &mut source do {
            let mut buffer = LinearBuffer::of_stream(rx);
            assert !buffer.fill(i32::MAX);
            assert buffer.len() == 5;
            held.push(buffer);
        };
    }
}

/// Forwards each read, noting whether the reader lent it memory of its own.
struct Lender {
    lent: bool,
}

impl Stream<u8> for Lender {
    fn begin_read(&mut self, this: &Stream<u8>, max: i32, into: ReadInto) -> StartedRead<u8> {
        self.lent = into.landing(max)[2] == 0;
        resume this.begin_read(max, into);
    }

    ..forward
}

test "a buffer lends its own memory to a stream copy" {
    let [rx, tx] = Stream::<u8>::new();
    let writing = tx.start_write([1, 2, 3, 4, 5]);
    let mut buffer = LinearBuffer::of_stream(rx);
    let mut lender = Lender { lent: false };
    with &mut lender do {
        assert buffer.fill(2);
    };
    assert lender.lent;
    assert buffer.len() == 5;
    let [writer, _] = writing.finish();
    writer.drop();
    assert !buffer.fill(6);
    assert buffer.bytes().to_list_of::<u8>(0, 5) == [1, 2, 3, 4, 5];
}

test "to_string_of reads a byte range as text" {
    let source: ByteList = b"\xffhi\xc3\xa9";
    let bytes = LinearArray::from_slice(&source);
    assert bytes.to_string_of(1, 5).unwrap() == "hié";
    assert bytes.to_string_of(1, 1).unwrap() == "";
    assert bytes.to_string_of(0, 3).unwrap_err() == Utf8Error::invalid(0, 1);
    assert bytes.to_string_of(1, 4).unwrap_err() == Utf8Error::incomplete(2);
}

test "filled writes every element, at each width" {
    let bytes = LinearArray::<i8>::filled(5, -3);
    assert bytes.to_list() == [-3, -3, -3, -3, -3];
    let halves = LinearArray::<f16>::filled(3, 1.5);
    assert halves[2] == 1.5;
    let wide = LinearArray::<u64>::filled(2, u64::MAX);
    assert wide[1] == u64::MAX;
    let lanes = LinearArray::<f32x4>::filled(3, f32x4::splat(2.0));
    assert lanes[2].extract_lane(3) == 2.0;
    let lengths = LinearArray::<Meters>::filled(2, 4.5 as Meters);
    assert lengths[1] == 4.5 as Meters;
}

test "an empty array holds nothing" {
    let empty = LinearArray::<f32>::filled(0, 1.0);
    assert empty.len() == 0;
    assert empty.is_empty();
    assert empty.to_list() == [];
    assert empty.duplicate().is_empty();
}

test "from_slice copies each element of a list" {
    let source: List<i32> = [7, -1, 0, 2147483647];
    let array = LinearArray::from_slice(&source);
    assert array.len() == 4;
    assert !array.is_empty();
    assert array.to_list() == source;
}

test "from_slice reads a byte list" {
    let source: ByteList = b"\x01\x02\xff";
    let array = LinearArray::from_slice(&source);
    assert array.at(2) == 0xFF;
}

test "set and an index assignment write one element" {
    let mut array = LinearArray::<i16>::filled(4, 0);
    array.set(1, -5);
    array[3] = 9;
    assert array.at(1) == -5;
    assert array[3] == 9;
    assert array.to_list() == [0, -5, 0, 9];
}

test "duplicate holds the elements apart from its source" {
    let mut source = LinearArray::<i32>::filled(3, 1);
    let copy = source.duplicate();
    source[0] = 5;
    assert copy.to_list() == [1, 1, 1];
    assert source.to_list() == [5, 1, 1];
}

test "cast reads the same bytes as another type" {
    let floats = LinearArray::<f32>::filled(2, 1.0);
    let bits = floats.cast::<u32>();
    assert bits.to_list() == [0x3F800000, 0x3F800000];
    let bytes = bits.cast::<u8>();
    assert bytes.len() == 8;
    assert bytes.to_list() == [0x00, 0x00, 0x80, 0x3F, 0x00, 0x00, 0x80, 0x3F];
    let back = bytes.cast::<f32>();
    assert back.to_list() == [1.0, 1.0];
}

test "to_list_of reads a byte range as little-endian elements" {
    let source: ByteList = [0xFF, 0x00, 0x00, 0x80, 0x3F, 0x00, 0x00, 0x00, 0xC0];
    let bytes = LinearArray::from_slice(&source);
    assert bytes.to_list_of::<f32>(1, 9) == [1.0, -2.0];
    assert bytes.to_list_of::<u16>(0, 2) == [0x00FF];
    assert bytes.to_list_of::<u8>(3, 3) == [];
}

#[expect_trap]
test "to_list_of traps on a range past the end" {
    let bytes = LinearArray::<u8>::filled(4, 0);
    let _ = bytes.to_list_of::<u8>(2, 5);
}

#[expect_trap]
test "to_list_of traps where the range is not whole elements" {
    let bytes = LinearArray::<u8>::filled(6, 0);
    let _ = bytes.to_list_of::<f32>(0, 6);
}

#[expect_trap]
test "cast traps where the bytes are not whole elements of the new type" {
    let bytes = LinearArray::<u8>::filled(6, 0);
    let _ = bytes.cast::<f32>();
}

#[expect_trap]
test "filled traps on a negative length" {
    let _ = LinearArray::<u8>::filled(-1, 0);
}

#[expect_trap]
test "filled traps past the address space" {
    let _ = LinearArray::<f64>::filled(i32::MAX / 8 + 1, 0.0);
}

#[expect_trap]
test "at traps past the end" {
    let array = LinearArray::<i32>::filled(2, 0);
    let _ = array.at(2);
}

#[expect_trap]
test "at traps below zero" {
    let array = LinearArray::<i32>::filled(2, 0);
    let _ = array.at(-1);
}

#[expect_trap]
test "set traps past the end" {
    let mut array = LinearArray::<i32>::filled(2, 0);
    array.set(2, 1);
}

#[expect_trap]
test "an index read traps past the end" {
    let array = LinearArray::<i32>::filled(2, 0);
    let _ = array[2];
}

#[expect_trap]
test "an index assignment traps past the end" {
    let mut array = LinearArray::<i32>::filled(2, 0);
    array[2] = 1;
}

test "a list lowers to a view of a copy, at each width" {
    let bytes: List<u8> = [1, 2];
    assert bytes.lowered().to_list() == bytes;
    let signed_bytes: List<i8> = [-1, 2];
    assert signed_bytes.lowered().to_list() == signed_bytes;
    let halves: List<u16> = [1, u16::MAX];
    assert halves.lowered().to_list() == halves;
    let signed_halves: List<i16> = [-1, i16::MIN];
    assert signed_halves.lowered().to_list() == signed_halves;
    let words: List<u32> = [1, u32::MAX];
    assert words.lowered().to_list() == words;
    let signed_words: List<i32> = [-1, i32::MIN];
    assert signed_words.lowered().to_list() == signed_words;
    let wide: List<u64> = [1, u64::MAX];
    assert wide.lowered().to_list() == wide;
    let signed_wide: List<i64> = [-1, i64::MIN];
    assert signed_wide.lowered().to_list() == signed_wide;
    let floats: List<f32> = [0.5, -1.5];
    assert floats.lowered().to_list() == floats;
    let doubles: List<f64> = [0.25, f64::MAX];
    assert doubles.lowered().to_list() == doubles;
}

test "an array lowers to a view of its own block" {
    let mut array = LinearArray::<u16>::filled(3, 7);
    let view = (&array).lowered();
    array[1] = 9;
    assert view.len() == 3;
    assert view.at(1) == 9;
    assert view[2] == 7;
}

test "an empty view holds nothing" {
    let empty: List<f32> = [];
    let view = empty.lowered();
    assert view.is_empty();
    assert view.to_list() == empty;
    assert !(&LinearArray::<u8>::filled(1, 0)).lowered().is_empty();
}

#[expect_trap]
test "a view read traps past the end" {
    let bytes: List<u8> = [1];
    let _ = bytes.lowered()[1];
}
