#![stdlib("core:protobuf")]
//! Protocol Buffers over `core:serde`: the wire format, and nothing of
//! `.proto`. See `docs/wep-2026-09-22-grog.md`.

use {
    DEFAULT_MAX_DEPTH,
    Deserialize,
    DeserializeError,
    DeserializeMap,
    DeserializeSeq,
    DeserializeStruct,
    DeserializeVariant,
    Deserializer,
    DuplicateKeyPolicy,
    FieldSchema,
    Serialize,
    SerializeError,
    SerializeErrorKind,
    SerializeMap,
    SerializeSeq,
    SerializeStruct,
    SerializeVariant,
    Serializer,
    Visitor,
    WireEncoding,
    WireNumbered,
    deeper,
} from "core:serde";

#[synopsis]
test {
    struct Point {
        #[wire(number = 1)]
        x: i32 = 0,
        #[wire(number = 2)]
        y: i32 = 0,
    }

    let Ok(bytes) = to_bytes(&Point { x: 1, y: 150 }) else {
        panic("the message did not encode");
    };
    let Ok(back) = from_bytes::<Point, ByteList>(bytes) else {
        panic("the message did not decode");
    };
    assert back.x == 1;
    assert back.y == 150;
}

/// What follows a tag, as the wire format numbers them.
pub enum WireType {
    Varint,
    Fixed64,
    Len,
    Fixed32,
}

impl WireType {
    /// The three bits a tag carries, or `None` for a number no wire type
    /// uses. `3` and `4` are the deprecated group markers.
    pub fn from_bits(bits: i32) -> Option<WireType> {
        return match bits {
            0 => Option::Some(WireType::Varint),
            1 => Option::Some(WireType::Fixed64),
            2 => Option::Some(WireType::Len),
            5 => Option::Some(WireType::Fixed32),
            _ => null,
        };
    }

    pub fn bits(&self) -> i32 {
        return match self {
            Varint => 0,
            Fixed64 => 1,
            Len => 2,
            Fixed32 => 5,
        };
    }

    /// A fixed-width element's width in bytes. The other two wire types are
    /// not fixed-width, and the only caller has already excluded them.
    fn element_width(&self) -> i32 {
        return match self {
            Fixed32 => 4,
            Fixed64 => 8,
            Varint => unreachable(),
            Len => unreachable(),
        };
    }
}

/// A base-128 varint: seven payload bits per byte, low group first, the top
/// bit set on every byte but the last.
pub fn write_varint(buf: &mut ByteList, value: u64) {
    let mut rest = value;
    while rest >= 128 {
        buf.push((rest & 0x7f | 0x80) as u8);
        rest = rest >> 7;
    }
    buf.push(rest as u8);
}

/// How many bytes `write_varint` would write.
pub fn varint_len(value: u64) -> i32 {
    let mut rest = value;
    let mut len = 1;
    while rest >= 128 {
        rest = rest >> 7;
        len += 1;
    }
    return len;
}

/// A field's tag: its number and what follows it, in one varint.
pub fn write_tag(buf: &mut ByteList, number: i32, wire_type: WireType) {
    write_varint(buf, number as u64 << 3 | wire_type.bits() as u64);
}

pub fn tag_len(number: i32) -> i32 {
    return varint_len(number as u64 << 3);
}

/// Zigzag: the encoding `sint32` and `sint64` use, which keeps a small
/// negative number small by moving the sign to the low bit.
pub fn zigzag_64(value: i64) -> u64 {
    return (value << 1 ^ value >> 63) as u64;
}

pub fn unzigzag_64(value: u64) -> i64 {
    return (value >> 1) as i64 ^ -((value & 1) as i64);
}

pub fn write_fixed32(buf: &mut ByteList, value: u32) {
    buf.push(value as u8);
    buf.push((value >> 8) as u8);
    buf.push((value >> 16) as u8);
    buf.push((value >> 24) as u8);
}

pub fn write_fixed64(buf: &mut ByteList, value: u64) {
    write_fixed32(buf, value as u32);
    write_fixed32(buf, (value >> 32) as u32);
}

/// A varint read at `pos`, with the position after it. `None` where the bytes
/// run out or the varint runs past the ten bytes a 64-bit value can take.
pub fn read_varint(input: &ByteSlice, pos: i32) -> Option<[u64, i32]> {
    let mut value: u64 = 0;
    let mut shift = 0;
    let mut at = pos;
    while at < input.len() {
        let byte = input[at];
        at += 1;
        // The tenth byte carries one bit, since 64 is not a multiple of 7. A
        // payload above it is a number no `u64` holds.
        if shift == 63 && byte > 1 {
            builtin::cold_path();
            return null;
        }
        value = value | (byte & 0x7f) as u64 << shift as u64;
        if byte < 128 {
            return Option::Some([value, at]);
        }
        shift += 7;
        if shift >= 70 {
            builtin::cold_path();
            return null;
        }
    }
    builtin::cold_path();
    return null;
}

pub fn read_fixed32(input: &ByteSlice, pos: i32) -> Option<[u32, i32]> {
    if pos + 4 > input.len() {
        builtin::cold_path();
        return null;
    }
    let value = input[pos] as u32 | input[pos + 1] as u32 << 8 | input[pos + 2] as u32 << 16 | input[pos + 3] as u32 << 24;
    return Option::Some([value, pos + 4]);
}

pub fn read_fixed64(input: &ByteSlice, pos: i32) -> Option<[u64, i32]> {
    let Some([low, after_low]) = read_fixed32(input, pos) else {
        return null;
    };
    let Some([high, after_high]) = read_fixed32(input, after_low) else {
        return null;
    };
    return Option::Some([low as u64 | high as u64 << 32, after_high]);
}

fn unsupported<S: AsStrSlice>(what: S) -> SerializeError {
    return SerializeError {
        kind: SerializeErrorKind::UnsupportedValue,
        message: `protobuf cannot encode ${what}`,
    };
}

/// The number a field carries at the root of a message, where no tag is
/// written. A real field number starts at 1, so it can never collide.
global NO_FIELD: i32 = 0;

/// The field numbers the wire format admits, from the specification's
/// "Assigning Field Numbers". `wado-compiler/src/ast.rs` holds the same two.
global FIELD_NUMBER_MIN: i32 = 1;
global FIELD_NUMBER_MAX: i32 = 536870911;

/// Whether a number can key a field on the wire. `WireNumbered` answers for
/// the type a call names; a field holding another message is bound by nothing.
fn is_field_number(number: i64) -> bool {
    return FIELD_NUMBER_MIN as i64 <= number <= FIELD_NUMBER_MAX as i64;
}

fn unnumbered<S: AsStrSlice>(name: S) -> SerializeError {
    return SerializeError {
        kind: SerializeErrorKind::UnsupportedValue,
        message: `protobuf cannot encode the unnumbered field ${name}`,
    };
}

/// Each submessage's payload length, in the order the traversal opens them.
/// Slot 0 is the whole message.
struct SizeState {
    sizes: List<i32>,
    open: List<i32>,
}

impl SizeState {
    fn add(&mut self, bytes: i32) {
        let slot = self.open[self.open.len() - 1];
        self.sizes[slot] = self.sizes[slot] + bytes;
    }

    fn open_frame(&mut self) {
        self.sizes.push(0);
        self.open.push(self.sizes.len() - 1);
    }

    fn close_frame(&mut self, number: i32) {
        let last = self.open.len() - 1;
        let total = self.sizes[self.open[last]];
        self.open.truncate(last);
        if number != NO_FIELD {
            self.add(tag_len(number) + varint_len(total as u64) + total);
        }
    }
}

struct SizeSerializer {
    state: &mut SizeState,
    number: i32,
    encoding: WireEncoding,
    /// Whether a zero here is what an absent field means, and so stays off
    /// the wire: proto3's implicit presence.
    implicit: bool,
}

struct SizeSeqSerializer {
    state: &mut SizeState,
    number: i32,
    encoding: WireEncoding,
}

struct SizeStructSerializer {
    state: &mut SizeState,
    number: i32,
}

/// The two shapes protobuf has no encoding for. Both passes name these as
/// their associated types, and neither is ever constructed: what would build
/// one returns the error instead.
struct UnsupportedMap {
}

struct UnsupportedVariant {
}

impl SerializeMap for UnsupportedMap {
    fn key<T: Serialize>(&mut self, key: &T) -> Result<(), SerializeError> {
        return Result::Err(unsupported("a map"));
    }

    fn value<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        return Result::Err(unsupported("a map"));
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        return Result::Err(unsupported("a map"));
    }
}

impl SerializeVariant for UnsupportedVariant {
    fn payload<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        return Result::Err(unsupported("a variant case with a payload"));
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        return Result::Err(unsupported("a variant case with a payload"));
    }
}

impl SizeSerializer {
    fn count_varint(&mut self, payload: u64) -> Result<(), SerializeError> {
        self.state.add(tag_len(self.number) + varint_len(payload));
        return Result::Ok(());
    }

    fn count_fixed(&mut self, width: i32) -> Result<(), SerializeError> {
        self.state.add(tag_len(self.number) + width);
        return Result::Ok(());
    }

    fn count_len(&mut self, payload: i32) -> Result<(), SerializeError> {
        if self.implicit && payload == 0 {
            return Result::Ok(());
        }
        self.state.add(tag_len(self.number) + varint_len(payload as u64) + payload);
        return Result::Ok(());
    }

    /// An integer of `width` bytes, as the field's encoding writes it.
    fn count_integer(&mut self, v: i64, width: i32) -> Result<(), SerializeError> {
        if self.implicit && v == 0 {
            return Result::Ok(());
        }
        return match self.encoding {
            Plain => self.count_varint(v as u64),
            ZigZag => self.count_varint(zigzag_64(v)),
            Fixed => self.count_fixed(width),
        };
    }
}

impl SerializeSeq for SizeSeqSerializer {
    fn element<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        let mut ser = SizeSerializer {
            state: self.state,
            number: self.number,
            encoding: self.encoding,
            implicit: false,
        };
        return value.serialize::<SizeSerializer>(&mut ser);
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
}

impl SerializeStruct for SizeStructSerializer {
    fn field<T: Serialize, S: AsStrSlice>(&mut self, name: S, value: &T) -> Result<(), SerializeError> {
        return Result::Err(unnumbered(name));
    }

    fn field_numbered<T: Serialize, S: AsStrSlice>(
        &mut self,
        number: i32,
        encoding: WireEncoding,
        implicit: bool,
        name: S,
        value: &T,
    ) -> Result<(), SerializeError> {
        if !is_field_number(number as i64) {
            builtin::cold_path();
            return Result::Err(unnumbered(name));
        }
        let mut ser = SizeSerializer { state: self.state, number, encoding, implicit };
        return value.serialize::<SizeSerializer>(&mut ser);
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.state.close_frame(self.number);
        return Result::Ok(());
    }
}

impl Serializer for SizeSerializer {
    type SeqSerializer = SizeSeqSerializer;
    type MapSerializer = UnsupportedMap;
    type StructSerializer = SizeStructSerializer;
    type VariantSerializer = UnsupportedVariant;

    fn serialize_i32(&mut self, v: i32) -> Result<(), SerializeError> {
        return self.count_integer(v as i64, 4);
    }

    fn serialize_i64(&mut self, v: i64) -> Result<(), SerializeError> {
        return self.count_integer(v, 8);
    }

    fn serialize_u32(&mut self, v: u32) -> Result<(), SerializeError> {
        return self.count_integer(v as i64, 4);
    }

    fn serialize_u64(&mut self, v: u64) -> Result<(), SerializeError> {
        return self.count_integer(v as i64, 8);
    }

    fn serialize_i128(&mut self, v: i128) -> Result<(), SerializeError> {
        return Result::Err(unsupported("an i128"));
    }

    fn serialize_u128(&mut self, v: u128) -> Result<(), SerializeError> {
        return Result::Err(unsupported("a u128"));
    }

    fn serialize_f32(&mut self, v: f32) -> Result<(), SerializeError> {
        if self.implicit && v.to_bits() == 0 {
            return Result::Ok(());
        }
        return self.count_fixed(4);
    }

    fn serialize_f64(&mut self, v: f64) -> Result<(), SerializeError> {
        if self.implicit && v.to_bits() == 0 {
            return Result::Ok(());
        }
        return self.count_fixed(8);
    }

    fn serialize_bool(&mut self, v: bool) -> Result<(), SerializeError> {
        if self.implicit && !v {
            return Result::Ok(());
        }
        return self.count_varint(1);
    }

    fn serialize_char(&mut self, v: char) -> Result<(), SerializeError> {
        return Result::Err(unsupported("a char"));
    }

    fn serialize_string<S: AsStrSlice>(&mut self, v: S) -> Result<(), SerializeError> {
        return self.count_len(v.len());
    }

    fn serialize_bytes(&mut self, v: ByteSlice) -> Result<(), SerializeError> {
        return self.count_len(v.len());
    }

    fn is_human_readable(&self) -> bool {
        return false;
    }

    /// A field the wire leaves out. Protobuf has no null, and an absent field
    /// is what `Option::None` means.
    fn serialize_null(&mut self) -> Result<(), SerializeError> {
        return Result::Ok(());
    }

    /// Explicit presence: a zero an `Option` holds is written.
    fn serialize_some<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        let mut ser = SizeSerializer {
            state: self.state,
            number: self.number,
            encoding: self.encoding,
            implicit: false,
        };
        return value.serialize::<SizeSerializer>(&mut ser);
    }

    fn begin_seq(&mut self, len: i32) -> Result<SizeSeqSerializer, SerializeError> {
        return Result::Ok(SizeSeqSerializer { state: self.state, number: self.number, encoding: self.encoding });
    }

    fn begin_map(&mut self, len: i32) -> Result<UnsupportedMap, SerializeError> {
        return Result::Err(unsupported("a map"));
    }

    fn begin_struct<S: AsStrSlice>(&mut self, name: S, fields: i32) -> Result<SizeStructSerializer, SerializeError> {
        self.state.open_frame();
        return Result::Ok(SizeStructSerializer { state: self.state, number: self.number });
    }

    fn serialize_unit_variant<S: AsStrSlice, S1: AsStrSlice>(
        &mut self,
        type_name: S,
        variant_name: S1,
        disc: i32,
    ) -> Result<(), SerializeError> {
        if self.implicit && disc == 0 {
            return Result::Ok(());
        }
        return self.count_varint(disc as i64 as u64);
    }

    fn begin_variant<S: AsStrSlice, S1: AsStrSlice>(
        &mut self,
        type_name: S,
        variant_name: S1,
        disc: i32,
    ) -> Result<UnsupportedVariant, SerializeError> {
        return Result::Err(unsupported("a variant case with a payload"));
    }
}

struct WriteState {
    buf: ByteList,
    sizes: List<i32>,
    next: i32,
}

impl WriteState {
    /// The length the size pass promised for the submessage now opening.
    fn take_size(&mut self) -> i32 {
        let size = self.sizes[self.next];
        self.next += 1;
        return size;
    }
}

struct WriteSerializer {
    state: &mut WriteState,
    number: i32,
    encoding: WireEncoding,
    implicit: bool,
}

struct WriteSeqSerializer {
    state: &mut WriteState,
    number: i32,
    encoding: WireEncoding,
}

struct WriteStructSerializer {
    state: &mut WriteState,
    expected_end: i32,
}

impl WriteSerializer {
    fn write_varint_field(&mut self, payload: u64) -> Result<(), SerializeError> {
        write_tag(&mut self.state.buf, self.number, WireType::Varint);
        write_varint(&mut self.state.buf, payload);
        return Result::Ok(());
    }

    fn write_len_prefix(&mut self, payload: i32) {
        write_tag(&mut self.state.buf, self.number, WireType::Len);
        write_varint(&mut self.state.buf, payload as u64);
    }

    /// The same decision the size pass made, so the two agree on what is
    /// written.
    fn write_len_field(&mut self, payload: Slice<u8>) -> Result<(), SerializeError> {
        if self.implicit && payload.len() == 0 {
            return Result::Ok(());
        }
        self.write_len_prefix(payload.len());
        self.state.buf.extend_from_slice(payload);
        return Result::Ok(());
    }

    fn write_integer(&mut self, v: i64, width: i32) -> Result<(), SerializeError> {
        if self.implicit && v == 0 {
            return Result::Ok(());
        }
        match self.encoding {
            Plain => {
                return self.write_varint_field(v as u64);
            },
            ZigZag => {
                return self.write_varint_field(zigzag_64(v));
            },
            Fixed => {
                if width == 4 {
                    write_tag(&mut self.state.buf, self.number, WireType::Fixed32);
                    write_fixed32(&mut self.state.buf, v as u32);
                } else {
                    write_tag(&mut self.state.buf, self.number, WireType::Fixed64);
                    write_fixed64(&mut self.state.buf, v as u64);
                }
                return Result::Ok(());
            },
        }
    }
}

impl SerializeSeq for WriteSeqSerializer {
    fn element<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        let mut ser = WriteSerializer {
            state: self.state,
            number: self.number,
            encoding: self.encoding,
            implicit: false,
        };
        return value.serialize::<WriteSerializer>(&mut ser);
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
}

impl SerializeStruct for WriteStructSerializer {
    fn field<T: Serialize, S: AsStrSlice>(&mut self, name: S, value: &T) -> Result<(), SerializeError> {
        return Result::Err(unnumbered(name));
    }

    fn field_numbered<T: Serialize, S: AsStrSlice>(
        &mut self,
        number: i32,
        encoding: WireEncoding,
        implicit: bool,
        name: S,
        value: &T,
    ) -> Result<(), SerializeError> {
        // The size pass refused this already, so reaching it here is the two
        // passes disagreeing about the same declaration.
        assert is_field_number(number as i64);
        let mut ser = WriteSerializer { state: self.state, number, encoding, implicit };
        return value.serialize::<WriteSerializer>(&mut ser);
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        assert self.state.buf.len() == self.expected_end;
        return Result::Ok(());
    }
}

impl Serializer for WriteSerializer {
    type SeqSerializer = WriteSeqSerializer;
    type MapSerializer = UnsupportedMap;
    type StructSerializer = WriteStructSerializer;
    type VariantSerializer = UnsupportedVariant;

    fn serialize_i32(&mut self, v: i32) -> Result<(), SerializeError> {
        return self.write_integer(v as i64, 4);
    }

    fn serialize_i64(&mut self, v: i64) -> Result<(), SerializeError> {
        return self.write_integer(v, 8);
    }

    fn serialize_u32(&mut self, v: u32) -> Result<(), SerializeError> {
        return self.write_integer(v as i64, 4);
    }

    fn serialize_u64(&mut self, v: u64) -> Result<(), SerializeError> {
        return self.write_integer(v as i64, 8);
    }

    fn serialize_i128(&mut self, v: i128) -> Result<(), SerializeError> {
        return Result::Err(unsupported("an i128"));
    }

    fn serialize_u128(&mut self, v: u128) -> Result<(), SerializeError> {
        return Result::Err(unsupported("a u128"));
    }

    fn serialize_f32(&mut self, v: f32) -> Result<(), SerializeError> {
        if self.implicit && v.to_bits() == 0 {
            return Result::Ok(());
        }
        write_tag(&mut self.state.buf, self.number, WireType::Fixed32);
        write_fixed32(&mut self.state.buf, v.to_bits());
        return Result::Ok(());
    }

    fn serialize_f64(&mut self, v: f64) -> Result<(), SerializeError> {
        if self.implicit && v.to_bits() == 0 {
            return Result::Ok(());
        }
        write_tag(&mut self.state.buf, self.number, WireType::Fixed64);
        write_fixed64(&mut self.state.buf, v.to_bits());
        return Result::Ok(());
    }

    fn serialize_bool(&mut self, v: bool) -> Result<(), SerializeError> {
        if self.implicit && !v {
            return Result::Ok(());
        }
        return self.write_varint_field(if v { 1 } else { 0 });
    }

    fn serialize_char(&mut self, v: char) -> Result<(), SerializeError> {
        return Result::Err(unsupported("a char"));
    }

    fn serialize_string<S: AsStrSlice>(&mut self, v: S) -> Result<(), SerializeError> {
        return self.write_len_field(v.as_bytes() as Slice<u8>);
    }

    fn serialize_bytes(&mut self, v: ByteSlice) -> Result<(), SerializeError> {
        return self.write_len_field(v as Slice<u8>);
    }

    fn is_human_readable(&self) -> bool {
        return false;
    }

    fn serialize_null(&mut self) -> Result<(), SerializeError> {
        return Result::Ok(());
    }

    fn serialize_some<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        let mut ser = WriteSerializer {
            state: self.state,
            number: self.number,
            encoding: self.encoding,
            implicit: false,
        };
        return value.serialize::<WriteSerializer>(&mut ser);
    }

    fn begin_seq(&mut self, len: i32) -> Result<WriteSeqSerializer, SerializeError> {
        return Result::Ok(WriteSeqSerializer { state: self.state, number: self.number, encoding: self.encoding });
    }

    fn begin_map(&mut self, len: i32) -> Result<UnsupportedMap, SerializeError> {
        return Result::Err(unsupported("a map"));
    }

    fn begin_struct<S: AsStrSlice>(&mut self, name: S, fields: i32) -> Result<WriteStructSerializer, SerializeError> {
        let size = self.state.take_size();
        if self.number != NO_FIELD {
            self.write_len_prefix(size);
        }
        return Result::Ok(WriteStructSerializer {
            state: self.state,
            expected_end: self.state.buf.len() + size,
        });
    }

    fn serialize_unit_variant<S: AsStrSlice, S1: AsStrSlice>(
        &mut self,
        type_name: S,
        variant_name: S1,
        disc: i32,
    ) -> Result<(), SerializeError> {
        if self.implicit && disc == 0 {
            return Result::Ok(());
        }
        return self.write_varint_field(disc as i64 as u64);
    }

    fn begin_variant<S: AsStrSlice, S1: AsStrSlice>(
        &mut self,
        type_name: S,
        variant_name: S1,
        disc: i32,
    ) -> Result<UnsupportedVariant, SerializeError> {
        return Result::Err(unsupported("a variant case with a payload"));
    }
}

/// A message as protobuf bytes. Fields are written in declaration order, which
/// is deterministic here and is not a canonical form: protobuf defines none.
pub fn to_bytes<T: Serialize + WireNumbered>(value: &T) -> Result<ByteList, SerializeError> {
    let mut measured = SizeState { sizes: [], open: [] };
    let mut size_pass = SizeSerializer {
        state: &mut measured,
        number: NO_FIELD,
        encoding: WireEncoding::Plain,
        implicit: false,
    };
    value.serialize::<SizeSerializer>(&mut size_pass)?;
    assert measured.open.is_empty();

    let mut out = WriteState {
        buf: ByteList::with_capacity(measured.sizes[0]),
        sizes: measured.sizes,
        next: 0,
    };
    let mut write_pass = WriteSerializer {
        state: &mut out,
        number: NO_FIELD,
        encoding: WireEncoding::Plain,
        implicit: false,
    };
    value.serialize::<WriteSerializer>(&mut write_pass)?;
    assert out.next == out.sizes.len();
    return Result::Ok(out.buf);
}

fn undecodable<S: AsStrSlice>(what: S, offset: i32) -> DeserializeError {
    return DeserializeError::unexpected_type(`protobuf cannot decode ${what}`, offset as i64);
}

fn partial_element(offset: i32) -> DeserializeError {
    return DeserializeError::malformed("a packed run that is not whole elements", offset as i64);
}

/// The bytes, the region the current message ends at, and what the last tag
/// said follows it.
struct ProtobufReader {
    input: ByteSlice,
    pos: i32,
    end: i32,
    pending: Option<WireType>,
    /// End of the packed-repeated run being read, or `-1` outside one.
    packed_end: i32,
    /// Whether the run just entered holds no elements.
    packed_empty: bool,
    /// Whether the value being read is an element of a repeated field. A run
    /// reaching any other field is one value, not a sequence.
    in_seq: bool,
    number: i32,
    /// How the field being read spells an integer.
    encoding: WireEncoding,
    depth: i32,
    max_depth: i32,
}

impl ProtobufReader {
    /// Where a read must stop: the packed run being read, or the message.
    fn limit(&self) -> i32 {
        if self.packed_end >= 0 {
            return self.packed_end;
        }
        return self.end;
    }

    fn varint(&mut self) -> Result<u64, DeserializeError> {
        let Some([value, next]) = read_varint(&self.input, self.pos) else {
            return Result::Err(DeserializeError::malformed("truncated varint", self.pos as i64));
        };
        if next > self.limit() {
            return Result::Err(DeserializeError::malformed("varint runs past the message", self.pos as i64));
        }
        self.pos = next;
        return Result::Ok(value);
    }

    /// Where a length-delimited record ends, leaving `pos` at its first byte.
    fn read_len(&mut self) -> Result<i32, DeserializeError> {
        if !self.pending matches { Some(Len) } {
            return Result::Err(DeserializeError::unexpected_type(
                "a length-delimited field",
                self.pos as i64,
            ));
        }
        let at = self.pos;
        // The length is checked against what is left before it is narrowed: a
        // length near `u64::MAX` added to a position is not a position.
        let len = self.varint()?;
        assert self.pos <= self.end;
        if len > (self.end - self.pos) as u64 {
            return Result::Err(DeserializeError::malformed("length runs past the message", at as i64));
        }
        return Result::Ok(self.pos + len as i32);
    }

    fn read_region(&mut self) -> Result<[i32, i32], DeserializeError> {
        let stop = self.read_len()?;
        let start = self.pos;
        self.pos = stop;
        return Result::Ok([start, stop]);
    }

    /// What a scalar of `scalar` is read from: its own tag, or a packed `LEN`
    /// run this enters. `false` where the run holds no element and the field
    /// keeps its default.
    fn enter_packed(&mut self, scalar: WireType) -> Result<bool, DeserializeError> {
        if self.packed_end >= 0 {
            return Result::Ok(true);
        }
        // A tag naming neither the scalar's own wire type nor a packed run
        // says the bytes are not what this read would make of them.
        if self.pending matches { Some(t) && t == scalar } {
            return Result::Ok(true);
        }
        if !self.pending matches { Some(Len) } {
            return Result::Err(DeserializeError::unexpected_type(
                `a ${scalar} field`,
                self.pos as i64,
            ));
        }
        self.packed_end = self.read_len()?;
        if self.in_seq {
            if self.packed_end == self.pos {
                // Only this read knew the tag was a run at all, so the flag is
                // how `PbSeqAccess` learns there is nothing in it.
                self.packed_empty = true;
                return Result::Err(DeserializeError::eof(self.pos as i64));
            }
            return Result::Ok(true);
        }
        // The field is not repeated, so the run is one value: its last element.
        // That is the `repeated` to singular path the wire format allows.
        if self.packed_end == self.pos {
            self.leave_packed();
            return Result::Ok(false);
        }
        self.pos = self.last_packed(scalar)?;
        self.leave_packed();
        return Result::Ok(true);
    }

    /// Where the last element of the run being read starts. A run holds whole
    /// elements, and one that does not is malformed rather than a last element
    /// read from before the run or past it.
    fn last_packed(&self, scalar: WireType) -> Result<i32, DeserializeError> {
        if scalar matches { Varint } {
            let mut at = self.pos;
            let mut last = at;
            while at < self.packed_end {
                let Some([_, next]) = read_varint(&self.input, at) else {
                    return Result::Err(DeserializeError::eof(at as i64));
                };
                if next > self.packed_end {
                    return Result::Err(partial_element(at));
                }
                last = at;
                at = next;
            }
            return Result::Ok(last);
        }
        let width = scalar.element_width();
        if (self.packed_end - self.pos) % width != 0 {
            return Result::Err(partial_element(self.pos));
        }
        return Result::Ok(self.packed_end - width);
    }

    fn leave_packed(&mut self) {
        self.packed_end = -1;
        self.pending = null;
    }

    fn scalar_varint(&mut self) -> Result<u64, DeserializeError> {
        if !self.enter_packed(WireType::Varint)? {
            return Result::Ok(0);
        }
        return self.varint();
    }

    fn scalar_fixed32(&mut self) -> Result<u32, DeserializeError> {
        if !self.enter_packed(WireType::Fixed32)? {
            return Result::Ok(0);
        }
        let Some([value, next]) = read_fixed32(&self.input, self.pos) else {
            return Result::Err(DeserializeError::eof(self.pos as i64));
        };
        if next > self.limit() {
            return Result::Err(DeserializeError::malformed("fixed32 runs past the message", self.pos as i64));
        }
        self.pos = next;
        return Result::Ok(value);
    }

    /// An integer of `width` bytes, read as the field's encoding spells it.
    fn scalar_integer(&mut self, width: i32) -> Result<u64, DeserializeError> {
        return match self.encoding {
            Plain => self.scalar_varint(),
            ZigZag => Result::Ok(unzigzag_64(self.scalar_varint()?) as u64),
            Fixed => if width == 4 { Result::Ok(self.scalar_fixed32()? as u64) } else { self.scalar_fixed64() },
        };
    }

    fn scalar_fixed64(&mut self) -> Result<u64, DeserializeError> {
        if !self.enter_packed(WireType::Fixed64)? {
            return Result::Ok(0);
        }
        let Some([value, next]) = read_fixed64(&self.input, self.pos) else {
            return Result::Err(DeserializeError::eof(self.pos as i64));
        };
        if next > self.limit() {
            return Result::Err(DeserializeError::malformed("fixed64 runs past the message", self.pos as i64));
        }
        self.pos = next;
        return Result::Ok(value);
    }

    /// The next tag's field number and wire type, without consuming it.
    fn peek_tag(&mut self) -> Result<Option<[i32, WireType, i32]>, DeserializeError> {
        if self.pos >= self.end {
            return Result::Ok(null);
        }
        let at = self.pos;
        let tag = self.varint()?;
        let after = self.pos;
        self.pos = at;
        let Some(wire_type) = WireType::from_bits((tag & 7) as i32) else {
            return Result::Err(DeserializeError::malformed("unknown wire type", at as i64));
        };
        let number = (tag >> 3) as i64;
        if !is_field_number(number) {
            return Result::Err(DeserializeError::malformed("field number out of range", at as i64));
        }
        return Result::Ok(Option::Some([number as i32, wire_type, after]));
    }
}

pub struct ProtobufDeserializer {
    de: &mut ProtobufReader,
}

pub struct PbSeqAccess {
    de: &mut ProtobufReader,
    number: i32,
    first: bool,
}

pub struct PbStructAccess {
    de: &mut ProtobufReader,
    outer_end: i32,
    outer_depth: i32,
    outer_in_seq: bool,
}

pub struct PbMapAccess {
    de: &mut ProtobufReader,
}

pub struct PbVariantAccess {
    de: &mut ProtobufReader,
}

impl DeserializeSeq for PbSeqAccess {
    fn next_element<T: Deserialize>(&mut self) -> Result<Option<T>, DeserializeError> {
        if self.de.packed_end >= 0 {
            if self.de.pos >= self.de.packed_end {
                self.de.leave_packed();
                return Result::Ok(null);
            }
        } else if !self.first {
            // Unpacked: the run continues only while the next tag repeats this
            // field's number.
            let Some([number, wire_type, after]) = self.de.peek_tag()? else {
                return Result::Ok(null);
            };
            if number != self.number {
                return Result::Ok(null);
            }
            self.de.pos = after;
            self.de.pending = Option::Some(wire_type);
        }
        self.first = false;
        self.de.in_seq = true;
        let mut de = ProtobufDeserializer { de: self.de };
        let outcome = T::deserialize(&mut de);
        self.de.in_seq = false;
        let value = match outcome {
            Ok(value) => value,
            Err(e) => {
                if !self.de.packed_empty {
                    return Result::Err(e);
                }
                self.de.packed_empty = false;
                self.de.leave_packed();
                return Result::Ok(null);
            },
        };
        return Result::Ok(Option::Some(value));
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        return Result::Ok(());
    }
}

impl DeserializeMap for PbMapAccess {
    fn next_key_string(&mut self) -> Result<Option<String>, DeserializeError> {
        return Result::Err(undecodable("a map", self.de.pos));
    }

    fn next_value<V: Deserialize>(&mut self) -> Result<V, DeserializeError> {
        return Result::Err(undecodable("a map", self.de.pos));
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        return Result::Err(undecodable("a map", self.de.pos));
    }
}

impl DeserializeVariant for PbVariantAccess {
    fn variant_name(&mut self) -> Result<String, DeserializeError> {
        return Result::Err(undecodable("a variant case name", self.de.pos));
    }

    fn disc(&mut self) -> Result<i32, DeserializeError> {
        let raw = self.de.scalar_varint()?;
        return Result::Ok(raw as i64 as i32);
    }

    fn payload<T: Deserialize>(&mut self) -> Result<T, DeserializeError> {
        return Result::Err(undecodable("a variant case with a payload", self.de.pos));
    }

    fn is_unit(&mut self) -> Result<bool, DeserializeError> {
        return Result::Ok(true);
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        return Result::Ok(());
    }
}

/// The index a field number reaches, or `-1` for a number the type does not
/// declare, which the derived body then skips. `null` ends the message.
impl DeserializeStruct for PbStructAccess {
    fn next_field<S: FieldSchema>(&mut self) -> Result<Option<i32>, DeserializeError> {
        let Some([number, wire_type, after]) = self.de.peek_tag()? else {
            return Result::Ok(null);
        };
        self.de.pos = after;
        self.de.pending = Option::Some(wire_type);
        self.de.number = number;
        return Result::Ok(Option::Some(match S::by_number(number) {
            Some(index) => index,
            None => -1,
        }));
    }

    fn value<T: Deserialize>(&mut self) -> Result<T, DeserializeError> {
        return self.value_encoded(WireEncoding::Plain);
    }

    fn value_encoded<T: Deserialize>(&mut self, encoding: WireEncoding) -> Result<T, DeserializeError> {
        self.de.encoding = encoding;
        let mut de = ProtobufDeserializer { de: self.de };
        return T::deserialize(&mut de);
    }

    fn skip(&mut self) -> Result<(), DeserializeError> {
        match self.de.pending {
            Some(WireType::Varint) => {
                self.de.varint()?;
            },
            Some(WireType::Fixed32) => {
                self.de.scalar_fixed32()?;
            },
            Some(WireType::Fixed64) => {
                self.de.scalar_fixed64()?;
            },
            Some(WireType::Len) => {
                self.de.read_region()?;
            },
            None => {
                return Result::Err(DeserializeError::malformed("no field to skip", self.de.pos as i64));
            },
        }
        self.de.pending = null;
        return Result::Ok(());
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        if self.de.pos != self.de.end {
            return Result::Err(DeserializeError::trailing(self.de.pos as i64));
        }
        self.de.end = self.outer_end;
        self.de.depth = self.outer_depth;
        self.de.in_seq = self.outer_in_seq;
        self.de.pending = null;
        return Result::Ok(());
    }
}

impl Deserializer for ProtobufDeserializer {
    type SeqAccess = PbSeqAccess;
    type MapAccess = PbMapAccess;
    type StructAccess = PbStructAccess;
    type VariantAccess = PbVariantAccess;

    fn deserialize_i32(&mut self) -> Result<i32, DeserializeError> {
        let raw = self.de.scalar_integer(4)?;
        return Result::Ok(raw as i64 as i32);
    }

    fn deserialize_i64(&mut self) -> Result<i64, DeserializeError> {
        let raw = self.de.scalar_integer(8)?;
        return Result::Ok(raw as i64);
    }

    fn deserialize_u32(&mut self) -> Result<u32, DeserializeError> {
        let raw = self.de.scalar_integer(4)?;
        return Result::Ok(raw as u32);
    }

    fn deserialize_u64(&mut self) -> Result<u64, DeserializeError> {
        return self.de.scalar_integer(8);
    }

    fn deserialize_i128(&mut self) -> Result<i128, DeserializeError> {
        return Result::Err(undecodable("an i128", self.de.pos));
    }

    fn deserialize_u128(&mut self) -> Result<u128, DeserializeError> {
        return Result::Err(undecodable("a u128", self.de.pos));
    }

    fn deserialize_f32(&mut self) -> Result<f32, DeserializeError> {
        let raw = self.de.scalar_fixed32()?;
        return Result::Ok(f32::from_bits(raw));
    }

    fn deserialize_f64(&mut self) -> Result<f64, DeserializeError> {
        let raw = self.de.scalar_fixed64()?;
        return Result::Ok(f64::from_bits(raw));
    }

    fn deserialize_f16(&mut self) -> Result<f16, DeserializeError> {
        return Result::Ok(f16::from_f32(self.deserialize_f32()?));
    }

    fn deserialize_bf16(&mut self) -> Result<bf16, DeserializeError> {
        return Result::Ok(bf16::from_f32(self.deserialize_f32()?));
    }

    fn deserialize_bool(&mut self) -> Result<bool, DeserializeError> {
        let raw = self.de.scalar_varint()?;
        return Result::Ok(raw != 0);
    }

    fn deserialize_char(&mut self) -> Result<char, DeserializeError> {
        return Result::Err(undecodable("a char", self.de.pos));
    }

    fn deserialize_string(&mut self) -> Result<String, DeserializeError> {
        let at = self.de.pos;
        let [start, stop] = self.de.read_region()?;
        let mut out = String::with_capacity(stop - start);
        if let Err(_) = out.push_utf8(&self.de.input.slice(start, stop)) {
            return Result::Err(DeserializeError::invalid_value("a string field is not UTF-8", at as i64));
        }
        return Result::Ok(out);
    }

    fn deserialize_bytes(&mut self) -> Result<ByteList, DeserializeError> {
        let [start, stop] = self.de.read_region()?;
        let mut out = ByteList::with_capacity(stop - start);
        out.extend_from_slice(self.de.input.slice(start, stop) as Slice<u8>);
        return Result::Ok(out);
    }

    /// Protobuf has no null. A field the wire left out never reaches here, so
    /// what does reach it is present.
    fn is_null(&mut self) -> Result<bool, DeserializeError> {
        return Result::Ok(false);
    }

    /// The last occurrence of a non-repeated field wins, which is what the
    /// specification says a reader must do.
    fn on_duplicate_key(&self) -> DuplicateKeyPolicy {
        return DuplicateKeyPolicy::PassThru;
    }

    fn begin_seq(&mut self) -> Result<PbSeqAccess, DeserializeError> {
        return Result::Ok(PbSeqAccess {
            de: self.de,
            number: self.de.number,
            first: true,
        });
    }

    fn begin_map(&mut self) -> Result<PbMapAccess, DeserializeError> {
        return Result::Err(undecodable("a map", self.de.pos));
    }

    fn begin_struct<S: AsStrSlice>(&mut self, name: S, num_fields: i32) -> Result<PbStructAccess, DeserializeError> {
        let outer_end = self.de.end;
        let outer_depth = self.de.depth;
        // A message reached as an element is still a message: its own fields
        // are repeated or not on their own declaration.
        let outer_in_seq = self.de.in_seq;
        self.de.in_seq = false;
        if self.de.pending matches { Some(_) } {
            self.de.end = self.de.read_len()?;
            self.de.depth = deeper(self.de.depth, self.de.max_depth, self.de.pos as i64)?;
        }
        self.de.pending = null;
        return Result::Ok(PbStructAccess {
            de: self.de,
            outer_end,
            outer_depth,
            outer_in_seq,
        });
    }

    fn begin_variant<S: AsStrSlice>(
        &mut self,
        type_name: S,
        num_cases: i32,
    ) -> Result<PbVariantAccess, DeserializeError> {
        return Result::Ok(PbVariantAccess { de: self.de });
    }

    fn deserialize_any<V: Visitor>(&mut self, visitor: &mut V) -> Result<V::Value, DeserializeError> {
        return Result::Err(undecodable("a value of unknown type", self.de.pos));
    }
}

/// A message from protobuf bytes. A field the type does not declare is
/// skipped, and its bytes are not kept.
pub fn from_bytes<T: Deserialize + WireNumbered, S: AsByteSlice>(
    input: S,
    max_depth: i32 = DEFAULT_MAX_DEPTH,
) -> Result<T, DeserializeError> {
    let bytes = input.as_byte_slice();
    let mut reader = ProtobufReader {
        input: bytes,
        pos: 0,
        end: bytes.len(),
        pending: null,
        packed_end: -1,
        packed_empty: false,
        in_seq: false,
        number: 0,
        encoding: WireEncoding::Plain,
        depth: 0,
        max_depth,
    };
    let mut de = ProtobufDeserializer { de: &mut reader };
    return T::deserialize(&mut de);
}
