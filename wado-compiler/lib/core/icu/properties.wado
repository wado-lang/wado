/// A property, or a value of one, named at run time: what a `\p{...}` in a
/// grammar names. It parses from a binary property's name (`White_Space`) or
/// from `property=value` (`sc=Latin`), as `FromStr` or `LenientFromStr` match
/// names.
pub variant Property {
    BinaryProperty(BinaryProperty),
    GeneralCategoryGroup(GeneralCategoryGroup),
    BidiClass(BidiClass),
    CanonicalCombiningClass(CanonicalCombiningClass),
    EastAsianWidth(EastAsianWidth),
    GraphemeClusterBreak(GraphemeClusterBreak),
    HangulSyllableType(HangulSyllableType),
    IndicConjunctBreak(IndicConjunctBreak),
    IndicSyllabicCategory(IndicSyllabicCategory),
    JoiningGroup(JoiningGroup),
    JoiningType(JoiningType),
    LineBreak(LineBreak),
    NumericType(NumericType),
    Script(Script),
    SentenceBreak(SentenceBreak),
    VerticalOrientation(VerticalOrientation),
    WordBreak(WordBreak),
}

impl CodePointSet for Property {
    fn ranges(&self) -> List<[u32, u32]> {
        return match *self {
            BinaryProperty(p) => p.ranges(),
            GeneralCategoryGroup(p) => p.ranges(),
            BidiClass(p) => p.ranges(),
            CanonicalCombiningClass(p) => p.ranges(),
            EastAsianWidth(p) => p.ranges(),
            GraphemeClusterBreak(p) => p.ranges(),
            HangulSyllableType(p) => p.ranges(),
            IndicConjunctBreak(p) => p.ranges(),
            IndicSyllabicCategory(p) => p.ranges(),
            JoiningGroup(p) => p.ranges(),
            JoiningType(p) => p.ranges(),
            LineBreak(p) => p.ranges(),
            NumericType(p) => p.ranges(),
            Script(p) => p.ranges(),
            SentenceBreak(p) => p.ranges(),
            VerticalOrientation(p) => p.ranges(),
            WordBreak(p) => p.ranges(),
        };
    }

    fn contains(&self, ch: char) -> bool {
        return match *self {
            BinaryProperty(p) => p.contains(ch),
            GeneralCategoryGroup(p) => p.contains(ch),
            BidiClass(p) => p.contains(ch),
            CanonicalCombiningClass(p) => p.contains(ch),
            EastAsianWidth(p) => p.contains(ch),
            GraphemeClusterBreak(p) => p.contains(ch),
            HangulSyllableType(p) => p.contains(ch),
            IndicConjunctBreak(p) => p.contains(ch),
            IndicSyllabicCategory(p) => p.contains(ch),
            JoiningGroup(p) => p.contains(ch),
            JoiningType(p) => p.contains(ch),
            LineBreak(p) => p.contains(ch),
            NumericType(p) => p.contains(ch),
            Script(p) => p.contains(ch),
            SentenceBreak(p) => p.contains(ch),
            VerticalOrientation(p) => p.contains(ch),
            WordBreak(p) => p.contains(ch),
        };
    }
}

impl FromStr for Property {
    type Err = PropertyNameError;

    fn from_str<S: AsStrSlice>(s: S) -> Result<Property, PropertyNameError> {
        let text = s.to_string();
        let Some([name, value]) = text.split_once("=") else {
            return Ok(Property::BinaryProperty(BinaryProperty::from_str(&text)?));
        };
        return match name {
            "General_Category" | "gc" => Ok(Property::GeneralCategoryGroup(GeneralCategoryGroup::from_str(value)?)),
            "Bidi_Class" | "bc" => Ok(Property::BidiClass(BidiClass::from_str(value)?)),
            "Canonical_Combining_Class" | "ccc" => Ok(Property::CanonicalCombiningClass(
                CanonicalCombiningClass::from_str(value)?,
            )),
            "East_Asian_Width" | "ea" => Ok(Property::EastAsianWidth(EastAsianWidth::from_str(value)?)),
            "Grapheme_Cluster_Break" | "GCB" => Ok(Property::GraphemeClusterBreak(
                GraphemeClusterBreak::from_str(value)?,
            )),
            "Hangul_Syllable_Type" | "hst" => Ok(Property::HangulSyllableType(HangulSyllableType::from_str(value)?)),
            "Indic_Conjunct_Break" | "InCB" => Ok(Property::IndicConjunctBreak(IndicConjunctBreak::from_str(value)?)),
            "Indic_Syllabic_Category" | "InSC" => Ok(Property::IndicSyllabicCategory(IndicSyllabicCategory::from_str(
                value,
            )?)),
            "Joining_Group" | "jg" => Ok(Property::JoiningGroup(JoiningGroup::from_str(value)?)),
            "Joining_Type" | "jt" => Ok(Property::JoiningType(JoiningType::from_str(value)?)),
            "Line_Break" | "lb" => Ok(Property::LineBreak(LineBreak::from_str(value)?)),
            "Numeric_Type" | "nt" => Ok(Property::NumericType(NumericType::from_str(value)?)),
            "Script" | "sc" => Ok(Property::Script(Script::from_str(value)?)),
            "Sentence_Break" | "SB" => Ok(Property::SentenceBreak(SentenceBreak::from_str(value)?)),
            "Vertical_Orientation" | "vo" => Ok(Property::VerticalOrientation(VerticalOrientation::from_str(value)?)),
            "Word_Break" | "WB" => Ok(Property::WordBreak(WordBreak::from_str(value)?)),
            _ => Err(refused(text, "a property=value pair")),
        };
    }
}

impl LenientFromStr for Property {
    type Err = PropertyNameError;

    fn from_str_lenient<S: AsStrSlice>(s: S) -> Result<Property, PropertyNameError> {
        let text = s.to_string();
        let Some([name, value]) = text.split_once("=") else {
            return Ok(Property::BinaryProperty(BinaryProperty::from_str_lenient(&text)?));
        };
        return match fold(name) {
            "gc" | "generalcategory" => Ok(Property::GeneralCategoryGroup(
                GeneralCategoryGroup::from_str_lenient(value)?,
            )),
            "bc" | "bidiclass" => Ok(Property::BidiClass(BidiClass::from_str_lenient(value)?)),
            "canonicalcombiningclass" | "ccc" => Ok(Property::CanonicalCombiningClass(
                CanonicalCombiningClass::from_str_lenient(value)?,
            )),
            "ea" | "eastasianwidth" => Ok(Property::EastAsianWidth(EastAsianWidth::from_str_lenient(value)?)),
            "gcb" | "graphemeclusterbreak" => Ok(Property::GraphemeClusterBreak(GraphemeClusterBreak::from_str_lenient(
                value,
            )?)),
            "hangulsyllabletype" | "hst" => Ok(Property::HangulSyllableType(
                HangulSyllableType::from_str_lenient(value)?,
            )),
            "incb" | "indicconjunctbreak" => Ok(Property::IndicConjunctBreak(
                IndicConjunctBreak::from_str_lenient(value)?,
            )),
            "indicsyllabiccategory" | "insc" => Ok(Property::IndicSyllabicCategory(
                IndicSyllabicCategory::from_str_lenient(value)?,
            )),
            "jg" | "joininggroup" => Ok(Property::JoiningGroup(JoiningGroup::from_str_lenient(value)?)),
            "joiningtype" | "jt" => Ok(Property::JoiningType(JoiningType::from_str_lenient(value)?)),
            "lb" | "linebreak" => Ok(Property::LineBreak(LineBreak::from_str_lenient(value)?)),
            "nt" | "numerictype" => Ok(Property::NumericType(NumericType::from_str_lenient(value)?)),
            "sc" | "script" => Ok(Property::Script(Script::from_str_lenient(value)?)),
            "sb" | "sentencebreak" => Ok(Property::SentenceBreak(SentenceBreak::from_str_lenient(value)?)),
            "verticalorientation" | "vo" => Ok(Property::VerticalOrientation(VerticalOrientation::from_str_lenient(
                value,
            )?)),
            "wb" | "wordbreak" => Ok(Property::WordBreak(WordBreak::from_str_lenient(value)?)),
            _ => Err(refused(text, "a property=value pair")),
        };
    }
}
