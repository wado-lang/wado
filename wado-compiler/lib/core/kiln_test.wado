use { Diagnostic, Error, KilnHost, KilnLogSink, package_of, read_all, read_text } from "core:kiln";
use { Event, Level, Log, Metadata, error, warn } from "core:log";

test "package_of keeps the package and drops a version or a file path" {
    assert package_of(&"lib:grog") == Option::Some("lib:grog");
    assert package_of(&"wado-lang:loam@0.1") == Option::Some("wado-lang:loam");
    assert package_of(&"lib:gale/src/generator.wado") == Option::Some("lib:gale");
    assert package_of(&"../package-grog") == null;
}

test "Error renders its reason" {
    assert `${Error::InvalidSchema("bad token")}` == "invalid schema: bad token";
    assert `${Error::Unsupported("streaming input")}` == "unsupported: streaming input";
    assert `${Error::Other("boom")}` == "boom";
}

/// A Kiln host that keeps what the generator reports.
struct RecordingHost {
    diagnostics: List<Diagnostic> = [],
}

impl KilnHost for RecordingHost {
    fn emit_diagnostic(&mut self, diagnostic: Diagnostic) {
        self.diagnostics.push(diagnostic);
        resume ();
    }
}

fn event_at(level: Level, message: String) -> Event {
    return Event {
        meta: Metadata { level, target: "gen", file: "gen.wado", line: 1 },
        message,
    };
}

// `wado test` builds at `log.level=warn`, so an `info` or `debug` call stops at
// the facade; those levels reach the sink as `Log` operations instead.

test "KilnLogSink takes info and above" {
    let mut taken: List<bool> = [];
    with Log => &mut KilnLogSink {} do {
        for let level of [Level::Trace, Level::Debug, Level::Info, Level::Warn, Level::Error] as List<Level> {
            taken.push(Log::enabled(level));
        }
    };
    assert taken == [false, false, true, true, true];
}

test "KilnLogSink reports info as info, and a warning or an error as a warning" {
    let mut host = RecordingHost {};
    with KilnHost => &mut host, Log => &mut KilnLogSink {} do {
        Log::event(event_at(Level::Debug, "noisy"));
        Log::event(event_at(Level::Info, "generating"));
        warn("careful", { path: "a.schema" });
        error("broken");
    };
    assert host.diagnostics.len() == 3;
    assert host.diagnostics[0].level matches { Info };
    assert host.diagnostics[0].message == "gen: generating";
    assert host.diagnostics[1].level matches { Warning };
    assert host.diagnostics[1].message.ends_with(": careful path=a.schema");
    assert host.diagnostics[2].level matches { Warning };
    assert host.diagnostics[2].message.ends_with(": broken");
}

/// An input stream that hands over its chunks one read at a time, the last
/// with the writer's drop.
struct ScriptedInput {
    chunks: List<List<u8>>,
    at: i32 = 0,
    dropped: bool = false,
}

impl Stream<u8> for ScriptedInput {
    fn read(&mut self, this: &Stream<u8>, max: i32) -> StreamChunk<u8> {
        let items = self.chunks[self.at];
        self.at += 1;
        let result = if self.at == self.chunks.len() { CopyResult::Dropped } else { CopyResult::Completed };
        resume StreamChunk { items, result };
    }

    fn drop(&mut self, this: &Stream<u8>) {
        self.dropped = true;
        resume ();
    }

    ..trap
}

/// A real handle for the scripted reads to answer, made outside the
/// handler's `with`, which traps on `new`.
fn scripted_stream() -> Stream<u8> {
    let [rx, tx] = Stream::<u8>::new();
    tx.drop();
    return rx;
}

test "read_all drains every chunk and drops the stream" {
    let mut input = ScriptedInput {
        chunks: [
            [1, 2],
            [],
            [3],
        ],
    };
    let stream = scripted_stream();
    with &mut input do {
        assert read_all(stream) == [1, 2, 3] as ByteList;
    };
    assert input.dropped;
}

test "read_text decodes a character split across chunks" {
    // U+00E9 is 0xC3 0xA9.
    let mut input = ScriptedInput {
        chunks: [
            [0x61, 0xc3],
            [0xa9, 0x62],
        ],
    };
    let stream = scripted_stream();
    with &mut input do {
        assert read_text(stream) == Result::Ok("a\u{e9}b");
    };
    assert input.dropped;
}

test "read_text reports where the text stops being UTF-8" {
    let mut input = ScriptedInput {
        chunks: [
            [0x61, 0x62],
            [0x63, 0xff],
        ],
    };
    let stream = scripted_stream();
    with &mut input do {
        assert read_text(stream) == Result::Err(Utf8Error::invalid(3, 1));
    };
    input = ScriptedInput {
        chunks: [
            [0x61, 0xc3],
        ],
    };
    let truncated = scripted_stream();
    with &mut input do {
        assert read_text(truncated) == Result::Err(Utf8Error::incomplete(1));
    };
}
