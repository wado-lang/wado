//! Tests for the `core:prelude` byte-buffer newtypes and `AsByteSlice`.

test "ByteList literal coercion and as_byte_slice view" {
    let b: ByteList = [1, 2, 3];
    assert b.len() == 3;
    let s = b.as_byte_slice();
    assert s.len() == 3;
    assert s[0] == 1;
    assert s[2] == 3;
}

test "ByteList to_hex renders lowercase hex" {
    let b: ByteList = [0x00, 0x0f, 0xa0, 0xff];
    assert b.to_hex() == "000fa0ff";
    let empty: ByteList = [];
    assert empty.to_hex() == "";
}

test "ByteSlice as_byte_slice is identity" {
    let b: ByteList = [10, 20, 30, 40];
    let s = b.as_byte_slice();
    let s2 = s.as_byte_slice();
    assert s2.len() == 4;
    assert s2[1] == 20;
    assert s2[3] == 40;
}

test "ByteArray construction, mutation, and as_byte_slice view" {
    let tmp: Array<u8> = Array::filled(3, 0);
    let mut a: ByteArray = tmp as ByteArray;
    a.set(0, 7);
    a.set(2, 9);
    assert a.len() == 3;
    assert a[0] == 7;
    let s = a.as_byte_slice();
    assert s.len() == 3;
    assert s[0] == 7;
    assert s[2] == 9;
}

test "Array range indexing yields a slice" {
    let a: Array<i32> = Array::filled(5, 7);
    let s = a[1..<4];
    assert s.len() == 3;
    assert s[0] == 7;
    let s2 = a[1..=3];
    assert s2.len() == 3;
}

test "ByteList inherits List<u8> mutation" {
    let mut b: ByteList = [];
    b.push(1);
    b.push(2);
    assert b.len() == 2;
    assert b[0] == 1;
    assert b.as_byte_slice().len() == 2;
}

test "ByteList get_byte_unchecked reads raw bytes" {
    let b: ByteList = [5, 6, 7];
    assert b.get_byte_unchecked(0) == 5;
    assert b.get_byte_unchecked(2) == 7;
}

test "ByteSlice get_unchecked respects the view offset" {
    let b: ByteList = [10, 20, 30, 40, 50];
    let s = b.as_byte_slice().slice(1, 4);
    assert s.len() == 3;
    assert s.get_unchecked(0) == 20;
    assert s.get_unchecked(1) == 30;
    assert s.get_unchecked(2) == 40;
}

test "eq_constant_time compares byte buffers" {
    let a: ByteList = [1, 2, 3];
    let b: ByteList = [1, 2, 3];
    let differs_last: ByteList = [1, 2, 4];
    let differs_first: ByteList = [9, 2, 3];
    let shorter: ByteList = [1, 2];
    assert eq_constant_time(&a, &b);
    assert !eq_constant_time(&a, &differs_last);
    assert !eq_constant_time(&a, &differs_first);
    assert !eq_constant_time(&a, &shorter);
    let empty: ByteList = [];
    assert eq_constant_time(&empty, &empty);
}

test "eq_constant_time spans the AsByteSlice family" {
    let list: ByteList = b"opensesame";
    let slice = list.as_byte_slice();
    assert eq_constant_time(&list, &slice);
    // An API key is a String, and compares the same way.
    assert eq_constant_time(&"opensesame", &list);
    assert eq_constant_time(&"opensesame", &"opensesame");
    assert !eq_constant_time(&"opensesame", &"opensesamf");
}
