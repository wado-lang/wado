#![stdlib("core:base64")]
//! Base64 encoding and decoding (RFC 4648).

// Base64 encoding/decoding module for Wado.
//
// Implements RFC 4648 Base64 encoding with:
//   - Standard alphabet (+/) and URL-safe alphabet (-_)
//   - Configurable padding via Encoding flags
//   - Lenient decode: accepts both alphabets and with/without padding
//
// All entry points accept any byte source via `AsByteSlice` (a `ByteList`,
// `ByteArray`, `ByteSlice`, `List<u8>`, or a `String`'s UTF-8 bytes).
//
// Usage:
//   use { encode, decode, encode_url, encode_with, Encoding } from "core:base64";
//
//   let data: ByteList = [72, 101, 108, 108, 111];
//   let b64 = encode(&data);           // "SGVsbG8="
//   let url = encode_url(&data);       // "SGVsbG8"
//   if let Some(decoded) = decode(&b64) { ... }


pub flags Encoding {
    UrlSafe,
    NoPadding,
}

global STANDARD_TABLE: List<u8> = [
    'A' as u8, 'B' as u8, 'C' as u8, 'D' as u8, 'E' as u8, 'F' as u8, 'G' as u8, 'H' as u8, 'I' as u8, 'J' as u8,
    'K' as u8, 'L' as u8, 'M' as u8, 'N' as u8, 'O' as u8, 'P' as u8, 'Q' as u8, 'R' as u8, 'S' as u8, 'T' as u8,
    'U' as u8, 'V' as u8, 'W' as u8, 'X' as u8, 'Y' as u8, 'Z' as u8, 'a' as u8, 'b' as u8, 'c' as u8, 'd' as u8,
    'e' as u8, 'f' as u8, 'g' as u8, 'h' as u8, 'i' as u8, 'j' as u8, 'k' as u8, 'l' as u8, 'm' as u8, 'n' as u8,
    'o' as u8, 'p' as u8, 'q' as u8, 'r' as u8, 's' as u8, 't' as u8, 'u' as u8, 'v' as u8, 'w' as u8, 'x' as u8,
    'y' as u8, 'z' as u8, '0' as u8, '1' as u8, '2' as u8, '3' as u8, '4' as u8, '5' as u8, '6' as u8, '7' as u8,
    '8' as u8, '9' as u8, '+' as u8, '/' as u8,
];

global URL_SAFE_TABLE: List<u8> = [
    'A' as u8, 'B' as u8, 'C' as u8, 'D' as u8, 'E' as u8, 'F' as u8, 'G' as u8, 'H' as u8, 'I' as u8, 'J' as u8,
    'K' as u8, 'L' as u8, 'M' as u8, 'N' as u8, 'O' as u8, 'P' as u8, 'Q' as u8, 'R' as u8, 'S' as u8, 'T' as u8,
    'U' as u8, 'V' as u8, 'W' as u8, 'X' as u8, 'Y' as u8, 'Z' as u8, 'a' as u8, 'b' as u8, 'c' as u8, 'd' as u8,
    'e' as u8, 'f' as u8, 'g' as u8, 'h' as u8, 'i' as u8, 'j' as u8, 'k' as u8, 'l' as u8, 'm' as u8, 'n' as u8,
    'o' as u8, 'p' as u8, 'q' as u8, 'r' as u8, 's' as u8, 't' as u8, 'u' as u8, 'v' as u8, 'w' as u8, 'x' as u8,
    'y' as u8, 'z' as u8, '0' as u8, '1' as u8, '2' as u8, '3' as u8, '4' as u8, '5' as u8, '6' as u8, '7' as u8,
    '8' as u8, '9' as u8, '-' as u8, '_' as u8,
];

fn build_decode_table() -> List<u8> {
    let mut table: List<u8> = List::filled(256, 255);

    for let mut i = 0; i < 26; i += 1 {
        table['A' as i32 + i] = i as u8;
    }
    for let mut i = 0; i < 26; i += 1 {
        table['a' as i32 + i] = (26 + i) as u8;
    }
    for let mut i = 0; i < 10; i += 1 {
        table['0' as i32 + i] = (52 + i) as u8;
    }
    table['+' as i32] = 62;
    table['/' as i32] = 63;
    table['-' as i32] = 62;
    table['_' as i32] = 63;
    table['=' as i32] = 254;

    return table;
}

global DECODE_TABLE: List<u8> = build_decode_table();

fn encode_impl(data: ByteSlice, table: &List<u8>, pad: bool) -> String {
    let len = data.len();
    if len == 0 {
        return "";
    }

    let remainder = len % 3;
    let mut out = String::with_capacity((len + 2) / 3 * 4);

    let mut i = 0;
    while i + 2 < len {
        let b0 = data[i] as i32;
        let b1 = data[i + 1] as i32;
        let b2 = data[i + 2] as i32;
        out.push(table[b0 >> 2 & 63] as char);
        out.push(table[(b0 << 4 | b1 >> 4) & 63] as char);
        out.push(table[(b1 << 2 | b2 >> 6) & 63] as char);
        out.push(table[b2 & 63] as char);
        i += 3;
    }

    if remainder == 1 {
        let b0 = data[i] as i32;
        out.push(table[b0 >> 2 & 63] as char);
        out.push(table[b0 << 4 & 63] as char);
        if pad {
            out.push_str(&"==");
        }
    } else if remainder == 2 {
        let b0 = data[i] as i32;
        let b1 = data[i + 1] as i32;
        out.push(table[b0 >> 2 & 63] as char);
        out.push(table[(b0 << 4 | b1 >> 4) & 63] as char);
        out.push(table[b1 << 2 & 63] as char);
        if pad {
            out.push('=');
        }
    }

    return out;
}

/// Encodes bytes as standard Base64 (RFC 4648 §4, padded).
#[inline]
pub fn encode<S: AsByteSlice>(data: &S) -> String {
    return encode_impl(data.as_byte_slice(), &STANDARD_TABLE, true);
}

/// Encodes bytes as URL-safe Base64 (RFC 4648 §5, no padding).
/// Equivalent to `encode_with(data, Encoding::UrlSafe | Encoding::NoPadding)`.
#[inline]
pub fn encode_url<S: AsByteSlice>(data: &S) -> String {
    return encode_impl(data.as_byte_slice(), &URL_SAFE_TABLE, false);
}

/// Encodes bytes as Base64 with custom flags.
pub fn encode_with<S: AsByteSlice>(data: &S, encoding: Encoding) -> String {
    let url_safe = (encoding & Encoding::UrlSafe) as u32 != 0;
    let no_padding = (encoding & Encoding::NoPadding) as u32 != 0;
    if url_safe {
        return encode_impl(data.as_byte_slice(), &URL_SAFE_TABLE, !no_padding);
    }
    return encode_impl(data.as_byte_slice(), &STANDARD_TABLE, !no_padding);
}

fn decode_impl(input: ByteSlice) -> Option<ByteList> {
    let mut end = input.len();
    while end > 0 && input[end - 1] == '=' as u8 {
        end -= 1;
    }

    if end % 4 == 1 {
        return null;
    }

    let full_groups = end / 4;
    let remainder = end % 4;
    let mut out_len = full_groups * 3;
    if remainder == 2 {
        out_len = out_len + 1;
    } else if remainder == 3 {
        out_len = out_len + 2;
    }

    let mut out: List<u8> = List::with_capacity(out_len);
    let table = &DECODE_TABLE;

    let mut i = 0;
    while i + 3 < end {
        let v0 = table[input[i] as i32] as i32;
        let v1 = table[input[i + 1] as i32] as i32;
        let v2 = table[input[i + 2] as i32] as i32;
        let v3 = table[input[i + 3] as i32] as i32;

        if v0 >= 254 || v1 >= 254 || v2 >= 254 || v3 >= 254 {
            return null;
        }

        out.push((v0 << 2 | v1 >> 4) as u8);
        out.push(((v1 & 15) << 4 | v2 >> 2) as u8);
        out.push(((v2 & 3) << 6 | v3) as u8);
        i += 4;
    }

    if remainder == 2 {
        let v0 = table[input[i] as i32] as i32;
        let v1 = table[input[i + 1] as i32] as i32;
        if v0 >= 254 || v1 >= 254 {
            return null;
        }
        out.push((v0 << 2 | v1 >> 4) as u8);
    } else if remainder == 3 {
        let v0 = table[input[i] as i32] as i32;
        let v1 = table[input[i + 1] as i32] as i32;
        let v2 = table[input[i + 2] as i32] as i32;
        if v0 >= 254 || v1 >= 254 || v2 >= 254 {
            return null;
        }
        out.push((v0 << 2 | v1 >> 4) as u8);
        out.push(((v1 & 15) << 4 | v2 >> 2) as u8);
    }

    return Option::Some(out as ByteList);
}

/// Decodes Base64 from text or raw bytes (e.g., HTTP body, file content).
/// Accepts both standard (+/) and URL-safe (-_) alphabets, with or without padding.
/// Returns null on invalid input.
#[inline]
pub fn decode<S: AsByteSlice>(encoded: &S) -> Option<ByteList> {
    return decode_impl(encoded.as_byte_slice());
}
