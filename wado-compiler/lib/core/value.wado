#![stdlib("core:value")]
//! Dynamically-typed, format-agnostic value type.
//!
//! `Value` represents any value the serde data model can carry, shared by
//! every self-describing format (`core:json`, `core:cbor`). It implements
//! `Serialize` and `Deserialize`, so it round-trips through `from_bytes` /
//! `to_bytes` with no per-type work.
//!
//! It is a general dynamic value, so it deliberately contains no
//! format-specific concepts (no CBOR `Tag`, no `Simple`): a single opaque
//! escape hatch, `Unknown`, carries the raw encoded bytes of anything the
//! model cannot represent. `Bytes` (a semantic byte-string value) and
//! `Unknown` (raw, format-specific encoded bytes) are distinct and must not
//! be conflated.
//!
//! Usage:
//!   use { Value } from "core:value";
//!   use { from_bytes, to_bytes } from "core:json";
//!
//!   let v: Value = from_bytes(`{"x": 1, "y": [true, null]}`)?;
//!   let s = to_bytes::<Value>(&v)?;


use {
    Serialize,
    Deserialize,
    Serializer,
    Deserializer,
    DeserializeSeq,
    DeserializeMap,
    SerializeError,
    SerializeErrorKind,
    DeserializeError,
    Visitor,
} from "core:serde";

use { TreeMap } from "core:collections";

/// A dynamically-typed, format-agnostic value.
///
/// JSON only ever produces `Null` / `Bool` / `Float` / `String` / `List` /
/// `Object` (it has no integer/float distinction and no byte strings); the
/// remaining arms are produced by binary formats such as CBOR.
pub variant Value {
    Null,
    Bool(bool),
    Int(i64),
    UInt(u64),
    Int128(i128),
    UInt128(u128),
    Float(f64),                      // binary16/32/64 all widened to f64
    String(String),
    Bytes(ByteList),                 // a byte-string *value*
    List(List<Value>),
    Object(TreeMap<String, Value>),  // string keys only, insertion order preserved
    Undefined,                       // CBOR simple 23; also present in JS/MsgPack data
    Unknown(ByteList),               // raw encoded bytes of an unrepresentable item
}

impl Eq for Value {
    fn eq(&self, other: &Value) -> bool {
        return match [*self, *other] {
            [Null, Null] => true,
            [Bool(a), Bool(b)] => a == b,
            [Int(a), Int(b)] => a == b,
            [UInt(a), UInt(b)] => a == b,
            [Int128(a), Int128(b)] => a == b,
            [UInt128(a), UInt128(b)] => a == b,
            [Float(a), Float(b)] => a == b,
            [String(a), String(b)] => a == b,
            [Bytes(a), Bytes(b)] => a == b,
            [List(a), List(b)] => {
                if a.len() != b.len() {
                    return false;
                }
                let mut i = 0;
                while i < a.len() {
                    if !(a[i] == b[i]) {
                        return false;
                    }
                    i += 1;
                }
                true;
            },
            [Object(a), Object(b)] => {
                if a.len() != b.len() {
                    return false;
                }
                for let [k, v] of a.entries() {
                    if let Some(other_v) = b.get(k) {
                        if !(v == other_v) {
                            return false;
                        }
                    } else {
                        return false;
                    }
                }
                true;
            },
            [Undefined, Undefined] => true,
            [Unknown(a), Unknown(b)] => a == b,
            _ => false,
        };
    }
}

impl Serialize for Value {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return match self {
            Null => s.serialize_null(),
            Bool(b) => s.serialize_bool(*b),
            Int(n) => s.serialize_i64(*n),
            UInt(n) => s.serialize_u64(*n),
            Int128(n) => s.serialize_i128(*n),
            UInt128(n) => s.serialize_u128(*n),
            Float(n) => s.serialize_f64(*n),
            String(str_val) => s.serialize_string(str_val),
            Bytes(bytes) => s.serialize_bytes(bytes.as_byte_slice()),
            List(arr) => {
                let seq = s.begin_seq(arr.len())?;
                for let item of arr {
                    seq.element(item)?;
                }
                seq.end();
            },
            Object(map) => {
                let m = s.begin_map(map.len())?;
                for let [key, val] of map.entries() {
                    m.key(&key)?;
                    m.value(&val)?;
                }
                m.end();
            },
            // `Undefined` has no serde data-model entry, and `Unknown` holds
            // raw format-specific bytes that only the originating format can
            // splice back. Neither is expressible through the generic
            // `Serializer`, so serialization errors by default (RFC 8949 §6).
            Undefined => Result::Err(SerializeError {
                kind: SerializeErrorKind::UnsupportedValue,
                message: "Value::Undefined cannot be serialized",
            }),
            Unknown(_) => Result::Err(SerializeError {
                kind: SerializeErrorKind::UnsupportedValue,
                message: "Value::Unknown cannot be re-serialized through a generic Serializer",
            }),
        };
    }
}

struct ValueVisitor {
}

impl Visitor for ValueVisitor {
    type Value = Value;

    fn visit_null(&mut self) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::Null);
    }

    fn visit_bool(&mut self, v: bool) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::Bool(v));
    }

    fn visit_i64(&mut self, v: i64) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::Int(v));
    }

    fn visit_u64(&mut self, v: u64) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::UInt(v));
    }

    fn visit_i128(&mut self, v: i128) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::Int128(v));
    }

    fn visit_u128(&mut self, v: u128) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::UInt128(v));
    }

    fn visit_f64(&mut self, v: f64) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::Float(v));
    }

    fn visit_string(&mut self, v: String) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::String(v));
    }

    fn visit_bytes(&mut self, v: ByteList) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::Bytes(v));
    }

    fn visit_seq<A: DeserializeSeq>(&mut self, seq: &mut A) -> Result<Value, DeserializeError> {
        let mut items: List<Value> = [];
        loop {
            let next_opt = seq.next_element::<Value>()?;
            match next_opt {
                Some(item) => {
                    items.push(item);
                },
                None => {
                    seq.end()?;
                    return Result::Ok(Value::List(items));
                },
            }
        }
    }

    fn visit_map<A: DeserializeMap>(&mut self, map: &mut A) -> Result<Value, DeserializeError> {
        let mut obj: TreeMap<String, Value> = TreeMap::new();
        loop {
            match map.next_key_string()? {
                Some(key) => {
                    obj[key] = map.next_value::<Value>()?;
                },
                None => {
                    map.end()?;
                    return Result::Ok(Value::Object(obj));
                },
            }
        }
    }

    fn visit_unknown(&mut self, raw: ByteList) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::Unknown(raw));
    }

    fn visit_undefined(&mut self) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::Undefined);
    }
}

impl Inspect for Value {
    pub fn inspect(&self, f: &mut Formatter) {
        match self {
            Null => f.write_str(&"null"),
            Bool(b) => f.write_str(&if *b { "true" } else { "false" }),
            Int(n) => (*n).inspect(f),
            UInt(n) => (*n).inspect(f),
            Int128(n) => (*n).inspect(f),
            UInt128(n) => (*n).inspect(f),
            Float(n) => (*n).inspect(f),
            String(s) => (*s).inspect(f),
            Bytes(b) => {
                f.write_str(&"0x");
                f.write_str(&b.to_hex());
            },
            List(arr) => {
                f.write_char('[');
                for let mut i = 0; i < arr.len(); i += 1 {
                    if i > 0 {
                        f.write_str(&", ");
                    }
                    arr[i].inspect(f);
                }
                f.write_char(']');
            },
            Object(map) => {
                f.write_char('{');
                let mut first = true;
                for let [k, v] of map.entries() {
                    if !first {
                        f.write_str(&", ");
                    }
                    first = false;
                    k.inspect(f);
                    f.write_str(&": ");
                    v.inspect(f);
                }
                f.write_char('}');
            },
            Undefined => f.write_str(&"undefined"),
            Unknown(b) => {
                f.write_str(&"unknown(0x");
                f.write_str(&b.to_hex());
                f.write_char(')');
            },
        }
    }
}

impl InspectAlt for Value {
    pub fn inspect_alt(&self, f: &mut Formatter) {
        match self {
            Null => f.write_str(&"null"),
            Bool(b) => f.write_str(&if *b { "true" } else { "false" }),
            Int(n) => (*n).inspect_alt(f),
            UInt(n) => (*n).inspect_alt(f),
            Int128(n) => (*n).inspect_alt(f),
            UInt128(n) => (*n).inspect_alt(f),
            Float(n) => (*n).inspect_alt(f),
            String(s) => (*s).inspect_alt(f),
            Bytes(b) => {
                f.write_str(&"0x");
                f.write_str(&b.to_hex());
            },
            List(arr) => {
                if arr.is_empty() {
                    f.write_str(&"[]");
                    return;
                }
                f.open_brace("[");
                for let mut i = 0; i < arr.len(); i += 1 {
                    f.write_newline_indent();
                    arr[i].inspect_alt(f);
                    f.write_char(',');
                }
                f.close_brace("]");
            },
            Object(map) => {
                if map.is_empty() {
                    f.write_str(&"{}");
                    return;
                }
                f.open_brace("{");
                for let [k, v] of map.entries() {
                    f.write_newline_indent();
                    k.inspect_alt(f);
                    f.write_str(&": ");
                    v.inspect_alt(f);
                    f.write_char(',');
                }
                f.close_brace("}");
            },
            Undefined => f.write_str(&"undefined"),
            Unknown(b) => {
                f.write_str(&"unknown(0x");
                f.write_str(&b.to_hex());
                f.write_char(')');
            },
        }
    }
}

impl Deserialize for Value {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<Value, DeserializeError> {
        let mut visitor = ValueVisitor {};
        return d.deserialize_any::<ValueVisitor>(&mut visitor);
    }
}
