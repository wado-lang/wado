#![stdlib("core:value")]
//! Dynamically-typed, format-agnostic value type.
//!
//! `Value` represents any value the serde data model can carry, shared by
//! every self-describing format (`core:json`, `core:cbor`). It implements
//! `Serialize` and `Deserialize`, so it round-trips through `from_bytes` /
//! `to_bytes` with no per-type work. `to_value` and `from_value` convert
//! between a typed value and a `Value` directly, and `merge` overlays one
//! `Value` on another, as layered configuration does.
//!
//! It is a general dynamic value, so it deliberately contains no
//! format-specific concepts (no CBOR `Tag`, no `Simple`): a single opaque
//! escape hatch, `Unknown`, carries the raw encoded bytes of anything the
//! model cannot represent. `Bytes` (a semantic byte-string value) and
//! `Unknown` (raw, format-specific encoded bytes) are distinct and must not
//! be conflated.

use {
    Serialize,
    Deserialize,
    Serializer,
    Deserializer,
    SerializeSeq,
    SerializeMap,
    SerializeStruct,
    SerializeVariant,
    DeserializeSeq,
    DeserializeMap,
    DeserializeStruct,
    DeserializeVariant,
    FieldSchema,
    SerializeError,
    SerializeErrorKind,
    DeserializeError,
    DeserializeErrorKind,
    Visitor,
    DuplicateKeyPolicy,
    report_duplicate_key,
} from "core:serde";

use { TreeMap, TreeMapEntriesRefIter } from "core:collections";
use { from_bytes, to_bytes } from "core:json";
use { decode as base64_decode } from "core:base64";

#[synopsis]
test {
    assert to_value(&[1, 2, 3]) matches { Ok(List(items)) && items.len() == 3 };
    assert to_value(&"wado") matches { Ok(String(s)) && s == "wado" };

    let v: Value = from_bytes("{\"x\":1,\"y\":[true,null]}").unwrap();
    assert v matches { Object(fields) && fields.len() == 2 };
    assert to_bytes::<Value>(&v) matches { Ok(bytes) && bytes.len() > 0 };
}

/// A dynamically-typed, format-agnostic value.
///
/// JSON only ever produces `Null` / `Bool` / `Float` / `String` / `List` /
/// `Object` (it has no integer/float distinction and no byte strings); the
/// remaining arms are produced by binary formats such as CBOR.
pub variant Value {
    Null,
    Bool(bool),
    Int(i64),
    UInt(u64),
    Int128(i128),
    UInt128(u128),
    Float(f64),  // binary16/32/64 all widened to f64
    String(String),
    Bytes(ByteList),  // a byte-string *value*
    List(List<Value>),
    Object(TreeMap<String, Value>),  // string keys only, insertion order preserved
    Undefined,  // CBOR simple 23; also present in JS/MsgPack data
    Unknown(ByteList),  // raw encoded bytes of an unrepresentable item
}

// A JSON-shaped literal builds a `Value` directly (WEP 2026-08-24): `[ … ]`
// through the array impl, `{ … }` through the pair-array one, and each leaf
// through its own `From`.
impl From<Array<Value>> for Value {
    fn from(elements: Array<Value>) -> Value {
        return Value::List(List::<Value>::from(elements));
    }
}

impl From<Array<[String, Value]>> for Value {
    fn from(entries: Array<[String, Value]>) -> Value {
        return Value::Object(TreeMap::<String, Value>::from(entries));
    }
}

// A bare `null` is an `Option<!>` — a value of every `Option` and of nothing
// else — so a type accepts `null` in a literal by converting from it.
impl From<Option<!>> for Value {
    fn from(value: Option<!>) -> Value {
        return Value::Null;
    }
}

impl From<bool> for Value {
    fn from(value: bool) -> Value {
        return Value::Bool(value);
    }
}

impl From<i32> for Value {
    fn from(value: i32) -> Value {
        return Value::Int(value as i64);
    }
}

impl From<i64> for Value {
    fn from(value: i64) -> Value {
        return Value::Int(value);
    }
}

impl From<u32> for Value {
    fn from(value: u32) -> Value {
        return Value::UInt(value as u64);
    }
}

impl From<u64> for Value {
    fn from(value: u64) -> Value {
        return Value::UInt(value);
    }
}

impl From<f64> for Value {
    fn from(value: f64) -> Value {
        return Value::Float(value);
    }
}

impl From<String> for Value {
    fn from(value: String) -> Value {
        return Value::String(value);
    }
}

impl Eq for Value {
    fn eq(&self, other: &Value) -> bool {
        return match [*self, *other] {
            [Null, Null] => true,
            [Bool(a), Bool(b)] => a == b,
            [Int(a), Int(b)] => a == b,
            [UInt(a), UInt(b)] => a == b,
            [Int128(a), Int128(b)] => a == b,
            [UInt128(a), UInt128(b)] => a == b,
            [Float(a), Float(b)] => a == b,
            [String(a), String(b)] => a == b,
            [Bytes(a), Bytes(b)] => a == b,
            [List(a), List(b)] => {
                if a.len() != b.len() {
                    return false;
                }
                let mut i = 0;
                while i < a.len() {
                    if !(a[i] == b[i]) {
                        return false;
                    }
                    i += 1;
                }
                true;
            },
            [Object(a), Object(b)] => {
                if a.len() != b.len() {
                    return false;
                }
                for let [k, v] of a.entries() {
                    if let Some(other_v) = b.get(*k) {
                        if !(*v == other_v) {
                            return false;
                        }
                    } else {
                        return false;
                    }
                }
                true;
            },
            [Undefined, Undefined] => true,
            [Unknown(a), Unknown(b)] => a == b,
            _ => false,
        };
    }
}

impl Serialize for Value {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return match self {
            Null => s.serialize_null(),
            Bool(b) => s.serialize_bool(*b),
            Int(n) => s.serialize_i64(*n),
            UInt(n) => s.serialize_u64(*n),
            Int128(n) => s.serialize_i128(*n),
            UInt128(n) => s.serialize_u128(*n),
            Float(n) => s.serialize_f64(*n),
            String(str_val) => s.serialize_string(str_val),
            Bytes(bytes) => s.serialize_bytes(bytes.as_byte_slice()),
            List(arr) => {
                let mut seq = s.begin_seq(arr.len())?;
                for let item of arr {
                    seq.element(item)?;
                }
                seq.end();
            },
            Object(map) => {
                let mut m = s.begin_map(map.len())?;
                for let [key, val] of map.entries() {
                    m.key(key)?;
                    m.value(val)?;
                }
                m.end();
            },
            // `Undefined` has no serde data-model entry, and `Unknown` holds
            // raw format-specific bytes that only the originating format can
            // splice back. Neither is expressible through the generic
            // `Serializer`, so serialization errors by default (RFC 8949 §6).
            Undefined => Result::Err(SerializeError {
                kind: SerializeErrorKind::UnsupportedValue,
                message: "Value::Undefined cannot be serialized",
            }),
            Unknown(_) => Result::Err(SerializeError {
                kind: SerializeErrorKind::UnsupportedValue,
                message: "Value::Unknown cannot be re-serialized through a generic Serializer",
            }),
        };
    }
}

struct ValueVisitor {
    /// `visit_map` is handed the map access, never the deserializer.
    on_duplicate: DuplicateKeyPolicy,
}

impl Visitor for ValueVisitor {
    type Value = Value;

    fn visit_null(&mut self) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::Null);
    }

    fn visit_bool(&mut self, v: bool) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::Bool(v));
    }

    fn visit_i64(&mut self, v: i64) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::Int(v));
    }

    fn visit_u64(&mut self, v: u64) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::UInt(v));
    }

    fn visit_i128(&mut self, v: i128) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::Int128(v));
    }

    fn visit_u128(&mut self, v: u128) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::UInt128(v));
    }

    fn visit_f64(&mut self, v: f64) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::Float(v));
    }

    fn visit_string<S: AsStrSlice>(&mut self, v: S) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::String(v.to_string()));
    }

    fn visit_bytes(&mut self, v: ByteList) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::Bytes(v));
    }

    fn visit_seq<A: DeserializeSeq>(&mut self, seq: &mut A) -> Result<Value, DeserializeError> {
        let mut items: List<Value> = [];
        loop {
            let next_opt = seq.next_element::<Value>()?;
            match next_opt {
                Some(item) => {
                    items.push(item);
                },
                None => {
                    seq.end()?;
                    return Result::Ok(Value::List(items));
                },
            }
        }
    }

    fn visit_map<A: DeserializeMap>(&mut self, map: &mut A) -> Result<Value, DeserializeError> {
        let mut obj: TreeMap<String, Value> = TreeMap::new();
        loop {
            match map.next_key_string()? {
                Some(key) => {
                    let val = map.next_value::<Value>()?;
                    if !obj.try_insert(key, val) {
                        report_duplicate_key(self.on_duplicate, &key)?;
                        obj[key] = val;
                    }
                },
                None => {
                    map.end()?;
                    return Result::Ok(Value::Object(obj));
                },
            }
        }
    }

    fn visit_unknown(&mut self, raw: ByteList) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::Unknown(raw));
    }

    fn visit_undefined(&mut self) -> Result<Value, DeserializeError> {
        return Result::Ok(Value::Undefined);
    }
}

/// The alternate (`#`) rendering `Inspect for Value` hands off to: one
/// element or entry per indented line. A free function because Wado has no
/// inherent `impl` on a variant.
fn inspect_value_alternate(value: &Value, f: &mut Formatter) {
    match value {
        Null => f.write_str("null"),
        Bool(b) => f.write_str(&if *b { "true" } else { "false" }),
        Int(n) => (*n).inspect(f),
        UInt(n) => (*n).inspect(f),
        Int128(n) => (*n).inspect(f),
        UInt128(n) => (*n).inspect(f),
        Float(n) => (*n).inspect(f),
        String(s) => (*s).inspect(f),
        Bytes(b) => {
            f.write_str("0x");
            f.write_str(&b.to_hex());
        },
        List(arr) => {
            if arr.is_empty() {
                f.write_str("[]");
                return;
            }
            f.open_brace("[");
            for let mut i = 0; i < arr.len(); i += 1 {
                f.write_newline_indent();
                arr[i].inspect(f);
                f.write_char(',');
            }
            f.close_brace("]");
        },
        Object(map) => {
            if map.is_empty() {
                f.write_str("{}");
                return;
            }
            f.open_brace("{");
            for let [k, v] of map.entries() {
                f.write_newline_indent();
                k.inspect(f);
                f.write_str(": ");
                v.inspect(f);
                f.write_char(',');
            }
            f.close_brace("}");
        },
        Undefined => f.write_str("undefined"),
        Unknown(b) => {
            f.write_str("unknown(0x");
            f.write_str(&b.to_hex());
            f.write_char(')');
        },
    }
}

impl Inspect for Value {
    pub fn inspect(&self, f: &mut Formatter) {
        if f.alternate {
            inspect_value_alternate(self, f);
            return;
        }
        match self {
            Null => f.write_str("null"),
            Bool(b) => f.write_str(&if *b { "true" } else { "false" }),
            Int(n) => (*n).inspect(f),
            UInt(n) => (*n).inspect(f),
            Int128(n) => (*n).inspect(f),
            UInt128(n) => (*n).inspect(f),
            Float(n) => (*n).inspect(f),
            String(s) => (*s).inspect(f),
            Bytes(b) => {
                f.write_str("0x");
                f.write_str(&b.to_hex());
            },
            List(arr) => {
                f.write_char('[');
                for let mut i = 0; i < arr.len(); i += 1 {
                    if i > 0 {
                        f.write_str(", ");
                    }
                    arr[i].inspect(f);
                }
                f.write_char(']');
            },
            Object(map) => {
                f.write_char('{');
                let mut first = true;
                for let [k, v] of map.entries() {
                    if !first {
                        f.write_str(", ");
                    }
                    first = false;
                    k.inspect(f);
                    f.write_str(": ");
                    v.inspect(f);
                }
                f.write_char('}');
            },
            Undefined => f.write_str("undefined"),
            Unknown(b) => {
                f.write_str("unknown(0x");
                f.write_str(&b.to_hex());
                f.write_char(')');
            },
        }
    }
}

impl Deserialize for Value {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<Value, DeserializeError> {
        let mut visitor = ValueVisitor { on_duplicate: d.on_duplicate_key() };
        return d.deserialize_any::<ValueVisitor>(&mut visitor);
    }
}

/// Build a `Value` from any `Serialize` value — the serde `to_value` analog.
///
/// Direct: it drives a `Value`-building `Serializer` with no intermediate
/// encoding, so it preserves the data model (`Int` vs `UInt` vs `Float`,
/// object key order, variant shape) that a round-trip through a text format
/// like JSON would flatten.
pub fn to_value<T: Serialize>(value: &T) -> Result<Value, SerializeError> {
    let mut out: Value = Value::Null;
    let mut ser = ValueSerializer { out: &mut out };
    value.serialize(&mut ser)?;
    return Result::Ok(out);
}

pub struct ValueSerializer {
    out: &mut Value,
}

pub struct ValueSeqSerializer {
    out: &mut Value,
    items: List<Value>,
}

pub struct ValueMapSerializer {
    out: &mut Value,
    entries: TreeMap<String, Value>,
    pending: Option<String>,
}

pub struct ValueStructSerializer {
    out: &mut Value,
    entries: TreeMap<String, Value>,
}

pub struct ValueVariantSerializer {
    out: &mut Value,
    name: String,
    payloads: List<Value>,
}

fn value_key(v: Value) -> String {
    return match v {
        String(s) => s,
        Int(n) => n.to_string(),
        UInt(n) => n.to_string(),
        Bool(b) => b.to_string(),
        _ => "",
    };
}

impl SerializeSeq for ValueSeqSerializer {
    fn element<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        let mut v: Value = Value::Null;
        let mut ser = ValueSerializer { out: &mut v };
        value.serialize(&mut ser)?;
        self.items.push(v);
        return Result::Ok(());
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        *self.out = Value::List(self.items);
        return Result::Ok(());
    }
}

impl SerializeMap for ValueMapSerializer {
    fn key<T: Serialize>(&mut self, key: &T) -> Result<(), SerializeError> {
        let mut k: Value = Value::Null;
        let mut ser = ValueSerializer { out: &mut k };
        key.serialize(&mut ser)?;
        self.pending = Option::Some(value_key(k));
        return Result::Ok(());
    }

    fn value<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        let mut v: Value = Value::Null;
        let mut ser = ValueSerializer { out: &mut v };
        value.serialize(&mut ser)?;
        if let Some(k) = self.pending {
            self.entries[k] = v;
        }
        self.pending = null;
        return Result::Ok(());
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        *self.out = Value::Object(self.entries);
        return Result::Ok(());
    }
}

impl SerializeStruct for ValueStructSerializer {
    fn field<T: Serialize, S: AsStrSlice>(&mut self, name: S, value: &T) -> Result<(), SerializeError> {
        let mut v: Value = Value::Null;
        let mut ser = ValueSerializer { out: &mut v };
        value.serialize(&mut ser)?;
        self.entries[name.to_string()] = v;
        return Result::Ok(());
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        *self.out = Value::Object(self.entries);
        return Result::Ok(());
    }
}

impl SerializeVariant for ValueVariantSerializer {
    fn payload<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        let mut v: Value = Value::Null;
        let mut ser = ValueSerializer { out: &mut v };
        value.serialize(&mut ser)?;
        self.payloads.push(v);
        return Result::Ok(());
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        let payload = if self.payloads.len() == 1 { self.payloads[0] } else { Value::List(self.payloads) };
        let mut obj = TreeMap::<String, Value>::new();
        obj[self.name] = payload;
        *self.out = Value::Object(obj);
        return Result::Ok(());
    }
}

impl Serializer for ValueSerializer {
    type SeqSerializer = ValueSeqSerializer;
    type MapSerializer = ValueMapSerializer;
    type StructSerializer = ValueStructSerializer;
    type VariantSerializer = ValueVariantSerializer;

    fn serialize_i32(&mut self, v: i32) -> Result<(), SerializeError> {
        *self.out = Value::Int(v as i64);
        return Result::Ok(());
    }

    fn serialize_i64(&mut self, v: i64) -> Result<(), SerializeError> {
        *self.out = Value::Int(v);
        return Result::Ok(());
    }

    fn serialize_u32(&mut self, v: u32) -> Result<(), SerializeError> {
        *self.out = Value::UInt(v as u64);
        return Result::Ok(());
    }

    fn serialize_u64(&mut self, v: u64) -> Result<(), SerializeError> {
        *self.out = Value::UInt(v);
        return Result::Ok(());
    }

    fn serialize_i128(&mut self, v: i128) -> Result<(), SerializeError> {
        *self.out = Value::Int128(v);
        return Result::Ok(());
    }

    fn serialize_u128(&mut self, v: u128) -> Result<(), SerializeError> {
        *self.out = Value::UInt128(v);
        return Result::Ok(());
    }

    fn serialize_f32(&mut self, v: f32) -> Result<(), SerializeError> {
        *self.out = Value::Float(v as f64);
        return Result::Ok(());
    }

    fn serialize_f64(&mut self, v: f64) -> Result<(), SerializeError> {
        *self.out = Value::Float(v);
        return Result::Ok(());
    }

    fn serialize_bool(&mut self, v: bool) -> Result<(), SerializeError> {
        *self.out = Value::Bool(v);
        return Result::Ok(());
    }

    fn serialize_char(&mut self, v: char) -> Result<(), SerializeError> {
        let mut s = String::with_capacity(4);
        s.push(v);
        *self.out = Value::String(s);
        return Result::Ok(());
    }

    fn serialize_string<S: AsStrSlice>(&mut self, v: S) -> Result<(), SerializeError> {
        *self.out = Value::String(v.to_string());
        return Result::Ok(());
    }

    fn serialize_null(&mut self) -> Result<(), SerializeError> {
        *self.out = Value::Null;
        return Result::Ok(());
    }

    fn serialize_bytes(&mut self, v: ByteSlice) -> Result<(), SerializeError> {
        // Preserve byte strings as `Value::Bytes`, not the default seq-of-u8
        // fallback that would yield `Value::List([Int, …])`.
        let mut it = v.iter_value();
        let bytes = it.collect() as ByteList;
        *self.out = Value::Bytes(bytes);
        return Result::Ok(());
    }

    fn begin_seq(&mut self, len: i32) -> Result<ValueSeqSerializer, SerializeError> {
        return Result::Ok(ValueSeqSerializer { out: self.out, items: [] });
    }

    fn begin_map(&mut self, len: i32) -> Result<ValueMapSerializer, SerializeError> {
        return Result::Ok(ValueMapSerializer {
            out: self.out,
            entries: TreeMap::<String, Value>::new(),
            pending: null,
        });
    }

    fn begin_struct<S: AsStrSlice>(&mut self, name: S, fields: i32) -> Result<ValueStructSerializer, SerializeError> {
        return Result::Ok(ValueStructSerializer {
            out: self.out,
            entries: TreeMap::<String, Value>::new(),
        });
    }

    fn serialize_unit_variant<S: AsStrSlice, S1: AsStrSlice>(
        &mut self,
        type_name: S,
        variant_name: S1,
        disc: i32,
    ) -> Result<(), SerializeError> {
        *self.out = Value::String(variant_name.to_string());
        return Result::Ok(());
    }

    fn begin_variant<S: AsStrSlice, S1: AsStrSlice>(
        &mut self,
        type_name: S,
        variant_name: S1,
        disc: i32,
    ) -> Result<ValueVariantSerializer, SerializeError> {
        return Result::Ok(ValueVariantSerializer {
            out: self.out,
            name: variant_name.to_string(),
            payloads: [],
        });
    }
}

/// Build a typed value from a `Value` — the serde `from_value` analog.
///
/// It reads what `to_value` and every self-describing format produce: a whole
/// `Float` reads as an integer, and a string as an integer or a byte string
/// where `core:json` would write one that way. A `Value` carries no position,
/// so an error's offset is `-1`.
pub fn from_value<T: Deserialize>(value: &Value) -> Result<T, DeserializeError> {
    let mut de = ValueDeserializer { value };
    return T::deserialize(&mut de);
}

/// `overlay` laid over `base`: where both are objects, each key of `overlay`
/// merges into `base`'s value for it, and a key `base` lacks is appended.
/// Anywhere else `overlay` wins whole, a list and an explicit `Null` included.
pub fn merge(base: Value, overlay: Value) -> Value {
    let Object(mut merged) = base else {
        return overlay;
    };
    let Object(layer) = overlay else {
        return overlay;
    };
    merge_fields(&mut merged, &layer);
    return Value::Object(merged);
}

/// [`merge`] of two objects' fields, in place, copying only what `layer`
/// puts into `fields`.
fn merge_fields(fields: &mut TreeMap<String, Value>, layer: &TreeMap<String, Value>) {
    for let [key, value] of layer.entries() {
        if let Object(sub_layer) = value {
            if fields.contains_key(*key) {
                if let Object(sub_fields) = &mut fields[*key] {
                    merge_fields(sub_fields, sub_layer);
                    continue;
                }
            }
        }
        fields[*key] = *value;
    }
}

/// Reads a typed value out of the `Value` it points at.
pub struct ValueDeserializer {
    value: &Value,
}

/// Reads the elements of a `List` value.
pub struct ValueSeqAccess {
    items: &List<Value>,
    index: i32,
}

/// Serves both a map and a struct: a `Value` spells them the same way.
pub struct ValueObjectAccess {
    entries: TreeMapEntriesRefIter<String, Value>,
    /// The value of the key just read.
    pending: Option<&Value>,
}

/// Reads a variant case: a bare name, or a single-key object holding the
/// payload.
pub struct ValueVariantAccess {
    name: String,
    /// `null` for a unit case.
    payload: Option<&Value>,
}

global TWO_POW_127: f64 = 170141183460469231731687303715884105728.0;
global TWO_POW_128: f64 = 340282366920938463463374607431768211456.0;

/// The integer `value` holds, as `i128`, the width every narrower target is
/// range-checked from. A value past `i128` is out of range for `type_name`.
fn integer_of(value: &Value, type_name: String) -> Result<i128, DeserializeError> {
    return match value {
        Int(n) => Result::Ok(*n as i128),
        UInt(n) => Result::Ok(*n as i128),
        Int128(n) => Result::Ok(*n),
        UInt128(n) && *n <= i128::MAX as u128 => Result::Ok(*n as i128),
        UInt128(_) => Result::Err(out_of_range(type_name)),
        Float(f) => Result::Ok(whole_float(*f, -TWO_POW_127, TWO_POW_127, type_name)? as i128),
        String(s) => integer_string(s),
        _ => Result::Err(DeserializeError::unexpected_type("expected integer")),
    };
}

/// The integer a string spells, as `core:json` writes one past 53 bits.
fn integer_string<T: FromStr>(s: &String) -> Result<T, DeserializeError> {
    return match T::from_str(s) {
        Ok(n) => Result::Ok(n),
        Err(e) => Result::Err(DeserializeError::invalid_value(`invalid integer string: ${e}`)),
    };
}

/// `f`, when it is whole and within `[min, max)`.
fn whole_float(f: f64, min: f64, max: f64, type_name: String) -> Result<f64, DeserializeError> {
    if f != f64::floor(f) {
        return Result::Err(DeserializeError::unexpected_type("expected integer, got float"));
    }
    if !(min <= f < max) {
        return Result::Err(out_of_range(type_name));
    }
    return Result::Ok(f);
}

/// The integer `value` holds, when it lies in `[min, max]`.
fn integer_in(value: &Value, min: i128, max: i128, type_name: String) -> Result<i128, DeserializeError> {
    let n = integer_of(value, type_name)?;
    if !(min <= n <= max) {
        return Result::Err(out_of_range(type_name));
    }
    return Result::Ok(n);
}

fn out_of_range(type_name: String) -> DeserializeError {
    return DeserializeError::overflow(`value out of range for ${type_name}`);
}

fn float_of(value: &Value) -> Result<f64, DeserializeError> {
    return match value {
        Float(f) => Result::Ok(*f),
        Int(n) => Result::Ok(*n as f64),
        UInt(n) => Result::Ok(*n as f64),
        Int128(n) => Result::Ok(*n as f64),
        UInt128(n) => Result::Ok(*n as f64),
        _ => Result::Err(DeserializeError::unexpected_type("expected number")),
    };
}

fn object_access(fields: &TreeMap<String, Value>) -> ValueObjectAccess {
    return ValueObjectAccess { entries: fields.entries(), pending: null };
}

impl ValueDeserializer {
    fn string_ref(&self) -> Result<&String, DeserializeError> {
        let String(s) = self.value else {
            return Result::Err(DeserializeError::unexpected_type("expected string"));
        };
        return Result::Ok(s);
    }

    fn object(&self) -> Result<ValueObjectAccess, DeserializeError> {
        let Object(fields) = self.value else {
            return Result::Err(DeserializeError::unexpected_type("expected object"));
        };
        return Result::Ok(object_access(fields));
    }
}

impl DeserializeSeq for ValueSeqAccess {
    fn next_element<T: Deserialize>(&mut self) -> Result<Option<T>, DeserializeError> {
        if self.index >= self.items.len() {
            return Result::Ok(null);
        }
        let mut de = ValueDeserializer { value: &self.items[self.index] };
        self.index += 1;
        return Result::Ok(Option::Some(T::deserialize(&mut de)?));
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        if self.index < self.items.len() {
            return Result::Err(DeserializeError::invalid_value(
                `${self.items.len() - self.index} elements left unread`,
            ));
        }
        return Result::Ok(());
    }
}

impl ValueObjectAccess {
    /// The next key, leaving its value pending.
    fn next_key(&mut self) -> Option<&String> {
        let Some([key, value]) = self.entries.next() else {
            return null;
        };
        self.pending = Option::Some(value);
        return Option::Some(key);
    }

    fn pending_value<T: Deserialize>(&mut self) -> Result<T, DeserializeError> {
        let mut de = ValueDeserializer { value: self.pending.expect("a value is read after its key") };
        return T::deserialize(&mut de);
    }
}

impl DeserializeMap for ValueObjectAccess {
    fn next_key_string(&mut self) -> Result<Option<String>, DeserializeError> {
        return Result::Ok(self.next_key().map(|key| *key));
    }

    fn next_value<V: Deserialize>(&mut self) -> Result<V, DeserializeError> {
        return self.pending_value();
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        return Result::Ok(());
    }
}

impl DeserializeStruct for ValueObjectAccess {
    fn next_field<S: FieldSchema>(&mut self) -> Result<Option<i32>, DeserializeError> {
        return Result::Ok(self.next_key().map(|key| S::lookup(key.as_bytes()).unwrap_or(-1)));
    }

    fn value<T: Deserialize>(&mut self) -> Result<T, DeserializeError> {
        return self.pending_value();
    }

    fn skip(&mut self) -> Result<(), DeserializeError> {
        return Result::Ok(());
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        return Result::Ok(());
    }
}

impl DeserializeVariant for ValueVariantAccess {
    fn variant_name(&mut self) -> Result<String, DeserializeError> {
        return Result::Ok(self.name);
    }

    fn disc(&mut self) -> Result<i32, DeserializeError> {
        return Result::Err(DeserializeError {
            kind: DeserializeErrorKind::Custom,
            message: "Value does not encode discriminants",
            offset: -1,
        });
    }

    fn payload<T: Deserialize>(&mut self) -> Result<T, DeserializeError> {
        let Some(payload) = self.payload else {
            return Result::Err(DeserializeError::unexpected_type(`expected a payload for ${self.name}`));
        };
        let mut de = ValueDeserializer { value: payload };
        return T::deserialize(&mut de);
    }

    fn is_unit(&mut self) -> Result<bool, DeserializeError> {
        return Result::Ok(self.payload matches { None });
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        return Result::Ok(());
    }
}

impl Deserializer for ValueDeserializer {
    type SeqAccess = ValueSeqAccess;
    type MapAccess = ValueObjectAccess;
    type StructAccess = ValueObjectAccess;
    type VariantAccess = ValueVariantAccess;

    fn deserialize_i32(&mut self) -> Result<i32, DeserializeError> {
        return Result::Ok(integer_in(self.value, i32::MIN as i128, i32::MAX as i128, "i32")? as i32);
    }

    fn deserialize_i64(&mut self) -> Result<i64, DeserializeError> {
        return Result::Ok(integer_in(self.value, i64::MIN as i128, i64::MAX as i128, "i64")? as i64);
    }

    fn deserialize_u32(&mut self) -> Result<u32, DeserializeError> {
        return Result::Ok(integer_in(self.value, 0, u32::MAX as i128, "u32")? as u32);
    }

    fn deserialize_u64(&mut self) -> Result<u64, DeserializeError> {
        return Result::Ok(integer_in(self.value, 0, u64::MAX as i128, "u64")? as u64);
    }

    fn deserialize_i128(&mut self) -> Result<i128, DeserializeError> {
        return integer_of(self.value, "i128");
    }

    fn deserialize_u128(&mut self) -> Result<u128, DeserializeError> {
        return match self.value {
            UInt128(n) => Result::Ok(*n),
            String(s) => integer_string(s),
            Float(f) => Result::Ok(whole_float(*f, 0.0, TWO_POW_128, "u128")? as u128),
            _ => Result::Ok(integer_in(self.value, 0, i128::MAX, "u128")? as u128),
        };
    }

    fn deserialize_f32(&mut self) -> Result<f32, DeserializeError> {
        return Result::Ok(float_of(self.value)? as f32);
    }

    fn deserialize_f64(&mut self) -> Result<f64, DeserializeError> {
        return float_of(self.value);
    }

    fn deserialize_f16(&mut self) -> Result<f16, DeserializeError> {
        return Result::Ok(f16::from_f64(float_of(self.value)?));
    }

    fn deserialize_bf16(&mut self) -> Result<bf16, DeserializeError> {
        return Result::Ok(bf16::from_f64(float_of(self.value)?));
    }

    fn deserialize_bool(&mut self) -> Result<bool, DeserializeError> {
        let Bool(b) = self.value else {
            return Result::Err(DeserializeError::unexpected_type("expected bool"));
        };
        return Result::Ok(*b);
    }

    fn deserialize_char(&mut self) -> Result<char, DeserializeError> {
        let mut chars = self.string_ref()?.chars();
        let Some(c) = chars.next() else {
            return Result::Err(DeserializeError::invalid_value("empty string for char"));
        };
        if chars.next() matches { Some(_) } {
            return Result::Err(DeserializeError::invalid_value("expected single char"));
        }
        return Result::Ok(c);
    }

    fn deserialize_string(&mut self) -> Result<String, DeserializeError> {
        return Result::Ok(*self.string_ref()?);
    }

    fn deserialize_bytes(&mut self) -> Result<ByteList, DeserializeError> {
        if let Bytes(b) = self.value {
            return Result::Ok(*b);
        }
        let Some(bytes) = base64_decode(self.string_ref()?) else {
            return Result::Err(DeserializeError::invalid_value("invalid base64 byte string"));
        };
        return Result::Ok(bytes);
    }

    fn is_null(&mut self) -> Result<bool, DeserializeError> {
        return Result::Ok(self.value matches { Null | Undefined });
    }

    fn begin_seq(&mut self) -> Result<ValueSeqAccess, DeserializeError> {
        let List(items) = self.value else {
            return Result::Err(DeserializeError::unexpected_type("expected list"));
        };
        return Result::Ok(ValueSeqAccess { items, index: 0 });
    }

    fn begin_map(&mut self) -> Result<ValueObjectAccess, DeserializeError> {
        return self.object();
    }

    fn begin_struct<S: AsStrSlice>(&mut self, name: S, num_fields: i32) -> Result<ValueObjectAccess, DeserializeError> {
        return self.object();
    }

    fn begin_variant<S: AsStrSlice>(
        &mut self,
        type_name: S,
        num_cases: i32,
    ) -> Result<ValueVariantAccess, DeserializeError> {
        if let String(name) = self.value {
            return Result::Ok(ValueVariantAccess { name: *name, payload: null });
        }
        if let Object(fields) = self.value {
            if fields.len() == 1 {
                let Some([name, payload]) = fields.entries().next() else {
                    unreachable();
                };
                return Result::Ok(ValueVariantAccess { name: *name, payload: Option::Some(payload) });
            }
        }
        return Result::Err(DeserializeError::unexpected_type(
            "expected string or single-key object for variant",
        ));
    }

    fn deserialize_any<V: Visitor>(&mut self, visitor: &mut V) -> Result<V::Value, DeserializeError> {
        return match self.value {
            Null => visitor.visit_null(),
            Bool(b) => visitor.visit_bool(*b),
            Int(n) => visitor.visit_i64(*n),
            UInt(n) => visitor.visit_u64(*n),
            Int128(n) => visitor.visit_i128(*n),
            UInt128(n) => visitor.visit_u128(*n),
            Float(f) => visitor.visit_f64(*f),
            String(s) => visitor.visit_string(s),
            Bytes(b) => visitor.visit_bytes(*b),
            List(items) => {
                let mut seq = ValueSeqAccess { items, index: 0 };
                visitor.visit_seq(&mut seq);
            },
            Object(fields) => {
                let mut map = object_access(fields);
                visitor.visit_map(&mut map);
            },
            Undefined => visitor.visit_undefined(),
            Unknown(raw) => visitor.visit_unknown(*raw),
        };
    }
}
