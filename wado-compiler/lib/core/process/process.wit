package core:process@0.1.0;

/// Types for running a host program. See WEP 2026-10-21 (`core:process`).
interface types {
    /// How a child ended.
    variant exit-status {
        /// It exited with this status.
        exited(u8),
        /// A signal ended it.
        signaled(u8),
        /// The host ended it at its timeout.
        timed-out,
    }

    /// Whether this host spawns. Fixed when the host starts.
    enum availability {
        available,
        /// The host turned spawning off.
        denied,
        /// The OS cannot confine a child.
        unsupported,
    }

    enum error-code {
        /// No such program.
        not-found,
        /// The sandbox refused to execute this program.
        not-permitted,
        resource-exhausted,
        io,
    }

    variant input {
        null,
        /// The guest's own stdin. The guest passes on only a stream it holds.
        inherit,
        piped(stream<u8>),
    }

    enum output {
        null,
        /// The guest's own stdout or stderr.
        inherit,
        piped,
    }

    record command {
        /// A path when it holds a `/`; otherwise a name looked up on the
        /// host's `PATH`, skipping empty and relative entries.
        program: string,
        args: list<string>,
        /// Laid over the baseline variables: `PATH`, a private `HOME` and
        /// `TMPDIR`, `LANG` and `LC_*`, and `TERM` where a stream is
        /// inherited. The guest's own environment is not passed on.
        env: list<tuple<string, string>>,
        stdin: input,
        stdout: output,
        stderr: output,
        /// Nanoseconds, as `wasi:clocks` counts a duration. At the timeout the
        /// host sends SIGTERM to the child's process group, then SIGKILL after
        /// a grace period the host sets.
        timeout: option<u64>,
    }

    /// A running child. Dropping it kills its process group, and the host
    /// kills every child when the guest exits.
    resource child {
        /// Kill the child's process group now.
        kill: func();
    }

    record spawned {
        child: child,
        /// `some` exactly where `command.stdout` was `piped`.
        stdout: option<stream<u8>>,
        /// `some` exactly where `command.stderr` was `piped`.
        stderr: option<stream<u8>>,
        exit: future<result<exit-status, error-code>>,
    }
}

/// Spawning a child confined to the guest's grants plus a fixed system
/// baseline: spawning never extends the guest's authority.
///
/// Every function but `get-availability` requires it to answer `available`,
/// and traps otherwise.
interface process {
    use wasi:filesystem/types@0.3.0.{descriptor};
    use types.{availability, command, spawned, error-code};

    /// Whether spawning is offered, with no side effect.
    get-availability: func() -> availability;

    /// Start `cmd` in `cwd`, or in the first preopened directory with `none`.
    spawn: func(cmd: command, cwd: option<borrow<descriptor>>) -> result<spawned, error-code>;
}
