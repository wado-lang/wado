package core:process@0.1.0;

/// Types for running a host program.
interface types {
    /// How a child ended.
    variant exit-status {
        /// It exited with this status, as the host's OS reports it.
        exited(s32),
        /// The host's OS ended it with this signal.
        signaled(s32),
    }

    /// Whether this host spawns. Fixed when the host starts.
    enum availability {
        available,
        /// The host turned spawning off.
        denied,
        /// The host cannot run a child as its policy requires.
        unsupported,
    }

    variant error-code {
        /// No program by that name, or nothing at the path given.
        not-found,
        /// The host's policy does not let a child run this program.
        not-permitted,
        /// What the name or path leads to is not a program the host can run.
        not-executable,
        /// `program`, an argument, or an environment variable is not one the
        /// host can pass: it holds a NUL, or a variable's name is empty or
        /// holds `=`.
        invalid-argument,
        /// The arguments and the environment together are more than the host
        /// can pass.
        argument-list-too-long,
        /// `cwd` is not a directory.
        not-directory,
        /// The host lacks a resource that running a child takes.
        resource-exhausted,
        /// Anything else, with a message for a person where the host has one.
        other(option<string>),
    }

    variant input {
        null,
        /// The guest's own stdin. The guest passes on only a stream it holds.
        inherit,
        piped(stream<u8>),
    }

    enum output {
        null,
        /// The guest's own stdout or stderr.
        inherit,
        piped,
    }

    record command {
        /// A path when it holds a `/`; otherwise a name the host looks up.
        program: string,
        args: list<string>,
        /// Laid over the variables the host gives every child. The guest's own
        /// environment is not passed on.
        env: list<tuple<string, string>>,
        stdin: input,
        stdout: output,
        stderr: output,
    }

    /// A running child. Dropping it ends the child and every process it
    /// started, and the host ends every child when the guest exits.
    resource child {
        /// End the child and every process it started, now.
        kill: func();
    }

    record spawned {
        child: child,
        /// `some` exactly where `command.stdout` was `piped`.
        stdout: option<stream<u8>>,
        /// `some` exactly where `command.stderr` was `piped`.
        stderr: option<stream<u8>>,
        exit: future<result<exit-status, error-code>>,
    }
}

/// Running a host program as a child of the guest.
///
/// A host may offer it or not, and confines a child as its own policy says.
/// Every function but `get-availability` requires it to answer `available`,
/// and traps otherwise.
interface process {
    use wasi:filesystem/types@0.3.0.{descriptor};
    use types.{availability, command, spawned, error-code};

    /// Whether spawning is offered, with no side effect.
    get-availability: func() -> availability;

    /// Start `cmd` in `cwd`, or in the first preopened directory with `none`.
    spawn: func(cmd: command, cwd: option<borrow<descriptor>>) -> result<spawned, error-code>;
}
