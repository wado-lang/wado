package core:process@0.1.0;

/// The types `process` speaks in.
interface types {
    /// How a child ended.
    variant exit-status {
        /// It exited with this code.
        exited(u8),
        /// A signal ended it.
        signaled(u8),
        /// It ran past its timeout, and the host ended it.
        timed-out,
    }

    /// Whether this host offers spawning.
    enum availability {
        available,
        /// The host turned spawning off.
        denied,
        /// The host cannot confine a child.
        unsupported,
    }

    /// Why one spawn failed.
    enum error-code {
        /// No such program.
        not-found,
        /// The sandbox refused to execute this program.
        not-permitted,
        resource-exhausted,
        io,
    }

    /// Where a child's standard input comes from.
    variant input {
        null,
        /// The caller's own standard input.
        inherit,
        piped(stream<u8>),
    }

    /// Where a child's standard output or error goes.
    enum output {
        null,
        /// The caller's own stream.
        inherit,
        /// A stream `spawned` hands back.
        piped,
    }

    record command {
        /// A name holding a `/` is a path; any other is looked up on the host's
        /// `PATH`.
        program: string,
        args: list<string>,
        /// Set over the baseline the host gives every child.
        env: list<tuple<string, string>>,
        stdin: input,
        stdout: output,
        stderr: output,
        /// Nanoseconds, as `wasi:clocks` counts a duration.
        timeout: option<u64>,
    }

    /// A running child. Dropping it kills its process group.
    resource child {
        /// Kill the child's process group.
        kill: func();
    }

    record spawned {
        child: child,
        /// Present where `command.stdout` is `piped`.
        stdout: option<stream<u8>>,
        /// Present where `command.stderr` is `piped`.
        stderr: option<stream<u8>>,
        exit: future<result<exit-status, error-code>>,
    }
}

/// Spawning a host program, confined to the caller's own grants. See
/// WEP 2026-10-21 (`core:process`).
///
/// Every function but `get-availability` requires it to answer `available`, and
/// traps otherwise. The answer is fixed for the instance's lifetime.
interface process {
    use types.{availability, command, spawned, error-code};
    use wasi:filesystem/types@0.3.0.{descriptor};

    get-availability: func() -> availability;

    /// Start `cmd` in `cwd`, or in the first preopened directory.
    spawn: func(cmd: command, cwd: option<borrow<descriptor>>) -> result<spawned, error-code>;
}
