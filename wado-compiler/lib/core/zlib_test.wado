use {
    Z_OK, Z_STREAM_END, Z_NEED_DICT, Z_ERRNO, Z_STREAM_ERROR,
    Z_DATA_ERROR, Z_MEM_ERROR, Z_BUF_ERROR, Z_VERSION_ERROR,
    Z_NO_FLUSH, Z_PARTIAL_FLUSH, Z_SYNC_FLUSH, Z_FULL_FLUSH,
    Z_FINISH, Z_BLOCK, Z_TREES,
    Z_NO_COMPRESSION, Z_BEST_SPEED, Z_BEST_COMPRESSION, Z_DEFAULT_COMPRESSION,
    Z_DEFAULT_STRATEGY, Z_FILTERED, Z_HUFFMAN_ONLY, Z_RLE, Z_FIXED,
    Z_BINARY, Z_TEXT, Z_UNKNOWN,
    Z_DEFLATED, MAX_WBITS,
    adler32, adler32_init, adler32_combine,
    crc32, crc32_init, crc32_combine,
    zlib_compress, zlib_compress_stored, inflate_zlib,
    compress2, compress_with_strategy, compress_bound,
    deflate_raw, deflate_raw2, inflate_raw,
    gzip_compress, gzip_compress2, inflate_gzip,
    uncompress, uncompress2,
    DeflateStream, InflateStream,
    ZLIB_FORMAT, RAW_FORMAT, GZIP_FORMAT, AUTO_FORMAT,
    zlib_version,
} from "core:zlib";

fn bytes_equal(a: &Array<u8>, b: &Array<u8>) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for let mut i = 0; i < a.len(); i += 1 {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}

fn string_to_bytes(s: String) -> Array<u8> {
    let mut out: Array<u8> = Array::<u8>::with_capacity(s.len());
    for let mut i = 0; i < s.len(); i += 1 {
        out.append(s.get_byte(i));
    }
    return out;
}

fn make_pattern_data(size: i32) -> Array<u8> {
    let mut data: Array<u8> = Array::<u8>::with_capacity(size);
    for let mut i = 0; i < size; i += 1 {
        data.append((i % 256) as u8);
    }
    return data;
}

fn make_repeated(byte: u8, count: i32) -> Array<u8> {
    let mut data: Array<u8> = Array::<u8>::with_capacity(count);
    for let mut i = 0; i < count; i += 1 {
        data.append(byte);
    }
    return data;
}

test "return codes" {
    assert Z_OK == 0;
    assert Z_STREAM_END == 1;
    assert Z_NEED_DICT == 2;
    assert Z_ERRNO == -1;
    assert Z_STREAM_ERROR == -2;
    assert Z_DATA_ERROR == -3;
    assert Z_MEM_ERROR == -4;
    assert Z_BUF_ERROR == -5;
    assert Z_VERSION_ERROR == -6;
}

test "flush modes" {
    assert Z_NO_FLUSH == 0;
    assert Z_PARTIAL_FLUSH == 1;
    assert Z_SYNC_FLUSH == 2;
    assert Z_FULL_FLUSH == 3;
    assert Z_FINISH == 4;
    assert Z_BLOCK == 5;
    assert Z_TREES == 6;
}

test "compression levels" {
    assert Z_NO_COMPRESSION == 0;
    assert Z_BEST_SPEED == 1;
    assert Z_BEST_COMPRESSION == 9;
    assert Z_DEFAULT_COMPRESSION == 6;
}

test "strategies" {
    assert Z_DEFAULT_STRATEGY == 0;
    assert Z_FILTERED == 1;
    assert Z_HUFFMAN_ONLY == 2;
    assert Z_RLE == 3;
    assert Z_FIXED == 4;
}

test "data types" {
    assert Z_BINARY == 0;
    assert Z_TEXT == 1;
    assert Z_UNKNOWN == 2;
}

test "other constants" {
    assert Z_DEFLATED == 8;
    assert MAX_WBITS == 15;
}

test "adler32" {
    let data: Array<u8> = [72 as u8, 101 as u8, 108 as u8, 108 as u8, 111 as u8]; // "Hello"
    let checksum = adler32(adler32_init(), &data, 0, 5);
    assert checksum == 93061621 as u32;
}

test "crc32" {
    let data: Array<u8> = [72 as u8, 101 as u8, 108 as u8, 108 as u8, 111 as u8]; // "Hello"
    let crc = crc32(crc32_init(), &data, 0, 5);
    assert crc == 4157704578 as u32;
}

test "adler32_combine" {
    let seg1 = string_to_bytes("Hello, ");
    let seg2 = string_to_bytes("World!");
    let mut combined: Array<u8> = Array::<u8>::with_capacity(seg1.len() + seg2.len());
    for let mut i = 0; i < seg1.len(); i += 1 {
        combined.append(seg1[i]);
    }
    for let mut i = 0; i < seg2.len(); i += 1 {
        combined.append(seg2[i]);
    }

    let a1 = adler32(adler32_init(), &seg1, 0, seg1.len());
    let a2 = adler32(adler32_init(), &seg2, 0, seg2.len());
    let a_full = adler32(adler32_init(), &combined, 0, combined.len());
    let a_joined = adler32_combine(a1, a2, seg2.len());
    assert a_full == a_joined, "adler32_combine must match full checksum";
}

test "crc32_combine" {
    let seg1 = string_to_bytes("Hello, ");
    let seg2 = string_to_bytes("World!");
    let mut combined: Array<u8> = Array::<u8>::with_capacity(seg1.len() + seg2.len());
    for let mut i = 0; i < seg1.len(); i += 1 {
        combined.append(seg1[i]);
    }
    for let mut i = 0; i < seg2.len(); i += 1 {
        combined.append(seg2[i]);
    }

    let c1 = crc32(crc32_init(), &seg1, 0, seg1.len());
    let c2 = crc32(crc32_init(), &seg2, 0, seg2.len());
    let c_full = crc32(crc32_init(), &combined, 0, combined.len());
    let c_joined = crc32_combine(c1, c2, seg2.len());
    assert c_full == c_joined, "crc32_combine must match full checksum";
}

test "inflate zlib Hello" {
    let expected: Array<u8> = [72 as u8, 101 as u8, 108 as u8, 108 as u8, 111 as u8];
    let compressed: Array<u8> = [120 as u8, 156 as u8, 243 as u8, 72 as u8, 205 as u8, 201 as u8, 201 as u8, 7 as u8, 0 as u8, 5 as u8, 140 as u8, 1 as u8, 245 as u8];
    let result = inflate_zlib(&compressed);
    assert bytes_equal(&expected, &result), "inflate Hello mismatch";
}

test "inflate zlib 1000xA" {
    let compressed: Array<u8> = [120 as u8, 156 as u8, 115 as u8, 116 as u8, 28 as u8, 5 as u8, 163 as u8, 96 as u8, 20 as u8, 12 as u8, 119 as u8, 0 as u8, 0 as u8, 137 as u8, 12 as u8, 253 as u8, 233 as u8];
    let result = inflate_zlib(&compressed);
    assert result.len() == 1000;
    for let mut i = 0; i < 1000; i += 1 {
        assert result[i] == 65 as u8;
    }
}

test "inflate zlib Hello World x20" {
    let compressed: Array<u8> = [120 as u8, 156 as u8, 243 as u8, 72 as u8, 205 as u8, 201 as u8, 201 as u8, 215 as u8, 81 as u8, 8 as u8, 207 as u8, 47 as u8, 202 as u8, 73 as u8, 81 as u8, 84 as u8, 240 as u8, 24 as u8, 229 as u8, 65 as u8, 121 as u8, 0 as u8, 245 as u8, 131 as u8, 90 as u8, 181 as u8];
    let result = inflate_zlib(&compressed);
    assert result.len() == 280;
    let expected_unit: Array<u8> = [72 as u8, 101 as u8, 108 as u8, 108 as u8, 111 as u8, 44 as u8, 32 as u8, 87 as u8, 111 as u8, 114 as u8, 108 as u8, 100 as u8, 33 as u8, 32 as u8];
    for let mut i = 0; i < 14; i += 1 {
        assert result[i] == expected_unit[i];
    }
}

