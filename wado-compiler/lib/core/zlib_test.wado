fn make_pattern_data(size: i32) -> ByteList {
    let mut data = ByteList::with_capacity(size);
    for let mut i = 0; i < size; i += 1 {
        data.push((i % 256) as u8);
    }
    return data;
}

fn make_repeated(byte: u8, count: i32) -> ByteList {
    return List::filled(count, byte) as ByteList;
}

// Text-shaped: a small vocabulary recurring at varying distances, which is what
// puts a position's best match deep in its hash chain rather than at the head.
fn make_wordy(size: i32) -> ByteList {
    let words: List<String> = [
        "\"name\":", "\"id\":", "\"created_at\":", "\"screen_name\":", "\"text\":", "\"followers_count\":", "\"url\":",
        "\"description\":", "null,", "true,",
    ];
    let mut data = ByteList::with_capacity(size);
    let mut state: u32 = 0x2468ace;
    while data.len() < size {
        state ^= state << 13;
        state ^= state >> 17;
        state ^= state << 5;
        let word = words[(state % 10) as i32];
        data.extend_from_slice(word.as_bytes() as Slice<u8>);
        let digits = (state >> 8 & 7) as i32;
        for let mut i = 0; i < digits; i += 1 {
            state ^= state << 13;
            state ^= state >> 17;
            state ^= state << 5;
            data.push((48 + state % 10) as u8);
        }
    }
    return data;
}

fn make_incompressible(size: i32) -> ByteList {
    let mut data = ByteList::with_capacity(size);
    let mut state: u32 = 0x12345678;
    for let mut i = 0; i < size; i += 1 {
        state ^= state << 13;
        state ^= state >> 17;
        state ^= state << 5;
        data.push((state & 0xFF) as u8);
    }
    return data;
}

test "return codes" {
    assert Z_OK == 0;
    assert Z_STREAM_END == 1;
    assert Z_ERRNO == -1;
    assert Z_STREAM_ERROR == -2;
    assert Z_DATA_ERROR == -3;
    assert Z_MEM_ERROR == -4;
    assert Z_BUF_ERROR == -5;
    assert Z_VERSION_ERROR == -6;
}

test "flush modes" {
    assert Z_NO_FLUSH == 0;
    assert Z_PARTIAL_FLUSH == 1;
    assert Z_SYNC_FLUSH == 2;
    assert Z_FULL_FLUSH == 3;
    assert Z_FINISH == 4;
    assert Z_BLOCK == 5;
    assert Z_TREES == 6;
}

test "compression levels" {
    assert Z_NO_COMPRESSION == 0;
    assert Z_BEST_SPEED == 1;
    assert Z_BEST_COMPRESSION == 9;
    assert Z_DEFAULT_COMPRESSION == 6;
}

test "strategies" {
    assert Z_DEFAULT_STRATEGY == 0;
    assert Z_FILTERED == 1;
    assert Z_HUFFMAN_ONLY == 2;
    assert Z_RLE == 3;
    assert Z_FIXED == 4;
}

test "data types" {
    assert Z_BINARY == 0;
    assert Z_TEXT == 1;
    assert Z_UNKNOWN == 2;
}

test "other constants" {
    assert Z_DEFLATED == 8;
    assert MAX_WBITS == 15;
}

test "adler32" {
    let data: ByteList = [72, 101, 108, 108, 111];  // "Hello"
    let checksum = adler32(adler32_init(), &data, 0, 5);
    assert checksum == 93061621;
}

test "crc32" {
    let data: ByteList = [72, 101, 108, 108, 111];  // "Hello"
    let crc = crc32(crc32_init(), &data, 0, 5);
    assert crc == 4157704578;
}

test "adler32_combine" {
    let seg1 = b"Hello, ";
    let seg2 = b"World!";
    let combined = b"Hello, World!";

    let a1 = adler32(adler32_init(), &seg1, 0, seg1.len());
    let a2 = adler32(adler32_init(), &seg2, 0, seg2.len());
    let a_full = adler32(adler32_init(), &combined, 0, combined.len());
    let a_joined = adler32_combine(a1, a2, seg2.len());
    assert a_full == a_joined, "adler32_combine must match full checksum";
}

test "crc32_combine" {
    let seg1 = b"Hello, ";
    let seg2 = b"World!";
    let combined = b"Hello, World!";

    let c1 = crc32(crc32_init(), &seg1, 0, seg1.len());
    let c2 = crc32(crc32_init(), &seg2, 0, seg2.len());
    let c_full = crc32(crc32_init(), &combined, 0, combined.len());
    let c_joined = crc32_combine(c1, c2, seg2.len());
    assert c_full == c_joined, "crc32_combine must match full checksum";
}

test "inflate zlib Hello" {
    let expected: ByteList = [72, 101, 108, 108, 111];
    let compressed: ByteList = [120, 156, 243, 72, 205, 201, 201, 7, 0, 5, 140, 1, 245];
    let result = inflate_zlib(&compressed).unwrap();
    assert result == expected;
}

test "inflate zlib 1000xA" {
    let compressed: ByteList = [120, 156, 115, 116, 28, 5, 163, 96, 20, 12, 119, 0, 0, 137, 12, 253, 233];
    let result = inflate_zlib(&compressed).unwrap();
    assert result.len() == 1000;
    for let mut i = 0; i < 1000; i += 1 {
        assert result[i] == 65;
    }
}

test "inflate zlib Hello World x20" {
    let compressed: ByteList = [
        120, 156, 243, 72, 205, 201, 201, 215, 81, 8, 207, 47, 202, 73, 81, 84, 240, 24, 229, 65, 121, 0, 245, 131, 90,
        181,
    ];
    let result = inflate_zlib(&compressed).unwrap();
    assert result.len() == 280;
    let expected_unit: ByteList = [72, 101, 108, 108, 111, 44, 32, 87, 111, 114, 108, 100, 33, 32];
    for let mut i = 0; i < 14; i += 1 {
        assert result[i] == expected_unit[i];
    }
}

