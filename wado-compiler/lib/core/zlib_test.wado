test "inflate zlib empty" {
    let compressed: Array<u8> = [120 as u8, 156 as u8, 3 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 1 as u8];
    let result = inflate_zlib(&compressed);
    assert result.len() == 0;
}

test "stored block round-trip Hello" {
    let data: Array<u8> = [72 as u8, 101 as u8, 108 as u8, 108 as u8, 111 as u8];
    let compressed = zlib_compress_stored(&data);
    let decompressed = inflate_zlib(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "stored block round-trip 1000 bytes" {
    let data = make_pattern_data(1000);
    let compressed = zlib_compress_stored(&data);
    let decompressed = inflate_zlib(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "Huffman round-trip Hello" {
    let data: Array<u8> = [72 as u8, 101 as u8, 108 as u8, 108 as u8, 111 as u8];
    let compressed = zlib_compress(&data);
    let decompressed = inflate_zlib(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "Huffman round-trip empty" {
    let data: Array<u8> = [];
    let compressed = zlib_compress(&data);
    let decompressed = inflate_zlib(&compressed);
    assert decompressed.len() == 0;
}

test "Huffman round-trip repetitive data" {
    let data = make_repeated(65 as u8, 1000);
    let compressed = zlib_compress(&data);
    assert compressed.len() < data.len(), "repetitive data should compress";
    let decompressed = inflate_zlib(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "Huffman round-trip mixed data" {
    let data = make_pattern_data(500);
    let compressed = zlib_compress(&data);
    let decompressed = inflate_zlib(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "Huffman round-trip Hello World x20" {
    let unit: Array<u8> = [72 as u8, 101 as u8, 108 as u8, 108 as u8, 111 as u8, 44 as u8, 32 as u8, 87 as u8, 111 as u8, 114 as u8, 108 as u8, 100 as u8, 33 as u8, 32 as u8];
    let mut data: Array<u8> = Array::<u8>::with_capacity(280);
    for let mut j = 0; j < 20; j += 1 {
        for let mut i = 0; i < 14; i += 1 {
            data.append(unit[i]);
        }
    }
    let compressed = zlib_compress(&data);
    assert compressed.len() < data.len(), "repetitive text should compress";
    let decompressed = inflate_zlib(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "compress_bound exceeds source length" {
    let bound = compress_bound(1000);
    assert bound > 1000;
}

test "compression level 0 stored round-trip" {
    let data = make_pattern_data(1000);
    let compressed = compress2(&data, Z_NO_COMPRESSION);
    let decompressed = inflate_zlib(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "compression level 1 fastest round-trip" {
    let data = make_pattern_data(1000);
    let compressed = compress2(&data, Z_BEST_SPEED);
    let decompressed = inflate_zlib(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "compression level 6 default round-trip" {
    let data = make_pattern_data(1000);
    let compressed = compress2(&data, Z_DEFAULT_COMPRESSION);
    let decompressed = inflate_zlib(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "compression level 9 best round-trip" {
    let data = make_pattern_data(1000);
    let compressed = compress2(&data, Z_BEST_COMPRESSION);
    let decompressed = inflate_zlib(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "stored is larger than compressed" {
    let data = make_pattern_data(1000);
    let c0 = compress2(&data, Z_NO_COMPRESSION);
    let c1 = compress2(&data, Z_BEST_SPEED);
    assert c0.len() > c1.len();
}

test "strategy Huffman-only round-trip" {
    let data = make_pattern_data(1000);
    let compressed = compress_with_strategy(&data, 6, Z_HUFFMAN_ONLY);
    let decompressed = inflate_zlib(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "strategy RLE round-trip" {
    let data = make_repeated(65 as u8, 1000);
    let compressed = compress_with_strategy(&data, 6, Z_RLE);
    let decompressed = inflate_zlib(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "strategy fixed round-trip" {
    let data = make_pattern_data(1000);
    let compressed = compress_with_strategy(&data, 6, Z_FIXED);
    let decompressed = inflate_zlib(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "raw deflate round-trip" {
    let data = string_to_bytes("Hello, raw deflate!");
    let compressed = deflate_raw(&data);
    assert compressed[0] != 0x78 as u8, "raw should not have zlib header";
    let decompressed = inflate_raw(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "raw deflate levels" {
    let data = string_to_bytes("Hello, raw deflate!");
    let c1 = deflate_raw2(&data, Z_BEST_SPEED);
    assert bytes_equal(&data, &inflate_raw(&c1));
    let c9 = deflate_raw2(&data, Z_BEST_COMPRESSION);
    assert bytes_equal(&data, &inflate_raw(&c9));
}

test "raw deflate large data" {
    let data = make_pattern_data(2000);
    let compressed = deflate_raw(&data);
    let decompressed = inflate_raw(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "gzip round-trip" {
    let data = string_to_bytes("Hello, gzip!");
    let compressed = gzip_compress(&data);
    assert compressed[0] == 0x1F as u8, "gzip magic byte 1";
    assert compressed[1] == 0x8B as u8, "gzip magic byte 2";
    assert compressed[2] == 8 as u8, "gzip method deflate";
    let decompressed = inflate_gzip(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "gzip compression levels" {
    let data = string_to_bytes("Hello, gzip!");
    let c1 = gzip_compress2(&data, Z_BEST_SPEED);
    assert bytes_equal(&data, &inflate_gzip(&c1));
    let c9 = gzip_compress2(&data, Z_BEST_COMPRESSION);
    assert bytes_equal(&data, &inflate_gzip(&c9));
}

test "gzip large data" {
    let data = make_pattern_data(5000);
    let compressed = gzip_compress(&data);
    let decompressed = inflate_gzip(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "gzip uncompress auto-detection" {
    let data = make_pattern_data(5000);
    let compressed = gzip_compress(&data);
    let decompressed = uncompress(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "gzip multi-member" {
    let seg1 = string_to_bytes("First member");
    let seg2 = string_to_bytes("Second member");
    let gz1 = gzip_compress(&seg1);
    let gz2 = gzip_compress(&seg2);

    let mut multi: Array<u8> = Array::<u8>::with_capacity(gz1.len() + gz2.len());
    for let mut i = 0; i < gz1.len(); i += 1 {
        multi.append(gz1[i]);
    }
    for let mut i = 0; i < gz2.len(); i += 1 {
        multi.append(gz2[i]);
    }

    let decompressed = inflate_gzip(&multi);
    assert decompressed.len() == seg1.len() + seg2.len();
    for let mut i = 0; i < seg1.len(); i += 1 {
        assert decompressed[i] == seg1[i];
    }
    for let mut i = 0; i < seg2.len(); i += 1 {
        assert decompressed[seg1.len() + i] == seg2[i];
    }
}

test "DeflateStream one-shot" {
    let data = make_pattern_data(500);
    let mut ds = DeflateStream::new(Z_DEFAULT_COMPRESSION);
    let compressed = ds.compress(&data);
    let decompressed = inflate_zlib(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "InflateStream one-shot" {
    let data = make_pattern_data(500);
    let mut ds = DeflateStream::new(Z_DEFAULT_COMPRESSION);
    let compressed = ds.compress(&data);
    let is = InflateStream::new();
    let decompressed = is.decompress(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "DeflateStream chunked update/finish" {
    let data = make_pattern_data(500);
    let mut chunk1: Array<u8> = Array::<u8>::with_capacity(200);
    for let mut i = 0; i < 200; i += 1 {
        chunk1.append(data[i]);
    }
    let mut chunk2: Array<u8> = Array::<u8>::with_capacity(300);
    for let mut i = 200; i < 500; i += 1 {
        chunk2.append(data[i]);
    }

    let mut ds = DeflateStream::new(Z_DEFAULT_COMPRESSION);
    ds.update(&chunk1);
    ds.update(&chunk2);
    let compressed = ds.finish();
    let decompressed = inflate_zlib(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "InflateStream chunked update/finish" {
    let data = make_pattern_data(500);
    let mut ds = DeflateStream::new(Z_DEFAULT_COMPRESSION);
    let compressed = ds.compress(&data);

    let half = compressed.len() / 2;
    let mut c1: Array<u8> = Array::<u8>::with_capacity(half);
    for let mut i = 0; i < half; i += 1 {
        c1.append(compressed[i]);
    }
    let mut c2: Array<u8> = Array::<u8>::with_capacity(compressed.len() - half);
    for let mut i = half; i < compressed.len(); i += 1 {
        c2.append(compressed[i]);
    }

    let mut is = InflateStream::new();
    is.update(&c1);
    is.update(&c2);
    let decompressed = is.finish();
    assert bytes_equal(&data, &decompressed);
}

test "DeflateStream preset dictionary" {
    let dict = string_to_bytes("common pattern data ");
    let data = string_to_bytes("common pattern data here");

    let mut ds = DeflateStream::new(Z_DEFAULT_COMPRESSION);
    ds.set_dictionary(&dict);
    let compressed = ds.compress(&data);

    let mut is = InflateStream::new();
    is.set_dictionary(&dict);
    let decompressed = is.decompress(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "DeflateStream with different level" {
    let data = make_pattern_data(500);
    let mut ds = DeflateStream::new(Z_BEST_SPEED);
    let compressed = ds.compress(&data);
    let decompressed = inflate_zlib(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "stream raw format round-trip" {
    let data = make_pattern_data(200);
    let mut ds = DeflateStream::new_with_format(Z_DEFAULT_COMPRESSION, RAW_FORMAT);
    let compressed = ds.compress(&data);
    assert compressed[0] != 0x78 as u8, "raw stream should not have zlib header";

    let is = InflateStream::new_with_format(RAW_FORMAT);
    let decompressed = is.decompress(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "stream gzip format round-trip" {
    let data = make_pattern_data(200);
    let mut ds = DeflateStream::new_with_format(Z_DEFAULT_COMPRESSION, GZIP_FORMAT);
    let compressed = ds.compress(&data);
    assert compressed[0] == 0x1F as u8, "gzip magic 1";
    assert compressed[1] == 0x8B as u8, "gzip magic 2";

    let is = InflateStream::new_with_format(GZIP_FORMAT);
    let decompressed = is.decompress(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "stream auto-detect zlib" {
    let data = make_pattern_data(200);
    let mut ds = DeflateStream::new(Z_DEFAULT_COMPRESSION);
    let compressed = ds.compress(&data);

    let is = InflateStream::new_with_format(AUTO_FORMAT);
    let decompressed = is.decompress(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "stream auto-detect gzip" {
    let data = make_pattern_data(200);
    let mut ds = DeflateStream::new_with_format(Z_DEFAULT_COMPRESSION, GZIP_FORMAT);
    let compressed = ds.compress(&data);

    let is = InflateStream::new_with_format(AUTO_FORMAT);
    let decompressed = is.decompress(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "DeflateStream reset" {
    let data = make_pattern_data(200);
    let mut ds = DeflateStream::new(Z_DEFAULT_COMPRESSION);
    let c1 = ds.compress(&data);
    ds.reset();
    let c2 = ds.compress(&data);
    assert c1.len() == c2.len(), "reset should produce same-size output";
}

test "DeflateStream copy" {
    let data = make_pattern_data(200);
    let mut ds = DeflateStream::new(Z_DEFAULT_COMPRESSION);
    ds.update(&data);
    let ds_clone = ds.copy();
    let f1 = ds.finish();
    let f2 = ds_clone.finish();
    assert f1.len() == f2.len(), "copy should produce same-size output";
}

test "zlib_version is non-empty" {
    let ver = zlib_version();
    assert ver.len() > 0;
}

test "compress_bound values" {
    assert compress_bound(0) > 0;
    assert compress_bound(100) > 100;
    assert compress_bound(65535) > 65535;
}

test "compress_bound is an upper bound" {
    let data = make_pattern_data(100);
    let compressed = compress2(&data, Z_DEFAULT_COMPRESSION);
    assert compressed.len() <= compress_bound(100);
}

test "uncompress round-trip" {
    let data = make_pattern_data(100);
    let compressed = compress2(&data, Z_DEFAULT_COMPRESSION);
    let decompressed = uncompress(&compressed);
    assert bytes_equal(&data, &decompressed);
}

test "uncompress2 with limit" {
    let data = make_pattern_data(100);
    let compressed = compress2(&data, Z_DEFAULT_COMPRESSION);
    let decompressed = uncompress2(&compressed, 200);
    assert bytes_equal(&data, &decompressed);
}
