test "inflate zlib empty" {
    let compressed: ByteList = [120, 156, 3, 0, 0, 0, 0, 1];
    let result = inflate_zlib(&compressed).unwrap();
    assert result.len() == 0;
}

test "stored block round-trip Hello" {
    let data: ByteList = [72, 101, 108, 108, 111];
    let compressed = zlib_compress(&data, Z_NO_COMPRESSION);
    let decompressed = inflate_zlib(&compressed).unwrap();
    assert decompressed == data;
}

test "Huffman round-trip Hello" {
    let data: ByteList = [72, 101, 108, 108, 111];
    let compressed = zlib_compress(&data);
    let decompressed = inflate_zlib(&compressed).unwrap();
    assert decompressed == data;
}

test "Huffman round-trip empty" {
    let data: ByteList = [];
    let compressed = zlib_compress(&data);
    let decompressed = inflate_zlib(&compressed).unwrap();
    assert decompressed.len() == 0;
}

test "Huffman round-trip repetitive data" {
    let data = make_repeated(65, 1000);
    let compressed = zlib_compress(&data);
    assert compressed.len() < data.len(), "repetitive data should compress";
    let decompressed = inflate_zlib(&compressed).unwrap();
    assert decompressed == data;
}

test "Huffman round-trip mixed data" {
    let data = make_pattern_data(500);
    let compressed = zlib_compress(&data);
    let decompressed = inflate_zlib(&compressed).unwrap();
    assert decompressed == data;
}

test "Huffman round-trip Hello World x20" {
    let unit: ByteList = [72, 101, 108, 108, 111, 44, 32, 87, 111, 114, 108, 100, 33, 32];
    let mut data = ByteList::with_capacity(280);
    for let mut j = 0; j < 20; j += 1 {
        data.extend(&unit);
    }
    let compressed = zlib_compress(&data);
    assert compressed.len() < data.len(), "repetitive text should compress";
    let decompressed = inflate_zlib(&compressed).unwrap();
    assert decompressed == data;
}

test "compress_bound exceeds source length" {
    let bound = compress_bound(1000);
    assert bound > 1000;
}

test "compression level 0 (stored) round-trip" {
    let data = make_pattern_data(1000);
    let compressed = zlib_compress(&data, Z_NO_COMPRESSION);
    let decompressed = inflate_zlib(&compressed).unwrap();
    assert decompressed == data;
}

test "compression level 1 (fastest) round-trip" {
    let data = make_pattern_data(1000);
    let compressed = zlib_compress(&data, Z_BEST_SPEED);
    let decompressed = inflate_zlib(&compressed).unwrap();
    assert decompressed == data;
}

test "compression level 6 (default) round-trip" {
    let data = make_pattern_data(1000);
    let compressed = zlib_compress(&data, Z_DEFAULT_COMPRESSION);
    let decompressed = inflate_zlib(&compressed).unwrap();
    assert decompressed == data;
}

test "compression level 9 (best) round-trip" {
    let data = make_pattern_data(1000);
    let compressed = zlib_compress(&data, Z_BEST_COMPRESSION);
    let decompressed = inflate_zlib(&compressed).unwrap();
    assert decompressed == data;
}

test "stored is larger than compressed" {
    let data = make_pattern_data(1000);
    let c0 = zlib_compress(&data, Z_NO_COMPRESSION);
    let c1 = zlib_compress(&data, Z_BEST_SPEED);
    assert c0.len() > c1.len();
}

test "stored block round-trip empty" {
    // RFC 1951 needs at least one block with BFINAL set, even for no data.
    let data: ByteList = [];
    let compressed = deflate_raw(&data, Z_NO_COMPRESSION);
    assert compressed.len() == 5;
    assert inflate_raw(&compressed).unwrap() == data;
    assert inflate_zlib(&zlib_compress(&data, Z_NO_COMPRESSION)).unwrap() == data;
}

test "a match deep in the hash chain is still found" {
    // A chain that self-links strands every older candidate behind the link, so
    // the walk reaches only the newest. That costs ratio, not validity, which
    // makes the guard a size bound: this input holds ~16.2 KB when the walk runs
    // to the end of a bucket and ~17.9 KB when it stops at the head.
    let data = make_wordy(60000);
    let compressed = deflate_raw(&data, 6);
    assert compressed.len() < 17000, `hash chain walk degraded: ${compressed.len()} bytes`;
    assert inflate_raw(&compressed).unwrap() == data;
}

test "default strategy never loses to fixed or stored" {
    // The encoder estimates all three costs and emits the cheapest, so its
    // output may never exceed either alternative.
    let inputs: List<ByteList> = [
        b"", b"a", b"Hello, world!", make_repeated(65, 3),
        make_repeated(65, 1000),
        make_pattern_data(1000),
        make_pattern_data(70000),
        make_incompressible(1000),
        make_incompressible(70000),
    ];
    for let data of &inputs {
        let chosen = deflate_raw(data, 6);
        let fixed = deflate_raw(data, 6, Z_FIXED);
        let stored = deflate_raw(data, 0);
        assert chosen.len() <= fixed.len();
        assert chosen.len() <= stored.len();
        assert inflate_raw(&chosen).unwrap() == *data;
    }
}

test "strategy Huffman-only round-trip" {
    let data = make_pattern_data(1000);
    let compressed = zlib_compress(&data, 6, Z_HUFFMAN_ONLY);
    let decompressed = inflate_zlib(&compressed).unwrap();
    assert decompressed == data;
}

test "strategy RLE round-trip" {
    let data = make_repeated(65, 1000);
    let compressed = zlib_compress(&data, 6, Z_RLE);
    let decompressed = inflate_zlib(&compressed).unwrap();
    assert decompressed == data;
}

test "strategy fixed round-trip" {
    let data = make_pattern_data(1000);
    let compressed = zlib_compress(&data, 6, Z_FIXED);
    let decompressed = inflate_zlib(&compressed).unwrap();
    assert decompressed == data;
}

test "raw deflate round-trip" {
    let data = b"Hello, raw deflate!";
    let compressed = deflate_raw(&data);
    assert compressed[0] != 0x78, "raw should not have zlib header";
    let decompressed = inflate_raw(&compressed).unwrap();
    assert decompressed == data;
}

test "raw deflate levels" {
    let data = b"Hello, raw deflate!";
    let c1 = deflate_raw(&data, Z_BEST_SPEED);
    assert inflate_raw(&c1).unwrap() == data;
    let c9 = deflate_raw(&data, Z_BEST_COMPRESSION);
    assert inflate_raw(&c9).unwrap() == data;
}

test "raw deflate large data" {
    let data = make_pattern_data(2000);
    let compressed = deflate_raw(&data);
    let decompressed = inflate_raw(&compressed).unwrap();
    assert decompressed == data;
}

test "gzip round-trip" {
    let data = b"Hello, gzip!";
    let compressed = gzip_compress(&data);
    assert compressed[0] == 0x1F, "gzip magic byte 1";
    assert compressed[1] == 0x8B, "gzip magic byte 2";
    assert compressed[2] == 8, "gzip method deflate";
    let decompressed = inflate_gzip(&compressed).unwrap();
    assert decompressed == data;
}

test "gzip compression levels" {
    let data = b"Hello, gzip!";
    let c1 = gzip_compress(&data, Z_BEST_SPEED);
    assert inflate_gzip(&c1).unwrap() == data;
    let c9 = gzip_compress(&data, Z_BEST_COMPRESSION);
    assert inflate_gzip(&c9).unwrap() == data;
}

test "gzip large data" {
    let data = make_pattern_data(5000);
    let compressed = gzip_compress(&data);
    let decompressed = inflate_gzip(&compressed).unwrap();
    assert decompressed == data;
}

test "gzip uncompress auto-detection" {
    let data = make_pattern_data(5000);
    let compressed = gzip_compress(&data);
    let decompressed = uncompress(&compressed).unwrap();
    assert decompressed == data;
}

test "gzip multi-member" {
    let seg1 = b"First member";
    let seg2 = b"Second member";
    let mut multi = gzip_compress(&seg1);
    multi.extend(&gzip_compress(&seg2));
    let mut expected = seg1;
    expected.extend(&seg2);
    assert inflate_gzip(&multi).unwrap() == expected;
}

test "DeflateStream one-shot" {
    let data = make_pattern_data(500);
    let mut ds = DeflateStream::new(Z_DEFAULT_COMPRESSION);
    let compressed = ds.compress(&data);
    let decompressed = inflate_zlib(&compressed).unwrap();
    assert decompressed == data;
}

test "InflateStream one-shot" {
    let data = make_pattern_data(500);
    let mut ds = DeflateStream::new(Z_DEFAULT_COMPRESSION);
    let compressed = ds.compress(&data);
    let is = InflateStream::new();
    let decompressed = is.decompress(&compressed).unwrap();
    assert decompressed == data;
}

test "DeflateStream chunked update/finish" {
    let data = make_pattern_data(500);
    let mut ds = DeflateStream::new(Z_DEFAULT_COMPRESSION);
    ds.update(&(data[0..<200].to_list() as ByteList));
    ds.update(&(data[200..<500].to_list() as ByteList));
    let compressed = ds.finish();
    let decompressed = inflate_zlib(&compressed).unwrap();
    assert decompressed == data;
}

test "InflateStream chunked update/finish" {
    let data = make_pattern_data(500);
    let mut ds = DeflateStream::new(Z_DEFAULT_COMPRESSION);
    let compressed = ds.compress(&data);

    let half = compressed.len() / 2;
    let mut is = InflateStream::new();
    is.update(&(compressed[0..<half].to_list() as ByteList));
    is.update(&(compressed[half..<compressed.len()].to_list() as ByteList));
    let decompressed = is.finish().unwrap();
    assert decompressed == data;
}

test "DeflateStream with different level" {
    let data = make_pattern_data(500);
    let mut ds = DeflateStream::new(Z_BEST_SPEED);
    let compressed = ds.compress(&data);
    let decompressed = inflate_zlib(&compressed).unwrap();
    assert decompressed == data;
}

test "stream raw format round-trip" {
    let data = make_pattern_data(200);
    let mut ds = DeflateStream::new(Z_DEFAULT_COMPRESSION, Z_DEFAULT_STRATEGY, RAW_FORMAT);
    let compressed = ds.compress(&data);
    assert compressed[0] != 0x78, "raw stream should not have zlib header";

    let is = InflateStream::new(RAW_FORMAT);
    let decompressed = is.decompress(&compressed).unwrap();
    assert decompressed == data;
}

test "stream gzip format round-trip" {
    let data = make_pattern_data(200);
    let mut ds = DeflateStream::new(Z_DEFAULT_COMPRESSION, Z_DEFAULT_STRATEGY, GZIP_FORMAT);
    let compressed = ds.compress(&data);
    assert compressed[0] == 0x1F, "gzip magic 1";
    assert compressed[1] == 0x8B, "gzip magic 2";

    let is = InflateStream::new(GZIP_FORMAT);
    let decompressed = is.decompress(&compressed).unwrap();
    assert decompressed == data;
}

test "stream auto-detect zlib" {
    let data = make_pattern_data(200);
    let mut ds = DeflateStream::new(Z_DEFAULT_COMPRESSION);
    let compressed = ds.compress(&data);

    let is = InflateStream::new(AUTO_FORMAT);
    let decompressed = is.decompress(&compressed).unwrap();
    assert decompressed == data;
}

test "stream auto-detect gzip" {
    let data = make_pattern_data(200);
    let mut ds = DeflateStream::new(Z_DEFAULT_COMPRESSION, Z_DEFAULT_STRATEGY, GZIP_FORMAT);
    let compressed = ds.compress(&data);

    let is = InflateStream::new(AUTO_FORMAT);
    let decompressed = is.decompress(&compressed).unwrap();
    assert decompressed == data;
}

test "DeflateStream reset" {
    let data = make_pattern_data(200);
    let mut ds = DeflateStream::new(Z_DEFAULT_COMPRESSION);
    let c1 = ds.compress(&data);
    ds.reset();
    let c2 = ds.compress(&data);
    assert c1.len() == c2.len(), "reset should produce same-size output";
}

test "DeflateStream copy" {
    let data = make_pattern_data(200);
    let mut ds = DeflateStream::new(Z_DEFAULT_COMPRESSION);
    ds.update(&data);
    let mut ds_clone = ds.copy();
    let f1 = ds.finish();
    let f2 = ds_clone.finish();
    assert f1.len() == f2.len(), "copy should produce same-size output";
}

test "zlib_version is non-empty" {
    let ver = zlib_version();
    assert ver.len() > 0;
}

test "compress_bound values" {
    assert compress_bound(0) > 0;
    assert compress_bound(100) > 100;
    assert compress_bound(65535) > 65535;
}

test "compress_bound is an upper bound" {
    let data = make_pattern_data(100);
    let compressed = zlib_compress(&data, Z_DEFAULT_COMPRESSION);
    assert compressed.len() <= compress_bound(100);
}

test "uncompress round-trip" {
    let data = make_pattern_data(100);
    let compressed = zlib_compress(&data, Z_DEFAULT_COMPRESSION);
    let decompressed = uncompress(&compressed).unwrap();
    assert decompressed == data;
}

test "uncompress with limit" {
    let data = make_pattern_data(100);
    let compressed = zlib_compress(&data, Z_DEFAULT_COMPRESSION);
    let decompressed = uncompress(&compressed, 200).unwrap();
    assert decompressed == data;
}

test "uncompress with limit (exceeded)" {
    let data = make_pattern_data(100);
    let compressed = zlib_compress(&data, Z_DEFAULT_COMPRESSION);
    let result = uncompress(&compressed, 50);
    assert result matches { Err(ZlibError::OutputExceedsMax) };
}

test "every inflate entry point stops once its output would pass max_output" {
    let data = make_pattern_data(4096);
    let raw = deflate_raw(&data);
    let zlib = zlib_compress(&data);
    let gz = gzip_compress(&data);
    assert inflate_raw(&raw, 4096) matches { Ok(out) && out == data };
    assert inflate_raw(&raw, 4095) matches { Err(ZlibError::OutputExceedsMax) };
    assert inflate_zlib(&zlib, 4096) matches { Ok(out) && out == data };
    assert inflate_zlib(&zlib, 4095) matches { Err(ZlibError::OutputExceedsMax) };
    assert inflate_gzip(&gz, 4096) matches { Ok(out) && out == data };
    assert inflate_gzip(&gz, 4095) matches { Err(ZlibError::OutputExceedsMax) };
    assert uncompress(&gz, 4095) matches { Err(ZlibError::OutputExceedsMax) };
    assert InflateStream::new(RAW_FORMAT).decompress(&raw, 4095) matches { Err(ZlibError::OutputExceedsMax) };
    let mut stream = InflateStream::new();
    stream.update(&zlib);
    assert stream.finish(4095) matches { Err(ZlibError::OutputExceedsMax) };
}

// RFC 1951 3.2.3 / 3.2.4: stored bytes, literals and back-references each grow
// the output, so each is held to the limit.
test "max_output holds stored, literal and match output alike" {
    let data = make_pattern_data(1000);
    let stored = deflate_stored(&data);
    assert inflate_raw(&stored, 999) matches { Err(ZlibError::OutputExceedsMax) };
    assert inflate_raw(&stored, 1000) matches { Ok(out) && out == data };
    let literals_then_match: ByteList = [0x73, 0x74, 0x02, 0x43, 0x00];  // "AB" + <5, 2>
    assert inflate_raw(&literals_then_match, 1) matches { Err(ZlibError::OutputExceedsMax) };
    assert inflate_raw(&literals_then_match, 6) matches { Err(ZlibError::OutputExceedsMax) };
    assert inflate_raw(&literals_then_match, 7) matches { Ok(out) && out.len() == 7 };
}

test "a zero max_output admits only an empty output" {
    let literals: ByteList = [0x73, 0x74, 0x02, 0x43, 0x00];
    let empty_fixed: ByteList = [0x03, 0x00];
    assert inflate_raw(&literals, 0) matches { Err(ZlibError::OutputExceedsMax) };
    assert inflate_raw(&empty_fixed, 0) matches { Ok(out) && out.len() == 0 };
}

#[expect_trap]
test "a negative max_output is a caller's error" {
    let empty_fixed: ByteList = [0x03, 0x00];
    let _ = inflate_raw(&empty_fixed, -1);
}

test "max_output bounds all gzip members together" {
    let data = make_pattern_data(100);
    let mut members = gzip_compress(&data);
    for let b of gzip_compress(&data) {
        members.push(b);
    }
    assert inflate_gzip(&members, 200) matches { Ok(out) && out.len() == 200 };
    assert inflate_gzip(&members, 199) matches { Err(ZlibError::OutputExceedsMax) };
}

// RFC 1951 3.2.3: BTYPE=11 is reserved; a stream cut short never ends its block.
test "inflate_raw reports a malformed stream" {
    let reserved: ByteList = [0x07];
    let truncated: ByteList = [0x01, 0x05, 0x00, 0xFA, 0xFF, 72];
    assert inflate_raw(&reserved) matches { Err(ZlibError::InvalidDeflateData) };
    assert inflate_raw(&truncated) matches { Err(ZlibError::InvalidDeflateData) };
}

test "round-trip large data (>32KB window boundary)" {
    // Regression: inflate_zlib failed for data exceeding the 32KB LZ77 window
    let data = make_pattern_data(34054);
    let compressed = zlib_compress(&data);
    let decompressed = inflate_zlib(&compressed).unwrap();
    assert decompressed.len() == 34054, "decompressed size mismatch";
    assert decompressed == data;
}

test "round-trip 100KB data" {
    let data = make_pattern_data(100000);
    let compressed = zlib_compress(&data);
    let decompressed = inflate_zlib(&compressed).unwrap();
    assert decompressed.len() == 100000, "decompressed size mismatch";
    assert decompressed == data;
}

test "inflate_zlib error on invalid data" {
    let bad: ByteList = [0, 0];
    assert inflate_zlib(&bad) matches { Err(_) };
}

test "inflate_gzip error on invalid data" {
    let bad: ByteList = [0, 0];
    assert inflate_gzip(&bad) matches { Err(_) };
}

// Returns a reference gzip member for "hello world", produced by a standard
// zlib and used by the gzip rejection tests below.
fn gzip_hello_world() -> ByteList {
    return [
        31, 139, 8, 0, 0, 0, 0, 0, 2, 255, 203, 72, 205, 201, 201, 87, 40, 207, 47, 202, 73, 1, 0, 133, 17, 74, 13, 11,
        0, 0, 0,
    ];
}

// ---------------------------------------------------------------------------
// RFC-anchored decode vectors.
//
// RFC 1950/1951/1952 specify only the bitstream formats and ship no
// conformance vectors. The tests below are hand-built streams, each
// independently verified against a reference zlib, that exercise format
// corners the random round-trip tests above rarely reach. Each case cites the
// relevant RFC section (texts kept under wado-compiler/ref/).
// ---------------------------------------------------------------------------

// RFC 1951 section 3.2.4: one final stored block (BFINAL=1, BTYPE=00), then
// LEN=5 and NLEN=~5, then the five literal bytes of "Hello".
test "inflate raw stored block (RFC 1951 3.2.4)" {
    let stream: ByteList = [0x01, 0x05, 0x00, 0xFA, 0xFF, 72, 101, 108, 108, 111];
    assert inflate_raw(&stream).unwrap() == b"Hello";
}

// RFC 1951 section 3.2.4: an empty final stored block (LEN=0, NLEN=0xFFFF).
test "inflate raw empty stored block (RFC 1951 3.2.4)" {
    let stream: ByteList = [0x01, 0x00, 0x00, 0xFF, 0xFF];
    assert inflate_raw(&stream).unwrap().len() == 0;
}

// RFC 1951 section 3.2.3: an overlapping back-reference. After the literals
// "AB", a <length=5, distance=2> copy overlaps the current position and adds
// A,B,A,B,A, producing "ABABABA" (the X,Y overlap example in the RFC).
// Encoded with fixed Huffman codes (BTYPE=01).
test "inflate raw overlapping match (RFC 1951 3.2.3)" {
    let stream: ByteList = [0x73, 0x74, 0x02, 0x43, 0x00];
    let expected: ByteList = [65, 66, 65, 66, 65, 66, 65];  // "ABABABA"
    assert inflate_raw(&stream).unwrap() == expected;
}

// RFC 1951 section 3.2.5: the maximum match length, 258, encoded with length
// code 285. Here a run of 259 identical bytes under fixed Huffman.
test "inflate raw max-length match (RFC 1951 3.2.5)" {
    let stream: ByteList = [139, 138, 26, 241, 0, 0];
    let out = inflate_raw(&stream).unwrap();
    assert out.len() == 259;
    for let mut i = 0; i < 259; i += 1 {
        assert out[i] == 90;  // 'Z'
    }
}

// RFC 1951 section 3.2.7: a dynamic Huffman block (BTYPE=10). Exercises the
// code-length code alphabet and the literal/length and distance tables built
// from it, which the stored/fixed cases above never touch.
test "inflate raw dynamic Huffman block (RFC 1951 3.2.7)" {
    let stream: ByteList = [
        77, 141, 193, 13, 195, 48, 12, 3, 87, 225, 4, 222, 163, 143, 252, 218, 1, 148, 136, 117, 4, 56, 114, 96, 27, 14,
        178, 125, 133, 188, 250, 33, 64, 145, 212, 189, 28, 99, 39, 86, 102, 115, 55, 207, 143, 251, 184, 77, 182, 78,
        92, 210, 177, 53, 202, 160, 38, 188, 119, 235, 216, 227, 114, 136, 18, 130, 82, 7, 234, 23, 39, 235, 89, 136, 24,
        220, 16, 207, 143, 106, 60, 164, 227, 50, 101, 185, 209, 152, 165, 41, 21, 177, 21, 172, 162, 56, 234, 100, 194,
        34, 30, 161, 108, 236, 81, 47, 198, 201, 160, 203, 128, 141, 127, 48, 214, 27, 189, 30, 12, 105, 15, 48, 87, 77,
        63,
    ];
    let text = "In the beginning the Universe was created. This has made a lot of people very angry and been widely regarded as a bad move. Many races believe that it was created by some sort of god.";
    let out = inflate_raw(&stream).unwrap();
    assert out.len() == 183;
    assert out == text.bytes().collect();
}

// RFC 1951 section 3.2.3: a distance cannot refer past the beginning of the
// output. A fixed block (0x03) opening with <length=3, distance=1> (0x02) at
// output position 0. Padded, the stream is long enough for the decoder's fast
// loop; unpadded, the byte-at-a-time path sees it.
test "a distance before the start of the output is rejected" {
    let unpadded: ByteList = [0x03, 0x02];
    let padded: ByteList = [0x03, 0x02, 0, 0, 0, 0, 0, 0, 0, 0];
    assert inflate_raw(&unpadded) matches { Err(ZlibError::InvalidDeflateData) };
    assert inflate_raw(&padded) matches { Err(ZlibError::InvalidDeflateData) };
}

// The decoder switches from its fast loop to the byte-at-a-time path near the
// end of the input, so a cut at every length crosses that handoff.
test "a stream cut at any length is rejected" {
    let raw = deflate_raw(&make_wordy(2000));
    for let mut n = 0; n < raw.len(); n += 1 {
        let cut = raw[0..<n].to_list() as ByteList;
        assert inflate_raw(&cut) matches { Err(ZlibError::InvalidDeflateData) }, `cut at ${n}`;
    }
}

test "max_output holds at every limit" {
    let data = make_wordy(600);
    let raw = deflate_raw(&data);
    for let mut limit = 0; limit < data.len(); limit += 1 {
        assert inflate_raw(&raw, limit) matches { Err(ZlibError::OutputExceedsMax) }, `limit ${limit}`;
    }
    assert inflate_raw(&raw, data.len()) matches { Ok(out) && out == data };
}

// The fast loop reads input ahead of the bits it decodes; the next member's
// header starts where the first member's trailer ends, so it must hand back
// every byte it did not decode.
test "gzip members after a long member decode in place" {
    let first = make_wordy(5000);
    let second = make_wordy(3000);
    let mut members = gzip_compress(&first);
    members.extend(&gzip_compress(&second));
    let mut expected = first;
    expected.extend(&second);
    assert inflate_gzip(&members).unwrap() == expected;
}

// The malformed streams below are ones no encoder emits, so they are written
// field by field with the encoder's own BitWriter.

fn huffman(w: &mut BitWriter, code: i32, n: i32) {
    w.write_bits(bi_reverse(code as u32, n), n);
}

fn open_fixed_block(w: &mut BitWriter) {
    w.write_bits(1, 1);
    w.write_bits(1, 2);
}

// A final dynamic block (RFC 1951 section 3.2.7) whose code length code gives
// `lengths[symbol]` bits to each code length symbol.
fn open_dynamic_block(w: &mut BitWriter, nlen: i32, ndist: i32, lengths: &List<i32>) {
    let order: List<i32> = [16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15];
    let mut ncode = 4;
    for let mut i = 0; i < 19; i += 1 {
        if lengths[order[i]] != 0 {
            ncode = i32::max(ncode, i + 1);
        }
    }
    w.write_bits(1, 1);
    w.write_bits(2, 2);
    w.write_bits((nlen - 257) as u32, 5);
    w.write_bits((ndist - 1) as u32, 5);
    w.write_bits((ncode - 4) as u32, 4);
    for let mut i = 0; i < ncode; i += 1 {
        w.write_bits(lengths[order[i]] as u32, 3);
    }
}

// The stream so far, its last byte zero-filled, then `padding` zero bytes.
fn finish(w: &BitWriter, padding: i32) -> ByteList {
    let mut flushed = *w;
    flushed.flush();
    let mut out = flushed.output;
    out.extend(&make_repeated(0, padding));
    return out;
}

fn rejects(w: &BitWriter, padding: i32) -> bool {
    return inflate_raw(&finish(w, padding)) matches { Err(ZlibError::InvalidDeflateData) };
}

// A code length code giving one bit each to two code length symbols, whose
// canonical codes are then 0 for `a` and 1 for `b`.
fn two_symbol_code_lengths(a: i32, b: i32) -> List<i32> {
    let mut lengths = List::filled(19, 0);
    lengths[a] = 1;
    lengths[b] = 1;
    return lengths;
}

// RFC 1951 section 3.2.6: literal/length codes 286 and 287 "will never
// actually occur in the compressed data". Unpadded, the byte-at-a-time path
// decodes the stream; padded, the fast loop does.
test "literal/length codes 286 and 287 are rejected" {
    let symbols: List<i32> = [286, 287];
    for let symbol of symbols {
        let mut w = BitWriter::new();
        open_fixed_block(&mut w);
        huffman(&mut w, 0b11000000 + symbol - 280, 8);
        assert rejects(&w, 0), `${symbol} unpadded`;
        assert rejects(&w, 8), `${symbol} padded`;
    }
}

// RFC 1951 section 3.2.6: distance codes 30 and 31 "will never actually occur
// in the compressed data". Each follows length code 257.
test "distance codes 30 and 31 are rejected" {
    let symbols: List<i32> = [30, 31];
    for let symbol of symbols {
        let mut w = BitWriter::new();
        open_fixed_block(&mut w);
        huffman(&mut w, 1, 7);
        huffman(&mut w, symbol, 5);
        assert rejects(&w, 0), `${symbol} unpadded`;
        assert rejects(&w, 8), `${symbol} padded`;
    }
}

// RFC 1951 section 3.2.4: LEN and NLEN take four bytes after the header byte.
test "a stored block cut inside LEN or NLEN is rejected" {
    let cut_in_len: ByteList = [0x01, 0x05];
    let cut_in_nlen: ByteList = [0x01, 0x05, 0x00, 0xFA];
    assert inflate_raw(&cut_in_len) matches { Err(ZlibError::InvalidDeflateData) };
    assert inflate_raw(&cut_in_nlen) matches { Err(ZlibError::InvalidDeflateData) };
}

// RFC 1951 section 3.2.4: "NLEN is the one's complement of LEN".
test "a stored block whose NLEN is not LEN's complement is rejected" {
    let stream: ByteList = [0x01, 0x05, 0x00, 0x05, 0x00, 72, 101, 108, 108, 111];
    assert inflate_raw(&stream) matches { Err(ZlibError::InvalidDeflateData) };
}

// RFC 1951 section 3.2.7: HLIT counts at most 286 codes and HDIST at most 30,
// though the five-bit fields reach 288 and 32.
test "a dynamic block counting more codes than the alphabet has is rejected" {
    let lengths = two_symbol_code_lengths(0, 16);
    let mut too_many_lengths = BitWriter::new();
    open_dynamic_block(&mut too_many_lengths, 287, 1, &lengths);
    let mut too_many_distances = BitWriter::new();
    open_dynamic_block(&mut too_many_distances, 257, 31, &lengths);
    assert rejects(&too_many_lengths, 4);
    assert rejects(&too_many_distances, 4);
}

// Four one-bit codes cannot all be told apart.
test "an over-subscribed code length code is rejected" {
    let mut lengths = List::filled(19, 0);
    lengths[16] = 1;
    lengths[17] = 1;
    lengths[18] = 1;
    lengths[0] = 1;
    let mut w = BitWriter::new();
    open_dynamic_block(&mut w, 257, 1, &lengths);
    assert rejects(&w, 4);
}

// RFC 1951 section 3.2.7: code 16 copies "the previous code length", which the
// first length does not have.
test "a repeat before any code length is rejected" {
    let mut w = BitWriter::new();
    open_dynamic_block(&mut w, 257, 1, &two_symbol_code_lengths(0, 16));
    huffman(&mut w, 1, 1);
    w.write_bits(0, 2);
    assert rejects(&w, 4);
}

test "a block without an end-of-block code is rejected" {
    let mut w = BitWriter::new();
    open_dynamic_block(&mut w, 257, 1, &two_symbol_code_lengths(0, 16));
    for let mut i = 0; i < 258; i += 1 {
        huffman(&mut w, 0, 1);
    }
    assert rejects(&w, 4);
}

test "an over-subscribed literal/length code is rejected" {
    let mut w = BitWriter::new();
    open_dynamic_block(&mut w, 257, 1, &two_symbol_code_lengths(0, 1));
    for let mut i = 0; i < 258; i += 1 {
        huffman(&mut w, 1, 1);
    }
    assert rejects(&w, 4);
}

// The literal/length code is complete, one bit each for literal 0 and
// end-of-block, and the distance code gives one bit each to three distances.
test "an over-subscribed distance code is rejected" {
    let mut w = BitWriter::new();
    open_dynamic_block(&mut w, 257, 3, &two_symbol_code_lengths(0, 1));
    huffman(&mut w, 1, 1);
    for let mut i = 1; i < 256; i += 1 {
        huffman(&mut w, 0, 1);
    }
    for let mut i = 0; i < 4; i += 1 {
        huffman(&mut w, 1, 1);
    }
    assert rejects(&w, 4);
}

// A lone two-bit code leaves half the code space unused. RFC 1951 section
// 3.2.7 allows an incomplete code only for a single one-bit distance code.
test "an incomplete literal/length code is rejected" {
    let mut w = BitWriter::new();
    open_dynamic_block(&mut w, 257, 1, &two_symbol_code_lengths(0, 2));
    for let mut i = 0; i < 256; i += 1 {
        huffman(&mut w, 0, 1);
    }
    huffman(&mut w, 1, 1);
    huffman(&mut w, 0, 1);
    assert rejects(&w, 4);
}

// RFC 1951 section 3.2.7: "One distance code of zero bits means that there are
// no distance codes used at all (the data is all literals)."
test "a block of literals may give every distance a zero length" {
    let mut w = BitWriter::new();
    open_dynamic_block(&mut w, 257, 1, &two_symbol_code_lengths(0, 1));
    for let mut symbol = 0; symbol < 257; symbol += 1 {
        huffman(&mut w, if symbol == 65 || symbol == 256 { 1 } else { 0 }, 1);
    }
    huffman(&mut w, 0, 1);
    huffman(&mut w, 0, 1);
    huffman(&mut w, 0, 1);
    huffman(&mut w, 1, 1);
    let expected: ByteList = [65, 65];
    assert inflate_raw(&finish(&w, 0)) matches { Ok(out) && out == expected };
}

// RFC 1950 section 2.2: FCHECK requires CMF*256+FLG to be a multiple of 31.
test "inflate zlib rejects bad FCHECK (RFC 1950 2.2)" {
    let bad: ByteList = [0x78, 0x00, 0, 0, 0, 0];
    assert inflate_zlib(&bad) matches { Err(ZlibError::InvalidHeader) };
}

// RFC 1950 section 2.2: CM must be 8 (deflate). Here CM=9 with a valid FCHECK.
test "inflate zlib rejects bad CM (RFC 1950 2.2)" {
    let bad: ByteList = [0x79, 0x18, 0, 0, 0, 0];
    assert inflate_zlib(&bad) matches { Err(ZlibError::UnsupportedCompressionMethod) };
}

// RFC 1950 section 2.2: FDICT set requests a preset dictionary (unsupported).
test "inflate zlib rejects preset dictionary (RFC 1950 2.2)" {
    let bad: ByteList = [0x78, 0x20, 0, 0, 0, 0];
    assert inflate_zlib(&bad) matches { Err(ZlibError::PresetDictionaryNotSupported) };
}

// A zlib stream shorter than header(2) + trailer(4) cannot be valid.
test "inflate zlib rejects truncated stream (RFC 1950 2.2)" {
    let bad: ByteList = [0x78, 0x9C];
    assert inflate_zlib(&bad) matches { Err(ZlibError::DataTooShort) };
}

// RFC 1951 section 3.2.3: BTYPE=11 is reserved. The DEFLATE body here is the
// single byte 0x07 = BFINAL=1, BTYPE=11. The stream must be rejected as
// malformed, not silently decoded as empty even though the trailer holds the
// Adler-32 of empty output (1).
test "inflate zlib rejects reserved block type (RFC 1951 3.2.3)" {
    let bad: ByteList = [0x78, 0x01, 0x07, 0, 0, 0, 1];
    assert inflate_zlib(&bad) matches { Err(ZlibError::InvalidDeflateData) };
}

// A zlib stream whose DEFLATE body ends before its final block's end-of-block
// code is malformed. 0x63 opens a fixed-Huffman block (BFINAL=1, BTYPE=01)
// with no room left to encode an end-of-block.
test "inflate zlib rejects truncated deflate body (RFC 1951 3.2.3)" {
    let bad: ByteList = [0x78, 0x01, 0x63, 0, 0, 0, 1];
    assert inflate_zlib(&bad) matches { Err(ZlibError::InvalidDeflateData) };
}

// RFC 1952: a complete reference gzip member decodes to its original bytes.
test "inflate gzip reference member (RFC 1952)" {
    let gz = gzip_hello_world();
    assert inflate_gzip(&gz).unwrap() == b"hello world";
}

// RFC 1952 section 2.3.1: the CRC32 trailer must match the uncompressed data.
test "inflate gzip rejects CRC mismatch (RFC 1952 2.3.1)" {
    let mut gz = gzip_hello_world();
    gz[23] ^= 0xFF;  // corrupt the first CRC32 byte
    assert inflate_gzip(&gz) matches { Err(ZlibError::Crc32Mismatch) };
}

// RFC 1952 section 2.3.1: the ISIZE trailer must equal the output length.
test "inflate gzip rejects ISIZE mismatch (RFC 1952 2.3.1)" {
    let mut gz = gzip_hello_world();
    gz[27] = 12;  // claim 12 output bytes instead of 11; CRC32 still valid
    assert inflate_gzip(&gz) matches { Err(ZlibError::IsizeMismatch) };
}

// A gzip stream cut off inside its 8-byte trailer is truncated.
test "inflate gzip rejects truncated trailer (RFC 1952 2.3.1)" {
    let gz = gzip_hello_world();
    let mut cut = ByteList::with_capacity(gz.len() - 4);
    for let mut i = 0; i < gz.len() - 4; i += 1 {
        cut.push(gz[i]);
    }
    assert inflate_gzip(&cut) matches { Err(ZlibError::TruncatedTrailer) };
}

test "gzip header preserves UTF-8 name and comment" {
    let mut header = GzipHeader::new();
    header.set_name("café_日本語.txt");
    header.set_comment("コメント 😀");

    let data = b"payload";
    let compressed = gzip_compress(&data, Z_DEFAULT_COMPRESSION, Z_DEFAULT_STRATEGY, &header);

    let parsed = inflate_get_gzip_header(&compressed).unwrap();
    assert parsed.name() == "café_日本語.txt", "FNAME must round-trip as UTF-8";
    assert parsed.comment() == "コメント 😀", "FCOMMENT must round-trip as UTF-8";

    // The body still inflates correctly with non-ASCII header fields present.
    assert inflate_gzip(&compressed).unwrap() == data;
}

test "ZlibError renders its reason" {
    assert `${uncompress(&([1 as u8] as ByteList)).unwrap_err()}` == "input is shorter than the smallest valid stream";
}

test "every ZlibError renders a distinct reason" {
    let errors: List<ZlibError> = [
        ZlibError::DataTooShort, ZlibError::InvalidHeader, ZlibError::InvalidMagicNumber,
        ZlibError::UnsupportedCompressionMethod, ZlibError::PresetDictionaryNotSupported, ZlibError::Adler32Mismatch,
        ZlibError::Crc32Mismatch, ZlibError::TruncatedExtraField, ZlibError::HeaderExtendsPastEnd,
        ZlibError::TruncatedTrailer, ZlibError::IsizeMismatch, ZlibError::OutputExceedsMax,
        ZlibError::InvalidDeflateData,
    ];
    let mut reasons: List<String> = [];
    for let error of errors {
        let reason = `${error}`;
        assert reason.len() > 0 && !reasons.contains(&reason), reason;
        reasons.push(reason);
    }
}

test "combined checksums match the whole at every split" {
    let data = make_incompressible(70000);
    let whole_adler = adler32(adler32_init(), &data, 0, data.len());
    let whole_crc = crc32(crc32_init(), &data, 0, data.len());
    let splits: List<i32> = [0, 1, 2, 3, 100, 4096, 65520, 65521, 65522, 69000, 69998, 69999, 70000];
    for let split of splits {
        let rest = data.len() - split;
        let adler_head = adler32(adler32_init(), &data, 0, split);
        let adler_tail = adler32(adler32_init(), &data, split, rest);
        assert adler32_combine(adler_head, adler_tail, rest) == whole_adler, `Adler-32 split at ${split}`;
        let crc_head = crc32(crc32_init(), &data, 0, split);
        let crc_tail = crc32(crc32_init(), &data, split, rest);
        assert crc32_combine(crc_head, crc_tail, rest) == whole_crc, `CRC-32 split at ${split}`;
    }

    // Bytes summing to 65520 leave Adler-32's low sum at 1 + 65520 = 0 mod 65521.
    let mut wraps = make_repeated(255, 256);
    wraps.push(240);
    let mut twice = wraps;
    twice.extend(&wraps);
    let wraps_adler = adler32(adler32_init(), &wraps, 0, wraps.len());
    assert wraps_adler & 0xFFFF == 0;
    assert adler32_combine(wraps_adler, wraps_adler, wraps.len()) == adler32(adler32_init(), &twice, 0, twice.len());
}

test "inflate zlib rejects an Adler-32 mismatch (RFC 1950 2.2)" {
    let mut stream = zlib_compress(&make_wordy(300));
    let last = stream.len() - 1;
    stream[last] ^= 1;
    assert inflate_zlib(&stream) matches { Err(ZlibError::Adler32Mismatch) };
}

// Past 32 KiB a match candidate can fall outside the window, and each level
// walks its hash chains under its own limits.
test "every level and strategy round-trips input longer than the window" {
    let data = make_wordy(70000);
    for let mut level = 0; level <= 9; level += 1 {
        for let mut strategy = 0; strategy <= 4; strategy += 1 {
            let raw = deflate_raw(&data, level, strategy);
            assert inflate_raw(&raw) matches { Ok(out) && out == data }, `level ${level} strategy ${strategy}`;
        }
        assert uncompress(&zlib_compress(&data, level)) matches { Ok(out) && out == data }, `zlib level ${level}`;
    }
}

// Byte k appears fib(k + 2) times, and the end-of-block code once, so the
// frequencies are the Fibonacci numbers: the distribution that gives the deepest
// Huffman tree. Its 23 codes want up to 22 bits, and DEFLATE allows 15.
test "a Fibonacci-skewed distribution round-trips with codes limited to 15 bits" {
    let mut data: ByteList = [];
    let mut count = 1;
    let mut next = 2;
    for let mut k = 0; k < 22; k += 1 {
        data.extend(&make_repeated(k as u8, count));
        let sum = count + next;
        count = next;
        next = sum;
    }
    let raw = deflate_raw(&data, Z_DEFAULT_COMPRESSION, Z_HUFFMAN_ONLY);
    assert inflate_raw(&raw) matches { Ok(out) && out == data };
}

test "a default gzip header sets no optional field" {
    let header = inflate_get_gzip_header(&gzip_compress(&make_wordy(100))).unwrap();
    assert !header.text() && !header.hcrc();
    assert header.time() == 0 && header.os() == 0xFF;
    assert header.extra().len() == 0 && header.name() == "" && header.comment() == "";
}

test "every gzip header field round-trips" {
    let mut header = GzipHeader::new();
    header.set_text(true);
    header.set_time(1700000000);
    header.set_os(3);
    let extra: ByteList = [0x41, 0x70, 2, 0, 7, 9];
    header.set_extra(&extra);
    header.set_name("data.json");
    header.set_comment("fixture");
    header.set_hcrc(true);
    let data = make_wordy(800);
    let levels: List<i32> = [Z_BEST_SPEED, Z_DEFAULT_COMPRESSION, Z_BEST_COMPRESSION];
    for let level of levels {
        let member = gzip_compress(&data, level, Z_DEFAULT_STRATEGY, &header);
        let parsed = inflate_get_gzip_header(&member).unwrap();
        assert parsed.text() && parsed.hcrc(), `level ${level}`;
        assert parsed.time() == 1700000000 && parsed.os() == 3, `level ${level}`;
        assert parsed.extra() == extra, `level ${level}`;
        assert parsed.name() == "data.json" && parsed.comment() == "fixture", `level ${level}`;
        assert inflate_gzip(&member) matches { Ok(out) && out == data }, `level ${level}`;
    }

    let mut stream = DeflateStream::new(Z_DEFAULT_COMPRESSION, Z_DEFAULT_STRATEGY, GZIP_FORMAT);
    stream.set_header(&header);
    let streamed = stream.compress(&data);
    assert inflate_get_gzip_header(&streamed) matches { Ok(parsed) && parsed.name() == "data.json" };
    assert inflate_gzip(&streamed) matches { Ok(out) && out == data };
}

// RFC 1952 section 2.3.1: ID1, ID2, CM and FLG open the member, and FEXTRA
// puts a two-byte XLEN after the ten fixed bytes.
test "a malformed gzip header is rejected" {
    let too_short: ByteList = [0x1F, 0x8B, 8, 0, 0, 0, 0, 0, 0];
    let wrong_magic: ByteList = [0x1F, 0x8C, 8, 0, 0, 0, 0, 0, 0, 0xFF, 3, 0];
    let wrong_method: ByteList = [0x1F, 0x8B, 7, 0, 0, 0, 0, 0, 0, 0xFF, 3, 0];
    let cut_in_xlen: ByteList = [0x1F, 0x8B, 8, 4, 0, 0, 0, 0, 0, 0xFF, 5];
    assert inflate_get_gzip_header(&too_short) matches { Err(ZlibError::DataTooShort) };
    assert inflate_gzip(&too_short) matches { Err(ZlibError::DataTooShort) };
    assert inflate_get_gzip_header(&wrong_magic) matches { Err(ZlibError::InvalidMagicNumber) };
    assert inflate_gzip(&wrong_method) matches { Err(ZlibError::UnsupportedCompressionMethod) };
    assert inflate_get_gzip_header(&cut_in_xlen) matches { Err(ZlibError::TruncatedExtraField) };
    assert inflate_gzip(&cut_in_xlen) matches { Err(ZlibError::TruncatedExtraField) };
}

test "a gzip header running past the end of the input is rejected" {
    let unterminated_name: ByteList = [0x1F, 0x8B, 8, 8, 0, 0, 0, 0, 0, 0xFF, 0x61, 0x62];
    let extra_past_end: ByteList = [0x1F, 0x8B, 8, 4, 0, 0, 0, 0, 0, 0xFF, 9, 0, 1, 2];
    let crc_past_end: ByteList = [0x1F, 0x8B, 8, 2, 0, 0, 0, 0, 0, 0xFF, 0x12];
    assert inflate_gzip(&unterminated_name) matches { Err(ZlibError::HeaderExtendsPastEnd) };
    assert inflate_gzip(&extra_past_end) matches { Err(ZlibError::HeaderExtendsPastEnd) };
    assert inflate_gzip(&crc_past_end) matches { Err(ZlibError::HeaderExtendsPastEnd) };
}

test "bytes after the last gzip member that do not open another are ignored" {
    let data = make_wordy(300);
    let mut one_byte_more = gzip_compress(&data);
    one_byte_more.push(0x1F);
    let mut zeros_after = gzip_compress(&data);
    zeros_after.extend(&([0, 0, 0] as ByteList));
    assert inflate_gzip(&one_byte_more) matches { Ok(out) && out == data };
    assert inflate_gzip(&zeros_after) matches { Ok(out) && out == data };
}

test "streams count what they took and gave" {
    let first = make_wordy(1000);
    let second = make_pattern_data(2000);
    let mut expected = first;
    expected.extend(&second);
    let mut deflate = DeflateStream::new(Z_BEST_SPEED, Z_FILTERED, RAW_FORMAT);
    deflate.update(&first);
    deflate.update(&second);
    assert deflate.pending() == expected.len();
    let compressed = deflate.finish();
    assert deflate.get_total_in() == expected.len();
    assert deflate.get_total_out() == compressed.len();
    assert compressed.len() <= deflate.bound(expected.len());

    let mut inflate = InflateStream::new(RAW_FORMAT);
    inflate.update(&compressed);
    assert inflate.finish() matches { Ok(out) && out == expected };
    assert inflate.get_total_in() == compressed.len();
    assert inflate.get_total_out() == expected.len();
}

test "DeflateStream params take effect at the next compress" {
    let data = make_wordy(5000);
    let mut stream = DeflateStream::new(Z_BEST_COMPRESSION);
    stream.params(Z_NO_COMPRESSION, Z_DEFAULT_STRATEGY);
    let stored = stream.compress(&data);
    assert stored.len() > data.len();
    assert uncompress(&stored) matches { Ok(out) && out == data };
}

#[expect_trap]
test "DeflateStream refuses update after finish" {
    let mut stream = DeflateStream::new(Z_DEFAULT_COMPRESSION);
    stream.finish();
    stream.update(&make_pattern_data(1));
}

#[expect_trap]
test "DeflateStream refuses a second finish" {
    let mut stream = DeflateStream::new(Z_DEFAULT_COMPRESSION);
    stream.finish();
    stream.finish();
}

#[expect_trap]
test "DeflateStream refuses compress after compress" {
    let mut stream = DeflateStream::new(Z_DEFAULT_COMPRESSION);
    stream.compress(&make_pattern_data(1));
    stream.compress(&make_pattern_data(1));
}

test "InflateStream reset drops buffered input, and a copy keeps its own" {
    let data = make_wordy(500);
    let compressed = zlib_compress(&data);
    let mut stream = InflateStream::new();
    stream.update(&compressed);
    let mut copy = stream.copy();
    stream.update(&make_pattern_data(3));
    stream.reset();
    assert stream.get_total_in() == 0 && stream.get_total_out() == 0;
    stream.update(&compressed);
    assert stream.finish() matches { Ok(out) && out == data };
    assert copy.finish() matches { Ok(out) && out == data };
}

// A sync flush ends with an empty stored block, whose LEN and NLEN are
// `00 00 FF FF`; the block opens one byte earlier.
test "inflate_sync_find locates the block before a sync marker" {
    let marked: ByteList = [7, 1, 0, 0, 0xFF, 0xFF, 9];
    let at_start: ByteList = [0, 0, 0xFF, 0xFF];
    let unmarked: ByteList = [0, 0, 0xFF, 0xFE, 0];
    assert inflate_sync_find(&marked, 0) == 1;
    assert inflate_sync_find(&marked, 3) == -1;
    assert inflate_sync_find(&at_start, 0) == 0;
    assert inflate_sync_find(&unmarked, 0) == -1;
}
