package core:coverage@0.1.0;

/// Host interface behind test coverage. A probe calls it the first time its
/// region runs in an instance, and a test that returns reports each region
/// that ran more than once. Only `wado test --coverage` and `--pgo` supply it.
/// See WEP 2026-09-28 (Test Coverage) and WEP 2026-10-25 (Profile-Guided
/// Optimization).
interface coverage-host {
    /// Region `id` ran for the first time in this instance.
    hit: func(id: u32);

    /// Region `id` ran `runs` times in this instance, more than once.
    count: func(id: u32, runs: s64);
}
