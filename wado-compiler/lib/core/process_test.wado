use {
    availability,
    cmd,
    Availability,
    Command,
    ErrorCode,
    ExitStatus,
    ProcessError,
    ProcessErrorKind,
} from "core:process";

test "cmd splits literal text and keeps each hole one argument" {
    let msg = "fix the bug";
    let files: List<String> = ["a.txt", "b c.txt"];
    let dir = "out";
    let c = cmd`git commit -m ${msg} -- ${files} ${dir}/x.txt`;
    assert c.program == "git";
    assert c.args == ["commit", "-m", "fix the bug", "--", "a.txt", "b c.txt", "out/x.txt"];
}

#[expect_trap]
test "cmd refuses a shell metacharacter in literal text" {
    let _ = cmd`git commit -m "fix bug"`;
}

#[expect_trap]
test "cmd refuses a list hole joined to text" {
    let files: List<String> = ["a"];
    let _ = cmd`rm --file=${files}`;
}

test "read returns stdout" {
    if availability() != Availability::Available {
        return;
    }
    let n = 3;
    assert cmd`echo -n a${n}`.read().unwrap() == b"a3";
}

test "output reads stdout and stderr together" {
    if availability() != Availability::Available {
        return;
    }
    let script = "head -c 200000 /dev/zero >&2; echo out; exit 4";
    let out = cmd`sh -c ${script}`.output().unwrap();
    assert out.status == ExitStatus::Exited(4);
    assert out.stdout == b"out\n";
    assert out.stderr.len() == 200000;
}

test "read fails on a nonzero exit" {
    if availability() != Availability::Available {
        return;
    }
    let err = cmd`false`.read().unwrap_err();
    assert err.program == "false";
    assert err.kind matches { Failed([Exited(1), _]) };
}

test "a missing program is NotFound" {
    if availability() != Availability::Available {
        return;
    }
    let err = Command::new("wado-no-such-program").status().unwrap_err();
    assert err.kind matches { Spawn(NotFound) };
    assert `${err}` == "wado-no-such-program: no such program";
    assert Command::new("wado-no-such-program").output().unwrap_err().kind matches { Spawn(NotFound) };
}

test "a file that is no program is NotExecutable" {
    if availability() != Availability::Available {
        return;
    }
    assert Command::new("/etc/hosts").status().unwrap_err().kind matches { Spawn(NotExecutable) };
}

test "what the host cannot pass is InvalidArgument" {
    if availability() != Availability::Available {
        return;
    }
    let invalid = |command: Command| command.status().unwrap_err().kind matches { Spawn(InvalidArgument) };
    assert invalid(Command::new("true").arg("a\u{0}b"));
    assert invalid(Command::new("true").env("A=B", "c"));
    assert invalid(Command::new("true").env("", "c"));
}

test "arguments past what the host can pass are ArgumentListTooLong" {
    if availability() != Availability::Available {
        return;
    }
    let err = Command::new("true").arg("x".repeat(4 << 20)).status().unwrap_err();
    assert err.kind matches { Spawn(ArgumentListTooLong) };
}

test "a failure names the program, the status and stderr" {
    if availability() != Availability::Available {
        return;
    }
    let script = "printf oops >&2; exit 3";
    let err = cmd`sh -c ${script}`.read().unwrap_err();
    assert `${err}` == "sh: ExitStatus::Exited(3): oops";
}

test "every error kind reads as a reason" {
    let reason = |kind: ProcessErrorKind| `${ProcessError { program: "p", kind }}`;
    let spawn = |code: ErrorCode| reason(ProcessErrorKind::Spawn(code));
    assert spawn(ErrorCode::NotPermitted) == "p: the host does not let a child run it";
    assert spawn(ErrorCode::NotExecutable) == "p: not a program the host can run";
    assert spawn(ErrorCode::InvalidArgument) == "p: an argument or environment variable the host cannot pass";
    assert spawn(ErrorCode::ArgumentListTooLong) == "p: the arguments and environment are too long";
    assert spawn(ErrorCode::NotDirectory) == "p: the directory to start in is not one";
    assert spawn(ErrorCode::ResourceExhausted) == "p: the host is out of the resources a child takes";
    assert spawn(ErrorCode::Other(Option::Some("lost"))) == "p: lost";
    assert spawn(ErrorCode::Other(null)) == "p: the host failed to run it";
    assert reason(ProcessErrorKind::OutputTooLarge) == "p: its stdout passed the capture limit";
}

test "cmd takes integers of every width as one argument each" {
    let c = cmd`seq ${1 as i64} ${2 as u32} ${3 as u64}`;
    assert c.args == ["1", "2", "3"];
}

test "arg appends one argument" {
    let c = Command::new("echo").arg("a b").arg("c");
    assert c.args == ["a b", "c"];
}

test "wait_timeout reports a child still running, and its end once it comes" {
    if availability() != Availability::Available {
        return;
    }
    let mut child = cmd`sleep 10`.spawn().unwrap();
    assert child.wait_timeout(10_000_000).unwrap() matches { None };
    child.kill();
    assert child.wait_timeout(10_000_000_000).unwrap() == Option::Some(ExitStatus::Signaled(9));
    assert child.wait().unwrap() == ExitStatus::Signaled(9);
}

test "stop asks first, and kills a child that does not listen" {
    if availability() != Availability::Available {
        return;
    }
    assert cmd`sleep 10`.spawn().unwrap().stop(10_000_000_000).unwrap() == ExitStatus::Signaled(15);
    // An ignored signal stays ignored across exec, so `sleep` ignores it too.
    // The child says when it ignores it, or the request could land first.
    let script = "trap '' TERM; echo ready; sleep 10";
    let mut deaf = cmd`sh -c ${script}`.stdout_piped().spawn().unwrap();
    let [_, said] = deaf.stdout.take().unwrap().start_read(6).finish();
    assert said.items == b"ready\n";
    assert deaf.stop(100_000_000).unwrap() == ExitStatus::Signaled(9);
}

test "a piped stderr reaches the guest" {
    if availability() != Availability::Available {
        return;
    }
    let script = "printf err >&2";
    let mut child = Command::new("sh").args(["-c", script]).stderr_piped().spawn().unwrap();
    assert child.stderr.take().unwrap().read_to_end_bytes() == b"err";
    assert child.wait().unwrap() == ExitStatus::Exited(0);
}

test "an inherited stream is the guest's own" {
    if availability() != Availability::Available {
        return;
    }
    assert Command::new("true").inherit_stdio().status().unwrap() == ExitStatus::Exited(0);
}

test "stdout past the capture limit is OutputTooLarge" {
    if availability() != Availability::Available {
        return;
    }
    let err = cmd`head -c 100000 /dev/zero`.capture_limit(1000).read().unwrap_err();
    assert err.kind matches { OutputTooLarge };
}

test "stderr past the capture limit keeps its tail" {
    if availability() != Availability::Available {
        return;
    }
    // Past twice the limit the read loop trims; short of it, only the end does.
    let stderr = |script: String| cmd`sh -c ${script}`.capture_limit(4).output().unwrap().stderr;
    assert stderr("printf 0123456789 >&2") == b"6789";
    assert stderr("printf 0123456 >&2") == b"3456";
}

test "a piped child reads what the guest writes" {
    if availability() != Availability::Available {
        return;
    }
    let mut child = Command::new("cat").stdin_piped().stdout_piped().spawn().unwrap();
    let stdin = child.stdin.take().unwrap();
    assert stdin.write_all(b"ping") == CopyResult::Completed;
    builtin::drop(stdin);
    let stdout = child.stdout.take().unwrap();
    assert stdout.read_to_end_bytes() == b"ping";
    assert child.wait().unwrap() == ExitStatus::Exited(0);
}

test "output and status close a piped stdin nobody can write" {
    if availability() != Availability::Available {
        return;
    }
    let cat = Command::new("cat").stdin_piped();
    assert cat.output().unwrap().stdout == b"";
    assert cat.status().unwrap() == ExitStatus::Exited(0);
}

test "status reads no pipe it never hands out" {
    if availability() != Availability::Available {
        return;
    }
    let script = "head -c 200000 /dev/zero; head -c 200000 /dev/zero >&2";
    let status = Command::new("sh").args(["-c", script]).stdout_piped().stderr_piped().status();
    assert status.unwrap() == ExitStatus::Exited(0);
}

test "wait closes a stdin the guest kept" {
    if availability() != Availability::Available {
        return;
    }
    let child = Command::new("cat").stdin_piped().spawn().unwrap();
    assert child.wait().unwrap() == ExitStatus::Exited(0);
}

test "the child sees only the guest's grants" {
    if availability() != Availability::Available {
        return;
    }
    assert cmd`ls /tmp`.status().unwrap() != ExitStatus::Exited(0);
}

test "the child reads the system configuration" {
    if availability() != Availability::Available {
        return;
    }
    assert cmd`cat /etc/hosts`.status().unwrap() == ExitStatus::Exited(0);
}

test "the child gets the env it is given and a private HOME" {
    if availability() != Availability::Available {
        return;
    }
    let script = "printf %s $GREETING; test -d $HOME -a -w $HOME";
    let out = Command::new("sh").args(["-c", script]).env("GREETING", "hi").output().unwrap();
    assert out.stdout == b"hi";
    assert out.status == ExitStatus::Exited(0);
}
