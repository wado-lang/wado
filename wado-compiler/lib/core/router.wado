#![stdlib("core:router")]
//! HTTP path router (`core:router`).
//!
//! A `Router<H>` maps a request's method and path to a handler of any type
//! `H`, and captures the parameters its pattern names.
//!
//! ## Patterns
//!
//! A pattern is a path of `/`-separated segments. Each segment is one of:
//!
//! - a literal, which matches itself exactly (`/api/v1/health`)
//! - `:name`, a parameter that captures one whole segment (`/users/:id`)
//! - `*name`, a wildcard that captures the rest of the path, slashes included
//!   (`/static/*path`). It must be the last segment.
//!
//! `/` alone is the root. Registering a pattern panics when it does not start
//! with `/`, has an empty segment (`/a//b`, or a trailing `/`), has nothing
//! after a `:` or `*`, or uses one name twice. It also panics when a parameter
//! or wildcard takes a different name from one registered before at the same
//! place: `/users/:id` and then `/users/:name/posts`.
//!
//! ## Matching
//!
//! A path is matched one segment at a time. Where a literal and a parameter
//! could both take a segment, the literal takes it. A path that then finds no
//! route does not go back to try the parameter: with `/users/list` and
//! `/users/:id` registered, `/users/list/extra` matches neither.
//!
//! A path that finds no route, or finds one without a handler for the request's
//! method, falls back to a wildcard. The deepest wildcard passed on the way that
//! takes the method matches, so `/*rest` catches whatever no other route takes.
//!
//! A trailing slash matters: `/users` and `/users/` are different paths. A
//! wildcard matches the empty rest after one (`/static/`), but not the bare
//! prefix (`/static`). A path that does not start with `/` matches nothing.
//! Parameters hold the path's raw text: `%20` is not decoded.
//!
//! A route registered for a method takes that method alone, so `HEAD` does not
//! fall back to `GET`. A route registered with `any` takes every method, but a
//! handler registered for the method itself at the same pattern wins.
//!
//! When `match_path` returns `None`, `allowed_methods` tells a 405 from a 404:
//! it lists the methods the path would match under, and is empty for a 404.
//!
//! See `docs/wep-2026-05-06-core-router.md` for the design.

use { Request } from "wasi:http";
use { HashMap, HashSeed } from "core:collections";
use {
    Deserialize,
    DeserializeError,
    Deserializer,
    DeserializeStruct,
    FieldSchema,
    NoCompound,
    Visitor,
} from "core:serde";
pub use { Method } from "wasi:http";

#[synopsis]
test {
    let mut routes = Router::<i32>::new();
    routes.get("/health", 1);
    routes.get("/users/:id", 2);
    assert routes.match_path(Method::Get, &"/health") matches { Some(hit) && hit.handler == 1 };
    assert routes.match_path(Method::Get, &"/users/42") matches { Some(hit) && hit.handler == 2
        && hit.params.get("id") matches { Some(v) && v == "42" } };
}

test "re-registering a route replaces its handler in place" {
    let mut r = Router::<i32>::new();
    r.get("/a/:id", 1);
    r.get("/a/:id", 2);
    r.any("/a/:id", 3);
    r.any("/a/:id", 4);
    r.get("/f/*rest", 5);
    r.get("/f/*rest", 6);
    r.get("/s", 7);
    r.get("/s", 8);
    assert r.handlers.len() == 4;
}

/// The parameters a matched route captured, by name. Each value is the raw
/// text the parameter or wildcard took from the path.
pub struct PathParams {
    path: &String,
    names: &List<String>,
    // `[start0, end0, start1, end1, ...]`, byte ranges into `path`.
    ranges: &List<i32>,
}

impl PathParams {
    /// The number of captured parameters: 0 for a route with none.
    pub fn len(&self) -> i32 {
        return self.names.len();
    }

    /// True when the route captured no parameters.
    pub fn is_empty(&self) -> bool {
        return self.names.is_empty();
    }

    /// The value captured as `name`, or `None` when the route has no such
    /// parameter.
    pub fn get<S: AsStrSlice>(&self, name: S) -> Option<String> {
        let n = self.names.len();
        for let mut i = 0; i < n; i += 1 {
            if name == self.names[i] {
                let s = self.ranges[i * 2];
                let e = self.ranges[i * 2 + 1];
                return Option::Some(self.path.substr_bytes(s, e));
            }
        }
        return null;
    }

    /// Deserializes the parameters into the struct `T`, each into the field of
    /// its name (`#[wire]` renames apply). A field parses from the parameter's
    /// text, so it may be a number, `bool`, `char`, `String`, any type that
    /// deserializes from a string, or an `Option` of one. A parameter `T` does
    /// not name is skipped.
    ///
    /// Fails with `InvalidValue` on text the field's type cannot parse, and with
    /// `UnexpectedType` when `T` is not a struct or has a field of a list, map,
    /// struct, or other variant type.
    pub fn deserialize<T: Deserialize>(&self) -> Result<T, DeserializeError> {
        let mut d = PathParamsDeserializer { src: self, cursor: 0 };
        return T::deserialize(&mut d);
    }
}

/// `params["id"]` is `params.get("id")`, but panics when the route has no
/// such parameter.
impl IndexValue<String> for PathParams {
    type Output = String;

    fn index_value(&self, name: String) -> String {
        return match self.get(name) {
            Some(v) => v,
            None => panic(`path param '${name}' not found`),
        };
    }
}

/// A route that matched: its handler, and the parameters it captured.
pub struct RouteMatch<H> {
    pub handler: H,
    pub params: PathParams,
}

variant Segment {
    Literal(String),
    Param(String),
    Wildcard(String),
}

struct MethodEntry {
    method: Method,
    handler_idx: i32,
}

/// One route's handlers by method, as indices into the list holding them.
struct MethodTable {
    specific: List<MethodEntry>,
    any_idx: i32,
}

impl MethodTable {
    fn new() -> MethodTable {
        return MethodTable { specific: [], any_idx: -1 };
    }

    fn is_empty(&self) -> bool {
        return self.specific.is_empty() && self.any_idx < 0;
    }

    /// The handler registered for `method` itself, or -1.
    fn find(&self, method: &Method) -> i32 {
        for let e of &self.specific {
            if e.method == *method {
                return e.handler_idx;
            }
        }
        return -1;
    }

    /// The handler a request with `method` reaches, or -1.
    fn dispatch(&self, method: &Method) -> i32 {
        let h = self.find(method);
        return if h >= 0 { h } else { self.any_idx };
    }

    /// The handler registered for exactly `method_opt`, `null` being `any`,
    /// or -1.
    fn slot(&self, method_opt: &Option<Method>) -> i32 {
        return match method_opt {
            Some(method) => self.find(method),
            None => self.any_idx,
        };
    }

    fn add(&mut self, method_opt: &Option<Method>, handler_idx: i32) {
        if let Some(method) = method_opt {
            self.specific.push(MethodEntry { method: *method, handler_idx });
        } else {
            self.any_idx = handler_idx;
        }
    }

    fn add_methods_to(&self, methods: &mut List<Method>) {
        for let e of &self.specific {
            push_new(methods, e.method);
        }
    }
}

struct DfaState {
    /// A literal segment's text to the state it leads to.
    literals: HashMap<String, i32>,
    param_target: i32,
    param_name: String,
    wildcard: MethodTable,
    terminal: MethodTable,
    /// Captured param names from root to this state (in capture order).
    /// Shared by all routes that end at this terminal.
    terminal_names: List<String>,
    /// The names a wildcard match at this state captures: the names on the
    /// way here, then the wildcard's own. Empty while it has no wildcard.
    wildcard_names: List<String>,
}

/// What the router's maps hash under. Their keys are the routes the program
/// registers. A request only probes chains that registration built, so it
/// cannot grow one. A fixed seed therefore exposes nothing, and spares a
/// program that routes from asking the host for a seed.
global ROUTER_SEED: HashSeed = HashSeed::fixed(0x452821E638D01377, 0xBE5466CF34E90C6C);

fn new_state() -> DfaState {
    return DfaState {
        literals: HashMap::with_seed(ROUTER_SEED),
        param_target: -1,
        param_name: "",
        wildcard: MethodTable::new(),
        terminal: MethodTable::new(),
        terminal_names: [],
        wildcard_names: [],
    };
}

/// A static pattern's matches, built once, by method.
struct StaticRoute<H> {
    table: MethodTable,
    matches: List<RouteMatch<H>>,
}

/// Shared singletons for `PathParams` with no captures.
global EMPTY_STR: String = "";
global EMPTY_NAMES: List<String> = [];
global EMPTY_RANGES: List<i32> = [];

/// An HTTP path router over handlers of type `H`.
pub struct Router<H> {
    static_routes: HashMap<String, StaticRoute<H>>,
    states: List<DfaState>,
    handlers: List<H>,
}

impl<H> Router<H> {
    /// An empty router.
    pub fn new() -> Router<H> {
        let mut r = Router {
            static_routes: HashMap::with_seed(ROUTER_SEED),
            states: [],
            handlers: [],
        };
        r.states.push(new_state());
        return r;
    }

    /// Registers `handler` for `method` at `pattern`, replacing the handler
    /// registered for both before. Panics on a malformed pattern.
    pub fn route<S: AsStrSlice>(&mut self, method: Method, pattern: S, handler: H) {
        self.insert(Option::Some(method), pattern, handler);
    }

    /// `route(Method::Get, pattern, handler)`.
    pub fn get<S: AsStrSlice>(&mut self, pattern: S, handler: H) {
        self.route(Method::Get, pattern, handler);
    }

    /// `route(Method::Post, pattern, handler)`.
    pub fn post<S: AsStrSlice>(&mut self, pattern: S, handler: H) {
        self.route(Method::Post, pattern, handler);
    }

    /// `route(Method::Put, pattern, handler)`.
    pub fn put<S: AsStrSlice>(&mut self, pattern: S, handler: H) {
        self.route(Method::Put, pattern, handler);
    }

    /// `route(Method::Patch, pattern, handler)`.
    pub fn patch<S: AsStrSlice>(&mut self, pattern: S, handler: H) {
        self.route(Method::Patch, pattern, handler);
    }

    /// `route(Method::Delete, pattern, handler)`.
    pub fn delete<S: AsStrSlice>(&mut self, pattern: S, handler: H) {
        self.route(Method::Delete, pattern, handler);
    }

    /// `route(Method::Options, pattern, handler)`.
    pub fn options<S: AsStrSlice>(&mut self, pattern: S, handler: H) {
        self.route(Method::Options, pattern, handler);
    }

    /// Registers `handler` for every method at `pattern`, `Method::Other(_)`
    /// included, replacing the `any` handler registered there before. A handler
    /// registered for the request's method at the same pattern wins over it.
    /// Panics on a malformed pattern.
    pub fn any<S: AsStrSlice>(&mut self, pattern: S, handler: H) {
        self.insert(null, pattern, handler);
    }

    fn insert<S: AsStrSlice>(&mut self, method_opt: Option<Method>, pattern: S, handler: H) {
        let segs = parse_pattern(&pattern);
        if is_static_pattern(&segs) {
            self.cache_static(&method_opt, pattern, handler);
        }
        self.insert_route(&method_opt, &segs, handler);
    }

    /// Builds the match a static pattern always gives, so a hit on it builds
    /// nothing. The DFA holds the route as well, and decides every path the
    /// cache does not answer outright.
    fn cache_static<S: AsStrSlice>(&mut self, method_opt: &Option<Method>, pattern: S, handler: H) {
        let rm = RouteMatch {
            handler,
            params: PathParams { path: &EMPTY_STR, names: &EMPTY_NAMES, ranges: &EMPTY_RANGES },
        };
        let key = pattern.to_string();
        self.static_routes.try_insert(key, StaticRoute { table: MethodTable::new(), matches: [] });
        let route = &mut self.static_routes[key];
        store_in(&mut route.matches, &mut route.table, method_opt, rm);
    }

    fn insert_route(&mut self, method_opt: &Option<Method>, segs: &List<Segment>, handler: H) {
        let mut cur: i32 = 0;
        let mut names: List<String> = [];
        for let seg of segs {
            match seg {
                Wildcard(name) => {
                    let existing = &self.states[cur].wildcard_names;
                    if existing.is_empty() {
                        names.push(*name);
                        self.states[cur].wildcard_names = names;
                    } else {
                        let held = existing[existing.len() - 1];
                        if held != *name {
                            panic(`wildcard name conflict: '*${held}' vs '*${*name}' at the same node`);
                        }
                    }
                    store_in(&mut self.handlers, &mut self.states[cur].wildcard, method_opt, handler);
                    return;
                },
                Param(name) => {
                    if self.states[cur].param_target < 0 {
                        let new_id = self.states.len();
                        self.states.push(new_state());
                        self.states[cur].param_target = new_id;
                        self.states[cur].param_name = *name;
                    } else if self.states[cur].param_name != *name {
                        panic(`param name conflict: ':${self.states[cur].param_name}' vs ':${*name}' at the same node`);
                    }
                    names.push(*name);
                    cur = self.states[cur].param_target;
                },
                Literal(lit) => {
                    if let Some(target) = self.states[cur].literals.get(*lit) {
                        cur = target;
                    } else {
                        let new_id = self.states.len();
                        self.states.push(new_state());
                        self.states[cur].literals[*lit] = new_id;
                        cur = new_id;
                    }
                },
            }
        }
        // A differing name panicked on the way here.
        assert self.states[cur].terminal_names.is_empty() || self.states[cur].terminal_names == names;
        self.states[cur].terminal_names = names;
        store_in(&mut self.handlers, &mut self.states[cur].terminal, method_opt, handler);
    }

    /// The route `path` matches under `method`, or `None`. `path` is the path
    /// alone, with no query or fragment; `match_request` strips them.
    pub fn match_path(&self, method: Method, path: &String) -> Option<&RouteMatch<H>> {
        if let Some(rm) = self.match_static(&method, path) {
            return Option::Some(rm);
        }
        return self.match_walk(&method, path);
    }

    fn match_static<S: AsStrSlice>(&self, method: &Method, path: S) -> Option<&RouteMatch<H>> {
        let Some(route) = self.static_routes.get_ref_str(path) else {
            return null;
        };
        let idx = route.table.dispatch(method);
        if idx < 0 {
            return null;
        }
        return Option::Some(&route.matches[idx]);
    }

    fn match_walk(&self, method: &Method, path: &String) -> Option<&RouteMatch<H>> {
        let mut m = Matcher {
            method,
            ranges: [],
            wildcard_names: &EMPTY_NAMES,
            wildcard_handler: -1,
            wildcard_pos: 0,
            wildcard_ranges: 0,
        };
        let end = self.walk(path, &mut m);
        if end >= 0 {
            let h = self.states[end].terminal.dispatch(method);
            if h >= 0 {
                return self.hit(h, path, &self.states[end].terminal_names, &m.ranges);
            }
        }
        if m.wildcard_handler < 0 {
            return null;
        }
        m.ranges.truncate(m.wildcard_ranges);
        m.ranges.push(m.wildcard_pos);
        m.ranges.push(path.len());
        return self.hit(m.wildcard_handler, path, m.wildcard_names, &m.ranges);
    }

    /// A fresh match, which the returned reference keeps alive.
    fn hit(&self, h: i32, path: &String, names: &List<String>, ranges: &List<i32>) -> Option<&RouteMatch<H>> {
        let rm = RouteMatch {
            handler: self.handlers[h],
            params: PathParams { path, names, ranges },
        };
        return Option::Some(&rm);
    }

    /// Walks `path` through the DFA, reporting to `v` on the way. Returns the
    /// state the path ends at, or -1 when it leaves the graph, ends in a `/`
    /// other than the root, or does not start with `/`.
    fn walk<S: AsStrSlice, V: PathVisitor>(&self, path: S, v: &mut V) -> i32 {
        let plen = path.len();
        if plen == 0 || unchecked path.byte_at(0) != b'/' {
            return -1;
        }
        let view = path.as_str_slice();
        let mut state: i32 = 0;
        let mut pos = 1;
        loop {
            let s = &self.states[state];
            if !s.wildcard.is_empty() {
                v.wildcard(s, pos);
            }
            if pos == plen {
                return if plen == 1 { 0 } else { -1 };
            }
            let mut end = pos;
            while end < plen && unchecked path.byte_at(end) != b'/' {
                end += 1;
            }
            if end == pos {
                return -1;
            }
            if let Some(target) = s.literals.get_str(unchecked view.slice(pos, end)) {
                state = target;
            } else if s.param_target >= 0 {
                v.param(pos, end);
                state = s.param_target;
            } else {
                return -1;
            }
            if end == plen {
                return state;
            }
            pos = end + 1;
        }
    }

    /// The methods `match_path` would match `path` under, each once. A method
    /// only an `any` handler takes is not listed, so the list is empty on a 404
    /// and where only `any` handlers match.
    pub fn allowed_methods<S: AsStrSlice>(&self, path: S) -> List<Method> {
        let mut methods: List<Method> = [];
        let mut c = MethodCollector { wildcard_methods: [] };
        let end = self.walk(path, &mut c);
        if end >= 0 {
            self.states[end].terminal.add_methods_to(&mut methods);
        }
        for let m of c.wildcard_methods {
            push_new(&mut methods, m);
        }
        return methods;
    }

    /// Matches a `wasi:http` request: its method, and its path with the query
    /// and fragment stripped. A request without a path matches as `/`.
    pub fn match_request(&self, request: &Request) -> Option<&RouteMatch<H>> {
        let method = request.get_method();
        let pq = match request.get_path_with_query() {
            Some(s) => s,
            None => "/",
        };
        let path = strip_query(pq);
        return self.match_path(method, &path);
    }
}

/// What a walk of a path through the DFA reports on the way.
trait PathVisitor with () {
    /// A parameter captured the bytes `start..end`.
    fn param(&mut self, start: i32, end: i32);

    /// `s` has a wildcard, which would capture the path from `pos`.
    fn wildcard(&mut self, s: &DfaState, pos: i32);
}

/// Matches under one method, keeping the deepest wildcard on the way that
/// takes it in case the walk finds no route.
struct Matcher {
    method: &Method,
    ranges: List<i32>,
    wildcard_names: &List<String>,
    wildcard_handler: i32,
    wildcard_pos: i32,
    /// How many `ranges` entries the walk had made at that wildcard.
    wildcard_ranges: i32,
}

impl PathVisitor for Matcher {
    fn param(&mut self, start: i32, end: i32) {
        self.ranges.push(start);
        self.ranges.push(end);
    }

    fn wildcard(&mut self, s: &DfaState, pos: i32) {
        let h = s.wildcard.dispatch(self.method);
        if h >= 0 {
            self.wildcard_names = &s.wildcard_names;
            self.wildcard_handler = h;
            self.wildcard_pos = pos;
            self.wildcard_ranges = self.ranges.len();
        }
    }
}

/// Collects the methods of the wildcards a walk passes.
struct MethodCollector {
    wildcard_methods: List<Method>,
}

impl PathVisitor for MethodCollector {
    fn param(&mut self, _start: i32, _end: i32) {
    }

    fn wildcard(&mut self, s: &DfaState, _pos: i32) {
        s.wildcard.add_methods_to(&mut self.wildcard_methods);
    }
}

/// Puts `item` in `items` as `table`'s entry for `method_opt`, replacing the
/// one there.
fn store_in<T>(items: &mut List<T>, table: &mut MethodTable, method_opt: &Option<Method>, item: T) {
    let slot = table.slot(method_opt);
    if slot >= 0 {
        items[slot] = item;
        return;
    }
    table.add(method_opt, items.len());
    items.push(item);
}

fn push_new(methods: &mut List<Method>, method: Method) {
    if !methods.contains(&method) {
        methods.push(method);
    }
}

fn is_static_pattern(segs: &List<Segment>) -> bool {
    for let seg of segs {
        if !seg matches { Literal(_) } {
            return false;
        }
    }
    return true;
}

fn strip_query<S: AsStrSlice>(s: S) -> String {
    let len = s.len();
    for let mut i = 0; i < len; i += 1 {
        let b = unchecked s.byte_at(i);
        if b == b'?' || b == b'#' {
            return s.substr_bytes(0, i);
        }
    }
    return s.to_string();
}

/// Parse a route pattern path into a list of segments. Panics on
/// malformed input.
fn parse_pattern<S: AsStrSlice>(path: S) -> List<Segment> {
    let bytes = path.len();
    if bytes == 0 || unchecked path.byte_at(0) != b'/' {
        panic("route pattern must start with '/'");
    }
    if bytes > 1 && unchecked path.byte_at(bytes - 1) == b'/' {
        panic("route pattern must not contain empty segments (no '//' or trailing '/')");
    }
    let mut out: List<Segment> = [];
    let mut names: List<String> = [];
    let mut wildcard_seen = false;
    let mut i = 1;
    while i < bytes {
        let mut j = i;
        while j < bytes && unchecked path.byte_at(j) != b'/' {
            j += 1;
        }
        if wildcard_seen {
            panic("wildcard '*name' must be the last segment of a route pattern");
        }
        let seg = path.substr_bytes(i, j);
        if seg.is_empty() {
            panic("route pattern must not contain empty segments (no '//' or trailing '/')");
        }
        let item = match unchecked seg.byte_at(0) as char {
            ':' => Segment::Param(capture_name(&seg, &mut names)),
            '*' => {
                wildcard_seen = true;
                Segment::Wildcard(capture_name(&seg, &mut names));
            },
            _ => Segment::Literal(seg),
        };
        out.push(item);
        i = j + 1;
    }
    return out;
}

/// The name after a `:` or `*` segment's sigil, checked to be new to its
/// pattern.
fn capture_name(seg: &String, names: &mut List<String>) -> String {
    let name = seg.substr_bytes(1, seg.len());
    if name.is_empty() {
        panic(`a name must follow '${*seg}' in a route pattern`);
    }
    if names.contains(&name) {
        panic(`route pattern uses the name '${name}' twice`);
    }
    names.push(name);
    return name;
}

/// `Deserializer` for `PathParams`. Iterates captured params in the order
/// they appear in the pattern (= struct-field index after name lookup).
/// Scalar atoms parse directly from path byte ranges; only `deserialize_string`
/// allocates a substring.
struct PathParamsDeserializer {
    src: &PathParams,
    cursor: i32,
}

struct PathParamsStructAccess {
    de: PathParamsDeserializer,
}

impl Deserializer for PathParamsDeserializer {
    type SeqAccess = NoCompound;
    type MapAccess = NoCompound;
    type StructAccess = PathParamsStructAccess;
    type VariantAccess = NoCompound;

    fn deserialize_i32(&mut self) -> Result<i32, DeserializeError> {
        return self.parse_scalar::<i32>("i32");
    }

    fn deserialize_i64(&mut self) -> Result<i64, DeserializeError> {
        return self.parse_scalar::<i64>("i64");
    }

    fn deserialize_u32(&mut self) -> Result<u32, DeserializeError> {
        return self.parse_scalar::<u32>("u32");
    }

    fn deserialize_u64(&mut self) -> Result<u64, DeserializeError> {
        return self.parse_scalar::<u64>("u64");
    }

    fn deserialize_i128(&mut self) -> Result<i128, DeserializeError> {
        return self.parse_scalar::<i128>("i128");
    }

    fn deserialize_u128(&mut self) -> Result<u128, DeserializeError> {
        return self.parse_scalar::<u128>("u128");
    }

    fn deserialize_f32(&mut self) -> Result<f32, DeserializeError> {
        return self.parse_scalar::<f32>("f32");
    }

    fn deserialize_f64(&mut self) -> Result<f64, DeserializeError> {
        return self.parse_scalar::<f64>("f64");
    }

    fn deserialize_f16(&mut self) -> Result<f16, DeserializeError> {
        return self.parse_scalar::<f16>("f16");
    }

    fn deserialize_bf16(&mut self) -> Result<bf16, DeserializeError> {
        return self.parse_scalar::<bf16>("bf16");
    }

    fn deserialize_bool(&mut self) -> Result<bool, DeserializeError> {
        return self.parse_scalar::<bool>("bool");
    }

    fn deserialize_char(&mut self) -> Result<char, DeserializeError> {
        return self.parse_scalar::<char>("char");
    }

    fn deserialize_string(&mut self) -> Result<String, DeserializeError> {
        self.require_active_param()?;
        let [s, e] = self.current_range();
        return Result::Ok(self.src.path.substr_bytes(s, e));
    }

    fn is_null(&mut self) -> Result<bool, DeserializeError> {
        return Result::Ok(false);
    }

    fn begin_seq(&mut self) -> Result<NoCompound, DeserializeError> {
        return Result::Err(DeserializeError::unexpected_type("path params cannot be deserialized as a seq", -1));
    }

    fn begin_map(&mut self) -> Result<NoCompound, DeserializeError> {
        return Result::Err(DeserializeError::unexpected_type("path params cannot be deserialized as a map", -1));
    }

    fn begin_struct<S: AsStrSlice>(
        &mut self,
        _name: S,
        _num_fields: i32,
    ) -> Result<PathParamsStructAccess, DeserializeError> {
        // Nested structs are unsupported: `PathParams` is a flat key/value
        // surface, so a nested `begin_struct` (cursor != 0) means a field
        // typed as another struct asked us to descend into it. Refuse loudly
        // rather than silently re-running the field loop for the inner type.
        if self.cursor != 0 {
            return Result::Err(DeserializeError::unexpected_type(
                "path params cannot deserialize a nested struct field",
                -1,
            ));
        }
        return Result::Ok(PathParamsStructAccess { de: *self });
    }

    fn begin_variant<S: AsStrSlice>(&mut self, _type_name: S, _num_cases: i32) -> Result<NoCompound, DeserializeError> {
        return Result::Err(DeserializeError::unexpected_type("path params cannot be deserialized as a variant", -1));
    }

    /// A path segment is always text, so a dynamic `Deserialize` gets it raw.
    fn deserialize_any<V: Visitor>(&mut self, visitor: &mut V) -> Result<V::Value, DeserializeError> {
        let text = self.deserialize_string()?;
        return visitor.visit_string(text);
    }
}

impl PathParamsDeserializer {
    /// Byte range of the path parameter currently being deserialized. A caller
    /// passes `require_active_param` first.
    fn current_range(&self) -> [i32, i32] {
        assert self.cursor > 0;
        let i = self.cursor - 1;
        return [self.src.ranges[i * 2], self.src.ranges[i * 2 + 1]];
    }

    /// Rejects a scalar read that no `next_field` preceded: the root of
    /// `PathParams::deserialize::<T>()` must be a struct, and a scalar root
    /// such as `u64` reaches here with no active param.
    fn require_active_param(&self) -> Result<(), DeserializeError> {
        if self.cursor == 0 {
            return Result::Err(DeserializeError::unexpected_type(
                "path params can only be deserialized into a struct (non-struct root not supported)",
                -1,
            ));
        }
        return Result::Ok(());
    }

    /// The `invalid_value` error for the active param, e.g. `path param 'id'
    /// is not a valid u64: 'abc' (invalid digit found in string)`.
    fn invalid_param<S: AsStrSlice, R: AsStrSlice>(&self, type_name: S, reason: R) -> DeserializeError {
        let name = &self.src.names[self.cursor - 1];
        let [s, e] = self.current_range();
        let value = self.src.path.substr_bytes(s, e);
        let message = `path param '${*name}' is not a valid ${type_name}: '${value}' (${reason})`;
        return DeserializeError::invalid_value(message, s as i64);
    }

    /// Parse the active param's byte range into `T` via `FromStr`.
    /// The shared body of every scalar `deserialize_*` arm.
    fn parse_scalar<T: FromStr, S: AsStrSlice>(&self, type_name: S) -> Result<T, DeserializeError> {
        self.require_active_param()?;
        let [s, e] = self.current_range();
        return match T::from_str(self.src.path.as_str_slice().slice(s, e)) {
            Ok(v) => Result::Ok(v),
            Err(reason) => Result::Err(self.invalid_param(type_name, `${reason}`)),
        };
    }
}

impl DeserializeStruct for PathParamsStructAccess {
    fn next_field<S: FieldSchema>(&mut self) -> Result<Option<i32>, DeserializeError> {
        if self.de.cursor >= self.de.src.names.len() {
            return Result::Ok(null);
        }
        let name = &self.de.src.names[self.de.cursor];
        self.de.cursor += 1;
        let idx = match S::lookup(name.as_bytes()) {
            Some(v) => v,
            None => -1,
        };
        return Result::Ok(Option::Some(idx));
    }

    fn value<T: Deserialize>(&mut self) -> Result<T, DeserializeError> {
        return T::deserialize(&mut self.de);
    }

    fn skip(&mut self) -> Result<(), DeserializeError> {
        return Result::Ok(());
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        return Result::Ok(());
    }
}
