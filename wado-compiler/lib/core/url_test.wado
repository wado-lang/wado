use { Url, ParseError, percent_encode, percent_decode, parse_query, format_query } from "core:url";
use { TreeMap } from "core:collections";
use { to_string, from_string } from "core:json";

// --- Url::parse basic ---

test "parse simple http" {
    if let Ok(url) = Url::parse("http://example.com") {
        assert url.scheme == "http";
        assert url.host == "example.com";
        assert url.path == "/";
        assert url.username == "";
        assert url.password == "";
        assert url.port matches { None };
        assert url.query matches { None };
        assert url.fragment matches { None };
    } else {
        panic("parse failed");
    }
}

test "parse https with path" {
    if let Ok(url) = Url::parse("https://example.com/foo/bar") {
        assert url.scheme == "https";
        assert url.host == "example.com";
        assert url.path == "/foo/bar";
    } else {
        panic("parse failed");
    }
}

test "parse with query and fragment" {
    if let Ok(url) = Url::parse("http://example.com/path?key=val&a=b#sec") {
        assert url.path == "/path";
        assert url.query matches { Some("key=val&a=b") };
        assert url.fragment matches { Some("sec") };
    } else {
        panic("parse failed");
    }
}

test "parse with userinfo" {
    if let Ok(url) = Url::parse("https://user:pass@example.com/path") {
        assert url.username == "user";
        assert url.password == "pass";
        assert url.host == "example.com";
    } else {
        panic("parse failed");
    }
}

test "parse with username only" {
    if let Ok(url) = Url::parse("https://admin@example.com/") {
        assert url.username == "admin";
        assert url.password == "";
        assert url.host == "example.com";
    } else {
        panic("parse failed");
    }
}

test "parse with explicit port" {
    if let Ok(url) = Url::parse("http://example.com:8080/path") {
        assert url.host == "example.com";
        assert url.port matches { Some(8080) };
    } else {
        panic("parse failed");
    }
}

test "parse default port normalized to None" {
    if let Ok(url) = Url::parse("http://example.com:80/path") {
        assert url.port matches { None };
    } else {
        panic("parse failed");
    }
}

test "parse https default port" {
    if let Ok(url) = Url::parse("https://example.com:443/") {
        assert url.port matches { None };
    } else {
        panic("parse failed");
    }
}

test "parse ws scheme" {
    if let Ok(url) = Url::parse("ws://localhost:9090/ws") {
        assert url.scheme == "ws";
        assert url.host == "localhost";
        assert url.port matches { Some(9090) };
        assert url.path == "/ws";
    } else {
        panic("parse failed");
    }
}

test "parse wss scheme" {
    if let Ok(url) = Url::parse("wss://example.com/chat") {
        assert url.scheme == "wss";
        assert url.host == "example.com";
        assert url.path == "/chat";
    } else {
        panic("parse failed");
    }
}

test "parse case insensitive scheme" {
    if let Ok(url) = Url::parse("HTTP://EXAMPLE.COM/PATH") {
        assert url.scheme == "http";
        assert url.host == "example.com";
    } else {
        panic("parse failed");
    }
}

test "parse IPv6 host" {
    if let Ok(url) = Url::parse("http://[::1]:8080/path") {
        assert url.host == "::1";
        assert url.port matches { Some(8080) };
    } else {
        panic("parse failed");
    }
}

test "parse full URL with all components" {
    if let Ok(url) = Url::parse("https://user:pass@example.com:8443/api/v1?key=val&lang=ja#sec1") {
        assert url.scheme == "https";
        assert url.username == "user";
        assert url.password == "pass";
        assert url.host == "example.com";
        assert url.port matches { Some(8443) };
        assert url.path == "/api/v1";
        assert url.query matches { Some("key=val&lang=ja") };
        assert url.fragment matches { Some("sec1") };
    } else {
        panic("parse failed");
    }
}

// --- Parse errors ---

test "parse empty input" {
    assert Url::parse("") matches { Err(EmptyInput) };
}

test "parse invalid scheme" {
    assert Url::parse("mailto:user@host") matches { Err(InvalidScheme) };
}

test "parse ftp rejected" {
    assert Url::parse("ftp://files.example.com/") matches { Err(InvalidScheme) };
}

test "parse missing host" {
    assert Url::parse("http://") matches { Err(MissingHost) };
}

test "parse no scheme" {
    assert Url::parse("/path/to/resource") matches { Err(InvalidScheme) };
}

test "parse invalid port" {
    assert Url::parse("http://example.com:99999/") matches { Err(InvalidPort) };
}

test "parse non-numeric port" {
    assert Url::parse("http://example.com:abc/") matches { Err(InvalidPort) };
}

// --- to_string ---

test "to_string simple" {
    if let Ok(url) = Url::parse("https://example.com/path") {
        assert url.to_string() == "https://example.com/path";
    } else {
        panic("parse failed");
    }
}

test "to_string with query and fragment" {
    if let Ok(url) = Url::parse("http://example.com/path?q=1#frag") {
        assert url.to_string() == "http://example.com/path?q=1#frag";
    } else {
        panic("parse failed");
    }
}

test "to_string with credentials" {
    if let Ok(url) = Url::parse("https://user:pass@example.com:8443/path") {
        assert url.to_string() == "https://user:pass@example.com:8443/path";
    } else {
        panic("parse failed");
    }
}

test "to_string default port omitted" {
    if let Ok(url) = Url::parse("http://example.com:80/path") {
        assert url.to_string() == "http://example.com/path";
    } else {
        panic("parse failed");
    }
}

test "to_string IPv6" {
    if let Ok(url) = Url::parse("http://[::1]:8080/") {
        assert url.to_string() == "http://[::1]:8080/";
    } else {
        panic("parse failed");
    }
}

// --- Derived accessors ---

test "authority with credentials and port" {
    if let Ok(url) = Url::parse("https://user:pass@example.com:8443/path") {
        assert url.authority() == "user:pass@example.com:8443";
    } else {
        panic("parse failed");
    }
}

test "authority simple" {
    if let Ok(url) = Url::parse("http://example.com/path") {
        assert url.authority() == "example.com";
    } else {
        panic("parse failed");
    }
}

test "origin" {
    if let Ok(url) = Url::parse("https://user:pass@example.com:8443/path") {
        assert url.origin() == "https://example.com:8443";
    } else {
        panic("parse failed");
    }
}

test "path_with_query with query" {
    if let Ok(url) = Url::parse("http://example.com/api?key=val") {
        assert url.path_with_query() == "/api?key=val";
    } else {
        panic("parse failed");
    }
}

test "path_with_query without query" {
    if let Ok(url) = Url::parse("http://example.com/api") {
        assert url.path_with_query() == "/api";
    } else {
        panic("parse failed");
    }
}

test "authority with port" {
    if let Ok(url) = Url::parse("http://example.com:8080/") {
        assert url.authority() == "example.com:8080";
    } else {
        panic("parse failed");
    }
}

test "authority without port" {
    if let Ok(url) = Url::parse("http://example.com/") {
        assert url.authority() == "example.com";
    } else {
        panic("parse failed");
    }
}

test "effective_port explicit" {
    if let Ok(url) = Url::parse("http://example.com:9090/") {
        assert url.effective_port() == 9090;
    } else {
        panic("parse failed");
    }
}

test "effective_port default http" {
    if let Ok(url) = Url::parse("http://example.com/") {
        assert url.effective_port() == 80;
    } else {
        panic("parse failed");
    }
}

test "effective_port default https" {
    if let Ok(url) = Url::parse("https://example.com/") {
        assert url.effective_port() == 443;
    } else {
        panic("parse failed");
    }
}

// --- Query parameters ---

test "query_pairs" {
    if let Ok(url) = Url::parse("http://example.com/?a=1&b=2&c=3") {
        let pairs = url.query_pairs();
        assert pairs.len() == 3;
        assert pairs.get("a") matches { Some("1") };
        assert pairs.get("b") matches { Some("2") };
        assert pairs.get("c") matches { Some("3") };
        let keys = pairs.keys();
        assert keys[0] == "a";
        assert keys[1] == "b";
        assert keys[2] == "c";
    } else {
        panic("parse failed");
    }
}

test "query_get" {
    if let Ok(url) = Url::parse("http://example.com/?name=Alice&age=30") {
        assert url.query_get("name") matches { Some("Alice") };
        assert url.query_get("age") matches { Some("30") };
        assert url.query_get("missing") matches { None };
    } else {
        panic("parse failed");
    }
}

test "query_get duplicate keys last wins" {
    if let Ok(url) = Url::parse("http://example.com/?tag=a&tag=b&tag=c") {
        assert url.query_get("tag") matches { Some("c") };
    } else {
        panic("parse failed");
    }
}

test "query_get_all duplicate keys" {
    if let Ok(url) = Url::parse("http://example.com/?tag=a&tag=b&tag=c") {
        let vals = url.query_get_all("tag");
        assert vals.len() == 3;
        assert vals[0] == "a";
        assert vals[1] == "b";
        assert vals[2] == "c";
    } else {
        panic("parse failed");
    }
}

test "query_get_all missing key" {
    if let Ok(url) = Url::parse("http://example.com/?a=1") {
        assert url.query_get_all("missing").len() == 0;
    } else {
        panic("parse failed");
    }
}

test "query_pairs empty query" {
    if let Ok(url) = Url::parse("http://example.com/") {
        assert url.query_pairs().len() == 0;
    } else {
        panic("parse failed");
    }
}

test "with_query_pairs" {
    if let Ok(url) = Url::parse("http://example.com/path") {
        let mut params = TreeMap::<String, String>::new();
        params["key"] = "val";
        params["name"] = "Alice";
        let updated = url.with_query_pairs(params);
        assert updated.query_get("key") matches { Some("val") };
        assert updated.query_get("name") matches { Some("Alice") };
        assert updated.path == "/path";
    } else {
        panic("parse failed");
    }
}

// --- Resolve ---

test "resolve absolute reference" {
    if let Ok(base) = Url::parse("http://example.com/a/b") {
        if let Ok(resolved) = base.resolve("http://other.com/c") {
            assert resolved.host == "other.com";
            assert resolved.path == "/c";
        } else {
            panic("resolve failed");
        }
    } else {
        panic("parse failed");
    }
}

test "resolve absolute path" {
    if let Ok(base) = Url::parse("http://example.com/a/b") {
        if let Ok(resolved) = base.resolve("/c/d") {
            assert resolved.host == "example.com";
            assert resolved.path == "/c/d";
        } else {
            panic("resolve failed");
        }
    } else {
        panic("parse failed");
    }
}

test "resolve relative path" {
    if let Ok(base) = Url::parse("http://example.com/a/b") {
        if let Ok(resolved) = base.resolve("c") {
            assert resolved.host == "example.com";
            assert resolved.path == "/a/c";
        } else {
            panic("resolve failed");
        }
    } else {
        panic("parse failed");
    }
}

test "resolve dot segments" {
    if let Ok(base) = Url::parse("http://example.com/a/b/c") {
        if let Ok(resolved) = base.resolve("../d") {
            assert resolved.path == "/a/d";
        } else {
            panic("resolve failed");
        }
    } else {
        panic("parse failed");
    }
}

test "resolve double dot" {
    if let Ok(base) = Url::parse("http://example.com/a/b/c") {
        if let Ok(resolved) = base.resolve("../../d") {
            assert resolved.path == "/d";
        } else {
            panic("resolve failed");
        }
    } else {
        panic("parse failed");
    }
}

test "resolve empty reference preserves base" {
    if let Ok(base) = Url::parse("http://example.com/path?q=1") {
        if let Ok(resolved) = base.resolve("") {
            assert resolved.path == "/path";
            assert resolved.query matches { Some("q=1") };
        } else {
            panic("resolve failed");
        }
    } else {
        panic("parse failed");
    }
}

test "resolve query-only reference" {
    if let Ok(base) = Url::parse("http://example.com/path?old=1") {
        if let Ok(resolved) = base.resolve("?new=2") {
            assert resolved.path == "/path";
            assert resolved.query matches { Some("new=2") };
        } else {
            panic("resolve failed");
        }
    } else {
        panic("parse failed");
    }
}

test "resolve fragment-only reference" {
    if let Ok(base) = Url::parse("http://example.com/path") {
        if let Ok(resolved) = base.resolve("#section") {
            assert resolved.path == "/path";
            assert resolved.fragment matches { Some("section") };
        } else {
            panic("resolve failed");
        }
    } else {
        panic("parse failed");
    }
}

test "resolve with new authority" {
    if let Ok(base) = Url::parse("http://example.com/a") {
        if let Ok(resolved) = base.resolve("//other.com/b") {
            assert resolved.scheme == "http";
            assert resolved.host == "other.com";
            assert resolved.path == "/b";
        } else {
            panic("resolve failed");
        }
    } else {
        panic("parse failed");
    }
}

// --- Parse-time normalization ---

test "parse normalizes scheme and host to lowercase" {
    if let Ok(url) = Url::parse("HTTP://EXAMPLE.COM/path") {
        assert url.scheme == "http";
        assert url.host == "example.com";
    } else {
        panic("parse failed");
    }
}

test "parse normalizes default port to None" {
    if let Ok(url) = Url::parse("http://example.com:80/") {
        assert url.port matches { None };
    } else {
        panic("parse failed");
    }
}

test "parse normalizes dot segments" {
    if let Ok(url) = Url::parse("http://example.com/a/b/../c/./d") {
        assert url.path == "/a/c/d";
    } else {
        panic("parse failed");
    }
}

test "parse normalizes percent encoding" {
    if let Ok(url) = Url::parse("http://example.com/%41%42%43") {
        assert url.path == "/ABC";
    } else {
        panic("parse failed");
    }
}

// --- Eq ---

test "eq same url" {
    if let Ok(a) = Url::parse("http://example.com/path") {
        if let Ok(b) = Url::parse("http://example.com/path") {
            assert a == b;
        }
    }
}

test "eq different case scheme and host" {
    if let Ok(a) = Url::parse("HTTP://EXAMPLE.COM/path") {
        if let Ok(b) = Url::parse("http://example.com/path") {
            assert a == b;
        }
    }
}

test "eq default port vs no port" {
    if let Ok(a) = Url::parse("http://example.com:80/") {
        if let Ok(b) = Url::parse("http://example.com/") {
            assert a == b;
        }
    }
}

test "not eq different paths" {
    if let Ok(a) = Url::parse("http://example.com/a") {
        if let Ok(b) = Url::parse("http://example.com/b") {
            assert !(a == b);
        }
    }
}

// --- Url::from_parts ---

test "from_parts simple" {
    let url = Url::from_parts("https", "example.com", Option::Some("/path?q=1"), null);
    assert url.scheme == "https";
    assert url.host == "example.com";
    assert url.path == "/path";
    assert url.query matches { Some("q=1") };
    assert url.fragment matches { None };
    assert url.to_string() == "https://example.com/path?q=1";
}

test "from_parts with port" {
    let url = Url::from_parts("http", "example.com:8080", Option::Some("/"), null);
    assert url.host == "example.com";
    assert url.port matches { Some(8080) };
    assert url.to_string() == "http://example.com:8080/";
}

test "from_parts null path defaults to slash" {
    let url = Url::from_parts("http", "example.com", null, null);
    assert url.path == "/";
    assert url.to_string() == "http://example.com/";
}

test "from_parts empty path defaults to slash" {
    let url = Url::from_parts("http", "example.com", Option::Some(""), null);
    assert url.path == "/";
    assert url.to_string() == "http://example.com/";
}

test "from_parts adds missing leading slash" {
    let url = Url::from_parts("http", "example.com", Option::Some("foo"), null);
    assert url.path == "/foo";
    assert url.to_string() == "http://example.com/foo";
}

test "from_parts with userinfo in authority" {
    let url = Url::from_parts("https", "user:pass@example.com", Option::Some("/"), null);
    assert url.username == "user";
    assert url.password == "pass";
    assert url.host == "example.com";
}

test "from_parts with fragment" {
    let url = Url::from_parts("https", "example.com", Option::Some("/foo"), Option::Some("section-1"));
    assert url.fragment matches { Some("section-1") };
    assert url.to_string() == "https://example.com/foo#section-1";
}

test "from_parts accepts non-special scheme" {
    let url = Url::from_parts("ftp", "example.com", Option::Some("/file"), null);
    assert url.scheme == "ftp";
    assert url.host == "example.com";
    assert url.to_string() == "ftp://example.com/file";
}

test "from_parts lowercases scheme" {
    let url = Url::from_parts("HTTPS", "example.com", Option::Some("/"), null);
    assert url.scheme == "https";
}

test "from_parts trailing question mark keeps empty query" {
    let url = Url::from_parts("http", "example.com", Option::Some("/foo?"), null);
    assert url.path == "/foo";
    assert url.query matches { Some("") };
}

// --- query_params ---

test "query_params returns parsed map" {
    let url = Url::from_parts("http", "example.com", Option::Some("/foo?a=1&b=2"), null);
    let params = url.query_params();
    assert params.len() == 2;
    assert params.get("a") matches { Some("1") };
    assert params.get("b") matches { Some("2") };
}

test "query_params empty when no query" {
    let url = Url::from_parts("http", "example.com", Option::Some("/foo"), null);
    assert url.query_params().len() == 0;
}

test "query_params decodes percent encoding" {
    let url = Url::from_parts("http", "example.com", Option::Some("/search?q=hello%20world"), null);
    assert url.query_params().get("q") matches { Some("hello world") };
}

// --- percent_encode / percent_decode ---

test "percent_encode unreserved pass through" {
    assert percent_encode("hello") == "hello";
    assert percent_encode("test-value_123.txt~") == "test-value_123.txt~";
}

test "percent_encode special chars" {
    assert percent_encode("hello world") == "hello%20world";
    assert percent_encode("a/b") == "a%2Fb";
    assert percent_encode("key=val") == "key%3Dval";
}

test "percent_encode empty" {
    assert percent_encode("") == "";
}

test "percent_decode simple" {
    assert percent_decode("hello%20world") matches { Ok("hello world") };
    assert percent_decode("a%2Fb") matches { Ok("a/b") };
}

test "percent_decode no encoding" {
    assert percent_decode("hello") matches { Ok("hello") };
}

test "percent_decode empty" {
    assert percent_decode("") matches { Ok("") };
}

test "percent_decode invalid hex" {
    assert percent_decode("%GG") matches { Err(InvalidPercentEncoding) };
}

test "percent_decode truncated" {
    assert percent_decode("%2") matches { Err(InvalidPercentEncoding) };
}

test "percent_encode roundtrip" {
    let original = "hello world/foo?bar=baz&x=y";
    let encoded = percent_encode(original);
    if let Ok(decoded) = percent_decode(encoded) {
        assert decoded == original;
    } else {
        panic("roundtrip failed");
    }
}

// --- parse_query / format_query ---

test "parse_query simple" {
    let params = parse_query("a=1&b=2");
    assert params.len() == 2;
    assert params.get("a") matches { Some("1") };
    assert params.get("b") matches { Some("2") };
}

test "parse_query plus as space" {
    let params = parse_query("name=hello+world");
    assert params.len() == 1;
    assert params.get("name") matches { Some("hello world") };
}

test "parse_query percent encoded" {
    let params = parse_query("key=hello%20world");
    assert params.len() == 1;
    assert params.get("key") matches { Some("hello world") };
}

test "parse_query empty value" {
    let params = parse_query("key=");
    assert params.len() == 1;
    assert params.get("key") matches { Some("") };
}

test "parse_query no value" {
    let params = parse_query("key");
    assert params.len() == 1;
    assert params.get("key") matches { Some("") };
}

test "parse_query empty" {
    assert parse_query("").len() == 0;
}

test "parse_query duplicate keys last wins" {
    let params = parse_query("a=1&b=2&a=3");
    assert params.len() == 2;
    assert params.get("a") matches { Some("3") };
    assert params.get("b") matches { Some("2") };
    let keys = params.keys();
    assert keys[0] == "a";
    assert keys[1] == "b";
}

test "format_query simple" {
    let mut params = TreeMap::<String, String>::new();
    params["a"] = "1";
    params["b"] = "2";
    assert format_query(params) == "a=1&b=2";
}

test "format_query encodes spaces" {
    let mut params = TreeMap::<String, String>::new();
    params["name"] = "hello world";
    assert format_query(params) == "name=hello+world";
}

test "format_query empty" {
    let params = TreeMap::<String, String>::new();
    assert format_query(params) == "";
}

test "parse_query format_query roundtrip" {
    let mut original = TreeMap::<String, String>::new();
    original["key"] = "value";
    original["name"] = "Alice Bob";
    let formatted = format_query(original);
    let parsed = parse_query(formatted);
    assert parsed.len() == 2;
    assert parsed.get("key") matches { Some("value") };
    assert parsed.get("name") matches { Some("Alice Bob") };
}

// --- Struct construction ---

test "construct Url from fields" {
    let url = Url {
        scheme: "https",
        username: "",
        password: "",
        host: "example.com",
        port: null,
        path: "/search",
        query: Option::Some("q=hello%20world"),
        fragment: null,
    };
    assert url.to_string() == "https://example.com/search?q=hello%20world";
}

// --- Display ---

test "display via template string" {
    if let Ok(url) = Url::parse("https://example.com/path") {
        assert `{url}` == "https://example.com/path";
    } else {
        panic("parse failed");
    }
}

// --- Non-ASCII / Unicode ---

test "percent_encode emoji" {
    let encoded = percent_encode("🍣");
    assert encoded == "%F0%9F%8D%A3";
}

test "percent_encode Japanese" {
    let encoded = percent_encode("東京");
    assert encoded == "%E6%9D%B1%E4%BA%AC";
}

test "percent_encode mixed ASCII and non-ASCII" {
    let encoded = percent_encode("café");
    assert encoded == "caf%C3%A9";
}

test "percent_decode emoji roundtrip" {
    let original = "hello 🌍 world";
    let encoded = percent_encode(original);
    if let Ok(decoded) = percent_decode(encoded) {
        assert decoded == original;
    } else {
        panic("roundtrip failed");
    }
}

test "percent_decode Japanese roundtrip" {
    let original = "検索キーワード";
    let encoded = percent_encode(original);
    if let Ok(decoded) = percent_decode(encoded) {
        assert decoded == original;
    } else {
        panic("roundtrip failed");
    }
}

test "parse_query with non-ASCII value" {
    let params = parse_query("city=%E6%9D%B1%E4%BA%AC&tag=%F0%9F%8D%A3");
    assert params.len() == 2;
    assert params.get("city") matches { Some("東京") };
    assert params.get("tag") matches { Some("🍣") };
}

test "format_query with non-ASCII value" {
    let mut params = TreeMap::<String, String>::new();
    params["city"] = "東京";
    let formatted = format_query(params);
    let parsed = parse_query(formatted);
    assert parsed.get("city") matches { Some("東京") };
}

test "char len_utf8" {
    assert 'A'.len_utf8() == 1;
    assert 'é'.len_utf8() == 2;
    assert '東'.len_utf8() == 3;
    assert '🍣'.len_utf8() == 4;
}

test "char encode_utf8" {
    let bytes = 'A'.encode_utf8();
    assert bytes.len() == 1;
    assert bytes[0] == 65;

    let bytes = '🍣'.encode_utf8();
    assert bytes.len() == 4;
    assert bytes[0] == 0xF0;
    assert bytes[1] == 0x9F;
    assert bytes[2] == 0x8D;
    assert bytes[3] == 0xA3;
}

// --- Serialize / Deserialize ---

test "serialize Url to JSON" {
    if let Ok(url) = Url::parse("https://example.com/path?q=1") {
        let r = to_string::<Url>(&url);
        assert r matches { Ok(s) && s == `"https://example.com/path?q=1"` };
    } else {
        panic("parse failed");
    }
}

test "deserialize Url from JSON" {
    let r = from_string::<Url>(`"https://example.com/path?q=1"`);
    if let Ok(url) = r {
        assert url.scheme == "https";
        assert url.host == "example.com";
        assert url.path == "/path";
        assert url.query matches { Some("q=1") };
    } else {
        panic("deserialize failed");
    }
}

test "serialize deserialize Url roundtrip" {
    if let Ok(original) = Url::parse("https://user:pass@example.com:8443/api/v1?key=val#frag") {
        let json = to_string::<Url>(&original);
        if let Ok(json_str) = json {
            let restored = from_string::<Url>(json_str);
            if let Ok(url) = restored {
                assert url == original;
            } else {
                panic("deserialize failed");
            }
        } else {
            panic("serialize failed");
        }
    } else {
        panic("parse failed");
    }
}

test "deserialize Url invalid string" {
    let r = from_string::<Url>(`"not-a-url"`);
    assert r matches { Err(_) };
}
