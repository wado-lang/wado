#![wasm_module("mem")]
#![no_prelude]
#![stdlib("core:allocator")]

/// This module defines the linear memory allocator for the Component Model.
/// All items here are compiled into a separate Wasm core module named "mem".
///
/// Three allocator implementations are provided:
/// - `bump_realloc`: Default bump allocator with free-rewind optimization.
/// - `debug_realloc`: Debug allocator that poisons freed memory with 0xFF
///   and never reuses freed addresses (for use-after-free detection).
/// - `freelist_realloc`: Free-list allocator that reclaims freed memory.
///   Suitable for long-living processes (e.g. HTTP servers).
///
/// The compiler selects one based on `--allocator` flag or target world,
/// and DCE removes the unused implementations.

/// Bump allocator heap pointer. Starts at 8 to avoid returning address 0 (null sentinel).
global mut heap_offset: i32 = 8;

/// Grow linear memory using a doubling strategy up to 16 MB, then 16 MB steps.
fn grow_memory(new_offset: i32) {
    let current_bytes = builtin::memory_size() * 65536;
    let deficit = new_offset - current_bytes;
    // Normal growth: double current size, capped at 16 MB
    let sixteen_mb = 16 * 1024 * 1024;
    let normal_grow = if current_bytes < sixteen_mb { current_bytes } else { sixteen_mb };
    // If deficit exceeds normal growth, round up to next power of two
    let grow_bytes = if deficit > normal_grow { 1 << 32 - builtin::i32_clz(deficit - 1) } else { normal_grow };
    let grow_pages = (grow_bytes + 65535) / 65536;
    builtin::memory_grow(grow_pages);
}

/// Bump allocator — advances a pointer with alignment.
/// When newsize is 0 and the allocation was the most recent one, rewinds the heap pointer.
/// Selected by `--allocator bump` (default for CLI/HTTP worlds).
#[allocator("bump")]
export fn bump_realloc(oldptr: i32, oldsize: i32, align: i32, newsize: i32) -> i32 {
    // Free: rewind if this was the most recent allocation
    if newsize == 0 {
        if oldptr + oldsize == heap_offset {
            heap_offset = oldptr;
        }
        return 0;
    }

    let aligned = builtin::i32_and(heap_offset + align - 1, 0 - align);
    let new_offset = aligned + newsize;

    if builtin::unlikely(new_offset > builtin::memory_size() * 65536) {
        grow_memory(new_offset);
    }

    heap_offset = new_offset;

    return aligned;
}

/// Debug allocator — advances a pointer with alignment, never reuses freed memory.
/// When newsize is 0, poisons the freed region with 0xFF bytes.
/// Selected by `--allocator debug` or automatically for the test world.
#[allocator("debug")]
export fn debug_realloc(oldptr: i32, oldsize: i32, align: i32, newsize: i32) -> i32 {
    // Free: poison freed memory with 0xFF, never reuse
    if newsize == 0 {
        if oldsize > 0 {
            builtin::memory_fill(oldptr, 0xFF, oldsize);
        }
        return 0;
    }

    let aligned = builtin::i32_and(heap_offset + align - 1, 0 - align);
    let new_offset = aligned + newsize;

    if builtin::unlikely(new_offset > builtin::memory_size() * 65536) {
        grow_memory(new_offset);
    }

    heap_offset = new_offset;

    return aligned;
}

/// Free-list allocator — reclaims freed memory with a *deferred-coalescing*,
/// size-class-segregated free list. Suitable for long-running processes
/// (e.g. HTTP servers).
///
/// Every block carries an 8-byte header and 8-byte footer (boundary
/// tags), both holding `block_size | used_bit`.
///
/// Free blocks are kept in segregated free lists — one doubly-linked
/// list per size class. Bin `k` (k < 32) holds blocks of size exactly
/// `32 + 16*k`; bin 32 is the catch-all "large" bin (first-fit).
/// Allocation goes straight to the size class's bin, so the common case
/// is O(1) rather than a first-fit scan over every free block.
///
/// Coalescing is *deferred*: a free never inspects its neighbours, it
/// just returns the block to its size-class bin. A long-running server
/// with a repeating per-request allocation pattern therefore reuses each
/// freed block straight from its exact bin, with no merge/re-split churn.
/// Adjacent free blocks are merged only by `fl_coalesce_all`, in a single
/// heap sweep run when an allocation finds no fit — i.e. just before the
/// heap would otherwise have to grow. That keeps fragmentation bounded
/// (the heap never grows while coalescing could still satisfy a request)
/// without taxing every free.
///
/// Block layout (size a multiple of 16):
///   [ size|used : i32 ][ pad : i32 ][ payload … ][ size|used : i32 ][ pad : i32 ]
/// Block sizes are multiples of 16 and the first block sits at an address
/// congruent to 8 (mod 16), so `alloc` returns `block + 8` — a payload
/// that is always 16-byte aligned. That satisfies every alignment
/// `realloc` is ever called with: Component Model alignments are all
/// <= 8, and the widest Wasm alignment, `v128`, is 16.
///
/// The 33 bin heads live in memory at `[8, 8 + 4*33)`; the first block
/// starts at byte 152 (the lowest address past the bin-head table that
/// is congruent to 8 mod 16). Wasm memory is zero-initialised, so every
/// bin head starts empty.
///
/// The algorithm is exercised end-to-end by the `allocator_freelist_*`
/// fixtures in `tests/fixtures/`.
///
/// Selected by `--allocator freelist` (default for HTTP service world).

/// Block size encoded in a boundary tag (clears the low 3 bits).
fn fl_size(tag: i32) -> i32 {
    return builtin::i32_and(tag, -8);
}

/// Used-bit of a boundary tag (1 = in use, 0 = free).
fn fl_used(tag: i32) -> i32 {
    return builtin::i32_and(tag, 1);
}

/// Size-class bin index for a block of `size` bytes: an exact bin per
/// 16-byte step for small blocks, bin 32 for everything larger.
fn fl_bin(size: i32) -> i32 {
    let k = (size - 32) / 16;
    return if k < 32 { k } else { 32 };
}

/// Head of size-class bin `k` (0 when empty). The bin-head table is the
/// reserved memory region starting at byte 8.
fn fl_bin_head(k: i32) -> i32 {
    return builtin::i32_load(8 + k * 4);
}

/// Set the head of size-class bin `k`.
fn fl_set_bin_head(k: i32, head: i32) {
    builtin::i32_store(8 + k * 4, head);
}

/// Write the header and footer boundary tags of the block at `block`.
fn fl_set_tags(block: i32, size: i32, used: i32) {
    // `size` is a multiple of 16 and `used` is 0 or 1, so `+` acts as `|`.
    let tag = size + used;
    builtin::i32_store(block, tag);
    builtin::i32_store(block + size - 8, tag);
}

/// Insert `block` (of `size` bytes) at the head of its size-class bin.
fn fl_push(block: i32, size: i32) {
    let k = fl_bin(size);
    let head = fl_bin_head(k);
    builtin::i32_store(block + 8, head);
    builtin::i32_store(block + 12, 0);
    if head != 0 {
        builtin::i32_store(head + 12, block);
    }
    fl_set_bin_head(k, block);
}

/// Remove `block` from its size-class bin (it must currently be linked).
fn fl_unlink(block: i32) {
    let next = builtin::i32_load(block + 8);
    let prev = builtin::i32_load(block + 12);
    if prev == 0 {
        // Only a head block needs its bin index, so compute it here
        // rather than unconditionally.
        let k = fl_bin(fl_size(builtin::i32_load(block)));
        fl_set_bin_head(k, next);
    } else {
        builtin::i32_store(prev + 8, next);
    }
    if next != 0 {
        builtin::i32_store(next + 12, prev);
    }
}

/// Mark the block at `block` (currently sized `block_size`) used for an
/// allocation of `size` bytes, splitting off the remainder as a free
/// block when it is large enough (>= the 32-byte minimum).
fn fl_carve(block: i32, block_size: i32, size: i32) {
    let remainder = block_size - size;
    if remainder >= 32 {
        fl_set_tags(block, size, 1);
        let rest = block + size;
        fl_set_tags(rest, remainder, 0);
        fl_push(rest, remainder);
    } else {
        fl_set_tags(block, block_size, 1);
    }
}

/// Take a free block of at least `size` bytes from the segregated free
/// lists, carving off any excess. Returns the payload pointer, or 0 when
/// no free block fits.
fn fl_take(size: i32) -> i32 {
    // Exact size-class bin first, then larger small bins: any block in a
    // bin at index >= fl_bin(size) is large enough.
    let mut j = fl_bin(size);
    while j < 32 {
        let b = fl_bin_head(j);
        if b != 0 {
            let block_size = fl_size(builtin::i32_load(b));
            fl_unlink(b);
            fl_carve(b, block_size, size);
            return b + 8;
        }
        j += 1;
    }

    // Large bin: first-fit over the catch-all list.
    let mut curr = fl_bin_head(32);
    while curr != 0 {
        let block_size = fl_size(builtin::i32_load(curr));
        if block_size >= size {
            fl_unlink(curr);
            fl_carve(curr, block_size, size);
            return curr + 8;
        }
        curr = builtin::i32_load(curr + 8);
    }

    return 0;
}

/// Merge every run of physically-adjacent free blocks into one block.
///
/// Deferred coalescing: `freelist_realloc` keeps frees cheap by never
/// inspecting neighbours, so the segregated bins keep holding a block of
/// each freed size for O(1) same-size reuse — the common case for a
/// long-running server. Fragmentation is reclaimed here instead, in a
/// single sweep run only when an allocation would otherwise have to grow
/// the heap.
fn fl_coalesce_all() {
    let mut block = 152;
    while block < heap_offset {
        let header = builtin::i32_load(block);
        let size = fl_size(header);
        if fl_used(header) == 0 {
            // Extend a run over the following physically-adjacent free
            // blocks.
            let mut run_end = block + size;
            while run_end < heap_offset
                && fl_used(builtin::i32_load(run_end)) == 0 {
                run_end += fl_size(builtin::i32_load(run_end));
            }
            let merged = run_end - block;
            if merged != size {
                // The run spans more than one block: unlink every free
                // block in it, then relink a single merged block.
                let mut p = block;
                while p < run_end {
                    let p_size = fl_size(builtin::i32_load(p));
                    fl_unlink(p);
                    p += p_size;
                }
                fl_set_tags(block, merged, 0);
                fl_push(block, merged);
            }
            block = run_end;
        } else {
            block += size;
        }
    }
}

// `oldsize` and `align` are unused: a freed block's size is read from its
// own boundary tag (authoritative — it includes rounding and any no-split
// slack), and every block payload is unconditionally 16-byte aligned,
// which satisfies every alignment `realloc` is called with (Component
// Model alignments are all <= 8; the widest Wasm alignment, `v128`, is 16).
#[allocator("freelist")]
export fn freelist_realloc(oldptr: i32, _oldsize: i32, _align: i32, newsize: i32) -> i32 {
    // The shared `heap_offset` global starts at 8; on first use, reserve
    // [8, 8 + 4*33) for the bin-head table and move the heap frontier to
    // 152 — past the table and congruent to 8 mod 16, so payloads land
    // 16-byte aligned. Wasm memory is zero-initialised, so the bins start
    // empty.
    if heap_offset < 152 {
        heap_offset = 152;
    }

    if newsize == 0 {
        // Free. `oldptr == 0` (freeing null) is a no-op.
        if oldptr == 0 {
            return 0;
        }
        let block = oldptr - 8;
        let header = builtin::i32_load(block);
        // Double-free guard: the block is already marked free.
        if fl_used(header) == 0 {
            builtin::unreachable();
        }
        // Deferred coalescing: return the block to its size-class bin
        // without inspecting neighbours, so the bins keep a block of
        // this exact size ready for O(1) reuse. Adjacent free blocks are
        // merged later by `fl_coalesce_all`, only under allocation
        // pressure.
        let size = fl_size(header);
        fl_set_tags(block, size, 0);
        fl_push(block, size);
        return 0;
    }

    // Allocate. Round the payload up to 16 bytes and add the boundary-tag
    // overhead; the result is a multiple of 16 (keeping every block's
    // payload 16-byte aligned) and at least the 32-byte minimum block.
    let size = builtin::i32_and(newsize + 15, -16) + 16;

    // Serve from the free lists. On a miss, run one coalescing sweep —
    // deferred coalescing concentrates the merge work here, where it is
    // actually needed — and retry before growing the heap.
    let mut payload = fl_take(size);
    if payload == 0 {
        fl_coalesce_all();
        payload = fl_take(size);
    }
    if payload != 0 {
        return payload;
    }

    // No fit even after coalescing: bump-allocate a fresh block.
    let block = heap_offset;
    let new_offset = block + size;
    if builtin::unlikely(new_offset > builtin::memory_size() * 65536) {
        grow_memory(new_offset);
    }
    heap_offset = new_offset;
    fl_set_tags(block, size, 1);
    return block + 8;
}
