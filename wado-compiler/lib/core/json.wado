            return match f64::from_str(raw) {
                Ok(v) && v != f64::floor(v) => Result::Err(DeserializeError::unexpected_type(
                    "expected integer, got float",
                    start,
                )),
                Ok(v) && v < -2147483648.0 || v > 2147483647.0 => Result::Err(
                    DeserializeError::overflow("value out of range for i32", start),
                ),
                Ok(v) => Result::Ok(v as i32),
                Err(_) => Result::Err(DeserializeError::invalid_value("invalid number", start)),
            };
        }
        return match i32::from_str(raw) {
            Ok(v) => Result::Ok(v),
            Err(e) => Result::Err(match e.kind() {
                PosOverflow | NegOverflow => DeserializeError::overflow(
                    "value out of range for i32",
                    start,
                ),
                _ => DeserializeError::invalid_value("invalid digit in number", start),
            }),
