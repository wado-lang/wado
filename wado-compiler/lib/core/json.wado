                } else {
                    break;
                }
            }
        }
        if self.pos < self.input.len() {
            let b = self.input.get_byte_unchecked(self.pos) as i32;
            if b == 'e' as i32 || b == 'E' as i32 {
                self.pos += 1;
                if self.pos < self.input.len() {
                    let sign = self.input.get_byte_unchecked(self.pos) as i32;
