    /// Single-pass f64 parsing directly from self.input using fpfmt.
    /// No intermediate String allocation.
    pub fn parse_f64_direct(&mut self) -> Result<f64, DeserializeError> {
        self.skip_whitespace();
        let start = self.pos as i64;
        if self.pos >= self.input.len() {
            return Result::Err(DeserializeError::eof(start));
        }
        let mut neg = false;
        if self.input.get_byte_unchecked(self.pos) as i32 == '-' as i32 {
            neg = true;
            self.pos += 1;
        }
        if self.pos >= self.input.len() {
            return Result::Err(DeserializeError::eof(self.pos as i64));
        }
        let first = self.input.get_byte_unchecked(self.pos) as i32;
        if first < '0' as i32 || first > '9' as i32 {
            return Result::Err(DeserializeError::unexpected_type(
                "expected number",
                self.pos as i64,
            ));
        }
        let mut d: u64 = (first - '0' as i32) as u64;
        let mut total_digits = 1;
        self.pos += 1;
        while self.pos < self.input.len() {
            let b = self.input.get_byte_unchecked(self.pos) as i32;
            if '0' as i32 <= b <= '9' as i32 {
                if total_digits < 19 {
                    d = d * 10 + (b - '0' as i32) as u64;
                }
                total_digits += 1;
                self.pos += 1;
            } else {
                break;
            }
        }
        let mut frac = 0;
        if self.pos < self.input.len() && self.input.get_byte_unchecked(self.pos) as i32 == '.' as i32 {
            self.pos += 1;
            while self.pos < self.input.len() {
                let b = self.input.get_byte_unchecked(self.pos) as i32;
                if '0' as i32 <= b <= '9' as i32 {
                    if total_digits < 19 {
                        d = d * 10 + (b - '0' as i32) as u64;
                        frac += 1;
                    }
                    total_digits += 1;
                    self.pos += 1;
                } else {
                    break;
                }
            }
        }
        let mut exp = 0;
        if self.pos < self.input.len() {
            let eb = self.input.get_byte_unchecked(self.pos) as i32;
            if eb == 'e' as i32 || eb == 'E' as i32 {
                self.pos += 1;
                let mut exp_neg = false;
                if self.pos < self.input.len() {
                    let sb = self.input.get_byte_unchecked(self.pos) as i32;
                    if sb == '-' as i32 {
                        exp_neg = true;
                        self.pos += 1;
                    } else if sb == '+' as i32 {
                        self.pos += 1;
                    }
                }
                while self.pos < self.input.len() {
                    let b3 = self.input.get_byte_unchecked(self.pos) as i32;
                    if '0' as i32 <= b3 <= '9' as i32 {
                        exp = exp * 10 + (b3 - '0' as i32);
                        self.pos += 1;
                    } else {
                        break;
                    }
                }
                if exp_neg {
                    exp = -exp;
                }
            }
        }
        if d == 0 {
            let v = if neg { -0.0 } else { 0.0 };
            return Result::Ok(v);
        }
        // Adjust for digits beyond 19 that were not accumulated
        let extra_int_digits = if total_digits - frac > 19 { total_digits - frac - 19 } else { 0 };
        let eff_p = exp - frac + extra_int_digits;
        if eff_p > 350 {
            let v = if neg { f64::NEG_INFINITY } else { f64::INFINITY };
            return Result::Ok(v);
        }
        if eff_p < -351 {
            let v = if neg { -0.0 } else { 0.0 };
            return Result::Ok(v);
        }
        let v = fpfmt_parse(d, eff_p);
        if neg {
            return Result::Ok(-v);
        }
        return Result::Ok(v);
