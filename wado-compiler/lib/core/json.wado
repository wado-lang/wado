        }
        if self.pos < self.input.len() && self.input.get_byte_unchecked(self.pos) as i32 == '.' as i32 {
            self.pos += 1;
            while self.pos < self.input.len() {
                let b = self.input.get_byte_unchecked(self.pos) as i32;
                if '0' as i32 <= b <= '9' as i32 {
