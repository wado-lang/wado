//! JSON serialization and deserialization (self-describing format).
//!
//! Implements the `core:serde` `Serializer` and `Deserializer` traits for JSON.
//!
//! Usage:
//!   use { to_string, from_string } from "core:json";
//!
//!   let json = to_string::<i32>(&42);            // "42"
//!   let val = from_string::<i32>("42");           // Result::Ok(42)
#![stdlib("core:json")]

use {
    Serialize,
    Deserialize,
    Serializer,
    Deserializer,
    SerializeSeq,
    SerializeMap,
    SerializeStruct,
    SerializeVariant,
    DeserializeSeq,
    DeserializeMap,
    DeserializeStruct,
    DeserializeVariant,
    SerializeError,
    SerializeErrorKind,
    DeserializeError,
    DeserializeErrorKind,
    Visitor,
} from "core:serde";

use { parse as fpfmt_parse } from "core:prelude/fpfmt.wado";

/// Writes a JSON-escaped string (with surrounding quotes) into buf.
pub fn write_escaped_string(buf: &mut String, s: &String) {
    buf.push('"');
    for let c of s.chars() {
        match c {
            '"' => buf.push_str(&"\\\""),
            '\\' => buf.push_str(&"\\\\"),
            '\n' => buf.push_str(&"\\n"),
            '\r' => buf.push_str(&"\\r"),
            '\t' => buf.push_str(&"\\t"),
            _ => {
                if (c as u32) < 0x20 {
                    let code = c as i32;
                    buf.push_str(&`\\u{code:04x}`);
                } else {
                    buf.push(c);
                }
            },
        }
    }
    buf.push('"');
}

struct JsonSeqSerializer {
    buf: &mut String,
    count: i32,
}

struct JsonMapSerializer {
    buf: &mut String,
    count: i32,
    need_value: bool,
}

struct JsonStructSerializer {
    buf: &mut String,
    count: i32,
}

struct JsonVariantSerializer {
    buf: &mut String,
}

pub struct JsonSerializer {
    buf: &mut String,
}

fn write_pretty_newline_and_indent(buf: &mut String, indent: &String, depth: i32) {
    buf.push('\n');
    for let mut i = 0; i < depth; i += 1 {
        buf.push_str(indent);
    }
}

impl SerializeSeq for JsonSeqSerializer {
    fn element<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.buf.push_str(&",");
        }
        let mut ser = JsonSerializer { buf: self.buf };
        let r = value.serialize::<JsonSerializer>(&mut ser);
        self.buf = ser.buf;
        self.count += 1;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.buf.push_str(&"]");
        return Result::Ok(());
    }
}

impl SerializeMap for JsonMapSerializer {
    fn key<T: Serialize>(&mut self, key: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.buf.push_str(&",");
        }
        let mut ser = JsonSerializer { buf: self.buf };
        let r = key.serialize::<JsonSerializer>(&mut ser);
        self.buf = ser.buf;
        self.buf.push_str(&":");
        self.need_value = true;
        return r;
    }

    fn value<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        let mut ser = JsonSerializer { buf: self.buf };
        let r = value.serialize::<JsonSerializer>(&mut ser);
        self.buf = ser.buf;
        self.count += 1;
        self.need_value = false;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.buf.push_str(&"}");
        return Result::Ok(());
    }
}

impl SerializeStruct for JsonStructSerializer {
    fn field<T: Serialize>(&mut self, name: &String, value: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.buf.push_str(&",");
        }
        write_escaped_string(self.buf, name);
        self.buf.push_str(&":");
        let mut ser = JsonSerializer { buf: self.buf };
        let r = value.serialize::<JsonSerializer>(&mut ser);
        self.buf = ser.buf;
        self.count += 1;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.buf.push_str(&"}");
        return Result::Ok(());
    }
}

impl SerializeVariant for JsonVariantSerializer {
    fn payload<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        let mut ser = JsonSerializer { buf: self.buf };
        let r = value.serialize::<JsonSerializer>(&mut ser);
        self.buf = ser.buf;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.buf.push_str(&"}");
        return Result::Ok(());
    }
}

impl Serializer for JsonSerializer {
    type SeqSerializer = JsonSeqSerializer;
    type MapSerializer = JsonMapSerializer;
    type StructSerializer = JsonStructSerializer;
    type VariantSerializer = JsonVariantSerializer;

    fn serialize_i32(&mut self, v: i32) -> Result<(), SerializeError> {
        self.buf.push_str(&`{v}`);
        return Result::Ok(());
    }

    fn serialize_i64(&mut self, v: i64) -> Result<(), SerializeError> {
        // Values outside ±2^53-1 are serialized as strings for JS safety
        if v > 9007199254740991 || v < -9007199254740991 {
            self.buf.push_str(&`"{v}"`);
        } else {
            self.buf.push_str(&`{v}`);
        }
        return Result::Ok(());
    }

    fn serialize_u32(&mut self, v: u32) -> Result<(), SerializeError> {
        self.buf.push_str(&`{v}`);
        return Result::Ok(());
    }

    fn serialize_u64(&mut self, v: u64) -> Result<(), SerializeError> {
        // Values above 2^53-1 are serialized as strings for JS safety
        if v > 9007199254740991 {
            self.buf.push_str(&`"{v}"`);
        } else {
            self.buf.push_str(&`{v}`);
        }
        return Result::Ok(());
    }

    fn serialize_i128(&mut self, v: i128) -> Result<(), SerializeError> {
        // i128 always serialized as string (always exceeds JS safe integer range)
        self.buf.push_str(&`"{v}"`);
        return Result::Ok(());
    }

    fn serialize_u128(&mut self, v: u128) -> Result<(), SerializeError> {
        // u128 always serialized as string (always exceeds JS safe integer range)
        self.buf.push_str(&`"{v}"`);
        return Result::Ok(());
    }

    fn serialize_f32(&mut self, v: f32) -> Result<(), SerializeError> {
        if v.is_nan() {
            return Result::Err(SerializeError {
                kind: SerializeErrorKind::UnsupportedValue,
                message: "NaN is not allowed in JSON",
            });
        }
        if !v.is_finite() {
            return Result::Err(SerializeError {
                kind: SerializeErrorKind::UnsupportedValue,
                message: "Infinity is not allowed in JSON",
            });
        }
        self.buf.push_str(&`{v as f64}`);
        return Result::Ok(());
    }

    fn serialize_f64(&mut self, v: f64) -> Result<(), SerializeError> {
        if v.is_nan() {
            return Result::Err(SerializeError {
                kind: SerializeErrorKind::UnsupportedValue,
                message: "NaN is not allowed in JSON",
            });
        }
        if !v.is_finite() {
            return Result::Err(SerializeError {
                kind: SerializeErrorKind::UnsupportedValue,
                message: "Infinity is not allowed in JSON",
            });
        }
        self.buf.push_str(&`{v}`);
        return Result::Ok(());
    }

    fn serialize_bool(&mut self, v: bool) -> Result<(), SerializeError> {
        if v {
            self.buf.push_str(&"true");
        } else {
            self.buf.push_str(&"false");
        }
        return Result::Ok(());
    }

    fn serialize_char(&mut self, v: char) -> Result<(), SerializeError> {
        let s = `{v}`;
        write_escaped_string(self.buf, &s);
        return Result::Ok(());
    }

    fn serialize_string(&mut self, v: &String) -> Result<(), SerializeError> {
        write_escaped_string(self.buf, v);
        return Result::Ok(());
    }

    fn serialize_null(&mut self) -> Result<(), SerializeError> {
        self.buf.push_str(&"null");
        return Result::Ok(());
    }

    fn begin_seq(&mut self, len: i32) -> Result<JsonSeqSerializer, SerializeError> {
        self.buf.push_str(&"[");
        return Result::Ok(JsonSeqSerializer {
            buf: self.buf,
            count: 0,
        });
    }

    fn begin_map(&mut self, len: i32) -> Result<JsonMapSerializer, SerializeError> {
        self.buf.push_str(&"{");
        return Result::Ok(JsonMapSerializer {
            buf: self.buf,
            count: 0,
            need_value: false,
        });
    }

    fn begin_struct(&mut self, name: &String, fields: i32) -> Result<JsonStructSerializer, SerializeError> {
        self.buf.push_str(&"{");
        return Result::Ok(JsonStructSerializer {
            buf: self.buf,
            count: 0,
        });
    }

    fn serialize_unit_variant(&mut self, type_name: &String, variant_name: &String, disc: i32) -> Result<(), SerializeError> {
        write_escaped_string(self.buf, variant_name);
        return Result::Ok(());
    }

    fn begin_variant(&mut self, type_name: &String, variant_name: &String, disc: i32) -> Result<JsonVariantSerializer, SerializeError> {
        self.buf.push_str(&"{");
        write_escaped_string(self.buf, variant_name);
        self.buf.push_str(&":");
        return Result::Ok(JsonVariantSerializer {
            buf: self.buf,
        });
    }
}

struct PrettyJsonSeqSerializer {
    buf: &mut String,
    count: i32,
    indent: &String,
    depth: i32,
}

struct PrettyJsonMapSerializer {
    buf: &mut String,
    count: i32,
    need_value: bool,
    indent: &String,
    depth: i32,
}

struct PrettyJsonStructSerializer {
    buf: &mut String,
    count: i32,
    indent: &String,
    depth: i32,
}

struct PrettyJsonVariantSerializer {
    buf: &mut String,
    indent: &String,
    depth: i32,
}

pub struct PrettyJsonSerializer {
    pub buf: &mut String,
    pub indent: &String,
    pub depth: i32,
}

impl SerializeSeq for PrettyJsonSeqSerializer {
    fn element<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.buf.push_str(&",");
        }
        write_pretty_newline_and_indent(self.buf, self.indent, self.depth);
        let mut ser = PrettyJsonSerializer {
            buf: self.buf,
            indent: self.indent,
            depth: self.depth,
        };
        let r = value.serialize::<PrettyJsonSerializer>(&mut ser);
        self.buf = ser.buf;
        self.count += 1;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        if self.count > 0 {
            write_pretty_newline_and_indent(self.buf, self.indent, self.depth - 1);
        }
        self.buf.push_str(&"]");
        return Result::Ok(());
    }
}

impl SerializeMap for PrettyJsonMapSerializer {
    fn key<T: Serialize>(&mut self, key: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.buf.push_str(&",");
        }
        write_pretty_newline_and_indent(self.buf, self.indent, self.depth);
        let mut ser = PrettyJsonSerializer {
            buf: self.buf,
            indent: self.indent,
            depth: self.depth,
        };
        let r = key.serialize::<PrettyJsonSerializer>(&mut ser);
        self.buf = ser.buf;
        self.buf.push_str(&": ");
        self.need_value = true;
        return r;
    }

    fn value<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        let mut ser = PrettyJsonSerializer {
            buf: self.buf,
            indent: self.indent,
            depth: self.depth,
        };
        let r = value.serialize::<PrettyJsonSerializer>(&mut ser);
        self.buf = ser.buf;
        self.count += 1;
        self.need_value = false;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        if self.count > 0 {
            write_pretty_newline_and_indent(self.buf, self.indent, self.depth - 1);
        }
        self.buf.push_str(&"}");
        return Result::Ok(());
    }
}

impl SerializeStruct for PrettyJsonStructSerializer {
    fn field<T: Serialize>(&mut self, name: &String, value: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.buf.push_str(&",");
        }
        write_pretty_newline_and_indent(self.buf, self.indent, self.depth);
        write_escaped_string(self.buf, name);
        self.buf.push_str(&": ");
        let mut ser = PrettyJsonSerializer {
            buf: self.buf,
            indent: self.indent,
            depth: self.depth,
        };
        let r = value.serialize::<PrettyJsonSerializer>(&mut ser);
        self.buf = ser.buf;
        self.count += 1;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        if self.count > 0 {
            write_pretty_newline_and_indent(self.buf, self.indent, self.depth - 1);
        }
        self.buf.push_str(&"}");
        return Result::Ok(());
    }
}

impl SerializeVariant for PrettyJsonVariantSerializer {
    fn payload<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        let mut ser = PrettyJsonSerializer {
            buf: self.buf,
            indent: self.indent,
            depth: self.depth,
        };
        let r = value.serialize::<PrettyJsonSerializer>(&mut ser);
        self.buf = ser.buf;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        write_pretty_newline_and_indent(self.buf, self.indent, self.depth - 1);
        self.buf.push_str(&"}");
        return Result::Ok(());
    }
}

impl Serializer for PrettyJsonSerializer {
    type SeqSerializer = PrettyJsonSeqSerializer;
    type MapSerializer = PrettyJsonMapSerializer;
    type StructSerializer = PrettyJsonStructSerializer;
    type VariantSerializer = PrettyJsonVariantSerializer;

    fn serialize_i32(&mut self, v: i32) -> Result<(), SerializeError> {
        self.buf.push_str(&`{v}`);
        return Result::Ok(());
    }

    fn serialize_i64(&mut self, v: i64) -> Result<(), SerializeError> {
        if v > 9007199254740991 || v < -9007199254740991 {
            self.buf.push_str(&`"{v}"`);
        } else {
            self.buf.push_str(&`{v}`);
        }
        return Result::Ok(());
    }

    fn serialize_u32(&mut self, v: u32) -> Result<(), SerializeError> {
        self.buf.push_str(&`{v}`);
        return Result::Ok(());
    }

    fn serialize_u64(&mut self, v: u64) -> Result<(), SerializeError> {
        if v > 9007199254740991 {
            self.buf.push_str(&`"{v}"`);
        } else {
            self.buf.push_str(&`{v}`);
        }
        return Result::Ok(());
    }

    fn serialize_i128(&mut self, v: i128) -> Result<(), SerializeError> {
        self.buf.push_str(&`"{v}"`);
        return Result::Ok(());
    }

    fn serialize_u128(&mut self, v: u128) -> Result<(), SerializeError> {
        self.buf.push_str(&`"{v}"`);
        return Result::Ok(());
    }

    fn serialize_f32(&mut self, v: f32) -> Result<(), SerializeError> {
        if v.is_nan() {
            return Result::Err(SerializeError {
                kind: SerializeErrorKind::UnsupportedValue,
                message: "NaN is not allowed in JSON",
            });
        }
        if !v.is_finite() {
            return Result::Err(SerializeError {
                kind: SerializeErrorKind::UnsupportedValue,
                message: "Infinity is not allowed in JSON",
            });
        }
        self.buf.push_str(&`{v as f64}`);
        return Result::Ok(());
    }

    fn serialize_f64(&mut self, v: f64) -> Result<(), SerializeError> {
        if v.is_nan() {
            return Result::Err(SerializeError {
                kind: SerializeErrorKind::UnsupportedValue,
                message: "NaN is not allowed in JSON",
            });
        }
        if !v.is_finite() {
            return Result::Err(SerializeError {
                kind: SerializeErrorKind::UnsupportedValue,
                message: "Infinity is not allowed in JSON",
            });
        }
        self.buf.push_str(&`{v}`);
        return Result::Ok(());
    }

    fn serialize_bool(&mut self, v: bool) -> Result<(), SerializeError> {
        if v {
            self.buf.push_str(&"true");
        } else {
            self.buf.push_str(&"false");
        }
        return Result::Ok(());
    }

    fn serialize_char(&mut self, v: char) -> Result<(), SerializeError> {
        let s = `{v}`;
        write_escaped_string(self.buf, &s);
        return Result::Ok(());
    }

    fn serialize_string(&mut self, v: &String) -> Result<(), SerializeError> {
        write_escaped_string(self.buf, v);
        return Result::Ok(());
    }

    fn serialize_null(&mut self) -> Result<(), SerializeError> {
        self.buf.push_str(&"null");
        return Result::Ok(());
    }

    fn begin_seq(&mut self, len: i32) -> Result<PrettyJsonSeqSerializer, SerializeError> {
        self.buf.push_str(&"[");
        return Result::Ok(PrettyJsonSeqSerializer {
            buf: self.buf,
            count: 0,
            indent: self.indent,
            depth: self.depth + 1,
        });
    }

    fn begin_map(&mut self, len: i32) -> Result<PrettyJsonMapSerializer, SerializeError> {
        self.buf.push_str(&"{");
        return Result::Ok(PrettyJsonMapSerializer {
            buf: self.buf,
            count: 0,
            need_value: false,
            indent: self.indent,
            depth: self.depth + 1,
        });
    }

    fn begin_struct(&mut self, name: &String, fields: i32) -> Result<PrettyJsonStructSerializer, SerializeError> {
        self.buf.push_str(&"{");
        return Result::Ok(PrettyJsonStructSerializer {
            buf: self.buf,
            count: 0,
            indent: self.indent,
            depth: self.depth + 1,
        });
    }

    fn serialize_unit_variant(&mut self, type_name: &String, variant_name: &String, disc: i32) -> Result<(), SerializeError> {
        write_escaped_string(self.buf, variant_name);
        return Result::Ok(());
    }

    fn begin_variant(&mut self, type_name: &String, variant_name: &String, disc: i32) -> Result<PrettyJsonVariantSerializer, SerializeError> {
        self.buf.push_str(&"{");
        write_pretty_newline_and_indent(self.buf, self.indent, self.depth + 1);
        write_escaped_string(self.buf, variant_name);
        self.buf.push_str(&": ");
        return Result::Ok(PrettyJsonVariantSerializer {
            buf: self.buf,
            indent: self.indent,
            depth: self.depth + 1,
        });
    }
}

pub struct JsonDeserializer {
    pub input: String,
    pub pos: i32,
}

impl JsonDeserializer {
    pub fn peek(&self) -> i32 {
        if self.pos >= self.input.len() {
            return -1;
        }
        return self.input.get_byte_unchecked(self.pos) as i32;
    }

    pub fn advance(&mut self) {
        self.pos += 1;
    }

    pub fn skip_whitespace(&mut self) {
        // Fast exit when next byte isn't whitespace. All JSON whitespace bytes
        // (space 0x20, tab 0x09, LF 0x0A, CR 0x0D) are <= 0x20, so the single
        // comparison `b > 32` is enough to reject non-whitespace without
        // checking each character individually.
        while self.pos < self.input.len() {
            let b = self.input.get_byte_unchecked(self.pos) as i32;
            if b > 32 {
                return;
            }
            if b == ' ' as i32 || b == '\t' as i32 || b == '\n' as i32 || b == '\r' as i32 {
                self.pos += 1;
            } else {
                return;
            }
        }
    }

    pub fn expect_char(&mut self, c: i32) -> Result<(), DeserializeError> {
        self.skip_whitespace();
        if self.pos >= self.input.len() {
            return Result::Err(DeserializeError::eof(self.pos as i64));
        }
        let b = self.input.get_byte_unchecked(self.pos) as i32;
        if b != c {
            return Result::Err(DeserializeError::malformed(
                `expected '{c as u8 as char}', found '{b as u8 as char}'`,
                self.pos as i64,
            ));
        }
        self.pos += 1;
        return Result::Ok(());
    }

    pub fn expect_literal(&mut self, lit: String) -> Result<(), DeserializeError> {
        let start = self.pos;
        let lit_len = lit.len();
        if self.pos + lit_len > self.input.len() {
            return Result::Err(DeserializeError::eof(self.pos as i64));
        }
        for let mut i = 0; i < lit_len; i += 1 {
            if self.input.get_byte_unchecked(self.pos + i) != lit.get_byte_unchecked(i) {
                return Result::Err(DeserializeError::malformed(
                    `expected '{lit}'`,
                    start as i64,
                ));
            }
        }
        self.pos += lit_len;
        return Result::Ok(());
    }

    pub fn read_json_string(&mut self) -> Result<String, DeserializeError> {
        self.skip_whitespace();
        let input_len = self.input.len();
        if self.pos >= input_len {
            return Result::Err(DeserializeError::eof(self.pos as i64));
        }
        if self.input.get_byte_unchecked(self.pos) as i32 != '"' as i32 {
            return Result::Err(DeserializeError::unexpected_type(
                "expected string",
                self.pos as i64,
            ));
        }
        self.pos += 1;

        // Phase 1: scan ahead to find the end of the escape-free prefix.
        // This lets us pre-size the allocation exactly, avoiding repeated grow() calls.
        let prefix_start = self.pos;
        let mut scan_pos = self.pos;
        while scan_pos < input_len {
            let sb = self.input.get_byte_unchecked(scan_pos) as i32;
            if sb == '"' as i32 || sb == '\\' as i32 {
                break;
            }
            scan_pos += 1;
        }
        let prefix_len = scan_pos - prefix_start;

        // Fast path: no escapes — allocate exactly the right size and copy raw bytes.
        if scan_pos < input_len && self.input.get_byte_unchecked(scan_pos) as i32 == '"' as i32 {
            let mut result = String::with_capacity(prefix_len);
            result.push_str_range_unchecked(self.input, prefix_start, prefix_start + prefix_len);
            self.pos = scan_pos + 1;
            return Result::Ok(result);
        }

        // Slow path: has escape sequences (or hit EOF).
        // Pre-copy the escape-free prefix with a well-sized allocation, then handle escapes.
        let mut result = String::with_capacity(prefix_len + 32);
        result.push_str_range_unchecked(self.input, prefix_start, prefix_start + prefix_len);
        self.pos = scan_pos;

        loop {
            // Scan for next terminator or escape. Bytes between escapes are already
            // valid UTF-8 (the input is valid UTF-8), so we can copy them as raw bytes
            // without per-byte UTF-8 decoding.
            let chunk_start = self.pos;
            while self.pos < self.input.len() {
                let b = self.input.get_byte_unchecked(self.pos) as i32;
                if b == '"' as i32 || b == '\\' as i32 {
                    break;
                }
                self.pos += 1;
            }
            let chunk_len = self.pos - chunk_start;
            if chunk_len > 0 {
                result.push_str_range_unchecked(self.input, chunk_start, self.pos);
            }

            if self.pos >= self.input.len() {
                return Result::Err(DeserializeError::eof(self.pos as i64));
            }
            let b = self.input.get_byte_unchecked(self.pos) as i32;
            if b == '"' as i32 {
                self.pos += 1;
                return Result::Ok(result);
            }
            // b == '\\'
            self.pos += 1;
            if self.pos >= self.input.len() {
                return Result::Err(DeserializeError::eof(self.pos as i64));
            }
            let esc = self.input.get_byte_unchecked(self.pos) as u8 as char;
            match esc {
                '"' => result.push('"'),
                '\\' => result.push('\\'),
                '/' => result.push('/'),
                'n' => result.push('\n'),
                'r' => result.push('\r'),
                't' => result.push('\t'),
                'b' => result.push(8 as u8 as char),
                'f' => result.push(12 as u8 as char),
                'u' => result.push(self.read_unicode_escape()?),
                _ => {
                    return Result::Err(DeserializeError::malformed(
                        `invalid escape '\\{esc}'`,
                        self.pos as i64,
                    ));
                },
            }
            self.pos += 1;
        }
