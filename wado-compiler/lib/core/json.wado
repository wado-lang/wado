#![stdlib("core:json")]
//! JSON serialization and deserialization (self-describing format).
//!
//! Implements the `core:serde` `Serializer` and `Deserializer` traits for JSON.
//!
//! Usage:
//!   use { to_string, from_string } from "core:json";
//!
//!   let json = to_string(&42);          // "42"
//!   let val = from_string::<i32>("42"); // Result::Ok(42)
//!
//! Serde I/O is bytes-primary: prefer `to_bytes` / `from_bytes` when the data
//! is consumed as bytes. `to_bytes_pretty` and `to_bytes_canonical` cover the
//! indented and the deterministic (sorted-key) forms.


use {
    Serialize,
    Deserialize,
    Serializer,
    Deserializer,
    SerializeSeq,
    SerializeMap,
    SerializeStruct,
    SerializeVariant,
    DeserializeSeq,
    DeserializeMap,
    DeserializeStruct,
    DeserializeVariant,
    FieldSchema,
    SerializeError,
    SerializeErrorKind,
    DeserializeError,
    DeserializeErrorKind,
    Visitor,
} from "core:serde";

use {
    parse as fpfmt_parse,
    PARSE_DIGITS_MAX as FPFMT_DIGITS_MAX,
    PARSE_EXP_MAX as FPFMT_EXP_MAX,
    PARSE_EXP_MIN as FPFMT_EXP_MIN,
} from "core:prelude/fpfmt.wado";
use { encode_with as base64_encode_with, decode as base64_decode, Encoding } from "core:base64";

/// 2^63 and 2^64 as f64 (both exactly representable): the overflow bounds
/// for i64 / u64 in the float-fallback integer parsing paths.
global TWO_POW_63: f64 = 9223372036854775808.0;
global TWO_POW_64: f64 = 18446744073709551616.0;

/// Writes a byte string as a base64url (no padding) JSON string into buf.
/// Matches RFC 8949 §6.1 advice for representing binary data as JSON text.
fn write_base64_string(buf: &mut String, v: ByteSlice) {
    buf.push('"');
    buf.push_str(&base64_encode_with(&v, Encoding::UrlSafe | Encoding::NoPadding));
    buf.push('"');
}

/// Writes a JSON-escaped string (with surrounding quotes) into buf.
pub fn write_escaped_string(buf: &mut String, s: &String) {
    buf.push('"');
    for let c of s.chars() {
        match c {
            '"' => buf.push_str(&"\\\""),
            '\\' => buf.push_str(&"\\\\"),
            '\n' => buf.push_str(&"\\n"),
            '\r' => buf.push_str(&"\\r"),
            '\t' => buf.push_str(&"\\t"),
            _ => {
                if (c as u32) < 0x20 {
                    let code = c as i32;
                    buf.push_str(&`\\u{code:04x}`);
                } else {
                    buf.push(c);
                }
            },
        }
    }
    buf.push('"');
}

// Scalar JSON encoding shared by the compact, pretty, and canonical
// serializers — only their container handling differs.

fn write_json_i32(buf: &mut String, v: i32) -> Result<(), SerializeError> {
    buf.push_str(&`{v}`);
    return Result::Ok(());
}

fn write_json_i64(buf: &mut String, v: i64) -> Result<(), SerializeError> {
    // Values outside the f64 safe-integer range are serialized as strings
    // so JS consumers don't lose precision.
    if v > f64::MAX_SAFE_INTEGER as i64 || v < f64::MIN_SAFE_INTEGER as i64 {
        buf.push_str(&`"{v}"`);
    } else {
        buf.push_str(&`{v}`);
    }
    return Result::Ok(());
}

fn write_json_u32(buf: &mut String, v: u32) -> Result<(), SerializeError> {
    buf.push_str(&`{v}`);
    return Result::Ok(());
}

fn write_json_u64(buf: &mut String, v: u64) -> Result<(), SerializeError> {
    // Values above the f64 safe-integer range are serialized as strings
    // so JS consumers don't lose precision.
    if v > f64::MAX_SAFE_INTEGER as u64 {
        buf.push_str(&`"{v}"`);
    } else {
        buf.push_str(&`{v}`);
    }
    return Result::Ok(());
}

fn write_json_i128(buf: &mut String, v: i128) -> Result<(), SerializeError> {
    // 128-bit values always exceed the f64 safe-integer range: always a string.
    buf.push_str(&`"{v}"`);
    return Result::Ok(());
}

fn write_json_u128(buf: &mut String, v: u128) -> Result<(), SerializeError> {
    buf.push_str(&`"{v}"`);
    return Result::Ok(());
}

fn write_json_f64(buf: &mut String, v: f64) -> Result<(), SerializeError> {
    if v.is_nan() {
        return Result::Err(SerializeError {
            kind: SerializeErrorKind::UnsupportedValue,
            message: "NaN is not allowed in JSON",
        });
    }
    if !v.is_finite() {
        return Result::Err(SerializeError {
            kind: SerializeErrorKind::UnsupportedValue,
            message: "Infinity is not allowed in JSON",
        });
    }
    buf.push_str(&`{v}`);
    return Result::Ok(());
}

fn write_json_f32(buf: &mut String, v: f32) -> Result<(), SerializeError> {
    // f32 widens losslessly; the NaN / Infinity checks and formatting are shared.
    return write_json_f64(buf, v as f64);
}

fn write_json_bool(buf: &mut String, v: bool) -> Result<(), SerializeError> {
    if v {
        buf.push_str(&"true");
    } else {
        buf.push_str(&"false");
    }
    return Result::Ok(());
}

fn write_json_char(buf: &mut String, v: char) -> Result<(), SerializeError> {
    let s = `{v}`;
    write_escaped_string(buf, &s);
    return Result::Ok(());
}

fn write_json_string(buf: &mut String, v: &String) -> Result<(), SerializeError> {
    write_escaped_string(buf, v);
    return Result::Ok(());
}

fn write_json_bytes(buf: &mut String, v: ByteSlice) -> Result<(), SerializeError> {
    write_base64_string(buf, v);
    return Result::Ok(());
}

fn write_json_null(buf: &mut String) -> Result<(), SerializeError> {
    buf.push_str(&"null");
    return Result::Ok(());
}

struct JsonSeqSerializer {
    buf: &mut String,
    count: i32,
}

struct JsonMapSerializer {
    buf: &mut String,
    count: i32,
    need_value: bool,
}

struct JsonStructSerializer {
    buf: &mut String,
    count: i32,
}

struct JsonVariantSerializer {
    buf: &mut String,
}

pub struct JsonSerializer {
    buf: &mut String,
}

fn write_pretty_newline_and_indent(buf: &mut String, indent: &String, depth: i32) {
    buf.push('\n');
    for let mut i = 0; i < depth; i += 1 {
        buf.push_str(indent);
    }
}

impl SerializeSeq for JsonSeqSerializer {
    fn element<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.buf.push_str(&",");
        }
        let mut ser = JsonSerializer { buf: self.buf };
        let r = value.serialize::<JsonSerializer>(&mut ser);
        self.buf = ser.buf;
        self.count += 1;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.buf.push_str(&"]");
        return Result::Ok(());
    }
}

impl SerializeMap for JsonMapSerializer {
    fn key<T: Serialize>(&mut self, key: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.buf.push_str(&",");
        }
        let mut ser = JsonSerializer { buf: self.buf };
        let r = key.serialize::<JsonSerializer>(&mut ser);
        self.buf = ser.buf;
        self.buf.push_str(&":");
        self.need_value = true;
        return r;
    }

    fn value<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        let mut ser = JsonSerializer { buf: self.buf };
        let r = value.serialize::<JsonSerializer>(&mut ser);
        self.buf = ser.buf;
        self.count += 1;
        self.need_value = false;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.buf.push_str(&"}");
        return Result::Ok(());
    }
}

impl SerializeStruct for JsonStructSerializer {
    fn field<T: Serialize>(&mut self, name: &String, value: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.buf.push_str(&",");
        }
        write_escaped_string(self.buf, name);
        self.buf.push_str(&":");
        let mut ser = JsonSerializer { buf: self.buf };
        let r = value.serialize::<JsonSerializer>(&mut ser);
        self.buf = ser.buf;
        self.count += 1;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.buf.push_str(&"}");
        return Result::Ok(());
    }
}

impl SerializeVariant for JsonVariantSerializer {
    fn payload<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        let mut ser = JsonSerializer { buf: self.buf };
        let r = value.serialize::<JsonSerializer>(&mut ser);
        self.buf = ser.buf;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.buf.push_str(&"}");
        return Result::Ok(());
    }
}

impl Serializer for JsonSerializer {
    type SeqSerializer = JsonSeqSerializer;
    type MapSerializer = JsonMapSerializer;
    type StructSerializer = JsonStructSerializer;
    type VariantSerializer = JsonVariantSerializer;

    fn serialize_i32(&mut self, v: i32) -> Result<(), SerializeError> {
        return write_json_i32(self.buf, v);
    }

    fn serialize_i64(&mut self, v: i64) -> Result<(), SerializeError> {
        return write_json_i64(self.buf, v);
    }

    fn serialize_u32(&mut self, v: u32) -> Result<(), SerializeError> {
        return write_json_u32(self.buf, v);
    }

    fn serialize_u64(&mut self, v: u64) -> Result<(), SerializeError> {
        return write_json_u64(self.buf, v);
    }

    fn serialize_i128(&mut self, v: i128) -> Result<(), SerializeError> {
        return write_json_i128(self.buf, v);
    }

    fn serialize_u128(&mut self, v: u128) -> Result<(), SerializeError> {
        return write_json_u128(self.buf, v);
    }

    fn serialize_f32(&mut self, v: f32) -> Result<(), SerializeError> {
        return write_json_f32(self.buf, v);
    }

    fn serialize_f64(&mut self, v: f64) -> Result<(), SerializeError> {
        return write_json_f64(self.buf, v);
    }

    fn serialize_bool(&mut self, v: bool) -> Result<(), SerializeError> {
        return write_json_bool(self.buf, v);
    }

    fn serialize_char(&mut self, v: char) -> Result<(), SerializeError> {
        return write_json_char(self.buf, v);
    }

    fn serialize_string(&mut self, v: &String) -> Result<(), SerializeError> {
        return write_json_string(self.buf, v);
    }

    fn serialize_bytes(&mut self, v: ByteSlice) -> Result<(), SerializeError> {
        return write_json_bytes(self.buf, v);
    }

    fn serialize_null(&mut self) -> Result<(), SerializeError> {
        return write_json_null(self.buf);
    }

    fn begin_seq(&mut self, len: i32) -> Result<JsonSeqSerializer, SerializeError> {
        self.buf.push_str(&"[");
        return Result::Ok(JsonSeqSerializer {
            buf: self.buf,
            count: 0,
        });
    }

    fn begin_map(&mut self, len: i32) -> Result<JsonMapSerializer, SerializeError> {
        self.buf.push_str(&"{");
        return Result::Ok(JsonMapSerializer {
            buf: self.buf,
            count: 0,
            need_value: false,
        });
    }

    fn begin_struct(&mut self, name: &String, fields: i32) -> Result<JsonStructSerializer, SerializeError> {
        self.buf.push_str(&"{");
        return Result::Ok(JsonStructSerializer {
            buf: self.buf,
            count: 0,
        });
    }

    fn serialize_unit_variant(
        &mut self,
        type_name: &String,
        variant_name: &String,
        disc: i32,
    ) -> Result<(), SerializeError> {
        write_escaped_string(self.buf, variant_name);
        return Result::Ok(());
    }

    fn begin_variant(
        &mut self,
        type_name: &String,
        variant_name: &String,
        disc: i32,
    ) -> Result<JsonVariantSerializer, SerializeError> {
        self.buf.push_str(&"{");
        write_escaped_string(self.buf, variant_name);
        self.buf.push_str(&":");
        return Result::Ok(JsonVariantSerializer {
            buf: self.buf,
        });
    }
}

struct PrettyJsonSeqSerializer {
    buf: &mut String,
    count: i32,
    indent: &String,
    depth: i32,
}

struct PrettyJsonMapSerializer {
    buf: &mut String,
    count: i32,
    need_value: bool,
    indent: &String,
    depth: i32,
}

struct PrettyJsonStructSerializer {
    buf: &mut String,
    count: i32,
    indent: &String,
    depth: i32,
}

struct PrettyJsonVariantSerializer {
    buf: &mut String,
    indent: &String,
    depth: i32,
}

pub struct PrettyJsonSerializer {
    pub buf: &mut String,
    pub indent: &String,
    pub depth: i32,
}

impl SerializeSeq for PrettyJsonSeqSerializer {
    fn element<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.buf.push_str(&",");
        }
        write_pretty_newline_and_indent(self.buf, self.indent, self.depth);
        let mut ser = PrettyJsonSerializer {
            buf: self.buf,
            indent: self.indent,
            depth: self.depth,
        };
        let r = value.serialize::<PrettyJsonSerializer>(&mut ser);
        self.buf = ser.buf;
        self.count += 1;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        if self.count > 0 {
            write_pretty_newline_and_indent(self.buf, self.indent, self.depth - 1);
        }
        self.buf.push_str(&"]");
        return Result::Ok(());
    }
}

impl SerializeMap for PrettyJsonMapSerializer {
    fn key<T: Serialize>(&mut self, key: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.buf.push_str(&",");
        }
        write_pretty_newline_and_indent(self.buf, self.indent, self.depth);
        let mut ser = PrettyJsonSerializer {
            buf: self.buf,
            indent: self.indent,
            depth: self.depth,
        };
        let r = key.serialize::<PrettyJsonSerializer>(&mut ser);
        self.buf = ser.buf;
        self.buf.push_str(&": ");
        self.need_value = true;
        return r;
    }

    fn value<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        let mut ser = PrettyJsonSerializer {
            buf: self.buf,
            indent: self.indent,
            depth: self.depth,
        };
        let r = value.serialize::<PrettyJsonSerializer>(&mut ser);
        self.buf = ser.buf;
        self.count += 1;
        self.need_value = false;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        if self.count > 0 {
            write_pretty_newline_and_indent(self.buf, self.indent, self.depth - 1);
        }
        self.buf.push_str(&"}");
        return Result::Ok(());
    }
}

impl SerializeStruct for PrettyJsonStructSerializer {
    fn field<T: Serialize>(&mut self, name: &String, value: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.buf.push_str(&",");
        }
        write_pretty_newline_and_indent(self.buf, self.indent, self.depth);
        write_escaped_string(self.buf, name);
        self.buf.push_str(&": ");
        let mut ser = PrettyJsonSerializer {
            buf: self.buf,
            indent: self.indent,
            depth: self.depth,
        };
        let r = value.serialize::<PrettyJsonSerializer>(&mut ser);
        self.buf = ser.buf;
        self.count += 1;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        if self.count > 0 {
            write_pretty_newline_and_indent(self.buf, self.indent, self.depth - 1);
        }
        self.buf.push_str(&"}");
        return Result::Ok(());
    }
}

impl SerializeVariant for PrettyJsonVariantSerializer {
    fn payload<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        let mut ser = PrettyJsonSerializer {
            buf: self.buf,
            indent: self.indent,
            depth: self.depth,
        };
        let r = value.serialize::<PrettyJsonSerializer>(&mut ser);
        self.buf = ser.buf;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        write_pretty_newline_and_indent(self.buf, self.indent, self.depth - 1);
        self.buf.push_str(&"}");
        return Result::Ok(());
    }
}

impl Serializer for PrettyJsonSerializer {
    type SeqSerializer = PrettyJsonSeqSerializer;
    type MapSerializer = PrettyJsonMapSerializer;
    type StructSerializer = PrettyJsonStructSerializer;
    type VariantSerializer = PrettyJsonVariantSerializer;

    fn serialize_i32(&mut self, v: i32) -> Result<(), SerializeError> {
        return write_json_i32(self.buf, v);
    }

    fn serialize_i64(&mut self, v: i64) -> Result<(), SerializeError> {
        return write_json_i64(self.buf, v);
    }

    fn serialize_u32(&mut self, v: u32) -> Result<(), SerializeError> {
        return write_json_u32(self.buf, v);
    }

    fn serialize_u64(&mut self, v: u64) -> Result<(), SerializeError> {
        return write_json_u64(self.buf, v);
    }

    fn serialize_i128(&mut self, v: i128) -> Result<(), SerializeError> {
        return write_json_i128(self.buf, v);
    }

    fn serialize_u128(&mut self, v: u128) -> Result<(), SerializeError> {
        return write_json_u128(self.buf, v);
    }

    fn serialize_f32(&mut self, v: f32) -> Result<(), SerializeError> {
        return write_json_f32(self.buf, v);
    }

    fn serialize_f64(&mut self, v: f64) -> Result<(), SerializeError> {
        return write_json_f64(self.buf, v);
    }

    fn serialize_bool(&mut self, v: bool) -> Result<(), SerializeError> {
        return write_json_bool(self.buf, v);
    }

    fn serialize_char(&mut self, v: char) -> Result<(), SerializeError> {
        return write_json_char(self.buf, v);
    }

    fn serialize_string(&mut self, v: &String) -> Result<(), SerializeError> {
        return write_json_string(self.buf, v);
    }

    fn serialize_bytes(&mut self, v: ByteSlice) -> Result<(), SerializeError> {
        return write_json_bytes(self.buf, v);
    }

    fn serialize_null(&mut self) -> Result<(), SerializeError> {
        return write_json_null(self.buf);
    }

    fn begin_seq(&mut self, len: i32) -> Result<PrettyJsonSeqSerializer, SerializeError> {
        self.buf.push_str(&"[");
        return Result::Ok(PrettyJsonSeqSerializer {
            buf: self.buf,
            count: 0,
            indent: self.indent,
            depth: self.depth + 1,
        });
    }

    fn begin_map(&mut self, len: i32) -> Result<PrettyJsonMapSerializer, SerializeError> {
        self.buf.push_str(&"{");
        return Result::Ok(PrettyJsonMapSerializer {
            buf: self.buf,
            count: 0,
            need_value: false,
            indent: self.indent,
            depth: self.depth + 1,
        });
    }

    fn begin_struct(&mut self, name: &String, fields: i32) -> Result<PrettyJsonStructSerializer, SerializeError> {
        self.buf.push_str(&"{");
        return Result::Ok(PrettyJsonStructSerializer {
            buf: self.buf,
            count: 0,
            indent: self.indent,
            depth: self.depth + 1,
        });
    }

    fn serialize_unit_variant(
        &mut self,
        type_name: &String,
        variant_name: &String,
        disc: i32,
    ) -> Result<(), SerializeError> {
        write_escaped_string(self.buf, variant_name);
        return Result::Ok(());
    }

    fn begin_variant(
        &mut self,
        type_name: &String,
        variant_name: &String,
        disc: i32,
    ) -> Result<PrettyJsonVariantSerializer, SerializeError> {
        self.buf.push_str(&"{");
        write_pretty_newline_and_indent(self.buf, self.indent, self.depth + 1);
        write_escaped_string(self.buf, variant_name);
        self.buf.push_str(&": ");
        return Result::Ok(PrettyJsonVariantSerializer {
            buf: self.buf,
            indent: self.indent,
            depth: self.depth + 1,
        });
    }
}

pub struct JsonDeserializer {
    pub input: ByteSlice,
    pub pos: i32,
}

/// A scanned JSON number token: sign, leading digits, the digit counts
/// needed to reconstruct the scale, and the explicit exponent. JSON forbids
/// leading zeros, so `int_digits` doubles as a magnitude proxy for the
/// integer parsers' range checks.
struct ScannedNumber {
    neg: bool,
    /// The first `FPFMT_DIGITS_MAX` digits, integer part first.
    digits: u64,
    /// All digits before the '.', including ones dropped from `digits`.
    int_digits: i32,
    /// Fraction digits accumulated into `digits`.
    frac_digits: i32,
    /// Explicit `e`/`E` exponent, saturating past fpfmt's domain.
    exp: i32,
    has_frac_or_exp: bool,
}

/// Reconstructs the f64 value of a scanned number token. Exponents outside
/// fpfmt's domain clamp to ±infinity / ±zero.
fn scanned_to_f64(n: &ScannedNumber) -> f64 {
    if n.digits == 0 {
        return if n.neg { -0.0 } else { 0.0 };
    }
    // Integer digits beyond the accumulated ones shift the scale up;
    // dropped fraction digits only truncate precision.
    let extra_int_digits = if n.int_digits > FPFMT_DIGITS_MAX { n.int_digits - FPFMT_DIGITS_MAX } else { 0 };
    let eff_p = n.exp - n.frac_digits + extra_int_digits;
    if eff_p > FPFMT_EXP_MAX {
        return if n.neg { f64::NEG_INFINITY } else { f64::INFINITY };
    }
    if eff_p < FPFMT_EXP_MIN {
        return if n.neg { -0.0 } else { 0.0 };
    }
    let v = fpfmt_parse(n.digits, eff_p);
    return if n.neg { -v } else { v };
}

/// True when a raw number token has a '.' or an exponent marker, i.e. it
/// needs the float-based integer fallback.
fn has_exp_or_dot(raw: &String) -> bool {
    for let mut i = 0; i < raw.len(); i += 1 {
        let b = raw.get_byte_unchecked(i) as i32;
        if b == '.' as i32 || b == 'e' as i32 || b == 'E' as i32 {
            return true;
        }
    }
    return false;
}

/// Maps an integer `from_str` failure onto a deserialize error.
fn int_from_str_error(kind: IntErrorKind, range_msg: String, start: i64) -> DeserializeError {
    return match kind {
        PosOverflow | NegOverflow => DeserializeError::overflow(range_msg, start),
        _ => DeserializeError::invalid_value("invalid digit in number", start),
    };
}

/// Parses a string-encoded JSON integer (e.g. an i64 beyond the f64
/// safe-integer range, which `write_json_i64` emits as a string).
fn parse_i64_from(raw: &String, start: i64) -> Result<i64, DeserializeError> {
    if has_exp_or_dot(raw) {
        // Reconstruct via f64 for scientific notation (e.g. 1e2 → 100).
        return match f64::from_str(raw) {
            Ok(v) && v != f64::floor(v) => {
                builtin::cold_path();
                Result::Err(DeserializeError::unexpected_type(
                    "expected integer, got float",
                    start,
                ));
            },
            Ok(v) && v >= TWO_POW_63 || v < -TWO_POW_63 => {
                builtin::cold_path();
                Result::Err(DeserializeError::overflow(
                    "value out of range for i64",
                    start,
                ));
            },
            Ok(v) => Result::Ok(v as i64),
            Err(_) => {
                builtin::cold_path();
                Result::Err(DeserializeError::invalid_value("invalid number", start));
            },
        };
    }
    return match i64::from_str(raw) {
        Ok(v) => Result::Ok(v),
        Err(e) => {
            builtin::cold_path();
            Result::Err(int_from_str_error(e.kind(), "value out of range for i64", start));
        },
    };
}

/// Parses a string-encoded JSON unsigned integer (the string form
/// `write_json_u64` emits beyond the f64 safe-integer range).
fn parse_u64_from(raw: &String, start: i64) -> Result<u64, DeserializeError> {
    if raw.len() > 0 && raw.get_byte_unchecked(0) as i32 == '-' as i32 {
        builtin::cold_path();
        return Result::Err(DeserializeError::overflow("negative value for u64", start));
    }
    if has_exp_or_dot(raw) {
        return match f64::from_str(raw) {
            // The leading-byte check above misses forms like " -1e3";
            // f64::from_str is the final authority on the sign.
            Ok(v) && v < 0.0 => {
                builtin::cold_path();
                Result::Err(DeserializeError::overflow("negative value for u64", start));
            },
            Ok(v) && v != f64::floor(v) => {
                builtin::cold_path();
                Result::Err(DeserializeError::unexpected_type(
                    "expected integer, got float",
                    start,
                ));
            },
            Ok(v) && v >= TWO_POW_64 => {
                builtin::cold_path();
                Result::Err(DeserializeError::overflow(
                    "value out of range for u64",
                    start,
                ));
            },
            Ok(v) => Result::Ok(v as u64),
            Err(_) => {
                builtin::cold_path();
                Result::Err(DeserializeError::invalid_value("invalid number", start));
            },
        };
    }
    return match u64::from_str(raw) {
        Ok(v) => Result::Ok(v),
        Err(e) => {
            builtin::cold_path();
            Result::Err(int_from_str_error(e.kind(), "value out of range for u64", start));
        },
    };
}

impl JsonDeserializer {
    pub fn peek(&self) -> i32 {
        if self.pos >= self.input.len() {
            return -1;
        }
        return self.input.get_unchecked(self.pos) as i32;
    }

    pub fn advance(&mut self) {
        self.pos += 1;
    }

    pub fn skip_whitespace(&mut self) {
        // Fast exit when next byte isn't whitespace. All JSON whitespace bytes
        // (space, tab, LF, CR) are <= ' ' (0x20), so a single comparison
        // rejects non-whitespace without checking each character individually.
        while self.pos < self.input.len() {
            let b = self.input.get_unchecked(self.pos) as i32;
            if b > ' ' as i32 {
                return;
            }
            if b == ' ' as i32 || b == '\t' as i32 || b == '\n' as i32 || b == '\r' as i32 {
                self.pos += 1;
            } else {
                return;
            }
        }
    }

    pub fn expect_char(&mut self, c: i32) -> Result<(), DeserializeError> {
        self.skip_whitespace();
        if self.pos >= self.input.len() {
            builtin::cold_path();
            return Result::Err(DeserializeError::eof(self.pos as i64));
        }
        let b = self.input.get_unchecked(self.pos) as i32;
        if b != c {
            builtin::cold_path();
            return Result::Err(DeserializeError::malformed(
                `expected '{c as u8 as char}', found '{b as u8 as char}'`,
                self.pos as i64,
            ));
        }
        self.pos += 1;
        return Result::Ok(());
    }

    /// Consumes a ':' — inline fast path for the common no-whitespace case.
    fn expect_colon(&mut self) -> Result<(), DeserializeError> {
        if self.pos < self.input.len() && self.input.get_unchecked(self.pos) as i32 == ':' as i32 {
            self.pos += 1;
            return Result::Ok(());
        }
        return self.expect_char(':' as i32);
    }

    /// Builds a String from `input[start..end)` with UTF-8 validation
    /// (RFC 8259 §8.1); invalid bytes are reported as `MalformedInput`.
    fn slice_to_string(&self, start: i32, end: i32) -> Result<String, DeserializeError> {
        return match String::from_utf8_slice(self.input.slice(start, end)) {
            Ok(s) => Result::Ok(s),
            Err(_) => {
                builtin::cold_path();
                Result::Err(DeserializeError::malformed(
                    "invalid UTF-8 in string",
                    start as i64,
                ));
            },
        };
    }

    pub fn read_json_string(&mut self) -> Result<String, DeserializeError> {
        self.skip_whitespace();
        let input_len = self.input.len();
        if self.pos >= input_len {
            builtin::cold_path();
            return Result::Err(DeserializeError::eof(self.pos as i64));
        }
        if self.input.get_unchecked(self.pos) as i32 != '"' as i32 {
            builtin::cold_path();
            return Result::Err(DeserializeError::unexpected_type(
                "expected string",
                self.pos as i64,
            ));
        }
        self.pos += 1;

        // Scan ahead to the end of the escape-free prefix so it can be built
        // in one exactly-sized allocation.
        let prefix_start = self.pos;
        let mut scan_pos = self.pos;
        while scan_pos < input_len {
            let sb = self.input.get_unchecked(scan_pos) as i32;
            if sb == '"' as i32 || sb == '\\' as i32 {
                break;
            }
            scan_pos += 1;
        }

        // Fast path: no escapes. The token is `input[prefix_start..scan_pos)`;
        // only string *content* can be multi-byte — JSON structure is ASCII.
        if scan_pos < input_len && self.input.get_unchecked(scan_pos) as i32 == '"' as i32 {
            let result = self.slice_to_string(prefix_start, scan_pos)?;
            self.pos = scan_pos + 1;
            return Result::Ok(result);
        }

        // Slow path: has escape sequences (or hit EOF). Build the escape-free
        // prefix, then handle escapes.
        let mut result = self.slice_to_string(prefix_start, scan_pos)?;
        self.pos = scan_pos;

        loop {
            // Scan to the next terminator or escape. The bytes between escapes
            // form one contiguous run that is validated and copied in a single
            // pass below (the `"` / `\` delimiters are ASCII, so a multi-byte
            // sequence never straddles a chunk boundary).
            let chunk_start = self.pos;
            while self.pos < self.input.len() {
                let b = self.input.get_unchecked(self.pos) as i32;
                if b == '"' as i32 || b == '\\' as i32 {
                    break;
                }
                self.pos += 1;
            }
            if self.pos > chunk_start {
                let chunk = self.slice_to_string(chunk_start, self.pos)?;
                result.push_str(&chunk);
            }

            if self.pos >= self.input.len() {
                builtin::cold_path();
                return Result::Err(DeserializeError::eof(self.pos as i64));
            }
            let b = self.input.get_unchecked(self.pos) as i32;
            if b == '"' as i32 {
                self.pos += 1;
                return Result::Ok(result);
            }
            // b == '\\'
            self.pos += 1;
            if self.pos >= self.input.len() {
                builtin::cold_path();
                return Result::Err(DeserializeError::eof(self.pos as i64));
            }
            let esc = self.input.get_unchecked(self.pos) as u8 as char;
            match esc {
                '"' => result.push('"'),
                '\\' => result.push('\\'),
                '/' => result.push('/'),
                'n' => result.push('\n'),
                'r' => result.push('\r'),
                't' => result.push('\t'),
                'b' => result.push('\u0008'),
                'f' => result.push('\u000C'),
                'u' => {
                    // read_unicode_escape consumes through the last hex digit
                    // (including a trailing low-surrogate escape), so skip the
                    // shared `pos += 1` below.
                    result.push(self.read_unicode_escape()?);
                    continue;
                },
                _ => {
                    builtin::cold_path();
                    return Result::Err(DeserializeError::malformed(
                        `invalid escape '\\{esc}'`,
                        self.pos as i64,
                    ));
                },
            }
            self.pos += 1;
        }
    }

    /// Reads exactly four hex digits at `pos`, advancing past them.
    fn read_hex4(&mut self) -> Result<u32, DeserializeError> {
        let start = self.pos;
        if self.pos + 4 > self.input.len() {
            builtin::cold_path();
            return Result::Err(DeserializeError::eof(self.pos as i64));
        }
        let mut code: u32 = 0;
        for let mut i = 0; i < 4; i += 1 {
            let c = self.input.get_unchecked(self.pos + i) as u8 as char;
            if !c.is_hexdigit() {
                builtin::cold_path();
                return Result::Err(DeserializeError::malformed(
                    "invalid unicode escape",
                    start as i64,
                ));
            }
            code = code * 16 + c.hex_digit_value() as u32;
        }
        self.pos += 4;
        return Result::Ok(code);
    }

    /// Reads a `\uXXXX` escape with `pos` at the `u`, decoding a surrogate
    /// pair (`\uD800`-`\uDBFF` followed by `\uDC00`-`\uDFFF`) into a single
    /// scalar as required by RFC 8259 §7. Leaves `pos` one past the last hex
    /// digit consumed.
    fn read_unicode_escape(&mut self) -> Result<char, DeserializeError> {
        self.pos += 1;
        let start = self.pos as i64;
        let hi = self.read_hex4()?;
        if 0xDC00 <= hi <= 0xDFFF {
            builtin::cold_path();
            return Result::Err(DeserializeError::malformed("unpaired low surrogate", start));
        }
        let mut code = hi;
        if 0xD800 <= hi <= 0xDBFF {
            // High surrogate: a `\uXXXX` low surrogate must follow.
            if self.pos + 2 > self.input.len()
                || self.input.get_unchecked(self.pos) as i32 != '\\' as i32
                || self.input.get_unchecked(self.pos + 1) as i32 != 'u' as i32 {
                builtin::cold_path();
                return Result::Err(DeserializeError::malformed(
                    "unpaired high surrogate",
                    start,
                ));
            }
            self.pos += 2;
            let lo = self.read_hex4()?;
            if !(0xDC00 <= lo <= 0xDFFF) {
                builtin::cold_path();
                return Result::Err(DeserializeError::malformed(
                    "unpaired high surrogate",
                    start,
                ));
            }
            code = 0x10000 + (hi - 0xD800 << 10) + (lo - 0xDC00);
        }
        return match char::from_u32(code) {
            Some(c) => Result::Ok(c),
            None => {
                builtin::cold_path();
                Result::Err(DeserializeError::malformed(
                    "invalid unicode codepoint",
                    start,
                ));
            },
        };
    }

    /// Reads a JSON number token as a String. Validates the token's prefix
    /// (optional '-' followed by a digit), then delegates the scan to
    /// `skip_number`.
    pub fn read_number_raw(&mut self) -> Result<String, DeserializeError> {
        self.skip_whitespace();
        let start = self.pos;
        let mut probe = self.pos;
        if probe < self.input.len() && self.input.get_unchecked(probe) as i32 == '-' as i32 {
            probe += 1;
        }
        if probe >= self.input.len() {
            builtin::cold_path();
            return Result::Err(DeserializeError::eof(probe as i64));
        }
        let first = self.input.get_unchecked(probe) as i32;
        if !('0' as i32 <= first <= '9' as i32) {
            builtin::cold_path();
            return Result::Err(DeserializeError::unexpected_type(
                "expected number",
                probe as i64,
            ));
        }
        self.skip_number();
        // A number token is ASCII (digits, sign, '.', 'e'/'E'), so it is valid
        // UTF-8 by construction. Build it in one bulk copy and skip the UTF-8
        // validation that `from_utf8_slice` would do — number-heavy input makes
        // that validation a measurable cost.
        return Result::Ok(String::internal_from_utf8_raw(
            self.input.slice(start, self.pos).to_array(),
            self.pos - start,
        ));
    }

    /// Advances past a JSON number in `self.input` without allocating a String.
    pub fn skip_number(&mut self) {
        if self.pos < self.input.len() && self.input.get_unchecked(self.pos) as i32 == '-' as i32 {
            self.pos += 1;
        }
        while self.pos < self.input.len() {
            let b = self.input.get_unchecked(self.pos) as i32;
            if '0' as i32 <= b <= '9' as i32 {
                self.pos += 1;
            } else {
                break;
            }
        }
        if self.pos < self.input.len() && self.input.get_unchecked(self.pos) as i32 == '.' as i32 {
            self.pos += 1;
            while self.pos < self.input.len() {
                let b = self.input.get_unchecked(self.pos) as i32;
                if '0' as i32 <= b <= '9' as i32 {
                    self.pos += 1;
                } else {
                    break;
                }
            }
        }
        if self.pos < self.input.len() {
            let b = self.input.get_unchecked(self.pos) as i32;
            if b == 'e' as i32 || b == 'E' as i32 {
                self.pos += 1;
                if self.pos < self.input.len() {
                    let sign = self.input.get_unchecked(self.pos) as i32;
                    if sign == '+' as i32 || sign == '-' as i32 {
                        self.pos += 1;
                    }
                }
                while self.pos < self.input.len() {
                    let b2 = self.input.get_unchecked(self.pos) as i32;
                    if '0' as i32 <= b2 <= '9' as i32 {
                        self.pos += 1;
                    } else {
                        break;
                    }
                }
            }
        }
    }

    /// Scans the JSON number token at `pos` (whitespace already skipped).
    /// Only the first `FPFMT_DIGITS_MAX` significant digits are accumulated.
    /// Dropped fraction digits merely truncate precision, while dropped
    /// integer digits shift the scale via `int_digits`.
    fn scan_number(&mut self) -> Result<ScannedNumber, DeserializeError> {
        if self.pos >= self.input.len() {
            builtin::cold_path();
            return Result::Err(DeserializeError::eof(self.pos as i64));
        }
        let mut neg = false;
        if self.input.get_unchecked(self.pos) as i32 == '-' as i32 {
            neg = true;
            self.pos += 1;
        }
        if self.pos >= self.input.len() {
            builtin::cold_path();
            return Result::Err(DeserializeError::eof(self.pos as i64));
        }
        let first = self.input.get_unchecked(self.pos) as i32;
        if !('0' as i32 <= first <= '9' as i32) {
            builtin::cold_path();
            return Result::Err(DeserializeError::unexpected_type(
                "expected number",
                self.pos as i64,
            ));
        }
        let mut digits: u64 = (first - '0' as i32) as u64;
        let mut acc_digits = 1;
        let mut int_digits = 1;
        self.pos += 1;
        while self.pos < self.input.len() {
            let b = self.input.get_unchecked(self.pos) as i32;
            if '0' as i32 <= b <= '9' as i32 {
                if acc_digits < FPFMT_DIGITS_MAX {
                    digits = digits * 10 + (b - '0' as i32) as u64;
                    acc_digits += 1;
                }
                int_digits += 1;
                self.pos += 1;
            } else {
                break;
            }
        }
        let mut frac_digits = 0;
        let mut has_frac_or_exp = false;
        if self.pos < self.input.len() && self.input.get_unchecked(self.pos) as i32 == '.' as i32 {
            has_frac_or_exp = true;
            self.pos += 1;
            while self.pos < self.input.len() {
                let b = self.input.get_unchecked(self.pos) as i32;
                if '0' as i32 <= b <= '9' as i32 {
                    if acc_digits < FPFMT_DIGITS_MAX {
                        digits = digits * 10 + (b - '0' as i32) as u64;
                        frac_digits += 1;
                        acc_digits += 1;
                    }
                    self.pos += 1;
                } else {
                    break;
                }
            }
        }
        let mut exp = 0;
        if self.pos < self.input.len() {
            let eb = self.input.get_unchecked(self.pos) as i32;
            if eb == 'e' as i32 || eb == 'E' as i32 {
                has_frac_or_exp = true;
                self.pos += 1;
                let mut exp_neg = false;
                if self.pos < self.input.len() {
                    let sb = self.input.get_unchecked(self.pos) as i32;
                    if sb == '-' as i32 {
                        exp_neg = true;
                        self.pos += 1;
                    } else if sb == '+' as i32 {
                        self.pos += 1;
                    }
                }
                while self.pos < self.input.len() {
                    let b = self.input.get_unchecked(self.pos) as i32;
                    if '0' as i32 <= b <= '9' as i32 {
                        // Stop accumulating once past fpfmt's domain: the
                        // value stays exact where it matters and saturates
                        // (instead of overflowing i32) on absurd exponents.
                        if exp <= FPFMT_EXP_MAX {
                            exp = exp * 10 + (b - '0' as i32);
                        }
                        self.pos += 1;
                    } else {
                        break;
                    }
                }
                if exp_neg {
                    exp = -exp;
                }
            }
        }
        return Result::Ok(ScannedNumber {
            neg,
            digits,
            int_digits,
            frac_digits,
            exp,
            has_frac_or_exp,
        });
    }

    /// Parses an i32 directly from `self.input`, without an intermediate
    /// String allocation.
    pub fn parse_i32_direct(&mut self) -> Result<i32, DeserializeError> {
        self.skip_whitespace();
        let start = self.pos as i64;
        let n = self.scan_number()?;
        if !n.has_frac_or_exp {
            // `digits` is exact within FPFMT_DIGITS_MAX digits; longer tokens
            // always overflow i32. i32::MIN's magnitude is one above i32::MAX.
            let limit: u64 = if n.neg { i32::MAX as u64 + 1 } else { i32::MAX as u64 };
            if n.int_digits > FPFMT_DIGITS_MAX || n.digits > limit {
                builtin::cold_path();
                return Result::Err(DeserializeError::overflow(
                    "value out of range for i32",
                    start,
                ));
            }
            let v = n.digits as i64;
            return Result::Ok(if n.neg { -v } else { v } as i32);
        }
        // Decimal point or exponent — reconstruct via f64 (e.g. 1e2 → 100).
        let v = scanned_to_f64(&n);
        if v != f64::floor(v) {
            builtin::cold_path();
            return Result::Err(DeserializeError::unexpected_type(
                "expected integer, got float",
                start,
            ));
        }
        if v < i32::MIN as f64 || v > i32::MAX as f64 {
            builtin::cold_path();
            return Result::Err(DeserializeError::overflow(
                "value out of range for i32",
                start,
            ));
        }
        return Result::Ok(v as i32);
    }

    /// Parses an i64 directly from `self.input`, without an intermediate
    /// String allocation.
    pub fn parse_i64_direct(&mut self) -> Result<i64, DeserializeError> {
        self.skip_whitespace();
        let start = self.pos as i64;
        let n = self.scan_number()?;
        if !n.has_frac_or_exp {
            // i64::MIN's magnitude (2^63) is one above i64::MAX.
            let limit: u64 = if n.neg { i64::MAX as u64 + 1 } else { i64::MAX as u64 };
            if n.int_digits > FPFMT_DIGITS_MAX || n.digits > limit {
                builtin::cold_path();
                return Result::Err(DeserializeError::overflow(
                    "value out of range for i64",
                    start,
                ));
            }
            let v = n.digits as i64;
            if n.neg {
                // 2^63 wraps to i64::MIN under `as i64`; negating it again
                // would overflow, so return it directly.
                if v == i64::MIN {
                    return Result::Ok(v);
                }
                return Result::Ok(-v);
            }
            return Result::Ok(v);
        }
        let v = scanned_to_f64(&n);
        if v != f64::floor(v) {
            builtin::cold_path();
            return Result::Err(DeserializeError::unexpected_type(
                "expected integer, got float",
                start,
            ));
        }
        if v >= TWO_POW_63 || v < -TWO_POW_63 {
            builtin::cold_path();
            return Result::Err(DeserializeError::overflow(
                "value out of range for i64",
                start,
            ));
        }
        return Result::Ok(v as i64);
    }

    /// Parses a u64 directly from `self.input`; only the rare token with one
    /// digit more than `FPFMT_DIGITS_MAX` allocates (for an exact re-parse).
    pub fn parse_u64_direct(&mut self) -> Result<u64, DeserializeError> {
        self.skip_whitespace();
        let start = self.pos as i64;
        if self.pos < self.input.len() && self.input.get_unchecked(self.pos) as i32 == '-' as i32 {
            builtin::cold_path();
            return Result::Err(DeserializeError::overflow("negative value for u64", start));
        }
        let n = self.scan_number()?;
        if !n.has_frac_or_exp {
            if n.int_digits <= FPFMT_DIGITS_MAX {
                return Result::Ok(n.digits);
            }
            if n.int_digits == FPFMT_DIGITS_MAX + 1 {
                // The scanner caps at FPFMT_DIGITS_MAX digits, but u64::MAX
                // has one more, so re-parse the token exactly (a number token
                // is ASCII, and with no sign / '.' / exponent here its length
                // equals its digit count).
                let len = n.int_digits;
                let raw = String::internal_from_utf8_raw(
                    self.input.slice(self.pos - len, self.pos).to_array(),
                    len,
                );
                return match u64::from_str(&raw) {
                    Ok(v) => Result::Ok(v),
                    Err(_) => {
                        builtin::cold_path();
                        Result::Err(DeserializeError::overflow(
                            "value out of range for u64",
                            start,
                        ));
                    },
                };
            }
            builtin::cold_path();
            return Result::Err(DeserializeError::overflow(
                "value out of range for u64",
                start,
            ));
        }
        let v = scanned_to_f64(&n);
        if v != f64::floor(v) {
            builtin::cold_path();
            return Result::Err(DeserializeError::unexpected_type(
                "expected integer, got float",
                start,
            ));
        }
        if v < 0.0 || v >= TWO_POW_64 {
            builtin::cold_path();
            return Result::Err(DeserializeError::overflow(
                "value out of range for u64",
                start,
            ));
        }
        return Result::Ok(v as u64);
    }

    /// Parses an f64 directly from `self.input` using fpfmt, without an
    /// intermediate String allocation.
    pub fn parse_f64_direct(&mut self) -> Result<f64, DeserializeError> {
        self.skip_whitespace();
        let n = self.scan_number()?;
        return Result::Ok(scanned_to_f64(&n));
    }

    /// Advances past a JSON string without allocating.
    pub fn skip_string(&mut self) -> Result<(), DeserializeError> {
        // Assumes pos is at the opening '"'
        self.pos += 1;
        while self.pos < self.input.len() {
            let b = self.input.get_unchecked(self.pos) as i32;
            if b == '"' as i32 {
                self.pos += 1;
                return Result::Ok(());
            }
            if b == '\\' as i32 {
                self.pos += 1;
                if self.pos >= self.input.len() {
                    builtin::cold_path();
                    return Result::Err(DeserializeError::eof(self.pos as i64));
                }
                let esc = self.input.get_unchecked(self.pos) as i32;
                if esc == 'u' as i32 {
                    // \uXXXX — skip 4 hex digits
                    self.pos += 4;
                }
            }
            self.pos += 1;
        }
        return Result::Err(DeserializeError::eof(self.pos as i64));
    }

    /// Inline check for "true" / "false" / "null". Assumes first byte already matched.
    /// Returns Ok if the literal matches and advances pos past it.
    fn expect_true(&mut self) -> Result<(), DeserializeError> {
        if self.pos + 4 <= self.input.len()
            && self.input.get_unchecked(self.pos + 1) as i32 == 'r' as i32
            && self.input.get_unchecked(self.pos + 2) as i32 == 'u' as i32
            && self.input.get_unchecked(self.pos + 3) as i32 == 'e' as i32 {
            self.pos += 4;
            return Result::Ok(());
        }
        return Result::Err(DeserializeError::malformed("expected 'true'", self.pos as i64));
    }

    fn expect_false(&mut self) -> Result<(), DeserializeError> {
        if self.pos + 5 <= self.input.len()
            && self.input.get_unchecked(self.pos + 1) as i32 == 'a' as i32
            && self.input.get_unchecked(self.pos + 2) as i32 == 'l' as i32
            && self.input.get_unchecked(self.pos + 3) as i32 == 's' as i32
            && self.input.get_unchecked(self.pos + 4) as i32 == 'e' as i32 {
            self.pos += 5;
            return Result::Ok(());
        }
        return Result::Err(DeserializeError::malformed("expected 'false'", self.pos as i64));
    }

    fn expect_null(&mut self) -> Result<(), DeserializeError> {
        if self.pos + 4 <= self.input.len()
            && self.input.get_unchecked(self.pos + 1) as i32 == 'u' as i32
            && self.input.get_unchecked(self.pos + 2) as i32 == 'l' as i32
            && self.input.get_unchecked(self.pos + 3) as i32 == 'l' as i32 {
            self.pos += 4;
            return Result::Ok(());
        }
        return Result::Err(DeserializeError::malformed("expected 'null'", self.pos as i64));
    }

    /// Skips the next JSON value without allocating.
    pub fn skip_value(&mut self) -> Result<(), DeserializeError> {
        self.skip_whitespace();
        if self.pos >= self.input.len() {
            builtin::cold_path();
            return Result::Err(DeserializeError::eof(self.pos as i64));
        }
        let b = self.input.get_unchecked(self.pos) as u8 as char;
        match b {
            '"' => {
                return self.skip_string();
            },
            't' => {
                return self.expect_true();
            },
            'f' => {
                return self.expect_false();
            },
            'n' => {
                return self.expect_null();
            },
            '[' => {
                self.pos += 1;
                self.skip_whitespace();
                if self.pos < self.input.len() && self.input.get_unchecked(self.pos) as i32 == ']' as i32 {
                    self.pos += 1;
                    return Result::Ok(());
                }
                loop {
                    self.skip_value()?;
                    self.skip_whitespace();
                    if self.pos >= self.input.len() {
                        builtin::cold_path();
                        return Result::Err(DeserializeError::eof(self.pos as i64));
                    }
                    let c = self.input.get_unchecked(self.pos) as i32;
                    if c == ']' as i32 {
                        self.pos += 1;
                        return Result::Ok(());
                    }
                    if c == ',' as i32 {
                        self.pos += 1;
                    } else {
                        builtin::cold_path();
                        return Result::Err(DeserializeError::malformed(
                            "expected ',' or ']'",
                            self.pos as i64,
                        ));
                    }
                }
            },
            '{' => {
                self.pos += 1;
                self.skip_whitespace();
                if self.pos < self.input.len() && self.input.get_unchecked(self.pos) as i32 == '}' as i32 {
                    self.pos += 1;
                    return Result::Ok(());
                }
                loop {
                    self.skip_whitespace();
                    if self.pos >= self.input.len() || self.input.get_unchecked(self.pos) as i32 != '"' as i32 {
                        builtin::cold_path();
                        return Result::Err(DeserializeError::malformed(
                            "expected string key",
                            self.pos as i64,
                        ));
                    }
                    self.skip_string()?;
                    self.expect_char(':' as i32)?;
                    self.skip_value()?;
                    self.skip_whitespace();
                    if self.pos >= self.input.len() {
                        builtin::cold_path();
                        return Result::Err(DeserializeError::eof(self.pos as i64));
                    }
                    let c = self.input.get_unchecked(self.pos) as i32;
                    if c == '}' as i32 {
                        self.pos += 1;
                        return Result::Ok(());
                    }
                    if c == ',' as i32 {
                        self.pos += 1;
                    } else {
                        builtin::cold_path();
                        return Result::Err(DeserializeError::malformed(
                            "expected ',' or '}'",
                            self.pos as i64,
                        ));
                    }
                }
            },
            '-' => {
                self.skip_number();
                return Result::Ok(());
            },
            c && '0' <= c <= '9' => {
                self.skip_number();
                return Result::Ok(());
            },
            _ => {
                builtin::cold_path();
                return Result::Err(DeserializeError::malformed(
                    "unexpected character in JSON value",
                    self.pos as i64,
                ));
            },
        }
    }
}

// --- Sub-deserializer implementations ---

// Sub-deserializers hold `&mut JsonDeserializer` so position advances
// inside the sub-access flow back to the outer `JsonDeserializer` the
// caller still owns. A value-typed `JsonDeserializer` field would
// deep-copy on construction (per Wado value semantics), and the
// caller's `pos` would never see the bytes the sub-access consumed —
// `from_string`'s post-deserialize "trailing data after value" check
// would fire on every map / struct / seq.
struct JsonSeqAccess {
    de: &mut JsonDeserializer,
    first: bool,
}

struct JsonMapAccess {
    de: &mut JsonDeserializer,
    first: bool,
}

struct JsonStructAccess {
    de: &mut JsonDeserializer,
    first: bool,
}

struct JsonVariantAccess {
    de: &mut JsonDeserializer,
    variant: String,
    is_object: bool,
}

impl DeserializeSeq for JsonSeqAccess {
    fn next_element<T: Deserialize>(&mut self) -> Result<Option<T>, DeserializeError> {
        self.de.skip_whitespace();
        if self.de.pos >= self.de.input.len() {
            builtin::cold_path();
            return Result::Err(DeserializeError::eof(self.de.pos as i64));
        }
        if self.de.input.get_unchecked(self.de.pos) as i32 == ']' as i32 {
            return Result::Ok(null);
        }
        if !self.first {
            self.de.expect_char(',' as i32)?;
        }
        self.first = false;
        return match T::deserialize::<JsonDeserializer>(&mut self.de) {
            Ok(v) => Result::Ok(Option::Some(v)),
            Err(e) => {
                builtin::cold_path();
                Result::Err(e);
            },
        };
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        return self.de.expect_char(']' as i32);
    }
}

impl DeserializeMap for JsonMapAccess {
    fn next_key_string(&mut self) -> Result<Option<String>, DeserializeError> {
        self.de.skip_whitespace();
        if self.de.pos >= self.de.input.len() {
            builtin::cold_path();
            return Result::Err(DeserializeError::eof(self.de.pos as i64));
        }
        if self.de.input.get_unchecked(self.de.pos) as i32 == '}' as i32 {
            return Result::Ok(null);
        }
        if !self.first {
            self.de.expect_char(',' as i32)?;
        }
        self.first = false;
        let key = self.de.read_json_string()?;
        self.de.expect_colon()?;
        return Result::Ok(Option::Some(key));
    }

    fn next_value<V: Deserialize>(&mut self) -> Result<V, DeserializeError> {
        return V::deserialize::<JsonDeserializer>(&mut self.de);
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        return self.de.expect_char('}' as i32);
    }
}

impl DeserializeStruct for JsonStructAccess {
    fn next_field<S: FieldSchema>(&mut self) -> Result<Option<i32>, DeserializeError> {
        self.de.skip_whitespace();
        if self.de.pos >= self.de.input.len() {
            builtin::cold_path();
            return Result::Err(DeserializeError::eof(self.de.pos as i64));
        }
        let b = self.de.input.get_unchecked(self.de.pos) as i32;
        if b == '}' as i32 {
            return Result::Ok(null);
        }
        if !self.first {
            if b != ',' as i32 {
                builtin::cold_path();
                return Result::Err(DeserializeError::malformed(
                    "expected ',' or '}'",
                    self.de.pos as i64,
                ));
            }
            self.de.pos += 1;
            self.de.skip_whitespace();
        }
        self.first = false;

        // Fast path: scan JSON string key without allocating.
        // For unescaped keys (the common case), we pass the byte range
        // directly to S::lookup, avoiding String allocation entirely.
        if self.de.pos >= self.de.input.len() || self.de.input.get_unchecked(self.de.pos) as i32 != '"' as i32 {
            builtin::cold_path();
            return Result::Err(DeserializeError::unexpected_type(
                "expected string key",
                self.de.pos as i64,
            ));
        }
        self.de.pos += 1;
        let key_start = self.de.pos;
        let mut has_escape = false;
        while self.de.pos < self.de.input.len() {
            let b = self.de.input.get_unchecked(self.de.pos) as i32;
            if b == '"' as i32 {
                break;
            }
            if b == '\\' as i32 {
                has_escape = true;
                break;
            }
            self.de.pos += 1;
        }

        if !has_escape {
            // Fast path: key has no escapes, compare directly from input buffer
            let key_end = self.de.pos;
            self.de.pos += 1;  // skip closing '"'
            self.de.expect_colon()?;
            let idx = match S::lookup(self.de.input.slice(key_start, key_end)) {
                Some(i) => i,
                None => -1,
            };
            return Result::Ok(Option::Some(idx));
        }
        builtin::cold_path();

        // Slow path: key has escape sequences, must parse fully.
        // Reset position to before the key and use read_json_string.
        self.de.pos = key_start - 1;
        let key = self.de.read_json_string()?;
        self.de.expect_char(':' as i32)?;
        let idx = match S::lookup(key.as_bytes()) {
            Some(i) => i,
            None => -1,
        };
        return Result::Ok(Option::Some(idx));
    }

    fn value<T: Deserialize>(&mut self) -> Result<T, DeserializeError> {
        return T::deserialize::<JsonDeserializer>(&mut self.de);
    }

    fn skip(&mut self) -> Result<(), DeserializeError> {
        return self.de.skip_value();
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        return self.de.expect_char('}' as i32);
    }
}

impl DeserializeVariant for JsonVariantAccess {
    fn variant_name(&mut self) -> Result<String, DeserializeError> {
        return Result::Ok(self.variant);
    }

    fn disc(&mut self) -> Result<i32, DeserializeError> {
        builtin::cold_path();
        return Result::Err(DeserializeError {
            kind: DeserializeErrorKind::Custom,
            message: "JSON does not encode discriminants",
            offset: -1,
        });
    }

    fn payload<T: Deserialize>(&mut self) -> Result<T, DeserializeError> {
        return T::deserialize::<JsonDeserializer>(&mut self.de);
    }

    fn is_unit(&mut self) -> Result<bool, DeserializeError> {
        return Result::Ok(!self.is_object);
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        if self.is_object {
            return self.de.expect_char('}' as i32);
        }
        return Result::Ok(());
    }
}

impl Deserializer for JsonDeserializer {
    type SeqAccess = JsonSeqAccess;
    type MapAccess = JsonMapAccess;
    type StructAccess = JsonStructAccess;
    type VariantAccess = JsonVariantAccess;

    fn deserialize_i32(&mut self) -> Result<i32, DeserializeError> {
        return self.parse_i32_direct();
    }

    fn deserialize_i64(&mut self) -> Result<i64, DeserializeError> {
        self.skip_whitespace();
        let start = self.pos as i64;
        // Accept string-encoded integers (for large values serialized as strings)
        if self.pos < self.input.len() && self.input.get_unchecked(self.pos) as i32 == '"' as i32 {
            let s = self.read_json_string()?;
            return parse_i64_from(&s, start);
        }
        return self.parse_i64_direct();
    }

    fn deserialize_u32(&mut self) -> Result<u32, DeserializeError> {
        self.skip_whitespace();
        let start = self.pos as i64;
        let v = self.parse_i64_direct()?;
        if v < 0 || v > u32::MAX as i64 {
            builtin::cold_path();
            return Result::Err(DeserializeError::overflow(
                "value out of range for u32",
                start,
            ));
        }
        return Result::Ok(v as u32);
    }

    fn deserialize_u64(&mut self) -> Result<u64, DeserializeError> {
        self.skip_whitespace();
        let start = self.pos as i64;
        // Accept string-encoded integers (for large values serialized as strings)
        if self.pos < self.input.len() && self.input.get_unchecked(self.pos) as i32 == '"' as i32 {
            let s = self.read_json_string()?;
            return parse_u64_from(&s, start);
        }
        return self.parse_u64_direct();
    }

    fn deserialize_i128(&mut self) -> Result<i128, DeserializeError> {
        self.skip_whitespace();
        let start = self.pos as i64;
        // Accept both bare numbers and string-encoded values (i128 is always
        // serialized as a string). from_str validates digits and overflow.
        let raw = if self.pos < self.input.len() && self.input.get_unchecked(self.pos) as i32 == '"' as i32 {
            self.read_json_string()?;
        } else {
            self.read_number_raw()?;
        };
        return match i128::from_str(&raw) {
            Ok(v) => Result::Ok(v),
            Err(e) => {
                builtin::cold_path();
                Result::Err(int_from_str_error(e.kind(), "value out of range for i128", start));
            },
        };
    }

    fn deserialize_u128(&mut self) -> Result<u128, DeserializeError> {
        self.skip_whitespace();
        let start = self.pos as i64;
        let raw = if self.pos < self.input.len() && self.input.get_unchecked(self.pos) as i32 == '"' as i32 {
            self.read_json_string()?;
        } else {
            self.read_number_raw()?;
        };
        if raw.len() > 0 && raw.get_byte_unchecked(0) as i32 == '-' as i32 {
            builtin::cold_path();
            return Result::Err(DeserializeError::overflow("negative value for u128", start));
        }
        return match u128::from_str(&raw) {
            Ok(v) => Result::Ok(v),
            Err(e) => {
                builtin::cold_path();
                Result::Err(int_from_str_error(e.kind(), "value out of range for u128", start));
            },
        };
    }

    fn deserialize_f32(&mut self) -> Result<f32, DeserializeError> {
        let v = self.parse_f64_direct()?;
        return Result::Ok(v as f32);
    }

    fn deserialize_f64(&mut self) -> Result<f64, DeserializeError> {
        return self.parse_f64_direct();
    }

    fn deserialize_bool(&mut self) -> Result<bool, DeserializeError> {
        self.skip_whitespace();
        if self.pos >= self.input.len() {
            builtin::cold_path();
            return Result::Err(DeserializeError::eof(self.pos as i64));
        }
        let b = self.input.get_unchecked(self.pos) as i32;
        if b == 't' as i32 {
            self.expect_true()?;
            return Result::Ok(true);
        }
        if b == 'f' as i32 {
            self.expect_false()?;
            return Result::Ok(false);
        }
        builtin::cold_path();
        return Result::Err(
            DeserializeError::unexpected_type("expected bool", self.pos as i64),
        );
    }

    fn deserialize_char(&mut self) -> Result<char, DeserializeError> {
        let s = self.read_json_string()?;
        let mut iter = s.chars();
        return match iter.next() {
            Some(c) => {
                if iter.next() matches { Some(_) } {
                    Result::Err(DeserializeError::invalid_value(
                        "expected single char",
                        self.pos as i64,
                    ));
                } else {
                    Result::Ok(c);
                }
            },
            None => {
                builtin::cold_path();
                Result::Err(DeserializeError::invalid_value(
                    "empty string for char",
                    self.pos as i64,
                ));
            },
        };
    }

    fn deserialize_string(&mut self) -> Result<String, DeserializeError> {
        return self.read_json_string();
    }

    fn deserialize_bytes(&mut self) -> Result<ByteList, DeserializeError> {
        let s = self.read_json_string()?;
        match base64_decode(&s) {
            Some(bytes) => {
                return Result::Ok(bytes);
            },
            None => {
                return Result::Err(DeserializeError::invalid_value(
                    "invalid base64 byte string",
                    self.pos as i64,
                ));
            },
        }
    }

    fn is_null(&mut self) -> Result<bool, DeserializeError> {
        self.skip_whitespace();
        // In JSON, only the `null` literal starts with 'n', so a mismatch
        // after it is malformed input rather than "not null".
        if self.pos < self.input.len() && self.input.get_unchecked(self.pos) as i32 == 'n' as i32 {
            self.expect_null()?;
            return Result::Ok(true);
        }
        return Result::Ok(false);
    }

    fn begin_seq(&mut self) -> Result<JsonSeqAccess, DeserializeError> with stores[self] {
        self.expect_char('[' as i32)?;
        return Result::Ok(JsonSeqAccess {
            de: self,
            first: true,
        });
    }

    fn begin_map(&mut self) -> Result<JsonMapAccess, DeserializeError> with stores[self] {
        self.expect_char('{' as i32)?;
        return Result::Ok(JsonMapAccess {
            de: self,
            first: true,
        });
    }

    fn begin_struct(
        &mut self,
        name: &String,
        num_fields: i32,
    ) -> Result<JsonStructAccess, DeserializeError> with stores[self] {
        self.expect_char('{' as i32)?;
        return Result::Ok(JsonStructAccess {
            de: self,
            first: true,
        });
    }

    fn begin_variant(
        &mut self,
        type_name: &String,
        num_cases: i32,
    ) -> Result<JsonVariantAccess, DeserializeError> with stores[self] {
        self.skip_whitespace();
        if self.pos >= self.input.len() {
            builtin::cold_path();
            return Result::Err(DeserializeError::eof(self.pos as i64));
        }
        let b = self.input.get_unchecked(self.pos) as u8 as char;
        match b {
            '"' => {
                let name = self.read_json_string()?;
                return Result::Ok(JsonVariantAccess {
                    de: self,
                    variant: name,
                    is_object: false,
                });
            },
            '{' => {
                self.pos += 1;
                let name = self.read_json_string()?;
                self.expect_char(':' as i32)?;
                return Result::Ok(JsonVariantAccess {
                    de: self,
                    variant: name,
                    is_object: true,
                });
            },
            _ => {
                builtin::cold_path();
                return Result::Err(DeserializeError::unexpected_type(
                    "expected string or object for variant",
                    self.pos as i64,
                ));
            },
        }
    }

    fn deserialize_any<V: Visitor>(&mut self, visitor: &mut V) -> Result<V::Value, DeserializeError> {
        self.skip_whitespace();
        if self.pos >= self.input.len() {
            builtin::cold_path();
            return Result::Err(DeserializeError::eof(self.pos as i64));
        }
        let b = self.input.get_unchecked(self.pos) as u8 as char;
        match b {
            'n' => {
                self.is_null()?;
                return visitor.visit_null();
            },
            't' | 'f' => {
                let v = self.deserialize_bool()?;
                return visitor.visit_bool(v);
            },
            '"' => {
                let v = self.deserialize_string()?;
                return visitor.visit_string(v);
            },
            '[' => {
                let mut seq = self.begin_seq()?;
                return visitor.visit_seq::<JsonSeqAccess>(&mut seq);
            },
            '{' => {
                let mut map = self.begin_map()?;
                return visitor.visit_map::<JsonMapAccess>(&mut map);
            },
            _ => {
                if b == '-' || '0' <= b <= '9' {
                    let v = self.deserialize_f64()?;
                    return visitor.visit_f64(v);
                }
                return Result::Err(DeserializeError::unexpected_type(
                    "unexpected byte in JSON value",
                    self.pos as i64,
                ));
            },
        }
    }
}

// Canonical (sorted-key) JSON serializer.
//
// Produces deterministic output: object / struct keys are emitted in ascending
// bytewise order of their encoded (quoted) form, while arrays keep their order.
// Scalars match the compact `JsonSerializer`. RFC 8785-style; used by
// `to_bytes_canonical` for signing / diffing where byte-exact reproducibility
// matters.
pub struct CanonicalJsonSerializer {
    buf: &mut String,
}

struct CanonicalSeqSerializer {
    buf: &mut String,
    count: i32,
}

struct CanonicalMapSerializer {
    buf: &mut String,
    entries: List<[String, String]>,
    pending_key: String,
}

struct CanonicalStructSerializer {
    buf: &mut String,
    entries: List<[String, String]>,
}

struct CanonicalVariantSerializer {
    buf: &mut String,
}

/// Serialize a value canonically into a fresh `String` buffer (used to buffer
/// map / struct values before their keys are sorted).
fn canonical_encode<T: Serialize>(value: &T) -> Result<String, SerializeError> {
    let mut buf = String::with_capacity(16);
    let mut ser = CanonicalJsonSerializer { buf: &mut buf };
    value.serialize::<CanonicalJsonSerializer>(&mut ser)?;
    return Result::Ok(buf);
}

/// Emit `entries` (encoded-key, encoded-value pairs) into `buf` as a JSON
/// object with keys in ascending bytewise order of the encoded key.
fn emit_sorted_object(buf: &mut String, entries: &mut List<[String, String]>) {
    entries.sort_by(|a: &[String, String], b: &[String, String]| a.0.cmp(&b.0));
    buf.push('{');
    for let mut i = 0; i < entries.len(); i += 1 {
        if i > 0 {
            buf.push(',');
        }
        buf.push_str(&entries[i].0);
        buf.push(':');
        buf.push_str(&entries[i].1);
    }
    buf.push('}');
}

impl SerializeSeq for CanonicalSeqSerializer {
    fn element<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.buf.push(',');
        }
        let mut ser = CanonicalJsonSerializer { buf: self.buf };
        let r = value.serialize::<CanonicalJsonSerializer>(&mut ser);
        self.buf = ser.buf;
        self.count += 1;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.buf.push(']');
        return Result::Ok(());
    }
}

impl SerializeMap for CanonicalMapSerializer {
    fn key<T: Serialize>(&mut self, key: &T) -> Result<(), SerializeError> {
        let mut kbuf = String::with_capacity(16);
        let mut ser = JsonSerializer { buf: &mut kbuf };
        key.serialize::<JsonSerializer>(&mut ser)?;
        self.pending_key = kbuf;
        return Result::Ok(());
    }

    fn value<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        let vbuf = canonical_encode::<T>(value)?;
        self.entries.push([self.pending_key, vbuf]);
        return Result::Ok(());
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        emit_sorted_object(self.buf, &mut self.entries);
        return Result::Ok(());
    }
}

impl SerializeStruct for CanonicalStructSerializer {
    fn field<T: Serialize>(&mut self, name: &String, value: &T) -> Result<(), SerializeError> {
        let mut kbuf = String::with_capacity(name.len() + 2);
        write_escaped_string(&mut kbuf, name);
        let vbuf = canonical_encode::<T>(value)?;
        self.entries.push([kbuf, vbuf]);
        return Result::Ok(());
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        emit_sorted_object(self.buf, &mut self.entries);
        return Result::Ok(());
    }
}

impl SerializeVariant for CanonicalVariantSerializer {
    fn payload<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        let mut ser = CanonicalJsonSerializer { buf: self.buf };
        let r = value.serialize::<CanonicalJsonSerializer>(&mut ser);
        self.buf = ser.buf;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.buf.push('}');
        return Result::Ok(());
    }
}

impl Serializer for CanonicalJsonSerializer {
    type SeqSerializer = CanonicalSeqSerializer;
    type MapSerializer = CanonicalMapSerializer;
    type StructSerializer = CanonicalStructSerializer;
    type VariantSerializer = CanonicalVariantSerializer;

    fn serialize_i32(&mut self, v: i32) -> Result<(), SerializeError> {
        return write_json_i32(self.buf, v);
    }

    fn serialize_i64(&mut self, v: i64) -> Result<(), SerializeError> {
        return write_json_i64(self.buf, v);
    }

    fn serialize_u32(&mut self, v: u32) -> Result<(), SerializeError> {
        return write_json_u32(self.buf, v);
    }

    fn serialize_u64(&mut self, v: u64) -> Result<(), SerializeError> {
        return write_json_u64(self.buf, v);
    }

    fn serialize_i128(&mut self, v: i128) -> Result<(), SerializeError> {
        return write_json_i128(self.buf, v);
    }

    fn serialize_u128(&mut self, v: u128) -> Result<(), SerializeError> {
        return write_json_u128(self.buf, v);
    }

    fn serialize_f32(&mut self, v: f32) -> Result<(), SerializeError> {
        return write_json_f32(self.buf, v);
    }

    fn serialize_f64(&mut self, v: f64) -> Result<(), SerializeError> {
        return write_json_f64(self.buf, v);
    }

    fn serialize_bool(&mut self, v: bool) -> Result<(), SerializeError> {
        return write_json_bool(self.buf, v);
    }

    fn serialize_char(&mut self, v: char) -> Result<(), SerializeError> {
        return write_json_char(self.buf, v);
    }

    fn serialize_string(&mut self, v: &String) -> Result<(), SerializeError> {
        return write_json_string(self.buf, v);
    }

    fn serialize_bytes(&mut self, v: ByteSlice) -> Result<(), SerializeError> {
        return write_json_bytes(self.buf, v);
    }

    fn serialize_null(&mut self) -> Result<(), SerializeError> {
        return write_json_null(self.buf);
    }

    fn begin_seq(&mut self, len: i32) -> Result<CanonicalSeqSerializer, SerializeError> {
        self.buf.push('[');
        return Result::Ok(CanonicalSeqSerializer {
            buf: self.buf,
            count: 0,
        });
    }

    fn begin_map(&mut self, len: i32) -> Result<CanonicalMapSerializer, SerializeError> {
        return Result::Ok(CanonicalMapSerializer {
            buf: self.buf,
            entries: [],
            pending_key: "",
        });
    }

    fn begin_struct(&mut self, name: &String, fields: i32) -> Result<CanonicalStructSerializer, SerializeError> {
        return Result::Ok(CanonicalStructSerializer {
            buf: self.buf,
            entries: [],
        });
    }

    fn serialize_unit_variant(
        &mut self,
        type_name: &String,
        variant_name: &String,
        disc: i32,
    ) -> Result<(), SerializeError> {
        write_escaped_string(self.buf, variant_name);
        return Result::Ok(());
    }

    fn begin_variant(
        &mut self,
        type_name: &String,
        variant_name: &String,
        disc: i32,
    ) -> Result<CanonicalVariantSerializer, SerializeError> {
        self.buf.push('{');
        write_escaped_string(self.buf, variant_name);
        self.buf.push(':');
        return Result::Ok(CanonicalVariantSerializer {
            buf: self.buf,
        });
    }
}

/// Initial serialization buffer capacity, in bytes. Most JSON values
/// fit without a reallocation; larger outputs still grow amortized.
/// Matches `serde_json`'s `to_vec` pre-sizing.
global SERIALIZE_BUFFER_CAPACITY: i32 = 128;

/// Serializes a value to a JSON string. Convenience over `to_bytes` for text
/// contexts; serde I/O is bytes-primary, so prefer `to_bytes` when the output
/// is consumed as bytes (e.g. an HTTP response body).
pub fn to_string<T: Serialize>(value: &T) -> Result<String, SerializeError> {
    let mut buf = String::with_capacity(SERIALIZE_BUFFER_CAPACITY);
    let mut ser = JsonSerializer { buf: &mut buf };
    value.serialize::<JsonSerializer>(&mut ser)?;
    return Result::Ok(buf);
}

/// Serializes a value directly to UTF-8 JSON bytes.
///
/// Equivalent to `to_string` followed by a byte-buffer conversion, but
/// skips the intermediate re-encoding: the serializer's UTF-8 buffer is
/// handed back directly as an `List<u8>` with no copy. Prefer this over
/// `to_string(value).bytes().collect()` whenever the output is consumed
/// as bytes (e.g. an HTTP response body).
pub fn to_bytes<T: Serialize>(value: &T) -> Result<List<u8>, SerializeError> {
    let mut buf = String::with_capacity(SERIALIZE_BUFFER_CAPACITY);
    let mut ser = JsonSerializer { buf: &mut buf };
    value.serialize::<JsonSerializer>(&mut ser)?;
    return Result::Ok(List::<u8>::internal_from_raw(buf.internal_raw_bytes(), buf.len()));
}

/// Serializes a value to a pretty JSON string. Convenience over
/// `to_bytes_pretty`; serde I/O is bytes-primary.
pub fn to_string_pretty<T: Serialize>(value: &T) -> Result<String, SerializeError> {
    let indent = "  ";
    let mut buf = String::with_capacity(SERIALIZE_BUFFER_CAPACITY);
    let mut ser = PrettyJsonSerializer {
        buf: &mut buf,
        indent: &indent,
        depth: 0,
    };
    value.serialize::<PrettyJsonSerializer>(&mut ser)?;
    return Result::Ok(buf);
}

/// Deserializes a value from a JSON string. Convenience wrapper over
/// `from_bytes` (a `String` is a UTF-8 byte source); serde I/O is bytes-primary.
pub fn from_string<T: Deserialize>(input: String) -> Result<T, DeserializeError> {
    return from_bytes::<T, String>(input);
}

/// Deserializes a value from UTF-8 JSON bytes — the primary entry point.
///
/// Accepts any byte source via `AsByteSlice`: a `ByteList`, `ByteArray`,
/// `ByteSlice`, or a `String` (its UTF-8 bytes). The deserializer scans the
/// borrowed bytes directly (zero-copy); UTF-8 is validated where string content
/// is materialized (RFC 8259 §8.1), reporting invalid bytes as `MalformedInput`.
pub fn from_bytes<T: Deserialize, S: AsByteSlice>(input: S) -> Result<T, DeserializeError> {
    let mut de = JsonDeserializer {
        input: input.as_byte_slice(),
        pos: 0,
    };
    let v = T::deserialize::<JsonDeserializer>(&mut de)?;
    de.skip_whitespace();
    if de.pos < de.input.len() {
        builtin::cold_path();
        return Result::Err(DeserializeError::trailing(de.pos as i64));
    }
    return Result::Ok(v);
}

/// Serializes a value to canonical (deterministic) UTF-8 JSON bytes.
///
/// Object / struct keys are emitted in ascending bytewise order of their
/// encoded form (RFC 8785-style); equal values produce byte-identical output
/// regardless of map insertion order. Use this for signing or content
/// addressing; use `to_bytes` for the faster insertion-order form.
pub fn to_bytes_canonical<T: Serialize>(value: &T) -> Result<List<u8>, SerializeError> {
    let mut buf = String::with_capacity(SERIALIZE_BUFFER_CAPACITY);
    let mut ser = CanonicalJsonSerializer { buf: &mut buf };
    value.serialize::<CanonicalJsonSerializer>(&mut ser)?;
    return Result::Ok(List::<u8>::internal_from_raw(buf.internal_raw_bytes(), buf.len()));
}

/// Serializes a value to pretty-printed UTF-8 JSON bytes.
pub fn to_bytes_pretty<T: Serialize>(value: &T) -> Result<List<u8>, SerializeError> {
    let indent = "  ";
    let mut buf = String::with_capacity(SERIALIZE_BUFFER_CAPACITY);
    let mut ser = PrettyJsonSerializer {
        buf: &mut buf,
        indent: &indent,
        depth: 0,
    };
    value.serialize::<PrettyJsonSerializer>(&mut ser)?;
    return Result::Ok(List::<u8>::internal_from_raw(buf.internal_raw_bytes(), buf.len()));
}
