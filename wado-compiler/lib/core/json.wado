    pub fn has_exp_or_dot(&self, raw: &String) -> bool {
        for let mut i = 0; i < raw.len(); i += 1 {
            let b = raw.get_byte_unchecked(i) as i32;
            if b == '.' as i32 || b == 'e' as i32 || b == 'E' as i32 {
