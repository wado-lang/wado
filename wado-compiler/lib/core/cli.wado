//! CLI helpers: `println`, `eprintln`, `args`, `env`, `exit`, etc.

// Wado CLI Module
// High-level CLI helpers built on top of wasi:cli
//
// This module provides convenient functions like println(), eprintln(), args(), etc.
// For raw WASI CLI interfaces, use "wasi:cli" instead.
//
// WASI P3 write_via_stream ordering:
// 1. Create stream pair: Stream::<u8>::new() → [rx, tx]
// 2. Start write_via_stream(rx) — returns a Future handle (i32)
// 3. Write data to tx via StreamWritable::write()
// 4. Drop tx via StreamWritable::drop()
// 5. Cast handle to Future and drop to signal completion

use { Stdout, Stderr, Environment, Exit } from "wasi:cli";
// Re-export commonly used effects for convenience
pub use { Stdout, Stderr, Environment, Exit } from "wasi:cli";
pub use { log_stdout, log_stderr } from "core:internal";
use { drop_cli_write_future } from "core:internal";
/// Writes a string to a StreamWritable<u8> with an optional newline, then drops it.
pub fn write_to_stream(tx: StreamWritable<u8>, message: String, add_newline: bool) {
    let bytes = message.internal_raw_bytes();
    let len = message.len();
    if add_newline {
        let new_repr: builtin::array<u8> = builtin::array_new(len + 1);
        builtin::array_copy(new_repr, 0, bytes, 0, len);
        builtin::array_set_u8(new_repr, len, 10);
        tx.write_raw(new_repr, len + 1);
    } else {
        tx.write_raw(bytes, len);
    }
    tx.drop();
}

/// Prints a line to stdout (adds newline).
pub fn println(message: String) with Stdout {
    let [rx, tx] = Stream::<u8>::new();
    let handle = Stdout::write_via_stream(rx);
    write_to_stream(tx, message, true);
    drop_cli_write_future(handle);
}

/// Prints a line to stderr (adds newline).
pub fn eprintln(message: String) with Stderr {
    let [rx, tx] = Stream::<u8>::new();
    let handle = Stderr::write_via_stream(rx);
    write_to_stream(tx, message, true);
    drop_cli_write_future(handle);
}

/// Prints to stdout without a trailing newline.
pub fn print(message: String) with Stdout {
    let [rx, tx] = Stream::<u8>::new();
    let handle = Stdout::write_via_stream(rx);
    write_to_stream(tx, message, false);
    drop_cli_write_future(handle);
}

/// Prints to stderr without a trailing newline.
pub fn eprint(message: String) with Stderr {
    let [rx, tx] = Stream::<u8>::new();
    let handle = Stderr::write_via_stream(rx);
    write_to_stream(tx, message, false);
    drop_cli_write_future(handle);
}

/// Writes raw bytes to stdout.
pub fn print_bytes(data: Array<u8>) with Stdout {
    let [rx, tx] = Stream::<u8>::new();
    let handle = Stdout::write_via_stream(rx);
    tx.write(data);
    tx.drop();
    drop_cli_write_future(handle);
}

/// Returns the value of an environment variable by name.
pub fn env(name: String) -> Option<String> with Environment {
    let vars = Environment::get_environment();
    for let mut i = 0; i < vars.len(); i += 1 {
        let pair = vars[i];
        if pair.0 == name {
            return Option::Some(pair.1);
        }
    }
    return null;
}

/// Returns all command-line arguments.
pub fn args() -> Array<String> with Environment {
    return Environment::get_arguments();
}

/// Returns the current working directory.
pub fn cwd() -> Option<String> with Environment {
    return Environment::get_initial_cwd();
}

/// Exits with success (code 0).
pub fn exit_success() -> ! with Exit {
    Exit::exit(Ok(()));
}

/// Exits with an error.
pub fn exit_error() -> ! with Exit {
    Exit::exit(Err(()));
}

/// Exits with a specific status code.
pub fn exit(code: u8) -> ! with Exit {
    Exit::exit_with_code(code);
}
