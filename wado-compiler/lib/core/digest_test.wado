use { Sha256, Digest, sha256 } from "core:digest";

test "sha256 empty input" {
    let digest = sha256(&([] as List<u8>));
    assert digest.to_hex() == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
}

test "sha256 abc" {
    let digest: ByteList = sha256(&"abc");
    assert digest.to_hex() == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
}

test "sha256 two-block message" {
    // The 56-byte FIPS 180-4 example; padding crosses into a second block.
    let msg = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
    let digest = sha256(&msg);
    assert digest.to_hex() == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1";
}

test "sha256 pangram" {
    let digest = sha256(&"The quick brown fox jumps over the lazy dog");
    assert digest.to_hex() == "d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592";
}

test "sha256 accepts any byte source" {
    // String, ByteList, and ByteSlice views of the same bytes hash equal.
    let from_string = sha256(&"abc").to_hex();
    let list: ByteList = [97, 98, 99];
    assert sha256(&list).to_hex() == from_string;
    let slice = list.as_byte_slice();
    assert sha256(&slice).to_hex() == from_string;
}

test "incremental update matches one-shot" {
    // Splitting the message across update() calls (and across a block
    // boundary) must yield the same digest as hashing it all at once.
    let mut hasher = Sha256::new();
    hasher.update(&"The quick brown fox ");
    hasher.update(&"jumps over the lazy dog");
    let incremental = hasher.finalize().to_hex();

    let oneshot = sha256(&"The quick brown fox jumps over the lazy dog").to_hex();
    assert incremental == oneshot;
}

test "to_hex zero-pads each byte" {
    let bytes: List<u8> = [0x00, 0x0f, 0xa0, 0xff] as List<u8>;
    assert bytes.to_hex() == "000fa0ff";
}
