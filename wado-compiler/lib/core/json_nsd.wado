#![stdlib("core:json_nsd")]
//! JSON NSD (Non-Self-Describing) serialization and deserialization.
//!
//! Structs are encoded as positional arrays (field names omitted).
//! Unit variants (enums) are encoded as integer discriminants.
//! Payload variants are encoded as `[disc, payload]`.
//!
//! Usage:
//!   use { to_string, from_string } from "core:json_nsd";
//!
//!   struct Point { x: i32, y: i32 }
//!   impl Serialize for Point;
//!   impl Deserialize for Point;
//!
//!   let json = to_string(&Point { x: 1, y: 2 });  // "[1,2]"
//!   let val: Result<Point, DeserializeError> = from_string("[1,2]");  // Ok(Point { x: 1, y: 2 })


use {
    Serialize,
    Deserialize,
    Serializer,
    Deserializer,
    SerializeSeq,
    SerializeMap,
    SerializeStruct,
    SerializeVariant,
    DeserializeSeq,
    DeserializeMap,
    DeserializeStruct,
    DeserializeVariant,
    FieldSchema,
    SerializeError,
    SerializeErrorKind,
    DeserializeError,
    DeserializeErrorKind,
    Visitor,
} from "core:serde";

use { write_escaped_string, JsonDeserializer } from "core:json";

// Sub-serializers hold `&mut String` so writes flow back to the
// outer buffer the caller still owns. A value-typed `String` field
// would deep-copy on construction (Wado value semantics deep-copy
// `String`'s `repr`), and the previous `self.buf = ser.buf` save-
// back trick (still in older revisions) doesn't recover the bytes
// the sub-serializer wrote to its own copy.
struct NsdSeqSerializer {
    buf: &mut String,
    count: i32,
}

struct NsdMapSerializer {
    buf: &mut String,
    count: i32,
    need_value: bool,
}

struct NsdStructSerializer {
    buf: &mut String,
    count: i32,
}

struct NsdVariantSerializer {
    buf: &mut String,
}

pub struct NsdSerializer {
    buf: &mut String,
}

impl SerializeSeq for NsdSeqSerializer {
    fn element<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.buf.push_str(&",");
        }
        let mut ser = NsdSerializer { buf: self.buf };
        let r = value.serialize::<NsdSerializer>(&mut ser);
        self.count += 1;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.buf.push_str(&"]");
        return Result::Ok(());
    }
}

impl SerializeMap for NsdMapSerializer {
    fn key<T: Serialize>(&mut self, key: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.buf.push_str(&",");
        }
        let mut ser = NsdSerializer { buf: self.buf };
        let r = key.serialize::<NsdSerializer>(&mut ser);
        self.buf.push_str(&":");
        self.need_value = true;
        return r;
    }

    fn value<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        let mut ser = NsdSerializer { buf: self.buf };
        let r = value.serialize::<NsdSerializer>(&mut ser);
        self.count += 1;
        self.need_value = false;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.buf.push_str(&"}");
        return Result::Ok(());
    }
}

impl SerializeStruct for NsdStructSerializer {
    fn field<T: Serialize>(&mut self, name: &String, value: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.buf.push_str(&",");
        }
        // NSD: omit field name, write value only
        let mut ser = NsdSerializer { buf: self.buf };
        let r = value.serialize::<NsdSerializer>(&mut ser);
        self.count += 1;
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.buf.push_str(&"]");
        return Result::Ok(());
    }
}

impl SerializeVariant for NsdVariantSerializer {
    fn payload<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        self.buf.push_str(&",");
        let mut ser = NsdSerializer { buf: self.buf };
        let r = value.serialize::<NsdSerializer>(&mut ser);
        return r;
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.buf.push_str(&"]");
        return Result::Ok(());
    }
}

impl Serializer for NsdSerializer {
    type SeqSerializer = NsdSeqSerializer;
    type MapSerializer = NsdMapSerializer;
    type StructSerializer = NsdStructSerializer;
    type VariantSerializer = NsdVariantSerializer;

    fn serialize_i32(&mut self, v: i32) -> Result<(), SerializeError> {
        self.buf.push_str(&`{v}`);
        return Result::Ok(());
    }

    fn serialize_i64(&mut self, v: i64) -> Result<(), SerializeError> {
        if v > 9007199254740991 || v < -9007199254740991 {
            self.buf.push_str(&`"{v}"`);
        } else {
            self.buf.push_str(&`{v}`);
        }
        return Result::Ok(());
    }

    fn serialize_u32(&mut self, v: u32) -> Result<(), SerializeError> {
        self.buf.push_str(&`{v}`);
        return Result::Ok(());
    }

    fn serialize_u64(&mut self, v: u64) -> Result<(), SerializeError> {
        if v > 9007199254740991 {
            self.buf.push_str(&`"{v}"`);
        } else {
            self.buf.push_str(&`{v}`);
        }
        return Result::Ok(());
    }

    fn serialize_i128(&mut self, v: i128) -> Result<(), SerializeError> {
        self.buf.push_str(&`"{v}"`);
        return Result::Ok(());
    }

    fn serialize_u128(&mut self, v: u128) -> Result<(), SerializeError> {
        self.buf.push_str(&`"{v}"`);
        return Result::Ok(());
    }

    fn serialize_f32(&mut self, v: f32) -> Result<(), SerializeError> {
        if v.is_nan() {
            return Result::Err(SerializeError {
                kind: SerializeErrorKind::UnsupportedValue,
                message: "NaN is not allowed in JSON",
            });
        }
        if !v.is_finite() {
            return Result::Err(SerializeError {
                kind: SerializeErrorKind::UnsupportedValue,
                message: "Infinity is not allowed in JSON",
            });
        }
        self.buf.push_str(&`{v as f64}`);
        return Result::Ok(());
    }

    fn serialize_f64(&mut self, v: f64) -> Result<(), SerializeError> {
        if v.is_nan() {
            return Result::Err(SerializeError {
                kind: SerializeErrorKind::UnsupportedValue,
                message: "NaN is not allowed in JSON",
            });
        }
        if !v.is_finite() {
            return Result::Err(SerializeError {
                kind: SerializeErrorKind::UnsupportedValue,
                message: "Infinity is not allowed in JSON",
            });
        }
        self.buf.push_str(&`{v}`);
        return Result::Ok(());
    }

    fn serialize_bool(&mut self, v: bool) -> Result<(), SerializeError> {
        if v {
            self.buf.push_str(&"true");
        } else {
            self.buf.push_str(&"false");
        }
        return Result::Ok(());
    }

    fn serialize_char(&mut self, v: char) -> Result<(), SerializeError> {
        let s = `{v}`;
        write_escaped_string(self.buf, &s);
        return Result::Ok(());
    }

    fn serialize_string(&mut self, v: &String) -> Result<(), SerializeError> {
        write_escaped_string(self.buf, v);
        return Result::Ok(());
    }

    fn serialize_null(&mut self) -> Result<(), SerializeError> {
        self.buf.push_str(&"null");
        return Result::Ok(());
    }

    fn begin_seq(&mut self, len: i32) -> Result<NsdSeqSerializer, SerializeError> with stores[self] {
        self.buf.push_str(&"[");
        return Result::Ok(NsdSeqSerializer {
            buf: self.buf,
            count: 0,
        });
    }

    fn begin_map(&mut self, len: i32) -> Result<NsdMapSerializer, SerializeError> with stores[self] {
        self.buf.push_str(&"{");
        return Result::Ok(NsdMapSerializer {
            buf: self.buf,
            count: 0,
            need_value: false,
        });
    }

    fn begin_struct(&mut self, name: &String, fields: i32) -> Result<NsdStructSerializer, SerializeError> with stores[self] {
        // NSD: struct as array
        self.buf.push_str(&"[");
        return Result::Ok(NsdStructSerializer {
            buf: self.buf,
            count: 0,
        });
    }

    fn serialize_unit_variant(&mut self, type_name: &String, variant_name: &String, disc: i32) -> Result<(), SerializeError> {
        // NSD: discriminant integer
        self.buf.push_str(&`{disc}`);
        return Result::Ok(());
    }

    fn begin_variant(&mut self, type_name: &String, variant_name: &String, disc: i32) -> Result<NsdVariantSerializer, SerializeError> with stores[self] {
        // NSD: [disc, payload]
        self.buf.push_str(&`[{disc}`);
        return Result::Ok(NsdVariantSerializer {
            buf: self.buf,
        });
    }
}

struct NsdSeqAccess {
    de: &mut JsonDeserializer,
    first: bool,
}

struct NsdMapAccess {
    de: &mut JsonDeserializer,
    first: bool,
}

struct NsdStructAccess {
    de: &mut JsonDeserializer,
    index: i32,
    num_fields: i32,
    first: bool,
}

struct NsdVariantAccess {
    de: &mut JsonDeserializer,
    disc: i32,
    is_unit: bool,
}

impl DeserializeSeq for NsdSeqAccess {
    fn next_element<T: Deserialize>(&mut self) -> Result<Option<T>, DeserializeError> {
        self.de.skip_whitespace();
        if self.de.pos >= self.de.input.len() {
            return Result::Err(DeserializeError::eof(self.de.pos as i64));
        }
        if self.de.input.get_byte_unchecked(self.de.pos) as i32 == ']' as i32 {
            return Result::Ok(null);
        }
        if !self.first {
            let r = self.de.expect_char(',' as i32);
            if let Err(e) = r {
                return Result::Err(e);
            }
        }
        self.first = false;
        let elem = T::deserialize(&mut NsdDeserializer { de: self.de });
        if let Ok(v) = elem {
            return Result::Ok(Option::Some(v));
        }
        if let Err(e) = elem {
            return Result::Err(e);
        }
        unreachable();
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        return self.de.expect_char(']' as i32);
    }
}

impl DeserializeMap for NsdMapAccess {
    fn next_key_string(&mut self) -> Result<Option<String>, DeserializeError> {
        self.de.skip_whitespace();
        if self.de.pos >= self.de.input.len() {
            return Result::Err(DeserializeError::eof(self.de.pos as i64));
        }
        if self.de.input.get_byte_unchecked(self.de.pos) as i32 == '}' as i32 {
            return Result::Ok(null);
        }
        if !self.first {
            let r = self.de.expect_char(',' as i32);
            if let Err(e) = r {
                return Result::Err(e);
            }
        }
        self.first = false;
        let key_r = self.de.read_json_string();
        if let Ok(key) = key_r {
            let r = self.de.expect_char(':' as i32);
            if let Err(e) = r {
                return Result::Err(e);
            }
            return Result::Ok(Option::Some(key));
        }
        if let Err(e) = key_r {
            return Result::Err(e);
        }
        unreachable();
    }

    fn next_value<V: Deserialize>(&mut self) -> Result<V, DeserializeError> {
        return V::deserialize(&mut NsdDeserializer { de: self.de });
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        return self.de.expect_char('}' as i32);
    }
}

impl DeserializeStruct for NsdStructAccess {
    // NSD is positional: the field schema `S` is irrelevant here. It stays in
    // the signature to satisfy the `DeserializeStruct` trait; the same generated
    // `next_field::<T>()` call site drives both SD and NSD formats.
    fn next_field<S: FieldSchema>(&mut self) -> Result<Option<i32>, DeserializeError> {
        self.de.skip_whitespace();
        if self.de.pos >= self.de.input.len() {
            return Result::Err(DeserializeError::eof(self.de.pos as i64));
        }
        if self.de.input.get_byte_unchecked(self.de.pos) as i32 == ']' as i32 {
            return Result::Ok(null);
        }
        if !self.first {
            let r = self.de.expect_char(',' as i32);
            if let Err(e) = r {
                return Result::Err(e);
            }
        }
        self.first = false;
        // NSD: return sequential field index
        let idx = self.index;
        self.index += 1;
        return Result::Ok(Option::Some(idx));
    }

    fn value<T: Deserialize>(&mut self) -> Result<T, DeserializeError> {
        return T::deserialize(&mut NsdDeserializer { de: self.de });
    }

    fn skip(&mut self) -> Result<(), DeserializeError> {
        return self.de.skip_value();
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        return self.de.expect_char(']' as i32);
    }
}

impl DeserializeVariant for NsdVariantAccess {
    fn variant_name(&mut self) -> Result<String, DeserializeError> {
        return Result::Err(DeserializeError {
            kind: DeserializeErrorKind::Custom,
            message: "NSD does not encode variant names",
            offset: -1,
        });
    }

    fn disc(&mut self) -> Result<i32, DeserializeError> {
        return Result::Ok(self.disc);
    }

    fn payload<T: Deserialize>(&mut self) -> Result<T, DeserializeError> {
        return T::deserialize(&mut NsdDeserializer { de: self.de });
    }

    fn is_unit(&mut self) -> Result<bool, DeserializeError> {
        return Result::Ok(self.is_unit);
    }

    fn end(&mut self) -> Result<(), DeserializeError> {
        if !self.is_unit {
            return self.de.expect_char(']' as i32);
        }
        return Result::Ok(());
    }
}

pub struct NsdDeserializer {
    de: &mut JsonDeserializer,
}

impl Deserializer for NsdDeserializer {
    type SeqAccess = NsdSeqAccess;
    type MapAccess = NsdMapAccess;
    type StructAccess = NsdStructAccess;
    type VariantAccess = NsdVariantAccess;

    fn deserialize_i32(&mut self) -> Result<i32, DeserializeError> {
        return self.de.deserialize_i32();
    }

    fn deserialize_i64(&mut self) -> Result<i64, DeserializeError> {
        return self.de.deserialize_i64();
    }

    fn deserialize_u32(&mut self) -> Result<u32, DeserializeError> {
        return self.de.deserialize_u32();
    }

    fn deserialize_u64(&mut self) -> Result<u64, DeserializeError> {
        return self.de.deserialize_u64();
    }

    fn deserialize_i128(&mut self) -> Result<i128, DeserializeError> {
        return self.de.deserialize_i128();
    }

    fn deserialize_u128(&mut self) -> Result<u128, DeserializeError> {
        return self.de.deserialize_u128();
    }

    fn deserialize_f32(&mut self) -> Result<f32, DeserializeError> {
        return self.de.deserialize_f32();
    }

    fn deserialize_f64(&mut self) -> Result<f64, DeserializeError> {
        return self.de.deserialize_f64();
    }

    fn deserialize_bool(&mut self) -> Result<bool, DeserializeError> {
        return self.de.deserialize_bool();
    }

    fn deserialize_char(&mut self) -> Result<char, DeserializeError> {
        return self.de.deserialize_char();
    }

    fn deserialize_string(&mut self) -> Result<String, DeserializeError> {
        return self.de.deserialize_string();
    }

    fn is_null(&mut self) -> Result<bool, DeserializeError> {
        return self.de.is_null();
    }

    fn begin_seq(&mut self) -> Result<NsdSeqAccess, DeserializeError> with stores[self] {
        let r = self.de.expect_char('[' as i32);
        if let Err(e) = r {
            return Result::Err(e);
        }
        return Result::Ok(NsdSeqAccess {
            de: self.de,
            first: true,
        });
    }

    fn begin_map(&mut self) -> Result<NsdMapAccess, DeserializeError> with stores[self] {
        let r = self.de.expect_char('{' as i32);
        if let Err(e) = r {
            return Result::Err(e);
        }
        return Result::Ok(NsdMapAccess {
            de: self.de,
            first: true,
        });
    }

    fn begin_struct(&mut self, name: &String, num_fields: i32) -> Result<NsdStructAccess, DeserializeError> with stores[self] {
        // NSD: struct encoded as array
        let r = self.de.expect_char('[' as i32);
        if let Err(e) = r {
            return Result::Err(e);
        }
        return Result::Ok(NsdStructAccess {
            de: self.de,
            index: 0,
            num_fields,
            first: true,
        });
    }

    fn begin_variant(&mut self, type_name: &String, num_cases: i32) -> Result<NsdVariantAccess, DeserializeError> with stores[self] {
        self.de.skip_whitespace();
        if self.de.pos >= self.de.input.len() {
            return Result::Err(DeserializeError::eof(self.de.pos as i64));
        }
        let b = self.de.input.get_byte_unchecked(self.de.pos) as i32;
        if b == '[' as i32 {
            // Payload variant: [disc, payload]
            self.de.pos += 1;
            let disc_r = self.de.parse_i32_direct();
            if let Ok(disc) = disc_r {
                let comma_r = self.de.expect_char(',' as i32);
                if let Err(e) = comma_r {
                    return Result::Err(e);
                }
                return Result::Ok(NsdVariantAccess {
                    de: self.de,
                    disc,
                    is_unit: false,
                });
            }
            if let Err(e) = disc_r {
                return Result::Err(e);
            }
            unreachable();
        }
        // Unit variant: bare integer discriminant
        let disc_r = self.de.parse_i32_direct();
        if let Ok(disc) = disc_r {
            return Result::Ok(NsdVariantAccess {
                de: self.de,
                disc,
                is_unit: true,
            });
        }
        if let Err(e) = disc_r {
            return Result::Err(e);
        }
        unreachable();
    }

    fn deserialize_any<V: Visitor>(&mut self, visitor: &mut V) -> Result<V::Value, DeserializeError> {
        return self.de.deserialize_any::<V>(visitor);
    }
}

/// Serializes a value to a JSON NSD string.
pub fn to_string<T: Serialize>(value: &T) -> Result<String, SerializeError> {
    let mut buf: String = "";
    let mut ser = NsdSerializer { buf: &mut buf };
    let r = value.serialize::<NsdSerializer>(&mut ser);
    if let Err(e) = r {
        return Result::Err(e);
    }
    return Result::Ok(buf);
}

/// Deserializes a value from a JSON NSD string.
pub fn from_string<T: Deserialize>(input: String) -> Result<T, DeserializeError> {
    let mut de = JsonDeserializer { input, pos: 0 };
    let mut nsd = NsdDeserializer { de: &mut de };
    let r = T::deserialize(&mut nsd);
    if let Ok(v) = r {
        de.skip_whitespace();
        if de.pos < de.input.len() {
            return Result::Err(DeserializeError::trailing(de.pos as i64));
        }
        return Result::Ok(v);
    }
    if let Err(e) = r {
        return Result::Err(e);
    }
    unreachable();
}
