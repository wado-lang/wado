// The Wado Prelude Module.
// Symbols defined in this module is automatically imported in every module.
//
// To disable the prelude in a module, use: #![no_prelude]

use {log_stderr} from "core:internal";

/// UTF-8 encoded string type
pub struct String {
    repr: builtin::array<u8>,
}

impl String {
    /// Get the length of the string in bytes
    pub fn len(&self) -> i32 {
        return builtin::array_len(self.repr);
    }

    /// Get a byte at the given index
    pub fn get(&self, index: i32) -> i32 {
        return builtin::array_get_u8(self.repr, index);
    }

    /// Set a byte at the given index
    pub fn set(&mut self, index: i32, value: i32) {
        builtin::array_set_u8(self.repr, index, value);
    }
}

// Eq implementation for String - lexicographic equality
impl Eq for String {
    pub fn eq(&self, other: &Self) -> bool {
        let len_a = self.len();
        let len_b = other.len();

        if len_a != len_b {
            return false;
        }

        for let mut i = 0; i < len_a; i += 1 {
            if self.get(i) != other.get(i) {
                return false;
            }
        }

        return true;
    }
}

// Ord implementation for String - lexicographic ordering
impl Ord for String {
    pub fn lt(&self, other: &Self) -> bool {
        let len_a = self.len();
        let len_b = other.len();
        let min_len = if len_b < len_a { len_b } else { len_a };

        for let mut i = 0; i < min_len; i += 1 {
            let a_byte = self.get(i);
            let b_byte = other.get(i);
            if a_byte < b_byte {
                return true;
            }
            if a_byte > b_byte {
                return false;
            }
        }

        // All compared bytes are equal, shorter string is less
        return len_a < len_b;
    }
}

/// Dynamic array type with O(1) amortized append
pub struct Array<T> {
    repr: builtin::array<T>,
    used: i32,
}

impl Array<T> {
    /// Create a new array with the specified capacity
    /// The array starts empty but has space for `capacity` elements
    pub fn with_capacity(capacity: i32) -> Array<T> {
        return Array {
            repr: builtin::array_new::<T>(capacity),
            used: 0,
        };
    }

    /// Create a new array with `n` elements, all initialized to `element`
    pub fn filled(n: i32, element: T) -> Array<T> {
        let repr = builtin::array_new::<T>(n);
        builtin::array_fill::<T>(repr, 0, element, n);
        return Array {
            repr,
            used: n,
        };
    }

    /// Get the number of elements in the array
    pub fn len(&self) -> i32 {
        return self.used;
    }

    /// Get the capacity (allocated size) of the array
    pub fn capacity(&self) -> i32 {
        return builtin::array_len(self.repr);
    }

    /// Append an element to the end of the array
    /// Grows the array if necessary (O(1) amortized)
    pub fn append(&mut self, value: T) {
        let used = self.used;
        let capacity = builtin::array_len(self.repr);

        // Grow if needed
        if builtin::unlikely(used >= capacity) {
            // Calculate new capacity: 4 if empty, otherwise double
            let mut new_capacity = capacity * 2;
            if capacity == 0 {
                new_capacity = 4;
            }

            // Create new array and copy elements
            let new_repr = builtin::array_new::<T>(new_capacity);
            builtin::array_copy::<T>(new_repr, 0, self.repr, 0, used);
            self.repr = new_repr;
        }

        // Set the new element
        builtin::array_set::<T>(self.repr, used, value);
        self.used = used + 1;
    }

    /// Get an element by index (returns a copy)
    pub fn get(&self, index: i32) -> T {
        return builtin::array_get::<T>(self.repr, index);
    }

    /// Set an element by index
    pub fn set(&mut self, index: i32, value: T) {
        builtin::array_set::<T>(self.repr, index, value);
    }
}

// IndexValue implementation for Array<T> - value-based read
// Returns a copy of the element. Works for all element types including primitives.
impl IndexValue<i32> for Array<T> {
    type Output = T;

    fn index_value(&self, index: i32) -> Self::Output {
        return builtin::array_get::<T>(self.repr, index);
    }
}

// IndexAssign implementation for Array<T> - value-based write
// Assigns to the element at the given index.
impl IndexAssign<i32> for Array<T> {
    type Input = T;

    fn index_assign(&mut self, index: i32, value: Self::Input) {
        builtin::array_set::<T>(self.repr, index, value);
    }
}

/// Trait for immutable indexing operations.
/// Types implementing this trait can be indexed with the `[]` operator for reading.
pub trait Index<IndexType> {
    type Output;

    /// Returns a reference to the element at the given index.
    fn index(&self, index: IndexType) -> &Self::Output;
}

/// Trait for mutable indexing operations.
/// Types implementing this trait can be indexed with the `[]` operator to get
/// a mutable reference: `container[i].mutating_method()`.
/// Note: Requires Index to be implemented (supertrait relationship).
pub trait IndexMut<IndexType> {
    type Output;

    /// Returns a mutable reference to the element at the given index.
    fn index_mut(&mut self, index: IndexType) -> &mut Self::Output;
}

/// Trait for index assignment operations.
/// Types implementing this trait can be assigned via the `[]` operator: `arr[i] = value`.
/// This is separate from `IndexMut` because in Wasm GC, you cannot get a mutable reference
/// to primitive array elements - reading and writing are fundamentally different operations.
pub trait IndexAssign<IndexType> {
    type Input;

    /// Assigns a value to the element at the given index.
    fn index_assign(&mut self, index: IndexType, value: Self::Input);
}

/// Trait for value-returning indexing operations.
/// Use this for containers of primitives where references cannot be returned.
/// Unlike `Index` which returns `&Output`, this returns `Output` by value (copy).
pub trait IndexValue<IndexType> {
    type Output;

    /// Returns a copy of the element at the given index.
    fn index_value(&self, index: IndexType) -> Self::Output;
}

/// Trait for equality comparisons.
/// Types implementing this trait can be compared with `==` and `!=` operators.
pub trait Eq {
    /// Returns true if self equals other.
    fn eq(&self, other: &Self) -> bool;
}

/// Trait for ordering comparisons.
/// Types implementing this trait can be compared with `<`, `<=`, `>`, `>=` operators.
pub trait Ord {
    /// Returns true if self is less than other.
    fn lt(&self, other: &Self) -> bool;
}

// ============================================================================
// Arithmetic Operator Traits
// ============================================================================

/// Trait for the `+` operator.
/// Types implementing this trait can use the `+` operator for addition.
pub trait Add {
    type Output;

    /// Adds two values and returns the result.
    fn add(&self, rhs: &Self) -> Self::Output;
}

/// Trait for the `-` operator (binary subtraction).
/// Types implementing this trait can use the `-` operator for subtraction.
pub trait Sub {
    type Output;

    /// Subtracts rhs from self and returns the result.
    fn sub(&self, rhs: &Self) -> Self::Output;
}

/// Trait for the `*` operator.
/// Types implementing this trait can use the `*` operator for multiplication.
pub trait Mul {
    type Output;

    /// Multiplies two values and returns the result.
    fn mul(&self, rhs: &Self) -> Self::Output;
}

/// Trait for the `/` operator.
/// Types implementing this trait can use the `/` operator for division.
pub trait Div {
    type Output;

    /// Divides self by rhs and returns the result.
    fn div(&self, rhs: &Self) -> Self::Output;
}

/// Trait for the `%` operator.
/// Types implementing this trait can use the `%` operator for remainder.
pub trait Rem {
    type Output;

    /// Returns the remainder of dividing self by rhs.
    fn rem(&self, rhs: &Self) -> Self::Output;
}

/// Trait for the unary `-` operator (negation).
/// Types implementing this trait can use the `-` prefix operator.
pub trait Neg {
    type Output;

    /// Returns the negation of self.
    fn neg(&self) -> Self::Output;
}

// ============================================================================
// Bitwise Operator Traits
// ============================================================================

/// Trait for the `&` operator (bitwise AND).
pub trait BitAnd {
    type Output;

    /// Returns the bitwise AND of self and rhs.
    fn bitand(&self, rhs: &Self) -> Self::Output;
}

/// Trait for the `|` operator (bitwise OR).
pub trait BitOr {
    type Output;

    /// Returns the bitwise OR of self and rhs.
    fn bitor(&self, rhs: &Self) -> Self::Output;
}

/// Trait for the `^` operator (bitwise XOR).
pub trait BitXor {
    type Output;

    /// Returns the bitwise XOR of self and rhs.
    fn bitxor(&self, rhs: &Self) -> Self::Output;
}

/// Trait for the `~` operator (bitwise NOT).
pub trait BitNot {
    type Output;

    /// Returns the bitwise NOT of self.
    fn bitnot(&self) -> Self::Output;
}

/// Trait for the `<<` operator (left shift).
pub trait Shl {
    type Output;

    /// Returns self shifted left by rhs bits.
    fn shl(&self, rhs: u32) -> Self::Output;
}

/// Trait for the `>>` operator (right shift).
pub trait Shr {
    type Output;

    /// Returns self shifted right by rhs bits.
    fn shr(&self, rhs: u32) -> Self::Output;
}

/// Trait for callable types (closures and function references).
/// This trait enables closure monomorphization - functions with `fn(A) -> R` parameters
/// are desugared to generic functions with `Fn<[A], R>` bounds.
///
/// Type parameters:
/// - `Args`: Tuple of argument types using `[...]` syntax, e.g., `[i32, String]`
/// - `Ret`: Return type
/// - `Effects`: Tuple of effect types, defaults to `[]` (pure)
///
/// Examples:
/// - `Fn<[i32], bool>` - takes i32, returns bool, pure
/// - `Fn<[i32, String], ()>` - takes i32 and String, returns unit, pure
/// - `Fn<[i32], (), [Stdout]>` - takes i32, returns unit, has Stdout effect
pub trait Fn<Args, Ret, Effects> {
    /// Call the function with the given arguments.
    fn call(&self, args: Args) -> Ret with Effects;
}

/// Optional value - either Some(T) or None
pub variant Option<T> {
    Some(T),
    None,
}

/// Result type - either Ok(T) or Err(E)
pub variant Result<T, E> {
    Ok(T),
    Err(E),
}

/// Stream type - an async sequence of values (WASI Component Model primitive)
/// This is an opaque handle managed by the runtime.
pub struct Stream<T> {
    handle: i32,
}

/// Future type - an async value that will resolve (WASI Component Model primitive)
/// This is an opaque handle managed by the runtime.
pub struct Future<T> {
    handle: i32,
}

/// The core iterator trait for sequences of values.
/// Types implementing this trait can be iterated over using `for-of` loops.
pub trait Iterator {
    type Item;

    /// Advances the iterator and returns the next value.
    /// Returns None when iteration is complete.
    fn next(&mut self) -> Option<Self::Item>;
}

/// Conversion into an Iterator.
/// Types implementing this trait can be used in `for-of` loops directly.
pub trait IntoIterator {
    type Item;
    type Iter;

    /// Creates an iterator from a value.
    /// Note: Uses &self due to parser limitation (self by value not yet supported in traits).
    fn into_iter(&self) -> Self::Iter;
}

/// Iterator over Array<T> elements.
/// Yields copies of each element (value semantics).
pub struct ArrayIter<T> {
    repr: builtin::array<T>,
    used: i32,
    index: i32,
}

impl Iterator for ArrayIter<T> {
    type Item = T;

    fn next(&mut self) -> Option<Self::Item> {
        if self.index >= self.used {
            return null;
        }
        let item = builtin::array_get::<T>(self.repr, self.index);
        self.index += 1;
        return Option::<T>::Some(item);
    }
}

impl IntoIterator for Array<T> {
    type Item = T;
    type Iter = ArrayIter<T>;

    fn into_iter(&self) -> Self::Iter {
        return ArrayIter {
            repr: self.repr,
            used: self.used,
            index: 0,
        };
    }
}

impl Array<T> {
    /// Returns an iterator over the array elements.
    /// Each call to next() returns a copy of the element (value semantics).
    pub fn iter(&self) -> ArrayIter<T> {
        return ArrayIter {
            repr: self.repr,
            used: self.used,
            index: 0,
        };
    }
}

/// Trait for creating a collection from an iterator.
/// This is a simplified version - the full Rust-style trait requires `impl Iterator`
/// syntax which is not yet supported.
trait FromIterator<T> {
    type Iter;
    fn from_iter(iter: Self::Iter) -> Self;
}

impl FromIterator<T> for Array<T> {
    type Iter = ArrayIter<T>;

    fn from_iter(iter: ArrayIter<T>) -> Array<T> {
        let mut result: Array<T> = [];
        let mut it = iter;
        loop {
            if let Some(item) = it.next() {
                result.append(item);
            } else {
                break;
            }
        }
        return result;
    }
}

impl ArrayIter<T> {
    /// Collects iterator elements into an Array.
    /// Consumes the iterator and returns a new Array with all remaining elements.
    pub fn collect(&mut self) -> Array<T> {
        let remaining = self.used - self.index;
        let mut repr = builtin::array_new::<T>(remaining);
        let mut result_used = 0;
        for let mut i = self.index; i < self.used; i += 1 {
            let item = builtin::array_get::<T>(self.repr, i);
            builtin::array_set::<T>(repr, result_used, item);
            result_used += 1;
        }
        // Mark iterator as exhausted
        self.index = self.used;
        return Array { repr, used: result_used };
    }

    /// Reduces the iterator to a single value by applying a function.
    /// Takes an initial value and a function that combines the accumulator with each element.
    pub fn fold<Acc>(&mut self, init: Acc, f: fn(Acc, T) -> Acc) -> Acc {
        let mut acc = init;
        loop {
            if let Some(item) = self.next() {
                acc = f(acc, item);
            } else {
                break;
            }
        }
        return acc;
    }

    /// Creates an iterator that yields (index, element) tuples.
    pub fn enumerate(&self) -> EnumerateIter<T> {
        return EnumerateIter {
            repr: self.repr,
            used: self.used,
            index: self.index,
            count: 0,
        };
    }

    /// Creates an iterator that transforms each element using a function.
    pub fn map<U>(&self, f: fn(T) -> U) -> MapIter<T, U> {
        return MapIter {
            repr: self.repr,
            used: self.used,
            index: self.index,
            f,
        };
    }

    /// Creates an iterator that only yields elements matching a predicate.
    pub fn filter(&self, pred: fn(T) -> bool) -> FilterIter<T> {
        return FilterIter {
            repr: self.repr,
            used: self.used,
            index: self.index,
            pred,
        };
    }
}

/// Iterator that yields (index, element) tuples.
pub struct EnumerateIter<T> {
    repr: builtin::array<T>,
    used: i32,
    index: i32,
    count: i32,
}

impl Iterator for EnumerateIter<T> {
    type Item = [i32, T];

    fn next(&mut self) -> Option<Self::Item> {
        if self.index >= self.used {
            return null;
        }
        let item = builtin::array_get::<T>(self.repr, self.index);
        let idx = self.count;
        self.index += 1;
        self.count += 1;
        return Option::<[i32, T]>::Some([idx, item]);
    }
}

impl EnumerateIter<T> {
    /// Collects iterator elements into an Array.
    pub fn collect(&mut self) -> Array<[i32, T]> {
        let mut result: Array<[i32, T]> = [];
        loop {
            if let Some(item) = self.next() {
                result.append(item);
            } else {
                break;
            }
        }
        return result;
    }
}

/// Iterator that transforms elements using a function.
pub struct MapIter<T, U> {
    repr: builtin::array<T>,
    used: i32,
    index: i32,
    f: fn(T) -> U,
}

impl Iterator for MapIter<T, U> {
    type Item = U;

    fn next(&mut self) -> Option<Self::Item> {
        if self.index >= self.used {
            return null;
        }
        let item = builtin::array_get::<T>(self.repr, self.index);
        self.index += 1;
        return Option::<U>::Some((self.f)(item));
    }
}

impl MapIter<T, U> {
    /// Collects iterator elements into an Array.
    pub fn collect(&mut self) -> Array<U> {
        let mut result: Array<U> = [];
        loop {
            if let Some(item) = self.next() {
                result.append(item);
            } else {
                break;
            }
        }
        return result;
    }

    /// Reduces the iterator to a single value.
    pub fn fold<Acc>(&mut self, init: Acc, f: fn(Acc, U) -> Acc) -> Acc {
        let mut acc = init;
        loop {
            if let Some(item) = self.next() {
                acc = f(acc, item);
            } else {
                break;
            }
        }
        return acc;
    }
}

/// Iterator that filters elements using a predicate.
pub struct FilterIter<T> {
    repr: builtin::array<T>,
    used: i32,
    index: i32,
    pred: fn(T) -> bool,
}

impl Iterator for FilterIter<T> {
    type Item = T;

    fn next(&mut self) -> Option<Self::Item> {
        loop {
            if self.index >= self.used {
                return null;
            }
            let item = builtin::array_get::<T>(self.repr, self.index);
            self.index += 1;
            if (self.pred)(item) {
                return Option::<T>::Some(item);
            }
        }
    }
}

impl FilterIter<T> {
    /// Collects iterator elements into an Array.
    pub fn collect(&mut self) -> Array<T> {
        let mut result: Array<T> = [];
        loop {
            if let Some(item) = self.next() {
                result.append(item);
            } else {
                break;
            }
        }
        return result;
    }

    /// Reduces the iterator to a single value.
    pub fn fold<Acc>(&mut self, init: Acc, f: fn(Acc, T) -> Acc) -> Acc {
        let mut acc = init;
        loop {
            if let Some(item) = self.next() {
                acc = f(acc, item);
            } else {
                break;
            }
        }
        return acc;
    }
}

// ============================================================================
// TreeMap - A sorted map backed by a self-balancing binary search tree
// ============================================================================

// A node in the tree (internal implementation detail)
struct TreeMapNode<K, V> {
    key: K,
    value: V,
    level: i32,
    left: Option<&mut TreeMapNode<K, V>>,
    right: Option<&mut TreeMapNode<K, V>>,
    deleted: bool,
}

impl TreeMapNode<K, V> {
    fn new(key: K, value: V) -> TreeMapNode<K, V> {
        return TreeMapNode {
            key,
            value,
            level: 1,
            left: null,
            right: null,
            deleted: false,
        };
    }
}

/// A sorted map backed by a self-balancing binary search tree (AA tree).
/// Keys are stored in sorted order, enabling efficient range queries.
pub struct TreeMap<K, V> {
    root: Option<&mut TreeMapNode<K, V>>,
    size: i32,
    deleted_count: i32,
}

impl TreeMap<K, V> {
    /// Creates a new empty TreeMap
    pub fn new() -> TreeMap<K, V> {
        return TreeMap {
            root: null,
            size: 0,
            deleted_count: 0,
        };
    }

    /// Returns the number of key-value pairs in the map
    pub fn len(&self) -> i32 { return self.size; }

    /// Returns true if the map contains no elements
    pub fn is_empty(&self) -> bool { return self.size == 0; }

    // Skew: right rotation to fix left horizontal link
    fn skew(&mut self, node: Option<&mut TreeMapNode<K, V>>) -> Option<&mut TreeMapNode<K, V>> {
        if let Some(n) = node {
            if let Some(left) = n.left {
                if left.level == n.level {
                    n.left = left.right;
                    left.right = Option::Some(n);
                    return Option::Some(left);
                }
            }
            return Option::Some(n);
        }
        return null;
    }

    // Split: left rotation to fix consecutive right horizontal links
    fn split(&mut self, node: Option<&mut TreeMapNode<K, V>>) -> Option<&mut TreeMapNode<K, V>> {
        if let Some(n) = node {
            if let Some(right) = n.right {
                if let Some(rr) = right.right {
                    if rr.level == n.level {
                        n.right = right.left;
                        right.left = Option::Some(n);
                        right.level = right.level + 1;
                        return Option::Some(right);
                    }
                }
            }
            return Option::Some(n);
        }
        return null;
    }

    fn insert_at(
        &mut self,
        node: Option<&mut TreeMapNode<K, V>>,
        key: K,
        value: V,
        inserted: &mut bool,
    ) -> Option<&mut TreeMapNode<K, V>> {
        if let Some(n) = node {
            if n.deleted && key == n.key {
                n.value = value;
                n.deleted = false;
                *inserted = true;
                return Option::Some(n);
            }

            if !n.deleted && key == n.key {
                n.value = value;
                return Option::Some(n);
            }

            if key < n.key {
                n.left = self.insert_at(n.left, key, value, inserted);
            } else {
                n.right = self.insert_at(n.right, key, value, inserted);
            }

            let after_skew = self.skew(Option::Some(n));
            return self.split(after_skew);
        }

        let mut new_node = TreeMapNode::<K, V>::new(key, value);
        *inserted = true;
        return Option::Some(&mut new_node);
    }

    /// Inserts a key-value pair into the map.
    /// If the key already exists, the value is updated.
    pub fn insert(&mut self, key: K, value: V) {
        let mut inserted = false;
        self.root = self.insert_at(self.root, key, value, &mut inserted);
        if inserted {
            self.size = self.size + 1;
        }
    }

    fn find_node(&self, key: K) -> Option<&TreeMapNode<K, V>> {
        let mut current = self.root;
        while let Some(n) = current {
            if !n.deleted && key == n.key {
                return Option::Some(n);
            }
            if key < n.key {
                current = n.left;
            } else {
                current = n.right;
            }
        }
        return null;
    }

    /// Returns true if the map contains a value for the specified key
    pub fn contains_key(&self, key: K) -> bool {
        return self.find_node(key) != null;
    }

    /// Returns the value corresponding to the key, or null if not found
    pub fn get(&self, key: K) -> Option<V> {
        if let Some(node) = self.find_node(key) {
            return Option::Some(node.value);
        }
        return null;
    }

    fn find_node_mut(&mut self, key: K) -> Option<&mut TreeMapNode<K, V>> {
        let mut current = self.root;
        while let Some(n) = current {
            if !n.deleted && key == n.key {
                return Option::Some(n);
            }
            if key < n.key {
                current = n.left;
            } else {
                current = n.right;
            }
        }
        return null;
    }

    /// Removes a key from the map. Returns true if the key was present.
    pub fn remove(&mut self, key: K) -> bool {
        if let Some(node) = self.find_node_mut(key) {
            node.deleted = true;
            self.deleted_count = self.deleted_count + 1;
            self.size = self.size - 1;
            if self.deleted_count > self.size {
                self.compact();
            }
            return true;
        }
        return false;
    }

    fn collect_pairs(&self, node: Option<&TreeMapNode<K, V>>, result: &mut Array<[K, V]>) {
        if let Some(n) = node {
            self.collect_pairs(n.left, result);
            if !n.deleted {
                result.append([n.key, n.value]);
            }
            self.collect_pairs(n.right, result);
        }
    }

    fn compact(&mut self) {
        if self.deleted_count == 0 { return; }

        let mut pairs: Array<[K, V]> = [];
        self.collect_pairs(self.root, &mut pairs);

        self.root = null;
        self.deleted_count = 0;
        self.size = 0;

        for let pair of pairs {
            self.insert(pair.0, pair.1);
        }
    }

    fn collect_keys(&self, node: Option<&TreeMapNode<K, V>>, result: &mut Array<K>) {
        if let Some(n) = node {
            self.collect_keys(n.left, result);
            if !n.deleted {
                result.append(n.key);
            }
            self.collect_keys(n.right, result);
        }
    }

    /// Returns all keys in sorted order
    pub fn keys(&self) -> Array<K> {
        let mut result: Array<K> = [];
        self.collect_keys(self.root, &mut result);
        return result;
    }

    fn collect_values(&self, node: Option<&TreeMapNode<K, V>>, result: &mut Array<V>) {
        if let Some(n) = node {
            self.collect_values(n.left, result);
            if !n.deleted {
                result.append(n.value);
            }
            self.collect_values(n.right, result);
        }
    }

    /// Returns all values in key-sorted order
    pub fn values(&self) -> Array<V> {
        let mut result: Array<V> = [];
        self.collect_values(self.root, &mut result);
        return result;
    }

    /// Removes all key-value pairs from the map
    pub fn clear(&mut self) {
        self.root = null;
        self.size = 0;
        self.deleted_count = 0;
    }
}

// IndexAssign for map[key] = value
impl IndexAssign<K> for TreeMap<K, V> {
    type Input = V;
    fn index_assign(&mut self, key: K, value: Self::Input) {
        self.insert(key, value);
    }
}

// IndexValue for map[key] -> Option<V>
impl IndexValue<K> for TreeMap<K, V> {
    type Output = Option<V>;
    fn index_value(&self, key: K) -> Self::Output {
        return self.get(key);
    }
}

// ============================================================================
// Core functions
// ============================================================================

/// Traps with a message
/// Logs the message to stderr (ambient, no effect required) and traps.
pub fn panic(message: String) -> ! {
    log_stderr(message);
    builtin::unreachable();
}

/// Traps with no message
pub fn unreachable() -> ! {
    builtin::unreachable();
}

// ============================================================================
// Re-exports from prelude sub-modules
// ============================================================================

/// 128-bit integer types (i128 and u128)
pub use { i128, u128 } from "./prelude/int128.wado";
