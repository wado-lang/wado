// Tests for `core:log`. The subscriber under test is `CaptureSink`, so
// assertions read the events rather than captured output; the two writing
// sinks are exercised through `render`, which builds the line they write.
//
// Every event asserted on here is at `Error`, the level no build threshold
// folds away, so an ambient `WADO_LOG_LEVEL` cannot change what a test sees.
// A test that needs a particular threshold names it instead:
// `log_level_test.wado` at `trace`, `log_warn_test.wado` at `warn`.

use {
    CaptureSink,
    Context,
    Directive,
    Event,
    Filter,
    JsonSink,
    Level,
    Log,
    Metadata,
    NopSink,
    SpanId,
    TextSink,
    WallClock,
    current,
    enabled,
    error,
    event,
    in_span,
    info,
    level_from_str,
    log_level,
    parse_directives,
    set_log_level,
    span,
} from "core:log";
use { Value } from "core:value";
use { TreeMap } from "core:collections";

fn text_event(level: Level, message: String, fields: Value) -> Event {
    return Event {
        meta: Metadata { level, target: "app", file: "app.wado", line: 7 },
        message,
        fields,
    };
}

// === Events ===

test "captures message, level, and caller location" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        let expected_line = #line + 1;
        error(`hello`);
        assert sink.events.len() == 1;
        let e = sink.events[0];
        assert e.message == "hello";
        assert e.meta.level matches { Error };
        assert e.meta.line == expected_line;
        assert e.meta.file.contains("log_test.wado");

        error(`heads up`, { code: 1 });
        assert sink.events.len() == 2;
        assert sink.events[1].fields matches { Object(_) };
    };
}

test "fields that will not serialize reach the sink as the reason" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        error(`boom`, Value::Undefined);
    };
    assert sink.events.len() == 1;
    let Object(fields) = sink.events[0].fields else {
        unreachable();
    };
    assert fields.len() == 1;
    assert fields["log.fields_error"] matches { String(_) };
}

test "the raw event emitter takes a run-time level" {
    let mut sink = CaptureSink {};
    let mut level = Level::Error;
    with Log => &mut sink do {
        event(level, `dynamic`);
    };
    assert sink.events.len() == 1;
    assert sink.events[0].meta.level matches { Error };
}

test "generic field accepts any Serialize value, preserving the data model" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        error(`with fields`, { user: "alice", n: 42 });
        let e = sink.events[0];
        if let Object(map) = e.fields {
            assert map.len() == 2;
            assert map.get("user") matches { Some(String(_)) };
            // Real to_value preserves Int (a JSON round-trip would give Float).
            assert map.get("n") matches { Some(Int(42)) };
        } else {
            panic("expected Object fields");
        }
    };
}

test "an event with no fields carries an empty object" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        error(`bare`);
    };
    assert sink.events[0].fields matches { Object(map) && map.len() == 0 };
}

// === Levels ===

test "level names round-trip through the lenient parser" {
    assert Level::Trace.name() == "trace";
    assert Level::Error.label() == "ERROR";
    assert Level::from_str_lenient("WARN") matches { Ok(Warn) };
    assert Level::from_str_lenient("nope") matches { Err(_) };
    // The infallible wrapper widens rather than silences.
    assert level_from_str("nope") matches { Trace };
    assert level_from_str("info") matches { Info };
}

test "levels are ordered by declaration" {
    assert Level::Trace < Level::Debug;
    assert Level::Debug < Level::Info;
    assert Level::Info < Level::Warn;
    assert Level::Warn < Level::Error;
}

// === Filtering ===
//
// The three tiers themselves are in `log_level_test.wado`: each needs an event
// below `Warn` to reach the tier under test.

test "tier 2 reports the level it was set to" {
    let prev = log_level();
    set_log_level(Level::Error);
    assert log_level() matches { Error };
    set_log_level(prev);
    assert log_level() == prev;
}

// === Spans ===

test "span lifecycle fires and events parent to the current span" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        let s = span(Level::Info, `request`);
        in_span(&s, || {
            error(`inside`);
        });
        error(`outside`);
    };
    let ops: List<String> = ["new:request#1", "enter:1", "exit:1", "close:1"];
    assert sink.ops == ops;
    assert sink.spans.len() == 1;
    assert sink.spans[0].meta.name == "request";
    assert sink.events.len() == 2;
    assert sink.events[0].message == "inside";
    assert sink.events[0].parent matches { Some(1) };
    assert sink.events[1].message == "outside";
    assert sink.events[1].parent matches { None };
}

test "in_span returns the body value and runs exit on an early return" {
    let mut sink = CaptureSink {};
    let n = with Log => &mut sink do {
        in_span(&span(Level::Info, `early`), || {
            if true {
                return 7;
            }
            info(`unreachable`);
            return 0;
        });
    };
    assert n == 7;
    let ops: List<String> = ["new:early#1", "enter:1", "exit:1", "close:1"];
    assert sink.ops == ops;
    assert sink.events.is_empty();
}

test "nested spans parent to the innermost span" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        let outer = span(Level::Info, `outer`);
        in_span(&outer, || {
            error(`in outer`);
            let inner = span(Level::Info, `inner`);
            in_span(&inner, || {
                error(`in inner`);
            });
            error(`back in outer`);
        });
    };
    assert sink.events[0].parent matches { Some(1) };
    assert sink.events[1].parent matches { Some(2) };
    assert sink.events[2].parent matches { Some(1) };
}

test "current() reports the active span and null outside" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        assert current() matches { None };
        in_span(&span(Level::Info, `s`), || {
            assert current() matches { Some(_) };
        });
        assert current() matches { None };
    };
}

test "record, follows_from and close reach the subscriber" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        let a = span(Level::Info, `a`);
        let b = span(Level::Info, `b`);
        a.record({ user: "alice", ip: "127.0.0.1" });
        b.follows_from(&a);
        a.close();
        assert a.id() == 1;
    };
    let ops: List<String> = ["new:a#1", "new:b#2", "record:1:user", "record:1:ip", "follows:2<-1", "close:1"];
    assert sink.ops == ops;
}

test "span attributes carry name, level and fields" {
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        let s = span(Level::Warn, `job`, { id: 3 });
    };
    let attrs = sink.spans[0];
    assert attrs.meta.name == "job";
    assert attrs.meta.level matches { Warn };
    assert attrs.fields matches { Object(map) && map.len() == 1 };
}

// === Layers ===

test "context layer prepends fields and forwards the rest" {
    let mut sink = CaptureSink {};
    let ctx = Context {
        fields: { request_id: "abc" },
    };
    with Log => &mut sink do {
        with Log => &ctx do {
            error(`x`, { k: "v" });
        };
    };
    assert sink.events.len() == 1;
    if let Object(map) = sink.events[0].fields {
        assert map.len() == 2;
        let entries = map.entries().iter_value().collect();
        assert entries[0][0] == "request_id";
        assert entries[1][0] == "k";
    } else {
        panic("expected Object fields");
    }
}

test "an event field overrides the context layer's" {
    let mut sink = CaptureSink {};
    let ctx = Context {
        fields: { k: "outer" },
    };
    with Log => &mut sink do {
        with Log => &ctx do {
            error(`x`, { k: "inner" });
        };
    };
    if let Object(map) = sink.events[0].fields {
        assert map.len() == 1;
        assert map.get("k") matches { Some(String(s)) && s == "inner" };
    } else {
        panic("expected Object fields");
    }
}

test "a forwarding layer passes span operations through untouched" {
    let mut sink = CaptureSink {};
    let ctx = Context {
        fields: { request_id: "abc" },
    };
    with Log => &mut sink do {
        with Log => &ctx do {
            let s = span(Level::Info, `request`);
            in_span(&s, || {
                s.record({ user: "alice" });
                error(`inside`);
            });
        };
    };
    let ops: List<String> = ["new:request#1", "enter:1", "record:1:user", "exit:1", "close:1"];
    assert sink.ops == ops;
    assert sink.events[0].parent matches { Some(1) };
}

test "a filter's per-target directive overrides its default" {
    let filt = Filter { directives: parse_directives("info,core:json=error,app=debug") };
    assert filt.threshold("other") matches { Info };
    assert filt.threshold("core:json") matches { Error };
    assert filt.threshold("app::db") matches { Debug };
    // The level-only gate is the floor over every directive, so it admits what
    // the per-target pass would go on to admit.
    assert filt.floor() matches { Debug };
}

test "a filter with no directives admits everything" {
    let filt = Filter {};
    assert filt.threshold("anything") matches { Trace };
    assert filt.floor() matches { Trace };
}

test "parse_directives skips malformed entries" {
    let ds = parse_directives("info, ,app=debug,bogus=nope,=warn,app::db=trace,");
    assert ds.len() == 3;
    assert ds[0].target == "";
    assert ds[0].level matches { Info };
    assert ds[1].target == "app";
    assert ds[1].level matches { Debug };
    assert ds[2].target == "app::db";
    assert ds[2].level matches { Trace };
}

test "a directive list is also buildable by hand" {
    let filt = Filter {
        directives: [
            Directive { level: Level::Warn },
            Directive { target: "app", level: Level::Trace },
        ],
    };
    assert filt.threshold("other") matches { Warn };
    assert filt.threshold("app") matches { Trace };
}

// === Sinks ===

test "text sink renders one line per event" {
    let mut sink = TextSink {};
    let line = sink.render(&text_event(Level::Info, "user logged in", Value::Null));
    assert line == "INFO 1 app: user logged in";
    // The sequence number advances per rendered line.
    assert sink.render(&text_event(Level::Warn, "again", Value::Null)) == "WARN 2 app: again";
}

test "a sink over WallClock stamps the line it renders" {
    // The stamp is the time, so what is asserted is its shape and its position:
    // an ISO instant ahead of everything the `NoClock` default renders.
    let mut stamped: TextSink<WallClock> = TextSink { seq: false };
    let line = stamped.render(&text_event(Level::Info, "hi", Value::Null));
    let Some([stamp, rest]) = line.split_once(" ") else {
        panic("a stamped line carries the stamp ahead of the level");
    };
    assert stamp.starts_with("20");
    assert stamp.ends_with("Z");
    assert rest == "INFO app: hi";

    let mut plain = TextSink { seq: false };
    assert plain.render(&text_event(Level::Info, "hi", Value::Null)) == "INFO app: hi";
}

test "text sink appends fields as key=value, unquoted" {
    let mut sink = TextSink { seq: false };
    let mut fields: TreeMap<String, Value> = TreeMap::new();
    fields["user_id"] = Value::Int(7);
    fields["ip"] = Value::String("127.0.0.1");
    let line = sink.render(&text_event(Level::Info, "hi", Value::Object(fields)));
    assert line == "INFO app: hi user_id=7 ip=127.0.0.1";
}

test "text sink location is opt-in" {
    let mut sink = TextSink { seq: false, location: true };
    let line = sink.render(&text_event(Level::Error, "boom", Value::Null));
    assert line == "ERROR app: boom at app.wado:7";
}

test "text sink names the parent span" {
    let mut sink = TextSink { seq: false };
    let mut e = text_event(Level::Info, "inside", Value::Null);
    e.parent = Option::<SpanId>::Some(3);
    assert sink.render(&e) == "INFO span=3 app: inside";
}

test "json sink writes one object per event" {
    let mut sink = JsonSink {};
    let mut fields: TreeMap<String, Value> = TreeMap::new();
    fields["user_id"] = Value::Int(7);
    let line = sink.render(&text_event(Level::Info, "user logged in", Value::Object(fields)));
    assert line == "{\"seq\":1,\"level\":\"info\",\"target\":\"app\",\"message\":\"user logged in\",\"fields\":{\"user_id\":7}}";
}

test "json sink omits the keys its switches turn off" {
    let mut sink = JsonSink { seq: false };
    let line = sink.render(&text_event(Level::Warn, "plain", Value::Null));
    assert line == "{\"level\":\"warn\",\"target\":\"app\",\"message\":\"plain\",\"fields\":null}";
}

test "json sink includes the parent span and location when asked" {
    let mut sink = JsonSink { seq: false, location: true };
    let mut e = text_event(Level::Info, "inside", Value::Null);
    e.parent = Option::<SpanId>::Some(3);
    let line = sink.render(&e);
    assert line.contains("\"span\":3");
    assert line.contains("\"file\":\"app.wado\"");
    assert line.contains("\"line\":7");
}

test "the writing sinks track spans like any subscriber" {
    let mut sink = TextSink {};
    with Log => &mut sink do {
        let s = span(Level::Info, `request`);
        assert s.id() == 1;
        in_span(&s, || {
            assert current() matches { Some(_) };
        });
        assert current() matches { None };
    };
}

// === The default subscriber ===
//
// With no handler installed the interface's own default implementations run:
// one text line per event on stderr. `wado test` captures a test's stderr and
// shows it only when the test fails, so these lines are post-mortem detail
// rather than noise. What the default admits is in `log_level_test.wado`.

test "logging with no sink installed neither traps nor is silent" {
    // No `with Log` anywhere: every call lands on a default implementation.
    error(`default subscriber`, { k: "v" });
    error(`still fine`);
    assert enabled(Level::Error);
}

test "spans work against the default subscriber" {
    assert current() matches { None };
    let n = in_span(&span(Level::Info, `default span`), || {
        assert current() matches { Some(_) };
        return 5;
    });
    assert n == 5;
    assert current() matches { None };
}

test "NopSink is how a program asks for silence" {
    let mut sink = NopSink {};
    with Log => &mut sink do {
        assert !enabled(Level::Error);
        error(`dropped`);
    };
}

test "an explicit target replaces the caller's #function" {
    // The target defaults to the caller's `#function`, so a `Filter` directive
    // names a function, not a module path. Passing `target` explicitly is how
    // events get grouped under a name of the application's choosing.
    let mut sink = CaptureSink {};
    with Log => &mut sink do {
        error(`default target`);
        error(`grouped under db`, {}, "db");
    };
    assert sink.events[0].meta.target.contains("explicit_target");
    assert sink.events[1].meta.target == "db";
}
