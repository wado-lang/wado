#![stdlib("core:temporal")]
//! Minimal date and time types, modelled on TC39 Temporal.
//!
//! This is the MVP described in `docs/wep-2026-06-05-core-temporal.md`: it
//! provides only the two value types every temporal API is built around, an
//! exact point on the timeline (`Instant`) and that instant paired with a
//! time-zone interpretation (`ZonedDateTime`). They carry ISO 8601 / RFC 3339
//! formatting (`Display`), civil field accessors, RFC 3339 parsing, epoch
//! constructors, and serde `Serialize`/`Deserialize` (an RFC 3339 string under
//! CBOR's date/time tag 0, a bare string in JSON; an epoch-seconds number is
//! also accepted on decode); arithmetic, `now()`, and
//! `Duration` are deferred to follow-up work. The types exist so a serde format
//! such as `core:json` or `core:cbor` has a concrete Wado type for timestamps.
//!
//! Relationship to `wasi:clocks`: `wasi:clocks` exposes its own `Instant`
//! record (`{ seconds, nanoseconds }`) for the system clock. That type is a
//! Component Model binding — pinned to a specific WASI version and regenerated
//! by `wado-from-idl` — whereas `core:temporal`'s `Instant` is a plain,
//! version-independent Wado type that grows methods. They share a name and
//! field layout deliberately: it is "the same concept, a different type". To
//! bridge them without making either depend on the other's representation,
//! `core:temporal` provides `From` impls both ways (a field-for-field copy), so
//! a clock reading converts with `Instant::from(SystemClock::now())` and back
//! with `ClockInstant::from`. Merely naming the `wasi:clocks` record in these
//! impls is not a runtime use of the clock, so it pulls in no WASI import for a
//! component that never calls one.
//!
//! Both `core:temporal` types are ISO 8601 only and so store no calendar.

use {
    Serialize,
    Serializer,
    SerializeError,
    Deserialize,
    Deserializer,
    DeserializeError,
    Visitor,
    DeserializeSeq,
    DeserializeMap,
} from "core:serde";
use { Instant as ClockInstant } from "wasi:clocks";

#[synopsis]
test {
    let epoch = Instant::from_epoch_seconds(0);
    assert `${epoch}` == "1970-01-01T00:00:00Z";
    assert epoch < Instant::from_epoch_seconds(1_000_000_000);

    assert ZonedDateTime::parse_rfc3339("2023-11-14T22:13:20+09:00") matches { Ok(zoned) && zoned.hour() == 22
        && `${zoned}` == "2023-11-14T22:13:20+09:00" };
}

/// An exact point on the timeline, as the offset from the Unix epoch
/// (1970-01-01T00:00:00Z). Time-zone- and calendar-independent.
///
/// Corresponds to `Temporal.Instant` and the `wasi:clocks` `instant` record.
/// Where Temporal stores `epochNanoseconds` as a BigInt, this uses an `i64`
/// second count (≈ ±292 billion years, far beyond Temporal's ±273,790-year
/// range) plus a `u32` sub-second part for full nanosecond resolution — the
/// exact shape of `wasi:clocks` `instant`.
///
/// `Ord` is auto-derived and orders chronologically: `seconds` is compared
/// first, then `nanoseconds`.
pub struct Instant {
    /// Whole seconds since the Unix epoch. Negative values are before it.
    pub seconds: i64,
    /// Sub-second component, always in `0..<1_000_000_000`. Incrementing
    /// `nanoseconds` always moves forward in time, even when `seconds < 0`
    /// (e.g. one nanosecond before the epoch is
    /// `Instant { seconds: -1, nanoseconds: 999_999_999 }`). Use `Instant::new`
    /// to normalize an arbitrary count into this range; the accessors assume it.
    pub nanoseconds: u32,
}

impl Eq for Instant;
impl Ord for Instant;

/// An exact instant together with the time zone it is interpreted in.
///
/// Corresponds to `Temporal.ZonedDateTime` — the only "complete" temporal
/// value (an instant plus a wall-clock interpretation). The calendar is always
/// ISO 8601 and therefore not stored. The broken-down wall-clock fields (year,
/// month, day, hour, …) are a function of `instant` + `time_zone`, computed on
/// demand by accessors rather than stored state.
///
/// `Ord` is auto-derived and orders by `instant` first, then `time_zone`
/// lexically, so it stays consistent with the derived `Eq`. Temporal splits the
/// two questions — `compare` weighs only the instant, `equals` the zone as well
/// — so for "the same moment, wherever it is read" compare `to_instant()`
/// rather than the values. `new` canonicalizes the three spellings of UTC, so
/// `"UTC"`, `"z"`, and `"+00:00"` are one zone rather than three.
pub struct ZonedDateTime {
    /// The exact instant.
    pub instant: Instant,
    /// IANA time-zone identifier (e.g. `"America/New_York"`, `"UTC"`) or a
    /// fixed UTC offset (e.g. `"+09:00"`). Mirrors the Temporal time-zone slot,
    /// which is also a string after the removal of `Temporal.TimeZone`. Only
    /// `"UTC"`/`"Z"` and fixed `±HH:MM` offsets are interpretable today; every
    /// operation traps on an IANA name until a tz database is bundled.
    pub time_zone: String,
}

impl Eq for ZonedDateTime;
impl Ord for ZonedDateTime;

// Display / DisplayAlt — ISO 8601 / RFC 3339 stringification.
//
// The format specifier's precision selects how many sub-second digits to print
// (truncated, not rounded). With no precision given, `Display` (`${x}`) prints
// whole seconds and `DisplayAlt` (`${x:#}`) prints milliseconds. `Inspect`
// (`${x:?}`) is left as the auto-derived structural form.

impl Display for Instant {
    fn fmt(&self, f: &mut Formatter) {
        let digits = resolve_fraction_digits(f, 0);
        f.pad(render_iso8601(self.seconds, self.nanoseconds, 0, digits, "Z"));
    }
}

impl DisplayAlt for Instant {
    fn fmt_alt(&self, f: &mut Formatter) {
        let digits = resolve_fraction_digits(f, 3);
        f.pad(render_iso8601(self.seconds, self.nanoseconds, 0, digits, "Z"));
    }
}

impl Display for ZonedDateTime {
    fn fmt(&self, f: &mut Formatter) {
        format_zoned(self, f, 0);
    }
}

impl DisplayAlt for ZonedDateTime {
    fn fmt_alt(&self, f: &mut Formatter) {
        format_zoned(self, f, 3);
    }
}

/// Resolve the formatter's precision into a sub-second digit count in `0..=9`,
/// falling back to `default_digits` when no precision was given.
fn resolve_fraction_digits(f: &Formatter, default_digits: i32) -> i32 {
    let p = f.precision;
    if p == Formatter::PRECISION_DEFAULT {
        return default_digits;
    }
    if p == Formatter::PRECISION_INFINITE {
        return 9;
    }
    if p < 0 {
        return 0;
    }
    if p > 9 {
        return 9;
    }
    return p;
}

/// Render an instant as an ISO 8601 / RFC 3339 string in the civil time given
/// by `offset_seconds` (0 for UTC), with `digits` truncated sub-second digits
/// and the given zone `suffix` (e.g. `"Z"` or `"+09:00"`).
fn render_iso8601(seconds: i64, nanoseconds: u32, offset_seconds: i64, digits: i32, suffix: String) -> String {
    let local = seconds + offset_seconds;
    let [days, second_of_day] = epoch_days_and_seconds(local);
    let [year, month, day] = civil_from_days(days);
    let hour = second_of_day / 3600;
    let minute = second_of_day % 3600 / 60;
    let second = second_of_day % 60;
    let year_str = format_iso_year(year);
    let fraction = format_fraction(nanoseconds, digits);
    return `${year_str}-${month:02}-${day:02}T${hour:02}:${minute:02}:${second:02}${fraction}${suffix}`;
}

/// Split an epoch-second count into whole days since 1970-01-01 and the
/// second-of-day, flooring toward negative infinity so instants before the
/// epoch land on the correct civil day.
fn epoch_days_and_seconds(epoch_seconds: i64) -> [i64, i64] {
    let seconds_per_day: i64 = 86400;
    let mut days = epoch_seconds / seconds_per_day;
    let mut rem = epoch_seconds % seconds_per_day;
    if rem < 0 {
        days = days - 1;
        rem = rem + seconds_per_day;
    }
    return [days, rem];
}

/// Convert a day count since 1970-01-01 into a proleptic Gregorian (ISO 8601)
/// `[year, month, day]`. Howard Hinnant's `civil_from_days` algorithm, valid
/// for any day count, including negatives.
fn civil_from_days(days: i64) -> [i64, i64, i64] {
    let z = days + 719468;
    let era = if z >= 0 { z } else { z - 146096 } / 146097;
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let year = yoe + era * 400;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let day = doy - (153 * mp + 2) / 5 + 1;
    let month = if mp < 10 { mp + 3 } else { mp - 9 };
    let civil_year = if month <= 2 { year + 1 } else { year };
    return [civil_year, month, day];
}

/// Format the year per ISO 8601 / Temporal `PadISOYear`: four digits in
/// `0..=9999`, otherwise a sign followed by six digits.
fn format_iso_year(year: i64) -> String {
    if year >= 0 && year <= 9999 {
        return `${year:04}`;
    }
    if year > 9999 {
        return `+${year:06}`;
    }
    let magnitude = -year;
    return `-${magnitude:06}`;
}

/// Format the `.fff…` fractional-second suffix, truncated to `digits`
/// most-significant digits of the nanosecond field. Returns `""` for 0 digits.
fn format_fraction(nanoseconds: u32, digits: i32) -> String {
    if digits <= 0 {
        return "";
    }
    let mut divisor: u32 = 1;
    let mut i = digits;
    while i < 9 {
        divisor = divisor * 10;
        i = i + 1;
    }
    let value = nanoseconds / divisor;
    let value_str = `${value}`;
    let zeros = digits - value_str.len();
    let padding = if zeros > 0 { "0".repeat(zeros) } else { "" };
    return `.${padding}${value_str}`;
}

/// Render a `ZonedDateTime` for `Display`/`DisplayAlt`. Only fixed UTC offsets
/// are supported; an IANA zone name traps, because resolving its offset needs
/// a time-zone database this MVP does not bundle.
fn format_zoned(zdt: &ZonedDateTime, f: &mut Formatter, default_digits: i32) {
    let digits = resolve_fraction_digits(f, default_digits);
    let offset = parse_fixed_offset(&zdt.time_zone);
    let suffix = format_offset_suffix(offset);
    f.pad(render_iso8601(zdt.instant.seconds, zdt.instant.nanoseconds, offset, digits, suffix));
}

/// A fixed UTC offset zone string as a signed second count, or `None` when the
/// zone is not one: `"Z"`/`"z"`, `"UTC"`, and ±HH:MM are the forms understood.
fn try_fixed_offset(zone: &String) -> Option<i64> {
    let n = zone.len();
    if n == 1 && (zone.get_byte_unchecked(0) == b'Z' || zone.get_byte_unchecked(0) == b'z') {
        return Option::Some(0);
    }
    if n == 3
        && zone.get_byte_unchecked(0) == b'U'
        && zone.get_byte_unchecked(1) == b'T'
        && zone.get_byte_unchecked(2) == b'C' {
        return Option::Some(0);
    }
    let well_formed = n == 6
        && (zone.get_byte_unchecked(0) == b'+' || zone.get_byte_unchecked(0) == b'-')
        && is_ascii_digit(zone.get_byte_unchecked(1))
        && is_ascii_digit(zone.get_byte_unchecked(2))
        && zone.get_byte_unchecked(3) == b':'
        && is_ascii_digit(zone.get_byte_unchecked(4))
        && is_ascii_digit(zone.get_byte_unchecked(5));
    if !well_formed {
        return Option::None;
    }
    let hours = (zone.get_byte_unchecked(1) - b'0') as i64 * 10 + (zone.get_byte_unchecked(2) - b'0') as i64;
    let minutes = (zone.get_byte_unchecked(4) - b'0') as i64 * 10 + (zone.get_byte_unchecked(5) - b'0') as i64;
    let magnitude = hours * 3600 + minutes * 60;
    if zone.get_byte_unchecked(0) == b'-' {
        return Option::Some(-magnitude);
    }
    return Option::Some(magnitude);
}

/// The fixed UTC offset of `zone` in seconds. Any other value (notably an IANA
/// zone name) traps with a clear message.
fn parse_fixed_offset(zone: &String) -> i64 {
    if let Some(offset) = try_fixed_offset(zone) {
        return offset;
    }
    panic(
        `core:temporal: time zone "${zone}" is not a fixed UTC offset; only "Z", "UTC", and ±HH:MM are supported (IANA zone offset resolution is future work)`,
    );
}

fn is_ascii_digit(byte: u8) -> bool {
    return byte >= 0x30 && byte <= 0x39;
}

/// Format a signed offset second count as `"Z"` (when zero) or `±HH:MM`.
fn format_offset_suffix(offset_seconds: i64) -> String {
    if offset_seconds == 0 {
        return "Z";
    }
    let sign = if offset_seconds < 0 { "-" } else { "+" };
    let magnitude = if offset_seconds < 0 { -offset_seconds } else { offset_seconds };
    let hours = magnitude / 3600;
    let minutes = magnitude % 3600 / 60;
    return `${sign}${hours:02}:${minutes:02}`;
}

// Accessors.
//
// Following Temporal, the broken-down wall-clock fields live on `ZonedDateTime`
// (an instant has no zone, so civil fields are undefined for it). `Instant`
// exposes only epoch-based convenience values. The calendar is always ISO 8601.

impl Instant {
    /// Construct an instant `nanoseconds` after `seconds` since the Unix epoch,
    /// normalizing so the stored sub-second part lands in `0..<1_000_000_000`
    /// even when `nanoseconds` is negative or `>= 1_000_000_000`. This is the
    /// canonical funnel that upholds the field invariant the accessors rely on.
    pub fn new(seconds: i64, nanoseconds: i64) -> Instant {
        let mut whole = seconds + nanoseconds / 1_000_000_000;
        let mut sub = nanoseconds % 1_000_000_000;
        if sub < 0 {
            whole = whole - 1;
            sub = sub + 1_000_000_000;
        }
        return Instant { seconds: whole, nanoseconds: sub as u32 };
    }

    /// Construct an instant from whole seconds since the Unix epoch (CBOR tag 1
    /// integer form).
    pub fn from_epoch_seconds(seconds: i64) -> Instant {
        return Instant { seconds: seconds, nanoseconds: 0 };
    }

    /// Construct an instant from milliseconds since the Unix epoch. The inverse
    /// of `epoch_milliseconds`.
    pub fn from_epoch_milliseconds(milliseconds: i64) -> Instant {
        return Instant::new(milliseconds / 1000, milliseconds % 1000 * 1_000_000);
    }

    /// Construct an instant from nanoseconds since the Unix epoch. The inverse
    /// of `epoch_nanoseconds`, and like it spanning the whole `i64`-second
    /// range.
    pub fn from_epoch_nanoseconds(nanoseconds: i128) -> Instant {
        return Instant::new((nanoseconds / 1_000_000_000) as i64, (nanoseconds % 1_000_000_000) as i64);
    }

    /// Construct an instant from fractional seconds since the Unix epoch (CBOR
    /// tag 1 floating-point form). The fraction is rounded to the nearest
    /// nanosecond; `f64` precision limits sub-microsecond accuracy near the
    /// present.
    pub fn from_unix_seconds(seconds: f64) -> Instant {
        let whole = f64::floor(seconds);
        let nanos = f64::floor((seconds - whole) * 1000000000.0 + 0.5);
        return Instant::new(whole as i64, nanos as i64);
    }

    /// The Unix epoch itself, 1970-01-01T00:00:00Z.
    pub const EPOCH: Instant = Instant { seconds: 0, nanoseconds: 0 };

    /// Construct an instant from microseconds since the Unix epoch. The inverse
    /// of `epoch_microseconds`.
    pub fn from_epoch_microseconds(microseconds: i64) -> Instant {
        return Instant::new(microseconds / 1_000_000, microseconds % 1_000_000 * 1000);
    }

    /// Microseconds since the Unix epoch, flooring toward the epoch's past so a
    /// pre-epoch instant keeps moving forward with `nanoseconds`.
    pub fn epoch_microseconds(&self) -> i64 {
        return self.seconds * 1_000_000 + (self.nanoseconds / 1000) as i64;
    }

    /// Milliseconds since the Unix epoch (`Temporal.Instant.epochMilliseconds`).
    pub fn epoch_milliseconds(&self) -> i64 {
        return self.seconds * 1000 + self.nanoseconds as i64 / 1_000_000;
    }

    /// Nanoseconds since the Unix epoch (`Temporal.Instant.epochNanoseconds`).
    ///
    /// Temporal uses a BigInt; `i128` covers the whole `i64`-second range with
    /// nanosecond resolution, so this never truncates.
    pub fn epoch_nanoseconds(&self) -> i128 {
        return self.seconds as i128 * 1_000_000_000 + self.nanoseconds as i128;
    }

    /// RFC 3339 / ISO 8601 string in UTC (`…Z`), using the least sub-second
    /// precision (0, 3, 6, or 9 fraction digits) that represents the instant
    /// exactly. This is the serde wire form.
    pub fn to_rfc3339(&self) -> String {
        let digits = fraction_digits_for(self.nanoseconds);
        return render_iso8601(self.seconds, self.nanoseconds, 0, digits, "Z");
    }

    /// Parse an RFC 3339 / ISO 8601 timestamp into the exact instant it names,
    /// discarding the offset. Same grammar as `ZonedDateTime::parse_rfc3339`.
    pub fn parse_rfc3339(text: String) -> Result<Instant, DeserializeError> {
        return Result::Ok(parse_iso_zoned(&text, 0, text.len())?.instant);
    }

    /// Interpret this instant in `time_zone`, the zoned view of the same moment
    /// (`Temporal.Instant.toZonedDateTimeISO`).
    pub fn to_zoned_date_time(&self, time_zone: String) -> ZonedDateTime {
        return ZonedDateTime::new(*self, time_zone);
    }
}

impl FromStr for Instant {
    type Err = DeserializeError;

    fn from_str_range(s: &String, start: i32, end: i32) -> Result<Instant, DeserializeError> {
        return Result::Ok(parse_iso_zoned(s, start, end)?.instant);
    }
}

impl FromStr for ZonedDateTime {
    type Err = DeserializeError;

    fn from_str_range(s: &String, start: i32, end: i32) -> Result<ZonedDateTime, DeserializeError> {
        return parse_iso_zoned(s, start, end);
    }
}

impl ZonedDateTime {
    /// Parse an RFC 3339 / ISO 8601 timestamp such as
    /// `"2023-11-14T22:13:20.5+09:00"` or `"1970-01-01T00:00:00Z"`, preserving
    /// the offset as a fixed-offset zone (so it round-trips through `to_rfc3339`
    /// / `Display` in canonical form).
    ///
    /// The grammar is `[±]Y…Y-MM-DDThh:mm:ss[.fraction](Z|±hh:mm)`: the year is
    /// four digits, or a sign followed by six (ISO 8601 expanded years), the
    /// date/time separator may be `T`, `t`, or a space, the fraction is
    /// truncated to nanosecond precision, a leap second (`:60`) is constrained
    /// to `:59`, and the offset is mandatory. `"Z"` and `"+00:00"` both
    /// normalize to a `"Z"` zone. Field values are range-checked against the
    /// ISO 8601 calendar (so e.g. `"2023-02-29"` and `"…T24:00:00Z"` are
    /// rejected); malformed or out-of-range input returns a `DeserializeError`
    /// carrying the byte offset of the problem.
    pub fn parse_rfc3339(text: String) -> Result<ZonedDateTime, DeserializeError> {
        return parse_iso_zoned(&text, 0, text.len());
    }

    /// RFC 3339 / ISO 8601 string in this zone's local time, with the offset
    /// suffix (or `Z`) and the least sub-second precision that is exact. This is
    /// the serde wire form. Traps on an IANA zone name (offset resolution is
    /// future work).
    pub fn to_rfc3339(&self) -> String {
        let offset = parse_fixed_offset(&self.time_zone);
        let digits = fraction_digits_for(self.instant.nanoseconds);
        return render_iso8601(self.instant.seconds, self.instant.nanoseconds, offset, digits, format_offset_suffix(
            offset,
        ));
    }

    /// ISO year in the zone's local time. May be negative or beyond four digits.
    pub fn year(&self) -> i32 {
        let [_, year, _, _, _] = self.local_parts();
        return year as i32;
    }

    /// Month of the year, `1..=12`.
    pub fn month(&self) -> i32 {
        let [_, _, month, _, _] = self.local_parts();
        return month as i32;
    }

    /// Day of the month, `1..=31`.
    pub fn day(&self) -> i32 {
        let [_, _, _, day, _] = self.local_parts();
        return day as i32;
    }

    /// Hour of the day, `0..=23`.
    pub fn hour(&self) -> i32 {
        let [_, _, _, _, second_of_day] = self.local_parts();
        return (second_of_day / 3600) as i32;
    }

    /// Minute of the hour, `0..=59`.
    pub fn minute(&self) -> i32 {
        let [_, _, _, _, second_of_day] = self.local_parts();
        return (second_of_day % 3600 / 60) as i32;
    }

    /// Second of the minute, `0..=59`.
    pub fn second(&self) -> i32 {
        let [_, _, _, _, second_of_day] = self.local_parts();
        return (second_of_day % 60) as i32;
    }

    /// Millisecond of the second, `0..=999`.
    pub fn millisecond(&self) -> i32 {
        return (self.instant.nanoseconds / 1_000_000) as i32;
    }

    /// Microsecond of the millisecond, `0..=999`.
    pub fn microsecond(&self) -> i32 {
        return (self.instant.nanoseconds / 1000 % 1000) as i32;
    }

    /// Nanosecond of the microsecond, `0..=999`.
    pub fn nanosecond(&self) -> i32 {
        return (self.instant.nanoseconds % 1000) as i32;
    }

    /// Day of the week, `1` (Monday) through `7` (Sunday), per ISO 8601.
    pub fn day_of_week(&self) -> i32 {
        let [days, _, _, _, _] = self.local_parts();
        return (floor_mod(days + 3, 7) + 1) as i32;
    }

    /// Day of the year, `1..=366`.
    pub fn day_of_year(&self) -> i32 {
        let [days, year, _, _, _] = self.local_parts();
        return (days - days_from_civil(year, 1, 1) + 1) as i32;
    }

    /// Number of days in this month, `28..=31`.
    pub fn days_in_month(&self) -> i32 {
        let [_, year, month, _, _] = self.local_parts();
        return days_in_month_value(year, month) as i32;
    }

    /// Number of days in this year, `365` or `366`.
    pub fn days_in_year(&self) -> i32 {
        let [_, year, _, _, _] = self.local_parts();
        if is_leap_year(year) {
            return 366;
        }
        return 365;
    }

    /// Whether this year is a leap year in the ISO 8601 calendar.
    pub fn in_leap_year(&self) -> bool {
        let [_, year, _, _, _] = self.local_parts();
        return is_leap_year(year);
    }

    /// Interpret `instant` in `time_zone`, canonicalizing the three spellings of
    /// UTC (`"UTC"`, `"z"`, `±00:00`) to `"Z"` so they are one value under the
    /// derived `Eq`. Any other zone is stored verbatim.
    pub fn new(instant: Instant, time_zone: String) -> ZonedDateTime {
        return ZonedDateTime { instant: instant, time_zone: canonical_time_zone(time_zone) };
    }

    /// The exact instant, dropping the zone (`Temporal.ZonedDateTime.toInstant`).
    pub fn to_instant(&self) -> Instant {
        return self.instant;
    }

    /// Milliseconds since the Unix epoch.
    pub fn epoch_milliseconds(&self) -> i64 {
        return self.instant.epoch_milliseconds();
    }

    /// Nanoseconds since the Unix epoch.
    pub fn epoch_nanoseconds(&self) -> i128 {
        return self.instant.epoch_nanoseconds();
    }

    /// The zone's UTC offset at this instant, as `±HH:MM`. Temporal spells a
    /// zero offset `"+00:00"` here even where the zone is `"Z"`.
    pub fn offset(&self) -> String {
        let offset = parse_fixed_offset(&self.time_zone);
        let sign = if offset < 0 { "-" } else { "+" };
        let magnitude = if offset < 0 { -offset } else { offset };
        return `${sign}${magnitude / 3600:02}:${magnitude % 3600 / 60:02}`;
    }

    /// The zone's UTC offset at this instant, in nanoseconds.
    pub fn offset_nanoseconds(&self) -> i64 {
        return parse_fixed_offset(&self.time_zone) * 1_000_000_000;
    }

    /// The same instant read in another zone.
    pub fn with_time_zone(&self, time_zone: String) -> ZonedDateTime {
        return ZonedDateTime::new(self.instant, time_zone);
    }

    /// Local midnight on this value's day. Traps on an IANA zone name.
    pub fn start_of_day(&self) -> ZonedDateTime {
        let offset = parse_fixed_offset(&self.time_zone);
        let [days, _, _, _, _] = self.local_parts();
        return ZonedDateTime {
            instant: Instant { seconds: days * 86400 - offset, nanoseconds: 0 },
            time_zone: self.time_zone,
        };
    }

    /// Hours between this day's start and the next. A fixed offset has no DST,
    /// so it is always 24; an IANA zone traps.
    pub fn hours_in_day(&self) -> i32 {
        let _ = parse_fixed_offset(&self.time_zone);
        return 24;
    }

    /// ISO 8601 week of the week-year, `1..=53`.
    pub fn week_of_year(&self) -> i32 {
        let [_, year, _, _, _] = self.local_parts();
        let [week, _] = iso_week_date(year, self.day_of_year() as i64, self.day_of_week() as i64);
        return week as i32;
    }

    /// ISO 8601 week-numbering year, which differs from `year` in the days at
    /// either end of the year that belong to the neighbour's week.
    pub fn year_of_week(&self) -> i32 {
        let [_, year, _, _, _] = self.local_parts();
        let [_, week_year] = iso_week_date(year, self.day_of_year() as i64, self.day_of_week() as i64);
        return week_year as i32;
    }

    /// Number of days in this week — always `7` for ISO 8601.
    pub fn days_in_week(&self) -> i32 {
        let _ = parse_fixed_offset(&self.time_zone);
        return 7;
    }

    /// Temporal month code, `"M01"` … `"M12"` under the ISO 8601 calendar.
    pub fn month_code(&self) -> String {
        return `M${self.month():02}`;
    }

    /// Number of months in this year — always `12` for ISO 8601.
    pub fn months_in_year(&self) -> i32 {
        // Validate the zone for consistency with the other accessors (all of
        // which trap on an unresolvable zone); the ISO 8601 answer is 12.
        let _ = parse_fixed_offset(&self.time_zone);
        return 12;
    }

    /// Local broken-down parts `[days_since_epoch, year, month, day,
    /// second_of_day]` after applying the fixed UTC offset. Traps on an IANA
    /// zone name (offset resolution is future work).
    fn local_parts(&self) -> [i64, i64, i64, i64, i64] {
        let offset = parse_fixed_offset(&self.time_zone);
        let local = self.instant.seconds + offset;
        let [days, second_of_day] = epoch_days_and_seconds(local);
        let [year, month, day] = civil_from_days(days);
        return [days, year, month, day, second_of_day];
    }
}

/// Non-negative remainder of `a` modulo positive `m`.
fn floor_mod(a: i64, m: i64) -> i64 {
    let r = a % m;
    if r < 0 {
        return r + m;
    }
    return r;
}

/// Canonicalize the spellings of a zero-offset zone (`"UTC"`, `"z"`, `±00:00`)
/// to `"Z"`, and a fixed offset to `±HH:MM`. Anything else is left verbatim.
fn canonical_time_zone(zone: String) -> String {
    if let Some(offset) = try_fixed_offset(&zone) {
        return format_offset_suffix(offset);
    }
    return zone;
}

/// ISO 8601 week date `[week, week_year]` for a day given by its calendar year,
/// day of year (`1..=366`), and day of week (`1` Monday … `7` Sunday).
fn iso_week_date(year: i64, day_of_year: i64, day_of_week: i64) -> [i64, i64] {
    let week = (day_of_year - day_of_week + 10) / 7;
    if week < 1 {
        return [iso_weeks_in_year(year - 1), year - 1];
    }
    if week > iso_weeks_in_year(year) {
        return [1, year + 1];
    }
    return [week, year];
}

/// Number of ISO 8601 weeks in `year`: 53 when the year ends on a Thursday, or
/// the year before it ended on a Wednesday; else 52.
fn iso_weeks_in_year(year: i64) -> i64 {
    if year_end_weekday(year) == 4 || year_end_weekday(year - 1) == 3 {
        return 53;
    }
    return 52;
}

/// Weekday of 31 December of `year`, `0` (Sunday) … `6` (Saturday), by the
/// closed form the ISO week count is built on.
fn year_end_weekday(year: i64) -> i64 {
    return floor_mod(year + year / 4 - year / 100 + year / 400, 7);
}

/// Whether `year` is a leap year in the proleptic Gregorian (ISO 8601) calendar.
fn is_leap_year(year: i64) -> bool {
    return year % 4 == 0 && year % 100 != 0 || year % 400 == 0;
}

/// Number of days in `month` (`1..=12`) of `year`.
fn days_in_month_value(year: i64, month: i64) -> i64 {
    if month == 2 {
        if is_leap_year(year) {
            return 29;
        }
        return 28;
    }
    if month == 4 || month == 6 || month == 9 || month == 11 {
        return 30;
    }
    return 31;
}

/// Days since 1970-01-01 for a proleptic Gregorian date. Howard Hinnant's
/// `days_from_civil`, the inverse of `civil_from_days`.
fn days_from_civil(year: i64, month: i64, day: i64) -> i64 {
    let y = if month <= 2 { year - 1 } else { year };
    let era = if y >= 0 { y } else { y - 399 } / 400;
    let yoe = y - era * 400;
    let mp = if month > 2 { month - 3 } else { month + 9 };
    let doy = (153 * mp + 2) / 5 + day - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return era * 146097 + doe - 719468;
}

/// Parse an RFC 3339 / ISO 8601 timestamp in `text[start..<end]`. The shared
/// engine behind `ZonedDateTime::parse_rfc3339`, `Instant::parse_rfc3339`, and
/// both `FromStr` impls.
fn parse_iso_zoned(text: &String, start: i32, end: i32) -> Result<ZonedDateTime, DeserializeError> {
    let mut i = start;

    let [year, year_end] = parse_iso_year(text, i, end)?;
    i = year_end;

    i = expect_byte(text, i, end, b'-')?;
    let month = read_digits(text, i, end, 2)?;
    if month < 1 || month > 12 {
        return Result::Err(DeserializeError::invalid_value("month out of range", i as i64));
    }
    i += 2;
    i = expect_byte(text, i, end, b'-')?;
    let day = read_digits(text, i, end, 2)?;
    if day < 1 || day > days_in_month_value(year, month) {
        return Result::Err(DeserializeError::invalid_value("day out of range", i as i64));
    }
    i += 2;

    // Date/time separator: 'T', 't', or a space.
    if i >= end {
        return Result::Err(DeserializeError::eof(i as i64));
    }
    let sep = text.get_byte_unchecked(i);
    if sep != b'T' && sep != b't' && sep != b' ' {
        return Result::Err(DeserializeError::malformed("expected a date/time separator", i as i64));
    }
    i += 1;

    let hour = read_digits(text, i, end, 2)?;
    if hour > 23 {
        return Result::Err(DeserializeError::invalid_value("hour out of range", i as i64));
    }
    i += 2;
    i = expect_byte(text, i, end, b':')?;
    let minute = read_digits(text, i, end, 2)?;
    if minute > 59 {
        return Result::Err(DeserializeError::invalid_value("minute out of range", i as i64));
    }
    i += 2;
    i = expect_byte(text, i, end, b':')?;
    let parsed_second = read_digits(text, i, end, 2)?;
    if parsed_second > 60 {
        return Result::Err(DeserializeError::invalid_value("second out of range", i as i64));
    }
    // RFC 3339 admits a leap second; the ISO caenddar has no 61st second to
    // hold it, so Temporal constrains :60 to :59 rather than rejecting it.
    let second = if parsed_second == 60 { 59 } else { parsed_second };
    i += 2;

    // Optional fractional seconds, truncated to nanosecond precision.
    let mut nanoseconds: i64 = 0;
    if i < end && text.get_byte_unchecked(i) == b'.' {
        i += 1;
        let frac_start = i;
        let mut scale: i64 = 100_000_000;
        while i < end && is_ascii_digit(text.get_byte_unchecked(i)) {
            if scale >= 1 {
                nanoseconds = nanoseconds + (text.get_byte_unchecked(i) - b'0') as i64 * scale;
                scale = scale / 10;
            }
            i += 1;
        }
        if i == frac_start {
            return Result::Err(DeserializeError::malformed(
                "expected fractional digits after '.'",
                frac_start as i64,
            ));
        }
    }

    // Mandatory zone designator: 'Z'/'z' or ±hh:mm.
    let offset = parse_zone_designator(text, i, end)?;

    let days = days_from_civil(year, month, day);
    let local_seconds = days * 86400 + hour * 3600 + minute * 60 + second;
    return Result::Ok(ZonedDateTime {
        instant: Instant { seconds: local_seconds - offset, nanoseconds: nanoseconds as u32 },
        time_zone: format_offset_suffix(offset),
    });
}

/// Require byte `byte` at index `i` of `text[..<end]`, returning the next index,
/// or a `DeserializeError` on mismatch or end of input.
fn expect_byte(text: &String, i: i32, end: i32, byte: u8) -> Result<i32, DeserializeError> {
    if i >= end || text.get_byte_unchecked(i) != byte {
        return Result::Err(DeserializeError::malformed(`expected '${byte as char}'`, i as i64));
    }
    return Result::Ok(i + 1);
}

/// Read exactly `count` ASCII digits at index `i` of `text[..<end]` as an integer,
/// erroring if any of them is missing or non-numeric.
fn read_digits(text: &String, i: i32, end: i32, count: i32) -> Result<i64, DeserializeError> {
    if i + count > end {
        return Result::Err(DeserializeError::malformed(`expected ${count} digits`, i as i64));
    }
    let mut value: i64 = 0;
    let mut k = 0;
    while k < count {
        let byte = text.get_byte_unchecked(i + k);
        if !is_ascii_digit(byte) {
            return Result::Err(DeserializeError::malformed(`expected ${count} digits`, i as i64));
        }
        value = value * 10 + (byte - b'0') as i64;
        k += 1;
    }
    return Result::Ok(value);
}

/// Parse the ISO 8601 year at index `i` — exactly four digits, or a sign
/// followed by exactly six (the expanded form) — returning the year and the
/// index just past it. `-000000` is the one expanded year ISO 8601 forbids.
fn parse_iso_year(text: &String, i: i32, end: i32) -> Result<[i64, i32], DeserializeError> {
    if i >= end {
        return Result::Err(DeserializeError::eof(i as i64));
    }
    let sign = text.get_byte_unchecked(i);
    if sign != b'+' && sign != b'-' {
        return Result::Ok([read_digits(text, i, end, 4)?, i + 4]);
    }
    let magnitude = read_digits(text, i + 1, end, 6)?;
    if sign == b'-' {
        if magnitude == 0 {
            return Result::Err(DeserializeError::invalid_value("year -000000 is not an ISO 8601 year", i as i64));
        }
        return Result::Ok([-magnitude, i + 7]);
    }
    return Result::Ok([magnitude, i + 7]);
}

/// Parse the mandatory RFC 3339 zone designator in `text[start..<end]` into a
/// signed second offset: `"Z"`/`"z"` yields 0, `±hh:mm` its offset. Errors on an
/// absent, malformed, or out-of-range offset.
fn parse_zone_designator(text: &String, start: i32, end: i32) -> Result<i64, DeserializeError> {
    let span = end - start;
    if span == 1 {
        let c = text.get_byte_unchecked(start);
        if c == b'Z' || c == b'z' {
            return Result::Ok(0);
        }
        return Result::Err(DeserializeError::malformed("expected 'Z' or a ±hh:mm offset", start as i64));
    }
    let well_formed = span == 6
        && (text.get_byte_unchecked(start) == b'+' || text.get_byte_unchecked(start) == b'-')
        && is_ascii_digit(text.get_byte_unchecked(start + 1))
        && is_ascii_digit(text.get_byte_unchecked(start + 2))
        && text.get_byte_unchecked(start + 3) == b':'
        && is_ascii_digit(text.get_byte_unchecked(start + 4))
        && is_ascii_digit(text.get_byte_unchecked(start + 5));
    if !well_formed {
        return Result::Err(DeserializeError::malformed("expected 'Z' or a ±hh:mm offset", start as i64));
    }
    let hours = (text.get_byte_unchecked(start + 1) - b'0') as i64 * 10 + (text.get_byte_unchecked(start + 2) - b'0') as i64;
    let minutes = (text.get_byte_unchecked(start + 4) - b'0') as i64 * 10 + (text.get_byte_unchecked(start + 5) - b'0') as i64;
    if hours > 23 || minutes > 59 {
        return Result::Err(DeserializeError::invalid_value("time-zone offset out of range", start as i64));
    }
    let magnitude = hours * 3600 + minutes * 60;
    if text.get_byte_unchecked(start) == b'-' {
        return Result::Ok(-magnitude);
    }
    return Result::Ok(magnitude);
}

/// Least sub-second precision (0, 3, 6, or 9 fraction digits) that renders
/// `nanoseconds` without loss.
fn fraction_digits_for(nanoseconds: u32) -> i32 {
    if nanoseconds == 0 {
        return 0;
    }
    if nanoseconds % 1_000_000 == 0 {
        return 3;
    }
    if nanoseconds % 1000 == 0 {
        return 6;
    }
    return 9;
}

// serde — `Instant` and `ZonedDateTime` serialize as an RFC 3339 string under
// the CBOR standard date/time tag 0 (RFC 8949 §3.4.1); JSON ignores the tag and
// emits the bare string. Deserialization accepts either an RFC 3339 string
// (tag 0 / JSON string) or an epoch-seconds number (tag 1 / JSON number), so a
// numeric epoch timestamp from any encoder is read as UTC.

impl Serialize for Instant {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        s.serialize_tag(0)?;
        let text = self.to_rfc3339();
        return s.serialize_string(&text);
    }
}

/// Accepts an RFC 3339 text string or an epoch-seconds number.
struct InstantVisitor {
}

impl Visitor for InstantVisitor {
    type Value = Instant;

    fn visit_string(&mut self, v: String) -> Result<Instant, DeserializeError> {
        let zdt = ZonedDateTime::parse_rfc3339(v)?;
        return Result::Ok(zdt.instant);
    }

    fn visit_i64(&mut self, v: i64) -> Result<Instant, DeserializeError> {
        return Result::Ok(Instant::from_epoch_seconds(v));
    }

    fn visit_u64(&mut self, v: u64) -> Result<Instant, DeserializeError> {
        return Result::Ok(Instant::from_epoch_seconds(v as i64));
    }

    fn visit_i128(&mut self, _v: i128) -> Result<Instant, DeserializeError> {
        return Result::Err(DeserializeError::overflow("epoch seconds out of range", -1));
    }

    fn visit_u128(&mut self, _v: u128) -> Result<Instant, DeserializeError> {
        return Result::Err(DeserializeError::overflow("epoch seconds out of range", -1));
    }

    fn visit_f64(&mut self, v: f64) -> Result<Instant, DeserializeError> {
        let whole = v as i64;
        let nanos = ((v - whole as f64) * 1_000_000_000.0) as i64;
        return Result::Ok(Instant::new(whole, nanos));
    }

    fn visit_null(&mut self) -> Result<Instant, DeserializeError> {
        return Result::Err(DeserializeError::unexpected_type("expected datetime string or epoch number", -1));
    }

    fn visit_bool(&mut self, _v: bool) -> Result<Instant, DeserializeError> {
        return Result::Err(DeserializeError::unexpected_type("expected datetime string or epoch number", -1));
    }

    fn visit_seq<A: DeserializeSeq>(&mut self, _seq: &mut A) -> Result<Instant, DeserializeError> {
        return Result::Err(DeserializeError::unexpected_type("expected datetime, found sequence", -1));
    }

    fn visit_map<A: DeserializeMap>(&mut self, _map: &mut A) -> Result<Instant, DeserializeError> {
        return Result::Err(DeserializeError::unexpected_type("expected datetime, found map", -1));
    }
}

impl Deserialize for Instant {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<Instant, DeserializeError> {
        let mut v = InstantVisitor {};
        return d.deserialize_any::<InstantVisitor>(&mut v);
    }
}

impl Serialize for ZonedDateTime {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        s.serialize_tag(0)?;
        let text = self.to_rfc3339();
        return s.serialize_string(&text);
    }
}

/// Accepts an RFC 3339 text string (offset preserved) or an epoch-seconds
/// number (interpreted as UTC).
struct ZonedDateTimeVisitor {
}

impl Visitor for ZonedDateTimeVisitor {
    type Value = ZonedDateTime;

    fn visit_string(&mut self, v: String) -> Result<ZonedDateTime, DeserializeError> {
        return ZonedDateTime::parse_rfc3339(v);
    }

    fn visit_i64(&mut self, v: i64) -> Result<ZonedDateTime, DeserializeError> {
        return Result::Ok(ZonedDateTime { instant: Instant::from_epoch_seconds(v), time_zone: "UTC" });
    }

    fn visit_u64(&mut self, v: u64) -> Result<ZonedDateTime, DeserializeError> {
        return Result::Ok(ZonedDateTime { instant: Instant::from_epoch_seconds(v as i64), time_zone: "UTC" });
    }

    fn visit_i128(&mut self, _v: i128) -> Result<ZonedDateTime, DeserializeError> {
        return Result::Err(DeserializeError::overflow("epoch seconds out of range", -1));
    }

    fn visit_u128(&mut self, _v: u128) -> Result<ZonedDateTime, DeserializeError> {
        return Result::Err(DeserializeError::overflow("epoch seconds out of range", -1));
    }

    fn visit_f64(&mut self, v: f64) -> Result<ZonedDateTime, DeserializeError> {
        let whole = v as i64;
        let nanos = ((v - whole as f64) * 1_000_000_000.0) as i64;
        return Result::Ok(ZonedDateTime { instant: Instant::new(whole, nanos), time_zone: "UTC" });
    }

    fn visit_null(&mut self) -> Result<ZonedDateTime, DeserializeError> {
        return Result::Err(DeserializeError::unexpected_type("expected datetime string or epoch number", -1));
    }

    fn visit_bool(&mut self, _v: bool) -> Result<ZonedDateTime, DeserializeError> {
        return Result::Err(DeserializeError::unexpected_type("expected datetime string or epoch number", -1));
    }

    fn visit_seq<A: DeserializeSeq>(&mut self, _seq: &mut A) -> Result<ZonedDateTime, DeserializeError> {
        return Result::Err(DeserializeError::unexpected_type("expected datetime, found sequence", -1));
    }

    fn visit_map<A: DeserializeMap>(&mut self, _map: &mut A) -> Result<ZonedDateTime, DeserializeError> {
        return Result::Err(DeserializeError::unexpected_type("expected datetime, found map", -1));
    }
}

impl Deserialize for ZonedDateTime {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<ZonedDateTime, DeserializeError> {
        let mut v = ZonedDateTimeVisitor {};
        return d.deserialize_any::<ZonedDateTimeVisitor>(&mut v);
    }
}

// `wasi:clocks` bridge — `Instant` and the clock's `instant` record share a
// field layout, so the conversion is a field-for-field copy. Both `From` impls
// live here because `Instant` (this module's type) is the local type that lets
// each direction satisfy the orphan rule.

impl From<ClockInstant> for Instant {
    fn from(value: ClockInstant) -> Instant {
        return Instant { seconds: value.seconds, nanoseconds: value.nanoseconds };
    }
}

impl From<Instant> for ClockInstant {
    fn from(value: Instant) -> ClockInstant {
        return ClockInstant { seconds: value.seconds, nanoseconds: value.nanoseconds };
    }
}
