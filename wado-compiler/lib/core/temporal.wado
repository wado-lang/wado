#![stdlib("core:temporal")]
//! Date and time, a faithful implementation of TC39 Temporal under the ISO 8601
//! calendar.
//!
//! Two types carry an instant — `Instant`, an exact point on the timeline, and
//! `ZonedDateTime`, that instant paired with the zone it is read in. Five are
//! zoneless readings the way a birthday or a recurring wall-clock time is:
//! `PlainDate`, `PlainTime`, `PlainDateTime`, `PlainYearMonth`, and
//! `PlainMonthDay`. `Duration` is a signed span, and `Unit` and `RoundingMode`
//! parameterize the difference and rounding operations.
//!
//! Every type parses Temporal's RFC 9557 / ISO 8601 grammar and renders
//! Temporal's `toString`, and that string is its serde wire form. `Instant` also
//! reads and writes the RFC 7231 IMF-fixdate an HTTP `Date` header carries.
//! `Instant::now` takes the system clock through the effect row, so a program
//! that never asks the time gains no WASI import.
//!
//! Where this module departs from the specification, it does so deliberately:
//!
//! - Temporal's BigInt epoch nanoseconds are an `i64` second count and a `u32`
//!   sub-second part, and `epoch_nanoseconds` answers an `i128`. A duration
//!   component is an exact `i64` rather than a float64; a result that does not
//!   fit one (a nanosecond count of more than ~292 years) traps.
//! - A RangeError traps, except in a parser, which returns a
//!   `DeserializeError`. A struct literal bypasses every constructor check, so
//!   every operation checks its receiver and arguments first.
//! - An option bag is a parameter list with defaults, and the options absent
//!   from it are gaps: `relativeTo`, the rounding options of `until` and
//!   `since`, `with`, `equals` and `compare` beyond the derived `Eq` and `Ord`,
//!   and the `overflow`, `disambiguation`, and `offset` options.
//! - No time zone database is bundled, so `"UTC"` is the only available named
//!   zone; fixed `±HH:MM` offset zones are all available. See
//!   `docs/wep-2026-06-05-core-temporal.md`.
//!
//! Relationship to `wasi:clocks`: `wasi:clocks` exposes its own `Instant`
//! record (`{ seconds, nanoseconds }`) for the system clock. That type is a
//! Component Model binding — pinned to a specific WASI version and regenerated
//! by `wado-from-idl` — whereas `core:temporal`'s `Instant` is a plain,
//! version-independent Wado type that grows methods. They share a name and
//! field layout deliberately: it is "the same concept, a different type", and
//! `From` impls both ways bridge them with a field-for-field copy.
//!
//! Every type here is ISO 8601 only and so stores no calendar.

use {
    Serialize,
    Serializer,
    SerializeError,
    Deserialize,
    Deserializer,
    DeserializeError,
    Visitor,
    DeserializeSeq,
    DeserializeMap,
} from "core:serde";
use { SystemClock, Instant as ClockInstant } from "wasi:clocks";

#[synopsis]
test {
    let epoch = Instant::from_epoch_seconds(0);
    assert `${epoch}` == "1970-01-01T00:00:00Z";
    assert epoch < Instant::from_epoch_seconds(1_000_000_000);

    let zoned = ZonedDateTime::from_str("2023-11-14T22:13:20+09:00[+09:00]").unwrap();
    assert zoned.hour() == 22;
    assert `${zoned}` == "2023-11-14T22:13:20+09:00[+09:00]";

    // A duration reads as written, and a calendar unit needs a calendar to
    // resolve it: 01-31 plus a month is 02-28, not 03-03.
    let month = Duration { months: 1 };
    assert `${month}` == "P1M";
    assert PlainDate::new(2023, 1, 31).add(&month) == PlainDate::new(2023, 2, 28);

    // The zoneless types are the shapes a date or a clock reading really has.
    assert PlainDate::new(2024, 2, 29).in_leap_year();
    assert `${PlainTime { hour: 9, minute: 30 }}` == "09:30:00";

    // Every type reads its own spelling back through `FromStr`.
    assert PlainDate::from_str("2024-02-29") matches { Ok(d) && d.in_leap_year() };
    assert PlainYearMonth::from_str("2024-13") matches { Err(_) };

    assert Instant::EPOCH.to_http_date() == "Thu, 01 Jan 1970 00:00:00 GMT";
}

global NANOSECONDS_PER_SECOND: i64 = 1_000_000_000;
global SECONDS_PER_DAY: i64 = 86_400;
global NANOSECONDS_PER_DAY: i64 = 86_400_000_000_000;
/// 10^8 days, the reach of an instant either side of the epoch.
global MAX_EPOCH_DAYS: i64 = 100_000_000;
global MAX_EPOCH_SECONDS: i64 = 8_640_000_000_000;
/// 2^53 seconds, which no time duration reaches.
global TIME_DURATION_SECONDS_LIMIT: i64 = 9_007_199_254_740_992;
/// 2^32, which no year, month, or week count of a duration reaches.
global CALENDAR_UNIT_LIMIT: i64 = 4_294_967_296;
global MAX_ROUNDING_INCREMENT: i64 = 1_000_000_000;

/// An exact point on the timeline, as the offset from the Unix epoch
/// (1970-01-01T00:00:00Z). Time-zone- and calendar-independent.
///
/// Corresponds to `Temporal.Instant` and the `wasi:clocks` `instant` record.
/// Where Temporal stores `epochNanoseconds` as a BigInt, this uses an `i64`
/// second count plus a `u32` sub-second part — the exact shape of
/// `wasi:clocks` `instant`. Temporal's range applies: 10^8 days either side of
/// the epoch, -271821-04-20T00:00:00Z through +275760-09-13T00:00:00Z.
///
/// `Ord` is auto-derived and orders chronologically: `seconds` is compared
/// first, then `nanoseconds`.
pub struct Instant {
    /// Whole seconds since the Unix epoch. Negative values are before it.
    pub seconds: i64,
    /// Sub-second component, always in `0..<1_000_000_000`. Incrementing
    /// `nanoseconds` always moves forward in time, even when `seconds < 0`
    /// (e.g. one nanosecond before the epoch is
    /// `Instant { seconds: -1, nanoseconds: 999_999_999 }`). Use `Instant::new`
    /// to normalize an arbitrary count into this range.
    pub nanoseconds: u32,
}

impl Eq for Instant;
impl Ord for Instant;

/// An exact instant together with the time zone it is interpreted in.
///
/// Corresponds to `Temporal.ZonedDateTime` — the only "complete" temporal
/// value (an instant plus a wall-clock interpretation). The calendar is always
/// ISO 8601 and therefore not stored. The broken-down wall-clock fields (year,
/// month, day, hour, …) are a function of `instant` + `time_zone`, computed on
/// demand by accessors rather than stored state.
///
/// `Ord` is auto-derived and orders by `instant` first, then `time_zone`
/// lexically, so it stays consistent with the derived `Eq`, which is Temporal's
/// `equals`. Temporal's `compare` weighs only the instant, so for "the same
/// moment, wherever it is read" compare `to_instant()` rather than the values.
pub struct ZonedDateTime {
    /// The exact instant.
    pub instant: Instant,
    /// The time zone identifier, as Temporal canonicalizes it: `"UTC"` or a
    /// fixed offset such as `"+09:00"`. An IANA name such as
    /// `"America/New_York"` is storable in a literal, but every operation traps
    /// on it until a time zone database is bundled.
    pub time_zone: String,
}

impl Eq for ZonedDateTime;
impl Ord for ZonedDateTime;

// Display — Temporal's `toString`.
//
// The format specifier's precision is Temporal's `fractionalSecondDigits`: it
// fixes how many sub-second digits to print, truncating. With no precision,
// the fraction is printed as far as its last non-zero digit. `Inspect`
// (`${x:?}`) is left as the auto-derived structural form.

impl Display for Instant {
    fn fmt(&self, f: &mut Formatter) {
        f.pad(format_instant(self.checked(), resolve_precision(f)));
    }
}

impl Display for ZonedDateTime {
    fn fmt(&self, f: &mut Formatter) {
        f.pad(self.format(resolve_precision(f), true));
    }
}

/// The formatter's precision as a sub-second digit count in `0..=9`, or `-1`
/// for Temporal's `auto`. A count above nine is a RangeError.
fn resolve_precision(f: &Formatter) -> i32 {
    let p = f.precision;
    if p == Formatter::PRECISION_DEFAULT || p == Formatter::PRECISION_INFINITE {
        return -1;
    }
    if p > 9 {
        panic(`core:temporal: ${p} fractional second digits is more than the nine a nanosecond needs`);
    }
    return p;
}

/// Temporal's `TemporalInstantToString` with no time zone: the UTC reading and
/// a `Z`.
fn format_instant(instant: Instant, precision: i32) -> String {
    let [days, time_of_day] = instant.epoch_day_parts();
    return `${format_date_time(days, time_of_day, precision)}Z`;
}

impl Instant {
    /// The Unix epoch itself, 1970-01-01T00:00:00Z.
    pub const EPOCH: Instant = Instant { seconds: 0, nanoseconds: 0 };

    /// Construct an instant `nanoseconds` after `seconds` since the Unix epoch,
    /// normalizing so the stored sub-second part lands in `0..<1_000_000_000`
    /// even when `nanoseconds` is negative or `>= 1_000_000_000`. Traps outside
    /// Temporal's range.
    pub fn new(seconds: i64, nanoseconds: i64) -> Instant {
        return checked_instant(seconds, nanoseconds);
    }

    /// Construct an instant from whole seconds since the Unix epoch (CBOR tag 1
    /// integer form).
    pub fn from_epoch_seconds(seconds: i64) -> Instant {
        return checked_instant(seconds, 0);
    }

    /// Construct an instant from milliseconds since the Unix epoch
    /// (`Temporal.Instant.fromEpochMilliseconds`).
    pub fn from_epoch_milliseconds(milliseconds: i64) -> Instant {
        return checked_instant(floor_div(milliseconds, 1000), floor_mod(milliseconds, 1000) * 1_000_000);
    }

    /// Construct an instant from microseconds since the Unix epoch. The inverse
    /// of `epoch_microseconds`.
    pub fn from_epoch_microseconds(microseconds: i64) -> Instant {
        return checked_instant(floor_div(microseconds, 1_000_000), floor_mod(microseconds, 1_000_000) * 1000);
    }

    /// Construct an instant from nanoseconds since the Unix epoch
    /// (`Temporal.Instant.fromEpochNanoseconds`).
    pub fn from_epoch_nanoseconds(nanoseconds: i128) -> Instant {
        let whole_seconds = floor_div_i128(nanoseconds, 1_000_000_000);
        let limit = MAX_EPOCH_SECONDS as i128;
        if whole_seconds < -limit || whole_seconds > limit {
            panic("core:temporal: the instant is outside the range of 10^8 days either side of the epoch");
        }
        return checked_instant(whole_seconds as i64, (nanoseconds - whole_seconds * 1_000_000_000) as i64);
    }

    /// Construct an instant from fractional seconds since the Unix epoch (CBOR
    /// tag 1 floating-point form). The fraction is rounded to the nearest
    /// nanosecond; `f64` precision limits sub-microsecond accuracy near the
    /// present. Traps on a value that is not finite or is outside the range.
    pub fn from_unix_seconds(seconds: f64) -> Instant {
        if let Some(instant) = try_instant_from_unix_seconds(seconds) {
            return instant;
        }
        panic(`core:temporal: ${seconds} epoch seconds names no instant within the range`);
    }

    /// The current reading of the system clock (`Temporal.Now.instant`),
    /// clamped to the range as `HostSystemUTCEpochNanoseconds` requires. The
    /// effect row is what keeps the clock off callers that never ask the time.
    pub fn now() -> Instant with SystemClock {
        let reading = SystemClock::now();
        let limit = MAX_EPOCH_SECONDS as i128 * 1_000_000_000;
        let nanoseconds = reading.seconds as i128 * 1_000_000_000 + reading.nanoseconds as i128;
        return Instant::from_epoch_nanoseconds(i128::clamp(nanoseconds, -limit, limit));
    }

    /// Milliseconds since the Unix epoch (`Temporal.Instant.epochMilliseconds`),
    /// floored.
    pub fn epoch_milliseconds(&self) -> i64 {
        let t = self.checked();
        return t.seconds * 1000 + t.nanoseconds as i64 / 1_000_000;
    }

    /// Microseconds since the Unix epoch, floored.
    pub fn epoch_microseconds(&self) -> i64 {
        let t = self.checked();
        return t.seconds * 1_000_000 + (t.nanoseconds / 1000) as i64;
    }

    /// Nanoseconds since the Unix epoch (`Temporal.Instant.epochNanoseconds`).
    /// Temporal uses a BigInt; an `i128` holds the whole range exactly.
    pub fn epoch_nanoseconds(&self) -> i128 {
        let t = self.checked();
        return t.seconds as i128 * 1_000_000_000 + t.nanoseconds as i128;
    }

    /// Move forward by `duration`. Only the time components are admitted: a day
    /// and above has no fixed length without a calendar, so Temporal measures
    /// those against a `ZonedDateTime` instead.
    pub fn add(&self, duration: &Duration) -> Instant {
        let start = self.checked();
        let d = duration.validated();
        if is_date_unit(d.default_largest_unit()) {
            panic(
                "core:temporal: Instant arithmetic admits hours and below; days and above need the calendar a ZonedDateTime carries",
            );
        }
        return add_instant(start, d.time_with_days());
    }

    /// Move back by `duration`, under the same restriction as `add`.
    pub fn subtract(&self, duration: &Duration) -> Instant {
        return self.add(&duration.negated());
    }

    /// The span from this instant to `other`, positive when `other` is later.
    /// `largest_unit` must be a time unit; Temporal's default is the second.
    pub fn until(&self, other: &Instant, largest_unit: Unit = Unit::Second) -> Duration {
        let start = self.checked();
        let end = other.checked();
        if is_date_unit(largest_unit) {
            panic(
                "core:temporal: Instant differences are measured in hours and below; use ZonedDateTime::until for a calendar unit",
            );
        }
        return duration_from_internal(&Duration {}, instant_difference(start, end), largest_unit);
    }

    /// The span from `other` to this instant — `until` with the sign flipped.
    pub fn since(&self, other: &Instant, largest_unit: Unit = Unit::Second) -> Duration {
        return self.until(other, largest_unit).negated();
    }

    /// Round to a multiple of `increment` units counted from the epoch, as if
    /// the count were positive: `Trunc` rounds toward the past like `Floor`.
    /// `smallest_unit` must be a time unit, and the step must divide the day.
    pub fn round(
        &self,
        smallest_unit: Unit,
        increment: i64 = 1,
        mode: RoundingMode = RoundingMode::HalfExpand,
    ) -> Instant {
        let t = self.checked();
        if is_date_unit(smallest_unit) {
            panic("core:temporal: an Instant rounds to hours and below; use ZonedDateTime::round for a day");
        }
        let unit_length = unit_nanoseconds(smallest_unit);
        validate_rounding_increment(increment, NANOSECONDS_PER_DAY / unit_length, true);
        return round_instant(t, increment * unit_length, mode);
    }

    /// Temporal's `toString` (and `toJSON`): the UTC reading with a `Z`, its
    /// fraction printed as far as the last non-zero digit. This is the serde
    /// wire form, and an RFC 3339 timestamp.
    pub fn to_iso8601(&self) -> String {
        return format_instant(self.checked(), -1);
    }

    /// RFC 7231 IMF-fixdate, the form an HTTP `Date`, `Expires`, or
    /// `Last-Modified` header carries: `"Sun, 06 Nov 1994 08:49:37 GMT"`.
    /// Always UTC, always whole seconds; traps outside the years `0..=9999`.
    pub fn to_http_date(&self) -> String {
        let [days, time_of_day] = self.checked().epoch_day_parts();
        let date = iso_date_from_epoch_days(days);
        if date.year < 0 || date.year > 9999 {
            panic(`core:temporal: an HTTP-date has a four-digit year, and ${date.year} is not one`);
        }
        let second_of_day = time_of_day / NANOSECONDS_PER_SECOND;
        let weekday = imf_weekday_name(day_of_week_of(days));
        let month = imf_month_name(date.month);
        return `${weekday}, ${date.day:02} ${month} ${date.year:04} ${second_of_day / 3600:02}:${second_of_day % 3600 / 60:02}:${second_of_day % 60:02} GMT`;
    }

    /// Parse an HTTP-date in any of the three forms RFC 7231 requires a
    /// recipient to accept: IMF-fixdate (`"Sun, 06 Nov 1994 08:49:37 GMT"`),
    /// the obsolete RFC 850 (`"Sunday, 06-Nov-94 08:49:37 GMT"`, whose
    /// two-digit year pivots at 70), and asctime (`"Sun Nov  6 08:49:37 1994"`).
    /// The weekday must be a weekday name, but is not checked against the date.
    pub fn parse_http_date<S: AsStrSlice>(text: S) -> Result<Instant, DeserializeError> {
        let view = text.as_str_slice();
        let comma = index_of_byte(&view, b',', 0);
        if comma < 0 {
            return parse_asctime(&view);
        }
        if comma + 4 < view.len() && view.get_byte_unchecked(comma + 4) == b'-' {
            return parse_rfc850_date(&view, comma);
        }
        return parse_imf_fixdate(&view, comma);
    }

    /// Interpret this instant in a time zone, the zoned view of the same moment
    /// (`Temporal.Instant.toZonedDateTimeISO`). The zone is a time zone
    /// identifier or an ISO string that carries one, as Temporal reads it.
    pub fn to_zoned_date_time<S: AsStrSlice>(&self, time_zone: S) -> ZonedDateTime {
        return ZonedDateTime {
            instant: self.checked(),
            time_zone: to_time_zone_identifier(time_zone),
        };
    }

    /// Trap unless the fields name an instant in Temporal's range, the check a
    /// struct literal skips.
    fn checked(&self) -> Instant {
        if !is_valid_instant(self.seconds, self.nanoseconds as i64) {
            panic(
                `core:temporal: Instant { seconds: ${self.seconds}, nanoseconds: ${self.nanoseconds} } is outside the range of 10^8 days either side of the epoch`,
            );
        }
        return *self;
    }

    /// Whole days since the epoch and the nanosecond of that UTC day.
    fn epoch_day_parts(&self) -> [i64, i64] {
        return day_parts(self.seconds, self.nanoseconds);
    }
}

/// `seconds` and a sub-second part split into whole days and the nanosecond of
/// the day.
fn day_parts(seconds: i64, nanoseconds: u32) -> [i64, i64] {
    return [
        floor_div(seconds, SECONDS_PER_DAY),
        floor_mod(seconds, SECONDS_PER_DAY) * NANOSECONDS_PER_SECOND + nanoseconds as i64,
    ];
}

/// Reads Temporal's `TemporalInstantString`: a date, a time, and `Z` or an
/// offset, then any annotations, which an instant sets aside.
impl FromStr for Instant {
    type Err = DeserializeError;

    fn from_str<S: AsStrSlice>(s: S) -> Result<Instant, DeserializeError> {
        let view = s.as_str_slice();
        let parsed = parse_instant_string(&view)?;
        let offset = if parsed.utc_designator { 0 } else { parsed.offset.unwrap() };
        let days = epoch_days_of(parsed.year, parsed.month, parsed.day);
        let seconds = days * SECONDS_PER_DAY + parsed.time_of_day / NANOSECONDS_PER_SECOND - offset / NANOSECONDS_PER_SECOND;
        let nanoseconds = parsed.time_of_day % NANOSECONDS_PER_SECOND - offset % NANOSECONDS_PER_SECOND;
        if let Some(instant) = try_instant(seconds, nanoseconds) {
            return Result::Ok(instant);
        }
        return Result::Err(out_of_range_instant());
    }
}

/// Whether the parts name an instant within 10^8 days of the epoch, with a
/// sub-second part below a second.
fn is_valid_instant(seconds: i64, nanoseconds: i64) -> bool {
    if nanoseconds < 0 || nanoseconds >= NANOSECONDS_PER_SECOND {
        return false;
    }
    if seconds < -MAX_EPOCH_SECONDS || seconds > MAX_EPOCH_SECONDS {
        return false;
    }
    return seconds < MAX_EPOCH_SECONDS || nanoseconds == 0;
}

/// The instant `nanoseconds` after `seconds`, normalized, or `None` outside the
/// range.
fn try_instant(seconds: i64, nanoseconds: i64) -> Option<Instant> {
    // Far enough out that no sub-second carry brings it back, and near enough
    // that adding one cannot overflow.
    if seconds < -2 * MAX_EPOCH_SECONDS || seconds > 2 * MAX_EPOCH_SECONDS {
        return null;
    }
    let whole = seconds + floor_div(nanoseconds, NANOSECONDS_PER_SECOND);
    let sub = floor_mod(nanoseconds, NANOSECONDS_PER_SECOND);
    if !is_valid_instant(whole, sub) {
        return null;
    }
    return Option::Some(Instant { seconds: whole, nanoseconds: sub as u32 });
}

/// `try_instant` for an operation, where leaving the range is a RangeError.
fn checked_instant(seconds: i64, nanoseconds: i64) -> Instant {
    if let Some(instant) = try_instant(seconds, nanoseconds) {
        return instant;
    }
    panic("core:temporal: the instant is outside the range of 10^8 days either side of the epoch");
}

/// The instant `seconds` after the epoch, rounded to the nearest nanosecond,
/// or `None` when it is not finite or not in the range.
fn try_instant_from_unix_seconds(seconds: f64) -> Option<Instant> {
    let bound = (2 * MAX_EPOCH_SECONDS) as f64;
    // Written so that a NaN fails it too.
    if !(seconds > -bound && seconds < bound) {
        return null;
    }
    let whole = f64::floor(seconds);
    let nanoseconds = f64::floor((seconds - whole) * 1000000000.0 + 0.5);
    return try_instant(whole as i64, nanoseconds as i64);
}

fn out_of_range_instant() -> DeserializeError {
    return DeserializeError::invalid_value("the instant is outside the range of 10^8 days either side of the epoch");
}

/// Temporal's `AddInstant`.
fn add_instant(instant: Instant, time: TimeDuration) -> Instant {
    return checked_instant(instant.seconds + time.seconds, instant.nanoseconds as i64 + time.nanoseconds);
}

/// Temporal's `TimeDurationFromEpochNanosecondsDifference`: `end` less `start`.
fn instant_difference(start: Instant, end: Instant) -> TimeDuration {
    return time_duration(end.seconds - start.seconds, end.nanoseconds as i64 - start.nanoseconds as i64);
}

/// Temporal's `RoundTemporalInstant`, where `step` nanoseconds divides the day:
/// the multiples counted from the epoch then line up with each UTC midnight,
/// so the day is set aside and only the time of day is rounded.
fn round_instant(instant: Instant, step: i64, mode: RoundingMode) -> Instant {
    let [days, time_of_day] = instant.epoch_day_parts();
    let quotient = time_of_day / step;
    let rest = time_of_day % step;
    if rest == 0 {
        return instant;
    }
    // The parity a half-even tie looks at is that of the multiple counted from
    // the epoch, so it takes in the steps of every whole day before this one.
    let lower_is_odd = (floor_mod(days, 2) * (NANOSECONDS_PER_DAY / step % 2) + quotient) % 2 == 1;
    let up = rounds_away(unsigned_rounding_mode(mode, false), compare_i64(rest, step - rest), lower_is_odd);
    let rounded = if up { quotient + 1 } else { quotient };
    return local_instant(days, rounded * step, 0);
}

impl ZonedDateTime {
    /// Interpret `instant` in `time_zone` (`new Temporal.ZonedDateTime`). The
    /// zone must be a time zone identifier, which this canonicalizes: `"utc"`
    /// becomes `"UTC"`, `"-00:00"` becomes `"+00:00"`, and `"+0930"` becomes
    /// `"+09:30"`. `"Z"` is a designator rather than a zone, and a named zone
    /// other than UTC needs a time zone database; both trap.
    pub fn new<S: AsStrSlice>(instant: Instant, time_zone: S) -> ZonedDateTime {
        let view = time_zone.as_str_slice();
        let zone = match time_zone_identifier(&view) {
            Ok(zone) => zone,
            Err(e) => panic(`core:temporal: "${view}" is not an available time zone identifier: ${e.message}`),
        };
        return ZonedDateTime { instant: instant.checked(), time_zone: zone };
    }

    /// The current time read in `time_zone` (`Temporal.Now.zonedDateTimeISO`),
    /// which is read as `Instant::to_zoned_date_time` reads it. The zone is the
    /// caller's: there is no system-zone lookup until the `wasi:clocks`
    /// `timezone` interface is wired up.
    pub fn now<S: AsStrSlice>(time_zone: S) -> ZonedDateTime with SystemClock {
        return Instant::now().to_zoned_date_time(time_zone);
    }

    /// Parse an RFC 3339 timestamp such as `"2023-11-14T22:13:20.5+09:00"`,
    /// keeping what it says about the zone: `Z` reads as `"UTC"`, and a numeric
    /// offset as that fixed-offset zone, so it round-trips through
    /// `to_rfc3339`. The grammar is that of an instant string without
    /// annotations, which are RFC 9557's; `FromStr` reads those. An offset with
    /// seconds names no zone and is an error.
    pub fn parse_rfc3339<S: AsStrSlice>(text: S) -> Result<ZonedDateTime, DeserializeError> {
        let view = text.as_str_slice();
        let mut parsed = ParsedIso {};
        let end = parse_date_time_prefix(&view, &mut parsed, true, true, true)?;
        if end != view.len() {
            return Result::Err(DeserializeError::malformed("trailing characters", end as i64));
        }
        if parsed.offset_has_seconds {
            return Result::Err(DeserializeError::invalid_value("an offset with seconds names no time zone"));
        }
        let offset_seconds = if parsed.utc_designator { 0 } else { parsed.offset.unwrap() / NANOSECONDS_PER_SECOND };
        let zone = if parsed.utc_designator { "UTC" } else { format_offset_identifier(offset_seconds / 60) };
        let days = epoch_days_of(parsed.year, parsed.month, parsed.day);
        let Some(instant) = epoch_from_local(days, parsed.time_of_day, offset_seconds) else {
            return Result::Err(out_of_range_instant());
        };
        return Result::Ok(ZonedDateTime { instant: instant, time_zone: zone });
    }

    /// The exact instant, dropping the zone (`Temporal.ZonedDateTime.toInstant`).
    pub fn to_instant(&self) -> Instant {
        return self.checked().instant;
    }

    /// Milliseconds since the Unix epoch, floored.
    pub fn epoch_milliseconds(&self) -> i64 {
        return self.to_instant().epoch_milliseconds();
    }

    /// Nanoseconds since the Unix epoch.
    pub fn epoch_nanoseconds(&self) -> i128 {
        return self.to_instant().epoch_nanoseconds();
    }

    /// The zone's UTC offset at this instant, as `±HH:MM`; `"+00:00"` for UTC.
    pub fn offset(&self) -> String {
        return format_offset_identifier(self.checked().offset_seconds() / 60);
    }

    /// The zone's UTC offset at this instant, in nanoseconds.
    pub fn offset_nanoseconds(&self) -> i64 {
        return self.checked().offset_seconds() * NANOSECONDS_PER_SECOND;
    }

    /// ISO year in the zone's local time. May be negative or beyond four digits.
    pub fn year(&self) -> i32 {
        return self.local_date().year as i32;
    }

    /// Month of the year, `1..=12`.
    pub fn month(&self) -> i32 {
        return self.local_date().month as i32;
    }

    /// Temporal month code, `"M01"` … `"M12"` under the ISO 8601 calendar.
    pub fn month_code(&self) -> String {
        return month_code_of(self.month());
    }

    /// Day of the month, `1..=31`.
    pub fn day(&self) -> i32 {
        return self.local_date().day as i32;
    }

    /// Hour of the day, `0..=23`.
    pub fn hour(&self) -> i32 {
        return self.to_plain_time().hour;
    }

    /// Minute of the hour, `0..=59`.
    pub fn minute(&self) -> i32 {
        return self.to_plain_time().minute;
    }

    /// Second of the minute, `0..=59`.
    pub fn second(&self) -> i32 {
        return self.to_plain_time().second;
    }

    /// Millisecond of the second, `0..=999`.
    pub fn millisecond(&self) -> i32 {
        return self.to_plain_time().millisecond;
    }

    /// Microsecond of the millisecond, `0..=999`.
    pub fn microsecond(&self) -> i32 {
        return self.to_plain_time().microsecond;
    }

    /// Nanosecond of the microsecond, `0..=999`.
    pub fn nanosecond(&self) -> i32 {
        return self.to_plain_time().nanosecond;
    }

    /// Day of the week, `1` (Monday) through `7` (Sunday), per ISO 8601.
    pub fn day_of_week(&self) -> i32 {
        return self.to_plain_date().day_of_week();
    }

    /// Day of the year, `1..=366`.
    pub fn day_of_year(&self) -> i32 {
        return self.to_plain_date().day_of_year();
    }

    /// ISO 8601 week of the week-year, `1..=53`.
    pub fn week_of_year(&self) -> i32 {
        return self.to_plain_date().week_of_year();
    }

    /// ISO 8601 week-numbering year, which differs from `year` in the days at
    /// either end of the year that belong to the neighbour's week.
    pub fn year_of_week(&self) -> i32 {
        return self.to_plain_date().year_of_week();
    }

    /// Number of days in this week — always `7` for ISO 8601.
    pub fn days_in_week(&self) -> i32 {
        return self.to_plain_date().days_in_week();
    }

    /// Number of days in this month, `28..=31`.
    pub fn days_in_month(&self) -> i32 {
        return self.to_plain_date().days_in_month();
    }

    /// Number of days in this year, `365` or `366`.
    pub fn days_in_year(&self) -> i32 {
        return self.to_plain_date().days_in_year();
    }

    /// Number of months in this year — always `12` for ISO 8601.
    pub fn months_in_year(&self) -> i32 {
        return self.to_plain_date().months_in_year();
    }

    /// Whether this year is a leap year in the ISO 8601 calendar.
    pub fn in_leap_year(&self) -> bool {
        return self.to_plain_date().in_leap_year();
    }

    /// Hours between this day's start and the next. A fixed offset has no DST,
    /// so it is always 24; traps where either start is outside the range.
    pub fn hours_in_day(&self) -> i32 {
        let [days, _] = self.local();
        let offset = self.offset_seconds();
        let today = local_instant(days, 0, offset);
        let tomorrow = local_instant(days + 1, 0, offset);
        return ((tomorrow.seconds - today.seconds) / 3600) as i32;
    }

    /// The first instant of this value's local day (`startOfDay`).
    pub fn start_of_day(&self) -> ZonedDateTime {
        let [days, _] = self.local();
        return self.with_instant(local_instant(days, 0, self.offset_seconds()));
    }

    /// Move forward by `duration` (Temporal's `AddZonedDateTime`): the date
    /// components in local calendar days, a month-end overflow constrained to
    /// the month's last day, then the time components in exact time.
    pub fn add(&self, duration: &Duration) -> ZonedDateTime {
        let z = self.checked();
        let d = duration.validated();
        let date = d.date_part();
        if date.raw_sign() == 0 {
            return z.with_instant(add_instant(z.instant, d.time_part()));
        }
        let [days, time_of_day] = z.local();
        let added = calendar_date_add(&iso_date_from_epoch_days(days), &date);
        require_date_time_within_limits(added, time_of_day);
        let intermediate = local_instant(added, time_of_day, z.offset_seconds());
        return z.with_instant(add_instant(intermediate, d.time_part()));
    }

    /// Move back by `duration`. Not the inverse of `add` when a month-end is
    /// constrained on the way out: 01-31 plus a month is 02-28, and minus a
    /// month again is 01-28.
    pub fn subtract(&self, duration: &Duration) -> ZonedDateTime {
        return self.add(&duration.negated());
    }

    /// The span from this value to `other`, positive when `other` is later. A
    /// time `largest_unit` divides the exact span; a date one walks the local
    /// calendar, which needs both values in one zone. Temporal's default is the
    /// hour.
    pub fn until(&self, other: &ZonedDateTime, largest_unit: Unit = Unit::Hour) -> Duration {
        let start = self.checked();
        let end = other.checked();
        if !is_date_unit(largest_unit) {
            return duration_from_internal(&Duration {}, instant_difference(start.instant, end.instant), largest_unit);
        }
        if start.time_zone != end.time_zone {
            panic(
                `core:temporal: a difference in ${largest_unit}s reads both values in one zone, and ${start.time_zone} is not ${end.time_zone}`,
            );
        }
        if start.instant == end.instant {
            return Duration {};
        }
        let [start_days, start_time] = start.local();
        let [end_days, end_time] = end.local();
        let [date, time] = difference_iso_date_time(start_days, start_time, end_days, end_time, largest_unit);
        return duration_from_internal(&date, time, Unit::Hour);
    }

    /// The span from `other` to this value — `until` with the sign flipped.
    pub fn since(&self, other: &ZonedDateTime, largest_unit: Unit = Unit::Hour) -> Duration {
        return self.until(other, largest_unit).negated();
    }

    /// Round the local wall clock to a multiple of `increment` units, measured
    /// within the next larger unit as Temporal's `RoundTime` does. `Unit::Day`
    /// rounds to the nearest start of day and takes no increment but `1`.
    pub fn round(
        &self,
        smallest_unit: Unit,
        increment: i64 = 1,
        mode: RoundingMode = RoundingMode::HalfExpand,
    ) -> ZonedDateTime {
        let z = self.checked();
        validate_time_or_day_rounding(smallest_unit, increment);
        if smallest_unit matches { Nanosecond } && increment == 1 {
            return z;
        }
        let offset = z.offset_seconds();
        let [days, time_of_day] = z.local();
        if smallest_unit matches { Day } {
            let start = local_instant(days, 0, offset);
            let end = local_instant(days + 1, 0, offset);
            let progress = instant_difference(start, z.instant);
            let length = instant_difference(start, end);
            return z.with_instant(add_instant(start, round_time_duration_seconds(progress, length.seconds, mode)));
        }
        let [carry, rounded] = round_time(time_of_day, increment, smallest_unit, mode);
        require_epoch_days_range(days + carry);
        return z.with_instant(local_instant(days + carry, rounded, offset));
    }

    /// The same instant read in another zone (`withTimeZone`), which is read as
    /// `Instant::to_zoned_date_time` reads it.
    pub fn with_time_zone<S: AsStrSlice>(&self, time_zone: S) -> ZonedDateTime {
        return self.to_instant().to_zoned_date_time(time_zone);
    }

    /// Temporal's `toString` (and `toJSON`): the local date and time, the
    /// offset, and the zone annotation, as in
    /// `"2023-11-15T07:13:20+09:00[+09:00]"`. This is the serde wire form.
    pub fn to_iso8601(&self) -> String {
        return self.format(-1, true);
    }

    /// RFC 3339: the local date and time and the offset, without the zone
    /// annotation RFC 9557 adds. `parse_rfc3339` reads it back.
    pub fn to_rfc3339(&self) -> String {
        return self.format(-1, false);
    }

    /// The local calendar date.
    pub fn to_plain_date(&self) -> PlainDate {
        return PlainDate::from_iso_date(self.local_date());
    }

    /// The local wall-clock time.
    pub fn to_plain_time(&self) -> PlainTime {
        let [_, time_of_day] = self.local();
        return PlainTime::from_nanoseconds_since_midnight(time_of_day);
    }

    /// The local date and time together, dropping the zone.
    pub fn to_plain_date_time(&self) -> PlainDateTime {
        let [days, time_of_day] = self.local();
        return PlainDateTime {
            date: PlainDate::from_iso_date(iso_date_from_epoch_days(days)),
            time: PlainTime::from_nanoseconds_since_midnight(time_of_day),
        };
    }

    /// Trap unless the instant is in range and the zone is an available,
    /// canonical identifier — the checks a struct literal skips.
    fn checked(&self) -> ZonedDateTime {
        let _ = self.instant.checked();
        let _ = zone_offset_seconds(&self.time_zone);
        return *self;
    }

    /// The zone's offset in seconds.
    fn offset_seconds(&self) -> i64 {
        return zone_offset_seconds(&self.time_zone);
    }

    /// The local reading as days since the epoch and the nanosecond of that
    /// day, checking the value on the way.
    fn local(&self) -> [i64, i64] {
        return day_parts(self.instant.checked().seconds + self.offset_seconds(), self.instant.nanoseconds);
    }

    fn local_date(&self) -> IsoDate {
        let [days, _] = self.local();
        return iso_date_from_epoch_days(days);
    }

    /// The same zone at a different instant.
    fn with_instant(&self, instant: Instant) -> ZonedDateTime {
        return ZonedDateTime { instant: instant, time_zone: self.time_zone };
    }

    /// The local date and time, the offset, and with `annotate` the zone.
    fn format(&self, precision: i32, annotate: bool) -> String {
        let [days, time_of_day] = self.local();
        let text = `${format_date_time(days, time_of_day, precision)}${format_offset_identifier(
            self.offset_seconds() / 60,
        )}`;
        if annotate {
            return `${text}[${self.time_zone}]`;
        }
        return text;
    }
}

/// Reads Temporal's `TemporalDateTimeString[+Zoned]`: a date, an optional time
/// and offset, and a required zone annotation. `Z` reads the date and time as
/// UTC; an offset must be the zone's; neither reads the wall clock in the zone,
/// and a date alone is the start of its day.
impl FromStr for ZonedDateTime {
    type Err = DeserializeError;

    fn from_str<S: AsStrSlice>(s: S) -> Result<ZonedDateTime, DeserializeError> {
        let view = s.as_str_slice();
        let parsed = parse_zoned_string(&view)?;
        require_iso_calendar(&parsed)?;
        let annotation = parsed.zone.unwrap();
        let zone = time_zone_identifier(&annotation.as_str_slice())?;
        let zone_offset = zone_offset_seconds(&zone);
        let days = epoch_days_of(parsed.year, parsed.month, parsed.day);
        let mut offset = zone_offset;
        if parsed.utc_designator {
            offset = 0;
        } else if let Some(given) = parsed.offset {
            if given != zone_offset * NANOSECONDS_PER_SECOND {
                return Result::Err(DeserializeError::invalid_value(`the offset does not match the time zone ${zone}`));
            }
            if !(-MAX_EPOCH_DAYS <= days <= MAX_EPOCH_DAYS) {
                return Result::Err(out_of_range_instant());
            }
        }
        let Some(instant) = epoch_from_local(days, parsed.time_of_day, offset) else {
            return Result::Err(out_of_range_instant());
        };
        return Result::Ok(ZonedDateTime { instant: instant, time_zone: zone });
    }
}

/// The instant a local reading names at a fixed offset, or `None` outside the
/// range.
fn epoch_from_local(days: i64, time_of_day: i64, offset_seconds: i64) -> Option<Instant> {
    return try_instant(
        days * SECONDS_PER_DAY + time_of_day / NANOSECONDS_PER_SECOND - offset_seconds,
        time_of_day % NANOSECONDS_PER_SECOND,
    );
}

/// `epoch_from_local` for an operation, where leaving the range is a
/// RangeError.
fn local_instant(days: i64, time_of_day: i64, offset_seconds: i64) -> Instant {
    if let Some(instant) = epoch_from_local(days, time_of_day, offset_seconds) {
        return instant;
    }
    panic("core:temporal: the local date and time name an instant outside the range");
}

/// Temporal's `CheckISODaysRange`, which an offset read from a string or kept
/// through rounding answers to before the instant does.
fn require_epoch_days_range(days: i64) {
    if !(-MAX_EPOCH_DAYS <= days <= MAX_EPOCH_DAYS) {
        panic("core:temporal: the local date is more than 10^8 days from the epoch");
    }
}

// Time zones. Without a time zone database the available zones are "UTC" and
// every fixed offset. An identifier is canonicalized where it enters, so a
// stored zone is either "UTC" or `±HH:MM`.

/// Temporal's `ToTemporalTimeZoneIdentifier` for an operation: a time zone
/// identifier, or an ISO string that carries a zone annotation, `Z`, or a
/// minute-precision offset. Anything else traps.
fn to_time_zone_identifier<S: AsStrSlice>(text: S) -> String {
    let view = text.as_str_slice();
    let result = if is_time_zone_identifier(&view) {
        time_zone_identifier(&view);
    } else {
        time_zone_from_iso_string(&view);
    };
    return match result {
        Ok(zone) => zone,
        Err(e) => panic(`core:temporal: "${view}" names no available time zone: ${e.message}`),
    };
}

/// The zone an ISO string names, read as Temporal's `ParseTemporalTimeZoneString`
/// reads one that is not an identifier itself.
fn time_zone_from_iso_string(text: &StrSlice) -> Result<String, DeserializeError> {
    let parsed = parse_any_iso_string(text)?;
    if let Some(annotation) = parsed.zone {
        return time_zone_identifier(&annotation.as_str_slice());
    }
    if parsed.utc_designator {
        return Result::Ok("UTC");
    }
    if let Some(offset) = parsed.offset {
        if parsed.offset_has_seconds {
            return Result::Err(DeserializeError::invalid_value("an offset with seconds names no time zone"));
        }
        return Result::Ok(format_offset_identifier(offset / 60_000_000_000));
    }
    return Result::Err(DeserializeError::invalid_value("the string carries no time zone"));
}

/// Temporal's `ParseTimeZoneIdentifier` followed by the canonicalization its
/// callers apply: an offset becomes `±HH:MM`, and a name must be available.
fn time_zone_identifier(text: &StrSlice) -> Result<String, DeserializeError> {
    let first = byte_at(text, 0);
    if first == b'+' || first == b'-' {
        let [offset, end, _] = parse_utc_offset(text, 0, false)?;
        if end != text.len() {
            return Result::Err(DeserializeError::malformed("expected a ±HH:MM offset", end as i64));
        }
        return Result::Ok(format_offset_identifier(offset / 60_000_000_000));
    }
    if !is_iana_name(text) {
        return Result::Err(DeserializeError::malformed("expected a time zone name or a ±HH:MM offset"));
    }
    if text.eq_ignore_ascii_case("UTC") {
        return Result::Ok("UTC");
    }
    return Result::Err(DeserializeError::invalid_value(
        "no time zone database is bundled, so UTC is the only named time zone available",
    ));
}

/// Whether `text` matches the grammar's `TimeZoneIANAName`: `/`-separated
/// components, each a letter, `.`, or `_` followed by any of those, digits,
/// `-`, and `+`.
fn is_iana_name(text: &StrSlice) -> bool {
    let mut component_start = true;
    for let mut i = 0; i < text.len(); i += 1 {
        let b = text.get_byte_unchecked(i);
        if b == b'/' {
            if component_start {
                return false;
            }
            component_start = true;
            continue;
        }
        let leading = b.is_ascii_alphabetic() || b == b'.' || b == b'_';
        if component_start {
            if !leading {
                return false;
            }
            component_start = false;
        } else if !(leading || b.is_ascii_digit() || b == b'-' || b == b'+') {
            return false;
        }
    }
    return !component_start;
}

/// Temporal's `FormatOffsetTimeZoneIdentifier`: `±HH:MM`, zero as `+00:00`.
fn format_offset_identifier(minutes: i64) -> String {
    let sign = if minutes < 0 { "-" } else { "+" };
    let magnitude = i64::abs(minutes);
    return `${sign}${magnitude / 60:02}:${magnitude % 60:02}`;
}

/// The offset in seconds of a stored zone, which must be canonical: `"UTC"` or
/// `±HH:MM`. Anything else, an IANA name above all, traps.
fn zone_offset_seconds(zone: &String) -> i64 {
    let view = zone.as_str_slice();
    if view == "UTC" {
        return 0;
    }
    if view.len() == 6 && view.get_byte_unchecked(3) == b':' {
        let sign = view.get_byte_unchecked(0);
        let digits = [
            view.get_byte_unchecked(1),
            view.get_byte_unchecked(2),
            view.get_byte_unchecked(4),
            view.get_byte_unchecked(5),
        ];
        let all_digits = digits.0.is_ascii_digit()
            && digits.1.is_ascii_digit()
            && digits.2.is_ascii_digit()
            && digits.3.is_ascii_digit();
        if (sign == b'+' || sign == b'-') && all_digits {
            let hours = (digits.0 - b'0') as i64 * 10 + (digits.1 - b'0') as i64;
            let minutes = (digits.2 - b'0') as i64 * 10 + (digits.3 - b'0') as i64;
            let magnitude = hours * 3600 + minutes * 60;
            let canonical = hours <= 23 && minutes <= 59 && !(sign == b'-' && magnitude == 0);
            if canonical {
                return if sign == b'-' { -magnitude } else { magnitude };
            }
        }
    }
    panic(
        `core:temporal: time zone "${zone}" is not an available time zone identifier; only "UTC" and ±HH:MM offsets are, until a time zone database is bundled`,
    );
}

/// The unit a temporal difference or rounding operation works in. The order is
/// Temporal's, largest first; `Year`, `Month`, `Week`, and `Day` are the date
/// units, the rest the time units.
pub enum Unit {
    Year,
    Month,
    Week,
    Day,
    Hour,
    Minute,
    Second,
    Millisecond,
    Microsecond,
    Nanosecond,
}

/// How a rounding operation breaks a tie and which way it moves. Temporal's
/// nine modes: the first four are directed, the `Half*` five choose only when
/// the value sits exactly halfway.
pub enum RoundingMode {
    /// Toward positive infinity.
    Ceil,
    /// Toward negative infinity.
    Floor,
    /// Away from zero.
    Expand,
    /// Toward zero.
    Trunc,
    /// Nearest; a tie goes toward positive infinity.
    HalfCeil,
    /// Nearest; a tie goes toward negative infinity.
    HalfFloor,
    /// Nearest; a tie goes away from zero. Temporal's default.
    HalfExpand,
    /// Nearest; a tie goes toward zero.
    HalfTrunc,
    /// Nearest; a tie goes to the even multiple.
    HalfEven,
}

/// Temporal's unsigned rounding modes (Table 22), which say which of the two
/// multiples around a magnitude it moves to.
enum UnsignedRoundingMode {
    Zero,
    Infinity,
    HalfZero,
    HalfInfinity,
    HalfEven,
}

/// Temporal's `GetUnsignedRoundingMode`.
fn unsigned_rounding_mode(mode: RoundingMode, negative: bool) -> UnsignedRoundingMode {
    return match mode {
        Ceil => if negative { UnsignedRoundingMode::Zero } else { UnsignedRoundingMode::Infinity },
        Floor => if negative { UnsignedRoundingMode::Infinity } else { UnsignedRoundingMode::Zero },
        Expand => UnsignedRoundingMode::Infinity,
        Trunc => UnsignedRoundingMode::Zero,
        HalfCeil => if negative { UnsignedRoundingMode::HalfZero } else { UnsignedRoundingMode::HalfInfinity },
        HalfFloor => if negative { UnsignedRoundingMode::HalfInfinity } else { UnsignedRoundingMode::HalfZero },
        HalfExpand => UnsignedRoundingMode::HalfInfinity,
        HalfTrunc => UnsignedRoundingMode::HalfZero,
        HalfEven => UnsignedRoundingMode::HalfEven,
    };
}

/// Temporal's `ApplyUnsignedRoundingMode` for a magnitude strictly between two
/// multiples: whether it moves to the upper one. `half_comparison` compares the
/// distance to the lower multiple with the distance to the upper one.
fn rounds_away(mode: UnsignedRoundingMode, half_comparison: i32, lower_is_odd: bool) -> bool {
    return match mode {
        Zero => false,
        Infinity => true,
        HalfZero => half_comparison > 0,
        HalfInfinity => half_comparison >= 0,
        HalfEven => half_comparison > 0 || half_comparison == 0 && lower_is_odd,
    };
}

fn compare_i64(a: i64, b: i64) -> i32 {
    if a < b {
        return -1;
    }
    if a > b {
        return 1;
    }
    return 0;
}

/// Position of `unit` in Temporal's order, `0` for `Year` … `9` for
/// `Nanosecond`. Smaller is larger.
fn unit_rank(unit: Unit) -> i32 {
    return match unit {
        Year => 0,
        Month => 1,
        Week => 2,
        Day => 3,
        Hour => 4,
        Minute => 5,
        Second => 6,
        Millisecond => 7,
        Microsecond => 8,
        Nanosecond => 9,
    };
}

/// The unit at `rank` in Temporal's order, the inverse of `unit_rank`.
fn unit_of_rank(rank: i32) -> Unit {
    return match rank {
        0 => Unit::Year,
        1 => Unit::Month,
        2 => Unit::Week,
        3 => Unit::Day,
        4 => Unit::Hour,
        5 => Unit::Minute,
        6 => Unit::Second,
        7 => Unit::Millisecond,
        8 => Unit::Microsecond,
        _ => Unit::Nanosecond,
    };
}

/// Temporal's `LargerOfTwoTemporalUnits`.
fn larger_unit(a: Unit, b: Unit) -> Unit {
    if unit_rank(a) <= unit_rank(b) {
        return a;
    }
    return b;
}

/// Whether `unit` is in Temporal's date category, `Day` and above.
fn is_date_unit(unit: Unit) -> bool {
    return unit_rank(unit) <= 3;
}

/// Temporal's `IsCalendarUnit`: a unit that has no length without a calendar.
fn is_calendar_unit(unit: Unit) -> bool {
    return unit_rank(unit) <= 2;
}

/// Nanoseconds in one `unit`, a day counting 24 hours. A calendar unit has no
/// length.
fn unit_nanoseconds(unit: Unit) -> i64 {
    return match unit {
        Day => NANOSECONDS_PER_DAY,
        Hour => 3_600_000_000_000,
        Minute => 60_000_000_000,
        Second => NANOSECONDS_PER_SECOND,
        Millisecond => 1_000_000,
        Microsecond => 1000,
        Nanosecond => 1,
        _ => panic(`core:temporal: a ${unit} has no fixed length without a calendar`),
    };
}

/// Temporal's `MaximumTemporalDurationRoundingIncrement`, `0` where it is
/// unset.
fn maximum_rounding_increment(unit: Unit) -> i64 {
    return match unit {
        Hour => 24,
        Minute => 60,
        Second => 60,
        Millisecond => 1000,
        Microsecond => 1000,
        Nanosecond => 1000,
        _ => 0,
    };
}

/// `GetRoundingIncrementOption`'s range, then Temporal's
/// `ValidateTemporalRoundingIncrement`: at most `dividend`, or below it unless
/// `inclusive`, and dividing it.
fn validate_rounding_increment(increment: i64, dividend: i64, inclusive: bool) {
    require_increment_range(increment);
    let maximum = if inclusive { dividend } else { dividend - 1 };
    if increment > maximum || dividend % increment != 0 {
        panic(`core:temporal: a rounding increment of ${increment} does not divide ${dividend} evenly within its range`);
    }
}

fn require_increment_range(increment: i64) {
    if increment < 1 || increment > MAX_ROUNDING_INCREMENT {
        panic(`core:temporal: a rounding increment of ${increment} is outside 1..=1000000000`);
    }
}

/// The increment check of a `round` that takes a time unit or a day: a day
/// takes no increment but `1`, a time unit one that divides the next unit.
fn validate_time_or_day_rounding(unit: Unit, increment: i64) {
    if unit matches { Day } {
        validate_rounding_increment(increment, 1, true);
        return;
    }
    if is_date_unit(unit) {
        panic(`core:temporal: a value with a clock rounds to a day or a time unit, and a ${unit} is neither`);
    }
    validate_rounding_increment(increment, maximum_rounding_increment(unit), false);
}

/// Temporal's time duration: a signed nanosecond count below 2^53 seconds,
/// held as whole seconds and a sub-second part of the same sign so that no
/// `i128` is needed.
struct TimeDuration {
    seconds: i64,
    nanoseconds: i64,
}

/// The time duration `seconds` plus `nanoseconds`, normalized so that both
/// parts share a sign and the sub-second part is below a second.
fn time_duration(seconds: i64, nanoseconds: i64) -> TimeDuration {
    let mut whole = seconds + nanoseconds / NANOSECONDS_PER_SECOND;
    let mut sub = nanoseconds % NANOSECONDS_PER_SECOND;
    if whole > 0 && sub < 0 {
        whole -= 1;
        sub += NANOSECONDS_PER_SECOND;
    } else if whole < 0 && sub > 0 {
        whole += 1;
        sub -= NANOSECONDS_PER_SECOND;
    }
    return TimeDuration { seconds: whole, nanoseconds: sub };
}

/// Temporal's `TimeDurationFromComponents`, with `days` counted as 24 hours.
/// The components are those of a duration whose time total is below 2^53
/// seconds, so no partial sum overflows.
fn time_duration_from_components(
    days: i64,
    hours: i64,
    minutes: i64,
    seconds: i64,
    milliseconds: i64,
    microseconds: i64,
    nanoseconds: i64,
) -> TimeDuration {
    let whole = days * SECONDS_PER_DAY + hours * 3600 + minutes * 60 + seconds + milliseconds / 1000 + microseconds / 1_000_000 + nanoseconds / NANOSECONDS_PER_SECOND;
    let sub = milliseconds % 1000 * 1_000_000 + microseconds % 1_000_000 * 1000 + nanoseconds % NANOSECONDS_PER_SECOND;
    return time_duration(whole, sub);
}

impl TimeDuration {
    fn sign(&self) -> i32 {
        if self.seconds > 0 || self.nanoseconds > 0 {
            return 1;
        }
        if self.seconds < 0 || self.nanoseconds < 0 {
            return -1;
        }
        return 0;
    }

    fn negated(&self) -> TimeDuration {
        return TimeDuration { seconds: -self.seconds, nanoseconds: -self.nanoseconds };
    }

    fn abs(&self) -> TimeDuration {
        if self.sign() < 0 {
            return self.negated();
        }
        return *self;
    }

    /// Temporal's `AddTimeDuration`.
    fn plus(&self, other: TimeDuration) -> TimeDuration {
        return time_duration(self.seconds + other.seconds, self.nanoseconds + other.nanoseconds).checked();
    }

    /// Temporal's `Add24HourDaysToTimeDuration`.
    fn plus_days(&self, days: i64) -> TimeDuration {
        return time_duration(self.seconds + days * SECONDS_PER_DAY, self.nanoseconds).checked();
    }

    /// Trap past Temporal's `maxTimeDuration`, 2^53 seconds less a nanosecond.
    fn checked(&self) -> TimeDuration {
        if !(-TIME_DURATION_SECONDS_LIMIT < self.seconds < TIME_DURATION_SECONDS_LIMIT) {
            panic("core:temporal: the time duration reaches 2^53 seconds");
        }
        return *self;
    }
}

/// Temporal's `RoundTimeDurationToIncrement` for an increment of `step` whole
/// seconds, rounding with the sign.
fn round_time_duration_seconds(t: TimeDuration, step: i64, mode: RoundingMode) -> TimeDuration {
    let negative = t.sign() < 0;
    let magnitude = t.abs();
    let quotient = magnitude.seconds / step;
    let rest = magnitude.seconds % step;
    if rest == 0 && magnitude.nanoseconds == 0 {
        return t;
    }
    // The distance up to the next multiple, as a whole-seconds and sub-second
    // pair to compare with the remainder.
    let mut up_seconds = step - rest;
    let mut up_nanoseconds: i64 = 0;
    if magnitude.nanoseconds > 0 {
        up_seconds -= 1;
        up_nanoseconds = NANOSECONDS_PER_SECOND - magnitude.nanoseconds;
    }
    let mut half = compare_i64(rest, up_seconds);
    if half == 0 {
        half = compare_i64(magnitude.nanoseconds, up_nanoseconds);
    }
    let up = rounds_away(unsigned_rounding_mode(mode, negative), half, quotient % 2 == 1);
    let multiple = if up { quotient + 1 } else { quotient };
    let rounded = TimeDuration { seconds: multiple * step, nanoseconds: 0 }.checked();
    return if negative { rounded.negated() } else { rounded };
}

/// Temporal's `RoundTimeDurationToIncrement` for an increment of `step`
/// nanoseconds that divides the second, rounding with the sign.
fn round_time_duration_subsecond(t: TimeDuration, step: i64, mode: RoundingMode) -> TimeDuration {
    let negative = t.sign() < 0;
    let magnitude = t.abs();
    let quotient = magnitude.nanoseconds / step;
    let rest = magnitude.nanoseconds % step;
    if rest == 0 {
        return t;
    }
    // The parity a half-even tie looks at is that of the whole count of steps,
    // so it takes in the steps of every whole second.
    let lower_is_odd = (magnitude.seconds % 2 * (NANOSECONDS_PER_SECOND / step % 2) + quotient) % 2 == 1;
    let up = rounds_away(unsigned_rounding_mode(mode, negative), compare_i64(rest, step - rest), lower_is_odd);
    let multiple = if up { quotient + 1 } else { quotient };
    let rounded = time_duration(magnitude.seconds, multiple * step).checked();
    return if negative { rounded.negated() } else { rounded };
}

/// Temporal's `RoundTimeDuration`. Every increment a caller validates is either
/// whole seconds or a divisor of the second.
fn round_time_duration(t: TimeDuration, increment: i64, unit: Unit, mode: RoundingMode) -> TimeDuration {
    if unit_rank(unit) <= unit_rank(Unit::Second) {
        return round_time_duration_seconds(t, increment * (unit_nanoseconds(unit) / NANOSECONDS_PER_SECOND), mode);
    }
    let step = increment * unit_nanoseconds(unit);
    assert NANOSECONDS_PER_SECOND % step == 0;
    return round_time_duration_subsecond(t, step, mode);
}

/// Temporal's `RoundTime` on a time of day, answering the days it carries and
/// the rounded time of day. The quantity rounded is measured within the next
/// larger unit, so a half-even tie looks at the parity within that unit.
fn round_time(time_of_day: i64, increment: i64, unit: Unit, mode: RoundingMode) -> [i64, i64] {
    let parent = if unit matches { Day } {
        NANOSECONDS_PER_DAY;
    } else {
        unit_nanoseconds(unit) * maximum_rounding_increment(unit);
    };
    let quantity = time_of_day % parent;
    let step = increment * unit_nanoseconds(unit);
    let quotient = quantity / step;
    let rest = quantity % step;
    let mut rounded = quantity;
    if rest != 0 {
        let up = rounds_away(unsigned_rounding_mode(mode, false), compare_i64(rest, step - rest), quotient % 2 == 1);
        rounded = if up { (quotient + 1) * step } else { quotient * step };
    }
    let total = time_of_day - quantity + rounded;
    return [
        floor_div(total, NANOSECONDS_PER_DAY),
        floor_mod(total, NANOSECONDS_PER_DAY),
    ];
}

/// Temporal's `AddTime` on a time of day, answering the days it carries and the
/// time of day it reaches.
fn add_time(time_of_day: i64, time: TimeDuration) -> [i64, i64] {
    let nanoseconds = time_of_day % NANOSECONDS_PER_SECOND + time.nanoseconds;
    let seconds = time_of_day / NANOSECONDS_PER_SECOND + time.seconds + floor_div(nanoseconds, NANOSECONDS_PER_SECOND);
    return [
        floor_div(seconds, SECONDS_PER_DAY),
        floor_mod(seconds, SECONDS_PER_DAY) * NANOSECONDS_PER_SECOND + floor_mod(nanoseconds, NANOSECONDS_PER_SECOND),
    ];
}

/// A signed span of time, as a Temporal-shaped record of ten components rather
/// than one scalar. Corresponds to `Temporal.Duration`.
///
/// Temporal's invariants hold: every non-zero component has one sign, a year,
/// month, or week count is below 2^32, and the days and time components
/// together are below 2^53 seconds. So that negation stays exact, no component
/// is `i64::MIN`. A struct literal can break them, so every
/// operation checks its receiver and traps on one that does. The date
/// components (`years`, `months`, `weeks`) have no fixed length, so a duration
/// carrying one applies only to a receiver that knows a calendar position.
pub struct Duration {
    pub years: i64 = 0,
    pub months: i64 = 0,
    pub weeks: i64 = 0,
    pub days: i64 = 0,
    pub hours: i64 = 0,
    pub minutes: i64 = 0,
    pub seconds: i64 = 0,
    pub milliseconds: i64 = 0,
    pub microseconds: i64 = 0,
    pub nanoseconds: i64 = 0,
}

impl Eq for Duration;

impl Duration {
    /// Parse Temporal's ISO 8601 duration, such as `"P1Y2M3W4DT5H6M7.5S"`,
    /// optionally signed. A fraction of up to nine digits is allowed on the
    /// last time component and spills into the components below it, so
    /// `"PT1.5H"` is `PT1H30M`. A result that is not a valid duration is an
    /// error.
    pub fn parse<S: AsStrSlice>(text: S) -> Result<Duration, DeserializeError> {
        return parse_iso_duration(&text.as_str_slice());
    }

    /// The sign of the duration: `1`, `-1`, or `0` when every component is
    /// zero.
    pub fn sign(&self) -> i32 {
        return self.validated().raw_sign();
    }

    /// Whether every component is zero (`Temporal.Duration.prototype.blank`).
    pub fn is_zero(&self) -> bool {
        return self.sign() == 0;
    }

    /// The same span in the opposite direction.
    pub fn negated(&self) -> Duration {
        return self.validated().scaled(-1);
    }

    /// The same span with a non-negative sign.
    pub fn abs(&self) -> Duration {
        let d = self.validated();
        if d.raw_sign() < 0 {
            return d.scaled(-1);
        }
        return d;
    }

    /// The two spans summed (Temporal's `AddDurations`), a day counting 24
    /// hours, and balanced up to the larger of their largest units. Years,
    /// months, and weeks trap, since adding one needs the calendar position
    /// Temporal's `relativeTo` supplies.
    pub fn add(&self, other: &Duration) -> Duration {
        let one = self.validated();
        let two = other.validated();
        let largest = larger_unit(one.default_largest_unit(), two.default_largest_unit());
        if is_calendar_unit(largest) {
            panic(
                "core:temporal: adding a duration that carries years, months, or weeks needs the calendar position a relativeTo anchor would supply",
            );
        }
        return duration_from_internal(&Duration {}, one.time_with_days().plus(two.time_with_days()), largest);
    }

    /// The difference of the two spans, balanced the same way as `add`.
    pub fn subtract(&self, other: &Duration) -> Duration {
        return self.add(&other.negated());
    }

    /// The whole span expressed in `unit`, a day counting 24 hours, as the
    /// float nearest the exact quotient. Years, months, and weeks have no
    /// length without a calendar anchor, as a component or as the unit, and
    /// trap.
    pub fn total(&self, unit: Unit) -> f64 {
        let d = self.validated();
        if d.has_calendar_components() {
            panic("core:temporal: a total of years, months, or weeks needs a calendar anchor");
        }
        let t = d.time_with_days();
        return exact_quotient_to_f64(
            t.seconds as i128 * 1_000_000_000 + t.nanoseconds as i128,
            unit_nanoseconds(unit) as i128,
        );
    }

    /// Round to a multiple of `increment` `smallest_unit`s, a day counting 24
    /// hours, and balance up to `largest_unit`, which may be no smaller.
    /// Years, months, and weeks trap, as a component or as a unit. A time unit
    /// takes an increment that divides the next unit; a day takes any.
    pub fn round(
        &self,
        smallest_unit: Unit,
        largest_unit: Unit,
        increment: i64 = 1,
        mode: RoundingMode = RoundingMode::HalfExpand,
    ) -> Duration {
        let d = self.validated();
        if unit_rank(largest_unit) > unit_rank(smallest_unit) {
            panic(`core:temporal: the largest unit ${largest_unit} is smaller than the smallest unit ${smallest_unit}`);
        }
        if is_calendar_unit(largest_unit) || d.has_calendar_components() {
            panic("core:temporal: rounding in or of years, months, or weeks needs a calendar anchor");
        }
        let maximum = maximum_rounding_increment(smallest_unit);
        if maximum == 0 {
            require_increment_range(increment);
        } else {
            validate_rounding_increment(increment, maximum, false);
        }
        let rounded = round_time_duration(d.time_with_days(), increment, smallest_unit, mode);
        return duration_from_internal(&Duration {}, rounded, largest_unit);
    }

    /// Temporal's `toString` (and `toJSON`), e.g. `"P1Y2M3W4DT5H6M7.5S"`. A
    /// zero duration is `"PT0S"`; a negative one takes a leading `-`.
    pub fn to_iso8601(&self) -> String {
        return duration_to_string(self, -1);
    }

    /// Every component, largest first.
    fn components(&self) -> [i64, i64, i64, i64, i64, i64, i64, i64, i64, i64] {
        return [
            self.years, self.months, self.weeks, self.days, self.hours, self.minutes, self.seconds, self.milliseconds,
            self.microseconds, self.nanoseconds,
        ];
    }

    /// Temporal's `DurationSign`, without the validity check.
    fn raw_sign(&self) -> i32 {
        for let component of self.components() {
            if component > 0 {
                return 1;
            }
            if component < 0 {
                return -1;
            }
        }
        return 0;
    }

    /// Temporal's `IsValidDuration`.
    fn is_valid(&self) -> bool {
        let sign = self.raw_sign();
        for let component of self.components() {
            // `i64::MIN` has no negation in an `i64`.
            if component > 0 && sign < 0 || component < 0 && sign > 0 || component == i64::MIN {
                return false;
            }
        }
        if !(is_below(self.years, CALENDAR_UNIT_LIMIT)
            && is_below(self.months, CALENDAR_UNIT_LIMIT)
            && is_below(self.weeks, CALENDAR_UNIT_LIMIT)) {
            return false;
        }
        // Each bound keeps the sum below from overflowing; a microsecond or
        // nanosecond count below the i64 limit is far below 2^53 seconds.
        let limit = TIME_DURATION_SECONDS_LIMIT;
        if !(is_below(self.days, limit / SECONDS_PER_DAY + 1)
            && is_below(self.hours, limit / 3600 + 1)
            && is_below(self.minutes, limit / 60 + 1)
            && is_below(self.seconds, limit)
            && is_below(self.milliseconds / 1000, limit)) {
            return false;
        }
        return is_below(self.time_with_days().seconds, limit);
    }

    /// Trap unless this is a valid duration, the check a struct literal skips.
    fn validated(&self) -> Duration {
        if !self.is_valid() {
            panic(`core:temporal: ${self:?} is not a valid duration`);
        }
        return *self;
    }

    fn has_calendar_components(&self) -> bool {
        return self.years != 0 || self.months != 0 || self.weeks != 0;
    }

    /// The date components alone, Temporal's date duration record.
    fn date_part(&self) -> Duration {
        return Duration { years: self.years, months: self.months, weeks: self.weeks, days: self.days };
    }

    /// The time components as a time duration, the days left out.
    fn time_part(&self) -> TimeDuration {
        return time_duration_from_components(
            0,
            self.hours,
            self.minutes,
            self.seconds,
            self.milliseconds,
            self.microseconds,
            self.nanoseconds,
        );
    }

    /// The days and time components as a time duration, a day counting 24
    /// hours (`ToInternalDurationRecordWith24HourDays`).
    fn time_with_days(&self) -> TimeDuration {
        return time_duration_from_components(
            self.days,
            self.hours,
            self.minutes,
            self.seconds,
            self.milliseconds,
            self.microseconds,
            self.nanoseconds,
        );
    }

    /// Temporal's `DefaultTemporalLargestUnit`: the largest non-zero
    /// component, or `Nanosecond` for a zero duration.
    fn default_largest_unit(&self) -> Unit {
        let mut rank = 0;
        for let component of self.components() {
            if component != 0 {
                return unit_of_rank(rank);
            }
            rank += 1;
        }
        return Unit::Nanosecond;
    }

    /// Every component scaled by `factor`.
    fn scaled(&self, factor: i64) -> Duration {
        return Duration {
            years: self.years * factor,
            months: self.months * factor,
            weeks: self.weeks * factor,
            days: self.days * factor,
            hours: self.hours * factor,
            minutes: self.minutes * factor,
            seconds: self.seconds * factor,
            milliseconds: self.milliseconds * factor,
            microseconds: self.microseconds * factor,
            nanoseconds: self.nanoseconds * factor,
        };
    }
}

/// Whether `value` is strictly between `-limit` and `limit`, written so that
/// `i64::MIN` fails it rather than wrapping through an `abs`.
fn is_below(value: i64, limit: i64) -> bool {
    return -limit < value < limit;
}

/// Temporal's `TemporalDurationFromInternal`: the date components as given,
/// and the time balanced into the components up to `largest_unit`. A
/// millisecond, microsecond, or nanosecond count beyond the `i64` range traps.
fn duration_from_internal(date: &Duration, time: TimeDuration, largest_unit: Unit) -> Duration {
    let sign = time.sign() as i64;
    let magnitude = time.abs();
    let s = magnitude.seconds;
    let n = magnitude.nanoseconds;
    let rank = unit_rank(largest_unit);
    let mut days: i64 = 0;
    let mut hours: i64 = 0;
    let mut minutes: i64 = 0;
    let mut seconds: i64 = 0;
    let mut milliseconds = n / 1_000_000;
    let mut microseconds = n / 1000 % 1000;
    let nanoseconds = n % 1000;
    if rank <= unit_rank(Unit::Day) {
        days = s / SECONDS_PER_DAY;
        hours = s % SECONDS_PER_DAY / 3600;
        minutes = s % 3600 / 60;
        seconds = s % 60;
    } else if rank == unit_rank(Unit::Hour) {
        hours = s / 3600;
        minutes = s % 3600 / 60;
        seconds = s % 60;
    } else if rank == unit_rank(Unit::Minute) {
        minutes = s / 60;
        seconds = s % 60;
    } else if rank == unit_rank(Unit::Second) {
        seconds = s;
    } else if rank == unit_rank(Unit::Millisecond) {
        milliseconds = scaled_count(s, milliseconds, 1000);
    } else if rank == unit_rank(Unit::Microsecond) {
        milliseconds = 0;
        microseconds = scaled_count(s, n / 1000, 1_000_000);
    } else {
        return Duration { ..*date, nanoseconds: sign * scaled_count(s, n, NANOSECONDS_PER_SECOND) }.validated();
    }
    return Duration {
        years: date.years,
        months: date.months,
        weeks: date.weeks,
        days: date.days + sign * days,
        hours: sign * hours,
        minutes: sign * minutes,
        seconds: sign * seconds,
        milliseconds: sign * milliseconds,
        microseconds: sign * microseconds,
        nanoseconds: sign * nanoseconds,
    }.validated();
}

/// `seconds` whole seconds in a unit `per_second` to the second, plus `sub`
/// of them. Traps where the count does not fit an `i64`.
fn scaled_count(seconds: i64, sub: i64, per_second: i64) -> i64 {
    if seconds > (i64::MAX - per_second) / per_second {
        panic("core:temporal: the count does not fit the i64 a duration component is stored in");
    }
    return seconds * per_second + sub;
}

/// The f64 nearest `numerator / denominator`, ties to even, for a positive
/// `denominator`: the exact quotient Temporal's `TotalTimeDuration` rounds
/// once, where dividing two rounded floats would round twice.
fn exact_quotient_to_f64(numerator: i128, denominator: i128) -> f64 {
    if numerator == 0 {
        return 0.0;
    }
    let negative = numerator < 0;
    let magnitude = if negative { -numerator } else { numerator };
    // Scale so that the integer quotient carries 55 or 56 significant bits,
    // two or three more than the 53 an f64 keeps.
    let shift = 55 + bit_length(denominator) - bit_length(magnitude);
    let mut scaled_numerator = magnitude;
    let mut scaled_denominator = denominator;
    if shift >= 0 {
        scaled_numerator = magnitude * power_of_two(shift);
    } else {
        scaled_denominator = denominator * power_of_two(-shift);
    }
    let mut quotient = scaled_numerator / scaled_denominator;
    let mut sticky = scaled_numerator % scaled_denominator != 0;
    let mut exponent = -shift;
    let mut round_bit: i128 = 0;
    let limit = power_of_two(53);
    while quotient >= limit {
        sticky = sticky || round_bit != 0;
        round_bit = quotient % 2;
        quotient /= 2;
        exponent += 1;
    }
    if round_bit == 1 && (sticky || quotient % 2 == 1) {
        quotient += 1;
        if quotient == limit {
            quotient /= 2;
            exponent += 1;
        }
    }
    let scale = f64::from_bits((exponent + 1023) as u64 << 52);
    let value = quotient as i64 as f64 * scale;
    return if negative { -value } else { value };
}

fn bit_length(value: i128) -> i32 {
    let mut bits = 0;
    let mut rest = value;
    while rest > 0 {
        rest /= 2;
        bits += 1;
    }
    return bits;
}

fn power_of_two(exponent: i32) -> i128 {
    let mut value: i128 = 1;
    for let mut i = 0; i < exponent; i += 1 {
        value *= 2;
    }
    return value;
}

impl Display for Duration {
    fn fmt(&self, f: &mut Formatter) {
        f.pad(duration_to_string(self, resolve_precision(f)));
    }
}

/// `Temporal.Duration.prototype.toString` with `fractionalSecondDigits`
/// `precision` (`-1` for `auto`): the time is truncated to that many digits
/// and rebalanced, then written out.
fn duration_to_string(duration: &Duration, precision: i32) -> String {
    let d = duration.validated();
    if precision < 0 || precision == 9 {
        return temporal_duration_to_string(&d, precision);
    }
    let mut step: i64 = 1;
    for let mut i = precision; i < 9; i += 1 {
        step *= 10;
    }
    let time = round_time_duration_subsecond(d.time_part(), step, RoundingMode::Trunc);
    let rounded = duration_from_internal(&d.date_part(), time, larger_unit(d.default_largest_unit(), Unit::Second));
    return temporal_duration_to_string(&rounded, precision);
}

/// Temporal's `TemporalDurationToString` for a valid duration.
fn temporal_duration_to_string(d: &Duration, precision: i32) -> String {
    let mut date_part = "";
    if d.years != 0 {
        date_part = `${date_part}${i64::abs(d.years)}Y`;
    }
    if d.months != 0 {
        date_part = `${date_part}${i64::abs(d.months)}M`;
    }
    if d.weeks != 0 {
        date_part = `${date_part}${i64::abs(d.weeks)}W`;
    }
    if d.days != 0 {
        date_part = `${date_part}${i64::abs(d.days)}D`;
    }
    let mut time_part = "";
    if d.hours != 0 {
        time_part = `${time_part}${i64::abs(d.hours)}H`;
    }
    if d.minutes != 0 {
        time_part = `${time_part}${i64::abs(d.minutes)}M`;
    }
    let zero_minutes_and_higher = unit_rank(d.default_largest_unit()) >= unit_rank(Unit::Second);
    let seconds = time_duration_from_components(0, 0, 0, d.seconds, d.milliseconds, d.microseconds, d.nanoseconds);
    if seconds.sign() != 0 || zero_minutes_and_higher || precision >= 0 {
        let magnitude = seconds.abs();
        time_part = `${time_part}${magnitude.seconds}${format_fraction(magnitude.nanoseconds, precision)}S`;
    }
    let sign_part = if d.raw_sign() < 0 { "-" } else { "" };
    if time_part.len() == 0 {
        return `${sign_part}P${date_part}`;
    }
    return `${sign_part}P${date_part}T${time_part}`;
}

impl Serialize for Duration {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let text = self.to_iso8601();
        return s.serialize_string(&text);
    }
}

impl FromStr for Duration {
    type Err = DeserializeError;

    fn from_str<S: AsStrSlice>(s: S) -> Result<Duration, DeserializeError> {
        return parse_iso_duration(&s.as_str_slice());
    }
}

/// Temporal's `ParseTemporalDurationString`.
fn parse_iso_duration(text: &StrSlice) -> Result<Duration, DeserializeError> {
    let end = text.len();
    let mut i = 0;
    let mut negative = false;
    let first = byte_at(text, 0);
    if first == b'+' || first == b'-' {
        negative = first == b'-';
        i = 1;
    }
    if !byte_at(text, i).eq_ignore_ascii_case(&b'P') {
        return Result::Err(DeserializeError::malformed("expected 'P'", i as i64));
    }
    i += 1;

    let mut out = Duration {};
    let mut seen_component = false;
    let mut date_slot = 0;
    while i < end && !byte_at(text, i).eq_ignore_ascii_case(&b'T') {
        let [value, after] = read_duration_integer(text, i)?;
        let slot = duration_date_slot(byte_at(text, after));
        if slot < 0 {
            return Result::Err(DeserializeError::malformed("expected 'Y', 'M', 'W', or 'D'", after as i64));
        }
        if slot < date_slot {
            return Result::Err(DeserializeError::malformed("duration components are out of order", after as i64));
        }
        date_slot = slot + 1;
        seen_component = true;
        out = assign_date_component(out, slot, value);
        i = after + 1;
    }

    if i < end {
        i += 1;
        let mut time_slot = 0;
        let mut fraction_seen = false;
        if i == end {
            return Result::Err(DeserializeError::malformed("expected a time component after 'T'", i as i64));
        }
        while i < end {
            if fraction_seen {
                return Result::Err(DeserializeError::malformed(
                    "only the last duration component may carry a fraction",
                    i as i64,
                ));
            }
            let [value, after_number] = read_duration_integer(text, i)?;
            let [fraction, after] = parse_time_fraction(text, after_number)?;
            let slot = duration_time_slot(byte_at(text, after));
            if slot < 0 {
                return Result::Err(DeserializeError::malformed("expected 'H', 'M', or 'S'", after as i64));
            }
            if slot < time_slot {
                return Result::Err(DeserializeError::malformed("duration components are out of order", after as i64));
            }
            time_slot = slot + 1;
            seen_component = true;
            out = assign_time_component(out, slot, value);
            if after > after_number {
                fraction_seen = true;
                out = spill_fraction(out, slot, fraction);
            }
            i = after + 1;
        }
    }

    if !seen_component {
        return Result::Err(DeserializeError::malformed("a duration needs at least one component", i as i64));
    }
    let result = if negative { out.scaled(-1) } else { out };
    if !result.is_valid() {
        return Result::Err(DeserializeError::invalid_value("the duration is outside Temporal's range"));
    }
    return Result::Ok(result);
}

/// Read the run of digits at `i`, returning the value and the index just past
/// it. A value past the `i64` range is an error rather than a wrapped count.
fn read_duration_integer(text: &StrSlice, i: i32) -> Result<[i64, i32], DeserializeError> {
    let mut j = i;
    let mut value: i64 = 0;
    while byte_at(text, j).is_ascii_digit() {
        let digit = (byte_at(text, j) - b'0') as i64;
        if value > (i64::MAX - digit) / 10 {
            return Result::Err(DeserializeError::overflow("a duration component overflows", i as i64));
        }
        value = value * 10 + digit;
        j += 1;
    }
    if j == i {
        return Result::Err(DeserializeError::malformed("expected a duration component", i as i64));
    }
    return Result::Ok([value, j]);
}

/// Spread `fraction_nanoseconds` billionths of the time unit in `slot` over the
/// components below it, which are still zero.
fn spill_fraction(duration: Duration, slot: i32, fraction_nanoseconds: i64) -> Duration {
    let slot_seconds: i64 = if slot == 0 {
        3600;
    } else if slot == 1 {
        60;
    } else {
        1;
    };
    let mut rest = fraction_nanoseconds * slot_seconds;
    let mut out = duration;
    if slot == 0 {
        out = Duration { ..out, minutes: rest / 60_000_000_000 };
        rest %= 60_000_000_000;
    }
    if slot <= 1 {
        out = Duration { ..out, seconds: rest / NANOSECONDS_PER_SECOND };
        rest %= NANOSECONDS_PER_SECOND;
    }
    return Duration {
        ..out,
        milliseconds: rest / 1_000_000,
        microseconds: rest / 1000 % 1000,
        nanoseconds: rest % 1000,
    };
}

/// Slot index of an ISO 8601 date designator (`Y`, `M`, `W`, `D`), or `-1`.
fn duration_date_slot(byte: u8) -> i32 {
    let upper = byte.to_ascii_uppercase();
    if upper == b'Y' {
        return 0;
    }
    if upper == b'M' {
        return 1;
    }
    if upper == b'W' {
        return 2;
    }
    if upper == b'D' {
        return 3;
    }
    return -1;
}

/// Slot index of an ISO 8601 time designator (`H`, `M`, `S`), or `-1`.
fn duration_time_slot(byte: u8) -> i32 {
    let upper = byte.to_ascii_uppercase();
    if upper == b'H' {
        return 0;
    }
    if upper == b'M' {
        return 1;
    }
    if upper == b'S' {
        return 2;
    }
    return -1;
}

/// Store `value` in the date component named by `slot`.
fn assign_date_component(duration: Duration, slot: i32, value: i64) -> Duration {
    if slot == 0 {
        return Duration { ..duration, years: value };
    }
    if slot == 1 {
        return Duration { ..duration, months: value };
    }
    if slot == 2 {
        return Duration { ..duration, weeks: value };
    }
    return Duration { ..duration, days: value };
}

/// Store `value` in the time component named by `slot`.
fn assign_time_component(duration: Duration, slot: i32, value: i64) -> Duration {
    if slot == 0 {
        return Duration { ..duration, hours: value };
    }
    if slot == 1 {
        return Duration { ..duration, minutes: value };
    }
    return Duration { ..duration, seconds: value };
}

impl Deserialize for Duration {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<Duration, DeserializeError> {
        let text = d.deserialize_string()?;
        return Duration::from_str(text);
    }
}

// The ISO 8601 calendar.

/// Temporal's ISO Date Record: a proleptic Gregorian date, not yet known to
/// exist or to be in range.
struct IsoDate {
    year: i64,
    month: i64,
    day: i64,
}

/// The date `days` after 1970-01-01. Howard Hinnant's `civil_from_days`,
/// valid for any day count, including negatives.
fn iso_date_from_epoch_days(days: i64) -> IsoDate {
    let z = days + 719468;
    let era = if z >= 0 { z } else { z - 146096 } / 146097;
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let month = if mp < 10 { mp + 3 } else { mp - 9 };
    let year = yoe + era * 400;
    return IsoDate { year: if month <= 2 { year + 1 } else { year }, month: month, day: doy - (153 * mp + 2) / 5 + 1 };
}

/// Days since 1970-01-01 for a proleptic Gregorian date. Howard Hinnant's
/// `days_from_civil`, the inverse of `iso_date_from_epoch_days`.
fn epoch_days_of(year: i64, month: i64, day: i64) -> i64 {
    let y = if month <= 2 { year - 1 } else { year };
    let era = if y >= 0 { y } else { y - 399 } / 400;
    let yoe = y - era * 400;
    let mp = if month > 2 { month - 3 } else { month + 9 };
    let doy = (153 * mp + 2) / 5 + day - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return era * 146097 + doe - 719468;
}

fn is_leap_year(year: i64) -> bool {
    return year % 4 == 0 && year % 100 != 0 || year % 400 == 0;
}

/// Temporal's `ISODaysInMonth`, for a month in `1..=12`.
fn iso_days_in_month(year: i64, month: i64) -> i64 {
    if month == 2 {
        return if is_leap_year(year) { 29 } else { 28 };
    }
    if month == 4 || month == 6 || month == 9 || month == 11 {
        return 30;
    }
    return 31;
}

/// Temporal's `IsValidISODate`.
fn is_valid_iso_date(year: i64, month: i64, day: i64) -> bool {
    return 1 <= month <= 12 && 1 <= day <= iso_days_in_month(year, month);
}

/// Temporal's `ISODateWithinLimits`: the instant range widened by a day, since
/// a local date may sit a day either side of the UTC one.
fn iso_date_within_limits(days: i64) -> bool {
    return -MAX_EPOCH_DAYS - 1 <= days <= MAX_EPOCH_DAYS;
}

/// Temporal's `ISODateTimeWithinLimits`: strictly within a day of the instant
/// range.
fn date_time_within_limits(days: i64, time_of_day: i64) -> bool {
    if !iso_date_within_limits(days) {
        return false;
    }
    return days > -MAX_EPOCH_DAYS - 1 || time_of_day > 0;
}

fn require_date_time_within_limits(days: i64, time_of_day: i64) {
    if !date_time_within_limits(days, time_of_day) {
        panic("core:temporal: the date and time are outside the range of 10^8 days either side of the epoch");
    }
}

/// Temporal's `ISOYearMonthWithinLimits`.
fn year_month_within_limits(year: i64, month: i64) -> bool {
    if year < -271821 || year > 275760 {
        return false;
    }
    return !(year == -271821 && month < 4) && !(year == 275760 && month > 9);
}

/// Temporal's `CalendarDateAdd` under ISO 8601 with `constrain`, answering the
/// epoch day of the result. A month-end overflow lands on the month's last day;
/// a result outside the date range traps.
fn calendar_date_add(date: &IsoDate, duration: &Duration) -> i64 {
    let months = date.month - 1 + duration.months;
    let year = date.year + duration.years + floor_div(months, 12);
    let month = floor_mod(months, 12) + 1;
    let day = i64::min(date.day, iso_days_in_month(year, month));
    let days = epoch_days_of(year, month, day) + duration.weeks * 7 + duration.days;
    if !iso_date_within_limits(days) {
        panic("core:temporal: the date is outside the range of 10^8 days either side of the epoch");
    }
    return days;
}

/// Temporal's `CalendarDateUntil` under ISO 8601: the largest whole years and
/// months that do not carry `one` past `two` (`ISODateSurpasses`, which tests
/// the month-end before constraining it), then whole weeks and days.
fn calendar_date_until(one: &IsoDate, two: &IsoDate, largest_unit: Unit) -> Duration {
    let order = compare_iso_dates(one, two);
    if order == 0 {
        return Duration {};
    }
    let sign = -order as i64;
    let mut years: i64 = 0;
    if largest_unit matches { Year } {
        years = two.year - one.year;
        if surpasses(sign, one.year + years, one.month, one.day, two) {
            years -= sign;
        }
    }
    let start_year = one.year + years;
    let mut months: i64 = 0;
    if largest_unit matches { Year | Month } {
        months = (two.year - start_year) * 12 + two.month - one.month;
        let total = one.month - 1 + months;
        if months != 0 && surpasses(sign, start_year + floor_div(total, 12), floor_mod(total, 12) + 1, one.day, two) {
            months -= sign;
        }
    }
    let total = one.month - 1 + months;
    let base_year = start_year + floor_div(total, 12);
    let base_month = floor_mod(total, 12) + 1;
    let base = epoch_days_of(base_year, base_month, i64::min(one.day, iso_days_in_month(base_year, base_month)));
    let remaining = epoch_days_of(two.year, two.month, two.day) - base;
    let weeks = if largest_unit matches { Week } { remaining / 7 } else { 0 };
    return Duration { years: years, months: months, weeks: weeks, days: remaining - weeks * 7 };
}

/// Temporal's `CompareISODate`.
fn compare_iso_dates(one: &IsoDate, two: &IsoDate) -> i32 {
    let by_year = compare_i64(one.year, two.year);
    if by_year != 0 {
        return by_year;
    }
    let by_month = compare_i64(one.month, two.month);
    if by_month != 0 {
        return by_month;
    }
    return compare_i64(one.day, two.day);
}

/// Temporal's `CompareSurpasses`: whether the unconstrained date lies beyond
/// `target` in the direction of `sign`.
fn surpasses(sign: i64, year: i64, month: i64, day: i64, target: &IsoDate) -> bool {
    return sign * compare_iso_dates(&IsoDate { year: year, month: month, day: day }, target) as i64 > 0;
}

/// Temporal's `DifferenceISODateTime` on two local readings, each an epoch day
/// and a time of day.
fn difference_iso_date_time(
    days1: i64,
    time1: i64,
    days2: i64,
    time2: i64,
    largest_unit: Unit,
) -> [Duration, TimeDuration] {
    let mut time = time_duration(0, time2 - time1);
    let time_sign = time.sign();
    let mut adjusted = days2;
    if time_sign == compare_i64(days1, days2) {
        adjusted += time_sign as i64;
        time = time.plus_days(-time_sign as i64);
    }
    let date_largest = larger_unit(Unit::Day, largest_unit);
    let date = calendar_date_until(&iso_date_from_epoch_days(days1), &iso_date_from_epoch_days(adjusted), date_largest);
    if unit_rank(largest_unit) != unit_rank(date_largest) {
        return [
            Duration { ..date, days: 0 },
            time.plus_days(date.days),
        ];
    }
    return [date, time];
}

/// ISO 8601 week date `[week, week_year]` for a day given by its calendar year,
/// day of year (`1..=366`), and day of week (`1` Monday … `7` Sunday).
fn iso_week_date(year: i64, day_of_year: i64, day_of_week: i64) -> [i64, i64] {
    let week = (day_of_year - day_of_week + 10) / 7;
    if week < 1 {
        return [iso_weeks_in_year(year - 1), year - 1];
    }
    if week > iso_weeks_in_year(year) {
        return [1, year + 1];
    }
    return [week, year];
}

/// Number of ISO 8601 weeks in `year`: 53 when the year ends on a Thursday, or
/// the year before it ended on a Wednesday; else 52.
fn iso_weeks_in_year(year: i64) -> i64 {
    if year_end_weekday(year) == 4 || year_end_weekday(year - 1) == 3 {
        return 53;
    }
    return 52;
}

/// Weekday of 31 December of `year`, `0` (Sunday) … `6` (Saturday), by the
/// closed form the ISO week count is built on.
fn year_end_weekday(year: i64) -> i64 {
    return floor_mod(year + floor_div(year, 4) - floor_div(year, 100) + floor_div(year, 400), 7);
}

/// Temporal month code, `"M01"` … `"M12"`. The ISO 8601 calendar has no leap
/// month, so no case carries the `L` suffix a lunisolar one would.
fn month_code_of(month: i32) -> String {
    return `M${month:02}`;
}

/// ISO 8601 day of the week for a day count since the epoch, `1` (Monday)
/// through `7` (Sunday). 1970-01-01 was a Thursday, hence the `+ 3`.
fn day_of_week_of(days: i64) -> i64 {
    return floor_mod(days + 3, 7) + 1;
}

/// Quotient of `a` by positive `m`, flooring toward negative infinity.
fn floor_div(a: i64, m: i64) -> i64 {
    return (a - floor_mod(a, m)) / m;
}

/// Non-negative remainder of `a` modulo positive `m`.
fn floor_mod(a: i64, m: i64) -> i64 {
    let r = a % m;
    if r < 0 {
        return r + m;
    }
    return r;
}

/// Quotient of `a` by positive `m`, flooring toward negative infinity.
fn floor_div_i128(a: i128, m: i128) -> i128 {
    let mut q = a / m;
    if a % m < 0 {
        q -= 1;
    }
    return q;
}

// Formatting, as Temporal's `toString` writes each part.

/// Temporal's `PadISOYear`: four digits in `0..=9999`, otherwise a sign and
/// six digits.
fn format_iso_year(year: i64) -> String {
    if 0 <= year <= 9999 {
        return `${year:04}`;
    }
    if year > 9999 {
        return `+${year:06}`;
    }
    let magnitude = -year;
    return `-${magnitude:06}`;
}

fn format_iso_date(date: &IsoDate) -> String {
    return `${format_iso_year(date.year)}-${date.month:02}-${date.day:02}`;
}

/// Temporal's `FormatTimeString` for a time of day in nanoseconds.
fn format_time_of_day(time_of_day: i64, precision: i32) -> String {
    let second_of_day = time_of_day / NANOSECONDS_PER_SECOND;
    let fraction = format_fraction(time_of_day % NANOSECONDS_PER_SECOND, precision);
    return `${second_of_day / 3600:02}:${second_of_day % 3600 / 60:02}:${second_of_day % 60:02}${fraction}`;
}

/// Temporal's `ISODateTimeToString` without a calendar annotation.
fn format_date_time(days: i64, time_of_day: i64, precision: i32) -> String {
    return `${format_iso_date(&iso_date_from_epoch_days(days))}T${format_time_of_day(time_of_day, precision)}`;
}

/// Temporal's `FormatFractionalSeconds`: `precision` digits, truncating, or
/// with `-1` (`auto`) as far as the last non-zero digit.
fn format_fraction(nanoseconds: i64, precision: i32) -> String {
    if precision == 0 || precision < 0 && nanoseconds == 0 {
        return "";
    }
    let digits = `${nanoseconds:09}`;
    let mut length = precision;
    if precision < 0 {
        length = 9;
        while digits.get_byte_unchecked(length - 1) == b'0' {
            length -= 1;
        }
    }
    return `.${digits.substr_bytes(0, length)}`;
}

// Parsing, as Temporal's ISO 8601 / RFC 9557 grammar reads each string.

/// What `ParseISODateTime` reads from a string: the fields a production
/// supplies, and what its offset and annotations say.
struct ParsedIso {
    year: i64 = 0,
    month: i64 = 1,
    day: i64 = 1,
    time_of_day: i64 = 0,
    has_time: bool = false,
    utc_designator: bool = false,
    /// The UTC offset in nanoseconds.
    offset: Option<i64> = null,
    offset_has_seconds: bool = false,
    zone: Option<String> = null,
    calendar: Option<String> = null,
    calendar_critical: bool = false,
}

/// The byte at `i`, or `0` past either end.
fn byte_at(text: &StrSlice, i: i32) -> u8 {
    if i < 0 || i >= text.len() {
        return 0;
    }
    return text.get_byte_unchecked(i);
}

/// Index of the first `byte` in `text` at or after `from`, or `-1`.
fn index_of_byte(text: &StrSlice, byte: u8, from: i32) -> i32 {
    for let mut i = from; i < text.len(); i += 1 {
        if text.get_byte_unchecked(i) == byte {
            return i;
        }
    }
    return -1;
}

fn read_two_digits(text: &StrSlice, i: i32) -> Result<i64, DeserializeError> {
    let tens = byte_at(text, i);
    let ones = byte_at(text, i + 1);
    if !(tens.is_ascii_digit() && ones.is_ascii_digit()) {
        return Result::Err(DeserializeError::malformed("expected two digits", i as i64));
    }
    return Result::Ok((tens - b'0') as i64 * 10 + (ones - b'0') as i64);
}

/// The grammar's `DateYear` at `i`: four digits, or a sign and six. `-000000`
/// is the one expanded year ISO 8601 forbids.
fn parse_iso_year(text: &StrSlice, i: i32) -> Result<[i64, i32], DeserializeError> {
    let sign = byte_at(text, i);
    if sign != b'+' && sign != b'-' {
        let high = read_two_digits(text, i)?;
        let low = read_two_digits(text, i + 2)?;
        return Result::Ok([high * 100 + low, i + 4]);
    }
    let mut magnitude: i64 = 0;
    for let mut k = 0; k < 6; k += 2 {
        magnitude = magnitude * 100 + read_two_digits(text, i + 1 + k)?;
    }
    if sign == b'-' {
        if magnitude == 0 {
            return Result::Err(DeserializeError::invalid_value("year -000000 is not an ISO 8601 year", i as i64));
        }
        return Result::Ok([-magnitude, i + 7]);
    }
    return Result::Ok([magnitude, i + 7]);
}

/// The grammar's `DateSpec`, extended or basic, which must name a real date.
fn parse_date(text: &StrSlice, start: i32, p: &mut ParsedIso) -> Result<i32, DeserializeError> {
    let [year, after_year] = parse_iso_year(text, start)?;
    let extended = byte_at(text, after_year) == b'-';
    let mut i = if extended { after_year + 1 } else { after_year };
    let month = read_two_digits(text, i)?;
    i += 2;
    if extended {
        if byte_at(text, i) != b'-' {
            return Result::Err(DeserializeError::malformed("expected '-'", i as i64));
        }
        i += 1;
    }
    let day = read_two_digits(text, i)?;
    if !is_valid_iso_date(year, month, day) {
        return Result::Err(DeserializeError::invalid_value("the date does not exist", start as i64));
    }
    p.year = year;
    p.month = month;
    p.day = day;
    return Result::Ok(i + 2);
}

/// The grammar's `DateSpecYearMonth`.
fn parse_year_month_spec(text: &StrSlice, p: &mut ParsedIso) -> Result<i32, DeserializeError> {
    let [year, after_year] = parse_iso_year(text, 0)?;
    let i = if byte_at(text, after_year) == b'-' { after_year + 1 } else { after_year };
    let month = read_two_digits(text, i)?;
    if !(1 <= month <= 12) {
        return Result::Err(DeserializeError::invalid_value("month out of range", i as i64));
    }
    p.year = year;
    p.month = month;
    return Result::Ok(i + 2);
}

/// The grammar's `DateSpecMonthDay`, which must name a day of a leap year.
fn parse_month_day_spec(text: &StrSlice, p: &mut ParsedIso) -> Result<i32, DeserializeError> {
    let mut i = 0;
    if byte_at(text, 0) == b'-' && byte_at(text, 1) == b'-' {
        i = 2;
    }
    let month = read_two_digits(text, i)?;
    i += 2;
    if byte_at(text, i) == b'-' {
        i += 1;
    }
    let day = read_two_digits(text, i)?;
    // A leap year is the yardstick: 02-29 is a real month-day.
    if !is_valid_iso_date(1972, month, day) {
        return Result::Err(DeserializeError::invalid_value("the month-day does not exist", i as i64));
    }
    p.month = month;
    p.day = day;
    return Result::Ok(i + 2);
}

/// The grammar's `Time`: an hour, then optionally minutes, then optionally
/// seconds and a fraction, all extended or all basic. A leap second reads as
/// `:59`, as Temporal constrains it.
fn parse_time(text: &StrSlice, start: i32, p: &mut ParsedIso) -> Result<i32, DeserializeError> {
    let clock = read_clock(text, start, true)?;
    if clock.hour > 23 || clock.minute > 59 || clock.second > 60 {
        return Result::Err(DeserializeError::invalid_value("the time does not exist", start as i64));
    }
    let constrained_second = if clock.second == 60 { 59 } else { clock.second };
    p.time_of_day = ((clock.hour * 60 + clock.minute) * 60 + constrained_second) * NANOSECONDS_PER_SECOND + clock.fraction;
    p.has_time = true;
    return Result::Ok(clock.end);
}

/// What `read_clock` reads, not yet range-checked.
struct ClockReading {
    hour: i64,
    minute: i64 = 0,
    second: i64 = 0,
    /// The fraction of the second, in nanoseconds.
    fraction: i64 = 0,
    has_seconds: bool = false,
    /// The index just past the reading.
    end: i32,
}

/// An hour at `start`, then optionally minutes, then with `seconds` optionally
/// seconds and a fraction, all extended or all basic: the shape a time and a
/// UTC offset share.
fn read_clock(text: &StrSlice, start: i32, seconds: bool) -> Result<ClockReading, DeserializeError> {
    let mut clock = ClockReading { hour: read_two_digits(text, start)?, end: start + 2 };
    let extended = byte_at(text, clock.end) == b':';
    if !(extended || byte_at(text, clock.end).is_ascii_digit()) {
        return Result::Ok(clock);
    }
    let mut i = if extended { clock.end + 1 } else { clock.end };
    clock.minute = read_two_digits(text, i)?;
    i += 2;
    let more = if extended { byte_at(text, i) == b':' } else { byte_at(text, i).is_ascii_digit() };
    if seconds && more {
        if extended {
            i += 1;
        }
        clock.second = read_two_digits(text, i)?;
        let [fraction, after] = parse_time_fraction(text, i + 2)?;
        clock.fraction = fraction;
        clock.has_seconds = true;
        i = after;
    }
    clock.end = i;
    return Result::Ok(clock);
}

/// The grammar's optional `TimeFraction` at `i`: a `.` or `,` and one to nine
/// digits, as nanoseconds, with the index past it.
fn parse_time_fraction(text: &StrSlice, i: i32) -> Result<[i64, i32], DeserializeError> {
    let separator = byte_at(text, i);
    if separator != b'.' && separator != b',' {
        return Result::Ok([0, i]);
    }
    let mut j = i + 1;
    let mut value: i64 = 0;
    let mut scale: i64 = NANOSECONDS_PER_SECOND;
    while byte_at(text, j).is_ascii_digit() {
        if scale == 1 {
            return Result::Err(DeserializeError::malformed("more than nine fractional digits", j as i64));
        }
        scale /= 10;
        value += (byte_at(text, j) - b'0') as i64 * scale;
        j += 1;
    }
    if j == i + 1 {
        return Result::Err(DeserializeError::malformed("expected fractional digits after the separator", j as i64));
    }
    return Result::Ok([value, j]);
}

/// The grammar's `UTCOffset` at `start`, which the caller has seen holds a `+`
/// or `-`: that sign and an hour, then optionally
/// minutes, and with `sub_minute` seconds and a fraction, all extended or all
/// basic. Answers the offset in nanoseconds, the index past it, and whether it
/// carried seconds.
fn parse_utc_offset(text: &StrSlice, start: i32, sub_minute: bool) -> Result<[i64, i32, bool], DeserializeError> {
    let sign = byte_at(text, start);
    let clock = read_clock(text, start + 1, sub_minute)?;
    if clock.hour > 23 || clock.minute > 59 || clock.second > 59 {
        return Result::Err(DeserializeError::invalid_value("the UTC offset is out of range", start as i64));
    }
    let magnitude = ((clock.hour * 60 + clock.minute) * 60 + clock.second) * NANOSECONDS_PER_SECOND + clock.fraction;
    return Result::Ok([if sign == b'-' { -magnitude } else { magnitude }, clock.end, clock.has_seconds]);
}

/// The grammar's optional `DateTimeUTCOffset` at `i`; `Z` only with `allow_z`.
fn parse_offset_part(text: &StrSlice, i: i32, p: &mut ParsedIso, allow_z: bool) -> Result<i32, DeserializeError> {
    let b = byte_at(text, i);
    if b == b'Z' || b == b'z' {
        if !allow_z {
            return Result::Err(DeserializeError::malformed(
                "Z names an exact time, which this type has no reading of",
                i as i64,
            ));
        }
        p.utc_designator = true;
        return Result::Ok(i + 1);
    }
    if b == b'+' || b == b'-' {
        let [offset, end, has_seconds] = parse_utc_offset(text, i, true)?;
        p.offset = Option::Some(offset);
        p.offset_has_seconds = has_seconds;
        return Result::Ok(end);
    }
    return Result::Ok(i);
}

/// The grammar's `DateTime`: a date, then optionally a separator, a time, and
/// an offset. Answers the index where the annotations begin.
fn parse_date_time_prefix(
    text: &StrSlice,
    p: &mut ParsedIso,
    allow_z: bool,
    require_time: bool,
    require_offset: bool,
) -> Result<i32, DeserializeError> {
    let mut i = parse_date(text, 0, p)?;
    let separator = byte_at(text, i);
    if (separator == b'T' || separator == b't' || separator == b' ') && byte_at(text, i + 1).is_ascii_digit() {
        i = parse_time(text, i + 1, p)?;
        i = parse_offset_part(text, i, p, allow_z)?;
    }
    if require_time && !p.has_time {
        return Result::Err(DeserializeError::malformed("expected a time", i as i64));
    }
    if require_offset && !p.utc_designator && p.offset matches { None } {
        return Result::Err(DeserializeError::malformed("expected Z or a UTC offset", i as i64));
    }
    return Result::Ok(i);
}

/// The grammar's `TimeZoneAnnotation` and `Annotations` from `start`, which
/// must run to the end. A zone comes first; the first `u-ca` names the
/// calendar, and a second one where either is critical is an error, as is any
/// other critical key.
fn parse_annotations(text: &StrSlice, start: i32, p: &mut ParsedIso) -> Result<(), DeserializeError> {
    let mut i = start;
    let mut any = false;
    while byte_at(text, i) == b'[' {
        let close = index_of_byte(text, b']', i + 1);
        if close < 0 {
            return Result::Err(DeserializeError::malformed("unterminated annotation", i as i64));
        }
        let critical = byte_at(text, i + 1) == b'!';
        let content = text.slice(if critical { i + 2 } else { i + 1 }, close);
        let equals = index_of_byte(&content, b'=', 0);
        if equals < 0 {
            if any || !is_time_zone_identifier(&content) {
                return Result::Err(DeserializeError::malformed("expected a time zone annotation first", i as i64));
            }
            p.zone = Option::Some(content.to_string());
        } else {
            let key = content.slice(0, equals);
            let value = content.slice(equals + 1, content.len());
            if !is_annotation_key(&key) || !is_annotation_value(&value) {
                return Result::Err(DeserializeError::malformed("malformed annotation", i as i64));
            }
            if key == "u-ca" {
                if p.calendar matches { None } {
                    p.calendar = Option::Some(value.to_string());
                    p.calendar_critical = critical;
                } else if critical || p.calendar_critical {
                    return Result::Err(DeserializeError::invalid_value("conflicting calendar annotations", i as i64));
                }
            } else if critical {
                return Result::Err(
                    DeserializeError::invalid_value("an unknown annotation is marked critical", i as i64),
                );
            }
        }
        any = true;
        i = close + 1;
    }
    if i != text.len() {
        return Result::Err(DeserializeError::malformed("trailing characters", i as i64));
    }
    return Result::Ok(());
}

/// The grammar's `TimeZoneIdentifier`: a minute-precision offset or an IANA
/// name, available or not.
fn is_time_zone_identifier(text: &StrSlice) -> bool {
    let first = byte_at(text, 0);
    if first == b'+' || first == b'-' {
        return parse_utc_offset(text, 0, false) matches { Ok([_, end, _]) && end == text.len() };
    }
    return is_iana_name(text);
}

/// The grammar's `AnnotationKey`: a lowercase letter or `_`, then lowercase
/// letters, digits, `_`, and `-`.
fn is_annotation_key(key: &StrSlice) -> bool {
    if key.len() == 0 {
        return false;
    }
    for let mut i = 0; i < key.len(); i += 1 {
        let b = key.get_byte_unchecked(i);
        let leading = b.is_ascii_lowercase() || b == b'_';
        if !(leading || i > 0 && (b.is_ascii_digit() || b == b'-')) {
            return false;
        }
    }
    return true;
}

/// The grammar's `AnnotationValue`: alphanumeric components joined by `-`.
fn is_annotation_value(value: &StrSlice) -> bool {
    let mut component_length = 0;
    for let mut i = 0; i < value.len(); i += 1 {
        let b = value.get_byte_unchecked(i);
        if b == b'-' {
            if component_length == 0 {
                return false;
            }
            component_length = 0;
        } else if b.is_ascii_alphanumeric() {
            component_length += 1;
        } else {
            return false;
        }
    }
    return component_length > 0;
}

/// Temporal's `TemporalInstantString`.
fn parse_instant_string(text: &StrSlice) -> Result<ParsedIso, DeserializeError> {
    let mut p = ParsedIso {};
    let i = parse_date_time_prefix(text, &mut p, true, true, true)?;
    parse_annotations(text, i, &mut p)?;
    return Result::Ok(p);
}

/// Temporal's `TemporalDateTimeString[+Zoned]`, whose zone annotation is
/// required.
fn parse_zoned_string(text: &StrSlice) -> Result<ParsedIso, DeserializeError> {
    let mut p = ParsedIso {};
    let i = parse_date_time_prefix(text, &mut p, true, false, false)?;
    parse_annotations(text, i, &mut p)?;
    if p.zone matches { None } {
        return Result::Err(DeserializeError::malformed("expected a time zone annotation", i as i64));
    }
    return Result::Ok(p);
}

/// Temporal's `TemporalDateTimeString[~Zoned]`, which takes no `Z`.
fn parse_date_time_string(text: &StrSlice, require_time: bool) -> Result<ParsedIso, DeserializeError> {
    let mut p = ParsedIso {};
    let i = parse_date_time_prefix(text, &mut p, false, require_time, false)?;
    parse_annotations(text, i, &mut p)?;
    return Result::Ok(p);
}

/// Temporal's `TemporalTimeString`: a time with an optional `T`, or a
/// date-time with a time. Without the `T`, text that also reads as a
/// month-day or a year-month is refused as ambiguous.
fn parse_time_string(text: &StrSlice) -> Result<ParsedIso, DeserializeError> {
    let mut p = ParsedIso {};
    let designated = byte_at(text, 0) == b'T' || byte_at(text, 0) == b't';
    if !designated {
        if let Ok(parsed) = parse_date_time_string(text, true) {
            return Result::Ok(parsed);
        }
    }
    let start = if designated { 1 } else { 0 };
    let after_time = parse_time(text, start, &mut p)?;
    let i = parse_offset_part(text, after_time, &mut p, false)?;
    if !designated {
        let lead = text.slice(0, i);
        let mut scratch = ParsedIso {};
        let month_day = parse_month_day_spec(&lead, &mut scratch) matches { Ok(end) && end == i };
        let year_month = parse_year_month_spec(&lead, &mut scratch) matches { Ok(end) && end == i };
        if month_day || year_month {
            return Result::Err(DeserializeError::malformed("ambiguous without a T: it also reads as a date", 0));
        }
    }
    parse_annotations(text, i, &mut p)?;
    return Result::Ok(p);
}

/// Temporal's `TemporalYearMonthString`.
fn parse_year_month_string(text: &StrSlice) -> Result<ParsedIso, DeserializeError> {
    let mut p = ParsedIso {};
    if let Ok(i) = parse_year_month_spec(text, &mut p) {
        if parse_annotations(text, i, &mut p) matches { Ok(_) } {
            return Result::Ok(p);
        }
    }
    return parse_date_time_string(text, false);
}

/// Temporal's `TemporalMonthDayString`.
fn parse_month_day_string(text: &StrSlice) -> Result<ParsedIso, DeserializeError> {
    let mut p = ParsedIso {};
    if let Ok(i) = parse_month_day_spec(text, &mut p) {
        if parse_annotations(text, i, &mut p) matches { Ok(_) } {
            return Result::Ok(p);
        }
    }
    return parse_date_time_string(text, false);
}

/// Every production `ParseTemporalTimeZoneString` tries on a string that is not
/// a time zone identifier itself.
fn parse_any_iso_string(text: &StrSlice) -> Result<ParsedIso, DeserializeError> {
    if let Ok(p) = parse_zoned_string(text) {
        return Result::Ok(p);
    }
    if let Ok(p) = parse_instant_string(text) {
        return Result::Ok(p);
    }
    if let Ok(p) = parse_date_time_string(text, false) {
        return Result::Ok(p);
    }
    if let Ok(p) = parse_time_string(text) {
        return Result::Ok(p);
    }
    if let Ok(p) = parse_month_day_string(text) {
        return Result::Ok(p);
    }
    return parse_year_month_string(text);
}

/// The calendar annotation, if any, must name ISO 8601, the only calendar here.
fn require_iso_calendar(p: &ParsedIso) -> Result<(), DeserializeError> {
    if let Some(calendar) = p.calendar {
        if !calendar.eq_ignore_ascii_case("iso8601") {
            return Result::Err(DeserializeError::invalid_value(
                `calendar "${calendar}" is not supported; only iso8601 is`,
            ));
        }
    }
    return Result::Ok(());
}

fn out_of_range_date() -> DeserializeError {
    return DeserializeError::invalid_value("the date is outside the range of 10^8 days either side of the epoch");
}

// HTTP-date (RFC 7231 §7.1.1.1).

/// English weekday abbreviations, Monday first, as RFC 7231 spells them.
fn imf_weekday_name(day_of_week: i64) -> String {
    return match day_of_week {
        1 => "Mon",
        2 => "Tue",
        3 => "Wed",
        4 => "Thu",
        5 => "Fri",
        6 => "Sat",
        _ => "Sun",
    };
}

/// English weekday names, Monday first, as RFC 850 spells them.
fn imf_long_weekday_name(day_of_week: i64) -> String {
    return match day_of_week {
        1 => "Monday",
        2 => "Tuesday",
        3 => "Wednesday",
        4 => "Thursday",
        5 => "Friday",
        6 => "Saturday",
        _ => "Sunday",
    };
}

/// English month abbreviations, as RFC 7231 spells them.
fn imf_month_name(month: i64) -> String {
    return match month {
        1 => "Jan",
        2 => "Feb",
        3 => "Mar",
        4 => "Apr",
        5 => "May",
        6 => "Jun",
        7 => "Jul",
        8 => "Aug",
        9 => "Sep",
        10 => "Oct",
        11 => "Nov",
        _ => "Dec",
    };
}

/// Whether `name` is one of RFC 7231's `day-name`s, or with `long` its
/// `day-name-l`s.
fn is_weekday_name(name: &StrSlice, long: bool) -> bool {
    for let mut day: i64 = 1; day <= 7; day += 1 {
        let candidate = if long { imf_long_weekday_name(day) } else { imf_weekday_name(day) };
        if name == candidate {
            return true;
        }
    }
    return false;
}

/// `"Sun, 06 Nov 1994 08:49:37 GMT"`.
fn parse_imf_fixdate(text: &StrSlice, comma: i32) -> Result<Instant, DeserializeError> {
    if !is_weekday_name(&text.slice(0, comma), false) {
        return Result::Err(DeserializeError::malformed("expected a weekday name", 0));
    }
    let mut i = comma + 1;
    i = expect_byte(text, i, b' ')?;
    let day = read_two_digits(text, i)?;
    i = expect_byte(text, i + 2, b' ')?;
    let month = read_month_name(text, i)?;
    i = expect_byte(text, i + 3, b' ')?;
    let [year, _] = parse_iso_year(text, i)?;
    i = expect_byte(text, i + 4, b' ')?;
    let [second_of_day, after] = read_clock_time(text, i)?;
    expect_gmt(text, after)?;
    return civil_instant(year, month, day, second_of_day, after);
}

/// The obsolete `"Sunday, 06-Nov-94 08:49:37 GMT"`. RFC 7231 asks that a
/// two-digit year more than 50 years ahead be read as the past year with those
/// digits; with no clock to compare against, this pivots at 70 — `70..=99` is
/// 1970s onward, `00..=69` is 2000s onward.
fn parse_rfc850_date(text: &StrSlice, comma: i32) -> Result<Instant, DeserializeError> {
    if !is_weekday_name(&text.slice(0, comma), true) {
        return Result::Err(DeserializeError::malformed("expected a weekday name", 0));
    }
    let mut i = comma + 1;
    i = expect_byte(text, i, b' ')?;
    let day = read_two_digits(text, i)?;
    // Past the `-` that `parse_http_date` chose this form on.
    i += 3;
    let month = read_month_name(text, i)?;
    i = expect_byte(text, i + 3, b'-')?;
    let two_digit_year = read_two_digits(text, i)?;
    let year = if two_digit_year >= 70 { 1900 + two_digit_year } else { 2000 + two_digit_year };
    i = expect_byte(text, i + 2, b' ')?;
    let [second_of_day, after] = read_clock_time(text, i)?;
    expect_gmt(text, after)?;
    return civil_instant(year, month, day, second_of_day, after);
}

/// The obsolete `"Sun Nov  6 08:49:37 1994"`. Fixed width at 24, with the day
/// space-padded rather than zero-padded.
fn parse_asctime(text: &StrSlice) -> Result<Instant, DeserializeError> {
    if text.len() != 24 || !is_weekday_name(&text.slice(0, 3), false) {
        return Result::Err(DeserializeError::malformed("expected an HTTP-date"));
    }
    expect_byte(text, 3, b' ')?;
    let month = read_month_name(text, 4)?;
    expect_byte(text, 7, b' ')?;
    let mut day: i64 = 0;
    if byte_at(text, 8) == b' ' && byte_at(text, 9).is_ascii_digit() {
        day = (byte_at(text, 9) - b'0') as i64;
    } else {
        day = read_two_digits(text, 8)?;
    }
    expect_byte(text, 10, b' ')?;
    let [second_of_day, after] = read_clock_time(text, 11)?;
    expect_byte(text, after, b' ')?;
    let [year, _] = parse_iso_year(text, 20)?;
    return civil_instant(year, month, day, second_of_day, 0);
}

/// Require byte `byte` at index `i` of `text`, returning the next index.
fn expect_byte(text: &StrSlice, i: i32, byte: u8) -> Result<i32, DeserializeError> {
    if byte_at(text, i) != byte {
        return Result::Err(DeserializeError::malformed(`expected '${byte as char}'`, i as i64));
    }
    return Result::Ok(i + 1);
}

/// Read `hh:mm:ss` at `i`, returning the second of the day and the index just
/// past it. A leap second reads as `:59`.
fn read_clock_time(text: &StrSlice, i: i32) -> Result<[i64, i32], DeserializeError> {
    let hour = read_two_digits(text, i)?;
    let mut j = expect_byte(text, i + 2, b':')?;
    let minute = read_two_digits(text, j)?;
    j = expect_byte(text, j + 2, b':')?;
    let second = read_two_digits(text, j)?;
    if hour > 23 || minute > 59 || second > 60 {
        return Result::Err(DeserializeError::invalid_value("clock time out of range", i as i64));
    }
    let constrained_second = if second == 60 { 59 } else { second };
    return Result::Ok([hour * 3600 + minute * 60 + constrained_second, j + 2]);
}

/// Read a three-letter English month abbreviation at `i`.
fn read_month_name(text: &StrSlice, i: i32) -> Result<i64, DeserializeError> {
    if i + 3 <= text.len() {
        let name = text.slice(i, i + 3);
        for let mut month: i64 = 1; month <= 12; month += 1 {
            if name == imf_month_name(month) {
                return Result::Ok(month);
            }
        }
    }
    return Result::Err(DeserializeError::malformed("expected a month name", i as i64));
}

/// Require the trailing `GMT` an HTTP-date's two dated forms end with.
fn expect_gmt(text: &StrSlice, i: i32) -> Result<(), DeserializeError> {
    let mut j = expect_byte(text, i, b' ')?;
    j = expect_byte(text, j, b'G')?;
    j = expect_byte(text, j, b'M')?;
    j = expect_byte(text, j, b'T')?;
    if j != text.len() {
        return Result::Err(DeserializeError::malformed("trailing characters", j as i64));
    }
    return Result::Ok(());
}

/// A UTC instant from range-checked civil fields.
fn civil_instant(year: i64, month: i64, day: i64, second_of_day: i64, offset: i32) -> Result<Instant, DeserializeError> {
    if !is_valid_iso_date(year, month, day) {
        return Result::Err(DeserializeError::invalid_value("day out of range", offset as i64));
    }
    return Result::Ok(Instant {
        seconds: epoch_days_of(year, month, day) * SECONDS_PER_DAY + second_of_day,
        nanoseconds: 0,
    });
}

// The plain (zoneless) family. Wado's literal spread is Temporal's `with`:
// `PlainDate { ..d, day: 1 }` replaces one component and keeps the rest. It does
// not constrain, so use `constrain` where the result may fall off a month's end;
// the next operation traps on a date that does not exist.

/// A calendar date with no time and no zone. Corresponds to
/// `Temporal.PlainDate`, over Temporal's range: -271821-04-19 through
/// +275760-09-13. `Ord` is auto-derived over year, month, day and so orders
/// chronologically.
pub struct PlainDate {
    pub year: i32,
    pub month: i32,
    pub day: i32,
}

impl Eq for PlainDate;
impl Ord for PlainDate;

/// A wall-clock time with no date and no zone. Corresponds to
/// `Temporal.PlainTime`. `Ord` is auto-derived over the components in
/// descending significance and so orders chronologically within a day.
pub struct PlainTime {
    pub hour: i32 = 0,
    pub minute: i32 = 0,
    pub second: i32 = 0,
    pub millisecond: i32 = 0,
    pub microsecond: i32 = 0,
    pub nanosecond: i32 = 0,
}

impl Eq for PlainTime;
impl Ord for PlainTime;

/// A date and a wall-clock time with no zone, and so no instant — the pair
/// still names a different moment in every zone. Corresponds to
/// `Temporal.PlainDateTime`, over the instant range widened by a day either
/// side, exclusive.
pub struct PlainDateTime {
    pub date: PlainDate,
    pub time: PlainTime,
}

impl Eq for PlainDateTime;
impl Ord for PlainDateTime;

/// A month of a particular year, with no day — a credit-card expiry, a billing
/// period. Corresponds to `Temporal.PlainYearMonth`, over -271821-04 through
/// +275760-09.
pub struct PlainYearMonth {
    pub year: i32,
    pub month: i32,
}

impl Eq for PlainYearMonth;
impl Ord for PlainYearMonth;

/// A day of a month with no year — a birthday, an anniversary. Corresponds to
/// `Temporal.PlainMonthDay`. February 29 is representable; landing it on a year
/// is `to_plain_date`'s problem.
pub struct PlainMonthDay {
    pub month: i32,
    pub day: i32,
}

impl Eq for PlainMonthDay;
impl Ord for PlainMonthDay;

impl PlainDate {
    /// A date, which must exist in the ISO 8601 calendar and be in range; it
    /// traps otherwise. Use `constrain` to clamp a day past the month's end
    /// instead, or `from_str` for input that may be malformed.
    pub fn new(year: i32, month: i32, day: i32) -> PlainDate {
        return PlainDate { year: year, month: month, day: day }.checked();
    }

    /// A date with `month` clamped to `1..=12` and `day` to that month's
    /// length — Temporal's `constrain` overflow. Traps outside the range.
    pub fn constrain(year: i32, month: i32, day: i32) -> PlainDate {
        let clamped_month = i32::clamp(month, 1, 12);
        let length = iso_days_in_month(year as i64, clamped_month as i64) as i32;
        return PlainDate::new(year, clamped_month, i32::clamp(day, 1, length));
    }

    /// The date `days` after the Unix epoch. Traps outside the range.
    pub fn from_epoch_days(days: i64) -> PlainDate {
        if !iso_date_within_limits(days) {
            panic("core:temporal: the date is outside the range of 10^8 days either side of the epoch");
        }
        return PlainDate::from_iso_date(iso_date_from_epoch_days(days));
    }

    /// Days since 1970-01-01, negative before it.
    pub fn epoch_days(&self) -> i64 {
        let d = self.checked();
        return epoch_days_of(d.year as i64, d.month as i64, d.day as i64);
    }

    /// Day of the week, `1` (Monday) through `7` (Sunday), per ISO 8601.
    pub fn day_of_week(&self) -> i32 {
        return day_of_week_of(self.epoch_days()) as i32;
    }

    /// Day of the year, `1..=366`.
    pub fn day_of_year(&self) -> i32 {
        return (self.epoch_days() - epoch_days_of(self.year as i64, 1, 1) + 1) as i32;
    }

    /// ISO 8601 week of the week-year, `1..=53`.
    pub fn week_of_year(&self) -> i32 {
        let [week, _] = iso_week_date(self.year as i64, self.day_of_year() as i64, self.day_of_week() as i64);
        return week as i32;
    }

    /// ISO 8601 week-numbering year, which differs from `year` in the days at
    /// either end of the year that belong to the neighbour's week.
    pub fn year_of_week(&self) -> i32 {
        let [_, week_year] = iso_week_date(self.year as i64, self.day_of_year() as i64, self.day_of_week() as i64);
        return week_year as i32;
    }

    /// Number of days in this week — always `7` for ISO 8601.
    pub fn days_in_week(&self) -> i32 {
        let _ = self.checked();
        return 7;
    }

    /// Number of days in this month, `28..=31`.
    pub fn days_in_month(&self) -> i32 {
        let d = self.checked();
        return iso_days_in_month(d.year as i64, d.month as i64) as i32;
    }

    /// Number of days in this year, `365` or `366`.
    pub fn days_in_year(&self) -> i32 {
        return if self.in_leap_year() { 366 } else { 365 };
    }

    /// Number of months in this year — always `12` for ISO 8601.
    pub fn months_in_year(&self) -> i32 {
        let _ = self.checked();
        return 12;
    }

    /// Whether this year is a leap year in the ISO 8601 calendar.
    pub fn in_leap_year(&self) -> bool {
        return is_leap_year(self.checked().year as i64);
    }

    /// Temporal month code, `"M01"` … `"M12"`.
    pub fn month_code(&self) -> String {
        return month_code_of(self.checked().month);
    }

    /// Move forward by `duration` (Temporal's `AddDurationToDate`): the time
    /// components fold into whole days, truncated, and a month-end overflow is
    /// constrained to the month's last day. Traps outside the range.
    pub fn add(&self, duration: &Duration) -> PlainDate {
        let date = self.checked();
        let d = duration.validated();
        let days = d.time_with_days().seconds / SECONDS_PER_DAY;
        let date_duration = Duration { years: d.years, months: d.months, weeks: d.weeks, days: days };
        return PlainDate::from_epoch_days(calendar_date_add(&date.iso_date(), &date_duration));
    }

    /// Move back by `duration`. Not the inverse of `add` when a month-end is
    /// constrained on the way out.
    pub fn subtract(&self, duration: &Duration) -> PlainDate {
        return self.add(&duration.negated());
    }

    /// The span from this date to `other`, positive when `other` is later.
    /// `largest_unit` must be a date unit; Temporal's default is the day.
    pub fn until(&self, other: &PlainDate, largest_unit: Unit = Unit::Day) -> Duration {
        let one = self.checked();
        let two = other.checked();
        if !is_date_unit(largest_unit) {
            panic("core:temporal: a PlainDate difference is measured in days and above");
        }
        return calendar_date_until(&one.iso_date(), &two.iso_date(), largest_unit).validated();
    }

    /// The span from `other` to this date — `until` with the sign flipped.
    pub fn since(&self, other: &PlainDate, largest_unit: Unit = Unit::Day) -> Duration {
        return self.until(other, largest_unit).negated();
    }

    /// Drop the day.
    pub fn to_plain_year_month(&self) -> PlainYearMonth {
        let d = self.checked();
        return PlainYearMonth::new(d.year, d.month);
    }

    /// Drop the year.
    pub fn to_plain_month_day(&self) -> PlainMonthDay {
        let d = self.checked();
        return PlainMonthDay { month: d.month, day: d.day };
    }

    /// Pair this date with a wall-clock time.
    pub fn to_plain_date_time(&self, time: PlainTime = PlainTime {}) -> PlainDateTime {
        return PlainDateTime::new(*self, time);
    }

    /// Read this date at `time` in `time_zone`, which resolves it to an
    /// instant. The zone is read as `Instant::to_zoned_date_time` reads it.
    pub fn to_zoned_date_time<S: AsStrSlice>(&self, time_zone: S, time: PlainTime = PlainTime {}) -> ZonedDateTime {
        return self.to_plain_date_time(time).to_zoned_date_time(time_zone);
    }

    /// Temporal's `toString`: `YYYY-MM-DD`, with a sign and six digits where
    /// the year does not fit four.
    pub fn to_iso8601(&self) -> String {
        return format_iso_date(&self.checked().iso_date());
    }

    /// A date known to exist and to be in range.
    fn from_iso_date(date: IsoDate) -> PlainDate {
        return PlainDate { year: date.year as i32, month: date.month as i32, day: date.day as i32 };
    }

    fn iso_date(&self) -> IsoDate {
        return IsoDate { year: self.year as i64, month: self.month as i64, day: self.day as i64 };
    }

    /// Trap unless the date exists and is in range, the check a struct literal
    /// skips.
    fn checked(&self) -> PlainDate {
        let d = self.iso_date();
        if !is_valid_iso_date(d.year, d.month, d.day)
            || !iso_date_within_limits(epoch_days_of(d.year, d.month, d.day)) {
            panic(`core:temporal: ${self:?} is not a date within Temporal's range`);
        }
        return *self;
    }
}

impl Display for PlainDate {
    fn fmt(&self, f: &mut Formatter) {
        f.pad(self.to_iso8601());
    }
}

impl PlainTime {
    /// A wall-clock time, which traps out of range. Every component defaults
    /// to zero, so `PlainTime { hour: 9 }` is 09:00:00.
    pub fn new(
        hour: i32,
        minute: i32,
        second: i32 = 0,
        millisecond: i32 = 0,
        microsecond: i32 = 0,
        nanosecond: i32 = 0,
    ) -> PlainTime {
        return PlainTime {
            hour: hour,
            minute: minute,
            second: second,
            millisecond: millisecond,
            microsecond: microsecond,
            nanosecond: nanosecond,
        }.checked();
    }

    /// Whether every component is in the range the ISO 8601 clock allows.
    pub fn is_valid(&self) -> bool {
        return 0 <= self.hour <= 23
            && 0 <= self.minute <= 59
            && 0 <= self.second <= 59
            && 0 <= self.millisecond <= 999
            && 0 <= self.microsecond <= 999
            && 0 <= self.nanosecond <= 999;
    }

    /// Nanoseconds since midnight, `0..<86_400_000_000_000`.
    pub fn nanoseconds_since_midnight(&self) -> i64 {
        let t = self.checked();
        return ((t.hour as i64 * 60 + t.minute as i64) * 60 + t.second as i64) * NANOSECONDS_PER_SECOND + t.millisecond as i64 * 1_000_000 + t.microsecond as i64 * 1000 + t.nanosecond as i64;
    }

    /// The time `nanoseconds` after midnight, wrapping into `0..<24h` so a
    /// negative or overflowing count lands on the same clock reading a day's
    /// worth of turning would.
    pub fn from_nanoseconds_since_midnight(nanoseconds: i64) -> PlainTime {
        let within_day = floor_mod(nanoseconds, NANOSECONDS_PER_DAY);
        return PlainTime {
            hour: (within_day / 3_600_000_000_000) as i32,
            minute: (within_day / 60_000_000_000 % 60) as i32,
            second: (within_day / NANOSECONDS_PER_SECOND % 60) as i32,
            millisecond: (within_day / 1_000_000 % 1000) as i32,
            microsecond: (within_day / 1000 % 1000) as i32,
            nanosecond: (within_day % 1000) as i32,
        };
    }

    /// Move forward by `duration`'s time components, wrapping around midnight
    /// (Temporal's `AddDurationToTime`). The date components, days included,
    /// do not move a clock.
    pub fn add(&self, duration: &Duration) -> PlainTime {
        let start = self.nanoseconds_since_midnight();
        let [_, time_of_day] = add_time(start, duration.validated().time_part());
        return PlainTime::from_nanoseconds_since_midnight(time_of_day);
    }

    /// Move back by `duration`, wrapping the same way.
    pub fn subtract(&self, duration: &Duration) -> PlainTime {
        return self.add(&duration.negated());
    }

    /// The span from this time to `other` within one day, positive when
    /// `other` is later on the clock. `largest_unit` must be a time unit;
    /// Temporal's default is the hour.
    pub fn until(&self, other: &PlainTime, largest_unit: Unit = Unit::Hour) -> Duration {
        let start = self.nanoseconds_since_midnight();
        let end = other.nanoseconds_since_midnight();
        if is_date_unit(largest_unit) {
            panic("core:temporal: a PlainTime difference is measured in hours and below");
        }
        return duration_from_internal(&Duration {}, time_duration(0, end - start), largest_unit);
    }

    /// The span from `other` to this time — `until` with the sign flipped.
    pub fn since(&self, other: &PlainTime, largest_unit: Unit = Unit::Hour) -> Duration {
        return self.until(other, largest_unit).negated();
    }

    /// Round to a multiple of `increment` units, measured within the next
    /// larger unit as Temporal's `RoundTime` does, and wrapping at the end of
    /// the day. The increment must divide the next unit.
    pub fn round(
        &self,
        smallest_unit: Unit,
        increment: i64 = 1,
        mode: RoundingMode = RoundingMode::HalfExpand,
    ) -> PlainTime {
        let start = self.nanoseconds_since_midnight();
        if is_date_unit(smallest_unit) {
            panic("core:temporal: a PlainTime rounds to hours and below");
        }
        validate_rounding_increment(increment, maximum_rounding_increment(smallest_unit), false);
        let [_, rounded] = round_time(start, increment, smallest_unit, mode);
        return PlainTime::from_nanoseconds_since_midnight(rounded);
    }

    /// Temporal's `toString`: `hh:mm:ss`, and the fraction as far as its last
    /// non-zero digit.
    pub fn to_iso8601(&self) -> String {
        return format_time_of_day(self.nanoseconds_since_midnight(), -1);
    }

    /// Trap unless every component is in range, the check a struct literal
    /// skips.
    fn checked(&self) -> PlainTime {
        if !self.is_valid() {
            panic(`core:temporal: ${self:?} is not a time of day`);
        }
        return *self;
    }
}

impl Display for PlainTime {
    fn fmt(&self, f: &mut Formatter) {
        f.pad(format_time_of_day(self.nanoseconds_since_midnight(), resolve_precision(f)));
    }
}

impl PlainDateTime {
    /// A date and time, which traps out of range.
    pub fn new(date: PlainDate, time: PlainTime = PlainTime {}) -> PlainDateTime {
        return PlainDateTime { date: date, time: time }.checked();
    }

    /// Move forward by `duration` (Temporal's `AddDurationToDateTime`): the
    /// days and time in exact time, carrying whole days into the date, then
    /// the years, months, and weeks with a month-end overflow constrained.
    pub fn add(&self, duration: &Duration) -> PlainDateTime {
        let [days, start] = self.parts();
        let d = duration.validated();
        let [carry, time_of_day] = add_time(start, d.time_with_days());
        let date_duration = Duration { years: d.years, months: d.months, weeks: d.weeks, days: carry };
        let added = calendar_date_add(&iso_date_from_epoch_days(days), &date_duration);
        return PlainDateTime::from_parts(added, time_of_day);
    }

    /// Move back by `duration`.
    pub fn subtract(&self, duration: &Duration) -> PlainDateTime {
        return self.add(&duration.negated());
    }

    /// The span from this value to `other`, positive when `other` is later
    /// (Temporal's `DifferenceISODateTime`). Temporal's default largest unit is
    /// the day.
    pub fn until(&self, other: &PlainDateTime, largest_unit: Unit = Unit::Day) -> Duration {
        let [start_days, start_time] = self.parts();
        let [end_days, end_time] = other.parts();
        if start_days == end_days && start_time == end_time {
            return Duration {};
        }
        let [date, time] = difference_iso_date_time(start_days, start_time, end_days, end_time, largest_unit);
        return duration_from_internal(&date, time, largest_unit);
    }

    /// The span from `other` to this value — `until` with the sign flipped.
    pub fn since(&self, other: &PlainDateTime, largest_unit: Unit = Unit::Day) -> Duration {
        return self.until(other, largest_unit).negated();
    }

    /// Round the clock to a multiple of `increment` units, measured within the
    /// next larger unit as Temporal's `RoundTime` does, carrying into the date.
    /// `Unit::Day` rounds to the nearest midnight and takes no increment but
    /// `1`.
    pub fn round(
        &self,
        smallest_unit: Unit,
        increment: i64 = 1,
        mode: RoundingMode = RoundingMode::HalfExpand,
    ) -> PlainDateTime {
        let [days, time_of_day] = self.parts();
        validate_time_or_day_rounding(smallest_unit, increment);
        let [carry, rounded] = round_time(time_of_day, increment, smallest_unit, mode);
        return PlainDateTime::from_parts(days + carry, rounded);
    }

    /// Read this reading in `time_zone`, which resolves it to an instant. The
    /// zone is read as `Instant::to_zoned_date_time` reads it.
    pub fn to_zoned_date_time<S: AsStrSlice>(&self, time_zone: S) -> ZonedDateTime {
        let [days, time_of_day] = self.parts();
        let zone = to_time_zone_identifier(time_zone);
        return ZonedDateTime { instant: local_instant(days, time_of_day, zone_offset_seconds(&zone)), time_zone: zone };
    }

    /// Temporal's `toString`: `YYYY-MM-DDThh:mm:ss`, and the fraction as far as
    /// its last non-zero digit.
    pub fn to_iso8601(&self) -> String {
        let [days, time_of_day] = self.parts();
        return format_date_time(days, time_of_day, -1);
    }

    /// The epoch day and the time of day, once the value is checked.
    fn parts(&self) -> [i64, i64] {
        let dt = self.checked();
        return [
            dt.date.epoch_days(),
            dt.time.nanoseconds_since_midnight(),
        ];
    }

    /// The reading at `time_of_day` on epoch day `days`, which traps out of
    /// range.
    fn from_parts(days: i64, time_of_day: i64) -> PlainDateTime {
        require_date_time_within_limits(days, time_of_day);
        return PlainDateTime {
            date: PlainDate::from_iso_date(iso_date_from_epoch_days(days)),
            time: PlainTime::from_nanoseconds_since_midnight(time_of_day),
        };
    }

    /// Trap unless both halves are valid and the pair is in range, the check a
    /// struct literal skips.
    fn checked(&self) -> PlainDateTime {
        let days = self.date.epoch_days();
        require_date_time_within_limits(days, self.time.nanoseconds_since_midnight());
        return *self;
    }
}

impl Display for PlainDateTime {
    fn fmt(&self, f: &mut Formatter) {
        let [days, time_of_day] = self.parts();
        f.pad(format_date_time(days, time_of_day, resolve_precision(f)));
    }
}

impl PlainYearMonth {
    /// A year and month, which traps out of range.
    pub fn new(year: i32, month: i32) -> PlainYearMonth {
        return PlainYearMonth { year: year, month: month }.checked();
    }

    /// Number of days in this month, `28..=31`.
    pub fn days_in_month(&self) -> i32 {
        let ym = self.checked();
        return iso_days_in_month(ym.year as i64, ym.month as i64) as i32;
    }

    /// Number of days in this year, `365` or `366`.
    pub fn days_in_year(&self) -> i32 {
        return if self.in_leap_year() { 366 } else { 365 };
    }

    /// Number of months in this year — always `12` for ISO 8601.
    pub fn months_in_year(&self) -> i32 {
        let _ = self.checked();
        return 12;
    }

    /// Whether this year is a leap year in the ISO 8601 calendar.
    pub fn in_leap_year(&self) -> bool {
        return is_leap_year(self.checked().year as i64);
    }

    /// Temporal month code, `"M01"` … `"M12"`.
    pub fn month_code(&self) -> String {
        return month_code_of(self.checked().month);
    }

    /// Move forward by `duration`'s years and months (Temporal's
    /// `AddDurationToYearMonth`), from the first of the month. Weeks, days,
    /// and time trap, as does a first of the month outside the date range.
    pub fn add(&self, duration: &Duration) -> PlainYearMonth {
        let first = self.first_day();
        let d = duration.validated();
        if d.weeks != 0 || d.days != 0 || d.time_part().sign() != 0 {
            panic("core:temporal: a PlainYearMonth moves in years and months only");
        }
        let added = iso_date_from_epoch_days(calendar_date_add(&first, &d.date_part()));
        return PlainYearMonth::new(added.year as i32, added.month as i32);
    }

    /// Move back by `duration`.
    pub fn subtract(&self, duration: &Duration) -> PlainYearMonth {
        return self.add(&duration.negated());
    }

    /// The span from this month to `other`, positive when `other` is later.
    /// `largest_unit` is `Year`, Temporal's default, or `Month`.
    pub fn until(&self, other: &PlainYearMonth, largest_unit: Unit = Unit::Year) -> Duration {
        let one = self.checked();
        let two = other.checked();
        if !largest_unit matches { Year | Month } {
            panic("core:temporal: a PlainYearMonth difference is measured in years or months");
        }
        if one == two {
            return Duration {};
        }
        // Temporal measures between the firsts of the months, which must both
        // be within the date range.
        let _ = one.first_day();
        let _ = two.first_day();
        let months = (two.year as i64 - one.year as i64) * 12 + two.month as i64 - one.month as i64;
        if largest_unit matches { Month } {
            return Duration { months: months };
        }
        return Duration { years: months / 12, months: months % 12 };
    }

    /// The span from `other` to this month — `until` with the sign flipped.
    pub fn since(&self, other: &PlainYearMonth, largest_unit: Unit = Unit::Year) -> Duration {
        return self.until(other, largest_unit).negated();
    }

    /// Land this month on a day, clamped to the month's length. Traps outside
    /// the date range.
    pub fn to_plain_date(&self, day: i32) -> PlainDate {
        let ym = self.checked();
        return PlainDate::constrain(ym.year, ym.month, day);
    }

    /// Temporal's `toString`: `YYYY-MM`.
    pub fn to_iso8601(&self) -> String {
        let ym = self.checked();
        return `${format_iso_year(ym.year as i64)}-${ym.month:02}`;
    }

    /// The first of the month, which Temporal's arithmetic starts from and
    /// which must be within the date range.
    fn first_day(&self) -> IsoDate {
        let ym = self.checked();
        if !iso_date_within_limits(epoch_days_of(ym.year as i64, ym.month as i64, 1)) {
            panic("core:temporal: the first of the month is outside the date range");
        }
        return IsoDate { year: ym.year as i64, month: ym.month as i64, day: 1 };
    }

    /// Trap unless the month exists and is in range, the check a struct
    /// literal skips.
    fn checked(&self) -> PlainYearMonth {
        if !(1 <= self.month <= 12) || !year_month_within_limits(self.year as i64, self.month as i64) {
            panic(`core:temporal: ${self:?} is not a year-month within Temporal's range`);
        }
        return *self;
    }
}

impl Display for PlainYearMonth {
    fn fmt(&self, f: &mut Formatter) {
        f.pad(self.to_iso8601());
    }
}

impl PlainMonthDay {
    /// A month and day, which must exist in some year — February 29 does, so
    /// it is accepted here and resolved by `to_plain_date`.
    pub fn new(month: i32, day: i32) -> PlainMonthDay {
        return PlainMonthDay { month: month, day: day }.checked();
    }

    /// Land this month-day in `year`, clamping February 29 to the 28th outside
    /// a leap year. Traps outside the date range.
    pub fn to_plain_date(&self, year: i32) -> PlainDate {
        let md = self.checked();
        return PlainDate::constrain(year, md.month, md.day);
    }

    /// Temporal month code, `"M01"` … `"M12"`.
    pub fn month_code(&self) -> String {
        return month_code_of(self.checked().month);
    }

    /// Temporal's `toString` under ISO 8601: `MM-DD`.
    pub fn to_iso8601(&self) -> String {
        let md = self.checked();
        return `${md.month:02}-${md.day:02}`;
    }

    /// Trap unless the month-day exists in a leap year, the check a struct
    /// literal skips.
    fn checked(&self) -> PlainMonthDay {
        if !is_valid_iso_date(1972, self.month as i64, self.day as i64) {
            panic(`core:temporal: ${self:?} is not a month-day`);
        }
        return *self;
    }
}

impl Display for PlainMonthDay {
    fn fmt(&self, f: &mut Formatter) {
        f.pad(self.to_iso8601());
    }
}

/// Reads Temporal's `TemporalDateTimeString` without a `Z`: a date, and any
/// time, offset, and annotations, which a date sets aside.
impl FromStr for PlainDate {
    type Err = DeserializeError;

    fn from_str<S: AsStrSlice>(s: S) -> Result<PlainDate, DeserializeError> {
        let view = s.as_str_slice();
        let p = parse_date_time_string(&view, false)?;
        require_iso_calendar(&p)?;
        if !iso_date_within_limits(epoch_days_of(p.year, p.month, p.day)) {
            return Result::Err(out_of_range_date());
        }
        return Result::Ok(PlainDate { year: p.year as i32, month: p.month as i32, day: p.day as i32 });
    }
}

/// Reads Temporal's `TemporalTimeString`: a time with an optional `T`, or a
/// date-time with a time, without a `Z`.
impl FromStr for PlainTime {
    type Err = DeserializeError;

    fn from_str<S: AsStrSlice>(s: S) -> Result<PlainTime, DeserializeError> {
        let view = s.as_str_slice();
        let p = parse_time_string(&view)?;
        require_iso_calendar(&p)?;
        return Result::Ok(PlainTime::from_nanoseconds_since_midnight(p.time_of_day));
    }
}

/// Reads Temporal's `TemporalDateTimeString` without a `Z`; a date alone is
/// its midnight.
impl FromStr for PlainDateTime {
    type Err = DeserializeError;

    fn from_str<S: AsStrSlice>(s: S) -> Result<PlainDateTime, DeserializeError> {
        let view = s.as_str_slice();
        let p = parse_date_time_string(&view, false)?;
        require_iso_calendar(&p)?;
        let days = epoch_days_of(p.year, p.month, p.day);
        if !date_time_within_limits(days, p.time_of_day) {
            return Result::Err(out_of_range_date());
        }
        return Result::Ok(PlainDateTime {
            date: PlainDate::from_iso_date(IsoDate { year: p.year, month: p.month, day: p.day }),
            time: PlainTime::from_nanoseconds_since_midnight(p.time_of_day),
        });
    }
}

/// Reads Temporal's `TemporalYearMonthString`: `YYYY-MM` or `YYYYMM`, or a
/// date-time without a `Z`.
impl FromStr for PlainYearMonth {
    type Err = DeserializeError;

    fn from_str<S: AsStrSlice>(s: S) -> Result<PlainYearMonth, DeserializeError> {
        let view = s.as_str_slice();
        let p = parse_year_month_string(&view)?;
        require_iso_calendar(&p)?;
        if !year_month_within_limits(p.year, p.month) {
            return Result::Err(out_of_range_date());
        }
        return Result::Ok(PlainYearMonth { year: p.year as i32, month: p.month as i32 });
    }
}

/// Reads Temporal's `TemporalMonthDayString`: `MM-DD`, `--MM-DD`, or their
/// basic forms, or a date-time without a `Z`.
impl FromStr for PlainMonthDay {
    type Err = DeserializeError;

    fn from_str<S: AsStrSlice>(s: S) -> Result<PlainMonthDay, DeserializeError> {
        let view = s.as_str_slice();
        let p = parse_month_day_string(&view)?;
        require_iso_calendar(&p)?;
        return Result::Ok(PlainMonthDay { month: p.month as i32, day: p.day as i32 });
    }
}

// The plain family goes over the wire as its Temporal string, the way
// Temporal's `toJSON` does, not as the field bag the structural derive would
// produce.

impl Serialize for PlainDate {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let text = self.to_iso8601();
        return s.serialize_string(&text);
    }
}

impl Deserialize for PlainDate {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<PlainDate, DeserializeError> {
        let text = d.deserialize_string()?;
        return PlainDate::from_str(text);
    }
}

impl Serialize for PlainTime {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let text = self.to_iso8601();
        return s.serialize_string(&text);
    }
}

impl Deserialize for PlainTime {
    fn deserialize<D: Deserializer>(d: &mut D) -> Result<PlainTime, DeserializeError> {
        let text = d.deserialize_string()?;
        return PlainTime::from_str(text);
    }
}

