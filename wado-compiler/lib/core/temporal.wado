        let total = self.time.nanoseconds_since_midnight() as i128 + duration.time_nanoseconds();
        let carried_days = floor_div_i128(total, 86_400_000_000_000);
        return PlainDateTime {
            date: PlainDate::from_epoch_days(shifted_date.epoch_days() + carried_days as i64),
            time: PlainTime::from_nanoseconds_since_midnight(
                (total - carried_days * 86_400_000_000_000) as i64,
            ),
        };
    }

