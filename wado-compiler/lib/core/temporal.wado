/// Parse `YYYY-MM-DD` at `start`, returning the date and the index just past it.
fn parse_iso_date(text: &String, start: i32, end: i32) -> Result<[PlainDate, i32], DeserializeError> {
    let [year, after_year] = parse_iso_year(text, start, end)?;
    let mut i = expect_byte(text, after_year, end, b'-')?;
    let month = read_digits(text, i, end, 2)?;
    if month < 1 || month > 12 {
        return Result::Err(DeserializeError::invalid_value("month out of range", i as i64));
    }
    i = expect_byte(text, i + 2, end, b'-')?;
    let day = read_digits(text, i, end, 2)?;
    if day < 1 || day > days_in_month_value(year, month) {
        return Result::Err(DeserializeError::invalid_value("day out of range", i as i64));
    }
    return Result::Ok([
        PlainDate { year: year as i32, month: month as i32, day: day as i32 },
        i + 2,
    ]);
}

/// Parse `hh:mm[:ss[.fraction]]` at `start`, returning the time and the index
/// just past it. A leap second is constrained to `:59`, as in a timestamp.
fn parse_iso_time(text: &String, start: i32, end: i32) -> Result<[PlainTime, i32], DeserializeError> {
    let hour = read_digits(text, start, end, 2)?;
    if hour > 23 {
        return Result::Err(DeserializeError::invalid_value("hour out of range", start as i64));
    }
    let mut i = expect_byte(text, start + 2, end, b':')?;
    let minute = read_digits(text, i, end, 2)?;
    if minute > 59 {
        return Result::Err(DeserializeError::invalid_value("minute out of range", i as i64));
    }
    i += 2;
    if i >= end || text.get_byte_unchecked(i) != b':' {
        return Result::Ok([
            PlainTime { hour: hour as i32, minute: minute as i32 },
            i,
        ]);
    }
    i += 1;
    let parsed_second = read_digits(text, i, end, 2)?;
    if parsed_second > 60 {
        return Result::Err(DeserializeError::invalid_value("second out of range", i as i64));
    }
    let second = if parsed_second == 60 { 59 } else { parsed_second };
    i += 2;
    let mut nanoseconds: i64 = 0;
    if i < end && text.get_byte_unchecked(i) == b'.' {
        let [fraction, after] = read_fraction_nanoseconds(text, i + 1, end)?;
        nanoseconds = fraction;
        i = after;
    }
    return Result::Ok([
        PlainTime {
            hour: hour as i32,
            minute: minute as i32,
            second: second as i32,
            millisecond: (nanoseconds / 1_000_000) as i32,
            microsecond: (nanoseconds / 1000 % 1000) as i32,
            nanosecond: (nanoseconds % 1000) as i32,
        },
        i,
    ]);
