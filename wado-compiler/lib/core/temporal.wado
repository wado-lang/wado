/// Clamp `value` into `low..=high`.
fn clamp_i32(value: i32, low: i32, high: i32) -> i32 {
    if value < low {
        return low;
    }
    if value > high {
        return high;
    }
    return value;
}

/// Quotient of `a` by positive `m`, flooring toward negative infinity.
fn floor_div_i128(a: i128, m: i128) -> i128 {
    let mut q = a / m;
    if a % m < 0 {
        q = q - 1;
    }
    return q;
}

