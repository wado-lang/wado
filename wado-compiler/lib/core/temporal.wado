    pub fn month_code(&self) -> String {
        return month_code_of(self.month);
    }

    /// Move forward by `duration`'s years and months. Smaller components trap:
    /// a year-month has no day to carry them.
    pub fn add(&self, duration: &Duration) -> PlainYearMonth {
        if duration.weeks != 0 || duration.days != 0 || duration.time_nanoseconds() != 0 {
            panic("core:temporal: a PlainYearMonth moves in years and months only");
        }
        let [year, month, _] = add_months_to_civil(
            self.year as i64,
            self.month as i64,
            1,
            duration.years * 12 + duration.months,
        );
        return PlainYearMonth { year: year as i32, month: month as i32 };
    }

    /// Move back by `duration`.
    pub fn subtract(&self, duration: &Duration) -> PlainYearMonth {
        return self.add(&duration.negated());
    }

    /// The span from this month to `other`, positive when `other` is later.
    pub fn until(&self, other: &PlainYearMonth, largest_unit: Unit = Unit::Year) -> Duration {
        let months = (other.year as i64 - self.year as i64) * 12 + (other.month as i64 - self.month as i64);
        if largest_unit matches { Month } {
            return Duration { months: months };
        }
        if largest_unit matches { Year } {
            return Duration { years: months / 12, months: months % 12 };
        }
        panic("core:temporal: a PlainYearMonth difference is measured in years or months");
    }

    /// The span from `other` to this month — `until` with the sign flipped.
    pub fn since(&self, other: &PlainYearMonth, largest_unit: Unit = Unit::Year) -> Duration {
        return self.until(other, largest_unit).negated();
    }

    /// Land this month on a day, clamped to the month's length.
    pub fn to_plain_date(&self, day: i32) -> PlainDate {
        return PlainDate::constrain(self.year, self.month, day);
    }

    /// `YYYY-MM`.
    pub fn to_iso8601(&self) -> String {
        return `${format_iso_year(self.year as i64)}-${self.month:02}`;
    }
