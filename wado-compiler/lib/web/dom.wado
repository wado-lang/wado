/// The `web:dom` entry points, which hand out the first handle.
#[cm("web:dom/global")]
pub interface Dom {
    #[cm("web:dom/global#window")]
    fn window() -> Window;
    #[cm("web:dom/global#document")]
    fn document() -> Document;
}
