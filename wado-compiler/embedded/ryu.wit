package wado:ryu@1.0.0;

/// Float formatting using ryu library
///
/// Provides deterministic float-to-string conversion across all platforms.
interface format {
    /// Format an f64 to a string
    ///
    /// Returns a string representation of the floating-point value.
    /// The output is deterministic across all platforms and runtimes.
    format-f64: func(value: f64) -> string;

    /// Format an f32 to a string
    ///
    /// Returns a string representation of the floating-point value.
    /// The output is deterministic across all platforms and runtimes.
    format-f32: func(value: f32) -> string;
}

world ryu {
    export format;
}
