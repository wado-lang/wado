#![no_prelude]

/// Doc comment on use
use { println } from "core:cli";

/// Doc comment on enum
#[cm("my-enum")]
enum Color {
    /// Red case
    Red,
    /// Green case
    Green,
    /// Blue case
    Blue,
}

/// Doc comment on variant
#[cm("my-variant")]
variant Shape {
    /// Circle with radius
    Circle(f64),
    /// Rectangle with dimensions
    Rectangle([f64, f64]),
    /// No-payload point
    Point,
}

/// Inherent impl: compact form with bounds inlined
impl List<T: Ord> {
    /// Sort method
    fn sort(&mut self) {
    }

    /// Sorted method
    fn sorted(&self) -> List<T> {
        return self.sorted();
    }
}

/// Trait impl: type params at impl level (expected, not compact)
impl<T: Ord> Iterator for List<T> {
    type Item = T;

    fn next(&mut self) -> Option<Self::Item> {
        return null;
    }
}

/// Async effect method is preserved
interface MyEffect {
    async fn perform(x: i32) -> i32;
    fn sync_op(y: String);
}

/// Resource: opaque handle without methods
resource Handle;

/// Resource: pub with methods, self: &Self normalized
pub resource Stream {
    /// Read data from stream
    fn read(self: &Self, len: u64) -> List<u8>;
    /// Write data to stream
    async fn write(self: &Self, data: List<u8>);
    /// Close the stream
    fn close(self: &Self);
}

/// Type alias with attribute preserved
#[cm("wasi:http/types#field-name")]
pub type FieldName = String;

/// Type alias with attribute and no visibility
#[cm("wasi:http/types#status-code")]
type StatusCode = u16;

/// Enum with attributed cases (no extra blank lines)
#[cm("wasi:sockets/types#ip-address-family")]
enum IpFamily {
    #[cm("ipv4")]
    Ipv4,
    #[cm("ipv6")]
    Ipv6,
}

/// Variant with attributed cases (no extra blank lines)
#[cm("wasi:http/types#scheme")]
variant Scheme {
    #[cm("HTTP")]
    Http,
    #[cm("HTTPS")]
    Https,
    #[cm("other")]
    Other(String),
}

/// Struct with attributed fields (no extra blank lines)
#[cm("wasi:http/types#dns-error-payload")]
struct DnsError {
    #[cm("rcode")]
    pub rcode: Option<String>,
    #[cm("info-code")]
    pub info_code: Option<u16>,
}

// Block comment /* */ before impl
/* inherent impl with trait bound */
impl List<T: Ord> {
    /* sort in ascending order */
    fn sort(&mut self) {
    }
}

// async methods in effect
interface FileIO {
    /* read bytes */
    async fn read(path: String) -> List<u8>;
    /* write bytes */
    fn write(path: String, data: List<u8>);
}
