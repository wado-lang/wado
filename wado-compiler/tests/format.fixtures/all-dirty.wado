//! Module doc comment

/// Doc comment on use
use { println } from "core:cli";

/// Doc comment on struct
struct Point {
    /// X field
    x: i32,
    /// Y field
    y: i32,
}

/// Struct with serde attributes (key=value and bare identifier)
struct SerdeExample {
    #[serde(rename = "myField")]
    my_field: i32,
    #[serde(default)]
    flag: bool,
    #[serde(rename_all = "camelCase")]
    other: i32,
}

/// Doc comment on enum
enum Color {
    /// Red case
    Red,
    /// Green case
    Green,
    /// Blue case
    Blue,
}

/// Doc comment on variant
variant Shape {
    /// Circle with radius
    Circle(f64),
    /// Rectangle with dimensions
    Rectangle([f64, f64]),
    /// No-payload point
    Point,
}

/// Doc comment on flags
flags Perms {
    /// Read permission
    Read,
    /// Write permission
    Write,
}

/// Trait with doc comments on methods
trait Greet {
    /// Greeting method doc
    fn greet(&self) -> String;

    /// Another method
    fn name(&self) -> String;
}

/// Trait with associated type then method (no extra blank lines)
trait Container {
    type Item;

    /// Get the contained item
    fn get(&self) -> Self::Item;
}

/// Trait with attribute (attribute must be preserved)
#[hidden]
pub trait HasDefault {
    fn default() -> Self;
}

/// Trait with associated type bound (bound must be preserved)
pub trait HasBoundedAssocType {
    type Item;
    type Iter: Iterator<Item = Self::Item>;

    fn into_iter(&self) -> Self::Iter;
}

/// Generic struct for bounded impl test
struct MyArray<T> {
    items: Array<T>,
}

/// Inherent impl: compact form with bounds inlined
impl MyArray<T: Ord> {
    /// Sort method
    fn sort(&mut self) {
    }

    /// Sorted method
    fn sorted(&self) -> MyArray<T> {
        return MyArray { items: self.items };
    }
}

/// Trait for trait-impl-with-type-params test
trait MyIterator {
    type Item;

    fn next(&mut self) -> Option<Self::Item>;
}

/// Trait impl: type params at impl level (expected, not compact)
impl<T: Ord> MyIterator for MyArray<T> {
    type Item = T;

    fn next(&mut self) -> Option<Self::Item> {
        return null;
    }
}

/// self: &Self normalized to &self
impl Point {
    fn get_x(self: &Self) -> i32 {
        return self.x;
    }

    fn set_x(self: &mut Self, x: i32) {
        self.x = x;
    }
}

/// Type alias (newtype)
type Meters = f64;

/// Pub type alias
pub type Kilograms = f64;

/// Global variables
global PI: f64 = 3.14159265358979;

pub global mut counter: i32 = 0;

/// Function return types: no return, -> (), and -> !
fn no_return_type() {
}

fn unit_return_type() -> () {
}

fn never_return_type() -> ! {
    panic("oops");
}

/// Numeric literals - integer forms
fn int_literals() {
    let a = 42;
    let b = 1_000_000;
    let c = 0xFF;
    let d = 0xff;
    let e = 0b1010_1010;
    let f = 0o755;
    let g = 0;
    let h = 0xDEAD_BEEF;
}

/// Numeric literals - float forms
fn float_literals() {
    let a = 3.14;
    let b = 1.0;
    let c = 1_000.5;
    let d = 1e10;
    let e = 3.14e-2;
    let f = 1.5e+3;
    let g = 0.0;
}

/// Char literals: ASCII, escapes, unicode (raw form preserved)
fn char_literals() {
    let a = 'A';
    let b = 'z';
    let c = '0';
    let d = ' ';
    let e = '\n';
    let f = '\t';
    let g = '\r';
    let h = '\\';
    let i = '\'';
    let j = '\0';
    let k = '\u0041';    // 4-hex unicode escape: preserved as-is
    let l = '\u{1F600}'; // curly-brace unicode escape: preserved as-is
    let m = '🦀';        // direct emoji: preserved as-is
    let n = '\u001B';    // ESC: preserved as-is
}

/// String literals: escapes and multiline
fn string_literals() {
    let a = "hello";
    let b = "with \"quotes\"";
    let c = "with\nnewline";
    let d = "with\ttab";
    let e = "backslash: \\";
    let f = "multiline
string
literal";
    let g = "unicode \u0041 in string";
}

/// Template strings with format specifiers
fn template_strings(name: String, pi: f64, n: i32) {
    let a = `Hello, {name}!`;
    let b = `Pi is approximately {pi:0.2f}`;
    let c = `Hex value: {n:x}`;
    let d = `Right-aligned: {n:>10}`;
    let e = `Zero-padded: {n:08d}`;
    let f = `Signed: {n:+}`;
    let g = `Alt hex: {n:#x}`;
    let h = `{name}: {n} items`;
    let i = `no interpolation here`;
    let j = `debug: {n:?}`;
    let k = `multiline
template {name}`;
    let l = `\{"key": "value"\}`;
    let m = `prefix \{literal\} and {name} mixed`;
    let n2 = `\{"name":"Alice","age":30\}`;
}

/// Assert statements
fn asserts(x: i32, s: String) {
    assert x > 0;
    assert x < 100, "x must be less than 100";
    assert x != 0, `x is {x} but should not be zero`;
    assert s.len() > 0;
}

/// Match expression with variant patterns
fn match_shape(shape: Shape) -> f64 {
    return match shape {
        Circle(r) => 3.14159 * r * r,
        Rectangle([w, h]) => w * h,
        Point => 0.0,
    };
}

/// Match with guard conditions
fn match_with_guard(opt: Option<i32>) -> String {
    return match opt {
        Some(x) && x > 100 => "large",
        Some(x) && x > 10 => "medium",
        Some(_) => "small",
        None => "none",
    };
}

/// Match with wildcard and block body
fn match_wildcard(color: Color) -> String {
    return match color {
        Red => "red",
        Green => "green",
        _ => "other",
    };
}

/// Match with enum and struct pattern
fn match_struct(result: Result<Point, String>) -> i32 {
    return match result {
        Ok({ x, y }) => x + y,
        Err(_) => -1,
    };
}

/// Matches operator
fn matches_example(opt: Option<i32>, shape: Shape) -> bool {
    let a = opt matches { Some(_) };
    let b = opt matches { Some(x) && x > 0 };
    let c = shape matches { Circle(_) };
    return a && b && c;
}

/// Inline if expression (single-line when short enough)
fn inline_if_expr(upper: bool) -> String {
    let letter = if upper {
        "E";
    } else {
        "e";
    };
    return letter;
}

/// Inline match expression (single-line when short enough)
fn inline_match_expr(color: Color) -> String {
    let name = match color {
        Red => "red",
        _ => "other",
    };
    return name;
}

/// Multiline if expression (too long to inline)
fn multiline_if_expr(some_very_long_condition_name: bool) -> String {
    let result = if some_very_long_condition_name {
        "this_is_a_somewhat_long_value_for_the_then_branch";
    } else {
        "this_is_a_somewhat_long_value_for_the_else_branch";
    };
    return result;
}

/// Closures: expression body, no capture
fn closure_no_capture() {
    let add_one = |x: i32| x + 1;
    let add = |a: i32, b: i32| a + b;
    let is_even = |x: i32| x % 2 == 0;
    let negate = |x: i32| -x;
}

/// Closures: block body with explicit return
fn closure_block_body() {
    let compute = |x: i32| {
        let doubled = x * 2;
        return doubled + x;
    };
    let greet = |name: String| {
        return `Hello, {name}!`;
    };
}

/// Calling a closure field requires parens: (self.f)(item)
struct Mapper {
    f: fn(i32) -> i32,
}

impl Mapper {
    fn apply(&self, x: i32) -> i32 {
        return (self.f)(x);
    }
}

/// Closures: capturing and mutable capture
fn closure_capture() {
    let multiplier = 10;
    let scale = |x: i32| x * multiplier;

    let mut count = 0;
    let mut inc = || { count += 1; };
    inc();
    inc();
    let _ = count;
    let _ = scale(5);
}

/// Struct literals: inline, shorthand, multiline
fn struct_literals() {
    let p = Point { x: 1, y: 2 };

    let x = 10;
    let y = 20;
    let p2 = Point { x, y };

    let p3 = Point {
        x: 100,
        y: 200,
    };

    let p4: Point = { x: 5, y: 6 };
}

/// Tuple and array literals
fn tuple_array_literals() {
    let t = [1, "hello", true];
    let pair = [42, 0];

    let a: Array<i32> = [1, 2, 3];
    let b = [1, 2, 3] as Array<i32>;
    let empty: Array<i32> = [];
    let nested: Array<Array<i32>> = [[1, 2], [3, 4]];
}

/// Destructuring: struct, tuple, in loops
fn destructuring_examples() {
    let p = Point { x: 1, y: 2 };

    let { x, y } = p;
    let Point { x: px, y: py } = p;
    let { x: hx, y: vy } = p;
    let { x: dx, .. } = p;

    let t = [1, 2, 3];
    let [a, b, c] = t;
    let [first, ..] = t;
    let [a2, b2, ..] = t;
    let [..] = t;

    let _ = x + y + px + py + hx + vy + dx + a + b + c + first + a2 + b2;

    let points: Array<Point> = [];
    for let { x, y } of points {
        let _ = x + y;
    }
}

/// Match used as a statement: trailing semicolon should be removed
fn match_as_stmt(color: Color, opt: Option<i32>) {
    match color {
        Red => { let _ = 1; },
        _ => { let _ = 2; },
    };
    match opt {
        Some(x) => { let _ = x; },
        None => {},
    };
}

/// Key-value list: array of 2-element tuples should be formatted one entry per line
fn kv_list_long(entries: Array<[String, i32]>) {
    let long = [["first-key", 100], ["second-key", 200], ["third-key", 300], ["fourth-key", 400], ["fifth-key", 500], ["sixth-key", 600]];
    let _ = long;
}

/// Stores: function storing a reference parameter
struct  Holder {
    data:  &Point,
}

fn hold_ref(  p:  &Point  )  ->  Holder  with  stores[p] {
    return Holder { data: p };
}

fn hold_ref_with_effects(  p:  &Point  )  ->  Holder  with  Stdout,  stores[p] {
    return Holder { data: p };
}

/// Stores: method with stores[self]
impl Point {
    fn to_holder(&self) -> Holder with stores[self] {
        return Holder { data: self };
    }
}

/// Function type with effect in parameter position
fn apply_fn(f:   fn(i32) -> i32   with   Stdout,  x:  i32)  ->  i32  with  Stdout {
    return f(x);
}

export fn run() {
}

/// Unary ref with cast: &(x as T) must keep parentheses (as has lower precedence than &)
fn ref_cast_parens(x: i32) {
    let _ = &(x as i64);
}

/// Deref with postfix: (*p)[i] and (*p).field must keep parens
fn deref_postfix_parens(data: &Array<i32>,  p: &Array<i32>) {
    let _ = (*data)[0];
    let _ =  (*p)[1];
}

/// World: blank lines between imports are preserved
pub world TestWorld {
    import Foo;

    import Bar;

    export fn run();
}

/// World: bare interface export form (`export Foo;`)
pub world TestService {
    import Stdout;

    export Handler;
}
