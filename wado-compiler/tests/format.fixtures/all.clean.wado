#![no_prelude]
//! Module doc comment

/// Doc comment on use
use { println } from "core:cli";

/// Doc comment on struct
struct Point {
    /// X field
    x: i32,
    /// Y field
    y: i32,
}

/// Doc comment on enum
#[wasi("my-enum")]
enum Color {
    /// Red case
    Red,
    /// Green case
    Green,
    /// Blue case
    Blue,
}

/// Doc comment on variant
#[wasi("my-variant")]
variant Shape {
    /// Circle with radius
    Circle(f64),
    /// Rectangle with dimensions
    Rectangle([f64, f64]),
    /// No-payload point
    Point,
}

/// Doc comment on flags
flags Perms {
    /// Read permission
    Read,
    /// Write permission
    Write,
}

/// Inherent impl: compact form with bounds inlined
impl Array<T: Ord> {
    /// Sort method
    fn sort(&mut self) {
    }

    /// Sorted method
    fn sorted(&self) -> Array<T> {
        return self.sorted();
    }
}

/// Trait impl: type params at impl level (expected, not compact)
impl<T: Ord> Iterator for Array<T> {
    type Item = T;

    fn next(&mut self) -> Option<Self::Item> {
        return null;
    }
}

/// Trait with doc comments on methods
trait Greet {
    /// Greeting method doc
    fn greet(&self) -> String;

    /// Another method
    fn name(&self) -> String;
}

/// self: &Self normalized to &self
impl Point {
    fn get_x(&self) -> i32 {
        return self.x;
    }

    fn set_x(&mut self, x: i32) {
        self.x = x;
    }
}

/// Async effect method is preserved
effect MyEffect {
    async fn perform(x: i32) -> i32;
    fn sync_op(y: String);
}

/// Top-level function
fn run() {
    let p = Point { x: 1, y: 2 };
}
