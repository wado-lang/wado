// トップレベルアイテム間に3行以上の空行（2行に削減される）
fn first() {
}


fn second() {
}


fn third() {
}

// use {} に内側スペースなし、コンマの後にスペースなし
use { println, eprintln, print, eprint } from "core:cli";

// 構造体フィールドにインライン /* */ コメント
struct Point {
    x: i32,  /* horizontal */
    /* vertical component */
    y: i32,
    z: i32,  /* depth */
}

// struct の前に /* */ ブロックコメント
/* This is the Color enum */
enum Color {
    Red,  /* primary */
    /* secondary */
    Green,
    Blue,  /* another primary */
    /* last one */
    Alpha,
}

// variant に /* */ ブロックコメント
/* Represents a geometric shape */
variant Shape {
    /* a circle with radius */
    Circle(f64),
    /* width and height */
    Rect([f64, f64]),
    /* just a point */
    Dot,
}

// flags に /* */ ブロックコメント
flags Access {
    Read,  /* can read */
    /* can write */
    Write,
    Execute,  /* can execute */
}

// implメソッド間に空行なし（1行に補正される）
struct Counter {
    n: i32,
}

impl Counter {
    fn new() -> Counter {
        return Counter { n: 0 };
    }

    fn inc(&mut self) {
        self.n = self.n + 1;
    }

    fn get(&self) -> i32 {
        return self.n;
    }

    fn reset(&mut self) {
        self.n = 0;
    }
}

// 関数内に3行以上の空行（2行に削減）
fn with_many_blank_lines() {
    let a = 1;


    let b = 2;


    let c = a + b;
    /* a trailing block comment inside function */
}

// ブロックコメントが制御構造の前後に
fn control_flow(x: i32) -> i32 {
    /* check if positive */
    if x > 0 {
        /* positive branch */
        return x;
    }
    /* check if negative */
    if x < 0 {
        /* negative branch */
        return -x;
    }
    /* must be zero */
    return 0;
}

// ループ内のブロックコメント
fn loop_example() {
    let mut i = 0;
    /* start of loop */
    while i < 10 {
        /* loop body */
        i += 1;
        /* end of iteration */
    }
    /* after loop */
}

// ネストしたブロックコメント
fn nested_blocks() {
    /* outer */
    for let j = 0; j < 5; j += 1 {
        /* inner */
        let x = j * 2;
        /* done */
    }
    /* all done */
}

// self: &Self の正規化
struct Wrapper {
    val: i32,
}

impl Wrapper {
    fn get(&self) -> i32 {
        return self.val;
    }

    fn set(&mut self, v: i32) {
        self.val = v;
    }

    fn clone_it(&self) -> Wrapper {
        return Wrapper { val: self.val };
    }
}

// impl ブロックコメント（メソッドの前後）
struct Logger {
    prefix: String,
}

impl Logger {
    /* constructor */
    fn new(prefix: String) -> Logger {
        return Logger { prefix };
    }

    /* main log method */
    fn log(&self, msg: String) {
    }

    /* log with level */
    fn log_level(&self, level: i32, msg: String) {
    }
}

// implの前に /* */ コメント
/* inherent impl with trait bound */
impl Array<T: Ord> {
    /* sort in ascending order */
    fn sort(&mut self) {
    }
}

// trait のメソッドに /* */ コメント
trait Printable {
    /* print to stdout */
    fn print(&self);
    /* print with newline */
    fn println(&self);
}

// effect の async メソッド
effect FileIO {
    /* read bytes */
    async fn read(path: String) -> Array<u8>;
    /* write bytes */
    fn write(path: String, data: Array<u8>);
}

// 関数本体の冒頭に /* */ コメント複数
fn add(a: i32, b: i32) -> i32 {
    /* first number */
    /* second number */
    return a + b;
}

// クロージャのあとに空行が多すぎる
fn with_closures() {
    let inc = |x: i32| x + 1;


    let double = |x: i32| x * 2;


    let result = double(inc(5));
}
