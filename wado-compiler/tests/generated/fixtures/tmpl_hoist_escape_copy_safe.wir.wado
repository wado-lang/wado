            i_220 = self_41.used;
            self_41.used = $mv$alt_prefix$used;
            builtin::array_set_u8(self_41.repr, i_220, 43);
        }
        if prefix_len > 0 {
            if @unlikely(local.tee prefix_len(local.tee self_41(self.buf).used + 2) > builtin::array_len(self_41.repr)) {
                cold_path;
                "core:prelude/string.wado/core:prelude/string.wado/String::grow"(self_41, prefix_len);
            }
            i_220 = self_41.used;
            self_41.used = prefix_len;
            builtin::array_copy<u8>(self_41.repr, i_220, $mv$alt_prefix$repr, 0, 2);
        }
        if @unlikely(local.tee digit_count(local.tee self_41(self.buf).used + digit_count) > builtin::array_len(self_41.repr)) {
            cold_path;
            "core:prelude/string.wado/core:prelude/string.wado/String::grow"(self_41, digit_count);
        }
        i_220 = self_41.used;
        self_41.used = digit_count;
        return i_220;
    }
}

