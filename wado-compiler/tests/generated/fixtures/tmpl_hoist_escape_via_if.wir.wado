            self_41.used = prefix_len;
            builtin::array_copy<u8>(self_41.repr, i_220, $mv$alt_prefix$repr, 0, 2);
        }
        if @unlikely(local.tee digit_count(local.tee self_41(self.buf).used + digit_count) > builtin::array_len(self_41.repr)) {
            cold_path;
            "core:prelude/string.wado/core:prelude/string.wado/String::grow"(self_41, digit_count);
        }
        i_220 = self_41.used;
        self_41.used = digit_count;
        return i_220;
    }
}

export fn "tmpl_hoist_escape_via_if.wado/$cm_export__run" as "run"
