    "core:prelude/primitive.wado/write_decimal_digits"(local.tee name(f.buf).repr, start_78, x, self);
    $sroa_other_repr_113 = array.new_fixed<u8>(32, 125);
    if @unlikely(local.tee self(name.used + 2) > builtin::array_len(name.repr)) {
