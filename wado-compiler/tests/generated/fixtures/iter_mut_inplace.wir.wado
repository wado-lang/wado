fn "core:prelude/primitive.wado/count_digits_u64"(val) {
    if val <u 100000_i64 {
        if val <u 100_i64 {
            if val <u 10_i64 {
                return 1;
            }
            return 2;
        }
        if val <u 1000_i64 {
            return 3;
        }
        if val <u 10000_i64 {
            return 4;
        }
        return 5;
    }
    if val <u 10000000000_i64 {
        if val <u 10000000_i64 {
            if val <u 1000000_i64 {
                return 6;
            }
            return 7;
        }
        if val <u 100000000_i64 {
            return 8;
        }
        if val <u 1000000000_i64 {
            return 9;
        }
        return 10;
    }
    if val <u 1000000000000000_i64 {
        if val <u 1000000000000_i64 {
            if val <u 100000000000_i64 {
                return 11;
            }
            return 12;
        }
        if val <u 10000000000000_i64 {
            return 13;
        }
        if val <u 100000000000000_i64 {
            return 14;
        }
        return 15;
    }
    if val <u 100000000000000000_i64 {
        if val <u 10000000000000000_i64 {
            return 16;
        }
        return 17;
    }
    if val <u 1000000000000000000_i64 {
        return 18;
    }
    if val <u -8446744073709551616_i64 {
        return 19;
    }
    return 20;
}

fn "core:prelude/primitive.wado/write_u64_base_digits"(arr, offset, val_i64, digit_count, bits_per_digit, mask, upper) {
    let mask64: i64;
    let pos: i32;
    let temp: i64;
    let digit: i32;
    mask64 = builtin::i64_extend_i32_s(mask);
    pos = offset + digit_count;
    if val_i64 == 0_i64 {
        builtin::array_set_u8(arr, offset, 48);
    } else {
        temp = val_i64;
        b106: block {
            l107: loop {
