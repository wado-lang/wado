    is_negative = "core:prelude/format.wado/core:prelude/format.wado/Formatter::prepare_int_write<core:prelude/string.wado/String>$spec0$scalar"(f, is_negative, self);
    arr = f.repr;
    is_negative = is_negative + self;
    i = 0;
    b44: block {
        l45: loop {
            break_if b44 i >= self;
            is_negative = is_negative - 1;
            builtin::array_set_u8(arr, is_negative, (48 + builtin::i32_wrap_i64(x %u 10_i64)) & 255);
            x = x /u 10_i64;
            i = i + 1;
            continue l45;
        };
    };
}

export fn "const_object_globalization.wado/$cm_export__run" as "run"
