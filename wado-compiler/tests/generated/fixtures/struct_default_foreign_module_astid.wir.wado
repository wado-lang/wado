fn "core:benchmark/next_iterations"(n, elapsed_ns, target_ns) {
    let est: u64;
    let hi: u64;
    est = (builtin::i64_extend_i32_s(n) * target_ns) /u select u64(elapsed_ns == 0_i64, 1_i64, elapsed_ns);
    hi = builtin::i64_extend_i32_s(n) * 100_i64;
    if est >u hi {
        est = hi;
    }
    if est >u 1000000000_i64 {
        est = 1000000000_i64;
    }
    if est <u 1_i64 {
        est = 1_i64;
    }
    return builtin::i32_wrap_i64(est);
}

