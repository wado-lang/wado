    if @unlikely(local.tee digit_count(self.used + digit_count) > builtin::array_len(self.repr)) {
        cold_path;
        "core:prelude/string.wado/core:prelude/string.wado/String::grow"(self, digit_count);
    }
    is_negative = self.used;
    self.used = digit_count;
    return is_negative;
}

export fn "float_constant_pattern.wado/$cm_export__$test_0" as "$test_0"
