export fn "newtype_qualified_method_call.wado/$cm_export__$test_0_a_written_method" as "$test_0_a_written_method"
export fn "newtype_qualified_method_call.wado/$cm_export__$test_1_a_derived_method" as "$test_1_a_derived_method"
export fn "newtype_qualified_method_call.wado/$cm_export__$test_2_a_primitive_s_trait_method" as "$test_2_a_primitive_s_trait_method"
