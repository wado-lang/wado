            builtin::array_set_u8(arr, pos, (48 + builtin::i32_wrap_i64(t %u 10_i64)) & 255);
            t = t /u 10_i64;
            i = i + 1;
            continue l207;
        };
    };
}

export fn "tmpl_hoist_fmt_edge.wado/$cm_export__run" as "run"
