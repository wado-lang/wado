    "core:prelude/fpfmt.wado/write_decimal"(f, $mv$result$digits, $mv$result$exponent, $mv$result$n_digits);
}

fn "core:prelude/primitive.wado/i64::fmt_decimal$scalar$spec0$scalar"(self, f) {
    let is_negative: bool;
    let abs_val: u64;
    let digit_count_5: i32;
    let offset_6: i32;
    let arr: ref Array<u8>;
    let pos: i32;
    let t: u64;
    let i: i32;
    is_negative = self < 0_i64;
    digit_count_5 = "core:prelude/primitive.wado/count_digits_u64"(local.tee abs_val(select i64(self < 0_i64, 0_i64 - self, self)));
    offset_6 = "core:prelude/format.wado/core:prelude/format.wado/Formatter::prepare_int_write<core:prelude/string.wado/String>$spec0$scalar"(f, is_negative, digit_count_5);
    arr = f.repr;
    pos = offset_6 + digit_count_5;
    t = abs_val;
    i = 0;
    b140: block {
        l141: loop {
            break_if b140 i >= digit_count_5;
            pos = pos - 1;
            builtin::array_set_u8(arr, pos, (48 + builtin::i32_wrap_i64(t %u 10_i64)) & 255);
            t = t /u 10_i64;
            i = i + 1;
            continue l141;
        };
    };
}

export fn "index_assign.wado/$cm_export__run" as "run"
