            if val <u 10_i64 {
                return 1;
            }
            return 2;
        }
        if val <u 1000_i64 {
            return 3;
        }
        if val <u 10000_i64 {
            return 4;
        }
        return 5;
    }
    if val <u 10000000000_i64 {
        if val <u 10000000_i64 {
            if val <u 1000000_i64 {
                return 6;
            }
            return 7;
