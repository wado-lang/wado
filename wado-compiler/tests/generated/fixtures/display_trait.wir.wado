    f.used = new_used_100;
    $mv$alt_prefix$repr = f.repr;
    base = start_101 + base;
    lo = 256_i64;
    hi = 0_i64;
    shift_u64 = builtin::i64_extend_i32_s(bits_per_digit);
    $licm_arith_23 = 64_i64 - shift_u64;
    b2788: block {
        l2789: loop {
            break_if b2788 ((lo != 0_i64) | (hi != 0_i64)) == 0;
