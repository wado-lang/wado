fn "core:prelude/primitive.wado/count_digits_i64"(val) {
    let n: i32;
    let t: i64;
    if val == 0_i64 {
        return 1;
    }
    n = 0;
    t = val;
    b3: block {
        l4: loop {
            break_if b3 t <= 0_i64;
            n = n + 1;
            t = t / 10_i64;
            continue l4;
        };
    };
    return n;
}

fn "core:prelude/primitive.wado/write_decimal_digits"(arr, offset, abs_val, digit_count) {
    let pos: i32;
    let temp: i64;
    pos = offset + digit_count;
    if abs_val == 0_i64 {
        builtin::array_set_u8(arr, offset, 48);
    } else {
