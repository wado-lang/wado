        "core:prelude/string.wado/core:prelude/string.wado/String::grow"(f, new_used);
    }
    start_16 = f.used;
    f.used = new_used;
    builtin::array_copy<u8>(f.repr, start_16, global:core:prelude/format.wado::$const_obj_513, 0, 1);
    "core:prelude/format.wado/core/prelude/format.wado/inspect_text<core:prelude/string.wado/StrSlice>$spec0$sroa$f.buf"(f, self.repr, self.start, self.end);
}

