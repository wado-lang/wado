    t = abs_val;
    i = 0;
    b242: block {
        l243: loop {
            break_if b242 i >= digit_count_4;
            pos = pos - 1;
            builtin::array_set_u8(arr, pos, (48 + builtin::i32_wrap_i64(t %u 10_i64)) & 255);
            t = t /u 10_i64;
            i = i + 1;
            continue l243;
        };
    };
}

export fn "spec_functions_generics.wado/$cm_export__$test_0_type_parameters" as "$test_0_type_parameters"
export fn "spec_functions_generics.wado/$cm_export__$test_1_bounds" as "$test_1_bounds"
export fn "spec_functions_generics.wado/$cm_export__$test_2_a_turbofish" as "$test_2_a_turbofish"
