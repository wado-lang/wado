        cold_path;
        "core:prelude/string.wado/core:prelude/string.wado/String::grow"(f, new_used_60);
    }
    start_61 = f.used;
    f.used = new_used_60;
    arr = f.repr;
    base = start_61 + base;
    lo = -1_i64;
    hi = -1_i64;
    shift_u64 = builtin::i64_extend_i32_s(bits_per_digit);
    $licm_arith_23 = 64_i64 - shift_u64;
    b2447: block {
        l2448: loop {
            break_if b2447 ((lo != 0_i64) | (hi != 0_i64)) == 0;
            base = base - 1;
            bits_per_digit = builtin::i32_wrap_i64(lo & mask);
            builtin::array_set_u8(arr, base, (if bits_per_digit < 10 -> i32 {
                48 + bits_per_digit;
            } else {
                select i32(upper, (65 + bits_per_digit) - 10, (97 + bits_per_digit) - 10);
            }));
            lo = (lo >>u shift_u64) | (hi << $licm_arith_23);
            hi = hi >>u shift_u64;
            continue l2448;
        };
    };
    if @unlikely(base != start_61) {
        cold_path;
        "core:prelude/int128.wado/core:prelude/int128.wado/u128::fmt_base$cold0$dae[self,f,base,upper,alt_prefix]"(start_61, base);
        unreachable;
    }
}

export fn "display_specifiers.wado/$cm_export__run" as "run"
