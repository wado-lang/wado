        if @unlikely(local.tee is_negative(self.used + 1) > builtin::array_len(self.repr)) {
            cold_path;
            "core:prelude/string.wado/core:prelude/string.wado/String::grow"(self, is_negative);
        }
        new_used_26 = self.used;
        self.used = is_negative;
        builtin::array_set_u8(self.repr, new_used_26, 45);
    } else {
    }
    if @unlikely(local.tee digit_count(self.used + digit_count) > builtin::array_len(self.repr)) {
        cold_path;
        "core:prelude/string.wado/core:prelude/string.wado/String::grow"(self, digit_count);
    }
    new_used_26 = self.used;
    self.used = digit_count;
    return new_used_26;
}

export fn "display_specifiers.wado/$cm_export__run" as "run"
