    is_negative = is_negative + self;
    i = 0;
    b50: block {
        l51: loop {
            break_if b50 i >= self;
            is_negative = is_negative - 1;
            builtin::array_set_u8(arr, is_negative, (48 + builtin::i32_wrap_i64(x %u 10_i64)) & 255);
            x = x /u 10_i64;
            i = i + 1;
            continue l51;
        };
    };
}

export fn "for_pattern_uninhabited_other_case.wado/$cm_export__$test_0" as "$test_0"
