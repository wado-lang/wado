        break $inline_count_digits_u64_base_0: select i32((self_12 - (q * bits_per_digit_5)) != 0, (local.tee q(local.tee self_12(64 - builtin::i32_wrap_i64(builtin::i64_clz(self))) / bits_per_digit_5) + 1) + ((self_12 ^ bits_per_digit_5) >> 31), q);
    };
    if @unlikely(local.tee new_used_113(local.tee self_12(f.used) + q) > builtin::array_len(f.repr)) {
        cold_path;
        "core:prelude/string.wado/core:prelude/string.wado/String::grow"(f, new_used_113);
    }
    f.used = new_used_113;
    "core:prelude/primitive.wado/write_u64_base_digits"(f.repr, self_12, self, q, bits_per_digit_5, base, upper);
}

export fn "cm_component_import_default_interface.wado/$cm_export__$test_0" as "$test_0"
