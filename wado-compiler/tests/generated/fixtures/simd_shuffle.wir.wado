        "core:prelude/string.wado/core:prelude/string.wado/String::grow"(self, digit_count);
    }
    start_26 = self.used;
    self.used = digit_count;
    return start_26;
}

export fn "simd_shuffle.wado/$cm_export__$test_0_shuffle_names_a_byte_of_either_operand" as "$test_0_shuffle_names_a_byte_of_either_operand"
export fn "simd_shuffle.wado/$cm_export__$test_1_shuffle_may_repeat_and_reverse" as "$test_1_shuffle_may_repeat_and_reverse"
export fn "simd_shuffle.wado/$cm_export__$test_2_swizzle_takes_its_indices_at_runtime__and_zeroes_an_out_of_range_one" as "$test_2_swizzle_takes_its_indices_at_runtime__and_zeroes_an_out_of_range_one"
