        "core:prelude/string.wado/core:prelude/string.wado/String::grow"(out, new_used);
    }
    start_9 = out.used;
    out.used = new_used;
    builtin::array_copy<u8>(out.repr, start_9, self.repr, 0, 3);
}

export fn "spec_lexical_ranges.wado/$cm_export__$test_0_range_types" as "$test_0_range_types"
export fn "spec_lexical_ranges.wado/$cm_export__$test_1_an_empty_literal_range" as "$test_1_an_empty_literal_range"
export fn "spec_lexical_ranges.wado/$cm_export__$test_2_iteration" as "$test_2_iteration"
