            break_if b347 i >= self;
            is_negative = is_negative - 1;
            builtin::array_set_u8(arr, is_negative, (48 + builtin::i32_wrap_i64(x %u 10_i64)) & 255);
            x = x /u 10_i64;
            i = i + 1;
