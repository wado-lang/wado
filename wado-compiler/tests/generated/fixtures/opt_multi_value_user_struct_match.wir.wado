fn "opt_multi_value_user_struct_match.wado/return_match_small"(x) {
    if x == 0 {
        return 10, 20;
    } else if x == 1 {
        return 30, 40;
    } else {
        return 50, 60;
    }
}

fn "opt_multi_value_user_struct_match.wado/return_match_large"(i) {
    if i == 0 {
        return 100_i64, 200_i64;
    } else if i == 1 {
        return 300_i64, 400_i64;
    } else if i == 2 {
        return 500_i64, 600_i64;
    } else if i == 3 {
        return 700_i64, 800_i64;
    } else if i == 4 {
        return 900_i64, 1000_i64;
    } else if i == 5 {
        return 1100_i64, 1200_i64;
    } else if i == 6 {
        return 1300_i64, 1400_i64;
    } else {
        return 0_i64, 0_i64;
    }
}

fn "opt_multi_value_user_struct_match.wado/return_match_with_unreachable"(x) {
    if x == 0 {
        return 1, 2;
    } else if @likely(x == 1) {
        return 3, 4;
    } else {
        "core:rt/unreachable"();
        unreachable;
    }
