            break_if b38 i >= digit_count_4;
            pos = pos - 1;
            builtin::array_set_u8(arr, pos, (48 + builtin::i32_wrap_i64(t %u 10_i64)) & 255);
            t = t /u 10_i64;
            i = i + 1;
            continue l39;
        };
    };
}

export fn "identifier.wado/$cm_export__$test_0_uppercase_local" as "$test_0_uppercase_local"
export fn "identifier.wado/$cm_export__$test_1_lowercase_type" as "$test_1_lowercase_type"
export fn "identifier.wado/$cm_export__$test_2_case_independence" as "$test_2_case_independence"
export fn "identifier.wado/$cm_export__$test_3_iflet_uppercase_binding" as "$test_3_iflet_uppercase_binding"
