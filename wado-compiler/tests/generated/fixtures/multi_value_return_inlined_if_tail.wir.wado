    is_negative = "core:prelude/format.wado/core:prelude/format.wado/Formatter::prepare_int_write<core:prelude/string.wado/String>$spec0$sroa[self.buf]$dae[alt_prefix]"(f, is_negative, self);
    "core:prelude/primitive.wado/write_decimal_digits"(f.repr, is_negative, x, self);
}

export fn "multi_value_return_inlined_if_tail.wado/$cm_export__$test_0_an_option_typed_field_parsed_from_argv" as "$test_0_an_option_typed_field_parsed_from_argv"
