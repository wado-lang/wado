        multivalue_bind [$mv$result_14$digits, $mv$result_14$exponent, $mv$result_14$n_digits] = "core:prelude/fpfmt.wado/fixed_width"(abs_f, (if total_digits > 18 -> i32 {
            18;
        } else {
            select i32(total_digits < 1, 1, total_digits);
        }));
        "core:prelude/fpfmt.wado/write_exp_prec"(f, $mv$result_14$digits, $mv$result_14$exponent, $mv$result_14$n_digits, precision, upper_bool);
    } else {
        let $mv$result_18$digits: u64;
        let $mv$result_18$exponent: i32;
        let $mv$result_18$n_digits: i32;
        multivalue_bind [$mv$result_18$digits, $mv$result_18$exponent, $mv$result_18$n_digits] = "core:prelude/fpfmt.wado/short"(abs_f);
        "core:prelude/fpfmt.wado/write_exp"(f, $mv$result_18$digits, $mv$result_18$exponent, $mv$result_18$n_digits, upper_bool);
    }
}

fn "core:prelude/primitive.wado/i32::fmt_decimal$scalar$spec0$scalar"(self, f) {
    let is_negative: bool;
    let abs_val: u64;
    let digit_count_4: i32;
    let offset_5: i32;
    let val_6: i64;
    let arr: ref Array<u8>;
    let pos: i32;
    let t: u64;
    let i: i32;
    is_negative = self < 0;
    val_6 = builtin::i64_extend_i32_s(self);
    digit_count_4 = "core:prelude/primitive.wado/count_digits_u64"(local.tee abs_val(select i64(val_6 < 0_i64, 0_i64 - val_6, val_6)));
    offset_5 = "core:prelude/format.wado/core:prelude/format.wado/Formatter::prepare_int_write<core:prelude/string.wado/String>$spec0$scalar"(f, is_negative, digit_count_4);
    arr = f.repr;
    pos = offset_5 + digit_count_4;
    t = abs_val;
    i = 0;
    b461: block {
        l462: loop {
            break_if b461 i >= digit_count_4;
            pos = pos - 1;
            builtin::array_set_u8(arr, pos, (48 + builtin::i32_wrap_i64(t %u 10_i64)) & 255);
            t = t /u 10_i64;
            i = i + 1;
            continue l462;
        };
    };
}

