                    "core:prelude/string.wado/core:prelude/string.wado/String::grow"(self_21, prefix_len);
                }
                is_negative = self_21.used;
                self_21.used = prefix_len;
                builtin::array_copy<u8>(self_21.repr, is_negative, $mv$alt_prefix$repr, 0, $mv$alt_prefix$used);
            };
        }
        if @unlikely(local.tee digit_count(local.tee self_21(self.buf).used + digit_count) > builtin::array_len(self_21.repr)) {
            cold_path;
            "core:prelude/string.wado/core:prelude/string.wado/String::grow"(self_21, digit_count);
        }
        $mv$alt_prefix$used = self_21.used;
        self_21.used = digit_count;
        return $mv$alt_prefix$used;
    }
}

export fn "tagged_template_nested_holes.wado/$cm_export__run" as "run"
