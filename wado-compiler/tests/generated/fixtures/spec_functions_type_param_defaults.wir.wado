    self_12 = "core:prelude/format.wado/core:prelude/format.wado/Formatter::prepare_int_write<core:prelude/string.wado/String>$spec1$sroa[self.buf]$dae[alt_prefix]"(f, 0, q);
    "core:prelude/primitive.wado/write_u64_base_digits"(f.repr, self_12, self, q, bits_per_digit_5, base, upper);
}

export fn "spec_functions_type_param_defaults.wado/$cm_export__$test_0_an_omitted_turbofish_takes_the_default" as "$test_0_an_omitted_turbofish_takes_the_default"
