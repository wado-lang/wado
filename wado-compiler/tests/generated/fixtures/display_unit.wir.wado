    bits_per_digit_6 = (if base == 2 -> i32 {
        1;
    } else {
        select i32(base == 8, 3, 4);
    });
    base = base - 1;
    q = $inline_count_digits_u64_base_0: block -> i32 {
        if self == 0_i64 {
            break $inline_count_digits_u64_base_0: 1;
        }
        break $inline_count_digits_u64_base_0: select i32((self_12 - (q * bits_per_digit_6)) != 0, (local.tee q(local.tee self_12(64 - builtin::i32_wrap_i64(builtin::i64_clz(self))) / bits_per_digit_6) + 1) + ((self_12 ^ bits_per_digit_6) >> 31), q);
    };
    $mv$alt_prefix$used = "core:prelude/format.wado/core:prelude/format.wado/Formatter::prepare_int_write<core:prelude/string.wado/String>$spec1"(f, 0, $mv$alt_prefix$repr, $mv$alt_prefix$used, q);
    "core:prelude/primitive.wado/write_u64_base_digits"(f.buf.repr, $mv$alt_prefix$used, self, q, bits_per_digit_6, base, upper);
}

export fn "display_unit.wado/$cm_export__run" as "run"
