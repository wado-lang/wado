fn "core:prelude/primitive.wado/count_digits_u64"(val) {
    if val <u 100000_i64 {
        if val <u 100_i64 {
            if val <u 10_i64 {
                return 1;
            }
            return 2;
        }
        if val <u 1000_i64 {
            return 3;
        }
        if val <u 10000_i64 {
