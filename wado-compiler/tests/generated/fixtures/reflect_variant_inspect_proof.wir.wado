        builtin::array_copy<u8>(f.repr, new_used_24, self_44.repr, 0, 5);
    }
}

export fn "reflect_variant_inspect_proof.wado/$cm_export__$test_0_library_code_variant_inspect_matches_the_synthesizer_s_output" as "$test_0_library_code_variant_inspect_matches_the_synthesizer_s_output"
