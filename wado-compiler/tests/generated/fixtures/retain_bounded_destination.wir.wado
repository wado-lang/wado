    offset_5 = "core:prelude/format.wado/core:prelude/format.wado/Formatter::prepare_int_write<core:prelude/string.wado/String>$spec0$scalar"(f, is_negative, digit_count_4);
    arr = f.repr;
    pos = offset_5 + digit_count_4;
    t = abs_val;
    i = 0;
    b226: block {
        l227: loop {
            break_if b226 i >= digit_count_4;
            pos = pos - 1;
            builtin::array_set_u8(arr, pos, (48 + builtin::i32_wrap_i64(t %u 10_i64)) & 255);
            t = t /u 10_i64;
            i = i + 1;
            continue l227;
        };
    };
}

export fn "retain_bounded_destination.wado/$cm_export__run" as "run"
