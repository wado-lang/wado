        "core:prelude/string.wado/core:prelude/string.wado/String::grow"(self, digit_count);
    }
    start_26 = self.used;
    self.used = digit_count;
    return start_26;
}

export fn "opt_early_freeze_names_a_local.wado/$cm_export__run" as "run"
