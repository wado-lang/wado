            builtin::array_set_u8(arr, is_negative, (48 + builtin::i32_wrap_i64(x %u 10_i64)) & 255);
            x = x /u 10_i64;
            i = i + 1;
            continue l105;
        };
    };
}

export fn "block_like_arg_infers_type_param.wado/$cm_export__run" as "run"
