            break_if b199 i >= digit_count_5;
            is_negative = is_negative - 1;
            builtin::array_set_u8(arr, is_negative, (48 + builtin::i32_wrap_i64(self %u 10_i64)) & 255);
            self = self /u 10_i64;
            i = i + 1;
            continue l200;
        };
    };
}

fn "core:prelude/string.wado/core:prelude/string.wado/String::internal_write_str_at$scalar"(self, offset, s, n) {
    builtin::array_copy<u8>(self, offset, s.repr, 0, n);
}

export fn "opt_sroa_variant_return_embedded_err_return.wado/$cm_export__run" as "run"
