fn "tuple_basic.wado/$test_6_destructuring_a_multi_value_builtin"() {
    let lo1: i64;
    let hi1: i64;
    let lo2: i64;
    let hi2: i64;
    let lo3: i64;
    let hi3: i64;
    let lo4: i64;
    let hi4: i64;
    let lo5: i64;
    let hi6: i64;
    multivalue_bind [lo1, hi1] = i64.add128(100_i64, 200_i64, 50_i64, 25_i64);
    if @unlikely(lo1 != 150_i64) {
        cold_path;
        "tuple_basic.wado/$test_6_destructuring_a_multi_value_builtin$cold9"(lo1);
        unreachable;
    }
    if @unlikely(hi1 != 225_i64) {
        cold_path;
        "tuple_basic.wado/$test_6_destructuring_a_multi_value_builtin$cold8"(hi1);
        unreachable;
    }
    multivalue_bind [lo2, hi2] = i64.sub128(150_i64, 225_i64, 50_i64, 25_i64);
    if @unlikely(lo2 != 100_i64) {
        cold_path;
        "tuple_basic.wado/$test_6_destructuring_a_multi_value_builtin$cold7"(lo2);
        unreachable;
    }
    if @unlikely(hi2 != 200_i64) {
        cold_path;
        "tuple_basic.wado/$test_6_destructuring_a_multi_value_builtin$cold6"(hi2);
        unreachable;
    }
    multivalue_bind [lo3, hi3] = i64.mul_wide_u(10_i64, 20_i64);
    if @unlikely(lo3 != 200_i64) {
        cold_path;
        "tuple_basic.wado/$test_6_destructuring_a_multi_value_builtin$cold5"(lo3);
        unreachable;
    }
    if @unlikely((hi3 == 0_i64) == 0) {
        cold_path;
        "tuple_basic.wado/$test_6_destructuring_a_multi_value_builtin$cold4"(hi3);
        unreachable;
    }
    multivalue_bind [lo4, hi4] = i64.mul_wide_s(-10_i64, 20_i64);
    if @unlikely(lo4 != -200_i64) {
        cold_path;
        "tuple_basic.wado/$test_6_destructuring_a_multi_value_builtin$cold3"(lo4, -200_i64);
        unreachable;
    }
    if @unlikely(hi4 != -1_i64) {
