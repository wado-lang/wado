    let abs_val: u64;
    let digit_count_4: i32;
    let offset_5: i32;
    let x: i64;
    let arr: ref Array<u8>;
    let pos: i32;
    let t: u64;
    let i: i32;
    is_negative = self < 0;
    digit_count_4 = "core:prelude/primitive.wado/count_digits_u64"(local.tee abs_val(x = builtin::i64_extend_i32_s(self); select i64(x < 0_i64, 0_i64 - x, x)));
    offset_5 = "core:prelude/format.wado/core:prelude/format.wado/Formatter::prepare_int_write<core:prelude/string.wado/String>$spec0$scalar"(f, is_negative, digit_count_4);
    arr = f.repr;
    pos = offset_5 + digit_count_4;
    t = abs_val;
    i = 0;
    b67: block {
        l68: loop {
            break_if b67 i >= digit_count_4;
            pos = pos - 1;
            builtin::array_set_u8(arr, pos, (48 + builtin::i32_wrap_i64(t %u 10_i64)) & 255);
            t = t /u 10_i64;
            i = i + 1;
            continue l68;
        };
    };
}

