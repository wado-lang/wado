        "tuple_basic.wado/$test_6_destructuring_a_multi_value_builtin$cold2"(hi4, -1_i64);
        unreachable;
    }
    multivalue_bind [lo5, _] = i64.mul_wide_u(100_i64, 100_i64);
    if @unlikely(lo5 != 10000_i64) {
        cold_path;
        "tuple_basic.wado/$test_6_destructuring_a_multi_value_builtin$cold1"(lo5);
        unreachable;
    }
    multivalue_bind [_, hi6] = i64.mul_wide_u(-9223372036854775808_i64, 2_i64);
    if @unlikely(hi6 != 1_i64) {
        cold_path;
        "tuple_basic.wado/$test_6_destructuring_a_multi_value_builtin$cold0"(hi6);
