fn "core:prelude/primitive.wado/write_decimal_digits"(arr, offset, abs_val, digit_count) {
    let pos: i32;
    let temp: i64;
    pos = offset + digit_count;
    if abs_val == 0_i64 {
        builtin::array_set_u8(arr, offset, 48);
    } else {
        temp = abs_val;
        b7: block {
            l8: loop {
                break_if b7 temp <= 0_i64;
                pos = pos - 1;
                builtin::array_set_u8(arr, pos, (48 + builtin::i32_wrap_i64(temp % 10_i64)) & 255);
                temp = temp / 10_i64;
                continue l8;
            };
        };
    }
}

fn "core:prelude/primitive.wado/count_digits_u64_base"(val_i64, bits_per_digit) {
    let highest_bit: i32;
    let b_4: i32;
    let b_5: i32;
    if val_i64 == 0_i64 {
        return 1;
    }
    highest_bit = 0;
    if ((val_i64 >> 32_i64) & 4294967295_i64) != 0_i64 {
        b_4 = 63;
        b11: block {
            l12: loop {
                break_if b11 b_4 < 32;
                if ((val_i64 >> builtin::i64_extend_i32_s(b_4)) & 1_i64) != 0_i64 {
                    highest_bit = b_4;
                    break b11;
                }
                b_4 = b_4 - 1;
                continue l12;
            };
        };
    } else {
        b_5 = 31;
        b14: block {
            l15: loop {
                break_if b14 b_5 < 0;
                if ((val_i64 >> builtin::i64_extend_i32_s(b_5)) & 1_i64) != 0_i64 {
                    highest_bit = b_5;
                    break b14;
                }
                b_5 = b_5 - 1;
                continue l15;
            };
        };
    }
    return (highest_bit / bits_per_digit) + 1;
}

fn "core:prelude/primitive.wado/write_u64_base_digits"(arr, offset, val_i64, digit_count, bits_per_digit, mask, upper) {
    let mask64: i64;
    let pos: i32;
    let temp: i64;
    let digit: i32;
    mask64 = builtin::i64_extend_i32_s(mask);
