fn "core:prelude/string.wado/encode_char"(repr, pos, code) {
    if code <u 128 {
        builtin::array_set_u8(repr, pos, code & 255);
        return 1;
    }
    if code <u 2048 {
        builtin::array_set_u8(repr, pos, (192 | (code >>u 6)) & 255);
