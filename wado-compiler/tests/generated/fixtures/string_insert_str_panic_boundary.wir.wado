            break_if b81 i >= digit_count_4;
            pos = pos - 1;
            builtin::array_set_u8(arr, pos, (48 + builtin::i32_wrap_i64(t %u 10_i64)) & 255);
            t = t /u 10_i64;
            i = i + 1;
            continue l82;
        };
    };
}

export fn "string_insert_str_panic_boundary.wado/$cm_export__run" as "run"
