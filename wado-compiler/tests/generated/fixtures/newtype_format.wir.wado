export fn "newtype_format.wado/$cm_export__$test_0_display_drops_the_inspect_cast" as "$test_0_display_drops_the_inspect_cast"
export fn "newtype_format.wado/$cm_export__$test_1_newtype_inherits_the_base_s_alternate_formats" as "$test_1_newtype_inherits_the_base_s_alternate_formats"
