    let pos: i32;
    let t: u64;
    let i: i32;
    is_negative = self < 0;
    val_6 = builtin::i64_extend_i32_s(self);
    digit_count_4 = "core:prelude/primitive.wado/count_digits_u64"(local.tee abs_val(select i64(val_6 < 0_i64, 0_i64 - val_6, val_6)));
    offset_5 = "core:prelude/format.wado/core:prelude/format.wado/Formatter::prepare_int_write<core:prelude/string.wado/String>$spec0$scalar"(f, is_negative, digit_count_4);
    arr = f.repr;
    pos = offset_5 + digit_count_4;
    t = abs_val;
    i = 0;
    b431: block {
        l432: loop {
            break_if b431 i >= digit_count_4;
            pos = pos - 1;
            builtin::array_set_u8(arr, pos, (48 + builtin::i32_wrap_i64(t %u 10_i64)) & 255);
            t = t /u 10_i64;
            i = i + 1;
            continue l432;
        };
    };
}

