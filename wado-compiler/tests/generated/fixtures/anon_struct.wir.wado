fn "core:prelude/primitive.wado/write_decimal_digits"(arr, offset, val, digit_count) {
    let q: u64;
    let pair: i32;
    let tens: i32;
    digit_count = offset + digit_count;
    b91: block {
        l92: loop {
            break_if b91 (digit_count - offset) < 2;
            q = val /u 100_i64;
            tens = local.tee pair(builtin::i32_wrap_i64(val - (q * 100_i64))) / 10;
            builtin::array_set_u8(arr, digit_count - 1, (48 + pair) - (tens * 10));
            builtin::array_set_u8(arr, digit_count - 2, 48 + tens);
            digit_count = digit_count - 2;
            val = q;
            continue l92;
        };
    };
    if digit_count > offset {
        builtin::array_set_u8(arr, offset, 48 + builtin::i32_wrap_i64(val %u 10_i64));
    }
}

fn "core:prelude/primitive.wado/count_digits_u64"(val) {
    if val <u 100000_i64 {
        if val <u 100_i64 {
            if val <u 10_i64 {
                return 1;
            }
            return 2;
        }
        if val <u 1000_i64 {
            return 3;
        }
        if val <u 10000_i64 {
