fn "core:prelude/primitive.wado/write_decimal_digits"(arr, offset, val, digit_count) {
    let q: u64;
    let pair: i32;
    let tens: i32;
    digit_count = offset + digit_count;
    b18: block {
        l19: loop {
            break_if b18 (digit_count - offset) < 2;
            q = val /u 100_i64;
            tens = local.tee pair(builtin::i32_wrap_i64(val - (q * 100_i64))) / 10;
            builtin::array_set_u8(arr, digit_count - 1, ((48 + pair) - (tens * 10)) & 255);
            builtin::array_set_u8(arr, digit_count - 2, (48 + tens) & 255);
            digit_count = digit_count - 2;
            val = q;
            continue l19;
        };
    };
    if digit_count > offset {
        builtin::array_set_u8(arr, offset, (48 + builtin::i32_wrap_i64(val %u 10_i64)) & 255);
    }
}

fn "core:prelude/primitive.wado/count_digits_u64"(val) {
    if val <u 100000_i64 {
        if val <u 100_i64 {
            if val <u 10_i64 {
                return 1;
            }
            return 2;
        }
        if val <u 1000_i64 {
            return 3;
        }
        if val <u 10000_i64 {
            return 4;
        }
        return 5;
    }
    if val <u 10000000000_i64 {
        if val <u 10000000_i64 {
            if val <u 1000000_i64 {
                return 6;
            }
            return 7;
        }
        if val <u 100000000_i64 {
            return 8;
        }
        if val <u 1000000000_i64 {
            return 9;
        }
        return 10;
    }
    if val <u 1000000000000000_i64 {
        if val <u 1000000000000_i64 {
            if val <u 100000000000_i64 {
                return 11;
            }
            return 12;
        }
        if val <u 10000000000000_i64 {
            return 13;
        }
        if val <u 100000000000000_i64 {
            return 14;
        }
        return 15;
    }
    if val <u 100000000000000000_i64 {
        if val <u 10000000000000000_i64 {
            return 16;
        }
        return 17;
    }
    if val <u 1000000000000000000_i64 {
        return 18;
    }
    if val <u -8446744073709551616_i64 {
        return 19;
    }
    return 20;
}

fn "core:prelude/types.wado/write_copy_is_final"(written) {
    return (if written.result != 0 -> i32 {
        1;
    } else {
        written.count <= 0;
