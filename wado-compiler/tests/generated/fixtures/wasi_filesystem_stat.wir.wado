fn "wasi_filesystem_stat.wado/run"() with Stdout, Stderr, Preopens {
    let dirs: ref "core:prelude//List<[wasi:filesystem/types.wado/Descriptor,core:prelude/string.wado/String]>";
    let dir: i32;
    let stat_result: ref "core:prelude/types.wado//Result<wasi:filesystem/types.wado/DescriptorStat,wasi:filesystem/types.wado/ErrorCode>";
