            break_if b153 i >= digit_count_4;
            pos = pos - 1;
            builtin::array_set_u8(arr, pos, (48 + builtin::i32_wrap_i64(t %u 10_i64)) & 255);
            t = t /u 10_i64;
            i = i + 1;
            continue l154;
        };
    };
}

export fn "operator_precedence.wado/$cm_export__$test_0_arithmetic_precedence" as "$test_0_arithmetic_precedence"
export fn "operator_precedence.wado/$cm_export__$test_1_assignment_precedence" as "$test_1_assignment_precedence"
export fn "operator_precedence.wado/$cm_export__$test_2_bitwise_precedence" as "$test_2_bitwise_precedence"
export fn "operator_precedence.wado/$cm_export__$test_3_bitwise_vs_comparison_precedence" as "$test_3_bitwise_vs_comparison_precedence"
export fn "operator_precedence.wado/$cm_export__$test_4_comparison_chaining" as "$test_4_comparison_chaining"
export fn "operator_precedence.wado/$cm_export__$test_5_comparison_vs_logical_precedence" as "$test_5_comparison_vs_logical_precedence"
export fn "operator_precedence.wado/$cm_export__$test_6_parentheses" as "$test_6_parentheses"
export fn "operator_precedence.wado/$cm_export__$test_7_shift_vs_arithmetic_precedence" as "$test_7_shift_vs_arithmetic_precedence"
export fn "operator_precedence.wado/$cm_export__$test_8_unary_precedence" as "$test_8_unary_precedence"
