    builtin::array_copy<u8>(local.tee new_repr(builtin::array_new<u8>(new_capacity)), 0, self.repr, 0, self.used);
    self.repr = new_repr;
}

fn "core:prelude/string.wado/core:prelude/string.wado/String::grow"(self, min_capacity) {
    let capacity: i32;
    capacity = builtin::array_len(self.repr);
    if min_capacity <= capacity {
        return;
    }
    "core:prelude/string.wado/core:prelude/string.wado/String::realloc_to"(self, select i32(min_capacity > 8, local.tee min_capacity(select i32(capacity > min_capacity, local.tee capacity(capacity * 2), min_capacity)), 8));
}

export fn "tagged_template_tag_default_arg.wado/$cm_export__run" as "run"
