    }
    builtin::array_set<ref "core:collections//TreeMapNode<core:prelude/string.wado/String>">(self.repr, used, value_50);
    self.used = used + 1;
    return struct.new "core:prelude/types.wado//Option<i32>::Some" { discriminant: 0, payload_0: new_idx };
}

export fn "from_literal_return.wado/$cm_export__run" as "run"
