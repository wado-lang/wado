    if @unlikely(local.tee new_used(out.used + 2) > builtin::array_len(out.repr)) {
        cold_path;
        "core:prelude/string.wado/core:prelude/string.wado/String::grow"(out, new_used);
    }
    start_9 = out.used;
    out.used = new_used;
    builtin::array_copy<u8>(out.repr, start_9, self.repr, 0, 2);
}

