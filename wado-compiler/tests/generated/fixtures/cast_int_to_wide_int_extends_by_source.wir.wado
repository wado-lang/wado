        "core:prelude/primitive.wado/write_decimal_digits"(arr, digit_count - 19, bottom, 19);
    }
    "core:prelude/primitive.wado/write_decimal_digits"(arr, is_neg, top, top_digits);
}

export fn "cast_int_to_wide_int_extends_by_source.wado/$cm_export__run" as "run"
