            }
            return 2;
        }
        if (val < 1000) {
            return 3;
        }
        if (val < 10000) {
            return 4;
        }
        return 5;
    }
    if (val < 10000000000) {
        if (val < 10000000) {
            if (val < 1000000) {
                return 6;
            }
            return 7;
        }
        if (val < 100000000) {
            return 8;
        }
        if (val < 1000000000) {
            return 9;
        }
        return 10;
    }
    if (val < 1000000000000000) {
        if (val < 1000000000000) {
            if (val < 100000000000) {
                return 11;
            }
            return 12;
        }
        if (val < 10000000000000) {
            return 13;
        }
        if (val < 100000000000000) {
            return 14;
        }
        return 15;
    }
    if (val < 100000000000000000) {
        if (val < 10000000000000000) {
            return 16;
        }
        return 17;
    }
    if (val < 1000000000000000000) {
        return 18;
    }
    if (val < 10000000000000000000) {
        return 19;
    }
    return 20;
}

