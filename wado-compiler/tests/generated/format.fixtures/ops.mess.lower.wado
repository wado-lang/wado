    Empty,
    InvalidDigit,
    PosOverflow,
    NegOverflow,
}

pub enum FloatErrorKind {
    Empty,
    Invalid,
}

pub enum CharErrorKind {
    Empty,
    TooManyChars,
}

pub enum Ordering {
    Less,
    Equal,
    Greater,
}

pub enum CaseStyle {
    Identity,
    Camel,
    Snake,
    ScreamingSnake,
    Pascal,
    Kebab,
    ScreamingKebab,
}

pub enum CopyResult {
    Completed,
    Dropped,
    Cancelled,
}

pub enum ErrorCode {
    Io,
    IllegalByteSequence,
    Pipe,
}

fn grow_memory(new_offset: i32) {
    let current_bytes: i32 = (core::builtin::memory_size() * core::allocator::PAGE_SIZE);
    let deficit: i32 = (new_offset - current_bytes);
    let sixteen_mb: i32 = 16777216;
    let normal_grow: i32 = if (current_bytes < sixteen_mb) {
        current_bytes;
    } else {
        sixteen_mb;
    };
    let grow_bytes: i32 = if (deficit > normal_grow) {
        (1 << (32 - core::builtin::i32_clz((deficit - 1))));
    } else {
        normal_grow;
    };
    let grow_pages: i32 = (((grow_bytes + core::allocator::PAGE_SIZE) - 1) / core::allocator::PAGE_SIZE);
    if (core::builtin::memory_grow(grow_pages) < 0) {
        core::builtin::cold_path();
        core::builtin::unreachable();
    }
}

pub export fn bump_realloc(oldptr: i32, oldsize: i32, align: i32, newsize: i32) -> i32 {
    if (newsize == 0) {
        if ((oldptr + oldsize) == core::allocator::heap_offset) {
            core::allocator::heap_offset = oldptr;
        }
        return 0;
    }
    let aligned: i32 = core::builtin::i32_and(((core::allocator::heap_offset + align) - 1), (0 - align));
    let new_offset: i32 = (aligned + newsize);
    if (new_offset > (core::builtin::memory_size() * core::allocator::PAGE_SIZE)) {
        core::builtin::cold_path();
        core::allocator::grow_memory(new_offset);
    }
    core::allocator::heap_offset = new_offset;
    return aligned;
}

pub export fn debug_realloc(oldptr: i32, oldsize: i32, align: i32, newsize: i32) -> i32 {
    if (newsize == 0) {
        if (oldsize > 0) {
            core::builtin::memory_fill(oldptr, 255, oldsize);
        }
        return 0;
    }
    let aligned: i32 = core::builtin::i32_and(((core::allocator::heap_offset + align) - 1), (0 - align));
    let new_offset: i32 = (aligned + newsize);
    if (new_offset > (core::builtin::memory_size() * core::allocator::PAGE_SIZE)) {
        core::builtin::cold_path();
        core::allocator::grow_memory(new_offset);
    }
    core::allocator::heap_offset = new_offset;
    return aligned;
}

fn fl_size(tag: i32) -> i32 {
    return core::builtin::i32_and(tag, -8);
}

fn fl_used(tag: i32) -> i32 {
    return core::builtin::i32_and(tag, 1);
}

fn fl_bin(size: i32) -> i32 {
    let k: i32 = ((size - 32) >> 4);
    return if (k < 32) {
        k;
    } else {
        32;
    };
}

fn fl_bin_head(k: i32) -> i32 {
    return core::builtin::i32_load((8 + (k * 4)));
}

fn fl_set_bin_head(k: i32, head: i32) {
    core::builtin::i32_store((8 + (k * 4)), head);
}

fn fl_set_tags(block: i32, size: i32, used: i32) {
    let tag: i32 = (size + used);
    core::builtin::i32_store(block, tag);
    core::builtin::i32_store(((block + size) - 8), tag);
}

fn fl_push(block: i32, size: i32) {
