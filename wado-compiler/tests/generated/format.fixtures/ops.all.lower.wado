fn fl_size(tag: u32) -> u32 {
    return (tag & 4294967288);
}

fn fl_used(tag: u32) -> u32 {
    return (tag & 1);
}

fn fl_bin(size: u32) -> u32 {
    let k: u32 = ((size - 32) >> 4);
    return if (k < 32) {
        k;
    } else {
        32;
    };
}

fn fl_bin_slot(k: u32) -> u32 {
    return ((core::builtin::heap_base() as u32 + 8) + (k * 4));
}

fn fl_bin_head(k: u32) -> u32 {
    return core::allocator::load(core::allocator::fl_bin_slot(k));
}

fn fl_set_bin_head(k: u32, head: u32) {
    core::allocator::store(core::allocator::fl_bin_slot(k), head);
