fn fl_push(block: u32, size: u32) {
    let k: u32 = core::allocator::fl_bin(size);
    let head: u32 = core::allocator::fl_bin_head(k);
    core::allocator::store((block + 8), head);
    core::allocator::store((block + 12), 0);
    if (head != 0) {
        core::allocator::store((head + 12), block);
    }
    core::allocator::fl_set_bin_head(k, block);
