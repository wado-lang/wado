}

fn memory_bytes() -> u64 {
    return (core::builtin::memory_size() as u64 * core::allocator::PAGE_SIZE);
}

fn pages(bytes: u64) -> i32 {
    return (((bytes + core::allocator::PAGE_SIZE) - 1) / core::allocator::PAGE_SIZE) as i32;
}

fn grow_memory(end: u64) {
    let current_bytes: u64 = core::allocator::memory_bytes();
    let deficit: u64 = (end - current_bytes);
    let sixteen_mb: u64 = 16777216;
    let normal_grow: u64 = if (current_bytes < sixteen_mb) {
        current_bytes;
    } else {
        sixteen_mb;
    };
    let grow_bytes: u64 = if (deficit > normal_grow) {
        (1 << (64 - core::builtin::i64_clz((deficit - 1) as i64)) as u64);
    } else {
        normal_grow;
    };
    if ((core::builtin::memory_grow(core::allocator::pages(grow_bytes)) < 0) && (core::builtin::memory_grow(core::allocator::pages(deficit)) < 0)) {
        core::builtin::cold_path();
        core::builtin::unreachable();
    }
}

fn bump(align: u32, size: u64) -> u32 {
    let mask: u64 = (align as u64 - 1);
    let start: u64 = ((core::allocator::frontier() as u64 + mask) & ~mask);
    let end: u64 = (start + size);
    if (end > core::allocator::MAX_ADDRESS) {
        core::builtin::cold_path();
        core::builtin::unreachable();
    }
    if (end > core::allocator::memory_bytes()) {
        core::builtin::cold_path();
        core::allocator::grow_memory(end);
    }
    core::allocator::set_frontier(end as u32);
    return start as u32;
}

pub export fn debug_realloc(oldptr: i32, oldsize: i32, align: i32, newsize: i32) -> i32 {
    if (newsize == 0) {
        if (oldptr != 0) {
            let tag: u32 = (oldptr as u32 - 4);
            if (core::allocator::load(tag) != core::allocator::DEBUG_LIVE) {
                core::builtin::cold_path();
                core::builtin::unreachable();
            }
            core::allocator::store(tag, 4294967295);
            if (oldsize != 0) {
                core::builtin::memory_fill(oldptr, 255, oldsize);
            }
        }
        return 0;
    }
    let gap: u32 = if (align < 4) {
        4;
    } else {
        align as u32;
    };
    let block: u32 = (core::allocator::bump(align as u32, (gap as u64 + newsize as u32 as u64)) + gap);
    core::allocator::store((block - 4), core::allocator::DEBUG_LIVE);
    return block as i32;
