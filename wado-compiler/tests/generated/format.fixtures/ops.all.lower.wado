fn frontier() -> u32 {
    return (core::builtin::heap_base() as u32 + core::allocator::heap_offset);
}

fn set_frontier(addr: u32) {
    core::allocator::heap_offset = (addr - core::builtin::heap_base() as u32);
}

fn load(addr: u32) -> u32 {
    return core::builtin::i32_load(addr as i32) as u32;
}

fn store(addr: u32, value: u32) {
