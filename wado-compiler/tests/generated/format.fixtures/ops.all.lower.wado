            }
        }
        core::allocator::fl_set_tags(block, size, 0);
        core::allocator::fl_push(block, size);
        return 0;
    }
    let wide_size: u64 = (((newsize as u32 as u64 + 15) & 18446744073709551600) + 16);
    if (wide_size > core::allocator::MAX_ADDRESS) {
