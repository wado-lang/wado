// Operator precedence tests - messy version
// with inconsistent spacing and block comments everywhere


/// Arithmetic: redundant parens (will be removed by formatter)
test "arithmetic" {
    // mul before add
    assert 1 + 2 * 3 == 7;


    // parens override mul
    assert (1 + 2) * 3 == 9;

    /* also parens override */
    assert 2 * (3 + 4) == 14;

    // both sides of add
    assert 2 * 3 + 4 * 5 == 26;

    assert (10 - 2) * 3 == 24;

    /* subtraction before mul */
    assert 10 - 2 * 3 == 4;
}

/// Left-associativity: redundant parens (will be removed by formatter)
test "left-assoc" {

    // subtraction is left-assoc
    assert 10 - 3 - 2 == 5;

    // right-assoc via parens
    assert 10 - (3 - 2) == 9;

    /* division left-assoc */
    assert 8 / 2 / 2 == 2;
    assert 8 / (2 / 2) == 8;

    // modulo left-assoc
    assert 15 % 7 % 3 == 1;
    assert 15 % (7 % 3) == 0;
}

/// Shift operators: + binds tighter than <<
test "shift" {

    // add first, then shift
    assert 1 + 1 << 3 == 16;

    // shift first (parens required), then add
    assert (1 << 3) + 1 == 9;

    // add on the right of <<
    assert 1 << 2 + 1 == 8;

    /* both sides are shifts */
    assert (1 << 2) + (1 << 1) == 6;

    // shift right then subtract
    assert (16 >> 1) - 1 == 7;
}

/// Bitwise operators: & > ^ > |, all tighter than ==
test "bitwise" {

    /* & is tighter than == */
    assert 0b1100 & 0b1010 == 8;

    // | then & on right
    assert 0b0111 | 0b1010 & 0b0101 == 7;

    // | first, then & masks the result
    assert (0b1100 | 0b0011) & 0b1010 == 10;

    /* ^ then & - & has higher precedence */
    assert 0b1010 ^ 0b1100 & 0b1111 == 6;

    // explicit parens force XOR first
    assert (0b1010 ^ 0b1100) & 0b1111 == 6;

    /* | first, then XOR */
    assert (0b1010 | 0b0110) ^ 0b0001 == 15;
}

/// Logical operators: && binds tighter than ||
test "logical" {

    // && before ||
    let a = true && false || true;
    assert a == true;

    // || needs parens to be evaluated first
    let b = true && (false || true);
    assert b == true;

    /* || needs parens to be evaluated first here too */
    let c = (true || false) && false;
    assert c == false;

    // && on right of || - && still binds tighter
    let d = true || false && true;
    assert d == true;
}

// A command entry so the fixture compiles (golden-dump emits non-empty NIR/WAT
// goldens). The `test` blocks above are the formatter's actual subject.
export fn run() {
}
