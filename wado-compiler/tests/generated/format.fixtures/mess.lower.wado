            let start: i32 = buf.String::len();
            "core::prelude/fpfmt.wado::fill_zeros"(buf, (nd + 1));
            "core::prelude/fpfmt.wado::write_digits_at"(buf, start, d, nd);
            let raw: builtin::array<u8> = buf.String::internal_raw_bytes();
            "core::builtin::core/builtin/array_copy<u8>"(raw, ((start + decimal_pos) + 1), raw, (start + decimal_pos), (nd - decimal_pos));
            buf.String::set_byte_unchecked((start + decimal_pos), '.' as u8);
            "core::prelude/fpfmt.wado::fill_zeros"(buf, trailing);
        }
    }
