fn grow_memory(new_offset: i32) {
    let current_bytes: i32 = (core::builtin::memory_size() * 65536);
    let deficit: i32 = (new_offset - current_bytes);
    let sixteen_mb: i32 = ((16 * 1024) * 1024);
    let normal_grow: i32 = if (current_bytes < sixteen_mb) {
        current_bytes;
    } else {
        sixteen_mb;
    };
    let grow_bytes: i32 = if (deficit > normal_grow) {
        (1 << (32 - core::builtin::i32_clz((deficit - 1))));
    } else {
        normal_grow;
    };
    let grow_pages: i32 = ((grow_bytes + 65535) / 65536);
    core::builtin::memory_grow(grow_pages);
}

export fn bump_realloc(oldptr: i32, oldsize: i32, align: i32, newsize: i32) -> i32 {
    if (newsize == 0) {
        if ((oldptr + oldsize) == core::allocator::heap_offset) {
            core::allocator::heap_offset = oldptr;
        }
        return 0;
    }
    let aligned: i32 = core::builtin::i32_and(((core::allocator::heap_offset + align) - 1), (0 - align));
    let new_offset: i32 = (aligned + newsize);
    if core::builtin::unlikely((new_offset > (core::builtin::memory_size() * 65536))) {
        core::allocator::grow_memory(new_offset);
    }
    core::allocator::heap_offset = new_offset;
    return aligned;
}

export fn debug_realloc(oldptr: i32, oldsize: i32, align: i32, newsize: i32) -> i32 {
    if (newsize == 0) {
        if (oldsize > 0) {
            core::builtin::memory_fill(oldptr, 0xFF, oldsize);
        }
        return 0;
    }
    let aligned: i32 = core::builtin::i32_and(((core::allocator::heap_offset + align) - 1), (0 - align));
    let new_offset: i32 = (aligned + newsize);
    if core::builtin::unlikely((new_offset > (core::builtin::memory_size() * 65536))) {
        core::allocator::grow_memory(new_offset);
    }
    core::allocator::heap_offset = new_offset;
    return aligned;
}

export fn freelist_realloc(oldptr: i32, oldsize: i32, align: i32, newsize: i32) -> i32 {
    if (newsize == 0) {
        if (oldsize == 0) {
            return 0;
        }
        if (oldptr == core::allocator::free_list) {
            core::builtin::unreachable();
        }
        let size: i32 = core::builtin::i32_and((oldsize + 7), -8);
        core::builtin::i32_store(oldptr, size);
        core::builtin::i32_store((oldptr + 4), core::allocator::free_list);
        core::allocator::free_list = oldptr;
        return 0;
    }
    let size: i32 = core::builtin::i32_and((newsize + 7), -8);
    let mut prev: i32 = 0;
    let mut curr: i32 = core::allocator::free_list;
    loop {
        if !(curr != 0) {
            break;
        }
        let block_size: i32 = core::builtin::i32_load(curr);
        let next: i32 = core::builtin::i32_load((curr + 4));
        if ((block_size >= size) && (core::builtin::i32_and(curr, (align - 1)) == 0)) {
            if (prev == 0) {
                core::allocator::free_list = next;
            } else {
                core::builtin::i32_store((prev + 4), next);
            }
            let remainder: i32 = (block_size - size);
            if (remainder >= 16) {
                let rem_ptr: i32 = (curr + size);
                core::builtin::i32_store(rem_ptr, remainder);
                core::builtin::i32_store((rem_ptr + 4), core::allocator::free_list);
                core::allocator::free_list = rem_ptr;
            }
            return curr;
        }
        prev = curr;
        curr = next;
    }
    let aligned: i32 = core::builtin::i32_and(((core::allocator::heap_offset + align) - 1), (0 - align));
    let new_offset: i32 = (aligned + size);
    if core::builtin::unlikely((new_offset > (core::builtin::memory_size() * 65536))) {
        core::allocator::grow_memory(new_offset);
    }
    core::allocator::heap_offset = new_offset;
    return aligned;
}

