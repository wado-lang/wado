fn digit_value(b: u8) -> i32 {
    let c: i32 = b as i32;
    if ((c >= '0' as i32) && (c <= '9' as i32)) {
        return (c - '0' as i32);
    }
    if ((c >= 'a' as i32) && (c <= 'z' as i32)) {
        return ((c - 'a' as i32) + 10);
    }
    if ((c >= 'A' as i32) && (c <= 'Z' as i32)) {
        return ((c - 'A' as i32) + 10);
    }
    return -1;
}

fn range_in_bounds(s: &String, start: i32, end: i32) -> bool {
    return (((start >= 0) && (end <= s.String::len())) && (start <= end));
}

