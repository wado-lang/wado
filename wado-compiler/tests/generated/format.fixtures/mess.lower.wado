    }
    let abs_exp: i32 = if (exp < 0) {
        -exp;
    } else {
        exp;
    };
    if (abs_exp < 10) {
        buf.String::push("core::prelude/primitive.wado::char::from_u32_unchecked"(('0' as u32 + abs_exp as u32)));
    } else {
        if (abs_exp < 100) {
