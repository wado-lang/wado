    }
    let mantissa_bits: u64 = (m & ~bit52);
    let exp_bits: u64 = ((1075 + e) as u64 << 52);
    return "core::prelude/primitive.wado::f64::from_bits"((mantissa_bits | exp_bits) as i64);
}

pub fn parse(d: u64, p: i32) -> f64 {
    let b: i32 = "core::prelude/fpfmt.wado::u64_bit_len"(d);
