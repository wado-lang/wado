pub fn "SpecialKind^Inspect::inspect"(self: &SpecialKind, f: &mut Formatter) {
    if (*self == 0) {
        f.Formatter::write_str("SpecialKind::NotSpecial");
    } else {
        if (*self == 1) {
            f.Formatter::write_str("SpecialKind::Zero");
        } else {
            if (*self == 2) {
                f.Formatter::write_str("SpecialKind::Inf");
            } else {
                if (*self == 3) {
                    f.Formatter::write_str("SpecialKind::NaN");
                };
            };
        };
    };
}

pub fn "UnpackResult^Inspect::inspect"(self: &UnpackResult, f: &mut Formatter) {
