    let mut e: i32 = "core::prelude/primitive.wado::i32::min"(1074, ((53 - b) - lp));
    let x: u64 = (d << (64 - b) as u64);
    let pm: PmHiLo = "core::prelude/fpfmt.wado::get_pow10"(p);
    let s_val: i32 = -(((e - (64 - b)) + lp) + 3);
    let mut u: u64 = "core::prelude/fpfmt.wado::uscale"(x, pm.hi, pm.lo, s_val);
    let unmin_val: u64 = ((1 as u64 << 55) - 2);
    let shift: u64 = (u >= unmin_val) as u64;
    u = ((u >> shift) | (u & 1));
    e = (e - shift as i32);
    return "core::prelude/fpfmt.wado::pack64"("core::prelude/fpfmt.wado::unrounded_round"(u), -e);
}

pub fn parse_text_range(s: &String, start: i32, end: i32) -> Option<f64> {
