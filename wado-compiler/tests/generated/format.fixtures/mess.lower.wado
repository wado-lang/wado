        return null;
    }
    if (d == 0) {
        return Option<f64>::Some(core::builtin::f64_copysign(0.0, sign));
    }
    let eff_p: i32 = (p - frac);
    if (eff_p > 350) {
        return Option<f64>::Some(core::builtin::f64_copysign((1.0 / 0.0), sign));
    }
    if (eff_p < -351) {
        return Option<f64>::Some(core::builtin::f64_copysign(0.0, sign));
    }
    let val: f64 = "core::prelude/fpfmt.wado::parse"(d, eff_p);
    return Option<f64>::Some(core::builtin::f64_copysign(val, sign));
