pub fn pow10(n: i32) -> u64 {
    return core::prelude/fpfmt.wado::POW10."Array<u64>^IndexValue<i32>::index_value"(n);
}

pub fn u64_bit_len(x: u64) -> i32 {
    return (64 - core::builtin::i64_clz(x as i64) as i32);
}

pub fn log10_pow2(x: i32) -> i32 {
    return ((x * 78913) >> 18);
}

pub fn log2_pow10(x: i32) -> i32 {
    return ((x * 108853) >> 15);
}

pub fn unpack64(f: f64) -> UnpackResult {
    let bits: u64 = Box<f64> { value: f }.f64::to_bits() as u64;
    let mantissa_mask: u64 = 0x000FFFFFFFFFFFFF;
    let exp_mask: u64 = 0x7FF;
    let shift: i32 = (64 - 53);
    let shift_u64: u64 = shift as u64;
    let min_exp: i32 = -(1074 + shift);
    let raw_mantissa: u64 = (bits & mantissa_mask);
    let raw_exp: i32 = ((bits >> 52) & exp_mask) as i32;
    if (raw_exp == 0) {
        if (raw_mantissa == 0) {
            return UnpackResult { mantissa: 0, exponent: 0 };
        }
        let m: u64 = (raw_mantissa << shift_u64);
        let e: i32 = min_exp;
        let s: u64 = (64 - "core::prelude/fpfmt.wado::u64_bit_len"(m)) as u64;
        return UnpackResult { mantissa: (m << s), exponent: (e - s as i32) };
    }
    let m: u64 = (0x8000000000000000 | (raw_mantissa << shift_u64));
    let e: i32 = ((raw_exp - 1) + min_exp);
    return UnpackResult { mantissa: m, exponent: e };
}

pub fn unpack32(f: f32) -> UnpackResult {
    let bits: u32 = Box<f32> { value: f }.f32::to_bits() as u32;
    let mantissa_mask: u32 = 0x007FFFFF;
    let exp_mask: u32 = 0xFF;
    let shift: i32 = (64 - 24);
    let shift_u64: u64 = shift as u64;
    let min_exp: i32 = -(149 + shift);
    let raw_mantissa: u64 = (bits & mantissa_mask) as u64;
    let raw_exp: i32 = ((bits >> 23) & exp_mask) as i32;
    if (raw_exp == 0) {
        if (raw_mantissa == 0) {
            return UnpackResult { mantissa: 0, exponent: 0 };
        }
        let m: u64 = (raw_mantissa << shift_u64);
        let e: i32 = min_exp;
        let s: u64 = (64 - "core::prelude/fpfmt.wado::u64_bit_len"(m)) as u64;
        return UnpackResult { mantissa: (m << s), exponent: (e - s as i32) };
    }
    let m: u64 = (0x8000000000000000 | (raw_mantissa << shift_u64));
    let e: i32 = ((raw_exp - 1) + min_exp);
