        return null;
    }
    let mut p: i32 = 0;
    if ((i < len) && ((s.String::get_byte_unchecked(i) == 'e' as u8) || (s.String::get_byte_unchecked(i) == 'E' as u8))) {
        i = (i + 1);
        let mut exp_sign: i32 = 1;
