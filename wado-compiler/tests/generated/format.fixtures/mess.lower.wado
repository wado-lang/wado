                let c4: u8 = s.String::get_byte_unchecked((i + 4));
                let c5: u8 = s.String::get_byte_unchecked((i + 5));
                let c6: u8 = s.String::get_byte_unchecked((i + 6));
                let c7: u8 = s.String::get_byte_unchecked((i + 7));
                if ((((((c3 == 'i' as u8) || (c3 == 'I' as u8)) && ((c4 == 'n' as u8) || (c4 == 'N' as u8))) && ((c5 == 'i' as u8) || (c5 == 'I' as u8))) && ((c6 == 't' as u8) || (c6 == 'T' as u8))) && ((c7 == 'y' as u8) || (c7 == 'Y' as u8))) {
                    return Option<f64>::Some(core::builtin::f64_copysign((1.0 / 0.0), sign));
                }
            }
        }
        return null;
    }
    if (((c0 == 'n' as u8) || (c0 == 'N' as u8)) && (remaining == 3)) {
