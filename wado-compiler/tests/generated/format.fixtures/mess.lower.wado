            }
            i = (i + 1);
        }
    }
    let int_digits: i32 = (i - digit_start);
    if ((i < len) && (s.String::get_byte_unchecked(i) == '.' as u8)) {
        if (int_digits == 0) {
            return null;
        }
        i = (i + 1);
        let frac_start: i32 = i;
        __for_1: {
            loop {
                if !(((i < len) && (s.String::get_byte_unchecked(i) >= '0' as u8)) && (s.String::get_byte_unchecked(i) <= '9' as u8)) {
                    break __for_1;
                }
                __for_1_body: {
                    d = ((d * 10) + (s.String::get_byte_unchecked(i) - '0' as u8) as u64);
                    frac = (frac + 1);
                }
                i = (i + 1);
            }
        }
        if (i == frac_start) {
