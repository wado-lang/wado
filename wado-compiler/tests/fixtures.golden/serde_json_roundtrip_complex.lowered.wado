fn _fullstruct_field_lookup(key: &String) -> Option<i32> {
    if key."String^Eq::eq"(&"name") {
        return Option<i32>::Some(0);
    }
    if key."String^Eq::eq"(&"age") {
        return Option<i32>::Some(1);
    }
    if key."String^Eq::eq"(&"score") {
        return Option<i32>::Some(2);
    }
    if key."String^Eq::eq"(&"active") {
        return Option<i32>::Some(3);
    }
    if key."String^Eq::eq"(&"tags") {
        return Option<i32>::Some(4);
    }
    if key."String^Eq::eq"(&"address") {
        return Option<i32>::Some(5);
    }
    if key."String^Eq::eq"(&"rating") {
        return Option<i32>::Some(6);
    }
    return Option<i32>::None;
}

