fn apply_align(align: Align) -> String {
    let mut result: String = move "";
    return match align {
        Left => {
            result = move "left";
            result;
        },
        Center => {
            result = move "center";
            result;
        },
        Right => {
            result = move "right";
            result;
        },
    };
}

export fn run() with Stdout {
    core::cli::println(move apply_align(move Align::Left));
    core::cli::println(move apply_align(move Align::Center));
    core::cli::println(move apply_align(move Align::Right));
}

