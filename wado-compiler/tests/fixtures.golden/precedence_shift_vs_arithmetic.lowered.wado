fn run() {
    let a: i32 = (1 << (2 + 1));
    assert (a == 8);  // a == 8
    let b: i32 = (16 >> (4 - 2));
    assert (b == 4);  // b == 4
    let c: i32 = (1 << (2 * 2));
    assert (c == 16);  // c == 16
    let d: i32 = (1 << (1 + 2));
    assert (d == 8);  // d == 8
    let e: i32 = ((1 << 2) + 3);
    assert (e == 7);  // e == 7
    let f: i32 = ((64 >> 2) >> 1);
    assert (f == 8);  // f == 8
    let g: i32 = ((1 << 2) << 1);
    assert (g == 8);  // g == 8
    let h: i32 = (8 & (4 << 1));
    assert (h == 8);  // h == 8
    let i: i32 = ((15 >> 1) & 3);
    assert (i == 3);  // i == 3
}

