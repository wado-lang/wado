struct Point {
    x: i32,
    y: i32,
}

struct "Box<String>" {
    value: String,
}

struct "Box<i32>" {
    value: i32,
}

fn run() with Stdout {
    let p: Point = Point { x: 10, y: 20 };
    let p_ref: &Point = &p;
    assert p_ref.sum() == 30;  // (p_ref.sum() == 30)
    assert p_ref.scale(2) == 60;  // (p_ref.scale(2) == 60)
    let p_ref2: &&Point = &p_ref;
    assert p_ref2.sum() == 30;  // (p_ref2.sum() == 30)
    let box_i32: Box<i32> = Box<i32> { value: 42 };
    let box_ref: &Box<i32> = &box_i32;
    assert box_ref.get() == 42;  // (box_ref.get() == 42)
    let box_str: Box<String> = Box<String> { value: "hello" };
    let box_str_ref: &Box<String> = &box_str;
    let inner: T = box_str_ref.get();
    assert inner.len() == 5;  // (inner.len() == 5)
    let s: String = "hello";
    let s_ref: &String = &s;
    assert s_ref.len() == 5;  // (s_ref.len() == 5)
    assert s_ref.get(0) == 'h' as;  // (s_ref.get(0) == 'h' as i32)
    let mut p2: Point = Point { x: 5, y: 10 };
    let p2_mut_ref: &mut Point = &mut p2;
    assert p2_mut_ref.sum() == 15;  // (p2_mut_ref.sum() == 15)
    let p_ref3: &&&Point = &p_ref2;
    assert p_ref3.sum() == 30;  // (p_ref3.sum() == 30)
    core::cli::println("all auto-deref tests passed");
}

