fn "ArrayIter<i32>^Iterator::next"(self: &mut ArrayIter<i32>) -> Option<i32> {
    if (self.index >= self.used) {
        return null;
    }
    let item: i32 = core::builtin::array_get::<i32>(self.repr, self.index);
    self.index = (self.index + 1);
    return Option::Some(item);
}

