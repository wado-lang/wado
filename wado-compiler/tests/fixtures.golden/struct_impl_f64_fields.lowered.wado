struct Circle {
    radius: f64,
}

struct Vector2D {
    x: f64,
    y: f64,
}

pub fn Circle::diameter(self: Circle) -> f64 {
    return (self.radius * 2.0);
}

pub fn Circle::circumference(self: Circle) -> f64 {
    return ((2.0 * 3.14159) * self.radius);
}

pub fn Vector2D::length_squared(self: Vector2D) -> f64 {
    return ((self.x * self.x) + (self.y * self.y));
}

pub fn Vector2D::dot(self: Vector2D, other_x: f64, other_y: f64) -> f64 {
    return ((self.x * other_x) + (self.y * other_y));
}

