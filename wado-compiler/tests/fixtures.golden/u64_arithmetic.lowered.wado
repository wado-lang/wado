fn "Array<i32>^IndexValue::index_value"(self: &Array<i32>, index: i32) -> i32 {
    if (index >= self.used) {
        core::internal::panic(move "index out of bounds");
    }
    return core::builtin::array_get::<i32>(self.repr, index);
}

pub fn "Array<i32>::append"(self: &mut Array<i32>, value: i32) {
    let used: i32 = self.used;
    let capacity: i32 = core::builtin::array_len(self.repr);
    if core::builtin::unlikely((used >= capacity)) {
        let mut new_capacity: i32 = (capacity * 2);
        if (capacity == 0) {
            new_capacity = 4;
        }
        let new_repr: builtin::array<i32> = core::builtin::array_new::<i32>(new_capacity);
        core::builtin::array_copy::<i32>(new_repr, 0, self.repr, 0, used);
        self.repr = new_repr;
    }
    core::builtin::array_set::<i32>(self.repr, used, value);
    self.used = (used + 1);
}

