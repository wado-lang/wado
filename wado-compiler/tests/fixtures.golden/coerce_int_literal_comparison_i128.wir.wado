fn u128^Eq::eq(self, other) {
    return if self.low == other.low -> i32 {
        self.high == other.high;
    } else {
        0;
    };
}

fn u128^Ord::cmp(self, other) {
    if self.high <u other.high {
        return 0;
    };
    if self.high >u other.high {
        return 2;
    };
    if self.low <u other.low {
        return 0;
    };
    if self.low >u other.low {
        return 2;
    };
    return 1;
}

fn i128^Eq::eq(self, other) {
    return if self.low == other.low -> i32 {
        self.high == other.high;
    } else {
        0;
    };
}

fn i128^Ord::cmp(self, other) {
    if self.high < other.high {
        return 0;
    };
    if self.high > other.high {
        return 2;
    };
    if self.low <u other.low {
        return 0;
    };
    if self.low >u other.low {
        return 2;
    };
    return 1;
}

