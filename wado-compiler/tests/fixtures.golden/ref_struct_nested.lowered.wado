struct Inner {
    value: i32,
}

struct Outer {
    inner: Inner,
}

fn get_inner_value(o: &Outer) -> i32 {
    return o.inner.value;
}

fn set_inner_value(o: &mut Outer, v: i32) {
    o.inner.value = v;
}

fn run() with Stdout {
    let mut o: Outer = Outer { inner: Inner { value: 42 } };
    core::cli::println(get_inner_value(&o).to_string());
    set_inner_value(&mut o, 100);
    core::cli::println(get_inner_value(&o).to_string());
}

