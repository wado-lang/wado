fn "core:allocator/grow_memory"(new_offset) {  // from core:allocator
    let current_bytes: i32;
    let deficit: i32;
    let normal_grow: i32;
    let grow_bytes: i32;
    let grow_pages: i32;
    current_bytes = builtin::memory_size() * 65536;
    deficit = new_offset - current_bytes;
    normal_grow = select i32(current_bytes < 16777216, current_bytes, 16777216);
    grow_bytes = if deficit > normal_grow -> i32 {
        1 << (32 - builtin::i32_clz(deficit - 1));
    } else {
        normal_grow;
    };
    grow_pages = (grow_bytes + 65535) / 65536;
    drop(builtin::memory_grow(grow_pages));
}

fn "core:allocator/bump_realloc"(oldptr, oldsize, align, newsize) {  // from core:allocator
    let aligned: i32;
    let new_offset: i32;
    if newsize == 0 {
        if (oldptr + oldsize) == heap_offset {
            heap_offset = oldptr;
        };
        return 0;
    };
    aligned = ((heap_offset + align) - 1) & (0 - align);
    new_offset = aligned + newsize;
    if builtin::unlikely(new_offset > (builtin::memory_size() * 65536)) {
        "core:allocator/grow_memory"(new_offset);
    };
    heap_offset = new_offset;
    return aligned;
}

fn "core:allocator/debug_realloc"(oldptr, oldsize, align, newsize) {  // from core:allocator
    let aligned: i32;
    let new_offset: i32;
    if newsize == 0 {
        if oldsize > 0 {
            builtin::memory_fill(oldptr, 255, oldsize);
        };
        return 0;
    };
    aligned = ((heap_offset + align) - 1) & (0 - align);
    new_offset = aligned + newsize;
    if builtin::unlikely(new_offset > (builtin::memory_size() * 65536)) {
        "core:allocator/grow_memory"(new_offset);
    };
    heap_offset = new_offset;
    return aligned;
}

fn "core:internal/gc_array_to_memory"(arr, ptr, len) {  // from core:internal
    let i: i32;
    __for_1: block {
        i = 0;
        block {
            l46: loop {
                if (i < len) == 0 {
                    break __for_1;
                };
                builtin::store_u8(ptr + i, builtin::array_get_u8(arr, i));
                i = i + 1;
                continue l46;
            };
        };
    };
}

fn "core:internal/cm_lower_string"(s) {  // from core:internal
    let len: i32;
    let bytes: ref array<u8>;
    let ptr: i32;
    len = s.used;
    bytes = s.repr;
    ptr = "mem/realloc"(0, 0, 1, len);
    "core:internal/gc_array_to_memory"(bytes, ptr, len);
    return builtin::i64_extend_i32_s(ptr) | (builtin::i64_extend_i32_s(len) << 32_i64);
