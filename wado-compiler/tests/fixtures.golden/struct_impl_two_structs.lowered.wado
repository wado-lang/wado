struct Point {
    x: i32,
    y: i32,
}

struct Rectangle {
    width: i32,
    height: i32,
}

pub fn Point::sum(self: Point) -> i32 {
    return (self.x + self.y);
}

pub fn Rectangle::area(self: Rectangle) -> i32 {
    return (self.width * self.height);
}

fn run() with Stdout {
    let p: Point = Point { x: 3, y: 4 };
    let r: Rectangle = Rectangle { width: 5, height: 6 };
    core::cli::println(core::internal::string_concat("point sum: ", p.sum().to_string()));
    core::cli::println(core::internal::string_concat("rect area: ", r.area().to_string()));
}

