struct Point {
    x: i32,
    y: i32,
}

fn "Point::sum"(self: &Point) -> i32 {
    return (self.x + self.y);
}

fn "Point::add"(self: &Point, other: &Point) -> Point {
    return Point { x: (self.x + other.x), y: (self.y + other.y) };
}

fn run() with Stdout {
    let loc1: Location = Point { x: 10, y: 20 } as Location;
    let loc2: Location = Point { x: 5, y: 5 } as Location;
    let s: i32 = "Location::sum"(&loc1);
    core::cli::println(move "String::concat"(move "sum: ", move "i32::to_string"(s)));
    let loc3: Location = "Location::add"(&loc1, &loc2);
    core::cli::println(move "String::concat"(move "String::concat"(move "String::concat"(move "String::concat"(move "added: (", move "i32::to_string"(loc3.x)), move ", "), move "i32::to_string"(loc3.y)), move ")"));
}

