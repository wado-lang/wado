struct Point {
    x: i32,
    y: i32,
}

fn Point::new(x: i32, y: i32) -> Point {
    return Point { x: x, y: y };
}

fn Point::scale(p: Point, factor: i32) -> Point {
    return Point { x: (p.x * factor), y: (p.y * factor) };
}

