fn "BTreeNode<String,i32>::new_internal"() -> BTreeNode<String,i32> {
    return BTreeNode<String,i32> { keys: [], values: [], deleted: [], children: [], is_leaf: false };
}

fn "BTreeNode<String,i32>::new_leaf"() -> BTreeNode<String,i32> {
