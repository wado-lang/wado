struct Counter {
    value: i32,
    step: i32,
}

pub fn Counter::get(self: Counter) -> i32 {
    return self.value;
}

pub fn Counter::get_step(self: Counter) -> i32 {
    return self.step;
}

pub fn Counter::double(self: Counter) -> i32 {
    return (self.value * 2);
}

pub fn Counter::add_step(self: Counter) -> i32 {
    return (self.value + self.step);
}

