fn clamp(r: Box<i32>, min: i32, max: i32) {
    if (r.value < min) {
        r.value = min;
    } else {
        if (r.value > max) {
            r.value = max;
        }
    }
}

fn run() with Stdout {
    let mut a: Box<i32> = move Box<i32> { value: 50 };
    clamp(a, 0, 100);
    core::cli::println(move "String::concat"(move "clamped 50: ", move a.value."i32::to_string"()));
    let mut b: Box<i32> = move Box<i32> { value: -10 };
    clamp(b, 0, 100);
    core::cli::println(move "String::concat"(move "clamped -10: ", move b.value."i32::to_string"()));
    let mut c: Box<i32> = move Box<i32> { value: 200 };
    clamp(c, 0, 100);
    core::cli::println(move "String::concat"(move "clamped 200: ", move c.value."i32::to_string"()));
}

