struct Point {
    x: i32,
    y: i32,
}

fn Point::origin() -> Point {
    return Point { x: 0, y: 0 };
}

fn Point::new(x: i32, y: i32) -> Point {
    return Point { x: x, y: y };
}

fn Point::scale(p: Point, factor: i32) -> Point {
    return Point { x: (p.x * factor), y: (p.y * factor) };
}

fn Point::add(a: Point, b: Point) -> Point {
    return Point { x: (a.x + b.x), y: (a.y + b.y) };
}

fn Point::distance_squared(a: Point, b: Point) -> i32 {
    let dx: i32 = (a.x - b.x);
    let dy: i32 = (a.y - b.y);
    return ((dx * dx) + (dy * dy));
}

fn run() with Stdout {
    let p1: Point = Point::scale(Point::origin(), 5);
    core::cli::println(core::internal::string_concat(core::internal::string_concat(core::internal::string_concat(core::internal::string_concat("scaled origin: (", p1.x.to_string()), ", "), p1.y.to_string()), ")"));
    let p2: Point = Point::add(Point::new(1, 2), Point::new(3, 4));
    core::cli::println(core::internal::string_concat(core::internal::string_concat(core::internal::string_concat(core::internal::string_concat("sum of points: (", p2.x.to_string()), ", "), p2.y.to_string()), ")"));
    let dist: i32 = Point::distance_squared(Point::origin(), Point::new(3, 4));
    core::cli::println(core::internal::string_concat("distance squared: ", dist.to_string()));
}

