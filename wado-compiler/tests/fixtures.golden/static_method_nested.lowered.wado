struct Point {
    x: i32,
    y: i32,
}

fn Point::add(a: Point, b: Point) -> Point {
    return Point { x: (a.x + b.x), y: (a.y + b.y) };
}

fn Point::distance_squared(a: Point, b: Point) -> i32 {
    let dx: i32 = (a.x - b.x);
    let dy: i32 = (a.y - b.y);
    return ((dx * dx) + (dy * dy));
}

