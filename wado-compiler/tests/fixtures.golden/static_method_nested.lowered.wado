    x: i32,
    y: i32,
}

fn "Point::origin"() -> Point {
    return Point { x: 0, y: 0 };
}

fn "Point::new"(x: i32, y: i32) -> Point {
    return Point { x: x, y: y };
}

fn "Point::scale"(p: Point, factor: i32) -> Point {
    return Point { x: (p.x * factor), y: (p.y * factor) };
}

fn "Point::add"(a: Point, b: Point) -> Point {
    return Point { x: (a.x + b.x), y: (a.y + b.y) };
}

fn "Point::distance_squared"(a: Point, b: Point) -> i32 {
    let dx: i32 = (a.x - b.x);
    let dy: i32 = (a.y - b.y);
    return ((dx * dx) + (dy * dy));
}

