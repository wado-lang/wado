fn "Array<u8>^IndexValue::index_value"(self: &Array<u8>, index: i32) -> u8 {
    if (index >= self.used) {
        core::internal::panic(move "index out of bounds");
    }
    return core::builtin::array_get::<u8>(self.repr, index);
}

pub fn "Array<u8>::append"(self: &mut Array<u8>, value: u8) {
    let used: i32 = self.used;
    let capacity: i32 = core::builtin::array_len(self.repr);
    if core::builtin::unlikely((used >= capacity)) {
        let mut new_capacity: i32 = (capacity * 2);
        if (capacity == 0) {
            new_capacity = 4;
        }
        let new_repr: builtin::array<u8> = core::builtin::array_new::<u8>(new_capacity);
        core::builtin::array_copy::<u8>(new_repr, 0, self.repr, 0, used);
        self.repr = new_repr;
    }
    core::builtin::array_set::<u8>(self.repr, used, value);
    self.used = (used + 1);
}

