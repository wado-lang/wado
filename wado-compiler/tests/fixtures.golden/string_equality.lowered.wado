fn run() with Stdout {
    let a: String = "hello";
    let b: String = "hello";
    let c: String = "world";
    assert core::internal::string_eq(&a, &b);  // a == b
    assert !core::internal::string_eq(&a, &c);  // a != c
    assert !core::internal::string_eq(&a, &c);  // !(a == c)
    assert !!core::internal::string_eq(&a, &b);  // !(a != b)
    let empty1: String = "";
    let empty2: String = "";
    assert core::internal::string_eq(&empty1, &empty2);  // empty1 == empty2
    let short: String = "hi";
    let long: String = "hello";
    assert !core::internal::string_eq(&short, &long);  // short != long
    let hello1: String = "hello1";
    let hello2: String = "hello2";
    assert !core::internal::string_eq(&hello1, &hello2);  // hello1 != hello2
    core::cli::println("all tests passed");
}

