struct Counter {
    value: i32,
}

pub fn Counter::new(value: i32) -> Counter {
    return Counter { value: value };
}

pub fn Counter::zero() -> i32 {
    return 0;
}

pub fn Counter::from_pair(a: i32, b: i32) -> Counter {
    return Counter { value: (a + b) };
}

pub fn Counter::get(self: Counter) -> i32 {
    return self.value;
}

fn run() with Stdout {
    let z: i32 = Counter::zero();
    core::cli::println(core::internal::string_concat("zero: ", z.to_string()));
    let c1: Counter = Counter::from_pair(10, 20);
    core::cli::println(core::internal::string_concat("from_pair: ", c1.get().to_string()));
    let c2: Counter = Counter::new(42);
    core::cli::println(core::internal::string_concat("counter value: ", c2.get().to_string()));
}

