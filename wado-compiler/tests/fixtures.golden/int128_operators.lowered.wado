// Golden file: Lowered TIR with -O2 optimization
// Source: wado-compiler/tests/fixtures/int128_operators.wado
// Generated by: make update-golden-fixtures

fn run() with Stdout {
    let a: u128 = move "u128::from_u64"(100 as u64);
    let b: u128 = move "u128::from_u64"(50 as u64);
    let sum: u128 = move "u128^Add::add"(&a, &b);
    core::cli::println(move core::internal::string_concat(move "u128 100 + 50 = ", move "u64::to_string"("u128::low"(&sum))));
    let diff: u128 = move "u128^Sub::sub"(&a, &b);
    core::cli::println(move core::internal::string_concat(move "u128 100 - 50 = ", move "u64::to_string"("u128::low"(&diff))));
    let x: i128 = move "i128::from_i64"(100 as i64);
    let y: i128 = move "i128::from_i64"(-50 as i64);
    let sum2: i128 = move "i128^Add::add"(&x, &y);
    core::cli::println(move core::internal::string_concat(move "i128 100 + (-50) = ", move "u64::to_string"("i128::low"(&sum2))));
    let neg_x: i128 = move "i128^Neg::neg"(&x);
    if "i128::is_negative"(&neg_x) {
        core::cli::println(move "i128: -100 is negative");
    }
    core::cli::println(move "All operator overloading tests passed!");
}

