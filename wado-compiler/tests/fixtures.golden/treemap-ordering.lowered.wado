        core::builtin::array_copy::<TreeMapEntry<String,i32>>(new_repr, 0, self.repr, 0, used);
        self.repr = new_repr;
    }
    core::builtin::array_set::<TreeMapEntry<String,i32>>(self.repr, used, value);
    self.used = (used + 1);
}

pub fn "Array<TreeMapEntry<String,i32>>::len"(self: &Array<TreeMapEntry<String,i32>>) -> i32 {
    return self.used;
}

fn "Array<TreeMapEntry<String,i32>>^IndexValue::index_value"(self: &Array<TreeMapEntry<String,i32>>, index: i32) -> TreeMapEntry<String,i32> {
    return core::builtin::array_get::<TreeMapEntry<String,i32>>(self.repr, index);
}

fn "TreeMap<String,i32>::find_index"(self: &TreeMap<String,i32>, key: String) -> i32 {
    let mut current: Option<&mut TreeMapNode<String>> = self.root;
    let _licm_entries: Array<TreeMapEntry<String,i32>> = self.entries;
    loop {
        if __is_not_null(current) {
            let n: &mut TreeMapNode<String> = __unwrap_option(current);
            if key."String^Eq::eq"(&n.key) {
                let entry: &TreeMapEntry<String,i32> = &_licm_entries."Array<TreeMapEntry<String,i32>>^IndexValue::index_value"(n.index);
                if entry.deleted {
                    return -1;
                }
                return n.index;
            }
            if (key."String^Ord::cmp"(&n.key) == Ordering::Less) {
                current = n.left;
            } else {
                current = n.right;
            }
        } else {
            break;
        }
    }
    return -1;
}

pub fn "TreeMap<String,i32>::new"() -> TreeMap<String,i32> {
    return TreeMap<String,i32> { root: null, entries: [], size: 0, deleted_count: 0 };
}

