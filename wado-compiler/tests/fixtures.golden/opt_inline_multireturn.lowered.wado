fn abs(x: i32) -> i32 {
    if (x < 0) {
        return -x;
    }
    return x;
}

fn run() {
    let a: i32 = abs(5);
    let b: i32 = abs(-5);
    assert (a == 5);  // a == 5
    assert (b == 5);  // b == 5
}

