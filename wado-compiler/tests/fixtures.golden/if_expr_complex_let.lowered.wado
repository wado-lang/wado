fn compute(mode: Mode, precision: i32, exp_est: i32) -> i32 {
    let n: i32 = if match mode {
        Decimal => true,
        _ => false,
    } {
        let base: i32 = (precision + 1);
        let adjusted: i32 = (base + exp_est);
        if (exp_est >= 0) {
            adjusted;
        } else {
            base;
        }
    } else {
        (precision + 1);
    };
    return n;
}

