    core::cli::println(move compute(move Mode::Decimal, 2, 3)."i32::to_string"());
    core::cli::println(move compute(move Mode::Decimal, 2, -1)."i32::to_string"());
    core::cli::println(move compute(move Mode::Exp, 2, 3)."i32::to_string"());
}

