use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let arr: Array<i32> = [10, 20, 30, 40, 50];

    // Basic slice
    let s = arr.slice(1, 4);
    assert s.len() == 3;
    assert s[0] == 20;
    assert s[1] == 30;
    assert s[2] == 40;

    // get with bounds check
    assert s.get(0) matches { Some(v) && v == 20 };
    assert s.get(3) matches { None };
    assert s.get(-1) matches { None };

    // Sub-slice
    let ss = s.slice(1, 2);
    assert ss.len() == 1;
    assert ss[0] == 30;

    // Empty slice
    let empty = arr.slice(3, 3);
    assert empty.len() == 0;
    assert empty.is_empty();

    // Clamping
    let clamped = arr.slice(0, 100);
    assert clamped.len() == 5;
    let clamped2 = arr.slice(-5, 3);
    assert clamped2.len() == 3;

    // to_array
    let copied = s.to_array();
    assert copied.len() == 3;
    assert copied[0] == 20;
    assert copied[2] == 40;

    // Iteration via for-of
    let mut sum = 0;
    for let x of s {
        sum += x;
    }
    assert sum == 90;

    // Iterator combinators
    let doubled = s.iter().map(|x: i32| x * 2).collect();
    assert doubled.len() == 3;
    assert doubled[0] == 40;
    assert doubled[1] == 60;
    assert doubled[2] == 80;

    let total = s.iter().fold(0, |acc: i32, x: i32| acc + x);
    assert total == 90;

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
