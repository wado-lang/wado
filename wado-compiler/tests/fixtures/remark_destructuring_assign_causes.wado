// A destructuring assignment that keeps its copying desugaring, rather than a
// move or an `index_swap`, is remarked with a note naming why. One function per
// cause.

use { println, Stdout } from "core:cli";

global mut K: i32 = 0;

fn rows() -> List<List<i32>> {
    return [[builtin::black_box(1)], [2]];
}

fn not_a_permutation() -> i32 {
    let mut a: List<i32> = [builtin::black_box(1)];
    let mut b: List<i32> = [2];
    [a, b] = [b, b];
    a.push(1);
    return a.len() + b.len();
}

fn reference_readable() -> i32 {
    let mut a: List<i32> = [builtin::black_box(1)];
    let mut b: List<i32> = [2];
    let r = &a;
    [a, b] = [b, a];
    return r.len() + b.len();
}

fn not_owned(rs: &mut List<List<i32>>, x: &mut List<i32>) -> i32 {
    [rs[0], *x] = [*x, rs[0]];
    return rs.len();
}

fn other_container() -> i32 {
    let mut ts = rows();
    let mut us = rows();
    [ts[0], us[1]] = [us[1], ts[0]];
    return ts.len() + us.len();
}

fn index_referenced() -> i32 {
    let mut ts = rows();
    let i = builtin::black_box(0);
    let r = &i;
    [ts[i], ts[1]] = [ts[1], ts[i]];
    return ts[0].len() + *r;
}

fn mutable_global_index() -> i32 {
    let mut ts = rows();
    [ts[K], ts[1]] = [ts[1], ts[K]];
    return ts[0].len();
}

struct Shelf { rows: List<List<i32>> }

impl IndexRef<i32> for Shelf {
    type Output = List<i32>;

    fn index_ref(&self, index: i32) -> &List<i32> {
        return &self.rows[index];
    }
}

impl IndexAssign<i32> for Shelf {
    type Output = List<i32>;

    fn index_assign(&mut self, index: i32, value: List<i32>) {
        self.rows[index] = value;
    }
}

fn no_index_swap() -> i32 {
    let mut s = Shelf { rows: rows() };
    [s[0], s[1]] = [s[1], s[0]];
    return s.rows.len();
}

global mut SHELF: List<List<i32>> = [];

fn container_not_local() -> i32 {
    SHELF = rows();
    [SHELF[0], SHELF[1]] = [SHELF[1], SHELF[0]];
    return SHELF[0].len();
}

export fn run() with Stdout {
    let mut rs = rows();
    let mut x: List<i32> = [3];
    println(`${not_a_permutation()} ${reference_readable()} ${not_owned(&mut rs, &mut x)}`);
    println(`${other_container()} ${index_referenced()} ${mutable_global_index()} ${no_index_swap()}`);
    println(`${container_not_local()}`);
}

__DATA__
{
    "stdout": "3 2 2\n4 1 1 2\n1\n",
    "remarks": {
        "O2": [
            {"contains": [":16:5 remark: a copy of", "\n  note: the right side is not a permutation of the targets"]},
            {"contains": [":25:5 remark: a copy of", "\n  note: a reference to a target is readable after the statement"]},
            {"contains": [":30:5 remark: a copy of", "\n  note: a target is not owned, and the statement is not a transposition within one container"]},
            {"contains": [":37:5 remark: a copy of", "\n  note: the two subscripts name different containers, or one the compiler cannot show to be the same"]},
            {"contains": [":45:5 remark: a copy of", "\n  note: an index reads a mutable global, or an index local or a `mut` reference local the container is reached through is referenced or captured"]},
            {"contains": [":51:5 remark: a copy of", "\n  note: an index reads a mutable global, or an index local or a `mut` reference local the container is reached through is referenced or captured"]},
            {"contains": [":75:5 remark: a copy of", "\n  note: `Shelf` does not implement `IndexSwap`"]},
            {"contains": [":83:5 remark: a copy of", "\n  note: the container is not reached from a local"]}
        ]
    }
}
