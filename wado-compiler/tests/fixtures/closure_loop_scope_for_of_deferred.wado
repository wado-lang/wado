// Test that for-of loop variables have per-iteration scope binding
// Store closures and call them AFTER the loop to verify each captured its own value
// If all closures share the same binding, they would all return the final value (50)
use { println, Stdout } from "core:cli";

fn call_fn(f: fn(i32) -> i32, x: i32) -> i32 {
    return f(x);
}

fn run() with Stdout {
    let items: Array<i32> = [10, 20, 30, 40, 50];
    let mut closures: Array<fn(i32) -> i32> = [];

    // Create closures in the loop - each should capture its own iteration's value
    for let item of items {
        let get_item = |_: i32| item;
        closures.append(get_item);
    }

    // Call closures AFTER the loop completes
    // If loop vars have per-iteration binding: 10,20,30,40,50
    // If loop vars share a single binding: 50,50,50,50,50
    let r0 = call_fn(closures[0], 0);
    let r1 = call_fn(closures[1], 0);
    let r2 = call_fn(closures[2], 0);
    let r3 = call_fn(closures[3], 0);
    let r4 = call_fn(closures[4], 0);

    println(`{r0},{r1},{r2},{r3},{r4}`);
}

__DATA__
{"stdout": "10,20,30,40,50\n"}
