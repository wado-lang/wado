// Optimizer miscompile pattern extracted from package-gale's
// `visitor_gen.wado/gen_walk_fn`. Issue #1187.
//
// In real package-gale, at -O3 with `--optimize-inline-threshold 33`
// (one above the default 32), `CodeWriter::to_string` asserts
// `unbalanced indentation (level=-3)` while generating the `walk_e`
// function for a 3-alternative parser rule.
//
// Diagnosis:
// * `WADO_SKIP_PASS=nir/inline` or `nir/copy_prop` makes the bug go
//   away; every other pass is irrelevant. So this is a copy_prop bug
//   on inliner output, not an inliner bug per se.
// * Empirically the trigger is `i32::fmt_decimal` (stdlib, about
//   28 statements after inlining `count_digits_i64`) becoming an
//   inline candidate. Once `fmt_decimal` lands inside the `walk_fn`
//   body, copy_prop drops the `self.indent_level -= 1` write from
//   the first inlined `Writer::end()` per call and the scalar drifts
//   negative by exactly `alternatives` for each subsequent
//   `gen_walk_fn` call.
//
// The fixture ships its own `Dec: Display` whose `fmt` mirrors
// `i32::fmt_decimal` / `count_digits_i64`, marked `#[inline(always)]`,
// so the reproduction does not depend on the stdlib inlining
// threshold and fires at the default -O1 / -O2 / -O3 / -Os.
//
// Shape of the miscompiled caller (in the source below):
//
//   fn gen_walk_fn(w, rule_name, n_alts, n_fields) {
//       w.begin(&"pub fn walk_<rule_name>...");     // fn block
//       let case_names = build_case_names(n_alts);
//       w.begin(&"match node");                     // match block
//       for let mut i = 0; i < n_alts; i += 1 {
//           let id = Dec { value: i };
//           w.begin(&"<case_names[i]>(n) =>");      // case block
//           w.line(&"v.enter_rule({id}, ...);");
//           let fields = build_walk_fields(n_fields);
//           for let f of &fields {
//               gen_walk_field(w, f, &"n");         // line() with {field.name}
//           }
//           w.line(&"v.exit_rule({id}, ...);");
//           w.end();                                // case end
//       }
//       w.end();                                    // match end
//       w.end();                                    // fn end
//   }

use { Display, Formatter } from "core:prelude";

// Standalone copy of `i32::fmt_decimal` (and `count_digits_i64`) from
// `wado-compiler/lib/core/prelude/primitive.wado`. Templating with the
// stdlib `{i:_}` for an i32 only inlines fmt_decimal at threshold ≥ 28
// (~size of count_digits_i64-plus-fmt_decimal after inline), so the
// real package-gale bug only fires at -O3 default. Re-implementing the
// same shape here as a `Display` impl on a newtype lets the fixture
// drive the same inline + copy_prop interaction independently of the
// stdlib threshold.
pub struct Dec { value: i32 }

#[inline(always)]
fn dec_count_digits(val: i64) -> i32 {
    if val == 0 {
        return 1;
    }
    let mut n: i32 = 0;
    for let mut t = val; t > 0; t = t / 10 {
        n += 1;
    }
    return n;
}

impl Display for Dec {
    #[inline(always)]
    fn fmt(&self, f: &mut Formatter) {
        let is_negative = self.value < 0;
        let abs_val: i64 = if is_negative { 0 - self.value as i64 } else { self.value as i64 };
        let digit_count = dec_count_digits(abs_val);
        if is_negative {
            f.buf.push('-');
        }
        let mut digits: Array<char> = [];
        if abs_val == 0 {
            digits.push('0');
        }
        let mut t = abs_val;
        for let mut k = 0; k < digit_count && t > 0; k += 1 {
            digits.push(char::from_u32(((t % 10) as i32 + ('0' as i32)) as u32).unwrap());
            t = t / 10;
        }
        let mut j = digits.len() - 1;
        while j >= 0 {
            f.buf.push(digits[j]);
            j -= 1;
        }
    }
}

pub struct Writer {
    buf: String,
    indent_level: i32,
    fresh_line: bool,
}

impl Writer {
    pub fn new() -> Writer {
        return Writer { buf: String::with_capacity(64), indent_level: 0, fresh_line: true };
    }

    #[inline(always)]
    fn write_indent(&mut self) {
        for let mut i = 0; i < self.indent_level; i += 1 {
            self.buf.push_str(&"    ");
        }
    }

    #[inline(always)]
    pub fn line(&mut self, text: &String) {
        self.write_indent();
        self.buf.push_str(text);
        self.buf.push('\n');
        self.fresh_line = true;
    }

    #[inline(always)]
    pub fn begin(&mut self, opener: &String) {
        self.write_indent();
        self.buf.push_str(opener);
        self.buf.push_str(&" {\n");
        self.fresh_line = true;
        self.indent_level += 1;
    }

    #[inline(always)]
    pub fn end(&mut self) {
        self.indent_level -= 1;
        self.write_indent();
        self.buf.push_str(&"}\n");
        self.fresh_line = true;
    }
}

variant WalkAction {
    VisitToken,
    WalkRule(String),
}

struct WalkField {
    name: String,
    action: WalkAction,
}

fn gen_walk_field(w: &mut Writer, field: &WalkField, var: &String) {
    match &field.action {
        VisitToken => w.line(&`v.visit_token(&{*var}.{field.name});`),
        WalkRule(rn) => w.line(&`walk_{*rn}(v, &{*var}.{field.name});`),
    };
}

fn build_walk_fields(n: i32) -> Array<WalkField> {
    let mut fields: Array<WalkField> = [];
    for let mut i = 0; i < n; i += 1 {
        if i % 2 == 0 {
            fields.push(WalkField { name: `f{Dec { value: i }}`, action: WalkAction::VisitToken });
        } else {
            fields.push(WalkField { name: `f{Dec { value: i }}`, action: WalkAction::WalkRule(`r{Dec { value: i }}`) });
        }
    }
    return fields;
}

fn build_case_names(n: i32) -> Array<String> {
    let mut names: Array<String> = [];
    for let mut i = 0; i < n; i += 1 {
        names.push(`Alt{Dec { value: i }}`);
    }
    return names;
}

fn gen_walk_fn(w: &mut Writer, rule_name: &String, n_alts: i32, n_fields: i32) {
    w.begin(&`pub fn walk_{*rule_name}<V: Visitor>(v: &mut V, node: &Node)`);
    let case_names = build_case_names(n_alts);
    w.begin(&"match node");
    for let mut i = 0; i < n_alts; i += 1 {
        w.begin(&`{case_names[i]}(n) =>`);
        w.line(&`v.enter_rule({Dec { value: i }}, &"{*rule_name}", &n.span);`);
        let fields = build_walk_fields(n_fields);
        for let f of &fields {
            gen_walk_field(w, f, &"n");
        }
        w.line(&`v.exit_rule({Dec { value: i }}, &"{*rule_name}", &n.span);`);
        w.end();
    }
    w.end();
    w.end();
}

export fn run() {
    let mut w = Writer::new();
    gen_walk_fn(&mut w, &"e", 3, 2);
    assert w.indent_level == 0, `expected level=0 after gen_walk_fn(3, 2), got {w.indent_level}`;
    gen_walk_fn(&mut w, &"stmt", 4, 3);
    assert w.indent_level == 0, `expected level=0 after gen_walk_fn(4, 3), got {w.indent_level}`;
}

__DATA__
{"stdout": ""}
