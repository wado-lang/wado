// Test for array indexing with comparison in loop conditions
// This mimics the treemap find_key_index pattern

use { println, Stdout } from "core:cli";

fn find_key_index(keys: &Array<String>, key: &String) -> i32 {
    let mut i = 0;
    while i < keys.len() && keys[i] < *key {
        i += 1;
    }
    return i;
}

export fn run() with Stdout {
    let keys: Array<String> = ["apple", "banana", "cherry", "date"];
    let result = find_key_index(&keys, &"cherry");
    println(`index: {result}`);
}

__DATA__
{"stdout": "index: 2\n"}
