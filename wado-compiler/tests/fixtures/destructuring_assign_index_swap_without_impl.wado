// A container that does not implement `IndexSwap` keeps the desugaring: it
// reads both elements through `IndexValue`, then writes each through
// `IndexAssign`.

use { println, Stdout } from "core:cli";

struct Shelf {
    books: List<String>,
}

impl IndexValue<i32> for Shelf {
    type Output = String;

    fn index_value(&self, index: i32) -> String {
        return self.books[index];
    }
}

impl IndexAssign<i32> for Shelf {
    type Output = String;

    fn index_assign(&mut self, index: i32, value: String) {
        self.books[index] = value;
    }
}

export fn run() with Stdout {
    let mut shelf = Shelf { books: ["a", "b"] };
    [shelf[0], shelf[1]] = [shelf[1], shelf[0]];
    println(`${shelf[0]}${shelf[1]}`);
}

__DATA__
{
    "stdout": "ba\n",
    "wir_expect:O0": ["Shelf^core:prelude/traits.wado/IndexAssign<i32>::index_assign"],
    "wir_contrast": {"O0": [
        {"impl IndexAssign<i32> for Shelf {": "impl IndexSwap<i32> for Shelf {\n    fn index_swap(&mut self, a: i32, b: i32) {\n        [self.books[a], self.books[b]] = [self.books[b], self.books[a]];\n    }\n}\n\nimpl IndexAssign<i32> for Shelf {"}
    ]}
}
