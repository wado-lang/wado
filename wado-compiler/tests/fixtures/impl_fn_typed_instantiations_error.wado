// A mangle spells a function type as `Fn<arity, return>`, so these two impls
// mint one name for two bodies — which monomorphization asserts away with a
// panic and the coherence check states first.
//
// The message names what *this* impl wrote. Naming the minted head instead
// prints `Slot<Fn<1,i32>>`: a type spelled nowhere in the source, and the same
// string for both impls, so it identifies neither.

struct Slot<T> { a: T }

impl Slot<fn(i32) -> i32> {
    fn f(self) -> i32 {
        return 1
    }
}

impl Slot<fn(String) -> i32> {
    fn f(self) -> i32 {
        return 2
    }
}

export fn run() {
    let _ = 1;
}

__DATA__
{"compile_error": "duplicate definition of `f` for `Slot<fn(String) -> i32>`"}
