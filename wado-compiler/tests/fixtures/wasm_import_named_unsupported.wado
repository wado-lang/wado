// Phase 1 of `use ... with { type: "wat" }` (see WEP-2026-01-10-wasm-import.md)
// only supports the wildcard form. Named imports must produce a clear
// compile error so users aren't left wondering why their imports don't
// resolve.

use { foo } from "./libm.wat" with { type: "wat" };

export fn run() {
    foo();
}

__DATA__
{
    "compile_error": "named imports from .wat/.wasm assets are not supported in Phase 1"
}
