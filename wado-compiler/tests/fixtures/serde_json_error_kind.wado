use {
    Deserialize,
    DeserializeError,
    DeserializeErrorKind,
} from "core:serde";

use { from_string } from "core:json";

test "enum field access on cross-module struct" {
    let r: Result<i32, DeserializeError> = from_string::<i32>("42 extra");
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::TrailingData };
}

test "enum field compared directly" {
    let r: Result<i32, DeserializeError> = from_string::<i32>("abc");
    if let Err(e) = r {
        assert e.kind == DeserializeErrorKind::UnexpectedType;
    }
}

struct Pair {
    a: i32,
    b: i32,
}

impl Deserialize for Pair;

// An input that stops after a member comma has no key to complain about, so
// the truncation is what the error names — on the deserializing walk and on
// the one that skips an unknown field's object value alike.
test "input truncated after an object member comma is Eof" {
    let r: Result<Pair, DeserializeError> = from_string::<Pair>(`{"a":1, `);
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::Eof };
}

test "input truncated inside a skipped object value is Eof" {
    let r: Result<Pair, DeserializeError> = from_string::<Pair>(`{"a":1,"z":{"k":1, `);
    assert r matches { Err(e) && e.kind == DeserializeErrorKind::Eof };
}
