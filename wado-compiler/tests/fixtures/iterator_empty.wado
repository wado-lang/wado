// Test iterator on empty array
use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let arr: Array<i32> = [];
    let mut iter = arr.iter();

    // Should immediately return None
    if let Some(a) = iter.next() {
        println(`unexpected: {a}`);
    } else {
        println("empty");
    }

    // Second call should also return None
    if let Some(b) = iter.next() {
        println(`unexpected: {b}`);
    } else {
        println("still empty");
    }
}

__DATA__
{"stdout": "empty\nstill empty\n"}
