// A `String` copy is right-sized to `used`, never to its backing array's
// capacity — a builder's slack is not part of the value.
//
// What decides it is whether the copy helper recognises the type as the
// compiler's `String`, which is a question about the declaration a type names
// (WEP 2026-08-12). Asked instead of the node registered against one of its
// ids, it answers no for every id but the first, and the helper built for the
// other copies `String` as a plain struct — over the whole capacity. This pins
// the shape; the miss it guards needs a second id for one declaration, which
// only a package-scale program has.

use { println, Stdout } from "core:cli";

struct Holder { s: String }

fn build() -> String {
    let mut b = String::with_capacity(1024);
    b.push('h');
    b.push('i');
    return b;
}

fn keep(h: &Holder, out: &mut List<String>) {
    out.push(h.s);
}

export fn run() with Stdout {
    let h = Holder { s: build() };
    let mut out: List<String> = [];
    keep(&h, &mut out);
    keep(&h, &mut out);
    println(`${out.len()} ${out[0].len()} ${out[1]}`);
}

__DATA__
{
    "stdout": "2 2 hi\n",
    "wir_not_expect:O0": ["builtin::array_len(__array_clone_src"],
    "wir_not_expect:O2": ["builtin::array_len(__array_clone_src"]
}
