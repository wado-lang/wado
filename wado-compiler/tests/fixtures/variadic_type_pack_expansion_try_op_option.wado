// Type pack expansion with try-op on Option: [..T::method()?]
use { println, Stdout } from "core:cli";

trait TryDefault {
    fn try_default() -> Option<Self>;
}

impl TryDefault for i32 {
    fn try_default() -> Option<i32> {
        return Option::<i32>::Some(42);
    }
}

impl TryDefault for String {
    fn try_default() -> Option<String> {
        return Option::<String>::Some("hello");
    }
}

fn make_defaults<..T: TryDefault>() -> Option<[..T]> {
    return Option::<[..T]>::Some([..T::try_default()?]);
}

fn make_defaults_fail<..T: TryDefault>() -> Option<[..T]> {
    // This always returns None since Option::None is null
    let _unused: Option<[..T]> = null;
    return Option::<[..T]>::Some([..T::try_default()?]);
}

export fn run() with Stdout {
    // Success path
    let result = make_defaults::<[i32, String]>();
    if let Some(t) = result {
        assert t.0 == 42;
        assert t.1 == "hello";
        println("ok");
    }
}

__DATA__
{"stdout": "ok\n"}
