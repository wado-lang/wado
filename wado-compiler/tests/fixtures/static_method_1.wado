use { println, Stdout } from "core:cli";

// from static_method_basic.wado
struct Point {
    x: i32,
    y: i32,
}

impl Point {
    fn origin() -> Point {
        // Static method (no self parameter)

        return Point { x: 0, y: 0 };
    }

    fn sum(&self) -> i32 {
        // Instance method for comparison

        return self.x + self.y;
    }
}

// from static_method_chained.wado
struct Box<T> {
    value: T,
}

impl<T> Box<T> {
    pub fn new(value: T) -> Box<T> {
        return Box { value };
    }

    pub fn get(&self) -> T {
        return self.value;
    }
}

struct Pair<T, U> {
    first: T,
    second: U,
}

impl<T, U> Pair<T, U> {
    pub fn create(first: T, second: U) -> Pair<T, U> {
        return Pair { first, second };
    }

    pub fn get_first(&self) -> T {
        return self.first;
    }

    pub fn get_second(&self) -> U {
        return self.second;
    }
}

// from static_method_basic.wado
fn static_method_basic() with Stdout {
    let p = Point::origin();
    println(`origin: ({p.x}, {p.y})`);
    println(`sum: {p.sum()}`);
}

// from static_method_chained.wado
fn static_method_chained() with Stdout {
    // Chain: use result of Pair method as argument to Box constructor
    let p = Pair::<i32, i64>::create(10, 20 as i64);
    let boxed = Box::<i32>::new(p.get_first());
    println(`boxed first: {boxed.get()}`);

    // Chain: Box of Pair
    let pair = Pair::<i32, i32>::create(100, 200);
    let boxed_pair = Box::<Pair<i32, i32>>::new(pair);
    let inner_pair = boxed_pair.get();
    println(`inner first: {inner_pair.get_first()}`);
    println(`inner second: {inner_pair.get_second()}`);

    // Inline chained call
    let val = Box::<i32>::new(Pair::<i32, i32>::create(5, 10).get_second()).get();
    println(`chained result: {val}`);
}

// from static_method_generic.wado
fn static_method_generic() with Stdout {
    // Create array with pre-allocated capacity using generic static method
    let mut arr = Array::<i32>::with_capacity(10);
    println(`initial len: {arr.len()}`);

    // Append some elements
    arr.append(1);
    arr.append(2);
    arr.append(3);

    println(`after append len: {arr.len()}`);

    // Access elements
    println(`arr[0]: {arr[0]}`);
    println(`arr[1]: {arr[1]}`);
    println(`arr[2]: {arr[2]}`);
}

export fn run() with Stdout {
    static_method_basic();
    static_method_chained();
    static_method_generic();
}

__DATA__
{"stdout": "origin: (0, 0)\nsum: 0\nboxed first: 10\ninner first: 100\ninner second: 200\nchained result: 10\ninitial len: 0\nafter append len: 3\narr[0]: 1\narr[1]: 2\narr[2]: 3\n"}
