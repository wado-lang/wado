// `List<T>` literals of every shape read back what they denote. A list whose
// every read folds to the element it denotes drops with its array, as the
// `String` one does.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Direct List<T> literal via type annotation
    let a: List<i32> = [10, 20, 30];
    assert a.len() == 3;
    assert a[0] == 10;
    assert a[1] == 20;
    assert a[2] == 30;

    // List<T> literal via explicit cast, one element read at a `black_box`ed
    // index.
    let b = [100, 200] as List<i32>;
    assert b.len() == 2;
    assert b[builtin::black_box(0)] == 100;
    assert b[1] == 200;

    // Empty array
    let c: List<i32> = [];
    assert c.len() == 0;

    // Single element
    let d: List<i32> = [42];
    assert d.len() == 1;
    assert d[0] == 42;

    // Different element type
    let e: List<i64> = [1, 2, 3];
    assert e.len() == 3;
    assert e[0] == 1;

    // Non-scalar element type (String)
    let f: List<String> = ["hello", "world"];
    assert f.len() == 2;
    assert f[0] == "hello";
    assert f[1] == "world";

    // Wrapper type (SeqVec) also benefits from List<T> optimization
    let g: SeqVec<i32> = [5, 10, 15];
    assert g.items.len() == 3;
    assert g.items[0] == 5;
    assert g.items[1] == 10;
    assert g.items[2] == 15;

    println("ok");
}

struct SeqVec<T> {
    items: List<T>,
}

impl<T> From<Array<T>> for SeqVec<T> {
    fn from(elements: Array<T>) -> SeqVec<T> {
        let items = List::<T>::from(elements);
        return SeqVec { items };
    }
}

__DATA__
{
    "stdout": "ok\n",
    "wir_pass": {"O2": ["nir/copy_prop", "nir/const_fold", "nir/store_load_forward_post_scalarize", "nir/const_fold_post_global"]},
    "wir_not_expect:O2": [
        "array.new_fixed<ref \"core:prelude/string.wado//String\">("
    ]
}
