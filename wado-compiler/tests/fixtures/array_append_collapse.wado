// Verifies that List<T> literals go through SequenceLiteralBuilder
// and the collapse_array_append_sequences WIR pass recovers ArrayNewFixed.
//
// Only the lists something still reads at run time reach the WIR: one whose
// every read folds to the element it denotes drops with its array.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Direct List<T> literal via type annotation
    let a: List<i32> = [10, 20, 30];
    assert a.len() == 3;
    assert a[0] == 10;
    assert a[1] == 20;
    assert a[2] == 30;

    // List<T> literal via explicit cast. One element is read at a
    // `black_box`ed index so the list survives to the WIR — a list whose
    // every read folds drops with its array, and this is the one the
    // `array.new_fixed` expectation below checks.
    let b = [100, 200] as List<i32>;
    assert b.len() == 2;
    assert b[builtin::black_box(0)] == 100;
    assert b[1] == 200;

    // Empty array
    let c: List<i32> = [];
    assert c.len() == 0;

    // Single element
    let d: List<i32> = [42];
    assert d.len() == 1;
    assert d[0] == 42;

    // Different element type
    let e: List<i64> = [1, 2, 3];
    assert e.len() == 3;
    assert e[0] == 1;

    // Non-scalar element type (String)
    let f: List<String> = ["hello", "world"];
    assert f.len() == 2;
    assert f[0] == "hello";
    assert f[1] == "world";

    // Wrapper type (SeqVec) also benefits from List<T> optimization
    let g: SeqVec<i32> = [5, 10, 15];
    assert g.items.len() == 3;
    assert g.items[0] == 5;
    assert g.items[1] == 10;
    assert g.items[2] == 15;

    println("ok");
}

struct SeqVec<T> {
    items: List<T>,
}

impl SequenceLiteralBuilder for SeqVec<T> {
    type Element = T;
    type Output = SeqVec<T>;

    fn new_literal(capacity: i32) -> SeqVec<T> {
        return SeqVec { items: List::<T>::with_capacity(capacity) };
    }

    fn push_literal(&mut self, value: Self::Element) {
        self.items.push(value);
    }

    fn build(&self) -> SeqVec<T> {
        return *self;
    }
}

__DATA__
{
    "stdout": "ok\n",
    "wir_expect:O2": [
        "array.new_fixed<i32>(100, 200)"
    ],
    "wir_not_expect:O2": [
        "SequenceLiteralBuilder::push_literal\"(",
        "List<String>::push\"(__local_",
        "List<i32>::push\"(",
        "array.new_fixed<ref \"core:prelude/string.wado//String\">("
    ]
}
