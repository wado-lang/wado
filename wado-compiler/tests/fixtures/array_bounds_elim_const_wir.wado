// Test: WIR-level verification of bounds check elimination.
// The constant read-only array is hoisted to an immutable module global by
// body globalization; const-fold then recovers its `used` length through
// the global (via niri's GlobalFieldEnv), so the constant-index bounds
// checks are still eliminated at O2.
//
// `const_object_globalization` also hoists unrelated `&`-literal call
// arguments elsewhere in this program (e.g. `println`'s Formatter/Inspect
// stack), so the exact `__const_obj_N` number below is not stable across
// unrelated optimizer changes — it is whatever this fixture's own global
// happens to land on, pinned as a snapshot. It comes first now that the
// bounds checks fold before their assert's diagnostic fragments are
// hoisted, leaving nothing ahead of it.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let arr: List<i32> = [10, 20, 30];
    let first = arr[0];
    let second = arr[1];
    let third = arr[2];
    println(`${first}, ${second}, ${third}`);
}

__DATA__
{
    "stdout": "10, 20, 30\n",
    "wir_expect:O2": [
        "global global:array_bounds_elim_const_wir.wado::__const_obj_0",
        "array.new_fixed<i32>(10, 20, 30)",
        "builtin::array_get<i32>(global:array_bounds_elim_const_wir.wado::__const_obj_0.repr, 0)",
        "builtin::array_get<i32>(global:array_bounds_elim_const_wir.wado::__const_obj_0.repr, 1)",
        "builtin::array_get<i32>(global:array_bounds_elim_const_wir.wado::__const_obj_0.repr, 2)"
    ],
    "wir_not_expect:O2": [
        "if 0 >= global:array_bounds_elim_const_wir.wado::__const_obj_0.used",
        "if 1 >= global:array_bounds_elim_const_wir.wado::__const_obj_0.used",
        "if 2 >= global:array_bounds_elim_const_wir.wado::__const_obj_0.used"
    ]
}
