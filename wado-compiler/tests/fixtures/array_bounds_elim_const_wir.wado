// Test: WIR-level verification that a constant list read at constant indices
// leaves nothing behind.
//
// The list is a compile-time value, so each read folds to the element it
// denotes and the formatter is handed the literals directly. The array is then
// unread and drops, taking the bounds checks — and the panic path that
// reported them — with it.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let arr: List<i32> = [10, 20, 30];
    let first = arr[0];
    let second = arr[1];
    let third = arr[2];
    println(`${first}, ${second}, ${third}`);
}

__DATA__
{
    "stdout": "10, 20, 30\n",
    "wir_expect:O2": [
        "i32::fmt_decimal\"(10,",
        "i32::fmt_decimal\"(20,",
        "i32::fmt_decimal\"(30,"
    ],
    "wir_not_expect:O2": [
        "array.new_fixed<i32>",
        "builtin::array_get<i32>",
        "index out of bounds"
    ]
}
