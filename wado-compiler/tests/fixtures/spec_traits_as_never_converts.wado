// `as` never calls `From`: a cast reaches only what `as` itself converts.

struct Wrapper { v: i32 }

impl From<i32> for Wrapper {
    fn from(v: i32) -> Wrapper { return Wrapper { v }; }
}

export fn run() {
    let w = 3 as Wrapper;
}

