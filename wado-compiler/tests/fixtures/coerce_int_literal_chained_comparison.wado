// Test integer literal coercion in chained comparisons
// e.g., 1 < x < 10 desugars to (1 < x) && (x < 10)
// Each sub-comparison should coerce the literal to the variable's type
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let x_u64: u64 = 50;
    let x_i64: i64 = -5;
    let x_u8: u8 = 128;
    let x_i8: i8 = -10;

    // Chained: literal < var < literal
    assert 0 < x_u64 < 100;
    assert -10 < x_i64 < 0;
    assert 100 < x_u8 < 200;
    assert -20 < x_i8 < 0;

    // Chained: literal <= var <= literal
    assert 50 <= x_u64 <= 50;
    assert -5 <= x_i64 <= -5;
    assert 128 <= x_u8 <= 128;
    assert -10 <= x_i8 <= -10;

    // Chained: literal < var <= literal
    assert 0 < x_u64 <= 50;
    assert -10 < x_i64 <= -5;

    // Chained: literal <= var < literal
    assert 50 <= x_u64 < 100;
    assert -5 <= x_i64 < 0;

    // Chained: var > literal > ...  (descending)
    assert 100 > x_u64 > 0;
    assert 0 > x_i64 > -10;

    // Negated chain should work too
    assert !(0 < x_u64 < 10);
    assert !(0 < x_i64);

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
