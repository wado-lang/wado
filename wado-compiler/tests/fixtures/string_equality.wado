use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Basic equality
    let a = "hello";
    let b = "hello";
    let c = "world";

    assert a == b;
    assert a != c;

    // Not equal
    assert !(a == c);
    assert !(a != b);

    // Empty strings
    let empty1 = "";
    let empty2 = "";
    assert empty1 == empty2;

    // Different lengths
    let short = "hi";
    let long = "hello";
    assert short != long;

    // Same prefix different suffix
    let hello1 = "hello1";
    let hello2 = "hello2";
    assert hello1 != hello2;

    println("all tests passed");
}

__DATA__
{"stdout": "all tests passed\n"}
