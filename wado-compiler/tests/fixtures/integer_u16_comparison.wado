// Test u16 comparison operations
use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let a: u16 = 1000 as u16;
    let b: u16 = 60000 as u16;
    let c: u16 = 0 as u16;

    // Basic comparisons
    if a < b {
        println("a < b: true");
    }
    if a <= b {
        println("a <= b: true");
    }
    if b > a {
        println("b > a: true");
    }
    if b >= a {
        println("b >= a: true");
    }

    // Comparison with zero
    if c < a {
        println("c < a: true");
    }
    if a > c {
        println("a > c: true");
    }

    // Equality
    let d: u16 = 1000 as u16;
    if a == d {
        println("a == d: true");
    }
    if a != b {
        println("a != b: true");
    }
}

__DATA__
{"stdout": "a < b: true\na <= b: true\nb > a: true\nb >= a: true\nc < a: true\na > c: true\na == d: true\na != b: true\n"}
