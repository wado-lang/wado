// Test global variable with negative i64 literal edge cases
use { println, Stdout } from "core:cli";

global NEGATIVE_ONE: i64 = -1;
global I64_MIN: i64 = -9223372036854775808;

export fn run() with Stdout {
    println(`NEGATIVE_ONE={NEGATIVE_ONE}`);
    println(`I64_MIN={I64_MIN}`);
}

__DATA__
{"stdout": "NEGATIVE_ONE=-1\nI64_MIN=-9223372036854775808\n"}
