// Test: Iterator::count() default method on ArrayIter
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let arr: Array<i32> = [1, 2, 3, 4, 5];
    let mut iter = arr.iter();
    iter.next();
    let remaining = iter.count();
    println(`{remaining}`);
}

__DATA__
{"stdout": "4\n"}
