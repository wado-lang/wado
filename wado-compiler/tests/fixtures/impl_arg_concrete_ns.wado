// `impl Cell<ns::Tag>` — a fully concrete inherent impl whose one argument
// carries a namespace prefix.
//
// Nothing about the program is unusual. It fails when the two halves of "is
// this argument concrete" disagree, naming the methods a template while the
// call site names an instantiation.

use { Cell } from "./sub/impl_arg_concrete_ns_holder.wado";
use tag from "./sub/cross_module_same_name_impl_arg_tag_a.wado";

test "a concrete namespace-qualified impl argument" {
    let c = Cell { a: tag::Tag { n: 5 } };
    assert c.get() == 5;
}
