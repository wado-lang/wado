// Tuple destructuring with variant sub-patterns in match

use { println, Stdout } from "core:cli";

variant Value {
    Null,
    Bool(bool),
    Number(i32),
    Text(String),
}

fn describe(a: Value, b: Value) -> String {
    return match [a, b] {
        [Null, Null] => "both null",
        [Bool(x), Bool(y)] => `bools: {x} {y}`,
        [Number(x), Number(y)] => `nums: {x} {y}`,
        [Text(x), Text(y)] => `texts: {x} {y}`,
        _ => "mismatch",
    };
}

export fn run() with Stdout {
    println(describe(Value::Bool(true), Value::Bool(false)));
    println(describe(Value::Number(1), Value::Number(2)));
    println(describe(Value::Null, Value::Null));
    println(describe(Value::Text("hi"), Value::Text("bye")));
    println(describe(Value::Bool(true), Value::Number(1)));
}

__DATA__
{"stdout": "bools: true false\nnums: 1 2\nboth null\ntexts: hi bye\nmismatch\n"}
