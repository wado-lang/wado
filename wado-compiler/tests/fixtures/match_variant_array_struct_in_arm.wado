use { println } from "core:cli";
use { Stdout } from "core:cli";

struct Pair {
    a: i32,
    b: i32,
}

variant Shape {
    Circle(i32),
    Rect([i32, i32]),
    Point,
}

fn classify(s: Shape) -> List<Pair> {
    return match s {
        Circle(r) => {
            if r > 0 {
                [Pair { a: r, b: r }]
            } else {
                []
            }
        },
        Rect(dims) => [Pair { a: dims.0, b: dims.1 }],
        Point => [],
    };
}

export fn run() with Stdout {
    let result = classify(Shape::Circle(5));
    assert result.len() == 1;
    assert result[0].a == 5;

    let empty = classify(Shape::Circle(-1));
    assert empty.len() == 0;

    let rect = classify(Shape::Rect([3, 4]));
    assert rect.len() == 1;
    assert rect[0].a == 3;
    assert rect[0].b == 4;

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
