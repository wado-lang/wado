// The canonical's core type is the canonical's to give. `subtask.cancel`
// answers with the status the subtask ended on, so its declaration returns
// that `i32`; a core import typed `(param i32)` where the component provides
// `(param i32) (result i32)` fails to validate. The call sits in a branch that
// never runs, so the module validating is what this pins.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    if builtin::black_box(false) {
        builtin::subtask_cancel(builtin::black_box(0));
    }
    println("ok");
}

__DATA__
{"stdout": "ok\n"}
