//! `Trait::<T>::method(…)` for a receiver-less declaration, the counterpart of
//! Rust's `<T as Trait>::method`. An instance method's `Trait::method(&v)`
//! works because the receiver argument pins `Self`; a static has none, so the
//! turbofish supplies it. Only on a trait declaring no parameters of its own:
//! `Take::<A>::take(recv)` already claims the turbofish for those.

trait Tagged {
    fn tag(v: i32) -> i32 {
        return v * 2;
    }

    fn named() -> String;
}

struct V {}

impl Tagged for V {
    fn named() -> String {
        return "v";
    }
}

test "the trait names an inherited default-bodied static" {
    assert Tagged::<V>::tag(5) == 10;
}

test "and one the block writes" {
    assert Tagged::<V>::named() == "v";
}
