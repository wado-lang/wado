// A value reify binds to a local ahead of where it is used moves on from that
// local where it is used, whatever the desugaring: each `Tok` drops once.

use { println, log_stdout, Stdout } from "core:cli";

affine struct Tok {
    id: i32,
}

impl Drop for Tok {
    fn drop(self) {
        log_stdout(`drop ${self.id}`);
    }
}

affine struct Pair {
    a: Tok,
    b: Tok,
}

affine struct Counted {
    a: Tok,
    n: i32,
}

fn named(n: i32, t: Tok, m: i32 = n + 1) -> i32 {
    return t.id + m;
}

fn spread_generic<affine A>(t: [A, i32]) -> [A, i32, i32] {
    return [..t, 1];
}

export fn run() with Stdout {
    // Fields written out of declaration order.
    let p = Pair { b: Tok { id: 2 }, a: Tok { id: 1 } };
    println(`${p.a.id}`);

    // A tuple spread.
    let t = [Tok { id: 3 }];
    let u = [..t, 0];
    println(`${u.1}`);

    // A functional update.
    let c = Counted { a: Tok { id: 4 }, n: 0 };
    let d = Counted { ..c, n: 5 };
    println(`${d.n}`);

    // A tuple `for-of`.
    for let v of [Tok { id: 5 }, Tok { id: 6 }] {
        println(`${v.id}`);
    }

    // An argument a later default names.
    println(`${named(1, Tok { id: 7 })}`);

    // A spread inside a generic instance.
    let q = spread_generic([Tok { id: 8 }, 1]);
    println(`${q.0.id}`);

    // A transpose of rows held by value.
    let w = [[Tok { id: 9 }, Tok { id: 10 }], [0, 1]].zip();
    println(`${w.1.1}`);
}

__DATA__
{"stdout": "1\n0\n5\n5\ndrop 5\n6\ndrop 6\ndrop 7\n9\n8\n1\ndrop 9\ndrop 10\ndrop 8\ndrop 4\ndrop 3\ndrop 1\ndrop 2\n"}
