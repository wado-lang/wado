// Test: type inference for Option::Some without turbofish
// Forward inference: infer T from the payload argument type

export fn run() {
    // Infer Option<String> from string payload
    let a = Option::Some("hello");
    assert a matches { Some(s) && s == "hello" };

    // Infer Option<i32> from integer payload
    let b = Option::Some(42);
    assert b matches { Some(n) && n == 42 };
}

