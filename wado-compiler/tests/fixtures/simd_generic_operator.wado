// A generic `T: Add` body instantiated with a SIMD type. `i32x4` is a newtype
// over `v128`, which has no scalar `Add` — the lane width lives in the newtype's
// own impl, so the operator must dispatch there rather than lower to a scalar op.
use { println } from "core:cli";
use { i32x4, f32x4 } from "core:simd";

fn combine<T: Add>(a: T, b: T) -> T {
    return a + b;
}

fn scaled<T: Mul>(a: T, b: T) -> T {
    return a * b;
}

export fn run() with Stdout {
    let lanes = combine(i32x4::splat(1), i32x4::splat(2));
    assert lanes.extract_lane(0) == 3;
    assert lanes.extract_lane(3) == 3;

    let floats = scaled(f32x4::splat(1.5), f32x4::splat(2.0));
    assert floats.extract_lane(0) == 3.0;

    assert combine(20, 22) == 42;
    println(`${lanes.extract_lane(0)} ${combine(20, 22)}`);
}

__DATA__
{"stdout": "3 42\n"}
