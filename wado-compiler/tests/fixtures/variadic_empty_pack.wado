fn identity<..T>(x: [..T]) -> [..T] {
    return x;
}

fn prepend<A, ..T>(a: A, rest: [..T]) -> [A, ..T] {
    return [a, ..rest];
}

export fn run() {
    // Empty pack: ..T = []
    let a = identity([]);

    // Prepend to empty pack: A=i32, ..T=[]
    let b = prepend(42, []);
    assert b.0 == 42;
}

