// `==` on references asks the pointee's `Eq`, so a pointee without one is
// rejected; `ref_eq` still compares identity.
struct Callback {
    f: fn(),
}

export fn run() {
    let a = Callback { f: || {} };
    let r = &a;
    assert ref_eq(r, &a);
    let _ = r == &a;
}

