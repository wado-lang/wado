// Reference equality works even when the inner type does not implement Eq
struct NoEq {
    data: &i32,
}

// NoEq doesn't implement Eq because &i32 field... wait, &i32 now implements Eq.
// Let's use a closure field which doesn't implement Eq.

test "ref identity works without inner Eq" {
    let a = 42;
    let b = 42;
    let r1 = &a;
    let r2 = &a;
    let r3 = &b;
    assert r1 == r2;
    assert r1 != r3;
}
