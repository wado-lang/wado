// The `take` idiom pays its copy, in both spellings. A repoint of the place does
// give the binding what the place held, but the compiler has no proof of it — no
// ordering, and no count of the bindings read out of that place — so handing the
// binding on copies. WEP 2026-05-21 states this as a known gap; these copies are
// what closing it would remove, and what an unsound licence would remove early.

struct Slot {
    held: Option<String>,
    name: String,
}

impl Slot {
    fn take_name(&mut self) -> Result<String, i32> {
        let v = self.name;
        self.name = "";
        return Result::Ok(v);
    }

    fn take_held(&mut self) -> Result<String, i32> {
        if let Some(v) = self.held {
            self.held = null;
            return Result::Ok(v);
        }
        return Result::Err(1);
    }
}

export fn run() {
    let mut s = Slot { held: Option::Some("abc"), name: "xy" };

    let Ok(held) = s.take_held() else { unreachable(); };
    assert held.len() == 3;
    assert s.held matches { None };
    assert s.take_held() matches { Err(_) };

    let Ok(name) = s.take_name() else { unreachable(); };
    assert name.len() == 2;
    assert s.name.len() == 0;
}

__DATA__
{
    "stdout": "",
    "wir_scope": "/run",
    "wir_expect:O0": ["$value_copy$core:prelude/string.wado/String\"("],
    "wir_expect:O2": ["array_clone"]
}
