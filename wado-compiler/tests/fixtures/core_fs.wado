// `core:fs` — whole-file I/O against the first preopened directory.
//
// The preopen is a fresh empty scratch directory, so every path this program
// reads is one it wrote first.

use { println, Stdout } from "core:cli";
use fs from "core:fs";
use { Preopens } from "wasi:filesystem";

export fn run() with (Stdout, Preopens) {
    let text: String = "hello, wado\n";
    fs::write(&"greeting.txt", &text).unwrap();
    assert fs::read_to_string(&"greeting.txt").unwrap() == text;
    println("text round-trips");

    let bytes: ByteList = [0xff as u8, 0x00 as u8, 0xfe as u8];
    fs::write(&"raw.bin", &bytes).unwrap();
    assert fs::read(&"raw.bin").unwrap() == bytes;
    println("bytes round-trip");

    // Reading bytes that are not UTF-8 as text is an error, not a lossy decode.
    match fs::read_to_string(&"raw.bin") {
        Ok(_) => panic("non-UTF-8 bytes must not read as text"),
        Err(e) => println(`not utf-8: ${e}`),
    }

    match fs::read_to_string(&"nope.txt") {
        Ok(_) => panic("a missing file must not read"),
        Err(e) => {
            assert e.kind matches { NotFound };
            println(`missing: ${e}`);
        },
    }

    fs::create_dir_all(&"a/b/c").unwrap();
    // Creating a directory that exists is not an error.
    fs::create_dir_all(&"a/b/c").unwrap();
    fs::write(&"a/b/c/leaf.txt", &"leaf").unwrap();
    assert fs::read_to_string(&"a/b/c/leaf.txt").unwrap() == "leaf";
    println("nested directories");

    // A directory is not a file: `read_via_stream` traps on one, so `read`
    // refuses it first.
    match fs::read(&"a/b") {
        Ok(_) => panic("a directory must not read as a file"),
        Err(e) => println(`read a directory: ${e}`),
    }

    // An absolute path resolves against no preopen, so it fails rather than
    // being rebuilt underneath one.
    match fs::create_dir_all(&"/rooted/elsewhere") {
        Ok(_) => panic("an absolute path must not be created under the preopen"),
        Err(e) => println(`absolute create_dir_all: ${e}`),
    }

    let nested = fs::read_dir(&"a/b").unwrap();
    assert nested.len() == 1;
    assert nested[0].name == "c";
    assert nested[0].type matches { Directory };

    let leaves = fs::read_dir(&"a/b/c").unwrap();
    assert leaves.len() == 1;
    assert leaves[0].name == "leaf.txt";
    assert leaves[0].type matches { File };
    println("directory entries carry their type");

    // The empty path is the preopen itself, so a walk has a root case.
    let mut names: List<String> = [];
    for let entry of fs::read_dir(&"").unwrap() {
        names.push(entry.name);
    }
    names.sort();
    assert names == ["a", "greeting.txt", "raw.bin"];  // no "rooted"
    println("the empty path lists the preopen");

    fs::remove_file(&"greeting.txt").unwrap();
    assert fs::read(&"greeting.txt").is_err();
    println("remove_file removes it");

    assert fs::root().is_ok();
    println("all core:fs tests passed");
}

__DATA__
{
    "preopened_dirs": [["", "scratch"]],
    "stdout_contains": [
        "text round-trips",
        "bytes round-trip",
        "not utf-8: raw.bin: not valid UTF-8",
        "missing: nope.txt: no such file or directory",
        "nested directories",
        "read a directory: a/b: ErrorCode::IsDirectory",
        "absolute create_dir_all: /rooted/elsewhere: ErrorCode::NotPermitted",
        "directory entries carry their type",
        "the empty path lists the preopen",
        "remove_file removes it",
        "all core:fs tests passed"
    ]
}
