// Minimal repro: generic adapter whose associated type is another associated type projection.
// IterFilter<I>::Item = I::Item — this requires chained associated type resolution.

export fn run() {
    let arr: List<i32> = [1, 2, 3, 4, 5];
    let evens = arr.iter().filter(|x: i32| x % 2 == 0).collect();
    assert evens.len() == 2;
    assert evens[0] == 2;
    assert evens[1] == 4;
}

