// Test: a variant return whose payload is itself a variant is scalarized at
// both levels, leaving nothing of `Result<Result<i64, i32>, OuterErr>` boxed.
//
// `Cursor::step` returns `Result<Result<i64, i32>, OuterErr>` (the serde
// `next_element<Result>` shape). `optimize::sroa_variant_return` flattens the
// outer variant to `[outer_disc, ref Result<i64,i32>, ref OuterErr]` and leaves
// the inner `Result<i64, i32>` as one slot it builds at each return.
//
// `wir_optimize`'s `slot_flatten` then splits that slot into the per-case
// layout `[inner_disc, i64, i32]` against the `?`-unwrap at the call site, so
// `step` returns `[i32, i32, i64, i32, ref null OuterErr]` and `sum_all` binds
// the pieces directly. Splitting it in NIR instead was implemented and
// discarded: the callee stops allocating, but a call site that binds the whole
// inner value has to rebuild it, and the rebuild cost more than the allocation
// it removed. The destructure has to be pushed down into the call site, which
// is what the WIR pass does — see the WEP.
//
// `#[inline("never")]` keeps `step` a real SROA'd call site.
variant OuterErr {
    Bad,
}

struct Cursor {
    data: List<i64>,
    pos: i32,
}

impl Cursor {
    // Returns Ok(Ok(v)) for a value, Ok(Err(-1)) as the end sentinel, and
    // Err(OuterErr::Bad) for a negative element.
    #[inline("never")]
    fn step(&mut self) -> Result<Result<i64, i32>, OuterErr> {
        if self.pos >= self.data.len() {
            return Result::Ok(Result::Err(-1));
        }
        let v = self.data[self.pos];
        if v < 0 {
            return Result::Err(OuterErr::Bad);
        }
        self.pos += 1;
        return Result::Ok(Result::Ok(v));
    }
}

fn sum_all(data: List<i64>) -> Result<i64, OuterErr> {
    let mut cur = Cursor { data, pos: 0 };
    let mut total: i64 = 0;
    loop {
        let inner = cur.step()?;
        if let Ok(v) = inner {
            total += v;
        } else {
            break;
        }
    }
    return Result::Ok(total);
}

export fn run() {
    let ok = sum_all([10, 20, 30, 40]);
    assert ok matches { Ok(100) };

    // Error path: `?` propagates OuterErr::Bad through the flattened slot.
    let bad = sum_all([10, -5, 30]);
    assert bad matches { Err(OuterErr::Bad) };

    // Empty: first `step()` yields Ok(Err(-1)) → break → total 0.
    let empty = sum_all([] as List<i64>);
    assert empty matches { Ok(0) };
}

__DATA__
{
    "stdout": "",
    "wir_expect:O2": [
        "Cursor::step\" = fn(ref \"",
        "-> [i32, i32, i64, i32, ref null \"opt_sroa_variant_return_nested_result.wado//OuterErr\"]",
        "__n_discriminant",
        "__n_case0_payload_0",
        "__n_case1_payload_0"
    ],
    "wir_not_expect:O2": [
        "Result<i64,i32>"
    ]
}
