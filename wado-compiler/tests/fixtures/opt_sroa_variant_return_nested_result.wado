// Test: a variant return whose payload is itself a variant stays boxed at the
// inner level, and the outer level is still scalarized.
//
// `Cursor::step` returns `Result<Result<i64, i32>, OuterErr>` (the serde
// `next_element<Result>` shape). `optimize::sroa_variant_return` gives it
// `[outer_disc, ref Result<i64,i32>, ref OuterErr]` — the outer variant flattened,
// the inner `Result<i64, i32>` left as one slot it still builds at each return.
//
// Splitting that slot into `[inner_disc, i64, i32]` is what `wir_optimize`'s
// `slot_flatten` used to do, and it is deliberately not done here. Doing it in
// NIR was implemented and discarded: the callee stops allocating, but a call
// site that binds the whole inner value has to rebuild it, and the rebuild cost
// more than the allocation it removed. Recovering it needs the destructure
// pushed down into the call site, not the inner value reconstructed — see the
// WEP.
//
// `#[inline("never")]` keeps `step` a real SROA'd call site.
variant OuterErr {
    Bad,
}

struct Cursor {
    data: List<i64>,
    pos: i32,
}

impl Cursor {
    // Returns Ok(Ok(v)) for a value, Ok(Err(-1)) as the end sentinel, and
    // Err(OuterErr::Bad) for a negative element.
    #[inline("never")]
    fn step(&mut self) -> Result<Result<i64, i32>, OuterErr> {
        if self.pos >= self.data.len() {
            return Result::Ok(Result::Err(-1));
        }
        let v = self.data[self.pos];
        if v < 0 {
            return Result::Err(OuterErr::Bad);
        }
        self.pos += 1;
        return Result::Ok(Result::Ok(v));
    }
}

fn sum_all(data: List<i64>) -> Result<i64, OuterErr> {
    let mut cur = Cursor { data, pos: 0 };
    let mut total: i64 = 0;
    loop {
        let inner = cur.step()?;
        if let Ok(v) = inner {
            total += v;
        } else {
            break;
        }
    }
    return Result::Ok(total);
}

export fn run() {
    let ok = sum_all([10, 20, 30, 40]);
    assert ok matches { Ok(100) };

    // Error path: `?` propagates OuterErr::Bad through the flattened slot.
    let bad = sum_all([10, -5, 30]);
    assert bad matches { Err(OuterErr::Bad) };

    // Empty: first `step()` yields Ok(Err(-1)) → break → total 0.
    let empty = sum_all([] as List<i64>);
    assert empty matches { Ok(0) };
}

__DATA__
{
    "stdout": "",
    "wir_expect:O2": [
        "Cursor::step\" = fn(ref \"",
        "-> [i32, ref null \"core:prelude/types.wado//Result<i64,i32>\", ref null \""
    ]
}
