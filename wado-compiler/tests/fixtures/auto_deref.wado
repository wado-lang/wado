use { println, Stdout } from "core:cli";

// from auto_deref_method.wado
struct Point {
    x: i32,
    y: i32,
}

impl Point {
    fn sum(&self) -> i32 {
        return self.x + self.y;
    }

    fn scale(&self, factor: i32) -> i32 {
        return (self.x + self.y) * factor;
    }
}

// Generic struct for auto-deref on generic types
struct Wrapper<T> {
    value: T,
}

impl<T> Wrapper<T> {
    fn get(&self) -> T {
        return self.value;
    }
}

// from auto_deref_for_of.wado
fn auto_deref_for_of() with Stdout {
    // for-of on &List<T>
    let arr: List<i32> = [1, 2, 3];
    let ra = &arr;
    let mut sum = 0;
    for let x of ra {
        sum += *x;
    }
    assert sum == 6;

    // for-of on &String (chars)
    let s = "abc";
    let rs = &s;
    let mut count = 0;
    for let c of rs.chars() {
        count += 1;
    }
    assert count == 3;

    println("ok");
}

// from auto_deref_method.wado
fn auto_deref_method() with Stdout {
    // Basic auto-deref on simple struct
    let p = Point { x: 10, y: 20 };
    let p_ref = &p;
    assert p_ref.sum() == 30;
    assert p_ref.scale(2) == 60;

    // Double reference auto-deref
    let p_ref2 = &p_ref;
    assert p_ref2.sum() == 30;

    // Auto-deref on generic struct Wrapper<i32>
    let box_i32 = Wrapper { value: 42 };
    let box_ref = &box_i32;
    assert box_ref.get() == 42;

    // Auto-deref on generic struct Wrapper<String>
    let box_str = Wrapper { value: "hello" };
    let box_str_ref = &box_str;
    let inner = box_str_ref.get();
    assert inner.len() == 5;

    // Auto-deref on String methods
    let s = "hello";
    let s_ref = &s;
    assert s_ref.len() == 5;
    // Test bytes() iterator via auto-deref
    let mut bytes_iter = s_ref.bytes();
    if let Some(b) = bytes_iter.next() {
        assert b == 'h' as u8;
    }

    // Mutable reference auto-deref
    let mut p2 = Point { x: 5, y: 10 };
    let p2_mut_ref = &mut p2;
    assert p2_mut_ref.sum() == 15;

    // Triple reference auto-deref
    let p_ref3 = &p_ref2;
    assert p_ref3.sum() == 30;

    println("all auto-deref tests passed");
}

export fn run() with Stdout {
    auto_deref_for_of();
    auto_deref_method();
}

__DATA__
{"stdout": "ok\nall auto-deref tests passed\n"}
