// A `bool` holds one bit, so `~b` is its complement. The lowering reused the
// integer `xor -1`, leaving `-1` / `-2` — both non-zero, so `~false` and
// `~true` both read back as `true`. The bound agrees with the expression:
// `T: BitNot<Output = T>` admits `bool`.
use { println } from "core:cli";

fn flip<T: BitNot<Output = T>>(v: T) -> T {
    return ~v;
}

export fn run() with Stdout {
    let f = builtin::black_box(false);
    let t = builtin::black_box(true);
    println(`${~f} ${~t} ${flip(f)} ${flip(t)} ${~(0 as u8)}`);
}

__DATA__
{"stdout": "true false true false 255\n"}
