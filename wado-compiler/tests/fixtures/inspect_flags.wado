use { println, Stdout } from "core:cli";

pub flags Perms {
    Read,
    Write,
    Execute,
}

export fn run() with Stdout {
    let r = Perms::Read;
    println(`{r:?}`);

    let rw = Perms::Read | Perms::Write;
    println(`{rw:?}`);

    let all = Perms::all();
    println(`{all:?}`);

    let none = Perms::none();
    println(`{none:?}`);
}

__DATA__
{"stdout": "Perms::Read\nPerms::Read | Perms::Write\nPerms::Read | Perms::Write | Perms::Execute\nPerms::none()\n"}
