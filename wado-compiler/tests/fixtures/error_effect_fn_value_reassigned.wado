// A binding's row stands for every value moved into it, so calling it after a
// reassignment demands what the new value performs.
use { println, Stdout } from "core:cli";

fn reassign() {
    let mut f = || {};
    f = || { println("r"); };
    f();
}

export fn run() with Stdout {
    reassign();
}

