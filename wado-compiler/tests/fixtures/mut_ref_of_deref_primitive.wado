// `&mut *r` over a `&mut i32` names the storage `r` names, so a write through
// it lands where `r` points.

use { println, Stdout } from "core:cli";

fn bump(x: &mut i32) {
    *x += 1;
}

fn bump_twice(rc: &mut i32) {
    bump(&mut *rc);
    bump(&mut *rc);
}

export fn run() with Stdout {
    let mut c = 0;
    bump_twice(&mut c);
    println(`c=${c}`);
}

__DATA__
{"stdout": "c=2\n"}
