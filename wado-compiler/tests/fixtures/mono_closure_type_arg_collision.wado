// A closure type's mangle carries its parameter types, so a generic
// instantiated at two closures differing only there lands two names rather
// than tripping `monomorphize`'s duplicate check.
use { println, Stdout } from "core:cli";

fn count<T>(v: T) -> i32 {
    return 1;
}

export fn run() with Stdout {
    println(`${count(|x: i32| x + 1) + count(|s: bool| 2)}`);
}

__DATA__
{"stdout": "2\n"}
