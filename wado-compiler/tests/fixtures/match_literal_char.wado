// Test match expression with char literal patterns

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let a = 'a';
    let z = 'z';
    let newline = '\n';

    let r1 = match a {
        'a' => "letter a",
        'b' => "letter b",
        _ => "other",
    };
    println(r1);

    let r2 = match z {
        'a' => "letter a",
        'z' => "letter z",
        _ => "other",
    };
    println(r2);

    let r3 = match newline {
        '\n' => "newline",
        '\t' => "tab",
        _ => "other",
    };
    println(r3);
}

__DATA__
{"stdout": "letter a\nletter z\nnewline\n"}
