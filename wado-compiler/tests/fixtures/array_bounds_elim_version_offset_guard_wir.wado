// Loop-versioned BCE under a guard that offsets its variable: `v + 1 < n`,
// which a loop stepping two elements at a time writes. The largest `v` the
// guard admits is `n - 2`, and the residual compares it in `i64`, where the
// guard's own `v + 1` is not left to wrap. The fast arm carries no check.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn pairs(xs: &List<i32>, n: i32) -> i32 {
    let mut sum = 0;
    for let mut v = 0; v + 1 < n; v += 2 {
        sum += xs[v] * xs[v + 1];
    }
    return sum;
}

export fn run() with Stdout {
    let xs: List<i32> = [1, 2, 3, 4, 5, 6, 7];
    println(`${pairs(&xs, builtin::black_box(7))}`);
}

__DATA__
{
    "stdout": "44\n",
    "wir_scope": ".wado/pairs",
    "wir_expect:O2": [
        "((builtin::i64_extend_i32_s(n) + -2_i64) + 1_i64) < builtin::i64_extend_i32_s("
    ]
}
