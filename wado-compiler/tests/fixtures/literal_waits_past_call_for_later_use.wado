// A literal whose variable its call leaves open takes the type a later use
// settles, rather than its default where the call ends.

struct Bx<T> { v: Option<T> }

fn none<T>() -> Bx<T> { return Bx { v: null }; }

fn put<T>(b: Bx<T>, x: T) -> Bx<T> { return Bx { v: Some(x) }; }

fn take64(b: Bx<i64>) -> i64 { return b.v.unwrap(); }

fn empty<T>() -> List<T> { return []; }

fn first64(xs: List<i64>) -> i64 { return xs[0]; }

test "a later argument settles a literal argument" {
    let b = put(none(), 5);
    assert take64(b) == 5;
}

test "a later argument settles a literal pushed onto an open list" {
    let mut xs = empty();
    xs.push(5);
    assert first64(xs) == 5;
}

test "a literal nothing settles takes its default" {
    let b = put(none(), 5);
    let n: i32 = b.v.unwrap();
    assert n == 5;
}

test "a literal is retyped by the use, out of an i32's range" {
    let b = put(none(), 5_000_000_000);
    assert take64(b) == 5_000_000_000;
}
