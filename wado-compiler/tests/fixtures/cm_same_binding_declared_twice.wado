// Two modules declaring the same `Dom::f` binding share one import.

use { Dom as ADom } from "./sub/cm_same_interface_name_two_modules_a.wado";
use { Dom as BDom } from "./sub/cm_same_binding_declared_twice_b.wado";

export fn run() with (ADom, BDom) {
    let _ = ADom::f();
    let _ = BDom::f();
}

