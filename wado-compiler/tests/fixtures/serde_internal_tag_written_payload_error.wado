// `String` and `List` are declared as structs, but their hand-written
// `Serialize` writes a string and a sequence, which have no object to hold
// the tag.
use json from "core:json";

#[wire(tag = "type")]
variant Label {
    Name(String),
    Items(List<i32>),
    Empty,
}

export fn run() {
    json::to_string(&Label::Empty);
}

