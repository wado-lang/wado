use { println, Stdout } from "core:cli";


// from integer_i8_basic.wado
fn integer_i8_basic() with Stdout {
    // Basic assignment
    let a: i8 = 10 as i8;
    let b: i8 = 3 as i8;

    // Arithmetic operations
    let sum = a + b;
    println(`sum: {sum}`);

    let diff = a - b;
    println(`diff: {diff}`);

    let prod = a * b;
    println(`prod: {prod}`);

    let quot = a / b;
    println(`quot: {quot}`);

    let rem = a % b;
    println(`rem: {rem}`);
}

// from integer_i8_comparison.wado
fn integer_i8_comparison() with Stdout {
    let a: i8 = 10 as i8;
    let b: i8 = 20 as i8;
    let c: i8 = -5 as i8;

    // Positive comparisons
    if a < b {
        println("a < b: true");
    }
    if a <= b {
        println("a <= b: true");
    }
    if b > a {
        println("b > a: true");
    }
    if b >= a {
        println("b >= a: true");
    }

    // Negative comparisons (critical for signed types)
    if c < a {
        println("c < a: true");
    }
    if c < 0 as i8 {
        println("c < 0: true");
    }
    if a > c {
        println("a > c: true");
    }

    // Equality
    let d: i8 = 10 as i8;
    if a == d {
        println("a == d: true");
    }
    if a != b {
        println("a != b: true");
    }
}

// from integer_i8_edge.wado
fn integer_i8_edge() with Stdout {
    // Max value: 127
    let max: i8 = 127 as i8;
    println(`max: {max}`);

    // Min value: -128
    let min: i8 = -128 as i8;
    println(`min: {min}`);

    // Negative arithmetic
    let neg: i8 = -50 as i8;
    let pos: i8 = 30 as i8;
    let sum = neg + pos;
    println(`neg + pos: {sum}`);

    // Negative division
    let div_result: i8 = -10 as i8 / 3 as i8;
    println(`-10 / 3: {div_result}`);

    // Negative modulo
    let mod_result: i8 = -10 as i8 % 3 as i8;
    println(`-10 % 3: {mod_result}`);
}

export fn run() with Stdout {
    integer_i8_basic();
    integer_i8_comparison();
    integer_i8_edge();
}

__DATA__
{"stdout": "sum: 13\ndiff: 7\nprod: 30\nquot: 3\nrem: 1\na < b: true\na <= b: true\nb > a: true\nb >= a: true\nc < a: true\nc < 0: true\na > c: true\na == d: true\na != b: true\nmax: 127\nmin: -128\nneg + pos: -20\n-10 / 3: -3\n-10 % 3: -1\n"}
