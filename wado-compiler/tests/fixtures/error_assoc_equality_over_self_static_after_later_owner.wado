// A static's bound over `Self` holds of an owner a later arm settles:
// `Self` is the receiver `M`, whose `Item` is `i32`, and `Box::Item` is `bool`.
trait Holder with () {
    type Item;
    fn empty() -> Self;
}

struct Box {
    v: i32,
}

impl Holder for Box {
    type Item = bool;
    fn empty() -> Box {
        return Box { v: 3 };
    }
}

trait Maker with () {
    type Item;
    fn made<T, H: Holder<Item = Self::Item>>(t: T) -> H;
}

struct M {
    v: i32,
}

impl Maker for M {
    type Item = i32;
    fn made<T, H: Holder<Item = i32>>(_t: T) -> H {
        return H::empty();
    }
}

test "the owner's projection disagrees with Self::Item" {
    let [_n, _b] = match builtin::black_box(true) {
        true => [3, M::made(1)],
        false => [0, Box { v: 0 }],
    };
}

