// Quoted by docs/spec-control-flow.md § Conditional Statements and docs/spec-patterns.md § Match Ergonomics.

test "if, else and else-if chains" {
    let x = 7;
    let mut sign = "";
    if x < 0 {
        sign = "negative";
    } else if x == 0 {
        sign = "zero";
    } else {
        sign = "positive";
    }
    assert sign == "positive";
}

test "if as an expression" {
    let x = -3;
    let abs = if x < 0 { -x } else { x };
    assert abs == 3;

    let score = 85;
    let grade = if score >= 90 { "A" } else if score >= 80 { "B" } else { "C" };
    assert grade == "B";
}

test "if let" {
    let opt: Option<i32> = Option::<i32>::Some(42);
    let mut got = 0;
    if let Some(x) = opt {
        got = x;
    } else {
        got = -1;
    }
    assert got == 42;
}

test "let chains" {
    let a: Option<i32> = Option::Some(4);
    let b: Option<i32> = Option::Some(6);
    let mut got = 0;
    if let Some(x) = a && x % 2 == 0 && let Some(y) = b && y > x {
        got = x + y;            // `x` and `y` are in scope here
    } else {
        got = -1;               // neither is in scope here
    }
    assert got == 10;

    // A later `let` may rebind a name an earlier one bound.
    if let Some(x) = a && let Some(x) = Option::Some(x * 10) {
        got = x;
    }
    assert got == 40;
}

test "a let chain stops at the first operand that fails" {
    let none: Option<i32> = null;
    let mut calls = 0;
    let mut tick = || {
        calls += 1;
        return true;
    };
    if let Some(_) = none && tick() {
        calls += 100;
    }
    assert calls == 0;
}

test "match ergonomics" {
    let opt: Option<i32> = Option::<i32>::Some(42);
    let ro = &opt;
    if let Some(x) = ro {       // ro: &Option<i32>, x: &i32
        assert *x == 42;        // dereference to use the value
    }
}

fn parse_port(s: String) -> i32 {
    let Ok(port) = i32::from_str(&s) else {
        return -1;
    };
    return port;                // `port` is in scope here
}

test {
    assert parse_port("8080") == 8080;
    assert parse_port("http") == -1;
}
