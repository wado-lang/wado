// `?` in a clause would leave the caller, as a `return` would.
fn parse(n: i32) -> Result<i32, String> {
    return Ok(n);
}

fn f(n: i32) -> Result<i32, String>
    contract parse(n)? >= 0
{
    return Ok(n);
}

export fn run() {
    let _ = f(1);
}

