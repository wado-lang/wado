// A `for-of` over an empty tuple unrolls to nothing, so its body and every
// region inside it report as never run.
fn count() -> i32 {
    let mut n = 0;
    for let v of [] {
        if n > 1 {
            n += 2;
        }
        n += 1;
    }
    return n;
}

test {
    assert count() == 0;
}

