// Struct destructuring in for-of loops

use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

export fn run() with Stdout {
    let points: Array<Point> = [
        Point { x: 1, y: 2 },
        Point { x: 3, y: 4 },
        Point { x: 5, y: 6 },
    ];

    // for-of with unnamed struct destructuring
    for let { x, y } of points {
        println(`{x + y}`);
    }

    // for-of with rename
    for let { x: a, y: b } of points {
        println(`{a * b}`);
    }
}

__DATA__
{"stdout": "3\n7\n11\n2\n12\n30\n"}
