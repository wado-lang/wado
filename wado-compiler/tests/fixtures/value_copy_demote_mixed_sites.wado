// `value_copy_demote` soundness: one function with two copies that share
// the same `$value_copy$T_List<String>` helper. `sorted` is only
// spine-mutated and read; `victim` has an element mutated via
// `victim[0].push`.
//
// The demote decides each site on its own, and `victim` must stay deep:
// a shallow copy would share `b`'s `String` objects, so
// `victim[0].push('!')` would corrupt `b[0]`.
//
// The stdout assertion catches the corruption (`b[0]` must remain "hi").

use { println, Stdout } from "core:cli";

fn process(a: &List<String>, b: &List<String>) -> String {
    let mut sorted = *a;
    sorted.sort();
    let mut victim = *b;
    victim[0].push('!');
    return `${sorted[0]} ${victim[0]} ${b[0]}`;
}

export fn run() with Stdout {
    let a: List<String> = ["q", "p"];
    let b: List<String> = ["hi", "yo"];
    println(process(&a, &b));
}

__DATA__
{
    "stdout": "p hi! hi\n",
    "wir_expect:O2": ["array_clone_deep"],
    "wir_scope": "value_copy_demote_mixed_sites.wado/process",
    "wir_contrast": {"O2": [
        {"    victim[0].push('!');\n": ""}
    ]}
}
