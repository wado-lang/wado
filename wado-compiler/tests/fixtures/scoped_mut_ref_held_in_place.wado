// A `&mut` of a `RefMut` type names an object of its own, so a variable, a
// field or a returned value holds it; so does a parameter of a function type.
// A `&mut` of any type is a parameter's, which the caller's scope bounds.

struct Point {
    x: i32,
}

struct Cursor {
    at: &mut Point,
}

fn keep<T: RefMut>(p: &mut T) -> &mut T {
    return p;
}

fn apply(f: fn(&mut i32), n: &mut i32) {
    f(n);
}

test "a `RefMut` type is held" {
    let mut p = Point { x: 1 };
    let r = &mut p;
    r.x = 2;
    let c = Cursor { at: keep(&mut p) };
    c.at.x += 1;
    assert p.x == 3;
}

test "a parameter takes any `&mut`" {
    let mut n = 1;
    apply(|m: &mut i32| *m += 1, &mut n);
    assert n == 2;
}
