// A default body reaching a bound's subject directly takes the impl for what
// the subject binds to, a reference included.
//
// `Items: Bump` names `Self::Items` itself, and `Bag` binds it to
// `&mut List<P>`, so `bump` is `Bump for &mut List<P>`, not the `List<P>` impl
// the reference also reaches, as the same code written as an inherent method
// does. Only a receiver that is a reference to the subject, as in
// `assoc_default_body_ref_receiver_selects_through_bound`, reads past a `&T`
// impl.

use { println, Stdout } from "core:cli";

struct P {
    v: i32,
}

trait Bump with () {
    fn bump(&mut self);
}

impl Bump for List<P> {
    fn bump(&mut self) {
        for let p of self {
            p.v += 1;
        }
    }
}

impl Bump for &mut List<P> {
    fn bump(&mut self) {
        for let p of &mut **self {
            p.v += 10;
        }
    }
}

trait Holder with () {
    type Items: Bump;

    fn items(&mut self) -> Self::Items;

    fn bump(&mut self) {
        let mut it = self.items();
        it.bump();
    }
}

struct Bag {
    xs: List<P>,
}

impl Holder for Bag {
    type Items = &mut List<P>;

    fn items(&mut self) -> &mut List<P> {
        return &mut self.xs;
    }
}

impl Bag {
    fn bump_inherent(&mut self) {
        let mut it = self.items();
        it.bump();
    }
}

export fn run() with Stdout {
    let mut b = Bag { xs: [P { v: 1 }, P { v: 2 }] };
    b.bump();
    println(`${b.xs:?}`);
    b.bump_inherent();
    println(`${b.xs:?}`);
}

__DATA__
{
    "stdout": "[P { v: 11 }, P { v: 12 }]\n[P { v: 21 }, P { v: 22 }]\n"
}
