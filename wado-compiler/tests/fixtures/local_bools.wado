// Test local boolean variables

use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let t = true;
    let f = false;

    if t {
        println("t is true");
    }

    if f {
        println("f is true");
    } else {
        println("f is false");
    }
}

__DATA__
{"stdout": "t is true\nf is false\n"}
