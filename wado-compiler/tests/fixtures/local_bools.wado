use { println, Stdout } from "core:cli";


// from local_bools.wado
fn local_bools() with Stdout {
    let t = true;
    let f = false;

    if t {
        println("t is true");
    }

    if f {
        println("f is true");
    } else {
        println("f is false");
    }
}

// from local_bools_mut.wado
fn local_bools_mut() with Stdout {
    let mut flag = false;

    if flag {
        println("flag is true");
    } else {
        println("flag is false");
    }

    flag = true;

    if flag {
        println("flag is true");
    } else {
        println("flag is false");
    }
}

export fn run() with Stdout {
    local_bools();
    local_bools_mut();
}

__DATA__
{"stdout": "t is true\nf is false\nflag is false\nflag is true\n"}
