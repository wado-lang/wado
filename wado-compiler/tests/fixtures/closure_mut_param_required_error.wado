// Function parameters typed `fn mut(...)` must be bound `mut f:`.
// See wep-2026-01-16-closure-implementation.md ("Mutability Binding
// Requirement").

fn run(f: fn mut(i32)) {
    f(1);
}

test "fn mut parameter requires mut" {
    let mut count = 0;
    run(|x: i32| {
        count += x;
    });
    assert count == 1;
}

__DATA__
{"test": {}, "compile_error": "mut"}
