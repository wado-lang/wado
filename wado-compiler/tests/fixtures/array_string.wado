use { println, Stdout } from "core:cli";

// from array_string_param.wado
fn join_names(names: List<String>) -> String {
    return `{names[0]} and {names[1]}`;
}

// from array_string.wado
fn array_string() with Stdout {
    let names: List<String> = ["Alice", "Bob", "Charlie"];
    println(`{names[0]}, {names[1]}, {names[2]}`);
}

// from array_string_cast.wado
fn array_string_cast() with Stdout {
    let names = ["Hello", "World"] as List<String>;
    println(`{names[0]} {names[1]}`);
}

// from array_string_param.wado
fn array_string_param() with Stdout {
    let result = join_names(["Alice", "Bob"]);
    println(result);
}

export fn run() with Stdout {
    array_string();
    array_string_cast();
    array_string_param();
}

__DATA__
{"stdout": "Alice, Bob, Charlie\nHello World\nAlice and Bob\n"}
