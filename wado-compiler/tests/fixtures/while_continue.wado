// Test continue in while loop

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut count = 0;
    while count < 5 {
        count = count + 1;
        if count == 3 {
            continue;
        }
        println(`count: {count}`);
    }
    println("done");
}

__DATA__
{"stdout": "count: 1\ncount: 2\ncount: 4\ncount: 5\ndone\n"}
