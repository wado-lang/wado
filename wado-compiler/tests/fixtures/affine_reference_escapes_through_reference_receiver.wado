// A `&mut` handed to a call by value is a `&mut` the callee may store through,
// whether it is an argument, the `self` of an impl written for the reference,
// or either under a newtype over a reference.
// Regression: only a `&mut self` receiver and an argument typed `&mut` itself
// counted, so a reference into an affine local escaped through the others.

affine struct Tok { id: i32 }

impl Drop for Tok {
    fn drop(self) {}
}

affine trait Sink with () {
    fn take(self, t: &Tok);
}

impl Sink for &mut List<&Tok> {
    #[allow(self_by_value)]
    fn take(self, t: &Tok) { (*self).push(t); }
}

type Seen = &mut List<&Tok>;

fn push_to(out: Seen, t: &Tok) {
    (out as &mut List<&Tok>).push(t);
}

fn keep_by_receiver(out: &mut List<&Tok>) {
    let t = Tok { id: 7 };
    out.take(&t);
}

fn keep_by_newtype_argument(out: Seen) {
    let t = Tok { id: 8 };
    push_to(out, &t);
}

test {
    let mut seen: List<&Tok> = [];
    keep_by_receiver(&mut seen);
    keep_by_newtype_argument(&mut seen as Seen);
}

