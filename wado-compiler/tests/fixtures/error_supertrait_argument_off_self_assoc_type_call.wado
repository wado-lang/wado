// The projection resolves, so the supertrait clause is not a type error, but
// the call through it reaches no impl (WEP: Trait Resolution, known gaps).

trait Make<T> with () {
    fn make(v: T) -> Self;
}

trait Constrained: Make<Self::Base> with () {
    type Base;

    fn check(b: &Self::Base) -> bool;
}

struct UserName {
    value: String,
}

impl Make<String> for UserName {
    fn make(v: String) -> UserName {
        return UserName { value: v };
    }
}

impl Constrained for UserName {
    type Base = String;

    fn check(b: &String) -> bool {
        return b.len() > 0;
    }
}

fn build<T: Constrained>(b: T::Base) -> T {
    return T::make(b);
}

test "a supertrait argument off Self::Assoc carries no call" {
    assert build::<UserName>("gfx").value == "gfx";
}

__DATA__
{
    "test": {},
    "compile_error": "type `UserName` does not implement trait `Make<Base>`",
    "compile_errors_not_contains": ["unknown type 'Self::Base'"]
}
