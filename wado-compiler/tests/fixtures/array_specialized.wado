    arr.push(1 as i8);
    arr.push(-2 as i8);
    arr.push(3 as i8);

    for let x of arr {
        println(`{x}`);
    }
}

// from array_specialized_string.wado
fn array_specialized_string() with Stdout {
    let mut arr: List<String> = [];
    arr.push("hello");
    arr.push("world");
    arr.push("!");

    for let x of arr {
        println(`{x}`);
    }
}

// from array_specialized_tuple.wado
fn array_specialized_tuple() with Stdout {
    let mut arr: List<[bool, i32, String]> = [];
    arr.push([true, 1, "one"]);
    arr.push([false, 2, "two"]);
    arr.push([true, 3, "three"]);

    for let x of arr {
        println(`{x.0} {x.1} {x.2}`);
    }
}

