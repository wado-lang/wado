export fn run() with Stdout {
    array_specialized_bool();
    array_specialized_char();
    array_specialized_f32();
    array_specialized_f64();
    array_specialized_i16();
    array_specialized_i32();
    array_specialized_i64();
    array_specialized_i8();
    array_specialized_string();
    array_specialized_tuple();
    array_specialized_u16();
    array_specialized_u32();
    array_specialized_u64();
    array_specialized_u8();
}

