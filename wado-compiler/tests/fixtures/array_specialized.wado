}

// from array_specialized_i16.wado
fn array_specialized_i16() with Stdout {
    let mut arr: List<i16> = [];
    arr.push(1000 as i16);
    arr.push(-2000 as i16);
    arr.push(3000 as i16);

    for let x of arr {
        println(`{x}`);
    }
}

// from array_specialized_i32.wado
