use { println, Stdout } from "core:cli";


// from array_specialized_bool.wado
fn array_specialized_bool() with Stdout {
    let mut arr: List<bool> = [];
    arr.push(true);
    arr.push(false);
    arr.push(true);

    for let x of arr {
        println(`{x}`);
    }
}

// from array_specialized_char.wado
fn array_specialized_char() with Stdout {
    let mut arr: List<char> = [];
    arr.push('A');
    arr.push('B');
    arr.push('C');

    for let x of arr {
        println(`{x}`);
    }
}

// from array_specialized_f32.wado
fn array_specialized_f32() with Stdout {
    let mut arr: List<f32> = [];
    arr.push(1.5 as f32);
    arr.push(2.5 as f32);
    arr.push(3.5 as f32);

    for let x of arr {
        println(`{x}`);
    }
}

