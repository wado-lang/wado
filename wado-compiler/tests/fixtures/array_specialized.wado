    let mut arr: List<i32> = [];
    arr.push(100000);
    arr.push(-200000);
    arr.push(300000);

    for let x of arr {
        println(`{x}`);
    }
}

// from array_specialized_i64.wado
fn array_specialized_i64() with Stdout {
    let mut arr: List<i64> = [];
    arr.push(10000000000 as i64);
    arr.push(-20000000000 as i64);
    arr.push(30000000000 as i64);

    for let x of arr {
        println(`{x}`);
    }
}

// from array_specialized_i8.wado
fn array_specialized_i8() with Stdout {
