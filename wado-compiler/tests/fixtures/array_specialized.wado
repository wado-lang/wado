use { println, Stdout } from "core:cli";


// from array_specialized_bool.wado
fn array_specialized_bool() with Stdout {
    let mut arr: Array<bool> = [];
    arr.append(true);
    arr.append(false);
    arr.append(true);

    for let x of arr {
        println(`{x}`);
    }
}

// from array_specialized_char.wado
fn array_specialized_char() with Stdout {
    let mut arr: Array<char> = [];
    arr.append('A');
    arr.append('B');
    arr.append('C');

    for let x of arr {
        println(`{x}`);
    }
}

// from array_specialized_f32.wado
fn array_specialized_f32() with Stdout {
    let mut arr: Array<f32> = [];
    arr.append(1.5 as f32);
    arr.append(2.5 as f32);
    arr.append(3.5 as f32);

    for let x of arr {
        println(`{x}`);
    }
}

// from array_specialized_f64.wado
