use { println, Stdout } from "core:cli";

fn test_overflow() with Stdout {
    // Addition overflow: 127 + 1 should wrap to -128
    let a: i8 = 127 as i8;
    let b: i8 = 1 as i8;
    let sum = a + b;
    println(`127 + 1: {sum}`);

    // The wrapped value should be negative
    if sum < 0 as i8 {
        println("sum is negative: true");
    } else {
        println("sum is negative: false");
    }

    // Subtraction underflow: -128 - 1 should wrap to 127
    let min: i8 = -128 as i8;
    let sub = min - b;
    println(`-128 - 1: {sub}`);

    // The wrapped value should be positive
    if sub > 0 as i8 {
        println("sub is positive: true");
    } else {
        println("sub is positive: false");
    }

    // Multiplication overflow: 127 * 2 should wrap to -2
    let two: i8 = 2 as i8;
    let mul = a * two;
    println(`127 * 2: {mul}`);

    // Negation overflow: -(-128) should wrap to -128
    let neg = -min;
    println(`-(-128): {neg}`);

    // Overflow then comparison
    let x: i8 = 100 as i8;
    let y: i8 = 100 as i8;
    let z = x + y;
    // 200 as i8 = -56, should be less than 0
    if z < 0 as i8 {
        println("100 + 100 < 0: true");
    } else {
        println("100 + 100 < 0: false");
    }
}

export fn run() with Stdout {
    test_overflow();
}

__DATA__
{"stdout": "127 + 1: -128\nsum is negative: true\n-128 - 1: 127\nsub is positive: true\n127 * 2: -2\n-(-128): -128\n100 + 100 < 0: true\n"}
