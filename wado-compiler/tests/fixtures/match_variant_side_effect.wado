// Test: match on variant used as a statement (side-effect only, no return value).
// TODO: old codegen cannot handle this; WIR backend passes.

use { println, Stdout } from "core:cli";

variant Direction {
    Left,
    Center,
    Right,
}

export fn run() with Stdout {
    let dir = Direction::Center;

    // Match used as statement — branches have side effects only (no return value)
    match dir {
        Left => {
            println("go left");
        },
        Center => {
            println("go center");
        },
        Right => {
            println("go right");
        },
    };

    println("done");
}

