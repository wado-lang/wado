//! A type parameter no field mentions and no default fills. Nothing settles
//! it, so the literal reports it the way a call reports its own. Answering it
//! with the declaration's `T` sends a type that is not a type to codegen.

struct Tagged<T> {
    x: i32,
}

test "a phantom parameter with no default" {
    let p = Tagged { x: 1 };
    assert p.x == 1;
}

__DATA__
{"compile_error": "cannot infer type parameter `T` of struct `Tagged`"}
