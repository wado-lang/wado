// Test: an `impl Trait for T;` marker is a conformance check, never a
// synthesis trigger (WEP: Trait Derivation Policy). A marker'd type that
// nothing compares still validates but gets no body; usage elsewhere is
// what generates code.
//
// Checked at -O0 so constant folding cannot mask the used case.
struct MarkedUnused {
    x: i32,
}

impl Eq for MarkedUnused;
impl Ord for MarkedUnused;

struct MarkedUsed {
    x: i32,
}

impl Eq for MarkedUsed;

export fn run() {
    let a = MarkedUsed { x: 1 };
    let b = MarkedUsed { x: 1 };
    assert a == b;

    let _unused = MarkedUnused { x: 2 };
}

__DATA__
{
    "wir_expect:O0": ["MarkedUsed^Eq::eq"],
    "wir_not_expect:O0": ["MarkedUnused^Eq::eq", "MarkedUnused^Ord::cmp"]
}
