use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let arr: Array<i32> = [1, 2, 3];
    println(`{arr:?}`);

    let empty: Array<i32> = [];
    println(`{empty:?}`);

    let single: Array<i32> = [42];
    println(`{single:?}`);
}

__DATA__
{"stdout": "[1, 2, 3]\n[]\n[42]\n"}
