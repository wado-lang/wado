use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

export fn run() with Stdout {
    let arr: Array<i32> = [1, 2, 3];
    println(`{arr:?}`);

    let empty: Array<i32> = [];
    println(`{empty:?}`);

    let single: Array<i32> = [42];
    println(`{single:?}`);

    // Without :? — Array<T> has no Display impl, falls back to inspect
    println(`{arr}`);
    println(`{empty}`);

    // Array of structs without Display
    let points: Array<Point> = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }];
    println(`{points}`);
}

__DATA__
{"stdout": "[1, 2, 3]\n[]\n[42]\n[1, 2, 3]\n[]\n[Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]\n"}
