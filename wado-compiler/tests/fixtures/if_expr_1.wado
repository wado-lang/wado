use { println, Stdout } from "core:cli";

// from if_expr_complex_let.wado
variant Mode {
    Decimal,
    Exp,
}

fn compute(mode: Mode, precision: i32, exp_est: i32) -> i32 {
    let n = if mode matches { Decimal } {
        // Multiple let statements followed by nested if expression
        let base = precision + 1;
        let adjusted = base + exp_est;
        if exp_est >= 0 {
            adjusted;
        } else {
            base;
        }
    } else {
        precision + 1;
    };
    return n;
}

// from if_expr_basic.wado
fn if_expr_basic() with Stdout {
    let x = if true {
        42;
    } else {
        0;
    };


    println(`{x}`);
    let y = if false {
        100;
    } else {
        200;
    };


    println(`{y}`);
}

// from if_expr_complex_let.wado
fn if_expr_complex_let() with Stdout {
    println(`{compute(Mode::Decimal, 2, 3)}`);
    println(`{compute(Mode::Decimal, 2, -1)}`);
    println(`{compute(Mode::Exp, 2, 3)}`);
}

// from if_expr_else_if.wado
fn if_expr_else_if() with Stdout {
    let n = 25;
    let x = if n < 10 {
        1;
    } else if n < 20 {
        2;
    } else if n < 30 {
        3;
    } else {
        4;
    };


    println(`{x}`);
    let y = if n == 25 {
        100;
    } else if n == 24 {
        200;
    } else {
        300;
    };


    println(`{y}`);
}

export fn run() with Stdout {
    if_expr_basic();
    if_expr_complex_let();
    if_expr_else_if();
}

__DATA__
{"stdout": "42\n200\n6\n3\n3\n3\n100\n"}
