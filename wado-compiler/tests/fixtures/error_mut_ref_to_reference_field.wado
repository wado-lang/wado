// A reference is replaced on assign, as a primitive is, so a `&mut` to a field
// holding one is a copy, and a variable holding it would lose the write
// `*p = &b`.

struct H {
    r: &i32,
}

export fn run() {
    let a = 1;
    let b = 2;
    let mut h = H { r: &a };
    let p = &mut h.r;
    *p = &b;
    assert *h.r == 2;
}

__DATA__
{"compile_error": "a variable cannot hold a `&mut &i32`"}
