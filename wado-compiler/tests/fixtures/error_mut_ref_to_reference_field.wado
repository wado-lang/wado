// A reference is replaced on assign, as a primitive is, so a `&mut` to a field
// holding one is a copy the variable holds past any point a store could go
// back: the write `*p = &b` replaces through it, and would be lost.

struct H {
    r: &i32,
}

export fn run() {
    let a = 1;
    let b = 2;
    let mut h = H { r: &a };
    let p = &mut h.r;
    *p = &b;
    assert *h.r == 2;
}

__DATA__
{"compile_error": ":13:18: analysis error: a mutable reference to a field or element of a replace-on-assign type is a detached copy, so a whole-value write through it would be lost: a variable holds it past the reference"}
