// An unsigned type has no `Neg`, so `-x` on one is an error at every width.
// `wrapping_neg` is the method that negates modulo the width.
// The unary operators read the same table as the binary ones.

fn on_u8(x: u8) -> u8 {
    return -x;
}

fn on_u16(x: u16) -> u16 {
    return -x;
}

fn on_u32(x: u32) -> u32 {
    return -x;
}

fn on_u64(x: u64) -> u64 {
    return -x;
}

fn on_u128(x: u128) -> u128 {
    return -x;
}

// Neither `char` nor `bool` is a number, and a `char` is no bit pattern.
fn on_char_and_bool(c: char, b: bool) {
    let _neg_char = -c;
    let _not_char = ~c;
    let _neg_bool = -b;
}

export fn run() {
    on_u8(1_u8);
    on_u16(1_u16);
    on_u32(1_u32);
    on_u64(1_u64);
    on_u128(1_u128);
    on_char_and_bool('a', true);
}

