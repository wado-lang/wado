// For-of loop with break

use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let numbers: Array<i32> = [1, 2, 3, 4, 5];
    for let n of numbers {
        if n == 3 {
            break;
        }
        println(`{n}`);
    }
    println("done");
}

__DATA__
{"stdout": "1\n2\ndone\n"}
