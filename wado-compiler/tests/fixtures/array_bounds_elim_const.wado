// Test: bounds check elimination for constant-index access on known-size arrays
// When an array is created with a literal (known size), accessing with a constant
// index that is in-bounds should have the bounds check eliminated at O2.

test "constant index within bounds" {
    let arr: List<i32> = [10, 20, 30];
    assert arr[0] == 10;
    assert arr[1] == 20;
    assert arr[2] == 30;
}

test "multiple arrays with different sizes" {
    let a: List<i32> = [1, 2];
    let b: List<i32> = [10, 20, 30, 40];
    assert a[0] == 1;
    assert a[1] == 2;
    assert b[0] == 10;
    assert b[3] == 40;
}

test "array with write then read" {
    let mut arr: List<i32> = [0, 0, 0];
    arr[0] = 42;
    arr[1] = 99;
    arr[2] = 7;
    assert arr[0] == 42;
    assert arr[1] == 99;
    assert arr[2] == 7;
}

__DATA__
{"test": {}}
