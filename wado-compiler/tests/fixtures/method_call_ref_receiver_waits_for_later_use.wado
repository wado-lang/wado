// A call through a reference whose impls are written for `&Bx<_>` waits, as a
// call on the value does, for a later use to settle which one it reaches.

struct Bx<T> { v: Option<T> }

fn empty<T>() -> Bx<T> { return Bx { v: null }; }

trait Lbl with () {
    fn label(&self) -> i32;
}

impl Lbl for &Bx<i32> {
    fn label(&self) -> i32 { return 1; }
}

impl Lbl for &Bx<bool> {
    fn label(&self) -> i32 { return 2; }
}

test {
    let b = empty();
    let r = &b;
    let n = r.label();
    let _settled: Bx<bool> = b;
    assert n == 2;
}
