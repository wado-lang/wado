// Tests: Descriptor::rename_at and Descriptor::unlink_file_at
//
// Verifies that:
// - rename_at moves a file from one name to another
// - The old name no longer exists after rename
// - The new name has the correct content
// - unlink_file_at removes a file
// - unlink_file_at on nonexistent file returns error

use { println, eprintln, Stdout, Stderr } from "core:cli";
use { Preopens, Descriptor, Filesize, DescriptorFlags, PathFlags, OpenFlags } from "wasi:filesystem";


export fn run() with Stdout, Stderr, Preopens {
    let dirs = Preopens::get_directories();
    if dirs.len() == 0 {
        eprintln("no preopened directories available");
        return;
    }

    let dir = dirs[0].0;

    // Create a source file with known content
    let src_result = dir.open_at(
        PathFlags::none(),
        "rename_src.txt",
        OpenFlags::Create | OpenFlags::Truncate,
        DescriptorFlags::Write,
    ).wait();

    if let Ok(src_file) = src_result {
        let [write_rx, write_tx] = Stream::<u8>::new();
        let sub = src_file.write_via_stream(write_rx, 0 as Filesize);
        // Write "RENAME" (82, 69, 78, 65, 77, 69)
        let data: List<u8> = [82, 69, 78, 65, 77, 69];
        write_tx.write(data);
        write_tx.drop();
        sub.drop();
        println("rename: source file created");
    } else {
        eprintln("rename: failed to create source file");
        return;
    }

    // Rename src -> dst
    let rename_result = dir.rename_at("rename_src.txt", &dir, "rename_dst.txt").wait();
    if let Ok(_) = rename_result {
        println("rename: rename_at succeeded");
    } else {
        eprintln("rename: rename_at failed");
        return;
    }

    // Verify old name no longer exists
    let old_result = dir.open_at(
        PathFlags::none(),
        "rename_src.txt",
        OpenFlags::none(),
        DescriptorFlags::Read,
    ).wait();
    if let Err(err) = old_result {
        if err matches { NoEntry } {
            println("rename: old path returns NoEntry (correct)");
        } else {
            eprintln("rename: old path returned unexpected error");
        }
    } else {
        eprintln("rename: old path should not exist");
    }

    // Verify new name exists and has correct content
    let dst_result = dir.open_at(
        PathFlags::none(),
        "rename_dst.txt",
        OpenFlags::none(),
        DescriptorFlags::Read,
    ).wait();
    if let Ok(dst_file) = dst_result {
        let stat_result = dst_file.stat().wait();
        if let Ok(stat) = stat_result {
            if stat.size == 6 as Filesize {
                println("rename: destination has correct size (correct)");
            } else {
                let sz = stat.size as u64;
                eprintln(`rename: destination size is {sz}, expected 6`);
            }
        }
    } else {
        eprintln("rename: failed to open destination file");
    }

    // Test unlink_file_at
    let unlink_result = dir.unlink_file_at("rename_dst.txt").wait();
    if let Ok(_) = unlink_result {
        println("unlink: removed rename_dst.txt");
    } else {
        eprintln("unlink: failed to remove rename_dst.txt");
    }

    // Verify file is gone
    let gone_result = dir.open_at(
        PathFlags::none(),
        "rename_dst.txt",
        OpenFlags::none(),
        DescriptorFlags::Read,
    ).wait();
    if let Err(err) = gone_result {
        if err matches { NoEntry } {
            println("unlink: file is gone (correct)");
        } else {
            eprintln("unlink: unexpected error after removal");
        }
    } else {
        eprintln("unlink: file should not exist after removal");
    }

    // Test unlink nonexistent file
    let unlink_missing = dir.unlink_file_at("nonexistent_file.txt").wait();
    if let Err(_) = unlink_missing {
        println("unlink: nonexistent file returns error (correct)");
    } else {
        eprintln("unlink: nonexistent file should return error");
    }

    println("all rename/unlink tests passed");
}

__DATA__
{
    "preopened_dirs": [["", "scratch"]],
    "stdout_contains": [
        "rename: source file created",
        "rename: rename_at succeeded",
        "rename: old path returns NoEntry (correct)",
        "rename: destination has correct size (correct)",
        "unlink: removed rename_dst.txt",
        "unlink: file is gone (correct)",
        "unlink: nonexistent file returns error (correct)",
        "all rename/unlink tests passed"
    ]
}
