// `[a, b, c].1` is `b` when the unselected elements are deletable. An element
// that prints is not, so that tuple stands and its side effect still happens.

use { println, Stdout } from "core:cli";

fn shout(s: String) -> String with Stdout {
    println(`side: ${s}`);
    return s;
}

export fn run() with Stdout {
    let n = builtin::black_box(3);
    println(`${[n, n * 2, n * 3].1}`);
    println([`kept`, shout(`boom`)].0);
}

__DATA__
{
    "stdout": "6\nside: boom\nkept\n",
    "wir_expect:O2": [
        "i32::fmt_decimal$scalar$spec0$scalar\"(3 * 2,"
    ],
    "wir_not_expect:O2": [
        "3 * 3"
    ]
}
