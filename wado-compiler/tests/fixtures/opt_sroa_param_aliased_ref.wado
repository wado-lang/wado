// Soundness regression for single-field-parameter SROA.
//
// `Node` is a single-field struct, so `sroa_param` is tempted to rewrite the
// read-only `b: &mut Node` parameter to a by-value `i32`, turning the call
// `run_loop(&mut n, &mut n)` into `run_loop(&mut n, n.value)` — a SNAPSHOT of
// `n.value` taken at the call site. But `a` and `b` alias the same node and the
// loop mutates `a.value`; Wado references alias (spec: "every read and write
// lands on the same location"), so `b.value` must observe each increment.
// Snapshotting `b` drops those writes and yields 0 instead of 15. The aliasing
// guard in `param_may_alias_sibling` must keep `b` as a reference.

use { println } from "core:cli";

struct Node { value: i32 }

#[inline("never")]
fn run_loop(a: &mut Node, b: &mut Node) -> i32 {
    let mut sum = 0;
    for let mut i = 0; i < 5; i += 1 {
        a.value = a.value + 1;   // write through a
        sum = sum + b.value;     // read through b (aliases *a)
    }
    return sum;
}

export fn run() with Stdout {
    let mut n = Node { value: 0 };
    let result = run_loop(&mut n, &mut n);  // a and b alias the same node
    // value: 0->1->2->3->4->5; sum = 1+2+3+4+5 = 15
    println(`{result}`);
}

__DATA__
{
    "stdout": "15\n"
}
