// A generic function that calls itself at a type built over its own type
// parameter needs an instance for every depth, so it is refused rather than
// instantiated forever.

fn walk<S: AsStrSlice>(n: i32, s: S) -> i32 {
    if n == 0 {
        return s.len();
    }
    return walk(n - 1, &s);
}

export fn run() {
    assert walk(3, "a") == 1;
}

