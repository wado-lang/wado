// A local item follows `let`'s scoping rules, not a nested block's: one
// declared inside an `if` is visible for the rest of the function, and from
// its declaration onwards it shadows a module-level item of the same name.
// See "Local Item Definitions" in docs/spec.md.

struct Point {
    x: i32,
}

fn f() -> i32 {
    let before = Point { x: 1 };
    if before.x == 1 {
        struct Point {
            x: i32,
            y: i32,
        }
        let inner = Point { x: 2, y: 3 };
        return before.x + inner.y;
    }
    let after = Point { x: 4, y: 5 };
    return after.x + after.y;
}

test "a block-local struct shadows the module-level one for the rest of the function" {
    assert f() == 4;
}
