// An async import past four flat params takes them in a memory buffer, which
// stores an unrestricted handle as its `u64` bits.

#[cm("example:demo/node", linearity = "unrestricted", classes = "0..=0")]
resource Node {}

#[cm("example:demo/global")]
interface Dom {
    #[cm("example:demo/global#touch")]
    async fn touch(n: Node, a: i32, b: i32, c: i32, d: i32) -> AsyncCall<i32>;

    #[cm("example:demo/global#root")]
    fn root() -> Node;
}

export fn run() with Dom {
    let n = Dom::root();
    let _ = Dom::touch(n, 1, 2, 3, 4).wait();
}

__DATA__
{
  "compile_only": true,
  "skip_os": true
}
