// An ambient body may perform any effect, but that is what the body holds, not
// what a function type it moves a closure into declares: `pure_caller` would
// perform `Stdout` without declaring it.

use { println } from "core:cli";

fn pure_caller(f: fn()) {
    f();
}

#[ambient]
fn setup() {
    pure_caller(|| { println("needs Stdout"); });
}

export fn run() {
    setup();
}

__DATA__
{"compile_error": "this function value performs effect 'Stdout', which the function type it is expected to be does not declare"}
