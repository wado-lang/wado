// HTTP Fields resource E2E test
// Tests all Fields resource operations in a single handler.
//
// This test exercises:
// - Fields::new() - constructor
// - fields.has(name) - check if header exists
// - fields.append(name, value) - add a header value
// - fields.delete(name) - remove a header
// - fields.clone() - deep copy fields

use { Request, Response, ErrorCode, Fields, FieldName, FieldValue, HeaderError, Trailers } from "wasi:http";

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    // 1. Create empty Fields
    let fields = Fields::new();

    // 2. has() should return false for non-existent header
    let has_before = fields.has("x-test" as FieldName);
    assert !has_before;

    // 3. append() a header value
    let bytes: Array<u8> = [104 as u8, 101 as u8, 108 as u8, 108 as u8, 111 as u8];
    let value = bytes as FieldValue;  // "hello" in UTF-8
    let append_result = fields.append("x-test" as FieldName, value);
    if let Err(e) = append_result {
        panic("append failed");
    }

    // 4. has() should return true after append
    let has_after = fields.has("x-test" as FieldName);
    assert has_after;

    // 5. clone() the fields
    let cloned = fields.clone();
    let cloned_has = cloned.has("x-test" as FieldName);
    assert cloned_has;

    // 6. delete() the header
    let delete_result = fields.delete("x-test" as FieldName);
    if let Err(e) = delete_result {
        panic("delete failed");
    }

    // 7. has() should return false after delete
    let has_deleted = fields.has("x-test" as FieldName);
    assert !has_deleted;

    // 8. Cloned copy should still have the header
    let cloned_still_has = cloned.has("x-test" as FieldName);
    assert cloned_still_has;

    // Return 200 OK
    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let response_headers = Fields::new();
    let [response, _tx_future] = Response::new(response_headers, null, trailers_future);
    task return Result::<Response, ErrorCode>::Ok(response);
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

__DATA__
{"wasi:http/service": {"status": 200}}
