// The early freeze runs before the structural passes, so it may plant only
// context-free values. A constant means the same thing wherever it lands; a
// value naming a local does not, because `inline` splices a callee body into a
// caller and `sroa` renumbers locals, re-contextualizing the slot underneath
// the value.
//
// The shape that broke: a callee whose parameters feed arithmetic, inlined into
// a caller loop that re-binds those slots each iteration. Frozen early, the one
// value spans every iteration's worth of reads.

use { println, Stdout } from "core:cli";

#[inline(always)]
fn span_end(start: i32, len: i32) -> i32 {
    return start + len;
}

#[inline(always)]
fn slice_of(s: String, start: i32, len: i32) -> String {
    return s.substr_bytes(start, span_end(start, len));
}

export fn run() with Stdout {
    let text = "abcdefghij";
    let mut out = "";
    let mut i = 0;
    while i < 4 {
        out = out + slice_of(text, i, 2);
        i = i + 1;
    }
    assert out == "abbccdde";
    println(out);
}

__DATA__
{
    "stdout": "abbccdde\n"
}
