use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // i32::popcnt
    println(`popcnt(0) = {i32::popcnt(0)}`);
    println(`popcnt(1) = {i32::popcnt(1)}`);
    println(`popcnt(0xFF) = {i32::popcnt(0xFF)}`);
    println(`popcnt(-1) = {i32::popcnt(-1)}`);

    // i32::ctz
    println(`ctz(1) = {i32::ctz(1)}`);
    println(`ctz(8) = {i32::ctz(8)}`);
    println(`ctz(0) = {i32::ctz(0)}`);

    // i32::clz
    println(`clz(1) = {i32::clz(1)}`);
    println(`clz(0) = {i32::clz(0)}`);
}

__DATA__
{"stdout": "popcnt(0) = 0\npopcnt(1) = 1\npopcnt(0xFF) = 8\npopcnt(-1) = 32\nctz(1) = 0\nctz(8) = 3\nctz(0) = 32\nclz(1) = 31\nclz(0) = 32\n"}
