use { make_wrapper } from "./sub/cross_module_same_name_helper.wado";

// Local Wrapper<T> with a completely different layout
struct Wrapper<T> {
    pub value: T,
    pub tag: i32,
}

test "cross-module same-name generic structs" {
    // Remote Wrapper<i32> — has field "inner"
    let remote = make_wrapper(42);
    assert remote.inner == 42;

    // Local Wrapper<i32> — has fields "value" and "tag"
    let local = Wrapper { value: 100, tag: 1 };
    assert local.value == 100;
    assert local.tag == 1;
}
