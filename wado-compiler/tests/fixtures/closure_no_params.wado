// Test zero-parameter closure (|| syntax)
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Expression body
    let get_value = || 42;
    println(`{get_value()}`);

    // Block body
    let greet = || {
        return "hello";
    };
    println(greet());

    // Capture outer variable
    let x = 10;
    let get_x = || x;
    println(`{get_x()}`);

    // Logical OR still works
    let a = false || true;
    println(`{a}`);

    // Logical OR with closure on right side: a || (|| expr)
    // This is: logical OR where right operand is a closure
    let b = false;
    let c = b || get_value() > 0;
    println(`{c}`);
}

__DATA__
{"stdout": "42\nhello\n10\ntrue\ntrue\n"}
