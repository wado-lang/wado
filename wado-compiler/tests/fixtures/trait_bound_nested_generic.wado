// Test: nested generics with trait bounds — Array<Array<T>> where T: Eq
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Array<i32> implements Eq (because i32: Eq),
    // so Array<Array<i32>> should also implement Eq
    let a: Array<Array<i32>> = [[1, 2], [3, 4]];
    let b: Array<Array<i32>> = [[1, 2], [3, 4]];
    if a == b {
        println("equal");
    } else {
        println("not equal");
    }
}

__DATA__
{"stdout": "equal\n"}
