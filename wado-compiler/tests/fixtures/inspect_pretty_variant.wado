use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

export fn run() with Stdout {
    let some_val = Option::Some(42);
    let none_val: Option<i32> = null;
    println(`{some_val:#?}`);
    println(`{none_val:#?}`);

    let nested = Option::Some(Point { x: 1, y: 2 });
    println(`{nested:#?}`);
}

__DATA__
{
    "stdout": "Option::Some(\n    42,\n)\nOption::None\nOption::Some(\n    Point {\n        x: 1,\n        y: 2,\n    },\n)\n"
}
