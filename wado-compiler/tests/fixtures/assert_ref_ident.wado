// `&<ident>` renders the place under it. The `&` itself takes no binding, since
// the scan cannot tell `&value` from `&fn_name` and a binding would lose the
// coercion — the operand renders without one.

fn deref(v: &i32) -> i32 {
    return *v;
}

export fn run() {
    let a = 7;
    assert deref(&a) == 99;
}

__DATA__
{
    "trapped": true,
    "stderr_contains": ["deref(&a): 7", "a: 7"]
}
