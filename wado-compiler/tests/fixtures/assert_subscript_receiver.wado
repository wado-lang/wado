// A subscript renders its index and the element, but not the sequence it
// read from: a subscript is a call, and its receiver is not captured.

export fn run() {
    let list: List<i32> = [10, 20];
    let i = 1;
    assert list[i] == 99;
}

__DATA__
{
    "trapped": true,
    "stderr_contains": ["condition: list[i] == 99\ni: 1\nlist[i]: 20\n"]
}
