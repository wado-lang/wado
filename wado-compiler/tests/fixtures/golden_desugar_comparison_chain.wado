// Golden test: Comparison chain desugaring
// a < b < c desugars to (a < b) && (b < c)
fn run() {
    // Basic ascending chain: 1 < 2 < 3
    let a = 1 < 2 < 3;
    assert a == true;

    // Failing chain: 1 < 3 < 2
    let b = 1 < 3 < 2;
    assert b == false;

    // Range check: 0 <= 5 <= 10
    let x = 5;
    let c = 0 <= x <= 10;
    assert c == true;

    // Longer chain: 1 < 2 < 3 < 4
    let d = 1 < 2 < 3 < 4;
    assert d == true;
}

