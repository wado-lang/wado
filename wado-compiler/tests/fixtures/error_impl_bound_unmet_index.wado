// A subscript whose only impl has a bound the key does not meet reports that
// bound, not an absent `IndexValue`, and an assignment through it reports
// nothing more.

use { HashMap } from "core:collections";

trait Tag with () {
    fn tag(&self) -> i32;
}

impl Tag for i32 {
    fn tag(&self) -> i32 {
        return 1;
    }
}

struct Wrap<T> {
    v: T,
}

impl<T: Tag> IndexValue<i32> for Wrap<T> {
    type Output = i32;

    fn index_value(&self, i: i32) -> i32 {
        return i;
    }
}

struct Point {
    x: i32,
}

test {
    let w = Wrap { v: "s" };
    let a = w[0];
    let mut m = HashMap::<Point, i32>::new();
    m[Point { x: 1 }] = 3;
    let b = m[Point { x: 1 }];
}

__DATA__
{
    "compile_error": ":35:13: analysis error: type 'String' does not implement trait 'Tag' required by bound on 'T'; 36:17: type 'Point' does not implement trait 'Hash' required by bound on 'K'; 37:5: type 'Point' does not implement trait 'Hash' required by bound on 'K'; 38:13: type 'Point' does not implement trait 'Hash' required by bound on 'K'",
    "compile_errors_not_contains": ["IndexValue", "not a place"]
}
