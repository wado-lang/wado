// A subscript whose only impl has a bound the key does not meet reports that
// bound, not an absent `IndexValue`, and an assignment through it reports
// nothing more. An assignment's own `IndexAssign` impl reports its bound too.

use { HashMap } from "core:collections";

trait Tag with () {
    fn tag(&self) -> i32;
}

impl Tag for i32 {
    fn tag(&self) -> i32 {
        return 1;
    }
}

struct Wrap<T> {
    v: T,
}

impl<T: Tag> IndexValue<i32> for Wrap<T> {
    type Output = i32;

    fn index_value(&self, i: i32) -> i32 {
        return i;
    }
}

struct Point {
    x: fn() -> i32,
}

struct Sink<T> {
    v: T,
}

impl<T: Tag> IndexAssign<i32> for Sink<T> {
    type Output = i32;

    fn index_assign(&mut self, i: i32, value: i32) {}
}

test {
    let w = Wrap { v: "s" };
    let a = w[0];
    let mut m = HashMap::<Point, i32>::new();
    m[Point { x: || 1 }] = 3;
    let b = m[Point { x: || 1 }];
    let mut s = Sink { v: "s" };
    s[0] = 1;
}

