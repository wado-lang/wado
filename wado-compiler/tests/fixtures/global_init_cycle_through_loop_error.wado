// A read is taken on every path when the code before it can only fall through
// to it: a loop that exits by its own `break`, and a call into a helper that
// reads unconditionally, both reach it. So `A` and `B` still wait on each
// other.

use { println, Stdout } from "core:cli";

global A: i32 = make_a(3);
global B: i32 = make_b();

#[inline(never)]
fn make_a(n: i32) -> i32 {
    let mut i = 0;
    while i < n {
        i += 1;
    }
    return i + read_b();
}

#[inline(never)]
fn read_b() -> i32 {
    return B;
}

#[inline(never)]
fn make_b() -> i32 {
    return A + 1;
}

export fn run() with Stdout {
    println(`${A}`);
}

__DATA__
{
    "compile_error": "global initializers form a cycle: A, B"
}
