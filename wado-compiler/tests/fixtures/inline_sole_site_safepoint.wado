// A callee reaching a safepoint still moves into its only caller when neither
// the site nor the callee holds a loop: the call it replaces is a safepoint as
// well, so the caller spills nothing more. `classify` calls `tally` and is
// over the plain threshold; inside a loop it would stay a call
// (`inline_loop_site_allocates.wado`).

#[inline(never)]
fn tally(code: i32) -> i32 {
    return code % 7;
}

fn classify(b: i32) -> i32 {
    let width = if b < 0x80 { 1 } else if b < 0xE0 { 2 } else if b < 0xF0 { 3 } else { 4 };
    let code = if width == 1 { b } else if width == 2 { b & 0x1F } else if width == 3 { b & 0x0F } else { b & 0x07 };
    return code * 8 + width + tally(code);
}

#[inline(never)]
fn first(b: i32) -> i32 {
    return classify(b) + 1;
}

export fn run() {
    assert first(builtin::black_box(0xC3)) == 30;
}

__DATA__
{
    "stdout": "",
    "wir_scope": "inline_sole_site_safepoint.wado/first",
    "wir_not_expect:O2": ["\"inline_sole_site_safepoint.wado/classify\"("]
}
