fn p<..P: NoSuchPack>(x: [..P]) -> i32 { return 1; }
fn n<T: NotATrait>(x: T) -> i32 { return 1; }
fn ok<T: Eq + Ord, F: fn(i32) -> i32, effect E>(x: T, f: F) -> i32 { return 1; }

