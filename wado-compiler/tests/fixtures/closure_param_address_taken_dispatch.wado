// A `fn` parameter whose address is taken still calls through its closure:
// the call must not read the cell the address lives in.

use { println, Stdout } from "core:cli";

fn call_mut<F: fn() with Stdout>(mut f: F) with Stdout {
    if builtin::black_box(false) { builtin::black_box(&mut f); }
    f();
}

fn call_ref<F: fn() with Stdout>(f: F) with Stdout {
    if builtin::black_box(false) { builtin::black_box(&f); }
    f();
}

export fn run() with Stdout {
    call_mut(|| { println("mut"); });
    call_ref(|| { println("ref"); });
}

__DATA__
{"stdout": "mut\nref\n"}
