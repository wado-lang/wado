// A `mut` `fn` parameter whose address is taken, directly or through a closure,
// still calls through its closure: the call must not read the cell the address
// lives in. An immutable one reads the parameter itself, and so does a closure
// capturing it once its address is taken.

use { println, Stdout } from "core:cli";

fn call_mut<F: fn() with Stdout>(mut f: F) with Stdout {
    if builtin::black_box(false) { builtin::black_box(&mut f); }
    f();
}

fn call_captured<F: fn() with Stdout>(mut f: F) with Stdout {
    let mut g = || { builtin::black_box(&mut f); return; };
    if builtin::black_box(false) { g(); }
    f();
}

fn call_ref<F: fn() with Stdout>(f: F) with Stdout {
    if builtin::black_box(false) { builtin::black_box(&f); }
    f();
}

fn call_ref_captured(f: fn(i32) -> bool) -> bool {
    if builtin::black_box(false) { builtin::black_box(&f); }
    let g = |n: i32| f(n);
    return g(1);
}

export fn run() with Stdout {
    call_mut(|| { println("mut"); });
    call_captured(|| { println("captured"); });
    call_ref(|| { println("ref"); });
    let yes = call_ref_captured(|n| n == 1);
    let no = call_ref_captured(|n| n == 2);
    println(`${yes} ${no}`);
}

__DATA__
{"stdout": "mut\ncaptured\nref\ntrue false\n"}
