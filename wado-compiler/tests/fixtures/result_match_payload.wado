// Test: match expression extracting payloads from both Ok and Err
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let ok_val: Result<String, String> = Result::<String, String>::Ok("success");
    let err_val: Result<String, String> = Result::<String, String>::Err("failure");

    let x = match ok_val {
        Ok(s) => `ok: {s}`,
        Err(s) => `err: {s}`,
    };
    println(x);

    let y = match err_val {
        Ok(s) => `ok: {s}`,
        Err(s) => `err: {s}`,
    };
    println(y);
}

__DATA__
{"stdout": "ok: success\nerr: failure\n"}
