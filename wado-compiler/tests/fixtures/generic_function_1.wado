use { println, Stdout } from "core:cli";

// from generic_function_multi_instantiations.wado
fn identity<T>(x: T) -> T {
    return x;
}

// from generic_function_multi_params.wado
fn first<T, U>(x: T, y: U) -> T {
    return x;
}

fn second<T, U>(x: T, y: U) -> U {
    return y;
}

// from generic_function_multi_instantiations.wado
fn generic_function_multi_instantiations() with Stdout {
    let a = identity::<i32>(1);
    let b = identity::<i64>(2 as i64);
    let c = identity::<f32>(3.5 as f32);
    let d = identity::<f64>(4.5);
    let e = identity::<bool>(true);
    println(`{a} {b} {c} {d} {e}`);
}

// from generic_function_multi_params.wado
fn generic_function_multi_params() with Stdout {
    let a = first::<i32, i64>(10, 20 as i64);
    let b = second::<i32, i64>(30, 40 as i64);
    println(`a: {a}`);
    println(`b: {b}`);
}

export fn run() with Stdout {
    generic_function_multi_instantiations();
    generic_function_multi_params();
}

__DATA__
{"stdout": "1 2 3.5 4.5 true\na: 10\nb: 40\n"}
