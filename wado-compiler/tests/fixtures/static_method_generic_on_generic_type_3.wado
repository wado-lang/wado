// Test: both impl type param and method type param come from outer generic context
use { println, Stdout } from "core:cli";

struct Converter<T> {
    _phantom: T,
}

impl<T> Converter<T> {
    pub fn convert<U>(value: U) -> U {
        return value;
    }
}

// Both T and U are forwarded from the outer generic function
fn do_convert<A, B>(value: B) -> B {
    return Converter::<A>::convert::<B>(value);
}

export fn run() with Stdout {
    let result = do_convert::<i32, String>("test");
    println(`{result}`);

    let result2 = do_convert::<String, i32>(99);
    println(`{result2}`);
}

__DATA__
{"stdout": "test\n99\n"}
