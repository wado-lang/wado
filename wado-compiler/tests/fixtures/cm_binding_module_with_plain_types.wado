// A module that binds a CM import may declare its own types beside it: only
// the `#[cm]` items are bindings, and the rest carry no CM name to read.
#[cm("wasi:demo/events@0.1.0#node", linearity = "unrestricted")]
resource Node {}

struct Pair {
    left: i32,
    right: i32,
}

enum Side {
    Left,
    Right,
}

variant Choice {
    One(i32),
    Other,
}

flags Marks {
    Seen,
}

export fn run() {
    let pair = Pair { left: 1, right: 2 };
    let side = Side::Left;
    let choice = Choice::One(pair.left);
    let marks = Marks::Seen;
    assert pair.right == 2 && side == Side::Left && choice matches { One(1) } && marks == Marks::Seen;
}

__DATA__
{}
