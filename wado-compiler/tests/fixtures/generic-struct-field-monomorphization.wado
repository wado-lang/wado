// Test for generic struct field monomorphization:
// - Container<T> has a field of type Array<T>
// - When instantiating Container<i32>, the field becomes Array<i32>
// - Methods (add, len, get) are also properly monomorphized

use { println, Stdout } from "core:cli";

// Generic struct with a field that uses the type parameter
struct Container<T> {
    items: Array<T>,
}

impl<T> Container<T> {
    fn new() -> Container<T> {
        return Container { items: [] as Array<T> };
    }

    fn add(&mut self, item: T) {
        self.items.append(item);
    }

    fn len(&self) -> i32 {
        return self.items.len();
    }

    fn get(&self, index: i32) -> T {
        return self.items[index];
    }
}

export fn run() with Stdout {
    let mut container = Container::<i32>::new();
    container.add(10);
    container.add(20);
    container.add(30);

    println(`Length: {container.len()}`);
    println(`First: {container.get(0)}`);
    println(`Second: {container.get(1)}`);
    println(`Third: {container.get(2)}`);
}

__DATA__
{
    "stdout": "Length: 3\nFirst: 10\nSecond: 20\nThird: 30\n"
}
