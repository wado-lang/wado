//! Two traits declaring one instance method on one receiver. `s.go()` reports
//! the ambiguity; `S::go(&s)` names the same two declarations and must report
//! it too. The ambiguity was asked only of receiver-less declarations, so the
//! spelling that reaches a receiver-taking one silently took the first block.

trait Alpha {
    fn go(&self) -> i32;
}

trait Beta {
    fn go(&self) -> i32;
}

struct S {}

impl Alpha for S {
    fn go(&self) -> i32 {
        return 1;
    }
}

impl Beta for S {
    fn go(&self) -> i32 {
        return 2;
    }
}

export fn run() {
    let s = S {};
    assert S::go(&s) == 1;
}

__DATA__
{"compile_error": "ambiguous method 'go': declared by 'Alpha' and 'Beta'"}
