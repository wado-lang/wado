// A trait impl written for a generic newtype dispatches to its own body, as
// inheriting the base's impl does (`newtype_generic_inherited_trait`).

trait Label with () {
    fn label(&self) -> String;
}

type MyArray<T> = List<T>;

impl<T: Display> Label for MyArray<T> {
    fn label(&self) -> String {
        return `${self[0]}`;
    }
}

test "a generic newtype's own trait impl dispatches" {
    let a: MyArray<i32> = [7, 8];
    assert a.label() == "7";
}
