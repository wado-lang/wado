// A list's storage moves an affine element: a read empties the slot, a store
// drops what the slot held, a shift leaves no copy behind, and shrinking drops
// what it releases (WEP: Affine Types).
test "remove leaves no copy for the drop" {
    let [a, ta] = Stream::<u8>::new();
    let [b, tb] = Stream::<u8>::new();
    let mut ends: List<Stream<u8>> = [];
    ends.push(a);
    ends.push(b);
    let first = ends.remove(0);
    first.drop();
    assert ta.write([1]).result == CopyResult::Dropped;
    builtin::drop(ends);
    assert tb.write([1]).result == CopyResult::Dropped;
}

test "insert shifts without a copy" {
    let [a, ta] = Stream::<u8>::new();
    let [b, tb] = Stream::<u8>::new();
    let mut ends: List<Stream<u8>> = [];
    ends.push(a);
    ends.insert(0, b);
    assert ends.len() == 2;
    let last = ends.pop();
    builtin::drop(last);
    assert ta.write([1]).result == CopyResult::Dropped;
    builtin::drop(ends);
    assert tb.write([1]).result == CopyResult::Dropped;
}

test "truncate drops what it releases" {
    let [a, ta] = Stream::<u8>::new();
    let [b, tb] = Stream::<u8>::new();
    let mut ends: List<Stream<u8>> = [];
    ends.push(a);
    ends.push(b);
    ends.truncate(1);
    assert tb.write([1]).result == CopyResult::Dropped;
    ends.clear();
    assert ta.write([1]).result == CopyResult::Dropped;
}

test "a store drops what the slot held" {
    let [a, ta] = Stream::<u8>::new();
    let [b, tb] = Stream::<u8>::new();
    let mut ends: List<Stream<u8>> = [];
    ends.push(a);
    ends[0] = b;
    assert ta.write([1]).result == CopyResult::Dropped;
    builtin::drop(ends);
    assert tb.write([1]).result == CopyResult::Dropped;
}

test "swap keeps both" {
    let [a, ta] = Stream::<u8>::new();
    let [b, tb] = Stream::<u8>::new();
    let mut ends: List<Stream<u8>> = [];
    ends.push(a);
    ends.push(b);
    ends.swap(0, 1);
    let last = ends.pop();
    builtin::drop(last);
    assert ta.write([1]).result == CopyResult::Dropped;
    builtin::drop(ends);
    assert tb.write([1]).result == CopyResult::Dropped;
}

test "inspecting reads each element in place" {
    let [a, ta] = Stream::<u8>::new();
    let mut ends: List<Stream<u8>> = [];
    ends.push(a);
    let shown = `${ends:?}`;
    assert shown.starts_with("[Stream<u8>#0x");
    assert ends.len() == 1;
    let kept = ends.pop();
    assert kept matches { Some(_) };
    builtin::drop(kept);
    assert ta.write([1]).result == CopyResult::Dropped;
}
