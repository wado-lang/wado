// Test pub use with alias re-export

use { println, Stdout } from "core:cli";
use { mul } from "./pub_use_alias_facade.wado";

fn run() with Stdout {
    let result = mul(6, 7);
    if result == 42 {
        println("success");
    } else {
        println("failure");
    }
}

__DATA__
{"stdout": "success\n"}
