// An `interface` and a `trait` are declared in the type namespace: one name
// reaches one declaration wherever it is written. Neither denotes a type, and a
// type position naming one says so where it was written.
//
// A turbofish is its own route. Type arguments are resolved by the call rather
// than by the annotation walk, and an unreported one resolved to `unknown`,
// which satisfies every bound: the call passed its `T: Default` check and
// reached monomorphization, where no impl exists and the compiler panicked.
// `interface_in_annotation_error.wado` covers the annotation route, which has
// to be its own file because that check stops at the first error reported.

interface Counter {
    fn next() -> i32;
}

trait Greet {
    fn greet(&self) -> String;
}

fn mk<T: Default>() -> T {
    return T::default();
}

export fn run() {
    let a = mk::<Counter>();
    let b = mk::<Greet>();
    let c = mk::<List<Greet>>();
}

__DATA__
{
  "compile_errors_contains": [
    "`Counter` is an interface, not a type",
    "`Greet` is a trait, not a type"
  ],
  "compile_error": "`Counter` is an interface, not a type: it names a set of operations, and no value has it as its type"
}
