// Test: two library modules defining variants with the same name
// This should work correctly - each module's Status type is distinct.

use { println, Stdout } from "core:cli";
use { make_active, status_a_name } from "./sub/wasm_name_conflict_variant_mod_a.wado";
use { make_ok, status_b_value } from "./sub/wasm_name_conflict_variant_mod_b.wado";

export fn run() with Stdout {
    let a = make_active();
    println(`a: {status_a_name(a)}`);
    let b = make_ok(99);
    println(`b: {status_b_value(b)}`);
}

__DATA__
{"stdout": "a: 1\nb: 99\n"}
