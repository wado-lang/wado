// Test combined bitwise operations with precedence

fn run() {
    // Test bitwise operator precedence
    // & has higher precedence than |
    // 0b0011 | 0b0100 & 0b0110 = 0b0011 | 0b0100 = 0b0111 = 7
    // Actually: & binds tighter, so 0b0100 & 0b0110 = 0b0100 = 4
    // Then 0b0011 | 0b0100 = 0b0111 = 7
    let a = 3;     // 0b0011
    let b = 4;     // 0b0100
    let c = 6;     // 0b0110
    let result = a | b & c;  // Should be 7

    assert result == 7;
}

