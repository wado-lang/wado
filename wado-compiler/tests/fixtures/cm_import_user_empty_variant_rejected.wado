// A `#[cm]` import is held to what an export is: a Component Model `variant`
// lists at least one case, however deep it sits in the signature.
#[cm("wasi:demo/gfx@0.1.0#nothing")]
variant Nothing {}

interface Gfx {
    #[cm("wasi:demo/gfx@0.1.0#configure")]
    fn configure(x: u32) -> Option<Nothing>;
}

export fn run() with Gfx {
    let _ = Gfx::configure(3);
}

