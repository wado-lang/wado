use { println, Stdout } from "core:cli";

// from inspect_nested.wado
struct Point {
    x: i32,
    y: i32,
}

struct Line {
    start: Point,
    end: Point,
}

// from inspect_nested_array_struct2_test.wado
struct Matrix {
    data: Array<Array<i32>>,
    rows: i32,
}

// from inspect_nested.wado
fn inspect_nested() with Stdout {
    // Nested struct
    let line = Line {
        start: Point { x: 0, y: 0 },
        end: Point { x: 10, y: 20 },
    };
    println(`{line:?}`);

    // Struct in array
    let points: Array<Point> = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }];
    println(`{points:?}`);

    // Option of struct
    let opt_p: Option<Point> = Option::<Point>::Some(Point { x: 10, y: 20 });
    println(`{opt_p:?}`);

    let none_p: Option<Point> = null;
    println(`{none_p:?}`);

    println("ok");
}

// from inspect_nested_array3_test.wado
fn inspect_nested_array3_test() with Stdout {
    let deep: Array<Array<Array<i32>>> = [[[1, 2], [3]], [[4, 5, 6]]];
    println(`{deep:?}`);
}

// from inspect_nested_array_option_test.wado
fn inspect_nested_array_option_test() with Stdout {
    let a: Option<i32> = Option::<i32>::Some(1);
    let b: Option<i32> = null;
    let c: Option<i32> = Option::<i32>::Some(3);
    let arr: Array<Option<i32>> = [a, b, c];
    println(`{arr:?}`);
}

// from inspect_nested_array_string_test.wado
fn inspect_nested_array_string_test() with Stdout {
    let arr: Array<Array<String>> = [["a", "b"], ["c"]];
    println(`{arr:?}`);
}

// from inspect_nested_array_struct2_test.wado
fn inspect_nested_array_struct2_test() with Stdout {
    let row1: Array<i32> = [1, 2];
    let row2: Array<i32> = [3, 4];
    let data: Array<Array<i32>> = [row1, row2];
    let m = Matrix { data: data, rows: 2 };
    println(`{m:?}`);
}

export fn run() with Stdout {
    inspect_nested();
    inspect_nested_array3_test();
    inspect_nested_array_option_test();
    inspect_nested_array_string_test();
    inspect_nested_array_struct2_test();
}

__DATA__
{"stdout": "Line { start: Point { x: 0, y: 0 }, end: Point { x: 10, y: 20 } }\n[Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]\nOption::Some(Point { x: 10, y: 20 })\nOption::None\nok\n[[[1, 2], [3]], [[4, 5, 6]]]\n[Option::Some(1), Option::None, Option::Some(3)]\n[[\"a\", \"b\"], [\"c\"]]\nMatrix { data: [[1, 2], [3, 4]], rows: 2 }\n"}
