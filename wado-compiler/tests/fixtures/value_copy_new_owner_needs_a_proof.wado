// Minting a second owner out of a binding needs a proof that the binding holds
// the only reference to what it read. A repoint of the place is not one: it says
// nothing about when it runs, or about a sibling binding read out of the same
// place. Neither is a chain of owned-looking sources, where the holder the chain
// ends at is still live.

struct H {
    held: Option<List<i32>>,
}

variant Held {
    Full(List<i32>),
    Empty,
}

struct HV {
    held: Held,
}

impl HV {
    fn count(&self) -> i32 {
        if let Full(v) = self.held {
            return v.len();
        }
        return 0;
    }
}

fn make() -> HV {
    return HV { held: Held::Full([1, 2]) };
}

// ---- Finding 1a: one repoint licenses every binding read out of the place.
// The holder arrives through `&mut`, so nothing under it is "fresh" and the
// move rule cannot be what elides the copy (control: `control_no_release`).
fn two_readers(h: &mut H) -> List<i32> {
    if let Some(a) = h.held {
        if let Some(b) = h.held {
            h.held = null;
            let mut x = a;
            x.push(9);
            return b;
        }
    }
    return [];
}

test "1a one release licenses two readers" {
    let mut h = H { held: Option::Some([1, 2]) };
    let b = two_readers(&mut h);
    assert b.len() == 2;
}

// ---- Finding 1b: a repoint that does not execute licenses all the same.
fn maybe_release(h: &mut H, c: bool) -> i32 {
    if let Some(a) = h.held {
        if c {
            h.held = null;
        }
        let mut x = a;
        x.push(9);
        return x.len();
    }
    return 0;
}

test "1b a release that never runs licenses a new owner" {
    let mut h = H { held: Option::Some([1, 2]) };
    assert maybe_release(&mut h, builtin::black_box(false)) == 3;
    if let Some(z) = h.held {
        assert z.len() == 2;
    }
}

// ---- Control: same shape, no repoint at all -> the copy is emitted.
fn control_no_release(h: &mut H) -> i32 {
    if let Some(a) = h.held {
        let mut x = a;
        x.push(9);
        return x.len();
    }
    return 0;
}

test "control non-fresh holder, no release" {
    let mut h = H { held: Option::Some([1, 2]) };
    assert control_no_release(&mut h) == 3;
    if let Some(z) = h.held {
        assert z.len() == 2;
    }
}

// ---- Finding 2: no repoint anywhere. A pattern binding out of a field of a
// freshly built holder is moved while the holder is still live.
test "2 arm binding out of a fresh holder is moved" {
    let mut h = make();
    if let Full(a) = h.held {
        let mut x = a;
        x.push(9);
        assert x.len() == 3;
    }
    assert h.count() == 2;
}

__DATA__
{"test": {}}
