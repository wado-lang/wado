// A callee that hands a projection of its by-value parameter back is not
// read-only, so a constant argument must not be hoisted into a shared global.
//
// `is_readonly_body` rejects a bare whole-value read of the binding but used to
// admit `return s.data`. Under value semantics a by-value parameter is the
// callee's own copy, so the return-convention fixpoint calls that owned and the
// caller keeps no defensive copy — with the argument hoisted, the "owned" value
// it receives is the shared global's storage, and the first `push` mutates the
// constant for every later call.
//
// `take` is called three times with the same literal; each caller pushes onto
// the result. Identical lengths are the check — before the fix this printed
// `4 5 6`.

use { println, Stdout } from "core:cli";

struct S {
    data: List<u8>,
    tag: List<u8>,
}

#[inline(never)]
fn take(s: S) -> List<u8> {
    if s.tag.len() > 100 {
        return s.tag;
    }
    return s.data;
}

export fn run() with Stdout {
    for let _i of 0..<3 {
        let mut x = take(S { data: [1, 2, 3] as List<u8>, tag: [7, 8] as List<u8> });
        x.push(9);
        println(`${x.len()}`);
    }
}

__DATA__
{
    "stdout": "4\n4\n4\n"
}
