// Nested index expressions in assignment
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let indices: Array<i32> = [2, 0, 1];
    let mut values: Array<i32> = [0, 0, 0];

    // Use index from another array
    values[indices[0]] = 100;  // values[2] = 100
    values[indices[1]] = 200;  // values[0] = 200
    values[indices[2]] = 300;  // values[1] = 300

    println(`{values[0]} {values[1]} {values[2]}`);

    // Value from another array
    let source: Array<i32> = [10, 20, 30];
    let mut dest: Array<i32> = [0, 0, 0];
    dest[0] = source[2];
    dest[1] = source[0];
    dest[2] = source[1];

    println(`{dest[0]} {dest[1]} {dest[2]}`);
}

__DATA__
{"stdout": "200 300 100\n30 10 20\n"}
