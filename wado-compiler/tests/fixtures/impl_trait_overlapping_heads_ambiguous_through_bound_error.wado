// Two impls that tie at the generality rank are as ambiguous when a bound
// reaches them as when a method call does: neither may win by declaration order.

struct Pair<A, B> {
    a: A,
    b: B,
}

trait Name with () {
    fn name(&self) -> String;
}

impl<T> Name for Pair<T, i32> {
    fn name(&self) -> String {
        return "pinned";
    }
}

impl<A, B> Name for Pair<A, B> {
    fn name(&self) -> String {
        return "open";
    }
}

fn via<T: Name>(x: T) -> String {
    return x.name();
}

export fn run() {
    let p: Pair<String, i32> = Pair { a: "x", b: 2 };
    let _ = via(p);
}

