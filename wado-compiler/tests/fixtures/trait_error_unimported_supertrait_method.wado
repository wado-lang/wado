#![TODO]
// The prelude is the only exemption: every other top-level symbol a module
// names must be imported, and a supertrait is a second name. `T: Sub` reaches
// `Sub`'s own methods, but calling `Base`'s through it needs `Base` imported
// too, exactly as writing `T: Base` would.
//
// Today the bound carries the supertrait's methods with it, so this resolves
// with `Base` unnamed (WEP 2026-09-01, "Scope is decided and not implemented").

use { Sub, Speaker } from "./sub/trait_scope_lib.wado";

fn describe<T: Sub>(v: &T) -> String {
    return v.base_name();
}

export fn run() {
    assert describe(&Speaker { id: 1 }) == "base";
}

