// A qualified static names its trait, so a newtype's own impl of another trait
// with a same-named method does not take the call: `Wanted::<N>::mk()` is the
// base's `Wanted`, which `N` inherits.

struct Base {
    v: i32,
}

trait Wanted {
    fn mk() -> i32;
}

trait Other {
    fn mk() -> i32;
}

impl Wanted for Base {
    fn mk() -> i32 {
        return 1;
    }
}

type N = Base;

impl Other for N {
    fn mk() -> i32 {
        return 2;
    }
}

type Outer = N;

test {
    assert Wanted::<N>::mk() == 1;
    assert Other::<N>::mk() == 2;
    assert Wanted::<Outer>::mk() == 1;
}

__DATA__
{"test": {}}
