// Test: return-only temp elision unblocks variant SROA
//
// NIR's `field_scalarize` (HFS) introduces `__hfs_call_N` locals that
// capture a match arm's value before convergence sync, even when the
// captured value flows straight into the surrounding function's `Return`:
//
//     __hfs_call_N = struct.new Result::Err { ... };
//     self.pos = __hfs_pos_X;                       // HFS write-back
//     return __hfs_call_N;
//
// The intermediate `LocalGet(__hfs_call_N)` hides the `StructNew` leaf
// from variant-return SROA candidate analysis, so without elision the
// function stays boxed.
//
// This fixture exercises the same shape via a `match`-with-write-back
// pattern. After Phase 0 in `sroa_variant_return`, the temp is gone and
// the function becomes a multi-value-return candidate.

struct Counter { n: i32 }

#[inline("never")]
fn step(c: &mut Counter, n: i32) -> Result<i32, String> {
    let was = c.n;
    match n {
        0 => {
            c.n = was + 1;
            return Result::<i32, String>::Err("zero");
        },
        1 => {
            c.n = was + 1;
            return Result::<i32, String>::Ok(was);
        },
        _ => {
            c.n = was - 1;
            return Result::<i32, String>::Err("other");
        },
    }
}

#[inline("never")]
fn drive(c: &mut Counter) -> i32 {
    let result = step(c, 1);
    if let Ok(v) = result {
        return v;
    }
    return -1;
}

export fn run() {
    let mut c = Counter { n: 0 };
    assert drive(&mut c) == 0;
    assert drive(&mut c) == 1;
    assert c.n == 2;
}

__DATA__
{
    "stdout": "",
    "wir_expect:O2": [
        "/step\" = fn(ref \"",
        "//Counter\", i32) -> [i32, i32, ref null \"core:prelude/string.wado//String\"]",
        "multivalue_bind [__sroa_result_discriminant, __sroa_result_case0_payload_0, __sroa_result_case1_payload_0]",
        "if __sroa_result_discriminant == 0"
    ],
    "wir_not_expect:O2": [
        "ref.test \"core:prelude/types.wado//Result<i32,core:prelude/string.wado/String>"
    ]
}
