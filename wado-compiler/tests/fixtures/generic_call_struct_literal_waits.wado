// A named struct literal without a turbofish takes its type arguments from the
// parameter type once the call's other arguments settle it, nested ones too.
use { println, Stdout } from "core:cli";

struct Pair<T> {
    a: T,
    b: T,
}

struct Outer<T> {
    p: Pair<T>,
}

fn second<T>(p: Pair<T>, fallback: T) -> T {
    return if p.a == p.b { fallback } else { p.b };
}

fn inner<T>(o: Outer<T>, fallback: T) -> T {
    return second(o.p, fallback);
}

struct Picker {}

impl Picker {
    fn second<T>(&self, p: Pair<T>, fallback: T) -> T {
        return second(p, fallback);
    }

    fn first<T>(p: Pair<T>, fallback: T) -> T {
        return if p.a == p.b { fallback } else { p.a };
    }
}

export fn run() with Stdout {
    let fallback: u64 = 0;
    let picker = Picker {};
    println(`${second(Pair { a: 1, b: 0x1_0000_0000 }, fallback)}`);
    println(`${inner(Outer { p: Pair { a: 1, b: 0x1_0000_0001 } }, fallback)}`);
    println(`${picker.second(Pair { a: 1, b: 0x1_0000_0002 }, fallback)}`);
    println(`${Picker::first(Pair { a: 0x1_0000_0003, b: 1 }, fallback)}`);
    println(`${second(Pair { a: 1, b: 2 }, 5)}`);
}

__DATA__
{
    "stdout": "4294967296\n4294967297\n4294967298\n4294967299\n2\n"
}
