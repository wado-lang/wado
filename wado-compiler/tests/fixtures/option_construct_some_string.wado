// Test Option::Some construction with String type

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let opt: Option<String> = Option::<String>::Some("hello");
    // Note: We can't print the option value yet since we don't have pattern matching
    // This test just verifies that Option::Some compiles correctly
    println("done");
}

