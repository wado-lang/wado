use { println, Stdout } from "core:cli";

fn fmt_with(value: &i32, sign_plus: bool, zero_pad: bool, width: i32, align: Alignment) -> String {
    let mut buf = String::with_capacity(64);
    let fill = if zero_pad {
        '0';
    } else {
        ' ';
    };
    let mut f = Formatter {
        fill,
        align,
        sign_plus,
        zero_pad,
        width,
        precision: -1,
        indent: 0,
        buf: &mut buf,
    };
    value.fmt(&mut f);
    return buf;
}

fn fmt_int(value: &i32, fill: char, align: Alignment, sign_plus: bool, zero_pad: bool, width: i32) -> String {
    let mut buf = String::with_capacity(64);
    let mut f = Formatter {
        fill,
        align,
        sign_plus,
        zero_pad,
        width,
        precision: -1,
        indent: 0,
        buf: &mut buf,
    };
    value.fmt(&mut f);
    return buf;
}

fn test_format_base() with Stdout {
    let x: i32 = 42;
    let neg: i32 = -42;
    assert fmt_with(&x, true, false, -1, Alignment::Right) == "+42";
    assert fmt_with(&neg, true, false, -1, Alignment::Right) == "-42";
    assert fmt_with(&x, true, true, 8, Alignment::Right) == "+0000042";
    assert fmt_with(&neg, false, true, 8, Alignment::Right) == "-0000042";
    assert fmt_with(&x, true, false, 10, Alignment::Right) == "       +42";
    assert fmt_with(&neg, false, false, 10, Alignment::Left) == "-42       ";
    println("ok");
}

fn test_format_padding() with Stdout {
    let x: i32 = 42;
    let neg: i32 = -42;
    let big: i32 = 12345;
    assert fmt_int(&x, ' ', Alignment::Right, false, false, 10) == "        42";
    assert fmt_int(&x, ' ', Alignment::Left, false, false, 10) == "42        ";
    assert fmt_int(&x, ' ', Alignment::Center, false, false, 10) == "    42    ";
    assert fmt_int(&x, '0', Alignment::Right, false, true, 8) == "00000042";
    assert fmt_int(&neg, '0', Alignment::Right, false, true, 8) == "-0000042";
    assert fmt_int(&x, ' ', Alignment::Right, true, false, -1) == "+42";
    assert fmt_int(&x, '*', Alignment::Center, false, false, 10) == "****42****";
    let mut buf = String::with_capacity(64);
    let mut f = Formatter {
        fill: ' ',
        align: Alignment::Left,
        sign_plus: false,
        zero_pad: false,
        width: 8,
        precision: -1,
        indent: 0,
        buf: &mut buf,
    };
    true.fmt(&mut f);
    assert buf == "true    ";
    assert fmt_int(&big, ' ', Alignment::Right, false, false, 2) == "12345";
    println("ok");
}

export fn run() with Stdout {
    test_format_base();
    test_format_padding();
}

__DATA__
{"stdout": "ok\nok\n"}
