// Test for wasi:cli Terminal effects
// Terminal functions return None in non-terminal environments (e.g., test harnesses)

use { println, Stdout } from "core:cli";
use { TerminalStdin, TerminalStdout, TerminalStderr } from "wasi:cli";

export fn run() with Stdout, TerminalStdin, TerminalStdout, TerminalStderr {
    // In non-terminal context, all terminal functions return None
    let stdin_terminal = TerminalStdin::get_terminal_stdin();
    assert stdin_terminal matches { None }, "stdin terminal should be None";

    let stdout_terminal = TerminalStdout::get_terminal_stdout();
    assert stdout_terminal matches { None }, "stdout terminal should be None";

    let stderr_terminal = TerminalStderr::get_terminal_stderr();
    assert stderr_terminal matches { None }, "stderr terminal should be None";

    println("all terminal tests passed");
}

__DATA__
{"stdout": "all terminal tests passed\n"}
