// A newtype's own `FromLeBytes` decides what `from_le_bytes` reads, for a
// literal argument as for a run-time one. One without its own reads the bits.

type Celsius = f32;
type Kelvin = f32;

impl FromLeBytes for Celsius {
    fn bits() -> i32 {
        return 32;
    }

    fn from_le_at(bytes: ByteSlice, at: i32) -> Celsius {
        return 100.0;
    }
}

export fn run() {
    let lit = List::<Celsius>::from_le_bytes(b"\x00\x00\x80\x3f");
    let dynamic = List::<Celsius>::from_le_bytes(builtin::black_box(b"\x00\x00\x80\x3f"));
    assert lit[0] as f32 == 100.0;
    assert dynamic[0] as f32 == 100.0;

    let k = List::<Kelvin>::from_le_bytes(b"\x00\x00\x80\x3f");
    assert k[0] as f32 == 1.0;
}

__DATA__
{}
