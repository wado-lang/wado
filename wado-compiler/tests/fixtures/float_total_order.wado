// A float has one order, which the operators, `cmp`, `sort` and a `T: Ord`
// bound all read:
//
//     -Inf < -finite < -0 == +0 < +finite < +Inf < NaN
//
// Every NaN is one value, whatever its sign and payload.

export fn run() {
    let neg_nan = f32::from_bits(0xFFC0_0000);
    let pos_nan = f32::from_bits(0x7FC0_0000);
    let payload_nan = f32::from_bits(0x7F80_0001);
    let neg_zero = f32::from_bits(0x8000_0000);
    let pos_zero = 0.0 as f32;
    let neg_inf = -f32::INFINITY;
    let pos_inf = f32::INFINITY;

    // The ladder, each step against the next.
    assert neg_inf.cmp(&(-1.0 as f32)) matches { Less };
    assert (-1.0 as f32).cmp(&neg_zero) matches { Less };
    assert neg_zero.cmp(&pos_zero) matches { Equal };
    assert pos_zero.cmp(&(1.0 as f32)) matches { Less };
    assert (1.0 as f32).cmp(&pos_inf) matches { Less };
    assert pos_inf.cmp(&neg_nan) matches { Less };

    // Every NaN is one value.
    assert neg_nan.cmp(&pos_nan) matches { Equal };
    assert payload_nan.cmp(&neg_nan) matches { Equal };
    assert neg_nan.cmp(&neg_inf) matches { Greater };

    // The operators answer as `cmp` does, NaN included.
    assert neg_nan == pos_nan;
    assert !(neg_nan != payload_nan);
    assert pos_inf < neg_nan;
    assert pos_inf <= neg_nan;
    assert neg_nan > pos_inf;
    assert neg_nan >= pos_inf;
    assert !(neg_nan < pos_inf);
    assert !(pos_inf > neg_nan);
    assert neg_nan <= pos_nan;
    assert !(neg_nan < pos_nan);
    assert neg_zero == pos_zero;
    assert !(neg_zero < pos_zero);
    assert neg_zero >= pos_zero;

    // Against a constant, a NaN is greatest too.
    assert pos_nan > 1.0;
    assert !(pos_nan < 1.0);
    assert 1.0 < pos_nan;
    assert !(1.0 >= pos_nan);
    assert pos_nan != 1.0;

    // `x == x` holds for every `x`, so a NaN is tested with `is_nan()`.
    assert pos_nan == pos_nan;
    assert pos_nan.is_nan();
    assert !pos_inf.is_nan();

    // A sort puts every NaN last, and keeps the NaNs and the zeroes in input
    // order, since each pair is `Equal`.
    let mut xs: List<f32> = [pos_inf, neg_zero, pos_nan, 1.0, neg_nan, pos_zero, neg_inf];
    xs.sort();
    assert xs[0].to_bits() == 0xFF80_0000;
    assert xs[1].to_bits() == 0x8000_0000;
    assert xs[2].to_bits() == 0x0000_0000;
    assert xs[3].to_bits() == 0x3F80_0000;
    assert xs[4].to_bits() == 0x7F80_0000;
    assert xs[5].to_bits() == 0x7FC0_0000;
    assert xs[6].to_bits() == 0xFFC0_0000;

    // A body generic over `T: Ord` answers what the concrete type does.
    assert bound_less(pos_inf, neg_nan);
    assert !bound_less(neg_nan, pos_inf);
    assert !bound_less(neg_zero, pos_zero);
    assert bound_equal(neg_nan, pos_nan);
    assert bound_equal(neg_zero, pos_zero);

    // One equality, so `contains` finds a NaN.
    let ys: List<f32> = [1.0, pos_nan];
    assert ys.contains(&neg_nan);

    // f64 orders by the same rule.
    let d_neg_nan = f64::from_bits(0xFFF8_0000_0000_0000);
    let d_pos_nan = f64::from_bits(0x7FF8_0000_0000_0000);
    let d_neg_zero = f64::from_bits(0x8000_0000_0000_0000);
    assert f64::INFINITY.cmp(&d_neg_nan) matches { Less };
    assert d_neg_nan.cmp(&d_pos_nan) matches { Equal };
    assert d_neg_zero.cmp(&(0.0 as f64)) matches { Equal };
    assert d_neg_nan == d_pos_nan;
    assert f64::INFINITY < d_neg_nan;
    assert d_neg_nan > f64::INFINITY;
    assert !(d_neg_nan < f64::INFINITY);
    assert d_neg_zero == 0.0;
    assert bound_less(f64::INFINITY, d_neg_nan);
}

fn bound_less<T: Ord>(a: T, b: T) -> bool {
    return a < b;
}

fn bound_equal<T: Eq>(a: T, b: T) -> bool {
    return a == b;
}

__DATA__
{}
