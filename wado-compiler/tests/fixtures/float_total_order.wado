// `Ord` on a float is IEEE 754-2019 `totalOrder`, which is what C++20's
// `std::strong_order` computes:
//
//     -NaN < -Inf < -finite < -0 < +0 < +finite < +Inf < +NaN
//
// `<` and `==` keep IEEE's answers, where a NaN compares false against
// everything and the two zeroes are one value. C++20 splits them the same way:
// `operator<=>` on a float yields `partial_ordering`, `strong_order` does not.

fn f32_bits(bits: u32) -> f32 {
    return f32::from_bits(bits);
}

export fn run() {
    let neg_nan = f32_bits(0xFFC0_0000);
    let pos_nan = f32_bits(0x7FC0_0000);
    let neg_zero = f32_bits(0x8000_0000);
    let pos_zero = 0.0 as f32;
    let neg_inf = -f32::INFINITY;
    let pos_inf = f32::INFINITY;

    // The ladder, each step against the next.
    assert neg_nan.cmp(&neg_inf) matches { Less };
    assert neg_inf.cmp(&(-1.0 as f32)) matches { Less };
    assert (-1.0 as f32).cmp(&neg_zero) matches { Less };
    assert neg_zero.cmp(&pos_zero) matches { Less };
    assert pos_zero.cmp(&(1.0 as f32)) matches { Less };
    assert (1.0 as f32).cmp(&pos_inf) matches { Less };
    assert pos_inf.cmp(&pos_nan) matches { Less };

    // Reflexive on every class, NaN included, which is what makes it total.
    assert neg_nan.cmp(&neg_nan) matches { Equal };
    assert pos_nan.cmp(&pos_nan) matches { Equal };
    assert neg_zero.cmp(&neg_zero) matches { Equal };
    assert (1.0 as f32).cmp(&(1.0 as f32)) matches { Equal };
    assert pos_nan.cmp(&neg_nan) matches { Greater };

    // A sort is therefore a permutation with one answer.
    let mut xs: List<f32> = [pos_inf, neg_zero, pos_nan, 1.0, neg_nan, pos_zero, neg_inf];
    xs.sort();
    assert xs[0].to_bits() == 0xFFC0_0000;
    assert xs[1].to_bits() == 0xFF80_0000;
    assert xs[2].to_bits() == 0x8000_0000;
    assert xs[3].to_bits() == 0x0000_0000;
    assert xs[4].to_bits() == 0x3F80_0000;
    assert xs[5].to_bits() == 0x7F80_0000;
    assert xs[6].to_bits() == 0x7FC0_0000;

    // The operators are untouched: IEEE, and `<` on a NaN stays false.
    assert !(pos_nan < pos_inf);
    assert !(pos_nan > pos_inf);
    assert !(pos_nan == pos_nan);
    assert neg_zero == pos_zero;
    assert !(neg_zero < pos_zero);

    // f64 orders by the same rule.
    let d_neg_nan = f64::from_bits(0xFFF8_0000_0000_0000);
    let d_pos_nan = f64::from_bits(0x7FF8_0000_0000_0000);
    assert d_neg_nan.cmp(&-f64::INFINITY) matches { Less };
    assert f64::INFINITY.cmp(&d_pos_nan) matches { Less };
    assert f64::from_bits(0x8000_0000_0000_0000).cmp(&(0.0 as f64)) matches { Less };
    assert d_pos_nan.cmp(&d_pos_nan) matches { Equal };

    // The half types order by the same rule. Their `<` reaches this `cmp`,
    // having no instruction of its own, so it is total where f32's is IEEE.
    assert f16::from_bits(0xFE00).cmp(&f16::from_bits(0xFC00)) matches { Less };
    assert f16::from_bits(0x8000).cmp(&f16::from_bits(0x0000)) matches { Less };
    assert f16::from_bits(0x7C00) < f16::from_bits(0x7E00);
    assert bf16::from_bits(0xFFC0).cmp(&bf16::from_bits(0xFF80)) matches { Less };
    assert bf16::from_bits(0x8000).cmp(&bf16::from_bits(0x0000)) matches { Less };
}

__DATA__
{}
