// Reflect per-struct synthesis (WEP 2026-06-13): trait-qualified static
// metadata `Reflect::<T>::type_name()`.

struct Point {
    x: i32,
    y: i32,
}

struct Named {
    id: i32,
    label: String,
    active: bool,
}

struct Unit {}

test "type_name is the struct name" {
    assert Reflect::<Point>::type_name() == "Point";
    assert Reflect::<Named>::type_name() == "Named";
    assert Reflect::<Unit>::type_name() == "Unit";
}

__DATA__
{"test": {}}
