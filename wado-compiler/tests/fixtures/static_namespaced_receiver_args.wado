//! `ns::Type::method(…)` reads the receiver's type arguments off the call, as
//! the two-segment spelling does. The namespaced branch was a parallel path
//! that read only a written turbofish: it mangled a name with no arguments at
//! all, and where none could be inferred it said nothing, leaving WIR build to
//! report an impl that is plainly there.

use lib from "./sub/static_namespaced_receiver_args.wado";

trait Wrap<T> {
    fn wrap(v: T) -> i32;
}

impl<T> Wrap<T> for lib::Cell<T> {
    fn wrap(v: T) -> i32 {
        return 1;
    }
}

test "the argument fills the namespaced receiver's slot" {
    assert lib::Cell::wrap(7) == 1;
}

__DATA__
{"test": {}}
