// Tuple destructuring with mutable bindings

use { println, Stdout } from "core:cli";

fn make_pair() -> [i32, i32] {
    return [10, 20];
}

fn run() with Stdout {
    let mut [a, b] = make_pair();
    println(`before: {a}, {b}`);
    a = 100;
    b = 200;
    println(`after: {a}, {b}`);
}

__DATA__
{"stdout": "before: 10, 20\nafter: 100, 200\n"}
