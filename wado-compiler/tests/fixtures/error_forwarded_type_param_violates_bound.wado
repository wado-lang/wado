// A forwarded type param that violates a bound is rejected in the generic body.
// `outer<U>` forwards `U` to `needs::<U>()` (requires `U: Producer`) without
// declaring the bound, so `U` meets none, whatever `outer` is called with.

use { println, Stdout } from "core:cli";

trait Producer with () {
    fn make() -> Self;
}
impl Producer for i32 {
    fn make() -> i32 { return 1; }
}

fn needs<T: Producer>() -> T {
    return T::make();
}

fn outer<U>() -> U {
    return needs::<U>();
}

export fn run() with Stdout {
    let x: String = outer::<String>();
    println(x);
}

__DATA__
{"compile_error": ":19:12: analysis error: type 'U' does not implement trait 'Producer' required by bound on 'T'"}
