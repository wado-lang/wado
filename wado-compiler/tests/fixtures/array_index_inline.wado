// Test for array indexing method inlining
// When optimized, index_value and index_assign calls should be inlined

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut arr: Array<i32> = [10, 20, 30];

    // Read via IndexValue trait (arr[i])
    let first = arr[0];
    let second = arr[1];

    // Write via IndexAssign trait (arr[i] = value)
    arr[2] = 100;

    println(`{first}, {second}, {arr[2]}`);
}

__DATA__
{"stdout": "10, 20, 100\n"}
