//! The lists a call records come from the resolution that named its callee.
//! Asking again by the base's bare name asks the *caller's* frame, which an
//! alias leaves without that name: the lists came back empty, the declared
//! default was never padded, and the call reached codegen an argument short.

use { Bytes as LibBytes } from "./sub/static_aliased_receiver_defaults.wado";

type Buf = LibBytes;

struct Bytes {
    n: i32,
}

impl Bytes {
    fn make(n: i32 = 99) -> Bytes {
        return Bytes { n: n };
    }
}

test "the alias pads its own declaration's default" {
    assert Buf::make().n == 1;
}

test "and the local shadow keeps its own" {
    assert Bytes::make().n == 99;
}

__DATA__
{"test": {}}
