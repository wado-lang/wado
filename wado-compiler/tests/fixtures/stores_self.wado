// stores[self]: a method that stores &self must declare stores[self].

struct Data {
    value: i32,
}

struct Container {
    data: &Data,
}

impl Data {
    fn store_self(&self) -> Container with stores[self] {
        return Container { data: self };
    }
}

export fn run() {
    let d = Data { value: 42 };
    let c = d.store_self();
    assert c.data.value == 42;
}

