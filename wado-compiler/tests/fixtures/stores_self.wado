// `self` is a reference parameter like any other: a method may put it in the
// value it returns, and the walk reads that retention from the body.

struct Data {
    value: i32,
}

struct Container {
    data: &Data,
}

impl Data {
    fn store_self(&self) -> Container {
        return Container { data: self };
    }
}

export fn run() {
    let d = Data { value: 42 };
    let c = d.store_self();
    assert c.data.value == 42;
}

