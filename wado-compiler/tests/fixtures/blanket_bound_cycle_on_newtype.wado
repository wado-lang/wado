// Two blankets whose bounds name each other, asked of a newtype. Rank 1 holds
// the subject fixed, so a repeated `(type, trait)` pair grounds nothing and
// answers `false`: `Wrapped` takes the `Limit` blanket it really carries, and
// the walk terminates (WEP 2026-09-01).

trait Alpha {
    fn alpha() -> i32;
}

trait Beta {
    fn beta() -> i32;
}

impl<T: Beta> Alpha for T {
    fn alpha() -> i32 {
        return T::beta();
    }
}

impl<T: Alpha> Beta for T {
    fn beta() -> i32 {
        return T::alpha();
    }
}

trait Limit {
    fn limit() -> i32;
}

trait Describe {
    fn describe(&self) -> String;
}

impl<T: Alpha> Describe for T {
    fn describe(&self) -> String {
        return `alpha:${T::alpha()}`;
    }
}

impl<T: Limit> Describe for T {
    fn describe(&self) -> String {
        return `limit:${T::limit()}`;
    }
}

struct Inner {
    x: i32,
}

type Wrapped = Inner;

impl Limit for Wrapped {
    fn limit() -> i32 {
        return 3;
    }
}

test "a cycle among blanket bounds terminates" {
    let w = Inner { x: 1 } as Wrapped;
    assert w.describe() == "limit:3";
}

__DATA__
{"test": {}}
