// An unrestricted handle is an `f64`, so `as` relates it to `f64` and nothing
// else: an integer would round away the class the handle carries. Between two
// handles `as` only upcasts, since only a type pattern tests the class.
use { Document, Element, Node } from "web:dom";

fn down(n: Node) -> Element {
    return n as Element;
}

fn up(e: Element) -> Node {
    return e as Node;
}

fn to_int(d: Document) -> u32 {
    return d as u32;
}

fn from_int() -> Document {
    return 0 as Document;
}

fn round_trip(d: Document) -> Document {
    return d as f64 as Document;
}

export fn run() {}

__DATA__
{
    "compile_error": "cannot cast 'Node' to 'Element': `as` only upcasts a handle; a type pattern narrows one",
    "compile_errors_contains": [
        "cannot cast 'Document' to 'u32': an unrestricted resource handle is an `f64`",
        "cannot cast 'i32' to 'Document': an unrestricted resource handle is an `f64`"
    ],
    "compile_error_codes": ["INVALID_CAST"]
}
