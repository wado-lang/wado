// `sroa_param` scalarizes the `&Point` parameter of the `rebuilt` clone down to
// its one non-constant field, retyping the slot from `&Point` to `String`. The
// value pool kept the canonical `Opaque(Local)` it had minted for the old type,
// so `promote_fields` re-derived `v.used` onto it and the WIR extractor read the
// receiver's recorded type — `Point` — and emitted `struct.get $Point 1` on a
// `String` local. Only `-O1` reached the shape: at `-O2` and above the shadowing
// `let` folds away, and the empty guard is what keeps it at `-O1`.

struct Point {
    x: i32,
    label: String,
}

fn rebuilt<S: ReflectStruct<FieldTypes = [..F]>, ..F>(v: &S) -> S {
    if builtin::black_box(false) { }
    return ReflectStruct::<S>::from_fields(
        [for let f of ReflectStruct::<S>::members() { f.get(v) }],
    );
}

test "a retyped parameter slot keeps its own field type" {
    let p = Point { x: 1, label: "hi" };
    assert rebuilt(&p) == p;
}

__DATA__
{"test": {}}
