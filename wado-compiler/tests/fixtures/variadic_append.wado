fn append<..T, B>(rest: [..T], b: B) -> [..T, B] {
    return [..rest, b];
}

export fn run() {
    let result = append(["hello", true], 42);
    assert result.0 == "hello";
    assert result.1 == true;
    assert result.2 == 42;

    // Single-element pack
    let single = append([1], "end");
    assert single.0 == 1;
    assert single.1 == "end";
}

__DATA__
