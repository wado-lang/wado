// Overwrite entire struct through dereference assignment
// Requires: deref assignment (*ref = value) for object types

use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

fn reset(p: &mut Point) {
    *p = Point { x: 0, y: 0 };
}

export fn run() with Stdout {
    let mut p = Point { x: 10, y: 20 };
    println(`{p.x},{p.y}`);

    reset(&mut p);
    println(`{p.x},{p.y}`);
}

__DATA__
{"stdout": "10,20\n0,0\n"}
