// Test: exhaustive Variant match emits no redundant last-arm test.
//
// For a `match` whose arms exhaustively cover every case of a variant
// (here `Result<(), AppError>` with two cases), the last arm in source
// order is statically guaranteed to be reached only when every previous
// arm has failed — its pattern test and the trailing `unreachable`
// fallback are dead. The TIR→WIR lowering in
// `wir_build/pattern_match.rs::translate_match` recognizes this and
// treats the final arm as irrefutable (bindings + body only, no `If`
// wrap). This removes one `ref.is_null` + one `i32.eqz` + one branch
// per `?` on the hot path of every deserializer and `?`-heavy
// function.
//
// At `-O2`, after `NullableRef` converts `ref.test` to `ref.is_null`,
// the redundant `ref.is_null(scrut) == 0` re-check is never emitted.

use { println, Stdout } from "core:cli";

struct AppError {
    message: String,
}

fn step(flag: bool) -> Result<(), AppError> {
    if flag {
        return Result::Err(AppError { message: "boom" });
    }
    return Result::Ok(());
}

pub fn chain(flag: bool) -> Result<(), AppError> {
    step(flag)?;
    return Result::Ok(());
}

test {
    assert chain(false) matches { Ok(_) };
    assert chain(true) matches { Err(_) };
}

__DATA__
{
    "test": {},
    "wir_not_expect:O2": ["ref.is_null(__match_scrut_0) == 0"]
}
