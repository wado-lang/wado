// Test: Collapse nested `if !cond ... unreachable` generated by match lowering.
//
// The `?` operator on a `Result<(), E>` (nullable-ref representation: the Ok
// arm has no payload, so the variant lowers to a single nullable error ref)
// lowers to a three-way match whose second arm is `!is_null` and whose third
// arm is unreachable. Since a nullable ref is exhaustively either null or
// non-null, the middle test is a redundant re-evaluation of the already-known
// condition. Collapsing it removes one `ref.is_null` + one `i32.eqz` + one
// branch per `?` on the hot path of every deserializer and `?`-heavy
// function.
//
// At O0: the redundant `is_null(X) == 0` re-check appears.
// At O2: the inner `if` is folded away; the outer else directly contains the
// error-propagation body.

use { println, Stdout } from "core:cli";

struct AppError {
    message: String,
}

fn step(flag: bool) -> Result<(), AppError> {
    if flag {
        return Result::Err(AppError { message: "boom" });
    }
    return Result::Ok(());
}

pub fn chain(flag: bool) -> Result<(), AppError> {
    step(flag)?;
    return Result::Ok(());
}

test {
    assert chain(false) matches { Ok(_) };
    assert chain(true) matches { Err(_) };
}

__DATA__
{
    "test": {},
    "wir_not_expect:O2": ["ref.is_null(__match_scrut_0) == 0"]
}
