// The trait's parameter is named as the trait writes it, whatever the impl
// method calls its own.
trait Sink with () {
    fn put<affine T>(&mut self, v: T) -> i32;
}

struct S {}

impl Sink for S {
    fn put<V>(&mut self, v: V) -> i32 {
        return 2;
    }
}

export fn run() {}

