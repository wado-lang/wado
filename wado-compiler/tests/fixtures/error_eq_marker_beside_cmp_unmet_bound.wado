// A marker beside a written `cmp` asks for the `Eq` that `cmp` gives, which
// carries the `cmp` impl's bounds: the marker's unbounded `T` does not widen
// it. `==` on an instance that is not `Ord` says why.

struct Ranked<T> {
    rank: T,
}

impl<T: Ord> Ord for Ranked<T> {
    fn cmp(&self, other: &Self) -> Ordering {
        return self.rank.cmp(&other.rank);
    }
}

impl<T> Eq for Ranked<T>;

struct Opaque {
    f: fn() -> i32,
}

fn one() -> i32 {
    return 1;
}

test {
    let a = Ranked { rank: Opaque { f: one } };
    let _ = a == a;
    assert Ranked { rank: 1 } == Ranked { rank: 1 };
}

__DATA__
{
    "compile_error": ":27:13: analysis error: operator `==` cannot be applied to type `Ranked<Opaque>`: type does not implement `Eq`\n  note: `Ranked<Opaque>` takes `Eq` from its written `cmp`, and does not implement `Ord`"
}
