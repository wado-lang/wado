// Escape analysis: hoisting must NOT fire when the whole template String
// escapes the iteration. Each result is moved into a list that outlives the
// loop, so all six must coexist — a reused scratch buffer would leave every
// entry showing the last iteration's bytes, which the printed output catches.
// The WIR must NOT contain __tmpl_buf_.
//
// The complementary case — a template moved straight into a map key — is the
// same rule seen from the caller side; see tmpl_hoist_escape_copy_safe.wado.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut kept: List<String> = [];

    // Case 1: let-bound template moved into the list
    for let mut i = 0; i < 3; i += 1 {
        let s = `x=${i}`;
        kept.push(s);
    }

    // Case 2: template directly as arg (non-Let context)
    for let mut i = 0; i < 3; i += 1 {
        kept.push(`y=${i}`);
    }

    for let s of &kept {
        println(*s);
    }
}

__DATA__
{
    "stdout": "x=0\nx=1\nx=2\ny=0\ny=1\ny=2\n",
    "wir_not_expect:O2": ["__tmpl_buf_"]
}
