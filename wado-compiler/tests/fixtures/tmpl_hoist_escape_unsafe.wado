// Escape analysis: hoisting must NOT fire when the whole template String
// escapes the iteration. Each result is passed by value to println (a core
// lib function, not inlined), so the entire local escapes and its backing
// buffer cannot be reused. The WIR must NOT contain __tmpl_buf_.
//
// The complementary case — a template whose bytes escape only through a fresh
// deep copy — IS safely hoisted; see tmpl_hoist_escape_copy_safe.wado.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Case 1: let-bound template passed to println (core lib, not inlined)
    for let mut i = 0; i < 3; i += 1 {
        let s = `x={i}`;
        println(s);
    }

    // Case 2: template directly as arg to println (non-Let context)
    for let mut i = 0; i < 3; i += 1 {
        println(`y={i}`);
    }
}

__DATA__
{
    "stdout": "x=0\nx=1\nx=2\ny=0\ny=1\ny=2\n",
    "wir_not_expect:O2": ["__tmpl_buf_"]
}
