// Escape analysis: hoisting must NOT fire when the whole template String
// escapes the iteration. Each result is passed by value to a call that stays a
// call, so the entire local escapes and its backing buffer cannot be reused.
// The WIR must NOT contain __tmpl_buf_.
//
// `#[inline(never)]` on the sink is what makes the escape a property of the
// fixture rather than of whatever the inline threshold happens to be: a
// `println` small enough to inline stops the String escaping at all, and
// hoisting it then becomes legitimate.
//
// The complementary case — a template whose bytes escape only through a fresh
// deep copy — IS safely hoisted; see tmpl_hoist_escape_copy_safe.wado.
use { println, Stdout } from "core:cli";

#[inline(never)]
fn sink(s: String) with Stdout {
    println(s);
}

export fn run() with Stdout {
    // Case 1: let-bound template passed by value to a call that stays a call
    for let mut i = 0; i < 3; i += 1 {
        let s = `x=${i}`;
        sink(s);
    }

    // Case 2: template directly as arg (non-Let context)
    for let mut i = 0; i < 3; i += 1 {
        sink(`y=${i}`);
    }
}

__DATA__
{
    "stdout": "x=0\nx=1\nx=2\ny=0\ny=1\ny=2\n",
    "wir_not_expect:O2": ["__tmpl_buf_"]
}
