use { println, Stdout } from "core:cli";
use { i32x4, f64x2, i8x16 } from "core:simd";

export fn run() with Stdout {
    // Tuple literal coercion to SIMD types
    let v: i32x4 = [1, 2, 3, 4];
    assert v.extract_lane(0) == 1;
    assert v.extract_lane(1) == 2;
    assert v.extract_lane(2) == 3;
    assert v.extract_lane(3) == 4;

    let f: f64x2 = [1.5, 2.5];
    assert f.extract_lane(0) == 1.5;
    assert f.extract_lane(1) == 2.5;

    // Arithmetic on coerced literals
    let a: i32x4 = [10, 20, 30, 40];
    let b: i32x4 = [1, 2, 3, 4];
    let c = a + b;
    assert c.extract_lane(0) == 11;
    assert c.extract_lane(3) == 44;

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
