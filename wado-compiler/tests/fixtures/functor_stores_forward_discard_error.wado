// Completing check #1 for a discarded-result call: `keep` stores its parameter
// externally (into a global) and returns nothing, so forwarding `d` to it makes
// `forward` store `d` too — regardless of the discarded result. `forward` must
// declare `stores[d]`.

struct Data {
    v: i32,
}

global mut SAVED: &Data = &Data { v: 0 };

fn keep(d: &Data) with stores[d] {
    SAVED = d;
}

fn forward(d: &Data) {
    keep(d);
}

export fn run() {
    let x = Data { v: 1 };
    forward(&x);
}

__DATA__
{"compile_error": "stores[d]"}
