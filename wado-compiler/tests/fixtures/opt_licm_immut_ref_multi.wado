// Optimization: LICM with multiple immutable ref locals and function calls.
//
// Field reads on multiple immutable ref locals hoist, here as one product, when
// the locals are passed to different non-mutating functions in a loop. Each
// reference names a list element, so no pass scalarizes the struct before LICM
// sees the read.

use { println, Stdout } from "core:cli";

struct Config {
    threshold: i32,
    scale: i32,
}

struct Stats {
    count: i32,
    total: i32,
}

#[inline("never")]
fn read_config(c: &Config) -> i32 {
    return c.threshold;
}

#[inline("never")]
fn read_stats(s: &Stats) -> i32 {
    return s.count;
}

// Case: Multiple immutable ref locals, each passed to a function.
// Both threshold and count field accesses should be hoisted.
export fn run() with Stdout {
    let configs: List<Config> = [Config { threshold: builtin::black_box(10), scale: 2 }];
    let stats: List<Stats> = [Stats { count: builtin::black_box(5), total: 0 }];
    let cr = &configs[0];
    let sr = &stats[0];
    let mut sum = 0;
    for let mut i = 0; i < 4; i += 1 {
        let _ = read_config(cr);
        let _ = read_stats(sr);
        sum += cr.threshold * sr.count * i;
    }
    println(`${sum}`);
}

__DATA__
{
    "stdout": "300\n",
    "wir_scope": "opt_licm_immut_ref_multi.wado/run",
    "wir_pass": {"O2": ["nir/licm"]},
    "wir_expect:O2": ["$licm_arith_{} = cr.threshold * sr.count;"]
}
