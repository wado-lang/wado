// Test importing a module with global variables
use { println, Stdout } from "core:cli";
use { get_constant, CONSTANT } from "./sub/global_import_module.wado";

fn run() with Stdout {
    // Test calling a function that uses an imported global
    let c = get_constant();
    println(`get_constant={c}`);

    // Test directly importing and using a global variable
    println(`CONSTANT={CONSTANT}`);
}

__DATA__
{"stdout": "get_constant=42\nCONSTANT=42\n"}
