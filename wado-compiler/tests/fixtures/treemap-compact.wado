// TreeMap compact after many deletions preserves insertion order
use { println, print } from "core:cli";
use { TreeMap } from "core:collections";

export fn run() with Stdout {
    let mut map = TreeMap::<String, i32>::new();

    // Insert 10 items
    map["a"] = 1;
    map["b"] = 2;
    map["c"] = 3;
    map["d"] = 4;
    map["e"] = 5;
    map["f"] = 6;
    map["g"] = 7;
    map["h"] = 8;
    map["i"] = 9;
    map["j"] = 10;

    assert map.len() == 10;

    // Remove 6 items to trigger compaction (deleted_count > size && deleted_count > 4)
    // Keep: a, d, f, j (positions 0, 3, 5, 9 originally)
    map.remove("b");  // deleted: 1
    map.remove("c");  // deleted: 2
    map.remove("e");  // deleted: 3
    map.remove("g");  // deleted: 4
    map.remove("h");  // deleted: 5
    map.remove("i");  // deleted: 6, size: 4 -> triggers compact

    assert map.len() == 4;

    // After compact, remaining keys should still be in original insertion order
    let keys = map.keys();
    assert keys.len() == 4;
    assert keys[0] == "a", "a should be first";
    assert keys[1] == "d", "d should be second";
    assert keys[2] == "f", "f should be third";
    assert keys[3] == "j", "j should be fourth";

    // Values should match
    let values = map.values();
    assert values[0] == 1;
    assert values[1] == 4;
    assert values[2] == 6;
    assert values[3] == 10;

    // Insert new key after compact - should go to end
    map["new"] = 100;
    let keys2 = map.keys();
    assert keys2.len() == 5;
    assert keys2[4] == "new";

    // Lookups should still work after compact
    if let Some(v) = map["d"] {
        assert v == 4;
    } else {
        panic("d should exist");
    }

    if let Some(v) = map["new"] {
        assert v == 100;
    } else {
        panic("new should exist");
    }

    println("compact preserves order: ok");
}

__DATA__
{"stdout": "compact preserves order: ok\n"}
