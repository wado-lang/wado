// stores[self] violation: storing &self without declaring stores[self].

struct Data {
    value: i32,
}

struct Container {
    data: &Data,
}

impl Data {
    fn store_self_bad(&self) -> Container {
        return Container { data: self };
    }
}

export fn run() {
    let d = Data { value: 42 };
    let c = d.store_self_bad();
    assert c.data.value == 42;
}

__DATA__
{"compile_error": "storing reference parameter 'self' in struct field requires `stores[self]` declaration"}
