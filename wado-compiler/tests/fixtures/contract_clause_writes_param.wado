// A parameter is the callee's own copy, so a clause writing it changes neither
// the caller's local nor the place the argument was read from. The body sees
// what the clause wrote, as it does through a function value.

use { println, Stdout } from "core:cli";

struct S { x: i32 }

fn bump(v: &mut i32) -> bool {
    *v += 1;
    return true;
}

fn bumped(mut n: i32) -> i32
    contract bump(&mut n)
{
    return n;
}

fn doubled(mut n: i32) -> i32
    contract doubling: { n = n * 2; true }
{
    return n;
}

fn bumped_beside(mut n: i32, xs: &List<i32>) -> i32
    contract bump(&mut n)
{
    return n + xs.len();
}

export fn run() with Stdout {
    let a = builtin::black_box(5);
    println(`${bumped(a)} ${a}`);
    let s = S { x: builtin::black_box(5) };
    println(`${bumped(s.x)} ${s.x}`);
    let ys: List<i32> = [7, 8];
    println(`${bumped(ys[1])} ${ys[1]}`);
    println(`${bumped_beside(a, &ys)} ${a}`);
    println(`${doubled(a)} ${a}`);
    let f: fn(i32) -> i32 = bumped;
    println(`${f(a)} ${a}`);
}

__DATA__
{
    "stdout": "6 5\n6 5\n9 8\n8 5\n10 5\n6 5\n"
}
