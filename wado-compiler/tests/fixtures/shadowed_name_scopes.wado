// A binding belongs to the construct that introduces it, wherever that
// construct sits. An expression form scopes its names the way a statement form
// does, so a second `matches` or `if let` reusing a name is not a shadow — and
// a parameter shares the body's top-level scope, which is what makes the
// derived `let` there the same-scope form the language sanctions.

use { println, Stdout } from "core:cli";

fn bump(n: i32) -> i32 {
    let n = n + 1;
    return n;
}

fn probe(a: &Option<i32>, b: &Option<i32>) -> i32 {
    assert *a matches { Some(v) && v > 0 };
    assert *b matches { Some(v) && v > 1 };
    let first = if let Some(v) = *a { v } else { 0 };
    let second = if let Some(v) = *b { v } else { 0 };
    let inc = |v: i32| v + 1;
    return first + second + inc(1);
}

export fn run() with Stdout {
    assert bump(1) == 2;
    assert probe(&Option::<i32>::Some(1), &Option::<i32>::Some(2)) == 5;
    assert bump(4) == 5;
    println("ok");
}

__DATA__
{
    "stdout": "ok\n",
    "warnings_not_contains": [
        "`n` shadows",
        "`v` shadows"
    ]
}
