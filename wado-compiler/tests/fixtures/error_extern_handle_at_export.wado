// An extern handle is a reference to a host object, which the canonical ABI
// cannot carry: an `export fn` neither takes nor returns one, bare or nested.

#[cm("example:demo/dom#node", linearity = "unrestricted", repr = "externref")]
pub resource Node {}

export fn take(n: Node) {}

export fn give() -> Option<Node> {
    return null;
}

export fn nested(ns: List<Node>) {}

__DATA__
{
    "compile_error": "extern handle in parameter 'n' of `take` is not allowed: an extern handle does not cross a component boundary",
    "compile_errors_contains": [
        "extern handle in return type of `give` is not allowed: an extern handle does not cross a component boundary",
        "extern handle in parameter 'ns' of `nested` is not allowed: an extern handle does not cross a component boundary"
    ],
    "compile_error_codes": ["CM_BOUNDARY_TYPE"]
}
