// `ReflectStruct::from_fields` (WEP 2026-06-13): assemble a struct from its
// field-value tuple — the build direction that mirrors the `members()` walk.

struct Point {
    x: i32,
    y: i32,
}

struct Mixed {
    a: i32,
    flag: bool,
    label: String,
}

struct Empty {}

test "from_fields assembles a struct from its field tuple" {
    let p = ReflectStruct::<Point>::from_fields([1, 2]);
    assert p.x == 1;
    assert p.y == 2;
}

test "from_fields carries heterogeneous field types" {
    let m = ReflectStruct::<Mixed>::from_fields([7, true, "hi"]);
    assert m.a == 7;
    assert m.flag;
    assert m.label == "hi";
}

test "from_fields round-trips a members() walk" {
    let p = Point { x: 3, y: 4 };
    let rebuilt = ReflectStruct::<Point>::from_fields([p.x, p.y]);
    assert rebuilt.x == p.x;
    assert rebuilt.y == p.y;
}

test "a memberless struct builds from the empty tuple" {
    let e = ReflectStruct::<Empty>::from_fields([]);
    assert `${e:?}` == "Empty {}";
}

__DATA__
{"test": {}}
