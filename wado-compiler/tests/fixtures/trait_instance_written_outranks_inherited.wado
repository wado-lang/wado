//! `trait_static_written_outranks_inherited` for the receiver-taking kind. The
//! argument picks first and the written body breaks the tie among what it
//! admits, so the block that inherits still answers for its own argument.

trait Conv<T> {
    fn go(&self, v: T) -> i32 {
        return 9;
    }
}

struct M {}

impl Conv<i32> for M {}

impl Conv<String> for M {
    fn go(&self, v: String) -> i32 {
        return 2;
    }
}

test "the written body answers its argument" {
    let m = M {};
    assert M::go(&m, "x") == 2;
}

test "and the inherited default still answers its own" {
    let m = M {};
    assert M::go(&m, 5) == 9;
}
