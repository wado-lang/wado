// `Iterator`'s head is `with _`, so an iterator that prints is ordinary. The
// effect reaches whoever iterates it: `consume` names `Counter`, so the head's
// hole resolves to what `Counter`'s impl declares.
use { println, Stdout } from "core:cli";

struct Counter {
    n: i32,
}

impl Iterator for Counter {
    type Item = i32;

    fn next(&mut self) -> Option<i32> with Stdout {
        println("tick");
        if self.n <= 0 {
            return null;
        }
        self.n = self.n - 1;
        return Option::Some(self.n);
    }
}

impl IntoIterator for Counter {
    type Item = i32;
    type Iter = Counter;

    fn into_iter(&self) -> Counter {
        return *self;
    }
}

fn consume(c: Counter) with Stdout {
    for let v of c {
        println(`${v}`);
    }
}

export fn run() with Stdout {
    consume(Counter { n: 2 });
}

__DATA__
{"stdout": "tick\n1\ntick\n0\ntick\n"}
