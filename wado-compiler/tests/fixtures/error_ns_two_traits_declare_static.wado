//! The namespace-qualified spelling of an ambiguity the bare one reports. The
//! arm read only a `Found` answer and built a trait-less name from anything
//! else, so through a namespace the ambiguity became a mangled name nothing
//! declares — reported as an internal temporary having no type.

use lib from "./sub/two_traits_static_lib.wado";

export fn run() {
    assert lib::M::make() == 1;
}

__DATA__
{"compile_error": "ambiguous method 'make': declared by 'Alpha' and 'Beta'"}
