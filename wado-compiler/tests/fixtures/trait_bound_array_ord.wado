// Test that List<T> comparison requires T: Ord

variant NoOrd {
    A(fn() -> i32),
    B,
}

struct Foo {
    x: NoOrd,
}

export fn run() {
    let a: List<Foo> = [Foo { x: NoOrd::A(|| 1) }];
    let b: List<Foo> = [Foo { x: NoOrd::A(|| 2) }];
    // Foo does not implement Ord (NoOrd's `fn` payload has none), so < on List<Foo> should fail
    assert a < b;
}

__DATA__
{"compile_error": "<"}
