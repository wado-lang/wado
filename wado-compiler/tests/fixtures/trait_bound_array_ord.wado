// Test that Array<T> comparison requires T: Ord

variant NoOrd {
    A(i32),
    B,
}

struct Foo {
    x: NoOrd,
}

export fn run() {
    let a: Array<Foo> = [Foo { x: NoOrd::A(1) }];
    let b: Array<Foo> = [Foo { x: NoOrd::A(2) }];
    // Foo does not implement Ord (NoOrd variant field), so < on Array<Foo> should fail
    assert a < b;
}

__DATA__
{"compile_error": "<"}
