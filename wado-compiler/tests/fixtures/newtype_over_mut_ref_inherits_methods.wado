// Test: a newtype over `&mut T` calls `T`'s methods, as the reference does.
//
// The inherited method was recorded as owned by the newtype's base `&mut T`
// rather than by `T`, so the call named `&mut T::bump`, a function that does
// not exist, and the compiler panicked. And the binding holding the newtype
// was taken for the place the method writes, so an immutable one was refused
// although the write lands behind the reference, as it does for `&mut T`.
// Nor does such a method re-type to the newtype, as one inherited from a value
// base does: `add` still takes `&Counter`, and `snapshot` returns a `Counter`,
// a copy, not a second handle onto `c`.

use { println, Stdout } from "core:cli";

struct Counter {
    n: i32,
}

impl Counter {
    fn bump(&mut self) -> i32 {
        self.n += 1;
        return self.n;
    }

    fn add(&mut self, other: &Counter) -> i32 {
        self.n += other.n;
        return self.n;
    }

    fn snapshot(&self) -> Counter {
        return *self;
    }
}

type Handle = &mut Counter;

fn twice(h: &mut Handle) -> i32 {
    return h.bump() + h.bump();
}

export fn run() with Stdout {
    let mut c = Counter { n: 0 };
    let h = &mut c as Handle;
    let first = h.bump();
    let mut held = &mut c as Handle;
    let both = twice(&mut held);
    let d = Counter { n: 10 };
    let summed = held.add(&d);
    let mut copy = held.snapshot();
    copy.n = 100;
    println(`${first} ${both} ${summed} ${c.n} ${copy.n}`);
}

__DATA__
{
    "stdout": "1 5 13 13 100\n"
}
