// Test: Branchless increment — `if bool { x += 1 }` → `x += bool`
//
// When a boolean-valued expression gates an increment-by-one, the peephole
// pass replaces the branch with an unconditional add of the 0/1 value.
//
// At O0: `if ... { count = count + 1; }` (conditional increment)
// At O2: `count = count + builtin::array_get_value<bool>(...)` (branchless add)
//
// Requires O2 because the array access must be inlined first.

fn count_trues(arr: List<bool>) -> i32 {
    let mut count = 0;
    for let mut i = 0; i < arr.len(); i += 1 {
        if arr[i] {
            count += 1;
        }
    }
    return count;
}

test {
    // `black_box`ed inputs so the calls survive to the WIR: a fully constant
    // list folds to the count, and the loop this pins goes with it. The counts
    // are bound first, so no assert formats a `List<bool>`, which branches on
    // each element.
    let a: List<bool> = [true, false, true, true, false];
    let a_count = count_trues(builtin::black_box(a));
    assert a_count == 3;

    let empty: List<bool> = [];
    let empty_count = count_trues(builtin::black_box(empty));
    assert empty_count == 0;

    let all_true: List<bool> = [true, true, true];
    let all_true_count = count_trues(builtin::black_box(all_true));
    assert all_true_count == 3;
}

__DATA__
{
    "test": {},
    "wir_expect:O0": ["count = count + 1"],
    "wir_not_expect:O2": ["if builtin::array_get_value<bool>"],
    "wir_expect:O2": [" + builtin::array_get_value<bool>("]
}
