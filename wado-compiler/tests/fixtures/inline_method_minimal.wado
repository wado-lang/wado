// Minimal test case for method call inlining
// This should trigger the local index out of bounds error

use { println, Stdout } from "core:cli";

fn run() with Stdout {
    // Create arrays that will have method calls inlined
    let mut arr1: Array<i32> = [];
    let mut arr2: Array<i32> = [];

    // Multiple method calls that get inlined
    // This creates multiple inlined locals that might conflict
    arr1.append(1);
    arr1.append(2);
    arr2.append(3);

    // Access elements to trigger more inlining
    let a = arr1[0];
    let b = arr2[0];

    println(`Result: {a}, {b}`);
}

__DATA__
{"stdout": "Result: 1, 3\n"}
