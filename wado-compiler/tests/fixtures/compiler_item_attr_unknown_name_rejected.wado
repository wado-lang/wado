// Rust side would leave the corresponding stdlib annotation pointing at nothing.

// Served as part of the standard library (`"stdlib": true`), the only place
// the attribute is valid.
#![stdlib("core:benchmark")]

#[compiler_item("not_a_real_item")]
pub struct Garbage {}

export fn run() {}

__DATA__
{"stdlib": true, "compile_error": "unknown compiler item"}
