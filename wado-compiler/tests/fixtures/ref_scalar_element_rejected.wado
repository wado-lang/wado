// `&xs[i]` on a value-typed element is rejected: an array element of a scalar
// type has no reference identity, so the reference would alias a snapshot copy
// rather than the element. Read it by value instead. (A scalar *local* `&x` is
// a real reference — its slot is boxed — and stays allowed.) See WEP 2026-07-19.

test "unreachable" {
    let nums: List<i32> = [1, 2, 3];
    let r = &nums[0];
    assert *r == 1;
}

__DATA__
{
    "test": {},
    "compile_error": "has no reference identity"
}
