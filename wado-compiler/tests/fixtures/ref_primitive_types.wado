// References to various primitive types (i64, f64, bool)

use { println, Stdout } from "core:cli";

fn set_i64(r: &mut i64, v: i64) {
    *r = v;
}

fn set_f64(r: &mut f64, v: f64) {
    *r = v;
}

fn set_bool(r: &mut bool, v: bool) {
    *r = v;
}

fn read_i64(r: &i64) -> i64 {
    return *r;
}

fn read_f64(r: &f64) -> f64 {
    return *r;
}

fn read_bool(r: &bool) -> bool {
    return *r;
}

export fn run() with Stdout {
    let mut a: i64 = 100 as i64;
    println(`i64: {read_i64(&a)}`);
    set_i64(&mut a, 200 as i64);
    println(`i64: {a}`);

    let mut b: f64 = 3.14;
    println(`f64: {read_f64(&b)}`);
    set_f64(&mut b, 2.718);
    println(`f64: {b}`);

    let mut c = true;
    println(`bool: {read_bool(&c)}`);
    set_bool(&mut c, false);
    println(`bool: {c}`);
}

__DATA__
{"stdout": "i64: 100\ni64: 200\nf64: 3.14\nf64: 2.718\nbool: true\nbool: false\n"}
