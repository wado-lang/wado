// `Array<T>` builds no sequence from a literal, so the annotated form is a type
// mismatch. The `as` form skipped that check and handed codegen a tuple
// `StructNew` typed as the target, tripping the module validator.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let n = [1, 2] as Array<i32>;
    println(`${n.len()}`);
}

