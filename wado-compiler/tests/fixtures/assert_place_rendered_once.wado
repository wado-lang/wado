// A place renders once however many times the condition mentions it. The
// failure branch re-reads it, so a second line would repeat the first.

export fn run() {
    let x = builtin::black_box(10);
    assert x + x + x == 99;
}

__DATA__
{
    "trapped": true,
    "stderr_contains": [
        "condition: x + x + x == 99\nx: 10\nx + x: 20\n"
    ]
}
