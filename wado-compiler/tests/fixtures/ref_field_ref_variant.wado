// A variant is boxed by `&mut` like any replace-on-assign type, but its payload
// is a shared GC struct, so mutation through the payload lands. Taking `&mut`
// of a variant place is therefore allowed, unlike a primitive or fn place.

use { println, Stdout } from "core:cli";

struct Named {
    name: String,
}

variant Element {
    Ref(Named),
    Wildcard,
}

struct Label {
    element: Element,
}

fn rename(elem: &mut Element) {
    match elem {
        Ref(r) => {
            r.name = `renamed`;
        },
        Wildcard => (),
    }
}

export fn run() with Stdout {
    let mut lab = Label { element: Element::Ref(Named { name: `original` }) };
    rename(&mut lab.element);
    assert lab.element matches { Ref(r) && r.name == `renamed` };

    let mut local = Element::Ref(Named { name: `original` });
    rename(&mut local);
    assert local matches { Ref(r) && r.name == `renamed` };

    println(`ok`);
}

__DATA__
{"stdout": "ok\n"}
