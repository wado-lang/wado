// A payload reached both directly and through a stdlib wrapper gets one binding
// helper, not two. `rx.read(..)` names `u32` before monomorphize, `read_to_end`
// only once its instance exists, so each half of binding synthesis sees the same
// payload — and minting `__cm_stream_read_val_u32` twice put two functions with
// one name in the module.
use { println, Stdout } from "core:cli";

// Separate streams: reading past a `Dropped` result is the trap the WEP's known
// gap still leaves, and not what this fixture is about.
export fn run() with Stdout {
    let [rx, tx] = Stream::<u32>::new();
    tx.drop();
    let chunk = rx.read(16);
    rx.drop();

    let [rx2, tx2] = Stream::<u32>::new();
    tx2.drop();
    let rest = rx2.read_to_end();
    rx2.drop();

    println(`${chunk.items.len()} ${chunk.result:?} ${rest.len()}`);
}

__DATA__
{"stdout": "0 CopyResult::Dropped 0\n"}
