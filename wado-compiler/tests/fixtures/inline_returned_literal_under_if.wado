// The literal a `return` hands back is the body's last act, whichever arm of
// an `if` builds it, so it is no safepoint: `position` loops and answers with
// an `Option` either way, and is spliced at its site in `total`'s loop like a
// callee returning one literal.
use { println, Stdout } from "core:cli";

fn position(xs: &Array<i32>, want: i32) -> Option<i32> {
    let mask = xs.len() - 1;
    let mut i = (want * 31 ^ want >> 3) & mask;
    let mut steps = 0;
    while steps <= mask && xs[i] != want && xs[i] + 1 != want + 1 && (xs[i] ^ want) != 0 {
        i = i + 1 & mask;
        steps += 1;
    }
    return if steps <= mask { Option::Some(i) } else { null };
}

#[inline(never)]
fn total(xs: &Array<i32>, wants: &Array<i32>) -> i32 {
    let mut sum = 0;
    for let w of 0..<wants.len() {
        sum += position(xs, wants[w]).unwrap_or(-1);
    }
    return sum;
}

export fn run() with Stdout {
    let mut xs = Array::<i32>::filled(4, 0);
    for let i of 0..<4 {
        xs[i] = builtin::black_box(i * 10);
    }
    let mut wants = Array::<i32>::filled(3, 0);
    wants[0] = 30;
    wants[1] = 10;
    wants[2] = 7;
    println(`${total(&xs, &builtin::black_box(wants))}`);
}

__DATA__
{
    "stdout": "3\n",
    "wir_pass": {"O2": ["nir/inline"]},
    "wir_not_expect:O2": ["/position"]
}
