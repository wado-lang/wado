// Test: a `let` the body later assigns to is no alias, mutable or not.
//
// Scalarizing `h` leaves `let $sroa_h_f = x` with no `mut` and then
// `$sroa_h_f = y`. The compile-time engine aliased every immutable `let` of a
// reference to the place it named, so that assignment wrote `y` into `x`, and
// `make` folded to 807.

use { println, Stdout } from "core:cli";

struct Holder {
    f: &mut &mut i32,
}

fn make() -> i32 {
    let mut x = 41;
    let mut y = 7;
    let mut rx = &mut x;
    let h = Holder { f: &mut rx };
    let r = *h.f;
    *h.f = &mut y;
    *r += 1;
    return x * 100 + y;
}

global FOLDED: i32 = make();

export fn run() with Stdout {
    println(`${FOLDED} ${make()}`);
}

__DATA__
{
    "stdout": "4207 4207\n"
}
