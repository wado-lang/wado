// Duplicate fields during JSON deserialization.
//
// RFC 8259 says names SHOULD be unique but leaves the behaviour for duplicates
// to the implementation. Wado rejects them: a repeat is how two readers of the
// same bytes are made to disagree — an authorizing proxy acting on the first
// occurrence, the application on the last — so silently taking either one is
// the dangerous default. A format that wants leniency overrides
// `on_duplicate_key`.
use { Serialize, Deserialize, DeserializeErrorKind } from "core:serde";
use { from_string } from "core:json";

struct Point {
    x: f64,
    y: f64,
}

impl Deserialize for Point;

export fn run() {
    let dup = from_string::<Point>(`\{"x":1.0,"y":2.0,"x":99.0\}`);
    assert dup matches { Err(e) && e.kind == DeserializeErrorKind::DuplicateField };

    // Distinct fields still parse.
    let ok = from_string::<Point>(`\{"x":1.0,"y":2.0\}`);
    assert ok matches { Ok(p) && p.x == 1.0 && p.y == 2.0 };
}

__DATA__
{"stdout": ""}
