// A keyword is a key in an object literal, as it is a field name anywhere.
use { println, Stdout } from "core:cli";
use { TreeMap } from "core:collections";

export fn run() with Stdout {
    let m = { if: 1, true: 2, type: 3 } as TreeMap<String, i32>;
    println(`${m["if"]} ${m["true"]} ${m["type"]}`);
}

__DATA__
{"stdout": "1 2 3\n"}
