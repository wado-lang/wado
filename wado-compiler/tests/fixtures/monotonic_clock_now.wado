// Test MonotonicClock::now() from core:clocks
// Verifies that the monotonic clock returns non-decreasing values

use { println, Stdout } from "core:cli";
use { now, MonotonicClock } from "core:clocks";

export fn run() with Stdout, MonotonicClock {
    let t1 = now();
    let t2 = now();

    // Monotonic clock should return non-decreasing values
    if t2 >= t1 {
        println("monotonic: ok");
    } else {
        println("monotonic: FAILED");
    }
}

__DATA__
{"stdout": "monotonic: ok\n"}
