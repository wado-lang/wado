// Rank 0 ranks the impls of *one* trait against each other: a variadic impl
// yields to a non-variadic one of its own trait only. Against another trait's
// blanket at the same level it is the two-trait ambiguity, so neither
// `impl<T: Inspect> A for T` nor `impl<..T> B for [..T]` answers `[1, 2].go()`
// (issue #2650).

trait A with () {
    fn go(&self) -> String;
}

impl<T: Inspect> A for T {
    fn go(&self) -> String {
        return "blanket-A";
    }
}

trait B with () {
    fn go(&self) -> String;
}

impl<..T: Inspect> B for [..T] {
    fn go(&self) -> String {
        return "variadic-B";
    }
}

export fn run() {
    let pair = [1, 2];
    assert pair.go() == "variadic-B";
}

__DATA__
{"compile_error": "ambiguous method 'go': declared by 'A' and 'B'; name the trait", "compile_error_codes": ["AMBIGUOUS_CANDIDATE"]}
