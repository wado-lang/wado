// A reference to a call's result, or to a field of one, refers to a value of
// its own, as a `let` binding it would hold: neither a write through it reaches
// the storage the call read the value out of, nor a later write to that
// storage reaches it, wherever the reference is kept.
struct Item {
    text: String,
}

struct Items {
    items: List<Item>,
}

impl Items {
    fn get(&self, i: i32) -> Item {
        return self.items[i];
    }

    fn text(&self, i: i32) -> String {
        return self.items[i].text;
    }
}

fn append(s: &mut String) {
    s.push_str("!");
}

test "a write through the reference" {
    let mut n = Items { items: [Item { text: "abc" }] };
    let r = &mut n.text(0);
    r.push_str("!");
    append(&mut n.text(0));
    let f = &mut n.get(0).text;
    f.push_str("!");
    append(&mut n.get(0).text);
    assert *r == "abc!";
    assert *f == "abc!";
    assert n.items[0].text == "abc";
}

struct Holder {
    held: &String,
}

fn keep(r: &String) -> &String {
    return r;
}

test "a write to the storage" {
    let mut n = Items { items: [Item { text: "abc" }] };
    let r = &n.text(0);
    let f = &n.get(0).text;
    let tuple = [&n.text(0), 0];
    let holder = Holder { held: &n.text(0) };
    let kept = keep(&n.text(0));
    let other: String = "x";
    let mut assigned = &other;
    assigned = &n.text(0);
    n.items[0].text.push_str("!");
    assert *r == "abc";
    assert *f == "abc";
    assert *tuple.0 == "abc";
    assert *holder.held == "abc";
    assert *kept == "abc";
    assert *assigned == "abc";
}
