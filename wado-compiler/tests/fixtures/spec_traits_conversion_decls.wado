// The prelude's conversion and error traits, declared here under their own
// names and implemented for an even number.

struct Even { n: i32 }

struct Odd { n: i32 }

impl Display for Odd {
    fn fmt(&self, f: &mut Formatter) { f.write_str(`${self.n} is odd`); }
}

impl Error for Odd { }

impl From<i16> for Even {
    fn from(half: i16) -> Even { return Even { n: half as i32 * 2 }; }
}

impl TryFrom<i32> for Even {
    type Err = Odd;
    fn try_from(n: i32) -> Result<Even, Odd> {
        if n % 2 != 0 { return Err(Odd { n }); }
        return Ok(Even { n });
    }
}

pub affine trait From<T> with () {
    fn from(value: T) -> Self;
}

pub affine trait TryFrom<T> with () {
    type Err: Error;
    fn try_from(value: T) -> Result<Self, Self::Err>;
}

pub affine trait Error: Display with () {
}

test {
    assert Even::from(21 as i16).n == 42;
    assert Even::try_from(4).unwrap().n == 4;
    assert `${Even::try_from(3).unwrap_err()}` == "3 is odd";
}
