// An `impl` method that adds a receiver the trait does not declare is rejected
// where the arity mismatch beside it is: the call is built to the trait's
// shape, so the body reads an argument nothing pushed. Unreported it reached
// codegen and failed Wasm validation.

trait Mk {
    fn made(n: i32) -> i32;
}

struct M {}

impl Mk for M {
    fn made(&self, n: i32) -> i32 {
        return n;
    }
}

fn via<T: Mk>() -> i32 {
    return T::made(1);
}

export fn run() {
    assert via::<M>() == 1;
}

__DATA__
{"compile_error": "receiver"}
