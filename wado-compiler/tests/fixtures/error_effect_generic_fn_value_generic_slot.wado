// An expected type that is not a function type, here the slot of `id`'s `T`,
// settles no effect parameter.

fn apply<effect E>(f: fn() with E) with E {
    f();
}

fn id<T>(x: T) -> T {
    return x;
}

export fn run() {
    let f: fn(fn()) = id(apply);
}

