// Closure literals coerce to a `type Handler = fn(...)` newtype:
// 1. Closure passed as a function argument whose param is the newtype.
// 2. Closure on the rhs of a `let` whose annotation is the newtype.
// 3. Closure params are inferred from the underlying fn signature even
//    when the expected type is a newtype.

use { println, Stdout } from "core:cli";

type IntFn = fn(i32) -> i32;
type Reducer = fn(i32, i32) -> i32;

fn apply(f: IntFn, x: i32) -> i32 {
    return f(x);
}

fn fold(arr: List<i32>, init: i32, op: Reducer) -> i32 {
    let mut acc = init;
    for let v of arr {
        acc = op(acc, v);
    }
    return acc;
}

export fn run() with Stdout {
    // Case 1: closure literal as function argument with newtype param
    let doubled = apply(|n: i32| n * 2, 21);
    println(`{doubled}`);

    // Case 2: closure literal on rhs of `let` with newtype annotation
    let inc: IntFn = |n: i32| n + 1;
    println(`{inc(41)}`);

    // Case 3: closure with unannotated params, inferred via newtype expected
    let sum = fold([1, 2, 3, 4, 5] as List<i32>, 0, |a, b| a + b);
    println(`{sum}`);
}

__DATA__
{"stdout": "42\n42\n15\n"}
