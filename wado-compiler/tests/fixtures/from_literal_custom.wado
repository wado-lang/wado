// KeyValueLiteral: custom type implementing KeyValueLiteral trait
// Verifies that struct literal coercion is not hardcoded to TreeMap
use { println } from "core:cli";

struct LinearMap<V> {
    keys: List<String>,
    values: List<V>,
}

impl LinearMap<V> {
    fn new() -> LinearMap<V> {
        return LinearMap { keys: [], values: [] };
    }

    fn len(&self) -> i32 {
        return self.keys.len();
    }
}

impl KeyValueLiteralBuilder for LinearMap<V> {
    type Value = V;
    type Output = LinearMap<V>;

    fn new_literal(capacity: i32) -> LinearMap<V> {
        return LinearMap::<V>::new();
    }

    fn insert_literal(&mut self, key: String, value: Self::Value) {
        self.keys.push(key);
        self.values.push(value);
    }

    fn build(&self) -> LinearMap<V> {
        return *self;
    }
}

export fn run() with Stdout {
    // Type annotation coercion
    let m: LinearMap<i32> = { x: 10, y: 20, z: 30 };

    assert m.len() == 3;
    assert m.keys[0] == "x";
    assert m.keys[1] == "y";
    assert m.keys[2] == "z";
    assert m.values[0] == 10;
    assert m.values[1] == 20;
    assert m.values[2] == 30;

    println("custom KeyValueLiteral: ok");
}

__DATA__
{"stdout": "custom KeyValueLiteral: ok\n"}
