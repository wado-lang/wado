// A user-defined key-value target: struct-literal coercion is not hardcoded to
// TreeMap.
use { println, Stdout } from "core:cli";

struct LinearMap<V> {
    keys: List<String>,
    values: List<V>,
}

impl LinearMap<V> {
    fn new() -> LinearMap<V> {
        return LinearMap { keys: [], values: [] };
    }

    fn len(&self) -> i32 {
        return self.keys.len();
    }
}

impl From<Array<[String, V]>> for LinearMap<V> {
    fn from(entries: Array<[String, V]>) -> LinearMap<V> {
        let mut map = LinearMap::<V>::new();
        for let [key, value] of entries {
            map.keys.push(key);
            map.values.push(value);
        }
        return map;
    }
}

export fn run() with Stdout {
    // Type annotation coercion
    let m: LinearMap<i32> = { x: 10, y: 20, z: 30 };

    assert m.len() == 3;
    assert m.keys[0] == "x";
    assert m.keys[1] == "y";
    assert m.keys[2] == "z";
    assert m.values[0] == 10;
    assert m.values[1] == 20;
    assert m.values[2] == 30;

    println("custom key-value literal: ok");
}

__DATA__
{"stdout": "custom key-value literal: ok\n"}
