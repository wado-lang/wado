// A `&S` parameter split into its fields reads them at the call, after every
// argument has run. The reference itself is the one the argument read where it
// stands, so a later argument rebinding the local does not move the reads.

struct P2 {
    a: i32,
    b: i32,
}

#[inline("never")]
fn sum_plus(p: &P2, n: i32) -> i32 {
    return p.a + p.b + n;
}

export fn run() {
    let a = P2 { a: builtin::black_box(1), b: 2 };
    let b = P2 { a: builtin::black_box(10), b: 20 };
    let mut r = &a;
    assert sum_plus(r, then: { r = &b; 0 }) == 3;
    assert sum_plus(r, 0) == 30;
}

__DATA__
{
    "stdout": ""
}
