// Edge case: multiple mutable references (no borrow checker)

use { println, Stdout } from "core:cli";

fn increment(x: &mut i32) {
    *x = *x + 1;
}

fn run() with Stdout {
    let mut a = 10;
    increment(&mut a);
    increment(&mut a);
    increment(&mut a);
    println(`{a}`);
}

__DATA__
{"stdout": "13\n"}
