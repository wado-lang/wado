// `Type::m(recv, v)` binds an impl parameter only the trait reference names,
// as the method form does: `X::put(&x, 7 as i64)` reaches
// `impl<T: Show> Put<T> for X` at `T = i64`.
trait Show with () {
    fn show(&self) -> String;
}

impl Show for i64 {
    fn show(&self) -> String {
        return `i64 ${*self}`;
    }
}

impl Show for String {
    fn show(&self) -> String {
        return `string ${*self}`;
    }
}

trait Put<T> with () {
    fn put(&self, v: T) -> String;
}

struct X {}

impl<T: Show> Put<T> for X {
    fn put(&self, v: T) -> String {
        return v.show();
    }
}

trait Make<T> with () {
    fn make(v: T) -> Self;
}

struct Made {
    shown: String,
}

impl<T: Show> Make<T> for Made {
    fn make(v: T) -> Made {
        return Made { shown: v.show() };
    }
}

test {
    let x = X {};
    assert X::put(&x, 7 as i64) == "i64 7";
    assert X::put(&x, "s") == "string s";
}

test "an associated function takes the parameter from its argument" {
    assert Made::make(7 as i64).shown == "i64 7";
    assert Made::make("s").shown == "string s";
}

struct Wrap<W> {
    v: W,
    shown: String,
}

impl<W: Default, U: Show> Make<U> for Wrap<W> {
    fn make(u: U) -> Wrap<W> {
        return Wrap { v: W::default(), shown: u.show() };
    }
}

test "a turbofish on the receiver keys the parameter its argument settles" {
    let w = Wrap::<i32>::make(5 as i64);
    assert w.v == 0;
    assert w.shown == "i64 5";
    assert Wrap::<bool>::make("s").shown == "string s";
}
