// A slot no argument pins is reported, whichever spelling names the receiver.
// The namespaced branch never asked, so the call reached WIR build unresolved
// and was reported there as an unimplemented trait.

use lib from "./sub/error_static_namespaced_uninferred.wado";

trait Show<T> {
    fn show() -> i32;
}

impl<T> Show<T> for lib::Cell<T> {
    fn show() -> i32 {
        return 5;
    }
}

export fn run() {
    let _ = lib::Cell::show();
}

