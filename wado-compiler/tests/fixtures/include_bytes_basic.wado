use { println } from "core:cli";

export fn run() with Stdout {
    let data: List<u8> = #include_bytes("./testdata/binary.dat");
    assert data.len() == 5;
    assert data[0] == 72;  // 'H'
    assert data[1] == 101; // 'e'
    assert data[2] == 108; // 'l'
    assert data[3] == 108; // 'l'
    assert data[4] == 111; // 'o'
    println("ok");
}

__DATA__
{"stdout": "ok\n"}
