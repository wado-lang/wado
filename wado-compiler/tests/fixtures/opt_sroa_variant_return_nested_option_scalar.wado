// Test: a variant return whose payload is itself a variant stays boxed at the
// inner level, and the outer level is still scalarized.
//
// `Cursor::step` returns `Result<Option<i64>, StepErr>` (the serde
// `next_element<scalar>` shape). `optimize::sroa_variant_return` gives it
// `[outer_disc, ref Option<i64>, ref StepErr]` — the outer variant flattened,
// the inner `Option<i64>` left as one slot it still builds at each return.
//
// Splitting that slot into `[inner_disc, i64]` is what `wir_optimize`'s
// `slot_flatten` used to do, and it is deliberately not done here. Doing it in
// NIR was implemented and measured: the callee stops allocating, but a call
// site that binds the whole inner value has to rebuild it, and the rebuild cost
// nine times what the allocation did (+985 bytes against +113 on cbor_twitter).
// Recovering it needs the destructure pushed down into the call site, not the
// inner value reconstructed — see the WEP.
//
// `#[inline("never")]` keeps `step` a real SROA'd call site.
variant StepErr {
    Negative,
}

struct Cursor {
    data: List<i64>,
    pos: i32,
}

impl Cursor {
    #[inline("never")]
    fn step(&mut self) -> Result<Option<i64>, StepErr> {
        if self.pos >= self.data.len() {
            return Result::Ok(null);
        }
        let v = self.data[self.pos];
        if v < 0 {
            return Result::Err(StepErr::Negative);
        }
        self.pos += 1;
        return Result::Ok(Option::Some(v));
    }
}

fn sum_all(data: List<i64>) -> Result<i64, StepErr> {
    let mut cur = Cursor { data, pos: 0 };
    let mut total: i64 = 0;
    loop {
        let opt = cur.step()?;
        if let Some(v) = opt {
            total += v;
        } else {
            break;
        }
    }
    return Result::Ok(total);
}

export fn run() {
    let ok = sum_all([10, 20, 30, 40]);
    assert ok matches { Ok(100) };

    // Error path: `?` propagates `StepErr::Negative` through the flattened slot.
    let bad = sum_all([10, -5, 30]);
    assert bad matches { Err(StepErr::Negative) };

    // Empty: first `step()` yields `Ok(null)` → break → total 0.
    let empty = sum_all([] as List<i64>);
    assert empty matches { Ok(0) };
}

__DATA__
{
    "stdout": "",
    "wir_expect:O2": [
        "Cursor::step\" = fn(ref \"",
        "-> [i32, ref null \"core:prelude/types.wado//Option<i64>\", ref null \""
    ]
}
