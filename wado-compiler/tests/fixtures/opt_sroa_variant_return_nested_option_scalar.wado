// Test: a variant return whose payload is itself a variant is scalarized at
// both levels, leaving nothing of `Result<Option<i64>, StepErr>` boxed.
//
// `Cursor::step` returns `Result<Option<i64>, StepErr>` (the serde
// `next_element<scalar>` shape). `optimize::sroa_variant_return` flattens the
// outer variant to `[outer_disc, ref Option<i64>, ref StepErr]` and leaves the
// inner `Option<i64>` as one slot, still a real heap object: `i64` is not a GC
// ref, so the slot cannot erase to a nullable one.
//
// `wir_optimize`'s `slot_flatten` then splits that slot into
// `[inner_disc, i64]` against the `?`-unwrap at the call site, so `step`
// returns `[i32, i32, i64, ref null StepErr]` and `sum_all` binds the pieces
// directly. Splitting it in NIR instead was implemented and discarded: the
// callee stops allocating, but a call site that binds the whole inner value has
// to rebuild it, and the rebuild cost more than the allocation it removed. The
// destructure has to be pushed down into the call site, which is what the WIR
// pass does — see the WEP.
//
// `#[inline("never")]` keeps `step` a real SROA'd call site.
variant StepErr {
    Negative,
}

struct Cursor {
    data: List<i64>,
    pos: i32,
}

impl Cursor {
    #[inline("never")]
    fn step(&mut self) -> Result<Option<i64>, StepErr> {
        if self.pos >= self.data.len() {
            return Result::Ok(null);
        }
        let v = self.data[self.pos];
        if v < 0 {
            return Result::Err(StepErr::Negative);
        }
        self.pos += 1;
        return Result::Ok(Option::Some(v));
    }
}

fn sum_all(data: List<i64>) -> Result<i64, StepErr> {
    let mut cur = Cursor { data, pos: 0 };
    let mut total: i64 = 0;
    loop {
        let opt = cur.step()?;
        if let Some(v) = opt {
            total += v;
        } else {
            break;
        }
    }
    return Result::Ok(total);
}

export fn run() {
    let ok = sum_all([10, 20, 30, 40]);
    assert ok matches { Ok(100) };

    // Error path: `?` propagates `StepErr::Negative` through the flattened slot.
    let bad = sum_all([10, -5, 30]);
    assert bad matches { Err(StepErr::Negative) };

    // Empty: first `step()` yields `Ok(null)` → break → total 0.
    let empty = sum_all([] as List<i64>);
    assert empty matches { Ok(0) };
}

__DATA__
{
    "stdout": "",
    "wir_expect:O2": [
        "Cursor::step\" = fn(ref \"",
        "-> [i32, i32, i64, ref null \"opt_sroa_variant_return_nested_option_scalar.wado//StepErr\"]",
        "__n_discriminant",
        "__n_payload_0"
    ],
    "wir_not_expect:O2": [
        "Option<i64>"
    ]
}
