// A literal index into a tuple carrying a variadic pack. The pack's arity is
// unknown before monomorphization, so `all.0` was resolving to the pack type
// itself: `.1` reported a bogus "tuple has 1 elements", and `.0` typed the
// element as the whole substituted tuple — invisible at -O0 (a raw struct.get)
// but miscompiled once a rewrite substituted the folded value at that node.

fn tags<..T>(t: &[..T]) -> [String, String] {
    let all = [for let v of t { "tag" }];
    return [all.0, all.1];
}

fn lengths<..T>(t: &[..T]) -> i32 {
    let all = [for let v of t { 5 }];
    return all.0 + all.1 + all.2;
}

fn rendered<..T: Inspect>(t: &[..T]) -> String {
    let all = [for let v of t { `${v:?}` }];
    return all.1;
}

struct Point {
    x: i32,
    y: i32,
}

trait FirstName {
    fn first_name(&self) -> String;
}

impl<S: ReflectStruct<FieldTypes = [..F]>, ..F> FirstName for S {
    fn first_name(&self) -> String {
        let names = [for let f of ReflectStruct::<S>::members() { f.name() }];
        return names.0;
    }
}

test "a constant element of a pack comprehension survives its index" {
    assert tags(&[1, 2]) == ["tag", "tag"];
    assert tags(&["a", true]) == ["tag", "tag"];
}

test "a literal index past the first element resolves" {
    assert lengths(&[1, 2, 3]) == 15;
    assert rendered(&[1, "two"]) == "\"two\"";
}

test "a member walk's names are indexable" {
    assert Point { x: 1, y: 2 }.first_name() == "x";
}

__DATA__
{"test": {}}
