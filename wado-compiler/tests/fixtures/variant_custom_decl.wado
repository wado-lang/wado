// Test custom variant declaration parsing
// Note: Codegen for custom variants is not yet implemented, so we only test parsing

use { println, Stdout } from "core:cli";

// A simple variant with unit and payload cases
variant Color {
    Red,
    Green,
    Blue,
    Custom(i32, i32, i32),
}

// A generic variant
variant Maybe<T> {
    Just(T),
    Nothing,
}

fn run() with Stdout {
    // Just verify compilation succeeds with variant declarations
    // Note: Variant construction is not yet implemented
    println("variant parsing works");
}

__DATA__
{"stdout": "variant parsing works\n"}
