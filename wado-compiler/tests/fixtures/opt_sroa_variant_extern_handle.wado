// An extern handle is an `externref`, not a number, so the padding its slot in
// a scalarized `Option<Node>` takes is a null of that hierarchy. Padded as a
// number, the module failed to validate.
#[cm("wasi:demo/dom@0.1.0#node", linearity = "unrestricted", repr = "externref", classes = "0..=1")]
resource Node {}

struct Weight {
    value: f64,
}

#[inline("never")]
fn maybe(w: &mut Weight) -> Option<Node> {
    if w.value > 0.0 {
        return Option::Some(Node::backed_by(w));
    }
    return null;
}

#[inline("never")]
fn last_positive(ws: &mut List<Weight>) -> f64 {
    let mut found: Option<Node> = null;
    for let w of ws {
        if w.value > 0.0 {
            found = Option::Some(Node::backed_by(w));
        }
    }
    return match found {
        Some(n) => n.backing::<Weight>().unwrap().value,
        None => -1.0,
    };
}

test "a returned handle round-trips" {
    let mut heavy = builtin::black_box(Weight { value: 2.5 });
    assert maybe(&mut heavy) matches { Some(n) && n == Node::backed_by(&mut heavy) };
    assert maybe(&mut builtin::black_box(Weight { value: -2.5 })) matches { None };
}

test "a handle local round-trips" {
    let ws: List<Weight> = [Weight { value: 1.5 }, Weight { value: -1.0 }, Weight { value: 3.5 }, Weight { value: -2.0 }];
    assert last_positive(&mut builtin::black_box(ws)) == 3.5;
    let none: List<Weight> = [Weight { value: -1.0 }];
    assert last_positive(&mut builtin::black_box(none)) == -1.0;
}

__DATA__
{"test": {}}
