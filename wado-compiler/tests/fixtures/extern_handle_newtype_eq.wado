// A newtype over an extern handle compares as the handle does: by what object
// it is, not as a scalar.
#[cm("example:demo/node", linearity = "unrestricted", repr = "externref")]
resource Node {}

type Marked = Node;

struct Tag {
    name: String,
}

fn same(a: Marked, b: Marked) -> bool {
    return a == b;
}

test "a newtype over a handle is equal as the handle is" {
    let a = Node::backed_by(Tag { name: "a" });
    let b = Node::backed_by(Tag { name: "b" });
    let first = a as Marked;
    assert same(first, a as Marked);
    assert !same(first, b as Marked);
    assert first != b as Marked;
}

__DATA__
{"test": {}}
