// Test: Interprocedural SROA patterns (struct → multi-value)
// Tests patterns where structs cross function boundaries.
// Uses #[inline(never)] to prevent inlining, isolating interprocedural patterns.

struct Point {
    x: i32,
    y: i32,
}

struct Vec3 {
    x: f64,
    y: f64,
    z: f64,
}

// Pattern 1: Function returns a struct, caller only uses fields
// Ideally the struct allocation could be eliminated by passing fields as multi-value

