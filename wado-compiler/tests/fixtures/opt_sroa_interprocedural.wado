#[inline("never")]
fn make_vec3(x: f64, y: f64, z: f64) -> Vec3 {
    return Vec3 { x, y, z };
}


#[inline("never")]
fn dot_product(a: Vec3, b: Vec3) -> f64 {
    return a.x * b.x + a.y * b.y + a.z * b.z;
}


#[inline("never")]
fn float_struct_ops() -> f64 {
    let a = make_vec3(1.0, 2.0, 3.0);
    let b = make_vec3(4.0, 5.0, 6.0);
    return dot_product(a, b);
}

// Pattern 5: Method call returning struct (common OOP pattern)
impl Point {
    fn offset(&self, dx: i32, dy: i32) -> Point {
        return Point { x: self.x + dx, y: self.y + dy };
    }
}


#[inline("never")]
fn method_returns_struct() -> i32 {
    let p = Point { x: 1, y: 2 };
    let q = p.offset(10, 20);
    return q.x + q.y;
}

export fn run() {
    assert use_returned_point() == 30;
    assert pass_struct_arg() == 10;
    assert chain_struct_ops() == 30;

    let dot = float_struct_ops();
    assert dot == 32.0;

    assert method_returns_struct() == 33;
}

