// A static function is called, never read: on a struct, on a resource and on
// a type named through a namespace alike, the path says what it names where
// it is written.
use { Fields } from "wasi:http";
use lib from "./sub/blanket_static_types_args_lib.wado";

struct Point { x: i32 }

impl Point {
    fn origin() -> Point { return Point { x: 0 }; }
}

export fn run() {
    let a = Point::origin;
    let b = Fields::new;
    let c = lib::P::origin;
}

