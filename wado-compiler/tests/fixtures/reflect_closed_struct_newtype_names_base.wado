// A newtype is closed because the struct it wraps is, so the note names that
// struct and its reach, not the newtype's.
use { to_string } from "core:json";

pub struct Closed {
    a: i32,
}

type Wrapped = Closed;

export fn run() {
    let _ = ReflectStruct::<Wrapped>::from_fields([0]);
    let _ = to_string(&(Closed { a: 0 } as Wrapped));
}

