// Test mutable floating point variables with reassignment

use {println, Stdout} from "core:cli";

fn main() with Stdout {
    let mut x = 1.0;

    if x == 1.0 {
        println("x is 1.0");
    }

    x = 2.5;

    if x == 2.5 {
        println("x is 2.5");
    }

    x = x + 0.5;

    if x == 3.0 {
        println("x is 3.0");
    }
}
