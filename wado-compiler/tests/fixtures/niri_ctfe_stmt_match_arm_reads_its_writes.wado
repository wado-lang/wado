// A statement-position `match` the compile-time interpreter settles runs the
// arm it selects. The arm reads `depth` after writing it, so folding the arm
// before running it reads the value from before the write: `depth == 0` stayed
// false at the `}`, the loop ran off the end, and the call folded to `None`.

fn probe(src: &StrSlice, i: i32, n: i32) -> Option<i32> {
    if i + 1 >= n {
        return null;
    }
    return match src.byte_at(i + 1) {
        b'/' => Option::Some(i + 2),
        _ => null,
    };
}

fn scan(src: &StrSlice, close: u8) -> Option<i32> {
    let n = src.len();
    let mut i = 1;
    let mut depth = 1;
    while i < n {
        if let Some(end) = probe(src, i, n) {
            i = end;
        } else if src.byte_at(i) == close {
            depth -= 1;
            i += 1;
            if depth == 0 {
                return Option::<i32>::Some(i);
            }
        } else {
            i += 1;
        }
    }
    return null;
}

test {
    let c = "{ x } rest".as_str_slice();
    assert scan(&c, b'}') matches { Some(5) };
}

__DATA__
{"test": {}}
