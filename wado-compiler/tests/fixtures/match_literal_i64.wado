// Test match expression with i64 literal patterns

use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let x: i64 = 42 as i64;
    let y: i64 = 0 as i64;
    let large: i64 = 1000000000000 as i64;

    let r1 = match x {
        0 => "zero",
        1 => "one",
        42 => "answer",
        _ => "other",
    };


    println(r1);

    let r2 = match y {
        0 => "zero",
        1 => "one",
        _ => "other",
    };


    println(r2);

    let r3 = match large {
        0 => "zero",
        1000000000000 => "trillion",
        _ => "other",
    };


    println(r3);
}

__DATA__
{"stdout": "answer\nzero\ntrillion\n"}
