// A generic hole is checked against the enclosing item's declared bounds at
// the template, under either form: a tag's pack bound, and `format`'s
// specifier trait as `${x}` reports it (WEP 2026-01-10).
fn tag<T: ReflectTemplate<Holes = [..V]>, ..V: Ord>(t: T) -> i32 {
    return 1;
}

fn sorted<X: Display>(x: X) -> i32 {
    return tag`${x}`;
}

fn shown<X>(x: X) -> String {
    return format`${x}`;
}

export fn run() {
    let _ = sorted(1);
    let _ = shown(1);
}

