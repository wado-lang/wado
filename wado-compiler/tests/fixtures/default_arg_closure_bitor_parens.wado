// Test: closure defaults can contain bitwise-or expressions when parenthesized.
// The bare `|` would terminate the closure parameter list, so `|` must be wrapped
// in parentheses inside a default.

export fn run() {
    let mask = |flags: i32 = (0x1 | 0x2)| flags;
    assert mask() == 3;
    assert mask(0x4) == 4;
}

