use { println, Stdout } from "core:cli";

// from match_guard_custom_variant.wado
variant Shape {
    Circle(f64),
    Rectangle([f64, f64]),
    Point,
}

// from match_guard_basic.wado
fn match_guard_basic() with Stdout {
    let x = 15;

    // Match with guard on literal pattern
    let result = match x {
        0 => "zero",
        n && n < 10 => "small",
        n && n < 20 => "medium",
        _ => "large",
    };
    println(result);

    // Guard that fails falls through to next arm
    let y = 5;
    let result2 = match y {
        n && n > 100 => "huge",
        n && n > 50 => "big",
        n && n > 10 => "medium",
        _ => "small",
    };
    println(result2);
}

// from match_guard_custom_variant.wado
fn match_guard_custom_variant() with Stdout {
    let s1 = Shape::Circle(5.0);
    let s2 = Shape::Circle(0.5);
    let s3 = Shape::Point;

    // Guard on custom variant with payload binding
    let desc1 = match s1 {
        Circle(r) && r > 1.0 => "big circle",
        Circle(_) => "small circle",
        Rectangle(_) => "rectangle",
        Point => "point",
    };
    println(desc1);

    let desc2 = match s2 {
        Circle(r) && r > 1.0 => "big circle",
        Circle(_) => "small circle",
        Rectangle(_) => "rectangle",
        Point => "point",
    };
    println(desc2);

    let desc3 = match s3 {
        Circle(r) && r > 1.0 => "big circle",
        Circle(_) => "small circle",
        Rectangle(_) => "rectangle",
        Point => "point",
    };
    println(desc3);
}

export fn run() with Stdout {
    match_guard_basic();
    match_guard_custom_variant();
}

__DATA__
{"stdout": "medium\nsmall\nbig circle\nsmall circle\npoint\n"}
