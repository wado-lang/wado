// Bug: undefined struct used as local variable type silently compiles standalone
// but produces Array<unknown>::push WIR error when imported cross-module.
// The compiler should report "unknown type 'MissingItem'" in both cases.
use lib from "./sub/undefined_struct_array_generated.wado";

test "cross module undefined struct in local" {
    let o = lib::make();
    assert o.value == 1;
}

__DATA__
{"compile_error": "unknown type 'MissingItem'"}
