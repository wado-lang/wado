// Regression: a `&self` method that returns a freshly-produced resource must
// NOT be treated as extracting the receiver's resource (WEP 2026-05-21). The
// receiver `h` is only borrowed, so `h.headers` stays owned and must be dropped
// at scope exit. The returned Fields is transferred into the Response, so the
// only owned Fields left to release is `h.headers` — if the extraction
// heuristic wrongly fired on the struct receiver, that drop would vanish.

use { Request, Response, ErrorCode, Fields, Trailers } from "wasi:http";

struct Holder {
    headers: Fields,
}

impl Holder {
    fn dup(&self) -> Fields {
        return Fields::new();
    }
}

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    let h = Holder { headers: Fields::new() };
    let headers = h.dup();

    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [response, _tx_future] = Response::new(headers, null, trailers_future);
    task return Result::<Response, ErrorCode>::Ok(response);
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

__DATA__
{"wasi:http/service": {"status": 200}, "wir_expect:O0": ["resource-drop:fields"]}
