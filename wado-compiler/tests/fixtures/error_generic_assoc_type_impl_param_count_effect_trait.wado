// An impl binds a generic associated type with as many parameters as the
// trait declares, whatever else the trait's header leaves unsettled.

trait Store<effect E> with () {
    type Pair<A, B>;
}

struct Lists {}

impl Store for Lists {
    type Pair<A> = List<A>;
}

export fn run() {}

