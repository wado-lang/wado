// Test: boolean identity folding eliminates redundant short-circuit operators.
//
// `false || x` folds to `x`, `true && x` folds to `x`.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn test_or_identity(x: bool) -> bool {
    return false || x;
}

#[inline(never)]
fn test_and_identity(x: bool) -> bool {
    return true && x;
}

export fn run() with Stdout {
    println(`{test_or_identity(true)}`);
    println(`{test_or_identity(false)}`);
    println(`{test_and_identity(true)}`);
    println(`{test_and_identity(false)}`);
}

__DATA__
{
    "stdout": "true\nfalse\ntrue\nfalse\n",
    "wir_expect:O2": ["return x;"],
    "wir_not_expect:O2": ["if x"]
}
