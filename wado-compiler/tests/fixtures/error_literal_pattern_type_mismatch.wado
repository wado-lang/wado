// A string pattern on an `i32` reached codegen unchecked and panicked in WIR
// build. Text answering `Eq<String>` is a match; `match_string_literal_text`
// pins that side.

test "a string pattern needs a scrutinee that compares with a String" {
    let n = 3;
    let k = match n {
        "---" => 1,
        _ => 0,
    };
    assert k == 0;
}

__DATA__
{"compile_error": "pattern mismatch: expected 'String', found 'i32'"}
