// A reference points to a place (spec-memory § Reference Identity). For an
// in-place type (a struct, `List`, `String` or tuple), an assignment to a
// place a reference may still read writes into the storage already there, so
// the reference reads the new value and is still `ref_eq` to the place
// (WEP 2026-10-13).
//
// The assignment used to point the place at a new object, leaving every
// earlier reference on the old one.
struct P {
    a: i32,
    b: i32,
}

struct H {
    p: P,
    tag: String,
}

impl P {
    fn sum(&self) -> i32 {
        return self.a + self.b;
    }
}

struct G {
    h: H,
}

struct E {}

fn reassign_through(h: &mut H, p: &P) -> i32 {
    h.p = P { a: 100, b: 200 };
    return p.sum();
}

fn make_reader(p: &P) -> fn() -> i32 {
    return || p.a;
}

// Each of these takes its new values from `n`, so no call in the body is
// what keeps the borrow observable.

fn nested_under_local(n: i32) -> i32 {
    let mut g = G { h: H { p: P { a: 1, b: 1 }, tag: "a" } };
    let hp = &g.h.p;
    g = G { h: H { p: P { a: 3, b: n }, tag: "b" } };
    return hp.sum();
}

fn nested_under_field(n: i32) -> i32 {
    let mut g = G { h: H { p: P { a: 1, b: 1 }, tag: "a" } };
    let hp = &g.h.p;
    g.h = H { p: P { a: 3, b: n }, tag: "b" };
    return hp.sum();
}

fn nested_under_element(n: i32) -> i32 {
    let mut gs: List<G> = [G { h: H { p: P { a: 1, b: 1 }, tag: "a" } }];
    let hp = &gs[0].h.p;
    gs[0] = G { h: H { p: P { a: 3, b: n }, tag: "b" } };
    return hp.sum();
}

fn field_of_element(n: i32) -> i32 {
    let mut hs: List<H> = [H { p: P { a: 1, b: 1 }, tag: "a" }];
    let r = &hs[0].p;
    hs[0].p = P { a: 3, b: n };
    return r.sum();
}

fn field_in_an_arm(n: i32) -> i32 {
    let mut h = H { p: P { a: 1, b: 1 }, tag: "a" };
    let hp = &h.p;
    match n {
        3 => h.p = P { a: 3, b: n },
        _ => {},
    }
    return hp.sum();
}

fn element_in_an_arm(n: i32) -> i32 {
    let mut xs: List<P> = [P { a: 1, b: 1 }];
    let r = &xs[0];
    match n {
        3 => xs[0] = P { a: 3, b: n },
        _ => {},
    }
    return r.sum();
}

fn element_in_a_closure(n: i32) -> i32 {
    let mut xs: List<P> = [P { a: 1, b: 1 }];
    let r = &xs[0];
    let mut set = |v: P| xs[0] = v;
    set(P { a: 3, b: n });
    return r.sum();
}

fn deferred_first_assigned_in_an_arm(n: i32) -> i32 {
    let mut x: P;
    match n {
        _ => x = P { a: 1, b: 1 },
    }
    let r = &x;
    x = P { a: 5, b: n };
    return r.sum();
}

fn reassigned_under_a_closure(n: i32) -> i32 {
    let mut x = P { a: 1, b: n };
    let f = make_reader(&x);
    x = P { a: 7, b: n };
    return f();
}

test "a place below the assigned one" {
    assert nested_under_local(3) == 6;
    assert nested_under_field(3) == 6;
    assert nested_under_element(3) == 6;
    assert field_of_element(3) == 6;
}

test "an assignment in expression position" {
    assert field_in_an_arm(3) == 6;
    assert element_in_an_arm(3) == 6;
    assert element_in_a_closure(3) == 6;
    assert deferred_first_assigned_in_an_arm(5) == 10;
}

// The new value is made of the old one's parts, so every part is read before
// any is written.
fn swap_under_a_field_ref(n: i32) -> i32 {
    let mut h = H { p: P { a: 1, b: 1 }, tag: "a" };
    let mut pair = [h.p, P { a: n, b: n }];
    let first = &pair.0;
    pair = [pair.1, pair.0];
    return first.sum() * 10 + pair.1.sum();
}

test "a value made of the place's own parts" {
    assert swap_under_a_field_ref(3) == 62;
}

test "a borrow a closure captured" {
    assert reassigned_under_a_closure(3) == 7;
}

test "a List element of a struct with no fields" {
    let mut es: List<E> = [E {}, E {}];
    let r = &es[0];
    es[0] = E {};
    let same = ref_eq(r, &es[0]);
    assert same;
}

test "a local" {
    let mut x = P { a: 1, b: 2 };
    let r = &x;
    x = P { a: 7, b: builtin::black_box(8) };
    assert r.sum() == 15;
    assert ref_eq(r, &x);
}

test "a struct field" {
    let mut h = H { p: P { a: 1, b: 1 }, tag: "a" };
    let hp = &h.p;
    let ht = &h.tag;
    h.p = P { a: 3, b: builtin::black_box(3) };
    h.tag = "b";
    assert hp.sum() == 6;
    assert *ht == "b";
}

test "a field reassigned inside a call" {
    let mut h = H { p: P { a: 1, b: 1 }, tag: "a" };
    let hp = &h.p;
    assert reassign_through(&mut h, hp) == 300;
}

test "a List and a String local" {
    let mut xs: List<i32> = [1, 2];
    let rx = &xs;
    xs = [3, 4, 5];
    assert rx.len() == 3;
    let mut s = "old";
    let rs = &s;
    s = "new";
    assert *rs == "new";
}

test "a tuple local" {
    let mut t = [1, "x"];
    let rt = &t;
    t = [2, "y"];
    assert rt.0 == 2;
}

test "a local declared without a value" {
    // `r` holds `x`'s storage from the previous turn, so each assignment after
    // the first writes in place, and the first has no storage to write into.
    let other = P { a: 0, b: 0 };
    let mut x: P;
    let mut r = &other;
    let mut seen = 0;
    for let i of 1..=3 {
        x = P { a: i, b: builtin::black_box(0) };
        seen += r.a;
        r = &x;
    }
    assert seen == 0 + 2 + 3;
}

fn assign_element(xs: &mut List<P>, i: i32, p: P) {
    xs[i] = p;
}

test "a List element" {
    let mut xs: List<P> = [P { a: 1, b: 1 }, P { a: 2, b: 2 }];
    let r = &xs[0];
    xs[0] = P { a: 7, b: builtin::black_box(7) };
    assert r.sum() == 14;
    assert xs[1].sum() == 4;
}

test "a List element that is a List" {
    let mut xss: List<List<i32>> = [[1], [2]];
    let r = &xss[1];
    xss[1] = [5, 6, 7];
    assert r.len() == 3;
}

test "a field of a List element" {
    let mut hs: List<H> = [H { p: P { a: 1, b: 1 }, tag: "a" }];
    let rp = &hs[0].p;
    let rt = &hs[0].tag;
    hs[0] = H { p: P { a: 4, b: builtin::black_box(4) }, tag: "b" };
    assert rp.sum() == 8;
    assert *rt == "b";
}

test "a List element an iterator holds" {
    let mut xs: List<P> = [P { a: 1, b: 1 }, P { a: 2, b: 2 }];
    let mut it = (&xs).into_iter();
    let first = it.next().unwrap();
    xs[0] = P { a: 5, b: builtin::black_box(5) };
    assert first.sum() == 10;
}

test "a List element assigned through a reference" {
    let mut xs: List<P> = [P { a: 1, b: 1 }];
    let r = &xs[0];
    assign_element(&mut xs, 0, P { a: 6, b: builtin::black_box(6) });
    assert r.sum() == 12;
}

test "a copy read out of a List element keeps its value" {
    let mut xs: List<P> = [P { a: 1, b: 1 }];
    let row = xs[0];
    let r = &xs[0];
    xs[0] = P { a: 3, b: builtin::black_box(3) };
    assert row.sum() == 2;
    assert r.sum() == 6;
}

#[expect_trap]
test "a List element past the end still traps" {
    let mut xs: List<P> = [P { a: 1, b: 1 }];
    let r = &xs[0];
    xs[builtin::black_box(1)] = P { a: 3, b: 3 };
    assert r.sum() == 2;
}

test "the assigned value stays a copy" {
    let mut x = P { a: 1, b: 2 };
    let r = &x;
    let mut y = P { a: 3, b: 4 };
    x = y;
    y.a = 99;
    assert r.a == 3;
    assert x.a == 3;
}
