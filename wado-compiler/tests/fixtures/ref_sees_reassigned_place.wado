// A reference points to a place (spec-memory § Reference Identity). For an
// in-place type (a struct, `List`, `String` or tuple), an assignment to a
// place a reference may still read writes into the storage already there, so
// the reference reads the new value and is still `ref_eq` to the place
// (WEP 2026-10-13).
//
// The assignment used to point the place at a new object, leaving every
// earlier reference on the old one.
struct P {
    a: i32,
    b: i32,
}

struct H {
    p: P,
    tag: String,
}

impl P {
    fn sum(&self) -> i32 {
        return self.a + self.b;
    }
}

fn reassign_through(h: &mut H, p: &P) -> i32 {
    h.p = P { a: 100, b: 200 };
    return p.sum();
}

test "a local" {
    let mut x = P { a: 1, b: 2 };
    let r = &x;
    x = P { a: 7, b: builtin::black_box(8) };
    assert r.sum() == 15;
    assert ref_eq(r, &x);
}

test "a struct field" {
    let mut h = H { p: P { a: 1, b: 1 }, tag: "a" };
    let hp = &h.p;
    let ht = &h.tag;
    h.p = P { a: 3, b: builtin::black_box(3) };
    h.tag = "b";
    assert hp.sum() == 6;
    assert *ht == "b";
}

test "a field reassigned inside a call" {
    let mut h = H { p: P { a: 1, b: 1 }, tag: "a" };
    let hp = &h.p;
    assert reassign_through(&mut h, hp) == 300;
}

test "a List and a String local" {
    let mut xs: List<i32> = [1, 2];
    let rx = &xs;
    xs = [3, 4, 5];
    assert rx.len() == 3;
    let mut s = "old";
    let rs = &s;
    s = "new";
    assert *rs == "new";
}

test "a tuple local" {
    let mut t = [1, "x"];
    let rt = &t;
    t = [2, "y"];
    assert rt.0 == 2;
}

test "a local declared without a value" {
    // `r` holds `x`'s storage from the previous turn, so each assignment after
    // the first writes in place, and the first has no storage to write into.
    let other = P { a: 0, b: 0 };
    let mut x: P;
    let mut r = &other;
    let mut seen = 0;
    for let i of 1..=3 {
        x = P { a: i, b: builtin::black_box(0) };
        seen += r.a;
        r = &x;
    }
    assert seen == 0 + 2 + 3;
}

test "the assigned value stays a copy" {
    let mut x = P { a: 1, b: 2 };
    let r = &x;
    let mut y = P { a: 3, b: 4 };
    x = y;
    y.a = 99;
    assert r.a == 3;
    assert x.a == 3;
}
