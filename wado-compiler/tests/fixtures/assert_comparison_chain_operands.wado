// A chain evaluates every operand, so a failure reports every one of them.
// The lower bound fails here and the message still names `used`, which is what
// a reader needs to see beside `index`.

export fn run() {
    let index = -1;
    let used = 3;
    assert 0 <= index < used, "index out of bounds";
}

__DATA__
{
    "trapped": true,
    "stderr_contains": [
        "condition: 0 <= index < used",
        "index: -1",
        "used: 3"
    ]
}
