// A user-defined effect's operation demands its interface, and a global
// initializer holds none, so the dispatch is rejected rather than trapping at
// module init.

use { println, Stdout } from "core:cli";

interface Counter {
    fn next() -> i32;
}

global COUNTED: i32 = Counter::next();

export fn run() with Stdout {
    println(`${COUNTED}`);
}

__DATA__
{
    "compile_error": ":11:23: analysis error: global initializer must be pure (no effects), but dispatches 'next', which needs a capability the position does not hold",
    "compile_error_codes": ["IMPURE_EXPRESSION"]
}
