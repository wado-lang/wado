// A struct-returning function whose call site passes the result by reference
// is not classified as multi-value: the reference take is an escape that
// disqualifies the candidate. `make_pair` has the same fresh literal for a
// body and only its fields are read, so it is.

struct Point {
    x: i32,
    y: i32,
}

#[inline("never")]
fn make_point(x: i32, y: i32) -> Point {
    return Point { x, y };
}

#[inline("never")]
fn make_pair(x: i32, y: i32) -> Point {
    return Point { x, y };
}

#[inline("never")]
fn value_use() -> i32 {
    let p = make_pair(builtin::black_box(1), builtin::black_box(2));
    return p.x + p.y;
}

#[inline("never")]
fn measure(p: &Point) -> i32 {
    return p.x + p.y;
}

#[inline("never")]
fn ref_use() -> i32 {
    // Opaque, or the call folds away and there is no candidate left to reject.
    let p = make_point(builtin::black_box(10), builtin::black_box(20));
    return measure(&p);
}

export fn run() {
    assert ref_use() == 30;
    assert value_use() == 3;
}

__DATA__
{
    "stdout": "",
    "wir_pass": {"O2": ["nir/multi_value_return"]},
    "wir_expect:O2": ["make_pair\" = fn(i32, i32) -> [i32, i32]"],
    "wir_guard": {
        "O2": {
            "expect": ["make_point\" = fn(i32, i32) -> ref"],
            "not_expect": ["make_point\" = fn(i32, i32) -> [i32, i32]"]
        }
    }
}
