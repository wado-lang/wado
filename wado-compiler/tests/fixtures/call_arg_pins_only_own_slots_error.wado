// An argument answers only the callee's own slots. A hole someone else
// deferred has its own sink, which nothing re-checks against an answer pinned
// here.
//
// `make()` defers `T`. Answering it from `push(1)` would fix the list to
// `List<i32>` and then push an `i64` into it.

fn make<T>() -> List<T> {
    return [];
}

test "an argument does not answer a hole the receiver deferred" {
    let mut xs = make();
    xs.push(1);
    let y: i64 = 5;
    xs.push(y);
    assert xs.len() == 2;
}

__DATA__
{"test": {}, "compile_error": "cannot infer type parameter `T` of function `make`"}
