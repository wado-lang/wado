use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

// Rebinding a mut struct param does not affect the caller's binding.
fn zero_out(mut p: Point) -> Point {
    p = Point { x: 0, y: 0 };
    return p;
}

export fn run() with Stdout {
    let p = Point { x: 5, y: 10 };
    let q = zero_out(p);
    assert q.x == 0;
    assert q.y == 0;
    assert p.x == 5; // caller's variable is unchanged
    assert p.y == 10;
    println("ok");
}

__DATA__
{"stdout": "ok\n"}
