// Multiple methods in one impl block

use {println} from "core:cli";

struct Counter {
    value: i32,
    step: i32,
}

impl Counter {
    pub fn get(&self) -> i32 {
        return self.value;
    }

    pub fn get_step(&self) -> i32 {
        return self.step;
    }

    pub fn double(&self) -> i32 {
        return self.value * 2;
    }

    pub fn add_step(&self) -> i32 {
        return self.value + self.step;
    }
}

fn run() with Stdout {
    let c = Counter { value: 10, step: 3 };
    println(`value: {c.get()}`);
    println(`step: {c.get_step()}`);
    println(`double: {c.double()}`);
    println(`add_step: {c.add_step()}`);
}

__DATA__
{"stdout": "value: 10\nstep: 3\ndouble: 20\nadd_step: 13\n"}
