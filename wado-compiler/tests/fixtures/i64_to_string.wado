// Test i64 to string conversion via template strings
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let x: i64 = 123456789012345 as i64;
    println(`i64: ${x}`);

    let y: i64 = -987654321 as i64;
    println(`negative: ${y}`);

    let z: i64 = 0 as i64;
    println(`zero: ${z}`);
}

__DATA__
{"stdout": "i64: 123456789012345\nnegative: -987654321\nzero: 0\n"}
