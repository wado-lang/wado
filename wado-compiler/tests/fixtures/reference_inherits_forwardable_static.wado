// A receiverless method has no receiver to auto-deref, so `&T` inherits it by
// forwarding to `T`'s — the bound and the dispatch alike, which forward exactly
// when `Self` is absent. `error_reference_bound_receiverless.wado` pins the no.
use { println } from "core:cli";

struct P {
    n: i32,
}

trait Named {
    fn name(&self) -> String;

    fn kind() -> String;
}

impl Named for P {
    fn name(&self) -> String {
        return "p";
    }

    fn kind() -> String {
        return "P";
    }
}

fn show<T: Named>(t: T) -> String {
    return t.name();
}

fn kind_of<T: Named>(t: T) -> String {
    return T::kind();
}

export fn run() with Stdout {
    let p = P { n: 1 };
    assert show(&p) == "p";
    assert kind_of(&p) == "P";
    println(`${show(&p)} ${show(P { n: 2 })} ${kind_of(&p)} ${kind_of(P { n: 3 })}`);
}

__DATA__
{"stdout": "p p P P\n"}
