// A closure's row selects among impls differing only in it once its body is
// walked, which a method call waits for and a trait-qualified call does not.
use { println, Stdout } from "core:cli";

trait Take<F> with _ {
    fn take(&self, f: F) -> i32;
}

struct S {}

impl Take<fn()> for S {
    fn take(&self, f: fn()) -> i32 {
        return 1;
    }
}

impl Take<fn() with Stdout> for S {
    fn take(&self, f: fn() with Stdout) -> i32 {
        return 2;
    }
}

export fn run() with Stdout {
    let s = S {};
    println(`${Take::take(&s, || {})}`);
}

