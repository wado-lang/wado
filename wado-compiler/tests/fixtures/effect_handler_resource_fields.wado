// TDD red: handlers for wasi:http resources (Fields).
//
// Per WEP-2026-04-11-effect-handler.md (Implementation Status):
//   "[ ] Today the dispatch synthesis only routes user-declared
//        `effect E` decls; resources (`resource Stream<T>`) live on a
//        separate track ... requires extending `build_effect_index` /
//        `build_handler_impl_index` to walk resources too, plus
//        teaching the call-site rewriter to intercept resource method
//        calls (`stream.read(max)`) the way it currently intercepts
//        effect-op calls (`Effect::op(args)`)."
//
// This fixture exercises the missing path on a real CM resource:
//   1. Static-method dispatch through a handler:
//      `Fields::new()` inside the `with` body must reach the user
//      handler's `new` rather than the wasi:http CM adapter directly.
//   2. Instance-method dispatch through a handler:
//      `f.has(name)` must reach the handler's `has`, not the resource
//      method's CM adapter.
//   3. Self-delegation to the outer (real) handler:
//      The handler bodies call `Fields::new()` / `this.has(name)`,
//      which Phase 4's outer-chain restoration must route to the
//      wasmtime-provided implementation, exactly as for user-declared
//      effects (see effect_handler_self_delegation.wado).
//
// Until resource handler dispatch lands, this test is expected to fail
// (compile-time or assertion-time). Once implemented, both globals
// will read 1 and 2 respectively because the handler intercepts each
// call before delegating.

use { Request, Response, ErrorCode, Fields, FieldName, Trailers } from "wasi:http";

global mut new_count: i32 = 0;
global mut has_count: i32 = 0;

struct CountingFields {
    _phantom: i32,
}

impl Fields for CountingFields {
    fn new(&self) -> Fields {
        new_count += 1;
        let real = Fields::new();
        resume real
    }
    fn has(&self, this: &Fields, name: FieldName) -> bool {
        has_count += 1;
        resume this.has(name)
    }
    ..
}

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    let counter = CountingFields { _phantom: 0 };
    with Fields => &counter do {
        let f = Fields::new();
        let _a = f.has("x-test" as FieldName);
        let _b = f.has("x-test" as FieldName);
    }

    assert new_count == 1;
    assert has_count == 2;

    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let response_headers = Fields::new();
    let [response, _tx_future] = Response::new(response_headers, null, trailers_future);
    task return Result::<Response, ErrorCode>::Ok(response);
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

__DATA__
{"wasi:http/service": {"status": 200}}
