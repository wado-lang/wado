// A field read out of a temporary leaves the temporary to drop when its
// statement ends (WEP: Affine Types), whether the read is bound or passed on.
// The optimizer removed a read it saw unused, and the drop with it.

use { println, log_stdout, Stdout } from "core:cli";

affine struct Tok {
    n: i32,
}

impl Drop for Tok {
    fn drop(self) {
        log_stdout(`drop ${self.n}`);
    }
}

fn make(n: i32) -> Tok {
    return Tok { n };
}

fn show(n: i32) with Stdout {
    println(`n=${n}`);
}

export fn run() with Stdout {
    let x = make(1).n;
    show(make(2).n);
    println("end");
}

__DATA__
{"stdout": "drop 1\nn=2\ndrop 2\nend\n"}
