// Location literals (`#file` / `#line` / `#function`) used as default arguments
// must evaluate at the CALL SITE, not where the default is written (the lib
// module). This mirrors Swift's `#file`/`#line` default parameters and C++'s
// `std::source_location::current()`. Name resolution in a default still uses
// the callee's scope — only the location literals are special-cased.

use { loc } from "./sub/default_arg_location_call_site_lib.wado";

fn call_here() -> [String, i32, String] {
    return loc(); // call site: this is line 10
}

test "location literal defaults evaluate at the call site" {
    let [file, line, fun] = call_here();
    // `#file` is the caller's module, not the lib that declares the default.
    assert file.ends_with("default_arg_location_call_site.wado");
    assert !file.contains("lib.wado");
    // `#line` is the call-site line (10), not the line of `#line` in the lib.
    assert line == 10;
    // `#function` is the calling function.
    assert fun == "call_here";
}

__DATA__
{"test": {}}
