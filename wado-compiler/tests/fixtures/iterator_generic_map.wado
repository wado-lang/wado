// Test: generic map iterator wrapping any Iterator via trait bound

pub struct GenericMapIter<I: Iterator, U> {
    pub inner: I,
    pub f: fn(I::Item) -> U,
}

impl<I: Iterator, U> Iterator for GenericMapIter<I, U> {
    type Item = U;

    fn next(&mut self) -> Option<Self::Item> {
        if let Some(item) = self.inner.next() {
            return Option::Some((self.f)(item));
        }
        return null;
    }
}

export fn run() {
    let arr: List<i32> = [1, 2, 3];
    let mut iter = GenericMapIter { inner: arr.iter(), f: |x: i32| x * 2 };
    let a = iter.next();
    assert a matches { Some(2) };
    let b = iter.next();
    assert b matches { Some(4) };
    let c = iter.next();
    assert c matches { Some(6) };
    let d = iter.next();
    assert d matches { None };
}

