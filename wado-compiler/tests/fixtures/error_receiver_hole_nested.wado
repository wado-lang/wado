// A static call's receiver takes a `_` only for a whole type argument.

struct Bx<T> {
    v: T,
}

impl<T> Bx<T> {
    fn make(v: T) -> Bx<T> {
        return Bx { v };
    }
}

export fn run() {
    let _b = Bx::<List<_>>::make(["x"]);
}

