// A unit global is accepted — Rust accepts `static X: () = ();` — and gets no
// Wasm slot, the way a unit local or parameter gets none. Both its initializer
// and a later assignment still run for their effects.
use { println, Stdout } from "core:cli";

fn announce(tag: String) with Stdout {
    println(tag);
}

fn take(u: ()) -> i32 {
    return 7;
}

global READY: () = announce(`init`);
global mut LATER: () = ();

export fn run() with Stdout {
    let _ = READY;
    LATER = announce(`assigned`);
    println(`${take(LATER)}`);
}

__DATA__
{
    "stdout": "init\nassigned\n7\n"
}
