// A default naming a parameter at or after its own slot is ill-formed on the
// declaration, whether or not anything applies it, whatever declares it.

struct Fwd<A = B, B = i32> {
    v: B,
}

variant Own<A = A> {
    V(i32),
}

type Later<A = B, B = i32> = List<A>;

fn free<C = D, D = i32>() -> i32 {
    return 1;
}

trait Tr<E = F, F = i32> {
    fn method<G = H, H = i32>(&self) -> i32;
}

struct Host {}

impl Host {
    fn assoc<K = L, L = i32>() -> i32 {
        return 1;
    }
}

export fn run() {
    struct Local<M = N, N = i32> {
        v: i32,
    }
    if true {
        struct Nested<P = Q, Q = i32> {
            v: i32,
        }
    }
}

