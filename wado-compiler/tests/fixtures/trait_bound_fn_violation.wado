// Test trait bound violation on function type parameters
trait Display {
    fn display(&self) -> String;
}

fn show<T: Display>(x: T) -> String {
    return x.display();
}

struct Foo {}

export fn run() {
    // Foo does not implement Display
    let s = show::<Foo>(Foo {});
}

__DATA__
{"compile_error": "does not implement trait 'Display'"}
