// Output between two accesses keeps the later check where it is: widening the
// first would trap before `before` is printed.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn split(xs: &List<i32>, i: i32) -> i32 with Stdout {
    let a = xs[i];
    println("before");
    return a + xs[i + 2];
}

export fn run() with Stdout {
    let xs: List<i32> = builtin::black_box([1, 2, 3]);
    let _ = split(&xs, builtin::black_box(1));
}

__DATA__
{"stdout": "before\n", "trapped": true}
