use { println, Stdout } from "core:cli";

enum Color {
    Red,
    Green,
    Blue,
}

export fn run() with Stdout {
    let r = Color::Red;
    println(`{r:?}`);

    let g = Color::Green;
    println(`{g:?}`);

    let b = Color::Blue;
    println(`{b:?}`);
}

__DATA__
{"stdout": "Color::Red\nColor::Green\nColor::Blue\n"}
