//! Regression (issue #1977): a `trait` static's parameter default is declared
//! on the trait, so the `impl`'s signature carries none. Every
//! `Type::method()` spelling read that signature and rejected an omitted
//! argument for arity instead of padding it. What the impl inherits is the
//! trait's whole parameter list — names, defaults, and the module they resolve
//! in — because a default may name the trait's module or an earlier parameter.

use { Tag } from "./sub/default_arg_trait_static_lib.wado";

trait Make {
    fn made(value: i32 = 0) -> i32;
    fn pair(a: i32, b: i32 = 2) -> i32;
}

struct Marker {}

impl Make for Marker {
    fn made(value: i32) -> i32 {
        return value + 1;
    }

    fn pair(a: i32, b: i32) -> i32 {
        return a * b;
    }
}

impl Marker {
    fn twice() -> i32 {
        return Self::made() + Self::made(4);
    }
}

struct Boxed<T> {
    value: T,
}

impl Make for Boxed<i32> {
    fn made(value: i32) -> i32 {
        return value + 10;
    }

    fn pair(a: i32, b: i32) -> i32 {
        return a + b;
    }
}

impl Tag for Marker {
    fn tagged(k: i32) -> i32 {
        return k * 2;
    }
}

// The default `Tag` declares calls this name in *its* module, where it answers
// 3. This one is what the call site sees; padding under the wrong module takes
// it, and the assertions below say which module answered.
fn origin() -> i32 {
    return 100;
}

trait Spread {
    fn spread(a: i32, b: i32 = a + 1) -> i32;
}

impl Spread for Marker {
    // Renamed: the trait's default names the trait's `a`, not this block's `x`.
    fn spread(x: i32, y: i32) -> i32 {
        return x * 100 + y;
    }
}

trait Ready {}

trait Blanketed {
    fn built(n: i32 = 7) -> i32;
}

struct Plain {}

impl Ready for Plain {}

// A blanket impl declares its statics under its receiver parameter, so no
// receiver-keyed lookup reaches them.
impl<X: Ready> Blanketed for X {
    fn built(n: i32) -> i32 {
        return n * 3;
    }
}

test "trait static fills omitted defaults" {
    assert Marker::made() == 1;
    assert Marker::made(7) == 8;
    assert Marker::pair(3) == 6;
    assert Marker::pair(3, 4) == 12;
    assert Marker::twice() == 6;
}

test "a cross-module default resolves in the trait's module" {
    assert origin() == 100;
    assert Marker::tagged() == 6;
    assert Marker::tagged(5) == 10;
}

test "a default naming an earlier parameter survives a renamed impl" {
    assert Marker::spread(3) == 304;
    assert Marker::spread(3, 9) == 309;
}

test "a blanket impl's static fills omitted defaults" {
    assert Plain::built() == 21;
    assert Plain::built(2) == 6;
}

test "trait static on a generic target fills omitted defaults" {
    assert Boxed::<i32>::made() == 10;
    assert Boxed::<i32>::pair(1) == 3;
    assert Boxed::<i32>::pair(1, 5) == 6;
}
