// Type pack expansion mixed with regular elements: [42, ..T::method(), true]
trait MakeDefault {
    fn make_default() -> Self;
}

impl MakeDefault for i32 {
    fn make_default() -> i32 {
        return 0;
    }
}

impl MakeDefault for String {
    fn make_default() -> String {
        return "";
    }
}

fn make_with_bookends<..T: MakeDefault>() -> [i32, ..T, bool] {
    return [42, ..T::make_default(), true];
}

export fn run() {
    let result = make_with_bookends::<[i32, String]>();
    assert result.0 == 42;
    assert result.1 == 0;
    assert result.2 == "";
    assert result.3 == true;
}

__DATA__
{"stdout": ""}
