// A half orders as f32 does on the widened values: every NaN is one value and
// greatest, and the two zeroes are one value. The operators, `cmp` and `sort`
// all read that one order.

global F16_POS_NAN: u16 = 0x7E00;
global F16_NEG_NAN: u16 = 0xFE00;
global F16_POS_INF: u16 = 0x7C00;
global F16_NEG_ZERO: u16 = 0x8000;
global F16_ONE: u16 = 0x3C00;

export fn run() {
    let pos_nan = f16::from_bits(F16_POS_NAN);
    let neg_nan = f16::from_bits(F16_NEG_NAN);
    let pos_inf = f16::from_bits(F16_POS_INF);
    let neg_zero = f16::from_bits(F16_NEG_ZERO);
    let pos_zero = f16::from_bits(0);
    let one = f16::from_bits(F16_ONE);

    // Every NaN is greatest, whichever NaN and whichever side it is on.
    assert !(neg_nan < pos_inf);
    assert !(neg_nan <= pos_inf);
    assert pos_inf < pos_nan;
    assert pos_inf <= pos_nan;
    assert neg_nan > pos_inf;
    assert neg_nan >= pos_inf;
    assert !(pos_nan < neg_nan);
    assert pos_nan <= neg_nan;
    assert pos_nan == neg_nan;
    assert pos_nan.is_nan();

    // The two zeroes are one value.
    assert !(neg_zero < pos_zero);
    assert !(pos_zero < neg_zero);
    assert neg_zero == pos_zero;
    assert neg_zero <= pos_zero;
    assert pos_zero >= neg_zero;

    // Ordinary values order as they do in f32.
    assert neg_zero < one;
    assert one < pos_inf;
    assert pos_inf > one;
    assert one >= one;

    // `cmp` answers as the operators do.
    assert neg_nan.cmp(&pos_inf) matches { Greater };
    assert pos_nan.cmp(&neg_nan) matches { Equal };
    assert neg_zero.cmp(&pos_zero) matches { Equal };

    // A sort puts the NaNs last, each pair of equals in input order.
    let mut xs: List<f16> = [pos_inf, neg_zero, pos_nan, one, neg_nan, pos_zero];
    xs.sort();
    assert xs[0].to_bits() == F16_NEG_ZERO;
    assert xs[1].to_bits() == 0x0000;
    assert xs[2].to_bits() == F16_ONE;
    assert xs[3].to_bits() == F16_POS_INF;
    assert xs[4].to_bits() == F16_POS_NAN;
    assert xs[5].to_bits() == F16_NEG_NAN;

    // A body generic over `T: Ord` answers what the concrete type does.
    assert bound_less(pos_inf, neg_nan);
    assert !bound_less(neg_nan, pos_inf);
    assert !bound_less(neg_zero, pos_zero);

    // bf16 answers the same way.
    let b_nan = bf16::from_bits(0x7FC0);
    let b_neg_nan = bf16::from_bits(0xFFC0);
    let b_inf = bf16::from_bits(0x7F80);
    assert b_inf < b_nan;
    assert b_nan >= b_inf;
    assert b_nan == b_neg_nan;
    assert b_nan.cmp(&b_neg_nan) matches { Equal };
    assert bf16::from_bits(0x8000) == bf16::from_bits(0x0000);
    assert !(bf16::from_bits(0x8000) < bf16::from_bits(0x0000));
    assert bound_less(b_inf, b_neg_nan);
}

fn bound_less<T: Ord>(a: T, b: T) -> bool {
    return a < b;
}

__DATA__
{}
