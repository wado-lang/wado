// Return tuple variable from function

use { println, Stdout } from "core:cli";

fn get_pair() -> [i32, String] {
    let t: [i32, String] = [42, "hello"];
    return t;
}

export fn run() with Stdout {
    let pair = get_pair();
    println(`{pair.0}, {pair.1}`);
}

__DATA__
{"stdout": "42, hello\n"}
