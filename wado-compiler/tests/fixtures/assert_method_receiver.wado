// A method call's receiver is not captured: the line for the call follows the
// condition with nothing between them.

struct Counter {
    n: i32,
}

impl Counter {
    fn get(&self) -> i32 {
        return self.n;
    }
}

export fn run() {
    let p = Counter { n: 7 };
    assert p.get() == 99;
}

__DATA__
{
    "trapped": true,
    "stderr_contains": ["condition: p.get() == 99\np.get(): 7\n"]
}
