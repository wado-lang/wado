// A future's readable end is read once, so the read consumes it, and a second
// read is a use after move (WEP: Affine Types).

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let [rx, tx] = Future::<i32>::new();
    tx.write(1);
    let first = rx.read();
    let second = rx.read();
    println(`${first:?} ${second:?}`);
}

__DATA__
{"compile_error": ":10:18: analysis error: affine value `rx` used after it was moved (moved at 9:17)"}
