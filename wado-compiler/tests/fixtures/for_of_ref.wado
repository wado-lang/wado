use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

fn test_for_of_ref_array() with Stdout {
    // for let x of &arr should give x: &i32
    let arr: List<i32> = [10, 20, 30];
    let mut sum = 0;
    for let x of &arr {
        sum += *x;
    }
    assert sum == 60;
    println("ok");
}

fn test_for_of_ref_struct() with Stdout {
    // for let p of &points should give p: &Point
    let points: List<Point> = [
        Point { x: 1, y: 2 },
        Point { x: 3, y: 4 },
    ];
    let mut sum = 0;
    for let p of &points {
        sum += p.x + p.y;
    }
    assert sum == 10;
    println("ok");
}

fn test_for_of_ref_var() with Stdout {
    // When the variable itself has type &List<T>
    let arr: List<i32> = [1, 2, 3];
    let ra = &arr;
    let mut sum = 0;
    for let x of ra {
        // x should be &i32 because ra is &List<i32>
        sum += *x;
    }
    assert sum == 6;
    println("ok");
}

fn test_for_of_value_unchanged() with Stdout {
    // Regular for-of should still yield T (not &T)
    let arr: List<i32> = [1, 2, 3];
    let mut sum = 0;
    for let x of arr {
        sum += x;
    }
    assert sum == 6;
    println("ok");
}

export fn run() with Stdout {
    test_for_of_ref_array();
    test_for_of_ref_struct();
    test_for_of_ref_var();
    test_for_of_value_unchanged();
}

__DATA__
{"stdout": "ok\nok\nok\nok\n"}
