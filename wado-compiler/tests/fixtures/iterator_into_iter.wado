// Test IntoIterator trait with Array
// TODO: Blocked by compiler bug - generic trait methods returning Option<Self::Item>
// where Self::Item is bound to a type parameter T don't resolve correctly.
use {println, Stdout} from "core:cli";

fn run() with Stdout {
    let arr: Array<i32> = [1, 2, 3];

    // Test into_iter() explicitly
    let mut iter = arr.into_iter();

    let mut sum = 0;
    loop {
        if let Some(x) = iter.next() {
            sum += x;
        } else {
            break;
        }
    }

    println(`sum: {sum}`);
}

