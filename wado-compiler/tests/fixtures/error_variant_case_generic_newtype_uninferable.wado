// A case reached through a generic newtype with nothing to settle a parameter
// reports it once: the variant's where the base reaches it, else the newtype's.

variant G<T> { J(T), N }
type Wrap<T> = G<T>;
type Tag<T> = G<i32>;

export fn run() {
    let w = Wrap::N;
    let t = Tag::N;
}

