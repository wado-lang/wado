// A suffix types a numeric literal: `255_u8` is a `u8` whatever its context
// expects, checked as `let x: u8 = 255` would be.

trait Named with () {
    fn name() -> String;
}

impl Named for i8 {
    fn name() -> String { return "i8"; }
}
impl Named for i16 {
    fn name() -> String { return "i16"; }
}
impl Named for i32 {
    fn name() -> String { return "i32"; }
}
impl Named for i64 {
    fn name() -> String { return "i64"; }
}
impl Named for i128 {
    fn name() -> String { return "i128"; }
}
impl Named for u8 {
    fn name() -> String { return "u8"; }
}
impl Named for u32 {
    fn name() -> String { return "u32"; }
}
impl Named for u128 {
    fn name() -> String { return "u128"; }
}
impl Named for bf16 {
    fn name() -> String { return "bf16"; }
}
impl Named for f32 {
    fn name() -> String { return "f32"; }
}
impl Named for f64 {
    fn name() -> String { return "f64"; }
}

fn name_of<T: Named>(x: T) -> String {
    return T::name();
}

test "a suffix names the literal's type" {
    assert name_of(255_u8) == "u8";
    assert name_of(1_000_000_i64) == "i64";
    assert name_of(1.5_f32) == "f32";
    assert name_of(0xFF_u8) == "u8";
    assert name_of(0b1010_i16) == "i16";
    assert name_of(0o17_u32) == "u32";
    assert name_of(1_f64) == "f64";
    assert name_of(1e3_i32) == "i32";
    assert name_of(1.5e3_f32) == "f32";
    assert name_of(2_bf16) == "bf16";
    assert name_of(-128_i8) == "i8";
    assert name_of(170141183460469231731687303715884105727_i128) == "i128";
    assert name_of(1_u128) == "u128";
}

test "a suffixed literal holds the value it spells" {
    let byte = 255_u8;
    assert byte as i32 == 255;
    let low = -128_i8;
    assert low as i32 == -128;
    let half = 1.5_f32;
    assert half as f64 == 1.5;
    assert 1_f64 == 1.0;
    assert 2_bf16 == bf16::from_f64(2.0);
    assert 340282366920938463463374607431768211455_u128 == u128::MAX;
    assert -170141183460469231731687303715884105728_i128 == i128::MIN;
}

// In a hex literal `b` and `f` are digits, so a float suffix cannot be written.
test "a hex literal reads b and f as digits" {
    assert 0x1_f32 == 0x1F32;
    assert name_of(0x1_bf16) == "i32";
}

test "an operand beside a suffixed literal takes its type" {
    let wide = 1_i64 << 40;      // an i64: `1 << 40` alone is an i32
    assert wide == 1_099_511_627_776;
    assert name_of(1_u8 + 2) == "u8";
    assert name_of(2 * 1.5_f32) == "f32";
}

test "a suffixed literal is a pattern of its type" {
    let x: u8 = builtin::black_box(255);
    let k = match x {
        255_u8 => 1,
        _ => 0,
    };
    assert k == 1;
    let w: i128 = builtin::black_box(-5);
    let j = match w {
        -5_i128 => 1,
        _ => 0,
    };
    assert j == 1;
    let r = match x {
        0_u8..=9_u8 => 0,
        250_u8..=255_u8 => 1,
        _ => 2,
    };
    assert r == 1;
}

test "an integer suffix keeps a constant tuple index" {
    let t = [10, "twenty"];
    assert t[0_i32] == 10;
}

__DATA__
{"test": {}}
