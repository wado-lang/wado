// Static method defined via impl in a different module from the type definition
// should be resolvable with correct return type.
// This tests that lookup_static_method_return_type searches across all modules.

test "u128::from(u64) resolves return type without annotation" {
    let x = 42 as u64;
    let y = u128::from(x);
    assert y == 42 as u128;
}

test "i128::from(i64) resolves return type without annotation" {
    let x = -10 as i64;
    let y = i128::from(x);
    assert y == -10 as i128;
}

__DATA__
{"test": {}}
