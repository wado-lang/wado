// A `&S` parameter whose every use is a field read takes the multi-value ABI
// too, where nothing the call runs stores into memory its caller holds: the
// fields the referent held at the call are what every read would see.
//
// Where the call may store (through a `&mut` the caller handed it, or in a
// callee), a read after the store sees it, so the reference stays whole.

struct Pair {
    a: i32,
    b: i32,
}

#[inline("never")]
fn total(p: &Pair) -> i32 {
    return p.a + p.b;
}

// The fields are read at the call, after every argument, so a later
// argument's store is seen as the callee would have seen it.
#[inline("never")]
fn total_plus(p: &Pair, k: i32) -> i32 {
    return p.a + p.b + k;
}

struct Span {
    tag: i64,
    start: i32,
    end: i32,
}

// Only the fields the callee reads are loaded at the call, `tag` left behind.
// `s.start` is read twice, so it becomes one promoted value no expression
// spells: the reads are counted off that too.
#[inline("never")]
fn span_head(s: &Span) -> i32 {
    let len = s.end - s.start;
    if len == 0 {
        return -1;
    }
    return s.start * 3 + len;
}

// `p.b` is read only past an early return, so splitting would load it at
// every call where the callee loads it on one path: the reference stays whole.
#[inline("never")]
fn guarded(p: &Pair) -> i32 {
    if p.a < 0 {
        return 0;
    }
    return p.a + p.b;
}

#[inline("never")]
fn bump_a(w: &mut Pair) -> i32 {
    w.a += 1000;
    return 0;
}

// `w` and `r` may be one place, so `r.a` is read after the store.
#[inline("never")]
fn store_then_read(w: &mut Pair, r: &Pair) -> i32 {
    w.a = 10;
    return r.a + r.b;
}

#[inline("never")]
fn bump(w: &mut Pair) {
    w.b += 100;
}

// The store is a callee's.
#[inline("never")]
fn read_around_a_callee(w: &mut Pair, r: &Pair) -> i32 {
    let before = r.b;
    bump(w);
    return r.b - before;
}

export fn run() {
    let mut x = Pair { a: builtin::black_box(1), b: builtin::black_box(2) };
    assert total(&x) == 3;
    assert guarded(&x) == 3;
    assert total_plus(&x, bump_a(&mut x)) == 1003;
    assert store_then_read(&mut x, &x) == 12;
    assert read_around_a_callee(&mut x, &x) == 100;
    let s = Span { tag: builtin::black_box(5), start: builtin::black_box(1), end: builtin::black_box(3) };
    let t = Span { tag: builtin::black_box(5), start: builtin::black_box(2), end: builtin::black_box(2) };
    assert span_head(&s) == 5;
    assert span_head(&t) == -1;
}

__DATA__
{
    "stdout": "",
    "wir_expect:O2": [
        "total\" = fn(i32, i32) -> i32",
        "total_plus\" = fn(i32, i32, i32) -> i32",
        "span_head\" = fn(i32, i32) -> i32",
        "guarded\" = fn(ref \"opt_multi_value_param_ref.wado//Pair\") -> i32",
        "store_then_read\" = fn(ref \"opt_multi_value_param_ref.wado//Pair\", ref \"opt_multi_value_param_ref.wado//Pair\") -> i32",
        "read_around_a_callee\" = fn(ref \"opt_multi_value_param_ref.wado//Pair\", ref \"opt_multi_value_param_ref.wado//Pair\") -> i32"
    ]
}
