// A scoped `&mut` element is stored back once the call returns, so a callee
// that keeps the reference would write a copy no store reaches.

struct Keep {
    held: &mut Option<i32>,
}

#[inline("never")]
fn keep(p: &mut Option<i32>) -> Keep {
    return Keep { held: p };
}

fn hand_over_an_element(xs: &mut List<Option<i32>>) -> Keep {
    return keep(&mut xs[0]);
}

test "unreachable" {
    let mut xs: List<Option<i32>> = [null];
    let k = hand_over_an_element(&mut xs);
    assert k.held matches { null };
}

__DATA__
{
    "test": {},
    "compile_error": "retains it, so it outlives the call"
}
