// Verifies (issue #1184, C1) that the WIR builder no longer appends an
// `unreachable` opcode after a typed-block `break LABEL: V;` — the Wasm
// validator's polymorphic-stack rule accepts the typed block's `end`
// without the trailing `unreachable` once the prior instruction is
// already an unconditional branch.
//
// Tested at `-O0` so no pass flattens the block before WIR translation, which
// would leave the C1 path in `wir_build/translate.rs` unexercised.

use { println, Stdout } from "core:cli";

fn pick(n: i32) -> i32 {
    return found: {
        let doubled = n * 2;
        break found: doubled;
    };
}

export fn run() with Stdout {
    println(`n=${pick(21)}`);
}

__DATA__
{
    "stdout": "n=42\n",
    "wir_expect:O0": [
        "break found: doubled;\n    };"
    ],
    "wir_not_expect:O0": [
        "break found: doubled;\n        unreachable;",
        "break found: doubled;\n    unreachable;"
    ]
}
