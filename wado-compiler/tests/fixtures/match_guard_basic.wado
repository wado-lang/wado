// Test match arm guards with && syntax

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let x = 15;

    // Match with guard on literal pattern
    let result = match x {
        0 => "zero",
        n && n < 10 => "small",
        n && n < 20 => "medium",
        _ => "large",
    };
    println(result);

    // Guard that fails falls through to next arm
    let y = 5;
    let result2 = match y {
        n && n > 100 => "huge",
        n && n > 50 => "big",
        n && n > 10 => "medium",
        _ => "small",
    };
    println(result2);
}

__DATA__
{"stdout": "medium\nsmall\n"}
