#![TODO]
// Rank 2 does not reach concrete impls: a newtype's own impl and its base's
// both sit at depth 0, so rank 3 decides and the local impl on the base takes
// a call on the newtype. A newtype is a type distinct from its base
// (WEP 2026-06-25), so its own impl must win wherever it is written.
//
// Closing this means measuring depth over the impl's target as well as over a
// blanket's bounds — a decision, so the gap is pinned rather than papered over
// (WEP 2026-09-01).

use { Describe, Inner, Wrapped } from "./sub/trait_newtype_own_impl_lib.wado";

impl Describe for Inner {
    fn describe(&self) -> String {
        return "base";
    }
}

test "a newtype's own impl outranks a local impl on its base" {
    let w = Inner { x: 1 } as Wrapped;
    assert w.describe() == "newtype";
}
