struct Point {
    x: i32,
    y: i32,
}

impl Point {
    fn sum(&self) -> i32 {
        return self.x + self.y;
    }

    fn bump(&mut self) {
        self.x += 1;
    }
}

struct Counter {
    hits: Shared<i32>,
}

fn hit(c: &Counter) {
    *c.hits += 1;
}

test "a cell is written without mut, and through a &" {
    let c = Shared::new(1);
    *c = 2;
    assert *c == 2;

    let counter = Counter { hits: Shared::new(0) };
    hit(&counter);
    hit(&counter);
    assert *counter.hits == 2;
}

test "a copy of a cell is the same cell" {
    let a = Shared::new(1);
    let b = a;
    *b = 5;
    assert *a == 5;

    let counter = Counter { hits: a };
    let copy = counter;
    *copy.hits = 9;
    assert *counter.hits == 9;
    assert *a == 9;

    let separate = Shared::new(*a);
    *separate = 0;
    assert *a == 9;
}

test "new takes a copy of its argument" {
    let mut p = Point { x: 1, y: 2 };
    let c = Shared::new(p);
    p.x = 100;
    assert c.x == 1;
}

test "== compares what two cells hold, and ref_eq whether they are one" {
    let a = Shared::new(1);
    let b = a;
    let c = Shared::new(1);
    assert a == b;
    assert a == c;
    assert a != Shared::new(2);
    assert ref_eq(a, b);
    assert !ref_eq(a, c);
}

test "an index and a for loop dereference a cell" {
    let c = Shared::new([1, 2, 3] as List<i32>);
    c[0] = 9;
    assert c[0] == 9;
    assert c.len() == 3;

    let points = Shared::new([Point { x: 1, y: 2 }] as List<Point>);
    for let p of points {
        p.x += 10;
    }
    assert points[0].sum() == 13;
}

test "a field access and a method call dereference a cell" {
    let p = Shared::new(Point { x: 1, y: 2 });
    p.x = 10;
    assert p.sum() == 12;
    p.bump();
    assert p.x == 11;

    let q = p;
    q.y = 0;
    assert p.sum() == 11;
}

test "a struct holding a cell compares what its cells hold" {
    let hits = Shared::new(0);
    let a = Counter { hits };
    let b = Counter { hits: Shared::new(0) };
    let c = Counter { hits: Shared::new(1) };
    assert a == b;
    assert a != c;
}

test "a cell inspects as what it holds, and defaults where that does" {
    let c = Shared::new(3);
    assert `${c:?}` == "Shared(3)";
    let p = Shared::new(Point { x: 1, y: 2 });
    assert `${p:?}` == "Shared(Point { x: 1, y: 2 })";

    let d: Shared<i32> = Shared::default();
    assert *d == 0;
}

fn bump_all(cells: &List<Shared<i32>>) {
    for let c of cells {
        **c += 1;
    }
}

test "a cell in a list is the one its copies are" {
    let a = Shared::new(1);
    let cells: List<Shared<i32>> = [a, Shared::new(10)];
    bump_all(&cells);
    assert *a == 2;
    assert *cells[1] == 11;
}

struct Shape {
    origin: Shared<Point>,
}

fn nudge(shape: &Shape) {
    shape.origin.x += 1;
    shape.origin.bump();
}

test "a path through a cell is writable under a &" {
    let shape = Shape { origin: Shared::new(Point { x: 0, y: 0 }) };
    nudge(&shape);
    assert shape.origin.x == 2;

    let points: List<Shared<Point>> = [shape.origin];
    points[0].bump();
    points[0].y = 7;
    assert shape.origin.sum() == 10;
}

test "a field access and a method call read through every cell and reference" {
    let mut p = Point { x: 1, y: 2 };
    let through_ref = Shared::new(&mut p);
    through_ref.x = 5;
    through_ref.bump();
    assert p.x == 6;

    let read_only = Shared::new(&p);
    assert read_only.sum() == 8;

    let inner = Shared::new(Point { x: 1, y: 2 });
    let outer = Shared::new(inner);
    outer.x = 5;
    outer.bump();
    assert inner.x == 6;
}

trait Area with () {
    fn area(&self) -> i32;
}

impl Area for Point {
    fn area(&self) -> i32 {
        return self.x * self.y;
    }
}

test "a qualified call takes a cell as the receiver it holds" {
    let c = Shared::new(Point { x: 2, y: 3 });
    assert Area::area(&c) == 6;
    assert Area::area(&Shared::new(c)) == 6;
}

struct Slot {
    r: &mut i32,
}

struct Holder {
    c: Shared<Slot>,
}

fn poke(h: &Holder) {
    *h.c.r = 7;
}

test "a &mut a cell holds is written under a &" {
    let mut n = 0;
    let h = Holder { c: Shared::new(Slot { r: &mut n }) };
    poke(&h);
    assert n == 7;
}

type Tally = Shared<i32>;
type Origin = Shared<Point>;

test "a newtype over a cell is a cell" {
    let t: Tally = Shared::new(1) as Tally;
    let u = t;
    *u += 1;
    assert *t == 2;
    assert t == u;

    let o = Shared::new(Point { x: 1, y: 2 }) as Origin;
    o.x = 5;
    o.bump();
    assert o.sum() == 8;
    assert `${o:?}` == "Shared(Point { x: 6, y: 2 }) as Origin";
}

variant Watcher {
    Idle(Shared<Point>),
    Busy(Shared<Point>),
}

fn x_of(watcher: &Watcher) -> i32 {
    return match watcher {
        Idle(p) => p.x,
        Busy(p) => p.x,
    };
}

test "a cell bound by a pattern under a & is still the cell" {
    let p = Shared::new(Point { x: 7, y: 0 });
    let watchers: List<Watcher> = [Watcher::Busy(p)];
    assert x_of(&watchers[0]) == 7;
    for let w of watchers {
        match w {
            Idle(q) => { q.y = 1; },
            Busy(q) => { q.y = 2; },
        }
    }
    assert p.y == 2;
}

struct Task {
    runs: i32,
    step: fn mut(),
}

test "a fn mut a cell holds is called without mut" {
    let mut count = 0;
    let task = Shared::new(Task { runs: 0, step: || { count += 1; } });
    (task.step)();
    (task.step)();
    task.runs += 2;
    assert count == 2;
    assert task.runs == 2;
}

test "a closure captures a cell and writes it without being fn mut" {
    let c = Shared::new(0);
    let inc = || { *c += 1; };
    inc();
    inc();
    assert *c == 2;
}
