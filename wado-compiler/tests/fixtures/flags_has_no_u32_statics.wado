// A flags type is not a newtype over `u32`: it inherits none of `u32`'s
// associated functions, and neither does a newtype over it.

flags Perm {
    read,
    write,
}

type M = Perm;

test {
    let p = Perm::from_str_radix("1", 2);
    let m = M::from_str_radix("1", 2);
}

