// `never`-typed arms (panic, unreachable) in match expressions.
// The `never` type is a bottom type compatible with any type,
// so a match arm returning `never` must not affect the match result type.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // never arm is the last arm (None => panic)
    let a: Option<i32> = Option::<i32>::Some(1);
    let x: i32 = match a {
        Some(v) => v,
        None => panic("unreachable"),
    };
    assert x == 1;

    // never arm is the first arm (None => panic)
    let b: Option<i32> = Option::<i32>::Some(2);
    let y: i32 = match b {
        None => panic("unreachable"),
        Some(v) => v,
    };
    assert y == 2;

    // unreachable() instead of panic
    let c: Option<i32> = Option::<i32>::Some(3);
    let z: i32 = match c {
        None => unreachable(),
        Some(v) => v,
    };
    assert z == 3;

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
