// Test branch hinting builtins

use { println, Stdout } from "core:cli";

fn check_likely(x: i32) -> i32 {
    // Use likely() to hint that this branch is usually taken
    if builtin::likely(x > 0) {
        return 1;
    }
    return 0;
}

fn check_unlikely(x: i32) -> i32 {
    // Use unlikely() to hint that this branch is rarely taken (error path)
    if builtin::unlikely(x < 0) {
        return 1;
    }
    return 0;
}

export fn run() with Stdout {
    // Test likely: 42 > 0 is true (matches hint)
    let r1 = check_likely(42);
    // Test likely: 0 > 0 is false (violates hint)
    let r2 = check_likely(0);
    // Test unlikely: 10 < 0 is false (matches hint)
    let r3 = check_unlikely(10);
    // Test unlikely: -1 < 0 is true (violates hint)
    let r4 = check_unlikely(-1);
    println(`r1={r1}, r2={r2}, r3={r3}, r4={r4}`);
}

__DATA__
{"stdout": "r1=1, r2=0, r3=0, r4=1\n"}
