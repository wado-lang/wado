// Stage C resolver (WEP 2026-06-13): `wire_name(field, policy)` resolves a
// field's wire key — its `#[wire(name)]` override wins, else the struct's
// `name_policy` is applied. Walks the `ReflectStruct::<S>::members()`.

use { wire_name } from "core:serde";

#[wire(name_policy = "camelCase")]
struct S {
    user_id: i32,
    #[wire(name = "explicit")]
    other_field: i32,
    created_at: i32,
}

test "wire_name resolves override then policy" {
    let policy = ReflectStruct::<S>::wire_name_policy();
    let mut out = "";
    for let f of ReflectStruct::<S>::members() {
        out = `${out}${wire_name(&f, policy)};`;
    }
    assert out == "userId;explicit;createdAt;";
}

__DATA__
{"test": {}}
