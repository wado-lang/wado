// Outside the test world, a build at `-O2` and above leaves the contract of a
// call marked `unchecked` to its caller, so a slice past the view reaches
// into the backing string.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let view = "abcdef".as_str_slice().slice(0, 3);
    let past = unchecked view.slice(0, builtin::black_box(5));
    println(`${past.len()}`);
}

__DATA__
{
    "only_opt": ["O2", "O3", "Os"],
    "stdout": "5\n"
}
