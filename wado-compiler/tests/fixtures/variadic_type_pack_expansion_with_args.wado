// Type pack expansion with method that takes args: [..T::from(42)]
use { println, Stdout } from "core:cli";

trait FromInt {
    fn from_int(n: i32) -> Self;
}

impl FromInt for i32 {
    fn from_int(n: i32) -> i32 {
        return n;
    }
}

impl FromInt for String {
    fn from_int(n: i32) -> String {
        return `{n}`;
    }
}

impl FromInt for f64 {
    fn from_int(n: i32) -> f64 {
        return n as f64;
    }
}

fn from_int_all<..T: FromInt>(n: i32) -> [..T] {
    return [..T::from_int(n)];
}

export fn run() with Stdout {
    let result = from_int_all::<[i32, String, f64]>(42);
    assert result.0 == 42;
    assert result.1 == "42";
    assert result.2 == 42.0;
    println("ok");
}

__DATA__
{"stdout": "ok\n"}
