// Type pack expansion with arguments: [..T::method(args)]
// The static method receives arguments forwarded from the call site.

trait FromI32 {
    fn from_i32(n: i32) -> Self;
}

impl FromI32 for i32 {
    fn from_i32(n: i32) -> i32 {
        return n;
    }
}

impl FromI32 for f64 {
    fn from_i32(n: i32) -> f64 {
        return n as f64;
    }
}

impl FromI32 for String {
    fn from_i32(n: i32) -> String {
        return `{n}`;
    }
}

fn convert_all<..T: FromI32>(n: i32) -> [..T] {
    return [..T::from_i32(n)];
}

test "type pack expansion with args" {
    let t = convert_all::<[i32, f64, String]>(42);
    assert t.0 == 42;
    assert t.1 == 42.0;
    assert t.2 == "42";
}

test "type pack expansion single element" {
    let t = convert_all::<[i32]>(7);
    assert t.0 == 7;
}

__DATA__
{"test": {}}
