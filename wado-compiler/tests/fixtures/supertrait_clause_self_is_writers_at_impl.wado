// An impl's supertraits are checked as their clauses were written: `Mid`'s
// `Base<Self::Item>` asks for `Base<i32>`, `Mid`'s `Item`, though `Root`,
// which inherits the clause, binds an `Item` of its own to `String`.
trait Base<A> with () {
    fn load(&self) -> A;
}

trait Mid: Base<Self::Item> with () {
    type Item;
}

trait Root: Mid with () {
    type Item;
}

struct Box {
    v: i32,
}

impl Base<i32> for Box {
    fn load(&self) -> i32 {
        return self.v;
    }
}

impl Mid for Box {
    type Item = i32;
}

impl Root for Box {
    type Item = String;
}

fn rooted<T: Root>(_t: &T) -> bool {
    return true;
}

test "Root's impl asks for Mid's Base" {
    let b = Box { v: 4 };
    assert rooted(&b) && b.load() == 4;
}
