use { println, Stdout } from "core:cli";


// from closure_call_basic.wado
fn closure_call_basic() with Stdout {
    let add_one = |x: i32| x + 1;
    let result = add_one(5);
    println(`{result}`);
}

// from closure_call_multi_args.wado
fn closure_call_multi_args() with Stdout {
    let add = |a: i32, b: i32| a + b;
    let mul = |x: i32, y: i32| x * y;
    let result = add(mul(2, 3), mul(4, 5));
    println(`{result}`);
}

// from closure_call_multiple.wado
fn closure_call_multiple() with Stdout {
    let double = |x: i32| x * 2;
    let a = double(3);
    let b = double(5);
    let c = double(7);
    println(`{a},{b},{c}`);
}

export fn run() with Stdout {
    closure_call_basic();
    closure_call_multi_args();
    closure_call_multiple();
}

__DATA__
{"stdout": "6\n26\n6,10,14\n"}
