// An anonymous struct walks its fields through a `ReflectStruct` bound on a
// generic function or method, as a declared struct does. The call site settles
// the pack by projecting `FieldTypes`, which for a shape has no declaration to
// read and must read the struct's head.

fn field_names<T: ReflectStruct<FieldTypes = [..F]>, ..F>(v: &T) -> String {
    let mut out = "";
    for let f of ReflectStruct::<T>::members() {
        out.push_str(f.name());
    }
    return out;
}

fn field_names_by_value<T: ReflectStruct<FieldTypes = [..F]>, ..F>(v: T) -> String {
    let mut out = "";
    for let f of ReflectStruct::<T>::members() {
        out.push_str(f.name());
    }
    return out;
}

struct Walker {}

impl Walker {
    fn field_names<T: ReflectStruct<FieldTypes = [..F]>, ..F>(&self, v: &T) -> String {
        let mut out = "";
        for let f of ReflectStruct::<T>::members() {
            out.push_str(f.name());
        }
        return out;
    }
}

struct Named {
    a: i32,
    b: String,
}

test "an anonymous struct walks its fields by reference" {
    let anon = { x: 1, y: "s" };
    assert field_names(&anon) == "xy";
}

test "an anonymous struct walks its fields by value" {
    let anon = { x: 1, y: "s" };
    assert field_names_by_value(anon) == "xy";
}

test "an anonymous struct walks its fields through a method" {
    let anon = { x: 1, y: "s" };
    assert Walker {}.field_names(&anon) == "xy";
}

test "a declared struct walks its fields" {
    let named = Named { a: 1, b: "s" };
    assert field_names(&named) == "ab";
    assert field_names_by_value(named) == "ab";
}

__DATA__
{"test": {}}
