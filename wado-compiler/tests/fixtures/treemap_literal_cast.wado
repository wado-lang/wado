// TreeMap literal: explicit cast syntax
use { println } from "core:cli";
use { TreeMap } from "core:collections";

export fn run() with Stdout {
    let m = { a: 1, b: 2, c: 3 } as TreeMap<String, i32>;

    assert m.len() == 3;

    assert m["a"] == 1;
    assert m["c"] == 3;

    println("cast: ok");
}

__DATA__
{"stdout": "cast: ok\n"}
