// A `_` in the turbofish of a trait static called with `Self = T` is a
// variable, and the one impl written at another argument does not settle it.

trait Tagged<V> with () {
    fn tag() -> String;
}

struct S {}

impl Tagged<i32> for S {
    fn tag() -> String {
        return "i32";
    }
}

export fn run() {
    let _t = Tagged::<_, Self = S>::tag();
}

