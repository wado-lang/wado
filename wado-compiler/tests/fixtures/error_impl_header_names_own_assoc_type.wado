// An impl header cannot name its own associated type: the header is resolved
// before the impl answers anything.

trait Conv<T> with () {
    type Item;
    fn conv(&self, t: T) -> i32;
}

struct X {}

impl Conv<Self::Item> for X {
    type Item = i32;
    fn conv(&self, t: i32) -> i32 {
        return t + 1;
    }
}

