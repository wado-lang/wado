// A `mut` parameter is the callee's own copy. Rebinding it, writing a field,
// writing an element, appending — none of it reaches the caller's value, for
// any type. The same holds for a method's and a closure's parameters.

struct Point {
    x: i32,
    y: i32,
}

struct Accumulator {
    total: i32,
}

impl Accumulator {
    fn add(&mut self, mut n: i32) {
        n *= 2;
        self.total += n;
    }
}

fn increment(mut n: i32) -> i32 {
    n += 1;
    return n;
}

// A mut param mutated for nothing: the caller's value is still its own.
fn double_in_place(mut n: i32) {
    n = n * 2;
}

fn compute(mut x: i32, y: i32) -> i32 {
    x = x * 2;
    return x + y;
}

fn zero_struct(mut p: Point) -> Point {
    p = Point { x: 0, y: 0 };
    return p;
}

fn translate(mut p: Point, dx: i32, dy: i32) -> Point {
    p.x += dx;
    p.y += dy;
    return p;
}

// A *non-mut* param copied into a local and mutated there.
fn shift(p: Point) -> Point {
    let mut q = p;
    q.x += 1;
    return q;
}

fn replace_string(mut s: String) -> String {
    s = "replaced";
    return s;
}

fn append_bang(mut s: String) -> String {
    s.push_str(&"!");
    return s;
}

fn swap_array(mut arr: List<i32>) -> List<i32> {
    arr = [99, 88] as List<i32>;
    return arr;
}

fn double_first(mut arr: List<i32>) -> List<i32> {
    arr[0] = arr[0] * 2;
    return arr;
}

fn push_zero(mut arr: List<i32>) -> List<i32> {
    arr.push(0);
    return arr;
}

// A mut param as a loop counter.
fn countdown(mut n: i32) -> List<i32> {
    let mut seen: List<i32> = [];
    while n > 0 {
        seen.push(n);
        n -= 1;
    }
    return seen;
}

test "a primitive mut param" {
    let x = builtin::black_box(5);
    assert increment(x) == 6;
    assert x == 5;
    double_in_place(x);
    assert x == 5;
}

test "mut and non-mut parameters side by side" {
    let x = builtin::black_box(5);
    let y = builtin::black_box(3);
    assert compute(x, y) == 13;
    assert x == 5;
    assert y == 3;
}

test "rebinding a struct param" {
    let p = Point { x: builtin::black_box(5), y: 10 };
    let q = zero_struct(p);
    assert q.x == 0;
    assert q.y == 0;
    assert p.x == 5;
    assert p.y == 10;
}

test "writing a field of a struct param" {
    let r = Point { x: builtin::black_box(1), y: 2 };
    let t = translate(r, 10, 20);
    assert t.x == 11;
    assert t.y == 22;
    assert r.x == 1;
    assert r.y == 2;
}

test "a non-mut param copied into a local and mutated" {
    let c = Point { x: builtin::black_box(3), y: 4 };
    let d = shift(c);
    assert d.x == 4;
    assert c.x == 3;
}

test "rebinding and appending to a String param" {
    let s = builtin::black_box("original");
    assert replace_string(s) == "replaced";
    assert s == "original";

    let greeting = builtin::black_box("hello");
    assert append_bang(greeting) == "hello!";
    assert greeting == "hello";
}

test "rebinding, writing and appending to a List param" {
    let a: List<i32> = [builtin::black_box(1), 2, 3];
    let b = swap_array(a);
    assert b[0] == 99;
    assert a[0] == 1;

    let c: List<i32> = [builtin::black_box(10), 20, 30];
    let d = double_first(c);
    assert d[0] == 20;
    assert c[0] == 10;

    let e: List<i32> = [builtin::black_box(1), 2, 3];
    let f = push_zero(e);
    assert f.len() == 4;
    assert e.len() == 3;
}

test "a method's mut param" {
    let mut acc = Accumulator { total: 0 };
    let delta = builtin::black_box(7);
    acc.add(delta);
    assert acc.total == 14;
    assert delta == 7;
}

test "a mut param as a loop counter" {
    let start = builtin::black_box(3);
    assert countdown(start) == [3, 2, 1];
    assert start == 3;
}

test "a closure's mut param" {
    let add_one = |mut n: i32| {
        n += 1;
        return n;
    };
    let y = builtin::black_box(10);
    assert add_one(y) == 11;
    assert y == 10;

    let sum_to = |mut n: i32| {
        let mut total = 0;
        while n > 0 {
            total += n;
            n -= 1;
        }
        return total;
    };
    let limit = builtin::black_box(4);
    assert sum_to(limit) == 10;
    assert limit == 4;
}
