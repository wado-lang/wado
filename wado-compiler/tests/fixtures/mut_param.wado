// Test: mut parameters have value semantics — callee mutations do not affect the caller.

struct Point {
    x: i32,
    y: i32,
}

struct Accumulator {
    total: i32,
}

impl Accumulator {
    fn add(&mut self, mut n: i32) {
        n *= 2;
        self.total += n;
    }
}

fn increment(mut n: i32) -> i32 {
    n += 1;
    return n;
}

fn translate(mut p: Point, dx: i32, dy: i32) -> Point {
    p.x += dx;
    p.y += dy;
    return p;
}

fn replace_string(mut s: String) -> String {
    s = "replaced";
    return s;
}

fn double_first(mut arr: Array<i32>) -> Array<i32> {
    arr[0] = arr[0] * 2;
    return arr;
}

fn compute(mut x: i32, y: i32) -> i32 {
    x = x * 2;
    return x + y;
}

fn countdown(mut n: i32) with Stdout {
    while n > 0 {
        println(`{n}`);
        n -= 1;
    }
}

export fn run() with Stdout {
    // Primitive: mutation does not affect caller
    let x = 5;
    assert increment(x) == 6;
    assert x == 5;

    // Struct: field mutation does not affect caller
    let p = Point { x: 1, y: 2 };
    let q = translate(p, 10, 20);
    assert q.x == 11;
    assert q.y == 22;
    assert p.x == 1;
    assert p.y == 2;

    // String: reassignment does not affect caller
    let s = "original";
    assert replace_string(s) == "replaced";
    assert s == "original";

    // Array: element mutation does not affect caller
    let a: Array<i32> = [1, 2, 3];
    let b = double_first(a);
    assert b[0] == 2;
    assert a[0] == 1;

    // Mixed mut/non-mut params
    let px = 5;
    let py = 3;
    assert compute(px, py) == 13; // (5*2) + 3
    assert px == 5;
    assert py == 3;

    // Method with mut param
    let mut acc = Accumulator { total: 0 };
    let delta = 7;
    acc.add(delta);
    assert acc.total == 14; // 7 * 2
    assert delta == 7;

    // Loop using mut param as counter
    let start = 3;
    countdown(start);
    assert start == 3;

    // Closure with mut parameter
    let add_one = |mut n: i32| {
        n += 1;
        return n;
    };
    let y = 10;
    assert add_one(y) == 11;
    assert y == 10;

    // Closure with mut param doing iteration
    let sum_to = |mut n: i32| {
        let mut total = 0;
        while n > 0 {
            total += n;
            n -= 1;
        }
        return total;
    };
    let limit = 4;
    assert sum_to(limit) == 10; // 4+3+2+1
    assert limit == 4;

    println("ok");
}

__DATA__
{"stdout": "3\n2\n1\nok\n"}
