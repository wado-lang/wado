// Test: mut parameters — full value semantics for all types.
// Mutations inside a function (field writes, append, element writes, rebinding)
// never propagate back to the caller's variable.

use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

struct Accumulator {
    total: i32,
}

impl Accumulator {
    fn add(&mut self, mut n: i32) {
        n *= 2;
        self.total += n;
    }
}

fn increment(mut n: i32) -> i32 {
    n += 1;
    return n;
}

// Rebinding a struct param does not affect the caller's binding.
fn zero_struct(mut p: Point) -> Point {
    p = Point { x: 0, y: 0 };
    return p;
}

// In-place field mutation on a mut struct param does not affect the caller.
fn translate(mut p: Point, dx: i32, dy: i32) -> Point {
    p.x += dx;
    p.y += dy;
    return p;
}

// Rebinding a string param does not affect the caller's binding.
fn replace_string(mut s: String) -> String {
    s = "replaced";
    return s;
}

// Appending to a mut string param does not affect the caller's string.
fn append_bang(mut s: String) -> String {
    s.push_str(&"!");
    return s;
}

// Rebinding an array param does not affect the caller's binding.
fn swap_array(mut arr: List<i32>) -> List<i32> {
    arr = [99, 88] as List<i32>;
    return arr;
}

// Element mutation on a mut array param does not affect the caller's array.
fn double_first(mut arr: List<i32>) -> List<i32> {
    arr[0] = arr[0] * 2;
    return arr;
}

fn compute(mut x: i32, y: i32) -> i32 {
    x = x * 2;
    return x + y;
}

fn countdown(mut n: i32) with Stdout {
    while n > 0 {
        println(`{n}`);
        n -= 1;
    }
}

export fn run() with Stdout {
    // Primitive: arithmetic mutation does not affect caller.
    let x = 5;
    assert increment(x) == 6;
    assert x == 5;

    // Struct: binding rebind does not affect caller.
    let p = Point { x: 5, y: 10 };
    let q = zero_struct(p);
    assert q.x == 0;
    assert q.y == 0;
    assert p.x == 5;
    assert p.y == 10;

    // Struct: field mutation does not affect caller (value semantics).
    let r = Point { x: 1, y: 2 };
    let t = translate(r, 10, 20);
    assert t.x == 11;
    assert t.y == 22;
    assert r.x == 1;
    assert r.y == 2;

    // String: rebind does not affect caller.
    let s = "original";
    assert replace_string(s) == "replaced";
    assert s == "original";

    // String: append does not affect caller (value semantics).
    let greeting = "hello";
    assert append_bang(greeting) == "hello!";
    assert greeting == "hello";

    // List: rebind does not affect caller.
    let a: List<i32> = [1, 2, 3];
    let b = swap_array(a);
    assert b[0] == 99;
    assert a[0] == 1;

    // List: element mutation does not affect caller (value semantics).
    let c: List<i32> = [10, 20, 30];
    let d = double_first(c);
    assert d[0] == 20;
    assert c[0] == 10;

    // Mixed mut/non-mut params.
    let px = 5;
    let py = 3;
    assert compute(px, py) == 13; // (5*2) + 3
    assert px == 5;
    assert py == 3;

    // Method with mut param.
    let mut acc = Accumulator { total: 0 };
    let delta = 7;
    acc.add(delta);
    assert acc.total == 14; // 7 * 2
    assert delta == 7;

    // Loop using mut param as counter.
    let start = 3;
    countdown(start);
    assert start == 3;

    // Closure with mut parameter: arithmetic mutation does not affect caller.
    let add_one = |mut n: i32| {
        n += 1;
        return n;
    };
    let y = 10;
    assert add_one(y) == 11;
    assert y == 10;

    // Closure with mut param doing iteration.
    let sum_to = |mut n: i32| {
        let mut total = 0;
        while n > 0 {
            total += n;
            n -= 1;
        }
        return total;
    };
    let limit = 4;
    assert sum_to(limit) == 10; // 4+3+2+1
    assert limit == 4;

    println("ok");
}

__DATA__
{"stdout": "3\n2\n1\nok\n"}
