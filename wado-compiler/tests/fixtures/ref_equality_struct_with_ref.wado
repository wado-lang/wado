// A struct's derived `Eq` compares a reference field by the value it points to.
struct Inner {
    value: i32,
}

struct Container {
    name: String,
    data: &Inner,
}

test "struct eq with same ref field" {
    let inner = Inner { value: 42 };
    let c1 = Container { name: "a", data: &inner };
    let c2 = Container { name: "a", data: &inner };
    assert c1 == c2;
}

test "struct eq with equal values behind different refs" {
    let inner1 = Inner { value: 42 };
    let inner2 = Inner { value: 42 };
    let c1 = Container { name: "a", data: &inner1 };
    let c2 = Container { name: "a", data: &inner2 };
    assert c1 == c2;
    assert !ref_eq(c1.data, c2.data);
}

test "struct neq with different values behind refs" {
    let inner1 = Inner { value: 42 };
    let inner2 = Inner { value: 43 };
    let c1 = Container { name: "a", data: &inner1 };
    let c2 = Container { name: "a", data: &inner2 };
    assert c1 != c2;
}

test "struct neq with different name same ref" {
    let inner = Inner { value: 42 };
    let c1 = Container { name: "a", data: &inner };
    let c2 = Container { name: "b", data: &inner };
    assert c1 != c2;
}
