// A declared type-parameter default is what the parameter takes when the use
// site omits it. The grammar has accepted `T = i32` all along and the
// formatter and `wado doc` both render it, but no declaration kind applied it:
// a bare `Pair` reported `missing type arguments`. Every generic declaration
// answers the same way — struct, variant and newtype alike — so no kind is the
// odd one out.

struct Pair<T = i32> {
    a: T,
}

variant Slot<T = i32> {
    Empty,
    Full(T),
}

struct Point {
    x: i32,
}

type Wrapped<T = i32> = Point;

// Only the omitted tail takes a default; a written argument always wins.
struct Both<A, B = String> {
    a: A,
    b: B,
}

// A default naming a parameter to its left stands for that parameter's
// argument, not for whatever the use site calls `A`.
struct Mirror<A, B = A> {
    a: A,
    b: B,
}

struct Chain<A = i32, B = A> {
    a: A,
    b: B,
}

// A field type resolves through a second path, which has to answer the same
// way: a half-applied `Both<i32>` here would reach the field as one argument.
struct Holder {
    p: Pair,
    b: Both<i32>,
}

test "a struct takes its declared default" {
    let p: Pair = Pair { a: 7 };
    assert p.a == 7;
}

test "a written argument still wins over the default" {
    let p: Pair<String> = Pair { a: "x" };
    assert p.a == "x";
}

test "a variant takes its declared default" {
    let s: Slot = Slot::Full(3);
    assert s matches { Slot::Full(3) };
}

// A default is a type the declaration wrote, so it never means what the use
// site happens to call the same name. The newtype path resolved its base and
// its defaults at the use site, which made `Aliased` inside `shadowed` stand
// for the function's own `Zero`. `struct_literal_phantom_slot` covers the
// struct and variant paths.
trait Mark {
    fn tag() -> i32;
}

struct Zero {}

impl Mark for Zero {
    fn tag() -> i32 {
        return 10;
    }
}

struct One {}

impl Mark for One {
    fn tag() -> i32 {
        return 20;
    }
}

struct Marked<M: Mark = Zero> {
    m: M,
}

impl<M: Mark> Marked<M> {
    fn which(&self) -> i32 {
        return M::tag();
    }
}

type Aliased<M: Mark = Zero> = Marked<M>;

fn make_aliased() -> Aliased {
    return Marked { m: Zero {} } as Aliased;
}

fn shadowed<Zero: Mark>(_p: Zero) -> i32 {
    let a: Aliased = make_aliased();
    return a.which();
}

test "a newtype takes its declared default" {
    let w = Point { x: 1 } as Wrapped;
    assert w.x == 1;
}

// The default fills only what the site left out.
test "the omitted tail takes its default" {
    let b: Both<i32> = Both { a: 1, b: "s" };
    assert b.a == 1;
    assert b.b == "s";
}

test "both arguments written" {
    let b: Both<i32, i32> = Both { a: 1, b: 2 };
    assert b.b == 2;
}

test "a dependent default takes the earlier argument" {
    let m: Mirror<i32> = Mirror { a: 1, b: 2 };
    assert m.a == 1;
    assert m.b == 2;
}

test "a dependent default resolves through another default" {
    let c: Chain = Chain { a: 1, b: 2 };
    assert c.a == 1;
    assert c.b == 2;
}

test "a field type takes the same defaults" {
    let h = Holder {
        p: Pair { a: 5 },
        b: Both { a: 6, b: "s" },
    };
    assert h.p.a == 5;
    assert h.b.b == "s";
}

test "a newtype's default is not the use site's parameter of the same name" {
    assert shadowed(One {}) == 10;
}

__DATA__
{"test": {}}
