// Dropping a resource whose defining interface also uses one from another
// interface. `resource.drop` resolves against outer component scope, but the CM
// spec puts `[constructor]X` / `[method]X.foo` in the instance exporting `X`.
use { println, Stdout } from "core:cli";
use { Connector, Error } from "wasi:tls";

export fn run() with (Stdout, Connector, Error) {
    let conn = Connector::new();

    let [data_rx, data_tx] = Stream::<u8>::new();
    let [_tls_rx, _send_done] = conn.send(data_rx);
    data_tx.drop();

    // `conn` is never handed to `connect`, so it is dropped here.
    println("connector dropped");
}

__DATA__
{"stdout": "connector dropped\n"}
