// Test: dropping a resource whose defining interface also uses a resource from
// another interface.
//
// `Connector::send` puts `wasi:tls/types#error` (a resource) in
// `wasi:tls/client`'s signatures, which categorizes that interface as a
// resource *using* one. That path declares the resources the interface defines
// itself inline in its instance type — the CM spec requires `[constructor]X` /
// `[method]X.foo` to sit in the instance exporting `X` — but used to stop
// there, never aliasing `connector` at outer component scope. `resource.drop`
// resolves against outer scope, so dropping the connector panicked codegen with
// `unknown component type: resource:connector`.
//
// `wasi_tls_mock_recv.wado` calls `send` too but hands the connector to
// `Connector::connect`, which consumes it, so no drop is ever emitted. Here the
// connector simply goes out of scope.
use { println, Stdout } from "core:cli";
use { Connector, Error } from "wasi:tls";

export fn run() with Stdout, Connector, Error {
    let conn = Connector::new();

    let [data_rx, data_tx] = Stream::<u8>::new();
    let [_tls_rx, _send_done] = conn.send(data_rx);
    data_tx.drop();

    // `conn` is never handed to `connect`, so it is dropped here.
    println("connector dropped");
}

__DATA__
{"stdout": "connector dropped\n"}
