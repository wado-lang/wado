// Test: a `future<result<_, own<error>>>` — the Err arm is a resource.
//
// `Connector::send` returns `Future<Result<(), Error>>`, where `wasi:tls`'s
// `Error` is a resource. A resource has no value representation, so the payload
// used to be classified as the WASI *transmission* future — `future<result<_,
// error-code>>` — which typed tls's future against `wasi:cli`'s error-code
// enum, a type this program never imports. Nothing caught it because the
// signature only reaches classification once the future is operated on:
// `wasi_tls_mock_recv.wado` binds it to `_send_done` and never touches it.
//
// Here `done` is dropped explicitly, which is what drives the classification.
use { println, Stdout } from "core:cli";
use { Connector, Error } from "wasi:tls";

export fn run() with Stdout, Connector, Error {
    let conn = Connector::new();

    let [data_rx, data_tx] = Stream::<u8>::new();
    let [tls_rx, send_done] = conn.send(data_rx);
    data_tx.drop();
    tls_rx.drop();
    send_done.drop();

    println("send future dropped");
}

__DATA__
{"stdout": "send future dropped\n"}
