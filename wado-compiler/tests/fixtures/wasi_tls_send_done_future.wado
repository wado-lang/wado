// Test: a `future<result<_, own<error>>>` — the Err arm is a resource.
//
// `Connector::send` returns `Future<Result<(), Error>>`, where `wasi:tls`'s
// `Error` is a resource. A unit Ok arm is also the WASI transmission shape, so
// only the Err arm tells the two apart.
//
// The payload reaches classification only once the future is operated on;
// `wasi_tls_mock_recv.wado` binds it to `_send_done` and never touches it, so
// `done` is dropped explicitly here.
use { println, Stdout } from "core:cli";
use { Connector, Error } from "wasi:tls";

export fn run() with Stdout, Connector, Error {
    let conn = Connector::new();

    let [data_rx, data_tx] = Stream::<u8>::new();
    let [tls_rx, send_done] = conn.send(data_rx);
    data_tx.drop();
    tls_rx.drop();
    send_done.drop();

    println("send future dropped");
}

__DATA__
{"stdout": "send future dropped\n"}
