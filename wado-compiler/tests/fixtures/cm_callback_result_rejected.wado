// A callback returns a scalar or an unrestricted handle at most, so one
// returning a `String` cannot cross the Component Model boundary.

#[cm("example:demo/target", linearity = "unrestricted", repr = "externref", classes = "0..=0")]
resource Target {
    #[cm("example:demo/target#listen")]
    #[cm_params("self", "listener")]
    fn listen(&self, listener: fn(i32) -> String);
}

export fn run() {
}

