// `&mut self.v` with `v: T` is checked in the generic body, where `T` is no
// replace-on-assign type, so the reference-site refusal never sees an instance
// whose `T` is one. There the reference is a detached copy, and the call writes
// the callee's replacement back to the field: any value whose bits differ, so
// `-0.0` replaces `0.0`, which `==` takes for the same.
use { f32x4 } from "core:simd";

struct P {
    n: i32,
}

struct Cell<T> {
    v: T,
}

fn put<T>(slot: &mut T, v: T) {
    *slot = v;
}

impl<T> Cell<T> {
    fn set(&mut self, x: T) {
        put(&mut self.v, x);
    }
}

test "a reference field rebinds" {
    let a = P { n: 1 };
    let b = P { n: 2 };
    let mut c = Cell { v: &a };
    c.set(&b);
    assert c.v.n == 2;
    assert a.n == 1;
}

test "a primitive field is replaced" {
    let mut c = Cell { v: 1 };
    c.set(2);
    assert c.v == 2;
}

test "a float field takes a zero of the other sign" {
    let mut c = Cell { v: 0.0 };
    c.set(-0.0);
    assert c.v.to_bits() == (-0.0).to_bits();
    let mut d = Cell { v: 0.0 as f32 };
    d.set(-0.0 as f32);
    assert d.v.to_bits() == (-0.0 as f32).to_bits();
}

test "a half float field is replaced" {
    let mut c = Cell { v: 1.5 as f16 };
    c.set(2.5 as f16);
    assert c.v == 2.5 as f16;
}

test "a v128 field is replaced" {
    let mut c = Cell { v: f32x4::splat(1.0) };
    c.set(f32x4::splat(2.0));
    assert c.v.extract_lane(3) == 2.0;
}

test "a struct field is replaced in place" {
    let mut c = Cell { v: P { n: 1 } };
    c.set(P { n: 3 });
    assert c.v.n == 3;
}

__DATA__
{"test": {}}
