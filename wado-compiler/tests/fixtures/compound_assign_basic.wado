// Test basic compound assignment operators.
//
// Each step folds to the constant it reaches, which is what the flow-sensitive
// local environment buys: `x` is a `let mut`, and the environment carries its
// scalar value between writes rather than giving up at the binding.
//
// The value is pinned on the assignments, not on the `fmt_decimal` argument.
// `${x}` reads `x` inside a template region, and an address-taken primitive is
// stored boxed, so the region sees a `Box<i32>`-typed mention where the
// environment holds a scalar — which `region_free_reads` refuses to seed.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut x = 10;

    x += 5;
    println(`+= : ${x}`);  // 15

    x -= 3;
    println(`-= : ${x}`);  // 12

    x *= 2;
    println(`*= : ${x}`);  // 24

    x /= 4;
    println(`/= : ${x}`);  // 6

    x %= 4;
    println(`%= : ${x}`);  // 2
}

__DATA__
{
    "stdout": "+= : 15\n-= : 12\n*= : 24\n/= : 6\n%= : 2\n",
    "wir_expect:O2": [
        "x = 15;",
        "x = 12;",
        "x = 24;",
        "x = 6;",
        "x = 2;"
    ]
}
