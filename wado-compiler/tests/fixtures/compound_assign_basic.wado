// Test basic compound assignment operators.
//
// Each step folds to the constant it reaches, which is what the flow-sensitive
// local environment buys: `x` is a `let mut`, and the environment carries its
// scalar value between writes rather than giving up at the binding.
//
// The constant reaches the formatter, so `x` itself is gone by O2. Which
// spelling it takes there — an immediate or the boxed constant
// `const_object_globalization` hoists — is that pass's call, same bytes.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut x = 10;

    x += 5;
    println(`+= : ${x}`);  // 15

    x -= 3;
    println(`-= : ${x}`);  // 12

    x *= 2;
    println(`*= : ${x}`);  // 24

    x /= 4;
    println(`/= : ${x}`);  // 6

    x %= 4;
    println(`%= : ${x}`);  // 2
}

__DATA__
{
    "stdout": "+= : 15\n-= : 12\n*= : 24\n/= : 6\n%= : 2\n",
    "wir_expect:O2": [
        "Box<i32>\" { value: 15 }",
        "Box<i32>\" { value: 12 }",
        "Box<i32>\" { value: 24 }",
        "Box<i32>\" { value: 6 }",
        "Box<i32>\" { value: 2 }"
    ]
}
