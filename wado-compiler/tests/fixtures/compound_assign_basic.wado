// Test basic compound assignment operators

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut x = 10;

    x += 5;
    println(`+= : ${x}`);  // 15

    x -= 3;
    println(`-= : ${x}`);  // 12

    x *= 2;
    println(`*= : ${x}`);  // 24

    x /= 4;
    println(`/= : ${x}`);  // 6

    x %= 4;
    println(`%= : ${x}`);  // 2
}

__DATA__
{
    "stdout": "+= : 15\n-= : 12\n*= : 24\n/= : 6\n%= : 2\n",
    "wir_expect:O2": [
        "i32::fmt_decimal$spec0\"(15,",
        "i32::fmt_decimal$spec0\"(12,",
        "i32::fmt_decimal$spec0\"(24,",
        "i32::fmt_decimal$spec0\"(6,",
        "i32::fmt_decimal$spec0\"(2,"
    ]
}
