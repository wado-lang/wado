// Test basic compound assignment operators.
//
// Each step folds to the constant it reaches, which is what the flow-sensitive
// local environment buys: `x` is a `let mut`, and the environment carries its
// scalar value between writes rather than giving up at the binding.
//
// The absent `x = x` is what says the fold happened: at O0 each compound
// assignment is a read-modify-write, and none survives O2. The positives name
// the folded constants, whose spelling `const_object_globalization` owns.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut x = 10;

    x += 5;
    println(`+= : ${x}`);  // 15

    x -= 3;
    println(`-= : ${x}`);  // 12

    x *= 2;
    println(`*= : ${x}`);  // 24

    x /= 4;
    println(`/= : ${x}`);  // 6

    x %= 4;
    println(`%= : ${x}`);  // 2
}

__DATA__
{
    "stdout": "+= : 15\n-= : 12\n*= : 24\n/= : 6\n%= : 2\n",
    "wir_expect:O2": [
        "Box<i32>\" { value: 15 }",
        "Box<i32>\" { value: 12 }",
        "Box<i32>\" { value: 24 }",
        "Box<i32>\" { value: 6 }",
        "Box<i32>\" { value: 2 }"
    ],
    "wir_not_expect:O2": [
        "x = x"
    ]
}
