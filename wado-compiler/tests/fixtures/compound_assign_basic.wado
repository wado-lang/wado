// Test basic compound assignment operators.
//
// Each step folds to the constant it reaches, which is what the flow-sensitive
// local environment buys: `x` is a `let mut`, and the environment carries its
// scalar value between writes rather than giving up at the binding.
//
// The value is pinned on the rendered strings. `${x}` reads `x` inside a
// template region through the `Box<i32>` an address-taken primitive wears,
// and a shared box over a scalar seeds the region, so each template folds to
// its literal and the assignments themselves leave the WIR.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut x = 10;

    x += 5;
    println(`+= : ${x}`);  // 15

    x -= 3;
    println(`-= : ${x}`);  // 12

    x *= 2;
    println(`*= : ${x}`);  // 24

    x /= 4;
    println(`/= : ${x}`);  // 6

    x %= 4;
    println(`%= : ${x}`);  // 2
}

__DATA__
{
    "stdout": "+= : 15\n-= : 12\n*= : 24\n/= : 6\n%= : 2\n",
    "wir_expect:O2": [
        "array.new_data<u8>(\"+= : 15\")",
        "array.new_data<u8>(\"-= : 12\")",
        "array.new_data<u8>(\"*= : 24\")",
        "array.new_data<u8>(\"/= : 6\")",
        "array.new_data<u8>(\"%= : 2\")"
    ],
    "wir_not_expect:O2": ["fmt_decimal"]
}
