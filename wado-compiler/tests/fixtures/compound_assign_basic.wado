// Test basic compound assignment operators.
//
// Only the first fold is pinned. `x` is a `let mut`, which `niri`'s
// `clobbered_locals` disqualifies frame-wide, so once `sroa_param` passes it to
// `fmt_decimal` directly — instead of inside the `Box<i32>` that const-object
// globalization used to fold — region seeding cannot supply its value and the
// later `x = x - 3` chain stops folding. Flow-sensitive clobbering would
// restore the rest; `stdout` pins the semantics meanwhile.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut x = 10;

    x += 5;
    println(`+= : ${x}`);  // 15

    x -= 3;
    println(`-= : ${x}`);  // 12

    x *= 2;
    println(`*= : ${x}`);  // 24

    x /= 4;
    println(`/= : ${x}`);  // 6

    x %= 4;
    println(`%= : ${x}`);  // 2
}

__DATA__
{
    "stdout": "+= : 15\n-= : 12\n*= : 24\n/= : 6\n%= : 2\n",
    "wir_expect:O2": [
        "x = 15;"
    ]
}
