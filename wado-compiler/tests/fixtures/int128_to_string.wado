use { println, Stdout } from "core:cli";
use { u128_to_string, i128_to_string } from "core:internal";

fn run() with Stdout {
    // Test u128_to_string with zero
    let zero = u128::zero();
    println(u128_to_string(zero));  // 0

    // Test u128_to_string with small number
    let small = u128::from_u64(12345 as u64);
    println(u128_to_string(small));  // 12345

    // Test u128_to_string with larger number
    let large = u128::from_u64(9999999999 as u64);
    println(u128_to_string(large));  // 9999999999

    // Test i128_to_string with zero
    let i_zero = i128::zero();
    println(i128_to_string(i_zero));  // 0

    // Test i128_to_string with positive number
    let pos = i128::from_i64(42 as i64);
    println(i128_to_string(pos));  // 42

    // Test i128_to_string with negative number
    let neg = i128::from_i64(-12345 as i64);
    println(i128_to_string(neg));  // -12345

    // Test i128_to_string with large negative number
    let large_neg = i128::from_i64(-9876543210 as i64);
    println(i128_to_string(large_neg));  // -9876543210

    println("to_string tests passed!");
}

__DATA__
{"stdout": "0\n12345\n9999999999\n0\n42\n-12345\n-9876543210\nto_string tests passed!\n"}
