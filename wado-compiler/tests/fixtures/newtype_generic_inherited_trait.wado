// A generic newtype answers under its own head for the methods it declares,
// and under its base for the trait impls it inherits. Identity is its own
// either way, so `Inspect` renders the base's value and tags it with the
// declaration's name — the same as a non-generic newtype (issue #1933; this
// fixture recorded the missing tag as the expected output).

type MyArray<T> = List<T>;

impl<T: Display> MyArray<T> {
    fn first_label(&self) -> String {
        return `${self[0]}`;
    }
}

test "a generic newtype inherits its base's Inspect" {
    let a: MyArray<i32> = [1, 2];
    assert `${a:?}` == "[1, 2] as MyArray";
    assert a.first_label() == "1";
}

__DATA__
{"test": {}}
