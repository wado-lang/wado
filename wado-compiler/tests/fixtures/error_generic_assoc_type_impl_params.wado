// An impl binds a generic associated type with the parameters its trait
// declares: as many, each bounded as the trait bounds it, arguments included.
// The names are the impl's own.

trait Elem with () {}

trait Conv<T> with () {}

trait Store with () {
    type Buf<E: Elem>;
    type Pair<A, B>;
    type Converted<C: Conv<i32>>;
}

struct Lists {}

impl Store for Lists {
    type Buf<T> = List<T>;
    type Pair<A> = List<A>;
    type Converted<C: Conv<String>> = List<C>;
}

export fn run() {}

