// A branch still holding an unresolved `null` (`[null]`) is resolved again
// only where the branches agreed on the result type. Under an annotation it is
// checked at once; skipping it there let `[Option<!>]` through as an `i32`
// and the module failed validation.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let k = builtin::black_box(0);
    let x: i32 = match k { 0 => [null], _ => 1 };
    println(`${x}`);
}

__DATA__
{
    "compile_error": ":9:33: analysis error: type mismatch: expected 'i32', found '[Option<!>]'"
}
