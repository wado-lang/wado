//! A parameter holding two type packs in one tuple, with nothing else to
//! settle them. Every split of the argument satisfies it, so the call must say
//! which parameters it could not infer and ask for a turbofish. A pack shifts
//! what follows it, so no element is a mismatch by its position: `[1, "s", 2,
//! true]` fits `[..A, i32, ..B, bool]` at `A = []`.
//! See docs/wep-2026-03-14-variadic-type-parameters.md §6.

fn split<..A, ..B>(t: [..A, ..B]) -> i32 {
    return t.len();
}

fn around<..A, ..B>(t: [..A, i32, ..B, bool]) -> i32 {
    return t.len();
}

test "two packs in one parameter tuple settle neither" {
    assert split([1, true]) == 2;
    assert around([1, "s", 2, true]) == 4;
}

__DATA__
{
    "compile_error": "cannot infer type parameter `A`, `B` of function `split`",
    "compile_errors_contains": ["cannot infer type parameter `A`, `B` of function `around`"],
    "compile_errors_not_contains": ["type mismatch"]
}
