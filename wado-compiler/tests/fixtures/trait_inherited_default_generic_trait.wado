//! A generic trait's default body, inherited by a block that overrides nothing.
//! The body is emitted under the trait reference the block wrote (`Enc<A>`),
//! so the call has to name that too: minting the segment from the trait
//! declaration instead drops the arguments and names `Enc::make`, which nothing
//! declares.

trait Enc<T> {
    fn make() -> i32 {
        return 7;
    }
}

struct A {}

struct M {}

impl Enc<A> for M {}

test "an inherited default body keeps the block's trait arguments" {
    assert M::make() == 7;
}
