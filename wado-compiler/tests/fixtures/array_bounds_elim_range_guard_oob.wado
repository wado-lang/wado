// A guard proves its bound for the list it names only: `i < ys.len()` says
// nothing about `xs`, so the read of `xs[i]` keeps its check and traps.

use { println, Stdout } from "core:cli";

fn read(xs: &List<i32>, ys: &List<i32>, i: i32) -> i32 {
    if 0 <= i && i < ys.len() {
        return xs[i];
    }
    return 0;
}

export fn run() with Stdout {
    let xs: List<i32> = [10, 20];
    let ys: List<i32> = [1, 2, 3, 4];
    println(`${read(&xs, &ys, builtin::black_box(1))}`);
    println(`${read(&xs, &ys, builtin::black_box(3))}`);
}

__DATA__
{
    "stdout": "20\n",
    "trapped": true
}
