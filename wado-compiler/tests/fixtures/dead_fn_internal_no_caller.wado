// `internal` is package-internal-only visibility — the role `pub` played
// before the 2026-06-25 visibility redesign — so it is not a liveness root:
// an `internal fn` with no in-package caller is still dead code.
internal fn helper() -> i32 {
    return 1;
}

export fn run() {}

