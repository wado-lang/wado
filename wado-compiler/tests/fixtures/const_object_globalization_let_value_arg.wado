// A constant bound by `let` and passed by value to a callee that only reads its
// parameter hoists into a shared global, as the same literal written at the call
// site does (see `const_object_globalization_value_arg.wado`).
//
// Two reads keep the binding from being copy-propagated into its use, so it is
// the `let` itself that has to hoist. `bump_first` writes its parameter, so
// `tag` stays per call: the repeated `bump` results are the soundness check.
//
// Regression: a whole-value read of the binding counted as consuming it
// whatever the parameter did, so `name` was rebuilt on every call.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn head_len(s: List<u8>, bias: i32) -> i32 {
    return s.len() + bias;
}

#[inline(never)]
fn bump_first(mut v: List<u8>, bias: i32) -> i32 {
    v[0] = v[0] + 1;
    return v[0] as i32 + bias;
}

#[inline(never)]
fn measure(bias: i32) -> i32 {
    let name: List<u8> = b"hello";
    if bias > 100 {
        return head_len(name, bias);
    }
    return head_len(name, bias) * 10;
}

#[inline(never)]
fn bump(bias: i32) -> i32 {
    let tag: List<u8> = b"abc";
    if bias > 100 {
        return bump_first(tag, bias);
    }
    return bump_first(tag, bias) * 10;
}

export fn run() with Stdout {
    let zero = builtin::black_box(0);
    println(`${measure(zero)} ${measure(zero)} ${bump(zero)} ${bump(zero)}`);
}

__DATA__
{
    "stdout": "50 50 980 980\n",
    "wir_expect:O2": ["tag = struct.new"],
    "wir_not_expect:O2": ["name = struct.new"]
}
