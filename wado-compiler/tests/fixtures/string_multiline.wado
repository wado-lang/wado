use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Multiline double-quoted string
    let poem = "Roses are red,
Violets are blue,
Wado is great,
And so are you!";
    println(poem);

    // Multiline with escape sequences
    let mixed = "Line with tab:\there
Next line";
    println(mixed);

    // Empty lines in multiline string
    let with_empty = "First

Third";
    println(with_empty);

    println("done");
}

__DATA__
{"stdout": "Roses are red,\nViolets are blue,\nWado is great,\nAnd so are you!\nLine with tab:\there\nNext line\nFirst\n\nThird\ndone\n"}
