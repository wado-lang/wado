// TreeMap index operations (bracket syntax)
use { println } from "core:cli";
use { TreeMap } from "core:collections";

export fn run() with Stdout {
    let mut map = TreeMap::<String, i32>::new();

    // Index assignment
    map["one"] = 1;
    map["two"] = 2;
    map["three"] = 3;

    assert map.len() == 3;
    assert map.contains_key("one");
    assert map.contains_key("two");
    assert map.contains_key("three");

    // Index value access
    assert map["one"] == 1;
    assert map["two"] == 2;

    // Update via index
    map["one"] = 100;
    assert map["one"] == 100;

    // Nonexistent key
    assert !map.contains_key("nonexistent");

    println("index operations: ok");
}

__DATA__
{"stdout": "index operations: ok\n"}
