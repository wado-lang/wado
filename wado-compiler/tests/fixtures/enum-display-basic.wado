// Test: Enum inspect in template strings
use { println, Stdout } from "core:cli";

enum Color {
    Red,
    Green,
    Blue,
}

export fn run() with Stdout {
    let r = Color::Red;
    let g = Color::Green;
    let b = Color::Blue;

    println(`{r:?}`);
    println(`{g:?}`);
    println(`{b:?}`);
}

__DATA__
{"stdout": "Color::Red\nColor::Green\nColor::Blue\n"}
