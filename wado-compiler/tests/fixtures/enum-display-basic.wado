// Test: Enum Display falls back to inspect when no Display impl
use { println, Stdout } from "core:cli";

enum Color {
    Red,
    Green,
    Blue,
}

export fn run() with Stdout {
    let r = Color::Red;
    let g = Color::Green;
    let b = Color::Blue;

    // No Display impl → falls back to inspect (typename-qualified)
    println(`{r}`);
    println(`{g}`);
    println(`{b}`);
}

__DATA__
{"stdout": "Color::Red\nColor::Green\nColor::Blue\n"}
