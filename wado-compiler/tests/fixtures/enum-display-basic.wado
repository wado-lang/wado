// Test: Enum auto-derived Display trait (template string stringification)
use { println, Stdout } from "core:cli";

enum Color {
    Red,
    Green,
    Blue,
}

export fn run() with Stdout {
    let r = Color::Red;
    let g = Color::Green;
    let b = Color::Blue;

    println(`{r}`);
    println(`{g}`);
    println(`{b}`);
}

__DATA__
{"stdout": "Red\nGreen\nBlue\n"}
