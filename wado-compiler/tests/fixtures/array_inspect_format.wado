// Formatting an `Array<T>` directly via the template format traits.
// `Array<T>` is `ResolvedType::BuiltinArray`, which the template synthesis
// dispatch (`method_name_for_type`) once routed through its `_` fallback,
// mangling the receiver as `Array<i32>` and tripping `LocalMethodName::new`'s
// "no type params in the base struct name" invariant.

fn make(a: i32, b: i32, c: i32) -> Array<i32> {
    let mut arr: Array<i32> = Array::new(3);
    arr[0] = a;
    arr[1] = b;
    arr[2] = c;
    return arr;
}

test "inspect" {
    let arr = make(1, 2, 3);
    assert `{arr:?}` == "[1, 2, 3]";
}

test "display" {
    let arr = make(1, 2, 3);
    assert `{arr}` == "[1, 2, 3]";
}

test "inspect empty" {
    let arr: Array<i32> = Array::new(0);
    assert `{arr:?}` == "[]";
}

test "pretty-print" {
    let arr = make(1, 2, 3);
    assert `{arr:#?}` == "[
  1,
  2,
  3,
]";
}

__DATA__
{"test": {}}
