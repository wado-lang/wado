// Formatting an `Array<T>` directly via the template format traits. `Array<T>`
// is `ResolvedType::BuiltinArray`; the template dispatch must mangle it under
// the base name `Array`, not the full `Array<i32>` (which trips
// `LocalMethodName::new`'s no-type-params invariant).

fn make(a: i32, b: i32, c: i32) -> Array<i32> {
    let mut arr: Array<i32> = Array::new(3);
    arr[0] = a;
    arr[1] = b;
    arr[2] = c;
    return arr;
}

test "inspect" {
    let arr = make(1, 2, 3);
    assert `{arr:?}` == "[1, 2, 3]";
}

test "display" {
    let arr = make(1, 2, 3);
    assert `{arr}` == "[1, 2, 3]";
}

test "inspect empty" {
    let arr: Array<i32> = Array::new(0);
    assert `{arr:?}` == "[]";
}

test "pretty-print" {
    let arr = make(1, 2, 3);
    assert `{arr:#?}` == "[
  1,
  2,
  3,
]";
}
