// A record or variant one interface declares crosses in another interface's
// function too, whether or not its own interface is imported.

#[cm("example:demo/node", linearity = "unrestricted", classes = "0..=0")]
resource Node {}

#[cm("example:demo/node#pair")]
struct Pair {
    #[cm("a")]
    a: Node,
}

#[cm("example:demo/types#node-or-string")]
variant NodeOrString {
    #[cm("as-node")]
    AsNode(Node),
    #[cm("as-string")]
    AsString(String),
}

#[cm("example:demo/global")]
interface Dom {
    #[cm("example:demo/global#touch")]
    fn touch(v: NodeOrString) -> i32;

    #[cm("example:demo/global#touch-pair")]
    fn touch_pair(p: Pair) -> i32;

    #[cm("example:demo/global#root")]
    fn root() -> Node;
}

export fn run() with Dom {
    let n = Dom::root();
    let _ = Dom::touch(NodeOrString::AsNode(n));
    let _ = Dom::touch_pair(Pair { a: n });
}

__DATA__
{
  "compile_only": true,
  "skip_os": true,
  "wat_lines": [
    { "contains": ["(variant (case \"as-node\" f64) (case \"as-string\" string))"], "count": 1 },
    { "contains": ["(record (field \"a\" f64))"], "count": 1 }
  ]
}
