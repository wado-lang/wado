// Test i16 basic operations
use { println, Stdout } from "core:cli";

fn run() with Stdout {
    // Basic assignment
    let a: i16 = 1000 as i16;
    let b: i16 = 30 as i16;

    // Arithmetic operations
    let sum = a + b;
    println(`sum: {sum}`);

    let diff = a - b;
    println(`diff: {diff}`);

    let prod = a * b;
    println(`prod: {prod}`);

    let quot = a / b;
    println(`quot: {quot}`);

    let rem = a % b;
    println(`rem: {rem}`);
}

__DATA__
{"stdout": "sum: 1030\ndiff: 970\nprod: 30000\nquot: 33\nrem: 10\n"}
