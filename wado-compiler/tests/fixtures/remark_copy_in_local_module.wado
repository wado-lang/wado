// The entry package is more than its entry point. A copy in a local module is
// the program's own cost, and the remark names that module's file.

use { println, Stdout, Environment, args } from "core:cli";
use { grow } from "./sub/remark_copy_helper.wado";

export fn run() with (Stdout, Environment) {
    println(`${grow(args().len() as i32)}`);
}

__DATA__
{
    "stdout": "5\n",
    "remarks": {"O2": [{"contains": ["remark_copy_helper.wado:9:5 remark: a copy of"]}]}
}
