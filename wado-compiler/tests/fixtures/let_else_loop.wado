// Test: `let ... else` inside a loop may diverge via `break`/`continue`,
// and bindings escape into the enclosing scope for the rest of the block.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let items: List<Option<i32>> = [Option::Some(1), null, Option::Some(3)];
    let mut sum = 0;
    for let it of items {
        let Some(n) = it else {
            continue;
        };
        sum += n;
    }
    println(`${sum}`);

    let mut i = 0;
    loop {
        let Some(v) = at(i) else {
            break;
        };
        println(`v=${v}`);
        i += 1;
    }
}

fn at(i: i32) -> Option<i32> {
    if i < 2 {
        return Option::Some(i * 10);
    }
    return null;
}

__DATA__
{"stdout": "4\nv=0\nv=10\n"}
