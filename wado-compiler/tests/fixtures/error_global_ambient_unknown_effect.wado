// An `#[ambient]` argument on a global must name an effect in scope, as on a
// function.

use { println, Stdout } from "core:cli";

#[ambient(Nonexistent)]
global SEVEN: i32 = 7;

export fn run() with Stdout {
    println(`${SEVEN}`);
}

__DATA__
{
    "compile_error": "`#[ambient(Nonexistent)]` on 'SEVEN' names no effect in scope",
    "compile_error_codes": ["UNKNOWN_TYPE"]
}
