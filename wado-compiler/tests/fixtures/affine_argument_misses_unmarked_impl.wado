// An `impl` whose type parameter is not declared `affine` does not apply to an
// affine argument, and a call of its method reports the kind the argument
// misses rather than an absent method (WEP: Affine Types).

affine struct Fields {
    n: i32,
}

impl Drop for Fields {
    fn drop(self) {}
}

struct Cell<affine T> {
    value: T,
}

impl<T> Cell<T> {
    fn twice(&self) -> [T, T] {
        return [self.value, self.value];
    }
}

export fn run() {
    let cell = Cell { value: Fields { n: 1 } };
    let pair = cell.twice();
}

__DATA__
{
    "compile_error": ":25:16: analysis error: affine type 'Fields' given for 'T', which may be copied; `affine T` would admit it",
    "compile_error_codes": ["AFFINE_ARGUMENT"]
