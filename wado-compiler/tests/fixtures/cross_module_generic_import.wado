// Test cross-module monomorphization of generic functions
use { println, Stdout } from "core:cli";
use { identity, make_pair } from "./cross_module_generic_helper.wado";

export fn run() with Stdout {
    // Use the generic identity function with i32
    let x = identity::<i32>(42);
    println(`identity<i32>(42) = ${x}`);

    // Use the generic identity function with String
    let s = identity::<String>("hello");
    println(`identity<String>(hello) = ${s}`);

    // Use the generic make_pair function
    let pair = make_pair::<i32, String>(10, "world");
    println(`make_pair = (${pair.0}, ${pair.1})`);
}

__DATA__
{"stdout": "identity<i32>(42) = 42\nidentity<String>(hello) = hello\nmake_pair = (10, world)\n"}
