// Test: uppercase global constants in if conditions should not be
// parsed as struct literals. MY_CONST is SCREAMING_SNAKE_CASE,
// not UpperCamelCase, so `MY_CONST {` should NOT be a struct literal.

use { println, Stdout } from "core:cli";

global MY_CONST: i32 = 0;
global ANOTHER: i32 = 1;

fn dispatch(x: i32) -> i32 {
    let mut result = -1;
    if x == MY_CONST {
        result = 100;
    } else if x == ANOTHER {
        result = 200;
    }
    return result;
}

export fn run() with Stdout {
    println(`{dispatch(0)}`);
    println(`{dispatch(1)}`);
    println(`{dispatch(2)}`);
}

__DATA__
{"stdout": "100\n200\n-1\n"}
