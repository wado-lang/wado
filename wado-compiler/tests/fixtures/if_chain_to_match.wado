// A long run of mutually exclusive `if K == x` siblings becomes one `br_table`
// instead of a chain that tests every key for every value.

use { println, Stdout } from "core:cli";

fn dispatch(x: i32) -> i32 {
    let mut out = 0;
    if 0 == x { out = 100 }
    if 1 == x { out = 101 }
    if 2 == x { out = 102 }
    if 3 == x { out = 103 }
    if 4 == x { out = 104 }
    if 5 == x { out = 105 }
    if 6 == x { out = 106 }
    if 7 == x { out = 107 }
    if 8 == x { out = 108 }
    if 9 == x { out = 109 }
    if 10 == x { out = 110 }
    if 11 == x { out = 111 }
    return out;
}

export fn run() with Stdout {
    println(`${dispatch(builtin::black_box(0))}`);
    println(`${dispatch(builtin::black_box(7))}`);
    println(`${dispatch(builtin::black_box(11))}`);
    println(`${dispatch(builtin::black_box(12))}`);
}

__DATA__
{
    "stdout": "100\n107\n111\n0\n",
    "wir_expect:O2": ["br_table"]
}
