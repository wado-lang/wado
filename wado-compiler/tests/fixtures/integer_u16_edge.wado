// Test u16 edge cases: max value and unsigned semantics
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Max value: 65535
    let max: u16 = 65535 as u16;
    println(`max: {max}`);

    // Min value: 0
    let min: u16 = 0 as u16;
    println(`min: {min}`);

    // Division with large values
    let a: u16 = 60000 as u16;
    let b: u16 = 7 as u16;
    let div_result = a / b;
    println(`60000 / 7: {div_result}`);

    // Modulo with large values
    let mod_result = a % b;
    println(`60000 % 7: {mod_result}`);
}

__DATA__
{"stdout": "max: 65535\nmin: 0\n60000 / 7: 8571\n60000 % 7: 3\n"}
