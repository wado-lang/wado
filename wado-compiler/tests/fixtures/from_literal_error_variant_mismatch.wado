// KeyValueLiteral error: variant in concrete impl position rejects wrong type.
// Before the is_known_type_name fix, Status was treated as a free type parameter,
// so StatusMap<String, i32> incorrectly matched the impl.
variant Status { Active, Inactive }

struct StatusMap<S, V> {
    keys: Array<String>,
    values: Array<V>,
}

impl KeyValueLiteralBuilder for StatusMap<Status, V> {
    type Value = V;
    type Output = StatusMap<Status, V>;

    fn new_literal(capacity: i32) -> StatusMap<Status, V> {
        return StatusMap { keys: [], values: [] };
    }

    fn insert_literal(&mut self, key: String, value: Self::Value) {
        self.keys.push(key);
        self.values.push(value);
    }

    fn build(&self) -> StatusMap<Status, V> {
        return *self;
    }
}

export fn run() {
    // String != Status — should fail to find impl
    let m: StatusMap<String, i32> = { a: 1 };
}

__DATA__
{"compile_error": "does not implement KeyValueLiteral"}
