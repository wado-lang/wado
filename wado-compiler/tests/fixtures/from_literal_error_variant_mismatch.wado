// Key-value literal error: variant in concrete impl position rejects wrong type.
// Read as a free type parameter, Status would let StatusMap<String, i32> match
// the impl.
variant Status { Active, Inactive }

struct StatusMap<S, V> {
    keys: List<String>,
    values: List<V>,
}

impl<V> From<Array<[String, V]>> for StatusMap<Status, V> {
    fn from(entries: Array<[String, V]>) -> StatusMap<Status, V> {
        let mut out: StatusMap<Status, V> = StatusMap { keys: [], values: [] };
        for let [key, value] of entries {
            out.keys.push(key);
            out.values.push(value);
        }
        return out;
    }
}

export fn run() {
    // String != Status — should fail to find impl
    let m: StatusMap<String, i32> = { a: 1 };
}

__DATA__
{"compile_error": "cannot be built from an object literal"}
