// Test integer literal coercion in arithmetic binary operators for i128/u128
// Uses check() instead of assert to avoid pre-existing u128 template interpolation bug
use { println, Stdout } from "core:cli";

fn check(cond: bool, label: String) {
    if !cond {
        panic(label);
    }
}

export fn run() with Stdout {
    let x_u128: u128 = 1000;
    let x_i128: i128 = -500;

    // + with literal on both sides
    let a1 = x_u128 + 42;
    check(a1 == 1042 as u128, "+ u128 rhs");
    let a2 = 42 + x_u128;
    check(a2 == 1042 as u128, "+ lhs u128");
    let a3 = x_i128 + 100;
    check(a3 == -400 as i128, "+ i128 rhs");
    let a4 = 100 + x_i128;
    check(a4 == -400 as i128, "+ lhs i128");

    // - with literal on both sides
    let b1 = x_u128 - 100;
    check(b1 == 900 as u128, "- u128 rhs");
    let b2 = 2000 - x_u128;
    check(b2 == 1000 as u128, "- lhs u128");
    let b3 = x_i128 - 100;
    check(b3 == -600 as i128, "- i128 rhs");
    let b4 = 100 - x_i128;
    check(b4 == 600 as i128, "- lhs i128");

    // * with literal on both sides
    let c1 = x_u128 * 3;
    check(c1 == 3000 as u128, "* u128 rhs");
    let c2 = 3 * x_u128;
    check(c2 == 3000 as u128, "* lhs u128");
    let c3 = x_i128 * 2;
    check(c3 == -1000 as i128, "* i128 rhs");
    let c4 = 2 * x_i128;
    check(c4 == -1000 as i128, "* lhs i128");

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
