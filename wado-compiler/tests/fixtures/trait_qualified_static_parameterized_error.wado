// A trait's turbofish is its argument list, so `Take::<i32>::take()` names no
// receiver: a static's receiver is bound as `Self` beside the arguments, or
// written out as `V::take()`, where the arguments select among the impls.

trait Take<A> with () {
    fn take() -> A;
}

trait Plain with () {
    fn plain() -> i32;
}

struct V {}

impl Take<i32> for V {
    fn take() -> i32 {
        return 7;
    }
}

impl Plain for V {
    fn plain() -> i32 {
        return 1;
    }
}

export fn run() {
    let _ = V::take();
    let _ = Take::<i32, Self = V>::take();
    let _ = Take::<i32>::take();
    let _ = Plain::<V>::plain();
    let _ = V::<Self = V>::take();
}

__DATA__
{
  "compile_error": "'Take::take' takes no receiver",
  "compile_errors_contains": [
    ":30:13: error: 'Take::take' takes no receiver, and the turbofish of 'Take' is its argument list; bind the receiver as 'Self', e.g. 'Take::<Self = Receiver>::take(…)'",
    ":31:13: error: 'Plain::plain' takes no receiver",
    ":32:13: error: 'V' is not a trait, and only a trait's turbofish binds 'Self'"
  ]
}
