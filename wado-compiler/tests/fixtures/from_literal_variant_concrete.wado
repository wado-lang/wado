use { println, Stdout } from "core:cli";

variant Status {
    Active,
    Inactive,
}

struct StatusMap<S, V> {
    keys: List<String>,
    values: List<V>,
}

impl KeyValueLiteralBuilder for StatusMap<Status, V> {
    type Value = V;
    type Output = StatusMap<Status, V>;

    fn new_literal(capacity: i32) -> StatusMap<Status, V> {
        return StatusMap { keys: [], values: [] };
    }

    fn insert_literal(&mut self, key: String, value: Self::Value) {
        self.keys.push(key);
        self.values.push(value);
    }

    fn build(&self) -> StatusMap<Status, V> {
        return *self;
    }
}

export fn run() with Stdout {
    let m: StatusMap<Status, i32> = { active: 1, inactive: 2 };
    assert m.keys.len() == 2;
    assert m.values[0] == 1;
    println("ok");
}

__DATA__
{"stdout": "ok\n"}
