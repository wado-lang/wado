use { println, Stdout } from "core:cli";

variant Status {
    Active,
    Inactive,
}

struct StatusMap<S, V> {
    keys: List<String>,
    values: List<V>,
}

impl From<Array<[String, V]>> for StatusMap<Status, V> {
    fn from(entries: Array<[String, V]>) -> StatusMap<Status, V> {
        let mut out: StatusMap<Status, V> = StatusMap { keys: [], values: [] };
        for let [key, value] of entries {
            out.keys.push(key);
            out.values.push(value);
        }
        return out;
    }
}

export fn run() with Stdout {
    let m: StatusMap<Status, i32> = { active: 1, inactive: 2 };
    assert m.keys.len() == 2;
    assert m.values[0] == 1;
    println("ok");
}

__DATA__
{"stdout": "ok\n"}
