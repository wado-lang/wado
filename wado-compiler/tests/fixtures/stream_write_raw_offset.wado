// Test: StreamWritable::write_raw writes exactly the slice's byte window.
// A larger buffer "XXerr msg\nYY" is written as its middle 8 bytes only (a
// non-zero slice start), so verifying stderr receives exactly "err msg\n"
// exercises the slice offset.
//
// Consumer is started before the write: CM streams are zero-buffered
// rendezvous channels, so the reader must exist before stream.write.
use { Stderr } from "core:cli";

export fn run() with Stderr {
    let [rx, tx] = Stream::<u8>::new();
    let subtask = Stderr::write_via_stream(rx);

    let list: List<u8> = [88, 88, 101, 114, 114, 32, 109, 115, 103, 10, 89, 89];
    let buf = list.to_array();
    tx.write_raw(buf.slice(2, 10));

    tx.drop();
    subtask.read();
}

__DATA__
{"stderr": "err msg\n"}
