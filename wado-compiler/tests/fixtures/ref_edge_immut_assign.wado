// Error: attempting to assign through immutable reference
// Requires: compiler should reject *r = value when r is &T (not &mut T)

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut a = 42;
    let r = &a;  // immutable reference
    *r = 99;     // Error: cannot assign through immutable reference
    println(`{a}`);
}

