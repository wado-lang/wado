//! A parameter tuple holding two packs, settled by an explicit turbofish. The
//! axis list of a tensor is the case: `[..Pre, K, ..Post]` names the axis to
//! contract wherever it sits, and the call spells the ends.
//! See docs/wep-2026-03-14-variadic-type-parameters.md §6.

struct Tensor<E, Axes> {
    extents: List<i32>,
}

struct Batch {}
struct Row {}
struct Col {}

fn rank<E, ..Pre, K, ..Post>(t: &Tensor<E, [..Pre, K, ..Post]>) -> i32 {
    return t.extents.len();
}

test "a turbofish spells the ends and the middle falls out" {
    let t: Tensor<f32, [Batch, Row, Col]> = Tensor { extents: [2, 3, 4] };
    assert rank::<f32, [Batch], Row, [Col]>(&t) == 3;
}

test "an empty end" {
    let t: Tensor<f32, [Row, Batch, Col]> = Tensor { extents: [3, 2, 4] };
    assert rank::<f32, [], Row, [Batch, Col]>(&t) == 3;
}
