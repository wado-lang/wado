// `copy_prop` forwards `let self = &mut out` into `self.repr` as
// `(&mut out).repr`, and `const_fold` runs before a peephole round folds it.
// That borrow names `out.repr`, no handle of its own, but the compile-time
// interpreter took it for one and gave up on `out`, so `apply_case` stopped
// folding a camelCase key into a constant and the serializer built the key
// afresh on every call.
use { println, Stdout } from "core:cli";
use { to_bytes } from "core:cbor";

#[wire(name_policy = "camelCase")]
struct Price {
    amount: i64,
    seat_category_id: i64,
}

export fn run() with Stdout {
    let p = builtin::black_box(Price { amount: 1, seat_category_id: 3 });
    println(`${to_bytes(&p).unwrap().len()}`);
}

__DATA__
{
    "stdout": "25\n",
    "wir_pass": {"O2": ["nir/const_fold"]},
    "wir_expect:O2": ["$const_obj_{}: ref \"core:prelude/slice.wado//Slice<u8>\" = struct.new \"core:prelude/slice.wado//Slice<u8>\" { repr: array.new_fixed<u8>(115, 101, 97, 116, 67, 97, 116, 101, 103, 111, 114, 121, 73, 100)"],
    "wir_not_expect:O2": ["builtin::array_new<u8>(14)"]
}
