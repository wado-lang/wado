// Range-based array slicing via IndexValue

test "exclusive range slice" {
    let arr: Array<i32> = [10, 20, 30, 40, 50];
    let slice = arr[1..<4];
    assert slice.len() == 3;
    assert slice[0] == 20;
    assert slice[1] == 30;
    assert slice[2] == 40;
}

test "inclusive range slice" {
    let arr: Array<i32> = [10, 20, 30, 40, 50];
    let slice = arr[2..=4];
    assert slice.len() == 3;
    assert slice[0] == 30;
    assert slice[1] == 40;
    assert slice[2] == 50;
}

__DATA__
{"test": {}}
