// Test that spread expression is evaluated only once, even when it has side effects.
global mut call_count: i32 = 0;

fn make_pair() -> [i32, i32] {
    call_count = call_count + 1;
    return [10, 20];
}

fn prepend<A, ..T>(a: A, rest: [..T]) -> [A, ..T] {
    return [a, ..rest];
}

export fn run() {
    // Concrete spread: the function should be called once
    let a = [..make_pair(), 30];
    assert a.0 == 10;
    assert a.1 == 20;
    assert call_count == 1, "make_pair() should be called exactly once for concrete spread";

    // Variadic spread: the function should be called once
    let b = prepend(99, make_pair());
    assert b.0 == 99;
    assert b.1 == 10;
    assert b.2 == 20;
    assert call_count == 2, "make_pair() should be called exactly once for variadic spread";
}

__DATA__
{"stdout": ""}
