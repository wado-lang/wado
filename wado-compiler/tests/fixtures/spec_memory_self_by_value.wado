// A by-value `self` on a type that holds no resource copies the receiver at
// every call, so the declaration warns and the caller keeps its value.

struct Point { x: i32, y: i32 }

impl Point {
    fn consume(self) -> i32 { return self.x; }
}

export fn run() {
    let p = Point { x: 1, y: 2 };
    assert p.consume() == 1;
    assert p.y == 2;
}

__DATA__
{"warnings_contains":["`self` by value copies `Point` at every call; take `&self`, or mark it `#[allow(self_by_value)]` if the copy is meant"]}
