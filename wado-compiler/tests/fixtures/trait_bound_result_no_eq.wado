// Test: Result<Foo, String> == fails when Foo doesn't implement Eq
variant NoEq {
    A(i32),
    B,
}

struct Foo {
    x: NoEq,
}

export fn run() {
    let a: Result<Foo, String> = Result::<Foo, String>::Ok(Foo { x: NoEq::A(1) });
    let b: Result<Foo, String> = Result::<Foo, String>::Ok(Foo { x: NoEq::A(1) });
    assert a == b;
}

__DATA__
{"compile_error": "=="}
