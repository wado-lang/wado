// Test: monomorphized Array methods should be correctly attributed to their
// defining module, enabling cross-module inlining. When the elaborator correctly
// sets module_source on FunctionRef and monomorphize preserves defining_module,
// the inline pass can match candidates across modules.

export fn run() {
    let mut arr: Array<i32> = [10, 20, 30];
    arr.push(40);
    assert arr.len() == 4;
}

