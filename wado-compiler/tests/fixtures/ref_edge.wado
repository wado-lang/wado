use { println, Stdout } from "core:cli";

// from ref_edge_coercion.wado
fn read_value(x: &i32) -> i32 {
    return *x;
}

// from ref_edge_multi_mut.wado
fn increment(x: &mut i32) {
    *x = *x + 1;
}

// from ref_edge_coercion.wado
fn ref_edge_coercion() with Stdout {
    let mut a = 42;
    let result = read_value(&mut a);  // Passing &mut to & param
    println(`{result}`);
}

// from ref_edge_double_deref.wado
fn ref_edge_double_deref() with Stdout {
    let mut a = 42;
    let mut r = &mut a;  // r must be mutable to take &mut r
    let rr = &mut r;
    **rr = 99;  // Assign through double reference
    println(`{a}`);
}

// from ref_edge_multi_mut.wado
fn ref_edge_multi_mut() with Stdout {
    let mut a = 10;
    increment(&mut a);
    increment(&mut a);
    increment(&mut a);
    println(`{a}`);
}

// from ref_edge_nested.wado
fn ref_edge_nested() with Stdout {
    let mut a = 42;
    let r = &mut a;
    let rr = &r;  // Reference to reference
    println(`{**rr}`);
}

// from ref_edge_temp.wado
fn ref_edge_temp() with Stdout {
    let r = &(1 + 2);  // Reference to temporary
    println(`{*r}`);
}

export fn run() with Stdout {
    ref_edge_coercion();
    ref_edge_double_deref();
    ref_edge_multi_mut();
    ref_edge_nested();
    ref_edge_temp();
}

__DATA__
{"stdout": "42\n99\n13\n42\n3\n"}
