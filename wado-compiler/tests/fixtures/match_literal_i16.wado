// Test match expression with i16 literal patterns

use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let x: i16 = 42 as i16;
    let y: i16 = 0 as i16;
    let z: i16 = -100 as i16;

    let r1 = match x {
        0 => "zero",
        42 => "answer",
        _ => "other",
    };
    println(r1);

    let r2 = match y {
        0 => "zero",
        _ => "other",
    };
    println(r2);

    let r3 = match z {
        0 => "zero",
        -100 => "minus hundred",
        _ => "other",
    };
    println(r3);
}

__DATA__
{"stdout": "answer\nzero\nminus hundred\n"}
