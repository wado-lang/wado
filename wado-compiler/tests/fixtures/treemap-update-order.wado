// TreeMap update preserves insertion order
use { println, print } from "core:cli";
use { TreeMap } from "core:collections";

export fn run() with Stdout {
    let mut map = TreeMap::<String, i32>::new();

    // Insert: a, b, c
    map["a"] = 1;
    map["b"] = 2;
    map["c"] = 3;

    // Update "a" - should preserve its position as first
    map["a"] = 100;

    // Update "b" - should preserve its position as second
    map["b"] = 200;

    let keys = map.keys();
    assert keys.len() == 3;
    assert keys[0] == "a", "a should still be first after update";
    assert keys[1] == "b", "b should still be second after update";
    assert keys[2] == "c", "c should still be third";

    let values = map.values();
    assert values[0] == 100, "a's value should be updated to 100";
    assert values[1] == 200, "b's value should be updated to 200";
    assert values[2] == 3, "c's value should be unchanged";

    // Insert new key "d" - should go to end
    map["d"] = 4;
    let keys2 = map.keys();
    assert keys2[3] == "d", "new key d should be at end";

    println("update preserves order: ok");
}

__DATA__
