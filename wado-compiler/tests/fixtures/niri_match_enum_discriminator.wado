// `x matches { Enum::Case }` answers whether `x` holds that case, as a
// comparison of its discriminator.

use { println, Stdout } from "core:cli";

enum Color { Red, Green, Blue }

#[inline(never)]
fn pick(n: i32) -> Color {
    if n == 0 {
        return Color::Red;
    }
    if n == 1 {
        return Color::Green;
    }
    return Color::Blue;
}

export fn run() with Stdout {
    let a = pick(0) matches { Red };
    let b = pick(1) matches { Red };
    let c = pick(2) matches { Blue };
    let d = pick(0) matches { Blue };
    assert a;
    assert !b;
    assert c;
    assert !d;
    println(`${a} ${b} ${c} ${d}`);
}

__DATA__
{
    "stdout": "true false true false\n"
}
