#![TODO]
// A program's own `Client::send` is refused because `wasi:http` declares a
// `Client::send` too, which the program never imports: a call finds its
// Component Model binding by `Interface::operation` alone, not by the
// declaration it names.

#[cm("example:demo/client")]
interface Client {
    #[cm("example:demo/client#send")]
    #[cm_params("n")]
    fn send(n: i32) -> i32;
}

struct Mock {}

impl Client for Mock {
    fn send(&mut self, n: i32) -> i32 {
        resume n + 1
    }
}

test {
    with Client => &mut Mock {} do {
        assert Client::send(1) == 2;
    }
}
