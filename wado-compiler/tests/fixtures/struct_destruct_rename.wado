// Struct destructuring with field renaming

use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

struct Person {
    name: String,
    age: i32,
    email: String,
}

export fn run() with Stdout {
    let p = Point { x: 10, y: 20 };

    // Rename both fields
    let { x: horizontal, y: vertical } = p;
    println(`{horizontal}, {vertical}`);

    // Mix shorthand and renamed
    let { x, y: vertical2 } = p;
    println(`{x}, {vertical2}`);

    // Rename with rest
    let person = Person { name: "Alice", age: 30, email: "alice@example.com" };
    let { name: n, .. } = person;
    println(`{n}`);

    // Named form with rename
    let Point { x: a, y: b } = p;
    println(`{a}, {b}`);
}

__DATA__
{"stdout": "10, 20\n10, 20\nAlice\n10, 20\n"}
