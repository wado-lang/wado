// Test: struct with Array<Array<i32>> field - constructed step by step
// This avoids the literal coercion question by constructing arrays explicitly
use { println, Stdout } from "core:cli";

struct Matrix {
    data: Array<Array<i32>>,
    rows: i32,
}

export fn run() with Stdout {
    let row1: Array<i32> = [1, 2];
    let row2: Array<i32> = [3, 4];
    let data: Array<Array<i32>> = [row1, row2];
    let m = Matrix { data: data, rows: 2 };
    println(`{m:?}`);
}

__DATA__
{"stdout": "Matrix { data: [[1, 2], [3, 4]], rows: 2 }\n"}
