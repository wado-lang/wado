// A function-local `struct` is a declaration whose *type* renders a mangled
// name. A pattern qualifier compared against that rendering matches nothing, so
// two sibling functions each declaring `Local` used to report
// `expected 'Local', found 'Local'`.

fn first() -> i32 {
    struct Local {
        first: i32,
        second: i32,
    }

    let Local { first, second } = Local { first: 7, second: 8 };
    return first * 10 + second;
}

fn second() -> i32 {
    struct Local {
        only: i32,
    }

    let Local { only } = Local { only: 3 };
    return only;
}

test "a function-local struct's pattern names its own declaration" {
    assert first() == 78;
    assert second() == 3;
}
