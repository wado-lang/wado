use {println, Stdout} from "core:cli";

fn run() with Stdout {
    // Test u128 creation
    let a = u128::from_u64(100 as u64);
    let b = u128::from_u64(50 as u64);

    // Test u128 addition
    let sum = a.add(&b);
    println(`u128 100 + 50 = {sum.low()}`);

    // Test u128 subtraction
    let diff = a.sub(&b);
    println(`u128 100 - 50 = {diff.low()}`);

    // Test u128 equality
    let c = u128::from_u64(100 as u64);
    if a == c {
        println("u128: 100 == 100 is true");
    }

    // Test u128 comparison
    if b < a {
        println("u128: 50 < 100 is true");
    }

    // Test i128 creation
    let x = i128::from_i64(100 as i64);
    let y = i128::from_i64(-50 as i64);

    // Test i128 addition
    let sum2 = x.add(&y);
    println(`i128 100 + (-50) = {sum2.low()}`);

    // Test i128 with negative result
    let z = i128::from_i64(30 as i64);
    let diff2 = z.sub(&x);
    if diff2.is_negative() {
        println("i128: 30 - 100 is negative");
    }

    // Test i128 negation
    let neg_x = x.neg();
    if neg_x.is_negative() {
        println("i128: -100 is negative");
    }

    println("All i128/u128 tests passed!");
}

__DATA__
{"stdout": "u128 100 + 50 = 150\nu128 100 - 50 = 50\nu128: 100 == 100 is true\nu128: 50 < 100 is true\ni128 100 + (-50) = 50\ni128: 30 - 100 is negative\ni128: -100 is negative\nAll i128/u128 tests passed!\n"}
