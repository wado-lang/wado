use { println, Stdout } from "core:cli";

// A `&mut` scrutinee gives its bindings `&mut`, and one onto a non-scalar
// writes through. A scalar binding is refused on both the `let` and the `match`
// path — Wasm GC has no interior pointer to one, so it would reference a copy.

struct Counter {
    hits: List<i32>,
}

fn test_mut_ref_if_let() with Stdout {
    let mut opt = Option::<Counter>::Some(Counter { hits: [1] });
    let rmo = &mut opt;
    if let Some(c) = rmo {
        c.hits.push(2);
    }
    if let Some(c) = &opt {
        assert c.hits.len() == 2;
    }
    println("ok");
}

fn test_mut_ref_match() with Stdout {
    let mut opt = Option::<Counter>::Some(Counter { hits: [10] });
    let rmo = &mut opt;
    let val = match rmo {
        Some(c) => {
            c.hits.push(20);
            c.hits.len()
        },
        None => 0,
    };
    assert val == 2;
    if let Some(c) = &opt {
        assert c.hits.len() == 2;
    }
    println("ok");
}

fn test_ref_if_let_unchanged() with Stdout {
    // &Option<T>: x should bind as &i32 (read-only, existing behavior)
    let opt = Option::<i32>::Some(42);
    let ro = &opt;
    if let Some(x) = ro {
        assert *x == 42;
    }
    println("ok");
}

export fn run() with Stdout {
    test_mut_ref_if_let();
    test_mut_ref_match();
    test_ref_if_let_unchanged();
}

__DATA__
{"stdout": "ok\nok\nok\n"}
