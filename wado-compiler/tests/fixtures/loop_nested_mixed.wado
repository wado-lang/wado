// Test nested loops with mixed types: loop -> while -> for

use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let mut a = 0;
    loop {
        a = a + 1;
        let mut b = 0;
        while b < 2 {
            b = b + 1;
            for let mut c = 0; c < 2; c = c + 1 {
                println(`a:{a} b:{b} c:{c}`);
                if c == 0 {
                    continue;
                }
            }
            if b == 1 {
                continue;
            }
        }
        if a >= 2 {
            break;
        }
    }
    println("done");
}

__DATA__
{"stdout": "a:1 b:1 c:0\na:1 b:1 c:1\na:1 b:2 c:0\na:1 b:2 c:1\na:2 b:1 c:0\na:2 b:1 c:1\na:2 b:2 c:0\na:2 b:2 c:1\ndone\n"}
