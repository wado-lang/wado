// Whether a newtype answers a qualified call or its base does is whether the
// newtype's own impl declares the name — either kind. Asked of the
// receiver-less declarations alone, a newtype's instance method was invisible,
// the call fell through to the base, and `i32` declares no `tag`: liveness
// dropped a callee WIR still emitted.

use { println, Stdout } from "core:cli";

type Meters = i32;

impl Meters {
    fn tag(&self) -> i32 {
        return 7;
    }
}

flags Perms {
    Read,
    Write,
}

impl Perms {
    fn count(&self) -> i32 {
        return 5;
    }
}

export fn run() with Stdout {
    let m: Meters = 3;
    println(`${Meters::tag(&m)}`);
    let p = Perms::Read;
    println(`${Perms::count(&p)}`);
}

__DATA__
{"stdout": "7\n5\n"}
