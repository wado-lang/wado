// Test all integer type associated constants (MAX, MIN)
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // i8
    println(`i8::MAX = {i8::MAX}`);
    println(`i8::MIN = {i8::MIN}`);

    // u8
    println(`u8::MAX = {u8::MAX}`);
    println(`u8::MIN = {u8::MIN}`);

    // i16
    println(`i16::MAX = {i16::MAX}`);
    println(`i16::MIN = {i16::MIN}`);

    // u16
    println(`u16::MAX = {u16::MAX}`);
    println(`u16::MIN = {u16::MIN}`);

    // i32
    println(`i32::MAX = {i32::MAX}`);
    println(`i32::MIN = {i32::MIN}`);

    // u32
    println(`u32::MAX = {u32::MAX}`);
    println(`u32::MIN = {u32::MIN}`);

    // i64
    println(`i64::MAX = {i64::MAX}`);
    println(`i64::MIN = {i64::MIN}`);

    // u64
    println(`u64::MAX = {u64::MAX}`);
    println(`u64::MIN = {u64::MIN}`);
}

__DATA__
{"stdout": "i8::MAX = 127\ni8::MIN = -128\nu8::MAX = 255\nu8::MIN = 0\ni16::MAX = 32767\ni16::MIN = -32768\nu16::MAX = 65535\nu16::MIN = 0\ni32::MAX = 2147483647\ni32::MIN = -2147483648\nu32::MAX = 4294967295\nu32::MIN = 0\ni64::MAX = 9223372036854775807\ni64::MIN = -9223372036854775808\nu64::MAX = 18446744073709551615\nu64::MIN = 0\n"}
