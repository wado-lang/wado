// HTTP multiple response headers test
// Verifies that multiple different response headers are correctly sent.

use { Request, Response, ErrorCode, Fields, FieldName, FieldValue, Trailers } from "wasi:http";

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();

    let headers = Fields::new();
    // "hello" = [104, 101, 108, 108, 111]
    let v1: Array<u8> = [104 as u8, 101 as u8, 108 as u8, 108 as u8, 111 as u8];
    let _ = headers.append("x-first" as FieldName, v1 as FieldValue);

    // "world" = [119, 111, 114, 108, 100]
    let v2: Array<u8> = [119 as u8, 111 as u8, 114 as u8, 108 as u8, 100 as u8];
    let _ = headers.append("x-second" as FieldName, v2 as FieldValue);

    let [response, _tx_future] = Response::new(headers, null, trailers_future);
    task return Result::<Response, ErrorCode>::Ok(response);
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

__DATA__
{
    "wasi:http/service": {
        "status": 200,
        "headers_contain": [["x-first", "hello"], ["x-second", "world"]]
    }
}
