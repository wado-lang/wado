use { println, Stdout } from "core:cli";


// from closure_return_bool.wado
fn closure_return_bool() with Stdout {
    let is_even = |x: i32| x % 2 == 0;

    let a = is_even(4);
    let b = is_even(7);
    println(`{a},{b}`);
}

// from closure_return_i64.wado
fn closure_return_i64() with Stdout {
    let to_i64 = |x: i32| x as i64 * 1000000000 as i64;
    let big = to_i64(5);
    println(`{big}`);
}

export fn run() with Stdout {
    closure_return_bool();
    closure_return_i64();
}

__DATA__
{"stdout": "true,false\n5000000000\n"}
