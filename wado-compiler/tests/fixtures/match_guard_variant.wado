// Test match arm guards with variant patterns

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let opt1: Option<i32> = Option::<i32>::Some(42);
    let opt2: Option<i32> = Option::<i32>::Some(3);
    let none: Option<i32> = null;

    // Guard on variant pattern
    let msg1 = match opt1 {
        Some(x) && x > 10 => "large value",
        Some(_) => "small value",
        None => "no value",
    };
    println(msg1);

    // Guard fails, falls to next arm
    let msg2 = match opt2 {
        Some(x) && x > 10 => "large value",
        Some(_) => "small value",
        None => "no value",
    };
    println(msg2);

    // None doesn't match Some patterns
    let msg3 = match none {
        Some(x) && x > 10 => "large value",
        Some(_) => "small value",
        None => "no value",
    };
    println(msg3);
}

__DATA__
{"stdout": "large value\nsmall value\nno value\n"}
