// Test mutable integer variables with reassignment

use {println, Stdout} from "core:cli";

fn main() with Stdout {
    let mut x = 5;

    if x == 5 {
        println("x is 5");
    }

    x = 10;

    if x == 10 {
        println("x is 10");
    }

    x = x + 5;

    if x == 15 {
        println("x is 15");
    }
}
