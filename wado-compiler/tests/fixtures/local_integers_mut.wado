// Test mutable integer variables with reassignment

use {println, Stdout} from "core:cli";

fn run() with Stdout {
    let mut x = 5;

    if x == 5 {
        println("x is 5");
    }

    x = 10;

    if x == 10 {
        println("x is 10");
    }

    x = x + 5;

    if x == 15 {
        println("x is 15");
    }
}

__DATA__
{"stdout": "x is 5\nx is 10\nx is 15\n"}
