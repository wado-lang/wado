// Test mutable integer variables with reassignment

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut x = 5;

    if x == 5 {
        println("x is 5");
    }

    x = 10;

    if x == 10 {
        println("x is 10");
    }

    x = x + 5;

    if x == 15 {
        println("x is 15");
    }
}

__DATA__
{
    "stdout": "x is 5\nx is 10\nx is 15\n",
    "wir_pass": {"O2": ["nir/const_fold", "nir/store_load_forward_post_scalarize", "nir/const_fold_post_global", "wir/fuse_remaining_local_tees"]},
    "wir_not_expect:O2": [
        "x == 5",
        "x == 10",
        "x == 15"
    ]
}
