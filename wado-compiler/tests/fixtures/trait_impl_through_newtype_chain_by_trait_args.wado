// A call through a newtype chain is owned by the link the selected impl sits
// on, even where a nearer link implements the same trait at other arguments.

trait Alpha<T> with () {
    fn m(&self) -> i32;
}

struct Pair_<A, B> {
    a: A,
    b: B,
}

type Mid = Pair_<i32, i32>;
type Outer = Mid;

impl Alpha<i32> for Mid {
    fn m(&self) -> i32 {
        return 1;
    }
}

impl Alpha<i64> for Pair_<i32, i32> {
    fn m(&self) -> i32 {
        return 2;
    }
}

impl Add<i32> for Mid {
    type Output = i32;
    fn add(&self, rhs: &i32) -> i32 {
        return 10;
    }
}

impl Add<i64> for Pair_<i32, i32> {
    type Output = i32;
    fn add(&self, rhs: &i64) -> i32 {
        return 20;
    }
}

test "each operand type reaches its own link" {
    let p: Pair_<i32, i32> = { a: 1, b: 2 };
    assert p + (5 as i64) == 20;
    let o: Outer = { a: 1, b: 2 };
    assert o + 5 == 10;
    assert o + (5 as i64) == 20;
}

test "each trait argument reaches its own link" {
    let p: Pair_<i32, i32> = { a: 1, b: 2 };
    assert Alpha::<i64>::m(&p) == 2;
    let o: Outer = { a: 1, b: 2 };
    assert Alpha::<i64>::m(&o) == 2;
    assert Alpha::<i32>::m(&o) == 1;
}
