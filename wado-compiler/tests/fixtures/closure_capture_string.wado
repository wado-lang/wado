// Test closure capturing String values
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Capture a String literal
    let greeting = "Hello";
    let get_greeting = || greeting;
    println(get_greeting());  // Hello

    // Capture multiple strings
    let name = "world";
    let make_msg = || `{greeting}, {name}!`;
    println(make_msg());  // Hello, world!

    // Capture a String and use it in a condition
    let status = "ok";
    let is_ok = || status == "ok";
    println(`{is_ok()}`);  // true
}

__DATA__
{"stdout": "Hello\nHello, world!\ntrue\n"}
