// `never` type in if expressions: a branch returning `never` is compatible
// with any type (bottom type rule). The if result type comes from the
// non-never branch.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let t = true;

    // else branch returns never - with type annotation
    let a: i32 = if t { 1 } else { panic("unreachable") };
    assert a == 1;

    // then branch returns never - with type annotation
    let b: i32 = if !t { panic("unreachable") } else { 2 };
    assert b == 2;

    // else branch returns never - type inferred from then branch
    let c = if t { 3 } else { panic("unreachable") };
    assert c == 3;

    // then branch returns never - type inferred from else branch
    let d = if !t { panic("unreachable") } else { 4 };
    assert d == 4;

    // unreachable() instead of panic
    let e: i32 = if t { 5 } else { unreachable() };
    assert e == 5;

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
