// An impl writes no clause: the trait's clauses bind every impl.
trait Get with () {
    fn get(&self, i: i32) -> i32;
}

struct Box { value: i32 }

impl Get for Box {
    fn get(&self, i: i32) -> i32
        contract i >= 0
    {
        return self.value + i;
    }
}

export fn run() {
    let b = Box { value: 1 };
    let _ = b.get(1);
}

__DATA__
