// An impl writes no clause on a method its trait binds: the trait's clauses
// bind every impl, so a caller through a bound vouches for those alone.
trait Get with () {
    fn get(&self, i: i32) -> i32
        contract i < 100;
}

struct Box { value: i32 }

impl Get for Box {
    fn get(&self, i: i32) -> i32
        contract i >= 0
    {
        return self.value + i;
    }
}

export fn run() {
    let b = Box { value: 1 };
    let _ = b.get(1);
}

__DATA__
{
  "compile_error": ":12:9: analysis error: an impl writes no `contract` on a method its trait's clauses bind"
}
