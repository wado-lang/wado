// Test: inspect references (&T, &mut T)
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Immutable reference
    let x = 42;
    let r = &x;
    println(`{r:?}`);

    // Mutable reference
    let mut y = 100;
    let mr = &mut y;
    println(`{mr:?}`);

    // Reference to string
    let s = "hello";
    let rs = &s;
    println(`{rs:?}`);

    // Reference to bool
    let b = true;
    let rb = &b;
    println(`{rb:?}`);

    println("ok");
}

__DATA__
{"stdout": "42\n100\n\"hello\"\ntrue\nok\n"}
