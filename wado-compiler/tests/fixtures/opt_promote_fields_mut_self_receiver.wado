// A `&mut self` receiver is the ordinary method shape and the bulk of what
// `promote_fields` can share — 96 % of its candidates on the SQLite parser
// benchmark. Being `&mut` is not itself a reason to refuse: what matters is
// whether anything writes the slot between the pin and the uses, which the
// placement checks against the builder's heap versions.
//
// This fixture pins both sides of that. `sum_twice` shares one load across two
// reads with no write between them, which must stay correct. `around_call`
// reads the same field on either side of a mutating call, which must *not*
// share — the two reads have different versions and the second must see 25.

struct Acc {
    total: i32,
    step: i32,
}

impl Acc {
    #[inline(never)]
    fn add(&mut self) {
        self.total = self.total + self.step;
    }

    // Two reads of `self.step`, nothing between them: one load is correct.
    #[inline(never)]
    fn sum_twice(&mut self) -> i32 {
        return self.step + self.step;
    }

    // `add()` writes `total` between the two reads, so they are different
    // values and must not collapse onto one load.
    #[inline(never)]
    fn around_call(&mut self) -> i32 {
        let before = self.total;
        self.add();
        let after = self.total;
        return before * 100 + after;
    }
}

#[inline(never)]
fn seed(n: i32) -> i32 {
    return n;
}

export fn run() {
    let mut a = Acc { total: seed(20), step: seed(5) };
    assert a.sum_twice() == 10;
    // before = 20, add() makes total 25, after = 25.
    assert a.around_call() == 2025;
    assert a.total == 25;
}

__DATA__
{
    "stdout": ""
}
