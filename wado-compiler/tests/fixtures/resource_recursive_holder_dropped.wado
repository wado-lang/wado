// A holder that holds itself drops every resource along the chain: the drop
// recurses through a function, where expanding it in place would never end.
// A generic struct drops through its type arguments.

use { Request, Response, ErrorCode, Fields, Headers, Trailers } from "wasi:http";

affine struct Node {
    fields: Fields,
    next: Option<Node>,
}

struct Wrap<affine T> {
    inner: T,
}

fn hold(depth: i32) with Fields {
    let mut chain = Node { fields: Fields::new(), next: null };
    for let _ of 0..<depth {
        chain = Node { fields: Fields::new(), next: Option::Some(chain) };
    }
    let wrapped = Wrap { inner: Fields::new() };
}

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    hold(0);
    hold(3);
    let [trailers, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [response, _sent] = Response::new(Headers::new(), null, trailers);
    task return Result::<Response, ErrorCode>::Ok(response);
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

__DATA__
{"wasi:http/service": {"status": 200}}
