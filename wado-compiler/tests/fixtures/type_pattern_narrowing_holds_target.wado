// A narrowing hands out a held resource's handle as the resource it extends,
// so the arm may call that resource's own methods with no `with` naming it.
use { Dom, Element, HtmlInputElement, Node } from "web:dom";

fn from_param(n: Node) -> String {
    return match n {
        input: HtmlInputElement => input.value(),
        _ => "",
    };
}

fn from_let_else(el: Element) -> String {
    let input: HtmlInputElement = el else {
        return "";
    };
    return input.value();
}

fn from_effect() -> String with Dom {
    if let Some(el) = Dom::document().get_element_by_id("i") {
        if let input: HtmlInputElement = el {
            return input.value();
        }
    }
    return "";
}

export fn run() with Dom {
    let doc = Dom::document();
    let _ = from_param(doc);
    let _ = from_let_else(doc.create_element("input", null));
    let _ = from_effect();
}

__DATA__
{"compile_only": true}
