// A struct element read through `iter_ref` is the source's own element, so a
// `List<P>` built from it would alias `xs`.

struct P {
    x: i32,
}

export fn run() {
    let xs: List<P> = [P { x: 1 }, P { x: 2 }];
    let mut out: List<P> = xs.iter_ref().collect();
    out[0].x = 9;
    assert xs[0].x == 1;
}

