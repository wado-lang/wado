// A type a component declares is foreign to the package importing it, as a
// `wasi:*` one is, so the package cannot add methods to it.
use { Point } from "./sub/cm-catalog.wasm" with { type: "wasm" };

impl Point {
    fn sum(&self) -> f64 {
        return self.x + self.y;
    }
}

export fn run() {}

__DATA__
{
  "compile_error": "cannot define an inherent `impl` on foreign type `Point`"
}
