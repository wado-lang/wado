use { println, Stdout } from "core:cli";

pub flags Perms {
    Read,
    Write,
    Execute,
}

flags Word { B0,B1,B2,B3,B4,B5,B6,B7,B8,B9,B10,B11,B12,B13,B14,B15,B16,B17,B18,B19,B20,B21,B22,B23,B24,B25,B26,B27,B28,B29,B30,B31 }

export fn run() with Stdout {
    let r = Perms::Read;
    let w = Perms::Write;
    let x = Perms::Execute;
    let rw = r | w;
    let rwx = rw | x;
    assert rw as u32 == 3;
    assert rwx as u32 == 7;
    assert Perms::none() as u32 == 0;
    assert Perms::all() as u32 == 7;
    let masked = rwx & Perms::Read;
    assert masked as u32 == 1;
    let toggled = rw ^ Perms::Read;
    assert toggled as u32 == 2;
    assert Word::all() as u32 == 0xFFFF_FFFF;  // every bit of the word
    println("ok");
}

__DATA__
{"stdout": "ok\n"}
