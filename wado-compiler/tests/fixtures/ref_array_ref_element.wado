// Reference to array element: does mutation through the ref affect the array?

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut arr: Array<i32> = [10, 20, 30];

    // Take reference to element (returns a copy reference, not alias to slot)
    let r = &arr[1];
    println(`ref element: {*r}`);

    // Modify array directly; ref should still hold old value (value semantics)
    arr[1] = 999;
    println(`arr[1]: {arr[1]}`);
    println(`ref still: {*r}`);
}

__DATA__
{"stdout": "ref element: 20\narr[1]: 999\nref still: 20\n"}
