// A by-value `self` is not read through a reference: the call would copy what
// the reference points to, where the reference says the caller meant that
// value itself.

fn head(r: &Option<i32>) -> i32 {
    return r.unwrap();
}

export fn run() {
    let o = Option::Some(1);
    assert head(&o) == 1;
}

