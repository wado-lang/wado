// A number identifies a case, so two cases cannot share one. Protobuf's
// `allow_alias` is a second name for a value, which is not a second case.

enum Corpus {
    #[wire(number = 3)] Web,
    #[wire(number = 3)] Www,
}

export fn run() {}

__DATA__
{"compile_error": "`#[wire(number = 3)]` is already `Web`'s number", "compile_error_codes": ["WIRE_NUMBER"]}
