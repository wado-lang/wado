use { println, Stdout } from "core:cli";
use { f32x4 } from "core:simd";


// from number_literal_coercion.wado
fn number_literal_coercion() with Stdout {
    // Integer literal coerced to float
    let a: f64 = 1;
    let b: f64 = 42;
    let c: f32 = 100;

    // Scientific notation as integer (no decimal point, non-negative exponent)
    let d: i32 = 1e2;  // 100
    let e: i64 = 1e10;  // 10000000000
    let f: i32 = 5e3;  // 5000

    // Scientific notation as float
    let g: f64 = 1e2;
    let h: f64 = 6.022e23;

    // Hex/binary/octal as float
    let i: f64 = 0xFF;  // 255.0
    let j: f64 = 0b1010;  // 10.0
    let k: f64 = 0o77;  // 63.0

    // Print results to verify
    println(`a=${a}, b=${b}, c=${c}`);
    println(`d=${d}, e=${e}, f=${f}`);
    println(`g=${g}, h=${h}`);
    println(`i=${i}, j=${j}, k=${k}`);
}

// from number_literal_coercion_builtin.wado
fn number_literal_coercion_builtin() with Stdout {
    // Float literal in f32x4 array context (coerced via SequenceLiteralBuilder)
    let v: f32x4 = [1.3, 2.7, -1.3, -2.7];
    assert v.extract_lane(0) as f64 > 1.0;

    // Verify non-round floats work too
    let w: f32x4 = [0.1, 0.2, 0.3, 0.4];
    assert w.extract_lane(3) as f64 > 0.3;

    println("ok");
}

export fn run() with Stdout {
    number_literal_coercion();
    number_literal_coercion_builtin();
}

__DATA__
{"stdout": "a=1, b=42, c=100\nd=100, e=10000000000, f=5000\ng=100, h=602200000000000000000000\ni=255, j=10, k=63\nok\n"}
