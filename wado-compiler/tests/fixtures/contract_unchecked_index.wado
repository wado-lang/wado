// `unchecked xs[i]` vouches for the range `List`'s index impl requires, so a
// build without contract checks reads with no range check, and only a marked
// read skips it.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut xs: List<i32> = List::with_capacity(8);
    xs.push(10);
    xs.push(20);
    println(`${unchecked xs[builtin::black_box(1)]}`);
    let names: List<String> = ["a", "b"];
    println((unchecked names[builtin::black_box(1)]).to_ascii_uppercase());
    println(`${xs[builtin::black_box(2)]}`);
}

__DATA__
{
    "stdout": "20\nB\n",
    "stderr_contains": ["condition: 0 <= index < self.len()"],
    "trapped": true
}
