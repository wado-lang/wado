// A conjunction written as `if a { b } else { false }` carries the same
// two-sided check `array_bounds_elim_chained_guard` writes with `&&`, but its
// false arm is a pooled bool rather than an integer zero. Reading the
// conjunction takes both spellings, or the guard stands and the access below
// keeps its own check. At O2 nothing of either survives.

use { println, Stdout } from "core:cli";

fn sum_guarded(xs: &List<i32>) -> i32 {
    let mut s = 0;
    for let mut i = 0; i < xs.len(); i += 1 {
        let ok = if 0 <= i { i < xs.len() } else { false };
        if !ok {
            panic("index out of range");
        }
        s += xs[i];
    }
    return s;
}

export fn run() with Stdout {
    let xs = List::<i32>::filled(builtin::black_box(5), 3);
    println(`${sum_guarded(&xs)}`);
}

__DATA__
{
    "stdout": "15\n",
    "wir_scope": ".wado/run\"",
    "wir_expect:O2": [
        "builtin::array_get_value<i32>("
    ],
    "wir_not_expect:O2": [
        "cold_path"
    ]
}
