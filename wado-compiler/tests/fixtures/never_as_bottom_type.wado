// `never` is the bottom type and is compatible with every type.
// This tests that `never`-typed expressions can appear in any value
// position: function arguments, binary operands, struct fields, and
// array elements — as long as the diverging path is not actually taken.
use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

fn add(a: i32, b: i32) -> i32 {
    return a + b;
}

export fn run() with Stdout {
    let opt: Option<i32> = Option::<i32>::Some(5);

    // Function argument
    let a = add(match opt {
        Some(v) => v,
        None => panic("none"),
    }, 10);
    assert a == 15;

    // Struct field
    let p = Point {
        x: match opt {
            Some(v) => v,
            None => panic("none"),
        },
        y: 0,
    };
    assert p.x == 5;

    // Array element
    let arr: Array<i32> = [match opt {
        Some(v) => v,
        None => panic("none"),
    }, 2];


    assert arr[0] == 5;

    // Binary operand (RHS)
    let b: i32 = 3 + match opt {
        Some(v) => v,
        None => panic("none"),
    };
    assert b == 8;

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
