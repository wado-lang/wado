// Test: i128/u128 format specifiers - width, alignment, sign, zero-pad, base
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let i: i128 = 42;
    let neg: i128 = -42;

    // Right-aligned (default)
    assert `{i:10}` == "        42";
    // Left-aligned
    assert `{i:<10}` == "42        ";
    // Center-aligned
    assert `{i:^10}` == "    42    ";
    // Custom fill + align
    assert `{i:*^10}` == "****42****";
    assert `{i:0>8}` == "00000042";
    assert `{i:-<8}` == "42------";

    // Sign
    assert `{i:+}` == "+42";
    assert `{neg:+}` == "-42";
    assert `{neg}` == "-42";

    // Zero-pad
    assert `{i:08}` == "00000042";
    assert `{neg:08}` == "-0000042";
    assert `{i:+08}` == "+0000042";

    // Width + sign + zero-pad
    assert `{i:+010}` == "+000000042";

    // Width smaller than content: no truncation
    assert `{i:2}` == "42";

    // Binary
    assert `{i:b}` == "101010";
    assert `{i:08b}` == "00101010";
    assert `{i:#b}` == "0b101010";
    assert `{i:#010b}` == "0b00101010";
    assert `{i:<10b}` == "101010    ";
    assert `{i:>10b}` == "    101010";

    // Negative binary
    assert `{neg:b}` == "-101010";
    assert `{neg:#b}` == "-0b101010";

    // Octal
    assert `{i:o}` == "52";
    assert `{i:#o}` == "0o52";
    assert `{i:#010o}` == "0o00000052";
    assert `{i:<10o}` == "52        ";

    // Negative octal
    assert `{neg:o}` == "-52";
    assert `{neg:#o}` == "-0o52";

    // Hex lower
    assert `{i:x}` == "2a";
    assert `{i:#x}` == "0x2a";
    assert `{i:#010x}` == "0x0000002a";
    assert `{i:<10x}` == "2a        ";
    assert `{i:>10x}` == "        2a";
    assert `{i:^10x}` == "    2a    ";

    // Hex upper
    assert `{i:X}` == "2A";
    assert `{i:#X}` == "0X2A";
    assert `{i:#010X}` == "0X0000002A";

    // Negative hex
    assert `{neg:x}` == "-2a";
    assert `{neg:#x}` == "-0x2a";
    assert `{neg:X}` == "-2A";
    assert `{neg:#X}` == "-0X2A";

    // Zero value
    let zero: i128 = 0;
    assert `{zero}` == "0";
    assert `{zero:+}` == "+0";
    assert `{zero:b}` == "0";
    assert `{zero:o}` == "0";
    assert `{zero:x}` == "0";
    assert `{zero:#x}` == "0x0";
    assert `{zero:#b}` == "0b0";
    assert `{zero:#o}` == "0o0";
    assert `{zero:05}` == "00000";
    assert `{zero:^5}` == "  0  ";

    // u128 - width and alignment
    let u: u128 = 42;
    assert `{u:10}` == "        42";
    assert `{u:<10}` == "42        ";
    assert `{u:^10}` == "    42    ";
    assert `{u:*^10}` == "****42****";
    assert `{u:08}` == "00000042";

    // u128 - binary
    assert `{u:b}` == "101010";
    assert `{u:08b}` == "00101010";
    assert `{u:#b}` == "0b101010";
    assert `{u:#010b}` == "0b00101010";

    // u128 - octal
    assert `{u:o}` == "52";
    assert `{u:#o}` == "0o52";
    assert `{u:#010o}` == "0o00000052";

    // u128 - hex
    assert `{u:x}` == "2a";
    assert `{u:X}` == "2A";
    assert `{u:#x}` == "0x2a";
    assert `{u:#X}` == "0X2A";
    assert `{u:#010x}` == "0x0000002a";
    assert `{u:<10x}` == "2a        ";

    // u128 zero
    let uzero: u128 = 0;
    assert `{uzero}` == "0";
    assert `{uzero:b}` == "0";
    assert `{uzero:#x}` == "0x0";
    assert `{uzero:05}` == "00000";

    // Large i128 values: i128::MAX = 2^127 - 1
    let i128_max: i128 = 170141183460469231731687303715884105727;
    assert `{i128_max}` == "170141183460469231731687303715884105727";
    assert `{i128_max:x}` == "7fffffffffffffffffffffffffffffff";
    assert `{i128_max:X}` == "7FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF";
    assert `{i128_max:#x}` == "0x7fffffffffffffffffffffffffffffff";

    // i128::MIN = -2^127
    let i128_min: i128 = -170141183460469231731687303715884105728;
    assert `{i128_min}` == "-170141183460469231731687303715884105728";
    assert `{i128_min:x}` == "-80000000000000000000000000000000";
    assert `{i128_min:#x}` == "-0x80000000000000000000000000000000";

    // Large u128 values: u128::MAX = 2^128 - 1
    let u128_max: u128 = 340282366920938463463374607431768211455;
    assert `{u128_max}` == "340282366920938463463374607431768211455";
    assert `{u128_max:x}` == "ffffffffffffffffffffffffffffffff";
    assert `{u128_max:X}` == "FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF";
    assert `{u128_max:#x}` == "0xffffffffffffffffffffffffffffffff";

    // Powers of two for u128
    let u128_one: u128 = 1;
    assert `{u128_one:b}` == "1";
    assert `{u128_one:#b}` == "0b1";
    assert `{u128_one:#x}` == "0x1";

    let u128_256: u128 = 256;
    assert `{u128_256:b}` == "100000000";
    assert `{u128_256:o}` == "400";
    assert `{u128_256:x}` == "100";
    assert `{u128_256:#x}` == "0x100";

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
