// A value bound from `?` keeps value semantics. In `let v: T = make()?;`,
// `?` lowers to
//   `match make() { Ok($qm_v) => $qm_v, Err(e) => return Err(e) }`
// whose scrutinee is a fresh rvalue (a function call), so lowering binds it
// without a value copy.

use { println, Stdout } from "core:cli";

pub struct Pair {
    pub a: i32,
    pub b: i32,
}

fn make_pair(ok: bool) -> Result<Pair, i32> {
    if ok {
        return Result::<Pair, i32>::Ok(Pair { a: 10, b: 20 });
    }
    return Result::<Pair, i32>::Err(-1);
}

fn extract() -> Result<i32, i32> {
    let p: Pair = make_pair(true)?;
    return Result::<i32, i32>::Ok(p.a + p.b);
}

export fn run() with Stdout {
    match extract() {
        Ok(n) => println(`${n}`),
        Err(_) => println("err"),
    };
}

__DATA__
{
    "stdout": "30\n",
    "wir_not_expect:O2": ["$value_copy$"]
}
