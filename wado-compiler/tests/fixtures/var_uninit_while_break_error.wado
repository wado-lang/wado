// Error: a `while` may run its body zero times, whatever its condition, so an
// assignment in the body never initializes a variable after the loop.

export fn run() {
    let x: i32;
    while true {
        x = 1;
        break;
    }
    assert x == 1;
}

__DATA__
{"compile_error": ":10:12: analysis error: 'x' is used before initialization"}
