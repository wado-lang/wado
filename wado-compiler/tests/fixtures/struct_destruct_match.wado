// Struct destructuring in match expressions

use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

export fn run() with Stdout {
    let p = Point { x: 10, y: 20 };

    // Match with struct pattern and guards
    let label = match p {
        { x, y } && x > 0 && y > 0 => "positive",
        { x, .. } && x > 0 => "positive x",
        _ => "other",
    };
    println(label);

    // Match with named struct pattern
    let label2 = match p {
        Point { x, y } && x + y > 25 => "large",
        Point { x, y } => "small",
    };
    println(label2);

    // Match extracting field via rename
    let desc = match p {
        { x: h, y: v } && h == v => `equal: {h}`,
        { x: h, y: v } => `{h}, {v}`,
    };
    println(desc);
}

__DATA__
{"stdout": "positive\nlarge\n10, 20\n"}
