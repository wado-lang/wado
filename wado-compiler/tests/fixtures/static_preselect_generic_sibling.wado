//! A bare slot admits every argument; a shape with a slot inside it admits
//! only that shape. `Wrap<A>` is no `i32` however `A` is chosen, and admitting
//! one made the generic sibling ambiguous with the concrete impl of the name —
//! on an argument no annotation could have separated.

struct M {}

struct Wrap<A> {
    a: A,
}

trait Conv<T> {
    fn make(v: T) -> i32;
}

impl<A> Conv<Wrap<A>> for M {
    fn make(v: Wrap<A>) -> i32 {
        return 1;
    }
}

impl Conv<i32> for M {
    fn make(v: i32) -> i32 {
        return 2;
    }
}

test "a local's declared type selects past a generic sibling" {
    let n: i32 = 5;
    assert M::make(n) == 2;
}

test "and the generic sibling still answers for its own shape" {
    let w = Wrap { a: true };
    assert M::make(w) == 1;
}

__DATA__
{"test": {}}
