// The same rule on the `match` path, which reaches the wrap by another route.

struct Point { x: i32, y: i32 }

export fn run() {
    let mut p = Point { x: 10, y: 20 };
    match &mut p {
        Point { x, y } => {
            *x = 100;
            *y = 200;
        }
    }
}

