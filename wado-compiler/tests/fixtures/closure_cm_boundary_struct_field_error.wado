// Closures buried inside a struct that crosses the Component Model
// boundary are also rejected. The `type_contains_closure` walk
// recurses through struct field types of the parameter / return type.

struct Holder {
    f: fn(i32) -> i32,
}

export fn run(h: Holder) {
    let _ = h.f(0);
}

