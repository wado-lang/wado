// A mutable global is state the clause did not declare.
global mut CALLS: i32 = 0;

fn counted(n: i32) -> i32
    contract counting: { CALLS += 1; n > 0 }
{
    return n;
}

export fn run() {
    let _ = counted(1);
}

__DATA__
{
  "compile_error": ":5:26: analysis error: contract clause cannot mutate 'CALLS', which it did not declare"
}
