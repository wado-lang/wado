// Test integer literal coercion in all comparison operators
// Covers: ==, !=, <, >, <=, >= with literal on both lhs and rhs
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let x_u64: u64 = 100;
    let x_i64: i64 = -50;
    let x_u8: u8 = 42;
    let x_i8: i8 = -10;

    // == with literal on rhs
    assert x_u64 == 100;
    assert x_i64 == -50;
    assert x_u8 == 42;
    assert x_i8 == -10;

    // == with literal on lhs
    assert 100 == x_u64;
    assert -50 == x_i64;
    assert 42 == x_u8;
    assert -10 == x_i8;

    // != with literal on rhs
    assert x_u64 != 99;
    assert x_i64 != 0;
    assert x_u8 != 0;
    assert x_i8 != 0;

    // != with literal on lhs
    assert 99 != x_u64;
    assert 0 != x_i64;
    assert 0 != x_u8;
    assert 0 != x_i8;

    // < with literal on rhs
    assert x_u64 < 101;
    assert x_i64 < 0;
    assert x_u8 < 43;
    assert x_i8 < 0;

    // < with literal on lhs
    assert 99 < x_u64;
    assert -51 < x_i64;
    assert 41 < x_u8;
    assert -11 < x_i8;

    // > with literal on rhs
    assert x_u64 > 99;
    assert x_i64 > -51;
    assert x_u8 > 41;
    assert x_i8 > -11;

    // > with literal on lhs
    assert 101 > x_u64;
    assert 0 > x_i64;
    assert 43 > x_u8;
    assert 0 > x_i8;

    // <= with literal on rhs
    assert x_u64 <= 100;
    assert x_u64 <= 101;
    assert x_i64 <= -50;
    assert x_i64 <= 0;

    // <= with literal on lhs
    assert 100 <= x_u64;
    assert 99 <= x_u64;
    assert -50 <= x_i64;
    assert -51 <= x_i64;

    // >= with literal on rhs
    assert x_u64 >= 100;
    assert x_u64 >= 99;
    assert x_i64 >= -50;
    assert x_i64 >= -51;

    // >= with literal on lhs
    assert 100 >= x_u64;
    assert 101 >= x_u64;
    assert -50 >= x_i64;
    assert 0 >= x_i64;

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
