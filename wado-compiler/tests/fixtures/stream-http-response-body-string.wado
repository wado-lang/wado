// HTTP response body from string test
// Tests writing a string-derived body to the response using byte conversion.

use { Request, Response, ErrorCode, Fields, Trailers } from "wasi:http";

fn string_to_bytes(s: String) -> Array<u8> {
    let mut bytes: Array<u8> = [];
    for let c of s.chars() {
        bytes.push(c as u8);
    }
    return bytes;
}

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [body_rx, body_tx] = Stream::<u8>::new();

    let headers = Fields::new();
    let [response, _tx_future] = Response::new(headers, Option::<Stream<u8>>::Some(body_rx), trailers_future);

    task return Result::<Response, ErrorCode>::Ok(response);

    let body = string_to_bytes("OK");
    body_tx.write(body);
    body_tx.drop();

    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

__DATA__
{"wasi:http/service": {"status": 200, "body": "OK"}}
