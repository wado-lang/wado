// Float literals, where they take their width from, and how a float prints.
use { f32x4 } from "core:simd";

fn take_f32(x: f32) -> f32 {
    return x;
}

fn take_f64(x: f64) -> f64 {
    return x;
}

fn ret_f32() -> f32 {
    return 3.14;
}

fn ret_f64() -> f64 {
    return 2.718;
}

test "float literal coerces to the let annotation" {
    let a: f32 = 3.14;
    let b: f64 = 2.718;
    assert `${a}` == "3.14";
    assert `${b}` == "2.718";
}

test "float literal coerces to the parameter type" {
    assert `${take_f32(3.14)}` == "3.14";
    assert `${take_f64(2.718)}` == "2.718";
}

test "float literal coerces to the return type" {
    assert `${ret_f32()}` == "3.14";
    assert `${ret_f64()}` == "2.718";
}

test "f32 infinities and constants" {
    let inf: f32 = 1.0 / 0.0;
    let neg_inf: f32 = -1.0 / 0.0;
    assert `${inf}` == "inf";
    assert `${neg_inf}` == "-inf";
    assert `${f32::PI}` == "3.1415927";
}

test "an integer literal coerces to a float" {
    let a: f64 = 1;
    let b: f64 = 42;
    let c: f32 = 100;
    assert `${a}` == "1";
    assert `${b}` == "42";
    assert `${c}` == "100";
}

test "scientific notation without a fraction is an integer literal" {
    let d: i32 = 1e2;
    let e: i64 = 1e10;
    let f: i32 = 5e3;
    assert d == 100;
    assert e == 10000000000 as i64;
    assert f == 5000;
}

test "scientific notation coerces to a float" {
    let g: f64 = 1e2;
    let h: f64 = 6.022e23;
    assert `${g}` == "100";
    assert `${h}` == "602200000000000000000000";
}

test "a radix literal coerces to a float" {
    let i: f64 = 0xFF;
    let j: f64 = 0b1010;
    let k: f64 = 0o77;
    assert `${i}` == "255";
    assert `${j}` == "10";
    assert `${k}` == "63";
}

test "float literal in a SIMD lane" {
    // Coerced via `From<Array<f32>>`.
    let v: f32x4 = [1.3, 2.7, -1.3, -2.7];
    assert v.extract_lane(0) as f64 > 1.0;
    let w: f32x4 = [0.1, 0.2, 0.3, 0.4];
    assert w.extract_lane(3) as f64 > 0.3;
}

test "a float prints as its shortest roundtrip form" {
    assert `${1.23}` == "1.23";
    assert `${3.14159}` == "3.14159";
    // No trailing `.0`: 13.0 prints as "13".
    assert `${10.5 + 2.5}` == "13";
    assert 3.14.to_string() == "3.14";
}
