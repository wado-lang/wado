use { println, Stdout } from "core:cli";

// from if_expr_with_let.wado
fn compute(x: i32) -> i32 {
    let result = if x > 0 {
        let a = x * 2;
        let b = a + 1;
        b;
    } else {
        let c = x * 3;
        c;
    };
    return result;
}

// from if_expr_with_let.wado
fn if_expr_with_let() with Stdout {
    println(`{compute(5)}`);
    println(`{compute(-2)}`);
}

// from if_expr_with_trailing_semi.wado
fn if_expr_with_trailing_semi() with Stdout {
    let x = if true {
        42;
    } else {
        0;
    };


    println(`{x}`);
}

export fn run() with Stdout {
    if_expr_with_let();
    if_expr_with_trailing_semi();
}

__DATA__
{"stdout": "11\n-6\n42\n"}
