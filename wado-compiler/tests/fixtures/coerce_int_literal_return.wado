// Test integer literal coercion in return statements
use { println, Stdout } from "core:cli";

fn get_i64() -> i64 {
    return 42;
}

fn get_u64() -> u64 {
    return 100;
}

fn get_i8() -> i8 {
    return 10;
}

fn get_u8() -> u8 {
    return 200;
}

fn run() with Stdout {
    println(`i64: {get_i64()}`);
    println(`u64: {get_u64()}`);
    println(`i8: {get_i8()}`);
    println(`u8: {get_u8()}`);
}

__DATA__
{"stdout": "i64: 42\nu64: 100\ni8: 10\nu8: 200\n"}
