// A global initializer runs before the program does, at a point no handler is
// installed and whose order among the other initializers the program does not
// choose. Performing an effect there has no semantics to give it, so it is
// rejected — the same rule the default-value position already carries.

use { println, Stdout } from "core:cli";

interface Counter {
    fn next() -> i32 {
        return 41;
    }
}

struct Tally {
    value: i32,
}

impl Counter for Tally {
    fn next(&mut self) -> i32 {
        self.value += 1;
        resume self.value
    }
}

fn noisy() -> i32 with Stdout {
    println("initializing");
    return 1;
}

// Calls a function that declares an effect.
global FROM_EFFECTFUL_FN: i32 = noisy();

// Dispatches an interface operation, with no handler installed to take it.
global FROM_OPERATION: i32 = Counter::next();

// Installs a handler, which writes the dispatch global.
global FROM_HANDLER: i32 = hold: {
    let mut tally = Tally { value: 10 };
    with Counter => &mut tally do {
        break hold: Counter::next()
    }
    break hold: 0
};

export fn run() with Stdout {
    println(`${FROM_EFFECTFUL_FN} ${FROM_OPERATION} ${FROM_HANDLER}`);
}

__DATA__
{
    "compile_error": "global initializer must be pure (no effects), but calls effectful function 'noisy'",
    "compile_errors_contains": [
        "global initializer must be pure (no effects), but calls effectful function 'next'",
        "global initializer must be pure (no effects), but installs an effect handler"
    ]
}
