// An effect a global initializer does not itself discharge has no semantics
// there: it runs before the program installs anything, in an order the program
// does not choose. See WEP: Global Variables.

use { println, Stdout } from "core:cli";

// No default body, so an unhandled dispatch has nothing to run.
interface Counter {
    fn next() -> i32;
}

fn noisy() -> i32 with Stdout {
    println("initializing");
    return 1;
}

// Calls a function that declares an effect.
global FROM_EFFECTFUL_FN: i32 = noisy();

// Dispatches a user-defined effect's operation, which only a handler answers.
global FROM_OPERATION: i32 = Counter::next();

export fn run() with Stdout {
    println(`${FROM_EFFECTFUL_FN} ${FROM_OPERATION}`);
}

__DATA__
{
    "compile_error": "global initializer must be pure (no effects), but calls effectful function 'noisy'",
    "compile_errors_contains": [
        "global initializer must be pure (no effects), but dispatches effect operation 'next', which needs an installed handler"
    ]
}
