// An inherent declaration shadows a trait impl's of either kind: `S::tag` is
// what `S` answers `tag` with, its own method, and `S::tag()` asks it for a
// receiver. The trait's associated function stays reachable through the trait,
// which `Mk::<Self = S>::tag()` names. `label` is the same-kind case.

use { println, Stdout } from "core:cli";

trait Mk with () {
    fn tag() -> i32;
}

trait Lbl with () {
    fn label(&self) -> i32;
}

struct S {
    v: i32,
}

impl Mk for S {
    fn tag() -> i32 {
        return 100;
    }
}

impl Lbl for S {
    fn label(&self) -> i32 {
        return 200;
    }
}

impl S {
    // Shadows both `Mk::tag` and `Lbl::label` for `S::tag` and `S::label`.
    fn tag(&self) -> i32 {
        return self.v;
    }

    fn label(&self) -> i32 {
        return 3;
    }
}

export fn run() with Stdout {
    let s = S { v: 9 };
    println(`${Mk::<Self = S>::tag()}`);
    println(`${S::tag(&s)}`);
    println(`${s.tag()}`);
    println(`${S::label(&s)}`);
    println(`${Lbl::label(&s)}`);
}

__DATA__
{"stdout": "100\n9\n9\n3\n200\n"}
