// A shift amount is reduced modulo the operand's bit width at every width, as
// Wasm's `i32.shl` and `i64.shl` do. The `black_box` cases reach the runtime;
// the others go through the constant folder, which must agree.

test "u8 and i8 shift modulo 8" {
    assert builtin::black_box(1 as u8) << builtin::black_box(9 as u8) == 2;
    assert builtin::black_box(-128 as i8) >> builtin::black_box(15 as i8) == -1;
    assert builtin::black_box(0x80 as u8) >> builtin::black_box(15 as u8) == 1;
    let one: u8 = 1;
    assert one << 9 == 2;
}

test "u16 and i16 shift modulo 16" {
    assert builtin::black_box(1 as u16) << builtin::black_box(17 as u16) == 2;
    assert builtin::black_box(-32768 as i16) >> builtin::black_box(31 as i16) == -1;
    let one: i16 = 1;
    assert one << 17 == 2;
}

test "i32 and i64 shift modulo 32 and 64" {
    assert builtin::black_box(1) << builtin::black_box(33) == 2;
    assert builtin::black_box(1 as i64) << builtin::black_box(65 as i64) == 2;
    assert 1 << 33 == 2;
}

test "u128 and i128 shift modulo 128" {
    assert builtin::black_box(1 as u128) << builtin::black_box(129 as u128) == 2;
    assert builtin::black_box(1 as i128) << builtin::black_box(129 as i128) == 2;
    assert builtin::black_box(i128::MIN) >> builtin::black_box(255 as i128) == -1;
    assert builtin::black_box(u128::MAX) >> builtin::black_box(255 as u128) == 1;
}

test "signed >> is arithmetic, unsigned >> is logical" {
    assert builtin::black_box(-8 as i8) >> builtin::black_box(1 as i8) == -4;
    assert builtin::black_box(0xF8 as u8) >> builtin::black_box(1 as u8) == 0x7C;
}
