// Plain resources inspect as `Name#0x<hex>` (WEP: Inspect > Resource). The
// host picks the handle, so only the shape is pinned.
test "resource inspect renders the handle in hex" {
    let [rx, tx] = Stream::<u8>::new();
    assert `${rx:?}`.starts_with("Stream<u8>#0x");
    tx.drop();
    rx.drop();
}

test "resource flows through Result::unwrap_err inspect" {
    let [rx, tx] = Stream::<u8>::new();
    let shown = `${tx:?}`;
    assert shown.starts_with("StreamWritable<u8>#0x");
    let r: Result<i32, StreamWritable<u8>> = Result::<i32, StreamWritable<u8>>::Err(tx);
    assert `${r.unwrap_err():?}` == shown;
    rx.drop();
}

__DATA__
{"test": {}}
