// An integer literal cast to a float converts by value, as `let x: f32 = N;`
// does, even one past 64 bits.

test "a literal past i64 reaches a float by value" {
    assert 340282350000000000000000000000000000000 as f32 == f32::MAX;
    assert -340282350000000000000000000000000000000 as f32 == -f32::MAX;
    assert 30000000000000000000 as f64 == 3e19;
    assert 3000000000 as f32 == 3e9;
}
