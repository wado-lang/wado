// A blanket over a reference (`impl<T: Bound> Tr for &T`) answers a call on a
// reference through a by-value `self` method, and through a `&self` method
// where the referent has no method of the name.
// Regression: only a by-value `self` reached it, and a `&self` method
// reported no method on the referent.

trait Limit with () {
    fn limit() -> i32;
}

trait Describe with () {
    fn describe(&self) -> String;
    fn describe_mut(&mut self) -> String;
    fn describe_value(self) -> String;
}

struct Point {
    x: i32,
}

impl Limit for Point {
    fn limit() -> i32 {
        return 7;
    }
}

impl<T: Limit> Describe for &T {
    fn describe(&self) -> String {
        return `ref blanket ${T::limit()}`;
    }
    fn describe_mut(&mut self) -> String {
        return "ref blanket, mut";
    }
    fn describe_value(self) -> String {
        return "ref blanket, value";
    }
}

struct Both {
    x: i32,
}

impl Limit for Both {
    fn limit() -> i32 {
        return 1;
    }
}

trait Named with () {
    fn name(&self) -> String;
}

impl Named for Both {
    fn name(&self) -> String {
        return "base";
    }
}

impl<T: Limit> Named for &T {
    fn name(&self) -> String {
        return "ref blanket";
    }
}

impl Named for &Point {
    fn name(&self) -> String {
        return "concrete";
    }
}

test "a blanket over a reference dispatches" {
    let p = Point { x: 1 };
    let r = &p;
    assert r.describe() == "ref blanket 7";
    assert (&p).describe() == "ref blanket 7";
    assert r.describe_value() == "ref blanket, value";
}

test "a qualified call" {
    let p = Point { x: 1 };
    let r = &p;
    assert Describe::describe(r) == "ref blanket 7";
}

test "the referent's own `&self` method answers first" {
    let b = Both { x: 1 };
    assert (&b).name() == "base";
    assert b.name() == "base";
    let p = Point { x: 1 };
    assert (&p).name() == "concrete";
}
