#![TODO]
// A blanket over a reference reaches no call: the reference step adopts only
// concrete `&T` impls, and the blanket collection takes only value blankets.
// The prelude's `Inspect for &T` works because the compiler answers that bound
// itself, not because this shape dispatches.
//
// Either the shape is rejected where it is written, or the reference step ranks
// a blanket `&T` impl below a concrete one and above the base type's — a
// decision, so the gap is pinned (WEP 2026-09-01).

trait Limit {
    fn limit() -> i32;
}

trait Describe {
    fn describe(&self) -> String;
}

struct Point {
    x: i32,
}

impl Limit for Point {
    fn limit() -> i32 {
        return 7;
    }
}

impl<T: Limit> Describe for &T {
    fn describe(&self) -> String {
        return "ref blanket";
    }
}

test "a blanket over a reference dispatches" {
    let p = Point { x: 1 };
    let r = &p;
    assert r.describe() == "ref blanket";
}
