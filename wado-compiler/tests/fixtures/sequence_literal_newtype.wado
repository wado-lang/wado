use { println, Stdout } from "core:cli";

struct Vec3 {
    x: f64,
    y: f64,
    z: f64,
}

impl From<Array<f64>> for Vec3 {
    fn from(values: Array<f64>) -> Vec3 {
        return Vec3 { x: values[0], y: values[1], z: values[2] };
    }
}

// Newtype of Vec3 — should also support tuple literal coercion
type Position = Vec3;

export fn run() with Stdout {
    // Newtype coercion via type annotation
    let p: Position = [1.0, 2.0, 3.0];
    assert p.x == 1.0;
    assert p.y == 2.0;
    assert p.z == 3.0;

    // Base type still works
    let v: Vec3 = [4.0, 5.0, 6.0];
    assert v.x == 4.0;

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
