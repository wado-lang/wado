use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let mut arr: Array<[bool, i32, String]> = [];
    arr.append([true, 1, "one"]);
    arr.append([false, 2, "two"]);
    arr.append([true, 3, "three"]);

    for let x of arr {
        println(`{x.0} {x.1} {x.2}`);
    }
}

__DATA__
{"stdout": "true 1 one\nfalse 2 two\ntrue 3 three\n"}
