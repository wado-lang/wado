// Regression: the fn-param specialization retyped `f` to its functor struct,
// but the assignment stores what `id` hands back — the canonical closure — so
// the WIR pipeline emitted an invalid `local.set` at every optimization level.
use { println, Stdout } from "core:cli";

fn id<T>(v: T) -> T {
    return v;
}

fn twice(mut f: fn() -> i32) -> i32 {
    f = id(f);
    return f() + f();
}

export fn run() with Stdout {
    println(`${twice(|| 21)}`);
}

__DATA__
{"stdout": "42\n"}
