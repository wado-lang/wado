// Min repro for the CM-variant `Result<unit, V>` multi-value codegen bug.
//
// Symptom (only via `wado compile`, NOT via this e2e harness):
//
//     Internal compiler error: WIR pipeline generated invalid core Wasm module
//     Validation error: type mismatch: expected i32, found (ref $type)
//
// Where the bug actually lives:
//
// 1.  In `register_mono_variants` (`wir_build/types.rs`) the case-struct of
//     `Result<(), ErrorCode>::Err` ends up with a payload `WirField` of type
//     `i32` instead of `(ref ErrorCode_struct)`. The body keeps emitting
//     `struct.get` against a sibling boxed type so it pushes a `(ref 5)`
//     where the just-registered case struct expects an `i32`.
// 2.  The choice between "FLAT i32 payload" and "BOXED (ref 5) payload"
//     depends on whether the compiler can resolve the ErrorCode WIR type
//     by the time it walks `Result<(), ErrorCode>` — when ErrorCode hasn't
//     been registered yet, `type_id_to_wir_type` returns `AbstractRef`,
//     the variant gets postponed, and a *later* iteration accidentally
//     re-resolves the payload via a different (CM-flat) path.
// 3.  The trigger is non-deterministic w.r.t. the entry filename. With
//     the entry filename given as an absolute path
//     (`/home/user/.../result_unit_cm_variant_passthrough.wado`) the
//     monomorph-registration order resolves cleanly and the BOXED layout
//     wins. With a relative path
//     (`wado-compiler/tests/fixtures/result_unit_cm_variant_passthrough.wado`)
//     the FLAT layout wins and the wasm fails validation.
//
// This e2e harness always passes an absolute fixture path to the compiler,
// so it cannot reproduce the bug by itself. To reproduce manually, run
// (from the repository root) — note the **relative** entry path:
//
//     cargo run --bin wado -- compile -O0 \\
//         wado-compiler/tests/fixtures/result_unit_cm_variant_passthrough.wado \\
//         -o /tmp/x.wasm
//
//   →   Validation error: type mismatch: expected i32, found (ref $type)
//
//     cargo run --bin wado -- compile -O0 \\
//         /home/user/wado/wado-compiler/tests/fixtures/result_unit_cm_variant_passthrough.wado \\
//         -o /tmp/x.wasm
//
//   →   Generated: /tmp/x.wasm
//
// To compare the two outputs and confirm the divergence, set
// `WADO_KEEP_WASM_DIR=/tmp/wado-keep` while running this e2e fixture and
// `wat`-diff against the buggy CLI output.

use { Stdout } from "core:cli";
use { Preopens, Descriptor, DescriptorFlags, PathFlags, OpenFlags, Filesize } from "wasi:filesystem";
use { ErrorCode } from "wasi:filesystem/types.wado";

fn write_helper(dir: &Descriptor, path: &String, content: &String) -> Result<(), ErrorCode> {
    let opened = dir.open_at(
        PathFlags::none(),
        *path,
        OpenFlags::Create | OpenFlags::Truncate,
        DescriptorFlags::Read | DescriptorFlags::Write,
    ).wait();
    match opened {
        Err(e) => return Result::Err(e),
        Ok(file) => {
            let bytes: Array<u8> = content.bytes().collect();
            let [rx, tx] = Stream::<u8>::new();
            let sub = file.write_via_stream(rx, 0 as Filesize);
            tx.write(bytes);
            tx.drop();
            sub.drop();
            return Result::Ok(());
        },
    }
}

export fn run() with Stdout, Preopens {
    let dirs = Preopens::get_directories();
    if dirs.len() == 0 {
        return;
    }
    let result = write_helper(&dirs[0].0, &"never_actually_opened.txt", &"hello");
    if let Err(_) = result {
        return;
    }
}

__DATA__
{"stdout": ""}
