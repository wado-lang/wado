// A run of `let`s taking distinct fields of one aggregate hands each field over,
// as a destructuring does: each field is read once, so neither pays a copy. A
// field taken twice still copies the first time, since the second reads it.

struct Pair {
    xs: List<i32>,
    ys: List<i32>,
}

fn make() -> Pair {
    let mut xs: List<i32> = [];
    xs.push(1);
    let mut ys: List<i32> = [];
    ys.push(2);
    ys.push(3);
    return Pair { xs, ys };
}

export fn run() {
    let p = make();
    let xs = p.xs;
    let ys = p.ys;
    let mut again = make();
    let first = again.xs;
    let second = again.xs;
    again.xs.push(9);
    assert xs.len() == 1;
    assert ys.len() == 2;
    assert first.len() == 1;
    assert second.len() == 1;
}

__DATA__
{
    "stdout": "",
    "wir_expect:O0": [
        "xs = $mv$p$xs;",
        "ys = $mv$p$ys;",
        "first = \"value_copy_field_let_run_each_move.wado/$value_copy$core:prelude/list.wado/List<i32>\"($mv$again$xs);"
    ],
    "wir_scope": "/run"
}
