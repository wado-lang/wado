// Every `HtmlInputElement` is an `Element`, so the second arm can never run.
use { Element, HtmlInputElement, Node } from "wado-lang:web";

fn kind(n: Node) -> i32 {
    return match n {
        el: Element => 1,
        input: HtmlInputElement => 2,
        _ => 0,
    };
}

export fn run() {}

