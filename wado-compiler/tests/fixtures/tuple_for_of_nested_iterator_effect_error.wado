// A `next` performing `Stdout` demands it of a loop over it, inside a tuple
// `for-of` as anywhere. The inner loop is walked once per element of the
// unrolled outer one, and the fault is still one diagnostic.

use { println, Stdout } from "core:cli";

struct Counter {
    n: i32,
}

impl Iterator for Counter {
    type Item = i32;

    fn next(&mut self) -> Option<i32> with Stdout {
        println("tick");
        if self.n <= 0 {
            return null;
        }
        self.n = self.n - 1;
        return Option::Some(self.n);
    }
}

impl IntoIterator for Counter {
    type Item = i32;
    type Iter = Counter;

    fn into_iter(&self) -> Counter {
        return *self;
    }
}

fn consume(c: Counter) {
    for let w of [1, 2] {
        for let v of c {
            let _ = v + w;
        }
    }
}

export fn run() with Stdout {
    consume(Counter { n: 2 });
}

