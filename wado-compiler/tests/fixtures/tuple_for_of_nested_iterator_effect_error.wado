// `Iterator::next` declares no effects, so an impl of it may not add one. The
// impl is walked once however many times the loops around it are unrolled, so
// the fault is one diagnostic.

use { println, Stdout } from "core:cli";

struct Counter {
    n: i32,
}

impl Iterator for Counter {
    type Item = i32;

    fn next(&mut self) -> Option<i32> with Stdout {
        println("tick");
        if self.n <= 0 {
            return null;
        }
        self.n = self.n - 1;
        return Option::Some(self.n);
    }
}

impl IntoIterator for Counter {
    type Item = i32;
    type Iter = Counter;

    fn into_iter(&self) -> Counter {
        return *self;
    }
}

fn consume(c: Counter) {
    for let w of [1, 2] {
        for let v of c {
            let _ = v + w;
        }
    }
}

export fn run() with Stdout {
    consume(Counter { n: 2 });
}

__DATA__
{"compile_error": "effect 'Stdout' is not declared by trait method 'Iterator::next'", "compile_error_count": 1}
