use { println, Stdout } from "core:cli";


// from inspect_option.wado
fn inspect_option() with Stdout {
    let some_val: Option<i32> = Option::<i32>::Some(42);
    println(`{some_val:?}`);

    let none_val: Option<i32> = null;
    println(`{none_val:?}`);
}

// from inspect_option_deeply_nested.wado
fn inspect_option_deeply_nested() with Stdout {
    let deep: Option<Option<Option<i32>>> = Option::<Option<Option<i32>>>::Some(Option::<Option<i32>>::Some(Option::<i32>::Some(7)));
    println(`{deep:?}`);

    let mid_null: Option<Option<Option<i32>>> = Option::<Option<Option<i32>>>::Some(Option::<Option<i32>>::Some(null));
    println(`{mid_null:?}`);

    let outer_null: Option<Option<Option<i32>>> = null;
    println(`{outer_null:?}`);
}

// from inspect_option_nested.wado
fn inspect_option_nested() with Stdout {
    let some_some: Option<Option<i32>> = Option::<Option<i32>>::Some(Option::<i32>::Some(42));
    println(`{some_some:?}`);

    let some_none: Option<Option<i32>> = Option::<Option<i32>>::Some(null);
    println(`{some_none:?}`);

    let none: Option<Option<i32>> = null;
    println(`{none:?}`);
}

// from inspect_option_of_string.wado
fn inspect_option_of_string() with Stdout {
    let some_some: Option<Option<String>> = Option::<Option<String>>::Some(Option::<String>::Some("hello"));
    println(`{some_some:?}`);

    let some_none: Option<Option<String>> = Option::<Option<String>>::Some(null);
    println(`{some_none:?}`);

    let none: Option<Option<String>> = null;
    println(`{none:?}`);
}

export fn run() with Stdout {
    inspect_option();
    inspect_option_deeply_nested();
    inspect_option_nested();
    inspect_option_of_string();
}

__DATA__
{"stdout": "Option::Some(42)\nOption::None\nOption::Some(Option::Some(Option::Some(7)))\nOption::Some(Option::Some(Option::None))\nOption::None\nOption::Some(Option::Some(42))\nOption::Some(Option::None)\nOption::None\nOption::Some(Option::Some(\"hello\"))\nOption::Some(Option::None)\nOption::None\n"}
