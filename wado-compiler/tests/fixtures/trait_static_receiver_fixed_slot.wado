//! A block slot the receiver mentions is fixed by the receiver, not by the
//! argument, so `impl<T> Make<T> for Wrap<T>` is no blanket to
//! `Wrap::<i32>::make`. Asking only whether the block declares *any* slot read
//! every such impl as one, and proposed an `impl Make<i32> for Wrap` nobody can
//! write.

trait Make<T> {
    fn make(v: T) -> i32;
}

struct Wrap<T> {
    v: T,
}

impl<T> Make<T> for Wrap<T> {
    fn make(v: T) -> i32 {
        return 1;
    }
}

test "the receiver fixes the block's slot" {
    assert Wrap::<i32>::make(1) == 1;
}
