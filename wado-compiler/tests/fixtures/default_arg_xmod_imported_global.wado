//! A default expression naming an item its declaring module *imported*.
//!
//! Per WEP: Default Arguments ("Name Resolution: Declaration Scope") a default
//! binds its names in the declaring module's scope. The declaring-module
//! fallback used to consult only that module's own declarations, so a default
//! naming an imported item failed with `unknown identifier` unless every caller
//! happened to import the same name. This module deliberately imports neither
//! `SHARED_LIMIT` nor `shared_fn`.

use {
    with_imported_global,
    with_local_global,
    with_imported_fn,
    generic_with_imported_global,
} from "./sub/default_arg_xmod_imported_global_mid.wado";

export fn run() {
    assert with_imported_global() == 7;
    assert with_imported_global(1) == 1;
    assert with_local_global() == 3;
    assert with_imported_fn() == 11;
    assert generic_with_imported_global::<i32>() == 7;
}

__DATA__
{"stdout": ""}
