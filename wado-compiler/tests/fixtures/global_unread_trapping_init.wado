// A global's initializer runs at module start whether or not anything reads
// the global, so one that traps traps every test. Nothing reads `Z`, and the
// constant division it holds must still trap at every optimization level.

global Z: i32 = 1 / 0;

#[expect_trap]
test "an unread global's trapping initializer still runs" {
    assert builtin::black_box(1) == 1;
}
