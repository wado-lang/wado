// `Eq` and `Ord` are bound-driven: a struct whose fields all implement them
// gets them where a use needs them, comparing field by field in declaration
// order. A hand-written impl always wins.

struct Point {
    x: i32,
    y: i32,
}

struct Color {
    r: u8,
    g: u8,
    b: u8,
}

struct Empty {}

struct Pair<T> {
    first: T,
    second: T,
}

struct ApproxFloat {
    value: f64,
}

impl Eq for ApproxFloat {
    fn eq(&self, other: &Self) -> bool {
        let diff = self.value - other.value;
        let abs_diff = if diff < 0.0 { -diff } else { diff };
        return abs_diff < 0.001;
    }
}

variant Hue {
    Red,
    Green,
    Blue(i32),
}

struct Pixel {
    x: i32,
    y: i32,
    color: Hue,
}

struct Labelled {
    label: String,
    value: Option<i32>,
}

test "equality field by field" {
    let a = Point { x: 1, y: 2 };
    let b = Point { x: 1, y: 2 };
    let c = Point { x: 3, y: 4 };
    assert a == b;
    assert !(a == c);
    assert a != c;

    let red1 = Color { r: 255, g: 0, b: 0 };
    let red2 = Color { r: 255, g: 0, b: 0 };
    let blue = Color { r: 0, g: 0, b: 255 };
    assert red1 == red2;
    assert red1 != blue;

    assert Empty {} == Empty {};
}

test "ordering is lexicographic by field order" {
    let a = Point { x: 1, y: 2 };
    let b = Point { x: 1, y: 3 };
    let c = Point { x: 2, y: 0 };
    // Same first field, the second decides.
    assert a < b;
    assert b > a;
    assert a <= b;
    assert b >= a;
    // A different first field decides on its own.
    assert a < c;
    assert c > a;
    let d = Point { x: 1, y: 2 };
    assert a <= d;
    assert a >= d;
}

test "a generic struct derives at each instantiation" {
    let a = Pair { first: 1, second: 2 };
    let b = Pair { first: 1, second: 2 };
    let c = Pair { first: 1, second: 3 };
    assert a == b;
    assert a != c;
    assert a < c;
    assert c > a;

    let s1 = Pair { first: "hello", second: "world" };
    let s2 = Pair { first: "hello", second: "world" };
    let s3 = Pair { first: "hello", second: "!" };
    assert s1 == s2;
    assert s1 != s3;
}

test "a hand-written Eq wins over the derived one" {
    let a = ApproxFloat { value: 1.0 };
    let b = ApproxFloat { value: 1.0005 };
    let c = ApproxFloat { value: 2.0 };
    assert a == b;
    assert a != c;
}

test "a variant field compares by case and payload" {
    let p1 = Pixel { x: 1, y: 2, color: Hue::Red };
    let p2 = Pixel { x: 1, y: 2, color: Hue::Red };
    let p3 = Pixel { x: 1, y: 2, color: Hue::Green };
    let p4 = Pixel { x: 1, y: 2, color: Hue::Blue(42) };
    let p5 = Pixel { x: 1, y: 2, color: Hue::Blue(42) };
    let p6 = Pixel { x: 1, y: 2, color: Hue::Blue(7) };
    let p7 = Pixel { x: 3, y: 2, color: Hue::Red };
    assert p1 == p2;
    assert p1 != p3;
    assert p4 == p5;
    assert p4 != p6;
    assert p1 != p7;
}

test "an Option field compares like any other variant" {
    let c1 = Labelled { label: "a", value: Option::Some(10) };
    let c2 = Labelled { label: "a", value: Option::Some(10) };
    let c3 = Labelled { label: "a", value: null };
    let c4 = Labelled { label: "b", value: Option::Some(10) };
    assert c1 == c2;
    assert c1 != c3;
    assert c1 != c4;
}
