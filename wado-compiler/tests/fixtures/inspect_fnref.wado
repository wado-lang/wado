// Bare function names lower to zero-capture closures, dispatching through the
// same canonical-vtable path as user-written closures. Display/Inspect treat
// `fn` values like any other closure value — no special "this came from a
// function name" rendering. The synthetic forwarder borrows the original
// parameter names so its source-form pretty-print reads naturally.

fn double(x: i32) -> i32 {
    return x * 2;
}

fn fmt_def(f: fn(i32) -> i32) -> String {
    return `{f:?}`;
}

fn fmt_alt(f: fn(i32) -> i32) -> String {
    return `{f:#?}`;
}

fn fmt_alt_ref(f: &fn(i32) -> i32) -> String {
    // Deref to render the underlying closure; the surface-level `&` prefix is
    // exercised by other reference-rendering fixtures.
    return `{*f:#?}`;
}

test "bare fn-ref :? signature" {
    assert fmt_def(double) == "|i32| -> i32";
}

test "bare fn-ref :#? renders as a forwarding closure" {
    assert fmt_alt(double) == "|x: i32| double(x)";
}

// Explicit `&fn_name` — a genuine `&fn(...)` reference. Deref'ing inside
// `fmt_alt_ref` and pretty-printing the underlying `fn(...)` value yields the
// same forwarding closure source as the bare-name case.
test "explicit &fn-ref deref :#? matches the bare form" {
    assert fmt_alt_ref(&double) == "|x: i32| double(x)";
}

// User-written closure that happens to be shape-identical to the
// synthetic forwarder. Round-trips through the parser.
test "user-written forwarding closure keeps its source for :#?" {
    let f = |x: i32| double(x);
    assert `{f:#?}` == "|x: i32| double(x)";
}

__DATA__
{"test": {}}
