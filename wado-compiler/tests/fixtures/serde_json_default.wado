// test: #[serde(default)] attribute for optional fields
// Missing fields with #[serde(default)] use zero-values instead of erroring.
use { Serialize, Deserialize } from "core:serde";
use { to_string, from_string } from "core:json";

struct Config {
    host: String,

    #[serde(default)]
    port: i32,

    #[serde(default)]
    verbose: bool,

    #[serde(default)]
    tags: List<String>,

    #[serde(default)]
    description: Option<String>,
}

impl Serialize for Config;
impl Deserialize for Config;

test "missing default fields use zero-values" {
    // Only host is provided; other fields should default
    let r = from_string::<Config>(`\{"host":"localhost"\}`);
    if let Ok(c) = r {
        assert c.host == "localhost";
        assert c.port == 0;
        assert c.verbose == false;
        assert c.tags.len() == 0;
        if let None = c.description {
            // OK
        } else {
            panic("expected None for description");
        }
    } else {
        panic("deserialize with defaults failed");
    }
}

test "provided fields override defaults" {
    let r = from_string::<Config>(`\{"host":"example.com","port":8080,"verbose":true,"tags":["a"],"description":"test"\}`);
    if let Ok(c) = r {
        assert c.host == "example.com";
        assert c.port == 8080;
        assert c.verbose == true;
        assert c.tags.len() == 1;
        if let Some(d) = c.description {
            assert d == "test";
        } else {
            panic("expected Some for description");
        }
    } else {
        panic("deserialize with all fields failed");
    }
}

test "missing required field still errors" {
    // host has no #[serde(default)], so missing it should error
    let r = from_string::<Config>(`\{"port":8080\}`);
    if let Err(e) = r {
        // should report missing required field
    } else {
        panic("expected error for missing required field");
    }
}

__DATA__
{"test": {}}
