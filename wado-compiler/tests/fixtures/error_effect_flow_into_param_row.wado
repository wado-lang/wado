// A slot whose row is an effect parameter admits only that parameter: the
// function holds for every row its caller may pick, the empty one among them,
// so a value performing more escapes into a caller that declares nothing.
use { println, Stdout } from "core:cli";

fn make<effect E>() -> fn() with E {
    return || { println("leak"); };   // ERROR: `E` may be no effect at all
}

fn use_it() {
    let f: fn() = make();
    f();
}

export fn run() with Stdout {
    use_it();
}

