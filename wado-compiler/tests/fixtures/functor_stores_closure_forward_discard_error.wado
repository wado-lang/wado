// The forwarding-call soundness gap: a closure that forwards its reference
// parameter to a callee which stores it externally (into a global) — for the
// call's side effect, with the result discarded — persists the reference. Bound
// to a `fn(&Node)` (stores=[]) slot the optimization trusts, it must be rejected
// before lowering.

struct Node {
    n: i32,
}

global mut STASHED: &Node = &Node { n: 0 };

fn stash(n: &Node) with stores[n] {
    STASHED = n;
}

fn run_with(n: &Node, f: fn(&Node)) {
    f(n);
}

export fn run() {
    let x = Node { n: 1 };
    run_with(&x, |p: &Node| {
        stash(p);
    });
}

__DATA__
{"compile_error": "closure may not store reference parameter 'p'"}
