// Regression test: the NIR `string_push` append fusion collapses a run of
// adjacent appends on one buffer into a single `internal_reserve_uninit`, so a
// run pays one capacity check instead of one per piece.
//
// `dynamic` is the shape the JSON writers emit — a constant frame around a
// run-time string. Its length must be read *after* the pieces before it in the
// run and *before* the reservation that covers it, because the source may be
// the buffer itself: `self_append` appends `s` to `s`, where hoisting the
// length read over the earlier `push` would copy one byte too few. The fusion
// therefore opens a new group at each run-time length, and only the pieces
// after it share that group's reservation.
//
// `framed` covers a long literal. Its length is a constant, so it shares the
// leading `<`'s reservation, and the packed array it leaves behind is what
// `const_object_globalization` hoists into a module global the loop copies out
// of.
//
// All four helpers splice into `run`, so every run is checked on `run`'s own
// locals (`buf_0`, `s_2`). `dynamic`'s group split survives that: the fusion
// runs before `inline`, so `name` was still a parameter when it opened the
// second group. `constant` reserves once, ending at used 6; `dynamic` reserves
// twice, ending at 7 and then 12.

use { println, Stdout } from "core:cli";

fn constant(buf: &mut String) {
    buf.push('[');
    buf.push_str(&"true");
    buf.push(']');
}

fn dynamic(buf: &mut String, name: &String) {
    buf.push('"');
    buf.push_str(name);
    buf.push_str(&"\":");
}

fn framed(buf: &mut String) {
    buf.push('<');
    buf.push_str(&"a long constant hoisted to a global and copied back in");
    buf.push('>');
}

fn self_append(s: &mut String) {
    s.push('<');
    s.push_str(s);
    s.push('>');
}

export fn run() with Stdout {
    let mut buf = String::with_capacity(128);
    constant(&mut buf);
    dynamic(&mut buf, &"key");
    for let mut i = 0; i < 2; i += 1 {
        framed(&mut buf);
    }
    println(buf);

    let mut s = "ab";
    self_append(&mut s);
    println(s);
}

