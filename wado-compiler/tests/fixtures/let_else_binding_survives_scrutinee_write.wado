// A `let ... else` binding shares the payload only while nothing writes it:
// a write through the scrutinee afterwards leaves the binding's value alone.

struct P {
    v: i32,
}

fn through_local() -> i32 {
    let mut o = Option::Some(P { v: 1 });
    let Some(x) = o else {
        return 0;
    };
    if let Some(p) = &mut o {
        p.v = 7;
    }
    return x.v;
}

fn through_reference(o: &mut Option<P>) -> i32 {
    let Some(x) = *o else {
        return 0;
    };
    if let Some(p) = o {
        p.v = 9;
    }
    return x.v;
}

test {
    assert through_local() == 1;
    let mut o = builtin::black_box(Option::Some(P { v: 2 }));
    assert through_reference(&mut o) == 2;
    assert o.unwrap().v == 9;
}
