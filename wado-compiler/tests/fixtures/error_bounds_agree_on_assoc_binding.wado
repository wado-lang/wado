// Two bounds declaring `Output` make `T::Output` ambiguous even where both pin
// it to one type. The pin already names that type, so the report says to write
// it: `T` rather than `T::Output`.
struct Cm {
    v: i32,
}

impl Add for Cm {
    type Output = Cm;

    fn add(&self, rhs: &Cm) -> Cm {
        return Cm { v: self.v + rhs.v };
    }
}

impl Mul for Cm {
    type Output = Cm;

    fn mul(&self, rhs: &Cm) -> Cm {
        return Cm { v: self.v * rhs.v };
    }
}

fn poly<T: Add<Output = T> + Mul<Output = T>>(a: T, b: T) -> T::Output {
    return a * b + a;
}

export fn run() {
    assert poly(Cm { v: 2 }, Cm { v: 3 }).v == 8;
}

__DATA__
{ "compile_error": "ambiguous associated type 'T::Output': declared by 'Add' and 'Mul'; each pins it to 'T', so write 'T'" }
