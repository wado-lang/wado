// A default implementation is real code, so what it reaches is live: a
// function called only from one keeps its "used" mark, and the effects it
// performs propagate to whoever performs the operation.
use { println, Stdout } from "core:cli";

fn double(n: i32) -> i32 {
    return n * 2;
}

global mut TRACE: List<String> = [];

fn record(tag: String) {
    TRACE.push(tag);
}

interface Calc {
    // Reaches a private free function, and nothing else in the module calls
    // it — liveness has to walk here or reify drops it.
    fn value(n: i32) -> i32 {
        record(`default:${n}`);
        return double(n);
    }

    fn twice(n: i32) -> i32 {
        return Calc::value(n) + Calc::value(n);
    }
}

struct Fixed {
    answer: i32,
}

impl Calc for Fixed {
    fn value(&self, n: i32) -> i32 {
        record(`handler:${n}`);
        resume self.answer;
    }

    ..forward
}

export fn run() with Stdout {
    println(`${Calc::value(21)}`);
    // The default `twice` forwards to the default `value` twice.
    println(`${Calc::twice(3)}`);

    let f = Fixed { answer: 7 };
    with Calc => &f do {
        println(`${Calc::value(1)}`);
        // `twice` is unimplemented, so `..forward` reaches the default. A
        // forwarded operation runs in the outer scope — that is what stops a
        // forward from recursing into itself — and out there no handler is
        // installed, so the default `twice`'s own `Calc::value` calls land on
        // the default `value`, not back on `Fixed`.
        println(`${Calc::twice(2)}`);
    };

    for let tag of TRACE {
        println(tag);
    }
}

__DATA__
{
    "stdout": "42\n12\n7\n8\ndefault:21\ndefault:3\ndefault:3\nhandler:1\ndefault:2\ndefault:2\n"
}
