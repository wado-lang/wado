// Test basic global variable declaration and usage
use { println, Stdout } from "core:cli";

global ANSWER: i32 = 42;
global PI: f64 = 3.14159;
global FLAG: bool = true;

export fn run() with Stdout {
    println(`ANSWER={ANSWER}`);
    println(`PI={PI}`);
    println(`FLAG={FLAG}`);
}

__DATA__
{"stdout": "ANSWER=42\nPI=3.14159\nFLAG=true\n"}
