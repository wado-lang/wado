// An associated type belongs to the *instantiated* trait: `<Cm as Combine>::Out`
// and `<Cm as Combine<Inch>>::Out` are two answers, and the registry keyed only
// by the trait declaration kept the last one. `join<Cm>` then returned `Inch`.
use { println } from "core:cli";

trait Combine<Rhs = Self> {
    type Out;

    fn combine(&self, rhs: &Rhs) -> Self::Out;
}

struct Cm {
    v: i32,
}

struct Inch {
    v: i32,
}

impl Combine for Cm {
    type Out = Cm;

    fn combine(&self, rhs: &Cm) -> Cm {
        return Cm { v: self.v + rhs.v };
    }
}

impl Combine<Inch> for Cm {
    type Out = Inch;

    fn combine(&self, rhs: &Inch) -> Inch {
        return Inch { v: self.v * rhs.v };
    }
}

fn join<T: Combine>(a: T, b: T) -> T::Out {
    return a.combine(&b);
}

export fn run() with Stdout {
    assert join(Cm { v: 2 }, Cm { v: 3 }).v == 5;
    assert Cm { v: 2 }.combine(&Inch { v: 3 }).v == 6;
    println(`${join(Cm { v: 2 }, Cm { v: 3 }).v} ${Cm { v: 2 }.combine(&Inch { v: 3 }).v}`);
}

__DATA__
{"stdout": "5 6\n"}
