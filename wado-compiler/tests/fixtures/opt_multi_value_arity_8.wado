// Multi-value return ABI above the old 2..=4 arity cap.
//
// The cap was raised to 8 to match the variant layout cap
// (`MAX_PER_CASE_RESULT_FIELDS`), so a per-case variant layout is not rejected
// by the classifier that is supposed to serve it. Source-level tuples get the
// wider cap too.

#[inline("never")]
fn spread(seed: i32) -> [i32, i32, i32, i32, i32, i32] {
    return [seed, seed + 1, seed + 2, seed + 3, seed + 4, seed + 5];
}

#[inline("never")]
fn total(seed: i32) -> i32 {
    let t = spread(seed);
    return t.0 + t.1 + t.2 + t.3 + t.4 + t.5;
}

export fn run() {
    assert total(builtin::black_box(10)) == 75;
}

__DATA__
{
    "stdout": "",
    "wir_expect:O2": [
        "spread\" = fn(i32) -> [i32, i32, i32, i32, i32, i32]",
        "multivalue_bind ["
    ],
    "wir_not_expect:O2": [
        "struct.new \"tuple//[i32, i32, i32, i32, i32, i32]\""
    ]
}
