// `${…:?}` on an `Option<&primitive>`: boxing redefines the `&i32` `TypeId` to
// `Box<i32>`, so the reflect bridge minted before it and the call minted after
// it must still agree on the tag helper's name.
use { println } from "core:cli";

export fn run() with Stdout {
    let xs: List<i32> = [1, 2, 3];
    let ys: List<String> = ["a"];
    println(`${xs.iter_ref().next():?} ${ys.iter_ref().next():?}`);
}

__DATA__
{"stdout": "Option::Some(&1) Option::Some(&\"a\")\n"}
