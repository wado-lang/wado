// `${…:?}` on an `Option<&primitive>`: boxing redefines the `&i32` `TypeId` to
// `Box<i32>`, so the reflect bridge minted before it and the call minted after
// it must agree on the helper name, however deeply the borrow is nested.
use { println } from "core:cli";

struct Holder<T> {
    v: T,
}

export fn run() with Stdout {
    let xs: List<i32> = [1, 2, 3];
    let ys: List<String> = ["a"];
    let h = Holder { v: xs.iter_ref().next() };
    println(`${xs.iter_ref().next():?} ${ys.iter_ref().next():?} ${h:?}`);
}

__DATA__
{"stdout": "Option::Some(&1) Option::Some(&\"a\") Holder { v: Option::Some(&1) }\n"}
