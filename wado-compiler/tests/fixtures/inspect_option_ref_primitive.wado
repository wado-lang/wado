// `${…:?}` on an `Option<&primitive>`: the reflect bridge minted before boxing
// and the call minted after it must agree on the helper name, however deeply
// the reference is nested.
use { println, Stdout } from "core:cli";

struct Holder<T> {
    v: T,
}

export fn run() with Stdout {
    let xs: List<i32> = [1, 2, 3];
    let ys: List<String> = ["a"];
    let h = Holder { v: xs.iter_ref().next() };
    println(`${xs.iter_ref().next():?} ${ys.iter_ref().next():?} ${h:?}`);
}

__DATA__
{"stdout": "Option::Some(&1) Option::Some(&\"a\") Holder { v: Option::Some(&1) }\n"}
