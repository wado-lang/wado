// An argument that diverges, in the place of a parameter taken field by field,
// runs where it stands and leaves no fields: the call after it is dead.

struct Pair {
    a: i32,
    b: i32,
}

#[inline("never")]
fn ref_sum(p: &Pair) -> i32 {
    return p.a + p.b;
}

#[inline("never")]
fn owned_sum(p: Pair) -> i32 {
    return p.a + p.b;
}

export fn run() {
    let p = Pair { a: builtin::black_box(1), b: builtin::black_box(2) };
    assert ref_sum(&p) == 3;
    assert owned_sum(p) == 3;
    if builtin::black_box(false) {
        let _ = ref_sum(panic("referenced"));
        let _ = owned_sum(panic("owned"));
    }
}

__DATA__
{
    "stdout": "",
    "wir_expect:O2": [
        "ref_sum\" = fn(i32, i32) -> i32",
        "owned_sum\" = fn(i32, i32) -> i32"
    ]
}
