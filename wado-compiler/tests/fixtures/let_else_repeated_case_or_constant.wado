// A bare name that a case or a constant answers binds nothing, so repeating
// it in one scope redeclares nothing.

global LIMIT: i32 = 5;

fn cases(a: Option<i32>, b: Option<i32>) -> i32 {
    let None = a else { return 1; };
    let None = b else { return 2; };
    return 0;
}

fn constants(a: i32, b: i32) -> i32 {
    let LIMIT = a else { return 1; };
    let LIMIT = b else { return 2; };
    return 0;
}

test {
    assert cases(null, null) == 0;
    assert constants(5, 5) == 0 && constants(5, 4) == 2;
}

__DATA__
{"test": {}}
