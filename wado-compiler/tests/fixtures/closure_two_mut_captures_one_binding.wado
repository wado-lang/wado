// Regression: each closure reserves its own `__ref_a` slot and the capture list
// records that index, so reify has to write the `&mut` into the reserved slot
// rather than one it picks by name — two closures over one binding otherwise
// share a slot and the second reads what the first never wrote.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut a = 0;
    let mut f = || {
        a += 1;
    };
    let mut g = || {
        a += 1;
    };
    f();
    g();
    println(`${a}`);
}

__DATA__
{"stdout": "2\n"}
