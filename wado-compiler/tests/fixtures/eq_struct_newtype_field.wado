// A struct derives `Eq` and `Ord` over a newtype field: the field compares as
// its base does, since the newtype inherits the base's impls.

type Meters = f64;
type Id = i32;
type Name = String;

struct Row {
    id: Id,
    name: Name,
    len: Meters,
}

test "a newtype field compares as its base" {
    let a = Row { id: 1, name: "a", len: 1.5 };
    let b = Row { id: 1, name: "a", len: 1.5 };
    let c = Row { id: 1, name: "a", len: 2.5 };
    assert a == b;
    assert a != c;
    assert a < c;
}

variant Shape {
    Line(Meters),
    Dot,
}

struct Boxed<T> {
    v: T,
}

test "a newtype payload compares as its base" {
    assert Shape::Line(1.5) == Shape::Line(1.5);
    assert Shape::Line(1.5) != Shape::Line(2.5);
    assert Shape::Line(1.5) != Shape::Dot;
}

test "a generic struct at a newtype argument compares as its base" {
    let a: Boxed<Id> = Boxed { v: 1 };
    let b: Boxed<Id> = Boxed { v: 2 };
    assert a == a;
    assert a < b;
}

// The base's impls are derived here, not written, so the field's call is named
// by the base the derived body is synthesized for.
enum Hue {
    Red,
    Blue,
}

struct Point {
    x: i32,
}

type Tint = Hue;
type Spot = Point;

struct Paint {
    tint: Tint,
    spot: Spot,
}

variant Mark {
    Tinted(Tint),
    Placed(Spot),
}

test "a newtype field over a derived base compares as its base" {
    let a = Paint { tint: Tint::Red, spot: Point { x: 1 } as Spot };
    let b = Paint { tint: Tint::Red, spot: Point { x: 1 } as Spot };
    let c = Paint { tint: Tint::Blue, spot: Point { x: 1 } as Spot };
    assert a == b;
    assert a != c;
    assert a < c;
    assert Mark::Tinted(Tint::Red) == Mark::Tinted(Tint::Red);
    assert Mark::Placed(Point { x: 1 } as Spot) != Mark::Placed(Point { x: 2 } as Spot);
    assert Mark::Tinted(Tint::Blue) > Mark::Tinted(Tint::Red);
}

test "a body-local struct over a newtype field compares as its base" {
    type Local = i32;
    struct Pair {
        v: Local,
    }
    assert Pair { v: 1 } == Pair { v: 1 };
    assert Pair { v: 1 } < Pair { v: 2 };
}

__DATA__
{"test": {}}
