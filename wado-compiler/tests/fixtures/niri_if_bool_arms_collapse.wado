// Verify niri's bool-arms collapse rules:
//   `if cond { true } else { false }`  → `cond`
//   `if cond { false } else { true }`  → `!cond`
//
// The unit tests in tests/niri.rs check the in-place NIR rewrite
// directly. This e2e fixture verifies correctness end-to-end: the
// compiled program must still produce the same observable booleans
// regardless of whether the if-form or the rewritten form is in
// effect, for both the cond-preserving and the negated case.
//
// The conds come from `global mut` seeds: a mutable global is
// `Lattice::NonConst` to const-folding, so the cond survives to the
// bool-arms rule instead of the const-condition splice rule firing
// first. `#[inline(never)]` then keeps the call itself in the WIR.

use { println, Stdout } from "core:cli";

global mut POS_SEED: i32 = 7;
global mut NEG_SEED: i32 = -1;

#[inline(never)]
fn opaque_pos(x: i32) -> bool {
    return x > 0;
}

#[inline(never)]
fn opaque_neg(x: i32) -> bool {
    return x < 0;
}

export fn run() with Stdout {
    // true/false → cond
    let a = if opaque_pos(POS_SEED) {
        true;
    } else {
        false;
    };

    // false/true → !cond
    let b = if opaque_neg(POS_SEED) {
        false;
    } else {
        true;
    };

    // Same shape with the polarity that produces `false`.
    let c = if opaque_pos(NEG_SEED) {
        true;
    } else {
        false;
    };
    let d = if opaque_neg(NEG_SEED) {
        false;
    } else {
        true;
    };

    assert a;
    assert b;
    assert !c;
    assert !d;
    println(`${a} ${b} ${c} ${d}`);
}

__DATA__
{
    "stdout": "true true false false\n",
    "wir_expect:O2": [
        "/opaque_pos\"(global:niri_if_bool_arms_collapse.wado::POS_SEED);",
        "/opaque_neg\"(global:niri_if_bool_arms_collapse.wado::POS_SEED) == 0;"
    ]
}
