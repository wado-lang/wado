struct Pair<A, B> {
    a: A,
    b: B,
}

trait Name<N> {
    fn name(&self) -> String;
}

impl<T> Name<T> for Pair<T, i32> {
    fn name(&self) -> String {
        return "pinned";
    }
}

impl<A, B> Name<A> for Pair<A, B> {
    fn name(&self) -> String {
        return "open";
    }
}

export fn run() {
    let p: Pair<String, i32> = Pair { a: "x", b: 2 };
    let _ = p.name();
}

