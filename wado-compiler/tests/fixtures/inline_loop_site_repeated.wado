// A callee called from several sites of one loop is a dispatch: each site runs
// on some iterations only, so the loop price does not apply and `tally` keeps
// both calls to `decode_at`, although the price alone would admit it at a loop
// site (`inline_loop_site.wado`).

fn decode_at(bytes: &Array<u8>, pos: i32) -> [i32, i32] {
    let b0 = bytes[pos] as i32;
    if b0 < 0x80 {
        return [b0, 1];
    }
    if b0 < 0xE0 {
        return [(b0 & 0x1F) << 6 | bytes[pos + 1] as i32 & 0x3F, 2];
    }
    if b0 < 0xF0 {
        return [(b0 & 0x0F) << 12 | (bytes[pos + 1] as i32 & 0x3F) << 6 | bytes[pos + 2] as i32 & 0x3F, 3];
    }
    return [(b0 & 0x07) << 18 | (bytes[pos + 1] as i32 & 0x3F) << 12 | (bytes[pos + 2] as i32 & 0x3F) << 6 | bytes[pos + 3] as i32 & 0x3F, 4];
}

#[inline(never)]
fn tally(bytes: &Array<u8>, modes: &List<i32>) -> i32 {
    let mut total = 0;
    let mut pos = 0;
    for let mode of modes {
        if *mode == 0 {
            let [code, len] = decode_at(bytes, pos);
            total += code;
            pos += len;
        } else {
            let [code, len] = decode_at(bytes, pos);
            total -= code;
            pos += len;
        }
    }
    return total;
}

export fn run() {
    let mut bytes: Array<u8> = builtin::array_new(3);
    bytes[0] = 0x41;
    bytes[1] = 0xC3;
    bytes[2] = 0xA9;
    let modes: List<i32> = [0, 1];
    assert tally(&builtin::black_box(bytes), &builtin::black_box(modes)) == 0x41 - 0xE9;
}

__DATA__
{
    "stdout": "",
    "wir_scope": "inline_loop_site_repeated.wado/tally",
    "wir_expect:O2": ["\"inline_loop_site_repeated.wado/decode_at\"("]
}
