// WIR field-constant forwarding rewrites a statement with the knowledge held
// before it, then invalidates. Within one statement that is wrong for a call:
// `bump(&mut c)` is evaluated before the `c.n` arguments beside it.
//
// A statement's own store is unaffected — it evaluates its operand first.

struct Counter {
    n: i32,
}

#[inline(never)]
fn bump(c: &mut Counter) -> i32 {
    c.n = c.n + 10;
    return 1;
}

#[inline(never)]
fn total(a: i32, b: i32, c: i32) -> i32 {
    return a + b + c;
}

export fn run() {
    let mut c = Counter { n: 8 };
    let r = total(bump(&mut c), c.n, c.n);
    assert r == 37;
    assert c.n == 18;
}

__DATA__
{
    "stdout": ""
}
