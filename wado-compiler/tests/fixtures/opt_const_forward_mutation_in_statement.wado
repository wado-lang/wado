// WIR field-constant forwarding must not fold a field read that a call
// earlier in the *same statement* already mutated.
//
// `forward_struct_field_constants` rewrites a statement using the knowledge
// held before it, then invalidates that statement's mutation effects
// (`update_knowledge_from_instr` — "after its rewrite"). Within one statement
// that ordering is wrong: `bump(&mut c)` is evaluated before the `c.n`
// arguments beside it, so both reads fold to the pre-call constant.
//
// A statement's *own* store is not affected — `c.n = c.n + 1` evaluates its
// operand before storing, so folding the read there stays correct. Only a call
// can mutate between two operands of one statement.

struct Counter {
    n: i32,
}

#[inline(never)]
fn bump(c: &mut Counter) -> i32 {
    c.n = c.n + 10;
    return 1;
}

#[inline(never)]
fn total(a: i32, b: i32, c: i32) -> i32 {
    return a + b + c;
}

export fn run() {
    // `n` is a literal, so its value is known to the forwarding pass.
    let mut c = Counter { n: 8 };
    // `bump` makes `c.n` 18, so both reads must see 18: 1 + 18 + 18 == 37.
    let r = total(bump(&mut c), c.n, c.n);
    assert r == 37;
    assert c.n == 18;
}

__DATA__
{
    "stdout": ""
}
