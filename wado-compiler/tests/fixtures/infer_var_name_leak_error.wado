// An inference variable renders as the slot it stands for. Ids restart per
// module while the table of names outlives them, so the dependency's `Weird`
// takes id 0 and this module's own variable takes the id over.

use { g } from "./sub/infer_var_name_leak_error_dep.wado";

test "a variable no one named does not read another module's slot" {
    let x = Option::None;
    x.no_such_method();
}

__DATA__
{"test": {}, "compile_error": "no method 'no_such_method' found on type 'Option<?0>'"}
