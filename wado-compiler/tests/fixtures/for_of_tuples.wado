// For-of loop over array of tuples

use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let t1: [i32, i32] = [1, 2];
    let t2: [i32, i32] = [3, 4];
    let pairs: Array<[i32, i32]> = [t1, t2];
    for let p of pairs {
        println(`{p.0},{p.1}`);
    }
}

__DATA__
{"stdout": "1,2\n3,4\n"}
