// Test match expression with i8 literal patterns

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let x: i8 = 42 as i8;
    let y: i8 = 0 as i8;
    let z: i8 = -1 as i8;

    let r1 = match x {
        0 => "zero",
        1 => "one",
        42 => "answer",
        _ => "other",
    };
    println(r1);

    let r2 = match y {
        0 => "zero",
        _ => "other",
    };
    println(r2);

    let r3 = match z {
        0 => "zero",
        -1 => "minus one",
        _ => "other",
    };
    println(r3);
}

__DATA__
{"stdout": "answer\nzero\nminus one\n"}
