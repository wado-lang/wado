// Template strings should work inside generic impl blocks.
// Both display ({value}) and inspect ({value:?}) formats should work
// with generic type parameters.
//
// After monomorphization, the concrete type's Display impl is used
// for {value}, while {value:?} always uses inspect output.

struct Wrapper<T> {
    value: T,
}

fn identity<T>(x: T) -> T {
    return x;
}

fn make_wrapper<T>(value: T) -> Wrapper<T> {
    return Wrapper { value: value };
}

impl Wrapper<T> {
    fn display_value(&self) -> String {
        return `{self.value}`;
    }

    fn inspect_value(&self) -> String {
        return `{self.value:?}`;
    }

    fn both(&self) -> String {
        return `display={self.value} inspect={self.value:?}`;
    }
}

// Display: integers render the same way for display and inspect
test "display integer" {
    let b = Wrapper { value: 42 };
    assert b.display_value() == "42";
}

test "inspect integer" {
    let b = Wrapper { value: 42 };
    assert b.inspect_value() == "42";
}

// Display vs Inspect: strings differ (inspect adds quotes)
test "display string" {
    let b = Wrapper { value: "hello" };
    assert b.display_value() == "hello";
}

test "inspect string" {
    let b = Wrapper { value: "hello" };
    assert b.inspect_value() == `"hello"`;
}

// Both in the same template string
test "both display and inspect for integer" {
    let b = Wrapper { value: 99 };
    assert b.both() == "display=99 inspect=99";
}

test "both display and inspect for string" {
    let b = Wrapper { value: "world" };
    assert b.both() == `display=world inspect="world"`;
}

// Bool type
test "display bool" {
    let b = Wrapper { value: true };
    assert b.display_value() == "true";
}

test "inspect bool" {
    let b = Wrapper { value: true };
    assert b.inspect_value() == "true";
}

// Interpolations parse a full expression, so call-site turbofish
// (`fn::<T>(args)`) is allowed inside `{...}`.
test "free function turbofish" {
    assert `{identity::<i32>(42)}` == "42";
    assert `{identity::<String>("hi")}` == "hi";
}

// The `::` of the turbofish must not be mistaken for the `:` that starts a
// format specifier: here `::<i32>` is part of the expression and `:x` is the
// format specifier.
test "turbofish with format specifier" {
    assert `{identity::<i32>(255):x}` == "ff";
    assert `{identity::<i32>(7):03}` == "007";
}

// Turbofish on a generic constructor, followed by a field access on the result.
test "turbofish on generic constructor" {
    assert `{make_wrapper::<i32>(1).value}` == "1";
    assert `{make_wrapper::<String>("a").value}` == "a";
}

__DATA__
{"test": {}}
