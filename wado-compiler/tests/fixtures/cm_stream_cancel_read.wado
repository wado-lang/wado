// Dropping a read copy still in flight cancels it: no writer has written, so
// the read blocks, and the drop cancels it and ends without waiting for one.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let [rx, tx] = Stream::<u8>::new();
    let copy = rx.start_read(1);
    builtin::drop(copy);
    println(`cancelled`);
    tx.drop();
}

__DATA__
{"stdout": "cancelled\n"}
