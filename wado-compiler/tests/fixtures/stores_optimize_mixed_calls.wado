// Optimization: mixed forwarding outcomes.
// `read_point` (no stores) inlines and `a.x` forwards → its assert folds.
// `capture_point` (stores[p]) aliases `b`; mutating `b.x` through the stored
// reference blocks forwarding → `b.x`'s assert survives (forwarding the stale
// 30 past the write would be a miscompile).

use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

struct Ref {
    p: &Point,
}

// Small, no stores — will be inlined, field forwarding succeeds.
fn read_point(p: &Point) -> i32 {
    return p.x + p.y;
}

// Stores the reference — causes aliasing after inlining.
fn capture_point(p: &Point) -> Ref with stores[p] {
    return Ref { p };
}

export fn run() with Stdout {
    let a = Point { x: 10, y: 20 };
    let b = Point { x: 30, y: 40 };

    // a: non-stores call, inlined → field forwarding eliminates this assert.
    let _ = read_point(&a);
    assert a.x == 10;

    // b: stores call, aliased; mutate through the stored ref, then read back.
    // Forwarding cannot eliminate this assert — `b.x` is now 70.
    let r = capture_point(&b);
    r.p.x = 70;
    assert b.x == 70;

    println(`{a.x} {b.x}`);
}

__DATA__
{
    "stdout": "10 70\n",
    "wir_expect:O2": [
        "core:internal/panic"
    ]
}
