// Test: if let Ok(x) = result pattern matching
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let r: Result<i32, String> = Result::<i32, String>::Ok(42);

    if let Ok(x) = r {
        println(`Ok: {x}`);
    } else {
        println("Err");
    }
}

__DATA__
{"stdout": "Ok: 42\n"}
