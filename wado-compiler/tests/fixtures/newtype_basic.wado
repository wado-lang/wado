// Basic newtype semantics: distinct types with same representation

use { println, Stdout } from "core:cli";

type Meters = f64;
type Kilometers = f64;

export fn run() with Stdout {
    // Literal coercion to newtype
    let m: Meters = 1000.0;
    let km: Kilometers = 1.0;

    // Same-type operations work
    let m2: Meters = 500.0;
    let sum = m + m2;
    println(`sum of meters: {sum}`);

    // Explicit cast from newtype to base
    let raw: f64 = m as f64;
    println(`raw: {raw}`);

    // Explicit cast from base to newtype
    let from_raw: Meters = 100.0 as Meters;
    println(`from_raw: {from_raw}`);

    // Explicit cast between newtypes with same base
    let km_from_m = (m as f64 / 1000.0) as Kilometers;
    println(`km_from_m: {km_from_m}`);
}

__DATA__
{
    "stdout": "sum of meters: 1500\nraw: 1000\nfrom_raw: 100\nkm_from_m: 1\n",
    "wir_expect:O2": ["_licm_buf_", "_licm_repr_"]
}
