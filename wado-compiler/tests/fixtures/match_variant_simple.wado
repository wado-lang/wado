// Test simple match expression on custom variants (single payload)

use { println, Stdout } from "core:cli";

variant Shape {
    Circle(f64),
    Point,
}

fn run() with Stdout {
    let circle = Shape::Circle(5.0);
    let point = Shape::Point;

    // Match on Circle
    let result1 = match circle {
        Circle(r) => r * r,
        Point => 0.0,
    };

    println(`Circle result: {result1}`);

    // Match on Point
    let result2 = match point {
        Circle(r) => r * r,
        Point => 0.0,
    };

    println(`Point result: {result2}`);
}

__DATA__
{"stdout": "Circle result: 25.0\nPoint result: 0.0\n"}
