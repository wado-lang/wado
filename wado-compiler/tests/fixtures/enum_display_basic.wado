// Test: plain enums auto-derive Display as the bare case name
use { println, Stdout } from "core:cli";

enum Color {
    Red,
    Green,
    Blue,
}

export fn run() with Stdout {
    let r = Color::Red;
    let g = Color::Green;
    let b = Color::Blue;

    // Display of a plain enum is the bare case name (Inspect keeps `Color::`).
    println(`{r}`);
    println(`{g}`);
    println(`{b}`);
}

__DATA__
{"stdout": "Red\nGreen\nBlue\n"}
