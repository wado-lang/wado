// Cross-module `fn(..)^Inspect` dispatch with a different closure shape per
// module. Neither `synthesize_traits`'s per-module dedup nor the project-wide
// `SynthesisedImpls` may collapse the two shapes into one entry.
use { println, Stdout } from "core:cli";
use sub from "./sub/inspect_fn_cross_module_helper.wado";

export fn run() with Stdout {
    sub::show_in_helper();
    let g = |y: i32| y * 2;
    println(`from main: ${g:?}`);
}

__DATA__
{"stdout": "from helper: |i32| -> bool\nfrom main: |i32| -> i32\n"}
