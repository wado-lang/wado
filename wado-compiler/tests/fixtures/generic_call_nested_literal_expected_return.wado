// A numeric literal nested in a generic call's argument takes the type the
// call's expected return type settles, where no other argument settles one.
use { println, Stdout } from "core:cli";

struct Pair<T> {
    a: T,
    b: T,
}

struct Box<T> {
    v: T,
}

fn second<T>(p: Pair<T>, fallback: T) -> T {
    return if p.a == p.b { fallback } else { p.b };
}

fn unbox<T>(b: Box<T>) -> T {
    return b.v;
}

fn wrap<U>(u: U) -> Box<U> {
    return Box { v: u };
}

export fn run() with Stdout {
    let p: u64 = second(Pair { a: 1, b: 0x1_0000_0000 }, 5);
    let q: u64 = unbox(Box { v: 0x1_0000_0001 });
    let r: u64 = unbox(wrap(0x1_0000_0002));
    let s: f32 = unbox(Box { v: 1.5 });
    println(`${p} ${q} ${r} ${s}`);
}

__DATA__
{
    "stdout": "4294967296 4294967297 4294967298 1.5\n"
}
