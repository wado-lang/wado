// A type pattern inside a closure narrows for the closure's own body, and the
// local it holds the handle in is the closure's.

#[cm("example:demo/dom#node", linearity = "unrestricted", classes = "0..=1")]
resource Node {}

#[cm("example:demo/dom#input", linearity = "unrestricted", classes = "1..=1")]
resource HtmlInputElement extends Node {
    #[cm("example:demo/dom#input-value")]
    fn value(&self) -> String;
}

fn describe(n: Node) -> String {
    let read = |m: Node| match m {
        input: HtmlInputElement => input.value(),
        _ => "",
    };
    return read(n);
}

fn is_input(n: Node) -> bool {
    let test = |m: Node| m matches { _i: HtmlInputElement };
    return test(n);
}

fn is_input_else(n: Node) -> bool {
    let test = |m: Node| {
        let _i: HtmlInputElement = m else { return false; };
        return true;
    };
    return test(n);
}

test {
    with HtmlInputElement => &Typed {} do {
        assert describe(an_input()) == "typed";
        assert describe(a_node()) == "";
    }
    assert is_input(an_input()) && !is_input(a_node());
    assert is_input_else(an_input()) && !is_input_else(a_node());
}

struct Typed {}

impl HtmlInputElement for Typed {
    fn value(&self, this: &HtmlInputElement) -> String {
        resume "typed"
    }
}

// A handle is `class * 2^37 + index`: class 0 is a plain `Node`, class 1 an
// `HtmlInputElement`.
fn a_node() -> Node {
    return builtin::black_box(1.0) as Node;
}

fn an_input() -> Node {
    return builtin::black_box(137438953472.0 + 1.0) as Node;
}
