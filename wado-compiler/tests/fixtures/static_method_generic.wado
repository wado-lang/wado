// Test static method on generic type
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Create array with pre-allocated capacity using generic static method
    let mut arr = Array::<i32>::with_capacity(10);
    println(`initial len: {arr.len()}`);

    // Append some elements
    arr.append(1);
    arr.append(2);
    arr.append(3);

    println(`after append len: {arr.len()}`);

    // Access elements
    println(`arr[0]: {arr[0]}`);
    println(`arr[1]: {arr[1]}`);
    println(`arr[2]: {arr[2]}`);
}

__DATA__
{"stdout": "initial len: 0\nafter append len: 3\narr[0]: 1\narr[1]: 2\narr[2]: 3\n"}
