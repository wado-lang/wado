// A closure operand renders its signature, which is all `Inspect` has for one.
// Its body stays unwalked: a sub-expression there has no value at the moment
// the condition failed.

fn apply(f: fn(i32) -> i32, x: i32) -> i32 {
    return f(x);
}

export fn run() {
    let n = 3;
    assert apply(|x: i32| -> i32 { return x * 2; }, n) == 99;
}

__DATA__
{
    "trapped": true,
    "stderr_contains": ["|i32| -> i32"]
}
