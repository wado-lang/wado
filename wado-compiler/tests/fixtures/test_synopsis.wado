// The #[synopsis] attribute tags a test for `wado doc`'s Synopsis section.
// The test runner treats it as an ordinary test: it runs and must pass.

//! Small counter.

#[synopsis]
test {
    let mut n = 0;
    n += 41;
    n += 1;
    assert n == 42;
}

// #[synopsis] composes with #[expect_trap]: the body is expected to trap.
#[synopsis]
#[expect_trap]
test {
    panic("boom");
}
