// A generator may stamp its log with the wall clock though its world has none:
// an ambient effect the component lacks is never imported, so the generator
// compiles, and the clock answers `null`.

use { stamped } from "./sub/kiln/value.schema"
    with {
        generator: { module: "./sub/kiln/wall_clock_generator.wado" },
    };

test {
    assert !stamped();
}

__DATA__
{"test": {}}
