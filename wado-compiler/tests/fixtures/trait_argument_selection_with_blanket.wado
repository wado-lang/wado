// One trait's argument lists form an overload set the call's arguments choose
// from (WEP 2026-07-31), but another trait's blanket declaring the same name
// at the same level is no general case beside them: two traits share no
// contract, so the call is ambiguous however general the blanket is
// (issue #2650).
struct AKey {}

struct BKey {}

struct Locker {
    id: i32,
}

trait Take<T> with () {
    fn take(&self, x: T) -> String;
}

trait Loud with () {
    fn take(&self, x: AKey) -> String;
}

impl<T: Inspect> Loud for T {
    fn take(&self, x: AKey) -> String {
        return "blanket";
    }
}

impl Take<AKey> for Locker {
    fn take(&self, x: AKey) -> String {
        return "took A";
    }
}

impl Take<BKey> for Locker {
    fn take(&self, x: BKey) -> String {
        return "took B";
    }
}

export fn run() {
    let l = Locker { id: 1 };
    assert l.take(BKey {}) == "took B";
}

__DATA__
{"compile_error": "ambiguous method 'take': declared by 'Loud' and 'Take'; name the trait", "compile_error_codes": ["AMBIGUOUS_CANDIDATE"]}
