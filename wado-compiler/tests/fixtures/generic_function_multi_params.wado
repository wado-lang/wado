// Test: Generic function with multiple type parameters
use { println, Stdout } from "core:cli";

fn first<T, U>(x: T, y: U) -> T {
    return x;
}

fn second<T, U>(x: T, y: U) -> U {
    return y;
}

fn run() with Stdout {
    let a = first::<i32, i64>(10, 20 as i64);
    let b = second::<i32, i64>(30, 40 as i64);
    println(`a: {a}`);
    println(`b: {b}`);
}

__DATA__
{"stdout": "a: 10\nb: 40\n"}
