// Comprehensive test for wasi:filesystem module features
// Tests: Preopens effect

use { println, Stdout } from "core:cli";
use { Preopens, Descriptor } from "wasi:filesystem";

export fn run() with (Stdout, Preopens) {
    // Test Preopens::get_directories()
    // This returns the preopened directories available to the WASI runtime
    let dirs = Preopens::get_directories();

    // The number of preopened directories depends on the runtime configuration
    // In test environment, there might be 0 or more directories
    let dir_count = dirs.len();
    println(`test: preopens returned ${dir_count} directories`);

    // Verify we can access the array without crashing
    if dir_count > 0 {
        // Read the first directory's path, leaving its descriptor in the list
        let path = dirs[0].1;
        println(`test: first preopened path exists`);

        // Verify path is a string (can be empty for root or contain path)
        if path.len() >= 0 {
            println("test: preopened path is valid string");
        }
    } else {
        // No preopened directories is valid in sandboxed environment
        println("test: no preopened directories (valid for sandboxed env)");
    }

    println("all filesystem tests passed");
}

__DATA__
{"stdout_contains": ["test: preopens returned", "all filesystem tests passed"]}
