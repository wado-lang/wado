// Each branch settles one half of `Result`: the join answers both, and a
// branch that settles neither does not read the declaration's own `T` and `E`
// as answers. Issue #2574.
use { println, Stdout } from "core:cli";

fn conc(c: bool, v: i32) -> Result<i32, String> {
    let r = if c { Result::Ok(v) } else { Result::Err("x") };
    return r;
}

fn swapped(c: bool, v: i32) -> Result<i32, String> {
    let r = if c { Result::Err("y") } else { Result::Ok(v) };
    return r;
}

fn generic<T, E>(c: bool, v: T, e: E) -> Result<T, E> {
    let r = if c { Result::Ok(v) } else { Result::Err(e) };
    return r;
}

export fn run() with Stdout {
    let c = builtin::black_box(true);
    println(`${conc(c, 1):?} ${conc(!c, 2):?}`);
    println(`${swapped(c, 3):?} ${swapped(!c, 4):?}`);
    println(`${generic(c, 5, "e"):?} ${generic(!c, 6, "f"):?}`);
}

__DATA__
{"stdout": "Result::Ok(1) Result::Err(\"x\")\nResult::Err(\"y\") Result::Ok(4)\nResult::Ok(5) Result::Err(\"f\")\n"}
