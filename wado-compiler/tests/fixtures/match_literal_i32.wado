// Test match expression with i32 literal patterns

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let x: i32 = 42;
    let y: i32 = 0;
    let z: i32 = -1;

    let r1 = match x {
        0 => "zero",
        1 => "one",
        42 => "answer",
        _ => "other",
    };
    println(r1);

    let r2 = match y {
        0 => "zero",
        1 => "one",
        _ => "other",
    };
    println(r2);

    let r3 = match z {
        0 => "zero",
        -1 => "minus one",
        _ => "other",
    };
    println(r3);
}

__DATA__
{"stdout": "answer\nzero\nminus one\n"}
