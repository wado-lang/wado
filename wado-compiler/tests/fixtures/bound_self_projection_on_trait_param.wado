// A bound on a trait's own type parameter may write `Self::Assoc`, where `Self`
// is the implementing type: `Uses<Self::Item>` reads as `Uses<i32>` at
// `impl Host<Worker> for H` and as `Uses<String>` at `impl Host<Namer> for N`,
// so the two impls dispatch `go` to different declarations.
//
// The default body is elaborated twice over: once at the declaration, where `O`
// is abstract and the call dispatches through the bound, and once per impl,
// where `O` is the concrete type the impl wrote.

trait Uses<A> with () {
    fn go(&self, a: A) -> i32;
}

struct Worker {}

struct Namer {}

struct H {}

struct N {}

impl Uses<i32> for Worker {
    fn go(&self, a: i32) -> i32 {
        return a + 1;
    }
}

impl Uses<String> for Namer {
    fn go(&self, a: String) -> i32 {
        return a.len();
    }
}

trait Host<O: Uses<Self::Item>> with () {
    type Item;

    fn drive(&self, w: O, a: Self::Item) -> i32 {
        return w.go(a);
    }
}

impl Host<Worker> for H {
    type Item = i32;
}

impl Host<Namer> for N {
    type Item = String;
}

test "Self::Assoc in a bound on a trait's own type parameter" {
    assert H {}.drive(Worker {}, 41) == 42;
    assert N {}.drive(Namer {}, "hello") == 5;
}

__DATA__
{"test": {}}
