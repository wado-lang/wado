// A `_` stands for a new variable each time its expression is elaborated: once
// per element of an unrolled tuple `for-of`, and once per call that fills a
// default argument.

struct Bx<T> {
    v: T,
}

fn id<T>(x: T) -> T {
    return x;
}

fn none_of<T>() -> Option<T> {
    return null;
}

fn g<T>(x: T, y: Option<List<T>> = none_of::<List<_>>()) -> i32 {
    return if y matches { null } { 1 } else { 2 };
}

test "a tuple for-of" {
    let mut n = 0;
    for let v of [42, "hello", true] {
        let o = id::<Option<_>>(Some(v));
        let b = Bx::<_> { v };
        assert o matches { Some(_) };
        n += 1;
    }
    assert n == 3;
}

test "a default argument" {
    assert g(1) == 1 && g("s") == 1;
}
