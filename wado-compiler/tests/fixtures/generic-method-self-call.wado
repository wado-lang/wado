// Test: generic method calling another method on the same struct via self
// This works in user code thanks to transitive monomorphization.
//
// Remaining limitation: closures defined inside delegating methods in stdlib
// generic structs fail at codegen (functor __call not found). For example,
// sort() cannot delegate to sort_by() with a closure argument in the prelude.
//
// Related bug (now fixed): `if let` / `matches` on variants from imported
// modules now works thanks to global variant_case_map in pattern lowering.

use { println, Stdout } from "core:cli";

struct Wrapper<T> {
    value: T,
}

impl Wrapper<T> {
    fn new(value: T) -> Wrapper<T> {
        return Wrapper { value };
    }

    fn get(&self) -> T {
        return self.value;
    }

    // This method calls another method on self - works with transitive monomorphization
    fn get_twice(&self) -> [T, T] {
        let a = self.get();
        let b = self.get();
        return [a, b];
    }
}

export fn run() with Stdout {
    let w = Wrapper::<i32>::new(42);
    let v = w.get();
    println(`get: {v}`);

    let pair = w.get_twice();
    println(`get_twice: {pair.0}, {pair.1}`);
}

__DATA__
{"stdout": "get: 42\nget_twice: 42, 42\n"}
