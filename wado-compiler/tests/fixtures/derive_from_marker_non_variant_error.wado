// A `From` marker wraps its value in a variant case, so only a variant derives
// one, and a marker on any other type says so at the marker.

struct Meters {
    value: i32,
}

enum Color {
    Red,
}

flags Perms {
    Read,
}

impl From<i32> for Meters;
impl From<i32> for Color;
impl From<u32> for Perms;

export fn run() {}

