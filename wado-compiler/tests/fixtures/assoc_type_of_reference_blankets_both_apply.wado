// A referent that keeps the bounds of two blankets over a reference is
// answered by neither: the call is ambiguous, and no associated type is
// picked for it silently.

trait Named with () { fn name(&self) -> String; }
trait Counted with () { fn count(&self) -> i32; }

trait Out with () {
    type Of;
    fn out(self) -> Self::Of;
}

impl<A: Named> Out for &A {
    type Of = String;
    fn out(self) -> String { return (*self).name(); }
}

impl<B: Counted> Out for &B {
    type Of = i32;
    fn out(self) -> i32 { return (*self).count(); }
}

struct Both {}

impl Named for Both { fn name(&self) -> String { return "both"; } }
impl Counted for Both { fn count(&self) -> i32 { return 3; } }

fn out_of<X: Out>(x: X) -> X::Of {
    return x.out();
}

export fn run() {
    let b = Both {};
    let _ = out_of(&b);
}

