// Two modules each bind `Dom::f` to `web:a/global#f`, returning different
// types. One binding cannot serve both, and the call sites crashed on it.

use { Dom as ADom } from "./sub/cm_same_interface_name_two_modules_a.wado";
use { Dom as BDom } from "./sub/cm_same_binding_two_signatures_b.wado";

export fn run() with (ADom, BDom) {
    let _ = ADom::f();
    let _ = BDom::f();
}

