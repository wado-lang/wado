use { println, Stdout } from "core:cli";

// from ref_closure_capture.wado
fn apply_to_ref(r: &i32, f: fn(&i32) -> i32) -> i32 {
    return f(r);
}

// from ref_closure_mut_param.wado
fn modify_via_closure(r: &mut i32, f: fn(&mut i32) -> ()) {
    f(r);
}

// from ref_closure_capture.wado
fn ref_closure_capture() with Stdout {
    // Closure takes &T parameter
    let x = 42;
    let result = apply_to_ref(&x, |r: &i32| *r * 2);
    println(`doubled: {result}`);

    // Closure captures a variable and takes a ref param
    let multiplier = 3;
    let result2 = apply_to_ref(&x, |r: &i32| *r * multiplier);
    println(`tripled: {result2}`);
}

// from ref_closure_mut_param.wado
fn ref_closure_mut_param() with Stdout {
    let mut y = 10;
    modify_via_closure(&mut y, |r: &mut i32| {
        *r = *r + 5;
    });


    println(`modified: {y}`);
}

export fn run() with Stdout {
    ref_closure_capture();
    ref_closure_mut_param();
}

__DATA__
{"stdout": "doubled: 84\ntripled: 126\nmodified: 15\n"}
