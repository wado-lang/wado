// A closure handed to a method dispatched through a bound brings its effects
// to the row the call returns, as one handed to an impl's method does.
// Regression: the effect check read no parameter types for a trait's
// declaration, so the returned function's row was solved empty and a caller
// performing `Stdout` through it needed no `with`.

use { println } from "core:cli";

struct Held<F> { f: F }

trait Hold with () {
    fn hold<effect E, F: fn() -> i32 with E>(&self, f: F) -> Held<F>;
}

fn held<H: Hold>(h: &H) -> i32 {
    let shelved = h.hold(|| {
        println("held");
        return 7;
    });
    let f = shelved.f;
    return f();
}

__DATA__
{"compile_error": ":21:12: analysis error: missing effect 'Stdout' required by '(indirect call)'"}
