// A static a newtype inherits, passed where a slot is still open, gives the
// slot the newtype. The expected result is not read at the base: the base's
// result would answer the slot as `List<u8>` and refuse the `ByteList`.
fn id<T>(value: T) -> T {
    return value;
}

fn byte_len<T: AsByteSlice>(data: &T) -> i32 {
    return data.as_byte_slice().len();
}

test "an inherited static into an open slot keeps the newtype" {
    let kept = id(ByteList::with_capacity(3));
    assert kept.len() == 0;
    assert byte_len(&ByteList::filled(3, 7)) == 3;
}
