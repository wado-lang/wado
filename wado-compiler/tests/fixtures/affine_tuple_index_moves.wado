// A tuple's `t[0]` is its field `t.0`, so reading it by value moves the
// element out as `t.0` does.
affine struct Tok {
    id: i32,
}

impl Drop for Tok {
    fn drop(self) {
    }
}

test {
    let t = [Tok { id: 1 }, 2];
    let a = t[0];
    let b = t[0];
}

