// `#[benign(E)]` on a global admits `E` in its initializer. The initializer
// asks the host for a seed, which the global's value does not show, and has
// run before the test reads the global.

use { InsecureSeed } from "wasi:random";

fn seeded() -> i32 with InsecureSeed {
    let [_, _] = InsecureSeed::get_insecure_seed();
    return 7;
}

#[benign(InsecureSeed)]
global SEVEN: i32 = seeded();

test {
    assert SEVEN == 7;
}
