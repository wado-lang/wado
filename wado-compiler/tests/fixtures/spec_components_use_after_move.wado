// An affine resource is move-only.

pub resource Counter {
    fn bump(&self);
    fn consume(self);
}

fn eat(c: Counter) { }

fn misuse(c: Counter, d: Counter) {
    eat(c);          // moves `c`
    c.bump();        // ERROR: affine value `c` used after it was moved
    d.consume();     // a by-value `self` moves `d` too
}

__DATA__
{"compile_error": "affine value `c` used after it was moved"}
