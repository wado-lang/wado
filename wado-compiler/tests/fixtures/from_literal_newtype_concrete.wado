use { println, Stdout } from "core:cli";

type Tag = String;

struct TagMap<K, V> {
    keys: List<String>,
    values: List<V>,
}

impl From<Array<[String, V]>> for TagMap<Tag, V> {
    fn from(entries: Array<[String, V]>) -> TagMap<Tag, V> {
        let mut out: TagMap<Tag, V> = TagMap { keys: [], values: [] };
        for let [key, value] of entries {
            out.keys.push(key);
            out.values.push(value);
        }
        return out;
    }
}

export fn run() with Stdout {
    let m: TagMap<Tag, i32> = { a: 1, b: 2 };
    assert m.keys.len() == 2;
    assert m.values[0] == 1;
    println("ok");
}

__DATA__
{"stdout": "ok\n"}
