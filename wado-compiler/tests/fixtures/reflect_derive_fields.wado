// Field-value derivation over Reflect (WEP 2026-06-13 §1): the derivation reads
// each field's VALUE via `Reflect::<T>::fields(self)`, whose type is the field
// pack `[..F]`. The inline bound `impl<T: Reflect<Fields = [..F]>, ..F: Weight>`
// projects `F` from `T`'s `Fields` at monomorphization; the `for-of` walks the
// pack, dispatching `weight()` per concrete field type.

trait Weight {
    fn weight(&self) -> i32;
}

impl Weight for i32 {
    fn weight(&self) -> i32 {
        return *self;
    }
}

impl Weight for bool {
    fn weight(&self) -> i32 {
        if *self {
            return 100;
        }
        return 0;
    }
}

impl<T: Reflect<Fields = [..F]>, ..F: Weight> Weight for T {
    fn weight(&self) -> i32 {
        let values: [..F] = Reflect::<T>::fields(self);
        let mut total: i32 = 0;
        for let v of values {
            total = total + v.weight();
        }
        return total;
    }
}

struct Point {
    x: i32,
    y: i32,
}

struct Mixed {
    a: i32,
    flag: bool,
}

test "field-value pack derivation sums field weights" {
    let p = Point { x: 3, y: 4 };
    assert p.weight() == 7;

    let m = Mixed { a: 5, flag: true };
    assert m.weight() == 105;
}

