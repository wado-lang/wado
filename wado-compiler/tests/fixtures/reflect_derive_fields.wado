// Field-value derivation over Reflect (WEP 2026-06-13): the derivation reads
// each field's VALUE via the `field_tokens()` walk (`Field::get`), whose type is
// the field pack element `F_k`. The inline bound
// `impl<T: Reflect<Fields = [..F]>, ..F: Weight>` projects `F` from `T`'s
// `Fields` at monomorphization; the token walk dispatches `weight()` per concrete
// field type.

trait Weight {
    fn weight(&self) -> i32;
}

impl Weight for i32 {
    fn weight(&self) -> i32 {
        return *self;
    }
}

impl Weight for bool {
    fn weight(&self) -> i32 {
        if *self {
            return 100;
        }
        return 0;
    }
}

impl<T: Reflect<Fields = [..F]>, ..F: Weight> Weight for T {
    fn weight(&self) -> i32 {
        let mut total: i32 = 0;
        for let f of Reflect::<T>::field_tokens() {
            total = total + f.get(self).weight();
        }
        return total;
    }
}

struct Point {
    x: i32,
    y: i32,
}

struct Mixed {
    a: i32,
    flag: bool,
}

test "field-value token walk sums field weights" {
    let p = Point { x: 3, y: 4 };
    assert p.weight() == 7;

    let m = Mixed { a: 5, flag: true };
    assert m.weight() == 105;
}

