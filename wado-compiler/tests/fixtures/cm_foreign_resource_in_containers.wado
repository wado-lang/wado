// An interface taking a resource another interface declares, inside an option,
// a borrowed option, a result, and a record. The instance aliases the resource
// and defines one `own` and one `borrow` over it, which every container reuses.

#[cm("wasi:demo/types@0.1.0#device")]
resource Device {
    #[cm("wasi:demo/types@0.1.0#[method]device.id")]
    #[cm_params("self")]
    fn id(&self) -> u32;
}

interface Maker {
    #[cm("wasi:demo/types@0.1.0#get-device")]
    fn get_device() -> Device;
}

#[cm("wasi:demo/user@0.1.0#slot")]
struct Slot {
    #[cm("device")]
    device: Device,
}

interface User {
    #[cm("wasi:demo/user@0.1.0#take")]
    #[cm_params("d")]
    fn take(d: Option<Device>) -> u32;
    #[cm("wasi:demo/user@0.1.0#peek")]
    #[cm_params("d")]
    fn peek(d: Option<&Device>) -> u32;
    #[cm("wasi:demo/user@0.1.0#settle")]
    #[cm_params("d")]
    fn settle(d: Result<Device, u32>) -> u32;
    #[cm("wasi:demo/user@0.1.0#fill")]
    #[cm_params("s")]
    fn fill(s: Slot) -> u32;
}

export fn run() with (Maker, User, Device) {
    let d = Maker::get_device();
    let _ = User::peek(Option::Some(&d));
    let _ = User::take(Option::Some(d));
    let _ = User::settle(Result::<Device, u32>::Ok(Maker::get_device()));
    let _ = User::fill(Slot { device: Maker::get_device() });
}

__DATA__
{
  "compile_only": true,
  "wat_lines": [
    { "contains": ["(import \"wasi:demo/user@0.1.0\""], "count": 1 },
    { "contains": ["(option 1)"], "count": 1 },
    { "contains": ["(option 2)"], "count": 1 },
    { "contains": ["(result 1 (error u32))"], "count": 1 },
    { "contains": ["(field \"device\" 1)"], "count": 1 }
  ]
}
