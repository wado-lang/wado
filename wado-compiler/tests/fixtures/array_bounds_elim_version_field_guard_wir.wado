// Loop-versioned BCE under a guard whose bound is a `let` of a field,
// `let per_row = shape.per_row`. The residual reads that local, as the guard
// does, rather than the field the bound came from.

use { println, Stdout } from "core:cli";

struct Shape {
    per_row: i32,
}

#[inline(never)]
fn first_row(xs: &List<i32>, shape: &Shape) -> i32 {
    let per_row = shape.per_row;
    let mut sum = 0;
    for let mut v = 0; v + 1 < per_row; v += 2 {
        sum += xs[v] + xs[v + 1];
    }
    return sum;
}

export fn run() with Stdout {
    let xs: List<i32> = [1, 2, 3, 4, 5, 6];
    println(`${first_row(&xs, &Shape { per_row: builtin::black_box(5) })}`);
}

__DATA__
{
    "stdout": "10\n",
    "wir_scope": ".wado/first_row",
    "wir_expect:O2": [
        " + -2_i64) + 1_i64) < builtin::i64_extend_i32_s($licm_used_{})"
    ]
}
