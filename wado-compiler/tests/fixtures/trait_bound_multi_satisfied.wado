// Test: multiple bounds all satisfied
use { println, Stdout } from "core:cli";

trait Drawable {
    fn draw(&self) -> String;
}

trait Clickable {
    fn on_click(&self) -> String;
}

struct Button {
    label: String,
}

impl Drawable for Button {
    fn draw(&self) -> String {
        return `[{self.label}]`;
    }
}

impl Clickable for Button {
    fn on_click(&self) -> String {
        return `clicked {self.label}`;
    }
}

struct Widget<T: Drawable + Clickable> {
    item: T,
}

export fn run() with Stdout {
    let w = Widget { item: Button { label: "OK" } };
    println(w.item.draw());
    println(w.item.on_click());
}

__DATA__
{"stdout": "[OK]\nclicked OK\n"}
