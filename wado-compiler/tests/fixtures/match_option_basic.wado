// Test basic match expression on Option<T>

use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let some_val: Option<i32> = Option::<i32>::Some(42);
    let none_val: Option<i32> = null;

    // Match on Some
    let x = match some_val {
        Some(v) => v * 2,
        None => 0,
    };

    println(`Result from Some: {x}`);

    // Match on None
    let y = match none_val {
        Some(v) => v * 2,
        None => -1,
    };

    println(`Result from None: {y}`);
}

__DATA__
{"stdout": "Result from Some: 84\nResult from None: -1\n"}
