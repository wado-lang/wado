// Index assignment with different value types
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // i32
    let mut arr_i32: List<i32> = [0];
    arr_i32[0] = 42;
    println(`i32: {arr_i32[0]}`);

    // i64
    let mut arr_i64: List<i64> = [0 as i64];
    arr_i64[0] = 9999999999 as i64;
    println(`i64: {arr_i64[0]}`);

    // f32
    let mut arr_f32: List<f32> = [0.0 as f32];
    arr_f32[0] = 3.14 as f32;
    println(`f32: {arr_f32[0]}`);

    // f64
    let mut arr_f64: List<f64> = [0.0];
    arr_f64[0] = 2.718281828;
    println(`f64: {arr_f64[0]}`);

    // bool
    let mut arr_bool: List<bool> = [false];
    arr_bool[0] = true;
    println(`bool: {arr_bool[0]}`);
}

__DATA__
{"stdout_contains": ["i32: 42", "i64: 9999999999", "f32: 3.14", "f64: 2.718281828", "bool: true"]}
