// A loop guard `i >= 0` proves the lower half of the index contract
// `0 <= index < self.len()`, so only the upper half is left to check.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn sum_back(xs: &List<i32>, from: i32) -> i32 {
    let mut s = 0;
    for let mut i = from; i >= 0; i -= 1 {
        s += xs[i];
    }
    return s;
}

export fn run() with Stdout {
    let xs: List<i32> = [1, 2, 3];
    println(`${sum_back(&xs, builtin::black_box(2))}`);
}

__DATA__
{
    "stdout": "6\n",
    "wir_scope": "sum_back",
    "wir_expect:O2": [
        "index_value$cold0"
    ],
    "wir_not_expect:O2": [
        "0 <= i",
        "0 > i"
    ]
}
