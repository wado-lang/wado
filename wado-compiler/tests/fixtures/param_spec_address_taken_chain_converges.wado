// An immutable parameter whose address is taken is read as itself, its box
// serving only `&k`, so `param_spec` carries a constant down the chain in one
// round rather than one link per round, which never converged.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn g01(k: i32, n: i32) -> i32 {
    builtin::black_box(&k);
    return g02(k, n + k);
}

#[inline(never)]
fn g02(k: i32, n: i32) -> i32 {
    builtin::black_box(&k);
    return g03(k, n + k);
}

