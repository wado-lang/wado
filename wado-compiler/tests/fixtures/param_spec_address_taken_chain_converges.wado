#[inline(never)]
fn g20(k: i32, n: i32) -> i32 {
    return n + k;
}

export fn run() with Stdout {
    println(`${g01(3, builtin::black_box(0))}`);
}

__DATA__
{
    "stdout": "60\n",
    "wir_expect:O2": ["g20$spec"]
