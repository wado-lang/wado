// `String` and `List<T>` compare lexicographically.

test {
    let a = "apple";
    let b = "banana";
    assert a < b;                    // lexicographic ordering
    assert a == "apple" && a != b;   // byte-by-byte equality

    let xs: List<i32> = [1, 2];
    assert xs < [1, 3] && xs < [1, 2, 0];
}
