use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Integer types
    let i = 42;
    println(`{i:?}`);

    let neg = -7;
    println(`{neg:?}`);

    // Float
    let f = 3.14;
    println(`{f:?}`);

    // Bool
    let b = true;
    println(`{b:?}`);
    let bf = false;
    println(`{bf:?}`);

    // Char
    let c = 'A';
    println(`{c:?}`);

    // Unit (via empty template)
    println("ok");
}

__DATA__
{"stdout": "42\n-7\n3.14\ntrue\nfalse\n'A'\nok\n"}
