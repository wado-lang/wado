#![no_prelude]
// The prelude's `Ordering`, declared in a module that does not import the
// prelude, so the name is free.

/// Result of a three-way comparison
pub enum Ordering {
    Less,    // first value is less than second
    Equal,   // values are equal
    Greater, // first value is greater than second
}

test {
    assert Ordering::Less != Ordering::Greater;
}
