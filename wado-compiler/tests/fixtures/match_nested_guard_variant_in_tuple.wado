// Bug: guard conditions on variant-extracted values in tuple produce wrong results.
// [Some(a), Some(b)] && a > b should correctly test a=100 > b=5.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let pair = [Option::Some(100), Option::Some(5)];
    let desc = match pair {
        [Some(a), Some(b)] && a > b => `a wins: ${a}`,
        [Some(a), Some(b)] => `b wins: ${b}`,
        _ => "other",
    };
    println(desc);
}

__DATA__
{"stdout": "a wins: 100\n"}
