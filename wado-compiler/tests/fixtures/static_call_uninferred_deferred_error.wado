// A static call whose type parameters nothing answers is reported at the call
// that left them open, once nothing later answered them either.

use { HashMap } from "core:collections";

test {
    let m = HashMap::new();
    assert m.len() == 0;
}

__DATA__
{
    "compile_error": "7:13: cannot infer type parameter `K`, `V` of `HashMap::new`",
    "compile_error_count": 1
}
