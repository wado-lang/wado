// Namespace-imported globals must resolve both as `ns::G` and as the bare `G`
// directly available from the namespace import.
use h from "./sub/ns_robust_helper.wado";

test "namespace global via ns:: and bare" {
    assert h::ANSWER == 42;
    assert ANSWER == 42;
}

test "namespace mutable global write" {
    h::COUNTER = 7;
    assert h::COUNTER == 7;
    COUNTER = COUNTER + 1;
    assert h::COUNTER == 8;
}

__DATA__
{"test": {}}
