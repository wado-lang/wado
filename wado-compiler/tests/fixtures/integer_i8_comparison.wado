// Test i8 comparison operations
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let a: i8 = 10 as i8;
    let b: i8 = 20 as i8;
    let c: i8 = -5 as i8;

    // Positive comparisons
    if a < b {
        println("a < b: true");
    }
    if a <= b {
        println("a <= b: true");
    }
    if b > a {
        println("b > a: true");
    }
    if b >= a {
        println("b >= a: true");
    }

    // Negative comparisons (critical for signed types)
    if c < a {
        println("c < a: true");
    }
    if c < 0 as i8 {
        println("c < 0: true");
    }
    if a > c {
        println("a > c: true");
    }

    // Equality
    let d: i8 = 10 as i8;
    if a == d {
        println("a == d: true");
    }
    if a != b {
        println("a != b: true");
    }
}

__DATA__
{"stdout": "a < b: true\na <= b: true\nb > a: true\nb >= a: true\nc < a: true\nc < 0: true\na > c: true\na == d: true\na != b: true\n"}
