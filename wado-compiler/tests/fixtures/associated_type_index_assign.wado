// Test: IndexAssign trait with associated types
use { println, Stdout } from "core:cli";

struct MutableBox {
    value: i32,
}

// Implement IndexAssign trait
impl IndexAssign<i32> for MutableBox {
    type Input = i32;

    fn index_assign(&mut self, _index: i32, value: Self::Input) {
        self.value = value;
    }
}

fn run() with Stdout {
    let mut box = MutableBox { value: 0 };
    // Call index_assign explicitly
    box.index_assign(0, 42);
    println(`Value: {box.value}`);
}

__DATA__
{"stdout": "Value: 42\n"}
