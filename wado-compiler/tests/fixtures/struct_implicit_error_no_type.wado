// Anonymous struct literal (was previously an error, now supported)

use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

export fn run() with Stdout {
    let p = { x: 1, y: 2 };  // Anonymous struct (no longer an error)
    println(`{p.x}, {p.y}`);
}

__DATA__
{"stdout": "1, 2\n"}
