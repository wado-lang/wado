// Test that unwrap() on a fresh Result does not produce double value_copy.
// The inlined unwrap pattern should recognize that FieldAccess and VariantPayload
// on fresh values are themselves fresh, eliminating unnecessary copies.

use { println, Stdout } from "core:cli";

fn make_result() -> Result<List<u8>, String> {
    let mut arr: List<u8> = [];
    arr.push(1);
    arr.push(2);
    arr.push(3);
    return Result::<List<u8>, String>::Ok(arr);
}

export fn run() with Stdout {
    let data = make_result().unwrap();
    assert data.len() == 3;
    println("ok");
}

__DATA__
{
    "stdout": "ok\n",
    "wir_expect:O2": ["data = __inline_Result_core_prelude_list_wado_List_u8__core_prelude_string_wado_String___unwrap_5: block"],
    "wir_not_expect:O2": ["data = value_copy"]
}
