// Closure variant of the partial-return rejection: an `if cond { return …; }`
// with no `else` lets the body fall through with the body's tail value type,
// which doesn't match the inner `return`'s value type. The closure elaborator
// rejects this so the discrepancy doesn't reach codegen and emit invalid Wasm.

export fn run() {
    let f = |cond: bool| {
        if cond {
            return 1;
        }
    };
    let _ = f(false);
}

__DATA__
{"compile_error": "function with return type 'i32' must use explicit `return`"}
