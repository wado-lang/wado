// `let x: T = <never-expr>` is valid because `never` is the bottom type.
// The expression diverges at runtime (traps), so the variable is never used.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // This is reached: match produces a value normally
    let opt: Option<i32> = Option::<i32>::Some(42);
    let x: i32 = match opt {
        Some(v) => v,
        None => panic("none"),
    };
    assert x == 42;

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
