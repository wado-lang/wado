// A value blanket whose receiver parameter carries no bound is rejected, and
// a call its method would have answered finds no method rather than reaching
// the rejected block.

trait Conv<U> {
    fn conv(&self) -> i32;
}

impl<T, U> Conv<U> for T {
    fn conv(&self) -> i32 {
        return 1;
    }
}

export fn run() {
    let x = 5;
    let _y = x.conv();
}

__DATA__
{
    "compile_error": ":9:1: analysis error: blanket impl of `Conv` for `T` states no bound"
