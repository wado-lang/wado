//! A caller's own argument substituted into a callee's default is still the
//! caller's code: its file-private members stay reachable, and the callee's
//! private struct literal in the default stays reachable there.
use { with_scalar_default, with_literal_default } from "./sub/default_vantage_lib.wado";

struct Local { v: i32 }

impl Local {
  fn secret(&self) -> i32 { return self.v }
}

test "a caller's private method reaches into a substituted default" {
    let t = Local { v: 1 };
    assert with_scalar_default(t.secret()) == 3;
}

test "a callee's private field reaches inside its own default literal" {
    assert with_literal_default(1) == 2;
}
