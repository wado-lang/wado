// Test: trait bounds with mutable reference parameters
use { println, Stdout } from "core:cli";

trait Resettable {
    fn reset(&mut self);
}

struct Counter {
    count: i32,
}

impl Resettable for Counter {
    fn reset(&mut self) {
        self.count = 0;
    }
}

fn reset_it<T: Resettable>(item: &mut T) {
    item.reset();
}

export fn run() with Stdout {
    let mut c = Counter { count: 42 };
    reset_it::<Counter>(&mut c);
    println(`{c.count}`);
}

__DATA__
{"stdout": "0\n"}
