// A range check against a non-negative bound compiles to one unsigned compare:
// a negative index reads as at least 2^31, past every bound below it.

use { println, Stdout } from "core:cli";

fn inside_list(xs: &List<i32>, i: i32) -> bool {
    return 0 <= i && i < xs.len();
}

fn inside_const(x: i64) -> bool {
    return x >= 0 && x <= 9;
}

fn outside_list(xs: &List<i32>, i: i32) -> bool {
    return i < 0 || i >= xs.len();
}

export fn run() with Stdout {
    let xs: List<i32> = builtin::black_box([10, 20, 30]);
    for let i of [-2147483648, -1, 0, 2, 3, 2147483647] as List<i32> {
        let i = builtin::black_box(i);
        println(`${i}: ${inside_list(&xs, i)} ${outside_list(&xs, i)}`);
    }
    for let x of [-1, 0, 9, 10] as List<i64> {
        println(`${x}: ${inside_const(builtin::black_box(x))}`);
    }
    println(`${xs[builtin::black_box(2)]}`);
}

__DATA__
{
    "stdout": "-2147483648: false true\n-1: false true\n0: true false\n2: true false\n3: false true\n2147483647: false true\n-1: false\n0: true\n9: true\n10: false\n30\n",
    "wir_scope": "/run\"",
    "wir_expect:O2": [
        "= item_{i} <u $licm_used_{n};",
        "= $licm_used_{n} <=u item_{i};",
        " <=u 9_i64;",
        "if @unlikely($mv_field_{} >=u $mv_field_{}) {"
    ],
    "wir_not_expect:O2": [
        "0 <= ",
        "item_{} < 0 "
    ]
}
