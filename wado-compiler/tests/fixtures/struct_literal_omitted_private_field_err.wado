// A literal written outside a struct's module cannot set a field hidden from
// it, so leaving one out says the literal cannot build it rather than asking for it.
use { Secret } from "./sub/internal_field_module.wado";

fn named() -> Secret {
    return Secret { label: "a" };
}

fn unnamed() -> Secret {
    return { label: "b" };
}

fn prelude() -> List<i32> {
    return { a: 1 };
}

export fn run() {
    let _ = named();
    let _ = unnamed();
    let _ = prelude();
}

