// The escape half of `stores_local_view_of_ref_param`: handing the view out is
// the parameter escaping, and the carries analysis names the return as the
// place it happens.
fn view_of(s: &String) -> ByteSlice {
    return s.as_byte_slice();
}

export fn run() {
    assert view_of(&"abc").len() == 3;
}

__DATA__
{ "compile_error": "returning reference parameter 's' requires `stores[s]` declaration" }
