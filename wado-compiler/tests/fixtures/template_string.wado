use { println, Stdout } from "core:cli";


// from template_string_bool.wado
fn template_string_bool() with Stdout {
    let t = true;
    let f = false;
    println(`true: {t}`);
    println(`false: {f}`);
}

// from template_string_char.wado
fn template_string_char() with Stdout {
    let a = 'A';
    let z = 'Z';
    println(`char A: {a}`);
    println(`char Z: {z}`);
}

// from template_string_empty.wado
fn template_string_empty() with Stdout {
    let s = ``;
    println(s);
}

// from template_string_f64.wado
fn template_string_f64() with Stdout {
    let pi = 3.14159;
    let neg = 0.0 - 2.5;
    println(`pi: {pi}`);
    println(`negative: {neg}`);
}

// from template_string_i32.wado
fn template_string_i32() with Stdout {
    let pos = 42;
    let neg = 0 - 17;
    let zero = 0;
    println(`positive: {pos}`);
    println(`negative: {neg}`);
    println(`zero: {zero}`);
}

// from template_string_i64.wado
fn template_string_i64() with Stdout {
    let pos: i64 = 12345 as i64;
    // Build a large number through multiplication to avoid literal truncation
    let big: i64 = 100000 as i64 * 1000000 as i64;
    let neg: i64 = 0 as i64 - 9876 as i64;
    println(`positive: {pos}`);
    println(`big: {big}`);
    println(`negative: {neg}`);
}

// from template_string_multiline.wado
fn template_string_multiline() with Stdout {
    // Multiline template string without interpolation
    let simple = `Line 1
Line 2
Line 3`;
    println(simple);

    // Multiline template with interpolation
    let name = "Alice";
    let greeting = `Dear {name},

Welcome to Wado!

Best regards`;
    println(greeting);

    // Multiline with multiple interpolations
    let a = 1;
    let b = 2;
    let result = `First: {a}
Second: {b}
Sum: {a + b}`;
    println(result);

    println("done");
}

// from template_string_three_interp.wado
fn template_string_three_interp() with Stdout {
    let s1 = "X";
    let s2 = "Y";
    let s3 = "Z";
    println(`{s1} a {s2} c {s3}`);
}

// from template_string_two_end.wado
fn template_string_two_end() with Stdout {
    let s1 = "X";
    let s2 = "Y";
    println(`a {s1} b {s2}`);
}

// from template_string_two_interp.wado
fn template_string_two_interp() with Stdout {
    let s1 = "X";
    let s2 = "Y";
    println(`{s1} a {s2} c`);
}

// from template_string_two_middle.wado
fn template_string_two_middle() with Stdout {
    let s1 = "X";
    let s2 = "Y";
    println(`a {s1} b {s2} c`);
}

// Interpolations hold arbitrary expressions, so an `if`/`match` expression can
// appear inside `{...}` — and each arm can itself be a template string, nesting
// interpolation within interpolation.
fn template_string_nested_expr() with Stdout {
    let n = 7;
    // `if` expression with nested template strings in both arms.
    println(`status: {if n % 2 == 0 { `{n} is even` } else { `{n} is odd` }}`);
    // `match` expression with nested template strings in the arms.
    println(`{match n { 0 => `zero`, _ => `nonzero ({n})` }}`);
    // Nested interpolation can stack more than one level deep.
    let inner = 1;
    println(`{if n > 0 { `inner={if inner == 1 { `one` } else { `other` }}` } else { `none` }}`);
}

export fn run() with Stdout {
    template_string_bool();
    template_string_char();
    template_string_empty();
    template_string_f64();
    template_string_i32();
    template_string_i64();
    template_string_multiline();
    template_string_three_interp();
    template_string_two_end();
    template_string_two_interp();
    template_string_two_middle();
    template_string_nested_expr();
}

__DATA__
{"stdout": "true: true\nfalse: false\nchar A: A\nchar Z: Z\n\npi: 3.14159\nnegative: -2.5\npositive: 42\nnegative: -17\nzero: 0\npositive: 12345\nbig: 100000000000\nnegative: -9876\nLine 1\nLine 2\nLine 3\nDear Alice,\n\nWelcome to Wado!\n\nBest regards\nFirst: 1\nSecond: 2\nSum: 3\ndone\nX a Y c Z\na X b Y\nX a Y c\na X b Y c\nstatus: 7 is odd\nnonzero (7)\ninner=one\n"}
