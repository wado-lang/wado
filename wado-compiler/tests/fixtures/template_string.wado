// Template string literals: what an interpolation renders for each type, how
// many segments a template may have, nesting, escapes, and the expressions an
// interpolation accepts.

struct Wrapper<T> {
    value: T,
}

struct Case {
    payload: Option<String>,
}

fn identity<T>(x: T) -> T {
    return x;
}

fn make_wrapper<T>(value: T) -> Wrapper<T> {
    return Wrapper { value: value };
}

fn pick(a: i32, c: char) -> i32 {
    return a;
}

impl Wrapper<T> {
    fn display_value(&self) -> String {
        return `${self.value}`;
    }

    fn inspect_value(&self) -> String {
        return `${self.value:?}`;
    }

    fn both(&self) -> String {
        return `display=${self.value} inspect=${self.value:?}`;
    }
}

test "bool interpolation" {
    let t = true;
    let f = false;
    assert `true: ${t}` == "true: true";
    assert `false: ${f}` == "false: false";
}

test "char interpolation" {
    let a = 'A';
    let z = 'Z';
    assert `char A: ${a}` == "char A: A";
    assert `char Z: ${z}` == "char Z: Z";
}

test "an empty template is the empty string" {
    assert `` == "";
}

test "f64 interpolation" {
    let pi = 3.14159;
    let neg = 0.0 - 2.5;
    assert `pi: ${pi}` == "pi: 3.14159";
    assert `negative: ${neg}` == "negative: -2.5";
}

test "i32 interpolation" {
    let pos = 42;
    let neg = 0 - 17;
    let zero = 0;
    assert `positive: ${pos}` == "positive: 42";
    assert `negative: ${neg}` == "negative: -17";
    assert `zero: ${zero}` == "zero: 0";
}

test "i64 interpolation" {
    let pos: i64 = 12345 as i64;
    // Built through multiplication so the literal is not truncated.
    let big: i64 = 100000 as i64 * 1000000 as i64;
    let neg: i64 = 0 as i64 - 9876 as i64;
    assert `positive: ${pos}` == "positive: 12345";
    assert `big: ${big}` == "big: 100000000000";
    assert `negative: ${neg}` == "negative: -9876";
}

test "a template spans lines" {
    let simple = `Line 1
Line 2
Line 3`;
    assert simple == "Line 1\nLine 2\nLine 3";

    let name = "Alice";
    let greeting = `Dear ${name},

Welcome to Wado!

Best regards`;
    assert greeting == "Dear Alice,\n\nWelcome to Wado!\n\nBest regards";

    let a = 1;
    let b = 2;
    let result = `First: ${a}
Second: ${b}
Sum: ${a + b}`;
    assert result == "First: 1\nSecond: 2\nSum: 3";
}

test "segment layouts around the interpolations" {
    let s1 = "X";
    let s2 = "Y";
    let s3 = "Z";
    assert `${s1} a ${s2} c ${s3}` == "X a Y c Z";
    assert `a ${s1} b ${s2}` == "a X b Y";
    assert `${s1} a ${s2} c` == "X a Y c";
    assert `a ${s1} b ${s2} c` == "a X b Y c";
}

test "an interpolation holds an if or match expression, nested" {
    let n = 7;
    assert `status: ${if n % 2 == 0 { `${n} is even` } else { `${n} is odd` }}`
        == "status: 7 is odd";
    assert `${match n { 0 => `zero`, _ => `nonzero (${n})` }}` == "nonzero (7)";
    let inner = 1;
    assert `${if n > 0 { `inner=${if inner == 1 { `one` } else { `other` }}` } else { `none` }}`
        == "inner=one";
}

// `\`` is a template-specific escape — the delimiter itself. The lexer
// accepted it, but the unescaper had no arm for it and the reify path turned
// that error into an empty string, so every literal segment of the template
// silently vanished.

test "an escaped backtick keeps the surrounding literal text" {
    let name = "Fly";
    assert `has no member \`${name}\`` == "has no member `Fly`";
}

test "an escaped backtick with no interpolation" {
    assert `a \`b\` c` == "a `b` c";
}

test "an escaped backtick beside the other template escapes" {
    let v = 1;
    assert `\`\$\{${v}\}\`` == "`${1}`";
}

// A `:` inside parentheses/brackets within an interpolation belongs to the
// expression, not to the `${expr:spec}` format specifier. The specifier split
// once tracked only brace depth, so the `:` in `|p: i32|` was read as a
// specifier and the expression was truncated mid-call.

test "a colon inside a closure parameter is not a format specifier" {
    let xs: List<i32> = [1, 2, 3];
    assert `any big? ${xs.iter_value().any(|p: i32| p > 2)}` == "any big? true";
}

test "a specifier still applies after a closure-bearing expression" {
    let nums: List<i32> = [255];
    assert `hex=${nums.iter_value().fold(0, |acc: i32, x: i32| acc + x):x}` == "hex=ff";
}

test "a bracket inside a char literal does not unbalance the nesting count" {
    assert `n=${pick(7, '('):02}` == "n=07";
}

// Inside a generic impl, monomorphization picks the concrete type's Display for
// `${value}`, while `${value:?}` always renders the inspect form.

test "display and inspect of an integer type parameter" {
    let b = Wrapper { value: 42 };
    assert b.display_value() == "42";
    assert b.inspect_value() == "42";
    assert Wrapper { value: 99 }.both() == "display=99 inspect=99";
}

test "display and inspect of a string type parameter" {
    let b = Wrapper { value: "hello" };
    assert b.display_value() == "hello";
    assert b.inspect_value() == `"hello"`;
    assert Wrapper { value: "world" }.both() == `display=world inspect="world"`;
}

test "display and inspect of a bool type parameter" {
    let b = Wrapper { value: true };
    assert b.display_value() == "true";
    assert b.inspect_value() == "true";
}

// An interpolation parses a full expression, so call-site turbofish is allowed
// inside it — and its `::` must not be mistaken for the specifier's `:`.

test "free function turbofish in an interpolation" {
    assert `${identity::<i32>(42)}` == "42";
    assert `${identity::<String>("hi")}` == "hi";
}

test "turbofish followed by a format specifier" {
    assert `${identity::<i32>(255):x}` == "ff";
    assert `${identity::<i32>(7):03}` == "007";
}

test "turbofish on a generic constructor, then a field access" {
    assert `${make_wrapper::<i32>(1).value}` == "1";
    assert `${make_wrapper::<String>("a").value}` == "a";
}

test "a template built in a loop keeps each iteration's value" {
    // Stored as `Option::Some(s)` and pushed, every element once pointed at
    // the last iteration's string.
    let mut cases: List<Case> = [];
    let base = "Expr";
    let labels: List<String> = ["BinOp", "Pass"];
    for let mut i = 0; i < labels.len(); i += 1 {
        let s = `${base}${labels[i]}`;
        cases.push(Case { payload: Option::<String>::Some(s) });
    }
    assert cases[0].payload.unwrap() == "ExprBinOp";
    assert cases[1].payload.unwrap() == "ExprPass";
}
