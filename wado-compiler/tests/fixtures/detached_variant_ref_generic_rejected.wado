// A place whose type is a type parameter may be a `variant` once the function
// is instantiated, and a `&mut` of one held by a variable would drop its write
// in silence. The generic body is refused as written: holding a `&mut T` needs
// `T: RefMut`.

variant Payload {
    Text(String),
    Empty,
}

struct Bag<T> {
    item: T,
}

fn store_and_write<T>(b: &mut Bag<T>, v: T) {
    let r = &mut b.item;
    *r = v;
}

test "unreachable" {
    let mut b: Bag<Payload> = Bag { item: Payload::Empty };
    store_and_write(&mut b, Payload::Text(`xyz`));
}

__DATA__
{
    "test": {},
    "compile_error": "a variable cannot hold a `&mut T`: a `&mut` of a type that is not `RefMut` lasts only for a call, a pattern's arm or a loop's turn; bound `T: RefMut`, or hold a `Shared<T>` instead"
}
