// Future read/write with float payloads (f32 and f64).
// Regression: future-write codegen previously rejected floats (only int/bool/char).

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let [rx32, tx32] = Future::<f32>::new();
    tx32.write(3.5);
    if let Some(v) = rx32.read() {
        println(`{v}`);
    }

    let [rx64, tx64] = Future::<f64>::new();
    tx64.write(-7.25);
    if let Some(v) = rx64.read() {
        println(`{v}`);
    }
}

__DATA__
{"stdout": "3.5\n-7.25\n"}
