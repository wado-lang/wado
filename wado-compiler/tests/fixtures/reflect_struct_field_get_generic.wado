// StructField::get over a generic-instance field type (`List<i32>`) whose mangle
// contains `<` — the exact bridge-helper shape that once tripped
// LocalMethodName. This runs it at O0/O2, not just compiles it, guarding the
// value bridge for `<`-carrying field types.

struct Bag {
    items: List<i32>,
    label: String,
}

test "members() get() reads a generic-instance field value at runtime" {
    let b = Bag { items: [1, 2, 3], label: "hi" };
    let mut out = "";
    for let f of ReflectStruct::<Bag>::members() {
        out = `${out}${f.name()}=${f.get(&b):?};`;
    }
    assert out == `items=[1, 2, 3];label="hi";`;
}

