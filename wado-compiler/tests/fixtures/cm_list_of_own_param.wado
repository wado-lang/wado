// `list<own<t>>` as an import parameter: the element is the resource's own
// handle, not an `own` of that handle.

#[cm("wasi:demo/gfx@0.1.0#device")]
resource Device {
    #[cm("wasi:demo/gfx@0.1.0#[method]device.id")]
    #[cm_params("self")]
    fn id(&self) -> u32;
}

interface Gfx {
    #[cm("wasi:demo/gfx@0.1.0#get-device")]
    fn get_device() -> Device;
    #[cm("wasi:demo/gfx@0.1.0#pick")]
    #[cm_params("ds")]
    fn pick(ds: List<Device>) -> u32;
}

export fn run() with (Gfx, Device) {
    let _ = Gfx::pick([Gfx::get_device(), Gfx::get_device()]);
}

__DATA__
{
  "compile_only": true,
  "wat_lines": [
    { "contains": ["(own "], "count": 1 },
    { "contains": ["(own 0)"], "count": 1 },
    { "contains": ["(list 1)"], "count": 1 }
  ]
}
