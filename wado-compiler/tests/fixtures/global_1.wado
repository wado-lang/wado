use { println, Stdout } from "core:cli";

global ANSWER: i32 = 42;
global PI: f64 = 3.14159;
global FLAG: bool = true;

global LETTER: char = 'A';
global NEWLINE: char = '\n';
global mut CURRENT: char = 'x';

global DOUBLED_CONST: i32 = 21 * 2;
global OFFSET: i32 = 100 + 23;
global NEGATIVE: i32 = -42;
global NEG_DOUBLED: i32 = -DOUBLED_CONST;

global mut counter: i32 = 0;

fn test_basic() with Stdout {
    println(`ANSWER={ANSWER}`);
    println(`PI={PI}`);
    println(`FLAG={FLAG}`);
}

fn test_char() with Stdout {
    println(`LETTER={LETTER}`);
    println(`NEWLINE code={NEWLINE as i32}`);
    println(`CURRENT={CURRENT}`);
    CURRENT = 'Z';
    println(`CURRENT after={CURRENT}`);
}

fn test_const_expr() with Stdout {
    println(`DOUBLED={DOUBLED_CONST}`);
    println(`OFFSET={OFFSET}`);
    println(`NEGATIVE={NEGATIVE}`);
    println(`NEG_DOUBLED={NEG_DOUBLED}`);
}

fn test_mutable() with Stdout {
    println(`counter={counter}`);
    counter = counter + 1;
    println(`counter={counter}`);
    counter = counter + 10;
    println(`counter={counter}`);
}

fn test_negative() with Stdout {
    println(`POW10_MIN={POW10_MIN}`);
    println(`NEGATIVE_ONE={NEGATIVE_ONE_I64}`);
    println(`I64_MIN={I64_MIN}`);
}

global POW10_MIN: i32 = -348;
global NEGATIVE_ONE_I64: i64 = -1;
global I64_MIN: i64 = -9223372036854775808;

export fn run() with Stdout {
    test_basic();
    test_char();
    test_const_expr();
    test_mutable();
    test_negative();
}

__DATA__
{"stdout": "ANSWER=42\nPI=3.14159\nFLAG=true\nLETTER=A\nNEWLINE code=10\nCURRENT=x\nCURRENT after=Z\nDOUBLED=42\nOFFSET=123\nNEGATIVE=-42\nNEG_DOUBLED=-42\ncounter=0\ncounter=1\ncounter=11\nPOW10_MIN=-348\nNEGATIVE_ONE=-1\nI64_MIN=-9223372036854775808\n"}
