// Under a `&mut` scrutinee a scalar payload cannot bind even to be read, and
// the report says nothing of an assignment, since there is none.

fn read(o: &mut Option<i32>) -> i32 {
    if let Some(x) = o {
        return *x;
    }
    return 0;
}

export fn run() {
    let mut o: Option<i32> = Some(3);
    read(&mut o);
}

