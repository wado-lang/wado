// Test: Match on Option with only None should report missing Some
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let opt: Option<i32> = Option::Some(42);
    let val = match opt {
        None => 0,
    };
    println(`${val}`);
}

__DATA__
{"compile_error": "missing case `Some`"}
