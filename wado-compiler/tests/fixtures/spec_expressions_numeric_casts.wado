// Numeric casts follow Rust's `as`: one operation per pair of types.

test "each pair of types gets one operation" {
    let n: i32 = -1;
    assert n as u32 == u32::MAX;           // transmute
    assert 300 as u16 as u8 == 44;         // truncate
    assert (200 as u8) as i32 == 200;      // zero-extend
    assert n as i64 == -1;                 // sign-extend
    assert -3.9 as i32 == -3;              // round toward zero
    assert 1.0e10 as i32 == i32::MAX;      // saturate
    assert f64::NAN as u8 == 0;
    assert 16_777_217 as f32 == 16_777_216.0;   // round to nearest
    let big: f64 = 1.0e300;
    assert big as f32 == f32::INFINITY;    // round to nearest
    assert 0.1 as f16 as f32 == 0.0999755859375;
}

test "a cast value reinterprets a bit pattern" {
    assert (0xFF as u8) as i8 == -1;
}

test "a bool casts to an integer" {
    assert true as i32 == 1 && false as u8 == 0;
}

test "half precision casts as any float does" {
    let h = 1.5 as f16;
    assert h as i32 == 1 && h as f64 == 1.5;
    assert h as bf16 as f32 == 1.5;
    assert 65504 as f16 as f32 == 65504.0;
    let past_max: i32 = 70000;
    assert past_max as f16 as f32 == f32::INFINITY;
    assert (-2.5 as bf16) as i8 == -2;
    // One past bf16's midpoint between 2^60 and 2^60 + 2^53 rounds up: the
    // integer is rounded once, never through a wider float first.
    let wide: i64 = 0x1010_0000_0000_0001;
    assert wide as bf16 as f64 == 1161928703861587968.0;
    assert (f32::NAN as f16).is_nan();
}

test "wide integers take the same rules" {
    let a: i128 = -1;
    assert a as u8 == 255 && a as u128 == u128::MAX;
    assert 1.5 as f16 as i128 == 1;
    assert u128::MAX as f16 as f32 == f32::INFINITY;
}
