// Error: mutating an element yielded by reference iteration. `&mut List<T>`
// iterates as `&T` (Wasm GC cannot yield `&mut T` for array elements), so a
// `&mut self` method on the element would mutate a copy. Use indexed access
// for in-place mutation.

export fn run() {
    let mut items: List<String> = [String::from("a")];
    for let s of &mut items {
        s.push_str(&"!");
    }
}

