// The host may hand back a type no arm names, so a narrowing match ends in `_`.
use { Element, HtmlInputElement, Node } from "wado-lang:web";

fn kind(n: Node) -> i32 {
    return match n {
        input: HtmlInputElement => 1,
        el: Element => 2,
    };
}

export fn run() {}

