// Test: the BLOCKED await path for both stream directions.
// With async stream canonicals, `stream.read` on a request body that has not
// arrived and `stream.write` on a response body the host is not yet draining
// both return BLOCKED and go through `core:rt`'s `cm_await_blocked`. Reading
// the body one byte at a time forces repeated awaits on the read side, and
// writing it back one byte at a time forces them on the write side.
use { Request, Response, ErrorCode, Fields, Trailers } from "wasi:http";

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    let [res_future, _res_tx] = Future::<Result<(), ErrorCode>>::new();
    let [body_stream, _trailers] = Request::consume_body(request, res_future);

    let mut body: List<u8> = [];
    loop {
        let chunk = body_stream.read(1);
        if chunk.len() == 0 {
            break;
        }
        for let byte of chunk {
            body.push(byte);
        }
    }
    body_stream.drop();

    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [resp_rx, resp_tx] = Stream::<u8>::new();
    let headers = Fields::new();
    let [response, _tx_future] = Response::new(headers, Option::<Stream<u8>>::Some(resp_rx), trailers_future);

    task return Result::<Response, ErrorCode>::Ok(response);

    for let byte of body {
        let one: List<u8> = [byte];
        resp_tx.write(one);
    }
    resp_tx.drop();
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

__DATA__
{
    "wasi:http/service": {
        "request": {
            "method": "POST",
            "path": "/",
            "body": "await-blocked round trip"
        },
        "status": 200,
        "body": "await-blocked round trip"
    }
}
