// TreeMap literal: string values
use { println, Stdout } from "core:cli";
use { TreeMap } from "core:collections";

export fn run() with Stdout {
    let colors: TreeMap<String, String> = {
        red: "#FF0000",
        green: "#00FF00",
        blue: "#0000FF",
    };

    assert colors.len() == 3;

    assert colors["red"] == "#FF0000";
    assert colors["green"] == "#00FF00";
    assert colors["blue"] == "#0000FF";

    println("string values: ok");
}

__DATA__
{"stdout": "string values: ok\n"}
