// Test that constant folding compares f32 values in f32 precision,
// not f64. Previously, the optimizer compared the f64 storage values
// of f32 constants, causing false negatives when one operand had been
// through f32 arithmetic and the other was a fresh f64-parsed literal.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // f32::PI * 2.0 should equal f32::TAU
    assert f32::TAU == f32::PI * 2.0;
    assert f32::FRAC_PI_2 == f32::PI / 2.0;
    assert f32::FRAC_PI_4 == f32::PI / 4.0;

    // f32 variable arithmetic comparison
    let x: f32 = 3.14;
    let y: f32 = x * 2.0;
    let z: f32 = 6.28;
    assert y == z;

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
