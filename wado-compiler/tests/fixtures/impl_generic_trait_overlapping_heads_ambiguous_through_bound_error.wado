// A bound reaching two tied heads of a generic trait reports them under the
// bound's arguments.

struct Pair<A, B> {
    a: A,
    b: B,
}

trait Name<N> with () {
    fn name(&self) -> String;
}

impl<T> Name<T> for Pair<T, i32> {
    fn name(&self) -> String {
        return "pinned";
    }
}

impl<A, B> Name<A> for Pair<A, B> {
    fn name(&self) -> String {
        return "open";
    }
}

fn via<T: Name<String>>(x: T) -> String {
    return x.name();
}

export fn run() {
    let p: Pair<String, i32> = Pair { a: "x", b: 2 };
    let _ = via(p);
}

