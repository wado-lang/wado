// `resume value` semantics inside a handler method body.
//
// Each call to `Counter::next()` increments a counter that lives in a
// global mut and resumes with the new value. Verifies:
// - resume with a non-unit value (`i32`)
// - multiple resume sites in a single handler invocation chain
// - user-defined effect operation calls land on the synthesised
//   `MethodCall` that the dispatch lowering generates
//
// The handler is `&self` and the counter state lives in a global
// rather than `&mut self` because of a pre-existing optimizer issue
// (see `effect_handler_mut_self_alias.wado`) that affects calling
// `&mut self` methods on a `&mut local` followed by direct field
// access on the local. Once that lands, the fixture can switch to
// `&mut self` + struct-owned state.

use { println, Stdout } from "core:cli";

effect Counter {
    fn next() -> i32;
}

global mut counter_state: i32 = 0;

struct CounterHandler {}

impl Counter for CounterHandler {
    fn next(&self) -> i32 {
        counter_state = counter_state + 1;
        resume counter_state
    }
}

export fn run() with Stdout {
    let h = CounterHandler {};
    with Counter = &h do {
        let a = Counter::next();
        let b = Counter::next();
        println(`{a}+{b}`);
    }
}

__DATA__
{"stdout_contains": ["1+2"]}
