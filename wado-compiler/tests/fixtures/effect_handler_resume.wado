// `resume value` semantics inside a handler method body, in the WEP
// example shape: `&mut self` over struct-owned counter state. Each
// call to `Counter::next()` increments the handler's `value` field
// and resumes with the new value. After the `do` block, the caller
// reads `c.value` to confirm the mutation persisted.
//
// Verifies:
// - resume with a non-unit value (`i32`)
// - mutable handler state via `&mut self`
// - multiple resume sites in a single handler invocation chain
// - field access on the handled local survives the `&mut` aliasing in
//   the surrounding `with` clause (regression covered by
//   `effect_handler_mut_self_alias.wado`)

use { println, Stdout } from "core:cli";

effect Counter {
    fn next() -> i32;
}

struct CounterState {
    value: i32,
}

impl Counter for CounterState {
    fn next(&mut self) -> i32 {
        self.value += 1;
        resume self.value
    }
}

export fn run() with Stdout {
    let mut c = CounterState { value: 0 };
    with Counter = &mut c do {
        let a = Counter::next();
        let b = Counter::next();
        println(`{a}+{b}={a + b}, final={c.value}`);
    }
}

__DATA__
{"stdout_contains": ["1+2=3, final=2"]}
