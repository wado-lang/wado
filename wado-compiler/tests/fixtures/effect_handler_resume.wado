#![TODO]
// `resume value` semantics inside an effect handler method.
//
// Currently blocked by a pre-existing optimizer/inliner issue when a
// `MethodCall` synthesised by the effect-dispatch lowering inlines an
// `&self` impl method into a context that does not have the inlined
// frame's `__local_N` aliases set up. Tracked as Phase 4 work in the
// effect-handler WEP. When the inliner is fixed, drop `#![TODO]` and
// the existing assertions will catch it.

use { println, Stdout } from "core:cli";

effect Counter {
    fn next() -> i32;
}

global mut counter_state: i32 = 0;

struct CounterHandler {}

impl Counter for CounterHandler {
    fn next(&self) -> i32 {
        counter_state = counter_state + 1;
        resume counter_state
    }
}

export fn run() with Stdout {
    let h = CounterHandler {};
    with Counter = &h do {
        let a = Counter::next();
        let b = Counter::next();
        println(`{a}+{b}`);
    }
}

__DATA__
{"stdout_contains": ["1+2"]}
