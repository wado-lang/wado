// The stream copy canonicals must carry the `async` option.
//
// Without it the canonical never hands BLOCKED back to the guest, so the
// BLOCKED branch of the prelude's `settled_copy`, which every stream read and
// write settles through, is unreachable code shipped in every component. A run
// passes either way, since the host blocks instead: the option is only
// observable in the emitted component. The program reads and writes a stream,
// so both copy canonicals survive DCE.
//
// See `docs/wep-2026-07-25-async-stream-canonical.md`.
use { println, Stdout } from "core:cli";
use { Stdin } from "wasi:cli";

export fn run() with (Stdout, Stdin) {
    let [stdin_stream, _done] = Stdin::read_via_stream();
    let [stdin_stream, chunk] = stdin_stream.start_read(16).finish();
    stdin_stream.drop();
    println(`read ${chunk.items.len()} bytes`);
}

__DATA__
{
    "stdin": "hello",
    "stdout": "read 5 bytes\n",
    "wat_lines": [
        {"contains": ["canon stream.read "]},
        {"contains": ["canon stream.read "], "not_contains": [" async"], "count": 0},
        {"contains": ["canon stream.write "]},
        {"contains": ["canon stream.write "], "not_contains": [" async"], "count": 0}
    ]
}
