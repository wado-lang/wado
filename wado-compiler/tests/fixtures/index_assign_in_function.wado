// Index assignment in non-run functions
use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let mut arr: Array<i32> = [0, 0, 0];
    fill_array(&mut arr);
    println(`{arr[0]} {arr[1]} {arr[2]}`);

    let result = create_and_fill();
    println(`{result[0]} {result[1]}`);
}

fn fill_array(arr: &mut Array<i32>) {
    arr[0] = 100;
    arr[1] = 200;
    arr[2] = 300;
}

fn create_and_fill() -> Array<i32> {
    let mut arr: Array<i32> = [0, 0];
    arr[0] = 42;
    arr[1] = 84;
    return arr;
}

__DATA__
{"stdout": "100 200 300\n42 84\n"}
