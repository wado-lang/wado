// Several unsolved slots of one call name themselves in a single message.
// Instantiating each slot separately made each raise its own, so a two-
// parameter method reported the same call twice.

struct P {}

impl P {
    fn gen<T, U>(&self) -> i32 {
        return 0;
    }
}

export fn run() {
    let p = P {};
    assert p.gen() == 0;
}

