// Test i32 edge cases: min/max values and negative numbers
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Max value: 2147483647
    let max = 2147483647;
    println(`max: {max}`);

    // Min value: -2147483648
    let min = -2147483648;
    println(`min: {min}`);

    // Negative arithmetic
    let neg = -50000000;
    let pos = 30000000;
    let sum = neg + pos;
    println(`neg + pos: {sum}`);

    // Negative division
    let div_result = -1000 / 7;
    println(`-1000 / 7: {div_result}`);

    // Negative modulo
    let mod_result = -1000 % 7;
    println(`-1000 % 7: {mod_result}`);
}

__DATA__
{"stdout": "max: 2147483647\nmin: -2147483648\nneg + pos: -20000000\n-1000 / 7: -142\n-1000 % 7: -6\n"}
