// Test match expression with u64 literal patterns

use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let x: u64 = 42 as u64;
    let y: u64 = 0 as u64;
    let large: u64 = 10000000000000 as u64;

    let r1 = match x {
        0 => "zero",
        42 => "answer",
        _ => "other",
    };


    println(r1);

    let r2 = match y {
        0 => "zero",
        _ => "other",
    };


    println(r2);

    let r3 = match large {
        0 => "zero",
        10000000000000 => "ten trillion",
        _ => "other",
    };


    println(r3);
}

__DATA__
{"stdout": "answer\nzero\nten trillion\n"}
