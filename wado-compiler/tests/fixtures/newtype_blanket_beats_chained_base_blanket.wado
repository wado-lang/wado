// A blanket the newtype reaches only through a *chain* ranks as its base's:
// `Wrapped` carries `impl Limit for Wrapped`, while `Derived` reaches it only
// via `impl<T: Base> Derived for T` over `Inner: Base`. Rank 1 asks every step
// of a derivation at the level being ranked (WEP 2026-09-01, issue #1932).

trait Base {
    fn base() -> i32;
}

trait Derived {
    fn derived() -> i32;
}

impl<T: Base> Derived for T {
    fn derived() -> i32 {
        return T::base() + 1;
    }
}

trait Limit {
    fn limit() -> i32;
}

trait Describe {
    fn describe(&self) -> String;
}

impl<T: Derived> Describe for T {
    fn describe(&self) -> String {
        return `derived:${T::derived()}`;
    }
}

impl<T: Limit> Describe for T {
    fn describe(&self) -> String {
        return `limit:${T::limit()}`;
    }
}

struct Inner {
    x: i32,
}

impl Base for Inner {
    fn base() -> i32 {
        return 10;
    }
}

type Wrapped = Inner;

impl Limit for Wrapped {
    fn limit() -> i32 {
        return 3;
    }
}

test "the newtype takes the blanket its own bound keys" {
    let w = Inner { x: 1 } as Wrapped;
    assert w.describe() == "limit:3";
}

test "the base takes the chained blanket" {
    let i = Inner { x: 1 };
    assert i.describe() == "derived:11";
}

__DATA__
{"test": {}}
