use { println, Stdout } from "core:cli";

variant Src {
    Payload(i32),
    Empty,
}

variant Dst {
    Text(String),
    Empty,
}

export fn run() with Stdout {
    let n = 1;
    let src = Src::Payload(n);
    let dst = src as Dst;
    if let Dst::Text(s) = dst {
        println(`${s}`);
    }
}

