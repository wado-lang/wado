// Test core:base64 encode functions
use { println } from "core:cli";
use { encode, encode_url, encode_with, Encoding } from "core:base64";

export fn run() with Stdout {
    // RFC 4648 test vectors
    let empty: Array<u8> = [];
    assert encode(&empty) == "";

    assert encode(&"f".bytes().collect()) == "Zg==";
    assert encode(&"fo".bytes().collect()) == "Zm8=";
    assert encode(&"foo".bytes().collect()) == "Zm9v";
    assert encode(&"foob".bytes().collect()) == "Zm9vYg==";
    assert encode(&"fooba".bytes().collect()) == "Zm9vYmE=";
    assert encode(&"foobar".bytes().collect()) == "Zm9vYmFy";

    // encode_url: no padding
    assert encode_url(&"Hello".bytes().collect()) == "SGVsbG8";

    // encode_with: NoPadding
    assert encode_with(&"Hello".bytes().collect(), Encoding::NoPadding) == "SGVsbG8";

    // encode_with: default (standard padded)
    assert encode_with(&"Hello".bytes().collect(), Encoding::none()) == "SGVsbG8=";

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
