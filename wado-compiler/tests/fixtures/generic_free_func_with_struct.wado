// Test generic free functions with generic structs
use { println, Stdout } from "core:cli";

struct Box<T> {
    value: T,
}

impl<T> Box<T> {
    pub fn new(value: T) -> Box<T> {
        return Box { value };
    }

    pub fn get(&self) -> T {
        return self.value;
    }
}

// Generic function that creates a Box
fn make_box<T>(value: T) -> Box<T> {
    return Box::<T>::new(value);
}

// Generic function that unwraps a Box
fn unwrap_box<T>(b: Box<T>) -> T {
    return b.get();
}

// Generic function that takes and returns Box
fn transform_box<T>(b: Box<T>) -> Box<T> {
    let v = b.get();
    return Box::<T>::new(v);
}

export fn run() with Stdout {
    // Create box via generic function
    let b1 = make_box::<i32>(42);
    println(`make_box: {b1.get()}`);

    // Unwrap box via generic function
    let v = unwrap_box::<i32>(b1);
    println(`unwrap_box: {v}`);

    // Transform box
    let b2 = make_box::<i64>(100 as i64);
    let b3 = transform_box::<i64>(b2);
    println(`transform_box: {b3.get()}`);
}

__DATA__
{"stdout": "make_box: 42\nunwrap_box: 42\ntransform_box: 100\n"}
