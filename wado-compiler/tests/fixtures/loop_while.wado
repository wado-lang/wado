// `while`, `while let`, and the infinite `loop`, with `break` / `continue` and
// nesting across all three forms.

test "while break" {
    let mut count = 0;
    while count < 10 {
        count = count + 1;
        if count >= 3 {
            break;
        }
    }
    assert count == 3;
}

test "while continue" {
    let mut sum = 0;
    let mut count = 0;
    while count < 5 {
        count = count + 1;
        if count == 3 {
            continue;
        }
        sum += count;
    }
    assert sum == 1 + 2 + 4 + 5;
}

test "while let" {
    let items: List<i32> = [1, 2, 3];
    let mut iter = items.iter_value();
    let mut sum = 0;
    while let Some(x) = iter.next() {
        sum += x;
    }
    assert sum == 6;
}

test "while let with a guard exits when the guard fails" {
    let arr: List<i32> = [1, 2, 3, 8, 9];
    let mut iter = arr.iter_value();
    let mut sum = 0;
    while let Some(x) = iter.next() && x < 5 {
        sum += x;
    }
    assert sum == 6;
}

test "chained while let consumes two iterators in lockstep" {
    let xs: List<i32> = [1, 2, 3];
    let ys: List<i32> = [10, 20, 30];
    let mut ix = xs.iter_value();
    let mut iy = ys.iter_value();
    let mut total = 0;
    while let Some(x) = ix.next() && let Some(y) = iy.next() {
        total += x + y;
    }
    assert total == 66;
}

test "while let with a parenthesised guard" {
    let arr: List<i32> = [2, 4, 7, 8];
    let mut iter = arr.iter_value();
    let min = 1;
    let max = 6;
    let mut count = 0;
    while let Some(v) = iter.next() && (v > min && v < max) {
        count += 1;
    }
    assert count == 2;
}

test "loop breaks" {
    let mut seen: List<i32> = [];
    let mut count = 0;
    loop {
        seen.push(count);
        count = count + 1;
        if count >= 3 {
            break;
        }
    }
    assert seen == [0, 1, 2];
}

test "loop continues" {
    let mut seen: List<i32> = [];
    let mut count = 0;
    loop {
        count = count + 1;
        if count >= 5 {
            break;
        }
        if count == 2 {
            continue;
        }
        seen.push(count);
    }
    assert seen == [1, 3, 4];
}

test "nested loop inside loop" {
    let mut seen: List<String> = [];
    let mut outer = 0;
    loop {
        outer = outer + 1;
        let mut inner = 0;
        loop {
            inner = inner + 1;
            seen.push(`outer:${outer} inner:${inner}`);
            if inner >= 2 {
                break;
            }
        }
        if outer >= 2 {
            break;
        }
    }
    assert seen
        == [
            "outer:1 inner:1",
            "outer:1 inner:2",
            "outer:2 inner:1",
            "outer:2 inner:2",
        ];
}

test "for, while and loop nested four deep" {
    let mut seen: List<String> = [];
    for let mut i = 0; i < 2; i = i + 1 {
        let mut j = 0;
        while j < 2 {
            j = j + 1;
            let mut k = 0;
            loop {
                k = k + 1;
                for let mut l = 0; l < 2; l = l + 1 {
                    seen.push(`${i}-${j}-${k}-${l}`);
                }
                if k >= 2 {
                    break;
                }
            }
        }
    }
    assert seen.len() == 16;
    assert seen[0] == "0-1-1-0";
    assert seen[7] == "0-2-2-1";
    assert seen[15] == "1-2-2-1";
}

test "continue in a for nested in a while nested in a loop" {
    let mut seen: List<String> = [];
    let mut a = 0;
    loop {
        a = a + 1;
        let mut b = 0;
        while b < 2 {
            b = b + 1;
            for let mut c = 0; c < 2; c = c + 1 {
                seen.push(`a:${a} b:${b} c:${c}`);
                if c == 0 {
                    continue;
                }
            }
            if b == 1 {
                continue;
            }
        }
        if a >= 2 {
            break;
        }
    }
    assert seen.len() == 8;
    assert seen[0] == "a:1 b:1 c:0";
    assert seen[7] == "a:2 b:2 c:1";
}
