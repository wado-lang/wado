// Test StrCharIter - iterates over Unicode scalar values of a String
// Tests all UTF-8 encoding branches: 1-byte, 2-byte, 3-byte, and 4-byte
use { println, Stdout } from "core:cli";

fn run() with Stdout {
    // Test 1-byte ASCII characters (U+0000 to U+007F)
    let ascii_chars: Array<char> = "ABC".chars().collect();
    assert ascii_chars.len() == 3;
    assert ascii_chars[0] == 'A';
    assert ascii_chars[1] == 'B';
    assert ascii_chars[2] == 'C';

    // Test 2-byte UTF-8 characters (U+0080 to U+07FF)
    // "ñé" - ñ is U+00F1, é is U+00E9
    let two_chars: Array<char> = "ñé".chars().collect();
    assert two_chars.len() == 2;
    assert two_chars[0] as i32 == 0x00F1;  // ñ
    assert two_chars[1] as i32 == 0x00E9;  // é

    // Test 3-byte UTF-8 characters (U+0800 to U+FFFF)
    // "日本" - 日 is U+65E5, 本 is U+672C
    let three_chars: Array<char> = "日本".chars().collect();
    assert three_chars.len() == 2;
    assert three_chars[0] as i32 == 0x65E5;  // 日
    assert three_chars[1] as i32 == 0x672C;  // 本

    // Test 4-byte UTF-8 characters (U+10000 to U+10FFFF)
    // Emoji: 😀 is U+1F600
    let four_chars: Array<char> = "😀".chars().collect();
    assert four_chars.len() == 1;
    assert four_chars[0] as i32 == 0x1F600;  // 😀

    // Test empty string
    assert "".chars().count() == 0;

    // Test mixed encoding - all branches in one string
    // "Aéï日😀" - A(1), é(2), ï(2), 日(3), 😀(4)
    let mixed_chars: Array<char> = "Aéï日😀".chars().collect();
    assert mixed_chars.len() == 5;
    assert mixed_chars[0] == 'A';              // 1-byte
    assert mixed_chars[1] as i32 == 0x00E9;    // 2-byte: é
    assert mixed_chars[2] as i32 == 0x00EF;    // 2-byte: ï
    assert mixed_chars[3] as i32 == 0x65E5;    // 3-byte: 日
    assert mixed_chars[4] as i32 == 0x1F600;   // 4-byte: 😀

    println("chars iter tests passed");
}

__DATA__
{"stdout": "chars iter tests passed\n"}
