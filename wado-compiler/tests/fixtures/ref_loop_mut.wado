// Modify value through &mut reference inside a loop

use { println, Stdout } from "core:cli";

fn accumulate(target: &mut i32, n: i32) {
    for let mut i = 0; i < n; i += 1 {
        *target = *target + i;
    }
}

export fn run() with Stdout {
    let mut sum = 0;

    // Modify through reference in a loop
    accumulate(&mut sum, 5);
    println(`sum 0..4: {sum}`);

    // Use reference in while loop
    let mut count = 0;
    let r = &mut count;
    while *r < 5 {
        *r = *r + 1;
    }
    println(`count: {count}`);
}

__DATA__
{"stdout": "sum 0..4: 10\ncount: 5\n"}
