//! One trait implemented twice, one block writing the body and one leaving the
//! trait's default. The argument picks first and the written body breaks the
//! tie only among what the argument admits, so the block that inherits still
//! answers for its own: answering the default per impl instead let the first
//! block seen win, and `M::make("x")` ran the `Conv<i32>` default.

trait Conv<T> {
    fn make(v: T) -> i32 {
        return 9;
    }
}

struct M {}

impl Conv<i32> for M {}

impl Conv<String> for M {
    fn make(v: String) -> i32 {
        return 2;
    }
}

test "the written body outranks the inherited default" {
    assert M::make("x") == 2;
}

test "and the inherited default still answers its own argument" {
    assert M::make(5) == 9;
}
