// Test: iterate and access 3-level nested Array<Array<Array<i32>>>
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let deep: Array<Array<Array<i32>>> = [[[1, 2], [3]], [[4, 5, 6]]];

    // Access inner elements
    println(`{deep[0][0][1]}`);
    println(`{deep[1][0][2]}`);

    // Nested iteration
    let mut total = 0;
    for let plane of deep {
        for let row of plane {
            for let val of row {
                total += val;
            }
        }
    }
    println(`{total}`);

    println("ok");
}

__DATA__
{"stdout": "2\n6\n21\nok\n"}
