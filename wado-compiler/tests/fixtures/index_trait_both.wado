// Test: Both Index and IndexAssign traits for a custom type
use { println, Stdout } from "core:cli";

struct SimpleArray {
    a: i32,
    b: i32,
    c: i32,
}

impl SimpleArray {
    fn new() -> SimpleArray {
        return SimpleArray { a: 0, b: 0, c: 0 };
    }
}

impl Index<i32> for SimpleArray {
    type Output = i32;

    fn index(&self, _idx: i32) -> &Self::Output {
        // For simplicity, always return &self.a
        return &self.a;
    }
}

impl IndexAssign<i32> for SimpleArray {
    type Input = i32;

    fn index_assign(&mut self, _idx: i32, value: Self::Input) {
        // For simplicity, always set self.a
        self.a = value;
    }
}

export fn run() with Stdout {
    let mut arr = SimpleArray::new();

    // Write using [] assignment (all go to arr.a)
    arr[0] = 42;

    // Read using [] (reads arr.a)
    println(`arr[0] = {arr[0]}`);
}

__DATA__
{"stdout": "arr[0] = 42\n"}
