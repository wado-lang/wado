/// Regression test for continue/break inside for-of nested in C-style for loop.
/// The desugarer was incorrectly transforming `continue` into `break __for_N_body`,
/// breaking out of the outer loop body instead of continuing the inner for-of.

fn for_of_with_continue(data: &List<List<i32>>) -> List<i32> {
    let mut result: List<i32> = [];
    for let mut k = 0; k < data.len(); k += 1 {
        for let item of data[k] {
            if item % 2 == 0 {
                continue;
            }
            result.push(item);
        }
    }
    return result;
}

fn for_of_with_break(data: &List<List<i32>>) -> List<i32> {
    let mut result: List<i32> = [];
    for let mut k = 0; k < data.len(); k += 1 {
        for let item of data[k] {
            if item > 2 {
                break;
            }
            result.push(item);
        }
    }
    return result;
}

test "continue in for-of inside c-style for" {
    let data: List<List<i32>> = [[1, 2, 3], [4, 5, 6]];
    let result = for_of_with_continue(&data);
    // Odd numbers only: 1, 3, 5
    assert result.len() == 3, `expected 3, got {result.len()}`;
    assert result[0] == 1;
    assert result[1] == 3;
    assert result[2] == 5;
}

test "break in for-of inside c-style for" {
    let data: List<List<i32>> = [[1, 2, 3], [4, 5, 6]];
    let result = for_of_with_break(&data);
    // First inner: 1, 2 (break at 3). Second inner: empty (break at 4).
    assert result.len() == 2, `expected 2, got {result.len()}`;
    assert result[0] == 1;
    assert result[1] == 2;
}

test "continue with double-indexed access" {
    let data: List<List<i32>> = [[10, 20, 30], [40, 50, 60]];
    let indices: List<i32> = [0, 1];
    let mut result: List<i32> = [];
    for let mut k = 0; k < indices.len(); k += 1 {
        for let item of data[indices[k]] {
            if item % 20 == 0 {
                continue;
            }
            result.push(item);
        }
    }
    // Skip 20, 40, 60 → keep 10, 30, 50
    assert result.len() == 3, `expected 3, got {result.len()}`;
    assert result[0] == 10;
    assert result[1] == 30;
    assert result[2] == 50;
}

__DATA__
{"test": {}}
