// The bound a primitive satisfies must match what the operator lowers to. The
// list carried only the five arithmetic traits, so `T: BitAnd` and `T: BitNot`
// were rejected for `i32` while `a & b` on a concrete `i32` compiled.
use { println } from "core:cli";

fn mask<T: BitAnd<Output = T>>(a: T, b: T) -> T {
    return a & b;
}

fn flip<T: BitNot<Output = T>>(a: T) -> T {
    return ~a;
}

fn twice<T: Shl<Output = T>>(a: T) -> T {
    return a << 1;
}

export fn run() with Stdout {
    assert mask(12, 10) == 8;
    assert flip(12) == -13;
    assert twice(12) == 24;
    println(`${mask(12, 10)} ${flip(12)} ${twice(12)} ${mask(true, false)}`);
}

__DATA__
{"stdout": "8 -13 24 false\n"}
