// Range patterns with matches operator
test "matches with range" {
    let code = 65;
    assert code matches { 0..<128 };
    assert !(code matches { 128..=255 });
}

test "matches with char range" {
    let c = 'f';
    assert c matches { 'a'..='z' };
    assert !(c matches { 'A'..='Z' });
}

