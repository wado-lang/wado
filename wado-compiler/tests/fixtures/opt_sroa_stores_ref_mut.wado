// Negative test: &mut s still causes hard escape (read-back not yet implemented).
//
// Even though the callee doesn't declare stores, &mut allows modification
// during the call, and SROA doesn't yet support read-back from temporaries.
// This test ensures &mut s correctly blocks SROA.

struct Point {
    x: i32,
    y: i32,
}

#[inline("never")]
fn scale_point(p: &mut Point, factor: i32) {
    p.x = p.x * factor;
    p.y = p.y * factor;
}

// Case: &mut p — struct must NOT be SROA'd (read-back not implemented).
export fn run() {
    let mut p = Point { x: 5, y: 10 };
    scale_point(&mut p, 3);
    assert p.x == 15;
    assert p.y == 30;
}

__DATA__
{
    "stdout": "",
    "wir_expect:O2": ["Point\" { x: 5, y: 10 }"]
}
