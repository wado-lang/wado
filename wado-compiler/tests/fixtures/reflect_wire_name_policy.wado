// ReflectStruct wire-name policy (WEP 2026-06-13, Stage C): the struct's
// `#[wire(name_policy)]` declaration surfaced as a `CaseStyle` value.
// Casing itself is resolved library-side by `core:serde::wire_name`.

#[wire(name_policy = "camelCase")]
struct A {
    user_id: i32,
}

struct B {
    user_id: i32,
}

test "wire_name_policy reflects name_policy" {
    assert ReflectStruct::<A>::wire_name_policy() == CaseStyle::Camel;
    assert ReflectStruct::<B>::wire_name_policy() == CaseStyle::Identity;
}

__DATA__
{"test": {}}
