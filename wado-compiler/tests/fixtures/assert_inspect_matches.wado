// A `matches` condition is quoted on the `condition:` line. Its scrutinee is
// not captured yet — see the WEP's *Known gaps*.

variant Shape {
    Circle(f64),
    Rectangle([f64, f64]),
    Point,
}

export fn run() with Stdout {
    let s = Shape::Circle(3.0);
    assert s matches { Rectangle(_) };
}

__DATA__
{
    "trapped": true,
    "stderr_contains": ["condition: s matches { Rectangle(_) }"]
}
