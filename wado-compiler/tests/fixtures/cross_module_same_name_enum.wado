// Two modules define enum Direction with different cases.
// Each module's Direction type must remain distinct.

use { Direction, is_up } from "./sub/cross_module_same_name_enum_a.wado";
use { Direction as DirectionB, is_left } from "./sub/cross_module_same_name_enum_b.wado";

test "cross-module same-name enums" {
    let u = Direction::Up;
    assert is_up(u);

    let l = DirectionB::Left;
    assert is_left(l);
}

__DATA__
{"test": {}}
