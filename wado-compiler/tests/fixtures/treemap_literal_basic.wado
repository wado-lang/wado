// TreeMap literal: basic coercion from anonymous struct literal
use { println, Stdout } from "core:cli";
use { TreeMap } from "core:collections";

export fn run() with Stdout {
    let m: TreeMap<String, i32> = { width: 1920, height: 1080 };

    assert m.len() == 2;
    assert m.contains_key("width");
    assert m.contains_key("height");

    assert m["width"] == 1920;
    assert m["height"] == 1080;

    println("basic literal: ok");
}

__DATA__
{"stdout": "basic literal: ok\n"}
