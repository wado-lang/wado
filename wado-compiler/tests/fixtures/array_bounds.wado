use { println, Stdout } from "core:cli";


// from array_bounds_check.wado
fn array_bounds_check() with Stdout {
    let mut arr: List<i32> = [10, 20, 30];

    // Read in-bounds
    println(`{arr[0]}, {arr[1]}, {arr[2]}`);

    // Write in-bounds
    arr[1] = 99;
    println(`{arr[1]}`);
}

// from array_bounds_elim_redundant.wado
fn array_bounds_elim_redundant() with Stdout {
    let arr: List<i32> = [10, 20, 30];
    let mut sum = 0;
    for let mut i = 0; i < arr.len(); i += 1 {
        // Two accesses with same index — second check should be eliminated
        let a = arr[i];
        let b = arr[i];
        sum += a + b;
    }
    assert sum == 120;
    println(`{sum}`);
}

export fn run() with Stdout {
    array_bounds_check();
    array_bounds_elim_redundant();
}

__DATA__
{"stdout": "10, 20, 30\n99\n120\n"}
