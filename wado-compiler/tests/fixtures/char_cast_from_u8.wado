// Test u8 -> char cast (always valid, like Rust)
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // u8 as char is always valid (0..255 are valid Unicode scalar values)
    let byte: u8 = 65;
    let c = byte as char;
    assert c == 'A';

    // u8 max value (255) is also valid
    let max_byte: u8 = 255;
    let c2 = max_byte as char;
    assert c2 as i32 == 255;

    // Zero
    let zero: u8 = 0;
    let c3 = zero as char;
    assert c3 as i32 == 0;

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
