// An operation of a user-defined interface demands its interface, as a host
// one does: a function declaring nothing is pure, so it cannot dispatch one.
interface Counter {
    fn next() -> i32;
}

fn next_id() -> i32 {
    return Counter::next();
}

export fn run() {
    let _ = next_id();
}

