//! An unrelated error ahead of a field holding two type packs. The two-packs
//! check reads the declaration, not how many errors the module has so far, so
//! the field is still reported.
//! See docs/wep-2026-03-14-variadic-type-parameters.md §6.

struct Earlier {
    v: NoSuchType,
}

struct Joined<..A, ..B> {
    both: [..A, ..B],
}

test "an earlier error does not hide the field" {
    let j: Joined<[i32], [bool]> = Joined { both: [1, true] };
    assert j.both.0 == 1;
}

__DATA__
{
  "compile_error": "unknown type 'NoSuchType'",
  "compile_errors_contains": ["a field cannot hold two type packs in one tuple"]
}
