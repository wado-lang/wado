// Test: Client::send with a request body stream (POST).
//
// Exercises the AsyncCall<T>::wait pattern:
//   1. Build an outgoing Request whose `contents` is the readable end of
//      a stream.
//   2. Call `Client::send(req)` — returns `AsyncCall<Result<Response,
//      ErrorCode>>` with the host task already reading the body.
//   3. Write the body bytes and close the writable end.
//   4. `task.wait()` to block on the response.
//
// This is the client-side mirror of the `task return` + stream-write
// pattern used by HTTP server handlers (`example/http-bin.wado`).

use { Request, Response, ErrorCode, Fields, Scheme, Trailers, FieldName, FieldValue } from "wasi:http";
use { Client } from "wasi:http/client.wado";

export async fn handle(request: Request) -> Result<Response, ErrorCode>
    with Client
{
    let [body_rx, body_tx] = Stream::<u8>::new();
    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();

    let headers = Fields::new();
    let _ = headers.append(
        "content-type" as FieldName,
        "text/plain".as_bytes() as FieldValue,
    );

    let [out_req, _req_future] = Request::new(
        headers,
        Option::<Stream<u8>>::Some(body_rx),
        trailers_future,
        null,
    );

    out_req.set_scheme(Option::<Scheme>::Some(Scheme::Http));
    out_req.set_authority(Option::<String>::Some("localhost"));
    out_req.set_path_with_query(Option::<String>::Some("/upstream"));

    // Start the send as a subtask. The host begins consuming the body
    // stream immediately; the guest is free to continue executing.
    let subtask = Client::send(out_req);

    // Write the body concurrently with the host subtask's read. These
    // writes rendezvous with the host reader without deadlock because
    // the subtask is already in flight by the time we reach here.
    body_tx.write("request body".as_bytes());
    body_tx.drop();
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));

    // Block until the host has a full response.
    let result = subtask.wait();

    task return result;
}

__DATA__
{
    "wasi:http/service": {
        "status": 200,
        "body": "upstream received body"
    },
    "outgoing_mocks": {
        "/upstream": {
            "status": 200,
            "body": "upstream received body"
        }
    }
}
