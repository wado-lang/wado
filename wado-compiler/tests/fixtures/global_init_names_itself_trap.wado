// An initializer that names its own global on a path it may skip reads the
// global before it holds a value when the path is taken, and traps at every
// optimization level.

use { println, Stdout } from "core:cli";

global A: i32 = if builtin::black_box(true) { A + 1 } else { 0 };

export fn run() with Stdout {
    println(`${A}`);
}

__DATA__
{
    "trapped": true,
    "stdout": "",
    "stderr_contains": ["global `A` was read before its initializer ran"]
}
