// A handler method takes as many parameters as its operation, counting the
// handle of a resource's instance method and not the handler's own receiver.

interface Src {
    fn get(n: i32) -> i32;
}

struct H {}

impl Src for H {
    fn get(&mut self) -> i32 {
        resume 3;
    }
}

export fn run() {
    let mut h = H {};
    with Src => &mut h do {
        assert Src::get(1) == 3;
    };
}

