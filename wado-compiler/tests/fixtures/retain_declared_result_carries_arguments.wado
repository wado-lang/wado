// A bodyless declaration's result carries what its declaration says it is made
// of: `#[result(part_of = p)]` is `p`. `select` hands back one of two operands
// and states both, and `black_box` hands back its one. Read as carrying nothing,
// the borrow of `x` returned through either was not seen, so `let mut y = x`
// moved `x` and the write through `y` reached what the result points at.

struct S { v: i32 }

fn through_select(c: bool, r: &S) -> Option<&S> {
    return builtin::select(c, Option::Some(r), null);
}

fn through_black_box(r: &S) -> Option<&S> {
    return builtin::black_box(Option::Some(r));
}

test "a borrow returned through select" {
    let mut x = S { v: 1 };
    let got = through_select(builtin::black_box(true), &x);
    let mut y = x;
    y.v = 2;
    assert got matches { Some(r) && r.v == 1 };
    assert y.v == 2;
}

test "a borrow returned through black_box" {
    let mut x = S { v: 1 };
    let got = through_black_box(&x);
    let mut y = x;
    y.v = 2;
    assert got matches { Some(r) && r.v == 1 };
    assert y.v == 2;
}

__DATA__
{"test": {}}
