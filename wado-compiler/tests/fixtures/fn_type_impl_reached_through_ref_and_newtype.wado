// A function-type impl target binds from a receiver reached through a
// reference or a newtype, as from the function type itself.
use { println, Stdout } from "core:cli";

trait Arg with () {
    type In;
    fn sample(&self) -> Self::In;
}

impl<T: Default> Arg for &fn(T) {
    type In = T;
    fn sample(&self) -> T {
        return T::default();
    }
}

trait Held with () {
    type Out;
    fn held(&self) -> Self::Out;
}

impl<effect E> Held for fn() with E {
    type Out = fn() with E;
    fn held(&self) -> fn() with E {
        return *self;
    }
}

trait Tr with () {
    fn t(&self) -> String;
}

impl<effect E> Tr for fn() with (E, Stdout) {
    fn t(&self) -> String {
        return "has stdout";
    }
}

type Loud = fn() with Stdout;

export fn run() with Stdout {
    let takes = |_x: i32| {};
    let r = &takes;
    println(`${r.sample() + 1}`);
    let h: Loud = || { println("held"); };
    let g = h.held();
    g();
    println(h.t());
}

__DATA__
{"stdout": "1\nheld\nhas stdout\n"}
