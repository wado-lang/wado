// The purity check reads the same segment the elaborator does: an operation
// reached through a namespace alias still needs an installed handler, which a
// global initializer has no way to have.

use { println, Stdout } from "core:cli";
use c from "./sub/ns_counter.wado";

global COUNTED: i32 = c::Counter::next();

export fn run() with Stdout {
    println(`${COUNTED}`);
}

__DATA__
{
    "compile_error": "global initializer must be pure (no effects), but dispatches effect operation 'next', which needs an installed handler"
}
