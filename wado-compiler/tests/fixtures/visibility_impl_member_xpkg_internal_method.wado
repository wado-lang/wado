//! An `internal` method reaches other files in its own package, not another
//! package.
use { make_gadget } from "xpkg";

export fn run() {
    assert make_gadget().pkg_internal() == 22;
}

__DATA__
{
  "dependencies": { "xpkg": "sub/xpkg/lib.wado" },
  "compile_error": "cannot be called from another package"
}
