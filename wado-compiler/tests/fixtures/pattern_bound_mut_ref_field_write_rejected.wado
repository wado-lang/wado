variant Shape {
    Circle(i32),
    Dot,
}

struct Holder {
    shape: Shape,
    count: i32,
}

test "a write through a destructured field" {
    let mut holder = Holder { shape: Shape::Circle(1), count: 0 };
    let { shape, .. } = &mut holder;
    *shape = Shape::Dot;
}

__DATA__
{
    "test": {},
    "compile_error": "a variable cannot hold a `&mut Shape`"
}
