// A float pattern another module declares, in a default argument, an
// associated constant or a trait's default method, warns in its own module
// once, whichever module reads it, and that module's `allow` waives it.
use { is_half, is_tenth, Probe, ThreeQuarters } from "./sub/float_literal_pattern_lib.wado";

struct Gauge {}

impl ThreeQuarters for Gauge {}

test {
    assert Gauge {}.is_three_quarters(builtin::black_box(0.75));
    assert is_half(builtin::black_box(0.5)) && !is_half(builtin::black_box(0.25));
    assert is_tenth(builtin::black_box(0.1));
    assert Probe::QUARTER;
}

__DATA__
{
  "test": {},
  "warnings_contains": [
    "`0.5` matches one exact float",
    "`0.25` matches one exact float",
    "`0.75` matches one exact float"
  ],
  "warnings_not_contains": ["`0.1` matches"]
}
