// `Type::method` names the type's own method, so an inherent declaration
// shadows a trait impl's of the same name, as dot syntax already resolves it;
// the trait's is named `Trait::method`. Counted as an overload instead, every
// lookup that must commit to one declaration declined: no signature, no use→def
// edge, and liveness dropped the callee that reify then emitted a call to.
//
// Each declaration below is reached through one spelling only. Calling `q.tag()`
// beside `Q::tag(&q)` keeps the inherent method alive by another edge and hides
// exactly what this pins.

use { println, Stdout } from "core:cli";

trait Tag {
    fn tag(&self) -> i32;
}

struct Q {
    v: i32,
}

impl Tag for Q {
    fn tag(&self) -> i32 {
        return 100;
    }
}

impl Q {
    fn tag(&self) -> i32 {
        return 1;
    }
}

struct R {
    v: i32,
}

impl Tag for R {
    fn tag(&self) -> i32 {
        return 300;
    }
}

impl R {
    fn tag(&self) -> i32 {
        return 3;
    }
}

export fn run() with Stdout {
    let q = Q { v: 1 };
    println(`${Q::tag(&q)}`);
    println(`${Tag::tag(&q)}`);
    // A receiver of its own, so dot syntax is the sole reach for `R`'s inherent
    // declaration.
    let r = R { v: 2 };
    println(`${r.tag()}`);
}

__DATA__
{"stdout": "1\n100\n3\n"}
