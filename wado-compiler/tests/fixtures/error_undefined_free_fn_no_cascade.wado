// An unknown callee is one fault: the call's value is an error, so the
// argument it feeds reports nothing more.
use { println } from "core:cli";

export fn run() with Stdout {
    println(no_such_free_fn(42));
}

__DATA__
{
    "compile_error": "unknown function 'no_such_free_fn'",
    "compile_errors_not_contains": ["type mismatch"]
}
