// An operation's `with` clause is rejected: its effects reach no call site, so
// a default implementation could perform what its caller never declared.
use { Stdout } from "core:cli";

interface Noisy {
    fn shout(message: String) with Stdout;
}

export fn run() {
    Noisy::shout(`hi`);
}

__DATA__
{
    "compile_error": "cannot declare effects"
}
