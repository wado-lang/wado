// Test: `#[benign(A, B)]` accepts multiple effects. `seeded` performs both
// `InsecureSeed` and `Insecure` internally, its result showing neither, and
// `run` calls it without declaring either.

use { println, Stdout } from "core:cli";
use { Insecure, InsecureSeed } from "wasi:random";

#[benign(InsecureSeed, Insecure)]
fn seeded() -> i32 {
    let [_, _] = InsecureSeed::get_insecure_seed();
    let _ = Insecure::get_insecure_random_u64();
    return 7;
}

export fn run() with Stdout {
    println(`${seeded()}`);
}

__DATA__
{"stdout": "7\n"}
