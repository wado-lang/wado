// Test u8 basic operations
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Basic assignment
    let a: u8 = 10 as u8;
    let b: u8 = 3 as u8;

    // Arithmetic operations
    let sum = a + b;
    println(`sum: {sum}`);

    let diff = a - b;
    println(`diff: {diff}`);

    let prod = a * b;
    println(`prod: {prod}`);

    let quot = a / b;
    println(`quot: {quot}`);

    let rem = a % b;
    println(`rem: {rem}`);
}

__DATA__
{"stdout": "sum: 13\ndiff: 7\nprod: 30\nquot: 3\nrem: 1\n"}
