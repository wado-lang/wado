// Test Array iterator map combinator with closure
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let nums: Array<i32> = [1, 2, 3, 4, 5];

    // Basic map: double each element
    let doubled = nums.iter().map(|x: i32| x * 2).collect();
    for let x of doubled {
        println(`{x}`);
    }

    // Map with capture
    let factor = 3;
    let tripled = nums.iter().map(|x: i32| x * factor).collect();
    for let x of tripled {
        println(`{x}`);
    }
}

__DATA__
{"stdout": "2\n4\n6\n8\n10\n3\n6\n9\n12\n15\n"}
