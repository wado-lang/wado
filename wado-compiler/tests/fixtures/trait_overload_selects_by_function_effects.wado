// One trait implemented at two function types that differ only in their row:
// a function argument selects the impl whose row is exactly its own. A named
// function's row is declared, and a closure's is what its body performs.
use { println, Stdout } from "core:cli";

trait Take<F> with _ {
    fn take(&self, f: F) -> i32;
}

struct S {}

impl Take<fn()> for S {
    fn take(&self, f: fn()) -> i32 {
        f();
        return 1;
    }
}

impl Take<fn() with Stdout> for S {
    fn take(&self, f: fn() with Stdout) -> i32 with Stdout {
        f();
        return 2;
    }
}

trait Apply<F> with _ {
    fn apply(&self, f: F) -> i32;
}

impl Apply<fn(i32) -> i32> for S {
    fn apply(&self, f: fn(i32) -> i32) -> i32 {
        return f(1);
    }
}

impl Apply<fn(i32) -> i32 with Stdout> for S {
    fn apply(&self, f: fn(i32) -> i32 with Stdout) -> i32 with Stdout {
        return f(2) * 10;
    }
}

fn quiet() {}

fn loud() with Stdout {
    println("loud");
}

fn through_bound<T: Take<fn()> + Take<fn() with Stdout>>(t: &T) -> i32 with _ {
    return t.take(quiet) * 10 + t.take(loud);
}

export fn run() with Stdout {
    let s = S {};
    assert s.take(quiet) == 1;
    assert s.take(loud) == 2;
    assert s.take(|| {}) == 1;
    assert s.take(|| { println("closure"); }) == 2;
    assert through_bound(&s) == 12;
    // The candidates agree on the parameter types, which type `x`.
    assert s.apply(|x| x + 1) == 2;
    assert s.apply(|x| { println("printed"); return x; }) == 20;
}

__DATA__
{"stdout": "loud\nclosure\nloud\nprinted\n"}
