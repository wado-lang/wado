// Regression: `fixed_width_for_prec` returns a `FormatResult` POD and must not
// cost a per-call heap `struct.new`. Its pure `let` (promoted to an
// `Operand::Value`) used to fail `multi_value_return`'s shape check, forcing an
// allocation per conversion; today it is spliced into `fmt_fixed`, its only
// caller, and the result is never built. `pick` is `inline("never")` so the
// float stays opaque (a constant would fold the call site away).

#[inline("never")]
fn pick(n: i32) -> f64 {
    return f64::from_bits(4614256656552045848 + n as u64);
}

export fn run() {
    let s = `${pick(builtin::black_box(0)):.6}`;
    assert s == "3.141593";
}

__DATA__
{
    "stdout": "",
    "wir_not_expect:O2": [
        "struct.new \"core:prelude/fpfmt.wado//FormatResult\""
    ]
}
