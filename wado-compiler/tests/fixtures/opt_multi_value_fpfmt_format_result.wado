// Regression: fpfmt's `fixed_width_for_prec` returns a 2-field `FormatResult`
// POD struct and must use the multi-value return ABI, not a per-call heap
// `struct.new`. It has a pure `let` (e.g. `let p1 = -log10_e63;`) whose RHS the
// live value graph promotes to an `Operand::Value`; `multi_value_return`'s
// shape check used to treat that non-expr operand as a non-matching return and
// disqualify the function, forcing a `FormatResult` allocation on every
// float-to-string conversion. `pick` is `inline("never")` so the value stays
// opaque (a constant float would fold the call site away).

#[inline("never")]
fn pick(n: i32) -> f64 {
    return f64::from_bits(4614256656552045848 + n as i64);
}

export fn run() {
    let s = `{pick(0):.6}`;
    assert s == "3.141593";
}

__DATA__
{
    "stdout": "",
    "wir_expect:O2": [
        "fixed_width_for_prec\" = fn(f64, i32) -> [u64, i32]"
    ],
    "wir_not_expect:O2": [
        "struct.new \"core:prelude/fpfmt.wado//FormatResult\""
    ]
}
