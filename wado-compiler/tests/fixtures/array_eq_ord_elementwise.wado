// `Array<T>` compares element-wise, like `List<T>`.
//
// Regression for a compiler panic: `binop_operand_requires_trait` did not
// classify `BuiltinArray` as trait-dispatched, so `a == b` fell through to the
// scalar path and `wir_build` panicked with
// `[WIR] `Eq` has no scalar lowering for BuiltinArray(TypeId(_))`.
// There was also no `Eq` / `Ord` impl to dispatch to.

test "equal contents compare equal" {
    let a: Array<i32> = Array::filled(3, 7);
    let b: Array<i32> = Array::filled(3, 7);
    assert a == b;
    assert !(a != b);
}

test "differing element compares unequal" {
    let mut a: Array<i32> = Array::filled(3, 7);
    let b: Array<i32> = Array::filled(3, 7);
    a[1] = 8;
    assert a != b;
    assert !(a == b);
}

test "differing length compares unequal" {
    let a: Array<i32> = Array::filled(2, 7);
    let b: Array<i32> = Array::filled(3, 7);
    assert a != b;
}

test "equality is by value, not by backing identity" {
    let a: Array<String> = Array::filled(2, "x");
    let b = a;
    assert a == b;
}

test "ordering is lexicographic" {
    let mut a: Array<i32> = Array::filled(3, 1);
    let mut b: Array<i32> = Array::filled(3, 1);
    b[2] = 2;
    assert a < b;
    assert b > a;
    assert a <= b;
    assert !(a >= b);

    a[0] = 9;
    assert a > b;
}

test "a prefix orders before a longer array" {
    let short: Array<i32> = Array::filled(2, 1);
    let long: Array<i32> = Array::filled(3, 1);
    assert short < long;
    assert long > short;
}

test "equal arrays order as equal" {
    let a: Array<i32> = Array::filled(3, 4);
    let b: Array<i32> = Array::filled(3, 4);
    assert a <= b;
    assert a >= b;
    assert !(a < b);
    assert !(a > b);
}

__DATA__
{"test": {}}
