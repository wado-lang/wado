// Identical immutable const globals are merged by
// `wir_optimize::dedupe_const_globals`. Two functions each hoist the same
// constant `[10, 20, 30, 40]` (via `const_object_globalization`), producing two
// const globals with byte-identical inits; the dedup pass keeps one canonical
// global, rewrites the other's reads to it, and drops it. Under value semantics
// the merge is unobservable, and the output proves both reads still work.
//
// `const_object_globalization` also hoists unrelated `&`-literal call
// arguments elsewhere in this program (e.g. the bounds-check assert
// diagnostic's message fragments, built fresh at each `xs[i % 4]` / `ys[i %
// 4]`), so the exact `__const_obj_N` numbering is not stable — this fixture
// pins the shared post-dedup read site instead of a specific absent number.

use { println, Stdout } from "core:cli";

fn sum_a(n: i32) -> i32 {
    let xs: List<i32> = [10, 20, 30, 40];
    let mut s = 0;
    let mut i = 0;
    while i < n {
        s = s + xs[i % 4];
        i = i + 1;
    }
    return s;
}

fn sum_b(n: i32) -> i32 {
    let ys: List<i32> = [10, 20, 30, 40];
    let mut s = 0;
    let mut i = 0;
    while i < n {
        s = s + ys[i % 4];
        i = i + 1;
    }
    return s;
}

export fn run() with Stdout {
    println(`${sum_a(4)},${sum_b(4)}`);
}

__DATA__
{
    "stdout": "100,100\n",
    "wir_expect:O2": [
        "global global:const_global_dedup.wado::__const_obj_6",
        "array.new_fixed<i32>(10, 20, 30, 40)",
        "global:const_global_dedup.wado::__const_obj_6.repr"
    ],
    "wir_not_expect:O2": [
        "global mut global:const_global_dedup.wado::__const_obj_6"
    ]
}
