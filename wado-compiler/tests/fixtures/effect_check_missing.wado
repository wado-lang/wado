// Test: calling a function that requires an effect from a function without that effect
// This should produce a compile error

use { println, Stdout } from "core:cli";

fn greet(name: String) with Stdout {
    println(`Hello, ${name}!`);
}

fn bad() {
    greet("Bob");  // ERROR: missing Stdout effect
}

export fn run() with Stdout {
    println("this test should not run");
}

__DATA__
{"compile_error": "missing effect"}
