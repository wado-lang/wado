// Mutating String through &mut reference (append method)

use { println, Stdout } from "core:cli";

fn append_world(s: &mut String) {
    s.append(", World!");
}

fn append_twice(s: &mut String, suffix: String) {
    s.append(suffix);
    s.append(suffix);
}

export fn run() with Stdout {
    let mut msg = "Hello";
    append_world(&mut msg);
    println(msg);

    let mut s = "a";
    append_twice(&mut s, "b");
    println(s);
}

__DATA__
{"stdout": "Hello, World!\nabb\n"}
