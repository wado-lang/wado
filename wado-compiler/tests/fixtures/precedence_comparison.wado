


// from precedence_comparison_chaining.wado
fn precedence_comparison_chaining() with Stdout {
    // Basic ascending chain
    // 1 < 2 < 3 = (1 < 2) && (2 < 3) = true && true = true
    let a = 1 < 2 < 3;
    assert a == true;

    // Failing ascending chain
    // 1 < 3 < 2 = (1 < 3) && (3 < 2) = true && false = false
    let b = 1 < 3 < 2;
    assert b == false;

    // Basic descending chain
    // 3 > 2 > 1 = (3 > 2) && (2 > 1) = true && true = true
    let c = 3 > 2 > 1;
    assert c == true;

    // Range check pattern
    // 0 <= 5 <= 10 = (0 <= 5) && (5 <= 10) = true && true = true
    let x = 5;
    let d = 0 <= x <= 10;
    assert d == true;

    // Out of range
    // 0 <= 15 <= 10 = (0 <= 15) && (15 <= 10) = true && false = false
    let y = 15;
    let e = 0 <= y <= 10;
    assert e == false;

    // Descending with >=
    // 10 >= 5 >= 0 = (10 >= 5) && (5 >= 0) = true && true = true
    let f = 10 >= 5 >= 0;
    assert f == true;

    // Equality chain
    // 5 == 5 == 5 = (5 == 5) && (5 == 5) = true && true = true
    let g = 5 == 5 == 5;
    assert g == true;

    // Failing equality chain
    // 5 == 5 == 6 = (5 == 5) && (5 == 6) = true && false = false
    let h = 5 == 5 == 6;
    assert h == false;

    // Longer chain
    // 1 < 2 < 3 < 4 = (1 < 2) && (2 < 3) && (3 < 4) = true
    let i = 1 < 2 < 3 < 4;
    assert i == true;
}

// from precedence_comparison_vs_logical.wado
fn precedence_comparison_vs_logical() with Stdout {
    // Comparison has higher precedence than &&
    // 1 < 2 && 3 < 4 = (1 < 2) && (3 < 4) = true && true = true
    let a = 1 < 2 && 3 < 4;
    assert a == true;

    // && has higher precedence than ||
    // true || false && false = true || (false && false) = true || false = true
    let b = true || false && false;
    assert b == true;

    // false && true || true = (false && true) || true = false || true = true
    let c = false && true || true;
    assert c == true;

    // Complex: comparison, then &&, then ||
    // 1 == 1 && 2 == 2 || 3 == 4 = ((1 == 1) && (2 == 2)) || (3 == 4)
    //                            = (true && true) || false
    //                            = true || false = true
    let d = 1 == 1 && 2 == 2 || 3 == 4;
    assert d == true;

    // 1 == 2 || 3 == 3 && 4 == 4 = (1 == 2) || ((3 == 3) && (4 == 4))
    //                            = false || (true && true)
    //                            = false || true = true
    let e = 1 == 2 || 3 == 3 && 4 == 4;
    assert e == true;

    // Multiple && (left-to-right)
    // true && true && false = (true && true) && false = true && false = false
    let f = true && true && false;
    assert f == false;

    // Multiple || (left-to-right)
    // false || false || true = (false || false) || true = false || true = true
    let g = false || false || true;
    assert g == true;

    // Comparison operators with numbers
    // 5 > 3 && 10 <= 10 || 1 != 1 = ((5 > 3) && (10 <= 10)) || (1 != 1)
    //                             = (true && true) || false
    //                             = true || false = true
    let h = 5 > 3 && 10 <= 10 || 1 != 1;
    assert h == true;

    // 2 >= 3 || 4 < 5 && 6 == 6 = (2 >= 3) || ((4 < 5) && (6 == 6))
    //                           = false || (true && true)
    //                           = false || true = true
    let i = 2 >= 3 || 4 < 5 && 6 == 6;
    assert i == true;
}

export fn run() with Stdout {
    precedence_comparison_chaining();
    precedence_comparison_vs_logical();
}

__DATA__
{"stdout": ""}
