// Regression: the format-trait redirect points `${g:?}` at the per-functor
// impl, which takes `&__Closure_N`. A closure that also escapes to an `fn(...)`
// parameter travels as a `CanonicalClosure_K`, so the redirect must stand down.
use { println, Stdout } from "core:cli";

fn apply(f: fn(i32) -> i32, v: i32) -> i32 {
    return f(v);
}

export fn run() with Stdout {
    let g = |x: i32| x + 1;
    println(`${apply(g, 1)} ${g:?}`);
}

__DATA__
{"stdout": "2 |i32| -> i32\n"}
