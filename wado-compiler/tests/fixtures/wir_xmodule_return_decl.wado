//! A namespace-qualified type used in a struct *field* declaration
//! (`Wrapper.node: mini::CstNode`) must resolve to the canonical cross-module
//! struct.
//!
//! The decl pre-pass that builds `all_struct_fields` resolved field types with
//! an empty namespace-import map, so `mini::CstNode` resolved to `unknown` and
//! reading `w.node.kind` errored with "expected 'unknown'" (sibling of issue
//! #1415's return-type miscompile).

use { wrap } from "./sub/wir_xmodule_return_decl.wado";
use mini from "./sub/wir_xmodule_return_parser.wado";

test "namespace-qualified struct field resolves canonically" {
    let w = wrap(&"(1)");
    assert w.node.kind == mini::RK_PROG;
}

__DATA__
{"test": {}}
