//! A namespace-qualified struct *field* type (`Wrapper.node: mini::CstNode`)
//! must resolve to the canonical cross-module struct. The decl pre-pass building
//! `all_struct_fields` once dropped namespace imports, so the field resolved to
//! `unknown` and `w.node.kind` errored "expected 'unknown'" (issue #1415).

use { wrap } from "./sub/wir_xmodule_return_decl.wado";
use mini from "./sub/wir_xmodule_return_parser.wado";

test "namespace-qualified struct field resolves canonically" {
    let w = wrap(&"(1)");
    assert w.node.kind == mini::RK_PROG;
}

__DATA__
{"test": {}}
