// A namespace-imported function used as a value (function reference) is
// accessed with the `ns::` prefix and reifies to a `FuncRef` for the
// defining module.
use h from "./sub/ns_robust_helper.wado";

fn apply(f: fn(i32, i32) -> i32, a: i32, b: i32) -> i32 {
    return f(a, b);
}

test "namespace function reference" {
    let f = h::add;
    assert f(2, 3) == 5;
    assert apply(h::add, 10, 20) == 30;
}

__DATA__
{"test": {}}
