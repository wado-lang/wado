// A derived body answers a method call as an impl does. Lookup reads the match
// off the `Reflect*` blanket the body comes from, which the order names for the
// derived impl; a marker `impl Serialize for T;` names its own block
// (WEP 2026-09-01, "Selection collects, the order decides").

use { Serialize, Serializer, SerializeSeq, SerializeMap, SerializeStruct, SerializeVariant, SerializeError } from "core:serde";

struct Sink {
    out: String,
}

struct SeqSink {}

struct MapSink {}

struct StructSink {}

struct VariantSink {}

impl SerializeSeq for SeqSink {
    fn element<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
    fn end(&mut self) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
}

impl SerializeMap for MapSink {
    fn key<T: Serialize>(&mut self, key: &T) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
    fn value<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
    fn end(&mut self) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
}

impl SerializeStruct for StructSink {
    fn field<T: Serialize>(&mut self, name: &String, value: &T) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
    fn end(&mut self) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
}

impl SerializeVariant for VariantSink {
    fn payload<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
    fn end(&mut self) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
}

impl Serializer for Sink {
    type SeqSerializer = SeqSink;
    type MapSerializer = MapSink;
    type StructSerializer = StructSink;
    type VariantSerializer = VariantSink;

    fn serialize_i32(&mut self, v: i32) -> Result<(), SerializeError> {
        self.out = `${v}`;
        return Result::Ok(());
    }
    fn serialize_i64(&mut self, v: i64) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
    fn serialize_u32(&mut self, v: u32) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
    fn serialize_u64(&mut self, v: u64) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
    fn serialize_i128(&mut self, v: i128) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
    fn serialize_u128(&mut self, v: u128) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
    fn serialize_f32(&mut self, v: f32) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
    fn serialize_f64(&mut self, v: f64) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
    fn serialize_bool(&mut self, v: bool) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
    fn serialize_char(&mut self, v: char) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
    fn serialize_string(&mut self, v: &String) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
    fn serialize_null(&mut self) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
    fn begin_seq(&mut self, len: i32) -> Result<SeqSink, SerializeError> with stores[self] {
        return Result::Ok(SeqSink {});
    }
    fn begin_map(&mut self, len: i32) -> Result<MapSink, SerializeError> with stores[self] {
        return Result::Ok(MapSink {});
    }
    fn begin_struct(&mut self, name: &String, fields: i32) -> Result<StructSink, SerializeError> with stores[self] {
        self.out = *name;
        return Result::Ok(StructSink {});
    }
    fn serialize_unit_variant(&mut self, type_name: &String, variant_name: &String, disc: i32) -> Result<(), SerializeError> {
        return Result::Ok(());
    }
    fn begin_variant(&mut self, type_name: &String, variant_name: &String, disc: i32) -> Result<VariantSink, SerializeError> with stores[self] {
        return Result::Ok(VariantSink {});
    }
}

struct Point {
    x: i32,
}

struct Marked {
    x: i32,
}
impl Serialize for Marked;

struct Pair<T> {
    a: T,
    b: T,
}

// The derived body is conditional on the fields, so the bound is written here:
// `Pair<T>` serializes where `T` does (WEP 2026-09-01, "Eligibility gates").
fn write_pair<T: Serialize>(p: &Pair<T>, ser: &mut Sink) -> Result<(), SerializeError> {
    return p.serialize(ser);
}

test "a derived body answers a method call on a struct" {
    let p = Point { x: 1 };
    let mut ser = Sink { out: "" };
    let r = p.serialize(&mut ser);
    assert r matches { Ok(_) };
    assert ser.out == "Point";
}

test "a marker's body answers a method call" {
    let m = Marked { x: 1 };
    let mut ser = Sink { out: "" };
    let r = m.serialize(&mut ser);
    assert r matches { Ok(_) };
    assert ser.out == "Marked";
}

test "a primitive's impl answers a method call" {
    let n: i32 = 7;
    let mut ser = Sink { out: "" };
    let r = n.serialize(&mut ser);
    assert r matches { Ok(_) };
    assert ser.out == "7";
}

test "a derived body answers through a bounded parameter" {
    let p = Pair { a: 1, b: 2 };
    let mut ser = Sink { out: "" };
    let r = write_pair(&p, &mut ser);
    assert r matches { Ok(_) };
    assert ser.out == "Pair";
}

__DATA__
{"test": {}}
