// Test: Reading HTTP request body via Stream::read()
// Consumes the request body stream and echoes the length in the response body.
use { Request, Response, ErrorCode, Fields, Trailers } from "wasi:http";

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    // Consume the request body
    let [res_future, _res_tx] = Future::<Result<(), ErrorCode>>::new();
    let [body_stream, _trailers] = Request::consume_body(request, res_future);

    // Read the entire request body
    let mut total_len = 0;
    loop {
        let chunk = body_stream.read(4096);
        if chunk.len() == 0 {
            break;
        }
        total_len = total_len + chunk.len();
    }
    body_stream.drop();

    // Build response with body length as body text
    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [resp_body_rx, resp_body_tx] = Stream::<u8>::new();

    let headers = Fields::new();
    let [response, _tx_future] = Response::new(headers, Option::<Stream<u8>>::Some(resp_body_rx), trailers_future);

    task return Result::<Response, ErrorCode>::Ok(response);

    // Write the length as response body bytes
    // For "Hello" (5 bytes), write "5"
    let len_byte = (total_len + 48) as u8;  // ASCII digit
    let body_data: Array<u8> = [len_byte];
    resp_body_tx.write(body_data);
    resp_body_tx.drop();

    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

__DATA__
{
    "wasi:http/service": {
        "request": {
            "method": "POST",
            "path": "/",
            "body": "Hello"
        },
        "status": 200,
        "body": "5"
    }
}
