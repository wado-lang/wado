// Test importing generic structs from collections
// This tests that generic structs like TreeMap<K,V> work when imported from core:collections
use { println } from "core:cli";
use { TreeMap } from "core:collections";

fn run() with Stdout {
    // TreeMap is defined in core:collections with type params <K, V>
    let mut map = TreeMap::<String, i32>::new();
    map["hello"] = 42;

    if let Some(val) = map["hello"] {
        println(`value: {val}`);
    }
}

__DATA__
{"stdout": "value: 42\n"}
