// An inherent impl whose target nests its type parameter inside an argument
// binds the parameter to what the receiver holds there.

struct Pair<A, B> {
    a: A,
    b: B,
}

impl<T> Pair<List<T>, i32> {
    fn first(&self) -> T {
        return self.a[0];
    }
}

impl<T> Pair<[T, bool], i32> {
    fn left(&self) -> T {
        return self.a.0;
    }
}

test "a parameter inside a generic argument" {
    let p: Pair<List<String>, i32> = Pair { a: ["x", "y"], b: 0 };
    let q: Pair<List<u8>, i32> = Pair { a: [7], b: 0 };
    assert p.first() == "x";
    assert q.first() == 7;
}

test "a parameter inside a tuple argument" {
    let p: Pair<[String, bool], i32> = Pair { a: ["x", true], b: 0 };
    assert p.left() == "x";
}

__DATA__
{"test": {}}
