use { println, Stdout } from "core:cli";

// from inspect_nested_array_struct_test.wado
struct Matrix {
    data: Array<Array<i32>>,
    rows: i32,
}

// from inspect_nested_array_struct_test.wado
fn inspect_nested_array_struct_test() with Stdout {
    let m = Matrix { data: [[1, 2], [3, 4]], rows: 2 };
    println(`{m:?}`);
}

// from inspect_nested_array_tuple_test.wado
fn inspect_nested_array_tuple_test() with Stdout {
    let arr: Array<[i32, String]> = [[1, "one"], [2, "two"]];
    println(`{arr:?}`);
}

// from inspect_nested_test.wado
fn inspect_nested_test() with Stdout {
    let matrix: Array<Array<i32>> = [[1, 2], [3, 4]];
    println(`{matrix:?}`);

    println("ok");
}

export fn run() with Stdout {
    inspect_nested_array_struct_test();
    inspect_nested_array_tuple_test();
    inspect_nested_test();
}

__DATA__
{"stdout": "Matrix { data: [[1, 2], [3, 4]], rows: 2 }\n[[1, \"one\"], [2, \"two\"]]\n[[1, 2], [3, 4]]\nok\n"}
