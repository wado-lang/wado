// ReflectVariant concrete metadata (WEP 2026-06-13 §3b/§3d): type_name,
// case_meta, and the discriminant value bridge on a concrete variant.

variant Shape {
    Circle(f64),
    Rectangle([f64, f64]),
    Point,
}

test "type_name and case_meta" {
    assert ReflectVariant::<Shape>::type_name() == "Shape";

    let metas = ReflectVariant::<Shape>::case_meta();
    assert metas.len() == 3;
    assert metas[0].name == "Circle";
    assert metas[0].discriminant == 0;
    assert !metas[0].is_unit;
    assert metas[1].name == "Rectangle";
    assert metas[1].discriminant == 1;
    assert metas[2].name == "Point";
    assert metas[2].discriminant == 2;
    assert metas[2].is_unit;
}

test "discriminant reads the live case" {
    let c = Shape::Circle(2.5);
    let r = Shape::Rectangle([3.0, 4.0]);
    let p = Shape::Point;
    assert ReflectVariant::<Shape>::discriminant(&c) == 0;
    assert ReflectVariant::<Shape>::discriminant(&r) == 1;
    assert ReflectVariant::<Shape>::discriminant(&p) == 2;
}

__DATA__
{"test": {}}
