use { println, Stdout } from "core:cli";

// An anonymous struct names no declaration, so a field's index has to come from
// the shape the literal interned. A pattern that resolves it by rendered
// spelling instead finds nothing and collapses every field onto index 0.
export fn run() with Stdout {
    let p = { x: 1, y: 2, z: 3 };
    let { x, y, z } = p;
    println(`${x}, ${y}, ${z}`);

    let { y: renamed, .. } = p;
    println(`${renamed}`);

    let q = { outer: 10, inner: { deep: 20 } };
    let { outer, inner: { deep } } = q;
    println(`${outer}, ${deep}`);
}

__DATA__
{"stdout": "1, 2, 3\n2\n10, 20\n"}
