// Test: a call to a function whose body WIR emptied is removed. Promoting the
// list global to an eager constant leaves the module's `$initialize_module`
// with nothing to do, and the program's initializer must not keep calling it.

use { println, Stdout } from "core:cli";

global TABLE: List<i32> = [3, 1, 4, 1, 5];

#[inline(never)]
fn pick(i: i32) -> i32 {
    return TABLE[i];
}

export fn run() with Stdout {
    println(`${pick(builtin::black_box(2))}`);
}

__DATA__
{
    "stdout": "4\n",
    "wir_not_expect:O2": [
        "$initialize_module\"()"
    ]
}
