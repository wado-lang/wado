// Geometry module with Point struct
// Also serves as a test for basic struct with impl methods

use { println, Stdout } from "core:cli";

pub struct Point {
    pub x: i32,
    pub y: i32,
}

impl Point {
    pub fn sum(&self) -> i32 {
        return self.x + self.y;
    }

    pub fn product(&self) -> i32 {
        return self.x * self.y;
    }
}

export fn run() with Stdout {
    let p = Point { x: 3, y: 4 };
    println(`sum: {p.sum()}`);
    println(`product: {p.product()}`);
}

__DATA__
{"stdout": "sum: 7\nproduct: 12\n"}
