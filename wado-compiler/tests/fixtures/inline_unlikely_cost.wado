// Inline cost must ignore the cold arm of a branch hinted with
// `builtin::unlikely` / `builtin::likely`.
//
// Both probes are tiny on their hot path but guard a large arithmetic cold
// path that, when counted, blows past the default inline threshold. The cold
// arm is by construction off the hot path, so the cost heuristic skips it and
// keeps the function inlinable. At -O2 each probe is inlined into `run` and
// DCE'd away, so its name disappears from the WIR.
//
// `wir_not_expect:O2` is the discriminator: without the cost fix, neither
// probe is inlined, the call survives, and the name reappears.

use { println, Stdout } from "core:cli";

// `builtin::unlikely(cond)` marks the then-branch as cold.
fn probe_unlikely(x: i32) -> i32 {
    let r = x + 1;
    if builtin::unlikely(x < 0) {
        let a = x + 2;
        let b = a + 3;
        let c = b + 4;
        let d = c + 5;
        let e = d + 6;
        let f = e + 7;
        let g = f + 8;
        let h = g + 9;
        let i = h + 10;
        let j = i + 11;
        panic(`cold {j}`);
    }
    return r;
}

// `builtin::likely(cond)` marks the else-branch as cold.
fn probe_likely(x: i32) -> i32 {
    let r = x + 1;
    if builtin::likely(x >= 0) {
        return r;
    } else {
        let a = x + 2;
        let b = a + 3;
        let c = b + 4;
        let d = c + 5;
        let e = d + 6;
        let f = e + 7;
        let g = f + 8;
        let h = g + 9;
        let i = h + 10;
        let j = i + 11;
        panic(`cold {j}`);
    }
}

export fn run() with Stdout {
    let a = probe_unlikely(5);
    let b = probe_likely(7);
    println(`{a},{b}`);
}

__DATA__
{
    "stdout": "6,8\n",
    "wir_not_expect:O2": ["probe_unlikely", "probe_likely"]
}
