// Test operator trait lookup on newtypes (Add, Sub, Eq, Ord)
use { println, Stdout } from "core:cli";

struct Vec2 {
    x: f64,
    y: f64,
}

impl Add for Vec2 {
    type Output = Vec2;
    fn add(&self, rhs: &Vec2) -> Vec2 {
        return Vec2 { x: self.x + rhs.x, y: self.y + rhs.y };
    }
}

impl Sub for Vec2 {
    type Output = Vec2;
    fn sub(&self, rhs: &Vec2) -> Vec2 {
        return Vec2 { x: self.x - rhs.x, y: self.y - rhs.y };
    }
}

impl Neg for Vec2 {
    type Output = Vec2;
    fn neg(&self) -> Vec2 {
        return Vec2 { x: -self.x, y: -self.y };
    }
}

impl Eq for Vec2 {
    fn eq(&self, other: &Self) -> bool {
        return self.x == other.x && self.y == other.y;
    }
}

// Newtype wrapping Vec2
type Position = Vec2;
type Velocity = Vec2;

export fn run() with Stdout {
    let p1 = Vec2 { x: 1.0, y: 2.0 } as Position;
    let p2 = Vec2 { x: 3.0, y: 4.0 } as Position;

    // Add on newtype
    let p3 = p1 + p2;
    assert p3.x == 4.0;
    assert p3.y == 6.0;
    println(`add: ${p3.x}, ${p3.y}`);

    // Sub on newtype
    let diff = p2 - p1;
    assert diff.x == 2.0;
    assert diff.y == 2.0;
    println(`sub: ${diff.x}, ${diff.y}`);

    // Neg on newtype
    let neg = -p1;
    assert neg.x == -1.0;
    assert neg.y == -2.0;
    println(`neg: ${neg.x}, ${neg.y}`);

    // Eq on newtype
    let same = Vec2 { x: 1.0, y: 2.0 } as Position;
    assert p1 == same;
    assert !(p1 == p2);
    println(`eq: true`);

    // Different newtypes of same base cannot be mixed
    let v1 = Vec2 { x: 5.0, y: 6.0 } as Velocity;
    // v1 + p1 would be a type error — they're different newtypes
    // Just verify Velocity works independently
    let v2 = Vec2 { x: 1.0, y: 1.0 } as Velocity;
    let v3 = v1 + v2;
    assert v3.x == 6.0;
    println(`velocity: ${v3.x}, ${v3.y}`);

    println("ok");
}

__DATA__
{"stdout": "add: 4, 6\nsub: 2, 2\nneg: -1, -2\neq: true\nvelocity: 6, 7\nok\n"}
