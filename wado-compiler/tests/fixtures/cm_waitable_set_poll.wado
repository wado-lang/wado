// WaitableSet::poll E2E test
// Tests that WaitableSet::poll() returns None when no events are ready.

use { Request, Response, ErrorCode, Fields, Trailers } from "wasi:http";

export async fn handle(request: Request) -> Result<Response, ErrorCode> with WaitableSet {
    // Create a waitable set and poll it (should get None since nothing is joined)
    let ws = WaitableSet::new();
    let event = ws.poll();

    // Poll should return None since there are no waitables
    if let Some(_) = event {
        // Unexpected — should not happen
        ws.drop();
        let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
        let headers = Fields::new();
        let [response, _tx_future] = Response::new(headers, null, trailers_future);
        task return Result::<Response, ErrorCode>::Ok(response);
        trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
    }

    ws.drop();

    // Return 200 OK
    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let headers = Fields::new();
    let [response, _tx_future] = Response::new(headers, null, trailers_future);
    task return Result::<Response, ErrorCode>::Ok(response);
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

__DATA__
{"wasi:http/service": {"status": 200}}
