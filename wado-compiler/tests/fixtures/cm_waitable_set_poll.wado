// Polling a WaitableSet with no members finds no event.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut set = WaitableSet::<Subtask>::new();
    let ready = set.poll();
    println(`ready: ${ready matches { Some(_) }}`);
}

__DATA__
{"stdout": "ready: false\n"}
