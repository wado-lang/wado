// A local declared without a value, a reference to which a call may keep.
// An assignment a reference may precede writes in place, behind a flag that
// says whether the local holds storage yet. The first assignment, which no
// reference precedes, stores: nothing reads the local before Wasm sees it set,
// so it stays non-nullable.
//
// A reference a loop takes precedes every assignment in the loop, since the
// next turn brings it first, but not one before the loop.
struct P {
    a: i32,
    b: i32,
}

impl P {
    fn sum(&self) -> i32 {
        return self.a + self.b;
    }
}

fn read_after(n: i32) -> i32 {
    let mut x: P;
    x = P { a: 1, b: 1 };
    let r = &x;
    builtin::black_box(r);
    x = P { a: 5, b: n };
    return r.a + r.b;
}

fn unread_after(n: i32) -> i32 {
    let mut x: P;
    x = P { a: 1, b: 1 };
    let r = &x;
    builtin::black_box(r);
    x = P { a: 5, b: n };
    return n;
}

fn first_assigned_in_an_arm(n: i32) -> i32 {
    let mut x: P;
    match n {
        _ => x = P { a: 1, b: 1 },
    }
    let r = &x;
    while builtin::black_box(false) {
        builtin::black_box(r);
    }
    x = P { a: 5, b: n };
    return r.sum();
}

fn referenced_by_a_loop_after(n: i32) -> i32 {
    let mut x: P;
    let mut r = &P { a: 0, b: 0 };
    x = P { a: 1, b: 1 };
    while r.a < 1 {
        r = &x;
        builtin::black_box(r);
    }
    x = P { a: 5, b: n };
    return r.a + r.b;
}

test "the reference reads the reassigned value" {
    assert read_after(5) == 10;
    assert first_assigned_in_an_arm(5) == 10;
    assert referenced_by_a_loop_after(5) == 10;
}

test "no read follows the reassignment" {
    assert unread_after(5) == 5;
}

__DATA__
{
    "test": {},
    "wir_not_expect:O0": [
        "let x: ref null"
    ]
}
