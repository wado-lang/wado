// A tag's result that meets the wrong type is an ordinary mismatch: only the
// template handed to the tag is a tag fault (WEP 2026-01-10).
fn id<T: ReflectTemplate<Holes = [..V]>, ..V>(t: T) -> T {
    return t;
}

export fn run() {
    let x = 1;
    let _: i32 = id`a ${x}`;
}

__DATA__
{
    "compile_error": "type mismatch: expected 'i32', found '`a ${i32}`'",
    "compile_errors_not_contains": ["a template tag's parameter"]
}
