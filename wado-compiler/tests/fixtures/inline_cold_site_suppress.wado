// Call sites in a cold context (after a `cold_path()` marker in the same
// block) are not inlined: the callee body would bloat the hot caller with
// code that rarely runs. An explicit `#[inline(always)]` still wins, as does a
// body no bigger than the call. A callee referenced only from cold sites
// therefore survives as a standalone function (`cold_helper` below), while
// hot-site, forced and tiny callees inline and DCE away (`hot_helper`,
// `forced_helper`, `tiny_helper`).

fn cold_helper(x: i32) -> i32 {
    let mut h = x ^ 0x5bd1e995;
    h = (h ^ h >> 13) * 0x2c1b3c6d;
    h = (h ^ h >> 15) * 0x297a2d39;
    return h ^ h >> 16;
}

fn hot_helper(x: i32) -> i32 {
    return x + 2000;
}

#[inline(always)]
fn forced_helper(x: i32) -> i32 {
    return x + 3000;
}

fn tiny_helper(x: i32) -> i32 {
    return x + 4000;
}

#[inline(never)]
fn h(x: i32) -> i32 {
    if x < 0 {
        builtin::cold_path();
        return tiny_helper(x);
    }
    return x;
}

#[inline(never)]
fn f(x: i32) -> i32 {
    if x < 0 {
        builtin::cold_path();
        return cold_helper(x);
    }
    return hot_helper(x);
}

#[inline(never)]
fn g(x: i32) -> i32 {
    if x < 0 {
        builtin::cold_path();
        return forced_helper(x);
    }
    return x;
}

export fn run() {
    // Opaque arguments, or every call folds and no site is left to inline at.
    assert f(builtin::black_box(5)) == 2005;
    assert f(builtin::black_box(-5)) == 1389461265;
    assert g(builtin::black_box(-5)) == 2995;
    assert g(builtin::black_box(7)) == 7;
    assert h(builtin::black_box(-5)) == 3995;
}

__DATA__
{
    "stdout": "",
    "wir_expect:O2": ["cold_helper"],
    "wir_not_expect:O2": ["hot_helper", "forced_helper", "tiny_helper"]
}
