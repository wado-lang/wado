// With `type` alone, the file is read as that type, and only `"wasm"` and
// `"wat"` are types the compiler reads. Any other names a format for a
// generator, so the use site must say which one reads it.

use { greeting } from "./sub/use_type_alone_is_wasm_or_wat.g4" with { type: "antlr4" };

