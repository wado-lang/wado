// Test closure returning struct literal
// Named struct literals (Point { ... }) work as closure expression body
use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

fn run() with Stdout {
    // Named struct literal as expression body (no parens needed)
    let make_point = |x: i32, y: i32| Point { x, y };

    let p: Point = make_point(10, 20);
    println(`{p.x},{p.y}`);
}

__DATA__
{"stdout": "10,20\n"}
