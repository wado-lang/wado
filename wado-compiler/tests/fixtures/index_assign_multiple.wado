// Multiple index assignments in same scope (tests local reuse)
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut a: Array<i32> = [0, 0, 0];
    let mut b: Array<i32> = [0, 0, 0];
    let mut c: Array<i64> = [0 as i64, 0 as i64];
    let mut d: Array<f64> = [0.0, 0.0];

    // Multiple i32 assignments (should reuse same temp local)
    a[0] = 1;
    a[1] = 2;
    a[2] = 3;
    b[0] = 10;
    b[1] = 20;
    b[2] = 30;

    // i64 assignments (different temp local)
    c[0] = 100 as i64;
    c[1] = 200 as i64;

    // f64 assignments (different temp local)
    d[0] = 1.5;
    d[1] = 2.5;

    println(`a: {a[0]} {a[1]} {a[2]}`);
    println(`b: {b[0]} {b[1]} {b[2]}`);
    println(`c: {c[0]} {c[1]}`);
    println(`d: {d[0]} {d[1]}`);
}

__DATA__
{"stdout": "a: 1 2 3\nb: 10 20 30\nc: 100 200\nd: 1.5 2.5\n"}
