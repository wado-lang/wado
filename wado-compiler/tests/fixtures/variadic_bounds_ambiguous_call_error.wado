// Two variadic impls of one trait whose bounds a tuple both meets: nothing
// ranks them, so the call reports, as it does for two head impls.

trait Tag with () {
    fn tag(&self) -> String;
}

impl<..T: Inspect> Tag for [..T] {
    fn tag(&self) -> String {
        return "a";
    }
}

impl<..T: Eq> Tag for [..T] {
    fn tag(&self) -> String {
        return "b";
    }
}

export fn run() {
    let pair = [1, 2];
    assert pair.tag() != "";
}

__DATA__
{"compile_error_codes": ["AMBIGUOUS_CANDIDATE"]}
