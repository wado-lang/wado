// An operation's declared default fills a trailing argument the call omits,
// the same call-site desugaring a free function's default gets. Dispatch
// reaches the handler with the argument already in place.

use { println, Stdout } from "core:cli";

interface Greet {
    fn hello(name: String = "world") -> String;
}

struct Mock {}

impl Greet for Mock {
    fn hello(&mut self, name: String) -> String {
        resume `hello, ${name}`
    }
}

export fn run() with Stdout {
    let mut h = Mock {};
    with &mut h do {
        assert Greet::hello() == "hello, world";
        assert Greet::hello(`wado`) == "hello, wado";
    }
    println("ok");
}

__DATA__
{
    "stdout": "ok\n"
}
