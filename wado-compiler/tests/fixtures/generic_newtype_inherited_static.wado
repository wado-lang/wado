// A generic newtype calling a static its base supplies, its arguments
// inferred: the call solves the newtype's own parameters, which `Listed`
// places inside the base's argument, and answers with the newtype. Every
// spelling of the receiver does, bare, with `_`, or through a namespace.
// A static the newtype declares itself keeps the type it wrote.
use { println, Stdout } from "core:cli";
use dep from "./sub/generic_newtype_inherited_static_dep.wado";

struct Wrap<T> {
    v: T,
}

impl<T> Wrap<T> {
    fn id(v: T) -> T {
        return v;
    }

    fn make(v: T) -> Wrap<T> {
        return Wrap { v };
    }
}

type Same<T> = Wrap<T>;
type Listed<T> = Wrap<List<T>>;
type Chained<T> = Same<T>;

impl<T> Same<T> {
    fn raw(v: T) -> Wrap<T> {
        return Wrap { v };
    }
}

export fn run() with Stdout {
    let l: List<i32> = [1, 2];
    let a = Same::id(1);
    let b: Same<i32> = Same::make(2);
    let c = Listed::id(l);
    let d: Listed<i32> = Listed::make(l);
    let e = Listed::<_>::id(l);
    let f: Chained<i32> = Chained::make(3);
    let g: Wrap<i32> = Same::raw(4);
    let h: dep::Same<i32> = dep::Same::make(5);
    let i = dep::Listed::id(l);
    println(`${a} ${b.v} ${c.len()} ${d.v.len()} ${e.len()} ${f.v} ${g.v} ${h.v} ${i.len()}`);
}

__DATA__
{"stdout": "1 2 2 2 2 3 4 5 2\n"}
