// Generic newtypes (`type MyArray<T> = Array<T>`): the newtype inherits
// methods from the instantiated base type, accepts literal coercion via
// the annotation, supports mutation (`push`), and works across element
// types (i32, String). See docs/wep-2026-01-29-newtype-semantics.md.

use { println, Stdout } from "core:cli";

type MyArray<T> = Array<T>;

export fn run() with Stdout {
    // Create via type annotation (literal coercion)
    let arr: MyArray<i32> = [1, 2, 3];

    // Inherit Array methods
    println(`len: {arr.len()}`);
    println(`first: {arr[0]}`);

    // Mutable operations
    let mut arr2: MyArray<i32> = [10, 20];
    arr2.push(30);
    println(`after append: {arr2.len()}`);

    // Different element types
    let strs: MyArray<String> = ["hello", "world"];
    println(`strs: {strs.len()}`);
}

__DATA__
{"stdout": "len: 3\nfirst: 1\nafter append: 3\nstrs: 2\n"}
