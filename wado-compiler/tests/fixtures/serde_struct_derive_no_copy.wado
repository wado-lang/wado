// The derived struct deserializer moves each field out of the slot tuple. A
// `List` field parsed once must not be deep-copied on the way into the struct,
// so no `array_clone_deep_prefix` survives the deserializer.

use { DeserializeError } from "core:serde";
use { from_string } from "core:json";

struct Bag {
    tags: List<String>,
    id: i32,
}

test "a list field survives the slot round trip" {
    let back: Result<Bag, DeserializeError> = from_string("{\"tags\":[\"a\",\"b\"],\"id\":5}");
    if let Ok(v) = back {
        assert v.tags == ["a", "b"];
        assert v.id == 5;
    } else {
        assert false;
    }
}

test "a deserialized list is independent of a copy of it" {
    let back: Result<Bag, DeserializeError> = from_string("{\"tags\":[\"a\"],\"id\":1}");
    if let Ok(v) = back {
        let mut other = v.tags;
        other.push("b");
        assert v.tags.len() == 1;
        assert other.len() == 2;
    } else {
        assert false;
    }
}

__DATA__
{
    "test": {},
    "wir_not_expect:O2": ["array_clone_deep_prefix<ref \"core:prelude/string.wado//String\">"]
}
