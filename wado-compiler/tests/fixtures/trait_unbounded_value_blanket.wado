// A value blanket's receiver parameter carries at least one bound: an unbounded
// `impl<T> Describe for T` names no condition that could select it, so it is
// rejected where it is written.
//
// Today it is accepted and indexed as nothing, so the call reports the method as
// missing with no hint that the impl exists. The message below states what the
// check should say; it does not exist yet, so this fixture fails until it is
// written (WEP 2026-09-01, "Two definition-time checks are missing").

trait Describe {
    fn describe(&self) -> String;
}

struct Point {
    x: i32,
}

impl<T> Describe for T {
    fn describe(&self) -> String {
        return "blanket";
    }
}

export fn run() {
    let p = Point { x: 1 };
    assert p.describe() == "blanket";
}

__DATA__
{"compile_error": "a blanket impl's receiver type parameter needs a bound"}
