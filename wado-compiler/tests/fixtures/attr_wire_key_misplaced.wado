// A `#[wire]` key the declaration does not read is refused rather than dropped:
// a variant case has no number on the wire.

variant Shape {
    #[wire(number = 1)]
    Circle(f64),
}

export fn run() {}

__DATA__
{"compile_error": "`wire` takes no `number` on a variant case; there it takes `name`", "compile_error_codes": ["ATTR_MISUSE"]}
