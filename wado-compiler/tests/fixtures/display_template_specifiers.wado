// Test: Template string format specifiers `{x:spec}`
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // ============================================================
    // Basic Display (no specifier)
    // ============================================================
    let i = 42;
    assert `{i}` == "42";
    assert `{-1}` == "-1";
    let s = "hello";
    assert `{s}` == "hello";

    // ============================================================
    // Width and alignment
    // ============================================================
    // Right-aligned (default)
    assert `{i:10}` == "        42";
    // Left-aligned
    assert `{i:<10}` == "42        ";
    // Center-aligned
    assert `{i:^10}` == "    42    ";
    // Custom fill + align
    assert `{i:*^10}` == "****42****";
    assert `{i:0>8}` == "00000042";
    assert `{i:-<8}` == "42------";

    // ============================================================
    // Sign
    // ============================================================
    assert `{i:+}` == "+42";
    let neg = -42;
    assert `{neg:+}` == "-42";
    assert `{neg}` == "-42";

    // ============================================================
    // Zero-pad
    // ============================================================
    assert `{i:08}` == "00000042";
    assert `{neg:08}` == "-0000042";
    assert `{i:+08}` == "+0000042";

    // ============================================================
    // Binary format (b)
    // ============================================================
    assert `{i:b}` == "101010";
    let byte: u8 = 255;
    assert `{byte:b}` == "11111111";
    assert `{byte:#b}` == "0b11111111";
    assert `{i:08b}` == "00101010";
    assert `{i:#010b}` == "0b00101010";

    // ============================================================
    // Octal format (o)
    // ============================================================
    assert `{i:o}` == "52";
    let oct_val = 511;
    assert `{oct_val:o}` == "777";
    assert `{oct_val:#o}` == "0o777";

    // ============================================================
    // Hex format (x, X)
    // ============================================================
    assert `{i:x}` == "2a";
    assert `{i:X}` == "2A";
    let hex_val = 255;
    assert `{hex_val:x}` == "ff";
    assert `{hex_val:X}` == "FF";
    assert `{hex_val:#x}` == "0xff";
    assert `{hex_val:#X}` == "0XFF";
    assert `{hex_val:#010x}` == "0x000000ff";

    // ============================================================
    // u32 large values
    // ============================================================
    let u32_max: u32 = 4294967295;
    assert `{u32_max:x}` == "ffffffff";
    assert `{u32_max:b}` == "11111111111111111111111111111111";

    // ============================================================
    // i64 format
    // ============================================================
    let big_i64: i64 = 9223372036854775807;
    assert `{big_i64:x}` == "7fffffffffffffff";
    let neg_i64: i64 = -1;
    assert `{neg_i64}` == "-1";
    assert `{neg_i64:x}` == "-1";

    // ============================================================
    // u64 format
    // ============================================================
    let u64_max: u64 = 18446744073709551615;
    assert `{u64_max:x}` == "ffffffffffffffff";
    assert `{u64_max:X}` == "FFFFFFFFFFFFFFFF";
    assert `{u64_max:o}` == "1777777777777777777777";
    let u64_one: u64 = 1;
    assert `{u64_one:b}` == "1";
    assert `{u64_one:#x}` == "0x1";

    // ============================================================
    // i128 format
    // ============================================================
    let i128_val: i128 = 255;
    assert `{i128_val:x}` == "ff";
    assert `{i128_val:X}` == "FF";
    assert `{i128_val:b}` == "11111111";
    assert `{i128_val:o}` == "377";
    assert `{i128_val:#x}` == "0xff";

    let neg_i128: i128 = -1;
    assert `{neg_i128:x}` == "-1";
    assert `{neg_i128:b}` == "-1";

    // ============================================================
    // u128 format
    // ============================================================
    let u128_val: u128 = 256;
    assert `{u128_val:x}` == "100";
    assert `{u128_val:b}` == "100000000";
    assert `{u128_val:o}` == "400";
    assert `{u128_val:#X}` == "0X100";

    // ============================================================
    // Combined specifiers
    // ============================================================
    // Width + sign + zero-pad
    assert `{i:+010}` == "+000000042";
    // Width + base + alternate + zero-pad
    assert `{i:#010x}` == "0x0000002a";
    // Width + left-align + base
    assert `{i:<10x}` == "2a        ";
    // String with width
    assert `{s:>10}` == "     hello";
    assert `{s:<10}` == "hello     ";
    assert `{s:^10}` == "  hello   ";
    // Bool
    assert `{true}` == "true";
    assert `{false}` == "false";

    // ============================================================
    // Negative values with base formats
    // ============================================================
    let neg_i32 = -42;
    assert `{neg_i32:b}` == "-101010";
    assert `{neg_i32:o}` == "-52";
    assert `{neg_i32:x}` == "-2a";
    assert `{neg_i32:#x}` == "-0x2a";

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
