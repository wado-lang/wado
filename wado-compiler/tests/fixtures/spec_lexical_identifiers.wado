// An identifier is ASCII: `[a-zA-Z_][a-zA-Z0-9_]*`, except `_` alone.
// Identifiers are case-sensitive.

test {
    let foo = 1;
    let foo_bar = foo + 1;
    let fooBar = foo_bar + 1;
    let FooBar = fooBar + 1;
    let FOO_BAR = FooBar + 1;
    let _private = FOO_BAR + 1;
    let name123 = _private + 1;
    assert name123 == 7;
}
