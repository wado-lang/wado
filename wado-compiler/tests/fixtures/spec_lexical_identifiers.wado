// An identifier starts with an ASCII letter or `_`; later characters may be
// any Unicode letter or number. Identifiers are case-sensitive.

test {
    let foo = 1;
    let foo_bar = foo + 1;
    let fooBar = foo_bar + 1;
    let FooBar = fooBar + 1;
    let FOO_BAR = FooBar + 1;
    let _private = FOO_BAR + 1;
    let name123 = _private + 1;
    let café = name123 + 1;    // OK: `é` is not the first character
    assert café == 8;
}
