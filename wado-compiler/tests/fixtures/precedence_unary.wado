// Test unary operator precedence
// Unary operators (-, !, ~) have highest precedence

export fn run() {
    // Negation has higher precedence than binary operators
    // -3 + 5 = (-3) + 5 = 2
    let a = -3 + 5;
    assert a == 2;

    // -2 * 3 = (-2) * 3 = -6
    let b = -2 * 3;
    assert b == -6;

    // 10 - -3 = 10 - (-3) = 13
    let c = 10 - -3;
    assert c == 13;

    // Logical NOT has higher precedence than binary operators
    // !true || true = (!true) || true = false || true = true
    let d = !true || true;
    assert d == true;

    // !false && false = (!false) && false = true && false = false
    let e = !false && false;
    assert e == false;

    // Bitwise NOT has higher precedence than binary operators
    // For i32, ~0 = -1 (all bits set)
    // ~0 + 2 = (-1) + 2 = 1
    let f = ~0 + 2;
    assert f == 1;

    // ~1 & 3 = (-2) & 3 = ...11111110 & ...00000011 = 2
    let g = ~1 & 3;
    assert g == 2;

    // Multiple unary operators (right-to-left)
    // --5 = -(-5) = 5
    let h = - -5;
    assert h == 5;

    // !!true = !(!true) = !(false) = true
    let i = !!true;
    assert i == true;

    // !!false = !(!false) = !(true) = false
    let j = !!false;
    assert j == false;

    // ~~0 = ~(~0) = ~(-1) = 0
    let k = ~~0;
    assert k == 0;

    // Negation with comparison (integers only to avoid f64 issue)
    // -5 < 0 = (-5) < 0 = true
    let n = -5 < 0;
    assert n == true;

    // Logical NOT with comparison
    // !true == false = (!true) == false = false == false = true
    let o = !true == false;
    assert o == true;

    // Negation in complex expression
    // -2 + 3 * -4 = (-2) + (3 * (-4)) = -2 + (-12) = -14
    let p = -2 + 3 * -4;
    assert p == -14;
}

__DATA__
{}
