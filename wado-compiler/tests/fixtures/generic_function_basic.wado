// Test: Basic generic function with turbofish syntax
use { println, Stdout } from "core:cli";

fn identity<T>(x: T) -> T {
    return x;
}

fn run() with Stdout {
    let a = identity::<i32>(42);
    let b = identity::<i64>(100 as i64);
    println(`a: {a}`);
    println(`b: {b}`);
}

__DATA__
{"stdout": "a: 42\nb: 100\n"}
