// A call that names no trait arguments leaves a parameter only the trait
// reference names to inference.

trait Source<A> with () { fn first(&self) -> A; }
trait Tag<A> with () { fn tag(&self) -> A; }

struct Two { n: i32 }
impl Source<i32> for Two { fn first(&self) -> i32 { return self.n; } }
impl Source<String> for Two { fn first(&self) -> String { return `${self.n}`; } }

impl<A, T: Source<A>> Tag<A> for T {
    fn tag(&self) -> A { return self.first(); }
}

test {
    let two = Two { n: 7 };
    let n: i32 = two.tag();          // `A` is `i32`, so `Two: Source<i32>`
    let s: String = Tag::tag(&two);  // `A` is `String`
    assert n == 7 && s == "7";
    assert Tag::<i32>::tag(&two) == 7;
}
