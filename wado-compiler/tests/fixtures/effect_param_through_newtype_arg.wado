// An effect parameter named inside a generic newtype's argument is resolved
// through it, as through a generic struct's. Two instances of the newtype
// apart only in that row are one type to the type check and to `as`.

use { println, Stdout } from "core:cli";

struct Holder<F> {
    f: F,
}

type Hold<F> = Holder<F>;

fn hold<effect E>(f: fn() with E) -> Hold<fn() with E> {
    return Holder { f } as Hold<fn() with E>;
}

fn fire<effect E>(h: Hold<fn() with E>) with E {
    let inner = h as Holder<fn() with E>;
    let f = inner.f;
    f();
}

export fn run() with Stdout {
    fire(hold(|| println("fired")));
}

__DATA__
{
    "stdout": "fired\n"
}
