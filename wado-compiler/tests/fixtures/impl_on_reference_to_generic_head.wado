// An impl whose target is a reference to a generic head. Every such impl is
// filed under one receiver key, so the written arguments are what choose
// between them, and `&Wrap<i32>` and `&Wrap<bool>` reach their own.
//
// The target is read through the reference to the pointee's arguments, which
// is where the receiver supplies its own. Comparing the pointee whole instead
// is a nesting level off, and the solver then contradicts the binding.

trait Show with () {
    fn show(&self) -> i32;
}

struct Wrap<A> {
    a: A,
}

impl Show for &Wrap<i32> {
    fn show(&self) -> i32 {
        return 1;
    }
}

impl Show for &Wrap<bool> {
    fn show(&self) -> i32 {
        return 2;
    }
}

fn show_it<T: Show>(t: &T) -> i32 {
    return t.show();
}

test "an impl on a reference to a generic head" {
    let wi = Wrap { a: 7 };
    let wb = Wrap { a: true };
    let ri = &wi;
    let rb = &wb;
    assert show_it(&ri) == 1;
    assert show_it(&rb) == 2;
}

__DATA__
{"test": {}}
