use { println, Stdout } from "core:cli";

// from match_exhaustive_enum_ok.wado
enum Direction {
    North,
    South,
    East,
    West,
}

fn dir_name(d: Direction) -> String {
    return match d {
        North => "north",
        South => "south",
        East => "east",
        West => "west",
    };
}

// from match_exhaustive_wildcard_ok.wado
enum Color {
    Red,
    Green,
    Blue,
}

// from match_exhaustive_enum_ok.wado
fn match_exhaustive_enum_ok() with Stdout {
    println(dir_name(Direction::North));
    println(dir_name(Direction::West));
}

// from match_exhaustive_option_null_ok.wado
fn match_exhaustive_option_null_ok() with Stdout {
    let opt: Option<i32> = null;
    let val = match opt {
        Some(x) => x,
        null => 0,
    };
    println(`{val}`);
}

// from match_exhaustive_wildcard_ok.wado
fn match_exhaustive_wildcard_ok() with Stdout {
    let c = Color::Green;
    let name = match c {
        Red => "red",
        _ => "other",
    };
    println(name);
}

export fn run() with Stdout {
    match_exhaustive_enum_ok();
    match_exhaustive_option_null_ok();
    match_exhaustive_wildcard_ok();
}

__DATA__
{"stdout": "north\nwest\n0\nother\n"}
