// Test: a read offering more room than one Component Model copy may move
// (2^28 - 1 elements) reads what is there instead of trapping.
use { println, Stdout } from "core:cli";
use { Stdin } from "wasi:cli";

export fn run() with (Stdout, Stdin) {
    let [stdin_stream, _done] = Stdin::read_via_stream();
    let chunk = stdin_stream.read(1 << 28);
    stdin_stream.drop();
    println(`read ${chunk.items.len()} bytes`);
}

__DATA__
{"stdin": "ABCDE", "stdout": "read 5 bytes\n"}
