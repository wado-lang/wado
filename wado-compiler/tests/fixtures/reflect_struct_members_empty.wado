// A blanket `ReflectStruct` derivation instantiated for a fieldless struct: the
// generic `members()` resolver must yield an empty walk, matching the
// concrete `ReflectStruct::<Empty>::members()` — not a spurious "no Fields bound"
// error.

trait FieldCount {
    fn field_count(&self) -> i32;
}

impl<T: ReflectStruct<FieldTypes = [..F]>, ..F: Inspect> FieldCount for T {
    fn field_count(&self) -> i32 {
        let mut count = 0;
        for let f of ReflectStruct::<T>::members() {
            count += 1;
        }
        return count;
    }
}

struct Empty {}

struct Two {
    a: i32,
    b: i32,
}

test "blanket members() derive works for empty and non-empty structs" {
    assert (Empty {}).field_count() == 0;
    assert (Two { a: 1, b: 2 }).field_count() == 2;
}

__DATA__
{"test": {}}
