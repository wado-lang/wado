// Newtype formatting: `Display`/`DisplayAlt` render transparently like the base
// value, while `Inspect`/`InspectAlt` add the ` as Name` debug annotation.
// `DisplayAlt` reaches the base display by chaining `DisplayAlt → Display`.

type Meters = f64;
type Seconds = i32;
type Label = String;

struct FmtPoint {
    x: i32,
    y: i32,
}
type FmtPointAlias = FmtPoint;

test "display drops the inspect cast" {
    let m: Meters = 100.5;
    assert `{m}` == "100.5";
    assert `{m:?}` == "100.5 as Meters";
    assert m.to_string() == "100.5";

    let s: Seconds = 42;
    assert `{s}` == "42";
    assert `{s:?}` == "42 as Seconds";

    let l: Label = "wado";
    assert `{l}` == "wado";
    assert `{l:?}` == "\"wado\" as Label";
}

test "alternate display chains through display" {
    let m: Meters = 100.5;
    assert `{m:#}` == "100.5";
    assert `{m:#?}` == "100.5 as Meters";
}

test "newtype over struct stays transparent for display" {
    let p: FmtPointAlias = FmtPoint { x: 1, y: 2 } as FmtPointAlias;
    assert `{p}` == "FmtPoint { x: 1, y: 2 }";
    assert `{p:#}` == "FmtPoint { x: 1, y: 2 }";
    assert `{p:?}` == "FmtPoint { x: 1, y: 2 } as FmtPointAlias";
}

__DATA__
{"test": {}}
