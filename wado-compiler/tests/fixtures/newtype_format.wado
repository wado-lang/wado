// Newtype formatting: a newtype inherits its base type's `Display`, rendering
// transparently like the base value, while `Inspect`/`InspectAlt` add the
// ` as Name` debug annotation. `DisplayAlt` reaches the base display by chaining
// `DisplayAlt → Display`. A newtype over a non-`Display` base (a plain struct)
// is not displayable — only `Inspect` (`{x:?}`) applies.

type Meters = f64;
type Seconds = i32;
type Label = String;

struct FmtPoint {
    x: i32,
    y: i32,
}
type FmtPointAlias = FmtPoint;

test "display drops the inspect cast" {
    let m: Meters = 100.5;
    assert `${m}` == "100.5";
    assert `${m:?}` == "100.5 as Meters";
    assert m.to_string() == "100.5";

    let s: Seconds = 42;
    assert `${s}` == "42";
    assert `${s:?}` == "42 as Seconds";

    let l: Label = "wado";
    assert `${l}` == "wado";
    assert `${l:?}` == "\"wado\" as Label";
}

test "newtype inherits the base's alternate formats" {
    let m: Meters = 100.5;
    // `{m:#?}` is `InspectAlt` — a newtype overrides it with the ` as Name` tag.
    assert `${m:#?}` == "100.5 as Meters";
    // `{m:#}` is `DisplayAlt`, which the newtype *inherits* from `f64` — and
    // `f64` has no `DisplayAlt` (like `{3.14:#}`), so this would be a compile
    // error, consistent with the base type. Inheritance, not a bespoke shim.
}

test "newtype over a non-Display struct: only Inspect applies" {
    let p: FmtPointAlias = FmtPoint { x: 1, y: 2 } as FmtPointAlias;
    // `FmtPoint` has no `Display`, so `FmtPointAlias` inherits none — `{p}`
    // would be a compile error. Debug output still works via Inspect.
    assert `${p:?}` == "FmtPoint { x: 1, y: 2 } as FmtPointAlias";
}

__DATA__
{"test": {}}
