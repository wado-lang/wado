// Test chained static method calls
use { println, Stdout } from "core:cli";

struct Box<T> {
    value: T,
}

impl Box<T> {
    pub fn new(value: T) -> Box<T> {
        return Box { value };
    }

    pub fn get(&self) -> T {
        return self.value;
    }
}

struct Pair<T, U> {
    first: T,
    second: U,
}

impl Pair<T, U> {
    pub fn create(first: T, second: U) -> Pair<T, U> {
        return Pair { first, second };
    }

    pub fn get_first(&self) -> T {
        return self.first;
    }

    pub fn get_second(&self) -> U {
        return self.second;
    }
}

export fn run() with Stdout {
    // Chain: use result of Pair method as argument to Box constructor
    let p = Pair::<i32, i64>::create(10, 20 as i64);
    let boxed = Box::<i32>::new(p.get_first());
    println(`boxed first: {boxed.get()}`);

    // Chain: Box of Pair
    let pair = Pair::<i32, i32>::create(100, 200);
    let boxed_pair = Box::<Pair<i32, i32>>::new(pair);
    let inner_pair = boxed_pair.get();
    println(`inner first: {inner_pair.get_first()}`);
    println(`inner second: {inner_pair.get_second()}`);

    // Inline chained call
    let val = Box::<i32>::new(Pair::<i32, i32>::create(5, 10).get_second()).get();
    println(`chained result: {val}`);
}

__DATA__
{"stdout": "boxed first: 10\ninner first: 100\ninner second: 200\nchained result: 10\n"}
