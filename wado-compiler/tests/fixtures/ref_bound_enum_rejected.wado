// An `enum` is a scalar discriminant (`i32`), not a GC reference, so it does not
// satisfy `T: Ref`.

enum Dir {
    North,
    South,
}

fn accepts_ref<T: Ref>(x: &T) -> i32 {
    return 1;
}

test "unreachable" {
    let d = Dir::North;
    assert accepts_ref(&d) == 1;  // enum is not Ref
}

__DATA__
{
    "test": {},
    "compile_error": "does not implement trait 'Ref'"
}
