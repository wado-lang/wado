// LICM reaches loops nested under match/switch arms. The block walker recurses
// through every child block (match and switch arms, expression blocks), so
// `config.threshold` hoists out of the loop inside the `0 =>` arm: `probe`
// takes the config by `&`, so no call in the loop writes it.

use { println, Stdout } from "core:cli";

struct Config {
    threshold: i32,
    scale: i32,
}

#[inline(never)]
fn probe(c: &Config) -> i32 {
    return c.scale;
}

#[inline(never)]
fn accumulate(mode: i32, n: i32, configs: &List<Config>) -> i32 {
    let config = &configs[0];
    let mut sum = 0;
    match mode {
        0 => {
            for let mut i = 0; i < n; i += 1 {
                builtin::black_box(probe(config));
                sum += config.threshold * i;
            }
        },
        1 => { sum = config.scale; },
        2 => { sum = config.threshold + 1; },
        _ => { sum = -1; },
    }
    return sum;
}

export fn run() with Stdout {
    let n = builtin::black_box(5);
    let configs: List<Config> = [Config { threshold: builtin::black_box(100), scale: 2 }];
    let mode = builtin::black_box(0);
    println(`${accumulate(mode, n, &configs)}`);
    println(`${accumulate(mode + 1, n, &configs)}`);
    println(`${accumulate(mode + 2, n, &configs)}`);
    println(`${accumulate(mode + 9, n, &configs)}`);
}

__DATA__
{
    "stdout": "1000\n2\n101\n-1\n",
    "wir_scope": "accumulate",
    "wir_pass": {"O2": ["nir/licm"]},
    "wir_expect:O2": ["$licm_threshold"]
}
