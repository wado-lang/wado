// Coherence Rule 1 (WEP 2026-03-14 §5) is a rivalry between *impls*, so it
// holds when the trait method declares type params of its own: both
// `impl Tag for Box_<i32>` and `impl<T> Tag for Box_<T>` reach
// `Box_<i32>^Tag::tag<i32>`. The specific impl wins; the general template is
// not instantiated onto the name. This previously aborted the compile with a
// duplicate-function panic.

struct Box_<T> {
    v: T,
}

trait Tag {
    fn tag<U: Inspect>(&self, u: U) -> String;
}

impl<T> Tag for Box_<T> {
    fn tag<U: Inspect>(&self, u: U) -> String {
        return `generic ${u:?}`;
    }
}

impl Tag for Box_<i32> {
    fn tag<U: Inspect>(&self, u: U) -> String {
        return `concrete ${u:?}`;
    }
}

test "the impl for one instantiation wins even when the method is generic" {
    let boxed = Box_ { v: 1 };
    assert boxed.tag(7) == "concrete 7";
}

test "another instantiation still takes the generic impl" {
    let boxed = Box_ { v: "s" };
    assert boxed.tag(7) == "generic 7";
}

test "a concrete impl's own generic method still reaches every instantiation" {
    let boxed = Box_ { v: 1 };
    assert boxed.tag("x") == "concrete \"x\"";
}

__DATA__
{"test": {}}
