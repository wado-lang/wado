// `#data` / `#file` / `#line` compile-time location literals. `#function` is
// covered exhaustively (all function/method kinds, exact match) in the test
// world by `location_function`.

use { println, Stdout } from "core:cli";

fn test_data() with Stdout {
    println(#data);
}

fn test_data_template() with Stdout {
    let s = `data: {#data}`;
    println(s);
}

fn test_file() with Stdout {
    println(#file);
}

fn test_line() with Stdout {
    println(#line.to_string());
}

fn test_line_template() with Stdout {
    println(`line: {#line}`);
}

export fn run() with Stdout {
    test_data();
    test_data_template();
    test_file();
    test_line();
    test_line_template();
}

__DATA__
{"stdout_contains": ["LOCATION_DATA_MARKER", "data: ", "LOCATION_DATA_MARKER", "location_merged.wado"]}
