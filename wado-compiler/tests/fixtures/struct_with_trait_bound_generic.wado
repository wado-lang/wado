// Test: struct with trait-bounded generic field
// Checking if trait bounds affect type registration order

use { println, Stdout } from "core:cli";

trait Printable {
    fn to_string(&self) -> String;
}

impl Printable for i32 {
    fn to_string(&self) -> String {
        return `{*self}`;
    }
}

struct Wrapper<T: Printable> {
    value: T,
}

struct Container {
    wrapped: Wrapper<i32>,
}

fn run() with Stdout {
    let c = Container { wrapped: Wrapper { value: 42 } };
    println(`value: {c.wrapped.value}`);
}

__DATA__
{"stdout": "value: 42\n"}
