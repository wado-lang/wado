// A constant negative step is refused outright, no residual: `i` only falls,
// so no term read at the version point could carry the floor. The loop keeps
// its checks and reports the first index below zero.

use { println, Stdout } from "core:cli";

fn walk_down(xs: &mut List<i32>, limit: i32, start: i32) -> i32 {
    let mut sum = 0;
    for let mut r = 0; r < 2; r += 1 {
        for let mut i = start; i <= limit; i += -1 {
            xs[i] = 9;
        }
        for let mut n = 0; n <= limit; n += 1 {
            sum += xs[n];
        }
    }
    return sum;
}

export fn run() with Stdout {
    let mut xs = List::<i32>::filled(11, 0);
    println(`${walk_down(&mut xs, builtin::black_box(10), builtin::black_box(2))}`);
}

__DATA__
{
    "stderr_contains": [
        "Assertion failed in List::index_assign",
        "index out of bounds",
        "index: -1"
    ],
    "trapped": true
}
