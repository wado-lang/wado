use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Select with f64
    let a = 3.14;
    let b = 2.71;
    let max = if a > b { a } else { b };
    println(`{max}`);

    // Select with f64 literals
    let x = if true { 1.5 } else { 2.5 };
    println(`{x}`);
}

__DATA__
{"stdout": "3.14\n1.5\n"}
