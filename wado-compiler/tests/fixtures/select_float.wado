use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // f64 locals
    let a = 3.14;
    let b = 2.71;
    let max = if a > b { a } else { b };
    println(`{max}`);

    // f64 literals
    let x = if true { 1.5 } else { 2.5 };
    println(`{x}`);

    // f32 locals
    let a32 = 3.14 as f32;
    let b32 = 2.71 as f32;
    let max32 = if a32 > b32 { a32 } else { b32 };
    println(`{max32}`);

    // f32 literals
    let y = if false { 1.5 as f32 } else { 2.5 as f32 };
    println(`{y}`);
}

__DATA__
{"stdout": "3.14\n1.5\n3.14\n2.5\n"}
