// A share licenses one binding to alias the storage it was read out of. It says
// nothing about a second owner made from that binding, so the wrap site minting
// one still owes its copy. Without it, a write through the new owner lands in the
// place the first binding aliases.

struct Holder {
    xs: List<i32>,
}

struct Wrapper {
    inner: List<i32>,
}

struct Watch {
    xs: &List<i32>,
}

variant Held {
    Some(List<i32>),
    Empty,
}

impl Holder {
    fn peek(&self) -> List<i32> {
        return self.xs;
    }
}

fn watch(xs: &List<i32>) -> Watch with stores[xs] {
    return Watch { xs };
}

test "a let out of a place copies" {
    let mut h = Holder { xs: [1, 2] };
    let a = h.xs;
    let mut b = a;
    b.push(3);
    assert h.xs.len() == 2;
    assert a.len() == 2;
    assert b.len() == 3;
}

test "a struct literal out of a place copies" {
    let mut h = Holder { xs: [1, 2] };
    let a = h.xs;
    let mut w = Wrapper { inner: a };
    w.inner.push(3);
    assert h.xs.len() == 2;
    assert a.len() == 2;
    assert w.inner.len() == 3;
}

test "an arm binding read again inside the arm is not moved out from under it" {
    let held = Held::Some([1, 2]);
    if let Some(v) = held {
        let mut w = v;
        w.push(3);
        if let Some(again) = held {
            assert again.len() == 2;
        }
        assert w.len() == 3;
    }
}

test "a released share still copies where the binding is read again" {
    let mut h = Holder { xs: [1, 2] };
    let a = h.xs;
    h.xs = [];
    let mut b = a;
    b.push(3);
    assert a.len() == 2;
    assert b.len() == 3;
}

test "a release does not travel to a chain whose root is read again" {
    let mut h = Holder { xs: [1, 2] };
    let a = h.xs;
    let c = a;
    h.xs = [];
    let mut b = c;
    b.push(3);
    assert a.len() == 2;
    assert b.len() == 3;
    assert h.xs.len() == 0;
}

test "a released share does not outrun a stored borrow" {
    let h = Holder { xs: [1, 2] };
    let mut b = h.peek();
    let w = watch(&b);
    let s = b;
    b = [];
    let mut c = s;
    c.push(3);
    assert w.xs.len() == 2;
    assert c.len() == 3;
}

test "a released share does not outrun a reference local" {
    let h = Holder { xs: [1, 2] };
    let mut b = h.peek();
    let r = &b;
    let s = b;
    b = [];
    let mut c = s;
    c.push(3);
    assert r.len() == 2;
    assert c.len() == 3;
}

__DATA__
{"test": {}}
