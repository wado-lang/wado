// A nested block may reuse a label; a `break` targets the innermost one. The
// inner block here is in statement position, which used to keep no break-type
// frame: its valueless `break blk` was attributed to the outer block
// *expression* instead, which then rejected its own `i32` value as `()`.

test "an inner block of the same name catches its own break" {
    let c = builtin::black_box(true);
    let mut inner_ran = 0;
    let v = blk: {
        blk: {
            if c {
                break blk;
            }
            inner_ran = 1;
        }
        break blk: 42;
    };
    assert v == 42;
    assert inner_ran == 0;
}

test "the inner block runs on to its end when no break is taken" {
    let c = builtin::black_box(false);
    let mut inner_ran = 0;
    let v = blk: {
        blk: {
            if c {
                break blk;
            }
            inner_ran = 1;
        }
        break blk: 42;
    };
    assert v == 42;
    assert inner_ran == 1;
}

__DATA__
{"test": {}}
