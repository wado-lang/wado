// Test: ? operator on Result<(), E> where Ok value is unit.
// The unit-typed local from ? expansion must not cause issues.
use { println, Stdout } from "core:cli";

fn may_fail() -> Result<(), String> {
    return Result::<(), String>::Ok(());
}

fn caller() -> Result<(), String> {
    may_fail()?;
    may_fail()?;
    return Result::<(), String>::Ok(());
}

export fn run() with Stdout {
    let result = caller();
    if let Ok(_) = result {
        println("ok");
    }
}

__DATA__
{"stdout": "ok\n"}
