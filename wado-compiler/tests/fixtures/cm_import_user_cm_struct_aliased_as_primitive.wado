// A `#[cm]` record imported under a primitive's name is still the record: the
// import takes `opts`, not a `u32`.
use { Opts as u32 } from "./sub/cm_import_user_cm_struct_dep.wado";

interface Gfx {
    #[cm("wasi:demo/gfx@0.1.0#get-count")]
    fn get_count(x: u32) -> i32;
}

export fn run() with Gfx {
    let _ = Gfx::get_count(u32 { v: 1 });
}

