// An `_` between two digits separates them and changes no value, in every
// base and on either side of a decimal point or an exponent's sign.

test {
    assert 1_000 == 1000;
    assert 0xFF_FF == 65535;
    assert 1_0.2_5 == 10.25;
    assert 0x1_f32 == 0x1F32;
    assert 0b1_0 == 2;
    assert 0o1_7 == 15;
    assert 1.5e0_1 == 15.0;
}

