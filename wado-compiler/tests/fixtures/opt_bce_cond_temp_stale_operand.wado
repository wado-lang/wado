// A condition held in a temporary is the value it had when bound. `c` records
// `1 < 3`, then `i` moves to 5, so `c` proves nothing about `arr[i]`: the index
// must still be checked and panic, not read a stale slot of the capacity.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn build() -> List<i32> {
    let mut arr: List<i32> = List::with_capacity(16);
    arr.push(10);
    arr.push(20);
    arr.push(30);
    return arr;
}

#[inline(never)]
fn at_moved(arr: &List<i32>, j: i32) -> i32 {
    let mut i = j;
    let c = i < arr.len();
    i = i + 4;
    if c {
        return arr[i];
    }
    return -1;
}

export fn run() with Stdout {
    let arr = build();
    println(`${at_moved(&arr, builtin::black_box(1))}`);
}

__DATA__
{"stderr_contains": ["index out of bounds"], "trapped": true}
