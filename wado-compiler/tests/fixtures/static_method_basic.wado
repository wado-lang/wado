// Basic static method test - non-generic type
use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

impl Point {
    fn origin() -> Point {
        // Static method (no self parameter)

        return Point { x: 0, y: 0 };
    }

    fn sum(&self) -> i32 {
        // Instance method for comparison

        return self.x + self.y;
    }
}

export fn run() with Stdout {
    let p = Point::origin();
    println(`origin: ({p.x}, {p.y})`);
    println(`sum: {p.sum()}`);
}

__DATA__
{"stdout": "origin: (0, 0)\nsum: 0\n"}
