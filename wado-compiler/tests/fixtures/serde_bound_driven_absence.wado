// Regression: bound-driven Serialize synthesis is genuinely on-demand — a
// declared type never passed to a serializer must not get a synthesized
// impl at all. `serde_bound_driven.wado` only exercises the positive
// (used) case; without this, a regression back to unconditional synthesis
// would pass every serde test in this suite silently.
use { to_string } from "core:json";

struct UsedForSerialize {
    x: i32,
}

struct NotUsedAtAll {
    y: i32,
}

export fn run() {
    let a = UsedForSerialize { x: 1 };
    let _ = to_string(&a);

    let _unused = NotUsedAtAll { y: 2 };
}

__DATA__
{
    "wir_expect:O0": ["UsedForSerialize^Serialize::serialize"],
    "wir_not_expect:O0": ["NotUsedAtAll^Serialize::serialize", "NotUsedAtAll^Deserialize::deserialize"]
}
