// `array.new_data` promotion is a size trade, not a free win: a data segment
// stores every element at its full width, while an `array.new_fixed` operand is
// LEB128-compressed. Promoting a `List<i32>` of small values therefore *grows*
// the module — 4 packed bytes against 3 inline — and, since `array.new_data` is
// not a Wasm constant instruction, also demotes a global that would have become
// an eager constant into a runtime-initialized one.
//
// `small` stays on the fixed path; `big`, whose values need a four-byte LEB,
// takes the promotion. Both are past `ARRAY_NEW_DATA_THRESHOLD`, so the element
// count alone cannot tell them apart.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let small: List<i32> = [100, 101, 102, 103, 104, 105, 106, 107, 108, 109, 110, 111, 112, 113, 114, 115, 116, 117, 118, 119, 120, 121, 122, 123, 124, 125, 126, 127, 128, 129, 130, 131, 132, 133, 134, 135, 136, 137, 138, 139, 140, 141, 142, 143, 144, 145, 146, 147, 148, 149, 150, 151, 152, 153, 154, 155, 156, 157, 158, 159, 160, 161, 162, 163, 164, 165, 166, 167, 168, 169, 170, 171, 172, 173, 174, 175, 176, 177, 178, 179, 180, 181, 182, 183, 184, 185, 186, 187, 188, 189, 190, 191, 192, 193, 194, 195, 196, 197, 198, 199, 200, 201, 202, 203, 204, 205, 206, 207, 208, 209, 210, 211, 212, 213, 214, 215, 216, 217, 218, 219, 220, 221, 222, 223, 224, 225, 226, 227, 228, 229, 230, 231, 232, 233, 234, 235, 236, 237, 238, 239, 240, 241, 242, 243, 244, 245, 246, 247, 248, 249];
    let big: List<i32> = [3000000, 3000001, 3000002, 3000003, 3000004, 3000005, 3000006, 3000007, 3000008, 3000009, 3000010, 3000011, 3000012, 3000013, 3000014, 3000015, 3000016, 3000017, 3000018, 3000019, 3000020, 3000021, 3000022, 3000023, 3000024, 3000025, 3000026, 3000027, 3000028, 3000029, 3000030, 3000031, 3000032, 3000033, 3000034, 3000035, 3000036, 3000037, 3000038, 3000039, 3000040, 3000041, 3000042, 3000043, 3000044, 3000045, 3000046, 3000047, 3000048, 3000049, 3000050, 3000051, 3000052, 3000053, 3000054, 3000055, 3000056, 3000057, 3000058, 3000059, 3000060, 3000061, 3000062, 3000063, 3000064, 3000065, 3000066, 3000067, 3000068, 3000069, 3000070, 3000071, 3000072, 3000073, 3000074, 3000075, 3000076, 3000077, 3000078, 3000079, 3000080, 3000081, 3000082, 3000083, 3000084, 3000085, 3000086, 3000087, 3000088, 3000089, 3000090, 3000091, 3000092, 3000093, 3000094, 3000095, 3000096, 3000097, 3000098, 3000099, 3000100, 3000101, 3000102, 3000103, 3000104, 3000105, 3000106, 3000107, 3000108, 3000109, 3000110, 3000111, 3000112, 3000113, 3000114, 3000115, 3000116, 3000117, 3000118, 3000119, 3000120, 3000121, 3000122, 3000123, 3000124, 3000125, 3000126, 3000127, 3000128, 3000129, 3000130, 3000131, 3000132, 3000133, 3000134, 3000135, 3000136, 3000137, 3000138, 3000139, 3000140, 3000141, 3000142, 3000143, 3000144, 3000145, 3000146, 3000147, 3000148, 3000149];
    println(`${small[builtin::black_box(3)]} ${big[builtin::black_box(3)]}`);
}

__DATA__
{
    "stdout": "103 3000003\n",
    "wir_expect:O2": ["array.new_fixed<i32>(100, 101, 102"],
    "wir_not_expect:O2": ["array.new_fixed<i32>(3000000, 3000001"]
}
