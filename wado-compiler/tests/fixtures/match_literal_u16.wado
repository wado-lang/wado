// Test match expression with u16 literal patterns

use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let x: u16 = 42 as u16;
    let y: u16 = 0 as u16;
    let large: u16 = 65535 as u16;

    let r1 = match x {
        0 => "zero",
        42 => "answer",
        _ => "other",
    };

    println(r1);

    let r2 = match y {
        0 => "zero",
        _ => "other",
    };

    println(r2);

    let r3 = match large {
        0 => "zero",
        65535 => "max u16",
        _ => "other",
    };

    println(r3);
}

__DATA__
{"stdout": "answer\nzero\nmax u16\n"}
