// Test: `core:cli::exit(255)` passes the full `u8` range through to the host
// exit code without truncation.
use { println, exit, Exit } from "core:cli";

export fn run() with Stdout, Exit {
    println("before");
    exit(255);
}

__DATA__
{
    "stdout": "before\n",
    "exit_code": 255,
    "trapped": false
}
