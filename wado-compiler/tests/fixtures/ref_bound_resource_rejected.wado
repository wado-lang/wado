// A `resource` handle lowers to `i32` (an index into the CM handle table), not a
// Wasm GC reference, so it does not satisfy `T: Ref`. See WEP 2026-01-20.

pub resource Counter {
    fn bump(&self);
}

fn accepts_ref<T: Ref>(x: &T) -> i32 {
    return 1;
}

fn use_it(c: &Counter) -> i32 {
    return accepts_ref(c);  // Counter is a resource handle, not Ref
}

test "unreachable" {
    assert true;
}

__DATA__
{
    "test": {},
    "compile_error": "does not implement trait 'Ref'"
}
