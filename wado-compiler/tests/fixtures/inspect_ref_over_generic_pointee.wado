// A reference whose pointee mentions a type parameter keeps its `&` when
// debug-formatted, as it does in non-generic code, and the instance formats the
// substituted pointee.

use { println, Stdout } from "core:cli";

struct Box<T> { v: T }

type Bag<T> = List<T>;

fn show_box<T: Inspect>(b: &Box<T>) -> String {
    return `${b:?}`;
}

fn show_option<T: Inspect>(o: Option<T>) -> String {
    let r = &o;
    return `${r:?}`;
}

fn show_list<T: Inspect>(xs: &List<T>) -> String {
    return `${xs:?}`;
}

fn show_bag<T: Inspect>(v: T) -> String {
    let b: Bag<T> = [v];
    let r = &b;
    return `${r:?}`;
}

export fn run() with Stdout {
    let xs: List<i32> = [1];
    let rx = &xs;
    println(show_box(&Box { v: 1 }));
    println(show_option(Option::Some(2)));
    println(`${show_list(&xs)} ${rx:?}`);
    println(show_bag(3));
}

__DATA__
{"stdout": "&Box { v: 1 }\n&Option::Some(2)\n&[1] &[1]\n&[3] as Bag\n"}
