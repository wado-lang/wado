// Test labeled block expression with break value
// Returns a value via `break label: expr;`

use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let x = foo: {
        for let item of [5, 6, 7] as Array<i32> {
            if item % 2 == 0 {
                break foo: item;
            }
        }
        break foo: -1;
    };


    // fallback if no even number found

    println(`x={x}`);
}

__DATA__
{"stdout": "x=6\n"}
