// Test that C-style for loop variable `i` itself has per-iteration binding
// Directly capture the loop counter without intermediate variable
use { println, Stdout } from "core:cli";

fn call_fn(f: fn(i32) -> i32, x: i32) -> i32 {
    return f(x);
}

fn run() with Stdout {
    let mut closures: Array<fn(i32) -> i32> = [];

    // Directly capture the loop variable i
    for let mut i = 0; i < 5; i += 1 {
        let get_i = |_: i32| i;
        closures.append(get_i);
    }

    // Call closures after the loop
    // Each should return its iteration's value of i
    let r0 = call_fn(closures[0], 0);
    let r1 = call_fn(closures[1], 0);
    let r2 = call_fn(closures[2], 0);
    let r3 = call_fn(closures[3], 0);
    let r4 = call_fn(closures[4], 0);

    println(`{r0},{r1},{r2},{r3},{r4}`);
}

__DATA__
{"stdout": "0,1,2,3,4\n"}
