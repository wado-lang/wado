// Test: iterate over Array<Array<i32>> elements and access them
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let matrix: Array<Array<i32>> = [[10, 20], [30, 40]];

    // Index access on nested array
    let first_row = matrix[0];
    println(`{first_row[0]}`);

    // For-of iteration over nested array
    let mut buf = "";
    for let row of matrix {
        for let val of row {
            buf = String::concat(buf, `{val} `);
        }
        buf = String::concat(buf, "\n");
    }
    println(buf);

    println("ok");
}

__DATA__
{"stdout": "10\n10 20 \n30 40 \n\nok\n"}
