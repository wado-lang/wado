// A defaulted type parameter stands in when the declaration checks an
// operation's default: `T` is `i32` here, so `0` is a value it admits.

#[cm("web:demo/buf", type = "extern-handle")]
resource Buf<T = i32> {
    #[cm("web:demo/buf#put")]
    #[cm_params("self", "v")]
    fn put(&self, v: T = 0);
}

export fn run() {}

__DATA__
{
    "stdout": ""
}
