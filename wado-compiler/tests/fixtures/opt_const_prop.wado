// Test constant propagation optimization
// Immutable globals with constant initializers should be inlined at use sites
use { println, Stdout } from "core:cli";

global X: i32 = 10;
global Y: i32 = 20;
global PI_APPROX: f64 = 3.14;
global ENABLED: bool = true;
global mut COUNTER: i32 = 0;

export fn run() with Stdout {
    // These should be propagated to literals
    let a = X + Y;
    println(`a={a}`);

    let b = PI_APPROX;
    println(`b={b}`);

    let c = ENABLED;
    println(`c={c}`);

    // Mutable global should NOT be propagated
    COUNTER = COUNTER + 1;
    println(`COUNTER={COUNTER}`);
}

__DATA__
{"stdout": "a=30\nb=3.14\nc=true\nCOUNTER=1\n"}
