// A trait's methods are candidates only where its declaration is in scope. The
// module below imports the receiver type and never names `Loud`, so `.shout()`
// must not resolve — today it does, because an impl reaches every receiver once
// its module is loaded.
//
// Lookup still searches outside the scope, for the message alone: it names the
// trait that would have answered and the import that would enable it
// (WEP 2026-09-01, "Scope is decided and not implemented").

use { Speaker } from "./sub/trait_scope_lib.wado";

export fn run() {
    let s = Speaker { id: 3 };
    assert s.shout() == "speaker:3";
}

