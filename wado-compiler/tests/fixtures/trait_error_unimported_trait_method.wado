// A trait's methods are candidates only where its declaration is in scope. The
// module below imports the receiver type and never names `Loud`, so `.shout()`
// does not resolve; the impl that would have answered names the trait the
// message asks to import (WEP 2026-09-01, "Scope").

use { Speaker } from "./sub/trait_scope_lib.wado";

export fn run() {
    let s = Speaker { id: 3 };
    assert s.shout() == "speaker:3";
}

