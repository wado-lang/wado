// Test: full JSON serializer integration — complete serde pipeline
// Combines all traits: Serialize, Serializer, SerializeSeq, SerializeStruct, SerializeVariant
use { println, Stdout } from "core:cli";

// Error type
struct SerializeError {
    message: String,
}

// Core trait
trait Serialize {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError>;
}

// Sub-serializer traits
trait SerializeSeq {
    fn element<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError>;
    fn end(&mut self) -> Result<(), SerializeError>;
}

trait SerializeStruct {
    fn field<T: Serialize>(&mut self, name: &String, value: &T) -> Result<(), SerializeError>;
    fn end(&mut self) -> Result<(), SerializeError>;
}

// Serializer trait
trait Serializer {
    type SeqSerializer: SerializeSeq;
    type StructSerializer: SerializeStruct;

    fn serialize_i32(&mut self, v: i32) -> Result<(), SerializeError>;
    fn serialize_f64(&mut self, v: f64) -> Result<(), SerializeError>;
    fn serialize_bool(&mut self, v: bool) -> Result<(), SerializeError>;
    fn serialize_string(&mut self, v: &String) -> Result<(), SerializeError>;
    fn serialize_null(&mut self) -> Result<(), SerializeError>;
    fn begin_seq(&mut self, len: i32) -> Result<Self::SeqSerializer, SerializeError>;
    fn begin_struct(&mut self, name: &String, fields: i32) -> Result<Self::StructSerializer, SerializeError>;
}

// JSON serializer implementation
struct JsonWriter {
    buf: String,
}

impl JsonWriter {
    fn write(&mut self, s: &String) {
        self.buf.push_str(*s);
    }
}

// `w: &mut JsonWriter` so writes from sub-serializers flow back to the
// outer instance. A value-typed `w: JsonWriter` field would deep-copy
// on construction, and the previous `self.w = ser.w` save-back trick
// (still in older revisions of this fixture) doesn't recover what
// happens between `let mut ser = ... { w: self.w }` and the
// re-assignment because the `String` inside the copy is itself a
// fresh allocation.
struct JsonSerializer {
    w: &mut JsonWriter,
}

struct JsonSeqSerializer {
    w: &mut JsonWriter,
    count: i32,
}

struct JsonStructSerializer {
    w: &mut JsonWriter,
    count: i32,
}

impl Serializer for JsonSerializer {
    type SeqSerializer = JsonSeqSerializer;
    type StructSerializer = JsonStructSerializer;

    fn serialize_i32(&mut self, v: i32) -> Result<(), SerializeError> {
        self.w.write(&`{v}`);
        return Result::<(), SerializeError>::Ok(());
    }

    fn serialize_f64(&mut self, v: f64) -> Result<(), SerializeError> {
        self.w.write(&`{v}`);
        return Result::<(), SerializeError>::Ok(());
    }

    fn serialize_bool(&mut self, v: bool) -> Result<(), SerializeError> {
        if v {
            self.w.write(&"true");
        } else {
            self.w.write(&"false");
        }
        return Result::<(), SerializeError>::Ok(());
    }

    fn serialize_string(&mut self, v: &String) -> Result<(), SerializeError> {
        self.w.write(&`"{*v}"`);
        return Result::<(), SerializeError>::Ok(());
    }

    fn serialize_null(&mut self) -> Result<(), SerializeError> {
        self.w.write(&"null");
        return Result::<(), SerializeError>::Ok(());
    }

    fn begin_seq(&mut self, len: i32) -> Result<JsonSeqSerializer, SerializeError> with stores[self] {
        self.w.write(&"[");
        return Result::<JsonSeqSerializer, SerializeError>::Ok(JsonSeqSerializer {
            w: self.w,
            count: 0,
        });
    }

    fn begin_struct(&mut self, name: &String, fields: i32) -> Result<JsonStructSerializer, SerializeError> with stores[self] {
        self.w.write(&"{");
        return Result::<JsonStructSerializer, SerializeError>::Ok(JsonStructSerializer {
            w: self.w,
            count: 0,
        });
    }
}

impl SerializeSeq for JsonSeqSerializer {
    fn element<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.w.write(&",");
        }
        let mut ser = JsonSerializer { w: self.w };
        value.serialize::<JsonSerializer>(&mut ser);
        self.count += 1;
        return Result::<(), SerializeError>::Ok(());
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.w.write(&"]");
        return Result::<(), SerializeError>::Ok(());
    }
}

impl SerializeStruct for JsonStructSerializer {
    fn field<T: Serialize>(&mut self, name: &String, value: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.w.write(&",");
        }
        self.w.write(&`"{*name}":`);
        let mut ser = JsonSerializer { w: self.w };
        value.serialize::<JsonSerializer>(&mut ser);
        self.count += 1;
        return Result::<(), SerializeError>::Ok(());
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.w.write(&"}");
        return Result::<(), SerializeError>::Ok(());
    }
}

// Primitive Serialize impls
impl Serialize for i32 {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_i32(*self);
    }
}

impl Serialize for f64 {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_f64(*self);
    }
}

impl Serialize for bool {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_bool(*self);
    }
}

impl Serialize for String {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_string(self);
    }
}

// Option<T: Serialize>
impl<T: Serialize> Serialize for Option<T> {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        if let Some(v) = self {
            return v.serialize::<S>(s);
        }
        return s.serialize_null();
    }
}

// Array<T: Serialize>
impl<T: Serialize> Serialize for Array<T> {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let mut seq = s.begin_seq(self.len());
        if let Ok(mut seq) = seq {
            for let item of *self {
                seq.element::<T>(&item);
            }
            return seq.end();
        }
        return Result::<(), SerializeError>::Err(SerializeError { message: "begin_seq failed" });
    }
}

// User-defined types
struct Point {
    x: f64,
    y: f64,
}

impl Serialize for Point {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let mut st = s.begin_struct("Point", 2);
        if let Ok(mut st) = st {
            st.field::<f64>("x", &self.x);
            st.field::<f64>("y", &self.y);
            return st.end();
        }
        return Result::<(), SerializeError>::Err(SerializeError { message: "begin_struct failed" });
    }
}

struct User {
    name: String,
    age: i32,
    active: bool,
    location: Option<Point>,
    tags: Array<String>,
}

impl Serialize for User {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let mut st = s.begin_struct("User", 5);
        if let Ok(mut st) = st {
            st.field::<String>("name", &self.name);
            st.field::<i32>("age", &self.age);
            st.field::<bool>("active", &self.active);
            st.field::<Option<Point>>("location", &self.location);
            st.field::<Array<String>>("tags", &self.tags);
            return st.end();
        }
        return Result::<(), SerializeError>::Err(SerializeError { message: "begin_struct failed" });
    }
}

// Helper: serialize to JSON string
fn to_json<T: Serialize>(value: &T) -> String {
    let mut writer = JsonWriter { buf: "" };
    let mut ser = JsonSerializer { w: &mut writer };
    value.serialize::<JsonSerializer>(&mut ser);
    return writer.buf;
}

export fn run() with Stdout {
    // Test primitives
    let n = 42;
    println(to_json::<i32>(&n));

    let s = "hello";
    println(to_json::<String>(&s));

    // Test struct
    let point = Point { x: 1.5, y: 2.5 };
    println(to_json::<Point>(&point));

    // Test nested struct with all types
    let user = User {
        name: "Alice",
        age: 30,
        active: true,
        location: Option::<Point>::Some(Point { x: 10.0, y: 20.0 }),
        tags: ["admin", "user"],
    };
    println(to_json::<User>(&user));

    // Test null location
    let user2 = User {
        name: "Bob",
        age: 25,
        active: false,
        location: null,
        tags: [],
    };
    println(to_json::<User>(&user2));
}

__DATA__
{"stdout": "42\n\"hello\"\n{\"x\":1.5,\"y\":2.5}\n{\"name\":\"Alice\",\"age\":30,\"active\":true,\"location\":{\"x\":10,\"y\":20},\"tags\":[\"admin\",\"user\"]}\n{\"name\":\"Bob\",\"age\":25,\"active\":false,\"location\":null,\"tags\":[]}\n"}
