// A `_` in a turbofish is settled by the type the site expects before the
// arguments are typed, so a literal under it takes that type, not its default.

struct Bx<T> {
    v: T,
}

fn id<T>(x: T) -> T {
    return x;
}

test "a call" {
    let o: Option<i64> = id::<Option<_>>(Some(5_000_000_000));
    assert o.unwrap() == 5_000_000_000;
}

test "a whole slot" {
    let n: i64 = id::<_>(5_000_000_000);
    let o: Option<Option<i64>> = Option::Some::<_>(null);
    assert n == 5_000_000_000 && o matches { Some(null) };
}

impl<T> Bx<T> {
    fn make(v: T) -> Bx<T> {
        return Bx { v };
    }

    fn empty() -> Bx<Option<T>> {
        return Bx { v: null };
    }
}

test "a path" {
    let b: Bx<List<i64>> = Bx::<List<_>>::make([5_000_000_000]);
    let e: Bx<Option<List<i64>>> = Bx::<List<_>>::empty();
    let n: Option<List<i64>> = Option::<List<_>>::None;
    assert b.v[0] == 5_000_000_000 && e.v == null && n == null;
}

test "a struct literal" {
    let b: Bx<i64> = Bx::<_> { v: 5_000_000_000 };
    let c: Bx<List<i64>> = Bx::<List<_>> { v: [5_000_000_000] };
    assert b.v == 5_000_000_000 && c.v[0] == 5_000_000_000;
}

test "a written `!`" {
    let n: Bx<Option<!>> = Bx::<Option<_>> { v: null };
    assert n.v == null;
}
