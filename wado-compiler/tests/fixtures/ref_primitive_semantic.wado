// Test that reference semantics work (not just value copy)

use { println, Stdout } from "core:cli";

fn get_and_modify(x: &mut i32) -> i32 {
    let original = *x;
    *x = 999;
    return original;
}

fn run() with Stdout {
    let mut a = 42;
    let result = get_and_modify(&mut a);
    println(`original={result}`);
    println(`modified={a}`);  // Should be 999 if true reference semantics
}

__DATA__
{"stdout": "original=42\nmodified=999\n"}
