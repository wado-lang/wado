// Test: `core:cli::exit_error()` exits with status code 1.
//
// It wraps `wasi:cli/exit#exit(Err(()))`, whose host mapping is `Err(()) -> 1`.
// Like `exit_success`, this exercises the unit-payload `Result<(), ()>`
// CM-lowering path that currently ICEs ("unresolved Call: name=\"Err\"").
use { println, Stdout } from "core:cli";
use { exit_error, Exit } from "core:cli";

export fn run() with Stdout, Exit {
    println("before");
    exit_error();
}

__DATA__
{
    "stdout": "before\n",
    "exit_code": 1,
    "trapped": false
}
