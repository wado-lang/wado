// exit_error wraps Exit::exit(Err(())); the host maps Err(()) to 1.
use { println, Stdout } from "core:cli";
use { exit_error, Exit } from "core:cli";

export fn run() with Stdout, Exit {
    println("before");
    exit_error();
}

__DATA__
{
    "stdout": "before\n",
    "exit_code": 1,
    "trapped": false
}
