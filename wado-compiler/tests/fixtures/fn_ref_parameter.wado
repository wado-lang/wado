// Function references as parameters: &fn type and &named_function syntax

fn apply(f: &fn(i32) -> i32, x: i32) -> i32 {
    return f(x);
}

fn double(n: i32) -> i32 {
    return n * 2;
}

test "function reference parameter" {
    let result = apply(&double, 21);
    assert result == 42;
}

__DATA__
{"test": {}}
