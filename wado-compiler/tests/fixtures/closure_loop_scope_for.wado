// Test that C-style for loop variables are captured correctly per iteration
// Each closure captures its own iteration's value of i
use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let mut results: Array<i32> = [];

    for let mut i = 0; i < 5; i += 1 {
        // Create closure that captures i
        let get_i = |_: i32| i;

        // Call it and store result
        results.append(get_i(0));
    }

    // Verify each closure captured its iteration's value
    println(`{results[0]},{results[1]},{results[2]},{results[3]},{results[4]}`);
}

__DATA__
{"stdout": "0,1,2,3,4\n"}
