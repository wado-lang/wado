// TreeMap literal: string values
use { println } from "core:cli";
use { TreeMap } from "core:collections";

export fn run() with Stdout {
    let colors: TreeMap<String, String> = {
        red: "#FF0000",
        green: "#00FF00",
        blue: "#0000FF",
    };

    assert colors.len() == 3;

    if let Some(r) = colors["red"] {
        assert r == "#FF0000";
    } else {
        assert false, "red not found";
    }

    if let Some(g) = colors["green"] {
        assert g == "#00FF00";
    } else {
        assert false, "green not found";
    }

    if let Some(b) = colors["blue"] {
        assert b == "#0000FF";
    } else {
        assert false, "blue not found";
    }

    println("string values: ok");
}

__DATA__
{"stdout": "string values: ok\n"}
