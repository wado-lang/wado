// A default argument's expression belongs to the module that wrote it, so a
// caller omitting the argument need not import what the expression names.
// Here `process`'s default is `&Ctx::new()` and this module imports only
// `process` — `Ctx` is reached through the *declaring* module's scope.
//
// Before the fix this compiled only because a name that reached nothing fell
// through to a whole-program unique-name lookup, so it broke the moment a
// second `Ctx` existed anywhere in the program. The second declaration below
// pins that: the derivation must answer from `process`'s module, not from the
// name being unique.

use { process } from "./sub/default_arg_unimported_type_lib.wado";

struct Ctx { count: i32 }

export fn run() {
    assert process() == 7;
    let mine = Ctx { count: 1 };
    assert mine.count == 1;
}

__DATA__
{"stdout": ""}
