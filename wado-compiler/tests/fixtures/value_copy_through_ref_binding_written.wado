// A binding read through a reference shares the referent only while nothing
// may write it. Each function here writes the referent while the binding is
// still read: through an aliasing `&mut` parameter, through a callee writing a
// global the reference points into, through a closure, through a callee
// running a closure it is handed, through a callee writing a reference held
// in its `&mut` argument, through a reference an `if` picks, which names no
// place, and through a write to the global, so each copies.

use { println, Stdout } from "core:cli";

struct Rec {
    name: String,
}

global mut HELD: Rec = Rec { name: "g" };

#[inline(never)]
fn through_alias(base: &Rec, other: &mut Rec) -> String {
    let r = *base;
    other.name.push_str("!");
    return r.name;
}

#[inline(never)]
fn touch_global() {
    HELD.name.push_str("!");
}

#[inline(never)]
fn through_callee(base: &Rec) -> String {
    let r = *base;
    touch_global();
    return r.name;
}

#[inline(never)]
fn through_closure(base: &Rec, mut f: fn mut()) -> String {
    let r = *base;
    f();
    return r.name;
}

#[inline(never)]
fn call_it(mut f: fn mut()) {
    f();
}

#[inline(never)]
fn through_handed_closure(base: &Rec, f: fn mut()) -> String {
    let r = *base;
    call_it(f);
    return r.name;
}

struct Holder {
    r: &mut Rec,
}

#[inline(never)]
fn poke(h: &mut Holder) {
    h.r.name.push_str("!");
}

#[inline(never)]
fn through_held_reference(base: &Rec, other: &mut Rec) -> String {
    let r = *base;
    let mut h = Holder { r: other };
    poke(&mut h);
    return r.name;
}

#[inline(never)]
fn through_unnamed_place(base: &Rec, other: &mut Rec, pick: bool) -> String {
    let r = *base;
    let h = Holder { r: other };
    (if pick { h.r } else { h.r }).name.push_str("!");
    return r.name;
}

#[inline(never)]
fn through_global_write(base: &Rec) -> String {
    let r = *base;
    HELD.name.push_str("!");
    return r.name;
}

export fn run() with Stdout {
    let mut a = Rec { name: "a" };
    let p: &Rec = &a;
    let x = through_alias(p, &mut a);
    let y = through_callee(&HELD);
    let mut c = Rec { name: "c" };
    let q: &Rec = &c;
    let z = through_closure(q, || c.name.push_str("!"));
    let mut d = Rec { name: "d" };
    let s: &Rec = &d;
    let w = through_handed_closure(s, || d.name.push_str("!"));
    let mut e = Rec { name: "e" };
    let t: &Rec = &e;
    let v = through_held_reference(t, &mut e);
    let mut f = Rec { name: "f" };
    let u: &Rec = &f;
    let o = through_unnamed_place(u, &mut f, builtin::black_box(true));
    let k = through_global_write(&HELD);
    println(`${x} ${y} ${z} ${w} ${v} ${o} ${k}`);
    println(`${a.name} ${HELD.name} ${c.name} ${d.name} ${e.name} ${f.name}`);
}

__DATA__
{
    "stdout": "a g c d e f g!\na! g!! c! d! e! f!\n"
}
