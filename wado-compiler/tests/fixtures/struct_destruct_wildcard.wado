// Struct destructuring with wildcard fields

use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

struct Person {
    name: String,
    age: i32,
    email: String,
}

export fn run() with Stdout {
    let p = Point { x: 10, y: 20 };

    // Ignore y with _
    let { x, y: _ } = p;
    println(`{x}`);

    // Ignore x with _
    let { x: _, y } = p;
    println(`{y}`);

    // Wildcard with three fields
    let person = Person { name: "Bob", age: 25, email: "bob@example.com" };
    let { name, age: _, email: _ } = person;
    println(`{name}`);

    // Wildcard combined with rename
    let { name: _, age, email: _ } = person;
    println(`{age}`);
}

__DATA__
{"stdout": "10\n20\nBob\n25\n"}
