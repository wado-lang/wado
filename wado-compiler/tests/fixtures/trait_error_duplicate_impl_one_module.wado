// Two impls of one `(Trait, Type)` pair are rejected where the second is
// written: no rank separates them, and a package compiles whole, so the check
// needs no open-world reasoning (WEP 2026-09-01, "The candidates").

trait Describe {
    fn describe(&self) -> String;
}

struct Point {
    x: i32,
}

impl Describe for Point {
    fn describe(&self) -> String {
        return "first";
    }
}

impl Describe for Point {
    fn describe(&self) -> String {
        return "second";
    }
}

export fn run() {
    let p = Point { x: 1 };
    assert p.describe() == "first";
}

