#![TODO]
// Tuple destructuring with rest pattern (..)

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let triple = [1, 2, 3];

    // Rest pattern to ignore trailing elements
    let [first, ..] = triple;
    println(`{first}`);

    let [a, b, ..] = triple;
    println(`{a}, {b}`);
}

__DATA__
{"stdout": "1\n1, 2\n"}
