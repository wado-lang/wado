// Closure inspect/inspect_alt must work for indirect dispatch:
// when the closure value is held behind a function parameter, struct
// field, or global, `{f:?}` and `{f:#?}` still produce the correct
// signature and per-literal source.
//
// The specialised path (closure kept as `&__Closure_N`) dispatches via
// per-functor `__Closure_N^Inspect / InspectAlt`. Cases that go
// through the canonical `Fn<N, Ret>` value (function parameters,
// struct fields, globals) read the source via the `inspect_alt` slot
// of `CanonicalClosure_K`.

fn fmt_def(f: fn(i32) -> i32) -> String {
    return `{f:?}`;
}

fn fmt_alt(f: fn(i32) -> i32) -> String {
    return `{f:#?}`;
}

struct Holder {
    cb: fn(i32) -> i32,
}

global mut GLOBAL_CB: fn(i32) -> i32 = |x: i32| x * 10;

test "literal-site :#? still works" {
    let add_one = |x: i32| x + 1;
    assert `{add_one:#?}` == "|x: i32| (x + 1)";
}

test "closure passed as fn param keeps signature for :?" {
    let add_one = |x: i32| x + 1;
    assert fmt_def(add_one) == "|i32| -> i32";
}

test "closure passed as fn param keeps source for :#?" {
    let add_one = |x: i32| x + 1;
    assert fmt_alt(add_one) == "|x: i32| (x + 1)";
}

test "closure stored in struct field keeps source for :#?" {
    let h = Holder { cb: |y: i32| y * 2 };
    assert `{h.cb:#?}` == "|y: i32| (y * 2)";
}

test "let-bound closure stored in struct field then read back keeps source for :#?" {
    let inner = |a: i32| a * 3;
    let h = Holder { cb: inner };
    assert `{h.cb:#?}` == "|a: i32| (a * 3)";
}

test "let-bound closure stored in struct field passed across fn boundary keeps source" {
    let inner = |a: i32| a * 3;
    let h = Holder { cb: inner };
    assert fmt_alt(h.cb) == "|a: i32| (a * 3)";
}

test "specialised closure formatted via Display falls through to Inspect output" {
    let f = |x: i32| x + 1;
    assert `{f}` == "|i32| -> i32";
    assert `{f:#}` == "|x: i32| (x + 1)";
}

test "capturing closure shows captures clause in :#?" {
    let n = 7;
    let f = |x: i32| x + n;
    assert `{f:#?}` == "|x: i32| captures[n] (x + n)";
}

test "closure stored in global keeps source for :#?" {
    GLOBAL_CB = |z: i32| z + 100;
    assert `{GLOBAL_CB:#?}` == "|z: i32| (z + 100)";
}

test "closure stored in global keeps signature for :?" {
    assert `{GLOBAL_CB:?}` == "|i32| -> i32";
}

fn returns_closure() -> fn(i32) -> i32 {
    return |k: i32| k + 42;
}

test "closure escaped through return value keeps source for :#?" {
    let r = returns_closure();
    assert `{r:#?}` == "|k: i32| (k + 42)";
}

test "closure rebound to another local keeps source for :#?" {
    let inner = |m: i32| m * 7;
    let alias = inner;
    assert `{alias:#?}` == "|m: i32| (m * 7)";
}

__DATA__
{"test": {}}
