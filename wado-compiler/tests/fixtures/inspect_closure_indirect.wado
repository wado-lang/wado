// Closure inspect/inspect_alt must work for indirect dispatch:
// when the closure value is held behind a function parameter, struct
// field, or global, `{f:?}` and `{f:#?}` should still produce the
// correct signature and per-literal source.
//
// Phase 2 (this commit) makes the SPECIALIZED path (closure stays as
// `&__Closure_N`) dispatch through per-functor `__Closure_N^Inspect /
// InspectAlt` impls. Indirect cases that go through the canonical
// `Fn<N, Ret>` value still fall back to the per-`(N, Ret)` Inspect
// impl, which writes the signature only — so `{f:#?}` for a closure
// passed across a function/struct boundary returns the signature
// rather than the source. Phase 3 extends `CanonicalClosure_K` with
// `inspect`/`inspect_alt` vtable slots to fix this; the failing
// sub-tests below are the acceptance criteria for that work.

fn fmt_def(f: fn(i32) -> i32) -> String {
    return `{f:?}`;
}

fn fmt_alt(f: fn(i32) -> i32) -> String {
    return `{f:#?}`;
}

struct Holder {
    cb: fn(i32) -> i32,
}

test "literal-site :#? still works" {
    let add_one = |x: i32| x + 1;
    assert `{add_one:#?}` == "|x: i32| x + 1";
}

test "closure passed as fn param keeps signature for :?" {
    let add_one = |x: i32| x + 1;
    assert fmt_def(add_one) == "|i32| -> i32";
}

test "closure passed as fn param keeps source for :#?" {
    let add_one = |x: i32| x + 1;
    assert fmt_alt(add_one) == "|x: i32| x + 1";
}

test "closure stored in struct field keeps source for :#?" {
    let h = Holder { cb: |y: i32| y * 2 };
    assert `{h.cb:#?}` == "|y: i32| y * 2";
}

__DATA__
{"test": {}}
