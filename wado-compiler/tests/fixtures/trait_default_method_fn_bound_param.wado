// A trait default method with a `fn`-bound type parameter. Such a parameter
// registers as its bound's function type and consumes no slot, but the trait
// declaration admitted it into the signature's slot list anyway — so the same
// method counted its slots one way through a trait and another through an
// impl.

use { println, Stdout } from "core:cli";

trait Apply {
    fn twice<F: fn(i32) -> i32>(&self, f: F) -> i32 {
        return f(f(1));
    }
}

struct Unit {}

impl Apply for Unit {}

export fn run() with Stdout {
    let u = Unit {};
    println(`${u.twice(|x| x + 1)}`);
}

__DATA__
{
    "stdout": "3\n"
}
