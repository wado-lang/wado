// Test: a discarded value inside an `if let` arm still runs its effects.
// `names.insert(*n)` returns a `bool` nobody reads, and its inlined body is a
// labeled block breaking with that `bool` on both paths. The arm is the last
// statement of the match arm the `if let` lowers to, so stripping the value has
// to leave the arm producing what its consumer expects — a rewrite that only
// looks at whether the *statement* is read gets this wrong and traps.

use { println, Stdout } from "core:cli";
use { TreeSet } from "core:collections";

variant Elem {
    Name(String),
    Num(i32),
}

fn distinct_names(elems: &List<Elem>) -> i32 {
    let mut names = TreeSet::<String>::new();
    for let e of elems {
        if let Name(n) = e {
            names.insert(*n);
        }
    }
    return names.len();
}

export fn run() with Stdout {
    let elems: List<Elem> = [
        Elem::Name("a"),
        Elem::Num(builtin::black_box(1)),
        Elem::Name("b"),
        Elem::Name("a"),
    ];
    println(`${distinct_names(&elems)}`);
}

__DATA__
{
    "stdout": "2\n"
}
