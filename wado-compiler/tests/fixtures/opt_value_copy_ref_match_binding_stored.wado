// The transient-borrow reading of a `&`-borrowed match scrutinee holds only
// while nothing derived from it is still read: an arm binding handed to a
// retaining callee leaves a reference into the scrutinee's storage in what the
// callee returns, so a whole-value read while that is live copies rather than
// moves.

use { println, Stdout } from "core:cli";

struct Rep { tags: List<String> }

variant Op { Plain(i32), Repeat(Rep) }

struct Held { r: &Rep }

fn hold(r: &Rep) -> Held {
    return Held { r };
}

fn make(i: i32) -> Op {
    if i % 2 == 0 {
        return Op::Repeat(Rep { tags: ["a", "b"] });
    }
    return Op::Plain(i);
}

fn build(n: i32) -> i32 {
    let mut ops: List<Op> = [];
    let mut tagged = 0;
    for let mut i = 0; i < n; i += 1 {
        let op = make(i);
        if let Repeat(rep) = &op {
            let h = hold(rep);
            ops.push(op);
            tagged += h.r.tags.len();
        } else {
            ops.push(op);
        }
    }
    return ops.len() * 10 + tagged;
}

export fn run() with Stdout {
    println(`${build(4)}`);
}

__DATA__
{
    "stdout": "44\n",
    "wir_scope": "/build",
    "wir_expect:O0": [
        "$value_copy$opt_value_copy_ref_match_binding_stored.wado/Op"
    ],
    "wir_expect:O2": [
        "array_clone_deep_prefix"
    ]
}
