// A binding's row stands for every value moved into it, one whose own row is
// fixed included: calling it demands what that value performs.
use { println, Stdout } from "core:cli";

fn leak(loud: fn() with Stdout) {
    let mut f = || {};
    f = loud;
    f();
}

export fn run() with Stdout {
    leak(|| { println("leak"); });
}

