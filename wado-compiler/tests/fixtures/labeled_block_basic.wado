use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let x = 10;

    // Labeled block creates a new scope with shadowing
    scope: {
        let x = 20;  // shadows outer x
        println(`x in scope: {x}`);
    }

    // Outer x is unchanged
    println(`x after scope: {x}`);

    // Nested labeled blocks
    outer: {
        let a = 1;
        inner: {
            let b = 2;
            let sum = a + b;
            println(`a + b = {sum}`);
        }
        // b is not visible here
        println(`a = {a}`);
    }

    println("labeled block tests passed");
}

__DATA__
{"stdout": "x in scope: 20\nx after scope: 10\na + b = 3\na = 1\nlabeled block tests passed\n"}
