// Bug: struct sub-pattern inside variant in match produces zeroed bindings.
// Some({x, y}) should extract x=5, y=10 but produces 0, 0.
use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

export fn run() with Stdout {
    let opt = Option::Some(Point { x: 5, y: 10 });
    let result = match opt {
        Some({ x, y }) => `point: {x},{y}`,
        None => "none",
    };
    println(result);
}

__DATA__
{"stdout": "point: 5,10\n"}
