// Test: bounded generic function returning the bounded type
use { println, Stdout } from "core:cli";

fn smaller<T: Ord>(a: T, b: T) -> T {
    if a < b {
        return a;
    }
    return b;
}

export fn run() with Stdout {
    let result = smaller::<i32>(10, 5);
    println(`{result}`);
    let s = smaller::<String>("apple", "banana");
    println(s);
}

__DATA__
{"stdout": "5\napple\n"}
