// Test: Iterator::map as a trait default method
// Verifies that to_ascii_lowercase/to_ascii_uppercase use Iterator::map + String::from_iter.

export fn run() {
    // to_ascii_lowercase
    assert "HELLO".to_ascii_lowercase() == "hello";
    assert "Hello World".to_ascii_lowercase() == "hello world";
    assert "already lower".to_ascii_lowercase() == "already lower";

    // to_ascii_uppercase
    assert "hello".to_ascii_uppercase() == "HELLO";
    assert "Hello World".to_ascii_uppercase() == "HELLO WORLD";
    assert "ALREADY UPPER".to_ascii_uppercase() == "ALREADY UPPER";
}

__DATA__
{"stdout": ""}
