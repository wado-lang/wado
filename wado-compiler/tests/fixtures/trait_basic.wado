use { println, Stdout } from "core:cli";

trait Greet {
    fn greet(&self) -> String;
}

struct Person {
    name: String,
}

impl Greet for Person {
    fn greet(&self) -> String {
        return `Hello, {self.name}!`;
    }
}

export fn run() with Stdout {
    let p = Person { name: "Alice" };
    println(p.greet());
}

__DATA__
{"stdout": "Hello, Alice!\n"}
