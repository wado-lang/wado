// A constraint whose type mentions a pack is left unchecked at the bound: a
// pack has no arity until it expands. The call is what rejects it, at the
// argument the constraint does not fit, with the pack still open rather than
// closed to `[]` (docs/wep-2026-03-14-variadic-type-parameters.md §6). That
// mismatch is the whole fault, so `P` is not reported again as uninferred.

trait Sink with () {
    type Cb;

    fn run(&self, cb: Self::Cb) -> i32;
}

struct Holder {
    n: i32,
}

impl Sink for Holder {
    type Cb = String;

    fn run(&self, cb: String) -> i32 {
        return cb.len();
    }
}

fn drive<..P, T: Sink<Cb = fn([..P]) -> i32>>(t: &T, cb: T::Cb) -> i32 {
    return t.run(cb);
}

test "a pack in a constraint is rejected at the call, not at the bound" {
    assert drive(&Holder { n: 7 }, "ab") == 2;
}

__DATA__
{
  "test": {},
  "compile_error": ":30:36: analysis error: type mismatch: expected 'fn([..P]) -> i32', found 'String'",
  "compile_errors_not_contains": ["cannot infer"]
}
