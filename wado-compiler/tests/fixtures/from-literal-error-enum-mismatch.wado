// KeyValueLiteral error: enum in concrete impl position rejects wrong type.
// Before the is_known_type_name fix, Direction was treated as a free type
// parameter, so DirMap<String, i32> incorrectly matched the impl.
enum Direction { North, South }

struct DirMap<D, V> {
    keys: Array<String>,
    values: Array<V>,
}

impl KeyValueLiteral for DirMap<Direction, V> {
    type Value = V;

    fn new_literal() -> DirMap<Direction, V> {
        return DirMap { keys: [], values: [] };
    }

    fn insert_literal(&mut self, key: String, value: Self::Value) {
        self.keys.append(key);
        self.values.append(value);
    }
}

export fn run() {
    // String != Direction — should fail to find impl
    let m: DirMap<String, i32> = { a: 1 };
}

__DATA__
{"compile_error": "does not implement KeyValueLiteral"}
