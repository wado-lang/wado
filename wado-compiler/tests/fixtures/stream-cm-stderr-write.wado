// Test: Write raw bytes to stderr via CM stream adapter
// Verifies that Stream<u8> data correctly reaches stderr through the CM adapter.
//
// Uses the same ordering as eprintln: start consumer first, then write.
// CM streams are zero-buffered rendezvous channels, so the consumer must be
// started before stream.write() to avoid BLOCKED.
use { Stderr } from "core:cli";
use { wait_for_subtask } from "core:internal";

export fn run() with Stderr {
    let handles = builtin::stream_new();
    let rx = handles as i32;
    let tx = (handles >> 32) as i32;

    // 1. Start stderr consumer FIRST (non-blocking, returns subtask handle)
    let subtask = builtin::call_indirect_stderr_write_via_stream(rx);

    // 2. Write "err msg\n" as raw bytes to the stream
    let data: Array<u8> = [101, 114, 114, 32, 109, 115, 103, 10];
    let ptr = builtin::realloc(0, 0, 1, 8);
