// Test: mutating imported variant field
use {Align, Opts, get_align_name} from "./variant_in_struct_match_module.wado";
use {println, Stdout} from "core:cli";

fn run() with Stdout {
    let mut opts = Opts::default();
    println(get_align_name(opts));

    opts.align = Align::Left;
    println(get_align_name(opts));
}

__DATA__
{"stdout": "right\nleft\n"}
