// A trailing comma after a parameter whose type ends in a `with` row, as the
// formatter folds a long signature. Never `wado format -w` this file.

use { Stdout } from "core:cli";

fn plain(x: i32, y: i32,) -> i32 {
    return x + y;
}

fn with_closure(x: i32, mut f: fn mut() -> i32,) -> i32 {
    return x + f();
}

fn with_effect<effect E>(x: i32, mut f: fn mut() with E,) -> i32 with E {
    f();
    return x;
}

// A parenthesized effect row keeps the comma inside the clause: this declares
// one parameter carrying two effects, not two parameters.
fn two_effects<effect E>(mut f: fn mut() with (E, Stdout),) -> i32 with (E, Stdout) {
    f();
    return 1;
}

test "a trailing comma closes the list, whatever the last parameter is" {
    assert plain(1, 2) == 3;
    assert with_closure(1, || 2) == 3;

    let mut n = 0;
    assert with_effect(5, || { n += 1; }) == 5;
    assert n == 1;
}

__DATA__
{"test": {}}
