// An inherited method demands the resource declaring it, whatever resource the
// receiver is and however the call is qualified: that resource's handler is
// the one the call reaches.
#[cm("test:dom/dom#event-target", linearity = "unrestricted", repr = "externref", classes = "0..=2")]
resource EventTarget {
    #[cm("test:dom/dom#tag")]
    fn tag(&self) -> String;
}

#[cm("test:dom/dom#bare", linearity = "unrestricted", repr = "externref", classes = "1..=1")]
resource Bare extends EventTarget {}

#[cm("test:dom/dom#node", linearity = "unrestricted", repr = "externref", classes = "2..=2")]
resource Node extends EventTarget {
    #[cm("test:dom/dom#text")]
    fn text(&self) -> String;
}

fn bare(b: Bare) -> String with EventTarget {
    return b.tag();
}

fn node(n: &Node) -> String with (EventTarget, Node) {
    return `${n.tag()}${EventTarget::tag(n)}${Node::tag(n)}${n.text()}`;
}

test {
    with EventTarget => &Tagged {}, Node => &Tagged {} do {
        assert bare(Bare::backed_by(Tagged {})) == "t";
        assert node(&Node::backed_by(Tagged {})) == "tttx";
    }
}

struct Tagged {}

impl EventTarget for Tagged {
    fn tag(&self, this: &EventTarget) -> String {
        resume "t"
    }
}

impl Node for Tagged {
    fn text(&self, this: &Node) -> String {
        resume "x"
    }
}
