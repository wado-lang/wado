// Negative test: `resume` is a statement, like `return`, so it has no value
// to bind.

interface Ask {
    fn ask() -> i32;
}

struct H {}

impl Ask for H {
    fn ask(&self) -> i32 {
        let x = resume 1;
        resume x
    }
}

export fn run() {
    let h = H {};
    with Ask => &h do {
        Ask::ask();
    }
}

