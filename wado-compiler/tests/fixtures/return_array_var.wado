// Return array variable from function

use { println, Stdout } from "core:cli";

fn get_numbers() -> Array<i32> {
    let arr: Array<i32> = [1, 2, 3];
    return arr;
}

export fn run() with Stdout {
    let nums = get_numbers();
    for let n of nums {
        println(`{n}`);
    }
}

__DATA__
{"stdout": "1\n2\n3\n"}
