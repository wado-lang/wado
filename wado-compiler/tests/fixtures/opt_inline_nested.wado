// Test: Nested function calls with inlining
// Functions calling other small functions should all be inlined

fn square(x: i32) -> i32 {
    return x * x;
}

fn sum_of_squares(a: i32, b: i32) -> i32 {
    return square(a) + square(b);
}

fn run() {
    let result = sum_of_squares(3, 4);
    assert result == 25;  // 9 + 16
}

