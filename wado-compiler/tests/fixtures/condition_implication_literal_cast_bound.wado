// Precision fix: `extract_bound_value` now peers through `Cast`
// around a literal, so a folded `(N as u32) >= var` shape (or
// symmetric `var >= (N as u32)`) is still recognised by the
// bounds-check eliminators.
//
// Without the Cast peel, niri folding `arr.used` to a literal and
// the surrounding comparison getting wrapped in a cast (typed-
// numeric context) bails out of `condition_implication`, leaving
// a dead `if unlikely(i >= (288 as u32)) { panic }` in WIR.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn cast_wrapped_bound() -> i32 {
    let arr: Array<u16> = Array::filled(288, 0 as u16);
    let mut sum: i32 = 0;
    // The loop guard `i < 288_i32` (literal) and the inner bounds
    // check `i >= arr.used` (folds to literal 288_i32 too) both go
    // through condition_implication. After Stage 2's folding,
    // intermediate casts may wrap either literal — `extract_bound_value`
    // strips them so the eliminator still fires.
    for let mut i = 0; i < 288; i += 1 {
        sum += arr[i] as i32;
    }
    return sum;
}

export fn run() with Stdout {
    let r = cast_wrapped_bound();
    println(`{r}`);
}

__DATA__
{
    "stdout": "0\n",
    "wir_not_expect:O2": ["index out of bounds"]
}
