// Test for-of inside generic method
// This tests type parameter resolution when iterating

use { println, Stdout } from "core:cli";

struct Container<T> {
    items: Array<T>,
}

impl<T> Container<T> {
    fn process(&mut self) {
        for let item of self.items {
            // Just iterate - the test is that type resolution works
        }
    }
}

export fn run() with Stdout {
    let mut c: Container<i32> = Container { items: [1, 2, 3] };
    c.process();
    println("ok");
}

__DATA__
{"stdout": "ok\n"}
