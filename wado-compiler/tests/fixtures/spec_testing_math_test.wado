// spec_testing_math_test.wado
use {add, multiply} from "./sub/spec_testing_math.wado";

test "add positive numbers" {
    assert add(2, 3) == 5;
    assert add(0, 0) == 0;
}

test "add negative numbers" {
    assert add(-1, -1) == -2;
    assert add(-5, 3) == -2;
}

test "multiply" {
    assert multiply(-2, 3) == -6;
}
