// An integer literal on a float is a float value: alone it is a float literal
// pattern, and as a range bound it takes the range check a float literal does.
// A suffix or a limit keeps its own type.

fn single(x: f64) -> i32 {
    return match x {
        1 => 1,
        _ => 0,
    };
}

fn out_of_range(x: f32) -> i32 {
    return match x {
        0..<340282366920938463463374607431768211455 => 1,
        _ => 0,
    };
}

fn suffixed(x: f64) -> i32 {
    return match x {
        0_i32..<1.5 => 1,
        _ => 0,
    };
}

fn limit(x: f64) -> i32 {
    return match x {
        0..<u8::MAX => 1,
        _ => 0,
    };
}

fn equal(x: f64) -> i32 {
    return match x {
        1..=1.0 => 1,
        _ => 0,
    };
}

export fn run() {
    let _ = single(0.0) + out_of_range(0.0) + suffixed(0.0) + limit(0.0) + equal(0.0);
}

