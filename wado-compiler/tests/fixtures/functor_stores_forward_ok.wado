// A forwarder may persist `d` through the callee; the walk reads that from the body.

struct Data {
    v: i32,
}

struct Box {
    d: &Data,
}

fn keep(d: &Data) -> Box {
    return Box { d };
}

fn forward(d: &Data) -> Box {
    return keep(d);
}

export fn run() {
    let x = Data { v: 7 };
    let b = forward(&x);
    assert b.d.v == 7;
}

