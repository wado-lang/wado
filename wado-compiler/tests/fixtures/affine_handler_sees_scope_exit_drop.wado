// A handler counting a resource's drops sees the drop at scope exit, which
// the compiler writes, as it sees one the user writes (WEP: Affine Types).

use { println, Stdout } from "core:cli";

struct Counter {
    stored: Option<i32>,
    drops: i32,
}

impl Future<i32> for Counter {
    fn new(&mut self) -> [Future<i32>, FutureWritable<i32>] {
        resume Future::<i32>::new()
    }
    fn read(&mut self, this: &Future<i32>) -> Option<i32> {
        let _ = this;
        resume self.stored
    }
    fn drop(&mut self, this: &Future<i32>) {
        let _ = this;
        self.drops += 1;
        resume ()
    }
    ..trap
}

impl FutureWritable<i32> for Counter {
    fn write(&mut self, this: &FutureWritable<i32>, value: i32) -> FutureWrite<i32> {
        let _ = this;
        self.stored = Option::Some(value);
        resume FutureWrite { rest: null, result: FutureWriteResult::Completed }
    }
    fn drop(&mut self, this: &FutureWritable<i32>) {
        let _ = this;
        resume ()
    }
    ..trap
}

export fn run() with Stdout {
    let mut c = Counter { stored: null, drops: 0 };
    with &mut c do {
        let [rx, tx] = Future::<i32>::new();
        tx.write(7);
        let _unread = rx;
    }
    println(`drops=${c.drops}`);
}

__DATA__
{"stdout": "drops=1\n"}
