/// Test that the freelist allocator coalesces adjacent free blocks:
/// freeing two neighbours merges them, so a later allocation too large
/// for either fragment alone can still reuse the merged space.
use { println } from "core:cli";

export fn run() with Stdout {
    // Three adjacent 64-byte blocks (80-byte blocks including tags).
    let a = builtin::realloc(0, 0, 8, 64);
    let b = builtin::realloc(0, 0, 8, 64);
    let c = builtin::realloc(0, 0, 8, 64);
    assert b == a + 80, `b={b}, a={a}`;
    assert c == a + 160, `c={c}, a={a}`;

    // Free b, then a — freeing a merges forward into b's free block.
    builtin::realloc(b, 64, 8, 0);
    builtin::realloc(a, 64, 8, 0);

    // A 120-byte payload does not fit either freed 64-byte block alone,
    // only their coalesced 160-byte block. Reuse must land back at `a`.
    let merged = builtin::realloc(0, 0, 8, 120);
    assert merged == a, `expected coalesced reuse: a={a}, merged={merged}`;

    builtin::realloc(c, 64, 8, 0);
    println("ok");
}

__DATA__
{"allocator": "freelist", "stdout": "ok\n"}
