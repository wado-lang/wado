// A written `Eq` for one instantiation of a head leaves the rest to derivation,
// through a bound as well as at the operator (finding 3).

struct Pair<A, B> {
    a: A,
    b: B,
}

impl Eq for Pair<i32, i64> {
    fn eq(&self, other: &Self) -> bool {
        return self.b == other.b;
    }
}

fn same<T: Eq>(x: T, y: T) -> bool {
    return x == y;
}

test "the written impl answers its instantiation" {
    let p: Pair<i32, i64> = Pair { a: 1, b: 2 };
    let q: Pair<i32, i64> = Pair { a: 3, b: 2 };
    assert p == q;
    assert same(p, q);
}

test "derivation answers the others" {
    let p: Pair<String, i32> = Pair { a: "x", b: 2 };
    let q: Pair<String, i32> = Pair { a: "y", b: 2 };
    assert p != q;
    assert !same(p, q);
}

__DATA__
{"test": {}}
