// Test: a scalar argument read from a field the caller holds constant
// specializes the callee, even when the callee also takes the struct by
// `&mut`. A formatter's precision reaches its float routine this way.
//
// `#[inline(never)]` keeps `hole` and `fixed` calls, so each `hole` clone
// passes `fixed` its own precision.

use { println, Stdout } from "core:cli";

struct Fmt {
    precision: i32,
    out: i64,
}

#[inline(never)]
fn fixed(x: i64, precision: i32, f: &mut Fmt) {
    let mut acc = x;
    for let mut i = 0; i < precision; i += 1 {
        acc = acc * 10 + i as i64;
    }
    f.out = acc;
}

#[inline(never)]
fn hole(x: i64, precision: i32) -> i64 {
    let mut f = Fmt { precision, out: 0 };
    fixed(x, f.precision, &mut f);
    return f.out;
}

export fn run() with Stdout {
    let x = builtin::black_box(3 as i64);
    println(`${hole(x, 6)} ${hole(x, 2)}`);
}

__DATA__
{
    "stdout": "3012345 301\n",
    "wir_expect:O2": [
        "fixed$spec0$dae[precision]",
        "fixed$spec1$dae[precision]"
    ]
}
