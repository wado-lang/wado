// `Waitable` is sealed: a hand-written impl could report a handle the value
// does not own, so a set would join it and drop it twice. A variant derives one
// with the marker instead.
struct Fake {
    handle: i32,
}

impl Waitable for Fake {
    fn wait_on(&self) -> WaitOn {
        return WaitOn::Settled(ReadyEvent::Unreported);
    }
}

export fn run() {
}

