use { println, Stdout } from "core:cli";

fn run() with Stdout {
    // Multiline template string without interpolation
    let simple = `Line 1
Line 2
Line 3`;
    println(simple);

    // Multiline template with interpolation
    let name = "Alice";
    let greeting = `Dear {name},

Welcome to Wado!

Best regards`;
    println(greeting);

    // Multiline with multiple interpolations
    let a = 1;
    let b = 2;
    let result = `First: {a}
Second: {b}
Sum: {a + b}`;
    println(result);

    println("done");
}

__DATA__
{"stdout": "Line 1\nLine 2\nLine 3\nDear Alice,\n\nWelcome to Wado!\n\nBest regards\nFirst: 1\nSecond: 2\nSum: 3\ndone\n"}
