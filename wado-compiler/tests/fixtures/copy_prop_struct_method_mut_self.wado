// Regression test: copy propagation must not eliminate a snapshot copy
// when the source struct is mutated by an inlined &mut self method call
// after the binding.
//
// Root cause: when `c.increment()` is inlined, the MethodCall node is gone and
// the body becomes `let self = &mut c; (*self).value += 1`. At TIR level the
// mutation is through `*self`, not directly on `c`. Previously, only
// `c.address_taken = true` was set (from the `&mut c` operand), but NOT
// `c.has_field_mutation`. The `single_use_value_copy` optimization then bypassed
// the `address_taken` check when `snapshot` was single-use, incorrectly propagating
// `let snapshot = c` → `c`, which reads the already-incremented value.
//
// Fix: taking `&mut c` now also sets `c.has_field_mutation = true`, blocking
// the incorrect single-use copy propagation.

struct Counter {
    value: i32,
}

impl Counter {
    // Intentionally inlinable (no #[inline(never)]) so the bug manifests.
    // After inlining, `c.increment()` becomes `let self = &mut c; (*self).value += 1`
    // which is the pattern that previously confused copy_prop.
    fn increment(&mut self) {
        self.value += 1;
    }

    fn get(&self) -> i32 {
        return self.value;
    }
}

test {
    let mut c = Counter { value: 0 };
    let snapshot = c;   // snapshot must capture value=0
    c.increment();      // c.value becomes 1; snapshot must stay 0
    assert snapshot.get() == 0;
    assert c.get() == 1;
}

__DATA__
{
    "test": {}
}
