// An `enum` case is a compile-time constant, so a local bound to one forwards
// into its uses like any other scalar literal: the second call below must carry
// the discriminant directly instead of reading `k2` back.
//
// The first call keeps a genuinely runtime-dependent `kind`, so it must *not*
// fold — the guard against a forward that ignores the branch.
//
// `describe` reads both fields and nothing else, so its parameter takes the
// multi-value ABI and the argument arrives field by field. The constant is
// therefore visible at the call rather than inside a struct literal.

use { println, Stdout } from "core:cli";

enum ErrorKind {
    Empty,
    Overflow,
}

struct ParseError {
    kind: ErrorKind,
    at: i32,
}

#[inline(never)]
fn describe(e: ParseError) -> i32 {
    match e.kind {
        Empty => { return e.at; },
        Overflow => { return e.at + 1; },
    }
}

export fn run() with Stdout {
    let at = builtin::black_box(10);
    let kind = if at > 5 { ErrorKind::Overflow } else { ErrorKind::Empty };
    println(`${describe(ParseError { kind, at })}`);
    let k2 = ErrorKind::Overflow;
    println(`${describe(ParseError { kind: k2, at })}`);
}

__DATA__
{
    "stdout": "11\n11\n",
    "wir_expect:O2": [
        "describe\"(1, at)",
        "describe\"(kind, at)"
    ],
    "wir_not_expect:O2": ["describe\"(k2"]
}
