// A call site that takes the whole result rebuilds it from the N results, so it
// costs only itself: the callee keeps the multi-value ABI that every
// field-reading site is lowered against. One such site used to refute the
// candidate outright, which turned a batch-returning generator's fast path into
// a heap tuple per call.
//
// The result is a fresh literal the callee built and nothing else holds, so a
// copy of it is the value itself. A whole read of a *bound* result is not —
// see `opt_multi_value_user_struct_escape.wado`, which still refutes.

struct Pair {
    a: i32,
    b: i32,
}

#[inline("never")]
fn make(x: i32) -> Pair {
    return Pair { a: x, b: x * 2 };
}

#[inline("never")]
fn total(p: Pair) -> i32 {
    return p.a + p.b;
}

// Reads the fields: lowered straight off the two results.
#[inline("never")]
fn from_fields(x: i32) -> i32 {
    let p = make(x);
    return p.b - p.a;
}

// Hands the aggregate on whole: the two results are bound and read back into
// the struct `total` was compiled to take.
#[inline("never")]
fn from_whole(x: i32) -> i32 {
    return total(make(x));
}

// Two whole hand-offs of the same callee, each rebuilding its own result.
#[inline("never")]
fn from_two(x: i32) -> i32 {
    return total(make(x)) + total(make(x + 1));
}

export fn run() {
    assert from_fields(builtin::black_box(5)) == 5;
    assert from_whole(builtin::black_box(5)) == 15;
    assert from_two(builtin::black_box(5)) == 33;
}

__DATA__
{
    "stdout": "",
    "wir_expect:O2": [
        "make\" = fn(i32) -> [i32, i32]"
    ]
}
