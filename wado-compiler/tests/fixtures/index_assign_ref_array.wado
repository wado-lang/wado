// Index assignment with reference types (String)
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Array of strings
    let mut strings: Array<String> = ["a", "b", "c"];
    strings[0] = "hello";
    strings[1] = "world";
    println(`{strings[0]} {strings[1]} {strings[2]}`);

    // String with computed value
    let mut messages: Array<String> = ["", ""];
    messages[0] = "first";
    messages[1] = "second";
    println(`{messages[0]} {messages[1]}`);
}

__DATA__
{"stdout": "hello world c\nfirst second\n"}
