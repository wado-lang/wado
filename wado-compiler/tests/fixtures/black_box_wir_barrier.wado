// `builtin::black_box` is a barrier for the whole Wado pipeline, not just NIR:
// `wir_build` keeps the call as an opaque WIR node, so no WIR pass reads the
// constant behind it. Codegen erases the node and emits the operand, leaving
// the Wasm engine free to fold what it likes.

export fn run() {
    // A guard the compiler must not decide: both arms survive to the WIR.
    let mut taken = 0;
    if builtin::black_box(0) == 0 {
        taken = 1;
    } else {
        taken = 2;
    }
    assert taken == 1;

    // Without the barrier, the same guard is decided and its dead arm goes.
    let mut folded = 0;
    if builtin::black_box(true) {
        let zero = 0;
        if zero == 0 {
            folded = 1;
        } else {
            folded = 3;
        }
    }
    assert folded == 1;

    // Arithmetic reading through the barrier stays a computation.
    let doubled = builtin::black_box(21) * 2;
    assert doubled == 42;

    // The spec's own example: the redundant mask must still be emitted.
    assert ((builtin::black_box(300) << 24) >> 24) == 44;

    // The EMI guard shape: no run reaches the payload, every pass compiles it.
    // `tests/emi.rs` injects exactly this, so it must survive the WIR too, or a
    // campaign covers only the NIR pipeline.
    let mut emi = 0;
    if builtin::black_box(false) {
        emi = 1;
    }
    assert emi == 0;
}

__DATA__
{
    "stdout": "",
    "wir_pass": {"O2": ["nir/copy_prop", "nir/const_fold", "nir/store_load_forward_post_scalarize", "nir/const_fold_post_global", "wir/run_peephole", "wir/coalesce_locals"]},
    "wir_contrast": {"O2": [
        {"if builtin::black_box(0) == 0 {": "if 0 == 0 {", "builtin::black_box(21) * 2": "21 * 2", "builtin::black_box(300) << 24": "300 << 24", "if builtin::black_box(false) {": "if false {"}
    ]},
    "wir_not_expect:O2": ["folded = 3"],
    "wir_expect:O2": [
        "black_box(0) == 0",
        "taken = 2",
        "black_box(21) * 2",
        "black_box(300)",
        "if black_box(0) {"
    ]
}
