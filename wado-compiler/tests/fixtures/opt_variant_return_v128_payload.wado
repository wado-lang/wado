// Test: a `v128` payload is declined by variant return scalarization.
//
// A `v128` is a scalar at Wasm level, so the layout rule would give it a direct
// result slot — but padding that slot for the `None` case needs a zero constant,
// and `ValueKind` has no `v128` literal to promote. `compute_layout` declines
// the payload rather than emit a wrong-typed pad: `i32.const 0` in a `v128`
// slot compiled to invalid Wasm ("type mismatch: expected v128, found i32").
//
// The WIR pass this replaced could pad it — `default_value_for_type` works on
// `WirType`, after lowering — so retiring that pass gave up the shape. No
// workload exercises it. Recovering it means a `v128` value in the graph, which
// is where the pad would have to come from.

use { i32x4 } from "core:simd";

#[inline("never")]
fn make(n: i32) -> Option<i32x4> {
    if n < 0 {
        return null;
    }
    return Option::<i32x4>::Some(i32x4::splat(n));
}

#[inline("never")]
fn use_it(n: i32) -> i32 {
    let r = make(n);
    if let Some(v) = r {
        return v.extract_lane(0);
    }
    return -1;
}

export fn run() {
    assert use_it(5) == 5;
    assert use_it(-3) == -1;
}

__DATA__
{
    "stdout": "",
    "wir_expect:O2": [
        "/make\" = fn(i32) -> ref \"core:prelude/types.wado//Option<v128>\""
    ]
}
