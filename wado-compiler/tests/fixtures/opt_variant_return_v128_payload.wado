// Test: variant SROA of an `Option<v128>` return.
//
// A v128 payload passes SROA eligibility, so the multi-value layout carries
// a v128 result slot. Padding that slot for the `None` case must emit
// `v128.const 0`, not the scalar-default `i32.const 0` — the wrong-typed pad
// compiled to invalid Wasm ("type mismatch: expected v128, found i32").

use { i32x4 } from "core:simd";

#[inline("never")]
fn make(n: i32) -> Option<i32x4> {
    if n < 0 {
        return null;
    }
    return Option::<i32x4>::Some(i32x4::splat(n));
}

#[inline("never")]
fn use_it(n: i32) -> i32 {
    let r = make(n);
    if let Some(v) = r {
        return v.extract_lane(0);
    }
    return -1;
}

export fn run() {
    assert use_it(5) == 5;
    assert use_it(-3) == -1;
}

__DATA__
{
    "stdout": "",
    "wir_expect:O2": [
        "-> [i32, v128]"
    ]
}
