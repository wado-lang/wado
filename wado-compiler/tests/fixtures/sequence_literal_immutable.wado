// A sequence literal building an immutable output type: no builder, no
// mutation methods — one `From<Array<T>>` impl.
use { println, Stdout } from "core:cli";

struct FrozenVec<T> {
    items: List<T>,
}

impl FrozenVec<T> {
    fn len(&self) -> i32 {
        return self.items.len();
    }

    fn get(&self, i: i32) -> T {
        return self.items[i];
    }
}

impl From<Array<T>> for FrozenVec<T> {
    fn from(elements: Array<T>) -> FrozenVec<T> {
        let mut items = List::<T>::with_capacity(elements.len());
        for let element of elements {
            items.push(element);
        }
        return FrozenVec { items };
    }
}

export fn run() with Stdout {
    let v: FrozenVec<i32> = [1, 2, 3, 4, 5];

    assert v.len() == 5;
    assert v.get(0) == 1;
    assert v.get(2) == 3;
    assert v.get(4) == 5;

    // Cast coercion
    let v2 = [10, 20] as FrozenVec<i32>;
    assert v2.len() == 2;
    assert v2.get(1) == 20;

    println("sequence-literal-immutable: ok");
}

__DATA__
{"stdout": "sequence-literal-immutable: ok\n"}
