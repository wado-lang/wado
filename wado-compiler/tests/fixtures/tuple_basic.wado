// Tuples: literals and their element types, `.n` / `[n]` access, `len()`,
// destructuring, casts, and where a user type named `Tuple` sits beside the
// built-in one.

struct Tuple {
    x: i32,
    y: i32,
}

struct GTuple<T> {
    value: T,
}

fn sum_pair(p: [i32, i32]) -> i32 {
    return p.0 + p.1;
}

fn get_pair() -> [i32, i32] {
    return [10, 20];
}

fn make_labeled(x: i32) -> [String, i32] {
    return [`value=${x}`, x];
}

fn swap_strings(a: String, b: String) -> [String, String] {
    return [b, a];
}

fn find_string() -> i32 {
    let t = [1, "hello"];
    for let v of t {
        return 0;
    }
    return 1;
}

test "field access by index" {
    let t = [1, 2, 3];
    assert t.0 == 1;
    assert t.1 == 2;
    assert t.2 == 3;
    let b = [10, 20, 30];
    assert b[0] == 10;
    assert b[1] == 20;
    assert b[2] == 30;
}

test "arities and element kinds" {
    let empty: [] = [];
    let single = [42];
    assert single.0 == 42;
    let het = [42, "hello", true];
    assert het.0 == 42;
    assert het.1 == "hello";
    assert het.2 == true;
    let unit: [i32, ()] = [42, ()];
    assert unit.0 == 42;
}

test "tuples nest" {
    let t = [[1, 2], [3, 4]];
    assert t.0.0 == 1;
    assert t.0.1 == 2;
    assert t.1.0 == 3;
    assert t.1.1 == 4;
}

test "a type annotation supplies the element types" {
    let t: [i32, String, bool] = [42, "hello", true];
    assert t.0 == 42;
    assert t.1 == "hello";
    assert t.2 == true;
}

test "len is the arity" {
    let t = [1, "hello", true];
    assert t.len() == 3;
    assert [42, 99].len() == 2;
    assert [42].len() == 1;
    assert [].len() == 0;
}

test "tuples as parameters and return values" {
    assert sum_pair([10, 20]) == 30;
    let p = get_pair();
    assert p.0 == 10;
    assert p.1 == 20;

    let [s, n] = make_labeled(42);
    assert s == "value=42";
    assert n == 42;
    let [a, b] = swap_strings("hello", "world");
    assert a == "world";
    assert b == "hello";
    let result = make_labeled(99);
    assert result.0 == "value=99";
    assert result.1 == 99;
}

test "destructuring a multi-value builtin" {
    let [lo1, hi1] = builtin::i64_add128(100 as i64, 200 as i64, 50 as i64, 25 as i64);
    assert lo1 == 150 as i64;
    assert hi1 == 225 as i64;

    let [lo2, hi2] = builtin::i64_sub128(150 as i64, 225 as i64, 50 as i64, 25 as i64);
    assert lo2 == 100 as i64;
    assert hi2 == 200 as i64;

    let [lo3, hi3] = builtin::i64_mul_wide_u(10 as i64, 20 as i64);
    assert lo3 == 200 as i64;
    assert hi3 == 0 as i64;

    let [lo4, hi4] = builtin::i64_mul_wide_s(0 as i64 - 10, 20 as i64);
    assert lo4 == 0 as i64 - 200;
    assert hi4 == 0 as i64 - 1;

    let [lo5, _] = builtin::i64_mul_wide_u(100 as i64, 100 as i64);
    assert lo5 == 10000 as i64;

    let [_, hi6] = builtin::i64_mul_wide_u(1 as i64 << 63, 2 as i64);
    assert hi6 == 1 as i64;
}

test "a rest pattern ignores the trailing elements" {
    let triple = [1, 2, 3];
    let [first, ..] = triple;
    assert first == 1;
    let [a, b, ..] = triple;
    assert a == 1;
    assert b == 2;
}

test "a cast takes the element types from the target" {
    // Resolving the literal on its own typed it `[i32, i32]` and left codegen
    // a `StructNew` of the wrong shape.
    let widened = [1, 2] as [i64, i64];
    let mixed = [1, "two"] as [i64, String];
    let same = [3, 4] as [i32, i32];
    assert widened.0 + widened.1 == 3 as i64;
    assert mixed.1 == "two";
    assert same.0 == 3;
}

// The expected type on a `let` must reach tuple literals nested inside if /
// match branches, so a numeric literal coerces to the narrower integer type.

test "a tuple literal in an if branch takes the narrow element type" {
    let flag = true;
    let t: [u16, String] = if flag {
        [200, "Hello!"];
    } else {
        [404, "NF"];
    };
    assert t.0 == 200 as u16;
    assert t.1 == "Hello!";

    let other: [i16, String] = if true {
        [42, "nested"];
    } else {
        [0, ""];
    };
    assert other.0 == 42 as i16;
    assert other.1 == "nested";
}

test "destructuring a tuple literal from an if branch" {
    let flag = false;
    let [status, body]: [u16, String] = if flag {
        [200, "Hello!"];
    } else {
        [404, "NF"];
    };
    assert status == 404 as u16;
    assert body == "NF";
}

test "a tuple literal in a match arm takes the narrow element type" {
    let n = 1;
    let t: [u8, String] = match n {
        0 => [0, "zero"],
        1 => [1, "one"],
        _ => [255, "other"],
    };
    assert t.0 == 1 as u8;
    assert t.1 == "one";
}

test "a user struct named Tuple coexists with the built-in" {
    let t = Tuple { x: 1, y: 2 };
    assert t.x == 1;
    assert t.y == 2;
    let pair = [10, 20];
    assert pair.0 == 10;
    assert pair.1 == 20;
}

test "a user generic Tuple<T> coexists with the built-in" {
    // The two once mangled to the same Wasm GC type name (`Tuple<i32>` for
    // both shapes); mangling now carries the owning module's source.
    let t = GTuple { value: 42 };
    assert t.value == 42;
    let pair = [10, 20];
    assert pair.0 == 10;
    assert pair.1 == 20;
}

test "return inside a tuple for-of leaves the function" {
    assert find_string() == 0;
}

test "zip over tuples" {
    let a = [1, 2, 3];
    let b = [4, 5, 6];
    let mut sum = 0;
    for let [x, y] of [a, b].zip() {
        sum = sum + x + y;
    }
    assert sum == 21;
}

test "zip over heterogeneous tuples" {
    let a = [1, "hello"];
    let b = [2, "world"];
    let zipped = [a, b].zip();
    assert zipped.0.0 == 1;
    assert zipped.0.1 == 2;
    assert zipped.1.0 == "hello";
    assert zipped.1.1 == "world";
}

test "zip over three tuples, and over single-element ones" {
    let a = [1, 2];
    let b = [3, 4];
    let c = [5, 6];
    let mut sum = 0;
    for let [x, y, z] of [a, b, c].zip() {
        sum = sum + x + y + z;
    }
    assert sum == 21;

    for let [x, y] of [[42], [99]].zip() {
        assert x == 42;
        assert y == 99;
    }
}
