// A written generic impl of a synthesized trait shares its method's name with the
// body synthesis emits for the instantiations it does not reach (finding 9).

struct Pair<A, B> {
    a: A,
    b: B,
}

impl<T> Inspect for Pair<T, i32> {
    fn inspect(&self, f: &mut Formatter) {
        f.write_str("pinned");
    }
}

fn show<T: Inspect>(v: T) -> String {
    return `${v:?}`;
}

test "the written impl and the synthesized body coexist" {
    let p: Pair<String, i32> = Pair { a: "x", b: 1 };
    let q: Pair<i32, i64> = Pair { a: 1, b: 2 };
    assert `${p:?}` == "pinned";
    assert `${q:?}` == "Pair { a: 1, b: 2 }";
}

test "a bound reaches the same body the direct spelling does" {
    let p: Pair<String, i32> = Pair { a: "x", b: 1 };
    let q: Pair<i32, i64> = Pair { a: 1, b: 2 };
    assert show(p) == "pinned";
    assert show(q) == "Pair { a: 1, b: 2 }";
}

