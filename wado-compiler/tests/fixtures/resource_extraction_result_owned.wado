// A generic call that reads its result through `&mut` takes it out of the
// referenced storage, so the caller owns the result whether or not a binding
// takes it (WEP 2026-05-21, "A call through `&mut` extracts"). An element
// popped and discarded is dropped.

use { Request, Response, ErrorCode, Fields, Headers, Trailers } from "wasi:http";

fn drain(list: &mut List<Fields>) {
    while let Some(_) = list.pop() {
    }
}

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    let mut list: List<Fields> = [Fields::new(), Fields::new()];
    drain(&mut list);
    assert list.is_empty();
    let [trailers, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [response, _sent] = Response::new(Headers::new(), null, trailers);
    task return Result::<Response, ErrorCode>::Ok(response);
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

__DATA__
{
  "wasi:http/service": {"status": 200},
  "wir_scope": "drain",
  "wir_expect:O0": ["resource-drop:wasi/http/types.wado#Fields"]
}
