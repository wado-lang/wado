// The generator world imports only part of `wasi:random`, so a generator
// naming the rest is refused at that name.

use { hello } from "./sub/kiln/value.schema"
    with {
        generator: { module: "./sub/kiln/random_generator.wado" },
    };

test {
    assert hello() == 7;
}

