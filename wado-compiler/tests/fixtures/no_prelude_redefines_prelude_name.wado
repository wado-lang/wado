#![no_prelude]

// The prelude-collision check is keyed off `#![no_prelude]`, not off where the
// file lives or what it contains: user code that opts out may reuse a prelude
// name. `prelude_type_collision.wado` pins the other side.

pub variant Option<T> {
    Some(T),
    None,
}

export fn run() {
    assert true;
}

