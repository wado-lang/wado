//! One trait implemented twice, both blocks leaving the trait's default body.
//! The trait's frame numbers `Self` as slot 0 and its own parameters after it,
//! so reading the default at the receiver alone leaves `T` unsubstituted: the
//! parameter list admitted any argument and codegen received a call to the
//! wrong block's body.

trait Conv<T> {
    fn tag(v: T) -> i32 {
        return 5;
    }
}

struct M {}

impl Conv<i32> for M {}

impl Conv<String> for M {}

test "the argument picks the block whose trait argument it matches" {
    assert M::tag("x") == 5;
    assert M::tag(5) == 5;
}
