// Test closure with block body
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let compute = |x: i32| {
        let doubled = x * 2;
        let tripled = x * 3;
        return doubled + tripled;
    };


    println(`{compute(3)}`); // (3 * 2) + (3 * 3) = 15
    println(`{compute(4)}`); // (4 * 2) + (4 * 3) = 20
    println(`{compute(5)}`); // (5 * 2) + (5 * 3) = 25
}

__DATA__
{"stdout": "15\n20\n25\n"}
