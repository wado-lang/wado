// Test closure with block body
use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let compute = |x: i32| {
        let doubled = x * 2;
        let tripled = x * 3;
        return doubled + tripled;
    };

    let result = compute(4);  // 8 + 12 = 20
    println(`{result}`);
}

__DATA__
{"stdout": "20\n"}
