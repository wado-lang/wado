// A trait method's `affine T` admits a move-only argument, so an impl that
// leaves it unmarked could copy one in its body: the impl must restate it.
trait Sink with () {
    fn put<affine T>(&mut self, v: T) -> i32;
}

struct S {}

impl Sink for S {
    fn put<T>(&mut self, v: T) -> i32 {
        let a = v;
        let b = v;
        return 2;
    }
}

export fn run() {}

