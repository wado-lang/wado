// A bound binding an associated type names one its trait declares, and one
// that takes no parameters of its own: a family is no type until a projection
// gives it arguments.

trait Store with () {
    type Item;
    type Buf<E>;
}

fn misspelled<S: Store<Itme = i32>>(s: &S) {}

fn family<S: Store<Buf = List<i32>>>(s: &S) {}

export fn run() {}

