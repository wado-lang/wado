// Loop-versioned BCE under a guard whose bound is a constant: `c < 4` against
// a list whose length is not known, read at an offset. The residual compares
// the constant itself, and the fast arm carries no check.

use { println, Stdout } from "core:cli";

fn sum4(xs: &List<i32>, at: i32) -> i32 {
    let mut sum = 0;
    for let mut c = 0; c < 4; c += 1 {
        sum += xs[at + c];
    }
    return sum;
}

export fn run() with Stdout {
    let xs = List::<i32>::filled(builtin::black_box(6), 3);
    println(`${sum4(&xs, builtin::black_box(2))}`);
}

__DATA__
{
    "stdout": "12\n",
    "wir_scope": ".wado/run",
    "wir_expect:O2": [
        "(at >= 0) & (4 <= (n"
    ]
}
