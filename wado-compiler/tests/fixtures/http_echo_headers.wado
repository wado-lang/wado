// HTTP header echo test
// Reads a request header and echoes its value in a response header.

use { Request, Response, ErrorCode, Fields, FieldName, FieldValue, Trailers } from "wasi:http";

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    let req_headers = request.get_headers();

    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let resp_headers = Fields::new();

    // If request has x-echo header, copy its value to x-echoed response header
    if req_headers.has("x-echo" as FieldName) {
        let values = req_headers.get("x-echo" as FieldName);
        if values.len() > 0 {
            let _ = resp_headers.append("x-echoed" as FieldName, values[0]);
        }
    }

    let [response, _tx_future] = Response::new(resp_headers, null, trailers_future);
    task return Result::<Response, ErrorCode>::Ok(response);
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

__DATA__
{
    "wasi:http/service": {
        "request": {
            "headers": [["x-echo", "ping"]]
        },
        "status": 200,
        "headers_contain": [["x-echoed", "ping"]]
    }
}
