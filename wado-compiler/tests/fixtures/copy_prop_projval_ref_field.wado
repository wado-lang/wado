// Regression guard: a copy-propagation that re-reads a field VALUE must not fire
// through a reference-typed field. Here `g.a` and `g.b` are `&mut Node` fields
// aliasing the same Node, so `g.b.value = 999` mutates what `g.a.value` reads —
// but that mutation is rooted at the local `p`, not `g`, and the field-level
// aliasing of `g.a`/`g.b` is invisible to the local-scoped alias analysis.
// Re-reading `g.a.value` at the return would observe 999; the snapshot must
// stay 5.
use { println, Stdout } from "core:cli";

struct Node { value: i32 }
struct Graph { a: &mut Node, b: &mut Node }

fn foo(g: &mut Graph, depth: i32) -> i32 {
    if depth > 0 {
        return foo(g, depth - 1);
    }
    let x = g.a.value;
    let p = g.b;
    p.value = 999;
    return x;
}

export fn run() with Stdout {
    let mut n = Node { value: 5 };
    let mut g = Graph { a: &mut n, b: &mut n };
    println(`{foo(&mut g, 0)}`);
}

__DATA__
{ "stdout": "5\n" }
