// Destructuring with string literal keys
use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

export fn run() with Stdout {
    let p = Point { "x": 10, "y": 20 };

    // Destructure with string literal keys
    let { "x": a, "y": b } = p;
    println(`{a}, {b}`);

    // Mixed destructuring
    let { "x": c, y } = p;
    println(`{c}, {y}`);
}

__DATA__
{"stdout": "10, 20\n10, 20\n"}
