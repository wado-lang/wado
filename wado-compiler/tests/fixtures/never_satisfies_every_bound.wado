// `!` and a newtype over it satisfy every trait bound. An associated type
// projected from `!` is `!`, a static method called at `Self = !` traps, and a
// written impl answers before the built-in one.

type Never = !;

fn fail() -> Never {
    panic("fail");
}

fn show<T: Display>(x: T) -> String {
    return `${x}`;
}

trait Labeled with () {
    fn label() -> String;
}

fn label_of<T: Labeled>() -> String {
    return T::label();
}

test "a `!` operand meets the bound its use asks" {
    if builtin::black_box(false) {
        let _ = `${panic("display")}`;
        let _ = show(fail());
        let _ = show(panic("bound"));
    }
}

#[expect_trap]
test "a static method no impl answers traps at `Self = !`" {
    let _ = label_of::<!>();
}

#[expect_trap]
test "a static method no impl answers traps at a newtype over `!`" {
    let _ = label_of::<Never>();
}

trait Source with () {
    type Item;
    fn get(&self) -> Self::Item;
}

fn item_of<S: Source>(s: S) -> S::Item {
    return s.get();
}

test "an associated type projected from `!` is `!`" {
    if builtin::black_box(false) {
        let _: ! = item_of(fail());
        let _: ! = item_of(panic("item"));
    }
}

trait Named with () {
    fn name() -> String;
}

impl Named for ! {
    fn name() -> String {
        return "never";
    }
}

fn name_of<T: Named>() -> String {
    return T::name();
}

test "a written impl for `!` answers" {
    assert name_of::<!>() == "never";
    assert name_of::<Never>() == "never";
}

trait Shown with () {
    fn shown() -> String;
}

impl<T: Display> Shown for T {
    fn shown() -> String {
        return "blanket";
    }
}

impl Shown for ! {
    fn shown() -> String {
        return "written";
    }
}

fn shown_of<T: Shown>() -> String {
    return T::shown();
}

test "a written impl for `!` answers before a blanket `!` now meets" {
    assert shown_of::<!>() == "written";
    assert shown_of::<i32>() == "blanket";
}

fn inspected<T: Inspect>(x: T) -> String {
    return `${x:?}`;
}

test "`Inspect` on `!` is the written impl" {
    if builtin::black_box(false) {
        let _ = `${panic("inspect"):?}`;
        let _ = inspected(fail());
    }
}
