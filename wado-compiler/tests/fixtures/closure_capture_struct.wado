// Test closure capturing struct values
use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

export fn run() with Stdout {
    let p = Point { x: 3, y: 4 };

    // Capture a struct and access its fields
    let get_x = || p.x;
    let get_y = || p.y;
    let sum_coords = || p.x + p.y;
    let manhattan = || {
        let dx = p.x;
        let dy = p.y;
        return dx + dy;
    };

    println(`{get_x()}`);      // 3
    println(`{get_y()}`);      // 4
    println(`{sum_coords()}`); // 7
    println(`{manhattan()}`);  // 7

    // Two closures capturing the same struct
    let q = Point { x: 10, y: 20 };
    let get_qx = || q.x;
    let get_qy = || q.y;
    println(`{get_qx()},{get_qy()}`);  // 10,20
}

__DATA__
{"stdout": "3\n4\n7\n7\n10,20\n"}
