// A bound settles what its arguments leave open where its subject has one impl
// of the trait.

trait Source<A> with () { fn first(&self) -> A; }

struct One { n: i32 }
impl Source<i32> for One { fn first(&self) -> i32 { return self.n; } }

struct Two { n: i32 }
impl Source<i32> for Two { fn first(&self) -> i32 { return self.n; } }
impl Source<String> for Two { fn first(&self) -> String { return `${self.n}`; } }

fn first_of<A, T: Source<A>>(t: &T) -> A {
    return t.first();
}

test {
    let v = first_of(&One { n: 7 });           // `One` has `Source<i32>` alone
    let s: String = first_of(&Two { n: 7 });   // `Two` has two: the annotation chooses
    assert `${v}` == "7" && s == "7";
}
