// Two closure signatures with the same (arity, return type) but different
// parameter types. Each gets its own dispatch stub, and both `ref.cast` to the
// shared `$canonical_inspectable_base` supertype.

fn fmt_def_i(f: fn(i32) -> i32) -> String {
    return `${f:?}`;
}

fn fmt_def_s(f: fn(String) -> i32) -> String {
    return `${f:?}`;
}

fn fmt_alt_i(f: fn(i32) -> i32) -> String {
    return `${f:#?}`;
}

fn fmt_alt_s(f: fn(String) -> i32) -> String {
    return `${f:#?}`;
}

test "i32 -> i32 :? via its own dispatch stub" {
    let g = |x: i32| x + 1;
    assert fmt_def_i(g) == "|i32| -> i32";
}

test "String -> i32 :? via its own dispatch stub" {
    let g = |s: String| s.len();
    assert fmt_def_s(g) == "|String| -> i32";
}

test "i32 -> i32 :#? via its own inspect_alt slot" {
    let g = |x: i32| x + 1;
    assert fmt_alt_i(g) == "|x: i32| (x + 1)";
}

test "String -> i32 :#? via its own inspect_alt slot" {
    let g = |s: String| s.len();
    assert fmt_alt_s(g) == "|s: String| s.String::len()";
}
