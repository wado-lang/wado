// A declaration holding an affine value says so with `affine`; a tuple, an
// anonymous struct and a newtype have no declaration to mark and infer it.
// Each is move-only, which the move check holds to.

use { println, Stdout } from "core:cli";

pub resource Counter {
    fn bump(&self);
}

affine struct Holder {
    c: Counter,
    n: i32,
}

affine variant Slot {
    Empty,
    Held(Holder),
}

affine struct Bag {
    items: List<Counter>,
}

type Wrapped = Holder;

fn describe(s: &Slot) -> String {
    return match s {
        Empty => "empty",
        Held(h) => `held ${h.n}`,
    };
}

export fn run() with Stdout {
    let slot: Slot = Empty;
    println(describe(&slot));
    let bag = Bag { items: [] };
    println(`${bag.items.len()}`);
}

__DATA__
{"stdout": "empty\n0\n"}
