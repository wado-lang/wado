// `PathFlags` is this interface's own flags, whatever `wasi:filesystem` calls
// its. Resolved by bare name, the flags type was never emitted into the
// instance and the parameter reached the CM walk with nothing to lower to.

#[cm("wasi:demo/gfx@0.1.0#opts")]
flags PathFlags {
    #[cm("first")]
    First,
}

interface Api {
    #[cm("wasi:demo/gfx@0.1.0#open")]
    fn open(opts: PathFlags) -> u32;
}

export fn run() with Api {
    let _ = Api::open(PathFlags::First);
}

__DATA__
{
  "compile_only": true,
  "wat_lines": [
    { "contains": ["(export", "\"opts\"", "(type (eq"], "count": 1 }
  ]
}
