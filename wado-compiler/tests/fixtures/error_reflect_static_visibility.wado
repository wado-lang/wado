// WEP 2026-06-13 Visibility: "What visibility withholds is a third party
// enumerating a shape its owner did not expose." The `T: ReflectStruct` bound
// enforces it — `reflect_visibility_opaque_error.wado` rejects these same two
// types, and a generic `dump<T>` cannot even be written here, since the
// `FieldTypes = [..F]` bound it needs is refused. But the concrete
// trait-qualified static call bypasses the rule: `members()` enumerates
// `Opaque`'s `root` and `size`, and `f.get()` reads their values, from a module
// that cannot so much as name those fields (`Opaque { root: 1 }` is an error).
//
// The hole reaches every foreign struct, the stdlib's included:
// `ReflectStruct::<String>::members()` yields `repr` and `used`, and reading
// `used` off `"abc"` gives 3.
use { Opaque, make_opaque } from "./sub/reflect_visibility_dep.wado";

trait Show {
    fn show(&self) -> String;
}

impl Show for i32 {
    fn show(&self) -> String {
        return `${*self}`;
    }
}

export fn run() {
    let o = make_opaque();
    let mut out = "";
    for let f of ReflectStruct::<Opaque>::members() {
        out = `${out}${f.name()}=${f.get(&o).show()};`;
    }
    assert out == "root=0;size=0;";
}

__DATA__
{"compile_error": "cannot reflect 'Opaque'"}
