use { println, Stdout } from "core:cli";

// Rebinding a mut string param does not affect the caller's binding.
fn replace(mut s: String) -> String {
    s = "new value";
    return s;
}

// Rebinding a mut array param does not affect the caller's binding.
fn swap_array(mut arr: Array<i32>) -> Array<i32> {
    arr = [99, 88, 77] as Array<i32>;
    return arr;
}

// Only the mut param can be reassigned; non-mut param cannot.
fn compute(mut x: i32, y: i32) -> i32 {
    x = x * 2;
    return x + y;
}

export fn run() with Stdout {
    // String: reassignment does not affect caller
    let original = "original";
    let result = replace(original);
    assert result == "new value";
    assert original == "original";

    // Array: rebinding does not affect caller
    let a: Array<i32> = [1, 2, 3];
    let b = swap_array(a);
    assert b[0] == 99;
    assert a[0] == 1; // caller's binding unchanged

    // Mixed mut/non-mut params
    let p = 5;
    let q = 3;
    assert compute(p, q) == 13; // (5*2) + 3
    assert p == 5;
    assert q == 3;

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
