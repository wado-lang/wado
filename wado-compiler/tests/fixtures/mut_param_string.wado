fn replace(mut s: String) -> String {
    s = "new value";
    return s;
}

fn append_exclaim(mut s: String) -> String {
    s.append("!");
    return s;
}

fn double_first(mut arr: Array<i32>) -> Array<i32> {
    arr[0] = arr[0] * 2;
    return arr;
}

fn push_zero(mut arr: Array<i32>) -> Array<i32> {
    arr.append(0);
    return arr;
}

fn compute(mut x: i32, y: i32) -> i32 {
    x = x * 2;
    return x + y;
}

export fn run() with Stdout {
    // String: reassignment does not affect caller
    let original = "original";
    let result = replace(original);
    assert result == "new value";
    assert original == "original";

    // String: append does not affect caller
    let greeting = "hello";
    let excited = append_exclaim(greeting);
    assert excited == "hello!";
    assert greeting == "hello";

    // Array: element modification does not affect caller
    let a: Array<i32> = [1, 2, 3];
    let b = double_first(a);
    assert b[0] == 2;
    assert a[0] == 1;
    assert a.len() == 3;

    // Array: append does not affect caller
    let c = push_zero(a);
    assert c.len() == 4;
    assert a.len() == 3;

    // Mixed mut and non-mut params
    let p = 5;
    let q = 3;
    let r = compute(p, q);
    assert r == 13; // (5*2) + 3
    assert p == 5;
    assert q == 3;

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
