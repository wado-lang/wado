// Constant Object Globalization for string literals.
//
// String literals lower to `StructLiteral String { repr: PackedArray, used }`
// (a const aggregate), so a constant read-only `List<String>` lookup table
// indexed dynamically in a loop is hoisted to a shared immutable
// `global:__const_obj_*` — built once at instantiation, not rebuilt per
// iteration — via the same `const_object_globalization` path as a `List<i32>`,
// with no string-specific code.

use { println, Stdout } from "core:cli";

fn total_len(n: i32) -> i32 {
    let table: List<String> = ["alpha", "beta", "gamma", "delta"];
    let mut sum = 0;
    let mut i = 0;
    while i < n {
        sum = sum + table[i % 4].len();
        i = i + 1;
    }
    return sum;
}

export fn run() with Stdout {
    // i%4 cycles 0..3: alpha(5)+beta(4)+gamma(5)+delta(5) = 19, twice = 38.
    println(`{total_len(8)}`);
}

__DATA__
{
    "stdout": "38\n",
    "wir_expect:O2": ["__const_obj"]
}
