// An extern handle inspects as the resource its class names: the dynamic type,
// whatever the static one.
#[cm("wasi:demo/dom@0.1.0#node", linearity = "unrestricted", repr = "externref", classes = "0..=2")]
resource Node {}

#[cm("wasi:demo/dom@0.1.0#element", linearity = "unrestricted", repr = "externref", classes = "1..=1")]
resource Element extends Node {}

#[cm("wasi:demo/dom@0.1.0#text", linearity = "unrestricted", repr = "externref", classes = "2..=2")]
resource Text extends Node {}

#[cm("wasi:demo/dom@0.1.0#plain", linearity = "unrestricted", repr = "externref")]
resource Plain {}

struct Mark {}

test "a handle inspects as its dynamic type" {
    let n: Node = Element::backed_by(Mark {});
    assert `${n:?}` == "Element";
    assert `${n:#?}` == "Element";
    assert `${Text::backed_by(Mark {}):?}` == "Text";
    assert `${Node::backed_by(Mark {}):?}` == "Node";
}

test "a handle inside a value inspects in place" {
    let n: Node = Text::backed_by(Mark {});
    assert `${Option::Some(n):?}` == "Option::Some(Text)";
    assert `${[n, n]:?}` == "[Text, Text]";
}

test "a resource without classes inspects as itself" {
    assert `${Plain::backed_by(Mark {}):?}` == "Plain";
}

__DATA__
{"test": {}}
