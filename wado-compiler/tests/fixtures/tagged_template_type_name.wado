// A template's type is named by its holes, each spelled as its type and
// specifier, and cut to 50 characters (WEP 2026-01-10). The literal text is the
// value's, not the type's, so it is not in the name. The name is the one
// `Reflect::type_name()` answers and a diagnostic shows.
use { println, Stdout } from "core:cli";

fn type_name_of<T: ReflectTemplate<Holes = [..V]>, ..V>(t: T) -> String {
    return Reflect::<T>::type_name();
}

export fn run() with Stdout {
    let list: List<i32> = [1];
    let x = 1;
    println(type_name_of`a ${list}`);
    println(type_name_of`a ${x:04} b`);
    println(type_name_of`plain`);
    println(type_name_of`SELECT * FROM users WHERE id = ${x} AND name = ${list} ORDER BY id`);
    println(type_name_of`${x}${x}${x}${x}${x}${x}${x}${x}${x}`);
}

__DATA__
{
    "stdout": "`${List<i32>}`\n`${i32:04}`\n``\n`${i32}${List<i32>}`\n`${i32}${i32}${i32}${i32}${i32}${i32}${i32}${i32}${...`\n"
}
