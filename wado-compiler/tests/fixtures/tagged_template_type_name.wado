// A template's type is named by its text, each hole spelled as its type and
// specifier, and cut to 50 characters (WEP 2026-01-10). The name is the one
// `Reflect::type_name()` answers and a diagnostic shows.
use { println } from "core:cli";

fn type_name_of<T: ReflectTemplate<Holes = [..V]>, ..V>(t: T) -> String {
    return Reflect::<T>::type_name();
}

export fn run() with Stdout {
    let list: List<i32> = [1];
    let x = 1;
    println(type_name_of`a ${list}`);
    println(type_name_of`a ${x:04} b`);
    println(type_name_of`line\n${x}`);
    println(type_name_of`SELECT * FROM users WHERE id = ${x} AND name = ${list} ORDER BY id`);
}

__DATA__
{
    "stdout": "`a ${List<i32>}`\n`a ${i32:04} b`\n`line\\n${i32}`\n`SELECT * FROM users WHERE id = ${i32} AND name = $...`\n"
}
