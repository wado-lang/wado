// Test nested static method calls
use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

impl Point {
    fn origin() -> Point {
        return Point { x: 0, y: 0 };
    }

    fn new(x: i32, y: i32) -> Point {
        return Point { x, y };
    }

    fn scale(p: Point, factor: i32) -> Point {
        return Point { x: p.x * factor, y: p.y * factor };
    }

    fn add(a: Point, b: Point) -> Point {
        return Point { x: a.x + b.x, y: a.y + b.y };
    }

    fn distance_squared(a: Point, b: Point) -> i32 {
        // Static method returning different type

        let dx = a.x - b.x;
        let dy = a.y - b.y;
        return dx * dx + dy * dy;
    }
}

export fn run() with Stdout {
    // Nested static method calls
    let p1 = Point::scale(Point::origin(), 5);
    println(`scaled origin: ({p1.x}, {p1.y})`);

    // Multiple levels of nesting
    let p2 = Point::add(Point::new(1, 2), Point::new(3, 4));
    println(`sum of points: ({p2.x}, {p2.y})`);

    // Static method returning different type
    let dist = Point::distance_squared(Point::origin(), Point::new(3, 4));
    println(`distance squared: {dist}`);
}

__DATA__
{"stdout": "scaled origin: (0, 0)\nsum of points: (4, 6)\ndistance squared: 25\n"}
