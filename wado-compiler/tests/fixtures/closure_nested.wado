// Test nested closures, closures returning closures, and complex capture patterns
use { println, Stdout } from "core:cli";

fn make_adder(n: i32) -> fn(i32) -> i32 {
    return |x: i32| x + n;
}

fn make_multiplier(n: i32) -> fn(i32) -> i32 {
    return |x: i32| x * n;
}

fn apply_twice(f: fn(i32) -> i32, x: i32) -> i32 {
    return f(f(x));
}

fn closure_nested_basic() with Stdout {
    // Closure captures closure
    let add5 = make_adder(5);
    let result = add5(10);
    println(`{result}`); // 15

    let mul3 = make_multiplier(3);
    let result2 = mul3(7);
    println(`{result2}`); // 21
}

fn closure_apply_twice() with Stdout {
    let add3 = make_adder(3);
    let result = apply_twice(add3, 10);
    println(`{result}`); // 16
}

fn closure_compose() with Stdout {
    let add1 = make_adder(1);
    let mul2 = make_multiplier(2);
    // Manual composition: apply add1 then mul2
    let result = mul2(add1(5));
    println(`{result}`); // (5+1)*2 = 12
}

fn closure_capture_in_branch() with Stdout {
    let x = 10;
    let y = 20;
    let pick = |use_x: bool| {
        if use_x {
            return x;
        }
        return y;
    };
    println(`{pick(true)}`);  // 10
    println(`{pick(false)}`); // 20
}

fn closure_counter() with Stdout {
    let mut count = 0;
    let inc = &mut || { count += 1; return count; };
    let a = inc();
    let b = inc();
    let c = inc();
    println(`{a},{b},{c}`); // 1,2,3
}

export fn run() with Stdout {
    closure_nested_basic();
    closure_apply_twice();
    closure_compose();
    closure_capture_in_branch();
    closure_counter();
}

__DATA__
{"stdout": "15\n21\n16\n12\n10\n20\n1,2,3\n"}
