// Test match expression with u32 literal patterns

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let x: u32 = 42 as u32;
    let y: u32 = 0 as u32;
    let large: u32 = 4000000000 as u32;

    let r1 = match x {
        0 => "zero",
        42 => "answer",
        _ => "other",
    };
    println(r1);

    let r2 = match y {
        0 => "zero",
        _ => "other",
    };
    println(r2);

    let r3 = match large {
        0 => "zero",
        4000000000 => "four billion",
        _ => "other",
    };
    println(r3);
}

__DATA__
{"stdout": "answer\nzero\nfour billion\n"}
