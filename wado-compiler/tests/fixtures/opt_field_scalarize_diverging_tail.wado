// `filter` fused into `reduce` leaves a labeled block whose tail is a `loop`
// only labeled breaks leave, so field scalarization must not append its sync
// after it. Needs the full pipeline at -O3, where inlining fuses the two.
use { println } from "core:cli";

export fn run() with Stdout {
    let arr: List<i32> = [1, 2, 3, 4];
    assert arr.iter_value().filter(|x: i32| x > 2).reduce(|a: i32, b: i32| a * b)
        matches { Some(v) && v == 12 };
    assert arr.iter_value().filter(|x: i32| x > 10).reduce(|a: i32, b: i32| a * b)
        matches { None };
    assert arr.iter_value().filter(|x: i32| x > 2).sum() matches { Some(v) && v == 7 };
    println("ok");
}

__DATA__
{"stdout": "ok\n"}
