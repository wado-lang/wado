use { println, Stdout } from "core:cli";


// from integer_u32_basic.wado
fn integer_u32_basic() with Stdout {
    // Basic assignment
    let a: u32 = 100000 as u32;
    let b: u32 = 3000 as u32;

    // Arithmetic operations
    let sum = a + b;
    println(`sum: {sum}`);

    let diff = a - b;
    println(`diff: {diff}`);

    let prod = a * b;
    println(`prod: {prod}`);

    let quot = a / b;
    println(`quot: {quot}`);

    let rem = a % b;
    println(`rem: {rem}`);
}

// from integer_u32_comparison.wado
fn integer_u32_comparison() with Stdout {
    let small: u32 = 100 as u32;
    // 3000000000 is above i32 max, would be negative if signed
    let large: u32 = 3000000000 as u32;
    let zero: u32 = 0 as u32;

    // Critical test: large > small must be true
    // With signed comparison: -1294967296 < 100 (wrong!)
    // With unsigned comparison: 3000000000 > 100 (correct!)
    if large > small {
        println("large > small: true");
    } else {
        println("large > small: false");
    }

    if large >= small {
        println("large >= small: true");
    } else {
        println("large >= small: false");
    }

    if small < large {
        println("small < large: true");
    } else {
        println("small < large: false");
    }

    if small <= large {
        println("small <= large: true");
    } else {
        println("small <= large: false");
    }

    // Comparison with zero
    if large > zero {
        println("large > zero: true");
    } else {
        println("large > zero: false");
    }

    // Equality
    let another_large: u32 = 3000000000 as u32;
    if large == another_large {
        println("large == another_large: true");
    }
    if large != small {
        println("large != small: true");
    }
}

// from integer_u32_edge.wado
fn integer_u32_edge() with Stdout {
    // Max value: 4294967295 (2^32 - 1)
    let max: u32 = 4294967295 as u32;
    println(`max: {max}`);

    // Min value: 0
    let min: u32 = 0 as u32;
    println(`min: {min}`);

    // Large value above i32 max (2147483647)
    let large: u32 = 3000000000 as u32;
    println(`large: {large}`);

    // Division with large unsigned value
    // 3000000000 / 2 = 1500000000 (correct)
    let div_result = large / 2 as u32;
    println(`3000000000 / 2: {div_result}`);

    // Modulo with large unsigned value
    let mod_result = large % 7 as u32;
    println(`3000000000 % 7: {mod_result}`);
}

export fn run() with Stdout {
    integer_u32_basic();
    integer_u32_comparison();
    integer_u32_edge();
}

__DATA__
{"stdout": "sum: 103000\ndiff: 97000\nprod: 300000000\nquot: 33\nrem: 1000\nlarge > small: true\nlarge >= small: true\nsmall < large: true\nsmall <= large: true\nlarge > zero: true\nlarge == another_large: true\nlarge != small: true\nmax: 4294967295\nmin: 0\nlarge: 3000000000\n3000000000 / 2: 1500000000\n3000000000 % 7: 4\n"}
