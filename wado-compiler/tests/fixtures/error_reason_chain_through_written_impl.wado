// A type whose impl of a derivable trait is written misses the trait through
// a bound of that impl: the reason chain names the bound, and follows it where
// it is the trait itself, not the type's own fields, which the written impl
// never reads.
use { to_string } from "core:json";

struct Inner {
    f: fn(),
}

struct Outer {
    items: List<Inner>,
}

trait Tag with () {
    fn tag(&self) -> i32;
}

struct Pair<T> {
    v: T,
}

impl<T: Tag> Eq for Pair<T> {
    fn eq(&self, other: &Self) -> bool {
        return self.v.tag() == other.v.tag();
    }
}

struct Untagged {
    n: i32,
}

struct Paired {
    p: Pair<Untagged>,
}

export fn run() {
    let o = Outer { items: [] };
    assert o == o;
    let r = to_string(&o);
    let p = Paired { p: Pair { v: Untagged { n: 1 } } };
    assert p == p;
}

__DATA__
{
    "compile_error": "note: `Outer` does not implement `Eq` because field `items` of type `List<Inner>` does not implement `Eq`\n  note: `List<Inner>` implements `Eq` only where `Inner` does\n  note: `Inner` does not implement `Eq` because field `f` of type `fn() -> ()` does not implement `Eq`",
    "compile_errors_contains": [
        "note: `List<Inner>` implements `Serialize` only where `Inner` does\n  note: `Inner` does not implement `Serialize` because field `f`",
        "note: `Paired` does not implement `Eq` because field `p` of type `Pair<Untagged>` does not implement `Eq`\n  note: `Pair<Untagged>` implements `Eq` only where `Untagged` implements `Tag`"
    ],
    "compile_errors_not_contains": ["repr"]
}
