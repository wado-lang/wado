// Uppercase local variable bindings
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let FOO = 42;
    assert FOO == 42;
    println(`{FOO}`);

    let mut BAR = 0;
    BAR = BAR + 1;
    assert BAR == 1;
    println(`{BAR}`);

    let [A, B] = [10, 20];
    assert A == 10;
    assert B == 20;
    println(`{A} {B}`);
}

__DATA__
{"stdout": "42\n1\n10 20\n"}

