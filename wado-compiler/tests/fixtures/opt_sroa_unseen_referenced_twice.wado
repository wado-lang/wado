// Two borrows of one variable are one place, even when a block that ends in a
// never-returning call keeps both. SROA rebuilds each borrow as its own
// literal, so it must not scalarize a candidate borrowed there twice.

use { println, Stdout } from "core:cli";

struct Point { x: i32, y: i32 }
struct Holder { a: Option<&Point>, b: Option<&Point> }

#[inline(never)]
fn keep_a(h: &mut Holder, p: &Point) {
    h.a = Option::Some(p);
}

#[inline(never)]
fn keep_b(h: &mut Holder, p: &Point) {
    h.b = Option::Some(p);
}

#[inline(never)]
fn show(h: &Holder) with Stdout {
    if let Some(a) = h.a && let Some(b) = h.b {
        println(`${ref_eq(a, b)}`);
    }
}

#[inline(never)]
fn f(a: i32, bad: bool) with Stdout {
    let p = Point { x: a, y: 2 };
    let mut h = Holder { a: null, b: null };
    if bad {
        keep_a(&mut h, &p);
        keep_b(&mut h, &p);
        show(&h);
        panic("boom");
    }
    println(`${p.x + p.y}`);
}

export fn run() with Stdout {
    f(builtin::black_box(1), builtin::black_box(true));
}

__DATA__
{
    "stdout": "true\n",
    "trapped": true
}
