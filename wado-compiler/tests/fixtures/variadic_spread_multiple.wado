export fn run() {
    // Multiple spreads in a non-generic tuple literal
    let a = [1, "hello"];
    let b = [true, 3.14];
    let c = [..a, ..b];
    assert c.0 == 1;
    assert c.1 == "hello";
    assert c.2 == true;
    assert c.3 == 3.14;

    // Spread with literal elements mixed in
    let d = [0, ..a, 99];
    assert d.0 == 0;
    assert d.1 == 1;
    assert d.2 == "hello";
    assert d.3 == 99;
}

