// A local item inside a template interpolation takes the `///` comment written
// there, which the outer lex hides behind the template token.

test {
    let doc = `${(|| {
        /// Inner doc.
        struct S { x: i32 }
        return Reflect::<S>::doc().unwrap();
    })()}`;
    assert doc == "Inner doc.";
}

__DATA__
{"test": {}}
