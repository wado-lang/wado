// Fall-through / implicit-else hinting: `cold_path()` placed as the cold
// fall-through after a guard `if` (whose taken branch diverges) hints the
// guard's condition likely-true, even though the marker is not inside the
// `if` body. This is the guard-clause idiom and the case where `unlikely`
// cannot be written.

// Single guard: `x == 1` is the hot path; the fall-through is cold.
fn one_guard(x: i32) -> i32 {
    if x == 1 {
        return 100;
    }
    builtin::cold_path();
    return -1;
}

// Chained guards: every guard's taken branch is hinted likely-true.
fn two_guards(x: i32) -> i32 {
    if x == 1 {
        return 10;
    }
    if x == 2 {
        return 20;
    }
    builtin::cold_path();
    return -1;
}

// `if let` guard: lowers to `if <test> { return } else { nop }`, whose cold
// fall-through must still hint the discriminant test likely-true even though the
// else is a `nop` rather than absent.
fn if_let_guard(opt: Option<i32>) -> i32 {
    if let Some(v) = opt {
        return v + 1;
    }
    builtin::cold_path();
    return -1;
}

export fn run() {
    assert one_guard(1) == 100;
    assert one_guard(9) == -1;
    assert two_guards(1) == 10;
    assert two_guards(2) == 20;
    assert two_guards(9) == -1;
    assert if_let_guard(Option::Some(7)) == 8;
    assert if_let_guard(Option::None) == -1;
}

__DATA__
{
    "stdout": "",
    "wir_expect:O0": ["@likely(x == 1)", "@likely(x == 2)", "@likely(ref.test"]
}
