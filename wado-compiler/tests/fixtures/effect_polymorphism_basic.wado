// Test: basic effect polymorphism with <effect E>
// A generic function that is polymorphic over effects

use { println, Stdout } from "core:cli";

fn wrapper<effect E>(f: fn() with E) with E {
    f();
}

fn apply<T, effect E>(f: fn(T) -> T with E, x: T) -> T with E {
    return f(x);
}

export fn run() with Stdout {
    // wrapper called with E = Stdout
    wrapper(|| {
        println("hello from wrapper");
    });

    // apply called with E = (no effects)
    let result = apply(|x: i32| x + 1, 41);
    println(`result: {result}`);

    // apply called with E = Stdout
    let result2 = apply(|x: i32| {
        println(`applying to {x}`);
        return x * 2;
    }, 21);
    println(`result2: {result2}`);
}

__DATA__
{"stdout": "hello from wrapper\nresult: 42\napplying to 21\nresult2: 42\n"}
