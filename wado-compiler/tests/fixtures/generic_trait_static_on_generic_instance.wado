// A trait-static call `T::trait_method()` whose `T` is monomorphized to a
// generic instance (List<i32>, Option<i32>) must instantiate the generic
// trait impl. Regression: the monomorphizer only queued such a call when the
// METHOD had type args of its own; for `T::default()` the type args are
// impl-level (the receiver's), so `List<i32>^Default::default` was never
// generated and trapped at WIR build — even though `List::<i32>::default()`
// (the direct form) and `T::default()` with a non-generic `T` (i32, String)
// both worked.

use { println, Stdout } from "core:cli";

fn make_default<T: Default>() -> T {
    return T::default();
}

export fn run() with Stdout {
    let a: List<i32> = make_default();
    assert a.len() == 0;

    let b: List<String> = make_default();
    assert b.len() == 0;

    let c: Option<i32> = make_default();
    assert c matches { None };

    // Non-generic concrete T still works.
    let d: i32 = make_default();
    assert d == 0;

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
