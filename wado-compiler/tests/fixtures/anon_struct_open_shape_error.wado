// What the literal itself leaves open names no shape, and is an error where
// the literal is written: an operator no field decides, and a spread base no
// field settles. Each once crashed the compiler.
struct W<T> {
    v: T,
}

impl Add for W<i32> {
    type Output = W<i32>;
    fn add(&self, rhs: &W<i32>) -> W<i32> {
        return W { v: self.v + rhs.v };
    }
}

impl Add for W<i64> {
    type Output = W<i64>;
    fn add(&self, rhs: &W<i64>) -> W<i64> {
        return W { v: self.v + rhs.v };
    }
}

fn zeroed<T: Default>() -> W<T> {
    return W { v: T::default() };
}

struct Bx<T> {
    v: Option<T>,
}

fn empty<T>() -> Bx<T> {
    return Bx { v: null };
}

fn takes_i32(_o: Option<i32>) -> i32 {
    return 1;
}

fn undecided_operator() {
    let x = zeroed();
    let s = { b: x + x };
    let _ = s;
}

fn open_base() {
    let b = empty();
    let s = { ..b, c: 1 };
    let _ = takes_i32(b.v) + s.c;
}

export fn run() {
    undecided_operator();
    open_base();
}

