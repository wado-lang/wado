// A panic between two accesses reports itself, so the later check does not
// move ahead of it.

#[inline(never)]
fn first_positive(xs: &List<i32>, i: i32) -> i32 {
    let a = xs[i];
    if a < 0 {
        panic("negative element");
    }
    return a + xs[i + 1];
}

export fn run() {
    let xs: List<i32> = builtin::black_box([-5]);
    let _ = first_positive(&xs, builtin::black_box(0));
}

__DATA__
