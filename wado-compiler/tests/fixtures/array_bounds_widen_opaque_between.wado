// A builtin whose side effect is `opaque` may be observed, so the check after
// it keeps its place: `realloc` hands over no storage, which says only that it
// writes no field the program reads.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn split(xs: &List<i32>, i: i32) -> i32 {
    let a = xs[i];
    let p = builtin::realloc(0, 0, 1, a);
    return a + xs[i + 1] + (p & 0);
}

export fn run() with Stdout {
    let xs: List<i32> = builtin::black_box([1, 2, 3, 4]);
    println(`${split(&xs, builtin::black_box(1))}`);
}

__DATA__
{
    "stdout": "5\n",
    "wir_scope": "split",
    "wir_expect:O2": [
        "if @unlikely(i >= $v1_{n})"
    ]
}
