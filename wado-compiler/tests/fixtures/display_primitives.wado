// Test: Display trait for primitive types
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Integer Display
    let mut buf = String::with_capacity(64);
    let mut f = Formatter::new(&mut buf, FormatSpec::default());

    // i32
    let x: i32 = 42;
    x.fmt(&mut f);
    println(buf);

    // bool
    buf = String::with_capacity(64);
    f = Formatter::new(&mut buf, FormatSpec::default());
    true.fmt(&mut f);
    println(buf);

    buf = String::with_capacity(64);
    f = Formatter::new(&mut buf, FormatSpec::default());
    false.fmt(&mut f);
    println(buf);

    // char
    buf = String::with_capacity(64);
    f = Formatter::new(&mut buf, FormatSpec::default());
    let c = 'A';
    c.fmt(&mut f);
    println(buf);

    // Negative i32
    buf = String::with_capacity(64);
    f = Formatter::new(&mut buf, FormatSpec::default());
    let neg: i32 = -123;
    neg.fmt(&mut f);
    println(buf);
}

__DATA__
{"stdout": "42\ntrue\nfalse\nA\n-123\n"}
