// `+` on a type parameter dispatches through its bound, and the bound pins
// `Output` so the sum stays a `T`.
use { println, Stdout } from "core:cli";

struct Vec2 {
    x: i32,
    y: i32,
}

impl Add for Vec2 {
    type Output = Vec2;

    fn add(&self, other: &Vec2) -> Vec2 {
        return Vec2 { x: self.x + other.x, y: self.y + other.y };
    }
}

fn generic_add<T: Add<Output = T>>(a: T, b: T) -> T {
    return a + b;
}

export fn run() with Stdout {
    let result = generic_add::<Vec2>(Vec2 { x: 1, y: 2 }, Vec2 { x: 3, y: 4 });
    println(`${result.x}, ${result.y}`);
}

__DATA__
{"stdout": "4, 6\n"}
