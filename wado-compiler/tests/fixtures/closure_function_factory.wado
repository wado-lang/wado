// Function returning a closure (function factory / higher-order functions)
use { println, Stdout } from "core:cli";

fn make_adder(n: i32) -> fn(i32) -> i32 {
    return |x: i32| x + n;
}

fn make_multiplier(factor: i32) -> fn(i32) -> i32 {
    return |x: i32| x * factor;
}

export fn run() with Stdout {
    let add5 = make_adder(5);
    let triple = make_multiplier(3);

    println(`{add5(3)}`);    // 8
    println(`{triple(4)}`);  // 12

    // Compose: triple then add5
    println(`{add5(triple(2))}`);  // add5(6) = 11
}

__DATA__
{"stdout": "8\n12\n11\n"}
