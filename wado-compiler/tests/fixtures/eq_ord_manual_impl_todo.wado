    let a: Meters = 1.0 as Meters;
    let b: Meters = 2.0 as Meters;
    assert a == b;
}

#[TODO]
test "an Eq bound's operator should take the newtype's impl" {
    assert eq_operator(1.0 as Meters, 2.0 as Meters);
}

#[TODO]
test "an Eq bound's method call should take the newtype's impl" {
    assert eq_method(&(1.0 as Meters), &(2.0 as Meters));
}

