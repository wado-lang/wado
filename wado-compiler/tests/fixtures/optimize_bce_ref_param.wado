// Bounds check elimination with reference parameter.
// The loop guard uses input.len() (= input.used) and the index check also uses input.used,
// but they may be different locals after LICM.
fn sum_all(input: &List<u8>) -> i32 {
    let input_len = input.len();
    let mut sum = 0;
    for let mut i = 0; i < input_len; i += 1 {
        sum += input[i] as i32;
    }
    return sum;
}

export fn run() {
    let arr: List<u8> = List::<u8>::filled(100, 42);
    let s = sum_all(&arr);
    assert s == 4200;
}

__DATA__
{
    "stdout": "",
    "wir_not_expect:O2": ["index out of bounds"]
}
