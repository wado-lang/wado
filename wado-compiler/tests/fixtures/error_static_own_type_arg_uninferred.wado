//! A static's own type parameters are filled from the spelling, never inferred
//! from the arguments. Where the block declares none the method's are numbered
//! from zero and the substitution reaches them anyway; where it declares some
//! they are not, and an unspelled one used to reach codegen unsubstituted.
//! Spelling it — `Box3::<i32>::build::<i32>(42)` — works.

trait Codec {
    fn build<T: Display>(v: T) -> String;
}

struct Box3<A> {
    a: A,
}

impl<A> Codec for Box3<A> {
    fn build<T: Display>(v: T) -> String {
        return `${v}`;
    }
}

export fn run() {
    assert Box3::<i32>::build(42) == "42";
}

__DATA__
{"compile_error": "declares the type parameter 'T', which is not inferred from the arguments here"}
