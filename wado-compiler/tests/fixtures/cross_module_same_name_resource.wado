// Two modules define `pub resource Counter` with different method
// sets. Each module's Counter must remain distinct.
//
// Regression guard for the bare-name resource-decl-index bug. See
// `cross_module_same_name_effect.wado` for the parallel effect-side
// case; the fix is shared (re-key `ResourceDeclIndex` by canonical
// `(decl_module, name)` and propagate `base_trait_module` through
// every handler method).

use { tick_a } from "./sub/cross_module_same_name_resource_a.wado";
use { tick_b } from "./sub/cross_module_same_name_resource_b.wado";

test "cross-module same-name resources compile" {
    let _a = tick_a;
    let _b = tick_b;
    assert true;
}

__DATA__
{"test": {}}
