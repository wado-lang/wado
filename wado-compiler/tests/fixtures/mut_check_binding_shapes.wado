// The shapes `mut` must reach, each of which was silently dropping it.
//
// - `for let mut` over a variant destructure: the statement carries the `mut`
//   while the pattern walker reads it off the identifier leaves.
// - A capture: a `let mut` binding stays writable inside a closure, and a local
//   shadowing a same-named immutable global answers for itself.

use { println, Stdout } from "core:cli";

struct Acc {
    sum: i32,
}

variant Held {
    Only(Acc),
}

global TABLE: List<i32> = [1, 2, 3];

export fn run() with Stdout {
    let items: List<Held> = [Held::Only(Acc { sum: 1 })];
    let mut total = 0;
    for let mut Only(a) of items {
        a.sum = 7;
        total += a.sum;
    }

    let mut TABLE: List<i32> = [9];
    let push_one = || {
        TABLE.push(5);
    };
    push_one();

    println(`${total} ${TABLE.len()}`);
}

__DATA__
{
    "stdout": "7 2\n"
}
