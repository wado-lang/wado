// Test: struct with Array<Array<i32>> field - nested literal with type annotation
use { println, Stdout } from "core:cli";

struct Matrix {
    data: Array<Array<i32>>,
    rows: i32,
}

export fn run() with Stdout {
    let data: Array<Array<i32>> = [[1, 2], [3, 4]];
    let m = Matrix { data: data, rows: 2 };
    println(`{m:?}`);
}

__DATA__
{"stdout": "Matrix { data: [[1, 2], [3, 4]], rows: 2 }\n"}
