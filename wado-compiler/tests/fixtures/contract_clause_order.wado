// Clauses are checked in the order written, and the first that fails traps, so
// a later clause may rely on the earlier ones: the second reads `xs[i]` only
// once the first has put `i` in range.
use { println, Stdout } from "core:cli";

fn non_negative_at(xs: &List<i32>, i: i32) -> i32
    contract 0 <= i < xs.len(), "i must be in range"
    contract xs[i] >= 0
{
    return xs[i];
}

export fn run() with Stdout {
    let xs: List<i32> = [1, -2, 3];
    println(`${non_negative_at(&xs, 2)}`);
    println(`${non_negative_at(&xs, builtin::black_box(5))}`);
}

__DATA__
{
    "stdout": "3\n",
    "stderr_contains": ["i must be in range", "condition: 0 <= i < xs.len()"],
    "trapped": true
}
