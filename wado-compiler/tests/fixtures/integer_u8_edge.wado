// Test u8 edge cases: max value and unsigned semantics
use { println, Stdout } from "core:cli";

fn run() with Stdout {
    // Max value: 255
    let max: u8 = 255 as u8;
    println(`max: {max}`);

    // Min value: 0
    let min: u8 = 0 as u8;
    println(`min: {min}`);

    // Division with unsigned semantics
    let a: u8 = 200 as u8;
    let b: u8 = 3 as u8;
    let div_result = a / b;
    println(`200 / 3: {div_result}`);

    // Modulo with unsigned semantics
    let mod_result = a % b;
    println(`200 % 3: {mod_result}`);
}

__DATA__
{"stdout": "max: 255\nmin: 0\n200 / 3: 66\n200 % 3: 2\n"}
