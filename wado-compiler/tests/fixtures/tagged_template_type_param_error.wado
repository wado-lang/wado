// A template's type is minted once per shape, so a hole that mentions the
// enclosing item's type parameter is rejected at the hole. The language allows
// it; WEP 2026-01-10's roadmap opens a template shape.
fn tag<T: ReflectTemplate<Holes = [..V]>, ..V>(t: T) -> i32 {
    return 1;
}

fn wrap<X>(x: X) -> i32 {
    return tag`${x}`;
}

export fn run() {
    let _ = wrap(1);
}

