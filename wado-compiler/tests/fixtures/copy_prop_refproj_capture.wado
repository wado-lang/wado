// A reference names its place, so an assignment to `b.xs` after the binding is
// what `r` reads: `r` is read afterwards, so the assignment writes into the
// storage `r` holds (WEP 2026-10-13). copy_prop may re-materialize `&b.xs` at
// the use or not; both answer the new list. The recursive callee is not
// inlined, isolating the call-argument path.
use { println, Stdout } from "core:cli";

struct Box { xs: List<i32> }

fn first_rec(xs: &List<i32>, depth: i32) -> i32 {
    if depth > 0 {
        return first_rec(xs, depth - 1);
    }
    return xs[0];
}

export fn run() with Stdout {
    let mut b = Box { xs: [10] };
    let r = &b.xs;
    b.xs = [20];
    println(`${first_rec(r, 0)}`);
}

__DATA__
{ "stdout": "20\n" }
