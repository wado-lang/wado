// An interface an imported component exports is served by that component, not
// the host, so an `#[ambient]` body over it always runs. `hlc.wasm` binds two
// interfaces, the one it exports and the guest effect it imports, and listing
// either names exactly one of them.
use { println, Stdout } from "core:cli";
use { CmCatalog } from "./sub/cm-catalog.wasm" with { type: "wasm" };
use { Hlc, Highlight } from "./sub/hlc.wasm" with { type: "wasm" };

struct Tag {}

impl Highlight for Tag {
    fn highlight(&mut self, code: String, lang: String) -> String {
        resume `${lang}:${code}`
    }
}

#[allow(undeclared_effects)]
#[ambient(CmCatalog)]
fn catalog_id() -> u8 {
    return CmCatalog::id_u8(200);
}

#[allow(undeclared_effects)]
#[ambient(Hlc, Highlight)]
fn wrapped() -> String {
    let mut tag = Tag {};
    return with Highlight => &mut tag do {
        Hlc::wrap("x", "wado").text
    };
}

export fn run() with Stdout {
    println(`${catalog_id()}`);
    println(wrapped());
}

__DATA__
{"stdout": "200\n[wado:x]\n"}
