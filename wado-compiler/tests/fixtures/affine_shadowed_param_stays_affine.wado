// A method's unmarked `T` shadowing the impl's `affine T` leaves `self.v` of
// the impl's: moving it out twice is refused.
struct Holder<affine T> {
    v: T,
}

impl<affine T> Holder<T> {
    fn twice<#[allow(shadowed_name)] T>(self, t: T) -> i32 {
        let a = self.v;
        let b = self.v;
        return 0;
    }
}

export fn run() {}

