// Test: inspect Array<Option<i32>> - array of variants
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let a: Option<i32> = Option::<i32>::Some(1);
    let b: Option<i32> = null;
    let c: Option<i32> = Option::<i32>::Some(3);
    let arr: Array<Option<i32>> = [a, b, c];
    println(`{arr:?}`);
}

__DATA__
{"stdout": "[Option::Some(1), Option::None, Option::Some(3)]\n"}
