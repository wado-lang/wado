// A handler installed in one initializer covers that initializer and nothing
// after it. The later initializer installs none of its own, so it holds no
// `Counter`, and its dispatch is rejected.

use { println, Stdout } from "core:cli";

interface Counter {
    fn next() -> i32;
}

struct Tally {
    value: i32,
}

impl Counter for Tally {
    fn next(&mut self) -> i32 {
        self.value += 1;
        resume self.value
    }
}

global HANDLED: i32 = hold: {
    let mut tally = Tally { value: 10 };
    with Counter => &mut tally do {
        break hold: Counter::next()
    }
    break hold: 0
};

global BARE: i32 = Counter::next();

export fn run() with Stdout {
    println(`${HANDLED} ${BARE}`);
}

__DATA__
{
    "compile_error": ":30:20: analysis error: global initializer must be pure (no effects), but dispatches 'next', which needs a capability the position does not hold",
    "compile_error_codes": ["TYPE_MISMATCH"]
}
