// Test: {expr} falls back to inspect when Display is not implemented
use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

export fn run() with Stdout {
    // {expr} without :? should fall back to inspect for types without Display
    let p = Point { x: 5, y: 10 };
    println(`{p}`);

    // Option without Display on inner type
    let opt: Option<Point> = Option::<Point>::Some(Point { x: 1, y: 2 });
    println(`{opt}`);

    println("ok");
}

__DATA__
{"stdout": "Point { x: 5, y: 10 }\nSome(Point { x: 1, y: 2 })\nok\n"}
