// A call through a closure value runs only the closures of its signature: the
// one writing `a.items` takes an `i32` too, so `f` cannot reach it, and `scan`
// reads `a.items` once, ahead of the loop.
use { println, Stdout } from "core:cli";

struct Acc {
    items: List<i32>,
    misses: i32,
}

#[inline(never)]
fn scan(a: &mut Acc, n: i32, f: fn(&mut Acc)) -> i32 {
    let mut sum = 0;
    for let mut i = 0; i < n; i += 1 {
        let v = a.items[i % 4];
        sum += v;
        if v < 0 {
            f(a);
        }
    }
    return sum;
}

#[inline(never)]
fn refill(a: &mut Acc, g: fn(&mut Acc, i32)) {
    g(a, 3);
}

export fn run() with Stdout {
    let mut a = Acc { items: builtin::black_box([1, -1, 0, 2]), misses: 0 };
    let f: fn(&mut Acc) = builtin::black_box(|acc: &mut Acc| acc.misses += 1);
    let g: fn(&mut Acc, i32) = builtin::black_box(|acc: &mut Acc, v: i32| acc.items = [v, v, v, v]);
    let total = scan(&mut a, builtin::black_box(8), f);
    refill(&mut a, g);
    println(`${total} ${a.misses} ${a.items[0]}`);
}

__DATA__
{
    "stdout": "4 2 3\n",
    "wir_scope": "licm_hoist_across_indirect_call_of_other_signature.wado/scan",
    "wir_pass": {"O2": ["nir/licm"]},
    "wir_expect:O2": ["array_get_value<i32>($licm_repr", "< $licm_used"]
}
