// Two value blankets of a generic trait that both apply are reported, and
// hinted at, under the trait's arguments at the receiver.

trait Limit with () {
    fn limit() -> i32;
}

trait Describe<N> with () {
    fn describe(&self) -> String;
}

impl<T: Limit> Describe<i32> for T {
    fn describe(&self) -> String {
        return `limit:${T::limit()}`;
    }
}

impl<T: ReflectStruct> Describe<i32> for T {
    fn describe(&self) -> String {
        return `struct:${Reflect::<T>::decl_name()}`;
    }
}

struct Point {
    x: i32,
}

impl Limit for Point {
    fn limit() -> i32 {
        return 7;
    }
}

export fn run() {
    let p = Point { x: 1 };
    assert p.describe() == "limit:7";
}

__DATA__
