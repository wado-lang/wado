// A `#[cm]` operation lends a list only as a parameter of its own; inside an
// `Option` the view is a reference to no resource.
use { ListView } from "core:linear";

interface Sink {
    #[cm("wasi:demo/sink@0.1.0#put")]
    fn put(bytes: Option<&ListView<u8>>) -> u32;
}

export fn run() with Sink {
    let _ = Sink::put(null);
}

