// Test: indirect call with correct effects should work
use { println, Stdout } from "core:cli";

fn make_printer() -> fn() with Stdout with Stdout {
    return || { println("hello from closure"); };
}

fn caller(f: fn() with Stdout) with Stdout {
    f();
}

export fn run() with Stdout {
    let f = make_printer();
    f();
    caller(f);
}

__DATA__
{"stdout": "hello from closure\nhello from closure\n"}
