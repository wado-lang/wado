// Simple module with variant in struct
use {println, Stdout} from "core:cli";

pub variant Status {
    Active,
    Inactive,
}

pub struct Item {
    status: Status,
    value: i32,
}

fn run() with Stdout {
    let item = Item { status: Status::Active, value: 42 };
    println(`{item.value}`);
}

__DATA__
{"stdout": "42\n"}
