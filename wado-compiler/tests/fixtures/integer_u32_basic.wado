// Test u32 basic operations
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Basic assignment
    let a: u32 = 100000 as u32;
    let b: u32 = 3000 as u32;

    // Arithmetic operations
    let sum = a + b;
    println(`sum: {sum}`);

    let diff = a - b;
    println(`diff: {diff}`);

    let prod = a * b;
    println(`prod: {prod}`);

    let quot = a / b;
    println(`quot: {quot}`);

    let rem = a % b;
    println(`rem: {rem}`);
}

__DATA__
{"stdout": "sum: 103000\ndiff: 97000\nprod: 300000000\nquot: 33\nrem: 1000\n"}
