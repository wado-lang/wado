//! Two impls of one trait agree on the first argument and differ after it.
//! `true` matches neither at argument one, so no impl declares the method for
//! this list — which is a different failure from the first argument matching
//! nothing, and said so wrongly while only one argument selected.

trait Conv<T> {
    fn make(tag: i32, v: T) -> i32;
}

struct M {}

impl Conv<i32> for M {
    fn make(tag: i32, v: i32) -> i32 {
        return 1;
    }
}

impl Conv<String> for M {
    fn make(tag: i32, v: String) -> i32 {
        return 2;
    }
}

export fn run() {
    assert M::make(0, true) == 1;
}

__DATA__
{"compile_error": "no impl of 'Conv' for 'M' declares 'make' for these arguments"}
