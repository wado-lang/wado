// Nothing settles `T`, so which `Add` answers `a + a` stays undecided.

struct Bx<T> { v: T }

impl Add for Bx<u64> {
    type Output = Bx<u64>;
    fn add(&self, o: &Self) -> Bx<u64> {
        return Bx { v: self.v + o.v };
    }
}

impl Add for Bx<i64> {
    type Output = Bx<i64>;
    fn add(&self, o: &Self) -> Bx<i64> {
        return Bx { v: self.v - o.v };
    }
}

fn mk<T: Default>() -> Bx<T> {
    return Bx { v: T::default() };
}

test {
    let a = mk();
    let _c = a + a;
}

