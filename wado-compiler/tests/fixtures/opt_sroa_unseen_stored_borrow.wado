// A block ending in a never-returning call still runs its statements up to that
// call. A borrow handed to a callee that stores it is read after the call, so
// SROA must not rebuild the candidate there as a fresh literal.

use { println, Stdout } from "core:cli";

struct Point { x: i32, y: i32 }
struct Holder { p: Option<&Point> }

#[inline(never)]
fn keep(h: &mut Holder, p: &Point) {
    h.p = Option::Some(p);
}

#[inline(never)]
fn show(h: &Holder) with Stdout {
    if let Some(p) = h.p {
        println(`${p.x}`);
    }
}

#[inline(never)]
fn f(a: i32, bad: bool) with Stdout {
    let mut p = Point { x: a, y: 2 };
    let mut h = Holder { p: null };
    if bad {
        keep(&mut h, &p);
        p.x = 9;
        show(&h);
        panic("boom");
    }
    println(`${p.x + p.y}`);
}

export fn run() with Stdout {
    f(builtin::black_box(1), builtin::black_box(true));
}

__DATA__
{
    "stdout": "9\n",
    "trapped": true
}
