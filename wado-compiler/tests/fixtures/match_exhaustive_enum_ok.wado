// Test: Exhaustive match on enum should compile and run correctly
use { println, Stdout } from "core:cli";

enum Direction {
    North,
    South,
    East,
    West,
}

fn dir_name(d: Direction) -> String {
    return match d {
        North => "north",
        South => "south",
        East => "east",
        West => "west",
    };
}

export fn run() with Stdout {
    println(dir_name(Direction::North));
    println(dir_name(Direction::West));
}

__DATA__
{"stdout": "north\nwest\n"}
