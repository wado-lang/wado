// A call handed two references to one local may compare them, so scalar
// replacement leaves the local whole rather than rebuild it once per reference:
// two rebuilt literals are two objects, and `ref_eq` then answers false.
struct P {
    a: i32,
    b: i32,
}

// Recursion keeps the call from being inlined, so the comparison stays behind it.
fn same(p: &P, q: &P, n: i32) -> bool {
    if n > 0 {
        return same(p, q, n - 1);
    }
    return ref_eq(p, q);
}

test "the builtin handed one local twice" {
    let mut x = P { a: 1, b: builtin::black_box(2) };
    x.a = 7;
    let same_place = ref_eq(&x, &x);
    assert same_place;
}

test "a callee comparing what it was handed" {
    let mut x = P { a: 1, b: builtin::black_box(2) };
    x.a = 7;
    let same_place = same(&x, &x, builtin::black_box(3));
    assert same_place;
}

test "a reference reaching the comparison through a binding" {
    let mut x = P { a: 1, b: 2 };
    let r = &x;
    x = P { a: 7, b: builtin::black_box(8) };
    let same_place = ref_eq(r, &x);
    assert same_place;
}
