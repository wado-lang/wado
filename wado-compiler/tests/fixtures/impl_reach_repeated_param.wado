// A parameter written at two positions takes one type: `impl<T> Pair<T, T>`
// reaches `Pair<i32, i32>` (finding 2).

struct Pair<A, B> {
    a: A,
    b: B,
}

impl<T> Pair<T, T> {
    fn second(&self) -> T {
        return self.b;
    }
}

test "both positions agree" {
    let p: Pair<i32, i32> = Pair { a: 1, b: 2 };
    assert p.second() == 2;
}

__DATA__
