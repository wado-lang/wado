// The purity check reads the same segment the elaborator does, so an operation
// reached through a namespace alias resolves to its interface and gets the same
// answer a bare spelling does: the initializer holds no `Counter`, so the
// dispatch is rejected.

use { println, Stdout } from "core:cli";
use c from "./sub/ns_counter.wado";

global COUNTED: i32 = c::Counter::next();

export fn run() with Stdout {
    println(`${COUNTED}`);
}

__DATA__
{
    "compile_error": ":9:23: analysis error: global initializer cannot perform effects, but dispatches 'next', which needs a capability the position does not hold",
    "compile_error_codes": ["EFFECT_NOT_ALLOWED"]
}
