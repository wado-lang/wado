// Test global variables accessed from multiple functions
use { println, Stdout } from "core:cli";

global mut shared: i32 = 100;
global MULTIPLIER: i32 = 2;

fn increment() {
    shared = shared + 1;
}

fn double() {
    shared = shared * MULTIPLIER;
}

fn get_value() -> i32 {
    return shared;
}

export fn run() with Stdout {
    println(`initial={get_value()}`);
    increment();
    println(`after increment={get_value()}`);
    double();
    println(`after double={get_value()}`);
    increment();
    increment();
    println(`after two increments={get_value()}`);
}

__DATA__
{"stdout": "initial=100\nafter increment=101\nafter double=202\nafter two increments=204\n"}
