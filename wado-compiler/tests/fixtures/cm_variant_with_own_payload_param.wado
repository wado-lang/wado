// A `#[cm]` variant carrying an `own<t>` payload, as an import parameter: the
// payload is the resource's own handle, not an `own` of that handle.

#[cm("wasi:demo/gfx@0.1.0#device")]
resource Device {
    #[cm("wasi:demo/gfx@0.1.0#[method]device.id")]
    #[cm_params("self")]
    fn id(&self) -> u32;
}

#[cm("wasi:demo/gfx@0.1.0#target")]
variant Target {
    #[cm("device")]
    Dev(Device),
    #[cm("none")]
    Nothing,
}

interface Gfx {
    #[cm("wasi:demo/gfx@0.1.0#get-device")]
    fn get_device() -> Device;
    #[cm("wasi:demo/gfx@0.1.0#pick")]
    #[cm_params("target")]
    fn pick(target: Target) -> u32;
}

export fn run() with (Gfx, Device) {
    let _ = Gfx::pick(Target::Dev(Gfx::get_device()));
    let _ = Gfx::pick(Target::Nothing);
}

