// Every kind trait holds of a closed struct, so reading it reaches its private
// fields; only building it from them is withheld.

use { make_opaque, Opaque } from "./sub/reflect_visibility_dep.wado";

fn field_names<T: ReflectStruct<FieldTypes = [..F]>, ..F>(v: &T) -> String {
    let mut out = "";
    for let f of ReflectStruct::<T>::members() {
        out.push_str(`${f.name()} `);
    }
    return out;
}

test "a closed struct still reads through reflection" {
    let o = make_opaque();              // `pub struct Opaque { root: i32, size: i32 }`
    assert Reflect::<Opaque>::type_name() == "Opaque";
    assert field_names(&o) == "root size ";
    assert `${o:?}` == "Opaque { root: 0, size: 0 }";
}

