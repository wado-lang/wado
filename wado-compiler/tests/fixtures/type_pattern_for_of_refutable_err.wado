// A `for` binding matches every element, so a narrowing there is refutable.
use { Dom, Node, HtmlInputElement } from "web:dom";

export fn run() with Dom {
    let nodes: List<Node> = [Dom::document().create_element("div", null)];
    for let input: HtmlInputElement of nodes {
        let _ = input.value();
    }
}

