// Test nested generic types with static methods
use { println, Stdout } from "core:cli";

struct Box<T> {
    value: T,
}

impl Box<T> {
    pub fn new(value: T) -> Box<T> {
        return Box { value };
    }

    pub fn get(&self) -> T {
        return self.value;
    }
}

fn run() with Stdout {
    // Nested generic: Box containing an Array
    let arr: Array<i32> = [1, 2, 3];
    let boxed_arr = Box::<Array<i32>>::new(arr);
    let inner = boxed_arr.get();
    println(`inner len: {inner.len()}`);
    println(`inner[0]: {inner[0]}`);

    // Recursive generic: Box containing Box
    let inner_box = Box::<i32>::new(42);
    let outer_box = Box::<Box<i32>>::new(inner_box);
    let unwrapped = outer_box.get();
    println(`unwrapped value: {unwrapped.get()}`);
}

__DATA__
{"stdout": "inner len: 3\ninner[0]: 1\nunwrapped value: 42\n"}
