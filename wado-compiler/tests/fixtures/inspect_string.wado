use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let s = "hello";
    println(`{s:?}`);

    let with_quote = "say \"hi\"";
    println(`{with_quote:?}`);

    let with_newline = "line1\nline2";
    println(`{with_newline:?}`);

    let empty = "";
    println(`{empty:?}`);
}

__DATA__
{"stdout": "\"hello\"\n\"say \\\"hi\\\"\"\n\"line1\\nline2\"\n\"\"\n"}
