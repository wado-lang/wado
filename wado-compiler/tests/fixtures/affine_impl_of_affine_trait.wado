// An affine type implements an `affine trait`, whose bodies hold `Self` to
// moves.
use { Fields } from "wasi:http";

affine trait Named {
    fn name(&self) -> String;

    fn shout(&self) -> String {
        return `${self.name()}!`;
    }
}

affine struct Holder {
    f: Fields,
}

impl Named for Holder {
    fn name(&self) -> String {
        return "holder";
    }
}

test {
    let h = Holder { f: Fields::new() };
    assert h.shout() == "holder!";
}
