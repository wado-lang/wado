// Test: multiple distinct effect parameters
// A function with two independent effect params resolved from different arguments

use { println, eprintln, Stdout, Stderr } from "core:cli";

fn combine<effect E1, effect E2>(f: fn() with E1, g: fn() with E2) with E1, E2 {
    f();
    g();
}

fn transform<T, effect E1, effect E2>(
    f: fn(T) -> T with E1,
    g: fn(T) -> T with E2,
    x: T,
) -> T with E1, E2 {
    let y = f(x);
    return g(y);
}

export fn run() with Stdout, Stderr {
    // E1 = Stdout, E2 = Stderr
    combine(
        || { println("from f"); },
        || { eprintln("from g"); },
    );

    // E1 = Stdout, E2 = (none)
    combine(
        || { println("effectful"); },
        || { },
    );

    // E1 = (none), E2 = (none)
    combine(|| { }, || { });

    // transform with mixed effects
    let result = transform(
        |x: i32| {
            println(`step1: {x}`);
            return x + 1;
        },
        |x: i32| {
            eprintln(`step2: {x}`);
            return x * 2;
        },
        10,
    );
    println(`result: {result}`);
}

__DATA__
{"stdout": "from f\neffectful\nstep1: 10\nresult: 22\n", "stderr_contains": ["from g", "step2: 11"]}
