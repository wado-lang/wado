// Test: single effect parameter resolved from multiple closures with different effects
// E gets the union of effects from all function-typed arguments

use { println, eprintln, Stdout, Stderr } from "core:cli";

fn combine<effect E>(f: fn() with E, g: fn() with E) with E {
    f();
    g();
}

fn transform<T, effect E>(
    f: fn(T) -> T with E,
    g: fn(T) -> T with E,
    x: T,
) -> T with E {
    let y = f(x);
    return g(y);
}

export fn run() with Stdout, Stderr {
    // E = Stdout + Stderr (union from both closures)
    combine(
        || { println("from f"); },
        || { eprintln("from g"); },
    );

    // E = Stdout (from first closure; second has no effects)
    combine(
        || { println("effectful"); },
        || { },
    );

    // E = (none)
    combine(|| { }, || { });

    // transform with mixed effects: E = Stdout + Stderr
    let result = transform(
        |x: i32| {
            println(`step1: {x}`);
            return x + 1;
        },
        |x: i32| {
            eprintln(`step2: {x}`);
            return x * 2;
        },
        10,
    );
    println(`result: {result}`);
}

__DATA__
{"stdout": "from f\neffectful\nstep1: 10\nresult: 22\n", "stderr_contains": ["from g", "step2: 11"]}
