// A `:` inside parentheses/brackets within a template interpolation belongs to
// the expression (here a closure parameter type), not the `{expr:spec}` format
// specifier. Regression: the specifier split tracked only brace depth, so the
// `:` in `|p: i32|` was mistaken for a format specifier and the expression was
// truncated mid-call ("expected RParen, found Eof").
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let xs: List<i32> = [1, 2, 3];

    // Colon inside a parenthesised closure: no format specifier here.
    let a = `any big? {xs.iter().any(|p: i32| p > 2)}`;
    assert a == "any big? true";

    // A real specifier still works after a closure-bearing expression: the
    // spec colon is the one at top level, once the parens have closed.
    let nums: List<i32> = [255];
    let b = `hex={nums.iter().fold(0, |acc: i32, x: i32| acc + x):x}`;
    assert b == "hex=ff";

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
