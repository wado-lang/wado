// A `let` bound to a `match`, `if` or `switch` whose every arm builds a struct
// literal, read only through its fields, keeps each field in a local: every
// arm assigns them, and no struct is built. A callee returning such a merge
// spliced into its only caller leaves this shape.

struct Pair {
    a: i32,
    b: i32,
}

#[inline(never)]
fn by_match(x: i32) -> i32 {
    let p = match x {
        0 => Pair { a: 10, b: 20 },
        1 => Pair { a: 30, b: 40 },
        _ => Pair { a: 50, b: 60 },
    };
    return p.a + p.b;
}

#[inline(never)]
fn by_if(x: i32) -> i32 {
    let p = if x > 0 { Pair { a: x, b: 1 } } else { Pair { a: 2, b: x } };
    return p.a * p.b;
}

#[inline(never)]
fn by_nested(x: i32) -> i32 {
    let p = if x > 0 {
        match x {
            1 => Pair { a: 1, b: 2 },
            _ => Pair { a: x, b: x },
        }
    } else {
        if x == 0 { panic("zero") }
        Pair { a: -x, b: 0 }
    };
    return p.a - p.b;
}

fn small_match(x: i32) -> Pair {
    return match x {
        0 => Pair { a: 10, b: 20 },
        1 => Pair { a: 30, b: 40 },
        _ => Pair { a: 50, b: 60 },
    };
}

#[inline(never)]
fn spliced(x: i32) -> i32 {
    let p = small_match(x);
    return p.a + p.b;
}

export fn run() {
    assert by_match(builtin::black_box(1)) == 70;
    assert by_match(builtin::black_box(7)) == 110;
    assert by_if(builtin::black_box(3)) == 3;
    assert by_if(builtin::black_box(-4)) == -8;
    assert by_nested(builtin::black_box(1)) == -1;
    assert by_nested(builtin::black_box(5)) == 0;
    assert by_nested(builtin::black_box(-3)) == 3;
    assert spliced(builtin::black_box(0)) == 30;
}

__DATA__
{
    "stdout": "",
    "wir_not_expect:O1": [
        "Pair\" {"
    ],
    "wir_not_expect:O2": [
        "Pair\" {"
    ]
}
