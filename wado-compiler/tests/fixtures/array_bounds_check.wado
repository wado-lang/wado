// Test array bounds checking: in-bounds index access works normally

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut arr: Array<i32> = [10, 20, 30];

    // Read in-bounds
    println(`{arr[0]}, {arr[1]}, {arr[2]}`);

    // Write in-bounds
    arr[1] = 99;
    println(`{arr[1]}`);
}

__DATA__
{"stdout": "10, 20, 30\n99\n"}
