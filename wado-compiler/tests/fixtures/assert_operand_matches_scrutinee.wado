// Test: `matches` renders the scrutinee the pattern rejected.

variant Shape {
    Circle(f64),
    Point,
}

export fn run() with Stdout {
    let s = Shape::Circle(3.0);
    assert s matches { Point }, "expected a point";
}

__DATA__
{
    "trapped": true,
    "stderr_contains": [
        "condition: s matches { Point }",
        "s: Shape::Circle(3.0)"
    ]
}
