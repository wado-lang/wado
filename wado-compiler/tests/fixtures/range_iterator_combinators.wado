// Range with iterator combinators
test "range collect" {
    let arr = (0..<5).collect();
    assert arr.len() == 5;
    assert arr[0] == 0;
    assert arr[4] == 4;
}

test "range fold" {
    let sum = (1..=100).fold(0, |acc: i32, x: i32| acc + x);
    assert sum == 5050;
}

test "range filter collect" {
    let evens = (0..<10).filter(|x: i32| x % 2 == 0).collect();
    assert evens.len() == 5;
    assert evens[0] == 0;
    assert evens[4] == 8;
}

test "range map collect" {
    let doubled = (1..=3).map(|x: i32| x * 2).collect();
    assert doubled.len() == 3;
    assert doubled[0] == 2;
    assert doubled[1] == 4;
    assert doubled[2] == 6;
}

__DATA__
{"test": {}}
