test "eq homogeneous" {
    let a = [1, 2, 3];
    let b = [1, 2, 3];
    let c = [1, 2, 4];
    assert a == b;
    assert a != c;
}

test "eq heterogeneous" {
    let a = [1, "hello", true];
    let b = [1, "hello", true];
    let c = [1, "world", true];
    assert a == b;
    assert a != c;
}

test "eq nested tuple" {
    let a = [[1, 2], [3, 4]];
    let b = [[1, 2], [3, 4]];
    let c = [[1, 2], [3, 5]];
    assert a == b;
    assert a != c;
}

test "eq empty" {
    let a: [] = [];
    let b: [] = [];
    assert a == b;
}

test "eq single" {
    let a = [42];
    let b = [42];
    let c = [99];
    assert a == b;
    assert a != c;
}

test "eq with struct" {
    let a = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }];
    let b = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }];
    let c = [Point { x: 1, y: 2 }, Point { x: 3, y: 5 }];
    assert a == b;
    assert a != c;
}

struct Point {
    x: i32,
    y: i32,
}

__DATA__
{"test": {}}
