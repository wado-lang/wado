// The boundaries the defaulted range check must admit. `-2147483648` is only
// in range because `-NUM` is checked as one literal; the bare `2147483648`
// is not, which the `coerce_invalid_default_i32_*` fixtures pin.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let lo = -2147483648;
    let hi = 2147483647;
    let generic_arg = identity::<i64>(4294967296);
    println(`${lo} ${hi} ${generic_arg}`);
}

fn identity<T>(v: T) -> T {
    return v;
}

__DATA__
{
    "stdout": "-2147483648 2147483647 4294967296\n"
}
