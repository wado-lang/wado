// An impl whose target is a projection, `G::Of<E>`, answers a bound on a
// projection whose base is the caller's own parameter: `G::Of<f32>` matches it
// at `G` and `E = f32`, with `G` left a parameter until the call is
// instantiated.
use { println, Stdout } from "core:cli";

trait Back with () {
    type T;
    type Of<E>;
    fn name() -> String;
}

struct Host {}

struct Boxed<E> {
    n: i32,
}

impl Back for Host {
    type T = i32;
    type Of<E> = Boxed<E>;
    fn name() -> String {
        return "host";
    }
}

trait Shown<G: Back> with () {
    fn shown(&self) -> String;
}

impl<G: Back> Shown<G> for G::T {
    fn shown(&self) -> String {
        return `plain on ${G::name()}`;
    }
}

impl<G: Back, E> Shown<G> for G::Of<E> {
    fn shown(&self) -> String {
        return `family on ${G::name()}`;
    }
}

fn show<G: Back, V: Shown<G>>(v: &V) -> String {
    return v.shown();
}

fn plain_on<G: Back>(v: &G::T) -> String {
    return show::<G, G::T>(v);
}

fn family_on<G: Back>(v: &G::Of<f32>) -> String {
    return show::<G, G::Of<f32>>(v);
}

// `E` is the caller's own parameter too.
fn family_at<G: Back, E>(v: &G::Of<E>) -> String {
    return Shown::<G>::shown(v);
}

// The receiver names `G` itself, so the call names no trait arguments.
fn family_of<G: Back>(v: &G::Of<bool>) -> String {
    return v.shown();
}

export fn run() with Stdout {
    let v: i32 = 1;
    println(plain_on::<Host>(&v));
    let b = Boxed::<f32> { n: 2 };
    println(family_on::<Host>(&b));
    println(family_at::<Host, f32>(&b));
    println(family_of::<Host>(&Boxed::<bool> { n: 3 }));
}

__DATA__
{
  "stdout": "plain on host\nfamily on host\nfamily on host\nfamily on host\n"
}
