// A by-value pattern consumes its scrutinee as the arm is entered, so the
// scrutinee is gone after the `match`.
use { Fields } from "wasi:http";

affine variant Slot {
    Empty,
    Held(Fields),
}

fn eat(f: Fields) {
}

fn take(s: Slot) {
    match s {
        Held(f) => eat(f),
        Empty => {},
    }
    let _ = s;
}

export fn run() {
}

