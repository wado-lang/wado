// A cycle only some executions take is no compile error: `make_a` reads `B`
// only when asked to. Taken, the read runs before `B` holds a value, and it
// traps at every optimization level. It used to trap at `-O0` on the empty
// slot and print `A` at `-O2`, which dropped the unused read (issue #2245).

use { println, Stdout } from "core:cli";

global A: String = make_a(builtin::black_box(true));
global B: String = make_b();

fn make_a(read_b: bool) -> String {
    if read_b {
        let _ = B.len();
    }
    return "a long enough string to stay lazy";
}

fn make_b() -> String {
    let _ = A.len();
    return "b long enough string to stay lazy";
}

export fn run() with Stdout {
    println(A);
}

__DATA__
{
    "trapped": true,
    "stdout": "",
    "stderr_contains": ["global `B` was read before its initializer ran"]
}
