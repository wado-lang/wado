// `Duo::build()` writes no arguments for `Duo`, so they are inference
// variables, and a blanket's static answers at the instance the expected type
// or an argument settles.
trait Holds with () {}

trait Build with () {
    fn build() -> Option<Self>;
}

trait Weigh with () {
    fn weigh(of: Self) -> i32;
}

struct Duo<A, B> {
    a: A,
    b: B,
}

impl Holds for Duo<i32, bool> {}
impl Holds for Duo<bool, bool> {}

impl<X: Holds> Build for X {
    fn build() -> Option<X> {
        return null;
    }
}

impl<X: Holds> Weigh for X {
    fn weigh(of: X) -> i32 {
        return 9;
    }
}

test "the expected type" {
    let d: Option<Duo<i32, bool>> = Duo::build();
    assert d matches { None };
}

test "an argument" {
    let d: Duo<bool, bool> = { a: true, b: false };
    assert Duo::weigh(d) == 9;
}
