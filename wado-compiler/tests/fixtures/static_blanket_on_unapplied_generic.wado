// `Pair::made()` writes no arguments for `Pair`, so a blanket's static answers
// it at the instance the call settles: the expected type, an argument, or the
// one instance the blanket's bounds hold of.
trait Holds with () {}

trait Make with () {
    fn made() -> i32;
}

trait Build with () {
    fn build() -> Option<Self>;
}

trait Weigh with () {
    fn weigh(of: Self) -> i32;
}

struct Pair<A, B> {
    a: A,
    b: B,
}

struct Duo<A, B> {
    a: A,
    b: B,
}

impl Holds for Pair<i32, i32> {}
impl Holds for Duo<i32, bool> {}
impl Holds for Duo<bool, bool> {}

impl<X: Holds> Make for X {
    fn made() -> i32 {
        return 7;
    }
}

impl<X: Holds> Build for X {
    fn build() -> Option<X> {
        return null;
    }
}

impl<X: Holds> Weigh for X {
    fn weigh(of: X) -> i32 {
        return 9;
    }
}

test "the one instance the bounds hold of" {
    assert Pair::made() == 7;
}

test "the expected type" {
    let d: Option<Duo<i32, bool>> = Duo::build();
    assert d matches { None };
}

test "an argument" {
    let d: Duo<bool, bool> = { a: true, b: false };
    assert Duo::weigh(d) == 9;
}
