// A type argument that does not implement the bound the parameter states.

trait Greet {
    fn greet(&self) -> String;
}

struct Plain { x: i32 }

fn hello<T: Greet>(t: &T) -> String {
    return t.greet();
}

export fn run() {
    let p = Plain { x: 1 };
    let s = hello(&p);
}

