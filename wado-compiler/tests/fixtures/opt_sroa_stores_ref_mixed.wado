// Optimization: SROA with mixed stores/non-stores &s usage.
//
// `a` has only a non-stores ref, and is SROA'd. `b`'s ref is stored in a
// `Holder`, which splits once `store_point` is inlined, leaving an ordinary
// reference local that `ref_elim` folds away; `b` then splits as well.
//
// `black_box` keeps the fields off the constant path: with constant ones both
// structs are compile-time values and there is nothing left to decompose.

struct Point {
    x: i32,
    y: i32,
}

struct Holder {
    p: &Point,
}

#[inline("never")]
fn read_point(p: &Point) -> i32 {
    return p.x + p.y;
}

fn store_point(p: &Point) -> Holder {
    return Holder { p };
}

export fn run() {
    // a: only non-stores ref — should be SROA'd
    let a = Point {
        x: builtin::black_box(1),
        y: builtin::black_box(2),
    };
    let ra = read_point(&a);
    assert a.x + ra == 4;

    // b: has a stores ref
    let b = Point {
        x: builtin::black_box(3),
        y: builtin::black_box(4),
    };
    let h = store_point(&b);
    assert b.x == 3;
    assert h.p.x == 3;
}

__DATA__
{
    "stdout": "",
    "wir_not_expect:O2": ["a = struct.new", "b = struct.new"]
}
