// A generic `core:builtin` call instantiates its type parameters like any other
// callee, so a literal argument takes the type the context decides rather than
// the i32 a rigid `T` leaves it at.

test "an integer literal through a generic builtin" {
    let a: i64 = builtin::black_box(3);
    assert a == 3;
    let b: u8 = builtin::black_box(3);
    assert b == 3;
    let c: f64 = builtin::black_box(1.5);
    assert c == 1.5;
    let d: i64 = builtin::copy_value(4);
    assert d == 4;
}

__DATA__
{"test": {}}
