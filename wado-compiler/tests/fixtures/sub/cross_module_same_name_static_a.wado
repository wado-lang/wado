// Module A: defines `struct Counter` with a static `make` factory.
// Same-name `Counter::make` is defined in module B with a different
// signature; the resolver must dispatch the right one based on the
// receiver's declaring module.
pub struct Counter {
    pub n: i32,
}

impl Counter {
    pub fn make(n: i32) -> Counter {
        return Counter { n };
    }
}
