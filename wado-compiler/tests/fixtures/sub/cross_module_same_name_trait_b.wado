// Module B: defines trait Describe (same name, different method signature) and impl for its own Data
pub trait Describe {
    fn describe(&self) -> i32;
}

pub struct Data {
    pub value: i32,
}

impl Describe for Data {
    fn describe(&self) -> i32 {
        return self.value;
    }
}

pub fn get_value(d: &Data) -> i32 {
    return d.describe();
}
