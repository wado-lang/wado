pub variant Elem {
    TokenRef(String),
    Literal(String),
    RuleRef(String),
    Repeat(RepeatElem),
    Group(List<Alt>),
    Label(LabelElem),
}

pub struct RepeatElem {
    pub element: Elem,
}

pub struct LabelElem {
    pub name: String,
    pub element: Elem,
}

pub struct Alt {
    pub label: Option<String>,
    pub elements: List<Elem>,
}
