//! A non-entry module of the `xpkg` package. Its `internal` items must reach
//! `lib.wado` (same package) but no further.

internal fn shared_helper() -> i32 { return 5 }

internal struct Secret { internal code: i32 }

internal fn make_secret() -> Secret { return Secret { code: 7 } }

pub fn open_helper() -> i32 { return 6 }
