use tag from "./cross_module_same_name_impl_arg_tag_a.wado";

pub struct Slot<A, B> {
    pub a: A,
    pub b: B
}

// The first argument is written with a namespace prefix. It names a
// declaration, so it constrains exactly like a bare name would; only the
// second position is free.
impl<Tag> Slot<tag::Tag, Tag> {
    pub fn n(&self) -> i32 {
        return self.a.n
    }
}
