// Helper module that uses a closure of shape `fn(i32) -> bool`.
// `synthesize_traits` produces a `Fn<1, bool>^Inspect::inspect` stub for
// it. The entry module uses a closure of shape `fn(i32) -> i32`, which
// requires its own distinct `Fn<1, i32>^Inspect::inspect` stub. The
// project-wide synthesis layer must not collapse these into a single
// `(Fn, Inspect)` entry — doing so makes per-module dedup skip the
// second shape and produces an unresolved trait-method call.
use { println, Stdout } from "core:cli";

pub fn show_in_helper() with Stdout {
    let pred = |x: i32| x > 0;
    println(`from helper: {pred:?}`);
}
