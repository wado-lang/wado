// The helper half of `inspect_fn_cross_module.wado`: a `fn(i32) -> bool`
// closure, whose `^Inspect` stub must not stand in for the entry module's
// `fn(i32) -> i32` one.
use { println, Stdout } from "core:cli";

pub fn show_in_helper() with Stdout {
    let pred = |x: i32| x > 0;
    println(`from helper: ${pred:?}`);
}
