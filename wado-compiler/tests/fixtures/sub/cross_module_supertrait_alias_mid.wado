use { Base as B } from "./cross_module_supertrait_alias_base.wado";

export trait Extra: B {
    fn extra(&self) -> i32;
}

export struct S {
    n: i32,
}

impl B for S {
    fn base(&self) -> i32 {
        return self.n;
    }
}

impl Extra for S {
    fn extra(&self) -> i32 {
        return self.n * 2;
    }
}

export fn make(n: i32) -> S {
    return S { n: n };
}
