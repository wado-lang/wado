// The imported half of `error_static_ambiguous_trait.wado`: the ambiguity a
// namespace-qualified spelling has to report as the bare one does.

pub trait NsAlpha {
    fn ns_make() -> i32 {
        return 1;
    }
}

pub trait NsBeta {
    fn ns_make() -> i32 {
        return 2;
    }
}

pub struct M {}

impl NsAlpha for M {}

impl NsBeta for M {}
