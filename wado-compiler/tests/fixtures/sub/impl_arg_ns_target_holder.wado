use c from "./impl_arg_ns_target_cell.wado";

// The impl *target* carries the namespace prefix, not just an argument. Which
// positions it pins has to be read the same way here as where the methods are
// named, or the two disagree about whether this impl is an instantiation.
impl c::Cell<i32> {
    pub fn get(&self) -> i32 {
        return self.a
    }
}
