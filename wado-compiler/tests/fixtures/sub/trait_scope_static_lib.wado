// Traits with static methods, implemented for a type the calling module can
// name without naming either trait.
pub trait Seeded with () {
    fn seed() -> i32;
}

trait Hidden with () {
    fn hidden() -> i32;
}

pub struct Plant {
    pub id: i32,
}

impl Seeded for Plant {
    fn seed() -> i32 {
        return 7;
    }
}

impl Hidden for Plant {
    fn hidden() -> i32 {
        return 9;
    }
}
