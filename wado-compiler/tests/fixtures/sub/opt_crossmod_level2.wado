// Level 2: uses level1 generics and creates array literals.
// The monomorphized Array<String>::push_literal may end up in this module,
// while the call site references the generic origin (prelude/array.wado).

use { make_pair, pair_to_array, Pair } from "./opt_crossmod_level1.wado";

pub fn string_pair() -> Array<String> {
    return pair_to_array::<String>(make_pair::<String>("hello", "world"));
}

pub fn int_triple() -> Array<i32> {
    return [10, 20, 30];
}

pub fn string_literals() -> Array<String> {
    return ["alpha", "beta", "gamma"];
}
