pub trait Doubled with () {
    fn doubled(&self) -> i32;
}

impl Doubled for i32 {
    fn doubled(&self) -> i32 {
        return *self * 2;
    }
}

pub trait Halved with () {
    fn halved(&self) -> i32;
}

impl Halved for i32 {
    fn halved(&self) -> i32 {
        return *self / 2;
    }
}

pub trait Tripled with () {
    fn tripled(&self) -> i32;
}

impl Tripled for i32 {
    fn tripled(&self) -> i32 {
        return *self * 3;
    }
}

pub struct Half {
    pub n: i32,
}

impl Half {
    pub fn halved(&self) -> i32 {
        return self.n / 2;
    }
}
