// Module A: defines trait Describe and impl for its own Data struct
pub trait Describe {
    fn describe(&self) -> String;
}

pub struct Data {
    pub x: i32,
}

impl Describe for Data {
    fn describe(&self) -> String {
        return `x=${self.x}`;
    }
}

pub fn get_description(d: &Data) -> String {
    return d.describe();
}
