// Module A: declares a user-owned struct, with no inherent methods of its own.
// Its inherent method lives in a *third* module (…_impl.wado), and the call
// site is in a *fourth* (the entry fixture) — exercising inherent-method
// lookup when the impl is neither in the type's home module nor the caller's.
pub struct Gadget {
    pub n: i32,
}
