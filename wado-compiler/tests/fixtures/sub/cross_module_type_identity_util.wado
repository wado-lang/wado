use { Shape } from "../cross_module_type_identity.wado";

pub fn sum_shapes(shapes: &List<Shape>) -> i32 {
    let mut total = 0;
    for let shape of shapes {
        match shape {
            Circle(c) => {
                total += c.radius;
            },
            Rect(r) => {
                total += r.width;
            },
        }
    }
    return total;
}
