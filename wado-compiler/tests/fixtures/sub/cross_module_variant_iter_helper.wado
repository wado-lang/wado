pub variant Choice {
    A(AData),
    B(BData),
}

pub struct AData {
    pub name: String,
    pub children: List<Choice>,
}

pub struct BData {
    pub value: i32,
}

pub trait Handler {
    fn on_value(&mut self, v: i32) {
    }
}

struct Counter {
    total: i32,
}

impl Handler for Counter {
    fn on_value(&mut self, v: i32) {
        self.total += v;
    }
}

fn walk<H: Handler>(h: &mut H, c: &Choice) {
    match c {
        A(a) => {
            for let child of &a.children {
                walk(h, child);
            }
        },
        B(b) => h.on_value(b.value),
    }
}

pub fn count(c: &Choice) -> i32 {
    let mut counter = Counter { total: 0 };
    walk(&mut counter, c);
    return counter.total;
}

pub fn make_tree() -> Choice {
    let leaf1 = Choice::B(BData { value: 10 });
    let leaf2 = Choice::B(BData { value: 20 });
    let children: List<Choice> = [leaf1, leaf2];
    return Choice::A(AData { name: "root", children });
}
