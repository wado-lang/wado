// Module B: a distinct `Token`/`Tag` (same bare names) and its own
// `impl Tag for List<Token>`.
pub struct Token {
    pub n: i32,
}

pub trait Tag {
    fn tag(&self) -> i32;
}

impl Tag for List<Token> {
    fn tag(&self) -> i32 {
        return 200 + self.len() as i32;
    }
}

pub fn tag_via_bound_b<T: Tag>(x: &T) -> i32 {
    return x.tag();
}
