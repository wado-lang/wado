use { Box2 as Option, Box2 as Array } from "./alias_named_prelude_generic_dep.wado";

pub struct Holder {
    pub y: Option<String>,
    pub z: Array<i32>,
}

pub struct GenericHolder<T> {
    pub x: Option<T>,
    pub y: Option<String>,
}

pub fn make() -> Holder {
    return Holder { y: Option::<String> { a: "y" }, z: Array::<i32> { a: 3 } };
}

pub fn make_generic() -> GenericHolder<i32> {
    return GenericHolder::<i32> { x: Option::<i32> { a: 1 }, y: Option::<String> { a: "g" } };
}
