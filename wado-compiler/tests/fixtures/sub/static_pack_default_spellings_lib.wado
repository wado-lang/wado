pub trait Made with () {
    fn made<..P: Default>(p: [..P] = [..P::default()]) -> [..P];
}

pub struct Kept {}

impl Made for Kept {
    fn made<..P: Default>(p: [..P]) -> [..P] {
        return p;
    }
}

pub struct Own {}

impl Own {
    pub fn made<..P: Default>(p: [..P] = [..P::default()]) -> [..P] {
        return p;
    }
}
