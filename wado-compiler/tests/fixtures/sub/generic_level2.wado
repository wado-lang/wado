// Level 2: Uses level1 generic functions and adds more complexity

use { wrap, apply_twice, pair } from "./generic_level1.wado";

// Use level1's wrap internally
pub fn wrap_and_double<T>(value: T) -> [T, T] {
    let wrapped = wrap::<T>(value);
    return pair::<T>(wrapped, wrapped);
}

// Chain multiple level1 calls
pub fn quad_wrap<T>(value: T) -> T {
    let first = apply_twice::<T>(value);
    return apply_twice::<T>(first);
}

// Mix different type instantiations
pub fn transform<T, U>(a: T, b: U) -> [[T, T], [U, U]] {
    let pair_a = pair::<T>(a, a);
    let pair_b = pair::<U>(b, b);
    return [pair_a, pair_b];
}
