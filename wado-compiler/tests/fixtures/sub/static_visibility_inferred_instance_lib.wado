pub struct W<T> { pub v: T }
impl W<i32> { fn mk() -> W<i32> { return W { v: 1 }; } }
impl W<String> { pub fn mk() -> W<String> { return W { v: "a" }; } }

pub struct V<T> { pub v: T }
impl V<String> { pub fn mk() -> V<String> { return V { v: "a" }; } }
impl V<i32> { fn mk() -> V<i32> { return V { v: 1 }; } }
