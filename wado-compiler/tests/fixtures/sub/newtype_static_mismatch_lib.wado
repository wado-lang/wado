pub struct Base {
    pub v: i32,
}

pub type N = Base;

pub trait Conv {
    fn mk(s: String) -> i32;
}

impl Conv for N {
    fn mk(s: String) -> i32 {
        return s.len();
    }
}

pub trait Conv2 {
    fn mk(x: i32) -> i32;
}

impl Conv2 for Base {
    fn mk(x: i32) -> i32 {
        return x;
    }
}
