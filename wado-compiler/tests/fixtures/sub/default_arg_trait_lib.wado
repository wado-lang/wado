// The trait half of `default_arg_and_type_param.wado`: defaults declared in
// another module than the impl. A default expression resolves here, so `origin`
// stays private; a type parameter's default is instantiated at the call, so
// `Tag` is `pub`.

fn origin() -> i32 {
    return 3;
}

pub trait Tagged with () {
    fn tagged(n: i32 = origin()) -> i32;
}

pub struct Tag {}

pub trait Named with () {
    fn name() -> String;
}

impl Named for Tag {
    fn name() -> String {
        return "tag";
    }
}

pub trait Boxed with () {
    fn boxed<T: Named = Tag>(&self) -> String;
    fn made<T: Named = Tag>() -> String;
}
