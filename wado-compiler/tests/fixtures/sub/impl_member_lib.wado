//! Impl members at each rung of the visibility ladder.

pub struct Item { pub v: i32 }

impl Item {
  fn file_private(&self) -> i32 { return self.v + 1 }

  internal fn pkg_internal(&self) -> i32 { return self.v + 2 }

  pub fn open(&self) -> i32 { return self.file_private() + self.pkg_internal() }

  const FILE_PRIVATE_C: i32 = 10;

  internal const PKG_INTERNAL_C: i32 = 20;
}

pub fn make_item() -> Item { return Item { v: 0 } }

impl Item {
  const BASE: i32 = 40;

  /// A `pub` constant whose body reads a file-private one: the body belongs to
  /// this file, so a consumer re-walking it must not be judged from its own.
  pub const DERIVED: i32 = Item::BASE + 2;

  fn secret_static() -> i32 { return 99 }
}

impl Item {
  fn bump(&mut self) -> i32 { self.v += 1; return self.v }

  pub fn bump_open(&mut self) -> i32 { return self.bump() }
}

pub fn make_items() -> List<Item> { return [Item { v: 0 }] }
