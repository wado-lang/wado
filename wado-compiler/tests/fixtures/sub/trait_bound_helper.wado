// Helper module for cross-module trait bounds tests

pub trait Summable {
    fn sum(&self) -> i32;
}

pub struct Pair {
    pub x: i32,
    pub y: i32,
}

impl Summable for Pair {
    fn sum(&self) -> i32 {
        return self.x + self.y;
    }
}

pub struct BoundedBox<T: Summable> {
    pub item: T,
}

pub fn total<T: Summable>(a: T) -> i32 {
    return a.sum();
}
