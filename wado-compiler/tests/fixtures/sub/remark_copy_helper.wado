// `seed` keeps the list out of reach of constant folding, which would evaluate
// the helper away and leave no copy to report. `#[inline(never)]` keeps the
// copy in a function of this module; `remark_copy_spliced_helper.wado` is the
// case of one spliced into its caller.

#[inline(never)]
pub fn grow(seed: i32) -> i32 {
    let a: List<i32> = [seed, seed + 1];
    let mut b = a;
    b.push(seed + 2);
    return a.len() + b.len();
}
