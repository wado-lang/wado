// Helper module for testing location literals in sub-modules
use { println, Stdout } from "core:cli";

pub fn show_file() with Stdout {
    println(#file);
}

pub fn show_line() with Stdout {
    println(#line.to_string());
}

pub fn show_function() with Stdout {
    println(#function);
}

pub fn show_data() with Stdout {
    println(#data);
}

__DATA__
SUBMODULE_DATA_MARKER
