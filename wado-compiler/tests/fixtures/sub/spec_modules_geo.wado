// A module imported as the `geo` namespace by spec_modules_namespace_members.wado.

pub struct Point {
    pub x: f64,
    pub y: f64,
}

impl Point {
    pub fn origin() -> Point {
        return Point { x: 0.0, y: 0.0 };
    }
}

pub enum Color {
    Red,
    Green,
}

pub variant Shape {
    Circle(f64),
    Square(f64),
}

pub struct Tag {
    pub name: String,
}

pub trait Show {
    fn show(&self) -> String;
}

pub fn distance(a: Point, b: Point) -> f64 {
    return f64::sqrt((a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y));
}
