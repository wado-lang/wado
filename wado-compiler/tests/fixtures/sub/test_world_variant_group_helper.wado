pub variant Choice {
    A(AData),
    B(BData),
}

pub struct AData {
    pub value: i32,
}

pub struct BData {
    pub value: i32,
}

pub fn make_a() -> Choice {
    return Choice::A(AData { value: 1 });
}

pub fn describe(c: &Choice) -> String {
    match c {
        A(_) => {
            return "a";
        },
        B(_) => {
            return "b";
        },
    }
}
