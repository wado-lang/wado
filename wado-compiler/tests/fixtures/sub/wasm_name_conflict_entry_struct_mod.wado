// Module defining struct Widget with value() method.
// Uses a free function constructor to avoid aliased static method call issues.

pub struct Widget {
    pub label: i32,
}

impl Widget {
    pub fn value(&self) -> i32 {
        return self.label * 2;
    }
}

pub fn make_lib_widget(n: i32) -> Widget {
    return Widget { label: n };
}
