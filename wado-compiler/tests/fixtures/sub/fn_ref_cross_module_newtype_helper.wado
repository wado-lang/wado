// Helper exposing a function whose parameter type is a newtype declared in
// this module. Importing the function and using `let f = scale` from another
// module exercises the resolver's cross-module type-resolution path: the
// newtype name "Pixels" only exists in this module's scope.

pub type Pixels = i32;

pub fn scale(p: Pixels) -> Pixels {
    return (p as i32 * 2) as Pixels;
}
