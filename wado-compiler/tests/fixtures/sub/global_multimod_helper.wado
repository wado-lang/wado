// Helper module with global variables for multi-module initialization test

// Counter that gets initialized
pub global mut HELPER_COUNTER: i32 = compute_initial();

fn compute_initial() -> i32 {
    return 42;
}

pub fn get_counter() -> i32 {
    return HELPER_COUNTER;
}

pub fn increment() {
    HELPER_COUNTER = HELPER_COUNTER + 1;
}
