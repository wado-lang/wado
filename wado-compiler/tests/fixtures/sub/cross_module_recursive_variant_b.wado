//! Module B of the cross-module recursive-variant regression. Same type names
//! (`Child` / `Node`) and shape as module A; only the values differ. The two
//! same-named recursive types must stay distinct through WIR lowering.

pub variant Child {
    Leaf(i32),
    Node(Node),
}

pub struct Node {
    pub kind: i32,
    pub children: List<Child>,
}

pub fn make_b() -> Node {
    return Node {
        kind: 5,
        children: [Child::Node(Node { kind: 7, children: [] }), Child::Leaf(20)],
    };
}

pub fn sum_b(n: &Node) -> i32 {
    let mut total = n.kind;
    for let c of &n.children {
        if let Node(inner) = c {
            total += sum_b(inner);
        }
    }
    return total;
}
