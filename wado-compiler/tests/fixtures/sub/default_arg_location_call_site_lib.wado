// Helper for `default_arg_location_call_site`. Returns its location-literal
// defaults so the caller can assert they reflect the call site, not this file.

pub fn loc(file: String = #file, line: i32 = #line, fun: String = #function) -> [String, i32, String] {
    return [file, line, fun];
}

// Nested default: `loc()` is itself defaulted.
pub fn wrap(info: [String, i32, String] = loc()) -> [String, i32, String] {
    return info;
}
