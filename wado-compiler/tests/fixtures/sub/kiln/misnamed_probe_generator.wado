// A Kiln generator whose probe names a parameter no host supplies.

use { Request, Response, Error } from "core:kiln";

export fn probe(bytes: Stream<u8>) -> Result<u64, Error> {
    bytes.drop();
    return Result::Ok(u64::MAX);
}

export fn generate(req: Request) -> Result<Response, Error> {
    return Result::Ok(Response { files: [] });
}
