// Options wide enough to pass through memory, holding a record another module
// declares.

use { TreeMap } from "core:collections";
use { Rule } from "./wide_rule.wado";

export struct Options {
    pub sizes: TreeMap<String, i32>,
    pub rules: List<Rule> = [],
    pub a: List<String> = [],
    pub b: List<String> = [],
    pub on: bool = true,
}
