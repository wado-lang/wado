// A Kiln generator whose list and map options default to literals.

use { Request, Response, OutputFile, Error } from "core:kiln";
use { TreeMap } from "core:collections";

export struct Options {
    pub sizes: TreeMap<String, i32> = { small: 1, large: 3 },
    pub tags: List<String> = ["a", "b"],
}

export fn generate(req: Request<Options>) -> Result<Response, Error> {
    let mut spelled: List<String> = [];
    for let [k, v] of req.options.sizes.entries() {
        spelled.push(`${k}=${v}`);
    }
    return Result::Ok(Response {
        files: [OutputFile {
            path: "greeting.wado",
            content: `pub fn greeting() -> String { return "${spelled.join(",")};${req.options.tags.join(",")}"; }`,
            is_entry: true,
        }],
    });
}
