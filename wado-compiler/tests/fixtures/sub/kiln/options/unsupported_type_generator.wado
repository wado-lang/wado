// A Kiln generator declaring an option of a type no options table can express.

use { Request, Response, OutputFile, Error } from "core:kiln";

export struct Options {
    pub verbose: [bool, bool],
}

export fn generate(req: Request<Options>) -> Result<Response, Error> {
    let _ = req.options.verbose;
    return Result::Ok(Response {
        files: [OutputFile {
            path: "greeting.wado",
            content: "pub fn greeting() -> String { return \"hi\"; }",
            is_entry: true,
        }],
    });
}
