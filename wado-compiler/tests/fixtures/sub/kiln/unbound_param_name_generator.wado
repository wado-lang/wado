// A Kiln generator naming a wire parameter it never declared.

use { Request, Response, OutputFile, Error } from "core:kiln";

export fn generate(req: Request) -> Result<Response, Error> {
    return Result::Ok(Response {
        files: [OutputFile {
            path: "out.wado",
            content: `${req.origin().header()}pub fn total() -> i32 { return ${module.len()}; }`,
            is_entry: true,
        }],
    });
}
