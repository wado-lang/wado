// A Kiln generator turning a number written as text into `hello()` returning
// it, and reporting an input that is not text as its own error.

use { Request, Response, OutputFile, Error, read_text } from "core:kiln";

export fn generate(req: Request) -> Result<Response, Error> {
    let text = match read_text(req.primary.content) {
        Ok(text) => text,
        Err(e) => { return Result::Err(Error::InvalidSchema(`schema is not text: ${e}`)); },
    };
    return Result::Ok(Response {
        files: [OutputFile {
            path: "out.wado",
            content: `pub fn hello() -> i32 { return ${text.trim()}; }`,
            is_entry: true,
        }],
    });
}
