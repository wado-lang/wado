// A Kiln generator that logs through `core:log` with no sink installed.

use { Request, Response, OutputFile, Error } from "core:kiln";
use { info } from "core:log";

export fn generate(req: Request) -> Result<Response, Error> {
    info("generating", { path: req.primary.path });
    return Result::Ok(Response {
        files: [OutputFile {
            path: "out.wado",
            content: "pub fn logged() -> bool { return true; }",
            is_entry: true,
        }],
    });
}
