// A Kiln generator writing `#function` into what it generates.

use { Request, Response, OutputFile, Error } from "core:kiln";

export fn generate(req: Request) -> Result<Response, Error> {
    return Result::Ok(Response {
        files: [OutputFile {
            path: "out.wado",
            content: `${req.origin().header()}pub fn generator_function() -> String { return "${#function}"; }`,
            is_entry: true,
        }],
    });
}
