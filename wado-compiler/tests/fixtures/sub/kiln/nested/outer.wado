// A Kiln generator whose own source imports what another generator produces,
// and whose output carries that value out to the program.

use { Request, Response, OutputFile, Error } from "core:kiln";
use { hello } from "./value.txt"
    with {
        generator: { module: "../text_generator.wado" },
    };

export fn generate(req: Request) -> Result<Response, Error> {
    let _ = req.primary.path;
    return Result::Ok(Response {
        files: [OutputFile {
            path: "model.wado",
            content: `pub fn model() -> i32 { return ${hello()}; }`,
            is_entry: true,
        }],
    });
}
