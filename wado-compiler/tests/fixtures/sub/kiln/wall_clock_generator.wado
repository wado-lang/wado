// A Kiln generator installing a sink that stamps each event with the wall
// clock. The generator world has no clock, and `WallClock::now()` is
// `#[ambient(SystemClock)]`, so it answers `null` rather than importing one.

use { Request, Response, OutputFile, Error } from "core:kiln";
use { Clock, Log, TextSink, WallClock, info } from "core:log";

export fn generate(req: Request) -> Result<Response, Error> {
    let mut sink: TextSink<WallClock> = TextSink {};
    with Log => &mut sink do {
        info(`generating`, { path: req.primary.path });
    }
    let stamped = WallClock::now() matches { Some(_) };
    return Result::Ok(Response {
        files: [OutputFile {
            path: "out.wado",
            content: `pub fn stamped() -> bool { return ${stamped}; }`,
            is_entry: true,
        }],
    });
}
