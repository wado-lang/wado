// Module B: struct Config with different fields, and a Container with a method returning Config
pub struct Config {
    name: String,
    count: i32,
}

pub struct ContainerB {
    config: Config,
}

impl ContainerB {
    pub fn get_config(&self) -> Config {
        return self.config;
    }

    pub fn make(n: String, c: i32) -> ContainerB {
        return ContainerB { config: Config { name: n, count: c } };
    }
}
