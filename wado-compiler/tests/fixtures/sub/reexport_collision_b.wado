//! The real definer of the `Widget` re-exported through
//! reexport_collision_barrel.wado (see ../reexport_collision.wado). Same name
//! as reexport_collision_a.wado's `Widget` but a different field layout.

pub struct Widget { pub x: i32, pub y: i32, pub z: i32 }

pub fn mk_b() -> Widget {
    return Widget { x: 10, y: 20, z: 30 };
}
