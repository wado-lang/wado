// The traits and the base type for `trait_depth_ignores_impl_module` and
// `trait_newtype_concrete_impl_outranks_foreign_base`, declared where the
// calling module does not own them.
pub trait Limit with () {
    fn limit() -> i32;
}

pub trait Base with () {
    fn base() -> i32;
}

pub trait Describe with () {
    fn describe(&self) -> String;
}

pub struct Inner {
    pub x: i32,
}
