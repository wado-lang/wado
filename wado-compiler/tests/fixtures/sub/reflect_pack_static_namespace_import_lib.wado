pub struct Rec {}

impl Rec {
    pub fn count<S: ReflectStruct<FieldTypes = [..F]>, ..F>(v: &S) -> i32 {
        let mut n = 0;
        for let f of ReflectStruct::<S>::members() {
            n += 1;
        }
        return n;
    }

    pub fn holes<T: ReflectTemplate<Holes = [..V]>, ..V>(t: T) -> i32 {
        let mut n = 0;
        for let h of ReflectTemplate::<T>::members() {
            n += 1;
        }
        return n;
    }
}
