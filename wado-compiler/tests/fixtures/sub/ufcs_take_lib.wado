pub struct AUnit {}

pub struct BUnit {}

pub struct Holder {
    pub id: i32,
}

pub trait Take<T> {
    fn take(&self, x: T) -> String;
}

impl Take<AUnit> for Holder {
    fn take(&self, x: AUnit) -> String {
        return "took A";
    }
}

impl Take<BUnit> for Holder {
    fn take(&self, x: BUnit) -> String {
        return "took B";
    }
}
