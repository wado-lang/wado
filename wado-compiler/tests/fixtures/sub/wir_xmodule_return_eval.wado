//! Repro lib for a WIR miscompile (issue #1415; see ../wir_xmodule_return.wado).
//!
//! `first_node_child` returns the imported parser's `CstNode` *by value*. When
//! this lives in an imported (non-entry) module and the result is borrowed and
//! recursed on, `lookup_function_return_type` re-resolves the return type via
//! the loaded-module path and yields a non-canonical `TypeId` for the
//! cross-module struct, so the binding's local is lowered as `i32` instead of a
//! GC ref ("expected i32, found (ref $type)"). Putting the same code in the
//! entry uses the pre-resolved cache instead and compiles fine.

use mini from "./wir_xmodule_return_parser.wado";

fn first_node_child(node: &mini::CstNode) -> mini::CstNode {
    for let child of &node.children {
        if let Node(n) = *child {
            return n;
        }
    }
    panic("expected a child rule node");
}

/// Nesting depth of the parsed `expr`: `((1))` → 3, `(1)` → 2, `1` → 1.
pub fn depth(input: &String) -> i32 {
    let r = mini::parse(input);
    let top = first_node_child(&r.root);
    return go(&top);
}

fn go(node: &mini::CstNode) -> i32 {
    return match mini::expr_alt(node) {
        Num => 1,
        Paren => {
            let inner = first_node_child(node);
            1 + go(&inner)
        },
    };
}
