pub struct Pt { pub x: i32 }

pub type Loc = Pt;

pub struct Wide { pub n: i64 }

impl From<i64> for Wide {
    fn from(value: i64) -> Wide { return Wide { n: value }; }
}

impl From<String> for Wide {
    fn from(value: String) -> Wide { return Wide { n: value.len() as i64 }; }
}

pub type Meters = f64;
