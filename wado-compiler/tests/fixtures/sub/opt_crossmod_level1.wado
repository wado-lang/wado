// Level 1: generic array utilities for cross-module optimization test.
// These generic functions are defined here but monomorphized in the
// modules that first use them — testing cross-module inline resolution.

pub struct Pair<T> {
    pub first: T,
    pub second: T,
}

pub fn make_pair<T>(a: T, b: T) -> Pair<T> {
    return Pair { first: a, second: b };
}

pub fn pair_to_array<T>(p: Pair<T>) -> List<T> {
    return [p.first, p.second];
}
