pub struct Wrap<T> {
    pub v: T,
}

impl<T> Wrap<T> {
    pub fn id(v: T) -> T {
        return v;
    }

    pub fn make(v: T) -> Wrap<T> {
        return Wrap { v };
    }

    pub fn take(w: Wrap<T>) -> T {
        return w.v;
    }
}

pub type Same<T> = Wrap<T>;
pub type Listed<T> = Wrap<List<T>>;
