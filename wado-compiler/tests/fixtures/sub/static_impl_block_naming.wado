// The imported half of `static_impl_block_naming.wado`: a generic type whose
// concrete impl the importing module writes, and a type whose static declares a
// default the importing module reaches only through an alias.

pub struct Cell<T> {
    pub v: T,
}

pub struct Bytes {
    pub n: i32,
}

impl Bytes {
    pub fn make(n: i32 = 1) -> Bytes {
        return Bytes { n: n };
    }
}
