pub struct Wrapper<T> {
    pub value: T,
}

impl<T> Wrapper<T> {
    pub fn make(value: T) -> Wrapper<T> {
        return Wrapper { value };
    }

    pub fn tagged<U>(value: T, tag: U) -> Wrapper<T> {
        let _ = tag;
        return Wrapper { value };
    }
}

pub variant Maybe<T> {
    Just(T),
    Nothing,
}

pub variant Either<L, R> {
    Left(L),
    Right(R),
}

pub trait Take<A> with () {
    fn take(&self, a: A) -> A;
}

impl Take<i32> for i32 {
    fn take(&self, a: i32) -> i32 {
        return *self + a;
    }
}
