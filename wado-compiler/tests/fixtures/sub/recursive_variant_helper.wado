pub struct Node {
    pub name: String,
    pub kind: NodeKind,
}

pub variant NodeKind {
    Leaf(LeafData),
    Branch(BranchData),
}

pub struct LeafData {
    pub value: i32,
}

pub struct BranchData {
    pub child: Node,
}

pub fn depth(n: &Node) -> i32 {
    if let Leaf(_) = n.kind {
        return 1;
    }
    if let Branch(b) = n.kind {
        return 1 + depth(&b.child);
    }
    return 0;
}
