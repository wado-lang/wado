// Module A: struct Config with a single field, and a Container with a method returning Config
pub struct Config {
    pub value: i32,
}

pub struct ContainerA {
    pub config: Config,
}

impl ContainerA {
    pub fn get_config(&self) -> Config {
        return self.config;
    }

    pub fn make(v: i32) -> ContainerA {
        return ContainerA { config: Config { value: v } };
    }
}
