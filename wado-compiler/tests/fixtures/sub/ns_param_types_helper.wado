pub struct Acc {
    pub total: i32,
}

impl Acc {
    pub fn sum(xs: List<i32>) -> i32 {
        let mut t = 0;
        for let x of xs {
            t = t + x;
        }
        return t;
    }
}

pub fn sum_free(xs: List<i32>) -> i32 {
    let mut t = 0;
    for let x of xs {
        t = t + x;
    }
    return t;
}
