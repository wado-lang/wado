// Test: Index traits with static methods
use { println, Stdout } from "core:cli";

struct Value {
    n: i32,
}

impl Value {
    fn new(n: i32) -> Value {
        return Value { n };
    }

    fn double(&mut self) {
        self.n = self.n * 2;
    }
}

struct Container {
    item: Value,
}

impl Container {
    fn new() -> Container {
        return Container { item: Value::new(10) };
    }
}

impl<i32> Index<i32> for Container {
    type Output = Value;

    fn index(&self, _idx: i32) -> &Self::Output {
        return &self.item;
    }
}

impl<i32> IndexMut<i32> for Container {
    type Output = Value;

    fn index_mut(&mut self, _idx: i32) -> &mut Self::Output {
        return &mut self.item;
    }
}

impl<i32> IndexAssign<i32> for Container {
    type Input = Value;

    fn index_assign(&mut self, _idx: i32, value: Self::Input) {
        self.item = value;
    }
}

export fn run() with Stdout {
    let mut c = Container::new();

    // Read via Index
    let v = c[0];
    println(`Initial: {v.n}`);

    // Mutate via IndexMut
    c[0].double();
    println(`After double: {c.item.n}`);

    // Assign via IndexAssign
    c[0] = Value::new(100);
    println(`After assign: {c.item.n}`);
}

__DATA__
{"stdout": "Initial: 10\nAfter double: 20\nAfter assign: 100\n"}
