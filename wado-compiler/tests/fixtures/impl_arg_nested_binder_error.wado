// `impl<T> Nest<[i32, T]>` must not apply to a `Nest<i32>`.
//
// A binder is a wildcard only where the header can bind it, which is as a bare
// argument. `[i32, T]` gives `T` no slot, so no receiver can instantiate this
// impl and it is selected for none — a diagnostic rather than a panic.

use { Nest } from "./sub/impl_arg_shapes_holder.wado";

export fn run() {
    let n = Nest { a: 7 };
    let _ = n.pair();
}

