// An async import returns an `AsyncCall<T>` at once; a handler that resumes
// with a `T` hands the caller one that has already completed.
use { Headers, Trailers } from "wasi:http";

use { Client, Request, Response, ErrorCode } from "wasi:http";

fn fetch(req: Request) -> Result<Response, ErrorCode> with Client {
    let call = Client::send(req);   // the request starts; nothing waits yet
    // ... work here runs while the host handles the request ...
    return call.wait();             // blocks until the response arrives
}

test {
    let mut mock = MockClient {};
    let fetched = with Client => &mut mock do { fetch(mock.new_request()) matches { Ok(_) } };
    assert fetched;
    mock.end_writes();
}

// Nothing reads the trailers of what the mock makes, and an end dropped
// unwritten traps, so the mock keeps each writable end until the test is done.
affine struct MockClient {
    ends: List<FutureWritable<Result<Option<Trailers>, ErrorCode>>> = [],
}

impl MockClient {
    fn new_request(&mut self) -> Request {
        let [trailers, end] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
        self.ends.push(end);
        let [req, _done] = Request::new(Headers::new(), null, trailers, null);
        return req;
    }

    fn canned_response(&mut self) -> Response {
        let [trailers, end] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
        self.ends.push(end);
        let [resp, _done] = Response::new(Headers::new(), null, trailers);
        return resp;
    }

    fn end_writes(&mut self) {
        while let Some(end) = self.ends.pop() {
            end.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
        }
    }
}

impl Client for MockClient {
    fn send(&mut self, request: Request) -> Result<Response, ErrorCode> {
        resume Result::<Response, ErrorCode>::Ok(self.canned_response());
    }
}

test {
    let mut mock = MockClient {};
    with Client => &mut mock do {
        let call = Client::send(mock.new_request());
        assert call.wait() matches { Ok(_) };   // completed already
    };
    mock.end_writes();
}

__DATA__
{"test": {}}
