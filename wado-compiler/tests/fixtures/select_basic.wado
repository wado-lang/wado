use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // i32 (default integer type)
    let a = 10;
    let b = 20;
    let max = if a > b { a } else { b };
    println(`{max}`);

    // i32 literals
    let x = if true { 42 } else { 0 };
    println(`{x}`);

    // i32 false condition
    let y = if false { 100 } else { 200 };
    println(`{y}`);

    // i64
    let a64 = 10 as i64;
    let b64 = 20 as i64;
    let max64 = if a64 > b64 { a64 } else { b64 };
    println(`{max64}`);

    // i8
    let a8 = 10 as i8;
    let b8 = 20 as i8;
    let min8 = if a8 < b8 { a8 } else { b8 };
    println(`{min8}`);

    // i16
    let a16 = 10 as i16;
    let b16 = 20 as i16;
    let min16 = if a16 < b16 { a16 } else { b16 };
    println(`{min16}`);

    // u8
    let ua = 10 as u8;
    let ub = 20 as u8;
    let umax = if ua > ub { ua } else { ub };
    println(`{umax}`);

    // u16
    let ua16 = 10 as u16;
    let ub16 = 20 as u16;
    let umax16 = if ua16 > ub16 { ua16 } else { ub16 };
    println(`{umax16}`);

    // u32
    let ua32 = 10 as u32;
    let ub32 = 20 as u32;
    let umax32 = if ua32 > ub32 { ua32 } else { ub32 };
    println(`{umax32}`);

    // u64
    let ua64 = 10 as u64;
    let ub64 = 20 as u64;
    let umax64 = if ua64 > ub64 { ua64 } else { ub64 };
    println(`{umax64}`);

    // bool
    let bt = true;
    let bf = false;
    let bsel = if bt { bt } else { bf };
    println(`{bsel}`);
}

__DATA__
{"stdout": "20\n42\n200\n20\n10\n10\n20\n20\n20\n20\ntrue\n"}
