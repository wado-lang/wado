// Two `From` impls for one type: the expected type for the argument is looked
// up by (receiver, method) name alone, so it can come from a different impl
// than the one the argument's type then selects. When they disagree no trait
// matches, and a trait-less `Wrapper::from` used to reach WIR build and ICE
// ("unresolved Call"). An unresolvable call must be a compile error.
struct Wrapper {
    tag: i32,
}

impl From<String> for Wrapper {
    fn from(value: String) -> Wrapper {
        return Wrapper { tag: 1 };
    }
}

impl From<i64> for Wrapper {
    fn from(value: i64) -> Wrapper {
        return Wrapper { tag: 2 };
    }
}

export fn run() {
    let a = Wrapper::from(42);
    assert a.tag == 2;
}

__DATA__
{"compile_error": "no impl of 'From' for 'Wrapper' takes an argument of type 'i32'"}
