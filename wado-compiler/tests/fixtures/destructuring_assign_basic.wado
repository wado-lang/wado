// A destructuring assignment assigns each target its element of the right
// side: locals, fields, subscripts and a global, from a tuple literal or from
// any value of a tuple type. The tuple of the targets' types is the right
// side's expected type, so literals take the targets' types.

struct Point {
    x: String,
    y: String,
}

global mut COUNT: i32 = 0;

fn divmod(n: i32, d: i32) -> [i32, i32] {
    return [n / d, n % d];
}

test "a transposition and a rotation of locals" {
    let mut a = 1;
    let mut b = 2;
    let mut c = 3;
    [a, b] = [b, a];
    assert a == 2 && b == 1;
    [a, b, c] = [b, c, a];
    assert a == 1 && b == 3 && c == 2;
}

test "fields, subscripts and a global" {
    let mut s = Point { x: "x", y: "y" };
    [s.x, s.y] = [s.y, s.x];
    assert s.x == "y" && s.y == "x";

    let mut xs: List<String> = ["a", "b", "c"];
    [xs[0], xs[2]] = [xs[2], xs[0]];
    assert xs == ["c", "b", "a"];

    let mut n = 0;
    [COUNT, n] = [5, COUNT];
    assert COUNT == 5 && n == 0;
}

test "a value of a tuple type" {
    let mut q = 0;
    let mut r = 0;
    [q, r] = divmod(17, 5);
    assert q == 3 && r == 2;
}

test "the targets' types are the expected type" {
    let mut big: i64 = 0;
    let mut small: u8 = 0;
    [big, small] = [1 << 40, 255];
    assert big == 1 << 40 && small == 255;

    let mut xs: List<i32> = [1];
    let mut ys: List<String> = ["a"];
    [xs, ys] = [[], []];
    assert xs.is_empty() && ys.is_empty();
}

struct Sink {
    last: i64,
}

impl IndexAssign<i32> for Sink {
    type Output = i64;
    fn index_assign(&mut self, index: i32, value: i64) {
        self.last = index as i64 + value;
    }
}

test "a target that takes IndexAssign alone, and its Output" {
    let mut s = Sink { last: 0 };
    let mut b = 0;
    [s[1], b] = [1 << 40, 6];
    assert s.last == (1 << 40) + 1 && b == 6;
}

test "a write inside a closure" {
    let mut a = 1;
    let mut b = 2;
    let mut swap = || {
        [a, b] = [b, a];
    };
    swap();
    assert a == 2 && b == 1;
}

global mut DROPS: i32 = 0;

affine struct Conn {
    id: i32,
}

impl Drop for Conn {
    fn drop(self) {
        DROPS += 1;
    }
}

fn pair(a: Conn, b: Conn) -> [Conn, Conn] {
    return [b, a];
}

test "affine values move into their targets" {
    let mut a = Conn { id: 1 };
    let mut b = Conn { id: 2 };
    [a, b] = [b, a];
    assert a.id == 2 && b.id == 1;
    [a, b] = pair(a, b);
    assert a.id == 1 && b.id == 2;
    assert DROPS == 0;
}

__DATA__
{"test": {}}
