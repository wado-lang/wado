// A substitution may land on a shape a literal already wrote, or that another
// origin already reached: each origin's derived methods still reach it.
use { println, Stdout } from "core:cli";

fn first<X>(x: X) -> X {
    let s = { a: x };
    return s.a;
}

fn same<Y: Ord>(y: Y) -> bool {
    let s = { a: y };
    return s == { a: y } && !(s < { a: y });
}

export fn run() with Stdout {
    let written = { a: 3 };
    println(`${written.a} ${first(1)} ${same(2)}`);
}

__DATA__
{"stdout": "3 1 true\n"}
