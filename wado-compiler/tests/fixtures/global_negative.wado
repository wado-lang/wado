use { println, Stdout } from "core:cli";

// from global_negative.wado
global POW10_MIN: i32 = -348;

// from global_negative_edge.wado
global NEGATIVE_ONE: i64 = -1;
global I64_MIN: i64 = -9223372036854775808;

// from global_negative.wado
fn global_negative() with Stdout {
    println(`POW10_MIN={POW10_MIN}`);
}

// from global_negative_edge.wado
fn global_negative_edge() with Stdout {
    println(`NEGATIVE_ONE={NEGATIVE_ONE}`);
    println(`I64_MIN={I64_MIN}`);
}

export fn run() with Stdout {
    global_negative();
    global_negative_edge();
}

__DATA__
{"stdout": "POW10_MIN=-348\nNEGATIVE_ONE=-1\nI64_MIN=-9223372036854775808\n"}
