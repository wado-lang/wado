// A `&mut` a pattern binds lasts for its arm, so a function cannot return one.

variant Shape {
    Circle(i32),
    Dot,
}

fn payload(held: &mut Option<Shape>) -> &mut Shape {
    return match held {
        Some(shape) => shape,
        _ => panic("empty"),
    };
}

test "a write through a binding a match returns" {
    let mut held: Option<Shape> = Option::Some(Shape::Circle(1));
    let shape = payload(&mut held);
    *shape = Shape::Dot;
}

__DATA__
{
    "test": {},
    "compile_error": "a returned value cannot hold a `&mut Shape`"
}
