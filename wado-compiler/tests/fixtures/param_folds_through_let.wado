// A compile-time parameter bound to a local still settles the gate: the binding
// is a trivial copy, so copy propagation drops it and leaves the parameter read
// in the condition, which folds. `guarded` must not survive at `-O2`.
//
// This does not hold for a binding whose copy is not trivial — a `String`
// parameter is deep-copied through `array_clone_prefix`, which no pass removes,
// so the gate is still decided at run time there. `remarks.rs` reports that
// case rather than leaving it silent.
use { println, Stdout } from "core:cli";

#[param(name = "log.level")]
global LOG_LEVEL: i32 = 0;

fn guarded() -> String {
    return `this text only exists inside the folded branch`;
}

export fn run() with Stdout {
    let level = LOG_LEVEL;
    if level < 2 {
        println(guarded());
    }
    println(`done`);
}

__DATA__
{
    "params": { "log.level": "5" },
    "stdout": "done\n",
    "wir_not_expect:O2": ["this text only exists inside the folded branch"]
}
