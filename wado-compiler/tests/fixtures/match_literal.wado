// Literal patterns at every width and kind: bool, char, each integer type,
// negatives, and the 128-bit types whose match lowers to an if-else chain.

global mut OBSERVED: i32 = 0;

fn observe(value: i128) -> i128 {
    OBSERVED = OBSERVED + 1;
    return value;
}

fn observe_u(value: u128) -> u128 {
    OBSERVED = OBSERVED + 1;
    return value;
}

test "bool literal patterns" {
    let t = true;
    let f = false;
    assert match t { true => "yes", false => "no" } == "yes";
    assert match f { true => "yes", false => "no" } == "no";
    assert match t { false => "no", _ => "yes" } == "yes";
}

test "char literal patterns" {
    assert match 'a' { 'a' => "letter a", 'b' => "letter b", _ => "other" } == "letter a";
    assert match 'z' { 'a' => "letter a", 'z' => "letter z", _ => "other" } == "letter z";
    assert match '\n' { '\n' => "newline", '\t' => "tab", _ => "other" } == "newline";
}

test "i8 literal patterns" {
    let x: i8 = 42 as i8;
    let y: i8 = 0 as i8;
    let z: i8 = -1 as i8;
    assert match x { 0 => "zero", 1 => "one", 42 => "answer", _ => "other" } == "answer";
    assert match y { 0 => "zero", _ => "other" } == "zero";
    assert match z { 0 => "zero", -1 => "minus one", _ => "other" } == "minus one";
}

test "i16 literal patterns" {
    let x: i16 = 42 as i16;
    let y: i16 = 0 as i16;
    let z: i16 = -100 as i16;
    assert match x { 0 => "zero", 42 => "answer", _ => "other" } == "answer";
    assert match y { 0 => "zero", _ => "other" } == "zero";
    assert match z { 0 => "zero", -100 => "minus hundred", _ => "other" } == "minus hundred";
}

test "i32 literal patterns" {
    let x: i32 = 42;
    let y: i32 = 0;
    let z: i32 = -1;
    assert match x { 0 => "zero", 1 => "one", 42 => "answer", _ => "other" } == "answer";
    assert match y { 0 => "zero", 1 => "one", _ => "other" } == "zero";
    assert match z { 0 => "zero", -1 => "minus one", _ => "other" } == "minus one";
}

test "i64 literal patterns" {
    let x: i64 = 42 as i64;
    let y: i64 = 0 as i64;
    let large: i64 = 1000000000000 as i64;
    assert match x { 0 => "zero", 1 => "one", 42 => "answer", _ => "other" } == "answer";
    assert match y { 0 => "zero", 1 => "one", _ => "other" } == "zero";
    assert match large { 0 => "zero", 1000000000000 => "trillion", _ => "other" } == "trillion";
}

test "u8 literal patterns" {
    let x: u8 = 42 as u8;
    let y: u8 = 0 as u8;
    let max: u8 = 255 as u8;
    assert match x { 0 => "zero", 42 => "answer", _ => "other" } == "answer";
    assert match y { 0 => "zero", _ => "other" } == "zero";
    assert match max { 0 => "zero", 255 => "max u8", _ => "other" } == "max u8";
}

test "u16 literal patterns" {
    let x: u16 = 42 as u16;
    let y: u16 = 0 as u16;
    let large: u16 = 65535 as u16;
    assert match x { 0 => "zero", 42 => "answer", _ => "other" } == "answer";
    assert match y { 0 => "zero", _ => "other" } == "zero";
    assert match large { 0 => "zero", 65535 => "max u16", _ => "other" } == "max u16";
}

test "u32 literal patterns" {
    let x: u32 = 42 as u32;
    let y: u32 = 0 as u32;
    let large: u32 = 4000000000 as u32;
    assert match x { 0 => "zero", 42 => "answer", _ => "other" } == "answer";
    assert match y { 0 => "zero", _ => "other" } == "zero";
    assert match large { 0 => "zero", 4000000000 => "four billion", _ => "other" } == "four billion";
}

test "u64 literal patterns" {
    let x: u64 = 42 as u64;
    let y: u64 = 0 as u64;
    let large: u64 = 10000000000000 as u64;
    assert match x { 0 => "zero", 42 => "answer", _ => "other" } == "answer";
    assert match y { 0 => "zero", _ => "other" } == "zero";
    assert match large { 0 => "zero", 10000000000000 => "ten trillion", _ => "other" } == "ten trillion";
}

test "negative literal patterns" {
    let a: i32 = -1;
    assert match a { 0 => "zero", -1 => "minus one", _ => "other" } == "minus one";
    let b: i32 = -100;
    assert match b { -100 => "minus hundred", -1 => "minus one", _ => "other" } == "minus hundred";
    let c: i64 = -1000000000000 as i64;
    assert match c { 0 => "zero", -1000000000000 => "minus trillion", _ => "other" }
        == "minus trillion";
    // Positive and negative in one match.
    let d: i32 = 42;
    assert match d { -42 => "minus answer", 0 => "zero", 42 => "answer", _ => "other" } == "answer";
    // A negative as the first pattern.
    let e: i32 = -5;
    assert match e { -5 => "minus five", 5 => "five", _ => "other" } == "minus five";
}

test "i128 and u128 literal patterns" {
    let x: i128 = 42 as i128;
    assert match x { 0 => "zero", 42 => "answer", _ => "other" } == "answer";
    let u: u128 = 42 as u128;
    assert match u { 0 => "zero", 42 => "answer", _ => "other" } == "answer";
}

// The wide-int `match` lowers to an if-else chain over `Eq::eq` calls, which
// once dropped the arm guard, truncated a literal past 64 bits, and re-ran a
// side-effecting scrutinee once per arm.

test "a guard on a wide-int arm is kept" {
    let x: i128 = 42 as i128;
    let positive = true;
    assert match x { 42 && positive => "answer_positive", 42 => "answer", _ => "other" }
        == "answer_positive";
    assert match x { 42 && false => "should_not_fire", 42 => "answer", _ => "other" } == "answer";

    let u: u128 = 7 as u128;
    let small = true;
    assert match u { 7 && small => "seven_small", 7 => "seven", _ => "other" } == "seven_small";
    assert match u { 7 && false => "should_not_fire", _ => "other" } == "other";
}

test "a binding catch-all on a wide int is assigned before its guard runs" {
    // The if-else rewrite treated `Binding` as a value-less catch-all, so `y`
    // referenced an uninitialized slot.
    let bind: i128 = 99 as i128;
    assert match bind { 42 => "answer", y && y > 10 as i128 => "big", _ => "other" } == "big";
}

test "a wide-int literal past 64 bits is not truncated" {
    // `create_i128_literal` built the arm-side value with
    // `i128::from_i64(value as i64)`, truncating everything above bit 63.
    let x: i128 = 9223372036854775808;
    assert match x { 9223372036854775808 => "i64_max_plus_one", _ => "other" }
        == "i64_max_plus_one";
    let y: i128 = -9223372036854775809;
    assert match y { -9223372036854775809 => "i64_min_minus_one", _ => "other" }
        == "i64_min_minus_one";
    let z: i128 = 170141183460469231731687303715884105727;
    assert match z { 170141183460469231731687303715884105727 => "i128_max", _ => "other" }
        == "i128_max";
    let small: i128 = 42 as i128;
    assert match small { 0 => "zero", 42 => "answer", _ => "other" } == "answer";

    let u: u128 = 18446744073709551616;
    assert match u { 18446744073709551616 => "u64_max_plus_one", _ => "other" }
        == "u64_max_plus_one";
    let u2: u128 = 340282366920938463463374607431768211455;
    assert match u2 { 340282366920938463463374607431768211455 => "u128_max", _ => "other" }
        == "u128_max";
    // The truncation could also alias a large pattern onto a small scrutinee.
    let small_u: u128 = 1 as u128;
    assert match small_u { 18446744073709551616 => "u64_max_plus_one", 1 => "one", _ => "other" }
        == "one";
}

test "a wide-int scrutinee is evaluated exactly once" {
    // The rewrite cloned the scrutinee `TirExpr` into every arm's `Eq::eq`
    // condition, so a side-effecting scrutinee ran once per arm tested.
    OBSERVED = 0;
    let r1 = match observe(30 as i128) { 10 => "ten", 20 => "twenty", 30 => "thirty", _ => "other" };
    assert r1 == "thirty";
    assert OBSERVED == 1;

    OBSERVED = 0;
    let r2 = match observe(99 as i128) { 10 => "ten", 20 => "twenty", 30 => "thirty", _ => "other" };
    assert r2 == "other";
    assert OBSERVED == 1;

    OBSERVED = 0;
    let r3 = match observe_u(7 as u128) { 1 => "one", 7 => "seven", _ => "other" };
    assert r3 == "seven";
    assert OBSERVED == 1;
}
