use { println, Stdout } from "core:cli";


// from match_literal_bool.wado
fn match_literal_bool() with Stdout {
    let t = true;
    let f = false;

    let r1 = match t {
        true => "yes",
        false => "no",
    };
    println(r1);

    let r2 = match f {
        true => "yes",
        false => "no",
    };
    println(r2);

    // With wildcard
    let r3 = match t {
        false => "no",
        _ => "yes",
    };
    println(r3);
}

// from match_literal_char.wado
fn match_literal_char() with Stdout {
    let a = 'a';
    let z = 'z';
    let newline = '\n';

    let r1 = match a {
        'a' => "letter a",
        'b' => "letter b",
        _ => "other",
    };
    println(r1);

    let r2 = match z {
        'a' => "letter a",
        'z' => "letter z",
        _ => "other",
    };
    println(r2);

    let r3 = match newline {
        '\n' => "newline",
        '\t' => "tab",
        _ => "other",
    };
    println(r3);
}

// from match_literal_i128.wado
fn match_literal_i128() with Stdout {
    let x: i128 = 42 as i128;

    let r1 = match x {
        0 => "zero",
        42 => "answer",
        _ => "other",
    };
    println(r1);
}

// from match_literal_i16.wado
fn match_literal_i16() with Stdout {
    let x: i16 = 42 as i16;
    let y: i16 = 0 as i16;
    let z: i16 = -100 as i16;

    let r1 = match x {
        0 => "zero",
        42 => "answer",
        _ => "other",
    };
    println(r1);

    let r2 = match y {
        0 => "zero",
        _ => "other",
    };
    println(r2);

    let r3 = match z {
        0 => "zero",
        -100 => "minus hundred",
        _ => "other",
    };
    println(r3);
}

// from match_literal_i32.wado
fn match_literal_i32() with Stdout {
    let x: i32 = 42;
    let y: i32 = 0;
    let z: i32 = -1;

    let r1 = match x {
        0 => "zero",
        1 => "one",
        42 => "answer",
        _ => "other",
    };
    println(r1);

    let r2 = match y {
        0 => "zero",
        1 => "one",
        _ => "other",
    };
    println(r2);

    let r3 = match z {
        0 => "zero",
        -1 => "minus one",
        _ => "other",
    };
    println(r3);
}

// from match_literal_i64.wado
fn match_literal_i64() with Stdout {
    let x: i64 = 42 as i64;
    let y: i64 = 0 as i64;
    let large: i64 = 1000000000000 as i64;

    let r1 = match x {
        0 => "zero",
        1 => "one",
        42 => "answer",
        _ => "other",
    };
    println(r1);

    let r2 = match y {
        0 => "zero",
        1 => "one",
        _ => "other",
    };
    println(r2);

    let r3 = match large {
        0 => "zero",
        1000000000000 => "trillion",
        _ => "other",
    };
    println(r3);
}

// from match_literal_i8.wado
fn match_literal_i8() with Stdout {
    let x: i8 = 42 as i8;
    let y: i8 = 0 as i8;
    let z: i8 = -1 as i8;

    let r1 = match x {
        0 => "zero",
        1 => "one",
        42 => "answer",
        _ => "other",
    };
    println(r1);

    let r2 = match y {
        0 => "zero",
        _ => "other",
    };
    println(r2);

    let r3 = match z {
        0 => "zero",
        -1 => "minus one",
        _ => "other",
    };
    println(r3);
}

// from match_literal_negative.wado
fn match_literal_negative() with Stdout {
    // i32 negative
    let a: i32 = -1;
    let r1 = match a {
        0 => "zero",
        -1 => "minus one",
        _ => "other",
    };
    println(r1);

    // i32 larger negative
    let b: i32 = -100;
    let r2 = match b {
        -100 => "minus hundred",
        -1 => "minus one",
        _ => "other",
    };
    println(r2);

    // i64 negative
    let c: i64 = -1000000000000 as i64;
    let r3 = match c {
        0 => "zero",
        -1000000000000 => "minus trillion",
        _ => "other",
    };
    println(r3);

    // Mix positive and negative
    let d: i32 = 42;
    let r4 = match d {
        -42 => "minus answer",
        0 => "zero",
        42 => "answer",
        _ => "other",
    };
    println(r4);

    // Negative as first pattern
    let e: i32 = -5;
    let r5 = match e {
        -5 => "minus five",
        5 => "five",
        _ => "other",
    };
    println(r5);
}

