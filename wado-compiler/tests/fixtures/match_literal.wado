// from match_literal_u8.wado
fn match_literal_u8() with Stdout {
    let x: u8 = 42 as u8;
    let y: u8 = 0 as u8;
    let max: u8 = 255 as u8;

    let r1 = match x {
        0 => "zero",
        42 => "answer",
        _ => "other",
    };
    println(r1);

    let r2 = match y {
        0 => "zero",
        _ => "other",
    };
    println(r2);

    let r3 = match max {
        0 => "zero",
        255 => "max u8",
        _ => "other",
    };
    println(r3);
}

export fn run() with Stdout {
    match_literal_bool();
    match_literal_char();
    match_literal_i128();
    match_literal_i16();
    match_literal_i32();
    match_literal_i64();
    match_literal_i8();
    match_literal_negative();
    match_literal_u128();
    match_literal_u16();
    match_literal_u32();
    match_literal_u64();
    match_literal_u8();
}

__DATA__
{"stdout": "yes\nno\nyes\nletter a\nletter z\nnewline\nanswer\nanswer\nzero\nminus hundred\nanswer\nzero\nminus one\nanswer\nzero\ntrillion\nanswer\nzero\nminus one\nminus one\nminus hundred\nminus trillion\nanswer\nminus five\nanswer\nanswer\nzero\nmax u16\nanswer\nzero\nfour billion\nanswer\nzero\nten trillion\nanswer\nzero\nmax u8\n"}
