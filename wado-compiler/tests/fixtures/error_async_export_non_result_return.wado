// The CLI world declares `run` returning `Result<(), ()>`, and the boundary
// carries what the world declares. An `i32` has nowhere to go in it: the
// delivery flattens the operand against its own type, landing the `1` on the
// world's discriminant, where the host reads it as an error.

export async fn run() -> i32 {
    task return 1;
}

