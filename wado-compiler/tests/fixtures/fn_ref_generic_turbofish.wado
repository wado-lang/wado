// Turbofish on a bare generic function name pins the type parameters and
// produces a typed `fn(...)` value, so it can be bound to a `let` (without
// any annotation) and called.

fn identity<T>(x: T) -> T {
    return x;
}

fn pair<A, B>(a: A, b: B) -> A {
    return a;
}

test "turbofish in let binding" {
    let f = identity::<i32>;
    assert f(42) == 42;
}

test "turbofish with multiple type args" {
    let f = pair::<i32, bool>;
    assert f(7, true) == 7;
}

__DATA__
{"test": {}}
