// A key-value literal building an immutable output type: no builder, no
// mutation methods — one `From<Array<[String, V]>>` impl.
use { println, Stdout } from "core:cli";

struct FrozenMap<V> {
    keys: List<String>,
    values: List<V>,
}

impl FrozenMap<V> {
    fn len(&self) -> i32 {
        return self.keys.len();
    }

    fn get(&self, key: String) -> Option<V> {
        let mut i = 0;
        while i < self.keys.len() {
            if self.keys[i] == key {
                return Option::<V>::Some(self.values[i]);
            }
            i += 1;
        }
        return null;
    }
}

impl From<Array<[String, V]>> for FrozenMap<V> {
    fn from(entries: Array<[String, V]>) -> FrozenMap<V> {
        let mut keys: List<String> = [];
        let mut values: List<V> = [];
        for let [key, value] of entries {
            keys.push(key);
            values.push(value);
        }
        return FrozenMap { keys, values };
    }
}

export fn run() with Stdout {
    let m: FrozenMap<i32> = { x: 10, y: 20, z: 30 };

    assert m.len() == 3;
    if let Some(v) = m.get("x") {
        assert v == 10;
    }
    if let Some(v) = m.get("y") {
        assert v == 20;
    }
    if let Some(v) = m.get("z") {
        assert v == 30;
    }

    // Cast coercion
    let m2 = { a: 1, b: 2 } as FrozenMap<i32>;
    assert m2.len() == 2;

    println("key-value-literal-immutable: ok");
}

__DATA__
{"stdout": "key-value-literal-immutable: ok\n"}
