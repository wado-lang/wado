// A value copied out from behind a `&` is the body's own, and a `&mut` it holds
// writes: the `2` stored before the call is not forwarded past it.

use { println, Stdout } from "core:cli";

struct S {
    f: i32,
}

struct Holder {
    r: &mut S,
}

#[inline(never)]
fn poke(h: &Holder) {
    let copy = *h;
    copy.r.f = 9;   // OK: `copy` is the body's own `Holder`
}

export fn run() with Stdout {
    let mut s = S { f: 1 };
    let h = Holder { r: &mut s };
    s.f = 2;
    poke(&h);
    println(`${s.f}`);
}

__DATA__
{"stdout": "9\n"}
