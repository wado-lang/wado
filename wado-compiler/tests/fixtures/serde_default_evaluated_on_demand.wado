// A field's default is evaluated only where the wire leaves the field out.
use { from_string } from "core:json";

fn boom() -> i32 {
    let xs: List<i32> = [];
    return xs[builtin::black_box(3)];
}

struct Named {
    first: i32 = boom(),
    second: i32 = 7,
}

test "decoding a missing field evaluates that field's default alone" {
    let n = from_string::<Named>("{\"first\":1}").unwrap();
    assert n.first == 1;
    assert n.second == 7;
}

__DATA__
{"test": {}}
