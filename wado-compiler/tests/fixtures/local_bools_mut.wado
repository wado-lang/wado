// Test mutable boolean variables with reassignment

use {println, Stdout} from "core:cli";

fn main() with Stdout {
    let mut flag = false;

    if flag {
        println("flag is true");
    } else {
        println("flag is false");
    }

    flag = true;

    if flag {
        println("flag is true");
    } else {
        println("flag is false");
    }
}
