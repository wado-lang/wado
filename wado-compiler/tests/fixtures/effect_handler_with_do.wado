#![TODO]
// TODO: effect handler installation `with E = h do { ... }`.
//
// Goal state: install a fixed-time `MonotonicClock` mock and observe
// that calls to `MonotonicClock::now()` inside the `do` block return
// the mocked value rather than the real wasmtime clock. This is one
// of the simplest realistic uses of effect handlers — `now()` is a
// plain `() -> Mark` operation, so the test exercises only:
//
// - `with` scope: install / restore the per-effect dispatch global
// - dispatch function for `MonotonicClock::now`
// - `resume value` lowered to `return value` inside the handler body
//
// Specifically, this fixture does NOT depend on:
// - `Stream<T>` / `Future<T>` / `StreamWritable<T>` / `FutureWritable<T>`
//   dispatch (handler body has no I/O), so `MockCM` (buffered CM
//   handlers) is not required here.
// - effect forwarding through nested handler scopes.
//
// `println` outside the `do` block uses real `Stdout` from wasmtime;
// when no user handler is installed for `Stdout`, dispatch lands on
// the null-fast-path that calls the CM adapter directly.
//
// When Phase 2 (resolver + effect-check) and Phase 3 (Wasm GC dispatch
// codegen) of `docs/wep-2026-04-11-effect-handler.md` land, this
// fixture will print "mark: 12345" and the runner will flag that
// `#![TODO]` must be removed.

use { println, Stdout } from "core:cli";
use { Mark, MonotonicClock } from "wasi:clocks";

struct FixedClock {
    mark: Mark,
}

impl MonotonicClock for FixedClock {
    fn now(&self) -> Mark {
        resume self.mark
    }
    ..
}

export fn run() with Stdout {
    let clock = FixedClock { mark: 12345 as Mark };
    with MonotonicClock = &clock do {
        let m = MonotonicClock::now();
        println(`mark: {m}`);
    }
}

__DATA__
{"stdout_contains": ["mark: 12345"]}
