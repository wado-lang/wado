// Install a fixed-time `MonotonicClock` mock and observe that calls
// to `MonotonicClock::now()` inside the `do` block return the mocked
// value. This is one of the simplest realistic uses of effect
// handlers — `now()` is a plain `() -> Mark` operation, so the test
// exercises only the `with` scope, the dispatch wrapper for
// `MonotonicClock::now`, and `resume value` lowered to `return value`
// inside the handler body.
//
// `println` outside the `do` block uses real `Stdout` from wasmtime;
// when no user handler is installed for `Stdout`, the dispatch wrapper
// falls through to the CM adapter directly.

use { println, Stdout } from "core:cli";
use { Mark, MonotonicClock } from "wasi:clocks";

struct FixedClock {
    mark: Mark,
}

impl MonotonicClock for FixedClock {
    fn now(&self) -> Mark {
        resume self.mark
    }
    ..
}

export fn run() with Stdout {
    let clock = FixedClock { mark: 12345 as Mark };
    with MonotonicClock => &clock do {
        let m = MonotonicClock::now();
        println(`mark: {m}`);
    }
}

__DATA__
{"stdout_contains": ["mark: 12345"]}
