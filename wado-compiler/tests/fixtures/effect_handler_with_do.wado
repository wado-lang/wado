use { println, Stdout } from "core:cli";

effect Greet {
    fn hello();
}

struct Greeter {}

impl Greet for Greeter {
    fn hello(&self) with Stdout {
        println("from handler");
        resume ()
    }
}

export fn run() with Stdout {
    let g = Greeter {};
    with Greet = &g do {
        Greet::hello();
    }
}

__DATA__
{"stdout_contains": ["from handler"]}
