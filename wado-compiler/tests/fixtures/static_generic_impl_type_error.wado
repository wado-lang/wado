// A parameter the block wrote concretely is checked with the slots unfilled:
// only the slot itself is unknown, and skipping the whole list took this with
// it.

struct Box2<T> {
    value: T,
}

impl<T> Box2<T> {
    fn wrap(v: T, tag: String) -> Box2<T> {
        return Box2 { value: v };
    }
}

export fn run() {
    assert Box2::wrap(5, 6).value == 5;
}

__DATA__
{"compile_error": "type mismatch: expected 'String', found 'i32'"}
