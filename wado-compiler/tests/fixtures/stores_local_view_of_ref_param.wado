// A generic view struct holds a reference in a field, not in a type argument:
// `Slice<u8>` keeps `&Array<u8>` whatever `u8` is. A call handing one back
// therefore defers to the carries analysis — a view that stays local needs no
// `stores`, and one that escapes is still caught at the place it escapes.
use { println, Stdout } from "core:cli";

fn count_bytes(s: &String, needle: u8) -> i32 {
    let view = s.as_byte_slice();
    let mut n = 0;
    for let mut i = 0; i < view.len(); i += 1 {
        if view.get_unchecked(i) == needle {
            n += 1;
        }
    }
    return n;
}

export fn run() with Stdout {
    println(`${count_bytes(&"banana", b'a')}`);
}

__DATA__
{ "stdout": "3\n" }
