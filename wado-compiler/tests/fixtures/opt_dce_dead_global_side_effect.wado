// A store to a dead global may still carry observable effects; DCE removes the
// `GlobalVarSet` for the dead global but must preserve the stored value's
// effect. `DEAD = build()` calls `build()`, which mutates the live, printed
// global `LIVE`. Deleting that statement wholesale (as the old `never`-only
// side-effect predicate did — a non-`never` call read as pure) silently drops
// the write, printing `1` instead of `2`. An initializer is another matter:
// whether it runs is unspecified, and `UNREAD`'s does not.
use { println, Stdout } from "core:cli";

global mut LIVE: i32 = 0;

fn build() -> i32 {
    LIVE = LIVE + 1;
    return 7;
}

global mut DEAD: i32 = 0;
global UNREAD: i32 = build();

export fn run() with Stdout {
    let _ = build();
    DEAD = build();
    println(`${LIVE}`);
}

__DATA__
{
    "stdout": "2\n",
    "warnings_contains": ["global `UNREAD` is never used"]
}
