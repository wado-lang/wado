// REGRESSION: at -O2, an uninitialized String local
// (`let mut body_str: String;`) followed by conditional assignment with
// `func() + "literal"` returns the wrong branch (and in some shapes
// traps with "wasm trap: null reference").
//
// Reduced from example/http_bin.wado.

use { Request, Response, ErrorCode, Fields, FieldValue, Trailers } from "wasi:http";

fn make_str() -> String {
    return "abc";
}

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    let take_else = if let Some(_) = request.get_path_with_query() {
        true;
    } else {
        false;
    };

    let mut body_str: String;
    if !take_else {
        body_str = "fallback";
    } else {
        body_str = make_str() + "\n";
    }

    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [body_rx, body_tx] = Stream::<u8>::new();
    let resp_headers = Fields::new();
    resp_headers.append("content-type", "text/plain".bytes().collect() as FieldValue);
    let [response, _tx] = Response::new(resp_headers, Option::Some(body_rx), trailers_future);
    response.set_status_code(200);
    task return Result::Ok(response);
    body_tx.write(body_str.bytes().collect());
    body_tx.drop();
    trailers_tx.write(Result::Ok(null));
}

__DATA__
{
    "wasi:http/service": {
        "request": {"path": "/anything"},
        "status": 200,
        "body": "abc\n"
    }
}
