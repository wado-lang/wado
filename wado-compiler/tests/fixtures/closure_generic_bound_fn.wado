// Generic bound syntax `<F: fn(...)>` / `<F: fn mut(...)>`.
// See wep-2026-01-16-closure-implementation.md ("Generic Bound Syntax").

fn apply<F: fn(i32) -> i32>(f: F, x: i32) -> i32 {
    return f(x);
}

fn run<F: fn mut(i32)>(mut f: F) {
    f(1);
    f(2);
}

fn dup<F: fn(i32) -> i32>(f: F) -> [F, F] {
    return [f, f];
}

test "generic bound fn" {
    let double = |x: i32| x * 2;
    assert apply(double, 7) == 14;
}

test "generic bound fn mut" {
    let mut total = 0;
    run(|x: i32| {
        total += x;
    });
    assert total == 3;
}

test "dup via generic bound" {
    let n = 10;
    let add_n = |x: i32| x + n;
    let pair = dup(add_n);
    assert pair[0](1) == 11;
    assert pair[1](2) == 12;
}

__DATA__
{"test": {}}
