// Test: `core:cli::exit(42)` terminates with a non-zero status code and never
// returns — code placed after the call is unreachable and must not run.
use { println, exit, Exit } from "core:cli";

export fn run() with Stdout, Exit {
    println("before");
    exit(42);
    println("after");
}

__DATA__
{
    "stdout": "before\n",
    "exit_code": 42,
    "trapped": false
}
