// LICM hoists an invariant cast out of a loop: every cast is total, a float
// saturating into an integer, so the pre-header may run one the loop never
// would. `n == 0` below runs no iteration, and hoisting `1e30 as i32` there
// must neither trap nor change the result.
//
// Two trees differing only in an inner cast's target are different values,
// so they must not share a temp: `x as i32 as i64` is -1 and
// `x as u32 as i64` is 4294967295.
//
// `black_box` keeps the arguments off the constant path: with constant ones
// the loop runs at compile time and the function under test is gone.

use { println, Stdout } from "core:cli";

fn sum_up_to(n: i32, x: f64) -> i32 {
    let mut i = 0;
    let mut s = 0;
    while i < n {
        s = s + (x as i32);
        i = i + 1;
    }
    return s;
}

fn widen_both(n: i32, x: i64) -> i64 {
    let mut s: i64 = 0;
    for let mut i = 0; i < n; i += 1 {
        s = s + (x as i32 as i64) * 3;
        s = s + (x as u32 as i64) * 3;
    }
    return s;
}

export fn run() with Stdout {
    println(`${sum_up_to(builtin::black_box(0), builtin::black_box(1.0e30))}`);
    println(`${sum_up_to(builtin::black_box(2), builtin::black_box(1.0e30))}`);
    println(`${widen_both(builtin::black_box(1), builtin::black_box(-1 as i64))}`);
}

__DATA__
{
    "stdout": "0\n-2\n12884901882\n",
    "wir_expect:O2": ["$licm_arith_"]
}
