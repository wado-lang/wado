// Test: Stdin::read_via_stream() with manual Stream::read()
// Verifies the CM adapter return type and that the stream can be read manually.
use { println, Stdout } from "core:cli";
use { Stdin } from "wasi:cli";

export fn run() with Stdout, Stdin {
    let [stdin_stream, _done] = Stdin::read_via_stream();

    // Read chunks from stdin
    let mut total = 0;
    loop {
        let chunk = stdin_stream.read(4096);
        if chunk.len() == 0 {
            break;
        }
        total = total + chunk.len();
    }
    stdin_stream.drop();

    println(`read {total} bytes`);
}

__DATA__
{"stdin": "ABCDE", "stdout": "read 5 bytes\n"}
