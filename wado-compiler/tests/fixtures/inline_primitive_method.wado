// Primitive method calls like f64::to_bits are inlined. Uses float formatting
// to exercise fpfmt.wado code paths.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn get_value() -> f64 {
    return 3.14;
}

export fn run() with Stdout {
    let x = get_value();
    let bits = x.to_bits();
    let back = f64::from_bits(bits);
    println(`${x} ${bits} ${back}`);
}

__DATA__
{
    "stdout": "3.14 4614253070214989087 3.14\n",
    "wir_scope": "inline_primitive_method.wado/run\"",
    "wir_pass": {"O2": ["nir/sroa_param", "nir/inline", "nir/param_spec"]},
    "wir_not_expect:O2": ["f64::to_bits\"(", "f64::from_bits\"("],
    "wir_expect:O2": ["builtin::i64_reinterpret_f64"]
}
