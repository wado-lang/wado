// Two generic impls of one trait at different instantiations are two answers.
// The generic registry kept no trait arguments, so the second overwrote the
// first: `Product` held or not depending on which was written last.
use { println } from "core:cli";

struct W<T> {
    v: T,
}

struct Inch {
    v: i32,
}

impl<T> Mul for W<T> {
    type Output = W<T>;

    fn mul(&self, rhs: &W<T>) -> W<T> {
        return W { v: self.v };
    }
}

impl<T> Mul<Inch> for W<T> {
    type Output = Inch;

    fn mul(&self, rhs: &Inch) -> Inch {
        return Inch { v: 1 };
    }
}

export fn run() with Stdout {
    let xs: List<W<i32>> = [W { v: 2 }, W { v: 3 }];
    assert xs.iter_value().product() matches { Some(p) && p.v == 2 };
    println(`${xs.iter_value().product() matches { Some(p) && p.v == 2 }}`);
}

__DATA__
{"stdout": "true\n"}
