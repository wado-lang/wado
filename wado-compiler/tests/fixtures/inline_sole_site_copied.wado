// A callee's only site stops being one once its caller is spliced: `mix` is
// called from `wrap` alone, but `first` and `second` each splice `wrap`, and
// each copy carries a site of its own. The body would be copied rather than
// moved, so `first` keeps its call to `mix` (`inline_sole_site.wado` is the
// site that stays one).

fn mix(x: i32, y: i32) -> i32 {
    let mut h = x ^ y * 0x27d4eb2d;
    h = (h ^ h >> 15) * 0x2c1b3c6d;
    h = (h ^ h >> 12) * 0x297a2d39;
    h = h ^ h >> 15;
    if h < 0 {
        h = (h ^ y) * 0x3c6ef372;
        h = (h ^ h >> 7) * 0x1b873593;
    } else {
        h = (h + x) * 0x1b873593;
        h = (h ^ h >> 9) * 0x3c6ef372;
    }
    h = (h ^ h >> 13) * 0x2c1b3c6d;
    h = (h ^ y >> 11) * 0x297a2d39;
    return h ^ h >> 13;
}

fn wrap(x: i32, y: i32) -> i32 {
    return mix(x, y);
}

#[inline(never)]
fn first(x: i32, y: i32) -> i32 {
    return wrap(x, y);
}

#[inline(never)]
fn second(x: i32, y: i32) -> i32 {
    return wrap(x, y) + 1;
}

export fn run() {
    let a = first(builtin::black_box(7), builtin::black_box(1));
    let b = second(builtin::black_box(9), builtin::black_box(2));
    assert a != b;
}

__DATA__
{
    "stdout": "",
    "wir_scope": "inline_sole_site_copied.wado/first",
    "wir_expect:O2": ["\"inline_sole_site_copied.wado/mix\"("]
}
