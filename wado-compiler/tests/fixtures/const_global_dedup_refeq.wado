// `wir_optimize::dedupe_const_globals` merges two const globals of equal
// value even where their references are compared by identity: a `ref_eq`
// between distinct places may turn true, and one to a single place stays true.

use { println, Stdout } from "core:cli";

global A: List<i32> = [10, 20, 30];
global B: List<i32> = [10, 20, 30];

export fn run() with Stdout {
    let ra = &A;
    let rb = &B;
    assert ref_eq(ra, &A);
    assert ra == rb;
    println("ok");
}

__DATA__
{
    "stdout": "ok\n",
    "wir_expect:O2": [
        "global global:const_global_dedup_refeq.wado::A"
    ],
    "wir_not_expect:O2": [
        "global global:const_global_dedup_refeq.wado::B"
    ]
}
