// Soundness guard for `wir_optimize::dedupe_const_globals`: two distinct const
// globals with byte-identical inits must NOT be merged when their references
// are compared by identity (`&A == &B` lowers to `ref.eq`). Merging them would
// flip the comparison from `false` to `true`. The pass bails entirely when the
// module contains any `ref.eq`, so both globals survive and the result stays
// `false` ("diff").

use { println, Stdout } from "core:cli";

global A: List<i32> = [10, 20, 30];
global B: List<i32> = [10, 20, 30];

export fn run() with Stdout {
    let ra = &A;
    let rb = &B;
    if ra == rb {
        println("same");
    } else {
        println("diff");
    }
}

__DATA__
{
    "stdout": "diff\n",
    "wir_expect:O2": [
        "global global:A",
        "global global:B"
    ]
}
