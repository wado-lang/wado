// A synchronous world function's `list<T>` parameter, for a number type `T`,
// takes any `ListArg<Elem = T>`: a `List<T>` or a newtype over one is copied
// for the call, and a `&LinearArray<T>` hands over its own block.
use { sum_bytes, sum_floats } from "./sub/wasm_import_cm_list_sum.wat" with { type: "wat" };
use { LinearArray, ListArg } from "core:linear";

fn sum_of<affine L: ListArg<Elem = u8>>(data: L) -> u32 {
    return sum_bytes(data);
}

test "a list<u8> parameter takes a List, a ByteList or a LinearArray" {
    let list: List<u8> = [1, 2, 3];
    let bytes: ByteList = b"\x01\x02";
    let mut linear = LinearArray::<u8>::filled(4, 2);
    assert sum_bytes(list) == 6;
    assert sum_bytes(bytes) == 3;
    assert sum_bytes(&linear) == 8;
    linear[0] = 10;
    assert sum_bytes(&linear) == 16;
    assert sum_of(&linear) == 16;
    assert sum_of(bytes) == 3;
}

test "a list<f32> parameter takes a List or a LinearArray" {
    let list: List<f32> = [0.5, 1.5];
    let linear = LinearArray::<f32>::filled(3, 0.25);
    assert sum_floats(list) == 2.0;
    assert sum_floats(&linear) == 0.75;
}

test "a temporary array lives through the call" {
    // The debug allocator poisons a freed block with 0xFF, so a block freed
    // before the call reads as 765.
    assert sum_bytes(&LinearArray::<u8>::filled(3, 1)) == 3;
}

test "an empty array" {
    let linear = LinearArray::<u8>::filled(0, 0);
    assert sum_bytes(&linear) == 0;
}

__DATA__
{"test": {}}
