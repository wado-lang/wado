// Formatter and buffer hoisting in loops:
// A template string with a format specifier (e.g. :0.6f) must not allocate per
// iteration. The String buffer is hoisted before the loop; the Formatter is no
// longer hoisted because `sroa_param` scalarizes its methods down to the `buf`
// field, so the struct is never built at all.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Hoistable: format specifier with precision, result used only via receiver
    let mut total = 0;
    for let mut i = 0; i < 5; i += 1 {
        let x = i as f64 / 10.0;
        let s = `${x:0.4f}`;
        total += s.len();
    }
    println(`total=${total}`);

    // Hoistable: hex format specifier
    let mut total2 = 0;
    for let mut i = 0; i < 5; i += 1 {
        let s = `${i:x}`;
        total2 += s.len();
    }
    println(`total2=${total2}`);

    // Multiple interpolations with mixed format specs: one default, one formatted
    let mut total3 = 0;
    for let mut i = 0; i < 3; i += 1 {
        let x = i as f64;
        let s = `i=${i}, x=${x:0.2f}`;
        total3 += s.len();
    }
    println(`total3=${total3}`);
}

__DATA__
{"stdout": "total=30\ntotal2=5\ntotal3=33\n", "wir_expect:O2": ["__tmpl_buf_"]}
