// Regression: a call inside an `if` arm can mutate a local passed to it
// (`grow` pushes through `&mut`), so the branch merge must invalidate
// that local's field facts: `a.len()` is 5 or 6 depending on `c` and
// must not fold to the pre-branch constant 5.
//
// `black_box` keeps CTFE from running `f` on a constant and erasing it.

use { println, Stdout } from "core:cli";

#[inline("never")]
fn grow(xs: &mut List<i32>) {
    xs.push(6);
}

#[inline("never")]
fn f(c: bool) -> i32 {
    let mut a: List<i32> = [1, 2, 3, 4, 5];
    if c {
        grow(&mut a);
    }
    return a.len();
}

export fn run() with Stdout {
    println(`${f(builtin::black_box(false))} ${f(builtin::black_box(true))}`);
}

__DATA__
{
    "stdout": "5 6\n",
    "wir_scope": "opt_const_forward_call_in_if_invalidates.wado/f",
    "wir_not_expect:O2": ["return 5;"],
    "wir_contrast": {"O2": [
        {"    if c {\n        grow(&mut a);\n    }\n": "    builtin::black_box(c);\n"}
    ]}
}
