// A `&mut` use of an affine local, other than through the reference, may move
// out what the reference reads: `pop` takes the element `first` names.
affine struct Tok {
    id: i32,
}

impl Drop for Tok {
    fn drop(self) {
    }
}

test {
    let mut toks: List<Tok> = [];
    toks.push(Tok { id: 1 });
    let first = &toks[0];
    let popped = toks.pop();
    assert first.id == 1;
}

