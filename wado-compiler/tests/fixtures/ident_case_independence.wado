// Identifiers in Wado have no case-based syntactic or semantic rules.
// This tests that uppercase local variables, lowercase type names, and
// lowercase enum/variant case names all work correctly.

use { println, Stdout } from "core:cli";

// Lowercase struct type name
struct point {
    x: i32,
    y: i32,
}

impl point {
    fn sum(&self) -> i32 {
        return self.x + self.y;
    }
}

// Lowercase enum type with lowercase case names
enum color {
    red,
    green,
    blue,
}

// Lowercase variant type with lowercase case names
variant maybe {
    just(i32),
    nothing,
}

// Uppercase function name
fn Double(n: i32) -> i32 {
    return n * 2;
}

export fn run() with Stdout {
    // Uppercase local variable binding
    let FOO = 42;
    assert FOO == 42;
    println(`FOO={FOO}`);

    // Lowercase type construction and method call
    let p = point { x: 3, y: 4 };
    assert p.sum() == 7;
    println(`point sum={p.sum()}`);

    // Lowercase struct destructuring
    let point { x: X, y: Y } = p;
    assert X == 3;
    assert Y == 4;
    println(`X={X} Y={Y}`);

    // Lowercase enum case in match
    let c = color::red;
    let name = match c {
        red => "red",
        green => "green",
        blue => "blue",
    };
    assert name == "red";
    println(`color={name}`);

    // Lowercase enum case in if let
    if c matches { red } {
        println("matches red");
    }

    // Lowercase variant construction
    let v: maybe = maybe::just(10);
    if let just(N) = v {
        assert N == 10;
        println(`just N={N}`);
    }

    // Uppercase Go-style if-let binding
    let opt = Option::<i32>::Some(99);
    if let VAL = opt; VAL matches { Some(_) } {
        println(`VAL is Some`);
    }

    // Uppercase function call
    assert Double(21) == 42;
    println(`Double(21)={Double(21)}`);
}

__DATA__
{
    "TODO": true,
    "stdout": "FOO=42\npoint sum=7\nX=3 Y=4\ncolor=red\nmatches red\njust N=10\nVAL is Some\nDouble(21)=42\n"
}
