// Test: explicit `impl Eq for T;` / `impl Ord for T;` markers (WEP: Trait
// Derivation Policy) force the derive into existence and are otherwise
// interchangeable with the structural (bound-driven) auto-derive.
struct Point {
    x: i32,
    y: i32,
}

impl Eq for Point;
impl Ord for Point;

test "explicit Eq marker works like auto-derive" {
    let a = Point { x: 1, y: 2 };
    let b = Point { x: 1, y: 2 };
    let c = Point { x: 3, y: 4 };
    assert a == b;
    assert a != c;
}

test "explicit Ord marker works like auto-derive" {
    let a = Point { x: 1, y: 2 };
    let b = Point { x: 3, y: 4 };
    assert a < b;
    assert b > a;
}

enum Color {
    Red,
    Green,
    Blue,
}

impl Eq for Color;
impl Ord for Color;

test "explicit Eq/Ord markers on an enum" {
    assert Color::Red == Color::Red;
    assert Color::Red != Color::Blue;
    assert Color::Red < Color::Blue;
}
