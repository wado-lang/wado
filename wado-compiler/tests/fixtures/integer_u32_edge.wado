// Test u32 edge cases: max value and unsigned semantics
// This is critical: values above 2^31-1 must use unsigned operations
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Max value: 4294967295 (2^32 - 1)
    let max: u32 = 4294967295 as u32;
    println(`max: {max}`);

    // Min value: 0
    let min: u32 = 0 as u32;
    println(`min: {min}`);

    // Large value above i32 max (2147483647)
    let large: u32 = 3000000000 as u32;
    println(`large: {large}`);

    // Division with large unsigned value
    // 3000000000 / 2 = 1500000000 (correct)
    let div_result = large / 2 as u32;
    println(`3000000000 / 2: {div_result}`);

    // Modulo with large unsigned value
    let mod_result = large % 7 as u32;
    println(`3000000000 % 7: {mod_result}`);
}

__DATA__
{"stdout": "max: 4294967295\nmin: 0\nlarge: 3000000000\n3000000000 / 2: 1500000000\n3000000000 % 7: 4\n"}
