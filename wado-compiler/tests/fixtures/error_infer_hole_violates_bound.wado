// A deferred type parameter solved to a type that violates its bound must
// raise a clean trait-bound error. `m.get().unwrap()` solves `get<T: Producer>`
// to `T = String`, which is not `Producer`.

trait Producer {
    fn make() -> Self;
}
impl Producer for i32 {
    fn make() -> i32 { return 1; }
}

struct Source {}
impl Source {
    fn get<T: Producer>(&self) -> Option<T> {
        return Option::Some(T::make());
    }
}

export fn run() {
    let s = Source {};
    let x: String = s.get().unwrap();
    let _ = x;
}

__DATA__
{"compile_error": "Producer"}
