// TODO: Pre-existing O0/O2 codegen ICE with phantom type args in generic structs.
// (type mismatch: expected (ref $type), found (ref (exact $type)))
// When the underlying codegen bug is fixed, this test should produce "ok".
// The is_known_type_name fix correctly recognizes Status (a variant) as a concrete
// type, preventing it from being treated as a free type parameter in the impl lookup.
use { println } from "core:cli";

variant Status { Active, Inactive }

struct StatusMap<S, V> {
    keys: Array<String>,
    values: Array<V>,
}

impl KeyValueLiteralBuilder for StatusMap<Status, V> {
    type Value = V;
    type Output = StatusMap<Status, V>;

    fn new_literal(capacity: i32) -> StatusMap<Status, V> {
        return StatusMap { keys: [], values: [] };
    }

    fn insert_literal(&mut self, key: String, value: Self::Value) {
        self.keys.append(key);
        self.values.append(value);
    }

    fn build(self) -> StatusMap<Status, V> {
        return self;
    }
}

export fn run() with Stdout {
    let m: StatusMap<Status, i32> = { active: 1, inactive: 2 };
    assert m.keys.len() == 2;
    assert m.values[0] == 1;
    println("ok");
}

__DATA__
{"TODO": true, "stdout": "ok\n"}
