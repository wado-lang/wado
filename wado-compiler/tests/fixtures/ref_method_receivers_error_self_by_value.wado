// A by-value `self` receiver is legal only on a resource (WEP 2026-05-21).
// A value type is not move-only, so its methods must borrow with `&self`.

struct Foo {
    x: i32,
}

impl Foo {
    fn consume(self) -> i32 {
        return self.x;
    }
}

export fn run() {
    let f = Foo { x: 42 };
    let v = f.consume();
}

__DATA__
{"compile_error": "`self` by value is only allowed on a resource"}
