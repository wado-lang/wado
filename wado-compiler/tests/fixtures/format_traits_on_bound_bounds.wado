// Test: `T: Inspect` / `T: Display` (and their Alt siblings) bounds are
// satisfied structurally for plain aggregate types (WEP: Trait Derivation
// Policy — on_bound format traits). Previously these bounds required a
// manual impl even though `{v}` / `{v:?}` always worked.
struct P {
    x: i32,
    y: i32,
}

enum Color {
    Red,
    Green,
}

variant Shape {
    Circle(f64),
    Dot,
}

fn show_inspect<T: Inspect>(v: &T) -> String {
    return `{v:?}`;
}

fn show_display<T: Display>(v: &T) -> String {
    return `{v}`;
}

fn show_inspect_alt<T: InspectAlt>(v: &T) -> String {
    return `{v:#?}`;
}

fn show_display_alt<T: DisplayAlt>(v: &T) -> String {
    return `{v:#}`;
}

test "Inspect bound on struct/enum/variant" {
    let p = P { x: 1, y: 2 };
    assert show_inspect(&p) == "P { x: 1, y: 2 }";
    assert show_inspect(&Color::Red) == "Color::Red";
    assert show_inspect(&Shape::Circle(1.5)) == "Shape::Circle(1.5)";
}

test "Display bound falls back to Inspect" {
    let p = P { x: 3, y: 4 };
    assert show_display(&p) == "P { x: 3, y: 4 }";
    assert show_display(&Color::Green) == "Color::Green";
}

test "alt bounds" {
    let p = P { x: 5, y: 6 };
    assert show_inspect_alt(&p) == show_display_alt(&p);
}

__DATA__
{"test": {}}
