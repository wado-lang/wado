// Test: default method calling another default method
use { println, Stdout } from "core:cli";

trait Describable {
    fn label(&self) -> String;
    fn short_desc(&self) -> String {
        return `[{self.label()}]`;
    }
    fn full_desc(&self) -> String {
        return `Description: {self.short_desc()}`;
    }
}

struct Item {
    name: String,
}

// Only provides label(), both short_desc() and full_desc() are defaults
impl Describable for Item {
    fn label(&self) -> String {
        return self.name;
    }
}

export fn run() with Stdout {
    let item = Item { name: "Widget" };
    println(item.label());
    println(item.short_desc());
    println(item.full_desc());
}

__DATA__
{"stdout": "Widget\n[Widget]\nDescription: [Widget]\n"}
