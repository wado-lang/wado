// A closure capturing a boxed binding by reference holds the binding's cell,
// even where the program also has a cell of the reference type itself: `via`
// takes `&p`, a `&&mut i32`, a cell holding a `&mut i32`.

fn peek(r: &&mut i32) -> i32 {
    return **r;
}

fn via(p: &mut i32) -> i32 {
    return peek(&p);
}

export fn run() {
    let mut fs: List<fn() -> i32> = [];
    for let mut i = 0; i < 3; i += 1 {
        let mut raise = || i += 1;
        raise();
        fs.push(|| i);
    }
    assert fs.len() == 2;
    assert fs[0]() == 1;
    assert fs[1]() == 3;
    let mut n = 7;
    assert via(&mut n) == 7;
}

