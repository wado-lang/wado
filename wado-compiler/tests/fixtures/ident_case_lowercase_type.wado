// Lowercase struct/enum/variant type names are valid.
use { println, Stdout } from "core:cli";

struct point {
    x: i32,
    y: i32,
}

enum color { red, green, blue }

variant maybe { just(i32), nothing }

export fn run() with Stdout {
    // Lowercase struct construction
    let p = point { x: 3, y: 4 };
    assert p.x == 3;
    println(`{p.x}`);

    // Named struct destructure with lowercase type
    let point { x, y } = p;
    assert x == 3;
    assert y == 4;
    println(`{x} {y}`);

    // Lowercase enum case match
    let c = color::red;
    let name = match c {
        red => "red",
        green => "green",
        blue => "blue",
    };
    assert name == "red";
    println(`{name}`);

    // Lowercase variant case if-let
    let v: maybe = maybe::just(10);
    if let just(n) = v {
        assert n == 10;
        println(`{n}`);
    }
}

__DATA__
{
    "stdout": "3\n3 4\nred\n10\n"
}
