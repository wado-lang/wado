// Nested for-of loops
// Tests that each loop has independent counters

use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let outer: Array<i32> = [1, 2, 3];
    let inner: Array<i32> = [10, 20];
    for let i of outer {
        for let j of inner {
            println(`{i},{j}`);
        }
    }
}

__DATA__
{"stdout": "1,10\n1,20\n2,10\n2,20\n3,10\n3,20\n"}
