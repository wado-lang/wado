// Test all f64 associated constants
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    println(`PI = {f64::PI}`);
    println(`TAU = {f64::TAU}`);
    println(`E = {f64::E}`);
    println(`LN2 = {f64::LN2}`);
    println(`LN10 = {f64::LN10}`);
    println(`LOG2_E = {f64::LOG2_E}`);
    println(`LOG10_E = {f64::LOG10_E}`);
    println(`SQRT2 = {f64::SQRT2}`);
    println(`FRAC_1_SQRT2 = {f64::FRAC_1_SQRT2}`);
    println(`FRAC_PI_2 = {f64::FRAC_PI_2}`);
    println(`FRAC_PI_4 = {f64::FRAC_PI_4}`);
    println(`INFINITY = {f64::INFINITY}`);
    println(`NEG_INFINITY = {f64::NEG_INFINITY}`);

    // Verify mathematical relationships
    println(`TAU == 2*PI: {f64::TAU == f64::PI * 2.0}`);
    println(`FRAC_PI_2 == PI/2: {f64::FRAC_PI_2 == f64::PI / 2.0}`);
    println(`FRAC_PI_4 == PI/4: {f64::FRAC_PI_4 == f64::PI / 4.0}`);
}

__DATA__
{"stdout_contains": [
    "PI = 3.141592653589793",
    "TAU = 6.283185307179586",
    "E = 2.718281828459045",
    "LN2 = 0.6931471805599453",
    "LN10 = 2.302585092994046",
    "LOG2_E = 1.4426950408889634",
    "LOG10_E = 0.4342944819032518",
    "SQRT2 = 1.4142135623730951",
    "FRAC_1_SQRT2 = 0.7071067811865476",
    "FRAC_PI_2 = 1.5707963267948966",
    "FRAC_PI_4 = 0.7853981633974483",
    "INFINITY = inf",
    "NEG_INFINITY = -inf",
    "TAU == 2*PI: true",
    "FRAC_PI_2 == PI/2: true",
    "FRAC_PI_4 == PI/4: true"
]}
