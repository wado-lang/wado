// Float literal coercion to f32 in builtin function arguments
// Regression: builtin::f32x4_splat(0.0) should coerce 0.0 to f32,
// but lookup_function_param_types returned empty for builtin:: calls.
use { println, Stdout } from "core:cli";
use { f32x4 } from "core:simd";

export fn run() with Stdout {
    // Float literal in f32x4 array context (coerced via SequenceLiteralBuilder)
    let v: f32x4 = [1.3, 2.7, -1.3, -2.7];
    assert v.extract_lane(0) as f64 > 1.0;

    // Verify non-round floats work too
    let w: f32x4 = [0.1, 0.2, 0.3, 0.4];
    assert w.extract_lane(3) as f64 > 0.3;

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
