// Test: Stream::read() loop pattern works correctly
// Tests the read-until-EOF loop pattern that is used in HTTP handlers.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let [rx, tx] = Stream::<u8>::new();

    // Close writer immediately so reads see EOF
    tx.drop();

    // A terminal chunk can still carry elements, so the loop takes what it
    // copied before it looks at the result.
    let mut reads = 0;
    let mut items = 0;
    loop {
        let chunk = rx.read(2);
        items += chunk.items.len();
        if chunk.result != CopyResult::Completed {
            break;
        }
        reads = reads + 1;
    }

    assert reads == 0;
    assert items == 0;
    rx.drop();
    println("multi-read ok");
}

__DATA__
{"stdout": "multi-read ok\n"}
