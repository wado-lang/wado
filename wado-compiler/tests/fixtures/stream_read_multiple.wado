// Test: a loop of started reads ends on the first non-Completed result.
// Tests the read-until-EOF loop pattern that is used in HTTP handlers.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let [rx, tx] = Stream::<u8>::new();

    // Close writer immediately so reads see EOF
    tx.drop();

    let mut rx = rx;
    let mut reads = 0;
    loop {
        let [end, chunk] = rx.start_read(2).finish();
        rx = end;
        if chunk.result != CopyResult::Completed {
            break;
        }
        reads = reads + 1;
    }

    assert reads == 0;
    rx.drop();
    println("multi-read ok");
}

__DATA__
{"stdout": "multi-read ok\n"}
