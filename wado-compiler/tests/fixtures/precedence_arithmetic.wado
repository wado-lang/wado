// Test arithmetic operator precedence
// Multiplicative (*, /, %) > Additive (+, -)

fn run() {
    // * has higher precedence than +
    // 2 + 3 * 4 = 2 + 12 = 14
    let a = 2 + 3 * 4;
    assert a == 14;

    // / has higher precedence than -
    // 10 - 8 / 2 = 10 - 4 = 6
    let b = 10 - 8 / 2;
    assert b == 6;

    // % has higher precedence than +
    // 5 + 7 % 3 = 5 + 1 = 6
    let c = 5 + 7 % 3;
    assert c == 6;

    // Mixed multiplicative operators (left-to-right)
    // 20 / 4 * 2 = 5 * 2 = 10
    let d = 20 / 4 * 2;
    assert d == 10;

    // Mixed additive operators (left-to-right)
    // 10 - 3 + 2 = 7 + 2 = 9
    let e = 10 - 3 + 2;
    assert e == 9;

    // Complex expression
    // 2 + 3 * 4 - 6 / 2 = 2 + 12 - 3 = 11
    let f = 2 + 3 * 4 - 6 / 2;
    assert f == 11;

    // Floating point precedence
    let g = 2.0 + 3.0 * 4.0;
    assert g == 14.0;

    let h = 10.0 - 8.0 / 2.0;
    assert h == 6.0;
}

__DATA__
{}
