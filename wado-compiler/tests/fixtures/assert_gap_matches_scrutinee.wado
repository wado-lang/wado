// Gap: a `matches` scrutinee renders nothing, so a failed pattern test shows
// the pattern but never the value that failed it.

variant Shape {
    Circle(f64),
    Point,
}

export fn run() {
    let s = Shape::Circle(3.0);
    assert s matches { Point };
}

__DATA__
{
    "trapped": true,
    "stderr_contains": ["s: Shape::Circle"]
}
