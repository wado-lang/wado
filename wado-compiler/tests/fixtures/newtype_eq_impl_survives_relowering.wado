// A monomorphized operator call relowers to the native instruction only where
// no impl wrote a body. The guard asked whether the newtype declared `Output`,
// which `Eq` never does, so `impl Eq for Meters` was replaced by `i32.eq`.
use { println } from "core:cli";

type Meters = i32;

impl Eq for Meters {
    fn eq(&self, other: &Meters) -> bool {
        return true;
    }
}

fn same<T: Eq>(a: T, b: T) -> bool {
    return a == b;
}

fn plain<T: Eq>(a: T, b: T) -> bool {
    return a == b;
}

export fn run() with Stdout {
    let a = builtin::black_box(1) as Meters;
    let b = builtin::black_box(2) as Meters;
    println(`${same(a, b)} ${plain(builtin::black_box(1), builtin::black_box(2))}`);
}

__DATA__
{"stdout": "true false\n"}
