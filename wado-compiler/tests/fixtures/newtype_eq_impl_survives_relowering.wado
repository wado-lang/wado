// A newtype over a primitive is its own type, so an impl it writes answers the
// operator — through a bound and written directly. The relowering guard asked
// whether the newtype declared `Output`, which `Eq` never does; the direct path
// peeled to the ultimate base, which for a primitive named no receiver at all.
// Both replaced `impl Eq for Meters` with `i32.eq`.
use { println } from "core:cli";

type Meters = i32;

impl Eq for Meters {
    fn eq(&self, other: &Meters) -> bool {
        return true;
    }
}

fn same<T: Eq>(a: T, b: T) -> bool {
    return a == b;
}

fn plain<T: Eq>(a: T, b: T) -> bool {
    return a == b;
}

export fn run() with Stdout {
    let a = builtin::black_box(1) as Meters;
    let b = builtin::black_box(2) as Meters;
    println(`${same(a, b)} ${a == b} ${plain(builtin::black_box(1), builtin::black_box(2))}`);
}

__DATA__
{"stdout": "true true false\n"}
