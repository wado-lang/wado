// Test: Stream::read() reports end-of-stream through `CopyResult`
// When the writable end is closed without writing, `read_to_end` yields nothing.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let [rx, tx] = Stream::<u8>::new();

    // Close writer immediately (no data written)
    tx.drop();

    // Draining an already-dropped stream yields no elements
    let result = rx.read_to_end();
    assert result.len() == 0;

    rx.drop();
    println("eof ok");
}

__DATA__
{"stdout": "eof ok\n"}
