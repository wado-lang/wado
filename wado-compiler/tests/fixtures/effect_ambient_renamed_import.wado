// `#[ambient(E)]` names its effect as this module spells it, alias included.

use { println, Stdout } from "core:cli";
use { InsecureSeed as Seed } from "wasi:random";

#[ambient(Seed)]
fn seeded() -> i32 {
    let [_, _] = Seed::get_insecure_seed();
    return 7;
}

export fn run() with Stdout {
    println(`${seeded()}`);
}

__DATA__
{"stdout": "7\n"}
