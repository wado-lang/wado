// The test world checks contracts, so a call marked `unchecked` outside its
// contract traps instead of reading past a view or minting a bad value.

fn view() -> StrSlice {
    return "héllo wörld".as_str_slice().slice(0, 5);
}

test "calls inside their contracts run as before" {
    assert unchecked view().byte_at(0) == b'h';
    assert unchecked view().slice(1, 3) == "é";
    assert unchecked view().char_at_byte(1) == 'é';
    assert unchecked char::from_u32(0x41) == 'A';
    let list: List<i32> = [1, 2, 3];
    assert unchecked list.as_slice().at(2) == 3;
    assert unchecked list[2] == 3;
    let mut s = "héllo";
    unchecked s.truncate(3);
    assert s == "hé";
    let bytes: ByteList = [0xC3, 0xA9];
    assert unchecked String::from_utf8(bytes) == "é";
    s.push_bytes(&bytes);
    assert s == "héé";
}

#[expect_trap]
test "unchecked StrSlice::byte_at past the view" {
    let _ = unchecked view().byte_at(builtin::black_box(5));
}

#[expect_trap]
test "unchecked StrSlice::slice past the view" {
    let _ = unchecked view().slice(0, builtin::black_box(6));
}

#[expect_trap]
test "unchecked StrSlice::slice off a character boundary" {
    let _ = unchecked view().slice(0, builtin::black_box(2));
}

#[expect_trap]
test "unchecked StrSlice::char_at_byte off a character boundary" {
    let _ = unchecked view().char_at_byte(builtin::black_box(2));
}

#[expect_trap]
test "unchecked String::byte_at past the length" {
    let mut s = String::with_capacity(16);
    s.push_str("abc");
    let _ = unchecked s.byte_at(builtin::black_box(3));
}

#[expect_trap]
test "unchecked String::from_utf8 on invalid bytes" {
    let bytes: ByteList = [0x61, builtin::black_box(0xFF)];
    let _ = unchecked String::from_utf8(bytes);
}

#[expect_trap]
test "unchecked String::push_bytes with half a character" {
    let mut s = "abc";
    let bytes: ByteList = [builtin::black_box(0xC3)];
    unchecked s.push_bytes(&bytes);
}

#[expect_trap]
test "unchecked String::push_ascii with a non-ASCII byte" {
    let mut s = "abc";
    unchecked s.push_ascii(builtin::black_box(0xC3));
}

#[expect_trap]
test "unchecked String::truncate off a character boundary" {
    let mut s = "héllo";
    unchecked s.truncate(builtin::black_box(2));
}

#[expect_trap]
test "unchecked String::insert off a character boundary" {
    let mut s = "héllo";
    unchecked s.insert(builtin::black_box(2), 'x');
}

#[expect_trap]
test "unchecked String::insert_str off a character boundary" {
    let mut s = "héllo";
    unchecked s.insert_str(builtin::black_box(2), "x");
}

#[expect_trap]
test "unchecked AsStrSlice::slice with the end before the start" {
    let _ = unchecked "abcd".slice(3, builtin::black_box(1));
}

#[expect_trap]
test "unchecked String::substr_bytes off a character boundary" {
    let _ = unchecked "héllo".substr_bytes(0, builtin::black_box(2));
}

#[expect_trap]
test "unchecked ByteList index past the length" {
    let mut bytes = ByteList::with_capacity(16);
    bytes.push(1);
    let _ = unchecked bytes[builtin::black_box(1)];
}

#[expect_trap]
test "unchecked String::remove at the length" {
    let mut s = String::with_capacity(16);
    s.push_str("abc");
    let _ = unchecked s.remove(builtin::black_box(3));
}

#[expect_trap]
test "unchecked char::from_u32 on a surrogate" {
    let _ = unchecked char::from_u32(builtin::black_box(0xD800));
}

#[expect_trap]
test "unchecked List::at past the length" {
    let mut list: List<i32> = List::with_capacity(16);
    list.push(1);
    let _ = unchecked list.at(builtin::black_box(1));
}

#[expect_trap]
test "unchecked AsStrSlice::byte_at on a String past the length" {
    let mut s = String::with_capacity(16);
    s.push_str("abc");
    let _ = unchecked AsStrSlice::byte_at(&s, builtin::black_box(3));
}

#[expect_trap]
test "unchecked Sequence::at on a Slice past the view" {
    let list: List<i32> = [1, 2, 3, 4];
    let _ = unchecked Sequence::at(&list.as_slice().slice(0, 2), builtin::black_box(2));
}

#[expect_trap]
test "unchecked List index past the length" {
    let mut list: List<i32> = List::with_capacity(16);
    list.push(1);
    let _ = unchecked list[builtin::black_box(1)];
}

#[expect_trap]
test "unchecked List index by reference past the length" {
    let mut list: List<String> = List::with_capacity(16);
    list.push("a");
    let _ = (unchecked list[builtin::black_box(1)]).len();
}

#[expect_trap]
test "unchecked Slice index past the view" {
    let list: List<i32> = [1, 2, 3, 4];
    let _ = unchecked list.as_slice().slice(0, 2)[builtin::black_box(2)];
}

__DATA__
{
    "test": {}
}
