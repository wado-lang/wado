// The test world checks contracts, so an `_unchecked` call or a call marked
// `unchecked` outside its contract traps instead of reading past a view or
// minting a bad value.

fn view() -> StrSlice {
    return "héllo wörld".as_str_slice().slice(0, 5);
}

test "calls inside their contracts run as before" {
    assert view().get_byte_unchecked(0) == b'h';
    assert unchecked view().slice(1, 3) == "é";
    assert view().char_at_byte_unchecked(1) == 'é';
    assert char::from_u32_unchecked(0x41) == 'A';
    let list: List<i32> = [1, 2, 3];
    assert list.as_slice().get_unchecked(2) == 3;
    let mut s = "héllo";
    unchecked s.truncate(3);
    assert s == "hé";
    let bytes: ByteList = [0xC3, 0xA9];
    assert unchecked String::from_utf8(bytes) == "é";
    s.push_bytes(&bytes);
    assert s == "héé";
}

#[expect_trap]
test "StrSlice::get_byte_unchecked past the view" {
    let _ = view().get_byte_unchecked(builtin::black_box(5));
}

#[expect_trap]
test "unchecked StrSlice::slice past the view" {
    let _ = unchecked view().slice(0, builtin::black_box(6));
}

#[expect_trap]
test "unchecked StrSlice::slice off a character boundary" {
    let _ = unchecked view().slice(0, builtin::black_box(2));
}

#[expect_trap]
test "StrSlice::char_at_byte_unchecked off a character boundary" {
    let _ = view().char_at_byte_unchecked(builtin::black_box(2));
}

#[expect_trap]
test "String::get_byte_unchecked past the length" {
    let mut s = String::with_capacity(16);
    s.push_str("abc");
    let _ = s.get_byte_unchecked(builtin::black_box(3));
}

#[expect_trap]
test "unchecked String::from_utf8 on invalid bytes" {
    let bytes: ByteList = [0x61, builtin::black_box(0xFF)];
    let _ = unchecked String::from_utf8(bytes);
}

#[expect_trap]
test "unchecked String::push_bytes with half a character" {
    let mut s = "abc";
    let bytes: ByteList = [builtin::black_box(0xC3)];
    unchecked s.push_bytes(&bytes);
}

#[expect_trap]
test "String::push_ascii_unchecked with a non-ASCII byte" {
    let mut s = "abc";
    s.push_ascii_unchecked(builtin::black_box(0xC3));
}

#[expect_trap]
test "unchecked String::truncate off a character boundary" {
    let mut s = "héllo";
    unchecked s.truncate(builtin::black_box(2));
}

#[expect_trap]
test "unchecked String::insert off a character boundary" {
    let mut s = "héllo";
    unchecked s.insert(builtin::black_box(2), 'x');
}

#[expect_trap]
test "unchecked String::insert_str off a character boundary" {
    let mut s = "héllo";
    unchecked s.insert_str(builtin::black_box(2), "x");
}

#[expect_trap]
test "unchecked AsStrSlice::slice with the end before the start" {
    let _ = unchecked "abcd".slice(3, builtin::black_box(1));
}

#[expect_trap]
test "unchecked String::substr_bytes off a character boundary" {
    let _ = unchecked "héllo".substr_bytes(0, builtin::black_box(2));
}

#[expect_trap]
test "ByteList::get_byte_unchecked past the length" {
    let mut bytes = ByteList::with_capacity(16);
    bytes.push(1);
    let _ = bytes.get_byte_unchecked(builtin::black_box(1));
}

#[expect_trap]
test "unchecked String::remove at the length" {
    let mut s = String::with_capacity(16);
    s.push_str("abc");
    let _ = unchecked s.remove(builtin::black_box(3));
}

#[expect_trap]
test "char::from_u32_unchecked on a surrogate" {
    let _ = char::from_u32_unchecked(builtin::black_box(0xD800));
}

#[expect_trap]
test "List::get_unchecked past the length" {
    let mut list: List<i32> = List::with_capacity(16);
    list.push(1);
    let _ = Sequence::get_unchecked(&list, builtin::black_box(1));
}

#[expect_trap]
test "AsStrSlice::get_byte_unchecked on a String past the length" {
    let mut s = String::with_capacity(16);
    s.push_str("abc");
    let _ = AsStrSlice::get_byte_unchecked(&s, builtin::black_box(3));
}

#[expect_trap]
test "Sequence::get_unchecked on a Slice past the view" {
    let list: List<i32> = [1, 2, 3, 4];
    let _ = Sequence::get_unchecked(&list.as_slice().slice(0, 2), builtin::black_box(2));
}

#[expect_trap]
test "Slice::get_unchecked past the view" {
    let list: List<i32> = [1, 2, 3, 4];
    let _ = list.as_slice().slice(0, 2).get_unchecked(builtin::black_box(2));
}

__DATA__
{
    "test": {}
}
