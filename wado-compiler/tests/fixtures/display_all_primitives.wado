// Test: Display trait for all primitive types via to_string and fmt
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // i8
    let a: i8 = 127;
    println(a.to_string());
    let b: i8 = -128;
    println(b.to_string());

    // u8
    let c: u8 = 255;
    println(c.to_string());
    let d: u8 = 0;
    println(d.to_string());

    // i16
    let e: i16 = 32767;
    println(e.to_string());
    let f: i16 = -32768;
    println(f.to_string());

    // u16
    let g: u16 = 65535;
    println(g.to_string());

    // i32
    let h: i32 = 2147483647;
    println(h.to_string());
    let i: i32 = -2147483648;
    println(i.to_string());
    println(0.to_string());

    // u32
    let j: u32 = 4294967295;
    println(j.to_string());

    // i64
    let k: i64 = 9223372036854775807;
    println(k.to_string());
    let l: i64 = -9223372036854775808;
    println(l.to_string());

    // u64
    let m: u64 = 18446744073709551615;
    println(m.to_string());

    // f32
    let n: f32 = 3.14;
    println(n.to_string());

    // f64
    let o: f64 = 3.141592653589793;
    println(o.to_string());

    // bool
    println(true.to_string());
    println(false.to_string());

    // char
    let p = 'Z';
    println(p.to_string());
}

__DATA__
{"stdout": "127\n-128\n255\n0\n32767\n-32768\n65535\n2147483647\n-2147483648\n0\n4294967295\n9223372036854775807\n-9223372036854775808\n18446744073709551615\n3.14\n3.141592653589793\ntrue\nfalse\nZ\n"}
