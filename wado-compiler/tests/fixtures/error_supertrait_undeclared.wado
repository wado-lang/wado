// An undeclared supertrait is reported once, at the declaration, not again at
// every implementor of the trait.
trait A: Undeclrd with () {
    fn a(&self) -> i32;
}

struct S {
    v: i32,
}

impl A for S {
    fn a(&self) -> i32 {
        return self.v;
    }
}

export fn run() {
}

__DATA__
{
    "compile_error": ":3:10: error: 'Undeclrd' is not a declared trait",
    "compile_error_count": 1,
    "compile_error_codes": ["UNKNOWN_TYPE"]
}
