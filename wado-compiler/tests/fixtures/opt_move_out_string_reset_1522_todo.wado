// Minimal reproduction of wado-lang/wado#1522: at -O1 and above the optimizer
// drops the value copy in `let text = *buf; *buf = String::new()`, so the
// moved-out string observes the later reset and reads empty. Correct at -O0.
// package-marl/src/inline.wado works around this in `flush_text`. Remove the
// #[TODO] once the optimizer no longer elides the copy.

fn take(buf: &mut String) -> String {
    let text = *buf;
    *buf = String::new();
    return text;
}

#[TODO]
test "moved-out string keeps its value across a reset (#1522)" {
    let mut s = "hello";
    let taken = take(&mut s);
    assert taken == "hello";
    assert s == "";
}

__DATA__
{
    "test": {},
    "only_opt": ["O1", "O2", "O3"]
}
