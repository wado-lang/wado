// A local item declared inside a `match` arm's block body is scoped to that
// arm. Each arm is its own block, so two arms may declare the same name with
// different fields without colliding.

fn f(x: i32) -> i32 {
    match x {
        1 => {
            struct Point {
                v: i32,
            }
            let p = Point { v: 10 };
            return p.v;
        }
        _ => {
            struct Point {
                v: i32,
                w: i32,
            }
            let p = Point { v: 20, w: 2 };
            return p.v + p.w;
        }
    }
}

test "a local item declared inside a match arm is scoped to that arm" {
    assert f(1) == 10;
    assert f(0) == 22;
}
