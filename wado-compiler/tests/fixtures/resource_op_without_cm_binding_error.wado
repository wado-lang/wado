// A resource operation has no body, so the `#[cm(...)]` import is the only
// thing a call to it can reach. The declaration is rejected where it is
// written, which is what keeps such a call from reaching WIR unresolved.

internal resource Widget {
    fn poke(&self, n: i32);
}

export fn run() with Widget {
    let w = 1 as Widget;
    Widget::poke(&w, 3);
}

