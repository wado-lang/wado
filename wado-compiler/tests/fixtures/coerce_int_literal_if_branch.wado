// Test integer literal coercion in if-expression branches.
// `let x: i64 = if cond { -1 } else { 0 };` works because the type
// annotation i64 provides the expected type, which propagates through
// if-expression branches.
use { println, Stdout } from "core:cli";

fn select(cond: bool) -> i64 {
    let x: i64 = if cond {
        -1;
    } else {
        0;
    };
    return x;
}

export fn run() with Stdout {
    println(`true: {select(true)}`);
    println(`false: {select(false)}`);
}

__DATA__
{"stdout": "true: -1\nfalse: 0\n"}
