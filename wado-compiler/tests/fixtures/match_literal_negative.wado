// Test match expression with negative literal patterns

use { println, Stdout } from "core:cli";

fn run() with Stdout {
    // i32 negative
    let a: i32 = -1;
    let r1 = match a {
        0 => "zero",
        -1 => "minus one",
        _ => "other",
    };


    println(r1);

    // i32 larger negative
    let b: i32 = -100;
    let r2 = match b {
        -100 => "minus hundred",
        -1 => "minus one",
        _ => "other",
    };


    println(r2);

    // i64 negative
    let c: i64 = -1000000000000 as i64;
    let r3 = match c {
        0 => "zero",
        -1000000000000 => "minus trillion",
        _ => "other",
    };


    println(r3);

    // Mix positive and negative
    let d: i32 = 42;
    let r4 = match d {
        -42 => "minus answer",
        0 => "zero",
        42 => "answer",
        _ => "other",
    };


    println(r4);

    // Negative as first pattern
    let e: i32 = -5;
    let r5 = match e {
        -5 => "minus five",
        5 => "five",
        _ => "other",
    };


    println(r5);
}

__DATA__
{"stdout": "minus one\nminus hundred\nminus trillion\nanswer\nminus five\n"}
