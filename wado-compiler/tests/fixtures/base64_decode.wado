use { println } from "core:cli";
use { encode, decode, encode_url, decode_bytes } from "core:base64";

export fn run() with Stdout {
    let hello = "Hello".bytes().collect();

    // Decode padded
    assert decode("SGVsbG8=") matches { Some(d) && d == hello };

    // Decode without padding (lenient)
    assert decode("SGVsbG8") matches { Some(d) && d == hello };

    // Decode empty
    assert decode("") matches { Some(d) && d.len() == 0 };

    // Round-trip standard
    let data: Array<u8> = [1, 2, 3, 4, 5] as Array<u8>;
    assert decode(encode(&data)) matches { Some(d) && d == data };

    // Round-trip URL-safe
    assert decode(encode_url(&data)) matches { Some(d) && d == data };

    // decode_bytes
    let raw = "SGVsbG8=".bytes().collect();
    assert decode_bytes(&raw) matches { Some(d) && d == hello };

    // Error cases
    assert decode("!!!") matches { None };
    assert decode("abc+def_ghi") matches { None };
    assert decode("A") matches { None };

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
