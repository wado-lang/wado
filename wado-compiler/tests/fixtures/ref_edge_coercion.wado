// Edge case: &mut T to &T coercion

use { println, Stdout } from "core:cli";

fn read_value(x: &i32) -> i32 {
    return *x;
}

export fn run() with Stdout {
    let mut a = 42;
    let result = read_value(&mut a);  // Passing &mut to & param
    println(`{result}`);
}

__DATA__
{"stdout": "42\n"}
