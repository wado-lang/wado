// A constant operand that is itself an operation. `(1000 + 7) * 3` sits in
// operand position, and the whole chain folds to one constant whether the
// value pool collapses it as it interns it or constant folding does later.
use { println, Stdout } from "core:cli";

#[inline(never)]
fn scale(n: i32) -> i32 {
    return n * ((1000 + 7) * 3)
}

export fn run() with Stdout {
    println(`${scale(builtin::black_box(2))}`);
}

__DATA__
{
    "stdout": "6042\n",
    "wir_expect:O2": ["* 3021"],
    "wir_contrast": {"O2": [
        {"n * ((1000 + 7) * 3)": "n * ((1000 + 7) * builtin::black_box(3))"}
    ]}
}
