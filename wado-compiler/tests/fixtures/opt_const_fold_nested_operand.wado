// A constant operand that is itself an operation. `(1000 + 7) * 3` sits in
// operand position, so folding it needs the value pool to collapse a constant
// operation as it interns it — otherwise the outer multiply's operand is the
// inner multiply's node, and the whole chain reaches Wasm unfolded.
use { println, Stdout } from "core:cli";

#[inline(never)]
fn scale(n: i32) -> i32 {
    return n * ((1000 + 7) * 3)
}

export fn run() with Stdout {
    println(`${scale(builtin::black_box(2))}`);
}

__DATA__
{
    "stdout": "6042\n",
    "wir_expect:O2": ["* 3021"],
    "wir_not_expect:O2": ["1000 + 7"]
}
