// Two modules define `pub interface Logger` with different method sets.
// Each module's Logger must remain distinct — a function that requires
// one must not be unifiable with a function that requires the other.
//
// Regression guard for the bare-name effect-decl-index bug: dispatch
// synthesis previously panicked on duplicate effect names across
// modules because `EffectDeclIndex` keyed entries by bare name. The
// fix re-keys the index by canonical `(decl_module, name)` and
// records the canonical declaring module on every handler method via
// `LocalMethodName.base_trait_module`.

use { greet } from "./sub/cross_module_same_name_effect_a.wado";
use { raise } from "./sub/cross_module_same_name_effect_b.wado";

test "cross-module same-name effects compile" {
    // We don't install effect handlers here — the test only verifies
    // that the compiler accepts both declarations without name
    // collision. Call-site resolution must pick the right Logger for
    // each function.
    let _g = greet;
    let _r = raise;
    assert true;
}

__DATA__
{"test": {}}
