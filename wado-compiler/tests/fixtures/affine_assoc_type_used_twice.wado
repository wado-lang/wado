// A value of an `affine type` projection moves at most once, in any body that
// names it.
affine trait Source with () {
    affine type Item;

    fn next(&mut self) -> Self::Item;
}

fn both<S: Source>(s: &mut S) -> [S::Item, S::Item] {
    let item = s.next();
    return [item, item];
}

export fn run() {
}

