// Test nested loop (loop inside loop) with break

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut outer = 0;
    loop {
        outer = outer + 1;
        let mut inner = 0;
        loop {
            inner = inner + 1;
            println(`outer:{outer} inner:{inner}`);
            if inner >= 2 {
                break;
            }
        }
        if outer >= 2 {
            break;
        }
    }
    println("done");
}

__DATA__
{"stdout": "outer:1 inner:1\nouter:1 inner:2\nouter:2 inner:1\nouter:2 inner:2\ndone\n"}
