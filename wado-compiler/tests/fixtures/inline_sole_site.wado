// A callee with one call site moves into its caller rather than being copied,
// so the inliner admits it there at the price it pays at a loop site.
// `decode_at` is over the plain threshold, and `first_code` is its only caller.

fn decode_at(bytes: &Array<u8>, pos: i32) -> [i32, i32] {
    let b0 = bytes[pos] as i32;
    if b0 < 0x80 {
        return [b0, 1];
    }
    if b0 < 0xE0 {
        return [(b0 & 0x1F) << 6 | bytes[pos + 1] as i32 & 0x3F, 2];
    }
    if b0 < 0xF0 {
        return [(b0 & 0x0F) << 12 | (bytes[pos + 1] as i32 & 0x3F) << 6 | bytes[pos + 2] as i32 & 0x3F, 3];
    }
    return [(b0 & 0x07) << 18 | (bytes[pos + 1] as i32 & 0x3F) << 12 | (bytes[pos + 2] as i32 & 0x3F) << 6 | bytes[pos + 3] as i32 & 0x3F, 4];
}

#[inline(never)]
fn first_code(bytes: &Array<u8>, pos: i32) -> i32 {
    return decode_at(bytes, pos).0;
}

export fn run() {
    let mut bytes: Array<u8> = builtin::array_new(2);
    bytes[0] = 0xC3;
    bytes[1] = 0xA9;
    assert first_code(&builtin::black_box(bytes), builtin::black_box(0)) == 0xE9;
}

__DATA__
{
    "stdout": "",
    "wir_scope": "inline_sole_site.wado/first_code",
    "wir_not_expect:O2": ["\"inline_sole_site.wado/decode_at\"("]
}
