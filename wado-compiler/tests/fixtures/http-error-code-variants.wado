// HTTP ErrorCode variant test
// Tests returning different ErrorCode variants, not just InternalError.

use { Request, Response, ErrorCode } from "wasi:http";

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    // Return a DestinationNotFound error
    task return Result::<Response, ErrorCode>::Err(ErrorCode::DestinationNotFound);
}

