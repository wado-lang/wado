// Type pack expansion with try-op mixed with non-pack elements
use { println, Stdout } from "core:cli";

trait TryDefault {
    fn try_default() -> Result<Self, String>;
}

impl TryDefault for i32 {
    fn try_default() -> Result<i32, String> {
        return Result::<i32, String>::Ok(10);
    }
}

impl TryDefault for bool {
    fn try_default() -> Result<bool, String> {
        return Result::<bool, String>::Ok(true);
    }
}

fn make_with_prefix<..T: TryDefault>(prefix: String) -> Result<[String, ..T], String> {
    return Result::<[String, ..T], String>::Ok([prefix, ..T::try_default()?]);
}

export fn run() with Stdout {
    let result = make_with_prefix::<[i32, bool]>("header");
    if let Ok(t) = result {
        assert t.0 == "header";
        assert t.1 == 10;
        assert t.2 == true;
        println("ok");
    }
}

__DATA__
{"stdout": "ok\n"}
