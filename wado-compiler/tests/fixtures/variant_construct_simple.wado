// Test simple custom variant construction

use { println, Stdout } from "core:cli";

// A simple variant for testing
variant Color {
    Red,
    Green,
    Blue,
}

export fn run() with Stdout {
    // Construct each variant case
    let r = Color::Red;
    let g = Color::Green;
    let b = Color::Blue;

    // We can't print variants yet (no pattern matching),
    // but we can verify construction works
    println("variant construction works");
}

__DATA__
{"stdout": "variant construction works\n"}
