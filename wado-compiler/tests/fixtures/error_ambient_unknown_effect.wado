// `#[ambient(E)]` names an effect in its module's scope, as a `with` clause
// does. `Stdout` is not imported here, so the attribute names nothing.

use { println } from "core:cli";

#[ambient(Stdout)]
fn emit() {
    println("x");
}

export fn run() {
    emit();
}

__DATA__
{"compile_error": "`#[ambient(Stdout)]` on 'emit' names no effect in scope"}
