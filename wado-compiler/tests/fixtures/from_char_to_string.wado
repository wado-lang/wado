// From<char> for String — single character to string conversion
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let c = 'A';
    let s = String::from(c);
    assert s == "A";

    let emoji = '🦀';
    let s2 = String::from(emoji);
    assert s2 == "🦀";

    let newline = '\n';
    let s3 = String::from(newline);
    assert s3.len() == 1;

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
