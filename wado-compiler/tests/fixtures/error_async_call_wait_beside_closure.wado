// A call started inside a closure is the closure's: the function around it
// still declares what waiting on a call it reaches otherwise performs.
#[cm("example:demo/fetch")]
interface Fetch {
    #[cm("example:demo/fetch#get")]
    async fn get(url: String) -> AsyncCall<i32>;
}

global mut PENDING: Option<AsyncCall<i32>> = null;

fn finish() -> i32 {
    let _start = || { let _ = Fetch::get("/b"); };
    if let Some(call) = PENDING.take() {
        return call.wait();
    }
    return 0;
}

export fn run() with Fetch {
    PENDING = Option::Some(Fetch::get("/a"));
    let _ = finish();
}

