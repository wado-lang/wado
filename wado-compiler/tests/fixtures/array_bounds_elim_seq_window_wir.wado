// `xs[i]` takes `xs[i + 3]`'s check, which puts `i` in `0..len - 3`, so
// `xs[i + 1]` and `xs[i + 2]` need no check either: the shape an unrolled loop
// body takes once its ends are read first.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn window(xs: &List<i32>, i: i32) -> i32 {
    return xs[i] + xs[i + 3] + xs[i + 1] + xs[i + 2];
}

export fn run() with Stdout {
    let xs: List<i32> = builtin::black_box([1, 2, 3, 4, 5]);
    println(`${window(&xs, builtin::black_box(1))}`);
}

__DATA__
{
    "stdout": "14\n",
    "wir_scope": "window",
    "wir_expect:O2": [
        "(i < ($load_{n} - 3))) == 0)",
        "builtin::array_get_value<i32>($load_{r}, i + 1)",
        "builtin::array_get_value<i32>($load_{r}, i + 2)"
    ],
    "wir_not_expect:O2": [
        "(i + 1) >=",
        "(i + 2) >=",
        "(i + 3) >="
    ]
}
