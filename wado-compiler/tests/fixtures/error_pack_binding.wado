// A walk over a type pack binds a name, `_`, or a tuple of them as long as
// the element; any other pattern is rejected rather than ignored. A `mut`
// index is no longer the element's position, so it cannot subscript.

fn f<..T>(t: [..T]) -> i32 {
    let r = [for let [i, 3] of t.enumerate() { i }];
    let s = [for let [i, v, w] of t.enumerate() { i }];
    for let [i, v, w] of t.enumerate() {}
    for let Some(v) of t {}
    let q = [for let [[a, b], v] of t.enumerate() { 0 }];
    for let [mut i, v] of t.enumerate() { let w = t[i]; }
    return 0;
}

test {
    assert f([1, 2]) == 0;
}

