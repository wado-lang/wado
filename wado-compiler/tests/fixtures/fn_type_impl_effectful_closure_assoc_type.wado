// An associated type a bound reaches through a closure literal's impl is the
// one the impl for its solved row binds, with no annotation on the result.

use { println, Stdout } from "core:cli";

trait Make with () {
    type Out;
    fn make(&self) -> Self::Out;
}

impl Make for fn() -> i32 with Stdout {
    type Out = i32;
    fn make(&self) -> i32 {
        return 7;
    }
}

fn go<T: Make>(t: &T) -> T::Out {
    return t.make();
}

fn loud() -> i32 with Stdout {
    println("loud");
    return 7;
}

export fn run() with Stdout {
    let h = || loud();
    let x = go(&h);
    println(`${x + 1}`);
}

__DATA__
{
    "stdout": "8\n"
}
