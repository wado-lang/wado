use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // truncate_bytes: ASCII
    let mut s1 = "hello world";
    s1.truncate_bytes(5);
    assert s1 == "hello";

    // truncate_bytes: no-op when len >= current
    let mut s2 = "hi";
    s2.truncate_bytes(10);
    assert s2 == "hi";

    // truncate_bytes: to zero
    let mut s3 = "abc";
    s3.truncate_bytes(0);
    assert s3 == "";

    // truncate_bytes: UTF-8 boundary (3-byte chars)
    let mut s4 = "日本語";  // 9 bytes: 3+3+3
    s4.truncate_bytes(6);    // keep first 2 chars
    assert s4 == "日本";

    // truncate_chars: ASCII
    let mut s5 = "hello world";
    s5.truncate_chars(5);
    assert s5 == "hello";

    // truncate_chars: no-op
    let mut s6 = "hi";
    s6.truncate_chars(100);
    assert s6 == "hi";

    // truncate_chars: to zero
    let mut s7 = "abc";
    s7.truncate_chars(0);
    assert s7 == "";

    // truncate_chars: multibyte
    let mut s8 = "日本語";
    s8.truncate_chars(2);
    assert s8 == "日本";

    // truncate_chars: mixed ASCII and multibyte
    let mut s9 = "A日B本C";
    s9.truncate_chars(3);
    assert s9 == "A日B";

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
