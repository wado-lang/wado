use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

struct Line {
    start: Point,
    end: Point,
}

export fn run() with Stdout {
    let p = Point { x: 1, y: 2 };
    println(`{p:#?}`);

    let line = Line {
        start: Point { x: 10, y: 20 },
        end: Point { x: 30, y: 40 },
    };
    println(`{line:#?}`);
}

__DATA__
{
    "stdout": "Point {\n    x: 1,\n    y: 2,\n}\nLine {\n    start: Point {\n        x: 10,\n        y: 20,\n    },\n    end: Point {\n        x: 30,\n        y: 40,\n    },\n}\n"
}
