// TryFrom trait — narrowing numeric conversions
use { println } from "core:cli";

export fn run() with Stdout {
    let big: i64 = 42;
    let r1 = i32::try_from(big);
    if let Ok(n) = r1 {
        assert n == 42;
    } else {
        panic("expected Ok");
    }

    let too_big: i64 = 3000000000;
    let r2 = i32::try_from(too_big);
    if let Err(msg) = r2 {
        assert msg == "3000000000 out of range for i32";
    } else {
        panic("expected Err");
    }

    let negative: i32 = -1;
    let r3 = u32::try_from(negative);
    if let Err(_) = r3 {
        // ok — negative values can't be unsigned
    } else {
        panic("expected Err for negative → u32");
    }

    let fits: i32 = 100;
    let r4 = u32::try_from(fits);
    if let Ok(n) = r4 {
        assert n == 100 as u32;
    } else {
        panic("expected Ok");
    }

    let small: u32 = 200;
    let r5 = u8::try_from(small);
    if let Ok(n) = r5 {
        assert n == 200 as u8;
    } else {
        panic("expected Ok");
    }

    let overflow: u32 = 300;
    let r6 = u8::try_from(overflow);
    if let Err(_) = r6 {
        // ok — 300 doesn't fit in u8
    } else {
        panic("expected Err for 300 → u8");
    }

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
