// `for-of` over an affine list moves the list into the loop, so reading it
// after the loop is a use after move (WEP: Affine Types).

affine struct Token {
    id: i32,
}

impl Drop for Token {
    fn drop(self) {}
}

export fn run() {
    let tokens: List<Token> = [Token { id: 1 }];
    for let t of tokens {
        builtin::drop(t);
    }
    let n = tokens.len();
}

