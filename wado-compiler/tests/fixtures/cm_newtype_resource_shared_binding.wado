// `Headers` and `Trailers` are both newtypes over the `wasi:http` `Fields` CM
// resource, so both inherit its constructor. `Headers::new()` and
// `Trailers::new()` resolve to the one canonical `fields.constructor` binding;
// the shared adapter must normalize each newtype return to the base resource
// instead of tripping the "call sites disagree on the return type of shared CM
// binding" ICE.
use { Request, Response, ErrorCode, Headers, Trailers } from "wasi:http";

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    let headers = Headers::new();

    let trailers = Trailers::new();
    let has_marker = trailers.has("x-marker");
    assert !has_marker;

    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [response, _tx_future] = Response::new(headers, null, trailers_future);
    task return Result::<Response, ErrorCode>::Ok(response);
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(Option::Some(trailers)));
}

__DATA__
{"wasi:http/service": {"status": 200}}
