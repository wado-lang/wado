// `==` on a reference is identity (WEP 2026-07-05), so no ordering follows from
// it and `Ord: Eq` would be contradicted by ordering the pointees.
fn smallest<O: Ord>(a: O, b: O) -> O {
    if let Less = a.cmp(&b) {
        return a;
    }
    return b;
}

export fn run() {
    let s: String = "a";
    let t: String = "b";
    assert *smallest(&s, &t) == "a";
}

