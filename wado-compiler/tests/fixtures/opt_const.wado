use { println, Stdout } from "core:cli";

// from opt_const_prop.wado
global X: i32 = 10;
global Y: i32 = 20;
global PI_APPROX: f64 = 3.14;
global ENABLED: bool = true;
global mut COUNTER: i32 = 0;

// from opt_const_fold.wado
fn opt_const_fold() with Stdout {
    // Integer comparison folding
    let cmp1 = 10 > 5;
    let cmp2 = 3 == 3;
    let cmp3 = 1 != 2;
    let cmp4 = 5 <= 5;
    println(`cmp: ${cmp1} ${cmp2} ${cmp3} ${cmp4}`);

    // Integer bitwise folding
    let band = 0xFF & 0x0F;
    let bor = 0xF0 | 0x0F;
    let bxor = 0xFF ^ 0x0F;
    println(`bitwise: ${band} ${bor} ${bxor}`);

    // Integer shift folding
    let shl = 1 << 4;
    let shr = 256 >> 4;
    println(`shift: ${shl} ${shr}`);

    // Boolean logical folding
    let and_t = true && true;
    let and_f = true && false;
    let or_t = false || true;
    let or_f = false || false;
    let not_t = !false;
    println(`bool: ${and_t} ${and_f} ${or_t} ${or_f} ${not_t}`);

    // Float arithmetic folding (non-NaN results are folded)
    let fadd = 1.5 + 2.5;
    let fsub = 10.0 - 3.5;
    let fmul = 3.0 * 2.0;
    let fdiv = 10.0 / 4.0;
    println(`float: ${fadd} ${fsub} ${fmul} ${fdiv}`);

    // Float comparison folding
    let flt = 1.0 < 2.0;
    let fge = 5.0 >= 5.0;
    println(`fcmp: ${flt} ${fge}`);

    // Combined: const propagation + const folding
    let a = 10 + 20;
    let b = a * 2;
    println(`combined: ${b}`);
}

// from opt_const_prop.wado
fn opt_const_prop() with Stdout {
    // These should be propagated to literals
    let a = X + Y;
    println(`a=${a}`);

    let b = PI_APPROX;
    println(`b=${b}`);

    let c = ENABLED;
    println(`c=${c}`);

    // Mutable global should NOT be propagated
    COUNTER = COUNTER + 1;
    println(`COUNTER=${COUNTER}`);
}

export fn run() with Stdout {
    opt_const_fold();
    opt_const_prop();
}

__DATA__
{"stdout": "cmp: true true true true\nbitwise: 15 255 240\nshift: 16 16\nbool: true false true false true\nfloat: 4 6.5 6 2.5\nfcmp: true true\ncombined: 60\na=30\nb=3.14\nc=true\nCOUNTER=1\n"}
