// A blanket covering a newtype's static sits at the link of its chain where
// its bound holds, as for a method call: `T2`'s bound holds at `N` itself and
// `T1`'s only at `Base`, so `N::mk()` takes `T2` (rank 2 of the selection
// order, `spec-traits`).

struct Base {
    v: i32,
}

type N = Base;

trait B1 {
    fn b1(&self) -> i32;
}

trait B2 {
    fn b2(&self) -> i32;
}

impl B1 for Base {
    fn b1(&self) -> i32 {
        return 1;
    }
}

impl B2 for N {
    fn b2(&self) -> i32 {
        return 2;
    }
}

trait T1 {
    fn mk() -> i32;
    fn mi(&self) -> i32;
}

trait T2 {
    fn mk() -> i32;
    fn mi(&self) -> i32;
}

impl<T: B1> T1 for T {
    fn mk() -> i32 {
        return 10;
    }

    fn mi(&self) -> i32 {
        return 10;
    }
}

impl<T: B2> T2 for T {
    fn mk() -> i32 {
        return 20;
    }

    fn mi(&self) -> i32 {
        return 20;
    }
}

test {
    let n: N = { v: 0 };
    assert n.mi() == 20;
    assert N::mk() == 20;
    assert Base::mk() == 10;
}

__DATA__
{"test": {}}
