// A list built in the function and read under its loop guard keeps no index
// check. Two things once kept it: LICM hoisted `v.used` a second time once the
// check was inlined, so guard and check read different locals; and the check's
// failure message boxes the index, which marked the loop counter aliased. The
// length is a runtime value, so no constant bound answers for the guard.

#[inline(never)]
fn sum_to(n: i32) -> i32 {
    let mut v: List<i32> = [];
    for let mut k = 0; k < n; k += 1 {
        v.push(k);
    }
    let mut s = 0;
    for let mut i = 0; i < v.len(); i += 1 {
        s += v[i];
    }
    return s;
}

export fn run() {
    assert sum_to(builtin::black_box(4)) == 6;
}

__DATA__
{
    "stdout": "",
    "wir_scope": "opt_bce_local_list_index_boxed.wado/sum_to",
    "wir_pass": {"O2": ["nir/inline"]},
    "wir_not_expect:O2": ["index_value"]
}
