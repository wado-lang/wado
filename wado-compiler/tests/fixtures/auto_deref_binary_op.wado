// Binary operators do not auto-dereference: &T op T is a type error.
// Use explicit dereference (*ref) instead.
export fn run() {
    let a = 10;
    let b = 20;
    let ra = &a;
    let rb = &b;

    // Arithmetic with mixed ref/value types
    let _ = ra + 5;     // &i32 + i32 → error
    let _ = 5 + ra;     // i32 + &i32 → error
    let _ = ra + rb;    // &i32 + &i32 → error
    let _ = ra * rb;    // &i32 * &i32 → error
}

__DATA__
{"compile_error": "type mismatch"}
