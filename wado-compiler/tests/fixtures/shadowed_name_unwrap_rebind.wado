// A binder that takes a name its own source already mentions rebuilds that
// binding rather than hiding it, so the lint passes over it wherever it is
// written: `if let Some(x) = x`, `while let Some(x) = x`, and a `let` deriving
// across a scope. A source naming something else still warns.

use { println, Stdout } from "core:cli";

fn unwrap(a: &Option<i32>) -> i32 {
    if let Some(a) = *a {
        return a;
    }
    return 0;
}

fn drain(xs: List<i32>) -> i32 {
    let mut total = 0;
    let mut xs = xs.into_iter();
    while let Some(xs) = xs.next() {
        total += xs;
    }
    return total;
}

fn step(n: i32) -> i32 {
    if n > 0 {
        let n = n + 1;
        return n;
    }
    return n;
}

export fn run() with Stdout {
    assert unwrap(&Option::<i32>::Some(3)) == 3;
    assert drain([1, 2, 3] as List<i32>) == 6;
    assert step(1) == 2;
    println("ok");
}

__DATA__
{
    "stdout": "ok\n",
    "warnings_not_contains": [
        "`a` shadows",
        "`xs` shadows",
        "`n` shadows"
    ]
}
