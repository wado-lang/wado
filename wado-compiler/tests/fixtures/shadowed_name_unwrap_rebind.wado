// `if let Some(x) = x` and `while let Some(x) = x` rebuild `x` from the binding
// they replace, which is the derivation `let x = x + 1` is sanctioned for. A
// condition takes no `#[allow]`, so a warning there could only be answered by a
// rename. A scrutinee that names something else still warns.

use { println, Stdout } from "core:cli";

fn unwrap(a: &Option<i32>) -> i32 {
    if let Some(a) = *a {
        return a;
    }
    return 0;
}

fn drain(xs: List<i32>) -> i32 {
    let mut total = 0;
    let mut xs = xs.into_iter();
    while let Some(xs) = xs.next() {
        total += xs;
    }
    return total;
}

export fn run() with Stdout {
    assert unwrap(&Option::<i32>::Some(3)) == 3;
    assert drain([1, 2, 3] as List<i32>) == 6;
    println("ok");
}

__DATA__
{
    "stdout": "ok\n",
    "warnings_not_contains": [
        "`a` shadows",
        "`xs` shadows"
    ]
}
