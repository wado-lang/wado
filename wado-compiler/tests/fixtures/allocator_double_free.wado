/// Test that every allocator traps on an immediate double free, the debug one
/// the test world runs under included, so a test catches what production would
/// trap on.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let ptr = builtin::realloc(0, 0, 4, 64);
    builtin::realloc(ptr, 64, 4, 0);
    // Double-free: same pointer freed again immediately
    builtin::realloc(ptr, 64, 4, 0);
    println("should not reach here");
}

__DATA__
{"allocator": ["freelist", "debug"], "trapped": true}
