// A reference or a view (a slice, a `StrSlice`, any struct pointing into storage
// it does not own, generic or not, directly or through an `Option`) has no
// Component Model representation, so it is rejected at the definition site of anything crossing
// the CM boundary, under the name the program uses (`ByteSlice`, not the
// `Slice<u8>` it wraps).
//
// Regression for a silent-degradation bug: the signature type-checked, and the
// failure surfaced only in `wit_emit`, whose error made the CLI skip the
// component-type section for the *whole* component with a warning. That broke
// the static "an `export` appears in WIT" guarantee of
// WEP-2026-06-25 (visibility). The check now runs at the definition site.

export fn takes_slice(a: Slice<i32>) -> i32 {
    return a.len();
}

export fn takes_str_slice(s: StrSlice) -> i32 {
    return s.len();
}

export fn takes_byte_slice(b: ByteSlice) -> i32 {
    return b.len();
}

export struct Window<T> {
    pub items: &List<T>,
}

export fn takes_window(w: Window<i32>) -> i32 {
    return 0;
}

export struct Maybe {
    pub items: Option<&List<i32>>,
}

export fn takes_maybe(m: Maybe) -> i32 {
    return 0;
}

export type ListRef = &List<i32>;

export struct RefField {
    pub b: ListRef,
}

export fn takes_ref_field(l: RefField) -> i32 {
    return 0;
}

export struct Inner {
    pub s: StrSlice,
}

export struct Holder<T> {
    pub i: Inner,
    pub v: T,
}

export fn takes_holder(h: Option<Holder<i32>>) -> i32 {
    return 0;
}

export fn takes_ref(r: &List<i32>) -> i32 {
    return 0;
}

export fn takes_optional_ref(r: Option<&List<i32>>) -> i32 {
    return 0;
}

