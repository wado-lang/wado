// A `use` whose name no site of its module reaches is reported, at the name it
// binds. A trait imported for its methods is used by a call dispatching to one
// (`Halved` is not: `halved` here is `Half`'s own), whatever import put it in
// scope (`traits` for `tripled`). A namespace is used where a site spells it
// (`parts` qualifies a case; `cbor` is not: `to_bytes` reaches its member by
// its own import), an effect by naming it in `#[benign]`, and a re-export by
// whoever imports it. `Stdin::{read_via_stream}` binds the function alone.
use { println, eprintln, eprint, Stdout, Stderr } from "core:cli";
use { Stdin, Stdin::{read_via_stream} } from "wasi:cli";
use traits from "./sub/unused_import_traits.wado";
use parts from "./sub/unused_import_parts.wado";
use { part } from "./sub/unused_import_parts.wado";
use { TreeMap as Map, TreeSet } from "core:collections";
use json from "core:json";
use base64 from "core:base64";
use cbor from "core:cbor";
use { to_bytes } from "core:cbor";
use { Doubled, Halved, Half } from "./sub/unused_import_traits.wado";
pub use { to_string } from "core:json";
#[allow(unused_imports)]
use { from_string } from "core:json";

#[benign(Stderr)]
fn quiet() {
    eprint("");
}

export fn run() with Stdout {
    quiet();
    let m = Map::<i32, i32>::new();
    let half = Half { n: 2 }.halved();
    let bytes = to_bytes(&half).unwrap().len();
    let whole = match part() {
        parts::Whole(n) => n,
        _ => 0,
    };
    println(`${m.len()} ${json::to_string(&21.doubled()).unwrap()} ${half} ${bytes} ${2.tripled()} ${whole}`);
}

__DATA__
{
    "stdout": "0 42 1 1 6 4\n",
    "warnings_contains": [
        "import `eprintln` is never used",
        "import `Stdin` is never used",
        "import `read_via_stream` is never used",
        "import `TreeSet` is never used",
        "import `base64` is never used",
        "import `cbor` is never used",
        "import `Halved` is never used"
    ],
    "warnings_not_contains": [
        "import `println`",
        "import `Stdout`",
        "import `eprint`",
        "import `Stderr`",
        "import `Map`",
        "import `json`",
        "import `to_bytes`",
        "import `Doubled`",
        "import `traits`",
        "import `parts`",
        "import `to_string`",
        "import `from_string`"
    ]
}
