use { println, Stdout } from "core:cli";


// from integer_i32_basic.wado
fn integer_i32_basic() with Stdout {
    // Basic assignment (i32 is default)
    let a = 100000;
    let b = 3000;

    // Arithmetic operations
    let sum = a + b;
    println(`sum: {sum}`);

    let diff = a - b;
    println(`diff: {diff}`);

    let prod = a * b;
    println(`prod: {prod}`);

    let quot = a / b;
    println(`quot: {quot}`);

    let rem = a % b;
    println(`rem: {rem}`);
}

// from integer_i32_comparison.wado
fn integer_i32_comparison() with Stdout {
    let a = 100000;
    let b = 200000;
    let c = -50000;

    // Positive comparisons
    if a < b {
        println("a < b: true");
    }
    if a <= b {
        println("a <= b: true");
    }
    if b > a {
        println("b > a: true");
    }
    if b >= a {
        println("b >= a: true");
    }

    // Negative comparisons (critical for signed types)
    if c < a {
        println("c < a: true");
    }
    if c < 0 {
        println("c < 0: true");
    }
    if a > c {
        println("a > c: true");
    }

    // Equality
    let d = 100000;
    if a == d {
        println("a == d: true");
    }
    if a != b {
        println("a != b: true");
    }
}

// from integer_i32_edge.wado
fn integer_i32_edge() with Stdout {
    // Max value: 2147483647
    let max = 2147483647;
    println(`max: {max}`);

    // Min value: -2147483648
    let min = -2147483648;
    println(`min: {min}`);

    // Negative arithmetic
    let neg = -50000000;
    let pos = 30000000;
    let sum = neg + pos;
    println(`neg + pos: {sum}`);

    // Negative division
    let div_result = -1000 / 7;
    println(`-1000 / 7: {div_result}`);

    // Negative modulo
    let mod_result = -1000 % 7;
    println(`-1000 % 7: {mod_result}`);
}

export fn run() with Stdout {
    integer_i32_basic();
    integer_i32_comparison();
    integer_i32_edge();
}

__DATA__
{"stdout": "sum: 103000\ndiff: 97000\nprod: 300000000\nquot: 33\nrem: 1000\na < b: true\na <= b: true\nb > a: true\nb >= a: true\nc < a: true\nc < 0: true\na > c: true\na == d: true\na != b: true\nmax: 2147483647\nmin: -2147483648\nneg + pos: -20000000\n-1000 / 7: -142\n-1000 % 7: -6\n"}
