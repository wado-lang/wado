// `List::filled(n, 0)` allocates via `array.new_default`, which already
// zero-initializes, so the whole-array fill of the zero scalar is elided at
// -O2; a non-zero fill stays.
export fn run() {
    let a: List<i32> = List::filled(5, 0);
    let b: List<i32> = List::filled(5, 7);
    let f: List<f64> = List::filled(3, 0.0);
    assert a[0] == 0 && a[4] == 0;
    assert b[0] == 7 && b[4] == 7;
    assert f[2] == 0.0;
    assert a.len() == 5 && b.len() == 5 && f.len() == 3;

    let mut n = a.len() + b[0] - 7;
    n += f.len() - 3;
    let d: List<i32> = List::filled(n, 0);
    assert d.len() == 5 && d[4] == 0;
}

__DATA__
{
    "stdout": "",
    "wir_expect:O2": [", 0, 7, 5);"],
    "wir_not_expect:O2": [", 0, 0, 5);", "builtin::array_fill<f64>"]
}
