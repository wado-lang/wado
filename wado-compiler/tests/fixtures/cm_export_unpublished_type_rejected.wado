// An `export fn` puts every named type its signature reaches into the
// package's Component Model interface, so the package publishes each one:
// declared `export`, or adopted from elsewhere with `export use`. A `#[cm]`
// type (`Descriptor`) is exempt, its own interface publishing it, and so is a
// stdlib newtype (`ByteList`), which crosses as the alias it is.

export use { DirEntry, FileType } from "core:fs";
use { WalkEntry } from "core:fs";
use { Descriptor } from "wasi:filesystem";

pub struct Point {
    pub x: i32,
}

export struct Outer {
    pub p: Point,
}

export type Meters = f64;

export fn takes_point(p: Point) -> i32 {
    return p.x;
}

export fn takes_outer(o: Outer) -> i32 {
    return o.p.x;
}

export fn takes_walk(w: WalkEntry) -> String {
    return w.path;
}

export fn takes_entry(e: DirEntry, m: Meters, b: ByteList) -> FileType {
    return e.type;
}

export fn takes_descriptor(d: Descriptor) -> i32 {
    return 0;
}

