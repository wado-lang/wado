// Regression: a binding introduced INSIDE a default expression that shadows
// an EARLIER parameter must win inside that form; the earlier parameter's
// substituted argument must not leak past the shadow.
//
// `Expr::substitute_idents` (annotate side) leaves binder / control forms
// (closure, block, `if`, `match`, labeled block) untouched, so a shadowing
// binding resolves there; reify must agree. Before the fix, reify's
// default-argument override map (keyed by parameter name) hijacked the
// shadowed name inside the form. `reify_expr` now suppresses the override map
// while descending into those forms (`with_defaults_suppressed`).
//
// A closure parameter is exercised here because it is the only such binder
// that is not a control-flow expression, so it runs at every optimization
// level. (`match` / `if let` / labeled-block defaults exercise the same
// suppression path but hit a separate, pre-existing O0 lowering bug for
// control-flow expressions in default-argument position.)
fn apply(n: i32, f: fn(i32) -> i32 = |n| n + 1) -> i32 {
    // Call the closure with a value distinct from `n` so a hijacked body
    // (which would ignore its parameter) is observable.
    return f(n * 100);
}

export fn run() {
    // f defaults to `|n| n + 1`; apply(10) = f(1000) = 1001.
    // With the bug, the closure body's `n` resolves to the outer argument 10,
    // so f would ignore its parameter and return 10 + 1 = 11.
    assert apply(10) == 1001;
    // An explicit closure argument still works.
    assert apply(10, |n| n * 2) == 2000;
}

