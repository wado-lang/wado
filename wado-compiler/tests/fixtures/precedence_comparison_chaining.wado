// Test comparison chaining (Python-like mathematical chaining)
// a < b < c means (a < b) && (b < c)
// NOTE: This feature is not yet implemented - tests are expected to fail

export fn run() {
    // Basic ascending chain
    // 1 < 2 < 3 = (1 < 2) && (2 < 3) = true && true = true
    let a = 1 < 2 < 3;
    assert a == true;

    // Failing ascending chain
    // 1 < 3 < 2 = (1 < 3) && (3 < 2) = true && false = false
    let b = 1 < 3 < 2;
    assert b == false;

    // Basic descending chain
    // 3 > 2 > 1 = (3 > 2) && (2 > 1) = true && true = true
    let c = 3 > 2 > 1;
    assert c == true;

    // Range check pattern
    // 0 <= 5 <= 10 = (0 <= 5) && (5 <= 10) = true && true = true
    let x = 5;
    let d = 0 <= x <= 10;
    assert d == true;

    // Out of range
    // 0 <= 15 <= 10 = (0 <= 15) && (15 <= 10) = true && false = false
    let y = 15;
    let e = 0 <= y <= 10;
    assert e == false;

    // Descending with >=
    // 10 >= 5 >= 0 = (10 >= 5) && (5 >= 0) = true && true = true
    let f = 10 >= 5 >= 0;
    assert f == true;

    // Equality chain
    // 5 == 5 == 5 = (5 == 5) && (5 == 5) = true && true = true
    let g = 5 == 5 == 5;
    assert g == true;

    // Failing equality chain
    // 5 == 5 == 6 = (5 == 5) && (5 == 6) = true && false = false
    let h = 5 == 5 == 6;
    assert h == false;

    // Longer chain
    // 1 < 2 < 3 < 4 = (1 < 2) && (2 < 3) && (3 < 4) = true
    let i = 1 < 2 < 3 < 4;
    assert i == true;
}

