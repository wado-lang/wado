// `#[serde(rename)]` / `#[serde(rename_all)]` on enum and variant cases.
// The strategy applies to the wire tag (serialize key + deserialize match),
// while the source-level case name still drives construction and matching.
use { Serialize, Deserialize } from "core:serde";
use { to_string, from_string } from "core:json";

#[serde(rename_all = "kebab-case")]
variant Command {
    AddRemote(i32),
    List,
    #[serde(rename = "rm")]
    Remove(i32),
}
impl Serialize for Command;
impl Deserialize for Command;

#[serde(rename_all = "snake_case")]
enum Color {
    LightRed,
    DarkBlue,
}
impl Serialize for Color;
impl Deserialize for Color;

test "variant rename_all kebab serialize" {
    assert to_string::<Command>(&Command::AddRemote(5)) matches { Ok(s) && s == `\{"add-remote":5\}` };
    assert to_string::<Command>(&Command::List) matches { Ok(s) && s == `"list"` };
    assert to_string::<Command>(&Command::Remove(9)) matches { Ok(s) && s == `\{"rm":9\}` };
}

test "variant rename_all kebab deserialize" {
    assert from_string::<Command>(`\{"add-remote":7\}`) matches { Ok(Command::AddRemote(v)) && v == 7 };
    assert from_string::<Command>(`"list"`) matches { Ok(Command::List) };
    assert from_string::<Command>(`\{"rm":3\}`) matches { Ok(Command::Remove(v)) && v == 3 };
    // The source-level PascalCase name is not a wire tag.
    assert from_string::<Command>(`\{"AddRemote":7\}`) matches { Err(_) };
}

test "enum rename_all snake_case roundtrips" {
    assert to_string::<Color>(&Color::LightRed) matches { Ok(s) && s == `"light_red"` };
    assert from_string::<Color>(`"dark_blue"`) matches { Ok(Color::DarkBlue) };
    assert from_string::<Color>(`"LightRed"`) matches { Err(_) };
}
