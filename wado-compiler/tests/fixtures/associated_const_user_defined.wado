// Test user-defined associated constants in local impl blocks
use { println, Stdout } from "core:cli";

struct Color {
    r: u8,
    g: u8,
    b: u8,
}

impl Color {
    pub const RED: Color = Color { r: 255 as u8, g: 0 as u8, b: 0 as u8 };
    pub const WHITE: Color = Color { r: 255 as u8, g: 255 as u8, b: 255 as u8 };
}

export fn run() with Stdout {
    let red = Color::RED;
    let white = Color::WHITE;
    println(`red: {red.r}, {red.g}, {red.b}`);
    println(`white: {white.r}, {white.g}, {white.b}`);
}

__DATA__
{"stdout": "red: 255, 0, 0\nwhite: 255, 255, 255\n"}
