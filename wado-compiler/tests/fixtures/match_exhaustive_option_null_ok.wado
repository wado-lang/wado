// Test: Match on Option with Some + null is exhaustive (null coerces to None)
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let opt: Option<i32> = null;
    let val = match opt {
        Some(x) => x,
        null => 0,
    };
    println(`{val}`);
}

__DATA__
{"stdout": "0\n"}
