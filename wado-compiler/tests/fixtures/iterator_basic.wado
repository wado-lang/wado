// Test basic iterator functionality with Array::iter()
use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let arr: Array<i32> = [10, 20, 30];

    // Test iter() with explicit next() calls
    let mut iter = arr.iter();

    if let Some(a) = iter.next() {
        println(`first: {a}`);
    }

    if let Some(b) = iter.next() {
        println(`second: {b}`);
    }

    if let Some(c) = iter.next() {
        println(`third: {c}`);
    }

    // Should be None now
    if let Some(d) = iter.next() {
        println(`unexpected: {d}`);
    } else {
        println("done");
    }
}

__DATA__
{"stdout": "first: 10\nsecond: 20\nthird: 30\ndone\n"}
