use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

fn test_let_struct_ref() with Stdout {
    // let { x, y } = &point should give x: &i32, y: &i32
    let p = Point { x: 10, y: 20 };
    let { x, y } = &p;
    assert *x == 10;
    assert *y == 20;
    println("ok");
}

// A `&mut` destructure of scalar fields is `&mut p.x` written another way, and
// is refused with it (see `compile_errors.rs`).
fn test_let_struct_mut_ref() with Stdout {
    let mut p = Point { x: 10, y: 20 };
    let { x, y } = &p;
    assert *x == 10;
    assert *y == 20;
    p.x = 100;
    assert p.x == 100;
    println("ok");
}

fn test_let_tuple_ref() with Stdout {
    // let [a, b] = &tuple should give a: &T, b: &U
    let t = [10, 20];
    let [a, b] = &t;
    assert *a == 10;
    assert *b == 20;
    println("ok");
}

export fn run() with Stdout {
    test_let_struct_ref();
    test_let_struct_mut_ref();
    test_let_tuple_ref();
}

__DATA__
{"stdout": "ok\nok\nok\n"}
