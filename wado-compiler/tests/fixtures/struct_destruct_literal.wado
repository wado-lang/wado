// Struct destructuring with literal patterns in match/if-let/matches

use { println, Stdout } from "core:cli";

struct IntPair {
    label: String,
    value: i32,
}

struct FloatPair {
    label: String,
    value: f64,
}

struct BoolPair {
    label: String,
    flag: bool,
}

struct CharPair {
    label: String,
    ch: char,
}

struct StringPair {
    first: String,
    second: String,
}

export fn run() with Stdout {
    // Integer literal in match
    let ip = IntPair { label: "int", value: 42 };
    let result = match ip {
        IntPair { label, value: 42 } => `matched int: {label}`,
        _ => "no match",
    };
    println(result);

    // Float literal in match
    let fp = FloatPair { label: "float", value: 3.14 };
    let result2 = match fp {
        FloatPair { label, value: 3.14 } => `matched float: {label}`,
        _ => "no match",
    };
    println(result2);

    // Bool literal in match
    let bp = BoolPair { label: "bool", flag: true };
    let result3 = match bp {
        BoolPair { label, flag: true } => `matched bool: {label}`,
        BoolPair { label, flag: false } => `not matched: {label}`,
    };
    println(result3);

    // Char literal in match
    let cp = CharPair { label: "char", ch: 'Z' };
    let result4 = match cp {
        CharPair { label, ch: 'Z' } => `matched char: {label}`,
        _ => "no match",
    };
    println(result4);

    // String literal in match
    let sp = StringPair { first: "hello", second: "world" };
    let result5 = match sp {
        StringPair { first, second: "world" } => `matched string: {first}`,
        _ => "no match",
    };
    println(result5);

    // Integer literal in if-let
    let ip2 = IntPair { label: "test", value: 0 };
    if let IntPair { label, value: 0 } = ip2 {
        println(`if-let int: {label}`);
    }

    // Bool literal in matches
    let bp2 = BoolPair { label: "check", flag: false };
    if bp2 matches { BoolPair { flag: false, .. } } {
        println("matches bool");
    }
}

__DATA__
{"TODO": true, "stdout": "matched int: int\nmatched float: float\nmatched bool: bool\nmatched char: char\nmatched string: hello\nif-let int: test\nmatches bool\n"}
