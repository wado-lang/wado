// A function holds what its `with` declares and implies, not the resources its
// signature mentions.
use { Headers, FieldName, Fields } from "wasi:http";
use { HashMap } from "core:collections";

fn consume(s: Stream<u8>) with Stream {         // also holds StreamWritable
    let [rx, tx] = Stream::<u8>::new();
    tx.drop();
    rx.drop();
    s.drop();
}

fn make_pair() -> [Stream<u8>, StreamWritable<u8>] with Stream {
    return Stream::<u8>::new();
}

// `Headers` is a newtype of the `Fields` resource.
fn headers_to_map(headers: &Headers) -> HashMap<String, String> with Fields {
    let mut map = HashMap::<String, String>::new();
    for let [name, value] of headers.copy_all() {
        map[name as String] = String::from_utf8_lossy(&value);
    }
    return map;
}

test {
    let [rx, tx] = make_pair();
    tx.drop();
    consume(rx);
    let headers = Headers::new();
    let _ = headers.append("x-id" as FieldName, [55]);
    assert headers_to_map(&headers)["x-id"] == "7";
}
