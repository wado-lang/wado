// TODO: Pre-existing O0/O2 codegen ICE with phantom type args in generic structs.
// (type mismatch: expected (ref $type), found (ref (exact $type)))
// When the underlying codegen bug is fixed, this test should produce "ok".
// The is_known_type_name fix correctly recognizes Direction as a concrete type,
// preventing it from being treated as a free type parameter in the impl lookup.
use { println } from "core:cli";

enum Direction { North, South, East, West }

struct DirMap<D, V> {
    keys: Array<String>,
    values: Array<V>,
}

impl KeyValueLiteralBuilder for DirMap<Direction, V> {
    type Value = V;
    type Output = DirMap<Direction, V>;

    fn new_literal(capacity: i32) -> DirMap<Direction, V> {
        return DirMap { keys: [], values: [] };
    }

    fn insert_literal(&mut self, key: String, value: Self::Value) {
        self.keys.append(key);
        self.values.append(value);
    }

    fn build(self) -> DirMap<Direction, V> {
        return self;
    }
}

export fn run() with Stdout {
    let m: DirMap<Direction, i32> = { north: 1, south: 2 };
    assert m.keys.len() == 2;
    assert m.values[0] == 1;
    println("ok");
}

__DATA__
{"TODO": true, "stdout": "ok\n"}
