// Number literal coercion tests
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Integer literal coerced to float
    let a: f64 = 1;
    let b: f64 = 42;
    let c: f32 = 100;

    // Scientific notation as integer (no decimal point, non-negative exponent)
    let d: i32 = 1e2;  // 100
    let e: i64 = 1e10;  // 10000000000
    let f: i32 = 5e3;  // 5000

    // Scientific notation as float
    let g: f64 = 1e2;
    let h: f64 = 6.022e23;

    // Hex/binary/octal as float
    let i: f64 = 0xFF;  // 255.0
    let j: f64 = 0b1010;  // 10.0
    let k: f64 = 0o77;  // 63.0

    // Print results to verify
    println(`a={a}, b={b}, c={c}`);
    println(`d={d}, e={e}, f={f}`);
    println(`g={g}, h={h}`);
    println(`i={i}, j={j}, k={k}`);
}

__DATA__
{"stdout": "a=1.0, b=42.0, c=100.0\nd=100, e=10000000000, f=5000\ng=100.0, h=6.022e23\ni=255.0, j=10.0, k=63.0\n"}
