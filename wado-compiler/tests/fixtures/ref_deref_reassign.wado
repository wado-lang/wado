// Dereference, modify local copy, and re-reference

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut original = 42;
    let r = &mut original;

    // Read through ref, compute, write back
    let val = *r;
    *r = val * 2 + 1;
    println(`modified: {original}`);

    // Take reference to result of dereference (creates independent copy)
    let val2 = *r;
    let r2 = &val2;
    *r = 0;
    println(`original: {original}`);
    println(`copy: {*r2}`);
}

__DATA__
{"stdout": "modified: 85\noriginal: 0\ncopy: 85\n"}
