// An operation demands the resource declaring it, whatever resource the handle
// is: `tag` demands `Node` on an input too, and `value` demands
// `HtmlInputElement`, which `Node` does not imply.

#[cm("example:demo/dom#node", linearity = "unrestricted", repr = "externref", classes = "0..=1")]
resource Node {
    #[cm("example:demo/dom#node-tag")]
    fn tag(&self) -> String;
}

#[cm("example:demo/dom#input", linearity = "unrestricted", repr = "externref", classes = "1..=1")]
resource HtmlInputElement extends Node {
    #[cm("example:demo/dom#input-value")]
    fn value(&self) -> String;
}

fn describe(n: Node) -> String with (Node, HtmlInputElement) {
    return match n {
        input: HtmlInputElement => `${input.tag()}:${input.value()}`,
        _ => n.tag(),
    };
}

test {
    with Node => &Typed {}, HtmlInputElement => &Typed {} do {
        assert describe(an_input()) == "input:typed";
        assert describe(a_node()) == "input";
    }
}

struct Typed {}

impl Node for Typed {
    fn tag(&self, this: &Node) -> String {
        resume "input"
    }
}

impl HtmlInputElement for Typed {
    fn value(&self, this: &HtmlInputElement) -> String {
        resume "typed"
    }
}

fn a_node() -> Node {
    return builtin::black_box(Node::backed_by(Typed {}));
}

fn an_input() -> Node {
    return builtin::black_box(HtmlInputElement::backed_by(Typed {}));
}
