//! Regression (issue #1418): consuming a `Future<Result<(), ErrorCode>>` and
//! materializing its unit `Ok(())` payload used to ICE the WIR pipeline in the
//! CLI world ("values remaining on stack at end of block"). The future is the
//! completion handle of `write_via_stream` / `read_via_stream`. Matching the
//! `Some(Ok(_))` arm extracts the unit `Ok` payload; that extraction must
//! produce no operand-stack value. See `variant_unit_payload_match.wado` for
//! the minimal, CM-independent case.

use { Preopens, Filesize, PathFlags, OpenFlags, DescriptorFlags, ErrorCode } from "wasi:filesystem";
use { eprintln, Stderr } from "core:cli";

export fn run() with Preopens, Stderr {
    let dirs = Preopens::get_directories();
    let root = dirs[0].0;
    let file = root.open_at(
        PathFlags::none(),
        "out.txt",
        OpenFlags::Create | OpenFlags::Truncate,
        DescriptorFlags::Read | DescriptorFlags::Write,
    ).wait().unwrap();
    let [rx, tx] = Stream::<u8>::new();
    let sub = file.write_via_stream(rx, 0 as Filesize);
    tx.write([65 as u8]);
    tx.drop();
    match sub.read() {
        Some(Ok(_)) => {},
        Some(Err(_)) => {
            eprintln("write failed");
        },
        None => {},
    }
}

__DATA__
{
    "preopened_dirs": [["", "/work"]],
    "stderr": ""
}
