use { println, Stdout } from "core:cli";


// from integer_i64_comparison.wado
fn integer_i64_comparison() with Stdout {
    let a: i64 = 1000000000000 as i64;
    let b: i64 = 2000000000000 as i64;
    let c: i64 = -500000000000 as i64;

    // Positive comparisons
    if a < b {
        println("a < b: true");
    }
    if a <= b {
        println("a <= b: true");
    }
    if b > a {
        println("b > a: true");
    }
    if b >= a {
        println("b >= a: true");
    }

    // Negative comparisons (critical for signed types)
    if c < a {
        println("c < a: true");
    }
    if c < 0 as i64 {
        println("c < 0: true");
    }
    if a > c {
        println("a > c: true");
    }

    // Equality
    let d: i64 = 1000000000000 as i64;
    if a == d {
        println("a == d: true");
    }
    if a != b {
        println("a != b: true");
    }
}

// from integer_i64_edge.wado
fn integer_i64_edge() with Stdout {
    // Max value: 9223372036854775807 (2^63 - 1)
    let max: i64 = 9223372036854775807 as i64;
    println(`max: {max}`);

    // Min value: -9223372036854775808 (-2^63)
    let min: i64 = -9223372036854775808 as i64;
    println(`min: {min}`);

    // Negative arithmetic
    let neg: i64 = -5000000000000 as i64;
    let pos: i64 = 3000000000000 as i64;
    let sum = neg + pos;
    println(`neg + pos: {sum}`);

    // Negative division
    let div_result: i64 = -1000000000000 as i64 / 7 as i64;
    println(`-1000000000000 / 7: {div_result}`);

    // Negative modulo
    let mod_result: i64 = -1000000000000 as i64 % 7 as i64;
    println(`-1000000000000 % 7: {mod_result}`);
}

export fn run() with Stdout {
    integer_i64_comparison();
    integer_i64_edge();
}

__DATA__
{"stdout": "a < b: true\na <= b: true\nb > a: true\nb >= a: true\nc < a: true\nc < 0: true\na > c: true\na == d: true\na != b: true\nmax: 9223372036854775807\nmin: -9223372036854775808\nneg + pos: -2000000000000\n-1000000000000 / 7: -142857142857\n-1000000000000 % 7: -1\n"}
