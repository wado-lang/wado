// An extern handle is a reference, so `as` relates it to no number. Between two
// handles `as` only upcasts, since only a type pattern tests the class.
use { Document, Element, Node, Window } from "wado-lang:web";

fn down(n: Node) -> Element {
    return n as Element;
}

fn sideways(w: Window) -> Node {
    return w as Node;
}

fn up(e: Element) -> Node {
    return e as Node;
}

fn to_int(d: Document) -> u32 {
    return d as u32;
}

fn from_int() -> Document {
    return 0 as Document;
}

fn to_float(d: Document) -> f64 {
    return d as f64;
}

export fn run() {}

__DATA__
{
  "compile_error": "cannot cast 'Node' to 'Element': `as` only upcasts a handle; a type pattern narrows one",
  "compile_errors_contains": [
    "cannot cast 'Window' to 'Node': neither resource extends the other",
    "cannot cast 'Document' to 'u32': an extern handle converts to no other type; `backed_by` makes one of a guest value",
    "cannot cast 'i32' to 'Document': an extern handle converts to no other type; `backed_by` makes one of a guest value",
    "cannot cast 'Document' to 'f64': an extern handle converts to no other type; `backed_by` makes one of a guest value"
  ],
  "compile_error_codes": [
    "INVALID_CAST"
  ],
  "dependencies": {
    "wado-lang:web": "../../../package-web/src/lib.wado"
  }
}
