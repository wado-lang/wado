// Comprehensive test for all primitive type casts.
// Covers: integer width conversions, integer↔float conversions,
// float↔float conversions, and signed/unsigned distinction.

use { println, Stdout } from "core:cli";

fn test_i32_widening() {
    // i32 → i64 (sign-extend)
    let pos: i32 = 42;
    assert pos as i64 == 42 as i64;
    let neg: i32 = -1;
    assert neg as i64 == -1 as i64;

    // i32 → u64 (sign-extend then reinterpret)
    assert pos as u64 == 42 as u64;
}

fn test_u32_widening() {
    // u32 → i64 (zero-extend)
    let small: u32 = 42 as u32;
    assert small as i64 == 42 as i64;
    // Large u32 (> 2^31) must zero-extend, not sign-extend
    let large: u32 = 3000000000 as u32;
    assert large as i64 == 3000000000 as i64;

    // u32 → u64 (zero-extend)
    assert small as u64 == 42 as u64;
    assert large as u64 == 3000000000 as u64;
}

fn test_i8_i16_widening() {
    // i8 → i64 (sign-extend)
    let a: i8 = -1 as i8;
    assert a as i64 == -1 as i64;
    let b: i8 = 100 as i8;
    assert b as i64 == 100 as i64;

    // i16 → i64 (sign-extend)
    let c: i16 = -1000 as i16;
    assert c as i64 == -1000 as i64;

    // u8 → i64 (zero-extend)
    let d: u8 = 255 as u8;
    assert d as i64 == 255 as i64;

    // u16 → i64 (zero-extend)
    let e: u16 = 65535 as u16;
    assert e as i64 == 65535 as i64;
}

fn test_i64_narrowing() {
    // i64 → i32
    let x: i64 = 300;
    assert x as i32 == 300;

    // i64 → u8 (wrap)
    assert x as u8 == 44 as u8;

    // negative i64 → i32
    let neg: i64 = -1;
    assert neg as i32 == -1;
}

fn test_i32_to_f64() {
    // i32 → f64 (signed convert)
    let i: i32 = 42;
    assert i as f64 == 42.0;
    let neg: i32 = -10;
    assert neg as f64 == -10.0;
}

fn test_u32_to_f64() {
    // u32 → f64 (unsigned convert)
    let small: u32 = 100 as u32;
    assert small as f64 == 100.0;
    // Large u32 must use unsigned conversion
    let large: u32 = 3000000000 as u32;
    assert large as f64 == 3000000000.0;
}

fn test_i64_to_f64() {
    // i64 → f64 (signed convert)
    let i: i64 = 1000000;
    assert i as f64 == 1000000.0;
    let neg: i64 = -42;
    assert neg as f64 == -42.0;
}

fn test_u64_to_f64() {
    // u64 → f64 (unsigned convert)
    let u: u64 = 1000000;
    assert u as f64 == 1000000.0;
    // Large u64 that would be negative as i64
    let large: u64 = 10000000000000000000 as u64;
    assert large as f64 == 10000000000000000000.0;
}

fn test_i32_to_f32() {
    // i32 → f32 (signed convert)
    let i: i32 = 42;
    let f = i as f32;
    assert f as f64 == 42.0;

    let neg: i32 = -10;
    let f2 = neg as f32;
    assert f2 as f64 == -10.0;
}

fn test_u32_to_f32() {
    // u32 → f32 (unsigned convert)
    let small: u32 = 100 as u32;
    let f = small as f32;
    assert f as f64 == 100.0;
}

fn test_i64_to_f32() {
    // i64 → f32 (signed convert)
    let i: i64 = 1000;
    let f = i as f32;
    assert f as f64 == 1000.0;
}

fn test_u64_to_f32() {
    // u64 → f32 (unsigned convert)
    let u: u64 = 1000;
    let f = u as f32;
    assert f as f64 == 1000.0;
}

fn test_i8_u8_to_f64() {
    let a: i8 = -5 as i8;
    assert a as f64 == -5.0;

    let b: u8 = 200 as u8;
    assert b as f64 == 200.0;
}

fn test_i16_u16_to_f64() {
    let a: i16 = -1000 as i16;
    assert a as f64 == -1000.0;

    let b: u16 = 50000 as u16;
    assert b as f64 == 50000.0;
}

fn test_i8_u8_to_f32() {
    let a: i8 = 100 as i8;
    let f = a as f32;
    assert f as f64 == 100.0;

    let b: u8 = 200 as u8;
    let f2 = b as f32;
    assert f2 as f64 == 200.0;
}

fn test_f64_to_i32() {
    // f64 → i32 (signed trunc)
    let f = 3.14;
    assert f as i32 == 3;

    let neg = -7.9;
    assert neg as i32 == -7;
}

fn test_f64_to_u32() {
    // f64 → u32 (unsigned trunc, must handle values > 2^31)
    let small = 100.0;
    assert small as u32 == 100 as u32;
    let large = 3000000000.0;
    assert large as u32 == 3000000000 as u32;
}

fn test_f64_to_i8_u8() {
    let f = 100.5;
    assert f as i8 == 100 as i8;
    assert f as u8 == 100 as u8;

    let neg = -5.9;
    assert neg as i8 == -5 as i8;
}

fn test_f64_to_i16_u16() {
    let f = 1000.5;
    assert f as i16 == 1000 as i16;
    assert f as u16 == 1000 as u16;
}

fn test_f64_to_i64() {
    let f = 42.0;
    assert f as i64 == 42 as i64;

    let neg = -7.9;
    assert neg as i64 == -7 as i64;
}

fn test_f64_to_u64() {
    let f = 100.0;
    assert f as u64 == 100 as u64;

    let large = 1000000.0;
    assert large as u64 == 1000000 as u64;
}

fn test_f32_to_i32() {
    let f = 3.14 as f32;
    assert f as i32 == 3;
}

fn test_f32_to_u32() {
    let f = 100.0 as f32;
    assert f as u32 == 100 as u32;

    let large = 3000000000.0 as f32;
    // f32 precision: 3000000000.0f32 rounds to 3000000000
    assert large as u32 == 3000000000 as u32;
}

fn test_f32_to_i8_u8() {
    let f = 50.9 as f32;
    assert f as i8 == 50 as i8;
    assert f as u8 == 50 as u8;
}

fn test_f32_to_i64() {
    let f = 1000.0 as f32;
    assert f as i64 == 1000 as i64;
}

fn test_f32_to_u64() {
    let f = 1000.0 as f32;
    assert f as u64 == 1000 as u64;
}

fn test_f64_f32_conversion() {
    // f64 → f32 (demote)
    let d = 3.14;
    let f = d as f32;
    // f32 precision limits
    let check = f as f64;
    assert check > 3.13 && check < 3.15;

    // f32 → f64 (promote)
    let f2 = 1.5 as f32;
    assert f2 as f64 == 1.5;
}

fn test_chained_casts() {
    // i32 → f64 → i32
    let x = 10;
    assert x as f64 as i32 == 10;

    // i32 → f64 → f32 → i32
    assert x as f64 as f32 as i32 == 10;

    // i32 → i64 → f64 → i32
    assert x as i64 as f64 as i32 == 10;
}

fn test_bool_casts() {
    let t = true;
    let f = false;

    // bool → i32 (noop at Wasm level)
    assert t as i32 == 1;
    assert f as i32 == 0;

    // bool → i64 (zero-extend)
    assert t as i64 == 1 as i64;
    assert f as i64 == 0 as i64;

    // bool → f64 (unsigned convert)
    assert t as f64 == 1.0;
    assert f as f64 == 0.0;

    // bool → f32 (unsigned convert)
    let tf = t as f32;
    assert tf as f64 == 1.0;
}

fn test_same_size_reinterpret() {
    // i32 → u32 (noop)
    let neg: i32 = -1;
    let u = neg as u32;
    // -1 as u32 reinterprets bit pattern
    assert u as i32 == -1;

    // i32 → i8 (truncate + sign-extend)
    let x: i32 = 300;
    assert x as i8 == 44 as i8;

    // i32 → u8 (truncate + mask)
    assert x as u8 == 44 as u8;

    // i32 → i16 (truncate + sign-extend)
    assert x as i16 == 300 as i16;
}

export fn run() with Stdout {
    test_i32_widening();
    test_u32_widening();
    test_i8_i16_widening();
    test_i64_narrowing();
    test_i32_to_f64();
    test_u32_to_f64();
    test_i64_to_f64();
    test_u64_to_f64();
    test_i32_to_f32();
    test_u32_to_f32();
    test_i64_to_f32();
    test_u64_to_f32();
    test_i8_u8_to_f64();
    test_i16_u16_to_f64();
    test_i8_u8_to_f32();
    test_f64_to_i32();
    test_f64_to_u32();
    test_f64_to_i8_u8();
    test_f64_to_i16_u16();
    test_f64_to_i64();
    test_f64_to_u64();
    test_f32_to_i32();
    test_f32_to_u32();
    test_f32_to_i8_u8();
    test_f32_to_i64();
    test_f32_to_u64();
    test_f64_f32_conversion();
    test_chained_casts();
    test_bool_casts();
    test_same_size_reinterpret();
    println("ok");
}

__DATA__
{"stdout": "ok\n"}
