// Test: a guest-created future whose payload is a resource — `future<option<own<error>>>`.
//
// A payload resource's component type is aliased at outer scope only when some
// imported function's signature names it. `Connector::send` does; a future the
// guest creates itself names none, so `own<error>` resolved against a type
// nothing had registered and codegen panicked with
// `unknown component type: resource:error`.
//
// `option<own<error>>` rather than a bare `own<error>` so the writable end has
// a value to send: dropping an unwritten one traps, and there is no way to
// construct an `Error` from the guest.
use { println, Stdout } from "core:cli";
use { Connector, Error } from "wasi:tls";

export fn run() with Stdout, Connector, Error {
    let [rx, tx] = Future::<Option<Error>>::new();
    tx.write(null);
    rx.drop();

    println("resource future written");
}

__DATA__
{"stdout": "resource future written\n"}
