// Test global variable with constant expression (arithmetic)
use { println, Stdout } from "core:cli";

global DOUBLED: i32 = 21 * 2;
global OFFSET: i32 = 100 + 23;
global NEGATIVE: i32 = -42;

export fn run() with Stdout {
    println(`DOUBLED={DOUBLED}`);
    println(`OFFSET={OFFSET}`);
    println(`NEGATIVE={NEGATIVE}`);
}

__DATA__
{"stdout": "DOUBLED=42\nOFFSET=123\nNEGATIVE=-42\n"}
