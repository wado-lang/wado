// Precision: an early-exit guard *inside* a loop body now feeds the following
// bounds check. `if i >= arr.len() { return }` proves `i < arr.len()` for the
// rest of the iteration, so `arr[i]` needs no check. Before loop bodies were
// routed through `process_block`, this fact was never collected inside a loop
// and the check survived at O2.

use { println, Stdout } from "core:cli";

#[inline("never")]
fn scan(arr: List<i32>, start: i32) -> i32 {
    let mut i = start;
    let mut sum = 0;
    loop {
        if i >= 100 {
            break;
        }
        if i >= arr.len() {
            return sum;
        }
        sum += arr[i];
        i += 1;
    }
    return sum;
}

export fn run() with Stdout {
    let arr: List<i32> = [10, 20, 30, 40, 50];
    println(`{scan(arr, 0)}`);
}

__DATA__
{
    "stdout": "150\n",
    "wir_not_expect:O2": [
        "index out of bounds"
    ]
}
