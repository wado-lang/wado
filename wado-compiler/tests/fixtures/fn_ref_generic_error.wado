// A bare generic function name cannot be used as a value: the function type
// depends on type arguments that haven't been provided. The resolver rejects
// it with a dedicated diagnostic pointing at the two ergonomic workarounds:
//   - turbofish on the name itself: `identity::<i32>`
//   - closure wrapper that pins `T` at the use site: `|x| identity(x)`
// A `fn(...)` type annotation on the binding (or a `fn(...)` parameter type
// at a call site) also drives inference and is the recommended form when a
// suitable expected type is in scope.

fn identity<T>(x: T) -> T {
    return x;
}

test "bare generic fn-name without type args is not callable" {
    let f = identity;
    assert f(42) == 42;
}

__DATA__
{
    "compile_error": "cannot reference generic function 'identity' bare"
}
