// Key-value literal: explicit cast to a custom type
use { println, Stdout } from "core:cli";

struct PairList<V> {
    keys: List<String>,
    values: List<V>,
}

impl PairList<V> {
    fn new() -> PairList<V> {
        return PairList { keys: [], values: [] };
    }

    fn len(&self) -> i32 {
        return self.keys.len();
    }
}

impl From<Array<[String, V]>> for PairList<V> {
    fn from(entries: Array<[String, V]>) -> PairList<V> {
        let mut out = PairList::<V>::new();
        for let [key, value] of entries {
            out.keys.push(key);
            out.values.push(value);
        }
        return out;
    }
}

export fn run() with Stdout {
    // Explicit cast coercion
    let m = { name: "Alice", city: "Tokyo" } as PairList<String>;

    assert m.len() == 2;
    assert m.keys[0] == "name";
    assert m.keys[1] == "city";
    assert m.values[0] == "Alice";
    assert m.values[1] == "Tokyo";

    println("cast key-value literal: ok");
}

__DATA__
{"stdout": "cast key-value literal: ok\n"}
