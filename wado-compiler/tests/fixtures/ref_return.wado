use { println, Stdout } from "core:cli";

// from ref_return.wado
fn get_first(arr: &Array<i32>) -> &i32 {
    return &arr[0];
}

// from ref_return_local.wado
fn make_ref() -> &i32 {
    let x = 42;
    return &x;  // In Rust this would be an error!
}

// from ref_return.wado
fn ref_return() with Stdout {
    let nums: Array<i32> = [42, 99, 7];
    let first = get_first(&nums);
    println(`{*first}`);
}

// from ref_return_local.wado
fn ref_return_local() with Stdout {
    let r = make_ref();
    println(`{*r}`);
}

export fn run() with Stdout {
    ref_return();
    ref_return_local();
}

__DATA__
{"stdout": "42\n42\n"}
