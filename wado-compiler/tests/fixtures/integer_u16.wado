use { println, Stdout } from "core:cli";


// from integer_u16_basic.wado
fn integer_u16_basic() with Stdout {
    // Basic assignment
    let a: u16 = 1000 as u16;
    let b: u16 = 30 as u16;

    // Arithmetic operations
    let sum = a + b;
    println(`sum: {sum}`);

    let diff = a - b;
    println(`diff: {diff}`);

    let prod = a * b;
    println(`prod: {prod}`);

    let quot = a / b;
    println(`quot: {quot}`);

    let rem = a % b;
    println(`rem: {rem}`);
}

// from integer_u16_comparison.wado
fn integer_u16_comparison() with Stdout {
    let a: u16 = 1000 as u16;
    let b: u16 = 60000 as u16;
    let c: u16 = 0 as u16;

    // Basic comparisons
    if a < b {
        println("a < b: true");
    }
    if a <= b {
        println("a <= b: true");
    }
    if b > a {
        println("b > a: true");
    }
    if b >= a {
        println("b >= a: true");
    }

    // Comparison with zero
    if c < a {
        println("c < a: true");
    }
    if a > c {
        println("a > c: true");
    }

    // Equality
    let d: u16 = 1000 as u16;
    if a == d {
        println("a == d: true");
    }
    if a != b {
        println("a != b: true");
    }
}

// from integer_u16_edge.wado
fn integer_u16_edge() with Stdout {
    // Max value: 65535
    let max: u16 = 65535 as u16;
    println(`max: {max}`);

    // Min value: 0
    let min: u16 = 0 as u16;
    println(`min: {min}`);

    // Division with large values
    let a: u16 = 60000 as u16;
    let b: u16 = 7 as u16;
    let div_result = a / b;
    println(`60000 / 7: {div_result}`);

    // Modulo with large values
    let mod_result = a % b;
    println(`60000 % 7: {mod_result}`);
}

export fn run() with Stdout {
    integer_u16_basic();
    integer_u16_comparison();
    integer_u16_edge();
}

__DATA__
{"stdout": "sum: 1030\ndiff: 970\nprod: 30000\nquot: 33\nrem: 10\na < b: true\na <= b: true\nb > a: true\nb >= a: true\nc < a: true\na > c: true\na == d: true\na != b: true\nmax: 65535\nmin: 0\n60000 / 7: 8571\n60000 % 7: 3\n"}
