// Test: `core:cli::exit_success()` exits with status code 0.
//
// It wraps `wasi:cli/exit#exit(Ok(()))`, whose host mapping is `Ok(()) -> 0`.
use { println, Stdout } from "core:cli";
use { exit_success, Exit } from "core:cli";

export fn run() with Stdout, Exit {
    println("before");
    exit_success();
}

__DATA__
{
    "stdout": "before\n",
    "exit_code": 0,
    "trapped": false
}
