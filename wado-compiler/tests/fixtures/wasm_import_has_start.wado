// A `start` section runs side-effecting code at instantiation time, which
// the embedding never does. The compiler rejects the asset with a
// diagnostic that points users at the constraint.

use _ from "./sub/wasm_import_has_start.wat" with { type: "wat" };

export fn run() {}

__DATA__
{
    "compile_error": "a start section is not supported"
}
