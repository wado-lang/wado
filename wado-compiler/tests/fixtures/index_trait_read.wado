// Test: Index trait for [] read operator
use { println, Stdout } from "core:cli";

struct ReadOnlyBox {
    value: i32,
}

impl<i32> Index<i32> for ReadOnlyBox {
    type Output = i32;

    fn index(&self, _index: i32) -> &Self::Output {
        return &self.value;
    }
}

export fn run() with Stdout {
    let box = ReadOnlyBox { value: 42 };
    // Use [] operator which calls index()
    let x = box[0];
    println(`Value: {x}`);
}

__DATA__
{"stdout": "Value: 42\n"}
