// `unconditional_trap` warns where an integer `/` or `%` always traps: its
// divisor is the literal zero, or both operands are literals and the quotient
// overflows. The program still compiles and the operation traps at run time.

#[expect_trap]
test "divides by zero" {
    let x = builtin::black_box(10);
    let _ = x / 0;
}

#[expect_trap]
test "takes a remainder by zero" {
    let x = builtin::black_box(10 as u64);
    let _ = x % 0;
}

#[expect_trap]
test "MIN / -1 overflows" {
    let _ = -128 as i8 / -1;
}

test "a float divides by zero without trapping" {
    let x = builtin::black_box(1.0);
    assert x / 0.0 == f64::INFINITY;
    assert -128 as i8 % -1 == 0;
}

#[allow(unconditional_trap)]
#[expect_trap]
test "allowed" {
    let _ = builtin::black_box(7) / 0;
}

__DATA__
{
    "test": {},
    "warnings_contains": [
        "`x / 0` divides by zero, so it always traps",
        "`x % 0` divides by zero, so it always traps",
        "`-128 as i8 / -1` overflows `i8`, so it always traps"
    ],
    "warnings_not_contains": ["x / 0.0", "`-128 as i8 % -1`", "black_box(7)"]
}
