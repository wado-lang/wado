// Regression test: a statement that leaves its function by `return` on every
// path is no cold path. `pick`'s `match` returns from both arms, so the
// expression statement has type `!`, as a `panic(…)` does. Marked cold on that
// type, it made all of `pick` cold, and Constant Object Globalization left the
// hot `&"hello"` a per-call allocation.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn byte_sum(s: &String, extra: i32) -> i32 {
    let mut total = extra;
    for let i of 0..<s.len() {
        total = total + unchecked s.byte_at(i) as i32;
    }
    return total;
}

#[inline(never)]
fn pick(opt: Option<i32>) -> i32 {
    (match opt {
        Some(v) => return v + byte_sum(&"hello", builtin::black_box(0)),
        None => return 0,
    });
}

export fn run() with Stdout {
    println(`${pick(builtin::black_box(Option::Some(1)))}`);
}

__DATA__
{
    "stdout": "533\n",
    "wir_pass": {"O2": ["nir/const_object_globalization"]},
    "wir_expect:O2": [
        "global global:cold_path_every_arm_returns.wado::$const_obj_0"
    ]
}
