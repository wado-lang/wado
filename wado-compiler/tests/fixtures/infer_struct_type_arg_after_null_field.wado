// A `null` field names the slot without answering it, so a later field still
// settles the slot.

struct Cache<T> {
    cached: Option<T>,
    items: List<T>,
}

struct Lazy<T> {
    cached: Option<T>,
    compute: fn() -> T,
}

fn lazy<T>(compute: fn() -> T) -> Lazy<T> {
    let state = Lazy { cached: null, compute };
    return state;
}

test {
    let items: List<i32> = [1, 2];
    let cache = Cache { cached: null, items };
    assert cache.items.len() == 2;
    assert cache.cached == null;

    let made = lazy(|| "x");
    assert (made.compute)() == "x";
}
