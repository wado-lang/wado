// Test local integer variables

use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let a = 10;
    let b = 20;
    let sum = a + b;

    // Test: sum should be 30, so this condition is true
    if sum == 30 {
        println("integers work");
    }
}

__DATA__
{"stdout": "integers work\n"}
