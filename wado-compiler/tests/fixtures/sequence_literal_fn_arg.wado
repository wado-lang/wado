// SequenceLiteralBuilder: sequence literal as function argument
use { println, Stdout } from "core:cli";

struct SeqVec<T> {
    items: List<T>,
}

impl SeqVec<T> {
    fn new() -> SeqVec<T> {
        return SeqVec { items: [] };
    }

    fn len(&self) -> i32 {
        return self.items.len();
    }

    fn get(&self, i: i32) -> T {
        return self.items[i];
    }
}

impl From<Array<T>> for SeqVec<T> {
    fn from(elements: Array<T>) -> SeqVec<T> {
        let mut out = SeqVec::<T>::new();
        for let element of elements {
            out.items.push(element);
        }
        return out;
    }
}

fn count_items(v: SeqVec<i32>) -> i32 {
    return v.len();
}

export fn run() with Stdout {
    // Function argument coercion
    let result = count_items([1, 2, 3, 4, 5]);
    assert result == 5;

    // Empty sequence literal
    let empty: SeqVec<i32> = [];
    assert empty.len() == 0;

    println("sequence-literal-fn-arg: ok");
}

__DATA__
{"stdout": "sequence-literal-fn-arg: ok\n"}
