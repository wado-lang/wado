// Test writing actual trailers after the response body.
//
// Tests:
// - Creating Fields for trailers with actual header values
// - Writing trailers via FutureWritable after body stream is complete
// - Response body + trailers flow
// - Fields operations on trailer fields (append, has)

use { Request, Response, ErrorCode, Fields, FieldName, FieldValue, Trailers } from "wasi:http";

export async fn handle(request: Request) -> Result<Response, ErrorCode>
    with Request, Response
{
    // Prepare trailers
    let trailers = Fields::new();
    let _ = trailers.append("x-checksum" as FieldName, "abc123".as_bytes() as FieldValue);
    let _ = trailers.append("x-request-id" as FieldName, "req-001".as_bytes() as FieldValue);
    assert trailers.has("x-checksum" as FieldName);
    assert trailers.has("x-request-id" as FieldName);

    // Build response with body stream
    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [resp_rx, resp_tx] = Stream::<u8>::new();
    let headers = Fields::new();
    let _ = headers.append("content-type" as FieldName, "text/plain".as_bytes() as FieldValue);
    let [response, _tx_future] = Response::new(headers, Option::<Stream<u8>>::Some(resp_rx), trailers_future);

    task return Result::<Response, ErrorCode>::Ok(response);

    // Write body
    resp_tx.write("response body".as_bytes());
    resp_tx.drop();

    // Write actual trailers (not null)
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(Option::<Trailers>::Some(trailers as Trailers)));
}

__DATA__
{
    "wasi:http/service": {
        "status": 200,
        "body": "response body",
        "headers_contain": [["content-type", "text/plain"]]
    }
}
