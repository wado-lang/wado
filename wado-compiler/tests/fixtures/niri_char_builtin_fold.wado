// CTFE evaluates `builtin::i32_as_char`, the bodyless builtin
// `char::from_u32_unchecked` wraps; without it any constant call reaching a
// char conversion bails and never folds. `#[inline(never)]` keeps the inliner
// away, so the fold is attributable to niri. The `eq_ignore_ascii_case` call
// pins the real-world shape: its inlined body splices `to_ascii_lowercase('Q')`
// into the caller, and that constant side must fold even though
// `to_ascii_lowercase` itself stays out-of-line.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn lower_k() -> char {
    return 'K'.to_ascii_lowercase();
}

export fn run() with Stdout {
    let a = lower_k();
    let c = (builtin::black_box(81) & 127) as u8 as char;
    let eq = c.eq_ignore_ascii_case(&'Q');
    if a != 'k' {
        panic("dead_char_fold_83125");
    }
    println(`${a} ${eq as i32}`);
}

__DATA__
{
    "stdout": "k 1\n",
    "wir_not_expect:O2": [
        "dead_char_fold_83125",
        "lower_k",
        "char::to_ascii_lowercase\"(81)"
    ]
}
