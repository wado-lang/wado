// A user who declares their own `trait Reflect` owns that name: the seal (for
// the compiler's sealed Reflect) must not fire on an impl of the user's trait.

trait Reflect {
    fn describe(&self) -> String;
}

struct Foo {
    a: i32,
}

impl Reflect for Foo {
    fn describe(&self) -> String {
        return "foo";
    }
}

test "user-defined Reflect trait works" {
    let f = Foo { a: 1 };
    assert f.describe() == "foo";
}

__DATA__
{"test": {}}
