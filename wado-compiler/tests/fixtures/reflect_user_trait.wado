// A user who declares their own `trait ReflectStruct` owns that name: the seal
// (for the compiler's sealed ReflectStruct) must not fire on an impl of the
// user's trait.

trait ReflectStruct {
    fn describe(&self) -> String;
}

struct Foo {
    a: i32,
}

impl ReflectStruct for Foo {
    fn describe(&self) -> String {
        return "foo";
    }
}

test "user-defined ReflectStruct trait works" {
    let f = Foo { a: 1 };
    assert f.describe() == "foo";
}

__DATA__
{"test": {}}
