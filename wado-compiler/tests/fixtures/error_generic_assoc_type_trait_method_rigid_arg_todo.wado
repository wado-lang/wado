#![TODO]
// A projection a trait method's signature writes owes the family's parameter
// bounds, as one a function's signature writes does: `Self::Buf<T>` needs
// `T: Elem`, which `hold` never asks for.
//
// Today the decl pass skips an argument naming a type parameter, so the trait
// is accepted. `measure` then reaches `Weighed<String>`, and the error surfaces
// in the `Len` impl's body when it is instantiated, far from its cause.

trait Elem with () {
    fn weight(&self) -> i32;
}

impl Elem for i32 {
    fn weight(&self) -> i32 {
        return *self;
    }
}

trait Len with () {
    fn total(&self) -> i32;
}

struct Weighed<E> {
    items: List<E>,
}

impl<E: Elem> Len for Weighed<E> {
    fn total(&self) -> i32 {
        let mut sum = 0;
        for let item of self.items {
            sum += item.weight();
        }
        return sum;
    }
}

trait Store with () {
    type Buf<E: Elem>: Len;

    fn hold<T>(&self, items: List<T>) -> Self::Buf<T>;
}

struct Weigher {}

impl Store for Weigher {
    type Buf<E: Elem> = Weighed<E>;

    fn hold<T>(&self, items: List<T>) -> Weighed<T> {
        return Weighed { items };
    }
}

fn measure<S: Store>(s: &S) -> i32 {
    return s.hold(["a", "bc"] as List<String>).total();
}

export fn run() {
    measure(&Weigher {});
}

__DATA__
{
  "compile_error": ":41:52: analysis error: type 'T' does not implement trait 'Elem' required by bound on 'E'",
  "compile_error_codes": ["TRAIT_BOUND_NOT_SATISFIED"]
}
