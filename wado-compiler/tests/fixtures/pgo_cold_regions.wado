// A profile marks cold each outermost region it never ran in a function the
// workloads entered: the `then` of `x < 0` in `sign` and the `-1` arm in
// `weigh`. `unprofiled`, which they never entered, keeps its code unmarked.
use { println, Stdout } from "core:cli";

fn sign(x: i32) -> i32 {
    if x < 0 {
        return -1;
    }
    if x == 0 {
        return 0;
    }
    return 1;
}

fn weigh(xs: List<i32>) -> i32 {
    let mut total = 0;
    for let x of xs {
        total += match sign(x) {
            -1 => {
                let doubled = x * 2;
                doubled
            },
            0 => 0,
            _ => x,
        };
    }
    return total;
}

fn unprofiled(x: i32) -> i32 {
    if x > 0 {
        return x;
    }
    return 0;
}

export fn run() with Stdout {
    println(`${weigh([-1, 0, 2])} ${unprofiled(3)}`);
}

__DATA__
{
  "profile": "testdata/pgo_cold_regions.pgo",
  "cold_regions": [
    "pgo_cold_regions.wado:7:14 then",
    "pgo_cold_regions.wado:20:19 arm"
  ],
  "stdout": "0 3\n"
}
