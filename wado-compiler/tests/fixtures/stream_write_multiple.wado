// Test: a write to a stream whose reader is gone settles as Dropped and hands
// the data back.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let [rx, tx] = Stream::<u8>::new();

    // Close the reader first so the write sees DROPPED rather than BLOCKED
    rx.drop();

    let chunk: List<u8> = [65, 66, 67, 10];  // "ABC\n"
    let [tx, written] = tx.start_write(chunk).finish();
    assert written.result == CopyResult::Dropped;
    assert written.rest.len() == 4;
    tx.drop();

    println("multi write ok");
}

__DATA__
{"stdout": "multi write ok\n"}
