// ReflectVariant case walk (WEP 2026-06-13 §3e): members() returns VariantCase<V, P>
// members; a tuple for-of statically binds each case's payload type, and
// holds / extract / construct bridge values in both directions.

variant Shape {
    Circle(f64),
    Rectangle([f64, f64]),
    Point,
}

test "holds finds the live case" {
    let s = Shape::Rectangle([3.0, 4.0]);
    let mut hits = 0;
    for let c of ReflectVariant::<Shape>::members() {
        if c.holds(&s) {
            hits += 1;
            assert c.discriminant() == 1;
        }
    }
    assert hits == 1;
}

test "extract returns the typed payload" {
    let s = Shape::Circle(2.5);
    let mut out = "";
    for let c of ReflectVariant::<Shape>::members() {
        if c.holds(&s) {
            out = `${c.extract(&s):?}`;
        }
    }
    assert out == "2.5";
}

test "construct builds each case" {
    let cs = ReflectVariant::<Shape>::members();
    let circle = cs.0.construct(2.5);
    assert circle matches { Circle(r) && r == 2.5 };
    let rect = cs.1.construct([3.0, 4.0]);
    assert rect matches { Rectangle([w, h]) && w == 3.0 && h == 4.0 };
    let point = cs.2.construct(());
    assert point matches { Point };
}

#[expect_trap]
test "extract on a non-live case traps" {
    let s = Shape::Point;
    let cs = ReflectVariant::<Shape>::members();
    let r = cs.0.extract(&s);
    assert r == 0.0;
}

__DATA__
{"test": {}}
