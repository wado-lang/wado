// Test importing from a subdirectory

use { println, Stdout } from "core:cli";
use { double, get_magic } from "./sub/helper.wado";

export fn run() with Stdout {
    let x = get_magic();
    let y = double(x);
    println(`magic: {x}, doubled: {y}`);
}

__DATA__
{"stdout": "magic: 42, doubled: 84\n"}
