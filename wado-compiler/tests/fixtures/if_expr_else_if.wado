use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let n = 25;
    let x = if n < 10 {
        1;
    } else if n < 20 {
        2;
    } else if n < 30 {
        3;
    } else {
        4;
    };


    println(`{x}`);
    let y = if n == 25 {
        100;
    } else if n == 24 {
        200;
    } else {
        300;
    };


    println(`{y}`);
}

__DATA__
{"stdout": "3\n100\n"}
