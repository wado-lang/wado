use { println, Stdout } from "core:cli";

fn test_overflow() with Stdout {
    // Addition overflow: 32767 + 1 should wrap to -32768
    let a: i16 = 32767 as i16;
    let b: i16 = 1 as i16;
    let sum = a + b;
    println(`32767 + 1: {sum}`);

    if sum < 0 as i16 {
        println("sum is negative: true");
    } else {
        println("sum is negative: false");
    }

    // Subtraction underflow: -32768 - 1 should wrap to 32767
    let min: i16 = -32768 as i16;
    let sub = min - b;
    println(`-32768 - 1: {sub}`);

    if sub > 0 as i16 {
        println("sub is positive: true");
    } else {
        println("sub is positive: false");
    }

    // Multiplication overflow: 32767 * 2 should wrap to -2
    let two: i16 = 2 as i16;
    let mul = a * two;
    println(`32767 * 2: {mul}`);
}

export fn run() with Stdout {
    test_overflow();
}

__DATA__
{"stdout": "32767 + 1: -32768\nsum is negative: true\n-32768 - 1: 32767\nsub is positive: true\n32767 * 2: -2\n"}
