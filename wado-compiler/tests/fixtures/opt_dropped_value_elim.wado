// Test: a discarded value keeps only its effects. `let _ = xs.pop()` inlines to
// a block breaking with an `Option` on both paths; nothing reads it, so neither
// allocation survives. The `used` decrement does, and so does the element read,
// which may trap.

use { println, Stdout } from "core:cli";

fn drain(n: i32) -> i32 {
    let mut xs: List<i32> = [];
    for let mut i = 0; i < n; i += 1 {
        xs.push(i);
    }
    let _ = xs.pop();
    let _ = xs.pop();
    return xs.len();
}

export fn run() with Stdout {
    println(`${drain(builtin::black_box(5))}`);
}

__DATA__
{
    "stdout": "3\n",
    "wir_not_expect:O2": [
        "Option<i32>"
    ]
}
