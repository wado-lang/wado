// `${x:e}` / `${x:E}` on integers, matching Rust: the mantissa drops trailing
// zeros, or carries `precision + 1` digits rounded half to even.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    assert `${0:e}` == "0e0";
    assert `${1:e}` == "1e0";
    assert `${10:e}` == "1e1";
    assert `${1200:e}` == "1.2e3";
    assert `${12345:e}` == "1.2345e4";
    assert `${-42:e}` == "-4.2e1";
    assert `${12345:E}` == "1.2345E4";

    // Precision fixes the mantissa width, padding with zeros when short.
    assert `${12345:.0e}` == "1e4";
    assert `${12345:.2e}` == "1.23e4";
    assert `${12345:.6e}` == "1.234500e4";
    assert `${0:.3e}` == "0.000e0";

    // Ties round to even; a carry moves the exponent up a decade.
    assert `${15:.0e}` == "2e1";
    assert `${25:.0e}` == "2e1";
    assert `${35:.0e}` == "4e1";
    assert `${45:.0e}` == "4e1";
    assert `${1250:.1e}` == "1.2e3";
    assert `${1350:.1e}` == "1.4e3";
    assert `${1251:.1e}` == "1.3e3";
    assert `${99:.0e}` == "1e2";
    assert `${9999:.2e}` == "1.00e4";

    // Sign, width and zero padding apply as they do to any number.
    assert `${12345:+10.2e}` == "   +1.23e4";
    assert `${-1200:>10e}` == "    -1.2e3";
    assert `${-1200:012e}` == "-0000001.2e3";

    // Every width, `MIN` included — negating it needs the unsigned magnitude.
    let min32: i32 = -2147483648;
    assert `${min32:e}` == "-2.147483648e9";
    let max64: u64 = 18446744073709551615;
    assert `${max64:e}` == "1.8446744073709551615e19";
    let min128: i128 = -170141183460469231731687303715884105728;
    assert `${min128:e}` == "-1.70141183460469231731687303715884105728e38";
    let max128: u128 = 340282366920938463463374607431768211455;
    assert `${max128:.3e}` == "3.403e38";
    let small: i8 = 5;
    assert `${small:e}` == "5e0";
    let byte: u8 = 255;
    assert `${byte:e}` == "2.55e2";

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
