//! Two impls of one trait that agree on the first argument and differ only
//! after it. Selection read one argument and compared it by type *name*, so
//! these were an overload nothing settled and the call was refused. It reads
//! the whole argument list now, each argument against the parameter written
//! for it.

trait Conv<T> {
    fn make(tag: i32, v: T) -> i32;
}

struct M {}

impl Conv<i32> for M {
    fn make(tag: i32, v: i32) -> i32 {
        return 1;
    }
}

impl Conv<String> for M {
    fn make(tag: i32, v: String) -> i32 {
        return 2;
    }
}

test "an argument after the first separates the impls" {
    assert M::make(0, "x") == 2;
    assert M::make(0, 5) == 1;
}
