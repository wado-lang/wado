// A function's parameters and its body share one scope, so a parameter named
// twice, or a `let` taking a parameter's name without deriving from it, is a
// redeclaration. So is a name one pattern binds twice.

fn twice(x: i32, x: i32) -> i32 {
    return x;
}

fn over_param(y: i32) -> i32 {
    let y = 2;
    return y;
}

fn in_one_pattern() -> i32 {
    let [z, z] = [1, 2];
    return z;
}

test {
    assert twice(1, 2) + over_param(1) + in_one_pattern() > 0;
}

__DATA__
{"compile_error": ":5:18: analysis error: cannot redeclare 'x' in the same scope (first defined at 5:10)\n  hint: shadowing is allowed when the new value is derived from the old one (e.g., `let x = x + 1`); 10:9: cannot redeclare 'y' in the same scope (first defined at 9:15)\n  hint: shadowing is allowed when the new value is derived from the old one (e.g., `let y = y + 1`); 15:13: cannot redeclare 'z' in the same scope (first defined at 15:10)"}
