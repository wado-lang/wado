// Test that explicit tuple field access (.0) inside a variadic tuple literal
// is NOT confused with spread expansion during monomorphization.
// The bug: monomorphizer uses FieldAccess{field_index:0} as heuristic for spread,
// which incorrectly expands non-spread field accesses on tuple-typed expressions.
fn combine<..T>(pair: [i32, i32], rest: [..T]) -> [i32, ..T] {
    // pair.0 is a normal field access, ..rest is a spread.
    // Both produce FieldAccess nodes, but only the spread should be expanded.
    return [pair.0, ..rest];
}

export fn run() {
    let result = combine([10, 20], [30, 40]);
    // Should be [10, 30, 40] — pair.0 is 10, rest is (30, 40)
    // Bug would produce [10, 20, 30, 40] — pair.0 incorrectly expanded to pair.0, pair.1
    assert result.0 == 10;
    assert result.1 == 30;
}

__DATA__
{"stdout": ""}
