// An assert inside a closure declares its capture locals without a value. The
// closure numbers its locals apart from the function around it, so the cell of
// an address-taken local there must not be mistaken for one of them.

use { println, Stdout } from "core:cli";

fn total(v: List<i32>) -> i32 {
    return v.len();
}

fn wrapper(f: fn() with Stdout) with Stdout {
    f();
}

export fn run() with Stdout {
    let ok = false;
    if builtin::black_box(false) { builtin::black_box(&ok); }
    wrapper(|| {
        assert ok || total([1, 2, 3]) == 3;
        println("ok");
    });
}

__DATA__
{"stdout": "ok\n"}
