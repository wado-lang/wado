// `touch` takes only `&h`, but `h` holds `&mut x`, and the callee writes `x.f`
// through it. The `1` stored before the call must not be forwarded past it.

use { println, Stdout } from "core:cli";

struct S {
    f: i32,
}

struct Holder {
    r: &mut S,
}

#[inline(never)]
fn touch(h: &Holder) {
    h.r.f = 2;
}

export fn run() with Stdout {
    let mut x = S { f: builtin::black_box(1) };
    let h = Holder { r: &mut x };
    touch(&h);
    println(`${x.f}`);
}

__DATA__
{"stdout": "2\n"}
