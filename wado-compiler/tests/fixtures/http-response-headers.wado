// HTTP response headers test
// Verifies that headers appended before Response::new() are visible
// in the actual HTTP response received by the client.
//
// Sets "x-wado: hello" and checks it via headers_contain in the spec.

use { Request, Response, ErrorCode, Fields, FieldName, FieldValue, Trailers } from "wasi:http";

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();

    let headers = Fields::new();
    // "hello" as UTF-8 bytes: [104, 101, 108, 108, 111]
    let value: Array<u8> = [104 as u8, 101 as u8, 108 as u8, 108 as u8, 111 as u8];
    let _ = headers.append("x-wado" as FieldName, value as FieldValue);

    let [response, _tx_future] = Response::new(headers, null, trailers_future);
    task return Result::<Response, ErrorCode>::Ok(response);
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

__DATA__
{"wasi:http/service": {"status": 200, "headers_contain": [["x-wado", "hello"]]}}
