// `break` alone leaves the innermost loop. A labeled block wrapped around a
// loop nest is how a single `break` leaves all of it — Wado has no loop labels
// — and the block's tail is the path no `break` took.

fn find(grid: List<List<i32>>, needle: i32) -> [i32, i32] {
    let mut hit = [-1, -1];
    search: {
        for let r of 0..<grid.len() {
            for let c of 0..<grid[r].len() {
                if grid[r][c] == needle {
                    hit = [r, c];
                    break search;
                }
            }
        }
        hit = [-2, -2];
    }
    return hit;
}

test "a labeled break leaves every enclosing loop" {
    let grid: List<List<i32>> = [[1, 2], [3, 4], [5, 6]];
    let [r, c] = find(grid, 4);
    assert r == 1;
    assert c == 1;
}

test "the tail runs only when no break was taken" {
    let grid: List<List<i32>> = [[1, 2], [3, 4]];
    let [r, c] = find(grid, 9);
    assert r == -2;
    assert c == -2;
}

test "a value-carrying break leaves the loop nest too" {
    let grid: List<List<i32>> = [[1, 3], [8, 5]];
    let first_even = find_even: {
        for let row of grid {
            for let x of row {
                if x % 2 == 0 {
                    break find_even: x;
                }
            }
        }
        -1
    };
    assert first_even == 8;
}

__DATA__
{"test": {}}
