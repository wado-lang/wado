// No `Option<!>` is a `Some`: its payload would be a `!`, which has no value.

test "unreachable: a Some pattern on an Option<!>" {
    let x = null;
    assert !(x matches { Some(_) });
    if let Some(_) = x {
        assert false;
    }
}

