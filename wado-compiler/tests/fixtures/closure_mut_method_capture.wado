// A `&mut self` method called on a captured binding writes it, as an assignment
// does: the closure captures it `&mut` and is a `fn mut`, and the write lands in
// the binding rather than in a copy.

use { println, Stdout } from "core:cli";

fn call(mut f: fn mut(i32)) {
    f(1);
}

struct Log {
    items: List<i32>,
}

export fn run() with Stdout {
    let mut seen: List<i32> = [];
    call(|v: i32| seen.push(v));
    let mut log = Log { items: [] };
    call(|v: i32| log.items.push(v + 1));
    let mut outer = |v: i32| {
        let mut inner = || seen.push(v);
        inner();
    };
    outer(3);
    println(`seen=${seen:?} log=${log.items:?}`);
}

__DATA__
{"stdout": "seen=[1, 3] log=[2]\n"}
