// A receiver that keeps none of a blanket's bounds does not reach it, whatever
// the parameter only the trait reference names would settle to.

trait Source<A> with () { fn first(&self) -> A; }
trait Tag<A> with () { fn tag(&self) -> A; }
impl<A, T: Source<A>> Tag<A> for T {
    fn tag(&self) -> A { return self.first(); }
}
struct Two { n: i32 }
export fn run() {
    let two = Two { n: 7 };
    let _: i32 = two.tag();
}

