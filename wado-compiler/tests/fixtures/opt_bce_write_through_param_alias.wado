// Two `&mut` parameters may name one list. A write through `b` shrinks `a`, so
// the second `a[i]` must check again and panic.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn h(a: &mut List<i32>, b: &mut List<i32>, i: i32) with Stdout {
    let x = a[i];
    b.pop();
    b.pop();
    let y = a[i];
    println(`${x} ${y}`);
}

export fn run() with Stdout {
    let mut arr: List<i32> = List::with_capacity(16);
    arr.push(1);
    arr.push(2);
    arr.push(3);
    let p = &mut arr;
    h(p, p, builtin::black_box(2));
}

__DATA__
{"stderr_contains": ["index out of bounds"], "trapped": true}
