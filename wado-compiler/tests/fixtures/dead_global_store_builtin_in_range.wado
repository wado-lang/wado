// A store to a dead global whose value calls a builtin, every `#[trap]` check
// holding at the call, goes whole: the call can neither trap nor write anything
// another reader sees. `BYTES` calls the builtin directly. `SEEN` reaches it
// through the list literal, whose construction inlining brings into `run`.
use { println, Stdout } from "core:cli";

global mut SEEN: List<u8> = [];
global mut BYTES: Array<u8> = builtin::array_new::<u8>(0);

export fn run() with Stdout {
    SEEN = [];
    BYTES = builtin::array_new::<u8>(4);
    println("ok");
}

__DATA__
{
    "stdout": "ok\n",
    "wir_not_expect:O2": [
        "array_new<u8>(4)"
    ]
}
