// An anonymous struct's type is the shape its fields make, so a field whose
// type is still an open variable names no shape. The variable once reached
// codegen.
fn none<T>() -> Option<T> {
    return null;
}

fn id<T>(x: T) -> T {
    return x;
}

export fn run() {
    let s = { a: none(), b: 1 };
    let _o: Option<i32> = s.a;
    let ok = id({ a: 1, b: id(2) });
    assert ok.a + ok.b == 3;
}

