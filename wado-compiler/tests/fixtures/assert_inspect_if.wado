// Test: Assert output when condition involves if expression
// If expressions in binary conditions: only surrounding identifiers are extracted

export fn run() with Stdout {
    let x = 3;
    let limit = 10;
    assert if x > 0 { x * 2 } else { 0 } > limit;
}

__DATA__
{
    "trapped": true,
    "stderr_contains": ["condition: if x > 0 { x * 2;", "limit: 10"]
}
