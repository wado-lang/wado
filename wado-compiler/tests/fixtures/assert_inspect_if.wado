// Test: Assert output when condition involves if expression.
// The `condition:` line quotes the source; an `if` operand is not itself a
// capture slot, so only the surrounding identifiers are extracted.

export fn run() with Stdout {
    let x = 3;
    let limit = 10;
    assert if x > 0 { x * 2 } else { 0 } > limit;
}

__DATA__
{
    "trapped": true,
    "stderr_contains": ["condition: if x > 0 { x * 2 } else { 0 } > limit", "limit: 10"]
}
