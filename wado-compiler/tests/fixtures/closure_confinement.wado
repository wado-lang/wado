// A closure in a callee reaches the frame only through its captures, so the
// callee's other by-value parameters still answer confinement for themselves.

fn stash(out: &mut List<List<i32>>, xs: List<i32>, tag: i32) -> i32 {
    let bump = || tag + 1;
    out.push(xs);
    return bump();
}

fn total(xs: List<i32>, tag: i32) -> i32 {
    let bump = || tag + 1;
    return xs.len() + bump();
}

fn keep_capture(out: &mut List<List<i32>>, xs: List<i32>) -> i32 {
    let count = || xs.len();
    out.push(xs);
    return count();
}

test "a parameter the callee stores is copied at the call" {
    let mut kept: List<List<i32>> = [];
    let mut src: List<i32> = [1];
    let n = stash(&mut kept, src, 5);
    src.push(3);
    assert n == 6;
    assert kept[0].len() == 1;
    assert src.len() == 2;
}

test "a parameter the callee only reads leaves the caller's value alone" {
    let mut src: List<i32> = [1];
    let n = total(src, 5);
    src.push(3);
    assert n == 7;
    assert src.len() == 2;
}

test "a parameter both captured and stored is copied at the call" {
    let mut kept: List<List<i32>> = [];
    let mut src: List<i32> = [1];
    let n = keep_capture(&mut kept, src);
    src.push(3);
    assert n == 1;
    assert kept[0].len() == 1;
    assert src.len() == 2;
}
