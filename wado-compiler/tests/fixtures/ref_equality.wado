// `==` on references compares what they point to, as in Rust; `ref_eq`
// compares identity.
struct Point {
    x: i32,
    y: i32,
}

test "references to equal values are equal" {
    let p1 = Point { x: 1, y: 2 };
    let p2 = Point { x: 1, y: 2 };
    let r1 = &p1;
    let r2 = &p2;
    assert r1 == r2;
    assert !ref_eq(r1, r2);
}

test "references to different values are not equal" {
    let p1 = Point { x: 1, y: 2 };
    let p2 = Point { x: 1, y: 3 };
    assert &p1 != &p2;
}

test "same reference is identical" {
    let p = Point { x: 1, y: 2 };
    let r1 = &p;
    let r2 = &p;
    assert r1 == r2;
    assert ref_eq(r1, r2);
}

test "mut ref equality" {
    let mut p = Point { x: 1, y: 2 };
    let q = Point { x: 1, y: 2 };
    let r1 = &mut p;
    let r2 = &mut p;
    assert r1 == r2;
    assert ref_eq(r1, r2);
    assert r1 == &q;
    assert !ref_eq(r1, &q);
}

test "a `&mut` operand compares with a `&` one either way round" {
    let mut p = Point { x: 1, y: 2 };
    let mut q = Point { x: 1, y: 2 };
    let r = Point { x: 0, y: 2 };
    assert &p == &mut q;
    assert &mut p == &q;
    assert &mut p == &mut q;
    assert &r != &mut q;
    assert &mut q != &r;
    let mut i = 3;
    let j = 3;
    assert &j == &mut i;
    assert &mut i == &j;
}

test "primitive ref equality" {
    let x = 42;
    let y = 42;
    let z = 7;
    let r1 = &x;
    let r2 = &y;
    assert r1 == r2;
    assert r1 != &z;
    assert ref_eq(r1, &x);
    assert !ref_eq(r1, r2);
}

test "reference to reference" {
    let a: String = "a";
    let b: String = "a";
    let ra = &a;
    let rb = &b;
    assert &ra == &rb;
}

fn same<T: Eq>(a: T, b: T) -> bool {
    return a == b;
}

test "a generic body compares references by value" {
    let p1 = Point { x: 1, y: 2 };
    let p2 = Point { x: 1, y: 2 };
    assert same(&p1, &p2);
    assert !same(&p1, &Point { x: 0, y: 2 });
}
