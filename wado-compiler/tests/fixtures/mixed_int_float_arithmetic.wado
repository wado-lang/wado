// Test mixed integer/float arithmetic with cast
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let width = 100;
    let x_max = 1.0;
    let x_min = -2.5;

    // Division with cast
    let dx = (x_max - x_min) / width as f64;
    println(`dx: {dx}`);
}

__DATA__
{"stdout": "dx: 0.035\n"}
