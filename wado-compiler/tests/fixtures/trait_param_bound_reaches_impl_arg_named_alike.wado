// A trait parameter's bound is not implied onto the impl argument that fills
// it, whatever the impl's own parameters are called. `Pair`'s `T` is spelled
// like the trait's, `Quad`'s `V` is not; both headers owe `U: Tag` alike.

trait Tag with () {
    fn tag(&self) -> i32;
}

trait Tr<T: Tag> {
    fn go(&self) -> i32;
}

struct Pair<T, U> {
    a: T,
    u: U,
}

impl<T, U> Tr<U> for Pair<T, U> {
    fn go(&self) -> i32 {
        return 1;
    }
}

struct Quad<V, U> {
    a: V,
    u: U,
}

impl<V, U> Tr<U> for Quad<V, U> {
    fn go(&self) -> i32 {
        return 2;
    }
}

export fn run() {}

__DATA__
{"compile_error": ":18:12: analysis error: type 'U' does not implement trait 'Tag' required by bound on 'T'"}
