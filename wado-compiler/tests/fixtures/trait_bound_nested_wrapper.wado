// Test: nested bounded struct — Wrapper<Wrapper<T>> with trait bounds
use { println, Stdout } from "core:cli";

trait Describable {
    fn describe(&self) -> String;
}

struct Wrapper<T: Describable> {
    inner: T,
}

impl Describable for i32 {
    fn describe(&self) -> String {
        return `{*self}`;
    }
}

// Wrapper<T: Describable> itself implements Describable
impl<T: Describable> Describable for Wrapper<T> {
    fn describe(&self) -> String {
        return `Wrapper({self.inner.describe()})`;
    }
}

export fn run() with Stdout {
    // Wrapper<i32> is valid because i32: Describable
    let w1 = Wrapper { inner: 42 };
    // Wrapper<Wrapper<i32>> is valid because Wrapper<i32>: Describable
    let w2 = Wrapper { inner: w1 };
    println(w2.inner.describe());
}

__DATA__
{"stdout": "Wrapper(42)\n"}
