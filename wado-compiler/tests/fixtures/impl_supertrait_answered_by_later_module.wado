// An impl's supertrait is checked once every module's impls are recorded.
//
// `Ord for Outer` needs `Outer: Eq`, derived through `Inner<i32>: Eq`, which a
// function field keeps from deriving. The impl answering it lives in a module
// whose path sorts after the declaring one's, so its declaration pass runs
// later; checked in the declaring module's own pass, the supertrait asked about
// an impl not yet recorded.

use { println, Stdout } from "core:cli";
use { outer } from "./sub/impl_supertrait_later_module_outer.wado";
use { same } from "./sub/impl_supertrait_later_module_z_eq.wado";

export fn run() with Stdout {
    println(`${outer(1) < outer(2)} ${outer(3) == outer(3)} ${same(1, 2)}`);
}

__DATA__
{
    "stdout": "true true false\n"
}
