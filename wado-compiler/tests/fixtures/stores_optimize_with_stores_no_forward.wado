// Optimization soundness: a mutation through a stored (aliased) reference
// must block field store→load forwarding. `hold_ref` stores `&p`, so writing
// `h.pair.a` mutates `p` itself. Forwarding the struct-literal `p.a = 42` past
// that write would be a miscompile — the read must observe the new value.
// Once `hold_ref` is inlined the write reads `(&mut p).a = 7`, which is
// `p.a = 7`, so the assert folds on the value written.

use { println, Stdout } from "core:cli";

struct Pair {
    a: i32,
    b: i32,
}

struct Holder {
    pair: &mut Pair,
}

// This function STORES the reference — caller's local becomes aliased.
fn hold_ref(p: &mut Pair) -> Holder {
    return Holder { pair: p };
}

export fn run() with Stdout {
    let mut p = Pair { a: 42, b: 99 };
    let h = hold_ref(&mut p);
    // Mutate `p` through the stored reference: `p.a` is now 7, not 42.
    h.pair.a = 7;
    // Forwarding the stale 42 here would be unsound.
    assert p.a == 7;
    println(`${p.a}`);
}

__DATA__
{
    "stdout": "7\n",
    "wir_not_expect:O2": [
        "core:rt/panic"
    ]
}
