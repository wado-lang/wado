// Swap two values using mutable references

use { println, Stdout } from "core:cli";

fn swap(a: &mut i32, b: &mut i32) {
    let tmp = *a;
    *a = *b;
    *b = tmp;
}

export fn run() with Stdout {
    let mut x = 1;
    let mut y = 2;
    println(`before: {x}, {y}`);

    swap(&mut x, &mut y);
    println(`after: {x}, {y}`);
}

__DATA__
{"stdout": "before: 1, 2\nafter: 2, 1\n"}
