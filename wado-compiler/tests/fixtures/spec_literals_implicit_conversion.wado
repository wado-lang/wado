// Only a literal converts implicitly, and a variable is never widened.

use { Value } from "core:value";

test {
    let a = 1;
    let b = "x";
    let x: i32 = 1;
    let v: List<Value> = [a, b];     // Error: write [Value::from(a), Value::from(b)]
    let w: List<i64> = [x];          // Error: no implicit widening of `x: i32`
}

