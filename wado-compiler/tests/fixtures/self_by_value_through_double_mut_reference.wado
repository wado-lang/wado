// A `&mut` to a `&mut` to an iterator is not itself asked for the adapter: the
// call would read the inner reference out of the outer one. A written `*`
// names the reference that iterates.

fn two(rr: &mut &mut RangeExclusive<i32>) -> List<i32> {
    return rr.take(2).collect();
}

export fn run() {
    let mut r = 0..<6;
    let mut m = &mut r;
    assert two(&mut m) == [0, 1];
}

