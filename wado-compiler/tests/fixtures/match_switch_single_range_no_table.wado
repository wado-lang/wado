// A single wide range arm stays a comparison cascade, not a `br_table`.

use { println, Stdout } from "core:cli";

fn in_block(n: i32) -> bool {
    return match n {
        0..=1000 => true,
        _ => false,
    };
}

export fn run() with Stdout {
    println(`{in_block(500)}`);
    println(`{in_block(2000)}`);
}

__DATA__
{
    "stdout": "true\nfalse\n",
    "wir_not_expect:O2": ["br_table"]
}
