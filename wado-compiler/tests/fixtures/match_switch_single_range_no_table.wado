// A single wide range arm must NOT become a `br_table`: one range test is two
// comparisons, far cheaper than a multi-hundred-entry jump table. The switch
// rewrite requires at least two switchable arms, so this stays a cascade while
// a multi-arm dense range class (see match_char_range_switch) still converts.

use { println, Stdout } from "core:cli";

fn in_block(n: i32) -> bool {
    return match n {
        0..=1000 => true,
        _ => false,
    };
}

export fn run() with Stdout {
    println(`{in_block(500)}`);
    println(`{in_block(2000)}`);
}

__DATA__
{
    "stdout": "true\nfalse\n",
    "wir_not_expect:O2": ["br_table"]
}
