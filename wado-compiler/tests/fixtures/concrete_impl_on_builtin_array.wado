// A concrete impl on the builtin `Array` head names its methods per
// instantiation, as one on `List` does, and a nested `Array` argument matches.

trait Lead with () {
    fn lead(&self) -> i32;
}

impl Lead for Array<i32> {
    fn lead(&self) -> i32 {
        return self.len();
    }
}

impl Lead for Array<String> {
    fn lead(&self) -> i32 {
        return 100 + self.len();
    }
}

impl Lead for List<Array<i32>> {
    fn lead(&self) -> i32 {
        return 10 * self.len();
    }
}

fn lead_of<T: Lead>(t: &T) -> i32 {
    return t.lead();
}

test "a bound holds for each instantiation" {
    let ints: List<i32> = [7];
    let strs: List<String> = ["a", "b"];
    assert lead_of(&ints.to_array()) == 1;
    assert lead_of(&strs.to_array()) == 102;
}

test "a method call reaches each instantiation" {
    let ints: List<i32> = [7];
    let strs: List<String> = ["a", "b"];
    assert ints.to_array().lead() == 1;
    assert strs.to_array().lead() == 102;
}

test "an Array argument of another head matches" {
    let ints: List<i32> = [7];
    let nested: List<Array<i32>> = [ints.to_array(), ints.to_array()];
    assert lead_of(&nested) == 20;
    assert nested.lead() == 20;
}

__DATA__
{"test": {}}
