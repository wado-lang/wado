// `push` inlines away and leaves `grow` on a cold path the frame never
// reaches, so the list folds into a constant array and nothing is left to
// blame. Naming `grow` would send the reader after the wrong thing.

use { println, Stdout } from "core:cli";

fn table() -> List<i32> {
    let mut out: List<i32> = List::<i32>::with_capacity(8);
    let mut i = 0;
    while i < 4 {
        out.push(i * 2);
        i += 1;
    }
    return out;
}

export fn run() with Stdout {
    println(`n=${table():?}`);
}

__DATA__
{
    "stdout": "n=[0, 2, 4, 6]\n",
    "wir_pass": {"O2": ["nir/const_fold"]},
    "wir_expect:O2": ["ref Array<i32> = array.new_fixed<i32>(0, 2, 4, 6);"],
    "remarks": {
        "O2": [
            {"contains": ["computes a constant at run time", "grow"], "count": 0}
        ]
    }
}
