use { Node, NodeKind, LeafData, BranchData, depth } from "./sub/recursive_variant_helper.wado";

test "recursive variant across modules" {
    let leaf = Node { name: "leaf", kind: NodeKind::Leaf(LeafData { value: 42 }) };
    let branch = Node {
        name: "branch",
        kind: NodeKind::Branch(BranchData { child: leaf }),
    };
    assert depth(&branch) == 2;
}

