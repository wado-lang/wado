// A `let` nested inside a globalized constant's initializer must stay inside
// it. Hoisting it out alongside the initializer's real siblings reordered it
// above the binding it reads, so the slice captured a null `repr` and `len()`
// trapped — at `-O2` only, where the pass runs on this shape.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let s = "hello";
    let b = s.as_bytes();
    println(`${b.len()}`);

    // The same shape with the slice read by element, not just by length.
    let t = "wado";
    let u = t.as_bytes();
    println(`${u.get_unchecked(0)}`);
}

__DATA__
{"stdout": "5\n119\n"}
