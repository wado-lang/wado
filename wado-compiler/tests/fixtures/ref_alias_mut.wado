// Multiple mutable references aliasing the same variable (no borrow checker)
// Both references can be used to modify the same underlying value

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut x = 0;
    let r1 = &mut x;
    let r2 = &mut x;

    *r1 = 10;
    println(`after r1: {x}`);

    *r2 = 20;
    println(`after r2: {x}`);

    // Both still point to x
    *r1 = *r1 + *r2 + 5;
    println(`final: {x}`);
}

__DATA__
{"stdout": "after r1: 10\nafter r2: 20\nfinal: 45\n"}
