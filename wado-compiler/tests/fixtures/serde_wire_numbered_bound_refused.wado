// A type whose fields carry no number is refused where the call is written,
// rather than when a format keyed by numbers runs out of things to write.
use { WireNumbered } from "core:serde";

struct Plain {
    x: i32,
}

fn numbered_only<T: WireNumbered>(_value: &T) -> i32 {
    return 1;
}

export fn run() {
    let _ = numbered_only(&Plain { x: 1 });
}

__DATA__
{"compile_error": "type 'Plain' does not implement trait 'WireNumbered' required by bound on 'T'"}
