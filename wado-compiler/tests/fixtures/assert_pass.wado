use { println } from "core:cli";

export fn run() with Stdout {
    let x = 5;
    let y = 3;

    // These should pass
    assert x > 0;
    assert x + y == 8;
    assert x != y, "x and y must be different";

    println("All assertions passed!");
}

__DATA__
{"stdout": "All assertions passed!\n"}
