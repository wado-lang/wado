use { println, Stdout } from "core:cli";

// from static_method_generic_non_constructor.wado
struct Counter<T> {
    value: T,
}

impl<T> Counter<T> {
    pub fn new(value: T) -> Counter<T> {
        // Constructor

        return Counter { value };
    }

    pub fn zero() -> i32 {
        // Static method returning different type (not a constructor)

        return 0;
    }

    pub fn default_value(v: T) -> T {
        // Static method returning the type parameter

        return v;
    }

    pub fn get(&self) -> T {
        // Getter

        return self.value;
    }
}

// from static_method_multi_type_params.wado
struct Pair<T, U> {
    first: T,
    second: U,
}

impl<T, U> Pair<T, U> {
    pub fn create(first: T, second: U) -> Pair<T, U> {
        return Pair { first, second };
    }

    pub fn get_first(&self) -> T {
        return self.first;
    }

    pub fn get_second(&self) -> U {
        return self.second;
    }
}

// from static_method_generic_non_constructor.wado
fn static_method_generic_non_constructor() with Stdout {
    // Call static method that returns i32
    let z = Counter::<i32>::zero();
    println(`zero: {z}`);

    // Call static method that returns T (i32 in this case)
    let d = Counter::<i32>::default_value(100);
    println(`default: {d}`);

    // Normal constructor usage
    let c = Counter::<i32>::new(42);
    println(`counter value: {c.get()}`);
}

// from static_method_multi_type_params.wado
fn static_method_multi_type_params() with Stdout {
    // Create Pair<i32, i64> using static method
    let p = Pair::<i32, i64>::create(10, 20 as i64);
    println(`first: {p.get_first()}`);
    println(`second: {p.get_second()}`);
}

export fn run() with Stdout {
    static_method_generic_non_constructor();
    static_method_multi_type_params();
}

__DATA__
{"stdout": "zero: 0\ndefault: 100\ncounter value: 42\nfirst: 10\nsecond: 20\n"}
