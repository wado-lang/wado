// The canonical's core type is the canonical's to give. A future's cancel
// answers with the `u32` its copy ended on, and `Future::cancel_read(&self)`
// states no result, so the call drops it; a core import typed from the call
// site would ask for `(param i32)` where the component provides
// `(param i32) (result i32)`, and the module would fail to validate.
//
// Cancelling with no read in progress traps, which is what reaching the trap
// pins: the module validated and ran.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let [rx, tx] = Future::<u8>::new();
    println(`built`);
    rx.cancel_read();
    rx.drop();
    tx.write(1);
}

__DATA__
{"stdout": "built\n", "trapped": true}
