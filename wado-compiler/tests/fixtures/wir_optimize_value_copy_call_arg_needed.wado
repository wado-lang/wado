// Negative test: value_copy MUST be preserved when the copy is passed
// to a function that could mutate it.
//
// Pattern:
//   copy = value_copy List<i32>(original)
//   mutate(copy)      // function call — may mutate via &mut self
//
// Without value_copy, the mutation would affect the original.

use { println, Stdout } from "core:cli";

fn append_zero(mut arr: List<i32>) -> i32 {
    arr.push(0);
    return arr.len();
}

export fn run() with Stdout {
    let a: List<i32> = [1, 2, 3];
    let new_len = append_zero(a);
    println(`${a.len()}`);
    println(`${new_len}`);
}

__DATA__
{
    "stdout": "3\n4\n",
    "wir_scope": "/run",
    "wir_contrast": {"O0": [
        {"    println(`${a.len()}`);\n": ""}
    ]},
    "wir_expect:O0": ["append_zero\"(\"wir_optimize_value_copy_call_arg_needed.wado/$value_copy$core:prelude/list.wado/List<i32>\"(a));"]
}
