// A bound whose subject has several impls of the bound's trait settles
// nothing by itself.

trait Source<A> with () { fn first(&self) -> A; }

struct Two { n: i32 }
impl Source<i32> for Two { fn first(&self) -> i32 { return self.n; } }
impl Source<String> for Two { fn first(&self) -> String { return `${self.n}`; } }

fn first_of<A, T: Source<A>>(t: &T) -> A {
    return t.first();
}

export fn run() {
    let two = Two { n: 7 };
    let _ = first_of(&two);
}

