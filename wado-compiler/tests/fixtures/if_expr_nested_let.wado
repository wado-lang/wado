// Test: nested if expression with let statements
use { println, Stdout } from "core:cli";

variant Mode {
    A,
    B,
}

fn compute(mode: Mode, x: i32) -> i32 {
    let n = if mode matches { A } {
        let a = x * 2;
        a;
    } else {
        x + 1;
    };
    return n;
}

fn run() with Stdout {
    println(`{compute(Mode::A, 5)}`);
    println(`{compute(Mode::B, 5)}`);
}

__DATA__
{"stdout": "10\n6\n"}
