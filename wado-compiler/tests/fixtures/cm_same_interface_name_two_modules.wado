// Two modules each declare an `interface Dom` with an `f`, bound to different
// CM functions. A call finds its binding by `Dom::f`, so the second binding
// took over the first one's call sites and compilation crashed.

use { Dom as ADom } from "./sub/cm_same_interface_name_two_modules_a.wado";
use { Dom as BDom } from "./sub/cm_same_interface_name_two_modules_b.wado";

export fn run() with (ADom, BDom) {
    let _ = ADom::f();
    let _ = BDom::f();
}

__DATA__
{
  "compile_error": "`Dom::f` binds `web:b/global#f`, but another `Dom::f` already binds `web:a/global#f`: rename one of the interfaces",
  "compile_error_codes": ["DUPLICATE_DEFINITION"]
}
