// Two interfaces named `Dom` each bind their own `f`: a call finds its binding
// by the declaration it names, not by `Dom::f`.

use { Dom as ADom } from "./sub/cm_same_interface_name_two_modules_a.wado";
use { Dom as BDom } from "./sub/cm_same_interface_name_two_modules_b.wado";

export fn run() with (ADom, BDom) {
    let _ = ADom::f();
    let _ = BDom::f();
}

