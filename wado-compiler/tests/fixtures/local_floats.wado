use { println, Stdout } from "core:cli";


// from local_floats.wado
fn local_floats() with Stdout {
    let a = 1.5;
    let b = 2.5;
    let sum = a + b;

    // Test: sum should be 4.0
    if sum == 4.0 {
        println("floats work");
    }
}

// from local_floats_mut.wado
fn local_floats_mut() with Stdout {
    let mut x = 1.0;

    if x == 1.0 {
        println("x is 1.0");
    }

    x = 2.5;

    if x == 2.5 {
        println("x is 2.5");
    }

    x = x + 0.5;

    if x == 3.0 {
        println("x is 3.0");
    }
}

export fn run() with Stdout {
    local_floats();
    local_floats_mut();
}

__DATA__
{"stdout": "floats work\nx is 1.0\nx is 2.5\nx is 3.0\n"}
