// Test: Index and IndexMut traits with associated types
use { println, Stdout } from "core:cli";

struct MyContainer {
    data: i32,
}

// Implement Index trait
impl<i32> Index<i32> for MyContainer {
    type Output = i32;

    fn index(&self, _index: i32) -> &Self::Output {
        return &self.data;
    }
}

export fn run() with Stdout {
    let container = MyContainer { data: 42 };
    // Call the index method explicitly (not via [] syntax yet)
    let val_ref = container.index(0);
    let val = *val_ref;
    println(`Value: {val}`);
}

__DATA__
{"stdout": "Value: 42\n"}
