//! A concrete block hosts its own function; a generic one's instance is
//! materialised in the receiver's module. The call named the receiver's for
//! both, so where the type comes from another module the call minted an extern
//! stub beside a definition of that very name and lowering panicked.

use { Cell } from "./sub/static_concrete_impl_imported_type.wado";

trait Wrap<T> {
    fn wrap(v: T) -> i32;
}

impl Wrap<i32> for Cell<i32> {
    fn wrap(v: i32) -> i32 {
        return v + 1;
    }
}

test "a concrete impl on an imported generic type is called in its own module" {
    assert Cell::<i32>::wrap(7) == 8;
}

__DATA__
{"test": {}}
