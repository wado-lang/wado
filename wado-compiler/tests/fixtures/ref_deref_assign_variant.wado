// References and Option types
// Requires: deref assignment (*ref = value) for variant types

use { println, Stdout } from "core:cli";

fn maybe_read(r: &Option<i32>) -> String {
    if let Some(v) = *r {
        return `some({v})`;
    }
    return "none";
}

export fn run() with Stdout {
    let a: Option<i32> = Option::<i32>::Some(42);
    let b: Option<i32> = null;

    println(maybe_read(&a));
    println(maybe_read(&b));

    // Mutable reference to Option: change Some to None
    let mut c: Option<i32> = Option::<i32>::Some(10);
    println(maybe_read(&c));

    let cr = &mut c;
    *cr = null;
    println(maybe_read(&c));
}

__DATA__
{"stdout": "some(42)\nnone\nsome(10)\nnone\n"}
