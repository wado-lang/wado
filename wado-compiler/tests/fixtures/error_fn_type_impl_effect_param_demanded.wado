// A method of a function-type impl generic over the row demands what the
// receiver's row holds, as calling the receiver would.
use { println, Stdout } from "core:cli";

trait Call with _ {
    fn call(&self);
}

impl<effect E> Call for fn() with E {
    fn call(&self) with E {
        let f = *self;
        f();
    }
}

fn quiet() {
    let g = || { println("x"); };
    g.call();
}

export fn run() with Stdout {
    quiet();
}

