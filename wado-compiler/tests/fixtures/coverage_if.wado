// `wado test --coverage` counts both sides of an `if`, the omitted `else`
// among them, and the lines under each.
fn sign(x: i32) -> i32 {
    if x > 0 {
        return 1;
    } else if x < 0 {
        return -1;
    }
    return 0;
}

fn clamp(x: i32) -> i32 {
    let mut y = x;
    if y > 10 {
        y = 10;
    }
    return y;
}

fn never() -> i32 {
    return 7;
}

test "positive and zero" {
    assert sign(3) == 1;
    assert sign(0) == 0;
    assert clamp(4) == 4;
}

__DATA__
{
  "test": {},
  "coverage": {
    "uncovered_lines": [7, 15, 21],
    "uncovered_branches": ["6:12 then", "14:5 then"],
    "uncovered_functions": ["never"]
  }
}
