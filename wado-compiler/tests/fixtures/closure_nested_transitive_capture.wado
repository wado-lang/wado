#![allow(shadowed_name)]

// A closure nested in a closure reaches a binding of any enclosing frame: each
// frame captures what the one inside it asked for, so the value is handed
// inward one environment at a time.

fn apply(f: fn() -> i32) -> i32 {
    return f();
}

fn apply1(f: fn(i32) -> i32, v: i32) -> i32 {
    return f(v);
}

fn apply_mut(mut f: fn mut()) {
    f();
}

fn transitive() -> i32 {
    let x = 42;
    return apply(|| {
        return apply(|| x);
    });
}

fn three_levels() -> i32 {
    let x = 40;
    return apply(|| {
        let y = 2;
        return apply(|| {
            return apply(|| x + y);
        });
    });
}

test "an inner closure reaches the enclosing function's local" {
    assert transitive() == 42;
}

test "an inner closure reaches the outer closure's own local" {
    let n = apply(|| {
        let y = 41;
        return apply(|| y + 1);
    });
    assert n == 42;
}

test "an inner closure reaches the outer closure's parameter" {
    let n = apply1(|p| apply(|| p + 1), 41);
    assert n == 42;
}

test "capture crosses three closure frames" {
    assert three_levels() == 42;
}

test "an inner closure writes the enclosing function's local" {
    let mut count = 0;
    apply_mut(|| {
        apply_mut(|| count += 1);
        count += 10;
    });
    assert count == 11;
}

test "a nested write alone boxes the binding" {
    let mut count = 0;
    apply_mut(|| {
        apply_mut(|| count += 1);
    });
    assert count == 1;
}

test "a let-bound nested closure writes the same binding" {
    let mut count = 0;
    let mut outer = || {
        let mut inner = || count += 1;
        inner();
        inner();
    };
    outer();
    assert count == 2;
}

test "a shadowing parameter is not the outer binding" {
    let mut count = 7;
    let bump = |mut count: i32| {
        count += 1;
        return count;
    };
    assert bump(1) == 2;
    assert count == 7;
}

test "a shadowing let is not the outer binding" {
    let mut count = 7;
    let n = apply(|| {
        let mut count = 0;
        count += 1;
        return count;
    });
    assert n == 1;
    assert count == 7;
}

test "the enclosing closure's own captures keep their slots" {
    let a = 1;
    let b = 20;
    let n = apply(|| {
        let inner = apply(|| a);
        return inner + b;
    });
    assert n == 21;
}

test "a slot mix-up would not even typecheck" {
    let word: String = "ab";
    let n = 40;
    let total = apply(|| {
        let len = apply(|| word.len());
        return len + n;
    });
    assert total == 42;
}

test "a nested write crosses three frames" {
    let mut count = 0;
    apply_mut(|| {
        apply_mut(|| {
            apply_mut(|| count += 1);
        });
    });
    assert count == 1;
}

test "two nested closures write one binding" {
    let mut count = 0;
    apply_mut(|| {
        apply_mut(|| count += 1);
        apply_mut(|| count += 10);
    });
    assert count == 11;
}

test "a nested closure only reading a mut binding stays fn" {
    let mut count = 5;
    let read = apply(|| apply(|| count));
    count += 1;
    assert read == 5;
    assert count == 6;
}

test "a shadowing local is not the boxed outer one" {
    let mut a = 0;
    apply_mut(|| {
        apply_mut(|| a += 1);
        let a = 5;
        assert apply(|| a) == 5;
    });
    assert a == 1;
}

test "an if-let binding does not reach the else branch" {
    let mut n = 0;
    let absent: Option<i32> = null;
    apply_mut(|| {
        if let Some(n) = absent {
            let _ = n;
        } else {
            n = 7;
        }
    });
    assert n == 7;
}

test "an if-let binding does not outlive the expression" {
    let mut n = 0;
    let one: Option<i32> = Some(1);
    apply_mut(|| {
        let v = if let Some(n) = one { n } else { 0 };
        n = v;
    });
    assert n == 1;
}

test "a shadowing binder's scope ends with its block" {
    let mut count = 0;
    let mut bump = || {
        inner: {
            let count = 99;
            let _ = count;
        }
        count += 1;
    };
    bump();
    assert count == 1;
}
