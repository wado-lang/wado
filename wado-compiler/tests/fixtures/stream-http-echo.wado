// Test: HTTP echo handler using Stream::read() and StreamWritable::write()
// Reads the full request body and echoes it back as the response body.
use { Request, Response, ErrorCode, Fields, Trailers } from "wasi:http";

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    // Consume request body
    let [res_future, _res_tx] = Future::<Result<(), ErrorCode>>::new();
    let [body_stream, _trailers] = Request::consume_body(request, res_future);

    // Read entire request body into chunks
    let mut chunks: Array<Array<u8>> = [];
    loop {
        let chunk = body_stream.read(4096);
        if chunk.len() == 0 {
            break;
        }
        chunks.push(chunk);
    }
    body_stream.drop();

    // Build response echoing the body
    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [resp_rx, resp_tx] = Stream::<u8>::new();

    let headers = Fields::new();
    let [response, _tx_future] = Response::new(headers, Option::<Stream<u8>>::Some(resp_rx), trailers_future);

    task return Result::<Response, ErrorCode>::Ok(response);

    // Write all chunks to response body
    for let chunk of chunks {
        resp_tx.write(chunk);
    }
    resp_tx.drop();

    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

__DATA__
{
    "wasi:http/service": {
        "request": {
            "method": "POST",
            "path": "/echo",
            "body": "echo me"
        },
        "status": 200,
        "body": "echo me"
    }
}
