/// Test that the freelist allocator stays bounded under churn that
/// mixes many size classes: priming every class then repeatedly
/// allocating and freeing the whole spread must return the heap to the
/// same frontier each cycle, exercising coalescing in both directions.
use { println } from "core:cli";

export fn run() with Stdout {
    let sizes: Array<i32> = [24, 200, 56, 512, 8, 96, 312, 40];

    // Prime every size class, then free it all so the bins hold a block
    // of each shape and the heap frontier reaches its steady state.
    let mut primed: Array<i32> = [];
    for let s of sizes {
        primed.push(builtin::realloc(0, 0, 8, s));
    }
    for let p of primed {
        builtin::realloc(p, 0, 8, 0);
    }

    // A sentinel allocation before and after the churn loop: if the
    // heap creeps, the second sentinel lands at a higher address.
    let before = builtin::realloc(0, 0, 8, 16);
    builtin::realloc(before, 16, 8, 0);

    for let mut i = 0; i < 1000; i += 1 {
        let mut live: Array<i32> = [];
        for let s of sizes {
            live.push(builtin::realloc(0, 0, 8, s));
        }
        // Free in reverse so coalescing merges in both directions.
        for let mut k = live.len() - 1; k >= 0; k -= 1 {
            builtin::realloc(live[k], 0, 8, 0);
        }
    }

    let after = builtin::realloc(0, 0, 8, 16);
    assert after == before, `heap crept under mixed churn: before={before}, after={after}`;
    builtin::realloc(after, 16, 8, 0);

    println("ok");
}

__DATA__
{"allocator": "freelist", "stdout": "ok\n"}
