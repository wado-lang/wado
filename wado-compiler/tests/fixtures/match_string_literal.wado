// Match on String literals should work like == comparison.

export fn run() {
    let text = "hello";
    let result = match text {
        "hello" => 1,
        "world" => 2,
        _ => 0,
    };
    assert result == 1;

    let text2 = "other";
    let result2 = match text2 {
        "hello" => 1,
        "world" => 2,
        _ => 0,
    };
    assert result2 == 0;
}

