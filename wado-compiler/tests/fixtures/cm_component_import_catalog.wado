use { CmCatalog, Color, Point, Shape, Perms, Mixed } from "./sub/cm-catalog.wasm" with { type: "wasm" };

test "primitives round-trip" {
    assert CmCatalog::id_bool(true) == true;
    assert CmCatalog::id_u8(200) == 200;
    assert CmCatalog::id_u16(40000) == 40000;
    assert CmCatalog::id_u32(42) == 42;
    assert CmCatalog::id_u64(9000000000) == 9000000000;
    assert CmCatalog::id_s8(-5) == -5;
    assert CmCatalog::id_s16(-300) == -300;
    assert CmCatalog::id_s32(-7) == -7;
    assert CmCatalog::id_s64(-9000000000) == -9000000000;
    assert CmCatalog::id_f32(1.5) == 1.5;
    assert CmCatalog::id_f64(3.5) == 3.5;
    assert CmCatalog::id_char('Z') == 'Z';
}

test "string round-trip" {
    assert CmCatalog::id_string("hello") == "hello";
    assert CmCatalog::id_string("") == "";
    assert CmCatalog::id_string("café — naïve") == "café — naïve";
    assert CmCatalog::id_string("日本語のテスト") == "日本語のテスト";
    assert CmCatalog::id_string("emoji 🎉🚀🦀 end") == "emoji 🎉🚀🦀 end";
}

test "enum round-trip" {
    assert CmCatalog::id_enum(Color::Green) == Color::Green;
}

test "newtype round-trip" {
    assert CmCatalog::id_newtype(2.5) == 2.5;
}

test "list round-trip" {
    let xs: List<u8> = [1, 2, 3];
    assert CmCatalog::id_list_u8(xs) == [1, 2, 3];
    let ss: List<String> = ["a", "bb"];
    assert CmCatalog::id_list_string(ss) == ["a", "bb"];
    let empty: List<u8> = [];
    assert CmCatalog::id_list_u8(empty) == [];
}

test "option round-trip" {
    let o5: Option<u32> = Option::Some(5);
    assert CmCatalog::id_option_u32(o5) == Option::Some(5);
    let on: Option<u32> = null;
    assert CmCatalog::id_option_u32(on) == null;
    let os: Option<String> = Option::Some("x");
    assert CmCatalog::id_option_string(os) == Option::Some("x");
    let osn: Option<String> = null;
    assert CmCatalog::id_option_string(osn) == null;
}

test "result round-trip" {
    let ok: Result<u32, String> = Result::Ok(9);
    assert CmCatalog::id_result_both(ok) == Result::Ok(9);
    let err: Result<u32, String> = Result::Err("nope");
    assert CmCatalog::id_result_both(err) == Result::Err("nope");
    let okf: Result<f32, u32> = Result::Ok(1.5);
    assert CmCatalog::id_result_fu(okf) == Result::Ok(1.5);
    let erru: Result<f32, u32> = Result::Err(42);
    assert CmCatalog::id_result_fu(erru) == Result::Err(42);
}

test "record round-trip" {
    let p = Point { x: 1.5, y: 2.5 };
    assert CmCatalog::id_record(p) == Point { x: 1.5, y: 2.5 };
}

test "variant round-trip" {
    assert CmCatalog::id_variant(Shape::Circle(2.0)) == Shape::Circle(2.0);
    assert CmCatalog::id_variant(Shape::Rect([3.0, 4.0])) == Shape::Rect([3.0, 4.0]);
    assert CmCatalog::id_variant(Shape::Nothing) == Shape::Nothing;
    assert CmCatalog::id_mixed(Mixed::AsInt(7)) == Mixed::AsInt(7);
    assert CmCatalog::id_mixed(Mixed::AsFloat(1.5)) == Mixed::AsFloat(1.5);
}

test "flags round-trip" {
    let p = Perms::Read | Perms::Write;
    assert CmCatalog::id_flags(p) == Perms::Read | Perms::Write;
}

test "tuple round-trip" {
    let pair: [u32, String] = [7, "x"];
    assert CmCatalog::id_tuple_pair(pair) == [7, "x"];
    let triple: [u8, bool, char] = [5, true, 'Z'];
    assert CmCatalog::id_tuple_triple(triple) == [5, true, 'Z'];
}

test "nested containers round-trip" {
    let lr: List<Point> = [Point { x: 1.0, y: 2.0 }];
    assert CmCatalog::id_list_record(lr) == [Point { x: 1.0, y: 2.0 }];
    let orr: Option<Point> = Option::Some(Point { x: 1.0, y: 2.0 });
    assert CmCatalog::id_option_record(orr) == Option::Some(Point { x: 1.0, y: 2.0 });
    let tr: [Point, u32] = [Point { x: 1.0, y: 2.0 }, 9];
    assert CmCatalog::id_tuple_record(tr) == [Point { x: 1.0, y: 2.0 }, 9];
    let ol: Option<List<u8>> = Option::Some([1, 2]);
    assert CmCatalog::id_option_list(ol) == Option::Some([1, 2]);
    let rl: Result<List<Point>, String> = Result::Ok([Point { x: 1.0, y: 2.0 }]);
    assert CmCatalog::id_result_list(rl) == Result::Ok([Point { x: 1.0, y: 2.0 }]);
    let lt: List<[u32, String]> = [[1, "a"]];
    assert CmCatalog::id_list_tuple(lt) == [[1, "a"]];
    let assoc: List<[String, u32]> = [["k", 1]];
    assert CmCatalog::id_assoc_array(assoc) == [["k", 1]];
    let lo: List<Option<u32>> = [Option::Some(1)];
    assert CmCatalog::id_list_option(lo) == [Option::Some(1)];
    let to: [Option<u32>, u8] = [Option::Some(3), 4];
    assert CmCatalog::id_tuple_option(to) == [Option::Some(3), 4];
    let ltr: List<[Point, u32]> = [[Point { x: 1.0, y: 2.0 }, 9]];
    assert CmCatalog::id_list_tuple_record(ltr) == [[Point { x: 1.0, y: 2.0 }, 9]];
}

__DATA__
{"test": {}}
