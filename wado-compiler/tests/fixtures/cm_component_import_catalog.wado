use { CmCatalog, Color, Point, Single, Shape, Perms, Mixed, Meters, Status } from "./sub/cm-catalog.wasm" with { type: "wasm" };
use { TreeMap } from "core:collections";

test "primitives round-trip" {
    assert CmCatalog::id_bool(true) == true;
    assert CmCatalog::id_u8(200) == 200;
    assert CmCatalog::id_u16(40000) == 40000;
    assert CmCatalog::id_u32(42) == 42;
    assert CmCatalog::id_u64(9000000000) == 9000000000;
    assert CmCatalog::id_s8(-5) == -5;
    assert CmCatalog::id_s16(-300) == -300;
    assert CmCatalog::id_s32(-7) == -7;
    assert CmCatalog::id_s64(-9000000000) == -9000000000;
    assert CmCatalog::id_f32(1.5) == 1.5;
    assert CmCatalog::id_f64(3.5) == 3.5;
    assert CmCatalog::id_char('Z') == 'Z';
}

test "string round-trip" {
    assert CmCatalog::id_string("hello") == "hello";
    assert CmCatalog::id_string("") == "";
    assert CmCatalog::id_string("café — naïve") == "café — naïve";
    assert CmCatalog::id_string("日本語のテスト") == "日本語のテスト";
    assert CmCatalog::id_string("emoji 🎉🚀🦀 end") == "emoji 🎉🚀🦀 end";
}

test "enum round-trip" {
    assert CmCatalog::id_enum(Color::Green) == Color::Green;
}

test "newtype round-trip" {
    // `Meters` is imported as a real newtype: `wado compile --lib` preserves
    // `type meters = f64` in the component's structural type, so `wit_consume`
    // reconstructs it here rather than seeing a bare `f64` (issue #1456).
    let m: Meters = 2.5 as Meters;
    assert CmCatalog::id_newtype(m) == m;
    assert CmCatalog::id_newtype(m) as f64 == 2.5;
}

test "list round-trip" {
    assert CmCatalog::id_list_u8([1, 2, 3]) == [1, 2, 3];
    assert CmCatalog::id_list_string(["a", "bb"]) == ["a", "bb"];
    assert CmCatalog::id_list_u8([]) == [];
}

test "option round-trip" {
    assert CmCatalog::id_option_u32(Option::Some(5)) == Option::Some(5);
    assert CmCatalog::id_option_u32(null) == null;
    assert CmCatalog::id_option_string(Option::Some("x")) == Option::Some("x");
    assert CmCatalog::id_option_string(null) == null;
}

test "result round-trip" {
    assert CmCatalog::id_result_both(Result::Ok(9)) == Result::Ok(9);
    assert CmCatalog::id_result_both(Result::Err("nope")) == Result::Err("nope");
    assert CmCatalog::id_result_fu(Result::Ok(1.5)) == Result::Ok(1.5);
    assert CmCatalog::id_result_fu(Result::Err(42)) == Result::Err(42);
}

test "record round-trip" {
    assert CmCatalog::id_record(Point { x: 1.5, y: 2.5 }) == Point { x: 1.5, y: 2.5 };
}

test "flat-result record round-trip" {
    // `Single` flattens to a single core value, so the component returns it
    // flat (not via an outptr); the import binding must reconstruct the struct.
    assert CmCatalog::id_record_flat(Single { value: 42 }) == Single { value: 42 };
    assert CmCatalog::id_record_flat(Single { value: 0 }) == Single { value: 0 };
}

test "variant round-trip" {
    assert CmCatalog::id_variant(Shape::Circle(2.0)) == Shape::Circle(2.0);
    assert CmCatalog::id_variant(Shape::Rect([3.0, 4.0])) == Shape::Rect([3.0, 4.0]);
    assert CmCatalog::id_variant(Shape::Nothing) == Shape::Nothing;
    assert CmCatalog::id_mixed(Mixed::AsInt(7)) == Mixed::AsInt(7);
    assert CmCatalog::id_mixed(Mixed::AsFloat(1.5)) == Mixed::AsFloat(1.5);
}

test "flags round-trip" {
    assert CmCatalog::id_flags(Perms::Read | Perms::Write) == Perms::Read | Perms::Write;
}

// A variant with no payload-bearing case lays out as its bare discriminant.
// Sizing it as a handle moves everything an aggregate places after it.
test "payload-less variant round-trip" {
    assert CmCatalog::id_payload_less_variant(Status::Inactive) == Status::Inactive;
    assert CmCatalog::id_option_payload_less_variant(Option::Some(Status::Inactive))
        == Option::Some(Status::Inactive);
    assert CmCatalog::id_list_payload_less_variant([Status::Active, Status::Inactive])
        == [Status::Active, Status::Inactive];
    assert CmCatalog::id_tuple_payload_less_variant([Status::Inactive, 200])
        == [Status::Inactive, 200];
}

test "tuple round-trip" {
    assert CmCatalog::id_tuple_pair([7, "x"]) == [7, "x"];
    assert CmCatalog::id_tuple_triple([5, true, 'Z']) == [5, true, 'Z'];
}

test "nested containers round-trip" {
    assert CmCatalog::id_list_record([Point { x: 1.0, y: 2.0 }]) == [Point { x: 1.0, y: 2.0 }];
    assert CmCatalog::id_option_record(Option::Some(Point { x: 1.0, y: 2.0 })) == Option::Some(Point { x: 1.0, y: 2.0 });
    assert CmCatalog::id_tuple_record([Point { x: 1.0, y: 2.0 }, 9]) == [Point { x: 1.0, y: 2.0 }, 9];
    assert CmCatalog::id_option_list(Option::Some([1, 2])) == Option::Some([1, 2]);
    assert CmCatalog::id_result_list(Result::Ok([Point { x: 1.0, y: 2.0 }])) == Result::Ok([Point { x: 1.0, y: 2.0 }]);
    assert CmCatalog::id_list_tuple([[1, "a"]]) == [[1, "a"]];
    assert CmCatalog::id_assoc_array([["k", 1]]) == [["k", 1]];
    assert CmCatalog::id_list_option([Option::Some(1)]) == [Option::Some(1)];
    assert CmCatalog::id_tuple_option([Option::Some(3), 4]) == [Option::Some(3), 4];
    assert CmCatalog::id_list_tuple_record([[Point { x: 1.0, y: 2.0 }, 9]]) == [[Point { x: 1.0, y: 2.0 }, 9]];
}

// Five flat params put every param in one buffer, each at the offset the
// tuple layout gives it. The `wir_expect` below is what pins the store widths.
test "narrow scalars in the indirect params buffer" {
    let packed = CmCatalog::narrow_scalars_in_params_buffer(
        Color::Green,
        Option::Some(7),
        Perms::Read | Perms::Execute,
        Status::Inactive,
    ).wait();
    assert packed == 2007052;
}

test "map round-trip" {
    let m = { a: 1, b: 2 } as TreeMap<String, u32>;
    let back = CmCatalog::id_map_string_u32(m);
    assert back.len() == 2;
    assert back["a"] == 1;
    assert back["b"] == 2;
    assert CmCatalog::id_map_string_u32(TreeMap::<String, u32>::new()).len() == 0;

    let nested = CmCatalog::id_option_map(Option::Some(m));
    assert nested.unwrap()["b"] == 2;
    assert CmCatalog::id_list_map([m])[0]["a"] == 1;
}

test "map in the indirect params buffer" {
    let m = { a: 1, b: 2 } as TreeMap<String, u32>;
    assert CmCatalog::map_in_params_buffer(m, Option::Some(7), 9).wait() == 30709;
}

test "async option within the flat params" {
    assert CmCatalog::option_passed_flat(Option::Some(4)).wait() == 5;
    assert CmCatalog::option_passed_flat(null).wait() == 1;
}

// A component operation is pure, so a global initializer may call one. The
// import binding must reach the initializer as it reaches a function body.
global CATALOG_ID: u32 = CmCatalog::id_u32(42);

test "component call in a global initializer" {
    assert CATALOG_ID == 42;
}

__DATA__
{
    "test": {},
    "wir_expect:O0": [
        "builtin::store_u8($params_buf, c)",
        "builtin::store_u8($params_buf + 3, p)",
        "builtin::store_u8($params_buf + 4, $variant_val.discriminant)",
        "builtin::store_i32($params_buf, $base)",
        "builtin::store_i32($params_buf + 4, $len)",
        "builtin::store_u8($params_buf + 10, tail)"
    ],
    "wir_not_expect:O0": [
        "builtin::store_i32($params_buf, c)",
        "builtin::store_i32($params_buf + 3, p)"
    ]
}
