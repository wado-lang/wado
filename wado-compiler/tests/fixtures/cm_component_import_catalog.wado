use { CmCatalog, Color, Point, Shape, Perms, Mixed } from "./sub/cm-catalog.wasm" with { type: "wasm" };

test "primitives round-trip" {
    assert CmCatalog::id_bool(true) == true;
    assert CmCatalog::id_u8(200) == 200;
    assert CmCatalog::id_u16(40000) == 40000;
    assert CmCatalog::id_u32(42) == 42;
    assert CmCatalog::id_u64(9000000000) == 9000000000;
    assert CmCatalog::id_s8(-5) == -5;
    assert CmCatalog::id_s16(-300) == -300;
    assert CmCatalog::id_s32(-7) == -7;
    assert CmCatalog::id_s64(-9000000000) == -9000000000;
    assert CmCatalog::id_f32(1.5) == 1.5;
    assert CmCatalog::id_f64(3.5) == 3.5;
    assert CmCatalog::id_char('Z') == 'Z';
}

test "string round-trip" {
    assert CmCatalog::id_string("hello") == "hello";
    assert CmCatalog::id_string("") == "";
    assert CmCatalog::id_string("café — naïve") == "café — naïve";
    assert CmCatalog::id_string("日本語のテスト") == "日本語のテスト";
    assert CmCatalog::id_string("emoji 🎉🚀🦀 end") == "emoji 🎉🚀🦀 end";
}

test "enum round-trip" {
    assert CmCatalog::id_enum(Color::Green) == Color::Green;
}

test "newtype round-trip" {
    assert CmCatalog::id_newtype(2.5) == 2.5;
}

test "list round-trip" {
    assert CmCatalog::id_list_u8([1, 2, 3]) == [1, 2, 3];
    assert CmCatalog::id_list_string(["a", "bb"]) == ["a", "bb"];
    assert CmCatalog::id_list_u8([]) == [];
}

test "option round-trip" {
    assert CmCatalog::id_option_u32(Option::Some(5)) == Option::Some(5);
    assert CmCatalog::id_option_u32(null) == null;
    assert CmCatalog::id_option_string(Option::Some("x")) == Option::Some("x");
    assert CmCatalog::id_option_string(null) == null;
}

test "result round-trip" {
    assert CmCatalog::id_result_both(Result::Ok(9)) == Result::Ok(9);
    assert CmCatalog::id_result_both(Result::Err("nope")) == Result::Err("nope");
    assert CmCatalog::id_result_fu(Result::Ok(1.5)) == Result::Ok(1.5);
    assert CmCatalog::id_result_fu(Result::Err(42)) == Result::Err(42);
}

test "record round-trip" {
    assert CmCatalog::id_record(Point { x: 1.5, y: 2.5 }) == Point { x: 1.5, y: 2.5 };
}

test "variant round-trip" {
    assert CmCatalog::id_variant(Shape::Circle(2.0)) == Shape::Circle(2.0);
    assert CmCatalog::id_variant(Shape::Rect([3.0, 4.0])) == Shape::Rect([3.0, 4.0]);
    assert CmCatalog::id_variant(Shape::Nothing) == Shape::Nothing;
    assert CmCatalog::id_mixed(Mixed::AsInt(7)) == Mixed::AsInt(7);
    assert CmCatalog::id_mixed(Mixed::AsFloat(1.5)) == Mixed::AsFloat(1.5);
}

test "flags round-trip" {
    assert CmCatalog::id_flags(Perms::Read | Perms::Write) == Perms::Read | Perms::Write;
}

test "tuple round-trip" {
    assert CmCatalog::id_tuple_pair([7, "x"]) == [7, "x"];
    assert CmCatalog::id_tuple_triple([5, true, 'Z']) == [5, true, 'Z'];
}

test "nested containers round-trip" {
    assert CmCatalog::id_list_record([Point { x: 1.0, y: 2.0 }]) == [Point { x: 1.0, y: 2.0 }];
    assert CmCatalog::id_option_record(Option::Some(Point { x: 1.0, y: 2.0 })) == Option::Some(Point { x: 1.0, y: 2.0 });
    assert CmCatalog::id_tuple_record([Point { x: 1.0, y: 2.0 }, 9]) == [Point { x: 1.0, y: 2.0 }, 9];
    assert CmCatalog::id_option_list(Option::Some([1, 2])) == Option::Some([1, 2]);
    assert CmCatalog::id_result_list(Result::Ok([Point { x: 1.0, y: 2.0 }])) == Result::Ok([Point { x: 1.0, y: 2.0 }]);
    assert CmCatalog::id_list_tuple([[1, "a"]]) == [[1, "a"]];
    assert CmCatalog::id_assoc_array([["k", 1]]) == [["k", 1]];
    assert CmCatalog::id_list_option([Option::Some(1)]) == [Option::Some(1)];
    assert CmCatalog::id_tuple_option([Option::Some(3), 4]) == [Option::Some(3), 4];
    assert CmCatalog::id_list_tuple_record([[Point { x: 1.0, y: 2.0 }, 9]]) == [[Point { x: 1.0, y: 2.0 }, 9]];
}
