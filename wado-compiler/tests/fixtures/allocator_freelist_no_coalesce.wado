/// Test that the freelist allocator does NOT coalesce across a block
/// that is still in use: a lone free block cannot merge with used
/// neighbours, so a request too large for it bump-allocates instead of
/// corrupting the live block.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let a = builtin::realloc(0, 0, 8, 64);
    let b = builtin::realloc(0, 0, 8, 64);
    let c = builtin::realloc(0, 0, 8, 64);
    assert b == a + 80, `b={b}, a={a}`;
    assert c == a + 160, `c={c}, a={a}`;

    // Only b is freed; a and c stay in use, so b's 80-byte block is
    // isolated and cannot grow by coalescing.
    builtin::realloc(b, 64, 8, 0);

    // A 256-byte payload does not fit b's 80-byte block, and b cannot
    // merge with its used neighbours — so this bump-allocates past c.
    let big = builtin::realloc(0, 0, 8, 256);
    assert big != b, `must not reuse the too-small block: big={big}, b={b}`;
    assert big == c + 80, `expected bump allocation past c: big={big}, c={c}`;

    builtin::realloc(a, 64, 8, 0);
    builtin::realloc(c, 64, 8, 0);
    builtin::realloc(big, 256, 8, 0);
    println("ok");
}

__DATA__
{"allocator": "freelist", "stdout": "ok\n"}
