// A tuple argument nesting the parameter reaches a receiver of that tuple shape
// (finding 10).

struct Pair<A, B> {
    a: A,
    b: B,
}

impl<T> Pair<[T, i32], i32> {
    fn left(&self) -> T {
        return self.a.0;
    }
}

trait Right {
    fn right(&self) -> i32;
}

impl<T> Right for Pair<[T, i32], i64> {
    fn right(&self) -> i32 {
        return self.a.1;
    }
}

test "an inherent impl" {
    let p: Pair<[i32, i32], i32> = Pair { a: [5, 6], b: 0 };
    assert p.left() == 5;
}

test "a trait impl" {
    let p: Pair<[String, i32], i64> = Pair { a: ["x", 6], b: 0 };
    assert p.right() == 6;
}

__DATA__
{"test": {}}
