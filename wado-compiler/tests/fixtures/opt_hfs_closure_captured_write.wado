// A closure's capture publishes the captured local's `Box` cell into the env
// struct, so hot-field scalarization may not hold `step.value` in a scalar
// across the call: `bump()` writes the cell through the env, naming no `&mut`
// the call scan can see.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut step = builtin::black_box(1);
    let mut bump = || {
        step = 100;
    };
    let mut sum = 0;
    for let mut i = 0; i < 3; i += 1 {
        step = step + 1;
        sum += step;
        sum += step;
        bump();
    }
    println(`${sum}`);
}

__DATA__
{
    "stdout": "408\n"
}
