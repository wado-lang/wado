// Test continue in for loop

use { println, Stdout } from "core:cli";

fn run() with Stdout {
    for let mut i = 0; i < 5; i = i + 1 {
        if i == 2 {
            continue;
        }
        println(`i: {i}`);
    }
    println("done");
}

__DATA__
{"stdout": "i: 0\ni: 1\ni: 3\ni: 4\ndone\n"}
