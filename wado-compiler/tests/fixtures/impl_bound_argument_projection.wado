// An impl's bound whose argument is a projection asks what the projection is
// at the matched arguments. `Q: Has<P::Item>` at `P = Ints` asks `Has<i32>`,
// which `Right` implements. The solver compared `<Ints as Src>::Item` with
// `i32` as written, so no impl of `Has` answered and the pair was not `Shown`.

trait Src with () {
    type Item;
}

trait Has<A> with () {
    fn h(&self) -> i32;
}

trait Shown with () {
    fn shown(&self) -> i32;
}

struct Ints {}

impl Src for Ints {
    type Item = i32;
}

struct Right {}

impl Has<i32> for Right {
    fn h(&self) -> i32 {
        return 5;
    }
}

struct Pair<P, Q> {
    q: Q,
    p: P,
}

impl<P: Src, Q: Has<P::Item>> Shown for Pair<P, Q> {
    fn shown(&self) -> i32 {
        return self.q.h();
    }
}

fn show<T: Shown>(t: &T) -> i32 {
    return t.shown();
}

test {
    assert show(&Pair { q: Right {}, p: Ints {} }) == 5;
}

__DATA__
{"test": {}}
