// A bare case names no type of its own, so a comparison resolves it after the
// other operand and hands it that operand's type: whichever side it is on, and
// even beside a static call, which consults the expected type too.

enum Color {
    Red,
    Green,
}

impl Color {
    fn favorite() -> Color {
        return Red;
    }
}

struct Box {}

impl Box {
    fn label() -> Option<String> {
        return Option::Some("a");
    }
}

test "a bare case beside a static call" {
    assert Box::label() == Some("a");
    assert Some("a") == Box::label();
    assert Color::favorite() == Red;
    assert Red == Color::favorite();
    assert Color::favorite() != Green;
    assert Red == Color::favorite() == Red;
}

test "a bare case on the left" {
    let c: Color = Green;
    assert Green == c;
    assert Red != c;
}

test "a bare case in a branch's tail" {
    let c: Color = Green;
    let warm = builtin::black_box(false);
    assert (if warm { Red } else { Green }) == c;
    assert (match warm { true => Red, false => Green }) == c;
    assert (if warm { Red } else { if c == Red { Red } else { Green } }) == c;
}

interface Noop {
    fn ping();
}

struct Quiet {}

impl Noop for Quiet {
    fn ping(&mut self) {
        resume ();
    }
}

test "a bare case in any form that hands the expected type on" {
    let c: Color = Green;
    let warm = builtin::black_box(false);
    assert (pick: { if warm { break pick: Red; } Green }) == c;
    assert (pick: { if warm { Red } else { break pick: Green; } }) == c;
    let mut quiet = Quiet {};
    assert (with Noop => &mut quiet do { Green }) == c;
    assert &Green == &c;
}

test "a tuple literal still takes a variable's type" {
    let t: [i64, i64] = [1, 2];
    assert [1, 2] == t;
}

__DATA__
{"test": {}}
