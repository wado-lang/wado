// Test Array::append inlining in nested contexts
// Mimics treemap patterns that cause issues

use { println, Stdout } from "core:cli";

struct Container {
    items: Array<i32>,
}

impl Container {
    fn add_items(&mut self, count: i32) {
        for let mut i = 0; i < count; i += 1 {
            // Multiple append calls in a loop
            self.items.push(i);
            self.items.push(i * 2);
        }
    }

    fn process(&mut self) {
        let mut temp: Array<i32> = [];

        // Nested loop with conditionals
        for let mut i = 0; i < self.items.len(); i += 1 {
            let val = self.items[i];
            if val % 2 == 0 {
                temp.push(val);
            }
        }

        // Copy back
        for let mut j = 0; j < temp.len(); j += 1 {
            self.items.push(temp[j] + 100);
        }
    }
}

export fn run() with Stdout {
    let mut c = Container { items: [] };
    c.add_items(3);
    c.process();
    println(`len={c.items.len()}`);
}

__DATA__
{
    "stdout": "len=11\n",
    "wir_expect:O2": ["_licm_repr"]
}
