// wado-lang/wado#1623: collect() targets any FromIterator type, including a
// newtype over List, chosen by the expected type.
use { println, Stdout } from "core:cli";

type Codes = List<u32>;

export fn run() with Stdout {
    let s = "AB";

    let list: List<u8> = s.bytes().collect();
    println(`${list.len()}`);

    let bytes: ByteList = s.bytes().collect();
    println(`${bytes.to_hex()}`);

    let hex = s.bytes().collect::<ByteList>().to_hex();
    println(`${hex}`);

    let codes: Codes = s.chars().map(|c: char| c as u32).collect();
    println(`${codes[0]}`);

    let mut it = ([10, 20, 30] as List<i32>).into_iter();
    let taken: List<i32> = it.collect();
    println(`${taken.len()} ${it.next() matches { None }}`);
}

__DATA__
{"stdout": "2\n4142\n4142\n65\n3 true\n"}
