// A dispatch path names its interface in the segment before the operation, so a
// namespace qualifier ahead of it must not stand in for the interface. Reading
// the first segment instead let `c::Counter::next()` past the purity check,
// which then reached WIR as an unresolved call and panicked.
//
// Namespace-qualified dispatch does not elaborate yet (it fails the same way in
// a plain function body), so what this pins is the diagnostic: the check sees
// the operation and words it, rather than waving the call through.

use { println, Stdout } from "core:cli";
use c from "./sub/ns_counter.wado";

global COUNTED: i32 = c::Counter::next();

export fn run() with Stdout {
    println(`${COUNTED}`);
}

__DATA__
{
    "compile_error": "global initializer must be pure (no effects), but dispatches effect operation 'next', which needs an installed handler"
}
