// A derived method on a receiver whose type arguments nothing settles is
// found, and the arguments are what the call reports: the method exists at
// every instance the receiver may become.
variant Tree<T> { Leaf(T), Empty }

test "a method call" {
    assert Tree::Empty.eq(&Tree::Empty);
}

test "a qualified call" {
    assert Tree::eq(&Tree::Empty, &Tree::Empty);
}

fn mk<T>() -> Tree<T> {
    return Tree::Empty;
}

test "a receiver a generic call returns" {
    assert !mk().eq(&Tree::Leaf(1));
}

// A variable inside an argument may be what the impl's parameter is bound to
// elsewhere.
trait Twin with () {
    fn twin(&self) -> i32;
}

struct Pair<A, B> {
    a: A,
    b: B,
}

impl<T> Twin for Pair<T, T> {
    fn twin(&self) -> i32 {
        return 2;
    }
}

fn half<U>(b: List<i32>) -> Pair<List<U>, List<i32>> {
    let a: List<U> = [];
    return Pair { a, b };
}

test "a variable nested in an argument" {
    assert half([1]).twin() == 2;
}

// Of two impls that may apply, the receiver's answer would choose, so neither
// answers before it, and the method is missing beside the variable.
trait Pick with () {
    fn pick(&self) -> i32;
}

impl Pick for Tree<i32> {
    fn pick(&self) -> i32 {
        return 1;
    }
}

impl Pick for Tree<String> {
    fn pick(&self) -> i32 {
        return 2;
    }
}

test "two impls that may apply" {
    assert mk().pick() == 1;
}

