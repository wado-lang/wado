use { println, Stdout } from "core:cli";

// from associated_type_index_mut.wado
struct Counter {
    value: i32,
}

impl Counter {
    fn increment(&mut self) {
        self.value = self.value + 1;
    }
}

struct Container {
    item: Counter,
}

// Implement IndexMutRef trait for mutable access (Counter is a reference type)
impl<i32> IndexMutRef<i32> for Container {
    type Output = Counter;

    fn index_mut_ref(&mut self, _index: i32) -> &mut Self::Output {
        return &mut self.item;
    }
}

// from associated_type_index_trait.wado
struct MyContainer {
    data: i32,
}

// Implement IndexValue trait (a scalar element is read by value, not by &i32)
impl<i32> IndexValue<i32> for MyContainer {
    type Output = i32;

    fn index_value(&self, _index: i32) -> Self::Output {
        return self.data;
    }
}

// from associated_type_index_mut.wado
fn associated_type_index_mut() with Stdout {
    let mut c = Container { item: Counter { value: 0 } };
    // Call index_mut_ref explicitly and mutate
    c.index_mut_ref(0).increment();
    c.index_mut_ref(0).increment();
    println(`Value: ${c.item.value}`);
}

// from associated_type_index_trait.wado
fn associated_type_index_trait() with Stdout {
    let container = MyContainer { data: 42 };
    // Call the index_value method explicitly (not via [] syntax yet)
    let val = container.index_value(0);
    println(`Value: ${val}`);
}

export fn run() with Stdout {
    associated_type_index_mut();
    associated_type_index_trait();
}

__DATA__
{"stdout": "Value: 2\nValue: 42\n"}
