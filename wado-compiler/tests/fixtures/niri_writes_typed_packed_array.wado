// A constant sequence the interpreter writes back is one data segment for
// every element type with a data width, not only for bytes.

export fn run() {
    let src = List::<f32>::from_le_bytes(b"\x00\x00\x80\x3f\x00\x00\x20\xc0\x00\x00\x40\x40");
    let copy = builtin::black_box([src[2], src[1], src[0]] as List<f32>);
    assert copy[0] == 3.0;
    assert copy[1] == -2.5;
    assert copy[2] == 1.0;
}

__DATA__
{
    "wir_expect:O2": ["array.new_data<f32>"],
    "wir_not_expect:O2": ["array.new_fixed<f32>"]
}
