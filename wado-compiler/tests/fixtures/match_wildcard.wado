// Test match expression with wildcard pattern

use { println, Stdout } from "core:cli";

variant Color {
    Red,
    Green,
    Blue,
}

fn run() with Stdout {
    let red = Color::Red;
    let green = Color::Green;
    let blue = Color::Blue;

    // Match with wildcard as catch-all
    let name1 = match red {
        Red => "red",
        _ => "other",
    };


    println(name1);

    let name2 = match green {
        Red => "red",
        _ => "other",
    };


    println(name2);

    let name3 = match blue {
        Red => "red",
        Green => "green",
        _ => "other",
    };


    println(name3);
}

__DATA__
{"stdout": "red\nother\nother\n"}
