// A parameter that is only assigned to is not dead: dropping it must not leave
// its assignment naming a slot that no longer exists (a handler closure's
// receiver, which no read keeps alive). Only -O1 reaches the shape, and only
// with both install forms and both `black_box` loops; remove any one and the
// crash is gone.

use { println, Stdout } from "core:cli";

struct Counter<T> {
    stored: Option<T>,
    drops: i32,
}

impl<T> Future<T> for Counter<T> {
    fn new(&mut self) -> [Future<T>, FutureWritable<T>] {
        resume Future::<T>::new();
    }

    fn read(&mut self, this: &Future<T>) -> Option<T> {
        let _ = this;
        resume self.stored;
    }

    fn drop(&mut self, this: &Future<T>) {
        let _ = this;
        self.drops += 1;
        resume ();
    }

    ..trap
}

impl<T> FutureWritable<T> for Counter<T> {
    fn write(&mut self, this: &FutureWritable<T>, value: T) -> FutureWrite<T> {
        let _ = this;
        self.stored = Option::Some(value);
        resume FutureWrite { rest: null, result: FutureWriteResult::Completed };
    }

    fn drop(&mut self, this: &FutureWritable<T>) {
        while builtin::black_box(false) {  } let _ = this;
        while builtin::black_box(false) {  } resume ();
    }

    ..trap
}

export fn run() with Stdout {
    let mut c = Counter::<i32> { stored: null, drops: 0 };
    with Future<i32> => &mut c, FutureWritable<i32> => &mut c do {
        let [rx, tx] = Future::<i32>::new();
        tx.write(7);
        let _unread = rx;
    };
    let mut b = Counter::<i32> { stored: null, drops: 0 };
    with &mut b do {
        let [rx, tx] = Future::<i32>::new();
        tx.write(8);
        let _unread = rx;
    };
    println(`drops=${b.drops}`);
}

__DATA__
{"stdout": "drops=1\n"}
