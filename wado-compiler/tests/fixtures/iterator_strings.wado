// Test iterator with String elements
use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let arr: Array<String> = ["hello", "world", "!"];
    let mut iter = arr.iter();

    loop {
        if let Some(s) = iter.next() {
            println(s);
        } else {
            break;
        }
    }
}

__DATA__
{"stdout": "hello\nworld\n!\n"}
