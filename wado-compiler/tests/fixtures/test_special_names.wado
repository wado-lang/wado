// Test names with special characters that must produce valid kebab-case exports.

test "parentheses (like this) work" {
    assert 1 + 1 == 2;
}

test "dashes in-test-name work" {
    assert true;
}

test "multiple  spaces  collapse" {
    assert true;
}

test "trailing special chars!" {
    assert true;
}

