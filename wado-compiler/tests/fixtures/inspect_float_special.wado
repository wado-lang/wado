// Test: inspect float special values
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let inf = f64::INFINITY;
    println(`{inf:?}`);

    let neg_inf = f64::NEG_INFINITY;
    println(`{neg_inf:?}`);

    let zero = 0.0;
    println(`{zero:?}`);

    let neg_zero = -0.0;
    println(`{neg_zero:?}`);

    let f32_inf = f32::INFINITY;
    println(`{f32_inf:?}`);

    println("ok");
}

__DATA__
{"stdout": "inf\n-inf\n0.0\n-0.0\ninf\nok\n"}
