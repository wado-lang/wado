// Test: mutate elements of Array<Array<i32>>
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut matrix: Array<Array<i32>> = [[1, 2], [3, 4]];

    // Append to inner array
    let mut row = matrix[0];
    row.append(99);
    println(`{row:?}`);

    // Replace inner array
    let new_row: Array<i32> = [10, 20, 30];
    matrix[0] = new_row;
    println(`{matrix:?}`);

    println("ok");
}

__DATA__
{"stdout": "[1, 2, 99]\n[[10, 20, 30], [3, 4]]\nok\n"}
