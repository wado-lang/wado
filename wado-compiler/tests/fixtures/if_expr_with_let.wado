// Test: if expression with let statements inside branches
use { println, Stdout } from "core:cli";

fn compute(x: i32) -> i32 {
    let result = if x > 0 {
        let a = x * 2;
        let b = a + 1;
        b;
    } else {
        let c = x * 3;
        c;
    };
    return result;
}

fn run() with Stdout {
    println(`{compute(5)}`);
    println(`{compute(-2)}`);
}

__DATA__
{"stdout": "11\n-6\n"}
