// At O1 `apply` is specialized to call `$call` directly and DAE drops `q`, so
// nothing mentions `&Node`; the closure wrapper is still built from the
// canonical signature, so type DCE must keep it.

struct Node {
    v: i32,
}

struct Owned {
    v: i32,
}

fn fresh(n: &Node) -> Owned {
    return Owned { v: n.v };
}

fn apply(f: fn(&Node), n: &Node) {
    while builtin::black_box(false) {}
    f(n);
}

export fn run() {
    let node = Node { v: 7 };
    apply(|q: &Node| {
        while builtin::black_box(false) {}
        let _ = fresh(q);
    }, &node);
    assert node.v == 7;
}

