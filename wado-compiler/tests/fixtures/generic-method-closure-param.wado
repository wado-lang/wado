// Test: generic method calling another method that takes a closure parameter

use { println, Stdout } from "core:cli";

struct Container<T> {
    value: T,
}

impl<T> Container<T> {
    fn new(value: T) -> Container<T> {
        return Container { value };
    }

    // This method takes a closure parameter
    fn transform(&self, f: fn(&T) -> T) -> T {
        return f(&self.value);
    }

    // This generic method calls another method, forwarding its closure parameter
    fn double_transform(&self, f: fn(&T) -> T) -> T {
        // First transform
        let intermediate = self.transform(f);
        // Create new container and transform again
        let c2 = Container::<T>::new(intermediate);
        return c2.transform(f);
    }
}

export fn run() with Stdout {
    let c = Container::<i32>::new(5);

    // Direct call works
    let result1 = c.transform(|x: &i32| *x * 2);
    println(`transform: {result1}`);

    // Calling generic method that internally calls method with closure
    let result2 = c.double_transform(|x: &i32| *x * 2);
    println(`double_transform: {result2}`);
}

__DATA__
{"stdout": "transform: 10\ndouble_transform: 20\n"}
