// A `fn(..)` value reached through a generic container must be inspectable.
//
// `T^Inspect::inspect` monomorphized at a `fn(..)` type named the receiver by
// the type's own name, while every closure of one arity and return type shares
// one dispatch stub keyed by that coarser shape — so the call reached WIR build
// with no target and the program was rejected with "type `fn(i32)->i32` does
// not implement trait `Inspect`". No `assert` is involved.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let fs: List<fn(i32) -> i32> = [|x: i32| -> i32 { return x * 3; }];
    let gs: List<fn(u8) -> i32> = [|x: u8| -> i32 { return 7; }];
    println(`${fs:?}`);
    println(`${gs:?}`);
    println(`${fs[0](2)}`);
}

__DATA__
{
    "stdout": "[|i32| -> i32]\n[|u8| -> i32]\n6\n"
}
