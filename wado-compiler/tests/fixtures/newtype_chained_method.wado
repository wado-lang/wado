// Chained newtypes: type C = B = A = Point
// Method inheritance should work through the chain

use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

impl Point {
    fn add(&self, other: &Point) -> Point {
        return Point { x: self.x + other.x, y: self.y + other.y };
    }
}

type A = Point;
type B = A;
type C = B;

export fn run() with Stdout {
    let c1: C = Point { x: 1, y: 2 } as C;
    let c2: C = Point { x: 3, y: 4 } as C;
    // Method call on C should work (inherited through B -> A -> Point)
    // Signature is substituted: add(&self, other: &C) -> C
    let c3 = c1.add(&c2);
    println(`x: ${c3.x}, y: ${c3.y}`);
}

__DATA__
{"stdout": "x: 4, y: 6\n"}
