// A wasm-asset export is its own asset's, whatever another import shares the
// name: the bundled libm's `f64_sin`, or the allocator's `realloc`.
use { realloc, f64_sin } from "./sub/wasm_import_shared_export_names.wat" with { type: "wat" };

test "each asset keeps its own export" {
    assert realloc(0, 0, 1, 1) == 7;
    assert f64_sin(0.0) == 42.0;
    assert f64::sin(0.0) == 0.0;
    assert `${f64::sin(0.5)}`.len() > 3;
}
