// Every constant a hole handle answers: the segment before it cooked and raw,
// the tail both ways, its index, and the specifier it wrote, if any. `fmt`
// renders through the trait the specifier selects, and a tag needs no bound to
// call it (WEP 2026-01-10).
//
// `ReflectTemplate` and `TemplateHole` are prelude API, so a module that spells the
// import out — as one under `#![no_prelude]` must — names the same items the
// auto-import gives.
use { println, Stdout } from "core:cli";
use { ReflectTemplate, TemplateHole } from "core:prelude";

fn show<T, V>(h: &TemplateHole<T, V>, t: &T, out: &mut String) {
    out.push_str(&`[${h.index()} lit=${h.lit(t):?} raw=${h.raw(t):?} spec=${h.has_spec()} ${h.spec():?} value=`);
    h.fmt(t, &mut Formatter::new(out));
    out.push_str(&"]");
}

fn describe<T: ReflectTemplate<Holes = [..V]>, ..V>(t: T) -> String {
    let mut out = "";
    for let h of ReflectTemplate::<T>::members() {
        show(&h, &t, &mut out);
    }
    out.push_str(&`[tail=${ReflectTemplate::<T>::tail(&t):?} raw=${ReflectTemplate::<T>::raw_tail(&t):?}]`);
    return out;
}

struct Pt {
    x: i32,
    y: i32,
}

export fn run() with Stdout {
    let pi = builtin::black_box(3.14159);
    let n = builtin::black_box(255);
    let p = Pt { x: 1, y: 2 };
    println(describe`a\t${pi:.2}b\n${n:#x}c${p:?}d${n}`);
    println(String::raw`x\t${n}\n`);
    println(describe`no holes\n`);
}

__DATA__
{"stdout": "[0 lit=\"a\\t\" raw=\"a\\\\t\" spec=true Option::Some(\".2\") value=3.14][1 lit=\"b\\n\" raw=\"b\\\\n\" spec=true Option::Some(\"#x\") value=0xff][2 lit=\"c\" raw=\"c\" spec=true Option::Some(\"?\") value=Pt { x: 1, y: 2 }][3 lit=\"d\" raw=\"d\" spec=false Option::None value=255][tail=\"\" raw=\"\"]\nx\\t255\\n\n[tail=\"no holes\\n\" raw=\"no holes\\\\n\"]\n"}
