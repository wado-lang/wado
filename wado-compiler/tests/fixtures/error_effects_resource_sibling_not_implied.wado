// A resource implies the resources that extend it, never its siblings: holding
// `Elem` grants nothing on an `Other`, though both extend `EventTarget`.
#[cm("test:dom/event-target", linearity = "unrestricted", repr = "externref")]
resource EventTarget {
    fn tag(&self) -> String;
}

#[cm("test:dom/elem", linearity = "unrestricted", repr = "externref")]
resource Elem extends EventTarget {
    fn b(&self) -> String;
}

#[cm("test:dom/other", linearity = "unrestricted", repr = "externref")]
resource Other extends EventTarget {
    fn c(&self) -> String;
}

fn sibling(o: Other) -> String with Elem {
    return o.c();
}

export fn run() {}

__DATA__
{
    "compile_error": ":19:12: analysis error: missing resource 'Other' required by 'c'",
    "compile_error_codes": ["MISSING_EFFECT"]
}
