// A `&mut` to an iterator is an iterator that advances the one it points to:
// a loop, an adapter and a generic consumer handed `&mut it` all leave `it`
// where they stopped. Regression: each walked a copy.

test "a loop over the iterator itself walks a copy" {
    let mut r = 0..<5;
    for let x of r { if x == 1 { break; } }
    assert r.next() matches { Some(0) };
}

test "a loop over `&mut it` advances it" {
    let mut r = 0..<5;
    for let x of &mut r { if x == 1 { break; } }
    assert r.next() matches { Some(2) };
}

fn sum_through_one<I: Iterator<Item = i32>>(it: &mut I) -> i32 with _ {
    let mut sum = 0;
    for let x of it {
        sum += x;
        if x == 1 { break; }
    }
    return sum;
}

test "a loop over a `&mut I` parameter advances the caller's iterator" {
    let mut r = 0..<5;
    assert sum_through_one(&mut r) == 1;
    assert r.next() matches { Some(2) };
}

fn first_two<I: Iterator<Item = i32>>(it: &mut I) -> List<i32> with _ {
    return it.take(2).collect();
}

test "an adapter called on a `&mut I` advances the caller's iterator" {
    let mut r = 0..<5;
    assert first_two(&mut r) == [0, 1];
    assert r.next() matches { Some(2) };
}

fn head<I: Iterator<Item = i32>>(it: I) -> Option<i32> with _ {
    let mut it = it;
    return it.next();
}

test "a generic consumer takes `&mut it` as its iterator" {
    let mut r = 0..<5;
    assert head(&mut r) matches { Some(0) };
    assert r.next() matches { Some(1) };
}

fn sum_to_one<I: Iterator<Item = i32>>(it: I) -> i32 with _ {
    let mut sum = 0;
    for let x of it {
        sum += x;
        if x == 1 { break; }
    }
    return sum;
}

test "a generic consumer's loop advances the `&mut it` it was handed" {
    let mut r = 0..<5;
    assert sum_to_one(&mut r) == 1;
    assert r.next() matches { Some(2) };
}

test "a generic consumer's loop walks a copy of an iterator handed by value" {
    let mut r = 0..<5;
    assert sum_to_one(r) == 1;
    assert r.next() matches { Some(0) };
}

test "a list's iterator is advanced the same way" {
    let xs: List<i32> = [1, 2, 3];
    let mut it = xs.into_iter();
    for let x of &mut it { if x == 1 { break; } }
    assert it.next() matches { Some(2) };
}

test "an adapter taking a closure reads the reference's item type" {
    let mut r = 0..<9;
    let doubled = (&mut r).map(|x| x * 2).take(1).collect();
    assert doubled == [0];
    let even = (&mut r).filter(|x| x % 2 == 0).take(1).collect();
    assert even == [2];
    assert r.next() == Option::Some(3);
}

fn skip_one<I: Iterator<Item = i32>>(it: &mut I) -> List<i32> with _ {
    return it.take(2).skip(1).collect();
}

test "adapters chain on a reference to a parameter" {
    let mut r = 0..<9;
    assert skip_one(&mut r) == [1];
    assert r.next() == Option::Some(2);
}

fn first_two_of(rr: &mut &mut RangeExclusive<i32>) -> List<i32> {
    return (*rr).take(2).collect();
}

test "a reference to a reference is dereferenced to the one that iterates" {
    let mut r = 0..<6;
    let mut m = &mut r;
    assert first_two_of(&mut m) == [0, 1];
    assert r.next() == Option::Some(2);
}

struct Counter { n: i32 }

impl Iterator for Counter {
    type Item = i32;
    fn next(&mut self) -> Option<i32> {
        self.n += 1;
        return Option::Some(self.n);
    }
}

impl Counter {
    fn take(&mut self, k: i32) -> i32 { return k; }
}

struct Printer {}

trait Show<T> with () {
    fn show(&self, t: T) -> i32;
}

impl Show<i32> for Printer {
    fn show(&self, t: i32) -> i32 { return t; }
}

impl Show<String> for Printer {
    fn show(&self, t: String) -> i32 { return t.len(); }
}

fn shown(c: &mut Counter) -> i32 {
    return Printer {}.show(c.take(2));
}

test "an inherent method answers ahead of the reference's adapter" {
    let mut c = Counter { n: 0 };
    assert shown(&mut c) == 2;
}

struct Evens { inner: &mut Counter }

impl Iterator for Evens {
    type Item = i32;
    fn next(&mut self) -> Option<i32> {
        loop {
            let Some(x) = self.inner.next() else { return null; };
            if x % 2 == 0 { return Option::Some(x); }
        }
    }
}

impl ForOf for &mut Counter {
    type Item = i32;
    type State = Evens;
    fn start(self) -> Evens { return Evens { inner: self }; }
}

test "a ForOf written for the reference says what the loop walks" {
    let mut c = Counter { n: 0 };
    let mut seen: List<i32> = [];
    for let x of &mut c {
        seen.push(x);
        if seen.len() == 2 { break; }
    }
    assert seen == [2, 4];
}

type Tally = Counter;

test "and a newtype inherits it from its base" {
    let mut t = Counter { n: 0 } as Tally;
    let mut seen: List<i32> = [];
    for let x of &mut t {
        seen.push(x);
        if seen.len() == 2 { break; }
    }
    assert seen == [2, 4];
}
