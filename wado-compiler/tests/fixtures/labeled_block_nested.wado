// Test nested labeled blocks

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut result = 0;
    outer: {
        result = 1;
        inner: {
            result = 2;
            if result == 2 {
                break outer;  // Break out of both blocks
            }
            result = 3;  // Should not reach here
        }
        result = 4;  // Should not reach here
    }
    assert result == 2;
    println("ok");
}

__DATA__
{"stdout": "ok\n"}
