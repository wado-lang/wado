use { println, Stdout } from "core:cli";

// Simple struct for basic auto-deref test
struct Point {
    x: i32,
    y: i32,
}

impl Point {
    fn sum(&self) -> i32 {
        return self.x + self.y;
    }

    fn scale(&self, factor: i32) -> i32 {
        return (self.x + self.y) * factor;
    }
}

// Generic struct for auto-deref on generic types
struct Box<T> {
    value: T,
}

impl Box<T> {
    fn get(&self) -> T {
        return self.value;
    }
}

fn run() with Stdout {
    // Basic auto-deref on simple struct
    let p = Point { x: 10, y: 20 };
    let p_ref = &p;
    assert p_ref.sum() == 30;
    assert p_ref.scale(2) == 60;

    // Double reference auto-deref
    let p_ref2 = &p_ref;
    assert p_ref2.sum() == 30;

    // Auto-deref on generic struct Box<i32>
    let box_i32 = Box { value: 42 };
    let box_ref = &box_i32;
    assert box_ref.get() == 42;

    // Auto-deref on generic struct Box<String>
    let box_str = Box { value: "hello" };
    let box_str_ref = &box_str;
    let inner = box_str_ref.get();
    assert inner.len() == 5;

    // Auto-deref on String methods
    let s = "hello";
    let s_ref = &s;
    assert s_ref.len() == 5;
    assert s_ref.get(0) == 'h' as i32;

    // Mutable reference auto-deref
    let mut p2 = Point { x: 5, y: 10 };
    let p2_mut_ref = &mut p2;
    assert p2_mut_ref.sum() == 15;

    // Triple reference auto-deref
    let p_ref3 = &p_ref2;
    assert p_ref3.sum() == 30;

    println("all auto-deref tests passed");
}

__DATA__
{"stdout": "all auto-deref tests passed\n"}
