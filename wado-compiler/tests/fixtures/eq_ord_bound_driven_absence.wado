// Regression: bound-driven Eq/Ord synthesis is genuinely on-demand — a
// declared type that no `==`/`<` call site, bound, or explicit marker ever
// asks about must not get a synthesized impl at all. This is the entire
// point of moving Eq/Ord off the old unconditional-synthesis policy (WEP:
// Trait Derivation Policy — Bound-Driven Synthesis); a regression back to
// unconditional synthesis would pass every other Eq/Ord test in this
// suite (they only check the positive, used case) without this one.
//
// Checked at -O0 (no optimization): at -O2 the optimizer constant-folds
// this comparison away entirely (both operands are compile-time-known
// literals), which would make `UsedForEq^Eq::eq` absent too and defeat
// the check for an unrelated reason.
struct UsedForEq {
    x: i32,
}

struct NotUsedAtAll {
    y: i32,
}

export fn run() {
    let a = UsedForEq { x: 1 };
    let b = UsedForEq { x: 1 };
    assert a == b;

    let _unused = NotUsedAtAll { y: 2 };
}

__DATA__
{
    "wir_expect:O0": ["UsedForEq^Eq::eq"],
    "wir_not_expect:O0": ["NotUsedAtAll^Eq::eq", "NotUsedAtAll^Ord::cmp"]
}
