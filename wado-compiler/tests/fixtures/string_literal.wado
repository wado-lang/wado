// String and byte-string literals: multiline text, `b"..."` escapes, and the
// conversions into `String` from a char and from bytes.

type MyBytes = List<u8>;

struct Holder {
    buf: List<u8>,
}

fn byte_list_len(v: ByteList) -> i32 {
    return v.len();
}

fn raw_len(v: List<u8>) -> i32 {
    return v.len();
}

fn raw_default() -> List<u8> {
    return b"xy";
}

test "a double-quoted literal spans lines" {
    let poem = "Roses are red,
Violets are blue,
Wado is great,
And so are you!";
    assert poem == "Roses are red,\nViolets are blue,\nWado is great,\nAnd so are you!";

    let mixed = "Line with tab:\there
Next line";
    assert mixed == "Line with tab:\there\nNext line";

    let with_empty = "First

Third";
    assert with_empty == "First\n\nThird";
}

test "a byte-string literal defaults to ByteList and coerces to List<u8>" {
    // `b"..."` lowers to a constant byte buffer via the data-segment path (the
    // same `BytesLiteral` lowering `#include_bytes` uses). Its default type is
    // the first-class `ByteList` newtype, and newtype literal coercion lets it
    // flow into a `List<u8>` context with no cast.
    let inferred = b"abc";
    assert byte_list_len(inferred) == 3;

    let bl: ByteList = b"abc";
    assert bl.len() == 3;

    let a: List<u8> = b"abc";
    assert a.len() == 3;
    assert a[0] == 97;
    assert a[1] == 98;
    assert a[2] == 99;

    assert raw_len(b"abcd") == 4;
    assert raw_default().len() == 2;
    assert Holder { buf: b"abcde" }.buf.len() == 5;
}

test "byte-string escapes" {
    let b: List<u8> = b"\x00\xff\n\t\\\"\0";
    assert b.len() == 7;
    assert b[0] == 0;
    assert b[1] == 255;
    assert b[2] == 10;
    assert b[3] == 9;
    assert b[4] == 92;
    assert b[5] == 34;
    assert b[6] == 0;

    let c: List<u8> = b"\r\b\f/";
    assert c.len() == 4;
    assert c[0] == 13;
    assert c[1] == 8;
    assert c[2] == 12;
    assert c[3] == 47;

    let e: List<u8> = b"";
    assert e.len() == 0;
}

test "String::from a char" {
    assert String::from('A') == "A";
    assert String::from('🦀') == "🦀";
    assert String::from('\n').len() == 1;
}

test "String::from_utf8_lossy accepts a newtype over List<u8>" {
    // The monomorphizer once failed to resolve `I::Iter` when `I` is a newtype,
    // leaving an unresolved WIR Call and an invalid Wasm module.
    let bytes: MyBytes = [72, 101, 108, 108, 111] as List<u8> as MyBytes;
    assert String::from_utf8_lossy(bytes) == "Hello";
}
