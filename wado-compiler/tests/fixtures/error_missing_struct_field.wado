// Test: struct literal with missing field should produce a compile error.
// When a reference-type field (List<Inner>) is omitted, the codegen produces
// invalid Wasm because struct.new receives fewer values than the struct requires.
use { Container, Inner } from "./sub/error_missing_struct_field_lib.wado";

export fn run() {
    // Missing field 'items' — should be a compile error
    let c = Container { name: "test", count: 42 };
    assert c.count == 42;
}

__DATA__
{"compile_error": "missing field"}
