// A reused field specialization must retain its scalar-parameter contract.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut total = 0;
    for let mut i = 0; i < 5; i += 1 {
        let x = i as f64 / 10.0;
        let s = `${x:0.4f}`;
        total += s.len();
    }
    println(`total=${total}`);
    let mut hex_total = 0;
    for let mut i = 0; i < 5; i += 1 {
        let s = `${i:x}`;
        hex_total += s.len();
    }
    println(`total2=${hex_total}`);
    let mut total2 = 0;
    for let mut i = 0; i < 3; i += 1 {
        let x = i as f64;
        let s = `i=${i}, x=${x:0.2f}`;
        total2 += s.len();
    }
    println(`total3=${total2}`);
}

__DATA__
{"stdout": "total=30\ntotal2=5\ntotal3=33\n"}
