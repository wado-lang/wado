use { println, Stdout } from "core:cli";


// from char_cast_from_u32_fn.wado
fn char_cast_from_u32_fn() with Stdout {
    // Valid ASCII
    if let Some(c) = char::from_u32(65 as u32) {
        assert c == 'A';
    } else {
        panic("expected Some");
    }

    // Valid emoji
    if let Some(c) = char::from_u32(0x1F600 as u32) {
        assert c as i32 == 0x1F600;
    } else {
        panic("expected Some");
    }

    // char::from_i32 valid
    if let Some(c) = char::from_i32(65) {
        assert c == 'A';
    } else {
        panic("expected Some");
    }

    // Invalid: surrogate (0xD800)
    if let None = char::from_u32(0xD800 as u32) {
        // expected
    } else {
        panic("expected None for surrogate");
    }

    // Invalid: surrogate (0xDFFF)
    if let None = char::from_u32(0xDFFF as u32) {
        // expected
    } else {
        panic("expected None for surrogate");
    }

    // Invalid: too large (> 0x10FFFF)
    if let None = char::from_u32(0x110000 as u32) {
        // expected
    } else {
        panic("expected None for too large");
    }

    // Invalid: negative i32
    if let None = char::from_i32(-1) {
        // expected
    } else {
        panic("expected None for negative");
    }

    // Edge cases: boundaries of valid ranges
    // U+0000 (null char)
    if let Some(c) = char::from_u32(0 as u32) {
        assert c as i32 == 0;
    } else {
        panic("expected Some for U+0000");
    }

    // U+D7FF (just before surrogates)
    if let Some(c) = char::from_u32(0xD7FF as u32) {
        assert c as i32 == 0xD7FF;
    } else {
        panic("expected Some for U+D7FF");
    }

    // U+E000 (just after surrogates)
    if let Some(c) = char::from_u32(0xE000 as u32) {
        assert c as i32 == 0xE000;
    } else {
        panic("expected Some for U+E000");
    }

    // U+10FFFF (max valid)
    if let Some(c) = char::from_u32(0x10FFFF as u32) {
        assert c as i32 == 0x10FFFF;
    } else {
        panic("expected Some for U+10FFFF");
    }

    // char::from_u32_unchecked
    let uc = char::from_u32_unchecked(65 as u32);
    assert uc == 'A';

    let uc2 = char::from_u32_unchecked(0x1F600 as u32);
    assert uc2 as i32 == 0x1F600;

    println("ok");
}

// from char_cast_from_u8.wado
fn char_cast_from_u8() with Stdout {
    // u8 as char is always valid (0..255 are valid Unicode scalar values)
    let byte: u8 = 65;
    let c = byte as char;
    assert c == 'A';

    // u8 max value (255) is also valid
    let max_byte: u8 = 255;
    let c2 = max_byte as char;
    assert c2 as i32 == 255;

    // Zero
    let zero: u8 = 0;
    let c3 = zero as char;
    assert c3 as i32 == 0;

    println("ok");
}

// from char_cast_valid.wado
fn char_cast_valid() with Stdout {
    let c = 'A';

    // char -> i32
    let code_i32 = c as i32;
    assert code_i32 == 65;

    // char -> u32
    let code_u32 = c as u32;
    assert code_u32 as i32 == 65;

    // Unicode character -> i32
    let emoji = '😀';
    let emoji_code = emoji as i32;
    assert emoji_code == 0x1F600;

    println("ok");
}

export fn run() with Stdout {
    char_cast_from_u32_fn();
    char_cast_from_u8();
    char_cast_valid();
}

__DATA__
{"stdout": "ok\nok\nok\n"}
