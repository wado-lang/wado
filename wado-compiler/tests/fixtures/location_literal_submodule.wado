// Test that location literals in sub-modules report the sub-module's own values,
// not the entry module's values.
use { show_file, show_line, show_function, show_data } from "./sub/location_submodule_helper.wado";
use { Stdout } from "core:cli";

export fn run() with Stdout {
    show_file();
    show_line();
    show_function();
    show_data();
}

__DATA__
{"stdout_contains": ["sub/location_submodule_helper.wado", "9", "show_function", "SUBMODULE_DATA_MARKER"]}
