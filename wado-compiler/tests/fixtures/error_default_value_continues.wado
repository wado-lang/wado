// A default is evaluated at each call, so a `continue` in it would reach a
// loop around the call.
fn f(x: i32 = pick: { if builtin::black_box(true) { continue; } 1 }) -> i32 {
    return x;
}

export fn run() {
    for let _ of 0..<2 {
        let _ = f();
    }
}

