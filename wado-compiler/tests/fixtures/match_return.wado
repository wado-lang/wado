// match arms containing return statements should satisfy the "explicit return" check.
// All arms have return so no fallthrough is needed.

fn classify(n: i32) -> String {
    match n {
        x && x > 0 => { return "positive"; },
        x && x < 0 => { return "negative"; },
        _ => { return "zero"; },
    };
}

export fn run() {
    assert classify(1) == "positive";
    assert classify(-1) == "negative";
    assert classify(0) == "zero";
}

