// An untagged template names `String::format` in a module without the
// prelude too (spec-literals § Template Strings).
#![no_prelude]
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let n = builtin::black_box(7);
    println(`n=${n:03}`);
}

__DATA__
{"stdout": "n=007\n"}
