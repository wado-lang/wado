// Optimization: LICM with mixed immutable and mutable ref locals.
//
// In the same loop, the immutable ref's field read hoists, while the mutable
// ref's field is read after `increment` writes it on every iteration, which
// the output shows. The config is a list element, so no pass scalarizes it
// before LICM sees the read. `run` prints `limit`, so the twin's write to it
// survives dead field elimination.

use { println, Stdout } from "core:cli";

struct Config {
    threshold: i32,
    scale: i32,
}

struct Counter {
    value: i32,
    limit: i32,
}

#[inline("never")]
fn read_config(c: &Config) -> i32 {
    return c.threshold;
}

#[inline("never")]
fn increment(ctr: &mut Counter) {
    ctr.value = ctr.value + 1;
}

export fn run() with Stdout {
    let configs: List<Config> = [Config { threshold: builtin::black_box(10), scale: 2 }];
    let mut counter = Counter { value: 0, limit: 100 };
    let cr = &configs[0];
    let cm = &mut counter;
    let mut sum = 0;
    for let mut i = 0; i < 5; i += 1 {
        let _ = read_config(cr);
        increment(cm);
        sum += cr.threshold + cm.value;
    }
    println(`${sum} ${counter.limit}`);
}

__DATA__
{
    "stdout": "65 100\n",
    "wir_scope": "opt_licm_immut_ref_mixed.wado/run",
    "wir_pass": {"O2": ["nir/licm"]},
    "wir_expect:O2": ["$licm_threshold"],
    "wir_not_expect:O2": ["$licm_arith_{} = cr.threshold + counter.value;"],
    "wir_contrast": {"O2": [
        {"    ctr.value = ctr.value + 1;": "    ctr.limit = ctr.limit + 1;", "Counter { value: 0,": "Counter { value: builtin::black_box(0),"}
    ]}
}
