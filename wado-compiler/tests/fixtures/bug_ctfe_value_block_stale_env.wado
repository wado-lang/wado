// Regression: a compile-time frame must not pre-reduce a value block's
// statements against the pre-block environment. Reads (and a constant `if`)
// folded before the block's own writes ran: `stale_sum` folded to 1 (runtime
// 2) and `stale_pick` took the dead branch, folding to 10 (runtime 20). Both
// must still fold — to the computed value — so their names must not survive
// to WIR.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn stale_sum() -> i32 {
    let mut w = 1;
    return sum: {
        w = w + 1;
        break sum: w;
    };
}

#[inline(never)]
fn stale_pick() -> i32 {
    let mut w = 1;
    return pick: {
        w = 2;
        if w == 1 {
            break pick: 10;
        }
        break pick: 20;
    };
}

export fn run() with Stdout {
    println(`${stale_sum()} ${stale_pick()}`);
}

__DATA__
{
    "stdout": "2 20\n",
    "wir_not_expect:O2": [
        "stale_sum",
        "stale_pick"
    ]
}
