// Nothing answers `A`. It is written only in the closure's parameter, and the
// body says nothing about it either, so the call is where that is reported.
//
// A slot answered with itself is not answered. Left standing it carries the
// declaration's own frame into codegen, which panicked with `unsubstituted
// TypeParam` instead of raising a diagnostic.

struct Counter {
    v: i32,
}

impl Counter {
    fn go<A: Default>(&self, f: fn(A) -> i32) -> i32 {
        return f(A::default());
    }
}

test "a parameter nothing answers is reported at the call" {
    let c = Counter { v: 1 };
    assert c.go(|a| 1) == 1;
}

__DATA__
{"test": {}, "compile_error": "cannot infer type parameter `A` of method `go`"}
