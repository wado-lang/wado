// Nothing answers `A`: it is written only in the closure's parameter, and the
// closure's body says nothing about it either. The call is where that is
// reported, and the message names the slot the reader would annotate — an
// inference variable is an internal identity, so `?0` names nothing the source
// wrote.
//
// A slot answered with itself is not answered. Left standing it would carry the
// declaration's own frame into codegen, where it died as an `unsubstituted
// TypeParam` panic rather than a diagnostic.

struct Counter {
    v: i32,
}

impl Counter {
    fn go<A: Default>(&self, f: fn(A) -> i32) -> i32 {
        return f(A::default());
    }
}

test "a parameter nothing answers is reported at the call" {
    let c = Counter { v: 1 };
    assert c.go(|a| 1) == 1;
}

__DATA__
{"test": {}, "compile_error": "cannot infer type parameter `A` of method `go`"}
