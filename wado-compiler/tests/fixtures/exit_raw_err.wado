// Raw Exit::exit(Err(())); the host maps Err(()) to 1 (ctor type args inferred).
use { println, Stdout } from "core:cli";
use { Exit } from "wasi:cli";

export fn run() with Stdout, Exit {
    println("before");
    Exit::exit(Result::Err(()));
}

__DATA__
{
    "stdout": "before\n",
    "exit_code": 1,
    "trapped": false
}
