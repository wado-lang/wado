// Test: Stream::read() compiles and handles closed writer (EOF)
// When the writer is closed before reading, read reports `Dropped` with no items.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let [rx, tx] = Stream::<u8>::new();

    // Close the writer so reader sees EOF
    tx.drop();

    // Read from the readable end - should report the writable end dropped
    let [rx, chunk] = rx.start_read(64).finish();
    assert chunk.items.len() == 0;
    assert chunk.result == CopyResult::Dropped;

    rx.drop();
    println("read ok");
}

__DATA__
{"stdout": "read ok\n"}
