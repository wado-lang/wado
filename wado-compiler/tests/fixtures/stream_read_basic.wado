// Test: Stream::read() compiles and handles closed writer (EOF)
// When the writer is closed before reading, read returns an empty array.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let [rx, tx] = Stream::<u8>::new();

    // Close the writer so reader sees EOF
    tx.drop();

    // Read from the readable end - should get empty (EOF since writer closed)
    let result = rx.read(64);
    assert result.len() == 0;

    rx.drop();
    println("read ok");
}

__DATA__
{"stdout": "read ok\n"}
