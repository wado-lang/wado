// A template's shape is its holes' types and specifiers, so two templates that
// differ only in their literal text or in how a hole is spelled are one type,
// and each value carries its own text.
use { println, Stdout } from "core:cli";

fn holes<T: ReflectTemplate<Holes = [..V]>, ..V>(t: T) -> T {
    return t;
}

fn pick<T>(first: bool, a: T, b: T) -> T {
    if first { return a; }
    return b;
}

fn as_written<T: ReflectTemplate<Holes = [..V]>, ..V>(t: T) -> String {
    let mut out = "";
    for let h of ReflectTemplate::<T>::members() {
        out.push_str(&h.raw(&t));
        h.fmt(&t, &mut Formatter::new(&mut out));
    }
    out.push_str(&ReflectTemplate::<T>::raw_tail(&t));
    return out;
}

export fn run() with Stdout {
    let a = builtin::black_box(1);
    let b = builtin::black_box(2);
    let t = pick(builtin::black_box(false), holes`x=${a}`, holes`y\t=${b}!`);
    println(String::format(t));
    println(as_written(t));
}

__DATA__
{"stdout": "y\t=2!\ny\\t=2!\n"}
