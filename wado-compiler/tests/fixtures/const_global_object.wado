// Constant Object Globalization: a constant-shaped struct or array global
// initializer is promoted to an eager Wasm constant by
// `wir_optimize::const_global`, instead of being assigned at runtime in
// `__initialize_module`.
//
// - `ORIGIN` (struct literal) lowers to a const `struct.new`.
// - `NUMS` (array literal) lowers to a const `struct.new` wrapping
//   `array.new_fixed`.
//   Both become immutable Wasm globals with an eager init, so the
//   `global:const_global_object.wado::ORIGIN = …` / `global:const_global_object.wado::NUMS = …` runtime assignments vanish from
//   `__initialize_module`.
// - `GREET` (short string, ≤ 8 bytes) is also eager: short strings get a
//   constant `array.new_fixed<u8>` repr (a valid Wasm constant instruction)
//   instead of a `array.new_data` data segment, so they promote too.
// - `BANNER` (longer string, > 8 bytes) stays lazy: it keeps the compact
//   `array.new_data<u8>` data-segment repr, which is not a valid Wasm constant
//   instruction, so it must be initialized at runtime. This locks the
//   short-string-eager threshold.

use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

global ORIGIN: Point = Point { x: 3, y: 4 };
global NUMS: List<i32> = [10, 20, 30];
global GREET: String = "hi";
global BANNER: String = "welcome to wado";

export fn run() with Stdout {
    // A scalar field read folds and leaves nothing behind, so `ORIGIN` is
    // inspected as a whole value to keep the global these expectations are
    // about alive.
    println(`${ORIGIN.x},${ORIGIN.y},${ORIGIN:?},${NUMS:?},${GREET},${BANNER}`);
}

__DATA__
{
    "stdout": "3,4,Point { x: 3, y: 4 },[10, 20, 30],hi,welcome to wado\n",
    "wir_expect:O2": [
        "global global:const_global_object.wado::ORIGIN",
        "global global:const_global_object.wado::NUMS",
        "array.new_fixed<i32>(10, 20, 30)",
        "global global:const_global_object.wado::GREET",
        "array.new_fixed<u8>(104, 105)",
        "global mut global:const_global_object.wado::BANNER"
    ],
    "wir_not_expect:O2": [
        "global mut global:const_global_object.wado::ORIGIN",
        "global mut global:const_global_object.wado::NUMS",
        "global mut global:const_global_object.wado::GREET"
    ]
}
