// Test i16 edge cases: min/max values and negative numbers
use { println, Stdout } from "core:cli";

fn run() with Stdout {
    // Max value: 32767
    let max: i16 = 32767 as i16;
    println(`max: {max}`);

    // Min value: -32768
    let min: i16 = -32768 as i16;
    println(`min: {min}`);

    // Negative arithmetic
    let neg: i16 = -5000 as i16;
    let pos: i16 = 3000 as i16;
    let sum = neg + pos;
    println(`neg + pos: {sum}`);

    // Negative division
    let div_result: i16 = -100 as i16 / 7 as i16;
    println(`-100 / 7: {div_result}`);

    // Negative modulo
    let mod_result: i16 = -100 as i16 % 7 as i16;
    println(`-100 % 7: {mod_result}`);
}

__DATA__
{"stdout": "max: 32767\nmin: -32768\nneg + pos: -2000\n-100 / 7: -14\n-100 % 7: -2\n"}
