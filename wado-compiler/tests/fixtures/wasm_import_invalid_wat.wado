// Importing a `.wat` whose contents fail `wat::parse_bytes` must surface
// as a compile error with a clear "failed to parse .wat" message — not
// as a downstream resolver / codegen failure.

use _ from "./sub/wasm_import_invalid.wat" with { type: "wat" };

export fn run() {}

__DATA__
{
    "compile_error": "failed to parse .wat"
}
