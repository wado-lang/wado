enum Color {
    Red,
    Green,
    Blue,
}

fn describe(c: Color) -> String {
    return match c {
        Red | Blue => "cool",
        Green => "warm",
    };
}

export fn run() {
    assert describe(Color::Red) == "cool";
    assert describe(Color::Blue) == "cool";
    assert describe(Color::Green) == "warm";
}

