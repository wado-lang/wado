// A method reached through a type parameter's bound requires what the trait
// method declares. The impl is not known at the call, so `draw` carries the
// effect itself or the call is reported.
use { println, Stdout } from "core:cli";

trait Source with () {
    fn next(&mut self) -> i32 with Stdout;
}

struct Loud {
    n: i32,
}

impl Source for Loud {
    fn next(&mut self) -> i32 with Stdout {
        println("tick");
        self.n += 1;
        return self.n;
    }
}

fn draw<S: Source>(s: &mut S) -> i32 {
    return s.next();
}

export fn run() with Stdout {
    let mut loud = Loud { n: 0 };
    println(`${draw(&mut loud)}`);
}

