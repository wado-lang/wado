// Test: importing variant type from another module
use { Color } from "./variant_import_module.wado";
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let c = Color::Red;
    if c matches { Red } {
        println("red");
    } else {
        println("not red");
    }
}

__DATA__
{"stdout": "red\n"}
