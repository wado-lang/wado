


// from bitwise_shift.wado
fn bitwise_shift() with Stdout {
    let a = 1;
    let left_shift = a << 3;  // 1 * 8 = 8
    let right_shift = 16 >> 2;  // 16 / 4 = 4

    assert left_shift == 8;
    assert right_shift == 4;
}

// from bitwise_shift_i64_by_i32.wado
fn bitwise_shift_i64_by_i32() with Stdout {
    // u64 << literal (literal coerced to u64)
    let x: u64 = 1;
    let result = x << 11;
    assert result == 2048;

    // u64 >> literal
    let y: u64 = 2048;
    let result2 = y >> 11;
    assert result2 == 1;

    // i64 << literal
    let z: i64 = 1 as i64;
    let result3 = z << 11;
    assert result3 == 2048 as i64;

    // i64 >> literal
    let w: i64 = 2048 as i64;
    let result4 = w >> 11;
    assert result4 == 1 as i64;

    // u64 << u64 variable (same type)
    let shift_amt: u64 = 5;
    let v: u64 = 1;
    let shifted = v << shift_amt;
    assert shifted == 32;
}

export fn run() with Stdout {
    bitwise_shift();
    bitwise_shift_i64_by_i32();
}

__DATA__
{"stdout": ""}
