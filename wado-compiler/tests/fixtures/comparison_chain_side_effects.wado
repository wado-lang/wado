// `a < b < c` desugars to `let $m0 = a; let $m1 = b; ($m0 < $m1) & ($m1 < c)`,
// so every term is evaluated exactly once, left to right — verified by
// side-effect counts and by the order the terms print in.

use { println, Stdout } from "core:cli";

global mut CALL_COUNT: i32 = 0;

fn counted(value: i32) -> i32 {
    CALL_COUNT = CALL_COUNT + 1;
    return value;
}

fn v(n: i32) -> i32 with Stdout {
    println(`eval ${n}`);
    return n;
}

export fn run() with Stdout {
    // One middle term: must be evaluated once.
    assert 0 < counted(5) < 10;
    println(`${CALL_COUNT}`);

    // Two middle terms: each must be evaluated once.
    CALL_COUNT = 0;
    assert 0 < counted(3) < counted(7) < 10;
    println(`${CALL_COUNT}`);

    let r = v(3) < v(1) < v(2);
    println(`${r}`);
    let s = v(1) < v(2) < v(3) < v(4);
    println(`${s}`);
    let t = v(5) == v(6) == v(7);
    println(`${t}`);
}

__DATA__
{"stdout": "1\n2\neval 3\neval 1\neval 2\nfalse\neval 1\neval 2\neval 3\neval 4\ntrue\neval 5\neval 6\neval 7\nfalse\n"}
