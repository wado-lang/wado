// A typed element of a sequence literal decides an open element type, and a
// numeric literal element answers last, so `[1, "abc"]` is a `List<String>`
// with `1` reported against it. Reading the element type afresh each round is
// what makes the decision stick — left as the variable it was before an element
// solved it, every element defers and `[1, "abc"]` passes, then traps codegen.

fn second<T>(xs: List<T>) -> T {
    return xs[1];
}

export fn run() {
    let x = second([1, "abc"]);
}

