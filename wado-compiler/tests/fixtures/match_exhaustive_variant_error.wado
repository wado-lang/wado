// Test: Non-exhaustive match on variant should produce a compile error
use { println, Stdout } from "core:cli";

variant Shape {
    Circle(f64),
    Rectangle([f64, f64]),
    Point,
}

export fn run() with Stdout {
    let s = Shape::Point;
    let desc = match s {
        Circle(r) => `circle ${r}`,
        Point => "point",
        // Missing Rectangle arm
    };
    println(desc);
}

__DATA__
{"compile_error": "missing case `Rectangle`"}
