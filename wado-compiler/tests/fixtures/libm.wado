// Test libm math functions from wado-bundled

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Test trigonometric functions (f64)
    let pi = 3.14159265358979323846;
    let half_pi = pi / 2.0;

    // sin(0) = 0, sin(pi/2) ≈ 1
    let sin_0 = builtin::f64_sin(0.0);
    let sin_half_pi = builtin::f64_sin(half_pi);
    assert sin_0 == 0.0, "sin(0) should be 0";
    assert sin_half_pi > 0.99 && sin_half_pi < 1.01, "sin(pi/2) should be ~1";

    // cos(0) = 1, cos(pi/2) ≈ 0
    let cos_0 = builtin::f64_cos(0.0);
    let cos_half_pi = builtin::f64_cos(half_pi);
    assert cos_0 == 1.0, "cos(0) should be 1";
    assert cos_half_pi > -0.01 && cos_half_pi < 0.01, "cos(pi/2) should be ~0";

    // tan(0) = 0
    let tan_0 = builtin::f64_tan(0.0);
    assert tan_0 == 0.0, "tan(0) should be 0";

    // asin(0) = 0, asin(1) = pi/2
    let asin_0 = builtin::f64_asin(0.0);
    let asin_1 = builtin::f64_asin(1.0);
    assert asin_0 == 0.0, "asin(0) should be 0";
    assert asin_1 > 1.57 && asin_1 < 1.58, "asin(1) should be ~pi/2";

    // acos(1) = 0, acos(0) = pi/2
    let acos_1 = builtin::f64_acos(1.0);
    let acos_0 = builtin::f64_acos(0.0);
    assert acos_1 == 0.0, "acos(1) should be 0";
    assert acos_0 > 1.57 && acos_0 < 1.58, "acos(0) should be ~pi/2";

    // atan(0) = 0, atan(1) = pi/4
    let atan_0 = builtin::f64_atan(0.0);
    let atan_1 = builtin::f64_atan(1.0);
    assert atan_0 == 0.0, "atan(0) should be 0";
    assert atan_1 > 0.78 && atan_1 < 0.79, "atan(1) should be ~pi/4";

    // atan2(1, 1) = pi/4
    let atan2_result = builtin::f64_atan2(1.0, 1.0);
    assert atan2_result > 0.78 && atan2_result < 0.79, "atan2(1,1) should be ~pi/4";

    // Test hyperbolic functions (f64)
    // sinh(0) = 0, cosh(0) = 1, tanh(0) = 0
    let sinh_0 = builtin::f64_sinh(0.0);
    let cosh_0 = builtin::f64_cosh(0.0);
    let tanh_0 = builtin::f64_tanh(0.0);
    assert sinh_0 == 0.0, "sinh(0) should be 0";
    assert cosh_0 == 1.0, "cosh(0) should be 1";
    assert tanh_0 == 0.0, "tanh(0) should be 0";

    // asinh(0) = 0, acosh(1) = 0, atanh(0) = 0
    let asinh_0 = builtin::f64_asinh(0.0);
    let acosh_1 = builtin::f64_acosh(1.0);
    let atanh_0 = builtin::f64_atanh(0.0);
    assert asinh_0 == 0.0, "asinh(0) should be 0";
    assert acosh_1 == 0.0, "acosh(1) should be 0";
    assert atanh_0 == 0.0, "atanh(0) should be 0";

    // Test exponential and logarithmic functions (f64)
    // exp(0) = 1, exp(1) ≈ e ≈ 2.718
    let exp_0 = builtin::f64_exp(0.0);
    let exp_1 = builtin::f64_exp(1.0);
    assert exp_0 == 1.0, "exp(0) should be 1";
    assert exp_1 > 2.71 && exp_1 < 2.72, "exp(1) should be ~e";

    // exp2(0) = 1, exp2(3) = 8
    let exp2_0 = builtin::f64_exp2(0.0);
    let exp2_3 = builtin::f64_exp2(3.0);
    assert exp2_0 == 1.0, "exp2(0) should be 1";
    assert exp2_3 == 8.0, "exp2(3) should be 8";

    // expm1(0) = 0
    let expm1_0 = builtin::f64_expm1(0.0);
    assert expm1_0 == 0.0, "expm1(0) should be 0";

    // ln(1) = 0, ln(e) ≈ 1
    let ln_1 = builtin::f64_ln(1.0);
    let e = 2.718281828459045;
    let ln_e = builtin::f64_ln(e);
    assert ln_1 == 0.0, "ln(1) should be 0";
    assert ln_e > 0.99 && ln_e < 1.01, "ln(e) should be ~1";

    // log2(1) = 0, log2(8) = 3
    let log2_1 = builtin::f64_log2(1.0);
    let log2_8 = builtin::f64_log2(8.0);
    assert log2_1 == 0.0, "log2(1) should be 0";
    assert log2_8 == 3.0, "log2(8) should be 3";

    // log10(1) = 0, log10(100) = 2
    let log10_1 = builtin::f64_log10(1.0);
    let log10_100 = builtin::f64_log10(100.0);
    assert log10_1 == 0.0, "log10(1) should be 0";
    assert log10_100 == 2.0, "log10(100) should be 2";

    // ln1p(0) = 0
    let ln1p_0 = builtin::f64_ln1p(0.0);
    assert ln1p_0 == 0.0, "ln1p(0) should be 0";

    // Test power functions (f64)
    // pow(2, 3) = 8
    let pow_2_3 = builtin::f64_pow(2.0, 3.0);
    assert pow_2_3 == 8.0, "pow(2,3) should be 8";

    // cbrt(8) = 2, cbrt(27) = 3
    let cbrt_8 = builtin::f64_cbrt(8.0);
    let cbrt_27 = builtin::f64_cbrt(27.0);
    assert cbrt_8 == 2.0, "cbrt(8) should be 2";
    assert cbrt_27 == 3.0, "cbrt(27) should be 3";

    // hypot(3, 4) = 5
    let hypot_3_4 = builtin::f64_hypot(3.0, 4.0);
    assert hypot_3_4 == 5.0, "hypot(3,4) should be 5";

    // fmod(7, 3) = 1
    let fmod_7_3 = builtin::f64_fmod(7.0, 3.0);
    assert fmod_7_3 == 1.0, "fmod(7,3) should be 1";

    // Test f32 variants
    let sin_f32 = builtin::f32_sin(0.0 as f32);
    assert sin_f32 == 0.0 as f32, "sinf(0) should be 0";

    let cos_f32 = builtin::f32_cos(0.0 as f32);
    assert cos_f32 == 1.0 as f32, "cosf(0) should be 1";

    let exp_f32 = builtin::f32_exp(0.0 as f32);
    assert exp_f32 == 1.0 as f32, "expf(0) should be 1";

    let ln_f32 = builtin::f32_ln(1.0 as f32);
    assert ln_f32 == 0.0 as f32, "lnf(1) should be 0";

    let pow_f32 = builtin::f32_pow(2.0 as f32, 3.0 as f32);
    assert pow_f32 == 8.0 as f32, "powf(2,3) should be 8";

    println("All libm tests passed!");
}

__DATA__
{"stdout": "All libm tests passed!\n"}
