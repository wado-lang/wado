// SROA scalarizes `Point` into i32 locals, so the copy disappears and there is
// nothing to remark on. `black_box` keeps the template off the constant-fold
// path, which a fully literal one reaches and the const-region remark reports
// on its own axis.

use { println, Stdout } from "core:cli";

struct Point { x: i32, y: i32 }

export fn run() with Stdout {
    let a = Point { x: builtin::black_box(1), y: 2 };
    let mut b = a;
    b.x = 9;
    println(`${a.x} ${b.x}`);
}

__DATA__
{
    "stdout": "1 9\n",
    "remarks": {"O2": [{"contains": ["remark:"], "count": 0}]}
}
