// Assert captures a template string literal, rendering its value as a
// sub-value of a `` `${...}` == "..." `` condition.

export fn run() {
    let m = 100.5;
    let name = "wado";
    assert `${m} ${name}` == "nope";
}

__DATA__
{
    "trapped": true,
    "stderr_contains": [
        "condition: `${m} ${name}` == \"nope\"",
        "`${m} ${name}`: \"100.5 wado\""
    ]
}
