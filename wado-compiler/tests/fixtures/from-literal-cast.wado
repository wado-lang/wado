// KeyValueLiteral: explicit cast to custom type
use { println } from "core:cli";

struct PairList<V> {
    keys: Array<String>,
    values: Array<V>,
}

impl PairList<V> {
    fn new() -> PairList<V> {
        return PairList { keys: [], values: [] };
    }

    fn len(&self) -> i32 {
        return self.keys.len();
    }
}

impl KeyValueLiteralBuilder for PairList<V> {
    type Value = V;
    type Output = PairList<V>;

    fn new_literal(capacity: i32) -> PairList<V> {
        return PairList::<V>::new();
    }

    fn insert_literal(&mut self, key: String, value: Self::Value) {
        self.keys.push(key);
        self.values.push(value);
    }

    fn build(&self) -> PairList<V> {
        return *self;
    }
}

export fn run() with Stdout {
    // Explicit cast coercion
    let m = { name: "Alice", city: "Tokyo" } as PairList<String>;

    assert m.len() == 2;
    assert m.keys[0] == "name";
    assert m.keys[1] == "city";
    assert m.values[0] == "Alice";
    assert m.values[1] == "Tokyo";

    println("cast KeyValueLiteral: ok");
}

__DATA__
{"stdout": "cast KeyValueLiteral: ok\n"}
