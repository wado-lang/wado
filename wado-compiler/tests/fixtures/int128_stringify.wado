use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // u128 stringify via template
    let a: u128 = 12345;
    println(`u128 value: {a}`);

    // i128 stringify via template
    let b: i128 = 42;
    println(`i128 value: {b}`);

    // i128 negative stringify
    let c: i128 = -9876;
    println(`i128 negative: {c}`);

    // Direct to_string call
    let d: u128 = 100;
    println(d.to_string());

    let e: i128 = -200;
    println(e.to_string());

    println("All stringify tests passed!");
}

__DATA__
{"stdout": "u128 value: 12345\ni128 value: 42\ni128 negative: -9876\n100\n-200\nAll stringify tests passed!\n"}
