// Test: same-scope shadowing is allowed when RHS references the variable

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let x = 1;
    let x = x + 1;
    println(`${x}`);

    let y = "hello";
    let y = `${y} world`;
    println(`${y}`);
}

__DATA__
{"stdout": "2\nhello world\n"}
