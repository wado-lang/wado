#![TODO]
// Two traits' blankets share a method name and both apply. Both traits are
// declared here, so scope leaves both and the tie is real: a blanket joins the
// cross-trait collision like any other candidate, and `Alpha::describe(&p)` is
// the escape. Today the cross-trait count skips blankets, so collection order
// picks (WEP 2026-09-01, "Two traits' blankets sharing a method name are not
// reported").

trait Limit {
    fn limit() -> i32;
}

trait Alpha {
    fn describe(&self) -> String;
}

trait Beta {
    fn describe(&self) -> String;
}

struct Point {
    x: i32,
}

impl Limit for Point {
    fn limit() -> i32 {
        return 7;
    }
}

impl<T: Limit> Alpha for T {
    fn describe(&self) -> String {
        return "alpha";
    }
}

impl<T: Limit> Beta for T {
    fn describe(&self) -> String {
        return "beta";
    }
}

export fn run() {
    let p = Point { x: 1 };
    assert p.describe() == "alpha";
}

__DATA__
{"compile_error": "ambiguous method 'describe'"}
