// copy_prop must collapse a single-use `&mut place` ref temp into its use when
// the root is only mutated *after* that use. Here `xs[i] = …` inlines to
// `let r = &mut xs.repr; array_set(r, i, v)`, and the root `xs` is next mutated
// by the recursive `fill` call — after the store. The store's receiver must
// end up as `xs.repr` inline, not a `&mut xs.repr` ref-temp binding. The
// recursion keeps `fill` from being inlined away.
use { println, Stdout } from "core:cli";

fn fill(xs: &mut List<i32>, i: i32) {
    if i < 0 {
        return;
    }
    xs[i] = i * 2;
    fill(xs, i - 1);
}

export fn run() with Stdout {
    let mut xs: List<i32> = [0, 0, 0, 0];
    fill(&mut xs, 3);
    println(`${xs[3]}`);
}

__DATA__
{
    "stdout": "6\n",
    "wir_expect:O2": ["array_set<i32>(xs.repr, i,"],
    "wir_not_expect:O2": ["= &mut xs.repr"]
}
