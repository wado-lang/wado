// Blanket derivation over ReflectFlags (WEP 2026-06-13 §3c): one derivation
// covers every flags type — the bound `Members = [..B]` sources the member
// tuple's arity, so serialization walks members() keeping the set bits by name
// (`FlagBit::is_set` / `name`); deserialization goes through from_bits.

trait BitNames {
    fn bit_names(&self) -> String;
    fn from_raw(raw: u64) -> Option<Self>;
}

impl<T: ReflectFlags<Members = [..B]>, ..B> BitNames for T {
    fn bit_names(&self) -> String {
        let mut out = "";
        for let b of ReflectFlags::<T>::members() {
            if b.is_set(self) {
                if out != "" {
                    out = `${out}|`;
                }
                out = `${out}${b.name()}`;
            }
        }
        return out;
    }

    fn from_raw(raw: u64) -> Option<T> {
        return ReflectFlags::<T>::from_bits(raw);
    }
}

fn parse_flags<T: BitNames>(raw: u64) -> Option<T> {
    return T::from_raw(raw);
}

flags Perms {
    Read,
    Write,
    Execute,
}

test "bit_names walks the set bits" {
    let rx = Perms::Read | Perms::Execute;
    assert rx.bit_names() == "Read|Execute";
}

test "from_raw derives through the bound" {
    assert parse_flags::<Perms>(3) matches { Some(p) && p as u32 == 3 };
    assert parse_flags::<Perms>(9) matches { None };
}

__DATA__
{"test": {}}
