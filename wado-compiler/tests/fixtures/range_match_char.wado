// Range patterns with char types
use { println, Stdout } from "core:cli";

fn classify_char(c: char) -> String {
    return match c {
        'a'..='z' => "lowercase",
        'A'..='Z' => "uppercase",
        '0'..='9' => "digit",
        _ => "other",
    };
}

export fn run() with Stdout {
    println(classify_char('h'));
    println(classify_char('Z'));
    println(classify_char('5'));
    println(classify_char('!'));
}

__DATA__
{"stdout": "lowercase\nuppercase\ndigit\nother\n"}
