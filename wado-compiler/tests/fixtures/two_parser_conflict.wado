//! Regression test (issue #1416): two independent modules that each define a
//! same-named type (here `CstNode` / `CstChild`, as every Gale-generated parser
//! does) coexist in one program. Matching module B's `CstChild::Node` case must
//! bind a value typed as B's `CstNode`, not A's same-named struct.
//!
//! The bug: pattern resolution discarded the scrutinee's `module_source` and
//! re-looked-up the variant by bare name, so the global-scan fallback picked
//! A's first-registered `CstChild`. Fixed by keying the lookup on
//! (name, module_source) — the type the scrutinee already carries.

use a from "./sub/two_parser_a.wado";
use b from "./sub/two_parser_b.wado";

fn count_b(node: &b::CstNode) -> i32 {
    let mut n = 0;
    for let child of &node.children {
        if let Node(c) = *child {
            n += count_b(&c);
        } else {
            n += 1;
        }
    }
    return n;
}

test "two parsers with same-named types coexist" {
    let _ = a::root();
    assert count_b(&b::root()) == 0;
}
