use { println, Stdout } from "core:cli";

// from display_format_base.wado
fn fmt_with(value: &i32, sign_plus: bool, zero_pad: bool, width: i32, align: Alignment) -> String {
    let mut buf = String::with_capacity(64);
    let fill = if zero_pad {
        '0';
    } else {
        ' ';
    };
    let mut f = Formatter {
        fill,
        align,
        sign_plus,
        zero_pad,
        width,
        precision: -1,
        indent: 0,
        buf: &mut buf,
    };
    value.fmt(&mut f);
    return buf;
}

// from display_format_padding.wado
fn fmt_int(value: &i32, fill: char, align: Alignment, sign_plus: bool, zero_pad: bool, width: i32) -> String {
    let mut buf = String::with_capacity(64);
    let mut f = Formatter {
        fill,
        align,
        sign_plus,
        zero_pad,
        width,
        precision: -1,
        indent: 0,
        buf: &mut buf,
    };
    value.fmt(&mut f);
    return buf;
}

// from display_format_base.wado
fn display_format_base() with Stdout {
    let x: i32 = 42;
    let neg: i32 = -42;

    // sign_plus
    assert fmt_with(&x, true, false, -1, Alignment::Right) == "+42";

    // negative with sign_plus
    assert fmt_with(&neg, true, false, -1, Alignment::Right) == "-42";

    // zero-padded with sign_plus
    assert fmt_with(&x, true, true, 8, Alignment::Right) == "+0000042";

    // zero-padded negative
    assert fmt_with(&neg, false, true, 8, Alignment::Right) == "-0000042";

    // right-aligned with width and sign_plus
    assert fmt_with(&x, true, false, 10, Alignment::Right) == "       +42";

    // left-aligned negative with width
    assert fmt_with(&neg, false, false, 10, Alignment::Left) == "-42       ";

    println("ok");
}

// from display_format_padding.wado
fn display_format_padding() with Stdout {
    let x: i32 = 42;
    let neg: i32 = -42;
    let big: i32 = 12345;

    // Right-aligned integer with width
    assert fmt_int(&x, ' ', Alignment::Right, false, false, 10) == "        42";

    // Left-aligned integer with width
    assert fmt_int(&x, ' ', Alignment::Left, false, false, 10) == "42        ";

    // Center-aligned integer with width
    assert fmt_int(&x, ' ', Alignment::Center, false, false, 10) == "    42    ";

    // Zero-padded integer
    assert fmt_int(&x, '0', Alignment::Right, false, true, 8) == "00000042";

    // Zero-padded negative integer
    assert fmt_int(&neg, '0', Alignment::Right, false, true, 8) == "-0000042";

    // Sign plus
    assert fmt_int(&x, ' ', Alignment::Right, true, false, -1) == "+42";

    // Custom fill char
    assert fmt_int(&x, '*', Alignment::Center, false, false, 10) == "****42****";

    // Bool with width
    let mut buf = String::with_capacity(64);
    let mut f = Formatter {
        fill: ' ',
        align: Alignment::Left,
        sign_plus: false,
        zero_pad: false,
        width: 8,
        precision: -1,
        indent: 0,
        buf: &mut buf,
    };
    true.fmt(&mut f);
    assert buf == "true    ";

    // No width (content wider than width)
    assert fmt_int(&big, ' ', Alignment::Right, false, false, 2) == "12345";

    println("ok");
}

export fn run() with Stdout {
    display_format_base();
    display_format_padding();
}

__DATA__
{"stdout": "ok\nok\n"}
