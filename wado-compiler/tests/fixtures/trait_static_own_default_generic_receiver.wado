//! A method-level slot the arguments do not pin takes the default its
//! declaration wrote, whether or not the block declares slots of its own. The
//! own-slot inference solved only from the arguments, so `M::made()` took the
//! default and `Box2::<i32>::made()` — the same declaration, on a block that
//! declares a slot — was rejected with "spell it".

struct Tag {}
struct Box2<T> { v: T }
struct M {}

trait Named {
    fn name() -> String;
}

impl Named for Tag {
    fn name() -> String { return "tag"; }
}

trait Made {
    fn made<U: Named = Tag>() -> String;
}

impl<T> Made for Box2<T> {
    fn made<U: Named>() -> String { return U::name(); }
}

impl Made for M {
    fn made<U: Named>() -> String { return U::name(); }
}

test "non-generic receiver takes the trait's default" {
    assert M::made() == "tag";
}

test "generic receiver takes it too" {
    assert Box2::<i32>::made() == "tag";
}

__DATA__
{"test": {}}
