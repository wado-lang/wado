// MiniDict - A minimal dictionary implementation using linear search
// Tests generic structs with tuple array fields: List<[K, V]>

use { println, Stdout } from "core:cli";

// MiniDict uses an array of [K, V] tuples for entries
struct MiniDict<K, V> {
    entries: List<[K, V]>,
}

impl<K, V> MiniDict<K, V> {
    fn new() -> MiniDict<K, V> {
        return MiniDict {
            entries: [],
        };
    }

    fn set(&mut self, key: K, value: V) {
        // Linear search for existing key using C-style for
        for let mut i = 0; i < self.entries.len(); i += 1 {
            if self.entries[i].0 == key {
                // Update existing value
                self.entries[i] = [key, value];
                return;
            }
        }
        // Key not found, append new entry
        self.entries.push([key, value]);
    }

    fn get(&self, key: K) -> Option<V> {
        // Linear search for key using C-style for
        for let mut i = 0; i < self.entries.len(); i += 1 {
            if self.entries[i].0 == key {
                return Option::<V>::Some(self.entries[i].1);
            }
        }
        return null;
    }

    fn has(&self, key: K) -> bool {
        for let mut i = 0; i < self.entries.len(); i += 1 {
            if self.entries[i].0 == key {
                return true;
            }
        }
        return false;
    }

    fn remove(&mut self, key: K) -> bool {
        for let mut i = 0; i < self.entries.len(); i += 1 {
            if self.entries[i].0 == key {
                // Found the key - remove by shifting elements
                for let mut j = i; j < self.entries.len() - 1; j += 1 {
                    self.entries[j] = self.entries[j + 1];
                }
                // Remove last element (now duplicated)
                // Note: List doesn't have pop() yet, so this is incomplete
                return true;
            }
        }
        return false;
    }

    fn size(&self) -> i32 {
        return self.entries.len();
    }
}

export fn run() with Stdout {
    let mut dict = MiniDict::<String, String>::new();

    // Test basic set and get
    dict.set("name", "Wado");
    dict.set("type", "language");
    dict.set("target", "WebAssembly");

    if let Some(name_val) = dict.get("name") {
        println(`name: {name_val}`);
    }

    if let Some(type_val) = dict.get("type") {
        println(`type: {type_val}`);
    }

    // Test updating existing key
    dict.set("name", "Wado Language");
    if let Some(updated_val) = dict.get("name") {
        println(`updated name: {updated_val}`);
    }

    // Test has()
    println(`has 'target': {dict.has("target")}`);
    println(`has 'version': {dict.has("version")}`);

    // Test size
    println(`size: {dict.size()}`);

    // Test missing key
    if let None = dict.get("missing") {
        println("missing key returned None");
    }
}

__DATA__
{
  "stdout": "name: Wado\ntype: language\nupdated name: Wado Language\nhas 'target': true\nhas 'version': false\nsize: 3\nmissing key returned None\n"
}
