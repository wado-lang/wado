// A store to a dead global whose value calls a builtin that fails its `#[trap]`
// check traps, and the trap is observable: the call stays although nothing
// reads the global.
use { println, Stdout } from "core:cli";

global mut BYTES: Array<u8> = builtin::array_new::<u8>(0);

export fn run() with Stdout {
    BYTES = builtin::array_new::<u8>(builtin::black_box(-1));
    println("unreachable");
}

__DATA__
{
    "trapped": true
}
