// Test float literal coercion in let statements with type annotations
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Float literals should coerce to both f32 and f64
    let a: f32 = 3.14;
    let b: f64 = 2.718;

    println(`f32: ${a}`);
    println(`f64: ${b}`);
}

__DATA__
{"stdout_contains": ["f32: 3.14", "f64: 2.718"]}
