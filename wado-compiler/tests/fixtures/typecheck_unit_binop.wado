// Every operator on `()` dispatches through a trait, and there is no
// `impl Add for ()`, so `() + ()` is a type error rather than a codegen
// failure. `==` and `<` have impls: `trait_unit_eq_ord.wado`.
fn nothing() {}

export fn run() {
    let _ = nothing() + nothing();
}

