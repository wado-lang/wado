// Test match expression with u8 literal patterns

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let x: u8 = 42 as u8;
    let y: u8 = 0 as u8;
    let max: u8 = 255 as u8;

    let r1 = match x {
        0 => "zero",
        42 => "answer",
        _ => "other",
    };
    println(r1);

    let r2 = match y {
        0 => "zero",
        _ => "other",
    };
    println(r2);

    let r3 = match max {
        0 => "zero",
        255 => "max u8",
        _ => "other",
    };
    println(r3);
}

__DATA__
{"stdout": "answer\nzero\nmax u8\n"}
