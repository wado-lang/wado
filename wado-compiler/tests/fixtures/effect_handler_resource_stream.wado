// Bundled-form handler for `Stream<u8>` + `StreamWritable<u8>`, per
// WEP-2026-04-11-effect-handler.md.
//
// `MockStream` implements both ends of the CM stream pair against a
// single shared `log` buffer; the bundled `with &mut s do` form
// installs both handlers at once for the duration of the `do` block.
// Inside the block, `Stream::<u8>::new()` / `tx.write_raw_all(payload)` /
// `tx.drop()` / `rx.drop()` all dispatch through
// the per-monomorphisation `$effect_dispatch__<module>/Stream<u8>__*` /
// `$effect_dispatch__<module>/StreamWritable<u8>__*` wrappers into
// `MockStream`'s methods rather than the CM canonical
// `stream-{new,write,drop-*}` intrinsics.

use { println, Stdout } from "core:cli";

struct MockStream {
    log: List<u8>,
    drops: i32,
}

impl Stream<u8> for MockStream {
    fn new(&mut self) -> [Stream<u8>, StreamWritable<u8>] {
        // A real pair, which the outer dispatch chain makes, since an integer
        // converts to no resource.
        resume Stream::<u8>::new()
    }
    fn drop(&mut self, this: &Stream<u8>) {
        let _ = this;
        self.drops += 1;
        resume ()
    }
    ..trap
}

impl StreamWritable<u8> for MockStream {
    fn write_raw_all(&mut self, this: &StreamWritable<u8>, data: Slice<u8>) -> CopyResult {
        let _ = this;
        for let b of data {
            self.log.push(b);
        }
        resume CopyResult::Completed
    }
    fn drop(&mut self, this: &StreamWritable<u8>) {
        let _ = this;
        self.drops += 1;
        resume ()
    }
    ..trap
}

export fn run() with Stdout {
    let mut s = MockStream { log: [], drops: 0 };
    with &mut s do {
        let [rx, tx] = Stream::<u8>::new();
        let payload: List<u8> = [104 as u8, 105 as u8]; // "hi"
        assert tx.write_raw_all(payload.as_slice()) == CopyResult::Completed;
        tx.drop();
        rx.drop();
    }
    println(`logged=${s.log.len()} drops=${s.drops}`);
}

__DATA__
{"stdout_contains": ["logged=2 drops=2"]}
