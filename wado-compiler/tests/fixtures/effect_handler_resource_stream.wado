// TDD red: bundled-form handler for Stream<u8> + StreamWritable<u8>.
//
// Per WEP-2026-04-11-effect-handler.md, a single MockCM-style struct
// can implement both ends of the CM stream pair, and the bundled
// handler form `with &mut s do` installs both at once.
//
// Until generic-resource handler dispatch lands, this test is
// expected to fail. The implementation gaps tracked in the WEP are:
//
//   1. The resolver records `MethodInfo::trait_name` as the full
//      mangled form (e.g. "Stream<u8>") for generic-resource impls,
//      but `resource_decl_index` and the dispatch-synthesis
//      `build_handler_impl_index` look it up by bare base name
//      ("Stream"). The lookup misses, `resume` is rejected by the
//      resolver, and the WithHandler reaches `lower_pre_boxing` un-
//      desugared.
//   2. Generic resources need per-monomorphisation dispatch
//      infrastructure: one `__Dispatch_Stream__u8` /
//      `__effect_Stream__u8` / `__effect_dispatch__Stream__u8__op`
//      triple per type-arg combination, with the resource's
//      operations' types substituted for that combination.
//   3. `Stream<T>` operations declared with the `&self` shorthand
//      have their receiver param filtered out by
//      `Resolver::resolve_effect_ops`, so the synthesised wrapper
//      signature today doesn't include the receiver — needed to
//      forward to `cm_stream_*` / `CmRawCall`.
//   4. Stream/Future call sites bypass the `__cm_binding__<R>_<op>`
//      adapter shape that today's call-site rewriter intercepts —
//      they lower instead to `CmRawCall { local_name: "stream-..." }`,
//      to internal binding functions like `__cm_stream_read_u8` /
//      `__cm_stream_write_u8`, or to WIR translate-phase intrinsics
//      (`stream-new`, `future-new`). The dispatch synthesis must
//      recognise and rewrite all three shapes for handlers to
//      intercept Stream/Future at all.
//
// Once those four gaps are closed, drop the `compile_error` field
// below and assert the buffered round-trip via `bytes_buffered=0`.

use { println, Stdout } from "core:cli";

struct MockStream {
    log: Array<u8>,
}

impl Stream<u8> for MockStream {
    fn new(&mut self) -> [Stream<u8>, StreamWritable<u8>] {
        // Hand out a fake handle pair. Both ends of this single
        // stream share the MockStream's `log` buffer, so the
        // writable end's writes are observed by the readable end's
        // reads — buffered semantics, unlike wasmtime's unbuffered
        // canonical streams.
        let id: i32 = 0;
        resume [id as Stream<u8>, id as StreamWritable<u8>]
    }
    fn read(&mut self, this: &Stream<u8>, max: i32) -> Array<u8> {
        let _ = this;
        let _ = max;
        let snapshot = self.log;
        self.log = [];
        resume snapshot
    }
    fn drop(&mut self, this: &Stream<u8>) {
        let _ = this;
        resume ()
    }
    ..
}

impl StreamWritable<u8> for MockStream {
    fn write(&mut self, this: &StreamWritable<u8>, data: Array<u8>) {
        let _ = this;
        for let b of data {
            self.log.push(b);
        }
        resume ()
    }
    fn drop(&mut self, this: &StreamWritable<u8>) {
        let _ = this;
        resume ()
    }
    ..
}

export fn run() with Stdout {
    let mut s = MockStream { log: [] };
    with &mut s do {
        let [rx, tx] = Stream::<u8>::new();
        let payload: Array<u8> = [104 as u8, 105 as u8]; // "hi"
        tx.write(payload);
        let got = rx.read(16);
        assert got.len() == 2;
        assert got[0] == 104 as u8;
        assert got[1] == 105 as u8;
        tx.drop();
        rx.drop();
    }
    println(`bytes_buffered={s.log.len()}`);
}

__DATA__
{"compile_error": "`resume` is only valid inside an effect handler method body"}
