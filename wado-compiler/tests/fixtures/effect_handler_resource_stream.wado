// TDD red: bundled-form handler for Stream<u8> + StreamWritable<u8>.
//
// Per WEP-2026-04-11-effect-handler.md, a single MockCM-style struct
// can implement both ends of the CM stream pair, and the bundled
// handler form `with &mut s do` installs both at once.
//
// Status: Gaps 1 (base-trait-name lookup), 2 (per-monomorph
// dispatch infra), and 3 (`&self` receiver in the wrapper signature)
// are closed in this branch. One gap remains before this fixture
// flips green; see WEP-2026-04-11 for the full list. The current
// failure surfaces in WIR build at the `tx.write(payload)` call
// site:
//
//   panic at wado-compiler/src/wir_build/canonical_abi.rs:187:
//     [WIR] unhandled canonical method: stream-write
//
// — i.e. the synthesised `__effect_dispatch__Stream<u8>__write`
// wrapper exists with the right `(self: &StreamWritable<u8>, data:
// Array<u8>)` signature, but the user call `tx.write(payload)`
// lowers through the CM canonical-method translator
// (`stream-write`) rather than the `__cm_binding__Stream_write`
// adapter shape that today's dispatch call-site rewriter
// intercepts. Gap 4 closes this: the dispatch synthesis must
// recognise and rewrite `CmRawCall { local_name: "stream-..." }`
// and `__cm_stream_*` internal binding calls in addition to the
// existing `__cm_binding__<R>_<op>` form.

use { println, Stdout } from "core:cli";

struct MockStream {
    log: Array<u8>,
}

impl Stream<u8> for MockStream {
    fn new(&mut self) -> [Stream<u8>, StreamWritable<u8>] {
        // Hand out a fake handle pair. Both ends of this single
        // stream share the MockStream's `log` buffer, so the
        // writable end's writes are observed by the readable end's
        // reads — buffered semantics, unlike wasmtime's unbuffered
        // canonical streams.
        let id: i32 = 0;
        resume [id as Stream<u8>, id as StreamWritable<u8>]
    }
    fn read(&mut self, this: &Stream<u8>, max: i32) -> Array<u8> {
        let _ = this;
        let _ = max;
        let snapshot = self.log;
        self.log = [];
        resume snapshot
    }
    fn drop(&mut self, this: &Stream<u8>) {
        let _ = this;
        resume ()
    }
    ..
}

impl StreamWritable<u8> for MockStream {
    fn write(&mut self, this: &StreamWritable<u8>, data: Array<u8>) {
        let _ = this;
        for let b of data {
            self.log.push(b);
        }
        resume ()
    }
    fn drop(&mut self, this: &StreamWritable<u8>) {
        let _ = this;
        resume ()
    }
    ..
}

export fn run() with Stdout {
    let mut s = MockStream { log: [] };
    with &mut s do {
        let [rx, tx] = Stream::<u8>::new();
        let payload: Array<u8> = [104 as u8, 105 as u8]; // "hi"
        tx.write(payload);
        let got = rx.read(16);
        assert got.len() == 2;
        assert got[0] == 104 as u8;
        assert got[1] == 105 as u8;
        tx.drop();
        rx.drop();
    }
    println(`bytes_buffered={s.log.len()}`);
}

__DATA__
{"stdout_contains": ["bytes_buffered=0"]}
