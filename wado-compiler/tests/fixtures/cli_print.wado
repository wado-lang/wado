// Test print() - output without newline

use { print, Stdout } from "core:cli";

export fn run() with Stdout {
    print("Hello");
    print(" ");
    print("World");
}

__DATA__
{
    "stdout": "Hello World",
    "wir_pass": {"O2": ["nir/inline"]},
    "wir_not_expect:O2": ["String::len", "String::internal_raw_bytes"]
}
