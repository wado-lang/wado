// Test print() - output without newline

use { print, Stdout } from "core:cli";

export fn run() with Stdout {
    print("Hello");
    print(" ");
    print("World");
}

__DATA__
{
    "stdout": "Hello World",
    "wir_not_expect:O2": ["$inline_String__len_", "$inline_String__internal_raw_bytes_", "String::len("]
}
