// A supertrait clause writes the supertrait's own arguments, and a bound naming
// the subtrait supplies the supertrait at exactly those arguments.

trait Measure<X> {
    fn of(&self, x: X) -> i32;
}

trait Metric: Measure<i32> {
    fn unit(&self) -> i32;
}

struct Ruler {
    scale: i32,
}

impl Measure<i32> for Ruler {
    fn of(&self, x: i32) -> i32 {
        return self.scale * x;
    }
}

impl Metric for Ruler {
    fn unit(&self) -> i32 {
        return self.scale;
    }
}

fn scaled<U: Measure<i32>>(u: U, by: i32) -> i32 {
    return u.of(by);
}

// `T: Metric` reaches `Measure<i32>` through the clause, so it answers a bound
// written at that same argument.
fn through_supertrait<T: Metric>(t: T, by: i32) -> i32 {
    return scaled(t, by);
}

test "a supertrait clause supplies its written arguments" {
    assert through_supertrait(Ruler { scale: 3 }, 4) == 12;
}
