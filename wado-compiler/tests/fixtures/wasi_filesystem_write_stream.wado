// Tests: Descriptor::write_via_stream writes data to a file via stream.
//
// WASI P3 spec (vendor/wasmtime/crates/wasi/src/p3/wit/deps/filesystem.wit):
//
//   write-via-stream: async func(data: stream<u8>, offset: filesize) -> result<_, error-code>;
//     - Takes the readable end of a stream and a byte offset.
//     - Writes the full stream contents to the file at the given offset (like pwrite).
//     - Is async: returns a subtask handle (i32) from the CM lowered call.
//     - Completes once all data is written or an error occurs.
//
// WASI P3 async streams require specific ordering in sync context:
//   1. Create stream pair [readable, writable].
//   2. Start consumer (write_via_stream) with the readable end FIRST.
//   3. Write data bytes to the writable end.
//   4. Drop writable end (signals EOF).
//   5. Wait for consumer subtask to complete.
//
// This is the same ordering used by core:cli/println for Stdout::write_via_stream.
//
// After writing, the file is read back via read_via_stream and piped to stdout
// to verify the round-trip.

use { Stdout, Stderr } from "core:cli";
use { Preopens, Descriptor, Filesize, PathFlags, OpenFlags, DescriptorFlags } from "wasi:filesystem";


export fn run() with Stdout, Stderr, Preopens {
    let dirs = Preopens::get_directories();
    if dirs.len() == 0 {
        return;
    }

    let dir = dirs[0].0;

    let write_result = dir.open_at(
        PathFlags::none(),
        "test_output.txt",
        OpenFlags::Create | OpenFlags::Truncate,
        DescriptorFlags::Write | DescriptorFlags::Read,
    ).wait();

    if let Ok(file) = write_result {
        // Write "Hello, Stream!\n" via stream (consumer-first ordering)
        let [write_rx, write_tx] = Stream::<u8>::new();
        let sub1 = file.write_via_stream(write_rx, 0 as Filesize);
        let data: Array<u8> = [72, 101, 108, 108, 111, 44, 32, 83, 116, 114, 101, 97, 109, 33, 10];
        write_tx.write(data);
        write_tx.drop();
        sub1.drop();

        // Read back via stream and pipe to stdout to verify round-trip
        let [file_rx, read_done] = file.read_via_stream(0 as Filesize);
        let [out_rx, out_tx] = Stream::<u8>::new();
        let sub2 = Stdout::write_via_stream(out_rx);
        loop {
            let chunk = file_rx.read(4096);
            if chunk.len() == 0 {
                break;
            }
            out_tx.write(chunk);
        }
        file_rx.drop();
        out_tx.drop();
        sub2.drop();
        read_done.drop();

        // Clean up
        dir.unlink_file_at("test_output.txt").wait();
    }
}

__DATA__
{
    "preopened_dirs": [["tests/fixtures/testdata", "testdata"]],
    "stdout": "Hello, Stream!\n"
}
