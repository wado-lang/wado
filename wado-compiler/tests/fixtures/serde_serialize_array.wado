// Test: Serialize implementation for List<T>
// List<T> serializes as a sequence
use { println, Stdout } from "core:cli";

struct SerializeError {
    message: String,
}

trait Serialize {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError>;
}

trait SerializeSeq {
    fn element<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError>;
    fn end(&mut self) -> Result<(), SerializeError>;
}

trait Serializer {
    type SeqSerializer: SerializeSeq;

    fn serialize_i32(&mut self, v: i32) -> Result<(), SerializeError>;
    fn serialize_string(&mut self, v: &String) -> Result<(), SerializeError>;
    fn begin_seq(&mut self, len: i32) -> Result<Self::SeqSerializer, SerializeError> with stores[self];
}

// Sub-serializer holds `&mut JsonSerializer` so writes flow back to the
// outer instance — see serde_serialize_struct.wado for the rationale.
struct JsonSerializer {
    buf: String,
}

struct JsonSeqSerializer {
    ser: &mut JsonSerializer,
    count: i32,
}

impl Serializer for JsonSerializer {
    type SeqSerializer = JsonSeqSerializer;

    fn serialize_i32(&mut self, v: i32) -> Result<(), SerializeError> {
        self.buf.push_str(&`{v}`);
        return Result::<(), SerializeError>::Ok(());
    }

    fn serialize_string(&mut self, v: &String) -> Result<(), SerializeError> {
        self.buf.push_str(&`"{*v}"`);
        return Result::<(), SerializeError>::Ok(());
    }

    fn begin_seq(&mut self, len: i32) -> Result<JsonSeqSerializer, SerializeError> with stores[self] {
        self.buf.push_str(&"[");
        return Result::<JsonSeqSerializer, SerializeError>::Ok(JsonSeqSerializer {
            ser: self,
            count: 0,
        });
    }
}

impl SerializeSeq for JsonSeqSerializer {
    fn element<T: Serialize>(&mut self, value: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.ser.buf.push_str(&",");
        }
        value.serialize::<JsonSerializer>(self.ser);
        self.count += 1;
        return Result::<(), SerializeError>::Ok(());
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.ser.buf.push_str(&"]");
        return Result::<(), SerializeError>::Ok(());
    }
}

impl Serialize for i32 {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_i32(*self);
    }
}

impl Serialize for String {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_string(self);
    }
}

// Serialize for List<T> — bounded impl
impl<T: Serialize> Serialize for List<T> {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let mut seq = s.begin_seq(self.len());
        if let Ok(mut seq) = seq {
            for let item of *self {
                seq.element::<T>(&item);
            }
            return seq.end();
        }
        return Result::<(), SerializeError>::Err(SerializeError { message: "begin_seq failed" });
    }
}

export fn run() with Stdout {
    let mut ser = JsonSerializer { buf: "" };

    let nums: List<i32> = [10, 20, 30];
    nums.serialize::<JsonSerializer>(&mut ser);
    println(`List<i32>: {ser.buf}`);

    ser.buf = "";
    let strs: List<String> = ["hello", "world"];
    strs.serialize::<JsonSerializer>(&mut ser);
    println(`List<String>: {ser.buf}`);

    ser.buf = "";
    let empty: List<i32> = [];
    empty.serialize::<JsonSerializer>(&mut ser);
    println(`Empty: {ser.buf}`);
}

__DATA__
{"stdout": "List<i32>: [10,20,30]\nList<String>: [\"hello\",\"world\"]\nEmpty: []\n"}
