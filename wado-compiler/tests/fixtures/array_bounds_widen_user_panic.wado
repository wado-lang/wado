// Only a contract check moves into another, and only across what reports
// nothing: a user's own guard keeps its message, and a panic between two
// accesses still runs first.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn guarded(xs: &List<i32>, i: i32) -> i32 with Stdout {
    if i >= xs.len() {
        panic("A");
    }
    if i + 1 >= xs.len() {
        println("diag");
        panic("B");
    }
    return 0;
}

export fn run() with Stdout {
    let xs: List<i32> = builtin::black_box([1, 2, 3]);
    let _ = guarded(&xs, builtin::black_box(2));
}

__DATA__
{"stdout": "diag\n", "trapped": true, "stderr_contains": ["B"]}
