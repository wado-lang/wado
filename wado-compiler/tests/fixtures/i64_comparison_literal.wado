// Test i64 comparison with i32 literal
use {println, Stdout} from "core:cli";

fn run() with Stdout {
    let x: i64 = 100 as i64;

    // Compare i64 with literal (literal is i32 by default)
    if x > 0 {
        println("x > 0: true");
    } else {
        println("x > 0: false");
    }

    let y: i64 = -50 as i64;
    if y < 0 {
        println("y < 0: true");
    } else {
        println("y < 0: false");
    }
}

__DATA__
{"stdout": "x > 0: true\ny < 0: true\n"}
