// The benign forwarding closure `|p| step(p)`: `step` does not store its
// parameter, so the closure persists nothing and compiles and runs, even
// though it is coerced to a `fn(&mut Parser)` slot.

struct Parser {
    pos: i32,
}

fn step(p: &mut Parser) {
    p.pos += 1;
}

fn drive(p: &mut Parser, f: fn(&mut Parser)) {
    f(p);
}

export fn run() {
    let mut par = Parser { pos: 0 };
    drive(&mut par, |p: &mut Parser| step(p));
    assert par.pos == 1;
}

