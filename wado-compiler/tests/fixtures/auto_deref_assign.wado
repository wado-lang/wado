// Simple and compound assignment do not auto-dereference &T to T.
// Use explicit dereference (*ref) instead.
export fn run() {
    // Simple assignment: &i32 to i32 variable
    let mut x = 0;
    let val = 42;
    let rv = &val;
    x = rv;  // expected i32, found &i32 → error
}

__DATA__
{"compile_error": "expected 'i32', found '&i32'"}
