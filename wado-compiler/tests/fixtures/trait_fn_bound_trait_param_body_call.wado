// A trait's type parameter may carry an `fn(...)` bound. Inside an impl of
// that trait, the bound names no trait — it is realised in the parameter's own
// type — so the environment a call in the body is answered under skips it,
// as the declaration's own parameter list does (WEP 2026-09-01).

trait Tag {
    fn tag(&self) -> i32;
}

impl Tag for i32 {
    fn tag(&self) -> i32 {
        return *self;
    }
}

trait Apply<F: fn(i32) -> i32> {
    fn apply(&self, f: F) -> i32;
}

struct P {
    x: i32,
}

impl Apply<fn(i32) -> i32> for P {
    fn apply(&self, f: fn(i32) -> i32) -> i32 {
        return f(self.x.tag());
    }
}

test "a call in the body of an impl whose trait carries an fn bound" {
    let p = P { x: 2 };
    assert p.apply(|v: i32| v + 1) == 3;
}

__DATA__
{"test": {}}
