// A struct that holds a Component Model resource (`Fields`) gets a synthesized
// compositional destructor: at scope exit, when the struct was never
// transferred, its resource field is released with `resource.drop` in
// declaration order (WEP 2026-05-21). Without it the field would leak a
// resource-table slot.

use { Request, Response, ErrorCode, Fields, Trailers } from "wasi:http";

struct Holder {
    headers: Fields,
}

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    // `h` is never transferred, so at scope exit `h.headers` is dropped.
    let h = Holder { headers: Fields::new() };

    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let headers = Fields::new();
    let [response, _tx_future] = Response::new(headers, null, trailers_future);
    task return Result::<Response, ErrorCode>::Ok(response);
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

__DATA__
{"wasi:http/service": {"status": 200}, "wir_expect:O2": ["resource-drop:fields"]}
