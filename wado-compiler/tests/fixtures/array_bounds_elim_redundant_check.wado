// Redundant bounds-check elimination: `end[child]` / `end[parent]` are each
// checked in the `if` condition and re-checked (redundantly) in the body. Pins
// runtime behavior across O-levels; the WIR count is in `tests/redundant_bce.rs`.
#[inline(never)]
fn bump(end: &mut List<i32>, child: i32, parent: i32) {
    if end[child] > end[parent] {
        end[parent] = end[child];
    }
}

export fn run() {
    let mut e: List<i32> = [5, 9, 2, 7];
    bump(&mut e, 0, 2);
    assert e[2] == 5;
    bump(&mut e, 1, 3);
    assert e[3] == 9;
    // No-op branch (9 < 2 is false), leaves e[0] unchanged.
    bump(&mut e, 2, 0);
    assert e[0] == 5;
}

__DATA__
{
    "stdout": ""
}
