// Redundant bounds-check elimination via a dominating panic-guard.
//
// `end[child]` and `end[parent]` are each accessed in the `if` condition and
// again in the body. The condition's bounds-check panic-guard proves the index
// is in bounds, so the body's re-check of the same index into the same
// (unmodified) array is redundant and must be eliminated (see the WIR count in
// `tests/redundant_bce.rs`). This fixture pins the runtime behavior across
// optimization levels — the elimination must not change results, and an actual
// out-of-bounds index must still trap.
#[inline(never)]
fn bump(end: &mut List<i32>, child: i32, parent: i32) {
    if end[child] > end[parent] {
        end[parent] = end[child];
    }
}

export fn run() {
    let mut e: List<i32> = [5, 9, 2, 7];
    bump(&mut e, 0, 2);
    assert e[2] == 5;
    bump(&mut e, 1, 3);
    assert e[3] == 9;
    // No-op branch (9 < 2 is false), leaves e[0] unchanged.
    bump(&mut e, 2, 0);
    assert e[0] == 5;
}

__DATA__
{
    "stdout": ""
}
