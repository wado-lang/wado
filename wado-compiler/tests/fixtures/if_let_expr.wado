use { println, Stdout } from "core:cli";

fn unwrap_or(opt: Option<i32>, default: i32) -> i32 {
    return if let Some(x) = opt { x } else { default };
}

fn classify(opt: Option<i32>) -> String {
    let label = if let Some(n) = opt {
        if n > 0 { "positive" } else { "non-positive" }
    } else {
        "none"
    };
    return label;
}

fn nested(outer: Option<Option<i32>>) -> i32 {
    return if let Some(inner) = outer {
        if let Some(v) = inner { v } else { -1 }
    } else {
        -2
    };
}

export fn run() with Stdout {
    println(`{unwrap_or(Option::Some(42), 0)}`);
    println(`{unwrap_or(null, 99)}`);
    println(`{classify(Option::Some(5))}`);
    println(`{classify(Option::Some(-3))}`);
    println(`{classify(null)}`);
    println(`{nested(Option::Some(Option::Some(7)))}`);
    println(`{nested(Option::Some(null))}`);
    println(`{nested(null)}`);
}

__DATA__
{"stdout": "42\n99\npositive\nnon-positive\nnone\n7\n-1\n-2\n"}
