// Test: SROA behavior when &s is passed to a stores function.
//
// When the callee declares `stores[p]`, the reference persists beyond the call.
// However, after inlining + SROA of the Holder + ref elimination, the stores
// semantics is resolved and `p` may be fully decomposed into scalars.

struct Point {
    x: i32,
    y: i32,
}

struct Holder {
    p: &Point,
}

fn store_point(p: &Point) -> Holder with stores[p] {
    return Holder { p };
}

// After inlining store_point and decomposing Holder, p can be fully SROA'd.
//
// `black_box` keeps the fields off the constant path, so the stores-blocked
// path is what the golden shows rather than a folded-away program.
export fn run() {
    let p = Point {
        x: builtin::black_box(10),
        y: builtin::black_box(20),
    };
    let h = store_point(&p);
    // The stored ref must see the same struct, so p must remain allocated.
    assert p.x == 10;
    assert h.p.x == 10;
}

__DATA__
{
    "stdout": ""
}
