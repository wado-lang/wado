// Key-value literal error: newtype in concrete impl position rejects wrong type.
// Read as a free type parameter, Tag would let TagMap<String, i32> match the impl.
type Tag = String;

struct TagMap<K, V> {
    keys: List<String>,
    values: List<V>,
}

impl<V> From<Array<[String, V]>> for TagMap<Tag, V> {
    fn from(entries: Array<[String, V]>) -> TagMap<Tag, V> {
        let mut out: TagMap<Tag, V> = TagMap { keys: [], values: [] };
        for let [key, value] of entries {
            out.keys.push(key);
            out.values.push(value);
        }
        return out;
    }
}

export fn run() {
    // String != Tag — should fail to find impl
    let m: TagMap<String, i32> = { a: 1 };
}

__DATA__
{"compile_error": "cannot be built from an object literal"}
