// KeyValueLiteral error: newtype in concrete impl position rejects wrong type.
// Before the is_known_type_name fix, Tag was treated as a free type parameter,
// so TagMap<String, i32> incorrectly matched the impl.
type Tag = String;

struct TagMap<K, V> {
    keys: List<String>,
    values: List<V>,
}

impl KeyValueLiteralBuilder for TagMap<Tag, V> {
    type Value = V;
    type Output = TagMap<Tag, V>;

    fn new_literal(capacity: i32) -> TagMap<Tag, V> {
        return TagMap { keys: [], values: [] };
    }

    fn insert_literal(&mut self, key: String, value: Self::Value) {
        self.keys.push(key);
        self.values.push(value);
    }

    fn build(&self) -> TagMap<Tag, V> {
        return *self;
    }
}

export fn run() {
    // String != Tag — should fail to find impl
    let m: TagMap<String, i32> = { a: 1 };
}

__DATA__
{"compile_error": "does not implement KeyValueLiteral"}
