// A value a `matches` guard moves is gone after it, on the path the guard ran.
affine struct Tok {
    id: i32,
}

impl Drop for Tok {
    fn drop(self) {
    }
}

fn eat(t: Tok) -> i32 {
    return t.id;
}

test {
    let k = Tok { id: 1 };
    let o: Option<i32> = Some(3);
    let b = o matches { Some(x) && eat(k) > x };
    let again = k;
}

__DATA__
{"compile_error": ":19:17: analysis error: affine value `k` used after it was moved (moved at 18:40)"}
