// Test global variable with struct type
use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

global mut ORIGIN: Point = Point { x: 0, y: 0 };

fn run() with Stdout {
    println(`x={ORIGIN.x} y={ORIGIN.y}`);
    ORIGIN = Point { x: 10, y: 20 };
    println(`x={ORIGIN.x} y={ORIGIN.y}`);
}

__DATA__
{"stdout": "x=0 y=0\nx=10 y=20\n"}
