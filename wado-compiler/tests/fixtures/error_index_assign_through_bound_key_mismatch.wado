// A write through an `IndexAssign` bound checks the key against the bound's key
// type, as a read through `IndexValue` does.
fn put<B: IndexAssign<i32, Output = u8>>(buf: &mut B) {
    buf["bad"] = 5;
}

test {
    let mut xs: List<u8> = [7];
    put(&mut xs);
}

