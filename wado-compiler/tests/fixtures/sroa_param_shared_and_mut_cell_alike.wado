// `&&S` and `&&mut S` point at one cell, a `&mut` coercing under a shared
// reference. `sroa_param` scalarizes `g`'s parameters, and a call passing one
// of each must forward the first and project the second, rather than decline
// a call that still forwards a scalarized parameter.
use { println, Stdout } from "core:cli";

struct S { x: i32 }

#[inline(never)]
fn g(a: &&S, b: &&S) -> i32 {
    return a.x + b.x;
}

#[inline(never)]
fn forwards_first(p: &&S) -> i32 {
    let mut s = S { x: builtin::black_box(2) };
    let r = &mut s;
    return g(p, &r);
}

#[inline(never)]
fn forwards_second(p: &&S) -> i32 {
    let mut s = S { x: builtin::black_box(3) };
    let r = &mut s;
    return g(&r, p);
}

export fn run() with Stdout {
    let s = S { x: builtin::black_box(1) };
    let r = &s;
    println(`${forwards_first(&r)} ${forwards_second(&r)}`);
}

__DATA__
{
    "stdout": "3 4\n"
}
