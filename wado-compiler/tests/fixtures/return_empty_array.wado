// Return empty array literal from function

use { println, Stdout } from "core:cli";

fn get_empty() -> Array<i32> {
    return [];
}

export fn run() with Stdout {
    let arr = get_empty();
    for let n of arr {
        println(`{n}`);
    }
    println("done");
}

__DATA__
{"stdout": "done\n"}
