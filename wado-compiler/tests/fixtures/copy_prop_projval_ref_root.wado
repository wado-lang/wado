// Regression guard: a copy-propagation that re-reads a field VALUE must not fire
// when the root is a reference local copied from a struct field. Here `root` and
// `s.a` are `&mut Node` aliasing the same Node, so `s.a.value = 999` mutates what
// `root.value` reads — but that mutation is rooted at `s`, and the field-level
// aliasing of `root`/`s.a` is invisible to the local-scoped alias analysis. The
// snapshot must stay 5. (`pad` keeps `Graph` from collapsing to a bare `&mut Node`
// under SROA; the recursion keeps `foo` from being inlined.)
use { println, Stdout } from "core:cli";

struct Node { value: i32 }
struct Graph { a: &mut Node, pad: i32 }

fn foo(s: &mut Graph, depth: i32) -> i32 {
    if depth > 0 {
        return foo(s, depth - 1);
    }
    let root = s.a;
    let x = root.value;
    s.a.value = 999;
    return x;
}

export fn run() with Stdout {
    let mut n = Node { value: 5 };
    let mut g = Graph { a: &mut n, pad: 0 };
    println(`${foo(&mut g, 0)}`);
}

__DATA__
{ "stdout": "5\n" }
