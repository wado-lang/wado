// Regression test for wado-lang/wado#1615: an inherent method defined on a
// newtype (`impl Bytes { fn to_hex }`) resolved correctly in a non-generic
// context but, when the same call appeared inside a *generic* function body,
// its method owner was mis-resolved to the newtype's erased base type
// (`List<u8>`) rather than the newtype itself, producing a WIR ICE
// ("unresolved MethodCall: name=\"List<u8>::to_hex\"").
//
// The newtype's own inherent method must be kept through monomorphization
// instead of being peeled to the erased generic base.
type Bytes = List<u8>;

fn hex_digit(nibble: u32) -> char {
    if nibble < 10 {
        return char::from_u32_unchecked(('0' as u32) + nibble);
    }
    return char::from_u32_unchecked(('a' as u32) + nibble - 10);
}

impl Bytes {
    fn to_hex(&self) -> String {
        let mut s = String::with_capacity(self.len() * 2);
        let mut i = 0;
        while i < self.len() {
            let b = self[i] as u32;
            s.push(hex_digit((b >> 4) & 0xf));
            s.push(hex_digit(b & 0xf));
            i += 1;
        }
        return s;
    }
}

fn make() -> Result<Bytes, String> {
    return Result::Ok([0x0f, 0xa0] as Bytes);
}

// `enc` is generic — that alone triggered the bug; `make()` being non-generic
// is irrelevant.
fn enc<T>(_v: &T) -> String {
    return match make() {
        Ok(bytes) => bytes.to_hex(),
        Err(_) => panic("unreachable"),
    };
}

// The non-generic form compiled fine before the fix; keep it as a control.
fn enc_direct(b: Bytes) -> String {
    return b.to_hex();
}

export fn run() {
    let n = 5;
    assert enc::<i32>(&n) == "0fa0";
    assert enc_direct([0x0f, 0xa0] as Bytes) == "0fa0";
}

__DATA__
{"stdout": ""}
