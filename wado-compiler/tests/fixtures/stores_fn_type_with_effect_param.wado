// Parser: fn type with effect inside parameter list must not consume next param.
// `fn(T) -> T with E, x: T` must parse as two parameters, not `with E, x`.

use { println, Stdout } from "core:cli";

fn apply(f: fn(i32) -> i32 with Stdout, x: i32) -> i32 with Stdout {
    return f(x);
}

export fn run() with Stdout {
    let result = apply(|x: i32| {
        println(`x = ${x}`);
        return x + 1;
    }, 41);
    assert result == 42;
    println(`result: ${result}`);
}

__DATA__
{"stdout": "x = 41\nresult: 42\n"}
