// O3 miscompilation: copy propagation corrupts parser state after
// inlining, causing backtracking dispatch to misparse subqueries.
// Minimal SQL: SELECT with IN subquery containing WHERE clause.
use sqlite from "./sub/sqlite.wado";

export fn run() {
    let sql = "SELECT 1 WHERE 1 IN (SELECT 1 WHERE 1 = 1);";
    let r = sqlite::parse(&sql);
    if let Err(e) = r { panic(e.message); }
}

