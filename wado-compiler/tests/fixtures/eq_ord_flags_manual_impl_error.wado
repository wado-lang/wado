// A flags type's equality is the bitmask compare `==` emits directly, and a
// `T: Eq` bound's generic code sees the erased `u32`. A hand-written body is
// reachable from neither, so it is rejected rather than silently ignored.

flags Perms {
    can_read,
    can_write,
}

impl Eq for Perms {
    fn eq(&self, _other: &Perms) -> bool {
        return true;
    }
}

test "the manual impl never runs" {
    assert Perms::can_read == Perms::can_write;
}

__DATA__
{"compile_error": "cannot implement `Eq` for the flags type `Perms`"}
