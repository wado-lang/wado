// Cross-module struct-name collision regression — WIR codegen path
// triggered by `for let _ of &mut Array<S>` iteration in one module
// while a same-named struct `S` exists in another module.
//
// Companion to `cross_module_same_name_struct.wado`, which only
// exercises construction-time field-type lookup. This fixture also
// exercises the codegen-time iterator-binding lookup that confuses
// the two modules' `Pair` and emits a Wasm GC reference type
// (`(ref (exact $T))`) where the surrounding code expects a
// nullable reference (`(ref null $T)`).
//
// Without the fix, this test fails with
//   "Internal compiler error: WIR pipeline generated invalid core
//   Wasm module / Validation error: type mismatch: expected
//   (ref null $type), found (ref (exact $type))"
// at codegen time. With the fix, the test passes: the WIR codegen
// resolves struct types by `(name, ModuleSource)` everywhere
// (mirroring the lower-time `struct_fields_map` keying).

use { Outer, Pair } from "./sub/cross_module_same_name_struct_iter_b.wado";

test "construct same-name struct from other module while a sibling iterates" {
    let o = Outer { items: [Pair { indices: [0, 1] }] };
    assert o.items.len() == 1;
    assert o.items[0].indices.len() == 2;
}

__DATA__
{"test": {}}
