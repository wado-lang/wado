// A bare binding takes every value, so a narrowing arm after it can never run.
use { Element, HtmlInputElement } from "wado-lang:web";

fn kind(e: Element) -> i32 {
    return match e {
        el => 1,
        input: HtmlInputElement => 2,
    };
}

export fn run() {}

