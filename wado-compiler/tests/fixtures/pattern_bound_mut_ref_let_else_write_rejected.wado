variant Shape {
    Circle(i32),
    Dot,
}

test "a write through a payload a let-else binds" {
    let mut held: Option<Shape> = Option::Some(Shape::Circle(1));
    let Some(shape) = &mut held else {
        return;
    };
    *shape = Shape::Dot;
}

__DATA__
{
    "test": {},
    "compile_error": "is a detached copy, so a whole-value write through it would be lost"
}
