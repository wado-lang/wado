use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut arr: Array<u32> = [];
    arr.append(100000 as u32);
    arr.append(200000 as u32);
    arr.append(300000 as u32);

    for let x of arr {
        println(`{x}`);
    }
}

__DATA__
{"stdout": "100000\n200000\n300000\n"}
