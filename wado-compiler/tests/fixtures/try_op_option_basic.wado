// ? operator on Option<T> — unwraps Some, returns null on None
use { println } from "core:cli";

fn first_positive(arr: Array<i32>) -> Option<i32> {
    let mut i = 0;
    while i < arr.len() {
        if arr[i] > 0 {
            return Option::<i32>::Some(arr[i]);
        }
        i += 1;
    }
    return null;
}

fn first_positive_doubled(arr: Array<i32>) -> Option<i32> {
    // ? unwraps Some → i32, or returns null if None
    let n = first_positive(arr)?;
    return Option::<i32>::Some(n * 2);
}

export fn run() with Stdout {
    // Some case: ? unwraps the value and the outer function returns Some
    assert first_positive_doubled([1, 2, 3] as Array<i32>) matches { Some(n) && n == 2 };

    // None case: ? causes early return of null
    assert first_positive_doubled([-1, -2] as Array<i32>) matches { None };

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
