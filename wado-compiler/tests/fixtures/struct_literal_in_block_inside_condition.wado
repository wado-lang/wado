// A condition takes no struct literal, since its `{` opens the body. Inside a
// block or a `match` the condition holds, the body is not next, so a struct
// literal parses as anywhere else.

struct P {
    x: i32,
}

fn branch(c: bool) -> i32 {
    if let { x } = if c { P { x: 1 } } else { P { x: 2 } } && x > 0 {
        return x;
    }
    return 0;
}

fn arm(n: i32) -> i32 {
    if (match n { 0 => P { x: 3 }, _ => P { x: 4 } }).x > 3 {
        return 1;
    }
    return 0;
}

test {
    assert branch(true) == 1;
    assert branch(false) == 2;
    assert arm(0) == 0;
    assert arm(1) == 1;
}
