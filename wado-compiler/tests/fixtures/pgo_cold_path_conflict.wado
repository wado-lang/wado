// An author's `cold_path()` and a `?`'s failure path each ran in 1 of 4 runs,
// neither unlikely nor cold, so the profile overrides both markers, with a
// remark naming what it measured.
use { println, Stdout } from "core:cli";

fn parse_digit(c: char) -> Result<i32, String> {
    if c < '0' || c > '9' {
        builtin::cold_path();
        return Err("not a digit");
    }
    return Ok(c as i32 - '0' as i32);
}

fn sum_digits(s: String) -> Result<i32, String> {
    let mut total = 0;
    for let c of s.chars() {
        total += parse_digit(c)?;
    }
    return Ok(total);
}

export fn run() with Stdout {
    println(`${sum_digits("12").unwrap()} ${sum_digits("1x").is_err()}`);
}

__DATA__
{
  "profile": "testdata/pgo_cold_path_conflict.pgo",
  "marked_regions": [],
  "remarks": {
    "O2": [
      {
        "contains": [
          "pgo_cold_path_conflict.wado:8:9 remark: `cold_path()` marks this path rare, but the profile ran it in 1 of 4 runs, so it is neither unlikely nor cold; the profile overrides the marker"
        ],
        "count": 1
      },
      {
        "contains": [
          "pgo_cold_path_conflict.wado:17:18 remark: `?` marks its failure path rare, but the profile ran it in 1 of 4 runs, so it is neither unlikely nor cold; the profile overrides the marker"
        ],
        "count": 1
      }
    ]
  },
  "stdout": "3 true\n"
}
