// Key-value literal coercion in function argument position, custom type
use { println, Stdout } from "core:cli";

struct SimpleMap<V> {
    keys: List<String>,
    values: List<V>,
}

impl SimpleMap<V> {
    fn new() -> SimpleMap<V> {
        return SimpleMap { keys: [], values: [] };
    }

    fn len(&self) -> i32 {
        return self.keys.len();
    }

    fn get(&self, key: String) -> Option<V> {
        for let mut i = 0; i < self.keys.len(); i += 1 {
            if self.keys[i] == key {
                return Option::<V>::Some(self.values[i]);
            }
        }
        return null;
    }
}

impl From<Array<[String, V]>> for SimpleMap<V> {
    fn from(entries: Array<[String, V]>) -> SimpleMap<V> {
        let mut out = SimpleMap::<V>::new();
        for let [key, value] of entries {
            out.keys.push(key);
            out.values.push(value);
        }
        return out;
    }
}

fn count_entries(m: SimpleMap<i32>) -> i32 {
    return m.len();
}

fn sum_values(m: SimpleMap<i32>) -> i32 {
    let mut total = 0;
    for let v of m.values {
        total = total + v;
    }
    return total;
}

export fn run() with Stdout {
    let n = count_entries({ a: 1, b: 2, c: 3 });
    assert n == 3;

    let s = sum_values({ x: 10, y: 20 });
    assert s == 30;

    println("fn arg key-value literal: ok");
}

__DATA__
{"stdout": "fn arg key-value literal: ok\n"}
