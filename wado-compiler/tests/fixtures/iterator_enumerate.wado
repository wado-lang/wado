// Test ArrayIter::enumerate() method
use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let arr: Array<String> = ["a", "b", "c"];

    // Enumerate yields (index, element) tuples
    let mut iter = arr.iter().enumerate();

    loop {
        if let Some(pair) = iter.next() {
            let idx = pair.0;
            let val = pair.1;
            println(`{idx}: {val}`);
        } else {
            break;
        }
    }
}

__DATA__
{"stdout": "0: a\n1: b\n2: c\n"}
