// The same rejection as `cm_future_record_nonlib_rejected.wado`, reached
// through a newtype. A newtype is a WIT type alias, so the payload is the
// record — the resolvability check has to see through the alias, or the
// unresolvable record slips past it and ICEs codegen instead.
use { Request, Response, ErrorCode, Fields, Trailers } from "wasi:http";

struct Point {
    x: f64,
    y: f64,
}

type Alias = Point;

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    let [rx, tx] = Future::<Alias>::new();
    tx.drop();
    rx.drop();

    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let headers = Fields::new();
    let [response, _tx_future] = Response::new(headers, null, trailers_future);
    task return Result::<Response, ErrorCode>::Ok(response);
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

__DATA__
{
    "wasi:http/service": {},
    "compile_error": "record type `Point` is used as a `future` / `stream` payload, which is only supported in library (`--lib`) components"
}
