// Test that Array<T> == Array<T> requires T: Eq

variant NoEq {
    A(i32),
    B,
}

struct Foo {
    x: NoEq,
}

export fn run() {
    let a: Array<Foo> = [Foo { x: NoEq::A(1) }];
    let b: Array<Foo> = [Foo { x: NoEq::A(1) }];
    // Foo does not implement Eq (NoEq variant field), so == on Array<Foo> should fail
    assert a == b;
}

__DATA__
{"compile_error": "=="}
