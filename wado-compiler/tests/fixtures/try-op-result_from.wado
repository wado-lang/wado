// ? operator on Result<T, E> — From-based error conversion
// Inner function returns Err(InnerError); outer function's ? converts to OuterError via From
use { println } from "core:cli";

struct LowError {
    code: i32,
}

variant HighError {
    Low(LowError),
    Other(String),
}

impl From<LowError> for HighError;

fn low_op(fail: bool) -> Result<i32, LowError> {
    if fail {
        return Result::<i32, LowError>::Err(LowError { code: 42 });
    }
    return Result::<i32, LowError>::Ok(100);
}

fn high_op(fail: bool) -> Result<i32, HighError> {
    // ? converts LowError → HighError::Low via From<LowError> for HighError
    let n = low_op(fail)?;
    return Result::<i32, HighError>::Ok(n + 1);
}

export fn run() with Stdout {
    // Ok path: error conversion not triggered
    assert high_op(false) matches { Ok(n) && n == 101 };

    // Err path: LowError is wrapped into HighError::Low
    let r2 = high_op(true);
    if let Err(e) = r2 {
        if let Low(inner) = e {
            assert inner.code == 42;
        } else {
            panic("expected Low variant");
        }
    } else {
        panic("expected Err");
    }

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
