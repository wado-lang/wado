// Test: httpbin /headers returns request headers
use { Request, Response, ErrorCode, Fields, FieldName, FieldValue, Trailers, StatusCode } from "wasi:http";
use { route, method_name, split_path_query } from "./sub/httpbin_handler.wado";

export async fn handle(request: Request) -> Result<Response, ErrorCode>
    with Request, Response
{
    let full_path = if let Some(p) = request.get_path_with_query() {
        p;
    } else {
        "/";
    };
    let method_str = method_name(request.get_method());
    let [path, query] = split_path_query(full_path);
    let [status, content_type, body_str] = route(request, method_str, path, query);

    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [body_rx, body_tx] = Stream::<u8>::new();
    let headers = Fields::new();
    let _ = headers.append("content-type" as FieldName, content_type.bytes().collect() as FieldValue);
    let [response, _tx_future] = Response::new(headers, Option::<Stream<u8>>::Some(body_rx), trailers_future);
    response.set_status_code(status as u16 as StatusCode);
    task return Result::<Response, ErrorCode>::Ok(response);
    body_tx.write(body_str.bytes().collect());
    body_tx.drop();
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

__DATA__
{
    "wasi:http/service": {
        "request": {"path": "/headers", "headers": [["x-custom", "test-value"]]},
        "status": 200,
        "body_contains": ["\"headers\":", "\"x-custom\":\"test-value\""]
    }
}
