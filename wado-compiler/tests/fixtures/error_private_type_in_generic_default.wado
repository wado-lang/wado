// A type parameter's default is written at the declaration but instantiated at
// the call, so a caller that omits the argument still gets the type back.
struct Hidden {
    n: i32,
}

pub fn make<T = Hidden>(v: T) -> T {
    return v;
}

export fn run() {
    assert make(Hidden { n: 1 }).n == 1;
}

