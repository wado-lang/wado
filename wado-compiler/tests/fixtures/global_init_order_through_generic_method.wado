// `HOLD`'s initializer reads `SEED` through a method of a generic type, and so
// runs after `SEED`'s. Monomorphization renames such a call to the instance but
// leaves the template's method name beside it. The ordering keyed the call by
// that name, so the read went unseen and `HOLD` ran first, reading a null `SEED`.

use { println, Stdout } from "core:cli";

global HOLD: Holder<i64> = Holder::new();

struct Seed { k: i64 }

global SEED: Seed = Seed { k: builtin::black_box(7) };

struct Holder<T> { k: i64, items: List<T> }

impl<T> Holder<T> {
    fn new() -> Holder<T> {
        return Holder { k: SEED.k, items: [] };
    }
}

export fn run() with Stdout {
    println(`${HOLD.k}`);
}

__DATA__
{
    "stdout": "7\n"
}
