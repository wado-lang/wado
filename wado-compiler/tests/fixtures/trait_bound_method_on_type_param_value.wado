// Test: calling trait method on value-type parameter (not reference)
// Covers the case where the receiver is T (by-value) and the trait method takes &self
use { println, Stdout } from "core:cli";

trait Describe {
    fn describe(&self) -> String;
}

struct Point {
    x: i32,
    y: i32,
}

impl Describe for Point {
    fn describe(&self) -> String {
        return `({self.x}, {self.y})`;
    }
}

impl Describe for i32 {
    fn describe(&self) -> String {
        return `int:{*self}`;
    }
}

fn show<T: Describe>(x: T) -> String {
    return x.describe();
}

export fn run() with Stdout {
    println(show::<Point>(Point { x: 1, y: 2 }));
    println(show::<i32>(42));
}

__DATA__
{"stdout": "(1, 2)\nint:42\n"}
