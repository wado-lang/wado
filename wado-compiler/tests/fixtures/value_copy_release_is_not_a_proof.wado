// The same hole reached with no pattern in sight: a two-step `let` chain
// launders the alias, so a repoint of the place is all that could license the
// chain — and it licenses nothing. A second reader of the place may be live, and
// the repoint may never run.

struct S {
    xs: List<i32>,
}

// A two-step `let` chain launders the alias, then one repoint would license the
// chain while a second reader of the same place is live.
fn two_readers(h: &mut S) -> List<i32> {
    let a0 = h.xs;
    let a = a0;
    let b = h.xs;
    h.xs = [];
    let mut x = a;
    x.push(9);
    return b;
}

test "a repoint does not license two readers of one place" {
    let mut h = S { xs: [1, 2] };
    let b = two_readers(&mut h);
    assert b.len() == 2;
}

// The same chain, with a repoint that never runs.
fn maybe(h: &mut S, c: bool) -> i32 {
    let a0 = h.xs;
    let a = a0;
    if c {
        h.xs = [];
    }
    let mut x = a;
    x.push(9);
    return x.len();
}

test "a repoint that never runs licenses nothing" {
    let mut h = S { xs: [1, 2] };
    assert maybe(&mut h, builtin::black_box(false)) == 3;
    assert h.xs.len() == 2;
}

__DATA__
{"test": {}}
