// A bound writes arguments for the trait's own parameters. They must reach the
// impl that writes them whatever else the parameter is bounded by, and whether
// or not the parameter has a declared default. The newtype side is in
// `bound_trait_argument`.

trait Pick<A = i32> with () {
    fn pick(&self, a: &A) -> bool;
}

struct Slot {
    width: i32,
}

impl Pick<String> for Slot {
    fn pick(&self, a: &String) -> bool {
        return a.len() == self.width;
    }
}

fn picks<T: Pick<String>>(t: T, a: String) -> bool {
    return t.pick(&a);
}

trait Marker with () {
    fn mark(&self) -> i32;
}

impl<T: Pick<String>> Marker for T {
    fn mark(&self) -> i32 {
        return 1;
    }
}

// A parameter answers a bound from its own bounds, so the arguments have to
// reach there too: `S: AsStrSlice` supplies `Eq<String>` through the supertrait
// that writes it, and `T: Pick<String>` supplies `Pick<String>` itself.
fn forwards_text<S: AsStrSlice>(s: S) -> bool {
    return compares_text(s);
}

fn compares_text<S: Eq<String>>(s: S) -> bool {
    return s == "x";
}

fn forwards_pick<T: Pick<String>>(t: T, a: String) -> bool {
    return picks(t, a);
}

fn text_first<S: AsStrSlice + Ord>(s: S) -> bool {
    return s == "x";
}

fn ord_first<S: Ord + AsStrSlice>(s: S) -> bool {
    return s == "x";
}

test "a bound writes a non-default argument for a defaulted parameter" {
    assert picks(Slot { width: 3 }, "abc");
    assert !picks(Slot { width: 2 }, "abc");
}

test "an impl's own bound reaches the impl that writes its argument" {
    assert Slot { width: 1 }.mark() == 1;
}

test "a parameter forwards the arguments its own bounds supply" {
    assert forwards_text("x");
    assert !forwards_text("y");
    assert forwards_pick(Slot { width: 3 }, "abc");
    assert !forwards_pick(Slot { width: 2 }, "abc");
}

test "a bound writing an argument reaches the impl whatever its position" {
    assert text_first("x");
    assert ord_first("x");
    assert !text_first("y");
    assert !ord_first("y");
}
