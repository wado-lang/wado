// The arguments a bound writes for the trait's own parameters must reach the
// impl that writes them, whatever else the parameter is bounded by, whatever
// the receiver's newtype chain, and whether or not the parameter has a
// declared default.

trait Pick<A = i32> {
    fn pick(&self, a: &A) -> bool;
}

struct Slot {
    width: i32,
}

impl Pick<String> for Slot {
    fn pick(&self, a: &String) -> bool {
        return a.len() == self.width;
    }
}

fn picks<T: Pick<String>>(t: T, a: String) -> bool {
    return t.pick(&a);
}

fn text_first<S: AsStrSlice + Ord>(s: S) -> bool {
    return s == "x";
}

fn ord_first<S: Ord + AsStrSlice>(s: S) -> bool {
    return s == "x";
}

type Name = String;

fn is_http<S: Eq<String>>(s: S) -> bool {
    return s == "http";
}

test "a bound writes a non-default argument for a defaulted parameter" {
    assert picks(Slot { width: 3 }, "abc");
    assert !picks(Slot { width: 2 }, "abc");
}

test "a bound writing an argument reaches the impl whatever its position" {
    assert text_first("x");
    assert ord_first("x");
    assert !text_first("y");
    assert !ord_first("y");
}

test "a newtype receiver takes the spelling its base's impl writes" {
    let n: Name = "http";
    assert is_http(n);
    assert is_http("http" as Name);
    assert !is_http("ftp" as Name);
    assert is_http("http");
}
