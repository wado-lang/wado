// A remark names a method the region still calls as source spells it: the
// receiver with its type arguments, the trait, the method. Not the clone the
// optimizer made of it, whose name carries `$spec0$sroa[...]`.

use { println, Stdout } from "core:cli";

struct Pair<T> { a: T, b: T }

impl<T: Display> Display for Pair<T> {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str("(");
        self.a.fmt(f);
        f.write_str(",");
        self.b.fmt(f);
        f.write_str(")");
    }
}

export fn run() with Stdout {
    let p = Pair { a: "x", b: "y" };
    println(`pair ${p} and ${p}`);
}

__DATA__
{
    "stdout": "pair (x,y) and (x,y)\n",
    "remarks": {
        "O2": [
            {"contains": ["computes a constant at run time: `Pair<String>^Display::fmt` still runs here"]}
        ]
    }
}
