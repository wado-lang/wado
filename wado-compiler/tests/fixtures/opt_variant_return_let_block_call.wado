// A `let` whose initializer is a block ending in the call.
//
// `let_block_flatten` hoists a receiver into `let t = { let r = …; f(r, …) }`.
// The rewrite binds that shape — `collect_bound_temps` looks through a block
// tail — so validation has to recognise it too. Matching only a bare `Call`
// there sends the site to the generic walk, which invalidates the callee for
// good: a candidate the rewrite handles, permanently refused.
internal struct Bank {
    rate: i32,
}

impl Bank {
    #[inline("never")]
    fn quote(&self, amount: i32) -> Result<i32, String> {
        if amount <= 0 {
            return Result::<i32, String>::Err("nonpositive");
        }
        return Result::<i32, String>::Ok(amount * self.rate);
    }
}

#[inline("never")]
internal fn make(rate: i32) -> Bank {
    return Bank { rate: rate };
}

internal fn total(rate: i32, amount: i32) -> i32 {
    let quoted = make(rate).quote(amount);
    if let Ok(v) = quoted {
        return v;
    }
    return -1;
}

export fn run() {
    assert total(3, 7) == 21;
    assert total(3, 0) == -1;
}

__DATA__
{
    "stdout": "",
    "wir_expect:O2": ["Bank::quote\" = fn(i32, i32) -> [i32, i32, ref null \"core:prelude/string.wado//String\"]"]
}
