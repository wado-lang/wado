// u64 as u8 cast should emit i32.wrap_i64
use { println, Stdout } from "core:cli";

struct Wrapper {
    value: u64,
}

export fn run() with Stdout {
    // Local variable cast works fine
    let x: u64 = 65;
    let y = x as u8;
    assert y == 65 as u8;

    // Struct field cast is the actual bug
    let w = Wrapper { value: 65 };
    let z = w.value as u8;
    assert z == 65 as u8;
    println(`{z}`);
}

__DATA__
{"stdout": "65\n"}
