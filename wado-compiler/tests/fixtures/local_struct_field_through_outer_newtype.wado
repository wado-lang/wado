// A local struct's field may reach the enclosing function's parameter through
// a local newtype. The walks over the struct's members read that parameter as
// one the struct does not bind, as they read any free parameter.
use { println, Stdout } from "core:cli";

fn count<T>(x: T) -> i32 {
    type Items = List<T>;
    struct Holder {
        items: Items,
        n: i32,
    }
    let held = Holder { items: [x, x], n: 1 };
    return held.n + held.items.len();
}

export fn run() with Stdout {
    println(`${count(7)} ${count("a")}`);
}

__DATA__
{"stdout": "3 3\n"}
