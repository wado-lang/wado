// Error: a `matches` guard runs only when the pattern matches, so what it
// assigns does not reach past the expression.

export fn run() {
    let x: i32;
    let o = builtin::black_box(Option::<i32>::None);
    let ok = o matches { Some(v) && match v { _ => { x = 1; true } } };
    assert x == 1;
}

