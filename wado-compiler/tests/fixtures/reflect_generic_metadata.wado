// Generic `Reflect::<T>::…` resolution (WEP 2026-06-13): the trait-qualified
// metadata call resolves for a generic `T: Reflect`, not only a concrete struct.
// `type_name()` is value-free (returns `String`); `field_tokens()` yields the
// per-field `Member` face, so field names are read generically. The calls are
// dispatched to `T`'s synthesized methods after `T` is monomorphized to a
// concrete struct.

trait Described {
    fn describe(&self) -> String;
}

impl<T: Reflect<Fields = [..F]>, ..F> Described for T {
    fn describe(&self) -> String {
        let mut names: List<String> = [];
        for let f of Reflect::<T>::field_tokens() {
            names.push(f.name());
        }
        return `${Reflect::<T>::type_name()}(${names.join(",")})`;
    }
}

struct Point {
    x: i32,
    y: i32,
}

struct Person {
    name: String,
    age: i32,
    active: bool,
}

test "generic Reflect::<T> metadata resolves and monomorphizes per struct" {
    let p = Point { x: 1, y: 2 };
    assert p.describe() == "Point(x,y)";

    let q = Person { name: "a", age: 1, active: true };
    assert q.describe() == "Person(name,age,active)";
}

__DATA__
{"test": {}}
