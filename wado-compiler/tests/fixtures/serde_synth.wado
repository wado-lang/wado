use { Deserialize, DeserializeError, Serialize, SerializeError } from "core:serde";
use { from_string, to_string } from "core:json";

// from serde_synth_deserialize.wado
// Test: compiler-synthesized Deserialize for a struct

struct Point {
    x: f64,
    y: f64,
}

impl Deserialize for Point;

test "synthesized deserialize Point" {
    let r = from_string::<Point>(`\{"x":1.5,"y":2.5\}`);
    if let Ok(p) = r {
        assert p.x == 1.5;
        assert p.y == 2.5;
    } else {
        panic("deserialize Point failed");
    }
}

test "synthesized deserialize Point out-of-order fields" {
    let r = from_string::<Point>(`\{"y":3.0,"x":7.0\}`);
    if let Ok(p) = r {
        assert p.x == 7.0;
        assert p.y == 3.0;
    } else {
        panic("deserialize Point with out-of-order fields failed");
    }
}

struct User {
    user_name: String,
    age: i32,
    active: bool,
}

impl Deserialize for User;

test "synthesized deserialize User with camelCase keys" {
    let r = from_string::<User>(`\{"userName":"Alice","age":30,"active":true\}`);
    if let Ok(u) = r {
        assert u.user_name == "Alice";
        assert u.age == 30;
        assert u.active == true;
    } else {
        panic("deserialize User failed");
    }
}

// from serde_synth_roundtrip.wado
// Test: synthesized Serialize + Deserialize roundtrip

struct Config {
    host: String,
    port: i32,
    debug: bool,
}

impl Serialize for Config;
impl Deserialize for Config;

test "roundtrip Config" {
    let c = Config { host: "localhost", port: 8080, debug: true };
    let json_r = to_string::<Config>(&c);
    if let Ok(json) = json_r {
        assert json == `\{"host":"localhost","port":8080,"debug":true\}`;
        let parsed_r = from_string::<Config>(json);
        if let Ok(parsed) = parsed_r {
            assert parsed.host == "localhost";
            assert parsed.port == 8080;
            assert parsed.debug == true;
        } else {
            panic("from_string failed");
        }
    } else {
        panic("to_string failed");
    }
}

// from serde_synth_serialize.wado
// Test: compiler-synthesized Serialize for a struct
// (Point and User are declared once above; both Serialize and
// Deserialize impls apply to those single definitions.)

impl Serialize for Point;

test "synthesized serialize Point" {
    let p = Point { x: 1.5, y: 2.5 };
    let r = to_string::<Point>(&p);
    if let Ok(s) = r {
        assert s == `\{"x":1.5,"y":2.5\}`;
    } else {
        panic("serialize Point failed");
    }
}

impl Serialize for User;

test "synthesized serialize User with snake_case -> camelCase" {
    let u = User { user_name: "Alice", age: 30, active: true };
    let r = to_string::<User>(&u);
    if let Ok(s) = r {
        assert s == `\{"userName":"Alice","age":30,"active":true\}`;
    } else {
        panic("serialize User failed");
    }
}

__DATA__
{"test": {}}
