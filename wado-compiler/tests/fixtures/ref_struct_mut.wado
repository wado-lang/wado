// Mutating through a mutable reference

use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

fn move_point(p: &mut Point) {
    p.x = p.x + 10;
    p.y = p.y + 20;
}

export fn run() with Stdout {
    let mut p = Point { x: 1, y: 2 };
    move_point(&mut p);
    println(`{p.x},{p.y}`);
}

__DATA__
{"stdout": "11,22\n"}
