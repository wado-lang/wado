// An early exit `if i >= n { return }` leaves `i` below `i32::MAX`, so a later
// `i == i32::MAX` is false. With the constant on the left, `i32::MAX > i` asks
// the opposite and holds.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn probe(xs: &List<i32>, i: i32) -> i32 {
    if i >= xs.len() {
        return -1;
    }
    if 2147483647 > i {
        return 1;
    }
    return 0;
}

export fn run() with Stdout {
    let xs: List<i32> = builtin::black_box([1, 2, 3]);
    println(`${probe(&xs, builtin::black_box(1))}`);
}

__DATA__
{"stdout": "1\n"}
