// `-f contract-checks` checks the contract of a call marked `unchecked` at
// every optimization level.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let view = "abcdef".as_str_slice().slice(0, 3);
    let past = unchecked view.slice(0, builtin::black_box(5));
    println(`${past.len()}`);
}

__DATA__
{
    "codegen_flags": ["contract-checks"],
    "trapped": true
}
