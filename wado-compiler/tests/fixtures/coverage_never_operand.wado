// A loop or subscript whose operand is `!` keeps the regions written inside
// it, the loop body and the index, though none of them can run.
fn loop_over(c: bool) -> i32 {
    if c {
        for let v of panic("loop") {
            let _: ! = v;
        }
    }
    return 1;
}

fn enumerated(c: bool) -> i32 {
    if c {
        for let v of panic("enumerate").enumerate() {
            let _: ! = v;
        }
    }
    return 2;
}

fn subscript(c: bool) -> i32 {
    if c {
        return panic("index")[if c { 0 } else { 1 }];
    }
    return 3;
}

test "no operand diverges" {
    assert loop_over(false) == 1;
    assert enumerated(false) == 2;
    assert subscript(false) == 3;
}

__DATA__
{
  "test": {},
  "coverage": {
    "uncovered_lines": [5, 6, 14, 15, 23],
    "uncovered_branches": ["4:5 then", "13:5 then", "22:5 then", "23:31 then", "23:31 else"],
    "uncovered_functions": []
  }
}
