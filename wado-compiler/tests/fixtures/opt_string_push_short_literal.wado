// Regression test: the NIR `string_push` pass rewrites
// `buf.push_str(&"short_constant")` (≤8 ASCII bytes) into a sequence of
// per-byte appends, eliminating the temporary `String` allocation that the
// literal would otherwise materialize at lowering. The `const_ascii_push`
// pass then retargets each per-byte `push(<const char < 0x80>)` to
// `push_ascii(<byte>)`, skipping `encode_char`'s UTF-8 width dispatch; the
// inliner folds `push_ascii` into `internal_reserve_uninit(buf, 1)` +
// `array_set_u8(buf.repr, _, <byte>)`. Both passes run *before* `inline`;
// once the inliner expands `push_str`'s body the call node is gone
// and the literal-recognising rewrite cannot match.
//
// Background: at high inline thresholds (e.g. -O3 = 40, well above
// `push_str`'s body) the WIR-level idiom recogniser was bypassed because
// `push_str` got fully inlined, producing per-call temporary `String`
// allocations that tanked benchmarks like `fts -O3` (52ms → 449ms).
// Lifting the rewrite to NIR pre-`inline` keeps the recognition
// independent of inliner threshold decisions.
//
// We exercise three short-literal cases (1–3 ASCII bytes) and verify in
// the WIR that:
//   * each source byte is written directly with `array_set_u8` (the
//     inlined `push_ascii` fast path); and
//   * no `push_str`, char-`push`, or `encode_char` call survives — the
//     specialization avoids the temporary `String` alloc and the UTF-8
//     width dispatch for every short-literal site.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut buf = String::with_capacity(32);
    buf.push_str(&"0.");   // 2 bytes — '0' (48), '.' (46)
    buf.push_str(&".");    // 1 byte  — '.' (46)
    buf.push_str(&"inf");  // 3 bytes — 'i' (105), 'n' (110), 'f' (102)
    println(buf);
}

__DATA__
{
    "stdout": "0..inf\n",
    "wir_expect:O2": [
        "String::internal_reserve_uninit\"(buf, 1)",
        "array_set_u8(buf.repr,",
        ", 48)",
        ", 46)",
        ", 105)",
        ", 110)",
        ", 102)"
    ],
    "wir_not_expect:O2": [
        "String::push_str\"(",
        "String::push\"(",
        "encode_char"
    ],
    "wir_not_expect:O3": [
        "String::push_str\"(",
        "String::push\"(",
        "encode_char",
        "__inline_String__push_str_"
    ]
}
