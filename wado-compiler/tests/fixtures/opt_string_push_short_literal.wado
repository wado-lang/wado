// Regression test: a short constant `buf.push_str(&"…")` costs no temporary
// `String`. The append fusion reads only the literal's packed `repr`, which
// leaves an aggregate `const_object_globalization` hoists into a module
// global, and writes it with one `array_copy` into the run's single
// reservation. The fusion runs *before* `inline`; once the inliner expands
// `push_str`'s body the call node is gone and the rewrite cannot match.
//
// Background: at high inline thresholds (e.g. -O3 = 40, well above
// `push_str`'s body) the WIR-level idiom recogniser was bypassed because
// `push_str` got fully inlined, producing per-call temporary `String`
// allocations that tanked benchmarks like `fts -O3` (52ms → 449ms).
// Recognising the call at NIR pre-`inline` keeps this independent of
// inliner threshold decisions.
//
// We exercise three short-literal cases (1–3 ASCII bytes) and verify in
// the WIR that:
//   * each literal is a module global, copied in at its own offset within
//     the one reservation the fusion leaves for the whole adjacent run —
//     the buffer starts empty and nothing else writes it, so that
//     reservation's new length is the constant 6; and
//   * no `push_str`, char-`push`, or `encode_char` call survives, so
//     neither the temporary `String` nor the UTF-8 width dispatch is paid
//     at any short-literal site.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut buf = String::with_capacity(32);
    buf.push_str(&"0.");   // 2 bytes — '0' (48), '.' (46)
    buf.push_str(&".");    // 1 byte  — '.' (46)
    buf.push_str(&"inf");  // 3 bytes — 'i' (105), 'n' (110), 'f' (102)
    println(buf);
}

__DATA__
{
    "stdout": "0..inf\n",
    "wir_expect:O2": [
        "buf.used = 6;",
        "= array.new_fixed<u8>(48, 46);",
        "= array.new_fixed<u8>(46);",
        "= array.new_fixed<u8>(105, 110, 102);",
        "array_copy<u8>(self_{}, 0, global:opt_string_push_short_literal.wado::__const_obj_{}, 0, 2)",
        "array_copy<u8>(self_{}, 0 + 2, global:opt_string_push_short_literal.wado::__const_obj_{}, 0, 1)",
        "array_copy<u8>(self_{}, 0 + 3, global:opt_string_push_short_literal.wado::__const_obj_{}, 0, 3)"
    ],
    "wir_not_expect:O2": [
        "String::push_str\"(",
        "String::push\"(",
        "encode_char"
    ],
    "wir_not_expect:O3": [
        "String::push_str\"(",
        "String::push\"(",
        "encode_char",
        "$inline_String__push_str_"
    ]
}
