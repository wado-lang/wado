// A tuple is invariant in each element (WEP 2026-04-28 § "Container and
// aggregate types"), and a pack ahead of one does not relax that. Compared at
// the surrounding position instead, `Node` satisfied `EventTarget` by resource
// subtyping, the unexpanded pack deferred, and codegen got an invalid module.

#[cm("wasi:demo/events@0.1.0#event-target", linearity = "unrestricted")]
resource EventTarget {}

#[cm("wasi:demo/events@0.1.0#node", linearity = "unrestricted")]
resource Node extends EventTarget {}

fn widen<..Rest>(t: [..Rest, Node]) -> [..Rest, EventTarget] {
    return t;
}

export fn run() with EventTarget {
    let n = 1 as Node;
    let _ = widen([7, n]);
}

__DATA__
{"compile_error": "type mismatch: expected '[..Rest, EventTarget]', found '[..Rest, Node]'"}
