// An impl binding an affine type to an associated type not declared
// `affine type` is a type error: a body generic over the trait may copy the
// projection, as `twice` copies `I::Item` (WEP: Affine Types). The binding is
// read with the impl's parameters and the family's own, `affine` as written.

affine struct Tok {
    n: i32,
}

impl Drop for Tok {
    fn drop(self) {}
}

struct It {
    done: bool,
}

impl Iterator for It {
    type Item = Tok;

    fn next(&mut self) -> Option<Tok> {
        if self.done {
            return null;
        }
        self.done = true;
        return Option::Some(Tok { n: 1 });
    }
}

trait Back {
    type Item;
}

struct Wrap<affine T> {
    value: T,
}

impl<affine T> Back for Wrap<T> {
    type Item = T;
}

trait Store {
    type Buf<affine E>;
}

struct Bare {}

impl Store for Bare {
    type Buf<affine E> = E;
}

fn twice<I: Iterator>(i: &mut I) -> [Option<I::Item>, Option<I::Item>] with _ {
    let x = i.next();
    return [x, x];
}

export fn run() {
    let mut it = It { done: false };
    let pair = twice(&mut it);
}

__DATA__
{
    "compile_error": ":19:5: analysis error: affine type 'Tok' bound to 'Item', which may be copied: the trait does not declare it `affine type`",
    "compile_errors_contains": [
        "affine type 'T' bound to 'Item', which may be copied",
        "affine type 'E' bound to 'Buf', which may be copied"
    ]
}
