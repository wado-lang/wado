// An assignment into a field of a by-value call's result writes a temporary,
// even where the callee hands back storage it does not own, such as a global
// or a field of its receiver: the storage the value was read out of keeps its
// value. A later argument writing so leaves an earlier by-value one as taken.
//
// The callee that returns a value of its own is in `assign_field_of_call_result`.

struct Pair {
    a: i32,
    s: List<i32>,
}

struct Box {
    pair: Pair,
}

global mut GD: Pair = Pair { a: 1, s: [] };

#[inline("never")]
fn shared() -> Pair {
    return GD;
}

impl Box {
    #[inline("never")]
    fn get(&self) -> Pair {
        return self.pair;
    }

    #[inline("never")]
    fn whole(&self) -> Box {
        return *self;
    }
}

#[inline("never")]
fn two(p: Pair, q: Pair) -> i32 {
    return p.a * 10 + q.a;
}

export fn run() {
    shared().a = 1001;
    shared().s.push(1);
    if GD.a != 1 || GD.s.len() != 0 {
        panic("the write reached GD");
    }
    shared().a += 1000;
    if GD.a != 1 {
        panic("the compound write reached GD");
    }
    let b = Box { pair: Pair { a: builtin::black_box(1), s: [] } };
    b.get().a = 1001;
    b.whole().pair.a = 1001;
    if b.pair.a != 1 {
        panic("the write reached b.pair");
    }
    let f = Pair { a: builtin::black_box(1), s: [] };
    if two(GD, then: { shared().a = 1001; f }) != 11 {
        panic("the later argument's write reached the earlier one");
    }
}

__DATA__
{
    "stdout": ""
}
