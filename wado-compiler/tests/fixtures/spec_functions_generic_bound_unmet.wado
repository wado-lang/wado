// A call's type arguments must satisfy the callee's bounds: `i32` does not
// implement `Named`.

trait Named {
    fn name(&self) -> String;
}

fn greet<T: Named>(x: &T) -> String {
    return `Hello, ${x.name()}`;
}

test {
    assert greet(&1) == "Hello, 1";
}

