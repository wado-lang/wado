// Regression: WIR const-forwarding treated a labeled block's body as
// unconditionally executed. A reassignment after a conditional `break`
// only runs on the fall-through path, so its field facts must not
// survive the block: `a.len()` below is 5 when `c` breaks early and 6
// otherwise, and must not fold to either constant.

use { println, Stdout } from "core:cli";

#[inline("never")]
fn f(c: bool) -> i32 {
    let mut a: List<i32> = [1, 2, 3, 4, 5];
    outer: {
        if c {
            break outer;
        }
        a = [1, 2, 3, 4, 5, 6];
    }
    return a.len();
}

// `black_box` keeps `c` off the constant path: specializing `f` on it folds the
// break away, and the fall-through this test is about is gone with it.
export fn run() with Stdout {
    println(`${f(builtin::black_box(true))} ${f(builtin::black_box(false))}`);
}

__DATA__
{
    "stdout": "5 6\n"
}
