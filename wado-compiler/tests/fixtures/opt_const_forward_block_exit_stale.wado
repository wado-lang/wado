// Regression: WIR const-forwarding treated a labeled block's body as
// unconditionally executed. A reassignment after a conditional `break`
// only runs on the fall-through path, so its field facts must not
// survive the block: `a.len()` below is 5 when `c` breaks early and 6
// otherwise, and must not fold to either constant.
//
// `wir_scope` holds the patterns to `f`, so a bare `return 5;` elsewhere in
// the whole-program dump — the string encoder and the decimal-digit counter
// both hold one — cannot answer for the code under test.

use { println, Stdout } from "core:cli";

#[inline("never")]
fn f(c: bool) -> i32 {
    let mut a: List<i32> = [1, 2, 3, 4, 5];
    outer: {
        if c {
            break outer;
        }
        a = [1, 2, 3, 4, 5, 6];
    }
    return a.len();
}

export fn run() with Stdout {
    println(`${f(true)} ${f(false)}`);
}

__DATA__
{
    "stdout": "5 6\n",
    "wir_scope": "opt_const_forward_block_exit_stale.wado/f",
    "wir_not_expect:O2": [
        "return 6;",
        "return 5;"
    ]
}
