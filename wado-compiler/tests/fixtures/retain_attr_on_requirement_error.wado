// A requirement is dispatched to an impl, and the impl is what answers each of
// the attributes a body-less declaration carries. Stating one on the
// requirement would bind every call site to a promise no implementation makes.

struct Item {
    v: i32,
}

struct Bag {
    item: &Item,
}

trait Keeper {
    #[retain(item)]
    fn keep(&self, item: &Item) -> Bag;

    #[result(owned)]
    fn fresh(&self) -> Bag;

    #[trap(never)]
    fn safe(&self) -> i32;
}

interface Sink {
    #[retain(item)]
    fn take(item: &Item);

    // `#[immediate]` describes how codegen lowers one call, and a requirement
    // reaches an impl that is called rather than lowered.
    #[immediate(lane)]
    fn pick(lane: i32) -> i32;
}

export fn run() {}

__DATA__
{
    "compile_error": "`Keeper::keep` cannot declare `#[retain]`",
    "compile_errors_contains": [
        "`Keeper::fresh` cannot declare `#[result]`",
        "`Keeper::safe` cannot declare `#[trap]`",
        "`Sink::take` cannot declare `#[retain]`",
        "`Sink::pick` cannot declare `#[immediate]`"
    ]
}
