// Test closure passed to static method
use { println, Stdout } from "core:cli";

struct Transform {
    dummy: i32,
}

impl Transform {
    fn apply(value: i32, f: fn(i32) -> i32) -> i32 {
        return f(value);
    }
}

export fn run() with Stdout {
    // Static method call with closure argument
    let result = Transform::apply(5, |x: i32| x * 3);
    println(`result: {result}`);
}

__DATA__
{"stdout": "result: 15\n"}
