use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let a: i8 = 1;
    let b: i16 = 2;
    let c: char = 'A';
    let d: i64 = 100;
    let e: i128 = 999;
    let f = "hello";
    let g = [1, true, "world"];

    let s = { a, b, c, d, e, f, g };
    println(`{s.a}`);
    println(`{s.b}`);
    println(`{s.c}`);
    println(`{s.d}`);
    println(`{s.e}`);
    println(`{s.f}`);
    println(`{s.g.0}, {s.g.1}, {s.g.2}`);
}

__DATA__
{"stdout": "1\n2\nA\n100\n999\nhello\n1, true, world\n"}
