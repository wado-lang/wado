// A parameter's bound reading the trait's parameter is owed at the argument
// the trait is reached at: `bool` converts to `String`, not to `i32`.

trait Conv<X> with () {}

impl Conv<String> for bool {}

trait Store<X> with () {
    type Buf<E: Conv<X>>;
}

fn take<S: Store<i32>>(b: S::Buf<bool>) {}

export fn run() {}

