// Module with String::concat in match
use {println, Stdout} from "core:cli";

pub variant Align {
    Left,
    Right,
    Center,
}

pub struct Opts {
    align: Align,
    width: i32,
}

impl Opts {
    pub fn default() -> Opts {
        return Opts { align: Align::Right, width: 0 };
    }
}

pub fn format_str(s: String, opts: Opts) -> String {
    let pad = "  ";
    return match opts.align {
        Left => String::concat(s, pad),
        Right => String::concat(pad, s),
        Center => String::concat(String::concat(pad, s), pad),
    };
}

fn run() with Stdout {
    let opts = Opts::default();
    let s = format_str("hi", opts);
    println(`[{s}]`);
}

__DATA__
{"stdout": "[  hi]\n"}
