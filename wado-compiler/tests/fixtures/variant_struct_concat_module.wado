// Module with string concatenation in match
use { println, Stdout } from "core:cli";

pub variant Align {
    Left,
    Right,
    Center,
}

pub struct Opts {
    pub align: Align,
    pub width: i32,
}

impl Opts {
    pub fn default() -> Opts {
        return Opts { align: Align::Right, width: 0 };
    }
}

pub fn format_str(s: String, opts: Opts) -> String {
    let pad = "  ";
    return match opts.align {
        Left => s + pad,
        Right => pad + s,
        Center => pad + s + pad,
    };
}

export fn run() with Stdout {
    let opts = Opts::default();
    let s = format_str("hi", opts);
    println(`[{s}]`);
}

__DATA__
{"stdout": "[  hi]\n"}
