//! A slot the receiver mentions is the receiver's to fill, whatever spelling
//! it is mentioned in. The walk that read the receiver stopped at a wildcard,
//! so a slot named inside a function type — or a namespaced generic, or a type
//! pack — read as one only an argument could fill. `Holder::mk(7)` was then
//! rejected as a blanket, and the namespaced spelling reached WIR unresolved.

struct Holder<F> {
    f: F,
}

trait Mk<A> {
    fn mk(v: A) -> i32;
}

impl<T> Mk<T> for Holder<fn(T) -> i32> {
    fn mk(v: T) -> i32 {
        return 1;
    }
}

test "a slot the receiver mentions inside a function type is the receiver's" {
    assert Holder::mk(7) == 1;
}

__DATA__
{"test": {}}
