// Template string buffer hoisting in loops:
// The optimizer should hoist the String backing array before the loop,
// reusing it across iterations instead of allocating a new one each time.
// The optimization applies when the template result is bound to a Let variable
// that is only used as a method receiver (not passed as a function argument).
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Hoistable: template result used only via method receiver (.len())
    let mut total = 0;
    for let mut i = 0; i < 5; i += 1 {
        let s = `value=${i}`;
        total += s.len();
    }
    println(`total=${total}`);

    // Hoistable: multiple interpolations, result used only via receiver
    let mut total2 = 0;
    for let mut i = 0; i < 3; i += 1 {
        let x = i * 10;
        let s = `i=${i}, x=${x}`;
        total2 += s.len();
    }
    println(`total2=${total2}`);

    // Not hoisted: template result passed as function argument (may escape)
    for let mut i = 0; i < 3; i += 1 {
        let s = `item_${i}`;
        println(s);
    }
}

__DATA__
{"stdout": "total=35\ntotal2=26\nitem_0\nitem_1\nitem_2\n", "wir_expect:O2": ["__tmpl_buf_"]}
