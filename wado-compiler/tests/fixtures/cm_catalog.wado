//! CM value-type catalog as a fixture: one `identity` export per Component
//! Model value type, each returning its argument unchanged.
//!
//! Two harnesses consume this file:
//!
//! - `e2e.rs` discovers it as a `test`-world fixture (the empty `test` block
//!   below). That run only confirms a library-shaped source — `export fn`s plus
//!   a `test` block — compiles and instantiates under the test world; the
//!   `export fn`s are dropped in the test world, so it does not exercise
//!   lift/lower.
//! - `cm_catalog.rs` compiles this same source as a `--lib` (library world) and
//!   round-trips a crafted Component Model value through each `id_*` export,
//!   asserting `lift(lower(x)) == x`. That is the lift/lower binding test for
//!   value types outside any WASI world.

// --- Named types referenced by the identity exports below ---

pub struct Point {
    x: f64,
    y: f64,
}

pub enum Color {
    Red,
    Green,
    Blue,
}

pub variant Shape {
    Circle(f64),
    Rect([f64, f64]),
    Nothing,
}

pub flags Perms {
    Read,
    Write,
    Execute,
}

pub type Meters = f64;

// --- Primitives ---

export fn id_bool(v: bool) -> bool {
    return v;
}
export fn id_u8(v: u8) -> u8 {
    return v;
}
export fn id_u16(v: u16) -> u16 {
    return v;
}
export fn id_u32(v: u32) -> u32 {
    return v;
}
export fn id_u64(v: u64) -> u64 {
    return v;
}
export fn id_s8(v: i8) -> i8 {
    return v;
}
export fn id_s16(v: i16) -> i16 {
    return v;
}
export fn id_s32(v: i32) -> i32 {
    return v;
}
export fn id_s64(v: i64) -> i64 {
    return v;
}
export fn id_f32(v: f32) -> f32 {
    return v;
}
export fn id_f64(v: f64) -> f64 {
    return v;
}
export fn id_char(v: char) -> char {
    return v;
}
export fn id_string(v: String) -> String {
    return v;
}

// --- Built-in containers ---

export fn id_list_u8(v: List<u8>) -> List<u8> {
    return v;
}
export fn id_list_string(v: List<String>) -> List<String> {
    return v;
}
export fn id_tuple_pair(v: [u32, String]) -> [u32, String] {
    return v;
}
export fn id_tuple_triple(v: [u8, bool, char]) -> [u8, bool, char] {
    return v;
}
export fn id_option_u32(v: Option<u32>) -> Option<u32> {
    return v;
}
export fn id_option_string(v: Option<String>) -> Option<String> {
    return v;
}

// `result` in all four WIT forms: both arms, ok-only, err-only, neither.
export fn id_result_both(v: Result<u32, String>) -> Result<u32, String> {
    return v;
}
export fn id_result_ok(v: Result<u32, ()>) -> Result<u32, ()> {
    return v;
}
export fn id_result_err(v: Result<(), String>) -> Result<(), String> {
    return v;
}
export fn id_result_unit(v: Result<(), ()>) -> Result<(), ()> {
    return v;
}

// --- Named value types ---

export fn id_record(v: Point) -> Point {
    return v;
}
export fn id_enum(v: Color) -> Color {
    return v;
}
export fn id_variant(v: Shape) -> Shape {
    return v;
}
export fn id_flags(v: Perms) -> Perms {
    return v;
}
export fn id_newtype(v: Meters) -> Meters {
    return v;
}

// --- Nested compositions ---

export fn id_list_option(v: List<Option<u32>>) -> List<Option<u32>> {
    return v;
}
export fn id_option_list(v: Option<List<u8>>) -> Option<List<u8>> {
    return v;
}
export fn id_list_record(v: List<Point>) -> List<Point> {
    return v;
}
export fn id_option_record(v: Option<Point>) -> Option<Point> {
    return v;
}
export fn id_list_tuple(v: List<[u32, String]>) -> List<[u32, String]> {
    return v;
}
export fn id_result_list(v: Result<List<Point>, String>) -> Result<List<Point>, String> {
    return v;
}

// --- Association list (the CM map idiom: `list<tuple<k, v>>`) ---

export fn id_assoc_array(v: List<[String, u32]>) -> List<[String, u32]> {
    return v;
}

// --- Tuples carrying aggregate (non-primitive) elements ---

export fn id_tuple_record(v: [Point, u32]) -> [Point, u32] {
    return v;
}
export fn id_tuple_option(v: [Option<u32>, u8]) -> [Option<u32>, u8] {
    return v;
}
export fn id_tuple_list(v: [List<String>, u32]) -> [List<String>, u32] {
    return v;
}
export fn id_list_tuple_record(v: List<[Point, u32]>) -> List<[Point, u32]> {
    return v;
}

// The empty test block makes `e2e.rs` accept this as a test-world fixture: it
// confirms a library-shaped source compiles and instantiates under the test
// world. The lift/lower round-trip lives in `cm_catalog.rs`.
test "library shape compiles under the test world" {
}

__DATA__
{"test": {}}
