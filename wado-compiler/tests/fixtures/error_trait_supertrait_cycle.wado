// A trait that reaches itself through supertraits can never be implemented,
// so the cycle is an error at the declaration.
trait A: B with () {
    fn a(&self) -> i32;
}

trait B: A with () {
    fn b(&self) -> i32;
}

export fn run() {
}

__DATA__
{"compile_error": "circular supertrait", "compile_error_codes": ["TRAIT_DECL_INVALID"]}
