// A marker asks for the impl the derivation rule gives, and beside a written
// `eq` the rule gives no `Ord`.

struct Name {
    text: String,
}

impl Eq for Name {
    fn eq(&self, other: &Self) -> bool {
        return self.text.len() == other.text.len();
    }
}

impl Ord for Name;

test {}

