use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

export fn run() with Stdout {
    let empty: Array<i32> = [];
    println(`{empty:#?}`);

    let nums: Array<i32> = [1, 2, 3];
    println(`{nums:#?}`);

    let points: Array<Point> = [
        Point { x: 1, y: 2 },
        Point { x: 3, y: 4 },
    ] as Array<Point>;
    println(`{points:#?}`);
}

__DATA__
{
    "stdout": "[]\n[\n  1,\n  2,\n  3,\n]\n[\n  Point {\n    x: 1,\n    y: 2,\n  },\n  Point {\n    x: 3,\n    y: 4,\n  },\n]\n"
}
