// An operator in a tuple `for-of` body whose left operand settles only after
// the loop selects for each element the impl that element's right operand
// reaches.

struct Bx<T> { v: Option<T> }

fn empty<T>() -> Bx<T> { return Bx { v: null }; }

impl Add<i32> for Bx<i32> {
    type Output = i32;
    fn add(&self, rhs: &i32) -> i32 { return 1; }
}

impl Add<String> for Bx<i32> {
    type Output = i32;
    fn add(&self, rhs: &String) -> i32 { return 2; }
}

impl Add<i32> for Bx<bool> {
    type Output = i32;
    fn add(&self, rhs: &i32) -> i32 { return 3; }
}

trait Conv<A> with () {
    fn conv(&self, a: A) -> i32;
}

impl Conv<i32> for Bx<i32> {
    fn conv(&self, a: i32) -> i32 { return 4; }
}

impl Conv<String> for Bx<i32> {
    fn conv(&self, a: String) -> i32 { return 5; }
}

impl Conv<i32> for Bx<bool> {
    fn conv(&self, a: i32) -> i32 { return 6; }
}

test "operator" {
    let b = empty();
    let mut got: List<i32> = [];
    for let v of [10, "s"] {
        got.push(b + v);
    }
    let _settled: Bx<i32> = b;
    assert got[0] == 1;
    assert got[1] == 2;
}

test "method call" {
    let b = empty();
    let mut got: List<i32> = [];
    for let v of [10, "s"] {
        got.push(b.conv(v));
    }
    let _settled: Bx<i32> = b;
    assert got[0] == 4;
    assert got[1] == 5;
}
