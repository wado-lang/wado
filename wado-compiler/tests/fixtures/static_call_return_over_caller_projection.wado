// A static call's return type over a projection off the caller's parameter
// is answered by the caller's bound: `S::Item` is `i64` here, in every
// spelling.
use lib from "./sub/static_call_arg_over_caller_projection_lib.wado";
use { Holder, W } from "./sub/static_call_arg_over_caller_projection_lib.wado";

struct Box {
    v: i32,
}

impl Holder for Box {
    type Item = i64;
}

fn inferred<S: Holder<Item = i64>>(s: S) -> i64 {
    return W::give(s, 5);
}

fn turbofish<S: Holder<Item = i64>>(s: S) -> i64 {
    return W::<S>::give(s, 6);
}

fn namespaced<S: Holder<Item = i64>>(s: S) -> i64 {
    return lib::W::give(s, 7);
}

test "the caller's bound answers the return type" {
    assert inferred(Box { v: 1 }) == 5;
    assert turbofish(Box { v: 1 }) == 6;
    assert namespaced(Box { v: 1 }) == 7;
}
