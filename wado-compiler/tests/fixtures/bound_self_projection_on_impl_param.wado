// A bound on an `impl` block's own type parameter may write `Self::Assoc`. The
// block binds `Self` to its target, so `Uses<Self::Item>` reads as `Uses<i32>`
// here. The target is resolved from the block's own names, so `Self` is
// established between binding those names and reading the bounds that pin it.

trait Uses<A> with () {
    fn go(&self, a: A) -> i32;
}

trait Src with () {
    type Item;
}

trait Run with () {
    fn run(&self, a: i32) -> i32;
}

struct Worker {}

impl Uses<i32> for Worker {
    fn go(&self, a: i32) -> i32 {
        return a * 2;
    }
}

struct Wrap<O> {
    o: O,
}

impl<O> Src for Wrap<O> {
    type Item = i32;
}

impl<O: Uses<Self::Item>> Run for Wrap<O> {
    fn run(&self, a: i32) -> i32 {
        return self.o.go(a);
    }
}

test "Self::Assoc in a bound on an impl block's own parameter" {
    assert Wrap { o: Worker {} }.run(2) == 4;
}

__DATA__
{"test": {}}
