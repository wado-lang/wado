// Two reference blankets of one trait tied on a `&self` method answer only
// where the referent has no method of the name, so only there is the tie
// reported.

trait Near with () {
    fn near() -> i32;
}

trait Far with () {
    fn far() -> i32;
}

struct Point {
    x: i32,
}

impl Near for Point {
    fn near() -> i32 {
        return 1;
    }
}

impl Far for Point {
    fn far() -> i32 {
        return 2;
    }
}

trait Name with () {
    fn name(&self) -> String;
    fn other(&self) -> String;
}

trait Base with () {
    fn name(&self) -> String;
}

impl<T: Near> Name for &T {
    fn name(&self) -> String {
        return "near";
    }

    fn other(&self) -> String {
        return "near";
    }
}

impl<T: Far> Name for &T {
    fn name(&self) -> String {
        return "far";
    }

    fn other(&self) -> String {
        return "far";
    }
}

impl Base for Point {
    fn name(&self) -> String {
        return "base";
    }
}

export fn run() {
    let p = Point { x: 1 };
    assert (&p).name() == "base";
    let _ = (&p).other();
}

