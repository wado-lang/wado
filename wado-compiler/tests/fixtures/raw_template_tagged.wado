// A tag over a raw template sees the text as written in both `lit` and `raw`,
// and `hashes()`, a constant of the type, says how many `#`s delimit it, so a
// raw template inspects as written.
use { println, Stdout } from "core:cli";
use { ReflectTemplate } from "core:prelude";

fn segments<T: ReflectTemplate<Holes = [..V]>, ..V>(t: T) -> String {
    let mut out = `${ReflectTemplate::<T>::hashes()}`;
    for let h of ReflectTemplate::<T>::members() {
        out.push_str(&`[${h.lit(&t)}|${h.raw(&t)}]`);
    }
    out.push_str(&`[${ReflectTemplate::<T>::tail(&t)}|${ReflectTemplate::<T>::raw_tail(&t)}]`);
    return out;
}

fn inspected<T: ReflectTemplate<Holes = [..V]> + Inspect, affine ..V>(t: T) -> String {
    return `${t:?}`;
}

export fn run() with Stdout {
    let n = builtin::black_box(7);
    println(segments##`\d${n}a`b`##);
    println(segments`\t${n}`);
    println(inspected#`\d=${n}`#);
    println(inspected##`a`#b${n}`##);
    println(inspected`\\d=${n}`);
}

__DATA__
{"stdout": "2[\\d|\\d][a`b|a`b]\n0[\t|\\t][|]\n#`\\d=${7}`#\n##`a`#b${7}`##\n`\\\\d=${7}`\n"}
