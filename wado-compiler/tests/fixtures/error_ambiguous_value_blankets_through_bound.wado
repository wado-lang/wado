// Two value blankets holding of one type are as ambiguous when a bound reaches
// them as when a method call does: neither may win by declaration order.

trait Limit with () {
    fn limit(&self) -> i32;
}

trait Mark with () {
    fn mark(&self) -> i32;
}

trait Describe with () {
    fn describe(&self) -> String;
}

impl<T: Limit> Describe for T {
    fn describe(&self) -> String {
        return "limit";
    }
}

impl<T: Mark> Describe for T {
    fn describe(&self) -> String {
        return "mark";
    }
}

struct Point {
    x: i32,
}

impl Limit for Point {
    fn limit(&self) -> i32 {
        return 1;
    }
}

impl Mark for Point {
    fn mark(&self) -> i32 {
        return 2;
    }
}

fn via<T: Describe>(x: T) -> String {
    return x.describe();
}

export fn run() {
    let _ = via(Point { x: 1 });
}

__DATA__
{"compile_error": "ambiguous blanket impls of 'Describe' for 'Point': 'T: Limit' and 'T: Mark' apply"}
