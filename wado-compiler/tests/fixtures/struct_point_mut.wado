// Mutable struct field assignment

use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

fn run() with Stdout {
    let mut p = Point { x: 10, y: 20 };
    println(`before: {p.x}, {p.y}`);
    p.x = 100;
    p.y = 200;
    println(`after: {p.x}, {p.y}`);
}

__DATA__
{"stdout": "before: 10, 20\nafter: 100, 200\n"}
