// Test match expression with bool literal patterns

use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let t = true;
    let f = false;

    let r1 = match t {
        true => "yes",
        false => "no",
    };


    println(r1);

    let r2 = match f {
        true => "yes",
        false => "no",
    };


    println(r2);

    // With wildcard
    let r3 = match t {
        false => "no",
        _ => "yes",
    };


    println(r3);
}

__DATA__
{"stdout": "yes\nno\nyes\n"}
