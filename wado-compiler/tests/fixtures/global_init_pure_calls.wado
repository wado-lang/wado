// What a global initializer may do is what performs no effect, and the purity
// check has to agree with the effect checker on what that is: an effect
// parameter that binds to nothing concrete demands nothing, an operation with a
// default body needs no handler, and a closure literal's body is read where it
// is written, as it is inside a function.

use { println, Stdout } from "core:cli";

interface Log {
    fn level() -> i32 {
        return 3;
    }
}

fn apply<T, effect E>(f: fn(T) -> T with E, x: T) -> T with E {
    return f(x);
}

// `E` binds to no concrete effect here, so the call demands none.
global APPLIED: i32 = apply(|n| n + 1, 41);

// A closure whose body performs nothing is a value like any other.
global DOUBLER: fn(i32) -> i32 = |n| n * 2;

// No handler is installed, so the default body runs.
global LEVEL: i32 = Log::level();

export fn run() with Stdout {
    assert APPLIED == 42;
    assert LEVEL == 3;
    assert DOUBLER(21) == 42;
    println(`${APPLIED} ${LEVEL}`);
}

__DATA__
{
    "stdout": "42 3\n"
}
