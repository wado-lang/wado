// Test basic type alias (newtype) declarations

use { println, Stdout } from "core:cli";

// Type alias creates distinct types (like WASI's Instant and Duration)
type Instant = u64;
type Duration = u64;

export fn run() with Stdout {
    // Use type alias in variable declaration
    let now: Instant = 1000;
    let later: Instant = 2000;

    if now == 1000 {
        println("type alias works");
    }

    if later > now {
        println("comparison works");
    }

    // Arithmetic on same newtype returns the newtype
    // Instant - Instant -> Instant, so we need explicit cast to Duration
    let elapsed: Duration = (later - now) as Duration;

    if elapsed == 1000 {
        println("arithmetic works");
    }
}

__DATA__
{"stdout": "type alias works\ncomparison works\narithmetic works\n"}
