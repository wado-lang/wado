// Stage 1.5: an `if cond { return … }` (or `panic(…)` / `unreachable()`)
// whose then-branch doesn't fall through MUST NOT poison the post-if
// field-env state. Only the implicit-else path reaches past the if-stmt,
// and that path equals the pre-if state.
//
// Without this, the conservative `clear_fields()` after every if-stmt
// dropped `arr.used = 16`, so a subsequent `1 >= arr.len()`
// could not const-fold. With this fix plus the literal-bound
// `condition_implication` extension (so a folded `1 >= 16` doesn't
// break loop-guard elimination elsewhere), Stage 1.5 lands without
// regression.

use { println, Stdout } from "core:cli";

fn early_exit_preserves_arr_len(force_exit: bool) -> i32 {
    let arr: List<u16> = List::filled(16, 0 as u16);
    // Trapping then-branch (no else, control returns).
    if force_exit {
        return -1;
    }
    // After the if, `arr.used = 16` should still be in field_env;
    // `1 >= arr.len()` then folds to `false` and
    // the panic is pruned at NIR.
    if 1 >= arr.len() {
        panic("dead_trapping_then_28491");
    }
    return arr.len();
}

export fn run() with Stdout {
    let a = early_exit_preserves_arr_len(false);
    let b = early_exit_preserves_arr_len(true);
    println(`{a},{b}`);
}

__DATA__
{
    "stdout": "16,-1\n",
    "wir_not_expect:O2": ["dead_trapping_then_28491"]
}
