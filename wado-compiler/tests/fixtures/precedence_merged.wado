test "arithmetic precedence" {
    let a = 2 + 3 * 4;
    assert a == 14;
    let b = 10 - 8 / 2;
    assert b == 6;
    let c = 5 + 7 % 3;
    assert c == 6;
    let d = 20 / 4 * 2;
    assert d == 10;
    let e = 10 - 3 + 2;
    assert e == 9;
    let f = 2 + 3 * 4 - 6 / 2;
    assert f == 11;
    let g = 2.0 + 3.0 * 4.0;
    assert g == 14.0;
    let h = 10.0 - 8.0 / 2.0;
    assert h == 6.0;
}

test "assignment precedence" {
    let mut a = 0;
    a = 2 + 3;
    assert a == 5;
    let mut b = 0;
    b = 2 * 3 + 1;
    assert b == 7;
    let c = 5 > 3;
    assert c == true;
    let d = true && false;
    assert d == false;
    let e = true || false;
    assert e == true;
    let f = 3 | 4;
    assert f == 7;
    let g = 7 & 3;
    assert g == 3;
    let mut h = 0;
    let mut i = 0;
    h = i = 42;
    assert h == 42;
    assert i == 42;
    let j = 2 + 3 * 4 - 1;
    assert j == 13;
}

test "bitwise precedence" {
    let a = 0b0011 | 0b0100 & 0b0110;
    assert a == 0b0111;
    let b = 0b01 | 0b10 ^ 0b11;
    assert b == 0b01;
    let c = 0b111 ^ 0b011 & 0b101;
    assert c == 0b110;
    let d = 0b001 & 0b001 << 2;
    assert d == 0b000;
    let e = 0b1000 | 0b10000 >> 2;
    assert e == 0b1100;
    let f = 0b001 | 0b010 & 0b011 ^ 0b100;
    assert f == 0b111;
    let g = 0b1111 & 0b0111 & 0b0011;
    assert g == 0b0011;
    let h = 0b001 | 0b010 | 0b100;
    assert h == 0b111;
}

test "bitwise vs comparison precedence" {
    let bits = 12;
    let mask = 4;
    let expected = 4;
    let result_and = bits & mask == expected;
    assert result_and == true;
    let result_or = 1 | 2 == 3;
    assert result_or == true;
    let result_xor = 5 ^ 3 == 6;
    assert result_xor == true;
    let result_ne = 7 & 3 != 0;
    assert result_ne == true;
    let result_lt = 8 & 7 < 10;
    assert result_lt == true;
    let result_gt = 15 | 1 > 10;
    assert result_gt == true;
    let result_le = 6 ^ 2 <= 4;
    assert result_le == true;
    let result_ge = 3 & 7 >= 3;
    assert result_ge == true;
    let complex = 12 & 8 | 4 == 12;
    assert complex == true;
}

test "comparison chaining" {
    let a = 1 < 2 < 3;
    assert a == true;
    let b = 1 < 3 < 2;
    assert b == false;
    let c = 3 > 2 > 1;
    assert c == true;
    let x = 5;
    let d = 0 <= x <= 10;
    assert d == true;
    let y = 15;
    let e = 0 <= y <= 10;
    assert e == false;
    let f = 10 >= 5 >= 0;
    assert f == true;
    let g = 5 == 5 == 5;
    assert g == true;
    let h = 5 == 5 == 6;
    assert h == false;
    let i = 1 < 2 < 3 < 4;
    assert i == true;
}

test "comparison vs logical precedence" {
    let a = 1 < 2 && 3 < 4;
    assert a == true;
    let b = true || false && false;
    assert b == true;
    let c = false && true || true;
    assert c == true;
    let d = 1 == 1 && 2 == 2 || 3 == 4;
    assert d == true;
    let e = 1 == 2 || 3 == 3 && 4 == 4;
    assert e == true;
    let f = true && true && false;
    assert f == false;
    let g = false || false || true;
    assert g == true;
    let h = 5 > 3 && 10 <= 10 || 1 != 1;
    assert h == true;
    let i = 2 >= 3 || 4 < 5 && 6 == 6;
    assert i == true;
}

test "parentheses" {
    let without_parens = 2 + 3 * 4;
    let with_parens = (2 + 3) * 4;
    assert without_parens == 14;
    assert with_parens == 20;
}

test "shift vs arithmetic precedence" {
    let a = 1 << 2 + 1;
    assert a == 8;
    let b = 16 >> 4 - 2;
    assert b == 4;
    let c = 1 << 2 * 2;
    assert c == 16;
    let d = 1 << 1 + 2;
    assert d == 8;
    let e = (1 << 2) + 3;
    assert e == 7;
    let f = 64 >> 2 >> 1;
    assert f == 8;
    let g = 1 << 2 << 1;
    assert g == 8;
    let h = 8 & 4 << 1;
    assert h == 8;
    let i = 15 >> 1 & 3;
    assert i == 3;
}

test "unary precedence" {
    let a = -3 + 5;
    assert a == 2;
    let b = -2 * 3;
    assert b == -6;
    let c = 10 - -3;
    assert c == 13;
    let d = !true || true;
    assert d == true;
    let e = !false && false;
    assert e == false;
    let f = ~0 + 2;
    assert f == 1;
    let g = ~1 & 3;
    assert g == 2;
    let h = - -5;
    assert h == 5;
    let i = !!true;
    assert i == true;
    let j = !!false;
    assert j == false;
    let k = ~~0;
    assert k == 0;
    let n = -5 < 0;
    assert n == true;
    let o = !true == false;
    assert o == true;
    let p = -2 + 3 * -4;
    assert p == -14;
}

__DATA__
{"test": {}}
