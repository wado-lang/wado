// Basic impl block for struct

use { println } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

impl Point {
    pub fn sum(&self) -> i32 {
        return self.x + self.y;
    }
}

export fn run() with Stdout {
    let p = Point { x: 10, y: 20 };
    let s = p.sum();
    println(`sum: {s}`);
}

__DATA__
{"stdout": "sum: 30\n"}
