// Compile-only test for wasi:clocks/timezone
// Timezone is not yet implemented in wasmtime, so we only verify compilation.

use { SystemClock, Instant, Timezone } from "wasi:clocks";

export fn run() with SystemClock, Timezone {
    let now: Instant = SystemClock::now();
    let offset = Timezone::utc_offset(now);
    if let Some(ns) = offset {
        let day_ns: i64 = 86_400_000_000_000;
        if ns >= 0 {
            assert ns < day_ns;
        } else {
            assert ns > -day_ns;
        }
    }
    let debug = Timezone::to_debug_string();
    assert debug.len() > 0;
    let id = Timezone::iana_id();
    if let Some(name) = id {
        assert name.len() > 0;
    }
}

