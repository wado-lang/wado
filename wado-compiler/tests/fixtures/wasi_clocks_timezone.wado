// E2E test for wasi:clocks/timezone.
//
// Wasmtime ships only the binding for this interface (gated by the unstable
// `clocks-timezone` feature) and not the host implementation, so the test
// runtime in `tests/common.rs` (and `wado run`/`wado serve` via
// `wado_cli::timezone_host`) wires its own implementation backed by
// `localtime_r` + the `iana-time-zone` crate.

use { SystemClock, Instant, Timezone } from "wasi:clocks";

export fn run() with SystemClock, Timezone {
    let now: Instant = SystemClock::now();
    let offset = Timezone::utc_offset(now);
    if let Some(ns) = offset {
        let day_ns: i64 = 86_400_000_000_000;
        if ns >= 0 {
            assert ns < day_ns;
        } else {
            assert ns > -day_ns;
        }
    }
    let debug = Timezone::to_debug_string();
    assert debug.len() > 0;
    let id = Timezone::iana_id();
    if let Some(name) = id {
        assert name.len() > 0;
    }
}

__DATA__
{}
