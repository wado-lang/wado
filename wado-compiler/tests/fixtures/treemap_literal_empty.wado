// TreeMap literal: empty map
use { println } from "core:cli";
use { TreeMap } from "core:collections";

export fn run() with Stdout {
    let m: TreeMap<String, i32> = {  };

    assert m.len() == 0;
    assert m.is_empty();

    println("empty literal: ok");
}

__DATA__
{"stdout": "empty literal: ok\n"}
