// Test constant folding with various integer types
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // i64
    let a = 1000000 as i64 * 1000000 as i64;
    println(`a={a}`);

    // u32
    let b = 100 as u32 + 200 as u32;
    println(`b={b}`);

    // Division
    let c = 100 / 3;
    println(`c={c}`);

    // Subtraction producing zero
    let d = 42 - 42;
    println(`d={d}`);

    // Multiplication by zero
    let e = 999 * 0;
    println(`e={e}`);

    // Modulo
    let f = 17 % 5;
    println(`f={f}`);
}

__DATA__
{"stdout": "a=1000000000000\nb=300\nc=33\nd=0\ne=0\nf=2\n"}
