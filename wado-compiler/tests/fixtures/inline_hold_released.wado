// Test: a callee held for a fold that never comes still receives inlining.
//
// `lookup` is over the `-O2` budget as written, and a constant table would
// unroll the scan loop away. So the inliner holds it,
// splicing nothing into it, to keep that admission open for the constants a
// later round may bring. No call site ever passes one, so once the loop has
// converged with the hold in place there is nothing left to wait for: the
// hold is released, and `List::len` and the by-reference iterator inline into
// `lookup` like any other function's callees.

struct Table {
    ids: List<i32>,
    defaults: List<i32>,
}

fn lookup(t: &Table, kind: i32) -> i32 {
    if kind >= 0 && kind < t.ids.len() {
        for let id of &t.ids {
            if *id == kind {
                return kind * 2;
            }
        }
    }
    if kind >= 0 && kind < t.defaults.len() {
        return t.defaults[kind];
    }
    return -1;
}

// A read of a global may still fold, so the table and the kind may still turn
// constant; these globals are written, so they never do.
global mut FIRST_ID: i32 = 5;
global mut KIND: i32 = 0;

export fn run() {
    FIRST_ID = builtin::black_box(FIRST_ID);
    exercise(Table {
        ids: [FIRST_ID, 1, 7],
        defaults: [10, 20, 30],
    });
}

// Kept out of `run`, which lands in the CM export wrapper: glue takes no
// callee at its one site.
#[inline("never")]
fn exercise(t: Table) {
    KIND = builtin::black_box(1);
    assert lookup(&t, KIND) == 2;
    KIND = builtin::black_box(2);
    assert lookup(&t, KIND) == 30;
    KIND = builtin::black_box(9);
    assert lookup(&t, KIND) == -1;
}

__DATA__
{
    "stdout": "",
    "wir_pass": {"O2": ["nir/inline"]},
    "wir_contrast": {"O2": [
        {"    KIND = builtin::black_box(2);\n    assert lookup(&t, KIND) == 30;\n    KIND = builtin::black_box(9);\n    assert lookup(&t, KIND) == -1;\n": ""}
    ]},
    "wir_not_expect:O2": ["List<i32>::len$sroa[self.used]\"(", "Iterator::next\"("],
    "wir_expect:O2": ["\"inline_hold_released.wado/lookup\"("]
}
