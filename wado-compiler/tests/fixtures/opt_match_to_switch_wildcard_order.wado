// `match` is first-match-wins, so a wildcard arm matches everything from its
// position on and every later arm is dead. `match_to_switch` must not route a
// dead literal arm's value to its own arm: `classify(12)` and `classify(13)`
// must hit the wildcard (100), not the unreachable `12 => 999` / `13 => 999`
// arms. The live arms above the wildcard keep the match dense enough to lower
// to a `Switch`; the `wir_expect` is what holds it to that path rather than the
// generic fallback, which a raised `SWITCH_MIN_CASES` would otherwise drop it to
// while it stayed green.
use { println, Stdout } from "core:cli";

#[inline(never)]
fn classify(x: i32) -> i32 {
    return match x {
        0 => 0,
        1 => 10,
        2 => 20,
        3 => 30,
        4 => 40,
        5 => 50,
        6 => 60,
        7 => 70,
        8 => 80,
        9 => 90,
        10 => 100,
        11 => 110,
        _ => 100,
        12 => 999,
        13 => 999,
    };
}

export fn run() with Stdout {
    assert classify(3) == 30;
    assert classify(11) == 110;
    assert classify(12) == 100;
    assert classify(13) == 100;
    assert classify(42) == 100;
    println("ok");
}

__DATA__
{ "stdout": "ok\n", "wir_expect:O2": ["br_table"] }
