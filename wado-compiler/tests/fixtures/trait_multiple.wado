use { println, Stdout } from "core:cli";

// from trait_multiple_impls.wado
trait Describe {
    fn describe(&self) -> String;
}

struct Cat {
    name: String,
}

struct Dog {
    name: String,
}

impl Describe for Cat {
    fn describe(&self) -> String {
        return `A cat named ${self.name}`;
    }
}

impl Describe for Dog {
    fn describe(&self) -> String {
        return `A dog named ${self.name}`;
    }
}

// from trait_multiple_methods.wado
trait Shape {
    fn area(&self) -> f64;
    fn perimeter(&self) -> f64;
    fn name(&self) -> String;
}

struct Rectangle {
    width: f64,
    height: f64,
}

impl Shape for Rectangle {
    fn area(&self) -> f64 {
        return self.width * self.height;
    }

    fn perimeter(&self) -> f64 {
        return 2.0 * (self.width + self.height);
    }

    fn name(&self) -> String {
        return "Rectangle";
    }
}

// from trait_multiple_impls.wado
fn trait_multiple_impls() with Stdout {
    let cat = Cat { name: "Whiskers" };
    let dog = Dog { name: "Buddy" };
    println(cat.describe());
    println(dog.describe());
}

// from trait_multiple_methods.wado
fn trait_multiple_methods() with Stdout {
    let r = Rectangle { width: 3.0, height: 4.0 };
    println(r.name());
    println(`Area: ${r.area()}`);
    println(`Perimeter: ${r.perimeter()}`);
}

export fn run() with Stdout {
    trait_multiple_impls();
    trait_multiple_methods();
}

__DATA__
{"stdout": "A cat named Whiskers\nA dog named Buddy\nRectangle\nArea: 12\nPerimeter: 14\n"}
