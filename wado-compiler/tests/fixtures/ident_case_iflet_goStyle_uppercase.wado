// if-let chain with uppercase binding name (replaces Go-style test)
// `if let UPPER = expr && cond` should bind UPPER as a variable.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let opt = Option::<i32>::Some(42);
    if let VAL = opt && VAL matches { Some(_) } {
        println("has value");
    }

    // Uppercase binding used in guard
    if let N = 10 && N > 5 {
        println("N>5");
    }
}

__DATA__
{
    "stdout": "has value\nN>5\n"
}
