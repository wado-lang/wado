// A user-defined sequence target: sequence-literal coercion works for any type
// with a `From<Array<T>>` impl.
use { println, Stdout } from "core:cli";

struct SeqVec<T> {
    items: List<T>,
}

impl SeqVec<T> {
    fn new() -> SeqVec<T> {
        return SeqVec { items: [] };
    }

    fn len(&self) -> i32 {
        return self.items.len();
    }

    fn get(&self, i: i32) -> T {
        return self.items[i];
    }
}

impl From<Array<T>> for SeqVec<T> {
    fn from(elements: Array<T>) -> SeqVec<T> {
        let mut out = SeqVec::<T>::new();
        for let element of elements {
            out.items.push(element);
        }
        return out;
    }
}

export fn run() with Stdout {
    // Type annotation coercion
    let s: SeqVec<i32> = [10, 20, 30];

    assert s.len() == 3;
    assert s.get(0) == 10;
    assert s.get(1) == 20;
    assert s.get(2) == 30;

    // Explicit cast
    let s2 = [1, 2, 3] as SeqVec<i32>;
    assert s2.len() == 3;

    println("sequence-literal-custom: ok");
}

__DATA__
{"stdout": "sequence-literal-custom: ok\n"}
