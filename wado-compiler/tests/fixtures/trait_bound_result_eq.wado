// Test: Result<T, E> == Result<T, E> requires T: Eq and E: Eq
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let a: Result<i32, String> = Result::<i32, String>::Ok(42);
    let b: Result<i32, String> = Result::<i32, String>::Ok(42);
    let c: Result<i32, String> = Result::<i32, String>::Err("fail");
    let d: Result<i32, String> = Result::<i32, String>::Err("fail");

    if a == b {
        println("Ok == Ok");
    }
    if a != c {
        println("Ok != Err");
    }
    if c == d {
        println("Err == Err");
    }
}

__DATA__
{"stdout": "Ok == Ok\nOk != Err\nErr == Err\n"}
