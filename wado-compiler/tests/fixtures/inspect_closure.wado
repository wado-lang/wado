use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // :? shows signature only
    let add_one = |x: i32| x + 1;
    println(`{add_one:?}`);

    // Multi-param closure
    let add = |a: i32, b: i32| a + b;
    println(`{add:?}`);

    // Closure with block body - :? still shows signature
    let compute = |x: i32| {
        let doubled = x * 2;
        return doubled;
    };


    println(`{compute:?}`);

    // Closure returning String
    let greet = |name: String| `Hello, {name}!`;
    println(`{greet:?}`);

    // No-param closure
    let always42 = || 42;
    println(`{always42:?}`);

    // #:? shows full source (alternate mode)
    println(`{add_one:#?}`);
    println(`{add:#?}`);
    println(`{compute:#?}`);
    println(`{greet:#?}`);
    println(`{always42:#?}`);

    // Mutable closure
    let mut count = 0;
    let inc = &mut || {
        count += 1;
    };


    println(`{inc:?}`);
    println(`{inc:#?}`);

    println("ok");
}

__DATA__
{"stdout": "|i32| -> i32\n|i32, i32| -> i32\n|i32| -> i32\n|String| -> String\n|| -> i32\n|x: i32| x + 1\n|a: i32, b: i32| a + b\n|x: i32| { let doubled = x * 2; return doubled; }\n|name: String| `Hello, {name}!`\n|| 42\n||\n|| { count += 1; }\nok\n"}
