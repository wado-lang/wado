// Struct destructuring in if-let expressions

use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

struct Person {
    name: String,
    age: i32,
    email: String,
}

export fn run() with Stdout {
    let p = Point { x: 5, y: 15 };

    // if-let with unnamed struct pattern
    if let { x, y } = p {
        println(`{x}, {y}`);
    }

    // if-let with named struct pattern
    if let Point { x, y } = p {
        println(`{x + y}`);
    }

    // if-let with rest pattern
    let person = Person { name: "Alice", age: 30, email: "alice@test.com" };
    if let { name, .. } = person {
        println(name);
    }

    // if-let with rename
    if let { x: a, y: b } = p {
        println(`{a * b}`);
    }
}

__DATA__
{"stdout": "5, 15\n20\nAlice\n75\n"}
