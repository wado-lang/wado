// Loop-versioned BCE leaves a check past what the loop guard admits, here
// `xs[i + 1]` under `i < xs.len()`, to the loop as it is: its residual
// `len + 1 <= len` holds at no entry, so a fast arm would be dead code. The twin
// bounds the loop by `stop` instead, which a residual can test.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn pair_sum(xs: &List<i32>, stop: i32) -> i32 {
    let n = xs.len();
    let mut s = 0;
    for let mut i = 0; i < n; i += 1 {
        if i != stop {
            s += xs[i + 1];
        }
    }
    return s;
}

export fn run() with Stdout {
    let xs: List<i32> = builtin::black_box([1, 2, 3, 4]);
    println(`${pair_sum(&xs, builtin::black_box(3))}`);
}

__DATA__
{
    "stdout": "9\n",
    "wir_scope": "array_bounds_elim_version_unsatisfiable_wir.wado/pair_sum",
    "wir_contrast": {"O2": [{"i < n;": "i < stop;"}]},
    "wir_not_expect:O2": ["<= ($mv$xs$used - 1)"]
}
