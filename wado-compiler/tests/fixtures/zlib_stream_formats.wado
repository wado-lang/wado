// Test DeflateStream and InflateStream with format selection
use {println, Stdout} from "core:cli";
use {DeflateStream, InflateStream, inflate_raw, inflate_gzip,
     Z_DEFAULT_COMPRESSION, ZLIB_FORMAT, RAW_FORMAT, GZIP_FORMAT, AUTO_FORMAT} from "core:zlib";

export fn run() with Stdout {
    let mut data: Array<u8> = Array::<u8>::with_capacity(200);
    for let mut i = 0; i < 200; i += 1 {
        data.append((i % 256) as u8);
    }

    // Test RAW format stream
    let mut ds_raw = DeflateStream::new_with_format(Z_DEFAULT_COMPRESSION, RAW_FORMAT);
    let raw_compressed = ds_raw.compress(&data);
    // Raw deflate output should not have zlib header
    assert raw_compressed[0] != 0x78 as u8, "raw stream no zlib header";
    let raw_decompressed = inflate_raw(&raw_compressed);
    assert raw_decompressed.len() == 200, "raw format round-trip size";
    println("raw format ok");

    // Test RAW InflateStream
    let is_raw = InflateStream::new_with_format(RAW_FORMAT);
    let raw_d2 = is_raw.decompress(&raw_compressed);
    assert raw_d2.len() == 200, "raw inflate stream size";
    println("raw inflate stream ok");

    // Test GZIP format stream
    let mut ds_gz = DeflateStream::new_with_format(Z_DEFAULT_COMPRESSION, GZIP_FORMAT);
    let gz_compressed = ds_gz.compress(&data);
    // Gzip output should have gzip magic bytes
    assert gz_compressed[0] == 0x1F as u8, "gzip magic 1";
    assert gz_compressed[1] == 0x8B as u8, "gzip magic 2";
    let gz_decompressed = inflate_gzip(&gz_compressed);
    assert gz_decompressed.len() == 200, "gzip format round-trip size";
    println("gzip format ok");

    // Test GZIP InflateStream
    let is_gz = InflateStream::new_with_format(GZIP_FORMAT);
    let gz_d2 = is_gz.decompress(&gz_compressed);
    assert gz_d2.len() == 200, "gzip inflate stream size";
    println("gzip inflate stream ok");

    // Test AUTO format InflateStream with zlib input
    let mut ds_zlib = DeflateStream::new(Z_DEFAULT_COMPRESSION);
    let zlib_compressed = ds_zlib.compress(&data);
    let is_auto_zlib = InflateStream::new_with_format(AUTO_FORMAT);
    let auto_d1 = is_auto_zlib.decompress(&zlib_compressed);
    assert auto_d1.len() == 200, "auto detect zlib size";
    println("auto detect zlib ok");

    // Test AUTO format InflateStream with gzip input
    let is_auto_gz = InflateStream::new_with_format(AUTO_FORMAT);
    let auto_d2 = is_auto_gz.decompress(&gz_compressed);
    assert auto_d2.len() == 200, "auto detect gzip size";
    println("auto detect gzip ok");

    // Test DeflateStream reset
    let mut ds_reset = DeflateStream::new(Z_DEFAULT_COMPRESSION);
    let c1 = ds_reset.compress(&data);
    ds_reset.reset();
    let c2 = ds_reset.compress(&data);
    assert c1.len() == c2.len(), "reset produces same-size output";
    println("stream reset ok");

    // Test DeflateStream copy
    let mut ds_copy = DeflateStream::new(Z_DEFAULT_COMPRESSION);
    ds_copy.update(&data);
    let ds_clone = ds_copy.copy();
    let f1 = ds_copy.finish();
    let f2 = ds_clone.finish();
    assert f1.len() == f2.len(), "copy produces same-size output";
    println("stream copy ok");

    println("stream formats ok");
}

__DATA__
{"stdout_contains": ["stream formats ok", "raw format ok", "gzip format ok", "auto detect zlib ok", "auto detect gzip ok", "stream reset ok", "stream copy ok"]}
