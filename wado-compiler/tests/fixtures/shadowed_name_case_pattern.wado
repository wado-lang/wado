// A bare identifier pattern matches rather than binds when it names a case or
// a `global`, and only the elaborator knows the scrutinee's type. So such a
// name is left alone by the lint, even where a type of that name outranks the
// case everywhere else — `Default` here is the prelude trait.

use { println, Stdout } from "core:cli";

global TK_ADD: i32 = 1;
global TK_SUB: i32 = 2;

fn op(token: i32) -> String {
    return match token {
        TK_ADD => "+",
        TK_SUB => "-",
        _ => "?",
    };
}

enum Visibility {
    Default,
    Public,
}

fn label(v: &Visibility) -> String {
    return match *v {
        Default => "",
        Public => "public",
    };
}

fn first(opt: &Option<i32>) -> i32 {
    return match *opt {
        Some(n) => n,
        None => -1,
    };
}

export fn run() with Stdout {
    assert label(&Visibility::Public) == "public";
    assert first(&Option::<i32>::Some(7)) == 7;
    assert op(TK_SUB) == "-";
    println("ok");
}

__DATA__
{
    "stdout": "ok\n",
    "warnings_not_contains": [
        "`Default` shadows",
        "`Public` shadows",
        "`None` shadows",
        "`Some` shadows",
        "`TK_ADD` shadows",
        "`TK_SUB` shadows"
    ]
}
