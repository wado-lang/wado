// Verify that impl_type_matches_concrete correctly rejects List<i32> != List<String>.
struct NestedMap<K, V> {
    keys: List<String>,
    values: List<V>,
}

impl NestedMap<K, V> {
    fn new() -> NestedMap<K, V> {
        return NestedMap { keys: [], values: [] };
    }
}

impl KeyValueLiteralBuilder for NestedMap<List<String>, V> {
    type Value = V;
    type Output = NestedMap<List<String>, V>;

    fn new_literal(capacity: i32) -> NestedMap<List<String>, V> {
        return NestedMap::<List<String>, V>::new();
    }

    fn insert_literal(&mut self, key: String, value: Self::Value) {
        self.keys.push(key);
        self.values.push(value);
    }

    fn build(&self) -> NestedMap<List<String>, V> {
        return *self;
    }
}

export fn run() {
    // List<i32> != List<String> — should fail to find impl
    let m: NestedMap<List<i32>, i32> = { a: 1 };
}

__DATA__
{"compile_error": "does not implement KeyValueLiteral"}
