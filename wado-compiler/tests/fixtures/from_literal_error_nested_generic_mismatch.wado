// Verify that impl_type_matches_concrete correctly rejects List<i32> != List<String>.
struct NestedMap<K, V> {
    keys: List<String>,
    values: List<V>,
}

impl NestedMap<K, V> {
    fn new() -> NestedMap<K, V> {
        return NestedMap { keys: [], values: [] };
    }
}

impl From<Array<[String, V]>> for NestedMap<List<String>, V> {
    fn from(entries: Array<[String, V]>) -> NestedMap<List<String>, V> {
        let mut out: NestedMap<List<String>, V> = NestedMap::<List<String>, V>::new();
        for let [key, value] of entries {
            out.keys.push(key);
            out.values.push(value);
        }
        return out;
    }
}

export fn run() {
    // List<i32> != List<String> — should fail to find impl
    let m: NestedMap<List<i32>, i32> = { a: 1 };
}

__DATA__
{"compile_error": "cannot be built from an object literal"}
