// Verify that impl_type_matches_concrete correctly rejects Array<i32> != Array<String>.
struct NestedMap<K, V> {
    keys: Array<String>,
    values: Array<V>,
}

impl NestedMap<K, V> {
    fn new() -> NestedMap<K, V> {
        return NestedMap { keys: [], values: [] };
    }
}

impl KeyValueLiteralBuilder for NestedMap<Array<String>, V> {
    type Value = V;
    type Output = NestedMap<Array<String>, V>;

    fn new_literal(capacity: i32) -> NestedMap<Array<String>, V> {
        return NestedMap::<Array<String>, V>::new();
    }

    fn insert_literal(&mut self, key: String, value: Self::Value) {
        self.keys.push(key);
        self.values.push(value);
    }

    fn build(&self) -> NestedMap<Array<String>, V> {
        return *self;
    }
}

export fn run() {
    // Array<i32> != Array<String> — should fail to find impl
    let m: NestedMap<Array<i32>, i32> = { a: 1 };
}

__DATA__
{"compile_error": "does not implement KeyValueLiteral"}
