// ReflectEnum concrete metadata (WEP 2026-06-13 §3b): an enum value is its
// i32 discriminant, so the value bridge is discriminant() one way and
// from_discriminant() (Option, unknown tag is a normal error) the other.

enum Color {
    Red,
    Green,
    Blue,
}

test "type_name and case_meta describe the enum" {
    assert ReflectEnum::<Color>::type_name() == "Color";
    let metas = ReflectEnum::<Color>::case_meta();
    assert metas.len() == 3;
    assert metas[0].name == "Red";
    assert metas[1].name == "Green";
    assert metas[2].discriminant == 2;
}

test "discriminant reads the live case" {
    let c = Color::Green;
    assert ReflectEnum::<Color>::discriminant(&c) == 1;
}

test "from_discriminant round-trips and rejects unknown tags" {
    let g = ReflectEnum::<Color>::from_discriminant(1);
    assert g matches { Some(x) && x == Color::Green };
    assert ReflectEnum::<Color>::from_discriminant(9) matches { None };
    assert ReflectEnum::<Color>::from_discriminant(-1) matches { None };
}

__DATA__
{"test": {}}
