// Closures buried inside a variant case payload are also rejected at
// the Component Model boundary. `type_contains_closure` looks up each
// variant's case payloads via the resolver's variant registry.

variant Callback {
    Sync,
    Async(fn(i32) -> i32),
}

export fn run(cb: Callback) {
    let _ = cb;
}

