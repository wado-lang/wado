// `-a` on a type parameter dispatches through its bounds, as `a + b` does, and
// monomorphization turns the call back into the instruction for a primitive.
use { println } from "core:cli";

struct Cm {
    v: i32,
}

impl Neg for Cm {
    type Output = Cm;

    fn neg(&self) -> Cm {
        return Cm { v: -self.v };
    }
}

fn flip<T: Neg<Output = T>>(a: T) -> T {
    return -a;
}

export fn run() with Stdout {
    assert flip(Cm { v: 5 }).v == -5;
    assert flip(7) == -7;
    println(`${flip(Cm { v: 5 }).v} ${flip(7)} ${flip(2.5)}`);
}

__DATA__
{"stdout": "-5 -7 -2.5\n"}
