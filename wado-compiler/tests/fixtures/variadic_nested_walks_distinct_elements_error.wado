//! Two nested walks over one pack bind two elements, which need not have one
//! type: over `[1, "a"]`, `x` is `i32` where `v` is `String`. Unifying them
//! monomorphized `pick` at one element and passed it the other, which emitted
//! invalid Wasm.
//! See docs/wep-2026-03-14-variadic-type-parameters.md.

fn pick<A>(a: A, b: A) -> A {
    return a;
}

trait Walk with () {
    fn walk(&self) -> i32;
}

impl<..T> Walk for [..T] {
    fn walk(&self) -> i32 {
        for let x of *self {
            for let v of *self {
                let w = pick(x, v);
            }
        }
        return 0;
    }
}

test "nested walks bind distinct elements" {
    assert [1, "a"].walk() == 0;
}

__DATA__
{"compile_error": "type mismatch: expected 'T', found 'T@1'"}
