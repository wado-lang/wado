// Attributes decorate what follows them, so the statement dispatch reads past
// them before deciding what it is looking at. Reading only the `#` reported a
// compile-time literal, hiding the real shape underneath.

export fn run() {
    #[allow(shadowed_name)]
    internal struct Point {
        x: i32,
    }
}

