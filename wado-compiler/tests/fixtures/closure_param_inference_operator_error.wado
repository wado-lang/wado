// A closure's parameter type is answered by a sibling argument, and the answer
// has to satisfy whatever the body does with it. `Plain` has no `Add`, so the
// `+` is reported here, at the operator, against the type the sibling supplied.
//
// Before the argument tiers this reached WIR undispatched and killed the
// compiler: an operator applied to an unanswered inference variable finds no
// impl, records no dispatch, and the variable is only substituted afterwards.

struct Plain {
    v: i32,
}

fn apply_pair<A>(f: fn(A, A) -> A, a: A, b: A) -> A {
    return f(a, b);
}

test "the operator is reported against the type the sibling argument supplied" {
    let sum = apply_pair(|a, b| a + b, Plain { v: 3 }, Plain { v: 4 });
    assert sum.v == 7;
}

__DATA__
{"test": {}, "compile_error": "operator `+` cannot be applied to type `Plain`: type does not implement `Add`"}
