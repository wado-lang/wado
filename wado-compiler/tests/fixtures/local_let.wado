use { println, Stdout } from "core:cli";


// from local_let.wado
fn local_let() with Stdout {
    let msg = "Hello from let!";
    println(msg);
}

// from local_let_mut.wado
fn local_let_mut() with Stdout {
    let mut msg = "First message";
    println(msg);
    msg = "Second message";
    println(msg);
}

export fn run() with Stdout {
    local_let();
    local_let_mut();
}

__DATA__
{"stdout": "Hello from let!\nFirst message\nSecond message\n"}
