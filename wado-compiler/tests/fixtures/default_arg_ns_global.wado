// Regression: a default naming a namespaced global (`nsb::SOME`) resolves the
// alias in the module that wrote it. Annotate canonicalized `ns::member` to the
// `ns$member` key using the alias map of whichever module took the default, so
// a caller without that alias left the name uncanonicalized and the global
// lookup missed: "unknown identifier 'nsb::SOME'" on a valid program.
//
// This file deliberately declares no `nsb` alias. A namespaced *function* call
// in a default already had coverage; a namespaced *global* did not.

use { Conf, called, takes } from "./sub/default_arg_ns_global_lib.wado";

export fn run() {
    assert takes() == 41;
    assert takes(3) == 3;
    assert Conf {}.v == 41;
    assert called() == 7;
}

__DATA__
{"stdout": ""}
