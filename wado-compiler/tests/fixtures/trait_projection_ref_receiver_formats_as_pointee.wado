// In generic code `&T` is a reference to a `T`, so `${v:?}` renders it as the
// `&P` it becomes: `&`, then the pointee. A reference over a projection
// (`&X::Item`) reads the same way, so both print `&3`.

trait Holder with () {
    type Item: Inspect;
    fn item_ref(&self) -> &Self::Item;
}

struct H {
    v: i32,
}

impl Holder for H {
    type Item = i32;
    fn item_ref(&self) -> &i32 {
        return &self.v;
    }
}

fn via_projection<X: Holder>(h: &X) -> String {
    let r = h.item_ref();
    return `${r:?}`;
}

fn via_param<T: Inspect>(v: &T) -> String {
    return `${v:?}`;
}

test "a reference over a projection debug-formats as a reference" {
    assert via_param(&3) == "&3";
    assert via_projection(&H { v: 3 }) == "&3";
}

__DATA__
{"test": {}}
