// Test: the index operand of a subscript is rendered alongside the element.

export fn run() with Stdout {
    let list: List<i32> = [10, 20, 30];
    let i = 1;
    assert list[i] == 99, "wrong element";
}

__DATA__
{
    "trapped": true,
    "stderr_contains": [
        "condition: list[i] == 99",
        "i: 1",
        "list[i]: 20"
    ]
}
