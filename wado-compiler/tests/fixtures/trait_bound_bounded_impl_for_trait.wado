// Test: bounded trait implementation — Pair<T> implements Ord only when T: Ord
use { println, Stdout } from "core:cli";

struct Pair<T> {
    first: T,
    second: T,
}

impl<T: Eq> Eq for Pair<T> {
    fn eq(&self, other: &Self) -> bool {
        return self.first == other.first && self.second == other.second;
    }
}

impl<T: Ord> Ord for Pair<T> {
    fn cmp(&self, other: &Self) -> Ordering {
        let c = self.first.cmp(&other.first);
        if let Equal = c {
            return self.second.cmp(&other.second);
        }
        return c;
    }
}

export fn run() with Stdout {
    let a = Pair { first: 1, second: 2 };
    let b = Pair { first: 1, second: 3 };
    if a < b {
        println("a < b");
    }
    if a == a {
        println("a == a");
    }
}

__DATA__
{"stdout": "a < b\na == a\n"}
