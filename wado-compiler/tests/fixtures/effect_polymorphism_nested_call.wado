// Test: effect-polymorphic function calling another effect-polymorphic function
// The inner function has a different effect param name

use { println, Stdout } from "core:cli";

fn inner<effect F>(f: fn() with F) with F {
    f();
}

fn outer<effect E>(f: fn() with E) with E {
    inner(f);
}

export fn run() with Stdout {
    outer(|| {
        println("nested effect polymorphism");
    });
    println("done");
}

__DATA__
{"stdout": "nested effect polymorphism\ndone\n"}
