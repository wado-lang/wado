// Test: an `impl Inspect for T;` marker is accepted as a conformance check
// (WEP: Trait Derivation Policy). `Display` is never derived, so a struct is
// formatted via a manual `impl Display`, which `${x:#}` reaches too — the `#`
// flag is a `Formatter` field, not a trait of its own.
struct Point {
    x: i32,
    y: i32,
}

impl Inspect for Point;

test "inspect markers validate and debug formatting works" {
    let p = Point { x: 1, y: 2 };
    assert `${p:?}` == "Point { x: 1, y: 2 }";
}

struct Custom {
    v: i32,
}

impl Display for Custom {
    pub fn fmt(&self, f: &mut Formatter) {
        f.write_str(&"custom!");
    }
}

test "manual Display drives {x} and {x:#}; Inspect drives {x:?}" {
    let c = Custom { v: 1 };
    assert `${c}` == "custom!";
    assert `${c:#}` == "custom!";
    assert `${c:?}` == "Custom { v: 1 }";
}

__DATA__
{"test": {}}
