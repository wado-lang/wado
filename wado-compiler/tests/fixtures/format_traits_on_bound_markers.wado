// Test: `impl Inspect for T;` / `impl InspectAlt for T;` markers are accepted as
// conformance checks (WEP: Trait Derivation Policy). `Display` is never derived,
// so a struct is formatted via a manual `impl Display`; `impl DisplayAlt for T;`
// then derives the alternate form by delegating to that `Display`.
struct Point {
    x: i32,
    y: i32,
}

impl Inspect for Point;
impl InspectAlt for Point;

test "inspect markers validate and debug formatting works" {
    let p = Point { x: 1, y: 2 };
    assert `{p:?}` == "Point { x: 1, y: 2 }";
}

struct Custom {
    v: i32,
}

impl Display for Custom {
    pub fn fmt(&self, f: &mut Formatter) {
        f.write_str(&"custom!");
    }
}

impl DisplayAlt for Custom;

test "manual Display drives {x} and {x:#}; Inspect drives {x:?}" {
    let c = Custom { v: 1 };
    assert `{c}` == "custom!";
    assert `{c:#}` == "custom!";
    assert `{c:?}` == "Custom { v: 1 }";
}

__DATA__
{"test": {}}
