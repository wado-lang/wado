// An associated type bound by an impl whose target has a concrete
// argument ahead of the free one.
//
// `V` is the block's first parameter and the target's second, and both
// the bindings and the recorded signatures number it by the target.

trait Boxy with () {
    type Item;
    fn first(&self) -> Self::Item;
}

struct Pair<A, B> {
    a: A,
    b: B,
}

impl<V: Display> Boxy for Pair<String, V> {
    type Item = V;

    fn first(&self) -> Self::Item {
        return self.b;
    }
}

test "an associated type resolves past a concrete target argument" {
    let p = Pair { a: "k", b: 42 };
    assert p.first() == 42;
}

__DATA__
{"test": {}}
