// Widening and narrowing checked against the IEEE 754 binary16 and bfloat16
// encodings: zero, the subnormal ends, the normal ends, an infinity and a NaN.
// Reference bit patterns, not computed ones, so a wrong shift cannot agree
// with itself on both sides.

export fn run() {
    // binary16 -> f32, every class.
    assert f32::from(f16::from_bits(0x0000)) == 0.0;
    assert f32::from(f16::from_bits(0x8000)).to_bits() == 0x8000_0000;
    assert f32::from(f16::from_bits(0x0001)) == 5.9604645e-8;
    assert f32::from(f16::from_bits(0x03FF)) == 6.0975552e-5;
    assert f32::from(f16::from_bits(0x0400)) == 6.1035156e-5;
    assert f32::from(f16::from_bits(0x3C00)) == 1.0;
    assert f32::from(f16::from_bits(0x3555)) == 0.33325195;
    assert f32::from(f16::from_bits(0xC000)) == -2.0;
    assert f32::from(f16::from_bits(0x7BFF)) == 65504.0;
    assert f32::from(f16::from_bits(0x7C00)) == f32::INFINITY;
    assert f32::from(f16::from_bits(0xFC00)) == -f32::INFINITY;
    assert f32::from(f16::from_bits(0x7E00)).is_nan();

    // f32 -> binary16, rounding to nearest with ties to even.
    assert f16::from_f32(0.0).to_bits() == 0x0000;
    assert f16::from_f32(-0.0).to_bits() == 0x8000;
    assert f16::from_f32(1.0).to_bits() == 0x3C00;
    assert f16::from_f32(-2.0).to_bits() == 0xC000;
    assert f16::from_f32(65504.0).to_bits() == 0x7BFF;
    assert f16::from_f32(5.9604645e-8).to_bits() == 0x0001;
    assert f16::from_f32(6.0975552e-5).to_bits() == 0x03FF;
    assert f16::from_f32(6.1035156e-5).to_bits() == 0x0400;
    // 1/3 rounds up at bit 10. Above 2048 the step is 2, so 2049 and 2051 are
    // both ties, and each lands on its even neighbour — down, then up.
    assert f16::from_f32(0.33333334).to_bits() == 0x3555;
    assert f16::from_f32(2049.0).to_bits() == 0x6800;
    assert f16::from_f32(2051.0).to_bits() == 0x6802;
    // Past binary16's range: saturate to an infinity, and underflow to a zero.
    assert f16::from_f32(70000.0).to_bits() == 0x7C00;
    assert f16::from_f32(-70000.0).to_bits() == 0xFC00;
    assert f16::from_f32(1.0e-10).to_bits() == 0x0000;
    assert f16::from_f32(f32::INFINITY).to_bits() == 0x7C00;
    assert f16::from_f32(f32::NAN).is_nan();

    // bfloat16 is f32's top half, so widening is a shift and nothing else.
    assert f32::from(bf16::from_bits(0x0000)) == 0.0;
    assert f32::from(bf16::from_bits(0x3F80)) == 1.0;
    assert f32::from(bf16::from_bits(0xBF80)) == -1.0;
    assert f32::from(bf16::from_bits(0x4049)) == 3.140625;
    assert f32::from(bf16::from_bits(0x7F80)) == f32::INFINITY;
    assert f32::from(bf16::from_bits(0x0001)).to_bits() == 0x0001_0000;
    assert f32::from(bf16::from_bits(0x7FC0)).is_nan();

    assert bf16::from_f32(1.0).to_bits() == 0x3F80;
    assert bf16::from_f32(-1.0).to_bits() == 0xBF80;
    assert bf16::from_f32(3.14159265).to_bits() == 0x4049;
    assert bf16::from_f32(f32::INFINITY).to_bits() == 0x7F80;
    assert bf16::from_f32(f32::NAN).is_nan();
    // A tie at bit 16 rounds to the even neighbour, and the carry walks into
    // the exponent where the mantissa is all ones.
    assert bf16::from_f32(f32::from_bits(0x3F80_8000)).to_bits() == 0x3F80;
    assert bf16::from_f32(f32::from_bits(0x3F81_8000)).to_bits() == 0x3F82;
    assert bf16::from_f32(f32::from_bits(0x3F7F_8000)).to_bits() == 0x3F80;

    // f64 widening goes through f32, and every binary16 value is exact there.
    assert f64::from(f16::from_bits(0x3C00)) == 1.0;
    assert f64::from(bf16::from_bits(0x3F80)) == 1.0;

    // `try_from` refuses what rounding would change, and accepts what it keeps.
    assert f16::try_from(1.0 as f32) matches { Ok(_) };
    assert f16::try_from(0.33333334 as f32) matches { Err(_) };
    assert bf16::try_from(1.0 as f64) matches { Ok(_) };
    assert bf16::try_from(3.14159265 as f64) matches { Err(_) };

    // Display widens; Inspect uses exponent notation.
    assert `${f16::from_bits(0x3C00)}` == "1";
    assert `${f16::from_bits(0xC000)}` == "-2";
    assert `${bf16::from_bits(0x4049)}` == "3.140625";
    assert `${f16::from_bits(0x3C00):?}` == "1e0";
}

__DATA__
{}
