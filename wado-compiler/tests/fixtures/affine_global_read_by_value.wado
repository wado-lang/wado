// A global holding an affine value is never read by value: no check follows a
// global across functions, so a read would copy it.
use { Fields } from "wasi:http";

global mut SLOT: Option<Fields> = null;

fn eat(f: Option<Fields>) {
}

export fn run() {
    eat(SLOT);
}

