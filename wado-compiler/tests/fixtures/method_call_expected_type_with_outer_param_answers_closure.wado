// The type a method call's site expects answers the slot no argument settles
// even where it names a type parameter of the enclosing function: `map`'s `U`
// is `Result<M, String>`, so the closure's `Result::Ok(v)` takes `E = String`.

fn wrap<M>(o: Option<M>) -> Option<Result<M, String>> {
    return o.map(|v| Result::Ok(v));
}

test {
    assert wrap(Option::Some(1)) == Option::Some(Result::Ok(1));
}
