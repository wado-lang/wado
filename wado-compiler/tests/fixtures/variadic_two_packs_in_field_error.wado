//! A struct field holding two type packs in one tuple. A literal gives the
//! field one value, which every split satisfies, so neither pack is settled
//! and the declaration is rejected.
//! See docs/wep-2026-03-14-variadic-type-parameters.md §6.

struct Joined<..A, ..B> {
    both: [..A, ..B],
}

test "two packs in one field tuple" {
    let j: Joined<[i32], [bool]> = Joined { both: [1, true] };
    assert j.both.0 == 1;
}

__DATA__
{"compile_error": "a field cannot hold two type packs in one tuple"}
