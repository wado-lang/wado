// Raw Exit::exit(Ok(())): Result<(), ()> lowers to a bare CM discriminant.
use { println, Stdout } from "core:cli";
use { Exit } from "wasi:cli";

export fn run() with Stdout, Exit {
    println("before");
    Exit::exit(Result::<(), ()>::Ok(()));
}

__DATA__
{
    "stdout": "before\n",
    "exit_code": 0,
    "trapped": false
}
