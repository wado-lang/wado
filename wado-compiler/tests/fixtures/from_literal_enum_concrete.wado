use { println, Stdout } from "core:cli";

enum Direction {
    North,
    South,
    East,
    West,
}

struct DirMap<D, V> {
    keys: List<String>,
    values: List<V>,
}

impl From<Array<[String, V]>> for DirMap<Direction, V> {
    fn from(entries: Array<[String, V]>) -> DirMap<Direction, V> {
        let mut out: DirMap<Direction, V> = DirMap { keys: [], values: [] };
        for let [key, value] of entries {
            out.keys.push(key);
            out.values.push(value);
        }
        return out;
    }
}

export fn run() with Stdout {
    let m: DirMap<Direction, i32> = { north: 1, south: 2 };
    assert m.keys.len() == 2;
    assert m.values[0] == 1;
    println("ok");
}

__DATA__
{"stdout": "ok\n"}
