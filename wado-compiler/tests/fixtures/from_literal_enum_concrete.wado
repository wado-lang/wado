use { println } from "core:cli";

enum Direction {
    North,
    South,
    East,
    West,
}

struct DirMap<D, V> {
    keys: List<String>,
    values: List<V>,
}

impl KeyValueLiteralBuilder for DirMap<Direction, V> {
    type Value = V;
    type Output = DirMap<Direction, V>;

    fn new_literal(capacity: i32) -> DirMap<Direction, V> {
        return DirMap { keys: [], values: [] };
    }

    fn insert_literal(&mut self, key: String, value: Self::Value) {
        self.keys.push(key);
        self.values.push(value);
    }

    fn build(&self) -> DirMap<Direction, V> {
        return *self;
    }
}

export fn run() with Stdout {
    let m: DirMap<Direction, i32> = { north: 1, south: 2 };
    assert m.keys.len() == 2;
    assert m.values[0] == 1;
    println("ok");
}

__DATA__
{"stdout": "ok\n"}
