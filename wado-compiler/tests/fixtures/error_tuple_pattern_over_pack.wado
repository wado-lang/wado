// Only the elements ahead of a variadic pack have a fixed position, so a tuple
// pattern over one names those and ends in `..`.

fn f<A, ..T>(t: [A, ..T]) -> A {
    let [a, b] = t;
    let [c] = t;
    let r = match t { [d, e, ..] => d };
    let [g, ..] = t;
    return g;
}

test {
    assert f([1, 2]) == 1;
}

