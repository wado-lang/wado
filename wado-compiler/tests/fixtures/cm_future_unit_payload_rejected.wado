// Test: an unlowerable future payload is reported, not panicked on, even from a
// function that is not one of the world's exports.
//
// The record half of the payload validation is scoped to functions the world's
// export bindings reach, because a record's resolvability depends on the world.
// Classifiability does not: synthesis classifies every `future` / `stream`
// method call in every function.
use { println, Stdout } from "core:cli";

export fn helper(v: Future<()>) -> i32 {
    v.drop();
    return 1;
}

export fn run() with Stdout {
    println("unreachable");
}

__DATA__
{
    "compile_error": "`()` has no Component Model representation as a `future` payload"
}
