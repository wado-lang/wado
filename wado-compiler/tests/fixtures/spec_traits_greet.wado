// A trait declared, implemented for a struct, and called as a method.

// Trait declaration
trait Greet {
    fn greet(&self) -> String;
}

// Trait implementation
struct Person {
    name: String,
}

impl Greet for Person {
    fn greet(&self) -> String {
        return `Hello, ${self.name}!`;
    }
}

// Usage
test {
    let p = Person { name: "Alice" };
    assert p.greet() == "Hello, Alice!";
}
