// Error: Chained newtype method expects the same newtype, not base

use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

impl Point {
    fn add(&self, other: &Point) -> Point {
        return Point { x: self.x + other.x, y: self.y + other.y };
    }
}

type A = Point;
type B = A;
type C = B;

export fn run() with Stdout {
    let c: C = Point { x: 1, y: 2 } as C;
    let pt = Point { x: 3, y: 4 };
    // ERROR: add expects &C (through chain), got &Point
    let bad = c.add(&pt);
}

__DATA__
{"compile_error": "expected 'argument 1 to be &C'"}
