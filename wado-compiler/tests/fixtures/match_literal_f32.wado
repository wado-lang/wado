// Test that float literal patterns produce a compile error
// Float comparisons are unreliable due to precision issues

use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let x: f32 = 3.14 as f32;

    let r1 = match x {
        0.0 => "zero",
        3.14 => "pi",
        _ => "other",
    };
    println(r1);
}

__DATA__
{"compile_error": "float literals cannot be used in match patterns"}
