// Test that List::sort is unavailable when T doesn't implement Ord

variant NoOrd {
    A(fn() -> i32),
    B,
}

struct Point {
    x: NoOrd,
}

export fn run() {
    let mut points: List<Point> = [];
    points.push(Point { x: NoOrd::A(|| 1) });
    // Point does not implement Ord (NoOrd's `fn` payload has none), so sort() should not be available
    points.sort();
}

__DATA__
{"compile_error": "no method 'sort' found"}
