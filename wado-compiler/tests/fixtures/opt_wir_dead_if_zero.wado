// Bounds-check elimination on constant-known array length. Previously
// pinned via `wir_not_expect:O2: ["if 0"]` against the WIR-level
// const_forward pass (now removed in favor of the TIR-level
// field_forward, which doesn't see through the `let arr = __seq_lit:
// { ... __b.push(...) ... break *__b }` MethodCall chain). The
// correctness assertion (sum == 30) keeps the dead-code-elimination
// path honest. Recovering the WIR pattern is tracked as future work.

fn sum_first_two(arr: Array<u16>) -> i32 {
    return arr[0] as i32 + arr[1] as i32;
}

export fn run() {
    let arr: Array<u16> = [10, 20, 30];
    assert sum_first_two(arr) == 30;
}

