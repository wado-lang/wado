// TreeMap entries() returns key-value pairs in insertion order
use { println, print } from "core:cli";
use { TreeMap } from "core:collections";

export fn run() with Stdout {
    let mut map = TreeMap::<String, i32>::new();

    map["first"] = 1;
    map["second"] = 2;
    map["third"] = 3;

    let pairs = map.entries();
    assert pairs.len() == 3;

    // First entry
    assert pairs[0].0 == "first";
    assert pairs[0].1 == 1;

    // Second entry
    assert pairs[1].0 == "second";
    assert pairs[1].1 == 2;

    // Third entry
    assert pairs[2].0 == "third";
    assert pairs[2].1 == 3;

    // After update, order preserved
    map["second"] = 200;
    let pairs2 = map.entries();
    assert pairs2[1].0 == "second";
    assert pairs2[1].1 == 200;

    // After remove, entries reflects the change
    map.remove("second");
    let pairs3 = map.entries();
    assert pairs3.len() == 2;
    assert pairs3[0].0 == "first";
    assert pairs3[1].0 == "third";

    println("entries: ok");
}

__DATA__
{"stdout": "entries: ok\n"}
