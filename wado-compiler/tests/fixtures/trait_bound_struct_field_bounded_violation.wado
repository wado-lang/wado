// Test: bounded impl block method unavailable for unbounded type
variant NoOrd {
    A(fn() -> i32),
    B,
}

struct Holder<T> {
    items: List<T>,
}

impl<T: Ord> Holder<T> {
    fn min(&self) -> T {
        return self.items[0];
    }
}

export fn run() {
    let h = Holder { items: [NoOrd::A(|| 1)] as List<NoOrd> };
    // NoOrd's `fn` payload has no Ord, so min() should not be available
    let m = h.min();
}

__DATA__
{"compile_error": "no method 'min' found"}
