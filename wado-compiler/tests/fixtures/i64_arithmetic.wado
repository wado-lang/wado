// Test i64 arithmetic operations
use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let a: i64 = 1000000000000 as i64;
    let b: i64 = 500000000000 as i64;

    // Subtraction
    let diff = a - b;
    println(`diff: {diff}`);

    // Addition
    let sum = a + b;
    println(`sum: {sum}`);

    // Multiplication
    let prod: i64 = 1000000 as i64 * 1000000 as i64;
    println(`prod: {prod}`);

    // Division
    let quot = a / b;
    println(`quot: {quot}`);
}

__DATA__
{"stdout": "diff: 500000000000\nsum: 1500000000000\nprod: 1000000000000\nquot: 2\n"}
