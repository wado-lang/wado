// Test all f32 associated constants
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    println(`PI = {f32::PI}`);
    println(`TAU = {f32::TAU}`);
    println(`E = {f32::E}`);
    println(`LN2 = {f32::LN2}`);
    println(`LN10 = {f32::LN10}`);
    println(`LOG2_E = {f32::LOG2_E}`);
    println(`LOG10_E = {f32::LOG10_E}`);
    println(`SQRT2 = {f32::SQRT2}`);
    println(`FRAC_1_SQRT2 = {f32::FRAC_1_SQRT2}`);
    println(`FRAC_PI_2 = {f32::FRAC_PI_2}`);
    println(`FRAC_PI_4 = {f32::FRAC_PI_4}`);
    println(`INFINITY = {f32::INFINITY}`);
    println(`NEG_INFINITY = {f32::NEG_INFINITY}`);

    // Verify mathematical relationships
    println(`TAU == 2*PI: {f32::TAU == f32::PI * (2.0 as f32)}`);
    println(`FRAC_PI_2 == PI/2: {f32::FRAC_PI_2 == f32::PI / (2.0 as f32)}`);
    println(`FRAC_PI_4 == PI/4: {f32::FRAC_PI_4 == f32::PI / (4.0 as f32)}`);
}

__DATA__
{"stdout_contains": [
    "PI = 3.1415927",
    "TAU = 6.2831855",
    "E = 2.7182817",
    "LN2 = 0.6931472",
    "LN10 = 2.3025851",
    "LOG2_E = 1.442695",
    "LOG10_E = 0.4342945",
    "SQRT2 = 1.4142135",
    "FRAC_1_SQRT2 = 0.70710677",
    "FRAC_PI_2 = 1.5707964",
    "FRAC_PI_4 = 0.7853982",
    "INFINITY = inf",
    "NEG_INFINITY = -inf",
    "TAU == 2*PI: true",
    "FRAC_PI_2 == PI/2: true",
    "FRAC_PI_4 == PI/4: true"
]}
