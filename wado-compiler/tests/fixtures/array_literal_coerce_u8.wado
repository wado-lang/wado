// List literal elements should coerce to the target element type.
// e.g., let a: List<u8> = [1, 2, 3]; should work like let x: u8 = 1;

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Type annotation coercion
    let a: List<u8> = [1, 2, 3];
    println(`{a[0]}, {a[1]}, {a[2]}`);

    // Other integer types
    let b: List<i64> = [10, 20, 30];
    println(`{b[0]}, {b[1]}, {b[2]}`);

    let c: List<u16> = [100, 200, 300];
    println(`{c[0]}, {c[1]}, {c[2]}`);

    // Cast syntax coercion
    let d = [4, 5, 6] as List<u8>;
    println(`{d[0]}, {d[1]}, {d[2]}`);
}

__DATA__
{"stdout": "1, 2, 3\n10, 20, 30\n100, 200, 300\n4, 5, 6\n"}
