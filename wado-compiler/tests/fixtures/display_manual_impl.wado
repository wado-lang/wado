// A struct with a hand-written `impl Display` formats with `{x}`; `{x:?}` still
// shows the auto-derived debug form.
struct Point {
    x: i32,
    y: i32,
}

impl Display for Point {
    pub fn fmt(&self, f: &mut Formatter) {
        f.write_char('(');
        f.write_str(&`${self.x}`);
        f.write_str(&", ");
        f.write_str(&`${self.y}`);
        f.write_char(')');
    }
}

test "manual Display drives {x}, Inspect drives {x:?}" {
    let p = Point { x: 10, y: 20 };
    assert `${p}` == "(10, 20)";
    assert `${p:?}` == "Point { x: 10, y: 20 }";
}

__DATA__
{"test": {}}
