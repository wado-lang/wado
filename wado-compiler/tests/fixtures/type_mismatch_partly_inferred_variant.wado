// A value whose type an argument leaves open is still a mismatch where its
// outermost type cannot be the one expected, whatever the open part becomes:
// `Result::Ok(1)` is no `i32`, whichever error type it would take. The
// mismatch says so, wherever it is checked, and the parameters left open add
// nothing to it.

fn wrong() -> i32 {
    let x: i32 = Result::Ok(1);
    return x;
}

fn branch(c: bool) -> i32 {
    let y: i32 = if c { Result::Ok(1) } else { 2 };
    return y;
}

fn arm(n: i32) -> i32 {
    return match n { 0 => Result::Ok(1), _ => 2 };
}

export fn run() {
    wrong();
    branch(true);
    arm(0);
}

__DATA__
{
    "compile_error": ":8:18: analysis error: type mismatch: expected 'i32', found 'Result<T, E>'",
    "compile_errors_not_contains": ["cannot infer"]
}
