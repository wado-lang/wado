// A `null` element in a slot that is neither an `Option` nor a type converting
// from one is refused where it is written; it used to reach WIR as a null ref
// in a non-nullable field.
struct Plain {
    n: i32,
}

impl From<Array<i32>> for Plain {
    fn from(a: Array<i32>) -> Plain {
        return Plain { n: builtin::array_len(&a) };
    }
}

export fn run() {
    let p: List<Plain> = [null];
}

