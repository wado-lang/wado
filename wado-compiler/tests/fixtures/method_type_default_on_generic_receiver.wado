// A method's type default fills an omitted type argument whatever the receiver
// is, a type parameter included: a generic function's `T` and a trait default
// body's own `Self` take `U = i32` as a concrete receiver does. A default
// naming `Self` there names the caller's own `T`.
use { println, Stdout } from "core:cli";

trait Shown with () {
    fn id() -> i32;
}

trait Tr: Shown with () {
    fn m<U = i32>(&self) -> i32 {
        return 1;
    }
    fn n<U: Shown = Self>(&self) -> i32 {
        return U::id();
    }
    fn e(&self) -> i32 {
        return Self::m(self) + self.m() * 10;
    }
}

struct A {}

impl Shown for A {
    fn id() -> i32 {
        return 3;
    }
}

impl Tr for A {}

fn via<T: Tr>(t: &T) -> i32 {
    return t.m() * 100 + t.n();
}

export fn run() with Stdout {
    let a = A {};
    println(`${a.m()} ${a.e()} ${via(&a)} ${a.n()}`);
}

__DATA__
{
    "stdout": "1 11 103 3\n"
}
