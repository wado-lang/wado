// Test match expression with u128 literal patterns
// u128 codegen is not yet fully implemented

use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let x: u128 = 42 as u128;

    let r1 = match x {
        0 => "zero",
        42 => "answer",
        _ => "other",
    };
    println(r1);
}

__DATA__
{"stdout": "answer\n"}
