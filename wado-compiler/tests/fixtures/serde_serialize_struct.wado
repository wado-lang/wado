// Test: manual Serialize implementation for a user-defined struct
// This is what the compiler would eventually synthesize
use { println, Stdout } from "core:cli";

struct SerializeError {
    message: String,
}

trait Serialize {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError>;
}

trait SerializeStruct {
    fn field<T: Serialize>(&mut self, name: &String, value: &T) -> Result<(), SerializeError>;
    fn end(&mut self) -> Result<(), SerializeError>;
}

trait Serializer {
    type StructSerializer: SerializeStruct;

    fn serialize_i32(&mut self, v: i32) -> Result<(), SerializeError>;
    fn serialize_string(&mut self, v: &String) -> Result<(), SerializeError>;
    fn serialize_bool(&mut self, v: bool) -> Result<(), SerializeError>;
    fn begin_struct(&mut self, name: &String, fields: i32) -> Result<Self::StructSerializer, SerializeError> with stores[self];
}

// Mock JSON-like serializer. Sub-serializers hold `&mut JsonSerializer`
// so writes to the buffer flow back to the outer instance the caller
// still owns. A value-typed `JsonSerializer` field would deep-copy on
// construction (per Wado value semantics — `String` deep-copies its
// `repr`), and `field` / `end` would mutate a *separate* buffer the
// caller never sees.
struct JsonSerializer {
    buf: String,
}

struct JsonStructSerializer {
    ser: &mut JsonSerializer,
    count: i32,
}

impl Serializer for JsonSerializer {
    type StructSerializer = JsonStructSerializer;

    fn serialize_i32(&mut self, v: i32) -> Result<(), SerializeError> {
        self.buf.push_str(&`{v}`);
        return Result::<(), SerializeError>::Ok(());
    }

    fn serialize_string(&mut self, v: &String) -> Result<(), SerializeError> {
        self.buf.push_str(&`"{*v}"`);
        return Result::<(), SerializeError>::Ok(());
    }

    fn serialize_bool(&mut self, v: bool) -> Result<(), SerializeError> {
        if v {
            self.buf.push_str(&"true");
        } else {
            self.buf.push_str(&"false");
        }
        return Result::<(), SerializeError>::Ok(());
    }

    fn begin_struct(&mut self, name: &String, fields: i32) -> Result<JsonStructSerializer, SerializeError> with stores[self] {
        self.buf.push_str(&"{");
        return Result::<JsonStructSerializer, SerializeError>::Ok(JsonStructSerializer {
            ser: self,
            count: 0,
        });
    }
}

impl SerializeStruct for JsonStructSerializer {
    fn field<T: Serialize>(&mut self, name: &String, value: &T) -> Result<(), SerializeError> {
        if self.count > 0 {
            self.ser.buf.push_str(&",");
        }
        self.ser.buf.push_str(&`"{*name}":`);
        value.serialize::<JsonSerializer>(self.ser);
        self.count += 1;
        return Result::<(), SerializeError>::Ok(());
    }

    fn end(&mut self) -> Result<(), SerializeError> {
        self.ser.buf.push_str(&"}");
        return Result::<(), SerializeError>::Ok(());
    }
}

// Primitive Serialize impls
impl Serialize for i32 {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_i32(*self);
    }
}

impl Serialize for String {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_string(self);
    }
}

impl Serialize for bool {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        return s.serialize_bool(*self);
    }
}

// User struct
struct User {
    name: String,
    age: i32,
    active: bool,
}

// Manual Serialize impl — what the compiler would generate
impl Serialize for User {
    fn serialize<S: Serializer>(&self, s: &mut S) -> Result<(), SerializeError> {
        let mut st = s.begin_struct(&"User", 3);
        if let Ok(mut st) = st {
            st.field::<String>(&"userName", &self.name);
            st.field::<i32>(&"age", &self.age);
            st.field::<bool>(&"active", &self.active);
            return st.end();
        }
        return Result::<(), SerializeError>::Err(SerializeError { message: "begin_struct failed" });
    }
}

export fn run() with Stdout {
    let user = User { name: "Alice", age: 30, active: true };
    let mut ser = JsonSerializer { buf: "" };
    user.serialize::<JsonSerializer>(&mut ser);
    println(ser.buf);
}

__DATA__
{"stdout": "{\"userName\":\"Alice\",\"age\":30,\"active\":true}\n"}
