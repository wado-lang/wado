// `log_stderr` writes in a `wasi:http/service` world, which imports stderr.
// Its ambient body was reified once into the standard library's snapshot, so
// the guard around it names the interface in terms every compilation reads
// alike, whatever other modules this one loads.

use { log_stderr } from "core:cli";
use { Request, Response, ErrorCode } from "wasi:http";

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    log_stderr("handled");
    task return Result::<Response, ErrorCode>::Err(ErrorCode::InternalError(null));
}

__DATA__
{
    "wasi:http/service": {"status": 500},
    "wir_expect:O2": ["wasi:cli/stderr@0.3.0#write-via-stream"]
}
