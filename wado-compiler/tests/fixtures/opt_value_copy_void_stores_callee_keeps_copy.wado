// A `stores` callee with no result to hand the reference back through keeps it
// somewhere the caller cannot see — here through a builtin `push` the walk does
// not read. The borrow therefore outlives the call, and the later whole-value
// read copies rather than moves.

use { println, Stdout } from "core:cli";

struct Item { tags: List<String> }

struct Sink { r: &Item }

fn keep(dst: &mut List<Sink>, it: &Item) with stores[it] {
    dst.push(Sink { r: it });
}

fn make(i: i32) -> Item {
    return Item { tags: [`aa${i}`, "b"] };
}

fn build(n: i32) -> i32 {
    let mut out: List<Item> = [];
    let mut sinks: List<Sink> = [];
    for let mut i = 0; i < n; i += 1 {
        let it = make(i);
        keep(&mut sinks, &it);
        out.push(it);
    }
    return out.len() * 10 + sinks.len();
}

export fn run() with Stdout {
    println(`${build(3)}`);
}

__DATA__
{
    "stdout": "33\n",
    "wir_expect:O0": [
        "$value_copy$core:prelude/list.wado/List<core:prelude/string.wado/String>"
    ],
    "wir_expect:O2": ["array_clone_deep_prefix"]
}
