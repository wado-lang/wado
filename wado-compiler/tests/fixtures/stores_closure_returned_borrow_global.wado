// A closure that stores a borrow returned by a plain function into a global is flagged.

struct Inner {
    w: i32,
}

struct Node {
    inner: Inner,
}

global mut GLOBAL: &Inner = &Inner { w: 0 };

fn get_ref(n: &Node) -> &Inner {
    return &n.inner;
}

fn apply(f: fn(&Node), n: &Node) {
    f(n);
}

export fn run() {
    let node = Node { inner: Inner { w: 1 } };
    apply(|q: &Node| {
        GLOBAL = get_ref(q);
    }, &node);
}

__DATA__
{"compile_error": "closure may not store reference parameter 'q'"}
