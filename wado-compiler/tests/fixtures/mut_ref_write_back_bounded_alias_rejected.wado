// The destination's own name is past its last read, but a borrow of it taken
// outside the call is a second name the read goes through. A borrow says
// nothing about where it is read, so it counts as a read after the call and
// the call is refused.

variant Payload {
    Text(String),
    Empty,
}

struct Bag {
    item: Payload,
}

struct Keep {
    held: &mut Payload,
}

#[inline("never")]
fn park(k: &mut Keep, p: &mut Payload) {
    k.held = p;
    *p = Payload::Text("parked");
}

fn park_a_field(b: &mut Bag, spare: &mut Payload) -> bool {
    let mut unread = Keep { held: spare };
    let alias = &mut unread;
    park(&mut unread, &mut b.item);
    return alias.held matches { Text(_) };
}

test "unreachable" {
    let mut b = Bag { item: Payload::Empty };
    let mut spare = Payload::Empty;
    assert park_a_field(&mut b, &mut spare);
}

__DATA__
{
    "test": {},
    "compile_error": "stores it, so it outlives the call"
}
