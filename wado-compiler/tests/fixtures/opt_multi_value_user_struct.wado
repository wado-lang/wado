// Multi-value return ABI for user-struct-returning functions.
// `optimize::multi_value_return` lifts a 2-4 field POD-struct return ABI
// from heap-allocated `(ref Point)` to multi-value Wasm `(result i32 i32)`
// when every return site is a fresh `StructLiteral` and every call site
// destructures via field access on the bound temp.

struct Point {
    x: i32,
    y: i32,
}

#[inline("never")]
fn make_point(x: i32, y: i32) -> Point {
    return Point { x, y };
}

#[inline("never")]
fn sum_point() -> i32 {
    let p = make_point(10, 20);
    return p.x + p.y;
}

export fn run() {
    assert sum_point() == 30;
}

__DATA__
{
    "stdout": "",
    "wir_expect:O2": [
        "make_point\" = fn(i32, i32) -> [i32, i32]",
        "multivalue_bind [",
        "_mv_x,",
        "_mv_y]"
    ],
    "wir_not_expect:O2": [
        "struct.new \"opt_multi_value_user_struct.wado//Point\""
    ]
}
