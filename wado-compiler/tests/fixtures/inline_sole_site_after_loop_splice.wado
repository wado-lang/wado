// A callee admitted only at loop sites becomes its last caller's once the loop
// takes the other copy. Splicing `decode_at` into `sum_codes` leaves
// `first_code` holding its only call, which the verdict then admits. Nothing
// changes `first_code`'s body or its neighbours (`probe` keeps `run` away), so
// the inliner has to revisit it for what changed elsewhere.

fn decode_at(bytes: &Array<u8>, pos: i32) -> [i32, i32] {
    let b0 = bytes[pos] as i32;
    if b0 < 0x80 {
        return [b0, 1];
    }
    if b0 < 0xE0 {
        return [(b0 & 0x1F) << 6 | bytes[pos + 1] as i32 & 0x3F, 2];
    }
    if b0 < 0xF0 {
        return [(b0 & 0x0F) << 12 | (bytes[pos + 1] as i32 & 0x3F) << 6 | bytes[pos + 2] as i32 & 0x3F, 3];
    }
    return [(b0 & 0x07) << 18 | (bytes[pos + 1] as i32 & 0x3F) << 12 | (bytes[pos + 2] as i32 & 0x3F) << 6 | bytes[pos + 3] as i32 & 0x3F, 4];
}

#[inline(never)]
fn sum_codes(bytes: &Array<u8>) -> i32 {
    let mut total = 0;
    let mut pos = 0;
    while pos < bytes.len() {
        let [code, len] = decode_at(bytes, pos);
        total += code;
        pos += len;
    }
    return total;
}

#[inline(never)]
fn first_code(bytes: &Array<u8>, pos: i32) -> i32 {
    return decode_at(bytes, pos).0;
}

#[inline(never)]
fn probe(bytes: &Array<u8>, pos: i32) -> i32 {
    return first_code(bytes, pos) + 1;
}

fn to_array(list: List<u8>) -> Array<u8> {
    let mut out: Array<u8> = builtin::array_new(list.len());
    for let i of 0..<list.len() {
        out[i] = list[i];
    }
    return out;
}

export fn run() {
    let literal: List<u8> = b"A\xC3\xA9\xE2\x82\xAC";
    let bytes = to_array(builtin::black_box(literal));
    assert sum_codes(&bytes) == 0x41 + 0xE9 + 0x20AC;
    assert probe(&bytes, builtin::black_box(1)) == 0xEA;
}

__DATA__
{
    "stdout": "",
    "wir_scope": "inline_sole_site_after_loop_splice.wado/first_code",
    "wir_not_expect:O2": ["\"inline_sole_site_after_loop_splice.wado/decode_at\"("]
}
