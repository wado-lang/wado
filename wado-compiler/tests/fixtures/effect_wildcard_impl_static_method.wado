// Regression test: `with _` on a method settles from the type arguments of
// its impl and of the method itself, as it does on a free function. Over
// impls whose methods perform nothing, the call requires nothing, whether the
// arguments are inferred or spelled.

use { println, Stdout } from "core:cli";

trait Tick with _ {
    fn tick(&mut self) -> i32;
}

struct Quiet {}

impl Tick for Quiet {
    fn tick(&mut self) -> i32 {
        return 1;
    }
}

struct Loud {}

impl Tick for Loud {
    fn tick(&mut self) -> i32 with Stdout {
        println("tick");
        return 2;
    }
}

struct Runner<T: Tick> {
    count: i32,
    marker: Option<T>,
}

impl<T: Tick> Runner<T> {
    fn once(t: &mut T) -> i32 with _ {
        return t.tick();
    }

    fn twice(&self, t: &mut T) -> i32 with _ {
        return t.tick() + t.tick() + self.count;
    }
}

struct Plain {}

impl Plain {
    fn once<T: Tick>(t: &mut T) -> i32 with _ {
        return t.tick();
    }

    fn again<T: Tick>(&self, t: &mut T) -> i32 with _ {
        return t.tick();
    }
}

fn quiet() -> i32 {
    let mut q = Quiet {};
    let r = Runner::<Quiet> { count: 10, marker: null };
    let p = Plain {};
    return Runner::once(&mut q) + Runner::<Quiet>::once(&mut q) + r.twice(&mut q) + Plain::once(&mut q)
        + p.again(&mut q);
}

export fn run() with Stdout {
    println(`${quiet()}`);
    let mut l = Loud {};
    println(`${Runner::once(&mut l)}`);
    println(`${Plain::once(&mut l)}`);
}

__DATA__
{
    "stdout": "16\ntick\n2\ntick\n2\n"
}
