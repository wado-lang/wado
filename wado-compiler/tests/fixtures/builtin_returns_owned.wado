// A bodyless declaration that reads through a reference is taken to hand out
// that reference's storage, so its result is copied where a caller binds it.
// `builtin::array_clone` allocates instead, and says so with `#[returns(owned)]`
// — without it the struct literal below would copy the array a second time.
use { println, Stdout } from "core:cli";

struct Holder {
    repr: Array<i32>,
}

export fn run() with Stdout {
    let mut src: Array<i32> = builtin::array_new(3);
    builtin::array_fill(&mut src, 0, 7, 3);
    let h = Holder { repr: builtin::array_clone(&src) };
    println(`${builtin::array_len(&h.repr)} ${builtin::array_get_value(&h.repr, 0)}`);
}

__DATA__
{
    "stdout": "3 7\n",
    "wir_not_expect:O0": ["$value_copy$Array<i32>"]
}
