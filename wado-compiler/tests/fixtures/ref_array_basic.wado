// Basic array reference test

use { println, Stdout } from "core:cli";

fn modify_array(arr: &mut Array<i32>) {
    arr[0] = 100;
}

export fn run() with Stdout {
    let mut nums: Array<i32> = [1, 2, 3];
    let before = nums[0];
    println(`before: {before}`);
    modify_array(&mut nums);
    let after = nums[0];
    println(`after: {after}`);
}

__DATA__
{"stdout": "before: 1\nafter: 100\n"}
