use { println, Stdout } from "core:cli";

// from value_semantics_struct.wado
struct Point {
    x: i32,
    y: i32,
}

// from value_semantics_array.wado
fn value_semantics_array() with Stdout {
    let a: List<i32> = [1, 2, 3];
    let mut b = a;  // b is a copy of a (value semantics)
    b[0] = 99;  // modifying b does NOT affect a
    println(`a[0]={a[0]}`);  // prints 1 (a is unchanged)
    println(`b[0]={b[0]}`);  // prints 99 (b has the modification)
}

// from value_semantics_string.wado
fn value_semantics_string() with Stdout {
    let a = "hello";
    let b = a;  // b is a copy of a (value semantics)
    println(`a={a}`);
    println(`b={b}`);
}

// from value_semantics_struct.wado
fn value_semantics_struct() with Stdout {
    let a = Point { x: 1, y: 2 };
    let mut b = a;  // b is a copy of a (value semantics)
    b.x = 99;  // modifying b does NOT affect a
    println(`a.x={a.x}`);  // prints 1 (a is unchanged)
    println(`b.x={b.x}`);  // prints 99 (b has the modification)
}

// from value_semantics_tuple.wado
fn value_semantics_tuple() with Stdout {
    let a: [i32, i32] = [1, 2];
    let mut b = a;  // b is a copy of a (value semantics)
    b.0 = 99;  // modifying b does NOT affect a
    println(`a.0={a.0}`);  // prints 1 (a is unchanged)
    println(`b.0={b.0}`);  // prints 99 (b has the modification)
}

export fn run() with Stdout {
    value_semantics_array();
    value_semantics_string();
    value_semantics_struct();
    value_semantics_tuple();
}

__DATA__
{"stdout": "a[0]=1\nb[0]=99\na=hello\nb=hello\na.x=1\nb.x=99\na.0=1\nb.0=99\n"}
