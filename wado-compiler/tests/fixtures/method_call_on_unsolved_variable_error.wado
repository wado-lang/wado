// A method called on a value whose type is still an unsolved variable reports
// the slot nothing answers, not a missing method on a type the source never
// spells.

fn mk<C: Default>(v: i64) -> C {
    return C::default();
}

fn apply<A, B>(a: A, f: fn(A) -> B) -> B {
    return f(a);
}

export fn run() {
    let n = apply(1 as i64, |v| mk(v).len());
}

