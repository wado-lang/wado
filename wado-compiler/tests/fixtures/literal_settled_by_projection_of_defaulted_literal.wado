// A literal that takes its default settles, through an associated-type bound,
// the variable another literal of the same call waits on.

trait Src { type Item; }

impl Src for i32 { type Item = i64; }

fn f<A: Src<Item = B>, B>(a: A, b: B) -> B { return b; }

test {
    let r = f(1, 2);
    let s: i64 = r;
    assert s == 2;
}
