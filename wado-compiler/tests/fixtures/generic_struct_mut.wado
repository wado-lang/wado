// Test: generic struct with mutable field access
use { println, Stdout } from "core:cli";

struct Box<T> {
    value: T,
}

fn run() with Stdout {
    let mut b = Box { value: 10 };
    println(`before: {b.value}`);
    b.value = 42;
    println(`after: {b.value}`);
}

__DATA__
{"stdout": "before: 10\nafter: 42\n"}
