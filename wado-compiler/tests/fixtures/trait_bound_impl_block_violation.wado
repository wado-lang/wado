// A method of a bounded impl block, called where the bound does not hold,
// reports the bound.

struct Wrapper<T> {
    value: T,
}

// Only available when T: Ord
impl<T: Ord> Wrapper<T> {
    fn max_with(&self, other: &Wrapper<T>) -> T {
        if self.value > other.value {
            return self.value;
        }
        return other.value;
    }
}

variant Foo {
    A(fn() -> i32),
    B,
}

export fn run() {
    let w1 = Wrapper { value: Foo::A(|| 1) };
    let w2 = Wrapper { value: Foo::A(|| 2) };
    // Foo's `fn` payload has no Ord, so max_with() should not be available
    let m = w1.max_with(&w2);
}

__DATA__
{"compile_error": ":27:13: analysis error: type 'Foo' does not implement trait 'Ord' required by bound on 'T'"}
