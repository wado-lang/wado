// Regression test: a chain of `let r = source` Local→Local copies of
// a reference-typed local forms an alias group. Writing through any
// member must invalidate the same field across every alias.
//
// If field_forward's alias-group widening misses this, the read of
// `r1.value` folds to 0 (the value at `&mut x`'s inception), and the
// assert panics. The object escapes at the end, so `sroa` keeps it whole
// and the forwarding sees the writes through its aliases.

struct Count {
    value: i32,
}

export fn run() {
    let mut x = Count { value: 0 };
    let r1 = &mut x;
    let r2 = r1;
    r2.value = 7;
    assert r1.value == 7;
    assert x.value == 7;
    builtin::black_box(r2);
}

__DATA__
{
    "wir_pass": {"O2": ["nir/store_load_forward_post_scalarize"]},
    "wir_contrast": {"O2": [
        {"    builtin::black_box(r2);\n": ""}
    ]},
    "stdout": "",
    "wir_expect:O2": [".value = 7;"],
    "wir_not_expect:O2": ["panic"]
}
