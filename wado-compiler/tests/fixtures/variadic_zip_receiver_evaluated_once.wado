global mut calls: i32 = 0;

fn rows() -> [[i32, i32], [i32, i32]] {
    calls += 1;
    return [[1, 2], [3, 4]];
}

fn pack_rows<..A>(a: [..A], b: [..A]) -> [[..A], [..A]] {
    calls += 1;
    return [a, b];
}

fn pack_columns<..A>(a: [..A], b: [..A]) -> i32 {
    let z = pack_rows(a, b).zip();
    let mut n = 0;
    for let c of z {
        n += 1;
    }
    return n;
}

test "a concrete zip evaluates its receiver once" {
    calls = 0;
    let z = rows().zip();
    assert calls == 1;
    assert z.0.0 == 1;
    assert z.0.1 == 3;
    assert z.1.0 == 2;
    assert z.1.1 == 4;
}

test "a pack zip evaluates its receiver once" {
    calls = 0;
    assert pack_columns([1, "x"], [2, "y"]) == 2;
    assert calls == 1;
}

__DATA__
{
  "test": {}
}
