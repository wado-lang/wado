// A concrete struct that owns a resource may define a by-value `self` consuming
// method (WEP 2026-05-21): `into_fields(self)` hands the owned `Fields` off to
// the caller. This relaxes `SelfByValueOnNonResource`, which now fires only on a
// value type that provably cannot carry a resource. The moved-out `Fields` has a
// single owner and is transferred into the `Response`, so nothing leaks or
// double-drops; `w` is consumed by the call and gets no structural drop.

use { Request, Response, ErrorCode, Fields, Trailers } from "wasi:http";

struct Wrapper {
    f: Fields,
}

impl Wrapper {
    fn into_fields(self) -> Fields {
        return self.f;
    }
}

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    let w = Wrapper { f: Fields::new() };
    let headers = w.into_fields();

    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [response, _tx_future] = Response::new(headers, null, trailers_future);
    task return Result::<Response, ErrorCode>::Ok(response);
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

__DATA__
{"wasi:http/service": {"status": 200}}
