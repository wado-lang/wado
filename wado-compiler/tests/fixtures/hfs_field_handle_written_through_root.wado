// `licm` binds `log.items` ahead of the loop, and hot field scalarization holds
// its `used` in a scalar. A call taking `log` pushes onto that list, so the
// scalar goes stale, and the `if let` arm re-reads it. Its other arm, a bare
// `()`, had no node to hold the re-read, and the iteration's write-back stored
// the stale length, dropping the pushed item.

struct Log {
    items: List<i32>,
    calls: i32,
    marks: List<i32>,
}

#[inline(never)]
fn add(log: &mut Log, v: i32) {
    log.calls += 1;
    log.marks.push(log.calls);
    log.items.push(v);
}

fn walk(keys: List<i32>, log: &mut Log, nested: Option<i32>) {
    for let k of keys {
        if k > 0 {
            add(log, k);
        }
        if let Some(n) = nested {
            let kept = log.items.len();
            add(log, n);
            assert log.items.len() == kept + 1;
            log.items.truncate(kept);
        }
    }
}

export fn run() {
    let mut log = Log { items: [], calls: 0, marks: [] };
    walk(builtin::black_box([1, -2, 3] as List<i32>), &mut log, builtin::black_box(null));
    assert log.items.len() == 2;
    assert log.calls == 2;

    let mut nested = Log { items: [], calls: 0, marks: [] };
    walk(builtin::black_box([1, -2, 3] as List<i32>), &mut nested, builtin::black_box(Option::Some(42)));
    assert nested.items.len() == 2;
    assert nested.items[0] == 1;
    assert nested.items[1] == 3;
    assert nested.calls == 5;
}

__DATA__
{"stdout": ""}
