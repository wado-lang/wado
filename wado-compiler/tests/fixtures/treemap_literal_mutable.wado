// TreeMap literal: mutable map created from literal
use { println } from "core:cli";
use { TreeMap } from "core:collections";

export fn run() with Stdout {
    let mut m: TreeMap<String, i32> = { x: 1, y: 2 };

    assert m.len() == 2;

    // Mutate after literal creation
    m["z"] = 3;
    assert m.len() == 3;

    // Update existing key
    m["x"] = 100;
    assert m["x"] == 100;

    println("mutable: ok");
}

__DATA__
{"stdout": "mutable: ok\n"}
