// Test: Non-exhaustive match on Option should produce a compile error
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let opt: Option<i32> = Option::Some(42);
    let val = match opt {
        Some(x) => x,
        // Missing None arm
    };
    println(`${val}`);
}

__DATA__
{"compile_error": "missing case `None`"}
