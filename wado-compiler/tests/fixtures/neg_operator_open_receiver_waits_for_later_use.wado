// Either `Neg` may answer `-a` while `T` is open, so the negation is typed by
// the trait's `Output` and waits for the line settling `T` to `u64`.

struct Bx<T> { v: T }

impl Neg for Bx<u64> {
    type Output = Bx<u64>;
    fn neg(&self) -> Bx<u64> {
        return Bx { v: self.v + 1 };
    }
}

impl Neg for Bx<i64> {
    type Output = Bx<i64>;
    fn neg(&self) -> Bx<i64> {
        return Bx { v: self.v - 1 };
    }
}

fn mk<T: Default>() -> Bx<T> {
    return Bx { v: T::default() };
}

test {
    let a = mk();
    let c = -a;
    let _d: Bx<u64> = a;
    let e: Bx<u64> = c;
    assert e.v == 1;
}
