// Two implemented traits both supply a default-bodied static of one name, so
// `M::make(...)` names neither. Unreported, the call was built to whichever
// impl came first and reached codegen as a module nothing validates.

trait Alpha {
    fn make(n: i32 = 1) -> i32 {
        return n;
    }
}

trait Beta {
    fn make(a: i32, b: i32) -> i32 {
        return a + b;
    }
}

struct M {}

impl Alpha for M {}
impl Beta for M {}

export fn run() {
    assert M::make(1, 2) == 3;
}

__DATA__
{"compile_error": "ambiguous method 'make'"}
