// Soundness regression (issue #1472): LICM must not hoist a field read out of
// a loop that mutates the same field through a `&mut` alias bound to that field.
//
// `r = &mut self.xs` aliases `self.xs`. Inside the loop, `r.push(-1)` grows the
// list (clobbering the `List<i32>` pointee), while the guard reads the same
// list directly as `self.xs.len()`. LICM used to hoist `self.xs` (and its
// `.used` length field) to the pre-header because the read goes through the
// field chain `self.xs` while the write goes through the opaque alias `r` — so
// the modified-vars analysis never connected the two. The hoisted guard then
// never observed the growth, looping forever until `List::grow` runs the heap
// out of memory.

struct Acc {
    xs: List<i32>,
    tag: i32,
}

impl Acc {
    fn grow(&mut self, idx: i32) {
        let r = &mut self.xs;
        while self.xs.len() <= idx {
            r.push(-1);
        }
        self.xs[idx] = 42;
    }
}

export fn run() {
    let mut a = Acc { xs: [], tag: 7 };
    a.grow(3);
    assert a.xs.len() == 4, `len = {a.xs.len()}`;
    assert a.xs[3] == 42, `xs[3] = {a.xs[3]}`;
    assert a.tag == 7;
}

