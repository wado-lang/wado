// A qualifier may spell the type declaring the case even where the file never
// imports that type: the bare `Alpha` needs no import either, so requiring one
// for the clearer spelling would punish it. The name is matched against the
// declaration the scrutinee's cases come from, not against another rendering.

use { pick } from "./sub/pattern_qualifier_unimported_type.wado";

test "an unimported type name qualifies a nested case" {
    assert pick(-1) matches { Err(Kind::Alpha) };
    assert pick(1) matches { Ok(_) };
}

test "the bare case needs no import either" {
    assert pick(-1) matches { Err(Alpha) };
}

__DATA__
{"test": {}}
