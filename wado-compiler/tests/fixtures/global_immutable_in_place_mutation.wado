// `global` without `mut` forbids reassignment, not in-place mutation — the
// same rule `let` follows. So what a global's initializer assigned is not what
// it holds forever, and the optimizer must not fold reads from it once
// something writes through the global.
//
// Without that, `len()` folds to the initializer's 3 and the program disagrees
// with itself across optimization levels.

use { println, Stdout } from "core:cli";

global T: List<i32> = [1, 2, 3];

export fn run() with Stdout {
    T.push(4);
    assert T.len() == 4;
    assert T[3] == 4;
    println(`${T.len()} ${T[3]}`);
}

__DATA__
{
    "stdout": "4 4\n"
}
