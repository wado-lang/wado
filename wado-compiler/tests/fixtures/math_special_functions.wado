use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let x: f64 = builtin::black_box(0.5);
    let y: f32 = builtin::black_box(0.5);

    println(`erf ${f64::erf(x)}`);
    println(`erf_neg ${f64::erf(-x)}`);
    println(`erf_zero ${f64::erf(0.0)}`);
    println(`erf_inf ${f64::erf(f64::INFINITY)}`);
    println(`erfc ${f64::erfc(x)}`);
    println(`erfc_tail ${f64::erfc(10.0):e}`);
    println(`gamma ${f64::gamma(x)}`);
    println(`gamma_int ${f64::gamma(5.0)}`);
    println(`ln_gamma ${f64::ln_gamma(10.0)}`);
    println(`ln_gamma_neg ${f64::ln_gamma(-x)}`);

    println(`erff ${f32::erf(y)}`);
    println(`erff_neg ${f32::erf(-y)}`);
    println(`erfcf ${f32::erfc(y)}`);
    println(`gammaf_int ${f32::gamma(5.0)}`);
    println(`ln_gammaf ${f32::ln_gamma(10.0)}`);
}

__DATA__
{"stdout": "erf 0.5204998778130465\nerf_neg -0.5204998778130465\nerf_zero 0\nerf_inf 1\nerfc 0.4795001221869535\nerfc_tail 2.088487583762545e-45\ngamma 1.7724538509055159\ngamma_int 24\nln_gamma 12.80182748008147\nln_gamma_neg 1.2655121234846454\nerff 0.5204999\nerff_neg -0.5204999\nerfcf 0.47950011\ngammaf_int 24\nln_gammaf 12.801827\n"}
