// test: `#[serde(default)]` is rejected, guiding to a default field value.
use { Serialize, Deserialize } from "core:serde";

struct Config {
    host: String,

    #[serde(default)]
    port: i32,
}

impl Serialize for Config;
impl Deserialize for Config;

export fn run() {}

__DATA__
{"compile_error": "`#[serde(default)]` is not supported; give field 'port' a default value instead"}
