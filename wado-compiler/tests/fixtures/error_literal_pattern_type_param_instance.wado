// A literal pattern on a type parameter is judged per instance: an instance
// whose type the literal cannot be is an error at the call that makes it,
// as a string-literal pattern without `Eq<String>` already is.

fn is_true<T>(x: T) -> i32 {
    return match x {
        true => 1,               // compile error: pattern mismatch: expected 'bool', found 'i32'
        _ => 0,
    };
}

fn is_a<T>(x: T) -> i32 {
    return match x {
        'a' => 1,                // compile error: pattern mismatch: expected 'char', found 'i32'
        _ => 0,
    };
}

fn is_seven<T>(x: T) -> i32 {
    return match x {
        7 => 1,                  // compile error: invalid pattern: `7` is a float on `f64`
        _ => 0,
    };
}

fn is_one_byte<T>(x: T) -> i32 {
    return match x {
        1_u8 => 1,               // compile error: pattern mismatch: expected 'u8', found 'i32'
        _ => 0,
    };
}

fn is_digit<T>(x: T) -> i32 {
    return match x {
        '0'..='9' => 1,         // compile error: pattern mismatch: expected 'char', found 'f64'
        _ => 0,
    };
}

fn is_large<T>(x: T) -> i32 {
    return match x {
        300 => 1,                // compile error: invalid pattern: literal out of range for `u8`: 300
        _ => 0,
    };
}

export fn run() {
    let a = is_true(1_i32);
    let b = is_a(97_i32);
    let c = is_seven(7.0);
    let d = is_one_byte(1_i32);
    let e = is_digit(0.5);
    let f = is_large(1_u8);
}

__DATA__
{
  "compile_error": "pattern mismatch",
  "compile_errors_contains": [
    "pattern mismatch: expected 'bool', found 'i32'",
    "pattern mismatch: expected 'char', found 'i32'",
    "invalid pattern: `7` is a float on `f64`, and a float literal is no pattern; compare it in a guard",
    "pattern mismatch: expected 'u8', found 'i32'",
    "pattern mismatch: expected 'char', found 'f64'",
    "invalid pattern: literal out of range for `u8`: 300"
  ]
}
