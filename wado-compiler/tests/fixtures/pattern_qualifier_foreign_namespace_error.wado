// A qualifier's namespace prefix must be one the scrutinee's type is reachable
// through. A prefix naming no namespace at all used to fall back to a bare-name
// lookup, so any prefix was accepted.

variant Maybe<T> {
    Just(T),
    Nothing,
}

export fn run() {
    let m: Maybe<i32> = Maybe::Just(1);
    assert !(m matches { bogus::Maybe::Nothing });
}

__DATA__
{
  "compile_error": "pattern mismatch: expected 'valid case of Maybe<i32>', found 'bogus::Maybe::Nothing'"
}
