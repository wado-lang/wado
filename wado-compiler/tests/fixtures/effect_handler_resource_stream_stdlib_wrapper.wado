// A handler claims the primitive even when a stdlib wrapper is what calls it.
// `read_to_end` and `write_all` are impl bodies over a type parameter, so their
// `#[cm]` calls name no concrete receiver until monomorphize mints the instance —
// effect-dispatch rewriting has to run again over those, or the call reaches the
// canonical past the installed handler.
//
// The direct-call form is effect_handler_resource_stream.wado.

use { println, Stdout } from "core:cli";

struct MockStream {
    log: List<u8>,
}

impl Stream<u8> for MockStream {
    // A real pair, which the outer dispatch chain makes, since an integer
    // converts to no resource.
    fn new(&mut self) -> [Stream<u8>, StreamWritable<u8>] {
        resume Stream::<u8>::new()
    }
    // `read_to_end` loops until a copy reports something other than
    // `Completed`, so the drained handler reports `Dropped` rather than an
    // empty chunk — an empty `Completed` would spin forever.
    fn begin_read(&mut self, this: &Stream<u8>, max: i32) -> StartedRead<u8> {
        let _ = this;
        let _ = max;
        let snapshot = self.log;
        self.log = [];
        let drained = snapshot.is_empty();
        resume StartedRead::settled(StreamChunk {
            items: snapshot,
            result: if drained { CopyResult::Dropped } else { CopyResult::Completed },
        })
    }
    fn drop(&mut self, this: &Stream<u8>) {
        let _ = this;
        resume ()
    }
    ..trap
}

impl StreamWritable<u8> for MockStream {
    fn begin_write(&mut self, this: &StreamWritable<u8>, data: List<u8>) -> StartedWrite<u8> {
        let _ = this;
        for let b of data {
            self.log.push(b);
        }
        resume StartedWrite::settled(StreamWrite { rest: [], result: CopyResult::Completed })
    }
    fn write_raw_all(&mut self, this: &StreamWritable<u8>, data: Slice<u8>) -> CopyResult {
        let _ = this;
        self.log.extend_from_slice(data);
        resume CopyResult::Completed
    }
    fn drop(&mut self, this: &StreamWritable<u8>) {
        let _ = this;
        resume ()
    }
    ..trap
}

export fn run() with Stdout {
    let mut s = MockStream { log: [] };
    with &mut s do {
        let [rx, tx] = Stream::<u8>::new();
        let hi: List<u8> = [104 as u8, 105 as u8]; // "hi"
        tx.write_all(hi);
        let bang: List<u8> = [33 as u8]; // "!"
        tx.write_raw_all(bang.as_slice());
        let got = rx.read_to_end();
        assert got.len() == 3;
        assert got[0] == 104 as u8;
        assert got[2] == 33 as u8;
        tx.drop();
        rx.drop();
    }
    println(`buffered=${s.log.len()}`);
}

__DATA__
{"stdout": "buffered=0\n"}
