// Test: call methods on elements retrieved from Array<Array<i32>>
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let matrix: Array<Array<i32>> = [[1, 2, 3], [4, 5]];

    // len() on retrieved element
    let row0 = matrix[0];
    println(`{row0.len()}`);

    // Direct method chain
    println(`{matrix[1].len()}`);

    println("ok");
}

__DATA__
{"stdout": "3\n2\nok\n"}
