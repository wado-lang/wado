// Test constant folding: integer comparison, bitwise, boolean, float comparison
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Integer comparison folding
    let cmp1 = 10 > 5;
    let cmp2 = 3 == 3;
    let cmp3 = 1 != 2;
    let cmp4 = 5 <= 5;
    println(`cmp: {cmp1} {cmp2} {cmp3} {cmp4}`);

    // Integer bitwise folding
    let band = 0xFF & 0x0F;
    let bor = 0xF0 | 0x0F;
    let bxor = 0xFF ^ 0x0F;
    println(`bitwise: {band} {bor} {bxor}`);

    // Integer shift folding
    let shl = 1 << 4;
    let shr = 256 >> 4;
    println(`shift: {shl} {shr}`);

    // Boolean logical folding
    let and_t = true && true;
    let and_f = true && false;
    let or_t = false || true;
    let or_f = false || false;
    let not_t = !false;
    println(`bool: {and_t} {and_f} {or_t} {or_f} {not_t}`);

    // Float comparison folding (comparisons produce bool, safe to fold)
    let flt = 1.0 < 2.0;
    let fge = 5.0 >= 5.0;
    println(`fcmp: {flt} {fge}`);

    // Combined: const propagation + const folding
    let a = 10 + 20;
    let b = a * 2;
    println(`combined: {b}`);
}

__DATA__
{"stdout": "cmp: true true true true\nbitwise: 15 255 240\nshift: 16 16\nbool: true false true false true\nfcmp: true true\ncombined: 60\n"}
