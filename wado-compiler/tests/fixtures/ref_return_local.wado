// Returning reference to local - works with GC (would be UB in Rust/C++)

use { println, Stdout } from "core:cli";

fn make_ref() -> &i32 {
    let x = 42;
    return &x;  // In Rust this would be an error!
}

fn run() with Stdout {
    let r = make_ref();
    println(`{*r}`);
}

__DATA__
{"stdout": "42\n"}
