// Test: generic struct with impl block
use { println, Stdout } from "core:cli";

struct Box<T> {
    value: T,
}

impl<i32> Box<i32> {
    fn get(&self) -> i32 {
        return self.value;
    }
}

export fn run() with Stdout {
    let b = Box { value: 42 };
    let v = b.get();
    println(`{v}`);
}

__DATA__
{"stdout": "42\n"}
