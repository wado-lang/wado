use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

export fn run() with Stdout {
    let p = Point { x: 10, y: 20 };
    println(`{p:?}`);

    let origin = Point { x: 0, y: 0 };
    println(`{origin:?}`);
}

__DATA__
{"stdout": "Point { x: 10, y: 20 }\nPoint { x: 0, y: 0 }\n"}
