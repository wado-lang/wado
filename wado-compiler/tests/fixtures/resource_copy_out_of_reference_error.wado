// A generic reaches an affine value through a reference only where its
// parameter is declared `affine` (WEP: Affine Types). A user's own `&self`
// getter over an unmarked `T` is not instantiated with a resource, and
// `list.last()` is not found, since `Sequence`, which declares it, is
// implemented for a copyable element only. `list[0]` read by value is a move
// out of a reference, which `spec_components_copy_out_of_reference` states.

use { Request, Response, ErrorCode, Fields, Headers, Trailers } from "wasi:http";

struct Shelf<T> {
    items: List<T>,
}

impl<T> Shelf<T> {
    fn first(&self) -> T {
        return self.items[0];
    }
}

fn eat(fields: Fields) {
}

fn copy() with Fields {
    let list: List<Fields> = [Fields::new()];
    let shelf = Shelf { items: [Fields::new()] };
    eat(list.last().unwrap());
}

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    copy();
    let [trailers, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [response, _sent] = Response::new(Headers::new(), null, trailers);
    task return Result::<Response, ErrorCode>::Ok(response);
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

