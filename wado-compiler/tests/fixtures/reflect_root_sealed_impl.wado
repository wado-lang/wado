// `Reflect` is sealed like every kind under it: a user `impl Reflect for T` is a
// compile error (the compiler synthesizes the impl for every named type).

struct Point {
    x: i32,
    y: i32,
}

impl Reflect for Point {
    fn type_name() -> String {
        return "forged";
    }
}

test "unreachable" {
    assert true;
}

__DATA__
{
    "test": {},
    "compile_error": "cannot implement `Reflect`: it is a sealed"
}
