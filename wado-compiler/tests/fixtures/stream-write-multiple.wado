// Test: StreamWritable::write() can be called multiple times
// Writes two chunks to the stream before closing.
use { Stdout } from "core:cli";

export fn run() with Stdout {
    let [rx, tx] = Stream::<u8>::new();

    // Start the consumer first (WASI P3 async ordering)
    Stdout::write_via_stream(rx);

    // Write "AB" as two separate chunks
    let chunk1: Array<u8> = [65, 66]; // "AB"
    let chunk2: Array<u8> = [67, 10]; // "C\n"
    tx.write(chunk1);
    tx.write(chunk2);
    tx.close();
}

__DATA__
{"TODO": true, "stdout": "ABC\n"}
