// Verifies that a failed outgoing request surfaces to the guest as
// `Err(ErrorCode)` from `Client::send`, and that the guest can match on it.
//
// The harness has no mock for this path, so its `send_request` hook fails.
// wasmtime 48 renders an embedder hook's error through `error_to_p3` into a
// guest-visible `ErrorCode` — the hook signature carries no trap channel — so
// what this pins is the guest's own view of the failure. The 502 below can
// only come from the `Err` arm, which is the assertion.

use { Request, Response, ErrorCode, Fields, Scheme, Trailers } from "wasi:http";
use { Client } from "wasi:http/client.wado";

export async fn handle(request: Request) -> Result<Response, ErrorCode>
    with Client
{
    let headers = Fields::new();
    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [out_req, _req_future] = Request::new(headers, null, trailers_future, null);

    out_req.set_scheme(Option::<Scheme>::Some(Scheme::Http));
    out_req.set_authority(Option::<String>::Some("localhost"));
    out_req.set_path_with_query(Option::<String>::Some("/no-mock-exists"));

    let result = Client::send(out_req).wait();
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));

    let [reply_trailers_future, reply_trailers_tx] =
        Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let reply_headers = Fields::new();
    let [reply, _reply_future] = Response::new(reply_headers, null, reply_trailers_future);
    match result {
        Result::Ok(_) => reply.set_status_code(200),
        Result::Err(_) => reply.set_status_code(502),
    }
    task return Result::<Response, ErrorCode>::Ok(reply);
    reply_trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

__DATA__
{
    "wasi:http/service": {
        "status": 502
    }
}
