// Unrelated aggregates: the slice views (repr, start, end), the list owns
// (repr, len). `as` used to pass the slice through as a `List<u8>`.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let v = "49".as_bytes() as List<u8>;
    println(`${v.len()}`);
}

