// `xs[i]` and `xs[i + 2]` run on one straight path with nothing observable
// between, so the first check takes the last's upper half: `i < len - 2`.
// Either failing traps, and a contract asks only that a violation traps, so
// `xs[i + 1]` and `xs[i + 2]` need no check of their own.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn ascending(xs: &List<i32>, i: i32) -> i32 {
    return xs[i] + xs[i + 1] + xs[i + 2];
}

export fn run() with Stdout {
    let xs: List<i32> = builtin::black_box([1, 2, 3, 4]);
    println(`${ascending(&xs, builtin::black_box(1))}`);
}

__DATA__
{
    "stdout": "9\n",
    "wir_scope": "ascending",
    "wir_expect:O2": [
        "$load_{n} - 2)"
    ],
    "wir_not_expect:O2": [
        "(i + 1) >=",
        "(i + 2) >="
    ]
}
