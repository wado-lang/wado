// `xs[i]` passing puts `i` in `0..len`, so `i + 1` cannot be negative: each
// later index checks only its upper half.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn ascending(xs: &List<i32>, i: i32) -> i32 {
    return xs[i] + xs[i + 1] + xs[i + 2];
}

export fn run() with Stdout {
    let xs: List<i32> = builtin::black_box([1, 2, 3, 4]);
    println(`${ascending(&xs, builtin::black_box(1))}`);
}

__DATA__
{
    "stdout": "9\n",
    "wir_scope": "ascending",
    "wir_expect:O2": [
        "if @unlikely(i >=u ",
        "(i + 1) >= $load_{n})",
        "(i + 2) >= $load_{n})"
    ],
    "wir_not_expect:O2": [
        "0 > ",
        "0 <= "
    ]
}
