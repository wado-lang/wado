// Test for multiple array indexing calls in one function
// This tests whether multiple inlines correctly track local indices

use { println, Stdout } from "core:cli";

struct Container<T> {
    items: Array<T>,
    flags: Array<bool>,
}

impl Container<T> {
    fn get_item(&self, i: i32) -> T {
        return self.items[i];
    }

    fn is_flagged(&self, i: i32) -> bool {
        return self.flags[i];
    }

    fn count_flagged(&self) -> i32 {
        let mut count = 0;
        for let mut i = 0; i < self.flags.len(); i += 1 {
            if self.flags[i] {
                count += 1;
            }
        }
        return count;
    }
}

fn run() with Stdout {
    let c: Container<String> = Container {
        items: ["apple", "banana", "cherry"],
        flags: [true, false, true],
    };

    // Multiple method calls that should be inlined
    let item0 = c.get_item(0);
    let item1 = c.get_item(1);
    let item2 = c.get_item(2);
    let flag0 = c.is_flagged(0);
    let flag1 = c.is_flagged(1);
    let count = c.count_flagged();

    println(`items: {item0}, {item1}, {item2}`);
    println(`flags: {flag0}, {flag1}`);
    println(`count: {count}`);
}

__DATA__
{"stdout": "items: apple, banana, cherry\nflags: true, false\ncount: 2\n"}
