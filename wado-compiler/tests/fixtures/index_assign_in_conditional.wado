// Index assignment inside conditionals
use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let mut arr: Array<i32> = [0, 0, 0];
    let condition = true;

    if condition {
        arr[0] = 111;
    } else {
        arr[0] = 999;
    }

    if !condition {
        arr[1] = 888;
    } else {
        arr[1] = 222;
    }

    // Nested if
    if condition {
        if condition {
            arr[2] = 333;
        }
    }

    println(`{arr[0]} {arr[1]} {arr[2]}`);
}

__DATA__
{"stdout": "111 222 333\n"}
