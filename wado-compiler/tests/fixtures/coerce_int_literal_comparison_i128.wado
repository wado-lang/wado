// Test integer literal coercion in comparison operators for i128/u128
// Uses if/panic instead of assert to avoid pre-existing u128 template interpolation bug
use { println, Stdout } from "core:cli";

fn check(cond: bool, label: String) {
    if !cond {
        panic(label);
    }
}

export fn run() with Stdout {
    let x_u128: u128 = 1000;
    let x_i128: i128 = -500;

    // == with literal on both sides
    check(x_u128 == 1000, "u128 == rhs");
    check(1000 == x_u128, "lhs == u128");
    check(x_i128 == -500, "i128 == rhs");
    check(-500 == x_i128, "lhs == i128");

    // != with literal on both sides
    check(x_u128 != 999, "u128 != rhs");
    check(999 != x_u128, "lhs != u128");
    check(x_i128 != 0, "i128 != rhs");
    check(0 != x_i128, "lhs != i128");

    // < with literal on both sides
    check(x_u128 < 1001, "u128 < rhs");
    check(999 < x_u128, "lhs < u128");
    check(x_i128 < 0, "i128 < rhs");
    check(-501 < x_i128, "lhs < i128");

    // > with literal on both sides
    check(x_u128 > 999, "u128 > rhs");
    check(1001 > x_u128, "lhs > u128");
    check(x_i128 > -501, "i128 > rhs");
    check(0 > x_i128, "lhs > i128");

    // <= with literal on both sides
    check(x_u128 <= 1000, "u128 <= rhs");
    check(1000 <= x_u128, "lhs <= u128");
    check(x_i128 <= -500, "i128 <= rhs");
    check(-500 <= x_i128, "lhs <= i128");

    // >= with literal on both sides
    check(x_u128 >= 1000, "u128 >= rhs");
    check(1000 >= x_u128, "lhs >= u128");
    check(x_i128 >= -500, "i128 >= rhs");
    check(-500 >= x_i128, "lhs >= i128");

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
