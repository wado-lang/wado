// `let r = *self; return r;` delivers what `return *self` does: the place,
// which the return conventions call a projection of `self`, so the caller
// copies it. The `let` shares instead of copying, and the value is copied once.

use { println, Stdout } from "core:cli";

struct Rec {
    name: String,
    n: i32,
}

impl Rec {
    #[inline(never)]
    fn same(&self) -> Rec {
        let r = *self;
        return r;
    }
}

#[inline(never)]
fn wrap(base: &Rec) -> Option<Rec> {
    return Some(base.same());
}

export fn run() with Stdout {
    let base = builtin::black_box(Rec { name: "a", n: 1 });
    let mut out = wrap(&base).unwrap();
    out.name.push_str("!");
    assert base.name == "a";
    assert out.name == "a!" && out.n == 1;
    println("ok");
}

__DATA__
{
    "wir_pass": {"O2": ["lower/value_copy/share", "nir/copy_elision"]},
    "stdout": "ok\n",
    "wir_scope": "value_copy_returned_binding_shares.wado/value_copy_returned_binding_shares.wado/Rec::same\"",
    "wir_not_expect:O2": ["array_copy"]
}
