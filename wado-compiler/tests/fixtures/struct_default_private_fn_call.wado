// Regression (issue #1308): a struct field default may call a private
// function of the struct's declaring module. Omitting `size` here
// synthesizes `helper()`, which must resolve in the defining module's
// scope rather than erroring with `unknown function 'helper'` at the
// construction site.

use { Widget, widget_size } from "./sub/struct_default_private_fn_call_lib.wado";

export fn run() {
    let w = Widget { name: "x" };
    assert widget_size(w) == 7;
}

