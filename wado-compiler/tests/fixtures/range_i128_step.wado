#![TODO]
// Step trait for i128/u128 (WEP mentions these types)

test "i128 range iteration" {
    let mut sum: i128 = 0 as i128;
    for let i of 1 as i128..=5 as i128 {
        sum = sum + i;
    }
    assert sum == 15 as i128;
}

test "u128 range iteration" {
    let mut sum: u128 = 0 as u128;
    for let i of 0 as u128..<5 as u128 {
        sum = sum + i;
    }
    assert sum == 10 as u128;
}

