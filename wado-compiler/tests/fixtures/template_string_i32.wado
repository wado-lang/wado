// Test template string interpolation with i32 values

use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let pos = 42;
    let neg = 0 - 17;
    let zero = 0;
    println(`positive: {pos}`);
    println(`negative: {neg}`);
    println(`zero: {zero}`);
}

__DATA__
{"stdout": "positive: 42\nnegative: -17\nzero: 0\n"}
