// Two blankets holding at the same level are tied — where each was written is
// not a rank — so the call reports rather than letting declaration order pick.
// `trait_error_local_blanket_ties_foreign.wado` is the same tie with one of the
// two written at the call site (WEP 2026-09-01).

use { Limit, Mark, Describe } from "./sub/two_foreign_value_blankets_traits.wado";
use { } from "./sub/two_foreign_value_blankets_limit.wado";
use { } from "./sub/two_foreign_value_blankets_mark.wado";

struct Point {
    x: i32,
}

impl Limit for Point {
    fn limit() -> i32 {
        return 7;
    }
}

impl Mark for Point {
    fn mark() -> i32 {
        return 9;
    }
}

export fn run() {
    let p = Point { x: 1 };
    assert p.describe() == "limit:7";
}

