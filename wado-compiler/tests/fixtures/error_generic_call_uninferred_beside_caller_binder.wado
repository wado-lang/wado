// A callee parameter nothing infers is reported even where the caller declares
// one of the same name at the same index, and a defaulted neighbour (`U`)
// does not hide it.
fn make<T, U = i32>() -> List<T> {
    return [];
}

fn g<T>(t: T) -> i32 {
    let l = make();
    return l.len();
}

export fn run() {
    assert g(1) == 0;
}

