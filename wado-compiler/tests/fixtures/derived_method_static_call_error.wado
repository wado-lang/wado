// A derived method called by type path checks its arguments as a declared one
// does: the receiver is the instance the path writes, else the declaration at
// its own parameters, and an instance withholding the derivation has none.

struct Pair<T> { a: T, b: T }

struct Opaque { v: i32 }
impl Eq for Opaque { fn eq(&self, other: &Opaque) -> bool { return true; } }

test "the turbofish names the receiver" {
    let p = Pair { a: 1_i64, b: 2_i64 };
    assert Pair::<i32>::eq(&p, &p);
}

test "an argument of another type is a mismatch" {
    assert Pair::eq(&1, &2);
}

test "an instance withholding the derivation has no method" {
    let p = Pair { a: Opaque { v: 1 }, b: Opaque { v: 2 } };
    assert Pair::cmp(&p, &p) == Ordering::Equal;
}

variant Tree<T> { Leaf(T), Empty }

test "an argument settling no parameter asks for a turbofish" {
    assert Tree::eq(&Tree::Empty, &Tree::Empty);
}

__DATA__
