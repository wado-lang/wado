// A drop of a resource with no host implementation is an operation like any
// other: an installed handler answers it, a written one and a scope exit
// alike. With no handler installed, it does nothing more.

use { println, Stdout } from "core:cli";

struct Count {
    n: i32,
}

resource Counter {
    fn get(&self) -> i32;
    fn drop(self);
}

struct Impl {
    drops: i32,
}

impl Counter for Impl {
    fn get(&mut self, this: &Counter) -> i32 {
        let Some(c) = this.backing::<Count>() else { unreachable(); };
        resume c.n;
    }
    fn drop(&mut self, this: Counter) {
        let _ = this;
        self.drops += 1;
        resume ()
    }
    ..trap
}

export fn run() with Stdout {
    let mut h = Impl { drops: 0 };
    with Counter => &mut h do {
        let explicit = Counter::backed_by(Count { n: 1 });
        explicit.drop();
        let scoped = Counter::backed_by(Count { n: 2 });
        println(`${scoped.get()}`);
    }
    println(`drops=${h.drops}`);
    let unhandled = Counter::backed_by(Count { n: 3 });
    unhandled.drop();
    println("unhandled drop ok");
}

__DATA__
{"stdout": "2\ndrops=2\nunhandled drop ok\n"}
