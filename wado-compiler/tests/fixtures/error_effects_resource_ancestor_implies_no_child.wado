// A resource implies none of the resources that extend it: holding
// `EventTarget` grants an operation `Elem` declares on no handle.
#[cm("test:dom/event-target", linearity = "unrestricted", repr = "externref")]
resource EventTarget {
    fn tag(&self) -> String;
}

#[cm("test:dom/elem", linearity = "unrestricted", repr = "externref")]
resource Elem extends EventTarget {
    fn b(&self) -> String;
}

fn child(e: Elem) -> String with EventTarget {
    return e.b();
}

export fn run() {}

__DATA__
{
    "compile_error": ":14:12: analysis error: missing resource 'Elem' required by 'b'",
    "compile_error_codes": ["MISSING_EFFECT"]
}
