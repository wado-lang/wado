// The attribute is placed on a module function, and on a method of an `impl`,
// a trait or a resource. Anywhere else it would be read by nothing, so it is
// rejected rather than dropped.

interface Log {
    #[unavailable("removed in 0.5.0; use `emit`")]
    fn old_emit(message: String);

    fn level() -> i32;
}

export fn run() {}

