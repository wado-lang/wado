// TreeMap remove and reinsert
use { println } from "core:cli";
use { TreeMap } from "core:collections";

export fn run() with Stdout {
    let mut map = TreeMap::<String, i32>::new();

    map["a"] = 1;
    map["b"] = 2;
    map["c"] = 3;

    // Remove existing key
    assert map.remove("b");
    assert !map.contains_key("b");
    assert map.len() == 2;
    assert map.contains_key("a");
    assert map.contains_key("c");

    // Remove nonexistent key
    assert !map.remove("z");
    assert map.len() == 2;

    // Reinsert after remove
    map["b"] = 999;
    assert map.contains_key("b");
    if let Some(val) = map["b"] {
        assert val == 999;
    }
    assert map.len() == 3;

    println("remove operations: ok");
}

