// Struct destructuring with matches operator

use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

struct Person {
    name: String,
    age: i32,
    email: String,
}

export fn run() with Stdout {
    let p = Point { x: 10, y: 20 };

    // matches with unnamed struct pattern and guard
    if p matches { { x, y } && x > 0 } {
        println("positive x");
    }

    // matches with named struct pattern
    if p matches { Point { x, y } && x + y > 25 } {
        println("large point");
    }

    // matches with rest and guard
    let person = Person { name: "Alice", age: 30, email: "alice@test.com" };
    if person matches { { age, .. } && age >= 18 } {
        println("adult");
    }

    // matches evaluates to bool
    let is_origin = p matches { { x, y } && x == 0 && y == 0 };
    if is_origin {
        println("origin");
    } else {
        println("not origin");
    }
}

__DATA__
{"stdout": "positive x\nlarge point\nadult\nnot origin\n"}
