// A marker in the first arm's guard runs on every path through the `match`
// when that arm's pattern always matches, so the whole `match` is cold and the
// call in its arm prices as one, staying a call.
use { println, Stdout } from "core:cli";

fn h(x: i32) -> i32 {
    let mut s = x;
    s = s * 31 + builtin::black_box(7);
    s = s ^ (s >> 3);
    s = s * 17 + builtin::black_box(5);
    s = s ^ (s >> 5);
    s = s * 13 + builtin::black_box(3);
    s = s ^ (s >> 7);
    return s;
}

#[inline("never")]
fn f(x: i32) -> i32 {
    return match x {
        v && marked: { builtin::cold_path(); v > 100 } => h(v),
        _ => 3,
    };
}

// A second site, so `h` is not admitted at its one site.
#[inline("never")]
fn other(x: i32) -> i32 {
    return h(x) + 1;
}

export fn run() with Stdout {
    println(`${f(builtin::black_box(500)) + other(builtin::black_box(2))}`);
}

__DATA__
{
  "wir_scope": "cold_path_first_guard.wado/f",
  "wir_expect:O2": ["\"cold_path_first_guard.wado/h\"("],
  "wir_contrast": {"O2": [
    {"builtin::cold_path(); v > 100": "v > 100"},
    {"v && marked: { builtin::cold_path(); v > 100 } => h(v)": "500 && marked: { builtin::cold_path(); x > 100 } => h(x)"}
  ]},
  "stdout": "3359304\n"
}
