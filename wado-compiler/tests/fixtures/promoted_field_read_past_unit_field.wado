// A field read promoted into a value keeps only the field's index, and a `()`
// field takes no slot in the Wasm struct. Extraction named the field by that
// index into the Wasm struct's fields, so every read past a `()` field took
// the field after it: `s.b - s.a` came out as `s.b - s.b`.
struct U {
    u: (),
    a: i32,
    b: i32,
}

// `s.a` is read twice, which promotes it.
#[inline("never")]
fn spread(s: U) -> i32 {
    let len = s.b - s.a;
    if len == 0 {
        return -1;
    }
    return s.a * 3 + len;
}

#[inline("never")]
fn spread_ref(s: &U) -> i32 {
    let len = s.b - s.a;
    if len == 0 {
        return -1;
    }
    return s.a * 3 + len;
}

// A tuple's `()` element is left out the same way.
#[inline("never")]
fn spread_tuple(t: [(), i32, i32]) -> i32 {
    let len = t.2 - t.1;
    if len == 0 {
        return -1;
    }
    return t.1 * 3 + len;
}

export fn run() {
    let x = U { u: (), a: builtin::black_box(1), b: builtin::black_box(2) };
    assert spread(x) == 4;
    assert spread_ref(&x) == 4;
    assert spread_tuple([(), builtin::black_box(1), builtin::black_box(2)]) == 4;
}

__DATA__
{
    "stdout": ""
}
