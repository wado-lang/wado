// A closure whose `$call` lost a parameter it never reads to `dae` is still
// called directly: the call passes its arguments by the closure's declared
// parameters, and the dropped one goes unevaluated.
use { println, Stdout } from "core:cli";

fn table(rows: i32, cols: i32, at: fn(i32, i32) -> i32) -> List<i32> {
    let mut out: List<i32> = [];
    for let r of 0..<rows {
        for let c of 0..<cols {
            let near = |dc: i32| if c + dc < cols { at(r, c + dc) } else { 0 };
            out.push(near(0) + near(1) * 2);
        }
    }
    return out;
}

export fn run() with Stdout {
    let scale = builtin::black_box(3);
    let t = table(builtin::black_box(2), builtin::black_box(3), |_r, c| c * scale);
    println(`${t}`);
}

__DATA__
{
    "stdout": "[6, 15, 6, 6, 15, 6]\n",
    "wir_not_expect:O2": [
        "call_ref"
    ]
}
