use { println, Stdout } from "core:cli";

flags Perms {
    Read,
    Write,
}

struct PermsMap<P, V> {
    keys: List<String>,
    values: List<V>,
}

impl From<Array<[String, V]>> for PermsMap<Perms, V> {
    fn from(entries: Array<[String, V]>) -> PermsMap<Perms, V> {
        let mut out: PermsMap<Perms, V> = PermsMap { keys: [], values: [] };
        for let [key, value] of entries {
            out.keys.push(key);
            out.values.push(value);
        }
        return out;
    }
}

export fn run() with Stdout {
    let m: PermsMap<Perms, i32> = { read: 1, write: 2 };
    assert m.keys.len() == 2;
    assert m.values[0] == 1;
    println("ok");
}

__DATA__
{"stdout": "ok\n"}
