use { println } from "core:cli";

flags Perms {
    Read,
    Write,
}

struct PermsMap<P, V> {
    keys: List<String>,
    values: List<V>,
}

impl KeyValueLiteralBuilder for PermsMap<Perms, V> {
    type Value = V;
    type Output = PermsMap<Perms, V>;

    fn new_literal(capacity: i32) -> PermsMap<Perms, V> {
        return PermsMap { keys: [], values: [] };
    }

    fn insert_literal(&mut self, key: String, value: Self::Value) {
        self.keys.push(key);
        self.values.push(value);
    }

    fn build(&self) -> PermsMap<Perms, V> {
        return *self;
    }
}

export fn run() with Stdout {
    let m: PermsMap<Perms, i32> = { read: 1, write: 2 };
    assert m.keys.len() == 2;
    assert m.values[0] == 1;
    println("ok");
}

__DATA__
{"stdout": "ok\n"}
