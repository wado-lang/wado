//! The same blanket the value-typed case reports, written over a reference.
//! A top-level shape test read `&T` as concrete and let the blanket be
//! selected, mangling its unsubstituted spelling; the reference is peeled
//! before the question is asked, so both spellings answer alike.

struct W {
    tag: i32,
}

impl<T: Display> From<&T> for W {
    fn from(value: &T) -> W {
        return W { tag: 5 };
    }
}

export fn run() {
    let s = "x";
    let w = W::from(&s);
    assert w.tag == 5;
}

__DATA__
{"compile_error": "resolves to a blanket 'From' impl, and selecting its instantiation from the argument is not supported yet"}
