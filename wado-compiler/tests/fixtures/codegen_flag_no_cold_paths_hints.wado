// `-f no-cold-paths` leaves no branch to hint where only a marker would: the
// author's, the one on a `?`, and the one past a global's once-guard. With
// the markers, each of the three hints its branch.

global START: i32 = builtin::black_box(3);

#[inline(never)]
fn guarded(x: i32) -> i32 {
    if x < 0 {
        builtin::cold_path();
        return -1;
    }
    return x + START;
}

#[inline(never)]
fn propagated(o: Option<i32>) -> Option<i32> {
    let v = o?;
    return Option::Some(v + 1);
}

export fn run() {
    let _ = guarded(5);
    let _ = propagated(builtin::black_box(Option::Some(1)));
}

__DATA__
{
    "codegen_flags": ["no-cold-paths"],
    "stdout": "",
    "wir_not_expect:O0": ["@unlikely", "@likely"],
    "wir_not_expect:O2": ["@unlikely", "@likely"]
}
