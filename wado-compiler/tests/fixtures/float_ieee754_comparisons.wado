// The `ieee754_*` methods answer as IEEE 754 compares, where the operators
// read the float order: a NaN operand makes every one false but `ieee754_ne`,
// and `-0.0` equals `0.0` under both. Each is one Wasm instruction.

#[inline(never)]
fn lt(a: f64, b: f64) -> bool {
    return a.ieee754_lt(b);
}

#[inline(never)]
fn ge32(a: f32, b: f32) -> bool {
    return a.ieee754_ge(b);
}

test "f64 against a NaN" {
    let nan = f64::from_bits(builtin::black_box(0x7FF8_0000_0000_0000));
    let one = builtin::black_box(1.0);
    assert !nan.ieee754_eq(nan) && nan.ieee754_ne(nan);
    assert !one.ieee754_eq(nan) && one.ieee754_ne(nan);
    assert !one.ieee754_lt(nan) && !one.ieee754_le(nan);
    assert !one.ieee754_gt(nan) && !one.ieee754_ge(nan);
    assert !nan.ieee754_lt(one) && !nan.ieee754_le(one);
    assert !nan.ieee754_gt(one) && !nan.ieee754_ge(one);
}

test "f64 on the two zeroes and an ordinary pair" {
    let neg = builtin::black_box(-0.0);
    let pos = builtin::black_box(0.0);
    assert neg.ieee754_eq(pos) && !neg.ieee754_ne(pos);
    assert !neg.ieee754_lt(pos) && neg.ieee754_le(pos) && neg.ieee754_ge(pos);

    let one = builtin::black_box(1.0);
    let two = builtin::black_box(2.0);
    assert one.ieee754_lt(two) && one.ieee754_le(two) && one.ieee754_ne(two);
    assert !one.ieee754_gt(two) && !one.ieee754_ge(two) && !one.ieee754_eq(two);
    assert lt(one, two) && !lt(two, one) && !lt(one, f64::NAN);
}

test "f32 answers as f64 does" {
    let nan = f32::from_bits(builtin::black_box(0x7FC0_0000));
    let one: f32 = builtin::black_box(1.0);
    let two: f32 = builtin::black_box(2.0);
    assert !nan.ieee754_eq(nan) && nan.ieee754_ne(nan);
    assert !one.ieee754_lt(nan) && !nan.ieee754_ge(one);
    assert one.ieee754_lt(two) && two.ieee754_gt(one) && one.ieee754_le(one);
    assert builtin::black_box(-0.0_f32).ieee754_eq(0.0);
    assert ge32(two, one) && ge32(one, one) && !ge32(nan, one);
}

test "f16 and bf16 compare widened to f32" {
    let nan = f16::NAN;
    let one: f16 = builtin::black_box(1.0);
    let two: f16 = builtin::black_box(2.0);
    assert !nan.ieee754_eq(nan) && nan.ieee754_ne(nan) && !one.ieee754_le(nan);
    assert one.ieee754_lt(two) && two.ieee754_ge(one) && !one.ieee754_gt(two);
    assert f16::from_bits(0x8000).ieee754_eq(f16::from_bits(0));

    let bnan = bf16::NAN;
    let bone: bf16 = builtin::black_box(1.0);
    let btwo: bf16 = builtin::black_box(2.0);
    assert !bnan.ieee754_eq(bnan) && bnan.ieee754_ne(bnan) && !bnan.ieee754_ge(bone);
    assert bone.ieee754_le(btwo) && btwo.ieee754_gt(bone) && !bone.ieee754_eq(btwo);
    assert bf16::from_bits(0x8000).ieee754_eq(bf16::from_bits(0));
}

test "constant operands fold as IEEE does" {
    assert !f64::NAN.ieee754_eq(f64::NAN);
    assert f64::NAN.ieee754_ne(f64::NAN);
    assert !f32::NAN.ieee754_lt(f32::INFINITY);
    assert (-0.0).ieee754_ge(0.0);
}

__DATA__
{
    "test": {},
    "wir_expect:O1": ["return a < b;", "return a >= b;"]
}
