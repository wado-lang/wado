// Reading an index as `var + const` sums the constants it walks through, and
// two i64 literals near the maximum sum past `i64`. The sum is the optimizer's
// own arithmetic, so it must forgo the match rather than overflow: a debug
// build of the compiler checks it and would abort the compile.
//
// The program itself is unremarkable — Wado's add wraps, so the guard is taken.

use { println, Stdout } from "core:cli";

fn wrapped(i: i64, n: i64) -> bool {
    return (i + 9223372036854775807) + 9223372036854775807 < n;
}

export fn run() with Stdout {
    let xs: List<i64> = [1, 2, 3];
    let i = builtin::black_box(0 as i64);
    if wrapped(i, xs.len() as i64) {
        println(`${xs[0]}`);
    }
}

__DATA__
{
    "stdout": "1\n"
}
