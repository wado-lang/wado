// A call demands the callee's declared effects; an operation demands its
// interface.
use { println, Stdout } from "core:cli";
use { Preopens } from "core:fs";

interface Counter {
    fn next() -> i32;
}

struct Seq {
    n: i32,
}

impl Counter for Seq {
    fn next(&mut self) -> i32 {
        self.n += 1;
        resume self.n
    }
}

fn next_id() -> i32 with Counter {
    return Counter::next();   // demands `Counter`
}

pub fn report() with (Stdout, Preopens) {
    println("report");
}

test {
    let mut seq = Seq { n: 0 };
    with Counter => &mut seq do {
        assert next_id() == 1;
    }
    report();
}
