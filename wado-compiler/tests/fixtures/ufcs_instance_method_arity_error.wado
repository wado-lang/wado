// Written qualified, an instance method's receiver is the call's first
// argument, so the count to check includes it.

struct P {
    v: i32,
}

impl P {
    fn add(&self, n: i32) -> i32 {
        return self.v + n;
    }
}

export fn run() {
    let p = P { v: 41 };
    let _ = P::add(&p);
}

