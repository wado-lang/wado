// Library module that defines functions to be re-exported

pub fn multiply(a: i32, b: i32) -> i32 {
    return a * b;
}

pub fn greet() -> String {
    return "hello from lib";
}

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    println("lib");
}

