// An initializer that may read its own global, through a call a path can skip,
// traps when it does, at every optimization level.

use { println, Stdout } from "core:cli";

global A: i32 = make(builtin::black_box(true));

#[inline(never)]
fn make(read_a: bool) -> i32 {
    if read_a {
        return A + 1;
    }
    return 0;
}

export fn run() with Stdout {
    println(`${A}`);
}

__DATA__
{
    "trapped": true,
    "stdout": "",
    "stderr_contains": ["global `A` was read before its initializer ran"]
}
