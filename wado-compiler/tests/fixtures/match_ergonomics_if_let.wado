// Match ergonomics: using &T in if-let, while-let, and matches patterns
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // if let on &Option<T>
    let opt: Option<i32> = Option::<i32>::Some(42);
    let ro = &opt;
    if let Some(x) = ro {
        println(`got: {x}`);
    }

    // if let None on &Option<T>
    let none_opt: Option<i32> = null;
    let rn = &none_opt;
    if let None = rn {
        println("got none");
    }

    // matches on &Option<T>
    let is_some = ro matches { Some(_) };
    assert is_some == true;

    let is_none = rn matches { Some(_) };
    assert is_none == false;

    println("ok");
}

__DATA__
{"stdout": "got: 42\ngot none\nok\n"}
