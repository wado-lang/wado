// Two variadic impls of one trait cannot be ordered.

trait Tag {
    fn tag(&self) -> String;
}

impl<..T: Inspect> Tag for [..T] { fn tag(&self) -> String { return "inspect"; } }
impl<..T: Eq> Tag for [..T] { fn tag(&self) -> String { return "eq"; } }     // ERROR: overlapping variadic impls

