// A flat turbofish cannot be split between two packs: the boundary is not
// written anywhere, so each pack must be spelled as its own tuple.

fn pair<..A, ..B>(a: [..A], b: [..B]) -> i32 {
    return a.len() + b.len();
}

test "flat turbofish across two packs" {
    assert pair::<i32, bool, String>([1], [true, "x"]) == 3;
}

__DATA__
{"compile_error": "spell each type pack as a tuple"}
