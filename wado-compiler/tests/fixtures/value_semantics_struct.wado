// Value semantics: struct assignment creates a copy

use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

fn run() with Stdout {
    let a = Point { x: 1, y: 2 };
    let mut b = a;  // b is a copy of a (value semantics)
    b.x = 99;  // modifying b does NOT affect a
    println(`a.x={a.x}`);  // prints 1 (a is unchanged)
    println(`b.x={b.x}`);  // prints 99 (b has the modification)
}

__DATA__
{"stdout": "a.x=1\nb.x=99\n"}
