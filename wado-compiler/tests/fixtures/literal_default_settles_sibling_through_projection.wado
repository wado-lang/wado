// Within one call, a literal that takes its default settles, through an
// associated-type bound, the variable another literal of the call waits on:
// `i32`'s `Src::Item` is `i64`, so the second literal is an `i64`. Free,
// method and static calls solve their slots alike, whatever the order of the
// arguments, and an operation over literals waits as a literal does.

trait Src { type Item; }

impl Src for i32 { type Item = i64; }

fn f<A: Src<Item = B>, B>(a: A, b: B) -> B { return b; }

fn g<A: Src<Item = B>, B>(b: B, a: A) -> B { return b; }

trait Many { type Items; }

impl Many for i32 { type Items = List<i64>; }

fn h<A: Many<Items = List<B>>, B>(b: B, a: A) -> B { return b; }

trait Selfish { type Item; type This; }

impl Selfish for i32 { type Item = i64; type This = i32; }

fn r<A: Selfish<Item = B, This = A>, B>(b: B, a: A) -> B { return b; }

struct K {}

impl K {
    fn m<A: Src<Item = B>, B>(&self, a: A, b: B) -> B { return b; }
    fn s<A: Src<Item = B>, B>(a: A, b: B) -> B { return b; }
}

test "a free call" {
    let r = f(1, 5_000_000_000);
    let s: i64 = r;
    assert s == 5_000_000_000;
}

test "a free call, the waiting literal first" {
    let r = g(5_000_000_000 + 0, 1);
    let s: i64 = r;
    assert s == 5_000_000_000;
}

test "a waiting literal inside the projected type" {
    let r = h(5_000_000_000 + 0, 1);
    let s: i64 = r;
    assert s == 5_000_000_000;
}

test "an equality naming its own owner" {
    let v = r(5_000_000_000 + 0, 1);
    let s: i64 = v;
    assert s == 5_000_000_000;
}

test "a method call" {
    let k = K {};
    let r = k.m(1, 5_000_000_000);
    let s: i64 = r;
    assert s == 5_000_000_000;
}

test "a static call" {
    let r = K::s(1, 5_000_000_000);
    let s: i64 = r;
    assert s == 5_000_000_000;
}

test "an operation over literals" {
    let k = K {};
    let r = f(1, 5_000_000_000 + 0);
    let m = k.m(1, -(5_000_000_000));
    let q = K::s(1, 5_000_000_000 * 2);
    let s: [i64, i64, i64] = [r, m, q];
    assert s == [5_000_000_000, -5_000_000_000, 10_000_000_000];
}
