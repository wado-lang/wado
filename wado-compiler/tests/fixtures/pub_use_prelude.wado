// Test importing from a facade prelude (simulates core:prelude split)

use { println, Stdout } from "core:cli";
use { MyPoint, helper_fn } from "./pub_use_prelude_mod.wado";

fn run() with Stdout {
    // Use re-exported struct and its methods
    let p = MyPoint::new(10, 20);
    let sum = p.sum();

    if sum == 30 {
        println("struct ok");
    } else {
        println("struct fail");
    }

    // Use re-exported function
    let doubled = helper_fn(21);
    if doubled == 42 {
        println("fn ok");
    } else {
        println("fn fail");
    }
}

__DATA__
{"stdout": "struct ok\nfn ok\n"}
