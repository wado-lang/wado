// Test closure with block body containing while loop
use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let sum_to_n = |n: i32| {
        let mut sum = 0;
        let mut i = 1;
        while i <= n {
            sum = sum + i;
            i = i + 1;
        }
        return sum;
    };

    println(`{sum_to_n(5)}`);  // 1+2+3+4+5 = 15
    println(`{sum_to_n(10)}`); // 1+...+10 = 55
    println(`{sum_to_n(3)}`);  // 1+2+3 = 6
}

__DATA__
{"stdout": "15\n55\n6\n"}
