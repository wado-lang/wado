// `match` over variant and enum cases: payload bindings, block-bodied arms
// that build a value, a statement-position match, and the `null` arm whose
// `Option` inner type comes from a sibling.

variant Shape {
    Circle(f64),
    Point,
}

variant Align {
    Left,
    Center,
    Right,
}

variant Direction {
    Left,
    Center,
    Right,
}

struct FormatSpec {
    align: Align,
    width: i32,
    fill: char,
}

fn align_name(align: Align) -> String {
    let mut result = "";
    return match align {
        Left => {
            result = "left";
            result;
        },
        Center => {
            result = "center";
            result;
        },
        Right => {
            result = "right";
            result;
        },
    };
}

fn apply_padding(s: String, spec: FormatSpec) -> String {
    let width = spec.width;
    if width <= 0 || s.len() >= width {
        return s;
    }
    let fill = spec.fill;
    let pad_len = width - s.len();
    let mut result = String::with_capacity(width);
    return match spec.align {
        Left => {
            result.push_str(&s);
            for let mut i = 0; i < pad_len; i += 1 {
                result.push(fill);
            }
            result;
        },
        Center => {
            let left_pad = pad_len / 2;
            let right_pad = pad_len - left_pad;
            for let mut i = 0; i < left_pad; i += 1 {
                result.push(fill);
            }
            result.push_str(&s);
            for let mut i = 0; i < right_pad; i += 1 {
                result.push(fill);
            }
            result;
        },
        Right => {
            for let mut i = 0; i < pad_len; i += 1 {
                result.push(fill);
            }
            result.push_str(&s);
            result;
        },
    };
}

fn make_ok() -> Result<String, ()> {
    return Result::Ok("hello");
}

fn make_err() -> Result<String, ()> {
    return Result::Err(());
}

test "a payload binding and a payload-less case" {
    let circle = Shape::Circle(5.0);
    let point = Shape::Point;
    assert `${match circle { Circle(r) => 3.14159 * r * r, Point => 0.0 }}` == "78.53975";
    assert `${match point { Circle(r) => 3.14159 * r * r, Point => 0.0 }}` == "0";
    assert `${match circle { Circle(r) => r * r, Point => 0.0 }}` == "25";
    assert `${match point { Circle(r) => r * r, Point => 0.0 }}` == "0";
}

test "a block-bodied arm yields its tail" {
    assert align_name(Align::Left) == "left";
    assert align_name(Align::Center) == "center";
    assert align_name(Align::Right) == "right";
}

test "arms that build a value in a loop" {
    let left = FormatSpec { align: Align::Left, width: 10, fill: '*' };
    let center = FormatSpec { align: Align::Center, width: 10, fill: '*' };
    let right = FormatSpec { align: Align::Right, width: 10, fill: '*' };
    assert apply_padding("test", left) == "test******";
    assert apply_padding("test", center) == "***test***";
    assert apply_padding("test", right) == "******test";
}

test "a match in statement position, arms with side effects only" {
    let dir = Direction::Center;
    let mut went = "";
    match dir {
        Left => {
            went = "go left";
        },
        Center => {
            went = "go center";
        },
        Right => {
            went = "go right";
        },
    };
    assert went == "go center";
}

// `null` in one arm whose sibling constructs `Option::Some(s: T)`: the match's
// result type unifies to `Option<T>` and the `null` coerces to
// `Option::<T>::None`. Before the fix, WIR translation panicked with "Null with
// unresolved Option inner type".

test "a null arm infers its Option inner from the Some arm's payload" {
    let some_value = match make_ok() {
        Ok(s) => Option::Some(s),
        Err(_) => null,
    };
    assert some_value matches { Some(v) && v == "hello" };

    let none_value = match make_err() {
        Ok(s) => Option::Some(s),
        Err(_) => null,
    };
    assert none_value matches { None };
}

test "a null arm in front infers just the same" {
    // The result-type computation must skip the leading `null` arm, whose own
    // type is `Option<UNKNOWN>`.
    let v = match make_err() {
        Err(_) => null,
        Ok(s) => Option::Some(s),
    };
    assert v matches { None };
}

test "a null in a block-bodied arm" {
    // The patch must walk into the block and reach the trailing literal.
    let v = match make_err() {
        Ok(s) => Option::Some(s),
        Err(_) => {
            null
        },
    };
    assert v matches { None };
}

test "a null in an if branch alongside Option::Some" {
    let cond = true;
    let v = if cond {
        null
    } else {
        Option::Some("x")
    };
    assert v matches { None };
}
