fn classify(n: i32) -> String {
    return match n {
        1 | 2 | 3 => "low",
        4 | 5 | 6 => "mid",
        _ => "high",
    };
}

export fn run() {
    assert classify(1) == "low";
    assert classify(2) == "low";
    assert classify(3) == "low";
    assert classify(4) == "mid";
    assert classify(5) == "mid";
    assert classify(6) == "mid";
    assert classify(7) == "high";
}

