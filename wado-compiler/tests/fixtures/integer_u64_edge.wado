// Test u64 edge cases: max value and unsigned semantics
// This is critical: values above 2^63-1 must use unsigned operations
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Max value: 18446744073709551615 (2^64 - 1)
    let max: u64 = 18446744073709551615 as u64;
    println(`max: {max}`);

    // Min value: 0
    let min: u64 = 0 as u64;
    println(`min: {min}`);

    // Large value above i64 max (9223372036854775807)
    let large: u64 = 10000000000000000000 as u64;
    println(`large: {large}`);

    // Division with large unsigned value
    // 10000000000000000000 / 2 = 5000000000000000000 (correct)
    let div_result = large / 2 as u64;
    println(`10000000000000000000 / 2: {div_result}`);

    // Modulo with large unsigned value
    let mod_result = large % 7 as u64;
    println(`10000000000000000000 % 7: {mod_result}`);
}

__DATA__
{"stdout": "max: 18446744073709551615\nmin: 0\nlarge: 10000000000000000000\n10000000000000000000 / 2: 5000000000000000000\n10000000000000000000 % 7: 3\n"}
