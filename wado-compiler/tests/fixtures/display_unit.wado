use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let u: () = ();
    assert u.to_string() == "()";
    assert `${u}` == "()";
    assert `${u:#}` == "()";
    let mut buf = String::with_capacity(8);
    let mut f = Formatter::new(&mut buf);
    u.fmt(&mut f);
    assert buf == "()";
    // `#` is a `Formatter` field, so the alternate form runs the same `Display`.
    let mut buf2 = String::with_capacity(8);
    let mut f2 = Formatter::new(&mut buf2);
    f2.alternate = true;
    u.fmt(&mut f2);
    assert buf2 == "()";
    println("ok");
}

__DATA__
{"stdout": "ok\n"}
