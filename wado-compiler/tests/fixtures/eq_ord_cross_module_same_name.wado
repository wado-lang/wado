// Regression: an unrelated, same-named type in another module must not
// block this module's own bound-driven Eq/Ord synthesis. `TraitEnv`'s
// impl index is keyed by bare type name, so this module's `Widget` and
// `sub/eq_ord_cross_module_same_name_a.wado`'s `Widget` share one bucket
// — the gate used to match the other module's hand-written `impl Eq for
// Widget` by bare name alone and skip generating this module's own.
use { make_a } from "./sub/eq_ord_cross_module_same_name_a.wado";

struct Widget {
    x: i32,
    y: i32,
}

impl Eq for Widget;

test "same-named cross-module type does not block this module's own Eq" {
    let _pull_in_other_module = make_a();
    let a = Widget { x: 1, y: 2 };
    let b = Widget { x: 1, y: 2 };
    let c = Widget { x: 3, y: 4 };
    assert a == b;
    assert a != c;
}
