// Verify that a call-clean hot field (`self.pos`, never read through the
// `&mut Scanner` reference inside the loop) writes back only at the loop's
// exits — never on the `continue` back-edge. The loop should have a
// `self.pos` struct.set at the guard `break` and the `else` `return`, but
// none per iteration.
use { println, Stdout } from "core:cli";

struct Scanner {
    data: String,
    pos: i32,
}

impl Scanner {
    fn peek(&self) -> i32 {
        if self.pos >= self.data.len() {
            return -1;
        }
        return self.data.get_byte_unchecked(self.pos) as i32;
    }

    fn skip_spaces(&mut self) {
        while self.pos < self.data.len() {
            let b = self.data.get_byte_unchecked(self.pos) as i32;
            if b == ' ' as i32 {
                self.pos += 1;
            } else {
                return;
            }
        }
    }
}

export fn run() with Stdout {
    let mut s = Scanner { data: "  a  b  c  ", pos: 0 };
    let mut count = 0;
    while s.pos < s.data.len() {
        s.skip_spaces();
        if s.peek() >= 0 {
            count += 1;
            s.pos += 1;
        }
    }
    println(`{count}`);
}

__DATA__
{
    "stdout": "3\n",
    "wir_expect:O2": [
        "b = builtin::array_get_u8(_licm_repr_",
        "self.pos = __hfs_pos_8;\n                break"
    ],
    "wir_not_expect:O2": [
        "self.pos = __hfs_pos_8;\n            continue",
        "String::get_byte_unchecked\""
    ]
}
