// Test: importing variant type used in struct from another module
use {Align, Options, format_with_opts} from "./variant_import_struct_module.wado";
use {println, Stdout} from "core:cli";

fn run() with Stdout {
    let mut opts = Options::default();
    opts.width = 10;

    // Right align (default)
    let s1 = format_with_opts("hi", opts);
    println(`[{s1}]`);

    // Left align
    opts.align = Align::Left;
    let s2 = format_with_opts("hi", opts);
    println(`[{s2}]`);

    // Center align
    opts.align = Align::Center;
    let s3 = format_with_opts("hi", opts);
    println(`[{s3}]`);
}

__DATA__
{"stdout": "[        hi]\n[hi        ]\n[    hi    ]\n"}
