// Regression: a short-circuit assert inside a closure. The closure body is
// lifted into its own function, and a capture local that is assigned but never
// declared has no declaration to lift.

fn wrapper(f: fn()) {
    f();
}

export fn run() {
    let list: List<i32> = [1, 2, 3];
    let i = 0;
    wrapper(|| {
        assert i < list.len() && list[i] == 1;
    });
}

__DATA__
{
    "stdout": ""
}
