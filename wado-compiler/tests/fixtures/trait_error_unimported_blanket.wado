// A blanket is scoped like any other candidate. Neither `Tagged` nor `Marked`
// is imported here, so `42.tag()` does not resolve: both blankets apply, and
// the message names the two traits an import would choose between. Without
// the gate, collection order would pick one, and swapping the two `use` lines
// would change what this program prints (WEP 2026-09-01, "Scope").

use { tagged_version } from "./sub/trait_scope_blanket_tagged.wado";
use { marked_version } from "./sub/trait_scope_blanket_marked.wado";

export fn run() {
    let _ = tagged_version() + marked_version();
    assert 42.tag() == "tagged:42";
}

