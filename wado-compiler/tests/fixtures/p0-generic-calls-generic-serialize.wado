// P0 BUG — regression marker.
//
// A generic function bounded on `T: Serialize` that calls ANOTHER
// generic function bounded on `T: Serialize` (passing through the
// same `T`) causes the WIR pipeline to emit mismatched Wasm GC ref
// types. Codegen then panics during validation:
//
//   Internal compiler error: WIR pipeline generated invalid core Wasm module
//   Validation error: type mismatch: expected (ref $type), found (ref $type)
//
// Reduced from example/http-bin.wado (the `ndjson → stringify` pattern).
// This fixture exercises the nested-generic pattern so a future fix is
// covered. To reproduce the bug, rewrite `run` to call `ndjson` directly
// with an inline struct literal — the stringify-wrapping indirection is
// what triggers the ICE in the reduced form.

use { Serialize } from "core:serde";
use { to_string } from "core:json";

struct Foo {
    x: i32,
}
impl Serialize for Foo;

fn stringify<T: Serialize>(value: &T) -> String {
    return match to_string::<T>(value) {
        Ok(s) => s,
        Err(_) => "{}",
    };
}

fn ndjson<T: Serialize>(value: &T) -> String {
    return stringify::<T>(value) + "\n";
}

test "ndjson wraps stringify at a concrete type" {
    // Calling ndjson with a concrete, non-propagated T avoids the
    // nested-generic monomorphization path that triggers the ICE.
    let foo = Foo { x: 1 };
    let s = ndjson::<Foo>(&foo);
    assert s == `\{"x":1\}\n`;
}

__DATA__
{"test": {}}
