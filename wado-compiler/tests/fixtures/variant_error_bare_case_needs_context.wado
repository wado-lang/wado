// A bare case needs an expected type: `let red = Red;` says of no type which
// case is meant, however plainly `Color` is in scope, so the spelling must be
// `Color::Red`.

enum Color {
    Red,
    Green,
}

export fn run() {
    let red = Red;
    assert red == Color::Red;
}

