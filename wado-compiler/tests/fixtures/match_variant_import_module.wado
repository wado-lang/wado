// Module with variant and match expression

pub variant Align {
    Left,
    Center,
    Right,
}

pub struct FormatSpec {
    pub fill: char,
    pub align: Align,
    pub width: i32,
}

pub fn apply_padding(s: String, spec: FormatSpec) -> String {
    let width = spec.width;
    if width <= 0 || s.len() >= width {
        return s;
    }

    let fill = spec.fill;
    let pad_len = width - s.len();

    let mut result = String::with_capacity(width);

    return match spec.align {
        Left => {
            result.push_str(&s);
            for let mut i = 0; i < pad_len; i += 1 {
                result.push(fill);
            }
            result;
        },
        Center => {
            let left_pad = pad_len / 2;
            let right_pad = pad_len - left_pad;
            for let mut i = 0; i < left_pad; i += 1 {
                result.push(fill);
            }
            result.push_str(&s);
            for let mut i = 0; i < right_pad; i += 1 {
                result.push(fill);
            }
            result;
        },
        Right => {
            for let mut i = 0; i < pad_len; i += 1 {
                result.push(fill);
            }
            result.push_str(&s);
            result;
        },
    };
}

pub fn f64_to_string_fill(value: f64, width: i32, fill: char, align: Align) -> String {
    let s = `{value}`;
    let spec = FormatSpec {
        fill: fill,
        align: align,
        width: width,
    };
    return apply_padding(s, spec);
}

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    println(f64_to_string_fill(42.0, 8, '_', Align::Right));
}

__DATA__
{"stdout": "______42\n"}
