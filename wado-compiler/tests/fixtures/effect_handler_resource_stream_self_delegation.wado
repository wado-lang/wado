// Self-delegation across nested handlers for the *generic* resource
// `StreamWritable<u8>`, mirroring the non-generic effect-level
// self-delegation in `effect_handler_self_delegation.wado`.
//
// The inner handler's body calls back into `StreamWritable::<u8>::write_raw_all(this, …)`,
// which the per-monomorphisation dispatch wrapper restores the outer dispatch
// chain for *before* invoking the closure. The recursive call therefore lands
// on the outer `BaseStream` handler, not back in `LoggingStream`.
//
// Verifies:
// - per-monomorphisation `outer` save/restore is wired for generic
//   resources (each `$effect_dispatch__<module>/StreamWritable<u8>__<op>`
//   wrapper restores its own `$effect_<module>/StreamWritable<u8>` global
//   before calling the closure)
// - the bundled `with &mut h do` form composes across nested handler
//   pairs without leaking inner-handler state to outer-handler calls

use { println, Stdout } from "core:cli";

struct BaseStream {
    buf: List<u8>,
}

impl Stream<u8> for BaseStream {
    // A real pair, which the outer dispatch chain makes, since an integer
    // converts to no resource.
    fn new(&mut self) -> [Stream<u8>, StreamWritable<u8>] {
        resume Stream::<u8>::new()
    }
    fn drop(&mut self, this: &Stream<u8>) {
        let _ = this;
        resume ()
    }
    ..trap
}

impl StreamWritable<u8> for BaseStream {
    fn write_raw_all(&mut self, this: &StreamWritable<u8>, data: Slice<u8>) -> CopyResult {
        let _ = this;
        for let b of data {
            self.buf.push(b);
        }
        resume CopyResult::Completed
    }
    fn drop(&mut self, this: &StreamWritable<u8>) {
        let _ = this;
        resume ()
    }
    ..trap
}

// Counts every write that flows through it and forwards to the outer handler.
// The `write_raw_all` call inside `write_raw_all` is self-delegation: the
// dispatch wrapper restores the outer chain (BaseStream) before invoking this
// closure, so the recursive call sees BaseStream, not LoggingStream.
struct LoggingStream {
    writes: i32,
}

impl StreamWritable<u8> for LoggingStream {
    fn write_raw_all(&mut self, this: &StreamWritable<u8>, data: Slice<u8>) -> CopyResult {
        self.writes += 1;
        let inner = this.write_raw_all(data); // -> BaseStream via outer handler
        resume inner
    }
    ..trap
}

export fn run() with Stdout {
    let mut base = BaseStream { buf: [] };
    let mut logger = LoggingStream { writes: 0 };
    with &mut base do {
        let [rx, tx] = Stream::<u8>::new();
        with &mut logger do {
            let payload: List<u8> = [104 as u8, 105 as u8]; // "hi"
            assert tx.write_raw_all(payload.as_slice()) == CopyResult::Completed;
        }
        tx.drop();
        rx.drop();
    }
    println(`writes=${logger.writes} buf_len=${base.buf.len()}`);
}

__DATA__
{"stdout_contains": ["writes=1 buf_len=2"]}
