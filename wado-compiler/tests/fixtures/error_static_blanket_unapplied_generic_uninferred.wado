// `Pair::made()` leaves `Pair`'s arguments to infer, and nothing in the call
// settles them. One impl written for one instance does not: a generic
// function does not infer its parameters from the impls written either.
trait Holds with () {}

trait Make with () {
    fn made() -> i32;
}

struct Pair<A, B> {
    a: A,
    b: B,
}

impl Holds for Pair<i32, i32> {}

impl<X: Holds> Make for X {
    fn made() -> i32 {
        return 7;
    }
}

export fn run() {
    let _ = Pair::made();
}

