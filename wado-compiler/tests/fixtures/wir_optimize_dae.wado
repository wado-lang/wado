// Test that Dead Argument Elimination removes unused function parameters.
//
// The function `add_with_label` has an unused `label` parameter.
// DAE should remove it from the function signature and call sites.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn add_with_label(a: i32, label: String, b: i32) -> i32 {
    return a + b;
}

export fn run() with Stdout {
    let result = add_with_label(builtin::black_box(10), "unused", builtin::black_box(20));
    println(`${result}`);
}

__DATA__
{
    "stdout": "30\n",
    "wir_pass": {"O2": ["nir/dae"]},
    "wir_expect:O2": ["add_with_label$dae[label]\"(a, b)"]
}
