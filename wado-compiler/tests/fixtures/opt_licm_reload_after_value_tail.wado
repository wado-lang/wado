// A call that writes the object behind a hoisted field sits inside an arm's
// value rather than being it, so a reload appended after the arm would take
// the place of the value the arm yields.

use { println, Stdout } from "core:cli";

struct P {
    x: i32,
    y: i32,
}

variant Step {
    Skip,
    Took(i32),
}

global mut G: P = P { x: 1, y: 0 };

#[inline(never)]
fn bump_global() -> i32 {
    G.x += 1;
    return G.x;
}

#[inline(never)]
fn arith_tail(r: &P) -> i32 {
    let mut s = 0;
    for let mut i = 0; i < 3; i += 1 {
        s += r.x;
        let v = if i == 1 { 0 } else { bump_global() + 10 };
        s += v;
    }
    return s;
}

#[inline(never)]
fn variant_tail(r: &P) -> i32 {
    let mut s = 0;
    for let mut i = 0; i < 3; i += 1 {
        s += r.x;
        let step = if i == 1 { Step::Skip } else { Step::Took(bump_global()) };
        if let Took(n) = step {
            s += n * 100;
        }
    }
    return s;
}

export fn run() with Stdout {
    println(`${arith_tail(&G)}`);
    G.x = 1;
    println(`${variant_tail(&G)}`);
}

__DATA__
{
    "stdout": "30\n505\n"
}
