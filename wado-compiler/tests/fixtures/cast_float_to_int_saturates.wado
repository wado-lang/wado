// A float-to-int `as` truncates toward zero and saturates, as Rust's does: NaN
// is 0, and a value past the target's range is the target's MIN or MAX,
// whatever its width. A cast the compiler folds agrees with one it runs.
use { println, Stdout } from "core:cli";

fn show(f: f64) with Stdout {
    println(`${f as i8} ${f as u8} ${f as i16} ${f as u16} ${f as i32} ${f as u32} ${f as i64} ${f as u64} ${f as i128} ${f as u128}`);
}

export fn run() with Stdout {
    let values: List<f64> = [
        300.7,
        -300.7,
        -7.9,
        -0.5,
        1.0e30,
        -1.0e30,
        1.0e40,
        -1.0e40,
        f64::NAN,
        f64::INFINITY,
        f64::NEG_INFINITY,
    ];
    for let v of values {
        show(builtin::black_box(v));
    }
    println(`${300.7 as i8} ${(-1.0) as u8} ${f64::NAN as i32} ${1.0e30 as i64} ${(-1.0e30) as u64}`);
    let g = builtin::black_box(3.0e9 as f32);
    println(`${g as i32} ${g as u32} ${g as i128} ${g as u128}`);
}

