// Test: two library modules defining structs with the same name
// This should work correctly - each module's Pair type is distinct.

use { println, Stdout } from "core:cli";
use { make_pair_a, pair_a_value } from "./sub/wasm_name_conflict_struct_mod_a.wado";
use { make_pair_b, pair_b_sum } from "./sub/wasm_name_conflict_struct_mod_b.wado";

export fn run() with Stdout {
    let a = make_pair_a();
    println(`a: {pair_a_value(a)}`);
    let b = make_pair_b();
    println(`b: {pair_b_sum(b)}`);
}

__DATA__
{"stdout": "a: 42\nb: 30\n"}
