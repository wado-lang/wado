// A user `struct T` must not shadow the `..T` pack in serde's
// `impl<..T> Serialize for [..T]`: impl type-param registration is scoped to
// the impl's own module.
use { Serialize, Deserialize, DeserializeError } from "core:serde";
use { from_string, to_string } from "core:json";

struct T {
    v: i32,
}

impl Deserialize for T;

test "struct named T deserializes" {
    let r = from_string::<T>(`\{"v":5\}`);
    assert r matches { Ok(x) && x.v == 5 };
}

test "tuple serde still works alongside struct T" {
    // Exercises serde's `impl<..T> Serialize for [..T]`, whose `..T` pack
    // param shares a name with the user struct `T`.
    let tup = [1, "hi", true];
    assert to_string(&tup) matches { Ok(s) && s == `[1,"hi",true]` };
    let r: Result<List<i32>, DeserializeError> = from_string("[1,2,3]");
    assert r matches { Ok(xs) && xs.len() == 3 };
}

__DATA__
{"test": {}}
