// Two modules define trait Describe with different method signatures.
// Each module's Describe trait and Data struct must remain distinct.

use { Data as DataA, get_description } from "./sub/cross_module_same_name_trait_a.wado";
use { Data as DataB, get_value } from "./sub/cross_module_same_name_trait_b.wado";

test "cross-module same-name traits" {
    let a = DataA { x: 42 };
    assert get_description(&a) == "x=42";

    let b = DataB { value: 99 };
    assert get_value(&b) == 99;
}

__DATA__
{"test": {}}
