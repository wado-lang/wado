// A reference to the same field being moved, still read after the move, must keep
// the deep copy. `p` is the function's own, so the reference is what keeps it:
// a parameter only read is one its caller may share, which copies anyway.

use { println, Stdout } from "core:cli";

struct P { a: List<i32> }
struct R { x: List<i32> }

fn split_same(n: i32) -> i32 {
    let p = make(n);
    let r = &p.a;
    let out = R { x: p.a };
    return r.len() + out.x.len();
}

fn make(n: i32) -> P {
    let mut a: List<i32> = [];
    let mut i = 0;
    loop { if i >= n { break; } a.push(i); i = i + 1; }
    return P { a };
}

export fn run() with Stdout {
    println(`${split_same(3)}`);
}

__DATA__
{
    "stdout": "6\n",
    "wir_scope": "/split_same",
    "wir_expect:O0": ["$value_copy$core:prelude/list.wado/List<i32>"],
    "wir_contrast": {"O0": [
        {"    let r = &p.a;\n": "", "r.len() + ": ""}
    ]}
}
