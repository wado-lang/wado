// The `&mut || ...` syntax is retired. Closures now auto-detect mutating
// captures and tag themselves `fn mut`; users write `let mut f = || ...`
// instead. See wep-2026-01-16-closure-implementation.md ("No `move`
// Keyword").

test "old &mut || syntax is rejected" {
    let mut count = 0;
    // The closure literal already has type `fn mut() -> ()` thanks to
    // auto-capture; applying `&mut` to it makes no sense at the type
    // level (a closure value is not a place that supports `&mut`).
    let inc = &mut || {
        count += 1;
    };
    inc();
}

__DATA__
{"test": {}, "compile_error": "retired"}
