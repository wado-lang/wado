// Test: entry module and library both define struct Widget with method value().
// The entry module's Widget::value has no module prefix in WIR (no module-qualification
// needed since it's from the entry module). The library's Widget::value is module-qualified.

use { println, Stdout } from "core:cli";
use { Widget as LibWidget, make_lib_widget } from "./sub/wasm_name_conflict_entry_struct_mod.wado";

pub struct Widget {
    pub score: i32,
}

impl Widget {
    fn value(&self) -> i32 {
        return self.score * 3;
    }
}

export fn run() with Stdout {
    let lib_w = make_lib_widget(10);
    println(`lib: {lib_w.value()}`);
    let entry_w = Widget { score: 10 };
    println(`entry: {entry_w.value()}`);
}

__DATA__
{"stdout": "lib: 20\nentry: 30\n"}
