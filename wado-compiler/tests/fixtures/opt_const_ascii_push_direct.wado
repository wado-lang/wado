// Regression test: the `const_ascii_push` NIR rule retargets a *direct*
// `buf.push(<const char < 0x80>)` (not one synthesized by the short-`push_str`
// expansion) to `push_ascii_byte`, which inlines to
// `internal_reserve_uninit(1)` + `array_set_u8`. A non-ASCII constant char
// must be left on the general `push`/`encode_char` path — retargeting it would
// write a raw code point where a UTF-8 sequence belongs.
//
// The two ASCII pushes are adjacent, so the append fusion gives them one
// shared reservation; the non-ASCII `push` ends the run. The buffer starts
// empty and nothing else writes it, so the ASCII bytes land at the constant
// indices 0 and 1, and the length is stored once, after the last push.
//
// This guards the direct-push path specifically: `opt_string_push_short_literal`
// only exercises pushes derived from `push_str`, so a regression in how char
// literals reach the rule (e.g. no longer born as `Operand::Value`) would slip
// past it but is caught here.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut buf = String::with_capacity(8);
    buf.push('a'); // 97  — ASCII, specialized
    buf.push('Z'); // 90  — ASCII, specialized
    buf.push('€'); // 8364 — non-ASCII, stays on encode_char
    println(buf);
}

__DATA__
{
    "stdout": "aZ€\n",
    "wir_pass": {"O2": ["nir/peephole", "wir/fuse_remaining_local_tees"]},
    "wir_expect:O2": [
        "array_set_u8(local.tee $load_1(local.tee buf(struct.new \"core:prelude/string.wado//String\" { repr: builtin::array_new<u8>(8), used: 0 }).repr), 0, 97)",
        "array_set_u8($load_1, 1, 90)",
        "array_set_u8($load_1, 2, 226); builtin::array_set_u8($load_1, 3, 130); builtin::array_set_u8($load_1, 4, 172);"
    ],
    "wir_not_expect:O2": [
        ", 8364)",
        "String::push\"(buf, 97)",
        "String::push\"(buf, 90)"
    ]
}
