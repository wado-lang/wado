//! Two value blankets of two traits both cover `S` and both declare `make`.
//! The blanket path ran as a fallback after the resolution answered nothing,
//! so it took the first applicable blanket and the call compiled — where the
//! same shape written as concrete impls is reported. A blanket is a candidate
//! now, and the ambiguity rule reads its trait like any other's.

trait Marker {
    fn kind() -> i32;
}

trait Alpha {
    fn make() -> i32;
}

trait Beta {
    fn make() -> i32;
}

impl<T: Marker> Alpha for T {
    fn make() -> i32 {
        return 1;
    }
}

impl<T: Marker> Beta for T {
    fn make() -> i32 {
        return 2;
    }
}

struct S {}

impl Marker for S {
    fn kind() -> i32 {
        return 0;
    }
}

export fn run() {
    assert S::make() == 1;
}

__DATA__
{"compile_error": "ambiguous method 'make': declared by 'Alpha' and 'Beta'"}
