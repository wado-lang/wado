*.wat
*.wasm

# Wasm-import fixture inputs live alongside the .wado entry points and
# must be tracked. Without these `!` overrides the patterns above (which
# exist to silence compiled test outputs) would mask them.
!sub/wasm_import_*.wat
!sub/wasm_import_*.wasm

# CM-linking dependency component fixture (imported by cm_link_*.wado).
!sub/cm-catalog.wasm

# Guest-effect reconstruction dependency component (imported by
# guest_effect_*.wado / reconstruction tests).
!sub/hlc.wasm

# Multi-guest-import dependency (provider multi-interface rejection test).
!sub/hl2.wasm
