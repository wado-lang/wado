// A bound's trait arguments meet the bounds the trait puts on its parameters:
// `S: Tr<U>` names `Tr` at `U`, which `Tr<T: Q>` needs to implement `Q`.

trait Q with () {
    fn q() -> i32;
}

trait P with () {}

trait Tr<T: Q> with () {
    fn run(&self) -> i32;
}

fn g<U: P, S: Tr<U>>(s: S) -> i32 {
    return s.run();
}

