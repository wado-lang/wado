// Both names are the prelude's, and a module's own declaration outranks it.

fn panic(msg: String) -> i32 {
    return 7;
}

fn unreachable() -> i32 {
    return 9;
}

test "a module's own panic outranks the prelude's" {
    assert panic("x") == 7;
}

test "a module's own unreachable outranks the prelude's" {
    assert unreachable() == 9;
}
