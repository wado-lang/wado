// A branch whose variant leaves its type parameter open (`Option::None`) takes
// it from a sibling branch that settles it, whichever construct holds them:
// `if`, `if let`, `match`, a labeled block's breaks, or a closure's returns.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let c = builtin::black_box(true);
    let o: Option<i32> = builtin::black_box(Option::Some(7));
    let a = if c { Option::None } else { Option::Some(1) };
    let b = if c { Option::Some(2) } else { Option::None };
    let d = if let Some(v) = o { Option::Some(v + 1) } else { Option::None };
    let e = if let Some(_) = o { Option::None } else { Option::Some("s") };
    let f = match c {
        true => Option::None,
        false => Option::Some(3),
    };
    let g = found: {
        if c {
            break found: Option::None;
        }
        Option::Some(4)
    };
    let h = found: {
        if c {
            break found: Option::Some("h");
        }
        Option::None
    };
    let k = || {
        if c {
            return Option::None;
        }
        return Option::Some(5);
    };
    println(`${a:?} ${b:?} ${d:?} ${e:?} ${f:?}`);
    println(`${g:?} ${h:?} ${k():?}`);
}

__DATA__
{
    "stdout": "Option::None Option::Some(2) Option::Some(8) Option::None Option::None\nOption::None Option::Some(\"h\") Option::None\n"
}
