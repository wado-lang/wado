// A NaN element keeps its payload: an f64 cannot carry an f32's, so the
// optimizer must not fold an element it cannot represent.

export fn run() {
    let signalling = List::<f32>::from_le_bytes(b"\x01\x00\x80\x7f");
    assert signalling[0].to_bits() == 0x7F800001;
    let wide = List::<f64>::from_le_bytes(b"\x01\x00\x00\x00\x00\x00\xf0\x7f");
    assert wide[0].to_bits() == 0x7FF0000000000001;
}

__DATA__
{}
