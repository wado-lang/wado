// Rebinding `mut` reference parameters in a rotation leaves each pointing at
// another, a loop of references reaching no storage. Resolving one to its
// referent must stop there rather than walk the loop forever.

struct Rows { items: List<i32> }
#[inline("never")]
fn rotate(mut x: &Rows, mut y: &Rows, mut z: &Rows) -> i32 {
    x = y;
    y = z;
    z = x;
    let kept = x.items;
    return kept.len() + y.items.len() + z.items.len();
}
export fn run() {
    let a = Rows { items: [1] };
    let b = Rows { items: [1, 2] };
    let c = Rows { items: [1, 2, 3] };
    assert rotate(&a, &b, &c) == 7;
}

__DATA__
{
    "stdout": ""
}
