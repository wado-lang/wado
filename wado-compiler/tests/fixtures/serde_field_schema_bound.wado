// Every struct the derivation deserializes implements `FieldSchema`, so a
// bound on it holds of one directly and through a generic impl over it, with
// no `Deserialize` asked of the struct anywhere else.
use { FieldSchema } from "core:serde";

struct Point {
    x: i32,
    #[wire(name = "why")]
    y: i32,
}

struct Shifted<S> {
}

impl<S: FieldSchema> FieldSchema for Shifted<S> {
    fn lookup(key: ByteSlice) -> Option<i32> {
        return S::lookup(key).map(|i| i + 10);
    }

    fn positional_at(rank: i32) -> Option<i32> {
        return S::positional_at(rank);
    }
}

fn index_of<S: FieldSchema>(key: String) -> Option<i32> {
    return S::lookup(key.as_bytes());
}

test "a derived struct meets a FieldSchema bound" {
    assert index_of::<Point>("x") == Option::Some(0);
    assert index_of::<Point>("why") == Option::Some(1);
    assert index_of::<Point>("y") matches { None };
}

test "a generic impl over a derived struct meets the bound" {
    assert index_of::<Shifted<Point>>("why") == Option::Some(11);
}

__DATA__
{"test": {}}
