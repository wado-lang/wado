#![TODO]
// TODO: a user struct named `T` breaks serde's variadic tuple impls.
//
// Declaring `struct T` makes core:serde itself fail to compile with
// `unknown type '..T'` at its `impl<..T: Serialize> Serialize for [..T]`
// (and the Deserialize twin). Two independent defects compose:
//
//   1. Impl-block type-param registration (elaborator.rs) consults the
//      *global* known-type-name union (`is_known_type_name`), which a user
//      `struct T` pollutes across modules — serde's `<..T>` is then treated
//      as a concrete type and the pack param is never registered. The
//      module-scoped `is_known_type_name_in` already exists for exactly this
//      class of bug (see its `impl Result<T, E>` doc example) and fixes this
//      site, but…
//
//   2. …the impl's pack param still does not propagate into every context
//      that resolves the impl's method signatures: with (1) fixed, the
//      `[..T]` in `fn deserialize<D>(…) -> Result<[..T], _>` is resolved
//      under a `trait_ctx.type_params` containing only `["D"]` (or nothing),
//      so `..T` stays unresolved. The pack must be in scope for all method
//      signature/body resolution paths, not just the impl header.
//
// Proper fix: switch impl-param registration to module-scoped visibility
// (1) and thread impl pack params through the method-resolution scopes (2).
// The same global-pollution hazard also applies to single-letter non-pack
// impl params, but those are shadowed correctly today; only packs fail.
use { Serialize, Deserialize, DeserializeError } from "core:serde";
use { from_string, to_string } from "core:json";

struct T {
    v: i32,
}

impl Deserialize for T;

test "struct named T deserializes" {
    let r = from_string::<T>(`\{"v":5\}`);
    assert r matches { Ok(x) && x.v == 5 };
}

test "tuple serde still works alongside struct T" {
    // Exercises serde's `impl<..T> Serialize for [..T]`, whose `..T` pack
    // param shares a name with the user struct `T`.
    let tup = [1, "hi", true];
    assert to_string(&tup) matches { Ok(s) && s == `[1,"hi",true]` };
    let r: Result<List<i32>, DeserializeError> = from_string("[1,2,3]");
    assert r matches { Ok(xs) && xs.len() == 3 };
}

__DATA__
{"test": {}}
