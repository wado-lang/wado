// Test: a declared resource implies what its operations hand out. Stream's
// closure (from `Stream::new -> [Stream, StreamWritable]`) grants
// StreamWritable, enough to call a helper declared `with StreamWritable`.

use { println, Stdout } from "core:cli";

pub fn needs_sw(tx: StreamWritable<u8>) with StreamWritable {
    tx.drop();
}

pub fn f(s: Stream<u8>, tx: StreamWritable<u8>) with Stream {
    needs_sw(tx);
    s.drop();
}

export fn run() with Stdout {
    let [rx, tx] = Stream::<u8>::new();
    f(rx, tx);
    println("ok");
}

__DATA__
{"stdout_contains": ["ok"]}
