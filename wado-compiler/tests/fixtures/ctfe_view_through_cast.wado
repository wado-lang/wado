// Test: a cast inside a borrow chain names the storage it converts.
//
// `borrow_root` walks a cast the way it walks a field access, so `&(G.n as i32)`
// roots at `G`. A value-producing cast interposes a fresh temporary, which only
// removes write paths — the borrow snapshots the converted value, and the later
// write to `G.n` cannot reach it. The `&G.items` view beside it takes the other
// answer: it names the global itself, so it grows with it.

use { println, Stdout } from "core:cli";

type Count = i32;

struct Buf { items: List<i32>, n: Count }

global mut G: Buf = Buf { items: [1, 2, 3], n: 3 };

export fn run() with Stdout {
    let r = &(G.n as i32);
    let before = *r;
    G.n = 7;
    let after = *r;
    let items = &G.items;
    let len_before = items.len();
    G.items.push(4);
    println(`${before} ${after} ${len_before} ${items.len()} ${G.n as i32}`);
}

__DATA__
{
    "stdout": "3 3 3 4 7\n"
}
