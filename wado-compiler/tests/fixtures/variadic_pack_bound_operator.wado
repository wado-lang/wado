// An operator on a pack member resolves through the pack's bound, the way a
// method on one already does and the way the same bound on a scalar type
// parameter already does.

type Meters = i32;

fn sum_pack<..T: Add<i32, Output = i32>>(items: [..T]) -> i32 {
    let mut total = 0;
    for let v of items {
        total = v + total;
    }
    return total;
}

test "an operator reaches a pack member's bound" {
    assert sum_pack([1, 2, 3]) == 6;
}

fn xor_pack<..T: BitXor<i32, Output = i32>>(items: [..T]) -> i32 {
    let mut acc = 0;
    for let v of items {
        acc = v ^ acc;
    }
    return acc;
}

test "a bound naming a right-hand type other than Self" {
    assert xor_pack([1, 2, 4]) == 7;
}

fn shift_pack<..T: Shl<Output = i32>>(items: [..T]) -> i32 {
    let by: u32 = 1;
    let mut acc = 0;
    for let v of items {
        acc = acc + (v << by);
    }
    return acc;
}

test "a shift reaches it too, where the right-hand side is a count" {
    assert shift_pack([1, 2, 4]) == 14;
}

fn negate_pack<..T: Neg<Output = i32>>(items: [..T]) -> i32 {
    let mut acc = 0;
    for let v of items {
        acc = acc + -v;
    }
    return acc;
}

test "and a unary operator" {
    assert negate_pack([1, 2, 4]) == -7;
}

// A newtype inherits its base's impl with itself put in for the base, so a
// bound naming the newtype is what the inherited impl answers. The solver
// peeled to the base without carrying the substitution, and disagreed with the
// rest of the compiler about `Meters: Add`.

fn add_newtype<T: Add<Meters, Output = Meters>>(v: T, acc: Meters) -> Meters {
    return v + acc;
}

test "a bound written at the newtype, answered by the base's impl" {
    let a: Meters = 1;
    let b: Meters = 2;
    assert add_newtype(a, b) as i32 == 3;
}

fn add_base<T: Add<i32, Output = i32>>(v: T, acc: i32) -> i32 {
    return v + acc;
}

test "the same bound written at the base still holds of the newtype" {
    let a: Meters = 1;
    assert add_base(a, 2) == 3;
}

fn sum_newtype_pack<..T: Add<Meters, Output = Meters>>(items: [..T]) -> Meters {
    let mut total: Meters = 0;
    for let v of items {
        total = v + total;
    }
    return total;
}

test "both at once: a pack of newtypes under a bound naming the newtype" {
    let a: Meters = 1;
    let b: Meters = 2;
    assert sum_newtype_pack([a, b]) as i32 == 3;
}

__DATA__
{"test": {}}
