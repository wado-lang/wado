// Regression: format-trait synthesis must be on-demand (WEP: Trait
// Derivation Policy) — a declared type nothing ever formats must get no
// synthesized Inspect / InspectAlt / Display / DisplayAlt impl.
//
// Checked at -O0 so DCE cannot mask a regression to unconditional
// synthesis.
struct Formatted {
    x: i32,
}

struct NeverFormatted {
    y: i32,
}

export fn run() {
    let a = Formatted { x: 1 };
    assert `{a:?}` == "Formatted { x: 1 }";
    assert `{a}` == "Formatted { x: 1 }";

    let b = NeverFormatted { y: 2 };
    assert b.y == 2;
}

__DATA__
{
    "wir_expect:O0": ["Formatted^Inspect::inspect", "Formatted^Display::fmt"],
    "wir_not_expect:O0": [
        "NeverFormatted^Inspect::inspect",
        "NeverFormatted^InspectAlt::inspect_alt",
        "NeverFormatted^Display::fmt",
        "NeverFormatted^DisplayAlt::fmt_alt"
    ]
}
