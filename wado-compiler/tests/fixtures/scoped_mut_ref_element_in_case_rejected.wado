// A case holds its payload past the expression that builds it, so a returned
// case cannot hold a scoped `&mut`.

fn held(xs: &mut List<i32>) -> Option<&mut i32> {
    return Some(&mut xs[0]);
}

test "unreachable" {
    let mut xs: List<i32> = [1];
    let _ = held(&mut xs);
}

__DATA__
{
    "test": {},
    "compile_error": "a returned value cannot hold a `&mut i32`"
}
