// A parameter is substituted against the instance's type arguments, so its
// number is where the impl target names it. `T` here is the target's second
// argument and the block's first, so the two orders disagree.

trait Kind with () {
    type Out;

    fn make(&self) -> Self::Out;
}

struct Holder<A, B> {
    a: A,
    b: B,
}

impl<T> Kind for Holder<Option<i32>, T> {
    type Out = T;

    fn make(&self) -> T {
        return self.b;
    }
}

fn kind_of<T: Kind>(t: &T) -> T::Out {
    return t.make();
}

test "a binder is numbered where the target names it" {
    let h = Holder { a: Option::<i32>::Some(1), b: true };
    assert kind_of(&h) == true;
}

__DATA__
{"test": {}}
