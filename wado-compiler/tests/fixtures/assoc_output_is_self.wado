// `type Output = Self;` names the impl's own target. It resolved with no `Self`
// bound and registered as `unknown`, so the bound `T: Add<Output = T>` that
// `Sum`'s blanket writes could not hold.
use { println } from "core:cli";

struct Cm {
    v: i32,
}

impl Add for Cm {
    type Output = Self;

    fn add(&self, rhs: &Cm) -> Cm {
        return Cm { v: self.v + rhs.v };
    }
}

export fn run() with Stdout {
    let xs: List<Cm> = [Cm { v: 2 }, Cm { v: 3 }];
    assert xs.iter_value().sum() matches { Some(t) && t.v == 5 };
    println(`${xs.iter_value().sum() matches { Some(t) && t.v == 5 }}`);
}

__DATA__
{"stdout": "true\n"}
