// Test: Common Subexpression Elimination (CSE)
//
// When the same pure binary expression appears in a loop guard and in the
// loop body, CSE computes it once and reuses the result.
//
// At O0: `p * p` is computed twice per iteration (guard and body)
// At O2: `p * p` is computed once into a __cse_ local and reused
//
// `#[inline(never)]` keeps `find_sqrt_bound` a standalone function so the
// WIR pattern check sees the CSE'd loop unchanged regardless of the
// inliner threshold.
//
// `black_box` keeps the arguments off the constant path: with constant ones
// the loop runs at compile time, the call folds to its result, and the
// function this fixture inspects is gone.

#[inline(never)]
fn find_sqrt_bound(limit: i32) -> i32 {
    let mut p = 2;
    let mut last_sq = 0;
    while p * p <= limit {
        last_sq = p * p;
        p += 1;
    }
    return last_sq;
}

test {
    assert find_sqrt_bound(builtin::black_box(100)) == 100;
    assert find_sqrt_bound(builtin::black_box(99)) == 81;
    assert find_sqrt_bound(builtin::black_box(1)) == 0;
}

__DATA__
{
    "test": {},
    "wir_expect:O0": ["last_sq = p * p"],
    "wir_not_expect:O2": ["last_sq = p * p"],
    "wir_expect:O2": ["__cse_"]
}
