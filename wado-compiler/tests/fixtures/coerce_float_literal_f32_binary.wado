// Test float literal coercion in binary expressions where operands
// include negated literals. Both `1.0 / 0.0` and `-1.0 / 0.0` should
// coerce to f32 when the expected type is f32.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let inf: f32 = 1.0 / 0.0;
    let neg_inf: f32 = -1.0 / 0.0;
    println(`{inf}`);
    println(`{neg_inf}`);
}

__DATA__
{"stdout": "inf\n-inf\n"}
