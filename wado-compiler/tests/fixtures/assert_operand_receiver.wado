// Test: the receiver of a field access and of a subscript is an operand like
// any other. A method call's receiver is not captured — a `&mut self` method
// would mutate the captured copy instead of the receiver.

struct Inner {
    v: i32,
}

struct Outer {
    inner: Inner,
}

export fn run() with Stdout {
    let o = Outer { inner: Inner { v: 1 } };
    let list: List<i32> = [10, 20];
    assert o.inner.v == list[0], "receivers";
}

__DATA__
{
    "trapped": true,
    "stderr_contains": [
        "condition: o.inner.v == list[0]",
        "o: Outer { inner: Inner { v: 1 } }",
        "o.inner: Inner { v: 1 }",
        "o.inner.v: 1",
        "list: [10, 20]",
        "list[0]: 10"
    ]
}
