// Holding a resource is not holding one that extends it: only narrowing a
// handle grants that. A closure reaching the extending resource by another
// way performs it, and a body holding the ancestor alone cannot call it.

#[cm("example:demo/dom#node", linearity = "unrestricted", repr = "externref", classes = "0..=1")]
resource Node {}

#[cm("example:demo/dom#input", linearity = "unrestricted", repr = "externref", classes = "1..=1")]
resource HtmlInputElement extends Node {}

fn focused() -> String with HtmlInputElement {
    return "focused";
}

fn read(_n: Node) -> String {
    let go = || focused();
    return go();
}

export fn run() with Node {
    let _ = read(Node::backed_by("node"));
}

