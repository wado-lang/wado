// Test: FutureWritable::drop() — cancel a future without resolving
// The response uses drop() on the trailers future writable instead of write().
//
// Expected behavior: traps with "unknown handle index"
// When trailers_tx.drop() is called, the CM runtime drops the writable end of the
// trailers future. The HTTP handler has already delivered the response via `task return`,
// so wasmtime tries to finalize trailers — but the future has been cancelled, causing
// the runtime to trap. This is correct: dropping an in-flight future is not recoverable.
use { Request, Response, ErrorCode, Fields, Trailers } from "wasi:http";

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let headers = Fields::new();
    let [response, _tx_future] = Response::new(headers, null, trailers_future);

    task return Result::<Response, ErrorCode>::Ok(response);

    // Drop the trailers future instead of writing to it
    trailers_tx.drop();
}

__DATA__
{"wasi:http/service": {"status": 200}, "trapped": true}
