// Test mutable global variable declaration and modification
use { println, Stdout } from "core:cli";

global mut counter: i32 = 0;

fn run() with Stdout {
    println(`counter={counter}`);
    counter = counter + 1;
    println(`counter={counter}`);
    counter = counter + 10;
    println(`counter={counter}`);
}

__DATA__
{"stdout": "counter=0\ncounter=1\ncounter=11\n"}
