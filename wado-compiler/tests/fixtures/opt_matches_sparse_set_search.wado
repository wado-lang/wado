// Test: a set too sparse for the mask test or a `br_table` is searched, not
// scanned. Its or-pattern tests one interval per alternative, so a Unicode
// property class of a thousand ranges cost a thousand compares per character.
// The pivot compare (`<u 910`) is the search's first step. The edges of every
// interval are probed, and a signed and an unsigned scrutinee order their
// values the way their type does. Alternatives that merge into a few intervals
// test those intervals, not each alternative.

use { println, Stdout } from "core:cli";

fn is_letter(c: char) -> bool {
    return c matches {
        'A'..='Z' | 'a'..='z' | '\u{AA}' | '\u{B5}' | '\u{BA}' | '\u{C0}'..='\u{D6}' | '\u{D8}'..='\u{F6}'
            | '\u{F8}'..='\u{2C1}' | '\u{370}'..='\u{374}' | '\u{386}' | '\u{388}'..='\u{38A}' | '\u{38C}'
            | '\u{38E}'..='\u{3A1}' | '\u{3A3}'..='\u{3F5}' | '\u{400}'..='\u{481}' | '\u{531}'..='\u{556}'
            | '\u{5D0}'..='\u{5EA}' | '\u{621}'..='\u{64A}' | '\u{904}'..='\u{939}' | '\u{E01}'..='\u{E30}'
            | '\u{10D0}'..='\u{10FA}' | '\u{3041}'..='\u{3096}' | '\u{30A1}'..='\u{30FA}' | '\u{4E00}'..='\u{9FFF}'
            | '\u{AC00}'..='\u{D7A3}'
    };
}

global EDGES: List<i32> = [
    65, 90, 97, 122, 170, 181, 186, 192, 214, 216, 246, 248, 705, 880, 884, 902, 904, 906, 908, 910, 929, 931,
    1013, 1024, 1153, 1329, 1366, 1488, 1514, 1569, 1610, 2308, 2361, 3585, 3632, 4304, 4346, 12353, 12438,
    12449, 12538, 19968, 40959, 44032, 55203,
];

fn is_odd_band(v: i32) -> bool {
    return v matches {
        -900..=-800 | -700 | -500..<-400 | -300 | -100..=-90 | 0 | 5..=9 | 100 | 300..=310 | 500 | 700..=800
    };
}

fn is_high(v: u32) -> bool {
    return v matches {
        1 | 10..=20 | 1000 | 70000..=80000 | 0x7FFF_FFFF | 0x8000_0000 | 0x9000_0000..=0x9000_00FF | 0xC000_0000
            | 0xFFFF_FFF0..=0xFFFF_FFFF
    };
}

fn is_run(v: i32) -> bool {
    return v matches { 4041 | 4042 | 4043 | 4044 | 4045 | 4046 | 4047 | 4048 };
}

export fn run() with Stdout {
    let mut inside = 0;
    let mut outside = 0;
    for let e of &EDGES {
        for let d of -1..=1 {
            let Some(c) = char::from_u32((*e + d) as u32) else { continue; };
            if is_letter(builtin::black_box(c)) {
                inside += 1;
            } else {
                outside += 1;
            }
        }
    }
    println(`${inside} ${outside}`);

    let mut odd = 0;
    for let v of -1000..=1000 {
        if is_odd_band(builtin::black_box(v)) {
            odd += 1;
        }
    }
    println(`${odd}`);

    let probes: List<u32> = [
        0, 1, 2, 9, 10, 20, 21, 999, 1000, 1001, 69999, 70000, 80000, 80001, 0x7FFF_FFFE, 0x7FFF_FFFF, 0x8000_0000,
        0x8000_0001, 0x9000_0000, 0x9000_00FF, 0x9000_0100, 0xBFFF_FFFF, 0xC000_0000, 0xFFFF_FFEF, 0xFFFF_FFF0,
        0xFFFF_FFFF,
    ];
    let mut high = 0;
    for let p of &probes {
        if is_high(builtin::black_box(*p)) {
            high += 1;
        }
    }
    println(`${high}`);

    let mut run = 0;
    for let v of 4030..=4060 {
        if is_run(builtin::black_box(v)) {
            run += 1;
        }
    }
    println(`${run}`);
}

__DATA__
{
    "stdout": "85 50\n334\n13\n8\n",
    "wir_expect:O0": ["<u 910"],
    "wir_expect:O2": ["<u 910"],
    "wir_not_expect:O0": ["== 4048"],
    "wir_not_expect:O2": ["== 4048"]
}
