// ? operator with variant auto-derive From — ergonomic error composition
// This is the primary motivating use case: multiple error types composed into one.
use { println } from "core:cli";

struct IoError {
    message: String,
}

struct ParseError {
    input: String,
}

variant AppError {
    Io(IoError),
    Parse(ParseError),
}

// Compiler generates From impls for each variant case
impl From<IoError> for AppError;
impl From<ParseError> for AppError;

fn read_data(ok: bool) -> Result<String, IoError> {
    if ok {
        return Result::<String, IoError>::Ok("42");
    }
    return Result::<String, IoError>::Err(IoError { message: "disk error" });
}

fn parse_number(s: String) -> Result<i32, ParseError> {
    if s == "42" {
        return Result::<i32, ParseError>::Ok(42);
    }
    return Result::<i32, ParseError>::Err(ParseError { input: s });
}

fn process(io_ok: bool, valid: bool) -> Result<i32, AppError> {
    // IoError → AppError::Io via auto-generated From
    let raw = read_data(io_ok)?;
    // ParseError → AppError::Parse via auto-generated From
    let n = parse_number(if valid { raw } else { "bad" })?;
    return Result::<i32, AppError>::Ok(n);
}

export fn run() with Stdout {
    // All steps succeed
    assert process(true, true) matches { Ok(n) && n == 42 };

    // IO failure → AppError::Io
    assert process(false, true) matches { Err(Io(e)) && e.message == "disk error" };

    // Parse failure → AppError::Parse
    assert process(true, false) matches { Err(Parse(e)) && e.input == "bad" };

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
