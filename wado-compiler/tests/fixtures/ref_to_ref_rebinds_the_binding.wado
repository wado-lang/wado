// A `&mut &T` names the binding holding the reference, so a write through it
// rebinds that binding and leaves the old referent alone. The reference was
// represented as its referent's handle, so the write overwrote `x` instead.

fn retarget(rr: &mut &i32, to: &i32) {
    *rr = to;
}

test "a call rebinds the reference it is handed" {
    let x = builtin::black_box(1);
    let y = builtin::black_box(2);
    let mut r = &x;
    retarget(&mut r, &y);
    assert *r == 2;
    assert x == 1;
}

struct P {
    v: i32,
}

fn retarget_struct(rr: &mut &P, to: &P) {
    *rr = to;
}

test "a struct reference rebinds through `&mut &T`" {
    let p = P { v: 1 };
    let q = P { v: 2 };
    let mut r = &p;
    retarget_struct(&mut r, &q);
    assert r.v == 2;
    assert p.v == 1;
}

test "a closure reads a reference rebound after it was built" {
    let mut a = P { v: builtin::black_box(1) };
    let mut b = P { v: builtin::black_box(2) };
    let mut r = &mut a;
    let read = || r.v;
    r = &mut b;
    assert read() == 2;
    assert a.v == 1;
}
