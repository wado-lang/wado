// `arithmetic_overflow` warns where integer literals alone overflow their type,
// or a literal shift amount is not below the bit width. The program still
// compiles, and the value wraps as it would at run time.

test "wraps" {
    assert 200_u8 + 100_u8 == 44;
    assert 0_u32 - 1_u32 == 4294967295;
    assert 2147483647 * 2 == -2;
    assert -(-128_i8) == -128;
    assert 1 << 33 == 2;
    let x = builtin::black_box(1_u8);
    assert x << 9 == 2;
}

test "in range stays quiet" {
    assert 100_u8 + 100_u8 + 55_u8 == 255;
    assert -128_i8 + 0_i8 == -128;
    assert 1 << 31 == -2147483648;
    assert 340282366920938463463374607431768211455_u128 - 1_u128 == 340282366920938463463374607431768211454_u128;
}

#[allow(arithmetic_overflow)]
test "allowed" {
    assert 255_u8 + 1_u8 == 0;
}

__DATA__
{
    "test": {},
    "warnings_contains": [
        "`200_u8 + 100_u8` overflows `u8`, so it wraps to 44",
        "`0_u32 - 1_u32` overflows `u32`, so it wraps to 4294967295",
        "`2147483647 * 2` overflows `i32`, so it wraps to -2",
        "`- -128_i8` overflows `i8`, so it wraps to -128",
        "`1 << 33` shifts by 33, which `i32` takes modulo 32 as 1",
        "`x << 9` shifts by 9, which `u8` takes modulo 8 as 1"
    ],
    "warnings_not_contains": ["`100_u8 + 100_u8", "`-128_i8 + 0_i8`", "`1 << 31`", "_u128 - 1_u128`", "`255_u8 + 1_u8`"]
}
