// Basic while let pattern matching
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let items: Array<i32> = [1, 2, 3];
    let mut iter = items.iter();

    while let Some(x) = iter.next() {
        println(`{x}`);
    }
    println("done");
}

__DATA__
{"stdout": "1\n2\n3\ndone\n"}
