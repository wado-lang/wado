// Test transitive function imports: main -> sub/uses_parent_simple -> ../user_function_call
// This tests that relative imports from subdirectory modules resolve correctly

use { println, Stdout } from "core:cli";
use { add_and_double } from "./sub/uses_parent_simple.wado";

export fn run() with Stdout {
    let result = add_and_double(10, 11);
    println(`result: {result}`);
}

__DATA__
{"stdout": "result: 42\n"}
