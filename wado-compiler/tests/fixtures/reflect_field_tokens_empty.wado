// A blanket `Reflect` derivation instantiated for a fieldless struct: the
// generic `field_tokens()` resolver must yield an empty walk, matching the
// concrete `Reflect::<Empty>::field_tokens()` — not a spurious "no Fields bound"
// error.

trait FieldCount {
    fn field_count(&self) -> i32;
}

impl<T: Reflect<Fields = [..F]>, ..F: Inspect> FieldCount for T {
    fn field_count(&self) -> i32 {
        let mut count = 0;
        for let f of Reflect::<T>::field_tokens() {
            count += 1;
        }
        return count;
    }
}

struct Empty {}

struct Two {
    a: i32,
    b: i32,
}

test "blanket field_tokens() derive works for empty and non-empty structs" {
    assert (Empty {}).field_count() == 0;
    assert (Two { a: 1, b: 2 }).field_count() == 2;
}

__DATA__
{"test": {}}
