// `Iterator` leaves its effects to the impl, so a `next()` may carry
// `with Stdout`. Iterating it demands `Stdout` of the caller, and a caller
// declaring none is reported where it iterates.
use { println, Stdout } from "core:cli";

struct Counter {
    n: i32,
}

impl Iterator for Counter {
    type Item = i32;

    fn next(&mut self) -> Option<i32> with Stdout {
        println("tick");
        if self.n <= 0 {
            return null;
        }
        self.n = self.n - 1;
        return Option::Some(self.n);
    }
}

impl IntoIterator for Counter {
    type Item = i32;
    type Iter = Counter;

    fn into_iter(&self) -> Counter {
        return *self;
    }
}

fn consume(c: Counter) {
    for let v of c {
        let _ = v;
    }
}

export fn run() with Stdout {
    consume(Counter { n: 2 });
}

