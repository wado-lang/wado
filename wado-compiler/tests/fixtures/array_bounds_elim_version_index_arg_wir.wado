// Loop-versioned BCE over a check inside the index expression. Once `sum` is
// inlined, `xs.len()` reads `(&xs).used`, which must read as `xs.used` for the
// bound to forward to the list's length and the loop to version.

use { println, Stdout } from "core:cli";

fn report(i: i32, n: i32, site: String) -> ! {
    panic(`${site} ${i} ${n}`);
}

fn sum(xs: &List<i32>, ob: i32, n: i32) -> i32 {
    let mut total = 0;
    for let mut c = 0; c < n; c += 1 {
        total += unchecked xs[check: {
            let k = ob + c + 1;
            let len = xs.len();
            if !(0 <= k && k < len) {
                builtin::cold_path();
                report(k, len, "here");
            }
            k
        }];
    }
    return total;
}

export fn run() with Stdout {
    let xs = List::<i32>::filled(builtin::black_box(8), 2);
    println(`${sum(&xs, builtin::black_box(2), builtin::black_box(5))}`);
}

__DATA__
{
    "stdout": "10\n",
    "wir_scope": ".wado/run",
    "wir_expect:O2": [
        "n_{} <= ((n_{} - 1) - ob)"
    ]
}
