// A tag can decide each hole by scanning the literal text before it. That scan
// reads nothing but constants: the shape holds every segment, and the state the
// previous segment left is constant too. It should fold to one answer per hole,
// leaving neither a call nor a loop.
//
// It folds only while the scan fits `inline_threshold` (16 at -O2, 26 at -O3).
// `small` is under it and folds away. `big` carries its pending escape and
// pending slash as loop-carried flags, sits over the budget, and survives as one
// call per hole, each rescanning a string the compiler knows.
//
// Splitting the per-character transition out of the loop closes that, at any
// state count: `scan` is two statements and `step` is a `match` over constants,
// so both inline and the whole walk folds. `step` recognizes the same language
// as `big` — each pending flag is a state of its own — so only the shape decides
// whether the answer is a constant. A tag wanting a scan bigger than the budget
// writes it this way rather than reaching for `--optimize-inline-threshold`.
use { println, Stdout } from "core:cli";

enum Small {
    Code,
    Str,
}

enum Big {
    Code,
    Str,
    Chr,
    Comment,
}

// `Big` with each pending flag promoted to a state.
enum Lex {
    Code,
    CodeSlash,
    Str,
    StrEscape,
    Chr,
    ChrEscape,
    Comment,
}

fn small(ctx: Small, lit: &String) -> Small {
    let mut cur = ctx;
    for let c of lit.chars() {
        if c == '"' {
            cur = match cur {
                Small::Code => Small::Str,
                Small::Str => Small::Code,
            };
        }
    }
    return cur;
}

fn big(ctx: Big, lit: &String) -> Big {
    let mut cur = ctx;
    let mut escaped = false;
    let mut prev_slash = false;
    for let c of lit.chars() {
        if escaped {
            escaped = false;
            prev_slash = false;
            continue;
        }
        match cur {
            Big::Code => {
                if c == '"' {
                    cur = Big::Str;
                } else if c == '\'' {
                    cur = Big::Chr;
                } else if c == '/' && prev_slash {
                    cur = Big::Comment;
                }
            },
            Big::Str => {
                if c == '\\' {
                    escaped = true;
                } else if c == '"' {
                    cur = Big::Code;
                }
            },
            Big::Chr => {
                if c == '\\' {
                    escaped = true;
                } else if c == '\'' {
                    cur = Big::Code;
                }
            },
            Big::Comment => {
                if c == '\n' {
                    cur = Big::Code;
                }
            },
        }
        prev_slash = c == '/';
    }
    return cur;
}

fn step(ctx: Lex, c: char) -> Lex {
    return match ctx {
        Lex::Code => open(c),
        Lex::CodeSlash => match c {
            '/' => Lex::Comment,
            _ => open(c),
        },
        Lex::Str => match c {
            '\\' => Lex::StrEscape,
            '"' => Lex::Code,
            _ => Lex::Str,
        },
        Lex::StrEscape => Lex::Str,
        Lex::Chr => match c {
            '\\' => Lex::ChrEscape,
            '\'' => Lex::Code,
            _ => Lex::Chr,
        },
        Lex::ChrEscape => Lex::Chr,
        Lex::Comment => match c {
            '\n' => Lex::Code,
            _ => Lex::Comment,
        },
    };
}

fn open(c: char) -> Lex {
    return match c {
        '"' => Lex::Str,
        '\'' => Lex::Chr,
        '/' => Lex::CodeSlash,
        _ => Lex::Code,
    };
}

fn scan(ctx: Lex, lit: &String) -> Lex {
    let mut cur = ctx;
    for let c of lit.chars() {
        cur = step(cur, c);
    }
    return cur;
}

fn marked<T: ReflectTemplate<Holes = [..V]>, ..V: Display>(t: T) -> String {
    let mut out = "";
    let mut in_small = Small::Code;
    let mut in_big = Big::Code;
    let mut in_scan = Lex::Code;
    for let h of ReflectTemplate::<T>::members() {
        let lit = h.lit();
        out.push_str(&lit);
        in_small = small(in_small, &lit);
        in_big = big(in_big, &lit);
        in_scan = scan(in_scan, &lit);
        if in_small matches { Small::Str } {
            out.push('!');
        }
        if in_big matches { Big::Chr } {
            out.push('?');
        }
        if in_scan matches { Lex::Chr } {
            out.push('#');
        }
        h.fmt(&t, &mut Formatter::new(&mut out));
    }
    out.push_str(&ReflectTemplate::<T>::tail());
    return out;
}

export fn run() with Stdout {
    let name = builtin::black_box("n");
    let text = builtin::black_box("t");
    println(marked`let ${name} = "${text}";`);
    println(marked`let ${name} = '${text}';`);
    // An escaped quote closes nothing, so the segment ends inside the char
    // literal it opened. A split that dropped the pending escape would end in
    // code and print no `#`.
    println(marked`let ${name} = '\\'' + '${text}';`);
}

__DATA__
{
    "stdout": "let n = \"!t\";\nlet n = '?#t';\nlet n = '\\'' + '?#t';\n",
    "wir_expect:O2": [
        "tagged_template_lit_scan_fold.wado/big"
    ],
    "wir_not_expect:O2": [
        "tagged_template_lit_scan_fold.wado/small",
        "tagged_template_lit_scan_fold.wado/step",
        "tagged_template_lit_scan_fold.wado/open",
        "tagged_template_lit_scan_fold.wado/scan"
    ]
}
