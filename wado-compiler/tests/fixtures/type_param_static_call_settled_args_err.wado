{"compile_error": ":31:19: analysis error: type mismatch: expected '&T', found '&String'; 35:29: type mismatch: expected 'u8', found 'String'; 39:24: type mismatch: expected 'T', found 'String'", "compile_error_codes": ["TYPE_MISMATCH"]}
