// Two inherent blocks reaching a common receiver may not both define a name.

struct Box<T> { v: T }

impl<T> Box<T> { fn a(&self) -> String { return "any"; } }
impl Box<i32> { fn a(&self) -> i32 { return self.v; } }   // ERROR: duplicate definition of `a`

