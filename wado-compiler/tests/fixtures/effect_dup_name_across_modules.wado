// Two modules declare `interface Log`, only this one handles it. Each
// declaration's dispatch is its own, named after the interface qualified by
// its module, so the other module's `Log` is no duplicate of this one.
use { println, Stdout } from "core:cli";
use { helper } from "./sub/effect_dup_name_other.wado";

interface Log {
    fn emit(message: String);
}

struct Sink {
    lines: List<String> = [],
}

impl Log for Sink {
    fn emit(&mut self, message: String) {
        self.lines.push(message);
        resume ();
    }
}

export fn run() with Stdout {
    let mut sink = Sink {};
    with Log => &mut sink do {
        Log::emit(`hello`);
    };
    println(`${sink.lines.len()} ${helper()}`);
}

__DATA__
{
    "stdout": "1 7\n"
}
