// Regression: Default synthesis must be on-demand (WEP: Trait Derivation
// Policy) — a defaults-eligible struct whose `default()` nothing calls must
// get no synthesized impl.
//
// Checked at -O0 so the optimizer cannot fold the used call away.
struct UsedDefault {
    x: i32 = 7,
}

struct UnusedDefault {
    y: i32 = 9,
}

export fn run() {
    let a = UsedDefault::default();
    assert a.x == 7;

    let _unused = UnusedDefault { y: 1 };
}

__DATA__
{
    "wir_expect:O0": ["UsedDefault^Default::default"],
    "wir_not_expect:O0": ["UnusedDefault^Default::default"]
}
