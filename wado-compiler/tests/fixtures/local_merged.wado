test "bools" {
    let t = true;
    let f = false;
    assert t == true;
    assert f == false;
}

test "bools mut" {
    let mut flag = false;
    assert flag == false;
    flag = true;
    assert flag == true;
}

test "floats" {
    let a = 1.5;
    let b = 2.5;
    let sum = a + b;
    assert sum == 4.0;
}

test "floats mut" {
    let mut x = 1.0;
    assert x == 1.0;
    x = 2.5;
    assert x == 2.5;
    x = x + 0.5;
    assert x == 3.0;
}

test "integers" {
    let a = 10;
    let b = 20;
    let sum = a + b;
    assert sum == 30;
}

test "let and let mut" {
    let msg = "Hello from let!";
    assert msg == "Hello from let!";
    let mut msg2 = "First message";
    assert msg2 == "First message";
    msg2 = "Second message";
    assert msg2 == "Second message";
}

__DATA__
{"test": {}}
