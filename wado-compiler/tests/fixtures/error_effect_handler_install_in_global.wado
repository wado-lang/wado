// A global initializer must be pure, so it may not install a handler whose
// methods perform a capability.

use { Random } from "wasi:random";

interface Dice {
    fn roll() -> u64;
}

struct HostDice {}

impl Dice for HostDice {
    fn roll(&self) -> u64 with Random {
        resume Random::get_random_u64();
    }
}

global SEED: u64 = with Dice => &HostDice {} do { Dice::roll() };

export fn run() {
    let _ = SEED;
}

