// A trait's default method declares `J`, and the impl receiving it declares
// its own `J`. The impl's `J` keeps its bounds while the method's is in scope:
// `Self` still names `Pair<I, J>` with the impl's.
use { println, Stdout } from "core:cli";

trait Count with () {
    fn count(&self) -> i32;

    fn plus<J: Count>(&self, other: &J) -> i32 {
        return self.count() + other.count();
    }
}

impl Count for i32 {
    fn count(&self) -> i32 {
        return *self;
    }
}

struct Pair<I, J> {
    i: I,
    j: J,
}

impl<I: Count, J: Count> Count for Pair<I, J> {
    fn count(&self) -> i32 {
        return self.i.count() + self.j.count();
    }
}

export fn run() with Stdout {
    let p = Pair { i: 1, j: 2 };
    println(`${p.plus(&10)}`);
}

__DATA__
{"stdout": "13\n"}
