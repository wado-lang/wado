// A stub names one generator by its whole specifier, so a version on its
// nickname is not it.

use { greeting } from "./sub/kiln/value.schema"
    with {
        generator: {
            module: "lib:gen@1.0.0",
            options: { verbose: false },
        },
    };

test {
    assert greeting() == "hi";
}

__DATA__
{"build_dependencies": {"lib:gen": "./sub/kiln/options/verbose_generator.wado"}, "compile_error": "kiln: generator `lib:gen@1.0.0` is neither a `./` path nor a stubbed build dependency"}
