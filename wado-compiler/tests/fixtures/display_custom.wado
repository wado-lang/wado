// Test: Display trait for custom struct
use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

impl Display for Point {
    pub fn fmt(&self, f: &mut Formatter) {
        f.write_char('(');
        f.write_str(self.x.to_string());
        f.write_str(", ");
        f.write_str(self.y.to_string());
        f.write_char(')');
    }
}

export fn run() with Stdout {
    let p = Point { x: 10, y: 20 };
    let mut buf = String::with_capacity(64);
    let mut f = Formatter::new(&mut buf, FormatSpec::default());
    p.fmt(&mut f);
    println(buf);

    // Origin
    let o = Point { x: 0, y: 0 };
    buf = String::with_capacity(64);
    f = Formatter::new(&mut buf, FormatSpec::default());
    o.fmt(&mut f);
    println(buf);
}

__DATA__
{"stdout": "(10, 20)\n(0, 0)\n"}
