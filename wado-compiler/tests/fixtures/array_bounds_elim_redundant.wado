// Test: redundant consecutive bounds check elimination
// When arr[i] is accessed twice with the same index (and the array is not
// modified in between), the second bounds check is redundant.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let arr: Array<i32> = [10, 20, 30];
    let mut sum = 0;
    for let mut i = 0; i < arr.len(); i += 1 {
        // Two accesses with same index — second check should be eliminated
        let a = arr[i];
        let b = arr[i];
        sum += a + b;
    }
    assert sum == 120;
    println(`{sum}`);
}

__DATA__
{
    "stdout": "120\n"
}
