// A closure is replaced on assignment, so a `&mut` binding to one inside a
// larger value would reference a detached copy, and is refused as a scalar's is.

export fn run() {
    let mut o: Option<fn() -> i32> = Option::Some(|| 1);
    if let Some(f) = &mut o {
        *f = || 3;
    }
}

