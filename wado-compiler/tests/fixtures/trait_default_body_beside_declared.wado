// A block that inherits a static with the trait's default body, beside another
// block on the same type that declares a static of its own. The selection
// reaches the trait's own declaration, whose signature `method_sig` does not
// hold — the impl-declared ones are its, a trait's own its `TraitSig`'s — and
// the spelling resolved to nothing.

trait Made {
    fn made(n: i32 = 3) -> i32 {
        return n;
    }
}

trait Other {
    fn other() -> i32;
}

struct M {}

impl Made for M {}

impl Other for M {
    fn other() -> i32 {
        return 1;
    }
}

test "the inherited static resolves beside a declared one" {
    assert M::made() == 3;
    assert M::made(8) == 8;
}

test "the declared one still answers" {
    assert M::other() == 1;
}
