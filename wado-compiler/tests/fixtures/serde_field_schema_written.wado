// A struct that writes its own `FieldSchema` keeps it when its `Deserialize`
// is derived: the derivation reads the keys through the written lookup, and
// none is synthesized beside it.
use { FieldSchema } from "core:serde";
use { from_string } from "core:json";

struct Point {
    x: i32,
}

impl FieldSchema for Point {
    fn lookup(key: ByteSlice) -> Option<i32> {
        if key == "ex".as_bytes() {
            return Option::Some(0);
        }
        return null;
    }

    fn positional_at(rank: i32) -> Option<i32> {
        return null;
    }
}

test "the derived Deserialize reads keys through the written FieldSchema" {
    assert from_string::<Point>("{\"ex\":1}").unwrap().x == 1;
    assert from_string::<Point>("{\"x\":1}") matches { Err(_) };
}

__DATA__
{"test": {}}
