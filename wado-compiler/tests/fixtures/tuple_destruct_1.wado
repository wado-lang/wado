use { println, Stdout } from "core:cli";

// from tuple_destruct_basic.wado
fn make_pair() -> [i32, String] {
    return [42, "hello"];
}

// from tuple_destruct_basic.wado
fn tuple_destruct_basic() with Stdout {
    let [a, b] = make_pair();
    println(`{a}, {b}`);
}

// from tuple_destruct_for_of.wado
fn tuple_destruct_for_of() with Stdout {
    let pairs: Array<[i32, String]> = [[1, "one"], [2, "two"], [3, "three"]];

    // for-of with tuple destructuring
    for let [num, name] of pairs {
        println(`{num}: {name}`);
    }

    // for-of with wildcard
    for let [_, name] of pairs {
        println(name);
    }
}

// from tuple_destruct_if_let.wado
fn tuple_destruct_if_let() with Stdout {
    let opt: Option<[i32, i32]> = Option::<[i32, i32]>::Some([10, 20]);

    // if-let with tuple destructuring inside variant
    if let Some([x, y]) = opt {
        println(`{x}, {y}`);
    }

    // if-let with None
    let none: Option<[i32, i32]> = null;
    if let Some([x, y]) = none {
        println(`{x}, {y}`);
    } else {
        println("none");
    }

    // if-let with wildcard in tuple
    if let Some([_, y]) = opt {
        println(`{y}`);
    }
}

export fn run() with Stdout {
    tuple_destruct_basic();
    tuple_destruct_for_of();
    tuple_destruct_if_let();
}

__DATA__
{"stdout": "42, hello\n1: one\n2: two\n3: three\none\ntwo\nthree\n10, 20\nnone\n20\n"}
