// Test match expression with i128 literal patterns
// i128 codegen is not yet fully implemented

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let x: i128 = 42 as i128;

    let r1 = match x {
        0 => "zero",
        42 => "answer",
        _ => "other",
    };
    println(r1);
}

__DATA__
{"stdout": "answer\n"}
