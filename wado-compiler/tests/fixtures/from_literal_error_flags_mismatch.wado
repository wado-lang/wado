// Key-value literal error: flags in concrete impl position rejects wrong type.
// Read as a free type parameter, Perms would let PermsMap<String, i32> match the
// impl.
flags Perms { Read, Write }

struct PermsMap<P, V> {
    keys: List<String>,
    values: List<V>,
}

impl<V> From<Array<[String, V]>> for PermsMap<Perms, V> {
    fn from(entries: Array<[String, V]>) -> PermsMap<Perms, V> {
        let mut out: PermsMap<Perms, V> = PermsMap { keys: [], values: [] };
        for let [key, value] of entries {
            out.keys.push(key);
            out.values.push(value);
        }
        return out;
    }
}

export fn run() {
    // String != Perms — should fail to find impl
    let m: PermsMap<String, i32> = { a: 1 };
}

__DATA__
{"compile_error": "cannot be built from an object literal"}
