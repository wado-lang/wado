// KeyValueLiteral error: flags in concrete impl position rejects wrong type.
// Before the is_known_type_name fix, Perms was treated as a free type parameter,
// so PermsMap<String, i32> incorrectly matched the impl.
flags Perms { Read, Write }

struct PermsMap<P, V> {
    keys: List<String>,
    values: List<V>,
}

impl KeyValueLiteralBuilder for PermsMap<Perms, V> {
    type Value = V;
    type Output = PermsMap<Perms, V>;

    fn new_literal(capacity: i32) -> PermsMap<Perms, V> {
        return PermsMap { keys: [], values: [] };
    }

    fn insert_literal(&mut self, key: String, value: Self::Value) {
        self.keys.push(key);
        self.values.push(value);
    }

    fn build(&self) -> PermsMap<Perms, V> {
        return *self;
    }
}

export fn run() {
    // String != Perms — should fail to find impl
    let m: PermsMap<String, i32> = { a: 1 };
}

__DATA__
{"compile_error": "does not implement KeyValueLiteral"}
