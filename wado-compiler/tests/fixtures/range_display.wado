#![TODO]
// Range Display and Eq traits (WEP Phase 4)
use { println, Stdout } from "core:cli";

test "exclusive range display" with Stdout {
    let r = 0..<10;
    println(`{r}`);
    assert `{r}` == "0..<10";
}

test "inclusive range display" with Stdout {
    let r = 1..=5;
    println(`{r}`);
    assert `{r}` == "1..=5";
}

test "exclusive range eq" {
    assert (0..<10) == (0..<10);
    assert !((0..<10) == (0..<5));
}

test "inclusive range eq" {
    assert (0..=10) == (0..=10);
    assert !((0..=10) == (0..=5));
}

