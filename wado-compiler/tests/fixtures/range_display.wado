// Range Display and Eq traits
use { println } from "core:cli";

test "exclusive range display" {
    let r = 0..<10;
    println(`{r}`);
    assert `{r}` == "0..<10";
}

test "inclusive range display" {
    let r = 1..=5;
    println(`{r}`);
    assert `{r}` == "1..=5";
}

test "exclusive range eq" {
    assert (0..<10) == (0..<10);
    assert !((0..<10) == (0..<5));
}

test "inclusive range eq" {
    assert (0..=10) == (0..=10);
    assert !((0..=10) == (0..=5));
}

__DATA__
{"test": {}}
