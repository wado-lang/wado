// Test ArrayIter::fold() method
use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let arr: Array<i32> = [1, 2, 3, 4, 5];

    // Sum using fold (explicit closure parameter types required)
    let sum = arr.iter().fold(0, |acc: i32, x: i32| acc + x);
    println(`sum: {sum}`);

    // Product using fold
    let product = arr.iter().fold(1, |acc: i32, x: i32| acc * x);
    println(`product: {product}`);

    // Count using fold
    let count = arr.iter().fold(0, |acc: i32, _x: i32| acc + 1);
    println(`count: {count}`);

    // Max using fold (starting with first element pattern)
    let arr2: Array<i32> = [3, 1, 4, 1, 5, 9, 2, 6];
    let max = arr2.iter().fold(0, |acc: i32, x: i32| if x > acc {
        x;
    } else {
        acc;
    });

    println(`max: {max}`);
}

__DATA__
{"stdout": "sum: 15\nproduct: 120\ncount: 5\nmax: 9\n"}
