// Test: struct with bounded field used in bounded impl block method
use { println, Stdout } from "core:cli";

struct Holder<T> {
    items: Array<T>,
}

impl Holder<T: Ord> {
    fn min(&self) -> T {
        let mut m = self.items[0];
        for let mut i = 1; i < self.items.len(); i += 1 {
            if self.items[i] < m {
                m = self.items[i];
            }
        }
        return m;
    }
}

export fn run() with Stdout {
    let h = Holder { items: [5, 3, 8, 1, 4] as Array<i32> };
    println(`{h.min()}`);
}

__DATA__
{"stdout": "1\n"}
