//! A static's own type parameters, solved from the arguments. Where the block
//! declares slots of its own the method's are not numbered from zero, so the
//! receiver's substitution does not reach them and an unspelled one used to
//! reach codegen unsubstituted — reported, with the spelling named as the
//! remedy. They are inferred at the call now, as instance dispatch infers them.

trait Codec {
    fn build<T: Display>(v: T) -> String;
}

struct Box3<A> {
    a: A,
}

impl<A> Codec for Box3<A> {
    fn build<T: Display>(v: T) -> String {
        return `${v}`;
    }
}

test "the argument solves the method's own slot" {
    assert Box3::<i32>::build(42) == "42";
    assert Box3::<i32>::build("x") == "x";
}

test "and a spelled turbofish still wins" {
    assert Box3::<i32>::build::<i32>(42) == "42";
}
