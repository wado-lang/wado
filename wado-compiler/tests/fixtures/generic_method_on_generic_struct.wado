// Test: Generic method on a non-generic struct
use { println, Stdout } from "core:cli";

struct Wrapper {
    value: i32,
}

impl Wrapper {
    fn convert<U>(&self, other: U) -> U {
        return other;
    }
}

fn run() with Stdout {
    let w = Wrapper { value: 42 };
    let x = w.convert::<i64>(100 as i64);
    let y = w.convert::<f64>(3.14);
    println(`x: {x}, y: {y}`);
}

__DATA__
{"stdout": "x: 100, y: 3.14\n"}
