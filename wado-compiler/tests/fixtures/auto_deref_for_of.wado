// Auto-dereference: using &Array<T> in for-of loops
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // for-of on &Array<T>
    let arr: Array<i32> = [1, 2, 3];
    let ra = &arr;
    let mut sum = 0;
    for let x of ra {
        sum += x;
    }
    assert sum == 6;

    // for-of on &String (chars)
    let s = "abc";
    let rs = &s;
    let mut count = 0;
    for let c of rs.chars() {
        count += 1;
    }
    assert count == 3;

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
