// TreeMap maintains insertion order (indexmap-style)
use { println, print } from "core:cli";
use { TreeMap } from "core:collections";

export fn run() with Stdout {
    let mut map = TreeMap::<String, i32>::new();

    // Insert in arbitrary order - should iterate in this exact order
    map["echo"] = 5;
    map["charlie"] = 3;
    map["golf"] = 7;
    map["alpha"] = 1;
    map["india"] = 9;
    map["delta"] = 4;
    map["foxtrot"] = 6;
    map["bravo"] = 2;
    map["hotel"] = 8;

    assert map.len() == 9;

    // Keys should be in insertion order, NOT sorted order
    let keys = map.keys();
    assert keys[0] == "echo";
    assert keys[1] == "charlie";
    assert keys[2] == "golf";
    assert keys[3] == "alpha";
    assert keys[4] == "india";
    assert keys[5] == "delta";
    assert keys[6] == "foxtrot";
    assert keys[7] == "bravo";
    assert keys[8] == "hotel";

    // Values should be in insertion order
    let values = map.values();
    assert values[0] == 5;
    assert values[1] == 3;
    assert values[2] == 7;
    assert values[3] == 1;
    assert values[4] == 9;

    print("keys: ");
    for let mut i = 0; i < keys.len(); i += 1 {
        if i > 0 {
            print(", ");
        }
        print(keys[i]);
    }
    println("");
}

__DATA__
{"stdout": "keys: echo, charlie, golf, alpha, india, delta, foxtrot, bravo, hotel\n"}
