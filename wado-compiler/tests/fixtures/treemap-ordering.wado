// TreeMap maintains sorted order
use { println, print } from "core:cli";

fn run() with Stdout {
    let mut map = TreeMap::<String, i32>::new();

    // Insert in random order
    map.insert("echo", 5);
    map.insert("charlie", 3);
    map.insert("golf", 7);
    map.insert("alpha", 1);
    map.insert("india", 9);
    map.insert("delta", 4);
    map.insert("foxtrot", 6);
    map.insert("bravo", 2);
    map.insert("hotel", 8);

    assert map.len() == 9;

    // Keys should be in sorted order
    let keys = map.keys();
    assert keys[0] == "alpha";
    assert keys[1] == "bravo";
    assert keys[2] == "charlie";
    assert keys[3] == "delta";
    assert keys[4] == "echo";
    assert keys[5] == "foxtrot";
    assert keys[6] == "golf";
    assert keys[7] == "hotel";
    assert keys[8] == "india";

    // Values should be in key-sorted order
    let values = map.values();
    assert values[0] == 1;
    assert values[1] == 2;
    assert values[2] == 3;

    print("keys: ");
    for let mut i = 0; i < keys.len(); i += 1 {
        if i > 0 {
            print(", ");
        }
        print(keys[i]);
    }
    println("");
}

__DATA__
{"stdout": "keys: alpha, bravo, charlie, delta, echo, foxtrot, golf, hotel, india\n"}
