// Loop-versioned BCE over a check whose index adds a constant after the guard
// variable: `ob + c + 1` groups as `(ob + c) + 1`, which reads as `c` shifted
// by `ob` and 1 alike.

use { println, Stdout } from "core:cli";

fn sum(xs: &List<i32>, ob: i32, n: i32) -> i32 {
    let mut total = 0;
    for let mut c = 0; c < n; c += 1 {
        total += xs[ob + c + 1];
    }
    return total;
}

export fn run() with Stdout {
    let xs = List::<i32>::filled(builtin::black_box(8), 2);
    println(`${sum(&xs, builtin::black_box(2), builtin::black_box(5))}`);
}

__DATA__
{
    "stdout": "10\n",
    "wir_scope": ".wado/run",
    "wir_expect:O2": [
        "n_{} <= ((n_{} - 1) - ob)"
    ]
}
