// Indexing a constant-length global `List`: the power-assert capture of the
// bounds check reads the global's length, and the index stays checked.

global TBL: List<u64> = [1, 10, 100, 1000, 10000];

fn lookup(n: i32) -> u64 {
    return TBL[n];
}

export fn run() {
    let mut s: u64 = 0;
    for let mut i = 0; i < 5; i += 1 {
        s += lookup(i);
    }
    assert s == 11111 as u64;
}

