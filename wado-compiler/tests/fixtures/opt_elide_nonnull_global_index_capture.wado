// Indexing a constant-length global `List` with an opaque index: the index
// stays checked, and the bounds check's power-assert capture of the global's
// length leaves no read of it on the hot path.

global TBL: List<u64> = [1, 10, 100, 1000, 10000];

fn lookup(n: i32) -> u64 {
    return TBL[n];
}

export fn run() {
    let mut s: u64 = 0;
    for let mut i = 0; i < 5; i += 1 {
        s += lookup(builtin::black_box(i));
    }
    assert s == 11111 as u64;
}

__DATA__
{
    "stdout": "",
    "wir_not_expect:O2": [".used"],
    "wir_expect:O2": ["if @unlikely(n >=u 5) {"],
    "wir_scope": "opt_elide_nonnull_global_index_capture.wado/$cm_export__run",
    "wir_pass": {"O2": ["nir/cold_outline", "nir/unsigned_range_check"]}
}
