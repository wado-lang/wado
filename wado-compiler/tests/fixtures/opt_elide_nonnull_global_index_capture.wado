// Indexing a constant-length global `List` leaves a dead `drop(self.used)` from
// the power-assert diagnostic capture; `elide_local` must drop it (via the
// local's non-null declared type) while keeping the `i >= 5` bounds check.

global TBL: List<u64> = [1, 10, 100, 1000, 10000];

fn lookup(n: i32) -> u64 {
    return TBL[n];
}

export fn run() {
    let mut s: u64 = 0;
    for let mut i = 0; i < 5; i += 1 {
        s += lookup(i);
    }
    assert s == 11111 as u64;
}

__DATA__
{
    "stdout": "",
    "wir_not_expect:O2": [
        "drop(self"
    ],
    "wir_expect:O2": [
        "builtin::array_get<u64>"
    ]
}
