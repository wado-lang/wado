// The library's `Option<T>` impl needs `Node: Describe`, which its module
// cannot prove: `Node`'s fields are private here. Its variant blanket takes
// `Option<Node>` by kind, but its `..P: Describe` fails on `Node` the same way,
// so neither serves and the call is reported rather than handed to the blanket.
use { Describe } from "./sub/reflect_blanket_payload_bound_lib.wado";

struct Node {
    value: i32,
    next: Option<Node>,
}

export fn run() {
    let _ = Node::describe(0);
}

