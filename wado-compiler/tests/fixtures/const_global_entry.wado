// Constant Object Globalization, inlined-init case: when a small entry-module
// `$initialize_module` is inlined into the entry points, the global's init
// `GlobalSet` ends up nested inside an `$inline__initialize_modules` guard
// block (and duplicated once per entry export). `wir_optimize::const_global`
// must still find and promote it — a top-level-only scan would silently leave
// the global lazy (`global mut … = ref.null`).
//
// A single struct global with no lazy globals to keep `$initialize_module`
// standalone exercises exactly that nested/duplicated shape.

use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

global ORIGIN: Point = Point { x: 3, y: 4 };

export fn run() with Stdout {
    // A read the optimizer sees through folds the whole line to a constant, so
    // only an opaque one keeps the global alive for the promotion pinned here.
    let origin = builtin::black_box(ORIGIN);
    println(`${origin.x},${origin.y},${origin:?}`);
}

__DATA__
{
    "stdout": "3,4,Point { x: 3, y: 4 }\n",
    "wir_expect:O2": [
        "global global:const_global_entry.wado::ORIGIN",
        "= struct.new",
        "{ x: 3, y: 4 }"
    ],
    "wir_not_expect:O2": [
        "global mut global:const_global_entry.wado::ORIGIN"
    ]
}
