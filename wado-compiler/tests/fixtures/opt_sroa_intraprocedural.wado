// Test: Intraprocedural SROA patterns
// Tests struct field access patterns that should benefit from SROA optimization.
// Uses #[inline(never)] to isolate intraprocedural patterns from inlining, and
// `black_box` to keep the calls off the constant path — a call whose arguments
// are all constant is evaluated at compile time, so the function SROA is meant
// to be observed in folds away entirely.

struct Point {
    x: i32,
    y: i32,
}

struct Rect {
    origin: Point,
    width: i32,
    height: i32,
}

// Pattern 1: Basic struct literal with field access (baseline - already works)


#[inline("never")]
fn basic_sroa() -> i32 {
    let p = Point { x: 10, y: 20 };
    return p.x + p.y;
}

// Pattern 2: Mutable struct with field write then read


#[inline("never")]
fn mutable_field_write(seed: i32) -> i32 {
    let mut p = Point { x: seed, y: 0 };
    p.x = p.x + 42;
    p.y = p.x * 2;
    return p.x + p.y;
}

// Pattern 2b: Whole write of a literal reading the struct itself. Every field
// is read before any is written, so the swap sees the old values.


#[inline("never")]
fn whole_write_reads_self(n: i32) -> i32 {
    let mut p = Point { x: n, y: 1 };
    for let _ of 0..<n {
        p = Point { x: p.y, y: p.x + p.y };
    }
    return p.x;
}

// Pattern 2c: Whole write whose later field leaves the statement. No field is
// written, the earlier one included.


#[inline("never")]
fn whole_write_continues(n: i32) -> i32 {
    let mut p = Point { x: 0, y: 0 };
    for let i of 0..<n {
        p = Point { x: i + 10, y: if i == n - 1 { continue; } else { i } };
    }
    return p.x * 100 + p.y;
}

// Pattern 3: Struct where only some fields escape (currently all-or-nothing)
// Ideally, field y should still be SROA'd even though x is used in a call


#[inline("never")]
fn partial_escape(x: i32) -> i32 {
    let p = Point { x, y: 100 };
    // p.x comes from a parameter (escapes via call), but p.y is constant
    return p.x + p.y;
}

// Pattern 4: Nested struct literal with field access


#[inline("never")]
fn nested_struct() -> i32 {
    let r = Rect { origin: Point { x: 1, y: 2 }, width: 10, height: 20 };
    return r.origin.x + r.origin.y + r.width + r.height;
}

// Pattern 5: Multiple structs in same function, independent lifetimes


#[inline("never")]
fn multiple_structs() -> i32 {
    let a = Point { x: 1, y: 2 };
    let b = Point { x: 3, y: 4 };
    return a.x * b.y + a.y * b.x;
}

// Pattern 6: Struct constructed, fields accessed, then passed to call (soft escape)
// SROA should decompose the struct and reconstruct it at the call site


#[inline("never")]
fn sum_point(p: Point) -> i32 {
    return p.x + p.y;
}


#[inline("never")]
fn use_then_pass() -> i32 {
    let p = Point { x: 10, y: 20 };
    let sum = p.x + p.y;  // field access (benefits from SROA)
    let passed = sum_point(p);  // escape via call (should reconstruct)
    return sum + passed;
}

// Pattern 7: Struct constructed and returned (soft escape via return)


#[inline("never")]
fn build_and_return(x: i32, y: i32) -> Point {
    let p = Point { x, y };
    // Currently p escapes via return; with reconstruction, fields stay as scalars
    return p;
}

export fn run() {
    assert basic_sroa() == 30;
    assert mutable_field_write(builtin::black_box(7)) == 147;
    assert whole_write_reads_self(builtin::black_box(3)) == 5;
    assert whole_write_continues(builtin::black_box(3)) == 1101;
    assert partial_escape(50) == 150;
    assert nested_struct() == 33;
    assert multiple_structs() == 10;
    assert use_then_pass() == 60;
    let built = build_and_return(5, 15);
    assert built.x + built.y == 20;
}

__DATA__
{
    "stdout": "",
    "wir_expect:O2": [
        "fn \"opt_sroa_intraprocedural.wado/mutable_field_write\"(seed) {\n    let $sroa_p_x_",
        "fn \"opt_sroa_intraprocedural.wado/whole_write_reads_self\"(n) {\n    let $sroa_p_x_"
    ]
}
