// Calling a `fn mut` mutates what it captured, which the clause did not declare.
fn guarded(mut f: fn mut() -> bool, n: i32) -> i32
    contract f()
{
    return n;
}

export fn run() {
    let mut seen = 0;
    let _ = guarded(|| { seen += 1; return true; }, 1);
}

