// Key-value literal error: enum in concrete impl position rejects wrong type.
// Before the is_known_type_name fix, Direction was treated as a free type
// parameter, so DirMap<String, i32> incorrectly matched the impl.
enum Direction { North, South }

struct DirMap<D, V> {
    keys: List<String>,
    values: List<V>,
}

impl From<Array<[String, V]>> for DirMap<Direction, V> {
    fn from(entries: Array<[String, V]>) -> DirMap<Direction, V> {
        let mut out: DirMap<Direction, V> = DirMap { keys: [], values: [] };
        for let [key, value] of entries {
            out.keys.push(key);
            out.values.push(value);
        }
        return out;
    }
}

export fn run() {
    // String != Direction — should fail to find impl
    let m: DirMap<String, i32> = { a: 1 };
}

__DATA__
{"compile_error": "cannot be built from an object literal"}
