// Regression (WEP 2026-05-21): a `Result<Resource, E>` bound to a `let`, first
// inspected with `if let Err(_)`, then consumed with `.unwrap()`, must be
// dropped exactly once. `unwrap` takes `self` by value, so the receiver `r` is
// transferred and must not also get a structural scope-exit drop — otherwise the
// extracted `Fields` (moved into the `Response`) is released twice: a double-free
// the debug allocator catches as an unknown-handle trap.
//
// The consuming-receiver classification keys on a monomorphization-invariant
// method identity; keying on the mangled name (with type args) made the generic
// `Result::unwrap` never match, leaving the spurious drop. This mirrors
// package-gale's `load_and_merge`, which drove the original trap.

use { Request, Response, ErrorCode, Fields, FieldName, FieldValue, Trailers } from "wasi:http";

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    let name = "x-probe" as FieldName;
    let entries: List<[FieldName, FieldValue]> = [[name, [118 as u8] as FieldValue]];
    let r = Fields::from_list(entries);
    if let Err(_) = r {
        task return Result::<Response, ErrorCode>::Err(ErrorCode::InternalError(null));
        return;
    }
    let headers = r.unwrap();

    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [response, _tx_future] = Response::new(headers, null, trailers_future);
    task return Result::<Response, ErrorCode>::Ok(response);
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

__DATA__
{"wasi:http/service": {"status": 200}}
