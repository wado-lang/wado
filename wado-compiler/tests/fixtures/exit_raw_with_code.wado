// Test: the raw `wasi:cli/exit#exit-with-code` interface call, bypassing the
// `core:cli::exit` helper, exits with the given status code.
use { println, Stdout } from "core:cli";
use { Exit } from "wasi:cli";

export fn run() with Stdout, Exit {
    println("before");
    Exit::exit_with_code(7);
}

__DATA__
{
    "stdout": "before\n",
    "exit_code": 7,
    "trapped": false
}
