use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut arr: Array<u64> = [];
    arr.append(10000000000 as u64);
    arr.append(20000000000 as u64);
    arr.append(30000000000 as u64);

    for let x of arr {
        println(`{x}`);
    }
}

__DATA__
{"stdout": "10000000000\n20000000000\n30000000000\n"}
