// Gap: `&<ident>` renders nothing, for the reason a bare identifier in the same
// position does — the scanner cannot yet tell `&value` from `&fn_name`.

fn deref(v: &i32) -> i32 {
    return *v;
}

export fn run() {
    let a = 7;
    assert deref(&a) == 99;
}

__DATA__
{
    "trapped": true,
    "stderr_contains": ["deref(&a): 7", "a: 7"]
}
