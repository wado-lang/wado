// Closure body that combines `if let` pattern matching with a template
// string. `synthesis::template::expand_templates` switches to a
// closure-scoped local allocator when descending into the closure body
// (mirroring `lower::translate::pattern::lower_expr`), so the `__r`
// String builder no longer collides with the elaborator-allocated `result`
// / `e` locals. The closure's return type also stays `Unit` even though
// the `if let Err(e)` arm calls `panic(…)`, so the `run_with<T>`
// monomorphisation binds `T = ()` and execution falls through to
// `println("ok")` when the parse succeeds.

use { Stdout, println } from "core:cli";

struct Err1 {
    message: String,
}

fn parse(input: &String) -> Result<i32, Err1> {
    if input.len() == 0 {
        return Result::<i32, Err1>::Err(Err1 { message: "empty" });
    }
    return Result::<i32, Err1>::Ok(input.len());
}

fn run_with<T>(f: fn() -> T) -> T {
    return f();
}

export fn run() with Stdout {
    let sql = "select 1";
    let _ = run_with(|| {
        let result = parse(&sql);
        if let Err(e) = result {
            panic(`Parse error: {e.message}`);
        }
    });
    println("ok");
}

__DATA__
{"stdout_contains": ["ok"]}
