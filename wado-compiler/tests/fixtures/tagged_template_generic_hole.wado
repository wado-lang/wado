// A hole that mentions the enclosing item's type parameter makes the template
// shape open, and each instantiation reaches the tag with its concrete shape
// (WEP 2026-01-10's roadmap).
use { println, Stdout } from "core:cli";

fn count<T: ReflectTemplate<Holes = [..V]>, ..V: Display>(t: T) -> String {
    let mut out = "";
    for let h of ReflectTemplate::<T>::members() {
        out.push_str(h.lit());
        out.push_str(&"=");
        h.fmt(&t, &mut Formatter::new(&mut out));
        out.push_str(&"|");
    }
    return out;
}

// Reads each hole's value through `get`, which groups the holes by type: `X`
// and `Y` share one group only once both are `i32`.
fn values<T: ReflectTemplate<Holes = [..V]>, ..V: Display>(t: T) -> String {
    let mut out = "";
    for let h of ReflectTemplate::<T>::members() {
        out.push_str(&`${h.get(&t)};`);
    }
    return out;
}

fn got<X: Display, Y: Display>(x: X, y: Y) -> String {
    return values`${x}${y}${x}`;
}

fn wrap<X: Display>(x: X) -> String {
    return count`a${x}b${x:>4}`;
}

fn both<X: Display, Y: Display>(x: X, y: Y) -> String {
    return count`${x}${y}${1}`;
}

fn formatted<X: Display>(x: X) -> String {
    return format`<${x}>`;
}

fn nested<X: Display>(x: X) -> String {
    return wrap(formatted(x));
}

// A shape substituted twice: `wrap`'s `X` is `outer`'s `Y`, then `i64`.
fn outer<Y: Display>(y: Y) -> String {
    return wrap(y);
}

fn specs<X: LowerHex + Display>(x: X, xs: List<X>) -> String {
    return format`${x:#x} ${xs:?} ${x:>3}`;
}

export fn run() with Stdout {
    println(wrap(5));
    println(wrap("hi"));
    println(both(1, "two"));
    println(both(true, 'c'));
    println(formatted(3.5));
    println(nested(7));
    println(outer(9 as i64));
    println(specs(255, [1, 2]));
    println(got(1, 2));
    println(got("s", 3));
    // The shape `wrap(5)` substitutes to, written: one type, one tag instance.
    let x = 6;
    println(count`a${x}b${x:>4}`);
}

__DATA__
{"stdout": "a=5|b=   5|\na=hi|b=  hi|\n=1|=two|=1|\n=true|=c|=1|\n<3.5>\na=<7>|b= <7>|\na=9|b=   9|\n0xff [1, 2] 255\n1;2;1;\ns;3;s;\na=6|b=   6|\n"}
