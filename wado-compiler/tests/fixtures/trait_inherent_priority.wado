// Test: inherent method takes priority over trait method with same name
use { println, Stdout } from "core:cli";

trait Greet {
    fn greet(&self) -> String;
}

struct Robot {
    id: i32,
}

// Inherent impl
impl Robot {
    fn greet(&self) -> String {
        return `Beep boop, I am Robot #{self.id}`;
    }
}

// Trait impl (should NOT be called when calling robot.greet())
impl Greet for Robot {
    fn greet(&self) -> String {
        return `Hello from Greet trait, Robot #{self.id}`;
    }
}

export fn run() with Stdout {
    let r = Robot { id: 42 };
    // Should call inherent method, not trait method
    println(r.greet());
}

__DATA__
{"stdout": "Beep boop, I am Robot #42\n"}
