// Test that C-style for loop variables have per-iteration scope binding
// Store closures and call them AFTER the loop to verify each captured its own value
// If all closures share the same binding, they would all return the final value (5)
use { println, Stdout } from "core:cli";

fn call_fn(f: fn(i32) -> i32, x: i32) -> i32 {
    return f(x);
}

fn run() with Stdout {
    let mut closures: Array<fn(i32) -> i32> = [];

    // Create closures in the loop - each should capture its own iteration's value
    for let mut i = 0; i < 5; i += 1 {
        let captured = i;  // Capture current value
        let get_captured = |_: i32| captured;
        closures.append(get_captured);
    }

    // Call closures AFTER the loop completes
    // If loop vars have per-iteration binding: 0,1,2,3,4
    // If loop vars share a single binding: 5,5,5,5,5 (or similar)
    let r0 = call_fn(closures[0], 0);
    let r1 = call_fn(closures[1], 0);
    let r2 = call_fn(closures[2], 0);
    let r3 = call_fn(closures[3], 0);
    let r4 = call_fn(closures[4], 0);

    println(`{r0},{r1},{r2},{r3},{r4}`);
}

__DATA__
{"stdout": "0,1,2,3,4\n"}
