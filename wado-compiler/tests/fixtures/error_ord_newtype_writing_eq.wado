// A newtype writing `eq` alone has no `Ord`: its base's would order values
// the written `eq` does not tell apart. So does a newtype over it, and
// `cmp` must be written beside `eq` to compare.

struct Point {
    x: i32,
    y: i32,
}

type Tagged = Point;

impl Eq for Tagged {
    fn eq(&self, other: &Self) -> bool {
        return self.x == other.x;
    }
}

type Relabeled = Tagged;

// An `Eq` at another `Rhs` is no `==` between two values, so `Coarse`'s `eq`
// still decides.
type Finer = Coarse;

impl Eq<f64> for Finer {
    fn eq(&self, other: &f64) -> bool {
        return *self as Coarse as f64 == *other;
    }
}

type Coarse = f64;

impl Eq for Coarse {
    fn eq(&self, other: &Self) -> bool {
        return f64::round(*self as f64) == f64::round(*other as f64);
    }
}

fn least<T: Ord>(a: T, b: T) -> T {
    return if a < b { a } else { b };
}

test {
    let a = Point { x: 1, y: 2 } as Tagged;
    let b = Point { x: 1, y: 3 } as Tagged;
    let _ = a < b;
    let _ = least(a, b);
    let _ = a.cmp(&b);
    let _ = least(a as Relabeled, b as Relabeled);
    let c: Coarse = builtin::black_box(1.2);
    let _ = c > 2.0;
    let _ = c.cmp(&c);
    let f: Finer = builtin::black_box(1.2);
    let _ = f < f;
}

__DATA__
{
    "compile_error": ":45:13: analysis error: operator `<` cannot be applied to type `Tagged`: type does not implement `Ord`\n  note: `Tagged` writes `eq`, so no `Ord` is derived for it; write `cmp` beside it",
    "compile_errors_contains": [
        "type 'Tagged' does not implement trait 'Ord' required by bound on 'T'\n  note: `Tagged` writes `eq`",
        "no method 'cmp' found on type 'Tagged'; `Tagged` writes `eq`",
        "type 'Relabeled' does not implement trait 'Ord' required by bound on 'T'\n  note: `Tagged` writes `eq`",
        "operator `>` cannot be applied to type `Coarse`: type does not implement `Ord`\n  note: `Coarse` writes `eq`",
        "no method 'cmp' found on type 'Coarse'; `Coarse` writes `eq`",
        "operator `<` cannot be applied to type `Finer`: type does not implement `Ord`\n  note: `Coarse` writes `eq`"
    ]
}
