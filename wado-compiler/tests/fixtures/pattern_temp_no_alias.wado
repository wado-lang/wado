// A destructure reads its scrutinee through a temp, and that temp is where the
// copy lands — the per-binding `Let`s share its storage. Skip it and every
// binding aliases the source.

struct S {
    items: List<i32>,
}

struct Holder {
    s: S,
}

variant V {
    A(List<i32>),
    B,
}

test "a let-destructure binding does not alias its source" {
    let mut src = S { items: [1] };
    let S { items } = src;
    src.items.push(2);
    assert items.len() == 1;
}

test "a match-arm binding does not alias its scrutinee" {
    let mut h = Holder { s: S { items: [1] } };
    match h.s {
        S { items } => {
            h.s.items.push(3);
            assert items.len() == 1;
        }
    }
}

test "a match-arm binding does not alias a local scrutinee" {
    let mut s = S { items: [1] };
    match s {
        S { items } => {
            s.items.push(2);
            assert items.len() == 1;
        }
    }
}

test "a variant payload binding does not alias a local scrutinee" {
    let mut v = V::A([1]);
    match v {
        V::A(xs) => {
            v = V::A([9, 9]);
            assert xs.len() == 1;
        }
        V::B => {}
    }
}

test "a tuple destructure binding does not alias its source" {
    let mut src: [i32, List<i32>] = [1, [2]];
    let [a, rest] = src;
    src.1.push(9);
    assert a == 1;
    assert rest.len() == 1;
}
