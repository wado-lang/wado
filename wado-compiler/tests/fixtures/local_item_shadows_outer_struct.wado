// A local struct shadows a same-named module-level one for its block only,
// and the two layouts must not be confused. Regression test for a bug where
// the ephemeral per-function local-item registry (bare-name-keyed, mutated in
// place as annotate walks the function) had unconditional lookup precedence
// even for reify's later, separate pass — so a struct value built from the
// *outer* `Point` silently reified against the *local* struct's field layout
// (wrong field indices) instead of the outer one's.

struct Point {
    x: i32,
    y: i32,
    z: i32,
}

test "a local struct shadows the module-level one for its block only" {
    let outer = Point { x: 1, y: 2, z: 3 };
    if outer.x == 1 {
        // Hoisted: the local `Point` owns this whole block, so `early` reads
        // the local layout even though the declaration comes after it.
        let early = Point { z: 60, y: 50, x: 40 };
        struct Point {
            z: i32,
            y: i32,
            x: i32,
        }
        let inner = Point { z: 30, y: 20, x: 10 };
        assert early.x == 40;
        assert inner.x == 10;
        assert inner.y == 20;
        assert inner.z == 30;
    }
    // The block has closed, so `Point` is the module-level one again.
    let after = Point { x: 7, y: 8, z: 9 };
    assert outer.x == 1;
    assert outer.y == 2;
    assert outer.z == 3;
    assert after.z == 9;
}
