// For-of loop with side-effecting iterable expression
// The iterable should be evaluated exactly once

use { println, Stdout } from "core:cli";

fn get_numbers() -> Array<i32> with Stdout {
    println("getting numbers");
    return [1, 2, 3];
}

export fn run() with Stdout {
    for let n of get_numbers() {
        println(`{n}`);
    }
    println("done");
}

__DATA__
{"stdout": "getting numbers\n1\n2\n3\ndone\n"}
