// A dominating `if 0 <= i && i < xs.len()` proves both halves of the index
// contract `0 <= index < self.len()`, so the check inside it is eliminated.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn at_or_zero(xs: &List<i32>, i: i32) -> i32 {
    if 0 <= i && i < xs.len() {
        return xs[i];
    }
    return 0;
}

export fn run() with Stdout {
    let xs: List<i32> = [10, 20, 30];
    println(`${at_or_zero(&xs, builtin::black_box(1))} ${at_or_zero(&xs, builtin::black_box(-1))} ${at_or_zero(&xs, builtin::black_box(3))}`);
}

__DATA__
{
    "stdout": "20 0 0\n",
    "wir_scope": "at_or_zero",
    "wir_expect:O2": [
        "builtin::array_get_value<i32>("
    ],
    "wir_not_expect:O2": [
        "cold_path"
    ]
}
