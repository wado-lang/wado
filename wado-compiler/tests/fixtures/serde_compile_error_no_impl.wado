// Test: compile error when a struct field's type cannot be serialized.
// A plain data field would now satisfy `Serialize` structurally (bound-driven
// synthesis, WEP: Trait Derivation Policy) with no explicit impl required, so
// this uses a field type — a function — that can never implement Serialize.
use { to_string } from "core:json";

struct NoSerialize {
    cb: fn(i32) -> i32,
}

export fn run() {
    let x = NoSerialize { cb: |v: i32| v };
    let r = to_string::<NoSerialize>(&x);
}

__DATA__
{"compile_error": "does not implement trait 'Serialize'"}
