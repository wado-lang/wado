// A written `From` impl that a provided conversion already answers is
// rejected: the cast would run, never its body.

type Meters = i64;

impl From<i64> for Meters {
    fn from(v: i64) -> Meters {
        return (v * 1000) as Meters;
    }
}

struct Point {
    x: i32,
}

impl From<Point> for Point {
    fn from(p: Point) -> Point {
        return p;
    }
}

test {
}

