// Test: nested generics with trait bounds violation — Array<Array<Foo>> where Foo doesn't impl Eq
variant NoEq {
    A(i32),
    B,
}

struct Foo {
    x: NoEq,
}

export fn run() {
    // Foo doesn't implement Eq (NoEq variant field), so Array<Foo> doesn't implement Eq,
    // so Array<Array<Foo>> == ... should fail
    let a: Array<Array<Foo>> = [[Foo { x: NoEq::A(1) }]];
    let b: Array<Array<Foo>> = [[Foo { x: NoEq::A(1) }]];
    assert a == b;
}

__DATA__
{"compile_error": "=="}
