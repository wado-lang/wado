// Each `Tree::Empty` leaves `Tree`'s parameter open, and the call's argument
// check makes both the receiver's: one unknown, reported once.

variant Tree<T> { Leaf(T), Empty }

test {
    assert Tree::eq(&Tree::Empty, &Tree::Empty);
}

