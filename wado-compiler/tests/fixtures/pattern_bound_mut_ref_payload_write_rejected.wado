// A `&mut` scrutinee binds a payload by reference. The reference to a payload
// that assignment replaces is a fresh box, so a whole-value write through it
// would be lost.

variant Shape {
    Circle(i32),
    Dot,
}

test "a write through a payload binding" {
    let mut held: Option<Shape> = Option::Some(Shape::Circle(1));
    if let Some(shape) = &mut held {
        *shape = Shape::Dot;
    }
}

__DATA__
{
    "test": {},
    "compile_error": "is a detached copy, so a whole-value write through it would be lost"
}
