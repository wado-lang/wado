// `N::make()` names what `N` answers with among what this module can name.
// `Shown` answers at `N` itself, but it is not imported here, so it does not
// hide `Base`'s own static a link below.
use { N } from "./sub/type_qualified_out_of_scope_trait_lib.wado";

test "a trait the call site cannot name answers nothing" {
    assert N::make() == 9;
}
