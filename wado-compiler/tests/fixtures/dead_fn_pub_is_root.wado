// A `pub fn` with no in-package caller is not dead: since the 2026-06-25
// visibility redesign, `pub` crosses the package boundary (the Wado-native
// library API) exactly like `export` crosses the CM boundary, so it is a
// liveness root.
pub fn library_api() -> i32 {
    return 1;
}

export fn run() {}

