use { println, Stdout } from "core:cli";

// from coerce_int_literal_bitwise_i128.wado
fn check(cond: bool, label: String) {
    if !cond {
        panic(label);
    }
}

// from coerce_int_literal_bitwise_i128.wado
fn coerce_int_literal_bitwise_i128() with Stdout {
    let x_u128: u128 = 0xFF00;
    let x_i128: i128 = 0xFF;

    // & with literal on both sides
    let a1 = x_u128 & 0xFF;
    check(a1 == 0 as u128, "u128 & rhs");
    let a2 = 0xFF & x_u128;
    check(a2 == 0 as u128, "lhs & u128");
    let a3 = x_i128 & 0x0F;
    check(a3 == 0x0F as i128, "i128 & rhs");
    let a4 = 0x0F & x_i128;
    check(a4 == 0x0F as i128, "lhs & i128");

    // | with literal on both sides
    let b1 = x_u128 | 0xFF;
    check(b1 == 0xFFFF as u128, "u128 | rhs");
    let b2 = 0xFF | x_u128;
    check(b2 == 0xFFFF as u128, "lhs | u128");
    let b3 = x_i128 | 0x100;
    check(b3 == 0x1FF as i128, "i128 | rhs");
    let b4 = 0x100 | x_i128;
    check(b4 == 0x1FF as i128, "lhs | i128");

    // ^ with literal on both sides
    let c1 = x_u128 ^ 0xFFFF;
    check(c1 == 0x00FF as u128, "u128 ^ rhs");
    let c2 = 0xFFFF ^ x_u128;
    check(c2 == 0x00FF as u128, "lhs ^ u128");
    let c3 = x_i128 ^ 0xFF;
    check(c3 == 0 as i128, "i128 ^ rhs");
    let c4 = 0xFF ^ x_i128;
    check(c4 == 0 as i128, "lhs ^ i128");

    println("ok");
}

// from coerce_int_literal_chained_comparison.wado
fn coerce_int_literal_chained_comparison() with Stdout {
    let x_u64: u64 = 50;
    let x_i64: i64 = -5;
    let x_u8: u8 = 128;
    let x_i8: i8 = -10;

    // Chained: literal < var < literal
    assert 0 < x_u64 < 100;
    assert -10 < x_i64 < 0;
    assert 100 < x_u8 < 200;
    assert -20 < x_i8 < 0;

    // Chained: literal <= var <= literal
    assert 50 <= x_u64 <= 50;
    assert -5 <= x_i64 <= -5;
    assert 128 <= x_u8 <= 128;
    assert -10 <= x_i8 <= -10;

    // Chained: literal < var <= literal
    assert 0 < x_u64 <= 50;
    assert -10 < x_i64 <= -5;

    // Chained: literal <= var < literal
    assert 50 <= x_u64 < 100;
    assert -5 <= x_i64 < 0;

    // Chained: var > literal > ...  (descending)
    assert 100 > x_u64 > 0;
    assert 0 > x_i64 > -10;

    // Negated chain should work too
    assert !(0 < x_u64 < 10);
    assert !(0 < x_i64);

    println("ok");
}

// from coerce_int_literal_comparison.wado
fn coerce_int_literal_comparison() with Stdout {
    let x_u64: u64 = 100;
    let x_i64: i64 = -50;
    let x_u8: u8 = 42;
    let x_i8: i8 = -10;

    // == with literal on rhs
    assert x_u64 == 100;
    assert x_i64 == -50;
    assert x_u8 == 42;
    assert x_i8 == -10;

    // == with literal on lhs
    assert 100 == x_u64;
    assert -50 == x_i64;
    assert 42 == x_u8;
    assert -10 == x_i8;

    // != with literal on rhs
    assert x_u64 != 99;
    assert x_i64 != 0;
    assert x_u8 != 0;
    assert x_i8 != 0;

    // != with literal on lhs
    assert 99 != x_u64;
    assert 0 != x_i64;
    assert 0 != x_u8;
    assert 0 != x_i8;

    // < with literal on rhs
    assert x_u64 < 101;
    assert x_i64 < 0;
    assert x_u8 < 43;
    assert x_i8 < 0;

    // < with literal on lhs
    assert 99 < x_u64;
    assert -51 < x_i64;
    assert 41 < x_u8;
    assert -11 < x_i8;

    // > with literal on rhs
    assert x_u64 > 99;
    assert x_i64 > -51;
    assert x_u8 > 41;
    assert x_i8 > -11;

    // > with literal on lhs
    assert 101 > x_u64;
    assert 0 > x_i64;
    assert 43 > x_u8;
    assert 0 > x_i8;

    // <= with literal on rhs
    assert x_u64 <= 100;
    assert x_u64 <= 101;
    assert x_i64 <= -50;
    assert x_i64 <= 0;

    // <= with literal on lhs
    assert 100 <= x_u64;
    assert 99 <= x_u64;
    assert -50 <= x_i64;
    assert -51 <= x_i64;

    // >= with literal on rhs
    assert x_u64 >= 100;
    assert x_u64 >= 99;
    assert x_i64 >= -50;
    assert x_i64 >= -51;

    // >= with literal on lhs
    assert 100 >= x_u64;
    assert 101 >= x_u64;
    assert -50 >= x_i64;
    assert 0 >= x_i64;

    println("ok");
}

export fn run() with Stdout {
    coerce_int_literal_bitwise_i128();
    coerce_int_literal_chained_comparison();
    coerce_int_literal_comparison();
}

__DATA__
{"stdout": "ok\nok\nok\n"}
