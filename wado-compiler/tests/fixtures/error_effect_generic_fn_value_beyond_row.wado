// The expected type settles `E` to no effect, so the closure handed to the
// value may perform none.

use { println } from "core:cli";

fn apply<effect E>(f: fn() with E) with E {
    f();
}

export fn run() {
    let pure: fn(fn()) = apply;
    pure(|| { println("x"); });
}

