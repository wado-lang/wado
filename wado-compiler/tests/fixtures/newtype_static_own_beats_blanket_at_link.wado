// A blanket sits at the link where its bound holds: `Eq` is derived for `Base`,
// so the blanket covers `N` at `Base`'s link, where `Base`'s own declaration
// outranks it. `N::mk()` is `Base::mk`.

struct Base {
    v: i32,
}

impl Base {
    fn mk() -> i32 {
        return 1;
    }
}

trait Mk {
    fn mk() -> i32;
}

impl<T: Eq> Mk for T {
    fn mk() -> i32 {
        return 2;
    }
}

type N = Base;

test {
    assert N::mk() == 1;
}

__DATA__
{"test": {}}
