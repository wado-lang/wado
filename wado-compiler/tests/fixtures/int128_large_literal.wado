// Test large integer literals for i128/u128 (values > u64::MAX)
use {println, Stdout} from "core:cli";

fn run() with Stdout {
    // Large u128 literal via coercion (larger than u64::MAX = 18446744073709551615)
    let large_u128: u128 = 18446744073709551616; // u64::MAX + 1
    println(`large_u128 = {large_u128.to_string()}`);

    // Maximum u128 via coercion
    let max_u128: u128 = 340282366920938463463374607431768211455;
    println(`max_u128 = {max_u128.to_string()}`);

    // Large i128 literal via coercion (larger than i64::MAX = 9223372036854775807)
    let large_i128: i128 = 9223372036854775808; // i64::MAX + 1
    println(`large_i128 = {large_i128.to_string()}`);

    // Maximum i128 via coercion
    let max_i128: i128 = 170141183460469231731687303715884105727;
    println(`max_i128 = {max_i128.to_string()}`);

    // Minimum i128 via coercion (negative)
    let min_i128: i128 = -170141183460469231731687303715884105728;
    println(`min_i128 = {min_i128.to_string()}`);

    // Large literal with cast
    let cast_u128 = 18446744073709551616 as u128;
    println(`cast_u128 = {cast_u128.to_string()}`);

    let cast_i128 = 9223372036854775808 as i128;
    println(`cast_i128 = {cast_i128.to_string()}`);

    // Negative large literal with cast
    let neg_cast_i128 = -170141183460469231731687303715884105728 as i128;
    println(`neg_cast_i128 = {neg_cast_i128.to_string()}`);

    // Underscores in large literals should work
    let with_underscores: u128 = 340_282_366_920_938_463_463_374_607_431_768_211_455;
    println(`with_underscores = {with_underscores.to_string()}`);
}

__DATA__
{"stdout": "large_u128 = 18446744073709551616\nmax_u128 = 340282366920938463463374607431768211455\nlarge_i128 = 9223372036854775808\nmax_i128 = 170141183460469231731687303715884105727\nmin_i128 = -170141183460469231731687303715884105728\ncast_u128 = 18446744073709551616\ncast_i128 = 9223372036854775808\nneg_cast_i128 = -170141183460469231731687303715884105728\nwith_underscores = 340282366920938463463374607431768211455\n"}
