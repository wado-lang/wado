// Regression: a closure body that mutates a captured binding inside a
// `for`, `while`, or `for-of` loop must still be detected as mutating
// — `collect_mutated_vars_stmt` previously fell through to the
// catch-all arm for these statements, so the `__ref_<var>` desugar
// never fired and the closure was mis-typed `fn` instead of `fn mut`.
// At runtime the mutation silently operated on a by-value copy.

test "mutation inside c-style for" {
    let mut count = 0;
    let mut inc = || {
        for let mut i = 0; i < 3; i += 1 {
            count += 1;
        }
    };
    inc();
    assert count == 3;
}

test "mutation inside while" {
    let mut total = 0;
    let mut add_until = |limit: i32| {
        let mut n = 0;
        while n < limit {
            total += n;
            n += 1;
        }
    };
    add_until(4);
    assert total == 6;
}

test "mutation inside for-of" {
    let mut sum = 0;
    let items: Array<i32> = [10, 20, 30];
    let mut accumulate = || {
        for let v of items {
            sum += v;
        }
    };
    accumulate();
    assert sum == 60;
}

test "mutation inside labeled block" {
    let mut tally = 0;
    let mut bump = || {
        outer: {
            tally += 5;
            break outer;
        }
    };
    bump();
    bump();
    assert tally == 10;
}

__DATA__
{"test": {}}
