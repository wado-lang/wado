// A view built and read in one function must leave no aggregate behind. The
// identity cast `as_byte_slice()` returns through is what used to hide the
// slice literal from `sroa`.
export fn run() {
    let text = builtin::black_box("banana");
    assert count_byte(&text, b'a') == 3;
}

fn count_byte(s: &String, needle: u8) -> i32 {
    let view = s.as_byte_slice();
    let mut n = 0;
    for let mut i = 0; i < view.len(); i += 1 {
        if view.get_unchecked(i) == needle {
            n += 1;
        }
    }
    return n;
}

__DATA__
{
    "wir_scope": "$cm_export__run",
    "wir_not_expect:O2": ["struct.new \"core:prelude/slice.wado//Slice<u8>\""]
}
