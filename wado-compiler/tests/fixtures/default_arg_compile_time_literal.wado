// Regression: `#include_str`, `#include_bytes` and `#data` in a default read
// the file that wrote them. Keyed by the module taking the default instead,
// an include resolved to nothing — "file not found" at a path that exists
// beside its author — and a caller with no `__DATA__` of its own saw the
// program rejected outright.
//
// `#file` / `#line` / `#function` go the other way on purpose and report the
// call site; `default_arg_location_call_site.wado` pins that.

use { println, Stdout } from "core:cli";
use { text, bytes, section } from "./sub/default_arg_compile_time_literal_lib.wado";

export fn run() with Stdout {
    assert text() == "Hello, World!\n";
    assert bytes().len() == 14;
    assert section() == "callee-section\n";
    println("ok");
}

__DATA__
{"stdout": "ok\n"}
