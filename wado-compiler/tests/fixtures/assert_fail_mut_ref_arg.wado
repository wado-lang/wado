// Power-assert keeps a `&mut <expr>` argument's operand in place: extracted
// into an immutable `let $v`, the call could not take `&mut $v`.

fn flip(b: &mut bool) -> bool {
    *b = !*b;
    return *b;
}

export fn run() {
    let mut visiting = false;
    assert flip(&mut visiting);
}

