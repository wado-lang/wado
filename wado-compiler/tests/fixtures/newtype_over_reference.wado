// A newtype over a reference is that reference's slot once erased: boxed where
// a reference to it is taken, and compared as the reference's pointee is.

struct P {
    x: i32,
}

type R = &i32;
type H = &mut P;

test "a reference to a newtype over a reference reads through both" {
    let a = 1;
    let b = 2;
    let ra = &a as R;
    let rra = &ra;
    let c = &b;
    let cc = &c;
    assert *(*rra as &i32) == 1;
    assert **cc == 2;
}

test "== on a newtype over a reference compares the pointees" {
    let mut a = P { x: 1 };
    let mut b = P { x: 1 };
    let mut c = P { x: 2 };
    let ha = &mut a as H;
    let hb = &mut b as H;
    let hc = &mut c as H;
    assert ha == hb;
    assert ha != hc;
}

__DATA__
{"test": {}}
