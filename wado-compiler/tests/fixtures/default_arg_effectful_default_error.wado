// Test: function parameter default cannot perform effects.

use { println, Stdout } from "core:cli";

fn noisy() -> i32 with Stdout {
    println("side effect");
    return 42;
}

fn greet(value: i32 = noisy()) -> i32 with Stdout {
    return value;
}

export fn run() with Stdout {
    let x = greet();
    assert x == 42;
}

__DATA__
{"compile_error": "default"}
