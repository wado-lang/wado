// A serde derive on a struct too wide for the duplicate-field bitmask.
//
// Deserialization records which fields the wire wrote in one `i64`, one bit
// each, so duplicates can be rejected without confusing "the wire set this"
// with "this is the declared default". 65 fields do not fit, and the derive
// refuses rather than leaving the check to fail at run time.

use { Deserialize } from "core:serde";

struct Wide {
    f0: i32 = 0,
    f1: i32 = 0,
    f2: i32 = 0,
    f3: i32 = 0,
    f4: i32 = 0,
