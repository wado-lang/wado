// Test unary negation on float types

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let x = -2.5;
    let y = -1.0 + 3.5;
    let z = -(4.0 + 2.0);
    println(`x = ${x}`);
    println(`y = ${y}`);
    println(`z = ${z}`);
}

__DATA__
{"stdout": "x = -2.5\ny = 2.5\nz = -6\n"}
