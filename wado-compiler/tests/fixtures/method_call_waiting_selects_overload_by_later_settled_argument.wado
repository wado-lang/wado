// A waiting call selects among one trait's overloads by an argument whose own
// type a later use settles, read as it stands when the receiver settles.

struct Bx<T> { v: Option<T> }

fn empty<T>() -> Bx<T> { return Bx { v: null }; }

trait Take<A> with () {
    fn take(&self, a: A) -> i32;
}

impl Take<Bx<String>> for Bx<i32> {
    fn take(&self, a: Bx<String>) -> i32 { return 1; }
}

impl Take<Bx<i32>> for Bx<i32> {
    fn take(&self, a: Bx<i32>) -> i32 { return 2; }
}

impl Take<i32> for Bx<bool> {
    fn take(&self, a: i32) -> i32 { return 3; }
}

test {
    let b = empty();
    let a = empty();
    let n = b.take(a);
    let _arg: Bx<String> = a;
    let _settled: Bx<i32> = b;
    assert n == 1;
}
