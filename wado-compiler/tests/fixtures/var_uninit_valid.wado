// Valid patterns for uninitialized variable declarations: a read is valid when
// every path reaching it has assigned the variable.
// Type annotation is required when there is no initializer.

// Pattern 1: declare then assign then use in sequence
test "declare, assign, use" {
    let x: i32;
    x = 42;
    assert x == 42;
}

// Pattern 2: assign in both branches of if-else, then use
test "if-else both branches assign" {
    let result: i32;
    let cond = true;
    if cond {
        result = 1;
    } else {
        result = 2;
    }
    assert result == 1;
}

// Pattern 3: assign in all arms of match, then use
test "match all arms assign" {
    let x: i32;
    let opt: Option<i32> = Option::Some(10);
    match opt {
        Some(v) => { x = v; },
        None => { x = 0; },
    };
    assert x == 10;
}

// Pattern 4: let mut — declare then assign, then reassign
test "mut: declare then assign then reassign" {
    let mut x: i32;
    x = 1;
    x = 2;
    assert x == 2;
}

// Pattern 5: nested if-else, all paths assign
test "nested if-else all paths assign" {
    let x: i32;
    let a = true;
    let b = false;
    if a {
        if b {
            x = 1;
        } else {
            x = 2;
        }
    } else {
        x = 3;
    }
    assert x == 2;
}

// Pattern 6: assign *before* the loop, then use inside and after the loop.
// (A `while` body may not run, so assigning there would not count.)
test "assign before loop, use inside loop" {
    let mut x: i32;
    let mut i = 0;
    x = 0;  // guaranteed assignment happens before the loop
    while i < 3 {
        x = x + 1;
        i = i + 1;
    }
    assert x == 3;
}

// Pattern 7: f64
test "f64 uninit then assign" {
    let y: f64;
    y = 3.14;
    assert y > 3.0;
}

// Pattern 8: bool uninit then assign in if-else
test "bool uninit assigned in if-else" {
    let flag: bool;
    if 1 > 0 {
        flag = true;
    } else {
        flag = false;
    }
    assert flag;
}

// Pattern 9: String uninit then assign
test "String uninit then assign" {
    let s: String;
    s = "hello";
    assert s.len() == 5;
}

// Pattern 10: String uninit assigned in if-else
test "String uninit assigned in if-else" {
    let greeting: String;
    let formal = false;
    if formal {
        greeting = "Good day.";
    } else {
        greeting = "Hi!";
    }
    assert greeting.len() == 3;
}

// Pattern 11: a `loop` ends only through a `break`, so what every break
// assigns is assigned after it, an immutable variable included.
test "loop assigns before each break" {
    let x: i32;
    let mut i = 0;
    loop {
        i += 1;
        if i == 3 {
            x = i;
            break;
        }
    }
    assert x == 3;
}

// Pattern 12: a branch that leaves by `return`, `break` or `continue` never
// reaches what follows, so it need not assign.
fn first_or_zero(opt: Option<i32>) -> i32 {
    let x: i32;
    match opt {
        Some(v) => { x = v; },
        None => { return 0; },
    };
    return x;
}

test "a diverging branch need not assign" {
    assert first_or_zero(Some(4)) == 4;
    assert first_or_zero(null) == 0;

    let mut sum = 0;
    for let i of 0..<4 {
        let x: i32;
        if i % 2 == 0 {
            x = i;
        } else {
            continue;
        }
        sum += x;
    }
    assert sum == 2;
}

// Pattern 13: a labeled block assigns on every path that leaves it.
test "labeled block assigns before each break" {
    let x: i32;
    done: {
        if builtin::black_box(true) {
            x = 1;
            break done;
        }
        x = 2;
    }
    assert x == 1;
}

// Pattern 14: once assigned, the variable is captured like any other.
test "capture after initialization" {
    let x: i32;
    x = 5;
    let add = |n: i32| n + x;
    assert add(1) == 6;
}

// Pattern 15: code no path reaches reads nothing.
fn after_return() -> i32 {
    return 1;
    let y: i32;
    return y;
}

test "unreachable read" {
    assert after_return() == 1;
}

// Pattern 16: a let chain's block runs only when every element ran.
test "let chain assigns before its block" {
    let x: i32;
    let o = builtin::black_box(Option::Some(3));
    if let Some(v) = o && match v { _ => { x = v; true } } {
        assert x == 3;
    }
}

// Pattern 17: the block an `&&` condition guards runs only when the right
// side ran.
test "short-circuit assigns before its block" {
    let x: i32;
    let c = builtin::black_box(true);
    if c && done: { x = 1; true } {
        assert x == 1;
    }
}

// Pattern 18: a guard's assignments reach the arm it guards.
test "guard assigns before its arm" {
    let x: i32;
    let o = builtin::black_box(Option::Some(2));
    let y = match o {
        Some(n) && n > 0 && done: { x = n; true } => x,
        _ => 0,
    };
    assert y == 2;
}

// Pattern 19: a `for` without a condition, like `loop`, ends only through a
// `break`.
test "conditionless for assigns before each break" {
    let x: i32;
    let mut i = 0;
    for ;; {
        i += 1;
        if i == 3 {
            x = i;
            break;
        }
    }
    assert x == 3;
}
