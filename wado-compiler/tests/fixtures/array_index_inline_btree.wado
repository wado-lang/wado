// Minimal B-tree-like structure to test multiple method inlining
// Attempts to reproduce the treemap local tracking issue

use { println, Stdout } from "core:cli";

struct Node<K> {
    keys: Array<K>,
    deleted: Array<bool>,
}

impl<K> Node<K> {
    fn count_active(&self) -> i32 {
        let mut count = 0;
        for let mut i = 0; i < self.keys.len(); i += 1 {
            if !self.deleted[i] {
                count += 1;
            }
        }
        return count;
    }

    fn is_full(&self, max_keys: i32) -> bool {
        let mut count = 0;
        for let mut i = 0; i < self.keys.len(); i += 1 {
            if !self.deleted[i] {
                count += 1;
            }
        }
        return count >= max_keys;
    }

    fn find_index(&self, key: &K) -> i32 {
        let mut i = 0;
        while i < self.keys.len() && self.keys[i] < *key {
            i += 1;
        }
        return i;
    }
}

struct Tree<K> {
    root: Node<K>,
    max_keys: i32,
}

impl<K> Tree<K> {
    fn check(&self) -> i32 {
        // Multiple calls to methods that should be inlined
        let active = self.root.count_active();
        let full = self.root.is_full(self.max_keys);
        let idx = self.root.find_index(&"cherry");

        if full {
            return active + 100;
        }
        return active + idx;
    }
}

export fn run() with Stdout {
    let tree: Tree<String> = Tree {
        root: Node {
            keys: ["apple", "banana", "cherry", "date"],
            deleted: [false, true, false, false],
        },
        max_keys: 5,
    };


    let result = tree.check();
    println(`result: {result}`);
}

__DATA__
{"stdout": "result: 5\n"}
