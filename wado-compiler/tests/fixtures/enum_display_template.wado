// Test: Enum Display fallback in template strings and match expressions
use { println, Stdout } from "core:cli";

enum Fruit {
    Apple,
    Banana,
    Cherry,
}

fn describe(f: Fruit) -> String {
    return match f {
        Apple => `I like {f}`,
        Banana => `{f} is yellow`,
        Cherry => `{f} is small`,
    };
}

export fn run() with Stdout {
    // Template string interpolation (no Display impl → inspect fallback)
    let f = Fruit::Apple;
    println(`fruit: {f}`);

    // In function using match
    println(describe(Fruit::Apple));
    println(describe(Fruit::Banana));
    println(describe(Fruit::Cherry));
}

__DATA__
{"stdout": "fruit: Fruit::Apple\nI like Fruit::Apple\nFruit::Banana is yellow\nFruit::Cherry is small\n"}
