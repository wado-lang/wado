// The bound a body-local struct's field owes is still asked once the local it
// names is stated: `B` declares no `Tag`.

trait Tag with () {}

struct Wrap<T: Tag> {
    v: T,
}

fn later() -> i32 {
    struct A {
        w: Wrap<B>,
    }
    struct B {
        x: i32,
    }
    return 0;
}

export fn run() {}

__DATA__
{
  "compile_error": ":12:12: analysis error: type 'B@13' does not implement trait 'Tag' required by bound on 'T'",
  "compile_error_codes": ["TRAIT_BOUND_NOT_SATISFIED"]
}
