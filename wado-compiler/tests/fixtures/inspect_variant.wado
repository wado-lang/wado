use { println, Stdout } from "core:cli";

variant Shape {
    Circle(f64),
    Rectangle([f64, f64]),
    Point,
}

export fn run() with Stdout {
    let c = Shape::Circle(5.0);
    println(`{c:?}`);

    let r = Shape::Rectangle([3.0, 4.0]);
    println(`{r:?}`);

    let p = Shape::Point;
    println(`{p:?}`);
}

__DATA__
{"stdout": "Shape::Circle(5.0)\nShape::Rectangle([3.0, 4.0])\nShape::Point\n"}
