use { println, Stdout } from "core:cli";

fn integer_i8_basic() with Stdout {
    let a: i8 = 10 as i8;
    let b: i8 = 3 as i8;
    let sum = a + b;
    println(`sum: ${sum}`);
    let diff = a - b;
    println(`diff: ${diff}`);
    let prod = a * b;
    println(`prod: ${prod}`);
    let quot = a / b;
    println(`quot: ${quot}`);
    let rem = a % b;
    println(`rem: ${rem}`);
}

fn integer_i8_comparison() with Stdout {
    let a: i8 = 10 as i8;
    let b: i8 = 20 as i8;
    let c: i8 = -5 as i8;
    if a < b {
        println("a < b: true");
    }
    if a <= b {
        println("a <= b: true");
    }
    if b > a {
        println("b > a: true");
    }
    if b >= a {
        println("b >= a: true");
    }
    if c < a {
        println("c < a: true");
    }
    if c < 0 as i8 {
        println("c < 0: true");
    }
    if a > c {
        println("a > c: true");
    }
    let d: i8 = 10 as i8;
    if a == d {
        println("a == d: true");
    }
    if a != b {
        println("a != b: true");
    }
}

fn integer_i8_edge() with Stdout {
    let max: i8 = 127 as i8;
    println(`max: ${max}`);
    let min: i8 = -128 as i8;
    println(`min: ${min}`);
    let neg: i8 = -50 as i8;
    let pos: i8 = 30 as i8;
    let sum = neg + pos;
    println(`neg + pos: ${sum}`);
    let div_result: i8 = -10 as i8 / 3 as i8;
    println(`-10 / 3: ${div_result}`);
    let mod_result: i8 = -10 as i8 % 3 as i8;
    println(`-10 % 3: ${mod_result}`);
}

