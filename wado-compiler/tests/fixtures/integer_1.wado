fn integer_u32_comparison() with Stdout {
    let small: u32 = 100 as u32;
    let large: u32 = 3000000000 as u32;
    let zero: u32 = 0 as u32;
    if large > small {
        println("large > small: true");
    } else {
        println("large > small: false");
    }
    if large >= small {
        println("large >= small: true");
    } else {
        println("large >= small: false");
    }
    if small < large {
        println("small < large: true");
    } else {
        println("small < large: false");
    }
    if small <= large {
        println("small <= large: true");
    } else {
        println("small <= large: false");
    }
    if large > zero {
        println("large > zero: true");
    } else {
        println("large > zero: false");
    }
    let another_large: u32 = 3000000000 as u32;
    if large == another_large {
        println("large == another_large: true");
    }
    if large != small {
        println("large != small: true");
    }
}

fn integer_u32_edge() with Stdout {
    let max: u32 = 4294967295 as u32;
    println(`max: ${max}`);
    let min: u32 = 0 as u32;
