// Error: a guard that fails passes the match on to the next arm, carrying
// what the guard assigned.

export fn run() {
    let x: i32;
    let o = builtin::black_box(1);
    match o {
        1 && match o { _ => { x = 1; false } } => {},
        _ => { x = 2; },
    }
    assert x == 2;
}

