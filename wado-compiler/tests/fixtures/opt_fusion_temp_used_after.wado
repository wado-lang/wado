// labeled_block_fusion deletes the `let x = <if-let temp>` binding when it
// fuses the consumer. It must not fuse when the temp is read again later: the
// second `if let Some(w) = x` reads `x`, so fusing the first would delete a
// binding still live at the second. The whole-function use count guards this.
use { println, Stdout } from "core:cli";

fn f(i: i32) -> Option<i32> {
    if i == 1 {
        return Option::Some(10);
    }
    return null;
}

export fn run() with Stdout {
    let mut total = 0;
    for let i of 1..<3 {
        let x = f(i);
        if let Some(v) = x {
            total += v;
        }
        if let Some(w) = x {
            total += w;
        }
    }
    println(`{total}`);
    assert total == 20;
}

__DATA__
{"stdout": "20\n"}
