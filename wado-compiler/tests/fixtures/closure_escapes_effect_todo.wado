// Closure escape must not leak effects out of the type system.
//
// `inner` has the declared type `fn()` (no effects), but its body invokes
// `println`, which requires `Stdout`. The compiler must reject this:
// the closure body's inferred effects (Stdout) cannot widen to the
// closure type's declared effect set (empty).
//
// See wep-2026-01-25-closure-implementation-internals.md, Phase 6
// (Effect-check fix).

use { println, Stdout } from "core:cli";

fn pure_caller(f: fn()) {
    f();
}

export fn run() with Stdout {
    let inner: fn() = || {
        println("this println needs Stdout but inner's type does not carry it");
    };
    pure_caller(inner);
}

__DATA__
{"compile_error": "Stdout"}
