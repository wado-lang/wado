// Test basic integer constant folding (arithmetic)
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Basic arithmetic
    let a = 21 * 2;
    println(`a={a}`);

    let b = 100 + 23;
    println(`b={b}`);

    let c = 50 - 8;
    println(`c={c}`);

    let d = 84 / 2;
    println(`d={d}`);

    let e = 10 % 3;
    println(`e={e}`);

    // Chained operations (should fold step by step)
    let f = 2 + 3 + 4;
    println(`f={f}`);

    let g = 10 * 2 + 5;
    println(`g={g}`);
}

__DATA__
{"stdout": "a=42\nb=123\nc=42\nd=42\ne=1\nf=9\ng=25\n"}
