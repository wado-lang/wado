// A block body leaves the closure's `with` row unambiguous, and it reaches the
// same diagnostic: the row is syntax the compiler does not carry yet.

interface Log {
    fn emit(message: String);
}

export fn run() {
    let f = |n: i32| -> i32 with Log { return n; };
    f(1);
}

__DATA__
{"compile_error": "a closure cannot declare `with` yet"}
