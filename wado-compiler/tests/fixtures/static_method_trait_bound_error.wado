// Calling a static method with a type argument that does not satisfy
// the trait bound should produce a compile error, not an ICE.
//
// String::from_utf8 requires I: IntoIterator<Item = u8>.
// Passing an i32 (which does not implement IntoIterator) should fail.

export fn run() {
    let _ = String::from_utf8::<i32>(42);
}

__DATA__
{"compile_error": "does not implement trait"}
