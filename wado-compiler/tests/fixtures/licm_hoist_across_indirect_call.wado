// A field read hoists across a call through a closure value as it does across a
// direct call: no closure body writes `a.items`, so `scan` reads it once,
// ahead of the loop, though each iteration hands `a` to `f`.
use { println, Stdout } from "core:cli";

struct Acc {
    items: List<i32>,
    misses: i32,
}

#[inline(never)]
fn scan(a: &mut Acc, n: i32, f: fn(&mut Acc)) -> i32 {
    let mut sum = 0;
    for let mut i = 0; i < n; i += 1 {
        let v = a.items[i % 4];
        sum += v;
        if v < 0 {
            f(a);
        }
    }
    return sum;
}

export fn run() with Stdout {
    let mut a = Acc { items: builtin::black_box([1, -1, 0, 2]), misses: 0 };
    let f: fn(&mut Acc) = builtin::black_box(|acc: &mut Acc| acc.misses += 1);
    let total = scan(&mut a, builtin::black_box(8), f);
    println(`${total} ${a.misses}`);
}

__DATA__
{
    "stdout": "4 2\n",
    "wir_scope": "licm_hoist_across_indirect_call.wado/scan",
    "wir_pass": {"O2": ["nir/licm"]},
    "wir_expect:O2": ["array_get_value<i32>($licm_repr", "< $licm_used"]
}
