// A list literal pulls in no `List<T>::push` / `::grow` instantiation at all:
// `[w]` denotes an `Array<Widget>` that `List<Widget>::from` takes ownership of
// (WEP 2026-08-24), so `array.new_fixed` is the whole construction.
//
// This fixture used to assert that WIR DCE *removed* those instantiations after
// a push chain was collapsed. That premise is gone with the builder protocol —
// and the assertion never held anyway: a monomorphized name is module-qualified
// (`List<wir_optimize_dce_orphan_push.wado/Widget>::push`), so the old
// `List<Widget>::push` pattern matched nothing on either lowering and the
// `wir_not_expect` passed unconditionally. The patterns below are the qualified
// suffix, which is 3 occurrences under the old lowering and 0 under this one.

use { println, Stdout } from "core:cli";

pub struct Widget {
    pub id: i32,
}

export fn run() with Stdout {
    let w = Widget { id: 7 };
    let widgets: List<Widget> = [w];
    println(`${widgets[0].id}`);
}

__DATA__
{
    "stdout": "7\n",
    "wir_not_expect:O2": [
        "Widget>::push",
        "Widget>::grow"
    ],
    "wir_expect:O2": [
        "array.new_fixed"
    ]
}
