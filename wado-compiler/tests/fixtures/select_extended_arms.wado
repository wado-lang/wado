// Verify that `select_lowering` accepts `Unary`, `Binary`, and `Cast`
// expressions as arms — not just `Local` / `Literal`. Both arms of a
// `select` are evaluated unconditionally, so the eligibility check
// must reject anything that could trap (Div, Mod, Deref) or have side
// effects (Call, Assign) but accept the cheap leaf-pure shapes. Each input
// is opaque, and each pattern names its local, so a match is this run's
// select and not one inlined from the stdlib.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Unary::Neg arm (the fpfmt::fmt_fixed shape).
    let v = builtin::black_box(3.5);
    let neg = builtin::black_box(true);
    let abs_f = if neg {
        -v;
    } else {
        v;
    };

    // Binary::Sub arms (the fpfmt::fixed_width_for_prec shape).
    let p = builtin::black_box(7);
    let c = builtin::black_box(true);
    let decimal_pos = if c {
        2 - p;
    } else {
        1 - p;
    };

    // Cast arm.
    let x = builtin::black_box(3);
    let c2 = builtin::black_box(false);
    let widened = if c2 {
        x as i64;
    } else {
        (x + 1) as i64;
    };

    assert abs_f == -3.5;
    assert decimal_pos == -5;
    assert widened == 4;
    println(`${abs_f} ${decimal_pos} ${widened}`);
}

__DATA__
{
    "stdout": "-3.5 -5 4\n",
    "wir_expect:O2": [
        "abs_f = select f64(",
        "decimal_pos = select i32(",
        "widened = select i64("
    ]
}
