// An enum: cases without payloads.

enum Color {
    Red,
    Green,
    Blue,
}

test {
    let c = Color::Red;
    let d: Color = Red;   // bare where the expected type supplies it
    assert c == d;

    let name = match c {
        _::Red => "red",
        _::Green => "green",
        _::Blue => "blue",
    };
    assert name == "red";

    assert c matches { _::Red };
    assert !(c matches { _::Green | _::Blue });
}

impl Color {
    fn is_warm(&self) -> bool {
        return match *self {
            _::Red => true,
            _ => false,
        };
    }
}

test {
    assert Color::Red.is_warm() && !Color::Blue.is_warm();
}
