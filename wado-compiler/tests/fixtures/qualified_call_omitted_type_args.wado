// A type spelled without its arguments in `Type::m(&x)` has them as inference
// variables, which the receiver settles: the call selects what `x.m()` does,
// whatever instance an impl happens to be written for.

trait Beta with () {
    fn m(&self) -> String;
}

trait AtBase with () {}

struct Pair<A, B> {
    a: A,
    b: B,
}

struct Box<T> {
    v: T,
}

type G<T> = Pair<T, i32>;
type H<U> = G<U>;
type Phantom<T> = Pair<i32, i32>;
type R<T> = &Pair<T, i32>;

impl AtBase for Pair<i32, i32> {}
impl<T> AtBase for Box<T> {}

impl<X: AtBase> Beta for X {
    fn m(&self) -> String {
        return "blanket";
    }
}

test "a generic newtype whose base the impl is written for" {
    let g: G<i32> = { a: 1, b: 2 };
    assert g.m() == "blanket";
    assert G::m(&g) == "blanket";
    assert G::<_>::m(&g) == "blanket";
}

test "two links down the chain" {
    let h: H<i32> = { a: 1, b: 2 };
    assert h.m() == "blanket";
    assert H::m(&h) == "blanket";
}

test "a parameter the base does not use" {
    let p: Phantom<String> = { a: 1, b: 2 };
    assert p.m() == "blanket";
    assert Phantom::m(&p) == "blanket";
}

test "a newtype over a reference" {
    let pair: Pair<i32, i32> = { a: 1, b: 2 };
    let r = &pair as R<i32>;
    assert r.m() == "blanket";
    assert R::m(&r) == "blanket";
}

test "a bound met by a generic impl" {
    let b: Box<String> = { v: "x" };
    assert b.m() == "blanket";
    assert Box::m(&b) == "blanket";
    assert Box::<_>::m(&b) == "blanket";
}

// A blanket whose bound nothing meets may not apply, so a static of the same
// name beside it does not make the call ambiguous.
trait Unmet with () {
    fn unmet(&self) -> i32;
}

trait Made with () {
    fn made() -> i32;
}

trait Taken with () {
    fn made(&self) -> i32;
}

impl<T: Unmet> Made for Box<T> {
    fn made() -> i32 {
        return 1;
    }
}

impl Taken for Box<String> {
    fn made(&self) -> i32 {
        return 2;
    }
}

test "a blanket whose bound nothing meets" {
    let b: Box<String> = { v: "x" };
    assert Box::made(&b) == 2;
    assert Box::<String>::made(&b) == 2;
}

// A projection in an impl's target, read at a variable, may be what it meets.
trait Fam with () {
    type Of;
}

struct Kin<T> {
    t: Option<T>,
}

impl<T> Fam for Kin<T> {
    type Of = Kin<T>;
}

trait Same with () {
    fn same(&self) -> Self;
}

impl<F: Fam> Same for Pair<F, F::Of> {
    fn same(&self) -> Self {
        return *self;
    }
}

fn kin_pair<U>() -> Pair<Kin<U>, Kin<i32>> {
    return { a: { t: null }, b: { t: null } };
}

test "a projection in the target" {
    let p: Pair<Kin<i32>, Kin<i32>> = kin_pair().same();
    assert p.b.t matches { None };
    assert Pair::same(&p).a.t matches { None };
}

// Two pins on one parameter must agree, so an impl whose pins name two types
// for it may not apply, and the other impl is the one answer.
trait Left with () {
    type Item;
}

trait Right with () {
    type Item;
}

struct Lr {
    x: i32,
}

impl Left for Lr {
    type Item = i32;
}

impl Right for Lr {
    type Item = bool;
}

trait Agree with () {
    fn agreed(&self) -> Self;
    fn which(&self) -> i32;
}

struct Maybe<A, B> {
    a: A,
    b: Option<B>,
}

impl<A: Left<Item = U> + Right<Item = U>, U> Agree for Maybe<A, U> {
    fn agreed(&self) -> Self {
        return *self;
    }
    fn which(&self) -> i32 {
        return 1;
    }
}

impl<B: AtBase> Agree for Maybe<Lr, B> {
    fn agreed(&self) -> Self {
        return *self;
    }
    fn which(&self) -> i32 {
        return 2;
    }
}

fn lr_maybe<V>() -> Maybe<Lr, V> {
    return { a: { x: 0 }, b: null };
}

// A projection read off a variable names no type yet, so it does not refute
// the impl whose target writes it.
trait Source with () {
    type Item;
}

impl Source for Lr {
    type Item = i32;
}

trait Echo with () {
    fn echoed(&self) -> Self;
}

struct Sourced<G, I> {
    g: Option<G>,
    item: I,
}

impl<G: Source> Echo for Sourced<G, G::Item> {
    fn echoed(&self) -> Self {
        return *self;
    }
}

fn sourced<V>() -> Sourced<V, i32> {
    return { g: null, item: 7 };
}

test "a projection read off a variable" {
    let s: Sourced<Lr, i32> = sourced().echoed();
    assert s.item == 7;
}

test "two pins on one parameter" {
    let p: Maybe<Lr, Box<i32>> = lr_maybe().agreed();
    assert p.which() == 2;
}
