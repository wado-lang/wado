// A closed struct's `FieldInputs` is `!`, which `[..F]` does not match, so a
// generic body pinning it cannot reach the closed `from_fields` either.
pub struct Closed {
    a: i32,
}

fn make<T: ReflectStruct<FieldInputs = [..F]>, ..F: Default>() -> T {
    return ReflectStruct::<T>::from_fields([..F::default()]);
}

export fn run() {
    let _ = make::<Closed>();
}

