// Test: Single-field struct parameter SROA
// Verifies that functions taking `ref null S` parameters (where S is any
// single-field struct, not just Box<T>) are rewritten to take the scalar
// field value directly, eliminating GC struct allocation at call sites.
//
// This extends the Box<T> parameter SROA to all single-field structs.

use { println, Stdout } from "core:cli";

// Single-field structs with different field names
struct Wrapper {
    inner: i32,
}

struct Amount {
    value: f64,
}

struct Label {
    text: String,
}

struct Flag {
    set: bool,
}

// Multi-field struct (should NOT be affected by single-field SROA)
struct Point {
    x: i32,
    y: i32,
}

// Edge case 1: Basic single-field struct with &self method
impl Wrapper {
    #[inline("never")]
    fn get(&self) -> i32 {
        return self.inner;
    }

    #[inline("never")]
    fn doubled(&self) -> i32 {
        return self.inner * 2;
    }

    // Edge case 11: &mut self should NOT be SROA'd (StructSet on the param)
    #[inline("never")]
    fn set(&mut self, v: i32) {
        self.inner = v;
    }
}

// Edge case 2: Single-field struct with f64 field
impl Amount {
    #[inline("never")]
    fn as_cents(&self) -> i32 {
        return (self.value * 100.0) as i32;
    }
}

// Edge case 3: Single-field struct with String field (GC ref type)
impl Label {
    #[inline("never")]
    fn len(&self) -> i32 {
        return self.text.len();
    }
}

// Edge case 4: Single-field struct with bool field
impl Flag {
    #[inline("never")]
    fn is_set(&self) -> bool {
        return self.set;
    }
}

// Edge case 5: Chain of single-field struct method calls
#[inline("never")]
fn double_wrapper(w: &Wrapper) -> i32 {
    return w.inner * 2;
}

#[inline("never")]
fn triple_wrapper(w: &Wrapper) -> i32 {
    return w.inner * 3;
}

// Edge case 6: Single-field struct passed to multiple functions
#[inline("never")]
fn process_wrapper(w: &Wrapper) -> i32 {
    let d = double_wrapper(w);
    let t = triple_wrapper(w);
    return d + t;
}

// Edge case 7: Wrapper constructed in branch, method called after
#[inline("never")]
fn conditional_wrapper(flag: bool) -> i32 {
    let w = if flag {
        Wrapper { inner: 10 }
    } else {
        Wrapper { inner: 20 }
    };
    return w.get();
}

// Edge case 8: Two params of different single-field struct types
#[inline("never")]
fn add_amounts(a: &Amount, b: &Amount) -> f64 {
    return a.value + b.value;
}

// Edge case 9: Single-field struct in a loop
#[inline("never")]
fn sum_wrappers() -> i32 {
    let mut total = 0;
    for let mut i = 0; i < 5; i += 1 {
        let w = Wrapper { inner: i * 10 };
        total += w.get();
    }
    return total;
}

// Edge case 10: Multiple different single-field structs in same function
#[inline("never")]
fn mixed_single_fields() -> i32 {
    let w = Wrapper { inner: 42 };
    let f = Flag { set: true };
    let result = if f.is_set() {
        w.get()
    } else {
        0
    };
    return result;
}

export fn run() with Stdout {
    // Basic method calls
    let w = Wrapper { inner: 42 };
    assert w.get() == 42;
    assert w.doubled() == 84;

    // Float single-field struct
    let a = Amount { value: 19.5 };
    assert a.as_cents() == 1950;

    // String single-field struct
    let l = Label { text: "hello" };
    assert l.len() == 5;

    // Bool single-field struct
    let f = Flag { set: true };
    assert f.is_set() == true;
    let f2 = Flag { set: false };
    assert f2.is_set() == false;

    // Chain of function calls
    assert double_wrapper(&w) == 84;
    assert triple_wrapper(&w) == 126;
    assert process_wrapper(&w) == 210;

    // Conditional construction
    assert conditional_wrapper(true) == 10;
    assert conditional_wrapper(false) == 20;

    // Amount addition
    let a1 = Amount { value: 10.5 };
    let a2 = Amount { value: 20.3 };
    let sum = add_amounts(&a1, &a2);
    assert sum == 30.8;

    // Loop
    assert sum_wrappers() == 100;  // 0 + 10 + 20 + 30 + 40

    // Mixed types
    assert mixed_single_fields() == 42;

    // Template string with single-field struct field (exercises Box<T> path too)
    let w2 = Wrapper { inner: 99 };
    assert `{w2.inner}` == "99";

    // &mut self should NOT be SROA'd but must work correctly
    let mut w3 = Wrapper { inner: 0 };
    w3.set(77);
    assert w3.inner == 77;

    // Verify multi-field structs still work correctly
    let p = Point { x: 10, y: 20 };
    assert p.x + p.y == 30;

    println("ok");
}

__DATA__
{
    "stdout": "ok\n",
    "wir_expect:O2": [
        "\"functype/Wrapper::get\" = fn(i32) -> i32",
        "\"functype/Wrapper::doubled\" = fn(i32) -> i32",
        "\"functype/Amount::as_cents\" = fn(f64) -> i32",
        "\"functype/Label::len\" = fn(ref String) -> i32",
        "\"functype/Flag::is_set\" = fn(bool) -> bool",
        "\"functype/double_wrapper\" = fn(i32) -> i32",
        "\"functype/triple_wrapper\" = fn(i32) -> i32",
        "\"functype/add_amounts\" = fn(f64, f64) -> f64"
    ],
    "wir_not_expect:O2": [
        "return self.inner;"
    ]
}
