// A web import carries an extern handle as a whole parameter or result, or an
// `Option` of one. Any other form has no lowering yet, so a call of the import
// is refused; declaring it is not.

#[cm("example:demo/node", linearity = "unrestricted", repr = "externref", classes = "0..=0")]
resource Node {}

#[cm("example:demo/global#pair")]
struct Pair {
    #[cm("a")]
    a: Node,
    #[cm("b")]
    b: Option<Node>,
}

#[cm("example:demo/global")]
interface Dom {
    #[cm("example:demo/global#touch")]
    fn touch(n: Option<&Node>) -> i32;

    #[cm("example:demo/global#touch-pair")]
    fn touch_pair(p: Pair) -> i32;

    #[cm("example:demo/global#touch-all")]
    fn touch_all(ns: List<Node>) -> i32;

    #[cm("example:demo/global#touch-later")]
    async fn touch_later(n: Node) -> AsyncCall<i32>;

    #[cm("example:demo/global#never-called")]
    fn never_called() -> List<Node>;

    #[cm("example:demo/global#root")]
    fn root() -> Node;
}

export fn run() with Dom {
    let n = Dom::root();
    let _ = Dom::touch(Option::Some(&n));
    let _ = Dom::touch_pair(Pair { a: n, b: null });
    let _ = Dom::touch_all([n]);
    let _ = Dom::touch_later(n).wait();
}

__DATA__
{
    "compile_error": ":40:13: error: `Dom::touch_pair` is unavailable: it takes or returns an extern handle in a form with no lowering yet: inside a list, a record or a variant other than `Option`, among parameters passed through memory, or in an `async` import",
    "compile_errors_contains": [
        ":41:13: error: `Dom::touch_all` is unavailable",
        ":42:13: error: `Dom::touch_later` is unavailable"
    ],
    "compile_errors_not_contains": ["`Dom::touch` is", "never_called", "`Dom::root`"],
    "compile_error_codes": ["UNAVAILABLE"]
}
