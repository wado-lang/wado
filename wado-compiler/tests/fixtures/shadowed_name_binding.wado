// A binding that takes a name already spelled for something else: an imported
// function, a module declaration, and an enclosing binding. Each is legal and
// each is reported.

use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
}

fn outer(Point: i32) -> i32 {
    return Point;
}

export fn run() with Stdout {
    let println = 1;
    let x = 2;
    if x > 0 {
        let x = 3;
        assert x == 3;
    }
    let twice = |x: i32| x * 2;
    assert twice(x) == 4;
    assert outer(println) == 1;
}

__DATA__
{
    "stdout": "",
    "warnings_contains": [
        "`println` shadows",
        "`Point` shadows",
        "`x` shadows"
    ]
}
