// A move empties its place with `null`, so the drop guard a scope end tests on
// that place folds away: neither end is dropped twice, and nothing tests a
// place every path reaching it emptied (WEP: Affine Types).

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    println("hi");
}

__DATA__
{
    "stdout": "hi\n",
    "wir_scope": "core:cli/println\"",
    "wir_not_expect:O2": ["ref.is_null("]
}
