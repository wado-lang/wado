// Test u64 basic operations
use { println, Stdout } from "core:cli";

fn run() with Stdout {
    // Basic assignment
    let a: u64 = 1000000000000 as u64;
    let b: u64 = 300000000000 as u64;

    // Arithmetic operations
    let sum = a + b;
    println(`sum: {sum}`);

    let diff = a - b;
    println(`diff: {diff}`);

    let prod: u64 = 1000000 as u64 * 1000000 as u64;
    println(`prod: {prod}`);

    let quot = a / b;
    println(`quot: {quot}`);

    let rem = a % b;
    println(`rem: {rem}`);
}

__DATA__
{"stdout": "sum: 1300000000000\ndiff: 700000000000\nprod: 1000000000000\nquot: 3\nrem: 100000000000\n"}
