// Test: user-defined struct named "Tuple" should not collide with built-in tuples
struct Tuple {
    x: i32,
    y: i32,
}

export fn run() {
    let t = Tuple { x: 1, y: 2 };
    assert t.x == 1;
    assert t.y == 2;

    let pair = [10, 20];
    assert pair.0 == 10;
    assert pair.1 == 20;
}

