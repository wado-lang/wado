// An interface no host provides that declares a record exports that type beside
// its functions, and the host accepts it.

use { println } from "core:cli";

#[cm("example:demo/global#pair")]
struct Pair {
    #[cm("a")]
    a: i32,
}

#[cm("example:demo/global")]
interface Dom {
    #[cm("example:demo/global#touch")]
    fn touch(p: Pair) -> i32;
}

struct Fake {}

impl Dom for Fake {
    fn touch(&mut self, p: Pair) -> i32 {
        resume p.a + 1
    }
}

fn poke() -> i32 with Dom {
    return Dom::touch(Pair { a: 41 });
}

export fn run() with Stdout {
    let mut f = Fake {};
    with Dom => &mut f do {
        println(`${poke()}`);
    }
}

__DATA__
{
  "stdout": "42\n"
}
