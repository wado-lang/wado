// An impl writing a multi-parameter trait's leading arguments only names the
// defaulted rest too, so a projection reached at full arguments finds it:
// `Holder<i32>` is `Holder<i32, i32>`.

trait Holder<T, U = T> with () {
    type Out;

    fn out(&self) -> Self::Out;
}

struct X {}

impl Holder<i32> for X {
    type Out = i32;

    fn out(&self) -> i32 {
        return 1;
    }
}

impl Holder<String> for X {
    type Out = String;

    fn out(&self) -> String {
        return "s";
    }
}

fn a<H: Holder<i32>>(h: &H) -> H::Out {
    return h.out();
}

test "a projection at defaults-filled arguments finds the impl" {
    assert a(&X {}) == 1;
}
