// A payload field whose wire name is the tag would write the key twice. The
// field's wire name counts, so a rename onto the tag collides too.

#[wire(tag = "kind")]
variant Event {
    Click(Click),
}

struct Click {
    #[wire(name = "kind")]
    button: i32,
}

export fn run() {}

