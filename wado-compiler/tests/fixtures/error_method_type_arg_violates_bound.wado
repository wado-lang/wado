// A method type argument that does not satisfy the parameter's trait bound
// must raise a clean trait-bound error, like the free-function path already
// does. Pre-existing bug: method type-arg bounds were never checked, so an
// explicit `m.get::<String>()` (where `String` does not implement `Producer`)
// reached WIR build and panicked ("unresolved Call String^Producer::make").

trait Producer {
    fn make() -> Self;
}
impl Producer for i32 {
    fn make() -> i32 { return 1; }
}

struct Source {}
impl Source {
    fn get<T: Producer>(&self) -> Option<T> {
        return Option::Some(T::make());
    }
}

export fn run() {
    let s = Source {};
    let x = s.get::<String>().unwrap();
    let _ = x;
}

__DATA__
{"compile_error": "Producer"}
