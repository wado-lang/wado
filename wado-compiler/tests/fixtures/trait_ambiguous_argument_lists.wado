// One trait at two argument lists distinguished only by numeric width: a
// literal admits both, and a literal never selects — letting its default type
// decide would make adding an impl silently retarget existing calls
// (WEP 2026-07-31). The fix is spelled out in the error.
trait Take<S> {
    fn take(&self, s: S) -> i32;
}

impl Take<i32> for bool {
    fn take(&self, s: i32) -> i32 {
        return 1;
    }
}

impl Take<i64> for bool {
    fn take(&self, s: i64) -> i32 {
        return 2;
    }
}

export fn run() {
    let f = true;
    assert f.take(42) == 1;
}

__DATA__
{"compile_error": "ambiguous call to 'take': the arguments do not select between 'Take<i32>' and 'Take<i64>'"}
