// `as` on a float literal is a conversion, not a re-typing of the literal.
// Reify re-typed any numeric literal operand of an integer-targeted cast so
// `-9e15 as i64` would not truncate through `i32` first; a float-only literal
// took that path too, and parsing "3.99" as an integer left `0`.
use { println } from "core:cli";

export fn run() with Stdout {
    let folded = `${3.99 as i32} ${-3.99 as i32} ${2.0 as i64} ${3.99 as u8} ${300.7 as i8}`;
    let f = builtin::black_box(3.99);
    let n = builtin::black_box(-3.99);
    let runtime = `${f as i32} ${n as i32} ${builtin::black_box(2.0) as i64} ${f as u8} ${builtin::black_box(300.7) as i8}`;
    assert folded == runtime;
    // The integer-literal path the re-typing exists for still widens first.
    assert -9e15 as i64 == -9000000000000000 as i64;
    println(folded);
}

__DATA__
{"stdout": "3 -3 2 3 44\n"}
