// Array literal elements do not auto-dereference &T to T.
// Use explicit dereference (*ref) instead.
export fn run() {
    let x = 1;
    let y = 2;
    let rx = &x;
    let ry = &y;
    let arr: Array<i32> = [rx, ry];    // &i32 in Array<i32> → error
}

