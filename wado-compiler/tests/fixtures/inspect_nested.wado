// Test: inspect nested types (struct in struct, Option of struct, Array of struct)
use { println, Stdout } from "core:cli";

struct Point {
    x: i32,
    y: i32,
}

struct Line {
    start: Point,
    end: Point,
}

export fn run() with Stdout {
    // Nested struct
    let line = Line {
        start: Point { x: 0, y: 0 },
        end: Point { x: 10, y: 20 },
    };
    println(`{line:?}`);

    // Struct in array
    let points: Array<Point> = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }];
    println(`{points:?}`);

    // Option of struct
    let opt_p: Option<Point> = Option::<Point>::Some(Point { x: 10, y: 20 });
    println(`{opt_p:?}`);

    let none_p: Option<Point> = null;
    println(`{none_p:?}`);

    println("ok");
}

__DATA__
{"stdout": "Line { start: Point { x: 0, y: 0 }, end: Point { x: 10, y: 20 } }\n[Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]\nOption::Some(Point { x: 10, y: 20 })\nOption::None\nok\n"}
