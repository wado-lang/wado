// A waiting call whose integer literal argument admits two overloads' widths
// is ambiguous once its receiver settles, as the same call on a receiver
// already settled is. The literal's default width does not select.

struct Bx<T> { v: Option<T> }

fn empty<T>() -> Bx<T> { return Bx { v: null }; }

trait Conv<A> with () {
    fn conv(&self, a: A) -> i32;
}

impl Conv<i32> for Bx<i32> {
    fn conv(&self, a: i32) -> i32 { return 1; }
}

impl Conv<i64> for Bx<i32> {
    fn conv(&self, a: i64) -> i32 { return 2; }
}

impl Conv<i32> for Bx<bool> {
    fn conv(&self, a: i32) -> i32 { return 3; }
}

test {
    let b = empty();
    let n = b.conv(1);
    let _settled: Bx<i32> = b;
    assert n == 1;
}

__DATA__
{"compile_error": ":27:13: analysis error: ambiguous call to 'conv': the arguments do not select between 'Conv<i32>' and 'Conv<i64>'"}
