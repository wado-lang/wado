// `&<non-local place>` names the place, so a later read through the reference
// observes an assignment to the place, as it observes a mutation through the
// shared handle (`xs[i] = …`, `push`). The assignment writes into the storage
// the reference holds wherever the reference is read afterwards
// (WEP 2026-10-13), and inlining turning `r[0]` into a field read answers the
// same. Each case below reassigns through a different path — direct, aliased
// `&mut`, and an out-of-line `&mut self` method.
use { println, Stdout } from "core:cli";

struct Box { xs: List<i32> }

impl Box {
    fn replace(&mut self, n: i32) {
        if n > 1000 { self.replace(n - 1) }
        self.xs = [n]
    }
}

export fn run() with Stdout {
    // Direct reassignment of the captured field.
    let mut a = Box { xs: [10] };
    let ra = &a.xs;
    a.xs = [20];
    println(`${ra[0]}`);

    // In-place element write: visible through the shared handle.
    let mut b = Box { xs: [10] };
    let rb = &b.xs;
    b.xs[0] = 20;
    println(`${rb[0]}`);

    // Reassignment through a `&mut` alias of the enclosing struct.
    let mut c = Box { xs: [10] };
    let rc = &c.xs;
    let m = &mut c;
    m.xs = [20];
    println(`${rc[0]}`);

    // Reassignment inside an out-of-line `&mut self` method.
    let mut d = Box { xs: [10] };
    let rd = &d.xs;
    d.replace(20);
    println(`${rd[0]}`);
}

__DATA__
{ "stdout": "20\n20\n20\n20\n" }
