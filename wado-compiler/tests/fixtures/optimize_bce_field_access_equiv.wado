// Bounds check elimination: loop guard and index check should resolve to the same bound
// even when they are derived from the same field access on different locals (LICM-hoisted).
export fn run() {
    let arr: List<i32> = List::<i32>::filled(100, 42);
    let n = arr.len();
    let mut sum = 0;
    for let mut i = 0; i < n; i += 1 {
        sum += arr[i];
    }
    assert sum == 4200;
}

__DATA__
{
    "stdout": "",
    "wir_not_expect:O2": ["index out of bounds"]
}
