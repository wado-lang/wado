// The read sits before the call in the source, but inside the loop that
// encloses it: the next turn runs that read after this turn's call. The borrow
// is still reachable there, so the call is refused.

variant Payload {
    Text(String),
    Empty,
}

struct Bag {
    item: Payload,
}

struct Keep {
    held: &mut Payload,
}

#[inline("never")]
fn park(k: &mut Keep, p: &mut Payload) {
    k.held = p;
    *p = Payload::Text("parked");
}

fn park_a_field(b: &mut Bag, spare: &mut Payload) -> i32 {
    let mut seen = Keep { held: spare };
    let mut n = 0;
    for let i of 0..<3 {
        if seen.held matches { Text(_) } { n += 1; }
        park(&mut seen, &mut b.item);
    }
    return n;
}

test "unreachable" {
    let mut b = Bag { item: Payload::Empty };
    let mut spare = Payload::Empty;
    assert park_a_field(&mut b, &mut spare) == 2;
}

__DATA__
{
    "test": {},
    "compile_error": "stores it, so it outlives the call"
}
