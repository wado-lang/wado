// Import struct with alias (no local collision)

use { println, Stdout } from "core:cli";
use { Point as OtherPoint } from "./geometry.wado";

export fn run() with Stdout {
    let p = OtherPoint { x: 10, y: 4 };
    println(`sum: {p.sum()}`);
    println(`product: {p.product()}`);
}

__DATA__
{"stdout": "sum: 14\nproduct: 40\n"}
