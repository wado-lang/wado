#![TODO]
// Where an impl was written is not a rank: these two blankets hold at the same
// level, so they tie and the call reports even though one is written here. The
// escape is `impl Describe for Point`, which rank 2 puts above both. Today the
// sort prefers the local candidate and the report groups local apart from
// foreign, so the local blanket answers (WEP 2026-09-01, "Locality is still
// implemented").

use { Limit, Mark, Describe } from "./sub/two_foreign_value_blankets_traits.wado";
use { } from "./sub/two_foreign_value_blankets_limit.wado";

struct Point {
    x: i32,
}

impl Limit for Point {
    fn limit() -> i32 {
        return 7;
    }
}

impl Mark for Point {
    fn mark() -> i32 {
        return 9;
    }
}

impl<T: Mark> Describe for T {
    fn describe(&self) -> String {
        return `mark:${T::mark()}`;
    }
}

export fn run() {
    let p = Point { x: 1 };
    assert p.describe() == "mark:9";
}

__DATA__
{"compile_error": "ambiguous blanket impls of 'Describe' for 'Point'"}
