#![TODO]
// Two libraries carry a blanket of the same method name, and exactly one of the
// traits is imported. Scope leaves one candidate, so the call resolves to it
// with no ambiguity and no dependence on which module loaded first.
//
// Today the scope tie-break consults concrete candidates only, so importing a
// trait does not change a blanket's reach and the other library's blanket
// answers instead (WEP 2026-09-01, "Scope is decided and not implemented").

use { tagged_version } from "./sub/trait_scope_blanket_tagged.wado";
use { Marked, marked_version } from "./sub/trait_scope_blanket_marked.wado";

test "the imported blanket is the one that answers" {
    let _ = tagged_version() + marked_version();
    assert 42.tag() == "marked:42";
}
