// Test: early-exit guard eliminates redundant bounds checks.
//
// Pattern: `if pos >= arr.len() { return ...; }; arr[pos]`
// After the guard, pos < arr.len() is known, so the bounds check
// inside arr[pos] is always false and gets eliminated.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn safe_get(arr: List<char>, pos: i32) -> char {
    if pos >= arr.len() {
        return '?';
    }
    return arr[pos];
}

export fn run() with Stdout {
    // `black_box`ed positions so the calls survive to the WIR: a fully constant
    // one folds to its result, and the bounds check this pins goes with it.
    let a: List<char> = ['a', 'b', 'c'];
    println(`${safe_get(a, builtin::black_box(1))}`);
    println(`${safe_get(a, builtin::black_box(10))}`);
}

__DATA__
{
    "stdout": "b\n?\n",
    "wir_expect:O2": ["builtin::array_get<char>(arr.repr, pos)"],
    "wir_not_expect:O2": ["index out of bounds"]
}
