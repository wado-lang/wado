// An impl target whose function type's row is an effect parameter matches a
// receiver whatever that row holds: the parameter stands for it.

struct Slot<T> {
    v: T,
}

impl<effect E> Slot<fn() with (E)> {
    fn tag(self) -> i32 {
        return 5;
    }
}

test "an effect binder in an impl target resolves" {
    let s = Slot { v: || {} };
    assert s.tag() == 5;
}
