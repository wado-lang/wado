#![TODO]
// An impl target whose function type carries an effect never matches: an effect
// has no reference site, so neither side can tell the binder `E` from a
// concrete effect. Effect-polymorphic impl targets are unimplemented.

struct Slot<T> {
    v: T,
}

impl<effect E> Slot<fn() with (E)> {
    fn tag(self) -> i32 {
        return 5;
    }
}

test "an effect binder in an impl target resolves" {
    let s = Slot { v: || {} };
    assert s.tag() == 5;
}
