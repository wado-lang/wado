// Match ergonomics: match expressions auto-deref &T scrutinees.
// Bindings through &T get reference types (Rust-compatible).
use { println, Stdout } from "core:cli";

enum Color {
    Red,
    Green,
    Blue,
}

export fn run() with Stdout {
    // Match on &enum — enum patterns have no bindings, works directly
    let c = Color::Red;
    let rc = &c;
    let name = match rc {
        Red => "red",
        Green => "green",
        Blue => "blue",
    };
    assert name == "red";

    // Match on &Option<T> — x binds as &i32
    let opt: Option<i32> = Option::<i32>::Some(42);
    let ro = &opt;
    let val = match ro {
        Some(x) => *x,
        None => 0,
    };
    assert val == 42;

    // Match on &i32 with guards
    let x = 50;
    let rx = &x;
    let label = match rx {
        _ && *rx > 100 => "large",
        _ && *rx > 10 => "medium",
        _ => "small",
    };
    assert label == "medium";

    println("ok");
}

__DATA__
{"stdout": "ok\n"}
