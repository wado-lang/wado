// A program cannot claim a compiler item: `#[compiler_item]` is a standard
// library attribute, so the registry's invariants stay tied to the stdlib.

#[compiler_item("eq")]
pub trait MyEq with () {
    fn eq(&self, other: &Self) -> bool;
}

export fn run() {}

