// ReflectFlags bit walk (WEP 2026-06-13 §3c): bit_tokens() returns FlagBit<F>
// tokens carrying the member name and its bitmask; bit / is_set / set bridge a
// value and its single bit. Flags have no rename surface, so wire_name_override
// is always None.

flags Perms {
    Read,
    Write,
    Execute,
}

test "Member exposes member name and bit" {
    let ts = ReflectFlags::<Perms>::bit_tokens();
    assert ts.len() == 3;
    assert ts[0].name() == "Read";
    assert ts[0].bit() == 1;
    assert ts[1].bit() == 2;
    assert ts[2].name() == "Execute";
    assert ts[2].bit() == 4;
    assert ts[0].wire_name_override() matches { None };
}

test "is_set and set round-trip a bit" {
    let ts = ReflectFlags::<Perms>::bit_tokens();
    let p = Perms::Read | Perms::Execute;
    assert ts[0].is_set(&p);
    assert !ts[1].is_set(&p);
    assert ts[2].is_set(&p);
    assert ts[1].set() as u32 == 2;
}

__DATA__
{"test": {}}
