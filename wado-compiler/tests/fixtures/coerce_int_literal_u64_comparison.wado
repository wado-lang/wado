// Test: literal coercion in comparison with u64 variable
// `x == 0` where x is u64 should coerce 0 to u64.
use { println, Stdout } from "core:cli";

fn is_zero(x: u64) -> bool {
    return x == 0;
}

export fn run() with Stdout {
    println(`0 is zero: {is_zero(0)}`);
    println(`1 is zero: {is_zero(1)}`);
}

__DATA__
{"stdout": "0 is zero: true\n1 is zero: false\n"}
