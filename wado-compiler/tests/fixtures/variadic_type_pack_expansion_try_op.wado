// Type pack expansion with try-op: [..T::method()?]
// TODO: try-op inside pack expansion needs local variable allocation fixup
use { println, Stdout } from "core:cli";

trait TryDefault {
    fn try_default() -> Result<Self, String>;
}

impl TryDefault for i32 {
    fn try_default() -> Result<i32, String> {
        return Result::<i32, String>::Ok(0);
    }
}

impl TryDefault for String {
    fn try_default() -> Result<String, String> {
        return Result::<String, String>::Ok("default");
    }
}

impl TryDefault for bool {
    fn try_default() -> Result<bool, String> {
        return Result::<bool, String>::Ok(false);
    }
}

fn make_defaults<..T: TryDefault>() -> Result<[..T], String> {
    return Result::<[..T], String>::Ok([..T::try_default()?]);
}

export fn run() with Stdout {
    let result = make_defaults::<[i32, String, bool]>();
    if let Ok(t) = result {
        assert t.0 == 0;
        assert t.1 == "default";
        assert t.2 == false;
    }
    println("ok");
}

__DATA__
{"TODO": true, "stdout": "ok\n"}
