/// Test that the freelist allocator splits large blocks:
/// a large freed block can serve multiple smaller allocations.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Allocate a large block and free it.
    let big = builtin::realloc(0, 0, 8, 1024);
    assert big > 0;
    builtin::realloc(big, 1024, 8, 0);

    // Allocate a smaller block — carved from the freed large block.
    let small1 = builtin::realloc(0, 0, 8, 64);
    assert small1 == big, `expected split from freed block: big={big}, small1={small1}`;

    // The next small block comes from the split remainder. A 64-byte
    // payload occupies an 80-byte block (16 bytes of boundary tags).
    let small2 = builtin::realloc(0, 0, 8, 64);
    assert small2 == big + 80, `expected split remainder: expected={big + 80}, small2={small2}`;

    // And again, a 128-byte payload (144-byte block) from what is left.
    let small3 = builtin::realloc(0, 0, 8, 128);
    assert small3 == big + 160, `expected from remainder: expected={big + 160}, small3={small3}`;

    println("ok");
}

__DATA__
{"allocator": "freelist", "stdout": "ok\n"}
