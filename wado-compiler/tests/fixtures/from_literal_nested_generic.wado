// Tests that a nested generic type (e.g. List<String>) works as a concrete type position
// in an impl target, and that impl_type_matches_concrete recursively validates it.
use { println, Stdout } from "core:cli";

struct NestedMap<K, V> {
    keys: List<String>,
    values: List<V>,
}

impl NestedMap<K, V> {
    fn new() -> NestedMap<K, V> {
        return NestedMap { keys: [], values: [] };
    }
}

impl From<Array<[String, V]>> for NestedMap<List<String>, V> {
    fn from(entries: Array<[String, V]>) -> NestedMap<List<String>, V> {
        let mut out = NestedMap::<List<String>, V>::new();
        for let [key, value] of entries {
            out.keys.push(key);
            out.values.push(value);
        }
        return out;
    }
}

export fn run() with Stdout {
    let m: NestedMap<List<String>, i32> = { a: 1, b: 2 };
    assert m.keys.len() == 2;
    println("ok");
}

__DATA__
{"stdout": "ok\n"}
