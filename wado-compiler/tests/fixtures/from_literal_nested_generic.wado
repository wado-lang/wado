// Tests that a nested generic type (e.g. List<String>) works as a concrete type position
// in an impl target, and that impl_type_matches_concrete recursively validates it.
use { println } from "core:cli";

struct NestedMap<K, V> {
    keys: List<String>,
    values: List<V>,
}

impl NestedMap<K, V> {
    fn new() -> NestedMap<K, V> {
        return NestedMap { keys: [], values: [] };
    }
}

impl KeyValueLiteralBuilder for NestedMap<List<String>, V> {
    type Value = V;
    type Output = NestedMap<List<String>, V>;

    fn new_literal(capacity: i32) -> NestedMap<List<String>, V> {
        return NestedMap::<List<String>, V>::new();
    }

    fn insert_literal(&mut self, key: String, value: Self::Value) {
        self.keys.push(key);
        self.values.push(value);
    }

    fn build(&self) -> NestedMap<List<String>, V> {
        return *self;
    }
}

export fn run() with Stdout {
    let m: NestedMap<List<String>, i32> = { a: 1, b: 2 };
    assert m.keys.len() == 2;
    println("ok");
}

__DATA__
{"stdout": "ok\n"}
