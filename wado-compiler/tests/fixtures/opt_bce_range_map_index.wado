// `(0..<xs.len()).map(|i| xs[i])` reads `xs[i]` under the range's own guard,
// which the inlined `Iterator::next` leaves inside two labeled blocks at the
// loop head, against the length LICM hoisted for the check beside the one the
// range read. Both must be seen through for the check to go.

#[inline(never)]
fn doubled(xs: &List<i32>) -> List<i32> {
    return (0..<xs.len()).into_iter().map(|i| xs[i] * 2).collect();
}

export fn run() {
    let xs: List<i32> = [1, 2, 3];
    let out = doubled(&builtin::black_box(xs));
    assert out.len() == 3;
    assert out[2] == 6;
}

__DATA__
{
    "stdout": "",
    "wir_pass": {"O2": ["nir/licm", "nir/cond_impl_post_promote"]},
    "wir_contrast": {"O2": [{"xs[i] * 2": "xs[i + 1] * 2"}]},
    "wir_scope": "opt_bce_range_map_index.wado/doubled",
    "wir_not_expect:O2": ["contract_report0"]
}
