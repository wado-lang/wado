// A float-to-int cast the compiler folds must agree with the one it runs: both
// saturate at the target's own bounds, so `300.7 as i8` is 127 and not the 44
// that wrapping an i32 intermediate gives, and `-1.0 as u8` is 0, not a trap.
use { println, Stdout } from "core:cli";

#[inline(never)]
fn to_i8(f: f64) -> i8 {
    return f as i8;
}

#[inline(never)]
fn to_u8(f: f64) -> u8 {
    return f as u8;
}

#[inline(never)]
fn to_i32(f: f64) -> i32 {
    return f as i32;
}

export fn run() with Stdout {
    println(`${to_i8(300.7)}`);
    println(`${to_i32(-7.9)}`);
    println(`${to_i32(2147483647.0)}`);
    println(`${to_u8(300.7)}`);
    println(`${to_u8(-1.0)}`);
}

__DATA__
{
    "stdout": "127\n-7\n2147483647\n255\n0\n"
}
