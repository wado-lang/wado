// Test trait bound checking
// A struct with a trait bound that should be checked at instantiation

use {println, Stdout} from "core:cli";

trait Printable {
    fn print(&self) -> String;
}

struct StringWrapper {
    value: String,
}

impl Printable for StringWrapper {
    fn print(&self) -> String {
        return self.value;
    }
}

// Container requires T to implement Printable
struct Container<T: Printable> {
    item: T,
}

fn run() with Stdout {
    // This should work: StringWrapper implements Printable
    let c = Container { item: StringWrapper { value: "hello" } };
    println(c.item.print());
}

__DATA__
{"stdout": "hello\n"}
