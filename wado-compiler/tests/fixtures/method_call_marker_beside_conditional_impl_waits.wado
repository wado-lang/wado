// The written `Eq` holds only where `T: Cap`, and the marker where `T: Eq`,
// so which impl answers `eq` on `Box<_>` depends on what `_` becomes. The
// selection waits for it: `Box<bool>` misses `Cap`, so the marker answers.

struct Box<T> { v: T }

trait Cap with () { fn cap(&self) -> i32; }
impl Cap for i32 { fn cap(&self) -> i32 { return 1; } }

impl<T: Cap> Eq for Box<T> { fn eq(&self, _o: &Self) -> bool { return false; } }
impl<T: Eq> Eq for Box<T>;

fn mk<T: Default>() -> Box<T> {
    return Box { v: T::default() };
}

test {
    let a = mk();
    let same = a.eq(&a);
    let _c: Box<bool> = a;
    assert same;
}
