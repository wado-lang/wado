// A shaped newtype's inherited static that nothing answers reports its slot
// once, with the receiver's turbofish.
type Wrapped<U> = List<Option<U>>;

export fn run() {
    let open = Wrapped::with_capacity(2);
    assert open.len() == 0;
}

