// A binding a closure captures is read whenever the closure runs, so a write
// to its source while the closure is live keeps the binding's copy.
struct Range { lo: i32, hi: i32 }
struct Class { ranges: List<Range>, neg: bool }

fn holds(c: &Class, x: i32) -> bool {
    for let r of &c.ranges {
        if r.lo <= x && x <= r.hi { return !c.neg; }
    }
    return c.neg;
}

#[inline("never")]
fn count_after_write(c: &mut Class, xs: &List<i32>) -> i32 {
    let f = *c;
    let admits = |x: i32| holds(&f, x);
    c.ranges[0].hi = 100;
    return xs.iter_ref().filter(|x| admits(*x)).count();
}

#[inline("never")]
fn make_admits(c: &Class) -> fn(i32) -> bool {
    let f = *c;
    return |x: i32| holds(&f, x);
}

#[inline("never")]
fn moved_after_capture(xs: &List<i32>) -> i32 {
    let f = Class { ranges: [Range { lo: 1, hi: builtin::black_box(3) }], neg: false };
    let admits = |x: i32| holds(&f, x);
    let mut g = f;
    g.ranges[0].hi = 100;
    assert g.ranges[0].hi == 100;
    return xs.iter_ref().filter(|x| admits(*x)).count();
}

#[inline("never")]
fn stored_closure(c: &mut Class) -> bool {
    let f = *c;
    let mut kept: List<fn(i32) -> bool> = [];
    kept.push(|x: i32| holds(&f, x));
    c.ranges[0].hi = 100;
    return kept[0](5);
}

test "a capture outlives a move of the binding" {
    let xs: List<i32> = [2, 5];
    assert moved_after_capture(&xs) == 1;
}

test "a closure a list keeps keeps the copy" {
    let mut c = Class { ranges: [Range { lo: 1, hi: 3 }], neg: false };
    assert !stored_closure(&mut c);
}

test "a write while the closure is live keeps the copy" {
    let mut c = Class { ranges: [Range { lo: 1, hi: 3 }], neg: false };
    let xs: List<i32> = [2, 5];
    assert count_after_write(&mut c, &xs) == 1;
}

test "a returned closure keeps the copy" {
    let mut c = Class { ranges: [Range { lo: 1, hi: 3 }], neg: false };
    let admits = make_admits(&c);
    c.ranges[0].hi = 100;
    assert !admits(5);
}

__DATA__
{"test": {}}
