// A closure type's mangle spells its effect row and each effect's module, so
// two closures differing only in their effects monomorphize a generic to two
// names rather than colliding on one.
use { eprintln, println, Stdout, Stderr } from "core:cli";

fn count<T>(v: T) -> i32 {
    return 1;
}

export fn run() with (Stdout, Stderr) {
    println(`${count(|| { println("x"); }) + count(|| { eprintln("y"); })}`);
}

__DATA__
{"stdout": "2\n"}
