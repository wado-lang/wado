// Test: Box<T> parameter SROA optimization
// Verifies that functions taking `ref null Box<T>` parameters are rewritten
// to take the scalar `T` directly, eliminating GC struct allocation at call sites.
//
// Box<T> is synthesized by the lower phase to wrap primitives for reference
// semantics (e.g., Display::fmt receives `&self` → `ref null Box<T>`).
// Template string interpolation is the primary trigger for Box<T> creation.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    // Integer types (i8/i16/u8/u16 are lowered to i32/u32 in Wasm)
    let i8_val: i8 = 42;
    let i16_val: i16 = 1000;
    let i32_val: i32 = 100000;
    let i64_val: i64 = 999999999;
    let u8_val: u8 = 255;
    let u16_val: u16 = 60000;
    let u32_val: u32 = 4000000000;
    let u64_val: u64 = 18000000000000000000;

    // Float types
    let f32_val: f32 = 3.14;
    let f64_val: f64 = 2.71828;

    // Other primitives
    let bool_val = true;
    let char_val = 'Z';

    // Template string interpolation triggers Box<T> creation for each value.
    // After SROA, the fmt functions receive scalars directly.
    assert `{i8_val}` == "42";
    assert `{i16_val}` == "1000";
    assert `{i32_val}` == "100000";
    assert `{i64_val}` == "999999999";
    assert `{u8_val}` == "255";
    assert `{u16_val}` == "60000";
    assert `{u32_val}` == "4000000000";
    assert `{u64_val}` == "18000000000000000000";
    assert `{f32_val}` == "3.14";
    assert `{f64_val}` == "2.71828";
    assert `{bool_val}` == "true";
    assert `{char_val}` == "Z";

    // Format specifiers also go through Box<T> paths
    assert `{f64_val:0.2f}` == "2.72";
    assert `{i32_val:x}` == "186a0";

    println("ok");
}

__DATA__
{
    "stdout": "ok\n",
    "wir_expect:O2": [
        "\"functype/i32::fmt_decimal\" = fn(i32, ref null Formatter)",
        "\"functype/u32::fmt_decimal\" = fn(u32, ref null Formatter)",
        "\"functype/i64::fmt_decimal\" = fn(i64, ref null Formatter)",
        "\"functype/u64::fmt_decimal\" = fn(u64, ref null Formatter)",
        "\"functype/f32::fmt_into\" = fn(f32, ref null Formatter)",
        "\"functype/f64::fmt_into\" = fn(f64, ref null Formatter)",
        "\"functype/f64::fmt_fixed\" = fn(f64, i32, ref null Formatter)",
        "\"functype/char^Display::fmt\" = fn(char, ref null Formatter)",
        "f64::fmt_fixed(self, f.precision, f)"
    ]
}
