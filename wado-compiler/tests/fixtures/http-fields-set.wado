// HTTP Fields.set() test
// Tests replacing all values for a header name using Fields.set().

use { Request, Response, ErrorCode, Fields, FieldName, FieldValue, Trailers } from "wasi:http";

export async fn handle(request: Request) -> Result<Response, ErrorCode> {
    let fields = Fields::new();

    // First append a value
    let v1: Array<u8> = [111 as u8, 108 as u8, 100 as u8]; // "old"
    let _ = fields.append("x-test" as FieldName, v1 as FieldValue);
    assert fields.has("x-test" as FieldName);

    // Now set() replaces all values for that name
    let v2: Array<u8> = [110 as u8, 101 as u8, 119 as u8]; // "new"
    let new_values: Array<FieldValue> = [v2 as FieldValue];
    let set_result = fields.set("x-test" as FieldName, new_values);
    if let Err(e) = set_result {
        panic("set failed");
    }

    // Verify there is exactly one value after set()
    let got = fields.get("x-test" as FieldName);
    assert got.len() == 1;

    let [trailers_future, trailers_tx] = Future::<Result<Option<Trailers>, ErrorCode>>::new();
    let [response, _tx_future] = Response::new(fields, null, trailers_future);
    // Use the fields as response headers so we can verify the value
    task return Result::<Response, ErrorCode>::Ok(response);
    trailers_tx.write(Result::<Option<Trailers>, ErrorCode>::Ok(null));
}

__DATA__
{"wasi:http/service": {"status": 200, "headers_contain": [["x-test", "new"]]}}
