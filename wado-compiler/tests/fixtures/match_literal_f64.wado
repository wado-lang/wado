// Test match expression with f64 literal patterns
// Float literal patterns are not yet implemented

use { println, Stdout } from "core:cli";

fn run() with Stdout {
    let x: f64 = 3.14159;

    let r1 = match x {
        0.0 => "zero",
        3.14159 => "pi",
        _ => "other",
    };

    println(r1);
}

