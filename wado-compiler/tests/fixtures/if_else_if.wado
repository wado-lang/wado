// Test: if/else if/else chains
use { println, Stdout } from "core:cli";

fn classify(n: i32) -> String {
    if n < 0 {
        return "negative";
    } else if n == 0 {
        return "zero";
    } else if n < 10 {
        return "small";
    } else if n < 100 {
        return "medium";
    } else {
        return "large";
    }
}

fn run() with Stdout {
    println(classify(-5));
    println(classify(0));
    println(classify(5));
    println(classify(50));
    println(classify(500));
}

__DATA__
{"stdout": "negative\nzero\nsmall\nmedium\nlarge\n"}
