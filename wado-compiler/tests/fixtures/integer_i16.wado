use { println, Stdout } from "core:cli";


// from integer_i16_basic.wado
fn integer_i16_basic() with Stdout {
    // Basic assignment
    let a: i16 = 1000 as i16;
    let b: i16 = 30 as i16;

    // Arithmetic operations
    let sum = a + b;
    println(`sum: {sum}`);

    let diff = a - b;
    println(`diff: {diff}`);

    let prod = a * b;
    println(`prod: {prod}`);

    let quot = a / b;
    println(`quot: {quot}`);

    let rem = a % b;
    println(`rem: {rem}`);
}

// from integer_i16_comparison.wado
fn integer_i16_comparison() with Stdout {
    let a: i16 = 1000 as i16;
    let b: i16 = 2000 as i16;
    let c: i16 = -500 as i16;

    // Positive comparisons
    if a < b {
        println("a < b: true");
    }
    if a <= b {
        println("a <= b: true");
    }
    if b > a {
        println("b > a: true");
    }
    if b >= a {
        println("b >= a: true");
    }

    // Negative comparisons (critical for signed types)
    if c < a {
        println("c < a: true");
    }
    if c < 0 as i16 {
        println("c < 0: true");
    }
    if a > c {
        println("a > c: true");
    }

    // Equality
    let d: i16 = 1000 as i16;
    if a == d {
        println("a == d: true");
    }
    if a != b {
        println("a != b: true");
    }
}

// from integer_i16_edge.wado
fn integer_i16_edge() with Stdout {
    // Max value: 32767
    let max: i16 = 32767 as i16;
    println(`max: {max}`);

    // Min value: -32768
    let min: i16 = -32768 as i16;
    println(`min: {min}`);

    // Negative arithmetic
    let neg: i16 = -5000 as i16;
    let pos: i16 = 3000 as i16;
    let sum = neg + pos;
    println(`neg + pos: {sum}`);

    // Negative division
    let div_result: i16 = -100 as i16 / 7 as i16;
    println(`-100 / 7: {div_result}`);

    // Negative modulo
    let mod_result: i16 = -100 as i16 % 7 as i16;
    println(`-100 % 7: {mod_result}`);
}

export fn run() with Stdout {
    integer_i16_basic();
    integer_i16_comparison();
    integer_i16_edge();
}

__DATA__
{"stdout": "sum: 1030\ndiff: 970\nprod: 30000\nquot: 33\nrem: 10\na < b: true\na <= b: true\nb > a: true\nb >= a: true\nc < a: true\nc < 0: true\na > c: true\na == d: true\na != b: true\nmax: 32767\nmin: -32768\nneg + pos: -2000\n-100 / 7: -14\n-100 % 7: -2\n"}
