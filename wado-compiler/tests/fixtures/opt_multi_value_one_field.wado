// A one-field aggregate takes the multi-value return ABI too: its one result
// is a plain Wasm return, so the call allocates no one-field struct or 1-tuple
// for the caller to read straight back out. A nullable field, a tail call and
// a caller rebuilding the whole value each take the same path an N-field one
// does.

struct Wrapped {
    value: i32,
}

struct Maybe {
    s: Option<String>,
}

#[inline("never")]
fn wrap(v: i32) -> Wrapped {
    return Wrapped { value: v * 2 };
}

#[inline("never")]
fn wrap_again(v: i32) -> Wrapped {
    return wrap(v + 1);
}

#[inline("never")]
fn single(v: i32) -> [i32] {
    return [v + 1];
}

#[inline("never")]
fn maybe(v: i32) -> Maybe {
    if v > 0 {
        return Maybe { s: Some(`v${v}`) };
    }
    return Maybe { s: null };
}

#[inline("never")]
fn unwrap_all(v: i32) -> i32 {
    let w = wrap(v);
    let a = wrap_again(v);
    let s = single(v);
    let m = maybe(v);
    let n = maybe(-v);
    let len = if let Some(t) = m.s { t.len() } else { -1 };
    let none = if n.s matches { None } { 100 } else { 0 };
    return w.value + a.value + s.0 + len + none;
}

global KEPT: Wrapped = wrap(builtin::black_box(4));

#[inline("never")]
fn whole() -> i32 {
    return KEPT.value;
}

export fn run() {
    assert unwrap_all(builtin::black_box(10)) == 156;
    assert whole() == 8;
}

__DATA__
{
    "stdout": "",
    "wir_expect:O2": [
        "wrap\" = fn(i32) -> i32",
        "wrap_again\" = fn(i32) -> i32",
        "single\" = fn(i32) -> i32",
        "maybe\" = fn(i32) -> ref null \"core:prelude/string.wado//String\"",
        "return \"opt_multi_value_one_field.wado/wrap\"(v + 1);",
        "struct.new \"opt_multi_value_one_field.wado//Wrapped\" { value: $mv",
        "multivalue_bind ["
    ],
    "wir_not_expect:O2": [
        "struct.new \"tuple//[i32]\"",
        "struct.new \"opt_multi_value_one_field.wado//Maybe\""
    ]
}
