// A closure that writes a captured local clobbers that local's `Box` cell, so
// licm may not hoist a read of it out of the loop. The closure arrives at the
// call as its env struct, never as a `&mut`, so the clobber has to be read off
// the `Box<T>` its capture field holds.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let mut step = builtin::black_box(1);
    let mut bump = || {
        step = 100;
    };
    let mut sum = 0;
    for let mut i = 0; i < 3; i += 1 {
        sum += step;
        bump();
    }
    println(`${sum}`);
}

__DATA__
{
    "stdout": "201\n"
}
