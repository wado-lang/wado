// The re-scan of a splice at a hot site spends hot prices, so a cap sized for a
// plain site runs out inside one hot callee. The site left over is not retried
// on the same terms: `last` grows by its own splices, and by the next round it
// is past what any site takes. The calls it was to bring stay calls in the
// hottest loop of the program.

use { println, Stdout } from "core:cli";

fn leaf_a(x: i32) -> i32 {
    let mut v = x;
    v = (v * 3) ^ (v >> 1);
    v = (v * 5) ^ (v >> 2);
    v = (v * 7) ^ (v >> 3);
    v = (v * 9) ^ (v >> 4);
    v = (v * 11) ^ (v >> 5);
    v = (v * 13) ^ (v >> 6);
    v = (v * 15) ^ (v >> 7);
    v = (v * 17) ^ (v >> 1);
    v = (v * 19) ^ (v >> 2);
    v = (v * 21) ^ (v >> 3);
    v = (v * 23) ^ (v >> 4);
    v = (v * 25) ^ (v >> 5);
    return v;
}

fn leaf_b(x: i32) -> i32 {
    let mut v = x;
    v = (v * 3) ^ (v >> 1);
    v = (v * 5) ^ (v >> 2);
    v = (v * 7) ^ (v >> 3);
    v = (v * 9) ^ (v >> 4);
    v = (v * 11) ^ (v >> 5);
    v = (v * 13) ^ (v >> 6);
    v = (v * 15) ^ (v >> 7);
    v = (v * 17) ^ (v >> 1);
    v = (v * 19) ^ (v >> 2);
    v = (v * 21) ^ (v >> 3);
    v = (v * 23) ^ (v >> 4);
    v = (v * 25) ^ (v >> 5);
    return v;
}

fn leaf_c(x: i32) -> i32 {
    let mut v = x;
    v = (v * 3) ^ (v >> 1);
    v = (v * 5) ^ (v >> 2);
    v = (v * 7) ^ (v >> 3);
    v = (v * 9) ^ (v >> 4);
    v = (v * 11) ^ (v >> 5);
    v = (v * 13) ^ (v >> 6);
    v = (v * 15) ^ (v >> 7);
    v = (v * 17) ^ (v >> 1);
    v = (v * 19) ^ (v >> 2);
    v = (v * 21) ^ (v >> 3);
    v = (v * 23) ^ (v >> 4);
    v = (v * 25) ^ (v >> 5);
    return v;
}

fn leaf_d(x: i32) -> i32 {
    let mut v = x;
    v = (v * 3) ^ (v >> 1);
    v = (v * 5) ^ (v >> 2);
    v = (v * 7) ^ (v >> 3);
    v = (v * 9) ^ (v >> 4);
    v = (v * 11) ^ (v >> 5);
    v = (v * 13) ^ (v >> 6);
    v = (v * 15) ^ (v >> 7);
    v = (v * 17) ^ (v >> 1);
    v = (v * 19) ^ (v >> 2);
    v = (v * 21) ^ (v >> 3);
    v = (v * 23) ^ (v >> 4);
    v = (v * 25) ^ (v >> 5);
    return v;
}

fn leaf_e(x: i32) -> i32 {
    let mut v = x;
    v = (v * 3) ^ (v >> 1);
    v = (v * 5) ^ (v >> 2);
    v = (v * 7) ^ (v >> 3);
    v = (v * 9) ^ (v >> 4);
    v = (v * 11) ^ (v >> 5);
    v = (v * 13) ^ (v >> 6);
    v = (v * 15) ^ (v >> 7);
    v = (v * 17) ^ (v >> 1);
    v = (v * 19) ^ (v >> 2);
    v = (v * 21) ^ (v >> 3);
    v = (v * 23) ^ (v >> 4);
    v = (v * 25) ^ (v >> 5);
