// A trait's default method body is materialized per impl, but resolves in the
// module that declares it. So it may name that module's private items and its
// own bounds, whatever the implementor's module happens to import — here
// `Pick`, which the bound on `pick` names and this module never imports.

use { Source, Doubled } from "./sub/trait_default_body_declaring_module_lib.wado";

struct Counter {
    n: i32,
}

impl Source for Counter {
    fn next(&mut self) -> i32 {
        self.n += 1;
        return self.n;
    }
}

export fn run() {
    let mut counter = Counter { n: 0 };
    assert counter.pick(Doubled {}) == 2;
    assert counter.scaled() == 6;
    assert counter.tallied() == 7;
}

__DATA__
{
    "stdout": ""
}
