// Test: struct literal syntax in if-condition is a compile error.
// `if state { value: 1 }` parses as: condition `state`, then block `{ value: 1 }`.
// Inside the block, `value: 1` is not a valid statement, so it fails.
// To use a struct literal in a condition, wrap it in parentheses:
//   if (state == State { value: 1 }) { ... }

struct State { value: i32 }

fn check(state: State) -> i32 {
    if state { value: 1 } {
        return 1;
    }
    return 0;
}

export fn run() {
    check(State { value: 1 });
}

__DATA__
{"compile_error": "expected"}
