// The memory64 memory is addressed by i64, so it reaches past the 4 GiB linear
// memory stops at. A value stored past 4 GiB reads back, the copies between
// the two memories move bytes each way, and linear memory keeps its own
// bytes at the same addresses.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let pages = 65536 as i64 + 1;
    assert builtin::memory64_size() == 0;
    assert builtin::memory64_grow(pages) == 0;
    assert builtin::memory64_size() == pages;

    let far = 65536 as i64 * 65536 + 8;
    builtin::memory64_store(far, 0x0807060504030201 as i64);
    builtin::memory64_store(far + 8, 1.5 as f32);
    println(`far ${builtin::memory64_load::<i64>(far):x} ${builtin::memory64_load::<f32>(far + 8)} byte ${builtin::memory64_load::<u8>(far + 1)}`);

    builtin::memory64_copy(16, far, 12);
    builtin::memory64_fill(far, 0, 12);
    println(`moved ${builtin::memory64_load::<i64>(16):x} cleared ${builtin::memory64_load::<i64>(far)}`);

    let p = builtin::realloc(0, 0, 16, 16);
    builtin::store(p, 0x55 as i64);
    builtin::memory64_store(p as i64, 0x66 as i64);
    println(`apart ${builtin::load::<i64>(p):x} ${builtin::memory64_load::<i64>(p as i64):x}`);
    builtin::store(p, -1 as i64);
    builtin::copy_from_memory64(p, 16, 8);
    println(`to linear ${builtin::load::<i64>(p):x}`);
    builtin::store(p, 0x1122 as i64);
    builtin::copy_to_memory64(far, p, 8);
    println(`to memory64 ${builtin::memory64_load::<i64>(far):x}`);
}

__DATA__
{
  "stdout": "far 807060504030201 1.5 byte 2\nmoved 807060504030201 cleared 0\napart 55 66\nto linear 807060504030201\nto memory64 1122\n"
}
