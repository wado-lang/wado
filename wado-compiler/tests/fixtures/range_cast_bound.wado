// A bound written as a cast compares as the value the cast yields.
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let truncated = (3.5 as i32)..=3;
    let from_char = ('a' as i32)..<98;
    println(`${truncated.contains(&3)} ${from_char.contains(&97)}`);
}

__DATA__
{
    "stdout": "true true\n"
}
