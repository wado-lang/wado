// Rank 1 reads the newtype chain and nothing else reads the module: the blanket
// holding at the newtype wins over the one holding only at the base, whichever
// of the two is written here (WEP 2026-09-01).

use { Limit, Base, Describe, Inner } from "./sub/trait_depth_lib.wado";
use { } from "./sub/trait_depth_foreign_blanket.wado";

type Wrapped = Inner;

impl Limit for Wrapped {
    fn limit() -> i32 {
        return 7;
    }
}

impl Base for Inner {
    fn base() -> i32 {
        return 9;
    }
}

impl<T: Base> Describe for T {
    fn describe(&self) -> String {
        return `base:${T::base()}`;
    }
}

test "a bound holding at the newtype beats a local one holding at the base" {
    let w = Inner { x: 1 } as Wrapped;
    assert w.describe() == "limit:7";
}

__DATA__
{"test": {}}
