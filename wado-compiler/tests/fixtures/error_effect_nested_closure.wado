// A closure written inside another closure is solved like any other: calling
// it performs what its body does, and the outer closure performs that too.
use { println, Stdout } from "core:cli";

fn f() {
    let outer = || {
        let g = || { println("x"); };
        g();
    };
    outer();
}

export fn run() with Stdout {
    f();
}

