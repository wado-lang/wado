// Test: Assert inspect output for reference intermediates
// &T and &mut T should show "&value" / "&mut value" in assert failure messages

export fn run() with Stdout {
    let x = 42;
    let r = &x;
    assert *r == 99;
}

__DATA__
{
    "trapped": true,
    "stderr_contains": ["condition: *r == 99", "r: &42", "*r: 42"]
}
