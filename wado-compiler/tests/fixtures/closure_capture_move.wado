// A closure reaches this frame only through its captures, so a function that
// builds one still decides move and share for every other local.

struct S {
    items: List<i32>,
    tag: i32,
}

fn source() -> List<S> {
    return [S { items: [1], tag: 0 }];
}

test "a captured local handed away keeps its own storage" {
    let src = source();
    let count = || src.len();
    let mut out: List<List<S>> = [];
    out.push(src);
    out[0].push(S { items: [2], tag: 1 });
    assert count() == 1;
    assert out[0].len() == 2;
}

test "a captured local still reads what a later write to the copy misses" {
    let src = source();
    let first_len = || src[0].items.len();
    let mut out = src;
    out[0].items.push(2);
    assert first_len() == 1;
    assert out[0].items.len() == 2;
}

test "a local the closure does not capture is untouched by it" {
    let other = source();
    let src = source();
    let count = || src.len();
    let mut out: List<List<S>> = [];
    out.push(other);
    out[0].push(S { items: [2], tag: 1 });
    assert count() == 1;
    assert out[0].len() == 2;
}

test "a capture read after the closure sees writes through the original" {
    let mut src = source();
    let count = || src.len();
    src.push(S { items: [3], tag: 2 });
    assert count() == 2;
}

test "a closure over one element leaves a sibling loop free to move" {
    let src = source();
    let count = || src.len();
    let mut out: List<S> = [];
    for let s of source() {
        if s.tag == -1 {
            out = [];
        } else {
            out.push(s);
        }
    }
    out[0].items.push(2);
    assert count() == 1;
    assert src[0].items.len() == 1;
    assert out[0].items.len() == 2;
}
