// Only `u8` casts to `char`.

test {
    let x: i32 = 65;
    let c = x as char;  // compile error

    let y: i8 = 65;
    let d = y as char;  // compile error (i8 can be negative)
}

__DATA__
{"compile_error":"cannot cast 'i32' to 'char': use char::from_u32() for a scalar value, or char::try_from() for one that may not be","compile_errors_contains":["cannot cast 'i8' to 'char'"]}
