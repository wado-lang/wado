// TreeMap with many elements
use { println } from "core:cli";
use { TreeMap } from "core:collections";

fn run() with Stdout {
    let mut map = TreeMap::<String, i32>::new();

    // Insert 50 items
    for let mut i = 0; i < 50; i += 1 {
        map.insert(`item{i}`, i);
    }
    assert map.len() == 50;

    // Verify some values
    if let Some(v0) = map.get("item0") {
        assert v0 == 0;
    }
    if let Some(v49) = map.get("item49") {
        assert v49 == 49;
    }

    // Remove every other item (triggers auto-compaction)
    for let mut i = 0; i < 50; i += 2 {
        map.remove(`item{i}`);
    }
    assert map.len() == 25;

    // Remaining items should still be accessible
    assert map.contains_key("item1");
    assert map.contains_key("item3");
    assert !map.contains_key("item0");
    assert !map.contains_key("item2");

    println("large tree: ok");
}

__DATA__
{"stdout": "large tree: ok\n"}
