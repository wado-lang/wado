// A closure costs its captures their confinement, not its whole frame's.
//
// Confinement used to mark every parameter of a closure-building callee as
// escaping, so each caller kept a defensive copy of a value the callee only
// read. `mine` is only read, so it shares `*src`, and the call reads it in
// place.
#[inline(never)]
fn total(xs: List<i32>, tag: i32) -> i32 {
    let bump = || tag + 1;
    return xs.len() + bump();
}

#[inline(never)]
fn caller(src: &List<i32>) -> i32 {
    let mine = *src;
    let n = total(mine, 5);
    return n + mine.len();
}

export fn run() { assert caller(&[1]) == 8; }

__DATA__
{
    "stdout": "",
    "wir_scope": "caller",
    "wir_not_expect:O2": ["array_copy"]
}
