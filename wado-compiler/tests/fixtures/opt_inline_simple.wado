// Test: Basic function inlining
// Small pure functions should be inlined at call sites

fn double(x: i32) -> i32 {
    return x * 2;
}

fn add(a: i32, b: i32) -> i32 {
    return a + b;
}

export fn run() {
    let a = 5;
    let b = double(a);  // Should inline: b = a * 2
    let c = add(b, 3);  // Should inline: c = b + 3
    assert c == 13;
}

__DATA__
