// `global x: T = <never-expr>` is valid because `never` is the bottom type.
// `run` reads the global, so the diverging initializer has run, and trapped,
// before `run` prints anything.
use { println, Stdout } from "core:cli";

global X: i32 = panic("global boom");

export fn run() with Stdout {
    println(`${X}`);
}

__DATA__
{"stderr_contains": ["global boom"], "trapped": true}
