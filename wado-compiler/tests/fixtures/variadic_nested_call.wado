fn identity<..T>(x: [..T]) -> [..T] {
    return x;
}

fn wrap<..T>(x: [..T]) -> [..T] {
    return identity(x);
}

fn double_wrap<..T>(x: [..T]) -> [..T] {
    return wrap(x);
}

export fn run() {
    let a = double_wrap([1, "hello", true]);
    assert a.0 == 1;
    assert a.1 == "hello";
    assert a.2 == true;

    let b = double_wrap([42]);
    assert b.0 == 42;
}

