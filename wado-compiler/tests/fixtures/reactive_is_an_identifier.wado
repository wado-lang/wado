// `reactive` is an identifier like any other.

fn reactive(reactive: i32) -> i32 {
    return reactive + 1;
}

test {
    let reactive = reactive(1);
    assert reactive == 2;
    let mut total = 0;
    for let mut reactive = 0; reactive < 3; reactive += 1 {
        total += reactive;
    }
    assert total == 3;
}
