// `reactive` is an identifier like any other, at the start of a statement and
// of a `for` initializer too.

test {
    let mut reactive = 1;
    reactive = reactive + 1;
    assert reactive == 2;

    let mut total = 0;
    for reactive = 0; reactive < 3; reactive += 1 {
        total += reactive;
    }
    assert total == 3;
    assert reactive == 3;
}
