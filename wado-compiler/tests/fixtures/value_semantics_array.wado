// Value semantics: array assignment creates a copy

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let a: Array<i32> = [1, 2, 3];
    let mut b = a;  // b is a copy of a (value semantics)
    b[0] = 99;  // modifying b does NOT affect a
    println(`a[0]={a[0]}`);  // prints 1 (a is unchanged)
    println(`b[0]={b[0]}`);  // prints 99 (b has the modification)
}

__DATA__
{"stdout": "a[0]=1\nb[0]=99\n"}
