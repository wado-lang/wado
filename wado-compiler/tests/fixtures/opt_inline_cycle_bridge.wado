// Test: a one-call forwarder on a call cycle is spliced into its callers.
//
// `entry` forwards to `scalar`, whose rare paths re-enter `entry`, so all four
// lie on one cycle. Cutting the cycle at `scalar`, its costliest member, leaves
// `entry` free to splice, so the expansion stops at the call to `scalar`.

use { println, Stdout } from "core:cli";

fn entry(x: i32) -> i32 {
    return scalar(x);
}

fn scalar(x: i32) -> i32 {
    if x < 0 {
        return negated(x);
    }
    if x > 1000 {
        return reduced(x);
    }
    return x * 2;
}

fn negated(x: i32) -> i32 {
    return entry(-x) + 1;
}

fn reduced(x: i32) -> i32 {
    return entry(x / 1000) + 2;
}

export fn run() with Stdout {
    let mut total = 0;
    for let i of -2..<builtin::black_box(3) {
        total += entry(i);
    }
    total += entry(builtin::black_box(5000));
    println(`${total}`);
}

__DATA__
{
    "stdout": "26\n",
    "wir_pass": {"O2": ["nir/inline"]},
    "wir_not_expect:O2": [
        "\"opt_inline_cycle_bridge.wado/entry\"("
    ]
}
