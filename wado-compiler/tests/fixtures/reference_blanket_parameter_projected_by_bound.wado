// A blanket over a reference may hold a parameter its receiver does not
// carry, set by a bound's associated type: the call binds it by projecting
// the bound off the referent, as a value blanket's does.
// Regression: the instance was keyed by the referent alone, so the projected
// parameter stayed open and the call was refused at monomorphization.

trait Source with () {
    type Item;
    fn first(&self) -> Self::Item;
}

trait Tag<A> with () {
    fn tag(self) -> A;
}

impl<A, T: Source<Item = A>> Tag<A> for &T {
    #[allow(self_by_value)]
    fn tag(self) -> A { return (*self).first(); }
}

struct Ints { n: i32 }
struct Words { w: String }

impl Source for Ints {
    type Item = i32;
    fn first(&self) -> i32 { return self.n; }
}

impl Source for Words {
    type Item = String;
    fn first(&self) -> String { return self.w; }
}

fn tagged<A, X: Tag<A>>(x: X) -> A {
    return x.tag();
}

fn through_bound<S: Source<Item = i32>>(s: &S) -> i32 {
    return s.tag() + 1;
}

test "the call binds the projected parameter per referent" {
    let ints = Ints { n: 7 };
    let words = Words { w: "seven" };
    assert (&ints).tag() == 7;
    assert (&words).tag() == "seven";
}

test "and so does a call through a bound" {
    let ints = Ints { n: 7 };
    let words = Words { w: "seven" };
    assert tagged::<i32, &Ints>(&ints) == 7;
    assert tagged::<String, &Words>(&words) == "seven";
    assert through_bound(&ints) == 8;
}
