use { println, Stdout } from "core:cli";

fn run() with Stdout {
    // Test u128 multiplication
    let a = u128::from_u64(100 as u64);
    let b = u128::from_u64(200 as u64);
    let mul_result = a * b;
    println(`u128 100 * 200 = {mul_result}`);

    // Test larger multiplication
    let c = u128::from_u64(1000000 as u64);
    let d = u128::from_u64(1000000 as u64);
    let large_mul = c * d;
    println(`u128 1M * 1M = {large_mul}`);

    // Test u128 division
    let div_result = mul_result / a;
    println(`u128 20000 / 100 = {div_result}`);

    // Test u128 remainder
    let e = u128::from_u64(17 as u64);
    let f = u128::from_u64(5 as u64);
    let rem_result = e % f;
    println(`u128 17 % 5 = {rem_result}`);

    // Test i128 multiplication
    let x = i128::from_i64(100 as i64);
    let y = i128::from_i64(-20 as i64);
    let i_mul = x * y;
    println(`i128 100 * (-20) = {i_mul}`);

    // Test i128 division
    let i_div = i_mul / x;
    println(`i128 (-2000) / 100 = {i_div}`);

    // Test i128 remainder with negative numbers
    let neg17 = i128::from_i64(-17 as i64);
    let pos5 = i128::from_i64(5 as i64);
    let i_rem = neg17 % pos5;
    // In Wado (like C/Rust), remainder has same sign as dividend
    println(`i128 (-17) % 5 = {i_rem}`);

    println("Mul/Div tests passed!");
}

__DATA__
{"stdout": "u128 100 * 200 = 20000\nu128 1M * 1M = 1000000000000\nu128 20000 / 100 = 200\nu128 17 % 5 = 2\ni128 100 * (-20) = -2000\ni128 (-2000) / 100 = -20\ni128 (-17) % 5 = -2\nMul/Div tests passed!\n"}
