// A `{ ..base, … }` literal folds through an `__acc` local, which annotate must
// reserve where reify allocates it (WEP 2026-08-24). Reserved nowhere, every
// local index after the literal was off by one and the closure below wrote its
// captured box into the wrong slot.
use { println, Stdout } from "core:cli";
use { TreeMap } from "core:collections";

export fn run() with Stdout {
    let base: TreeMap<String, i32> = { a: 1 };
    let merged: TreeMap<String, i32> = { ..base, b: 2 };

    let mut total = 0;
    let mut bump = || { total += 1; };
    bump();
    bump();

    assert merged.len() == 2;
    assert merged["a"] == 1;
    assert merged["b"] == 2;
    assert base.len() == 1;
    assert total == 2;

    // Two spreads and a nested literal, so the fold allocates around
    // subexpressions that take locals of their own.
    let other: TreeMap<String, i32> = { c: 3 };
    let all: TreeMap<String, i32> = { ..base, ..other, a: 9 };
    let mut seen = 0;
    let mut count = || { seen += 1; };
    count();
    assert all.len() == 2;
    assert all["a"] == 9;
    assert all["c"] == 3;
    assert seen == 1;

    println("literal spread local numbering: ok");
}

__DATA__
{"stdout": "literal spread local numbering: ok\n"}
