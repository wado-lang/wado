// Outside the test world, a build at `-O0` or `-O1` checks the contract of a
// call marked `unchecked`, so a slice past the view traps.

use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let view = "abcdef".as_str_slice().slice(0, 3);
    let past = unchecked view.slice(0, builtin::black_box(5));
    println(`${past.len()}`);
}

__DATA__
{
    "only_opt": ["O0", "O1"],
    "trapped": true
}
