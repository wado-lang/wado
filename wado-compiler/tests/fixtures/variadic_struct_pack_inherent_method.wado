//! An inherent impl over a struct whose type parameter is a pack answers a
//! method call where its target's tuple matches, as a trait impl over it does:
//! the pack takes the elements its fixed neighbours leave.

struct W<..P> {
    t: [..P],
}

impl<..P> W<[..P]> {
    fn one(&self) -> i32 {
        return 1;
    }
}

impl<..P> W<[i32, ..P]> {
    fn head(&self) -> i32 {
        return self.t.0;
    }
}

impl<..P> W<[..P, bool]> {
    fn last_is_bool(&self) -> i32 {
        return 3;
    }
}

trait Two {
    fn two(&self) -> i32;
}

impl<..P> Two for W<[..P]> {
    fn two(&self) -> i32 {
        return 2;
    }
}

test {
    let w = W { t: [1, true] };
    assert w.one() == 1;
    assert w.two() == 2;
    assert w.head() == 1;
}

test "a fixed element ahead of the pack selects the receivers it matches" {
    let w = W { t: [7, true, "x"] };
    assert w.head() == 7;
}

test "a fixed element after the pack selects the receivers it matches" {
    let w = W { t: ["x", 1, true] };
    assert w.last_is_bool() == 3;
}

test "the pack takes no element where the neighbours take them all" {
    let w = W { t: [5] };
    assert w.head() == 5;
}
