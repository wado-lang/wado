// Test global variables with expressions, mutable globals in loops, and cross-function usage
use { println, Stdout } from "core:cli";

global MAX_SIZE: i32 = 100;
global HALF_SIZE: i32 = MAX_SIZE / 2;
global mut total: i32 = 0;
global mut call_count: i32 = 0;
global GREETING: String = "hello";
global PI_APPROX: f64 = 355.0 / 113.0;

fn accumulate(n: i32) {
    total += n;
    call_count += 1;
}

fn get_total() -> i32 {
    return total;
}

fn get_call_count() -> i32 {
    return call_count;
}

fn globals_basic() with Stdout {
    println(`MAX_SIZE={MAX_SIZE}`);
    println(`HALF_SIZE={HALF_SIZE}`);
    println(`GREETING={GREETING}`);
    println(`PI_APPROX={PI_APPROX}`);
}

fn globals_mutable_loop() with Stdout {
    for let mut i = 0; i < 5; i += 1 {
        accumulate(i * 10);
    }
    println(`total={get_total()}`);
    println(`calls={get_call_count()}`);
}

fn globals_conditional() with Stdout {
    let size = HALF_SIZE;
    if size <= MAX_SIZE {
        println("within bounds");
    } else {
        println("out of bounds");
    }
}

export fn run() with Stdout {
    globals_basic();
    globals_mutable_loop();
    globals_conditional();
}

__DATA__
{"stdout": "MAX_SIZE=100\nHALF_SIZE=50\nGREETING=hello\nPI_APPROX=3.1415929203539825\ntotal=100\ncalls=5\nwithin bounds\n"}
