// A chain compares each link as a lone `==` would: references by identity,
// values through `Eq`.

use { println, Stdout } from "core:cli";

struct P { x: i32 }

export fn run() with Stdout {
    let a = P { x: 1 };
    let b = P { x: 1 };
    let ra = &a;
    let rb = &b;
    assert ra == ra == ra;
    assert !(ra == ra == rb);
    assert a == b == P { x: 1 };
    println("ok");
}

__DATA__
{"stdout": "ok\n"}
