// A literal left open past its call, settled by a later use to a type no
// literal can be, is reported where the literal is written.

struct Bx<T> { v: Option<T> }

fn none<T>() -> Bx<T> { return Bx { v: null }; }

fn put<T>(b: Bx<T>, x: T) -> Bx<T> { return Bx { v: Some(x) }; }

fn take_str(b: Bx<String>) -> i32 { return 0; }

test {
    let b = put(none(), 5);
    assert take_str(b) == 0;
}

__DATA__
{"compile_error": ":13:25: type mismatch: expected 'String', found 'i32'"}
