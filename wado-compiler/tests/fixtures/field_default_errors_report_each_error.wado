// A field default is a statement of its own, as a parameter default is: the
// mismatch in one field's default once covered the slot another's left open,
// in a module struct and a local one alike.
fn none<T>() -> Option<T> {
    return null;
}

fn pick<T>(_o: Option<T>) -> i32 {
