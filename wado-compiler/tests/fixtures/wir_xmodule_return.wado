//! Regression test (issue #1415): an imported (non-entry) module that returns a
//! cross-module struct (here an imported Gale parser's `CstNode`) *by value* and
//! then borrows + recurses on it used to lower the binding's local as `i32`
//! instead of a GC ref, producing invalid core Wasm ("expected i32, found (ref
//! $type)").
//!
//! Root cause: `Elaborator::lookup_function_return_type` re-resolved the
//! return-type AST for a callee in the module currently being walked through a
//! reconstructed import scope that dropped namespace imports, yielding a
//! non-canonical `TypeId` for the cross-module struct. It now resolves a
//! same-module callee's signature in the live scope instead.

use { depth } from "./sub/wir_xmodule_return_eval.wado";

test "nested parens give nesting depth" {
    assert depth(&"1") == 1;
    assert depth(&"(1)") == 2;
    assert depth(&"((1))") == 3;
}

__DATA__
{"test": {}}
