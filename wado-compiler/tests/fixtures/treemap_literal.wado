// The `{ key: value }` literal building a `TreeMap`: where the target type
// comes from, mutation after construction, and a value type carrying a
// nullable struct ref.
use { TreeMap } from "core:collections";

struct LNode {
    val: i32,
    next: Option<LNode>,
}

fn sum_values(m: TreeMap<String, i32>) -> i32 {
    let mut total = 0;
    for let entry of m.entries() {
        total = total + *entry.1;
    }
    return total;
}

test "an annotation supplies the map type" {
    let m: TreeMap<String, i32> = { width: 1920, height: 1080 };
    assert m.len() == 2;
    assert m.contains_key("width");
    assert m.contains_key("height");
    assert m["width"] == 1920;
    assert m["height"] == 1080;
}

test "a cast supplies the map type" {
    let m = { a: 1, b: 2, c: 3 } as TreeMap<String, i32>;
    assert m.len() == 3;
    assert m["a"] == 1;
    assert m["c"] == 3;
}

test "an empty literal" {
    let m: TreeMap<String, i32> = {  };
    assert m.len() == 0;
    assert m.is_empty();
}

test "a parameter supplies the map type" {
    assert sum_values({ x: 10, y: 20, z: 30 }) == 60;
}

test "a branch of an if supplies the map type" {
    let flag = true;
    let m: TreeMap<String, i32> = if flag {
        { a: 1 };
    } else {
        { b: 2 };
    };
    assert m["a"] == 1;
    let m2: TreeMap<String, i32> = if !flag {
        { a: 1 };
    } else {
        { b: 2 };
    };
    assert m2["b"] == 2;
}

test "a map built from a literal is mutable" {
    let mut m: TreeMap<String, i32> = { x: 1, y: 2 };
    assert m.len() == 2;
    m["z"] = 3;
    assert m.len() == 3;
    m["x"] = 100;
    assert m["x"] == 100;
}

test "string values" {
    let colors: TreeMap<String, String> = {
        red: "#FF0000",
        green: "#00FF00",
        blue: "#0000FF",
    };
    assert colors.len() == 3;
    assert colors["red"] == "#FF0000";
    assert colors["green"] == "#00FF00";
    assert colors["blue"] == "#0000FF";
}

// A `TreeMap` whose value type carries a nullable struct ref used to ICE at
// codegen on a `ref` vs `ref null` mismatch: the per-entry tuple `[K, V]` from
// `entries()` registered twice for one logical type, once with the value type
// qualified and once not, and the non-null tuple from the array met the
// `ref null` tuple of the iterator's `Option<[K, V]>` return.

test "a TreeMap-valued TreeMap iterates its entries" {
    let mut inner: TreeMap<String, i32> = TreeMap::new();
    inner["z"] = 1;
    inner["a"] = 2;
    let mut outer: TreeMap<String, TreeMap<String, i32>> = TreeMap::new();
    outer["m"] = inner;
    let mut count = 0;
    for let [k, v] of outer.entries() {
        assert *k == "m";
        assert v.len() == 2;
        count += 1;
    }
    assert count == 1;
}

test "a TreeMap with a recursive-struct value iterates its entries" {
    let mut m: TreeMap<String, LNode> = TreeMap::new();
    m["a"] = LNode { val: 7, next: null };
    let mut count = 0;
    for let [k, v] of m.entries() {
        assert *k == "a";
        assert v.val == 7;
        count += 1;
    }
    assert count == 1;
}
