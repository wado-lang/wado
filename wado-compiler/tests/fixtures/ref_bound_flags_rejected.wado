// A `flags` value is a `u32` bitmask, not a GC reference, so it does not satisfy
// `T: Ref`.

flags Perms {
    Read,
    Write,
}

fn accepts_ref<T: Ref>(x: &T) -> i32 {
    return 1;
}

test "unreachable" {
    let p = Perms::Read;
    assert accepts_ref(&p) == 1;  // flags is not Ref
}

__DATA__
{
    "test": {},
    "compile_error": "does not implement trait 'Ref'"
}
