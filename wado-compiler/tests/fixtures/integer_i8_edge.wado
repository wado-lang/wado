// Test i8 edge cases: min/max values and negative numbers
use { println, Stdout } from "core:cli";

fn run() with Stdout {
    // Max value: 127
    let max: i8 = 127 as i8;
    println(`max: {max}`);

    // Min value: -128
    let min: i8 = -128 as i8;
    println(`min: {min}`);

    // Negative arithmetic
    let neg: i8 = -50 as i8;
    let pos: i8 = 30 as i8;
    let sum = neg + pos;
    println(`neg + pos: {sum}`);

    // Negative division
    let div_result: i8 = -10 as i8 / 3 as i8;
    println(`-10 / 3: {div_result}`);

    // Negative modulo
    let mod_result: i8 = -10 as i8 % 3 as i8;
    println(`-10 % 3: {mod_result}`);
}

__DATA__
{"stdout": "max: 127\nmin: -128\nneg + pos: -20\n-10 / 3: -3\n-10 % 3: -1\n"}
