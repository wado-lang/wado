// The `E` in `with E => h do` must name an effect or resource. A plain trait
// declares no operations to dispatch, so it is rejected, not installed as a no-op.

trait Plain with () {
    fn ping(&self) -> i32;
}

struct H {
    n: i32,
}

impl Plain for H {
    fn ping(&self) -> i32 {
        return self.n;
    }
}

export fn run() {
    let h = H { n: 1 };
    with Plain => &h do {
        let _ = h.ping();
    }
}

