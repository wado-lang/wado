// A cast hands its operand on unchanged, so `return r as Named` shares `r` as
// `return r` does, and the value is copied once, by the caller.

use { println, Stdout } from "core:cli";

struct Rec {
    name: String,
}

type Named = Rec;

#[inline(never)]
fn named(base: &Rec) -> Named {
    let r = *base;
    return r as Named;
}

export fn run() with Stdout {
    let base = builtin::black_box(Rec { name: "a" });
    let mut out = named(&base);
    out.name.push_str("!");
    println(`${base.name} ${out.name}`);
}

__DATA__
{
    "wir_pass": {"O2": ["lower/value_copy/share"]},
    "stdout": "a a!\n",
    "wir_scope": "value_copy_returned_cast_binding_shares.wado/named\"",
    "wir_not_expect:O2": ["array_copy"]
}
