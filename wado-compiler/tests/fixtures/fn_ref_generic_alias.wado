// `use { identity as id }` lets an imported generic function be referenced
// by its alias. Both turbofish and expected-fn-type inference work through
// the alias the same as through the original name.

use { identity as id } from "./sub/fn_ref_generic_cross_module_helper.wado";

fn apply_fn(f: fn(i32) -> i32, x: i32) -> i32 {
    return f(x);
}

test "aliased generic turbofish" {
    let f = id::<i32>;
    assert f(42) == 42;
}

test "aliased generic with fn annotation" {
    let f: fn(bool) -> bool = id;
    assert f(true);
}

test "aliased generic to fn parameter" {
    assert apply_fn(id, 7) == 7;
}

__DATA__
{"test": {}}
