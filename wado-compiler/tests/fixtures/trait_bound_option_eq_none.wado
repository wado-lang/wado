// Test: Option None == None
use { println, Stdout } from "core:cli";

export fn run() with Stdout {
    let a: Option<i32> = null;
    let b: Option<i32> = null;
    if a == b {
        println("None == None");
    }
    let c: Option<i32> = Option::<i32>::Some(1);
    let d: Option<i32> = Option::<i32>::Some(2);
    if c != d {
        println("Some(1) != Some(2)");
    }
}

__DATA__
{"stdout": "None == None\nSome(1) != Some(2)\n"}
