use {println, Stdout} from "core:cli";

fn run() with Stdout {
    // Literal coercion: let x: u128 = 42
    let a: u128 = 100;
    println(`u128 literal coercion: low={a.low()}`);

    let b: i128 = 42;
    println(`i128 literal coercion: low={b.low()}`);

    let c: i128 = -100;
    if c.is_negative() {
        println("i128 negative literal coercion works");
    }

    // Cast: 42 as u128
    let d = 200 as u128;
    println(`u128 cast: low={d.low()}`);

    let e = 300 as i128;
    println(`i128 cast: low={e.low()}`);

    // Cast from variable
    let x: i64 = 500;
    let g = x as u128;
    println(`u128 from i64 variable: low={g.low()}`);

    let h = x as i128;
    println(`i128 from i64 variable: low={h.low()}`);

    // Arithmetic with coerced literals
    let sum: u128 = 10;
    let sum2 = sum + u128::from_u64(5 as u64);
    println(`u128 arithmetic: low={sum2.low()}`);

    println("All coercion tests passed!");
}

__DATA__
{"stdout": "u128 literal coercion: low=100\ni128 literal coercion: low=42\ni128 negative literal coercion works\nu128 cast: low=200\ni128 cast: low=300\nu128 from i64 variable: low=500\ni128 from i64 variable: low=500\nu128 arithmetic: low=15\nAll coercion tests passed!\n"}
