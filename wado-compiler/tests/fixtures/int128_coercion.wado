use { println, Stdout } from "core:cli";

fn run() with Stdout {
    // Literal coercion: let x: u128 = 42
    let a: u128 = 100;
    println(`u128 literal coercion: {a}`);

    let b: i128 = 42;
    println(`i128 literal coercion: {b}`);

    let c: i128 = -100;
    println(`i128 negative literal coercion: {c}`);

    // Cast: 42 as u128
    let d = 200 as u128;
    println(`u128 cast: {d}`);

    let e = 300 as i128;
    println(`i128 cast: {e}`);

    // Cast from variable
    let x: i64 = 500;
    let g = x as u128;
    println(`u128 from i64 variable: {g}`);

    let h = x as i128;
    println(`i128 from i64 variable: {h}`);

    // Arithmetic with coerced literals
    let sum: u128 = 10;
    let sum2 = sum + u128::from_u64(5 as u64);
    println(`u128 arithmetic: {sum2}`);

    println("All coercion tests passed!");
}

__DATA__
{"stdout": "u128 literal coercion: 100\ni128 literal coercion: 42\ni128 negative literal coercion: -100\nu128 cast: 200\ni128 cast: 300\nu128 from i64 variable: 500\ni128 from i64 variable: 500\nu128 arithmetic: 15\nAll coercion tests passed!\n"}
