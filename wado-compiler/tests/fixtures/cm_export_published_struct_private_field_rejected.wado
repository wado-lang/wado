// A package publishes a type by declaring it `export` or by adopting it with
// `export use`. WIT shows every field of a record, so a published struct has
// no field that is not `pub`, and only a type can be published. `export use`
// adopts another package's type under one name; a type of this package is
// published by its `export`. A WIT interface owns a type a `#[cm]` binds, and
// WIT has no generic type and gives a resource no `export use`.

export use { Uuid } from "core:uuid";
export use { join } from "core:fs";
export use { FileType as Kind, FileType as Sort } from "core:fs";
export use { S } from "./sub/cross_module_same_name_bound_alias_dep.wado";
export use { ErrorCode, Fields } from "wasi:http";
export use { TreeMap } from "core:collections";

export struct Secret {
    pub a: i32,
    b: i32,
}

