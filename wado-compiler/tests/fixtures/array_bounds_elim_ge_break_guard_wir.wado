// A loop guard written `if i >= n { break; }` leaves `i < n` after it as
// `while i < n` does, so with the floor its entry gives, it proves the whole
// index contract `0 <= index < self.len()`.

use { println, Stdout } from "core:cli";

#[inline(never)]
fn sum(xs: &List<i32>) -> i32 {
    let mut s = 0;
    let mut i = 0;
    loop {
        if i >= xs.len() {
            break;
        }
        s += xs[i];
        i += 1;
    }
    return s;
}

export fn run() with Stdout {
    let xs: List<i32> = [1, 2, 3];
    println(`${sum(&builtin::black_box(xs))}`);
}

__DATA__
{
    "stdout": "6\n",
    "wir_scope": "sum",
    "wir_not_expect:O2": [
        "cold_path"
    ]
}
