// A generic associated type's pack parameter is rejected where it is
// declared, and a spread of it in a bound or a binding reports nothing more.

trait Tr<X> with () {}

trait Store with () {
    type Packed<..T>: Tr<[..T]>;
}

struct Bags {}

impl Store for Bags {
    type Packed<..T> = [..T];
}

export fn run() {}

__DATA__
{
  "compile_error": ":7:17: analysis error: associated type `Packed` takes only plain type parameters, which `T` is not"
}
