pub fn "i128^Shl::shl"(self: &i128, rhs: u32) -> i128 {
    let shift: i32 = rhs as i32;
    if (shift >= 128) {
        return "core::prelude/int128.wado::i128::from_i64"(0);
    }
    if (shift >= 64) {
        let s: u64 = (shift - 64) as u64;
        return i128 { low: 0, high: (self.low << s) as i64 };
    }
    if (shift == 0) {
        return *self;
    }
    let s: u64 = shift as u64;
    let inv_s: u64 = (64 - shift) as u64;
    return i128 { low: (self.low << s), high: ((self.high as u64 << s) | (self.low >> inv_s)) as i64 };
}

pub fn "i128^Shr::shr"(self: &i128, rhs: u32) -> i128 {
    let shift: i32 = rhs as i32;
    if (shift >= 128) {
        if (self.high < 0) {
            return i128 { low: 0xFFFFFFFFFFFFFFFF, high: -1 };
        } else {
            return "core::prelude/int128.wado::i128::from_i64"(0);
        }
    }
    if (shift >= 64) {
        let s: i64 = (shift - 64) as i64;
        let sign_ext: i64 = if (self.high < 0) {
            -1;
        } else {
            0;
        };
        return i128 { low: (self.high >> s) as u64, high: sign_ext };
    }
    if (shift == 0) {
        return *self;
    }
    let s: u64 = shift as u64;
    let inv_s: u64 = (64 - shift) as u64;
    return i128 { low: ((self.low >> s) | (self.high as u64 << inv_s)), high: (self.high >> s as i64) };
}

