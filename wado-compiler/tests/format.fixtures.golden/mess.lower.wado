// --- Module: wasi:cli ---
pub enum ErrorCode {
    Io,
    IllegalByteSequence,
    Pipe,
}

pub fn "ErrorCode^Eq::eq"(self: &ErrorCode, other: &ErrorCode) -> bool {
    return (*self == *other);
}

pub fn "ErrorCode^Ord::cmp"(self: &ErrorCode, other: &ErrorCode) -> Ordering {
    let a: ErrorCode = *self;
    let b: ErrorCode = *other;
    if (a < b) {
        return Ordering::Less;
    }
    if (a > b) {
        return Ordering::Greater;
    }
    return Ordering::Equal;
}

pub fn "ErrorCode^Inspect::inspect"(self: &ErrorCode, f: &mut Formatter) {
    if (*self == 0) {
        f.Formatter::write_str("ErrorCode::Io");
    } else {
        if (*self == 1) {
            f.Formatter::write_str("ErrorCode::IllegalByteSequence");
