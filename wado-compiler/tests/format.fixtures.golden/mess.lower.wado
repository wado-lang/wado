pub fn i128::from_string(s: String) -> i128 {
    let len: i32 = s.String::len();
    if (len == 0) {
        return "core::prelude/int128.wado::i128::zero"();
    }
    let bytes: builtin::array<u8> = s.String::internal_raw_bytes();
    let first_byte: u8 = core::builtin::array_get_u8(bytes, 0);
    let is_negative: bool = (first_byte == '-' as u8);
    let start_idx: i32 = if is_negative {
        1;
    } else {
        0;
    };
    let mut abs_value: u128 = "core::prelude/int128.wado::u128::zero"();
    let mut i: i32 = start_idx;
    let ten: u128 = "core::prelude/int128.wado::u128::from_u64"(10);
    loop {
        if !(i < len) {
            break;
        }
        let byte: u8 = core::builtin::array_get_u8(bytes, i);
        let digit: i32 = (byte as i32 - '0' as i32);
        if ((0 <= digit) && (digit <= 9)) {
            abs_value = abs_value."u128^Mul::mul"(&ten)."u128^Add::add"(&"core::prelude/int128.wado::u128::from_u64"(digit as u64));
        }
        i = (i + 1);
    }
    let result: i128 = i128 { low: abs_value.low, high: abs_value.high as i64 };
    if is_negative {
        return result.i128::neg();
    }
    return result;
}

