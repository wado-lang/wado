pub enum Ordering {
    Less,
    Equal,
    Greater,
}

pub fn "Ordering^Eq::eq"(self: &Ordering, other: &Ordering) -> bool {
    return (*self == *other);
}

pub fn "Ordering^Ord::cmp"(self: &Ordering, other: &Ordering) -> Ordering {
    let a: Ordering = *self;
    let b: Ordering = *other;
    if (a < b) {
        return Ordering::Less;
    }
    if (a > b) {
        return Ordering::Greater;
    }
    return Ordering::Equal;
}

pub fn "Ordering^Inspect::inspect"(self: &Ordering, f: &mut Formatter) {
    if (*self == 0) {
        f.Formatter::write_str("Ordering::Less");
    } else {
        if (*self == 1) {
            f.Formatter::write_str("Ordering::Equal");
        } else {
            if (*self == 2) {
                f.Formatter::write_str("Ordering::Greater");
            };
        };
    };
}

