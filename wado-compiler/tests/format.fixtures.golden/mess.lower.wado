fn fmt_float_special(f: &mut Formatter, is_neg: bool, kind: SpecialKind, zero_repr: String) {
    let mark: i32 = f.Formatter::mark();
    if match kind {
        NaN => true,
        _ => false,
    } {
        f.buf.String::append("NaN");
    } else {
        if match kind {
            Inf => true,
            _ => false,
        } {
            f.buf.String::append(if is_neg {
                "-inf";
            } else {
                "inf";
            });
        } else {
            f.buf.String::append(if is_neg {
                "-";
            } else {
                "";
            });
            f.buf.String::append(zero_repr);
        }
    }
    f.Formatter::apply_padding(mark);
}

fn fmt_float_sign(f: &mut Formatter, is_neg: bool) {
    if is_neg {
        f.buf.String::append("-");
    } else {
        if f.sign_plus {
            f.buf.String::append("+");
        }
    }
}

