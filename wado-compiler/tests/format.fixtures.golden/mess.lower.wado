fn i128::fmt_decimal(self: &i128, f: &mut Formatter) {
    let is_neg: bool = self.i128::is_negative();
    let abs_val: u128 = self.i128::abs_u128();
    if ((abs_val.low == 0) && (abs_val.high == 0)) {
        let offset: i32 = f.Formatter::prepare_int_write(false, "", 1);
        let arr: builtin::array<u8> = f.buf.String::internal_raw_bytes();
        core::builtin::array_set_u8(arr, offset, '0' as u8);
        return;
    }
    let ten: u128 = "core::prelude/int128.wado::u128::from_u64"(10);
    let mut temp: u128 = abs_val;
    let mut digit_count: i32 = 0;
    __for_2: {
        let mut temp: u128 = abs_val;
        loop {
            if !(temp."u128^Ord::cmp"(&"core::prelude/int128.wado::u128::from_u64"(0)) == Ordering::Greater) {
                break __for_2;
            }
            __for_2_body: {
                digit_count = (digit_count + 1);
            }
            temp = temp."u128^Div::div"(&ten);
        }
    }
    let offset: i32 = f.Formatter::prepare_int_write(is_neg, "", digit_count);
    let arr: builtin::array<u8> = f.buf.String::internal_raw_bytes();
    let mut pos: i32 = (offset + digit_count);
    temp = abs_val;
    __for_3: {
        let mut temp: u128 = abs_val;
        loop {
            if !(temp."u128^Ord::cmp"(&"core::prelude/int128.wado::u128::from_u64"(0)) == Ordering::Greater) {
                break __for_3;
            }
            __for_3_body: {
                pos = (pos - 1);
                let digit: i32 = temp."u128^Rem::rem"(&ten).u128::low() as i64 as i32;
                core::builtin::array_set_u8(arr, pos, ('0' as i32 + digit) as u8);
            }
            temp = temp."u128^Div::div"(&ten);
        }
    }
}

fn i128::fmt_base(self: &i128, f: &mut Formatter, base: i32, upper: bool) {
    let is_neg: bool = self.i128::is_negative();
    let abs_val: u128 = self.i128::abs_u128();
    let bits_per_digit: i32 = if (base == 2) {
        1;
    } else {
        if (base == 8) {
            3;
        } else {
            4;
        };
    };
    let mask: u64 = (base - 1) as u64;
    let prefix: String = if f.alternate {
        if (base == 2) {
            "0b";
        } else {
            if (base == 8) {
                "0o";
            } else {
                if upper {
                    "0X";
                } else {
                    "0x";
                }
            }
        }
    } else {
        "";
    };
    let is_zero: bool = abs_val."u128^Eq::eq"(&"core::prelude/int128.wado::u128::from_u64"(0));
    let digit_count: i32 = if is_zero {
        1;
    } else {
        let mut highest_bit: i32 = 0;
        let h: i64 = abs_val.high as i64;
        let l: i64 = abs_val.low as i64;
        if (h != 0) {
            let mut b: i32 = 63;
            loop {
                if !(b >= 0) {
                    break;
                }
                let one: i64 = 1;
                if (((h >> b as i64) & one) != 0) {
                    highest_bit = (64 + b);
                    break;
                }
                b = (b - 1);
            }
        } else {
            let mut b: i32 = 63;
            loop {
                if !(b >= 0) {
                    break;
                }
                let one: i64 = 1;
                if (((l >> b as i64) & one) != 0) {
                    highest_bit = b;
                    break;
                }
                b = (b - 1);
            }
        }
        ((highest_bit / bits_per_digit) + 1);
    };
    let offset: i32 = f.Formatter::prepare_int_write(is_neg, prefix, digit_count);
    let arr: builtin::array<u8> = f.buf.String::internal_raw_bytes();
    if is_zero {
        core::builtin::array_set_u8(arr, offset, '0' as u8);
    } else {
        let mut pos: i32 = (offset + digit_count);
        let mut lo: u64 = abs_val.low;
        let mut hi: u64 = abs_val.high;
        let shift_u64: u64 = bits_per_digit as u64;
        loop {
            if !((lo != 0) || (hi != 0)) {
                break;
            }
            pos = (pos - 1);
            let digit: i32 = (lo & mask) as i32;
            let ch: i32 = if (digit < 10) {
                ('0' as i32 + digit);
            } else {
                if upper {
                    (('A' as i32 + digit) - 10);
                } else {
                    (('a' as i32 + digit) - 10);
                };
            };
            core::builtin::array_set_u8(arr, pos, ch as u8);
            let hi_bits: u64 = (hi << (64 - shift_u64));
            lo = ((lo >> shift_u64) | hi_bits);
            hi = (hi >> shift_u64);
        }
    }
}

