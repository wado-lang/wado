    let s: u64 = shift as u64;
    let inv_s: u64 = (64 - shift) as u64;
    return u128 { low: (self.low << s), high: ((self.high << s) | (self.low >> inv_s)) };
}

pub fn "u128^Shr::shr"(self: &u128, rhs: u32) -> u128 {
    let shift: i32 = rhs as i32;
    if (shift >= 128) {
        return "core::prelude/int128.wado::u128::zero"();
    }
    if (shift >= 64) {
        let s: u64 = (shift - 64) as u64;
        return u128 { low: (self.high >> s), high: 0 };
    }
    if (shift == 0) {
        return *self;
