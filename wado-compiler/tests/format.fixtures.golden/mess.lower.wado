pub fn i128::div_rem(self: &i128, divisor: &i128) -> [i128, i128] {
    if ((divisor.low == 0) && (divisor.high == 0)) {
        core::internal::panic("i128 division by zero");
    }
    let dividend_neg: bool = self.i128::is_negative();
    let divisor_neg: bool = divisor.i128::is_negative();
    let abs_dividend: u128 = self.i128::abs_u128();
    let abs_divisor: u128 = divisor.i128::abs_u128();
    let result: [u128, u128] = abs_dividend.u128::div_rem(&abs_divisor);
    let abs_quotient: u128 = result.0;
    let abs_remainder: u128 = result.1;
    let mut quotient: i128 = "core::prelude/int128.wado::i128::from_u128"(abs_quotient);
    if (dividend_neg != divisor_neg) {
        quotient = quotient.i128::neg();
    }
    let mut remainder: i128 = "core::prelude/int128.wado::i128::from_u128"(abs_remainder);
    if dividend_neg {
        remainder = remainder.i128::neg();
    }
    return [quotient, remainder];
}

