pub fn write_to_stream(tx: i32, message: <TypeId(20)>, add_newline: bool) {
    let len: i32 = message.String::len();
    let msg_bytes: builtin::array<u8> = message.String::internal_raw_bytes();
    let alloc_size: i32 = if add_newline {
        (len + 1);
    } else {
        len;
    };
    let ptr: i32 = core::builtin::realloc(0, 0, 1, alloc_size);
    __for_0: {
        let mut i: i32 = 0;
        loop {
            if !(i < len) {
                break __for_0;
            }
            __for_0_body: {
                let byte: u8 = core::builtin::array_get_u8(msg_bytes, i);
                core::builtin::i32_store8((ptr + i), byte);
            }
            i = (i + 1);
        }
