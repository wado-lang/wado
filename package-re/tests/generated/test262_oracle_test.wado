}

test "false" {
    assert spans(#"false"#, "false") == "0..5";
}

test "foo" {
    assert spans(#"foo"#, "xfoox") == "1..4";
}

test "four" {
    assert spans(#"four"#, "one two three four five") == "14..18";
}

test "java(script)?" {
    assert spans(#"java(script)?"#, "state: javascript is extension of ecma script") == "7..17,11..17";
    assert spans(#"java(script)?"#, "state: java and javascript are vastly different") == "7..11,- 16..26,20..26";
    assert spans(#"java(script)?"#, "state: both Java and JavaScript used in web development") == "";
}

