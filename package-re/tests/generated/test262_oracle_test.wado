}

test "World" {
    assert spans(#"World"#, "Hello World!") == "6..11";
}

test "X" {
    assert spans(#"X"#, "a b c de f") == "";
}

test "[\"'][^\"']*[\"']" {
    assert spans(#"["'][^"']*["']"#, "alice \"sweep\": \"don't\"") == "6..13 15..20";
    assert spans(#"["'][^"']*["']"#, "alice cries out: 'don't'") == "17..22";
    assert spans(#"["'][^"']*["']"#, "alice cries out: don't") == "";
    assert spans(#"["'][^"']*["']"#, "alice cries out:\"\"") == "16..18";
}

