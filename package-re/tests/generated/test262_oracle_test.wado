}

test "b{2}c" {
    assert spans(#"b{2}c"#, "aaabbbbcccddeeeefffff") == "5..8";
}

test "b{42,93}c" {
    assert spans(#"b{42,93}c"#, "aaabbbbcccddeeeefffff") == "";
}

