    assert spans(#"abc"#, "abc") == "0..3";
    assert spans(#"abc"#, "abcd") == "0..3";
}

test "abcd" {
    assert spans(#"abcd"#, "abcd") == "0..4";
}

test "ab{2,4}c$" {
    assert spans(#"ab{2,4}c$"#, "abbc") == "0..4";
    assert spans(#"ab{2,4}c$"#, "abbbc") == "0..5";
    assert spans(#"ab{2,4}c$"#, "abbbbc") == "0..6";
    assert spans(#"ab{2,4}c$"#, "xabbc") == "1..5";
    assert spans(#"ab{2,4}c$"#, "xabbbc") == "1..6";
    assert spans(#"ab{2,4}c$"#, "xabbbbc") == "1..7";
    assert spans(#"ab{2,4}c$"#, "ac") == "";
    assert spans(#"ab{2,4}c$"#, "abc") == "";
    assert spans(#"ab{2,4}c$"#, "abbcx") == "";
    assert spans(#"ab{2,4}c$"#, "bbc") == "";
    assert spans(#"ab{2,4}c$"#, "abb") == "";
    assert spans(#"ab{2,4}c$"#, "abbbbbc") == "";
}

