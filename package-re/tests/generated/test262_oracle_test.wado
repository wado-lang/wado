    assert spans(#"AB"#, "ssABBABABAB") == "2..4 5..7 7..9 9..11";
}

test "AL|se" {
    assert spans(#"AL|se"#, "false") == "3..5";
}

test "Four" {
    assert spans(#"Four"#, "one two three four five") == "";
}

test "String" {
