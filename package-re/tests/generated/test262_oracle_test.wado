test "^(([a-z]+)*([a-z])\\.)+[a-z]{2,}$" {
    assert spans(#"^(([a-z]+)*([a-z])\.)+[a-z]{2,}$"#, "www.netscape.com") == "0..16,4..13,4..11,11..12";
}

test "^(([a-z]+)*[a-z]\\.)+[a-z]{2,}$" {
    assert spans(#"^(([a-z]+)*[a-z]\.)+[a-z]{2,}$"#, "www.netscape.com") == "0..16,4..13,4..11";
}

test "^(A)?(A.*)$" {
    assert spans(#"^(A)?(A.*)$"#, "AAA") == "0..3,0..1,1..3";
    assert spans(#"^(A)?(A.*)$"#, "AA") == "0..2,0..1,1..2";
    assert spans(#"^(A)?(A.*)$"#, "A") == "0..1,-,0..1";
}

test "^([a-z]+)*[a-z]$" {
    assert spans(#"^([a-z]+)*[a-z]$"#, "a") == "0..1,-";
    assert spans(#"^([a-z]+)*[a-z]$"#, "ab") == "0..2,0..1";
    assert spans(#"^([a-z]+)*[a-z]$"#, "abc") == "0..3,0..2";
}

test "^.$" {
    assert spans(#"^.$"#, "a") == "0..1";
    assert spans(#"^.$"#, "3") == "0..1";
    assert spans(#"^.$"#, "\u{3C0}") == "0..2";
    assert spans(#"^.$"#, "\u{2027}") == "0..3";
    assert spans(#"^.$"#, "\u{85}") == "0..2";
    assert spans(#"^.$"#, "\u{B}") == "0..1";
    assert spans(#"^.$"#, "\u{C}") == "0..1";
    assert spans(#"^.$"#, "\u{180E}") == "0..3";
    assert spans(#"^.$"#, "\u{10300}") == "0..4";
    assert spans(#"^.$"#, "\u{A}") == "";
    assert spans(#"^.$"#, "\u{D}") == "";
    assert spans(#"^.$"#, "\u{2028}") == "";
    assert spans(#"^.$"#, "\u{2029}") == "";
}

test "^.*(:|$)" {
    assert spans(#"^.*(:|$)"#, "Hello: World") == "0..12,12..12";
}

