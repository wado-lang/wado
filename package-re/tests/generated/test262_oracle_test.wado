test "(?m:(^a$)|(?:^b$)|(?-m:^c$)|(?:^d$)|(^e$))" {
    assert spans(#"(?m:(^a$)|(?:^b$)|(?-m:^c$)|(?:^d$)|(^e$))"#, "\u{A}a\u{A}") == "1..2,1..2,-";
    assert spans(#"(?m:(^a$)|(?:^b$)|(?-m:^c$)|(?:^d$)|(^e$))"#, "\u{A}b\u{A}") == "1..2,-,-";
    assert spans(#"(?m:(^a$)|(?:^b$)|(?-m:^c$)|(?:^d$)|(^e$))"#, "\u{A}c\u{A}") == "";
    assert spans(#"(?m:(^a$)|(?:^b$)|(?-m:^c$)|(?:^d$)|(^e$))"#, "\u{A}d\u{A}") == "1..2,-,-";
    assert spans(#"(?m:(^a$)|(?:^b$)|(?-m:^c$)|(?:^d$)|(^e$))"#, "\u{A}e\u{A}") == "1..2,-,1..2";
}

