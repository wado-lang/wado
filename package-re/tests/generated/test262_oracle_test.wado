    assert spans(#"true"#, "atruebtruec") == "1..5 6..10";
    assert spans(#"true"#, "true") == "0..4";
}

test "undefined" {
    assert spans(#"undefined"#, "undefined") == "0..9";
}

test "x" {
    assert spans(#"x"#, "[x]") == "1..2";
    assert spans(#"x"#, "abc") == "";
    assert spans(#"x"#, "axbxcxdxe") == "1..2 3..4 5..6 7..8";
    assert spans(#"x"#, "\u{20BB7}a\u{20BB7}b\u{20BB7}") == "";
    assert spans(#"x"#, "\u{20BB7}a\u{20BB7}b\u{20BB7}c\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}d") == "";
    assert spans(#"x"#, "x") == "0..1";
    assert spans(#"x"#, "foo-x-bar") == "4..5";
}

test "x*y+$" {
    assert spans(#"x*y+$"#, "xxxxxxyyyyyy") == "0..12";
}

