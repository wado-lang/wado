test "(?s:(a.a)|(?:b.b)|(?-s:c.c)|(?:d.d)|(e.e))" {
    assert spans(#"(?s:(a.a)|(?:b.b)|(?-s:c.c)|(?:d.d)|(e.e))"#, "a\u{A}a") == "0..3,0..3,-";
    assert spans(#"(?s:(a.a)|(?:b.b)|(?-s:c.c)|(?:d.d)|(e.e))"#, "b\u{A}b") == "0..3,-,-";
    assert spans(#"(?s:(a.a)|(?:b.b)|(?-s:c.c)|(?:d.d)|(e.e))"#, "c\u{A}c") == "";
    assert spans(#"(?s:(a.a)|(?:b.b)|(?-s:c.c)|(?:d.d)|(e.e))"#, "d\u{A}d") == "0..3,-,-";
    assert spans(#"(?s:(a.a)|(?:b.b)|(?-s:c.c)|(?:d.d)|(e.e))"#, "e\u{A}e") == "0..3,-,0..3";
}

test "(?s:.es$)" {
    assert spans(#"(?s:.es$)"#, "\u{A}es") == "0..3";
    assert spans(#"(?s:.es$)"#, "\u{A}es\u{A}z") == "";
}

