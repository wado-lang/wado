    assert spans(#"[^"]*"#, "alice said: \"don't\"") == "0..12 13..18 19..19";
    assert spans(#"[^"]*"#, "before'i'start") == "0..14";
    assert spans(#"[^"]*"#, "alice \"sweep\": \"don't\"") == "0..6 7..12 13..15 16..21 22..22";
}

test "[^\\[\\b\\]]+" {
