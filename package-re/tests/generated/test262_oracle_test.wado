    assert spans(#"ab|cd|ef"#, "AEKFCD") == "";
}

test "a|(b)" {
    assert spans(#"a|(b)"#, "a") == "0..1,-";
}

test "a|ab" {
    assert spans(#"a|ab"#, "abc") == "0..1";
}

test "b" {
    assert spans(#"b"#, "abc") == "1..2";
    assert spans(#"b"#, "ab") == "1..2";
    assert spans(#"b"#, "abcd") == "1..2";
    assert spans(#"b"#, "abc abc abc") == "1..2 5..6 9..10";
    assert spans(#"b"#, "abcba") == "1..2 3..4";
}

test "b(.).(.)" {
    assert spans(#"b(.).(.)"#, "abcdef") == "1..5,2..3,4..5";
}

test "b(.).(.)." {
    assert spans(#"b(.).(.)."#, "abcdefg") == "1..6,2..3,4..5";
    assert spans(#"b(.).(.)."#, "ab\u{1D306}defg") == "1..9,2..6,7..8";
}

test "b(c)" {
    assert spans(#"b(c)"#, "abcd") == "1..3,2..3";
}

test "b(c)(z)?(.)" {
    assert spans(#"b(c)(z)?(.)"#, "abcde") == "1..4,2..3,-,3..4";
}

test "b(c)?" {
    assert spans(#"b(c)?"#, "abd") == "1..2,-";
}

test "b*b+" {
    assert spans(#"b*b+"#, "abbbbbbbc") == "1..8";
}

test "b." {
    assert spans(#"b."#, "abcd") == "1..3";
}

test "b?b?b?b" {
    assert spans(#"b?b?b?b"#, "abbbbc") == "1..5";
}

test "bc" {
    assert spans(#"bc"#, "abcd") == "1..3";
}

test "bc..[\\d]*[\\s]*" {
    assert spans(#"bc..[\d]*[\s]*"#, "abcdef") == "1..5";
}

test "bcd" {
    assert spans(#"bcd"#, "abcd") == "1..4";
}

test "bj" {
    assert spans(#"bj"#, "[object Object]") == "2..4 9..11";
}

