}

test "a" {
    assert spans(#"a"#, "a") == "0..1";
    assert spans(#"a"#, "b") == "";
    assert spans(#"a"#, "ba") == "1..2";
    assert spans(#"a"#, "aba") == "0..1 2..3";
    assert spans(#"a"#, "aaba") == "0..1 1..2 3..4";
    assert spans(#"a"#, "aa") == "0..1 1..2";
    assert spans(#"a"#, "1a2") == "1..2";
    assert spans(#"a"#, "abcd") == "0..1";
    assert spans(#"a"#, "abc") == "0..1";
    assert spans(#"a"#, "nbc") == "";
    assert spans(#"a"#, "\u{20BB7}a\u{20BB7}b\u{20BB7}") == "4..5";
    assert spans(#"a"#, "\u{20BB7}a\u{20BB7}b\u{20BB7}c\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}d") == "4..5";
}

test "a(..(..)..)" {
    assert spans(#"a(..(..)..)"#, "abcdefgh") == "0..7,1..7,3..5";
}

test "a(?<z>b)(ca)" {
    assert spans(#"a(?<z>b)(ca)"#, "abcabcabcabc") == "0..4,1..2,2..4 6..10,7..8,8..10";
}

test "a(b)(ca)" {
    assert spans(#"a(b)(ca)"#, "abcabcabcabc") == "0..4,1..2,2..4 6..10,7..8,8..10";
}

test "a(bc)d(ef)g" {
    assert spans(#"a(bc)d(ef)g"#, "abcdefg") == "0..7,1..3,4..6";
}

test "a.(?s:b.b).c" {
    assert spans(#"a.(?s:b.b).c"#, "a,b,b,c") == "0..7";
    assert spans(#"a.(?s:b.b).c"#, "a,b\u{A}b,c") == "0..7";
    assert spans(#"a.(?s:b.b).c"#, "a\u{A}b\u{A}b,c") == "";
    assert spans(#"a.(?s:b.b).c"#, "a,b\u{A}b\u{A}c") == "";
    assert spans(#"a.(?s:b.b).c"#, "a\u{A}b\u{A}b\u{A}c") == "";
}

test "a.a|(?s:b.b|(?-s:c.c)|d.d|(?s:e.e)|f.f)|g.g|(?-s:h.h)|k.k" {
    assert spans(#"a.a|(?s:b.b|(?-s:c.c)|d.d|(?s:e.e)|f.f)|g.g|(?-s:h.h)|k.k"#, "a\u{A}a") == "";
    assert spans(#"a.a|(?s:b.b|(?-s:c.c)|d.d|(?s:e.e)|f.f)|g.g|(?-s:h.h)|k.k"#, "b\u{A}b") == "0..3";
    assert spans(#"a.a|(?s:b.b|(?-s:c.c)|d.d|(?s:e.e)|f.f)|g.g|(?-s:h.h)|k.k"#, "c\u{A}c") == "";
    assert spans(#"a.a|(?s:b.b|(?-s:c.c)|d.d|(?s:e.e)|f.f)|g.g|(?-s:h.h)|k.k"#, "d\u{A}d") == "0..3";
    assert spans(#"a.a|(?s:b.b|(?-s:c.c)|d.d|(?s:e.e)|f.f)|g.g|(?-s:h.h)|k.k"#, "e\u{A}e") == "0..3";
    assert spans(#"a.a|(?s:b.b|(?-s:c.c)|d.d|(?s:e.e)|f.f)|g.g|(?-s:h.h)|k.k"#, "f\u{A}f") == "0..3";
    assert spans(#"a.a|(?s:b.b|(?-s:c.c)|d.d|(?s:e.e)|f.f)|g.g|(?-s:h.h)|k.k"#, "g\u{A}g") == "";
    assert spans(#"a.a|(?s:b.b|(?-s:c.c)|d.d|(?s:e.e)|f.f)|g.g|(?-s:h.h)|k.k"#, "h\u{A}h") == "";
    assert spans(#"a.a|(?s:b.b|(?-s:c.c)|d.d|(?s:e.e)|f.f)|g.g|(?-s:h.h)|k.k"#, "k\u{A}k") == "";
}

test "a.a|b.b|(?s:c.c)|d.d|e.e" {
    assert spans(#"a.a|b.b|(?s:c.c)|d.d|e.e"#, "a\u{A}a") == "";
    assert spans(#"a.a|b.b|(?s:c.c)|d.d|e.e"#, "b\u{A}b") == "";
    assert spans(#"a.a|b.b|(?s:c.c)|d.d|e.e"#, "c\u{A}c") == "0..3";
    assert spans(#"a.a|b.b|(?s:c.c)|d.d|e.e"#, "d\u{A}d") == "";
    assert spans(#"a.a|b.b|(?s:c.c)|d.d|e.e"#, "e\u{A}e") == "";
}

