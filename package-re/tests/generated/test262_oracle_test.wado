    assert spans(#"11111|111"#, "1111111111111111") == "0..5 5..10 10..15";
}

test "1|12" {
    assert spans(#"1|12"#, "123") == "0..1";
    assert spans(#"1|12"#, "1.01") == "0..1 3..4";
    assert spans(#"1|12"#, "function __string(){}") == "";
}

