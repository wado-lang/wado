    assert spans(#"a[^b-z]\s+"#, "ab an az aY n") == "9..12";
}

test "a[^b]c" {
    assert spans(#"a[^b]c"#, "abc") == "";
}

test "a[a-z]{2,4}" {
    assert spans(#"a[a-z]{2,4}"#, "abcdefghi") == "0..5";
}

