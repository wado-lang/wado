    assert spans(#"(?m:^(?-m:es$))"#, "es") == "0..2";
    assert spans(#"(?m:^(?-m:es$))"#, "es\u{A}s") == "";
    assert spans(#"(?m:^(?-m:es$))"#, "\u{A}es\u{A}s") == "";
    assert spans(#"(?m:^(?-m:es$))"#, "\u{A}es") == "1..3";
}

