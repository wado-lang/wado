test "\\s+java\\s+" {
    assert spans(#"\s+java\s+"#, "language  java\u{A}") == "8..15";
    assert spans(#"\s+java\s+"#, "\u{9} java object") == "0..7";
    assert spans(#"\s+java\s+"#, "\u{9} javax package") == "";
    assert spans(#"\s+java\s+"#, "java\u{A}\u{A}object") == "";
}

