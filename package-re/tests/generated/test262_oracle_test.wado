    assert spans(#"x?y?z?"#, "abcd") == "0..0 1..1 2..2 3..3 4..4";
}

test "xyz|..." {
    assert spans(#"xyz|..."#, "abc") == "0..3";
}

test "x{1,2}x{1,}" {
    assert spans(#"x{1,2}x{1,}"#, "xxxxxxx") == "0..7";
}

test "z" {
    assert spans(#"z"#, "a") == "";
}

test "|()" {
    assert spans(#"|()"#, "") == "0..0,-";
}

test "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}" {
    assert spans(
        #"👨‍👩‍👧‍👦"#,
        "\u{20BB7}a\u{20BB7}b\u{20BB7}c\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}d",
    ) == "15..40";
}

test "\u{20BB7}" {
    assert spans(#"𠮷"#, "\u{20BB7}a\u{20BB7}b\u{20BB7}") == "0..4 5..9 10..14";
    assert spans(
        #"𠮷"#,
        "\u{20BB7}a\u{20BB7}b\u{20BB7}c\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}d",
    ) == "0..4 5..9 10..14";
}
