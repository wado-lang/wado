    assert spans(#"(?m:^.$)"#, "\u{180E}") == "0..3";
    assert spans(#"(?m:^.$)"#, "\u{10300}") == "0..4";
    assert spans(#"(?m:^.$)"#, "\u{A}") == "";
    assert spans(#"(?m:^.$)"#, "\u{D}") == "";
    assert spans(#"(?m:^.$)"#, "\u{2028}") == "";
    assert spans(#"(?m:^.$)"#, "\u{2029}") == "";
}

