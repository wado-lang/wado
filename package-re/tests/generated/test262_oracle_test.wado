test "^^^^^^^robot$$$$" {
    assert spans(#"^^^^^^^robot$$$$"#, "robot") == "0..5";
}

test "^a$|(?m:^b$|(?-m:^c$)|^d$|(?m:^e$)|^f$)|^g$|(?-m:^h$)|^k$" {
    assert spans(#"^a$|(?m:^b$|(?-m:^c$)|^d$|(?m:^e$)|^f$)|^g$|(?-m:^h$)|^k$"#, "\u{A}a\u{A}") == "";
    assert spans(#"^a$|(?m:^b$|(?-m:^c$)|^d$|(?m:^e$)|^f$)|^g$|(?-m:^h$)|^k$"#, "\u{A}b\u{A}") == "1..2";
    assert spans(#"^a$|(?m:^b$|(?-m:^c$)|^d$|(?m:^e$)|^f$)|^g$|(?-m:^h$)|^k$"#, "\u{A}c\u{A}") == "";
    assert spans(#"^a$|(?m:^b$|(?-m:^c$)|^d$|(?m:^e$)|^f$)|^g$|(?-m:^h$)|^k$"#, "\u{A}d\u{A}") == "1..2";
    assert spans(#"^a$|(?m:^b$|(?-m:^c$)|^d$|(?m:^e$)|^f$)|^g$|(?-m:^h$)|^k$"#, "\u{A}e\u{A}") == "1..2";
    assert spans(#"^a$|(?m:^b$|(?-m:^c$)|^d$|(?m:^e$)|^f$)|^g$|(?-m:^h$)|^k$"#, "\u{A}f\u{A}") == "1..2";
    assert spans(#"^a$|(?m:^b$|(?-m:^c$)|^d$|(?m:^e$)|^f$)|^g$|(?-m:^h$)|^k$"#, "\u{A}g\u{A}") == "";
    assert spans(#"^a$|(?m:^b$|(?-m:^c$)|^d$|(?m:^e$)|^f$)|^g$|(?-m:^h$)|^k$"#, "\u{A}h\u{A}") == "";
    assert spans(#"^a$|(?m:^b$|(?-m:^c$)|^d$|(?m:^e$)|^f$)|^g$|(?-m:^h$)|^k$"#, "\u{A}k\u{A}") == "";
}

test "^a$|^b$|(?m:^c$)|^d$|^e$" {
    assert spans(#"^a$|^b$|(?m:^c$)|^d$|^e$"#, "\u{A}a\u{A}") == "";
    assert spans(#"^a$|^b$|(?m:^c$)|^d$|^e$"#, "\u{A}b\u{A}") == "";
    assert spans(#"^a$|^b$|(?m:^c$)|^d$|^e$"#, "\u{A}c\u{A}") == "1..2";
    assert spans(#"^a$|^b$|(?m:^c$)|^d$|^e$"#, "\u{A}d\u{A}") == "";
    assert spans(#"^a$|^b$|(?m:^c$)|^d$|^e$"#, "\u{A}e\u{A}") == "";
}

test "^a\\n(?m:^b$)\\nc$" {
    assert spans(#"^a\n(?m:^b$)\nc$"#, "a\u{A}b\u{A}c") == "0..5";
    assert spans(#"^a\n(?m:^b$)\nc$"#, "\u{A}a\u{A}b\u{A}c") == "";
    assert spans(#"^a\n(?m:^b$)\nc$"#, "a\u{A}b\u{A}c\u{A}") == "";
    assert spans(#"^a\n(?m:^b$)\nc$"#, "\u{A}a\u{A}b\u{A}c\u{A}") == "";
}

