    assert spans(#"(?m:^a$|(?-m:^b$|(?m:^c$)|^d$|(?-m:^e$)|^f$)|^g$|(?m:^h$)|^k$)"#, "\u{A}g\u{A}") == "1..2";
    assert spans(#"(?m:^a$|(?-m:^b$|(?m:^c$)|^d$|(?-m:^e$)|^f$)|^g$|(?m:^h$)|^k$)"#, "\u{A}h\u{A}") == "1..2";
    assert spans(#"(?m:^a$|(?-m:^b$|(?m:^c$)|^d$|(?-m:^e$)|^f$)|^g$|(?m:^h$)|^k$)"#, "\u{A}k\u{A}") == "1..2";
}

test "(?m:^a$|^b$|(?-m:^c$)|^d$|^e$)" {
    assert spans(#"(?m:^a$|^b$|(?-m:^c$)|^d$|^e$)"#, "\u{A}a\u{A}") == "1..2";
    assert spans(#"(?m:^a$|^b$|(?-m:^c$)|^d$|^e$)"#, "\u{A}b\u{A}") == "1..2";
    assert spans(#"(?m:^a$|^b$|(?-m:^c$)|^d$|^e$)"#, "\u{A}c\u{A}") == "";
    assert spans(#"(?m:^a$|^b$|(?-m:^c$)|^d$|^e$)"#, "\u{A}d\u{A}") == "1..2";
    assert spans(#"(?m:^a$|^b$|(?-m:^c$)|^d$|^e$)"#, "\u{A}e\u{A}") == "1..2";
}

test "(?m:^m)" {
    assert spans(#"(?m:^m)"#, "pairs\u{A}makes\u{9}double") == "6..7";
}

test "(?m:^p[b-z])" {
    assert spans(#"(?m:^p[b-z])"#, "pairs\u{A}makes\u{9}double\u{A}pesos") == "19..21";
}

test "(?m:es$)" {
    assert spans(#"(?m:es$)"#, "pairs\u{A}makes\u{9}doubles") == "17..19";
    assert spans(#"(?m:es$)"#, "es") == "0..2";
    assert spans(#"(?m:es$)"#, "eS") == "";
    assert spans(#"(?m:es$)"#, "es\u{A}z") == "0..2";
    assert spans(#"(?m:es$)"#, "eS\u{A}z") == "";
    assert spans(#"(?m:es$)"#, "es\u{A}s") == "0..2";
}

test "(?m:es$|(?-m:js$))" {
    assert spans(#"(?m:es$|(?-m:js$))"#, "es\u{A}s") == "0..2";
    assert spans(#"(?m:es$|(?-m:js$))"#, "js") == "0..2";
    assert spans(#"(?m:es$|(?-m:js$))"#, "js\u{A}s") == "";
}

