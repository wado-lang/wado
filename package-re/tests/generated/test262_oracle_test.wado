}

test "d" {
    assert spans(#"d"#, "abcd") == "3..4";
    assert spans(#"d"#, "abcdefg") == "3..4";
}

test "d*" {
    assert spans(#"d*"#, "abcddddefg") == "0..0 1..1 2..2 3..7 8..8 9..9 10..10";
}

test "d+" {
    assert spans(#"d+"#, "abcdefg") == "3..4";
    assert spans(#"d+"#, "abcdddddefg") == "3..8";
}

test "e" {
    assert spans(#"e"#, "undefined") == "3..4 7..8";
}

test "e$" {
    assert spans(#"e$"#, "pairs\u{A}makes\u{9}double") == "17..18";
}

test "e\\b" {
    assert spans(#"e\b"#, "pilot\u{A}soviet robot\u{9}openoffice") == "28..29";
}

test "e{1}" {
