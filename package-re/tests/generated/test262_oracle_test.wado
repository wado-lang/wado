    assert spans(#"[^\[\b\]]+"#, "abcdef") == "0..6";
}

test "[^\\b]+" {
    assert spans(#"[^\b]+"#, "easy\u{8}to\u{8}ride") == "0..4 5..7 8..12";
}

test "[^]" {
