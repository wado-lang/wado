}

test "[a-c\\d]+" {
    assert spans(#"[a-c\d]+"#, "\u{A}\u{A}abc324234\u{A}") == "2..11";
}

test "[a-f]d" {
    assert spans(#"[a-f]d"#, "undefined") == "7..9";
}

test "[a-z]" {
    assert spans(#"[a-z]"#, "abc") == "0..1 1..2 2..3";
}

test "[a-z]+" {
    assert spans(#"[a-z]+"#, "ABC def ghi") == "4..7 8..11";
}

test "[a-z]+(\\d+)" {
    assert spans(#"[a-z]+(\d+)"#, "x 2 ff 55 x2 as1 z12 abc12.0") == "10..12,11..12 13..16,15..16 17..20,18..20 21..26,24..26";
    assert spans(#"[a-z]+(\d+)"#, "__abc123.0") == "2..8,5..8";
}

test "[a-z]+\\d+" {
    assert spans(#"[a-z]+\d+"#, "x 2 ff 55 x2 as1 z12 abc12.0") == "10..12 13..16 17..20 21..26";
    assert spans(#"[a-z]+\d+"#, "__abc123.0") == "2..8";
}

test "[a-z][^1-9][a-z]" {
    assert spans(#"[a-z][^1-9][a-z]"#, "a1b  b2c  c3d  def  f4g") == "15..18";
}

test "[a-z]n" {
    assert spans(#"[a-z]n"#, "undefined") == "0..2 5..7";
}

test "[d-h]+" {
    assert spans(#"[d-h]+"#, "abcdefghijkl") == "3..8";
}

test "[db]" {
    assert spans(#"[db]"#, "abcde") == "1..2 3..4";
}

test "[f-z]e\\B" {
    assert spans(#"[f-z]e\B"#, "devils arise\u{9}for\u{A}revil") == "17..19";
}

test "[object Object]" {
    assert spans(#"[object Object]"#, "undefined") == "3..4 7..8";
}

test "[xyz]*1" {
    assert spans(#"[xyz]*1"#, "a0.b2.c3") == "";
}

test "[\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}]" {
    assert spans(
        #"[👨‍👩‍👧‍👦]"#,
        "\u{20BB7}a\u{20BB7}b\u{20BB7}c\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}d",
    ) == "15..19 19..22 22..26 26..29 29..33 33..36 36..40";
}

test "\\$" {
    assert spans(#"\$"#, "~`!@#$%^&*()-+={[}]|\\:;'<,>./?\"") == "5..6";
    assert spans(#"\$"#, "$") == "0..1";
}

test "\\(" {
    assert spans(#"\("#, "~`!@#$%^&*()-+={[}]|\\:;'<,>./?\"") == "10..11";
    assert spans(#"\("#, "(") == "0..1";
}

test "\\)" {
    assert spans(#"\)"#, "~`!@#$%^&*()-+={[}]|\\:;'<,>./?\"") == "11..12";
    assert spans(#"\)"#, ")") == "0..1";
}

test "\\*" {
    assert spans(#"\*"#, "~`!@#$%^&*()-+={[}]|\\:;'<,>./?\"") == "9..10";
    assert spans(#"\*"#, "*") == "0..1";
}

test "\\+" {
    assert spans(#"\+"#, "~`!@#$%^&*()-+={[}]|\\:;'<,>./?\"") == "13..14";
    assert spans(#"\+"#, "+") == "0..1";
}

test "\\." {
    assert spans(#"\."#, "~`!@#$%^&*()-+={[}]|\\:;'<,>./?\"") == "27..28";
    assert spans(#"\."#, ".") == "0..1";
}

test "\\.14" {
    assert spans(#"\.14"#, "3.141592653589793") == "1..4";
}

test "\\/" {
    assert spans(#"\/"#, "~`!@#$%^&*()-+={[}]|\\:;'<,>./?\"") == "28..29";
    assert spans(#"\/"#, "/") == "0..1";
    assert spans(#"\/"#, "_/_") == "1..2";
    assert spans(#"\/"#, "\\") == "";
}

test "\\0" {
    assert spans(#"\0"#, "\u{0}") == "0..1";
    assert spans(#"\0"#, "x") == "";
}

test "\\?" {
    assert spans(#"\?"#, "~`!@#$%^&*()-+={[}]|\\:;'<,>./?\"") == "29..30";
    assert spans(#"\?"#, "?") == "0..1";
}

test "\\??\\??\\??\\??\\??" {
