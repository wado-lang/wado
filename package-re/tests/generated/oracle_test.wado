}

test "^(\\d+)(?:\\.(\\d+))?$" {
    assert spans(#"^(\d+)(?:\.(\d+))?$"#, "3.14") == "0..4,0..1,2..4";
    assert spans(#"^(\d+)(?:\.(\d+))?$"#, "42") == "0..2,0..2,-";
    assert spans(#"^(\d+)(?:\.(\d+))?$"#, "4.") == "";
}

