// Generated by package-re/scripts/oracle.mjs from tests/oracle/cases.json:
// what Node's RegExp finds with the `u` flag. Regenerate with
// `mise run oracle-re`; do not edit.

use { Regex } from "../../src/lib.wado";

fn spans(pattern: String, text: String) -> String {
    let regex = Regex::new(pattern).unwrap();
    let mut found: List<String> = [];
    for let caps of regex.captures_iter(text) {
        let mut groups: List<String> = [];
        for let i of 0..<caps.len() {
            groups.push(match caps[i] {
                Some(m) => `${m.start()}..${m.end()}`,
                None => "-",
            });
        }
        found.push(groups.join(","));
    }
    return found.join(" ");
}

test "abc" {
    assert spans(#"abc"#, "abc") == "0..3";
    assert spans(#"abc"#, "xabcx") == "1..4";
    assert spans(#"abc"#, "ab") == "";
    assert spans(#"abc"#, "abcabc") == "0..3 3..6";
}

test "a|b|c" {
    assert spans(#"a|b|c"#, "xbyaz") == "1..2 3..4";
    assert spans(#"a|b|c"#, "") == "";
    assert spans(#"a|b|c"#, "ccc") == "0..1 1..2 2..3";
}

test "ab|a" {
    assert spans(#"ab|a"#, "ab") == "0..2";
    assert spans(#"ab|a"#, "a") == "0..1";
    assert spans(#"ab|a"#, "aab") == "0..1 1..3";
}

test "a|ab" {
    assert spans(#"a|ab"#, "ab") == "0..1";
    assert spans(#"a|ab"#, "aab") == "0..1 1..2";
}

test "(a|ab)(c|bcd)(d*)" {
    assert spans(#"(a|ab)(c|bcd)(d*)"#, "abcd") == "0..4,0..1,1..4,4..4";
    assert spans(#"(a|ab)(c|bcd)(d*)"#, "abcdd") == "0..5,0..1,1..4,4..5";
}

test "a*" {
    assert spans(#"a*"#, "") == "0..0";
    assert spans(#"a*"#, "aaa") == "0..3";
    assert spans(#"a*"#, "baaac") == "0..0 1..4 5..5";
    assert spans(#"a*"#, "bab") == "0..0 1..2 3..3";
}

test "a+" {
    assert spans(#"a+"#, "baaac") == "1..4";
    assert spans(#"a+"#, "aXa") == "0..1 2..3";
}

test "a?" {
    assert spans(#"a?"#, "") == "0..0";
    assert spans(#"a?"#, "a") == "0..1";
    assert spans(#"a?"#, "ba") == "0..0 1..2";
}

