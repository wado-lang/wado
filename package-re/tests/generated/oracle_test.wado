    assert spans(#"a+?"#, "aaa") == "0..1 1..2 2..3";
}

test "a??b" {
    assert spans(#"a??b"#, "ab") == "0..2";
    assert spans(#"a??b"#, "b") == "0..1";
}

test "a{2}" {
    assert spans(#"a{2}"#, "a") == "";
    assert spans(#"a{2}"#, "aaaaa") == "0..2 2..4";
}

test "a{2,}" {
    assert spans(#"a{2,}"#, "a") == "";
    assert spans(#"a{2,}"#, "aaaaa") == "0..5";
    assert spans(#"a{2,}"#, "aa") == "0..2";
}

