//! The program a tree compiles to: a Pike VM's instructions over UTF-8 bytes.

use { simple_fold_closure } from "core:icu";
use { Flag, Lookaround, Node, each_child } from "./ast.wado";
use { MAX_CODE_POINT, complement, line_terminators, resolve } from "./charset.wado";
use { PatternError } from "./parse.wado";
use { sequences } from "./utf8.wado";

/// How many instructions the programs of a pattern may hold between them, so
/// that a pattern read at run time cannot spend unbounded memory on its
/// expanded counts (`a{1000}{1000}`). One inside optional iterations of an
/// empty-matching body counts once for each of them and once more, as the
/// Pike VM tracks it once for each.
#[param(name = "re.max_program")]
internal global MAX_PROGRAM: i32 = 1_000_000;

internal enum Look {
    StartText,
    EndText,
    StartLine,
    EndLine,
    WordBoundary,
    NotWordBoundary,
    /// `\b` and `\B` under `i`, whose WordCharacters reach past ASCII.
    FoldedWordBoundary,
    FoldedNotWordBoundary,
}

internal variant Inst {
    /// One byte in the inclusive range, then the next instruction.
    Byte([u8, u8]),
    /// Both targets, the first preferred.
    Split([i32, i32]),
    Jump(i32),
    Save(i32),
    /// Unset the capture slots `[from, to)`, as each iteration of a quantified
    /// atom does (RepeatMatcher, step 4).
    Clear([i32, i32]),
    Assert(Look),
    /// Passes where the lookaround of this index holds. A second number that
    /// is not negative is the slot it leaves its position in, for the groups
    /// it holds to be read there once the match is known.
    Lookaround([i32, i32]),
    /// Passes only past the position slot `k` holds: an optional iteration
    /// that matched empty fails (RepeatMatcher, step 2.b).
    Progress(i32),
    /// What an empty set compiles to: no thread passes.
    Fail,
    Match,
}

internal struct Program {
    internal insts: List<Inst>,
    /// Two per group, group 0 being the whole match, then one per
    /// `Progress`.
    internal slots: i32,
    /// How many of `slots` are the groups'.
    internal captures: i32,
    /// Where each instruction's states start, then how many there are. A
    /// thread's state at an instruction is how many of the optional iterations
    /// around it it entered at the current position: past a `Progress`,
    /// threads that differ in that differ in what they can match.
    internal state_base: List<i32>,
    /// How many bytes every match spans, where they all span as many.
    internal match_len: Option<i32>,
    internal direction: Direction,
    /// The lookarounds whose instruction leaves a position in a slot.
    internal marked: List<i32>,
}

impl Program {
    /// How many states a thread may be in.
    internal fn states(&self) -> i32 {
        return self.state_base[self.insts.len()];
    }
}

/// Which way a program reads the text.
internal enum Direction {
    Forward,
    /// From a match's end back to its start, as ECMA-262 reads a lookbehind
    /// (CompileSubpattern under a _direction_ of backward, §22.2.2.3): the
    /// parts of a sequence last to first, and each group's end saved before
    /// its start.
    Reverse,
}

/// What a lookaround compiles to.
internal struct LookaroundPrograms {
    internal negated: bool,
    /// The body read against its own direction, so that one pass over the
    /// text, from where a match would end, tells every position it holds at.
    internal holds: Program,
    /// The body read in its own direction, for the groups it holds, which
    /// only one that is not negated leaves set.
    internal reads: Option<Reads>,
}

internal struct Reads {
    internal program: Program,
    /// The slots of the groups in the body: `[from, until)`.
    internal from: i32,
    internal until: i32,
}

/// The program matching `node` under `flags`, whose pattern holds `groups`
/// capturing groups and programs of `used` states already.
internal fn compile(
    node: &Node,
    groups: i32,
    direction: Direction,
    flags: Flag = Flag::none(),
    used: i32 = 0,
) -> Result<Program, PatternError> {
    let captures = 2 * (groups + 1);
    let mut c = Compiler {
        insts: [],
        depths: [],
        state_base: [0],
        depth: 0,
        flags,
        slots: captures,
        direction,
        used,
    };
    c.group(0, |c| c.node(node))?;
    c.push(Inst::Match)?;
    let match_len = match_len(&c.insts);
    let mut marked: List<i32> = [];
    collect_marked(node, &mut marked);
    return Ok(Program {
        insts: c.insts,
        slots: c.slots,
        captures,
        state_base: c.state_base,
        match_len,
        direction,
        marked,
    });
}

/// The lookarounds whose instruction in the program of `node` leaves a
/// position in a slot: not those inside another lookaround, whose
/// instructions are in its programs.
fn collect_marked(node: &Node, marked: &mut List<i32>) {
    if let Lookaround(l) = *node {
        if slots_read(&l) matches { Some(_) } {
            marked.push(l.index);
        }
        return;
    }
    each_child(node, |n| collect_marked(n, marked));
}

/// The programs of each lookaround in `tree`, by index, where `main` is the
/// program of `tree` itself.
internal fn compile_lookarounds(
    tree: &Node,
    groups: i32,
    main: &Program,
) -> Result<List<LookaroundPrograms>, PatternError> {
    let mut found: List<[Lookaround, Flag, bool]> = [];
    collect_lookarounds(tree, Flag::none(), true, &mut found);
    let mut used = main.states();
    let mut programs: List<LookaroundPrograms> = [];
    for let [l, flags, keeps_groups] of &found {
        assert l.index == programs.len();
        let [own, against] = if l.ahead {
            [Direction::Forward, Direction::Reverse];
        } else {
            [Direction::Reverse, Direction::Forward];
        };
        let holds = compile(&l.body, groups, against, *flags, used)?;
        used += holds.states();
        let mut reads: Option<Reads> = null;
        if *keeps_groups && let Some([from, until]) = slots_read(l) {
            let program = compile(&l.body, groups, own, *flags, used)?;
            used += program.states();
            reads = Some(Reads { program, from, until });
        }
        programs.push(LookaroundPrograms { negated: l.negated, holds, reads });
    }
    return Ok(programs);
}

/// Each lookaround under `node`, in the order of their indices, with the flags
/// in force where it stands and whether a match keeps the groups set there.
/// `keeps_groups` says so of `node`: no negated lookaround encloses it.
fn collect_lookarounds(node: &Node, flags: Flag, keeps_groups: bool, found: &mut List<[Lookaround, Flag, bool]>) {
    let mut kept_inside = keeps_groups;
    if let Lookaround(l) = *node {
        found.push([l, flags, keeps_groups]);
        kept_inside = keeps_groups && !l.negated;
    }
    let flags_inside = if let Modified(m) = *node {
        (flags | m.add) & ~m.remove;
    } else {
        flags;
    };
    each_child(node, |n| collect_lookarounds(n, flags_inside, kept_inside, found));
}

/// The slots `[from, until)` of the groups `l` leaves set: those in its body,
/// unless it is negated: a negative lookaround goes on with the captures it
/// was given (CompileAssertion, §22.2.2.4).
fn slots_read(l: &Lookaround) -> Option<[i32, i32]> {
    if !l.negated && let Some([lo, hi]) = group_span(&l.body) {
        return Some([2 * lo, 2 * hi + 2]);
    }
    return null;
}

/// How many bytes every match of `insts` spans, if they all span as many.
fn match_len(insts: &List<Inst>) -> Option<i32> {
    // From each instruction to `Match`: a length, or one of these.
    let varies = -1;
    let no_match = -2;
    let merge = |a: i32, b: i32| {
        return if a == no_match || a == b {
            b;
        } else if b == no_match {
            a;
        } else {
            varies;
        };
    };
    let mut to_match: List<i32> = List::filled(insts.len(), varies);
    // A target that lies back is a loop, whose matches vary in length, so
    // one pass from the end settles every instruction after those it needs.
    let at = |target: i32, from: i32, known: &List<i32>| {
        return if target > from { known[target] } else { varies };
    };
    for let back of 0..<insts.len() {
        let pc = insts.len() - 1 - back;
        to_match[pc] = match insts[pc] {
            _::Match => 0,
            _::Fail => no_match,
            Byte(_) => {
                let rest = to_match[pc + 1];
                if rest >= 0 {
                    rest + 1;
                } else {
                    rest;
                }
            },
            Jump(target) => at(target, pc, &to_match),
            Split([first, second]) => merge(at(first, pc, &to_match), at(second, pc, &to_match)),
            Save(_) | Clear(_) | Assert(_) | Lookaround(_) | Progress(_) => to_match[pc + 1],
        };
    }
    return if to_match[0] >= 0 { Some(to_match[0]) } else { null };
}

struct Compiler {
    insts: List<Inst>,
    /// How many optional iterations guarded by a `Progress` hold each
    /// instruction.
    depths: List<i32>,
    state_base: List<i32>,
    depth: i32,
    flags: Flag,
    slots: i32,
    direction: Direction,
    /// How many states the pattern's programs before this one hold.
    used: i32,
}

/// Whether `node` can match without consuming a character.
fn can_match_empty(node: &Node) -> bool {
    return match *node {
        Char(_) | _::Any | Set(_) => false,
        _::Start | _::End | _::WordBoundary | _::NotWordBoundary | Lookaround(_) => true,
        Group(g) => can_match_empty(&g.body),
        Modified(m) => can_match_empty(&m.body),
        Repeat(r) => r.min == 0 || can_match_empty(&r.body),
        Concat(nodes) => {
            for let n of &nodes {
                if !can_match_empty(n) {
                    return false;
                }
            }
            true;
        },
        Alternation(nodes) => {
            for let n of &nodes {
                if can_match_empty(n) {
                    return true;
                }
            }
            false;
        },
    };
}

/// `inst` moved `delta` instructions on, its targets with it.
fn relocate(inst: Inst, delta: i32) -> Inst {
    return match inst {
        Split([a, b]) => Inst::Split([a + delta, b + delta]),
        Jump(target) => Inst::Jump(target + delta),
        _ => inst,
    };
}

/// The lowest and highest capturing group `node` holds, those inside a
/// lookaround included.
fn group_span(node: &Node) -> Option<[i32, i32]> {
    let mut span: Option<[i32, i32]> = null;
    let mut widen = |inner: Option<[i32, i32]>| {
        if let Some([lo, hi]) = inner {
            span = match span {
                Some([a, b]) => Some([
                    i32::min(a, lo),
                    i32::max(b, hi),
                ]),
                null => Some([lo, hi]),
            };
        }
    };
    if let Group(g) = *node && let Some(i) = g.index {
        widen(Some([i, i]));
    }
    each_child(node, |n| widen(group_span(n)));
    return span;
}

impl Compiler {
    fn pc(&self) -> i32 {
        return self.insts.len();
    }

    fn push(&mut self, inst: Inst) -> Result<i32, PatternError> {
        return self.push_at(inst, self.depth);
    }

    fn push_at(&mut self, inst: Inst, depth: i32) -> Result<i32, PatternError> {
        let states = self.state_base[self.insts.len()] + depth + 1;
        if self.used + states > MAX_PROGRAM {
            return Err(PatternError {
                offset: 0,
                message: `the pattern compiles to a program over re.max_program (${MAX_PROGRAM})`,
            });
        }
        self.insts.push(inst);
        self.depths.push(depth);
        self.state_base.push(states);
        return Ok(self.insts.len() - 1);
    }

    fn patch(&mut self, at: i32, inst: Inst) {
        self.insts[at] = inst;
    }

    fn node(&mut self, node: &Node) -> Result<(), PatternError> {
        match *node {
            Char(c) => self.chars([
                [c, c],
            ])?,
            _::Any => {
                if self.flags & Flag::DotAll != Flag::none() {
                    self.chars([
                        [0, MAX_CODE_POINT],
                    ])?;
                } else {
                    self.chars(complement(&line_terminators()))?;
                }
            },
            _::Start => {
                let look = if self.multiline() { Look::StartLine } else { Look::StartText };
                self.push(Inst::Assert(look))?;
            },
            _::End => {
                let look = if self.multiline() { Look::EndLine } else { Look::EndText };
                self.push(Inst::Assert(look))?;
            },
            _::WordBoundary => {
                let look = if self.ignore_case() { Look::FoldedWordBoundary } else { Look::WordBoundary };
                self.push(Inst::Assert(look))?;
            },
            _::NotWordBoundary => {
                let look = if self.ignore_case() { Look::FoldedNotWordBoundary } else { Look::NotWordBoundary };
                self.push(Inst::Assert(look))?;
            },
            Set(set) => self.ranges(&resolve(&set, self.ignore_case()))?,
            Group(g) => {
                if let Some(i) = g.index {
                    self.group(i, |c| c.node(&g.body))?;
                } else {
                    self.node(&g.body)?;
                }
            },
            Lookaround(l) => {
                // No instruction of this program saves a group of the body,
                // so the first of their slots is free until they are read.
                let mark = match slots_read(&l) {
                    Some([from, _]) => from,
                    null => -1,
                };
                self.push(Inst::Lookaround([l.index, mark]))?;
            },
            Modified(m) => {
                let outer = self.flags;
                self.flags = (self.flags | m.add) & ~m.remove;
                self.node(&m.body)?;
                self.flags = outer;
            },
            Repeat(r) => self.repeat(&r.body, r.min, r.max, r.greedy)?,
            Concat(nodes) => {
                for let i of 0..<nodes.len() {
                    self.node(&nodes[self.in_reading_order(i, nodes.len())])?;
                }
            },
            Alternation(nodes) => self.choice(&nodes, |c, n| c.node(n))?,
        }
        return Ok(());
    }

    /// What `emit` writes, between the saves of group `index`'s two ends as
    /// this program meets them.
    fn group(&mut self, index: i32, emit: fn(&mut Compiler) -> Result<(), PatternError>) -> Result<(), PatternError> {
        let reverse = (self.direction == Direction::Reverse) as i32;
        self.push(Inst::Save(2 * index + reverse))?;
        emit(self)?;
        self.push(Inst::Save(2 * index + 1 - reverse))?;
        return Ok(());
    }

    /// The index of the `i`th of `len` parts in a sequence, as this program
    /// reads them.
    fn in_reading_order(&self, i: i32, len: i32) -> i32 {
        return if self.direction == Direction::Reverse { len - 1 - i } else { i };
    }

    fn multiline(&self) -> bool {
        return self.flags & Flag::Multiline != Flag::none();
    }

    fn ignore_case(&self) -> bool {
        return self.flags & Flag::IgnoreCase != Flag::none();
    }

    /// What matches one of `set`, which is normalized: under `i`, each
    /// character that folds as one of them does (CharacterSetMatcher,
    /// §22.2.2.7.1).
    fn chars(&mut self, set: List<[u32, u32]>) -> Result<(), PatternError> {
        return self.ranges(&if self.ignore_case() { simple_fold_closure(set) } else { set });
    }

    /// A choice among what `emit` compiles each of `items` to, each split
    /// preferring the item before it.
    fn choice<T>(
        &mut self,
        items: &List<T>,
        emit: fn(&mut Compiler, &T) -> Result<(), PatternError>,
    ) -> Result<(), PatternError>
        contract !items.is_empty()
    {
        let mut jumps: List<i32> = [];
        for let i of 0..<items.len() - 1 {
            let split = self.push(Inst::Split([0, 0]))?;
            emit(self, &items[i])?;
            jumps.push(self.push(Inst::Jump(0))?);
            let next = self.pc();
            self.patch(split, Inst::Split([split + 1, next]));
        }
        emit(self, &items[items.len() - 1])?;
        let end = self.pc();
        for let j of jumps {
            self.patch(j, Inst::Jump(end));
        }
        return Ok(());
    }

    /// One iteration of a quantified atom: its groups start unset.
    fn iteration(&mut self, body: &Node) -> Result<(), PatternError> {
        if let Some([lo, hi]) = group_span(body) {
            self.push(Inst::Clear([2 * lo, 2 * hi + 2]))?;
        }
        return self.node(body);
    }

    fn split_toward(&mut self, at: i32, body: i32, skip: i32, greedy: bool) {
        self.patch(at, if greedy { Inst::Split([body, skip]) } else { Inst::Split([skip, body]) });
    }

    fn repeat(&mut self, body: &Node, min: u32, max: Option<u32>, greedy: bool) -> Result<(), PatternError> {
        self.copies(min, |c| c.iteration(body))?;
        let progress: Option<i32> = if can_match_empty(body) { Some(self.slot()) } else { null };
        let optional = |c: &mut Compiler| c.optional_iteration(body, progress);
        let Some(max) = max else {
            // body*: L: split(body, end); body; jump L
            let top = self.pc();
            optional(self)?;
            self.push(Inst::Jump(top))?;
            let end = self.pc();
            self.split_toward(top, top + 1, end, greedy);
            return Ok(());
        };
        // Each optional iteration may stop, and stopping skips the rest.
        let first = self.pc();
        let size = self.copies(max - min, optional)?;
        let end = self.pc();
        for let k of 0..<max - min {
            let split = first + k as i32 * size;
            self.split_toward(split, split + 1, end, greedy);
        }
        return Ok(());
    }

    /// An iteration a quantifier may skip, led by the split that skips it.
    /// One whose body can match empty must consume something.
    fn optional_iteration(&mut self, body: &Node, progress: Option<i32>) -> Result<(), PatternError> {
        self.push(Inst::Split([0, 0]))?;
        let Some(k) = progress else {
            return self.iteration(body);
        };
        self.push(Inst::Save(k))?;
        self.depth += 1;
        self.iteration(body)?;
        self.push(Inst::Progress(k))?;
        self.depth -= 1;
        return Ok(());
    }

    /// `count` copies of what `emit` writes, which runs once: compiling a
    /// body again would redo its sets' UTF-8 splitting. Returns the size of
    /// one copy. A copy of nothing is nothing, so an empty body under a
    /// count as high as `u32::MAX` costs no time.
    fn copies(&mut self, count: u32, emit: fn(&mut Compiler) -> Result<(), PatternError>) -> Result<i32, PatternError> {
        if count == 0 {
            return Ok(0);
        }
        let from = self.pc();
        emit(self)?;
        let to = self.pc();
        if to > from {
            for let _i of 1..<count {
                let delta = self.pc() - from;
                for let i of from..<to {
                    self.push_at(relocate(self.insts[i], delta), self.depths[i])?;
                }
            }
        }
        return Ok(to - from);
    }

    fn slot(&mut self) -> i32 {
        self.slots += 1;
        return self.slots - 1;
    }

    /// A choice among `set`'s UTF-8 sequences, lowest first.
    fn ranges(&mut self, set: &List<[u32, u32]>) -> Result<(), PatternError> {
        let mut seqs: List<List<[u8, u8]>> = [];
        for let r of set {
            sequences(r.0, r.1, &mut seqs);
        }
        if seqs.is_empty() {
            self.push(Inst::Fail)?;
            return Ok(());
        }
        return self.choice(&seqs, |c, seq| {
            for let i of 0..<seq.len() {
                c.push(Inst::Byte(seq[c.in_reading_order(i, seq.len())]))?;
            }
            return Ok(());
        });
    }
}
