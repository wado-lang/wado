//! The program a tree compiles to: a Pike VM's instructions over UTF-8 bytes.

use { Flag, Node } from "./ast.wado";
use { MAX_CODE_POINT, complement, line_terminators, resolve } from "./charset.wado";
use { PatternError } from "./parse.wado";
use { sequences } from "./utf8.wado";

/// How many instructions a program may hold, so that a pattern read at run
/// time cannot spend unbounded memory on its expanded counts (`a{1000}{1000}`).
#[param(name = "re.max_program")]
internal global MAX_PROGRAM: i32 = 1_000_000;

internal enum Look {
    StartText,
    EndText,
    StartLine,
    EndLine,
    WordBoundary,
    NotWordBoundary,
}

internal variant Inst {
    /// One byte in the inclusive range, then the next instruction.
    Byte([u8, u8]),
    /// Both targets, the first preferred.
    Split([i32, i32]),
    Jump(i32),
    Save(i32),
    /// Unset the capture slots `[from, to)`, as each iteration of a quantified
    /// atom does (RepeatMatcher, step 4).
    Clear([i32, i32]),
    Assert(Look),
    /// Passes only past the position slot `k` holds: an optional iteration
    /// that matched empty fails (RepeatMatcher, step 2.b).
    Progress(i32),
    /// What an empty set compiles to: no thread passes.
    Fail,
    Match,
}

internal struct Program {
    internal insts: List<Inst>,
    /// Two per group, group 0 being the whole match, then one per
    /// `Progress`.
    internal slots: i32,
    /// How many of `slots` are the groups'.
    internal captures: i32,
}

/// The program matching `node`, whose capturing groups number `groups`.
internal fn compile(node: &Node, groups: i32) -> Result<Program, PatternError> {
    let captures = 2 * (groups + 1);
    let mut c = Compiler { insts: [], flags: Flag::none(), slots: captures };
    c.push(Inst::Save(0))?;
    c.node(node)?;
    c.push(Inst::Save(1))?;
    c.push(Inst::Match)?;
    return Ok(Program { insts: c.insts, slots: c.slots, captures });
}

struct Compiler {
    insts: List<Inst>,
    flags: Flag,
    slots: i32,
}

/// Whether `node` can match without consuming a character.
fn can_match_empty(node: &Node) -> bool {
    return match *node {
        Char(_) | Any | Set(_) => false,
        Start | End | WordBoundary | NotWordBoundary => true,
        Group(g) => can_match_empty(&g.body),
        Modified(m) => can_match_empty(&m.body),
        Repeat(r) => r.min == 0 || can_match_empty(&r.body),
        Concat(nodes) => {
            for let n of &nodes {
                if !can_match_empty(n) {
                    return false;
                }
            }
            true;
        },
        Alternation(nodes) => {
            for let n of &nodes {
                if can_match_empty(n) {
                    return true;
                }
            }
            false;
        },
    };
}

/// `inst` moved `delta` instructions on, its targets with it.
fn relocate(inst: Inst, delta: i32) -> Inst {
    return match inst {
        Split([a, b]) => Inst::Split([a + delta, b + delta]),
        Jump(target) => Inst::Jump(target + delta),
        _ => inst,
    };
}

/// The lowest and highest capturing group `node` holds.
fn group_span(node: &Node) -> Option<[i32, i32]> {
    let mut span: Option<[i32, i32]> = null;
    let mut widen = |inner: Option<[i32, i32]>| {
        if let Some([lo, hi]) = inner {
            span = match span {
                Some([a, b]) => Some([
                    i32::min(a, lo),
                    i32::max(b, hi),
                ]),
                None => Some([lo, hi]),
            };
        }
    };
    match *node {
        Group(g) => {
            if let Some(i) = g.index {
                widen(Some([i, i]));
            }
            widen(group_span(&g.body));
        },
        Modified(m) => widen(group_span(&m.body)),
        Repeat(r) => widen(group_span(&r.body)),
        Concat(nodes) | Alternation(nodes) => {
            for let n of &nodes {
                widen(group_span(n));
            }
        },
        _ => {
        },
    }
    return span;
}

impl Compiler {
    fn pc(&self) -> i32 {
        return self.insts.len();
    }

    fn push(&mut self, inst: Inst) -> Result<i32, PatternError> {
        if self.insts.len() >= MAX_PROGRAM {
            return Err(PatternError {
                offset: 0,
                message: `the pattern compiles to more than ${MAX_PROGRAM} instructions`,
            });
        }
        self.insts.push(inst);
        return Ok(self.insts.len() - 1);
    }

    fn patch(&mut self, at: i32, inst: Inst) {
        self.insts[at] = inst;
    }

    fn node(&mut self, node: &Node) -> Result<(), PatternError> {
        match *node {
            Char(c) => self.ranges(&[
                [c, c],
            ])?,
            Any => {
                if self.flags & Flag::DotAll != Flag::none() {
                    self.ranges(&[
                        [0, MAX_CODE_POINT],
                    ])?;
                } else {
                    self.ranges(&complement(&line_terminators()))?;
                }
            },
            Start => {
                let look = if self.multiline() { Look::StartLine } else { Look::StartText };
                self.push(Inst::Assert(look))?;
            },
            End => {
                let look = if self.multiline() { Look::EndLine } else { Look::EndText };
                self.push(Inst::Assert(look))?;
            },
            WordBoundary => {
                self.push(Inst::Assert(Look::WordBoundary))?;
            },
            NotWordBoundary => {
                self.push(Inst::Assert(Look::NotWordBoundary))?;
            },
            Set(set) => self.ranges(&resolve(&set))?,
            Group(g) => {
                if let Some(i) = g.index {
                    self.push(Inst::Save(2 * i))?;
                    self.node(&g.body)?;
                    self.push(Inst::Save(2 * i + 1))?;
                } else {
                    self.node(&g.body)?;
                }
            },
            Modified(m) => {
                assert m.add & Flag::IgnoreCase == Flag::none(), "the parser refuses the `i` modifier";
                let outer = self.flags;
                self.flags = (self.flags | m.add) & ~m.remove;
                self.node(&m.body)?;
                self.flags = outer;
            },
            Repeat(r) => self.repeat(&r.body, r.min, r.max, r.greedy)?,
            Concat(nodes) => {
                for let n of &nodes {
                    self.node(n)?;
                }
            },
            Alternation(nodes) => self.choice(&nodes, |c, n| c.node(n))?,
        }
        return Ok(());
    }

    fn multiline(&self) -> bool {
        return self.flags & Flag::Multiline != Flag::none();
    }

    /// A choice among what `emit` compiles each of `items` to, each split
    /// preferring the item before it.
    fn choice<T>(
        &mut self,
        items: &List<T>,
        emit: fn(&mut Compiler, &T) -> Result<(), PatternError>,
    ) -> Result<(), PatternError>
        contract !items.is_empty()
    {
        let mut jumps: List<i32> = [];
        for let i of 0..<items.len() - 1 {
            let split = self.push(Inst::Split([0, 0]))?;
            emit(self, &items[i])?;
            jumps.push(self.push(Inst::Jump(0))?);
            let next = self.pc();
            self.patch(split, Inst::Split([split + 1, next]));
        }
        emit(self, &items[items.len() - 1])?;
        let end = self.pc();
        for let j of jumps {
            self.patch(j, Inst::Jump(end));
        }
        return Ok(());
    }

    /// One iteration of a quantified atom: its groups start unset.
    fn iteration(&mut self, body: &Node) -> Result<(), PatternError> {
        if let Some([lo, hi]) = group_span(body) {
            self.push(Inst::Clear([2 * lo, 2 * hi + 2]))?;
        }
        return self.node(body);
    }

    fn split_toward(&mut self, at: i32, body: i32, skip: i32, greedy: bool) {
        self.patch(at, if greedy { Inst::Split([body, skip]) } else { Inst::Split([skip, body]) });
    }

    fn repeat(&mut self, body: &Node, min: u32, max: Option<u32>, greedy: bool) -> Result<(), PatternError> {
        self.copies(min, |c| c.iteration(body))?;
        let progress: Option<i32> = if can_match_empty(body) { Some(self.slot()) } else { null };
        let optional = |c: &mut Compiler| c.optional_iteration(body, progress);
        let Some(max) = max else {
            // body*: L: split(body, end); body; jump L
            let top = self.pc();
            optional(self)?;
            self.push(Inst::Jump(top))?;
            let end = self.pc();
            self.split_toward(top, top + 1, end, greedy);
            return Ok(());
        };
        // Each optional iteration may stop, and stopping skips the rest.
        let first = self.pc();
        let size = self.copies(max - min, optional)?;
        let end = self.pc();
        for let k of 0..<max - min {
            let split = first + k as i32 * size;
            self.split_toward(split, split + 1, end, greedy);
        }
        return Ok(());
    }

    /// An iteration a quantifier may skip, led by the split that skips it.
    /// One whose body can match empty must consume something.
    fn optional_iteration(&mut self, body: &Node, progress: Option<i32>) -> Result<(), PatternError> {
        self.push(Inst::Split([0, 0]))?;
        if let Some(k) = progress {
            self.push(Inst::Save(k))?;
        }
        self.iteration(body)?;
        if let Some(k) = progress {
            self.push(Inst::Progress(k))?;
        }
        return Ok(());
    }

    /// `count` copies of what `emit` writes, which runs once: compiling a
    /// body again would redo its sets' UTF-8 splitting. Returns the size of
    /// one copy. A copy of nothing is nothing, so an empty body under a
    /// count as high as `u32::MAX` costs no time.
    fn copies(&mut self, count: u32, emit: fn(&mut Compiler) -> Result<(), PatternError>) -> Result<i32, PatternError> {
        if count == 0 {
            return Ok(0);
        }
        let from = self.pc();
        emit(self)?;
        let to = self.pc();
        if to > from {
            for let _i of 1..<count {
                let delta = self.pc() - from;
                for let i of from..<to {
                    self.push(relocate(self.insts[i], delta))?;
                }
            }
        }
        return Ok(to - from);
    }

    fn slot(&mut self) -> i32 {
        self.slots += 1;
        return self.slots - 1;
    }

    /// A choice among `set`'s UTF-8 sequences, lowest first.
    fn ranges(&mut self, set: &List<[u32, u32]>) -> Result<(), PatternError> {
        let mut seqs: List<List<[u8, u8]>> = [];
        for let r of set {
            sequences(r.0, r.1, &mut seqs);
        }
        if seqs.is_empty() {
            self.push(Inst::Fail)?;
            return Ok(());
        }
        return self.choice(&seqs, |c, seq| {
            for let b of seq {
                c.push(Inst::Byte(*b))?;
            }
            return Ok(());
        });
    }
}
