//! `Regex` and what a search answers.

use { Node } from "./ast.wado";
use { PatternError, Syntax, parse } from "./parse.wado";
use { search } from "./pike.wado";
use { Program, compile } from "./program.wado";

/// A compiled regular expression.
pub struct Regex {
    program: Program,
    /// The name of each group, by index; group 0 has none.
    names: List<Option<String>>,
}

/// Records each named group's name at its index in `names`.
fn collect_names(node: &Node, names: &mut List<Option<String>>) {
    match *node {
        Group(g) => {
            if let Some(i) = g.index && let Some(name) = g.name {
                names[i] = Some(name);
            }
            collect_names(&g.body, names);
        },
        Modified(m) => collect_names(&m.body, names),
        Repeat(r) => collect_names(&r.body, names),
        Concat(nodes) | Alternation(nodes) => {
            for let n of &nodes {
                collect_names(n, names);
            }
        },
        _ => {
        },
    }
}

internal fn build(pattern: StrSlice, syntax: Syntax) -> Result<Regex, PatternError> {
    let [node, groups] = parse(pattern, syntax)?;
    let mut names: List<Option<String>> = [];
    for let _i of 0..=groups {
        names.push(null);
    }
    collect_names(&node, &mut names);
    return Ok(Regex { program: compile(&node, groups)?, names });
}

impl Regex {
    /// The regular expression `pattern` spells, or why it spells none.
    pub fn new<S: AsStrSlice>(pattern: S) -> Result<Regex, PatternError> {
        return build(pattern.as_str_slice(), Syntax::Plain);
    }

    /// Whether `text` holds a match.
    pub fn is_match<S: AsStrSlice>(&self, text: S) -> bool {
        return search(&self.program, text.as_str_slice(), 0) matches { Some(_) };
    }

    /// The leftmost match in `text`.
    pub fn find<S: AsStrSlice>(&self, text: S) -> Option<Match> {
        return self.find_at(text, 0);
    }

    /// The leftmost match at or after the byte offset `start`. The text before
    /// it still counts as context for `^` and `\b`.
    pub fn find_at<S: AsStrSlice>(&self, text: S, start: i32) -> Option<Match>
        contract text.as_str_slice().is_char_boundary(start), "start must lie on a character boundary"
    {
        let view = text.as_str_slice();
        let Some(slots) = search(&self.program, view, start) else {
            return null;
        };
        return Some(Match { text: view, start: slots[0], end: slots[1] });
    }

    /// The groups of the leftmost match in `text`.
    pub fn captures<S: AsStrSlice>(&self, text: S) -> Option<Captures> {
        return self.captures_at(text, 0);
    }

    /// The groups of the leftmost match at or after the byte offset `start`.
    pub fn captures_at<S: AsStrSlice>(&self, text: S, start: i32) -> Option<Captures>
        contract text.as_str_slice().is_char_boundary(start), "start must lie on a character boundary"
    {
        let view = text.as_str_slice();
        let Some(slots) = search(&self.program, view, start) else {
            return null;
        };
        return Some(Captures { text: view, slots, regex: self });
    }

    /// Each match in `text`, left to right. After an empty match the search
    /// resumes one character on, as `String.prototype.matchAll` does.
    pub fn find_iter<S: AsStrSlice>(&self, text: S) -> Matches {
        return Matches { regex: self, text: text.as_str_slice(), next: 0 };
    }

    /// The groups of each match in `text`, left to right, resuming as
    /// `find_iter` does.
    pub fn captures_iter<S: AsStrSlice>(&self, text: S) -> CaptureMatches {
        return CaptureMatches { matches: self.find_iter(text) };
    }
}

/// A match: a span of the text searched.
pub struct Match {
    text: StrSlice,
    start: i32,
    end: i32,
}

impl Match {
    /// The byte offset where the match starts.
    pub fn start(&self) -> i32 {
        return self.start;
    }

    /// The byte offset just past the match.
    pub fn end(&self) -> i32 {
        return self.end;
    }

    /// The text matched.
    pub fn as_str(&self) -> StrSlice {
        return self.text.slice(self.start, self.end);
    }
}

/// The groups of one match. Group 0 is the whole match.
pub struct Captures {
    text: StrSlice,
    slots: List<i32>,
    regex: &Regex,
}

impl Captures {
    /// How many groups the expression has, group 0 included.
    pub fn len(&self) -> i32 {
        return self.slots.len() / 2;
    }

    /// Group `index`, if it took part in the match.
    pub fn get(&self, index: i32) -> Option<Match>
        contract index >= 0 && index < self.len(), "no group has this index"
    {
        let start = self.slots[2 * index];
        if start < 0 {
            return null;
        }
        return Some(Match { text: self.text, start, end: self.slots[2 * index + 1] });
    }

    /// The group named `name`, if it took part in the match.
    pub fn name<S: AsStrSlice>(&self, name: S) -> Option<Match> {
        for let i of 1..<self.len() {
            if let Some(n) = self.regex.names[i] && n == name.as_str_slice() {
                return self.get(i);
            }
        }
        return null;
    }
}

/// The iterator `Regex::find_iter` returns.
pub struct Matches {
    regex: &Regex,
    text: StrSlice,
    /// Where the next search starts; past the text's end once done.
    next: i32,
}

impl Iterator for Matches {
    type Item = Match;

    fn next(&mut self) -> Option<Match> {
        if self.next > self.text.len() {
            return null;
        }
        let Some(m) = self.regex.find_at(self.text, self.next) else {
            self.next = self.text.len() + 1;
            return null;
        };
        self.next = if m.end > m.start {
            m.end;
        } else if m.end < self.text.len() {
            m.end + self.text.char_at_byte(m.end).len_utf8();
        } else {
            m.end + 1;
        };
        return Some(m);
    }
}

/// The iterator `Regex::captures_iter` returns.
pub struct CaptureMatches {
    matches: Matches,
}

impl Iterator for CaptureMatches {
    type Item = Captures;

    fn next(&mut self) -> Option<Captures> {
        let m = &mut self.matches;
        if m.next > m.text.len() {
            return null;
        }
        let Some(caps) = m.regex.captures_at(m.text, m.next) else {
            m.next = m.text.len() + 1;
            return null;
        };
        let start = caps.slots[0];
        let end = caps.slots[1];
        m.next = if end > start {
            end;
        } else if end < m.text.len() {
            end + m.text.char_at_byte(end).len_utf8();
        } else {
            end + 1;
        };
        return Some(caps);
    }
}
