//! Sets of code points, each a list of sorted, disjoint, non-adjacent
//! inclusive ranges.

use { GeneralCategoryGroup, ranges, simple_fold_closure } from "core:icu";
use { CharSet, NamedSet } from "./ast.wado";

internal global MAX_CODE_POINT: u32 = 0x10FFFF;

/// `set` sorted and merged.
internal fn normalize(mut set: List<[u32, u32]>) -> List<[u32, u32]> {
    set.sort_by(|a, b| a.0.cmp(&b.0));
    let mut out: List<[u32, u32]> = [];
    for let r of &set {
        let [lo, hi] = *r;
        let last = out.len() - 1;
        if last >= 0 && lo <= out[last].1 + 1 {
            if hi > out[last].1 {
                out[last] = [out[last].0, hi];
            }
        } else {
            out.push([lo, hi]);
        }
    }
    return out;
}

/// Every code point the normalized `set` leaves out.
internal fn complement(set: &List<[u32, u32]>) -> List<[u32, u32]> {
    let mut out: List<[u32, u32]> = [];
    let mut next: u32 = 0;
    for let r of set {
        let [lo, hi] = *r;
        if lo > next {
            out.push([next, lo - 1]);
        }
        next = hi + 1;
    }
    if next <= MAX_CODE_POINT {
        out.push([next, MAX_CODE_POINT]);
    }
    return out;
}

/// LineTerminator: LF, CR, LS, PS.
internal fn line_terminators() -> List<[u32, u32]> {
    return [
        [0x0A, 0x0A],
        [0x0D, 0x0D],
        [0x2028, 0x2029],
    ];
}

/// WordCharacters (§22.2.2.9.3): `[A-Za-z0-9_]`, and under `i` the characters
/// whose simple folding lies in it. Simple folding maps the set into itself,
/// so that is the set's closure.
internal fn word(ignore_case: bool) -> List<[u32, u32]> {
    let ascii: List<[u32, u32]> = [
        [0x30, 0x39],
        [0x41, 0x5A],
        [0x5F, 0x5F],
        [0x61, 0x7A],
    ];
    return if ignore_case { simple_fold_closure(ascii) } else { ascii };
}

/// CharacterClassEscape `s`: WhiteSpace and LineTerminator. WhiteSpace is TAB,
/// VT, FF, ZWNBSP and the Space_Separator characters.
fn space() -> List<[u32, u32]> {
    let mut out: List<[u32, u32]> = [
        [0x09, 0x0D],
        [0x20, 0x20],
        [0x2028, 0x2029],
        [0xFEFF, 0xFEFF],
    ];
    for let r of ranges(GeneralCategoryGroup::SpaceSeparator) {
        out.push(r);
    }
    return normalize(out);
}

fn named(set: &NamedSet, ignore_case: bool) -> List<[u32, u32]> {
    let positive: List<[u32, u32]> = match set.kind {
        Digit => [
            [0x30, 0x39],
        ],
        Word => word(ignore_case),
        Space => space(),
        Property(p) => p.ranges,
    };
    if set.negated {
        return complement(&positive);
    }
    return positive;
}

/// The code points `set` matches. Under `i` a class matches what folds as one
/// of its members does, and a negated class the rest (CharacterSetMatcher,
/// §22.2.2.7.1).
internal fn resolve(set: &CharSet, ignore_case: bool) -> List<[u32, u32]> {
    let mut out: List<[u32, u32]> = [];
    for let item of &set.items {
        match *item {
            Range(r) => out.push(r),
            Named(n) => {
                for let r of named(&n, ignore_case) {
                    out.push(r);
                }
            },
        }
    }
    let members = if ignore_case { simple_fold_closure(out) } else { normalize(out) };
    if set.negated {
        return complement(&members);
    }
    return members;
}

/// Whether `b` encodes one of WordCharacters without `i`. Each is ASCII, so no
/// byte of a longer sequence is one.
internal fn is_word_byte(b: u8) -> bool {
    return b.is_ascii_alphanumeric() || b == b'_';
}

/// WordCharacters under `i`, which `\b` and `\B` test inside one.
internal global FOLDED_WORD: List<[u32, u32]> = word(true);

/// Whether the normalized `set` holds `c`.
internal fn includes(set: &List<[u32, u32]>, c: u32) -> bool {
    let mut lo = 0;
    let mut hi = set.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        let [first, last] = set[mid];
        if c < first {
            hi = mid;
        } else if c > last {
            lo = mid + 1;
        } else {
            return true;
        }
    }
    return false;
}
