//! The Rust recognizer with its base ports installed: the one clause that
//! generates it, for any package reading Rust.

use rust from "../assets/grammar/RustLexer.g4"
    with {
        generator: {
            module: "wado-lang:gale",
            inputs: ["../assets/grammar/RustParser.g4"],
        },
    };
use { RustLexerBase, RustParserBase, LexerView, Parser } from "../assets/grammar/RustLexer.g4";
pub use {
    token_kind_name,
    RK_INNER_ATTRIBUTE,
    RK_OUTER_ATTRIBUTE,
    RK_STATEMENTS,
    TK_DOT,
    TK_PATHSEP,
    TK_LPAREN,
    TK_NOT,
    TK_KW_FN,
} from "../assets/grammar/RustLexer.g4";

/// The lexer base, ported from Java, as `tools/java/RustLexerBase.java` is.
/// Stateless: the predicates read only the match window.
struct RustBase {
}

impl RustLexerBase for RustBase {
    fn sof(&self, view: LexerView) -> bool {
        resume view.la(-1) == -1;
    }

    fn float_literal_possible(&self, view: LexerView) -> bool {
        resume view.la(-1) != '.' as i32;
    }

    fn float_dot_possible(&self, view: LexerView) -> bool {
        let c = view.la(1);
        if c == '.' as i32 || c == '_' as i32 {
            resume false;
        }
        if c >= 'a' as i32 && c <= 'z' as i32 || c >= 'A' as i32 && c <= 'Z' as i32 {
            resume false;
        }
        resume true;
    }
}

/// The parser base, likewise a port. The lexer emits `<` and `>` one character
/// at a time so nested generics close cleanly, so `shl` / `shr` reassemble a
/// shift only for a pair one start offset apart — what `NextLT` / `NextGT` ask.
struct RustPBase {
}

impl RustParserBase for RustPBase {
    fn next_lt(&self, p: &Parser) -> bool {
        resume p.token_start(p.lt(1)) - p.token_start(p.lt(-1)) == 1;
    }

    fn next_gt(&self, p: &Parser) -> bool {
        resume p.token_start(p.lt(1)) - p.token_start(p.lt(-1)) == 1;
    }
}

/// Runs `recognize` with the base ports installed.
pub fn with_rust_bases<T>(recognize: fn() -> T with (RustLexerBase, RustParserBase)) -> T {
    let mut base = RustBase {};
    let mut pbase = RustPBase {};
    with RustLexerBase => &mut base, RustParserBase => &mut pbase do {
        return recognize();
    };
}

/// Parses a whole Rust source file.
pub fn parse_rust<S: AsStrSlice>(source: S) -> rust::ParseResult {
    return with_rust_bases(|| rust::parse(source));
}

/// The syntax errors in Rust `source`, one rendered message each; empty when
/// it parses. The component's public entry point.
export fn diagnose(source: String) -> List<String> {
    return parse_rust(source).diagnostics.into_iter().map(|d| `${d}`).collect();
}

/// FNV-1a over every row of the tree: what it is, where it sits, and the
/// alternative that built it. Two parses of one file agree on it exactly when
/// they built the same tree.
pub fn tree_hash(cst: &rust::CstStore) -> u64 {
    let mut h: u64 = 14695981039346656037;
    for let mut i = 0; i < cst.row_count(); i += 1 {
        let span = cst.span(i);
        for let field of [
            ReflectEnum::<rust::EventTag>::discriminant(&cst.tag[i]),
            cst.id[i],
            cst.alt(i),
            span.start,
            span.end,
            cst.is_error(i) as i32,
        ] {
            h = (h ^ field as u32 as u64) * 1099511628211;
        }
    }
    return h;
}
