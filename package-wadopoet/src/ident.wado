use { is_keyword, is_prelude_name } from "./vocabulary.wado";

/// Whether a generated declaration named `name` would collide with the
/// language: a keyword, or a name the prelude puts in every module's scope.
pub fn is_reserved<S: AsStrSlice>(name: S) -> bool {
    return is_keyword(name) || is_prelude_name(name);
}

/// `name`, with a trailing `_` when it is reserved.
pub fn escape_ident<S: AsStrSlice>(name: S) -> String {
    if is_reserved(name) {
        return `${name}_`;
    }
    return name.to_string();
}
