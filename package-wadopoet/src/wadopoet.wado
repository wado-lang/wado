use { ReflectTemplate } from "core:prelude";
use { TreeMap, TreeSet } from "core:collections";

/// What a call does with the callee's result.
pub variant CallForm {
    /// `callee(args);`
    Discard,
    /// `return callee(args);`
    Return,
    /// The prefix given, then the call: `let x = callee(args);`, `pos = …`.
    Bind(String),
}

/// A call statement kept apart from the text around it, so `prune` can see
/// which function it calls and with what.
pub struct CallStmt {
    /// Statements that run just before the call, each on its own line. They
    /// travel with the call when `prune` forwards it.
    pub pre: List<String> = [],
    pub form: CallForm = CallForm::Discard,
    pub callee: String,
    pub args: List<String>,
}

/// Lines written as text. What a pass may ask of them is counted as they are
/// written, never read back from `text`.
struct TextSeg {
    text: String,
    /// Extra indentation levels, applied at every line start when printed. A
    /// segment spliced in by `append` carries the level it landed at.
    offset: i32 = 0,
    /// Statement lines: `line` calls, block openers and closers.
    lines: i32 = 0,
    blocks: bool = false,
    /// Written by `write` or `raw`, whose line structure is not counted.
    opaque: bool = false,
    /// The byte range of the first `line` call's text.
    first: [i32, i32] = [0, 0],
    /// Names the text references, for `prune`.
    refs: List<String> = [],
}

struct FnOpenSeg {
    spec: FnSpec,
    depth: i32,
}

/// The brace closing a function body.
struct CloseSeg {
    depth: i32,
    blank_after: bool = false,
}

struct CallSeg {
    call: CallStmt,
    depth: i32,
    /// Names the bodies forwarded into this call `note`d.
    refs: List<String> = [],
}

/// One statement a forwarded function contributed at a call site, after the
/// call's `pre`. Forwarding replaces a call with one segment, so the positions
/// of the others never move.
struct LineSeg {
    pre: List<String>,
    text: String,
    depth: i32,
    refs: List<String>,
}

variant Seg {
    Text(TextSeg),
    FnOpen(FnOpenSeg),
    Close(CloseSeg),
    Call(CallSeg),
    Line(LineSeg),
    /// `return;` at the depth given.
    Return(i32),
}

/// Generated Wado source: indentation and blocks for the text, and the
/// functions, calls and references within it held apart, so `prune` can forward
/// and drop functions before anything is printed. The builder specs
/// (`StructSpec`, `VariantSpec`, `FnSpec`, …) construct declarations around it.
pub struct CodeWriter {
    segs: List<Seg>,
    cur: TextSeg,
    indent_level: i32,
    fresh_line: bool,
    id_counter: i32,
    /// Per open block, whether it is a function body `FnSpec::emit_begin` opened.
    fn_blocks: List<bool> = [],
    hoisted_names: List<[String, String]> = [],
    hoisted: String = "",
}

impl CodeWriter {
    pub fn new() -> CodeWriter {
        // Pre-size to 64 KB: amortizes `String::grow` doublings over a large
        // emit (Gale's parser for Rust runs to ≈ 1.3 MB), negligible for a small one.
        return CodeWriter::with_capacity(65536);
    }

    pub fn with_capacity(initial: i32) -> CodeWriter {
        return CodeWriter {
            segs: [],
            cur: TextSeg { text: String::with_capacity(initial) },
            indent_level: 0,
            fresh_line: true,
            id_counter: 0,
        };
    }

    /// Write text with auto-indentation at line starts.
    pub fn write<S: AsStrSlice>(&mut self, text: S) {
        self.cur.opaque = true;
        for let c of text.chars() {
            if c == '\n' {
                self.cur.text.push('\n');
                self.fresh_line = true;
            } else {
                if self.fresh_line {
                    self.write_indent();
                    self.fresh_line = false;
                }
                self.cur.text.push(c);
            }
        }
    }

    /// Write a complete line (auto-indented, with trailing newline).
    pub fn line<S: AsStrSlice>(&mut self, text: S) {
        self.write_indent();
        if self.cur.lines == 0 {
            let start = self.cur.text.len();
            self.cur.first = [start, start + text.len()];
        }
        self.cur.lines += 1;
        self.cur.text.push_str(text);
        self.cur.text.push('\n');
        self.fresh_line = true;
    }

    /// Emit a blank line.
    pub fn blank(&mut self) {
        let n = self.segs.len();
        if n > 0 && self.cur.text.is_empty() && self.cur.refs.is_empty() {
            if let Close(c) = self.segs[n - 1] {
                self.segs[n - 1] = Seg::Close(CloseSeg { depth: c.depth, blank_after: true });
                self.fresh_line = true;
                return;
            }
        }
        self.cur.text.push('\n');
        self.fresh_line = true;
    }

    /// Begin a block: emits "opener {" and increases indentation.
    pub fn begin<S: AsStrSlice>(&mut self, opener: S) {
        self.write_indent();
        self.cur.text.push_str(opener);
        self.cur.text.push_str(" {\n");
        self.cur.lines += 1;
        self.cur.blocks = true;
        self.fresh_line = true;
        self.indent_level += 1;
        self.fn_blocks.push(false);
    }

    /// End a block: decreases indentation and emits "}".
    pub fn end(&mut self) {
        self.indent_level -= 1;
        if self.fn_blocks.pop().unwrap_or(false) {
            self.flush_text();
            self.segs.push(Seg::Close(CloseSeg { depth: self.indent_level }));
            self.fresh_line = true;
            return;
        }
        self.write_indent();
        self.cur.text.push_str("}\n");
        self.cur.lines += 1;
        self.cur.blocks = true;
        self.fresh_line = true;
    }

    /// End a block with a trailing suffix, e.g. "," or "\n".
    pub fn end_with<S: AsStrSlice>(&mut self, suffix: S) {
        self.indent_level -= 1;
        assert !self.fn_blocks.pop().unwrap_or(false), "CodeWriter: a function body closes with `end`";
        self.write_indent();
        self.cur.text.push('}');
        self.cur.text.push_str(suffix);
        self.cur.text.push('\n');
        self.cur.lines += 1;
        self.cur.blocks = true;
        self.fresh_line = true;
    }

    /// Close the current block and open a new one: "} opener {".
    /// Useful for else-if chains: `w.else_begin("else if cond")`.
    pub fn else_begin<S: AsStrSlice>(&mut self, opener: S) {
        assert !self.fn_blocks.last().unwrap_or(false), "CodeWriter: a function body has no else";
        self.indent_level -= 1;
        self.write_indent();
        self.cur.text.push_str("} ");
        self.cur.text.push_str(opener);
        self.cur.text.push_str(" {\n");
        self.cur.lines += 1;
        self.cur.blocks = true;
        self.fresh_line = true;
        self.indent_level += 1;
    }

    /// A call statement at the current depth.
    pub fn call(&mut self, call: CallStmt) {
        self.flush_text();
        self.segs.push(Seg::Call(CallSeg { call, depth: self.indent_level }));
        self.fresh_line = true;
    }

    /// `return;` at the current depth.
    pub fn ret(&mut self) {
        self.flush_text();
        self.segs.push(Seg::Return(self.indent_level));
        self.fresh_line = true;
    }

    /// Record that the text here references `name`, which keeps a function or
    /// global of that name through `prune`.
    pub fn note<S: AsStrSlice>(&mut self, name: S) {
        self.cur.refs.push(name.to_string());
    }

    /// Splice in what `other` wrote, indented to the current depth.
    pub fn append(&mut self, other: &CodeWriter) {
        assert other.indent_level == 0, `CodeWriter: appending an unbalanced writer (level=${other.indent_level})`;
        assert other.hoisted.is_empty(), "CodeWriter: an appended writer holds a hoisted definition never written";
        self.flush_text();
        let d = self.indent_level;
        for let seg of &other.segs {
            self.segs.push(seg.shifted(d));
        }
        if !other.cur.text.is_empty() || !other.cur.refs.is_empty() {
            self.segs.push(Seg::Text(other.cur).shifted(d));
        }
        self.fresh_line = true;
    }

    fn open_fn(&mut self, spec: &FnSpec) {
        self.flush_text();
        self.segs.push(Seg::FnOpen(FnOpenSeg { spec: *spec, depth: self.indent_level }));
        self.fresh_line = true;
        self.indent_level += 1;
        self.fn_blocks.push(true);
    }

    fn flush_text(&mut self) {
        if self.cur.text.is_empty() && self.cur.refs.is_empty() {
            return;
        }
        self.segs.push(Seg::Text(self.cur));
        self.cur = TextSeg { text: String::new() };
    }

    /// Increase indentation level manually.
    pub fn indent(&mut self) {
        self.indent_level += 1;
    }

    /// Decrease indentation level manually.
    pub fn dedent(&mut self) {
        self.indent_level -= 1;
    }

    /// Generate a unique ID (replaces manual counter threading).
    pub fn next_id(&mut self) -> i32 {
        let id = self.id_counter;
        self.id_counter += 1;
        return id;
    }

    /// The name of a top-level function defined once per distinct `key`: `define`
    /// renders it from the name, and `write_hoisted` places it.
    pub fn hoist_fn<S: AsStrSlice, S1: AsStrSlice>(
        &mut self,
        key: S,
        prefix: S1,
        define: fn(&String) -> String,
    ) -> String {
        if let Some(hit) = self.hoisted_names.iter_ref().find(|kn| kn.0 == key.as_str_slice()) {
            return hit.1;
        }
        let name = `${prefix}${self.hoisted_names.len()}`;
        self.hoisted_names.push([key.to_string(), name]);
        self.hoisted.push_str(&define(&name));
        return name;
    }

    /// Write every definition `hoist_fn` has queued since the last call.
    pub fn write_hoisted(&mut self) {
        let text = self.hoisted;
        self.hoisted = "";
        self.raw(&text);
    }

    /// Append raw text with no indentation handling.
    pub fn raw<S: AsStrSlice>(&mut self, text: S) {
        self.cur.opaque = true;
        self.cur.text.push_str(text);
        if text.len() > 0 {
            self.fresh_line = text.as_str_slice().ends_with("\n");
        }
    }

    /// Return the generated code. Asserts that indentation is balanced.
    pub fn to_string(&self) -> String {
        assert self.indent_level == 0, `CodeWriter: unbalanced indentation (level=${self.indent_level})`;
        assert self.hoisted.is_empty(), "CodeWriter: a hoisted definition was never written";
        if self.segs.is_empty() {
            return self.cur.text;
        }
        let mut out = String::with_capacity(65536);
        for let seg of &self.segs {
            seg.print(&mut out);
        }
        Seg::Text(self.cur).print(&mut out);
        return out;
    }

    /// Whether `other` holds what this writer holds, segment for segment, so
    /// both print the same code. It compares without printing either, and can
    /// miss two writers that print alike from segments built differently.
    pub fn same_code(&self, other: &CodeWriter) -> bool {
        return self.segs == other.segs && self.cur == other.cur;
    }

    /// Forward calls through functions that only forward, then drop each
    /// function `FnSpec::set_prunable` marked that nothing kept calls or
    /// `note`s. Everything else written at the top level is kept, and what it
    /// references.
    ///
    /// A prunable function forwards when its body, apart from `note`d names, is
    /// one call returned, one call then `return;`, or one statement line then
    /// `return;`. A call to it passing its own parameters by name becomes that
    /// body, the call's statements and the callee's `pre` included. A call
    /// passing anything else is renamed to the inner callee instead, where the
    /// body forwards every parameter in order and runs nothing before.
    pub fn prune(&mut self) {
        self.flush_text();
        let items = self.items();
        let mut specs = TreeMap::<String, FnSpec>::new();
        for let item of &items {
            specs[item.spec.name] = item.spec;
        }
        for let mut round = 0; round < MAX_FORWARD_ROUNDS; round += 1 {
            if !self.forward_calls(&items, &specs) {
                break;
            }
        }
        self.drop_unreached(&items);
    }

    /// Every name the text `note`s or a call statement calls.
    pub fn references(&self) -> TreeSet<String> {
        let mut found: List<String> = [];
        for let seg of &self.segs {
            seg.collect_refs(&mut found);
        }
        found.extend(&self.cur.refs);
        let mut names = TreeSet::<String>::new();
        for let r of &found {
            names.insert(*r);
        }
        return names;
    }

    fn write_indent(&mut self) {
        for let mut i = 0; i < self.indent_level; i += 1 {
            self.cur.text.push_str("    ");
        }
    }

    /// The top-level function items, in order.
    fn items(&self) -> List<Item> {
        let mut items: List<Item> = [];
        let mut opened_at: Option<i32> = null;
        for let mut i = 0; i < self.segs.len(); i += 1 {
            match &self.segs[i] {
                FnOpen(f) && f.depth == 0 => {
                    opened_at = Option::Some(i);
                },
                Close(c) && c.depth == 0 => {
                    let Some(start) = opened_at else {
                        panic("CodeWriter: a function body closes that never opened");
                    };
                    let FnOpen(f) = &self.segs[start] else {
                        unreachable();
                    };
                    items.push(Item { spec: f.spec, start, end: i });
                    opened_at = null;
                },
                _ => {
                },
            }
        }
        return items;
    }

    /// One round of forwarding over the functions `items`, `specs` holding each
    /// by name. Whether any call changed.
    fn forward_calls(&mut self, items: &List<Item>, specs: &TreeMap<String, FnSpec>) -> bool {
        let mut forwards = TreeMap::<String, Forward>::new();
        for let item of items {
            if item.spec.prunable {
                if let Some(fw) = self.forward_of(item) {
                    forwards[item.spec.name] = fw;
                }
            }
        }
        if forwards.is_empty() {
            return false;
        }
        let mut changed = false;
        for let mut i = 0; i < self.segs.len(); i += 1 {
            let Call(site) = &self.segs[i] else {
                continue;
            };
            let Some(fw) = forwards.get_ref_str(&site.call.callee) else {
                continue;
            };
            let Some(spec) = specs.get_ref_str(&site.call.callee) else {
                unreachable();
            };
            if let Some(seg) = forward_site(site, spec, fw, specs) {
                self.segs[i] = seg;
                changed = true;
            }
        }
        return changed;
    }

    /// What a call to `item` can run instead, or `null`.
    fn forward_of(&self, item: &Item) -> Option<Forward> {
        let mut refs: List<String> = [];
        let mut body: List<i32> = [];
        for let mut i = item.start + 1; i < item.end; i += 1 {
            if let Text(t) = &self.segs[i] {
                refs.extend(&t.refs);
                if t.text.is_empty() {
                    continue;
                }
            }
            if body.len() == 2 {
                return null;
            }
            body.push(i);
        }
        if body.is_empty() {
            return null;
        }
        let first = &self.segs[body[0]];
        if body.len() == 1 {
            let Call(c) = first else {
                return null;
            };
            if !c.call.form matches { Return } {
                return null;
            }
            refs.extend(&c.refs);
            return Option::Some(Forward { kind: ForwardKind::Call(c.call), refs });
        }
        if !self.segs[body[1]] matches { Return(_) } {
            return null;
        }
        return match first {
            Call(c) && c.call.form matches { Discard } => {
                refs.extend(&c.refs);
                Option::Some(Forward { kind: ForwardKind::Call(c.call), refs });
            },
            Text(t) && t.lines == 1 && !t.blocks && !t.opaque => Option::Some(
                Forward { kind: ForwardKind::Stmt(t.text.substr_bytes(t.first.0, t.first.1)), refs },
            ),
            _ => null,
        };
    }

    /// Drop the prunable functions of `items` nothing kept reaches.
    fn drop_unreached(&mut self, items: &List<Item>) {
        let mut item_of = TreeMap::<String, i32>::new();
        for let mut k = 0; k < items.len(); k += 1 {
            item_of[items[k].spec.name] = k;
        }
        let mut kept: List<bool> = [];
        let mut queue: List<i32> = [];
        for let mut k = 0; k < items.len(); k += 1 {
            let root = !items[k].spec.prunable;
            kept.push(root);
            if root {
                queue.push(k);
            }
        }
        let mut names: List<String> = [];
        let mut next_item = 0;
        for let mut i = 0; i < self.segs.len(); i += 1 {
            if next_item < items.len() && i == items[next_item].start {
                i = items[next_item].end;
                next_item += 1;
                continue;
            }
            self.segs[i].collect_refs(&mut names);
        }
        for let name of &names {
            reach(name, &item_of, &mut kept, &mut queue);
        }
        while let Some(k) = queue.pop() {
            names.clear();
            for let mut i = items[k].start; i <= items[k].end; i += 1 {
                self.segs[i].collect_refs(&mut names);
            }
            for let name of &names {
                reach(name, &item_of, &mut kept, &mut queue);
            }
        }
        let mut out: List<Seg> = [];
        let mut next = 0;
        for let mut i = 0; i < self.segs.len(); i += 1 {
            if next < items.len() && i == items[next].start {
                if !kept[next] {
                    i = items[next].end;
                    next += 1;
                    continue;
                }
                next += 1;
            }
            out.push(self.segs[i]);
        }
        self.segs = out;
    }
}

/// Forwarding rounds before `prune` stops following chains of forwarders. Each
/// round resolves one link of every chain, and generated code nests few.
global MAX_FORWARD_ROUNDS: i32 = 8;

/// A top-level function: its spec and the segments of its head and closing brace.
struct Item {
    spec: FnSpec,
    start: i32,
    end: i32,
}

variant ForwardKind {
    Call(CallStmt),
    Stmt(String),
}

/// What a forwarding function runs, and the names its body `note`s.
struct Forward {
    kind: ForwardKind,
    refs: List<String>,
}

/// Mark the item `name` names kept, if there is one.
fn reach(name: &String, item_of: &TreeMap<String, i32>, kept: &mut List<bool>, queue: &mut List<i32>) {
    if let Some(k) = item_of.get_str(name) {
        if !kept[k] {
            kept[k] = true;
            queue.push(k);
        }
    }
}

/// What `site`, a call to the function `spec` names, becomes under `fw`, or
/// `null` where it cannot be forwarded.
fn forward_site(site: &CallSeg, spec: &FnSpec, fw: &Forward, specs: &TreeMap<String, FnSpec>) -> Option<Seg> {
    let passes_params = site.call.args == spec.param_names();
    let call = match &fw.kind {
        Stmt(text) => {
            if !passes_params || !site.call.form matches { Discard } {
                return null;
            }
            let mut refs = site.refs;
            refs.extend(&fw.refs);
            return Option::Some(Seg::Line(LineSeg { pre: site.call.pre, text: *text, depth: site.depth, refs }));
        },
        Call(inner) => inner,
    };
    if call.callee == spec.name {
        return null;
    }
    // A body discarding the inner result forwards a value only where there is
    // none to discard.
    if call.form matches { Discard } && !site.call.form matches { Discard } {
        let Some(target) = specs.get_ref_str(&call.callee) else {
            return null;
        };
        if !target.returns_unit() {
            return null;
        }
    }
    let mut pre = site.call.pre;
    let args = if passes_params {
        pre.extend(&call.pre);
        call.args;
    } else {
        if !call.pre.is_empty()
            || call.args != spec.param_names()
            || !renamed_call_keeps_defaults(site, spec, call, specs) {
            return null;
        }
        site.call.args;
    };
    let mut refs = site.refs;
    refs.extend(&fw.refs);
    return Option::Some(Seg::Call(CallSeg {
        call: CallStmt { pre, form: site.call.form, callee: call.callee, args },
        depth: site.depth,
        refs,
    }));
}

/// Whether a call leaving out `spec`'s defaulted parameters gets the same
/// defaults from the inner callee.
fn renamed_call_keeps_defaults(site: &CallSeg, spec: &FnSpec, call: &CallStmt, specs: &TreeMap<String, FnSpec>) -> bool {
    let given = site.call.args.len();
    if given == spec.params.len() {
        return true;
    }
    let Some(target) = specs.get_ref_str(&call.callee) else {
        return false;
    };
    for let mut i = given; i < spec.params.len(); i += 1 {
        if i >= target.params.len() || target.params[i].default_value != spec.params[i].default_value {
            return false;
        }
    }
    return true;
}

impl Seg {
    /// This segment spliced in `levels` deeper.
    fn shifted(&self, levels: i32) -> Seg {
        return match self {
            Text(t) => Seg::Text(TextSeg { ..*t, offset: t.offset + levels }),
            FnOpen(f) => Seg::FnOpen(FnOpenSeg { spec: f.spec, depth: f.depth + levels }),
            Close(c) => Seg::Close(CloseSeg { depth: c.depth + levels, blank_after: c.blank_after }),
            Call(c) => Seg::Call(CallSeg { ..*c, depth: c.depth + levels }),
            Line(l) => Seg::Line(LineSeg { ..*l, depth: l.depth + levels }),
            Return(d) => Seg::Return(*d + levels),
        };
    }

    /// Push the names this segment references, repeats included.
    fn collect_refs(&self, names: &mut List<String>) {
        match self {
            Text(t) => names.extend(&t.refs),
            Line(l) => names.extend(&l.refs),
            Call(c) => {
                names.push(c.call.callee);
                names.extend(&c.refs);
            },
            FnOpen(_) | Close(_) | Return(_) => {
            },
        }
    }

    fn print(&self, out: &mut String) {
        match self {
            Text(t) => print_shifted(out, &t.text, t.offset),
            FnOpen(f) => {
                push_indent(out, f.depth);
                out.push_str(&f.spec.signature());
                out.push_str(" {\n");
            },
            Close(c) => {
                push_indent(out, c.depth);
                out.push_str(if c.blank_after { "}\n\n" } else { "}\n" });
            },
            Call(c) => {
                print_lines(out, &c.call.pre, c.depth);
                push_indent(out, c.depth);
                match &c.call.form {
                    Discard => {
                    },
                    Return => out.push_str("return "),
                    Bind(prefix) => out.push_str(prefix),
                }
                out.push_str(&c.call.callee);
                out.push('(');
                out.push_str(&join_comma(&c.call.args));
                out.push_str(");\n");
            },
            Line(l) => {
                print_lines(out, &l.pre, l.depth);
                push_indent(out, l.depth);
                out.push_str(&l.text);
                out.push('\n');
            },
            Return(d) => {
                push_indent(out, *d);
                out.push_str("return;\n");
            },
        }
    }
}

fn print_lines(out: &mut String, lines: &List<String>, depth: i32) {
    for let l of lines {
        push_indent(out, depth);
        out.push_str(l);
        out.push('\n');
    }
}

fn push_indent(out: &mut String, depth: i32) {
    for let mut i = 0; i < depth; i += 1 {
        out.push_str("    ");
    }
}

/// `text` with `levels` more indentation at each line start that has content.
fn print_shifted(out: &mut String, text: &String, levels: i32) {
    if levels == 0 {
        out.push_str(text);
        return;
    }
    let mut fresh = true;
    for let c of text.chars() {
        if c == '\n' {
            fresh = true;
        } else if fresh {
            push_indent(out, levels);
            fresh = false;
        }
        out.push(c);
    }
}

/// The lexical state the template text of a `wado` tag is in at a hole: the
/// contexts the compiler's own lexer has, which this must agree with. `Tpl`
/// needs no nesting count, since the tag's own holes are the interpolations.
enum Ctx {
    Code,
    CodeSlash,
    Str,
    StrEscape,
    Chr,
    ChrEscape,
    Tpl,
    TplEscape,
    LineComment,
    BlockComment,
    BlockCommentStar,
}

/// The state one character further on.
fn step(ctx: Ctx, c: char) -> Ctx {
    return match ctx {
        Ctx::Code => open(c),
        Ctx::CodeSlash => match c {
            '/' => Ctx::LineComment,
            '*' => Ctx::BlockComment,
            _ => open(c),
        },
        Ctx::Str => match c {
            '\\' => Ctx::StrEscape,
            '"' => Ctx::Code,
            _ => Ctx::Str,
        },
        Ctx::StrEscape => Ctx::Str,
        Ctx::Chr => match c {
            '\\' => Ctx::ChrEscape,
            '\'' => Ctx::Code,
            _ => Ctx::Chr,
        },
        Ctx::ChrEscape => Ctx::Chr,
        Ctx::Tpl => match c {
            '\\' => Ctx::TplEscape,
            '`' => Ctx::Code,
            _ => Ctx::Tpl,
        },
        Ctx::TplEscape => Ctx::Tpl,
        Ctx::LineComment => match c {
            '\n' => Ctx::Code,
            _ => Ctx::LineComment,
        },
        Ctx::BlockComment => match c {
            '*' => Ctx::BlockCommentStar,
            _ => Ctx::BlockComment,
        },
        Ctx::BlockCommentStar => match c {
            '/' => Ctx::Code,
            '*' => Ctx::BlockCommentStar,
            _ => Ctx::BlockComment,
        },
    };
}

/// The state `c` opens from code.
fn open(c: char) -> Ctx {
    return match c {
        '"' => Ctx::Str,
        '\'' => Ctx::Chr,
        '`' => Ctx::Tpl,
        '/' => Ctx::CodeSlash,
        _ => Ctx::Code,
    };
}

/// Advance the lexical state over one literal segment. Kept apart from `step`
/// so both fit the inliner's budget: the whole walk then folds to a constant at
/// -O2 and the tag pays nothing for it.
fn advance<S: AsStrSlice>(ctx: Ctx, lit: S) -> Ctx {
    let mut cur = ctx;
    for let c of lit.chars() {
        cur = step(cur, c);
    }
    return cur;
}

/// The delimiter a hole landing in `ctx` is escaped for, or none where it is
/// written as it renders.
fn hole_quote(ctx: Ctx) -> Option<u8> {
    return match ctx {
        Ctx::Code | Ctx::CodeSlash | Ctx::LineComment | Ctx::BlockComment | Ctx::BlockCommentStar => null,
        Ctx::Str | Ctx::StrEscape => Option::Some(b'"'),
        Ctx::Chr | Ctx::ChrEscape => Option::Some(b'\''),
        Ctx::Tpl | Ctx::TplEscape => Option::Some(b'`'),
    };
}

/// Whether `b` may not stand as itself inside a Wado literal delimited by
/// `quote`. Every other byte passes through, so printable non-ASCII survives.
fn needs_escape(b: u8, quote: u8) -> bool {
    return b < 0x20 || b == 0x7f || b == quote || b == b'\\' || quote == b'`' && b == b'$';
}

/// Append `b` in the form a Wado literal delimited by `quote` reads back. The
/// control-char policy mirrors `Inspect for String` in core's `format.wado`;
/// keep the two in lockstep (see WEP: Inspect).
fn write_escaped(out: &mut String, b: u8, quote: u8) {
    assert needs_escape(b, quote);
    if b == quote || b == b'\\' || b == b'$' {
        out.push('\\');
        out.push_ascii_unchecked(b);
        return;
    }
    match b {
        b'\n' => out.push_str("\\n"),
        b'\r' => out.push_str("\\r"),
        b'\t' => out.push_str("\\t"),
        _ => out.push_str(`\\u{${b:x}}`),
    }
}

/// Escape in place the text `out` grew past `at`, which is one hole's
/// rendering, for a literal delimited by `quote`. Nothing to escape costs one
/// scan and no copy.
fn escape_in_place(out: &mut String, at: i32, quote: u8) {
    let n = out.len();
    let mut i = at;
    while i < n && !needs_escape(out.get_byte_unchecked(i), quote) {
        i += 1;
    }
    if i == n {
        return;
    }
    let tail = out.substr_bytes_unchecked(i, n);
    out.truncate_unchecked(i);
    let end = tail.len();
    let mut from = 0;
    for let mut j = 0; j < end; j += 1 {
        let b = tail.get_byte_unchecked(j);
        if !needs_escape(b, quote) {
            continue;
        }
        if j > from {
            out.push_str_range_unchecked(&tail, from, j);
        }
        write_escaped(out, b, quote);
        from = j + 1;
    }
    if end > from {
        out.push_str_range_unchecked(&tail, from, end);
    }
}

/// Build a fragment of Wado source (WEP: Tagged Template Literals), escaping
/// each hole for the lexical context the template's own text put it in.
pub fn wado<T: ReflectTemplate<Holes = [..V]>, ..V: Display>(t: T) -> String {
    let mut out = String::with_capacity(64);
    let mut ctx = Ctx::Code;
    for let h of ReflectTemplate::<T>::members() {
        let lit = h.lit();
        out.push_str(&lit);
        ctx = advance(ctx, &lit);
        // A backslash left pending at a hole binds the hole's first byte, and
        // which state that lands in depends on the value: `z` stays in the
        // string, an escaped `"` closes it. The scan reads literals only, so it
        // cannot answer for the rest of the template. The template is malformed.
        assert !ctx matches { Ctx::StrEscape | Ctx::ChrEscape | Ctx::TplEscape }, "a `wado` hole cannot follow a dangling backslash";
        let at = out.len();
        h.fmt(&t, &mut Formatter::new(&mut out));
        if let Some(quote) = hole_quote(ctx) {
            escape_in_place(&mut out, at, quote);
        }
    }
    out.push_str(&ReflectTemplate::<T>::tail());
    return out;
}

/// `bytes` as a byte string literal. Printable ASCII other than `"` and `\`
/// stands as itself, and every other byte is a `\x` escape.
pub fn byte_string_literal<S: AsByteSlice>(bytes: S) -> String {
    let view = bytes.as_byte_slice();
    let mut out = String::with_capacity(view.len() * 4 + 3);
    out.push_str("b\"");
    for let mut i = 0; i < view.len(); i += 1 {
        let b = view.get_unchecked(i);
        if b'\x20' <= b <= b'\x7e' && b != b'"' && b != b'\\' {
            out.push_ascii_unchecked(b);
        } else {
            out.push_str("\\x");
            out.push_ascii_unchecked(HEX_DIGITS.get_byte_unchecked((b >> 4) as i32));
            out.push_ascii_unchecked(HEX_DIGITS.get_byte_unchecked((b & 0xf) as i32));
        }
    }
    out.push('"');
    return out;
}

global HEX_DIGITS: String = "0123456789abcdef";

pub type CharRangePat = RangeInclusive<char>;

pub fn char_range_pat(range: RangeInclusive<char>) -> CharRangePat {
    return range as CharRangePat;
}

impl Display for CharRangePat {
    pub fn fmt(&self, f: &mut Formatter) {
        let range = *self as RangeInclusive<char>;
        if range.start == range.end {
            f.write_str(wado`'${range.start}'`);
            return;
        }
        f.write_str(wado`'${range.start}'..='${range.end}'`);
    }
}

/// Visibility modifier for an emitted Wado declaration — the scope ladder
/// (file-private / `internal` / `pub`). Passed to the spec builders as a
/// defaulted argument, so the common file-private case stays implicit.
pub enum Vis {
    Private,
    Internal,
    Pub,
}

impl Vis {
    /// Source keyword with a trailing space (`""`, `"internal "`, `"pub "`).
    pub fn prefix(&self) -> String {
        let p = match *self {
            Vis::Private => "",
            Vis::Internal => "internal ",
            Vis::Pub => "pub ",
        };
        return p;
    }
}

pub struct FieldSpec {
    pub name: String,
    pub type_str: String,
    pub is_pub: bool,
    /// Optional field default (`field: T = default`), so a struct literal can
    /// omit the field.
    pub default: Option<String> = null,
    /// Attribute bodies, each written `#[body]` on its own line above the field.
    pub attrs: List<String> = [],
}

impl FieldSpec {
    pub fn new<S: AsStrSlice, S1: AsStrSlice>(name: S, type_str: S1) -> FieldSpec {
        return FieldSpec {
            name: name.to_string(),
            type_str: type_str.to_string(),
            is_pub: false,
        };
    }

    pub fn new_pub<S: AsStrSlice, S1: AsStrSlice>(name: S, type_str: S1) -> FieldSpec {
        return FieldSpec {
            name: name.to_string(),
            type_str: type_str.to_string(),
            is_pub: true,
        };
    }
}

pub struct StructSpec {
    pub name: String,
    fields: List<FieldSpec>,
    visibility: Vis,
}

impl StructSpec {
    pub fn new<S: AsStrSlice>(name: S, visibility: Vis = Vis::Private) -> StructSpec {
        return StructSpec { name: name.to_string(), fields: [], visibility };
    }

    pub fn add_field<S: AsStrSlice, S1: AsStrSlice>(&mut self, name: S, type_str: S1) -> &mut StructSpec {
        self.fields.push(FieldSpec::new(name, type_str));
        return self;
    }

    pub fn add_pub_field<S: AsStrSlice, S1: AsStrSlice>(&mut self, name: S, type_str: S1) -> &mut StructSpec {
        self.fields.push(FieldSpec::new_pub(name, type_str));
        return self;
    }

    pub fn add_field_default<S: AsStrSlice, S1: AsStrSlice, S2: AsStrSlice>(
        &mut self,
        name: S,
        type_str: S1,
        default: S2,
    ) -> &mut StructSpec {
        self.fields.push(FieldSpec {
            name: name.to_string(),
            type_str: type_str.to_string(),
            is_pub: false,
            default: Option::Some(default.to_string()),
        });
        return self;
    }

    pub fn add_field_spec(&mut self, field: FieldSpec) -> &mut StructSpec {
        self.fields.push(field);
        return self;
    }

    pub fn emit(&self, w: &mut CodeWriter) {
        let head = `${self.visibility.prefix()}struct ${self.name}`;
        if self.fields.is_empty() {
            w.line(`${head} {}`);
            return;
        }
        w.begin(head);
        for let field of &self.fields {
            write_attrs(w, &field.attrs);
            let vis = if field.is_pub { "pub " } else { "" };
            match &field.default {
                Some(d) => w.line(`${vis}${field.name}: ${field.type_str} = ${*d},`),
                None => w.line(`${vis}${field.name}: ${field.type_str},`),
            }
        }
        w.end();
    }
}

pub struct WadoVariantCase {
    pub name: String,
    pub payload: Option<String>,
}

pub struct VariantSpec {
    pub name: String,
    cases: List<WadoVariantCase>,
    visibility: Vis,
}

impl VariantSpec {
    pub fn new<S: AsStrSlice>(name: S, visibility: Vis = Vis::Private) -> VariantSpec {
        return VariantSpec { name: name.to_string(), cases: [], visibility };
    }

    pub fn add_case<S: AsStrSlice>(&mut self, name: S) -> &mut VariantSpec {
        self.cases.push(WadoVariantCase { name: name.to_string(), payload: null });
        return self;
    }

    pub fn add_case_with_payload<S: AsStrSlice, S1: AsStrSlice>(&mut self, name: S, payload: S1) -> &mut VariantSpec {
        self.cases.push(WadoVariantCase {
            name: name.to_string(),
            payload: Option::<String>::Some(payload.to_string()),
        });
        return self;
    }

    pub fn emit(&self, w: &mut CodeWriter) {
        w.begin(`${self.visibility.prefix()}variant ${self.name}`);
        for let case of &self.cases {
            if let Some(p) = &case.payload {
                w.line(`${case.name}(${*p}),`);
            } else {
                w.line(`${case.name},`);
            }
        }
        w.end();
    }
}

pub struct EnumMember {
    pub name: String,
    pub trailing_comment: Option<String>,
    pub attrs: List<String> = [],
}

fn write_attrs(w: &mut CodeWriter, attrs: &List<String>) {
    for let attr of attrs {
        w.line(`#[${attr}]`);
    }
}

pub struct EnumSpec {
    pub name: String,
    members: List<EnumMember>,
    visibility: Vis,
}

impl EnumSpec {
    pub fn new<S: AsStrSlice>(name: S, visibility: Vis = Vis::Private) -> EnumSpec {
        return EnumSpec { name: name.to_string(), members: [], visibility };
    }

    pub fn add_member<S: AsStrSlice>(&mut self, name: S) -> &mut EnumSpec {
        self.members.push(EnumMember { name: name.to_string(), trailing_comment: null });
        return self;
    }

    pub fn add_member_with_attrs<S: AsStrSlice>(&mut self, name: S, attrs: List<String>) -> &mut EnumSpec {
        self.members.push(EnumMember { name: name.to_string(), trailing_comment: null, attrs });
        return self;
    }

    pub fn add_member_with_comment<S: AsStrSlice, S1: AsStrSlice>(&mut self, name: S, comment: S1) -> &mut EnumSpec {
        self.members.push(EnumMember {
            name: name.to_string(),
            trailing_comment: Option::<String>::Some(comment.to_string()),
        });
        return self;
    }

    pub fn emit(&self, w: &mut CodeWriter) {
        w.begin(`${self.visibility.prefix()}enum ${self.name}`);
        for let member of &self.members {
            write_attrs(w, &member.attrs);
            if let Some(c) = &member.trailing_comment {
                w.line(`${member.name},  // ${*c}`);
            } else {
                w.line(`${member.name},`);
            }
        }
        w.end();
    }
}

pub struct ParamSpec {
    pub name: String,
    pub type_str: String,
    pub is_mut: bool = false,
    pub default_value: Option<String> = null,
}

impl ParamSpec {
    pub fn new<S: AsStrSlice, S1: AsStrSlice>(name: S, type_str: S1) -> ParamSpec {
        return ParamSpec {
            name: name.to_string(),
            type_str: type_str.to_string(),
        };
    }
}

/// Join strings with ", " — the separator every spec list (generics,
/// effects, …) renders with.
fn join_comma(items: &List<String>) -> String {
    let mut out = String::with_capacity(items.len() * 8);
    for let mut i = 0; i < items.len(); i += 1 {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(&items[i]);
    }
    return out;
}

pub struct FnSpec {
    pub name: String,
    params: List<ParamSpec>,
    return_type: Option<String>,
    visibility: Vis,
    is_export: bool,
    /// Generic type parameters, each rendered verbatim between the name
    /// and the parameter list (e.g. `"V: Visitor"` → `fn walk<V: Visitor>(`).
    generics: List<String>,
    /// Effect names for the `with …` clause, rendered after the return
    /// type (e.g. `["Stdout", "Stderr"]` → ` with (Stdout, Stderr)`).
    effects: List<String>,
    receiver: Option<String>,
    /// Whether `CodeWriter::prune` may drop it when nothing kept references it.
    prunable: bool = false,
}

impl FnSpec {
    pub fn new<S: AsStrSlice>(name: S, visibility: Vis = Vis::Private) -> FnSpec {
        return FnSpec {
            name: name.to_string(),
            params: [],
            return_type: null,
            visibility,
            is_export: false,
            generics: [],
            effects: [],
            receiver: null,
        };
    }

    /// Let `CodeWriter::prune` drop the function when nothing kept calls it or
    /// `note`s its name, and forward calls through it. Every reference to it
    /// must then be a `CallStmt` or a `note`.
    pub fn set_prunable(&mut self) -> &mut FnSpec {
        self.prunable = true;
        return self;
    }

    fn param_names(&self) -> List<String> {
        return self.params.iter_ref().map(|p| p.name).collect();
    }

    fn returns_unit(&self) -> bool {
        return match &self.return_type {
            None => true,
            Some(t) => *t == "()",
        };
    }

    /// Mark the function `export` (component-model export). `export` implies
    /// `pub`; the signature emits just `export`, never `pub export`.
    pub fn set_export(&mut self) -> &mut FnSpec {
        self.is_export = true;
        return self;
    }

    pub fn add_generic<S: AsStrSlice>(&mut self, generic: S) -> &mut FnSpec {
        self.generics.push(generic.to_string());
        return self;
    }

    pub fn add_effect<S: AsStrSlice>(&mut self, effect_name: S) -> &mut FnSpec {
        self.effects.push(effect_name.to_string());
        return self;
    }

    pub fn set_receiver<S: AsStrSlice>(&mut self, recv: S) -> &mut FnSpec {
        self.receiver = Option::<String>::Some(recv.to_string());
        return self;
    }

    pub fn add_param<S: AsStrSlice, S1: AsStrSlice>(&mut self, name: S, type_str: S1) -> &mut FnSpec {
        self.params.push(ParamSpec::new(name, type_str));
        return self;
    }

    pub fn add_param_spec(&mut self, param: ParamSpec) -> &mut FnSpec {
        self.params.push(param);
        return self;
    }

    pub fn set_return_type<S: AsStrSlice>(&mut self, type_str: S) -> &mut FnSpec {
        self.return_type = Option::<String>::Some(type_str.to_string());
        return self;
    }

    /// Emit the function signature as a `begin` block (opens `{`).
    /// Caller writes the body via `w`, then calls `w.end()`.
    pub fn emit_begin(&self, w: &mut CodeWriter) {
        w.open_fn(self);
    }

    /// Build the full signature string.
    pub fn signature(&self) -> String {
        let mut sig = String::with_capacity(64);
        if self.is_export {
            sig.push_str("export ");
        } else {
            sig.push_str(&self.visibility.prefix());
        }
        sig.push_str(`fn ${self.name}`);
        if self.generics.len() > 0 {
            sig.push_str(`<${join_comma(&self.generics)}>`);
        }
        sig.push_str("(");
        let mut first = true;
        if let Some(recv) = &self.receiver {
            sig.push_str(recv);
            first = false;
        }
        for let param of &self.params {
            if !first {
                sig.push_str(", ");
            }
            if param.is_mut {
                sig.push_str("mut ");
            }
            sig.push_str(`${param.name}: ${param.type_str}`);
            if let Some(d) = &param.default_value {
                sig.push_str(` = ${*d}`);
            }
            first = false;
        }
        sig.push_str(")");
        if let Some(ret) = &self.return_type {
            sig.push_str(` -> ${*ret}`);
        }
        let mut clauses: List<String> = [];
        for let e of &self.effects {
            clauses.push(*e);
        }
        if clauses.len() == 1 {
            sig.push_str(` with ${clauses[0]}`);
        } else if clauses.len() > 1 {
            sig.push_str(` with (${join_comma(&clauses)})`);
        }
        return sig;
    }
}

pub struct GlobalSpec {
    pub name: String,
    type_str: String,
    initializer: String,
    visibility: Vis,
    is_mut: bool,
    trailing_comment: Option<String>,
}

impl GlobalSpec {
    pub fn new<S: AsStrSlice, S1: AsStrSlice, S2: AsStrSlice>(
        name: S,
        type_str: S1,
        initializer: S2,
        visibility: Vis = Vis::Private,
    ) -> GlobalSpec {
        return GlobalSpec {
            name: name.to_string(),
            type_str: type_str.to_string(),
            initializer: initializer.to_string(),
            visibility,
            is_mut: false,
            trailing_comment: null,
        };
    }

    pub fn set_trailing_comment<S: AsStrSlice>(&mut self, comment: S) -> &mut GlobalSpec {
        self.trailing_comment = Option::<String>::Some(comment.to_string());
        return self;
    }

    pub fn emit(&self, w: &mut CodeWriter) {
        let vis = self.visibility.prefix();
        let mutability = if self.is_mut { "mut " } else { "" };
        let trailer = if let Some(c) = &self.trailing_comment {
            `  // ${*c}`;
        } else {
            "";
        };
        w.line(`${vis}global ${mutability}${self.name}: ${self.type_str} = ${self.initializer};${trailer}`);
    }
}

pub struct ImplSpec {
    type_name: String,
    trait_name: Option<String>,
}

impl ImplSpec {
    pub fn new<S: AsStrSlice>(type_name: S) -> ImplSpec {
        return ImplSpec { type_name: type_name.to_string(), trait_name: null };
    }

    pub fn new_trait<S: AsStrSlice, S1: AsStrSlice>(trait_name: S, type_name: S1) -> ImplSpec {
        return ImplSpec {
            type_name: type_name.to_string(),
            trait_name: Option::<String>::Some(trait_name.to_string()),
        };
    }

    pub fn emit_begin(&self, w: &mut CodeWriter) {
        if let Some(t) = &self.trait_name {
            w.begin(`impl ${*t} for ${self.type_name}`);
        } else {
            w.begin(`impl ${self.type_name}`);
        }
    }
}
