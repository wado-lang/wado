/// Whether `name` cannot be written as a name anywhere, not even where a
/// type or enum qualifies it: a keyword the parser does not take as a name.
pub fn is_keyword<S: AsStrSlice>(name: S) -> bool {
    let name = name.as_str_slice();
    return match name.len() {
        1 => match name {
            "_" => true,
            _ => false,
        },
        2 => match name {
            "as" | "do" | "fn" | "if" | "in" => true,
            _ => false,
        },
        3 => match name {
            "for" | "let" | "mut" | "pub" | "use" => true,
            _ => false,
        },
        4 => match name {
            "Self" | "else" | "enum" | "impl" | "loop" | "null" | "self" | "task" | "test" | "trap" | "true" | "with" => true,
            _ => false,
        },
        5 => match name {
            "async" | "break" | "const" | "false" | "match" | "trait" | "while" | "world" => true,
            _ => false,
        },
        6 => match name {
            "affine" | "assert" | "effect" | "export" | "global" | "import" | "resume" | "return" | "struct" => true,
            _ => false,
        },
        7 => match name {
            "forward" | "matches" | "variant" => true,
            _ => false,
        },
        8 => match name {
            "continue" | "contract" | "internal" | "reactive" | "resource" => true,
            _ => false,
        },
        9 => match name {
            "interface" | "unchecked" => true,
            _ => false,
        },
        _ => false,
    };
}

/// Whether a generated declaration named `name` would collide with the
/// language: a keyword, or a name `core:prelude` puts in every module's scope.
pub fn is_reserved<S: AsStrSlice>(name: S) -> bool {
    return is_keyword(name) || is_prelude_name(name);
}

