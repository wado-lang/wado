//! Wadopoet: builders for generated Wado source.
//!
//! `CodeWriter` indents and blocks, the specs (`StructSpec`, `FnSpec`, …) build
//! declarations around it, and `wado` escapes a hole for the literal it sits
//! in. `is_reserved` says which names a minted one must avoid, `is_keyword`
//! the part of them a qualified name, like an enum case, must avoid.

pub use {
    CodeWriter,
    FieldSpec,
    StructSpec,
    VariantCase,
    VariantSpec,
    EnumMember,
    EnumSpec,
    ParamSpec,
    FnSpec,
    GlobalSpec,
    ImplSpec,
    Vis,
    CharRangePat,
    char_range_pat,
    byte_string_literal,
    wado,
} from "./wadopoet.wado";
pub use { is_keyword, is_reserved } from "./vocabulary.wado";
