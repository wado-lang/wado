//! Wadopoet: builders for generated Wado source.
//!
//! `CodeWriter` indents and blocks, the specs (`StructSpec`, `FnSpec`, …) build
//! declarations around it, and `wado` escapes a hole for the literal it sits
//! in. `escape_ident` keeps a minted name clear of the language's vocabulary.

pub use {
    CodeWriter,
    FieldSpec,
    StructSpec,
    VariantCase,
    VariantSpec,
    EnumMember,
    EnumSpec,
    ParamSpec,
    FnSpec,
    GlobalSpec,
    ImplSpec,
    Vis,
    CharRangePat,
    char_range_pat,
    wado,
} from "./wadopoet.wado";
pub use { is_reserved, escape_ident } from "./ident.wado";
pub use { is_keyword, is_prelude_name } from "./vocabulary.wado";
