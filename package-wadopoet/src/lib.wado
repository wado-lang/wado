//! Wadopoet: builders for generated Wado source.
//!
//! `CodeWriter` indents and blocks, the specs (`StructSpec`, `FnSpec`, …) build
//! declarations around it, and `wado` escapes a hole for the literal it sits
//! in. `is_reserved` says which names a minted one must avoid.

pub use {
    CodeWriter,
    FieldSpec,
    StructSpec,
    VariantCase,
    VariantSpec,
    EnumMember,
    EnumSpec,
    ParamSpec,
    FnSpec,
    GlobalSpec,
    ImplSpec,
    Vis,
    CharRangePat,
    char_range_pat,
    wado,
} from "./wadopoet.wado";
pub use { is_reserved } from "./vocabulary.wado";
