use {
    CodeWriter,
    CallStmt,
    CallForm,
    FieldSpec,
    StructSpec,
    VariantSpec,
    EnumSpec,
    ParamSpec,
    FnSpec,
    GlobalSpec,
    ImplSpec,
    Vis,
    wado,
    char_range_pat,
    byte_string_literal,
} from "./wadopoet.wado";
use { eval } from "core:eval";

/// What a command prints when `body` is its `run`, beside `items`.
fn printed(body: String, items: String = "") -> String {
    let out = eval(`use { print, Stdout } from "core:cli";
${items}
export fn run() with Stdout {
${body}
}`).unwrap();
    assert out.status matches { Exited(0) }, `${out.status}\n${out.stderr}`;
    return out.stdout;
}

test "empty writer" {
    let w = CodeWriter::new();
    assert w.to_string() == "";
}

test "single line" {
    let mut w = CodeWriter::new();
    w.line("let x = 42;");
    assert w.to_string() == "let x = 42;\n";
}

test "multiple lines" {
    let mut w = CodeWriter::new();
    w.line("let x = 1;");
    w.line("let y = 2;");
    assert w.to_string() == "let x = 1;\nlet y = 2;\n";
}

test "blank line" {
    let mut w = CodeWriter::new();
    w.line("let x = 1;");
    w.blank();
    w.line("let y = 2;");
    assert w.to_string() == "let x = 1;\n\nlet y = 2;\n";
}

test "begin/end block" {
    let mut w = CodeWriter::new();
    w.begin("struct Foo");
    w.line("x: i32,");
    w.line("y: i32,");
    w.end();
    let expected = "struct Foo {\n    x: i32,\n    y: i32,\n}\n";
    assert w.to_string() == expected, `got: ${w.to_string()}`;
}

test "nested blocks" {
    let mut w = CodeWriter::new();
    w.begin("impl Foo");
    w.begin("fn bar(&self) -> i32");
    w.line("return self.x;");
    w.end();
    w.end();
    let expected = "impl Foo {\n    fn bar(&self) -> i32 {\n        return self.x;\n    }\n}\n";
    assert w.to_string() == expected, `got: ${w.to_string()}`;
}

test "end_with suffix" {
    let mut w = CodeWriter::new();
    w.begin("variant Shape");
    w.begin("Circle");
    w.line("radius: f64,");
    w.end_with(",");
    w.end();
    let expected = "variant Shape {\n    Circle {\n        radius: f64,\n    },\n}\n";
    assert w.to_string() == expected, `got: ${w.to_string()}`;
}

test "write with embedded newlines" {
    let mut w = CodeWriter::new();
    w.begin("fn foo()");
    w.write("let x = 1;\nlet y = 2;\n");
    w.end();
    let expected = "fn foo() {\n    let x = 1;\n    let y = 2;\n}\n";
    assert w.to_string() == expected, `got: ${w.to_string()}`;
}

test "raw bypasses indentation" {
    let mut w = CodeWriter::new();
    w.raw("// raw header\n");
    w.begin("fn foo()");
    w.line("return 1;");
    w.end();
    let expected = "// raw header\nfn foo() {\n    return 1;\n}\n";
    assert w.to_string() == expected, `got: ${w.to_string()}`;
}

test "next_id generates unique ids" {
    let mut w = CodeWriter::new();
    let a = w.next_id();
    let b = w.next_id();
    let c = w.next_id();
    assert a == 0;
    assert b == 1;
    assert c == 2;
}

test "hoist_fn defines each distinct key once, where write_hoisted is" {
    let mut w = CodeWriter::new();
    let define = |name: &String| `fn ${*name}() {}\n`;
    let a = w.hoist_fn("x", "f", define);
    let b = w.hoist_fn("y", "f", define);
    let again = w.hoist_fn("x", "f", define);
    w.line("// body");
    w.write_hoisted();
    assert a == "f0" && b == "f1" && again == "f0";
    assert w.to_string() == "// body\nfn f0() {}\nfn f1() {}\n", `got: ${w.to_string()}`;
}

#[expect_trap]
test "to_string refuses a hoisted definition never written" {
    let mut w = CodeWriter::new();
    w.hoist_fn("x", "f", |name: &String| `fn ${*name}() {}\n`);
    w.to_string();
}

test "else_begin for if/else-if chain" {
    let mut w = CodeWriter::new();
    w.begin("if x > 0");
    w.line("positive();");
    w.else_begin("else if x < 0");
    w.line("negative();");
    w.else_begin("else");
    w.line("zero();");
    w.end();
    let expected = "if x > 0 {\n    positive();\n} else if x < 0 {\n    negative();\n} else {\n    zero();\n}\n";
    assert w.to_string() == expected, `got: ${w.to_string()}`;
}

test "manual indent/dedent" {
    let mut w = CodeWriter::new();
    w.line("outer");
    w.indent();
    w.line("inner");
    w.dedent();
    w.line("outer again");
    assert w.to_string() == "outer\n    inner\nouter again\n";
}

/// A private unit function `name(p: i32)` whose body `body` writes.
fn unit_fn(w: &mut CodeWriter, name: String, prunable: bool, body: fn(&mut CodeWriter)) {
    let mut f = FnSpec::new(name);
    f.add_param("p", "i32");
    if prunable {
        f.set_prunable();
    }
    f.emit_begin(w);
    body(w);
    w.end();
    w.blank();
}

fn call_of(callee: String, args: List<String>, form: CallForm = CallForm::Discard) -> CallStmt {
    return CallStmt { form, callee, args };
}

test "append indents what it splices to the current depth" {
    let mut inner = CodeWriter::new();
    inner.begin("if c");
    inner.call(call_of("f", ["p"]));
    inner.end();
    let mut w = CodeWriter::new();
    w.begin("fn g(p: i32)");
    w.append(&inner);
    w.ret();
    w.end();
    assert w.to_string() == "fn g(p: i32) {\n    if c {\n        f(p);\n    }\n    return;\n}\n", `got: ${w.to_string()}`;
}

test "prune drops a prunable function nothing kept calls, and what only it references" {
    let mut w = CodeWriter::new();
    unit_fn(&mut w, "kept", false, |b| {
        b.line("used(p);");
        b.note("used");
    });
    unit_fn(&mut w, "used", true, |b| b.ret());
    unit_fn(&mut w, "dead", true, |b| b.call(call_of("dead_callee", ["p"])));
    unit_fn(&mut w, "dead_callee", true, |b| b.ret());
    w.prune();
    assert w.to_string() == "fn kept(p: i32) {\n    used(p);\n}\n\nfn used(p: i32) {\n    return;\n}\n\n", `got: ${w.to_string(
    )}`;
}

test "prune inlines a one-statement body where its parameters are passed" {
    let mut w = CodeWriter::new();
    unit_fn(&mut w, "outer", false, |b| b.call(call_of("one", ["p"])));
    unit_fn(&mut w, "one", true, |b| {
        b.stmt("take(p);");
        b.note("TABLE");
        b.ret();
    });
    w.prune();
    assert w.to_string() == "fn outer(p: i32) {\n    take(p);\n}\n\n", `got: ${w.to_string()}`;
    assert w.references().contains("TABLE");
}

test "prune keeps a one-line body the generator did not write as a movable statement" {
    let mut w = CodeWriter::new();
    unit_fn(&mut w, "outer", false, |b| b.call(call_of("guard", ["p"])));
    unit_fn(&mut w, "guard", true, |b| {
        b.line("if p < 0 { return; }");
        b.ret();
    });
    w.prune();
    assert w.to_string().contains("    guard(p);\n"), `got: ${w.to_string()}`;
    assert w.to_string().contains("fn guard("), `got: ${w.to_string()}`;
}

test "prune prints the joined pre-statements of a forwarded call once" {
    let mut w = CodeWriter::new();
    unit_fn(&mut w, "outer", false, |b| {
        b.call(CallStmt {
            pre: ["a(p);"],
            callee: "helper",
            args: ["p"],
        });
    });
    unit_fn(&mut w, "helper", true, |b| {
        b.call(CallStmt {
            pre: ["b(p);"],
            callee: "target",
            args: ["p"],
        });
        b.ret();
    });
    unit_fn(&mut w, "target", false, |b| b.ret());
    w.prune();
    let expected = "fn outer(p: i32) {\n    a(p);\n    b(p);\n    target(p);\n}\n\nfn target(p: i32) {\n    return;\n}\n\n";
    assert w.to_string() == expected, `got: ${w.to_string()}`;
}

test "prune leaves only the names kept code references" {
    let mut w = CodeWriter::new();
    // `dead` reaches `target` through two forwarders whose notes do not
    // adjoin, so forwarding joins them into a new run of names.
    unit_fn(&mut w, "dead", true, |b| b.call(call_of("a", ["p"])));
    unit_fn(&mut w, "a", true, |b| {
        b.note("TABLE_A");
        b.call(call_of("b", ["p"]));
        b.ret();
    });
    unit_fn(&mut w, "kept", false, |b| b.note("TABLE_KEPT"));
    unit_fn(&mut w, "b", true, |b| {
        b.note("TABLE_B");
        b.call(call_of("target", ["p"]));
        b.ret();
    });
    unit_fn(&mut w, "target", false, |b| b.ret());
    w.prune();
    let refs = w.references();
    assert refs.contains("TABLE_KEPT");
    assert !refs.contains("TABLE_A") && !refs.contains("TABLE_B"), `got: ${refs:?}`;
}

test "prune can leave a writer empty" {
    let mut w = CodeWriter::new();
    unit_fn(&mut w, "dead", true, |b| b.ret());
    w.prune();
    assert w.to_string() == "", `got: ${w.to_string()}`;
}

test "prune forwards a call through a body that only calls, with its pre-statements" {
    let mut w = CodeWriter::new();
    unit_fn(&mut w, "outer", false, |b| b.call(call_of("helper", ["p"], CallForm::Return)));
    unit_fn(&mut w, "helper", true, |b| {
        b.call(CallStmt {
            pre: ["p.site = 3;"],
            callee: "target",
            args: ["p", "7"],
        });
        b.ret();
    });
    unit_fn(&mut w, "target", false, |b| b.ret());
    w.prune();
    let expected = "fn outer(p: i32) {\n    p.site = 3;\n    return target(p, 7);\n}\n\nfn target(p: i32) {\n    return;\n}\n\n";
    assert w.to_string() == expected, `got: ${w.to_string()}`;
}

test "prune renames a call to a function returning another's result on its own parameters" {
    let mut w = CodeWriter::new();
    unit_fn(&mut w, "outer", false, |b| b.call(call_of("alias", ["q"], CallForm::Bind("let r = "))));
    unit_fn(&mut w, "alias", true, |b| b.call(call_of("target", ["p"], CallForm::Return)));
    unit_fn(&mut w, "target", false, |b| b.ret());
    w.prune();
    let expected = "fn outer(p: i32) {\n    let r = target(q);\n}\n\nfn target(p: i32) {\n    return;\n}\n\n";
    assert w.to_string() == expected, `got: ${w.to_string()}`;
}

test "prune keeps a call whose arguments a forwarded body cannot take" {
    let mut w = CodeWriter::new();
    unit_fn(&mut w, "outer", false, |b| b.call(call_of("helper", ["q"])));
    unit_fn(&mut w, "helper", true, |b| {
        b.call(CallStmt {
            pre: ["p.site = 3;"],
            callee: "target",
            args: ["p"],
        });
        b.ret();
    });
    unit_fn(&mut w, "target", false, |b| b.ret());
    w.prune();
    assert w.to_string().contains("helper(q);");
    assert w.to_string().contains("fn helper(");
}

test "a call forwarded through a chain keeps what each forwarder notes" {
    let mut w = CodeWriter::new();
    unit_fn(&mut w, "outer", false, |b| b.call(call_of("a", ["p"])));
    unit_fn(&mut w, "a", true, |b| {
        b.note("TABLE_A");
        b.call(call_of("b", ["p"]));
        b.ret();
    });
    unit_fn(&mut w, "b", true, |b| {
        b.note("TABLE_B");
        b.call(call_of("target", ["p"]));
        b.ret();
    });
    unit_fn(&mut w, "target", false, |b| b.ret());
    w.prune();
    assert w.to_string() == "fn outer(p: i32) {\n    target(p);\n}\n\nfn target(p: i32) {\n    return;\n}\n\n", `got: ${w.to_string(
    )}`;
    let refs = w.references();
    assert refs.contains("TABLE_A") && refs.contains("TABLE_B");
}

test "same_code compares what two writers hold" {
    let build = |callee: String| {
        let mut w = CodeWriter::new();
        w.line("let x = 1;");
        w.call(call_of(callee, ["x"]));
        return w;
    };
    assert build("f").same_code(&build("f"));
    assert !build("f").same_code(&build("g"));
}


test "StructSpec basic" {
    let mut s = StructSpec::new("Point");
    s.add_field("x", "i32");
    s.add_field("y", "i32");

    let mut w = CodeWriter::new();
    s.emit(&mut w);
    let expected = "struct Point {\n    x: i32,\n    y: i32,\n}\n";
    assert w.to_string() == expected, `got: ${w.to_string()}`;
}

test "StructSpec pub with pub fields" {
    let mut s = StructSpec::new("Token", Vis::Pub);
    s.add_pub_field("kind", "i32");
    s.add_pub_field("text", "String");

    let mut w = CodeWriter::new();
    s.emit(&mut w);
    let expected = "pub struct Token {\n    pub kind: i32,\n    pub text: String,\n}\n";
    assert w.to_string() == expected, `got: ${w.to_string()}`;
}

test "StructSpec mixed visibility fields" {
    let mut s = StructSpec::new("Config", Vis::Pub);
    s.add_pub_field("name", "String");
    s.add_field("secret", "i32");

    let mut w = CodeWriter::new();
    s.emit(&mut w);
    let expected = "pub struct Config {\n    pub name: String,\n    secret: i32,\n}\n";
    assert w.to_string() == expected, `got: ${w.to_string()}`;
}

test "StructSpec with FieldSpec" {
    let mut s = StructSpec::new("Foo");
    s.add_field_spec(FieldSpec::new_pub("x", "f64"));

    let mut w = CodeWriter::new();
    s.emit(&mut w);
    assert w.to_string() == "struct Foo {\n    pub x: f64,\n}\n";
}


test "a field's attributes precede it, one a line" {
    let mut s = StructSpec::new("Foo");
    s.add_field_spec(FieldSpec {
        name: "x",
        type_str: "i32",
        is_pub: true,
        default: Option::Some("0"),
        attrs: ["wire(name = \"y\")", "secret"],
    });

    let mut w = CodeWriter::new();
    s.emit(&mut w);
    let expected = "struct Foo {\n    #[wire(name = \"y\")]\n    #[secret]\n    pub x: i32 = 0,\n}\n";
    assert w.to_string() == expected;
}

test "an enum member's attributes precede it" {
    let mut e = EnumSpec::new("Corpus");
    e.add_member_with_attrs("Web", ["wire(name = \"web\")"]);

    let mut w = CodeWriter::new();
    e.emit(&mut w);
    assert w.to_string() == "enum Corpus {\n    #[wire(name = \"web\")]\n    Web,\n}\n";
}

test "VariantSpec unit cases" {
    let mut v = VariantSpec::new("TokenKind", Vis::Pub);
    v.add_case("Number");
    v.add_case("String");
    v.add_case("Eof");

    let mut w = CodeWriter::new();
    v.emit(&mut w);
    let expected = "pub variant TokenKind {\n    Number,\n    String,\n    Eof,\n}\n";
    assert w.to_string() == expected, `got: ${w.to_string()}`;
}

test "VariantSpec with payloads" {
    let mut v = VariantSpec::new("Shape");
    v.add_case_with_payload("Circle", "f64");
    v.add_case_with_payload("Rect", "[f64, f64]");
    v.add_case("Point");

    let mut w = CodeWriter::new();
    v.emit(&mut w);
    let expected = "variant Shape {\n    Circle(f64),\n    Rect([f64, f64]),\n    Point,\n}\n";
    assert w.to_string() == expected, `got: ${w.to_string()}`;
}


test "EnumSpec basic" {
    let mut e = EnumSpec::new("Color", Vis::Pub);
    e.add_member("Red");
    e.add_member("Green");
    e.add_member("Blue");

    let mut w = CodeWriter::new();
    e.emit(&mut w);
    let expected = "pub enum Color {\n    Red,\n    Green,\n    Blue,\n}\n";
    assert w.to_string() == expected, `got: ${w.to_string()}`;
}


test "FnSpec simple" {
    let mut f = FnSpec::new("add");
    f.add_param("a", "i32");
    f.add_param("b", "i32");
    f.set_return_type("i32");

    let mut w = CodeWriter::new();
    f.emit_begin(&mut w);
    w.line("return a + b;");
    w.end();
    let expected = "fn add(a: i32, b: i32) -> i32 {\n    return a + b;\n}\n";
    assert w.to_string() == expected, `got: ${w.to_string()}`;
}

test "FnSpec with receiver" {
    let mut f = FnSpec::new("len", Vis::Pub);
    f.set_receiver("&self");
    f.set_return_type("i32");

    assert f.signature() == "pub fn len(&self) -> i32";
}

test "FnSpec with default-valued param" {
    let mut f = FnSpec::new("parse_expr");
    f.add_param("p", "&mut Parser");
    f.add_param_spec(ParamSpec {
        name: "min_prec",
        type_str: "i32",
        default_value: Option::<String>::Some("0"),
    });
    f.set_return_type("ExprNode");

    assert f.signature() == "fn parse_expr(p: &mut Parser, min_prec: i32 = 0) -> ExprNode";
}

test "FnSpec no return type" {
    let mut f = FnSpec::new("reset");
    f.set_receiver("&mut self");

    let mut w = CodeWriter::new();
    f.emit_begin(&mut w);
    w.line("self.x = 0;");
    w.end();
    let expected = "fn reset(&mut self) {\n    self.x = 0;\n}\n";
    assert w.to_string() == expected, `got: ${w.to_string()}`;
}

test "FnSpec signature string" {
    let mut f = FnSpec::new("transform", Vis::Pub);
    f.set_receiver("&self");
    f.add_param("input", "&String");
    f.add_param("scale", "f64");
    f.set_return_type("String");

    let sig = f.signature();
    assert sig == "pub fn transform(&self, input: &String, scale: f64) -> String", `got: ${sig}`;
}

test "FnSpec export with effects" {
    let mut f = FnSpec::new("run");
    f.set_export();
    f.add_effect("Stdout");
    f.add_effect("Stderr");
    f.add_effect("Environment");

    let sig = f.signature();
    assert sig == "export fn run() with (Stdout, Stderr, Environment)", `got: ${sig}`;
}

// A row of one goes bare; only a row of more than one takes parentheses.
test "FnSpec with a single effect" {
    let mut f = FnSpec::new("run");
    f.set_export();
    f.add_effect("Stdout");

    let sig = f.signature();
    assert sig == "export fn run() with Stdout", `got: ${sig}`;
}

test "FnSpec generic type parameter" {
    let mut f = FnSpec::new("walk_stmt", Vis::Pub);
    f.add_generic("V: Visitor");
    f.add_param("v", "&mut V");
    f.add_param("node", "&StmtNode");

    let sig = f.signature();
    assert sig == "pub fn walk_stmt<V: Visitor>(v: &mut V, node: &StmtNode)", `got: ${sig}`;
}

test "FnSpec multiple generics" {
    let mut f = FnSpec::new("zip");
    f.add_generic("A");
    f.add_generic("B");
    f.add_param("a", "A");
    f.add_param("b", "B");
    f.set_return_type("[A, B]");

    let sig = f.signature();
    assert sig == "fn zip<A, B>(a: A, b: B) -> [A, B]", `got: ${sig}`;
}


test "GlobalSpec basic" {
    let g = GlobalSpec::new("TK_EOF", "i32", "0");

    let mut w = CodeWriter::new();
    g.emit(&mut w);
    assert w.to_string() == "global TK_EOF: i32 = 0;\n";
}

test "GlobalSpec pub" {
    let mut g = GlobalSpec::new("COUNTER", "i32", "0", Vis::Pub);

    let mut w = CodeWriter::new();
    g.emit(&mut w);
    assert w.to_string() == "pub global COUNTER: i32 = 0;\n";
}

// Integration: composing specs with CodeWriter

test "struct + impl + fn composition" {
    let mut w = CodeWriter::new();

    // struct Lexer { chars: List<char>, pos: i32, }
    let mut s = StructSpec::new("Lexer");
    s.add_field("chars", "List<char>");
    s.add_field("pos", "i32");
    s.emit(&mut w);
    w.blank();

    // impl Lexer { fn new(...) -> Lexer { ... } }
    w.begin("impl Lexer");

    let mut f = FnSpec::new("new");
    f.add_param("input", "&String");
    f.set_return_type("Lexer");
    f.emit_begin(&mut w);
    w.line("return Lexer { chars: input.chars().collect(), pos: 0 };");
    w.end();
    w.blank();

    let mut f2 = FnSpec::new("at_end");
    f2.set_receiver("&self");
    f2.set_return_type("bool");
    f2.emit_begin(&mut w);
    w.line("return self.pos >= self.chars.len();");
    w.end();

    w.end();

    let run = "let input = \"ab\"; print(if Lexer::new(&input).at_end() { \"end\" } else { \"more\" });";
    assert printed(run, w.to_string()) == "more";
}

test "variant + global composition" {
    let mut w = CodeWriter::new();

    let mut v = VariantSpec::new("TokenKind", Vis::Pub);
    v.add_case("Number");
    v.add_case("Eof");
    v.add_case("Error");
    v.emit(&mut w);
    w.blank();

    GlobalSpec::new("TK_Number", "i32", "0").emit(&mut w);
    GlobalSpec::new("TK_EOF", "i32", "1").emit(&mut w);
    GlobalSpec::new("TK_ERROR", "i32", "2").emit(&mut w);

    let run = "let k: TokenKind = Eof; print(match k { Number => `${TK_Number}`, Eof => `${TK_EOF}`, Error => `${TK_ERROR}` });";
    assert printed(run, w.to_string()) == "1";
}

test "chaining builder methods" {
    let mut s = StructSpec::new("Pair", Vis::Pub);
    s.add_pub_field("first", "i32").add_pub_field("second", "i32");

    let mut w = CodeWriter::new();
    s.emit(&mut w);
    let expected = "pub struct Pair {\n    pub first: i32,\n    pub second: i32,\n}\n";
    assert w.to_string() == expected, `got: ${w.to_string()}`;
}


test "wado writes a code hole verbatim" {
    let name = "expr_list";
    let index = 3;
    assert wado`pos = ${name}(tokens, pos, ${index});` == "pos = expr_list(tokens, pos, 3);";
}

test "a hole in a string literal reads back as its value" {
    let values: List<String> = ["foo", "", "a\"\\b", "\n\t\r\u{1}\u{7f}", "あ", "${evil}"];
    let mut run = String::new();
    let mut expected = String::new();
    for let v of values {
        run.push_str(wado`print("${v}");`);
        expected.push_str(&v);
    }
    // Adjacent holes: the empty segment between them carries the context.
    let [a, b] = ["a\"", "b"];
    run.push_str(wado`print("${a}${b}");`);
    expected.push_str("a\"b");
    assert printed(run) == expected;
}

test "wado keeps printable non-ASCII verbatim" {
    // The key contract: Japanese text is NOT \u-escaped.
    let text = "あ";
    assert wado`"${text}"` == "\"あ\"";
}

test "a hole in a char literal reads back as its value" {
    let chars: List<char> = ['a', '\'', '"', '\\', '\n', '\u{1}', 'あ'];
    let mut run = "let mut s = String::new();";
    let mut expected = String::new();
    for let c of chars {
        run.push_str(wado`s.push('${c}');`);
        expected.push(c);
    }
    run.push_str("print(s);");
    assert printed(run) == expected;
}

test "wado keeps a printable non-ASCII char verbatim" {
    let c = 'あ';
    assert wado`'${c}'` == "'あ'";
}

test "a hole's value does not shift the context of the next hole" {
    // The first hole renders an unbalanced quote; the second is still code.
    let opener = "f(\"";
    let text = "x";
    assert wado`${opener}${text}");` == "f(\"x\");";
}

test "wado reads a quote in a line comment as text" {
    let comment = "don't";
    let text = "x\"y";
    let got = wado`// ${comment}
let s = "${text}";`;
    assert got == "// don't\nlet s = \"x\\\"y\";", `got: ${got}`;
}

test "wado reads a lone slash as division, not a comment" {
    let text = "x\"y";
    let got = wado`let n = a / b; let s = "${text}";`;
    assert got == "let n = a / b; let s = \"x\\\"y\";", `got: ${got}`;
}

test "wado reads an escaped quote as text inside a string literal" {
    // The template writes `\\"` because it emits `\"`; the scan sees the
    // backslash and the string stays open.
    let text = "x\"y";
    let got = wado`let s = "a\\"${text}";`;
    assert got == "let s = \"a\\\"x\\\"y\";", `got: ${got}`;
}

test "wado applies a format specifier" {
    let bits = 255;
    assert wado`let mask = 0x${bits:x};` == "let mask = 0xff;";
}

test "wado nests generated code" {
    let text = "a\"b";
    let inner = wado`f("${text}")`;
    assert wado`let x = ${inner};` == "let x = f(\"a\\\"b\");";
}

test "char_range_pat renders an inclusive range" {
    assert `${char_range_pat('a'..='z')}` == "'a'..='z'";
}

test "char_range_pat collapses a singleton to one literal" {
    assert `${char_range_pat('_'..='_')}` == "'_'";
}

test "char_range_pat matches its range and nothing past either end" {
    let tabs = char_range_pat('\t'..='\n');
    let under = char_range_pat('_'..='_');
    let run = wado`for let n of [8, 9, 10, 11, 94, 95, 96] as List<u32> {
    print(match char::from_u32_unchecked(n) { ${tabs} => "t", ${under} => "u", _ => "-" });
}`;
    assert printed(run) == "-tt--u-";
}

test "byte_string_literal keeps printable ASCII and escapes the rest" {
    assert byte_string_literal(b"a\"\\ \x00\xff\n~") == "b\"a\\x22\\x5c \\x00\\xff\\x0a~\"";
}

test "byte_string_literal reads back byte for byte" {
    let bytes = b"\x89PNG\r\n\x1a\n\"\\\x00\xff~";
    let mut run = "for let b of ";
    run.push_str(&byte_string_literal(&bytes));
    run.push_str(" { print(`${b} `); }");
    let mut expected = String::new();
    for let b of bytes {
        expected.push_str(`${b} `);
    }
    assert printed(run) == expected;
    assert byte_string_literal(b"") == "b\"\"";
}

test "ImplSpec basic" {
    let mut w = CodeWriter::new();
    let i = ImplSpec::new("Point");
    i.emit_begin(&mut w);
    let mut f = FnSpec::new("origin");
    f.set_return_type("Point");
    f.emit_begin(&mut w);
    w.line("return Point { x: 0, y: 0 };");
    w.end();
    w.end();
    let expected = "impl Point {\n    fn origin() -> Point {\n        return Point { x: 0, y: 0 };\n    }\n}\n";
    assert w.to_string() == expected, `got: ${w.to_string()}`;
}

test "ImplSpec trait impl" {
    let mut w = CodeWriter::new();
    let i = ImplSpec::new_trait("Eq", "Point");
    i.emit_begin(&mut w);
    let mut f = FnSpec::new("eq");
    f.set_receiver("&self");
    f.add_param("other", "&Self");
    f.set_return_type("bool");
    f.emit_begin(&mut w);
    w.line("return self.x == other.x && self.y == other.y;");
    w.end();
    w.end();
    let expected = "impl Eq for Point {\n    fn eq(&self, other: &Self) -> bool {\n        return self.x == other.x && self.y == other.y;\n    }\n}\n";
    assert w.to_string() == expected, `got: ${w.to_string()}`;
}

test "struct + impl trait composition" {
    let mut w = CodeWriter::new();

    // struct
    let mut s = StructSpec::new("Article", Vis::Pub);
    s.add_pub_field("name", "String");
    s.emit(&mut w);
    w.blank();

    // impl trait for struct
    let i = ImplSpec::new_trait("Summary", "Article");
    i.emit_begin(&mut w);
    let mut f = FnSpec::new("title");
    f.set_receiver("&self");
    f.set_return_type("String");
    f.emit_begin(&mut w);
    w.line("return self.name;");
    w.end();
    w.end();

    let items = `trait Summary with () {
    fn title(&self) -> String;
}
${w.to_string()}`;
    assert printed("print(Article { name: \"wado\" }.title());", items) == "wado";
}

test "wado runs a block comment to its close, not to the first quote inside" {
    // `/*` opens a state of its own: an unbalanced quote inside is comment
    // text, so the hole after the close is still in a string.
    let x = "a\"b";
    assert wado`/* he said "hi */ let s = "${x}";` == "/* he said \"hi */ let s = \"a\\\"b\";";
}

test "wado leaves a block comment only on the star that precedes the slash" {
    let x = "q\"r";
    assert wado`/** doc **/ let s = "${x}";` == "/** doc **/ let s = \"q\\\"r\";";
}

test "a hole in a template reads back as its value" {
    // The apostrophe must not open a char literal, and a `${` in a value must
    // not open an interpolation.
    let values: List<String> = ["a`b", "${evil}", "\\", "\"q\""];
    let mut run = String::new();
    let mut expected = String::new();
    for let v of values {
        run.push_str(wado`print(\`don't ${v}\`);`);
        expected.push_str("don't ");
        expected.push_str(&v);
    }
    assert printed(run) == expected;
}

test "wado carries the state past a hole that completes an escape" {
    // The `\n` is finished before the hole, so the hole sits in the string and
    // the one after the closing quote sits in code.
    let x = "q";
    let y = "\"str\"";
    assert wado`let s = "a\\n${x}"; let t = ${y};` == "let s = \"a\\nq\"; let t = \"str\";";
}

#[expect_trap]
test "wado refuses a hole whose backslash is still pending" {
    // The backslash would bind the hole's first byte, and which state that
    // lands in depends on the value, so the scan cannot answer for what follows.
    let x = "q";
    let _ = wado`let s = "a\\${x}";`;
}
