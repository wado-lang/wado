#!/usr/bin/env wado
//! Writes `src/vocabulary.wado` from the JSON `wado syntax --format json`
//! prints. Reads the JSON's path on argv, prints the module to stdout.

use { args, print, eprintln, exit, Stdout, Stderr, Environment, Exit } from "core:cli";
use fs from "core:fs";
use { Preopens } from "core:fs";
use { from_string } from "core:json";
use { TreeMap } from "core:collections";
use { CodeWriter, FnSpec, Vis, wado } from "../src/wadopoet.wado";

struct PreludeName {
    name: String,
}

struct Vocabulary {
    keywords: List<String>,
    contextual_keywords: List<String>,
    name_keywords: List<String>,
    prelude: List<PreludeName>,
}

export fn run() with (Stdout, Stderr, Environment, Preopens, Exit) {
    let arguments = args();
    if arguments.len() != 1 {
        eprintln("usage: gen_vocabulary <wado-syntax.json>");
        exit(1);
    }
    let json = match fs::read_to_string(&arguments[0]) {
        Ok(text) => text,
        Err(e) => {
            eprintln(`gen_vocabulary: ${e}`);
            exit(1);
        },
    };
    let vocabulary = match from_string::<Vocabulary>(&json) {
        Ok(v) => v,
        Err(e) => {
            eprintln(`gen_vocabulary: ${e}`);
            exit(1);
        },
    };
    print(render(&vocabulary));
}

fn render(vocabulary: &Vocabulary) -> String {
    let mut keywords: List<String> = [];
    for let words of [vocabulary.keywords, vocabulary.contextual_keywords] {
        for let word of words {
            if !vocabulary.name_keywords.contains_str(&word) {
                keywords.push(word);
            }
        }
    }
    let mut prelude: List<String> = [];
    for let p of &vocabulary.prelude {
        if is_identifier(&p.name) {
            prelude.push(p.name);
        }
    }

    let mut w = CodeWriter::new();
    w.line("// Generated by `mise run update-wadopoet-vocabulary` from `wado syntax --format json`.");
    w.line("// Do not edit by hand.");
    w.blank();
    w.line("/// Whether `name` cannot be written as a name anywhere, not even where a");
    w.line("/// type or enum qualifies it: a keyword the parser does not take as a name.");
    emit_membership(&mut w, "is_keyword", Vis::Pub, &keywords);
    w.blank();
    w.line("/// Whether a generated declaration named `name` would collide with the");
    w.line("/// language: a keyword, or a name `core:prelude` puts in every module's scope.");
    let mut reserved = FnSpec::new("is_reserved", Vis::Pub);
    reserved.add_generic("S: AsStrSlice").add_param("name", "S").set_return_type("bool");
    reserved.emit_begin(&mut w);
    w.line("return is_keyword(name) || is_prelude_name(name);");
    w.end();
    w.blank();
    emit_membership(&mut w, "is_prelude_name", Vis::Private, &prelude);
    return w.to_string();
}

/// A predicate over `words`, dispatched on length first so most names are
/// rejected without a string comparison.
fn emit_membership(w: &mut CodeWriter, name: String, vis: Vis, words: &List<String>) {
    let mut by_len = TreeMap::<i32, List<String>>::new();
    for let word of words {
        by_len.get_or_insert(word.len(), []);
        by_len[word.len()].push(*word);
    }
    let mut lens: List<i32> = [];
    for let [len, _] of by_len.entries() {
        lens.push(*len);
    }
    lens.sort();

    let mut f = FnSpec::new(name, vis);
    f.add_generic("S: AsStrSlice").add_param("name", "S").set_return_type("bool");
    f.emit_begin(w);
    w.line("let name = name.as_str_slice();");
    w.begin("return match name.len()");
    for let len of lens {
        let mut group = by_len[len];
        group.sort();
        let mut alternatives = "";
        for let word of group {
            if !alternatives.is_empty() {
                alternatives.push_str(" | ");
            }
            alternatives.push_str(&wado`"${word}"`);
        }
        w.begin(`${len} => match name`);
        w.line(`${alternatives} => true,`);
        w.line("_ => false,");
        w.end_with(",");
    }
    w.line("_ => false,");
    w.end_with(";");
    w.end();
}

fn is_identifier(name: &String) -> bool {
    let mut first = true;
    for let c of name.chars() {
        let ok = c == '_' || c.is_ascii_alphabetic() || !first && c.is_ascii_digit();
        if !ok {
            return false;
        }
        first = false;
    }
    return !first;
}
