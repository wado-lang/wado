//! Rill: fine-grained reactivity and the DOM bound to it. A page is built once,
//! and a write to a signal reruns only the bindings that read it.

pub use { Memo, Signal, Track, flush, memo, observe, on_cleanup, scope, signal, untracked } from "./signals.wado";
pub use { bind_attribute, bind_text, each, element, on, text } from "./view.wado";

use { Event, SurfaceDom } from "wado-lang:web";

#[synopsis]
test {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let count = signal(0);
        let button = element("button");
        let mut dispose = scope(|| {
            bind_text(button, || `clicked ${count.get()} times`);
            on(button, "click", |_event: Event| count.set(count.get() + 1));
        });
        assert button.text_content() == Option::Some("clicked 0 times");

        count.set(2);
        flush();
        assert button.text_content() == Option::Some("clicked 2 times");

        dispose();
    };
}
