use { Signal, flush, observe, on_cleanup, scope, signal } from "./signals.wado";
use { NodeRef, View, build, each, element, hydrate, hydrate_reporting, node_ref, show, switch } from "./view.wado";
use { Dom, Element, Event, Node, SurfaceDom, Text } from "wado-lang:web";

fn children_text(parent: Element) -> String with Dom {
    let mut out = "";
    let mut child = parent.first_child();
    while let Some(node) = child {
        out.push_str(node.text_content().unwrap());
        child = node.next_sibling();
    }
    return out;
}

fn item(value: i32) -> View {
    return element("li").children([`${value}`]);
}

fn new_element(tag: String) -> Element with Dom {
    return Dom::document().create_element(tag);
}

test "a view builds its element's attributes, text and children in call order" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let count = signal(1);
        let mut clicks = 0;
        let card = new_element("div");
        let _dispose = scope(|| {
            build(
                View::of(card)
                    .attr("class", "card")
                    .children([
                        element("h2").children(["Title"]),
                        element("p").children(["Count: ", || `${count.get()}`]),
                        element("button").children(["+"]).on("click", |_: Event| clicks += 1),
                    ])
                    .children([element("footer").attr("title", || `${count.get()}`)]),
            );
        });
        assert card.get_attribute("class") == Option::Some("card");
        assert card.get_html() == "<h2>Title</h2><p>Count: 1</p><button>+</button><footer title=\"1\"></footer>";

        count.set(2);
        flush();
        assert card.get_html() == "<h2>Title</h2><p>Count: 2</p><button>+</button><footer title=\"2\"></footer>";

        card.last_child().unwrap().previous_sibling().unwrap().dispatch_event(Event::new("click"));
        assert clicks == 1;
    };
}

test "a bound attribute is absent while its closure answers None" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let title: Signal<Option<String>> = signal(null);
        let mut built: Option<Element> = null;
        let _dispose = scope(|| {
            built = Option::Some(build(element("p").attr("title", || title.get())));
        });
        let p = built.unwrap();
        assert p.get_attribute("title") == null;

        title.set(Option::Some("a"));
        flush();
        assert p.get_attribute("title") == Option::Some("a");

        title.set(null);
        flush();
        assert p.get_attribute("title") == null;
    };
}

test "a view builds nothing until it is built" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let root = new_element("main");
        let view = View::of(root).children([element("h1").children(["Todos"])]);
        assert root.get_html() == "";

        let _dispose = scope(|| {
            build(view);
        });
        assert root.get_html() == "<h1>Todos</h1>";
    };
}

test "a node ref hands over the element the view built" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let made = node_ref();
        let mut built: Option<Element> = null;
        let _dispose = scope(|| {
            built = Option::Some(build(element("p").node_ref(made)));
        });
        assert made.get() == built.unwrap();
    };
}

#[expect_trap]
test "a node ref is not read before its view is built" {
    node_ref().get();
}

test "show puts its subtree where it stands among the children while the condition holds" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = new_element("ul");
        let empty = signal(true);
        let _dispose = scope(|| {
            build(View::of(list).children([item(1), show(|| empty.get(), || element("li").children(["none"])), item(2)]));
        });
        assert list.get_html() == "<li>1</li><li>none</li><li>2</li>";

        empty.set(false);
        flush();
        assert list.get_html() == "<li>1</li><li>2</li>";

        empty.set(true);
        flush();
        assert list.get_html() == "<li>1</li><li>none</li><li>2</li>";
    };
}

test "show keeps its subtree while the condition stays true" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let box = new_element("div");
        let count = signal(1);
        let mut renders = 0;
        let _dispose = scope(|| {
            build(View::of(box).children([show(|| count.get() > 0, || {
                renders += 1;
                return element("p");
            })]));
        });
        let shown = box.first_child().unwrap();

        count.set(2);
        flush();
        assert renders == 1;
        assert box.first_child().unwrap() == shown;
    };
}

test "show disposes of its subtree when it hides it" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let box = new_element("div");
        let visible = signal(true);
        let label = signal("a");
        let mut cleanups = 0;
        let _dispose = scope(|| {
            build(View::of(box).children([show(|| visible.get(), || {
                on_cleanup(|| cleanups += 1);
                return element("p").attr("title", || label.get());
            })]));
        });
        let shown: Element = box.first_child().unwrap() else {
            unreachable();
        };

        visible.set(false);
        flush();
        assert cleanups == 1;
        label.set("b");
        flush();
        assert shown.get_attribute("title") == Option::Some("a");
    };
}

test "show takes its subtree out when its owner is disposed of" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let box = new_element("div");
        let mut dispose = scope(|| {
            build(View::of(box).children(["x", show(|| true, || element("p"))]));
        });
        assert box.get_html() == "x<p></p>";

        dispose();
        assert box.get_html() == "x";
        assert box.first_child() == box.last_child();
    };
}

test "show survives a cleanup in its subtree disposing of its owner" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let box = new_element("div");
        let visible = signal(true);
        let mut dispose_owner: fn mut() with Dom = || {
        };
        dispose_owner = scope(|| {
            build(View::of(box).children([show(|| visible.get(), || {
                on_cleanup(|| dispose_owner());
                return element("p");
            })]));
        });

        visible.set(false);
        flush();
        assert box.get_html() == "";
        assert !box.has_child_nodes();
    };
}

test "show disposes of what render made after render disposed of its owner" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let box = new_element("div");
        let visible = signal(false);
        let label = signal("a");
        let mut dispose_owner: fn mut() with Dom = || {
        };
        let made = node_ref();
        dispose_owner = scope(|| {
            build(View::of(box).children([show(|| visible.get(), || {
                dispose_owner();
                return element("p").attr("title", || label.get()).node_ref(made);
            })]));
        });

        visible.set(true);
        flush();
        label.set("b");
        flush();
        assert made.get().get_attribute("title") == Option::Some("a");
        assert !box.has_child_nodes();
    };
}

test "each renders no further once render disposed of its owner, and disposes of what it made" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = new_element("ul");
        let items: Signal<List<i32>> = signal([]);
        let label = signal("a");
        let mut dispose_owner: fn mut() with Dom = || {
        };
        let mut made: List<NodeRef> = [];
        dispose_owner = scope(|| {
            build(View::of(list).children([each(|| items.get(), |value: i32| {
                dispose_owner();
                let row = node_ref();
                made.push(row);
                return item(value).attr("title", || label.get()).node_ref(row);
            })]));
        });

        items.set([1, 2]);
        flush();
        label.set("b");
        flush();
        assert made.len() == 1;
        for let row of made {
            assert row.get().get_attribute("title") == Option::Some("a");
        }
        assert !list.has_child_nodes();
    };
}

test "each keeps no rows once a removed row's cleanup disposed of its owner" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = new_element("ul");
        let items: Signal<List<i32>> = signal([1]);
        let label = signal("a");
        let mut dispose_owner: fn mut() with Dom = || {
        };
        let mut made: List<NodeRef> = [];
        let mut cleanups = 0;
        dispose_owner = scope(|| {
            build(View::of(list).children([each(|| items.get(), |value: i32| {
                if value == 1 {
                    on_cleanup(|| {
                        cleanups += 1;
                        dispose_owner();
                    });
                }
                let row = node_ref();
                made.push(row);
                return item(value).attr("title", || label.get()).node_ref(row);
            })]));
        });

        items.set([2]);
        flush();
        label.set("b");
        flush();
        assert cleanups == 1;
        assert made[1].get().get_attribute("title") == Option::Some("a");
        assert !list.has_child_nodes();
    };
}

test "switch shows the subtree render makes for the key, and swaps it when the key changes" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let box = new_element("div");
        let mode = signal("view");
        let mut cleanups: List<String> = [];
        let mut renders = 0;
        let mut dispose = scope(|| {
            build(
                View::of(box).children(
                    [
                        "[",
                        switch(|| mode.get(), |key| {
                            renders += 1;
                            on_cleanup(|| cleanups.push(key));
                            return element(if key == "edit" { "input" } else { "span" });
                        }),
                        "]",
                    ],
                ),
            );
        });
        assert box.get_html() == "[<span></span>]";

        mode.set("view");
        flush();
        assert renders == 1;

        mode.set("edit");
        flush();
        assert box.get_html() == "[<input>]";
        assert cleanups == ["view"];

        mode.set("view");
        flush();
        assert renders == 3;
        assert box.get_html() == "[<span></span>]";

        dispose();
        assert cleanups == ["view", "edit", "view"];
        assert box.get_html() == "[]";
    };
}

test "show asks when once to show what was hidden" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let box = new_element("div");
        let requests = signal(0);
        let mut pending = 0;
        let mut asked = 0;
        let _dispose = scope(|| {
            build(View::of(box).children([show(|| {
                asked += 1;
                requests.get();
                let answer = pending > 0;
                pending = 0;
                return answer;
            }, || element("p"))]));
        });

        pending = 1;
        requests.set(1);
        flush();
        assert asked == 2;
        assert box.has_child_nodes();
    };
}

test "switch renders nothing once its key disposed of the owner" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let box = new_element("div");
        let mode = signal(1);
        let mut dispose_owner: fn mut() with Dom = || {
        };
        let mut renders = 0;
        dispose_owner = scope(|| {
            build(View::of(box).children([switch(|| {
                let key = mode.get();
                if key == 2 {
                    with &mut dom do {
                        dispose_owner();
                    };
                }
                return key;
            }, |_| {
                renders += 1;
                return element("p");
            })]));
        });

        mode.set(2);
        flush();
        assert renders == 1;
        assert !box.has_child_nodes();
    };
}

test "switch renders the key a cleanup of the last subtree wrote" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let box = new_element("div");
        let mode = signal(1);
        let mut rendered: List<i32> = [];
        let _dispose = scope(|| {
            build(View::of(box).children([switch(|| mode.get(), |key| {
                rendered.push(key);
                if key == 1 {
                    on_cleanup(|| mode.set(3));
                }
                return element("p");
            })]));
        });

        mode.set(2);
        flush();
        assert rendered == [1, 3];
    };
}

test "switch renders no next subtree once the last one's cleanup disposed of its owner" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let box = new_element("div");
        let mode = signal(1);
        let mut dispose_owner: fn mut() with Dom = || {
        };
        let mut renders = 0;
        dispose_owner = scope(|| {
            build(View::of(box).children([switch(|| mode.get(), |key| {
                renders += 1;
                if key == 1 {
                    on_cleanup(|| dispose_owner());
                }
                return element("p");
            })]));
        });

        mode.set(2);
        flush();
        assert renders == 1;
        assert !box.has_child_nodes();
    };
}

test "each follows a new order with the nodes it had" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = new_element("ul");
        let items: Signal<List<i32>> = signal([1, 2, 3]);
        let _dispose = scope(|| {
            build(View::of(list).children([each(|| items.get(), item)]));
        });
        let rows = elements_in(list);

        items.set([3, 1, 2]);
        flush();
        assert children_text(list) == "312";
        assert elements_in(list) == [rows[2], rows[0], rows[1]];
    };
}

test "each keeps its rows among the element's other children" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = new_element("ul");
        let items: Signal<List<i32>> = signal([1, 2]);
        let _dispose = scope(|| {
            build(View::of(list).children([item(0), each(|| items.get(), item), item(9)]));
        });
        assert list.get_html() == "<li>0</li><li>1</li><li>2</li><li>9</li>";

        items.set([2, 3, 1]);
        flush();
        assert list.get_html() == "<li>0</li><li>2</li><li>3</li><li>1</li><li>9</li>";

        items.set([]);
        flush();
        assert list.get_html() == "<li>0</li><li>9</li>";
    };
}

test "a bound text owns one text node, and leaves the element's other children" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let label = new_element("p");
        let count = signal(0);
        let _dispose = scope(|| {
            build(View::of(label).children([element("b").children(["Count: "]), || `${count.get()}`]));
        });
        let shown = label.last_child().unwrap();
        assert label.get_html() == "<b>Count: </b>0";

        count.set(1);
        flush();
        assert label.get_html() == "<b>Count: </b>1";
        assert label.last_child().unwrap() == shown;
    };
}

test "a bound text takes its text node out when it is disposed of" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let label = new_element("p");
        let shown = signal(true);
        let text = signal("x");
        let _dispose = scope(|| observe(|| {
            if shown.get() {
                build(View::of(label).children([|| text.get()]));
            }
        }));
        assert label.get_html() == "x";

        shown.set(true);
        flush();
        assert label.get_html() == "x";
        shown.set(false);
        flush();
        assert label.get_html() == "";
    };
}

// Counts the insertions that reach the DOM beneath it.
struct Insertions {
    count: i32,
}

impl Node for Insertions {
    fn append_child(&mut self, this: &Node, node: Node) -> Node with Node {
        self.count += 1;
        resume (*this).append_child(node);
    }

    fn insert_before(&mut self, this: &Node, node: Node, child: Option<Node>) -> Node with Node {
        self.count += 1;
        resume (*this).insert_before(node, child);
    }

    ..forward
}

test "each moves only the rows out of place" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = new_element("ul");
        let items: Signal<List<i32>> = signal([1, 2, 3, 4, 5]);
        let _dispose = scope(|| {
            build(View::of(list).children([each(|| items.get(), item)]));
        });

        let mut insertions = Insertions { count: 0 };
        with Node => &mut insertions do {
            items.set([2, 3, 4, 5, 1]);
            flush();
        };
        assert children_text(list) == "23451";
        assert insertions.count == 1;

        with Node => &mut insertions do {
            items.set([1, 2, 3, 4, 5]);
            flush();
        };
        assert children_text(list) == "12345";
        assert insertions.count == 2;
    };
}

test "each takes back a row moved out of its parent" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = new_element("ul");
        let items: Signal<List<i32>> = signal([1, 2]);
        let _dispose = scope(|| {
            build(View::of(list).children([each(|| items.get(), item)]));
        });
        new_element("ol").append_child(elements_in(list)[1]);

        items.set([0, 1, 2]);
        flush();
        assert children_text(list) == "012";
    };
}

test "each restores its order after render moved a row" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = new_element("ul");
        let items: Signal<List<i32>> = signal([1, 2]);
        let _dispose = scope(|| {
            build(View::of(list).children([each(|| items.get(), |value: i32| {
                if value == 0 {
                    list.append_child(list.first_child().unwrap());
                }
                return item(value);
            })]));
        });

        items.set([0, 1, 2]);
        flush();
        assert children_text(list) == "012";
    };
}

test "each restores its order after render moved a row while it was built" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = new_element("ul");
        let items: Signal<List<i32>> = signal([1, 2, 3]);
        let _dispose = scope(|| {
            build(View::of(list).children([each(|| items.get(), |value: i32| {
                if value == 3 {
                    list.append_child(list.first_child().unwrap());
                }
                return item(value);
            })]));
        });
        assert children_text(list) == "123";
    };
}

test "show leaves nothing behind once its first run disposed of its owner" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let box = new_element("div");
        let go = signal(false);
        let mut dispose_owner: fn mut() with Dom = || {
        };
        dispose_owner = scope(|| observe(|| {
            if go.get() {
                build(View::of(box).children([show(|| {
                    with &mut dom do {
                        dispose_owner();
                    };
                    return true;
                }, || element("p"))]));
            }
        }));

        go.set(true);
        flush();
        assert !box.has_child_nodes();
    };
}

test "each claims no further once render disposed of its owner while hydrating" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = new_element("ul");
        let _built = scope(|| {
            build(View::of(list).children([each(|| [1, 2] as List<i32>, item)]));
        });
        let go = signal(false);
        let mut dispose_owner: fn mut() with Dom = || {
        };
        dispose_owner = scope(|| observe(|| {
            if go.get() {
                hydrate(View::of(list).children([each(|| [1, 2] as List<i32>, |value: i32| {
                    dispose_owner();
                    return item(value);
                })]));
            }
        }));

        go.set(true);
        flush();
        assert elements_in(list).is_empty();
    };
}

test "each restores its order after a row moved within its parent" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = new_element("ul");
        let items: Signal<List<i32>> = signal([1, 2]);
        let _dispose = scope(|| {
            build(View::of(list).children([each(|| items.get(), item)]));
        });
        list.append_child(list.first_child().unwrap());

        items.set([0, 1, 2]);
        flush();
        assert children_text(list) == "012";
    };
}

test "each disposes of the row of an item that left" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = new_element("ul");
        let items: Signal<List<i32>> = signal([1, 2, 3]);
        let mut left: List<i32> = [];
        let _dispose = scope(|| {
            build(View::of(list).children([each(|| items.get(), |value: i32| {
                on_cleanup(|| left.push(value));
                return item(value);
            })]));
        });

        items.set([1, 3]);
        flush();
        assert children_text(list) == "13";
        assert left == [2];
    };
}

test "each gives equal items a row each" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = new_element("ul");
        let items: Signal<List<i32>> = signal([1, 1]);
        let _dispose = scope(|| {
            build(View::of(list).children([each(|| items.get(), item)]));
        });
        assert children_text(list) == "11";

        items.set([1, 1, 1]);
        flush();
        assert children_text(list) == "111";
    };
}

// Leaves the tree as the HTML parser would: adjacent text joined into one
// node, and empty text gone.
fn serve(parent: Element) with Dom {
    let mut child = parent.first_child();
    while let Some(current) = child {
        if let nested: Element = current {
            serve(nested);
            child = current.next_sibling();
            continue;
        }
        let mut joined = "";
        while let Some(node) = child && let text: Text = node {
            joined.push_str(text.data());
            child = node.next_sibling();
            parent.remove_child(node);
        }
        if !joined.is_empty() {
            parent.insert_before(Dom::document().create_text_node(joined), child);
        }
    }
}

fn elements_in(parent: Element) -> List<Element> with Dom {
    let mut found: List<Element> = [];
    let mut child = parent.first_child();
    while let Some(node) = child {
        if let nested: Element = node {
            found.push(nested);
            for let inner of elements_in(nested) {
                found.push(inner);
            }
        }
        child = node.next_sibling();
    }
    return found;
}

struct Page {
    count: Signal<i32>,
    items: Signal<List<i32>>,
    clicks: Signal<i32>,
}

fn new_page() -> Page {
    return Page {
        count: signal(1),
        items: signal([1, 2]),
        clicks: signal(0),
    };
}

fn page_view(root: Element, page: Page) -> View {
    return View::of(root).children(
        [
            element("h1").attr("class", "title").children(["Count: ", || `${page.count.get()}`, "!"]),
            element("ul").children([each(|| page.items.get(), item)]),
            element("button")
                .children([|| `${page.clicks.get()}`])
                .on("click", |_: Event| page.clicks.set(page.clicks.get() + 1)),
            show(|| page.count.get() > 0, || element("em").children(["positive"])),
            element("footer"),
        ],
    );
}

// Builds the page, serves it, and hydrates what was served with signals of its
// own, so a write reaches only the hydrated bindings.
fn hydrated(root: Element) -> Page with Dom {
    let _built = scope(|| {
        build(page_view(root, new_page()));
    });
    serve(root);
    let page = new_page();
    let _hydrated = scope(|| {
        hydrate(page_view(root, page));
    });
    return page;
}

test "hydrate claims every element the served page holds, and makes none" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let root = new_element("main");
        let _built = scope(|| {
            build(page_view(root, new_page()));
        });
        serve(root);
        let served = root.get_html();
        let elements = elements_in(root);

        let _hydrated = scope(|| {
            hydrate(page_view(root, new_page()));
        });
        assert root.get_html() == served;
        assert elements_in(root) == elements;
    };
}

test "a hydrated page follows its signals" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let root = new_element("main");
        let page = hydrated(root);

        page.count.set(5);
        flush();
        assert root.get_html() == "<h1 class=\"title\">Count: 5!</h1><ul><li>1</li><li>2</li></ul><button>0</button><em>positive</em><footer></footer>";

        root.first_child().unwrap().next_sibling().unwrap().next_sibling().unwrap().dispatch_event(Event::new("click"));
        assert page.clicks.get() == 1;
        assert children_text(root).contains("1positive");
    };
}

test "a hydrated each keeps the rows it claimed" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let root = new_element("main");
        let page = hydrated(root);
        let list: Element = root.first_child().unwrap().next_sibling().unwrap() else {
            unreachable();
        };
        let rows = elements_in(list);

        page.items.set([1, 2, 3]);
        flush();
        assert children_text(list) == "123";
        assert list.first_child().unwrap() == rows[0] as Node;
        assert list.first_child().unwrap().next_sibling().unwrap() == rows[1] as Node;
    };
}

test "a hydrated each moves none of the rows it claimed" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = new_element("ul");
        for let value of [1, 2] as List<i32> {
            let row = new_element("li");
            row.append_child(Dom::document().create_text_node(`${value}`));
            list.append_child(row);
            list.append_child(Dom::document().create_text_node("\n"));
        }

        let mut insertions = Insertions { count: 0 };
        with Node => &mut insertions do {
            let _hydrated = scope(|| {
                hydrate(View::of(list).children([each(|| [1, 2] as List<i32>, item)]));
            });
        };
        assert list.get_html() == "<li>1</li><li>2</li>";
        // The rows' text, made anew, and the node that ends the rows.
        assert insertions.count == 3;
    };
}

test "hydrate checks the attribute value the view leaves, not one it overwrites" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let root = new_element("main");
        let bound = signal("b");
        let view = || View::of(root).children(
            [
                element("p")
                    .attr("class", "base")
                    .attr("class", "final")
                    .attr("title", "a")
                    .attr("title", || bound.get())
                    .attr("lang", || `${bound.get()}ound`)
                    .attr("lang", "static"),
            ],
        );
        let _built = scope(|| {
            build(view());
        });
        let built = root.get_html();
        let _hydrated = scope(|| {
            hydrate(view());
        });
        assert root.get_html() == built;
        assert built == "<p class=\"final\" title=\"b\" lang=\"static\"></p>";
    };
}

#[expect_trap]
test "hydrate traps on a served attribute the view does not leave" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let root = new_element("main");
        let served = new_element("p");
        served.set_attribute("class", "other");
        root.append_child(served);
        let _hydrated = scope(|| {
            hydrate(View::of(root).children([element("p").attr("class", "final")]));
        });
    };
}

#[expect_trap]
test "an attribute name holds no uppercase letter, which an HTML element would lower" {
    element("p").attr("CLASS", "card");
}

test "a hydrated each restores its order after render moved a claimed row" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = new_element("ul");
        let _built = scope(|| {
            build(View::of(list).children([each(|| [1, 2, 3] as List<i32>, item)]));
        });
        serve(list);
        let rows = elements_in(list);
        let _hydrated = scope(|| {
            hydrate(View::of(list).children([each(|| [1, 2, 3] as List<i32>, |value: i32| {
                if value == 3 {
                    list.append_child(list.first_child().unwrap());
                }
                return item(value);
            })]));
        });
        assert children_text(list) == "123";
        assert elements_in(list) == rows;
    };
}

test "a hydrated show hides and shows again where it stands" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let root = new_element("main");
        let page = hydrated(root);

        page.count.set(0);
        flush();
        assert !root.get_html().contains("<em>");

        page.count.set(1);
        flush();
        assert root.get_html().contains("<em>positive</em><footer></footer>");
    };
}

#[expect_trap]
test "hydrate traps on a served element of another tag" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let root = new_element("main");
        root.append_child(new_element("p"));
        let _hydrated = scope(|| {
            hydrate(View::of(root).children([element("div")]));
        });
    };
}

#[expect_trap]
test "hydrate traps on a served element its view does not build" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let root = new_element("main");
        root.append_child(new_element("p"));
        let _hydrated = scope(|| {
            hydrate(View::of(root).children(["x"]));
        });
    };
}

#[expect_trap]
test "hydrate traps on a served page missing an element its view builds" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let root = new_element("main");
        let _hydrated = scope(|| {
            hydrate(View::of(root).children([element("p")]));
        });
    };
}

// Hydrates `view` as a build that checks no contracts does, and answers how
// many mismatches it met.
fn rebuilt(view: View) -> i32 with Dom {
    let mut mismatches = 0;
    let _hydrated = scope(|| {
        hydrate_reporting(view, |_: String| mismatches += 1);
    });
    return mismatches;
}

test "a served element of another tag is built anew, its bindings live" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let root = new_element("main");
        let kept = new_element("p");
        root.append_child(kept);
        let served = new_element("p");
        served.append_child(new_element("i"));
        root.append_child(served);
        let shown = signal("a");
        assert rebuilt(View::of(root).children([element("p"), element("div").children([|| shown.get()])])) == 1;
        assert root.get_html() == "<p></p><div>a</div>";
        assert root.first_child().unwrap() == kept as Node;

        shown.set("b");
        flush();
        assert root.get_html() == "<p></p><div>b</div>";
    };
}

test "an adopted element that does not fit is put in place and claims what it holds" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let root = new_element("main");
        root.append_child(new_element("p"));
        let adopted = new_element("section");
        let held = new_element("span");
        held.append_child(Dom::document().create_text_node("a"));
        adopted.append_child(held);
        assert rebuilt(View::of(root).children([View::of(adopted).children([element("span").children(["a"])])])) == 1;
        assert root.get_html() == "<section><span>a</span></section>";
        assert adopted.first_child().unwrap() == held as Node;
    };
}

test "an adopted element served later is moved up, and not taken out as extra" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let root = new_element("main");
        root.append_child(new_element("p"));
        let adopted = new_element("section");
        adopted.append_child(new_element("span"));
        root.append_child(adopted);
        assert rebuilt(View::of(root).children([View::of(adopted).children([element("span")])])) == 1;
        assert root.get_html() == "<section><span></span></section>";
    };
}

test "an adopted element inside one built anew still claims what it holds" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let root = new_element("main");
        root.append_child(new_element("p"));
        let adopted = new_element("section");
        let held = new_element("button");
        adopted.append_child(held);
        let view = View::of(root).children([element("div").children([View::of(adopted).children([element("button")])])]);
        assert rebuilt(view) == 1;
        assert root.get_html() == "<div><section><button></button></section></div>";
        assert adopted.first_child().unwrap() == held as Node;
    };
}

test "an element missing from the served page is built where it belongs" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let root = new_element("main");
        let kept = new_element("p");
        root.append_child(kept);
        let view = View::of(root).children([element("p"), element("span").children(["x"]), element("b")]);
        assert rebuilt(view) == 2;
        assert root.get_html() == "<p></p><span>x</span><b></b>";
        assert root.first_child().unwrap() == kept as Node;
    };
}

test "a served element its view does not build is taken out" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let root = new_element("main");
        root.append_child(new_element("p"));
        root.append_child(new_element("i"));
        assert rebuilt(View::of(root).children([element("p")])) == 1;
        assert root.get_html() == "<p></p>";
    };
}

test "a served attribute the view does not leave takes the view's value" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let root = new_element("main");
        let served = new_element("p");
        served.set_attribute("class", "other");
        root.append_child(served);
        assert rebuilt(View::of(root).children([element("p").attr("class", "final")])) == 1;
        assert root.get_html() == "<p class=\"final\"></p>";
    };
}

test "a page served as built meets no mismatch" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let root = new_element("main");
        let _built = scope(|| {
            build(page_view(root, new_page()));
        });
        serve(root);
        assert rebuilt(page_view(root, new_page())) == 0;
    };
}
