use { Signal, flush, observe, on_cleanup, scope, signal } from "./signals.wado";
use { View, element } from "./view.wado";
use { Dom, Element, Event, Node, SurfaceDom } from "wado-lang:web";

fn children_text(parent: Element) -> String with Dom {
    let mut out = "";
    let mut child = parent.first_child();
    while let Some(node) = child {
        out.push_str(node.text_content().unwrap());
        child = node.next_sibling();
    }
    return out;
}

fn item(value: i32) -> View with Dom {
    return element("li").text(`${value}`);
}

test "a view builds its element's attributes, text and children in call order" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let count = signal(1);
        let mut clicks = 0;
        let card = element("div").attribute("class", "card");
        let _dispose = scope(|| {
            card
                .children([
                    element("h2").text("Title"),
                    element("p").text("Count: ").bind_text(|| `${count.get()}`),
                    element("button").text("+").on("click", |_: Event| clicks += 1),
                ])
                .child(element("footer").bind_attribute("title", || Option::Some(`${count.get()}`)));
        });
        assert card.node.get_attribute("class") == Option::Some("card");
        assert card.node.get_html() == "<h2>Title</h2><p>Count: 1</p><button>+</button><footer title=\"1\"></footer>";

        count.set(2);
        flush();
        assert card.node.get_html() == "<h2>Title</h2><p>Count: 2</p><button>+</button><footer title=\"2\"></footer>";

        card.node.last_child().unwrap().previous_sibling().unwrap().dispatch_event(Event::new("click"));
        assert clicks == 1;
    };
}

test "a view of an element made elsewhere builds on that element" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let root = Dom::document().create_element("main");
        View::of(root).child(element("h1").text("Todos"));
        assert root.get_html() == "<h1>Todos</h1>";
    };
}

test "show puts its subtree where it stands in the chain while the condition holds" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = element("ul");
        let empty = signal(true);
        let _dispose = scope(|| {
            list.child(item(1)).show(|| empty.get(), || element("li").text("none")).child(item(2));
        });
        assert list.node.get_html() == "<li>1</li><li>none</li><li>2</li>";

        empty.set(false);
        flush();
        assert list.node.get_html() == "<li>1</li><li>2</li>";

        empty.set(true);
        flush();
        assert list.node.get_html() == "<li>1</li><li>none</li><li>2</li>";
    };
}

test "show keeps its subtree while the condition stays true" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let box = element("div");
        let count = signal(1);
        let mut renders = 0;
        let _dispose = scope(|| {
            box.show(|| count.get() > 0, || {
                renders += 1;
                return element("p");
            });
        });
        let shown = box.node.first_child().unwrap();

        count.set(2);
        flush();
        assert renders == 1;
        assert box.node.first_child().unwrap() == shown;
    };
}

test "show disposes of its subtree when it hides it" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let box = element("div");
        let visible = signal(true);
        let label = signal("a");
        let mut cleanups = 0;
        let _dispose = scope(|| {
            box.show(|| visible.get(), || {
                on_cleanup(|| cleanups += 1);
                return element("p").bind_attribute("title", || Option::Some(label.get()));
            });
        });
        let shown: Element = box.node.first_child().unwrap() else {
            unreachable();
        };

        visible.set(false);
        flush();
        assert cleanups == 1;
        label.set("b");
        flush();
        assert shown.get_attribute("title") == Option::Some("a");
    };
}

test "show takes its subtree out when its owner is disposed of" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let box = element("div").text("x");
        let mut dispose = scope(|| {
            box.show(|| true, || element("p"));
        });
        assert box.node.get_html() == "x<p></p>";

        dispose();
        assert box.node.get_html() == "x";
        assert box.node.first_child() == box.node.last_child();
    };
}

test "show survives a cleanup in its subtree disposing of its owner" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let box = element("div");
        let visible = signal(true);
        let mut dispose_owner: fn mut() with Dom = || {
        };
        dispose_owner = scope(|| {
            box.show(|| visible.get(), || {
                on_cleanup(|| dispose_owner());
                return element("p");
            });
        });

        visible.set(false);
        flush();
        assert box.node.get_html() == "";
        assert !box.node.has_child_nodes();
    };
}

test "show disposes of what render made after render disposed of its owner" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let box = element("div");
        let visible = signal(false);
        let label = signal("a");
        let mut dispose_owner: fn mut() with Dom = || {
        };
        let mut made: Option<Element> = null;
        dispose_owner = scope(|| {
            box.show(|| visible.get(), || {
                dispose_owner();
                let p = element("p").bind_attribute("title", || Option::Some(label.get()));
                made = Option::Some(p.node);
                return p;
            });
        });

        visible.set(true);
        flush();
        label.set("b");
        flush();
        assert made.unwrap().get_attribute("title") == Option::Some("a");
        assert !box.node.has_child_nodes();
    };
}

test "each renders no further once render disposed of its owner, and disposes of what it made" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = element("ul");
        let items: Signal<List<i32>> = signal([]);
        let label = signal("a");
        let mut dispose_owner: fn mut() with Dom = || {
        };
        let mut made: List<Element> = [];
        dispose_owner = scope(|| {
            list.each(|| items.get(), |value: i32| {
                dispose_owner();
                let row = item(value).bind_attribute("title", || Option::Some(label.get()));
                made.push(row.node);
                return row;
            });
        });

        items.set([1, 2]);
        flush();
        label.set("b");
        flush();
        assert made.len() == 1;
        for let row of made {
            assert row.get_attribute("title") == Option::Some("a");
        }
        assert !list.node.has_child_nodes();
    };
}

test "each keeps no rows once a removed row's cleanup disposed of its owner" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = element("ul");
        let items: Signal<List<i32>> = signal([1]);
        let label = signal("a");
        let mut dispose_owner: fn mut() with Dom = || {
        };
        let mut made: List<Element> = [];
        let mut cleanups = 0;
        dispose_owner = scope(|| {
            list.each(|| items.get(), |value: i32| {
                if value == 1 {
                    on_cleanup(|| {
                        cleanups += 1;
                        dispose_owner();
                    });
                }
                let row = item(value).bind_attribute("title", || Option::Some(label.get()));
                made.push(row.node);
                return row;
            });
        });

        items.set([2]);
        flush();
        label.set("b");
        flush();
        assert cleanups == 1;
        assert made[1].get_attribute("title") == Option::Some("a");
        assert !list.node.has_child_nodes();
    };
}

test "switch shows the subtree render makes for the key, and swaps it when the key changes" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let box = element("div").text("[");
        let mode = signal("view");
        let mut cleanups: List<String> = [];
        let mut renders = 0;
        let mut dispose = scope(|| {
            box
                .switch(|| mode.get(), |key| {
                    renders += 1;
                    on_cleanup(|| cleanups.push(key));
                    return element(if key == "edit" { "input" } else { "span" });
                })
                .text("]");
        });
        assert box.node.get_html() == "[<span></span>]";

        mode.set("view");
        flush();
        assert renders == 1;

        mode.set("edit");
        flush();
        assert box.node.get_html() == "[<input>]";
        assert cleanups == ["view"];

        mode.set("view");
        flush();
        assert renders == 3;
        assert box.node.get_html() == "[<span></span>]";

        dispose();
        assert cleanups == ["view", "edit", "view"];
        assert box.node.get_html() == "[]";
    };
}

test "show asks when once to show what was hidden" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let box = element("div");
        let requests = signal(0);
        let mut pending = 0;
        let mut asked = 0;
        let _dispose = scope(|| {
            box.show(|| {
                asked += 1;
                requests.get();
                let answer = pending > 0;
                pending = 0;
                return answer;
            }, || element("p"));
        });

        pending = 1;
        requests.set(1);
        flush();
        assert asked == 2;
        assert box.node.has_child_nodes();
    };
}

test "switch renders nothing once its key disposed of the owner" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let box = element("div");
        let mode = signal(1);
        let mut dispose_owner: fn mut() with Dom = || {
        };
        let mut renders = 0;
        dispose_owner = scope(|| {
            box.switch(|| {
                let key = mode.get();
                if key == 2 {
                    with &mut dom do {
                        dispose_owner();
                    };
                }
                return key;
            }, |_| {
                renders += 1;
                return element("p");
            });
        });

        mode.set(2);
        flush();
        assert renders == 1;
        assert !box.node.has_child_nodes();
    };
}

test "switch renders the key a cleanup of the last subtree wrote" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let box = element("div");
        let mode = signal(1);
        let mut rendered: List<i32> = [];
        let _dispose = scope(|| {
            box.switch(|| mode.get(), |key| {
                rendered.push(key);
                if key == 1 {
                    on_cleanup(|| mode.set(3));
                }
                return element("p");
            });
        });

        mode.set(2);
        flush();
        assert rendered == [1, 3];
    };
}

test "switch renders no next subtree once the last one's cleanup disposed of its owner" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let box = element("div");
        let mode = signal(1);
        let mut dispose_owner: fn mut() with Dom = || {
        };
        let mut renders = 0;
        dispose_owner = scope(|| {
            box.switch(|| mode.get(), |key| {
                renders += 1;
                if key == 1 {
                    on_cleanup(|| dispose_owner());
                }
                return element("p");
            });
        });

        mode.set(2);
        flush();
        assert renders == 1;
        assert !box.node.has_child_nodes();
    };
}

test "each follows a new order with the nodes it had" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = element("ul");
        let items: Signal<List<i32>> = signal([1, 2, 3]);
        let _dispose = scope(|| {
            list.each(|| items.get(), item);
        });
        let first = list.node.first_child().unwrap();
        let last = list.node.last_child().unwrap();

        items.set([3, 1, 2]);
        flush();
        assert children_text(list.node) == "312";
        assert list.node.first_child().unwrap() == last;
        assert list.node.first_child().unwrap().next_sibling().unwrap() == first;
    };
}

test "bind_text owns one text node, and leaves the element's other children" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let label = element("p").child(element("b").text("Count: "));
        let count = signal(0);
        let _dispose = scope(|| {
            label.bind_text(|| `${count.get()}`);
        });
        let shown = label.node.last_child().unwrap();
        assert label.node.get_html() == "<b>Count: </b>0";

        count.set(1);
        flush();
        assert label.node.get_html() == "<b>Count: </b>1";
        assert label.node.last_child().unwrap() == shown;
    };
}

test "bind_text takes its text node out when it is disposed of" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let label = element("p");
        let shown = signal(true);
        let _dispose = scope(|| observe(|| {
            if shown.get() {
                label.bind_text(|| "x");
            }
        }));
        assert label.node.get_html() == "x";

        shown.set(true);
        flush();
        assert label.node.get_html() == "x";
        shown.set(false);
        flush();
        assert label.node.get_html() == "";
    };
}

// Counts the insertions that reach the DOM beneath it.
struct Insertions {
    count: i32,
}

impl Node for Insertions {
    fn append_child(&mut self, this: &Node, node: Node) -> Node with Node {
        self.count += 1;
        resume (*this).append_child(node);
    }

    fn insert_before(&mut self, this: &Node, node: Node, child: Option<Node>) -> Node with Node {
        self.count += 1;
        resume (*this).insert_before(node, child);
    }

    ..forward
}

test "each moves only the rows out of place" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = element("ul");
        let items: Signal<List<i32>> = signal([1, 2, 3, 4, 5]);
        let _dispose = scope(|| {
            list.each(|| items.get(), item);
        });

        let mut insertions = Insertions { count: 0 };
        with Node => &mut insertions do {
            items.set([2, 3, 4, 5, 1]);
            flush();
        };
        assert children_text(list.node) == "23451";
        assert insertions.count == 1;

        with Node => &mut insertions do {
            items.set([1, 2, 3, 4, 5]);
            flush();
        };
        assert children_text(list.node) == "12345";
        assert insertions.count == 2;
    };
}

test "each takes back a row moved out of its parent" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = element("ul");
        let items: Signal<List<i32>> = signal([1, 2]);
        let _dispose = scope(|| {
            list.each(|| items.get(), item);
        });
        element("ol").node.append_child(list.node.last_child().unwrap());

        items.set([0, 1, 2]);
        flush();
        assert children_text(list.node) == "012";
    };
}

test "each restores its order after render moved a row" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = element("ul");
        let items: Signal<List<i32>> = signal([1, 2]);
        let _dispose = scope(|| {
            list.each(|| items.get(), |value: i32| {
                if value == 0 {
                    list.node.append_child(list.node.first_child().unwrap());
                }
                return item(value);
            });
        });

        items.set([0, 1, 2]);
        flush();
        assert children_text(list.node) == "012";
    };
}

test "each restores its order after a row moved within its parent" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = element("ul");
        let items: Signal<List<i32>> = signal([1, 2]);
        let _dispose = scope(|| {
            list.each(|| items.get(), item);
        });
        list.node.append_child(list.node.first_child().unwrap());

        items.set([0, 1, 2]);
        flush();
        assert children_text(list.node) == "012";
    };
}

test "each disposes of the row of an item that left" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = element("ul");
        let items: Signal<List<i32>> = signal([1, 2, 3]);
        let mut left: List<i32> = [];
        let _dispose = scope(|| {
            list.each(|| items.get(), |value: i32| {
                on_cleanup(|| left.push(value));
                return item(value);
            });
        });

        items.set([1, 3]);
        flush();
        assert children_text(list.node) == "13";
        assert left == [2];
    };
}

test "each gives equal items a row each" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let list = element("ul");
        let items: Signal<List<i32>> = signal([1, 1]);
        let _dispose = scope(|| {
            list.each(|| items.get(), item);
        });
        assert children_text(list.node) == "11";

        items.set([1, 1, 1]);
        flush();
        assert children_text(list.node) == "111";
    };
}
