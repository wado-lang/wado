//! Fine-grained reactivity as a library: signals, memos and effects, with the
//! dependencies found as the code runs.
//!
//! A write only marks what depends on it. `flush` then reruns each marked
//! effect once, so an effect never sees half of a batch of writes.

use { Dom } from "wado-lang:web";

/// What a computation reports while it runs. Outside one, both do nothing: a
/// read is untracked, and what would have been owned lives on.
pub interface Track {
    fn read(dep: Dep) {
    }

    fn own(dispose: fn mut() with Dom) {
    }
}

/// Who reads a signal or a memo, and how many times the signal was written or
/// the memo's value came out different.
struct Readers {
    observers: List<Observer>,
    version: i32,
    // The memo whose value this is; `None` for a signal.
    memo: Option<Shared<MemoCore>>,
}

pub struct Dep {
    readers: Shared<Readers>,
}

/// A dependency as a computation read it.
struct Seen {
    dep: Dep,
    version: i32,
}

variant Observer {
    Memo(Shared<MemoCore>),
    Effect(Shared<EffectCore>),
}

enum Freshness {
    Fresh,
    // A dependency may have changed.
    Check,
    // Never computed, or no longer listening.
    Stale,
}

/// The part of a memo that does not depend on its value's type.
struct MemoCore {
    id: i32,
    freshness: Freshness,
    dep: Dep,
    deps: List<Seen>,
    recompute: fn mut(),
}

struct EffectCore {
    id: i32,
    disposed: bool,
    running: bool,
    body: fn mut() with (Track, Dom),
    deps: List<Seen>,
    owned: List<fn mut() with Dom>,
}

global mut NEXT_OBSERVER_ID: i32 = 0;
global mut QUEUE: List<Shared<EffectCore>> = [];
global mut COMPUTING_MEMOS: i32 = 0;

fn next_observer_id() -> i32 {
    NEXT_OBSERVER_ID += 1;
    return NEXT_OBSERVER_ID;
}

fn new_dep() -> Dep {
    return Dep { readers: Shared::new(Readers { observers: [], version: 0, memo: null }) };
}

/// Whether every dependency still holds what was read, bringing each memo
/// among them up to date first.
fn unchanged(deps: &List<Seen>) -> bool {
    for let seen of deps {
        if let Some(core) = seen.dep.readers.memo {
            refresh(core);
        }
        if seen.dep.readers.version != seen.version {
            return false;
        }
    }
    return true;
}

fn refresh(core: Shared<MemoCore>) {
    match core.freshness {
        _::Fresh => {
        },
        _::Check => {
            if unchanged(&core.deps) {
                core.freshness = Freshness::Fresh;
            } else {
                (core.recompute)();
            }
        },
        _::Stale => (core.recompute)(),
    }
}

fn id_of(observer: &Observer) -> i32 {
    return match observer {
        Memo(core) => core.id,
        Effect(watcher) => watcher.id,
    };
}

/// Whether the observer was not subscribed yet.
fn subscribe(dep: Dep, observer: Observer) -> bool {
    let id = id_of(&observer);
    for let subscribed of dep.readers.observers {
        if id_of(&subscribed) == id {
            return false;
        }
    }
    dep.readers.observers.push(observer);
    return true;
}

fn unsubscribe_all(deps: List<Seen>, id: i32) {
    for let seen of deps {
        let readers = seen.dep.readers;
        let mut rest: List<Observer> = [];
        for let subscribed of readers.observers {
            if id_of(&subscribed) != id {
                rest.push(subscribed);
            }
        }
        readers.observers = rest;
    }
}

/// Marks what reads `dep`. A memo's readers learn only that it may have
/// changed: whether it did is known once someone asks for it.
fn notify(dep: Dep) {
    for let observer of dep.readers.observers {
        match observer {
            Memo(core) => {
                if core.freshness matches { _::Fresh } {
                    core.freshness = Freshness::Check;
                    notify(core.dep);
                }
            },
            Effect(watcher) => {
                if !watcher.disposed {
                    QUEUE.push(watcher);
                }
            },
        }
    }
}

struct Computation {
    // `None` leaves the reads untracked.
    observer: Option<Observer>,
    deps: List<Seen>,
    owns: bool,
    owned: List<fn mut() with Dom>,
}

impl Track for Computation {
    // Subscribing here and not once the run ends, so a write the run itself
    // makes to what it already read marks it.
    fn read(&mut self, dep: Dep) {
        if let Some(observer) = self.observer && subscribe(dep, observer) {
            self.deps.push(Seen { dep, version: dep.readers.version });
        }
        resume ();
    }

    fn own(&mut self, dispose: fn mut() with Dom) {
        assert self.owns, "a memo owns nothing: it has no end to dispose of it at";
        self.owned.push(dispose);
        resume ();
    }
}

/// Empties `owned` before disposing of any of it, so a disposer that reaches
/// the same list finds nothing left to dispose of.
fn dispose_all(owned: &mut List<fn mut() with Dom>) with Dom {
    let detached = *owned;
    *owned = [];
    for let mut dispose of detached {
        dispose();
    }
}

struct Cell<T> {
    value: T,
    dep: Dep,
}

/// A value that tells its readers when it is written. A copy is the same
/// signal.
pub struct Signal<T> {
    cell: Shared<Cell<T>>,
}

pub fn signal<T>(initial: T) -> Signal<T> {
    return Signal { cell: Shared::new(Cell { value: initial, dep: new_dep() }) };
}

impl<T> Signal<T> {
    pub fn get(&self) -> T with Track {
        Track::read(self.cell.dep);
        return self.cell.value;
    }

    pub fn set(&self, value: T) {
        assert COMPUTING_MEMOS == 0, "a memo computes a value and writes nothing";
        self.cell.value = value;
        self.cell.dep.readers.version += 1;
        notify(self.cell.dep);
    }
}

/// Two signals are equal when they are the same signal, whatever they hold.
impl<T> Eq for Signal<T> {
    fn eq(&self, other: &Self) -> bool {
        return self.cell == other.cell;
    }
}

struct MemoState<T> {
    core: Shared<MemoCore>,
    cached: Option<T>,
    compute: fn mut() -> T with Track,
}

/// A value computed from others, again only when one of them changed and
/// someone asks. A value `==` to the last one changes nothing for its readers,
/// so a type whose `Eq` compares only a key hides a change outside the key.
/// It stops listening when the computation that made it is disposed of, and
/// listens again if it is read after that. `compute` writes no signal.
pub struct Memo<T> {
    state: Shared<MemoState<T>>,
}

pub fn memo<T: Eq>(compute: fn mut() -> T with Track) -> Memo<T> with Track {
    let core = Shared::new(MemoCore {
        id: next_observer_id(),
        freshness: Freshness::Stale,
        dep: new_dep(),
        deps: [],
        recompute: || {
        },
    });
    core.dep.readers.memo = Option::Some(core);
    let state = Shared::new(MemoState { core, cached: null, compute });
    core.recompute = || recompute(state);
    // Its readers still read it, and no write reaches them through it now.
    Track::own(|| {
        core.freshness = Freshness::Stale;
        unsubscribe_all(core.deps, core.id);
        core.deps = [];
        notify(core.dep);
    });
    return Memo { state };
}

fn recompute<T: Eq>(state: Shared<MemoState<T>>) {
    let core = state.core;
    unsubscribe_all(core.deps, core.id);
    let mut computation = Computation {
        observer: Option::Some(Observer::Memo(core)),
        deps: [],
        owns: false,
        owned: [],
    };
    let mut compute = state.compute;
    core.freshness = Freshness::Fresh;
    // `==` runs the value's own `Eq`, so it is part of the computation.
    COMPUTING_MEMOS += 1;
    let value = with Track => &mut computation do {
        compute();
    };
    let same = state.cached matches { Some(was) && was == value };
    COMPUTING_MEMOS -= 1;
    core.deps = computation.deps;
    if same {
        return;
    }
    state.cached = Option::Some(value);
    core.dep.readers.version += 1;
}

/// Two memos are equal when they are the same memo.
impl<T> Eq for Memo<T> {
    fn eq(&self, other: &Self) -> bool {
        return self.state == other.state;
    }
}

impl<T> Memo<T> {
    pub fn get(&self) -> T with Track {
        let core = self.state.core;
        refresh(core);
        Track::read(core.dep);
        return self.state.cached.unwrap();
    }
}

/// Lets go of what the effect owns and of what it listens to.
fn release(watcher: Shared<EffectCore>) with Dom {
    unsubscribe_all(watcher.deps, watcher.id);
    watcher.deps = [];
    dispose_all(&mut watcher.owned);
}

fn run(watcher: Shared<EffectCore>) with Dom {
    release(watcher);
    // A disposer that ran during the release may have disposed of the effect.
    if watcher.disposed {
        return;
    }
    let mut computation = Computation {
        observer: Option::Some(Observer::Effect(watcher)),
        deps: [],
        owns: true,
        owned: [],
    };
    watcher.running = true;
    with Track => &mut computation do {
        (watcher.body)();
    };
    watcher.running = false;
    watcher.deps = computation.deps;
    watcher.owned = computation.owned;
    // The body may have disposed of the effect it runs in.
    if watcher.disposed {
        release(watcher);
    }
}

/// Runs `body` now, and again after a flush whenever something it read was
/// written. What `body` owns is disposed before each rerun, and with the
/// effect itself.
pub fn observe(body: fn mut() with (Track, Dom)) with (Track, Dom) {
    let watcher = Shared::new(EffectCore {
        id: next_observer_id(),
        disposed: false,
        running: false,
        body,
        deps: [],
        owned: [],
    });
    run(watcher);
    Track::own(|| {
        watcher.disposed = true;
        release(watcher);
    });
}

/// Registers `cleanup` with the computation running now.
pub fn on_cleanup(cleanup: fn mut() with Dom) with Track {
    Track::own(cleanup);
}

/// Runs `body` owning what it creates, and returns what disposes of it all.
/// Reads inside are untracked.
pub fn scope(body: fn mut() with (Track, Dom)) -> fn mut() with Dom with Dom {
    let mut body = body;
    let mut computation = Computation { observer: null, deps: [], owns: true, owned: [] };
    with Track => &mut computation do {
        body();
    };
    let mut owned = computation.owned;
    return || dispose_all(&mut owned);
}

/// Runs `body` with its reads untracked and what it creates never disposed
/// of, as an event listener runs.
pub fn untracked(body: fn mut() with (Track, Dom)) with Dom {
    let _never_disposed = scope(body);
}

/// Reruns every effect a write marked, each once, until none is marked. An
/// effect whose body is the one flushing stays queued, and reruns once that
/// run has kept what it read and made.
pub fn flush() with Dom {
    assert COMPUTING_MEMOS == 0, "a memo computes a value and flushes nothing";
    let mut running: List<Shared<EffectCore>> = [];
    while !QUEUE.is_empty() {
        let batch = QUEUE;
        QUEUE = [];
        let mut ran: List<i32> = [];
        for let marked of batch {
            if marked.running {
                running.push(marked);
                continue;
            }
            if ran.contains(&marked.id) {
                continue;
            }
            ran.push(marked.id);
            // Marked through a memo that came out the same.
            if unchanged(&marked.deps) {
                continue;
            }
            run(marked);
        }
    }
    QUEUE = running;
}
