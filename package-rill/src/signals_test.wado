use { Memo, Signal, flush, memo, observe, on_cleanup, scope, signal } from "./signals.wado";
use { Dom, SurfaceDom } from "wado-lang:web";

test "an effect reruns once for a batch of writes" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let a = signal(1);
        let b = signal(10);
        let mut seen: List<i32> = [];
        observe(|| seen.push(a.get() + b.get()));
        assert seen == [11];

        a.set(2);
        b.set(20);
        assert seen == [11];
        flush();
        assert seen == [11, 22];
    };
}

test "a copy of a signal is the same signal" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let count = signal(0);
        let copy = count;
        copy.set(5);
        assert count.get() == 5;
    };
}

test "a diamond is computed once and never seen half updated" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let count = signal(1);
        let mut computed = 0;
        let doubled = memo(|| {
            computed += 1;
            return count.get() * 2;
        });
        let tripled = memo(|| count.get() * 3);
        let sum = memo(|| doubled.get() + tripled.get());
        let mut seen: List<i32> = [];
        observe(|| seen.push(sum.get()));
        assert seen == [5];
        assert computed == 1;

        count.set(10);
        assert computed == 1;
        flush();
        assert seen == [5, 50];
        assert computed == 2;
    };
}

test "a dependency no longer read does not rerun the effect" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let use_first = signal(true);
        let first = signal(1);
        let second = signal(2);
        let mut seen: List<i32> = [];
        observe(|| seen.push(if use_first.get() { first.get() } else { second.get() }));

        use_first.set(false);
        flush();
        assert seen == [1, 2];

        first.set(100);
        flush();
        assert seen == [1, 2];
    };
}

test "a dependency a memo no longer reads does not recompute it" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let use_first = signal(true);
        let first = signal(1);
        let second = signal(2);
        let picked = memo(|| if use_first.get() { first.get() } else { second.get() });
        let mut seen: List<i32> = [];
        observe(|| seen.push(picked.get()));

        use_first.set(false);
        flush();
        first.set(100);
        flush();
        assert seen == [1, 2];
    };
}

test "a write an effect makes to what it read reruns it" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let count = signal(1);
        let doubled = memo(|| count.get() * 2);
        let mut seen: List<i32> = [];
        observe(|| {
            seen.push(doubled.get());
            if count.get() == 1 {
                count.set(2);
            }
        });
        flush();
        assert seen == [2, 4];
    };
}

test "disposing of a scope stops its effects and runs their cleanups" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let count = signal(0);
        let mut seen: List<i32> = [];
        let mut cleaned = 0;
        let mut dispose = scope(|| {
            observe(|| {
                seen.push(count.get());
                on_cleanup(|| cleaned += 1);
            });
        });

        count.set(1);
        flush();
        assert seen == [0, 1];
        assert cleaned == 1;

        dispose();
        assert cleaned == 2;
        count.set(2);
        flush();
        assert seen == [0, 1];
    };
}

test "an effect made by an effect is disposed when its maker reruns" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let outer = signal(0);
        let inner = signal(0);
        let mut inner_runs = 0;
        observe(|| {
            outer.get();
            observe(|| {
                inner.get();
                inner_runs += 1;
            });
        });
        assert inner_runs == 1;

        outer.set(1);
        flush();
        assert inner_runs == 2;

        inner.set(1);
        flush();
        assert inner_runs == 3;
    };
}

test "an effect disposed while it runs keeps nothing it made" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let count = signal(0);
        let mut inner_runs = 0;
        let mut dispose: fn mut() with Dom = || {
        };
        dispose = scope(|| {
            observe(|| {
                if count.get() == 1 {
                    dispose();
                }
                observe(|| {
                    count.get();
                    inner_runs += 1;
                });
            });
        });
        count.set(1);
        flush();
        let after = inner_runs;

        count.set(2);
        flush();
        assert inner_runs == after;
    };
}

test "a cleanup that disposes of its own scope runs once" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let count = signal(0);
        let mut runs = 0;
        let mut cleaned = 0;
        let mut dispose: fn mut() with Dom = || {
        };
        dispose = scope(|| {
            observe(|| {
                count.get();
                runs += 1;
                on_cleanup(|| {
                    cleaned += 1;
                    dispose();
                });
            });
        });
        count.set(1);
        flush();
        assert cleaned == 1;
        assert runs == 1;
    };
}

test "an effect that flushes inside its own run keeps every cleanup" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let count = signal(0);
        let mut cleaned = 0;
        let mut dispose = scope(|| {
            observe(|| {
                if count.get() == 1 {
                    count.set(2);
                    flush();
                }
                on_cleanup(|| cleaned += 1);
            });
        });
        count.set(1);
        flush();
        dispose();
        assert cleaned == 3;
    };
}

test "a memo that comes out the same reruns none of its dependents" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let count = signal(1);
        let parity = memo(|| count.get() % 2);
        let mut labelled = 0;
        let label = memo(|| {
            labelled += 1;
            return if parity.get() == 0 { "even" } else { "odd" };
        });
        let mut seen: List<String> = [];
        observe(|| seen.push(label.get()));

        count.set(3);
        flush();
        assert seen == ["odd"];
        assert labelled == 1;

        count.set(4);
        flush();
        assert seen == ["odd", "even"];
        assert labelled == 2;
    };
}

test "an effect that read a memo and a signal reruns for the signal alone" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let count = signal(1);
        let name = signal("a");
        let parity = memo(|| count.get() % 2);
        let mut seen: List<String> = [];
        observe(|| seen.push(`${name.get()}${parity.get()}`));

        count.set(3);
        name.set("b");
        flush();
        assert seen == ["a1", "b1"];
    };
}

test "an effect reading a disposed memo reruns once a read restarts it with a new value" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let count = signal(1);
        let mut doubled: Option<Memo<i32>> = null;
        let mut dispose = scope(|| doubled = Option::Some(memo(|| count.get() * 2)));
        let doubled = doubled.unwrap();
        let mut seen: List<i32> = [];
        observe(|| seen.push(doubled.get()));
        dispose();

        count.set(2);
        assert doubled.get() == 4;
        flush();
        assert seen == [2, 4];
    };
}

struct Item {
    done: Signal<bool>,
}

test "a memo over values holding signals compares them as the same signals" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let first = Item { done: signal(false) };
        let items: Signal<List<Item>> = signal([first]);
        let open = memo(|| {
            let mut left: List<Item> = [];
            for let item of items.get() {
                if !item.done.get() {
                    left.push(item);
                }
            }
            return left;
        });
        let mut runs = 0;
        observe(|| {
            runs += 1;
            open.get();
        });

        items.set([first]);
        flush();
        assert runs == 1;

        first.done.set(true);
        flush();
        assert runs == 2;
    };
}

test "an effect marked through an unchanged memo is skipped when it flushed inside its last run" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let count = signal(1);
        let parity = memo(|| count.get() % 2);
        let mut write_next = false;
        let mut seen: List<i32> = [];
        observe(|| {
            seen.push(parity.get());
            if write_next {
                write_next = false;
                count.set(4);
                flush();
            }
        });

        write_next = true;
        count.set(2);
        flush();
        assert seen == [1, 0];

        count.set(5);
        flush();
        assert seen == [1, 0, 1];
    };
}

test "a memo reading one a read restarts mid-run comes out from both new values" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let count = signal(1);
        let mut doubled: Option<Memo<i32>> = null;
        let mut dispose = scope(|| doubled = Option::Some(memo(|| count.get() * 2)));
        let doubled = doubled.unwrap();
        let forwarded = memo(|| doubled.get());
        let tick = signal(0);
        let pair = memo(|| {
            tick.get();
            return [
                forwarded.get(),
                doubled.get(),
            ];
        });
        assert pair.get() == [2, 2];
        dispose();

        count.set(2);
        tick.set(1);
        pair.get();
        assert pair.get() == [4, 4];
    };
}

struct Loud {
    value: i32,
    on_compare: Signal<i32>,
}

impl Eq for Loud {
    fn eq(&self, other: &Self) -> bool {
        self.on_compare.set(1);
        return self.value == other.value;
    }
}

#[expect_trap]
test "a memo whose values write when compared traps" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let count = signal(1);
        let other = signal(0);
        let loud = memo(|| Loud { value: count.get(), on_compare: other });
        loud.get();
        count.set(2);
        loud.get();
    };
}

#[expect_trap]
test "a memo that flushes traps" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let count = signal(1);
        let flushed = memo(|| {
            let mut inner = SurfaceDom::new();
            with &mut inner do {
                flush();
            };
            return count.get();
        });
        flushed.get();
    };
}

#[expect_trap]
test "a memo that writes a signal traps" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let count = signal(1);
        let other = signal(0);
        let doubled = memo(|| {
            other.set(1);
            return count.get() * 2;
        });
        doubled.get();
    };
}

test "a disposed memo listens again when it is read" {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let count = signal(1);
        let mut doubled: Option<Memo<i32>> = null;
        let mut dispose = scope(|| doubled = Option::Some(memo(|| count.get() * 2)));
        let doubled = doubled.unwrap();
        assert doubled.get() == 2;
        dispose();

        count.set(2);
        assert doubled.get() == 4;
        let mut seen: List<i32> = [];
        observe(|| seen.push(doubled.get()));
        count.set(3);
        flush();
        assert seen == [4, 6];
    };
}
