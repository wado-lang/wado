//! Signals bound to the DOM: each binding is an effect that writes one place,
//! so a write to a signal touches the nodes that show it and no others.

use { Track, flush, observe, on_cleanup, scope, untracked } from "./signals.wado";
use { Dom, Element, Event, EventTarget, Node } from "wado-lang:web";

/// An element under construction. Each method changes the element at once and
/// returns the view, so a page is written as one expression that nests as the
/// DOM does. A method that binds a signal must run inside a computation, which
/// owns the binding.
pub struct View {
    pub node: Element,
}

pub fn element(tag: String) -> View with Dom {
    return View::of(Dom::document().create_element(tag));
}

impl View {
    /// Builds on an element made elsewhere, such as the one a page mounts in.
    pub fn of(node: Element) -> View {
        return View { node };
    }

    pub fn attribute(&self, name: String, value: String) -> View with Dom {
        self.node.set_attribute(name, value);
        return *self;
    }

    /// Keeps the attribute at what `value` answers, absent for `None`.
    pub fn bind_attribute(&self, name: String, value: fn mut() -> Option<String> with Track) -> View with (Track, Dom) {
        let target = self.node;
        let mut value = value;
        observe(|| {
            match value() {
                Some(set) => target.set_attribute(name, set),
                None => target.remove_attribute(name),
            }
        });
        return *self;
    }

    /// Appends a text node holding `content`.
    pub fn text(&self, content: String) -> View with Dom {
        self.node.append_child(Dom::document().create_text_node(content));
        return *self;
    }

    /// Appends a text node and keeps its text at what `content` answers,
    /// taking it out when the binding is disposed of.
    pub fn bind_text(&self, content: fn mut() -> String with Track) -> View with (Track, Dom) {
        let mut content = content;
        let shown = Dom::document().create_text_node("");
        self.node.append_child(shown);
        on_cleanup(|| detach(shown));
        observe(|| shown.set_data(content()));
        return *self;
    }

    /// Shows what `render` makes at this point among the element's children
    /// while `when` answers true. It renders anew each time it shows, and
    /// disposes of what it hides.
    pub fn show(
        &self,
        when: fn mut() -> bool with Track,
        render: fn mut() -> View with (Track, Dom),
    ) -> View with (Track, Dom) {
        let mut render = render;
        return self.place(when, |visible| visible, |_| render());
    }

    /// Shows what `render` makes for the key `key` answers, at this point
    /// among the element's children. It keeps that subtree while the key stays
    /// equal, and disposes of it for the next one when the key changes.
    pub fn switch<K: Eq>(
        &self,
        key: fn mut() -> K with Track,
        render: fn mut(K) -> View with (Track, Dom),
    ) -> View with (Track, Dom) {
        return self.place(key, |_| true, render);
    }

    /// Shows what `render` makes for the key, for a key `shows` admits, at this
    /// point among the element's children.
    fn place<K: Eq>(
        &self,
        key: fn mut() -> K with Track,
        shows: fn(K) -> bool,
        render: fn mut(K) -> View with (Track, Dom),
    ) -> View with (Track, Dom) {
        let mut key = key;
        let mut render = render;
        // Holds the place, so siblings added later stay after the subtree.
        let anchor = Dom::document().create_text_node("");
        self.node.append_child(anchor);
        let mut shown_for: Option<K> = null;
        let mut shown: Option<Rendered> = null;
        let mut disposed = false;
        on_cleanup(|| {
            disposed = true;
            hide(&mut shown);
            detach(anchor);
        });
        observe(|| {
            let current = key();
            if let Some(was) = shown_for && was == current {
                return;
            }
            shown_for = Option::Some(current);
            hide(&mut shown);
            // `key` or a cleanup of what was shown may have disposed of the
            // binding's owner.
            if disposed || !shows(current) {
                return;
            }
            let made = render_owned(|| render(current));
            // So may `render`.
            if disposed {
                remove(made);
                return;
            }
            if let Some(holder) = anchor.parent_node() {
                holder.insert_before(made.node, Option::Some(anchor as Node));
            }
            shown = Option::Some(made);
        });
        return *self;
    }

    pub fn child(&self, child: View) -> View with Dom {
        self.node.append_child(child.node);
        return *self;
    }

    pub fn children(&self, children: List<View>) -> View with Dom {
        for let child of children {
            self.child(child);
        }
        return *self;
    }

    pub fn on(&self, type: String, handler: fn mut(Event) with (Track, Dom)) -> View with Dom {
        on(self.node, type, handler);
        return *self;
    }

    /// Keeps the element's children at one per item, in the items' order. An
    /// item equal to one already shown keeps its child, and whatever `render`
    /// made for an item that left is disposed of.
    pub fn each<T: Eq>(
        &self,
        items: fn mut() -> List<T> with Track,
        render: fn mut(T) -> View with (Track, Dom),
    ) -> View with (Track, Dom) {
        each(self.node, items, render);
        return *self;
    }
}

/// Listens on `target`, and flushes once the handler returns: the handler's
/// writes are one batch.
pub fn on(target: EventTarget, type: String, handler: fn mut(Event) with (Track, Dom)) with Dom {
    let mut handler = handler;
    target.add_event_listener(type, |event: Event| {
        untracked(|| handler(event));
        flush();
    });
}

/// Takes `node` out of wherever it is now; other code may have moved it.
fn detach(node: Node) with Dom {
    if let Some(holder) = node.parent_node() {
        holder.remove_child(node);
    }
}

/// A subtree and what disposes of what was made with it.
struct Rendered {
    node: Element,
    dispose: fn mut() with Dom,
}

fn render_owned(render: fn mut() -> View with (Track, Dom)) -> Rendered with Dom {
    let mut render = render;
    let mut node: Option<Element> = null;
    let dispose = scope(|| node = Option::Some(render().node));
    return Rendered { node: node.unwrap(), dispose };
}

fn remove(rendered: Rendered) with Dom {
    let mut dispose = rendered.dispose;
    dispose();
    detach(rendered.node);
}

/// Clears `shown` before removing it, so a cleanup that reaches `shown` again
/// finds nothing left to hide.
fn hide(shown: &mut Option<Rendered>) with Dom {
    let Some(current) = *shown else {
        return;
    };
    *shown = null;
    remove(current);
}

struct Row<T> {
    item: T,
    rendered: Rendered,
}

fn remove_rows<T>(rows: List<Row<T>>) with Dom {
    for let row of rows {
        remove(row.rendered);
    }
}

/// Empties `rows` before removing them, so a cleanup that reaches `rows` again
/// finds none of them left to remove.
fn clear_rows<T>(rows: &mut List<Row<T>>) with Dom {
    let leaving = *rows;
    *rows = [];
    remove_rows(leaving);
}

fn each<T: Eq>(
    parent: Element,
    items: fn mut() -> List<T> with Track,
    render: fn mut(T) -> View with (Track, Dom),
) with (Track, Dom) {
    let mut items = items;
    let mut render = render;
    let mut rows: List<Row<T>> = [];
    let mut disposed = false;
    on_cleanup(|| {
        disposed = true;
        clear_rows(&mut rows);
    });
    observe(|| {
        let mut kept: List<Row<T>> = [];
        // Each kept row's index among the rows before, -1 for a new one.
        let mut was: List<i32> = [];
        let shown = rows.len();
        let mut left: List<i32> = (0..<shown).collect();
        for let item of items() {
            let mut found = false;
            for let i of 0..<rows.len() {
                if rows[i].item == item {
                    kept.push(rows.remove(i));
                    was.push(left.remove(i));
                    found = true;
                    break;
                }
            }
            if found {
                continue;
            }
            kept.push(Row { item, rendered: render_owned(|| render(item)) });
            was.push(-1);
            if disposed {
                break;
            }
        }
        clear_rows(&mut rows);
        // `render` or a cleanup may have disposed of the binding's owner,
        // whose cleanup removed only the rows not yet kept.
        if disposed {
            remove_rows(kept);
            return;
        }
        // `render` and the cleanups have run, and either may have moved a row.
        // Nothing runs from here on, so the DOM now is the DOM the moves meet.
        let mut before: List<Option<Element>> = [];
        for let _ of 0..<shown {
            before.push(null);
        }
        for let i of 0..<kept.len() {
            if was[i] >= 0 {
                before[was[i]] = Option::Some(kept[i].rendered.node);
            }
        }
        if !holds_in_order(parent, &before) {
            for let i of 0..<was.len() {
                was[i] = -1;
            }
        }
        // The rows already in their old order stay; the rest move in among
        // them, from the last row back.
        let stay = longest_increasing(&was);
        let mut next: Option<Node> = null;
        for let mut i = kept.len() - 1; i >= 0; i -= 1 {
            let node = kept[i].rendered.node;
            if !stay[i] {
                parent.insert_before(node, next);
            }
            next = Option::Some(node);
        }
        rows = kept;
    });
}

// Whether `parent`'s children are exactly `nodes`, in order, the gaps skipped:
// other code may have moved one.
fn holds_in_order(parent: Element, nodes: &List<Option<Element>>) -> bool with Dom {
    let mut child = parent.first_child();
    for let slot of nodes {
        let Some(expected) = slot else {
            continue;
        };
        if child != Option::Some(expected as Node) {
            return false;
        }
        child = child.unwrap().next_sibling();
    }
    return child == null;
}

// Marks a longest strictly increasing subsequence of `values`, skipping the
// negative ones.
fn longest_increasing(values: &List<i32>) -> List<bool> {
    // `tails[k]` ends the increasing run of length k + 1 with the least last value.
    let mut tails: List<i32> = [];
    let mut previous: List<i32> = [];
    for let i of 0..<values.len() {
        previous.push(-1);
        if values[i] < 0 {
            continue;
        }
        let mut low = 0;
        let mut high = tails.len();
        while low < high {
            let middle = (low + high) / 2;
            if values[tails[middle]] < values[i] {
                low = middle + 1;
            } else {
                high = middle;
            }
        }
        if low > 0 {
            previous[i] = tails[low - 1];
        }
        if low == tails.len() {
            tails.push(i);
        } else {
            tails[low] = i;
        }
    }
    let mut marked: List<bool> = [];
    for let _ of 0..<values.len() {
        marked.push(false);
    }
    let mut at = if tails.is_empty() { -1 } else { tails[tails.len() - 1] };
    while at >= 0 {
        marked[at] = true;
        at = previous[at];
    }
    return marked;
}
