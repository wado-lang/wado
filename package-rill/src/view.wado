//! Signals bound to the DOM: each binding is an effect that writes one place,
//! so a write to a signal touches the nodes that show it and no others.

use { Track, flush, observe, on_cleanup, scope, untracked } from "./signals.wado";
use { TreeMap } from "core:collections";
use { Dom, Element, Event, EventTarget, Node } from "wado-lang:web";

/// An element as it is to be built. Each method returns the view with one more
/// step, so a page is written as one expression that nests as the DOM does.
/// Nothing is built until `build` or `hydrate` runs the steps, parent before
/// children, in the order they were written.
pub struct View {
    origin: Origin,
    steps: List<fn mut(&mut Build) with (Track, Dom)>,
}

/// What a view builds on: an element it makes, or one made elsewhere.
variant Origin {
    Tag(String),
    Adopted(Element),
}

pub fn element(tag: String) -> View {
    return View { origin: Origin::Tag(tag), steps: [] };
}

/// Builds `view` anew, inside the computation that owns its bindings.
pub fn build(view: View) -> Element with (Track, Dom) {
    let node = make(view.origin);
    run_steps(node, null, view.steps);
    return node;
}

fn make(origin: Origin) -> Element with Dom {
    return match origin {
        Tag(tag) => Dom::document().create_element(tag),
        Adopted(node) => node,
    };
}

/// Builds `view` on the served element it adopts, taking each element it would
/// make from what the element already holds. Text is made anew, since the HTML
/// a page is served as merges adjacent text and drops empty text.
///
/// A served page that differs from the view is a bug in the app or the build.
/// A build that checks contracts traps on it; any other builds anew what
/// differs, so the page keeps working.
pub fn hydrate(view: View) -> Element with (Track, Dom) {
    return hydrate_reporting(view, |what: String| unchecked mismatch(what));
}

fn mismatch(what: String)
    contract false, `hydrate: ${what}`
{
}

/// Hydrates `view`, handing each mismatch to `report` and building anew what
/// differs.
internal fn hydrate_reporting(view: View, report: fn mut(String)) -> Element with (Track, Dom) {
    let Adopted(node) = view.origin else {
        panic("hydrate builds on a served element, which `View::of` names");
    };
    run_steps(node, Option::Some(report), view.steps);
    return node;
}

/// The element being built, and how far the build has come through it.
///
/// A build claims what was served while it has a `report` for what differs.
/// Then `served` and `served_attributes` hold the children and the attributes
/// the element was served with, taken before any step runs: a step may move a
/// child or write an attribute. The build has passed the first `passed`
/// children. `attributes` holds the value each static attribute is left at,
/// `None` for one a binding writes, checked against `served_attributes` once
/// every step has run.
struct Build {
    node: Element,
    report: Option<fn mut(String)>,
    served: List<Node>,
    passed: i32,
    attributes: TreeMap<String, Option<String>>,
    served_attributes: TreeMap<String, String>,
}

impl Build {
    fn new(node: Element, report: Option<fn mut(String)>) -> Build with Dom {
        let mut served: List<Node> = [];
        let mut served_attributes = TreeMap::<String, String>::new();
        if report matches { Some(_) } {
            let mut child = node.first_child();
            while let Some(current) = child {
                served.push(current);
                child = current.next_sibling();
            }
            for let name of node.get_attribute_names() {
                served_attributes[name] = node.get_attribute(name).unwrap();
            }
        }
        return Build { node, report, served, passed: 0, attributes: TreeMap::new(), served_attributes };
    }

    fn claiming(&self) -> bool {
        return self.report matches { Some(_) };
    }

    fn report(&mut self, what: String) with Dom {
        let mut report = self.report.unwrap();
        report(`<${self.node.local_name()}> ${what}`);
    }

    /// The first served child not yet passed, passing those a callback took
    /// out of the element.
    fn ahead(&mut self) -> Option<Node> with Dom {
        while self.passed < self.served.len() {
            let served = self.served[self.passed];
            if served.parent_node() == Option::Some(self.node as Node) {
                return Option::Some(served);
            }
            self.passed += 1;
        }
        return null;
    }

    fn next_served(&mut self) -> Option<Node> with Dom {
        let served = self.ahead();
        if served matches { Some(_) } {
            self.passed += 1;
        }
        return served;
    }

    /// Puts `node` at the point the build has reached.
    fn insert(&mut self, node: Node) with Dom {
        self.node.insert_before(node, self.ahead());
    }

    /// Takes the next served element, if any is left, and out the served text
    /// before it.
    fn claim(&mut self) -> Option<Element> with Dom {
        while let Some(served) = self.next_served() {
            if let claimed: Element = served {
                return Option::Some(claimed);
            }
            self.node.remove_child(served);
        }
        return null;
    }

    /// Takes out what was served after the last element claimed.
    fn finish(&mut self) with Dom {
        while let Some(served) = self.next_served() {
            if let extra: Element = served {
                self.report(`was served <${extra.local_name()}>, which its view does not build`);
            }
            self.node.remove_child(served);
        }
    }

    /// Reports each static attribute served at another value. The step that
    /// set it has written the view's value already.
    fn check_attributes(&mut self) with Dom {
        for let [name, value] of self.attributes.entries() {
            if let Some(expected) = value && self.served_attributes.get(*name) != Option::Some(*expected) {
                self.report(`was served another ${name} than "${expected}"`);
            }
        }
    }
}

fn run_steps(
    node: Element,
    report: Option<fn mut(String)>,
    steps: List<fn mut(&mut Build) with (Track, Dom)>,
) with (Track, Dom) {
    let mut at = Build::new(node, report);
    for let step of steps {
        let mut step = step;
        step(&mut at);
    }
    if at.claiming() {
        at.finish();
        at.check_attributes();
    }
}

/// Whether an HTML element stores the attribute name as written: it lowers
/// the name, and hydration compares names as the element stores them.
fn is_stored_as_written(name: String) -> bool {
    return name == name.to_ascii_lowercase();
}

/// Builds `view` at the point `parent` has reached: on the served element
/// there while claiming, and anew where none fits.
fn build_in(parent: &mut Build, view: View) -> Element with (Track, Dom) {
    let served = if parent.claiming() { parent.claim() } else { null };
    if let Some(claimed) = served && fits(claimed, &view.origin) {
        run_steps(claimed, parent.report, view.steps);
        return claimed;
    }
    let made = make(view.origin);
    match served {
        Some(other) => {
            parent.report(`was served <${other.local_name()}> where its view builds <${made.local_name()}>`);
            parent.node.replace_child(made, other);
        },
        None => {
            if parent.claiming() {
                parent.report(`was served without the <${made.local_name()}> its view builds`);
            }
            parent.insert(made);
        },
    }
    run_steps(made, null, view.steps);
    return made;
}

fn fits(served: Element, origin: &Origin) -> bool with Dom {
    return match *origin {
        Tag(tag) => served.local_name() == tag,
        Adopted(node) => served == node,
    };
}

impl View {
    /// Builds on an element made elsewhere, such as the one a page mounts in.
    pub fn of(node: Element) -> View {
        return View { origin: Origin::Adopted(node), steps: [] };
    }

    fn then(&self, step: fn mut(&mut Build) with (Track, Dom)) -> View {
        let mut next = *self;
        next.steps.push(step);
        return next;
    }

    pub fn attribute(&self, name: String, value: String) -> View
        contract is_stored_as_written(name), "an attribute name must be lowercase, as an HTML element stores it"
    {
        return self.then(
            |at: &mut Build| {
                if at.claiming() {
                    at.attributes[name] = Option::Some(value);
                }
                at.node.set_attribute(name, value);
            },
        );
    }

    /// Keeps the attribute at what `value` answers, absent for `None`.
    pub fn bind_attribute(&self, name: String, value: fn mut() -> Option<String> with Track) -> View
        contract is_stored_as_written(name), "an attribute name must be lowercase, as an HTML element stores it"
    {
        let mut value = value;
        return self.then(|at: &mut Build| {
            at.attributes[name] = null;
            let target = at.node;
            observe(|| {
                match value() {
                    Some(set) => target.set_attribute(name, set),
                    None => target.remove_attribute(name),
                }
            });
        });
    }

    /// Adds a text node holding `content`.
    pub fn text(&self, content: String) -> View {
        return self.then(|at: &mut Build| at.insert(Dom::document().create_text_node(content)));
    }

    /// Adds a text node and keeps its text at what `content` answers, taking it
    /// out when the binding is disposed of.
    pub fn bind_text(&self, content: fn mut() -> String with Track) -> View {
        let mut content = content;
        return self.then(|at: &mut Build| {
            let shown = Dom::document().create_text_node("");
            at.insert(shown);
            on_cleanup(|| detach(shown));
            observe(|| shown.set_data(content()));
        });
    }

    /// Shows what `render` makes at this point among the element's children
    /// while `when` answers true. It renders anew each time it shows, and
    /// disposes of what it hides.
    pub fn show(&self, when: fn mut() -> bool with Track, render: fn mut() -> View with (Track, Dom)) -> View {
        let mut render = render;
        return self.place(when, |visible| visible, |_| render());
    }

    /// Shows what `render` makes for the key `key` answers, at this point
    /// among the element's children. It keeps that subtree while the key stays
    /// equal, and disposes of it for the next one when the key changes.
    pub fn switch<K: Eq>(&self, key: fn mut() -> K with Track, render: fn mut(K) -> View with (Track, Dom)) -> View {
        return self.place(key, |_| true, render);
    }

    fn place<K: Eq>(
        &self,
        key: fn mut() -> K with Track,
        shows: fn(K) -> bool,
        render: fn mut(K) -> View with (Track, Dom),
    ) -> View {
        return self.then(|at: &mut Build| place(at, key, shows, render));
    }

    pub fn child(&self, child: View) -> View {
        return self.then(|at: &mut Build| {
            build_in(at, child);
        });
    }

    pub fn children(&self, children: List<View>) -> View {
        return self.then(|at: &mut Build| {
            for let child of children {
                build_in(at, child);
            }
        });
    }

    pub fn on(&self, type: String, handler: fn mut(Event) with (Track, Dom)) -> View {
        return self.then(|at: &mut Build| on(at.node, type, handler));
    }

    /// Hands the element to `use_node` once it is built or claimed.
    pub fn with_node(&self, use_node: fn mut(Element) with (Track, Dom)) -> View {
        let mut use_node = use_node;
        return self.then(|at: &mut Build| use_node(at.node));
    }

    /// Keeps the element's children at one per item, in the items' order. An
    /// item equal to one already shown keeps its child, and whatever `render`
    /// made for an item that left is disposed of.
    pub fn each<T: Eq>(
        &self,
        items: fn mut() -> List<T> with Track,
        render: fn mut(T) -> View with (Track, Dom),
    ) -> View {
        return self.then(|at: &mut Build| each(at, items, render));
    }
}

/// Listens on `target`, and flushes once the handler returns: the handler's
/// writes are one batch.
pub fn on(target: EventTarget, type: String, handler: fn mut(Event) with (Track, Dom)) with Dom {
    let mut handler = handler;
    target.add_event_listener(type, |event: Event| {
        untracked(|| handler(event));
        flush();
    });
}

/// Takes `node` out of wherever it is now; other code may have moved it.
fn detach(node: Node) with Dom {
    if let Some(holder) = node.parent_node() {
        holder.remove_child(node);
    }
}

/// A subtree and what disposes of what was made with it.
struct Rendered {
    node: Element,
    dispose: fn mut() with Dom,
}

/// Builds what `render` makes in a scope of its own: at the point `at` has
/// reached while `in_place`, so a claiming build claims it, and anew otherwise.
fn render_owned(at: &mut Build, in_place: bool, render: fn mut() -> View with (Track, Dom)) -> Rendered with Dom {
    let mut render = render;
    let mut node: Option<Element> = null;
    let dispose = scope(|| {
        let view = render();
        node = Option::Some(if in_place { build_in(at, view) } else { build(view) });
    });
    return Rendered { node: node.unwrap(), dispose };
}

fn remove(rendered: Rendered) with Dom {
    let mut dispose = rendered.dispose;
    dispose();
    detach(rendered.node);
}

/// Clears `shown` before removing it, so a cleanup that reaches `shown` again
/// finds nothing left to hide.
fn hide(shown: &mut Option<Rendered>) with Dom {
    let Some(current) = *shown else {
        return;
    };
    *shown = null;
    remove(current);
}

/// Shows what `render` makes for the key, for a key `shows` admits, at the
/// point `at` has reached.
fn place<K: Eq>(
    at: &mut Build,
    key: fn mut() -> K with Track,
    shows: fn(K) -> bool,
    render: fn mut(K) -> View with (Track, Dom),
) with (Track, Dom) {
    let mut key = key;
    let mut render = render;
    // Holds the place, so siblings added later stay after the subtree.
    let anchor = Dom::document().create_text_node("");
    let mut building = true;
    let mut shown_for: Option<K> = null;
    let mut shown: Option<Rendered> = null;
    let mut disposed = false;
    on_cleanup(|| {
        disposed = true;
        hide(&mut shown);
        detach(anchor);
    });
    observe(|| {
        let in_place = building;
        building = false;
        let mut current = key();
        if let Some(was) = shown_for && was == current {
            return;
        }
        if shown matches { Some(_) } {
            hide(&mut shown);
            // A cleanup of what was shown may have written what `key` reads.
            if !disposed {
                current = key();
            }
        }
        // `key` or a cleanup may have disposed of the binding's owner.
        if disposed {
            return;
        }
        shown_for = Option::Some(current);
        if !shows(current) {
            return;
        }
        let made = render_owned(at, in_place, || render(current));
        // So may `render`.
        if disposed {
            remove(made);
            return;
        }
        if !in_place && let Some(holder) = anchor.parent_node() {
            holder.insert_before(made.node, Option::Some(anchor as Node));
        }
        shown = Option::Some(made);
    });
    if !disposed {
        at.insert(anchor);
    }
}

struct Row<T> {
    item: T,
    rendered: Rendered,
}

fn remove_rows<T>(rows: List<Row<T>>) with Dom {
    for let row of rows {
        remove(row.rendered);
    }
}

/// Empties `rows` before removing them, so a cleanup that reaches `rows` again
/// finds none of them left to remove.
fn clear_rows<T>(rows: &mut List<Row<T>>) with Dom {
    let leaving = *rows;
    *rows = [];
    remove_rows(leaving);
}

fn each<T: Eq>(
    at: &mut Build,
    items: fn mut() -> List<T> with Track,
    render: fn mut(T) -> View with (Track, Dom),
) with (Track, Dom) {
    let parent = at.node;
    let mut items = items;
    let mut render = render;
    let mut building = true;
    let mut rows: List<Row<T>> = [];
    let mut disposed = false;
    on_cleanup(|| {
        disposed = true;
        clear_rows(&mut rows);
    });
    observe(|| {
        let in_place = building;
        building = false;
        let mut kept: List<Row<T>> = [];
        // Each kept row's index among the rows before, -1 for a new one.
        let mut was: List<i32> = [];
        let shown = rows.len();
        let mut left: List<i32> = (0..<shown).collect();
        for let item of items() {
            let mut found = false;
            for let i of 0..<rows.len() {
                if rows[i].item == item {
                    kept.push(rows.remove(i));
                    was.push(left.remove(i));
                    found = true;
                    break;
                }
            }
            if found {
                continue;
            }
            // A row built in place stands as if it had been shown in order.
            was.push(if in_place { kept.len() } else { -1 });
            kept.push(Row { item, rendered: render_owned(at, in_place, || render(item)) });
            if disposed {
                break;
            }
        }
        clear_rows(&mut rows);
        // `render` or a cleanup may have disposed of the binding's owner,
        // whose cleanup removed only the rows not yet kept.
        if disposed {
            remove_rows(kept);
            return;
        }
        // The rows are all of the element's children, so served text after
        // the last one goes before the order is checked.
        if in_place && at.claiming() {
            at.finish();
        }
        // `render` and the cleanups have run, and either may have moved a row.
        // Nothing runs from here on, so the DOM now is the DOM the moves meet.
        let slots = if in_place { kept.len() } else { shown };
        let mut before: List<Option<Element>> = [];
        for let _ of 0..<slots {
            before.push(null);
        }
        for let i of 0..<kept.len() {
            if was[i] >= 0 {
                before[was[i]] = Option::Some(kept[i].rendered.node);
            }
        }
        if !holds_in_order(parent, &before) {
            for let i of 0..<was.len() {
                was[i] = -1;
            }
        }
        // The rows already in their old order stay; the rest move in among
        // them, from the last row back.
        let stay = longest_increasing(&was);
        let mut next: Option<Node> = null;
        for let mut i = kept.len() - 1; i >= 0; i -= 1 {
            let node = kept[i].rendered.node;
            if !stay[i] {
                parent.insert_before(node, next);
            }
            next = Option::Some(node);
        }
        rows = kept;
    });
}

// Whether `parent`'s children are exactly `nodes`, in order, the gaps skipped:
// other code may have moved one.
fn holds_in_order(parent: Element, nodes: &List<Option<Element>>) -> bool with Dom {
    let mut child = parent.first_child();
    for let slot of nodes {
        let Some(expected) = slot else {
            continue;
        };
        if child != Option::Some(expected as Node) {
            return false;
        }
        child = child.unwrap().next_sibling();
    }
    return child == null;
}

// Marks a longest strictly increasing subsequence of `values`, skipping the
// negative ones.
fn longest_increasing(values: &List<i32>) -> List<bool> {
    // `tails[k]` ends the increasing run of length k + 1 with the least last value.
    let mut tails: List<i32> = [];
    let mut previous: List<i32> = [];
    for let i of 0..<values.len() {
        previous.push(-1);
        if values[i] < 0 {
            continue;
        }
        let mut low = 0;
        let mut high = tails.len();
        while low < high {
            let middle = (low + high) / 2;
            if values[tails[middle]] < values[i] {
                low = middle + 1;
            } else {
                high = middle;
            }
        }
        if low > 0 {
            previous[i] = tails[low - 1];
        }
        if low == tails.len() {
            tails.push(i);
        } else {
            tails[low] = i;
        }
    }
    let mut marked: List<bool> = [];
    for let _ of 0..<values.len() {
        marked.push(false);
    }
    let mut at = if tails.is_empty() { -1 } else { tails[tails.len() - 1] };
    while at >= 0 {
        marked[at] = true;
        at = previous[at];
    }
    return marked;
}
