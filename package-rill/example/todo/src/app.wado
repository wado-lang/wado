//! A to-do list. `mount` runs once and builds the page; after that only the
//! bindings run, each when a signal it read was written.

use { Memo, Signal, Track, View, build, element, memo, scope, signal } from "wado-lang:rill";
use { Dom, Element, Event, HtmlInputElement, SurfaceDom } from "wado-lang:web";

struct Todo {
    id: i32,
    title: String,
    done: Signal<bool>,
}

impl Eq for Todo {
    fn eq(&self, other: &Self) -> bool {
        return self.id == other.id;
    }
}

fn done_class(todo: &Todo) -> Option<String> with Track {
    if todo.done.get() {
        return Option::Some("done");
    }
    return null;
}

fn todo_row(todos: Signal<List<Todo>>, todo: Todo) -> View {
    let title = element("span").text(todo.title).on("click", |_: Event| todo.done.set(!todo.done.get()));
    let remove = element("button").text("×").on("click", |_: Event| {
        let mut rest: List<Todo> = [];
        for let other of todos.get() {
            if other != todo {
                rest.push(other);
            }
        }
        todos.set(rest);
    });
    let row = element("li").attribute("id", `todo-${todo.id}`);
    return row.bind_attribute("class", || done_class(&todo)).children([title, remove]);
}

/// Builds the list under `root` with `attach`, which is `build` for an empty
/// root and `hydrate` for one served with the page. Returns what stops its
/// bindings and takes out the rows and the summary. The other nodes stay, and
/// so do the listeners.
pub fn mount(root: Element, attach: fn(View) -> Element with (Track, Dom)) -> fn mut() with Dom with Dom {
    return scope(|| {
        let todos: Signal<List<Todo>> = signal([]);
        let mut next_id = 1;
        let remaining: Memo<i32> = memo(|| {
            let mut left = 0;
            for let todo of todos.get() {
                if !todo.done.get() {
                    left += 1;
                }
            }
            return left;
        });

        let mut field: Option<HtmlInputElement> = null;
        let view = View::of(root)
            .children([
                element("input").attribute("id", "title").with_node(|node| {
                    let input: HtmlInputElement = node else {
                        unreachable();
                    };
                    field = Option::Some(input);
                }),
                element("button").attribute("id", "add").text("Add").on("click", |_: Event| {
                    let input = field.unwrap();
                    let title = input.value();
                    if title.is_empty() {
                        return;
                    }
                    let mut list = todos.get();
                    list.push(Todo { id: next_id, title, done: signal(false) });
                    next_id += 1;
                    todos.set(list);
                    input.set_value("");
                }),
                element("ul").each(|| todos.get(), |todo: Todo| todo_row(todos, todo)),
            ])
            .switch(|| todos.get().is_empty(), |empty| {
                if empty {
                    return element("p").text("Nothing to do.");
                }
                return element("p").bind_text(|| `${remaining.get()} left`);
            });
        attach(view);
    });
}

/// The page as served: the list's initial state, and the browser program that
/// hydrates it, at `script` beside the page.
pub fn page(script: String) -> String {
    let mut dom = SurfaceDom::new();
    with &mut dom do {
        let doc = Dom::document();
        doc.set_title("Rill to-do");
        let Some(head: Element) = doc.document_element().unwrap().first_child() else {
            unreachable();
        };
        let charset = doc.create_element("meta");
        charset.set_attribute("charset", "utf-8");
        head.insert_before(charset, head.first_child());
        let style = doc.create_element("style");
        style.set_text_content(Option::Some(
            "li.done span { text-decoration: line-through; } li span { cursor: pointer; }",
        ));
        head.append_child(style);
        let program = doc.create_element("script");
        program.set_attribute("type", "module");
        program.set_attribute("src", script);
        head.append_child(program);
        mount(doc.body().unwrap(), build);
    };
    return dom.to_html();
}
