// Schemas compiled by Grog, encoded and decoded by its runtime.
use { TreeMap } from "core:collections";
use { LinearArray, LinearBuffer } from "core:linear";
use grog from "lib:grog";
use { Account, AccountAddress, AccountContact, Spread, SpreadPick, Status } from "./demo.proto"
    with {
        generator: { module: "lib:grog" },
    };
use legacy from "./legacy.proto"
    with {
        generator: { module: "lib:grog" },
    };
use descriptor from "../../tests/proto/protobuf/src/google/protobuf/descriptor.proto"
    with {
        generator: { module: "lib:grog" },
    };
use pbstruct from "../../tests/proto/protobuf/src/google/protobuf/struct.proto"
    with {
        generator: { module: "lib:grog" },
    };
use onnx from "../../tests/proto/onnx/onnx/onnx.proto"
    with {
        generator: { module: "lib:grog" },
    };

fn unhex(text: String) -> ByteList {
    let mut out: ByteList = b"";
    let view = text.as_str_slice();
    for let mut i = 0; i < view.len(); i += 2 {
        out.push(u8::from_str_radix(view.slice(i, i + 2), 16).unwrap());
    }
    return out;
}

fn held(bytes: &ByteList) -> LinearBuffer {
    return LinearBuffer::of(LinearArray::from_slice(bytes));
}

/// Serves `content` three bytes a read, so every field straddles a read.
struct Trickle {
    content: ByteList,
    at: i32,
}

impl Stream<u8> for Trickle {
    fn begin_read(&mut self, this: &Stream<u8>, max: i32, into: ReadInto) -> StartedRead<u8> {
        let _ = [this, into];
        let end = i32::min(self.content.len(), self.at + i32::min(max, 3));
        let items = self.content[self.at..<end].to_list() as List<u8>;
        self.at = end;
        let result = if end == self.content.len() { CopyResult::Dropped } else { CopyResult::Completed };
        resume StartedRead::settled(StreamChunk { items, result });
    }

    ..forward
}

test "an empty proto3 message is no bytes" {
    assert grog::encode(&Account {}).len() == 0;
}

test "implicit fields are written only when set" {
    assert grog::encode(&Account { id: 150, status: Status::Active }).to_hex() == "0896015001";
}

test "a oneof member is written at its own number" {
    let last = Spread { pick: Option::Some(SpreadPick::Last("q")), middle: 2 };
    assert grog::encode(&last).to_hex() == "28024a0171";
    let first = Spread { pick: Option::Some(SpreadPick::First(3)), middle: 2 };
    assert grog::encode(&first).to_hex() == "08032802";
}

test "every mapping round-trips" {
    let mut limits = TreeMap::<String, i32>::new();
    limits["daily"] = 10;
    let account = Account {
        id: 7,
        name: "Ada",
        balance: Option::Some(0),
        delta: -3,
        checksum: 0xdeadbeef,
        offset: -1,
        ratio: 0.5,
        verified: true,
        avatar: b"\x89PNG",
        status: Status::Retired,
        tags: ["a", "b"],
        limits,
        address: Option::Some(AccountAddress { city: "Kyoto", zip: 6000000 }),
        history: [
            AccountAddress { city: "Osaka" },
        ],
        contact: Option::Some(AccountContact::Phone(81)),
        scores: [1, -1, 300],
    };
    assert grog::decode::<Account>(&grog::encode(&account)).unwrap() == account;
}

test "sint32 is zigzag and sfixed32 fixed on the wire" {
    assert grog::encode(&Account { delta: -3 }).to_hex() == "2005";
    assert grog::encode(&Account { offset: -1 }).to_hex() == "35ffffffff";
}

test "explicit presence writes a zero" {
    assert grog::encode(&Account { balance: Option::Some(0) }).to_hex() == "1800";
}

test "a repeated scalar is packed in proto3 and read either way" {
    assert grog::encode(&Account {
        scores: [1, -1],
    }).to_hex() == "8a01020201";
    let unpacked = grog::decode::<Account>(&unhex("880102880101")).unwrap();
    assert unpacked.scores == [1, -1];
}

test "a oneof holds its last member" {
    let back = grog::decode::<Account>(&unhex("7a0161800102")).unwrap();
    assert back.contact == Option::Some(AccountContact::Phone(2));
}

test "an open enum keeps a number it does not declare" {
    let back = grog::decode::<Account>(&unhex("5007")).unwrap();
    assert back.status == Status::Unrecognized(7);
    assert grog::encode(&back).to_hex() == "5007";
}

test "an undeclared field survives a round trip" {
    let input = unhex("0801a0063fa20603616263");
    let back = grog::decode::<Account>(&input).unwrap();
    assert back.id == 1;
    assert grog::encode(&back).to_hex() == input.to_hex();
}

test "a message merges field by field" {
    let mut account = grog::decode::<Account>(&unhex("0801")).unwrap();
    grog::merge(&mut account, &unhex("12026869")).unwrap();
    assert account.id == 1;
    assert account.name == "hi";
}

test "a repeated message field is read one value at a time" {
    let account = Account {
        id: 7,
        history: [
            AccountAddress { city: "Osaka" },
            AccountAddress { zip: 1 },
        ],
        address: Option::Some(AccountAddress { city: "Kyoto" }),
    };
    let mut read: List<AccountAddress> = [];
    for let a of Account::history_of(held(&grog::encode(&account))) {
        read.push(a.unwrap());
    }
    assert read == account.history;
}

test "a repeated message is read one value at a time off a stream" {
    let account = Account {
        name: "a name longer than one read",
        history: [
            AccountAddress { city: "Osaka", zip: 5300001 },
            AccountAddress { city: "Kyoto" },
        ],
        scores: [1, -1, 300],
    };
    let [rx, tx] = Stream::<u8>::new();
    tx.drop();
    let mut source = Trickle { content: grog::encode(&account), at: 0 };
    let read: List<Result<AccountAddress, grog::DecodeError>> = with &mut source do {
        Account::history_of(LinearBuffer::of_stream(rx)).collect();
    };
    assert read.len() == 2;
    assert read[0].unwrap() == account.history[0];
    assert read[1].unwrap() == account.history[1];
}

test "a repeated message read one at a time skips a value of another wire type" {
    // Field 14 as a varint, then as the message `{ zip: 1 }`, around a fixed32
    // and a fixed64 field.
    let input = unhex("700535ffffffff72021001390000000000000000");
    let read: List<Result<AccountAddress, grog::DecodeError>> = Account::history_of(held(&input)).collect();
    assert read.len() == 1;
    assert read[0].unwrap().zip == 1;
}

test "a repeated message read one at a time stops at a malformed input" {
    let read: List<Result<AccountAddress, grog::DecodeError>> = Account::history_of(held(&unhex("7202100172"))).collect();
    assert read.len() == 2;
    assert read[0].unwrap().zip == 1;
    assert read[1] matches { Err(e) && e.offset == 5 };
}

test "a value cut short off a stream is refused where it starts, as a decode refuses it" {
    let [rx, tx] = Stream::<u8>::new();
    tx.drop();
    let mut source = Trickle { content: unhex("720210017205100110"), at: 0 };
    let read: List<Result<AccountAddress, grog::DecodeError>> = with &mut source do {
        Account::history_of(LinearBuffer::of_stream(rx)).collect();
    };
    assert read.len() == 2;
    assert read[1] matches { Err(e) && e.offset == 6 };
}

test "messages one after another are read each behind its length" {
    let first = AccountAddress { city: "Osaka" };
    let second = AccountAddress {};
    let third = AccountAddress { zip: 1 };
    let mut input = grog::encode_delimited(&first);
    input.extend(&grog::encode_delimited(&second));
    input.extend(&grog::encode_delimited(&third));
    assert input.to_hex() == "070a054f73616b6100021001";
    let [rx, tx] = Stream::<u8>::new();
    tx.drop();
    let mut source = Trickle { content: input, at: 0 };
    let read: List<Result<AccountAddress, grog::DecodeError>> = with &mut source do {
        grog::delimited::<AccountAddress>(LinearBuffer::of_stream(rx)).collect();
    };
    assert read.len() == 3;
    assert read[0].unwrap() == first;
    assert read[1].unwrap() == second;
    assert read[2].unwrap() == third;
}

test "a delimited message cut short is refused" {
    let read: List<Result<AccountAddress, grog::DecodeError>> = grog::delimited::<AccountAddress>(held(&unhex(
        "0210010310",
    ))).collect();
    assert read.len() == 2;
    assert read[0].unwrap().zip == 1;
    assert read[1] matches { Err(e) && e.offset == 4 };
}

test "a repeated group is read one value at a time" {
    let record = legacy::Record {
        id: Option::Some(1),
        tag: [
            legacy::RecordTag { name: Option::Some("a") },
            legacy::RecordTag {},
        ],
    };
    let read: List<Result<legacy::RecordTag, grog::DecodeError>> = legacy::Record::tag_of(held(&grog::encode(&record))).collect();
    assert read.len() == 2;
    assert read[0].unwrap() == record.tag[0];
    assert read[1].unwrap() == record.tag[1];
}

test "a repeated group is read one value at a time off a stream" {
    let record = legacy::Record {
        id: Option::Some(1),
        tag: [
            legacy::RecordTag { name: Option::Some("a name that spans reads") },
            legacy::RecordTag {},
        ],
    };
    let [rx, tx] = Stream::<u8>::new();
    tx.drop();
    let mut source = Trickle { content: grog::encode(&record), at: 0 };
    let read: List<Result<legacy::RecordTag, grog::DecodeError>> = with &mut source do {
        legacy::Record::tag_of(LinearBuffer::of_stream(rx)).collect();
    };
    assert read.len() == 2;
    assert read[0].unwrap() == record.tag[0];
    assert read[1].unwrap() == record.tag[1];
}

test "a truncated or malformed input is refused" {
    assert grog::decode::<Account>(&unhex("08")) matches { Err(_) };
    assert grog::decode::<Account>(&unhex("1205ab")) matches { Err(_) };
    assert grog::decode::<Account>(&unhex("0f")) matches { Err(_) };
    assert grog::decode::<Account>(&unhex("1201ff")) matches { Err(_) };
}

test "proto2 writes every set field, zeros included" {
    let record = legacy::Record {
        id: Option::Some(0),
        level: Option::Some(legacy::Level::Low),
    };
    assert grog::encode(&record).to_hex() == "08001001";
}

test "a closed enum's undeclared number is an unknown field" {
    let input = unhex("08011009");
    let back = grog::decode::<legacy::Record>(&input).unwrap();
    assert back.level matches { None };
    assert grog::encode(&back).to_hex() == input.to_hex();
}

test "proto2 repeated scalars are unpacked unless asked" {
    let record = legacy::Record {
        counts: [1, 2],
        packed_counts: [3, 4],
    };
    assert grog::encode(&record).to_hex() == "200120022a020304";
}

test "a group is delimited by tags" {
    let record = legacy::Record {
        note: Option::Some(legacy::RecordNote { text: Option::Some("n") }),
        tag: [
            legacy::RecordTag { name: Option::Some("a") },
            legacy::RecordTag {},
        ],
    };
    let bytes = grog::encode(&record);
    assert bytes.to_hex() == "333a016e34434a0161444344";
    assert grog::decode::<legacy::Record>(&bytes).unwrap() == record;
}

test "onnx.proto round-trips a model" {
    let model = onnx::ModelProto {
        ir_version: Option::Some(10),
        producer_name: Option::Some("grog"),
        graph: Option::Some(onnx::GraphProto {
            name: Option::Some("g"),
            node: [
                onnx::NodeProto {
                    op_type: Option::Some("Relu"),
                    input: ["x"],
                    output: ["y"],
                },
            ],
            initializer: [
                onnx::TensorProto {
                    dims: [2],
                    data_type: Option::Some(1),
                    float_data: [1.0, -2.0],
                },
            ],
        }),
    };
    assert grog::decode::<onnx::ModelProto>(&grog::encode(&model)).unwrap() == model;
}

test "descriptor.proto describes itself" {
    let file = descriptor::FileDescriptorProto {
        name: Option::Some("demo.proto"),
        package: Option::Some("demo"),
        message_type: [
            descriptor::DescriptorProto {
                name: Option::Some("Point"),
                field: [
                    descriptor::FieldDescriptorProto {
                        name: Option::Some("x"),
                        number: Option::Some(1),
                        label: Option::Some(descriptor::FieldDescriptorProtoLabel::Optional),
                        type: Option::Some(descriptor::FieldDescriptorProtoType::Sint32),
                    },
                ],
            },
        ],
        syntax: Option::Some("proto3"),
    };
    assert grog::decode::<descriptor::FileDescriptorProto>(&grog::encode(&file)).unwrap() == file;
}

test "struct.proto nests values through a map and a oneof" {
    let mut fields = TreeMap::<String, pbstruct::Value>::new();
    fields["n"] = pbstruct::Value { kind: Option::Some(pbstruct::ValueKind::NumberValue(1.5)) };
    let value = pbstruct::Value {
        kind: Option::Some(pbstruct::ValueKind::ListValue(pbstruct::ListValue {
            values: [
                pbstruct::Value { kind: Option::Some(pbstruct::ValueKind::NullValue(pbstruct::NullValue::NullValue)) },
                pbstruct::Value { kind: Option::Some(pbstruct::ValueKind::StructValue(pbstruct::Struct { fields })) },
            ],
        })),
    };
    assert grog::decode::<pbstruct::Value>(&grog::encode(&value)).unwrap() == value;
}

/// `depth` lists, each holding the next, as `Value`s.
fn nested_lists(depth: i32) -> ByteList {
    let mut value = pbstruct::Value {};
    for let _ of 0..<depth {
        value = pbstruct::Value { kind: Option::Some(pbstruct::ValueKind::ListValue(pbstruct::ListValue {
            values: [value],
        })) };
    }
    return grog::encode(&value);
}

test "a oneof message member read again merges in place" {
    // `Value.list_value`, one element each time: copying the held list on
    // every read would make this quadratic.
    let k = 50000;
    let mut input: ByteList = b"";
    for let _ of 0..<k {
        input.extend(&b"\x32\x04\x0a\x02\x08\x00");
    }
    let back = grog::decode::<pbstruct::Value>(&input).unwrap();
    let Some(pbstruct::ValueKind::ListValue(list)) = back.kind else {
        panic("the last member read is the list");
    };
    assert list.values.len() == k;
}

test "an open enum is equal by its number" {
    assert Status::Unrecognized(1) == Status::Active;
    assert Status::Unrecognized(7) != Status::Active;
    assert Status::Unrecognized(-1) < Status::Unspecified && Status::Retired < Status::Unrecognized(3);
    assert grog::decode::<Account>(&grog::encode(&Account { status: Status::Unrecognized(1) })).unwrap() == Account {
        status: Status::Active,
    };
}

test "an open enum's zero is left off the wire however it is spelled" {
    assert grog::encode(&Account { status: Status::Unrecognized(0) }).len() == 0;
}

test "nesting past the depth limit is refused" {
    assert grog::decode::<pbstruct::Value>(&nested_lists(40)) matches { Ok(_) };
    assert grog::decode::<pbstruct::Value>(&nested_lists(60)) matches { Err(_) };
}
