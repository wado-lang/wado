// Schemas imported through Grog, encoded and decoded by `core:protobuf`.
use { from_bytes, to_bytes } from "core:protobuf";
use { Account, AccountAddress, AccountLimitsEntry, Status } from "./grog/demo.proto"
    with {
        generator: { module: "../src/generator.wado" },
    };
use descriptor from "../tests/proto/protobuf/src/google/protobuf/descriptor.proto"
    with {
        generator: { module: "../src/generator.wado" },
    };
use pbstruct from "../tests/proto/protobuf/src/google/protobuf/struct.proto"
    with {
        generator: { module: "../src/generator.wado" },
    };
use onnx from "../tests/proto/onnx/onnx/onnx.proto"
    with {
        generator: { module: "../src/generator.wado" },
    };

fn hex(bytes: &ByteList) -> String {
    let mut out = "";
    for let b of bytes {
        out.push_str(&`${b:02x}`);
    }
    return out;
}

test "an empty proto3 message is no bytes" {
    assert to_bytes(&Account {}).unwrap().len() == 0;
}

test "implicit fields are written only when set" {
    let bytes = to_bytes(&Account { id: 150, status: Status::Active }).unwrap();
    assert hex(&bytes) == "0896015001";
}

test "every mapping round-trips" {
    let account = Account {
        id: 7,
        name: "Ada",
        balance: Option::Some(0),
        delta: -3,
        checksum: 0xdeadbeef,
        offset: -1,
        ratio: 0.5,
        verified: true,
        avatar: b"\x89PNG",
        status: Status::Retired,
        tags: ["a", "b"],
        limits: [
            AccountLimitsEntry { key: "daily", value: 10 },
        ],
        address: Option::Some(AccountAddress { city: "Kyoto", zip: 6000000 }),
        history: [
            AccountAddress { city: "Osaka" },
        ],
        phone: Option::Some(81),
    };
    let bytes = to_bytes(&account).unwrap();
    let back = from_bytes::<Account>(&bytes).unwrap();
    assert back == account;
}

test "sint32 is zigzag and sfixed32 fixed on the wire" {
    assert hex(&to_bytes(&Account { delta: -3 }).unwrap()) == "2005";
    assert hex(&to_bytes(&Account { offset: -1 }).unwrap()) == "35ffffffff";
}

test "explicit presence writes a zero" {
    assert hex(&to_bytes(&Account { balance: Option::Some(0) }).unwrap()) == "1800";
}

test "an enum value is its number" {
    let back = from_bytes::<Account>(&[0x50, 0x02] as ByteList).unwrap();
    assert back.status == Status::Retired;
}

test "an enum number the schema does not declare is refused" {
    assert from_bytes::<Account>(&[0x50, 0x07] as ByteList) matches { Err(_) };
}

test "onnx.proto round-trips a model" {
    let model = onnx::ModelProto {
        ir_version: Option::Some(10),
        producer_name: Option::Some("grog"),
        graph: Option::Some(onnx::GraphProto {
            name: Option::Some("g"),
            node: [
                onnx::NodeProto {
                    op_type: Option::Some("Relu"),
                    input: ["x"],
                    output: ["y"],
                },
            ],
            initializer: [
                onnx::TensorProto {
                    dims: [2],
                    data_type: Option::Some(1),
                    float_data: [1.0, -2.0],
                },
            ],
        }),
    };
    let back = from_bytes::<onnx::ModelProto>(&to_bytes(&model).unwrap()).unwrap();
    assert back == model;
}

test "descriptor.proto describes itself" {
    let file = descriptor::FileDescriptorProto {
        name: Option::Some("demo.proto"),
        package: Option::Some("demo"),
        message_type: [
            descriptor::DescriptorProto {
                name: Option::Some("Point"),
                field: [
                    descriptor::FieldDescriptorProto {
                        name: Option::Some("x"),
                        number: Option::Some(1),
                        label: Option::Some(descriptor::FieldDescriptorProtoLabel::Optional),
                        type: Option::Some(descriptor::FieldDescriptorProtoType::Sint32),
                    },
                ],
            },
        ],
        syntax: Option::Some("proto3"),
    };
    let bytes = to_bytes(&file).unwrap();
    assert from_bytes::<descriptor::FileDescriptorProto>(&bytes).unwrap() == file;
}

test "struct.proto nests values through a map" {
    let inner = pbstruct::Struct {
        fields: [
            pbstruct::StructFieldsEntry { key: "n", value: Option::Some(pbstruct::Value { number_value: Option::Some(
                1.5,
            ) }) },
        ],
    };
    let value = pbstruct::Value {
        list_value: Option::Some(pbstruct::ListValue {
            values: [
                pbstruct::Value { null_value: Option::Some(pbstruct::NullValue::NullValue) },
                pbstruct::Value { struct_value: Option::Some(inner) },
            ],
        }),
    };
    assert from_bytes::<pbstruct::Value>(&to_bytes(&value).unwrap()).unwrap() == value;
}
