//! A `ProtoFile` as the Wado declarations `core:protobuf` encodes: a struct per
//! message and an enum per enum, each at the top level.

use { TreeMap } from "core:collections";
use { CodeWriter, EnumSpec, FieldSpec, StructSpec, Vis, is_keyword, is_reserved, wado } from "lib:wadopoet";
use { EnumDecl, EnumValue, Features, Field, FieldType, Label, MessageDecl, ProtoFile, Syntax } from "./schema.wado";

pub variant EmitError {
    /// The schema breaks a rule of its own, or names what the file does not declare.
    Invalid(String),
    /// The schema is sound but uses what Grog does not map.
    Unsupported(String),
}

impl Display for EmitError {
    fn fmt(&self, f: &mut Formatter) {
        match self {
            Invalid(m) | Unsupported(m) => f.write_str(m),
        }
    }
}

/// The Wado declarations for `file`, as the text of one module.
pub fn emit(file: &ProtoFile) -> Result<String, EmitError> {
    let mut e = Emitter {
        file,
        names: TreeMap::new(),
        taken: TreeMap::new(),
        features: TreeMap::new(),
    };
    let mut enums: List<EnumPlan> = [];
    for let decl of &file.enums {
        enums.push(e.plan_enum(decl)?);
    }
    for let decl of &file.messages {
        let name = e.claim(&decl.path, decl.line)?;
        e.names[e.full_name(&decl.path)] = Named { name, zero: null };
        e.features[decl.path.join(".")] = decl.features;
    }
    let mut w = CodeWriter::new();
    w.line("// Generated by Grog from a `.proto` schema. Do not edit.");
    for let plan of &enums {
        w.blank();
        plan.write(&mut w);
    }
    for let decl of &file.messages {
        for let spec of e.message(decl)? {
            w.blank();
            spec.emit(&mut w);
        }
    }
    return Result::Ok(w.to_string());
}

/// A declaration's Wado name, and for an enum the case its zero value is.
struct Named {
    name: String,
    zero: Option<String>,
}

struct PlannedCase {
    name: String,
    value: EnumValue,
}

struct EnumPlan {
    name: String,
    cases: List<PlannedCase>,
    /// `[alias, case]`: a second name for a number an earlier case holds.
    aliases: List<[String, String]>,
}

impl EnumPlan {
    fn write(&self, w: &mut CodeWriter) {
        let mut spec = EnumSpec::new(&self.name, Vis::Pub);
        for let c of &self.cases {
            let mut attrs: List<String> = [`wire(number = ${c.value.number})`];
            if c.name != c.value.name {
                attrs.push(wado`wire(name = "${c.value.name}")`);
            }
            spec.add_member_with_attrs(&c.name, attrs);
        }
        spec.emit(w);
        if self.aliases.is_empty() {
            return;
        }
        w.blank();
        w.begin(`impl ${self.name}`);
        for let alias of &self.aliases {
            w.line(`pub const ${alias.0}: ${self.name} = ${self.name}::${alias.1};`);
        }
        w.end();
    }
}

enum Presence {
    Implicit,
    Explicit,
    Required,
}

struct Emitter {
    file: &ProtoFile,
    /// Keyed by the full protobuf name, package included.
    names: TreeMap<String, Named>,
    /// Each Wado name handed out, and the protobuf path it went to.
    taken: TreeMap<String, String>,
    /// Each message's own `features`, keyed by its dotted path.
    features: TreeMap<String, Features>,
}

impl Emitter {
    fn full_name(&self, path: &List<String>) -> String {
        let joined = path.join(".");
        if self.file.package.is_empty() {
            return joined;
        }
        return `${self.file.package}.${joined}`;
    }

    /// The top-level Wado name for a nested declaration, joined from its path.
    fn claim(&mut self, path: &List<String>, line: i32) -> Result<String, EmitError> {
        let mut name = path.join("");
        if is_reserved(&name) {
            name.push_str("_");
        }
        return self.take(name, path.join("."), line);
    }

    fn take(&mut self, name: String, owner: String, line: i32) -> Result<String, EmitError> {
        if let Some(other) = self.taken.get_str(&name) {
            return Result::Err(EmitError::Invalid(
                `${line}: '${owner}' and '${other}' are both named ${name} once flattened`,
            ));
        }
        self.taken[name] = owner;
        return Result::Ok(name);
    }

    fn plan_enum(&mut self, decl: &EnumDecl) -> Result<EnumPlan, EmitError> {
        let name = self.claim(&decl.path, decl.line)?;
        let prefix = `${screaming_snake(&decl.path[decl.path.len() - 1])}_`;
        let mut cases: List<PlannedCase> = [];
        let mut aliases: List<[String, String]> = [];
        for let value of &decl.values {
            let case = case_name(&value.name, &prefix);
            let mut aliased = false;
            for let c of &cases {
                if c.value.number == value.number {
                    if c.name != case {
                        aliases.push([case, c.name]);
                    }
                    aliased = true;
                    break;
                }
                if c.name == case {
                    return Result::Err(
                        EmitError::Invalid(
                            `${decl.line}: ${decl.path.join(".")}: '${c.value.name}' and '${value.name}' are both ${case} in Wado`,
                        ),
                    );
                }
            }
            if !aliased {
                cases.push(PlannedCase { name: case, value: *value });
            }
        }
        let mut zero = &cases[0];
        for let c of &cases {
            if c.value.number == 0 {
                zero = c;
                break;
            }
        }
        self.names[self.full_name(&decl.path)] = Named { name, zero: Option::Some(`${name}::${zero.name}`) };
        return Result::Ok(EnumPlan { name, cases, aliases });
    }

    /// The struct for `decl`, and one per `map` field it declares.
    fn message(&mut self, decl: &MessageDecl) -> Result<List<StructSpec>, EmitError> {
        let name = self.names[self.full_name(&decl.path)].name;
        let mut spec = StructSpec::new(&name, Vis::Pub);
        let mut entries: List<StructSpec> = [];
        let mut field_names: List<String> = [];
        for let field of &decl.fields {
            let mut out = FieldSpec::new_pub(&field.name, "");
            out.attrs.push(`wire(number = ${field.number})`);
            if is_keyword(&field.name) {
                out.name.push_str("_");
                out.attrs.push(wado`wire(name = "${field.name}")`);
            }
            if field_names.contains_str(&out.name) {
                return Result::Err(EmitError::Invalid(
                    `${field.line}: ${decl.path.join(".")} has two fields named ${out.name} in Wado`,
                ));
            }
            field_names.push(out.name);
            if let Map([key, value]) = &field.type_ {
                let entry = self.map_entry(decl, field, key, value)?;
                out.type_str = `List<${entry.name}>`;
                out.default = Option::Some("[]");
                entries.push(entry);
            } else {
                self.map_field(decl, field, &mut out)?;
            }
            spec.add_field_spec(out);
        }
        let mut specs: List<StructSpec> = [spec];
        specs.extend(&entries);
        return Result::Ok(specs);
    }

    fn map_field(&self, decl: &MessageDecl, field: &Field, out: &mut FieldSpec) -> Result<(), EmitError> {
        let [ty, zero] = self.type_of(decl, field, &field.type_, &mut out.attrs)?;
        // A map entry is always length-prefixed, so only a field of its own is checked.
        if zero matches { None } && self.delimited(decl, field) {
            return Result::Err(
                EmitError::Unsupported(
                    `${field.line}: ${field.name}: a DELIMITED message is a group on the wire, which core:protobuf does not read`,
                ),
            );
        }
        if field.label matches { Repeated } {
            out.type_str = `List<${ty}>`;
            out.default = Option::Some("[]");
            return Result::Ok(());
        }
        let mut presence = self.presence(decl, field);
        // A oneof member and a message both have presence whatever the syntax says.
        if field.oneof matches { Some(_) } || zero matches { None } && presence matches { Implicit } {
            presence = Presence::Explicit;
        }
        match presence {
            Implicit => {
                out.type_str = ty;
                out.default = zero;
            },
            Explicit => {
                out.type_str = `Option<${ty}>`;
                out.default = Option::Some("null");
            },
            Required => {
                out.type_str = ty;
            },
        }
        return Result::Ok(());
    }

    /// The struct a `map<K, V>` field's entries decode into: protobuf's own
    /// wire form for a map, a key numbered 1 and a value numbered 2.
    fn map_entry(
        &mut self,
        decl: &MessageDecl,
        field: &Field,
        key: &String,
        value: &FieldType,
    ) -> Result<StructSpec, EmitError> {
        let owner = self.names[self.full_name(&decl.path)].name;
        let name = self.take(`${owner}${pascal(&field.name)}Entry`, `${decl.path.join(".")}.${field.name}`, field.line)?;
        let mut spec = StructSpec::new(&name, Vis::Pub);
        let mut key_field = FieldSpec::new_pub("key", "");
        key_field.attrs.push("wire(number = 1)");
        let [key_ty, key_zero] = self.type_of(decl, field, &FieldType::Scalar(*key), &mut key_field.attrs)?;
        key_field.type_str = key_ty;
        key_field.default = key_zero;
        let mut value_field = FieldSpec::new_pub("value", "");
        value_field.attrs.push("wire(number = 2)");
        let [value_ty, value_zero] = self.type_of(decl, field, value, &mut value_field.attrs)?;
        if value_zero matches { None } {
            value_field.type_str = `Option<${value_ty}>`;
            value_field.default = Option::Some("null");
        } else {
            value_field.type_str = value_ty;
            value_field.default = value_zero;
        }
        spec.add_field_spec(key_field);
        spec.add_field_spec(value_field);
        return Result::Ok(spec);
    }

    /// A field type's Wado spelling and its zero, `None` for a message, which
    /// has no zero to omit. An encoding the type needs lands in `attrs`.
    fn type_of(
        &self,
        decl: &MessageDecl,
        field: &Field,
        ty: &FieldType,
        attrs: &mut List<String>,
    ) -> Result<[String, Option<String>], EmitError> {
        match ty {
            Scalar(s) => {
                let [wado_type, zero, encoding] = scalar(s);
                if let Some(e) = encoding {
                    attrs.push(`wire(encoding = "${e}")`);
                }
                return Result::Ok([wado_type, Option::Some(zero)]);
            },
            Named(n) => {
                let Some(named) = self.resolve(n, decl) else {
                    return Result::Err(
                        EmitError::Invalid(
                            `${field.line}: ${field.name}: no message or enum named '${n}' is declared in this file, and Grog reads no import`,
                        ),
                    );
                };
                return Result::Ok([named.name, named.zero]);
            },
            Group(g) => {
                return Result::Err(EmitError::Unsupported(
                    `${field.line}: group ${g}: a group is not read by core:protobuf`,
                ));
            },
            Map(_) => {
                return Result::Err(EmitError::Invalid(`${field.line}: ${field.name}: a map's value cannot be a map`));
            },
        }
    }

    /// Protobuf's scoping: a relative name is looked up in the innermost
    /// enclosing scope first, out to the root; a leading `.` starts at the root.
    fn resolve(&self, name: &String, decl: &MessageDecl) -> Option<Named> {
        if name.starts_with(".") {
            return self.names.get_str(name.as_str_slice().slice(1, name.len()));
        }
        let mut scope: List<String> = [];
        if !self.file.package.is_empty() {
            for let part of self.file.package.split(".") {
                scope.push(part.to_string());
            }
        }
        scope.extend(&decl.path);
        for let mut depth = scope.len(); depth >= 0; depth -= 1 {
            let prefix = scope.as_slice().slice(0, depth).to_list().join(".");
            let candidate = if prefix.is_empty() { *name } else { `${prefix}.${name}` };
            if let Some(found) = self.names.get_str(&candidate) {
                return Option::Some(found);
            }
        }
        return null;
    }

    fn presence(&self, decl: &MessageDecl, field: &Field) -> Presence {
        match &self.file.syntax {
            Proto2 => {
                return if field.label matches { Required } { Presence::Required } else { Presence::Explicit };
            },
            Proto3 => {
                return if field.label matches { Optional } { Presence::Explicit } else { Presence::Implicit };
            },
            Edition(_) => {
                return match self.feature(decl, field, |f| f.field_presence) {
                    Some(p) && p == "IMPLICIT" => Presence::Implicit,
                    Some(p) && p == "LEGACY_REQUIRED" => Presence::Required,
                    _ => Presence::Explicit,
                };
            },
        }
    }

    fn delimited(&self, decl: &MessageDecl, field: &Field) -> bool {
        return self.file.syntax matches { Edition(_) }
            && self.feature(decl, field, |f| f.message_encoding) matches { Some(e) && e == "DELIMITED" };
    }

    /// A feature as editions resolve it: the field's setting, else the
    /// innermost enclosing message's, else the file's. `None` is the edition's default.
    fn feature(&self, decl: &MessageDecl, field: &Field, pick: fn(&Features) -> Option<String>) -> Option<String> {
        if let Some(v) = pick(&field.features) {
            return Option::Some(v);
        }
        for let mut depth = decl.path.len(); depth > 0; depth -= 1 {
            let key = decl.path.as_slice().slice(0, depth).to_list().join(".");
            if let Some(f) = self.features.get_str(&key) {
                if let Some(v) = pick(&f) {
                    return Option::Some(v);
                }
            }
        }
        return pick(&self.file.features);
    }
}

/// A scalar's Wado type, its zero, and the encoding it needs beyond the
/// varint or length prefix its Wado type implies.
fn scalar(name: &String) -> [String, String, Option<String>] {
    return match name.as_str_slice() {
        "double" => ["f64", "0.0", null],
        "float" => ["f32", "0.0", null],
        "int32" => ["i32", "0", null],
        "int64" => ["i64", "0", null],
        "uint32" => ["u32", "0", null],
        "uint64" => ["u64", "0", null],
        "sint32" => ["i32", "0", Option::Some("zigzag")],
        "sint64" => ["i64", "0", Option::Some("zigzag")],
        "fixed32" => ["u32", "0", Option::Some("fixed")],
        "fixed64" => ["u64", "0", Option::Some("fixed")],
        "sfixed32" => ["i32", "0", Option::Some("fixed")],
        "sfixed64" => ["i64", "0", Option::Some("fixed")],
        "bool" => ["bool", "false", null],
        "string" => ["String", "\"\"", null],
        _ => ["ByteList", "b\"\"", null],
    };
}

/// `FieldPresence` as `FIELD_PRESENCE`, the prefix protobuf's style guide puts
/// on each of an enum's values.
fn screaming_snake(name: &String) -> String {
    let mut out = "";
    let mut previous = ' ';
    for let c of name.chars() {
        if c.is_ascii_uppercase() && (previous.is_ascii_lowercase() || previous.is_ascii_digit()) {
            out.push('_');
        }
        out.push(c.to_ascii_uppercase());
        previous = c;
    }
    return out;
}

/// An enum value's case name: its enum's prefix dropped, the rest PascalCased.
fn case_name(value: &String, prefix: &String) -> String {
    let mut rest = *value;
    if value.starts_with(prefix) && value.len() > prefix.len() {
        let tail = value.as_str_slice().slice(prefix.len(), value.len()).to_string();
        if !tail.chars().next().unwrap().is_ascii_digit() {
            rest = tail;
        }
    }
    let mut name = pascal(&rest);
    if name.is_empty() || name.chars().next().unwrap().is_ascii_digit() {
        name = `N${name}`;
    }
    if is_keyword(&name) {
        name.push_str("_");
    }
    return name;
}

/// `TYPE_DOUBLE` as `TypeDouble`, `field_name` as `FieldName`. A part already
/// in mixed case keeps it.
fn pascal(name: &String) -> String {
    let mut out = "";
    let mut previous = ' ';
    for let part of name.split("_") {
        let text = part.to_string();
        let mixed = text.chars().any(|c| c.is_ascii_lowercase()) && text.chars().any(|c| c.is_ascii_uppercase());
        let mut first = true;
        for let c of text.chars() {
            // `2017_11_3` keeps its separators, or it would read as `2017_1_13`.
            if first && previous.is_ascii_digit() && c.is_ascii_digit() {
                out.push('_');
            }
            let next = if first {
                c.to_ascii_uppercase();
            } else if mixed {
                c;
            } else {
                c.to_ascii_lowercase();
            };
            out.push(next);
            previous = next;
            first = false;
        }
    }
    return out;
}
