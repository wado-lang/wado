//! A `ProtoFile` as Wado: a struct per message, an enum per enum, and the
//! `Message` and `Enumeration` impls through which Grog's runtime encodes them.

use { TreeMap } from "core:collections";
use { apply_case } from "core:serde";
use { CodeWriter, EnumSpec, FieldSpec, StructSpec, VariantSpec, Vis, is_keyword, is_reserved } from "lib:wadopoet";
use { FIELD_NUMBER_MAX } from "./lib.wado";
use { is_scalar } from "./parse.wado";
use { EnumDecl, EnumValue, Features, Field, FieldType, Label, MessageDecl, ProtoFile, Syntax } from "./schema.wado";

pub variant EmitError {
    /// The schema breaks a rule of its own, or names what the file does not declare.
    Invalid(String),
    /// Grog cannot serve the request as made.
    Unsupported(String),
}

impl Display for EmitError {
    fn fmt(&self, f: &mut Formatter) {
        match self {
            Invalid(m) | Unsupported(m) => f.write_str(m),
        }
    }
}

/// What the generated module calls Grog's runtime.
global RUNTIME: String = "grog";

/// The name each message keeps the fields its schema does not declare under.
global UNKNOWN_FIELDS: String = "unknown_fields";

/// The Wado module for `file`. It imports Grog's runtime from `runtime`, the
/// package `[dependencies]` names it under.
pub fn emit(file: &ProtoFile, runtime: String) -> Result<String, EmitError> {
    let mut e = Emitter {
        file,
        names: TreeMap::new(),
        taken: TreeMap::new(),
        features: TreeMap::new(),
        uses_map: false,
    };
    for let decl of &file.messages {
        e.features[decl.path.join(".")] = decl.features;
    }
    let mut enums: List<EnumPlan> = [];
    for let decl of &file.enums {
        enums.push(e.plan_enum(decl)?);
    }
    for let decl of &file.messages {
        let name = e.claim(&decl.path, decl.line)?;
        e.names[e.full_name(&decl.path)] = Named { name, kind: Kind::Message };
    }
    let mut messages: List<MessagePlan> = [];
    for let decl of &file.messages {
        messages.push(e.plan_message(decl)?);
    }
    let mut w = CodeWriter::new();
    w.line("// Generated by Grog from a `.proto` schema. Do not edit.");
    w.blank();
    if e.uses_map {
        w.line("use { TreeMap } from \"core:collections\";");
    }
    w.line(`use ${RUNTIME} from "${runtime}";`);
    for let plan of &enums {
        w.blank();
        plan.write(&mut w);
    }
    for let plan of &messages {
        w.blank();
        plan.write(&mut w);
    }
    return Result::Ok(w.to_string());
}

variant Kind {
    Message,
    /// An enum, and the case an unset field of it reads as.
    Enum(String),
}

/// A declaration's Wado name.
struct Named {
    name: String,
    kind: Kind,
}

struct PlannedCase {
    name: String,
    number: i32,
}

struct EnumPlan {
    name: String,
    cases: List<PlannedCase>,
    /// `[alias, case]`: a second name for a number an earlier case holds.
    aliases: List<[String, String]>,
    /// The case an open enum holds a number it does not declare in.
    unrecognized: Option<String>,
}

impl EnumPlan {
    fn write(&self, w: &mut CodeWriter) {
        if let Some(other) = &self.unrecognized {
            let mut spec = VariantSpec::new(&self.name, Vis::Pub);
            for let c of &self.cases {
                spec.add_case(&c.name);
            }
            spec.add_case_with_payload(other, "i32");
            spec.emit(w);
        } else {
            let mut spec = EnumSpec::new(&self.name, Vis::Pub);
            for let c of &self.cases {
                spec.add_member(&c.name);
            }
            spec.emit(w);
        }
        if !self.aliases.is_empty() {
            w.blank();
            w.begin(`impl ${self.name}`);
            for let alias of &self.aliases {
                w.line(`pub const ${alias.0}: ${self.name} = ${self.name}::${alias.1};`);
            }
            w.end();
        }
        w.blank();
        w.begin(`impl ${RUNTIME}::Enumeration for ${self.name}`);
        w.begin("fn number(&self) -> i32");
        w.begin("return match self");
        for let c of &self.cases {
            w.line(`${self.name}::${c.name} => ${c.number},`);
        }
        if let Some(other) = &self.unrecognized {
            w.line(`${self.name}::${other}(n) => *n,`);
        }
        w.end_with(";");
        w.end();
        w.blank();
        w.begin(`fn from_number(number: i32) -> Option<${self.name}>`);
        for let c of &self.cases {
            w.begin(`if number == ${c.number}`);
            w.line(`return Option::Some(${self.name}::${c.name});`);
            w.end();
        }
        if let Some(other) = &self.unrecognized {
            w.line(`return Option::Some(${self.name}::${other}(number));`);
        } else {
            w.line("return null;");
        }
        w.end();
        w.blank();
        w.begin(`fn first() -> ${self.name}`);
        w.line(`return ${self.name}::${self.cases[0].name};`);
        w.end();
        w.end();
    }
}

/// How a field's value is written, and what the generated code reads it with.
struct Access {
    number: i32,
    /// The Sizer and Writer method.
    put: String,
    take: Take,
    /// The turbofish every call names, or `""`.
    types: String,
}

/// How `merge_field` reads a field.
variant Take {
    /// A Reader method that merges into the field in place.
    Into(String),
    /// One scalar, stored as the expression this holds, which reads it as `v`.
    Stored(String),
}

/// One member of a `oneof`: its case, and how its value sits on the wire.
struct Member {
    case: String,
    payload: String,
    number: i32,
    /// The runtime method for one value, `scalar`, `message` or `group`, on every pass.
    put: String,
    types: String,
    /// A message case's fresh value, which a read merges into unless the case
    /// already holds one. `None` for a scalar, which a read replaces.
    fresh: Option<String>,
}

variant Slot {
    Field([String, Access]),
    /// The field the `oneof` is stored in, its variant, and its members.
    Oneof([String, String, List<Member>]),
}

impl Slot {
    fn number(&self) -> i32 {
        return match self {
            Field([_, a]) => a.number,
            Oneof([_, _, members]) => members[0].number,
        };
    }
}

struct MessagePlan {
    spec: StructSpec,
    oneofs: List<VariantSpec>,
    slots: List<Slot>,
}

impl MessagePlan {
    /// One runtime call per field, each prefixed by `call`: the size or the write pass.
    fn calls(&self, w: &mut CodeWriter, call: String) {
        for let slot of &self.slots {
            match slot {
                Field([field, a]) => w.line(`${call}${a.put}${a.types}(${a.number}, &self.${field});`),
                Oneof([field, sum, members]) => {
                    w.begin(`if let Some(c) = &self.${field}`);
                    w.begin("match c");
                    for let m of members {
                        w.line(`${sum}::${m.case}(v) => ${call}${m.put}${m.types}(${m.number}, v),`);
                    }
                    w.end();
                    w.end();
                },
            }
        }
    }

    fn write(&self, w: &mut CodeWriter) {
        self.spec.emit(w);
        for let v of &self.oneofs {
            w.blank();
            v.emit(w);
        }
        let name = &self.spec.name;
        w.blank();
        w.begin(`impl ${RUNTIME}::Message for ${name}`);
        w.begin(`fn size(&self, s: &mut ${RUNTIME}::Sizer) -> i32`);
        w.line(`let mut n = self.${UNKNOWN_FIELDS}.len();`);
        self.calls(w, "n += s.");
        w.line("return n;");
        w.end();
        w.blank();
        w.begin(`fn write(&self, w: &mut ${RUNTIME}::Writer)`);
        self.calls(w, "w.");
        w.line(`w.raw(&self.${UNKNOWN_FIELDS});`);
        w.end();
        w.blank();
        w.begin(
            `fn merge_field(&mut self, number: i32, r: &mut ${RUNTIME}::Reader) -> Result<bool, ${RUNTIME}::DecodeError>`,
        );
        if !self.slots.is_empty() {
            w.begin("match number");
            for let slot of &self.slots {
                match slot {
                    Field([field, a]) => {
                        match &a.take {
                            Into(method) => {
                                w.line(`${a.number} => return r.${method}${a.types}(&mut self.${field}),`);
                            },
                            Stored(value) => write_stored_merge(w, a.number, &a.types, field, value),
                        }
                    },
                    Oneof([field, sum, members]) => {
                        for let m of members {
                            write_member_merge(w, field, sum, m);
                        }
                    },
                }
            }
            w.line("_ => {},");
            w.end();
        }
        w.line("return Result::Ok(false);");
        w.end();
        w.blank();
        w.begin("fn unknown_fields(&mut self) -> &mut ByteList");
        w.line(`return &mut self.${UNKNOWN_FIELDS};`);
        w.end();
        w.end();
    }
}

/// A scalar's arm: read one value and store `value`, which holds it as `v`.
fn write_stored_merge(w: &mut CodeWriter, number: i32, types: &String, field: &String, value: &String) {
    w.begin(`${number} =>`);
    w.begin(`let Some(v) = r.scalar${types}()? else`);
    w.line("return Result::Ok(false);");
    w.end_with(";");
    w.line(`self.${field} = ${value};`);
    w.line("return Result::Ok(true);");
    w.end_with(",");
}

/// A oneof member's arm: a scalar replaces the case, a message merges into the
/// one the case holds.
fn write_member_merge(w: &mut CodeWriter, field: &String, sum: &String, m: &Member) {
    let Some(fresh) = &m.fresh else {
        write_stored_merge(w, m.number, &m.types, field, &`Option::Some(${sum}::${m.case}(v))`);
        return;
    };
    w.begin(`${m.number} =>`);
    w.begin(`let mut v = match self.${field}`);
    w.line(`Some(${sum}::${m.case}(held)) => held,`);
    w.line(`_ => ${fresh},`);
    w.end_with(";");
    w.begin(`if !r.${m.put}(&mut v)?`);
    w.line("return Result::Ok(false);");
    w.end();
    w.line(`self.${field} = Option::Some(${sum}::${m.case}(v));`);
    w.line("return Result::Ok(true);");
    w.end_with(",");
}

enum Presence {
    Implicit,
    Explicit,
}

/// A field type as Wado spells it and as the runtime reads it.
variant Resolved {
    /// The Wado type, the runtime's `Scalar` for it, and its zero.
    Scalar([String, String, String]),
    /// A message, and whether it sits on the wire as a group.
    Message([String, bool]),
}

struct Emitter {
    file: &ProtoFile,
    /// Keyed by the full protobuf name, package included.
    names: TreeMap<String, Named>,
    /// Each Wado name handed out, and the protobuf path it went to.
    taken: TreeMap<String, String>,
    /// Each message's own `features`, keyed by its dotted path.
    features: TreeMap<String, Features>,
    uses_map: bool,
}

impl Emitter {
    fn full_name(&self, path: &List<String>) -> String {
        let joined = path.join(".");
        if self.file.package.is_empty() {
            return joined;
        }
        return `${self.file.package}.${joined}`;
    }

    /// The top-level Wado name for a nested declaration, joined from its path.
    fn claim(&mut self, path: &List<String>, line: i32) -> Result<String, EmitError> {
        return self.take(path.join(""), path.join("."), line);
    }

    fn take(&mut self, name: String, owner: String, line: i32) -> Result<String, EmitError> {
        let name = type_name_of(name);
        if let Some(other) = self.taken.get_str(&name) {
            return Result::Err(EmitError::Invalid(
                `${line}: '${owner}' and '${other}' are both named ${name} once flattened`,
            ));
        }
        self.taken[name] = owner;
        return Result::Ok(name);
    }

    fn plan_enum(&mut self, decl: &EnumDecl) -> Result<EnumPlan, EmitError> {
        let name = self.claim(&decl.path, decl.line)?;
        let prefix = `${apply_case(CaseStyle::ScreamingSnake, &decl.path[decl.path.len() - 1])}_`;
        let mut cases: List<PlannedCase> = [];
        let mut aliases: List<[String, String]> = [];
        let mut named_by = TreeMap::<String, String>::new();
        if decl.values.is_empty() {
            return Result::Err(EmitError::Invalid(`${decl.line}: ${decl.path.join(".")} declares no value`));
        }
        for let value of &decl.values {
            let case = case_name(&value.name, &prefix);
            let aliased = cases.into_iter().find(|c| c.number == value.number);
            if let Some(other) = named_by.get_str(&case) {
                if aliased matches { Some(c) && c.name == case } {
                    continue;
                }
                return Result::Err(
                    EmitError::Invalid(
                        `${decl.line}: ${decl.path.join(".")}: '${other}' and '${value.name}' are both ${case} in Wado`,
                    ),
                );
            }
            named_by[case] = value.name;
            match aliased {
                Some(c) => aliases.push([case, c.name]),
                None => cases.push(PlannedCase { name: case, number: value.number }),
            }
        }
        let mut unrecognized: Option<String> = null;
        if self.enum_is_open(decl) {
            let mut other = "Unrecognized";
            while named_by.contains_key_str(&other) {
                other.push_str("_");
            }
            unrecognized = Option::Some(other);
        }
        // Protobuf defaults an enum to its first value, which proto3 and open enums require to be 0.
        self.names[self.full_name(&decl.path)] = Named { name, kind: Kind::Enum(`${name}::${cases[0].name}`) };
        return Result::Ok(EnumPlan { name, cases, aliases, unrecognized });
    }

    fn enum_is_open(&self, decl: &EnumDecl) -> bool {
        return match &self.file.syntax {
            Proto2 => false,
            Proto3 => true,
            Edition(_) => !self.inherited(&decl.features, &decl.path, |f| f.enum_type) matches { Some(t) && t == "CLOSED" },
        };
    }

    fn plan_message(&mut self, decl: &MessageDecl) -> Result<MessagePlan, EmitError> {
        let name = self.names[self.full_name(&decl.path)].name;
        let mut spec = StructSpec::new(&name, Vis::Pub);
        let mut slots: List<Slot> = [];
        let mut field_names: List<String> = [UNKNOWN_FIELDS];
        // Each oneof in the order its first member appears: its field, its variant, its members.
        let mut oneofs: List<[String, String, List<Member>]> = [];
        let mut numbered: List<[i32, String]> = [];
        for let field of &decl.fields {
            let n = field.number;
            if !is_assignable_field_number(n) {
                return Result::Err(EmitError::Invalid(
                    `${field.line}: ${field.name}: ${n} is not a field number the wire format admits`,
                ));
            }
            for let [number, other] of &numbered {
                if *number == n {
                    return Result::Err(EmitError::Invalid(
                        `${field.line}: ${decl.path.join(".")}: ${other} and ${field.name} are both field ${n}`,
                    ));
                }
            }
            numbered.push([n, field.name]);
            if let Some(oneof) = &field.oneof {
                let wado_name = field_name_of(oneof);
                let at = match oneofs.into_iter().position(|o| o.0 == wado_name) {
                    Some(at) => at,
                    None => {
                        field_names.push(field_name(oneof, &field_names, decl, field)?);
                        let sum = self.take(`${name}${pascal(oneof)}`, `${decl.path.join(".")}.${oneof}`, field.line)?;
                        let mut out = FieldSpec::new_pub(&wado_name, &`Option<${sum}>`);
                        out.default = Option::Some("null");
                        spec.add_field_spec(out);
                        oneofs.push([wado_name, sum, []]);
                        oneofs.len() - 1;
                    },
                };
                let member = self.plan_member(decl, field, &oneofs[at].2)?;
                oneofs[at].2.push(member);
                continue;
            }
            let wado_name = field_name(&field.name, &field_names, decl, field)?;
            field_names.push(wado_name);
            let [type_str, default, wire] = self.plan_field(decl, field)?;
            let mut out = FieldSpec::new_pub(&wado_name, &type_str);
            out.default = Option::Some(default);
            spec.add_field_spec(out);
            slots.push(Slot::Field([wado_name, wire]));
        }
        let mut unknown = FieldSpec::new_pub(UNKNOWN_FIELDS, "ByteList");
        unknown.default = Option::Some("b\"\"");
        spec.add_field_spec(unknown);
        let mut variants: List<VariantSpec> = [];
        for let [field, sum, members] of oneofs {
            let mut v = VariantSpec::new(&sum, Vis::Pub);
            for let m of &members {
                v.add_case_with_payload(&m.case, &m.payload);
            }
            variants.push(v);
            slots.push(Slot::Oneof([field, sum, members]));
        }
        slots.sort_by(|a, b| a.number().cmp(&b.number()));
        return Result::Ok(MessagePlan { spec, oneofs: variants, slots });
    }

    /// A field outside any `oneof`: its Wado type, its default, and its access.
    fn plan_field(&mut self, decl: &MessageDecl, field: &Field) -> Result<[String, String, Access], EmitError> {
        let n = field.number;
        if let Map([key, value]) = &field.type_ {
            return self.plan_map(decl, field, key, value);
        }
        let resolved = self.resolve_type(decl, field, &field.type_)?;
        if field.label matches { Repeated } {
            return match resolved {
                Scalar([wado, runtime, _]) => {
                    let put = if self.packed(decl, field) { "packed" } else { "repeated" };
                    Result::Ok([`List<${wado}>`, "[]", access(n, put, Take::Into("repeated"), `::<${runtime}>`)]);
                },
                Message([wado, group]) => {
                    let put = if group { "groups" } else { "messages" };
                    Result::Ok([`List<${wado}>`, "[]", access(n, put, Take::Into(put), "")]);
                },
            };
        }
        return match resolved {
            Scalar([wado, runtime, zero]) => {
                match self.presence(decl, field) {
                    Implicit => Result::Ok([wado, zero, access(n, "implicit", Take::Stored("v"), `::<${runtime}>`)]),
                    Explicit => {
                        let optional = access(n, "optional", Take::Stored("Option::Some(v)"), `::<${runtime}>`);
                        Result::Ok([`Option<${wado}>`, "null", optional]);
                    },
                }
            },
            Message([wado, group]) => {
                let put = if group { "optional_group" } else { "optional_message" };
                Result::Ok([`Option<${wado}>`, "null", access(n, put, Take::Into(put), "")]);
            },
        };
    }

    /// A `map<K, V>` field, which the wire holds as one entry message per key.
    fn plan_map(
        &mut self,
        decl: &MessageDecl,
        field: &Field,
        key: &String,
        value: &FieldType,
    ) -> Result<[String, String, Access], EmitError> {
        if !is_map_key(key) {
            return Result::Err(EmitError::Invalid(`${field.line}: ${field.name}: a map key cannot be ${key}`));
        }
        self.uses_map = true;
        let [key_wado, key_runtime, _] = scalar(key);
        let [wado, put, types] = match self.resolve_type(decl, field, value)? {
            Scalar([wado, runtime, _]) => [wado, "map", `::<${key_runtime}, ${runtime}, ${key_wado}, ${wado}>`],
            // An entry's value is length-prefixed whatever the message's encoding.
            Message([wado, _]) => [wado, "message_map", `::<${key_runtime}, ${key_wado}, ${wado}>`],
        };
        let map = `TreeMap<${key_wado}, ${wado}>`;
        return Result::Ok([map, "TreeMap::new()", access(field.number, put, Take::Into(put), types)]);
    }

    /// A `oneof` member: its case, and how its value sits on the wire.
    fn plan_member(&self, decl: &MessageDecl, field: &Field, others: &List<Member>) -> Result<Member, EmitError> {
        let case = case_name(&field.name, &"");
        if others.into_iter().any(|m| m.case == case) {
            return Result::Err(EmitError::Invalid(
                `${field.line}: ${decl.path.join(".")} has two oneof members named ${case} in Wado`,
            ));
        }
        return match self.resolve_type(decl, field, &field.type_)? {
            Scalar([wado, runtime, _]) => Result::Ok(Member {
                case,
                payload: wado,
                number: field.number,
                put: "scalar",
                types: `::<${runtime}>`,
                fresh: null,
            }),
            Message([wado, group]) => Result::Ok(Member {
                case,
                payload: wado,
                number: field.number,
                put: if group { "group" } else { "message" },
                types: "",
                fresh: Option::Some(`${wado} {}`),
            }),
        };
    }

    fn resolve_type(&self, decl: &MessageDecl, field: &Field, ty: &FieldType) -> Result<Resolved, EmitError> {
        match ty {
            Scalar(s) => {
                let [wado, runtime, zero] = scalar(s);
                return Result::Ok(Resolved::Scalar([wado, runtime, zero]));
            },
            Named(n) | Group(n) => {
                let Some(named) = self.resolve(n, decl) else {
                    return Result::Err(
                        EmitError::Invalid(
                            `${field.line}: ${field.name}: no message or enum named '${n}' is declared in this file, and Grog reads no import`,
                        ),
                    );
                };
                return match named.kind {
                    Message => Result::Ok(Resolved::Message([
                        named.name, ty matches { Group(_) } || self.delimited(decl, field),
                    ])),
                    Enum(first) => Result::Ok(Resolved::Scalar([named.name, `${RUNTIME}::Enum<${named.name}>`, first])),
                };
            },
            Map(_) => unreachable(),
        }
    }

    /// Protobuf's scoping: a relative name is looked up in the innermost
    /// enclosing scope first, out to the root; a leading `.` starts at the root.
    fn resolve(&self, name: &String, decl: &MessageDecl) -> Option<Named> {
        if let Some(rooted) = name.as_str_slice().strip_prefix(".") {
            return self.names.get_str(rooted);
        }
        let mut scope: List<String> = [];
        if !self.file.package.is_empty() {
            scope = self.file.package.split(".").collect();
        }
        scope.extend(&decl.path);
        for let mut depth = scope.len(); depth >= 0; depth -= 1 {
            let prefix = joined_prefix(&scope, depth);
            let candidate = if prefix.is_empty() { *name } else { `${prefix}.${name}` };
            if let Some(found) = self.names.get_str(&candidate) {
                return Option::Some(found);
            }
        }
        return null;
    }

    /// Whether an unset field is told apart from one set to its zero. A proto2
    /// `required` field has presence too.
    fn presence(&self, decl: &MessageDecl, field: &Field) -> Presence {
        return match &self.file.syntax {
            Proto2 => Presence::Explicit,
            Proto3 => if field.label matches { Optional } { Presence::Explicit } else { Presence::Implicit },
            Edition(_) => match self.feature(decl, field, |f| f.field_presence) {
                Some(p) && p == "IMPLICIT" => Presence::Implicit,
                _ => Presence::Explicit,
            },
        };
    }

    /// Whether a repeated scalar is written as one length-prefixed run.
    fn packed(&self, decl: &MessageDecl, field: &Field) -> bool {
        if field.type_ matches { Scalar(s) && s == "string" || s == "bytes" } {
            return false;
        }
        return match &self.file.syntax {
            Proto2 => field.packed matches { Some(true) },
            Proto3 => !field.packed matches { Some(false) },
            Edition(_) => !self.feature(decl, field, |f| f.repeated_field_encoding) matches { Some(e) && e == "EXPANDED" },
        };
    }

    fn delimited(&self, decl: &MessageDecl, field: &Field) -> bool {
        return self.file.syntax matches { Edition(_) }
            && self.feature(decl, field, |f| f.message_encoding) matches { Some(e) && e == "DELIMITED" };
    }

    /// A feature as editions resolve it for a field.
    fn feature(&self, decl: &MessageDecl, field: &Field, pick: fn(&Features) -> Option<String>) -> Option<String> {
        let mut path = decl.path;
        path.push(field.name);
        return self.inherited(&field.features, &path, pick);
    }

    /// A feature set on a declaration at `path`, else on the innermost enclosing
    /// message, else on the file. `None` is the edition's default.
    fn inherited(&self, own: &Features, path: &List<String>, pick: fn(&Features) -> Option<String>) -> Option<String> {
        if let Some(v) = pick(own) {
            return Option::Some(v);
        }
        for let mut depth = path.len() - 1; depth > 0; depth -= 1 {
            let key = joined_prefix(path, depth);
            if let Some(f) = self.features.get_str(&key) {
                if let Some(v) = pick(&f) {
                    return Option::Some(v);
                }
            }
        }
        return pick(&self.file.features);
    }
}

/// The first `depth` parts of a dotted path, joined.
fn joined_prefix(path: &List<String>, depth: i32) -> String {
    return path.as_slice().slice(0, depth).to_list().join(".");
}

fn access(number: i32, put: String, take: Take, types: String) -> Access {
    return Access { number, put, take, types };
}

/// A field's Wado name: a keyword or the unknown-fields name suffixed, and
/// refused where two fields would share one.
fn field_name(name: &String, taken: &List<String>, decl: &MessageDecl, field: &Field) -> Result<String, EmitError> {
    let wado_name = field_name_of(name);
    if taken.contains_str(&wado_name) {
        return Result::Err(EmitError::Invalid(
            `${field.line}: ${decl.path.join(".")} has two fields named ${wado_name} in Wado`,
        ));
    }
    return Result::Ok(wado_name);
}

/// A generated type's name, suffixed where it would shadow what the module imports.
fn type_name_of(name: String) -> String {
    if is_reserved(&name) || name == RUNTIME || name == "TreeMap" {
        return `${name}_`;
    }
    return name;
}

fn field_name_of(name: &String) -> String {
    let mut out = *name;
    if is_keyword(&out) || out == UNKNOWN_FIELDS {
        out.push_str("_");
    }
    return out;
}

/// The field number range the wire format assigns, less the range protobuf
/// keeps for itself.
fn is_assignable_field_number(n: i32) -> bool {
    return n >= 1 && n <= FIELD_NUMBER_MAX && !(n >= 19000 && n <= 19999);
}

/// A scalar's Wado type, the runtime's `Scalar` for it, and its zero.
fn scalar(name: &String) -> [String, String, String] {
    let [wado, runtime, zero] = match name.as_str_slice() {
        "double" => ["f64", "Double", "0.0"],
        "float" => ["f32", "Float", "0.0"],
        "int32" => ["i32", "Int32", "0"],
        "int64" => ["i64", "Int64", "0"],
        "uint32" => ["u32", "UInt32", "0"],
        "uint64" => ["u64", "UInt64", "0"],
        "sint32" => ["i32", "SInt32", "0"],
        "sint64" => ["i64", "SInt64", "0"],
        "fixed32" => ["u32", "Fixed32", "0"],
        "fixed64" => ["u64", "Fixed64", "0"],
        "sfixed32" => ["i32", "SFixed32", "0"],
        "sfixed64" => ["i64", "SFixed64", "0"],
        "bool" => ["bool", "Bool", "false"],
        "string" => ["String", "Str", "\"\""],
        "bytes" => ["ByteList", "Bytes", "b\"\""],
        _ => unreachable(),
    };
    return [wado, `${RUNTIME}::${runtime}`, zero];
}

/// Any scalar but a float or `bytes`, as protobuf's language guide allows.
fn is_map_key(name: &String) -> bool {
    return match name.as_str_slice() {
        "double" | "float" | "bytes" => false,
        _ => is_scalar(name),
    };
}

/// An enum value's case name: its enum's prefix dropped, the rest PascalCased.
fn case_name(value: &String, prefix: &String) -> String {
    let mut rest = *value;
    if let Some(tail) = value.as_str_slice().strip_prefix(prefix) {
        if tail.chars().next() matches { Some(c) && !c.is_ascii_digit() } {
            rest = tail.to_string();
        }
    }
    let mut name = pascal(&rest);
    if name.is_empty() || name.chars().next().unwrap().is_ascii_digit() {
        name = `N${name}`;
    }
    if is_keyword(&name) {
        name.push_str("_");
    }
    return name;
}

/// `TYPE_DOUBLE` as `TypeDouble`, `field_name` as `FieldName`. A part already
/// in mixed case keeps it.
fn pascal(name: &String) -> String {
    let mut out = "";
    let mut previous = ' ';
    for let part of name.split("_") {
        let mixed = part.chars().any(|c| c.is_ascii_lowercase()) && part.chars().any(|c| c.is_ascii_uppercase());
        let mut first = true;
        for let c of part.chars() {
            // `2017_11_3` keeps its separators, or it would read as `2017_1_13`.
            if first && previous.is_ascii_digit() && c.is_ascii_digit() {
                out.push('_');
            }
            let next = if first {
                c.to_ascii_uppercase();
            } else if mixed {
                c;
            } else {
                c.to_ascii_lowercase();
            };
            out.push(next);
            previous = next;
            first = false;
        }
    }
    return out;
}
