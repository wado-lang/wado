    fn len(v: &i32) -> i32 {
        return varint_len(zigzag_32(*v));
    }

    fn put(w: &mut Writer, v: &i32) {
        w.varint(zigzag_32(*v));
    }

    fn take(r: &mut Reader) -> Result<Option<i32>, DecodeError> {
        return Result::Ok(Option::Some(unzigzag_32(r.varint()?)));
    }
}

