}

impl Scalar for Double {
    type Value = f64;

    fn wire_type() -> WireType {
        return WireType::I64;
    }

    fn zero() -> f64 {
        return 0.0;
    }

    fn is_zero(v: &f64) -> bool {
        return v.to_bits() == 0;
    }

    fn len(v: &f64) -> i32 {
        return 8;
    }

    fn put(w: &mut Writer, v: &f64) {
        w.fixed64(v.to_bits());
    }

    fn take(r: &mut Reader) -> Result<Option<f64>, DecodeError> {
        return Result::Ok(Option::Some(f64::from_bits(r.fixed64()?)));
    }
}

/// `string`, which a Wado `String` holds only as UTF-8, whatever the schema's syntax.
pub struct Str {
}

impl Scalar for Str {
    type Value = String;

    fn wire_type() -> WireType {
        return WireType::Len;
    }

    fn zero() -> String {
        return "";
    }

    fn len(v: &String) -> i32 {
        return varint_len(v.len() as u64) + v.len();
    }

    fn put(w: &mut Writer, v: &String) {
        w.length_delimited(v.as_byte_slice());
    }

    fn take(r: &mut Reader) -> Result<Option<String>, DecodeError> {
        let bytes = r.length_delimited()?;
        let Ok(text) = String::from_utf8_slice(bytes) else {
            return r.fail("a string field is not UTF-8");
        };
        return Result::Ok(Option::Some(text));
    }
}

pub struct Bytes {
}

impl Scalar for Bytes {
    type Value = ByteList;

    fn wire_type() -> WireType {
        return WireType::Len;
    }

    fn zero() -> ByteList {
        return b"";
    }

    fn len(v: &ByteList) -> i32 {
        return varint_len(v.len() as u64) + v.len();
    }

    fn put(w: &mut Writer, v: &ByteList) {
        w.length_delimited(v.as_byte_slice());
    }

    fn take(r: &mut Reader) -> Result<Option<ByteList>, DecodeError> {
        return Result::Ok(Option::Some(r.length_delimited()?.to_list() as ByteList));
    }
}

/// An enum field of type `E`, on the wire as its number.
pub struct Enum<E> {
}

impl<E: Enumeration> Scalar for Enum<E> {
    type Value = E;

    fn wire_type() -> WireType {
        return WireType::Varint;
    }

    fn zero() -> E {
        return E::first();
    }

    fn is_zero(v: &E) -> bool {
        return v.number() == 0;
    }

    fn len(v: &E) -> i32 {
        return varint_len(v.number() as i64 as u64);
    }

    fn put(w: &mut Writer, v: &E) {
        w.varint(v.number() as i64 as u64);
    }

    fn take(r: &mut Reader) -> Result<Option<E>, DecodeError> {
        return Result::Ok(E::from_number(r.varint()? as i32));
    }
}
