pub struct Bool {
}

impl Scalar for Bool {
    type Value = bool;

    fn wire_type() -> WireType {
        return WireType::Varint;
    }

    fn zero() -> bool {
        return false;
    }

    fn len(v: &bool) -> i32 {
        return 1;
    }

    fn put(w: &mut Writer, v: &bool) {
        w.varint(if *v { 1 } else { 0 });
    }

    fn take(r: &mut Reader) -> Result<Option<bool>, DecodeError> {
        return Result::Ok(Option::Some(r.varint()? != 0));
    }
}

pub struct Float {
}

impl Scalar for Float {
    type Value = f32;

    fn wire_type() -> WireType {
        return WireType::I32;
    }

    fn zero() -> f32 {
        return 0.0;
    }

    /// By bits, as protobuf compares: `-0.0` is written.
    fn is_zero(v: &f32) -> bool {
        return v.to_bits() == 0;
    }

    fn len(v: &f32) -> i32 {
        return 4;
    }

    fn put(w: &mut Writer, v: &f32) {
        w.fixed32(v.to_bits());
    }

    fn take(r: &mut Reader) -> Result<Option<f32>, DecodeError> {
        return Result::Ok(Option::Some(f32::from_bits(r.fixed32()?)));
    }
}

