fn zigzag_32(v: i32) -> u64 {
    return (v << 1 ^ v >> 31) as u32 as u64;
}

fn unzigzag_32(v: u64) -> i32 {
    let n = v as u32;
    return (n >> 1) as i32 ^ -((n & 1) as i32);
}

fn zigzag_64(v: i64) -> u64 {
    return (v << 1 ^ v >> 63) as u64;
}

fn unzigzag_64(v: u64) -> i64 {
    return (v >> 1) as i64 ^ -((v & 1) as i64);
}

