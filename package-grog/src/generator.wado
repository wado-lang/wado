//! Kiln generator entry for Grog. Reads a `.proto` schema and emits Wado
//! declarations that Grog's runtime encodes.

use { Request, Response, Error, OutputFile, KilnHost, read_text } from "core:kiln";
use { EmitError, emit } from "./emit.wado";
use { read } from "./parse.wado";

export fn generate(req: Request) -> Result<Response, Error> with KilnHost {
    let path = req.primary.path;
    let source = match read_text(req.primary.content) {
        Ok(text) => text,
        Err(e) => {
            return Result::Err(Error::InvalidSchema(`grog: '${path}' is not UTF-8: ${e}`));
        },
    };
    let runtime = runtime_of(&req.module)?;
    let file = read(&source).map_err(|e| at(&path, EmitError::Invalid(e)))?;
    let generated = emit(&file, runtime).map_err(|e| at(&path, e))?;
    let files: List<OutputFile> = [
        OutputFile {
            path: `${stem(&path)}.wado`,
            content: generated,
            is_entry: true,
        },
    ];
    return Result::Ok(Response { files });
}

/// The package spec the generated code imports the runtime from: the one Grog
/// was invoked under, since the consumer's `[dependencies]` names it the same.
fn runtime_of(module: &String) -> Result<String, Error> {
    let view = module.as_str_slice();
    let Some(colon) = view.find(":") else {
        return Result::Err(Error::Unsupported(
            `grog: invoked by the path ${module}; name it by the package spec its runtime is a dependency under`,
        ));
    };
    let rest = view.slice(colon + 1, view.len());
    let end = rest.find_char(|c| c == '@' || c == '/').map(|i| colon + 1 + i).unwrap_or(view.len());
    return Result::Ok(view.slice(0, end).to_string());
}

/// What the schema is wrong about, said against the file it was read from.
fn at(path: &String, e: EmitError) -> Error {
    return match e {
        Invalid(m) => Error::InvalidSchema(`grog: '${path}':${m}`),
        Unsupported(m) => Error::Unsupported(`grog: '${path}':${m}`),
    };
}

/// `a/b/demo.proto` as `demo`.
fn stem(path: &String) -> String {
    let view = path.as_str_slice();
    let name = view.slice(view.rfind("/").map(|i| i + 1).unwrap_or(0), view.len());
    return name.strip_suffix(".proto").unwrap_or(name).to_string();
}

test "a runtime named by a path is refused, naming the path" {
    let Err(Unsupported(message)) = runtime_of(&"../package-grog") else {
        panic("a path names no package");
    };
    assert message.contains("../package-grog");
}
