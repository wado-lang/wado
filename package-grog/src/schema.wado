//! A `.proto` file as Grog reads it: its declarations, still named as the
//! schema names them, before any Wado name is chosen.

/// Which rules the file is written under: its `syntax` or `edition` statement.
pub variant Syntax {
    Proto2,
    Proto3,
    /// The edition's year as written, `"2023"` for `edition = "2023";`.
    Edition(String),
}

/// A `features.*` setting, where the file, a message or a field writes one.
/// Editions state presence here; the older syntaxes do it with labels.
pub struct Features {
    pub field_presence: Option<String> = null,
    pub message_encoding: Option<String> = null,
    pub repeated_field_encoding: Option<String> = null,
    pub enum_type: Option<String> = null,
}

pub enum Label {
    None,
    Optional,
    Required,
    Repeated,
}

/// A protobuf scalar type, each case named as the runtime type that encodes it.
pub enum ScalarType {
    Double,
    Float,
    Int32,
    Int64,
    UInt32,
    UInt64,
    SInt32,
    SInt64,
    Fixed32,
    Fixed64,
    SFixed32,
    SFixed64,
    Bool,
    Str,
    Bytes,
}

/// The scalar type a `.proto` names, if `name` names one.
pub fn scalar_type(name: &String) -> Option<ScalarType> {
    return match name.as_str_slice() {
        "double" => Option::Some(ScalarType::Double),
        "float" => Option::Some(ScalarType::Float),
        "int32" => Option::Some(ScalarType::Int32),
        "int64" => Option::Some(ScalarType::Int64),
        "uint32" => Option::Some(ScalarType::UInt32),
        "uint64" => Option::Some(ScalarType::UInt64),
        "sint32" => Option::Some(ScalarType::SInt32),
        "sint64" => Option::Some(ScalarType::SInt64),
        "fixed32" => Option::Some(ScalarType::Fixed32),
        "fixed64" => Option::Some(ScalarType::Fixed64),
        "sfixed32" => Option::Some(ScalarType::SFixed32),
        "sfixed64" => Option::Some(ScalarType::SFixed64),
        "bool" => Option::Some(ScalarType::Bool),
        "string" => Option::Some(ScalarType::Str),
        "bytes" => Option::Some(ScalarType::Bytes),
        _ => null,
    };
}

impl ScalarType {
    /// Any scalar but a float or `bytes`, as protobuf's language guide allows.
    pub fn is_map_key(&self) -> bool {
        return match self {
            Double | Float | Bytes => false,
            Int32 | Int64 | UInt32 | UInt64 | SInt32 | SInt64 | Fixed32 | Fixed64 | SFixed32 | SFixed64 | Bool | Str => true,
        };
    }
}

/// What a field holds. A named type is a message or an enum, resolved only
/// once every declaration in the file is known.
pub variant FieldType {
    Scalar(ScalarType),
    Named(String),
    /// `map<K, V>`: the key's type, and the value's.
    Map([ScalarType, FieldType]),
    /// A `group`, whose body is the nested message named here.
    Group(String),
}

pub struct Field {
    pub name: String,
    pub number: i32,
    pub label: Label,
    pub type_: FieldType,
    /// The `oneof` the field belongs to, if any.
    pub oneof: Option<String> = null,
    /// The `packed` option, where the field writes one.
    pub packed: Option<bool> = null,
    pub features: Features = Features {},
    pub line: i32,
}

pub struct EnumValue {
    pub name: String,
    pub number: i32,
}

pub struct EnumDecl {
    /// The names from the file's top level down to this enum.
    pub path: List<String>,
    pub values: List<EnumValue>,
    pub features: Features = Features {},
    pub line: i32,
}

pub struct MessageDecl {
    pub path: List<String>,
    pub fields: List<Field>,
    pub features: Features = Features {},
    pub line: i32,
}

pub struct ProtoFile {
    pub syntax: Syntax,
    pub package: String,
    pub imports: List<String>,
    pub features: Features,
    /// Every message, nested ones included, parents before children.
    pub messages: List<MessageDecl>,
    /// Every enum, nested ones included.
    pub enums: List<EnumDecl>,
}
