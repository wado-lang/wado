//! Standalone HTML demo — and a reference for how to style the highlighter's
//! output.
//!
//! The library ships only the highlight *fragment* (`<span class="...">`);
//! bringing your own page shell is the intended usage. This example is a
//! copy-paste starting point: it highlights a sample, colors the tokens with
//! `gale-highlight`'s `default_theme` via `stylesheet`, and wraps the result in
//! a page whose own chrome (background, container, font) is the `PAGE_CSS`
//! below.
//!
//!     wado run package-gale-highlight-wado/example/standalone.wado > demo.html
//!
//! then open `demo.html` in a browser.

use { print, Stdout } from "core:cli";
use { highlight } from "../src/lib.wado";
use { stylesheet, default_theme } from "lib:gale";

// The page's own chrome — not part of the highlighter. Token colors come from
// the theme (see `run`); this only sets the surrounding page and code block.
global PAGE_CSS: String = "
body { background: #0d1117; margin: 0; padding: 2rem; }
.wado {
    display: block;
    font: 14px/1.6 ui-monospace, SFMono-Regular, Menlo, monospace;
    color: #c9d1d9;
    background: #161b22;
    padding: 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
}
";

// Sample source, exercising comments, keywords, strings, numbers, template
// interpolation, and booleans. A `\"`-escaped double quote keeps this a plain
// string; the backtick template and `${...}` are literal here and highlight as
// real Wado once parsed.
global SAMPLE: String = "// A short tour of Wado tokens
use { println } from \"core:cli\";

struct Point { x: i32, y: i32 }

export fn run() with Stdout {
    let mut p = Point { x: 10, y: 0xFF };
    let name = \"world\";
    let ok = true;
    println(`Hello, ${name}! sum = ${p.x + p.y}`);
    if p.x > 0 { println(\"positive\"); }
}
";

export fn run() with Stdout {
    let theme = default_theme();
    let css = `${PAGE_CSS}${stylesheet(&theme)}`;
    print(`<!doctype html>
<html>
<head><meta charset="utf-8"><title>Wado highlight demo</title><style>${css}</style></head>
<body><pre class="wado">${highlight(SAMPLE)}</pre></body>
</html>
`);
}
