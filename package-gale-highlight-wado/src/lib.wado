//! Syntax highlighter for the Wado language.
//!
//! The parser is generated at build time by Gale from the bundled grammar
//! (`grammar/Wado.g4` + `grammar/Wado.highlights.scm`). `highlight()` renders
//! Wado source to an HTML fragment of `<span class="...">` nodes using the
//! tree-sitter capture vocabulary; pair it with `gale-highlight`'s themes
//! (`document`, `Theme`) for a standalone page.
//!
//!     use { highlight } from "wado-lang:gale-highlight-wado";
//!     let html = highlight(&src);

pub use { parse, highlight, highlight_result, ParseResult, Diagnostic } from "../grammar/Wado.g4"
    with {
        generator: {
            module: "lib:gale",
            inputs: ["../grammar/Wado.highlights.scm"],
        },
    };
