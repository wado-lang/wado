use { parse, highlight } from "./lib.wado";

/// The visible text of a highlight fragment: strip the `<span>` tags and
/// unescape the entities the highlighter emits (`&amp;` last, so an escaped
/// `&` in the source round-trips).
fn visible_text(html: &String) -> String {
    let mut out = String::new();
    let mut in_tag = false;
    for let c of html.chars() {
        if in_tag {
            if c == '>' {
                in_tag = false;
            }
        } else if c == '<' {
            in_tag = true;
        } else {
            out.push(c);
        }
    }
    return out.replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", "\"").replace("&amp;", "&");
}

/// A highlighter must parse the source and reproduce it losslessly: stripping
/// the emitted spans yields exactly the input, so no token is dropped,
/// duplicated, or reordered.
fn assert_highlights(src: &String) {
    assert parse(src).ok(), "parse failed";
    let html = highlight(*src);
    assert visible_text(&html) == *src, "highlighting is not text-preserving";
}

test "highlight template interpolation expression" {
    // An interpolation holds ordinary code, so its names take the classes the
    // code rules give them and nothing more: `n` is bare inside `${}` exactly
    // as it is in the `let` before it.
    let src = "fn f() { let n = 1; let s = `n = ${n}, at ${self.now()}`; }\n";
    assert parse(&src).ok(), "parse failed";
    let html = highlight(src);
    assert html.contains("<span class=\"constant builtin\">self</span>"), "self is a constant";
    assert html.contains("<span class=\"function method\">now</span>"), "interp call -> function method";
    assert !html.contains(">n</span>"), "a bare name is uncoloured inside an interpolation too";
}

test "highlight identifiers the grammar can place" {
    let src = "fn f<T>(p: Point) -> T { return p.x; }\n";
    assert parse(&src).ok(), "parse failed";
    let html = highlight(src);
    assert html.contains("<span class=\"type\">Point</span>"), "type reference -> type";
    assert html.contains("<span class=\"type\">T</span>"), "type parameter -> type";
    assert html.contains("<span class=\"property\">x</span>"), "field access -> property";
    // A plain name stays uncoloured: which kind it is takes name resolution.
    // A `>` never survives inside span content (it escapes to `&gt;`), so this
    // matches only a span whose whole content is `p`.
    assert !html.contains(">p</span>"), "a bare identifier carries no span";
}

test "highlight contextual keyword used as a member name" {
    // `memberName` spells `forward` out as a literal, so without an override it
    // keeps the keyword class the token kind carries by default. The compiler
    // lexes it as a plain identifier here.
    let src = "fn f(h: H) -> i32 { return h.forward; }\n";
    assert parse(&src).ok(), "parse failed";
    let html = highlight(src);
    assert html.contains("<span class=\"property\">forward</span>"), "member -> property";
}

test "highlight template format spec" {
    let src = "fn f() -> String { let x = 1.5; return `v = ${x:0.2}`; }\n";
    assert parse(&src).ok(), "parse failed";
    let html = highlight(src);
    assert html.contains("<span class=\"comment\">0.2</span>"), "format spec muted";
    assert !html.contains(">x</span>"), "the expression before the spec is ordinary code";
}

test "highlight struct literal in interpolation" {
    let src = "struct P { x: i32 }\nfn f() -> String { return `p = ${P { x: 1 }}!`; }\n";
    assert parse(&src).ok(), "parse failed";
    let html = highlight(src);
    assert html.contains("<span class=\"property\">x</span>"), "interp literal field -> property";
    assert !html.contains(">P</span>"), "which kind the struct name is takes name resolution";
}

test "highlight nested template string" {
    assert_highlights(&"fn f() -> String { let n = 1; return `outer ${`inner ${n}`}`; }\n");
}

test "highlight fragment: unterminated fn body keeps interpolation context" {
    let src = "fn f() { let x = 1.5; let s = `v = ${x:0.2}`;\n";
    assert !parse(&src).ok(), "fragment should not parse cleanly";
    let html = highlight(src);
    assert html.contains("<span class=\"comment\">0.2</span>"), "format spec muted in fragment";
    assert html.contains("<span class=\"keyword\">let</span>"), "surrounding code still classified";
    assert visible_text(&html) == src, "fragment highlighting is text-preserving";
}

test "highlight fragment: bare statements keep default classes and text" {
    let src = "let name = 1;\nif name > 0 { return true; }\n";
    let html = highlight(src);
    assert html.contains("<span class=\"keyword\">let</span>"), "keyword highlighted in fragment";
    assert html.contains("<span class=\"constant builtin\">true</span>"), "constant highlighted in fragment";
    assert visible_text(&html) == src, "bare-statement fragment is text-preserving";
}

test "highlight fragment: bare statement recovers interpolation context" {
    let src = "let name = 1;\nlet s = `hi ${name} ${name:0.2}`;\n";
    let html = highlight(src);
    assert !parse(&src).ok(), "fragment should not parse cleanly";
    assert html.contains("<span class=\"comment\">0.2</span>"), "format spec muted in bare fragment";
    assert html.contains("<span class=\"keyword\">let</span>"), "surrounding keyword still highlighted";
    assert !html.contains(">name</span>"), "interp id uncoloured in a fragment, as outside one";
    assert visible_text(&html) == src, "bare-statement fragment is text-preserving";
}

test "highlight fragment: bare expression recovers interpolation context" {
    let src = "`hi ${name}` + compute(1, 2)\n";
    let html = highlight(src);
    // `${` spans on its own only once the interpolation is recognised: an
    // unrecovered fragment swallows the whole `${name}` as template text.
    assert html.contains("<span class=\"string\">${</span>"), "interpolation opened, not text";
    assert !html.contains(">name</span>"), "interp id uncoloured in a bare expression";
    assert visible_text(&html) == src, "bare-expression fragment is text-preserving";
}

test "highlight __DATA__ section" {
    let src = "fn f() { }\n\n__DATA__\ndata body\n";
    let html = highlight(src);
    assert html.contains("<span class=\"comment\">__DATA__"), "data section highlighted";
}

test "highlight flags declaration" {
    assert_highlights(&"pub flags Perms { Read, Write }\n");
}

test "highlight unit value and type" {
    assert_highlights(&"struct S { u: () }\nfn f() -> () { let t = [1, ()]; return (); }\n");
}

test "highlight labeled block" {
    assert_highlights(&"fn f() { scope: { break scope; } let r = outer: { break outer: 5; }; }\n");
}

test "highlight mut struct destructuring" {
    assert_highlights(&"struct P { x: i32, y: i32 }\nfn f(p: P) { let mut { x: mx, y: my } = p; mx += 1; }\n");
}

test "highlight turbofish wildcard type" {
    assert_highlights(&"fn f() { let x = pick::<_, bool>(1, true); }\n");
}

test "highlight array type in variant payload" {
    assert_highlights(&"variant V { Rect([f64, f64]), Pt }\ntype T = Foo<[i32, i32], bool>;\n");
}

test "highlight chained tuple index" {
    assert_highlights(&"fn f() { let t = [[1, 2], [3, 4]]; assert t.0.0 == 1; }\n");
}

test "highlight match arm diverging with a bare return" {
    assert_highlights(&"fn f(o: Option<i32>) -> i32 { return match o { Some(v) => v, None => return 0 }; }\n");
}

test "highlight range pattern" {
    assert_highlights(&"fn f(c: char) -> i32 { match c { '0'..='9' => 1, 'a'..<'f' => 2, _ => 0 }; }\n");
}

test "highlight range inside an or-pattern" {
    assert_highlights(&"fn f(c: char) -> i32 { match c { '-' | '0'..='9' => 1, _ => 0 }; }\n");
}

test "highlight fn-type effect before next param" {
    assert_highlights(&"fn a(f: fn() with Stdout, x: i32) with Stdout { f(); }\n");
}

// Grammar-coverage: highlight real Wado files and assert lossless
// text preservation (and a clean parse) across the language surface.
test "highlight example/cat.wado" {
    assert_highlights(&#include_str("../../example/cat.wado"));
}

