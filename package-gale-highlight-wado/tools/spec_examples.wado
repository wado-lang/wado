//! Every `wado` code block in the specification quotes an e2e fixture or a
//! source file ([WEP: Spec Examples Quote Fixtures](../../docs/wep-2026-09-26-spec-examples.md)).
//! Marl reads the Markdown, and the `Wado.g4` lexer finds each `assert`.

use wado from "../grammar/Wado.g4"
    with {
        generator: {
            module: "lib:gale",
            inputs: ["../grammar/Wado.highlights.scm"],
            options: {
                fragment_entries: ["statement"],
            },
        },
    };
use { fenced_code_blocks, FencedCode } from "../../package-marl/src/lib.wado";
use { collect_paths } from "lib:gale";
use { args, eprintln, exit, Stderr, Environment, Exit } from "core:cli";
use fs from "core:fs";
use { Preopens } from "core:fs";
use { TreeMap } from "core:collections";
use { from_string } from "core:json";

global FIXTURE_DIR: String = "wado-compiler/tests/fixtures";

/// What a block quotes.
pub variant Reference {
    /// An e2e fixture, by its path under `FIXTURE_DIR`. The suite runs it, so
    /// the block asserts or the fixture expects a compile error.
    Fixture(String),
    /// Any file in the repository, by its path from the root, quoted whole.
    Source(String),
}

impl Reference {
    /// The file's path from the repository root.
    pub fn path(&self) -> String {
        return match self {
            Fixture(name) => fs::join(&FIXTURE_DIR, name),
            Source(path) => *path,
        };
    }
}

/// A block that does not comply, at the line of its opening fence, and why.
pub struct Finding {
    pub line: i32,
    pub why: String,
}

/// The `wado` blocks of a Markdown document.
pub fn wado_blocks<S: AsStrSlice>(markdown: S) -> List<FencedCode> {
    return fenced_code_blocks(markdown).into_iter().filter(|b| b.tag == "wado").collect();
}

/// What a block names in the HTML comment before it: `null` when the comment
/// holds no JSON object, or why the object is no reference.
pub fn reference_of(block: &FencedCode) -> Result<Option<Reference>, String> {
    let Some(html) = block.html_before else {
        return Result::Ok(null);
    };
    let Some(inner) = html.strip_prefix("<!--") else {
        return Result::Ok(null);
    };
    let Some(inner) = inner.strip_suffix("-->") else {
        return Result::Ok(null);
    };
    let body = inner.trim();
    if !body.starts_with("{") {
        return Result::Ok(null);
    }
    let reference = from_string::<TreeMap<String, String>>(body.to_string()).map_err(
        |e| `the reference is not a JSON object of strings: ${e:?}`,
    )?;
    for let [key, _value] of reference.entries() {
        if *key != "fixture" && *key != "source" {
            return Result::Err(`the reference has an unknown key \`${*key}\``);
        }
    }
    return match [
        reference.get("fixture"),
        reference.get("source"),
    ] {
        [Some(name), None] => Result::Ok(Option::Some(Reference::Fixture(name))),
        [None, Some(path)] => Result::Ok(Option::Some(Reference::Source(path))),
        [Some(_), Some(_)] => Result::Err("the reference names both a `fixture` and a `source`"),
        [None, None] => Result::Err("the reference names no `fixture` or `source`"),
    };
}

fn is_blank<S: AsStrSlice>(line: S) -> bool {
    return line.trim().len() == 0;
}

/// Whether `code`'s lines appear in `text` in order and contiguous, each shifted
/// by one whitespace prefix. A blank line matches a blank line.
pub fn quotes<S: AsStrSlice>(text: S, code: &String) -> bool {
    let want: List<String> = code.lines().collect();
    let have: List<String> = text.lines().collect();
    let Some(anchor) = want.into_iter().position(|w| !is_blank(&w)) else {
        return false;
    };
    for let mut j = 0; j + want.len() <= have.len(); j += 1 {
        let line = &have[j + anchor];
        if !line.ends_with(&want[anchor]) {
            continue;
        }
        let prefix = line.substr_bytes(0, line.len() - want[anchor].len());
        if !is_blank(&prefix) {
            continue;
        }
        let mut all = true;
        for let mut k = 0; k < want.len() && all; k += 1 {
            all = if is_blank(&want[k]) { is_blank(&have[j + k]) } else { have[j + k] == `${prefix}${want[k]}` };
        }
        if all {
            return true;
        }
    }
    return false;
}

/// How many `assert` keywords `code` holds, as the lexer finds them.
pub fn assert_count(code: &String) -> i32 {
    let result = wado::parse(code);
    let tokens = &result.tokens;
    let mut n = 0;
    for let mut i = 0; i < tokens.len(); i += 1 {
        if tokens.kind_at(i) == wado::TK_LIT_assert {
            n += 1;
        }
    }
    return n;
}

/// The expectation keys of a fixture's `__DATA__` this check reads.
struct Expectation {
    compile_error: Option<String> = null,
    compile_error_codes: Option<List<String>> = null,
}

/// A fixture's source split at its `__DATA__` marker: the code, and the data.
fn split_data(source: &String) -> [String, String] {
    let marker = "\n__DATA__\n";
    return match source.find(marker) {
        Some(at) => [
            source.substr_bytes(0, at),
            source.substr_bytes(at + marker.len(), source.len()),
        ],
        None => [*source, ""],
    };
}

fn expects_rejection(data: &String) -> Result<bool, String> {
    if is_blank(data) {
        return Result::Ok(false);
    }
    return match from_string::<Expectation>(*data) {
        Ok(e) => Result::Ok(e.compile_error matches { Some(_) } || e.compile_error_codes matches { Some(_) }),
        Err(e) => Result::Err(`cannot read its __DATA__: ${e:?}`),
    };
}

/// Why `block`, which names `reference`, breaks a rule, or `null` if it keeps
/// them all. `files` holds each file that could be read, by its path.
fn check_block(block: &FencedCode, reference: &Reference, files: &TreeMap<String, String>) -> Option<String> {
    let path = reference.path();
    let Some(text) = files.get_ref_str(&path) else {
        return Option::Some(`no file \`${path}\``);
    };
    let Fixture(name) = reference else {
        if !quotes(text, &block.code) {
            return Option::Some(`\`${path}\` does not contain the block`);
        }
        return null;
    };
    let source = text;
    let [code, data] = split_data(source);
    if !quotes(&code, &block.code) {
        return Option::Some(`\`${name}\` does not contain the block`);
    }
    let rejected = match expects_rejection(&data) {
        Ok(r) => r,
        Err(why) => {
            return Option::Some(`\`${name}\`: ${why}`);
        },
    };
    if !rejected && assert_count(&block.code) == 0 {
        return Option::Some(`the block holds no \`assert\`, and \`${name}\` expects no compile error`);
    }
    return null;
}

/// Every block of `blocks` that does not comply.
pub fn audit(blocks: &List<FencedCode>, files: &TreeMap<String, String>) -> List<Finding> {
    let mut out: List<Finding> = [];
    for let block of blocks {
        let why = match reference_of(block) {
            Ok(Some(reference)) => check_block(block, &reference, files),
            Ok(None) => Option::Some("names no fixture or source"),
            Err(why) => Option::Some(why),
        };
        if let Some(why) = why {
            out.push(Finding { line: block.line, why });
        }
    }
    return out;
}

// --- the command ---

/// Each file `blocks` names that can be read, by its path.
fn read_files(blocks: &List<FencedCode>, into: &mut TreeMap<String, String>) with Preopens {
    for let block of blocks {
        if let Ok(Some(reference)) = reference_of(block) {
            let path = reference.path();
            if !into.contains_key_str(&path) {
                if let Ok(text) = fs::read_to_string(&path) {
                    into[path] = text;
                }
            }
        }
    }
}

/// Report each block of `paths` that does not comply, and how many there were.
fn report(paths: &List<String>) -> i32 with (Stderr, Preopens) {
    let mut files = TreeMap::<String, String>::new();
    let mut failed = 0;
    for let path of paths {
        let markdown = match fs::read_to_string(path) {
            Ok(s) => s,
            Err(e) => {
                eprintln(`error: ${e}`);
                failed += 1;
                continue;
            },
        };
        let blocks = wado_blocks(&markdown);
        read_files(&blocks, &mut files);
        for let f of audit(&blocks, &files) {
            eprintln(`${*path}:${f.line}: ${f.why}`);
            failed += 1;
        }
    }
    return failed;
}

export fn run() with (Stderr, Environment, Preopens, Exit) {
    if report(&collect_paths(&args(), ".md", [])) > 0 {
        exit(1);
    }
}

test "a block names what it quotes in the JSON comment before it" {
    let blocks = wado_blocks(
        "<!-- {\"fixture\": \"a.wado\"} -->\n\n```wado\nx\n```\n\n<!-- {\"source\": \"lib/b.wado\"} -->\n\n```wado\ny\n```\n\n```wado\nz\n```\n\n```text\nw\n```\n",
    );
    assert blocks.len() == 3;
    assert reference_of(&blocks[0]) == Result::Ok(Option::Some(Reference::Fixture("a.wado")));
    assert reference_of(&blocks[1]) == Result::Ok(Option::Some(Reference::Source("lib/b.wado")));
    assert reference_of(&blocks[2]) == Result::Ok(null);
}

test "a comment holding no JSON object names nothing" {
    let blocks = wado_blocks("<!-- dprint-ignore -->\n```wado\nx\n```\n");
    assert reference_of(&blocks[0]) == Result::Ok(null);
}

test "a JSON comment that is not a reference breaks the rule" {
    let malformed = "<!-- {\"fixture\": } -->\n```wado\nx\n```\n";
    assert why_of(malformed, &TreeMap::new()) matches { Some(_) };
    let misspelled = "<!-- {\"fixure\": \"a.wado\"} -->\n```wado\nx\n```\n";
    assert why_of(misspelled, &TreeMap::new()) matches { Some(_) };
    let extra = "<!-- {\"fixture\": \"a.wado\", \"note\": \"x\"} -->\n```wado\nx\n```\n";
    assert why_of(extra, &TreeMap::new()) matches { Some(_) };
    let both = "<!-- {\"fixture\": \"a.wado\", \"source\": \"b.wado\"} -->\n```wado\nx\n```\n";
    assert why_of(both, &TreeMap::new()) matches { Some(_) };
}

test "a quotation matches under one indentation prefix" {
    let fixture = "test {\n    let x = 1;\n\n    assert x == 1;\n}\n";
    assert quotes(fixture, &"let x = 1;\n\nassert x == 1;\n");
    assert quotes(fixture, &"test {\n    let x = 1;\n");
}

test "a quotation fails on a changed line, a gap, or two prefixes" {
    let fixture = "test {\n    let x = 1;\n    let y = 2;\n  let z = 3;\n}\n";
    assert !quotes(fixture, &"let x = 2;\n");
    assert !quotes(fixture, &"let x = 1;\nlet z = 3;\n");
    assert !quotes(fixture, &"let y = 2;\nlet z = 3;\n");
    assert !quotes(fixture, &"\n");
}

test "a prefix is whitespace" {
    assert !quotes("// let x = 1;\n", &"let x = 1;\n");
}

test "an assert counts where the lexer finds the keyword" {
    assert assert_count(&"let x = 1;\nassert x == 1;\n") == 1;
    assert assert_count(&"// assert x\nlet s = \"assert\";\n") == 0;
}

/// One file, keyed as a reference to it is: a fixture under `FIXTURE_DIR`.
#[allow(dead_code)]
fn fixture_map(name: String, source: String) -> TreeMap<String, String> {
    return file_map(fs::join(&FIXTURE_DIR, &name), source);
}

#[allow(dead_code)]
fn file_map(path: String, text: String) -> TreeMap<String, String> {
    let mut map = TreeMap::<String, String>::new();
    map[path] = text;
    return map;
}

#[allow(dead_code)]
fn why_of(markdown: String, files: &TreeMap<String, String>) -> Option<String> {
    let findings = audit(&wado_blocks(&markdown), files);
    assert findings.len() <= 1;
    return findings.into_iter().map(|f| f.why).next();
}

#[allow(dead_code)]
fn quoting() -> String {
    return "<!-- {\"fixture\": \"a.wado\"} -->\n\n```wado\nassert f() == 1;\n```\n";
}

test "a block quoting its fixture complies" {
    let fixtures = fixture_map("a.wado", "test {\n    assert f() == 1;\n}\n\n__DATA__\n{\"test\": {}}\n");
    assert why_of(quoting(), &fixtures) == null;
}

test "a block without a reference breaks the rule" {
    assert why_of("```wado\nx\n```\n", &TreeMap::new()) == Option::Some("names no fixture or source");
}

test "a missing fixture breaks the rule" {
    assert why_of(quoting(), &TreeMap::new()) matches { Some(_) };
}

test "a fixture that does not contain the block breaks the rule" {
    let fixtures = fixture_map("a.wado", "test {\n    assert f() == 2;\n}\n");
    assert why_of(quoting(), &fixtures) matches { Some(_) };
}

test "the quotation is read from the code, not the data" {
    let fixtures = fixture_map("a.wado", "fn f() -> i32 { return 1; }\n__DATA__\nassert f() == 1;\n");
    assert why_of(quoting(), &fixtures) matches { Some(_) };
}

test "a block with no assert breaks the rule unless its fixture is rejected" {
    let markdown = "<!-- {\"fixture\": \"a.wado\"} -->\n```wado\nlet x: i32 = \"s\";\n```\n";
    let accepted = fixture_map("a.wado", "let x: i32 = \"s\";\n__DATA__\n{\"test\": {}}\n");
    assert why_of(markdown, &accepted) matches { Some(_) };
    let rejected = fixture_map(
        "a.wado",
        "let x: i32 = \"s\";\n__DATA__\n{\"compile_error_codes\": [\"TYPE_MISMATCH\"]}\n",
    );
    assert why_of(markdown, &rejected) == null;
}

test "a source is quoted whole, with no assert asked of it" {
    let markdown = "<!-- {\"source\": \"lib/a.wado\"} -->\n```wado\nfn f() {}\n__DATA__\nraw\n```\n";
    let files = file_map("lib/a.wado", "fn f() {}\n__DATA__\nraw\n");
    assert why_of(markdown, &files) == null;
    assert why_of(markdown, &file_map("lib/a.wado", "fn f() {}\n")) matches { Some(_) };
    assert why_of(markdown, &TreeMap::new()) matches { Some(_) };
}
