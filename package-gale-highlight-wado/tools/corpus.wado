//! Shared plumbing for the corpus tools: the path list and reading a file.
//!
//! `wado run` grants only the current directory, so every path is opened
//! relative to the first preopen and the corpus list has to live inside the
//! repository.

use { eprintln, Stderr } from "core:cli";
use { Preopens, Descriptor, Filesize, PathFlags, OpenFlags, DescriptorFlags } from "wasi:filesystem";

/// The directory every path opens relative to, reporting the failure itself.
pub fn corpus_root() -> Option<Descriptor> with (Stderr, Preopens) {
    let dirs = Preopens::get_directories();
    if dirs.len() == 0 {
        eprintln("error: no preopened directories available");
        return null;
    }
    return Option::Some(dirs[0].0);
}

/// The `.wado` paths to process: every `--paths-from <file>` list plus any
/// bare `.wado` argument. `--paths-from` reads one path per line — the only
/// form that survives a path containing a space.
pub fn collect_paths(root: &Descriptor, argv: &List<String>) -> List<String> with Stderr {
    let mut paths: List<String> = [];
    for let mut i = 0; i < argv.len(); i += 1 {
        if argv[i] == "--paths-from" && i + 1 < argv.len() {
            i += 1;
            let list = match read_file(root, &argv[i]) {
                Some(text) => text,
                None => "",
            };
            for let line of list.lines() {
                if !line.is_empty() {
                    paths.push(line);
                }
            }
        } else if argv[i].ends_with(".wado") {
            paths.push(argv[i]);
        }
    }
    return paths;
}

pub fn read_file(root: &Descriptor, path: &String) -> Option<String> with Stderr {
    let file = match root.open_at(
        PathFlags::none(),
        *path,
        OpenFlags::none(),
        DescriptorFlags::Read,
    ).wait() {
        Ok(f) => f,
        Err(e) => {
            eprintln(`error: ${*path}: cannot open: ${e:?}`);
            return null;
        },
    };
    let [read_stream, _done] = file.read_via_stream(0 as Filesize);
    let bytes = read_stream.read_to_end();
    read_stream.drop();
    return match String::from_utf8(bytes) {
        Ok(s) => Option::Some(s),
        Err(e) => {
            eprintln(`error: ${*path}: not UTF-8: ${e}`);
            return null;
        },
    };
}
