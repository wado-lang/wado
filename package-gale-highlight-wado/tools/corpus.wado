//! The path list the corpus tools share. Every path opens relative to the
//! first preopen, which `wado run` grants; `core:fs` resolves it.

use { eprintln, Stderr } from "core:cli";
use fs from "core:fs";
use { Preopens } from "wasi:filesystem";

/// The `.wado` paths to process: every `--paths-from <file>` list plus any
/// bare `.wado` argument. `--paths-from` reads one path per line — the only
/// form that survives a path containing a space.
pub fn collect_paths(argv: &List<String>) -> List<String> with (Stderr, Preopens) {
    let mut paths: List<String> = [];
    for let mut i = 0; i < argv.len(); i += 1 {
        if argv[i] == "--paths-from" {
            assert i + 1 < argv.len(), "--paths-from needs a file";
            i += 1;
            match fs::read_to_string(&argv[i]) {
                Ok(list) => {
                    for let line of list.lines() {
                        if !line.is_empty() {
                            paths.push(line);
                        }
                    }
                },
                // An unreadable list yields no paths, which would otherwise
                // read as a clean run. Keep it as the one path that reports
                // itself.
                Err(e) => {
                    eprintln(`error: ${e}`);
                    paths.push(argv[i]);
                },
            }
        } else if argv[i].ends_with(".wado") {
            paths.push(argv[i]);
        }
    }
    return paths;
}
