//! Corpus check: parse every `.wado` path given on the command line with the
//! Gale-generated parser and report each file's first diagnostic.
//!
//!     wado run package-gale-highlight-wado/tools/corpus_check.wado -- <paths...>
//!
//! Prints one `ok` / `ng` line per file plus a closing summary, so a corpus of
//! compiler fixtures can be triaged against `grammar/Wado.g4`.

use { parse } from "../src/lib.wado";
use { args, println, eprintln, Stdout, Stderr, Environment } from "core:cli";
use { Preopens, Descriptor, Filesize, PathFlags, OpenFlags, DescriptorFlags } from "wasi:filesystem";

export fn run() with Stdout, Stderr, Environment, Preopens {
    let dirs = Preopens::get_directories();
    if dirs.len() == 0 {
        eprintln("error: no preopened directories available");
        return;
    }
    let root = dirs[0].0;

    let mut total = 0;
    let mut bad = 0;
    for let arg of &args() {
        if !arg.ends_with(".wado") {
            continue;
        }
        total += 1;
        if let Some(src) = read_file(&root, arg) {
            let result = parse(&src);
            if result.diagnostics.len() == 0 {
                println(`ok\t${*arg}`);
            } else {
                bad += 1;
                let d = result.diagnostics[0];
                let line = line_of(&src, d.span.start);
                println(
                    `ng\t${*arg}\t${result.diagnostics.len()}\t${line}\t${d.message}\t${snippet(&src, d.span.start)}`,
                );
            }
        } else {
            bad += 1;
            println(`ng\t${*arg}\t0\t0\tunreadable\t`);
        }
    }
    eprintln(`summary: ${total} files, ${bad} with diagnostics`);
}

/// 1-based line number of byte offset `at`.
fn line_of(src: &String, at: i32) -> i32 {
    let mut line = 1;
    let mut i = 0;
    while i < at && i < src.len() {
        if src.get_byte_unchecked(i) == b'\n' {
            line += 1;
        }
        i += 1;
    }
    return line;
}

/// The source line containing byte offset `at`, trimmed.
fn snippet(src: &String, at: i32) -> String {
    let mut start = at;
    if start > src.len() {
        start = src.len();
    }
    while start > 0 && src.get_byte_unchecked(start - 1) != b'\n' {
        start -= 1;
    }
    let mut end = at;
    while end < src.len() && src.get_byte_unchecked(end) != b'\n' {
        end += 1;
    }
    return src.substr_bytes(start, end).trim();
}

fn read_file(root: &Descriptor, path: &String) -> Option<String> with Stderr {
    let file = match root.open_at(
        PathFlags::none(),
        *path,
        OpenFlags::none(),
        DescriptorFlags::Read,
    ).wait() {
        Ok(f) => f,
        Err(e) => {
            eprintln(`error: ${*path}: cannot open: ${e:?}`);
            return null;
        },
    };
    let [read_stream, _done] = file.read_via_stream(0 as Filesize);
    let mut bytes: List<u8> = [];
    loop {
        let chunk = read_stream.read(65536);
        if chunk.len() == 0 {
            break;
        }
        bytes.extend(&chunk);
    }
    read_stream.drop();
    return match String::from_utf8(bytes) {
        Ok(s) => Option::Some(s),
        Err(e) => {
            eprintln(`error: ${*path}: not UTF-8: ${e}`);
            return null;
        },
    };
}
