use { Alternative } from "./ir.wado";
use { TreeSet } from "core:collections";

pub fn to_pascal_case(name: &String) -> String {
    let mut result = String::with_capacity(name.len());
    let mut capitalize_next = true;
    for let c of name.chars() {
        if c == '_' {
            capitalize_next = true;
        } else if capitalize_next {
            result.append_char(c.to_ascii_uppercase());
            capitalize_next = false;
        } else {
            result.append_char(c);
        }
    }
    return result;
}

pub fn to_snake_case(name: &String) -> String {
    let mut result = String::with_capacity(name.len() + 4);
    let mut prev_lower = false;
    for let c of name.chars() {
        if c.is_ascii_uppercase() {
            if prev_lower {
                result.append_char('_');
            }
            result.append_char(c.to_ascii_lowercase());
            prev_lower = false;
        } else {
            result.append_char(c);
            prev_lower = c.is_ascii_lowercase();
        }
    }
    return result;
}

pub fn to_lower(name: &String) -> String {
    return name.to_ascii_lowercase();
}

fn escape_control(c: char) -> Option<String> {
    return match c {
        '\\' => Option::Some("\\\\"),
        '\n' => Option::Some("\\n"),
        '\r' => Option::Some("\\r"),
        '\t' => Option::Some("\\t"),
        _ => null,
    };
}

fn append_escaped_body(result: &mut String, c: char) {
    if let Some(esc) = escape_control(c) {
        result.append(&esc);
    } else {
        let code = c as i32;
        if code >= 32 && code < 127 {
            result.append_char(c);
        } else {
            result.append(`\\u\{{code:x}\}`);
        }
    }
}

pub fn escape_char(c: char) -> String {
    if c == '\'' {
        return "'\\''";
    }
    let mut s = String::with_capacity(6);
    s.append_char('\'');
    append_escaped_body(&mut s, c);
    s.append_char('\'');
    return s;
}

pub fn escape_string(s: &String) -> String {
    let mut result = String::with_capacity(s.len() + 2);
    result.append_char('"');
    for let c of s.chars() {
        if c == '"' {
            result.append("\\\"");
        } else {
            append_escaped_body(&mut result, c);
        }
    }
    result.append_char('"');
    return result;
}

pub fn rule_type_name(name: &String) -> String {
    let mut result = to_pascal_case(name);
    result.append("Node");
    return result;
}

fn symbol_char_names(c: char) -> Option<[String, String]> {
    return match c {
        '+' => Option::Some(["plus", "PLUS"]),
        '-' => Option::Some(["minus", "MINUS"]),
        '*' => Option::Some(["star", "STAR"]),
        '/' => Option::Some(["slash", "SLASH"]),
        '%' => Option::Some(["percent", "PERCENT"]),
        '=' => Option::Some(["eq", "EQ"]),
        '!' => Option::Some(["bang", "BANG"]),
        '<' => Option::Some(["lt", "LT"]),
        '>' => Option::Some(["gt", "GT"]),
        '&' => Option::Some(["amp", "AMP"]),
        '|' => Option::Some(["pipe", "PIPE"]),
        '^' => Option::Some(["caret", "CARET"]),
        '~' => Option::Some(["tilde", "TILDE"]),
        '.' => Option::Some(["dot", "DOT"]),
        ',' => Option::Some(["comma", "COMMA"]),
        ':' => Option::Some(["colon", "COLON"]),
        ';' => Option::Some(["semicolon", "SEMI"]),
        '(' => Option::Some(["lparen", "LPAREN"]),
        ')' => Option::Some(["rparen", "RPAREN"]),
        '{' => Option::Some(["lbrace", "LBRACE"]),
        '}' => Option::Some(["rbrace", "RBRACE"]),
        '[' => Option::Some(["lbracket", "LBRACKET"]),
        ']' => Option::Some(["rbracket", "RBRACKET"]),
        _ => null,
    };
}

pub fn literal_field_name(text: &String) -> String {
    let chars: Array<char> = text.chars().collect();
    if chars.len() == 1 {
        if let Some(names) = symbol_char_names(chars[0]) {
            return names.0;
        }
    }
    let mut result = String::with_capacity(text.len() + 4);
    result.append("lit_");
    for let c of chars {
        if c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' {
            result.append_char(c.to_ascii_lowercase());
        } else {
            result.append_char('_');
        }
    }
    return result;
}

pub fn strip_suffix(s: &String, suffix: &String) -> String {
    let s_chars: Array<char> = s.chars().collect();
    let suffix_chars: Array<char> = suffix.chars().collect();
    let s_len = s_chars.len();
    let suf_len = suffix_chars.len();
    if s_len < suf_len {
        return *s;
    }
    for let mut i = 0; i < suf_len; i += 1 {
        if s_chars[s_len - suf_len + i] != suffix_chars[i] {
            return *s;
        }
    }
    let mut result = String::with_capacity(s.len());
    for let mut i = 0; i < s_len - suf_len; i += 1 {
        result.append_char(s_chars[i]);
    }
    return result;
}

pub fn is_simple_cst_group(alts: &Array<Alternative>) -> bool {
    if alts.len() < 2 { return false; }
    for let alt of alts {
        if alt.elements.len() != 1 { return false; }
        if let RuleRef(_) = alt.elements[0] {
            // ok
        } else {
            return false;
        }
    }
    return true;
}

pub fn group_variant_type_name(alts: &Array<Alternative>) -> String {
    let mut result = String::with_capacity(64);
    for let mut i = 0; i < alts.len(); i += 1 {
        if i > 0 { result.append("Or"); }
        if let RuleRef(name) = &alts[i].elements[0] {
            result.append(&to_pascal_case(name));
        }
    }
    result.append("Group");
    return result;
}

pub fn group_field_base_name(alts: &Array<Alternative>) -> String {
    let mut result = String::with_capacity(64);
    for let mut i = 0; i < alts.len(); i += 1 {
        if i > 0 { result.append("_or_"); }
        if let RuleRef(name) = &alts[i].elements[0] {
            result.append(&to_snake_case(name));
        }
    }
    return result;
}

pub fn group_case_name(alt: &Alternative) -> String {
    if let RuleRef(name) = &alt.elements[0] {
        return to_pascal_case(name);
    }
    return "Unknown";
}


/// A token-only group: multiple alternatives, each with a single TokenRef or Literal.
/// Example: (K_INSERT | K_REPLACE)
pub fn is_token_only_group(alts: &Array<Alternative>) -> bool {
    if alts.len() < 2 { return false; }
    for let alt of alts {
        if alt.elements.len() != 1 { return false; }
        if let TokenRef(_) | Literal(_) = alt.elements[0] {
            // ok
        } else {
            return false;
        }
    }
    return true;
}

/// A single-alternative multi-element group: exactly 1 alt with 2+ elements.
/// Example: (',' pair), (';'+ sql_stmt)
pub fn is_single_alt_group(alts: &Array<Alternative>) -> bool {
    if alts.len() != 1 { return false; }
    return alts[0].elements.len() >= 2;
}

/// Check if a group has any storable pattern (simple, token-only, or single-alt).
pub fn is_storable_group(alts: &Array<Alternative>) -> bool {
    return is_simple_cst_group(alts) || is_token_only_group(alts) || is_single_alt_group(alts);
}

/// Get a field name for the elements in a single-alt group's element.
fn element_base_name(elem: &Element) -> String {
    if let RuleRef(name) = *elem {
        return to_snake_case(&name);
    }
    if let TokenRef(name) = *elem {
        return to_lower(&name);
    }
    if let Literal(text) = *elem {
        return literal_field_name(&text);
    }
    if let Repeat(rep) = *elem {
        return element_base_name(&rep.element);
    }
    if let Label(lab) = *elem {
        return to_snake_case(&lab.name);
    }
    return "item";
}

/// Generate a struct type name for a single-alt group from its elements.
/// (',' pair) -> "CommaPairItem"
pub fn single_alt_group_type_name(alt: &Alternative) -> String {
    let mut result = String::with_capacity(64);
    for let elem of &alt.elements {
        result.append(&to_pascal_case(&element_base_name(&elem)));
    }
    result.append("Item");
    return result;
}

/// Generate a field base name for a single-alt group.
/// (',' pair) -> "comma_pair"
pub fn single_alt_group_field_name(alt: &Alternative) -> String {
    let mut result = String::with_capacity(64);
    for let mut i = 0; i < alt.elements.len(); i += 1 {
        if i > 0 { result.append("_"); }
        result.append(&element_base_name(&alt.elements[i]));
    }
    return result;
}

/// Generate a field base name for a token-only group.
/// (K_INSERT | K_REPLACE) -> "k_insert_or_k_replace"
pub fn token_group_field_name(alts: &Array<Alternative>) -> String {
    let mut result = String::with_capacity(64);
    for let mut i = 0; i < alts.len(); i += 1 {
        if i > 0 { result.append("_or_"); }
        result.append(&element_base_name(&alts[i].elements[0]));
    }
    return result;
}

pub fn literal_const_name(text: &String) -> String {
    let mut result = String::with_capacity(text.len() + 8);
    result.append("TK_LIT_");
    for let c of text.chars() {
        if c.is_ascii_lowercase() {
            result.append_char(c.to_ascii_uppercase());
        } else if c.is_ascii_uppercase() || c >= '0' && c <= '9' {
            result.append_char(c);
        } else if let Some(names) = symbol_char_names(c) {
            result.append(&names.1);
        } else {
            result.append_char('_');
        }
    }
    return result;
}

pub fn str_set_from(arr: &Array<String>) -> TreeSet<String> {
    let mut set = TreeSet::<String>::new();
    for let item of arr {
        set.insert(*item);
    }
    return set;
}

pub fn str_set_insert_all(set: &mut TreeSet<String>, arr: &Array<String>) {
    for let item of arr {
        set.insert(*item);
    }
}
