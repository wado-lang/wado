use { Alternative, Element, Visibility } from "./ir.wado";
use { FOLLOW_PARAM, symbol_char_names, char_hex_name } from "./ident.wado";
use { CodeWriter } from "lib:wadopoet";
use { TreeSet } from "core:collections";
use { unwrap_label } from "./lr_util.wado";
use { is_ident_byte } from "./text.wado";
pub use { escape_ident, escape_case, to_pascal_case, to_snake_case, to_lower } from "./ident.wado";

/// Emit a `// rule visibility: <name> (ignored by codegen, matches ANTLR4)`
/// comment for a rule whose .g4 source carried a `public` / `private` /
/// `protected` modifier. ANTLR4 itself ignores these modifiers at code
/// generation time, so Gale matches that behavior but surfaces the value as
/// a doc comment above the generated `parse_X` / `try_X` function so the
/// modifier stays observable in the output.
pub fn gen_visibility_comment(w: &mut CodeWriter, visibility: &Visibility) {
    let label = match *visibility {
        Default => "",
        Public => "public",
        Private => "private",
        Protected => "protected",
    };
    if label == "" {
        return;
    }
    w.line(`// rule visibility: ${label} (ignored by codegen, matches ANTLR4)`);
}

/// Every free function generated `text` calls: an identifier followed by `(`
/// that is neither a method nor the one a `fn` defines.
pub fn collect_called_names(text: &String, out: &mut TreeSet<String>) {
    collect_names(text, out, true, &[]);
}

/// Every identifier generated `text` names that starts with one of `prefixes`.
pub fn collect_referenced_names(text: &String, prefixes: &List<String>, out: &mut TreeSet<String>) {
    collect_names(text, out, false, prefixes);
}

fn collect_names(text: &String, out: &mut TreeSet<String>, calls_only: bool, prefixes: &List<String>) {
    let n = text.len();
    let mut i = 0;
    while i < n {
        if !is_ident_byte(text.get_byte_unchecked(i)) {
            i += 1;
            continue;
        }
        let start = i;
        while i < n && is_ident_byte(text.get_byte_unchecked(i)) {
            i += 1;
        }
        if calls_only && is_method_name(text, start) {
            continue;
        }
        let name = text.as_str_slice().slice(start, i);
        if !prefixes.is_empty() && !prefixes.iter_ref().any(|p| name.starts_with(p)) {
            continue;
        }
        if !calls_only || i < n && text.get_byte_unchecked(i) == b'(' && !follows_fn_keyword(text, start) {
            out.insert(name.to_string());
        }
    }
}

/// Whether the name at `start` follows a receiver's `.`, not a spread's `..`.
fn is_method_name(text: &String, start: i32) -> bool {
    return start >= 1
        && text.get_byte_unchecked(start - 1) == b'.'
        && !(start >= 2 && text.get_byte_unchecked(start - 2) == b'.');
}

fn follows_fn_keyword(text: &String, start: i32) -> bool {
    return start >= 3 && text.as_str_slice().slice(start - 3, start) == "fn ";
}

/// The top-level functions generated `text` defines.
pub fn defined_fn_names(text: &String) -> List<String> {
    let mut out: List<String> = [];
    for let line of text.split("\n") {
        if !line.starts_with("fn ") {
            continue;
        }
        let rest = line.as_str_slice().slice(3, line.len());
        let mut end = 0;
        while end < rest.len() && is_ident_byte(rest.get_byte_unchecked(end)) {
            end += 1;
        }
        out.push(rest.slice(0, end).to_string());
    }
    return out;
}

pub fn rule_type_name<S: AsStrSlice>(name: S) -> String {
    let mut result = to_pascal_case(name);
    result.push_str("Node");
    return result;
}

/// A rule's `RK_` node-kind constant: its snake-case name uppercased, so
/// `valueInfo` reaches `RK_VALUE_INFO`. The declaration and every `start_node`
/// referring to it come through here, which is what keeps them one name.
pub fn rule_kind_const<S: AsStrSlice>(name: S) -> String {
    let snake = to_snake_case(name);
    let mut out = String::with_capacity(snake.len() + 3);
    out.push_str("RK_");
    for let c of snake.chars() {
        out.push(c.to_ascii_uppercase());
    }
    return out;
}

/// Field base name for a parser-side `~ X` (set complement). The inner element
/// is typically a terminal (TokenRef / Literal) or a simple terminal set; we
/// derive a readable name from it so multi-element alternatives can dedup.
pub fn not_element_field_name(inner: &Element) -> String {
    return match *inner {
        TokenRef(t) => `not_${t.lower_name}`,
        Literal(l) => `not_${literal_field_name(&l.text)}`,
        _ => "not_set",
    };
}

pub fn literal_field_name<S: AsStrSlice>(text: S) -> String {
    let chars: List<char> = text.chars().collect();
    if chars.len() == 1 {
        if let Some(names) = symbol_char_names(chars[0]) {
            return names.0;
        }
    }
    let mut result = String::with_capacity(text.len() + 4);
    result.push_str("lit_");
    for let c of chars {
        if 'a' <= c <= 'z' || 'A' <= c <= 'Z' || '0' <= c <= '9' {
            result.push(c.to_ascii_lowercase());
        } else if let Some(names) = symbol_char_names(c) {
            result.push_str(&names.0);
        } else {
            result.push_str("u");
            result.push_str(&char_hex_name(c));
        }
    }
    return result;
}

pub fn strip_suffix<S: AsStrSlice, S1: AsStrSlice>(s: S, suffix: S1) -> String {
    let s_chars: List<char> = s.chars().collect();
    let suffix_chars: List<char> = suffix.chars().collect();
    let s_len = s_chars.len();
    let suf_len = suffix_chars.len();
    if s_len < suf_len {
        return s.to_string();
    }
    for let mut i = 0; i < suf_len; i += 1 {
        if s_chars[s_len - suf_len + i] != suffix_chars[i] {
            return s.to_string();
        }
    }
    let mut result = String::with_capacity(s.len());
    for let mut i = 0; i < s_len - suf_len; i += 1 {
        result.push(s_chars[i]);
    }
    return result;
}

pub fn is_simple_cst_group(alts: &List<Alternative>) -> bool {
    if alts.len() < 2 {
        return false;
    }
    for let alt of alts {
        if alt.elements.len() != 1 {
            return false;
        }
        if let RuleRef(_) = alt.elements[0] {
            // ok
        } else {
            return false;
        }
    }
    return true;
}

pub fn group_variant_type_name(alts: &List<Alternative>) -> String {
    let mut result = String::with_capacity(64);
    for let mut i = 0; i < alts.len(); i += 1 {
        if i > 0 {
            result.push_str("Or");
        }
        if let RuleRef(r) = &alts[i].elements[0] {
            result.push_str(&to_pascal_case(&r.name));
        }
    }
    result.push_str("Group");
    return result;
}

pub fn group_field_base_name(alts: &List<Alternative>) -> String {
    let mut result = String::with_capacity(64);
    for let mut i = 0; i < alts.len(); i += 1 {
        if i > 0 {
            result.push_str("_or_");
        }
        if let RuleRef(r) = &alts[i].elements[0] {
            result.push_str(&r.snake_name);
        }
    }
    return result;
}

pub fn group_case_name(alt: &Alternative) -> String {
    if let RuleRef(r) = &alt.elements[0] {
        return to_pascal_case(&r.name);
    }
    // Only ever called on SimpleCst-group alts, whose first element is a
    // RuleRef by construction. Emitting a placeholder case name here would
    // generate wrong code, so fail loudly instead.
    panic(
        "group_case_name: SimpleCst-group alt's first element is not a RuleRef — classifier/caller invariant violated",
    );
}


/// A token-only group: multiple alternatives, each with a single TokenRef or Literal.
/// Example: (K_INSERT | K_REPLACE)
pub fn is_token_only_group(alts: &List<Alternative>) -> bool {
    if alts.len() < 2 {
        return false;
    }
    for let alt of alts {
        if alt.elements.len() != 1 {
            return false;
        }
        if let TokenRef(_) | Literal(_) = alt.elements[0] {
            // ok
        } else {
            return false;
        }
    }
    return true;
}

/// A single-alternative multi-element group: exactly 1 alt with 2+ elements.
/// Example: (',' pair), (';'+ sql_stmt)
pub fn is_single_alt_group(alts: &List<Alternative>) -> bool {
    if alts.len() != 1 {
        return false;
    }
    return alts[0].elements.len() >= 2;
}

/// True when every alternative carries a `# Label` (ANTLR4 requires
/// all-or-none labeling). Drives the per-rule `<Rule>Alt` enum emission and
/// the parser's `set_alt` stamping; unlabeled rules stay byte-identical.
pub fn rule_alts_labeled(alts: &List<Alternative>) -> bool {
    if alts.is_empty() {
        return false;
    }
    for let a of alts {
        if let Some(_) = &a.label {
            continue;
        }
        return false;
    }
    return true;
}

/// Every group except a `GroupClass::Transparent` one is storable: multi-alt
/// groups get a variant type, a single alt with 2+ elements gets a struct.
pub fn is_storable_group(alts: &List<Alternative>) -> bool {
    if alts.is_empty() {
        return false;
    }
    return alts.len() > 1 || alts[0].elements.len() >= 2;
}

/// A general multi-alt group: 2+ alternatives that don't match any specialized pattern.
pub fn is_general_group(alts: &List<Alternative>) -> bool {
    if alts.len() < 2 {
        return false;
    }
    return classify_group(alts) matches { General };
}

pub enum GroupClass {
    Transparent,
    SingleAlt,
    TokenOnly,
    SimpleCst,
    General,
}

pub fn classify_group(alts: &List<Alternative>) -> GroupClass {
    assert alts.len() > 0, "Group with no alts is not a valid lowering input";
    if alts.len() == 1 {
        assert alts[0].elements.len() > 0, "Group with empty alt is not a valid lowering input";
        if alts[0].elements.len() == 1 {
            return GroupClass::Transparent;
        }
        return GroupClass::SingleAlt;
    }
    // Only the General shape keeps a per-alternative body to run an action in
    // and a per-alternative condition for a predicate to gate.
    if group_alts_have_actions(alts) {
        return GroupClass::General;
    }
    if is_token_only_group(alts) {
        return GroupClass::TokenOnly;
    }
    if is_simple_cst_group(alts) {
        return GroupClass::SimpleCst;
    }
    return GroupClass::General;
}

/// Whether any alternative of `alts` carries an action or a predicate.
pub fn group_alts_have_actions(alts: &List<Alternative>) -> bool {
    return alts.iter_ref().any(|a: &Alternative| !a.actions.is_empty());
}

/// Count how many general groups are in an element list.
/// Matches the type gen's counting logic (looks through Repeat wrappers).
pub fn count_general_groups(elements: &List<Element>) -> i32 {
    let mut count: i32 = 0;
    for let elem of elements {
        count += count_element_groups(elem);
    }
    return count;
}

/// Groups nested under `alts`, plus one when `alts` is itself a general group.
fn group_nesting_count(alts: &List<Alternative>) -> i32 {
    let mut max_nested: i32 = 0;
    for let alt of alts {
        let nested = count_general_groups(&alt.elements);
        if nested > max_nested {
            max_nested = nested;
        }
    }
    if is_general_group(alts) {
        return 1 + max_nested;
    }
    return max_nested;
}

pub fn count_element_groups(elem: &Element) -> i32 {
    return match elem {
        Group(g) => group_nesting_count(&g.alternatives),
        Repeat(rep) => if let Group(g) = &rep.element {
            group_nesting_count(&g.alternatives);
        } else {
            count_element_groups(&rep.element);
        },
        Label(lab) => count_element_groups(&lab.element),
        TokenRef(_) | Literal(_) | RuleRef(_) | Wildcard(_) | Not(_) => 0,
    };
}

/// Generate a variant type name for a general multi-alt group.
/// Uses parent rule name + group index: "InsertStmtGroup0"
pub fn general_group_type_name<S: AsStrSlice>(rule_name: S, group_index: i32) -> String {
    return `${to_pascal_case(rule_name)}Group${group_index}`;
}

/// Generate a field base name for a general multi-alt group.
/// Uses group index: "group_0"
pub fn general_group_field_name(group_index: i32) -> String {
    return `group_${group_index}`;
}

/// Generate a struct name for a specific alternative in a general group.
/// Uses parent rule name + group index + alt index: "InsertStmtGroup0Alt1"
pub fn general_group_alt_struct_name<S: AsStrSlice>(rule_name: S, group_index: i32, alt_index: i32) -> String {
    return `${to_pascal_case(rule_name)}Group${group_index}Alt${alt_index}`;
}

/// Get a field name for the elements in a single-alt group's element.
fn element_base_name(elem: &Element) -> String {
    return match elem {
        RuleRef(r) => r.field_name,
        TokenRef(t) => t.field_name,
        Literal(l) => literal_field_name(&l.text),
        Repeat(rep) => element_base_name(&rep.element),
        Label(lab) => lab.field_name,
        _ => "item",
    };
}

/// Get a type-disambiguating base name for an element, including repeat suffixes.
/// E.g. ','? -> "comma_opt", ','* -> "comma_list", ',' -> "comma"
fn element_type_base_name(elem: &Element) -> String {
    if let Repeat(rep) = elem {
        let inner = element_base_name(&rep.element);
        return match rep.kind {
            Optional => `${inner}_opt`,
            Star | Plus => `${inner}_list`,
        };
    }
    return element_base_name(elem);
}

/// Generate a struct type name for a single-alt group from its elements.
/// (',' pair) -> "CommaPairItem"
/// (',' pair?) -> "CommaOptPairItem"  (distinguishes from non-optional)
pub fn single_alt_group_type_name(alt: &Alternative) -> String {
    let mut result = String::with_capacity(64);
    for let elem of &alt.elements {
        result.push_str(&to_pascal_case(&element_type_base_name(elem)));
    }
    result.push_str("Item");
    return result;
}

/// Generate a field base name for a single-alt group.
/// (',' pair) -> "comma_pair"
pub fn single_alt_group_field_name(alt: &Alternative) -> String {
    let mut result = String::with_capacity(64);
    for let mut i = 0; i < alt.elements.len(); i += 1 {
        if i > 0 {
            result.push_str("_");
        }
        result.push_str(&element_base_name(&alt.elements[i]));
    }
    return result;
}

/// Generate a field base name for a token-only group.
/// (K_INSERT | K_REPLACE) -> "k_insert_or_k_replace"
pub fn token_group_field_name(alts: &List<Alternative>) -> String {
    let mut result = String::with_capacity(64);
    for let mut i = 0; i < alts.len(); i += 1 {
        if i > 0 {
            result.push_str("_or_");
        }
        result.push_str(&element_base_name(&alts[i].elements[0]));
    }
    return result;
}

/// Returns true if every alt in `alts` is a single TokenRef or Literal
/// element. Such rules collapse to a one-token kind check at scan time
/// and to a compact `{ span, token }` struct (instead of an N-arm
/// variant) at CST / parse / walk time. Labelled single tokens
/// (`x='+'`) are `Label(...)`, not `TokenRef(...)`, so they are
/// excluded — the compaction drops the per-alt label name.
pub fn all_alts_are_single_token(alts: &List<Alternative>) -> bool {
    for let alt of alts {
        if alt.elements.len() != 1 {
            return false;
        }
        let elem = &alt.elements[0];
        if !elem matches { TokenRef(_) | Literal(_) } {
            return false;
        }
    }
    return true;
}

/// Return the matched token-kind constant for a single TokenRef/Literal
/// element. Caller is expected to have screened the element via
/// `all_alts_are_single_token`.
pub fn single_token_first(elem: &Element) -> String {
    return match elem {
        TokenRef(t) => `TK_${t.name}`,
        Literal(l) => l.const_name,
        _ => panic("single_token_first: unexpected element"),
    };
}

/// Build unique case names for labeled alternatives.
/// When labels are unique, use them directly. When duplicated, append an index.
fn build_case_names(alts: &List<Alternative>, all_labeled: bool) -> List<String> {
    let mut names: List<String> = [];
    if !all_labeled {
        for let mut i = 0; i < alts.len(); i += 1 {
            names.push(`Alt${i}`);
        }
        return names;
    }
    // Count occurrences of each label
    let mut label_counts: List<[String, i32]> = [];
    for let alt of alts {
        let lab = alt.label.unwrap();
        let mut found = false;
        for let mut j = 0; j < label_counts.len(); j += 1 {
            if label_counts[j].0 == lab {
                label_counts[j] = [label_counts[j].0, label_counts[j].1 + 1];
                found = true;
            }
        }
        if !found {
            label_counts.push([lab, 1]);
        }
    }
    // Assign names: unique labels keep their name, duplicates get index
    let mut label_indices: List<[String, i32]> = [];
    for let alt of alts {
        let lab = alt.label.unwrap();
        let mut is_dup = false;
        for let lc of &label_counts {
            if lc.0 == lab && lc.1 > 1 {
                is_dup = true;
            }
        }
        if is_dup {
            let mut idx: i32 = 0;
            let mut found_idx = false;
            for let mut j = 0; j < label_indices.len(); j += 1 {
                if label_indices[j].0 == lab {
                    idx = label_indices[j].1 + 1;
                    label_indices[j] = [label_indices[j].0, idx];
                    found_idx = true;
                }
            }
            if !found_idx {
                label_indices.push([lab, 0]);
            }
            names.push(`${lab}${idx}`);
        } else {
            names.push(lab);
        }
    }
    return names;
}

fn all_alternatives_labeled(alts: &List<Alternative>) -> bool {
    for let alt of alts {
        if let None = alt.label {
            return false;
        }
    }
    return true;
}

pub fn case_names_for_rule(alts: &List<Alternative>) -> List<String> {
    let all_labeled = all_alternatives_labeled(alts);
    return build_case_names(alts, all_labeled);
}

/// Return `true` when `first` contains `token`.
pub fn first_contains<S: AsStrSlice>(first: &List<String>, token: S) -> bool {
    return first.contains_str(token);
}

/// Append every token in `source` to `arr`, skipping duplicates already in `arr`.
pub fn dedup_append_arr(arr: &mut List<String>, source: &List<String>) {
    for let tk of source {
        if !first_contains(arr, tk) {
            arr.push(*tk);
        }
    }
}

pub fn subtract_sets(a: &List<String>, b: &List<String>) -> List<String> {
    return a.iter_value().filter(|x: String| !first_contains(b, &x)).collect();
}

// Parser codegen names every consumed element so the surrounding struct
// field can be populated. When the same base name appears more than
// once in an alt (e.g. two `ID` tokens) the second occurrence gets a
// `_2` suffix, the third `_3`, and so on. `List<[String, i32]>` is
// the running counter: `[base, count_emitted_so_far]`.
fn get_count<S: AsStrSlice>(counts: &List<[String, i32]>, name: S) -> i32 {
    for let entry of counts {
        if entry.0 == name.as_str_slice() {
            return entry.1;
        }
    }
    return 0;
}

fn increment_count<S: AsStrSlice>(counts: &mut List<[String, i32]>, name: S) {
    for let mut i = 0; i < counts.len(); i += 1 {
        if counts[i].0 == name.as_str_slice() {
            counts[i].1 += 1;
            return;
        }
    }
    counts.push([name.to_string(), 1]);
}

/// Emit-and-record: returns the deduplicated name and bumps the counter.
/// First occurrence returns `base`, second returns `${base}_2`, etc.
pub fn dedup_name<S: AsStrSlice>(base: S, counts: &mut List<[String, i32]>) -> String {
    let count = get_count(counts, base);
    increment_count(counts, base);
    if count > 0 {
        return `${base}_${count + 1}`;
    }
    return base.to_string();
}

/// Predict what `dedup_name(base, counts)` would return without
/// advancing the counter. Used at scan-guard / lookahead sites where
/// the inner emission performs the actual `dedup_name` (which both
/// returns the name and advances the counter).
pub fn peek_dedup_name<S: AsStrSlice>(base: S, counts: &List<[String, i32]>) -> String {
    let count = get_count(counts, base);
    if count > 0 {
        return `${base}_${count + 1}`;
    }
    return base.to_string();
}

pub fn element_field_info(elem: &Element) -> [String, String] {
    return match elem {
        TokenRef(t) => [t.field_name, "Token"],
        Literal(l) => [literal_field_name(&l.text), "Token"],
        RuleRef(r) => [r.field_name, rule_type_name(&r.name)],
        Wildcard(_) => ["wildcard", "Token"],
        Not(ne) => [not_element_field_name(&ne.element), "Token"],
        Label(lab) => if lab.list {
            let inner = element_field_info(&lab.element);
            [lab.field_name, `List<${inner.1}>`];
        } else {
            element_field_info(&lab.element);
        },
        Group(g) => match classify_group(&g.alternatives) {
            SimpleCst => [
                group_field_base_name(&g.alternatives),
                group_variant_type_name(&g.alternatives),
            ],
            TokenOnly => [token_group_field_name(&g.alternatives), "Token"],
            SingleAlt => [
                single_alt_group_field_name(&g.alternatives[0]),
                single_alt_group_type_name(&g.alternatives[0]),
            ],
            General => panic(
                "element_field_info: general Group reached the surface helper — route through `gen_op_group`/`gen_general_group_store*` instead",
            ),
            Transparent => panic(
                "element_field_info: transparent Group has no storable field shape — caller routed a non-storable element into the field-info helper",
            ),
        },
        Repeat(_) => panic(
            "element_field_info: Repeat has no storable field shape — caller routed a non-storable element into the field-info helper",
        ),
    };
}

/// A continuation is one `i64`: `FOLLOW_CONT_SLOTS` positions of
/// `FOLLOW_SLOT_BITS`, each holding a 1-based `FOLLOW_SETS` index and a bit
/// saying it opens a fresh reading. Composition is a shift, so a call site
/// spells it in constants and a rule carries one parameter.
pub global FOLLOW_SLOT_BITS: i32 = 8;

pub global FOLLOW_CONT_SLOTS: i32 = 7;

pub global FOLLOW_MAX_POSITION_ID: i32 = 127;

/// The whole continuation forwarded unmoved.
pub fn follow_forward_args() -> String {
    return FOLLOW_PARAM;
}

/// `prefix` ahead of the caller's continuation, which therefore starts at the
/// `positions` the prefix already constrains. `opens` marks that start as a
/// fresh reading rather than more of the same one.
///
/// The forwarded half is masked down to its positions first. A reading it opens
/// begins where the alternation was written, and `prefix` moves that point
/// without moving the mark, so the gate would revive the reading `prefix`
/// positions early — `{ x, y }` inside `[ … ]` handing its own comma to the
/// list, whose next iteration also starts with one. Only the reading this
/// composition opens is at a position the gate can still place.
pub fn follow_composed<S: AsStrSlice>(prefix: S, positions: i32, opens: bool) -> String {
    let sequenced = `${FOLLOW_PARAM} & FOLLOW_SEQUENCED`;
    let shifted = if opens { `(${sequenced} | FOLLOW_OPENS_BIT)` } else { `(${sequenced})` };
    return `(${prefix} | ${shifted} << ${positions * FOLLOW_SLOT_BITS}) & FOLLOW_CONT_MASK`;
}

/// A `follow_yields` call on the forwarded continuation.
pub fn follow_yields_call<S: AsStrSlice, S1: AsStrSlice>(tokens: S, pos: S1) -> String {
    return follow_yields_call_of(tokens, pos, &FOLLOW_PARAM);
}

/// `follow_yields_call` where the site is `gated` on the caller's FOLLOW, else "".
pub fn follow_yields_call_if<S: AsStrSlice, S1: AsStrSlice>(gated: bool, tokens: S, pos: S1) -> String {
    return if gated { follow_yields_call(tokens, pos) } else { String::new() };
}

/// A `follow_yields` call on a continuation held in one local.
pub fn follow_yields_call_of<S: AsStrSlice, S1: AsStrSlice, S2: AsStrSlice>(tokens: S, pos: S1, head: S2) -> String {
    return `follow_yields(${tokens}, ${pos}, ${head}, &FOLLOW_SETS, TK_EOF)`;
}

/// `", <forwarded continuation>"` when the callee declares the parameter, else
/// `""`. Appended after a call's fixed arguments.
pub fn follow_sep(emit_follow: bool) -> String {
    if emit_follow {
        return `, ${follow_forward_args()}`;
    }
    return "";
}

pub fn join_kinds(kinds: &List<String>) -> String {
    let mut result = String::with_capacity(64);
    for let mut i = 0; i < kinds.len(); i += 1 {
        if i > 0 {
            result.push_str(", ");
        }
        result.push_str(&kinds[i]);
    }
    return result;
}


/// Check if a consumed element matches the expected element at a given skip position.
/// Returns true only for exact terminal matches (TokenRef or Literal).
/// Unwraps Labels to compare inner elements.
pub fn elements_match(consumed: &Element, expected: &Element) -> bool {
    let exp = unwrap_label(expected);
    return match consumed {
        TokenRef(a) => *exp matches { TokenRef(b) && b.name == a.name },
        Literal(a) => *exp matches { Literal(b) && b.text == a.text },
        RuleRef(_) | Group(_) | Repeat(_) | Label(_) | Wildcard(_) | Not(_) => false,
    };
}
