use { FOLLOW_PARAM, symbol_char_names, char_hex_name } from "./ident.wado";
use { is_id_continue_char, scan_closed_string } from "./g4/scan.wado";
use { collect_range } from "./text.wado";
pub use { escape_ident, escape_case, to_pascal_case, to_snake_case, to_lower } from "./ident.wado";
use { CodeWriter } from "lib:wadopoet";

/// Open an `if` arm, or chain it onto the arm already open.
pub fn open_chain_arm<S: AsStrSlice>(w: &mut CodeWriter, chained: bool, cond: S) {
    if chained {
        w.else_begin(`else if ${cond}`);
    } else {
        w.begin(`if ${cond}`);
    }
}

pub fn rule_type_name<S: AsStrSlice>(name: S) -> String {
    let mut result = to_pascal_case(name);
    result.push_str("Node");
    return result;
}

/// A rule's `RK_` node-kind constant: its snake-case name uppercased, so
/// `valueInfo` reaches `RK_VALUE_INFO`. The declaration and every `start_node`
/// referring to it come through here, which is what keeps them one name.
pub fn rule_kind_const<S: AsStrSlice>(name: S) -> String {
    let snake = to_snake_case(name);
    let mut out = String::with_capacity(snake.len() + 3);
    out.push_str("RK_");
    for let c of snake.chars() {
        out.push(c.to_ascii_uppercase());
    }
    return out;
}

pub fn literal_field_name<S: AsStrSlice>(text: S) -> String {
    let chars: List<char> = text.chars().collect();
    if chars.len() == 1 {
        if let Some(names) = symbol_char_names(chars[0]) {
            return names.0;
        }
    }
    let mut result = String::with_capacity(text.len() + 4);
    result.push_str("lit_");
    for let c of chars {
        if 'a' <= c <= 'z' || 'A' <= c <= 'Z' || '0' <= c <= '9' {
            result.push(c.to_ascii_lowercase());
        } else if let Some(names) = symbol_char_names(c) {
            result.push_str(&names.0);
        } else {
            result.push_str("u");
            result.push_str(&char_hex_name(c));
        }
    }
    return result;
}

// Parser codegen names every consumed element so the surrounding struct
// field can be populated. When the same base name appears more than
// once in an alt (e.g. two `ID` tokens) the second occurrence gets a
// `_2` suffix, the third `_3`, and so on. `List<[String, i32]>` is
// the running counter: `[base, count_emitted_so_far]`.
fn get_count<S: AsStrSlice>(counts: &List<[String, i32]>, name: S) -> i32 {
    for let entry of counts {
        if entry.0 == name.as_str_slice() {
            return entry.1;
        }
    }
    return 0;
}

fn increment_count<S: AsStrSlice>(counts: &mut List<[String, i32]>, name: S) {
    for let mut i = 0; i < counts.len(); i += 1 {
        if counts[i].0 == name.as_str_slice() {
            counts[i].1 += 1;
            return;
        }
    }
    counts.push([name.to_string(), 1]);
}

/// Emit-and-record: returns the deduplicated name and bumps the counter.
/// First occurrence returns `base`, second returns `${base}_2`, etc.
pub fn dedup_name<S: AsStrSlice>(base: S, counts: &mut List<[String, i32]>) -> String {
    let count = get_count(counts, base);
    increment_count(counts, base);
    if count > 0 {
        return `${base}_${count + 1}`;
    }
    return base.to_string();
}

/// A continuation is one `i64`: `FOLLOW_CONT_SLOTS` positions of
/// `FOLLOW_SLOT_BITS`, each holding a 1-based `FOLLOW_SETS` index and a bit
/// saying it opens a fresh reading. Composition is a shift, so a call site
/// spells it in constants and a rule carries one parameter.
pub global FOLLOW_SLOT_BITS: i32 = 8;

pub global FOLLOW_CONT_SLOTS: i32 = 7;

pub global FOLLOW_MAX_POSITION_ID: i32 = 127;

/// The whole continuation forwarded unmoved.
pub fn follow_forward_args() -> String {
    return FOLLOW_PARAM;
}

/// `prefix` ahead of the caller's continuation, which therefore starts at the
/// `positions` the prefix already constrains. `opens` marks that start as a
/// fresh reading rather than more of the same one.
///
/// The forwarded half is masked down to its positions first. A reading it opens
/// begins where the alternation was written, and `prefix` moves that point
/// without moving the mark, so the gate would revive the reading `prefix`
/// positions early — `{ x, y }` inside `[ … ]` handing its own comma to the
/// list, whose next iteration also starts with one. Only the reading this
/// composition opens is at a position the gate can still place.
///
/// An empty continuation is an unknown one. Behind `prefix` it only stops
/// constraining, but as an alternative to it, it is a reading the slots cannot
/// hold, so the result carries `FOLLOW_OPEN_READING` for `follow_admits`. An
/// open reading behind `prefix` is dropped: `follow_admits` asks only where a
/// reading can start, and every reading here starts with the prefix. Carried as
/// a bare mark it would admit any kind, and `[b, c]` would give its `,` to the
/// element before it.
pub fn follow_composed<S: AsStrSlice>(prefix: S, positions: i32, opens: bool) -> String {
    let helper = if opens { "follow_then_opening" } else { "follow_then" };
    return `${helper}(${prefix}, ${positions * FOLLOW_SLOT_BITS}, ${FOLLOW_PARAM})`;
}

/// `prefix` or `alternative`, each read from the gate's position. Unlike the
/// forwarded half in `follow_composed`, `alternative` is spelled here, so every
/// reading it opens already begins at the gate and keeps its mark.
pub fn follow_alternative<S: AsStrSlice, S1: AsStrSlice>(prefix: S, positions: i32, alternative: S1) -> String {
    return `follow_or(${prefix}, ${positions * FOLLOW_SLOT_BITS}, ${alternative})`;
}

/// `cont` with one more reading the slots cannot hold, `open` being
/// `follow_open_set` of the kinds it starts with or a bare
/// `FOLLOW_OPEN_READING`. One field holds one set, so two different sets
/// widen to any kind.
pub fn follow_opened<S: AsStrSlice, S1: AsStrSlice>(cont: S, open: S1) -> String {
    return `follow_open_with(${cont}, ${open})`;
}

/// A `follow_yields` call on the forwarded continuation.
pub fn follow_yields_call<S: AsStrSlice, S1: AsStrSlice>(tokens: S, pos: S1) -> String {
    return follow_yields_call_of(tokens, pos, &FOLLOW_PARAM);
}

/// A `follow_admits` call on the forwarded continuation: whether it can start
/// at `pos`, which an unknown continuation always can.
pub fn follow_admits_call<S: AsStrSlice, S1: AsStrSlice>(tokens: S, pos: S1) -> String {
    return follow_query("follow_admits", tokens, pos, &FOLLOW_PARAM);
}

/// A `follow_resumes` call on the forwarded continuation: whether it is known
/// to start at `pos`. An unknown continuation never is, so it cannot overturn a
/// continuation that yields.
pub fn follow_resumes_call<S: AsStrSlice, S1: AsStrSlice>(tokens: S, pos: S1) -> String {
    return follow_query("follow_resumes", tokens, pos, &FOLLOW_PARAM);
}

/// A `follow_exit_viable` call on the forwarded continuation: whether leaving
/// the rule at `pos` can go on. A known continuation must match as far as it is
/// known; one the caller did not pass on is taken at its first token.
pub fn follow_exit_viable_call<S: AsStrSlice, S1: AsStrSlice>(tokens: S, pos: S1) -> String {
    return follow_query("follow_exit_viable", tokens, pos, &FOLLOW_PARAM);
}

fn follow_query<S: AsStrSlice, S1: AsStrSlice, S2: AsStrSlice, S3: AsStrSlice>(
    query: S,
    tokens: S1,
    pos: S2,
    cont: S3,
) -> String {
    return `${query}(${tokens}, ${pos}, ${cont}, &FOLLOW_SETS, TK_EOF)`;
}

/// `follow_yields_call` where the site is `gated` on the caller's FOLLOW, else "".
pub fn follow_yields_call_if<S: AsStrSlice, S1: AsStrSlice>(gated: bool, tokens: S, pos: S1) -> String {
    return if gated { follow_yields_call(tokens, pos) } else { String::new() };
}

/// A `follow_yields` call on a continuation held in one local.
pub fn follow_yields_call_of<S: AsStrSlice, S1: AsStrSlice, S2: AsStrSlice>(tokens: S, pos: S1, head: S2) -> String {
    return follow_query("follow_yields", tokens, pos, head);
}

/// The caller's own `lr_cont`, handed on where the callee's trailing operand reads it.
pub fn lr_cont_forward(mid_operand_gated: bool) -> String {
    return if mid_operand_gated { ", lr_cont" } else { "" };
}

/// `", <forwarded continuation>"` when the callee declares the parameter, else
/// `""`. Appended after a call's fixed arguments.
pub fn follow_sep(emit_follow: bool) -> String {
    if emit_follow {
        return `, ${follow_forward_args()}`;
    }
    return "";
}

/// The negation of the condition `cond`: `!x` on an operand, `x` on `!x`,
/// `a != b` for `a == b` and back, and `!(cond)` for anything else. Each is
/// already an operand of `&&`.
pub fn negate_cond<S: AsStrSlice>(cond: S) -> String {
    let c = cond.to_string();
    let mut chars: List<char> = c.chars().collect();
    let n = chars.len();
    let lhs = operand_end(&chars, 0);
    if lhs == n {
        return if chars[0] == '!' { collect_range(&chars, 1, n) } else { `!${c}` };
    }
    if is_equality_at(&chars, lhs) && operand_end(&chars, lhs + 4) == n {
        chars[lhs + 1] = if chars[lhs + 1] == '=' { '!' } else { '=' };
        return collect_range(&chars, 0, n);
    }
    return `!(${c})`;
}

/// `cond` as an operand of `&&`: bare when it is a chain of operands and
/// equalities joined by `&&`, parenthesized otherwise.
pub fn and_operand<S: AsStrSlice>(cond: S) -> String {
    let c = cond.to_string();
    let chars: List<char> = c.chars().collect();
    let mut i = 0;
    loop {
        i = operand_end(&chars, i);
        if is_equality_at(&chars, i) {
            i = operand_end(&chars, i + 4);
        }
        if i == chars.len() {
            return c;
        }
        if !spaced_operator_at(&chars, i, '&', '&') {
            return `(${c})`;
        }
        i += 4;
    }
}

/// The end of the operand starting at `start`, or -1 where none does: `!`s,
/// then a path, literal or bracketed group, each followed by calls, indexes and
/// field reads. Recognized rather than inferred from spacing, so a condition
/// carrying a predicate's own text (`vals.a&&vals.b`) is never taken for one.
fn operand_end(chars: &List<char>, start: i32) -> i32 {
    if start < 0 {
        return -1;
    }
    let n = chars.len();
    let mut i = start;
    while i < n && chars[i] == '!' {
        i += 1;
    }
    let mut atom = false;
    while i < n {
        let c = chars[i];
        let end = if c matches { '(' | '[' } {
            delimited_end(chars, i);
        } else if c matches { '"' | '\'' } && !atom {
            scan_closed_string(chars, i).unwrap_or(-1);
        } else if c == '<' && i >= 2 && chars[i - 1] == ':' && chars[i - 2] == ':' {
            delimited_end(chars, i);
        } else if is_id_continue_char(c) || c matches { '.' | ':' } {
            i + 1;
        } else {
            break;
        };
        if end < 0 {
            return -1;
        }
        i = end;
        atom = true;
    }
    return if atom { i } else { -1 };
}

/// The end of the bracket opening at `open`, skipping nested brackets and
/// literals, or -1 where it never closes or holds a template or a comment,
/// whose text this scan does not follow. `-1` only costs parentheses.
fn delimited_end(chars: &List<char>, open: i32) -> i32 {
    let mut depth = 0;
    let mut i = open;
    while i < chars.len() {
        let c = chars[i];
        if c matches { '"' | '\'' } {
            i = scan_closed_string(chars, i).unwrap_or(-1);
            if i < 0 {
                return -1;
            }
            continue;
        }
        if c == '`' || c == '/' && i + 1 < chars.len() && chars[i + 1] matches { '/' | '*' } {
            return -1;
        }
        if c matches { '(' | '[' | '{' } || c == '<' && chars[open] == '<' {
            depth += 1;
        } else if c matches { ')' | ']' | '}' } || c == '>' && chars[open] == '<' {
            depth -= 1;
            if depth == 0 {
                return i + 1;
            }
        }
        i += 1;
    }
    return -1;
}

fn is_equality_at(chars: &List<char>, at: i32) -> bool {
    return spaced_operator_at(chars, at, '=', '=') || spaced_operator_at(chars, at, '!', '=');
}

/// Whether ` <first><second> ` sits at `at`, which is -1 where the scan before
/// it recognized nothing.
fn spaced_operator_at(chars: &List<char>, at: i32, first: char, second: char) -> bool {
    return at >= 0
        && at + 4 <= chars.len()
        && chars[at] == ' '
        && chars[at + 1] == first
        && chars[at + 2] == second
        && chars[at + 3] == ' ';
}
