use { Alternative } from "./ir.wado";

pub fn to_pascal_case(name: &String) -> String {
    let mut result = String::with_capacity(name.len());
    let mut capitalize_next = true;
    for let c of name.chars() {
        if c == '_' {
            capitalize_next = true;
        } else if capitalize_next {
            result.append_char(c.to_ascii_uppercase());
            capitalize_next = false;
        } else {
            result.append_char(c);
        }
    }
    return result;
}

pub fn to_snake_case(name: &String) -> String {
    let mut result = String::with_capacity(name.len() + 4);
    let mut prev_lower = false;
    for let c of name.chars() {
        if c.is_ascii_uppercase() {
            if prev_lower {
                result.append_char('_');
            }
            result.append_char(c.to_ascii_lowercase());
            prev_lower = false;
        } else {
            result.append_char(c);
            prev_lower = c.is_ascii_lowercase();
        }
    }
    return result;
}

pub fn to_lower(name: &String) -> String {
    return name.to_ascii_lowercase();
}

pub fn escape_char(c: char) -> String {
    if c == '\'' {
        return "'\\''";
    }
    if c == '\\' {
        return "'\\\\'";
    }
    if c == '\n' {
        return "'\\n'";
    }
    if c == '\r' {
        return "'\\r'";
    }
    if c == '\t' {
        return "'\\t'";
    }
    let code = c as i32;
    if code >= 32 && code < 127 {
        let mut s = String::with_capacity(3);
        s.append_char('\'');
        s.append_char(c);
        s.append_char('\'');
        return s;
    }
    return `'\\u\{{code:x}\}'`;
}

pub fn escape_string(s: &String) -> String {
    let mut result = String::with_capacity(s.len() + 2);
    result.append_char('"');
    for let c of s.chars() {
        match c {
            '"' => result.append("\\\""),
            '\\' => result.append("\\\\"),
            '\n' => result.append("\\n"),
            '\r' => result.append("\\r"),
            '\t' => result.append("\\t"),
            _ => {
                let code = c as i32;
                if code >= 32 && code < 127 {
                    result.append_char(c);
                } else {
                    result.append(`\\u\{{code:x}\}`);
                }
            },
        }
    }
    result.append_char('"');
    return result;
}

pub fn rule_type_name(name: &String) -> String {
    let mut result = to_pascal_case(name);
    result.append("Node");
    return result;
}

pub fn literal_field_name(text: &String) -> String {
    if *text == "+" {
        return "plus";
    }
    if *text == "-" {
        return "minus";
    }
    if *text == "*" {
        return "star";
    }
    if *text == "/" {
        return "slash";
    }
    if *text == "%" {
        return "percent";
    }
    if *text == "=" {
        return "eq";
    }
    if *text == "!" {
        return "bang";
    }
    if *text == "<" {
        return "lt";
    }
    if *text == ">" {
        return "gt";
    }
    if *text == "&" {
        return "amp";
    }
    if *text == "|" {
        return "pipe";
    }
    if *text == "^" {
        return "caret";
    }
    if *text == "~" {
        return "tilde";
    }
    if *text == "." {
        return "dot";
    }
    if *text == "," {
        return "comma";
    }
    if *text == ":" {
        return "colon";
    }
    if *text == ";" {
        return "semicolon";
    }
    if *text == "(" {
        return "lparen";
    }
    if *text == ")" {
        return "rparen";
    }
    if *text == "{" {
        return "lbrace";
    }
    if *text == "}" {
        return "rbrace";
    }
    if *text == "[" {
        return "lbracket";
    }
    if *text == "]" {
        return "rbracket";
    }
    let mut result = String::with_capacity(text.len() + 4);
    result.append("lit_");
    for let c of text.chars() {
        if c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' {
            result.append_char(c.to_ascii_lowercase());
        } else {
            result.append_char('_');
        }
    }
    return result;
}

pub fn strip_suffix(s: &String, suffix: &String) -> String {
    let s_chars: Array<char> = s.chars().collect();
    let suffix_chars: Array<char> = suffix.chars().collect();
    let s_len = s_chars.len();
    let suf_len = suffix_chars.len();
    if s_len < suf_len {
        return *s;
    }
    for let mut i = 0; i < suf_len; i += 1 {
        if s_chars[s_len - suf_len + i] != suffix_chars[i] {
            return *s;
        }
    }
    let mut result = String::with_capacity(s.len());
    for let mut i = 0; i < s_len - suf_len; i += 1 {
        result.append_char(s_chars[i]);
    }
    return result;
}

pub fn is_simple_cst_group(alts: &Array<Alternative>) -> bool {
    if alts.len() < 2 { return false; }
    for let alt of alts {
        if alt.elements.len() != 1 { return false; }
        if let RuleRef(_) = alt.elements[0] {
            // ok
        } else {
            return false;
        }
    }
    return true;
}

pub fn group_variant_type_name(alts: &Array<Alternative>) -> String {
    let mut result = String::with_capacity(64);
    for let mut i = 0; i < alts.len(); i += 1 {
        if i > 0 { result.append("Or"); }
        if let RuleRef(name) = &alts[i].elements[0] {
            result.append(&to_pascal_case(name));
        }
    }
    result.append("Group");
    return result;
}

pub fn group_field_base_name(alts: &Array<Alternative>) -> String {
    let mut result = String::with_capacity(64);
    for let mut i = 0; i < alts.len(); i += 1 {
        if i > 0 { result.append("_or_"); }
        if let RuleRef(name) = &alts[i].elements[0] {
            result.append(&to_snake_case(name));
        }
    }
    return result;
}

pub fn group_case_name(alt: &Alternative) -> String {
    if let RuleRef(name) = &alt.elements[0] {
        return to_pascal_case(name);
    }
    return "Unknown";
}

pub fn array_contains_str(arr: &Array<String>, value: &String) -> bool {
    for let item of arr {
        if *item == *value {
            return true;
        }
    }
    return false;
}

pub fn literal_const_name(text: &String) -> String {
    let mut result = String::with_capacity(text.len() + 8);
    result.append("TK_LIT_");
    for let c of text.chars() {
        if c.is_ascii_lowercase() {
            result.append_char(c.to_ascii_uppercase());
        } else if c.is_ascii_uppercase() || c >= '0' && c <= '9' {
            result.append_char(c);
        } else {
            match c {
                '{' => result.append("LBRACE"),
                '}' => result.append("RBRACE"),
                '[' => result.append("LBRACKET"),
                ']' => result.append("RBRACKET"),
                '(' => result.append("LPAREN"),
                ')' => result.append("RPAREN"),
                ':' => result.append("COLON"),
                ',' => result.append("COMMA"),
                '.' => result.append("DOT"),
                ';' => result.append("SEMI"),
                '+' => result.append("PLUS"),
                '-' => result.append("MINUS"),
                '*' => result.append("STAR"),
                '/' => result.append("SLASH"),
                '=' => result.append("EQ"),
                '<' => result.append("LT"),
                '>' => result.append("GT"),
                '!' => result.append("BANG"),
                '&' => result.append("AMP"),
                '|' => result.append("PIPE"),
                '^' => result.append("CARET"),
                '~' => result.append("TILDE"),
                _ => result.append_char('_'),
            }
        }
    }
    return result;
}
