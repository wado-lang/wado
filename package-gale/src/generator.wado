use {
    Grammar, ParserRule, Alternative, Element, RepeatElement, LabelElement,
    RepeatKind, LexerRule,
} from "./ir.wado";
use {
    to_pascal_case, to_snake_case, to_lower,
    rule_type_name, literal_field_name, strip_suffix,
} from "./gen_util.wado";
use { collect_literal_tokens, gen_token_constants, gen_lexer } from "./lexer_gen.wado";
use { gen_parser } from "./parser_gen.wado";

pub fn generate(grammar: &Grammar) -> String {
    let mut out = String::with_capacity(8192);
    gen_header(&mut out, &grammar.name);
    gen_runtime(&mut out);
    gen_token_kind(&mut out, &grammar.lexer_rules);
    gen_cst_types(&mut out, &grammar.parser_rules);
    let lit_tokens = collect_literal_tokens(&grammar.parser_rules);
    gen_token_constants(&mut out, &grammar.lexer_rules, &lit_tokens);
    gen_lexer(&mut out, grammar, &lit_tokens);
    gen_parser(&mut out, grammar, &lit_tokens);
    return out;
}

fn gen_header(out: &mut String, name: &String) {
    out.append(`// Generated by Gale from {name}.g4 — do not edit.\n\n`);
}

fn gen_runtime(out: &mut String) {
    out.append(#include_str("./runtime.wado"));
    out.append("\n");
}

fn gen_token_kind(out: &mut String, lexer_rules: &Array<LexerRule>) {
    out.append("pub variant TokenKind {\n");
    for let rule of lexer_rules {
        if !rule.is_fragment {
            out.append(`    {rule.name},\n`);
        }
    }
    out.append("    Eof,\n");
    out.append("    Error,\n");
    out.append("}\n\n");
}

fn gen_cst_types(out: &mut String, parser_rules: &Array<ParserRule>) {
    for let rule of parser_rules {
        gen_parser_rule_type(out, rule);
    }
}

fn gen_parser_rule_type(out: &mut String, rule: &ParserRule) {
    let type_name = rule_type_name(&rule.name);
    if rule.alternatives.len() == 1 {
        gen_struct_for_alt(out, &type_name, &rule.alternatives[0]);
    } else {
        let all_labeled = all_alternatives_labeled(&rule.alternatives);
        out.append(`pub variant {type_name} \{\n`);
        for let mut i = 0; i < rule.alternatives.len(); i += 1 {
            let alt = &rule.alternatives[i];
            let case_name = if all_labeled {
                alt.label.unwrap()
            } else {
                `Alt{i}`
            };
            let struct_name = `{strip_suffix(&type_name, "Node")}{case_name}`;
            out.append(`    {case_name}({struct_name}),\n`);
        }
        out.append("}\n\n");
        gen_variant_eq(out, &type_name, &rule.alternatives, all_labeled);

        for let mut i = 0; i < rule.alternatives.len(); i += 1 {
            let alt = &rule.alternatives[i];
            let case_name = if all_labeled {
                alt.label.unwrap()
            } else {
                `Alt{i}`
            };
            let struct_name = `{strip_suffix(&type_name, "Node")}{case_name}`;
            gen_struct_for_alt(out, &struct_name, alt);
        }
    }
}

fn gen_struct_for_alt(out: &mut String, type_name: &String, alt: &Alternative) {
    let fields = collect_fields(&alt.elements);
    out.append(`pub struct {type_name} \{\n`);
    out.append("    pub span: Span,\n");
    for let field of &fields {
        out.append(`    pub {field.name}: {field.type_str},\n`);
    }
    out.append("}\n\n");
    gen_struct_eq(out, type_name, &fields);
}

// TODO: Remove explicit Eq generation once the compiler supports auto-derive Eq for recursive types.
fn gen_struct_eq(out: &mut String, type_name: &String, fields: &Array<Field>) {
    out.append(`impl Eq for {type_name} \{\n`);
    out.append("    fn eq(&self, other: &Self) -> bool {\n");
    out.append("        return self.span == other.span");
    for let field of fields {
        out.append(` && self.{field.name} == other.{field.name}`);
    }
    out.append(";\n");
    out.append("    }\n");
    out.append("}\n\n");
}

struct Field {
    name: String,
    type_str: String,
}

fn collect_fields(elements: &Array<Element>) -> Array<Field> {
    let mut fields: Array<Field> = [];
    let mut name_counts: Array<[String, i32]> = [];
    for let mut i = 0; i < elements.len(); i += 1 {
        if let Some(field) = element_to_field(&elements[i]) {
            let count = get_name_count(&name_counts, &field.name);
            increment_name_count(&mut name_counts, &field.name);
            let final_name = if count > 0 {
                `{field.name}_{count + 1}`
            } else {
                field.name
            };
            fields.append(Field { name: final_name, type_str: field.type_str });
        }
    }
    return fields;
}

fn get_name_count(counts: &Array<[String, i32]>, name: &String) -> i32 {
    for let entry of counts {
        if entry.0 == *name {
            return entry.1;
        }
    }
    return 0;
}

fn increment_name_count(counts: &mut Array<[String, i32]>, name: &String) {
    for let mut i = 0; i < counts.len(); i += 1 {
        if counts[i].0 == *name {
            let prev = counts[i].1;
            counts[i] = [*name, prev + 1];
            return;
        }
    }
    counts.append([*name, 1]);
}

fn element_to_field(elem: &Element) -> Option<Field> {
    if let RuleRef(name) = *elem {
        return Option::<Field>::Some(Field {
            name: to_snake_case(&name),
            type_str: rule_type_name(&name),
        });
    }
    if let TokenRef(name) = *elem {
        return Option::<Field>::Some(Field {
            name: to_lower(&name),
            type_str: "Token",
        });
    }
    if let Literal(text) = *elem {
        return Option::<Field>::Some(Field {
            name: literal_field_name(&text),
            type_str: "Token",
        });
    }
    if let Repeat(rep) = *elem {
        if let Some(inner) = element_to_field(&rep.element) {
            let field = match rep.kind {
                Star => Field {
                    name: `{inner.name}_list`,
                    type_str: `Array<{inner.type_str}>`,
                },
                Plus => Field {
                    name: `{inner.name}_list`,
                    type_str: `Array<{inner.type_str}>`,
                },
                Optional => Field {
                    name: inner.name,
                    type_str: `Option<{inner.type_str}>`,
                },
            };
            return Option::<Field>::Some(field);
        }
        return null;
    }
    if let Label(lab) = *elem {
        if let Some(inner) = element_to_field(&lab.element) {
            return Option::<Field>::Some(Field {
                name: to_snake_case(&lab.name),
                type_str: inner.type_str,
            });
        }
        return null;
    }
    return null;
}

// TODO: Remove explicit Eq generation once the compiler supports auto-derive Eq for recursive types.
fn gen_variant_eq(out: &mut String, type_name: &String, alts: &Array<Alternative>, all_labeled: bool) {
    out.append(`impl Eq for {type_name} \{\n`);
    out.append("    fn eq(&self, other: &Self) -> bool {\n");
    out.append("        return match [*self, *other] {\n");
    for let mut i = 0; i < alts.len(); i += 1 {
        let case_name = if all_labeled {
            alts[i].label.unwrap()
        } else {
            `Alt{i}`
        };
        out.append(`            [{case_name}(a), {case_name}(b)] => a == b,\n`);
    }
    out.append("            _ => false,\n");
    out.append("        };\n");
    out.append("    }\n");
    out.append("}\n\n");
}

fn all_alternatives_labeled(alts: &Array<Alternative>) -> bool {
    for let alt of alts {
        if let None = alt.label {
            return false;
        }
    }
    return true;
}
