//! Kiln generator entry for Gale.
//!
//! Declared by `[package].generator = "src/generator.wado"` in `wado.toml`.
//! Reads a `.g4` grammar from `raw.primary.content`, parses it with the
//! existing g4 parser, and emits a single entry `.wado` module built from
//! the `./codegen.wado` pipeline.
//!
//! The `gale gen` CLI in `./main.wado` is still exposed for ad-hoc
//! command-line use and is exercised by an end-to-end CLI test, but no
//! production caller depends on it: every in-tree consumer drives Gale
//! through the Kiln invocation surface.
//!
//! The author writes `fn generate(req: Request<Options>)`; the
//! compiler's `inject_kiln_request_adapter` phase rewrites it into the
//! wire shape — a `primary` parameter, an `inputs` parameter, and a
//! typed `options: Options` parameter — and rebuilds `req` as a local,
//! so the body below sees `Request<Options>` unchanged. See WEP
//! 2026-04-12 §"Authoring a generator".

use {
    Request,
    Response,
    Error,
    OutputFile,
    KilnHost,
    Diagnostic as KilnDiagnostic,
    DiagnosticLevel,
    InputFile,
    read_text,
} from "core:kiln";
use { assemble_grammar, AssembleError } from "./g4/parser.wado";
use { generate as codegen_generate, GenerateOptions } from "./codegen.wado";
use { parse_highlight_query, HighlightRule } from "./highlight_query.wado";
use { diagnostic_level } from "./gir.wado";
use { Level } from "core:log";
use { to_snake_case } from "./gen_util.wado";
use { Deserialize } from "core:serde";

/// Generator-side options. Surfaced under `options = { ... }` at a
/// consuming `use ... with { generator: { options: { ... } } }` site.
///
/// The shape mirrors the legacy `gale gen` CLI flags; extend here as new
/// flags land (WEP 2026-04-12 M6.7 checklist).
pub struct Options {
    /// Emit trace logging to stderr in the generated parser: rule
    /// enter/ok/fail frames plus multi-alt scan/pick/try decisions. Off by
    /// default; set `trace: true` to debug why a grammar rejects an input.
    pub trace: bool = false,
    /// Rule names a fragment is a sequence of, for tooling (highlight / LSP);
    /// e.g. `["statement"]`. Empty is byte-identical. See "Parsing a fragment"
    /// in the README.
    pub fragment_entries: List<String>,
}

impl Deserialize for Options;

/// Why a file's `type` is not one Gale reads: the primary is a grammar,
/// `"antlr4"` by default, and an input a grammar or a highlight query.
fn type_refusal(primary: &InputFile, inputs: &List<InputFile>) -> Option<String> {
    if let Some(other) = primary.type && other != "antlr4" {
        return Option::Some(`gale: '${primary.path}' is given \`type: "${other}"\`; a grammar is \`type: "antlr4"\``);
    }
    for let input of *inputs {
        if let Some(other) = input.type && other != "antlr4" && other != "tree-sitter-highlights" {
            return Option::Some(
                `gale: '${input.path}' is given \`type: "${other}"\`; an input is \`type: "antlr4"\` or \`type: "tree-sitter-highlights"\``,
            );
        }
    }
    return null;
}

/// The grammars, the primary first, and the highlight queries the request
/// carries, each `[path, text]`. A stream is outside drop elaboration, so every
/// one is read or dropped before any return.
fn read_inputs(
    primary: InputFile,
    inputs: List<InputFile>,
) -> Result<[List<[String, String]>, List<[String, String]>], Error> {
    if let Some(reason) = type_refusal(&primary, &inputs) {
        primary.content.drop();
        for let input of inputs {
            input.content.drop();
        }
        return Result::Err(Error::Unsupported(reason));
    }
    let mut files: List<InputFile> = [primary];
    files.extend(&inputs);
    let mut grammars: List<[String, String]> = [];
    let mut queries: List<[String, String]> = [];
    for let mut i = 0; i < files.len(); i += 1 {
        let file = files[i];
        let text = match read_text(file.content) {
            Ok(text) => text,
            Err(e) => {
                for let rest of files[i + 1..<files.len()].to_list() {
                    rest.content.drop();
                }
                return Result::Err(Error::InvalidSchema(`gale: '${file.path}' is not UTF-8: ${e}`));
            },
        };
        if file.type matches { Some("tree-sitter-highlights") } {
            queries.push([file.path, text]);
        } else {
            grammars.push([file.path, text]);
        }
    }
    return Result::Ok([grammars, queries]);
}

/// Kiln entry point. Called by the compiler via
/// `core:kiln/generator.generate` when `[build.generators.*]` references
/// this package as its `module`. The compiler rewrites the
/// `Request<Options>` form to the internal `RawRequest` +
/// `bind_request` shape during
/// `kiln::import_check::inject_kiln_request_adapter` (runs before
/// analyze).
export fn generate(req: Request<Options>) -> Result<Response, Error> with KilnHost {
    // Stamp the real Kiln paths; otherwise the generated header's
    // `sources = [...]` fabricates a nonexistent `<GrammarName>.g4`. A
    // `"tree-sitter-highlights"` input is a highlight query, compiled into the
    // highlighter, and every other file a grammar half merged into the primary.
    let primary_path = req.primary.path;
    let [g4_inputs, scm_inputs] = read_inputs(req.primary, req.inputs)?;
    let mut grammar = match assemble_grammar(&g4_inputs) {
        Ok(g) => g,
        Err(Parse(pe)) => {
            let which = if pe.0 == primary_path { "primary" } else { "supplementary" };
            return Result::Err(Error::InvalidSchema(
                `gale: failed to parse ${which} grammar '${pe.0}': ${pe.1}`,
            ));
        },
        Err(Check(msg)) => {
            return Result::Err(Error::InvalidSchema(
                `gale: unresolved rule references in '${primary_path}': ${msg}`,
            ));
        },
    };

    // Parse each `.scm` separately so an error reports the file it came from
    // with its own line/column, then concatenate the rule lists.
    let mut highlight_query: Option<List<HighlightRule>> = null;
    if scm_inputs.len() > 0 {
        let mut all_rules: List<HighlightRule> = [];
        for let scm of &scm_inputs {
            match parse_highlight_query(&scm.1) {
                Ok(rules) => {
                    for let r of rules {
                        all_rules.push(r);
                    }
                },
                Err(e) => {
                    return Result::Err(Error::InvalidSchema(
                        `gale: invalid highlight query '${scm.0}' at ${e.line}:${e.col}: ${e.message}`,
                    ));
                },
            }
        }
        highlight_query = Option::Some(all_rules);
    }

    let gen_opts = GenerateOptions {
        highlight_query,
        trace: req.options.trace,
        fragment_entries: req.options.fragment_entries,
    };
    let generated = codegen_generate(&mut grammar, &gen_opts);
    // Surface Gale's prediction-strategy diagnostics through the Kiln host, at
    // the level `gir::diagnostic_level` gives each kind — the same level the
    // `gale gen` CLI emits it at, so a grammar built either way is read the same
    // way. Gale diagnostics carry no source span yet, so the label leads the text.
    for let d of &generated.diagnostics {
        if let Some(level) = diagnostic_level(&d.kind) {
            KilnHost::emit_diagnostic(KilnDiagnostic {
                level: kiln_level(level),
                span: null,
                message: `gale: ${d.owner.label()}: ${d.message}`,
            });
        }
    }
    let wado_source = generated.source;

    // Kiln entry module name mirrors Gale's CLI convention: snake-case
    // the grammar name. Reuses `gen_util::to_snake_case` so the filename
    // stays in lockstep with the identifiers the generated parser emits.
    // Consumers import the generated module via the
    // `use { X } from "./path/to/grammar.g4"` redirect that the Kiln
    // pipeline installs.
    let entry_name = to_snake_case(&grammar.name);
    let files: List<OutputFile> = [
        OutputFile {
            path: `${entry_name}.wado`,
            content: wado_source,
            is_entry: true,
        },
    ];
    return Result::Ok(Response { files });
}

/// Gale's diagnostic level as a Kiln one. Kiln has no `Debug` or `Trace`, so
/// both land on `Hint`, its quietest.
fn kiln_level(level: Level) -> DiagnosticLevel {
    return match level {
        Error => DiagnosticLevel::Error,
        Warn => DiagnosticLevel::Warning,
        Info => DiagnosticLevel::Info,
        Debug | Trace => DiagnosticLevel::Hint,
    };
}
