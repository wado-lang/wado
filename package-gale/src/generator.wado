use { Grammar, ParserRule, Alternative, Element, RepeatElement, LabelElement, RepeatKind, LexerRule } from "./ir.wado";
use { to_pascal_case, to_snake_case, to_lower, rule_type_name, literal_field_name, strip_suffix, array_contains_str } from "./gen_util.wado";
use { collect_literal_tokens, gen_token_constants, gen_lexer } from "./lexer_gen.wado";
use { gen_parser } from "./parser_gen.wado";
use { gen_visitor } from "./visitor_gen.wado";
use { CodeWriter, StructSpec, VariantSpec, EnumSpec } from "./wadopoet.wado";

pub fn generate(grammar: &Grammar) -> String {
    let mut w = CodeWriter::new();
    gen_header(&mut w, &grammar.name);
    gen_runtime(&mut w);
    gen_token_kind(&mut w, &grammar.lexer_rules);
    gen_cst_types(&mut w, &grammar.parser_rules);
    let lit_tokens = collect_literal_tokens(&grammar.parser_rules);
    gen_token_constants(&mut w, &grammar.lexer_rules, &lit_tokens);
    gen_lexer(&mut w, grammar, &lit_tokens);
    gen_parser(&mut w, grammar, &lit_tokens);
    gen_visitor(&mut w, grammar);
    return w.to_string();
}

fn gen_header(w: &mut CodeWriter, name: &String) {
    w.line(`// Generated by Gale from {name}.g4 — do not edit.`);
    w.blank();
}

fn gen_runtime(w: &mut CodeWriter) {
    w.raw(#include_str("./runtime.wado"));
    w.raw("\n");
}

fn gen_token_kind(w: &mut CodeWriter, lexer_rules: &Array<LexerRule>) {
    let mut e = EnumSpec::new("TokenKind");
    e.set_pub();
    for let rule of lexer_rules {
        if !rule.is_fragment {
            e.add_member(&rule.name);
        }
    }
    e.add_member("Eof");
    e.add_member("Error");
    e.emit(w);
    w.blank();
}

fn gen_cst_types(w: &mut CodeWriter, parser_rules: &Array<ParserRule>) {
    for let rule of parser_rules {
        gen_parser_rule_type(w, rule);
    }
}

fn gen_parser_rule_type(w: &mut CodeWriter, rule: &ParserRule) {
    let type_name = rule_type_name(&rule.name);
    if rule.alternatives.len() == 1 {
        gen_struct_for_alt(w, &type_name, &rule.alternatives[0]);
    } else {
        let all_labeled = all_alternatives_labeled(&rule.alternatives);
        let base = strip_suffix(&type_name, "Node");
        let mut v = VariantSpec::new(&type_name);
        v.set_pub();
        for let mut i = 0; i < rule.alternatives.len(); i += 1 {
            let alt = &rule.alternatives[i];
            let case_name = if all_labeled { alt.label.unwrap() } else { `Alt{i}` };
            let struct_name = `{base}{case_name}`;
            v.add_case_with_payload(&case_name, &struct_name);
        }
        v.emit(w);
        w.blank();

        for let mut i = 0; i < rule.alternatives.len(); i += 1 {
            let alt = &rule.alternatives[i];
            let case_name = if all_labeled { alt.label.unwrap() } else { `Alt{i}` };
            let struct_name = `{base}{case_name}`;
            gen_struct_for_alt(w, &struct_name, alt);
        }
    }
}

fn gen_struct_for_alt(w: &mut CodeWriter, type_name: &String, alt: &Alternative) {
    gen_group_types_in_elements(w, &alt.elements);
    let fields = collect_fields(&alt.elements);
    let mut s = StructSpec::new(type_name);
    s.set_pub();
    s.add_pub_field("span", "Span");
    for let field of &fields {
        s.add_pub_field(&field.name, &field.type_str);
    }
    s.emit(w);
    w.blank();
}

struct Field {
    name: String,
    type_str: String,
}

fn collect_fields(elements: &Array<Element>) -> Array<Field> {
    let mut fields: Array<Field> = [];
    let mut name_counts: Array<[String, i32]> = [];
    for let mut i = 0; i < elements.len(); i += 1 {
        if let Some(field) = element_to_field(&elements[i]) {
            let count = get_name_count(&name_counts, &field.name);
            increment_name_count(&mut name_counts, &field.name);
            let final_name = if count > 0 { `{field.name}_{count + 1}` } else { field.name };
            fields.append(Field { name: final_name, type_str: field.type_str });
        }
    }
    return fields;
}

fn get_name_count(counts: &Array<[String, i32]>, name: &String) -> i32 {
    for let entry of counts {
        if entry.0 == *name {
            return entry.1;
        }
    }
    return 0;
}

fn increment_name_count(counts: &mut Array<[String, i32]>, name: &String) {
    for let mut i = 0; i < counts.len(); i += 1 {
        if counts[i].0 == *name {
            let prev = counts[i].1;
            counts[i] = [*name, prev + 1];
            return;
        }
    }
    counts.append([*name, 1]);
}

fn element_to_field(elem: &Element) -> Option<Field> {
    if let RuleRef(name) = *elem {
        return Option::<Field>::Some(Field {
            name: to_snake_case(&name),
            type_str: rule_type_name(&name),
        });
    }
    if let TokenRef(name) = *elem {
        return Option::<Field>::Some(Field {
            name: to_lower(&name),
            type_str: "Token",
        });
    }
    if let Literal(text) = *elem {
        return Option::<Field>::Some(Field {
            name: literal_field_name(&text),
            type_str: "Token",
        });
    }
    if let Group(alts) = *elem {
        if group_can_store(&alts) {
            let gtn = group_type_name_from_alts(&alts);
            return Option::<Field>::Some(Field { name: "group", type_str: gtn });
        }
        return null;
    }
    if let Repeat(rep) = *elem {
        if let Some(inner) = element_to_field(&rep.element) {
            let field = match rep.kind {
                Star | Plus => Field {
                    name: `{inner.name}_list`,
                    type_str: `Array<{inner.type_str}>`,
                },
                Optional => Field {
                    name: inner.name,
                    type_str: `Option<{inner.type_str}>`,
                },
            };
            return Option::<Field>::Some(field);
        }
        return null;
    }
    if let Label(lab) = *elem {
        if let Some(inner) = element_to_field(&lab.element) {
            return Option::<Field>::Some(Field {
                name: to_snake_case(&lab.name),
                type_str: inner.type_str,
            });
        }
        return null;
    }
    return null;
}

fn all_alternatives_labeled(alts: &Array<Alternative>) -> bool {
    for let alt of alts {
        if let None = alt.label {
            return false;
        }
    }
    return true;
}

pub fn group_can_store(alts: &Array<Alternative>) -> bool {
    // Only multi-alt groups with single-element alternatives are storable.
    // Single-alt groups have variable name scoping issues and are deferred.
    if alts.len() <= 1 {
        return false;
    }
    // Each alt must be a single RuleRef (not TokenRef/Literal, which can have
    // overlapping FIRST sets and trigger backtracking that doesn't store results).
    for let alt of alts {
        if alt.elements.len() != 1 { return false; }
        if let RuleRef(_) = alt.elements[0] {} else { return false; }
    }
    return true;
}

pub fn group_type_name_from_alts(alts: &Array<Alternative>) -> String {
    let mut parts: Array<String> = [];
    for let alt of alts {
        if alt.elements.len() == 1 {
            if let RuleRef(name) = alt.elements[0] { parts.append(to_pascal_case(&name)); }
            else if let TokenRef(name) = alt.elements[0] { parts.append(to_pascal_case(&name)); }
            else if let Literal(text) = alt.elements[0] { parts.append(to_pascal_case(&literal_field_name(&text))); }
            else { parts.append(`Alt{parts.len()}`); }
        } else { parts.append(`Alt{parts.len()}`); }
    }
    let mut name = String::with_capacity(64);
    for let mut i = 0; i < parts.len(); i += 1 {
        if i > 0 { name.append("Or"); }
        name.append(parts[i]);
    }
    name.append("Group");
    return name;
}

pub fn group_alt_case_info(alt: &Alternative, index: i32) -> [String, String] {
    if alt.elements.len() == 1 {
        if let RuleRef(name) = alt.elements[0] {
            let pc = to_pascal_case(&name);
            return [pc, `{to_pascal_case(&name)}Node`];
        }
        if let TokenRef(name) = alt.elements[0] {
            let pc = to_pascal_case(&name);
            return [pc, `{pc}Payload`];
        }
    }
    return [`Alt{index}`, `GroupAlt{index}`];
}

fn extract_group_alts(elem: &Element) -> Option<Array<Alternative>> {
    if let Group(alts) = *elem { return Option::Some(alts); }
    if let Repeat(rep) = *elem { return extract_group_alts(&rep.element); }
    if let Label(lab) = *elem { return extract_group_alts(&lab.element); }
    return null;
}

fn gen_group_types_in_elements(w: &mut CodeWriter, elements: &Array<Element>) {
    let mut seen: Array<String> = [];
    for let elem of elements {
        if let Some(alts) = extract_group_alts(&elem) {
            if group_can_store(&alts) {
                let gtn = group_type_name_from_alts(&alts);
                if !array_contains_str(&seen, &gtn) {
                    seen.append(gtn);
                    gen_group_type_def(w, &group_type_name_from_alts(&alts), &alts);
                }
            }
        }
    }
}

fn gen_group_type_def(w: &mut CodeWriter, type_name: &String, alts: &Array<Alternative>) {
    if alts.len() == 1 {
        gen_group_types_in_elements(w, &alts[0].elements);
        let fields = collect_fields(&alts[0].elements);
        let mut s = StructSpec::new(type_name);
        s.set_pub();
        s.add_pub_field("span", "Span");
        for let field of &fields { s.add_pub_field(&field.name, &field.type_str); }
        s.emit(w);
        w.blank();
    } else {
        let mut v = VariantSpec::new(type_name);
        v.set_pub();
        for let mut i = 0; i < alts.len(); i += 1 {
            let ci = group_alt_case_info(&alts[i], i);
            v.add_case_with_payload(&ci.0, &ci.1);
        }
        v.emit(w);
        w.blank();
        // Only generate case structs for non-RuleRef alternatives.
        // RuleRef alternatives reuse existing Node types (e.g., SqlStmtListNode).
        for let mut i = 0; i < alts.len(); i += 1 {
            if let RuleRef(_) = alts[i].elements[0] {
                // Reuses existing node type — no struct to generate
            } else {
                let ci = group_alt_case_info(&alts[i], i);
                gen_group_types_in_elements(w, &alts[i].elements);
                let fields = collect_fields(&alts[i].elements);
                let mut s = StructSpec::new(&ci.1);
                s.set_pub();
                s.add_pub_field("span", "Span");
                for let field of &fields { s.add_pub_field(&field.name, &field.type_str); }
                s.emit(w);
                w.blank();
            }
        }
    }
}
