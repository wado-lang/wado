use { Grammar, ParserRule, Alternative, Element, RepeatElement, LabelElement, RepeatKind, LexerRule } from "./ir.wado";
use {
    to_pascal_case,
    to_snake_case,
    to_lower,
    rule_type_name,
    literal_field_name,
    strip_suffix,
    is_simple_cst_group,
    is_token_only_group,
    is_single_alt_group,
    is_storable_group,
    group_variant_type_name,
    group_field_base_name,
    group_case_name,
    single_alt_group_type_name,
    single_alt_group_field_name,
    token_group_field_name,
} from "./gen_util.wado";
use { collect_literal_tokens, gen_token_constants, gen_lexer } from "./lexer_gen.wado";
use { gen_parser } from "./parser_gen.wado";
use { gen_visitor } from "./visitor_gen.wado";
use { GenContext } from "./gen_context.wado";
use { CodeWriter, StructSpec, VariantSpec, EnumSpec } from "./wadopoet.wado";

pub fn generate(grammar: &Grammar) -> String {
    let mut w = CodeWriter::new();
    gen_header(&mut w, &grammar.name);
    gen_runtime(&mut w);
    gen_token_kind(&mut w, &grammar.lexer_rules);
    gen_cst_types(&mut w, &grammar.parser_rules);
    let lit_tokens = collect_literal_tokens(&grammar.parser_rules);
    gen_token_constants(&mut w, &grammar.lexer_rules, &lit_tokens);
    gen_lexer(&mut w, grammar, &lit_tokens);
    let mut ctx = GenContext::new(&grammar.parser_rules, &lit_tokens);
    gen_parser(&mut w, grammar, &mut ctx);
    gen_visitor(&mut w, grammar);
    return w.to_string();
}

fn gen_header(w: &mut CodeWriter, name: &String) {
    w.line("#![generated]");
    w.line(`// Generated by Gale from {name}.g4 — do not edit.`);
    w.blank();
}

fn gen_runtime(w: &mut CodeWriter) {
    w.raw(#include_str("./runtime.wado"));
    w.raw("\n");
}

fn gen_token_kind(w: &mut CodeWriter, lexer_rules: &Array<LexerRule>) {
    let mut e = EnumSpec::new("TokenKind");
    e.set_pub();
    for let rule of lexer_rules {
        if !rule.is_fragment {
            e.add_member(&rule.name);
        }
    }
    e.add_member("Eof");
    e.add_member("Error");
    e.emit(w);
    w.blank();
}

fn gen_cst_types(w: &mut CodeWriter, parser_rules: &Array<ParserRule>) {
    let mut emitted: Array<String> = [];
    for let rule of parser_rules {
        gen_parser_rule_type(w, rule, &mut emitted);
    }
}

fn gen_parser_rule_type(w: &mut CodeWriter, rule: &ParserRule, emitted: &mut Array<String>) {
    let type_name = rule_type_name(&rule.name);
    if rule.alternatives.len() == 1 {
        gen_struct_for_alt(w, &type_name, &rule.alternatives[0], emitted);
    } else {
        let all_labeled = all_alternatives_labeled(&rule.alternatives);
        let base = strip_suffix(&type_name, "Node");
        let mut v = VariantSpec::new(&type_name);
        v.set_pub();
        for let mut i = 0; i < rule.alternatives.len(); i += 1 {
            let alt = &rule.alternatives[i];
            let case_name = if all_labeled { alt.label.unwrap() } else { `Alt{i}` };
            let struct_name = `{base}{case_name}`;
            v.add_case_with_payload(&case_name, &struct_name);
        }
        v.emit(w);
        w.blank();

        for let mut i = 0; i < rule.alternatives.len(); i += 1 {
            let alt = &rule.alternatives[i];
            let case_name = if all_labeled { alt.label.unwrap() } else { `Alt{i}` };
            let struct_name = `{base}{case_name}`;
            gen_struct_for_alt(w, &struct_name, alt, emitted);
        }
    }
}

fn gen_struct_for_alt(w: &mut CodeWriter, type_name: &String, alt: &Alternative, emitted: &mut Array<String>) {
    gen_group_variant_types(w, &alt.elements, emitted);
    let fields = collect_fields(&alt.elements);
    let mut s = StructSpec::new(type_name);
    s.set_pub();
    s.add_pub_field("span", "Span");
    for let field of &fields {
        s.add_pub_field(&field.name, &field.type_str);
    }
    s.emit(w);
    w.blank();
}

fn repeat_inner_field(elem: &Element) -> Option<Field> {
    if let Group(alts) = elem {
        if is_simple_cst_group(alts) {
            return Option::<Field>::Some(Field {
                name: group_field_base_name(alts),
                type_str: group_variant_type_name(alts),
            });
        }
        if is_token_only_group(alts) {
            return Option::<Field>::Some(Field {
                name: token_group_field_name(alts),
                type_str: "Token",
            });
        }
        if is_single_alt_group(&alts) {
            return Option::<Field>::Some(Field {
                name: single_alt_group_field_name(&alts[0]),
                type_str: single_alt_group_type_name(&alts[0]),
            });
        }
        return null;
    }
    return element_to_field(elem);
}

fn gen_group_variant_types(w: &mut CodeWriter, elements: &Array<Element>, emitted: &mut Array<String>) {
    for let elem of elements {
        gen_element_variant_types(w, &elem, emitted);
    }
}

fn gen_element_variant_types(w: &mut CodeWriter, elem: &Element, emitted: &mut Array<String>) {
    let alts = extract_group_alts(elem);
    if let Some(group_alts) = alts {
        if is_simple_cst_group(group_alts) {
            let type_name = group_variant_type_name(group_alts);
            if !has_emitted(emitted, &type_name) {
                emitted.push(type_name);
                gen_group_variant_type(w, group_alts);
            }
        } else if is_single_alt_group(group_alts) {
            let type_name = single_alt_group_type_name(&group_alts[0]);
            if !has_emitted(emitted, &type_name) {
                emitted.push(type_name);
                gen_single_alt_group_struct(w, &group_alts[0], emitted);
            }
        } else {
            // Recurse into multi-alt groups to find nested storable groups
            for let alt of group_alts {
                gen_group_variant_types(w, &alt.elements, emitted);
            }
        }
        return;
    }
    // Recurse into repeat elements (non-group inner)
    if let Repeat(rep) = elem {
        gen_element_variant_types(w, &rep.element, emitted);
        return;
    }
    // Recurse into label elements
    if let Label(lab) = elem {
        gen_element_variant_types(w, &lab.element, emitted);
    }
}

fn has_emitted(emitted: &Array<String>, name: &String) -> bool {
    for let e of emitted {
        if *e == *name {
            return true;
        }
    }
    return false;
}

fn extract_group_alts(elem: &Element) -> Option<&Array<Alternative>> {
    if let Group(alts) = elem {
        return Option::Some(alts);
    }
    if let Repeat(rep) = elem {
        if let Group(alts) = &rep.element {
            return Option::Some(alts);
        }
    }
    return null;
}

fn gen_group_variant_type(w: &mut CodeWriter, alts: &Array<Alternative>) {
    let type_name = group_variant_type_name(alts);
    let mut v = VariantSpec::new(&type_name);
    v.set_pub();
    for let alt of alts {
        if let RuleRef(name) = &alt.elements[0] {
            let case_name = to_pascal_case(name);
            let payload = rule_type_name(name);
            v.add_case_with_payload(&case_name, &payload);
        }
    }
    v.emit(w);
    w.blank();
}

fn gen_single_alt_group_struct(w: &mut CodeWriter, alt: &Alternative, emitted: &mut Array<String>) {
    gen_group_variant_types(w, &alt.elements, emitted);
    let type_name = single_alt_group_type_name(alt);
    let fields = collect_fields(&alt.elements);
    let mut s = StructSpec::new(&type_name);
    s.set_pub();
    for let field of &fields {
        s.add_pub_field(&field.name, &field.type_str);
    }
    s.emit(w);
    w.blank();
}

struct Field {
    name: String,
    type_str: String,
}

fn collect_fields(elements: &Array<Element>) -> Array<Field> {
    let mut fields: Array<Field> = [];
    let mut name_counts: Array<[String, i32]> = [];
    for let mut i = 0; i < elements.len(); i += 1 {
        if let Some(field) = element_to_field(&elements[i]) {
            let count = get_name_count(&name_counts, &field.name);
            increment_name_count(&mut name_counts, &field.name);
            let final_name = if count > 0 { `{field.name}_{count + 1}` } else { field.name };
            fields.push(Field { name: final_name, type_str: field.type_str });
        }
    }
    return fields;
}

fn get_name_count(counts: &Array<[String, i32]>, name: &String) -> i32 {
    for let entry of counts {
        if entry.0 == *name {
            return entry.1;
        }
    }
    return 0;
}

fn increment_name_count(counts: &mut Array<[String, i32]>, name: &String) {
    for let mut i = 0; i < counts.len(); i += 1 {
        if counts[i].0 == *name {
            let prev = counts[i].1;
            counts[i] = [*name, prev + 1];
            return;
        }
    }
    counts.push([*name, 1]);
}

fn element_to_field(elem: &Element) -> Option<Field> {
    if let RuleRef(name) = elem {
        return Option::<Field>::Some(Field {
            name: to_snake_case(name),
            type_str: rule_type_name(name),
        });
    }
    if let TokenRef(name) = elem {
        return Option::<Field>::Some(Field {
            name: to_lower(name),
            type_str: "Token",
        });
    }
    if let Literal(text) = elem {
        return Option::<Field>::Some(Field {
            name: literal_field_name(text),
            type_str: "Token",
        });
    }
    if let Repeat(rep) = elem {
        let inner_field = repeat_inner_field(&rep.element);
        if let Some(inner) = inner_field {
            let field = match rep.kind {
                Star | Plus => Field {
                    name: `{inner.name}_list`,
                    type_str: `Array<{inner.type_str}>`,
                },
                Optional => Field {
                    name: inner.name,
                    type_str: `Option<{inner.type_str}>`,
                },
            };
            return Option::<Field>::Some(field);
        }
        return null;
    }
    if let Label(lab) = elem {
        if let Some(inner) = element_to_field(&lab.element) {
            return Option::<Field>::Some(Field {
                name: to_snake_case(&lab.name),
                type_str: inner.type_str,
            });
        }
        return null;
    }
    if let Group(alts) = elem {
        if is_simple_cst_group(alts) {
            return Option::<Field>::Some(Field {
                name: group_field_base_name(alts),
                type_str: `Option<{group_variant_type_name(alts)}>`,
            });
        }
        if is_token_only_group(alts) {
            return Option::<Field>::Some(Field {
                name: token_group_field_name(alts),
                type_str: "Token",
            });
        }
        if is_single_alt_group(alts) {
            return Option::<Field>::Some(Field {
                name: single_alt_group_field_name(&alts[0]),
                type_str: `Option<{single_alt_group_type_name(&alts[0])}>`,
            });
        }
        return null;
    }
    return null;
}

fn all_alternatives_labeled(alts: &Array<Alternative>) -> bool {
    for let alt of alts {
        if let None = alt.label {
            return false;
        }
    }
    return true;
}
