//! Kiln generator entry for Gale.
//!
//! Declared by `[package].generator = "src/generator.wado"` in `wado.toml`.
//! Reads a `.g4` grammar from `raw.primary.content`, parses it with the
//! existing g4 parser, and emits a single entry `.wado` module built from
//! the `./codegen.wado` pipeline.
//!
//! The `gale gen` CLI in `./main.wado` is still exposed for ad-hoc
//! command-line use and is exercised by an end-to-end CLI test, but no
//! production caller depends on it: every in-tree consumer drives Gale
//! through the Kiln invocation surface.
//!
//! v2 ergonomics (WEP 2026-04-12 §"M6.5 stage 2"): the author writes
//! `fn generate(req: Request<Options>)` and the compiler's
//! `inject_kiln_request_adapter` phase rewrites the signature to
//! `fn generate(req: RawRequest)` with
//! `let req = bind_request::<Options>(req)?;` prepended. The v1
//! explicit form still compiles for packages that prefer it.

use { Request, Response, Error, OutputFile, KilnHost, Diagnostic as KilnDiagnostic, DiagnosticLevel } from "core:kiln";
use { parse } from "./g4/parser.wado";
use { Grammar, merge_grammars, check_references, synthesize_implicit_tokens } from "./ir.wado";
use { generate as codegen_generate, GenerateOptions } from "./codegen.wado";
use { to_snake_case } from "./gen_util.wado";

/// Generator-side options. Surfaced under `options = { ... }` on the
/// consuming project's `[build.generators.<name>]` table or at an inline
/// `use ... with { generator: { options: { ... } } }` site.
///
/// The shape mirrors the legacy `gale gen` CLI flags; extend here as new
/// flags land (WEP 2026-04-12 M6.7 checklist).
pub struct Options {
    /// Emit the optional `highlight` table in the generated parser.
    pub highlight: bool,
}

impl Deserialize for Options;

/// Kiln entry point. Called by the compiler via
/// `core:kiln/generator.generate` when `[build.generators.*]` references
/// this package as its `module`. The compiler rewrites the
/// `Request<Options>` form to the internal `RawRequest` +
/// `bind_request` shape during
/// `kiln::import_check::inject_kiln_request_adapter` (runs before
/// analyze).
export fn generate(req: Request<Options>) -> Result<Response, Error> with KilnHost {
    // Parse the primary grammar plus any supplementary grammars listed in
    // `inputs` (e.g. a sibling lexer grammar for a split parser grammar).
    // `merge_grammars` handles the single-grammar case by returning the
    // input unchanged, so the fast path stays fast.
    let mut grammars: Array<Grammar> = [];
    match parse(req.primary.content) {
        Ok(g) => grammars.push(g),
        Err(e) => {
            return Result::Err(Error::InvalidSchema(
                `gale: failed to parse primary grammar '{req.primary.path}': {e.message}`,
            ));
        },
    }
    for let supp of &req.inputs {
        match parse(supp.content) {
            Ok(g) => grammars.push(g),
            Err(e) => {
                return Result::Err(Error::InvalidSchema(
                    `gale: failed to parse supplementary grammar '{supp.path}': {e.message}`,
                ));
            },
        }
    }

    let mut grammar = merge_grammars(grammars);

    // Must run before `check_references`. See `ir.wado` for rationale.
    synthesize_implicit_tokens(&mut grammar);

    match check_references(&grammar) {
        Ok(_) => {
        },
        Err(e) => {
            return Result::Err(Error::InvalidSchema(
                `gale: unresolved rule references in '{req.primary.path}': {e.message}`,
            ));
        },
    }

    let gen_opts = GenerateOptions { highlight: req.options.highlight };
    let generated = codegen_generate(&mut grammar, &gen_opts);
    // Surface Gale's prediction-strategy diagnostics through the Kiln host so
    // they appear as normal compile warnings. The Kiln surface is the
    // production entry (the `gale gen` CLI prints the same warnings on
    // stderr), so a grammar built either way gets identical visibility. Gale
    // diagnostics carry no source span yet, so the rule label leads the text.
    for let d of &generated.diagnostics {
        KilnHost::emit_diagnostic(KilnDiagnostic {
            level: DiagnosticLevel::Warning,
            span: null,
            message: `gale: {d.rule}: {d.message}`,
        });
    }
    let wado_source = generated.source;

    // Kiln entry module name mirrors Gale's CLI convention: snake-case
    // the grammar name. Reuses `gen_util::to_snake_case` so the filename
    // stays in lockstep with the identifiers the generated parser emits.
    // Consumers import the generated module via the
    // `use { X } from "./path/to/grammar.g4"` redirect that the Kiln
    // pipeline installs.
    let entry_name = to_snake_case(&grammar.name);
    let files: Array<OutputFile> = [
        OutputFile {
            path: `{entry_name}.wado`,
            content: wado_source,
            is_entry: true,
        },
    ];
    return Result::Ok(Response { files });
}
