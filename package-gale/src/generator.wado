use { Grammar, ParserRule, Alternative, Element, RepeatElement, LabelElement, NotElement, RepeatKind, LexerRule } from "./ir.wado";
use {
    to_pascal_case,
    to_snake_case,
    to_lower,
    escape_ident,
    rule_type_name,
    literal_field_name,
    not_element_field_name,
    strip_suffix,
    case_names_for_rule,
    is_simple_cst_group,
    is_token_only_group,
    is_single_alt_group,
    is_storable_group,
    is_general_group,
    group_variant_type_name,
    group_field_base_name,
    group_case_name,
    single_alt_group_type_name,
    single_alt_group_field_name,
    token_group_field_name,
    general_group_type_name,
    general_group_field_name,
    general_group_alt_struct_name,
    count_element_groups,
    count_general_groups,
} from "./gen_util.wado";
use { collect_literal_tokens, gen_token_constants, gen_lexer } from "./lexer_gen.wado";
use { gen_parser } from "./parser_gen.wado";
use { gen_visitor } from "./visitor_gen.wado";
use { gen_highlight } from "./highlight_gen.wado";
use { GenContext } from "./gen_context.wado";
use { CodeWriter, StructSpec, VariantSpec, EnumSpec } from "./wadopoet.wado";

pub struct GenerateOptions {
    pub highlight: bool,
}

pub fn generate(grammar: &Grammar, options: &GenerateOptions) -> String {
    let mut w = CodeWriter::new();
    gen_header(&mut w, &grammar.name);
    gen_runtime(&mut w);
    gen_token_kind(&mut w, &grammar.lexer_rules);
    gen_cst_types(&mut w, &grammar.parser_rules);
    let lit_tokens = collect_literal_tokens(&grammar.parser_rules);
    gen_token_constants(&mut w, &grammar.lexer_rules, &lit_tokens);
    gen_lexer(&mut w, grammar, &lit_tokens);
    let mut ctx = GenContext::new(&grammar.parser_rules, &lit_tokens);
    gen_parser(&mut w, grammar, &mut ctx);
    gen_visitor(&mut w, grammar);
    if options.highlight {
        gen_highlight(&mut w, grammar, &lit_tokens);
    }
    return w.to_string();
}

fn gen_header(w: &mut CodeWriter, name: &String) {
    w.line("#![generated]");
    w.line(`// Generated by Gale from {name}.g4 — do not edit.`);
    w.blank();
}

fn gen_runtime(w: &mut CodeWriter) {
    w.raw(#include_str("./runtime.wado"));
    w.raw("\n");
}

fn gen_token_kind(w: &mut CodeWriter, lexer_rules: &Array<LexerRule>) {
    let mut e = EnumSpec::new("TokenKind");
    e.set_pub();
    for let rule of lexer_rules {
        if !rule.is_fragment {
            e.add_member(&rule.name);
        }
    }
    e.add_member("Eof");
    e.add_member("Error");
    e.emit(w);
    w.blank();
}

fn gen_cst_types(w: &mut CodeWriter, parser_rules: &Array<ParserRule>) {
    let mut emitted: Array<String> = [];
    for let rule of parser_rules {
        gen_parser_rule_type(w, rule, &mut emitted);
    }
}

fn gen_parser_rule_type(w: &mut CodeWriter, rule: &ParserRule, emitted: &mut Array<String>) {
    let type_name = rule_type_name(&rule.name);
    let mut group_counter: i32 = 0;
    if rule.alternatives.len() == 1 {
        gen_struct_for_alt(w, &type_name, &rule.alternatives[0], emitted, &rule.name, &mut group_counter);
    } else {
        let case_names = case_names_for_rule(&rule.alternatives);
        let base = strip_suffix(&type_name, "Node");
        let mut v = VariantSpec::new(&type_name);
        v.set_pub();
        for let mut i = 0; i < rule.alternatives.len(); i += 1 {
            let struct_name = `{base}{case_names[i]}`;
            v.add_case_with_payload(&case_names[i], &struct_name);
        }
        v.emit(w);
        w.blank();

        for let mut i = 0; i < rule.alternatives.len(); i += 1 {
            let struct_name = `{base}{case_names[i]}`;
            gen_struct_for_alt(w, &struct_name, &rule.alternatives[i], emitted, &rule.name, &mut group_counter);
        }
    }
}

fn gen_struct_for_alt(w: &mut CodeWriter, type_name: &String, alt: &Alternative, emitted: &mut Array<String>, rule_name: &String, group_counter: &mut i32) {
    let gc_start = *group_counter;
    gen_group_variant_types(w, &alt.elements, emitted, rule_name, group_counter);
    let mut gc = gc_start;
    let fields = collect_fields(&alt.elements, rule_name, &mut gc);
    let mut s = StructSpec::new(type_name);
    s.set_pub();
    s.add_pub_field("span", "Span");
    for let field of &fields {
        s.add_pub_field(&field.name, &field.type_str);
    }
    s.emit(w);
    w.blank();
}

fn repeat_inner_field(elem: &Element, rule_name: &String, group_counter: &mut i32) -> Option<Field> {
    if let Group(alts) = elem {
        if is_simple_cst_group(alts) {
            return Option::<Field>::Some(Field {
                name: group_field_base_name(alts),
                type_str: group_variant_type_name(alts),
            });
        }
        if is_token_only_group(alts) {
            return Option::<Field>::Some(Field {
                name: token_group_field_name(alts),
                type_str: "Token",
            });
        }
        if is_single_alt_group(alts) {
            return Option::<Field>::Some(Field {
                name: single_alt_group_field_name(&alts[0]),
                type_str: single_alt_group_type_name(&alts[0]),
            });
        }
        if is_general_group(alts) {
            let idx = *group_counter;
            *group_counter += 1;
            return Option::<Field>::Some(Field {
                name: general_group_field_name(idx),
                type_str: general_group_type_name(rule_name, idx),
            });
        }
        // Non-storable group: advance counter for nested general groups
        *group_counter += count_element_groups(elem);
        return null;
    }
    return element_to_field(elem, rule_name, group_counter);
}

fn gen_group_variant_types(w: &mut CodeWriter, elements: &Array<Element>, emitted: &mut Array<String>, rule_name: &String, group_counter: &mut i32) {
    for let elem of elements {
        gen_element_variant_types(w, elem, emitted, rule_name, group_counter);
    }
}

fn gen_element_variant_types(w: &mut CodeWriter, elem: &Element, emitted: &mut Array<String>, rule_name: &String, group_counter: &mut i32) {
    let alts = extract_group_alts(elem);
    if let Some(group_alts) = alts {
        if is_simple_cst_group(group_alts) {
            let type_name = group_variant_type_name(group_alts);
            if !has_emitted(emitted, &type_name) {
                emitted.push(type_name);
                gen_group_variant_type(w, group_alts);
            }
        } else if is_single_alt_group(group_alts) {
            let type_name = single_alt_group_type_name(&group_alts[0]);
            if !has_emitted(emitted, &type_name) {
                emitted.push(type_name);
                gen_single_alt_group_struct(w, &group_alts[0], emitted, rule_name, group_counter);
            } else {
                // Struct already emitted (shared across rules). Just advance counter
                // for nested general groups. Don't emit types — they were already
                // emitted under the first rule's name.
                *group_counter += count_general_groups(&group_alts[0].elements);
            }
        } else if is_general_group(group_alts) {
            let idx = *group_counter;
            *group_counter += 1;
            let type_name = general_group_type_name(rule_name, idx);
            if !has_emitted(emitted, &type_name) {
                emitted.push(type_name);
                gen_general_group_types(w, group_alts, emitted, rule_name, idx, group_counter);
            }
        } else {
            // Recurse into multi-alt groups to find nested storable groups
            for let alt of group_alts {
                gen_group_variant_types(w, &alt.elements, emitted, rule_name, group_counter);
            }
        }
        return;
    }
    // Recurse into repeat elements (non-group inner)
    if let Repeat(rep) = elem {
        gen_element_variant_types(w, &rep.element, emitted, rule_name, group_counter);
        return;
    }
    // Recurse into label elements
    if let Label(lab) = elem {
        gen_element_variant_types(w, &lab.element, emitted, rule_name, group_counter);
    }
}

fn has_emitted(emitted: &Array<String>, name: &String) -> bool {
    for let e of emitted {
        if *e == *name {
            return true;
        }
    }
    return false;
}

fn extract_group_alts(elem: &Element) -> Option<&Array<Alternative>> {
    if let Group(alts) = elem {
        return Option::Some(alts);
    }
    if let Repeat(rep) = elem {
        if let Group(alts) = &rep.element {
            return Option::Some(alts);
        }
    }
    return null;
}

fn gen_group_variant_type(w: &mut CodeWriter, alts: &Array<Alternative>) {
    let type_name = group_variant_type_name(alts);
    let mut v = VariantSpec::new(&type_name);
    v.set_pub();
    for let alt of alts {
        if let RuleRef(name) = &alt.elements[0] {
            let case_name = to_pascal_case(name);
            let payload = rule_type_name(name);
            v.add_case_with_payload(&case_name, &payload);
        }
    }
    v.emit(w);
    w.blank();
}

fn gen_single_alt_group_struct(w: &mut CodeWriter, alt: &Alternative, emitted: &mut Array<String>, rule_name: &String, group_counter: &mut i32) {
    let gc_start = *group_counter;
    gen_group_variant_types(w, &alt.elements, emitted, rule_name, group_counter);
    let mut gc = gc_start;
    let type_name = single_alt_group_type_name(alt);
    let fields = collect_fields(&alt.elements, rule_name, &mut gc);
    let mut s = StructSpec::new(&type_name);
    s.set_pub();
    for let field of &fields {
        s.add_pub_field(&field.name, &field.type_str);
    }
    s.emit(w);
    w.blank();
}

fn gen_general_group_types(w: &mut CodeWriter, alts: &Array<Alternative>, emitted: &mut Array<String>, rule_name: &String, group_index: i32, group_counter: &mut i32) {
    // Recurse into alts to generate nested storable group types first.
    // Use the rule-level counter so nested group indices match the parser gen.
    // Save counter before each alt's traversal, then process the alt,
    // tracking the maximum counter reached across all alts.
    let gc_before_alts = *group_counter;
    let mut gc_max = gc_before_alts;
    for let alt of alts {
        *group_counter = gc_before_alts;
        gen_group_variant_types(w, &alt.elements, emitted, rule_name, group_counter);
        if *group_counter > gc_max {
            gc_max = *group_counter;
        }
    }
    *group_counter = gc_max;
    // Generate variant type
    let type_name = general_group_type_name(rule_name, group_index);
    let mut v = VariantSpec::new(&type_name);
    v.set_pub();
    for let mut i = 0; i < alts.len(); i += 1 {
        let struct_name = general_group_alt_struct_name(rule_name, group_index, i);
        v.add_case_with_payload(&`Alt{i}`, &struct_name);
    }
    v.emit(w);
    w.blank();
    // Generate struct per alt
    for let mut i = 0; i < alts.len(); i += 1 {
        let struct_name = general_group_alt_struct_name(rule_name, group_index, i);
        let mut gc = gc_before_alts;
        let fields = collect_fields(&alts[i].elements, rule_name, &mut gc);
        let mut s = StructSpec::new(&struct_name);
        s.set_pub();
        for let field of &fields {
            s.add_pub_field(&field.name, &field.type_str);
        }
        s.emit(w);
        w.blank();
    }
}

struct Field {
    name: String,
    type_str: String,
}

fn collect_fields(elements: &Array<Element>, rule_name: &String, group_counter: &mut i32) -> Array<Field> {
    let mut fields: Array<Field> = [];
    let mut name_counts: Array<[String, i32]> = [];
    for let mut i = 0; i < elements.len(); i += 1 {
        if let Some(field) = element_to_field(&elements[i], rule_name, group_counter) {
            let count = get_name_count(&name_counts, &field.name);
            increment_name_count(&mut name_counts, &field.name);
            let final_name = if count > 0 { `{field.name}_{count + 1}` } else { field.name };
            fields.push(Field { name: final_name, type_str: field.type_str });
        }
    }
    return fields;
}

fn get_name_count(counts: &Array<[String, i32]>, name: &String) -> i32 {
    for let entry of counts {
        if entry.0 == *name {
            return entry.1;
        }
    }
    return 0;
}

fn increment_name_count(counts: &mut Array<[String, i32]>, name: &String) {
    for let mut i = 0; i < counts.len(); i += 1 {
        if counts[i].0 == *name {
            let prev = counts[i].1;
            counts[i] = [*name, prev + 1];
            return;
        }
    }
    counts.push([*name, 1]);
}

fn element_to_field(elem: &Element, rule_name: &String, group_counter: &mut i32) -> Option<Field> {
    if let RuleRef(name) = elem {
        return Option::<Field>::Some(Field {
            name: escape_ident(&to_snake_case(name)),
            type_str: rule_type_name(name),
        });
    }
    if let TokenRef(name) = elem {
        return Option::<Field>::Some(Field {
            name: escape_ident(&to_lower(name)),
            type_str: "Token",
        });
    }
    if let Literal(text) = elem {
        return Option::<Field>::Some(Field {
            name: literal_field_name(text),
            type_str: "Token",
        });
    }
    if let Wildcard = elem {
        return Option::<Field>::Some(Field {
            name: "wildcard",
            type_str: "Token",
        });
    }
    if let Not(ne) = elem {
        return Option::<Field>::Some(Field {
            name: not_element_field_name(&ne.element),
            type_str: "Token",
        });
    }
    if let Repeat(rep) = elem {
        // List labels are already Array-typed — return them as-is without
        // re-wrapping. `(items+=item)*` and `items+=item*` both produce a
        // single `items: Array<ItemNode>` field.
        if let Label(lab) = &rep.element {
            if lab.list {
                return element_to_field(&rep.element, rule_name, group_counter);
            }
        }
        let inner_field = repeat_inner_field(&rep.element, rule_name, group_counter);
        if let Some(inner) = inner_field {
            let field = match rep.kind {
                Star | Plus => Field {
                    name: `{inner.name}_list`,
                    type_str: `Array<{inner.type_str}>`,
                },
                Optional => Field {
                    name: inner.name,
                    type_str: `Option<{inner.type_str}>`,
                },
            };
            return Option::<Field>::Some(field);
        }
        return null;
    }
    if let Label(lab) = elem {
        if let Some(inner) = element_to_field(&lab.element, rule_name, group_counter) {
            if lab.list {
                // `items+=item` — the field is an Array<ItemNode>, regardless
                // of whether this Label is wrapped in a Repeat.
                return Option::<Field>::Some(Field {
                    name: escape_ident(&to_snake_case(&lab.name)),
                    type_str: `Array<{inner.type_str}>`,
                });
            }
            return Option::<Field>::Some(Field {
                name: escape_ident(&to_snake_case(&lab.name)),
                type_str: inner.type_str,
            });
        }
        return null;
    }
    if let Group(alts) = elem {
        if is_simple_cst_group(alts) {
            return Option::<Field>::Some(Field {
                name: group_field_base_name(alts),
                type_str: `Option<{group_variant_type_name(alts)}>`,
            });
        }
        if is_token_only_group(alts) {
            return Option::<Field>::Some(Field {
                name: token_group_field_name(alts),
                type_str: "Token",
            });
        }
        if is_single_alt_group(alts) {
            return Option::<Field>::Some(Field {
                name: single_alt_group_field_name(&alts[0]),
                type_str: single_alt_group_type_name(&alts[0]),
            });
        }
        if is_general_group(alts) {
            let idx = *group_counter;
            *group_counter += 1;
            return Option::<Field>::Some(Field {
                name: general_group_field_name(idx),
                type_str: `Option<{general_group_type_name(rule_name, idx)}>`,
            });
        }
        // Non-storable group: advance counter for nested general groups
        *group_counter += count_element_groups(elem);
        return null;
    }
    return null;
}
