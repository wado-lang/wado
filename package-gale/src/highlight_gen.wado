use { Grammar, LexerRule, LexerElement, ParserRule } from "./ir.wado";
use { LitToken, TokenSlot, token_slot_order } from "./lexer_gen.wado";
use { CodeWriter, FnSpec, Vis, str_lit } from "./wadopoet.wado";
use { HighlightRule, TokenSelector } from "./highlight_query.wado";
use { GenContext } from "./gen_context.wado";
use { DiagnosticKind } from "./gir.wado";
use { TreeMap } from "core:collections";

/// `highlight`: build the token/rule mapping from the parsed highlight query,
/// then drive `highlight_walk` over the parsed CST store. `parse` always
/// returns a tree (partial on broken input), so there is no parse-failure /
/// tokenize-only branch — a broken input still highlights from its partial
/// tree.
pub fn gen_highlight(
    w: &mut CodeWriter,
    grammar: &Grammar,
    lit_tokens: &List<LitToken>,
    query: &List<HighlightRule>,
    ctx: &mut GenContext,
) {
    gen_highlight_mapping(w, &grammar.lexer_rules, &grammar.parser_rules, lit_tokens, query, ctx);
    if grammar.parser_rules.len() > 0 {
        let mut fr = FnSpec::new("highlight_result", Vis::Pub);
        fr.add_param(&"result", &"&ParseResult");
        fr.add_param(&"input", &"&String");
        fr.set_return_type(&"String");
        fr.emit_begin(w);
        w.line(&"let mapping = highlight_mapping();");
        w.line(&"let mut visitor = HighlightVisitor::new(mapping);");
        w.line(&"highlight_walk(&mut visitor, &result.tokens, &result.cst);");
        w.line(&"visitor.hl_cover_unvisited(&result.tokens);");
        w.line(&"return highlight_html(input, &visitor.captures);");
        w.end();
        w.blank();

        let mut f = FnSpec::new("highlight", Vis::Pub);
        f.add_param(&"input", &"&String");
        f.set_return_type(&"String");
        f.emit_begin(w);
        w.line(&"let result = parse(input);");
        w.line(&"return highlight_result(&result, input);");
        w.end();
    } else {
        // Lexer-only grammar: no `parse` / tree, so highlight the raw stream.
        let mut f = FnSpec::new("highlight", Vis::Pub);
        f.add_param(&"input", &"&String");
        f.set_return_type(&"String");
        f.emit_begin(w);
        w.line(&"let mapping = highlight_mapping();");
        w.line(&"let mut visitor = HighlightVisitor::new(mapping);");
        w.line(&"let tokens = tokenize(input);");
        w.begin(&"for let mut _i = 0; _i < tokens.len(); _i += 1");
        w.line(&"visitor.hl_visit_token(&tokens, _i);");
        w.end();
        w.line(&"return highlight_html(input, &visitor.captures);");
        w.end();
    }
    w.blank();
    gen_highlight_run(w);
}

/// Token kind resolution built once per grammar: token kind ids are the index
/// into `token_slot_order`, so a name / literal maps directly to its kind.
struct KindIndex {
    by_name: TreeMap<String, i32>,
    by_literal: TreeMap<String, i32>,
    /// A single-literal lexer rule (`OPEN_PAR : '('`) is shadowed at lex time
    /// by the identical inline-literal token, so a `(OPEN_PAR)` mapping alone
    /// would target a kind the lexer never emits. Map such a rule name to the
    /// literal kind that actually appears, so a default / override written
    /// against the name still fires.
    shadow: TreeMap<String, i32>,
}

/// The literal text of a lexer rule whose whole body is a single string
/// literal (`OPEN_PAR : '(' ;`), else `None`.
fn single_literal_text(rule: &LexerRule) -> Option<String> {
    if rule.body.len() != 1 {
        return null;
    }
    if rule.body[0].elements.len() != 1 {
        return null;
    }
    if let Literal(t) = &rule.body[0].elements[0] {
        return Option::Some(*t);
    }
    return null;
}

/// A resolved override: rule name + integer token kind + capture, ready to emit
/// into the `overrides` table.
struct ResolvedOverride {
    rule_name: String,
    token_kind: i32,
    capture: String,
}

fn build_kind_index(lexer_rules: &List<LexerRule>, lit_tokens: &List<LitToken>, slots: &List<TokenSlot>) -> KindIndex {
    let mut by_name = TreeMap::<String, i32>::new();
    let mut by_literal = TreeMap::<String, i32>::new();
    for let mut i = 0; i < slots.len(); i += 1 {
        match &slots[i] {
            Rule(ri) => by_name[lexer_rules[*ri].name] = i,
            Lit(li) => by_literal[lit_tokens[*li].text] = i,
            Eof => {
            },
            Error => {
            },
        }
    }
    // A named single-literal rule whose text also exists as an inline-literal
    // token is shadowed by that literal at lex time; record the literal kind.
    let mut shadow = TreeMap::<String, i32>::new();
    for let rule of lexer_rules {
        if let Some(text) = single_literal_text(rule) {
            if let Some(lit_kind) = by_literal.get(text) {
                if by_name.get(rule.name) matches { Some(_) } {
                    shadow[rule.name] = lit_kind;
                }
            }
        }
    }
    return KindIndex { by_name, by_literal, shadow };
}

fn resolve_selector(idx: &KindIndex, sel: &TokenSelector) -> Option<i32> {
    return match sel {
        Name(n) => idx.by_name.get(*n),
        Literal(t) => idx.by_literal.get(*t),
    };
}

fn selector_desc(sel: &TokenSelector) -> String {
    return match sel {
        Name(n) => `'${*n}'`,
        Literal(t) => `literal "${*t}"`,
    };
}

fn parser_rule_exists(parser_rules: &List<ParserRule>, name: &String) -> bool {
    for let r of parser_rules {
        if r.name == *name {
            return true;
        }
    }
    return false;
}

/// Record an override for (rule, token), last-wins: a later query rule for the
/// same pair replaces an earlier one (matching the default table's last-wins
/// and tree-sitter's convention), rather than being dead behind it.
fn push_override(overrides: &mut List<ResolvedOverride>, rule_name: String, token_kind: i32, capture: String) {
    for let mut i = 0; i < overrides.len(); i += 1 {
        if overrides[i].rule_name == rule_name && overrides[i].token_kind == token_kind {
            overrides[i] = ResolvedOverride { rule_name, token_kind, capture };
            return;
        }
    }
    overrides.push(ResolvedOverride { rule_name, token_kind, capture });
}

fn slot_comment(slot: &TokenSlot, lexer_rules: &List<LexerRule>, lit_tokens: &List<LitToken>) -> String {
    return match slot {
        Rule(ri) => `TK_${lexer_rules[*ri].name}`,
        Eof => "TK_EOF",
        Error => "TK_ERROR",
        Lit(li) => lit_tokens[*li].const_name,
    };
}

fn gen_highlight_mapping(
    w: &mut CodeWriter,
    lexer_rules: &List<LexerRule>,
    parser_rules: &List<ParserRule>,
    lit_tokens: &List<LitToken>,
    query: &List<HighlightRule>,
    ctx: &mut GenContext,
) {
    // Token kind ids follow `token_slot_order` — including deferred
    // `more` / `type(...)` rules and the conditional `TK_ERROR` sentinel —
    // so both the defaults table (indexed `defaults[kind]` at runtime) and
    // override resolution key off it.
    let slots = token_slot_order(lexer_rules, lit_tokens);
    let idx = build_kind_index(lexer_rules, lit_tokens, &slots);

    // Compile the query: defaults keyed by token kind and overrides, both
    // last-wins. Unknown token / rule names are skipped with a warning rather
    // than failing the whole highlighter. A name selector that is shadowed by
    // an inline literal maps the literal kind too (`shadow_kind`).
    let mut default_by_kind = TreeMap::<i32, String>::new();
    let mut overrides: List<ResolvedOverride> = [];
    for let rule of query {
        let kind = match resolve_selector(&idx, &rule.selector) {
            Some(k) => k,
            None => {
                ctx.warn(
                    &"highlight",
                    DiagnosticKind::HighlightQuery,
                    `highlight query: unknown token ${selector_desc(&rule.selector)}`,
                );
                continue;
            },
        };
        let shadow_kind = match &rule.selector {
            Name(n) => idx.shadow.get(*n),
            Literal(_) => null,
        };
        match &rule.rule_context {
            None => {
                default_by_kind[kind] = rule.capture;
                if let Some(k2) = shadow_kind {
                    default_by_kind[k2] = rule.capture;
                }
            },
            Some(rctx) => {
                if !parser_rule_exists(parser_rules, rctx) {
                    ctx.warn(
                        &"highlight",
                        DiagnosticKind::HighlightQuery,
                        `highlight query: unknown parser rule '${*rctx}'`,
                    );
                    continue;
                }
                push_override(&mut overrides, *rctx, kind, rule.capture);
                if let Some(k2) = shadow_kind {
                    push_override(&mut overrides, *rctx, k2, rule.capture);
                }
            },
        }
    }

    let mut f = FnSpec::new("highlight_mapping", Vis::Pub);
    f.set_return_type(&"HighlightMapping");
    f.emit_begin(w);

    // Default capture per token kind, one row per slot in kind order.
    w.line(&"let defaults: List<String> = [");
    w.indent();
    for let mut i = 0; i < slots.len(); i += 1 {
        let capture = match default_by_kind.get(i) {
            Some(c) => c,
            None => "",
        };
        w.line(&`${str_lit(capture)},  // ${slot_comment(&slots[i], lexer_rules, lit_tokens)}`);
    }
    w.dedent();
    w.line(&"];");

    // Rule names indexed by rule_id (parser-rule declaration order). Must
    // match the ids the generated walker passes to hl_enter, and the ids the
    // runtime resolves override `rule_name`s against.
    w.line(&"let rule_names: List<String> = [");
    w.indent();
    for let rule of parser_rules {
        w.line(&`${str_lit(rule.name)},`);
    }
    w.dedent();
    w.line(&"];");

    if overrides.is_empty() {
        w.line(&"let overrides: List<HighlightOverride> = [];");
    } else {
        w.line(&"let overrides: List<HighlightOverride> = [");
        w.indent();
        for let ov of &overrides {
            w.line(
                &`HighlightOverride \{ rule_name: ${str_lit(ov.rule_name)}, token_kind: ${ov.token_kind}, capture: ${str_lit(
                    ov.capture,
                )} \},`,
            );
        }
        w.dedent();
        w.line(&"];");
    }

    w.line(&"return HighlightMapping { defaults, rule_names, overrides };");

    w.end();
    w.blank();
}

fn gen_highlight_run(w: &mut CodeWriter) {
    w.line(&"use { args, print, eprintln, Stdout, Stderr, Environment } from \"core:cli\";");
    w.line(&"use { Preopens, Descriptor, Filesize, PathFlags, OpenFlags, DescriptorFlags } from \"wasi:filesystem\";");
    w.blank();
    let mut run_fn = FnSpec::new("run");
    run_fn.set_export();
    run_fn.add_effect(&"Stdout");
    run_fn.add_effect(&"Stderr");
    run_fn.add_effect(&"Environment");
    run_fn.add_effect(&"Preopens");
    run_fn.emit_begin(w);
    w.line(&"let arguments = args();");
    w.begin(&"if arguments.len() < 1");
    w.line(&"eprintln(\"Usage: <highlighter> <input-file>\");");
    w.line(&"return;");
    w.end();
    w.line(&"let path = arguments[0];");
    w.line(&"let dirs = Preopens::get_directories();");
    w.line(&"let root = dirs[0].0;");
    w.line(
        &"let file = root.open_at(PathFlags::none(), path, OpenFlags::none(), DescriptorFlags::Read).wait().unwrap();",
    );
    w.line(&"let [read_stream, _done] = file.read_via_stream(0 as Filesize);");
    w.line(&"let mut bytes: ByteList = [];");
    w.begin(&"loop");
    w.line(&"let chunk = read_stream.read(65536);");
    w.begin(&"if chunk.len() == 0");
    w.line(&"break;");
    w.end();
    w.begin(&"for let b of chunk");
    w.line(&"bytes.push(b);");
    w.end();
    w.end();
    w.line(&"read_stream.drop();");
    w.line(&"let input = String::from_utf8_unchecked(bytes);");
    w.line(&"print(highlight(&input));");
    w.end();
    w.blank();
}
