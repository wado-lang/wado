use { Grammar, LexerRule, ParserRule, lexer_alias_text } from "./ir.wado";
use { LitToken, TokenSlot, token_slot_order } from "./lexer_gen.wado";
use { CodeWriter, FnSpec, Vis, wado } from "lib:wadopoet";
use { HighlightRule, TokenSelector } from "./highlight_query.wado";
use { GenContext } from "./gen_context.wado";
use { DiagnosticKind, DiagnosticOwner } from "./gir.wado";
use { rule_kind_const } from "./gen_util.wado";
use { TreeMap } from "core:collections";

/// `highlight`: the query compiled into the `HIGHLIGHT_MAPPING` global, then
/// `highlight_walk` over the CST with `hl_cover_unvisited` for what the tree
/// left out. `parse` always returns a tree, partial on broken input, so there
/// is no tokenize-only fallback.
pub fn gen_highlight(
    w: &mut CodeWriter,
    grammar: &Grammar,
    lit_tokens: &List<LitToken>,
    query: &List<HighlightRule>,
    ctx: &mut GenContext,
) {
    gen_highlight_mapping(
        w,
        &grammar.lexer_rules,
        &grammar.parser_rules,
        lit_tokens,
        query,
        ctx,
    );
    if grammar.parser_rules.len() > 0 {
        let mut fr = FnSpec::new("highlight_result", Vis::Pub);
        fr.add_generic("S: AsStrSlice");
        fr.add_param("result", "&ParseResult");
        fr.add_param("input", "S");
        fr.set_return_type("String");
        fr.emit_begin(w);
        w.line("let mut visitor = HighlightVisitor::new(&HIGHLIGHT_MAPPING);");
        w.line("highlight_walk(&mut visitor, &result.tokens, &result.cst);");
        w.line("visitor.hl_cover_unvisited(&result.tokens);");
        w.line("return highlight_html(input, &visitor.captures, &HIGHLIGHT_MAPPING.capture_classes);");
        w.end();
        w.blank();

        let mut f = FnSpec::new("highlight", Vis::Pub);
        f.add_generic("S: AsStrSlice");
        f.add_param("input", "S");
        f.set_return_type("String");
        f.emit_begin(w);
        w.line("let result = parse(input);");
        w.line("return highlight_result(&result, input);");
        w.end();
    } else {
        // Lexer-only grammar: no `parse` / tree, so highlight the raw stream.
        let mut f = FnSpec::new("highlight", Vis::Pub);
        f.add_generic("S: AsStrSlice");
        f.add_param("input", "S");
        f.set_return_type("String");
        f.emit_begin(w);
        w.line("let mut visitor = HighlightVisitor::new(&HIGHLIGHT_MAPPING);");
        w.line("let tokens = tokenize(input);");
        w.begin("for let mut _i = 0; _i < tokens.len(); _i += 1");
        w.line("visitor.hl_capture_token(&tokens, _i);");
        w.end();
        w.line("return highlight_html(input, &visitor.captures, &HIGHLIGHT_MAPPING.capture_classes);");
        w.end();
    }
    w.blank();
}

/// Token kind resolution built once per grammar: token kind ids are the index
/// into `token_slot_order`, so a name / literal maps directly to its kind.
struct KindIndex {
    by_name: TreeMap<String, i32>,
    by_literal: TreeMap<String, i32>,
}

/// `(rule (TOKEN) @capture)`: `order` is the position in the query of the rule
/// that decides it, which is what settles a token two captures both claim.
struct ResolvedOverride {
    rule_index: i32,
    token_kind: i32,
    capture: String,
    order: i32,
}

/// `(rule) @capture`: every token under the rule, which accepts exactly `kinds`.
struct ResolvedRuleCapture {
    rule_index: i32,
    kinds: List<i32>,
    capture: String,
    order: i32,
}

/// The query resolved against the grammar, each tier last-wins.
struct ResolvedQuery {
    default_by_kind: TreeMap<i32, String>,
    overrides: List<ResolvedOverride>,
    rule_captures: List<ResolvedRuleCapture>,
}

fn build_kind_index(lexer_rules: &List<LexerRule>, lit_tokens: &List<LitToken>, slots: &List<TokenSlot>) -> KindIndex {
    let mut by_name = TreeMap::<String, i32>::new();
    let mut by_literal = TreeMap::<String, i32>::new();
    for let mut i = 0; i < slots.len(); i += 1 {
        match &slots[i] {
            Rule(ri) => by_name[lexer_rules[*ri].name] = i,
            Lit(li) => by_literal[lit_tokens[*li].text] = i,
            Eof => {
            },
            Error => {
            },
        }
    }
    // A query writes punctuation by text (`"(" @punctuation.bracket`). An
    // aliased text mints no `TK_LIT_*`, so it resolves through its rule's kind.
    for let rule of lexer_rules {
        if let Some(text) = lexer_alias_text(rule) {
            if by_literal.get(text) matches { None } {
                if let Some(kind) = by_name.get(rule.name) {
                    by_literal[text] = kind;
                }
            }
        }
    }
    return KindIndex { by_name, by_literal };
}

fn resolve_selector(idx: &KindIndex, sel: &TokenSelector) -> Option<i32> {
    return match sel {
        Name(n) => idx.by_name.get(*n),
        Literal(t) => idx.by_literal.get(*t),
    };
}

fn selector_desc(sel: &TokenSelector) -> String {
    return match sel {
        Name(n) => `'${*n}'`,
        Literal(t) => `literal "${*t}"`,
    };
}

/// Position of the named parser rule, or -1. An index rather than a reference:
/// the caller reads the rule out of the list it already holds.
fn parser_rule_index<S: AsStrSlice>(parser_rules: &List<ParserRule>, name: S) -> i32 {
    for let mut i = 0; i < parser_rules.len(); i += 1 {
        if parser_rules[i].name == name.as_str_slice() {
            return i;
        }
    }
    return -1;
}

/// Every token kind `rule` accepts, or `null` where an alternative is anything
/// but one token or a delegation to such a rule (`fieldName : memberName`).
/// `visiting` is the delegation chain being followed, which is what ends a cycle.
fn rule_token_kinds(
    rule: &ParserRule,
    parser_rules: &List<ParserRule>,
    idx: &KindIndex,
    visiting: &mut List<String>,
) -> Option<List<i32>> {
    assert visiting.contains(&rule.name);
    let mut kinds: List<i32> = [];
    for let alt of &rule.alternatives {
        if alt.elements.len() != 1 {
            return null;
        }
        match &alt.elements[0] {
            TokenRef(t) => match idx.by_name.get(t.name) {
                Some(k) => kinds.push(k),
                None => {
                    return null;
                },
            },
            Literal(l) => match idx.by_literal.get(l.text) {
                Some(k) => kinds.push(k),
                None => {
                    return null;
                },
            },
            RuleRef(r) => {
                let at = parser_rule_index(parser_rules, &r.name);
                if at < 0 || visiting.contains(&r.name) {
                    return null;
                }
                visiting.push(r.name);
                let delegated = rule_token_kinds(&parser_rules[at], parser_rules, idx, visiting);
                visiting.pop();
                match delegated {
                    Some(inner) => {
                        for let k of &inner {
                            kinds.push(*k);
                        }
                    },
                    None => {
                        return null;
                    },
                }
            },
            _ => {
                return null;
            },
        }
    }
    return Option::Some(kinds);
}

impl ResolvedQuery {
    /// Last-wins per (rule, token): a later rule replaces the capture and keeps
    /// the earlier order, as does one landing on a kind a rule capture covers.
    fn push_override<S: AsStrSlice>(&mut self, rule_index: i32, token_kind: i32, capture: S, order: i32) {
        for let ov of &mut self.overrides {
            if ov.rule_index == rule_index && ov.token_kind == token_kind {
                ov.capture = capture.to_string();
                return;
            }
        }
        let mut at = order;
        for let rc of &self.rule_captures {
            if rc.rule_index == rule_index && rc.kinds.contains(&token_kind) {
                at = rc.order;
            }
        }
        self.overrides.push(ResolvedOverride { rule_index, token_kind, capture: capture.to_string(), order: at });
    }

    /// `(rule) @capture` restates every (rule, token) override it covers, so
    /// the later capture wins there too.
    fn push_rule_capture<S: AsStrSlice>(&mut self, rule_index: i32, kinds: List<i32>, capture: S, order: i32) {
        for let ov of &mut self.overrides {
            if ov.rule_index == rule_index && kinds.contains(&ov.token_kind) {
                ov.capture = capture.to_string();
            }
        }
        for let rc of &mut self.rule_captures {
            if rc.rule_index == rule_index {
                rc.capture = capture.to_string();
                return;
            }
        }
        self.rule_captures.push(ResolvedRuleCapture { rule_index, kinds, capture: capture.to_string(), order });
    }

    /// Every capture class the query can emit, sorted: a capture's id is its
    /// index here.
    fn vocabulary(&self) -> List<String> {
        let mut out: List<String> = [];
        for let capture of self.default_by_kind.values() {
            push_unique(&mut out, *capture);
        }
        for let ov of &self.overrides {
            push_unique(&mut out, ov.capture);
        }
        for let rc of &self.rule_captures {
            push_unique(&mut out, rc.capture);
        }
        out.sort();
        return out;
    }
}

fn resolve_query(
    parser_rules: &List<ParserRule>,
    idx: &KindIndex,
    query: &List<HighlightRule>,
    ctx: &mut GenContext,
) -> ResolvedQuery {
    let mut resolved = ResolvedQuery {
        default_by_kind: TreeMap::<i32, String>::new(),
        overrides: [],
        rule_captures: [],
    };
    for let mut order = 0; order < query.len(); order += 1 {
        let rule = &query[order];
        if rule.rule_context matches { None } {
            if let Name(name) = &rule.selector {
                let at = parser_rule_index(parser_rules, name);
                if at >= 0 {
                    let captured = &parser_rules[at];
                    let mut visiting: List<String> = [captured.name];
                    match rule_token_kinds(captured, parser_rules, idx, &mut visiting) {
                        Some(kinds) => resolved.push_rule_capture(at, kinds, rule.capture, order),
                        None => ctx.warn(
                            &DiagnosticOwner::host("highlight"),
                            DiagnosticKind::HighlightQuery,
                            `highlight query: '(${captured.name}) @${rule.capture}' needs every alternative of '${captured.name}' to be a single token, or a delegation to a rule that is`,
                        ),
                    }
                    continue;
                }
            }
        }
        let kind = match resolve_selector(idx, &rule.selector) {
            Some(k) => k,
            None => {
                ctx.warn(
                    &DiagnosticOwner::host("highlight"),
                    DiagnosticKind::HighlightQuery,
                    `highlight query: unknown token ${selector_desc(&rule.selector)}`,
                );
                continue;
            },
        };
        match &rule.rule_context {
            None => {
                resolved.default_by_kind[kind] = rule.capture;
            },
            Some(rctx) => {
                let at = parser_rule_index(parser_rules, rctx);
                if at < 0 {
                    ctx.warn(
                        &DiagnosticOwner::host("highlight"),
                        DiagnosticKind::HighlightQuery,
                        `highlight query: unknown parser rule '${*rctx}'`,
                    );
                    continue;
                }
                resolved.push_override(at, kind, rule.capture, order);
            },
        }
    }
    return resolved;
}

fn slot_comment(slot: &TokenSlot, lexer_rules: &List<LexerRule>, lit_tokens: &List<LitToken>) -> String {
    return match slot {
        Rule(ri) => `TK_${lexer_rules[*ri].name}`,
        Eof => "TK_EOF",
        Error => "TK_ERROR",
        Lit(li) => lit_tokens[*li].const_name,
    };
}

fn rule_capture_literal<S: AsStrSlice>(rule: &ParserRule, capture_id: i32, order: i32, capture: S) -> String {
    return `RuleCapture { rule_id: ${rule_kind_const(&rule.name)} as i32, capture_id: ${capture_id}, order: ${order} },  // @${capture}`;
}

fn gen_list_field(w: &mut CodeWriter, field: &String, rows: &List<String>) {
    if rows.is_empty() {
        w.line(`${field}: [],`);
        return;
    }
    w.line(`${field}: [`);
    w.indent();
    for let row of rows {
        w.line(row);
    }
    w.dedent();
    w.line("],");
}

fn string_rows(items: &List<String>) -> List<String> {
    let mut rows: List<String> = [];
    for let item of items {
        rows.push(wado`"${*item}",`);
    }
    return rows;
}

/// `HIGHLIGHT_MAPPING`: the query resolved down to capture ids, token kinds and
/// rule kinds, so a highlight reads it without building anything.
fn gen_highlight_mapping(
    w: &mut CodeWriter,
    lexer_rules: &List<LexerRule>,
    parser_rules: &List<ParserRule>,
    lit_tokens: &List<LitToken>,
    query: &List<HighlightRule>,
    ctx: &mut GenContext,
) {
    // Token kind ids follow `token_slot_order` — including deferred
    // `more` / `type(...)` rules and the conditional `TK_ERROR` sentinel.
    let slots = token_slot_order(lexer_rules, lit_tokens);
    let idx = build_kind_index(lexer_rules, lit_tokens, &slots);
    let resolved = resolve_query(parser_rules, &idx, query, ctx);
    let vocabulary = resolved.vocabulary();
    let mut capture_ids = TreeMap::<String, i32>::new();
    let mut classes: List<String> = [];
    for let mut i = 0; i < vocabulary.len(); i += 1 {
        capture_ids[vocabulary[i]] = i;
        classes.push(vocabulary[i].replace(".", " "));
    }

    w.line("pub global HIGHLIGHT_MAPPING: HighlightMapping = HighlightMapping {");
    w.indent();
    gen_list_field(w, &"capture_names", &string_rows(&vocabulary));
    gen_list_field(w, &"capture_classes", &string_rows(&classes));

    let mut default_rows: List<String> = [];
    for let mut i = 0; i < slots.len(); i += 1 {
        let slot = slot_comment(&slots[i], lexer_rules, lit_tokens);
        default_rows.push(
            match resolved.default_by_kind.get(i) {
                Some(c) => `${capture_ids[c]},  // ${slot} @${c}`,
                None => `-1,  // ${slot}`,
            },
        );
    }
    gen_list_field(w, &"default_ids", &default_rows);

    let mut by_kind: List<List<ResolvedOverride>> = [];
    for let ov of &resolved.overrides {
        while by_kind.len() <= ov.token_kind {
            by_kind.push([]);
        }
        by_kind[ov.token_kind].push(*ov);
    }
    if by_kind.is_empty() {
        w.line("overrides_by_kind: [],");
    } else {
        w.line("overrides_by_kind: [");
        w.indent();
        for let mut kind = 0; kind < by_kind.len(); kind += 1 {
            let slot = slot_comment(&slots[kind], lexer_rules, lit_tokens);
            if by_kind[kind].is_empty() {
                w.line(`[],  // ${slot}`);
                continue;
            }
            by_kind[kind].sort_by(|a: &ResolvedOverride, b: &ResolvedOverride| a.order.cmp(&b.order));
            w.line(`[  // ${slot}`);
            w.indent();
            for let ov of &by_kind[kind] {
                w.line(
                    rule_capture_literal(&parser_rules[ov.rule_index], capture_ids[ov.capture], ov.order, ov.capture),
                );
            }
            w.dedent();
            w.line("],");
        }
        w.dedent();
        w.line("],");
    }

    let mut rule_captures = resolved.rule_captures;
    rule_captures.sort_by(|a: &ResolvedRuleCapture, b: &ResolvedRuleCapture| a.order.cmp(&b.order));
    let mut rule_capture_rows: List<String> = [];
    for let rc of &rule_captures {
        rule_capture_rows.push(
            rule_capture_literal(&parser_rules[rc.rule_index], capture_ids[rc.capture], rc.order, rc.capture),
        );
    }
    gen_list_field(w, &"rule_captures", &rule_capture_rows);
    w.dedent();
    w.line("};");
    w.blank();

    let mut f = FnSpec::new("capture_vocabulary", Vis::Pub);
    f.set_return_type("List<String>");
    f.emit_begin(w);
    w.line("return HIGHLIGHT_MAPPING.capture_names;");
    w.end();
    w.blank();
}

fn push_unique<S: AsStrSlice>(out: &mut List<String>, value: S) {
    if !out.contains_str(value) {
        out.push(value.to_string());
    }
}
