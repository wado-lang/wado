//! The seed Gale hashes its maps and sets under. It keys them by its own input:
//! grammar names, ATN states, rule texts. A developer writes that input, not an
//! attacker, and the Kiln generator may import no `wasi:*` interface, so every
//! map the generator reaches takes this fixed seed rather than the host's.

use { HashSeed } from "core:collections";

internal global GALE_SEED: HashSeed = HashSeed::fixed(0x243F6A8885A308D3, 0x13198A2E03707344);
