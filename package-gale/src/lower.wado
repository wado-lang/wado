} from "./gir.wado";

/// True when an element threads a `FollowArg` into a callee: a `RuleRef`, or
/// a `Label` or `?` wrapping one. A loop's body continues into the loop, which
/// `repeat_body_follow` reads for itself. Other shapes discard it in
/// `lower_op`, so computing a site there interns a dead `FOLLOW_SITE` and
/// perturbs site ids.
fn element_consumes_follow_arg(elem: &Element) -> bool {
    return match elem {
        RuleRef(_) => true,
        Label(lab) => element_consumes_follow_arg(&lab.element),
        Repeat(rep) => rep.kind matches { Optional } && element_consumes_follow_arg(&rep.element),
        Group(g) => if let Some(inner) = transparent_inner(g) {
            element_consumes_follow_arg(inner);
        } else {
            false;
        },
        TokenRef(_) | Literal(_) | Wildcard(_) | Not(_) => false,
    };
}

/// The one element a Transparent group `(e)` wraps, which sits where the group
/// does and so continues as it does.
fn transparent_inner(g: &GroupElement) -> Option<&Element> {
    if classify_group(&g.alternatives) matches { Transparent } {
        return Option::Some(&g.alternatives[0].elements[0]);
    }
    return null;
}

/// A position whose continuation ends with the element list it sits in: a
/// rule's own alternative.
global NO_OUTER_SUFFIX: List<Element> = [];

/// The elements a position's continuation runs through: the alternative's own,
/// then what follows the group holding it, up to the end of the rule. Inside
/// `(OR names? OR) body` the continuation of `names?` is `OR body`, and only
/// the first half is in the list the group walks. Inside a loop, what follows
/// is the loop again (`repeat_body_suffix`).
fn follow_elements_of(elements: &List<Element>, outer_suffix: &List<Element>) -> List<Element> {
    let mut out = *elements;
    out.extend(outer_suffix);
    return out;
}

/// The runtime FOLLOW argument a call at index `i` in `elements` supplies to
/// its callee: the rest of the rule past it, `elements[i+1..]`, as a
/// continuation site the caller threads as data, so no callee is cloned per
/// continuation.
fn compute_follow_arg(ctx: &mut LowerContext, elements: &List<Element>, i: i32) -> FollowArg {
    return forwarding_into(ctx, &elements[i], follow_arg_for(ctx, elements, i));
}

/// `arg`, recorded as an edge where it spells the caller's own continuation
/// into a call to `callee`. Only where the callee declares one, so this is an
/// edge in the fixpoint `lower` closes, not a verdict.
fn forwarding_into(ctx: &mut LowerContext, callee: &Element, arg: FollowArg) -> FollowArg {
    let forwards = match &arg {
        NoFollow => false,
        Forward => true,
        Site(site) => site.ends,
    };
    if forwards {
        if let Some(target) = rule_ref_snake(callee) {
            ctx.mark_rule_forwards_follow(&target);
        }
    }
    return arg;
}

/// The callee a position names, through the `Label` and greedy-`?` wrappers
/// `element_consumes_follow_arg` looks through.
fn rule_ref_snake(elem: &Element) -> Option<String> {
    return match elem {
        RuleRef(r) => Option::Some(r.snake_name),
        Label(lab) => rule_ref_snake(&lab.element),
        Repeat(rep) => rule_ref_snake(&rep.element),
        Group(g) => if let Some(inner) = transparent_inner(g) {
            rule_ref_snake(inner);
        } else {
            null;
        },
        TokenRef(_) | Literal(_) | Wildcard(_) | Not(_) => null,
    };
}

fn follow_arg_for(ctx: &mut LowerContext, elements: &List<Element>, i: i32) -> FollowArg {
    if !element_consumes_follow_arg(&elements[i]) {
        return FollowArg::NoFollow;
    }
    return continuation_arg(ctx, elements, i + 1);
}

/// The FOLLOW argument for what continues from `elements[from]` on: nothing
/// past the rule's own continuation, or the site reading the rest. A rest that
/// can match nothing reads on into what the current rule was called with,
/// which is no reason to drop either: `x?` ahead of the caller's `x` is both.
fn continuation_arg(ctx: &mut LowerContext, elements: &List<Element>, from: i32) -> FollowArg {
    let readings = ctx.analysis.readings_from(elements, from, FOLLOW_SITE_DEPTH);
    if readings_are_empty(&readings) {
        return FollowArg::Forward;
    }
    return FollowArg::Site(FollowSite {
        id: ctx.intern_follow_site(&readings),
        ends: readings_end(&readings),
    });
}

/// What a repeat's body continues into: a `?` runs it once, so what follows
/// the repeat; a loop runs it again, so the loop and then that.
fn repeat_body_suffix(rep: &RepeatElement, outer_suffix: &List<Element>) -> List<Element> {
    if rep.kind matches { Optional } {
        return *outer_suffix;
    }
    return follow_elements_of(&[Element::Repeat(RepeatElement { ..*rep, kind: RepeatKind::Star })], outer_suffix);
}

/// What a repeat's body is told about its own continuation, `body_suffix`
/// being `repeat_body_suffix`. A `?` passes its own arg down; a loop body's
/// call reads the loop.
fn repeat_body_follow(
    ctx: &mut LowerContext,
    rep: &RepeatElement,
    follow_arg: FollowArg,
    body_suffix: &List<Element>,
) -> FollowArg {
    if rep.kind matches { Optional } {
        return follow_arg;
    }
    if !element_consumes_follow_arg(&rep.element) {
        return FollowArg::NoFollow;
    }
    return forwarding_into(ctx, &rep.element, continuation_arg(ctx, body_suffix, 0));
}

/// Whether a tail-greedy `Repeat` at index `i` in `elements` should
/// emit the runtime caller-FOLLOW yield gate. True exactly when
/// the suffix after the Repeat is deep-nullable — i.e. the loop sits at
/// the rule's tail, where another iteration competes with the caller's
/// continuation (threaded in via the runtime `follow`). The gate is
/// inert when `follow` is empty, so emitting it here is sound for every
/// caller and subsumes both the old 1-token subtraction and the
/// K-prefix variant gate.
fn compute_gate_caller_follow(ctx: &mut LowerContext, elements: &List<Element>, i: i32) -> bool {
    return ctx.analysis.tail_is_nullable_deep(elements, i + 1);
}

/// Lower a `Grammar` to `LoweredGrammar`. The returned value is the
/// only input parser-side codegen needs; lexer / highlight emission
/// still consume `Grammar` directly in v1 (their data is also mirrored
/// here for forward compatibility).
///
/// `lit_tokens` is computed by `lexer_gen::collect_literal_tokens`
/// before lowering and threaded in so a single literal-collection
/// pass serves both the lexer and parser sides.
///
/// `ctx`'s analysis, tables and diagnostics pass on to emit (real codegen
/// builds its own); callers that don't need them (e.g. `lower_test.wado`
/// smoke tests) omit it and lowering builds a fresh one from the grammar. The
/// body comment explains what passing them on buys.
pub fn lower(grammar: &Grammar, lit_tokens: &List<LitToken>, ctx: &mut LowerContext = &mut LowerContext::new(
    GrammarAnalysis::new(&grammar.parser_rules),
    GenSettings {},
)) -> LoweredGrammar {
    // The continuation sites the per-rule walk below interns at each `RuleRef`
    // are the ones emit names, and `gen_follow_tables` emits a row for each
    // site emitted code names. Caches (first / nullable / single-token /
    // scannable / tail-greedy) survive across the lower-then-emit boundary and
    // only get computed once.
    let mut parser_rules: List<Rule> = [];
    for let rule of &grammar.parser_rules {
        parser_rules.push(lower_rule(rule, ctx));
    }
    ctx.marks.follow_rule_snakes = follow_rule_snakes(grammar, &ctx.analysis, &ctx.marks);
    ctx.marks.entry_follow_sites = entry_follow_sites(grammar, ctx);
    return LoweredGrammar {
        name: grammar.name,
        source_files: grammar.source_files,
        options: grammar.options,
        named_actions: grammar.named_actions,
        lexer_rules: grammar.lexer_rules,
        mode_names: grammar.mode_names,
        channels: grammar.channels,
        lit_tokens: *lit_tokens,
        parser_rules,
        diagnostics: ctx.diagnostics.to_list(),
    };
}

/// Which rules carry the FOLLOW slots, by snake name. The rules that gate on
/// the continuation or scan to it seed it; a rule that hands its continuation to one
/// of them joins, and that is what its own callers then see. Settled only once
/// every rule is lowered, and emit asks it at both ends of a call so the
/// declaration and the arguments cannot disagree.
fn follow_rule_snakes(grammar: &Grammar, analysis: &GrammarAnalysis, marks: &LowerMarks) -> List<String> {
    let forwards: List<List<i32>> = marks.follow_forward_edges.iter_ref().map(|targets| targets.iter_ref().map(
        |t| analysis.snake_rule_index(t),
    ).collect()).collect();
    let reads = close_over_callers(&forwards, marks.rule_reads_follow);
    let mut snakes: List<String> = [];
    for let mut i = 0; i < grammar.parser_rules.len(); i += 1 {
        if reads[i] {
            snakes.push(grammar.parser_rules[i].snake_name);
        }
    }
    return snakes;
}

/// The continuation each rule's entry passes: what follows the rule where the
/// parse starts at it (`GrammarAnalysis::entry_readings`).
fn entry_follow_sites(grammar: &Grammar, ctx: &mut LowerContext) -> List<i32> {
    let mut sites = List::<i32>::filled(grammar.parser_rules.len(), -1);
    if !ctx.marks.caller_follow_gate {
        return sites;
    }
    let entry = ctx.analysis.entry_readings(FOLLOW_SITE_DEPTH);
    for let ri of 0..<grammar.parser_rules.len() {
        assert !entry[ri].is_empty(), "every rule's entry reads on to the input end or a caller";
        if ctx.marks.follow_rule_snakes.contains_str(&grammar.parser_rules[ri].snake_name) {
            sites[ri] = ctx.intern_follow_site(&entry[ri]);
        }
    }
    return sites;
}

/// Classify a parser rule by shape and dispatch to the matching
/// lowering. Single-alt → `Simple`; multi-alt with no LR alt →
/// `MultiAlt`; multi-alt with at least one LR alt → `LeftRecursive`.
fn lower_rule(rule: &ParserRule, ctx: &mut LowerContext) -> Rule {
    // Scan-group leniency (`scan_group_is_nullable`) reads the rule's
    // scan-cyclic flag; record which rule we are lowering. Emit re-sets this per
    // rule later, so sharing the field is safe (lowering fully precedes emit).
    ctx.set_current_rule_index(ctx.analysis.rule_index_of(&rule.name));
    if rule.alternatives.len() == 1 {
        return Rule::Simple(lower_simple_rule(rule, ctx));
    }
    if rule_is_left_recursive(rule) {
        return Rule::LeftRecursive(lower_lr_rule(rule, ctx));
    }
    return Rule::MultiAlt(lower_multi_alt_rule(rule, ctx));
}

fn lower_simple_rule(rule: &ParserRule, ctx: &mut LowerContext) -> SimpleRule {
    let case_names = case_names_for_rule(&rule.alternatives);
    let alt_gc_starts = compute_alt_gc_starts(&rule.alternatives);
    let body = lower_alt_body(&rule.alternatives[0], 0, rule, ctx, &case_names, &alt_gc_starts, true);
    let scan_body = lower_scan_body(&rule.alternatives[0], ctx, &rule.name, true);
    return SimpleRule {
        header: lower_header(rule),
        body,
        scan_body,
    };
}

/// Lower a multi-alt rule (no LR alts). Disjoint first-sets dispatch as a
/// single token-led `if / else if` chain (`Direct`); overlapping
/// first-sets land in `Tournament` (scan-and-commit).
fn lower_multi_alt_rule(rule: &ParserRule, ctx: &mut LowerContext) -> MultiAltRule {
    let header = lower_header(rule);

    // Compute per-alt first sets up-front so the dispatch decision
    // sees them and the resulting `DispatchBranch.tokens` reuses the
    // same sets the per-alt analysis already computed.
    let mut first_sets: List<List<i32>> = [];
    for let alt of &rule.alternatives {
        let mut visiting: List<String> = [];
        first_sets.push(ctx.analysis.first_of_alt(alt, &mut visiting));
    }

    let case_names = case_names_for_rule(&rule.alternatives);
    let alt_gc_starts = compute_alt_gc_starts(&rule.alternatives);
    let mut alts: List<AltBody> = [];
    let mut scan_alts: List<ScanBody> = [];
    let mut all_indices: List<i32> = [];
    for let mut i = 0; i < rule.alternatives.len(); i += 1 {
        alts.push(lower_alt_body(&rule.alternatives[i], i, rule, ctx, &case_names, &alt_gc_starts, true));
        scan_alts.push(lower_scan_body(&rule.alternatives[i], ctx, &rule.name, true));
        all_indices.push(i);
    }

    let owner = DiagnosticOwner::rule_dispatch(&rule.name);
    let classes = alt_classes(
        &all_indices,
        &rule.alternatives,
        rule_is_left_recursive(rule),
        &first_sets,
        &mut ctx.analysis,
    );
    let dispatch = build_overlap_dispatch(&owner, &rule.alternatives, &all_indices, &classes, ctx);
    // The scan of a rule whose choice the simulator makes consults it as the
    // parse does.
    if ctx.simulator_makes_choice(rule, all_indices, true) {
        ctx.mark_asks_simulator("the choice among the alternatives");
    }
    return MultiAltRule {
        header,
        alts,
        scan_alts,
        dispatch: dispatch,
    };
}

/// Lower a directly-left-recursive rule. ANTLR4 rewrites
/// `expr : expr op expr | atom ;` into a precedence-climbing
/// `parse_expr(min_prec)` whose body parses an atom and then runs
/// a loop that dispatches on the next token to one of the LR
/// suffix bodies. We mirror that structure in GIR:
///
/// * `atom: MultiAltRule` — the non-LR alternatives, lowered
///   exactly as a regular multi-alt rule. When only one non-LR alt
///   exists, this is still a `MultiAltRule` with a single-branch
///   `Direct` dispatch — emit treats both cases uniformly.
/// * `lr_alts: List<LrAlt>` — per-LR-alt metadata: prefix-stripped
///   suffix, precedence assignment, conflict-min-precedence, last
///   internal self-ref index, suffix first-set, right-associativity.
/// * `lr_dispatch: LrDispatchData` — the suffix-loop overlap groups
///   and the indices of LR alts that have a non-empty suffix.
fn lower_lr_rule(rule: &ParserRule, ctx: &mut LowerContext) -> LeftRecursiveRule {
    let header = lower_header(rule);

    // Partition alts into atom (non-LR) and lr (LR). `check_left_recursion_ends`
    // has rejected a rule with no non-LR alt, so the GIR `atom: MultiAltRule`
    // (header derived from a non-empty alt set) always has one.
    let mut non_lr_indices: List<i32> = [];
    let mut lr_indices: List<i32> = [];
    for let mut i = 0; i < rule.alternatives.len(); i += 1 {
        if alt_is_left_recursive(&rule.alternatives[i], &rule.name) {
            lr_indices.push(i);
        } else {
            non_lr_indices.push(i);
        }
    }
    assert !non_lr_indices.is_empty();
    assert !lr_indices.is_empty();

    let total_lr: i32 = lr_indices.len();
    let mut atom = lower_lr_atom(rule, &non_lr_indices, ctx);

    // Lower each LR alt's suffix and compute its precedence /
    // metadata. `own_prec` follows ANTLR4's convention: first LR
    // alt in source order gets the highest precedence (`total_lr`),
    // last gets `1`.
    let case_names = case_names_for_rule(&rule.alternatives);
    let alt_gc_starts = compute_alt_gc_starts(&rule.alternatives);
    let mut lr_alts: List<LrAlt> = [];
    let mut lr_position: i32 = 0;
    for let lr_idx of &lr_indices {
        let alt = &rule.alternatives[*lr_idx];
        let own_prec = total_lr - lr_position;
        let conflict_min = compute_lr_conflict_min_prec(alt, own_prec, &lr_indices, rule, ctx, total_lr);
        lr_alts.push(lower_lr_alt(rule, *lr_idx, own_prec, conflict_min, ctx, &case_names, &alt_gc_starts));
        lr_position += 1;
    }
    let mut loop_edges = 0;
    for let a of &mut lr_alts {
        if lr_alt_has_suffix(&rule.alternatives[a.alt_index]) {
            a.loop_edge = loop_edges;
            loop_edges += 1;
        }
    }

    // ATN-class detection: the static suffix-first dispatch mis-commits when
    // an atom alt recursively references this rule with a trailing literal
    // that overlaps an LR suffix-first (the `'between' expr 'and' expr`
    // shape), when a suffix can open on a `.` / `~X`, or when a self-ref
    // nested in a suffix's subrule can meet a loop operator.
    // Route such a rule's loop-entry through the runtime simulator. So too a
    // rule whose atom choice the simulator makes: the static loop would take a
    // suffix the full context gives the caller (`new Map<T>()` in a TypeScript
    // initializer: `()` is the `new`'s, not a call suffix).
    let suffix_classes = lr_suffix_classes(rule, &lr_alts, ctx);
    let atom_routes = ctx.simulator_makes_choice(rule, non_lr_indices, false);
    let atn_class = atom_routes
        || lr_rule_is_atn_class(rule, &non_lr_indices, &lr_alts, &suffix_classes, &mut ctx.analysis);
    if atn_class {
        ctx.mark_needs_lr_atn(
            if atom_routes { "the atom choice" } else { "the left-recursion loop's choice of suffix" },
        );
    }

    // `valid_lr_alts` must line up with the ATN precedence-edge list (which
    // covers every real suffix) when the rule dispatches via the simulator, so
    // pass `atn_class` through.
    let lr_dispatch = compute_lr_dispatch_data(&lr_alts, &suffix_classes, atn_class);

    let mut cont_rests: List<LrContRest> = [];
    if !atn_class {
        stamp_lr_atom_mid_operands(&mut atom, rule, &non_lr_indices, &lr_alts, ctx, &mut cont_rests);
    }
    stamp_lr_self_ref_min_prec(&mut lr_alts, rule, ctx, atn_class, &mut cont_rests);
    let loop_checked = !atn_class && ctx.settings.prediction.verifies();
    if loop_checked {
        ctx.mark_checks_with_simulator();
    }
    if !cont_rests.is_empty() {
        forward_lr_cont_to_trailing_operands(&mut atom, &mut lr_alts, &rule.name, &rule.snake_name);
        ctx.mark_caller_follow_gate();
        ctx.mark_rule_reads_follow();
    }

    return LeftRecursiveRule {
        header,
        atom,
        lr_alts,
        lr_dispatch,
        atn_class,
        loop_checked,
        cont_rests,
    };
}

/// The class of each LR alt's suffix (`elements[1..]`), in `lr_alts` order.
fn lr_suffix_classes(rule: &ParserRule, lr_alts: &List<LrAlt>, ctx: &mut LowerContext) -> List<AltClass> {
    let mut out: List<AltClass> = [];
    for let a of lr_alts {
        let alt = &rule.alternatives[a.alt_index];
        let suffix = Alternative { ..*alt, elements: elements_from(&alt.elements, 1), actions: [] };
        out.push(alt_class(&suffix, &a.suffix_first, &mut ctx.analysis));
    }
    return out;
}

/// True when this LR rule's loop entry needs the runtime simulator's full
/// context, as with `'between' expr 'and' expr` beside `expr 'and' expr`.
fn lr_rule_is_atn_class(
    rule: &ParserRule,
    non_lr_indices: &List<i32>,
    lr_alts: &List<LrAlt>,
    suffix_classes: &List<AltClass>,
    analysis: &mut GrammarAnalysis,
) -> bool {
    // A suffix that can open on a `.` / `~X`, in place or behind a rule, admits
    // tokens its static `suffix_first` does not name — all of them when that
    // set is empty, and still the rest in `A? .` or `(w | A)`. No static
    // first-token check decides such a loop entry; the runtime simulator admits
    // the open end via `atn_state_cont_admits`.
    for let mut i = 0; i < lr_alts.len(); i += 1 {
        let a = &lr_alts[i];
        if a.loop_edge >= 0 && (a.suffix_first.is_empty() || alt_class_is_open_ended(&suffix_classes[i])) {
            return true;
        }
    }

    // A suffix that is a proper prefix of another's scans wherever the longer
    // one does, so no static pick between them is right.
    for let a of lr_alts {
        for let b of lr_alts {
            if lr_suffix_is_proper_prefix(
                rule,
                &rule.alternatives[a.alt_index],
                &rule.alternatives[b.alt_index],
                analysis,
            ) {
                return true;
            }
        }
    }

    let suffix_first_tokens = collect_lr_suffix_first_tokens_from_lowered(lr_alts);
    if suffix_first_tokens.is_empty() {
        return false;
    }
    // A self-reference nested in a subrule is ANTLR4's plain `e[0]`: it climbs
    // every operator, and only full context says whether it must leave one to
    // the rest of its suffix (`e (',' e)* '>>' e`). No precedence floor says
    // it: one that leaves the suffix its `'>>'` also refuses a `'>>'` when
    // another is left over.
    for let a of lr_alts {
        if nested_operand_meets_operator_in_suffix(&a.suffix.ops, &rule.name, &suffix_first_tokens) {
            return true;
        }
    }
    // An atom operand followed by a loop delimiter: the static dispatch would
    // commit the loop and starve the atom's own delimiter.
    for let idx of non_lr_indices {
        let alt = &rule.alternatives[*idx];
        for let mut i = 0; i + 1 < alt.elements.len(); i += 1 {
            if !element_is_self_ref(&alt.elements[i], &rule.name) {
                continue;
            }
            let tok = fixed_token_kind(&alt.elements[i + 1], analysis);
            if let Some(t) = tok {
                if suffix_first_tokens.contains(&t) {
                    return true;
                }
            }
        }
    }
    return false;
}

/// Whether `short`'s suffix is a proper prefix of `long`'s, element for element,
/// each a fixed token or a self-reference.
fn lr_suffix_is_proper_prefix(
    rule: &ParserRule,
    short: &Alternative,
    long: &Alternative,
    analysis: &mut GrammarAnalysis,
) -> bool {
    if short.elements.len() < 2 || short.elements.len() >= long.elements.len() {
        return false;
    }
    for let mut i = 1; i < short.elements.len(); i += 1 {
        let s = &short.elements[i];
        let l = &long.elements[i];
        let same = if element_is_self_ref(s, &rule.name) {
            element_is_self_ref(l, &rule.name);
        } else {
            let tok = fixed_token_kind(s, analysis);
            tok != null && tok == fixed_token_kind(l, analysis);
        };
        if !same {
            return false;
        }
    }
    return true;
}

/// The kind id of a fixed-token element, labeled or not, or `null` for
/// anything else.
fn fixed_token_kind(elem: &Element, analysis: &mut GrammarAnalysis) -> Option<i32> {
    return match elem {
        TokenRef(_) | Literal(_) => Option::Some(analysis.terminal_kind(elem)),
        Label(lab) => fixed_token_kind(&lab.element, analysis),
        _ => null,
    };
}

/// Stamps each operand of an LR suffix, parse and scan side alike, with its
/// precedence and continuation gate, adding to `rests` what each gated mid
/// operand leaves behind. A self-reference nested in a subrule is not an
/// operand but a plain call, ANTLR4's `e[0]`, so it keeps the callee's defaults.
fn stamp_lr_self_ref_min_prec(
    lr_alts: &mut List<LrAlt>,
    rule: &ParserRule,
    ctx: &mut LowerContext,
    atn_class: bool,
    rests: &mut List<LrContRest>,
) {
    let rule_name = &rule.name;
    let rule_snake = &rule.snake_name;
    let lr_suffix_first_tokens = collect_lr_suffix_first_tokens_from_lowered(lr_alts);
    for let mut i = 0; i < lr_alts.len(); i += 1 {
        let suffix_len = lr_alts[i].suffix.ops.len();
        let conflict_min = lr_alts[i].conflict_min;

        let scan_len = lr_alts[i].scan_suffix.elements.len();
        assert scan_len == suffix_len, "LR suffix walk length mismatch";

        let mut alt_gated = false;
        for let mut k = 0; k < suffix_len; k += 1 {
            // suffix.ops[k] / scan_suffix.elements[k] correspond to
            // alt.elements[k+1]. A scalar `Label` is collapsed by
            // `lower_label_op`, so only a `ListLabel` wraps an operand.
            if find_self_ref_rule_call(&lr_alts[i].suffix.ops[k], rule_name) matches { None } {
                continue;
            }
            let mut prec = compute_self_ref_prec_from_ops(
                &lr_alts[i].suffix.ops,
                k,
                conflict_min,
                &lr_suffix_first_tokens,
            );
            // A mid operand is ANTLR4's `e[0]`, a trailing one its own
            // precedence. An ATN-class loop decides its climb with full
            // context; the static dispatch hands a mid operand the
            // rest of its alternative to leave behind, and its loop stops at
            // the last boundary where that rest still scans.
            let mut cont = LrCont::Unset;
            let natural_trailing = lr_trailing_prec(lr_alts[i].own_prec, lr_alts[i].right_associative);
            if atn_class {
                prec = if k + 1 < suffix_len { 0 } else { natural_trailing };
            } else if alt_gated && k + 1 == suffix_len {
                prec = natural_trailing;
            } else if k + 1 < suffix_len
                && mid_operand_rest_contested(
                    &rule.alternatives[lr_alts[i].alt_index].elements,
                    k + 2,
                    &lr_suffix_first_tokens,
                    ctx,
                ) {
                prec = 0;
                cont = LrCont::Rest(rests.len());
                rests.push(LrContRest { body: LrRestBody::Suffix(i), from: k + 1 });
                alt_gated = true;
            }
            lr_alts[i].suffix.ops[k] = rebind_self_ref_lr_cont(
                rebind_self_ref_min_prec(lr_alts[i].suffix.ops[k], prec),
                cont,
            );
            lr_alts[i].scan_suffix.elements[k] = rebind_scan_self_ref_lr_cont(
                rebind_scan_self_ref_min_prec(lr_alts[i].scan_suffix.elements[k], rule_snake, prec),
                rule_snake,
                cont,
            );
        }
    }
}

/// Whether what follows a mid operand, `elements[from..]`, can start with a
/// token the loop takes, with any token (`.`, `~x`), or be empty. The
/// operand's loop could then climb past what its alternative needs, so it is
/// gated: it stops at the last boundary where that rest still parses.
/// Elsewhere, as in `'(' e ')'`, the loop stops by itself.
fn mid_operand_rest_contested(
    elements: &List<Element>,
    from: i32,
    lr_suffix_first_tokens: &List<i32>,
    ctx: &mut LowerContext,
) -> bool {
    return ctx.analysis.tail_is_nullable_deep(elements, from)
        || ctx.analysis.elements_reach_open_end(elements, from)
        || sets_overlap(&ctx.analysis.first_of_elements_from(elements, from), lr_suffix_first_tokens);
}

/// Stamps an atom's mid operand the way `stamp_lr_self_ref_min_prec` stamps a
/// suffix's. `'new' e '<'? args` owes `args` to the `new`, and the operand's
/// own call suffix would take them.
fn stamp_lr_atom_mid_operands(
    atom: &mut MultiAltRule,
    rule: &ParserRule,
    non_lr_indices: &List<i32>,
    lr_alts: &List<LrAlt>,
    ctx: &mut LowerContext,
    rests: &mut List<LrContRest>,
) {
    let lr_suffix_first_tokens = collect_lr_suffix_first_tokens_from_lowered(lr_alts);
    for let mut a = 0; a < atom.alts.len(); a += 1 {
        let elements = &rule.alternatives[non_lr_indices[a]].elements;
        let ops_len = atom.alts[a].ops.len();
        let scan_len = atom.scan_alts[a].elements.len();
        assert scan_len == ops_len, "LR atom walk length mismatch";
        for let mut k = 0; k + 1 < ops_len; k += 1 {
            if find_self_ref_rule_call(&atom.alts[a].ops[k], &rule.name) matches { None } {
                continue;
            }
            if !mid_operand_rest_contested(elements, k + 1, &lr_suffix_first_tokens, ctx) {
                continue;
            }
            let cont = LrCont::Rest(rests.len());
            rests.push(LrContRest { body: LrRestBody::Atom(a), from: k + 1 });
            atom.alts[a].ops[k] = rebind_self_ref_lr_cont(rebind_self_ref_min_prec(atom.alts[a].ops[k], 0), cont);
            atom.scan_alts[a].elements[k] = rebind_scan_self_ref_lr_cont(
                rebind_scan_self_ref_min_prec(atom.scan_alts[a].elements[k], &rule.snake_name, 0),
                &rule.snake_name,
                cont,
            );
        }
    }
}

/// A trailing operand ends the invocation it sits in, so the continuation that
/// invocation must leave behind is its own: `a or b` as a mid operand stops `b`
/// before `and`, and `-a` as one stops `a` before the arguments a `new` owes.
fn forward_lr_cont_to_trailing_operands<S: AsStrSlice, S1: AsStrSlice>(
    atom: &mut MultiAltRule,
    lr_alts: &mut List<LrAlt>,
    rule_name: S,
    rule_snake: S1,
) {
    let name = rule_name.to_string();
    let snake = rule_snake.to_string();
    for let mut a = 0; a < atom.alts.len(); a += 1 {
        forward_lr_cont_to_trailing_operand(&mut atom.alts[a].ops, &mut atom.scan_alts[a].elements, &name, &snake);
    }
    for let mut i = 0; i < lr_alts.len(); i += 1 {
        forward_lr_cont_to_trailing_operand(
            &mut lr_alts[i].suffix.ops,
            &mut lr_alts[i].scan_suffix.elements,
            &name,
            &snake,
        );
    }
}

/// `forward_lr_cont_to_trailing_operands` for one walk, parse and scan side.
fn forward_lr_cont_to_trailing_operand<S: AsStrSlice, S1: AsStrSlice>(
    ops: &mut List<Op>,
    scan: &mut List<ScanElement>,
    rule_name: S,
    rule_snake: S1,
) {
    let last = ops.len() - 1;
    if last < 0 || find_self_ref_rule_call(&ops[last], rule_name) matches { None } {
        return;
    }
    ops[last] = rebind_self_ref_lr_cont(ops[last], LrCont::Forward);
    scan[last] = rebind_scan_self_ref_lr_cont(scan[last], rule_snake, LrCont::Forward);
}

/// Set `lr_cont` on a self-ref `RuleCall`, peeling the `ListLabel` wrapper
/// `rebind_self_ref_min_prec` also handles.
fn rebind_self_ref_lr_cont(op: Op, lr_cont: LrCont) -> Op {
    if lr_cont matches { Unset } {
        return op;
    }
    if let RuleCall(rc) = op {
        return Op::RuleCall(RuleCallOp { ..rc, lr_cont });
    }
    if let ListLabel(ll) = op {
        return Op::ListLabel(ListLabelOp { ..ll, inner: rebind_self_ref_lr_cont(ll.inner, lr_cont) });
    }
    return op;
}

/// Scan mirror of `rebind_self_ref_lr_cont`.
fn rebind_scan_self_ref_lr_cont<S: AsStrSlice>(se: ScanElement, rule_snake: S, lr_cont: LrCont) -> ScanElement {
    if lr_cont matches { Unset } {
        return se;
    }
    if let RuleCall(rc) = se {
        if rc.target_snake == rule_snake.as_str_slice() {
            return ScanElement::RuleCall(ScanRuleCallElement { ..rc, lr_cont });
        }
    }
    return se;
}

/// Scan-side counterpart to `rebind_self_ref_min_prec`. Stamps
/// `min_prec_arg` on the top-level `ScanRuleCall` when it targets
/// `rule_snake` — for an LR self-ref the LR loop's `min_prec` is what
/// disambiguates the climb. The call's `follow_arg` is preserved
/// as-is; the runtime `follow` is threaded independently of the
/// precedence argument.
fn rebind_scan_self_ref_min_prec<S: AsStrSlice>(se: ScanElement, rule_snake: S, prec: i32) -> ScanElement {
    if let RuleCall(mut rc) = se {
        if rc.target_snake == rule_snake.as_str_slice() {
            rc.min_prec_arg = Option::Some(prec);
            return ScanElement::RuleCall(rc);
        }
    }
    return se;
}

/// The precedence `stamp_lr_self_ref_min_prec` gave the self-reference at
/// `lr.suffix.ops[k]`, the alternative's element `k + 1`.
pub fn lr_operand_prec<S: AsStrSlice>(lr: &LrAlt, k: i32, rule_name: S) -> i32 {
    let Some(rc) = find_self_ref_rule_call(&lr.suffix.ops[k], rule_name) else {
        panic(`suffix op ${k} of LR alt ${lr.alt_index} is not a self-reference`);
    };
    let Some(prec) = rc.min_prec_arg else {
        panic(`self-reference ${k} of LR alt ${lr.alt_index} was never stamped`);
    };
    return prec;
}

fn find_self_ref_rule_call<S: AsStrSlice>(op: &Op, rule_name: S) -> Option<&RuleCallOp> {
    return match op {
        RuleCall(rc) => if rc.target_name == rule_name.as_str_slice() { Option::Some(rc) } else { null },
        ListLabel(ll) => find_self_ref_rule_call(&ll.inner, rule_name),
        Token(_) | Literal(_) | Wildcard(_) | Excluded(_) | Repeat(_) | Group(_) => null,
    };
}

/// Whether a self-reference nested in a subrule of the LR suffix `ops` can be
/// followed, before the suffix ends, by a token in `operators`.
fn nested_operand_meets_operator_in_suffix<S: AsStrSlice>(ops: &List<Op>, rule_name: S, operators: &List<i32>) -> bool {
    for let mut k = 0; k < ops.len(); k += 1 {
        if find_self_ref_rule_call(&ops[k], rule_name) matches { Some(_) } {
            continue;
        }
        let follow_has = seq_first_has_lr(ops, k + 1, operators, false);
        if nested_operand_meets_operator(&ops[k], rule_name, operators, follow_has) {
            return true;
        }
    }
    return false;
}

/// Whether a self-reference inside `op` can be followed by a token in
/// `operators`; `follow_has` says whether what follows `op` can start with one.
fn nested_operand_meets_operator<S: AsStrSlice>(op: &Op, rule_name: S, operators: &List<i32>, follow_has: bool) -> bool {
    return match *op {
        RuleCall(rc) => follow_has && rc.target_name == rule_name.as_str_slice(),
        ListLabel(ll) => nested_operand_meets_operator(&ll.inner, rule_name, operators, follow_has),
        Repeat(r) => {
            // A `*` / `+` body is also followed by its own next iteration.
            let reiterates = r.kind matches { Star | Plus } && op_first_has_lr(&r.body, operators);
            nested_operand_meets_operator(&r.body, rule_name, operators, reiterates || follow_has);
        },
        Group(g) => {
            for let alt of &g.alts {
                for let mut j = 0; j < alt.ops.len(); j += 1 {
                    let inner_follow_has = seq_first_has_lr(&alt.ops, j + 1, operators, follow_has);
                    if nested_operand_meets_operator(&alt.ops[j], rule_name, operators, inner_follow_has) {
                        return true;
                    }
                }
            }
            false;
        },
        Token(_) | Literal(_) | Wildcard(_) | Excluded(_) => false,
    };
}

/// Stamp `prec` on a self-reference, bare or under its `ListLabel`; every
/// caller found it with `find_self_ref_rule_call` first.
fn rebind_self_ref_min_prec(op: Op, prec: i32) -> Op {
    if let ListLabel(mut ll) = op {
        ll.inner = rebind_self_ref_min_prec(ll.inner, prec);
        return Op::ListLabel(ll);
    }
    let RuleCall(mut rc) = op else {
        panic("rebind_self_ref_min_prec: not a self-reference");
    };
    rc.min_prec_arg = Option::Some(prec);
    return Op::RuleCall(rc);
}

/// True iff FIRST(`op`) can contain a token in `lr_first` (the union of
/// the rule's LR-suffix-first operator tokens). Opaque ops (RuleCall /
/// Wildcard / Excluded) return true conservatively.
fn op_first_has_lr(op: &Op, lr_first: &List<i32>) -> bool {
    return match *op {
        Token(t) => lr_first.contains(&t.kind),
        Literal(l) => lr_first.contains(&l.kind),
        RuleCall(_) | Wildcard(_) | Excluded(_) => true,
        Repeat(r) => op_first_has_lr(&r.body, lr_first),
        Group(g) => {
            for let alt of &g.alts {
                if seq_first_has_lr(&alt.ops, 0, lr_first, false) {
                    return true;
                }
            }
            false;
        },
        ListLabel(ll) => op_first_has_lr(&ll.inner, lr_first),
    };
}

/// True iff `op` can match the empty string.
fn op_nullable(op: &Op) -> bool {
    return match *op {
        Token(_) | Literal(_) | RuleCall(_) | Wildcard(_) | Excluded(_) => false,
        Repeat(r) => match r.kind {
            RepeatKind::Star => true,
            RepeatKind::Optional => true,
            RepeatKind::Plus => op_nullable(&r.body),
        },
        Group(g) => {
            for let alt of &g.alts {
                if seq_all_nullable(&alt.ops) {
                    return true;
                }
            }
            false;
        },
        ListLabel(ll) => op_nullable(&ll.inner),
    };
}

fn seq_all_nullable(ops: &List<Op>) -> bool {
    for let op of ops {
        if !op_nullable(op) {
            return false;
        }
    }
    return true;
}

/// True iff the content of `ops[idx..]`, followed by `tail_has`, can begin
/// with a token in `lr_first` — i.e. whether an LR operator can appear in
/// the FOLLOW of the position just before `ops[idx]`.
fn seq_first_has_lr(ops: &List<Op>, idx: i32, lr_first: &List<i32>, tail_has: bool) -> bool {
    if idx >= ops.len() {
        return tail_has;
    }
    if op_first_has_lr(&ops[idx], lr_first) {
        return true;
    }
    if op_nullable(&ops[idx]) {
        return seq_first_has_lr(ops, idx + 1, lr_first, tail_has);
    }
    return false;
}

/// Collect the union of every LR alt's `suffix_first` token set.
/// Used to decide whether a non-trailing self-ref must keep its
/// precedence so a shared delimiter binds at the right precedence.
fn collect_lr_suffix_first_tokens_from_lowered(lr_alts: &List<LrAlt>) -> List<i32> {
    let mut result: List<i32> = [];
    for let lr of lr_alts {
        dedup_append_arr(&mut result, &lr.suffix_first);
    }
    return result;
}

/// Pick the `min_prec` for a TOP-LEVEL self-recursive call at suffix
/// position `k`. A self-ref that is the alt's LAST element is the
/// trailing operand and keeps `conflict_min` (associativity). Otherwise
/// it drops to `0` — a primary reference — UNLESS the token that
/// immediately follows it is itself an LR-suffix-first operator, in which
/// case the ref must keep `conflict_min` so it cannot steal that operator
/// (BETWEEN…AND). This is why `'(' expr ')'` parses its inner `expr` as a
/// full expression: the `)` that follows is not an LR operator.
fn compute_self_ref_prec_from_ops(ops: &List<Op>, k: i32, conflict_min: i32, lr_suffix_first_tokens: &List<i32>) -> i32 {
    let mut prec = conflict_min;
    if k + 1 < ops.len() {
        let next_op = &ops[k + 1];
        let next_is_lr_op = match next_op {
            Token(t) => lr_suffix_first_tokens.contains(&t.kind),
            Literal(l) => lr_suffix_first_tokens.contains(&l.kind),
            RuleCall(_) | Wildcard(_) | Excluded(_) | Repeat(_) | Group(_) | ListLabel(_) => false,
        };
        if !next_is_lr_op {
            prec = 0;
        }
    }
    return prec;
}

/// Lower the atom side of an LR rule — the non-LR alternatives only.
/// Reuses `lower_multi_alt_rule`'s first-set + dispatch logic but
/// projects through `non_lr_indices` so the output's `alt_index`,
/// `case_name` / `struct_name` still match the ORIGINAL alt index in
/// the surface `rule.alternatives` list. emit relies on that
/// correspondence to look up case names from `header.case_names`.
fn lower_lr_atom(rule: &ParserRule, non_lr_indices: &List<i32>, ctx: &mut LowerContext) -> MultiAltRule {
    let header = lower_header(rule);

    let mut first_sets: List<List<i32>> = [];
    for let idx of non_lr_indices {
        let mut visiting: List<String> = [];
        first_sets.push(ctx.analysis.first_of_alt(&rule.alternatives[*idx], &mut visiting));
    }

    let case_names = case_names_for_rule(&rule.alternatives);
    let alt_gc_starts = compute_alt_gc_starts(&rule.alternatives);
    let mut alts: List<AltBody> = [];
    let mut scan_alts: List<ScanBody> = [];
    // An atom alt ends where the LR suffix loop begins, not at the rule's
    // tail, so no continuation scan here may ask the caller.
    for let idx of non_lr_indices {
        let body = lower_alt_body(&rule.alternatives[*idx], *idx, rule, ctx, &case_names, &alt_gc_starts, false);
        let mut scan = lower_scan_body(&rule.alternatives[*idx], ctx, &rule.name, false);
        if body.prefix_self_ref_min_prec > 0 {
            let last = scan.elements.len() - 1;
            let RuleCall(mut operand) = scan.elements[last] else {
                panic(`lower_lr_atom: prefix alt ${*idx} of '${rule.name}' does not scan its operand last`);
            };
            operand.min_prec_arg = Option::Some(body.prefix_self_ref_min_prec);
            scan.elements[last] = ScanElement::RuleCall(operand);
        }
        alts.push(body);
        scan_alts.push(scan);
    }

    let owner = DiagnosticOwner { rule: rule.name, site: DiagnosticSite::LrAtomDispatch };
    let classes = alt_classes(
        non_lr_indices,
        &rule.alternatives,
        rule_is_left_recursive(rule),
        &first_sets,
        &mut ctx.analysis,
    );
    let dispatch = build_overlap_dispatch(&owner, &rule.alternatives, non_lr_indices, &classes, ctx);
    return MultiAltRule {
        header,
        alts,
        scan_alts,
        dispatch: dispatch,
    };
}

/// Lower a single LR alternative. Strips the leading self-ref and
/// lowers everything after it as the alt's suffix body. The
/// precedence (`own_prec`) and conflict floor (`conflict_min`) are
/// computed by the caller and stored verbatim.
fn lower_lr_alt(
    rule: &ParserRule,
    alt_index: i32,
    own_prec: i32,
    conflict_min: i32,
    ctx: &mut LowerContext,
    case_names: &List<String>,
    alt_gc_starts: &List<i32>,
) -> LrAlt {
    let alt = &rule.alternatives[alt_index];
    assert !alt.elements.is_empty();

    // Build per-alt CST identifiers. `case_name` mirrors
    // `case_names_for_rule`, and `struct_name` follows the
    // `<RuleBase><CaseName>` convention the rest of `lower_alt_body`
    // uses. We don't reuse `lower_alt_body` directly because we need
    // the suffix elements (skipping the leading self-ref), not the
    // whole alt. `case_names` / `alt_gc_starts` are per-rule and
    // threaded in by `lower_lr_rule` so they are computed once, not
    // once per LR alt.
    let type_name = rule.type_name;
    let base = type_name.strip_suffix("Node").unwrap();
    let case_name = case_names[alt_index];
    let struct_name = `${base}${case_name}`;

    // Compute `last_self_ref_idx` — the index (within the original
    // alt's element list) of the LAST self-reference. -1 when the
    // only self-ref is the leading one. This drives emit's
    // "trailing self-ref drops back into the LR loop with the right
    // precedence" handling.
    let last_self_ref_idx = find_last_self_ref_idx(alt, &rule.name);

    // Suffix first-set drives the LR loop's per-iteration dispatch.
    let suffix_first = ctx.analysis.first_of_elements_from(&alt.elements, 1);

    // Lower the suffix (elements[1..]) as an AltBody / ScanBody.
    let suffix = lower_lr_alt_suffix(rule, alt_index, &case_name, &struct_name, ctx, alt_gc_starts);
    let scan_suffix = lower_lr_alt_scan_suffix(rule, alt_index, ctx);

    return LrAlt {
        alt_index: alt_index,
        case_name: case_name,
        struct_name: struct_name,
        suffix: suffix,
        scan_suffix: scan_suffix,
        own_prec: own_prec,
        conflict_min: conflict_min,
        last_self_ref_idx: last_self_ref_idx,
        suffix_first: suffix_first,
        right_associative: is_right_associative_alt(alt),
        prefix_self_ref: lr_prefix_field_decl(&alt.elements[0], &rule.name),
    };
}

fn lower_lr_alt_suffix<S: AsStrSlice, S1: AsStrSlice>(
    rule: &ParserRule,
    alt_index: i32,
    case_name: S,
    struct_name: S1,
    ctx: &mut LowerContext,
    alt_gc_starts: &List<i32>,
) -> AltBody {
    let alt = &rule.alternatives[alt_index];

    // Per-alt counter starts at this alt's position in the rule's
    // `alt_gc_starts` table (threaded in by `lower_lr_rule`, computed
    // once) — same as `lower_alt_body` does for the full-alt case. The
    // suffix walk continues from there.
    let mut group_counter: i32 = alt_gc_starts[alt_index];

    // Seed the dedup counter with the prefix self-ref's field name so
    // a trailing self-ref dedups to `<name>_2` — matching the
    // surface-IR `collect_fields` walk that flat-walked all elements
    // together. Without this seed, a `e op e` suffix would produce two
    // ops both named `e` and the resulting CST struct would carry
    // duplicate fields.
    let prefix_field = lr_prefix_field_decl(&alt.elements[0], &rule.name);
    let mut name_counts: List<[String, i32]> = [
        [prefix_field.name, 1],
    ];
    let mut ops: List<Op> = [];
    // Same per-element follow logic as `lower_alt_body`, but the
    // suffix starts at index 1 (index 0 is the stripped leading
    // self-ref).
    for let mut i = 1; i < alt.elements.len(); i += 1 {
        let elem_follow = ctx.analysis.compute_call_site_follow(&alt.elements, i);
        let elem_follow_arg = compute_follow_arg(ctx, &alt.elements, i);
        let elem_gate = compute_gate_caller_follow(ctx, &alt.elements, i);
        let elem_follow_exact = ctx.analysis.call_site_follow_is_exact(&alt.elements, i);
        let mut op = lower_op(
            &alt.elements[i],
            &mut name_counts,
            &rule.name,
            ctx,
            &mut group_counter,
            &elem_follow,
            elem_follow_arg,
            elem_gate,
            elem_follow_exact,
            &elements_from(&alt.elements, i + 1),
        );
        if let Some(rep_op) = op_repeat_inner(&op) {
            let basic_follow = ctx.analysis.first_of_elements_from(&alt.elements, i + 1);
            let basic_second = compute_caller_follow_second(&alt.elements, i + 1, ctx);
            let patched = Op::Repeat(patch_repeat_op_caller_follow(
                rep_op,
                basic_follow,
                basic_second,
                &alt.elements,
                i,
                ctx,
                false,
                &rule.name,
            ));
            op = rewrap_op_repeat(op, patched);
        }
        ops.push(op);
    }

    let fields = enumerate_alt_field_decls(&ops);

    return AltBody {
        alt_index: alt_index,
        case_name: case_name.to_string(),
        struct_name: struct_name.to_string(),
        ops: ops,
        fields: fields,
        prefix_self_ref_min_prec: 0,
    };
}

fn lower_lr_alt_scan_suffix(rule: &ParserRule, alt_index: i32, ctx: &mut LowerContext) -> ScanBody {
    let alt = &rule.alternatives[alt_index];
    let mut elements: List<ScanElement> = [];
    // LR suffix walks `alt.elements[1..]` — the leading self-ref is
    // stripped. The end-of-suffix outer follow is left empty; threading
    // the LR rule's caller-side follow through the precedence climb
    // would extend the runtime-FOLLOW repair to LR rules, which no
    // committed grammar yet exercises.
    for let mut i = 1; i < alt.elements.len(); i += 1 {
        elements.push(lower_alt_scan_element(
            &alt.elements,
            i,
            ctx,
            false,
        ));
    }
    return ScanBody {
        elements,
        gates: scan_gates_for(alt, ctx, 1),
        gate_cond: String::new(),
    };
}

/// Index (within `alt.elements`) of the LAST self-reference to
/// `rule_name`. Returns `-1` when the leading-prefix self-ref is
/// the ONLY self-ref. Mirrors what emit needs to know about
/// trailing self-refs (`expr op expr` has a trailing one;
/// `expr '++' ` does not).
fn find_last_self_ref_idx<S: AsStrSlice>(alt: &Alternative, rule_name: S) -> i32 {
    let mut last: i32 = -1;
    // Index 0 is the leading prefix self-ref (already known to
    // exist for an LR alt); we count any self-ref at i >= 1 as
    // "internal".
    for let mut i = 1; i < alt.elements.len(); i += 1 {
        if element_is_self_ref(&alt.elements[i], rule_name) {
            last = i;
        }
    }
    return last;
}

/// True iff `alt` carries `<assoc=right>` in its options. Mirrors
/// `parser_gen::is_right_associative`.
fn is_right_associative_alt(alt: &Alternative) -> bool {
    for let opt of &alt.options {
        if opt.name != "assoc" {
            continue;
        }
        if let Ident(v) = &opt.value {
            if *v == "right" {
                return true;
            }
        }
    }
    return false;
}

/// The precedence floor of `alt`'s operands, raised past any higher alt whose
/// suffix starts with a delimiter an operand of `alt` must leave behind (`AND`
/// in `e BETWEEN e AND e`). The operator right after the leading `e` follows
/// none of `alt`'s operands, so a higher suffix sharing it (`e '?'? '.' ID`
/// beside `e '?' e ':' e`) raises nothing.
fn compute_lr_conflict_min_prec(
    alt: &Alternative,
    own_prec: i32,
    lr_indices: &List<i32>,
    rule: &ParserRule,
    ctx: &mut LowerContext,
    total_lr: i32,
) -> i32 {
    let mut min_prec = lr_trailing_prec(own_prec, is_right_associative_alt(alt));

    let mut fixed_tokens: List<i32> = [];
    for let mut ei = 2; ei < alt.elements.len(); ei += 1 {
        if let Some(t) = fixed_token_kind(&alt.elements[ei], &mut ctx.analysis) {
            fixed_tokens.push(t);
        }
    }
    if fixed_tokens.is_empty() {
        return min_prec;
    }

    let mut lr_pos: i32 = 0;
    for let lr_idx of lr_indices {
        let other = &rule.alternatives[*lr_idx];
        if !lr_alt_has_suffix(other) {
            lr_pos += 1;
            continue;
        }
        let other_prec = total_lr - lr_pos;
        if other_prec <= own_prec {
            lr_pos += 1;
            continue;
        }
        let suffix_first = ctx.analysis.first_of_elements_from(&other.elements, 1);
        for let ft of &fixed_tokens {
            if suffix_first.contains(ft) {
                min_prec = i32::max(min_prec, other_prec + 1);
            }
        }
        lr_pos += 1;
    }
    return min_prec;
}

/// Build the LR loop's dispatch metadata. `valid_lr_alts` lists the
/// indices (into `lr_alts`) of alts whose suffix is non-empty —
/// degenerate `expr : expr` alts are filtered out. `groups` is the
/// overlap-group partition over those alts' suffix first sets.
fn compute_lr_dispatch_data(lr_alts: &List<LrAlt>, suffix_classes: &List<AltClass>, atn_class: bool) -> LrDispatchData {
    let mut valid_lr_alts: List<i32> = [];
    let mut suffix_first_sets: List<List<i32>> = [];
    for let mut i = 0; i < lr_alts.len(); i += 1 {
        let lr = &lr_alts[i];
        // Static dispatch gates on a non-empty `suffix_first`, so it drops a
        // `.` / `~X`-led suffix (empty static first). An ATN-class rule
        // dispatches via the simulator (`_atn_alt == i`, no static gate), so it
        // keeps EVERY real suffix — the same set the ATN precedence-edge list
        // builds, so the simulator's edge index lines up with these branches
        // and their `scan_X_lr_N` helpers. Only the static dispatch reads
        // `groups`: the simulator decides between suffixes admitting one token,
        // as ANTLR4 does.
        let skip = if atn_class { lr.loop_edge < 0 } else { lr.suffix_first.is_empty() };
        if skip {
            continue;
        }
        assert atn_class || !alt_class_is_open_ended(&suffix_classes[i]), "an open-ended LR suffix makes its rule ATN-class";
        valid_lr_alts.push(i);
        suffix_first_sets.push(lr.suffix_first);
    }

    // Overlap groups are tolerated here: emit's LR-suffix loop
    // resolves multi-alt groups via scan-dispatch on the suffix
    // (same scan-tournament pattern as the top-level `Tournament`
    // dispatch). The GIR carries the groups as-is; correctness
    // falls out of emit treating `group.len() > 1` as the cue to
    // generate a scan-and-commit cascade across the group's alts.
    let groups = compute_overlap_groups(&suffix_first_sets);

    return LrDispatchData {
        valid_lr_alts: valid_lr_alts,
        groups: groups,
    };
}

/// Build a `Direct` dispatch over alternatives whose first sets are disjoint
/// by construction — a token-only group's.
fn build_direct_dispatch(
    alts: &List<Alternative>,
    first_sets: &List<List<i32>>,
    ctx: &mut LowerContext,
) -> MultiAltDispatch {
    let slots = identity_slots(alts.len());
    return direct_dispatch(&alt_classes(&slots, alts, false, first_sets, &mut ctx.analysis), &slots);
}

/// The token-led chain itself: one branch per class, in `indices` order. Emit
/// translates it into `if / else if` and an error fallback.
fn direct_dispatch(classes: &List<AltClass>, indices: &List<i32>) -> MultiAltDispatch
    contract classes.len() == indices.len(), "one alternative index per class"
{
    let mut branches: List<DispatchBranch> = [];
    for let mut k = 0; k < indices.len(); k += 1 {
        if !classes[k] matches { Subsumed } {
            branches.push(DispatchBranch { alt_class: classes[k], alt_index: indices[k] });
        }
    }
    return MultiAltDispatch::Direct(DirectDispatch { branches });
}

fn any_open_ended(classes: &List<AltClass>) -> bool {
    return classes.iter_ref().any(|c: &AltClass| alt_class_is_open_ended(c));
}

/// Choose a dispatch for the alternatives `indices` selects: a token-led
/// `Direct` chain where the partition separates them all, otherwise a
/// `Tournament` over their scans — ANTLR4's longest-match LL choice, which
/// needs every alternative scannable. `owner` names the decision site in the
/// unscannable panic and keys the advisory diagnostic.
fn build_overlap_dispatch(
    owner: &DiagnosticOwner,
    alts: &List<Alternative>,
    indices: &List<i32>,
    classes: &List<AltClass>,
    ctx: &mut LowerContext,
) -> MultiAltDispatch {
    let n_classes = classes.len();
    let n_indices = indices.len();
    assert n_classes == n_indices, "classes is parallel to indices";

    // A lone alternative overlaps nothing, whatever it admits, so there is no
    // tournament to run and none to report.
    if n_indices < 2 {
        return direct_dispatch(classes, indices);
    }

    // Overlap is `compute_overlap_groups_of`'s answer, as at every emitted
    // decision: a branch of more than one alternative is exactly an overlap.
    let disjoint = !compute_overlap_groups_of(classes).iter_ref().any(|g: &List<i32>| g.len() > 1);
    // An open-ended alt reads as disjoint by its static set, and a Direct
    // chain would give it an unreachable empty-token branch.
    if disjoint && !any_open_ended(classes) {
        return direct_dispatch(classes, indices);
    }

    for let idx of indices {
        let mut visiting: List<String> = [];
        assert ctx.analysis.is_alt_scannable(&alts[*idx].elements, &mut visiting), "Tournament dispatch needs all alts scannable";
    }

    // Surface the overlap as an advisory diagnostic.
    let shared = shared_overlap_tokens(classes);
    // Reporting the shared set for an open-ended alt would read as `{}`.
    let cause = if shared.is_empty() {
        "an open-ended alternative (`.` / `~X`) overlaps every lookahead";
    } else {
        `share lookahead {${ctx.analysis.token_names_of(&shared).join(", ")}}`;
    };
    ctx.diagnostics.warn(
        owner,
        DiagnosticKind::OverlapTournament,
        `alts ${join_kind_list(indices)} ${cause}; resolved by longest-match scan tournament, not a token-led branch`,
    );

    let mut sorted: List<i32> = [];
    for let k of 0..<n_indices {
        if !classes[k] matches { Subsumed } {
            sorted.push(indices[k]);
        }
    }
    sort_group_by_element_count(&mut sorted, alts);
    return MultiAltDispatch::Tournament(TournamentDispatch { alts: sorted });
}

/// Collect the token kinds that appear in more than one alt's first
/// set — the lookahead that made the alts overlap. Order follows first
/// appearance so the message is stable across runs.
fn shared_overlap_tokens(classes: &List<AltClass>) -> List<i32> {
    let mut first_sets: List<List<i32>> = [];
    for let c of classes {
        first_sets.push(alt_class_first_set(c));
    }
    let mut shared: List<i32> = [];
    for let mut i = 0; i < first_sets.len(); i += 1 {
        for let tok of &first_sets[i] {
            if shared.contains(tok) {
                continue;
            }
            let mut seen_elsewhere = false;
            for let mut j = 0; j < first_sets.len(); j += 1 {
                if j != i && first_sets[j].contains(tok) {
                    seen_elsewhere = true;
                    break;
                }
            }
            if seen_elsewhere {
                shared.push(*tok);
            }
        }
    }
    return shared;
}

/// Render alt indices as `0, 1, 2` for a diagnostic message.
fn join_kind_list(indices: &List<i32>) -> String {
    let mut out = String::with_capacity(indices.len() * 3);
    for let mut i = 0; i < indices.len(); i += 1 {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(`${indices[i]}`);
    }
    return out;
}

/// FieldDecl for the leading self-reference element of an LR alt
/// (the element ANTLR4's left-recursion rewrite strips from the parse
/// path). The element is constrained by `alt_is_left_recursive` to a
/// RuleRef self-ref, possibly wrapped in a Label; we mirror the
/// surface-IR `element_to_field` shape so emit's CST struct lays out
/// the same field as before the GIR migration.
fn lr_prefix_field_decl<S: AsStrSlice>(elem: &Element, rule_name: S) -> FieldDecl {
    let type_str = rule_type_name(rule_name);
    return match *elem {
        RuleRef(r) => FieldDecl {
            name: r.field_name,
            type_str: type_str,
            kind: FieldKind::Plain,
        },
        Label(lab) => {
            let inner_type = if lab.list { `List<${type_str}>` } else { type_str };
            let kind = if lab.list { FieldKind::List } else { FieldKind::Plain };
            FieldDecl { name: lab.field_name, type_str: inner_type, kind: kind };
        },
        _ => panic("lr_prefix_field_decl: LR alt's first element must be a self-ref RuleRef (possibly labeled)"),
    };
}

/// Lower the scan-side body for an alternative — the structural
/// twin of `lower_alt_body` for the `scan_<rule>` predicate
/// emission. Covers every shape `lower_op` handles: leaf ops, scalar
/// `Label` rebinds, `Repeat` (greedy / non-greedy / Optional with
/// follow propagation), and every `Group` shape
/// (`Transparent` / `SingleAlt` / `TokenOnly` / `SimpleCst` /
/// `General`).
///
/// The scan side has no field bindings, no struct construction, and
/// no name dedup — it only produces a token-stream walk that
/// returns the new `pos`.
fn lower_scan_body<S: AsStrSlice>(
    alt: &Alternative,
    ctx: &mut LowerContext,
    rule_name: S,
    reaches_rule_tail: bool,
) -> ScanBody {
    let enclosing_rule = rule_name.to_string();
    let mut elements: List<ScanElement> = [];
    for let mut i = 0; i < alt.elements.len(); i += 1 {
        elements.push(lower_alt_scan_element(
            &alt.elements,
            i,
            ctx,
            reaches_rule_tail,
            true,
            &enclosing_rule,
        ));
    }
    return alt_scan_body(alt, elements, ctx);
}

/// What a scan of `alt` runs between elements — see `scan_gate.wado`: the
/// predicates past its left edge it answers, then the gate actions it can run
/// by walking. They keep `alt`'s order, since every answered predicate sits
/// ahead of the first action. Empty unless the grammar declares a simulable
/// gate member or a scan answers a predicate, so any other grammar lowers
/// exactly as before.
///
/// `from` is the surface index the scan body starts at. An LR suffix walks
/// `elements[1..]`, so it positions its gates against what it actually emits.
///
/// A gate before `from` is dropped, not repositioned. The LR rewrite stripped it
/// with the leading self-ref, and `emit_lr_branch_body` interleaves the
/// alternative's actions from `before == 1`. The parse never runs it, so
/// simulating it leaves the scan holding a value no parse produces.
fn scan_gates_for(alt: &Alternative, ctx: &mut LowerContext, from: i32 = 0) -> List<ScanGate> {
    if !ctx.settings.emit_scan_gate() {
        return [];
    }
    let checks = ctx.alt_scan_checks(alt, from);
    let escapes = ctx.alt_scan_escapes(alt, from);
    let settings = &ctx.settings;
    let mut gates: List<ScanGate> = [];
    for let at of from..=alt.elements.len() {
        let mut push = |step: ScanGateStep| gates.push(ScanGate { step, before_index: at - from });
        for let [i, cond] of &escapes.after_elements {
            if *i == at {
                push(ScanGateStep::Escape(*cond));
            }
        }
        for let [i, cond] of &checks {
            if *i == at {
                push(ScanGateStep::Check(*cond));
            }
        }
        for let a of &alt.actions {
            if a.kind matches { Predicate } || a.before_index != at {
                continue;
            }
            let body = settings.gate_body(a.source.action_id);
            if let Some(hit) = gate_assignment(&body) && settings.scan_gate_fields.contains(&hit.0) {
                push(ScanGateStep::Assign(hit));
            }
        }
        if let Some([i, cond]) = escapes.at_action && i == at {
            push(ScanGateStep::Escape(cond));
        }
    }
    return gates;
}

fn lower_scan_element(
    elem: &Element,
    ctx: &mut LowerContext,
    outer_follow: &List<i32>,
    follow_arg: FollowArg,
    gate_caller_follow: bool,
    follow_is_exact: bool = false,
    outer_suffix: &List<Element> = &NO_OUTER_SUFFIX,
) -> ScanElement {
    return match *elem {
        TokenRef(_) | Literal(_) => ScanElement::Token(ScanTokenElement { kind: ctx.analysis.terminal_kind(elem) }),
        RuleRef(r) => ScanElement::RuleCall(ScanRuleCallElement {
            target_snake: r.snake_name,
            follow_arg: follow_arg,
            min_prec_arg: null,
            atn_call_site: r.atn_call_site,
        }),
        Wildcard(_) => ScanElement::Wildcard,
        Not(ne) => ScanElement::Excluded(ScanExcludedElement {
            kinds: collect_excluded_kinds(&ne.element, &mut ctx.analysis),
        }),
        Label(lab) => lower_scan_element(
            &lab.element,
            ctx,
            outer_follow,
            follow_arg,
            gate_caller_follow,
            follow_is_exact,
            outer_suffix,
        ),
        Repeat(rep) => lower_scan_repeat(
            &rep,
            ctx,
            outer_follow,
            follow_arg,
            gate_caller_follow,
            outer_suffix,
        ),
        Group(g) => lower_scan_group(
            &g,
            ctx,
            outer_follow,
            follow_arg,
            follow_is_exact,
            gate_caller_follow,
            outer_suffix,
        ),
    };
}

/// Scan-side twin of `lower_group_op`. The scan side has no struct
/// construction, so the shape distinction matters only for the
/// dispatch step: single-alt groups have no dispatch (one body run
/// unconditionally / wrapped in a one-alt `ScanGroupElement`), while
/// multi-alt token-only groups dispatch on token kind.
fn lower_scan_group(
    g: &GroupElement,
    ctx: &mut LowerContext,
    outer_follow: &List<i32>,
    follow_arg: FollowArg,
    follow_is_exact: bool,
    enclosing_at_tail: bool = true,
    outer_suffix: &List<Element> = &NO_OUTER_SUFFIX,
) -> ScanElement {
    let alts = &g.alternatives;
    match classify_group(alts) {
        Transparent => {
            // The wrapper adds nothing, so the outer follow, its FollowArg and
            // gate, its exactness and the enclosing suffix pass through — the
            // parse side reads them here too (invariant 9). A predicate on the
            // alternative is what keeps the wrapper: its body is where the scan
            // answers it.
            let walk = lower_scan_element(
                &alts[0].elements[0],
                ctx,
                outer_follow,
                follow_arg,
                enclosing_at_tail,
                follow_is_exact,
                outer_suffix,
            );
            let body = alt_scan_body(&alts[0], [walk], ctx);
            if body.gates.is_empty() && body.gate_cond.is_empty() {
                return body.elements[0];
            }
            return ScanElement::Group(ScanGroupElement {
                alts: [body],
                lenient: false,
                alt_classes: [alt_class_of(&alts[0], &mut ctx.analysis)],
            });
        },
        SingleAlt => {
            let alt = &alts[0];
            let mut elements: List<ScanElement> = [];
            for let mut i = 0; i < alt.elements.len(); i += 1 {
                elements.push(lower_alt_scan_element(
                    &alt.elements,
                    i,
                    ctx,
                    false,
                    enclosing_at_tail,
                    &NO_ENCLOSING_RULE,
                    outer_suffix,
                ));
            }
            return ScanElement::Group(ScanGroupElement {
                alts: [alt_scan_body(alt, elements, ctx)],
                lenient: false,
                alt_classes: [alt_class_of(alt, &mut ctx.analysis)],
            });
        },
        TokenOnly => {
            let mut bodies: List<ScanBody> = [];
            let mut classes: List<AltClass> = [];
            for let alt of alts {
                let elem = &alt.elements[0];
                let token = lower_scan_element(elem, ctx, outer_follow, FollowArg::NoFollow, false);
                bodies.push(alt_scan_body(alt, [token], ctx));
                classes.push(AltClass::Selects([ctx.analysis.terminal_kind(elem)]));
            }
            return ScanElement::Group(ScanGroupElement {
                alts: bodies,
                lenient: false,
                alt_classes: classes,
            });
        },
        SimpleCst => {
            let se = lower_simple_cst_scan_group(alts, ctx, outer_follow, follow_is_exact, outer_suffix);
            return with_scan_group_atn_site(se, g, outer_follow, follow_is_exact, ctx);
        },
        General => {
            let se = lower_general_scan_group(
                alts,
                ctx,
                outer_follow,
                follow_is_exact,
                enclosing_at_tail,
                outer_suffix,
            );
            return with_scan_group_atn_site(se, g, outer_follow, follow_is_exact, ctx);
        },
    }
}

fn with_scan_group_atn_site(
    se: ScanElement,
    g: &GroupElement,
    outer_follow: &List<i32>,
    follow_is_exact: bool,
    ctx: &mut LowerContext,
) -> ScanElement {
    let Group(mut sg) = se else {
        return se;
    };
    let admits = group_empty_alt_admits(&g.alternatives, outer_follow, follow_is_exact, ctx);
    sg.atn_site = group_atn_site(g, &sg.alt_classes, &admits, ctx);
    return ScanElement::Group(sg);
}

/// `g`'s decision site where only the simulator can tell which alternative the
/// rest of the input takes: its empty alternative shares a branch with another,
/// or any two share one where the simulator takes a contested decision
/// (`simulator_takes_contested`). Else -1.
fn group_atn_site(
    g: &GroupElement,
    classes: &List<AltClass>,
    admits: &Option<EmptyAltAdmits>,
    ctx: &mut LowerContext,
) -> i32 {
    if shares_empty_alt(classes, admits) {
        ctx.mark_asks_simulator("a group's choice between its empty alternative and another");
        return g.atn_decision;
    }
    if ctx.simulator_takes_contested() && decision_partition(classes).iter_ref().any(|b| b.alts.len() > 1) {
        ctx.mark_asks_simulator("a group's choice among alternatives sharing a first token");
        return g.atn_decision;
    }
    return -1;
}

fn lower_general_scan_group(
    alts: &List<Alternative>,
    ctx: &mut LowerContext,
    outer_follow: &List<i32>,
    follow_is_exact: bool,
    enclosing_at_tail: bool = true,
    outer_suffix: &List<Element> = &NO_OUTER_SUFFIX,
) -> ScanElement {
    let mut bodies: List<ScanBody> = [];
    for let alt of alts {
        let mut elements: List<ScanElement> = [];
        for let mut i = 0; i < alt.elements.len(); i += 1 {
            elements.push(lower_alt_scan_element(
                &alt.elements,
                i,
                ctx,
                false,
                enclosing_at_tail,
                &NO_ENCLOSING_RULE,
                outer_suffix,
            ));
        }
        bodies.push(alt_scan_body(alt, elements, ctx));
    }
    return scan_group_element(bodies, alts, outer_follow, follow_is_exact, ctx);
}

/// The scan body of `alt`, walking `elements` and clearing the alternative's
/// gates. A group's alternative clears them as a rule's does, since prediction
/// meets a predicate inside a group as it does in a rule.
fn alt_scan_body(alt: &Alternative, elements: List<ScanElement>, ctx: &mut LowerContext) -> ScanBody {
    return ScanBody {
        elements,
        gates: scan_gates_for(alt, ctx),
        gate_cond: ctx.alt_scan_gate_conditions(alt),
    };
}

/// A standalone scan group over `bodies` — the leniency its alternatives call
/// for, and the one classification lower makes for every shape (invariant 9).
fn scan_group_element(
    bodies: List<ScanBody>,
    alts: &List<Alternative>,
    outer_follow: &List<i32>,
    follow_is_exact: bool,
    ctx: &mut LowerContext,
) -> ScanElement {
    let empty_alt_admits = group_empty_alt_admits(alts, outer_follow, follow_is_exact, ctx);
    return ScanElement::Group(ScanGroupElement {
        alts: bodies,
        lenient: scan_group_lenient(alts, ctx),
        alt_classes: group_alt_classes(alts, &empty_alt_admits, &mut ctx.analysis),
    });
}

/// A repeat body's own group, scanned strict: finding no alternative is the body
/// not matching, which an optional's continuation scan and an iteration both
/// read. Lenient, it rewinds and reports a match of nothing, and the optional
/// enters a group none of whose alternatives fits
/// (`('-'? 'a' 'b' | 'a' 'd')? 'a' 'c'` on `a c`). A
/// group that can match empty stays lenient, and so does one holding a
/// non-greedy loop, which a scan measures rather than decides.
fn strict_repeat_body(body: ScanElement, elem: &Element, ctx: &mut LowerContext) -> ScanElement {
    let Group(ge) = body else {
        return body;
    };
    let Group(g) = peel_labels(elem) else {
        unreachable();
    };
    if scan_group_is_nullable(&g.alternatives, ctx) || alts_hold_non_greedy(&g.alternatives) {
        return body;
    }
    return ScanElement::Group(ScanGroupElement { ..ge, lenient: false });
}

fn alts_hold_non_greedy(alts: &List<Alternative>) -> bool {
    return alts.iter_ref().any(|alt| alt.elements.iter_ref().any(|e| element_holds_non_greedy(e)));
}

fn element_holds_non_greedy(e: &Element) -> bool {
    return match e {
        Repeat(r) => r.non_greedy || element_holds_non_greedy(&r.element),
        Label(l) => element_holds_non_greedy(&l.element),
        Group(g) => alts_hold_non_greedy(&g.alternatives),
        Not(_) | RuleRef(_) | TokenRef(_) | Literal(_) | Wildcard(_) => false,
    };
}

/// The scan group a `GroupOp` carries: the bodies lower built, paired here —
/// and only here — with the classification lower made, so emit can only read
/// it (invariant 9).
fn group_op_scan_group(
    bodies: &List<ScanBody>,
    alts: &List<Alternative>,
    empty_alt_admits: &Option<EmptyAltAdmits>,
    ctx: &mut LowerContext,
) -> ScanGroupElement
    contract bodies.len() == alts.len(), "one scan body per alternative"
{
    // Strict, not `scan_group_lenient`'s answer: this copy is scanned only by
    // the optional's entry guard, which cannot rewind and call it a match.
    let lenient = false;
    return ScanGroupElement {
        alts: *bodies,
        lenient,
        alt_classes: group_alt_classes(alts, empty_alt_admits, &mut ctx.analysis),
    };
}

/// The `GroupOp` a multi-alt shape becomes: one classification of `alts`, the
/// dispatch that reads it, and the scan group carrying the same one.
fn group_op(
    shape: GroupShape,
    owner: &DiagnosticOwner,
    alts: &List<Alternative>,
    bodies: List<AltBody>,
    scan_bodies: &List<ScanBody>,
    outer_follow: &List<i32>,
    follow_is_exact: bool,
    ctx: &mut LowerContext,
) -> Op {
    let empty_alt_admits = group_empty_alt_admits(alts, outer_follow, follow_is_exact, ctx);
    let classes = group_alt_classes(alts, &empty_alt_admits, &mut ctx.analysis);
    return Op::Group(GroupOp {
        shape: shape,
        alts: bodies,
        scan_group: group_op_scan_group(scan_bodies, alts, &empty_alt_admits, ctx),
        dispatch: build_overlap_dispatch(owner, alts, &identity_slots(alts.len()), &classes, ctx),
        empty_alt_admits: empty_alt_admits,
    });
}

/// Whether a required scan group is emitted `lenient` — bailing out at its entry
/// position on no match instead of failing. The lenient over-approximation is
/// what the longest-match tournament relies on, so it is the default; only a
/// mandatory (non-nullable) group whose rule's scan can re-enter itself at the
/// same position (`is_rule_scan_cyclic`) must scan strict, or that
/// zero-consumption cycle never terminates (issue #1671).
fn scan_group_lenient(alts: &List<Alternative>, ctx: &mut LowerContext) -> bool {
    if scan_group_is_nullable(alts, ctx) {
        return true;
    }
    // A group the scan decides rather than approximates: finding no alternative
    // is then the answer the parse will give, and rewinding instead reports the
    // prefix before the group as a match —
    // `item : outerAttribute* (visItem | macroItem)` measures `#[a]` as an item
    // the parse refuses, and the tournament has already committed to it.
    if scan_group_is_decidable(alts, ctx) {
        return false;
    }
    let cyclic = ctx.analysis.is_rule_scan_cyclic(ctx.current_rule_index());
    return !cyclic;
}

/// True iff every alternative is a flat sequence of scannable rule / token
/// references — no repeat, group or wildcard.
///
/// The shape is the point, not just scannability. A scan measures a non-greedy
/// repeat rather than deciding it, so a group containing one can fail where the
/// parse succeeds, and making that group strict loses the whole rule: SQLite's
/// `create_table_stmt` has `( ',' column_def )*?` inside exactly such a group.
/// A flat sequence has no such decision in it — it matches or it does not.
fn scan_group_is_decidable(alts: &List<Alternative>, ctx: &mut LowerContext) -> bool {
    for let alt of alts {
        for let e of &alt.elements {
            if !peel_labels(e) matches { RuleRef(_) | TokenRef(_) | Literal(_) } {
                return false;
            }
            let mut visiting: List<String> = [];
            if !ctx.analysis.is_element_scannable(e, &mut visiting) {
                return false;
            }
        }
    }
    return true;
}

/// True iff some alternative of the group is fully nullable (the group can match
/// zero tokens grammatically).
fn scan_group_is_nullable(alts: &List<Alternative>, ctx: &mut LowerContext) -> bool {
    for let alt of alts {
        let mut all_null = true;
        for let e of &alt.elements {
            let mut visiting: List<String> = [];
            if !ctx.analysis.element_is_nullable_deep(e, &mut visiting) {
                all_null = false;
                break;
            }
        }
        if all_null {
            return true;
        }
    }
    return false;
}

/// What one iteration of a repeat's body admits: every token for a body
/// reaching `.` or `~X`, nothing for one deriving only epsilon.
fn repeat_inner_admits(inner: &Element, inner_first: &List<i32>, ctx: &mut LowerContext) -> Admits {
    let mut visiting: List<String> = [];
    if ctx.analysis.element_reaches_open_end(inner, &mut visiting) {
        // The enumerated subset is kept: the repeat-exit probe gates on it.
        return Admits::Everything(*inner_first);
    }
    return admits_or_untestable(inner_first);
}

/// A repeat's `body_admits`, widened for a greedy `b?` whose `b` matches empty:
/// entering is the preferred alternative, so what follows the `?` enters too.
/// An inexact follow set is left out, for `group_empty_alt_admits`'s reason.
fn repeat_body_admits(
    rep: &RepeatElement,
    inner_first: &List<i32>,
    outer_follow: &List<i32>,
    follow_is_exact: bool,
    ctx: &mut LowerContext,
) -> Admits {
    let admits = repeat_inner_admits(&rep.element, inner_first, ctx);
    if rep.non_greedy || !rep.kind matches { Optional } || !follow_is_exact || outer_follow.is_empty() {
        return admits;
    }
    let mut visiting: List<String> = [];
    if !ctx.analysis.element_is_nullable_deep(&rep.element, &mut visiting) {
        return admits;
    }
    return match admits {
        Everything(_) => admits,
        _ => admits_or_untestable(&union_kind_arrays(inner_first, outer_follow)),
    };
}

/// Scan-side twin of `lower_repeat_op`. Same restrictions: greedy
/// `Star` / `Plus` with a leaf inner only.
fn lower_scan_repeat(
    rep: &RepeatElement,
    ctx: &mut LowerContext,
    outer_follow: &List<i32>,
    follow_arg: FollowArg,
    gate_caller_follow: bool,
    outer_suffix: &List<Element> = &NO_OUTER_SUFFIX,
) -> ScanElement {
    // Greedy Optional + Group inner with nested optional sub-elements
    // is the shape-based-lookahead case: lower produces
    // `ScanElement::OptionalLookahead` so emit reads per-shape sigs
    // instead of running a regular scan-repeat (which would fire on
    // the first leading token without disambiguating the inner
    // optional shape, breaking `( (a)? b )?`-style cases).
    if !rep.non_greedy {
        if let Optional = rep.kind {
            if let Group(g) = peel_labels(&rep.element) {
                if g.alternatives.len() == 1
                    && has_nested_optional_in_alt(&g.alternatives[0])
                    && !alt_has_variable_repeat(&g.alternatives[0])
                    && !shape_optional_count_exceeds_cap(&g.alternatives[0].elements) {
                    let plain = lower_scan_plain_repeat(
                        rep,
                        ctx,
                        outer_follow,
                        follow_arg,
                        gate_caller_follow,
                        outer_suffix,
                    );
                    return lower_scan_optional_lookahead_group(
                        &g.alternatives[0],
                        ctx,
                        plain,
                        gate_caller_follow,
                        outer_suffix,
                    );
                }
            }
        }
    }
    return ScanElement::Repeat(lower_scan_plain_repeat(
        rep,
        ctx,
        outer_follow,
        follow_arg,
        gate_caller_follow,
        outer_suffix,
    ));
}

fn lower_scan_plain_repeat(
    rep: &RepeatElement,
    ctx: &mut LowerContext,
    outer_follow: &List<i32>,
    follow_arg: FollowArg,
    gate_caller_follow: bool,
    outer_suffix: &List<Element>,
) -> ScanRepeatElement {
    let inner_suffix = repeat_body_suffix(rep, outer_suffix);
    let inner_follow_arg = repeat_body_follow(ctx, rep, follow_arg, &inner_suffix);
    let mut inner_visiting: List<String> = [];
    let inner_first = ctx.analysis.first_of_element(&rep.element, &mut inner_visiting);

    let iter_follow = union_kind_arrays(&inner_first, outer_follow);

    let lowered = lower_scan_element(
        &rep.element,
        ctx,
        &iter_follow,
        inner_follow_arg,
        gate_caller_follow,
        false,
        &inner_suffix,
    );
    let body = strict_repeat_body(lowered, &rep.element, ctx);
    let effective_gate = gate_caller_follow && !rep.non_greedy;
    if effective_gate {
        ctx.mark_caller_follow_gate();
        ctx.mark_rule_reads_follow();
    }
    let mut body_visiting: List<String> = [];
    return ScanRepeatElement {
        kind: rep.kind,
        body,
        inner_admits: repeat_inner_admits(&rep.element, &inner_first, ctx),
        caller_follow_first: *outer_follow,
        gate_caller_follow: effective_gate,
        non_greedy: rep.non_greedy,
        body_second_position_first: compute_body_second_position_first(&rep.element, ctx),
        body_scannable: ctx.analysis.is_element_scannable(&rep.element, &mut body_visiting),
        atn_decision: rep.atn_decision,
    };
}

/// Rebuild a top-level `ScanElement::Repeat` with a fresh
/// `caller_follow_first`. No-op for non-Repeat elements. Used by
/// alt-level scan walkers (`lower_scan_body`,
/// `lower_lr_alt_scan_suffix`, per-shape walks inside groups) to
/// override the default that `lower_scan_repeat` seeded with
/// `outer_follow`, matching the parse-side `RepeatOp` post-pass.
fn rebind_scan_repeat_caller_follow(
    se: ScanElement,
    caller_follow_first: List<i32>,
    alt_elements: &List<Element>,
    index: i32,
    ctx: &mut LowerContext,
    reaches_rule_tail: bool,
    rule_name: &String = &NO_ENCLOSING_RULE,
    outer_suffix: &List<Element> = &NO_OUTER_SUFFIX,
) -> ScanElement {
    let mut rebind = |re: ScanRepeatElement| {
        let caller_follow_second = compute_caller_follow_second(alt_elements, index + 1, ctx);
        let stamps = lower_repeat_exit_stamps(
            re.non_greedy,
            re.kind,
            &re.inner_admits,
            &caller_follow_first,
            &re.body_second_position_first,
            &caller_follow_second,
            alt_elements,
            index,
            ctx,
            reaches_rule_tail,
            re.gate_caller_follow,
            rule_name,
            outer_suffix,
        );
        return ScanRepeatElement {
            ..re,
            caller_follow_first,
            caller_follow_second,
            continuation_scan: stamps.continuation.elements,
            continuation_scannable: stamps.continuation.scannable,
            continuation_reaches_caller: stamps.continuation.reaches_caller,
            continuation_contested: stamps.continuation_contested,
            static_exit_undecided: stamps.static_exit_undecided,
            atn_decides: stamps.atn_decides,
            atn_asked_kinds: stamps.atn_asked_kinds,
            caller_follow_kinds: stamps.continuation.caller_follow_kinds,
            duties: stamps.duties,
        };
    };
    if let Repeat(re) = se {
        return ScanElement::Repeat(rebind(re));
    }
    if let OptionalLookahead(ole) = se && let Some(re) = ole.as_repeat {
        return ScanElement::OptionalLookahead(ScanOptionalLookaheadElement {
            ..ole,
            as_repeat: Option::Some(rebind(re)),
        });
    }
    return se;
}

/// Default for scan walks with no enclosing rule to stamp from — group
/// bodies and continuation walks, where `reaches_rule_tail` is false and
/// the rule's FOLLOW is never read.
global NO_ENCLOSING_RULE: String = "";

/// Scan mirror of the elements after `index`, or `null` when any of them is
/// unscannable. The continuation scan and the reserve lower their continuation
/// through here so they scan the same tokens.
fn lower_scan_continuation_elements(
    alt_elements: &List<Element>,
    index: i32,
    ctx: &mut LowerContext,
) -> Option<List<ScanElement>> {
    let mut out: List<ScanElement> = [];
    for let mut k = index + 1; k < alt_elements.len(); k += 1 {
        let mut visiting: List<String> = [];
        if !ctx.analysis.is_element_scannable(&alt_elements[k], &mut visiting) {
            return null;
        }
        out.push(lower_alt_scan_element(alt_elements, k, ctx, false, false));
    }
    return Option::Some(out);
}

/// Lower one element of `alt_elements` at index `i` to a `ScanElement`,
/// then run the alt-level post-pass: if the result is a top-level
/// Repeat, rebind its `caller_follow_first` to
/// `first_of_elements_from(alt_elements, i + 1)`. Mirrors the parse-
/// side `RepeatOp` post-pass; used by every scan-only alt walker
/// (`lower_scan_body`, `lower_lr_alt_scan_suffix`, the single-alt
/// branch of `lower_scan_group`, `lower_general_scan_group`). Walks
/// that emit parse-side ops alongside scan elements (`lower_single_alt_group`,
/// `lower_general_group`) inline the post-pass so they can share
/// `basic_follow` with the parse-side rebind.
///
/// `reaches_rule_tail` and `enclosing_at_tail` are different questions and
/// must stay separate: the FOLLOW gate only needs the enclosing alt to be at
/// its tail, while the continuation scan ends by asking the caller and is sound
/// only where the walk really reaches the rule's tail. An LR atom alt and an
/// LR suffix both end at the loop, not at the rule, so they answer `false`.
fn lower_alt_scan_element(
    alt_elements: &List<Element>,
    i: i32,
    ctx: &mut LowerContext,
    reaches_rule_tail: bool,
    enclosing_at_tail: bool = true,
    rule_name: &String = &NO_ENCLOSING_RULE,
    outer_suffix: &List<Element> = &NO_OUTER_SUFFIX,
) -> ScanElement {
    let elem_follow = ctx.analysis.compute_call_site_follow(alt_elements, i);
    // Mirror the parse side: the per-position `FollowArg` and the tail
    // Repeat's `gate_caller_follow` flag keep the scan tournament in
    // lockstep with the gated parse body, so the scan side doesn't
    // over-count a tail iteration the caller's continuation claims.
    // Callers walk every position of one alt, so joining the suffix here only
    // where there is one keeps that walk from copying the alt per position.
    let [elem_follow_arg, continuation] = if outer_suffix.is_empty() {
        [
            compute_follow_arg(ctx, alt_elements, i),
            elements_from(alt_elements, i + 1),
        ];
    } else {
        let follow_elements = follow_elements_of(alt_elements, outer_suffix);
        [
            compute_follow_arg(ctx, &follow_elements, i),
            elements_from(&follow_elements, i + 1),
        ];
    };
    let elem_gate = compute_gate_caller_follow(ctx, alt_elements, i) && enclosing_at_tail;
    let elem_follow_exact = ctx.analysis.call_site_follow_is_exact(alt_elements, i);
    let mut se = lower_scan_element(
        &alt_elements[i],
        ctx,
        &elem_follow,
        elem_follow_arg,
        elem_gate,
        elem_follow_exact,
        &continuation,
    );
    if se matches { Repeat(_) | OptionalLookahead(_) } {
        let basic_follow = ctx.analysis.first_of_elements_from(alt_elements, i + 1);
        se = rebind_scan_repeat_caller_follow(se, basic_follow, alt_elements, i, ctx, reaches_rule_tail, rule_name);
    }
    return se;
}

/// True iff any element in the alt is an Optional Repeat (possibly
/// wrapped in a `Label`). Drives the scan-side OptionalLookahead
/// trigger via `surface_is_optional_repeat`.
fn has_nested_optional_in_alt(alt: &Alternative) -> bool {
    return alt.elements.iter_ref().any(|elem| surface_is_optional_repeat(elem));
}

/// True when any element of `alt` contains a variable-length repeat.
fn alt_has_variable_repeat(alt: &Alternative) -> bool {
    return alt.elements.iter_ref().any(|elem| surface_contains_variable_repeat(elem));
}

fn surface_is_optional_repeat(elem: &Element) -> bool {
    return match elem {
        Repeat(rep) => rep.kind matches { Optional },
        Label(lab) => surface_is_optional_repeat(&lab.element),
        Group(_) | TokenRef(_) | Literal(_) | RuleRef(_) | Wildcard(_) | Not(_) => false,
    };
}

/// True when `elem` contains a variable-length repeat (`Star` / `Plus`),
/// even nested in an optional or group. Shape-lookahead can't model these.
fn surface_contains_variable_repeat(elem: &Element) -> bool {
    return match elem {
        // A Star/Plus nested in an `Optional` (`( a (',' a)* )?`) defeats
        // shape enumeration too, so recurse through the optional's inner.
        Repeat(rep) => if rep.kind matches { Star | Plus } {
            true;
        } else {
            surface_contains_variable_repeat(&rep.element);
        },
        Group(g) => {
            let mut found = false;
            for let alt of &g.alternatives {
                for let inner of &alt.elements {
                    if surface_contains_variable_repeat(inner) {
                        found = true;
                        break;
                    }
                }
                if found {
                    break;
                }
            }
            found;
        },
        Label(lab) => surface_contains_variable_repeat(&lab.element),
        TokenRef(_) | Literal(_) | RuleRef(_) | Wildcard(_) | Not(_) => false,
    };
}

/// Lower an Optional Group with nested optionals to
/// `ScanElement::OptionalLookahead`. Enumerates 2^n shape
/// combinations (where n is the number of optional sub-elements),
/// computes per-shape lookahead signatures, and lowers each shape's
/// scan body separately (the optional sub-elements that are "on"
/// in this shape, unwrapped from their Optional Repeat wrappers,
/// plus the corresponding inner Group flattening when applicable).
fn lower_scan_optional_lookahead_group(
    alt: &Alternative,
    ctx: &mut LowerContext,
    as_repeat: ScanRepeatElement,
    enclosing_at_tail: bool,
    outer_suffix: &List<Element>,
) -> ScanElement {
    let shapes = compute_shapes_for_alt(&alt.elements);
    let mut sigs: List<List<List<i32>>> = [];
    let mut bodies: List<ScanBody> = [];
    for let shape of &shapes {
        // An all-optionals-off shape selects no element, so it has no
        // lookahead to gate on and no body to scan, so it is dropped here as
        // by the parse-side twin (`try_optional_shape_lookahead`); emit
        // asserts on a non-empty signature rather than skipping one silently.
        let sig = shape_lookahead_signature_for_alt(shape, &alt.elements, ctx);
        if sig.is_empty() {
            continue;
        }
        sigs.push(sig);
        bodies.push(lower_scan_shape_body(shape, alt, enclosing_at_tail, outer_suffix, ctx));
    }
    let scan_guarded = shape_signatures_collide(&sigs);
    return ScanElement::OptionalLookahead(ScanOptionalLookaheadElement {
        sigs: sigs,
        bodies: bodies,
        scan_guarded: scan_guarded,
        as_repeat: Option::Some(as_repeat),
    });
}

/// Lower a single shape's scan body. Mirrors surface
/// `gen_scan_optional_with_lookahead`'s per-shape inner loop: for
/// each selected position, unwrap the optional, and if the unwrapped
/// is a single-alt Group with no action or predicate, flatten its inner
/// elements into the scan body directly. Otherwise lower the unwrapped
/// element, which keeps a group's own gates.
///
/// The shape clears `alt`'s predicates as `alt_scan_body` does. One
/// placed before an element the shape leaves out runs before the next element
/// it keeps.
///
/// Each element continues into the rest of the shape and then `outer_suffix`,
/// as in a group body, so a call it makes hears the shape's own continuation:
/// `= expression` without its optional `else block` ends where the rule does.
fn lower_scan_shape_body(
    shape: &List<i32>,
    alt: &Alternative,
    enclosing_at_tail: bool,
    outer_suffix: &List<Element>,
    ctx: &mut LowerContext,
) -> ScanBody {
    let elements = &alt.elements;
    let mut shape_elements: List<Element> = [];
    let mut gates = scan_gates_for(alt, ctx);
    assert !gates.iter_ref().any(|g| g.step matches { Assign(_) }), "a write inside a group is never simulated";
    let mut placed = 0;
    for let mut k = 0; k < shape.len(); k += 1 {
        let idx = shape[k];
        while placed < gates.len() && gates[placed].before_index <= idx {
            gates[placed].before_index = shape_elements.len();
            placed += 1;
        }
        let actual = surface_unwrap_optional(&elements[idx]);
        if let Group(g) = actual && g.alternatives.len() == 1 && g.alternatives[0].actions.is_empty() {
            shape_elements.extend(&g.alternatives[0].elements);
        } else {
            shape_elements.push(*actual);
        }
    }
    while placed < gates.len() {
        gates[placed].before_index = shape_elements.len();
        placed += 1;
    }
    let mut body_elems: List<ScanElement> = [];
    for let mut i = 0; i < shape_elements.len(); i += 1 {
        body_elems.push(lower_alt_scan_element(
            &shape_elements,
            i,
            ctx,
            false,
            enclosing_at_tail,
            &NO_ENCLOSING_RULE,
            outer_suffix,
        ));
    }
    return ScanBody { elements: body_elems, gates, gate_cond: ctx.alt_scan_gate_conditions(alt) };
}

fn surface_unwrap_optional(elem: &Element) -> &Element {
    return match elem {
        Repeat(rep) => if rep.kind matches { Optional } { &rep.element } else { elem },
        Label(lab) => surface_unwrap_optional(&lab.element),
        Group(_) | TokenRef(_) | Literal(_) | RuleRef(_) | Wildcard(_) | Not(_) => elem,
    };
}

/// Enumerate 2^n shape combinations of optional sub-elements in an
/// alt. Mirrors `parser_gen::compute_shapes`: bit-mask from
/// `(2^n - 1)` down to 0; higher bits = more optionals included =
/// longer shape = tried first.
pub fn compute_shapes_for_alt(elements: &List<Element>) -> List<List<i32>> {
    let mut opt_indices: List<i32> = [];
    for let mut i = 0; i < elements.len(); i += 1 {
        if is_nullable(&elements[i]) {
            opt_indices.push(i);
        }
    }
    let n = opt_indices.len();
    let mut shapes: List<List<i32>> = [];
    let total = 1 << n;
    for let mut mask = total - 1; mask >= 0; mask -= 1 {
        let mut shape: List<i32> = [];
        for let mut i = 0; i < elements.len(); i += 1 {
            let mut is_opt = false;
            let mut opt_bit = -1;
            for let mut j = 0; j < opt_indices.len(); j += 1 {
                if opt_indices[j] == i {
                    is_opt = true;
                    opt_bit = j;
                }
            }
            if is_opt {
                if mask >> opt_bit & 1 == 1 {
                    shape.push(i);
                }
            } else {
                shape.push(i);
            }
        }
        shapes.push(shape);
    }
    return shapes;
}

/// Per-shape lookahead signature: for each element in the shape (in
/// the shape's selection order), compute the per-position first set.
/// Mirrors `parser_gen::shape_lookahead_signature`.
pub fn shape_lookahead_signature_for_alt(
    shape: &List<i32>,
    elements: &List<Element>,
    ctx: &mut LowerContext,
) -> List<List<i32>> {
    let mut sig: List<List<i32>> = [];
    for let mut si = 0; si < shape.len(); si += 1 {
        let actual = surface_unwrap_optional(&elements[shape[si]]);
        let [part, aligned] = shape_signature_positions(actual, ctx);
        for let position of &part {
            sig.push(*position);
        }
        if !aligned {
            return sig;
        }
    }
    return sig;
}

/// The per-position kind sets `elem` contributes, and whether the position
/// counter still lines up after it.
///
/// `sig[d]` guards `peek_at(d)`, so only a one-token element keeps the
/// alignment. A longer one contributes its position and stops the signature:
/// in `( '=' expr ('else' block)? )`, `peek_at(2)` would name whatever `expr`
/// left there, not `else`. A `.` admits any kind, which no kind set guards, so
/// it contributes nothing and stops the signature too.
fn shape_signature_positions(elem: &Element, ctx: &mut LowerContext) -> [List<List<i32>>, bool] {
    if let Group(g) = elem {
        if g.alternatives.len() == 1 {
            let mut out: List<List<i32>> = [];
            for let inner of &g.alternatives[0].elements {
                let [part, aligned] = shape_signature_positions(inner, ctx);
                for let position of &part {
                    out.push(*position);
                }
                if !aligned {
                    return [out, false];
                }
            }
            return [out, true];
        }
    }
    let mut visiting: List<String> = [];
    let first = ctx.analysis.first_of_element(elem, &mut visiting);
    if first.is_empty() {
        return [[], false];
    }
    let mut single_visiting: List<String> = [];
    let aligned = ctx.analysis.element_is_single_token(elem, &mut single_visiting);
    return [
        [first],
        aligned,
    ];
}

/// True when two signatures can both match one input: their kind sets overlap
/// at every shared position. A shorter one constrains nothing past its end, so
/// a prefix is compatible. Emit renders shapes as an `if … else if …` chain,
/// so a compatible pair can commit to a shape whose body does not match.
fn signatures_can_both_match(a: &List<List<i32>>, b: &List<List<i32>>) -> bool {
    let shared = if a.len() < b.len() { a.len() } else { b.len() };
    for let mut i = 0; i < shared; i += 1 {
        if !sets_overlap(&a[i], &b[i]) {
            return false;
        }
    }
    return true;
}

/// True when any two of `sigs` can match the same input.
fn shape_signatures_collide(sigs: &List<List<List<i32>>>) -> bool {
    for let mut i = 0; i < sigs.len(); i += 1 {
        for let mut j = i + 1; j < sigs.len(); j += 1 {
            if signatures_can_both_match(&sigs[i], &sigs[j]) {
                return true;
            }
        }
    }
    return false;
}

/// Build the `RuleHeader` shared by every `Rule` variant. The cached
/// snake/field names on `ParserRule` are reused so we don't recompute
/// `to_snake_case`. `case_names` is derived from the alternative list
/// with the same helper `parser_gen.wado` uses.
fn lower_header(rule: &ParserRule) -> RuleHeader {
    return RuleHeader {
        name: rule.name,
        snake_name: rule.snake_name,
        field_name: rule.field_name,
        type_name: rule.type_name,
        visibility: rule.visibility,
        case_names: case_names_for_rule(&rule.alternatives),
    };
}

/// Cumulative `general_group` counter starts per alternative.
/// Each alt records the running counter at its start, then
/// `count_general_groups(&alt.elements)` advances it for the next
/// alt. Consumed locally by `lower_lr_alt_suffix` and `lower_alt_body`
/// to seed each alt's local `group_counter` mutable; lower's
/// `lower_general_group` then assigns `GeneralShape.group_index` from
/// the bumped counter and emit reads `gs.group_index` directly off
/// the lowered IR.
fn compute_alt_gc_starts(alternatives: &List<Alternative>) -> List<i32> {
    let mut starts: List<i32> = [];
    let mut running: i32 = 0;
    for let alt of alternatives {
        starts.push(running);
        running += count_general_groups(&alt.elements);
    }
    return starts;
}

/// Lower one alternative body. For a single-alt rule the rule's own
/// struct is the alt's struct (`case_name` empty, `struct_name`
/// is the rule's CST type name). For a multi-alt rule the alt
/// gets a per-alt case + struct name derived from
/// `case_names_for_rule` and the convention `<RuleBase><CaseName>`
/// (`<RuleBase>` being `rule_type_name(rule.name)` with the trailing
/// `Node` stripped — same as `parser_gen::gen_alt_body` callers).
/// `case_names` (`case_names_for_rule`) and `alt_gc_starts`
/// (`compute_alt_gc_starts`) are per-rule and identical across every alt,
/// so the caller computes them once and threads them in rather than
/// re-deriving them on each alt.
fn lower_alt_body(
    alt: &Alternative,
    idx: i32,
    rule: &ParserRule,
    ctx: &mut LowerContext,
    case_names: &List<String>,
    alt_gc_starts: &List<i32>,
    reaches_rule_tail: bool,
) -> AltBody {
    let type_name = rule.type_name;
    let mut case_name: String = "";
    let mut struct_name: String = type_name;
    if rule.alternatives.len() != 1 {
        let base = type_name.strip_suffix("Node").unwrap();
        case_name = case_names[idx];
        struct_name = `${base}${case_names[idx]}`;
    }

    // The general-group counter is per-rule but its starting value
    // for this alt is fixed by `compute_alt_gc_starts`, so init from
    // there. Each general group encountered while lowering bumps it
    // by 1; the final value is consumed by `lower_general_group` to
    // assign `GeneralShape.group_index`, which emit reads directly
    // off the lowered IR.
    let mut group_counter: i32 = alt_gc_starts[idx];

    let mut name_counts: List<[String, i32]> = [];
    let mut ops: List<Op> = [];
    for let mut i = 0; i < alt.elements.len(); i += 1 {
        let elem = &alt.elements[i];
        let elem_follow = ctx.analysis.compute_call_site_follow(&alt.elements, i);
        // The runtime FOLLOW argument for a RuleRef at this
        // position, and whether a tail Repeat here gates on the caller's
        // continuation. Computed against the alt's surface elements,
        // which is the only place the suffix-nullability test has the
        // context it needs.
        let elem_follow_arg = compute_follow_arg(ctx, &alt.elements, i);
        let elem_gate = compute_gate_caller_follow(ctx, &alt.elements, i);
        let elem_follow_exact = ctx.analysis.call_site_follow_is_exact(&alt.elements, i);
        let mut op = lower_op(
            elem,
            &mut name_counts,
            &rule.name,
            ctx,
            &mut group_counter,
            &elem_follow,
            elem_follow_arg,
            elem_gate,
            elem_follow_exact,
            &elements_from(&alt.elements, i + 1),
        );
        // For Repeat ops, replace `caller_follow_first` with the basic
        // first set of the surrounding suffix. `compute_call_site_follow`
        // returns the deep follow (which considers deep-nullable
        // suffixes); emit's per-position `gen_repeat*` decisions use the
        // simpler `first_of_elements_from`.
        if let Some(rep_op) = op_repeat_inner(&op) {
            let basic_follow = ctx.analysis.first_of_elements_from(&alt.elements, i + 1);
            let basic_second = compute_caller_follow_second(&alt.elements, i + 1, ctx);
            let patched = Op::Repeat(patch_repeat_op_caller_follow(
                rep_op,
                basic_follow,
                basic_second,
                &alt.elements,
                i,
                ctx,
                reaches_rule_tail,
                &rule.name,
            ));
            op = rewrap_op_repeat(op, patched);
        }
        ops.push(op);
    }

    // For prefix LR alts (`'-' e` in `e : e '+' e | '-' e | …`), stamp
    // the trailing self-ref's `min_prec_arg` so emit reads it directly.
    // The shallow `find_self_ref_rule_call` is sufficient because
    // `is_prefix_alt` only accepts a direct (possibly labeled) self-ref
    // as the trailing element; if it ever broadens to containers,
    // mirror the depth-walking fallback in `stamp_lr_self_ref_min_prec`.
    let prefix_prec = compute_prefix_self_ref_min_prec(rule, idx);
    if prefix_prec > 0 && !ops.is_empty() {
        let last_idx = ops.len() - 1;
        if let Some(_) = find_self_ref_rule_call(&ops[last_idx], &rule.name) {
            ops[last_idx] = rebind_self_ref_min_prec(ops[last_idx], prefix_prec);
        }
    }

    let fields = enumerate_alt_field_decls(&ops);

    return AltBody {
        alt_index: idx,
        case_name,
        struct_name,
        ops,
        fields,
        prefix_self_ref_min_prec: prefix_prec,
    };
}

/// Lower a single surface `Element` to a GIR `Op`. `rule_name` is
/// the enclosing rule's name, threaded through so nested
/// `SingleAlt` / `General` groups can fill in their `owner_rule`
/// slot (the rule whose monomorph table the group's struct names
/// live under).
fn lower_op<S: AsStrSlice>(
    elem: &Element,
    name_counts: &mut List<[String, i32]>,
    rule_name: S,
    ctx: &mut LowerContext,
    group_counter: &mut i32,
    outer_follow: &List<i32>,
    follow_arg: FollowArg,
    gate_caller_follow: bool,
    follow_is_exact: bool = false,
    outer_suffix: &List<Element> = &NO_OUTER_SUFFIX,
) -> Op {
    return match *elem {
        TokenRef(_) | Literal(_) => lower_token_only_leaf(elem, name_counts, &mut ctx.analysis),
        RuleRef(r) => Op::RuleCall(RuleCallOp {
            target_name: r.name,
            target_snake: r.snake_name,
            follow_arg: follow_arg,
            min_prec_arg: null,
            field: dedup_name(&r.field_name, name_counts),
            dedup_base: r.field_name,
            atn_call_site: r.atn_call_site,
            arg_action: r.arg_action,
        }),
        Wildcard(_) => Op::Wildcard(WildcardOp {
            field: dedup_name("wildcard", name_counts),
            dedup_base: "wildcard",
        }),
        Not(ne) => {
            let base = not_element_field_name(&ne.element);
            Op::Excluded(ExcludedOp {
                kinds: collect_excluded_kinds(&ne.element, &mut ctx.analysis),
                field: dedup_name(&base, name_counts),
                dedup_base: base,
            });
        },
        Repeat(rep) => lower_repeat_op(
            &rep,
            name_counts,
            rule_name,
            ctx,
            group_counter,
            outer_follow,
            follow_arg,
            gate_caller_follow,
            follow_is_exact,
            outer_suffix,
        ),
        Group(g) => with_alt_actions(
            lower_group_op(
                &g,
                name_counts,
                rule_name,
                ctx,
                group_counter,
                outer_follow,
                follow_arg,
                follow_is_exact,
                gate_caller_follow,
                outer_suffix,
            ),
            &g,
        ),
        Label(lab) => lower_label_op(
            &lab,
            name_counts,
            rule_name,
            ctx,
            group_counter,
            outer_follow,
            follow_arg,
            gate_caller_follow,
            follow_is_exact,
            outer_suffix,
        ),
    };
}

/// Lower a `Group` element into the `GroupShape` `classify_group` names.
/// Inner ops share the surrounding alt's `name_counts` only for `Transparent`,
/// whose wrapping is purely syntactic; every storable shape gets its own scope.
/// `op`, lowered from `g`, with each alternative carrying the actions written
/// in it, for the op-only walker, which has no surface alternative to read
/// them from.
fn with_alt_actions(op: Op, g: &GroupElement) -> Op {
    let Group(mut go) = op else {
        unreachable();
    };
    for let alt of &mut go.alts {
        alt.actions = g.alternatives[alt.alt_index].actions;
    }
    return Op::Group(go);
}

fn lower_group_op<S: AsStrSlice>(
    g: &GroupElement,
    name_counts: &mut List<[String, i32]>,
    rule_name: S,
    ctx: &mut LowerContext,
    group_counter: &mut i32,
    outer_follow: &List<i32>,
    follow_arg: FollowArg,
    follow_is_exact: bool,
    enclosing_at_tail: bool = true,
    outer_suffix: &List<Element> = &NO_OUTER_SUFFIX,
) -> Op {
    let alts = &g.alternatives;
    match classify_group(alts) {
        Transparent => {
            return lower_transparent_group(
                &alts[0],
                name_counts,
                rule_name,
                ctx,
                group_counter,
                outer_follow,
                follow_arg,
                follow_is_exact,
                enclosing_at_tail,
                outer_suffix,
            );
        },
        SingleAlt => {
            return lower_single_alt_group(
                &alts[0],
                name_counts,
                rule_name,
                ctx,
                group_counter,
                enclosing_at_tail,
                outer_suffix,
            );
        },
        TokenOnly => {
            return lower_token_only_group(alts, name_counts, ctx);
        },
        SimpleCst => {
            let op = lower_simple_cst_group(alts, name_counts, ctx, outer_follow, follow_is_exact, outer_suffix);
            return with_group_atn_site(op, g, ctx);
        },
        General => {
            let op = lower_general_group(
                alts,
                name_counts,
                rule_name,
                ctx,
                group_counter,
                outer_follow,
                follow_is_exact,
                enclosing_at_tail,
                outer_suffix,
            );
            return with_group_atn_site(op, g, ctx);
        },
    }
}

fn with_group_atn_site(op: Op, g: &GroupElement, ctx: &mut LowerContext) -> Op {
    let Group(mut go) = op else {
        return op;
    };
    go.atn_site = group_atn_site(g, &go.scan_group.alt_classes, &go.empty_alt_admits, ctx);
    go.scan_group.atn_site = go.atn_site;
    go.tournament_shadowed = go.atn_site >= 0
        && ctx.settings.prediction.verifies()
        && !shares_empty_alt(&go.scan_group.alt_classes, &go.empty_alt_admits);
    return Op::Group(go);
}

/// Whether a branch of the group's decision holds its empty alternative beside
/// another, a choice only the simulator makes.
fn shares_empty_alt(classes: &List<AltClass>, admits: &Option<EmptyAltAdmits>) -> bool {
    let Some(e) = admits else {
        return false;
    };
    return decision_partition(classes).iter_ref().any(|b| b.alts.len() > 1 && b.alts.contains(&e.alt_index));
}

/// Single-element single-alt: `(e)` lowers to `e` with no struct of
/// its own. The binding nests in the surrounding alt's name table.
fn lower_transparent_group<S: AsStrSlice>(
    alt: &Alternative,
    name_counts: &mut List<[String, i32]>,
    rule_name: S,
    ctx: &mut LowerContext,
    group_counter: &mut i32,
    outer_follow: &List<i32>,
    follow_arg: FollowArg,
    follow_is_exact: bool,
    gate_caller_follow: bool,
    outer_suffix: &List<Element> = &NO_OUTER_SUFFIX,
) -> Op {
    // A Transparent group adds nothing between the inner and the outer alt, so
    // `outer_follow`, the position's FollowArg and gate, its exactness and the
    // enclosing suffix pass through verbatim.
    let inner = &alt.elements[0];
    let inner_op = lower_op(
        inner,
        name_counts,
        rule_name,
        ctx,
        group_counter,
        outer_follow,
        follow_arg,
        gate_caller_follow,
        follow_is_exact,
        outer_suffix,
    );
    let body = AltBody {
        alt_index: 0,
        case_name: "",
        struct_name: "",
        ops: [inner_op],
        fields: [],
        prefix_self_ref_min_prec: 0,
    };
    let walk = lower_scan_element(
        inner,
        ctx,
        outer_follow,
        follow_arg,
        gate_caller_follow,
        follow_is_exact,
        outer_suffix,
    );
    // `dispatch` is meaningless for a one-alt Transparent group:
    // emit recognises `GroupShape::Transparent` and skips the
    // dispatch step, running the body unconditionally. The empty
    // `Direct` placeholder is the cheapest valid `MultiAltDispatch`.
    let scan_body = alt_scan_body(alt, [walk], ctx);
    return Op::Group(GroupOp {
        shape: GroupShape::Transparent,
        alts: [body],
        scan_group: group_op_scan_group(&[scan_body], &[*alt], &null, ctx),
        dispatch: empty_direct_dispatch(),
        empty_alt_admits: null,
    });
}

/// One group alternative, parse ops and scan elements together, so both sides
/// read the same per-position `FollowArg` and stay in lockstep. `owner_rule`
/// names the monomorph table nested groups bake into; `rule_name` is the
/// enclosing rule, which the Repeat post-pass reports diagnostics under.
fn lower_group_alt<S: AsStrSlice, S1: AsStrSlice>(
    alt: &Alternative,
    name_counts: &mut List<[String, i32]>,
    owner_rule: S,
    rule_name: S1,
    ctx: &mut LowerContext,
    group_counter: &mut i32,
    enclosing_at_tail: bool,
    outer_suffix: &List<Element>,
) -> [List<Op>, List<ScanElement>] {
    // The continuation of a position inside the group runs off the end of the
    // group's alt into what follows it, so the FollowArg walk reads both.
    let follow_elements = follow_elements_of(&alt.elements, outer_suffix);
    let mut ops: List<Op> = [];
    let mut scan_elements: List<ScanElement> = [];
    for let mut i = 0; i < alt.elements.len(); i += 1 {
        let elem = &alt.elements[i];
        // Per-element follow inside the group: tokens that can appear
        // immediately after this element. For non-last positions, that's the
        // first-set of the suffix in the group's alt. The last position
        // inherits the surrounding alt's `outer_follow`.
        let elem_follow = ctx.analysis.compute_call_site_follow(&alt.elements, i);
        let elem_follow_arg = compute_follow_arg(ctx, &follow_elements, i);
        let elem_gate = compute_gate_caller_follow(ctx, &alt.elements, i) && enclosing_at_tail;
        let elem_follow_exact = ctx.analysis.call_site_follow_is_exact(&alt.elements, i);
        let inner_suffix = elements_from(&follow_elements, i + 1);
        let mut op = lower_op(
            elem,
            name_counts,
            owner_rule,
            ctx,
            group_counter,
            &elem_follow,
            elem_follow_arg,
            elem_gate,
            elem_follow_exact,
            &inner_suffix,
        );
        let mut se = lower_scan_element(
            elem,
            ctx,
            &elem_follow,
            elem_follow_arg,
            elem_gate,
            elem_follow_exact,
            &inner_suffix,
        );
        // Gate `basic_follow` on either side actually being a Repeat —
        // `first_of_elements_from` walks the suffix and isn't free.
        // Scalar `Label(Repeat(_))` collapses to `Op::Repeat` on the
        // parse side (so this fires); list `Label(Repeat(_))` lands as
        // `Op::ListLabel(Repeat(_))` on parse, but the scan side still
        // surfaces a top-level `ScanElement::Repeat` — so the scan
        // rebind needs an independent check, not an `&&` of the two.
        let op_is_repeat = op_repeat_inner(&op) matches { Some(_) };
        let se_is_repeat = se matches { Repeat(_) | OptionalLookahead(_) };
        if op_is_repeat || se_is_repeat {
            let basic_follow = ctx.analysis.first_of_elements_from(&alt.elements, i + 1);
            if let Some(rep_op) = op_repeat_inner(&op) {
                let basic_second = compute_caller_follow_second(&alt.elements, i + 1, ctx);
                let patched = Op::Repeat(patch_repeat_op_caller_follow(
                    rep_op,
                    basic_follow,
                    basic_second,
                    &alt.elements,
                    i,
                    ctx,
                    false,
                    rule_name,
                    outer_suffix,
                ));
                op = rewrap_op_repeat(op, patched);
            }
            if se_is_repeat {
                se = rebind_scan_repeat_caller_follow(
                    se,
                    basic_follow,
                    &alt.elements,
                    i,
                    ctx,
                    false,
                    &NO_ENCLOSING_RULE,
                    outer_suffix,
                );
            }
        }
        ops.push(op);
        scan_elements.push(se);
    }
    return [ops, scan_elements];
}

/// The `RepeatOp` an op is, through a list label — the parse side's answer to
/// the question the scan side asks as `se matches { Repeat(_) }`.
///
/// A scalar `Label(Repeat(_))` collapses to `Op::Repeat`, but a list one lands
/// as `Op::ListLabel(Repeat(_))` while the scan still surfaces a top-level
/// `ScanElement::Repeat`. Every site that rebinds a repeat's caller FOLLOW asks
/// through here, so `x+=(y*)` cannot take that rebind — and with it the reserve
/// guard — on the scan alone.
fn op_repeat_inner(op: &Op) -> Option<&RepeatOp> {
    return match op {
        Repeat(r) => Option::Some(r),
        ListLabel(l) => if let Repeat(r) = &l.inner {
            Option::Some(r);
        } else {
            null;
        },
        _ => null,
    };
}

/// Put a patched `RepeatOp` back under whatever wrapper `op` had.
fn rewrap_op_repeat(op: Op, patched: Op) -> Op {
    return match op {
        ListLabel(l) => Op::ListLabel(ListLabelOp { ..l, inner: patched }),
        _ => patched,
    };
}

/// Single-alt with ≥ 2 elements: `(name=ID '=' expr)` lowers to a
/// struct of its own (`NameIdEqualsExprItem`) bound under a single
/// field in the outer alt. The struct's element bindings live in a
/// fresh name scope — they don't pollute the outer alt's counts.
///
/// `owner_rule` records the surrounding rule's name so a nested `General`
/// group inside this body resolves its monomorph table key
/// (`<RuleName>Group<idx>`).
fn lower_single_alt_group<S: AsStrSlice>(
    alt: &Alternative,
    name_counts: &mut List<[String, i32]>,
    rule_name: S,
    ctx: &mut LowerContext,
    group_counter: &mut i32,
    enclosing_at_tail: bool = true,
    outer_suffix: &List<Element> = &NO_OUTER_SUFFIX,
) -> Op {
    // Nested elements are allowed: `(a (b c))` / `(a*)` /
    // `(name=a b)`. Each elem is lowered through the standard
    // `lower_op` recursion.

    let struct_name = single_alt_group_type_name(alt);
    let field = dedup_name(&single_alt_group_field_name(alt), name_counts);

    // Canonical owner for this single-alt struct: when the same body
    // appears in multiple rules CST emit deduplicates under the first
    // rule that defines it (see `build_single_alt_owner_map`). Lower
    // nested elements with the owner as `rule_name` so any inner
    // `lower_general_group` bakes type names (`<Owner>Group<idx>`)
    // that match the deduplicated CST types directly. Without this,
    // emit had to re-derive the names through `ctx.current_rule_name`.
    let owner_rule = ctx.analysis.general_group_rule_name(&struct_name, rule_name);

    // Inner ops use a fresh name table — bindings inside the
    // group's struct don't dedup against the outer alt.
    let mut inner_counts: List<[String, i32]> = [];
    let [ops, scan_elements] = lower_group_alt(
        alt,
        &mut inner_counts,
        &owner_rule,
        rule_name,
        ctx,
        group_counter,
        enclosing_at_tail,
        outer_suffix,
    );

    let body = AltBody {
        alt_index: 0,
        case_name: "",
        struct_name: struct_name,
        fields: enumerate_op_field_decls(&ops),
        ops: ops,
        prefix_self_ref_min_prec: 0,
    };
    let scan_body = alt_scan_body(alt, scan_elements, ctx);
    return Op::Group(GroupOp {
        shape: GroupShape::SingleAlt(SingleAltShape {
            struct_name: struct_name,
            field: field,
            owner_rule: owner_rule,
        }),
        alts: [body],
        scan_group: group_op_scan_group(&[scan_body], &[*alt], &null, ctx),
        dispatch: empty_direct_dispatch(),
        empty_alt_admits: null,
    });
}

fn empty_direct_dispatch() -> MultiAltDispatch {
    let branches: List<DispatchBranch> = [];
    return MultiAltDispatch::Direct(DirectDispatch { branches });
}

/// Multi-alt group whose every alt is a single Token / Literal —
/// `(K_INSERT | K_REPLACE)`. Lowers to `GroupShape::TokenOnly`,
/// which emit realises as a single `Token`-typed CST field. The
/// alt bodies are the matched leaf token; dispatch is direct on
/// each alt's single token kind (the alts are mutually exclusive
/// by construction — the classifier has already checked).
///
/// Field name is `token_group_field_name(alts)` (e.g.
/// `k_insert_or_k_replace`), deduped against the surrounding alt
/// scope. Inner ops carry no field name of their own — emit reads
/// the matched token off the runtime stack and writes it into the
/// outer `field` slot.
fn lower_token_only_group(alts: &List<Alternative>, name_counts: &mut List<[String, i32]>, ctx: &mut LowerContext) -> Op {
    let dedup_base = token_group_field_name(alts);
    let field = dedup_name(&dedup_base, name_counts);

    let mut bodies: List<AltBody> = [];
    let mut scan_bodies: List<ScanBody> = [];
    let mut first_sets: List<List<i32>> = [];
    let mut inner_counts: List<[String, i32]> = [];
    for let mut i = 0; i < alts.len(); i += 1 {
        let alt = &alts[i];
        assert !alt.elements.is_empty(), "a TokenOnly alt is one token, never empty";
        let elem = &alt.elements[0];
        let op = lower_token_only_leaf(elem, &mut inner_counts, &mut ctx.analysis);
        bodies.push(AltBody {
            alt_index: i,
            case_name: "",
            struct_name: "",
            ops: [op],
            fields: [],
            prefix_self_ref_min_prec: 0,
        });
        // Token-only alts are by construction leaves with no inner
        // Repeats — outer_follow is irrelevant, pass empty.
        let empty_follow: List<i32> = [];
        let token = lower_scan_element(elem, ctx, &empty_follow, FollowArg::NoFollow, false);
        scan_bodies.push(alt_scan_body(alt, [token], ctx));
        first_sets.push([ctx.analysis.terminal_kind(elem)]);
    }
    let dispatch = build_direct_dispatch(alts, &first_sets, ctx);
    return Op::Group(GroupOp {
        shape: GroupShape::TokenOnly(TokenOnlyShape { field, dedup_base }),
        alts: bodies,
        scan_group: group_op_scan_group(&scan_bodies, alts, &null, ctx),
        dispatch: dispatch,
        empty_alt_admits: null,
    });
}

fn lower_token_only_leaf(elem: &Element, counts: &mut List<[String, i32]>, analysis: &mut GrammarAnalysis) -> Op {
    let kind = analysis.terminal_kind(elem);
    return match *elem {
        TokenRef(t) => Op::Token(TokenOp {
            kind,
            field: dedup_name(&t.field_name, counts),
            dedup_base: t.field_name,
            atn_leaf_site: t.atn_leaf_site,
        }),
        Literal(l) => {
            let base = literal_field_name(&l.text);
            Op::Literal(LiteralOp {
                kind,
                field: dedup_name(&base, counts),
                dedup_base: base,
                atn_leaf_site: l.atn_leaf_site,
            });
        },
        _ => panic("lower_token_only_leaf: classifier permitted non-token leaf"),
    };
}

/// Multi-alt group whose every alt is a single distinct `RuleRef` —
/// `(stmt | expr | decl)`. One shared variant type, one field, one `RuleCall`
/// per alt.
fn lower_simple_cst_group(
    alts: &List<Alternative>,
    name_counts: &mut List<[String, i32]>,
    ctx: &mut LowerContext,
    outer_follow: &List<i32>,
    follow_is_exact: bool,
    outer_suffix: &List<Element>,
) -> Op {
    let type_name = group_variant_type_name(alts);
    let field = dedup_name(&group_field_base_name(alts), name_counts);

    let mut bodies: List<AltBody> = [];
    let mut scan_bodies: List<ScanBody> = [];
    let mut inner_counts: List<[String, i32]> = [];
    for let mut i = 0; i < alts.len(); i += 1 {
        let alt = &alts[i];
        let follow_arg = simple_cst_alt_follow_arg(ctx, alt, outer_suffix);
        let op = lower_simple_cst_alt_call(&alt.elements[0], follow_arg, &mut inner_counts);
        bodies.push(AltBody {
            alt_index: i,
            case_name: group_case_name(alt),
            struct_name: "",
            ops: [op],
            fields: [],
            prefix_self_ref_min_prec: 0,
        });
        let call = lower_scan_element(&alt.elements[0], ctx, &SIMPLE_CST_UNREAD_FOLLOW, follow_arg, false);
        scan_bodies.push(alt_scan_body(alt, [call], ctx));
    }
    let owner = DiagnosticOwner {
        rule: ctx.current_rule_name(),
        site: DiagnosticSite::SimpleCstGroup,
    };
    return group_op(
        GroupShape::SimpleCst(SimpleCstShape { type_name: type_name, field: field }),
        &owner,
        alts,
        bodies,
        &scan_bodies,
        outer_follow,
        follow_is_exact,
        ctx,
    );
}

/// A SimpleCst alt is one bare `RuleRef`, reaching none of the arms that read
/// `lower_scan_element`'s per-position follow — so both paths pass one value.
global SIMPLE_CST_UNREAD_FOLLOW: List<i32> = [];

fn lower_simple_cst_scan_group(
    alts: &List<Alternative>,
    ctx: &mut LowerContext,
    outer_follow: &List<i32>,
    follow_is_exact: bool,
    outer_suffix: &List<Element>,
) -> ScanElement {
    let mut bodies: List<ScanBody> = [];
    for let alt of alts {
        let follow_arg = simple_cst_alt_follow_arg(ctx, alt, outer_suffix);
        let call = lower_scan_element(&alt.elements[0], ctx, &SIMPLE_CST_UNREAD_FOLLOW, follow_arg, false);
        bodies.push(alt_scan_body(alt, [call], ctx));
    }
    return scan_group_element(bodies, alts, outer_follow, follow_is_exact, ctx);
}

/// What a SimpleCst alternative's one call continues into: what follows the
/// group, as a General group's tail call is told.
fn simple_cst_alt_follow_arg(ctx: &mut LowerContext, alt: &Alternative, outer_suffix: &List<Element>) -> FollowArg {
    assert alt.elements.len() == 1, "a SimpleCst alt is one RuleRef";
    return compute_follow_arg(ctx, &follow_elements_of(&alt.elements, outer_suffix), 0);
}

fn lower_simple_cst_alt_call(elem: &Element, follow_arg: FollowArg, counts: &mut List<[String, i32]>) -> Op {
    if let RuleRef(r) = *elem {
        return Op::RuleCall(RuleCallOp {
            target_name: r.name,
            target_snake: r.snake_name,
            follow_arg: follow_arg,
            min_prec_arg: null,
            field: dedup_name(&r.field_name, counts),
            dedup_base: r.field_name,
            atn_call_site: r.atn_call_site,
        });
    }
    panic("lower_simple_cst_alt_call: classifier permitted non-RuleRef leaf");
}

/// An alternative that can match nothing, so what follows the group selects it
/// — `alt_class`'s answer, never a nullability walk of this site's own. One
/// with a gateable alt-initial predicate is selected by the predicate instead,
/// and keeps the unconditional branch the gate hangs on.
fn alt_earns_group_follow(alt: &Alternative, class: &AltClass, ctx: &mut LowerContext) -> bool {
    return !ctx.alt_has_gate(alt) && alt_class_is_nullable(class);
}

/// The admit set of a group's nullable alternative — `outer_follow`, what
/// selects it — or `null` where there is none to write.
pub fn group_empty_alt_admits(
    alts: &List<Alternative>,
    outer_follow: &List<i32>,
    follow_is_exact: bool,
    ctx: &mut LowerContext,
) -> Option<EmptyAltAdmits> {
    // An inexact follow set is no answer: written in as the whole set it makes
    // the dispatch reject every lookahead the caller could still supply.
    if !follow_is_exact || outer_follow.is_empty() {
        return null;
    }
    let classes = alt_classes_of(alts, &mut ctx.analysis);
    for let mut i = 0; i < alts.len(); i += 1 {
        if alt_earns_group_follow(&alts[i], &classes[i], ctx) {
            return Option::Some(EmptyAltAdmits { alt_index: i, admits: *outer_follow });
        }
    }
    return null;
}

/// What a group's alternatives match: the classification, with the group's
/// follow set resolving the one that matches empty.
pub fn group_alt_classes(
    alts: &List<Alternative>,
    empty_alt_admits: &Option<EmptyAltAdmits>,
    analysis: &mut GrammarAnalysis,
) -> List<AltClass> {
    let mut classes = alt_classes_of(alts, analysis);
    apply_empty_alt_admits(&mut classes, empty_alt_admits);
    return classes;
}

/// Union the group's follow set into the nullable alternative's class — it
/// joins that alternative's own first set rather than replacing it: `( A? | B ) C`
/// is selected by `a` and by `c` alike.
fn apply_empty_alt_admits(classes: &mut List<AltClass>, admits: &Option<EmptyAltAdmits>) {
    let e = if let Some(x) = admits {
        x;
    } else {
        return;
    };
    assert !e.admits.is_empty(), "an admit set that admits nothing is `null`, not an empty set";
    assert alt_class_is_nullable(&classes[e.alt_index]), "only a nullable alternative earns the group's follow set";
    let mut admitted = alt_class_first_set(&classes[e.alt_index]);
    dedup_append_arr(&mut admitted, &e.admits);
    classes[e.alt_index] = AltClass::Selects(admitted);
}

/// Multi-alt group not covered by `SimpleCst` / `TokenOnly` /
/// `SingleAlt` — `(stmt | 'go' expr)`. Lowers to
/// `GroupShape::General` carrying:
///
/// * `variant_type = <RuleName>Group<idx>` — the per-rule variant
///   type that stores one of the alts.
/// * `alt_struct_names[j] = <RuleName>Group<idx>Alt<j>` — the
///   per-alt struct name (always allocated, even when an alt is a
///   single op, so emit can drop a uniform `<Variant>::Alt<j>(...)`
///   constructor).
/// * `field = group_<idx>` — deduped against the surrounding alt.
/// * `group_index = <idx>` — the per-rule cumulative counter; emit
///   uses this id to look up monomorph table entries and to
///   resolve the cross-pass general-group enumeration.
///
/// Per-alt elements use a fresh name table — the inner ops bind
/// names inside the group's struct, not the outer alt. The shared
/// `group_counter` is bumped before lowering inner alts so any
/// nested general groups get the next sequential ids.
fn lower_general_group<S: AsStrSlice>(
    alts: &List<Alternative>,
    name_counts: &mut List<[String, i32]>,
    rule_name: S,
    ctx: &mut LowerContext,
    group_counter: &mut i32,
    outer_follow: &List<i32>,
    follow_is_exact: bool,
    enclosing_at_tail: bool = true,
    outer_suffix: &List<Element> = &NO_OUTER_SUFFIX,
) -> Op {
    let group_index = *group_counter;
    *group_counter += 1;

    let variant_type = general_group_type_name(rule_name, group_index);
    let field = dedup_name(&general_group_field_name(group_index), name_counts);

    let mut bodies: List<AltBody> = [];
    let mut scan_bodies: List<ScanBody> = [];
    let mut alt_struct_names: List<String> = [];
    for let mut i = 0; i < alts.len(); i += 1 {
        let alt = &alts[i];
        let alt_struct = general_group_alt_struct_name(rule_name, group_index, i);
        alt_struct_names.push(alt_struct);

        // Inner alts get a fresh name table (the group struct is
        // its own scope) but share the outer rule's
        // `group_counter` — nested general groups inside this
        // alt take the next sequential ids.
        let mut inner_counts: List<[String, i32]> = [];
        let [ops, scan_elements] = lower_group_alt(
            alt,
            &mut inner_counts,
            rule_name,
            rule_name,
            ctx,
            group_counter,
            enclosing_at_tail,
            outer_suffix,
        );

        bodies.push(AltBody {
            alt_index: i,
            case_name: `Alt${i}`,
            struct_name: alt_struct,
            fields: enumerate_op_field_decls(&ops),
            ops: ops,
            prefix_self_ref_min_prec: 0,
        });
        scan_bodies.push(alt_scan_body(alt, scan_elements, ctx));
    }
    let owner = DiagnosticOwner {
        rule: rule_name.to_string(),
        site: DiagnosticSite::GeneralGroup(group_index),
    };
    return group_op(
        GroupShape::General(GeneralShape {
            variant_type: variant_type,
            alt_struct_names: alt_struct_names,
            field: field,
            group_index: group_index,
        }),
        &owner,
        alts,
        bodies,
        &scan_bodies,
        outer_follow,
        follow_is_exact,
        ctx,
    );
}

/// Outer struct field name for the alt that contains a Repeat. For
/// `Star` / `Plus` it's `<inner_base>_list` (the struct holds a
/// `List<...>`); for `Optional` it's the inner base name (an
/// `Option<...>`). Deduped against the surrounding alt's name table.
///
/// Special case `(name+=expr)*`: when the inner is a list-label (`+=`,
/// detected by `repeat_inner_is_list_label`) the label name IS the
/// list, with no `_list` suffix.
fn compute_repeat_outer_field(rep: &RepeatElement, name_counts: &mut List<[String, i32]>, group_counter: i32) -> String {
    if repeat_inner_is_list_label(&rep.element) {
        if let Label(lab) = rep.element {
            return dedup_name(&lab.field_name, name_counts);
        }
        panic("repeat_inner_is_list_label returned true for non-Label");
    }
    let outer_base = repeat_outer_base_name(&rep.element, rep.kind, group_counter);
    return dedup_name(&outer_base, name_counts);
}

/// Lower a `Repeat` element (`e?` / `e*` / `e+`). The strategy (`Plain` vs.
/// the specialised Optional shapes) is chosen inline below.
///
/// The inner Op uses a fresh `name_counts`: a binding name inside a
/// loop body is local to that iteration and does not dedup against the
/// surrounding alt's bindings.
fn lower_repeat_op<S: AsStrSlice>(
    rep: &RepeatElement,
    name_counts: &mut List<[String, i32]>,
    rule_name: S,
    ctx: &mut LowerContext,
    group_counter: &mut i32,
    outer_follow: &List<i32>,
    follow_arg: FollowArg,
    gate_caller_follow: bool,
    follow_is_exact: bool,
    outer_suffix: &List<Element> = &NO_OUTER_SUFFIX,
) -> Op {
    let inner_suffix = repeat_body_suffix(rep, outer_suffix);
    let inner_follow_arg = repeat_body_follow(ctx, rep, follow_arg, &inner_suffix);
    let outer_field = compute_repeat_outer_field(rep, name_counts, *group_counter);
    // Every shape decision below reads the body the op was lowered from, not
    // the label wrapping it — a label changes a repeat's typing, never its
    // shape. Positional reads (`first_of_element`, scannability) take either.
    let body_elem = peel_labels(&rep.element);

    // Pre-compute the inner's first set; used both by the strategy
    // decision (mask subtraction / suppression) and by the
    // iter-follow propagation for nested constructs.
    let mut inner_visiting: List<String> = [];
    let inner_first = ctx.analysis.first_of_element(&rep.element, &mut inner_visiting);

    // Optional `?` has three specialised strategies that supersede
    // the mask-aware decision when applicable:
    //
    // * `OptionalLookahead` — inner is a single-alt Group whose
    //   leading elements are fixed tokens (`TokenRef` / `Literal`).
    //   Bare leaf Optionals (`TokenRef?` / `Literal?`) stay at
    //   `Plain` and are handled by emit's Optional+leaf arm.
    // * `OptionalShapeLookahead` — inner is a single-alt Group with
    //   nested Optionals; emit enumerates 2^n shapes (longest-first).
    // * `OptionalScanGuard` — any other Optional shape where the
    //   inner is fully scannable; emit runs the scan helper as a
    //   commit gate.
    //
    // `pick_optional_specialised` resolves which one fires using the
    // `body_has_field` storability flag to match emit's storable /
    // transparent dispatch order. When none fires the strategy is
    // `Plain` and the tail-position caller-FOLLOW repair is threaded
    // at runtime via `gate_caller_follow`.
    let body_has_field = element_has_field(&rep.element);
    let mut opt_specialised: Option<RepeatStrategy> = null;
    if !rep.non_greedy {
        if let Optional = rep.kind {
            let owner = DiagnosticOwner {
                rule: rule_name.to_string(),
                site: DiagnosticSite::Optional(outer_field),
            };
            opt_specialised = pick_optional_specialised(
                body_elem,
                body_has_field,
                &owner,
                gate_caller_follow,
                &inner_suffix,
                ctx,
            );
        }
    }

    let strategy = if rep.non_greedy {
        // `??` shares the `Option<T>` emit shape of greedy `?`; the
        // prefer-skip decision is taken at runtime by the ATN simulator,
        // so it never uses a specialised static Optional strategy. `*?` /
        // `+?` keep the dedicated non-greedy strategy.
        if let Optional = rep.kind {
            // Always `Plain` — the specialised Optional strategies are
            // greedy-only (`opt_specialised` is computed only under
            // `!non_greedy`).
            ctx.mark_asks_simulator("a non-greedy `??`");
            RepeatStrategy::Plain;
        } else {
            compute_non_greedy_strategy(body_elem, outer_follow, ctx);
        }
    } else {
        // Greedy: a specialised Optional strategy when one fires,
        // otherwise `Plain`.
        pick_greedy_strategy(opt_specialised);
    };

    // The inner body's `outer_follow` for nested constructs is the
    // iter-follow of this repeat: `first(inner) ∪ outer_follow`,
    // because after the inner finishes the loop either restarts
    // (consuming a `first(inner)` token) or exits (the surrounding
    // `outer_follow`). Today this propagation is only consumed by
    // nested non-greedy Repeats.
    let iter_follow = union_kind_arrays(&inner_first, outer_follow);

    let mut inner_counts: List<[String, i32]> = [];
    // `(name+=elem)*` / `name+=elem+` / `name+=elem?`: the Repeat
    // supplies the `List<>` typing via its `field`; bypass
    // `lower_label_op`'s `Op::ListLabel` wrapper and lower the inner
    // directly. Seed `inner_counts` with `outer_field` so the inner's
    // `dedup_name` forks the name when it would collide with the
    // container — keeps `let <natural>` for the common case while
    // guaranteeing `<inner>.push(<natural>)` never self-shadows. The
    // non-Repeat counterpart is handled emit-side in
    // `gen_op_list_label` (lower's `name_counts` can't track it there
    // without desyncing the visitor's parallel naming pipeline).
    let body = if repeat_inner_is_list_label(&rep.element) {
        if let Label(lab) = &rep.element {
            let _ = dedup_name(&outer_field, &mut inner_counts);
            lower_op(
                &lab.element,
                &mut inner_counts,
                rule_name,
                ctx,
                group_counter,
                &iter_follow,
                inner_follow_arg,
                gate_caller_follow,
                false,
                &inner_suffix,
            );
        } else {
            panic("repeat_inner_is_list_label returned true for non-Label");
        }
    } else {
        lower_op(
            &rep.element,
            &mut inner_counts,
            rule_name,
            ctx,
            group_counter,
            &iter_follow,
            inner_follow_arg,
            gate_caller_follow,
            false,
            &inner_suffix,
        );
    };
    let mut body_visiting: List<String> = [];
    let body_scannable = ctx.analysis.is_element_scannable(&rep.element, &mut body_visiting);
    // Scan-side mirror of `body`. Computed here so emit's scan-guard
    // helpers (`gen_rep_scan_guard` / `gen_scan_guard_with_prefix`)
    // can scan the inner element via the op-driven scan walker
    // (`gen_scan_op_element`) without falling back to the surface
    // `gen_scan_*` walker graph. Uses the same `iter_follow` as the
    // parse side so per-position context (`caller_follow_first`
    // baked on nested `ScanRepeatElement`s) lines up.
    let lowered_scan_body = lower_scan_element(
        &rep.element,
        ctx,
        &iter_follow,
        inner_follow_arg,
        gate_caller_follow,
        false,
        &inner_suffix,
    );
    let scan_body = strict_repeat_body(lowered_scan_body, &rep.element, ctx);
    let body_is_single_alt_group = if let Group(g) = body_elem {
        g.alternatives.len() == 1;
    } else {
        false;
    };
    let body_second_position_first = compute_body_second_position_first(&rep.element, ctx);
    let body_shape = classify_repeat_body_shape(&body);
    let effective_gate = gate_caller_follow && !rep.non_greedy;
    if effective_gate {
        ctx.mark_caller_follow_gate();
        ctx.mark_rule_reads_follow();
    }
    return Op::Repeat(RepeatOp {
        kind: rep.kind,
        non_greedy: rep.non_greedy,
        body,
        scan_body,
        strategy: strategy,
        field: outer_field,
        caller_follow_first: *outer_follow,
        caller_follow_second: [],
        body_scannable,
        body_has_field,
        body_admits: repeat_body_admits(rep, &inner_first, outer_follow, follow_is_exact, ctx),
        body_is_single_alt_group,
        body_second_position_first,
        body_shape,
        gate_caller_follow: effective_gate,
        atn_decision: rep.atn_decision,
    });
}

/// Inner second-position first set for the non-greedy 2-token
/// disambiguation `non_greedy_static_cond` emits: when the inner is a single-alt `Group` of ≥ 2 elements,
/// returns `first_of_elements_from(&elements, 1)`; otherwise `[]`.
fn compute_body_second_position_first(elem: &Element, ctx: &mut LowerContext) -> List<i32> {
    if let Group(g) = peel_labels(elem) {
        if g.alternatives.len() == 1 && g.alternatives[0].elements.len() >= 2 {
            return ctx.analysis.first_of_elements_from(&g.alternatives[0].elements, 1);
        }
    }
    return [];
}

/// Classify the body op into its `RepeatBodyShape`. The four cases
/// cover every shape `lower_op` produces for a Repeat's inner; lower
/// asserts on anything else so emit's exhaustive dispatch can drop
/// the "did not cover this body shape" panics.
///
/// Mirrors emit's pre-shape checks (`is RuleCall(_)`, `op_is_leaf`,
/// `let Group(g_op) = body && body_has_field`).
fn classify_repeat_body_shape(body: &Op) -> RepeatBodyShape {
    return match body {
        RuleCall(_) => RepeatBodyShape::LeafRuleCall,
        Token(_) | Literal(_) | Wildcard(_) | Excluded(_) => RepeatBodyShape::LeafOther,
        Group(g_op) => match &g_op.shape {
            Transparent => RepeatBodyShape::TransparentGroup,
            SingleAlt(_) | TokenOnly(_) | SimpleCst(_) | General(_) => RepeatBodyShape::StorableGroup,
        },
        // Lower never produces these as a Repeat body: ListLabel is
        // unwrapped by `lower_repeat_op`'s `repeat_inner_is_list_label`
        // arm before `lower_op` builds the Op, and a directly nested
        // Repeat body has no surface-grammar equivalent (`(a*)*`
        // collapses through the surface Group).
        ListLabel(_) | Repeat(_) => panic(
            "classify_repeat_body_shape: ListLabel / Repeat reached as a Repeat body — lower-side bug",
        ),
    };
}

/// Caller-side second-token set for a non-greedy Repeat at position
/// `start - 1` in the surrounding alt. Returns the first set of the
/// second sub-position when the next element (at `start`) is itself a
/// Repeat over a single-alt Group of ≥ 2 elements (the common
/// `(',' x)*?` followed by `(',' y)*` disambiguation pattern). Returns
/// `[]` otherwise — emit's `non_greedy_static_cond` mirror
/// already handles the empty case.
fn compute_caller_follow_second(elements: &List<Element>, start: i32, ctx: &mut LowerContext) -> List<i32> {
    if start >= elements.len() {
        return [];
    }
    let follow_elem = &elements[start];
    if let Repeat(rep) = follow_elem {
        return compute_body_second_position_first(&rep.element, ctx);
    }
    return [];
}

/// True iff the surface `Element` contributes a CST field. Baked into
/// `RepeatOp.body_has_field` so emit never asks the surface IR.
fn element_has_field(elem: &Element) -> bool {
    return match elem {
        TokenRef(_) | Literal(_) | RuleRef(_) | Wildcard(_) | Not(_) => true,
        Label(lab) => element_has_field(&lab.element),
        Group(g) => is_storable_group(&g.alternatives),
        Repeat(_) => false,
    };
}

/// Pick the specialised `Optional` strategy lower bakes into a Repeat's
/// `RepeatOp.strategy`. The dispatch order depends on whether the inner
/// will be wrapped in a CST struct (storable) or inlined (transparent):
///
/// * Storable (`body_has_field == true`): a single k-token check is
///   preferred when applicable because the outer struct only needs
///   one entry point; falls back to shape-disjunction when the inner
///   has nested optionals, then to scan-guard.
/// * Transparent (`body_has_field == false`): shape-disjunction is
///   preferred because each shape inlines different elements
///   directly; falls back to k-token, then scan-guard.
///
/// Returns `null` when none apply; the caller falls through to
/// `Plain`. This function is the single source of truth for the
/// Optional+Group dispatch decision — emit consumes the resulting
/// strategy variant directly via `gen_op_repeat_optional_group`.
///
/// Reaching the scan guard is the advisory case: neither lookahead mode
/// decided the optional, so emit speculatively scans the body on every visit.
/// `owner` names the optional so the warning points at a binding the author
/// can find.
fn pick_optional_specialised(
    inner: &Element,
    body_has_field: bool,
    owner: &DiagnosticOwner,
    enclosing_at_tail: bool,
    outer_suffix: &List<Element>,
    ctx: &mut LowerContext,
) -> Option<RepeatStrategy> {
    let k_token = try_optional_k_token_lookahead(inner, ctx);
    let shape = try_optional_shape_lookahead(inner, enclosing_at_tail, outer_suffix, ctx);
    let scan_guard = try_optional_scan_guard(inner, ctx);
    if body_has_field {
        if let Some(s) = k_token {
            return Option::Some(s);
        }
        if let Some(s) = shape {
            return Option::Some(s);
        }
    } else {
        if let Some(s) = shape {
            return Option::Some(s);
        }
        if let Some(s) = k_token {
            return Option::Some(s);
        }
    }
    if let Some(s) = scan_guard {
        warn_optional_scan_guard(owner, ctx);
        return Option::Some(s);
    }
    return null;
}

fn warn_optional_scan_guard(owner: &DiagnosticOwner, ctx: &mut LowerContext) {
    ctx.diagnostics.warn(
        owner,
        DiagnosticKind::OptionalScanGuardFallback,
        "no fixed-token lookahead decides this optional; entry is gated by speculatively scanning the body on every visit",
    );
}

/// Try to materialise an `OptionalLookahead` strategy (k-token mode).
/// Fires when the inner is a single-alt Group with a non-empty
/// leading run of fixed tokens (`TokenRef` / `Literal`); returns
/// `null` for non-Group inners. Bare leaf Optionals stay at
/// `Plain` — the Optional+leaf arm of
/// `gen_op_repeat_with_follow_override` emits the single-token
/// guard directly from `body_admits`, so the specialisation is
/// unnecessary there.
fn try_optional_k_token_lookahead(inner: &Element, ctx: &mut LowerContext) -> Option<RepeatStrategy> {
    let sig = collect_optional_entry_signature(inner, ctx);
    if sig.is_empty() {
        return null;
    }
    return Option::Some(RepeatStrategy::OptionalLookahead(
        OptionalLookaheadStrategy { sig: sig },
    ));
}

/// The per-position kind sets deciding whether to enter an Optional's
/// single-alt Group inner. Each leading fixed token (`TokenRef` /
/// `Literal`) contributes its own kind; the element that ends that run
/// contributes its whole first set, and the walk stops there because a
/// multi-token element leaves the next position naming whatever it ended
/// with (the alignment rule `shape_signature_positions` follows).
///
/// That last position is what separates the body from a caller that opens
/// on the same token: in `seg : ID (SEP args)?` inside
/// `path : seg (SEP seg)*`, SEP alone commits to the optional and strands
/// `a::b`, while FIRST(args) decides it. The walk stops before a nullable
/// element instead, whose position may not be there to peek at.
///
/// Returns `[]` for non-Group inners and for a group with no leading
/// fixed token — leaf Optionals (`TokenRef?` / `Literal?`) are handled by
/// `gen_op_repeat_with_follow_override`'s Optional+leaf arm using
/// `inner_first` directly, so we keep their strategy at `Plain`.
fn collect_optional_entry_signature(inner: &Element, ctx: &mut LowerContext) -> List<List<i32>> {
    let mut sig: List<List<i32>> = [];
    if let Group(g) = inner {
        if g.alternatives.len() != 1 {
            return sig;
        }
        for let elem of &g.alternatives[0].elements {
            if elem matches { TokenRef(_) | Literal(_) } {
                sig.push([ctx.analysis.terminal_kind(elem)]);
            } else {
                // Deep: a `RuleRef` to a rule deriving epsilon matches nothing,
                // so the position this would name may hold what follows it.
                let mut null_visiting: List<String> = [];
                if sig.is_empty() || ctx.analysis.element_is_nullable_deep(elem, &mut null_visiting) {
                    break;
                }
                let mut visiting: List<String> = [];
                let first = ctx.analysis.first_of_element(elem, &mut visiting);
                if !first.is_empty() {
                    sig.push(first);
                }
                break;
            }
        }
    }
    return sig;
}

/// Maximum number of nullable sub-elements for which shape enumeration
/// (2^n) is worthwhile. Beyond this, both the parse-side
/// (`try_optional_shape_lookahead`) and scan-side (`lower_scan_repeat`)
/// shape paths fall back to the non-enumerating strategy (8 → at most
/// 256 shapes). They must agree, so both consult the shared predicate.
global MAX_SHAPE_OPTIONALS: i32 = 8;

/// True when the alt has more nullable (shape-contributing) elements than
/// `MAX_SHAPE_OPTIONALS`, so the 2^n shape enumeration must be skipped.
/// Shared by the parse-side and scan-side shape gates to keep them in
/// lockstep.
fn shape_optional_count_exceeds_cap(elements: &List<Element>) -> bool {
    let mut nullable_count = 0;
    for let elem of elements {
        if is_nullable(elem) {
            nullable_count += 1;
        }
    }
    return nullable_count > MAX_SHAPE_OPTIONALS;
}

/// Try to materialise an `OptionalShapeLookahead` strategy. Fires
/// when the inner is a single-alt Group with at least one nested
/// Optional Repeat — emit enumerates 2^n shapes (longest-first) and
/// guards each on the per-position kind set computed from
/// `ctx.first_of_element`. Returns `null` for other inner shapes or when
/// there are more than `MAX_SHAPE_OPTIONALS` nullable sub-elements.
fn try_optional_shape_lookahead(
    inner: &Element,
    enclosing_at_tail: bool,
    outer_suffix: &List<Element>,
    ctx: &mut LowerContext,
) -> Option<RepeatStrategy> {
    if let Group(g) = inner {
        if g.alternatives.len() != 1 {
            return null;
        }
        let elements = &g.alternatives[0].elements;
        // A variable-length repeat breaks fixed shape enumeration (two
        // shapes collapse to one signature), so fall back to the scan
        // guard. `( arm (',' arm)* ','? )` is the canonical case.
        for let elem of elements {
            if surface_contains_variable_repeat(elem) {
                return null;
            }
        }
        let mut has_nested = false;
        for let elem of elements {
            if surface_is_optional_repeat(elem) {
                has_nested = true;
                break;
            }
        }
        if !has_nested {
            return null;
        }
        // Shape enumeration is 2^n; cap it so a pathological alt with many
        // independent optionals neither blows up compile time nor overflows
        // `1 << n` (i32). Past the cap, fall back to the scan-guard strategy.
        if shape_optional_count_exceeds_cap(elements) {
            return null;
        }
        let shapes = compute_shapes_for_alt(elements);
        let mut shape_entries: List<OptionalLookaheadShape> = [];
        let mut signatures: List<List<List<i32>>> = [];
        for let shape of &shapes {
            let sig = shape_lookahead_signature_for_alt(shape, elements, ctx);
            if sig.is_empty() {
                continue;
            }
            signatures.push(sig);
            shape_entries.push(OptionalLookaheadShape {
                positions: *shape,
                sig: sig,
                scan_body: lower_scan_shape_body(shape, &g.alternatives[0], enclosing_at_tail, outer_suffix, ctx),
            });
        }
        if shape_entries.is_empty() {
            return null;
        }
        return Option::Some(RepeatStrategy::OptionalShapeLookahead(
            OptionalShapeLookaheadStrategy {
                shapes: shape_entries,
                scan_guarded: shape_signatures_collide(&signatures),
            },
        ));
    }
    return null;
}

/// Resolve the greedy Repeat strategy: a specialised Optional
/// strategy when `pick_optional_specialised` produced one, otherwise
/// `Plain`. The tail-position caller-FOLLOW repair is threaded at
/// runtime (`gate_caller_follow`), so there is no static mask
/// decision to combine here.
fn pick_greedy_strategy(specialised: Option<RepeatStrategy>) -> RepeatStrategy {
    if let Some(strat) = specialised {
        return strat;
    }
    return RepeatStrategy::Plain;
}

/// Try to materialise an `OptionalScanGuard` strategy for an
/// `Optional` Repeat whose inner cannot be decided by lookahead but
/// IS fully scannable. emit runs the scan helper as a commit gate
/// and only parses the body on success.
///
/// Returns `null` for:
/// * leaf inners (Token / Literal / Wildcard / Not — `Plain`
///   handles them without a scan);
/// * token-only Groups, whose scan is the first-set check `Plain`
///   already emits (`optional_body_decided_by_first`);
/// * unscannable inners (no save-and-rewind path; emit will panic
///   with the "no backtracking" message);
/// * RuleRef inners that are unscannable (same reason).
fn try_optional_scan_guard(inner: &Element, ctx: &mut LowerContext) -> Option<RepeatStrategy> {
    let needs_guard = match *inner {
        Group(_) | RuleRef(_) => true,
        TokenRef(_) | Literal(_) | Wildcard(_) | Not(_) | Label(_) | Repeat(_) => false,
    };
    if !needs_guard {
        return null;
    }
    if optional_body_decided_by_first(inner) {
        return null;
    }
    let mut visiting: List<String> = [];
    if !ctx.analysis.is_element_scannable(inner, &mut visiting) {
        return null;
    }
    return Option::Some(RepeatStrategy::OptionalScanGuard);
}

/// Whether scanning the optional's body answers exactly what its first-set
/// check answers: a token-only group, where every alternative is one token.
/// `EOF` is the exception — `p.peek_kind()` reports it past the end of the
/// stream, where a scan fails.
fn optional_body_decided_by_first(inner: &Element) -> bool {
    let alts = if let Group(g) = inner {
        &g.alternatives;
    } else {
        return false;
    };
    if !classify_group(alts) matches { TokenOnly } {
        return false;
    }
    return !alts.iter_ref().any(|alt: &Alternative| alt_is_eof_token(alt));
}

fn alt_is_eof_token(alt: &Alternative) -> bool {
    if let TokenRef(t) = &alt.elements[0] {
        return t.name == "EOF";
    }
    return false;
}

/// Compute the `NonGreedy` strategy for a non-greedy Repeat (`e*?` /
/// `e+?` / `e??`). `exit_first` is the surrounding alt's
/// `outer_follow` — the tokens that may legitimately appear after
/// the loop. `exit_second` provides 2-token disambiguation for the
/// case where the inner's first set overlaps `outer_follow` (e.g.
/// `(',' column_def)*?` followed by `(',' table_constraint)*`,
/// where peek(0)==',' for both but peek(1) distinguishes).
fn compute_non_greedy_strategy(inner: &Element, outer_follow: &List<i32>, ctx: &mut LowerContext) -> RepeatStrategy {
    // Wildcard / Not inner have open-ended first sets — emit treats
    // their continue condition as "while not in follow". The strategy
    // payload just carries `outer_follow` as `exit_first`; emit
    // generates the appropriate "loop until follow appears" check.
    if *inner matches { Wildcard(_) | Not(_) } {
        return RepeatStrategy::NonGreedy(NonGreedyStrategy {
            exit_first: *outer_follow,
            exit_second: [],
        });
    }

    // `exit_second` is needed only when the inner's first set fully
    // overlaps `outer_follow`. For now we only compute it for the
    // single-alt Group inner case (the common ',' separator pattern)
    // and leave it empty otherwise — emit's check falls back to a
    // 1-token peek which conservatively matches minimum.
    let mut exit_second: List<i32> = [];
    if let Group(g) = inner {
        if g.alternatives.len() == 1 && g.alternatives[0].elements.len() >= 2 {
            exit_second = ctx.analysis.first_of_elements_from(&g.alternatives[0].elements, 1);
        }
    }
    return RepeatStrategy::NonGreedy(NonGreedyStrategy {
        exit_first: *outer_follow,
        exit_second: exit_second,
    });
}

/// A first set larger than this is treated as "matches almost anything"
/// (e.g. `name+?` where `name` covers every keyword): single-token lookahead
/// cannot tell the inner from the continuation.
pub global BROAD_FIRST_SET_THRESHOLD: i32 = 20;

/// True when no lookahead separates a non-greedy loop's body from its
/// continuation, so the static exit condition collapses to the minimum
/// match. Stamped on the op and its scan mirror, and consumed by emit's
/// `non_greedy_static_cond`, so all three decide on one answer.
pub fn non_greedy_static_undecided(
    body_first: &List<i32>,
    follow_first: &List<i32>,
    body_second: &List<i32>,
    follow_second: &List<i32>,
) -> bool {
    if body_first.is_empty() {
        return false;
    }
    let continue_first = subtract_sets(body_first, follow_first);
    if !continue_first.is_empty() {
        return continue_first.len() > BROAD_FIRST_SET_THRESHOLD && body_first.len() > BROAD_FIRST_SET_THRESHOLD;
    }
    if !body_second.is_empty() && !follow_second.is_empty() {
        return subtract_sets(body_second, follow_second).is_empty();
    }
    return true;
}

/// A non-greedy `*?` / `+?` over a body taking every token (`.*?`, `~X*?`).
/// No lookahead says where it stops: exiting is viable only where the whole rest
/// of the input matches, which ANTLR4 predicts on, so the runtime simulator
/// decides each exit on the parse and the scan alike.
fn non_greedy_exit_by_atn(non_greedy: bool, kind: RepeatKind, body: &Admits) -> bool {
    return non_greedy && kind matches { Star | Plus } && admits_is_everything(body);
}

/// Whether a Repeat's body and what follows it in its alternative can start on
/// one token, so its first token does not say whether it enters. Past the
/// alternative's end the caller continues, which is unknown here, so a Repeat
/// whose rest can match empty counts as contested. So does one ending an
/// alternative that ends at a left-recursion loop rather than at the rule's
/// tail, which `gate_caller_follow` marks as well.
fn repeat_contested(
    body_admits: &Admits,
    caller_follow_first: &List<i32>,
    alt_elements: &List<Element>,
    index: i32,
    ctx: &mut LowerContext,
    reaches_rule_tail: bool,
    gate_caller_follow: bool,
) -> bool {
    return admits_is_everything(body_admits)
        || admits_overlap(body_admits, caller_follow_first)
        || gate_caller_follow
        || reaches_rule_tail && ctx.analysis.tail_is_nullable_deep(alt_elements, index + 1);
}

/// Rebuild a `RepeatOp` with fresh `caller_follow_first` /
/// `caller_follow_second` while preserving every other field. Used by
/// every alt-walker post-pass — `lower_alt_body`, `lower_lr_alt_suffix`,
/// `lower_single_alt_group`, `lower_general_group` — so a future
/// `RepeatOp` field addition only needs to touch this builder.
fn patch_repeat_op_caller_follow<S: AsStrSlice>(
    rep_op: &RepeatOp,
    caller_follow_first: List<i32>,
    caller_follow_second: List<i32>,
    alt_elements: &List<Element>,
    index: i32,
    ctx: &mut LowerContext,
    reaches_rule_tail: bool,
    rule_name: S,
    outer_suffix: &List<Element> = &NO_OUTER_SUFFIX,
) -> RepeatOp {
    let stamps = lower_repeat_exit_stamps(
        rep_op.non_greedy,
        rep_op.kind,
        &rep_op.body_admits,
        &caller_follow_first,
        &rep_op.body_second_position_first,
        &caller_follow_second,
        alt_elements,
        index,
        ctx,
        reaches_rule_tail,
        rep_op.gate_caller_follow,
        rule_name,
        outer_suffix,
    );
    return RepeatOp {
        ..*rep_op,
        caller_follow_first,
        caller_follow_second,
        continuation_scan: stamps.continuation.elements,
        continuation_scannable: stamps.continuation.scannable,
        continuation_reaches_caller: stamps.continuation.reaches_caller,
        continuation_contested: stamps.continuation_contested,
        static_exit_undecided: stamps.static_exit_undecided,
        atn_decides: stamps.atn_decides,
        shadow: stamps.shadow,
        atn_asked_kinds: stamps.atn_asked_kinds,
        caller_follow_kinds: stamps.continuation.caller_follow_kinds,
        duties: stamps.duties,
    };
}

/// What a loop's exit reads from its place in the alternative, stamped alike on
/// the parse's `RepeatOp` and the scan's `ScanRepeatElement`. `shadow` is the
/// continuation scan the static path would read where the simulator decides,
/// which only the parse's check of it reads.
struct RepeatExitStamps {
    continuation: ContinuationScan,
    shadow: Option<ContinuationScan>,
    continuation_contested: bool,
    static_exit_undecided: bool,
    atn_decides: bool,
    atn_asked_kinds: List<i32>,
    duties: IterationDuties,
}

/// The tokens a loop the simulator decides needs asking about: those that
/// could start the continuation, and those its `.` or `~X` body refuses. Any
/// other token only the body can take, so the prediction would enter too. Empty
/// where the continuation can match empty or a token no first set names, since
/// its first tokens are then not all known.
fn atn_asked_kinds(
    repeat: &Element,
    exit_first: &List<i32>,
    alt_elements: &List<Element>,
    index: i32,
    ctx: &mut LowerContext,
) -> List<i32> {
    if ctx.analysis.tail_is_nullable_deep(alt_elements, index + 1)
        || ctx.analysis.elements_reach_open_end(alt_elements, index + 1) {
        return [];
    }
    let Repeat(rep) = repeat else {
        panic("a loop's exit stamps are read at the loop");
    };
    let refused = match peel_labels(&rep.element) {
        Wildcard(_) => [] as List<i32>,
        Not(ne) => collect_excluded_kinds(&ne.element, &mut ctx.analysis),
        _ => {
            return [];
        },
    };
    let mut asked = union_kind_arrays(exit_first, &refused);
    push_unique(&mut asked, ctx.analysis.eof_kind_id());
    return asked;
}

fn lower_repeat_exit_stamps<S: AsStrSlice>(
    non_greedy: bool,
    kind: RepeatKind,
    body_admits: &Admits,
    caller_follow_first: &List<i32>,
    body_second: &List<i32>,
    caller_follow_second: &List<i32>,
    alt_elements: &List<Element>,
    index: i32,
    ctx: &mut LowerContext,
    reaches_rule_tail: bool,
    gate_caller_follow: bool,
    rule_name: S,
    outer_suffix: &List<Element>,
) -> RepeatExitStamps {
    let by_atn = non_greedy_exit_by_atn(non_greedy, kind, body_admits);
    let contested = ctx.simulator_takes_contested()
        && !by_atn
        && repeat_contested(
            body_admits,
            caller_follow_first,
            alt_elements,
            index,
            ctx,
            reaches_rule_tail,
            gate_caller_follow,
        );
    let shadowed = contested && !non_greedy && ctx.settings.prediction.verifies();
    if by_atn {
        ctx.mark_asks_simulator("a non-greedy loop's exit");
    } else if contested {
        ctx.mark_asks_simulator("a repeat whose body and continuation can start on one token");
    }
    let mut static_scan = || lower_continuation_scan(
        non_greedy,
        kind,
        alt_elements,
        index,
        ctx,
        reaches_rule_tail,
        rule_name,
    );
    return RepeatExitStamps {
        continuation: if by_atn || contested { ContinuationScan {} } else { static_scan() },
        shadow: if shadowed { Option::Some(static_scan()) } else { null },
        continuation_contested: optional_continuation_contested(
            non_greedy,
            kind,
            body_admits,
            caller_follow_first,
            alt_elements,
            index,
            ctx,
        ),
        static_exit_undecided: non_greedy_static_undecided(
            &admits_kinds(body_admits),
            caller_follow_first,
            body_second,
            caller_follow_second,
        ),
        atn_decides: by_atn || contested,
        atn_asked_kinds: if by_atn {
            atn_asked_kinds(&alt_elements[index], caller_follow_first, alt_elements, index, ctx);
        } else {
            [];
        },
        duties: lower_iteration_duties(
            non_greedy,
            kind,
            body_admits,
            alt_elements,
            index,
            ctx,
            outer_suffix,
        ),
    };
}

/// Everything a loop's iteration owes, in one value.
///
/// The loop arrives as its three deciding properties rather than as an op, so
/// the parse's `RepeatOp` and the scan's `ScanRepeatElement` build their duties
/// from the same body. Two calls with the same arguments cannot disagree, which
/// is the invariant the mirrored stamps could only assert.
fn lower_iteration_duties(
    non_greedy: bool,
    kind: RepeatKind,
    loop_admits: &Admits,
    alt_elements: &List<Element>,
    index: i32,
    ctx: &mut LowerContext,
    outer_suffix: &List<Element>,
) -> IterationDuties {
    let mut duties = IterationDuties {};
    let continuation = follow_elements_of(alt_elements, outer_suffix);
    if let Some(scan) = lower_reserve_scan(non_greedy, kind, loop_admits, &continuation, index, ctx) {
        duties.reserve_scan = scan;
    }
    return duties;
}

/// The mandatory suffix a loop must leave to its own alternative, as scan
/// elements. `null` wherever the loop cannot starve it, which is every loop
/// but the `X* X` shape. Inside a group the suffix runs on past the group, so
/// `( X | .* ) Y` reserves the `Y` too.
///
/// Each condition rules out a reservation that would decide nothing and only
/// cost a scan: a non-greedy loop already stops at its continuation; a
/// nullable suffix is nothing to reserve, since the alternative completes
/// without it; a suffix whose head no iteration admits can never be eaten; and
/// an unscannable one would be reserved on a prefix, which proves nothing about
/// the whole.
fn lower_reserve_scan(
    non_greedy: bool,
    kind: RepeatKind,
    loop_admits: &Admits,
    alt_elements: &List<Element>,
    index: i32,
    ctx: &mut LowerContext,
) -> Option<List<ScanElement>> {
    if non_greedy || !kind matches { Star | Plus } {
        return null;
    }
    if index + 1 >= alt_elements.len() || ctx.analysis.tail_is_nullable_deep(alt_elements, index + 1) {
        return null;
    }
    if !admits_overlap(loop_admits, &ctx.analysis.first_of_elements_from(alt_elements, index + 1)) {
        return null;
    }
    return lower_scan_continuation_elements(alt_elements, index, ctx);
}

/// The continuation emit scans, built only for the Repeat kinds whose decision
/// can need it, and only where the scan's end settles the exit.
fn lower_continuation_scan<S: AsStrSlice>(
    non_greedy: bool,
    kind: RepeatKind,
    alt_elements: &List<Element>,
    index: i32,
    ctx: &mut LowerContext,
    reaches_rule_tail: bool,
    rule_name: S,
) -> ContinuationScan {
    let wants_scan = non_greedy || kind matches { Optional };
    // Only a tail walk may ask the caller (invariant 10: a group's walk ends at
    // the group, `use foo::*`); elsewhere the continuation must consume.
    if !wants_scan || !reaches_rule_tail && ctx.analysis.tail_is_nullable_deep(alt_elements, index + 1) {
        return ContinuationScan {};
    }
    let Some(elements) = lower_scan_continuation_elements(alt_elements, index, ctx) else {
        return ContinuationScan {};
    };
    if !reaches_rule_tail {
        return ContinuationScan { elements, scannable: true };
    }
    let caller_follow_kinds = ctx.follow.exact_kinds(rule_name);
    ctx.mark_rule_reads_follow();
    return ContinuationScan { elements, scannable: true, reaches_caller: true, caller_follow_kinds };
}

/// Whether a greedy `?`'s body and what follows it can start on one token, so
/// no lookahead test separates entering from skipping.
fn optional_continuation_contested(
    non_greedy: bool,
    kind: RepeatKind,
    body: &Admits,
    follow: &List<i32>,
    alt_elements: &List<Element>,
    index: i32,
    ctx: &mut LowerContext,
) -> bool {
    if non_greedy || !kind matches { Optional } || admits_is_untestable(body) {
        return false;
    }
    return ctx.analysis.elements_reach_open_end(alt_elements, index + 1) || admits_overlap(body, follow);
}

/// True iff `elem` is a list-label (`+=`). Used by
/// `lower_repeat_op` to bypass the `_list`-suffix base-name
/// computation: when a Repeat's inner is `name+=expr`, the label
/// name IS the array.
fn repeat_inner_is_list_label(elem: &Element) -> bool {
    if let Label(lab) = elem {
        return lab.list;
    }
    return false;
}

/// Outer struct field base name for a Repeat. `Star` / `Plus`
/// take a `_list` suffix on the inner element's base; `Optional`
/// uses the inner base unchanged. Mirrors `parser_gen`'s
/// `dedup_name("<inner>_list", ...)` / `dedup_name("<inner>", ...)`
/// pattern at field-info call sites.
///
/// `gc_speculative` is the speculative group counter for a
/// General-Group inner: the outer field name embeds this id
/// (`group_<id>_list`) and the subsequent inner lowering consumes the
/// same id and increments the counter. Other shapes ignore it.
fn repeat_outer_base_name(elem: &Element, kind: RepeatKind, gc_speculative: i32) -> String {
    let base = repeat_inner_base_name(elem, gc_speculative);
    return match kind {
        Optional => base,
        Star | Plus => `${base}_list`,
    };
}

/// A repeat body's field base name. Unlike `ir_shape`'s `element_base_name`
/// it names every element shape, groups by the shape `classify_group` gives.
fn repeat_inner_base_name(elem: &Element, gc_speculative: i32) -> String {
    return match elem {
        TokenRef(t) => t.field_name,
        Literal(l) => literal_field_name(&l.text),
        RuleRef(r) => r.field_name,
        Wildcard(_) => "wildcard",
        Not(ne) => not_element_field_name(&ne.element),
        Label(lab) => lab.field_name,
        Group(g) => repeat_inner_group_base_name(g, gc_speculative),
        Repeat(_) => panic("Nested Repeat (e**) is not valid g4 syntax"),
    };
}

/// Base name for a Group element when it appears as a Repeat's
/// inner — selects the Group shape's field-base helper that
/// matches the classifier. For a General-Group inner, embeds the
/// caller's speculative `group_counter` value (the same id the
/// inner lowering will consume).
fn repeat_inner_group_base_name(g: &GroupElement, gc_speculative: i32) -> String {
    let alts = &g.alternatives;
    match classify_group(alts) {
        Transparent => {
            return repeat_inner_base_name(&alts[0].elements[0], gc_speculative);
        },
        SingleAlt => {
            return single_alt_group_field_name(&alts[0]);
        },
        TokenOnly => {
            return token_group_field_name(alts);
        },
        SimpleCst => {
            return group_field_base_name(alts);
        },
        // Repeat is the first visitor of its inner Group but defers the
        // group_counter increment to the inner-Op lowering, so embed the
        // same speculative value the increment will use.
        General => {
            return general_group_field_name(gc_speculative);
        },
    }
}

/// Lower a `Label` element by recursively lowering its inner
/// element, then overriding the inner op's field name with the
/// label's name (deduped against the surrounding alt's name table).
///
/// The inner emission would have produced its own field name, but the
/// label rebinds the value under `lab.field_name`. A list label (`+=`) needs a
/// `List<...>`-typed wrapper field, which the CST `FieldDecl` enumeration adds.
fn lower_label_op<S: AsStrSlice>(
    lab: &LabelElement,
    name_counts: &mut List<[String, i32]>,
    rule_name: S,
    ctx: &mut LowerContext,
    group_counter: &mut i32,
    outer_follow: &List<i32>,
    follow_arg: FollowArg,
    gate_caller_follow: bool,
    follow_is_exact: bool = false,
    outer_suffix: &List<Element> = &NO_OUTER_SUFFIX,
) -> Op {
    let label_field = dedup_name(&lab.field_name, name_counts);
    let mut inner_counts: List<[String, i32]> = [];
    // A label `name=elem` is positionally identical to `elem` at the
    // surrounding alt, so the FollowArg / tail-gate propagate verbatim —
    // the RuleRef inside the label still sees the same caller
    // continuation, and a Repeat inside still gates at the same tail
    // position.
    let inner_op = lower_op(
        &lab.element,
        &mut inner_counts,
        rule_name,
        ctx,
        group_counter,
        outer_follow,
        follow_arg,
        gate_caller_follow,
        follow_is_exact,
        outer_suffix,
    );
    if lab.list {
        // `name+=elem` outside a Repeat: the outer CST struct stores
        // the matched value in an `List<inner_type>`. Wrap the inner
        // op so `op_field_decl` produces the `List<>` typing.
        // Inside a Repeat, `lower_repeat_op` adopts the label name
        // directly (the Repeat itself implies `List<>`); that path
        // skips this wrapper.
        //
        // The inner is emitted into the surrounding alternative's scope, not
        // a loop body, so its name has to be unique there. `inner_counts` is
        // fresh, so the name lower just gave it is blind to the alt — name it
        // after the label instead and dedup that in the alt's own table. The
        // local is never read (the tree builder holds the matched value) and
        // `list_label_field_decl` takes only the inner's *type*, so nothing
        // downstream depends on it; reserving it here is what keeps a later
        // sibling from claiming the same name.
        let item_base = `${label_field}_item`;
        let item_field = dedup_name(&item_base, name_counts);
        return Op::ListLabel(ListLabelOp {
            field: label_field,
            inner: rebind_op_field(inner_op, &item_field, &item_base),
            dedup_base: lab.field_name,
        });
    }
    // Scalar `name = elem` rebind. Pass `lab.field_name` as the new
    // dedup_base so emit's leaf sync bumps the rebound name (the only
    // binding that actually surfaces in the generated source) rather
    // than the inner element's elided base.
    return rebind_op_field(inner_op, &label_field, &lab.field_name);
}

/// Enumerate the CST struct fields for an alt's `ops` list. The
/// leading `span: Span` is always present; the rest map 1:1 from
/// the lowered op list. Transparent `Group` ops contribute their
/// inner op's field instead (the group itself has no struct slot).
///
/// It reads the lowered IR, so the field name and type agree with
/// whatever shape the lowering chose. emit reads this list directly to
/// lay out the struct.
fn enumerate_alt_field_decls(ops: &List<Op>) -> List<FieldDecl> {
    let mut fields: List<FieldDecl> = [
        FieldDecl {
            name: "span",
            type_str: "Span",
            kind: FieldKind::Span,
        },
    ];
    let op_fields = enumerate_op_field_decls(ops);
    for let f of &op_fields {
        fields.push(*f);
    }
    return fields;
}

/// Like `enumerate_alt_field_decls` but without the leading `span`
/// entry. Used by nested struct shapes (`SingleAlt`, General-group
/// alt struct) whose containers do not carry their own span field —
/// the surrounding rule-level alt struct owns the span.
fn enumerate_op_field_decls(ops: &List<Op>) -> List<FieldDecl> {
    let mut fields: List<FieldDecl> = [];
    for let op of ops {
        if let Some(decl) = op_field_decl(op) {
            fields.push(decl);
        }
    }
    return fields;
}

/// Single-op field decl. Returns `None` when the op contributes no
/// struct field (Transparent groups inline their inner; Repeats
/// over zero-field inners would do the same once supported).
fn op_field_decl(op: &Op) -> Option<FieldDecl> {
    return match op {
        Token(t) => Option::Some(FieldDecl {
            name: t.field,
            type_str: "i32",
            kind: FieldKind::Plain,
        }),
        Literal(l) => Option::Some(FieldDecl {
            name: l.field,
            type_str: "i32",
            kind: FieldKind::Plain,
        }),
        RuleCall(r) => Option::Some(FieldDecl {
            name: r.field,
            type_str: rule_type_name(&r.target_name),
            kind: FieldKind::Plain,
        }),
        Wildcard(w) => Option::Some(FieldDecl {
            name: w.field,
            type_str: "i32",
            kind: FieldKind::Plain,
        }),
        Excluded(e) => Option::Some(FieldDecl {
            name: e.field,
            type_str: "i32",
            kind: FieldKind::Plain,
        }),
        Repeat(rep) => repeat_field_decl(rep),
        Group(g) => group_field_decl(g),
        ListLabel(ll) => list_label_field_decl(ll),
    };
}

/// FieldDecl for a `name+=elem` list-label outside a Repeat. The
/// inner op contributes its bare type via
/// `op_field_decl_for_repeat_inner` (so SimpleCst / General payloads
/// are NOT pre-wrapped in `Option<>`) and we wrap once in `List<>`.
fn list_label_field_decl(ll: &ListLabelOp) -> Option<FieldDecl> {
    let inner_decl = op_field_decl_for_repeat_inner(&ll.inner);
    return match &inner_decl {
        Some(d) => Option::Some(FieldDecl {
            name: ll.field,
            type_str: `List<${d.type_str}>`,
            kind: FieldKind::List,
        }),
        null => null,
    };
}

fn repeat_field_decl(rep: &RepeatOp) -> Option<FieldDecl> {
    // Inside a Repeat the SimpleCst / General payload appears
    // verbatim (`List<FooGroup>` / `Option<FooGroup>`) — the outer
    // Repeat wraps for us. Use the Repeat-inner variant so we don't
    // double-wrap.
    let inner_decl = op_field_decl_for_repeat_inner(&rep.body);
    let inner_type = match &inner_decl {
        Some(d) => d.type_str,
        // No-field inner (e.g. transparent group with no leaf type
        // resolution). The Repeat then has no struct field either —
        // emit doesn't allocate storage for it.
        null => {
            return null;
        },
    };
    return match rep.kind {
        Optional => Option::Some(FieldDecl {
            name: rep.field,
            type_str: `Option<${inner_type}>`,
            kind: FieldKind::Optional,
        }),
        Star | Plus => Option::Some(FieldDecl {
            name: rep.field,
            type_str: `List<${inner_type}>`,
            kind: FieldKind::List,
        }),
    };
}

/// `op_field_decl` variant that produces the *unwrapped* inner type
/// for `SimpleCst` / `General` groups inside a Repeat. The Repeat
/// itself adds the outer `List<>` / `Option<>` wrap; the
/// non-Repeat top-level path (`op_field_decl`) wraps SimpleCst /
/// General payloads in `Option<>` to mirror parser_gen's
/// `gen_consume_group_store_optional` / `gen_general_group_store_optional`.
fn op_field_decl_for_repeat_inner(op: &Op) -> Option<FieldDecl> {
    if let Group(g) = op {
        return match &g.shape {
            Transparent => transparent_group_inner_decl(g),
            TokenOnly(to) => Option::Some(FieldDecl {
                name: to.field,
                type_str: "i32",
                kind: FieldKind::Plain,
            }),
            SimpleCst(scst) => Option::Some(FieldDecl {
                name: scst.field,
                type_str: scst.type_name,
                kind: FieldKind::Plain,
            }),
            SingleAlt(sa) => Option::Some(FieldDecl {
                name: sa.field,
                type_str: sa.struct_name,
                kind: FieldKind::Plain,
            }),
            General(gen) => Option::Some(FieldDecl {
                name: gen.field,
                type_str: gen.variant_type,
                kind: FieldKind::Plain,
            }),
        };
    }
    return op_field_decl(op);
}

fn group_field_decl(g: &GroupOp) -> Option<FieldDecl> {
    return match &g.shape {
        // Transparent groups inline their single inner op; there
        // is no group-level field. The inner op's decl was already
        // pushed by the surrounding `enumerate_alt_field_decls`
        // — except… it wasn't, because the Group op IS the only
        // entry in the alt's op list at that position. We need to
        // hand back the inner's decl directly.
        Transparent => transparent_group_inner_decl(g),
        TokenOnly(to) => Option::Some(FieldDecl {
            name: to.field,
            type_str: "i32",
            kind: FieldKind::Plain,
        }),
        // Standalone SimpleCst / General groups surface as
        // `Option<>`-typed fields because parser_gen's
        // `gen_consume_group_store_optional` /
        // `gen_general_group_store_optional` initialise the slot to
        // `None` and only populate on a successful dispatch.
        SimpleCst(scst) => Option::Some(FieldDecl {
            name: scst.field,
            type_str: `Option<${scst.type_name}>`,
            kind: FieldKind::Optional,
        }),
        SingleAlt(sa) => Option::Some(FieldDecl {
            name: sa.field,
            type_str: sa.struct_name,
            kind: FieldKind::Plain,
        }),
        General(gen) => Option::Some(FieldDecl {
            name: gen.field,
            type_str: `Option<${gen.variant_type}>`,
            kind: FieldKind::Optional,
        }),
    };
}

/// Transparent groups have exactly one alt whose body is one op.
/// The wrapper has no struct field of its own: `element_has_field`
/// answers `is_storable_group(...)` for a group, which is
/// false for transparent (1-alt, 1-element) groups. Matching that
/// decision here ensures `body.fields` agrees with what emit's
/// runtime construction actually assigns — a transparent `(X)` at
/// outer alt level contributes nothing to the outer CST struct.
fn transparent_group_inner_decl(_g: &GroupOp) -> Option<FieldDecl> {
    return null;
}

/// Replace the `field` slot of an op with `new_field` and the
/// `dedup_base` slot of leaf ops with `new_dedup_base`. Covers every
/// Op variant — labels can wrap any inner shape, and the rebind only
/// rewrites the outermost field slot:
///
/// * Leaf ops carry their field and `dedup_base` directly — replace
///   both. `new_dedup_base` is the surface base name lower would have
///   passed to `dedup_name` for the *rebound* binding (e.g.
///   `lab.field_name` for `name = ID`, `lab.field_name` for the
///   `(name+=elem)*` outer Repeat). The inner element's original
///   `dedup_base` is intentionally dropped: the rebind elides the
///   inner binding from emit, so its base name is no longer in scope
///   and emit's `name_counts` should not pretend it is.
/// * `Repeat` carries the outer struct field on `RepeatOp.field`
///   (the per-iteration `body.field` lives in its own scope and is
///   unaffected). Repeat ops have no `dedup_base` of their own —
///   `new_dedup_base` is unused for this arm.
/// * `Group` shapes carry their outer field inside the shape payload
///   (`TokenOnly.field`, `SimpleCst.field`, etc.); the `Transparent`
///   shape has no field of its own and the label passes through to
///   the inner op. Only `TokenOnly`, a leaf to emit, carries a
///   `dedup_base`.
/// * `ListLabel` carries `dedup_base` itself; rebinding the outer
///   field here updates `dedup_base` to `new_dedup_base` for the same
///   reason as the leaf arms.
pub fn rebind_op_field<S: AsStrSlice, S1: AsStrSlice>(op: Op, new_field: S, new_dedup_base: S1) -> Op {
    return match op {
        Token(mut t) => {
            t.field = new_field.to_string();
            t.dedup_base = new_dedup_base.to_string();
            Op::Token(t);
        },
        Literal(mut l) => {
            l.field = new_field.to_string();
            l.dedup_base = new_dedup_base.to_string();
            Op::Literal(l);
        },
        RuleCall(mut r) => {
            r.field = new_field.to_string();
            r.dedup_base = new_dedup_base.to_string();
            Op::RuleCall(r);
        },
        Wildcard(mut w) => {
            w.field = new_field.to_string();
            w.dedup_base = new_dedup_base.to_string();
            Op::Wildcard(w);
        },
        Excluded(mut e) => {
            e.field = new_field.to_string();
            e.dedup_base = new_dedup_base.to_string();
            Op::Excluded(e);
        },
        Repeat(mut rep) => {
            rep.field = new_field.to_string();
            Op::Repeat(rep);
        },
        Group(mut g) => {
            g.shape = rebind_group_shape(g.shape, new_field, new_dedup_base);
            Op::Group(g);
        },
        ListLabel(mut ll) => {
            ll.field = new_field.to_string();
            ll.dedup_base = new_dedup_base.to_string();
            Op::ListLabel(ll);
        },
    };
}

fn rebind_group_shape<S: AsStrSlice, S1: AsStrSlice>(shape: GroupShape, new_field: S, new_dedup_base: S1) -> GroupShape {
    return match shape {
        Transparent => GroupShape::Transparent,
        TokenOnly(mut to) => {
            to.field = new_field.to_string();
            to.dedup_base = new_dedup_base.to_string();
            GroupShape::TokenOnly(to);
        },
        SimpleCst(mut scst) => {
            scst.field = new_field.to_string();
            GroupShape::SimpleCst(scst);
        },
        SingleAlt(mut sa) => {
            sa.field = new_field.to_string();
            GroupShape::SingleAlt(sa);
        },
        General(mut gen) => {
            gen.field = new_field.to_string();
            GroupShape::General(gen);
        },
    };
}

/// Resolve the exclusion set for a `~ X` element.
///
/// * `~ TOKEN` / `~ 'lit'` — single-token complement, the simple case.
/// * `~ ( A | B | C )` — multi-token complement; each alt must be a
///   single `TokenRef` or `Literal`.
///
/// Other inner shapes (`~ rule`, `~ ( a b )`) name no token set for
/// `p.expect_not(...)` to exclude.
fn collect_excluded_kinds(inner: &Element, analysis: &mut GrammarAnalysis) -> List<i32> {
    return match inner {
        TokenRef(_) | Literal(_) => [analysis.terminal_kind(inner)],
        Group(g) => collect_excluded_kinds_from_group(g, analysis),
        _ => panic(
            "collect_excluded_kinds: unsupported inner shape (only TokenRef / Literal / single-token-alts Group are valid)",
        ),
    };
}

fn collect_excluded_kinds_from_group(g: &GroupElement, analysis: &mut GrammarAnalysis) -> List<i32> {
    let mut kinds: List<i32> = [];
    for let alt of &g.alternatives {
        assert alt.elements.len() == 1, "collect_excluded_kinds: ~ Group alt must be a single token / literal";
        let elem = &alt.elements[0];
        assert elem matches { TokenRef(_) | Literal(_) }, "collect_excluded_kinds: ~ Group alt must be a single token / literal";
        kinds.push(analysis.terminal_kind(elem));
    }
    return kinds;
}
