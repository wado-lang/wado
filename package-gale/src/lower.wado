//! `lower(Grammar) -> LoweredGrammar` — translate the surface IR
//! to GIR for parser code generation.
//!
//! This is the planning phase of the pipeline:
//!
//! ```text
//! .g4 source ──parse──► Grammar (surface IR, ir.wado)
//!                ──lower──► LoweredGrammar (gir.wado)
//!                ──emit──► Wado source
//! ```
//!
//! Every codegen-time decision (rule shape, multi-alt dispatch, LR
//! precedence, follow variants, group shape, repeat strategy, field
//! deduplication, scan/parse symmetry) is committed here so the emit
//! layer can translate structurally without consulting the surface IR.
//!
//! ## Phase status
//!
//! Phase 2 is complete: lower handles every shape the surface IR
//! produces — single-alt and multi-alt rules, left-recursive rules
//! (atom + lr_alts), every Group classifier (`Transparent`,
//! `SingleAlt`, `TokenOnly`, `SimpleCst`, `General`), every Repeat
//! kind (`Star` / `Plus` / `Optional`) with both greedy and
//! non-greedy semantics, `Not` complements (single token or
//! multi-token Group), and scalar / list (`+=`) Labels. Dispatch
//! falls into `Direct` for disjoint first-sets or `Tournament` for
//! overlapping fully-scannable alts. Follow-aware variants are
//! registered per call site and re-lowered per `(rule, mask)` pair;
//! variant-body Repeats pick `Suppressed` / `WithFollowSubtraction`
//! / `Plain` based on how the mask intersects the loop's inner
//! first set. Repeats over General-Group inners coordinate the
//! per-rule `group_counter` so the outer field name and the inner
//! variant share the same id.
//!
//! Optional `?` Repeats now resolve to `OptionalLookahead` when
//! the inner is a single-alt Group of ≥ 2 fixed tokens, or to
//! `OptionalScanGuard` when the inner is a scannable Group /
//! RuleRef without a usable fixed-token prefix. The mask-driven
//! `Suppressed` decision still wins over both — if every iteration
//! is claimed by the variant's follow mask, the loop never runs.
//!
//! Phase 3 swaps `codegen::generate` to call `lower` and feed the
//! result through a thin emit adapter; until then this file is
//! exercised only by `lower_test.wado`.

use { Grammar, ParserRule, Alternative, Element, LabelElement, RepeatElement, RepeatKind, GroupElement } from "./ir.wado";
use { alt_is_wildcard_led } from "./alt_grouping.wado";
use {
    rule_type_name,
    literal_const_name,
    literal_field_name,
    not_element_field_name,
    case_names_for_rule,
    count_general_groups,
    single_alt_group_type_name,
    single_alt_group_field_name,
    is_token_only_group,
    is_simple_cst_group,
    is_general_group,
    token_group_field_name,
    group_variant_type_name,
    group_field_base_name,
    group_case_name,
    general_group_type_name,
    general_group_field_name,
    general_group_alt_struct_name,
    is_storable_group,
} from "./gen_util.wado";
use { LitToken } from "./lexer_gen.wado";
use { GenContext, is_nullable, union_kind_arrays, FOLLOW_VARIANT_MAX_K } from "./gen_context.wado";
use { strip_suffix } from "./gen_util.wado";
use { compute_prefix_self_ref_min_prec } from "./lr_util.wado";
use { TreeMap } from "core:collections";
use {
    LoweredGrammar,
    Rule,
    SimpleRule,
    MultiAltRule,
    LeftRecursiveRule,
    LrAlt,
    LrDispatchData,
    RuleHeader,
    AltBody,
    MultiAltDispatch,
    DirectDispatch,
    DispatchBranch,
    TournamentDispatch,
    ScanBody,
    ScanElement,
    ScanTokenElem,
    ScanRuleCallElem,
    ScanExcludedElem,
    ScanRepeatElem,
    ScanRepeatStrategy,
    ScanGroupElem,
    ScanOptionalLookaheadElem,
    Op,
    TokenOp,
    LiteralOp,
    RuleCallOp,
    WildcardOp,
    ExcludedOp,
    RepeatOp,
    RepeatBodyShape,
    RepeatStrategy,
    NonGreedyStrategy,
    WithFollowSubtractionStrategy,
    OptionalLookaheadStrategy,
    OptionalShapeLookaheadStrategy,
    OptionalLookaheadShape,
    GroupOp,
    GroupShape,
    SingleAltShape,
    TokenOnlyShape,
    SimpleCstShape,
    GeneralShape,
    ListLabelOp,
    FieldDecl,
    FieldKind,
    KindSet,
    FollowVariant,
} from "./gir.wado";

/// Lower a `Grammar` to `LoweredGrammar`. The returned value is the
/// only input parser-side codegen needs; lexer / visitor / highlight
/// emission still consume `Grammar` directly in v1 (their data is
/// also mirrored here for forward compatibility).
///
/// `lit_tokens` is computed by `lexer_gen::collect_literal_tokens`
/// before lowering and threaded in so a single literal-collection
/// pass serves both the lexer and parser sides.
/// Convenience entry for callers that don't share a `GenContext`
/// with downstream emit (e.g. `lower_test.wado` smoke tests). Real
/// codegen calls `lower_with_ctx` instead so the variant and
/// kind-set registries land in the ctx emit later consumes.
pub fn lower(grammar: &Grammar, lit_tokens: &Array<LitToken>) -> LoweredGrammar {
    let mut ctx = GenContext::new(&grammar.parser_rules, lit_tokens);
    return lower_with_ctx(grammar, lit_tokens, &mut ctx);
}

pub fn lower_with_ctx(grammar: &Grammar, lit_tokens: &Array<LitToken>, ctx: &mut GenContext) -> LoweredGrammar {
    // `ctx` is shared with downstream emit. The follow-variant and
    // kind-set registries lower writes into ctx are the same ones
    // emit reads from later: the per-rule lower walk below interns
    // variants at every `RuleRef` site through
    // `ctx.intern_follow_variant` (idempotent on the canonical
    // `(rule, mask, k_prefix_mask)` triple), and emit's `gen_parser`
    // loops over `ctx.follow_variants()` to emit the body for each
    // entry. Caches (first / nullable / single-token / scannable /
    // tail-greedy) survive across the lower-then-emit boundary and
    // only get computed once.
    let mut parser_rules: Array<Rule> = [];
    let empty_mask: Array<String> = [];
    let empty_k_mask: Array<Array<String>> = [];
    for let rule of &grammar.parser_rules {
        parser_rules.push(lower_rule(rule, ctx, &empty_mask, &empty_k_mask));
    }
    // Phase 2.6 — follow-variant body lowering. The walk above
    // registered every variant the rule bodies trigger via
    // `intern_follow_variant`; iterate the registry to lower one
    // body per entry. Each variant's body lowering re-walks the
    // rule with the variant's mask threaded through, which may
    // register further variants whose own bodies must be lowered —
    // loop to a fixed point.
    let variant_rules = lower_variant_rules(&grammar.parser_rules, ctx);
    // Phase 2.7 — pre-intern multi-element token-kind sets that
    // surface in dispatch branches and `Op::Excluded` kinds. The
    // resulting registry is the source of truth for `_gale_kind_set_<id>`
    // helper-function emission; emit consults it in lockstep with
    // the dispatch / op walk it does anyway.
    let kind_sets = intern_kind_sets(&parser_rules, ctx);
    return LoweredGrammar {
        name: grammar.name,
        source_files: grammar.source_files,
        options: grammar.options,
        named_actions: grammar.named_actions,
        lexer_rules: grammar.lexer_rules,
        mode_names: grammar.mode_names,
        channels: grammar.channels,
        lit_tokens: *lit_tokens,
        parser_rules,
        variant_rules,
        kind_sets,
    };
}

/// Lower each registered follow-aware variant. Runs as a fixed-point
/// loop because a variant body may itself register new variants. Each
/// per-variant lowering passes `entry.mask` as `variant_mask` to
/// `lower_rule`; that mask is consumed by `lower_repeat_op` /
/// `lower_scan_repeat` to pick `Suppressed` / `WithFollowSubtraction`
/// strategies and by `compute_call_site_follow` for the deep-nullable
/// suffix propagation, then falls back to `[]` for the next iteration.
fn lower_variant_rules(parser_rules: &Array<ParserRule>, ctx: &mut GenContext) -> Array<Rule> {
    let mut result: Array<Rule> = [];
    let mut lowered_count: i32 = 0;
    loop {
        let entries = ctx.follow_variants();
        if entries.len() == lowered_count {
            break;
        }
        // Lower the entries we haven't seen yet. The registry is
        // append-only, so indices < `lowered_count` are already in
        // `result`; new entries land at the end.
        for let mut i = lowered_count; i < entries.len(); i += 1 {
            let entry = &entries[i];
            let rule = match ctx.find_rule(&entry.rule_name) {
                Some(r) => r,
                null => panic(
                    `lower_variant_rules: rule '{entry.rule_name}' not found — intern_follow_variant should reject unknown rules`,
                ),
            };
            // Thread the variant's mask through `lower_rule` so the
            // body's per-element follow (computed via
            // `compute_call_site_follow`) propagates it through
            // deep-nullable suffixes, and `lower_repeat_op` /
            // `lower_scan_repeat` see it for the mask-aware
            // greedy-strategy decision. Without this propagation, the
            // body re-lowers with an empty mask and misses interning
            // the secondary variants emit would register at its
            // `intern_follow_variant` call sites — which `gen_parser`
            // now treats as a hard assertion.
            let mut lowered = lower_rule(rule, ctx, &entry.mask, &entry.k_prefix_mask);
            // Tag the lowered rule's header so emit can route the
            // variant to its `__follow_<id>` function name.
            attach_variant_header(&mut lowered, FollowVariant {
                id: entry.id,
                rule_name: entry.rule_name,
                mask: entry.mask,
                scan_used: entry.scan_used,
                parse_used: entry.parse_used,
            });
            // Re-route self-recursive scan calls inside the variant's
            // LR suffixes to the variant's own `__follow_<id>` function.
            // Mirrors the pre-Phase-2-F emitter, which used the
            // surrounding `fn_name` (`scan_X__follow_<id>` when called
            // from `emit_follow_variant_from_gir`) for every self-ref
            // regardless of the call-site's local follow.
            attach_variant_id_to_lr_self_refs(&mut lowered, &rule.snake_name, entry.id);
            result.push(lowered);
        }
        lowered_count = entries.len();
    }
    return result;
}

fn attach_variant_header(rule: &mut Rule, v: FollowVariant) {
    let wrapped = Option::<FollowVariant>::Some(v);
    match *rule {
        Simple(s) => {
            let mut h = s.header;
            h.variant_of = wrapped;
            *rule = Rule::Simple(SimpleRule { header: h, body: s.body, scan_body: s.scan_body });
        },
        MultiAlt(m) => {
            let mut h = m.header;
            h.variant_of = wrapped;
            *rule = Rule::MultiAlt(MultiAltRule {
                header: h,
                alts: m.alts,
                scan_alts: m.scan_alts,
                dispatch: m.dispatch,
                scan_dispatch: m.scan_dispatch,
            });
        },
        LeftRecursive(l) => {
            let mut h = l.header;
            h.variant_of = wrapped;
            *rule = Rule::LeftRecursive(LeftRecursiveRule {
                header: h,
                atom: l.atom,
                lr_alts: l.lr_alts,
                lr_dispatch: l.lr_dispatch,
            });
        },
    }
}

/// Walk a freshly-lowered LR variant rule and re-stamp `variant_id`
/// on every top-level self-recursive `ScanRuleCall` inside the LR
/// suffixes. Used by `lower_variant_rules` after `attach_variant_header`
/// to preserve the pre-Phase-2-F emitter contract: an LR variant's
/// suffix recurses into the SAME variant function (not the base
/// `scan_X`, and not whichever per-call-site variant
/// `intern_follow_variant` happened to register for the local follow).
///
/// No-op for non-LR rules — they have no LR suffix to walk.
fn attach_variant_id_to_lr_self_refs(rule: &mut Rule, rule_snake: &String, variant_id: i32) {
    if let LeftRecursive(l) = *rule {
        // Walk every suffix once to count self-refs. If zero, the
        // rebuild is a no-op — skip it so a variant rule with only
        // non-self-ref-targeting LR alts (e.g. unary prefix alts
        // whose suffix is just a token) doesn't pay the
        // reconstruction cost.
        let mut has_self_ref = false;
        for let lr_alt of &l.lr_alts {
            for let se of &lr_alt.scan_suffix.elements {
                if let RuleCall(rc) = se {
                    if rc.target_snake == *rule_snake {
                        has_self_ref = true;
                        break;
                    }
                }
            }
            if has_self_ref {
                break;
            }
        }
        if !has_self_ref {
            return;
        }
        let mut new_lr_alts: Array<LrAlt> = [];
        for let lr_alt of &l.lr_alts {
            let mut new_elements: Array<ScanElement> = [];
            for let se of &lr_alt.scan_suffix.elements {
                new_elements.push(rebind_scan_self_ref_variant_id(*se, rule_snake, variant_id));
            }
            new_lr_alts.push(LrAlt {
                alt_index: lr_alt.alt_index,
                case_name: lr_alt.case_name,
                struct_name: lr_alt.struct_name,
                suffix: lr_alt.suffix,
                scan_suffix: ScanBody { elements: new_elements },
                own_prec: lr_alt.own_prec,
                conflict_min: lr_alt.conflict_min,
                last_self_ref_idx: lr_alt.last_self_ref_idx,
                suffix_first: lr_alt.suffix_first,
                right_associative: lr_alt.right_associative,
                prefix_self_ref: lr_alt.prefix_self_ref,
            });
        }
        *rule = Rule::LeftRecursive(LeftRecursiveRule {
            header: l.header,
            atom: l.atom,
            lr_alts: new_lr_alts,
            lr_dispatch: l.lr_dispatch,
        });
    }
}

fn rebind_scan_self_ref_variant_id(se: ScanElement, rule_snake: &String, variant_id: i32) -> ScanElement {
    if let RuleCall(rc) = se {
        if rc.target_snake == *rule_snake {
            return ScanElement::RuleCall(ScanRuleCallElem {
                target_snake: rc.target_snake,
                variant_id: Option::<i32>::Some(variant_id),
                min_prec_arg: rc.min_prec_arg,
            });
        }
    }
    return se;
}

/// Walk every lowered `Rule` and intern every multi-element
/// token-kind set into a single `KindSet` registry. The resulting
/// `Array<KindSet>` is keyed by registration order — single-token
/// sets are not interned (emit renders those as `<expr> == TK_X`
/// directly), and identical sets share a single `id` so the
/// generated `_gale_kind_set_<id>` helper is shared.
///
/// Covers the `Direct` dispatch (multi-token branch.tokens) and
/// `Op::Excluded.kinds`. `Tournament` carries only alt indices and
/// has no kind set to intern. Strategy-internal token sets
/// (`WithFollowSubtraction.effective_first`, `NonGreedy.exit_*`,
/// `OptionalLookahead.sigs`) are consumed inline by emit and don't
/// need helper-function interning.
fn intern_kind_sets(parser_rules: &Array<Rule>, ctx: &mut GenContext) -> Array<KindSet> {
    // Prime ctx's kind-set registry with every multi-element token
    // set the lowered IR carries. ctx is also where emit interns
    // sets at gen_parse_fn time via `kind_check_str`; sharing the
    // registry means lower's helper ids match emit's call sites
    // exactly — `_gale_kind_set_<id>` references resolve to the
    // helper this pre-pass produced.
    for let rule of parser_rules {
        walk_rule_for_kind_sets(rule, ctx);
    }
    // Snapshot ctx's current state. Emit may grow this registry
    // further when `kind_check_str` hits a set lower didn't see
    // (e.g. token sets that surface only from the legacy emit
    // walks that don't read from GIR yet). Those tail entries
    // remain reachable via `ctx.kind_sets()` and the kind-set
    // helper emitter handles them via the salvage tail.
    let entries = ctx.kind_sets();
    let mut sets: Array<KindSet> = [];
    for let entry of &entries {
        sets.push(KindSet { id: entry.id, tokens: entry.tokens });
    }
    return sets;
}

fn walk_rule_for_kind_sets(rule: &Rule, ctx: &mut GenContext) {
    match *rule {
        Simple(s) => {
            walk_alt_body_for_kind_sets(&s.body, ctx);
            walk_scan_body_for_kind_sets(&s.scan_body, ctx);
        },
        MultiAlt(m) => {
            walk_dispatch_for_kind_sets(&m.dispatch, ctx);
            walk_dispatch_for_kind_sets(&m.scan_dispatch, ctx);
            for let alt of &m.alts {
                walk_alt_body_for_kind_sets(alt, ctx);
            }
            for let sb of &m.scan_alts {
                walk_scan_body_for_kind_sets(sb, ctx);
            }
        },
        LeftRecursive(l) => {
            walk_dispatch_for_kind_sets(&l.atom.dispatch, ctx);
            walk_dispatch_for_kind_sets(&l.atom.scan_dispatch, ctx);
            for let alt of &l.atom.alts {
                walk_alt_body_for_kind_sets(alt, ctx);
            }
            for let sb of &l.atom.scan_alts {
                walk_scan_body_for_kind_sets(sb, ctx);
            }
            for let lr of &l.lr_alts {
                walk_alt_body_for_kind_sets(&lr.suffix, ctx);
                walk_scan_body_for_kind_sets(&lr.scan_suffix, ctx);
            }
        },
    }
}

/// Walk a `ScanBody` and pre-register every kind set the op-driven
/// scan emit will consult at `kind_check_str` time. Keeps the
/// registry in lock-step with the IR so `_gale_kind_set_<id>` names
/// don't shift when emit-time intern call orders change between
/// refactors.
fn walk_scan_body_for_kind_sets(body: &ScanBody, ctx: &mut GenContext) {
    for let elem of &body.elements {
        walk_scan_element_for_kind_sets(elem, ctx);
    }
}

fn walk_scan_element_for_kind_sets(elem: &ScanElement, ctx: &mut GenContext) {
    match *elem {
        Token(_) => {
        },
        RuleCall(_) => {
        },
        Wildcard => {
        },
        Excluded(e) => {
            if e.kinds.len() >= 2 {
                ctx.intern_kind_set(&e.kinds);
            }
        },
        Repeat(r) => {
            // `gen_scan_op_repeat` reads `inner_first` for the
            // while-loop guard. `WithFollowSubtraction` overrides it
            // with `effective_first`. For Optional + RuleRef bodies
            // the emit additionally subtracts `caller_follow_first`
            // from the loop's first set — pre-register that derived
            // set too so the `_gale_kind_set_<id>` registry stays
            // anchored to the lower walk order.
            if r.inner_first.len() >= 2 {
                ctx.intern_kind_set(&r.inner_first);
            }
            let loop_first = if let WithFollowSubtraction(s) = &r.strategy {
                if s.effective_first.len() >= 2 {
                    ctx.intern_kind_set(&s.effective_first);
                }
                s.effective_first;
            } else {
                r.inner_first;
            };
            if let Optional = r.kind {
                let body_is_rulecall = r.body matches { RuleCall(_) };
                if body_is_rulecall && !r.caller_follow_first.is_empty() {
                    let effective = subtract_first(&loop_first, &r.caller_follow_first);
                    if effective.len() >= 2 {
                        ctx.intern_kind_set(&effective);
                    }
                }
            }
            walk_scan_element_for_kind_sets(&r.body, ctx);
        },
        Group(g) => {
            walk_dispatch_for_kind_sets(&g.dispatch, ctx);
            // Per-alt first sets feed the ambiguity check inside
            // `gen_scan_op_group` (which calls `kind_check_str` on
            // each `alt_first_sets[i]` indirectly via the lenient gate).
            for let fs of &g.alt_first_sets {
                if fs.len() >= 2 {
                    ctx.intern_kind_set(fs);
                }
            }
            // Lenient gate union: when emit takes the top-level call
            // path with `lenient = true`, it builds the union of every
            // alt's first set and emits a single kind-set check before
            // entering the dispatch. Compute the same union here so the
            // intern lands at lower time.
            if g.lenient {
                let mut union_first: Array<String> = [];
                for let fs of &g.alt_first_sets {
                    for let tk of fs {
                        if !first_set_contains(&union_first, tk) {
                            union_first.push(*tk);
                        }
                    }
                }
                if union_first.len() >= 2 {
                    ctx.intern_kind_set(&union_first);
                }
            }
            for let b of &g.alts {
                walk_scan_body_for_kind_sets(b, ctx);
            }
        },
        OptionalLookahead(ole) => {
            // Per-shape per-position kind sets feed
            // `gen_scan_lookahead_condition`. Walk every signature so
            // emit hits existing entries.
            for let sig of &ole.sigs {
                for let pos_set of sig {
                    if pos_set.len() >= 2 {
                        ctx.intern_kind_set(pos_set);
                    }
                }
            }
            for let b of &ole.bodies {
                walk_scan_body_for_kind_sets(b, ctx);
            }
        },
    }
}

fn walk_dispatch_for_kind_sets(d: &MultiAltDispatch, ctx: &mut GenContext) {
    match *d {
        Direct(dd) => {
            for let branch of &dd.branches {
                if branch.tokens.len() >= 2 {
                    ctx.intern_kind_set(&branch.tokens);
                }
            }
        },
        Tournament(_) => {
        },
    }
}

fn walk_alt_body_for_kind_sets(alt: &AltBody, ctx: &mut GenContext) {
    for let op of &alt.ops {
        walk_op_for_kind_sets(op, ctx);
    }
}

fn walk_op_for_kind_sets(op: &Op, ctx: &mut GenContext) {
    match *op {
        Excluded(e) => {
            if e.kinds.len() >= 2 {
                ctx.intern_kind_set(&e.kinds);
            }
        },
        Repeat(r) => walk_op_for_kind_sets(&r.body, ctx),
        Group(go) => {
            walk_dispatch_for_kind_sets(&go.dispatch, ctx);
            walk_dispatch_for_kind_sets(&go.scan_dispatch, ctx);
            for let inner_alt of &go.alts {
                walk_alt_body_for_kind_sets(inner_alt, ctx);
            }
        },
        ListLabel(ll) => walk_op_for_kind_sets(&ll.inner, ctx),
        Token(_) | Literal(_) | RuleCall(_) | Wildcard(_) => {
        },
    }
}

// `intern_kind_set` / `canonical_kind_set` / `join_pipe` removed;
// `walk_*_for_kind_sets` calls `ctx.intern_kind_set` directly so
// lower and emit share a single registry.

/// Classify a parser rule by shape and dispatch to the matching
/// lowering. Single-alt → `Simple`; multi-alt with no LR alt →
/// `MultiAlt`; multi-alt with at least one LR alt → `LeftRecursive`.
/// The shape decision matches `parser_gen::gen_parse_fn_named`'s
/// branching exactly so the eventual Phase 4 split is a structural
/// translation rather than a re-classification.
fn lower_rule(rule: &ParserRule, ctx: &mut GenContext, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>) -> Rule {
    if rule.alternatives.len() == 1 {
        return Rule::Simple(lower_simple_rule(rule, ctx, variant_mask, variant_k_prefix_mask));
    }
    if has_left_recursive_alt(rule) {
        return Rule::LeftRecursive(lower_lr_rule(rule, ctx, variant_mask, variant_k_prefix_mask));
    }
    return Rule::MultiAlt(lower_multi_alt_rule(rule, ctx, variant_mask, variant_k_prefix_mask));
}

fn lower_simple_rule(rule: &ParserRule, ctx: &mut GenContext, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>) -> SimpleRule {
    let body = lower_alt_body(&rule.alternatives[0], 0, rule, ctx, variant_mask, variant_k_prefix_mask);
    let scan_body = lower_scan_body(&rule.alternatives[0], ctx, variant_mask, variant_k_prefix_mask);
    return SimpleRule {
        header: lower_header(rule),
        body,
        scan_body,
    };
}

/// Lower a multi-alt rule (no LR alts). Phase 2.3a only handles the
/// case where every pair of alts has disjoint first-sets — the
/// dispatch is a single token-led `if / else if` chain (`Direct`).
/// Overlapping first-sets land in `Tournament` (scan-and-commit).
fn lower_multi_alt_rule(rule: &ParserRule, ctx: &mut GenContext, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>) -> MultiAltRule {
    let header = lower_header(rule);

    // Compute per-alt first sets up-front so the dispatch decision
    // sees them and the resulting `DispatchBranch.tokens` reuses the
    // same sets the per-alt analysis already computed.
    let mut first_sets: Array<Array<String>> = [];
    for let alt of &rule.alternatives {
        let mut visiting: Array<String> = [];
        first_sets.push(ctx.first_of_alt(alt, &mut visiting));
    }

    let mut alts: Array<AltBody> = [];
    let mut scan_alts: Array<ScanBody> = [];
    let mut all_indices: Array<i32> = [];
    for let mut i = 0; i < rule.alternatives.len(); i += 1 {
        alts.push(lower_alt_body(&rule.alternatives[i], i, rule, ctx, variant_mask, variant_k_prefix_mask));
        scan_alts.push(lower_scan_body(&rule.alternatives[i], ctx, variant_mask, variant_k_prefix_mask));
        all_indices.push(i);
    }

    let ctx_label = `rule '{rule.name}'`;
    let dispatch = build_overlap_dispatch(&ctx_label, &rule.alternatives, &all_indices, &first_sets, ctx);
    return MultiAltRule {
        header,
        alts,
        scan_alts,
        dispatch: clone_dispatch(&dispatch),
        scan_dispatch: dispatch,
    };
}

/// Lower a directly-left-recursive rule. ANTLR4 rewrites
/// `expr : expr op expr | atom ;` into a precedence-climbing
/// `parse_expr(min_prec)` whose body parses an atom and then runs
/// a loop that dispatches on the next token to one of the LR
/// suffix bodies. We mirror that structure in GIR:
///
/// * `atom: MultiAltRule` — the non-LR alternatives, lowered
///   exactly as a regular multi-alt rule. When only one non-LR alt
///   exists, this is still a `MultiAltRule` with a single-branch
///   `Direct` dispatch — emit treats both cases uniformly.
/// * `lr_alts: Array<LrAlt>` — per-LR-alt metadata: prefix-stripped
///   suffix, precedence assignment, conflict-min-precedence, last
///   internal self-ref index, suffix first-set, right-associativity.
/// * `lr_dispatch: LrDispatchData` — the suffix-loop overlap groups
///   and the indices of LR alts that have a non-empty suffix.
///
/// Phase 2.4 only handles the disjoint-suffix-first case (no overlap
/// groups beyond singletons). Overlapping suffix first-sets need
/// the scan-tournament dispatch from Phase 2.3c.
fn lower_lr_rule(rule: &ParserRule, ctx: &mut GenContext, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>) -> LeftRecursiveRule {
    let header = lower_header(rule);

    // Partition alts into atom (non-LR) and lr (LR). ANTLR4 requires
    // at least one non-LR alt; we mirror the assertion so the GIR
    // `atom: MultiAltRule` invariant (header derived from a non-empty
    // alt set) is honoured.
    let mut non_lr_indices: Array<i32> = [];
    let mut lr_indices: Array<i32> = [];
    for let mut i = 0; i < rule.alternatives.len(); i += 1 {
        if alt_is_left_recursive(&rule.alternatives[i], &rule.name) {
            lr_indices.push(i);
        } else {
            non_lr_indices.push(i);
        }
    }
    assert !non_lr_indices.is_empty(), `LR rule '{rule.name}' has no non-LR alt — ANTLR4 requires at least one atom alt`;
    assert !lr_indices.is_empty(), `LR rule '{rule.name}' has no LR alt — should not have reached lower_lr_rule`;

    let total_lr: i32 = lr_indices.len();
    let atom = lower_lr_atom(rule, &non_lr_indices, ctx, variant_mask, variant_k_prefix_mask);

    // Lower each LR alt's suffix and compute its precedence /
    // metadata. `own_prec` follows ANTLR4's convention: first LR
    // alt in source order gets the highest precedence (`total_lr`),
    // last gets `1`.
    let mut lr_alts: Array<LrAlt> = [];
    let mut lr_position: i32 = 0;
    for let lr_idx of &lr_indices {
        let alt = &rule.alternatives[*lr_idx];
        let own_prec = total_lr - lr_position;
        let conflict_min = compute_lr_conflict_min_prec(alt, own_prec, &lr_indices, rule, ctx, total_lr);
        lr_alts.push(lower_lr_alt(rule, *lr_idx, own_prec, conflict_min, ctx, variant_mask, variant_k_prefix_mask));
        lr_position += 1;
    }

    let lr_dispatch = compute_lr_dispatch_data(&lr_alts);

    // Bake `min_prec_arg` into every self-recursive `RuleCall` op
    // inside each LR suffix. Mirrors emit's
    // `compute_lr_self_ref_prec` decision, but resolved once at
    // lower time so emit consumes the suffix as a structural walk.
    // Stamps both `suffix.ops` (parse-side `RuleCallOp.min_prec_arg`)
    // and `scan_suffix.elements` (scan-side `ScanRuleCallElem.min_prec_arg`).
    stamp_lr_self_ref_min_prec(&mut lr_alts, &rule.name, &rule.snake_name);

    return LeftRecursiveRule {
        header,
        atom,
        lr_alts,
        lr_dispatch,
    };
}

/// Walk every LR suffix and stamp `min_prec_arg` on self-recursive
/// calls — both on the parse-side ops (`RuleCallOp.min_prec_arg`)
/// and on the scan-side elements (`ScanRuleCallElem.min_prec_arg`).
/// The trailing self-ref (at original alt position
/// `last_self_ref_idx`) uses the alt's `conflict_min`; non-trailing
/// self-refs use 0 unless the immediately following op is a fixed
/// token that also appears in some LR alt's `suffix_first` set (the
/// BETWEEN…AND-style case where a non-final self-ref must keep its
/// precedence so the shared delimiter binds correctly). Mirrors
/// `parser_gen::compute_lr_self_ref_prec`.
///
/// Parse-side `suffix.ops` and scan-side `scan_suffix.elements`
/// walk the same `alt.elements[1..]` in lockstep — index `k` on
/// each side corresponds to `alt.elements[k+1]`. The per-position
/// precedence is computed once from the parse-side ops (whose
/// neighbour tokens drive the BETWEEN…AND decision) and then
/// stamped onto whichever side carries a self-ref at that position.
fn stamp_lr_self_ref_min_prec(lr_alts: &mut Array<LrAlt>, rule_name: &String, rule_snake: &String) {
    let lr_suffix_first_tokens = collect_lr_suffix_first_tokens_from_lowered(lr_alts);
    for let mut i = 0; i < lr_alts.len(); i += 1 {
        let suffix_len = lr_alts[i].suffix.ops.len();
        let last_self_ref_idx = lr_alts[i].last_self_ref_idx;
        let conflict_min = lr_alts[i].conflict_min;

        let scan_len = lr_alts[i].scan_suffix.elements.len();
        assert scan_len == suffix_len, `LR suffix walk length mismatch: parse-side {suffix_len}, scan-side {scan_len}`;

        let mut new_ops: Array<Op> = [];
        let mut new_scan: Array<ScanElement> = [];
        for let mut k = 0; k < suffix_len; k += 1 {
            // suffix.ops[k] / scan_suffix.elements[k] correspond to
            // alt.elements[k+1].
            let elem_idx = k + 1;
            let op_ref = &lr_alts[i].suffix.ops[k];
            let se_ref = &lr_alts[i].scan_suffix.elements[k];

            // Find the inner parse-side RuleCall, peeling a single
            // `Op::ListLabel` wrapper (scalar `Label` is collapsed
            // by `lower_label_op`).
            let inner_rc_opt = find_self_ref_rule_call(op_ref, rule_name);
            if let Some(_) = inner_rc_opt {
                let prec = compute_self_ref_prec_from_ops(
                    &lr_alts[i].suffix.ops,
                    k,
                    elem_idx,
                    last_self_ref_idx,
                    conflict_min,
                    &lr_suffix_first_tokens,
                );
                new_ops.push(rebind_self_ref_min_prec(*op_ref, prec));
                new_scan.push(rebind_scan_self_ref_min_prec(*se_ref, rule_snake, prec));
            } else {
                new_ops.push(*op_ref);
                new_scan.push(*se_ref);
            }
        }
        lr_alts[i].suffix.ops = new_ops;
        lr_alts[i].scan_suffix = ScanBody { elements: new_scan };
    }
}

/// Scan-side counterpart to `rebind_self_ref_min_prec`. Stamps
/// `min_prec_arg` on the top-level `ScanRuleCall` when it targets
/// `rule_snake`, and clears `variant_id` — for an LR self-ref the
/// LR loop's `min_prec` is what disambiguates the climb, so the
/// per-call-site variant id `intern_follow_variant` returned is not
/// what we want here. `lower_variant_rules` re-stamps `variant_id`
/// for variant bodies via `attach_variant_id_to_lr_self_refs` so a
/// `__follow_<id>` variant recurses into the same variant.
fn rebind_scan_self_ref_min_prec(se: ScanElement, rule_snake: &String, prec: i32) -> ScanElement {
    if let RuleCall(rc) = se {
        if rc.target_snake == *rule_snake {
            return ScanElement::RuleCall(ScanRuleCallElem {
                target_snake: rc.target_snake,
                variant_id: null,
                min_prec_arg: Option::<i32>::Some(prec),
            });
        }
    }
    return se;
}

fn find_self_ref_rule_call(op: &Op, rule_name: &String) -> Option<&RuleCallOp> with stores[op] {
    if let RuleCall(rc) = op {
        if rc.target_name == *rule_name {
            return Option::<&RuleCallOp>::Some(rc);
        }
    }
    if let ListLabel(ll) = op {
        return find_self_ref_rule_call(&ll.inner, rule_name);
    }
    return null;
}

fn rebind_self_ref_min_prec(op: Op, prec: i32) -> Op {
    return match op {
        RuleCall(rc) => Op::RuleCall(RuleCallOp {
            target_name: rc.target_name,
            target_snake: rc.target_snake,
            variant_id: rc.variant_id,
            min_prec_arg: Option::<i32>::Some(prec),
            field: rc.field,
            dedup_base: rc.dedup_base,
        }),
        ListLabel(ll) => Op::ListLabel(ListLabelOp {
            field: ll.field,
            inner: rebind_self_ref_min_prec(ll.inner, prec),
            dedup_base: ll.dedup_base,
        }),
        other => other,
    };
}

/// Collect the union of every LR alt's `suffix_first` token set.
/// Used to decide whether a non-trailing self-ref must keep its
/// precedence so a shared delimiter binds at the right precedence.
fn collect_lr_suffix_first_tokens_from_lowered(lr_alts: &Array<LrAlt>) -> Array<String> {
    let mut result: Array<String> = [];
    for let lr of lr_alts {
        for let tk of &lr.suffix_first {
            if !first_set_contains(&result, tk) {
                result.push(*tk);
            }
        }
    }
    return result;
}

fn compute_self_ref_prec_from_ops(ops: &Array<Op>, k: i32, elem_idx: i32, last_self_ref_idx: i32, conflict_min: i32, lr_suffix_first_tokens: &Array<String>) -> i32 {
    let mut prec = conflict_min;
    if elem_idx != last_self_ref_idx && k + 1 < ops.len() {
        let next_op = &ops[k + 1];
        let mut next_is_lr_op = false;
        if let Token(t) = next_op {
            if first_set_contains(lr_suffix_first_tokens, &t.kind) {
                next_is_lr_op = true;
            }
        }
        if let Literal(l) = next_op {
            if first_set_contains(lr_suffix_first_tokens, &l.kind) {
                next_is_lr_op = true;
            }
        }
        if !next_is_lr_op {
            prec = 0;
        }
    }
    return prec;
}

/// Lower the atom side of an LR rule — the non-LR alternatives only.
/// Reuses `lower_multi_alt_rule`'s first-set + dispatch logic but
/// projects through `non_lr_indices` so the output's `alt_index`,
/// `case_name` / `struct_name` still match the ORIGINAL alt index in
/// the surface `rule.alternatives` list. emit relies on that
/// correspondence to look up case names from `header.case_names`.
fn lower_lr_atom(rule: &ParserRule, non_lr_indices: &Array<i32>, ctx: &mut GenContext, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>) -> MultiAltRule {
    let header = lower_header(rule);

    let mut first_sets: Array<Array<String>> = [];
    for let idx of non_lr_indices {
        let mut visiting: Array<String> = [];
        first_sets.push(ctx.first_of_alt(&rule.alternatives[*idx], &mut visiting));
    }

    let mut alts: Array<AltBody> = [];
    let mut scan_alts: Array<ScanBody> = [];
    for let idx of non_lr_indices {
        alts.push(lower_alt_body(&rule.alternatives[*idx], *idx, rule, ctx, variant_mask, variant_k_prefix_mask));
        scan_alts.push(lower_scan_body(&rule.alternatives[*idx], ctx, variant_mask, variant_k_prefix_mask));
    }

    let ctx_label = `LR rule '{rule.name}' atom`;
    let dispatch = build_overlap_dispatch(&ctx_label, &rule.alternatives, non_lr_indices, &first_sets, ctx);
    return MultiAltRule {
        header,
        alts,
        scan_alts,
        dispatch: clone_dispatch(&dispatch),
        scan_dispatch: dispatch,
    };
}

/// Lower a single LR alternative. Strips the leading self-ref and
/// lowers everything after it as the alt's suffix body. The
/// precedence (`own_prec`) and conflict floor (`conflict_min`) are
/// computed by the caller and stored verbatim.
fn lower_lr_alt(rule: &ParserRule, alt_idx: i32, own_prec: i32, conflict_min: i32, ctx: &mut GenContext, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>) -> LrAlt {
    let alt = &rule.alternatives[alt_idx];
    assert !alt.elements.is_empty(), `LR alt {alt_idx} of '{rule.name}' is empty — should not be classified LR`;

    // Build per-alt CST identifiers. `case_name` mirrors
    // `case_names_for_rule`, and `struct_name` follows the
    // `<RuleBase><CaseName>` convention the rest of `lower_alt_body`
    // uses. We don't reuse `lower_alt_body` directly because we need
    // the suffix elements (skipping the leading self-ref), not the
    // whole alt.
    let case_names = case_names_for_rule(&rule.alternatives);
    let type_name = rule_type_name(&rule.name);
    let base = strip_suffix(&type_name, &"Node");
    let case_name = case_names[alt_idx];
    let struct_name = `{base}{case_name}`;

    // Compute `last_self_ref_idx` — the index (within the original
    // alt's element list) of the LAST self-reference. -1 when the
    // only self-ref is the leading one. This drives emit's
    // "trailing self-ref drops back into the LR loop with the right
    // precedence" handling.
    let last_self_ref_idx = find_last_self_ref_idx(alt, &rule.name);

    // Suffix first-set drives the LR loop's per-iteration dispatch.
    let suffix_first = ctx.first_of_elements_from(&alt.elements, 1);

    // Lower the suffix (elements[1..]) as an AltBody / ScanBody.
    let suffix = lower_lr_alt_suffix(rule, alt_idx, &case_name, &struct_name, ctx, variant_mask, variant_k_prefix_mask);
    let scan_suffix = lower_lr_alt_scan_suffix(rule, alt_idx, ctx, variant_mask, variant_k_prefix_mask);

    return LrAlt {
        alt_index: alt_idx,
        case_name: case_name,
        struct_name: struct_name,
        suffix: suffix,
        scan_suffix: scan_suffix,
        own_prec: own_prec,
        conflict_min: conflict_min,
        last_self_ref_idx: last_self_ref_idx,
        suffix_first: suffix_first,
        right_associative: is_right_associative_alt(alt),
        prefix_self_ref: lr_prefix_field_decl(&alt.elements[0], &rule.name),
    };
}

fn lower_lr_alt_suffix(rule: &ParserRule, alt_idx: i32, case_name: &String, struct_name: &String, ctx: &mut GenContext, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>) -> AltBody {
    let alt = &rule.alternatives[alt_idx];

    // Per-alt counter starts at this alt's position in the rule's
    // alt_gc_starts table — same as `lower_alt_body` does for the
    // full-alt case. The suffix walk continues from there.
    let alt_gc_starts = compute_alt_gc_starts(&rule.alternatives);
    let mut group_counter: i32 = alt_gc_starts[alt_idx];

    // Seed the dedup counter with the prefix self-ref's field name so
    // a trailing self-ref dedups to `<name>_2` — matching the
    // surface-IR `collect_fields` walk that flat-walked all elements
    // together. Without this seed, a `e op e` suffix would produce two
    // ops both named `e` and the resulting CST struct would carry
    // duplicate fields.
    let prefix_field = lr_prefix_field_decl(&alt.elements[0], &rule.name);
    let mut name_counts: Array<[String, i32]> = [[prefix_field.name, 1]];
    let mut ops: Array<Op> = [];
    // Same per-element follow logic as `lower_alt_body`, but the
    // suffix starts at index 1 (index 0 is the stripped leading
    // self-ref).
    let outer_follow: Array<String> = [];
    for let mut i = 1; i < alt.elements.len(); i += 1 {
        let [elem_follow, position_mask] = ctx.compute_call_site_follow_and_mask(&alt.elements, i, variant_mask);
        let elem_k_prefix = ctx.compute_call_site_k_prefix_mask(
            &alt.elements,
            i,
            FOLLOW_VARIANT_MAX_K,
            variant_k_prefix_mask,
        );
        let elem_k_prefix_position_mask = ctx.compute_k_prefix_position_mask(&alt.elements, i, variant_k_prefix_mask);
        let mut op = lower_op(
            &alt.elements[i],
            &mut name_counts,
            &rule.name,
            ctx,
            &mut group_counter,
            &elem_follow,
            &elem_k_prefix,
            variant_mask,
            variant_k_prefix_mask,
            &position_mask,
            &elem_k_prefix_position_mask,
        );
        if let Repeat(rep_op) = &op {
            let basic_follow = ctx.first_of_elements_from(&alt.elements, i + 1);
            let basic_second = compute_caller_follow_second(&alt.elements, i + 1, ctx);
            op = Op::Repeat(patch_repeat_op_caller_follow(rep_op, basic_follow, basic_second));
        }
        ops.push(op);
    }

    let fields = enumerate_alt_field_decls(&ops);

    return AltBody {
        alt_index: alt_idx,
        case_name: *case_name,
        struct_name: *struct_name,
        ops: ops,
        fields: fields,
        prefix_self_ref_min_prec: 0,
    };
}

fn lower_lr_alt_scan_suffix(rule: &ParserRule, alt_idx: i32, ctx: &mut GenContext, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>) -> ScanBody {
    let alt = &rule.alternatives[alt_idx];
    let mut elements: Array<ScanElement> = [];
    // LR suffix walks `alt.elements[1..]` — the leading self-ref is
    // stripped. The end-of-suffix outer follow is left empty; threading
    // the LR rule's caller-side follow here would require an LR-variant
    // mechanism analogous to the non-LR follow variants, which no
    // committed grammar yet exercises.
    for let mut i = 1; i < alt.elements.len(); i += 1 {
        elements.push(lower_alt_scan_element(
            &alt.elements,
            i,
            ctx,
            variant_mask,
            variant_k_prefix_mask,
            &empty_k_prefix(),
        ));
    }
    return ScanBody { elements };
}

/// Index (within `alt.elements`) of the LAST self-reference to
/// `rule_name`. Returns `-1` when the leading-prefix self-ref is
/// the ONLY self-ref. Mirrors what emit needs to know about
/// trailing self-refs (`expr op expr` has a trailing one;
/// `expr '++' ` does not).
fn find_last_self_ref_idx(alt: &Alternative, rule_name: &String) -> i32 {
    let mut last: i32 = -1;
    // Index 0 is the leading prefix self-ref (already known to
    // exist for an LR alt); we count any self-ref at i >= 1 as
    // "internal".
    for let mut i = 1; i < alt.elements.len(); i += 1 {
        if element_is_self_ref(&alt.elements[i], rule_name) {
            last = i;
        }
    }
    return last;
}

/// True iff `alt` carries `<assoc=right>` in its options. Mirrors
/// `parser_gen::is_right_associative`.
fn is_right_associative_alt(alt: &Alternative) -> bool {
    for let opt of &alt.options {
        if opt.name != "assoc" {
            continue;
        }
        if let Ident(v) = &opt.value {
            if *v == "right" {
                return true;
            }
        }
    }
    return false;
}

/// Compute the conflict-floor `min_prec` for `alt`. Left-associative
/// alts use `own_prec + 1` as the floor (rejecting same-precedence
/// on the right operand); right-associative use `own_prec` (so
/// same-precedence nests rightward). Then widen the floor when a
/// strictly higher-precedence alt's suffix claims one of our suffix's
/// fixed tokens — see `parser_gen::compute_lr_conflict_min_prec` for
/// the rationale (essentially: avoid the higher-prec alt grabbing a
/// shared delimiter at the wrong precedence).
fn compute_lr_conflict_min_prec(alt: &Alternative, own_prec: i32, lr_indices: &Array<i32>, rule: &ParserRule, ctx: &mut GenContext, total_lr: i32) -> i32 {
    let mut min_prec: i32 = if is_right_associative_alt(alt) { own_prec } else { own_prec + 1 };

    let mut fixed_tokens: Array<String> = [];
    for let mut ei = 1; ei < alt.elements.len(); ei += 1 {
        let elem = &alt.elements[ei];
        match *elem {
            TokenRef(t) => fixed_tokens.push(`TK_{t.name}`),
            Literal(l) => fixed_tokens.push(literal_const_name(&l.text)),
            _ => {
            },
        }
    }
    if fixed_tokens.is_empty() {
        return min_prec;
    }

    let mut lr_pos: i32 = 0;
    for let lr_idx of lr_indices {
        let other = &rule.alternatives[*lr_idx];
        if other.elements.len() <= 1 {
            lr_pos += 1;
            continue;
        }
        let other_prec = total_lr - lr_pos;
        if other_prec <= own_prec {
            lr_pos += 1;
            continue;
        }
        let suffix_first = ctx.first_of_elements_from(&other.elements, 1);
        for let ft of &fixed_tokens {
            if first_set_contains(&suffix_first, ft) {
                let candidate = other_prec + 1;
                if candidate > min_prec {
                    min_prec = candidate;
                }
            }
        }
        lr_pos += 1;
    }
    return min_prec;
}

/// Build the LR loop's dispatch metadata. `valid_lr_alts` lists the
/// indices (into `lr_alts`) of alts whose suffix is non-empty —
/// degenerate `expr : expr` alts are filtered out. `groups` is the
/// overlap-group partition over those alts' `suffix_first` sets.
///
/// Phase 2.4 only handles the disjoint case (each group is a
/// singleton). Overlap groups land in Phase 2.3c.
fn compute_lr_dispatch_data(lr_alts: &Array<LrAlt>) -> LrDispatchData {
    let mut valid_lr_alts: Array<i32> = [];
    let mut suffix_first_sets: Array<Array<String>> = [];
    for let mut i = 0; i < lr_alts.len(); i += 1 {
        let lr = &lr_alts[i];
        if lr.suffix_first.is_empty() {
            continue;
        }
        valid_lr_alts.push(i);
        suffix_first_sets.push(lr.suffix_first);
    }

    // Overlap groups are tolerated here: emit's LR-suffix loop
    // resolves multi-alt groups via scan-dispatch on the suffix
    // (same scan-tournament pattern as the top-level `Tournament`
    // dispatch). The GIR carries the groups as-is; correctness
    // falls out of emit treating `group.len() > 1` as the cue to
    // generate a scan-and-commit cascade across the group's alts.
    let groups = compute_overlap_groups(&suffix_first_sets);

    return LrDispatchData {
        valid_lr_alts: valid_lr_alts,
        groups: groups,
    };
}

/// Union-find overlap grouping over per-alt first sets. Mirrors
/// `alt_grouping::compute_overlap_groups` — alts whose first sets
/// share at least one token end up in the same group; disjoint
/// alts get their own singleton group. The output's iteration order
/// matches the input order (first occurrence wins as group root).
fn compute_overlap_groups(first_sets: &Array<Array<String>>) -> Array<Array<i32>> {
    let n = first_sets.len();
    let mut group_ids: Array<i32> = [];
    for let mut i = 0; i < n; i += 1 {
        group_ids.push(i);
    }
    for let mut i = 0; i < n; i += 1 {
        for let mut j = i + 1; j < n; j += 1 {
            if first_sets_overlap(&first_sets[i], &first_sets[j]) {
                let gi = group_ids[i];
                let gj = group_ids[j];
                if gi != gj {
                    for let mut k = 0; k < n; k += 1 {
                        if group_ids[k] == gj {
                            group_ids[k] = gi;
                        }
                    }
                }
            }
        }
    }
    let mut seen_ids: Array<i32> = [];
    let mut groups: Array<Array<i32>> = [];
    for let mut i = 0; i < n; i += 1 {
        let gid = group_ids[i];
        let mut found: i32 = -1;
        for let mut s = 0; s < seen_ids.len(); s += 1 {
            if seen_ids[s] == gid {
                found = s;
                break;
            }
        }
        if found >= 0 {
            groups[found].push(i);
        } else {
            seen_ids.push(gid);
            groups.push([i]);
        }
    }
    return groups;
}

fn first_sets_overlap(a: &Array<String>, b: &Array<String>) -> bool {
    for let tk of a {
        if first_set_contains(b, tk) {
            return true;
        }
    }
    return false;
}

fn first_set_contains(set: &Array<String>, token: &String) -> bool {
    for let t of set {
        if *t == *token {
            return true;
        }
    }
    return false;
}

/// Build a `Direct` dispatch from disjoint first sets. Each branch
/// matches one alt's first set; emit translates the branch list into
/// an `if / else if` chain followed by an error fallback.
fn build_direct_dispatch(first_sets: &Array<Array<String>>) -> MultiAltDispatch {
    let mut branches: Array<DispatchBranch> = [];
    for let mut i = 0; i < first_sets.len(); i += 1 {
        branches.push(DispatchBranch {
            tokens: first_sets[i],
            alt_index: i,
        });
    }
    return MultiAltDispatch::Direct(DirectDispatch { branches });
}

fn clone_dispatch(d: &MultiAltDispatch) -> MultiAltDispatch {
    return match d {
        Direct(dd) => MultiAltDispatch::Direct(DirectDispatch { branches: dd.branches }),
        Tournament(td) => MultiAltDispatch::Tournament(TournamentDispatch { alts: td.alts }),
    };
}

/// Choose a dispatch for a set of alternatives. When the per-alt
/// first sets are pairwise disjoint, falls through to a token-led
/// `Direct` dispatch. Otherwise (any two alts share a first token),
/// requires every alt to be fully scannable and falls back to a
/// scan-side `Tournament` dispatch sorted by element count
/// descending — emit runs each scan helper and commits to the
/// longest match. ANTLR4's longest-match LL choice, no backtracking.
///
/// `ctx_name` is the human-readable owner used in the panic message
/// for unscannable alts (`"rule 'expr'"`, `"SimpleCst group"`, …).
/// `alts` is the underlying surface alternative list; `indices`
/// selects which alts participate in this dispatch.
fn build_overlap_dispatch(ctx_name: &String, alts: &Array<Alternative>, indices: &Array<i32>, first_sets: &Array<Array<String>>, ctx: &mut GenContext) -> MultiAltDispatch {
    if !any_overlap(first_sets) {
        let mut branches: Array<DispatchBranch> = [];
        for let mut k = 0; k < indices.len(); k += 1 {
            branches.push(DispatchBranch {
                tokens: first_sets[k],
                alt_index: indices[k],
            });
        }
        return MultiAltDispatch::Direct(DirectDispatch { branches });
    }

    for let idx of indices {
        let mut visiting: Array<String> = [];
        assert ctx.is_alt_scannable(&alts[*idx].elements, &mut visiting), `{*ctx_name}: alt {*idx} is not fully scannable; Tournament dispatch needs all alts scannable`;
    }

    let mut sorted: Array<i32> = [];
    for let idx of indices {
        sorted.push(*idx);
    }
    sort_alts_by_element_count(&mut sorted, alts);
    return MultiAltDispatch::Tournament(TournamentDispatch { alts: sorted });
}

/// True iff any pair of first-sets shares at least one token.
fn any_overlap(first_sets: &Array<Array<String>>) -> bool {
    for let mut i = 0; i < first_sets.len(); i += 1 {
        for let mut j = i + 1; j < first_sets.len(); j += 1 {
            if first_sets_overlap(&first_sets[i], &first_sets[j]) {
                return true;
            }
        }
    }
    return false;
}

/// Sort `indices` by descending number of MANDATORY-leading-elements,
/// with ties broken by `alt_sort_priority` and finally source order.
/// Mirrors `alt_grouping::sort_group_by_element_count` for the
/// tournament-style dispatch.
fn sort_alts_by_element_count(indices: &mut Array<i32>, alts: &Array<Alternative>) {
    for let mut i = 0; i < indices.len(); i += 1 {
        for let mut j = i + 1; j < indices.len(); j += 1 {
            let pi = alt_sort_priority(&alts[indices[i]]);
            let pj = alt_sort_priority(&alts[indices[j]]);
            let mut swap = false;
            if pj > pi {
                swap = true;
            } else if pj == pi {
                if alts[indices[j]].elements.len() > alts[indices[i]].elements.len() {
                    swap = true;
                }
            }
            if swap {
                let tmp = indices[i];
                indices[i] = indices[j];
                indices[j] = tmp;
            }
        }
    }
}

/// Per-alt sorting priority, mirroring `alt_grouping::alt_sort_priority`.
/// Higher = preferred at dispatch time. Single-element alts whose
/// only element is a `RuleRef` get a higher tier than multi-element
/// `RuleRef`-led alts so SQLite-style `tor (',' tor)* | join_clause`
/// groupings still pick the rule-ref catch-all on tie.
///
/// Skips leading nullable elements so the classification matches on the
/// first element that actually contributes to FIRST — `b? K_TOKEN_X` gets
/// `MULTI_TOKEN_LED` (4) rather than `MULTI_RULE_REF_LED` (2).
fn alt_sort_priority(alt: &Alternative) -> i32 {
    if alt.elements.len() == 1 {
        if let RuleRef(_) = alt.elements[0] {
            return 3;
        }
        return 1;
    }
    for let elem of &alt.elements {
        if is_nullable(elem) {
            continue;
        }
        match *elem {
            TokenRef(_) | Literal(_) => {
                return 4;
            },
            _ => {
                return 2;
            },
        }
    }
    return 2;
}

/// Whether the rule has at least one directly-left-recursive
/// alternative. Mirrors `parser_gen::is_left_recursive`'s shallow
/// first-element check (ANTLR4 only rewrites direct LR; deep LR is
/// out of contract — see `vendor/antlr4/doc/left-recursion.md`).
fn has_left_recursive_alt(rule: &ParserRule) -> bool {
    for let alt of &rule.alternatives {
        if alt_is_left_recursive(alt, &rule.name) {
            return true;
        }
    }
    return false;
}

/// FieldDecl for the leading self-reference element of an LR alt
/// (the element ANTLR4's left-recursion rewrite strips from the parse
/// path). The element is constrained by `alt_is_left_recursive` to a
/// RuleRef self-ref, possibly wrapped in a Label; we mirror the
/// surface-IR `element_to_field` shape so emit's CST struct lays out
/// the same field as before the GIR migration.
fn lr_prefix_field_decl(elem: &Element, rule_name: &String) -> FieldDecl {
    let type_str = rule_type_name(rule_name);
    return match *elem {
        RuleRef(r) => FieldDecl {
            name: r.field_name,
            type_str: type_str,
            kind: FieldKind::Plain,
        },
        Label(lab) => {
            let inner_type = if lab.list { `Array<{type_str}>` } else { type_str };
            let kind = if lab.list { FieldKind::List } else { FieldKind::Plain };
            FieldDecl { name: lab.field_name, type_str: inner_type, kind: kind };
        },
        _ => panic("lr_prefix_field_decl: LR alt's first element must be a self-ref RuleRef (possibly labeled)"),
    };
}

fn alt_is_left_recursive(alt: &Alternative, rule_name: &String) -> bool {
    if alt.elements.is_empty() {
        return false;
    }
    return element_is_self_ref(&alt.elements[0], rule_name);
}

fn element_is_self_ref(elem: &Element, rule_name: &String) -> bool {
    return match *elem {
        RuleRef(r) => r.name == *rule_name,
        Label(lab) => element_is_self_ref(&lab.element, rule_name),
        _ => false,
    };
}

/// Lower the scan-side body for an alternative — the structural
/// twin of `lower_alt_body` for the `scan_<rule>` predicate
/// emission. Covers every shape `lower_op` handles: leaf ops, scalar
/// `Label` rebinds, `Repeat` (greedy / non-greedy / Optional with
/// follow propagation), and every `Group` shape
/// (`Transparent` / `SingleAlt` / `TokenOnly` / `SimpleCst` /
/// `General`).
///
/// The scan side has no field bindings, no struct construction, and
/// no name dedup — it only produces a token-stream walk that
/// returns the new `pos`.
fn lower_scan_body(alt: &Alternative, ctx: &mut GenContext, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>) -> ScanBody {
    let mut elements: Array<ScanElement> = [];
    for let mut i = 0; i < alt.elements.len(); i += 1 {
        elements.push(lower_alt_scan_element(
            &alt.elements,
            i,
            ctx,
            variant_mask,
            variant_k_prefix_mask,
            &empty_k_prefix(),
        ));
    }
    return ScanBody { elements };
}

fn lower_scan_element(elem: &Element, ctx: &mut GenContext, outer_follow: &Array<String>, outer_k_prefix: &Array<Array<String>>, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>, outer_k_prefix_position_mask: &Array<Array<String>>) -> ScanElement {
    return match *elem {
        TokenRef(t) => ScanElement::Token(ScanTokenElem { kind: `TK_{t.name}` }),
        Literal(l) => ScanElement::Token(ScanTokenElem {
            kind: literal_const_name(&l.text),
        }),
        RuleRef(r) => ScanElement::RuleCall(ScanRuleCallElem {
            target_snake: r.snake_name,
            variant_id: ctx.intern_follow_variant(&r.name, outer_follow, outer_k_prefix, true),
            min_prec_arg: null,
        }),
        Wildcard(_) => ScanElement::Wildcard,
        Not(ne) => ScanElement::Excluded(ScanExcludedElem {
            kinds: collect_excluded_kinds(&ne.element),
        }),
        Label(lab) => lower_scan_element(
            &lab.element,
            ctx,
            outer_follow,
            outer_k_prefix,
            variant_mask,
            variant_k_prefix_mask,
            outer_k_prefix_position_mask,
        ),
        Repeat(rep) => lower_scan_repeat(
            &rep,
            ctx,
            outer_follow,
            variant_mask,
            variant_k_prefix_mask,
            outer_k_prefix_position_mask,
        ),
        Group(g) => lower_scan_group(
            &g,
            ctx,
            outer_follow,
            variant_mask,
            variant_k_prefix_mask,
            outer_k_prefix_position_mask,
        ),
    };
}

/// Scan-side twin of `lower_group_op`. The scan side has no struct
/// construction, so the shape distinction matters only for the
/// dispatch step: single-alt groups have no dispatch (one body run
/// unconditionally / wrapped in a one-alt `ScanGroupElem`), while
/// multi-alt token-only groups dispatch on token kind.
fn lower_scan_group(g: &GroupElement, ctx: &mut GenContext, outer_follow: &Array<String>, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>, outer_k_prefix_position_mask: &Array<Array<String>>) -> ScanElement {
    let alts = &g.alternatives;
    assert alts.len() > 0, "Group with no alts is not a valid scan-lowering input";
    if alts.len() == 1 {
        let alt = &alts[0];
        assert alt.elements.len() > 0, "Group with empty alt is not a valid scan-lowering input";
        if alt.elements.len() == 1 {
            // Transparent (scan side) — nested inner allowed. The
            // group's only element inherits the surrounding follow.
            return lower_scan_element(
                &alt.elements[0],
                ctx,
                outer_follow,
                &empty_k_prefix(),
                variant_mask,
                variant_k_prefix_mask,
                &empty_k_prefix(),
            );
        }
        // Single-alt (scan side) — nested elements allowed; each
        // is lowered through the standard scan-element recursion.
        let mut elements: Array<ScanElement> = [];
        for let mut i = 0; i < alt.elements.len(); i += 1 {
            elements.push(lower_alt_scan_element(
                &alt.elements,
                i,
                ctx,
                variant_mask,
                variant_k_prefix_mask,
                &empty_k_prefix(),
            ));
        }
        let mut visiting: Array<String> = [];
        let alt_first = ctx.first_of_alt(alt, &mut visiting);
        let mut wildcard_indices: Array<i32> = [];
        if alt_is_wildcard_led(alt) {
            wildcard_indices.push(0);
        }
        return ScanElement::Group(ScanGroupElem {
            alts: [ScanBody { elements }],
            dispatch: empty_direct_dispatch(),
            lenient: false,
            alt_first_sets: [alt_first],
            wildcard_alt_indices: wildcard_indices,
        });
    }
    if is_token_only_group(alts) {
        let mut bodies: Array<ScanBody> = [];
        let mut first_sets: Array<Array<String>> = [];
        for let alt of alts {
            let elem = &alt.elements[0];
            bodies.push(ScanBody { elements: [
                lower_scan_element(
                    elem,
                    ctx,
                    outer_follow,
                    &empty_k_prefix(),
                    variant_mask,
                    variant_k_prefix_mask,
                    &empty_k_prefix(),
                ),
            ] });
            first_sets.push([token_only_kind(elem)]);
        }
        return ScanElement::Group(ScanGroupElem {
            alts: bodies,
            dispatch: build_direct_dispatch(&first_sets),
            lenient: false,
            alt_first_sets: first_sets,
            wildcard_alt_indices: ([] as Array<i32>),
        });
    }
    if is_simple_cst_group(alts) {
        return lower_simple_cst_scan_group(alts, ctx, outer_follow, variant_mask, variant_k_prefix_mask);
    }
    if is_general_group(alts) {
        return lower_general_scan_group(alts, ctx, outer_follow, variant_mask, variant_k_prefix_mask, &empty_k_prefix());
    }
    panic("Group shape (scan side) unrecognised by classifier");
}

fn lower_general_scan_group(alts: &Array<Alternative>, ctx: &mut GenContext, outer_follow: &Array<String>, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>, outer_k_prefix_position_mask: &Array<Array<String>>) -> ScanElement {
    let mut bodies: Array<ScanBody> = [];
    let mut first_sets: Array<Array<String>> = [];
    let mut all_indices: Array<i32> = [];
    for let mut ai = 0; ai < alts.len(); ai += 1 {
        let alt = &alts[ai];
        let mut elements: Array<ScanElement> = [];
        for let mut i = 0; i < alt.elements.len(); i += 1 {
            elements.push(lower_alt_scan_element(
                &alt.elements,
                i,
                ctx,
                variant_mask,
                variant_k_prefix_mask,
                &empty_k_prefix(),
            ));
        }
        bodies.push(ScanBody { elements });
        let mut visiting: Array<String> = [];
        first_sets.push(ctx.first_of_alt(alt, &mut visiting));
        all_indices.push(ai);
    }
    let dispatch = build_overlap_dispatch(&"General group (scan)", alts, &all_indices, &first_sets, ctx);
    let mut wildcard_indices: Array<i32> = [];
    for let mut ai = 0; ai < alts.len(); ai += 1 {
        if alt_is_wildcard_led(&alts[ai]) {
            wildcard_indices.push(ai);
        }
    }
    return ScanElement::Group(ScanGroupElem {
        alts: bodies,
        dispatch: dispatch,
        lenient: true,
        alt_first_sets: first_sets,
        wildcard_alt_indices: wildcard_indices,
    });
}

/// Scan-side twin of `lower_repeat_op`. Same restrictions: greedy
/// `Star` / `Plus` with a leaf inner only.
fn lower_scan_repeat(rep: &RepeatElement, ctx: &mut GenContext, outer_follow: &Array<String>, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>, outer_k_prefix_position_mask: &Array<Array<String>>) -> ScanElement {
    // Greedy Optional + Group inner with nested optional sub-elements
    // is the shape-based-lookahead case: lower produces
    // `ScanElement::OptionalLookahead` so emit reads per-shape sigs
    // instead of running a regular scan-repeat (which would fire on
    // the first leading token without disambiguating the inner
    // optional shape, breaking `( (a)? b )?`-style cases).
    if !rep.non_greedy {
        if let Optional = rep.kind {
            if let Group(g) = rep.element {
                if g.alternatives.len() == 1 && has_nested_optional_in_alt(&g.alternatives[0]) {
                    return lower_scan_optional_lookahead_group(
                        &g.alternatives[0],
                        ctx,
                        outer_follow,
                        variant_mask,
                        variant_k_prefix_mask,
                    );
                }
            }
        }
    }

    let mut inner_visiting: Array<String> = [];
    let inner_first = ctx.first_of_element(&rep.element, &mut inner_visiting);

    // Scan-side ignores `rep.non_greedy` because the existing surface
    // emit (`gen_scan_repeat_body`) also ignores it — both greedy and
    // non-greedy Repeats lower to the same `while peek ∈ inner_first`
    // loop with `pos = sp; break` on 0-advance / failure. The scan
    // result has been correct in practice on every committed grammar:
    // when the loop overshoots, the parse side's longest-match scan
    // tournament picks a shorter prefix instead. If we ever encounter
    // a grammar where the scan-side fixed-point really needs 2-token
    // disambiguation to distinguish `(',' a)*?` from `(',' b)*`, the
    // `NonGreedyStrategy` infrastructure on the parse side (carrying
    // `exit_second`) is the natural foundation to restore here.
    let strategy = choose_greedy_scan_repeat_strategy(&inner_first, variant_mask);

    let iter_follow = union_kind_arrays(&inner_first, outer_follow);

    let body = lower_scan_element(
        &rep.element,
        ctx,
        &iter_follow,
        &empty_k_prefix(),
        variant_mask,
        variant_k_prefix_mask,
        &empty_k_prefix(),
    );
    return ScanElement::Repeat(ScanRepeatElem {
        kind: rep.kind,
        body,
        strategy: strategy,
        inner_first: inner_first,
        caller_follow_first: *outer_follow,
        k_prefix_mask: *outer_k_prefix_position_mask,
    });
}

/// Rebuild a top-level `ScanElement::Repeat` with a fresh
/// `caller_follow_first`. No-op for non-Repeat elements. Used by
/// alt-level scan walkers (`lower_scan_body`,
/// `lower_lr_alt_scan_suffix`, per-shape walks inside groups) to
/// override the default that `lower_scan_repeat` seeded with
/// `outer_follow`, matching the parse-side `RepeatOp` post-pass.
fn rebind_scan_repeat_caller_follow(se: ScanElement, caller_follow_first: Array<String>) -> ScanElement {
    if let Repeat(re) = se {
        return ScanElement::Repeat(ScanRepeatElem {
            kind: re.kind,
            body: re.body,
            strategy: re.strategy,
            inner_first: re.inner_first,
            caller_follow_first: caller_follow_first,
            k_prefix_mask: re.k_prefix_mask,
        });
    }
    return se;
}

/// Lower one element of `alt_elements` at index `i` to a `ScanElement`,
/// then run the alt-level post-pass: if the result is a top-level
/// Repeat, rebind its `caller_follow_first` to
/// `first_of_elements_from(alt_elements, i + 1)`. Mirrors the parse-
/// side `RepeatOp` post-pass; used by every scan-only alt walker
/// (`lower_scan_body`, `lower_lr_alt_scan_suffix`, the single-alt
/// branch of `lower_scan_group`, `lower_general_scan_group`). Walks
/// that emit parse-side ops alongside scan elements (`lower_single_alt_group`,
/// `lower_general_group`) inline the post-pass so they can share
/// `basic_follow` with the parse-side rebind.
fn lower_alt_scan_element(alt_elements: &Array<Element>, i: i32, ctx: &mut GenContext, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>, outer_k_prefix_position_mask: &Array<Array<String>>) -> ScanElement {
    let elem_follow = ctx.compute_call_site_follow(alt_elements, i, variant_mask);
    // Compute the same per-position K-prefix the parse-side uses so
    // both sides register the same variant key — without this the
    // scan-side would intern a separate variant with an empty
    // K-prefix mask and the parse-side variant body's references to
    // `scan_X__follow_<id>_*` would dangle.
    let elem_k_prefix = ctx.compute_call_site_k_prefix_mask(
        alt_elements,
        i,
        FOLLOW_VARIANT_MAX_K,
        variant_k_prefix_mask,
    );
    // K-prefix position mask: variant's k_prefix_mask propagates into
    // this element when the suffix at i+1 is deep-nullable, mirroring
    // the parse-side `compute_k_prefix_position_mask`. Without this,
    // `ScanRepeatElem.k_prefix_mask` stays empty and the scan-side
    // K-prefix gate at `gen_scan_op_repeat` is never emitted — the
    // scan tournament then over-counts the iter and rejects the alt
    // that parse-side's gated variant body would have accepted.
    let elem_k_prefix_position_mask = ctx.compute_k_prefix_position_mask(alt_elements, i, variant_k_prefix_mask);
    let mut se = lower_scan_element(
        &alt_elements[i],
        ctx,
        &elem_follow,
        &elem_k_prefix,
        variant_mask,
        variant_k_prefix_mask,
        &elem_k_prefix_position_mask,
    );
    if let Repeat(_) = &se {
        let basic_follow = ctx.first_of_elements_from(alt_elements, i + 1);
        se = rebind_scan_repeat_caller_follow(se, basic_follow);
    }
    return se;
}

/// True iff any element in the alt is an Optional Repeat (possibly
/// wrapped in a `Label`). Drives the scan-side OptionalLookahead
/// trigger via `surface_is_optional_repeat`.
fn has_nested_optional_in_alt(alt: &Alternative) -> bool {
    for let elem of &alt.elements {
        if surface_is_optional_repeat(elem) {
            return true;
        }
    }
    return false;
}

fn surface_is_optional_repeat(elem: &Element) -> bool {
    if let Repeat(rep) = elem {
        if let Optional = rep.kind {
            return true;
        }
    }
    if let Label(lab) = elem {
        return surface_is_optional_repeat(&lab.element);
    }
    return false;
}

/// Lower an Optional Group with nested optionals to
/// `ScanElement::OptionalLookahead`. Enumerates 2^n shape
/// combinations (where n is the number of optional sub-elements),
/// computes per-shape lookahead signatures, and lowers each shape's
/// scan body separately (the optional sub-elements that are "on"
/// in this shape, unwrapped from their Optional Repeat wrappers,
/// plus the corresponding inner Group flattening when applicable).
fn lower_scan_optional_lookahead_group(alt: &Alternative, ctx: &mut GenContext, outer_follow: &Array<String>, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>) -> ScanElement {
    let shapes = compute_shapes_for_alt(&alt.elements);
    let mut sigs: Array<Array<Array<String>>> = [];
    let mut bodies: Array<ScanBody> = [];
    for let shape of &shapes {
        sigs.push(shape_lookahead_signature_for_alt(shape, &alt.elements, ctx));
        bodies.push(lower_scan_shape_body(shape, &alt.elements, ctx, variant_mask, variant_k_prefix_mask));
    }
    return ScanElement::OptionalLookahead(ScanOptionalLookaheadElem {
        sigs: sigs,
        bodies: bodies,
    });
}

/// Lower a single shape's scan body. Mirrors surface
/// `gen_scan_optional_with_lookahead`'s per-shape inner loop: for
/// each selected position, unwrap the optional, and if the unwrapped
/// is a single-alt Group, flatten its inner elements into the scan
/// body directly. Otherwise lower the unwrapped element.
fn lower_scan_shape_body(shape: &Array<i32>, elements: &Array<Element>, ctx: &mut GenContext, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>) -> ScanBody {
    let mut body_elems: Array<ScanElement> = [];
    for let mut k = 0; k < shape.len(); k += 1 {
        let idx = shape[k];
        let actual = surface_unwrap_optional(&elements[idx]);
        // Empty follow at lower time — the shape body is consumed
        // as a labeled block, and emit handles per-position fail via
        // `break <shape_label>;`. Per-element follow within the
        // shape doesn't affect the scan emit.
        let empty_follow: Array<String> = [];
        if let Group(g) = actual {
            if g.alternatives.len() == 1 {
                for let mut j = 0; j < g.alternatives[0].elements.len(); j += 1 {
                    body_elems.push(
                        lower_scan_element(
                            &g.alternatives[0].elements[j],
                            ctx,
                            &empty_follow,
                            &empty_k_prefix(),
                            variant_mask,
                            variant_k_prefix_mask,
                            &empty_k_prefix(),
                        ),
                    );
                }
                continue;
            }
        }
        body_elems.push(lower_scan_element(
            actual,
            ctx,
            &empty_follow,
            &empty_k_prefix(),
            variant_mask,
            variant_k_prefix_mask,
            &empty_k_prefix(),
        ));
    }
    return ScanBody { elements: body_elems };
}

fn surface_unwrap_optional(elem: &Element) -> &Element with stores[elem] {
    if let Repeat(rep) = elem {
        if let Optional = rep.kind {
            return &rep.element;
        }
    }
    if let Label(lab) = elem {
        return surface_unwrap_optional(&lab.element);
    }
    return elem;
}

/// Enumerate 2^n shape combinations of optional sub-elements in an
/// alt. Mirrors `parser_gen::compute_shapes`: bit-mask from
/// `(2^n - 1)` down to 0; higher bits = more optionals included =
/// longer shape = tried first.
pub fn compute_shapes_for_alt(elements: &Array<Element>) -> Array<Array<i32>> {
    let mut opt_indices: Array<i32> = [];
    for let mut i = 0; i < elements.len(); i += 1 {
        if is_nullable(&elements[i]) {
            opt_indices.push(i);
        }
    }
    let n = opt_indices.len();
    let mut shapes: Array<Array<i32>> = [];
    let total = 1 << n;
    for let mut mask = total - 1; mask >= 0; mask -= 1 {
        let mut shape: Array<i32> = [];
        for let mut i = 0; i < elements.len(); i += 1 {
            let mut is_opt = false;
            let mut opt_bit = -1;
            for let mut j = 0; j < opt_indices.len(); j += 1 {
                if opt_indices[j] == i {
                    is_opt = true;
                    opt_bit = j;
                }
            }
            if is_opt {
                if mask >> opt_bit & 1 == 1 {
                    shape.push(i);
                }
            } else {
                shape.push(i);
            }
        }
        shapes.push(shape);
    }
    return shapes;
}

/// Per-shape lookahead signature: for each element in the shape (in
/// the shape's selection order), compute the per-position first set.
/// Mirrors `parser_gen::shape_lookahead_signature`.
pub fn shape_lookahead_signature_for_alt(shape: &Array<i32>, elements: &Array<Element>, ctx: &mut GenContext) -> Array<Array<String>> {
    let mut sig: Array<Array<String>> = [];
    for let mut si = 0; si < shape.len(); si += 1 {
        let idx = shape[si];
        let actual = surface_unwrap_optional(&elements[idx]);
        if let Group(g) = actual {
            if g.alternatives.len() == 1 {
                for let mut j = 0; j < g.alternatives[0].elements.len(); j += 1 {
                    let mut visiting: Array<String> = [];
                    sig.push(ctx.first_of_element(&g.alternatives[0].elements[j], &mut visiting));
                }
                continue;
            }
        }
        let mut visiting: Array<String> = [];
        sig.push(ctx.first_of_element(actual, &mut visiting));
    }
    return sig;
}

/// Build the `RuleHeader` shared by every `Rule` variant. The cached
/// snake/field names on `ParserRule` are reused so we don't recompute
/// `to_snake_case`. `case_names` is derived from the alternative list
/// with the same helper `parser_gen.wado` uses.
fn lower_header(rule: &ParserRule) -> RuleHeader {
    return RuleHeader {
        name: rule.name,
        snake_name: rule.snake_name,
        field_name: rule.field_name,
        type_name: rule_type_name(&rule.name),
        visibility: rule.visibility,
        variant_of: null,
        case_names: case_names_for_rule(&rule.alternatives),
    };
}

/// Cumulative `general_group` counter starts per alternative.
/// Each alt records the running counter at its start, then
/// `count_general_groups(&alt.elements)` advances it for the next
/// alt. Consumed locally by `lower_lr_alt_suffix` and `lower_alt_body`
/// to seed each alt's local `group_counter` mutable; lower's
/// `lower_general_group` then assigns `GeneralShape.group_index` from
/// the bumped counter and emit reads `gs.group_index` directly off
/// the lowered IR.
fn compute_alt_gc_starts(alternatives: &Array<Alternative>) -> Array<i32> {
    let mut starts: Array<i32> = [];
    let mut running: i32 = 0;
    for let alt of alternatives {
        starts.push(running);
        running += count_general_groups(&alt.elements);
    }
    return starts;
}

/// Lower one alternative body. For a single-alt rule the rule's own
/// struct is the alt's struct (`case_name` empty, `struct_name`
/// is the rule's CST type name). For a multi-alt rule the alt
/// gets a per-alt case + struct name derived from
/// `case_names_for_rule` and the convention `<RuleBase><CaseName>`
/// (`<RuleBase>` being `rule_type_name(rule.name)` with the trailing
/// `Node` stripped — same as `parser_gen::gen_alt_body` callers).
fn lower_alt_body(alt: &Alternative, idx: i32, rule: &ParserRule, ctx: &mut GenContext, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>) -> AltBody {
    let type_name = rule_type_name(&rule.name);
    let mut case_name: String = "";
    let mut struct_name: String = type_name;
    if rule.alternatives.len() != 1 {
        let case_names = case_names_for_rule(&rule.alternatives);
        let base = strip_suffix(&type_name, &"Node");
        case_name = case_names[idx];
        struct_name = `{base}{case_names[idx]}`;
    }

    // The general-group counter is per-rule but its starting value
    // for this alt is fixed by `compute_alt_gc_starts`, so init from
    // there. Each general group encountered while lowering bumps it
    // by 1; the final value is consumed by `lower_general_group` to
    // assign `GeneralShape.group_index`, which emit reads directly
    // off the lowered IR.
    let alt_gc_starts = compute_alt_gc_starts(&rule.alternatives);
    let mut group_counter: i32 = alt_gc_starts[idx];

    let mut name_counts: Array<[String, i32]> = [];
    let mut ops: Array<Op> = [];
    // Per-element follow within the alt: tokens that can appear
    // immediately after this element in the alt. For the last
    // element, the follow is empty (the rule's own follow is the
    // surrounding caller's concern, threaded via Phase 2.6 variant
    // masks rather than this local computation).
    let outer_follow: Array<String> = [];
    for let mut i = 0; i < alt.elements.len(); i += 1 {
        let elem = &alt.elements[i];
        let [elem_follow, position_mask] = ctx.compute_call_site_follow_and_mask(&alt.elements, i, variant_mask);
        let elem_k_prefix = ctx.compute_call_site_k_prefix_mask(
            &alt.elements,
            i,
            FOLLOW_VARIANT_MAX_K,
            variant_k_prefix_mask,
        );
        let elem_k_prefix_position_mask = ctx.compute_k_prefix_position_mask(&alt.elements, i, variant_k_prefix_mask);
        let mut op = lower_op(
            elem,
            &mut name_counts,
            &rule.name,
            ctx,
            &mut group_counter,
            &elem_follow,
            &elem_k_prefix,
            variant_mask,
            variant_k_prefix_mask,
            &position_mask,
            &elem_k_prefix_position_mask,
        );
        // For Repeat ops, replace `caller_follow_first` with the basic
        // first set of the surrounding suffix. `compute_call_site_follow_and_mask`
        // returns the variant-interning follow (which considers deep-nullable
        // suffixes via the threaded `variant_mask`); emit's per-position
        // `gen_repeat*` decisions use the simpler `first_of_elements_from`.
        if let Repeat(rep_op) = &op {
            let basic_follow = ctx.first_of_elements_from(&alt.elements, i + 1);
            let basic_second = compute_caller_follow_second(&alt.elements, i + 1, ctx);
            op = Op::Repeat(patch_repeat_op_caller_follow(rep_op, basic_follow, basic_second));
        }
        ops.push(op);
    }

    // For prefix LR alts (e.g. `'-' e` in `e : e '+' e | '-' e | …`),
    // stamp the trailing self-ref RuleCall's `min_prec_arg` so emit
    // doesn't need to thread the prec value through `ctx`. The
    // surrounding alt walker (`gen_op_leaf`) reads
    // `RuleCallOp.min_prec_arg` directly.
    let prefix_prec = compute_prefix_self_ref_min_prec(rule, idx);
    if prefix_prec > 0 && !ops.is_empty() {
        let last_idx = ops.len() - 1;
        if let Some(_) = find_self_ref_rule_call(&ops[last_idx], &rule.name) {
            ops[last_idx] = rebind_self_ref_min_prec(ops[last_idx], prefix_prec);
        }
    }

    let fields = enumerate_alt_field_decls(&ops);

    return AltBody {
        alt_index: idx,
        case_name,
        struct_name,
        ops,
        fields,
        prefix_self_ref_min_prec: prefix_prec,
    };
}

/// Lower a single surface `Element` to a GIR `Op`. `rule_name` is
/// the enclosing rule's name, threaded through so nested
/// `SingleAlt` / `General` groups can fill in their `owner_rule`
/// slot (the rule whose monomorph table the group's struct names
/// live under). Phase 2.1 covers the trivial leaf elements; the
/// remaining shapes panic with their own `TODO Phase 2.x` markers
/// so a half-lowered alt body can't quietly reach codegen.
fn lower_op(elem: &Element, name_counts: &mut Array<[String, i32]>, rule_name: &String, ctx: &mut GenContext, group_counter: &mut i32, outer_follow: &Array<String>, outer_k_prefix: &Array<Array<String>>, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>, outer_position_mask: &Array<String>, outer_k_prefix_position_mask: &Array<Array<String>>) -> Op {
    return match *elem {
        TokenRef(t) => Op::Token(TokenOp {
            kind: `TK_{t.name}`,
            field: dedup_name(&t.field_name, name_counts),
            dedup_base: t.field_name,
        }),
        Literal(l) => {
            let base = literal_field_name(&l.text);
            Op::Literal(LiteralOp {
                kind: literal_const_name(&l.text),
                field: dedup_name(&base, name_counts),
                dedup_base: base,
            });
        },
        RuleRef(r) => Op::RuleCall(RuleCallOp {
            target_name: r.name,
            target_snake: r.snake_name,
            variant_id: ctx.intern_follow_variant(&r.name, outer_follow, outer_k_prefix, false),
            min_prec_arg: null,
            field: dedup_name(&r.field_name, name_counts),
            dedup_base: r.field_name,
        }),
        Wildcard(_) => Op::Wildcard(WildcardOp {
            field: dedup_name(&"wildcard", name_counts),
            dedup_base: "wildcard",
        }),
        Not(ne) => {
            let base = not_element_field_name(&ne.element);
            Op::Excluded(ExcludedOp {
                kinds: collect_excluded_kinds(&ne.element),
                field: dedup_name(&base, name_counts),
                dedup_base: base,
            });
        },
        Repeat(rep) => lower_repeat_op(
            &rep,
            name_counts,
            rule_name,
            ctx,
            group_counter,
            outer_follow,
            variant_mask,
            variant_k_prefix_mask,
            outer_position_mask,
            outer_k_prefix_position_mask,
        ),
        Group(g) => lower_group_op(
            &g,
            name_counts,
            rule_name,
            ctx,
            group_counter,
            outer_follow,
            outer_k_prefix,
            variant_mask,
            variant_k_prefix_mask,
            outer_position_mask,
            outer_k_prefix_position_mask,
        ),
        Label(lab) => lower_label_op(
            &lab,
            name_counts,
            rule_name,
            ctx,
            group_counter,
            outer_follow,
            outer_k_prefix,
            variant_mask,
            variant_k_prefix_mask,
            outer_position_mask,
            outer_k_prefix_position_mask,
        ),
    };
}

/// Lower a `Group` element. Phase 2.x.transparent only handles the
/// trivial wrapping shape — a single alt containing exactly one
/// leaf element (e.g. `(INT)`). The wrapping is purely syntactic;
/// the inner element runs unconditionally with the surrounding
/// alt's binding scope, so the inner Op is lowered against the same
/// `name_counts` and the resulting `GroupOp` carries
/// `GroupShape::Transparent`.
///
/// Storable shapes (`SingleAlt`, `TokenOnly`, `SimpleCst`,
/// `General`) and multi-element Transparent groups land in their
/// own follow-up sub-phases:
///
/// * Phase 2.x.singlealt — single alt with ≥ 2 elements →
///   `GroupShape::SingleAlt` (struct of its own)
/// * Phase 2.x.tokenonly — every alt a single Token / Literal →
///   `GroupShape::TokenOnly`
/// * Phase 2.x.simplecst — every alt a single distinct RuleRef →
///   `GroupShape::SimpleCst`
/// * Phase 2.x.general — multi-alt non-trivial → `GroupShape::General`
fn lower_group_op(g: &GroupElement, name_counts: &mut Array<[String, i32]>, rule_name: &String, ctx: &mut GenContext, group_counter: &mut i32, outer_follow: &Array<String>, outer_k_prefix: &Array<Array<String>>, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>, outer_position_mask: &Array<String>, outer_k_prefix_position_mask: &Array<Array<String>>) -> Op {
    let alts = &g.alternatives;
    assert alts.len() > 0, "Group with no alts is not a valid lowering input";
    if alts.len() == 1 {
        let alt = &alts[0];
        assert alt.elements.len() > 0, "Group with empty alt is not a valid lowering input";
        if alt.elements.len() == 1 {
            // Transparent group `(e)` is positionally identical to `e` at
            // the surrounding alt, so the K-prefix propagates verbatim.
            return lower_transparent_group(
                &alt.elements[0],
                name_counts,
                rule_name,
                ctx,
                group_counter,
                outer_follow,
                outer_k_prefix,
                variant_mask,
                variant_k_prefix_mask,
                outer_position_mask,
                outer_k_prefix_position_mask,
            );
        }
        return lower_single_alt_group(
            alt,
            name_counts,
            rule_name,
            ctx,
            group_counter,
            outer_follow,
            variant_mask,
            variant_k_prefix_mask,
            outer_position_mask,
            outer_k_prefix_position_mask,
        );
    }
    if is_token_only_group(alts) {
        return lower_token_only_group(alts, name_counts, ctx, variant_mask, variant_k_prefix_mask);
    }
    if is_simple_cst_group(alts) {
        return lower_simple_cst_group(alts, name_counts, ctx, variant_mask, variant_k_prefix_mask);
    }
    if is_general_group(alts) {
        return lower_general_group(
            alts,
            name_counts,
            rule_name,
            ctx,
            group_counter,
            outer_follow,
            variant_mask,
            variant_k_prefix_mask,
            outer_position_mask,
            outer_k_prefix_position_mask,
        );
    }
    panic("Group shape unrecognised by classifier — should be impossible");
}

/// Single-element single-alt: `(e)` lowers to `e` with no struct of
/// its own. The binding nests in the surrounding alt's name table.
fn lower_transparent_group(inner: &Element, name_counts: &mut Array<[String, i32]>, rule_name: &String, ctx: &mut GenContext, group_counter: &mut i32, outer_follow: &Array<String>, outer_k_prefix: &Array<Array<String>>, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>, outer_position_mask: &Array<String>, outer_k_prefix_position_mask: &Array<Array<String>>) -> Op {
    // Nested inner is allowed: `((a))` / `(a*)` / `(name=a)`.
    // The Op carries whatever shape `lower_op` produces; the
    // surrounding emit-side Transparent path inlines it directly.
    // A Transparent group adds nothing between the inner and the
    // outer alt, so `outer_follow` passes through verbatim.

    let inner_op = lower_op(
        inner,
        name_counts,
        rule_name,
        ctx,
        group_counter,
        outer_follow,
        outer_k_prefix,
        variant_mask,
        variant_k_prefix_mask,
        outer_position_mask,
        outer_k_prefix_position_mask,
    );
    let body = AltBody {
        alt_index: 0,
        case_name: "",
        struct_name: "",
        ops: [inner_op],
        fields: [],
        prefix_self_ref_min_prec: 0,
    };
    let scan_body = ScanBody {
        elements: [
            lower_scan_element(
                inner,
                ctx,
                outer_follow,
                &empty_k_prefix(),
                variant_mask,
                variant_k_prefix_mask,
                &empty_k_prefix(),
            ),
        ],
    };
    // `dispatch` is meaningless for a one-alt Transparent group:
    // emit recognises `GroupShape::Transparent` and skips the
    // dispatch step, running the body unconditionally. The empty
    // `Direct` placeholder is the cheapest valid `MultiAltDispatch`.
    return Op::Group(GroupOp {
        shape: GroupShape::Transparent,
        alts: [body],
        scan_alts: [scan_body],
        dispatch: empty_direct_dispatch(),
        scan_dispatch: empty_direct_dispatch(),
    });
}

/// Single-alt with ≥ 2 elements: `(name=ID '=' expr)` lowers to a
/// struct of its own (`NameIdEqualsExprItem`) bound under a single
/// field in the outer alt. The struct's element bindings live in a
/// fresh name scope — they don't pollute the outer alt's counts.
///
/// `owner_rule` records the surrounding rule's name so a future
/// nested `General` group inside this body can resolve its
/// monomorph table key (`<RuleName>Group<idx>`). For Phase
/// 2.x.singlealt the inner ops are leaves only; nested groups land
/// in Phase 2.x.nested.
fn lower_single_alt_group(alt: &Alternative, name_counts: &mut Array<[String, i32]>, rule_name: &String, ctx: &mut GenContext, group_counter: &mut i32, outer_follow: &Array<String>, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>, outer_position_mask: &Array<String>, outer_k_prefix_position_mask: &Array<Array<String>>) -> Op {
    // Nested elements are allowed: `(a (b c))` / `(a*)` /
    // `(name=a b)`. Each elem is lowered through the standard
    // `lower_op` recursion.

    let struct_name = single_alt_group_type_name(alt);
    let field = dedup_name(&single_alt_group_field_name(alt), name_counts);

    // Canonical owner for this single-alt struct: when the same body
    // appears in multiple rules CST emit deduplicates under the first
    // rule that defines it (see `build_single_alt_owner_map`). Lower
    // nested elements with the owner as `rule_name` so any inner
    // `lower_general_group` bakes type names (`<Owner>Group<idx>`)
    // that match the deduplicated CST types directly. Without this,
    // emit had to re-derive the names through `ctx.current_rule_name`.
    let owner_rule = ctx.general_group_rule_name(&struct_name, rule_name);

    // Inner ops use a fresh name table — bindings inside the
    // group's struct don't dedup against the outer alt.
    let mut inner_counts: Array<[String, i32]> = [];
    let mut ops: Array<Op> = [];
    let mut scan_elements: Array<ScanElement> = [];
    for let mut i = 0; i < alt.elements.len(); i += 1 {
        let elem = &alt.elements[i];
        // Per-element follow inside the group: tokens that can
        // appear immediately after this element. For non-last
        // positions, that's the first-set of the suffix in the
        // group's alt. The last position inherits the surrounding
        // alt's `outer_follow`.
        let elem_follow = ctx.compute_call_site_follow(&alt.elements, i, variant_mask);
        // Inner positions get a FRESH per-position K-prefix mask
        // computed from the inner alt's suffix — the outer position's
        // mask doesn't carry through (the inner sits at a different
        // input depth than the outer alt position).
        let elem_k_prefix = ctx.compute_call_site_k_prefix_mask(
            &alt.elements,
            i,
            FOLLOW_VARIANT_MAX_K,
            variant_k_prefix_mask,
        );
        // Inner elements inherit the outer position's mask — `(a? b)?`
        // inside `outer ... (a? b)? rest` reads the same mask emit used
        // to install on `ctx.current_follow_mask` at the OUTER position.
        let mut op = lower_op(
            elem,
            &mut inner_counts,
            &owner_rule,
            ctx,
            group_counter,
            &elem_follow,
            &elem_k_prefix,
            variant_mask,
            variant_k_prefix_mask,
            outer_position_mask,
            outer_k_prefix_position_mask,
        );
        let mut se = lower_scan_element(
            elem,
            ctx,
            &elem_follow,
            &empty_k_prefix(),
            variant_mask,
            variant_k_prefix_mask,
            &empty_k_prefix(),
        );
        // Gate `basic_follow` on either side actually being a Repeat —
        // `first_of_elements_from` walks the suffix and isn't free.
        // Scalar `Label(Repeat(_))` collapses to `Op::Repeat` on the
        // parse side (so this fires); list `Label(Repeat(_))` lands as
        // `Op::ListLabel(Repeat(_))` on parse, but the scan side still
        // surfaces a top-level `ScanElement::Repeat` — so the scan
        // rebind needs an independent check, not an `&&` of the two.
        let op_is_repeat = op matches { Repeat(_) };
        let se_is_repeat = se matches { Repeat(_) };
        if op_is_repeat || se_is_repeat {
            let basic_follow = ctx.first_of_elements_from(&alt.elements, i + 1);
            if let Repeat(rep_op) = &op {
                let basic_second = compute_caller_follow_second(&alt.elements, i + 1, ctx);
                op = Op::Repeat(patch_repeat_op_caller_follow(rep_op, basic_follow, basic_second));
            }
            if se_is_repeat {
                se = rebind_scan_repeat_caller_follow(se, basic_follow);
            }
        }
        ops.push(op);
        scan_elements.push(se);
    }

    let body = AltBody {
        alt_index: 0,
        case_name: "",
        struct_name: struct_name,
        fields: enumerate_op_field_decls(&ops),
        ops: ops,
        prefix_self_ref_min_prec: 0,
    };
    let scan_body = ScanBody { elements: scan_elements };
    return Op::Group(GroupOp {
        shape: GroupShape::SingleAlt(SingleAltShape {
            struct_name: struct_name,
            field: field,
            owner_rule: owner_rule,
        }),
        alts: [body],
        scan_alts: [scan_body],
        dispatch: empty_direct_dispatch(),
        scan_dispatch: empty_direct_dispatch(),
    });
}

fn empty_direct_dispatch() -> MultiAltDispatch {
    let branches: Array<DispatchBranch> = [];
    return MultiAltDispatch::Direct(DirectDispatch { branches });
}

/// Multi-alt group whose every alt is a single Token / Literal —
/// `(K_INSERT | K_REPLACE)`. Lowers to `GroupShape::TokenOnly`,
/// which emit realises as a single `Token`-typed CST field. The
/// alt bodies are the matched leaf token; dispatch is direct on
/// each alt's single token kind (the alts are mutually exclusive
/// by construction — the classifier has already checked).
///
/// Field name is `token_group_field_name(alts)` (e.g.
/// `k_insert_or_k_replace`), deduped against the surrounding alt
/// scope. Inner ops carry no field name of their own — emit reads
/// the matched token off the runtime stack and writes it into the
/// outer `field` slot.
fn lower_token_only_group(alts: &Array<Alternative>, name_counts: &mut Array<[String, i32]>, ctx: &mut GenContext, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>) -> Op {
    let field = dedup_name(&token_group_field_name(alts), name_counts);

    let mut bodies: Array<AltBody> = [];
    let mut scan_bodies: Array<ScanBody> = [];
    let mut first_sets: Array<Array<String>> = [];
    let mut inner_counts: Array<[String, i32]> = [];
    for let mut i = 0; i < alts.len(); i += 1 {
        let alt = &alts[i];
        let elem = &alt.elements[0];
        let op = lower_token_only_leaf(elem, &mut inner_counts);
        bodies.push(AltBody {
            alt_index: i,
            case_name: "",
            struct_name: "",
            ops: [op],
            fields: [],
            prefix_self_ref_min_prec: 0,
        });
        // Token-only alts are by construction leaves with no inner
        // Repeats — outer_follow is irrelevant, pass empty.
        let empty_follow: Array<String> = [];
        scan_bodies.push(ScanBody { elements: [
            lower_scan_element(
                elem,
                ctx,
                &empty_follow,
                &empty_k_prefix(),
                variant_mask,
                variant_k_prefix_mask,
                &empty_k_prefix(),
            ),
        ] });
        first_sets.push([token_only_kind(elem)]);
    }
    let dispatch = build_direct_dispatch(&first_sets);
    return Op::Group(GroupOp {
        shape: GroupShape::TokenOnly(TokenOnlyShape { field: field }),
        alts: bodies,
        scan_alts: scan_bodies,
        dispatch: dispatch,
        scan_dispatch: clone_dispatch(&dispatch),
    });
}

fn lower_token_only_leaf(elem: &Element, counts: &mut Array<[String, i32]>) -> Op {
    return match *elem {
        TokenRef(t) => Op::Token(TokenOp {
            kind: `TK_{t.name}`,
            field: dedup_name(&t.field_name, counts),
            dedup_base: t.field_name,
        }),
        Literal(l) => {
            let base = literal_field_name(&l.text);
            Op::Literal(LiteralOp {
                kind: literal_const_name(&l.text),
                field: dedup_name(&base, counts),
                dedup_base: base,
            });
        },
        _ => panic("lower_token_only_leaf: classifier permitted non-token leaf"),
    };
}

fn token_only_kind(elem: &Element) -> String {
    return match *elem {
        TokenRef(t) => `TK_{t.name}`,
        Literal(l) => literal_const_name(&l.text),
        _ => panic("token_only_kind: classifier permitted non-token leaf"),
    };
}

/// Multi-alt group whose every alt is a single distinct `RuleRef` —
/// `(stmt | expr | decl)`. Lowers to `GroupShape::SimpleCst` with
/// a shared variant type name and a single field name. Each alt's
/// body is the matched `RuleCall`; dispatch uses each callee rule's
/// first set.
///
/// Phase 2.x.simplecst handles only the disjoint-first-set case so
/// the dispatch is a clean `Direct` chain. Overlapping rule-ref
/// alts (e.g. two rules sharing a leading IDENT) need the scan-side
/// tournament dispatch — that lands in Phase 2.3c.
fn lower_simple_cst_group(alts: &Array<Alternative>, name_counts: &mut Array<[String, i32]>, ctx: &mut GenContext, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>) -> Op {
    let type_name = group_variant_type_name(alts);
    let field = dedup_name(&group_field_base_name(alts), name_counts);

    let mut first_sets: Array<Array<String>> = [];
    for let alt of alts {
        let mut visiting: Array<String> = [];
        first_sets.push(ctx.first_of_alt(alt, &mut visiting));
    }

    let mut bodies: Array<AltBody> = [];
    let mut scan_bodies: Array<ScanBody> = [];
    let mut inner_counts: Array<[String, i32]> = [];
    let mut all_indices: Array<i32> = [];
    for let mut i = 0; i < alts.len(); i += 1 {
        let alt = &alts[i];
        let elem = &alt.elements[0];
        let case_name = group_case_name(alt);
        let op = lower_simple_cst_alt_call(elem, &mut inner_counts);
        bodies.push(AltBody {
            alt_index: i,
            case_name: case_name,
            struct_name: "",
            ops: [op],
            fields: [],
            prefix_self_ref_min_prec: 0,
        });
        // SimpleCst alts are single `RuleRef`s — outer_follow does
        // not propagate into the callee (whole-rule follow is the
        // callee's concern via Phase 2.6 variants).
        let empty_follow: Array<String> = [];
        scan_bodies.push(ScanBody { elements: [
            lower_scan_element(
                elem,
                ctx,
                &empty_follow,
                &empty_k_prefix(),
                variant_mask,
                variant_k_prefix_mask,
                &empty_k_prefix(),
            ),
        ] });
        all_indices.push(i);
    }
    let dispatch = build_overlap_dispatch(&"SimpleCst group", alts, &all_indices, &first_sets, ctx);
    return Op::Group(GroupOp {
        shape: GroupShape::SimpleCst(SimpleCstShape {
            type_name: type_name,
            field: field,
        }),
        alts: bodies,
        scan_alts: scan_bodies,
        dispatch: clone_dispatch(&dispatch),
        scan_dispatch: dispatch,
    });
}

fn lower_simple_cst_scan_group(alts: &Array<Alternative>, ctx: &mut GenContext, outer_follow: &Array<String>, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>) -> ScanElement {
    let mut bodies: Array<ScanBody> = [];
    let mut first_sets: Array<Array<String>> = [];
    let mut all_indices: Array<i32> = [];
    for let mut i = 0; i < alts.len(); i += 1 {
        let alt = &alts[i];
        let elem = &alt.elements[0];
        // Pass `outer_follow` (not an empty per-position follow) here so
        // lower's variant-registry stays in lock-step across the variant
        // body: `variant_mask` carries the variant's mask, and any
        // RuleRef call inside the variant re-lowers with that mask
        // propagated through `compute_call_site_follow`. Cutting the
        // follow to `[]` here would make lower under-register variants
        // at this site — and `gen_parser`'s post-lower assert catches
        // such divergence. The spurious `scan_X__follow_N` cases this
        // approach re-introduces (e.g. `scan_sql_stmt_list__follow_0`)
        // are currently observable; see the matching commit message
        // for the tradeoff.
        // SimpleCst alts are single RuleRefs by construction
        // (`is_simple_cst_group`), so `lower_scan_element` produces a
        // `ScanRuleCall` here, never a Repeat — no caller-follow
        // rebind is needed.
        bodies.push(ScanBody { elements: [
            lower_scan_element(
                elem,
                ctx,
                outer_follow,
                &empty_k_prefix(),
                variant_mask,
                variant_k_prefix_mask,
                &empty_k_prefix(),
            ),
        ] });
        let mut visiting: Array<String> = [];
        first_sets.push(ctx.first_of_alt(alt, &mut visiting));
        all_indices.push(i);
    }
    let dispatch = build_overlap_dispatch(&"SimpleCst group (scan)", alts, &all_indices, &first_sets, ctx);
    return ScanElement::Group(ScanGroupElem {
        alts: bodies,
        dispatch: dispatch,
        lenient: true,
        alt_first_sets: first_sets,
        wildcard_alt_indices: ([] as Array<i32>),
    });
}

fn lower_simple_cst_alt_call(elem: &Element, counts: &mut Array<[String, i32]>) -> Op {
    if let RuleRef(r) = *elem {
        return Op::RuleCall(RuleCallOp {
            target_name: r.name,
            target_snake: r.snake_name,
            variant_id: null,
            min_prec_arg: null,
            field: dedup_name(&r.field_name, counts),
            dedup_base: r.field_name,
        });
    }
    panic("lower_simple_cst_alt_call: classifier permitted non-RuleRef leaf");
}

/// Multi-alt group not covered by `SimpleCst` / `TokenOnly` /
/// `SingleAlt` — `(stmt | 'go' expr)`. Lowers to
/// `GroupShape::General` carrying:
///
/// * `variant_type = <RuleName>Group<idx>` — the per-rule variant
///   type that stores one of the alts.
/// * `alt_struct_names[j] = <RuleName>Group<idx>Alt<j>` — the
///   per-alt struct name (always allocated, even when an alt is a
///   single op, so emit can drop a uniform `<Variant>::Alt<j>(...)`
///   constructor).
/// * `field = group_<idx>` — deduped against the surrounding alt.
/// * `group_index = <idx>` — the per-rule cumulative counter; emit
///   uses this id to look up monomorph table entries and to
///   resolve the cross-pass general-group enumeration.
///
/// Phase 2.x.general handles only the disjoint-first-set case.
/// Overlapping alts (the typical case for non-trivial groups) need
/// the scan-tournament dispatch from Phase 2.3c.
///
/// Per-alt elements use a fresh name table — the inner ops bind
/// names inside the group's struct, not the outer alt. The shared
/// `group_counter` is bumped before lowering inner alts so any
/// nested general groups get the next sequential ids.
fn lower_general_group(alts: &Array<Alternative>, name_counts: &mut Array<[String, i32]>, rule_name: &String, ctx: &mut GenContext, group_counter: &mut i32, outer_follow: &Array<String>, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>, outer_position_mask: &Array<String>, outer_k_prefix_position_mask: &Array<Array<String>>) -> Op {
    let group_index = *group_counter;
    *group_counter += 1;

    let variant_type = general_group_type_name(rule_name, group_index);
    let field = dedup_name(&general_group_field_name(group_index), name_counts);

    let mut first_sets: Array<Array<String>> = [];
    for let alt of alts {
        let mut visiting: Array<String> = [];
        first_sets.push(ctx.first_of_alt(alt, &mut visiting));
    }

    let mut bodies: Array<AltBody> = [];
    let mut scan_bodies: Array<ScanBody> = [];
    let mut alt_struct_names: Array<String> = [];
    let mut all_indices: Array<i32> = [];
    for let mut i = 0; i < alts.len(); i += 1 {
        let alt = &alts[i];
        let alt_struct = general_group_alt_struct_name(rule_name, group_index, i);
        all_indices.push(i);
        alt_struct_names.push(alt_struct);

        // Inner alts get a fresh name table (the group struct is
        // its own scope) but share the outer rule's
        // `group_counter` — nested general groups inside this
        // alt take the next sequential ids.
        let mut inner_counts: Array<[String, i32]> = [];
        let mut ops: Array<Op> = [];
        let mut scan_elements: Array<ScanElement> = [];
        for let mut ei = 0; ei < alt.elements.len(); ei += 1 {
            let elem = &alt.elements[ei];
            let elem_follow = ctx.compute_call_site_follow(&alt.elements, ei, variant_mask);
            // Fresh per-position K-prefix from the inner alt's suffix —
            // the outer K-prefix doesn't propagate into per-alt inner
            // positions (each alt's inner sits at its own input depth).
            let elem_k_prefix = ctx.compute_call_site_k_prefix_mask(
                &alt.elements,
                ei,
                FOLLOW_VARIANT_MAX_K,
                variant_k_prefix_mask,
            );
            // See `lower_single_alt_group` — inner elements inherit
            // the outer position's mask, mirroring emit's inner-walker
            // semantics on the retired `ctx.current_follow_mask`.
            let mut op = lower_op(
                elem,
                &mut inner_counts,
                rule_name,
                ctx,
                group_counter,
                &elem_follow,
                &elem_k_prefix,
                variant_mask,
                variant_k_prefix_mask,
                outer_position_mask,
                outer_k_prefix_position_mask,
            );
            let mut se = lower_scan_element(
                elem,
                ctx,
                &elem_follow,
                &empty_k_prefix(),
                variant_mask,
                variant_k_prefix_mask,
                &empty_k_prefix(),
            );
            let op_is_repeat = op matches { Repeat(_) };
            let se_is_repeat = se matches { Repeat(_) };
            if op_is_repeat || se_is_repeat {
                let basic_follow = ctx.first_of_elements_from(&alt.elements, ei + 1);
                if let Repeat(rep_op) = &op {
                    let basic_second = compute_caller_follow_second(&alt.elements, ei + 1, ctx);
                    op = Op::Repeat(patch_repeat_op_caller_follow(rep_op, basic_follow, basic_second));
                }
                if se_is_repeat {
                    se = rebind_scan_repeat_caller_follow(se, basic_follow);
                }
            }
            ops.push(op);
            scan_elements.push(se);
        }

        bodies.push(AltBody {
            alt_index: i,
            case_name: `Alt{i}`,
            struct_name: alt_struct,
            fields: enumerate_op_field_decls(&ops),
            ops: ops,
            prefix_self_ref_min_prec: 0,
        });
        scan_bodies.push(ScanBody { elements: scan_elements });
    }
    let ctx_label = `General group {*rule_name}Group{group_index}`;
    let dispatch = build_overlap_dispatch(&ctx_label, alts, &all_indices, &first_sets, ctx);
    return Op::Group(GroupOp {
        shape: GroupShape::General(GeneralShape {
            variant_type: variant_type,
            alt_struct_names: alt_struct_names,
            field: field,
            group_index: group_index,
        }),
        alts: bodies,
        scan_alts: scan_bodies,
        dispatch: clone_dispatch(&dispatch),
        scan_dispatch: dispatch,
    });
}

/// Lower a `Repeat` element (`e?` / `e*` / `e+`). Phase 2.x.partial
/// only handles greedy `Star` / `Plus` whose inner is a leaf
/// element (no nested `Repeat` / `Group` / `Label`). The remaining
/// shapes panic with their own `TODO` markers so a half-lowered
/// `Repeat` cannot quietly reach codegen.
///
/// Default strategy is `Plain`: emit produces `while peek_kind ∈
/// first_of_inner { … push body }` for `Star` and `Plus` (with `+`'s
/// mandatory-first guard handled at emit time, not in the strategy
/// enum). When `variant_mask` is non-empty (variant bodies),
/// `choose_greedy_repeat_strategy` picks `Suppressed` /
/// `WithFollowSubtraction` / `OptionalLookahead` / `OptionalScanGuard`
/// as appropriate.
///
/// The inner Op uses a fresh `name_counts` because the binding name
/// inside a loop body is a local to that iteration — it does not
/// shadow or dedup against the surrounding alt's bindings (the
/// outer alt's list-typed field comes from `FieldDecl` in Phase 2.9,
/// independent of the inner binding).
fn lower_repeat_op(rep: &RepeatElement, name_counts: &mut Array<[String, i32]>, rule_name: &String, ctx: &mut GenContext, group_counter: &mut i32, outer_follow: &Array<String>, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>, outer_position_mask: &Array<String>, outer_k_prefix_position_mask: &Array<Array<String>>) -> Op {
    // Outer struct field name for the alt that contains this
    // Repeat. For `Star` / `Plus` it's `<inner_base>_list` (the
    // struct holds an `Array<...>`); for `Optional` it's just the
    // inner base name (the struct holds an `Option<...>`). Dedup
    // against the surrounding alt's name table — the inner body
    // op's field lives in a fresh scope and does not collide.
    //
    // Special case: `(name+=expr)*` — when the Repeat's inner is a
    // list-label (`+=`), the label name IS the array, with no
    // `_list` suffix. Mirrors `parser_gen::gen_repeat_body`'s
    // `is_list_label(inner)` branch at line 3113.
    let outer_field = if repeat_inner_is_list_label(&rep.element) {
        if let Label(lab) = rep.element {
            dedup_name(&lab.field_name, name_counts);
        } else {
            panic("repeat_inner_is_list_label returned true for non-Label");
        }
    } else {
        // Speculative `group_counter` value the inner lowering
        // will see: pass the current value verbatim. A General-
        // Group inner uses this id for its `group_<idx>` field
        // name; the increment happens during the inner-Op
        // lowering below so the outer name and inner shape stay
        // in lockstep.
        let outer_base = repeat_outer_base_name(&rep.element, rep.kind, *group_counter);
        dedup_name(&outer_base, name_counts);
    };

    // Pre-compute the inner's first set; used both by the strategy
    // decision (mask subtraction / suppression) and by the
    // iter-follow propagation for nested constructs.
    let mut inner_visiting: Array<String> = [];
    let inner_first = ctx.first_of_element(&rep.element, &mut inner_visiting);

    // Optional `?` has three specialised strategies that supersede
    // the mask-aware decision when applicable:
    //
    // * `OptionalLookahead` — inner is a single-alt Group whose
    //   leading elements are fixed tokens (`TokenRef` / `Literal`).
    //   Bare leaf Optionals (`TokenRef?` / `Literal?`) stay at
    //   `Plain` and are handled by emit's Optional+leaf arm.
    // * `OptionalShapeLookahead` — inner is a single-alt Group with
    //   nested Optionals; emit enumerates 2^n shapes (longest-first).
    // * `OptionalScanGuard` — any other Optional shape where the
    //   inner is fully scannable; emit runs the scan helper as a
    //   commit gate.
    //
    // `pick_optional_specialised` resolves which one fires using the
    // `body_has_field` storability flag to match emit's storable /
    // transparent dispatch order. All three kick in only outside a
    // follow-mask suppression window; when the mask fully blocks the
    // loop (`Suppressed`), the specialised strategies are unnecessary.
    let body_has_field = element_has_field(&rep.element);
    let mut opt_specialised: Option<RepeatStrategy> = null;
    if !rep.non_greedy {
        if let Optional = rep.kind {
            opt_specialised = pick_optional_specialised(&rep.element, body_has_field, ctx);
        }
    }

    let strategy = if rep.non_greedy {
        compute_non_greedy_strategy(&rep.element, outer_follow, ctx);
    } else {
        // Mask-driven `Suppressed` always wins — if every iteration's
        // first token is in the variant mask, the loop never enters
        // and any specialised guard would be unreachable. Otherwise
        // prefer the specialised strategy when one is available;
        // fall through to the mask-aware decision when not.
        let mask_decision = choose_greedy_repeat_strategy(&inner_first, variant_mask);
        pick_greedy_strategy(mask_decision, opt_specialised);
    };

    // The inner body's `outer_follow` for nested constructs is the
    // iter-follow of this repeat: `first(inner) ∪ outer_follow`,
    // because after the inner finishes the loop either restarts
    // (consuming a `first(inner)` token) or exits (the surrounding
    // `outer_follow`). Today this propagation is only consumed by
    // nested non-greedy Repeats.
    let iter_follow = union_kind_arrays(&inner_first, outer_follow);

    let mut inner_counts: Array<[String, i32]> = [];
    // `(name+=elem)*` / `name+=elem+` / `name+=elem?` — the Repeat
    // itself supplies the `Array<>` typing via its `field`; the inner
    // Label only contributes its name, not an extra `Array<>` wrap.
    // Bypass `lower_label_op`'s `Op::ListLabel` wrapper here and
    // lower the labelled inner directly, rebinding to the Repeat's
    // outer field name so emit's runtime construction (which
    // references the binding as `<outer_field>.push(...)`) matches.
    // The iter body sits at a different input depth than the
    // surrounding alt position — the surrounding K-prefix (e.g. caller
    // `c : X Y Z` at the outer site) does not apply here. The iter's
    // own K-prefix would be `first(iter again | exit-to-caller)`, a
    // fixed-point computation we defer; passing `[]` is sound and
    // preserves the existing 1-token mask path for inner RuleRefs.
    let body = if repeat_inner_is_list_label(&rep.element) {
        if let Label(lab) = &rep.element {
            let inner_op = lower_op(
                &lab.element,
                &mut inner_counts,
                rule_name,
                ctx,
                group_counter,
                &iter_follow,
                &empty_k_prefix(),
                variant_mask,
                variant_k_prefix_mask,
                outer_position_mask,
                &empty_k_prefix(),
            );
            // The Repeat's outer field carries `lab.field_name` as
            // its base (deduped earlier in `outer_field`); the rebind
            // adopts that base on the inner op so emit's leaf sync
            // bumps the actually-emitted name, not the elided inner.
            rebind_op_field(inner_op, &outer_field, &lab.field_name);
        } else {
            panic("repeat_inner_is_list_label returned true for non-Label");
        }
    } else {
        lower_op(
            &rep.element,
            &mut inner_counts,
            rule_name,
            ctx,
            group_counter,
            &iter_follow,
            &empty_k_prefix(),
            variant_mask,
            variant_k_prefix_mask,
            outer_position_mask,
            &empty_k_prefix(),
        );
    };
    let mut body_visiting: Array<String> = [];
    let body_scannable = ctx.is_element_scannable(&rep.element, &mut body_visiting);
    // Scan-side mirror of `body`. Computed here so emit's scan-guard
    // helpers (`emit_rep_scan_guard` / `emit_scan_guard_with_prefix`)
    // can scan the inner element via the op-driven scan walker
    // (`gen_scan_op_element`) without falling back to the surface
    // `gen_scan_*` walker graph. Uses the same `iter_follow` as the
    // parse side so per-position context (`caller_follow_first`
    // baked on nested `ScanRepeatElem`s) lines up.
    let scan_body = lower_scan_element(
        &rep.element,
        ctx,
        &iter_follow,
        &empty_k_prefix(),
        variant_mask,
        variant_k_prefix_mask,
        &empty_k_prefix(),
    );
    let body_is_single_alt_group = if let Group(g) = &rep.element {
        g.alternatives.len() == 1;
    } else {
        false;
    };
    let body_second_position_first = compute_body_second_position_first(&rep.element, ctx);
    let body_shape = classify_repeat_body_shape(&body);
    return Op::Repeat(RepeatOp {
        kind: rep.kind,
        body,
        scan_body,
        strategy: strategy,
        field: outer_field,
        caller_follow_first: *outer_follow,
        position_mask: *outer_position_mask,
        k_prefix_mask: *outer_k_prefix_position_mask,
        caller_follow_second: [],
        body_scannable,
        body_has_field,
        body_first_set: inner_first,
        body_is_single_alt_group,
        body_second_position_first,
        body_shape,
    });
}

/// Inner second-position first set for non-greedy 2-token disambiguation.
/// Mirrors the surface check `compute_non_greedy_condition` used to perform
/// at emit time: when the inner is a single-alt `Group` of ≥ 2 elements,
/// returns `first_of_elements_from(&elements, 1)`; otherwise `[]`.
fn compute_body_second_position_first(elem: &Element, ctx: &mut GenContext) -> Array<String> {
    if let Group(g) = elem {
        if g.alternatives.len() == 1 && g.alternatives[0].elements.len() >= 2 {
            return ctx.first_of_elements_from(&g.alternatives[0].elements, 1);
        }
    }
    return [];
}

/// Classify the body op into its `RepeatBodyShape`. The four cases
/// cover every shape `lower_op` produces for a Repeat's inner; lower
/// asserts on anything else so emit's exhaustive dispatch can drop
/// the "did not cover this body shape" panics.
///
/// Mirrors emit's pre-shape probes (`op_is_rulecall`, `op_is_leaf`,
/// `let Group(g_op) = body && body_has_field`).
fn classify_repeat_body_shape(body: &Op) -> RepeatBodyShape {
    return match body {
        RuleCall(_) => RepeatBodyShape::LeafRuleCall,
        Token(_) | Literal(_) | Wildcard(_) | Excluded(_) => RepeatBodyShape::LeafOther,
        Group(g_op) => match &g_op.shape {
            Transparent => RepeatBodyShape::TransparentGroup,
            SingleAlt(_) | TokenOnly(_) | SimpleCst(_) | General(_) => RepeatBodyShape::StorableGroup,
        },
        // Lower never produces these as a Repeat body: ListLabel is
        // unwrapped by `lower_repeat_op`'s `repeat_inner_is_list_label`
        // arm before `lower_op` builds the Op, and a directly nested
        // Repeat body has no surface-grammar equivalent (`(a*)*`
        // collapses through the surface Group).
        ListLabel(_) | Repeat(_) => panic(
            "classify_repeat_body_shape: ListLabel / Repeat reached as a Repeat body — lower-side bug",
        ),
    };
}

/// Caller-side second-token set for a non-greedy Repeat at position
/// `start - 1` in the surrounding alt. Returns the first set of the
/// second sub-position when the next element (at `start`) is itself a
/// Repeat over a single-alt Group of ≥ 2 elements (the common
/// `(',' x)*?` followed by `(',' y)*` disambiguation pattern). Returns
/// `[]` otherwise — emit's `compute_non_greedy_condition` mirror
/// already handles the empty case.
fn compute_caller_follow_second(elements: &Array<Element>, start: i32, ctx: &mut GenContext) -> Array<String> {
    if start >= elements.len() {
        return [];
    }
    let follow_elem = &elements[start];
    if let Repeat(rep) = follow_elem {
        if let Group(g) = rep.element {
            if g.alternatives.len() == 1 && g.alternatives[0].elements.len() >= 2 {
                return ctx.first_of_elements_from(&g.alternatives[0].elements, 1);
            }
        }
    }
    return [];
}

/// True iff the surface `Element` contributes a CST field. Mirror of
/// `gen_util::has_field`, kept in lower so the result can be baked
/// into `RepeatOp.body_has_field` without forcing emit to keep the
/// surface predicate alive.
fn element_has_field(elem: &Element) -> bool {
    if let TokenRef(_) | Literal(_) | RuleRef(_) | Wildcard(_) | Not(_) = elem {
        return true;
    }
    if let Label(lab) = elem {
        return element_has_field(&lab.element);
    }
    if let Group(g) = elem {
        return is_storable_group(&g.alternatives);
    }
    return false;
}

/// Pick the specialised `Optional` strategy lower bakes into a Repeat's
/// `RepeatOp.strategy`. The dispatch order depends on whether the inner
/// will be wrapped in a CST struct (storable) or inlined (transparent):
///
/// * Storable (`body_has_field == true`): a single k-token check is
///   preferred when applicable because the outer struct only needs
///   one entry point; falls back to shape-disjunction when the inner
///   has nested optionals, then to scan-guard.
/// * Transparent (`body_has_field == false`): shape-disjunction is
///   preferred because each shape inlines different elements
///   directly; falls back to k-token, then scan-guard.
///
/// Returns `null` when none apply; the caller falls through to the
/// mask-aware `Plain` / `WithFollowSubtraction` / `Suppressed` decision.
/// This function is the single source of truth for the
/// Optional+Group dispatch decision — emit consumes the resulting
/// strategy variant directly via `gen_op_storable_optional` /
/// `gen_op_transparent_optional`.
fn pick_optional_specialised(inner: &Element, body_has_field: bool, ctx: &mut GenContext) -> Option<RepeatStrategy> {
    let k_token = try_optional_k_token_lookahead(inner);
    let shape = try_optional_shape_lookahead(inner, ctx);
    let scan_guard = try_optional_scan_guard(inner, ctx);
    if body_has_field {
        if let Some(s) = k_token {
            return Option::<RepeatStrategy>::Some(s);
        }
        if let Some(s) = shape {
            return Option::<RepeatStrategy>::Some(s);
        }
        if let Some(s) = scan_guard {
            return Option::<RepeatStrategy>::Some(s);
        }
    } else {
        if let Some(s) = shape {
            return Option::<RepeatStrategy>::Some(s);
        }
        if let Some(s) = k_token {
            return Option::<RepeatStrategy>::Some(s);
        }
        if let Some(s) = scan_guard {
            return Option::<RepeatStrategy>::Some(s);
        }
    }
    return null;
}

/// Try to materialise an `OptionalLookahead` strategy (k-token mode).
/// Fires when the inner is a single-alt Group with a non-empty
/// leading run of fixed tokens (`TokenRef` / `Literal`); returns
/// `null` for non-Group inners. Bare leaf Optionals stay at
/// `Plain` — the Optional+leaf arm of
/// `gen_op_repeat_with_follow_override` emits the single-token
/// guard directly from `body_first_set`, so the specialisation is
/// unnecessary there.
fn try_optional_k_token_lookahead(inner: &Element) -> Option<RepeatStrategy> {
    let tokens = collect_optional_leading_tokens(inner);
    if tokens.is_empty() {
        return null;
    }
    let mut sig: Array<Array<String>> = [];
    for let tk of &tokens {
        sig.push([*tk]);
    }
    return Option::<RepeatStrategy>::Some(RepeatStrategy::OptionalLookahead(
        OptionalLookaheadStrategy { sig: sig },
    ));
}

/// Collect leading fixed-token kinds from an Optional's single-alt
/// Group inner. Walks the alt's elements until the first non-fixed one.
/// Returns `[]` for non-Group inners — leaf Optionals (`TokenRef?` /
/// `Literal?`) are handled by `gen_op_repeat_with_follow_override`'s
/// Optional+leaf arm using `inner_first` directly, so we keep their
/// strategy at the mask-aware `Plain` / `WithFollowSubtraction`.
fn collect_optional_leading_tokens(inner: &Element) -> Array<String> {
    let mut tokens: Array<String> = [];
    if let Group(g) = inner {
        if g.alternatives.len() != 1 {
            return tokens;
        }
        for let elem of &g.alternatives[0].elements {
            if let TokenRef(t) = elem {
                tokens.push(`TK_{t.name}`);
            } else if let Literal(l) = elem {
                tokens.push(literal_const_name(&l.text));
            } else {
                break;
            }
        }
    }
    return tokens;
}

/// Try to materialise an `OptionalShapeLookahead` strategy. Fires
/// when the inner is a single-alt Group with at least one nested
/// Optional Repeat — emit enumerates 2^n shapes (longest-first) and
/// guards each on the per-position kind set computed from
/// `ctx.first_of_element`. Returns `null` for other inner shapes.
fn try_optional_shape_lookahead(inner: &Element, ctx: &mut GenContext) -> Option<RepeatStrategy> {
    if let Group(g) = inner {
        if g.alternatives.len() != 1 {
            return null;
        }
        let elements = &g.alternatives[0].elements;
        let mut has_nested = false;
        for let elem of elements {
            if surface_is_optional_repeat(elem) {
                has_nested = true;
                break;
            }
        }
        if !has_nested {
            return null;
        }
        let shapes = compute_shapes_for_alt(elements);
        let mut shape_entries: Array<OptionalLookaheadShape> = [];
        for let shape of &shapes {
            let sig = shape_lookahead_signature_for_alt(shape, elements, ctx);
            if sig.is_empty() {
                continue;
            }
            shape_entries.push(OptionalLookaheadShape {
                positions: *shape,
                sig: sig,
            });
        }
        if shape_entries.is_empty() {
            return null;
        }
        return Option::<RepeatStrategy>::Some(RepeatStrategy::OptionalShapeLookahead(
            OptionalShapeLookaheadStrategy { shapes: shape_entries },
        ));
    }
    return null;
}

/// Combine the mask-aware decision with an optional specialised
/// strategy: `Suppressed` always wins (the loop won't run at all);
/// otherwise the specialised strategy is preferred when available.
fn pick_greedy_strategy(mask_decision: RepeatStrategy, specialised: Option<RepeatStrategy>) -> RepeatStrategy {
    if let Suppressed = mask_decision {
        return mask_decision;
    }
    if let Some(strat) = specialised {
        return strat;
    }
    return mask_decision;
}

/// Try to materialise an `OptionalScanGuard` strategy for an
/// `Optional` Repeat whose inner cannot be decided by lookahead but
/// IS fully scannable. emit runs the scan helper as a commit gate
/// and only parses the body on success.
///
/// Returns `null` for:
/// * leaf inners (Token / Literal / Wildcard / Not — `Plain`
///   handles them without a scan probe);
/// * unscannable inners (no save-and-rewind path; emit will panic
///   with the "no backtracking" message);
/// * RuleRef inners that are unscannable (same reason).
fn try_optional_scan_guard(inner: &Element, ctx: &mut GenContext) -> Option<RepeatStrategy> {
    let needs_guard = match *inner {
        Group(_) => true,
        RuleRef(_) => true,
        _ => false,
    };
    if !needs_guard {
        return null;
    }
    let mut visiting: Array<String> = [];
    if !ctx.is_element_scannable(inner, &mut visiting) {
        return null;
    }
    return Option::<RepeatStrategy>::Some(RepeatStrategy::OptionalScanGuard);
}

/// Greedy Repeat strategy decision. Outside a follow-aware variant
/// (`variant_mask` empty) the strategy is `Plain`. Inside a variant
/// we apply the mask to the inner's first set:
///
/// * `effective_first` is empty → every iteration's first token is
///   in the mask, so the loop should never enter — emit it
///   `Suppressed` and the runtime skips the storage allocation
///   entirely.
/// * `effective_first` is shorter than `inner_first` (some overlap
///   between the loop's first set and the mask) → emit guards on
///   the subtracted set with `WithFollowSubtraction`.
/// * No overlap at all → `Plain` (the mask doesn't intersect this
///   loop's iteration condition, so emit walks the standard
///   `while peek ∈ first` path).
fn choose_greedy_repeat_strategy(inner_first: &Array<String>, mask: &Array<String>) -> RepeatStrategy {
    if mask.is_empty() {
        return RepeatStrategy::Plain;
    }
    let effective = subtract_first(inner_first, mask);
    if effective.is_empty() {
        return RepeatStrategy::Suppressed;
    }
    if effective.len() == inner_first.len() {
        return RepeatStrategy::Plain;
    }
    return RepeatStrategy::WithFollowSubtraction(WithFollowSubtractionStrategy {
        effective_first: effective,
    });
}

/// Scan-side twin of `choose_greedy_repeat_strategy`. Different
/// enum (`ScanRepeatStrategy` lacks `OptionalLookahead` /
/// `OptionalScanGuard`) but otherwise identical decision tree.
fn choose_greedy_scan_repeat_strategy(inner_first: &Array<String>, mask: &Array<String>) -> ScanRepeatStrategy {
    if mask.is_empty() {
        return ScanRepeatStrategy::Plain;
    }
    let effective = subtract_first(inner_first, mask);
    if effective.is_empty() {
        return ScanRepeatStrategy::Suppressed;
    }
    if effective.len() == inner_first.len() {
        return ScanRepeatStrategy::Plain;
    }
    return ScanRepeatStrategy::WithFollowSubtraction(WithFollowSubtractionStrategy {
        effective_first: effective,
    });
}

/// Token-by-token subtraction of `b` from `a`, preserving `a`'s
/// order. Linear scan; kind-set sizes here are small (≤ a few
/// dozen) so a linear `first_set_contains` is fine.
fn subtract_first(a: &Array<String>, b: &Array<String>) -> Array<String> {
    let mut result: Array<String> = [];
    for let tk of a {
        if !first_set_contains(b, tk) {
            result.push(*tk);
        }
    }
    return result;
}

/// Compute the `NonGreedy` strategy for a non-greedy Repeat (`e*?` /
/// `e+?` / `e??`). `exit_first` is the surrounding alt's
/// `outer_follow` — the tokens that may legitimately appear after
/// the loop. `exit_second` provides 2-token disambiguation for the
/// case where the inner's first set overlaps `outer_follow` (e.g.
/// `(',' column_def)*?` followed by `(',' table_constraint)*`,
/// where peek(0)==',' for both but peek(1) distinguishes).
fn compute_non_greedy_strategy(inner: &Element, outer_follow: &Array<String>, ctx: &mut GenContext) -> RepeatStrategy {
    // Wildcard / Not inner have open-ended first sets — emit treats
    // their continue condition as "while not in follow". The strategy
    // payload just carries `outer_follow` as `exit_first`; emit
    // generates the appropriate "loop until follow appears" check.
    if let Wildcard(_) = inner {
        return RepeatStrategy::NonGreedy(NonGreedyStrategy {
            exit_first: *outer_follow,
            exit_second: [],
        });
    }
    if let Not(_) = inner {
        return RepeatStrategy::NonGreedy(NonGreedyStrategy {
            exit_first: *outer_follow,
            exit_second: [],
        });
    }

    // `exit_second` is needed only when the inner's first set fully
    // overlaps `outer_follow`. For now we only compute it for the
    // single-alt Group inner case (the common ',' separator pattern)
    // and leave it empty otherwise — emit's check falls back to a
    // 1-token peek which conservatively matches minimum.
    let mut exit_second: Array<String> = [];
    if let Group(g) = inner {
        if g.alternatives.len() == 1 && g.alternatives[0].elements.len() >= 2 {
            exit_second = ctx.first_of_elements_from(&g.alternatives[0].elements, 1);
        }
    }
    return RepeatStrategy::NonGreedy(NonGreedyStrategy {
        exit_first: *outer_follow,
        exit_second: exit_second,
    });
}

/// Rebuild a `RepeatOp` with fresh `caller_follow_first` /
/// `caller_follow_second` while preserving every other field
/// (including the lower-time-baked `position_mask`). Used by every
/// alt-walker post-pass — `lower_alt_body`, `lower_lr_alt_suffix`,
/// `lower_single_alt_group`, `lower_general_group` — so a future
/// `RepeatOp` field addition only needs to touch this builder.
fn patch_repeat_op_caller_follow(rep_op: &RepeatOp, caller_follow_first: Array<String>, caller_follow_second: Array<String>) -> RepeatOp {
    return RepeatOp {
        kind: rep_op.kind,
        body: rep_op.body,
        scan_body: rep_op.scan_body,
        strategy: rep_op.strategy,
        field: rep_op.field,
        caller_follow_first: caller_follow_first,
        position_mask: rep_op.position_mask,
        k_prefix_mask: rep_op.k_prefix_mask,
        caller_follow_second: caller_follow_second,
        body_scannable: rep_op.body_scannable,
        body_has_field: rep_op.body_has_field,
        body_first_set: rep_op.body_first_set,
        body_is_single_alt_group: rep_op.body_is_single_alt_group,
        body_second_position_first: rep_op.body_second_position_first,
        body_shape: rep_op.body_shape,
    };
}

/// True iff `elem` is a list-label (`+=`). Used by
/// `lower_repeat_op` to bypass the `_list`-suffix base-name
/// computation: when a Repeat's inner is `name+=expr`, the label
/// name IS the array.
fn repeat_inner_is_list_label(elem: &Element) -> bool {
    if let Label(lab) = elem {
        return lab.list;
    }
    return false;
}

/// Outer struct field base name for a Repeat. `Star` / `Plus`
/// take a `_list` suffix on the inner element's base; `Optional`
/// uses the inner base unchanged. Mirrors `parser_gen`'s
/// `dedup_name(&"<inner>_list", ...)` / `dedup_name(&"<inner>", ...)`
/// pattern at field-info call sites.

/// Empty K-prefix mask sentinel for inner lowerings that sit at a
/// different input depth than the surrounding alt position (Repeat iter
/// bodies, transparent rebinds where the K-prefix is not yet
/// propagated). Returning an owned empty array keeps the type-inference
/// for `Array<Array<String>>` without an `as` annotation at every call
/// site.
fn empty_k_prefix() -> Array<Array<String>> {
    return [];
}

/// outer field name embeds this id (`group_<id>_list`); the
/// subsequent inner lowering consumes the same id and increments
/// the counter. Other shapes ignore this parameter.
fn repeat_outer_base_name(elem: &Element, kind: RepeatKind, gc_speculative: i32) -> String {
    let base = repeat_inner_base_name(elem, gc_speculative);
    return match kind {
        Optional => base,
        Star | Plus => `{base}_list`,
    };
}

/// Inner element's base name, mirroring `gen_util::element_base_name`
/// but inlined here so the lowering boundary stays self-contained.
fn repeat_inner_base_name(elem: &Element, gc_speculative: i32) -> String {
    return match elem {
        TokenRef(t) => t.field_name,
        Literal(l) => literal_field_name(&l.text),
        RuleRef(r) => r.field_name,
        Wildcard(_) => "wildcard",
        Not(ne) => not_element_field_name(&ne.element),
        Label(lab) => lab.field_name,
        Group(g) => repeat_inner_group_base_name(g, gc_speculative),
        Repeat(_) => panic("Nested Repeat (e**) is not valid g4 syntax"),
    };
}

/// Base name for a Group element when it appears as a Repeat's
/// inner — selects the Group shape's field-base helper that
/// matches the classifier. For a General-Group inner, embeds the
/// caller's speculative `group_counter` value (the same id the
/// inner lowering will consume).
fn repeat_inner_group_base_name(g: &GroupElement, gc_speculative: i32) -> String {
    let alts = &g.alternatives;
    if alts.len() == 1 {
        let alt = &alts[0];
        if alt.elements.len() == 1 {
            // Transparent (single-element single-alt) — peel through
            // to the inner element and let it pick the name.
            return repeat_inner_base_name(&alt.elements[0], gc_speculative);
        }
        return single_alt_group_field_name(alt);
    }
    if is_token_only_group(alts) {
        return token_group_field_name(alts);
    }
    if is_simple_cst_group(alts) {
        return group_field_base_name(alts);
    }
    if is_general_group(alts) {
        // The General group's CST type uses `group_<idx>` where
        // `<idx>` is the per-rule `group_counter` value at the
        // point the lowering visits it. The Repeat is the first
        // visitor (computing its outer field name) but defers the
        // actual increment to the subsequent inner-Op lowering, so
        // we just embed the same speculative value here.
        return general_group_field_name(gc_speculative);
    }
    panic("Group shape unrecognised by classifier (Repeat inner base name)");
}

/// Lower a `Label` element by recursively lowering its inner
/// element, then overriding the inner op's field name with the
/// label's name (deduped against the surrounding alt's name table).
///
/// Mirrors `parser_gen::gen_element`'s scalar-Label arm: the inner
/// emission would have produced its own field name, but the label
/// rebinds the value under `lab.field_name`. Phase 2.1 only allows
/// labels around leaf elements; nested `Repeat` / `Group` inside a
/// label requires the matching lowerings (Phase 2.3+) before the
/// rebind can be expressed. List labels (`+=`) need an additional
/// `Array<...>`-typed wrapper field; that wrapping is handled by
/// the CST `FieldDecl` enumeration in Phase 2.9.
fn lower_label_op(lab: &LabelElement, name_counts: &mut Array<[String, i32]>, rule_name: &String, ctx: &mut GenContext, group_counter: &mut i32, outer_follow: &Array<String>, outer_k_prefix: &Array<Array<String>>, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>, outer_position_mask: &Array<String>, outer_k_prefix_position_mask: &Array<Array<String>>) -> Op {
    let label_field = dedup_name(&lab.field_name, name_counts);
    let mut inner_counts: Array<[String, i32]> = [];
    // A label `name=elem` is positionally identical to `elem` at the
    // surrounding alt, so both K-prefix masks propagate verbatim — the
    // RuleRef inside the label still sees the same caller continuation,
    // and a Repeat inside still sees the same variant K-prefix at its
    // tail position.
    let inner_op = lower_op(
        &lab.element,
        &mut inner_counts,
        rule_name,
        ctx,
        group_counter,
        outer_follow,
        outer_k_prefix,
        variant_mask,
        variant_k_prefix_mask,
        outer_position_mask,
        outer_k_prefix_position_mask,
    );
    if lab.list {
        // `name+=elem` outside a Repeat: the outer CST struct stores
        // the matched value in an `Array<inner_type>`. Wrap the inner
        // op so `op_field_decl` produces the `Array<>` typing.
        // Inside a Repeat, `lower_repeat_op` adopts the label name
        // directly (the Repeat itself implies `Array<>`); that path
        // skips this wrapper.
        return Op::ListLabel(ListLabelOp {
            field: label_field,
            inner: inner_op,
            dedup_base: lab.field_name,
        });
    }
    // Scalar `name = elem` rebind. Pass `lab.field_name` as the new
    // dedup_base so emit's leaf sync bumps the rebound name (the only
    // binding that actually surfaces in the generated source) rather
    // than the inner element's elided base.
    return rebind_op_field(inner_op, &label_field, &lab.field_name);
}

/// Enumerate the CST struct fields for an alt's `ops` list. The
/// leading `span: Span` is always present; the rest map 1:1 from
/// the lowered op list. Transparent `Group` ops contribute their
/// inner op's field instead (the group itself has no struct slot).
///
/// Mirrors what `gen_util::element_field_info` computed at emit
/// time, but consumes the lowered IR so the field name and type
/// agree with whatever shape the lowering chose. emit reads this
/// list directly to lay out the struct.
fn enumerate_alt_field_decls(ops: &Array<Op>) -> Array<FieldDecl> {
    let mut fields: Array<FieldDecl> = [FieldDecl {
            name: "span",
            type_str: "Span",
            kind: FieldKind::Span,
        }];
    let op_fields = enumerate_op_field_decls(ops);
    for let f of &op_fields {
        fields.push(*f);
    }
    return fields;
}

/// Like `enumerate_alt_field_decls` but without the leading `span`
/// entry. Used by nested struct shapes (`SingleAlt`, General-group
/// alt struct) whose containers do not carry their own span field —
/// the surrounding rule-level alt struct owns the span.
fn enumerate_op_field_decls(ops: &Array<Op>) -> Array<FieldDecl> {
    let mut fields: Array<FieldDecl> = [];
    for let op of ops {
        if let Some(decl) = op_field_decl(op) {
            fields.push(decl);
        }
    }
    return fields;
}

/// Single-op field decl. Returns `None` when the op contributes no
/// struct field (Transparent groups inline their inner; Repeats
/// over zero-field inners would do the same once supported).
fn op_field_decl(op: &Op) -> Option<FieldDecl> {
    return match op {
        Token(t) => Option::<FieldDecl>::Some(FieldDecl {
            name: t.field,
            type_str: "Token",
            kind: FieldKind::Plain,
        }),
        Literal(l) => Option::<FieldDecl>::Some(FieldDecl {
            name: l.field,
            type_str: "Token",
            kind: FieldKind::Plain,
        }),
        RuleCall(r) => Option::<FieldDecl>::Some(FieldDecl {
            name: r.field,
            type_str: rule_type_name(&r.target_name),
            kind: FieldKind::Plain,
        }),
        Wildcard(w) => Option::<FieldDecl>::Some(FieldDecl {
            name: w.field,
            type_str: "Token",
            kind: FieldKind::Plain,
        }),
        Excluded(e) => Option::<FieldDecl>::Some(FieldDecl {
            name: e.field,
            type_str: "Token",
            kind: FieldKind::Plain,
        }),
        Repeat(rep) => repeat_field_decl(rep),
        Group(g) => group_field_decl(g),
        ListLabel(ll) => list_label_field_decl(ll),
    };
}

/// FieldDecl for a `name+=elem` list-label outside a Repeat. The
/// inner op contributes its bare type via
/// `op_field_decl_for_repeat_inner` (so SimpleCst / General payloads
/// are NOT pre-wrapped in `Option<>`) and we wrap once in `Array<>`.
fn list_label_field_decl(ll: &ListLabelOp) -> Option<FieldDecl> {
    let inner_decl = op_field_decl_for_repeat_inner(&ll.inner);
    return match &inner_decl {
        Some(d) => Option::<FieldDecl>::Some(FieldDecl {
            name: ll.field,
            type_str: `Array<{d.type_str}>`,
            kind: FieldKind::List,
        }),
        null => null,
    };
}

fn repeat_field_decl(rep: &RepeatOp) -> Option<FieldDecl> {
    // Inside a Repeat the SimpleCst / General payload appears
    // verbatim (`Array<FooGroup>` / `Option<FooGroup>`) — the outer
    // Repeat wraps for us. Use the Repeat-inner variant so we don't
    // double-wrap.
    let inner_decl = op_field_decl_for_repeat_inner(&rep.body);
    let inner_type = match &inner_decl {
        Some(d) => d.type_str,
        // No-field inner (e.g. transparent group with no leaf type
        // resolution). The Repeat then has no struct field either —
        // emit doesn't allocate storage for it.
        null => {
            return null;
        },
    };
    return match rep.kind {
        Optional => Option::<FieldDecl>::Some(FieldDecl {
            name: rep.field,
            type_str: `Option<{inner_type}>`,
            kind: FieldKind::Optional,
        }),
        Star | Plus => Option::<FieldDecl>::Some(FieldDecl {
            name: rep.field,
            type_str: `Array<{inner_type}>`,
            kind: FieldKind::List,
        }),
    };
}

/// `op_field_decl` variant that produces the *unwrapped* inner type
/// for `SimpleCst` / `General` groups inside a Repeat. The Repeat
/// itself adds the outer `Array<>` / `Option<>` wrap; the
/// non-Repeat top-level path (`op_field_decl`) wraps SimpleCst /
/// General payloads in `Option<>` to mirror parser_gen's
/// `gen_consume_group_store_optional` / `gen_general_group_store_optional`.
fn op_field_decl_for_repeat_inner(op: &Op) -> Option<FieldDecl> {
    if let Group(g) = op {
        return match &g.shape {
            Transparent => transparent_group_inner_decl(g),
            TokenOnly(to) => Option::<FieldDecl>::Some(FieldDecl {
                name: to.field,
                type_str: "Token",
                kind: FieldKind::Plain,
            }),
            SimpleCst(scst) => Option::<FieldDecl>::Some(FieldDecl {
                name: scst.field,
                type_str: scst.type_name,
                kind: FieldKind::Plain,
            }),
            SingleAlt(sa) => Option::<FieldDecl>::Some(FieldDecl {
                name: sa.field,
                type_str: sa.struct_name,
                kind: FieldKind::Plain,
            }),
            General(gen) => Option::<FieldDecl>::Some(FieldDecl {
                name: gen.field,
                type_str: gen.variant_type,
                kind: FieldKind::Plain,
            }),
        };
    }
    return op_field_decl(op);
}

fn group_field_decl(g: &GroupOp) -> Option<FieldDecl> {
    return match &g.shape {
        // Transparent groups inline their single inner op; there
        // is no group-level field. The inner op's decl was already
        // pushed by the surrounding `enumerate_alt_field_decls`
        // — except… it wasn't, because the Group op IS the only
        // entry in the alt's op list at that position. We need to
        // hand back the inner's decl directly.
        Transparent => transparent_group_inner_decl(g),
        TokenOnly(to) => Option::<FieldDecl>::Some(FieldDecl {
            name: to.field,
            type_str: "Token",
            kind: FieldKind::Plain,
        }),
        // Standalone SimpleCst / General groups surface as
        // `Option<>`-typed fields because parser_gen's
        // `gen_consume_group_store_optional` /
        // `gen_general_group_store_optional` initialise the slot to
        // `None` and only populate on a successful dispatch.
        SimpleCst(scst) => Option::<FieldDecl>::Some(FieldDecl {
            name: scst.field,
            type_str: `Option<{scst.type_name}>`,
            kind: FieldKind::Optional,
        }),
        SingleAlt(sa) => Option::<FieldDecl>::Some(FieldDecl {
            name: sa.field,
            type_str: sa.struct_name,
            kind: FieldKind::Plain,
        }),
        General(gen) => Option::<FieldDecl>::Some(FieldDecl {
            name: gen.field,
            type_str: `Option<{gen.variant_type}>`,
            kind: FieldKind::Optional,
        }),
    };
}

/// Transparent groups have exactly one alt whose body is one op.
/// The wrapper has no struct field of its own: `parser_gen`'s
/// `has_field(Group)` returns `is_storable_group(...)`, which is
/// false for transparent (1-alt, 1-element) groups. Matching that
/// decision here ensures `body.fields` agrees with what emit's
/// runtime construction actually assigns — a transparent `(X)` at
/// outer alt level contributes nothing to the outer CST struct.
fn transparent_group_inner_decl(_g: &GroupOp) -> Option<FieldDecl> {
    return null;
}

/// Replace the `field` slot of an op with `new_field` and the
/// `dedup_base` slot of leaf ops with `new_dedup_base`. Covers every
/// Op variant — labels can wrap any inner shape, and the rebind only
/// rewrites the outermost field slot:
///
/// * Leaf ops carry their field and `dedup_base` directly — replace
///   both. `new_dedup_base` is the surface base name lower would have
///   passed to `dedup_name` for the *rebound* binding (e.g.
///   `lab.field_name` for `name = ID`, `lab.field_name` for the
///   `(name+=elem)*` outer Repeat). The inner element's original
///   `dedup_base` is intentionally dropped: the rebind elides the
///   inner binding from emit, so its base name is no longer in scope
///   and emit's `name_counts` should not pretend it is.
/// * `Repeat` carries the outer struct field on `RepeatOp.field`
///   (the per-iteration `body.field` lives in its own scope and is
///   unaffected). Repeat ops have no `dedup_base` of their own —
///   `new_dedup_base` is unused for this arm.
/// * `Group` shapes carry their outer field inside the shape payload
///   (`TokenOnly.field`, `SimpleCst.field`, etc.); the `Transparent`
///   shape has no field of its own and the label passes through to
///   the inner op. Group payloads have no `dedup_base` —
///   `new_dedup_base` is unused for this arm.
/// * `ListLabel` carries `dedup_base` itself; rebinding the outer
///   field here updates `dedup_base` to `new_dedup_base` for the same
///   reason as the leaf arms.
fn rebind_op_field(op: Op, new_field: &String, new_dedup_base: &String) -> Op {
    return match op {
        Token(t) => Op::Token(TokenOp { kind: t.kind, field: *new_field, dedup_base: *new_dedup_base }),
        Literal(l) => Op::Literal(LiteralOp { kind: l.kind, field: *new_field, dedup_base: *new_dedup_base }),
        RuleCall(r) => Op::RuleCall(RuleCallOp {
            target_name: r.target_name,
            target_snake: r.target_snake,
            variant_id: r.variant_id,
            min_prec_arg: r.min_prec_arg,
            field: *new_field,
            dedup_base: *new_dedup_base,
        }),
        Wildcard(_) => Op::Wildcard(WildcardOp { field: *new_field, dedup_base: *new_dedup_base }),
        Excluded(e) => Op::Excluded(ExcludedOp { kinds: e.kinds, field: *new_field, dedup_base: *new_dedup_base }),
        Repeat(rep) => Op::Repeat(RepeatOp {
            kind: rep.kind,
            body: rep.body,
            scan_body: rep.scan_body,
            strategy: rep.strategy,
            field: *new_field,
            caller_follow_first: rep.caller_follow_first,
            position_mask: rep.position_mask,
            k_prefix_mask: rep.k_prefix_mask,
            caller_follow_second: rep.caller_follow_second,
            body_scannable: rep.body_scannable,
            body_has_field: rep.body_has_field,
            body_first_set: rep.body_first_set,
            body_is_single_alt_group: rep.body_is_single_alt_group,
            body_second_position_first: rep.body_second_position_first,
            body_shape: rep.body_shape,
        }),
        Group(g) => Op::Group(GroupOp {
            shape: rebind_group_shape(g.shape, new_field),
            alts: g.alts,
            scan_alts: g.scan_alts,
            dispatch: g.dispatch,
            scan_dispatch: g.scan_dispatch,
        }),
        ListLabel(ll) => rebind_list_label_op(ll, new_field, new_dedup_base),
    };
}

fn rebind_list_label_op(ll: ListLabelOp, new_field: &String, new_dedup_base: &String) -> Op {
    return Op::ListLabel(ListLabelOp {
        inner: ll.inner,
        field: *new_field,
        dedup_base: *new_dedup_base,
    });
}

fn rebind_group_shape(shape: GroupShape, new_field: &String) -> GroupShape {
    return match shape {
        // Transparent groups inline their inner op; the label
        // rebinds the inner op's field directly. The Group node
        // itself has no field slot, so return the shape unchanged
        // — the caller's `rebind_op_field` should have recursed
        // into the inner op instead. Keep this as the unreachable
        // arm rather than crashing: a label on a Transparent group
        // is uncommon and emit's existing path handles it via the
        // inner op's field.
        Transparent => GroupShape::Transparent,
        TokenOnly(to) => GroupShape::TokenOnly(TokenOnlyShape { field: *new_field }),
        SimpleCst(scst) => GroupShape::SimpleCst(SimpleCstShape {
            type_name: scst.type_name,
            field: *new_field,
        }),
        SingleAlt(sa) => GroupShape::SingleAlt(SingleAltShape {
            struct_name: sa.struct_name,
            field: *new_field,
            owner_rule: sa.owner_rule,
        }),
        General(gen) => GroupShape::General(GeneralShape {
            variant_type: gen.variant_type,
            alt_struct_names: gen.alt_struct_names,
            field: *new_field,
            group_index: gen.group_index,
        }),
    };
}

/// Resolve the exclusion set for a `~ X` element.
///
/// * `~ TOKEN` / `~ 'lit'` — single-token complement, the simple case.
/// * `~ ( A | B | C )` — multi-token complement; each alt must be a
///   single `TokenRef` or `Literal` (mirrors `parser_gen::collect_not_set_tokens`).
///
/// Other inner shapes (`~ rule`, `~ ( a b )`) are not supported by
/// the runtime helpers (`p.match_not([...])`) and aren't expected
/// in committed grammars.
fn collect_excluded_kinds(inner: &Element) -> Array<String> {
    return match *inner {
        TokenRef(t) => [`TK_{t.name}`],
        Literal(l) => [literal_const_name(&l.text)],
        Group(g) => collect_excluded_kinds_from_group(&g),
        _ => panic(
            "collect_excluded_kinds: unsupported inner shape (only TokenRef / Literal / single-token-alts Group are valid)",
        ),
    };
}

fn collect_excluded_kinds_from_group(g: &GroupElement) -> Array<String> {
    let mut kinds: Array<String> = [];
    for let alt of &g.alternatives {
        assert alt.elements.len() == 1, "collect_excluded_kinds: ~ Group alt must be a single token / literal";
        let elem = &alt.elements[0];
        match *elem {
            TokenRef(t) => kinds.push(`TK_{t.name}`),
            Literal(l) => kinds.push(literal_const_name(&l.text)),
            _ => panic("collect_excluded_kinds: ~ Group alt must be a single token / literal"),
        }
    }
    return kinds;
}

/// Field-name deduplication mirroring `gen_util::dedup_name`. The
/// first occurrence keeps the base name; subsequent occurrences get
/// `<base>_<n>` for `n = 2, 3, ...`.
///
/// Re-implemented here (not imported from `parser_gen.wado`) because
/// Phase 4's split will move every emit-side helper out of
/// `parser_gen.wado`; sharing utilities cross-file before the split
/// would just create import churn for a few lines of straightforward
/// counting.
fn dedup_name(base: &String, counts: &mut Array<[String, i32]>) -> String {
    let count = get_count(counts, base);
    increment_count(counts, base);
    if count > 0 {
        return `{*base}_{count + 1}`;
    }
    return *base;
}

fn get_count(counts: &Array<[String, i32]>, name: &String) -> i32 {
    for let entry of counts {
        if entry.0 == *name {
            return entry.1;
        }
    }
    return 0;
}

fn increment_count(counts: &mut Array<[String, i32]>, name: &String) {
    for let mut i = 0; i < counts.len(); i += 1 {
        if counts[i].0 == *name {
            let prev = counts[i].1;
            counts[i] = [*name, prev + 1];
            return;
        }
    }
    counts.push([*name, 1]);
}
