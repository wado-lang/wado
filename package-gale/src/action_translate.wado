//! Identity translator (`language = Wado`): rewrite an action body's
//! `$`-references to Wado expressions over the value channel, leaving the
//! surrounding host text (already Wado) verbatim. A reference the current subset
//! cannot emit returns a loud error naming it, so codegen surfaces a diagnostic
//! rather than emitting invalid code. Shared with java2wado via `resolve_attr_ref`.

use { ParserRule, AttrDecl, AltAction } from "./ir.wado";
use { resolve_attrs, ResolvedAttr, AttrTarget } from "./attr_resolve.wado";
use { find_attr_refs, AttrRef } from "./attr_scan.wado";
use { splice_attrs } from "./attr_substitute.wado";
use { to_pascal_case, to_snake_case, escape_ident } from "./ident.wado";
use { is_self_ref_element } from "./lr_util.wado";

/// Name of a rule's value-channel struct (`e` -> `EVals`).
pub fn vals_struct_name(rule: &ParserRule) -> String {
    return `${to_pascal_case(&rule.name)}Vals`;
}

/// The recognizer handle in emitted context-API calls (`p.token_text(...)`):
/// `p` in a parse / predicate body, `self` in a `@members` method body.
pub global PARSER_HANDLE: String = "p";

/// The lexer handle in emitted lexer-action calls (`lx.emit(...)`): the
/// `&mut Lexer` parameter of the generated `apply_<rule>_actions`.
pub global LEXER_HANDLE: String = "lx";

/// Translate `body` against `rule`'s environment, resolving `$`-refs over the
/// value channel and leaving surrounding Wado verbatim. `vals_in_scope` is true
/// when the enclosing rule emits a `vals` local. Errors on the first unsupported
/// reference.
pub fn translate_wado_action(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    body: &String,
    vals_in_scope: bool,
    bindings: &List<[bool, String, String]>,
    handle: &String = &PARSER_HANDLE,
) -> Result<String, String> {
    let resolved = resolve_attrs(body, rule, rules, bindings)?;
    let body_chars: List<char> = body.chars().collect();
    let mut adjusted: List<ResolvedAttr> = [];
    let mut repls: List<String> = [];
    for let r of &resolved {
        let e = action_attr_expr(rule, rules, r, vals_in_scope, bindings, handle)?;
        repls.push(e);
        let mut r2 = *r;
        if is_ctx_to_string_tree(r) {
            r2.end = swallow_trailing_call(&body_chars, r.end);
        }
        adjusted.push(r2);
    }
    return Result::Ok(splice_attrs(body, &adjusted, &repls));
}

/// Resolve a single `$name(.member)?` reference to its Wado expression, shared
/// by the identity translator and java2wado (attribute resolution is
/// language-independent). `ref_text` is exactly the reference (`$x`, `$x.v`).
pub fn resolve_attr_ref(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    ref_text: &String,
    vals_in_scope: bool,
    bindings: &List<[bool, String, String]>,
    handle: &String = &PARSER_HANDLE,
) -> Result<String, String> {
    return translate_wado_action(rule, rules, ref_text, vals_in_scope, bindings, handle);
}

/// The single source of truth for the `$ctx.toStringTree` special: a `ctx`
/// reference with the `toStringTree` member.
fn is_ctx_to_string_tree_ref(name: &String, member: &Option<String>) -> bool {
    return *name == "ctx" && *member matches { Some("toStringTree") };
}

fn is_ctx_to_string_tree(r: &ResolvedAttr) -> bool {
    return r.target matches { ParserSpecial } && is_ctx_to_string_tree_ref(&r.name, &r.member);
}

/// Whether `ref_text` is exactly the `$ctx.toStringTree` special. Its Wado form
/// is a nullary call (`rule_string_tree()`), so a host action's trailing
/// `(...)` / `(this)` — the parser argument ANTLR's `toStringTree(this)` needs
/// but Gale does not — is redundant and swallowed. Shared with java2wado, whose
/// `$`-attr lexer captures `$ctx.toStringTree` as the call target.
pub fn ref_is_ctx_to_string_tree(ref_text: &String) -> bool {
    let refs = find_attr_refs(ref_text);
    return refs.len() == 1 && is_ctx_to_string_tree_ref(&refs[0].name, &refs[0].member);
}

/// Extend past an immediately-following call `(...)` (skipping leading spaces),
/// so `$ctx.toStringTree()` and `$ctx.toStringTree(this)` both reduce to a bare
/// call. Bails (returns `end` unchanged) if a nested `$`-ref lives inside the
/// parens — that ref is spliced on its own.
fn swallow_trailing_call(chars: &List<char>, end: i32) -> i32 {
    let n = chars.len();
    let mut j = end;
    while j < n && chars[j].is_ascii_whitespace() {
        j += 1;
    }
    if j >= n || chars[j] != '(' {
        return end;
    }
    let mut depth = 0;
    for let mut k = j; k < n; k += 1 {
        match chars[k] {
            '$' => {
                return end;
            },
            '(' => depth += 1,
            ')' => {
                depth -= 1;
                if depth == 0 {
                    return k + 1;
                }
            },
            _ => {
            },
        }
    }
    return end;
}

/// The actual local a `$ref` binds to: the post-dedup binding (so `e_2` resolves
/// correctly), falling back to `base` when the reference is not in the map.
fn binding_for(bindings: &List<[bool, String, String]>, is_token: bool, base: &String) -> String {
    return match bindings.iter().find(|b: &[bool, String, String]| b.0 == is_token && b.1 == *base) {
        Some(b) => b.2,
        None => *base,
    };
}

/// The rule's first token index, captured at rule entry; read by a `$text` /
/// `$start` / `$stop` substitution.
pub global RULE_START_TOK_LOCAL: String = "_rule_start_tok";

/// The locals a labeled rule call captures around itself so `$<label>.text` can
/// read that invocation's own token range. Emitted only where an action reads it
/// (`action_reads_rule_span`), so every other call site is unchanged.
pub fn rule_span_lo_local(field: &String) -> String {
    return `_span_lo_${*field}`;
}

pub fn rule_span_hi_local(field: &String) -> String {
    return `_span_hi_${*field}`;
}

/// Whether `body` reads `$<label>.text` for the rule-call binding `dedup_base`,
/// the one reference that needs the call's token range captured.
pub fn action_reads_rule_span(body: &String, dedup_base: &String) -> bool {
    for let r of &find_attr_refs(body) {
        if r.member matches { Some("text") } && binding_name(&r.name) == *dedup_base {
            return true;
        }
    }
    return false;
}

/// The precedence-threshold parameter a left-recursive rule fn carries; read
/// by a `$_p` substitution in an LR rule (elsewhere `$_p` is the literal 0).
global MIN_PREC_LOCAL: String = "min_prec";

/// The LR precedence-climbing accumulator local (`gen_lr_fn`), holding the left
/// operand's vals. java2wado maps `((Ctx)$ctx).<rule>(0)` onto it.
pub global LR_ACC_LOCAL: String = "_lr_acc";

/// The Wado local a rule-child reference binds to (post-dedup), for a rule child
/// named `name` — the same lookup the identity translator uses for `$rule`.
/// Shared with java2wado's ctx-child accessor (`((Ctx)$ctx).<rule>(k)`).
pub fn rule_binding_for(bindings: &List<[bool, String, String]>, name: &String) -> String {
    return binding_for(bindings, false, &binding_name(name));
}

/// Whether any of `rule`'s actions references a rule-span special (`$text`,
/// `$start`, `$stop`), so codegen must capture the rule's start token before the
/// body.
pub fn rule_uses_rule_span(rule: &ParserRule, rules: &List<ParserRule>) -> bool {
    if let Some(a) = &rule.init_action {
        if body_uses_rule_span(&a.text, rule, rules) {
            return true;
        }
    }
    if let Some(a) = &rule.after_action {
        if body_uses_rule_span(&a.text, rule, rules) {
            return true;
        }
    }
    for let alt of &rule.alternatives {
        for let a of &alt.actions {
            if body_uses_rule_span(&a.source.text, rule, rules) {
                return true;
            }
        }
    }
    return false;
}

fn body_uses_rule_span(body: &String, rule: &ParserRule, rules: &List<ParserRule>) -> bool {
    if let Ok(resolved) = resolve_attrs(body, rule, rules) {
        for let r of &resolved {
            if r.target matches { ParserSpecial } && (r.name == "text" || r.name == "start" || r.name == "stop") {
                return true;
            }
        }
    }
    return false;
}

/// The Wado expression a resolved reference becomes, or an error if this
/// slice cannot emit it yet.
fn action_attr_expr(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    r: &ResolvedAttr,
    vals_in_scope: bool,
    bindings: &List<[bool, String, String]>,
    handle: &String,
) -> Result<String, String> {
    if r.target matches { ParserSpecial } {
        return parser_special_expr(r, rule_is_left_recursive(rule), handle);
    }
    return match r.target {
        RuleAttr => {
            if is_arg(rule, &r.name) {
                if !rule_threads_args(rule) {
                    Result::Err(
                        `$${r.name}: rule arguments are threaded only for single-alt rules with defaultable arg types`,
                    );
                } else if !vals_in_scope {
                    Result::Err(`$${r.name}: no value channel in the enclosing rule`);
                } else {
                    Result::Ok(`vals.${r.name}`);
                }
            } else if field_default(rule, &r.name) matches { None } {
                Result::Err(
                    `$${r.name}: value-channel field type '${field_type(rule, &r.name)}' has no Wado default`,
                );
            } else if !vals_in_scope {
                Result::Err(`$${r.name}: no value channel in the enclosing rule`);
            } else {
                Result::Ok(`vals.${r.name}`);
            }
        },
        RuleLabel => rule_member_expr(rules, r, bindings, handle),
        RuleRef => rule_member_expr(rules, r, bindings, handle),
        TokenLabel => token_member_expr(r, bindings, handle),
        TokenRef => token_member_expr(r, bindings, handle),
        _ => Result::Err(`$${r.name}: this attribute form is not yet emitted`),
    };
}

/// A parser special: `$text` is the consumed input span, `$start`/`$stop` the
/// rule's first/last token, `$ctx.toStringTree` the node under construction,
/// `$_p` the current precedence threshold. Only a left-recursive rule fn carries
/// a `min_prec` parameter, so `$_p` reads `min_prec` there and the literal `0`
/// (its only value outside a precedence context) elsewhere. `$text`/`$start`
/// read the codegen-captured `_rule_start_tok`.
fn parser_special_expr(r: &ResolvedAttr, is_lr: bool, handle: &String) -> Result<String, String> {
    return match r.name {
        "text" && r.member matches { None } => Result::Ok(
            `${*handle}.rule_text(${RULE_START_TOK_LOCAL})`,
        ),
        "start" => token_member_of(&RULE_START_TOK_LOCAL, &r.member, handle),
        "stop" => token_member_of(&`(${*handle}.pos - 1)`, &r.member, handle),
        "ctx" && r.member matches { Some("toStringTree") } => {
            let method = if is_lr { "rule_string_tree_final" } else { "rule_string_tree" };
            Result::Ok(`${*handle}.${method}()`);
        },
        "_p" && r.member matches { None } => Result::Ok(if is_lr { MIN_PREC_LOCAL } else { "0" }),
        _ => Result::Err(`$${r.name}: this parser special is not yet emitted`),
    };
}

/// Translate a lexer predicate / action body (identity translator): resolve
/// lexer `$`-attributes to expressions over the match fn's `chars` / `start` /
/// `pos`, leaving the surrounding host text (already Wado) verbatim. Only
/// `$text` (the matched slice) is emitted today; any other `$`-reference is a
/// loud error, so codegen never emits an unresolved `$ref`. A `$`-free body
/// (`pos - start == 4`) passes through unchanged.
pub fn translate_lexer_predicate(body: &String) -> Result<String, String> {
    let raw = find_attr_refs(body);
    let mut refs: List<ResolvedAttr> = [];
    let mut replacements: List<String> = [];
    for let r of &raw {
        replacements.push(lexer_attr_expr(r)?);
        refs.push(ResolvedAttr {
            target: AttrTarget::LexerSpecial,
            name: r.name,
            member: r.member,
            rule_name: "",
            start: r.start,
            end: r.end,
        });
    }
    return Result::Ok(splice_attrs(body, &refs, &replacements));
}

/// Translate a lexer `{ ... }` action body (identity translator). Same
/// resolution as `translate_lexer_predicate` — `$text` maps to the matched
/// slice over the apply-fn's `chars` / `start` / `pos`, the rest passes through
/// verbatim (already Wado, calling the `lx` action-context API). A body that
/// references an unresolved `$`-attribute is a loud error.
pub fn translate_lexer_action(body: &String) -> Result<String, String> {
    return translate_lexer_predicate(body);
}

/// The match-fn expression for the text matched so far (`chars[start..pos]`),
/// which is what both `$text` and Java's `getText()` mean in a lexer body.
pub fn lexer_matched_text_expr() -> String {
    return "LexerSlice::new(chars, start, pos).to_string()";
}

/// The match-fn expression for the live match cursor's column within its line
/// (ANTLR4's `getCharPositionInLine()`).
pub fn lexer_cursor_column_expr() -> String {
    return "char_pos_in_line(chars, pos)";
}

/// The match-fn expression for the column the token started at (ANTLR4's
/// `_tokenStartCharPositionInLine`).
pub fn lexer_token_start_column_expr() -> String {
    return "char_pos_in_line(chars, start)";
}

/// The match-fn expression a lexer `$`-attribute becomes. `$text` is the slice
/// matched so far; other lexer attributes await their own resolution.
fn lexer_attr_expr(r: &AttrRef) -> Result<String, String> {
    if r.name == "text" && r.member matches { None } {
        return Result::Ok(lexer_matched_text_expr());
    }
    builtin::cold_path();
    return Result::Err(`$${r.name}: this lexer attribute is not yet emitted`);
}

/// Resolve one whole `$ref` occurrence (delimiters included) in a lexer body,
/// for a front end that has already isolated the reference (java2wado).
pub fn resolve_lexer_attr_ref(text: &String) -> Result<String, String> {
    let refs = find_attr_refs(text);
    if refs.len() != 1 {
        builtin::cold_path();
        return Result::Err(`lexer attribute: '${*text}' is not a single $-reference`);
    }
    return lexer_attr_expr(&refs[0]);
}

/// The local a call site binds a rule / label / token result to, matching
/// `RuleRefElement` / `LabelElement` field-name derivation.
fn binding_name(name: &String) -> String {
    return escape_ident(&to_snake_case(name));
}

/// A token reference resolves to its bound stream index; a member reads that
/// token through the context API.
fn token_member_expr(
    r: &ResolvedAttr,
    bindings: &List<[bool, String, String]>,
    handle: &String,
) -> Result<String, String> {
    return token_member_of(&binding_for(bindings, true, &binding_name(&r.name)), &r.member, handle);
}

/// A token member read on a token-index expression `idx`. `.index` is `idx`
/// itself and `.channel` is `0`; the rest go through the `token_*` context API.
fn token_member_of(idx: &String, member: &Option<String>, handle: &String) -> Result<String, String> {
    let m = match member {
        Some(m) => *m,
        None => {
            return Result::Ok(*idx);
        },
    };
    return match m {
        "text" => Result::Ok(`${*handle}.token_text(${*idx})`),
        "int" => Result::Ok(`${*handle}.token_int(${*idx})`),
        "type" => Result::Ok(`${*handle}.token_kind(${*idx})`),
        "line" => Result::Ok(`${*handle}.token_line(${*idx})`),
        "pos" => Result::Ok(`${*handle}.token_col(${*idx})`),
        "index" => Result::Ok(*idx),
        "channel" => Result::Ok(String::from("0")),
        _ => Result::Err(`.${m}: unknown token member`),
    };
}

fn rule_member_expr(
    rules: &List<ParserRule>,
    r: &ResolvedAttr,
    bindings: &List<[bool, String, String]>,
    handle: &String,
) -> Result<String, String> {
    let binding = binding_for(bindings, false, &binding_name(&r.name));
    // `.text` is the invocation's own span, not a value-channel field.
    if let Some(m) = &r.member && *m == "text" {
        return Result::Ok(
            `${*handle}.text_between(${rule_span_lo_local(&binding)}, ${rule_span_hi_local(&binding)})`,
        );
    }
    let target = match find_rule(rules, &r.rule_name) {
        Some(t) => t,
        None => {
            builtin::cold_path();
            return Result::Err(`$${r.name}: unknown referenced rule '${r.rule_name}'`);
        },
    };
    if !rule_returns_vals(&target) {
        builtin::cold_path();
        return Result::Err(
            `$${r.name}: rule '${r.rule_name}' does not expose a value channel (needs single-alt + defaultable returns/locals)`,
        );
    }
    return match &r.member {
        Some(m) => {
            if field_default(&target, m) matches { Some(_) } {
                Result::Ok(`${binding}.${*m}`);
            } else {
                Result::Err(`$${r.name}.${*m}: not an emittable value-channel field of '${r.rule_name}'`);
            }
        },
        None => Result::Ok(binding),
    };
}

fn find_rule(rules: &List<ParserRule>, name: &String) -> Option<ParserRule> {
    for let rule of rules {
        if rule.name == *name {
            return Option::Some(*rule);
        }
    }
    return null;
}

/// The `wado_type_default` of a rule's returns/locals field named `name`, or
/// `None` if there is no such field or its type has no Wado default.
fn field_default(rule: &ParserRule, name: &String) -> Option<String> {
    return match find_field(rule, name) {
        Some(d) => wado_type_default(&d.type_text),
        None => null,
    };
}

fn field_type(rule: &ParserRule, name: &String) -> String {
    return match find_field(rule, name) {
        Some(d) => d.type_text,
        None => "",
    };
}

fn find_field(rule: &ParserRule, name: &String) -> Option<AttrDecl> {
    for let d of &rule.returns_decls {
        if d.name == *name {
            return Option::Some(*d);
        }
    }
    for let d of &rule.locals_decls {
        if d.name == *name {
            return Option::Some(*d);
        }
    }
    return null;
}

fn is_arg(rule: &ParserRule, name: &String) -> bool {
    for let d of &rule.args {
        if d.name == *name {
            return true;
        }
    }
    return false;
}

/// Whether a rule exposes a value channel to callers (a defaultable
/// `returns`/`locals`, or threaded args), so `_parse_<rule>` returns `<Rule>Vals`
/// and a caller's `$a.v` reads it. Independent of whether the rule's own actions
/// read the channel — a caller might.
pub fn rule_returns_vals(rule: &ParserRule) -> bool {
    return rule_value_channel_ready(rule);
}

/// Whether any alternative is directly left-recursive (its first element
/// references the rule itself). Mirrors lowering's LR classification at the
/// surface level so the value-channel decision can exclude LR rules without a
/// lowered `Rule`.
pub fn rule_is_left_recursive(rule: &ParserRule) -> bool {
    for let alt of &rule.alternatives {
        if !alt.elements.is_empty() && is_self_ref_element(&alt.elements[0], &rule.name) {
            return true;
        }
    }
    return false;
}

/// Whether a rule exposes an emittable value channel: a returns / locals field
/// whose type has a Wado default, or threaded rule arguments. Unsupported-type
/// fields are excluded per-field, so one does not disable the whole channel.
pub fn rule_value_channel_ready(rule: &ParserRule) -> bool {
    for let d of &rule.returns_decls {
        if wado_type_default(&d.type_text) matches { Some(_) } {
            return true;
        }
    }
    for let d of &rule.locals_decls {
        if wado_type_default(&d.type_text) matches { Some(_) } {
            return true;
        }
    }
    return rule_threads_args(rule);
}

/// Whether a rule's arguments are threaded as `_parse_<rule>` parameters and
/// stored into its `<Rule>Vals`: a non-left-recursive rule every arg type of
/// which has a Wado default. Otherwise `$arg` is a loud error.
pub fn rule_threads_args(rule: &ParserRule) -> bool {
    if rule_is_left_recursive(rule) {
        return false;
    }
    if rule.args.is_empty() {
        return false;
    }
    for let a of &rule.args {
        if wado_type_default(&a.type_text) matches { None } {
            return false;
        }
    }
    return true;
}

/// Whether a returns / locals field goes into the `<Rule>Vals` struct: its type
/// has a Wado default.
pub fn field_in_vals(d: &AttrDecl) -> bool {
    return wado_type_default(&d.type_text) matches { Some(_) };
}

/// A Wado default-value expression for a value-channel field type, or `None` if
/// the type has no known Wado default (a non-Wado name like `int` is skipped).
pub fn wado_type_default(type_text: &String) -> Option<String> {
    let t = type_text.trim();
    if t == "bool" {
        return Option::Some("false");
    }
    if t == "String" {
        return Option::Some("\"\"");
    }
    if t.starts_with("List") || t.starts_with("[") {
        return Option::Some("[]");
    }
    if is_numeric_type(&t) {
        return Option::Some("0");
    }
    return null;
}

fn is_numeric_type(t: &String) -> bool {
    return *t == "i8"
        || *t == "i16"
        || *t == "i32"
        || *t == "i64"
        || *t == "u8"
        || *t == "u16"
        || *t == "u32"
        || *t == "u64"
        || *t == "f32"
        || *t == "f64"
        || *t == "usize"
        || *t == "isize";
}
