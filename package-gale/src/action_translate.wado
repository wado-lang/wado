//! Identity translator (`language = Wado`): rewrite an action body's
//! `$`-references to Wado expressions over the value channel, leaving the
//! surrounding host text (already Wado) verbatim.
//!
//! This slice covers a rule's own value channel — `$v` / `$local` map to
//! the `vals` struct local emitted in the rule function. References that
//! need infrastructure not yet emitted (rule arguments, cross-rule
//! `$a.v`, token members via the context API, specials) return a loud
//! error naming the reference, so codegen surfaces a diagnostic rather
//! than emitting invalid code. The supported subset grows as the value
//! channel and context API land.

use { ParserRule, AttrDecl, AltAction } from "./ir.wado";
use { resolve_attrs, ResolvedAttr, AttrTarget } from "./attr_resolve.wado";
use { splice_attrs } from "./attr_substitute.wado";
use { to_pascal_case, to_snake_case, escape_ident } from "./ident.wado";
use { is_self_ref_element } from "./lr_util.wado";

/// Name of a rule's value-channel struct (`e` -> `EVals`).
pub fn vals_struct_name(rule: &ParserRule) -> String {
    return `{to_pascal_case(&rule.name)}Vals`;
}

/// Translate `body` against `rule`'s environment. `vals_in_scope` is true
/// when the enclosing rule emits a `vals` local (so `$v` / `$local` can be
/// served). Returns ready-to-emit Wado, or an error naming the first
/// unsupported reference.
pub fn translate_wado_action(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    body: &String,
    vals_in_scope: bool,
    rule_text_in_scope: bool,
) -> Result<String, String> {
    let resolved = resolve_attrs(body, rule, rules)?;
    let mut repls: List<String> = [];
    for let r of &resolved {
        let e = action_attr_expr(rule, rules, r, vals_in_scope, rule_text_in_scope)?;
        repls.push(e);
    }
    return Result::<String, String>::Ok(splice_attrs(body, &resolved, &repls));
}

/// The `let _rule_text_start = p.peek_start();` local a `$text`-substituted
/// action reads. Named once so codegen (which emits it at inner-body entry) and
/// the translator (which references it) cannot diverge.
pub global RULE_TEXT_START_LOCAL: String = "_rule_text_start";

/// Whether any of `rule`'s actions references the `$text` special, so codegen
/// must capture the rule's start byte before the body.
pub fn rule_uses_parser_text(rule: &ParserRule, rules: &List<ParserRule>) -> bool {
    if let Some(a) = &rule.init_action {
        if body_uses_parser_text(&a.text, rule, rules) {
            return true;
        }
    }
    if let Some(a) = &rule.after_action {
        if body_uses_parser_text(&a.text, rule, rules) {
            return true;
        }
    }
    for let alt of &rule.alternatives {
        for let a of &alt.actions {
            if body_uses_parser_text(&a.source.text, rule, rules) {
                return true;
            }
        }
    }
    return false;
}

fn body_uses_parser_text(body: &String, rule: &ParserRule, rules: &List<ParserRule>) -> bool {
    if let Ok(resolved) = resolve_attrs(body, rule, rules) {
        for let r of &resolved {
            if r.target matches { ParserSpecial } && r.name == "text" {
                return true;
            }
        }
    }
    return false;
}

/// The Wado expression a resolved reference becomes, or an error if this
/// slice cannot emit it yet.
fn action_attr_expr(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    r: &ResolvedAttr,
    vals_in_scope: bool,
    rule_text_in_scope: bool,
) -> Result<String, String> {
    if r.target matches { ParserSpecial } {
        return parser_special_expr(r, rule_text_in_scope);
    }
    return match r.target {
        RuleAttr => {
            if is_arg(rule, &r.name) {
                if !rule_threads_args(rule) {
                    Result::<String, String>::Err(
                        `${r.name}: rule arguments are threaded only for single-alt rules with defaultable arg types`,
                    );
                } else if !vals_in_scope {
                    Result::<String, String>::Err(`${r.name}: no value channel in the enclosing rule`);
                } else {
                    Result::<String, String>::Ok(`vals.{r.name}`);
                }
            } else if field_default(rule, &r.name) matches { None } {
                Result::<String, String>::Err(
                    `${r.name}: value-channel field type '{field_type(rule, &r.name)}' has no Wado default`,
                );
            } else if !vals_in_scope {
                Result::<String, String>::Err(`${r.name}: no value channel in the enclosing rule`);
            } else {
                Result::<String, String>::Ok(`vals.{r.name}`);
            }
        },
        RuleLabel => rule_member_expr(rules, r),
        RuleRef => rule_member_expr(rules, r),
        TokenLabel => token_member_expr(r),
        TokenRef => token_member_expr(r),
        _ => Result::<String, String>::Err(`${r.name}: this attribute form is not yet emitted`),
    };
}

/// A parser special (`$text`, `$ctx`, `$start`, `$stop`, `$_p`). Only `$text`
/// is emitted so far — the input the current rule has consumed, spanning the
/// captured rule-start byte to the last consumed token. The rest await the CST
/// context handle and remain a loud error.
fn parser_special_expr(r: &ResolvedAttr, rule_text_in_scope: bool) -> Result<String, String> {
    if r.name == "text" && r.member matches { None } {
        if !rule_text_in_scope {
            return Result::<String, String>::Err("$text: only emitted for single-alt rules so far");
        }
        return Result::<String, String>::Ok(`p.text_span({RULE_TEXT_START_LOCAL}, p.last_end())`);
    }
    return Result::<String, String>::Err(`${r.name}: this parser special is not yet emitted`);
}

/// The local variable a call site binds a rule / label / token result to:
/// `escape_ident(to_snake_case(name))`, matching `RuleRefElement`/`LabelElement`
/// field-name derivation. The translator must reproduce it exactly — a raw
/// grammar name (e.g. camelCase `myTok`) would reference an undefined local.
fn binding_name(name: &String) -> String {
    return escape_ident(&to_snake_case(name));
}

/// A token reference resolves to the stream index its `let x = p.expect(...)`
/// bound; a member reads that token through the context API. `.index` is the
/// index itself and `.channel` is 0 (parser-visible tokens are default channel),
/// so neither needs a runtime call.
fn token_member_expr(r: &ResolvedAttr) -> Result<String, String> {
    let binding = binding_name(&r.name);
    let m = match &r.member {
        Some(m) => *m,
        None => {
            return Result::<String, String>::Ok(binding);
        },
    };
    if m == "text" {
        return Result::<String, String>::Ok(`p.token_text({binding})`);
    }
    if m == "int" {
        return Result::<String, String>::Ok(`p.token_int({binding})`);
    }
    if m == "type" {
        return Result::<String, String>::Ok(`p.token_kind({binding})`);
    }
    if m == "line" {
        return Result::<String, String>::Ok(`p.token_line({binding})`);
    }
    if m == "pos" {
        return Result::<String, String>::Ok(`p.token_col({binding})`);
    }
    if m == "index" {
        return Result::<String, String>::Ok(binding);
    }
    if m == "channel" {
        return Result::<String, String>::Ok(String::from("0"));
    }
    return Result::<String, String>::Err(`${r.name}.{m}: unknown token member`);
}

fn rule_member_expr(rules: &List<ParserRule>, r: &ResolvedAttr) -> Result<String, String> {
    let binding = binding_name(&r.name);
    let target = match find_rule(rules, &r.rule_name) {
        Some(t) => t,
        None => {
            return Result::<String, String>::Err(`${r.name}: unknown referenced rule '{r.rule_name}'`);
        },
    };
    if !rule_returns_vals(&target) {
        return Result::<String, String>::Err(
            `${r.name}: rule '{r.rule_name}' does not expose a value channel (needs single-alt + defaultable returns/locals)`,
        );
    }
    return match &r.member {
        Some(m) => {
            if field_default(&target, m) matches { Some(_) } {
                Result::<String, String>::Ok(`{binding}.{*m}`);
            } else {
                Result::<String, String>::Err(`${r.name}.{*m}: not an emittable value-channel field of '{r.rule_name}'`);
            }
        },
        None => Result::<String, String>::Ok(binding),
    };
}

fn find_rule(rules: &List<ParserRule>, name: &String) -> Option<ParserRule> {
    for let rule of rules {
        if rule.name == *name {
            return Option::Some(*rule);
        }
    }
    return null;
}

/// The `wado_type_default` of a rule's returns/locals field named `name`, or
/// `None` if there is no such field or its type has no Wado default.
fn field_default(rule: &ParserRule, name: &String) -> Option<String> {
    return match find_field(rule, name) {
        Some(d) => wado_type_default(&d.type_text),
        None => null,
    };
}

fn field_type(rule: &ParserRule, name: &String) -> String {
    return match find_field(rule, name) {
        Some(d) => d.type_text,
        None => "",
    };
}

fn find_field(rule: &ParserRule, name: &String) -> Option<AttrDecl> {
    for let d of &rule.returns_decls {
        if d.name == *name {
            return Option::Some(*d);
        }
    }
    for let d of &rule.locals_decls {
        if d.name == *name {
            return Option::Some(*d);
        }
    }
    return null;
}

fn is_arg(rule: &ParserRule, name: &String) -> bool {
    for let d of &rule.args {
        if d.name == *name {
            return true;
        }
    }
    return false;
}

/// Whether a rule exposes a value channel to callers: a non-left-recursive
/// rule declaring a defaultable `returns` / `locals`. Such a rule's
/// `_parse_<rule>` returns `<Rule>Vals`, its body gets a `vals` local (one per
/// alternative, or one shared local for the inlined dispatch), and a caller's
/// `$a.v` reads the returned struct. This is the return-type decision —
/// independent of whether the rule's own actions read the channel, since a
/// caller might. LR rules are excluded: threading the channel through the
/// precedence-climbing loop is a separate step.
pub fn rule_returns_vals(rule: &ParserRule) -> bool {
    return !rule_is_left_recursive(rule) && rule_value_channel_ready(rule);
}

/// Whether any alternative is directly left-recursive (its first element
/// references the rule itself). Mirrors lowering's LR classification at the
/// surface level so the value-channel decision can exclude LR rules without a
/// lowered `Rule`.
pub fn rule_is_left_recursive(rule: &ParserRule) -> bool {
    for let alt of &rule.alternatives {
        if !alt.elements.is_empty() && is_self_ref_element(&alt.elements[0], &rule.name) {
            return true;
        }
    }
    return false;
}

/// Whether a rule exposes an emittable value channel: it declares a
/// returns / locals field whose type has a Wado default, or it threads
/// rule arguments (which live in the same `<Rule>Vals` struct). Fields with
/// an unsupported type are excluded per-field (they do not appear in the
/// struct and a reference to one is a loud error), so one unsupported field
/// no longer disables the whole channel.
pub fn rule_value_channel_ready(rule: &ParserRule) -> bool {
    for let d of &rule.returns_decls {
        if wado_type_default(&d.type_text) matches { Some(_) } {
            return true;
        }
    }
    for let d of &rule.locals_decls {
        if wado_type_default(&d.type_text) matches { Some(_) } {
            return true;
        }
    }
    return rule_threads_args(rule);
}

/// Whether a rule's arguments are threaded as `_parse_<rule>` parameters and
/// stored into its `<Rule>Vals`. Any non-left-recursive rule qualifies (the
/// seeded `vals` threads through the multi-alt `_alt_<n>` helpers), provided
/// every arg type has a Wado default so the param can be defaulted and the vals
/// field `Default`-init. An LR or non-defaultable-arg rule keeps `$arg` a loud
/// error.
pub fn rule_threads_args(rule: &ParserRule) -> bool {
    if rule_is_left_recursive(rule) {
        return false;
    }
    if rule.args.is_empty() {
        return false;
    }
    for let a of &rule.args {
        if wado_type_default(&a.type_text) matches { None } {
            return false;
        }
    }
    return true;
}

/// Whether a returns / locals field goes into the `<Rule>Vals` struct: it has
/// a Wado default. Codegen and the translator agree on this predicate so the
/// struct's fields and the substituted `vals.<name>` reads stay in lockstep.
pub fn field_in_vals(d: &AttrDecl) -> bool {
    return wado_type_default(&d.type_text) matches { Some(_) };
}

/// A Wado default-value expression for a value-channel field type, or `None`
/// if the type has no known Wado default. Types are Wado (`language = Wado`,
/// identity translator), so only genuine Wado types are recognized — a
/// non-Wado name like `int` / `str` has no default and its field is skipped.
pub fn wado_type_default(type_text: &String) -> Option<String> {
    let t = type_text.trim();
    if t == "bool" {
        return Option::<String>::Some("false");
    }
    if t == "String" {
        return Option::<String>::Some("\"\"");
    }
    if t.starts_with("List") || t.starts_with("[") {
        return Option::<String>::Some("[]");
    }
    if is_numeric_type(&t) {
        return Option::<String>::Some("0");
    }
    return null;
}

fn is_numeric_type(t: &String) -> bool {
    return *t == "i8"
        || *t == "i16"
        || *t == "i32"
        || *t == "i64"
        || *t == "u8"
        || *t == "u16"
        || *t == "u32"
        || *t == "u64"
        || *t == "f32"
        || *t == "f64"
        || *t == "usize"
        || *t == "isize";
}
