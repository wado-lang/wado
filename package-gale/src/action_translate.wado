//! Identity translator (`language = Wado`): rewrite an action body's
//! `$`-references to Wado expressions over the value channel, leaving the
//! surrounding host text (already Wado) verbatim.
//!
//! This slice covers a rule's own value channel — `$v` / `$local` map to
//! the `vals` struct local emitted in the rule function. References that
//! need infrastructure not yet emitted (rule arguments, cross-rule
//! `$a.v`, token members via the context API, specials) return a loud
//! error naming the reference, so codegen surfaces a diagnostic rather
//! than emitting invalid code. The supported subset grows as the value
//! channel and context API land.

use { ParserRule } from "./ir.wado";
use { resolve_attrs, ResolvedAttr } from "./attr_resolve.wado";
use { splice_attrs } from "./attr_substitute.wado";
use { to_pascal_case } from "./ident.wado";

/// Name of a rule's value-channel struct (`e` -> `EVals`).
pub fn vals_struct_name(rule: &ParserRule) -> String {
    return `{to_pascal_case(&rule.name)}Vals`;
}

/// Translate `body` against `rule`'s environment. `vals_in_scope` is true
/// when the enclosing rule emits a `vals` local (so `$v` / `$local` can be
/// served). Returns ready-to-emit Wado, or an error naming the first
/// unsupported reference.
pub fn translate_wado_action(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    body: &String,
    vals_in_scope: bool,
) -> Result<String, String> {
    let resolved = resolve_attrs(body, rule, rules)?;
    let mut repls: List<String> = [];
    for let r of &resolved {
        let e = action_attr_expr(rule, r, vals_in_scope)?;
        repls.push(e);
    }
    return Result::<String, String>::Ok(splice_attrs(body, &resolved, &repls));
}

/// The Wado expression a resolved reference becomes, or an error if this
/// slice cannot emit it yet.
fn action_attr_expr(rule: &ParserRule, r: &ResolvedAttr, vals_in_scope: bool) -> Result<String, String> {
    return match r.target {
        // Rule returns / locals resolve to the enclosing rule's `vals` local.
        // Rule arguments share the `RuleAttr` target but are not threaded as
        // parameters yet.
        RuleAttr => {
            if is_arg(rule, &r.name) {
                Result::<String, String>::Err(`$${r.name}: rule arguments are not yet threaded into the value channel`);
            } else if !vals_in_scope {
                Result::<String, String>::Err(`$${r.name}: no value channel in the enclosing rule`);
            } else {
                Result::<String, String>::Ok(`vals.{r.name}`);
            }
        },
        // A labeled / named child rule reference: the call site bound its
        // returned vals as `let <name> = _parse_<rule>(p)`, so a returns
        // field reads `<name>.<field>`. CST pseudo-members (.text/.ctx/
        // .start/.stop) need tree access not yet emitted.
        RuleLabel => rule_member_expr(r),
        RuleRef => rule_member_expr(r),
        _ => Result::<String, String>::Err(`$${r.name}: this attribute form is not yet emitted`),
    };
}

fn rule_member_expr(r: &ResolvedAttr) -> Result<String, String> {
    return match &r.member {
        // `resolve_attrs` already validated the member is a returns field or a
        // pseudo-member; reject the four pseudo-members (tree access), so the
        // rest are the target rule's returns fields.
        Some(m) => {
            if is_pseudo_member(m) {
                Result::<String, String>::Err(`$${r.name}.{*m}: CST pseudo-members are not yet emitted`);
            } else {
                Result::<String, String>::Ok(`{r.name}.{*m}`);
            }
        },
        // A bare `$a` is the child's vals struct itself.
        None => Result::<String, String>::Ok(`{r.name}`),
    };
}

fn is_pseudo_member(m: &String) -> bool {
    return *m == "text" || *m == "ctx" || *m == "start" || *m == "stop";
}

fn is_arg(rule: &ParserRule, name: &String) -> bool {
    for let d of &rule.args {
        if d.name == *name {
            return true;
        }
    }
    return false;
}

/// Whether a rule exposes a value channel to callers: a single-alt (non-LR)
/// rule declaring a defaultable `returns` / `locals`. Such a rule's
/// `_parse_<rule>` returns `<Rule>Vals`, its body gets a `vals` local, and a
/// caller's `$a.v` reads the returned struct. This is the return-type
/// decision — independent of whether the rule's own actions read the channel,
/// since a caller might.
pub fn rule_returns_vals(rule: &ParserRule) -> bool {
    return rule.alternatives.len() == 1 && rule_value_channel_ready(rule);
}

/// Whether every returns / locals type has a Wado default, so a `<Rule>Vals`
/// struct can be emitted and default-constructed. Args are excluded (not yet
/// threaded).
pub fn rule_value_channel_ready(rule: &ParserRule) -> bool {
    if rule.returns_decls.len() == 0 && rule.locals_decls.len() == 0 {
        return false;
    }
    for let d of &rule.returns_decls {
        if wado_type_default(&d.type_text) matches { None } {
            return false;
        }
    }
    for let d of &rule.locals_decls {
        if wado_type_default(&d.type_text) matches { None } {
            return false;
        }
    }
    return true;
}

/// A Wado default-value expression for a value-channel field type, or `None`
/// if the type has no known default (the rule's value channel is then not
/// emitted). Covers the corpus surface: numerics, `bool`, `String`, `List`.
pub fn wado_type_default(type_text: &String) -> Option<String> {
    let t = type_text.trim();
    if t == "bool" {
        return Option::<String>::Some("false");
    }
    if t == "String" || t == "str" {
        return Option::<String>::Some("\"\"");
    }
    if t.starts_with("List") || t.starts_with("[") {
        return Option::<String>::Some("[]");
    }
    if is_numeric_type(&t) {
        return Option::<String>::Some("0");
    }
    return null;
}

fn is_numeric_type(t: &String) -> bool {
    return *t == "i8" || *t == "i16" || *t == "i32" || *t == "i64"
        || *t == "u8" || *t == "u16" || *t == "u32" || *t == "u64"
        || *t == "f32" || *t == "f64" || *t == "usize" || *t == "isize"
        || *t == "int";
}
