use { gate_assignment, gate_scope, reads_only_scan_gate_fields, scan_gate_fields } from "./scan_gate.wado";
use {
    ActionKind,
    ActionSource,
    AltAction,
    Alternative,
    Element,
    Grammar,
    GrammarKind,
    GroupElement,
    ParserRule,
    Visibility,
} from "./ir.wado";
use { parse } from "./g4/parser.wado";
use { generate, GenerateOptions } from "./codegen.wado";

global GEN_OPTS: GenerateOptions = GenerateOptions {};

fn gen_source(src: &String) -> String {
    let mut g = parse(*src).unwrap();
    return generate(&mut g, &GEN_OPTS).source;
}

// The action bodies and the members block are two readings of the same grammar,
// and either can come back empty on its own. A block the translator refuses
// declares nothing, so the fields its actions name have no type to copy — the
// gate has to go unsimulated, which is warn-and-degrade, not a dead emit.
test "a members block the translator refuses leaves the gate unsimulated" {
    let src = &"grammar C;
options { language = Java; }
@parser::members {
    java.util.Map<String, Integer> seen = new java.util.HashMap<>();
    int n = 0;
}
r : A { n = 1; } A ;
A : 'a' ;
";
    // The action side names the field, so what removes it is the members side
    // and nothing else. Without this the assertion below would hold for a
    // grammar that simulates nothing to begin with.
    let mut g = parse(*src).unwrap();
    assert scan_gate_fields(&g) == ["n"], `the action must name a gate candidate: ${scan_gate_fields(&g):?}`;
    let out = generate(&mut g, &GEN_OPTS).source;
    assert !out.contains("struct ScanGate"), `a field no member declares must not reach the scan gate: ${out}`;
}

// The hit case, so the test above is not passing because nothing ever simulates:
// the same grammar with a members block that does translate keeps its gate.
test "a members block that translates keeps its field simulable" {
    let out = gen_source(&"grammar C;
options { language = Java; }
@parser::members {
    int n = 0;
}
r : A { n = 1; } A ;
A : 'a' ;
");
    assert out.contains("struct ScanGate"), `a declared field stays simulable: ${out}`;
    assert out.contains("n: i32 = 0"), `the gate copies the member's own type and initialiser: ${out}`;
}

test "gate_assignment: a bare constant assignment" {
    let hit = gate_assignment(&"noStruct = 1;");
    assert hit matches { Some(_) }, `${hit:?}`;
    if let Some(h) = hit {
        assert h.0 == "no_struct", &h.0;
        assert h.1 == 1, `${h.1}`;
    }
}

test "gate_assignment: whitespace and a missing semicolon" {
    let hit = gate_assignment(&"  noStruct   =   0  ");
    assert hit matches { Some(_) }, `${hit:?}`;
    if let Some(h) = hit {
        assert h.0 == "no_struct", &h.0;
        assert h.1 == 0, `${h.1}`;
    }
}

test "gate_assignment: a negative constant" {
    let hit = gate_assignment(&"depth = -1;");
    assert hit matches { Some(_) }, `${hit:?}`;
    if let Some(h) = hit {
        assert h.1 == -1, `${h.1}`;
    }
}

// The rejection cases. Each is a body a scan cannot run by walking alone, so
// simulating it would answer with a value the parse never holds.
test "gate_assignment: a comparison is not an assignment" {
    assert gate_assignment(&"noStruct == 0") matches { None };
}

test "gate_assignment: an expression right-hand side" {
    assert gate_assignment(&"noStruct = noStruct + 1;") matches { None };
}

test "gate_assignment: a second statement" {
    assert gate_assignment(&"noStruct = 1; depth = 2;") matches { None };
}

test "gate_assignment: a call" {
    assert gate_assignment(&"reset();") matches { None };
}

test "gate_assignment: a field write through a receiver" {
    assert gate_assignment(&"this.noStruct = 1;") matches { None };
}

// A gate scope: the save/restore a members field alone cannot express, because
// each invocation of the rule keeps its own copy of the saved value.
test "gate_scope: the @init / @after pair" {
    let r = ParserRule {
        name: "callParams",
        visibility: Visibility::Public,
        options: [],
        alternatives: [],
        init_action: Option::Some(ActionSource { text: "$sv = noStruct; noStruct = 0;" }),
        after_action: Option::Some(ActionSource { text: "noStruct = $sv;" }),
    };
    let s = gate_scope(&r);
    assert s matches { Some(_) }, `${s:?}`;
    if let Some(g) = s {
        assert g.field == "no_struct", &g.field;
        assert g.value == 0, `${g.value}`;
    }
}

// The rejection cases. Each is a pair a scan cannot run as a save/restore, so
// running it anyway would leave the gate holding a value the parse never does.
test "gate_scope: a restore of a different field" {
    let r = ParserRule {
        name: "r",
        visibility: Visibility::Public,
        options: [],
        alternatives: [],
        init_action: Option::Some(ActionSource { text: "$sv = noStruct; noStruct = 0;" }),
        after_action: Option::Some(ActionSource { text: "depth = $sv;" }),
    };
    assert gate_scope(&r) matches { None };
}

test "gate_scope: a save the restore does not read" {
    let r = ParserRule {
        name: "r",
        visibility: Visibility::Public,
        options: [],
        alternatives: [],
        init_action: Option::Some(ActionSource { text: "$sv = noStruct; noStruct = 0;" }),
        after_action: Option::Some(ActionSource { text: "noStruct = $other;" }),
    };
    assert gate_scope(&r) matches { None };
}

test "gate_scope: no @after is no scope" {
    let r = ParserRule {
        name: "r",
        visibility: Visibility::Public,
        options: [],
        alternatives: [],
        init_action: Option::Some(ActionSource { text: "$sv = noStruct; noStruct = 0;" }),
    };
    assert gate_scope(&r) matches { None };
}

// A gate field is simulated only when the scan can run *every* write to it, and
// a rule's `@init` / `@after` write to one as much as an alternative's action.
fn grammar_with(init: &String, after: Option<ActionSource>) -> Grammar {
    return Grammar {
        name: "G",
        kind: GrammarKind::Combined,
        lexer_rules: [],
        mode_names: [],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
        parser_rules: [
            ParserRule {
                name: "scope",
                visibility: Visibility::Public,
                options: [],
                alternatives: [],
                init_action: Option::Some(ActionSource { text: *init }),
                after_action: after,
            },
            ParserRule {
                name: "head",
                visibility: Visibility::Public,
                options: [],
                alternatives: [
                    Alternative {
                        label: null,
                        options: [],
                        elements: [],
                        actions: [
                            AltAction {
                                kind: ActionKind::Action,
                                source: ActionSource { text: "noStruct = 1;" },
                                before_index: 0,
                            },
                        ],
                    },
                ],
            },
        ],
    };
}

test "scan_gate_fields: the recognised scope pair leaves its field simulable" {
    let g = grammar_with(
        &"$sv = noStruct; noStruct = 0;",
        Option::Some(ActionSource { text: "noStruct = $sv;" }),
    );
    assert scan_gate_fields(&g) == ["no_struct"], `${scan_gate_fields(&g):?}`;
}

test "scan_gate_fields: an unrunnable rule-level write disqualifies the field" {
    let g = grammar_with(&"noStruct = depth();", null);
    assert scan_gate_fields(&g).is_empty(), `${scan_gate_fields(&g):?}`;
}

// The disqualifying set is every name in a body the scan cannot run, not the
// write shapes someone listed. A field the scan simulates for one write and
// misses for another holds a value the parse never does, and any enumeration of
// shapes has one it does not know.
test "scan_gate_fields: a compound assignment disqualifies the field" {
    for let op of ["+=", "|=", "&=", "^=", "%=", "<<=", ">>="] as List<String> {
        let g = grammar_with(&`noStruct ${op} 1;`, null);
        assert scan_gate_fields(&g).is_empty(), `${op} left the field simulable`;
    }
}

// The shapes an assignment-target matcher misses. The first has a plain `f = 0`
// in it that only a statement splitter would find on its own; the second has no
// `=` at all.
test "scan_gate_fields: a conditional write disqualifies the field" {
    for let body of ["if (c) noStruct = 0;", "while (c) noStruct = 0;", "for (;;) noStruct = 0;"] as List<String> {
        let g = grammar_with(&body, null);
        assert scan_gate_fields(&g).is_empty(), `${body} left the field simulable`;
    }
}

test "scan_gate_fields: an increment disqualifies the field" {
    for let body of ["noStruct++;", "--noStruct;", "noStruct--;"] as List<String> {
        let g = grammar_with(&body, null);
        assert scan_gate_fields(&g).is_empty(), `${body} left the field simulable`;
    }
}

// A body naming the field disqualifies it even where it plainly only reads:
// what the body does to the names it mentions is exactly what could not be
// read, and over-rejecting only leaves the gate unsimulated.
test "scan_gate_fields: a body that merely names the field disqualifies it" {
    let g = grammar_with(&"log(noStruct);", null);
    assert scan_gate_fields(&g).is_empty(), `${scan_gate_fields(&g):?}`;
}

// The rejection case for the rule above: a body naming something else leaves
// the field alone, so the set is not simply always empty.
test "scan_gate_fields: a body naming other things leaves the field simulable" {
    let g = grammar_with(&"log(depth);", null);
    assert scan_gate_fields(&g) == ["no_struct"], `${scan_gate_fields(&g):?}`;
}

test "scan_gate_fields: a write through a receiver disqualifies the field" {
    let g = grammar_with(&"this.noStruct = depth();", null);
    assert scan_gate_fields(&g).is_empty(), `${scan_gate_fields(&g):?}`;
}

// An inline group's alternatives carry actions the parse runs, and lowering
// puts no gates on a group alternative's scan body — so the scan cannot run
// them however simply they are written.
test "scan_gate_fields: a write inside a group disqualifies the field" {
    let mut g = grammar_with(&"other = 1;", null);
    let inner = Alternative {
        label: null,
        options: [],
        elements: [],
        actions: [
            AltAction {
                kind: ActionKind::Action,
                source: ActionSource { text: "noStruct = 0;" },
                before_index: 0,
            },
        ],
    };
    g.parser_rules[1].alternatives[0].elements = [
        Element::Group(GroupElement {
            alternatives: [inner],
            options: [],
        }),
    ];
    assert scan_gate_fields(&g).is_empty(), `${scan_gate_fields(&g):?}`;
}

// A condition the scan may evaluate reads simulated fields and nothing else.
test "reads_only_scan_gate_fields: a simulated field" {
    assert reads_only_scan_gate_fields(&"(SCAN_GATE.no_struct == 0)", &["no_struct"]);
}

test "reads_only_scan_gate_fields: two of them" {
    let fields = ["no_struct", "depth"] as List<String>;
    assert reads_only_scan_gate_fields(&"(SCAN_GATE.no_struct == 0 && SCAN_GATE.depth > 1)", &fields);
}

// One field name can be a prefix of another. Taking the short one out of the
// long one leaves `_tail`, which is a read of a field the global does not have.
test "reads_only_scan_gate_fields: a field whose name extends a simulated one" {
    assert !reads_only_scan_gate_fields(&"(SCAN_GATE.no_struct_tail == 0)", &["no_struct"]);
}

test "reads_only_scan_gate_fields: the longer name, simulated, is read" {
    let fields = ["no_struct", "no_struct_tail"] as List<String>;
    assert reads_only_scan_gate_fields(&"(SCAN_GATE.no_struct_tail == 0)", &fields);
}

test "reads_only_scan_gate_fields: an unsimulated field" {
    assert !reads_only_scan_gate_fields(&"(SCAN_GATE.depth == 0)", &["no_struct"]);
}

test "reads_only_scan_gate_fields: a parser read" {
    assert !reads_only_scan_gate_fields(&"(p.no_struct == 0)", &["no_struct"]);
}

test "reads_only_scan_gate_fields: a call on the recognizer" {
    assert !reads_only_scan_gate_fields(&"pred_3(p)", &["no_struct"]);
}
