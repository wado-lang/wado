//! Tests for `alt_grouping.wado`. Focus: the overlap-group sorts must be
//! STABLE on key ties — the dispatch/tournament commits to the first-tried
//! alt on a scan-length tie, so reordering tied alts can change parse
//! results. The reference `sort_group_by_mandatory_count_desc` already
//! breaks full ties by source order; the others must too.

use { sort_group_by_specificity, decision_partition, AltBranch } from "./alt_grouping.wado";
use { AltClass, admits_kinds } from "./gir.wado";

fn describe(branches: &List<AltBranch>) -> String {
    let mut parts: List<String> = [];
    for let b of branches {
        parts.push(`${admits_kinds(&b.admits):?}=>${b.alts:?}`);
    }
    return parts.join(" ");
}

test "decision_partition: a token only one alternative starts decides it alone" {
    // `( 1 2 | 2 3 | 4 )`: 2 is contested, 1, 3 and 4 each select one alternative,
    // so only 2's branch has anything for a scan to decide.
    let classes: List<AltClass> = [
        AltClass::Selects([1, 2]),
        AltClass::Selects([2, 3]),
        AltClass::Selects([4]),
    ];
    let got = describe(&decision_partition(&classes));
    assert got == "[1]=>[0] [2]=>[0, 1] [3]=>[1] [4]=>[2]", got;
}

test "decision_partition: an open-ended alternative keeps the group whole" {
    let classes: List<AltClass> = [
        AltClass::Selects([1]),
        AltClass::OpenEnded([2]),
    ];
    let branches = decision_partition(&classes);
    assert branches.len() == 1 && branches[0].alts == [0, 1], describe(&branches);
}

test "decision_partition: an empty alternative no follow resolved keeps the group whole" {
    let classes: List<AltClass> = [
        AltClass::Selects([1, 2]),
        AltClass::Nullable([1]),
    ];
    let branches = decision_partition(&classes);
    assert branches.len() == 1 && branches[0].alts == [0, 1], describe(&branches);
}

test "sort_group_by_specificity: ties keep source order" {
    // First-set sizes [2, 2, 1]. Ascending by size puts alt 2 (size 1)
    // first; alts 0 and 1 tie on size 2 and must stay in source order.
    // The buggy swap-immediately sort yields [2, 1, 0] (0 and 1 reversed).
    let first_sets: List<List<i32>> = [
        [1, 2],
        [3, 4],
        [5],
    ];
    let mut group: List<i32> = [0, 1, 2];
    sort_group_by_specificity(&mut group, &first_sets);
    assert group[0] == 2, `group[0]=${group[0]}`;
    assert group[1] == 0, `group[1]=${group[1]} (tie not in source order)`;
    assert group[2] == 1, `group[2]=${group[2]} (tie not in source order)`;
}

test "sort_group_by_specificity: already-ascending stays put" {
    let first_sets: List<List<i32>> = [
        [1],
        [2, 3],
        [4, 5, 6],
    ];
    let mut group: List<i32> = [0, 1, 2];
    sort_group_by_specificity(&mut group, &first_sets);
    assert group[0] == 0 && group[1] == 1 && group[2] == 2, `${group[0]},${group[1]},${group[2]}`;
}
