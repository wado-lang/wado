use { ParserRule } from "./ir.wado";
use { LowerContext, LowerMarks } from "./lower_context.wado";
use { GrammarAnalysis } from "./grammar_analysis.wado";
use { GenSettings } from "./gen_settings.wado";
use { Reading } from "./readings.wado";

test "a site interns once whatever order its kinds were found in" {
    let rules: List<ParserRule> = [];
    let mut ctx = LowerContext::new(GrammarAnalysis::new(&rules), GenSettings {});
    let names: List<String> = ["TK_X", "TK_Y", "TK_Z"];
    let k = ctx.analysis.token_ids_of(&names);
    let s1: List<Reading> = [Reading { kinds: [[k[0], k[1]]], ends: true }];
    let s1_reordered: List<Reading> = [Reading { kinds: [[k[1], k[0]]], ends: true }];
    let s2: List<Reading> = [Reading { kinds: [[k[2]]], ends: true }];
    assert ctx.intern_follow_site(&s1) == 0;
    assert ctx.intern_follow_site(&s2) == 1;
    assert ctx.intern_follow_site(&s1_reordered) == 0;
    assert ctx.tables.follow_sites().len() == 2;
}

// A shared edge list handed every rule the first rule's forwards, and the FOLLOW
// slots with them.
test "each rule records its own FOLLOW forwards" {
    let mut marks = LowerMarks::new(2);
    marks.follow_forward_edges[0].push("b");
    assert marks.follow_forward_edges[1].is_empty();
}
