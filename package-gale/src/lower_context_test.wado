use { ParserRule } from "./ir.wado";
use { LowerContext, LowerMarks } from "./lower_context.wado";
use { GrammarAnalysis } from "./grammar_analysis.wado";
use { GenSettings } from "./gen_settings.wado";

test "intern_follow_mask: same mask returns same id, empty returns null" {
    let rules: List<ParserRule> = [];
    let mut ctx = LowerContext::new(GrammarAnalysis::new(&rules), GenSettings {});
    let m1: List<List<String>> = [
        ["TK_X"],
        ["TK_Y"],
    ];
    let m2: List<List<String>> = [
        ["TK_X"],
        ["TK_Z"],
    ];
    let id1 = ctx.intern_follow_mask(&m1);
    let id2 = ctx.intern_follow_mask(&m2);
    let id1_again = ctx.intern_follow_mask(&m1);
    assert id1 matches { Some(0) }, "first mask gets id 0";
    assert id2 matches { Some(1) }, "distinct mask gets id 1";
    assert id1_again == id1, "same mask reuses its id";
    // A mask whose every depth-set is empty never gates → no global.
    let empty_depths: List<List<String>> = [[], []];
    let id_empty = ctx.intern_follow_mask(&empty_depths);
    assert id_empty matches { None }, "all-empty mask interns to null";
    assert ctx.tables.follow_masks().len() == 2, "only the two real masks are registered";
}

// A shared edge list handed every rule the first rule's forwards, and the FOLLOW
// slots with them.
test "each rule records its own FOLLOW forwards" {
    let mut marks = LowerMarks::new(2);
    marks.follow_forward_edges[0].push("b");
    assert marks.follow_forward_edges[1].is_empty();
}
