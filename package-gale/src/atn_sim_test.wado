//! Tests for the runtime ATN simulator core (P2/P3a).
//!
//! Builds ATNs with `atn.wado`, serializes, decodes through the inlined
//! runtime (`atn_decode`), and drives `atn_adaptive_predict` /
//! `atn_predict_with_stack` to prove the engine mechanics: multi-token
//! lookahead resolution, the greedy/non-greedy tie-break (min-alt-on-conflict
//! + edge ordering), and the full-context (real rule-stack) cases that bind
//! the dangling-`else` per caller context (the closing tests).

use {
    build_atn,
    build_token_kinds,
    serialize_atn,
    Atn,
} from "./atn.wado";
use {
    atn_decode, atn_adaptive_predict, atn_predict_with_stack, AtnSim,
    ATN_BLOCK_START, ATN_BLOCK_END, ATN_STAR_LOOP_ENTRY,
} from "./runtime/atn.wado";
use { Token, LexerSlice, Span } from "./runtime/lex.wado";
use { parse } from "./g4/parser.wado";
use { assign_atn_call_sites } from "./ir.wado";

fn mk(kind: i32) -> Token {
    return Token::new(kind, LexerSlice::from_string(""), Span::new(0, 0));
}

/// Decision number of parser rule `rule`'s top-level alternation block.
fn rule_block_decision(atn: &Atn, rule: i32) -> i32 {
    for let mut d = 0; d < atn.decision_state.len(); d += 1 {
        let s = &atn.states[atn.decision_state[d]];
        if s.kind == ATN_BLOCK_START && s.rule == rule {
            return d;
        }
    }
    return -1;
}

/// Decision number of the optional/loop whose decision state has an edge
/// straight to a BlockEnd (i.e. an EBNF repeat, not an N-way rule body).
fn optional_decision(atn: &Atn) -> i32 {
    for let mut d = 0; d < atn.decision_state.len(); d += 1 {
        let s = &atn.states[atn.decision_state[d]];
        if s.kind != ATN_BLOCK_START {
            continue;
        }
        for let t of &s.transitions {
            if atn.states[t.target].kind == ATN_BLOCK_END {
                return d;
            }
        }
    }
    return -1;
}

/// Kind of the state reached by `alt`'s edge out of decision `d`.
fn alt_target_kind(atn: &Atn, d: i32, alt: i32) -> i32 {
    let s = &atn.states[atn.decision_state[d]];
    return atn.states[s.transitions[alt].target].kind;
}

/// Decision number of rule `rule`'s `STAR_LOOP_ENTRY` (the LR loop entry).
fn loop_entry_decision(atn: &Atn, rule: i32) -> i32 {
    for let mut d = 0; d < atn.decision_state.len(); d += 1 {
        let s = &atn.states[atn.decision_state[d]];
        if s.kind == ATN_STAR_LOOP_ENTRY && s.rule == rule {
            return d;
        }
    }
    return -1;
}

global K2_G4: String = "
grammar T;
a : ID '(' ')' | ID '[' ']' ;
ID : 'a'..'z'+ ;
WS : ' ' -> skip ;
";

// Directly left-recursive operator grammar — the P4.1 walkability case.
// Built naively (pre-rewrite) the simulator would left-recurse forever on
// `expr -> RuleRef(expr) ...`; the rewritten loop-entry form is finite.
global LR_G4: String = "
grammar E;
expr : expr '*' expr
     | expr '+' expr
     | INT ;
INT : '0'..'9'+ ;
WS : ' ' -> channel(HIDDEN);
";

global NG_G4: String = "
grammar T;
start : statement+ ;
statement : 'x' | ifStatement;
ifStatement : 'if' 'y' statement ('else' statement)?? ;
ID : 'a'..'z'+ ;
WS : (' '|'\\n') -> channel(HIDDEN);
";

global GR_G4: String = "
grammar T;
start : statement+ ;
statement : 'x' | ifStatement;
ifStatement : 'if' 'y' statement ('else' statement)? ;
ID : 'a'..'z'+ ;
WS : (' '|'\\n') -> channel(HIDDEN);
";

test "predict resolves a two-token shared-prefix decision" {
    let g = parse(K2_G4).unwrap();
    let atn = build_atn(&g);
    let sim = atn_decode(&serialize_atn(&atn));
    let d = rule_block_decision(&atn, 0);
    assert d >= 0, "rule `a` must have an alternation decision";
    // kinds: ID=0, WS=1, EOF=2, ERROR=3, '('=4, ')'=5, '['=6, ']'=7.
    let eof = 2;
    let paren: List<Token> = [mk(0), mk(4), mk(5)];
    let brack: List<Token> = [mk(0), mk(6), mk(7)];
    assert atn_adaptive_predict(&sim, d, &paren, 0, eof) == 0, "ID '(' ')' should pick alt 0";
    assert atn_adaptive_predict(&sim, d, &brack, 0, eof) == 1, "ID '[' ']' should pick alt 1";
}

test "non-greedy ?? picks the exit alt on the dangling-else conflict" {
    let g = parse(NG_G4).unwrap();
    let atn = build_atn(&g);
    let tk = build_token_kinds(&g);
    let eof = tk.0["TK_EOF"];
    let sim = atn_decode(&serialize_atn(&atn));
    let d = optional_decision(&atn);
    assert d >= 0, "the `??` must produce an optional decision";
    // 'else'=7, 'x'=4 — both alts stay viable to EOF (true ambiguity).
    let toks: List<Token> = [mk(7), mk(4)];
    let alt = atn_adaptive_predict(&sim, d, &toks, 0, eof);
    // The chosen alt's edge must lead to BlockEnd: non-greedy prefers EXIT.
    assert alt_target_kind(&atn, d, alt) == ATN_BLOCK_END, "non-greedy must choose the exit alt";
}

test "greedy ? picks the enter alt on the same conflict" {
    let g = parse(GR_G4).unwrap();
    let atn = build_atn(&g);
    let tk = build_token_kinds(&g);
    let eof = tk.0["TK_EOF"];
    let sim = atn_decode(&serialize_atn(&atn));
    let d = optional_decision(&atn);
    assert d >= 0, "the `?` must produce an optional decision";
    let toks: List<Token> = [mk(7), mk(4)];
    let alt = atn_adaptive_predict(&sim, d, &toks, 0, eof);
    // Greedy prefers ENTER: the chosen alt's edge must NOT go to BlockEnd.
    assert alt_target_kind(&atn, d, alt) != ATN_BLOCK_END, "greedy must choose the enter alt";
}

// Full-context: the SAME `??` decision binds differently depending on the
// caller stack of ATN return states. This is the IfIfElseNonGreedyBinding1
// crux. The stack mirrors what the generated parser pushes at each rule
// call: the start-rule frame (-1, follow is EOF) at the bottom, then each
// call site's exact return state (`call_site_returns`). Call-site ids (the
// depth-first numbering of `assign_atn_call_sites`):
//   cs0 = start -> statement   (inside `statement+`)
//   cs1 = statement -> ifStatement
//   cs2 = ifStatement -> statement   (the mandatory one, before the `??`)
//   cs3 = ifStatement -> statement   (inside `('else' statement)??`)

test "full-context: inner ifStatement ?? skips the else (binds to outer)" {
    let mut g = parse(NG_G4).unwrap();
    assign_atn_call_sites(&mut g);
    let atn = build_atn(&g);
    let eof = build_token_kinds(&g).0["TK_EOF"];
    let sim = atn_decode(&serialize_atn(&atn));
    let d = optional_decision(&atn);
    let csr = &atn.call_site_returns;
    // Inner ifStatement reached via
    // start >(cs0) statement >(cs1) ifStatement >(cs2) statement >(cs1) ifStatement.
    let stack: List<i32> = [-1, csr[0], csr[1], csr[2], csr[1]];
    let toks: List<Token> = [mk(7), mk(4)];
    let alt = atn_predict_with_stack(&sim, d, &stack, &toks, 0, eof);
    assert alt_target_kind(&atn, d, alt) == ATN_BLOCK_END, "inner ?? must EXIT (let the outer take the else)";
}

test "full-context: outer ifStatement ?? consumes the else" {
    let mut g = parse(NG_G4).unwrap();
    assign_atn_call_sites(&mut g);
    let atn = build_atn(&g);
    let eof = build_token_kinds(&g).0["TK_EOF"];
    let sim = atn_decode(&serialize_atn(&atn));
    let d = optional_decision(&atn);
    let csr = &atn.call_site_returns;
    // Outermost ifStatement: start >(cs0) statement >(cs1) ifStatement.
    let stack: List<i32> = [-1, csr[0], csr[1]];
    let toks: List<Token> = [mk(7), mk(4)];
    let alt = atn_predict_with_stack(&sim, d, &stack, &toks, 0, eof);
    assert alt_target_kind(&atn, d, alt) != ATN_BLOCK_END, "outer ?? must ENTER (consume the else)";
}

// P4.1: the rewritten LR loop-entry form is walkable. A naive
// pre-rewrite ATN (`expr -> RuleRef(expr) ...` at position 0) would
// left-recurse forever in `atn_closure`; the precedence-climbing rewrite
// stops at the atom block, so prediction terminates and returns a valid
// alternative. (Precedence-guided enter/exit selection itself is P4.3;
// here we only assert termination + a sane in-range result.)
test "LR loop-entry prediction terminates (no naive left recursion)" {
    let g = parse(LR_G4).unwrap();
    let atn = build_atn(&g);
    let eof = build_token_kinds(&g).0["TK_EOF"];
    let sim = atn_decode(&serialize_atn(&atn));
    let d = loop_entry_decision(&atn, 0);
    assert d >= 0, "expr must have an LR loop-entry decision";
    // After the first atom, input continues with `'+' INT` (tk: INT=0,
    // WS=1, EOF=2, ERROR=3, '*'=4, '+'=5). Three loop-entry edges exist
    // (enter '*', enter '+', exit); the predictor must return one of them.
    let toks: List<Token> = [mk(5), mk(0)];
    let alt = atn_adaptive_predict(&sim, d, &toks, 0, eof);
    assert alt >= 0 && alt < 3, `LR loop-entry prediction out of range: {alt}`;
}
