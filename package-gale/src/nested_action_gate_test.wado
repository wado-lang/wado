//! An action or predicate nested inside a group must never vanish: it either
//! runs — a group's alternatives decide like a rule's — or it is reported.

use { parse } from "./g4/parser.wado";
use { generate, GenerateOptions } from "./codegen.wado";
use { Diagnostic, DiagnosticKind } from "./gir.wado";

global OPTS: GenerateOptions = GenerateOptions {};

fn gen_diagnostics(src: &String) -> List<Diagnostic> {
    let mut g = parse(*src).unwrap();
    return generate(&mut g, &OPTS).diagnostics;
}

fn has_unsupported_action(diags: &List<Diagnostic>) -> bool {
    for let d of diags {
        if d.kind matches { UnsupportedAction } {
            return true;
        }
    }
    return false;
}

test "a nested-group predicate gates its branch" {
    // The group's alternatives are a decision like a rule's, so the predicate
    // joins the branch condition instead of being dropped (or emitted as an
    // inline guard, which would fail the parse rather than select `B`).
    let src = &"grammar T;
options { language = Wado; }
r : ( {false}? A | B ) ;
A : 'a' ;
B : 'b' ;
";
    assert !has_unsupported_action(&gen_diagnostics(src)), "a gated group predicate must not warn";
    let out = gen_source(src);
    assert out.contains("== TK_A && (pred_0(p))"), "the predicate joins its branch condition";
}

test "an empty-alt predicate gates the empty alternative" {
    // `( {p}? | A )` means "match nothing when p holds, else match A". The
    // group carries an action, so it keeps its per-alternative dispatch instead
    // of folding to an Optional that had nowhere to put the predicate.
    let src = &"grammar T;
options { language = Wado; }
r : ( {false}? | A ) A ;
A : 'a' ;
";
    assert !has_unsupported_action(&gen_diagnostics(src)), "a gated empty alternative must not warn";
    let out = gen_source(src);
    assert out.contains("if true && (pred_0(p))"), "the empty alternative is taken only while the predicate holds";
}

test "a `+` over a single-alternative gated group answers the predicate on its first iteration" {
    // The loop gate exits later iterations, but the mandatory first one runs
    // past it. A single-alternative body has no dispatch to report from, so
    // without an answer here the predicate is dropped and `A B` matches.
    let src = &"grammar T;
options { language = Wado; }
r : ( {false}? A B )+ A ;
A : 'a' ;
B : 'b' ;
";
    assert !has_unsupported_action(&gen_diagnostics(src)), "a gated group predicate must not warn";
    let out = gen_source(src);
    assert out.contains("failed semantic predicate"), `the first iteration must answer the predicate: ${out}`;
}

fn gen_source(src: &String) -> String {
    let mut g = parse(*src).unwrap();
    return generate(&mut g, &OPTS).source;
}

test "lexer nested-group predicate is emitted, not silently dropped" {
    // `KW`'s only action is a predicate inside a group. With `grammar_has_actions`
    // blind to nested lexer actions, `emit_actions` stayed off and the predicate
    // vanished (`try_KW` matched any `[a-z]+`). It must reach the generated
    // lexer — its literal (`zzq`, chosen so no runtime word contains it) appears
    // only when the predicate is emitted.
    let src = gen_source(&"lexer grammar L;
options { language = Wado; }
KW : ([a-z]+ { $text == \"zzq\" }? | 'dog') ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
");
    assert src.contains("zzq"), "a predicate nested in a lexer group must be emitted, not silently dropped";
}

test "a plain action on an empty alternative does not cost it its follow set" {
    // Only a gateable alt-initial predicate makes an alternative decide by
    // something other than the lookahead, so a plain action leaves the empty
    // alternative the follow set that selects it.
    let src = &"grammar T;
options { language = Wado; }
s : 'k' ( A | {x();} | B ) EOF ;
A : 'a' ;
B : 'b' ;
";
    assert !has_unsupported_action(&gen_diagnostics(src)), "a plain action on an empty alternative must not warn";
    let out = gen_source(src);
    assert out.contains("grp_kind == TK_EOF"), `the empty alternative must test the follow set: ${out}`;
    assert out.contains("no viable alternative"), `a lookahead no alternative admits must report: ${out}`;
}
