use {
    ParserRule,
    Alternative,
    Element,
    RuleRefElement,
    TokenRefElement,
    RepeatElement,
    RepeatKind,
    GroupElement,
    Visibility,
} from "./ir.wado";
use { GenContext } from "./gen_context.wado";
use { LitToken } from "./lexer_gen.wado";
use { FollowEnv, FollowSet, build } from "./follow_env.wado";

fn tk(name: String) -> Element {
    return Element::TokenRef(TokenRefElement::new(name));
}

fn rr(name: String) -> Element {
    return Element::RuleRef(RuleRefElement::new(name));
}

fn opt(elem: Element) -> Element {
    return Element::Repeat(RepeatElement {
        kind: RepeatKind::Optional,
        element: elem,
        non_greedy: false,
    });
}

fn group(alts: Array<Alternative>) -> Element {
    return Element::Group(GroupElement::new(alts));
}

fn alt(elements: Array<Element>) -> Alternative {
    return Alternative::new(elements);
}

fn mk_rule(name: String, alts: Array<Alternative>) -> ParserRule {
    return ParserRule::new(name, Visibility::Private, [], alts);
}

fn mk_ctx(rules: &Array<ParserRule>) -> GenContext {
    let toks: Array<LitToken> = [];
    return GenContext::new(rules, &toks);
}

fn no_start() -> String {
    return "";
}

test "FollowEnv::empty has no rules" {
    let env = FollowEnv::empty();
    let rule_name = "anything";
    assert env.tail_greedy(&rule_name).is_empty();
    let fs = env.rule_follow(&rule_name);
    assert fs.kinds.is_empty();
    assert !fs.closed;
}

test "build: empty grammar produces empty env" {
    let rules: Array<ParserRule> = [];
    let mut ctx = mk_ctx(&rules);
    let start = no_start();
    let env = build(&rules, &mut ctx, &start);
    let unknown = "no_such_rule";
    assert env.tail_greedy(&unknown).is_empty();
}

test "build: rule with tail-greedy Y? has TK_Y in tail_greedy" {
    let rules: Array<ParserRule> = [mk_rule("a", [alt([tk("X"), opt(tk("Y"))])])];
    let mut ctx = mk_ctx(&rules);
    let start = no_start();
    let env = build(&rules, &mut ctx, &start);
    let name = "a";
    let tg = env.tail_greedy(&name);
    assert tg.len() == 1;
    assert tg[0] == "TK_Y";
}

test "build: rule with mandatory tail has empty tail_greedy" {
    let rules: Array<ParserRule> = [mk_rule("b", [alt([tk("X"), tk("Y")])])];
    let mut ctx = mk_ctx(&rules);
    let start = no_start();
    let env = build(&rules, &mut ctx, &start);
    let name = "b";
    assert env.tail_greedy(&name).is_empty();
}

test "build: tail-greedy unions across alts" {
    let rules: Array<ParserRule> = [mk_rule("c", [alt([tk("X"), opt(tk("Y"))]), alt([tk("Z"), opt(tk("W"))])])];
    let mut ctx = mk_ctx(&rules);
    let start = no_start();
    let env = build(&rules, &mut ctx, &start);
    let name = "c";
    let tg = env.tail_greedy(&name);
    let mut sorted = tg;
    sorted.sort();
    assert sorted.len() == 2 && sorted[0] == "TK_W" && sorted[1] == "TK_Y";
}

test "build: transitive tail-greedy through RuleRef" {
    let rules: Array<ParserRule> = [mk_rule("d", [alt([rr("a")])]), mk_rule("a", [alt([tk("X"), opt(tk("Y"))])])];
    let mut ctx = mk_ctx(&rules);
    let start = no_start();
    let env = build(&rules, &mut ctx, &start);
    let d = "d";
    let a = "a";
    assert env.tail_greedy(&a).len() == 1 && env.tail_greedy(&a)[0] == "TK_Y";
    assert env.tail_greedy(&d).len() == 1 && env.tail_greedy(&d)[0] == "TK_Y";
}

test "build: left-recursive rule does not infinitely recurse" {
    let rules: Array<ParserRule> = [mk_rule("e", [alt([rr("e"), tk("PLUS"), rr("e")]), alt([tk("X")])])];
    let mut ctx = mk_ctx(&rules);
    let start = no_start();
    let env = build(&rules, &mut ctx, &start);
    let name = "e";
    let _tg = env.tail_greedy(&name);
}

test "rule_follow: start rule seeded with EOF when named" {
    let rules: Array<ParserRule> = [mk_rule("r", [alt([tk("X")])])];
    let mut ctx = mk_ctx(&rules);
    let start = "r";
    let env = build(&rules, &mut ctx, &start);
    let r = "r";
    let fs = env.rule_follow(&r);
    assert fs.closed, "start rule's FOLLOW must be closed";
    assert fs.kinds.contains("TK_EOF"), "start rule's FOLLOW must contain TK_EOF";
}

test "rule_follow: callee gets first(suffix) of caller alt" {
    // r : a B ;
    let rules: Array<ParserRule> = [mk_rule("r", [alt([rr("a"), tk("B")])]), mk_rule("a", [alt([tk("X")])])];
    let mut ctx = mk_ctx(&rules);
    let start = "r";
    let env = build(&rules, &mut ctx, &start);
    let a = "a";
    let fs_a = env.rule_follow(&a);
    assert fs_a.kinds.contains("TK_B"), `expected TK_B in FOLLOW(a), got {fs_a.kinds.len()} entries`;
}

test "rule_follow: callee at deep-nullable suffix inherits caller's FOLLOW" {
    // r : a ;        // a is at deep-nullable suffix (nothing follows in r)
    // a : X ;
    // FOLLOW(r) = {EOF}, so FOLLOW(a) ⊇ {EOF}.
    let rules: Array<ParserRule> = [mk_rule("r", [alt([rr("a")])]), mk_rule("a", [alt([tk("X")])])];
    let mut ctx = mk_ctx(&rules);
    let start = "r";
    let env = build(&rules, &mut ctx, &start);
    let a = "a";
    let fs_a = env.rule_follow(&a);
    assert fs_a.kinds.contains("TK_EOF"), "FOLLOW(a) must include TK_EOF transitively from FOLLOW(r)";
}

test "rule_follow: ll_ctx_follow grammar yields FOLLOW(a) = {TK_Y, TK_EOF}" {
    // r : (wrapper b | wrapper) EOF ;
    // wrapper : a ;
    // a : X Y? ;
    // b : Y ;
    let rules: Array<ParserRule> = [
        mk_rule("r", [alt([group([alt([rr("wrapper"), rr("b")]), alt([rr("wrapper")])]), tk("EOF")])]),
        mk_rule("wrapper", [alt([rr("a")])]),
        mk_rule("a", [alt([tk("X"), opt(tk("Y"))])]),
        mk_rule("b", [alt([tk("Y")])]),
    ];
    let mut ctx = mk_ctx(&rules);
    let start = "r";
    let env = build(&rules, &mut ctx, &start);
    let a = "a";
    let wrapper = "wrapper";
    let b = "b";
    let fs_a = env.rule_follow(&a);
    let fs_w = env.rule_follow(&wrapper);
    let fs_b = env.rule_follow(&b);
    assert fs_a.kinds.contains("TK_Y"), `expected TK_Y in FOLLOW(a) (via wrapper b), got {fs_a.kinds.len()} entries`;
    assert fs_a.kinds.contains("TK_EOF"), "expected TK_EOF in FOLLOW(a) (via wrapper alone in alt 1)";
    assert fs_w.kinds.contains("TK_Y"), "expected TK_Y in FOLLOW(wrapper) (via wrapper b in r alt 0)";
    assert fs_w.kinds.contains("TK_EOF"), "expected TK_EOF in FOLLOW(wrapper) (via wrapper alone in r alt 1)";
    assert fs_b.kinds.contains("TK_EOF"), "expected TK_EOF in FOLLOW(b) (via outer EOF after group in r)";
}

test "rule_follow: nullable suffix propagates FOLLOW through Optional" {
    // r : a b? EOF ;
    // a : X Y? ;
    // b : Y ;
    // FOLLOW(a) ⊇ first(b? EOF) = {Y, EOF}.
    let rules: Array<ParserRule> = [
        mk_rule("r", [alt([rr("a"), opt(rr("b")), tk("EOF")])]),
        mk_rule("a", [alt([tk("X"), opt(tk("Y"))])]),
        mk_rule("b", [alt([tk("Y")])]),
    ];
    let mut ctx = mk_ctx(&rules);
    let start = "r";
    let env = build(&rules, &mut ctx, &start);
    let a = "a";
    let fs_a = env.rule_follow(&a);
    assert fs_a.kinds.contains("TK_Y"), "FOLLOW(a) must include TK_Y from b?";
    assert fs_a.kinds.contains("TK_EOF"), "FOLLOW(a) must include TK_EOF since b? is nullable";
}

test "rule_follow: terminates on left recursion" {
    // e : e PLUS e | X ;
    let rules: Array<ParserRule> = [mk_rule("e", [alt([rr("e"), tk("PLUS"), rr("e")]), alt([tk("X")])])];
    let mut ctx = mk_ctx(&rules);
    let start = "e";
    let env = build(&rules, &mut ctx, &start);
    let e = "e";
    let fs_e = env.rule_follow(&e);
    // FOLLOW(e) at least includes EOF (start) and TK_PLUS (recursive caller's suffix).
    assert fs_e.kinds.contains("TK_EOF");
    assert fs_e.kinds.contains("TK_PLUS");
}

// ────────────────────────────────────────────────────────────────────
// FollowEnv variant pre-pass tests.
//
// `FollowEnv::build` registers follow-variant entries up front by
// walking every parser rule body and calling `intern_follow_variant`
// at each `RuleRef` call site. The registration mirrors what `lower`
// would do later; because `intern_follow_variant` is keyed on the
// canonical `(rule_name, mask, k_prefix_mask)` triple, lower's
// subsequent calls return the cached id and no new entries are
// added. The pre-pass exists so a future refactor can switch lower
// to lookup-only.
// ────────────────────────────────────────────────────────────────────

test "variant pre-pass: registers a variant for tail-greedy + follow conflict" {
    // r : a b ;
    // a : X Y? ;       // tail_greedy(a) = {TK_Y}
    // b : Y ;          // first(b)        = {TK_Y}
    // → FOLLOW(a) ⊇ {TK_Y}, so the (a, mask=[TK_Y]) variant must be
    //   registered by the pre-pass.
    let rules: Array<ParserRule> = [
        mk_rule("r", [alt([rr("a"), rr("b")])]),
        mk_rule("a", [alt([tk("X"), opt(tk("Y"))])]),
        mk_rule("b", [alt([tk("Y")])]),
    ];
    let mut ctx = mk_ctx(&rules);
    let start = "r";
    let _env = build(&rules, &mut ctx, &start);
    let entries = ctx.follow_variants();
    let mut found = false;
    for let e of &entries {
        if e.rule_name == "a" {
            assert e.mask.len() == 1 && e.mask[0] == "TK_Y",
                `expected variant for a with mask=[TK_Y], got mask len {e.mask.len()}`;
            found = true;
        }
    }
    assert found, `expected variant entry for rule 'a', registry has {entries.len()} entries`;
}

test "variant pre-pass: no variant when caller follow disjoint from tail-greedy" {
    // r : a Z ;        // first(Z) = {TK_Z}
    // a : X Y? ;       // tail_greedy(a) = {TK_Y}
    // → {TK_Y} ∩ {TK_Z} = ∅, no variant needed.
    let rules: Array<ParserRule> = [
        mk_rule("r", [alt([rr("a"), tk("Z")])]),
        mk_rule("a", [alt([tk("X"), opt(tk("Y"))])]),
    ];
    let mut ctx = mk_ctx(&rules);
    let start = "r";
    let _env = build(&rules, &mut ctx, &start);
    let entries = ctx.follow_variants();
    for let e of &entries {
        assert e.rule_name != "a",
            "unexpected variant for rule 'a' (caller follow is {TK_Z}, disjoint from tail-greedy {TK_Y})";
    }
}

test "variant pre-pass: walks into Repeat bodies" {
    // r : (a b)* EOF ; // FOLLOW(a) ⊇ first(b) = {TK_Y}
    // a : X Y? ;
    // b : Y ;
    let rules: Array<ParserRule> = [
        mk_rule("r", [alt([opt(group([alt([rr("a"), rr("b")])])), tk("EOF")])]),
        mk_rule("a", [alt([tk("X"), opt(tk("Y"))])]),
        mk_rule("b", [alt([tk("Y")])]),
    ];
    let mut ctx = mk_ctx(&rules);
    let start = "r";
    let _env = build(&rules, &mut ctx, &start);
    let entries = ctx.follow_variants();
    let mut found = false;
    for let e of &entries {
        if e.rule_name == "a" && e.mask.len() == 1 && e.mask[0] == "TK_Y" {
            found = true;
        }
    }
    assert found, `expected variant for 'a' inside the Repeat body, registry has {entries.len()} entries`;
}

test "variant pre-pass: LR alt leading self-ref is not interned" {
    // e : e X? | X ;
    // tail_greedy(e) = first(X) = {TK_X}     (from LR alt's trailing X?)
    // The leading `e` of the LR alt sits at position 0; its
    // suffix-derived caller_follow is first(X?) = {TK_X}, which
    // overlaps tail_greedy(e) = {TK_X}. If `walk_rule_alts` walked
    // position 0 of an LR alt, that overlap would register an
    // `(e, mask=[TK_X])` variant.
    //
    // Lower never reaches that intern site: `lower_lr_alt_suffix`
    // lowers `alt.elements[1..]`, skipping the leading self-ref. The
    // walker must mirror that skip — otherwise the variant lives in
    // the registry but lower never emits a body for it (registry
    // length > `lowered.variant_rules.len()`, tripping the
    // `gen_parser` assertion at parser_gen.wado:122).
    //
    // No outside caller of `e` overlaps `tail_greedy(e)` here, so the
    // registry must be empty when the skip is in effect.
    let rules: Array<ParserRule> = [mk_rule(
        "e",
        [
            alt([rr("e"), opt(tk("X"))]),
            alt([tk("X")]),
        ],
    )];
    let mut ctx = mk_ctx(&rules);
    let start = no_start();
    let _env = build(&rules, &mut ctx, &start);
    let entries = ctx.follow_variants();
    assert entries.is_empty(),
        `LR alt's leading self-ref must not contribute a variant; registry has {entries.len()} entries`;
}

test "variant pre-pass: LR rule walks non-LR alts before LR alts" {
    // Two-alt LR rule with the LR alt FIRST in source order:
    //   e : e b Y | a X ;
    //   a : N X? ;     // tail_greedy(a) = {TK_X}
    //   b : M Y? ;     // tail_greedy(b) = {TK_Y}
    //
    // Both alts trigger a variant on different rules:
    //   * Non-LR alt `a X` — call to `a` at position 0 with
    //     caller_follow=first(X)={TK_X}; intersection with
    //     tail_greedy(a)={TK_X} is non-empty, so variant
    //     `(a, mask=[TK_X])` is registered.
    //   * LR alt suffix `e b Y` — call to `b` at position 1 with
    //     caller_follow=first(Y)={TK_Y}; intersection with
    //     tail_greedy(b)={TK_Y} is non-empty, so variant
    //     `(b, mask=[TK_Y])` is registered.
    //
    // `lower::lower_lr_rule` partitions the alts and processes the
    // non-LR atom before the LR suffix. The walker mirrors that, so
    // `(a, mask=[TK_X])` lands at id 0 and `(b, mask=[TK_Y])` at
    // id 1 — even though the LR alt comes first in source order.
    //
    // A source-order walk (LR alt first) would flip the ids
    // (b → 0, a → 1). The byte-identical generated parser
    // regression check on `tests/generated/rust/rust.wado` would
    // catch that flip globally, but this unit test pins the
    // invariant explicitly on a self-contained two-rule grammar.
    let rules: Array<ParserRule> = [
        mk_rule(
            "e",
            [
                alt([rr("e"), rr("b"), tk("Y")]),
                alt([rr("a"), tk("X")]),
            ],
        ),
        mk_rule("a", [alt([tk("N"), opt(tk("X"))])]),
        mk_rule("b", [alt([tk("M"), opt(tk("Y"))])]),
    ];
    let mut ctx = mk_ctx(&rules);
    let start = no_start();
    let _env = build(&rules, &mut ctx, &start);
    let entries = ctx.follow_variants();
    assert entries.len() == 2,
        `expected 2 variants (one for a, one for b), got {entries.len()}`;
    assert entries[0].rule_name == "a",
        `expected first variant rule 'a' (non-LR alt processed first), got '{entries[0].rule_name}'`;
    assert entries[0].mask.len() == 1 && entries[0].mask[0] == "TK_X",
        `expected first variant mask=[TK_X], got len {entries[0].mask.len()}`;
    assert entries[1].rule_name == "b",
        `expected second variant rule 'b' (LR suffix walk after non-LR), got '{entries[1].rule_name}'`;
    assert entries[1].mask.len() == 1 && entries[1].mask[0] == "TK_Y",
        `expected second variant mask=[TK_Y], got len {entries[1].mask.len()}`;
}
