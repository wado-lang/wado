/// Ranges of one block, addressed without the `In` prefix a grammar writes
/// (`\p{InGreek}` → `greekandcoptic`), or an empty string when the name is
/// not a block.
pub fn block_ranges(name: &String) -> String {
    return match *name {
        "basiclatin" | "ascii" => "AH8=",
        "latin1supplement" | "latin1sup" | "latin1" => "gAF/",
        "latinextendeda" | "latinexta" => "gAJ/",
        "latinextendedb" | "latinextb" => "gAPPAQ==",
        "ipaextensions" | "ipaext" => "0ARf",
        "spacingmodifierletters" | "modifierletters" => "sAVP",
        "combiningdiacriticalmarks" | "diacriticals" => "gAZv",
        "greekandcoptic" | "greek" => "8AaPAQ==",
        "cyrillic" => "gAj/AQ==",
        "cyrillicsupplement" | "cyrillicsup" | "cyrillicsupplementary" => "gAov",
        "armenian" => "sApf",
        "hebrew" => "kAtv",
        "arabic" => "gAz/AQ==",
        "syriac" => "gA5P",
        "arabicsupplement" | "arabicsup" => "0A4v",
        "thaana" => "gA8/",
        "nko" => "wA8/",
        "samaritan" => "gBA/",
        "mandaic" => "wBAf",
        "syriacsupplement" | "syriacsup" => "4BAP",
        "arabicextendedb" | "arabicextb" => "8BAv",
        "arabicextendeda" | "arabicexta" => "oBFf",
        "devanagari" => "gBJ/",
        "bengali" => "gBN/",
        "gurmukhi" => "gBR/",
        "gujarati" => "gBV/",
        "oriya" => "gBZ/",
        "tamil" => "gBd/",
        "telugu" => "gBh/",
        "kannada" => "gBl/",
        "malayalam" => "gBp/",
        "sinhala" => "gBt/",
        "thai" => "gBx/",
        "lao" => "gB1/",
        "tibetan" => "gB7/AQ==",
        "myanmar" => "gCCfAQ==",
        "georgian" => "oCFf",
