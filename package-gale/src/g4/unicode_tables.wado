#![generated(by = "scripts/regen-unicode-tables.sh", sources = [])]
//! Unicode property ranges for `\p{...}` / `\P{...}` char sets: general
//! categories, scripts, blocks, binary properties, and the enumerated
//! `Property=Value` names ANTLR4 answers.
//!
//! Do not edit by hand — regenerate from UCD 17.0.0 with
//! `scripts/regen-unicode-tables.sh`.
//!
//! A property's ranges are base64 over `(gap from the previous range's
//! end, length)` varint pairs, and its keys are folded (lowercase, no
//! `_` / `-` / space) as UAX #44 matches them. `\P` complements what
//! `\p` selects, so an approximate table would admit real members of the
//! property, not merely miss some.

pub global UNICODE_VERSION: String = "17.0.0";

/// Ranges of one general category (`Lu`, `Nd`, …), or an empty string when
/// the name is not a general category. Group letters (`L`, `N`, …) are
/// unions of their subcategories and are resolved by the caller.
