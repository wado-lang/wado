/// Ranges of one `Vertical_Orientation` value, or an empty string when the name
/// is not one of its values.
pub fn vertical_orientation_ranges(name: &String) -> String {
    return match *name {
        "rotated" | "r" => "",
        "upright" | "u" => "",
        "transformedrotated" | "tr" => "mEABAgGLBgHdGQkCCxAAbwBbANyaAwWpAQEQAR8AAQABABsFggEA",
        "transformedupright" | "tu" => "gWABPgABAAEAAQABABkAHwABAAEABgAGAQQBBAABAAEAAQABABkAHwABAAEABgAGATAAjAEDAwA0D/8BWCME0JUDAq4BAAoAAQAQAJLkAgAdAgIADgOYgQEB",
        _ => "",
    };
}

/// Ranges of one enumerated property's value (`\p{lb=AL}`), or an empty
/// string when the property is not one of these or the value is not one of
/// its own. `General_Category`, `Script` and `Block` have their own tables.
pub fn enumerated_property_ranges(property: &String, value: &String) -> String {
    return match *property {
        "bidiclass" | "bc" => bidi_class_ranges(value),
        "linebreak" | "lb" => line_break_ranges(value),
        "wordbreak" | "wb" => word_break_ranges(value),
        "sentencebreak" | "sb" => sentence_break_ranges(value),
        "graphemeclusterbreak" | "gcb" => grapheme_cluster_break_ranges(value),
        "numerictype" | "nt" => numeric_type_ranges(value),
        "eastasianwidth" | "ea" => east_asian_width_ranges(value),
        "hangulsyllabletype" | "hst" => hangul_syllable_type_ranges(value),
        "joiningtype" | "jt" => joining_type_ranges(value),
        "indicsyllabiccategory" | "insc" => indic_syllabic_category_ranges(value),
        "decompositiontype" | "dt" => decomposition_type_ranges(value),
        "verticalorientation" | "vo" => vertical_orientation_ranges(value),
        _ => "",
    };
}
