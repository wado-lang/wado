//! Unicode property ranges for `\p{...}` / `\P{...}` char sets: general
//! categories, scripts, blocks and binary properties.
//!
//! Do not edit by hand — regenerate from UCD 17.0.0 with
//! `scripts/regen-unicode-tables.sh`.
//!
//! A property's ranges are `START[-END]` in hex, comma separated, and its
//! keys are folded (lowercase, no `_` / `-` / space) as UAX #44 matches
//! them. `\P` complements what `\p` selects, so an approximate table would
//! admit real members of the property, not merely miss some.

pub global UNICODE_VERSION: String = "17.0.0";

