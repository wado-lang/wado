/// Ranges of one block, addressed without the `In` prefix a grammar writes
/// (`\p{InGreek}` → `greekandcoptic`), or an empty string when the name is
/// not a block.
pub fn block_ranges(name: &String) -> String {
    return match *name {
        "basiclatin" | "ascii" => "AX4=",
        "latin1supplement" | "latin1sup" | "latin1" => "gQJ+",
        "latinextendeda" | "latinexta" => "gQR+",
        "latinextendedb" | "latinextb" => "gQbOAQ==",
        "ipaextensions" | "ipaext" => "oQle",
        "spacingmodifierletters" | "modifierletters" => "4QpO",
        "combiningdiacriticalmarks" | "diacriticals" => "gQxu",
        "greekandcoptic" | "greek" => "4Q2OAQ==",
        "cyrillic" => "gRD+AQ==",
        "cyrillicsupplement" | "cyrillicsup" | "cyrillicsupplementary" => "gRQu",
        "armenian" => "4RRe",
        "hebrew" => "oRZu",
        "arabic" => "gRj+AQ==",
        "syriac" => "gRxO",
        "arabicsupplement" | "arabicsup" => "oR0u",
        "thaana" => "gR4+",
        "nko" => "gR8+",
        "samaritan" => "gSA+",
        "mandaic" => "gSEe",
        "syriacsupplement" | "syriacsup" => "wSEO",
        "arabicextendedb" | "arabicextb" => "4SEu",
        "arabicextendeda" | "arabicexta" => "wSJe",
