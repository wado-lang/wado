/// Subcategories of a general-category group letter (`L` -> `Lu`, `Ll`, …),
/// or an empty list when the name is not a group.
pub fn general_category_group(name: &String) -> List<String> {
    return match *name {
        "l" | "letter" => ["ll", "lm", "lo", "lt", "lu"],
        "m" | "mark" => ["mc", "me", "mn"],
        "n" | "number" => ["nd", "nl", "no"],
        "p" | "punctuation" => ["pc", "pd", "pe", "pf", "pi", "po", "ps"],
        "s" | "symbol" => ["sc", "sk", "sm", "so"],
        "z" | "separator" => ["zl", "zp", "zs"],
        "c" | "other" => ["cc", "cf", "cn", "co", "cs"],
        _ => [],
    };
}

