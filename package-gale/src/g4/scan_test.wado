use {
    comment_end,
    scan_string,
    scan_char_class,
    scan_balanced,
    split_top_level_commas,
    word_at,
    ident_start,
    ident_end,
} from "./scan.wado";

test "comment_end stops a line comment at the newline" {
    let c = "// hi\nrest".as_str_slice();
    assert comment_end(&c, 0, c.len()) matches { Some(5) };
}

test "comment_end runs a line comment to end when no newline" {
    let c = "// trailing".as_str_slice();
    assert comment_end(&c, 0, c.len()) == Option::Some(c.len());
}

test "comment_end returns the offset past a closing */" {
    let c = "/* x */ y".as_str_slice();
    assert comment_end(&c, 0, c.len()) matches { Some(7) };
}

test "comment_end runs a block comment to end when unterminated" {
    let c = "/* open".as_str_slice();
    assert comment_end(&c, 0, c.len()) == Option::Some(c.len());
}

test "comment_end is null where no comment opens" {
    let c = "a / b /".as_str_slice();
    assert comment_end(&c, 0, c.len()) matches { None };
    assert comment_end(&c, 2, c.len()) matches { None };
    assert comment_end(&c, 6, c.len()) matches { None };
}

test "scan_string skips a single-quoted string" {
    let c = "'abc' tail".as_str_slice();
    assert scan_string(&c, 0) == 5;
}

test "scan_string skips a double-quoted string" {
    let c = "\"abc\" tail".as_str_slice();
    assert scan_string(&c, 0) == 5;
}

test "scan_string honors escaped quote" {
    // `'a\'b'` — the escaped quote is not the terminator
    let c = "'a\\'b' tail".as_str_slice();
    assert scan_string(&c, 0) == 6;
}

test "scan_string runs to end when unterminated" {
    let c = "'open".as_str_slice();
    assert scan_string(&c, 0) == c.len();
}

test "scan_char_class ends at the first unescaped ]" {
    let c = "[a-z] x".as_str_slice();
    assert scan_char_class(&c, 0) matches { Some(5) };
}

test "scan_char_class does not nest: literal [ is content" {
    // ANTLR4 char sets do not nest; `[/[]` ends at the first ']'.
    let c = "[/[] x".as_str_slice();
    assert scan_char_class(&c, 0) matches { Some(4) };
}

test "scan_char_class honors \\] escape" {
    let c = "[a\\]b] x".as_str_slice();
    assert scan_char_class(&c, 0) matches { Some(6) };
}

test "scan_char_class returns None when unterminated" {
    let c = "[a-z".as_str_slice();
    assert scan_char_class(&c, 0) matches { None };
}

test "scan_balanced handles a simple brace block" {
    let c = "{ x } rest".as_str_slice();
    assert scan_balanced(&c, 0, b'{', b'}') matches { Some(5) };
}

test "scan_balanced nests braces" {
    let c = "{ if (x) { y } } rest".as_str_slice();
    assert scan_balanced(&c, 0, b'{', b'}') matches { Some(16) };
}

test "scan_balanced ignores a close inside a string" {
    let c = "{ s = \"}\" } rest".as_str_slice();
    assert scan_balanced(&c, 0, b'{', b'}') matches { Some(11) };
}

test "scan_balanced ignores a close inside a line comment" {
    let c = "{ // }\n}".as_str_slice();
    assert scan_balanced(&c, 0, b'{', b'}') matches { Some(8) };
}

test "scan_balanced ignores a close inside a block comment" {
    let c = "{ /* } */ }".as_str_slice();
    assert scan_balanced(&c, 0, b'{', b'}') matches { Some(11) };
}

test "scan_balanced nests brackets for arg-actions" {
    let c = "[int[] arr] rest".as_str_slice();
    assert scan_balanced(&c, 0, b'[', b']') matches { Some(11) };
}

test "scan_balanced returns None when unterminated" {
    let c = "{ never closed".as_str_slice();
    assert scan_balanced(&c, 0, b'{', b'}') matches { None };
}

test "split_top_level_commas reads `<` as a comparison outside a type" {
    let args = split_top_level_commas(&"a < 2, b > 1, f(x, y)".as_str_slice(), false);
    assert args == ["a < 2", "b > 1", "f(x, y)"];
}

test "split_top_level_commas keeps a type's arguments in one piece" {
    let args = split_top_level_commas(
        &"m as Pair<i32, i32>, List::<A, B>::new(), |p: Pair<A, B>| p, || -> Pair<A, B> { x }".as_str_slice(),
        false,
    );
    assert args == ["m as Pair<i32, i32>", "List::<A, B>::new()", "|p: Pair<A, B>| p", "|| -> Pair<A, B> { x }"];
    let decls = split_top_level_commas(&"TreeMap<String, i32> m, i32 n = a < b".as_str_slice(), true);
    assert decls == ["TreeMap<String, i32> m", "i32 n = a < b"];
}

test "scanners return byte offsets past multi-byte chars" {
    assert scan_string(&"'日本' x".as_str_slice(), 0) == 8;
    assert scan_balanced(&"{ é } x".as_str_slice(), 0, b'{', b'}') matches { Some(6) };
    assert split_top_level_commas(&"f(\"é,\"), 日本 as Pair<é, b>".as_str_slice(), false) == [
        "f(\"é,\")", "日本 as Pair<é, b>",
    ];
}

test "an identifier's ends step over multi-byte name chars" {
    let s = "x.日本ab+".as_str_slice();
    assert ident_start(&s, 10) == 2;
    assert ident_end(&s, 2, s.len()) == 10;
}

test "word_at reads a multi-byte name char as part of the word" {
    let s = "éthis this".as_str_slice();
    assert !word_at(&s, 2, s.len(), "this");
    assert word_at(&s, 7, s.len(), "this");
}
