use { Span, chars_text } from "../runtime/lex.wado";
use { G4Token, Token } from "./token.wado";
use {
    scan_line_comment,
    scan_block_comment,
    scan_char_class,
    is_id_start_char,
    is_id_continue_char,
} from "./scan.wado";

pub struct G4Lexer {
    chars: &List<char>,
    pos: i32,
}

impl G4Lexer {
    pub fn new(chars: &List<char>) -> G4Lexer {
        return G4Lexer { chars, pos: 0 };
    }

    /// A token whose text is a copy of the source span `[start, end)`.
    fn owned_token(&self, kind: G4Token, start: i32, end: i32) -> Token {
        return Token::new(kind as i32, chars_text(self.chars, start, end), Span::new(start, end));
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }

    fn peek_at(&self, offset: i32) -> Option<char> {
        let i = self.pos + offset;
        if i >= self.chars.len() {
            return null;
        }
        return Option::<char>::Some(self.chars[i]);
    }

    fn advance(&mut self) -> char {
        let c = self.chars[self.pos];
        self.pos += 1;
        return c;
    }

    fn skip_whitespace(&mut self) {
        while !self.at_end() {
            if self.chars[self.pos].is_ascii_whitespace() {
                self.pos += 1;
            } else {
                break;
            }
        }
    }

    fn skip_whitespace_and_comments(&mut self) {
        loop {
            self.skip_whitespace();
            if self.at_end() {
                break;
            }
            let c = self.chars[self.pos];
            if c == '/' {
                if let Some(next) = self.peek_at(1) {
                    if next == '/' {
                        self.pos = scan_line_comment(self.chars, self.pos);
                        continue;
                    } else if next == '*' {
                        self.pos = scan_block_comment(self.chars, self.pos);
                        continue;
                    }
                }
            }
            break;
        }
    }

    fn read_string_literal(&mut self) -> Token {
        let start = self.pos;
        self.pos += 1;
        // The one token whose text is not its source span: escapes are resolved.
        let mut text = String::new();
        // The literal is scanned to its closing quote either way, so the next
        // token starts where it would have; only the kind and the span change.
        let mut bad: Option<Span> = null;
        loop {
            if self.at_end() {
                return self.owned_token(G4Token::UnterminatedString, start, self.pos);
            }
            let c = self.chars[self.pos];
            self.pos += 1;
            if c == '\'' {
                if let Some(esc) = bad {
                    return self.owned_token(G4Token::InvalidEscape, esc.start, esc.end);
                }
                return Token::new(G4Token::StringLit as i32, text, Span::new(start, self.pos));
            } else if c == '\\' && !self.at_end() {
                self.read_string_escape(&mut text, &mut bad);
            } else {
                text.push(c);
            }
        }
    }

    fn read_string_escape(&mut self, text: &mut String, bad: &mut Option<Span>) {
        let esc_start = self.pos - 1;
        let mut p = self.pos;
        let cp = decode_string_escape(self.chars, &mut p);
        self.pos = p;
        if cp == INVALID_ESCAPE {
            if *bad matches { None } {
                *bad = Option::<Span>::Some(Span::new(esc_start, self.pos));
            }
            return;
        }
        text.push(scalar_or_replacement(cp));
    }

    fn read_char_class(&mut self) -> Token {
        // `scan_char_class` handles the ANTLR4 char-set lexicon; the text is
        // a verbatim copy of its source span, so emit an owned token.
        let start = self.pos;
        match scan_char_class(self.chars, start) {
            Some(end) => {
                self.pos = end;
                return self.owned_token(G4Token::CharClass, start, end);
            },
            None => {
                self.pos = self.chars.len();
                return self.owned_token(G4Token::UnterminatedCharClass, start, self.pos);
            },
        }
    }

    fn read_int_literal(&mut self) -> Token {
        let start = self.pos;
        while !self.at_end() && '0' <= self.chars[self.pos] <= '9' {
            self.pos += 1;
        }
        return self.owned_token(G4Token::IntLit, start, self.pos);
    }

    fn read_identifier(&mut self) -> Token {
        let start = self.pos;
        while !self.at_end() && is_id_continue_char(self.chars[self.pos]) {
            self.pos += 1;
        }
        let text = chars_text(self.chars, start, self.pos);
        // Hard keywords only: `grammar` and `fragment` introduce structural
        // constructs that the parser disambiguates by token kind. Lexer command
        // names like `skip`, `channel`, `mode`, `more`, `pushMode`, `popMode`,
        // `type`, and the rule prequel keywords (`returns`, `throws`, `locals`,
        // `catch`, `finally`, `import`, `options`, `tokens`, `channels`,
        // `parser`, `lexer`) remain plain identifiers — they are matched by
        // text in the parser when their context demands it.
        let kind = match text {
            "grammar" => G4Token::Grammar,
            "fragment" => G4Token::Fragment,
            _ => G4Token::Identifier,
        };
        return Token::new(kind as i32, text, Span::new(start, self.pos));
    }

    pub fn next_token(&mut self) -> Token {
        self.skip_whitespace_and_comments();
        if self.at_end() {
            return self.owned_token(G4Token::Eof, self.pos, self.pos);
        }
        let start = self.pos;
        let c = self.chars[self.pos];
        if c == '\'' {
            return self.read_string_literal();
        }
        if c == '[' {
            return self.read_char_class();
        }
        if is_id_start_char(c) {
            return self.read_identifier();
        }
        if '0' <= c <= '9' {
            return self.read_int_literal();
        }
        // Two-char operators: peek ahead before consuming `c`.
        if c == '+' && self.peek_at(1) matches { Some('=') } {
            self.pos += 2;
            return self.owned_token(G4Token::PlusAssign, start, self.pos);
        }
        if c == ':' && self.peek_at(1) matches { Some(':') } {
            self.pos += 2;
            return self.owned_token(G4Token::ColonColon, start, self.pos);
        }
        self.pos += 1;
        let kind = match c {
            ':' => G4Token::Colon,
            ';' => G4Token::Semicolon,
            '|' => G4Token::Pipe,
            '(' => G4Token::LParen,
            ')' => G4Token::RParen,
            '*' => G4Token::Star,
            '+' => G4Token::Plus,
            '?' => G4Token::Question,
            '.' => G4Token::Dot,
            '~' => G4Token::Tilde,
            '=' => G4Token::Assign,
            '#' => G4Token::Hash,
            '{' => G4Token::LBrace,
            '}' => G4Token::RBrace,
            ',' => G4Token::Comma,
            '@' => G4Token::At,
            '<' => G4Token::LAngle,
            '>' => G4Token::RAngle,
            '-' && !self.at_end() && self.chars[self.pos] == '>' => {
                self.pos += 1;
                return self.owned_token(G4Token::Arrow, start, self.pos);
            },
            _ => {
                return self.owned_token(G4Token::UnexpectedChar, start, self.pos);
            },
        };
        return self.owned_token(kind, start, self.pos);
    }
}

/// Tokenize an already-collected char buffer, which `parse` shares with the
/// parser. Token text is owned, so the tokens do not alias `chars`.
pub fn tokenize_chars(chars: &List<char>) -> List<Token> {
    let mut lexer = G4Lexer::new(chars);
    let mut tokens: List<Token> = [];
    loop {
        let tok = lexer.next_token();
        let is_eof = tok.kind == G4Token::Eof as i32;
        tokens.push(tok);
        if is_eof {
            break;
        }
    }
    return tokens;
}

/// What a decoder returns for an escape ANTLR4 does not define. No code point
/// is negative, so it collides with none.
pub global INVALID_ESCAPE: i32 = -1;

/// One escape body — the chars *after* the `\` — as a code point, or
/// `INVALID_ESCAPE`. `pos` enters at the escape character and leaves past it.
pub fn decode_string_escape(chars: &List<char>, pos: &mut i32) -> i32 {
    let ec = chars[*pos];
    *pos += 1;
    return match ec {
        'u' => resolve_unicode_escape_code(chars, pos),
        '\'' => ec as i32,
        _ => decode_shared_escape(ec),
    };
}

/// The escapes a string literal and a char set both define.
pub fn decode_shared_escape(ec: char) -> i32 {
    return match ec {
        'n' => '\n' as i32,
        'r' => '\r' as i32,
        't' => '\t' as i32,
        'b' => '\u0008' as i32,
        'f' => '\u000C' as i32,
        '\\' => ec as i32,
        _ => INVALID_ESCAPE,
    };
}

/// Code points a string-literal token denotes, decoded from its source span
/// (`'…'`, quotes included). Unlike the token text, an unpaired surrogate
/// escape survives as its own code point rather than collapsing to U+FFFD —
/// a char-range endpoint must not silently become a different, matchable char.
pub fn string_literal_code_points(chars: &List<char>, span: Span) -> List<i32> {
    let mut out: List<i32> = [];
    let mut pos = span.start + 1;
    let last = span.end - 1;
    while pos < last {
        let c = chars[pos];
        pos += 1;
        if c == '\\' && pos < last {
            let cp = decode_string_escape(chars, &mut pos);
            assert cp != INVALID_ESCAPE, "a literal carrying an undefined escape lexes as InvalidEscape, so no StringLit reaches here with one";
            out.push(cp);
        } else {
            out.push(c as i32);
        }
    }
    return out;
}

/// The `char` for a code point, or U+FFFD when it is not a Unicode scalar
/// (an unpaired surrogate). Only for text that must stay a `String`.
pub fn scalar_or_replacement(code: i32) -> char {
    return match char::from_i32(code) {
        Some(ch) => ch,
        None => '\u{FFFD}',
    };
}

global MAX_CODE_POINT: i32 = 0x10FFFF;

/// Raw code point of a `\uXXXX` / `\u{…}` escape body (`pos` enters past the
/// `u`), or `INVALID_ESCAPE`. Surrogates come back verbatim.
pub fn resolve_unicode_escape_code(chars: &List<char>, pos: &mut i32) -> i32 {
    if *pos < chars.len() && chars[*pos] == '{' {
        *pos += 1;
        return resolve_braced_escape_code(chars, pos);
    }
    let [val, n] = scan_hex_digits(chars, pos, 4);
    if n < 4 {
        return INVALID_ESCAPE;
    }
    return val;
}

/// The `\u{…}` body past its `{`. The whole form is consumed before anything is
/// decided, so a caller reporting `pos` names the escape and not a prefix.
fn resolve_braced_escape_code(chars: &List<char>, pos: &mut i32) -> i32 {
    let [val, n] = scan_hex_digits(chars, pos, i32::MAX);
    let closed = *pos < chars.len() && chars[*pos] == '}';
    if closed {
        *pos += 1;
    }
    if n == 0 || !closed || val > MAX_CODE_POINT {
        return INVALID_ESCAPE;
    }
    return val;
}

/// The value and length of the hex run at `pos`, taking at most `limit` digits.
/// The value stops climbing at `MAX_CODE_POINT`, so no run overflows.
fn scan_hex_digits(chars: &List<char>, pos: &mut i32, limit: i32) -> [i32, i32] {
    let mut val = 0;
    let mut n = 0;
    while n < limit && *pos < chars.len() && chars[*pos].is_hexdigit() {
        if val <= MAX_CODE_POINT {
            val = val * 16 + chars[*pos].hex_digit_value();
        }
        *pos += 1;
        n += 1;
    }
    return [val, n];
}
