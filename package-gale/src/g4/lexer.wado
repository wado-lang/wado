use { Span, Token } from "../runtime.wado";
use { G4Token, make_token } from "./token.wado";

pub struct G4Lexer {
    chars: Array<char>,
    pos: i32,
}

impl G4Lexer {
    pub fn new(input: String) -> G4Lexer {
        return G4Lexer { chars: input.chars().collect(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }

    fn peek_at(&self, offset: i32) -> Option<char> {
        let i = self.pos + offset;
        if i >= self.chars.len() {
            return null;
        }
        return Option::<char>::Some(self.chars[i]);
    }

    fn advance(&mut self) -> char {
        let c = self.chars[self.pos];
        self.pos += 1;
        return c;
    }

    fn skip_whitespace(&mut self) {
        while !self.at_end() {
            if self.chars[self.pos].is_ascii_whitespace() {
                self.pos += 1;
            } else {
                break;
            }
        }
    }

    fn skip_line_comment(&mut self) {
        while !self.at_end() {
            let c = self.advance();
            if c == '\n' {
                break;
            }
        }
    }

    fn skip_block_comment(&mut self) {
        while !self.at_end() {
            let c = self.advance();
            if c == '*' && !self.at_end() && self.chars[self.pos] == '/' {
                self.pos += 1;
                return;
            }
        }
    }

    fn skip_whitespace_and_comments(&mut self) {
        loop {
            self.skip_whitespace();
            if self.at_end() {
                break;
            }
            let c = self.chars[self.pos];
            if c == '/' {
                if let Some(next) = self.peek_at(1) {
                    if next == '/' {
                        self.pos += 2;
                        self.skip_line_comment();
                        continue;
                    } else if next == '*' {
                        self.pos += 2;
                        self.skip_block_comment();
                        continue;
                    }
                }
            }
            break;
        }
    }

    fn read_string_literal(&mut self) -> Token {
        let start = self.pos;
        self.pos += 1;
        let mut text = String::with_capacity(16);
        loop {
            if self.at_end() {
                return make_token(G4Token::Error, "unterminated string", start, self.pos);
            }
            let c = self.chars[self.pos];
            self.pos += 1;
            if c == '\'' {
                return make_token(G4Token::StringLit, text, start, self.pos);
            } else if c == '\\' && !self.at_end() {
                self.read_string_escape(&mut text);
            } else {
                text.push(c);
            }
        }
    }

    fn read_string_escape(&mut self, text: &mut String) {
        let ec = self.chars[self.pos];
        self.pos += 1;
        if ec == 'u' {
            if !self.at_end() && self.chars[self.pos] == '{' {
                self.pos += 1;
                let mut val = 0;
                while !self.at_end() && self.chars[self.pos] != '}' {
                    val = val * 16 + hex_value(self.chars[self.pos]);
                    self.pos += 1;
                }
                if !self.at_end() {
                    self.pos += 1;
                }
                text.push(char::from_i32(val).unwrap());
            } else {
                let mut val = 0;
                let mut hex_count = 0;
                while hex_count < 4 && !self.at_end() {
                    val = val * 16 + hex_value(self.chars[self.pos]);
                    self.pos += 1;
                    hex_count += 1;
                }
                text.push(char::from_i32(val).unwrap());
            }
        } else if ec == 'n' {
            text.push('\n');
        } else if ec == 'r' {
            text.push('\r');
        } else if ec == 't' {
            text.push('\t');
        } else if ec == 'f' {
            text.push('\u000C');
        } else {
            text.push(ec);
        }
    }

    fn read_char_class(&mut self) -> Token {
        let start = self.pos;
        self.pos += 1;
        let mut text = String::with_capacity(16);
        text.push('[');
        loop {
            if self.at_end() {
                return make_token(G4Token::Error, "unterminated char class", start, self.pos);
            }
            let c = self.chars[self.pos];
            self.pos += 1;
            if c == ']' {
                text.push(']');
                return make_token(G4Token::CharClass, text, start, self.pos);
            } else if c == '\\' {
                text.push(c);
                if !self.at_end() {
                    text.push(self.chars[self.pos]);
                    self.pos += 1;
                }
            } else {
                text.push(c);
            }
        }
    }

    fn read_identifier(&mut self) -> Token {
        let start = self.pos;
        let mut text = String::with_capacity(16);
        while !self.at_end() {
            let c = self.chars[self.pos];
            if is_ident_char(c) {
                text.push(c);
                self.pos += 1;
            } else {
                break;
            }
        }
        let kind = match text {
            "grammar" => G4Token::Grammar,
            "fragment" => G4Token::Fragment,
            "skip" => G4Token::Skip,
            "channel" => G4Token::Channel,
            _ => G4Token::Identifier,
        };
        return make_token(kind, text, start, self.pos);
    }

    pub fn next_token(&mut self) -> Token {
        self.skip_whitespace_and_comments();
        if self.at_end() {
            return make_token(G4Token::Eof, "", self.pos, self.pos);
        }
        let start = self.pos;
        let c = self.chars[self.pos];
        if c == '\'' {
            return self.read_string_literal();
        }
        if c == '[' {
            return self.read_char_class();
        }
        if is_ident_start(c) {
            return self.read_identifier();
        }
        self.pos += 1;
        let text = String::from(c);
        let kind = match c {
            ':' => G4Token::Colon,
            ';' => G4Token::Semicolon,
            '|' => G4Token::Pipe,
            '(' => G4Token::LParen,
            ')' => G4Token::RParen,
            '*' => G4Token::Star,
            '+' => G4Token::Plus,
            '?' => G4Token::Question,
            '.' => G4Token::Dot,
            '~' => G4Token::Tilde,
            '=' => G4Token::Assign,
            '#' => G4Token::Hash,
            '{' => G4Token::LBrace,
            '}' => G4Token::RBrace,
            ',' => G4Token::Comma,
            '@' => G4Token::At,
            '<' => G4Token::LAngle,
            '>' => G4Token::RAngle,
            '-' && !self.at_end() && self.chars[self.pos] == '>' => {
                self.pos += 1;
                return make_token(G4Token::Arrow, "->", start, self.pos);
            },
            _ => {
                return make_token(G4Token::Error, `unexpected char: {c}`, start, self.pos);
            },
        };
        return make_token(kind, text, start, self.pos);
    }
}

pub fn tokenize(input: String) -> Array<Token> {
    let mut lexer = G4Lexer::new(input);
    let mut tokens: Array<Token> = [];
    loop {
        let tok = lexer.next_token();
        let is_eof = tok.kind == G4Token::Eof as i32;
        tokens.push(tok);
        if is_eof {
            break;
        }
    }
    return tokens;
}

fn is_ident_start(c: char) -> bool {
    return 'a' <= c <= 'z' || 'A' <= c <= 'Z' || c == '_';
}

fn is_ident_char(c: char) -> bool {
    return is_ident_start(c) || '0' <= c <= '9';
}

fn hex_value(c: char) -> i32 {
    if '0' <= c <= '9' {
        return c as i32 - '0' as i32;
    }
    if 'a' <= c <= 'f' {
        return c as i32 - 'a' as i32 + 10;
    }
    if 'A' <= c <= 'F' {
        return c as i32 - 'A' as i32 + 10;
    }
    return 0;
}
