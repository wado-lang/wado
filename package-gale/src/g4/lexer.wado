use { Span, Token, LexerSlice } from "../runtime/lex.wado";
use { G4Token, make_token } from "./token.wado";
use { scan_line_comment, scan_block_comment, scan_char_class } from "./scan.wado";

pub struct G4Lexer {
    chars: &List<char>,
    pos: i32,
}

impl G4Lexer {
    pub fn new(chars: &List<char>) -> G4Lexer with stores[chars] {
        return G4Lexer { chars, pos: 0 };
    }

    /// Mint a token whose text is a verbatim copy of the source span
    /// `[start, end)`. The owned char buffer is built in a single pass with
    /// exact capacity, avoiding both the intermediate `String` and the
    /// re-`collect` that `make_token`'s `String` -> `LexerSlice` round-trip
    /// incurred per token. Used for every token whose text equals its raw
    /// source span (char classes, operators, EOF); identifiers and ints
    /// build their buffer inline while scanning.
    fn owned_token(&self, kind: G4Token, start: i32, end: i32) -> Token {
        let mut buf: List<char> = List::with_capacity(end - start);
        for let mut i = start; i < end; i += 1 {
            buf.push(self.chars[i]);
        }
        return Token::new(kind as i32, owned_slice(buf), Span::new(start, end));
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }

    fn peek_at(&self, offset: i32) -> Option<char> {
        let i = self.pos + offset;
        if i >= self.chars.len() {
            return null;
        }
        return Option::<char>::Some(self.chars[i]);
    }

    fn advance(&mut self) -> char {
        let c = self.chars[self.pos];
        self.pos += 1;
        return c;
    }

    fn skip_whitespace(&mut self) {
        while !self.at_end() {
            if self.chars[self.pos].is_ascii_whitespace() {
                self.pos += 1;
            } else {
                break;
            }
        }
    }

    fn skip_whitespace_and_comments(&mut self) {
        loop {
            self.skip_whitespace();
            if self.at_end() {
                break;
            }
            let c = self.chars[self.pos];
            if c == '/' {
                if let Some(next) = self.peek_at(1) {
                    if next == '/' {
                        self.pos = scan_line_comment(self.chars, self.pos);
                        continue;
                    } else if next == '*' {
                        self.pos = scan_block_comment(self.chars, self.pos);
                        continue;
                    }
                }
            }
            break;
        }
    }

    fn read_string_literal(&mut self) -> Token {
        let start = self.pos;
        self.pos += 1;
        // String literals are the one token kind whose text is transformed
        // (escapes resolved), so it cannot alias the raw source. Build the
        // owned char buffer directly instead of going through an intermediate
        // String + re-collect.
        let mut text: List<char> = [];
        loop {
            if self.at_end() {
                return make_token(G4Token::Error, "unterminated string", start, self.pos);
            }
            let c = self.chars[self.pos];
            self.pos += 1;
            if c == '\'' {
                return Token::new(G4Token::StringLit as i32, owned_slice(text), Span::new(start, self.pos));
            } else if c == '\\' && !self.at_end() {
                self.read_string_escape(&mut text);
            } else {
                text.push(c);
            }
        }
    }

    fn read_string_escape(&mut self, text: &mut List<char>) {
        let mut p = self.pos;
        let cp = decode_string_escape(self.chars, &mut p);
        self.pos = p;
        text.push(scalar_or_replacement(cp));
    }

    fn read_char_class(&mut self) -> Token {
        // `scan_char_class` handles the ANTLR4 char-set lexicon; the text is
        // a verbatim copy of its source span, so emit an owned token.
        let start = self.pos;
        match scan_char_class(self.chars, start) {
            Some(end) => {
                self.pos = end;
                return self.owned_token(G4Token::CharClass, start, end);
            },
            None => {
                self.pos = self.chars.len();
                return make_token(G4Token::Error, "unterminated char class", start, self.pos);
            },
        }
    }

    fn read_int_literal(&mut self) -> Token {
        let start = self.pos;
        let mut buf: List<char> = List::with_capacity(4);
        while !self.at_end() {
            let c = self.chars[self.pos];
            if '0' <= c <= '9' {
                buf.push(c);
                self.pos += 1;
            } else {
                break;
            }
        }
        return Token::new(G4Token::IntLit as i32, owned_slice(buf), Span::new(start, self.pos));
    }

    fn read_identifier(&mut self) -> Token {
        let start = self.pos;
        let mut buf: List<char> = List::with_capacity(16);
        while !self.at_end() {
            let c = self.chars[self.pos];
            if is_ident_char(c) {
                buf.push(c);
                self.pos += 1;
            } else {
                break;
            }
        }
        // Hard keywords only: `grammar` and `fragment` introduce structural
        // constructs that the parser disambiguates by token kind. Lexer command
        // names like `skip`, `channel`, `mode`, `more`, `pushMode`, `popMode`,
        // `type`, and the rule prequel keywords (`returns`, `throws`, `locals`,
        // `catch`, `finally`, `import`, `options`, `tokens`, `channels`,
        // `parser`, `lexer`) remain plain identifiers — they are matched by
        // text in the parser when their context demands it. The length gate
        // skips the char comparison for the overwhelming majority of
        // identifiers, which are neither 7 nor 8 chars long.
        let kind = match buf.len() {
            7 => if buf_eq(&buf, &"grammar") { G4Token::Grammar } else { G4Token::Identifier },
            8 => if buf_eq(&buf, &"fragment") { G4Token::Fragment } else { G4Token::Identifier },
            _ => G4Token::Identifier,
        };
        return Token::new(kind as i32, owned_slice(buf), Span::new(start, self.pos));
    }

    pub fn next_token(&mut self) -> Token {
        self.skip_whitespace_and_comments();
        if self.at_end() {
            return self.owned_token(G4Token::Eof, self.pos, self.pos);
        }
        let start = self.pos;
        let c = self.chars[self.pos];
        if c == '\'' {
            return self.read_string_literal();
        }
        if c == '[' {
            return self.read_char_class();
        }
        if is_ident_start(c) {
            return self.read_identifier();
        }
        if '0' <= c <= '9' {
            return self.read_int_literal();
        }
        // Two-char operators: peek ahead before consuming `c`.
        if c == '+' && self.peek_at(1) matches { Some('=') } {
            self.pos += 2;
            return self.owned_token(G4Token::PlusAssign, start, self.pos);
        }
        if c == ':' && self.peek_at(1) matches { Some(':') } {
            self.pos += 2;
            return self.owned_token(G4Token::ColonColon, start, self.pos);
        }
        self.pos += 1;
        let kind = match c {
            ':' => G4Token::Colon,
            ';' => G4Token::Semicolon,
            '|' => G4Token::Pipe,
            '(' => G4Token::LParen,
            ')' => G4Token::RParen,
            '*' => G4Token::Star,
            '+' => G4Token::Plus,
            '?' => G4Token::Question,
            '.' => G4Token::Dot,
            '~' => G4Token::Tilde,
            '=' => G4Token::Assign,
            '#' => G4Token::Hash,
            '{' => G4Token::LBrace,
            '}' => G4Token::RBrace,
            ',' => G4Token::Comma,
            '@' => G4Token::At,
            '<' => G4Token::LAngle,
            '>' => G4Token::RAngle,
            '-' && !self.at_end() && self.chars[self.pos] == '>' => {
                self.pos += 1;
                return self.owned_token(G4Token::Arrow, start, self.pos);
            },
            _ => {
                return make_token(G4Token::Error, `unexpected char: ${c}`, start, self.pos);
            },
        };
        return self.owned_token(kind, start, self.pos);
    }
}

/// Tokenize directly from an already-collected char buffer. `parse` uses
/// this to share the single `List<char>` collection between the lexer and
/// the parser (which keeps it for `scan_balanced`), instead of collecting
/// the whole input twice. Token text is owned (`owned_slice`), so
/// the tokens do not alias `chars` and the buffer may be moved afterwards.
pub fn tokenize_chars(chars: &List<char>) -> List<Token> {
    let mut lexer = G4Lexer::new(chars);
    let mut tokens: List<Token> = [];
    loop {
        let tok = lexer.next_token();
        let is_eof = tok.kind == G4Token::Eof as i32;
        tokens.push(tok);
        if is_eof {
            break;
        }
    }
    return tokens;
}

/// Wrap an owned char buffer as a `LexerSlice` over its full extent, without
/// the `String` round-trip + re-`collect` that `LexerSlice::from_string`
/// performs. Kept local to the g4 frontend so it is not inlined into every
/// generated parser through the runtime (`runtime/lex.wado`).
fn owned_slice(buf: List<char>) -> LexerSlice {
    let n = buf.len();
    return LexerSlice { chars: &buf, start: 0, end: n };
}

/// Compare an owned char buffer against a keyword literal. Callers gate on
/// `buf.len()` first, so this only runs for length-matched candidates.
fn buf_eq(buf: &List<char>, lit: &String) -> bool {
    let mut i = 0;
    for let c of lit.chars() {
        if i >= buf.len() || buf[i] != c {
            return false;
        }
        i += 1;
    }
    return i == buf.len();
}

fn is_ident_start(c: char) -> bool {
    return 'a' <= c <= 'z' || 'A' <= c <= 'Z' || c == '_';
}

fn is_ident_char(c: char) -> bool {
    return is_ident_start(c) || '0' <= c <= '9';
}

/// Decode one escape body — the chars *after* the `\` — into a code point.
/// `pos` enters at the escape character and leaves past the escape.
pub fn decode_string_escape(chars: &List<char>, pos: &mut i32) -> i32 {
    let ec = chars[*pos];
    *pos += 1;
    return match ec {
        'u' => resolve_unicode_escape_code(chars, pos),
        'n' => '\n' as i32,
        'r' => '\r' as i32,
        't' => '\t' as i32,
        'b' => '\u0008' as i32,
        'f' => '\u000C' as i32,
        _ => ec as i32,
    };
}

/// Code points a string-literal token denotes, decoded from its source span
/// (`'…'`, quotes included). Unlike the token text, an unpaired surrogate
/// escape survives as its own code point instead of collapsing to U+FFFD —
/// `char` cannot hold one, but a char-range endpoint must not silently become
/// a different, matchable character.
pub fn string_literal_code_points(chars: &List<char>, span: Span) -> List<i32> {
    let mut out: List<i32> = [];
    let mut pos = span.start + 1;
    let last = span.end - 1;
    while pos < last {
        let c = chars[pos];
        pos += 1;
        if c == '\\' && pos < last {
            out.push(decode_string_escape(chars, &mut pos));
        } else {
            out.push(c as i32);
        }
    }
    return out;
}

/// The `char` for a code point, or U+FFFD when it is not a Unicode scalar
/// (an unpaired surrogate). Only for text that must stay a `String`.
pub fn scalar_or_replacement(code: i32) -> char {
    return match char::from_i32(code) {
        Some(ch) => ch,
        None => '\u{FFFD}',
    };
}

/// Raw code point of a `\uXXXX` / `\u{…}` escape body (`pos` enters past the
/// `u`). Surrogates come back verbatim; the caller decides what they mean.
pub fn resolve_unicode_escape_code(chars: &List<char>, pos: &mut i32) -> i32 {
    let mut val = 0;
    if *pos < chars.len() && chars[*pos] == '{' {
        *pos += 1;
        while *pos < chars.len() && chars[*pos] != '}' {
            if !chars[*pos].is_hexdigit() {
                break;
            }
            val = val * 16 + chars[*pos].hex_digit_value();
            *pos += 1;
        }
        if *pos < chars.len() && chars[*pos] == '}' {
            *pos += 1;
        }
    } else {
        let mut n = 0;
        while n < 4 && *pos < chars.len() && chars[*pos].is_hexdigit() {
            val = val * 16 + chars[*pos].hex_digit_value();
            *pos += 1;
            n += 1;
        }
    }
    return val;
}
