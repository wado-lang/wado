use { Span, char_at } from "../runtime/lex.wado";
use { G4Token, Token } from "./token.wado";
use { scan_line_comment, scan_block_comment, scan_char_class, ident_end, is_id_start_char } from "./scan.wado";
use { CODE_POINT_MAX } from "./unicode.wado";

pub struct G4Lexer {
    src: &StrSlice,
    pos: i32,
}

impl G4Lexer {
    pub fn new(src: &StrSlice) -> G4Lexer {
        return G4Lexer { src, pos: 0 };
    }

    /// A token whose text is a copy of the source span `[start, end)`.
    fn owned_token(&self, kind: G4Token, start: i32, end: i32) -> Token {
        return Token::new(kind.code(), self.src.slice(start, end).to_string(), Span::new(start, end));
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.src.len();
    }

    fn byte_after(&self, offset: i32) -> Option<u8> {
        let i = self.pos + offset;
        if i >= self.src.len() {
            return null;
        }
        return Option::<u8>::Some(self.src.byte_at(i));
    }

    fn skip_whitespace(&mut self) {
        while !self.at_end() && self.src.byte_at(self.pos).is_ascii_whitespace() {
            self.pos += 1;
        }
    }

    fn skip_whitespace_and_comments(&mut self) {
        loop {
            self.skip_whitespace();
            if self.at_end() || self.src.byte_at(self.pos) != b'/' {
                break;
            }
            match self.byte_after(1) {
                Some(b'/') => self.pos = scan_line_comment(self.src, self.pos),
                Some(b'*') => self.pos = scan_block_comment(self.src, self.pos),
                _ => {
                    break;
                },
            }
        }
    }

    fn read_string_literal(&mut self) -> Token {
        let start = self.pos;
        self.pos += 1;
        // The one token whose text is not its source span: escapes are resolved.
        let mut text = String::new();
        let mut run = self.pos;
        // The literal is scanned to its closing quote either way, so the next
        // token starts where it would have; only the kind and the span change.
        let mut bad: Option<Span> = null;
        loop {
            if self.at_end() {
                return self.owned_token(G4Token::UnterminatedString, start, self.pos);
            }
            let b = self.src.byte_at(self.pos);
            if b == b'\'' {
                text.push_str(self.src.slice(run, self.pos));
                self.pos += 1;
                if let Some(esc) = bad {
                    return self.owned_token(G4Token::InvalidEscape, esc.start, esc.end);
                }
                return Token::new(G4Token::StringLit.code(), text, Span::new(start, self.pos));
            }
            if b == b'\\' && self.pos + 1 < self.src.len() {
                text.push_str(self.src.slice(run, self.pos));
                self.pos += 1;
                self.read_string_escape(&mut text, &mut bad);
                run = self.pos;
            } else {
                self.pos += 1;
            }
        }
    }

    fn read_string_escape(&mut self, text: &mut String, bad: &mut Option<Span>) {
        let esc_start = self.pos - 1;
        let mut p = self.pos;
        let cp = decode_string_escape(self.src, &mut p);
        self.pos = p;
        if cp == INVALID_ESCAPE {
            if *bad matches { None } {
                *bad = Option::<Span>::Some(Span::new(esc_start, self.pos));
            }
            return;
        }
        text.push(scalar_or_replacement(cp));
    }

    fn read_char_class(&mut self) -> Token {
        // `scan_char_class` handles the ANTLR4 char-set lexicon; the text is
        // a verbatim copy of its source span, so emit an owned token.
        let start = self.pos;
        match scan_char_class(self.src, start) {
            Some(end) => {
                self.pos = end;
                return self.owned_token(G4Token::CharClass, start, end);
            },
            None => {
                self.pos = self.src.len();
                return self.owned_token(G4Token::UnterminatedCharClass, start, self.pos);
            },
        }
    }

    fn read_int_literal(&mut self) -> Token {
        let start = self.pos;
        while !self.at_end() && self.src.byte_at(self.pos).is_ascii_digit() {
            self.pos += 1;
        }
        return self.owned_token(G4Token::IntLit, start, self.pos);
    }

    fn read_identifier(&mut self) -> Token {
        let start = self.pos;
        self.pos = ident_end(self.src, start, self.src.len());
        let text = self.src.slice(start, self.pos).to_string();
        // Hard keywords only: `grammar` and `fragment` introduce structural
        // constructs that the parser disambiguates by token kind. Lexer command
        // names like `skip`, `channel`, `mode`, `more`, `pushMode`, `popMode`,
        // `type`, and the rule prequel keywords (`returns`, `throws`, `locals`,
        // `catch`, `finally`, `import`, `options`, `tokens`, `channels`,
        // `parser`, `lexer`) remain plain identifiers — they are matched by
        // text in the parser when their context demands it.
        let kind = match text {
            "grammar" => G4Token::Grammar,
            "fragment" => G4Token::Fragment,
            _ => G4Token::Identifier,
        };
        return Token::new(kind.code(), text, Span::new(start, self.pos));
    }

    pub fn next_token(&mut self) -> Token {
        self.skip_whitespace_and_comments();
        if self.at_end() {
            return self.owned_token(G4Token::Eof, self.pos, self.pos);
        }
        let start = self.pos;
        let b = self.src.byte_at(self.pos);
        if b == b'\'' {
            return self.read_string_literal();
        }
        if b == b'[' {
            return self.read_char_class();
        }
        if is_id_start_char(char_at(self.src, self.pos)) {
            return self.read_identifier();
        }
        if b.is_ascii_digit() {
            return self.read_int_literal();
        }
        if b == b'+' && self.byte_after(1) matches { Some(b'=') } {
            self.pos += 2;
            return self.owned_token(G4Token::PlusAssign, start, self.pos);
        }
        if b == b':' && self.byte_after(1) matches { Some(b':') } {
            self.pos += 2;
            return self.owned_token(G4Token::ColonColon, start, self.pos);
        }
        // One token, as in ANTLR4: `. .` is two wildcards, never a range.
        if b == b'.' && self.byte_after(1) matches { Some(b'.') } {
            self.pos += 2;
            return self.owned_token(G4Token::Range, start, self.pos);
        }
        if b == b'-' && self.byte_after(1) matches { Some(b'>') } {
            self.pos += 2;
            return self.owned_token(G4Token::Arrow, start, self.pos);
        }
        self.pos = self.src.ceil_char_boundary(start + 1);
        let kind = match b {
            b':' => G4Token::Colon,
            b';' => G4Token::Semicolon,
            b'|' => G4Token::Pipe,
            b'(' => G4Token::LParen,
            b')' => G4Token::RParen,
            b'*' => G4Token::Star,
            b'+' => G4Token::Plus,
            b'?' => G4Token::Question,
            b'.' => G4Token::Dot,
            b'~' => G4Token::Tilde,
            b'=' => G4Token::Assign,
            b'#' => G4Token::Hash,
            b'{' => G4Token::LBrace,
            b'}' => G4Token::RBrace,
            b',' => G4Token::Comma,
            b'@' => G4Token::At,
            b'<' => G4Token::LAngle,
            b'>' => G4Token::RAngle,
            _ => G4Token::UnexpectedChar,
        };
        return self.owned_token(kind, start, self.pos);
    }
}

/// Tokenize a `.g4` source, which `parse` shares with the parser. Token text
/// is owned, so the tokens do not alias `src`.
pub fn tokenize(src: &StrSlice) -> List<Token> {
    let mut lexer = G4Lexer::new(src);
    let mut tokens: List<Token> = [];
    loop {
        let tok = lexer.next_token();
        let is_eof = tok.kind == G4Token::Eof.code();
        tokens.push(tok);
        if is_eof {
            break;
        }
    }
    return tokens;
}

/// What a decoder returns for an escape ANTLR4 does not define. No code point
/// is negative, so it collides with none.
pub global INVALID_ESCAPE: i32 = -1;

/// One escape body — the chars *after* the `\` — as a code point, or
/// `INVALID_ESCAPE`. `pos` enters at the escape character and leaves past it.
pub fn decode_string_escape(src: &StrSlice, pos: &mut i32) -> i32 {
    let ec = char_at(src, *pos);
    *pos = src.ceil_char_boundary(*pos + 1);
    return match ec {
        'u' => resolve_unicode_escape_code(src, pos),
        '\'' => ec as i32,
        _ => decode_shared_escape(ec),
    };
}

/// The escapes a string literal and a char set both define.
pub fn decode_shared_escape(ec: char) -> i32 {
    return match ec {
        'n' => '\n' as i32,
        'r' => '\r' as i32,
        't' => '\t' as i32,
        'b' => '\u0008' as i32,
        'f' => '\u000C' as i32,
        '\\' => ec as i32,
        _ => INVALID_ESCAPE,
    };
}

/// Code points a string-literal token denotes, decoded from its source span
/// (`'…'`, quotes included). Unlike the token text, an unpaired surrogate
/// escape survives as its own code point rather than collapsing to U+FFFD —
/// a char-range endpoint must not silently become a different, matchable char.
pub fn string_literal_code_points(src: &StrSlice, span: Span) -> List<i32> {
    let mut out: List<i32> = [];
    let mut pos = span.start + 1;
    let last = span.end - 1;
    while pos < last {
        let c = char_at(src, pos);
        pos = src.ceil_char_boundary(pos + 1);
        if c == '\\' && pos < last {
            let cp = decode_string_escape(src, &mut pos);
            assert cp != INVALID_ESCAPE, "a literal carrying an undefined escape lexes as InvalidEscape, so no StringLit reaches here with one";
            out.push(cp);
        } else {
            out.push(c as i32);
        }
    }
    return out;
}

/// The `char` for a code point, or U+FFFD when it is not a Unicode scalar
/// (an unpaired surrogate). Only for text that must stay a `String`.
pub fn scalar_or_replacement(code: i32) -> char {
    if code < 0 || !char::is_scalar_value(code as u32) {
        return '\u{FFFD}';
    }
    return unchecked char::from_i32(code);
}

/// Raw code point of a `\uXXXX` / `\u{…}` escape body (`pos` enters past the
/// `u`), or `INVALID_ESCAPE`. Surrogates come back verbatim.
pub fn resolve_unicode_escape_code(src: &StrSlice, pos: &mut i32) -> i32 {
    if *pos < src.len() && src.byte_at(*pos) == b'{' {
        *pos += 1;
        return resolve_braced_escape_code(src, pos);
    }
    let [val, n] = scan_hex_digits(src, pos, 4);
    if n < 4 {
        return INVALID_ESCAPE;
    }
    return val;
}

/// The `\u{…}` body past its `{`. The whole form is consumed before anything is
/// decided, so a caller reporting `pos` names the escape and not a prefix.
fn resolve_braced_escape_code(src: &StrSlice, pos: &mut i32) -> i32 {
    let [val, n] = scan_hex_digits(src, pos, i32::MAX);
    let closed = *pos < src.len() && src.byte_at(*pos) == b'}';
    if closed {
        *pos += 1;
    }
    if n == 0 || !closed || val > CODE_POINT_MAX {
        return INVALID_ESCAPE;
    }
    return val;
}

/// The value and length of the hex run at `pos`, taking at most `limit` digits.
/// The value stops climbing at `CODE_POINT_MAX`, so no run overflows.
fn scan_hex_digits(src: &StrSlice, pos: &mut i32, limit: i32) -> [i32, i32] {
    let mut val = 0;
    let mut n = 0;
    while n < limit && *pos < src.len() && src.byte_at(*pos).is_hexdigit() {
        if val <= CODE_POINT_MAX {
            val = val * 16 + unchecked (src.byte_at(*pos) as char).hex_digit_value();
        }
        *pos += 1;
        n += 1;
    }
    return [val, n];
}
