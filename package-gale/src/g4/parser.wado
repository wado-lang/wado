use { Token, ParseError, Span } from "../runtime/lex.wado";
use {
    Grammar,
    GrammarKind,
    GrammarOption,
    OptionValue,
    ActionSource,
    ActionKind,
    AltAction,
    AttrDecl,
    CatchClause,
    ActionLanguage,
    NamedAction,
    PendingRef,
    RefKind,
    ParserRule,
    Alternative,
    Element,
    RuleRefElement,
    TokenRefElement,
    LiteralElement,
    WildcardElement,
    GroupElement,
    RepeatElement,
    LabelElement,
    NotElement,
    RepeatKind,
    LexerRule,
    LexerAlternative,
    LexerElement,
    LexerRepeatElement,
    LexerNotElement,
    CharClass,
    CharRange,
    Visibility,
    DEFAULT_MODE,
    NO_MODE,
    DEFAULT_CHANNEL,
    HIDDEN_CHANNEL,
    check_references,
    synthesize_implicit_tokens,
    merge_grammars,
} from "../ir.wado";
use { G4Token } from "./token.wado";
use { tokenize_chars, resolve_unicode_escape } from "./lexer.wado";
use { scan_balanced, is_id_continue_char } from "./scan.wado";

pub struct G4Parser {
    tokens: List<Token>,
    chars: List<char>,
    pos: i32,
    channels: List<String>,
    options: List<GrammarOption>,
    named_actions: List<NamedAction>,
    pending_refs: List<PendingRef>,
    current_rule: String,
    kind: GrammarKind,
}

struct LexerCommands {
    skip: bool,
    more: bool,
    type_override: Option<String>,
    channel: i32,
    set_mode: i32,
    push_mode: i32,
    pop_mode: bool,
}

impl LexerCommands {
    fn empty() -> LexerCommands {
        return LexerCommands {
            skip: false,
            more: false,
            type_override: null,
            channel: 0,
            set_mode: NO_MODE,
            push_mode: NO_MODE,
            pop_mode: false,
        };
    }
}

fn first_char(s: &String) -> Option<char> {
    let mut iter = s.chars();
    return iter.next();
}

fn is_lexer_rule_name(name: &String) -> bool {
    if let Some(c) = first_char(name) {
        return 'A' <= c <= 'Z';
    }
    return false;
}

fn is_valid_not_set_element(elem: &Element) -> bool {
    if let TokenRef(_) = elem {
        return true;
    }
    if let Literal(_) = elem {
        return true;
    }
    if let Group(g) = elem {
        for let alt of &g.alternatives {
            if alt.elements.len() != 1 {
                return false;
            }
            if let TokenRef(_) = alt.elements[0] {
                continue;
            }
            if let Literal(_) = alt.elements[0] {
                continue;
            }
            return false;
        }
        return true;
    }
    return false;
}

fn is_valid_lexer_not_element(elem: &LexerElement) -> bool {
    if let Literal(s) = elem {
        return s.chars().count() == 1;
    }
    if let CharRange(_) = elem {
        return true;
    }
    if let CharClass(_) = elem {
        return true;
    }
    if let Group(alts) = elem {
        for let alt of alts {
            if alt.elements.len() != 1 {
                return false;
            }
            if !is_valid_lexer_not_element(&alt.elements[0]) {
                return false;
            }
        }
        return true;
    }
    return false;
}

impl G4Parser {
    pub fn new(tokens: List<Token>, chars: List<char>) -> G4Parser {
        return G4Parser {
            tokens,
            chars,
            pos: 0,
            channels: [],
            options: [],
            named_actions: [],
            pending_refs: [],
            current_rule: "",
            kind: GrammarKind::Combined,
        };
    }

    fn peek(&self) -> &Token with stores[self] {
        return &self.tokens[self.pos];
    }

    fn peek_kind(&self) -> i32 {
        return self.tokens[self.pos].kind;
    }

    fn at_eof(&self) -> bool {
        return self.peek_kind() == G4Token::Eof as i32;
    }

    fn advance(&mut self) -> &Token with stores[self] {
        let tok = &self.tokens[self.pos];
        self.pos += 1;
        return tok;
    }

    fn expect(&mut self, kind: G4Token) -> Result<&Token, ParseError> with stores[self] {
        let tok = self.peek();
        if tok.kind == kind as i32 {
            self.pos += 1;
            return Result::<&Token, ParseError>::Ok(tok);
        }
        let expected: List<String> = [kind.name()];
        return Result::<&Token, ParseError>::Err(
            ParseError::new(`expected ${kind.name()}, got "${tok.text}"`, tok.span, expected),
        );
    }

    fn is_kind(&self, kind: G4Token) -> bool {
        return self.peek_kind() == kind as i32;
    }

    pub fn parse_grammar(&mut self) -> Result<Grammar, ParseError> {
        let mut is_lexer_grammar = false;
        let mut is_parser_grammar = false;
        if self.is_kind(G4Token::Identifier) {
            let text = &self.peek().text;
            if LexerSlice::eq_str(&"lexer", text) {
                is_lexer_grammar = true;
                self.advance();
            } else if LexerSlice::eq_str(&"parser", text) {
                is_parser_grammar = true;
                self.advance();
            }
        }
        if is_lexer_grammar {
            self.kind = GrammarKind::Lexer;
        } else if is_parser_grammar {
            self.kind = GrammarKind::Parser;
        } else {
            self.kind = GrammarKind::Combined;
        }

        self.expect(G4Token::Grammar)?;
        let name_tok = self.expect(G4Token::Identifier)?;
        let name = name_tok.text.to_string();
        self.expect(G4Token::Semicolon)?;

        let mut virtual_tokens: List<String> = [];
        self.skip_prequel_blocks(&mut virtual_tokens)?;

        let mut parser_rules: List<ParserRule> = [];
        let mut lexer_rules: List<LexerRule> = [];
        let mut mode_names: List<String> = ["DEFAULT_MODE"];
        let mut current_mode: i32 = DEFAULT_MODE;

        while !self.at_eof() {
            if self.is_kind(G4Token::Identifier) && LexerSlice::eq_str(&"mode", &self.peek().text) {
                if is_parser_grammar {
                    let tok = self.peek();
                    let expected: List<String> = ["rule definition"];
                    return Result::<Grammar, ParseError>::Err(
                        ParseError::new(
                            "mode declaration is only allowed in lexer grammars",
                            tok.span,
                            expected,
                        ),
                    );
                }
                self.advance();
                let mode_name_tok = self.expect(G4Token::Identifier)?;
                current_mode = intern_mode(&mut mode_names, &mode_name_tok.text.to_string());
                self.expect(G4Token::Semicolon)?;
                continue;
            }

            let mut is_frag = false;
            let mut visibility = Visibility::Default;
            loop {
                if self.is_kind(G4Token::Fragment) {
                    is_frag = true;
                    self.advance();
                    continue;
                }
                if self.is_kind(G4Token::Identifier) {
                    let text = &self.peek().text;
                    if LexerSlice::eq_str(&"public", text) {
                        visibility = Visibility::Public;
                        self.advance();
                        continue;
                    }
                    if LexerSlice::eq_str(&"private", text) {
                        visibility = Visibility::Private;
                        self.advance();
                        continue;
                    }
                    if LexerSlice::eq_str(&"protected", text) {
                        visibility = Visibility::Protected;
                        self.advance();
                        continue;
                    }
                }
                break;
            }

            let rule_name_tok = self.expect(G4Token::Identifier)?;
            let rule_name = rule_name_tok.text.to_string();
            let rule_name_span = rule_name_tok.span;

            if is_lexer_grammar || is_frag || is_lexer_rule_name(&rule_name) {
                for let existing of &lexer_rules {
                    if existing.name == rule_name {
                        return Result::<Grammar, ParseError>::Err(
                            ParseError::new(
                                `duplicate rule "${rule_name}"`,
                                rule_name_span,
                                ["unique rule name"],
                            ),
                        );
                    }
                }
                let mut rule = self.parse_lexer_rule(rule_name, is_frag, current_mode, &mut mode_names)?;
                rule.visibility = visibility;
                let _ = self.parse_exception_group();
                lexer_rules.push(rule);
            } else {
                for let existing of &parser_rules {
                    if existing.name == rule_name {
                        return Result::<Grammar, ParseError>::Err(
                            ParseError::new(
                                `duplicate rule "${rule_name}"`,
                                rule_name_span,
                                ["unique rule name"],
                            ),
                        );
                    }
                }
                let mut rule = self.parse_parser_rule(rule_name)?;
                rule.visibility = visibility;
                let exc = self.parse_exception_group();
                rule.catches = exc.catches;
                rule.finally_action = exc.finally_action;
                parser_rules.push(rule);
            }
        }

        for let vt of virtual_tokens {
            let mut found = false;
            for let rule of &lexer_rules {
                if rule.name == vt {
                    found = true;
                }
            }
            if !found {
                lexer_rules.push(LexerRule::virtual_token(vt));
            }
        }


        let channels = self.channels;
        let options = self.options;
        let named_actions = self.named_actions;
        let pending_refs = self.pending_refs;
        let kind = self.kind;
        let source_files: List<String> = [];
        let action_language = action_language_from_options(&options);
        return Result::<Grammar, ParseError>::Ok(
            Grammar {
                name,
                kind,
                parser_rules,
                lexer_rules,
                mode_names,
                channels,
                options,
                named_actions,
                action_language,
                pending_refs,
                source_files,
            },
        );
    }

    fn skip_prequel_blocks(&mut self, virtual_tokens: &mut List<String>) -> Result<(), ParseError> {
        loop {
            if self.is_kind(G4Token::Identifier) {
                let text = &self.peek().text;
                if LexerSlice::eq_str(&"tokens", text) {
                    self.advance();
                    self.parse_tokens_block(virtual_tokens)?;
                    continue;
                }
                if LexerSlice::eq_str(&"channels", text) {
                    self.advance();
                    self.parse_channels_block()?;
                    continue;
                }
                if LexerSlice::eq_str(&"options", text) {
                    self.advance();
                    let opts = self.parse_options_block();
                    for let o of opts {
                        self.options.push(o);
                    }
                    continue;
                }
                if LexerSlice::eq_str(&"import", text) {
                    self.advance();
                    self.parse_delegate_grammars();
                    continue;
                }
            }
            if self.is_kind(G4Token::At) {
                let act = self.parse_named_action();
                self.named_actions.push(act);
                continue;
            }
            break;
        }
        return Result::<(), ParseError>::Ok(());
    }

    fn parse_id_list_block(&mut self, kw: &String) -> Result<List<String>, ParseError> {
        let mut names: List<String> = [];
        if !self.is_kind(G4Token::LBrace) {
            let tok = self.peek();
            let mut msg = String::with_capacity(24);
            msg.push_str(&"expected `{` after `");
            msg.push_str(kw);
            msg.push_str(&"`");
            return Result::<List<String>, ParseError>::Err(
                ParseError::new(msg, tok.span, ["{"]),
            );
        }
        let brace_span = self.peek().span;
        self.advance();
        while !self.at_eof() && !self.is_kind(G4Token::RBrace) {
            if self.is_kind(G4Token::Identifier) {
                names.push(self.peek().text.to_string());
                self.advance();
                if self.is_kind(G4Token::Assign) {
                    self.advance();
                    if self.is_kind(G4Token::IntLit) {
                        self.advance();
                    }
                }
            } else {
                self.advance();
            }
            if self.is_kind(G4Token::Comma) {
                self.advance();
            }
        }
        if !self.is_kind(G4Token::RBrace) {
            let mut msg = String::with_capacity(56);
            msg.push_str(&"unterminated `");
            msg.push_str(kw);
            msg.push_str(&" { ... }` block — expected `}` before end of file");
            return Result::<List<String>, ParseError>::Err(
                ParseError::new(msg, brace_span, ["}"]),
            );
        }
        self.advance();
        return Result::<List<String>, ParseError>::Ok(names);
    }

    fn parse_channels_block(&mut self) -> Result<(), ParseError> {
        let names = self.parse_id_list_block(&"channels")?;
        for let name of names {
            let mut dup = false;
            for let existing of &self.channels {
                if *existing == name {
                    dup = true;
                }
            }
            if !dup {
                self.channels.push(name);
            }
        }
        return Result::<(), ParseError>::Ok(());
    }

    fn parse_delegate_grammars(&mut self) {
        loop {
            if !self.is_kind(G4Token::Identifier) {
                break;
            }
            self.advance();
            if self.is_kind(G4Token::Assign) {
                self.advance();
                if self.is_kind(G4Token::Identifier) {
                    self.advance();
                }
            }
            if self.is_kind(G4Token::Comma) {
                self.advance();
                continue;
            }
            break;
        }
        if self.is_kind(G4Token::Semicolon) {
            self.advance();
        }
    }

    fn parse_options_block(&mut self) -> List<GrammarOption> {
        let mut out: List<GrammarOption> = [];
        if !self.is_kind(G4Token::LBrace) {
            return out;
        }
        self.advance();
        while !self.at_eof() && !self.is_kind(G4Token::RBrace) {
            if !self.is_kind(G4Token::Identifier) {
                self.advance();
                continue;
            }
            let name = self.peek().text.to_string();
            self.advance();
            if !self.is_kind(G4Token::Assign) {
                while !self.at_eof() && !self.is_kind(G4Token::Semicolon) && !self.is_kind(G4Token::RBrace) {
                    self.advance();
                }
                if self.is_kind(G4Token::Semicolon) {
                    self.advance();
                }
                continue;
            }
            self.advance();
            let value = self.parse_option_value();
            out.push(GrammarOption { name, value });
            if self.is_kind(G4Token::Semicolon) {
                self.advance();
            }
        }
        if self.is_kind(G4Token::RBrace) {
            self.advance();
        }
        return out;
    }

    fn parse_option_value(&mut self) -> OptionValue {
        if self.is_kind(G4Token::StringLit) {
            let body = self.peek().text.to_string();
            self.advance();
            return OptionValue::Str(body);
        }
        if self.is_kind(G4Token::IntLit) {
            let text = self.peek().text.to_string();
            self.advance();
            return OptionValue::Int(parse_int_literal(&text) as i64);
        }
        if self.is_kind(G4Token::LBrace) {
            let body = self.extract_action('{', '}');
            return OptionValue::Action(body);
        }
        if self.is_kind(G4Token::Identifier) {
            let head = self.peek().text.to_string();
            self.advance();
            if !(self.is_kind(G4Token::Dot) && self.peek_kind_at(1) == G4Token::Identifier as i32) {
                return OptionValue::Ident(head);
            }
            let mut parts: List<String> = [head];
            while self.is_kind(G4Token::Dot) && self.peek_kind_at(1) == G4Token::Identifier as i32 {
                self.advance();
                parts.push(self.peek().text.to_string());
                self.advance();
            }
            return OptionValue::Qualified(parts);
        }
        return OptionValue::Ident("");
    }

    fn parse_named_action(&mut self) -> NamedAction {
        self.expect(G4Token::At).unwrap();
        let mut scope: Option<String> = null;
        let mut name = String::with_capacity(8);
        if self.is_kind(G4Token::Identifier) {
            name = self.peek().text.to_string();
            self.advance();
        }
        if self.is_kind(G4Token::ColonColon) {
            self.advance();
            scope = Option::<String>::Some(name);
            name = String::with_capacity(8);
            if self.is_kind(G4Token::Identifier) {
                name = self.peek().text.to_string();
                self.advance();
            }
        }
        let mut body = ActionSource {};
        if self.is_kind(G4Token::LBrace) {
            body = self.extract_action('{', '}');
        }
        return NamedAction { scope, name, body };
    }

    fn parse_tokens_block(&mut self, virtual_tokens: &mut List<String>) -> Result<(), ParseError> {
        let names = self.parse_id_list_block(&"tokens")?;
        for let name of names {
            virtual_tokens.push(name);
        }
        return Result::<(), ParseError>::Ok(());
    }

    fn extract_action(&mut self, open: char, close: char) -> ActionSource {
        let tok = self.peek();
        let start = tok.span.start;
        let end = scan_balanced_or_end(&self.chars, start, open, close);
        self.advance();
        while !self.at_eof() && self.tokens[self.pos].span.start < end {
            self.pos += 1;
        }
        let body_start = start + 1;
        let body_end = if end > start + 1 { end - 1 } else { start + 1 };
        let mut body = String::with_capacity(body_end - body_start);
        let mut i = body_start;
        while i < body_end {
            body.push(self.chars[i]);
            i += 1;
        }
        return ActionSource {
            text: body,
            span: Span { start, end },
            action_id: -1,
        };
    }

    fn skip_angle_block(&mut self) {
        self.expect(G4Token::LAngle).unwrap();
        let mut depth = 1;
        while !self.at_eof() && depth > 0 {
            if self.is_kind(G4Token::LAngle) {
                depth += 1;
            } else if self.is_kind(G4Token::RAngle) {
                depth -= 1;
            }
            self.advance();
        }
    }

    fn parse_angle_options(&mut self) -> Result<List<GrammarOption>, ParseError> {
        let mut out: List<GrammarOption> = [];
        if !self.is_kind(G4Token::LAngle) {
            return Result::<List<GrammarOption>, ParseError>::Ok(out);
        }
        self.advance();
        let mut depth = 1;
        while !self.at_eof() && depth > 0 {
            if self.is_kind(G4Token::RAngle) {
                depth -= 1;
                self.advance();
                continue;
            }
            if self.is_kind(G4Token::LAngle) {
                depth += 1;
                self.advance();
                continue;
            }
            if !self.is_kind(G4Token::Identifier) {
                self.advance();
                continue;
            }
            let name_tok = self.peek();
            let name = name_tok.text.to_string();
            self.advance();
            if !self.is_kind(G4Token::Assign) {
                while !self.at_eof() && !self.is_kind(G4Token::Comma) && !self.is_kind(G4Token::RAngle) {
                    self.advance();
                }
                if self.is_kind(G4Token::Comma) {
                    self.advance();
                }
                continue;
            }
            self.advance();
            let value_span = self.peek().span;
            let value = self.parse_option_value();
            if name == "assoc" {
                let mut valid = false;
                if let Ident(v) = &value {
                    if *v == "left" || *v == "right" {
                        valid = true;
                    }
                }
                if !valid {
                    return Result::<List<GrammarOption>, ParseError>::Err(
                        ParseError::new(
                            `invalid <assoc=...> value: only "left" or "right" are accepted`,
                            value_span,
                            ["left", "right"],
                        ),
                    );
                }
            }
            out.push(GrammarOption { name, value });
            if self.is_kind(G4Token::Comma) {
                self.advance();
            }
        }
        return Result::<List<GrammarOption>, ParseError>::Ok(out);
    }

    fn parse_parser_rule(&mut self, name: String) -> Result<ParserRule, ParseError> {
        let prequel = self.parse_rule_prequel();
        self.expect(G4Token::Colon)?;
        self.current_rule = name;
        let alternatives = self.parse_alternatives()?;
        self.current_rule = "";
        self.expect(G4Token::Semicolon)?;
        let mut rule = ParserRule::new(name, Visibility::Default, prequel.options, alternatives);
        rule.args = prequel.args;
        rule.returns_decls = prequel.returns_decls;
        rule.locals_decls = prequel.locals_decls;
        rule.throws = prequel.throws;
        rule.init_action = prequel.init_action;
        rule.after_action = prequel.after_action;
        return Result::<ParserRule, ParseError>::Ok(rule);
    }

    fn parse_rule_prequel(&mut self) -> RulePrequel {
        let mut p = RulePrequel {};
        loop {
            if self.is_kind(G4Token::CharClass) {
                let act = self.extract_action('[', ']');
                for let d of parse_attr_decls(&act.text, act.span) {
                    p.args.push(d);
                }
                continue;
            }
            if self.is_kind(G4Token::Identifier) {
                let text = &self.peek().text;
                let is_returns = LexerSlice::eq_str(&"returns", text);
                let is_locals = LexerSlice::eq_str(&"locals", text);
                if is_returns || is_locals {
                    self.advance();
                    if self.is_kind(G4Token::CharClass) {
                        let act = self.extract_action('[', ']');
                        for let d of parse_attr_decls(&act.text, act.span) {
                            if is_returns {
                                p.returns_decls.push(d);
                            } else {
                                p.locals_decls.push(d);
                            }
                        }
                    }
                    continue;
                }
                if LexerSlice::eq_str(&"throws", text) {
                    self.advance();
                    for let q of self.parse_qualified_id_list() {
                        p.throws.push(q);
                    }
                    continue;
                }
                if LexerSlice::eq_str(&"options", text) {
                    self.advance();
                    let opts = self.parse_options_block();
                    for let o of opts {
                        p.options.push(o);
                    }
                    continue;
                }
            }
            if self.is_kind(G4Token::At) {
                let act = self.parse_named_action();
                if act.name == "init" {
                    p.init_action = Option::<ActionSource>::Some(act.body);
                } else if act.name == "after" {
                    p.after_action = Option::<ActionSource>::Some(act.body);
                }
                continue;
            }
            break;
        }
        return p;
    }

    fn parse_qualified_id_list(&mut self) -> List<String> {
        let mut out: List<String> = [];
        loop {
            if !self.is_kind(G4Token::Identifier) {
                break;
            }
            let mut qid = self.peek().text.to_string();
            self.advance();
            while self.is_kind(G4Token::Dot) && self.peek_kind_at(1) == G4Token::Identifier as i32 {
                self.advance();
                qid.push('.');
                qid.push_str(&self.peek().text.to_string());
                self.advance();
            }
            out.push(qid);
            if self.is_kind(G4Token::Comma) {
                self.advance();
                continue;
            }
            break;
        }
        return out;
    }

    fn parse_exception_group(&mut self) -> ExceptionGroup {
        let mut g = ExceptionGroup {};
        loop {
            if !self.is_kind(G4Token::Identifier) {
                break;
            }
            let text = &self.peek().text;
            if LexerSlice::eq_str(&"catch", text) {
                self.advance();
                let mut decl_text = "";
                if self.is_kind(G4Token::CharClass) {
                    decl_text = self.extract_action('[', ']').text;
                }
                let mut body = ActionSource {};
                if self.is_kind(G4Token::LBrace) {
                    body = self.extract_action('{', '}');
                }
                g.catches.push(CatchClause { decl_text, body });
                continue;
            }
            if LexerSlice::eq_str(&"finally", text) {
                self.advance();
                if self.is_kind(G4Token::LBrace) {
                    g.finally_action = Option::<ActionSource>::Some(self.extract_action('{', '}'));
                }
                break;
            }
            break;
        }
        return g;
    }

    fn parse_alternatives(&mut self) -> Result<List<Alternative>, ParseError> {
        let mut alts: List<Alternative> = [];
        let first = self.parse_alternative()?;
        alts.push(first);

        while self.is_kind(G4Token::Pipe) {
            self.advance();
            let alt = self.parse_alternative()?;
            alts.push(alt);
        }
        return Result::<List<Alternative>, ParseError>::Ok(alts);
    }

    fn capture_alt_action(&mut self, before_index: i32) -> AltAction {
        let source = self.extract_action('{', '}');
        let mut kind = ActionKind::Action;
        if self.is_kind(G4Token::Question) {
            kind = ActionKind::Predicate;
            self.advance();
        }
        return AltAction { kind, source, before_index };
    }

    fn parse_alternative(&mut self) -> Result<Alternative, ParseError> {
        let mut elements: List<Element> = [];
        let mut options: List<GrammarOption> = [];
        let mut actions: List<AltAction> = [];
        let mut label: Option<String> = null;

        loop {
            if self.at_eof()
                || self.is_kind(G4Token::Pipe)
                || self.is_kind(G4Token::Semicolon)
                || self.is_kind(G4Token::RParen)
                || self.is_kind(G4Token::Hash) {
                break;
            }
            if self.is_kind(G4Token::LBrace) {
                actions.push(self.capture_alt_action(elements.len()));
                if self.is_kind(G4Token::LAngle) {
                    let opts = self.parse_angle_options()?;
                    for let o of opts {
                        options.push(o);
                    }
                }
                continue;
            }
            if self.is_kind(G4Token::LAngle) && elements.is_empty() {
                let mut opts = self.parse_angle_options()?;
                for let o of opts {
                    options.push(o);
                }
                continue;
            }
            let elem = self.parse_element()?;
            elements.push(elem);
        }

        if self.is_kind(G4Token::Hash) {
            self.advance();
            let label_tok = self.expect(G4Token::Identifier)?;
            label = Option::<String>::Some(label_tok.text.to_string());
        }

        return Result::<Alternative, ParseError>::Ok(Alternative { label, options, elements, actions });
    }

    fn parse_element(&mut self) -> Result<Element, ParseError> {
        let mut elem = self.parse_atom()?;
        elem = self.parse_postfix(elem)?;
        return Result::<Element, ParseError>::Ok(elem);
    }

    fn parse_atom(&mut self) -> Result<Element, ParseError> {
        if self.is_kind(G4Token::Identifier) {
            let tok = self.advance();
            let name = tok.text.to_string();
            let name_span = tok.span;
            if self.is_kind(G4Token::Assign) || self.is_kind(G4Token::PlusAssign) {
                let list = self.is_kind(G4Token::PlusAssign);
                self.advance();
                let inner = self.parse_atom()?;
                return Result::<Element, ParseError>::Ok(
                    Element::Label(LabelElement::new(name, list, inner)),
                );
            }
            let mut arg_action: Option<ActionSource> = null;
            if self.is_kind(G4Token::CharClass) {
                arg_action = Option::<ActionSource>::Some(self.extract_action('[', ']'));
            }
            let mut options: List<GrammarOption> = [];
            if self.is_kind(G4Token::LAngle) {
                options = self.parse_angle_options()?;
            }
            if is_lexer_rule_name(&name) {
                self.pending_refs.push(PendingRef {
                    kind: RefKind::TokenRef,
                    containing_rule: self.current_rule,
                    referenced_name: name,
                    span: name_span,
                });
                return Result::<Element, ParseError>::Ok(
                    Element::TokenRef(TokenRefElement::with_options(name, options)),
                );
            }
            self.pending_refs.push(PendingRef {
                kind: RefKind::ParserRuleRef,
                containing_rule: self.current_rule,
                referenced_name: name,
                span: name_span,
            });
            let mut rr = RuleRefElement::with_options(name, options);
            rr.arg_action = arg_action;
            return Result::<Element, ParseError>::Ok(Element::RuleRef(rr));
        }
        if self.is_kind(G4Token::StringLit) {
            let tok = self.advance();
            let text = tok.text.to_string();
            let mut options: List<GrammarOption> = [];
            if self.is_kind(G4Token::LAngle) {
                options = self.parse_angle_options()?;
            }
            return Result::<Element, ParseError>::Ok(
                Element::Literal(LiteralElement { text, options }),
            );
        }
        if self.is_kind(G4Token::LParen) {
            self.advance();
            let options = self.parse_block_prequel();
            let alternatives = self.parse_alternatives()?;
            self.expect(G4Token::RParen)?;
            return Result::<Element, ParseError>::Ok(
                Element::Group(GroupElement { alternatives, options }),
            );
        }
        if self.is_kind(G4Token::Dot) {
            self.advance();
            let mut options: List<GrammarOption> = [];
            if self.is_kind(G4Token::LAngle) {
                options = self.parse_angle_options()?;
            }
            return Result::<Element, ParseError>::Ok(
                Element::Wildcard(WildcardElement { options }),
            );
        }
        if self.is_kind(G4Token::Tilde) {
            let tilde_tok = self.peek();
            let tilde_span = tilde_tok.span;
            self.advance();
            let inner = self.parse_atom()?;
            if !is_valid_not_set_element(&inner) {
                return Result::<Element, ParseError>::Err(
                    ParseError::new(
                        `\`~\` must be applied to a token reference, string literal, or parenthesised set — not a rule reference or wildcard`,
                        tilde_span,
                        ["TOKEN_REF", "STRING_LITERAL", "(set)"],
                    ),
                );
            }
            return Result::<Element, ParseError>::Ok(
                Element::Not(NotElement { element: inner }),
            );
        }
        let tok = self.peek();
        let expected: List<String> = ["identifier", "string", "(", ".", "~"];
        return Result::<Element, ParseError>::Err(
            ParseError::new(`unexpected token "${tok.text}"`, tok.span, expected),
        );
    }

    fn parse_block_prequel(&mut self) -> List<GrammarOption> {
        let mut options: List<GrammarOption> = [];
        let mut consumed = false;
        loop {
            if self.is_kind(G4Token::Identifier) && LexerSlice::eq_str(&"options", &self.peek().text) {
                self.advance();
                let opts = self.parse_options_block();
                for let o of opts {
                    options.push(o);
                }
                consumed = true;
                continue;
            }
            if self.is_kind(G4Token::At) {
                self.parse_named_action();
                consumed = true;
                continue;
            }
            break;
        }
        if consumed && self.is_kind(G4Token::Colon) {
            self.advance();
        }
        return options;
    }

    fn parse_repeat_op(&mut self) -> Option<[RepeatKind, bool]> {
        let kind = if self.is_kind(G4Token::Star) {
            RepeatKind::Star;
        } else if self.is_kind(G4Token::Plus) {
            RepeatKind::Plus;
        } else if self.is_kind(G4Token::Question) {
            RepeatKind::Optional;
        } else {
            return null;
        };
        self.advance();
        let non_greedy = if self.is_kind(G4Token::Question) {
            self.advance();
            true;
        } else {
            false;
        };
        return Option::<[RepeatKind, bool]>::Some([kind, non_greedy]);
    }

    fn parse_postfix(&mut self, elem: Element) -> Result<Element, ParseError> {
        return match self.parse_repeat_op() {
            Some(rep) => Result::<Element, ParseError>::Ok(
                Element::Repeat(RepeatElement { kind: rep.0, element: elem, non_greedy: rep.1 }),
            ),
            None => Result::<Element, ParseError>::Ok(elem),
        };
    }

    fn parse_lexer_rule(
        &mut self,
        name: String,
        is_fragment: bool,
        mode: i32,
        mode_names: &mut List<String>,
    ) -> Result<LexerRule, ParseError> {
        let options = self.parse_rule_prequel().options;
        self.expect(G4Token::Colon)?;
        self.current_rule = name;
        let body = self.parse_lexer_alternatives()?;
        self.current_rule = "";

        let mut actions = LexerCommands::empty();
        if self.is_kind(G4Token::Arrow) {
            self.advance();
            self.parse_lexer_actions(&mut actions, mode_names)?;
        }

        self.expect(G4Token::Semicolon)?;
        return Result::<LexerRule, ParseError>::Ok(
            LexerRule {
                name,
                visibility: Visibility::Default,
                is_fragment,
                skip: actions.skip,
                more: actions.more,
                type_override: actions.type_override,
                channel: actions.channel,
                mode,
                set_mode: actions.set_mode,
                push_mode: actions.push_mode,
                pop_mode: actions.pop_mode,
                is_virtual: false,
                options,
                body,
            },
        );
    }

    fn parse_lexer_actions(
        &mut self,
        actions: &mut LexerCommands,
        mode_names: &mut List<String>,
    ) -> Result<(), ParseError> {
        loop {
            let action_tok = self.advance();
            let action_span = action_tok.span;
            let action_name = action_tok.text.to_string();
            match action_name {
                "skip" => {
                    actions.skip = true;
                },
                "pushMode" => {
                    self.expect(G4Token::LParen)?;
                    let mode_name = self.advance();
                    self.expect(G4Token::RParen)?;
                    actions.push_mode = intern_mode(mode_names, &mode_name.text.to_string());
                },
                "popMode" => {
                    actions.pop_mode = true;
                },
                "mode" => {
                    self.expect(G4Token::LParen)?;
                    let mode_name = self.advance();
                    self.expect(G4Token::RParen)?;
                    actions.set_mode = intern_mode(mode_names, &mode_name.text.to_string());
                },
                "channel" => {
                    self.expect(G4Token::LParen)?;
                    let arg = self.advance();
                    self.expect(G4Token::RParen)?;
                    if LexerSlice::eq_str(&"DEFAULT_TOKEN_CHANNEL", &arg.text) {
                        actions.channel = DEFAULT_CHANNEL;
                    } else if LexerSlice::eq_str(&"HIDDEN", &arg.text) {
                        actions.channel = HIDDEN_CHANNEL;
                    } else if arg.kind == G4Token::IntLit as i32 {
                        actions.channel = parse_int_literal(&arg.text.to_string());
                    } else {
                        let name = arg.text.to_string();
                        let mut resolved = -1;
                        for let mut i = 0; i < self.channels.len(); i += 1 {
                            if self.channels[i] == name {
                                resolved = i + 2;
                            }
                        }
                        if resolved < 0 {
                            let expected: List<String> = ["a channel declared in `channels { }`"];
                            return Result::<(), ParseError>::Err(
                                ParseError::new(
                                    `channel "${name}" is not declared in a \`channels \{ ... \}\` block`,
                                    arg.span,
                                    expected,
                                ),
                            );
                        }
                        actions.channel = resolved;
                    }
                },
                "type" => {
                    self.expect(G4Token::LParen)?;
                    let target = self.advance();
                    self.expect(G4Token::RParen)?;
                    actions.type_override = Option::<String>::Some(target.text.to_string());
                },
                "more" => {
                    actions.more = true;
                },
                _ => {
                    return Result::<(), ParseError>::Err(
                        ParseError::new(
                            `unknown lexer command "${action_name}" — expected one of: skip, more, channel, type, pushMode, popMode, mode`,
                            action_span,
                            ["skip", "more", "channel", "type", "pushMode", "popMode", "mode"],
                        ),
                    );
                },
            }
            if !self.is_kind(G4Token::Comma) {
                break;
            }
            self.advance();
        }
        return Result::<(), ParseError>::Ok(());
    }

    fn parse_lexer_alternatives(&mut self) -> Result<List<LexerAlternative>, ParseError> {
        let mut alts: List<LexerAlternative> = [];
        let first = self.parse_lexer_alt()?;
        alts.push(first);

        while self.is_kind(G4Token::Pipe) {
            self.advance();
            let alt = self.parse_lexer_alt()?;
            alts.push(alt);
        }
        return Result::<List<LexerAlternative>, ParseError>::Ok(alts);
    }

    fn parse_lexer_alt(&mut self) -> Result<LexerAlternative, ParseError> {
        let mut elements: List<LexerElement> = [];
        let mut actions: List<AltAction> = [];
        loop {
            if self.at_eof()
                || self.is_kind(G4Token::Pipe)
                || self.is_kind(G4Token::Semicolon)
                || self.is_kind(G4Token::RParen)
                || self.is_kind(G4Token::Arrow) {
                break;
            }
            if self.is_kind(G4Token::LBrace) {
                actions.push(self.capture_alt_action(elements.len()));
                continue;
            }
            if self.is_kind(G4Token::LAngle) {
                self.skip_angle_block();
                continue;
            }
            let elem = self.parse_lexer_element()?;
            elements.push(elem);
        }
        return Result::<LexerAlternative, ParseError>::Ok(LexerAlternative { elements, actions });
    }

    fn parse_lexer_element(&mut self) -> Result<LexerElement, ParseError> {
        let mut elem = self.parse_lexer_atom()?;
        elem = self.parse_lexer_postfix(elem)?;
        return Result::<LexerElement, ParseError>::Ok(elem);
    }

    fn peek_kind_at(&self, offset: i32) -> i32 {
        let i = self.pos + offset;
        if i >= self.tokens.len() {
            return G4Token::Eof as i32;
        }
        return self.tokens[i].kind;
    }

    fn parse_lexer_atom(&mut self) -> Result<LexerElement, ParseError> {
        if self.is_kind(G4Token::StringLit) {
            let tok = self.advance();
            let text = tok.text.to_string();
            let is_dot_dot = self.is_kind(G4Token::Dot) && self.peek_kind_at(1) == G4Token::Dot as i32;
            if is_dot_dot && text.chars().count() == 1 {
                self.advance();
                self.advance();
                let end_tok = self.expect(G4Token::StringLit)?;
                let end_text = end_tok.text.to_string();
                if end_text.chars().count() != 1 {
                    let expected: List<String> = ["single-char string literal"];
                    return Result::<LexerElement, ParseError>::Err(
                        ParseError::new(
                            "range endpoint must be a single character",
                            end_tok.span,
                            expected,
                        ),
                    );
                }
                let start_char = first_char(&text).unwrap();
                let end_char = first_char(&end_text).unwrap();
                return Result::<LexerElement, ParseError>::Ok(
                    LexerElement::CharRange([start_char, end_char]),
                );
            }
            return Result::<LexerElement, ParseError>::Ok(LexerElement::Literal(text));
        }
        if self.is_kind(G4Token::CharClass) {
            let tok = self.advance();
            let cc = parse_char_class(&tok.text.to_string())?;
            return Result::<LexerElement, ParseError>::Ok(LexerElement::CharClass(cc));
        }
        if self.is_kind(G4Token::Dot) {
            self.advance();
            if self.is_kind(G4Token::Dot) {
                let tok = self.peek();
                let expected: List<String> = ["element"];
                return Result::<LexerElement, ParseError>::Err(
                    ParseError::new("unexpected '..' without preceding char literal", tok.span, expected),
                );
            }
            return Result::<LexerElement, ParseError>::Ok(LexerElement::AnyChar);
        }
        if self.is_kind(G4Token::Identifier) {
            let tok = self.advance();
            let name = tok.text.to_string();
            let span = tok.span;
            self.pending_refs.push(PendingRef {
                kind: RefKind::LexerRuleRef,
                containing_rule: self.current_rule,
                referenced_name: name,
                span,
            });
            return Result::<LexerElement, ParseError>::Ok(LexerElement::RuleRef(name));
        }
        if self.is_kind(G4Token::LParen) {
            self.advance();
            let alts = self.parse_lexer_alternatives()?;
            self.expect(G4Token::RParen)?;
            return Result::<LexerElement, ParseError>::Ok(LexerElement::Group(alts));
        }
        if self.is_kind(G4Token::Tilde) {
            let tilde_span = self.peek().span;
            self.advance();
            let inner = self.parse_lexer_atom()?;
            if !is_valid_lexer_not_element(&inner) {
                let expected: List<String> = ["single char, char set, or block of them"];
                return Result::<LexerElement, ParseError>::Err(
                    ParseError::new(
                        "`~` in a lexer rule must be applied to a single character, a char set, or a parenthesised set — not a rule reference, wildcard, or multi-char literal",
                        tilde_span,
                        expected,
                    ),
                );
            }
            return Result::<LexerElement, ParseError>::Ok(
                LexerElement::Not(LexerNotElement { element: inner }),
            );
        }
        let tok = self.peek();
        let expected: List<String> = ["string", "char-class", "identifier", "(", "~", "."];
        return Result::<LexerElement, ParseError>::Err(
            ParseError::new(`unexpected token "${tok.text}" in lexer rule`, tok.span, expected),
        );
    }

    fn parse_lexer_postfix(&mut self, elem: LexerElement) -> Result<LexerElement, ParseError> {
        return match self.parse_repeat_op() {
            Some(rep) => Result::<LexerElement, ParseError>::Ok(
                LexerElement::Repeat(LexerRepeatElement { kind: rep.0, element: elem, non_greedy: rep.1 }),
            ),
            None => Result::<LexerElement, ParseError>::Ok(elem),
        };
    }
}

fn advance_char(chars: &List<char>, pos: &mut i32) -> char {
    let c = chars[*pos];
    *pos += 1;
    return c;
}

fn resolve_char(chars: &List<char>, pos: &mut i32) -> char {
    let c = advance_char(chars, pos);
    if c != '\\' {
        return c;
    }
    let ec = advance_char(chars, pos);
    return match ec {
        'n' => '\n',
        'r' => '\r',
        't' => '\t',
        'b' => '\u0008',
        'f' => '\u000C',
        '\\' => '\\',
        ']' => ']',
        '-' => '-',
        'u' => resolve_unicode_escape(chars, pos),
        _ => ec,
    };
}

fn parse_char_class(text: &String) -> Result<CharClass, ParseError> {
    let chars = text.chars().collect();
    let end = chars.len() - 1;
    let mut pos = 1;
    let mut negated = false;
    let mut ranges: List<CharRange> = [];

    if pos < end && chars[pos] == '^' {
        negated = true;
        pos += 1;
    }

    while pos < end {
        if pos + 2 < end && chars[pos] == '\\' && chars[pos + 1] == 'p' && chars[pos + 2] == '{' {
            pos += 3;
            let mut prop = String::with_capacity(16);
            while pos < end && chars[pos] != '}' {
                prop.push(chars[pos]);
                pos += 1;
            }
            if pos < end {
                pos += 1;
            }
            expand_unicode_property(&prop, &mut ranges);
            continue;
        }

        let c = resolve_char(&chars, &mut pos);
        if pos < end && chars[pos] == '-' && pos + 1 < end {
            advance_char(&chars, &mut pos);
            let c2 = resolve_char(&chars, &mut pos);
            ranges.push(CharRange::range(c, c2));
        } else {
            ranges.push(CharRange::single(c));
        }
    }

    return Result::<CharClass, ParseError>::Ok(CharClass { ranges, negated });
}

fn expand_unicode_property(name: &String, ranges: &mut List<CharRange>) {
    match *name {
        "L" | "Letter" => {
            ranges.push(CharRange::range('A', 'Z'));
            ranges.push(CharRange::range('a', 'z'));
            ranges.push(CharRange::range('\u00C0', '\u00D6'));
            ranges.push(CharRange::range('\u00D8', '\u00F6'));
            ranges.push(CharRange::range('\u00F8', '\u00FF'));
            ranges.push(CharRange::range('\u0100', '\u024F'));
            ranges.push(CharRange::range('\u0370', '\u03FF'));
            ranges.push(CharRange::range('\u0400', '\u04FF'));
            ranges.push(CharRange::range('\u0600', '\u06FF'));
            ranges.push(CharRange::range('\u0900', '\u097F'));
            ranges.push(CharRange::range('\u4E00', '\u9FFF'));
            ranges.push(CharRange::range('\u3040', '\u309F'));
            ranges.push(CharRange::range('\u30A0', '\u30FF'));
            ranges.push(CharRange::range('\uAC00', '\uD7AF'));
        },
        "Nl" | "Letter_Number" => {
            ranges.push(CharRange::range('\u2160', '\u2188'));
            ranges.push(CharRange::range('\u16EE', '\u16F0'));
        },
        "Mn" | "Nonspacing_Mark" => {
            ranges.push(CharRange::range('\u0300', '\u036F'));
            ranges.push(CharRange::range('\u1AB0', '\u1AFF'));
            ranges.push(CharRange::range('\u0901', '\u0902'));
            ranges.push(CharRange::single('\u093C'));
            ranges.push(CharRange::range('\u0941', '\u0948'));
            ranges.push(CharRange::single('\u094D'));
        },
        "Mc" | "Spacing_Mark" => {
            ranges.push(CharRange::single('\u0903'));
            ranges.push(CharRange::range('\u093E', '\u0940'));
            ranges.push(CharRange::range('\u0949', '\u094C'));
        },
        "Nd" | "Decimal_Number" => {
            ranges.push(CharRange::range('0', '9'));
            ranges.push(CharRange::range('\u0660', '\u0669'));
            ranges.push(CharRange::range('\u06F0', '\u06F9'));
            ranges.push(CharRange::range('\u0966', '\u096F'));
        },
        "Pc" | "Connector_Punctuation" => {
            ranges.push(CharRange::single('_'));
            ranges.push(CharRange::range('\u203F', '\u2040'));
            ranges.push(CharRange::single('\u2054'));
            ranges.push(CharRange::range('\uFE33', '\uFE34'));
            ranges.push(CharRange::range('\uFE4D', '\uFE4F'));
            ranges.push(CharRange::single('\uFF3F'));
        },
        "Zs" | "Space_Separator" => {
            ranges.push(CharRange::single(' '));
            ranges.push(CharRange::single('\u00A0'));
            ranges.push(CharRange::single('\u1680'));
            ranges.push(CharRange::range('\u2000', '\u200A'));
            ranges.push(CharRange::single('\u202F'));
            ranges.push(CharRange::single('\u205F'));
            ranges.push(CharRange::single('\u3000'));
        },
        _ => {
        },
    }
}

fn intern_mode(mode_names: &mut List<String>, name: &String) -> i32 {
    for let mut i = 0; i < mode_names.len(); i += 1 {
        if mode_names[i] == *name {
            return i;
        }
    }
    mode_names.push(*name);
    return mode_names.len() - 1;
}

fn action_language_from_options(options: &List<GrammarOption>) -> ActionLanguage {
    for let opt of options {
        if opt.name == "language" {
            let name = match &opt.value {
                Ident(v) => Option::<String>::Some(*v),
                Str(v) => Option::<String>::Some(*v),
                Qualified(_) => null,
                Int(_) => null,
                Action(_) => null,
            };
            if let Some(v) = name {
                if v.eq_ignore_ascii_case("java") {
                    return ActionLanguage::Java;
                }
                if v.eq_ignore_ascii_case("wado") {
                    return ActionLanguage::Wado;
                }
                return ActionLanguage::Other(v);
            }
        }
    }
    return ActionLanguage::Java;
}

struct ExceptionGroup {
    catches: List<CatchClause> = [],
    finally_action: Option<ActionSource> = null,
}

struct RulePrequel {
    options: List<GrammarOption> = [],
    args: List<AttrDecl> = [],
    returns_decls: List<AttrDecl> = [],
    locals_decls: List<AttrDecl> = [],
    throws: List<String> = [],
    init_action: Option<ActionSource> = null,
    after_action: Option<ActionSource> = null,
}

fn parse_attr_decls(body: &String, list_span: Span) -> List<AttrDecl> {
    let chars: List<char> = body.chars().collect();
    let n = chars.len();
    let mut out: List<AttrDecl> = [];
    let mut depth = 0;
    let mut seg = String::with_capacity(16);
    let mut i = 0;
    while i <= n {
        let c = if i == n { ',' } else { chars[i] };
        match c {
            '<' | '[' | '(' => {
                depth += 1;
                seg.push(c);
            },
            '>' | ']' | ')' => {
                if depth > 0 {
                    depth -= 1;
                }
                seg.push(c);
            },
            ',' && depth == 0 => {
                if let Some(d) = split_attr_decl(&seg, list_span) {
                    out.push(d);
                }
                seg = String::with_capacity(16);
            },
            _ => seg.push(c),
        }
        i += 1;
    }
    return out;
}

fn split_attr_decl(seg: &String, span: Span) -> Option<AttrDecl> {
    let chars: List<char> = seg.chars().collect();
    let full = chars.len();
    let mut n = full;
    for let mut k = 0; k < full; k += 1 {
        if chars[k] == '=' {
            let prev_cmp = k > 0
                && (chars[k - 1] == '!' || chars[k - 1] == '<' || chars[k - 1] == '>' || chars[k - 1] == '=');
            let next_eq = k + 1 < full && chars[k + 1] == '=';
            if !prev_cmp && !next_eq {
                n = k;
                break;
            }
        }
    }
    let mut end = n;
    while end > 0 && chars[end - 1].is_ascii_whitespace() {
        end -= 1;
    }
    if end == 0 {
        return null;
    }
    let mut name_start = end;
    while name_start > 0 && is_id_continue_char(chars[name_start - 1]) {
        name_start -= 1;
    }
    let mut name = String::with_capacity(end - name_start);
    for let mut k = name_start; k < end; k += 1 {
        name.push(chars[k]);
    }
    let mut type_end = name_start;
    while type_end > 0 && chars[type_end - 1].is_ascii_whitespace() {
        type_end -= 1;
    }
    let mut type_text = String::with_capacity(type_end);
    let mut ts = 0;
    while ts < type_end && chars[ts].is_ascii_whitespace() {
        ts += 1;
    }
    for let mut k = ts; k < type_end; k += 1 {
        type_text.push(chars[k]);
    }
    return Option::<AttrDecl>::Some(AttrDecl { type_text, name, span });
}

fn scan_balanced_or_end(chars: &List<char>, start: i32, open: char, close: char) -> i32 {
    return match scan_balanced(chars, start, open, close) {
        Some(end) => end,
        None => chars.len(),
    };
}

fn parse_int_literal(text: &String) -> i32 {
    let mut value: i32 = 0;
    for let c of text.chars() {
        let digit = c as i32 - '0' as i32;
        value = value * 10 + digit;
    }
    return value;
}

pub fn parse(input: String) -> Result<Grammar, ParseError> {
    let chars: List<char> = input.chars().collect();
    let tokens = tokenize_chars(&chars);
    let mut parser = G4Parser::new(tokens, chars);
    return parser.parse_grammar();
}

#[allow(dead_code)]
pub fn parse_checked(input: String) -> Result<Grammar, ParseError> {
    let mut grammar = parse(input)?;
    synthesize_implicit_tokens(&mut grammar);
    check_references(&grammar)?;
    return Result::<Grammar, ParseError>::Ok(grammar);
}

pub variant AssembleError {
    Parse([String, String]),
    Check(String),
}

pub fn assemble_grammar(inputs: &List<[String, String]>) -> Result<Grammar, AssembleError> {
    let mut grammars: List<Grammar> = [];
    for let inp of inputs {
        match parse(inp.1) {
            Ok(mut g) => {
                g.source_files.push(inp.0);
                grammars.push(g);
            },
            Err(e) => {
                return Result::Err(AssembleError::Parse([inp.0, e.message]));
            },
        }
    }
    let mut merged = merge_grammars(grammars);
    synthesize_implicit_tokens(&mut merged);
    match check_references(&merged) {
        Ok(_) => {
        },
        Err(e) => {
            return Result::Err(AssembleError::Check(e.message));
        },
    }
    return Result::Ok(merged);
}
