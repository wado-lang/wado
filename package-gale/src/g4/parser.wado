    Element,
    RuleRefElement,
    TokenRefElement,
    LiteralElement,
    WildcardElement,
    GroupElement,
    RepeatElement,
    LabelElement,
    NotElement,
    RepeatKind,
    LexerRule,
    LexerAlternative,
    LexerElement,
    LexerRepeatElement,
    LexerNotElement,
    CharClass,
    CharRange,
    Visibility,
    DEFAULT_MODE,
    NO_MODE,
    DEFAULT_CHANNEL,
    HIDDEN_CHANNEL,
    check_references,
    check_rule_shapes,
    synthesize_implicit_tokens,
    compose_grammars,
    superclass_bases,
} from "../ir.wado";
use { G4Token, Token } from "./token.wado";
use {
    tokenize,
    resolve_unicode_escape_code,
    string_literal_code_points,
    decode_shared_escape,
    INVALID_ESCAPE,
} from "./lexer.wado";
