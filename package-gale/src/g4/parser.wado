use { Token, ParseError, Span } from "../runtime/lex.wado";
use {
    Grammar,
    GrammarKind,
    GrammarOption,
    OptionValue,
    ActionSource,
    AttrDecl,
    CatchClause,
    ActionLanguage,
    NamedAction,
    PendingRef,
    RefKind,
    ParserRule,
    Alternative,
    Element,
    RuleRefElement,
    TokenRefElement,
    LiteralElement,
    WildcardElement,
    GroupElement,
    RepeatElement,
    LabelElement,
    NotElement,
    RepeatKind,
    LexerRule,
    LexerAlternative,
    LexerElement,
    LexerRepeatElement,
    LexerNotElement,
    CharClass,
    CharRange,
    Visibility,
    DEFAULT_MODE,
    NO_MODE,
    DEFAULT_CHANNEL,
    HIDDEN_CHANNEL,
    check_references,
    synthesize_implicit_tokens,
    merge_grammars,
} from "../ir.wado";
use { G4Token } from "./token.wado";
use { tokenize_chars, resolve_unicode_escape } from "./lexer.wado";
use { scan_balanced, is_id_continue_char } from "./scan.wado";

pub struct G4Parser {
    tokens: List<Token>,
    /// Snapshot of the source as a char array. Used by `scan_balanced` to
    /// re-scan host-language regions (ARG_ACTION, action bodies) that the
    /// byte-level lexer cannot delimit on its own — those need bracket
    /// balance plus string-/comment-awareness, which only matters in
    /// host-language code.
    chars: List<char>,
    pos: i32,
    /// User-defined channel names collected from `channels { }` blocks.
    /// Lexer command `channel(X)` with an identifier argument is resolved
    /// against this list; matching names map to id `index + 2` (0=DEFAULT,
    /// 1=HIDDEN are predefined).
    channels: List<String>,
    /// Grammar-level options collected from the grammar prequel
    /// `options { ... }` blocks. Later blocks append to earlier ones.
    options: List<GrammarOption>,
    /// Grammar-level `@name { ... }` named actions collected from the
    /// prequel. Action bodies are discarded; only the name/scope is kept.
    named_actions: List<NamedAction>,
    /// Rule / token references encountered while parsing rule bodies.
    /// Each entry carries a `RefKind` tag so the post-parse validator
    /// (`check_references` in `ir.wado`) can resolve it against the right
    /// rule table. Emitted straight onto `Grammar.pending_refs` when
    /// `parse_grammar` returns, so a `merge_grammars` over split grammars
    /// can concatenate cross-file refs into a single validatable table.
    pending_refs: List<PendingRef>,
    /// Name of the rule currently being parsed. Used to tag pending refs
    /// so validator error messages can say where the bad reference came
    /// from. Empty outside of a rule body.
    current_rule: String,
    /// Grammar kind latched from the translation unit's header
    /// (`lexer grammar`, `parser grammar`, or bare `grammar`). Surfaced
    /// on the returned `Grammar` so `check_references` can gate which
    /// `RefKind`s are resolvable locally vs. deferred to merge time.
    kind: GrammarKind,
}

/// Accumulator for lexer commands parsed from `-> cmd, cmd, ...`.
/// See ANTLR4 lexer-rules.md for the canonical command set.
struct LexerCommands {
    skip: bool,
    more: bool,
    type_override: Option<String>,
    channel: i32,
    set_mode: i32,
    push_mode: i32,
    pop_mode: bool,
}

impl LexerCommands {
    fn empty() -> LexerCommands {
        return LexerCommands {
            skip: false,
            more: false,
            type_override: null,
            channel: 0,
            set_mode: NO_MODE,
            push_mode: NO_MODE,
            pop_mode: false,
        };
    }
}

fn first_char(s: &String) -> Option<char> {
    let mut iter = s.chars();
    return iter.next();
}

fn is_lexer_rule_name(name: &String) -> bool {
    if let Some(c) = first_char(name) {
        return 'A' <= c <= 'Z';
    }
    return false;
}

/// ANTLR4 restricts `~` in parser rules to a token reference, string
/// literal, or a parenthesised block whose alternatives are themselves
/// set elements. Rule references, wildcards, and EBNF-suffixed elements
/// are rejected. Spec: `vendor/antlr4/doc/parser-rules.md` (sets),
/// confirmed against the published ANTLR4 jar as a black-box oracle.
fn is_valid_not_set_element(elem: &Element) -> bool {
    if let TokenRef(_) = elem {
        return true;
    }
    if let Literal(_) = elem {
        return true;
    }
    if let Group(g) = elem {
        for let alt of &g.alternatives {
            if alt.elements.len() != 1 {
                return false;
            }
            if let TokenRef(_) = alt.elements[0] {
                continue;
            }
            if let Literal(_) = alt.elements[0] {
                continue;
            }
            return false;
        }
        return true;
    }
    return false;
}

/// ANTLR4 restricts `~` in *lexer* rules to a single-character literal, a
/// char range / char class, or a parenthesised block whose alternatives are
/// themselves such set elements. A rule reference, the wildcard (`~.`), a
/// multi-character literal, or an EBNF-suffixed element is rejected. Spec:
/// `vendor/antlr4/doc/lexer-rules.md` (set complement).
fn is_valid_lexer_not_element(elem: &LexerElement) -> bool {
    if let Literal(s) = elem {
        return s.chars().count() == 1;
    }
    if let CharRange(_) = elem {
        return true;
    }
    if let CharClass(_) = elem {
        return true;
    }
    if let Group(alts) = elem {
        for let alt of alts {
            if alt.elements.len() != 1 {
                return false;
            }
            if !is_valid_lexer_not_element(&alt.elements[0]) {
                return false;
            }
        }
        return true;
    }
    return false;
}

impl G4Parser {
    pub fn new(tokens: List<Token>, chars: List<char>) -> G4Parser {
        return G4Parser {
            tokens,
            chars,
            pos: 0,
            channels: [],
            options: [],
            named_actions: [],
            pending_refs: [],
            current_rule: "",
            kind: GrammarKind::Combined,
        };
    }

    fn peek(&self) -> &Token {
        return &self.tokens[self.pos];
    }

    fn peek_kind(&self) -> i32 {
        return self.tokens[self.pos].kind;
    }

    fn at_eof(&self) -> bool {
        return self.peek_kind() == G4Token::Eof as i32;
    }

    fn advance(&mut self) -> &Token {
        let tok = &self.tokens[self.pos];
        self.pos += 1;
        return tok;
    }

    fn expect(&mut self, kind: G4Token) -> Result<&Token, ParseError> {
        let tok = self.peek();
        if tok.kind == kind as i32 {
            self.pos += 1;
            return Result::<&Token, ParseError>::Ok(tok);
        }
        let expected: List<String> = [kind.name()];
        return Result::<&Token, ParseError>::Err(
            ParseError::new(`expected {kind.name()}, got "{tok.text}"`, tok.span, expected),
        );
    }

    fn is_kind(&self, kind: G4Token) -> bool {
        return self.peek_kind() == kind as i32;
    }

    pub fn parse_grammar(&mut self) -> Result<Grammar, ParseError> {
        // Detect lexer/parser grammar prefix. Persist on `self.kind` and
        // on the returned `Grammar` so `check_references` can decide
        // which pending refs are resolvable locally and which have been
        // deferred to a sibling grammar (split-grammar merge).
        let mut is_lexer_grammar = false;
        let mut is_parser_grammar = false;
        if self.is_kind(G4Token::Identifier) {
            let text = &self.peek().text;
            if LexerSlice::eq_str(&"lexer", text) {
                is_lexer_grammar = true;
                self.advance();
            } else if LexerSlice::eq_str(&"parser", text) {
                is_parser_grammar = true;
                self.advance();
            }
        }
        if is_lexer_grammar {
            self.kind = GrammarKind::Lexer;
        } else if is_parser_grammar {
            self.kind = GrammarKind::Parser;
        } else {
            self.kind = GrammarKind::Combined;
        }

        self.expect(G4Token::Grammar)?;
        let name_tok = self.expect(G4Token::Identifier)?;
        let name = name_tok.text.to_string();
        self.expect(G4Token::Semicolon)?;

        let mut virtual_tokens: List<String> = [];
        self.skip_prequel_blocks(&mut virtual_tokens)?;

        let mut parser_rules: List<ParserRule> = [];
        let mut lexer_rules: List<LexerRule> = [];
        let mut mode_names: List<String> = ["DEFAULT_MODE"];
        let mut current_mode: i32 = DEFAULT_MODE;

        while !self.at_eof() {
            // Check for mode declaration: mode NAME;
            // ANTLR4 only allows `mode X;` in lexer grammars (combined or
            // split lexer). Reject it in `parser grammar` form — see
            // `vendor/antlr4/doc/lexer-rules.md` (modes are a lexer-only
            // construct); confirmed against the published ANTLR4 jar.
            if self.is_kind(G4Token::Identifier) && LexerSlice::eq_str(&"mode", &self.peek().text) {
                if is_parser_grammar {
                    let tok = self.peek();
                    let expected: List<String> = ["rule definition"];
                    return Result::<Grammar, ParseError>::Err(
                        ParseError::new(
                            "mode declaration is only allowed in lexer grammars",
                            tok.span,
                            expected,
                        ),
                    );
                }
                self.advance();
                let mode_name_tok = self.expect(G4Token::Identifier)?;
                current_mode = intern_mode(&mut mode_names, &mode_name_tok.text.to_string());
                self.expect(G4Token::Semicolon)?;
                continue;
            }

            // Optional rule modifiers: `public`, `private`, `protected`, `fragment`.
            // ANTLR4 allows multiple visibility modifiers before `fragment`;
            // Gale records the last visibility seen and whether `fragment` was
            // present (only meaningful for the lexer-rule branch).
            let mut is_frag = false;
            let mut visibility = Visibility::Default;
            loop {
                if self.is_kind(G4Token::Fragment) {
                    is_frag = true;
                    self.advance();
                    continue;
                }
                if self.is_kind(G4Token::Identifier) {
                    let text = &self.peek().text;
                    if LexerSlice::eq_str(&"public", text) {
                        visibility = Visibility::Public;
                        self.advance();
                        continue;
                    }
                    if LexerSlice::eq_str(&"private", text) {
                        visibility = Visibility::Private;
                        self.advance();
                        continue;
                    }
                    if LexerSlice::eq_str(&"protected", text) {
                        visibility = Visibility::Protected;
                        self.advance();
                        continue;
                    }
                }
                break;
            }

            let rule_name_tok = self.expect(G4Token::Identifier)?;
            let rule_name = rule_name_tok.text.to_string();
            let rule_name_span = rule_name_tok.span;

            if is_lexer_grammar || is_frag || is_lexer_rule_name(&rule_name) {
                // ANTLR4 rejects duplicate lexer rule names within a grammar.
                // Spec: vendor/antlr4/doc/grammars.md — each rule name is
                // unique in its namespace (lexer / parser).
                for let existing of &lexer_rules {
                    if existing.name == rule_name {
                        return Result::<Grammar, ParseError>::Err(
                            ParseError::new(
                                `duplicate rule "{rule_name}"`,
                                rule_name_span,
                                ["unique rule name"],
                            ),
                        );
                    }
                }
                let mut rule = self.parse_lexer_rule(rule_name, is_frag, current_mode, &mut mode_names)?;
                rule.visibility = visibility;
                // ANTLR4 accepts catch/finally syntax on lexer rules too; the
                // clauses have no lexer meaning, so consume and drop them.
                let _ = self.parse_exception_group();
                lexer_rules.push(rule);
            } else {
                for let existing of &parser_rules {
                    if existing.name == rule_name {
                        return Result::<Grammar, ParseError>::Err(
                            ParseError::new(
                                `duplicate rule "{rule_name}"`,
                                rule_name_span,
                                ["unique rule name"],
                            ),
                        );
                    }
                }
                let mut rule = self.parse_parser_rule(rule_name)?;
                rule.visibility = visibility;
                // Optional exception group: catch* finally? — attach to the rule.
                let exc = self.parse_exception_group();
                rule.catches = exc.catches;
                rule.finally_action = exc.finally_action;
                parser_rules.push(rule);
            }
        }

        // Add virtual tokens from `tokens { }` blocks that don't have real lexer rules
        for let vt of virtual_tokens {
            let mut found = false;
            for let rule of &lexer_rules {
                if rule.name == vt {
                    found = true;
                }
            }
            if !found {
                lexer_rules.push(LexerRule::virtual_token(vt));
            }
        }

        // Semantic rule-reference resolution runs as a separate phase
        // (`check_references` in `ir.wado`), mirroring ANTLR4's split
        // between syntactic parsing and a later semantic-analysis pass.
        // `parse_grammar`
        // publishes the raw `pending_refs` onto the returned `Grammar`
        // so callers can either validate immediately (`parse_checked`)
        // or first merge split-grammar halves with `merge_grammars` and
        // then validate the combined result.

        let channels = self.channels;
        let options = self.options;
        let named_actions = self.named_actions;
        let pending_refs = self.pending_refs;
        let kind = self.kind;
        let source_files: List<String> = [];
        let action_language = action_language_from_options(&options);
        return Result::<Grammar, ParseError>::Ok(
            Grammar {
                name,
                kind,
                parser_rules,
                lexer_rules,
                mode_names,
                channels,
                options,
                named_actions,
                action_language,
                pending_refs,
                source_files,
            },
        );
    }

    fn skip_prequel_blocks(&mut self, virtual_tokens: &mut List<String>) -> Result<(), ParseError> {
        // ANTLR4 grammar prequel constructs (any order, repeatable):
        //   optionsSpec      : 'options'  '{' ... '}'
        //   delegateGrammars : 'import' id ('=' id)? (',' id ('=' id)?)* ';'
        //   tokensSpec       : 'tokens'   '{' id (',' id)* '}'
        //   channelsSpec     : 'channels' '{' id (',' id)* '}'
        //   action           : '@' (id '::')? id '{' ... '}'
        loop {
            if self.is_kind(G4Token::Identifier) {
                let text = &self.peek().text;
                if LexerSlice::eq_str(&"tokens", text) {
                    self.advance();
                    self.parse_tokens_block(virtual_tokens)?;
                    continue;
                }
                if LexerSlice::eq_str(&"channels", text) {
                    self.advance();
                    self.parse_channels_block()?;
                    continue;
                }
                if LexerSlice::eq_str(&"options", text) {
                    self.advance();
                    let opts = self.parse_options_block();
                    for let o of opts {
                        self.options.push(o);
                    }
                    continue;
                }
                if LexerSlice::eq_str(&"import", text) {
                    self.advance();
                    self.parse_delegate_grammars();
                    continue;
                }
            }
            if self.is_kind(G4Token::At) {
                let act = self.parse_named_action();
                self.named_actions.push(act);
                continue;
            }
            break;
        }
        return Result::<(), ParseError>::Ok(());
    }

    /// Parse a `{ NAME (, NAME)* }` block — the shape shared by the
    /// `tokens` and `channels` prequels — and return the names in
    /// declaration order. ANTLR3-style `NAME = INT` assignments are
    /// tolerated (the integer is discarded; Gale assigns ids by order).
    /// Unknown tokens are skipped so malformed input cannot hang the loop.
    /// `kw` names the keyword for the diagnostics. Unclosed blocks (EOF
    /// before `}`) are rejected.
    fn parse_id_list_block(&mut self, kw: &String) -> Result<List<String>, ParseError> {
        let mut names: List<String> = [];
        if !self.is_kind(G4Token::LBrace) {
            let tok = self.peek();
            let mut msg = String::with_capacity(24);
            msg.push_str(&"expected `{` after `");
            msg.push_str(kw);
            msg.push_str(&"`");
            return Result::<List<String>, ParseError>::Err(
                ParseError::new(msg, tok.span, ["{"]),
            );
        }
        let brace_span = self.peek().span;
        self.advance();  // skip '{'
        while !self.at_eof() && !self.is_kind(G4Token::RBrace) {
            if self.is_kind(G4Token::Identifier) {
                names.push(self.peek().text.to_string());
                self.advance();
                // Tolerate ANTLR3-style `= INT` assignments.
                if self.is_kind(G4Token::Assign) {
                    self.advance();
                    if self.is_kind(G4Token::IntLit) {
                        self.advance();
                    }
                }
            } else {
                // Unknown token — advance to avoid an infinite loop on
                // malformed input. Block bodies are not semantically
                // meaningful to Gale beyond the names.
                self.advance();
            }
            if self.is_kind(G4Token::Comma) {
                self.advance();
            }
        }
        if !self.is_kind(G4Token::RBrace) {
            let mut msg = String::with_capacity(56);
            msg.push_str(&"unterminated `");
            msg.push_str(kw);
            msg.push_str(&" { ... }` block — expected `}` before end of file");
            return Result::<List<String>, ParseError>::Err(
                ParseError::new(msg, brace_span, ["}"]),
            );
        }
        self.advance();
        return Result::<List<String>, ParseError>::Ok(names);
    }

    /// Parse `channels { NAME, NAME, ... }` and collect channel names into
    /// `self.channels`. Duplicate declarations collapse silently — ANTLR4
    /// also tolerates repeated channels blocks; the name list is the union.
    /// Unclosed blocks (EOF before `}`) are rejected.
    fn parse_channels_block(&mut self) -> Result<(), ParseError> {
        let names = self.parse_id_list_block(&"channels")?;
        for let name of names {
            let mut dup = false;
            for let existing of &self.channels {
                if *existing == name {
                    dup = true;
                }
            }
            if !dup {
                self.channels.push(name);
            }
        }
        return Result::<(), ParseError>::Ok(());
    }

    /// Parse `import id ('=' id)? (',' id ('=' id)?)* ';'`. We discard the
    /// imports — the IR has no representation for delegate grammars yet.
    fn parse_delegate_grammars(&mut self) {
        loop {
            if !self.is_kind(G4Token::Identifier) {
                break;
            }
            self.advance();
            if self.is_kind(G4Token::Assign) {
                self.advance();
                if self.is_kind(G4Token::Identifier) {
                    self.advance();
                }
            }
            if self.is_kind(G4Token::Comma) {
                self.advance();
                continue;
            }
            break;
        }
        if self.is_kind(G4Token::Semicolon) {
            self.advance();
        }
    }

    /// Parse `options { name = value ; ... }` and return the entries.
    /// Each value is categorised into a typed `OptionValue` variant so
    /// downstream stages don't need to re-parse the raw text; see
    /// `parse_option_value` for the supported shapes. Malformed entries
    /// are silently tolerated to match the rest of the parser's recovery
    /// posture.
    fn parse_options_block(&mut self) -> List<GrammarOption> {
        let mut out: List<GrammarOption> = [];
        if !self.is_kind(G4Token::LBrace) {
            return out;
        }
        self.advance();  // '{'
        while !self.at_eof() && !self.is_kind(G4Token::RBrace) {
            if !self.is_kind(G4Token::Identifier) {
                // Resync: skip unexpected tokens until `;` or `}`.
                self.advance();
                continue;
            }
            let name = self.peek().text.to_string();
            self.advance();
            if !self.is_kind(G4Token::Assign) {
                // No `=`; best-effort recover by swallowing until `;`/`}`.
                while !self.at_eof() && !self.is_kind(G4Token::Semicolon) && !self.is_kind(G4Token::RBrace) {
                    self.advance();
                }
                if self.is_kind(G4Token::Semicolon) {
                    self.advance();
                }
                continue;
            }
            self.advance();  // '='
            let value = self.parse_option_value();
            out.push(GrammarOption { name, value });
            if self.is_kind(G4Token::Semicolon) {
                self.advance();
            }
        }
        if self.is_kind(G4Token::RBrace) {
            self.advance();
        }
        return out;
    }

    /// Parse a single ANTLR4 option value into its typed form:
    /// - `'...'`                  → `Str(<body without quotes>)`
    /// - `42`                     → `Int(42)`
    /// - `{ ... }`                → `Action(<body without braces>)`
    /// - `id`                     → `Ident("id")`
    /// - `pkg.sub.Name`           → `Qualified(["pkg", "sub", "Name"])`
    /// - anything else            → `Ident("")` (permissive recovery)
    fn parse_option_value(&mut self) -> OptionValue {
        if self.is_kind(G4Token::StringLit) {
            let body = self.peek().text.to_string();
            self.advance();
            return OptionValue::Str(body);
        }
        if self.is_kind(G4Token::IntLit) {
            let text = self.peek().text.to_string();
            self.advance();
            return OptionValue::Int(parse_int_literal(&text) as i64);
        }
        if self.is_kind(G4Token::LBrace) {
            let body = self.extract_action('{', '}');
            return OptionValue::Action(body);
        }
        if self.is_kind(G4Token::Identifier) {
            let head = self.peek().text.to_string();
            self.advance();
            if !(self.is_kind(G4Token::Dot) && self.peek_kind_at(1) == G4Token::Identifier as i32) {
                return OptionValue::Ident(head);
            }
            let mut parts: List<String> = [head];
            while self.is_kind(G4Token::Dot) && self.peek_kind_at(1) == G4Token::Identifier as i32 {
                self.advance();
                parts.push(self.peek().text.to_string());
                self.advance();
            }
            return OptionValue::Qualified(parts);
        }
        return OptionValue::Ident("");
    }

    /// Parse `@ id ('::' id)? '{' ... '}'`. The action body is retained on
    /// the returned `NamedAction` (as an `ActionSource`) for the action
    /// pipeline; callers that don't need it simply ignore `body`.
    fn parse_named_action(&mut self) -> NamedAction {
        self.expect(G4Token::At).unwrap();
        let mut scope: Option<String> = null;
        let mut name = String::with_capacity(8);
        if self.is_kind(G4Token::Identifier) {
            name = self.peek().text.to_string();
            self.advance();
        }
        if self.is_kind(G4Token::ColonColon) {
            self.advance();
            // The previously-parsed id was the scope; read the real name.
            scope = Option::<String>::Some(name);
            name = String::with_capacity(8);
            if self.is_kind(G4Token::Identifier) {
                name = self.peek().text.to_string();
                self.advance();
            }
        }
        let mut body = ActionSource {};
        if self.is_kind(G4Token::LBrace) {
            body = self.extract_action('{', '}');
        }
        return NamedAction { scope, name, body };
    }

    /// Parse `tokens { NAME, NAME, ... }` and collect token names.
    ///
    /// Accepts ANTLR3-style numbered assignments `NAME = INT` too for
    /// permissive parsing of legacy `.g4` files ported without cleanup.
    /// The assigned integer is discarded — Gale assigns token ids based on
    /// declaration order internally.
    fn parse_tokens_block(&mut self, virtual_tokens: &mut List<String>) -> Result<(), ParseError> {
        let names = self.parse_id_list_block(&"tokens")?;
        for let name of names {
            virtual_tokens.push(name);
        }
        return Result::<(), ParseError>::Ok(());
    }

    /// Skip a `{ ... }` block of host-language code — `extract_action`
    /// without retaining the captured body. Used where the action element
    /// still has no IR slot (inline alt / lexer actions, pending Phase 1a-ii).
    fn skip_braced_block(&mut self) {
        let _ = self.extract_action('{', '}');
    }

    /// Same traversal as `skip_braced_block`, but capture the block as an
    /// `ActionSource`: `text` is the source strictly between the delimiters,
    /// `span` covers the whole block including them. Used to retain action /
    /// predicate / arg-action bodies. `open`/`close` are `{`/`}` or `[`/`]`.
    fn extract_action(&mut self, open: char, close: char) -> ActionSource {
        let tok = self.peek();
        let start = tok.span.start;
        let end = scan_balanced_or_end(&self.chars, start, open, close);
        self.advance();
        while !self.at_eof() && self.tokens[self.pos].span.start < end {
            self.pos += 1;
        }
        // `end` is just after the closing delimiter; body excludes the
        // opening delimiter at `start` and the closing one at `end - 1`.
        let body_start = start + 1;
        let body_end = if end > start + 1 { end - 1 } else { start + 1 };
        let mut body = String::with_capacity(body_end - body_start);
        let mut i = body_start;
        while i < body_end {
            body.push(self.chars[i]);
            i += 1;
        }
        return ActionSource { text: body, span: Span { start, end }, action_id: -1 };
    }

    /// Skip a `<...>` angle-bracket block without interpreting its contents.
    ///
    /// Only retained for the lexer-alternative call site, where ANTLR4 does
    /// not define element options. Parser-side element options are parsed by
    /// `parse_angle_options()` and stored on the IR.
    fn skip_angle_block(&mut self) {
        self.expect(G4Token::LAngle).unwrap();
        let mut depth = 1;
        while !self.at_eof() && depth > 0 {
            if self.is_kind(G4Token::LAngle) {
                depth += 1;
            } else if self.is_kind(G4Token::RAngle) {
                depth -= 1;
            }
            self.advance();
        }
    }

    /// Parse an ANTLR4 element-option angle block:
    /// `< id '=' value (',' id '=' value)* >`. Returns the parsed options, or
    /// an empty array if malformed. Value parsing reuses `parse_option_value`
    /// so identifiers, qualified ids, integers, strings, and action-block
    /// placeholders round-trip through the same code path as `options { ... }`.
    /// Malformed entries are tolerated (best-effort resync to the closing `>`)
    /// to match the rest of the parser's recovery posture.
    fn parse_angle_options(&mut self) -> Result<List<GrammarOption>, ParseError> {
        let mut out: List<GrammarOption> = [];
        if !self.is_kind(G4Token::LAngle) {
            return Result::<List<GrammarOption>, ParseError>::Ok(out);
        }
        self.advance();
        let mut depth = 1;
        while !self.at_eof() && depth > 0 {
            if self.is_kind(G4Token::RAngle) {
                depth -= 1;
                self.advance();
                continue;
            }
            if self.is_kind(G4Token::LAngle) {
                depth += 1;
                self.advance();
                continue;
            }
            if !self.is_kind(G4Token::Identifier) {
                self.advance();
                continue;
            }
            let name_tok = self.peek();
            let name = name_tok.text.to_string();
            self.advance();
            if !self.is_kind(G4Token::Assign) {
                while !self.at_eof() && !self.is_kind(G4Token::Comma) && !self.is_kind(G4Token::RAngle) {
                    self.advance();
                }
                if self.is_kind(G4Token::Comma) {
                    self.advance();
                }
                continue;
            }
            self.advance();
            let value_span = self.peek().span;
            let value = self.parse_option_value();
            // ANTLR4 options spec (`vendor/antlr4/doc/options.md`): `assoc`
            // is an alt-prefix / token option whose only accepted values are
            // the bare identifiers `left` and `right`. Anything else (a
            // different identifier, a string, an integer, or an action
            // block) is a left-recursion / associativity conflict and must
            // be rejected at parse time — otherwise downstream LR codegen
            // silently falls back to left-associative.
            if name == "assoc" {
                let mut valid = false;
                if let Ident(v) = &value {
                    if *v == "left" || *v == "right" {
                        valid = true;
                    }
                }
                if !valid {
                    return Result::<List<GrammarOption>, ParseError>::Err(
                        ParseError::new(
                            `invalid <assoc=...> value: only "left" or "right" are accepted`,
                            value_span,
                            ["left", "right"],
                        ),
                    );
                }
            }
            out.push(GrammarOption { name, value });
            if self.is_kind(G4Token::Comma) {
                self.advance();
            }
        }
        return Result::<List<GrammarOption>, ParseError>::Ok(out);
    }

    fn parse_parser_rule(&mut self, name: String) -> Result<ParserRule, ParseError> {
        let prequel = self.parse_rule_prequel();
        self.expect(G4Token::Colon)?;
        self.current_rule = name;
        let alternatives = self.parse_alternatives()?;
        self.current_rule = "";
        self.expect(G4Token::Semicolon)?;
        let mut rule = ParserRule::new(name, Visibility::Default, prequel.options, alternatives);
        rule.args = prequel.args;
        rule.returns_decls = prequel.returns_decls;
        rule.locals_decls = prequel.locals_decls;
        rule.throws = prequel.throws;
        rule.init_action = prequel.init_action;
        rule.after_action = prequel.after_action;
        return Result::<ParserRule, ParseError>::Ok(rule);
    }

    /// Consume the optional rule prequel:
    ///   ARG_ACTION? ('returns' ARG_ACTION)? ('throws' qid (',' qid)*)?
    ///   ('locals' ARG_ACTION)? rulePrequel*
    /// where rulePrequel is `optionsSpec` or `'@' id ACTION` (e.g. `@init`,
    /// `@after`). ANTLR4 fixes the order of args/returns/throws/locals before
    /// the repeated `options{}`/`@id{}` block, but we accept any order here
    /// for resilience. Retains everything as a `RulePrequel` for the action
    /// pipeline (see `action.md`).
    fn parse_rule_prequel(&mut self) -> RulePrequel {
        let mut p = RulePrequel {};
        loop {
            if self.is_kind(G4Token::CharClass) {
                // Bare ARG_ACTION right after the rule name → rule arguments.
                let act = self.extract_action('[', ']');
                for let d of parse_attr_decls(&act.text, act.span) {
                    p.args.push(d);
                }
                continue;
            }
            if self.is_kind(G4Token::Identifier) {
                let text = &self.peek().text;
                let is_returns = LexerSlice::eq_str(&"returns", text);
                let is_locals = LexerSlice::eq_str(&"locals", text);
                if is_returns || is_locals {
                    self.advance();
                    if self.is_kind(G4Token::CharClass) {
                        let act = self.extract_action('[', ']');
                        for let d of parse_attr_decls(&act.text, act.span) {
                            if is_returns { p.returns_decls.push(d); } else { p.locals_decls.push(d); }
                        }
                    }
                    continue;
                }
                if LexerSlice::eq_str(&"throws", text) {
                    self.advance();
                    for let q of self.parse_qualified_id_list() {
                        p.throws.push(q);
                    }
                    continue;
                }
                if LexerSlice::eq_str(&"options", text) {
                    self.advance();
                    let opts = self.parse_options_block();
                    for let o of opts {
                        p.options.push(o);
                    }
                    continue;
                }
            }
            if self.is_kind(G4Token::At) {
                // Rule-level prequel actions: `@init` / `@after` bind to the
                // rule; any other `@name` here is retained only as its body
                // being consumed (ANTLR rejects it — we tolerate and drop).
                let act = self.parse_named_action();
                if act.name == "init" {
                    p.init_action = Option::<ActionSource>::Some(act.body);
                } else if act.name == "after" {
                    p.after_action = Option::<ActionSource>::Some(act.body);
                }
                continue;
            }
            break;
        }
        return p;
    }

    /// Parse `qid (',' qid)*` (dotted qualified ids) and return each as a
    /// dotted string. Used for a rule's `throws` list.
    fn parse_qualified_id_list(&mut self) -> List<String> {
        let mut out: List<String> = [];
        loop {
            if !self.is_kind(G4Token::Identifier) {
                break;
            }
            let mut qid = self.peek().text.to_string();
            self.advance();
            // Allow dotted qualified ids: `foo.bar.Baz`
            while self.is_kind(G4Token::Dot) && self.peek_kind_at(1) == G4Token::Identifier as i32 {
                self.advance();
                qid.push('.');
                qid.push_str(&self.peek().text.to_string());
                self.advance();
            }
            out.push(qid);
            if self.is_kind(G4Token::Comma) {
                self.advance();
                continue;
            }
            break;
        }
        return out;
    }

    /// Consume `(catch ARG_ACTION ACTION)* (finally ACTION)?` and retain the
    /// clauses. Execution under Gale's resilient-parse model is a separate
    /// decision (see `action.md`); the IR just carries them.
    fn parse_exception_group(&mut self) -> ExceptionGroup {
        let mut g = ExceptionGroup {};
        loop {
            if !self.is_kind(G4Token::Identifier) {
                break;
            }
            let text = &self.peek().text;
            if LexerSlice::eq_str(&"catch", text) {
                self.advance();
                let mut decl_text = "";
                if self.is_kind(G4Token::CharClass) {
                    decl_text = self.extract_action('[', ']').text;
                }
                let mut body = ActionSource {};
                if self.is_kind(G4Token::LBrace) {
                    body = self.extract_action('{', '}');
                }
                g.catches.push(CatchClause { decl_text, body });
                continue;
            }
            if LexerSlice::eq_str(&"finally", text) {
                self.advance();
                if self.is_kind(G4Token::LBrace) {
                    g.finally_action = Option::<ActionSource>::Some(self.extract_action('{', '}'));
                }
                break;
            }
            break;
        }
        return g;
    }

    fn parse_alternatives(&mut self) -> Result<List<Alternative>, ParseError> {
        let mut alts: List<Alternative> = [];
        let first = self.parse_alternative()?;
        alts.push(first);

        while self.is_kind(G4Token::Pipe) {
            self.advance();
            let alt = self.parse_alternative()?;
            alts.push(alt);
        }
        return Result::<List<Alternative>, ParseError>::Ok(alts);
    }

    fn parse_alternative(&mut self) -> Result<Alternative, ParseError> {
        let mut elements: List<Element> = [];
        let mut options: List<GrammarOption> = [];
        let mut label: Option<String> = null;

        loop {
            if self.at_eof()
                || self.is_kind(G4Token::Pipe)
                || self.is_kind(G4Token::Semicolon)
                || self.is_kind(G4Token::RParen)
                || self.is_kind(G4Token::Hash) {
                break;
            }
            // Skip action blocks {..} and semantic predicates {..}?
            if self.is_kind(G4Token::LBrace) {
                self.skip_braced_block();
                // If followed by ?, this was a semantic predicate — skip the ?
                if self.is_kind(G4Token::Question) {
                    self.advance();
                }
                // ANTLR4 attaches element options to action blocks and
                // semantic predicates: `{ ... }<p=3>` and `{ ... }?<fail='…'>`.
                // The action/predicate body itself is host-language code that
                // Gale skips (Stage C territory), so the action element has no
                // IR slot of its own. Promote the options up to the enclosing
                // alternative — that is where ANTLR4's left-recursion rewriter
                // also reads them from (e.g. `<p=N>` overriding alt precedence,
                // `<fail='…'>` providing a custom predicate failure message).
                if self.is_kind(G4Token::LAngle) {
                    let opts = self.parse_angle_options()?;
                    for let o of opts {
                        options.push(o);
                    }
                }
                continue;
            }
            // Element options `<key=value, ...>` appearing before any element
            // of the alternative attach to the alternative as a whole
            // (e.g. `<assoc=right>` on a left-recursive alt). Any `<...>`
            // encountered later in the loop can only be a post-atom suffix
            // that `parse_atom` already consumed, so it is safe to treat every
            // in-alt angle block at this position as alt-prefix.
            if self.is_kind(G4Token::LAngle) && elements.is_empty() {
                let mut opts = self.parse_angle_options()?;
                for let o of opts {
                    options.push(o);
                }
                continue;
            }
            let elem = self.parse_element()?;
            elements.push(elem);
        }

        if self.is_kind(G4Token::Hash) {
            self.advance();
            let label_tok = self.expect(G4Token::Identifier)?;
            label = Option::<String>::Some(label_tok.text.to_string());
        }

        return Result::<Alternative, ParseError>::Ok(Alternative { label, options, elements });
    }

    fn parse_element(&mut self) -> Result<Element, ParseError> {
        let mut elem = self.parse_atom()?;
        elem = self.parse_postfix(elem)?;
        return Result::<Element, ParseError>::Ok(elem);
    }

    fn parse_atom(&mut self) -> Result<Element, ParseError> {
        if self.is_kind(G4Token::Identifier) {
            let tok = self.advance();
            let name = tok.text.to_string();
            let name_span = tok.span;
            if self.is_kind(G4Token::Assign) || self.is_kind(G4Token::PlusAssign) {
                let list = self.is_kind(G4Token::PlusAssign);
                self.advance();
                let inner = self.parse_atom()?;
                return Result::<Element, ParseError>::Ok(
                    Element::Label(LabelElement::new(name, list, inner)),
                );
            }
            // Optional rule arguments: `ruleref[arg, arg]`. The CharClass
            // token at this position is an ARG_ACTION; retained as raw text
            // on the RuleRef (args apply to parser-rule refs only).
            let mut arg_action: Option<ActionSource> = null;
            if self.is_kind(G4Token::CharClass) {
                arg_action = Option::<ActionSource>::Some(self.extract_action('[', ']'));
            }
            // Optional element options: `ID<assoc=right>`.
            let mut options: List<GrammarOption> = [];
            if self.is_kind(G4Token::LAngle) {
                options = self.parse_angle_options()?;
            }
            // `EOF` is upper-case-led, so `is_lexer_rule_name` already
            // classifies it as a token reference.
            if is_lexer_rule_name(&name) {
                self.pending_refs.push(PendingRef {
                    kind: RefKind::TokenRef,
                    containing_rule: self.current_rule,
                    referenced_name: name,
                    span: name_span,
                });
                return Result::<Element, ParseError>::Ok(
                    Element::TokenRef(TokenRefElement::with_options(name, options)),
                );
            }
            self.pending_refs.push(PendingRef {
                kind: RefKind::ParserRuleRef,
                containing_rule: self.current_rule,
                referenced_name: name,
                span: name_span,
            });
            let mut rr = RuleRefElement::with_options(name, options);
            rr.arg_action = arg_action;
            return Result::<Element, ParseError>::Ok(Element::RuleRef(rr));
        }
        if self.is_kind(G4Token::StringLit) {
            let tok = self.advance();
            let text = tok.text.to_string();
            // Optional element options: `'foo'<p=3>`.
            let mut options: List<GrammarOption> = [];
            if self.is_kind(G4Token::LAngle) {
                options = self.parse_angle_options()?;
            }
            return Result::<Element, ParseError>::Ok(
                Element::Literal(LiteralElement { text, options }),
            );
        }
        if self.is_kind(G4Token::LParen) {
            self.advance();
            // Optional block-level prequel:
            //   ( options { ... } : alt | alt )
            //   ( @init { ... } : alt | alt )
            // Option bodies are parsed onto the GroupElement; action bodies
            // (`@id { ... }`) are still discarded — they are host-language
            // code Gale cannot transpile.
            let options = self.parse_block_prequel();
            let alternatives = self.parse_alternatives()?;
            self.expect(G4Token::RParen)?;
            return Result::<Element, ParseError>::Ok(
                Element::Group(GroupElement { alternatives, options }),
            );
        }
        if self.is_kind(G4Token::Dot) {
            self.advance();
            // Optional element options on wildcard: `.<...>`
            let mut options: List<GrammarOption> = [];
            if self.is_kind(G4Token::LAngle) {
                options = self.parse_angle_options()?;
            }
            return Result::<Element, ParseError>::Ok(
                Element::Wildcard(WildcardElement { options }),
            );
        }
        if self.is_kind(G4Token::Tilde) {
            let tilde_tok = self.peek();
            let tilde_span = tilde_tok.span;
            self.advance();
            let inner = self.parse_atom()?;
            if !is_valid_not_set_element(&inner) {
                return Result::<Element, ParseError>::Err(
                    ParseError::new(
                        `\`~\` must be applied to a token reference, string literal, or parenthesised set — not a rule reference or wildcard`,
                        tilde_span,
                        ["TOKEN_REF", "STRING_LITERAL", "(set)"],
                    ),
                );
            }
            return Result::<Element, ParseError>::Ok(
                Element::Not(NotElement { element: inner }),
            );
        }
        let tok = self.peek();
        let expected: List<String> = ["identifier", "string", "(", ".", "~"];
        return Result::<Element, ParseError>::Err(
            ParseError::new(`unexpected token "{tok.text}"`, tok.span, expected),
        );
    }

    /// Inside a `( ... )` group, ANTLR4 allows an optional `options { ... }`
    /// block followed by `:`, or `@id { ... }` actions, before the actual
    /// alternative list. Returns the accumulated block-level options (empty
    /// if none appeared). Action bodies are still discarded — they are
    /// host-language code Gale cannot transpile.
    fn parse_block_prequel(&mut self) -> List<GrammarOption> {
        let mut options: List<GrammarOption> = [];
        let mut consumed = false;
        loop {
            if self.is_kind(G4Token::Identifier) && LexerSlice::eq_str(&"options", &self.peek().text) {
                self.advance();
                let opts = self.parse_options_block();
                for let o of opts {
                    options.push(o);
                }
                consumed = true;
                continue;
            }
            if self.is_kind(G4Token::At) {
                self.parse_named_action();
                consumed = true;
                continue;
            }
            break;
        }
        // After block prequel, ANTLR4 requires a `:` separator before the
        // alt list. Consume it if present.
        if consumed && self.is_kind(G4Token::Colon) {
            self.advance();
        }
        return options;
    }

    /// Recognize a trailing EBNF repetition operator (`*`, `+`, `?`) plus
    /// an optional non-greedy `?`. Returns `[kind, non_greedy]`, or `None`
    /// when the next token is not a repetition operator. Shared by the
    /// parser-side and lexer-side postfix parsers, which differ only in the
    /// element type they wrap.
    fn parse_repeat_op(&mut self) -> Option<[RepeatKind, bool]> {
        let kind = if self.is_kind(G4Token::Star) {
            RepeatKind::Star;
        } else if self.is_kind(G4Token::Plus) {
            RepeatKind::Plus;
        } else if self.is_kind(G4Token::Question) {
            RepeatKind::Optional;
        } else {
            return null;
        };
        self.advance();
        let non_greedy = if self.is_kind(G4Token::Question) {
            self.advance();
            true;
        } else {
            false;
        };
        return Option::<[RepeatKind, bool]>::Some([kind, non_greedy]);
    }

    fn parse_postfix(&mut self, elem: Element) -> Result<Element, ParseError> {
        return match self.parse_repeat_op() {
            Some(rep) => Result::<Element, ParseError>::Ok(
                Element::Repeat(RepeatElement { kind: rep.0, element: elem, non_greedy: rep.1 }),
            ),
            None => Result::<Element, ParseError>::Ok(elem),
        };
    }

    fn parse_lexer_rule(
        &mut self,
        name: String,
        is_fragment: bool,
        mode: i32,
        mode_names: &mut List<String>,
    ) -> Result<LexerRule, ParseError> {
        // Lexer rules in ANTLR4 also accept the rule prequel (rare but legal,
        // most commonly `locals [int n]`). Only options flow onto a lexer
        // rule today; other prequel parts are consumed and dropped.
        let options = self.parse_rule_prequel().options;
        self.expect(G4Token::Colon)?;
        self.current_rule = name;
        let body = self.parse_lexer_alternatives()?;
        self.current_rule = "";

        let mut actions = LexerCommands::empty();
        if self.is_kind(G4Token::Arrow) {
            self.advance();
            self.parse_lexer_actions(&mut actions, mode_names)?;
        }

        self.expect(G4Token::Semicolon)?;
        return Result::<LexerRule, ParseError>::Ok(
            LexerRule {
                name,
                visibility: Visibility::Default,
                is_fragment,
                skip: actions.skip,
                more: actions.more,
                type_override: actions.type_override,
                channel: actions.channel,
                mode,
                set_mode: actions.set_mode,
                push_mode: actions.push_mode,
                pop_mode: actions.pop_mode,
                is_virtual: false,
                options,
                body,
            },
        );
    }

    fn parse_lexer_actions(
        &mut self,
        actions: &mut LexerCommands,
        mode_names: &mut List<String>,
    ) -> Result<(), ParseError> {
        loop {
            let action_tok = self.advance();
            let action_text = &action_tok.text;
            let action_span = action_tok.span;
            let action_name = action_tok.text.to_string();
            if LexerSlice::eq_str(&"skip", action_text) {
                actions.skip = true;
            } else if LexerSlice::eq_str(&"pushMode", action_text) {
                self.expect(G4Token::LParen)?;
                let mode_name = self.advance();
                self.expect(G4Token::RParen)?;
                actions.push_mode = intern_mode(mode_names, &mode_name.text.to_string());
            } else if LexerSlice::eq_str(&"popMode", action_text) {
                actions.pop_mode = true;
            } else if LexerSlice::eq_str(&"mode", action_text) {
                // `mode(X)` switches the current mode (top of stack), unlike pushMode.
                self.expect(G4Token::LParen)?;
                let mode_name = self.advance();
                self.expect(G4Token::RParen)?;
                actions.set_mode = intern_mode(mode_names, &mode_name.text.to_string());
            } else if LexerSlice::eq_str(&"channel", action_text) {
                // `channel(X)` accepts an integer literal, the predefined name
                // HIDDEN, or a user-defined channel name from `channels { }`.
                self.expect(G4Token::LParen)?;
                let arg = self.advance();
                self.expect(G4Token::RParen)?;
                if LexerSlice::eq_str(&"DEFAULT_TOKEN_CHANNEL", &arg.text) {
                    // ANTLR4's predefined name for channel 0.
                    actions.channel = DEFAULT_CHANNEL;
                } else if LexerSlice::eq_str(&"HIDDEN", &arg.text) {
                    // HIDDEN is the predefined hidden channel (id 1).
                    // ANTLR4 emits HIDDEN tokens on a separate channel —
                    // they are NOT discarded.
                    actions.channel = HIDDEN_CHANNEL;
                } else if arg.kind == G4Token::IntLit as i32 {
                    actions.channel = parse_int_literal(&arg.text.to_string());
                } else {
                    // User-defined channel name: look up in the grammar's
                    // channels { } block (declared in the prequel, before
                    // rules). ANTLR4 errors on an undeclared name; resolving
                    // it to 0 (DEFAULT) would silently invert the author's
                    // intent to route the token off the default channel.
                    let name = arg.text.to_string();
                    let mut resolved = -1;
                    for let mut i = 0; i < self.channels.len(); i += 1 {
                        if self.channels[i] == name {
                            resolved = i + 2;
                        }
                    }
                    if resolved < 0 {
                        let expected: List<String> = ["a channel declared in `channels { }`"];
                        return Result::<(), ParseError>::Err(
                            ParseError::new(
                                `channel "{name}" is not declared in a \`channels \{ ... \}\` block`,
                                arg.span,
                                expected,
                            ),
                        );
                    }
                    actions.channel = resolved;
                }
            } else if LexerSlice::eq_str(&"type", action_text) {
                self.expect(G4Token::LParen)?;
                let target = self.advance();
                self.expect(G4Token::RParen)?;
                actions.type_override = Option::<String>::Some(target.text.to_string());
            } else if LexerSlice::eq_str(&"more", action_text) {
                actions.more = true;
            } else {
                // Unknown lexer command. ANTLR4's command set is fixed:
                // skip, more, channel(X), type(X), pushMode(X), popMode, mode(X).
                // Spec: vendor/antlr4/doc/lexer-rules.md §"Lexer Commands".
                return Result::<(), ParseError>::Err(
                    ParseError::new(
                        `unknown lexer command "{action_name}" — expected one of: skip, more, channel, type, pushMode, popMode, mode`,
                        action_span,
                        ["skip", "more", "channel", "type", "pushMode", "popMode", "mode"],
                    ),
                );
            }
            if !self.is_kind(G4Token::Comma) {
                break;
            }
            self.advance();
        }
        return Result::<(), ParseError>::Ok(());
    }

    fn parse_lexer_alternatives(&mut self) -> Result<List<LexerAlternative>, ParseError> {
        let mut alts: List<LexerAlternative> = [];
        let first = self.parse_lexer_alt()?;
        alts.push(first);

        while self.is_kind(G4Token::Pipe) {
            self.advance();
            let alt = self.parse_lexer_alt()?;
            alts.push(alt);
        }
        return Result::<List<LexerAlternative>, ParseError>::Ok(alts);
    }

    fn parse_lexer_alt(&mut self) -> Result<LexerAlternative, ParseError> {
        let mut elements: List<LexerElement> = [];
        loop {
            if self.at_eof()
                || self.is_kind(G4Token::Pipe)
                || self.is_kind(G4Token::Semicolon)
                || self.is_kind(G4Token::RParen)
                || self.is_kind(G4Token::Arrow) {
                break;
            }
            // Skip action blocks {..} and semantic predicates {..}?
            if self.is_kind(G4Token::LBrace) {
                self.skip_braced_block();
                if self.is_kind(G4Token::Question) {
                    self.advance();
                }
                continue;
            }
            // Skip element options <...>
            if self.is_kind(G4Token::LAngle) {
                self.skip_angle_block();
                continue;
            }
            let elem = self.parse_lexer_element()?;
            elements.push(elem);
        }
        return Result::<LexerAlternative, ParseError>::Ok(LexerAlternative { elements });
    }

    fn parse_lexer_element(&mut self) -> Result<LexerElement, ParseError> {
        let mut elem = self.parse_lexer_atom()?;
        elem = self.parse_lexer_postfix(elem)?;
        return Result::<LexerElement, ParseError>::Ok(elem);
    }

    fn peek_kind_at(&self, offset: i32) -> i32 {
        let i = self.pos + offset;
        if i >= self.tokens.len() {
            return G4Token::Eof as i32;
        }
        return self.tokens[i].kind;
    }

    fn parse_lexer_atom(&mut self) -> Result<LexerElement, ParseError> {
        if self.is_kind(G4Token::StringLit) {
            let tok = self.advance();
            let text = tok.text.to_string();
            let is_dot_dot = self.is_kind(G4Token::Dot) && self.peek_kind_at(1) == G4Token::Dot as i32;
            if is_dot_dot && text.chars().count() == 1 {
                self.advance();
                self.advance();
                let end_tok = self.expect(G4Token::StringLit)?;
                let end_text = end_tok.text.to_string();
                // ANTLR4 requires a single-char endpoint. The start is
                // guarded above; validate the end too rather than silently
                // truncating (`'a'..'bc'`) or panicking on empty (`'a'..''`).
                if end_text.chars().count() != 1 {
                    let expected: List<String> = ["single-char string literal"];
                    return Result::<LexerElement, ParseError>::Err(
                        ParseError::new(
                            "range endpoint must be a single character",
                            end_tok.span,
                            expected,
                        ),
                    );
                }
                let start_char = first_char(&text).unwrap();
                let end_char = first_char(&end_text).unwrap();
                return Result::<LexerElement, ParseError>::Ok(
                    LexerElement::CharRange([start_char, end_char]),
                );
            }
            return Result::<LexerElement, ParseError>::Ok(LexerElement::Literal(text));
        }
        if self.is_kind(G4Token::CharClass) {
            let tok = self.advance();
            let cc = parse_char_class(&tok.text.to_string())?;
            return Result::<LexerElement, ParseError>::Ok(LexerElement::CharClass(cc));
        }
        if self.is_kind(G4Token::Dot) {
            self.advance();
            if self.is_kind(G4Token::Dot) {
                let tok = self.peek();
                let expected: List<String> = ["element"];
                return Result::<LexerElement, ParseError>::Err(
                    ParseError::new("unexpected '..' without preceding char literal", tok.span, expected),
                );
            }
            return Result::<LexerElement, ParseError>::Ok(LexerElement::AnyChar);
        }
        if self.is_kind(G4Token::Identifier) {
            let tok = self.advance();
            let name = tok.text.to_string();
            let span = tok.span;
            self.pending_refs.push(PendingRef {
                kind: RefKind::LexerRuleRef,
                containing_rule: self.current_rule,
                referenced_name: name,
                span,
            });
            return Result::<LexerElement, ParseError>::Ok(LexerElement::RuleRef(name));
        }
        if self.is_kind(G4Token::LParen) {
            self.advance();
            let alts = self.parse_lexer_alternatives()?;
            self.expect(G4Token::RParen)?;
            return Result::<LexerElement, ParseError>::Ok(LexerElement::Group(alts));
        }
        if self.is_kind(G4Token::Tilde) {
            let tilde_span = self.peek().span;
            self.advance();
            let inner = self.parse_lexer_atom()?;
            if !is_valid_lexer_not_element(&inner) {
                let expected: List<String> = ["single char, char set, or block of them"];
                return Result::<LexerElement, ParseError>::Err(
                    ParseError::new(
                        "`~` in a lexer rule must be applied to a single character, a char set, or a parenthesised set — not a rule reference, wildcard, or multi-char literal",
                        tilde_span,
                        expected,
                    ),
                );
            }
            return Result::<LexerElement, ParseError>::Ok(
                LexerElement::Not(LexerNotElement { element: inner }),
            );
        }
        let tok = self.peek();
        let expected: List<String> = ["string", "char-class", "identifier", "(", "~", "."];
        return Result::<LexerElement, ParseError>::Err(
            ParseError::new(`unexpected token "{tok.text}" in lexer rule`, tok.span, expected),
        );
    }

    fn parse_lexer_postfix(&mut self, elem: LexerElement) -> Result<LexerElement, ParseError> {
        return match self.parse_repeat_op() {
            Some(rep) => Result::<LexerElement, ParseError>::Ok(
                LexerElement::Repeat(LexerRepeatElement { kind: rep.0, element: elem, non_greedy: rep.1 }),
            ),
            None => Result::<LexerElement, ParseError>::Ok(elem),
        };
    }
}

fn advance_char(chars: &List<char>, pos: &mut i32) -> char {
    let c = chars[*pos];
    *pos += 1;
    return c;
}

fn resolve_char(chars: &List<char>, pos: &mut i32) -> char {
    let c = advance_char(chars, pos);
    if c != '\\' {
        return c;
    }
    let ec = advance_char(chars, pos);
    return match ec {
        'n' => '\n',
        'r' => '\r',
        't' => '\t',
        'b' => '\u0008',  // backspace (ANTLR4 lexicon.md)
        'f' => '\u000C',  // form feed
        '\\' => '\\',
        ']' => ']',
        '-' => '-',
        'u' => resolve_unicode_escape(chars, pos),
        _ => ec,
    };
}

fn parse_char_class(text: &String) -> Result<CharClass, ParseError> {
    let chars = text.chars().collect();
    let end = chars.len() - 1;
    let mut pos = 1;
    let mut negated = false;
    let mut ranges: List<CharRange> = [];

    if pos < end && chars[pos] == '^' {
        negated = true;
        pos += 1;
    }

    while pos < end {
        // Detect \p{PropertyName} Unicode property escape
        if pos + 2 < end && chars[pos] == '\\' && chars[pos + 1] == 'p' && chars[pos + 2] == '{' {
            pos += 3;  // skip \p{
            let mut prop = String::with_capacity(16);
            while pos < end && chars[pos] != '}' {
                prop.push(chars[pos]);
                pos += 1;
            }
            if pos < end {
                pos += 1;  // skip }
            }
            expand_unicode_property(&prop, &mut ranges);
            continue;
        }

        let c = resolve_char(&chars, &mut pos);
        if pos < end && chars[pos] == '-' && pos + 1 < end {
            advance_char(&chars, &mut pos);
            let c2 = resolve_char(&chars, &mut pos);
            ranges.push(CharRange::range(c, c2));
        } else {
            ranges.push(CharRange::single(c));
        }
    }

    return Result::<CharClass, ParseError>::Ok(CharClass { ranges, negated });
}

/// Expand a Unicode general category property into character ranges.
/// This is an incomplete approximation covering ASCII and common Unicode blocks.
fn expand_unicode_property(name: &String, ranges: &mut List<CharRange>) {
    if *name == "L" || *name == "Letter" {
        // Basic Latin
        ranges.push(CharRange::range('A', 'Z'));
        ranges.push(CharRange::range('a', 'z'));
        // Latin-1 Supplement
        ranges.push(CharRange::range('\u00C0', '\u00D6'));
        ranges.push(CharRange::range('\u00D8', '\u00F6'));
        ranges.push(CharRange::range('\u00F8', '\u00FF'));
        // Latin Extended-A/B
        ranges.push(CharRange::range('\u0100', '\u024F'));
        // Greek and Coptic
        ranges.push(CharRange::range('\u0370', '\u03FF'));
        // Cyrillic
        ranges.push(CharRange::range('\u0400', '\u04FF'));
        // Arabic
        ranges.push(CharRange::range('\u0600', '\u06FF'));
        // Devanagari
        ranges.push(CharRange::range('\u0900', '\u097F'));
        // CJK Unified Ideographs
        ranges.push(CharRange::range('\u4E00', '\u9FFF'));
        // Hiragana
        ranges.push(CharRange::range('\u3040', '\u309F'));
        // Katakana
        ranges.push(CharRange::range('\u30A0', '\u30FF'));
        // Hangul Syllables
        ranges.push(CharRange::range('\uAC00', '\uD7AF'));
    } else if *name == "Nl" || *name == "Letter_Number" {
        // Roman Numerals
        ranges.push(CharRange::range('\u2160', '\u2188'));
        // Runic
        ranges.push(CharRange::range('\u16EE', '\u16F0'));
    } else if *name == "Mn" || *name == "Nonspacing_Mark" {
        // Combining Diacritical Marks
        ranges.push(CharRange::range('\u0300', '\u036F'));
        // Combining Diacritical Marks Extended
        ranges.push(CharRange::range('\u1AB0', '\u1AFF'));
        // Devanagari combining marks
        ranges.push(CharRange::range('\u0901', '\u0902'));
        ranges.push(CharRange::single('\u093C'));
        ranges.push(CharRange::range('\u0941', '\u0948'));
        ranges.push(CharRange::single('\u094D'));
    } else if *name == "Mc" || *name == "Spacing_Mark" {
        ranges.push(CharRange::single('\u0903'));
        ranges.push(CharRange::range('\u093E', '\u0940'));
        ranges.push(CharRange::range('\u0949', '\u094C'));
    } else if *name == "Nd" || *name == "Decimal_Number" {
        ranges.push(CharRange::range('0', '9'));
        // Arabic-Indic
        ranges.push(CharRange::range('\u0660', '\u0669'));
        ranges.push(CharRange::range('\u06F0', '\u06F9'));
        // Devanagari
        ranges.push(CharRange::range('\u0966', '\u096F'));
    } else if *name == "Pc" || *name == "Connector_Punctuation" {
        ranges.push(CharRange::single('_'));
        ranges.push(CharRange::range('\u203F', '\u2040'));
        ranges.push(CharRange::single('\u2054'));
        ranges.push(CharRange::range('\uFE33', '\uFE34'));
        ranges.push(CharRange::range('\uFE4D', '\uFE4F'));
        ranges.push(CharRange::single('\uFF3F'));
    } else if *name == "Zs" || *name == "Space_Separator" {
        ranges.push(CharRange::single(' '));
        ranges.push(CharRange::single('\u00A0'));
        ranges.push(CharRange::single('\u1680'));
        ranges.push(CharRange::range('\u2000', '\u200A'));
        ranges.push(CharRange::single('\u202F'));
        ranges.push(CharRange::single('\u205F'));
        ranges.push(CharRange::single('\u3000'));
    }
    // Unknown properties are silently ignored (empty expansion)
}

fn intern_mode(mode_names: &mut List<String>, name: &String) -> i32 {
    for let mut i = 0; i < mode_names.len(); i += 1 {
        if mode_names[i] == *name {
            return i;
        }
    }
    mode_names.push(*name);
    return mode_names.len() - 1;
}

/// `scan_balanced` with the parser's unterminated convention: a region
/// that never closes is consumed to end-of-input, so the caller advances
/// past every remaining token of the malformed action body.
/// Map a grammar-level `options { language = X }` to `ActionLanguage`.
/// Absent → `Java` (ANTLR4's default target and the corpus's language).
fn action_language_from_options(options: &List<GrammarOption>) -> ActionLanguage {
    for let opt of options {
        if opt.name == "language" {
            // The value is a bare identifier conventionally (`language = Java`)
            // but ANTLR4's optionValue also admits a string literal
            // (`language = "Java"`); accept both. Match case-insensitively so
            // `java` / `JAVA` classify as Java, not Other.
            let name = match &opt.value {
                Ident(v) => Option::<String>::Some(*v),
                Str(v) => Option::<String>::Some(*v),
                Qualified(_) => null,
                Int(_) => null,
                Action(_) => null,
            };
            if let Some(v) = name {
                if v.eq_ignore_ascii_case("java") { return ActionLanguage::Java; }
                if v.eq_ignore_ascii_case("wado") { return ActionLanguage::Wado; }
                return ActionLanguage::Other(v);
            }
        }
    }
    return ActionLanguage::Java;
}

/// Captured `catch` / `finally` clauses following a rule body.
struct ExceptionGroup {
    catches: List<CatchClause> = [],
    finally_action: Option<ActionSource> = null,
}

/// Everything captured from a rule prequel, retained on the `ParserRule`.
/// All fields defaulted so `RulePrequel {}` is a valid empty starting point.
struct RulePrequel {
    options: List<GrammarOption> = [],
    args: List<AttrDecl> = [],
    returns_decls: List<AttrDecl> = [],
    locals_decls: List<AttrDecl> = [],
    throws: List<String> = [],
    init_action: Option<ActionSource> = null,
    after_action: Option<ActionSource> = null,
}

/// Split an attribute-list body (the text between `[` and `]` of an
/// `[...]` / `returns [...]` / `locals [...]`) into `AttrDecl`s. Commas at
/// nesting depth 0 separate declarations; `<>`, `[]`, `()` nest so a comma
/// inside `Map<K, V>` or `int[]` does not split. Within a declaration, the
/// last identifier run is the attribute name and everything before it
/// (trimmed) is the type text. All decls share `list_span` (the enclosing
/// arg-action span) — per-decl spans are a later refinement. This is ANTLR
/// attribute-definition syntax, not host-language parsing.
fn parse_attr_decls(body: &String, list_span: Span) -> List<AttrDecl> {
    let chars: List<char> = body.chars().collect();
    let n = chars.len();
    let mut out: List<AttrDecl> = [];
    let mut depth = 0;
    let mut seg = String::with_capacity(16);
    let mut i = 0;
    while i <= n {
        let at_end = i == n;
        let c = if at_end { ',' } else { chars[i] };
        if !at_end && (c == '<' || c == '[' || c == '(') {
            depth += 1;
            seg.push(c);
        } else if !at_end && (c == '>' || c == ']' || c == ')') {
            if depth > 0 { depth -= 1; }
            seg.push(c);
        } else if c == ',' && depth == 0 {
            if let Some(d) = split_attr_decl(&seg, list_span) {
                out.push(d);
            }
            seg = String::with_capacity(16);
        } else {
            seg.push(c);
        }
        i += 1;
    }
    return out;
}

/// Split one declaration segment ("int v", "List<String> ignored",
/// "int i = 0") into (type_text, name). `null` when the segment is blank.
/// An initializer (`= expr`, legal in ANTLR4 `returns`/`locals`/args) is
/// dropped: the declaration is everything before the first assignment `=`.
fn split_attr_decl(seg: &String, span: Span) -> Option<AttrDecl> {
    let chars: List<char> = seg.chars().collect();
    let full = chars.len();
    // Cut at the first assignment `=` (not `==` / `<=` / `>=` / `!=`), so
    // "int i = 0" declares `i`, not the initializer's trailing token.
    let mut n = full;
    for let mut k = 0; k < full; k += 1 {
        if chars[k] == '=' {
            let prev_cmp = k > 0 && (chars[k - 1] == '!' || chars[k - 1] == '<' || chars[k - 1] == '>' || chars[k - 1] == '=');
            let next_eq = k + 1 < full && chars[k + 1] == '=';
            if !prev_cmp && !next_eq {
                n = k;
                break;
            }
        }
    }
    // Trim trailing whitespace, then take the trailing identifier run as name.
    let mut end = n;
    while end > 0 && chars[end - 1].is_ascii_whitespace() {
        end -= 1;
    }
    if end == 0 {
        return null;
    }
    let mut name_start = end;
    while name_start > 0 && is_id_continue_char(chars[name_start - 1]) {
        name_start -= 1;
    }
    let mut name = String::with_capacity(end - name_start);
    for let mut k = name_start; k < end; k += 1 {
        name.push(chars[k]);
    }
    let mut type_end = name_start;
    while type_end > 0 && chars[type_end - 1].is_ascii_whitespace() {
        type_end -= 1;
    }
    let mut type_text = String::with_capacity(type_end);
    let mut ts = 0;
    while ts < type_end && chars[ts].is_ascii_whitespace() {
        ts += 1;
    }
    for let mut k = ts; k < type_end; k += 1 {
        type_text.push(chars[k]);
    }
    return Option::<AttrDecl>::Some(AttrDecl { type_text, name, span });
}

fn scan_balanced_or_end(chars: &List<char>, start: i32, open: char, close: char) -> i32 {
    return match scan_balanced(chars, start, open, close) {
        Some(end) => end,
        None => chars.len(),
    };
}

/// Parse a decimal integer literal token (e.g. "42", "0", "9999"). The lexer
/// guarantees the text is non-empty and contains only ASCII digits.
fn parse_int_literal(text: &String) -> i32 {
    let mut value: i32 = 0;
    for let c of text.chars() {
        let digit = c as i32 - '0' as i32;
        value = value * 10 + digit;
    }
    return value;
}

/// Syntactic parse only. Turns a `.g4` source string into a `Grammar` IR
/// without running the semantic rule-reference resolution pass — mirrors
/// ANTLR4 accepting any syntactically well-formed grammar and leaving
/// symbol resolution to a later phase.
///
/// The parser still rejects mistakes that can be caught locally during a
/// single pass: duplicate rule names (B1), a `mode X;` declaration inside
/// a `parser grammar`, `~` applied to something that isn't a set (B5),
/// unknown lexer commands (B7), and `<assoc=…>` values other than `left`
/// / `right` (B6). These are structural / lexical errors, not
/// cross-rule symbol lookups.
///
/// Use `parse` when the translation unit deliberately defers symbols to
/// a sibling grammar:
///   - a `parser grammar` that pulls tokens from its matching `lexer
///     grammar` (they're merged by `merge_grammars` before codegen).
///   - a combined grammar that uses `tokenVocab` / `import` to bring in
///     rules from elsewhere.
///   - minimal test fixtures that intentionally leave references
///     dangling.
///
/// If you want the full ANTLR4-tool contract — including rejection of
/// references to undefined rules / tokens — call `parse_checked`
/// instead, or follow `parse` with `check_references` (from `ir.wado`)
/// on the merged grammar.
pub fn parse(input: String) -> Result<Grammar, ParseError> {
    // Collect the source once and share it between the lexer and the parser.
    // Tokens own their text, so the buffer can be handed off to the parser
    // (which retains it for `scan_balanced`) after tokenization.
    let chars: List<char> = input.chars().collect();
    let tokens = tokenize_chars(&chars);
    let mut parser = G4Parser::new(tokens, chars);
    return parser.parse_grammar();
}

/// Parse + semantic rule-reference resolution, in one call. Equivalent
/// to `parse` followed by `ir::check_references`, and mirrors ANTLR4's
/// full tool-level contract (a syntactic parse plus the
/// unresolved-rule-reference check).
///
/// Rejects grammars that `parse` would accept but where a parser-rule
/// ref, token ref, or lexer-rule ref does not resolve against the rule
/// table of the current translation unit. The check is
/// grammar-kind-aware:
///   - combined grammar: parser refs, token refs, and lexer-to-lexer
///     refs are all resolvable locally and all validated.
///   - `lexer grammar`: only lexer-to-lexer refs can be resolved
///     locally; there are no parser / token refs to check.
///   - `parser grammar`: only parser-rule refs can be resolved
///     locally; token refs come from the matching lexer grammar at
///     merge time and are skipped.
///
/// Prefer this over bare `parse` whenever the input is a complete,
/// self-contained grammar translation unit. Split-grammar halves that
/// rely on a sibling translation unit should still go through `parse`
/// and call `check_references` after `merge_grammars`.
///
/// NOTE: currently exercised only by tests. Gale's CLI and Kiln generator
/// always take the split-grammar path (`parse` + `merge_grammars` +
/// `check_references`), so this single-call convenience has no production
/// caller yet; whether Gale exposes a library API is still undecided.
/// `#[allow(dead_code)]` keeps it as a documented public entry without a
/// "never used" warning until that decision is made.
#[allow(dead_code)]
pub fn parse_checked(input: String) -> Result<Grammar, ParseError> {
    let mut grammar = parse(input)?;
    // Must run before `check_references`. See `ir.wado` for rationale.
    synthesize_implicit_tokens(&mut grammar);
    check_references(&grammar)?;
    return Result::<Grammar, ParseError>::Ok(grammar);
}

pub variant AssembleError {
    Parse([String, String]),
    Check(String),
}

pub fn assemble_grammar(inputs: &List<[String, String]>) -> Result<Grammar, AssembleError> {
    let mut grammars: List<Grammar> = [];
    for let inp of inputs {
        match parse(inp.1) {
            Ok(mut g) => {
                g.source_files.push(inp.0);
                grammars.push(g);
            },
            Err(e) => {
                return Result::Err(AssembleError::Parse([inp.0, e.message]));
            },
        }
    }
    let mut merged = merge_grammars(grammars);
    // Must run before `check_references`. See `ir.wado` for rationale.
    synthesize_implicit_tokens(&mut merged);
    match check_references(&merged) {
        Ok(_) => {
        },
        Err(e) => {
            return Result::Err(AssembleError::Check(e.message));
        },
    }
    return Result::Ok(merged);
}
