use { scan_balanced, split_top_level_commas, ident_start, is_rule_name_upper, skip_ws } from "./scan.wado";
use {
    clip_to_scalars,
    complement_char_ranges,
    expand_unicode_property,
    unsupported_property_message,
} from "./unicode.wado";

pub struct G4Parser {
    tokens: List<Token>,
    src: StrSlice,
    pos: i32,
    channels: List<String>,
    options: List<GrammarOption>,
    named_actions: List<NamedAction>,
    imports: List<String>,
    pending_refs: List<PendingRef>,
    current_rule: String,
    kind: GrammarKind,
}

struct LexerCommands {
    skip: bool,
    more: bool,
    type_override: Option<String>,
    channel: i32,
    set_mode: i32,
    push_mode: i32,
    pop_mode: bool,
}

impl LexerCommands {
    fn empty() -> LexerCommands {
        return LexerCommands {
            skip: false,
            more: false,
            type_override: null,
            channel: 0,
            set_mode: NO_MODE,
            push_mode: NO_MODE,
            pop_mode: false,
        };
    }
}

/// Every lexer command ANTLR4 defines. Doubles as the wanted set each
/// lexer-command diagnostic reports, so the list is stated once.
global LEXER_COMMAND_NAMES: List<String> = ["skip", "more", "channel", "type", "pushMode", "popMode", "mode"];

/// The "what was found" half of a parse error; the wanted set travels
/// separately in `ParseError.expected`. A token the lexer could not form names
/// its own lexical problem — quoting its raw text would show a truncated
/// fragment and say nothing about why the lexer stopped.
fn found_desc(tok: &Token) -> String {
    if tok.kind == G4Token::UnterminatedString.code() {
        return G4Token::UnterminatedString.name();
    }
    if tok.kind == G4Token::UnterminatedCharClass.code() {
        return G4Token::UnterminatedCharClass.name();
    }
    if tok.kind == G4Token::InvalidEscape.code() {
        return `${G4Token::InvalidEscape.name()} ${tok.text}`;
    }
    if tok.kind == G4Token::UnexpectedChar.code() {
        return `${G4Token::UnexpectedChar.name()} "${tok.text}"`;
    }
    assert tok.kind < G4Token::UnterminatedString.code();
    return `got "${tok.text}"`;
}

/// Whether a block may carry a label. ANTLR4 takes one only on a set: two or
/// more alternatives, each a single terminal and nothing else (`error(130)`).
fn is_labelable_set(g: &GroupElement) -> bool {
    if g.alternatives.len() < 2 || !g.options.is_empty() {
        return false;
    }
    for let alt of &g.alternatives {
        if alt.elements.len() != 1 || !alt.actions.is_empty() || !alt.options.is_empty() {
            return false;
        }
        if alt.label matches { Some(_) } || !alt.elements[0] matches { TokenRef(_) | Literal(_) } {
            return false;
        }
    }
    return true;
}

fn first_char<S: AsStrSlice>(s: S) -> Option<char> {
    let mut iter = s.chars();
    return iter.next();
}

fn is_lexer_rule_name<S: AsStrSlice>(name: S) -> bool {
    return first_char(name) matches { Some(c) && is_rule_name_upper(c) };
}

fn is_valid_not_set_element(elem: &Element) -> bool {
    return match elem {
        TokenRef(_) | Literal(_) => true,
        Group(g) => {
            let mut ok = true;
            for let alt of &g.alternatives {
                if alt.elements.len() != 1 || !alt.elements[0] matches { TokenRef(_) | Literal(_) } {
                    ok = false;
                    break;
                }
            }
            ok;
        },
        RuleRef(_) | Label(_) | Repeat(_) | Wildcard(_) | Not(_) => false,
    };
}

/// The span of the first action or predicate a `~` set's alternatives carry.
fn not_set_code_span(elem: &Element) -> Option<Span> {
    if let Group(g) = elem {
        for let alt of &g.alternatives {
            if !alt.actions.is_empty() {
                return Option::Some(alt.actions[0].source.span);
            }
            for let e of &alt.elements {
                if let Some(span) = not_set_code_span(e) {
                    return Option::Some(span);
                }
            }
        }
    }
    return null;
}

fn lexer_not_set_code_span(elem: &LexerElement) -> Option<Span> {
    if let Group(alts) = elem {
        for let alt of alts {
            if !alt.actions.is_empty() {
                return Option::Some(alt.actions[0].source.span);
            }
            for let e of &alt.elements {
                if let Some(span) = lexer_not_set_code_span(e) {
                    return Option::Some(span);
                }
            }
        }
    }
    return null;
}

// A set is computed before any input is read, so an action has no point at
// which to run and a predicate none at which to decide; no reading of either
// is the grammar's, which the compatibility contract asks to reject.
fn not_set_code_error(span: Span) -> ParseError {
    return ParseError::new(
        "an action or predicate inside a `~` set: the set is fixed before parsing, so the code would never run",
        span,
        [],
    );
}

fn is_valid_lexer_not_element(elem: &LexerElement) -> bool {
    return match elem {
        Literal(s) => s.chars().count() == 1,
        CharRange(_) | CharClass(_) => true,
        Group(alts) => {
            let mut ok = true;
            for let alt of alts {
                if alt.elements.len() != 1 || !is_valid_lexer_not_element(&alt.elements[0]) {
                    ok = false;
                    break;
                }
            }
            ok;
        },
        AnyChar | RuleRef(_) | Repeat(_) | Not(_) => false,
    };
}

impl G4Parser {
    pub fn new(tokens: List<Token>, src: StrSlice) -> G4Parser {
        return G4Parser {
            tokens,
            src,
            pos: 0,
            channels: [],
            options: [],
            named_actions: [],
            imports: [],
            pending_refs: [],
            current_rule: "",
            kind: GrammarKind::Combined,
        };
    }

    fn peek(&self) -> &Token {
        return &self.tokens[self.pos];
    }

    fn peek_kind(&self) -> i32 {
        return self.tokens[self.pos].kind;
    }

    fn at_eof(&self) -> bool {
        return self.peek_kind() == G4Token::Eof.code();
    }

    fn advance(&mut self) -> &Token {
        let tok = &self.tokens[self.pos];
        self.pos += 1;
        return tok;
    }

    fn expect(&mut self, kind: G4Token) -> Result<&Token, ParseError> {
        let tok = self.peek();
        if tok.kind == kind.code() {
            self.pos += 1;
            return Result::<&Token, ParseError>::Ok(tok);
        }
        let expected: List<String> = [kind.name()];
        return Result::<&Token, ParseError>::Err(
            ParseError::new(found_desc(tok), tok.span, expected),
        );
    }

    fn is_kind(&self, kind: G4Token) -> bool {
        return self.peek_kind() == kind.code();
    }

    pub fn parse_grammar(&mut self) -> Result<Grammar, ParseError> {
        let mut is_lexer_grammar = false;
        let mut is_parser_grammar = false;
        if self.is_kind(G4Token::Identifier) {
            let text = &self.peek().text;
            if *text == "lexer" {
                is_lexer_grammar = true;
                self.advance();
            } else if *text == "parser" {
                is_parser_grammar = true;
                self.advance();
            }
        }
        if is_lexer_grammar {
            self.kind = GrammarKind::Lexer;
        } else if is_parser_grammar {
            self.kind = GrammarKind::Parser;
        } else {
            self.kind = GrammarKind::Combined;
        }

        self.expect(G4Token::Grammar)?;
        let name_tok = self.expect(G4Token::Identifier)?;
        let name = name_tok.text;
        self.expect(G4Token::Semicolon)?;

        let mut virtual_tokens: List<String> = [];
        self.skip_prequel_blocks(&mut virtual_tokens)?;

        let mut parser_rules: List<ParserRule> = [];
        let mut lexer_rules: List<LexerRule> = [];
        let mut mode_names: List<String> = ["DEFAULT_MODE"];
        let mut current_mode: i32 = DEFAULT_MODE;
        let mut misplaced_rule: Option<ParseError> = null;

        while !self.at_eof() {
            if self.is_kind(G4Token::Identifier) && self.peek().text == "mode" {
                if is_parser_grammar {
                    let tok = self.peek();
                    let expected: List<String> = ["rule definition"];
                    return Result::<Grammar, ParseError>::Err(
                        ParseError::new(
                            "mode declaration is only allowed in lexer grammars",
                            tok.span,
                            expected,
                        ),
                    );
                }
                self.advance();
                let mode_name_tok = self.expect(G4Token::Identifier)?;
                current_mode = intern_mode(&mut mode_names, &mode_name_tok.text);
                self.expect(G4Token::Semicolon)?;
                continue;
            }

            let mut is_frag = false;
            let mut visibility = Visibility::Default;
            loop {
                if self.is_kind(G4Token::Fragment) {
                    is_frag = true;
                    self.advance();
                    continue;
                }
                if self.is_kind(G4Token::Identifier) {
                    let modifier = match self.peek().text {
                        "public" => Option::Some(Visibility::Public),
                        "private" => Option::Some(Visibility::Private),
                        "protected" => Option::Some(Visibility::Protected),
                        _ => null,
                    };
                    if let Some(v) = modifier {
                        visibility = v;
                        self.advance();
                        continue;
                    }
                }
                break;
            }

            let rule_name_tok = self.expect(G4Token::Identifier)?;
            let rule_name = rule_name_tok.text;
            let rule_name_span = rule_name_tok.span;

            let is_lexer_rule = is_frag || is_lexer_rule_name(&rule_name);
            if misplaced_rule matches { None } {
                if is_parser_grammar && is_lexer_rule {
                    misplaced_rule = Option::Some(
                        ParseError::new(
                            `lexer rule ${rule_name} not allowed in parser`,
                            rule_name_span,
                            ["parser rule"],
                        ),
                    );
                } else if is_lexer_grammar && !is_lexer_rule {
                    misplaced_rule = Option::Some(
                        ParseError::new(`parser rule ${rule_name} not allowed in lexer`, rule_name_span, ["lexer rule"]),
                    );
                }
            }
            if is_lexer_rule {
                for let existing of &lexer_rules {
                    if existing.name == rule_name {
                        return Result::<Grammar, ParseError>::Err(
                            ParseError::new(
                                `duplicate rule "${rule_name}"`,
                                rule_name_span,
                                ["unique rule name"],
                            ),
                        );
                    }
                }
                let mut rule = self.parse_lexer_rule(rule_name, is_frag, current_mode, &mut mode_names)?;
                rule.visibility = visibility;
                if self.at_exception_clause() {
                    return Result::<Grammar, ParseError>::Err(
                        ParseError::new(
                            "a lexer rule takes no `catch` or `finally` clause",
                            self.peek().span,
                            ["rule definition"],
                        ),
                    );
                }
                lexer_rules.push(rule);
            } else {
                for let existing of &parser_rules {
                    if existing.name == rule_name {
                        return Result::<Grammar, ParseError>::Err(
                            ParseError::new(
                                `duplicate rule "${rule_name}"`,
                                rule_name_span,
                                ["unique rule name"],
                            ),
                        );
                    }
                }
                let mut rule = self.parse_parser_rule(rule_name)?;
                rule.visibility = visibility;
                let exc = self.parse_exception_group()?;
                rule.catches = exc.catches;
                rule.finally_action = exc.finally_action;
                parser_rules.push(rule);
            }
        }

        for let vt of virtual_tokens {
            let mut found = false;
            for let rule of &lexer_rules {
                if rule.name == vt {
                    found = true;
                }
            }
            if !found {
                lexer_rules.push(LexerRule::virtual_token(vt));
            }
        }


        let channels = self.channels;
        let options = self.options;
        let named_actions = self.named_actions;
        let imports = self.imports;
        let pending_refs = self.pending_refs;
        let kind = self.kind;
        let source_files: List<String> = [];
        let action_language = action_language_from_options(&options);
        let [lexer_superclass, parser_superclass] = superclass_bases(&kind, &options);
        return Result::<Grammar, ParseError>::Ok(
            Grammar {
                name,
                kind,
                parser_rules,
                lexer_rules,
                mode_names,
                channels,
                options,
                named_actions,
                imports,
                action_language,
                pending_refs,
                source_files,
                lexer_superclass,
                parser_superclass,
                misplaced_rule,
            },
        );
    }

    fn skip_prequel_blocks(&mut self, virtual_tokens: &mut List<String>) -> Result<(), ParseError> {
        loop {
            if self.is_kind(G4Token::Identifier) {
                let text = &self.peek().text;
                if *text == "tokens" {
                    self.advance();
                    self.parse_tokens_block(virtual_tokens)?;
                    continue;
                }
                if *text == "channels" {
                    self.advance();
                    self.parse_channels_block()?;
                    continue;
                }
                if *text == "options" {
                    self.advance();
                    for let o of self.parse_options_block()? {
                        self.options.push(o);
                    }
                    continue;
                }
                if *text == "import" {
                    self.advance();
                    self.parse_delegate_grammars()?;
                    continue;
                }
            }
            if self.is_kind(G4Token::At) {
                let act = self.parse_named_action();
                self.named_actions.push(act);
                continue;
            }
            break;
        }
        return Result::<(), ParseError>::Ok(());
    }

    fn parse_id_list_block<S: AsStrSlice>(&mut self, kw: S) -> Result<List<String>, ParseError> {
        let mut names: List<String> = [];
        if !self.is_kind(G4Token::LBrace) {
            let tok = self.peek();
            let mut msg = String::with_capacity(24);
            msg.push_str("expected `{` after `");
            msg.push_str(kw);
            msg.push_str("`");
            return Result::<List<String>, ParseError>::Err(
                ParseError::new(msg, tok.span, ["{"]),
            );
        }
        let brace_span = self.peek().span;
        self.advance();
        // `ident (, ident)*`, possibly empty, with no trailing comma: what the
        // jar admits.
        while !self.at_eof() && !self.is_kind(G4Token::RBrace) {
            if !names.is_empty() {
                self.expect(G4Token::Comma)?;
            }
            names.push(self.expect(G4Token::Identifier)?.text);
        }
        if !self.is_kind(G4Token::RBrace) {
            let mut msg = String::with_capacity(56);
            msg.push_str("unterminated `");
            msg.push_str(kw);
            msg.push_str(" { ... }` block — expected `}` before end of file");
            return Result::<List<String>, ParseError>::Err(
                ParseError::new(msg, brace_span, ["}"]),
            );
        }
        self.advance();
        return Result::<List<String>, ParseError>::Ok(names);
    }

    fn parse_channels_block(&mut self) -> Result<(), ParseError> {
        let names = self.parse_id_list_block("channels")?;
        for let name of names {
            let mut dup = false;
            for let existing of &self.channels {
                if *existing == name {
                    dup = true;
                }
            }
            if !dup {
                self.channels.push(name);
            }
        }
        return Result::<(), ParseError>::Ok(());
    }

    /// `import S, T;` — record each delegate's declared name for
    /// `compose_grammars` to bind. One name and the `;` are the minimum, so a
    /// mistyped clause is loud here rather than a missing rule later. The
    /// aliased form is rejected; see `import.md`.
    fn parse_delegate_grammars(&mut self) -> Result<(), ParseError> {
        loop {
            if !self.is_kind(G4Token::Identifier) {
                return Result::<(), ParseError>::Err(
                    ParseError::new(
                        "expected a grammar name after `import`",
                        self.peek().span,
                        ["import <grammar name>"],
                    ),
                );
            }
            let name_tok = self.peek();
            let name = name_tok.text;
            let name_span = name_tok.span;
            self.advance();
            if self.is_kind(G4Token::Assign) {
                return Result::<(), ParseError>::Err(
                    ParseError::new(
                        `aliased grammar import "import ${name} = ...;" is not supported`,
                        name_span,
                        ["import <grammar name>"],
                    ),
                );
            }
            push_unique(&mut self.imports, name);
            if self.is_kind(G4Token::Comma) {
                self.advance();
                continue;
            }
            break;
        }
        if !self.is_kind(G4Token::Semicolon) {
            return Result::<(), ParseError>::Err(
                ParseError::new("expected `;` after the import list", self.peek().span, [";"]),
            );
        }
        self.advance();
        return Result::<(), ParseError>::Ok(());
    }

    /// `{ (name = value ;)* }`, each `;` required, as the jar requires it.
    fn parse_options_block(&mut self) -> Result<List<GrammarOption>, ParseError> {
        let mut out: List<GrammarOption> = [];
        self.expect(G4Token::LBrace)?;
        while !self.is_kind(G4Token::RBrace) {
            let name = self.expect(G4Token::Identifier)?.text;
            self.expect(G4Token::Assign)?;
            let value = self.parse_option_value()?;
            out.push(GrammarOption { name, value });
            self.expect(G4Token::Semicolon)?;
        }
        self.advance();
        return Result::Ok(out);
    }

    /// The integer literal at the cursor, rejected past `i32::MAX`.
    fn take_i32_literal(&mut self) -> Result<i32, ParseError> {
        let tok = self.advance();
        return match i32::from_str(&tok.text) {
            Ok(v) => Result::Ok(v),
            Err(_) => Result::Err(ParseError::new(`${tok.text} is out of range`, tok.span, [`at most ${i32::MAX}`])),
        };
    }

    fn parse_option_value(&mut self) -> Result<OptionValue, ParseError> {
        if self.is_kind(G4Token::StringLit) {
            let body = self.peek().text;
            self.advance();
            return Result::Ok(OptionValue::Str(body));
        }
        if self.is_kind(G4Token::IntLit) {
            return Result::Ok(OptionValue::Int(self.advance().text));
        }
        if self.is_kind(G4Token::LBrace) {
            let body = self.extract_action(b'{', b'}');
            return Result::Ok(OptionValue::Action(body));
        }
        if self.is_kind(G4Token::Identifier) {
            let parts = self.parse_dotted_name();
            if parts.len() == 1 {
                return Result::Ok(OptionValue::Ident(parts[0]));
            }
            return Result::Ok(OptionValue::Qualified(parts));
        }
        return Result::Err(
            ParseError::new(
                found_desc(self.peek()),
                self.peek().span,
                ["an identifier", "a string", "an integer", "an action"],
            ),
        );
    }

    fn parse_named_action(&mut self) -> NamedAction {
        self.expect(G4Token::At).unwrap();
        let mut scope: Option<String> = null;
        let mut name = String::with_capacity(8);
        if self.is_kind(G4Token::Identifier) {
            name = self.peek().text;
            self.advance();
        }
        if self.is_kind(G4Token::ColonColon) {
            self.advance();
            scope = Option::<String>::Some(name);
            name = String::with_capacity(8);
            if self.is_kind(G4Token::Identifier) {
                name = self.peek().text;
                self.advance();
            }
        }
        let mut body = ActionSource {};
        if self.is_kind(G4Token::LBrace) {
            body = self.extract_action(b'{', b'}');
        }
        return NamedAction { scope, name, body };
    }

    fn parse_tokens_block(&mut self, virtual_tokens: &mut List<String>) -> Result<(), ParseError> {
        let names = self.parse_id_list_block("tokens")?;
        for let name of names {
            virtual_tokens.push(name);
        }
        return Result::<(), ParseError>::Ok(());
    }

    fn extract_action(&mut self, open: u8, close: u8) -> ActionSource {
        let tok = self.peek();
        let start = tok.span.start;
        let end = scan_balanced(&self.src, start, open, close).unwrap_or(self.src.len());
        self.advance();
        while !self.at_eof() && self.tokens[self.pos].span.start < end {
            self.pos += 1;
        }
        let body_start = start + 1;
        let body_end = if end > start + 1 { end - 1 } else { start + 1 };
        return ActionSource {
            text: self.src.slice(body_start, body_end).to_string(),
            span: Span { start, end },
            action_id: -1,
        };
    }

    fn skip_angle_block(&mut self) {
        self.expect(G4Token::LAngle).unwrap();
        let mut depth = 1;
        while !self.at_eof() && depth > 0 {
            if self.is_kind(G4Token::LAngle) {
                depth += 1;
            } else if self.is_kind(G4Token::RAngle) {
                depth -= 1;
            }
            self.advance();
        }
    }

    fn parse_angle_options(&mut self) -> Result<List<GrammarOption>, ParseError> {
        let mut out: List<GrammarOption> = [];
        self.expect(G4Token::LAngle).unwrap();
        let mut depth = 1;
        while !self.at_eof() && depth > 0 {
            if self.is_kind(G4Token::RAngle) {
                depth -= 1;
                self.advance();
                continue;
            }
            if self.is_kind(G4Token::LAngle) {
                depth += 1;
                self.advance();
                continue;
            }
            if !self.is_kind(G4Token::Identifier) {
                self.advance();
                continue;
            }
            let name_tok = self.peek();
            let name = name_tok.text;
            self.advance();
            if !self.is_kind(G4Token::Assign) {
                while !self.at_eof() && !self.is_kind(G4Token::Comma) && !self.is_kind(G4Token::RAngle) {
                    self.advance();
                }
                if self.is_kind(G4Token::Comma) {
                    self.advance();
                }
                continue;
            }
            self.advance();
            let value_span = self.peek().span;
            let value = self.parse_option_value()?;
            if name == "assoc" {
                let mut valid = false;
                if let Ident(v) = &value {
                    if *v == "left" || *v == "right" {
                        valid = true;
                    }
                }
                if !valid {
                    return Result::<List<GrammarOption>, ParseError>::Err(
                        ParseError::new(
                            `invalid <assoc=...> value`,
                            value_span,
                            ["left", "right"],
                        ),
                    );
                }
            }
            out.push(GrammarOption { name, value });
            if self.is_kind(G4Token::Comma) {
                self.advance();
            }
        }
        return Result::<List<GrammarOption>, ParseError>::Ok(out);
    }

    fn parse_parser_rule<S: AsStrSlice>(&mut self, name: S) -> Result<ParserRule, ParseError> {
        let prequel = self.parse_rule_prequel()?;
        self.expect(G4Token::Colon)?;
        self.current_rule = name.to_string();
        let alternatives = self.parse_alternatives()?;
        self.current_rule = "";
        self.expect(G4Token::Semicolon)?;
        let mut rule = ParserRule::new(name, Visibility::Default, prequel.options, alternatives);
        rule.args = prequel.args;
        rule.returns_decls = prequel.returns_decls;
        rule.locals_decls = prequel.locals_decls;
        rule.throws = prequel.throws;
        rule.init_action = prequel.init_action;
        rule.after_action = prequel.after_action;
        return Result::<ParserRule, ParseError>::Ok(rule);
    }

    fn parse_rule_prequel(&mut self) -> Result<RulePrequel, ParseError> {
        let mut p = RulePrequel {};
        loop {
            if self.is_kind(G4Token::CharClass) {
                let act = self.extract_action(b'[', b']');
                for let d of parse_attr_decls(&act.text, act.span) {
                    p.args.push(d);
                }
                continue;
            }
            if self.is_kind(G4Token::Identifier) {
                let text = &self.peek().text;
                let is_returns = *text == "returns";
                let is_locals = *text == "locals";
                if is_returns || is_locals {
                    let what = if is_returns { "`[...]` after `returns`" } else { "`[...]` after `locals`" };
                    self.advance();
                    let act = self.expect_action(G4Token::CharClass, what)?;
                    for let d of parse_attr_decls(&act.text, act.span) {
                        if is_returns {
                            p.returns_decls.push(d);
                        } else {
                            p.locals_decls.push(d);
                        }
                    }
                    continue;
                }
                if *text == "throws" {
                    self.advance();
                    for let q of self.parse_qualified_id_list() {
                        p.throws.push(q);
                    }
                    continue;
                }
                if *text == "options" {
                    self.advance();
                    for let o of self.parse_options_block()? {
                        p.options.push(o);
                    }
                    continue;
                }
            }
            if self.is_kind(G4Token::At) {
                let act = self.parse_named_action();
                if act.name == "init" {
                    p.init_action = Option::<ActionSource>::Some(act.body);
                } else if act.name == "after" {
                    p.after_action = Option::<ActionSource>::Some(act.body);
                }
                continue;
            }
            break;
        }
        return Result::Ok(p);
    }

    /// An identifier and each `.ident` after it; a `.` not followed by an
    /// identifier is left unread. Peeking past a `Dot` stays in bounds, since
    /// the token stream ends in `Eof`.
    fn parse_dotted_name(&mut self) -> List<String> {
        let mut parts: List<String> = [self.expect(G4Token::Identifier).unwrap().text];
        while self.is_kind(G4Token::Dot) && self.tokens[self.pos + 1].kind == G4Token::Identifier.code() {
            self.advance();
            parts.push(self.advance().text);
        }
        return parts;
    }

    fn parse_qualified_id_list(&mut self) -> List<String> {
        let mut out: List<String> = [];
        loop {
            if !self.is_kind(G4Token::Identifier) {
                break;
            }
            out.push(self.parse_dotted_name().join("."));
            if self.is_kind(G4Token::Comma) {
                self.advance();
                continue;
            }
            break;
        }
        return out;
    }

    fn at_exception_clause(&self) -> bool {
        return self.is_kind(G4Token::Identifier) && (self.peek().text == "catch" || self.peek().text == "finally");
    }

    /// `catch [decl] { body }`, any number, then at most one `finally { body }`.
    fn parse_exception_group(&mut self) -> Result<ExceptionGroup, ParseError> {
        let mut g = ExceptionGroup {};
        while self.is_kind(G4Token::Identifier) && self.peek().text == "catch" {
            self.advance();
            let decl_text = self.expect_action(G4Token::CharClass, "`[...]` after `catch`")?.text;
            let body = self.expect_action(G4Token::LBrace, "`{...}` after `catch [...]`")?;
            g.catches.push(CatchClause { decl_text, body });
        }
        if self.is_kind(G4Token::Identifier) && self.peek().text == "finally" {
            self.advance();
            g.finally_action = Option::<ActionSource>::Some(
                self.expect_action(G4Token::LBrace, "`{...}` after `finally`")?,
            );
        }
        return Result::Ok(g);
    }

    /// The `[...]` or `{...}` block `kind` names, which the grammar requires here.
    fn expect_action<S: AsStrSlice>(&mut self, kind: G4Token, what: S) -> Result<ActionSource, ParseError> {
        if !self.is_kind(kind) {
            return Result::Err(ParseError::new(`expected ${what}`, self.peek().span, [what.to_string()]));
        }
        return Result::Ok(
            if kind matches { CharClass } { self.extract_action(b'[', b']') } else { self.extract_action(b'{', b'}') },
        );
    }

    fn parse_alternatives(&mut self) -> Result<List<Alternative>, ParseError> {
        let mut alts: List<Alternative> = [];
        let first = self.parse_alternative()?;
        alts.push(first);

        while self.is_kind(G4Token::Pipe) {
            self.advance();
            let alt = self.parse_alternative()?;
            alts.push(alt);
        }
        return Result::<List<Alternative>, ParseError>::Ok(alts);
    }

    fn capture_alt_action(&mut self, before_index: i32) -> AltAction {
        let source = self.extract_action(b'{', b'}');
        let mut kind = ActionKind::Action;
        if self.is_kind(G4Token::Question) {
            kind = ActionKind::Predicate;
            self.advance();
        }
        return AltAction { kind, source, before_index };
    }

    fn parse_alternative(&mut self) -> Result<Alternative, ParseError> {
        let mut elements: List<Element> = [];
        let mut options: List<GrammarOption> = [];
        let mut actions: List<AltAction> = [];
        let mut label: Option<String> = null;

        loop {
            if self.at_eof()
                || self.is_kind(G4Token::Pipe)
                || self.is_kind(G4Token::Semicolon)
                || self.is_kind(G4Token::RParen)
                || self.is_kind(G4Token::Hash) {
                break;
            }
            if self.is_kind(G4Token::LBrace) {
                actions.push(self.capture_alt_action(elements.len()));
                if self.is_kind(G4Token::LAngle) {
                    let opts = self.parse_angle_options()?;
                    for let o of opts {
                        options.push(o);
                    }
                }
                continue;
            }
            if self.is_kind(G4Token::LAngle) && elements.is_empty() {
                let mut opts = self.parse_angle_options()?;
                for let o of opts {
                    options.push(o);
                }
                continue;
            }
            let elem = self.parse_element()?;
            elements.push(elem);
        }

        if self.is_kind(G4Token::Hash) {
            self.advance();
            let label_tok = self.expect(G4Token::Identifier)?;
            label = Option::<String>::Some(label_tok.text);
        }

        return Result::<Alternative, ParseError>::Ok(Alternative { label, options, elements, actions });
    }

    fn parse_element(&mut self) -> Result<Element, ParseError> {
        let mut elem = self.parse_atom()?;
        elem = self.parse_postfix(elem)?;
        return Result::<Element, ParseError>::Ok(elem);
    }

    fn parse_atom(&mut self) -> Result<Element, ParseError> {
        if self.is_kind(G4Token::Identifier) {
            let tok = self.advance();
            let name = tok.text;
            let name_span = tok.span;
            if self.is_kind(G4Token::Assign) || self.is_kind(G4Token::PlusAssign) {
                let list = self.is_kind(G4Token::PlusAssign);
                self.advance();
                let inner = self.parse_atom()?;
                if let Group(g) = &inner {
                    if !is_labelable_set(g) {
                        let expected: List<String> = ["a set of terminals, or an atom"];
                        return Result::<Element, ParseError>::Err(
                            ParseError::new(
                                `label ${name} assigned to a block which is not a set`,
                                name_span,
                                expected,
                            ),
                        );
                    }
                }
                return Result::<Element, ParseError>::Ok(
                    Element::Label(LabelElement::new(name, list, inner)),
                );
            }
            let mut arg_action: Option<ActionSource> = null;
            if self.is_kind(G4Token::CharClass) {
                arg_action = Option::<ActionSource>::Some(self.extract_action(b'[', b']'));
            }
            let mut options: List<GrammarOption> = [];
            if self.is_kind(G4Token::LAngle) {
                options = self.parse_angle_options()?;
            }
            if is_lexer_rule_name(&name) {
                if let Some(arg) = &arg_action {
                    return Result::Err(
                        ParseError::new(`token reference ${name} takes no argument`, arg.span, ["a rule reference"]),
                    );
                }
                self.pending_refs.push(PendingRef {
                    kind: RefKind::TokenRef,
                    containing_rule: self.current_rule,
                    referenced_name: name,
                    span: name_span,
                });
                return Result::<Element, ParseError>::Ok(
                    Element::TokenRef(TokenRefElement::with_options(name, options)),
                );
            }
            self.pending_refs.push(PendingRef {
                kind: RefKind::ParserRuleRef,
                containing_rule: self.current_rule,
                referenced_name: name,
                span: name_span,
            });
            let mut rr = RuleRefElement::with_options(name, options);
            rr.arg_action = arg_action;
            return Result::<Element, ParseError>::Ok(Element::RuleRef(rr));
        }
        if self.is_kind(G4Token::StringLit) {
            let tok = self.advance();
            let text = tok.text;
            let mut options: List<GrammarOption> = [];
            if self.is_kind(G4Token::LAngle) {
                options = self.parse_angle_options()?;
            }
            return Result::<Element, ParseError>::Ok(
                Element::Literal(LiteralElement::with_options(text, options)),
            );
        }
        if self.is_kind(G4Token::LParen) {
            self.advance();
            let options = self.parse_block_prequel()?;
            let alternatives = self.parse_alternatives()?;
            self.expect(G4Token::RParen)?;
            return Result::<Element, ParseError>::Ok(
                Element::Group(GroupElement { alternatives, options }),
            );
        }
        if self.is_kind(G4Token::Dot) {
            self.advance();
            let mut options: List<GrammarOption> = [];
            if self.is_kind(G4Token::LAngle) {
                options = self.parse_angle_options()?;
            }
            return Result::<Element, ParseError>::Ok(
                Element::Wildcard(WildcardElement { options }),
            );
        }
        if self.is_kind(G4Token::Tilde) {
            let tilde_tok = self.peek();
            let tilde_span = tilde_tok.span;
            self.advance();
            let inner = self.parse_atom()?;
            if let Some(span) = not_set_code_span(&inner) {
                return Result::<Element, ParseError>::Err(not_set_code_error(span));
            }
            if !is_valid_not_set_element(&inner) {
                return Result::<Element, ParseError>::Err(
                    ParseError::new(
                        `\`~\` must be applied to a token reference, string literal, or parenthesised set — not a rule reference or wildcard`,
                        tilde_span,
                        ["TOKEN_REF", "STRING_LITERAL", "(set)"],
                    ),
                );
            }
            return Result::<Element, ParseError>::Ok(
                Element::Not(NotElement { element: inner }),
            );
        }
        let tok = self.peek();
        let expected: List<String> = ["identifier", "string", "(", ".", "~"];
        return Result::<Element, ParseError>::Err(
            ParseError::new(found_desc(tok), tok.span, expected),
        );
    }

    /// `options { ... }` and `@name { ... }` at the head of a block, closed by
    /// the `:` the jar requires after them.
    fn parse_block_prequel(&mut self) -> Result<List<GrammarOption>, ParseError> {
        let mut options: List<GrammarOption> = [];
        let mut consumed = false;
        loop {
            if self.is_kind(G4Token::Identifier) && self.peek().text == "options" {
                self.advance();
                for let o of self.parse_options_block()? {
                    options.push(o);
                }
                consumed = true;
                continue;
            }
            if self.is_kind(G4Token::At) {
                self.parse_named_action();
                consumed = true;
                continue;
            }
            break;
        }
        if consumed {
            self.expect(G4Token::Colon)?;
        }
        return Result::Ok(options);
    }

    fn parse_repeat_op(&mut self) -> Option<[RepeatKind, bool]> {
        let kind = if self.is_kind(G4Token::Star) {
            RepeatKind::Star;
        } else if self.is_kind(G4Token::Plus) {
            RepeatKind::Plus;
        } else if self.is_kind(G4Token::Question) {
            RepeatKind::Optional;
        } else {
            return null;
        };
        self.advance();
        let non_greedy = if self.is_kind(G4Token::Question) {
            self.advance();
            true;
        } else {
            false;
        };
        return Option::<[RepeatKind, bool]>::Some([kind, non_greedy]);
    }

    fn parse_postfix(&mut self, elem: Element) -> Result<Element, ParseError> {
        return match self.parse_repeat_op() {
            Some(rep) => Result::<Element, ParseError>::Ok(
                Element::Repeat(RepeatElement { kind: rep.0, element: elem, non_greedy: rep.1 }),
            ),
            None => Result::<Element, ParseError>::Ok(elem),
        };
    }

    fn parse_lexer_rule<S: AsStrSlice>(
        &mut self,
        name: S,
        is_fragment: bool,
        mode: i32,
        mode_names: &mut List<String>,
    ) -> Result<LexerRule, ParseError> {
        // Only `options` may stand between a lexer rule's name and its `:`.
        let mut options: List<GrammarOption> = [];
        if self.is_kind(G4Token::Identifier) && self.peek().text == "options" {
            self.advance();
            options = self.parse_options_block()?;
        }
        self.expect(G4Token::Colon)?;
        self.current_rule = name.to_string();
        let body = self.parse_lexer_alternatives()?;
        self.current_rule = "";

        let mut actions = LexerCommands::empty();
        if self.is_kind(G4Token::Arrow) {
            self.advance();
            self.parse_lexer_actions(&mut actions, mode_names)?;
        }

        self.expect(G4Token::Semicolon)?;
        return Result::<LexerRule, ParseError>::Ok(
            LexerRule {
                name: name.to_string(),
                visibility: Visibility::Default,
                is_fragment,
                skip: actions.skip,
                more: actions.more,
                type_override: actions.type_override,
                channel: actions.channel,
                mode,
                set_mode: actions.set_mode,
                push_mode: actions.push_mode,
                pop_mode: actions.pop_mode,
                is_virtual: false,
                options,
                body,
            },
        );
    }

    /// The `(<arg>)` of a lexer command that takes one. `allow_int` is for
    /// `type`, which ANTLR4 lets you give as a literal type number
    /// (`-> type(65535)`); a `mode` / `pushMode` argument names a declared
    /// mode, where a number means nothing.
    fn parse_lexer_command_arg<S: AsStrSlice>(&mut self, command: S, allow_int: bool) -> Result<String, ParseError> {
        self.expect(G4Token::LParen)?;
        let ok = self.is_kind(G4Token::Identifier) || allow_int && self.is_kind(G4Token::IntLit);
        if !ok {
            let tok = self.peek();
            let expected: List<String> = if allow_int { ["identifier", "int"] } else { ["identifier"] };
            return Result::<String, ParseError>::Err(
                ParseError::new(
                    `${found_desc(tok)} as the argument of \`${command}\``,
                    tok.span,
                    expected,
                ),
            );
        }
        let arg = self.advance().text;
        self.expect(G4Token::RParen)?;
        return Result::<String, ParseError>::Ok(arg);
    }

    /// A channel number that fits `i32`, or a channel name.
    fn parse_channel_arg(&mut self) -> Result<i32, ParseError> {
        if self.is_kind(G4Token::IntLit) {
            return Result::Ok(self.take_i32_literal()?);
        }
        let arg = self.expect(G4Token::Identifier)?;
        if arg.text == "DEFAULT_TOKEN_CHANNEL" {
            return Result::Ok(DEFAULT_CHANNEL);
        }
        if arg.text == "HIDDEN" {
            return Result::Ok(HIDDEN_CHANNEL);
        }
        for let mut i = 0; i < self.channels.len(); i += 1 {
            if self.channels[i] == arg.text {
                return Result::Ok(i + 2);
            }
        }
        let expected: List<String> = ["a channel declared in `channels { }`"];
        return Result::Err(
            ParseError::new(
                `channel "${arg.text}" is not declared in a \`channels { ... }\` block`,
                arg.span,
                expected,
            ),
        );
    }

    fn parse_lexer_actions(
        &mut self,
        actions: &mut LexerCommands,
        mode_names: &mut List<String>,
    ) -> Result<(), ParseError> {
        loop {
            if !self.is_kind(G4Token::Identifier) {
                let tok = self.peek();
                return Result::<(), ParseError>::Err(
                    ParseError::new(found_desc(tok), tok.span, LEXER_COMMAND_NAMES),
                );
            }
            let action_tok = self.advance();
            let action_span = action_tok.span;
            let action_name = action_tok.text;
            match action_name {
                "skip" => {
                    actions.skip = true;
                },
                "pushMode" => {
                    let mode_name = self.parse_lexer_command_arg("pushMode", false)?;
                    actions.push_mode = intern_mode(mode_names, &mode_name);
                },
                "popMode" => {
                    actions.pop_mode = true;
                },
                "mode" => {
                    let mode_name = self.parse_lexer_command_arg("mode", false)?;
                    actions.set_mode = intern_mode(mode_names, &mode_name);
                },
                "channel" => {
                    self.expect(G4Token::LParen)?;
                    actions.channel = self.parse_channel_arg()?;
                    self.expect(G4Token::RParen)?;
                },
                "type" => {
                    actions.type_override = Option::<String>::Some(
                        self.parse_lexer_command_arg("type", true)?,
                    );
                },
                "more" => {
                    actions.more = true;
                },
                _ => {
                    return Result::<(), ParseError>::Err(
                        ParseError::new(
                            `unknown lexer command "${action_name}"`,
                            action_span,
                            LEXER_COMMAND_NAMES,
                        ),
                    );
                },
            }
            if !self.is_kind(G4Token::Comma) {
                break;
            }
            self.advance();
        }
        return Result::<(), ParseError>::Ok(());
    }

    fn parse_lexer_alternatives(&mut self) -> Result<List<LexerAlternative>, ParseError> {
        let mut alts: List<LexerAlternative> = [];
        let first = self.parse_lexer_alt()?;
        alts.push(first);

        while self.is_kind(G4Token::Pipe) {
            self.advance();
            let alt = self.parse_lexer_alt()?;
            alts.push(alt);
        }
        return Result::<List<LexerAlternative>, ParseError>::Ok(alts);
    }

    fn parse_lexer_alt(&mut self) -> Result<LexerAlternative, ParseError> {
        let mut elements: List<LexerElement> = [];
        let mut actions: List<AltAction> = [];
        loop {
            if self.at_eof()
                || self.is_kind(G4Token::Pipe)
                || self.is_kind(G4Token::Semicolon)
                || self.is_kind(G4Token::RParen)
                || self.is_kind(G4Token::Arrow) {
                break;
            }
            if self.is_kind(G4Token::LBrace) {
                actions.push(self.capture_alt_action(elements.len()));
                continue;
            }
            if self.is_kind(G4Token::LAngle) {
                self.skip_angle_block();
                continue;
            }
            let elem = self.parse_lexer_element()?;
            elements.push(elem);
        }
        return Result::<LexerAlternative, ParseError>::Ok(LexerAlternative { elements, actions });
    }

    fn parse_lexer_element(&mut self) -> Result<LexerElement, ParseError> {
        let mut elem = self.parse_lexer_atom()?;
        elem = self.parse_lexer_postfix(elem)?;
        return Result::<LexerElement, ParseError>::Ok(elem);
    }

    fn parse_lexer_atom(&mut self) -> Result<LexerElement, ParseError> {
        if self.is_kind(G4Token::StringLit) {
            let tok = self.advance();
            let text = tok.text;
            let start_span = tok.span;
            if self.is_kind(G4Token::Range) {
                self.advance();
                let end_tok = self.expect(G4Token::StringLit)?;
                for let [endpoint, span] of [
                    [text, start_span],
                    [end_tok.text, end_tok.span],
                ] {
                    if endpoint.chars().count() != 1 {
                        let expected: List<String> = ["single-char string literal"];
                        return Result::<LexerElement, ParseError>::Err(
                            ParseError::new("range endpoint must be a single character", span, expected),
                        );
                    }
                }
                // From source, not the token text: that already collapsed an
                // unpaired surrogate escape to U+FFFD.
                let lo = string_literal_code_points(&self.src, start_span)[0];
                let hi = string_literal_code_points(&self.src, end_tok.span)[0];
                return Result::<LexerElement, ParseError>::Ok(scalar_char_range(lo, hi));
            }
            return Result::<LexerElement, ParseError>::Ok(LexerElement::Literal(text));
        }
        if self.is_kind(G4Token::CharClass) {
            let tok = self.advance();
            let cc = parse_char_class(&tok.text, tok.span)?;
            return Result::<LexerElement, ParseError>::Ok(LexerElement::CharClass(cc));
        }
        if self.is_kind(G4Token::Dot) {
            self.advance();
            return Result::<LexerElement, ParseError>::Ok(LexerElement::AnyChar);
        }
        if self.is_kind(G4Token::Identifier) {
            let tok = self.advance();
            let name = tok.text;
            let span = tok.span;
            self.pending_refs.push(PendingRef {
                kind: RefKind::LexerRuleRef,
                containing_rule: self.current_rule,
                referenced_name: name,
                span,
            });
            return Result::<LexerElement, ParseError>::Ok(LexerElement::RuleRef(name));
        }
        if self.is_kind(G4Token::LParen) {
            self.advance();
            let alts = self.parse_lexer_alternatives()?;
            self.expect(G4Token::RParen)?;
            return Result::<LexerElement, ParseError>::Ok(LexerElement::Group(alts));
        }
        if self.is_kind(G4Token::Tilde) {
            let tilde_span = self.peek().span;
            self.advance();
            let inner = self.parse_lexer_atom()?;
            if let Some(span) = lexer_not_set_code_span(&inner) {
                return Result::<LexerElement, ParseError>::Err(not_set_code_error(span));
            }
            if !is_valid_lexer_not_element(&inner) {
                let expected: List<String> = ["single char, char set, or block of them"];
                return Result::<LexerElement, ParseError>::Err(
                    ParseError::new(
                        "`~` in a lexer rule must be applied to a single character, a char set, or a parenthesised set — not a rule reference, wildcard, or multi-char literal",
                        tilde_span,
                        expected,
                    ),
                );
            }
            return Result::<LexerElement, ParseError>::Ok(
                LexerElement::Not(LexerNotElement { element: inner }),
            );
        }
        let tok = self.peek();
        let expected: List<String> = ["string", "char-class", "identifier", "(", "~", "."];
        return Result::<LexerElement, ParseError>::Err(
            ParseError::new(`${found_desc(tok)} in a lexer rule`, tok.span, expected),
        );
    }

    fn parse_lexer_postfix(&mut self, elem: LexerElement) -> Result<LexerElement, ParseError> {
        return match self.parse_repeat_op() {
            Some(rep) => Result::<LexerElement, ParseError>::Ok(
                LexerElement::Repeat(LexerRepeatElement { kind: rep.0, element: elem, non_greedy: rep.1 }),
            ),
            None => Result::<LexerElement, ParseError>::Ok(elem),
        };
    }
}

fn advance_char(src: &StrSlice, pos: &mut i32) -> char {
    let c = char_at(src, *pos);
    *pos = src.ceil_char_boundary(*pos + 1);
    return c;
}

/// Code point of the next char-set item, escapes resolved, or
/// `INVALID_ESCAPE`. Surrogates come back verbatim, for `clip_to_scalars`.
fn resolve_char_code(src: &StrSlice, pos: &mut i32) -> i32 {
    let c = advance_char(src, pos);
    if c != '\\' {
        return c as i32;
    }
    let ec = advance_char(src, pos);
    return match ec {
        'u' => resolve_unicode_escape_code(src, pos),
        '-' | ']' => ec as i32,
        _ => decode_shared_escape(ec),
    };
}

/// True when `\p{` / `\P{` opens at `pos`, inside a class ending at `end`.
fn at_property_escape(src: &StrSlice, pos: i32, end: i32) -> bool {
    return pos + 2 < end
        && src.byte_at(pos) == b'\\'
        && src.byte_at(pos + 1) matches { b'p' | b'P' }
        && src.byte_at(pos + 2) == b'{';
}

/// True when the `-` at `pos` joins two bounds rather than standing for
/// itself. A `-` last in the set has nothing to its right, so it is an
/// ordinary character — the line ANTLR4 draws too (`[\p{Nd}-]` is fine).
fn opens_char_range(src: &StrSlice, pos: i32, end: i32) -> bool {
    return pos + 1 < end && src.byte_at(pos) == b'-';
}

/// The error for a `\p{...}` used as a range bound. ANTLR4 reports the same
/// shape (`error(182)`); there is no range from one property to another, so
/// accepting it would mean inventing a meaning for it.
fn property_range_error(span: Span) -> ParseError {
    let expected: List<String> = ["a single character"];
    return ParseError::new(
        "a Unicode property escape cannot be a bound of a character range",
        span,
        expected,
    );
}

/// The next char-set item, or the `error(156)` ANTLR4 reports for an escape
/// the lexicon does not define. `class_span` places the error in the source.
fn take_char_code(src: &StrSlice, pos: &mut i32, class_span: Span) -> Result<i32, ParseError> {
    let start = *pos;
    let code = resolve_char_code(src, pos);
    if code != INVALID_ESCAPE {
        return Result::<i32, ParseError>::Ok(code);
    }
    let expected: List<String> = ["a defined escape sequence"];
    return Result::<i32, ParseError>::Err(
        ParseError::new(
            `invalid escape sequence ${src.slice(start, *pos)}`,
            Span::new(class_span.start + start, class_span.start + *pos),
            expected,
        ),
    );
}

fn parse_char_class<S: AsStrSlice>(text: S, span: Span) -> Result<CharClass, ParseError> {
    let src = text.as_str_slice();
    let end = src.len() - 1;
    let mut pos = 1;
    let mut ranges: List<CharRange> = [];

    while pos < end {
        if at_property_escape(&src, pos, end) {
            let complement = src.byte_at(pos + 1) == b'P';
            let start = pos;
            pos += 3;
            while pos < end && src.byte_at(pos) != b'}' {
                pos += 1;
            }
            if pos == end {
                let expected: List<String> = ["`}` closing the property"];
                return Result::Err(
                    ParseError::new(
                        `invalid escape sequence ${src.slice(start, end)}`,
                        Span::new(span.start + start, span.start + end),
                        expected,
                    ),
                );
            }
            let prop = src.slice(start + 3, pos).to_string();
            pos += 1;
            let mut prop_ranges: List<CharRange> = [];
            if !expand_unicode_property(&prop, &mut prop_ranges) {
                let expected: List<String> = ["a supported Unicode property"];
                return Result::<CharClass, ParseError>::Err(
                    ParseError::new(unsupported_property_message(&prop), span, expected),
                );
            }
            if opens_char_range(&src, pos, end) {
                return Result::<CharClass, ParseError>::Err(property_range_error(span));
            }
            let items = if complement { complement_char_ranges(&prop_ranges) } else { prop_ranges };
            for let r of &items {
                ranges.push(*r);
            }
            continue;
        }

        let c = take_char_code(&src, &mut pos, span)?;
        if opens_char_range(&src, pos, end) {
            pos += 1;
            if at_property_escape(&src, pos, end) {
                return Result::<CharClass, ParseError>::Err(property_range_error(span));
            }
            let c2 = take_char_code(&src, &mut pos, span)?;
            clip_to_scalars(&mut ranges, c, c2);
        } else {
            clip_to_scalars(&mut ranges, c, c);
        }
    }

    return Result::<CharClass, ParseError>::Ok(CharClass { ranges, negated: false });
}

/// `'lo'..'hi'` restricted to the Unicode scalars. A range holding no
/// surrogates keeps the plain `CharRange` shape, so grammars that stay inside
/// the scalars are unchanged.
fn scalar_char_range(lo: i32, hi: i32) -> LexerElement {
    let mut ranges: List<CharRange> = [];
    clip_to_scalars(&mut ranges, lo, hi);
    if ranges.len() == 1 && ranges[0].start as i32 == lo && ranges[0].end as i32 == hi {
        return LexerElement::CharRange([ranges[0].start, ranges[0].end]);
    }
    return LexerElement::CharClass(CharClass { ranges, negated: false });
}

fn intern_mode(mode_names: &mut List<String>, name: &String) -> i32 {
    for let mut i = 0; i < mode_names.len(); i += 1 {
        if mode_names[i] == name.as_str_slice() {
            return i;
        }
    }
    mode_names.push(name.to_string());
    return mode_names.len() - 1;
}

fn action_language_from_options(options: &List<GrammarOption>) -> ActionLanguage {
    for let opt of options {
        if opt.name == "language" {
            let name = match &opt.value {
                Ident(v) | Str(v) => Option::<String>::Some(*v),
                Qualified(_) | Int(_) | Action(_) => null,
            };
            if let Some(v) = name {
                if v.eq_ignore_ascii_case("java") {
                    return ActionLanguage::Java;
                }
                if v.eq_ignore_ascii_case("wado") {
                    return ActionLanguage::Wado;
                }
                return ActionLanguage::Other(v);
            }
        }
    }
    return ActionLanguage::Java;
}

struct ExceptionGroup {
    catches: List<CatchClause> = [],
    finally_action: Option<ActionSource> = null,
}

struct RulePrequel {
    options: List<GrammarOption> = [],
    args: List<AttrDecl> = [],
    returns_decls: List<AttrDecl> = [],
    locals_decls: List<AttrDecl> = [],
    throws: List<String> = [],
    init_action: Option<ActionSource> = null,
    after_action: Option<ActionSource> = null,
}

fn parse_attr_decls<S: AsStrSlice>(body: S, list_span: Span) -> List<AttrDecl> {
    let mut out: List<AttrDecl> = [];
    for let seg of &split_top_level_commas(&body.as_str_slice(), true) {
        if let Some(d) = split_attr_decl(seg, list_span) {
            out.push(d);
        }
    }
    return out;
}

fn split_attr_decl<S: AsStrSlice>(seg: S, span: Span) -> Option<AttrDecl> {
    let src = seg.as_str_slice();
    let full = src.len();
    let mut n = full;
    for let mut k = 0; k < full; k += 1 {
        if src.byte_at(k) == b'=' {
            let prev_cmp = k > 0 && src.byte_at(k - 1) matches { b'!' | b'<' | b'>' | b'=' };
            let next_eq = k + 1 < full && src.byte_at(k + 1) == b'=';
            if !prev_cmp && !next_eq {
                n = k;
                break;
            }
        }
    }
    let mut end = n;
    while end > 0 && src.byte_at(end - 1).is_ascii_whitespace() {
        end -= 1;
    }
    if end == 0 {
        return null;
    }
    let name_start = ident_start(&src, end);
    let name = src.slice(name_start, end).to_string();
    let mut type_end = name_start;
    while type_end > 0 && src.byte_at(type_end - 1).is_ascii_whitespace() {
        type_end -= 1;
    }
    let type_text = src.slice(skip_ws(&src, 0, type_end), type_end).to_string();
    return Option::<AttrDecl>::Some(AttrDecl { type_text, name, span });
}

pub fn parse<S: AsStrSlice>(input: S) -> Result<Grammar, ParseError> {
    let src = input.as_str_slice();
    let tokens = tokenize(&src);
    let mut parser = G4Parser::new(tokens, src);
    return parser.parse_grammar();
}

/// The post-parse pipeline every entry point runs: implicit-token synthesis
/// followed by the whole-grammar checks. One definition so a new check cannot
/// reach `assemble_grammar` and miss `parse_checked`.
fn finish_grammar(grammar: &mut Grammar) -> Result<(), ParseError> {
    synthesize_implicit_tokens(grammar);
    check_references(grammar)?;
    check_rule_shapes(grammar)?;
    return Result::Ok(());
}

#[allow(dead_code)]
pub fn parse_checked<S: AsStrSlice>(input: S) -> Result<Grammar, ParseError> {
    let grammars: List<Grammar> = [parse(input)?];
    if let Err([_, e]) = check_admission(&grammars) {
        return Result::Err(e);
    }
    let mut grammar = grammars[0];
    finish_grammar(&mut grammar)?;
    return Result::<Grammar, ParseError>::Ok(grammar);
}

/// What the jar refuses per input before composing, with the offending input's
/// index: a lexer or parser grammar importing another kind, and a rule its own
/// header forbids. Every rule lands under the root's kind, so a grammar a
/// combined one reaches through imports is exempt from the second.
fn check_admission(grammars: &List<Grammar>) -> Result<(), [i32, ParseError]> {
    let mut under_combined: List<String> = [];
    for let g of grammars {
        if g.kind matches { Combined } {
            mark_imports(&g.imports, grammars, &mut under_combined);
        }
    }
    for let mut i = 0; i < grammars.len(); i += 1 {
        let g = &grammars[i];
        if !g.kind matches { Combined } {
            for let name of &g.imports {
                if let Some(d) = grammars.iter_ref().find(|d| d.name == *name) && d.kind != g.kind {
                    let msg = `${kind_word(&g.kind)} grammar ${g.name} cannot import ${kind_word(&d.kind)} grammar ${d.name}`;
                    return Result::Err([i, ParseError::new(msg, Span::new(0, 0), ["a grammar of the same kind"])]);
                }
            }
        }
        if let Some(e) = &g.misplaced_rule && !under_combined.contains(&g.name) {
            return Result::Err([i, *e]);
        }
    }
    return Result::Ok(());
}

fn mark_imports(imports: &List<String>, grammars: &List<Grammar>, marked: &mut List<String>) {
    for let name of imports {
        if marked.contains(name) {
            continue;
        }
        marked.push(*name);
        if let Some(d) = grammars.iter_ref().find(|d| d.name == *name) {
            mark_imports(&d.imports, grammars, marked);
        }
    }
}

fn kind_word(kind: &GrammarKind) -> String {
    return match kind {
        Combined => "combined",
        Lexer => "lexer",
        Parser => "parser",
    };
}

pub variant AssembleError {
    Parse([String, String]),
    Check(String),
}

pub fn assemble_grammar(inputs: &List<[String, String]>) -> Result<Grammar, AssembleError> {
    let mut grammars: List<Grammar> = [];
    for let inp of inputs {
        match parse(inp.1) {
            Ok(mut g) => {
                g.source_files.push(inp.0);
                grammars.push(g);
            },
            Err(e) => {
                return Result::Err(AssembleError::Parse([inp.0, e.full_message()]));
            },
        }
    }
    if let Err([i, e]) = check_admission(&grammars) {
        return Result::Err(AssembleError::Parse([grammars[i].source_files[0], e.full_message()]));
    }
    let mut merged = match compose_grammars(grammars) {
        Ok(g) => g,
        Err(e) => {
            return Result::Err(AssembleError::Check(e.full_message()));
        },
    };
    match finish_grammar(&mut merged) {
        Ok(_) => {
        },
        Err(e) => {
            return Result::Err(AssembleError::Check(e.full_message()));
        },
    }
    return Result::Ok(merged);
}
