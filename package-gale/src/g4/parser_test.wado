test "parser rule with element options" {
    let input = "grammar Test;
expr : ID<assoc=right> ;";
    let g = parse(input).unwrap();
    assert g.parser_rules[0].alternatives[0].elements.len() == 1;
}

test "parser rule with block options" {
    // ANTLR4 allows `options{}` inside a parenthesized block.
    let input = "grammar Test;
expr : ( options { greedy = false; } : ID | NUM ) ;";
    let g = parse(input).unwrap();
    assert g.parser_rules.len() == 1;
}

test "parser rule with epsilon alternative" {
    // Empty alternative — ANTLR4 allows `| /* nothing */`.
    let input = "grammar Test;
opt : ID | ;";
    let g = parse(input).unwrap();
    assert g.parser_rules[0].alternatives.len() == 2;
    assert g.parser_rules[0].alternatives[1].elements.is_empty();
}

test "mixed parser and lexer rules" {
    let input = "grammar JSON;
json : value EOF ;
value : STRING | NUMBER ;
STRING : '\"' SAFE* '\"' ;
fragment SAFE : [a-z] ;
WS : [ \\t\\n\\r]+ -> skip ;";
    let g = parse(input).unwrap();
    assert g.name == "JSON";
    assert g.parser_rules.len() == 2;
    assert g.lexer_rules.len() == 3;
    assert g.lexer_rules[1].is_fragment == true;
    assert g.lexer_rules[2].skip == true;
}

test "lexer command mode switches current mode" {
    // `mode(X)` switches the current mode (top of stack), unlike pushMode.
    // Spec: vendor/antlr4/doc/lexer-rules.md "mode(), pushMode(), popMode, and more".
    let input = "lexer grammar Test;
LQUOTE : '\"' -> more, mode(STR) ;
mode STR;
STRING : '\"' -> mode(DEFAULT_MODE) ;";
    let g = parse(input).unwrap();
    assert g.lexer_rules.len() == 2;
    // First rule lives in default mode and switches to STR
    assert g.lexer_rules[0].name == "LQUOTE";
    assert g.lexer_rules[0].mode == 0;
    assert g.lexer_rules[0].set_mode != -1;
    assert g.mode_names[g.lexer_rules[0].set_mode as i32] == "STR";
    assert g.lexer_rules[0].more == true;
    // Second rule lives in STR mode and switches back to DEFAULT_MODE
    assert g.lexer_rules[1].name == "STRING";
    assert g.lexer_rules[1].mode == 1;
    assert g.mode_names[g.lexer_rules[1].mode as i32] == "STR";
    assert g.lexer_rules[1].set_mode == 0;
}

test "lexer command channel with integer literal" {
    // ANTLR4 allows `channel(N)` with an integer literal, e.g. `channel(2)`.
    let input = "lexer grammar Test;
COMMENT : '#' ~[\\r\\n]* -> channel(2) ;";
    let g = parse(input).unwrap();
    assert g.lexer_rules.len() == 1;
    assert g.lexer_rules[0].channel == 2;
}

test "lexer command channel with HIDDEN" {
    let input = "lexer grammar Test;
WS : [ \\t]+ -> channel(HIDDEN) ;";
    let g = parse(input).unwrap();
    assert g.lexer_rules.len() == 1;
    // HIDDEN is the predefined channel id 1.
    assert g.lexer_rules[0].channel == 1;
}

test "lexer command type override" {
    // `type(X)` rewrites the emitted token type. Useful for unifying alts.
    let input = "lexer grammar SetType;
DOUBLE : '\"' .*? '\"' -> type(STRING) ;
SINGLE : '\\'' .*? '\\'' -> type(STRING) ;";
    let g = parse(input).unwrap();
    assert g.lexer_rules.len() == 2;
    if let Some(t) = &g.lexer_rules[0].type_override {
        assert *t == "STRING";
    } else {
        panic("expected type_override on DOUBLE");
    }
    if let Some(t) = &g.lexer_rules[1].type_override {
        assert *t == "STRING";
    } else {
        panic("expected type_override on SINGLE");
    }
}

test "lexer command more sets more flag" {
    let input = "lexer grammar Test;
TEXT : . -> more ;";
    let g = parse(input).unwrap();
    assert g.lexer_rules.len() == 1;
    assert g.lexer_rules[0].more == true;
    assert g.lexer_rules[0].skip == false;
}

test "lexer command combo with mode and more" {
    // ANTLR4 allows multiple commands separated by commas.
    let input = "lexer grammar Test;
SPECIAL_OPEN : '<?' -> more, pushMode(PROC) ;
mode PROC;
INSIDE : 'x' -> more ;";
    let g = parse(input).unwrap();
    assert g.lexer_rules.len() == 2;
    assert g.lexer_rules[0].more == true;
    assert g.lexer_rules[0].push_mode != -1;
    assert g.mode_names[g.lexer_rules[0].push_mode as i32] == "PROC";
    assert g.lexer_rules[1].more == true;
    assert g.lexer_rules[1].mode == 1;
}
