test "parser rule with block options" {
    // ANTLR4 allows `options{}` inside a parenthesized block.
    let input = "grammar Test;
expr : ( options { greedy = false; } : ID | NUM ) ;";
    let g = parse(input).unwrap();
    assert g.parser_rules.len() == 1;
}

test "parser rule with epsilon alternative" {
    // Empty alternative — ANTLR4 allows `| /* nothing */`.
    let input = "grammar Test;
opt : ID | ;";
    let g = parse(input).unwrap();
    assert g.parser_rules[0].alternatives.len() == 2;
    assert g.parser_rules[0].alternatives[1].elements.is_empty();
}

test "mixed parser and lexer rules" {
    let input = "grammar JSON;
json : value EOF ;
value : STRING | NUMBER ;
STRING : '\"' SAFE* '\"' ;
fragment SAFE : [a-z] ;
WS : [ \\t\\n\\r]+ -> skip ;";
    let g = parse(input).unwrap();
    assert g.name == "JSON";
    assert g.parser_rules.len() == 2;
    assert g.lexer_rules.len() == 3;
    assert g.lexer_rules[1].is_fragment == true;
    assert g.lexer_rules[2].skip == true;
}

test "lexer command mode switches current mode" {
    // `mode(X)` switches the current mode (top of stack), unlike pushMode.
    // Spec: vendor/antlr4/doc/lexer-rules.md "mode(), pushMode(), popMode, and more".
    let input = "lexer grammar Test;
LQUOTE : '\"' -> more, mode(STR) ;
mode STR;
STRING : '\"' -> mode(DEFAULT_MODE) ;";
    let g = parse(input).unwrap();
    assert g.lexer_rules.len() == 2;
    // First rule lives in default mode and switches to STR
    assert g.lexer_rules[0].name == "LQUOTE";
    assert g.lexer_rules[0].mode == 0;
    assert g.lexer_rules[0].set_mode != -1;
    assert g.mode_names[g.lexer_rules[0].set_mode as i32] == "STR";
    assert g.lexer_rules[0].more == true;
    // Second rule lives in STR mode and switches back to DEFAULT_MODE
    assert g.lexer_rules[1].name == "STRING";
    assert g.lexer_rules[1].mode == 1;
    assert g.mode_names[g.lexer_rules[1].mode as i32] == "STR";
    assert g.lexer_rules[1].set_mode == 0;
}

test "lexer command channel with integer literal" {
    // ANTLR4 allows `channel(N)` with an integer literal, e.g. `channel(2)`.
    let input = "lexer grammar Test;
COMMENT : '#' ~[\\r\\n]* -> channel(2) ;";
    let g = parse(input).unwrap();
    assert g.lexer_rules.len() == 1;
    assert g.lexer_rules[0].channel == 2;
}

test "lexer command channel with HIDDEN" {
    let input = "lexer grammar Test;
WS : [ \\t]+ -> channel(HIDDEN) ;";
    let g = parse(input).unwrap();
    assert g.lexer_rules.len() == 1;
    // HIDDEN is the predefined channel id 1. ANTLR4 emits HIDDEN tokens on
    // a separate channel — they are NOT discarded, so `skip` must remain
    // false.
    assert g.lexer_rules[0].channel == 1;
    assert g.lexer_rules[0].skip == false;
}

test "lexer command type override" {
    // `type(X)` rewrites the emitted token type. Useful for unifying alts.
    let input = "lexer grammar SetType;
DOUBLE : '\"' .*? '\"' -> type(STRING) ;
SINGLE : '\\'' .*? '\\'' -> type(STRING) ;";
    let g = parse(input).unwrap();
    assert g.lexer_rules.len() == 2;
    if let Some(t) = &g.lexer_rules[0].type_override {
        assert *t == "STRING";
    } else {
        panic("expected type_override on DOUBLE");
    }
    if let Some(t) = &g.lexer_rules[1].type_override {
        assert *t == "STRING";
    } else {
        panic("expected type_override on SINGLE");
    }
}

test "lexer command more sets more flag" {
    let input = "lexer grammar Test;
TEXT : . -> more ;";
    let g = parse(input).unwrap();
    assert g.lexer_rules.len() == 1;
    assert g.lexer_rules[0].more == true;
    assert g.lexer_rules[0].skip == false;
}

test "lexer command combo with mode and more" {
    // ANTLR4 allows multiple commands separated by commas.
    let input = "lexer grammar Test;
SPECIAL_OPEN : '<?' -> more, pushMode(PROC) ;
mode PROC;
INSIDE : 'x' -> more ;";
    let g = parse(input).unwrap();
    assert g.lexer_rules.len() == 2;
    assert g.lexer_rules[0].more == true;
    assert g.lexer_rules[0].push_mode != -1;
    assert g.mode_names[g.lexer_rules[0].push_mode as i32] == "PROC";
    assert g.lexer_rules[1].more == true;
    assert g.lexer_rules[1].mode == 1;
}

test "ARG_ACTION supports nested brackets in returns" {
    // ANTLR4 ARG_ACTION is host-language code; nested `[]` (e.g. Java
    // array types like `int[]`) must not terminate the action early.
    let input = "grammar Test;
expr returns [int[] arr] : ID ;";
    let g = parse(input).unwrap();
    assert g.parser_rules.len() == 1;
    assert g.parser_rules[0].name == "expr";
}

test "ARG_ACTION supports nested brackets in rule arguments" {
    let input = "grammar Test;
expr[int[] xs, String[] names] : ID ;";
    let g = parse(input).unwrap();
    assert g.parser_rules.len() == 1;
    assert g.parser_rules[0].name == "expr";
}

test "ARG_ACTION supports nested brackets in locals" {
    let input = "grammar Test;
expr locals [int[] xs] : ID ;";
    let g = parse(input).unwrap();
    assert g.parser_rules.len() == 1;
}

test "ARG_ACTION supports nested brackets in catch" {
    let input = "grammar Test;
expr : ID ; catch [Exception[] es] { handle(es); }";
    let g = parse(input).unwrap();
    assert g.parser_rules.len() == 1;
}

test "ARG_ACTION supports nested brackets in rule ref" {
    let input = "grammar Test;
expr : sub[arr[0], xs[1]] ;";
    let g = parse(input).unwrap();
    let elems = &g.parser_rules[0].alternatives[0].elements;
    assert elems.len() == 1;
    if let RuleRef(name) = elems[0] {
        assert name == "sub";
    } else {
        panic("expected RuleRef sub");
    }
}

test "action body with brace inside string literal" {
    // ANTLR4 actions are host-language code, so a `}` inside a string
    // literal must NOT terminate the action block.
    let input = "grammar Test;
@header { String s = \"a } b\"; }
expr : ID ;";
    let g = parse(input).unwrap();
    assert g.parser_rules.len() == 1;
    assert g.parser_rules[0].name == "expr";
}

test "action body with brace inside char literal" {
    let input = "grammar Test;
@header { char c = '}'; }
expr : ID ;";
    let g = parse(input).unwrap();
    assert g.parser_rules.len() == 1;
}

test "action body with brace inside line comment" {
    let input = "grammar Test;
@header { // close brace } in comment
int x = 0; }
expr : ID ;";
    let g = parse(input).unwrap();
    assert g.parser_rules.len() == 1;
}

test "action body with brace inside block comment" {
    let input = "grammar Test;
@header { /* close brace } in block */ int x = 0; }
expr : ID ;";
    let g = parse(input).unwrap();
    assert g.parser_rules.len() == 1;
}

test "mode declaration is rejected in parser grammar" {
    // ANTLR4 only allows `mode X;` in lexer grammars (combined or split lexer).
    // Spec: vendor/antlr4/tool/src/org/antlr/v4/parse/ANTLRParser.g — mode rules
    // appear only under lexerRule branches.
    let input = "parser grammar Test;
mode FOO;
expr : ID ;";
    let result = parse(input);
    assert result matches { Err(_) }, "expected mode in parser grammar to be rejected";
}

test "parser rule tilde applied to block" {
    // ANTLR4 allows `~` on a set expressed as a block of alternatives, not
    // just a single token reference: `~( 'a' | 'b' | 'c' )`.
    // Spec: vendor/antlr4/doc/parser-rules.md (set complement).
    let input = "grammar Test;
noise : ~( 'a' | 'b' | 'c' ) ;";
    let g = parse(input).unwrap();
    assert g.parser_rules.len() == 1;
    let elems = &g.parser_rules[0].alternatives[0].elements;
    assert elems.len() == 1;
    if let Not(n) = &elems[0] {
        if let Group(alts) = &n.element {
            assert alts.len() == 3;
        } else {
            panic("expected Group inside Not");
        }
    } else {
        panic("expected Not element");
    }
}

test "lexer rule tilde applied to block" {
    // Same as the parser case, but for lexer rules where `~` may wrap a set
    // of char classes / literals: `~( 'a' | [0-9] )`.
    let input = "lexer grammar Test;
NON_AB : ~( 'a' | 'b' ) ;";
    let g = parse(input).unwrap();
    assert g.lexer_rules.len() == 1;
    let rule = &g.lexer_rules[0];
    let elems = &rule.body[0].elements;
    assert elems.len() == 1;
    if let Not(n) = &elems[0] {
        if let Group(_) = &n.element {
            // ok
        } else {
            panic("expected Group inside LexerElement::Not");
        }
    } else {
        panic("expected LexerElement::Not");
    }
}

test "block label single-value" {
    // ANTLR4 allows labels on blocks, not just single atoms:
    //   lbl = ( 'a' | 'b' )
    let input = "grammar Test;
expr : op = ( '+' | '-' ) ;";
    let g = parse(input).unwrap();
    let elems = &g.parser_rules[0].alternatives[0].elements;
    assert elems.len() == 1;
    if let Label(l) = &elems[0] {
        assert l.name == "op";
        assert l.list == false;
        if let Group(_) = &l.element {
            // ok
        } else {
            panic("expected Group inside Label");
        }
    } else {
        panic("expected Label element");
    }
}

test "block label list" {
    // `+=` form of block label: collect each match into an Array.
    let input = "grammar Test;
expr : ops += ( '+' | '-' )* ;";
    let g = parse(input).unwrap();
    let elems = &g.parser_rules[0].alternatives[0].elements;
    assert elems.len() == 1;
    // The top-level element is a Repeat (because of the `*`) whose inner
    // element is the Label.
    if let Repeat(r) = &elems[0] {
        if let Label(l) = &r.element {
            assert l.name == "ops";
            assert l.list == true;
            if let Group(_) = &l.element {
                // ok
            } else {
                panic("expected Group inside Label");
            }
        } else {
            panic("expected Label inside Repeat");
        }
    } else {
        panic("expected Repeat at top level");
    }
}

test "arg action with only whitespace" {
    // ANTLR4 accepts an empty/whitespace-only ARG_ACTION: `returns [ ]`.
    // Gale discards the body, but the surrounding structure must still
    // parse.
    let input = "grammar Test;
expr returns [ ] : ID ;";
    let g = parse(input).unwrap();
    assert g.parser_rules.len() == 1;
    assert g.parser_rules[0].name == "expr";
}

test "empty arg action on rule arguments" {
    // Same for bare rule arguments: `rule[] : ...`.
    let input = "grammar Test;
expr [ ] : ID ;";
    let g = parse(input).unwrap();
    assert g.parser_rules.len() == 1;
    assert g.parser_rules[0].name == "expr";
}

test "tokens block with numbered assignments" {
    // ANTLR3 allowed `tokens { NAME = 1, OTHER = 2 }`. ANTLR4's grammar
    // rejects the assignment syntax, but real-world `.g4` files that were
    // ported without cleanup still contain it. Gale's compatibility
    // principle is lenient — we accept (and ignore) the `= INT` suffix so
    // the rest of the grammar still parses, rather than erroring out.
    let input = "grammar Test;
tokens { FOO = 1, BAR = 2 }
expr : ID ;";
    let g = parse(input).unwrap();
    assert g.parser_rules.len() == 1;
    // Both virtual tokens must still be registered on the lexer side, with
    // their original names.
    let mut saw_foo = false;
    let mut saw_bar = false;
    for let r of &g.lexer_rules {
        if r.name == "FOO" && r.is_virtual { saw_foo = true; }
        if r.name == "BAR" && r.is_virtual { saw_bar = true; }
    }
    assert saw_foo, "tokens{} block must still register FOO as virtual token";
    assert saw_bar, "tokens{} block must still register BAR as virtual token";
}
