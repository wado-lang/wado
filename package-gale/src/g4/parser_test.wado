test "parser rule with catch clause" {
    let input = "grammar Test;
expr : ID ; catch [Exception e] { handle(e); }";
    let g = parse(input).unwrap();
    assert g.parser_rules.len() == 1;
}

test "parser rule with finally clause" {
    let input = "grammar Test;
expr : ID ; finally { cleanup(); }";
    let g = parse(input).unwrap();
    assert g.parser_rules.len() == 1;
}

test "parser rule with catch and finally" {
    let input = "grammar Test;
expr : ID ; catch [E1 e] { h1(e); } catch [E2 e] { h2(e); } finally { done(); }";
    let g = parse(input).unwrap();
    assert g.parser_rules.len() == 1;
}

test "lexer rule with locals" {
    let input = "grammar Test;
INT locals [int n] : [0-9]+ ;";
    let g = parse(input).unwrap();
    assert g.lexer_rules.len() == 1;
    assert g.lexer_rules[0].name == "INT";
}

test "private rule modifier" {
    // ANTLR4 supports `public`, `private`, `protected`, `fragment` rule modifiers.
    let input = "grammar Test;
public expr : ID ;
private nested : ID ;
protected helper : ID ;";
    let g = parse(input).unwrap();
    assert g.parser_rules.len() == 3;
}

