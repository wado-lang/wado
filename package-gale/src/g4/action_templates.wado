//! StringTemplate-helper expansion for ANTLR4 testsuite grammars.
//!
//! The upstream `runtime-testsuite/` descriptors write action bodies and
//! semantic predicates in a target-agnostic helper vocabulary
//! (`<writeln("$e.v")>`, `<True()>`, ...) that the upstream test harness
//! expands per target language. Gale's descriptor extractor calls
//! `expand_action_templates` to bake the **Java-target** expansion into the
//! extracted `.g4`, so the committed corpus carries real host-language
//! action bodies instead of testsuite-only notation. Downstream consumers
//! (the future Stage C action pipeline, the Stage B' oracle stripper) then
//! never see StringTemplate syntax.
//!
//! Expansion semantics were derived clean-room: from the helper names, the
//! descriptors' observed `[input]`/`[output]` pairs, and the *public* ANTLR4
//! Java runtime API — never from the upstream `.stg` template definitions or
//! runtime implementation source (License hygiene, package AGENTS.md). If a
//! future jar-oracle run shows an expansion diverging from upstream
//! behaviour, fix the table in `expand_helper` and regenerate the corpus
//! via `mise run extract-gale-descriptors` (a table change cannot be
//! re-applied in place — see `scripts/expand_action_templates_in_place.wado`).
//!
//! Template reference syntax handled here (the subset the corpus uses):
//!
//! ```text
//! template  = '<' chain '>'
//! chain     = call (':' call)*            // X:F() applies F to X
//! call      = IDENT '(' (arg (',' arg)*)? ')'
//! arg       = '"' ... '"'                 // code text; \" and \\ unescaped
//!           | '{' subtemplate '}'         // literal text + nested templates
//!           | chain                       // nested helper call
//! ```
//!
//! Only `<IDENT(` sequences whose IDENT is a known helper are rewritten;
//! element options (`<assoc=right>`), token literals (`'<'`), comments, and
//! raw Java action bodies pass through verbatim, so the transform is
//! idempotent. An unknown `<IDENT(...)>` is left verbatim and reported in
//! `warnings` — loud, never a silent guess.

use { scan_string, comment_end, skip_ws, copy_char, name_end } from "./scan.wado";

pub struct ExpandOutcome {
    pub text: String,
    pub warnings: List<String>,
}

pub fn expand_action_templates<S: AsStrSlice>(text: S) -> ExpandOutcome {
    let src = text.as_str_slice();
    let n = src.len();
    let mut out = String::with_capacity(n);
    let mut warnings: List<String> = [];
    let mut i = 0;
    while i < n {
        if let Some(end) = comment_end(&src, i, n) {
            out.push_str(src.slice(i, end));
            i = end;
            continue;
        }
        match src.byte_at(i) {
            // A `'...'` grammar string is copied verbatim (never a template).
            b'\'' => {
                let end = scan_string(&src, i);
                out.push_str(src.slice(i, end));
                i = end;
                continue;
            },
            // A `[...]` region is either a lexer char class (`[a-z']`, which
            // may contain a bare `'`) or a rule arg-action / `returns` /
            // `locals` bracket (`[<StringList()> x]`, which may contain a
            // template). Walk it expanding templates but treating `'` as a
            // literal char, so an apostrophe never opens a string that would
            // swallow a later `<template>`.
            b'[' => {
                out.push_str("[");
                i += 1;
                let mut depth = 1;
                while i < n && depth > 0 {
                    let d = src.byte_at(i);
                    if d == b'\\' && i + 1 < n {
                        out.push_str("\\");
                        i = copy_char(&mut out, &src, i + 1);
                        continue;
                    }
                    if d == b'<' && is_template_start(&src, i) {
                        match eval_template(&src, i) {
                            Ok(expanded) => {
                                out.push_str(&expanded.text);
                                i = expanded.end;
                                continue;
                            },
                            Err(reason) => {
                                warnings.push(reason);
                            },
                        }
                    }
                    if d == b'[' {
                        depth += 1;
                    } else if d == b']' {
                        depth -= 1;
                    }
                    i = copy_char(&mut out, &src, i);
                }
                continue;
            },
            b'<' && i + 1 < n && src.byte_at(i + 1) == b'!' => {
                i = scan_st_comment(&src, i);
                continue;
            },
            b'<' && is_template_start(&src, i) => {
                match eval_template(&src, i) {
                    Ok(expanded) => {
                        out.push_str(&expanded.text);
                        i = expanded.end;
                        continue;
                    },
                    Err(reason) => {
                        // Fall through: emit '<' and rescan the rest verbatim.
                        warnings.push(reason);
                    },
                }
            },
            _ => {
            },
        }
        i = copy_char(&mut out, &src, i);
    }
    return ExpandOutcome { text: out, warnings };
}

/// Scan a `<! ... !>` StringTemplate comment. `pos` must point at the `<`.
/// Returns the offset just past the closing `!>`, or `src.len()` if
/// unterminated.
fn scan_st_comment(src: &StrSlice, pos: i32) -> i32 {
    let n = src.len();
    let mut i = pos + 2;
    while i + 1 < n {
        if src.byte_at(i) == b'!' && src.byte_at(i + 1) == b'>' {
            return i + 2;
        }
        i += 1;
    }
    return n;
}

struct Expanded {
    text: String,
    /// Offset just past the closing '>'.
    end: i32,
}

/// A '<' opens a template only when an identifier followed by '(' comes
/// next. This keeps `<assoc=right>`, `<EOF>`, `<p=3>`, and comparison
/// operators out of the template path without tracking regions.
fn is_template_start(src: &StrSlice, lt: i32) -> bool {
    let n = src.len();
    let end = name_end(src, lt + 1, n);
    return end > lt + 1 && end < n && src.byte_at(end) == b'(';
}

/// Parse and expand one `<chain>` starting at the '<'.
fn eval_template(src: &StrSlice, lt: i32) -> Result<Expanded, String> {
    let chain = eval_chain(src, lt + 1)?;
    let j = skip_ws(src, chain.end, src.len());
    if j >= src.len() || src.byte_at(j) != b'>' {
        return Result::Err(`template at offset ${lt}: expected '>' to close the reference`);
    }
    return Result::Ok(Expanded { text: chain.text, end: j + 1 });
}

/// Parse and expand `call (':' call)*` starting at an identifier.
fn eval_chain(src: &StrSlice, start: i32) -> Result<Expanded, String> {
    let n = src.len();
    let mut current = eval_call(src, start, null)?;
    loop {
        let j = skip_ws(src, current.end, n);
        if j < n && src.byte_at(j) == b':' {
            let k = skip_ws(src, j + 1, n);
            current = eval_call(src, k, Option::Some(current.text))?;
            continue;
        }
        return Result::Ok(Expanded { text: current.text, end: current.end });
    }
}

/// Parse `IDENT '(' args ')'` at `start` and expand it against the table.
fn eval_call(src: &StrSlice, start: i32, receiver: Option<String>) -> Result<Expanded, String> {
    let n = src.len();
    let mut j = name_end(src, start, n);
    if j == start {
        return Result::Err(`template call at offset ${start}: expected a helper name`);
    }
    let name = src.slice(start, j);
    if j >= n || src.byte_at(j) != b'(' {
        return Result::Err(`template helper '${name}': expected '('`);
    }
    j += 1;
    let mut args: List<String> = [];
    j = skip_ws(src, j, n);
    if j < n && src.byte_at(j) != b')' {
        loop {
            let arg = eval_arg(src, j)?;
            args.push(arg.text);
            j = skip_ws(src, arg.end, n);
            if j < n && src.byte_at(j) == b',' {
                j = skip_ws(src, j + 1, n);
                continue;
            }
            break;
        }
    }
    if j >= n || src.byte_at(j) != b')' {
        return Result::Err(`template helper '${name}': expected ')'`);
    }
    let text = expand_helper(name, &receiver, &args)?;
    return Result::Ok(Expanded { text, end: j + 1 });
}

/// Parse one argument: a `"..."` code-text string, a `{...}` subtemplate
/// block, or a nested helper chain.
fn eval_arg(src: &StrSlice, start: i32) -> Result<Expanded, String> {
    let n = src.len();
    let b = src.byte_at(start);
    if b == b'"' {
        let mut text = String::with_capacity(16);
        let mut j = start + 1;
        while j < n {
            let d = src.byte_at(j);
            if d == b'\\' && j + 1 < n && src.byte_at(j + 1) matches { b'"' | b'\\' } {
                j = copy_char(&mut text, src, j + 1);
                continue;
            }
            if d == b'"' {
                return Result::Ok(Expanded { text, end: j + 1 });
            }
            j = copy_char(&mut text, src, j);
        }
        return Result::Err(`template string argument at offset ${start} is unterminated`);
    }
    if b == b'{' {
        // Subtemplate: literal text with nested `<template>` references.
        // Balance inner `{`/`}` so a literal brace in the body (host code
        // like `if (x) { y; }`) does not close the argument early.
        let mut text = String::with_capacity(16);
        let mut j = start + 1;
        let mut depth = 1;
        while j < n {
            let d = src.byte_at(j);
            if d == b'<' && is_template_start(src, j) {
                let nested = eval_template(src, j)?;
                text.push_str(&nested.text);
                j = nested.end;
                continue;
            }
            if d == b'{' {
                depth += 1;
            } else if d == b'}' {
                depth -= 1;
                if depth == 0 {
                    break;
                }
            }
            j = copy_char(&mut text, src, j);
        }
        if j >= n {
            return Result::Err(`template block argument at offset ${start} is unterminated`);
        }
        return Result::Ok(Expanded { text, end: j + 1 });
    }
    if name_end(src, start, n) > start {
        return eval_chain(src, start);
    }
    return Result::Err(`template argument at offset ${start}: expected a string, block, or helper call`);
}

/// The Java-target expansion table. `recv` is the chained receiver
/// (`X:F()` passes X's expansion), `args` are the evaluated arguments.
fn expand_helper<S: AsStrSlice>(name: S, recv: &Option<String>, args: &List<String>) -> Result<String, String> {
    let name = name.as_str_slice();
    // Receiver-capable helpers: the print helpers take the value chained or
    // as a single argument; the combinators require a chained receiver. A
    // non-match falls through to the receiver-free table below.
    match name {
        "writeln" => {
            return Result::Ok(`System.out.println(${chain_or_arg(recv, args, name)?});`);
        },
        "write" => {
            return Result::Ok(`System.out.print(${chain_or_arg(recv, args, name)?});`);
        },
        "ToStringTree" => {
            return Result::Ok(`${chain_or_arg(recv, args, name)?}.toStringTree(this)`);
        },
        "Invoke_pred" => {
            return Result::Ok(`this.pred(${require_receiver(recv, name)?})`);
        },
        "Assert" => {
            return Result::Ok(`assert ${require_receiver(recv, name)?};`);
        },
        "Not" => {
            return Result::Ok(`!(${require_receiver(recv, name)?})`);
        },
        "Concat" => {
            let r = require_receiver(recv, name)?;
            require_args(args, 1, name)?;
            return Result::Ok(`${r}${args[0]}`);
        },
        "SubContextLocal" => {
            let r = require_receiver(recv, name)?;
            require_args(args, 2, name)?;
            return Result::Ok(`${r}.${args[0]}.${args[1]}`);
        },
        // Host-side scaffolding (see the group below); the receiver it
        // would walk is discarded with it.
        "WalkListener" => {
            let _ = require_receiver(recv, name)?;
            return Result::Ok("");
        },
        _ => {
        },
    }

    // Everything below is receiver-free.
    if recv matches { Some(_) } {
        return Result::Err(`template helper '${name}' does not take a chained receiver`);
    }

    return match name {
        // Constants.
        "True" => Result::Ok("true"),
        "False" => Result::Ok("false"),
        "Pass" => Result::Ok(""),
        "InputText" => Result::Ok("_input.getText()"),
        "Text" => Result::Ok("getText()"),
        "Column" => Result::Ok("getCharPositionInLine()"),
        "StringType" => Result::Ok("String"),
        "StringList" => Result::Ok("List<String>"),
        "LL_EXACT_AMBIG_DETECTION" => Result::Ok(
            "getInterpreter().setPredictionMode(PredictionMode.LL_EXACT_AMBIG_DETECTION);",
        ),
        "DumpDFA" => Result::Ok("dumpDFA();"),
        "BuildParseTrees" => Result::Ok("setBuildParseTree(true);"),
        "BailErrorStrategy" => Result::Ok("setErrorHandler(new BailErrorStrategy());"),
        "GetExpectedTokenNames" => Result::Ok("getExpectedTokens().toString(getVocabulary())"),
        "Invoke_foo" => Result::Ok("this.foo();"),
        "RuleInvocationStack" => Result::Ok("getRuleInvocationStack()"),
        // Host-side scaffolding — a listener import or class the testsuite
        // injects per target, invisible in the parse tree the corpus
        // compares. A helper that changes what the parser *produces* must
        // not join this group; see the action-template section of
        // `antlr4-compatibility.md` for what that rules out and why.
        "ImportRuleInvocationStack" => Result::Ok(""),
        "ImportListener" | "BasicListener" | "LRListener" | "LRWithLabelsListener" | "RuleGetterListener" | "TokenGetterListener" => {
            require_args(args, 1, name)?;
            Result::Ok("");
        },
        "Declare_pred" => Result::Ok("boolean pred(boolean v) {\n\tSystem.out.println(\"eval=\" + v);\n\treturn v;\n}"),
        "Declare_foo" => Result::Ok("public void foo() {\n\tSystem.out.println(\"foo\");\n}"),
        // Compile-time check that the rule context exposes list getters.
        "DeclareContextListGettersFunction" => Result::Ok("void foo() {\n\tSContext s = null;\n\ts.a();\n\ts.b();\n}"),
        // One argument.
        "PlusText" => {
            require_args(args, 1, name)?;
            Result::Ok(`"${args[0]}" + getText()`);
        },
        "TokenStartColumnEquals" => {
            require_args(args, 1, name)?;
            Result::Ok(`_tokenStartCharPositionInLine == ${args[0]}`);
        },
        // Compile-time check that the expression has a List type.
        "AssertIsList" => {
            require_args(args, 1, name)?;
            Result::Ok(`java.util.List<?> __assertIsList = ${args[0]};`);
        },
        "TextEquals" => {
            require_args(args, 1, name)?;
            Result::Ok(`getText().equals("${args[0]}")`);
        },
        "GetMember" => {
            require_args(args, 1, name)?;
            Result::Ok(`this.${args[0]}`);
        },
        "IntArg" => {
            require_args(args, 1, name)?;
            Result::Ok(`int ${args[0]}`);
        },
        "Production" | "Result" | "VarRef" => {
            require_args(args, 1, name)?;
            Result::Ok(args[0]);
        },
        // Two arguments.
        "Cast" => {
            require_args(args, 2, name)?;
            Result::Ok(`((${args[0]})${args[1]})`);
        },
        "ContextRuleFunction" | "ParserToken" | "ContextMember" => {
            require_args(args, 2, name)?;
            Result::Ok(`${args[0]}.${args[1]}`);
        },
        "ContextListFunction" => {
            require_args(args, 2, name)?;
            Result::Ok(`${args[0]}.${args[1]}()`);
        },
        "LANotEquals" => {
            require_args(args, 2, name)?;
            Result::Ok(`_input.LA(${args[0]}) != ${args[1]}`);
        },
        "LTEquals" => {
            require_args(args, 2, name)?;
            Result::Ok(`_input.LT(${args[0]}).getText().equals(${args[1]})`);
        },
        "ValEquals" => {
            require_args(args, 2, name)?;
            Result::Ok(`${args[0]} == ${args[1]}`);
        },
        "AssignLocal" => {
            require_args(args, 2, name)?;
            Result::Ok(`${args[0]} = ${args[1]};`);
        },
        "InitIntVar" | "InitIntMember" => {
            require_args(args, 2, name)?;
            Result::Ok(`int ${args[0]} = ${args[1]};`);
        },
        "InitBooleanMember" => {
            require_args(args, 2, name)?;
            Result::Ok(`boolean ${args[0]} = ${args[1]};`);
        },
        "SetMember" => {
            require_args(args, 2, name)?;
            Result::Ok(`this.${args[0]} = ${args[1]};`);
        },
        "AddMember" => {
            require_args(args, 2, name)?;
            Result::Ok(`this.${args[0]} += ${args[1]};`);
        },
        "MemberEquals" => {
            require_args(args, 2, name)?;
            Result::Ok(`this.${args[0]} == ${args[1]}`);
        },
        "Append" | "AppendStr" => {
            require_args(args, 2, name)?;
            Result::Ok(`${args[0]} + ${args[1]}`);
        },
        // Three arguments.
        "ModMemberEquals" => {
            require_args(args, 3, name)?;
            Result::Ok(`this.${args[0]} % ${args[1]} == ${args[2]}`);
        },
        "ModMemberNotEquals" => {
            require_args(args, 3, name)?;
            Result::Ok(`this.${args[0]} % ${args[1]} != ${args[2]}`);
        },
        _ => Result::Err(`unknown template helper '${name}'`),
    };
}

fn chain_or_arg<S: AsStrSlice>(recv: &Option<String>, args: &List<String>, name: S) -> Result<String, String> {
    if let Some(r) = recv {
        if !args.is_empty() {
            return Result::Err(`template helper '${name}' takes a receiver or one argument, not both`);
        }
        return Result::Ok(*r);
    }
    if args.len() != 1 {
        return Result::Err(`template helper '${name}' expects exactly one argument`);
    }
    return Result::Ok(args[0]);
}

fn require_receiver<S: AsStrSlice>(recv: &Option<String>, name: S) -> Result<String, String> {
    return match recv {
        Some(r) => Result::Ok(*r),
        None => Result::Err(`template helper '${name}' requires a chained receiver`),
    };
}

/// Validate the argument count; callers then index `args` directly (no
/// list copy). `?`-propagates the arity error.
fn require_args<S: AsStrSlice>(args: &List<String>, count: i32, name: S) -> Result<(), String> {
    if args.len() != count {
        return Result::Err(`template helper '${name}' expects ${count} argument(s), got ${args.len()}`);
    }
    return Result::Ok(());
}
