//! Action-body stripper for ANTLR4 grammar source, for the Stage B′ oracle.
//!
//! The jar's Java target copies an action body verbatim without substituting
//! the StringTemplate directives the testsuite writes (`<writeln("$text")>`),
//! so `javac` rejects it and the oracle will not run. A plain action is
//! side-effecting host code, so dropping it leaves what the parser matches
//! alone. A `{ … }?` semantic predicate does not have that property — it gates
//! an alternative, and stripping it widens what the grammar accepts. Such a
//! descriptor is triaged out (`[stage_b_todo]`, `[stage_b_oracle_skip]`)
//! rather than pinned against the oracle.

use {
    scan_string,
    scan_char_class,
    comment_end,
    scan_balanced,
    copy_char,
    name_end,
    is_rule_name_upper,
    skip_ws,
    word_at,
} from "./scan.wado";
use { char_at } from "../runtime/lex.wado";

/// ANTLR's `currentRuleType`: which recognizer the rule being scanned belongs
/// to, `Unknown` between rules.
enum RuleType {
    Unknown,
    Lexer,
    Parser,
}

/// The three keywords whose `{ … }` is a grammar prequel rather than an
/// action body.
global PREQUEL_KEYWORDS: List<String> = ["tokens", "options", "channels"];

/// The `.g4` words ANTLR4 lexes as keywords rather than as an identifier,
/// so none of them names a rule or fixes the rule type.
global GRAMMAR_KEYWORDS: List<String> = [
    "options", "tokens", "channels", "import", "fragment", "lexer", "parser", "grammar", "protected", "public",
    "private", "returns", "locals", "throws", "catch", "finally", "mode",
];

pub fn strip_action_bodies<S: AsStrSlice>(grammar: S) -> String {
    let src = grammar.as_str_slice();
    let n = src.len();
    let mut out = String::with_capacity(n);
    let mut rule_type = RuleType::Unknown;
    // Set only by the identifier branch, and cleared by every other token:
    // ANTLR's `OPTIONS : 'options' WSNLCHARS* '{'` admits whitespace before
    // the brace and nothing else, so a comment or a string between the two
    // means the brace opens an action body.
    let mut prequel_open = false;
    let mut i = 0;
    while i < n {
        let b = src.byte_at(i);
        if b == b';' {
            rule_type = RuleType::Unknown;
            prequel_open = false;
            out.push_str(";");
            i += 1;
            continue;
        }
        if b == b'\'' {
            // `.g4` lexer doesn't recognise `"..."` outside actions, so
            // only single-quote strings need top-level skip protection.
            let end = scan_string(&src, i);
            out.push_str(src.slice(i, end));
            prequel_open = false;
            i = end;
            continue;
        }
        if b == b'[' {
            // Both regions are copied verbatim; only where they end differs.
            // A lexer rule's char set does not nest — a literal `[` inside is
            // content, so depth tracking would run past the real `]` for sets
            // like TypeScript's `~[*...[]` and swallow the next action.
            // Anywhere else the brackets are an argument list, which nests, so
            // a `[]` host type does not end it.
            let scanned = if rule_type matches { RuleType::Lexer } {
                scan_char_class(&src, i);
            } else {
                scan_balanced(&src, i, b'[', b']');
            };
            // Left unterminated, a region runs to end-of-input, as ANTLR4's
            // lexer treats it.
            let end = scanned.unwrap_or(n);
            out.push_str(src.slice(i, end));
            prequel_open = false;
            i = end;
            continue;
        }
        if let Some(end) = comment_end(&src, i, n) {
            out.push_str(src.slice(i, end));
            prequel_open = false;
            i = end;
            continue;
        }
        if b == b'@' {
            // Named actions: `@id { … }` or `@scope::id { … }`. Strip
            // the prefix and its body together. If no `{` follows,
            // fall through and copy the `@` verbatim.
            let mut j = name_end(&src, i + 1, n);
            if j > i + 1 {
                if j + 1 < n && src.byte_at(j) == b':' && src.byte_at(j + 1) == b':' {
                    j = name_end(&src, j + 2, n);
                }
                j = skip_ws(&src, j, n);
                if j < n && src.byte_at(j) == b'{' {
                    if let Some(end) = scan_balanced(&src, j, b'{', b'}') {
                        i = end;
                        continue;
                    }
                }
            }
            out.push_str("@");
            prequel_open = false;
            i += 1;
            continue;
        }
        if b == b'c' && word_at(&src, i, n, "catch") {
            let j = skip_ws(&src, i + 5, n);
            if j < n && src.byte_at(j) == b'[' {
                if let Some(bracket_end) = scan_balanced(&src, j, b'[', b']') {
                    let k = skip_ws(&src, bracket_end, n);
                    if k < n && src.byte_at(k) == b'{' {
                        if let Some(end) = scan_balanced(&src, k, b'{', b'}') {
                            i = end;
                            continue;
                        }
                    }
                }
            }
        }
        if b == b'f' && word_at(&src, i, n, "finally") {
            let j = skip_ws(&src, i + 7, n);
            if j < n && src.byte_at(j) == b'{' {
                if let Some(end) = scan_balanced(&src, j, b'{', b'}') {
                    i = end;
                    continue;
                }
            }
        }
        if b == b'{' {
            let scanned = scan_balanced(&src, i, b'{', b'}');
            // `tokens { … }`, `options { … }`, `channels { … }` are grammar
            // prequels, not action bodies — keep them whole, so the names
            // inside them never read as a rule name.
            if prequel_open {
                let end = scanned.unwrap_or(n);
                out.push_str(src.slice(i, end));
                prequel_open = false;
                i = end;
                continue;
            }
            match scanned {
                Some(end) => {
                    let mut k = end;
                    // `{…}?` is a semantic predicate — strip the `?` too.
                    if k < n && src.byte_at(k) == b'?' {
                        k += 1;
                    }
                    i = k;
                    continue;
                },
                None => {
                    out.push_str("{");
                    i += 1;
                    continue;
                },
            }
        }
        let j = name_end(&src, i, n);
        if j > i {
            let word = src.slice(i, j);
            prequel_open = PREQUEL_KEYWORDS.contains_str(word);
            if rule_type matches { RuleType::Unknown } && !GRAMMAR_KEYWORDS.contains_str(word) {
                rule_type = if is_rule_name_upper(char_at(&src, i)) { RuleType::Lexer } else { RuleType::Parser };
            }
            out.push_str(word);
            i = j;
            continue;
        }
        if !b.is_ascii_whitespace() {
            prequel_open = false;
        }
        i = copy_char(&mut out, &src, i);
    }
    return out;
}
