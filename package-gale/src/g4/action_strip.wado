//! Action-body stripper for ANTLR4 grammar source.
//!
//! The published ANTLR4 jar's Java target copies action-body source
//! into the generated parser verbatim — it does not substitute the
//! StringTemplate directives the testsuite uses (`<writeln("$text")>`,
//! etc.). `javac` then rejects the body, making the oracle uninvocable.
//! Stripping action bodies before handing the grammar to the oracle
//! works because actions are side-effecting host code; they don't
//! affect what the parser matches.
//!
//! The char-level region scanners (`scan_string`, `scan_char_class`,
//! `scan_line_comment`, `scan_block_comment`, `scan_balanced`) are shared
//! with the lexer and parser via `scan.wado`, so string-/comment-handling
//! lives in one place. Here a region that must be preserved is copied to
//! `out` verbatim; an action body is skipped by advancing `i` past it.
//!
//! A `[` means one of two things, and ANTLR4's own lexer decides by the
//! rule it is in: a char set inside a lexer rule (no nesting, ends at the
//! first unescaped `]`), an argument list anywhere else (nests, so a
//! `[]` host type stays inside it). `RuleType` mirrors ANTLR's
//! `currentRuleType` — set by the first non-keyword identifier of a rule,
//! reset by `;`.

use {
    scan_string,
    scan_char_class,
    scan_line_comment,
    scan_block_comment,
    scan_balanced,
    is_id_start_char,
    is_id_continue_char,
} from "./scan.wado";

/// Which recognizer the rule being scanned belongs to. `Unknown` covers
/// the span between rules, where ANTLR4 also reads a `[` as an argument
/// list.
enum RuleType {
    Unknown,
    Lexer,
    Parser,
}

/// The `.g4` words ANTLR4 lexes as keywords rather than as an identifier,
/// so none of them names a rule or fixes the rule type.
global GRAMMAR_KEYWORDS: List<String> = [
    "options", "tokens", "channels", "import", "fragment", "lexer", "parser", "grammar", "protected", "public",
    "private", "returns", "locals", "throws", "catch", "finally", "mode",
];

pub fn strip_action_bodies(grammar: &String) -> String {
    let chars: List<char> = grammar.chars().collect();
    let n = chars.len();
    let mut out = String::with_capacity(grammar.len());
    let mut rule_type = RuleType::Unknown;
    let mut i = 0;
    while i < n {
        let c = chars[i];
        if c == ';' {
            rule_type = RuleType::Unknown;
            out.push(c);
            i += 1;
            continue;
        }
        if c == '\'' {
            // `.g4` lexer doesn't recognise `"..."` outside actions, so
            // only single-quote strings need top-level skip protection.
            let end = scan_string(&chars, i);
            push_span(&mut out, &chars, i, end);
            i = end;
            continue;
        }
        if c == '[' {
            // Either way the region is copied verbatim; only where it ends
            // matters. A lexer rule's char set does NOT nest — a literal
            // `[` inside is content — so depth tracking there would stay
            // "inside" past the real `]` for sets like TypeScript's
            // `~[*...[]`, swallowing a following action. Everywhere else
            // the brackets are an argument list, which does nest, so a
            // `[]` host type does not end it.
            let scanned = if rule_type matches { RuleType::Lexer } {
                scan_char_class(&chars, i);
            } else {
                scan_balanced(&chars, i, '[', ']');
            };
            let end = match scanned {
                Some(e) => e,
                None => n,
            };
            push_span(&mut out, &chars, i, end);
            i = end;
            continue;
        }
        if c == '/' && i + 1 < n && chars[i + 1] == '/' {
            let end = scan_line_comment(&chars, i);
            push_span(&mut out, &chars, i, end);
            i = end;
            continue;
        }
        if c == '/' && i + 1 < n && chars[i + 1] == '*' {
            let end = scan_block_comment(&chars, i);
            push_span(&mut out, &chars, i, end);
            i = end;
            continue;
        }
        if c == '@' {
            // Named actions: `@id { … }` or `@scope::id { … }`. Strip
            // the prefix and its body together. If no `{` follows,
            // fall through and copy the `@` verbatim.
            let mut j = i + 1;
            if j < n && is_id_start_char(chars[j]) {
                j += 1;
                while j < n && is_id_continue_char(chars[j]) {
                    j += 1;
                }
                if j + 1 < n && chars[j] == ':' && chars[j + 1] == ':' {
                    j += 2;
                    if j < n && is_id_start_char(chars[j]) {
                        j += 1;
                        while j < n && is_id_continue_char(chars[j]) {
                            j += 1;
                        }
                    }
                }
                while j < n && chars[j].is_ascii_whitespace() {
                    j += 1;
                }
                if j < n && chars[j] == '{' {
                    if let Some(end) = scan_balanced(&chars, j, '{', '}') {
                        i = end;
                        continue;
                    }
                }
            }
            out.push(c);
            i += 1;
            continue;
        }
        if c == 'c' && starts_with_word(&chars, i, &"catch") {
            let mut j = i + 5;
            while j < n && chars[j].is_ascii_whitespace() {
                j += 1;
            }
            if j < n && chars[j] == '[' {
                if let Some(bracket_end) = scan_balanced(&chars, j, '[', ']') {
                    let mut k = bracket_end;
                    while k < n && chars[k].is_ascii_whitespace() {
                        k += 1;
                    }
                    if k < n && chars[k] == '{' {
                        if let Some(end) = scan_balanced(&chars, k, '{', '}') {
                            i = end;
                            continue;
                        }
                    }
                }
            }
        }
        if c == 'f' && starts_with_word(&chars, i, &"finally") {
            let mut j = i + 7;
            while j < n && chars[j].is_ascii_whitespace() {
                j += 1;
            }
            if j < n && chars[j] == '{' {
                if let Some(end) = scan_balanced(&chars, j, '{', '}') {
                    i = end;
                    continue;
                }
            }
        }
        if c == '{' {
            // `tokens { … }`, `options { … }`, `channels { … }` are
            // grammar prequels, not action bodies — keep them whole, so
            // the names inside them never read as a rule name.
            if preceded_by_prequel_keyword(&out) {
                let end = match scan_balanced(&chars, i, '{', '}') {
                    Some(e) => e,
                    None => n,
                };
                push_span(&mut out, &chars, i, end);
                i = end;
                continue;
            }
            match scan_balanced(&chars, i, '{', '}') {
                Some(end) => {
                    let mut k = end;
                    // `{…}?` is a semantic predicate — strip the `?` too.
                    if k < n && chars[k] == '?' {
                        k += 1;
                    }
                    i = k;
                    continue;
                },
                None => {
                    out.push(c);
                    i += 1;
                    continue;
                },
            }
        }
        if is_id_start_char(c) {
            let mut j = i + 1;
            while j < n && is_id_continue_char(chars[j]) {
                j += 1;
            }
            if rule_type matches { RuleType::Unknown } && !is_grammar_keyword(&chars, i) {
                // ASCII-only, as ANTLR asks `Character.isUpperCase`: see
                // TODO.md, blocked on ICU.
                rule_type = if c.is_ascii_uppercase() { RuleType::Lexer } else { RuleType::Parser };
            }
            push_span(&mut out, &chars, i, j);
            i = j;
            continue;
        }
        out.push(c);
        i += 1;
    }
    return out;
}

/// `starts_with_word` already demands a non-identifier char after the
/// match, so a hit means the identifier at `start` *is* the keyword.
fn is_grammar_keyword(chars: &List<char>, start: i32) -> bool {
    for let kw of GRAMMAR_KEYWORDS {
        if starts_with_word(chars, start, &kw) {
            return true;
        }
    }
    return false;
}

fn push_span(out: &mut String, chars: &List<char>, start: i32, end: i32) {
    let mut i = start;
    while i < end {
        out.push(chars[i]);
        i += 1;
    }
}

fn starts_with_word(chars: &List<char>, i: i32, word: &String) -> bool {
    let w: List<char> = word.chars().collect();
    let wn = w.len();
    if i + wn > chars.len() {
        return false;
    }
    if i > 0 && is_id_continue_char(chars[i - 1]) {
        return false;
    }
    for let mut k = 0; k < wn; k += 1 {
        if chars[i + k] != w[k] {
            return false;
        }
    }
    if i + wn < chars.len() && is_id_continue_char(chars[i + wn]) {
        return false;
    }
    return true;
}

fn preceded_by_prequel_keyword(out: &String) -> bool {
    let out_chars: List<char> = out.chars().collect();
    let mut j = out_chars.len();
    while j > 0 && out_chars[j - 1].is_ascii_whitespace() {
        j -= 1;
    }
    return ends_with_word(&out_chars, j, &"tokens")
        || ends_with_word(&out_chars, j, &"options")
        || ends_with_word(&out_chars, j, &"channels");
}

fn ends_with_word(chars: &List<char>, end: i32, word: &String) -> bool {
    let w: List<char> = word.chars().collect();
    let wn = w.len();
    if end < wn {
        return false;
    }
    let start = end - wn;
    if start > 0 && is_id_continue_char(chars[start - 1]) {
        return false;
    }
    for let mut k = 0; k < wn; k += 1 {
        if chars[start + k] != w[k] {
            return false;
        }
    }
    return true;
}
