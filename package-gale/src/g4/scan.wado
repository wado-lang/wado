//! Byte-level scanners shared across the g4 frontend.
//!
//! `.g4` source embeds host-language regions (action bodies `{...}`,
//! arg-actions `[...]`) that the lexer cannot delimit on its own: a `}` or
//! `]` may sit inside a host string or comment, or the brackets may nest.
//! These scanners walk the UTF-8 source with the awareness each region needs,
//! with one implementation per concern so a fix to string- or
//! comment-handling lands in a single place.
//!
//! Every position is a byte offset. Each delimiter they look for is ASCII, and
//! no byte of a multi-byte char is, so a scan may step one byte at a time and
//! still stop only on a char boundary.
//!
//! Each scanner takes `pos` at the opening element and returns the offset
//! just past what it consumed. The two-delimiter scanners report an
//! unterminated region as `None`; comment/string scanners run to
//! end-of-input (ANTLR4 tolerates unterminated comments).

use icu from "core:icu";
use { Properties } from "core:icu";
use { char_at } from "../runtime/lex.wado";

/// Scan a `//` line comment. `pos` must point at the first `/`. Returns
/// the offset of the terminating `\n` (which it excludes), or `src.len()`.
fn scan_line_comment(src: &StrSlice, pos: i32) -> i32 {
    let n = src.len();
    let mut i = pos + 2;
    while i < n && src.byte_at(i) != b'\n' {
        i += 1;
    }
    return i;
}

/// Scan a `/* ... */` block comment. `pos` must point at the first `/`.
/// Returns the offset just past the closing `*/`, or `src.len()` if
/// unterminated.
fn scan_block_comment(src: &StrSlice, pos: i32) -> i32 {
    let n = src.len();
    let mut i = pos + 2;
    while i + 1 < n {
        if src.byte_at(i) == b'*' && src.byte_at(i + 1) == b'/' {
            return i + 2;
        }
        i += 1;
    }
    return n;
}

/// The end of the `//` or `/* */` comment opening at `i`, or `null` where none
/// does.
pub fn comment_end(src: &StrSlice, i: i32, n: i32) -> Option<i32> {
    if src.byte_at(i) != b'/' || i + 1 >= n {
        return null;
    }
    return match src.byte_at(i + 1) {
        b'/' => Option::Some(scan_line_comment(src, i)),
        b'*' => Option::Some(scan_block_comment(src, i)),
        _ => null,
    };
}

/// Scan a `'...'` or `"..."` host string. `pos` must point at the opening
/// quote. Honors `\` escapes. Returns the offset just past the closing
/// quote, or `src.len()` if unterminated.
pub fn scan_string(src: &StrSlice, pos: i32) -> i32 {
    return scan_closed_string(src, pos).unwrap_or(src.len());
}

/// `scan_string`, with an unterminated string reported as `None`.
pub fn scan_closed_string(src: &StrSlice, pos: i32) -> Option<i32> {
    let n = src.len();
    let quote = src.byte_at(pos);
    let mut i = pos + 1;
    while i < n {
        let b = src.byte_at(i);
        if b == b'\\' && i + 1 < n {
            i += 2;
            continue;
        }
        i += 1;
        if b == quote {
            return Option::Some(i);
        }
    }
    return null;
}

/// Scan a Wado template literal. `pos` must point at the opening backtick.
/// Returns the offset just past the closing backtick, or `n` if unterminated,
/// and the span of each `${ ... }` body. A hole is Wado code, so a string,
/// comment or template inside it is stepped over whole.
pub fn scan_template(src: &StrSlice, pos: i32, n: i32) -> [i32, List<[i32, i32]>] {
    let mut holes: List<[i32, i32]> = [];
    let mut i = pos + 1;
    while i < n {
        let b = src.byte_at(i);
        if b == b'\\' && i + 1 < n {
            i += 2;
            continue;
        }
        if b == b'`' {
            return [i + 1, holes];
        }
        if b == b'$' && i + 1 < n && src.byte_at(i + 1) == b'{' {
            let Some(close) = match_delim(src, i + 1, n, b'{', b'}') else {
                holes.push([i + 2, n]);
                return [n, holes];
            };
            holes.push([i + 2, close - 1]);
            i = close;
            continue;
        }
        i += 1;
    }
    return [n, holes];
}

/// The end of the Wado string, char, template or comment opening at `i`, or
/// `null` where none does: what a scan of Wado code steps over whole.
pub fn wado_opaque_end(src: &StrSlice, i: i32, n: i32) -> Option<i32> {
    return match src.byte_at(i) {
        b'"' | b'\'' => Option::Some(scan_string(src, i)),
        b'`' => Option::Some(scan_template(src, i, n).0),
        _ => comment_end(src, i, n),
    };
}

/// In Wado code, the offset just past the delimiter matching the `open_b` at
/// `open`, or `null` when it never closes.
pub fn match_delim(src: &StrSlice, open: i32, n: i32, open_b: u8, close_b: u8) -> Option<i32> {
    let mut depth = 0;
    let mut i = open;
    while i < n {
        if let Some(end) = wado_opaque_end(src, i, n) {
            i = end;
            continue;
        }
        let b = src.byte_at(i);
        if b == open_b {
            depth += 1;
        } else if b == close_b {
            depth -= 1;
            if depth == 0 {
                return Option::Some(i + 1);
            }
        }
        i += 1;
    }
    return null;
}

/// The spans of `src` between the commas no bracket encloses, each trimmed,
/// an empty last one dropped. `<` is a comparison unless it opens a type's
/// arguments: after `::`, or anywhere in a declaration's type, before its `=`.
pub fn split_top_level_commas(src: &StrSlice, declarations: bool) -> List<String> {
    let n = src.len();
    let mut out: List<String> = [];
    let mut open: List<u8> = [];
    let mut seg_start = 0;
    let mut in_type = declarations;
    let mut i = 0;
    while i < n {
        if let Some(end) = wado_opaque_end(src, i, n) {
            i = end;
            continue;
        }
        let b = src.byte_at(i);
        if b matches { b'(' | b'[' | b'{' }
            || b == b'<' && (in_type || open.last() == Option::Some(b'<') || opens_type_args(src, i)) {
            open.push(b);
        } else if b matches { b')' | b']' | b'}' }
            || b == b'>' && open.last() == Option::Some(b'<') && src.byte_at(i - 1) != b'-' {
            open.pop();
        } else if open.is_empty()
            && b == b'='
            && !(i + 1 < n && src.byte_at(i + 1) == b'=')
            && !(i > 0 && src.byte_at(i - 1) matches { b'!' | b'<' | b'>' | b'=' }) {
            in_type = false;
        } else if open.is_empty() && b == b',' {
            out.push(src.slice(seg_start, i).trim().to_string());
            seg_start = i + 1;
            in_type = declarations;
        }
        i += 1;
    }
    let last = src.slice(seg_start, n).trim();
    if !last.is_empty() {
        out.push(last.to_string());
    }
    return out;
}

/// Whether the `<` at `lt` follows a turbofish `::`, or a path where Wado
/// expects a type: after `as`, a single `:` or `->`.
fn opens_type_args(src: &StrSlice, lt: i32) -> bool {
    if text_at(src, lt - 2, lt, "::") {
        return true;
    }
    let mut j = ident_start(src, lt);
    while text_at(src, j - 2, j, "::") {
        j = ident_start(src, j - 2);
    }
    while j > 0 && src.byte_at(j - 1).is_ascii_whitespace() {
        j -= 1;
    }
    return word_at(src, j - 2, j, "as")
        || text_at(src, j - 2, j, "->")
        || text_at(src, j - 1, j, ":") && !text_at(src, j - 2, j, "::");
}

/// The start of the identifier ending at `end`, which is `end` itself when
/// none does.
pub fn ident_start(src: &StrSlice, end: i32) -> i32 {
    let mut j = end;
    while j > 0 {
        let prev = src.floor_char_boundary(j - 1);
        if !is_id_continue_char(char_at(src, prev)) {
            break;
        }
        j = prev;
    }
    return j;
}

/// The end of the identifier starting at `start`, which is `start` itself when
/// none does.
pub fn ident_end(src: &StrSlice, start: i32, n: i32) -> i32 {
    let mut j = start;
    while j < n && is_id_continue_char(char_at(src, j)) {
        j = if src.byte_at(j) < 0x80 { j + 1 } else { src.ceil_char_boundary(j + 1) };
    }
    return j;
}

/// The end of the name starting at `start`: a NameStartChar, then NameChars.
/// `start` itself when no name starts there.
pub fn name_end(src: &StrSlice, start: i32, n: i32) -> i32 {
    if start >= n || !is_id_start_char(char_at(src, start)) {
        return start;
    }
    return ident_end(src, start, n);
}

/// Scan an ANTLR4 char class `[...]`. `pos` must point at the opening `[`.
/// Per the char-set lexicon, only `\X` escapes are recognized and the
/// first unescaped `]` ends the set: brackets do not nest and host
/// strings/comments are not interpreted. Returns the offset just past the
/// closing `]`, or `None` if unterminated.
pub fn scan_char_class(src: &StrSlice, pos: i32) -> Option<i32> {
    let n = src.len();
    let mut i = pos + 1;
    while i < n {
        let b = src.byte_at(i);
        i += 1;
        if b == b'\\' {
            if i < n {
                i += 1;
            }
            continue;
        }
        if b == b']' {
            return Option::<i32>::Some(i);
        }
    }
    return null;
}

/// Scan a balanced host-code region delimited by `open`/`close`
/// (`{...}` action body, `[...]` arg-action). `open_idx` must point at
/// the opening delimiter. Host strings and `//` / `/* */` comments are
/// skipped so a delimiter inside them does not affect depth; `open` /
/// `close` nest. Returns the offset just past the matching `close`, or
/// `None` if depth never returns to zero before end-of-input.
pub fn scan_balanced(src: &StrSlice, open_idx: i32, open: u8, close: u8) -> Option<i32> {
    let n = src.len();
    let mut i = open_idx + 1;
    let mut depth = 1;
    while i < n {
        let b = src.byte_at(i);
        if let Some(end) = comment_end(src, i, n) {
            i = end;
        } else if b == b'"' || b == b'\'' {
            i = scan_string(src, i);
        } else if b == open {
            depth += 1;
            i += 1;
        } else if b == close {
            depth -= 1;
            i += 1;
            if depth == 0 {
                return Option::<i32>::Some(i);
            }
        } else {
            i += 1;
        }
    }
    return null;
}

/// Append the char at `i` to `out`, returning the offset past it.
pub fn copy_char(out: &mut String, src: &StrSlice, i: i32) -> i32 {
    let next = src.ceil_char_boundary(i + 1);
    out.push_str(src.slice(i, next));
    return next;
}

/// Past the ASCII whitespace from `start`, stopping at `n`.
pub fn skip_ws(src: &StrSlice, start: i32, n: i32) -> i32 {
    let mut i = start;
    while i < n && src.byte_at(i).is_ascii_whitespace() {
        i += 1;
    }
    return i;
}

/// Whether `text` sits at `i`, ending by `n`.
pub fn text_at<S: AsStrSlice>(src: &StrSlice, i: i32, n: i32, text: S) -> bool {
    let t = text.as_str_slice();
    if i < 0 || i + t.len() > n {
        return false;
    }
    for let mut k = 0; k < t.len(); k += 1 {
        if src.byte_at(i + k) != t.byte_at(k) {
            return false;
        }
    }
    return true;
}

/// Whether `word` sits at `i` as a whole word, not part of a longer name.
pub fn word_at<S: AsStrSlice>(src: &StrSlice, i: i32, n: i32, word: S) -> bool {
    let w = word.as_str_slice();
    if !text_at(src, i, n, w) {
        return false;
    }
    return ident_start(src, i) == i && ident_end(src, i + w.len(), n) == i + w.len();
}

/// ANTLR4's `NameStartChar` (`vendor/antlr4/doc/lexicon.md`), which is XML's:
/// a fixed range list rather than a Unicode property, so it is written out
/// rather than asked of `core:icu`.
fn is_id_start_char(c: char) -> bool {
    if c.is_ascii_alphabetic() || c == '_' {
        return true;
    }
    return '\u{00C0}' <= c <= '\u{00D6}'
        || '\u{00D8}' <= c <= '\u{00F6}'
        || '\u{00F8}' <= c <= '\u{02FF}'
        || '\u{0370}' <= c <= '\u{037D}'
        || '\u{037F}' <= c <= '\u{1FFF}'
        || '\u{200C}' <= c <= '\u{200D}'
        || '\u{2070}' <= c <= '\u{218F}'
        || '\u{2C00}' <= c <= '\u{2FEF}'
        || '\u{3001}' <= c <= '\u{D7FF}'
        || '\u{F900}' <= c <= '\u{FDCF}'
        || '\u{FDF0}' <= c <= '\u{FFFD}';
}

/// Whether a rule name starting with `c` is a lexer rule. ANTLR4 types a rule
/// by `Character.isUpperCase` (`vendor/antlr4/doc/lexicon.md`), which is the
/// UCD's `Uppercase`: `Lu` plus `Other_Uppercase`, not the ASCII range.
pub fn is_rule_name_upper(c: char) -> bool {
    if c <= '\u{007F}' {
        return 'A' <= c <= 'Z';
    }
    return icu::has(Properties::BinaryProperty::Uppercase, c);
}

/// ANTLR4's `NameChar`.
fn is_id_continue_char(c: char) -> bool {
    if is_id_start_char(c) || c.is_ascii_digit() {
        return true;
    }
    return c == '\u{00B7}' || '\u{0300}' <= c <= '\u{036F}' || '\u{203F}' <= c <= '\u{2040}';
}
