use { Span, chars_text } from "../runtime/lex.wado";

pub enum G4Token {
    Grammar,
    Fragment,
    Arrow,
    Colon,
    ColonColon,
    Semicolon,
    Pipe,
    LParen,
    RParen,
    LBrace,
    RBrace,
    Comma,
    At,
    LAngle,
    RAngle,
    Star,
    Plus,
    PlusAssign,
    Question,
    Dot,
    Tilde,
    Assign,
    Hash,
    StringLit,
    CharClass,
    Identifier,
    IntLit,
    Eof,
    // Tokens the lexer could not form. Each names its own lexical problem, so
    // the token's `text` stays the source slice it is for every other kind.
    UnterminatedString,
    UnterminatedCharClass,
    InvalidEscape,
    UnexpectedChar,
}

impl G4Token {
    pub fn name(&self) -> String {
        return match *self {
            Grammar => "grammar",
            Fragment => "fragment",
            Arrow => "->",
            Colon => ":",
            ColonColon => "::",
            Semicolon => ";",
            Pipe => "|",
            LParen => "(",
            RParen => ")",
            LBrace => "{",
            RBrace => "}",
            Comma => ",",
            At => "@",
            LAngle => "<",
            RAngle => ">",
            Star => "*",
            Plus => "+",
            PlusAssign => "+=",
            Question => "?",
            Dot => ".",
            Tilde => "~",
            Assign => "=",
            Hash => "#",
            StringLit => "string",
            CharClass => "char-class",
            Identifier => "identifier",
            IntLit => "int",
            Eof => "EOF",
            UnterminatedString => "unterminated string",
            UnterminatedCharClass => "unterminated character set",
            InvalidEscape => "invalid escape sequence",
            UnexpectedChar => "unexpected character",
        };
    }
}

pub struct LexerSlice {
    pub chars: &List<char>,
    pub start: i32,
    pub end: i32,
}

impl LexerSlice {
    pub fn new(chars: &List<char>, start: i32, end: i32) -> LexerSlice {
        return LexerSlice { chars, start, end };
    }

    pub fn from_string<S: AsStrSlice>(s: S) -> LexerSlice {
        let chars = s.chars().collect();
        return LexerSlice { chars: &chars, start: 0, end: chars.len() };
    }

    pub fn len(&self) -> i32 {
        return self.end - self.start;
    }

    pub fn to_string(&self) -> String {
        return chars_text(self.chars, self.start, self.end);
    }
}

impl Display for LexerSlice {
    fn fmt(&self, f: &mut Formatter) {
        for let mut i = self.start; i < self.end; i += 1 {
            f.write_char(self.chars[i]);
        }
    }
}

impl Eq<String> for LexerSlice {
    fn eq(&self, other: &String) -> bool {
        let mut i = self.start;
        for let c of other.chars() {
            if i >= self.end || c != self.chars[i] {
                return false;
            }
            i += 1;
        }
        return i == self.end;
    }
}

pub struct Token {
    pub kind: i32,
    pub text: LexerSlice,
    pub span: Span,
}

impl Token {
    pub fn new(kind: i32, text: LexerSlice, span: Span) -> Token {
        return Token { kind, text, span };
    }
}
