use { Span } from "../runtime/lex.wado";

pub enum G4Token {
    Grammar,
    Fragment,
    Arrow,
    Colon,
    ColonColon,
    Semicolon,
    Pipe,
    LParen,
    RParen,
    LBrace,
    RBrace,
    Comma,
    At,
    LAngle,
    RAngle,
    Star,
    Plus,
    PlusAssign,
    Question,
    Dot,
    Tilde,
    Assign,
    Hash,
    StringLit,
    CharClass,
    Identifier,
    IntLit,
    Eof,
    // Tokens the lexer could not form. Each names its own lexical problem, so
    // the token's `text` stays the source slice it is for every other kind.
    UnterminatedString,
    UnterminatedCharClass,
    InvalidEscape,
    UnexpectedChar,
}

impl G4Token {
    pub fn name(&self) -> String {
        return match *self {
            Grammar => "grammar",
            Fragment => "fragment",
            Arrow => "->",
            Colon => ":",
            ColonColon => "::",
            Semicolon => ";",
            Pipe => "|",
            LParen => "(",
            RParen => ")",
            LBrace => "{",
            RBrace => "}",
            Comma => ",",
            At => "@",
            LAngle => "<",
            RAngle => ">",
            Star => "*",
            Plus => "+",
            PlusAssign => "+=",
            Question => "?",
            Dot => ".",
            Tilde => "~",
            Assign => "=",
            Hash => "#",
            StringLit => "string",
            CharClass => "char-class",
            Identifier => "identifier",
            IntLit => "int",
            Eof => "EOF",
            UnterminatedString => "unterminated string",
            UnterminatedCharClass => "unterminated character set",
            InvalidEscape => "invalid escape sequence",
            UnexpectedChar => "unexpected character",
        };
    }
}

pub struct Token {
    pub kind: i32,
    pub text: String,
    pub span: Span,
}

impl Token {
    pub fn new(kind: i32, text: String, span: Span) -> Token {
        return Token { kind, text, span };
    }
}
