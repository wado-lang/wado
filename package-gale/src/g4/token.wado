use { Span } from "../runtime/lex.wado";

pub enum G4Token {
    Grammar,
    Fragment,
    Arrow,
    Colon,
    ColonColon,
    Semicolon,
    Pipe,
    LParen,
    RParen,
    LBrace,
    RBrace,
    Comma,
    At,
    LAngle,
    RAngle,
    Star,
    Plus,
    PlusAssign,
    Question,
    Dot,
    Range,
    Tilde,
    Assign,
    Hash,
    StringLit,
    CharClass,
    Identifier,
    IntLit,
    Eof,

    // Tokens the lexer could not form. Each names its own lexical problem, so
    // the token's `text` stays the source slice it is for every other kind.

    UnterminatedString,
    UnterminatedCharClass,
    InvalidEscape,
    UnexpectedChar,
}

impl G4Token {
    /// The kind a `Token` carries for this case.
    pub fn code(&self) -> i32 {
        return ReflectEnum::<G4Token>::discriminant(self);
    }

    pub fn name(&self) -> String {
        return match *self {
            _::Grammar => "grammar",
            _::Fragment => "fragment",
            _::Arrow => "->",
            _::Colon => ":",
            _::ColonColon => "::",
            _::Semicolon => ";",
            _::Pipe => "|",
            _::LParen => "(",
            _::RParen => ")",
            _::LBrace => "{",
            _::RBrace => "}",
            _::Comma => ",",
            _::At => "@",
            _::LAngle => "<",
            _::RAngle => ">",
            _::Star => "*",
            _::Plus => "+",
            _::PlusAssign => "+=",
            _::Question => "?",
            _::Dot => ".",
            _::Range => "..",
            _::Tilde => "~",
            _::Assign => "=",
            _::Hash => "#",
            _::StringLit => "string",
            _::CharClass => "char-class",
            _::Identifier => "identifier",
            _::IntLit => "int",
            _::Eof => "EOF",
            _::UnterminatedString => "unterminated string literal",
            _::UnterminatedCharClass => "unterminated character set",
            _::InvalidEscape => "invalid escape sequence",
            _::UnexpectedChar => "unexpected character",
        };
    }
}

pub struct Token {
    pub kind: i32,
    pub text: String,
    pub span: Span,
}

impl Token {
    pub fn new(kind: i32, text: String, span: Span) -> Token {
        return Token { kind, text, span };
    }
}
