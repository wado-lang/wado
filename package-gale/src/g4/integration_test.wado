}

test "merge css3 grammars" {
    let lexer_g = parse(#include_str("../../tests/grammars/css3Lexer.g4")).unwrap();
    let parser_g = parse(#include_str("../../tests/grammars/css3Parser.g4")).unwrap();
    let merged = merge_grammars([lexer_g, parser_g]);
    assert merged.name == "css3";
    assert merged.lexer_rules.len() > 20;
    assert merged.parser_rules.len() > 10;
}

