test "parse TypeScriptLexer.g4" {
    let input = #include_str("../../tests/grammars/TypeScriptLexer.g4");
    let result = parse(input);
    if let Err(e) = result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
    let g = result.unwrap();
    assert g.name == "TypeScriptLexer";
    assert g.parser_rules.is_empty();
    assert g.lexer_rules.len() > 20;
    // BackTickInside has `-> type(BackTick), popMode` — verify the type
    // override and popMode are both extracted from the lexer command list.
    let mut found_back_tick_inside = false;
    for let rule of g.lexer_rules {
        if rule.name == "BackTickInside" {
            if let Some(t) = &rule.type_override {
                assert *t == "BackTick", `expected type_override BackTick, got {*t}`;
            } else {
                panic("BackTickInside should have type_override");
            }
            assert rule.pop_mode == true;
            found_back_tick_inside = true;
        }
    }
    assert found_back_tick_inside;
}

