// The Rust grammar is the largest in the corpus; on small (≤2 vCPU)
// CI runners it parses near the default 5 s budget. Give it explicit
// headroom so the test reflects parser correctness, not transient
// scheduler oversubscription.
#[timeout_ms(15000)]
test "parse RustParser.g4" {
    let input = #include_str("../../tests/grammars/RustParser.g4");
    let result = parse(input);
    if let Err(e) = result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
    let g = result.unwrap();
    assert g.name == "RustParser";
    assert g.lexer_rules.is_empty();
    assert g.parser_rules.len() > 30;
}

test "parse TypeScriptLexer.g4" {
    let input = #include_str("../../tests/grammars/TypeScriptLexer.g4");
    let result = parse(input);
    if let Err(e) = result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
    let g = result.unwrap();
    assert g.name == "TypeScriptLexer";
    assert g.parser_rules.is_empty();
    assert g.lexer_rules.len() > 20;
    // BackTickInside has `-> type(BackTick), popMode` — verify the type
    // override and popMode are both extracted from the lexer command list.
    let mut found_back_tick_inside = false;
    for let rule of g.lexer_rules {
        if rule.name == "BackTickInside" {
            if let Some(t) = &rule.type_override {
                assert *t == "BackTick", `expected type_override BackTick, got {*t}`;
            } else {
                panic("BackTickInside should have type_override");
            }
            assert rule.pop_mode == true;
            found_back_tick_inside = true;
        }
    }
    assert found_back_tick_inside;
}

test "parse TypeScriptParser.g4" {
    let input = #include_str("../../tests/grammars/TypeScriptParser.g4");
    let result = parse(input);
    if let Err(e) = result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
    let g = result.unwrap();
    assert g.name == "TypeScriptParser";
    assert g.lexer_rules.is_empty();
    assert g.parser_rules.len() > 20;

    // singleExpression has a PowerExpression alternative carrying
    // `<assoc=right>` — the alt-prefix option that drives right-associative
    // code generation for `**`. See vendor/antlr4/doc/left-recursion.md.
    let mut found_power = false;
    for let rule of &g.parser_rules {
        if rule.name != "singleExpression" {
            continue;
        }
        for let alt of &rule.alternatives {
            if let Some(label) = &alt.label {
                if *label != "PowerExpression" {
                    continue;
                }
                found_power = true;
                assert alt.options.len() == 1, `expected 1 option on PowerExpression, got {alt.options.len()}`;
                assert alt.options[0].name == "assoc";
                if let Ident(v) = &alt.options[0].value {
                    assert *v == "right", `expected assoc=right, got assoc={*v}`;
                } else {
                    panic("expected Ident for assoc value");
                }
            }
        }
    }
    assert found_power, "TypeScriptParser singleExpression missing PowerExpression alt";
}

