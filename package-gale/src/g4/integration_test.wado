test "parse HTMLLexer.g4" {
    let input = #include_str("../../tests/grammars/HTMLLexer.g4");
    let result = parse(input);
    if let Err(e) = result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
    let g = result.unwrap();
    assert g.name == "HTMLLexer";
    assert g.parser_rules.is_empty();
    // Check modes
    assert g.lexer_rules[0].name == "HTML_COMMENT";
    assert g.lexer_rules[0].mode == 0;
    // Check mode names table
    assert g.mode_names.len() >= 3, `expected at least 3 modes, got {g.mode_names.len()}`;
    assert g.mode_names[0] == "DEFAULT_MODE";
    // TAG_CLOSE is in TAG mode
    let mut found_tag_close = false;
    let mut found_tag_whitespace = false;
    for let rule of g.lexer_rules {
        if rule.name == "TAG_CLOSE" {
            assert g.mode_names[rule.mode] == "TAG";
            assert rule.pop_mode == true;
            found_tag_close = true;
        }
        if rule.name == "TAG_OPEN" {
            assert rule.mode == 0;  // DEFAULT_MODE
            assert rule.push_mode >= 0, "TAG_OPEN should have pushMode(TAG)";
            assert g.mode_names[rule.push_mode] == "TAG";
        }
        if rule.name == "SCRIPT_BODY" {
            assert g.mode_names[rule.mode] == "SCRIPT";
            assert rule.pop_mode == true;
        }
        if rule.name == "TAG_WHITESPACE" {
            // -> channel(HIDDEN) sets channel to 1 (HIDDEN's predefined id).
            // ANTLR4 routes HIDDEN tokens to a separate channel without
            // discarding them, so `skip` must remain false.
            assert rule.channel == 1;
            assert rule.skip == false;
            found_tag_whitespace = true;
        }
    }
    assert found_tag_close;
    assert found_tag_whitespace;
}

