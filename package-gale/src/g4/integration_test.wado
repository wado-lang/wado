test "parse calculator.g4" {
    let input = #include_str("../../tests/grammars/calculator.g4");
    let g = parse(input).unwrap();
    assert g.name == "calculator";

    // Has many parser rules: equation, expression, multiplyingExpression, etc.
    assert g.parser_rules.len() > 5;

    // Has many lexer rules
    assert g.lexer_rules.len() > 10;

    // WS should have skip
    let last_rule = &g.lexer_rules[g.lexer_rules.len() - 1];
    assert last_rule.name == "WS";
    assert last_rule.skip == true;
}
