test "parse ll_multi_alt.g4" {
    let input = #include_str("../../tests/grammars/ll_multi_alt.g4");
    let g = parse(input).unwrap();
    assert g.name == "LLMultiAlt";
    assert g.parser_rules.len() == 3;
    // `a` is the multi-alt callee — two alternatives.
    assert g.parser_rules[1].name == "a";
    assert g.parser_rules[1].alternatives.len() == 2;
}

test "parse ll_lr_atom.g4" {
    let input = #include_str("../../tests/grammars/ll_lr_atom.g4");
    let g = parse(input).unwrap();
    assert g.name == "LLLRAtom";
    assert g.parser_rules.len() == 3;
    // `a` is the LR callee — alt 0 is the atom, alt 1 is `a '+' a`.
    assert g.parser_rules[1].name == "a";
    assert g.parser_rules[1].alternatives.len() == 2;
}

test "parse ll_ctx_follow.g4" {
    let input = #include_str("../../tests/grammars/ll_ctx_follow.g4");
    let g = parse(input).unwrap();
    assert g.name == "LLCtxFollow";
    // r, wrapper, a, b
    assert g.parser_rules.len() == 4;
}
