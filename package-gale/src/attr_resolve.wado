//! Attribute resolution for action / predicate bodies.
//!
//! Consumes the raw `$ident(.ident)?` references `attr_scan` finds and
//! resolves each against a per-rule environment (action.md, "Attribute
//! resolution"): element labels, rule args / returns / locals, unlabeled
//! element references by name, and the ANTLR specials. The result is a
//! `ResolvedAttr` per reference — a target classification plus the member
//! and the fragment span the substitution engine later rewrites. An
//! unresolvable reference is a loud error, never a silent passthrough.

use { ParserRule, Element, Alternative, AttrDecl } from "./ir.wado";
use { AttrRef, find_attr_refs } from "./attr_scan.wado";

/// What a `$name` reference resolves to. Determines how the substitution
/// engine rewrites it (value-channel field, context-API call, ...).
pub variant AttrTarget {
    /// A parser special: `$text`, `$ctx`, `$start`, `$stop`, `$_p`.
    ParserSpecial,
    /// A lexer special: `$text`, `$type`, `$channel`, `$mode`.
    LexerSpecial,
    /// A rule argument / returns / locals attribute (a value-channel field).
    RuleAttr,
    /// A single-value label (`x=E`) bound to a token reference.
    TokenLabel,
    /// A single-value label (`x=e`) bound to a rule reference.
    RuleLabel,
    /// A list label (`x+=E`).
    ListLabel,
    /// An unlabeled token reference by name (`$ID`).
    TokenRef,
    /// An unlabeled rule reference by name (`$e`).
    RuleRef,
}

/// A resolved attribute reference: its target classification, the base
/// name, the `.member` suffix (validated), and the fragment span to rewrite.
pub struct ResolvedAttr {
    pub target: AttrTarget,
    pub name: String,
    pub member: Option<String> = null,
    /// For a `RuleLabel` / `RuleRef`, the referenced parser rule's name (so
    /// codegen can check it exposes a value channel and resolve the member
    /// against its `returns`). Empty for non-rule targets.
    pub rule_name: String = "",
    pub start: i32,
    pub end: i32,
}

struct LabelInfo {
    name: String,
    list: bool,
    is_token: bool,
    /// The referenced element's name: the rule name for a rule label (for member
    /// validation against its `returns`) or the token name for a token label
    /// (for the by-name alias). Empty when neither applies.
    ref_name: String,
}

/// The attribute environment of one parser rule: the names it defines.
pub struct AttrEnv {
    labels: List<LabelInfo>,
    attrs: List<String>,
    token_refs: List<String>,
    rule_refs: List<String>,
    /// `underlying_name → label` aliases: a labeled ref (`q=e`, `x=ID`) is also
    /// reachable by the referenced element's name (`$e`, `$ID`), resolving to the
    /// label's storage. Registered only when that name has a single labeled
    /// occurrence and no unlabeled one, matching ANTLR erroring on ambiguity.
    label_aliases: List<[String, String]>,
}

/// Resolve every attribute reference in `body` against `rule`'s environment.
/// `rules` is the parser-rule table, used to validate a rule member against
/// the referenced rule's `returns` fields. Returns the resolved list, or an
/// error message naming the first unresolvable reference / member.
pub fn resolve_attrs(body: &String, rule: &ParserRule, rules: &List<ParserRule>) -> Result<List<ResolvedAttr>, String> {
    let env = build_attr_env(rule);
    let refs = find_attr_refs(body);
    let mut out: List<ResolvedAttr> = [];
    for let r of &refs {
        let resolved = resolve_one(r, &env, rules)?;
        out.push(resolved);
    }
    return Result::Ok(out);
}

fn resolve_one(r: &AttrRef, env: &AttrEnv, rules: &List<ParserRule>) -> Result<ResolvedAttr, String> {
    for let lab of &env.labels {
        if lab.name == r.name {
            let target = label_target(lab);
            check_member(r, &target, &lab.ref_name, rules)?;
            return ok_attr(r, target, &lab.ref_name);
        }
    }
    if contains(&env.attrs, &r.name) {
        check_member(r, &AttrTarget::RuleAttr, &"", rules)?;
        return ok_attr(r, AttrTarget::RuleAttr, &"");
    }
    if is_parser_special(&r.name) {
        check_member(r, &AttrTarget::ParserSpecial, &"", rules)?;
        return ok_attr(r, AttrTarget::ParserSpecial, &"");
    }
    if contains(&env.token_refs, &r.name) {
        check_member(r, &AttrTarget::TokenRef, &"", rules)?;
        return ok_attr(r, AttrTarget::TokenRef, &"");
    }
    if contains(&env.rule_refs, &r.name) {
        check_member(r, &AttrTarget::RuleRef, &r.name, rules)?;
        return ok_attr(r, AttrTarget::RuleRef, &r.name);
    }
    // Fallback only: a labeled ref reachable by its underlying name (`$e` for
    // `q=e`). Tried after direct resolution so it never shadows a same-named
    // declared attribute or label.
    let alias = alias_target(env, &r.name);
    if alias != r.name {
        for let lab of &env.labels {
            if lab.name == alias {
                let target = label_target(lab);
                check_member(r, &target, &lab.ref_name, rules)?;
                return ok_attr_named(r, &alias, target, &lab.ref_name);
            }
        }
    }
    return Result::Err(`unresolved attribute reference '$${r.name}'`);
}

fn label_target(lab: &LabelInfo) -> AttrTarget {
    return if lab.list {
        AttrTarget::ListLabel;
    } else if lab.is_token {
        AttrTarget::TokenLabel;
    } else {
        AttrTarget::RuleLabel;
    };
}

fn ok_attr(r: &AttrRef, target: AttrTarget, rule_name: &String) -> Result<ResolvedAttr, String> {
    return ok_attr_named(r, &r.name, target, rule_name);
}

/// Like `ok_attr` but with an explicit binding `name` (the fragment span still
/// comes from `r`). Used when `$e` aliases a labeled ref `q=e`: the binding name
/// is the label (`q`), the rewritten span the original `$e`.
fn ok_attr_named(r: &AttrRef, name: &String, target: AttrTarget, rule_name: &String) -> Result<ResolvedAttr, String> {
    return Result::Ok(ResolvedAttr {
        target,
        name: *name,
        member: r.member,
        rule_name: *rule_name,
        start: r.start,
        end: r.end,
    });
}

/// Map a reference name through the label-alias table: a labeled ref `q=e` /
/// `x=ID` makes `$e` / `$ID` resolve to its label. Returns the name unchanged
/// when it is not an alias.
fn alias_target(env: &AttrEnv, name: &String) -> String {
    for let a of &env.label_aliases {
        if a.0 == *name {
            return a.1;
        }
    }
    return *name;
}

/// Validate `r.member` against what `target` legally exposes. A token-like
/// target admits the token member set; a rule-like target admits the rule
/// pseudo-members plus the referenced rule's `returns` fields; specials and
/// scalar attrs admit no member.
fn check_member(r: &AttrRef, target: &AttrTarget, rule_name: &String, rules: &List<ParserRule>) -> Result<(), String> {
    let member = match &r.member {
        Some(m) => *m,
        None => {
            return Result::Ok(());
        },
    };
    let ok = match *target {
        TokenLabel => is_token_member(&member),
        TokenRef => is_token_member(&member),
        RuleLabel => is_rule_member(&member, rule_name, rules),
        RuleRef => is_rule_member(&member, rule_name, rules),
        // `$start` / `$stop` are the rule's first / last token, so they take the
        // token member set; `$ctx` exposes `toStringTree`; `$text` / `$_p` take
        // no member.
        ParserSpecial => r.name matches { "start" | "stop" } && is_token_member(&member)
            || r.name == "ctx" && member == "toStringTree",
        LexerSpecial => false,
        RuleAttr => false,
        ListLabel => false,
    };
    if ok {
        return Result::Ok(());
    }
    return Result::Err(`invalid member '.$${member}' on '$${r.name}'`);
}

fn is_token_member(m: &String) -> bool {
    return m matches { "text" | "type" | "line" | "pos" | "index" | "channel" | "int" };
}

fn is_rule_member(m: &String, rule_name: &String, rules: &List<ParserRule>) -> bool {
    if is_rule_pseudo_member(m) {
        return true;
    }
    for let rule of rules {
        if rule.name == *rule_name {
            for let d of &rule.returns_decls {
                if d.name == *m {
                    return true;
                }
            }
        }
    }
    return false;
}

/// The CST pseudo-members every rule reference exposes (`.text` / `.ctx` /
/// `.start` / `.stop`), independent of its declared `returns`.
pub fn is_rule_pseudo_member(name: &String) -> bool {
    return name matches { "text" | "ctx" | "start" | "stop" };
}

fn is_parser_special(name: &String) -> bool {
    return is_rule_pseudo_member(name) || *name == "_p";
}

fn contains(names: &List<String>, name: &String) -> bool {
    for let n of names {
        if *n == *name {
            return true;
        }
    }
    return false;
}

/// Build a rule's attribute environment by collecting its declared
/// attributes and walking its alternatives for labels and unlabeled refs.
pub fn build_attr_env(rule: &ParserRule) -> AttrEnv {
    let mut attrs: List<String> = [];
    for let d of &rule.args {
        attrs.push(d.name);
    }
    for let d of &rule.returns_decls {
        attrs.push(d.name);
    }
    for let d of &rule.locals_decls {
        attrs.push(d.name);
    }
    let mut labels: List<LabelInfo> = [];
    let mut token_refs: List<String> = [];
    let mut rule_refs: List<String> = [];
    for let alt of &rule.alternatives {
        for let e of &alt.elements {
            collect_env_element(e, &mut labels, &mut token_refs, &mut rule_refs);
        }
    }
    let label_aliases = build_label_aliases(&labels, &rule_refs, &token_refs);
    return AttrEnv { labels, attrs, token_refs, rule_refs, label_aliases };
}

/// Build the `underlying_name → label` alias table so a labeled ref is also
/// reachable by the referenced element's name: `$e` for `q=e`, `$ID` for
/// `x=ID`. Registered only when that name has exactly one labeled occurrence
/// and no unlabeled reference (of the same token/rule kind); an ambiguous
/// reference stays unresolved, a loud error as ANTLR reports. The alias is a
/// fallback (`resolve_one` tries direct resolution first), so it never shadows
/// a same-named declared attribute or label.
fn build_label_aliases(
    labels: &List<LabelInfo>,
    rule_refs: &List<String>,
    token_refs: &List<String>,
) -> List<[String, String]> {
    let mut aliases: List<[String, String]> = [];
    for let lab of labels {
        if lab.list || lab.ref_name == "" {
            continue;
        }
        let refs = if lab.is_token { token_refs } else { rule_refs };
        if count_labeled_ref(labels, &lab.ref_name, lab.is_token) != 1 || contains(refs, &lab.ref_name) {
            continue;
        }
        aliases.push([lab.ref_name, lab.name]);
    }
    return aliases;
}

fn count_labeled_ref(labels: &List<LabelInfo>, ref_name: &String, is_token: bool) -> i32 {
    let mut n = 0;
    for let lab of labels {
        if !lab.list && lab.is_token == is_token && lab.ref_name == *ref_name {
            n += 1;
        }
    }
    return n;
}

fn collect_env_element(
    elem: &Element,
    labels: &mut List<LabelInfo>,
    token_refs: &mut List<String>,
    rule_refs: &mut List<String>,
) {
    match *elem {
        Label(lab) => {
            let [is_token, ref_name] = classify_labeled(&lab.element);
            labels.push(LabelInfo { name: lab.name, list: lab.list, is_token, ref_name });
        },
        RuleRef(rr) => rule_refs.push(rr.name),
        TokenRef(tr) => token_refs.push(tr.name),
        Group(g) => {
            for let alt of &g.alternatives {
                for let e of &alt.elements {
                    collect_env_element(e, labels, token_refs, rule_refs);
                }
            }
        },
        Repeat(rep) => collect_env_element(&rep.element, labels, token_refs, rule_refs),
        Not(n) => collect_env_element(&n.element, labels, token_refs, rule_refs),
        _ => {
        },
    }
}

/// Classify a labeled element as token-bound or rule-bound, returning
/// `[is_token, ref_name]`. A `RuleRef` is a rule (its name backs member
/// validation); a `TokenRef` is a token (its name backs the by-name alias); a
/// `Literal` is a token with no addressable name. Other shapes default
/// token-like.
fn classify_labeled(elem: &Element) -> [bool, String] {
    return match *elem {
        RuleRef(rr) => [false, rr.name],
        TokenRef(tr) => [true, tr.name],
        Literal(_) => [true, ""],
        Not(n) => classify_labeled(&n.element),
        _ => [true, ""],
    };
}
