//! What a corpus tool needs either side of its parser: the paths to process,
//! where in a file a byte offset falls, and the baseline its count ratchets
//! against.

use { println, eprintln, Stdout, Stderr } from "core:cli";
use fs from "core:fs";
use { Preopens } from "core:fs";
use { TreeMap } from "core:collections";
use { from_string, to_string_pretty } from "core:json";

/// The paths to process: every `--paths-from <file>` list, one path per line,
/// plus any bare argument ending in `extension`. A list that cannot be read
/// yields its own path, so the run reports it rather than looking clean.
pub fn collect_paths<S: AsStrSlice>(argv: &List<String>, extension: S) -> List<String> with (Stderr, Preopens) {
    let mut paths: List<String> = [];
    for let mut i = 0; i < argv.len(); i += 1 {
        if argv[i] == "--paths-from" {
            assert i + 1 < argv.len(), "--paths-from needs a file";
            i += 1;
            match fs::read_to_string(&argv[i]) {
                Ok(list) => {
                    for let line of list.lines() {
                        if !line.is_empty() {
                            paths.push(line);
                        }
                    }
                },
                Err(e) => {
                    eprintln(`error: ${e}`);
                    paths.push(argv[i]);
                },
            }
        } else if argv[i].ends_with(extension) {
            paths.push(argv[i]);
        }
    }
    return paths;
}

/// The 1-based line holding byte offset `at`.
pub fn line_of<S: AsStrSlice>(source: S, at: i32) -> i32 {
    let mut line = 1;
    let mut i = 0;
    while i < at && i < source.len() {
        if source.get_byte_unchecked(i) == b'\n' {
            line += 1;
        }
        i += 1;
    }
    return line;
}

fn read_baseline(path: &String) -> Option<TreeMap<String, i32>> with (Stderr, Preopens) {
    let text = match fs::read_to_string(path) {
        Ok(s) => s,
        Err(e) => {
            eprintln(`error: ${e}`);
            return null;
        },
    };
    return match from_string::<TreeMap<String, i32>>(text) {
        Ok(map) => Option::Some(map),
        Err(e) => {
            eprintln(`error: ${path}: ${e:?}`);
            return null;
        },
    };
}

fn write_baseline(path: &String, counts: &TreeMap<String, i32>) -> bool with (Stderr, Preopens) {
    let text = match to_string_pretty(counts, Option::Some('\n')) {
        Ok(s) => s,
        Err(e) => {
            eprintln(`error: cannot serialize the baseline: ${e:?}`);
            return false;
        },
    };
    if let Err(e) = fs::write(path, &text) {
        eprintln(`error: ${e}`);
        return false;
    }
    return true;
}

fn total(counts: &TreeMap<String, i32>) -> i32 {
    let mut sum = 0;
    for let [_path, n] of counts.entries() {
        sum += *n;
    }
    return sum;
}

/// Every file counting more than `baseline` allows, as `[file, was, now]`.
fn grown(counts: &TreeMap<String, i32>, baseline: &TreeMap<String, i32>) -> List<[String, i32, i32]> {
    let mut out: List<[String, i32, i32]> = [];
    for let [path, now] of counts.entries() {
        let was = baseline.get(*path).unwrap_or(0);
        if *now > was {
            out.push([*path, was, *now]);
        }
    }
    return out;
}

/// Holds `counts` (file path to how many `noun` it carries, omitting the files
/// at zero) to the baseline at `baseline_path`, and with `update` records them
/// there. Returns the exit status. A file that grew fails either way: recording
/// it would license what the check is there to refuse, so the baseline only
/// ever ratchets down. `remedy` tells the reader what to do about a growth.
pub fn ratchet(
    baseline_path: String,
    counts: &TreeMap<String, i32>,
    update: bool,
    noun: String,
    remedy: String,
) -> i32 with (Stdout, Stderr, Preopens) {
    let Some(baseline) = read_baseline(&baseline_path) else {
        return 1;
    };
    let rows = grown(counts, &baseline);
    if rows.len() > 0 {
        eprintln(`error: ${noun} added:`);
        for let row of &rows {
            eprintln(`  ${row.0}: ${row.1} -> ${row.2}`);
        }
        eprintln("");
        eprintln(remedy);
        return 1;
    }
    let left = total(counts);
    if update {
        if !write_baseline(&baseline_path, counts) {
            return 1;
        }
        println(`baseline: ${left} ${noun} in ${counts.len()} files`);
        return 0;
    }
    let shrunk = total(&baseline) - left;
    let note = if shrunk > 0 { `, ${shrunk} fewer than the baseline — run --update` } else { "" };
    println(`ok: no file gained ${noun} (${left} left${note})`);
    return 0;
}

test "line_of counts the newlines before the offset" {
    let source = "a\nbb\nccc";
    assert line_of(&source, 0) == 1;
    assert line_of(&source, 2) == 2;
    assert line_of(&source, 5) == 3;
    assert line_of(&source, source.len()) == 3;
}
