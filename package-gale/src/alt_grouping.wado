//! The lookahead decision over a set of alternatives, and the sorting
//! heuristics that order what it picks between.
//!
//! One decision, produced here and elsewhere only rendered:
//!  * `alt_class` says what each alternative matches;
//!  * `compute_overlap_groups_of` partitions them into branches;
//!  * `group_branch_admits` says what each branch admits, and `fallback_last`
//!    puts the branch no lookahead decides at the end of the chain.
//!
//! Every decision site goes through those four. The lowerer interning the kind
//! sets, the surface emit walker and the op-only walker are three readers of
//! one answer, so none can partition a group differently from the others
//! (soundness invariant 9). Only the rendering — the `if` chain, the scan
//! cursor vs `p.peek_kind()` — belongs to the caller.
//!
//! Within a branch, order is `sort_group_by_specificity`,
//! `sort_group_by_mandatory_count_desc`, `sort_group_by_element_count`. The
//! priority tier constants (`ALT_PRIORITY_*`) and the per-alt priority key
//! (`alt_sort_priority`) are the contract the parse-side and scan-side
//! dispatch share. See the CLAUDE.md "Failed Approaches" section for why the
//! bands are split the way they are.

use { Alternative, Element } from "./ir.wado";
use {
    GenContext,
    Admits,
    admits_is_untestable,
    admits_or_untestable,
    is_nullable,
    sets_overlap,
} from "./gen_context.wado";
use {
    AltClass,
    DirectDispatch,
    MultiAltDispatch,
    ScanGroupElement,
    alt_class_first_set,
    alt_class_is_open_ended,
} from "./gir.wado";
use { dedup_append_arr } from "./gen_util.wado";

/// One branch of a decision: the lookahead that admits it, the
/// alternative-initial predicate it is further gated by, and the alternatives
/// it holds. `alts` are slots in whatever index space the partition was built
/// in, never assumed to be the rule's alternative indices.
pub struct DecisionBranch {
    pub test: Admits,
    /// Rendered `&& (…)` suffix, empty where the branch has no predicate.
    pub gate: String,
    pub alts: List<i32>,
}

/// A branch the lookahead cannot decide, gated by nothing, decides nothing the
/// branches after it could still decide, so it is the chain's `else`. Moving it
/// there is what keeps a later alternative from being emitted behind a test
/// that can never fail. A gated one can decline, so it stays where it is.
pub fn is_decision_fallback(b: &DecisionBranch) -> bool {
    return admits_is_untestable(&b.test) && b.gate.is_empty();
}

/// Branches the lookahead cannot decide are one branch, not a chain of arms
/// only the first of which is reachable. Their alternatives share it and the
/// scan lengths pick between them, which is what a branch holding several
/// always meant. An open-ended branch is not among them: it admits every token
/// by decision, so it keeps its place and the partition has already merged
/// every alternative into it.
pub fn fallback_last(branches: &List<DecisionBranch>) -> List<DecisionBranch> {
    let mut out: List<DecisionBranch> = [];
    let mut fallback_alts: List<i32> = [];
    for let b of branches {
        if is_decision_fallback(b) {
            for let a of &b.alts {
                fallback_alts.push(*a);
            }
        } else {
            out.push(*b);
        }
    }
    if !fallback_alts.is_empty() {
        out.push(DecisionBranch { test: Admits::Untestable, gate: "", alts: fallback_alts.sorted() });
    }
    return out;
}

/// The union of the first sets of one branch's alternatives — what its
/// lookahead test admits.
pub fn group_first_union(group: &List<i32>, classes: &List<AltClass>) -> List<String> {
    let mut union_first: List<String> = [];
    for let idx of group {
        dedup_append_arr(&mut union_first, &alt_class_first_set(&classes[*idx]));
    }
    return union_first;
}

/// The union over every alternative a partition covers — the expected set a
/// no-viable-alternative report names.
pub fn classes_union(classes: &List<AltClass>) -> List<String> {
    return group_first_union(&identity_slots(classes.len()), classes);
}

/// What a branch admits. An open-ended alternative admits every token and says
/// so exactly, which is why it keeps its place; a union that comes out empty
/// is an alternative the lookahead cannot decide, which does not.
pub fn group_branch_admits(group: &List<i32>, classes: &List<AltClass>) -> Admits {
    if group.iter_ref().any(|slot: &i32| alt_class_is_open_ended(&classes[*slot])) {
        return Admits::Everything;
    }
    return admits_or_untestable(&group_first_union(group, classes));
}

/// The whole decision over a classified alternative list: the partition, what
/// each branch admits, and the untestable branch moved last. Gates are the
/// caller's to add — they are a surface-alternative property the classification
/// does not carry.
pub fn class_decision_branches(classes: &List<AltClass>) -> List<DecisionBranch> {
    let mut branches: List<DecisionBranch> = [];
    for let group of &compute_overlap_groups_of(classes) {
        branches.push(DecisionBranch {
            test: group_branch_admits(group, classes),
            gate: "",
            alts: *group,
        });
    }
    return fallback_last(&branches);
}

/// The branches a scan group takes, off the classification lower baked. Emit
/// renders them against the scan cursor's lookahead and the lowerer interns
/// the kind sets they test; both read this list, so the set interned is the
/// set rendered.
pub fn scan_decision_branches(ge: &ScanGroupElement) -> List<DecisionBranch> {
    return class_decision_branches(&ge.alt_classes);
}

/// The branches a baked `Direct` dispatch takes. Each holds one alternative,
/// and what it admits goes through `group_branch_admits` like every other
/// branch — so a `Direct` chain and the surface chain cannot disagree about
/// which branch is the fallback.
pub fn direct_dispatch_branches(dd: &DirectDispatch) -> List<DecisionBranch> {
    let mut branches: List<DecisionBranch> = [];
    for let br of &dd.branches {
        branches.push(DecisionBranch {
            test: group_branch_admits(&[0], &[br.alt_class]),
            gate: "",
            alts: [br.alt_index],
        });
    }
    return fallback_last(&branches);
}

/// The branches a baked dispatch takes, for a reader that has not yet split on
/// its kind. A `Tournament` tests nothing: every alternative is a candidate
/// and the scan lengths decide.
pub fn dispatch_branches(d: &MultiAltDispatch) -> List<DecisionBranch> {
    return match d {
        Direct(dd) => direct_dispatch_branches(dd),
        Tournament(td) => [
            DecisionBranch { test: Admits::Everything, gate: "", alts: td.alts },
        ],
    };
}

/// The one classifier. `first_set` is the alternative's own, already computed
/// by the caller that needs it anyway.
pub fn alt_class(alt: &Alternative, first_set: &List<String>, ctx: &mut GenContext) -> AltClass {
    if alt_is_open_ended(alt, ctx) {
        return AltClass::OpenEnded;
    }
    if first_set.is_empty() {
        return AltClass::Epsilon;
    }
    return AltClass::Selects(*first_set);
}

/// `alt_class` for a caller that has no first set to hand.
pub fn alt_class_of(alt: &Alternative, ctx: &mut GenContext) -> AltClass {
    let mut visiting: List<String> = [];
    let first = ctx.first_of_alt(alt, &mut visiting);
    return alt_class(alt, &first, ctx);
}

/// True when `alt` admits every token: it has no first set to be selected by,
/// and it consumes at least one token, so what it matches is a token of any
/// kind. `.` and `~X` are why a first set comes out empty — `first_of_element`
/// cannot enumerate "every token kind" — whether they are written in the
/// alternative or reached through a rule that is.
///
/// Such an alt overlaps every other alt that consumes a token, so it is merged
/// into the surrounding overlap group: the dispatch routes through the scan
/// tournament, which falls back to it when a more specific alt's scan fails,
/// instead of a kind-check that commits to the first alt whose FIRST set
/// covers the lookahead.
///
/// The other reason a first set comes out empty is an alternative that derives
/// only the empty string. That one is selected by nothing, not by everything,
/// and the two must not be told apart by looking at the surface elements: that
/// answers for a wildcard written in place and not for one behind a rule ref,
/// so the walkers that ask differently partition differently.
pub fn alt_is_open_ended(alt: &Alternative, ctx: &mut GenContext) -> bool {
    let mut visiting: List<String> = [];
    return alt_reaches_open_end(alt, ctx, &mut visiting);
}

/// Whether a position the alternative can reach — every element before it
/// nullable — matches a token no first set names. Having a first set settles
/// nothing: `A? .` is selected by `a` and by every other token too, and
/// reading the first set alone called it narrow.
fn alt_reaches_open_end(alt: &Alternative, ctx: &mut GenContext, visiting: &mut List<String>) -> bool {
    for let elem of &alt.elements {
        if element_reaches_open_end(elem, ctx, visiting) {
            return true;
        }
        let mut nullable_visiting: List<String> = [];
        if !ctx.element_is_nullable_deep(elem, &mut nullable_visiting) {
            return false;
        }
    }
    return false;
}

/// `.` and `~X` carry the empty static FIRST set, and neither a label, a
/// `( … )`, a repeat nor a rule reference changes what is behind them — so
/// `w=.`, `(~X)`, `(.)+` and a call to `w : . ;` are all as open-ended as the
/// bare form. `visiting` breaks the recursion on a left-recursive rule.
fn element_reaches_open_end(elem: &Element, ctx: &mut GenContext, visiting: &mut List<String>) -> bool {
    return match elem {
        Wildcard(_) | Not(_) => true,
        Label(lab) => element_reaches_open_end(&lab.element, ctx, visiting),
        Repeat(rep) => element_reaches_open_end(&rep.element, ctx, visiting),
        Group(g) => {
            let mut any = false;
            for let alt of &g.alternatives {
                if alt_reaches_open_end(alt, ctx, visiting) {
                    any = true;
                    break;
                }
            }
            any;
        },
        RuleRef(r) => rule_reaches_open_end(&r.name, ctx, visiting),
        TokenRef(_) | Literal(_) => false,
    };
}

fn rule_reaches_open_end(name: &String, ctx: &mut GenContext, visiting: &mut List<String>) -> bool {
    if visiting.iter_ref().any(|v| *v == *name) {
        return false;
    }
    let idx = ctx.rule_index_of(name);
    if idx < 0 {
        return false;
    }
    visiting.push(*name);
    let alts = ctx.parser_rules()[idx].alternatives;
    let mut any = false;
    for let alt of &alts {
        if alt_reaches_open_end(alt, ctx, visiting) {
            any = true;
            break;
        }
    }
    visiting.pop();
    return any;
}

/// The classification of each alternative a partition covers, in the index
/// space its first sets are in. `alt_of` maps a slot to its alternative, so a
/// partition over a subset supplies its own mapping instead of assuming the
/// two spaces coincide.
pub fn alt_classes(
    alt_of: &List<i32>,
    alts: &List<Alternative>,
    first_sets: &List<List<String>>,
    ctx: &mut GenContext,
) -> List<AltClass> {
    assert alt_of.len() == first_sets.len(), "one alternative per first set";
    let mut out: List<AltClass> = [];
    for let mut slot = 0; slot < alt_of.len(); slot += 1 {
        out.push(alt_class(&alts[alt_of[slot]], &first_sets[slot], ctx));
    }
    return out;
}

/// `alt_classes` over a whole alternative list, for a caller with no first
/// sets to hand and no subset to map.
pub fn alt_classes_of(alts: &List<Alternative>, ctx: &mut GenContext) -> List<AltClass> {
    let mut out: List<AltClass> = [];
    for let alt of alts {
        out.push(alt_class_of(alt, ctx));
    }
    return out;
}

/// The identity mapping, for a partition over `alts` itself.
pub fn identity_slots(n: i32) -> List<i32> {
    let mut out: List<i32> = [];
    for let mut i = 0; i < n; i += 1 {
        out.push(i);
    }
    return out;
}

/// The partition every decision site branches on, from the classification and
/// nothing else. Both emit walkers call this — the surface one over the
/// classes it computes, the op-only one over the classes lower baked — so a
/// group cannot come out partitioned one way in one and another way in the
/// other (invariant 9).
///
/// An open-ended alternative's effective first set is the universal token set,
/// so no lookahead test separates any alternative from it and they all merge
/// into one branch. Without the merge the dispatch emits `if peek_kind == TK_X
/// … else { open-ended }` and commits to `TK_X`'s alt whenever the lookahead
/// matches, even where that alt's deeper structure cannot succeed —
/// `(assign | .)` over an `ID` not followed by `=` is the canonical example.
/// An epsilon alternative joins the merge too: left out of it, it became a
/// branch of its own that the open-ended alternative's unconditional branch
/// shadowed. Inside, it is ranked as epsilon and wins where nothing longer
/// scans (`( A | . | )` on no input).
pub fn compute_overlap_groups_of(classes: &List<AltClass>) -> List<List<i32>> {
    let n = classes.len();
    if n >= 2 && classes.iter_ref().any(|c: &AltClass| alt_class_is_open_ended(c)) {
        return [identity_slots(n)];
    }
    let mut first_sets: List<List<String>> = [];
    for let c of classes {
        first_sets.push(alt_class_first_set(c));
    }
    return compute_overlap_groups(&first_sets);
}

pub fn compute_overlap_groups(first_sets: &List<List<String>>) -> List<List<i32>> {
    let n = first_sets.len();
    let mut group_ids: List<i32> = [];
    for let mut i = 0; i < n; i += 1 {
        group_ids.push(i);
    }
    for let mut i = 0; i < n; i += 1 {
        for let mut j = i + 1; j < n; j += 1 {
            if sets_overlap(&first_sets[i], &first_sets[j]) {
                let gi = group_ids[i];
                let gj = group_ids[j];
                if gi != gj {
                    for let mut k = 0; k < n; k += 1 {
                        if group_ids[k] == gj {
                            group_ids[k] = gi;
                        }
                    }
                }
            }
        }
    }
    let mut seen_ids: List<i32> = [];
    let mut groups: List<List<i32>> = [];
    for let mut i = 0; i < n; i += 1 {
        let gid = group_ids[i];
        let mut found = -1;
        for let mut s = 0; s < seen_ids.len(); s += 1 {
            if seen_ids[s] == gid {
                found = s;
                break;
            }
        }
        if found >= 0 {
            groups[found].push(i);
        } else {
            seen_ids.push(gid);
            groups.push([i]);
        }
    }
    return groups;
}

pub fn has_multi_alt_groups(groups: &List<List<i32>>) -> bool {
    return groups.iter_ref().any(|g| g.len() > 1);
}

pub fn sort_group_by_specificity(group: &mut List<i32>, first_sets: &List<List<String>>) {
    // A smaller first set is the more specific alt, so it is tried first.
    let sets = first_sets;
    group.sort_by(|a: &i32, b: &i32| {
        let sa = sets[*a].len();
        let sb = sets[*b].len();
        if sa != sb {
            return sa.cmp(&sb);
        }
        return a.cmp(b);
    });
}

// Priority bands consumed by `alt_sort_priority` and friends. Higher
// = try first.
//
// `MultiTokenLed` (4) is most specific: a multi-element alt whose
// first non-nullable element is a fixed token (e.g. `K_CAST '(' expr
// K_AS type_name ')'`). The leading token uniquely identifies the
// alt, so committing on first match is safe.
//
// `BareRuleRef` (3) is the catch-all rank: a single-RuleRef alt
// whose body can match complex internal patterns (`join_clause`,
// `expr`). Ordered before `MultiRuleRefLed` so the scan cascade
// tries the catch-all early; this is a tie-break for emission order
// only — the runtime tournament decides the winner by scan length,
// with ties resolved to the first grammar alt (ANTLR4's ambiguity
// resolution), so the band ordering does not decide correctness.
//
// `MultiRuleRefLed` (2) is a multi-element alt whose first non-
// nullable element is itself a RuleRef. Less specific than
// `BareRuleRef` because the RuleRef prefix is shared with the
// catch-all sibling.
//
// `BareToken` (1) is a single Token/Literal alt — the cheapest
// fallback (e.g. `K_INSERT` alone).
pub global ALT_PRIORITY_MULTI_TOKEN_LED: i32 = 4;
pub global ALT_PRIORITY_BARE_RULE_REF: i32 = 3;
pub global ALT_PRIORITY_MULTI_RULE_REF_LED: i32 = 2;
pub global ALT_PRIORITY_BARE_TOKEN: i32 = 1;

pub fn alt_sort_priority(alt: &Alternative) -> i32 {
    if alt.elements.len() == 1 {
        let elem = &alt.elements[0];
        if let RuleRef(_) = elem {
            return ALT_PRIORITY_BARE_RULE_REF;
        }
        return ALT_PRIORITY_BARE_TOKEN;
    }
    // Multi-element: check first non-nullable element.
    for let elem of alt.elements {
        if is_nullable(&elem) {
            continue;
        }
        if let TokenRef(_) | Literal(_) = elem {
            return ALT_PRIORITY_MULTI_TOKEN_LED;
        }
        break;
    }
    return ALT_PRIORITY_MULTI_RULE_REF_LED;
}

/// Sort `group` so the alt with the most MANDATORY (non-deeply-
/// nullable) elements comes first, breaking ties by `alt_sort_priority`
/// (single-RuleRef catch-alls win against multi-element-RuleRef
/// siblings) and finally source order. Used by the prediction tree's
/// `Ambiguous` case (and the matching parse-side group dispatches) to
/// pick the longer MANDATORY match between alts that share a prefix.
///
/// Counting mandatory elements only is the LL distinguisher:
/// `( a b | a )` (where `b` is mandatory) sorts the 2-elem alt first,
/// while `( a b? | a )` (where `b?` is optional) ties on mandatory
/// length and falls through to priority. The order affects only which
/// scan is emitted first — the runtime tournament picks the longest
/// scan, resolving ties to the first grammar alt.
pub fn sort_group_by_mandatory_count_desc(group: &mut List<i32>, alts: &List<Alternative>, ctx: &mut GenContext) {
    let mut keyed: List<[i32, i32, i32]> = [];
    for let mut i = 0; i < group.len(); i += 1 {
        let idx = group[i];
        let len = ll_match_length(&alts[idx], ctx);
        keyed.push([len, alt_sort_priority(&alts[idx]), idx]);
    }
    keyed.sort_by(|a: &[i32, i32, i32], b: &[i32, i32, i32]| {
        if a.0 != b.0 {
            return b.0.cmp(&a.0);
        }
        if a.1 != b.1 {
            return b.1.cmp(&a.1);
        }
        return a.2.cmp(&b.2);
    });
    for let mut i = 0; i < keyed.len(); i += 1 {
        group[i] = keyed[i].2;
    }
}

/// LL-aware "match length" for `alt`, used to sort group alternatives so
/// the more specific LL alt wins on overlap-prefix ties. Counts every
/// mandatory top-level element plus every *trailing* deep-nullable
/// element that is first-exact (single-token-derived; see
/// `GenContext::element_is_first_exact`).
///
/// Why this is the right key: a first-exact nullable trailing element
/// like `b?` (where `b : Y`) is "1 token whose presence is decisive" —
/// when `Y` is in the input, alt 0 of `(a b? | a)` is the LL-correct
/// pick because `b?` will fire and consume `Y`. Counting it as a
/// pseudo-mandatory token sorts alt 0 ahead of the bare-RuleRef
/// catch-all alt 1, mirroring ANTLR4's full-context LL preference for
/// the longer meaningful match. Multi-element nullable structures
/// (SQLite's `(',' tor)*` Star) stay at the original count because
/// their first set is not first-exact, preserving the join-clause
/// catch-all behaviour their grammars depend on.
///
/// The `seen_mandatory` gate restricts the trailing-nullable bonus to
/// nullables that follow a committed token. A *leading* nullable like
/// `b?` in `( b? a c | a c )` cannot disambiguate length: the runtime
/// has not yet committed to either alt at that position, so claiming
/// "alt 0 has 3 tokens" is no better signal than "alt 1 has 2" —
/// either alt's `a c` will match. Counting only post-mandatory
/// nullables means the bonus fires exactly when it can shorten the
/// LL decision: after a shared prefix has committed, a tail-position
/// `b?` whose presence is decisive elects the longer alt.
pub fn ll_match_length(alt: &Alternative, ctx: &mut GenContext) -> i32 {
    let mut count: i32 = 0;
    let mut seen_mandatory: bool = false;
    for let elem of &alt.elements {
        let mut visiting: List<String> = [];
        if !ctx.element_is_nullable_deep(elem, &mut visiting) {
            count += 1;
            seen_mandatory = true;
        } else if seen_mandatory && ctx.element_is_first_exact(elem) {
            count += 1;
        }
    }
    return count;
}

pub fn sort_group_by_element_count(group: &mut List<i32>, alts: &List<Alternative>) {
    // The source-order tie-break is what makes the tournament's first-tried
    // alt deterministic.
    let all = alts;
    group.sort_by(|a: &i32, b: &i32| {
        let pa = alt_sort_priority(&all[*a]);
        let pb = alt_sort_priority(&all[*b]);
        if pa != pb {
            return pb.cmp(&pa);
        }
        let ea = all[*a].elements.len();
        let eb = all[*b].elements.len();
        if ea != eb {
            return eb.cmp(&ea);
        }
        return a.cmp(b);
    });
}
