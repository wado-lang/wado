//! The corpus tools' shell: which paths a run processes, where an offset falls,
//! and the baseline its count ratchets against.

use { collect_paths, line_of, ratchet } from "./corpus.wado";
use { Console } from "../tests/support/console.wado";
use { scratch } from "../tests/support/scratch.wado";
use fs from "core:fs";
use { Preopens } from "core:fs";
use { TreeMap } from "core:collections";

global SUITE: String = "gale-corpus-test";

global NOUN: String = "inline paths";
global REMEDY: String = "Import them with `use`.";

fn counts(entries: List<[String, i32]>) -> TreeMap<String, i32> {
    let mut map = TreeMap::<String, i32>::new();
    for let [path, n] of entries {
        map[path] = n;
    }
    return map;
}

test "a --paths-from list gives one path per line, blank lines skipped" {
    let dir = scratch(SUITE, "paths-from");
    let list = `${dir}/paths.txt`;
    let text: String = "src/a.rs\n\nsrc/with space.rs\n";
    fs::write(&list, &text).unwrap();
    let mut console = Console {};
    let paths = with &mut console do {
        collect_paths(&["--paths-from", list], ".rs", []);
    };
    assert paths == ["src/a.rs", "src/with space.rs"];
    assert console.stderr() == "";
}

test "bare arguments with the extension are paths, and the caller's flags are not" {
    let mut console = Console {};
    let paths = with &mut console do {
        collect_paths(&["a.rs", "--update", "b.rs"], ".rs", ["--update"]);
    };
    assert paths == ["a.rs", "b.rs"];
}

test "a list that cannot be read is reported and kept as a path" {
    let dir = scratch(SUITE, "paths-from-missing");
    let list = `${dir}/absent.txt`;
    let mut console = Console {};
    let paths = with &mut console do {
        collect_paths(&["--paths-from", list], ".rs", []);
    };
    assert paths == [list];
    assert console.stderr() == `error: ${list}: no such file or directory\n`;
}

#[expect_trap]
test "an argument that is neither a path nor a flag stops the run" {
    let mut console = Console {};
    with &mut console do {
        collect_paths(&["--verbose"], ".rs", []);
    };
}

test "line_of counts the newlines before the offset" {
    let source = "a\nbb\nccc";
    assert line_of(&source, 0) == 1;
    assert line_of(&source, 2) == 2;
    assert line_of(&source, 5) == 3;
    assert line_of(&source, source.len()) == 3;
}

fn baseline_with<S: AsStrSlice>(case: S, text: String) -> String with Preopens {
    let path = `${scratch(SUITE, case)}/baseline.json`;
    fs::write(&path, &text).unwrap();
    return path;
}

test "counts that match the baseline pass" {
    let baseline = baseline_with("ratchet-equal", "{\"a.rs\": 2, \"b.rs\": 1}");
    let mut console = Console {};
    let status = with &mut console do {
        ratchet(baseline, &counts([
            ["a.rs", 2],
            ["b.rs", 1],
        ]), false, NOUN, REMEDY);
    };
    assert status == 0;
    assert console.stdout() == "ok: no file gained inline paths (3 left)\n";
    assert console.stderr() == "";
}

test "counts below the baseline pass and ask for an update" {
    let baseline = baseline_with("ratchet-shrunk", "{\"a.rs\": 2, \"b.rs\": 1}");
    let mut console = Console {};
    let status = with &mut console do {
        ratchet(baseline, &counts([
            ["a.rs", 1],
        ]), false, NOUN, REMEDY);
    };
    assert status == 0;
    assert console.stdout() == "ok: no file gained inline paths (1 left, 2 fewer than the baseline — run --update)\n";
}

test "a file that grew fails, naming each file with its old and new count" {
    let baseline = baseline_with("ratchet-grown", "{\"a.rs\": 2}");
    let mut console = Console {};
    let status = with &mut console do {
        ratchet(baseline, &counts([
            ["a.rs", 3],
            ["new.rs", 1],
        ]), false, NOUN, REMEDY);
    };
    assert status == 1;
    assert console.stdout() == "";
    assert console.stderr() == "error: inline paths added:\n  a.rs: 2 -> 3\n  new.rs: 0 -> 1\n\nImport them with `use`.\n";
}

test "an update records the counts as the new baseline" {
    let baseline = baseline_with("ratchet-update", "{\"a.rs\": 2, \"b.rs\": 1}");
    let mut console = Console {};
    let status = with &mut console do {
        ratchet(baseline, &counts([
            ["a.rs", 1],
        ]), true, NOUN, REMEDY);
    };
    assert status == 0;
    assert console.stdout() == "baseline: 1 inline paths in 1 files\n";
    assert fs::read_to_string(&baseline).unwrap() == "{\n  \"a.rs\": 1\n}\n";
}

test "an update never records a file that grew" {
    let text: String = "{\"a.rs\": 2}";
    let baseline = baseline_with("ratchet-update-grown", text);
    let mut console = Console {};
    let status = with &mut console do {
        ratchet(baseline, &counts([
            ["a.rs", 3],
        ]), true, NOUN, REMEDY);
    };
    assert status == 1;
    assert fs::read_to_string(&baseline).unwrap() == text;
}

test "a missing baseline fails the run" {
    let baseline = `${scratch(SUITE, "ratchet-missing")}/baseline.json`;
    let mut console = Console {};
    let status = with &mut console do {
        ratchet(baseline, &counts([]), false, NOUN, REMEDY);
    };
    assert status == 1;
    assert console.stderr() == `error: ${baseline}: no such file or directory\n`;
}

test "a baseline that is not a JSON object of counts fails the run" {
    let baseline = baseline_with("ratchet-malformed", "[1, 2]");
    let mut console = Console {};
    let status = with &mut console do {
        ratchet(baseline, &counts([]), false, NOUN, REMEDY);
    };
    assert status == 1;
    assert console.stderr().starts_with(`error: ${baseline}: `), console.stderr();
}
