//! Tests for the ATN model, builder, and serialization (P1).
//!
//! These pin three things the runtime simulator (P2/P3) depends on:
//!   1. `serialize_atn` -> `atn_decode` reconstructs the ATN exactly (the
//!      production encode/decode path);
//!   2. token-kind numbering matches the generated `TK_*` constants;
//!   3. non-greedy repeats put the EXIT edge first at the decision state
//!      (the invariant that makes `(else stmt)??` bind to the outer rule).

use { build_atn, build_token_kinds, serialize_atn, Atn, AtnState } from "./atn.wado";
use {
    atn_decode,
    AtnSim,
    ATN_BLOCK_START,
    ATN_BLOCK_END,
    ATN_RULE_START,
    ATN_STAR_LOOP_ENTRY,
    ATN_LOOP_END,
    ATN_TR_EPSILON,
    ATN_TR_RULE,
    ATN_TR_PRECEDENCE,
} from "./runtime/atn.wado";
use { parse } from "./g4/parser.wado";
use { assign_atn_call_sites } from "./ir.wado";

global NON_GREEDY_G4: String = "
grammar T;
start : statement+ ;
statement : 'x' | ifStatement;
ifStatement : 'if' 'y' statement ('else' statement)?? ;
ID : 'a'..'z'+ ;
WS : (' '|'\\n') -> channel(HIDDEN);
";

global GREEDY_G4: String = "
grammar T;
start : statement+ ;
statement : 'x' | ifStatement;
ifStatement : 'if' 'y' statement ('else' statement)? ;
ID : 'a'..'z'+ ;
WS : (' '|'\\n') -> channel(HIDDEN);
";

// A directly left-recursive binary-operator rule. `expr`'s two LR alts
// ('*' then '+') get descending `own_prec` (2, 1) by source order, and
// left-associative `conflict_min` = own_prec + 1 (3, 2). `INT` is the
// single non-LR atom alt. Drives the P4.1 rewritten-form assertions.
global LR_G4: String = "
grammar E;
expr : expr '*' expr
     | expr '+' expr
     | INT ;
INT : '0'..'9'+ ;
WS : ' ' -> channel(HIDDEN);
";

/// Find rule `rule`'s `STAR_LOOP_ENTRY` decision state (the LR loop entry),
/// or -1 if the rule has none.
fn find_loop_entry(atn: &Atn, rule: i32) -> i32 {
    for let mut i = 0; i < atn.states.len(); i += 1 {
        let st = &atn.states[i];
        if st.kind == ATN_STAR_LOOP_ENTRY && st.rule == rule {
            return i;
        }
    }
    return -1;
}

/// True iff some RULE transition in `atn` targets `target_start` and returns
/// (follow) to `ret` — i.e. `ret` is a genuine post-call return state.
fn return_state_follows_call(atn: &Atn, ret: i32, target_start: i32) -> bool {
    for let mut i = 0; i < atn.states.len(); i += 1 {
        for let t of &atn.states[i].transitions {
            if t.kind == ATN_TR_RULE && t.target == target_start && t.follow == ret {
                return true;
            }
        }
    }
    return false;
}

// A `between`-style LR grammar: `expr` is left-recursive (`expr 'and' expr`)
// with a non-LR atom alt that itself calls `expr` twice
// (`'between' expr 'and' expr`). The descriptor `DropLoopEntryBranchInLRRule_4`
// hinges on distinguishing between's first operand (after which `'and'` is
// pending) from the LR loop operand — which the rule-index stack cannot do
// but per-call-site return states can.
global BETWEEN_G4: String = "
grammar B;
stat : expr ;
expr : expr 'and' expr
     | 'between' expr 'and' expr
     | ID ;
ID : 'a'..'z'+ ;
WS : ' ' -> channel(HIDDEN);
";

/// Find a BlockStart decision state whose FIRST outgoing epsilon edge
/// targets a BlockEnd — i.e. an optional/loop whose decision prefers to
/// EXIT before entering. Returns the state id, or -1.
fn find_exit_first_decision(atn: &Atn) -> i32 {
    for let mut i = 0; i < atn.states.len(); i += 1 {
        let st = &atn.states[i];
        if st.kind != ATN_BLOCK_START || st.decision < 0 {
            continue;
        }
        if st.transitions.len() < 1 {
            continue;
        }
        let first = &st.transitions[0];
        if first.kind != ATN_TR_EPSILON {
            continue;
        }
        if atn.states[first.target].kind == ATN_BLOCK_END {
            return i;
        }
    }
    return -1;
}

/// Assert the SoA `AtnSim` the runtime decodes faithfully reconstructs the
/// AoS `Atn` the builder produced — i.e. `serialize_atn` and the production
/// `atn_decode` agree field-for-field.
fn assert_sim_matches_atn(sim: &AtnSim, atn: &Atn) {
    assert sim.num_tokens == atn.num_tokens, "num_tokens";
    assert sim.rule_start == atn.rule_start, "rule_start";
    assert sim.rule_stop == atn.rule_stop, "rule_stop";
    assert sim.decision_state == atn.decision_state, "decision_state";
    assert sim.state_kind.len() == atn.states.len(), "state count";
    for let mut i = 0; i < atn.states.len(); i += 1 {
        let st = &atn.states[i];
        assert sim.state_kind[i] == st.kind, `state {i} kind`;
        assert sim.state_rule[i] == st.rule, `state {i} rule`;
        assert sim.state_decision[i] == st.decision, `state {i} decision`;
        assert sim.state_tr_count[i] == st.transitions.len(), `state {i} tr count`;
        let base = sim.state_tr_start[i];
        for let mut j = 0; j < st.transitions.len(); j += 1 {
            let t = &st.transitions[j];
            assert sim.tr_src[base + j] == i, `state {i} tr {j} src`;
            assert sim.tr_kind[base + j] == t.kind, `state {i} tr {j} kind`;
            assert sim.tr_target[base + j] == t.target, `state {i} tr {j} target`;
            assert sim.tr_label[base + j] == t.label, `state {i} tr {j} label`;
            assert sim.tr_follow[base + j] == t.follow, `state {i} tr {j} follow`;
            assert sim.tr_prec[base + j] == t.prec, `state {i} tr {j} prec`;
        }
    }
}

test "ATN round-trips through serialize_atn/atn_decode exactly" {
    let g = parse(NON_GREEDY_G4).unwrap();
    let atn = build_atn(&g);
    let sim = atn_decode(&serialize_atn(&atn));
    assert_sim_matches_atn(&sim, &atn);
}

test "ATN has one start/stop per parser rule" {
    let g = parse(NON_GREEDY_G4).unwrap();
    let atn = build_atn(&g);
    assert atn.rule_start.len() == g.parser_rules.len();
    assert atn.rule_stop.len() == g.parser_rules.len();
    // Every rule_start id points at an actual RuleStart state.
    for let mut r = 0; r < g.parser_rules.len(); r += 1 {
        assert atn.states[atn.rule_start[r]].kind == ATN_RULE_START;
    }
}

test "token kinds mirror gen_token_constants numbering" {
    let g = parse(NON_GREEDY_G4).unwrap();
    let tk = build_token_kinds(&g);
    let map = tk.0;
    // Non-deferred lexer rules first, in declaration order: ID=0, WS=1.
    assert map["TK_ID"] == 0;
    assert map["TK_WS"] == 1;
    // Then TK_EOF, then TK_ERROR (no ERROR rule here).
    assert map["TK_EOF"] == 2;
    assert map["TK_ERROR"] == 3;
    // Literal tokens follow, in first-seen order across rules:
    // 'x', 'if', 'y', 'else'.
    assert map.get("TK_LIT_X") matches { Some(_) };
    // num_tokens accounts for every assigned id.
    assert tk.1 >= 8;
}

test "non-greedy optional puts the exit edge first" {
    let g = parse(NON_GREEDY_G4).unwrap();
    let atn = build_atn(&g);
    let d = find_exit_first_decision(&atn);
    assert d >= 0, "non-greedy `??` should produce an exit-first decision state";
}

test "greedy optional puts the enter edge first" {
    let g = parse(GREEDY_G4).unwrap();
    let atn = build_atn(&g);
    // The greedy `?` enters before exiting, so no decision is exit-first
    // *into a BlockEnd as its very first edge* from an optional. (The 2-alt
    // `statement` block starts with sequence entries, not a BlockEnd.)
    let d = find_exit_first_decision(&atn);
    assert d < 0, "greedy `?` must not be exit-first";
}

test "LR rule builds in rewritten loop-entry form" {
    let g = parse(LR_G4).unwrap();
    let atn = build_atn(&g);
    // `expr` is the first parser rule.
    let entry = find_loop_entry(&atn, 0);
    assert entry >= 0, "LR rule should build a STAR_LOOP_ENTRY";
    let st = &atn.states[entry];
    assert st.decision >= 0, "loop entry must be a decision";
    // Two precedence-guarded enter edges (one per LR alt), then the exit.
    assert st.transitions.len() == 3, `expected 3 loop-entry edges, got {st.transitions.len()}`;
    assert st.transitions[0].kind == ATN_TR_PRECEDENCE, "first enter edge is a precedence predicate";
    assert st.transitions[0].prec == 2, `'*' alt own_prec should be 2, got {st.transitions[0].prec}`;
    assert st.transitions[1].kind == ATN_TR_PRECEDENCE, "second enter edge is a precedence predicate";
    assert st.transitions[1].prec == 1, `'+' alt own_prec should be 1, got {st.transitions[1].prec}`;
    // Greedy ordering: the exit epsilon is last and lands on a LoopEnd.
    assert st.transitions[2].kind == ATN_TR_EPSILON, "exit edge is epsilon";
    assert atn.states[st.transitions[2].target].kind == ATN_LOOP_END, "exit lands on LoopEnd";
}

test "LR rule has no position-0 self-reference (no naive left recursion)" {
    let g = parse(LR_G4).unwrap();
    let atn = build_atn(&g);
    // The rule body the simulator enters first must be the atom block, not
    // a self-ref — otherwise the closure left-recurses forever.
    let body_entry = atn.states[atn.rule_start[0]].transitions[0].target;
    assert atn.states[body_entry].kind == ATN_BLOCK_START, "LR rule enters its atom block first";
    // The only self-references (RULE edges back to expr's start) live in the
    // loop suffixes, each carrying the raised precedence floor `conflict_min`
    // (3 for '*', 2 for '+').
    let mut found3 = false;
    let mut found2 = false;
    for let mut i = 0; i < atn.states.len(); i += 1 {
        for let t of &atn.states[i].transitions {
            if t.kind == ATN_TR_RULE && t.target == atn.rule_start[0] {
                if t.prec == 3 {
                    found3 = true;
                }
                if t.prec == 2 {
                    found2 = true;
                }
            }
        }
    }
    assert found3, "'*' operand should recurse at conflict_min = 3";
    assert found2, "'+' operand should recurse at conflict_min = 2";
}

test "LR ATN round-trips through serialize_atn/atn_decode exactly" {
    let g = parse(LR_G4).unwrap();
    let atn = build_atn(&g);
    let sim = atn_decode(&serialize_atn(&atn));
    assert_sim_matches_atn(&sim, &atn);
}

test "P4.2a: call sites map to distinct ATN return states (between shape)" {
    let mut g = parse(BETWEEN_G4).unwrap();
    assign_atn_call_sites(&mut g);
    let atn = build_atn(&g);
    let csr = &atn.call_site_returns;
    // Call-site numbering (depth-first over rules then alts):
    //   cs0 = stat -> expr
    //   cs1 = expr alt0 leading self-ref (LR prefix, stripped by the rewrite)
    //   cs2 = expr alt0 trailing 'and' operand
    //   cs3 = 'between' first operand
    //   cs4 = 'between' second operand
    assert csr.len() == 5, `expected 5 call sites, got {csr.len()}`;
    assert csr[0] >= 0, "stat->expr call site should have a return state";
    // The leading LR self-ref is the precedence-climb entry, not a real call
    // in the rewritten form, so it never gets a return state.
    assert csr[1] == -1, "leading LR self-ref is stripped, not a call site";
    assert csr[2] >= 0, "trailing 'and' operand has a return state";
    assert csr[3] >= 0, "between's first operand has a return state";
    assert csr[4] >= 0, "between's second operand has a return state";
    // The crux of the `between` fix: the LR loop operand and between's first
    // operand return to DIFFERENT ATN states — the precision a rule-index
    // stack lacks. Likewise between's two operands are distinct sites.
    assert csr[2] != csr[3], "loop operand vs between-first-operand must differ";
    assert csr[3] != csr[4], "between's two operands return to different states";
    assert csr[2] != csr[4], "loop operand vs between-second-operand must differ";
    // Every recorded return state is the follow of a real `expr` call.
    let expr_start = atn.rule_start[1];
    assert return_state_follows_call(&atn, csr[2], expr_start), "cs2 follows an expr call";
    assert return_state_follows_call(&atn, csr[3], expr_start), "cs3 follows an expr call";
    assert return_state_follows_call(&atn, csr[4], expr_start), "cs4 follows an expr call";
}
