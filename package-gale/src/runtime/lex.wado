#![allow(dead_code)]

pub struct Span {
    pub start: i32,
    pub end: i32,
}

impl Span {
    pub fn new(start: i32, end: i32) -> Span {
        return Span { start, end };
    }

    pub fn len(&self) -> i32 {
        return self.end - self.start;
    }
}

internal fn char_at(src: &StrSlice, pos: i32) -> char
    contract 0 <= pos < src.len()
{
    let b = unchecked src.byte_at(pos);
    if b < 0x80 {
        return b as char;
    }
    return src.char_at_byte(pos);
}

internal fn char_count(src: &StrSlice, start: i32, end: i32) -> i32
    contract 0 <= start <= end <= src.len()
{
    let mut n = 0;
    for let mut i = start; i < end; i += 1 {
        if src.is_char_boundary(i) {
            n += 1;
        }
    }
    return n;
}

internal fn span_text(src: &StrSlice, start: i32, end: i32) -> String {
    return src.slice(start, end).to_string();
}

internal fn push_escaped(out: &mut String, src: &StrSlice, start: i32, end: i32) {
    let mut run = start;
    for let mut i = start; i < end; i += 1 {
        let b = unchecked src.byte_at(i);
        if b matches { b'\n' | b'\r' | b'\t' } {
            out.push_str(unchecked src.slice(run, i));
            out.push_str(match b {
                b'\n' => "\\n",
                b'\r' => "\\r",
                _ => "\\t",
            });
            run = i + 1;
        }
    }
    out.push_str(unchecked src.slice(run, end));
}

internal fn kind_set_has(set: &List<i32>, kind: i32) -> bool {
    let w = kind >> 5;
    if w >= set.len() {
        return false;
    }
    return set[w] >> (kind & 31) & 1 == 1;
}

internal fn with_expected<S: AsStrSlice>(message: S, expected: &List<String>) -> String {
    let n = expected.len();
    if n == 0 {
        return message.to_string();
    }
    let mut out = String::with_capacity(n * 8 + message.len() + 11);
    out.push_str("expected ");
    for let mut i = 0; i < n; i += 1 {
        if i > 0 {
            out.push_str(&if i == n - 1 { " or " } else { ", " });
        }
        out.push_str(&expected[i]);
    }
    out.push_str("; ");
    out.push_str(message);
    return out;
}

internal fn char_pos_in_line(src: &StrSlice, pos: i32) -> i32 {
    let end = i32::min(pos, src.len());
    let mut line_start = end;
    while line_start > 0 && unchecked src.byte_at(line_start - 1) != b'\n' {
        line_start -= 1;
    }
    return char_count(src, line_start, end);
}

internal fn line_starts(src: &StrSlice) -> List<i32> {
    let mut starts: List<i32> = [0];
    for let mut i = 0; i < src.len(); i += 1 {
        if unchecked src.byte_at(i) == b'\n' {
            starts.push(i + 1);
        }
    }
    return starts;
}

internal fn line_at(starts: &List<i32>, pos: i32) -> i32 {
    let mut lo = 0;
    let mut hi = starts.len() - 1;
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if starts[mid] <= pos {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    return lo + 1;
}

internal fn line_col_at(src: &StrSlice, starts: &List<i32>, pos: i32) -> [i32, i32] {
    let line = line_at(starts, pos);
    return [line, char_count(src, starts[line - 1], pos)];
}

pub flags TokenFlags {
    Synthetic,
    Skipped,
    LexError,
}

pub struct TokenStream {
    pub kinds: List<i32>,
    token_fields: List<i32>,
    pub src: StrSlice,
    trivia_fields: List<i32>,
    pub output: String = "",
}

impl TokenStream {
    internal fn new(src: StrSlice) -> TokenStream {
        let cap = src.len() / 4 + 1;
        return TokenStream {
            kinds: List::with_capacity(cap),
            token_fields: List::with_capacity(cap * 5),
            src,
            trivia_fields: List::with_capacity(cap * 4),
        };
    }

    pub fn len(&self) -> i32 {
        return self.kinds.len();
    }

    pub fn start_at(&self, i: i32) -> i32 {
        return self.token_fields[i * 5];
    }

    pub fn end_at(&self, i: i32) -> i32 {
        return self.token_fields[i * 5 + 1];
    }

    pub fn trivia_lo_at(&self, i: i32) -> i32 {
        return self.token_fields[i * 5 + 2];
    }

    pub fn trivia_hi_at(&self, i: i32) -> i32 {
        return self.token_fields[i * 5 + 3];
    }

    pub fn trivia_kind_at(&self, t: i32) -> i32 {
        return self.trivia_fields[t * 4];
    }

    pub fn trivia_start_at(&self, t: i32) -> i32 {
        return self.trivia_fields[t * 4 + 1];
    }

    pub fn trivia_end_at(&self, t: i32) -> i32 {
        return self.trivia_fields[t * 4 + 2];
    }

    pub fn trivia_channel_at(&self, t: i32) -> i32 {
        return self.trivia_fields[t * 4 + 3];
    }

    internal fn trivia_mark(&self) -> i32 {
        return self.trivia_fields.len() >> 2;
    }

    internal fn push_trivia(&mut self, kind: i32, start: i32, end: i32, channel: i32) {
        if self.trivia_fields.len() >= self.trivia_fields.capacity() {
            builtin::cold_path();
            self.trivia_fields.grow();
            assert self.trivia_fields.capacity() % 4 == 0, "TokenStream trivia_fields must hold whole trivia";
        }
        unchecked self.trivia_fields.push_within_capacity(kind);
        unchecked self.trivia_fields.push_within_capacity(start);
        unchecked self.trivia_fields.push_within_capacity(end);
        unchecked self.trivia_fields.push_within_capacity(channel);
    }

    internal fn push_token(&mut self, kind: i32, start: i32, end: i32, triv_lo: i32, triv_hi: i32) {
        self.push_token_flagged(kind, start, end, triv_lo, triv_hi, TokenFlags::none());
    }

    internal fn push_token_flagged(
        &mut self,
        kind: i32,
        start: i32,
        end: i32,
        triv_lo: i32,
        triv_hi: i32,
        flags: TokenFlags,
    ) -> i32 {
        let idx = self.kinds.len();
        if idx >= self.kinds.capacity() {
            builtin::cold_path();
            self.kinds.grow();
            self.token_fields.reserve(self.kinds.capacity() * 5 - self.token_fields.len());
            assert self.token_fields.capacity() == self.kinds.capacity() * 5, "TokenStream token_fields must grow with kinds";
        }
        unchecked self.kinds.push_within_capacity(kind);
        unchecked self.token_fields.push_within_capacity(start);
        unchecked self.token_fields.push_within_capacity(end);
        unchecked self.token_fields.push_within_capacity(triv_lo);
        unchecked self.token_fields.push_within_capacity(triv_hi);
        unchecked self.token_fields.push_within_capacity(flags as u32 as i32);
        return idx;
    }

    internal fn push_synthetic(&mut self, expected_kind: i32, at: i32) -> i32 {
        let m = self.trivia_mark();
        return self.push_token_flagged(expected_kind, at, at, m, m, TokenFlags::Synthetic);
    }

    pub fn flags_at(&self, i: i32) -> TokenFlags {
        return self.token_fields[i * 5 + 4] as u32 as TokenFlags;
    }

    internal fn set_flag(&mut self, i: i32, flag: TokenFlags) {
        self.token_fields[i * 5 + 4] = (self.flags_at(i) | flag) as u32 as i32;
    }

    internal fn mark_skipped(&mut self, i: i32) {
        self.set_flag(i, TokenFlags::Skipped);
    }

    pub fn is_synthetic(&self, i: i32) -> bool {
        return self.flags_at(i) & TokenFlags::Synthetic != TokenFlags::none();
    }

    pub fn is_skipped(&self, i: i32) -> bool {
        return self.flags_at(i) & TokenFlags::Skipped != TokenFlags::none();
    }

    pub fn is_lex_error(&self, i: i32) -> bool {
        return self.flags_at(i) & TokenFlags::LexError != TokenFlags::none();
    }

    pub fn kind_at(&self, i: i32) -> i32 {
        return self.kinds[i];
    }

    pub fn span_at(&self, i: i32) -> Span {
        return Span::new(self.start_at(i), self.end_at(i));
    }

    pub fn is_empty_text(&self, i: i32) -> bool {
        return self.start_at(i) >= self.end_at(i);
    }

    pub fn token_text(&self, i: i32) -> String {
        return span_text(&self.src, self.start_at(i), self.end_at(i));
    }

    pub fn push_token_text(&self, out: &mut String, i: i32) {
        out.push_str(self.src.slice(self.start_at(i), self.end_at(i)));
    }

    pub fn push_token_text_escaped(&self, out: &mut String, i: i32) {
        push_escaped(out, &self.src, self.start_at(i), self.end_at(i));
    }

    pub fn rule_text(&self, start_tok: i32, end_tok: i32) -> String {
        let mut out = String::new();
        for let mut i = start_tok; i <= end_tok; i += 1 {
            if i > start_tok {
                for let mut t = self.trivia_lo_at(i); t < self.trivia_hi_at(i); t += 1 {
                    if self.trivia_channel_at(t) != 0 {
                        out.push_str(self.src.slice(self.trivia_start_at(t), self.trivia_end_at(t)));
                    }
                }
            }
            self.push_token_text(&mut out, i);
        }
        return out;
    }
}
