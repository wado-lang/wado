#![allow(dead_code)]

pub struct Span {
    pub start: i32,
    pub end: i32,
}

impl Span {
    pub fn new(start: i32, end: i32) -> Span {
        return Span { start, end };
    }

    pub fn len(&self) -> i32 {
        return self.end - self.start;
    }
}

internal fn char_at(src: &StrSlice, pos: i32) -> char
    contract 0 <= pos < src.len()
{
    let b = unchecked src.byte_at(pos);
    if b < 0x80 {
        return b as char;
    }
    return src.char_at_byte(pos);
}

internal fn char_count(src: &StrSlice, start: i32, end: i32) -> i32
    contract 0 <= start <= end <= src.len()
{
    let mut n = 0;
    for let mut i = start; i < end; i += 1 {
        if src.is_char_boundary(i) {
            n += 1;
        }
    }
    return n;
}

internal fn span_text(src: &StrSlice, start: i32, end: i32) -> String {
    return src.slice(start, end).to_string();
}

internal fn push_escaped(out: &mut String, src: &StrSlice, start: i32, end: i32) {
    let mut run = start;
    for let mut i = start; i < end; i += 1 {
        let b = unchecked src.byte_at(i);
        if b matches { b'\n' | b'\r' | b'\t' } {
            out.push_str(unchecked src.slice(run, i));
            out.push_str(match b {
                b'\n' => "\\n",
                b'\r' => "\\r",
                _ => "\\t",
            });
            run = i + 1;
        }
    }
    out.push_str(unchecked src.slice(run, end));
}

internal fn kind_set_has(set: &List<i32>, kind: i32) -> bool {
    let w = kind >> 5;
    if w >= set.len() {
        return false;
    }
    return set[w] >> (kind & 31) & 1 == 1;
}

internal fn with_expected<S: AsStrSlice>(message: S, expected: &List<String>) -> String {
    let n = expected.len();
    if n == 0 {
        return message.to_string();
    }
    let mut out = String::with_capacity(n * 8 + message.len() + 11);
    out.push_str("expected ");
    for let mut i = 0; i < n; i += 1 {
        if i > 0 {
            out.push_str(&if i == n - 1 { " or " } else { ", " });
        }
        out.push_str(&expected[i]);
    }
    out.push_str("; ");
    out.push_str(message);
    return out;
}

internal fn char_pos_in_line(src: &StrSlice, pos: i32) -> i32 {
    let end = i32::min(pos, src.len());
    let mut line_start = end;
    while line_start > 0 && unchecked src.byte_at(line_start - 1) != b'\n' {
        line_start -= 1;
    }
    return char_count(src, line_start, end);
}

internal fn line_starts(src: &StrSlice) -> List<i32> {
    let mut starts: List<i32> = [0];
    for let mut i = 0; i < src.len(); i += 1 {
        if unchecked src.byte_at(i) == b'\n' {
            starts.push(i + 1);
        }
    }
    return starts;
}

internal fn line_at(starts: &List<i32>, pos: i32) -> i32 {
    let mut lo = 0;
    let mut hi = starts.len() - 1;
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if starts[mid] <= pos {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    return lo + 1;
}

internal fn line_col_at(src: &StrSlice, starts: &List<i32>, pos: i32) -> [i32, i32] {
    let line = line_at(starts, pos);
    return [line, char_count(src, starts[line - 1], pos)];
}

pub flags TokenFlags {
    Synthetic,
    Skipped,
    LexError,
}

pub struct TokenStream {
    pub kinds: List<i32>,
    pub starts: List<i32>,
    pub ends: List<i32>,
    pub triv_lo: List<i32>,
    pub triv_hi: List<i32>,
    pub src: StrSlice,
    pub triv_kinds: List<i32>,
    pub triv_starts: List<i32>,
    pub triv_ends: List<i32>,
    pub triv_chans: List<i32>,
    pub flags: List<TokenFlags>,
    pub output: String = "",
}

impl TokenStream {
    internal fn new(src: StrSlice) -> TokenStream {
        let cap = src.len() / 4 + 1;
        return TokenStream {
            kinds: List::with_capacity(cap),
            starts: List::with_capacity(cap),
            ends: List::with_capacity(cap),
            triv_lo: List::with_capacity(cap),
            triv_hi: List::with_capacity(cap),
            src,
            triv_kinds: List::with_capacity(cap),
            triv_starts: List::with_capacity(cap),
            triv_ends: List::with_capacity(cap),
            triv_chans: List::with_capacity(cap),
            flags: List::with_capacity(cap),
        };
    }

    pub fn len(&self) -> i32 {
        return self.kinds.len();
    }

    internal fn trivia_mark(&self) -> i32 {
        return self.triv_kinds.len();
    }

    internal fn push_trivia(&mut self, kind: i32, start: i32, end: i32, channel: i32) {
        if self.triv_kinds.len() >= self.triv_kinds.capacity() {
            builtin::cold_path();
            self.triv_kinds.grow();
            self.triv_starts.grow();
            self.triv_ends.grow();
            self.triv_chans.grow();
            assert self.triv_starts.capacity() == self.triv_kinds.capacity()
                && self.triv_ends.capacity() == self.triv_kinds.capacity()
                && self.triv_chans.capacity() == self.triv_kinds.capacity(), "TokenStream trivia columns must grow in lockstep";
        }
        unchecked self.triv_kinds.push_within_capacity(kind);
        unchecked self.triv_starts.push_within_capacity(start);
        unchecked self.triv_ends.push_within_capacity(end);
        unchecked self.triv_chans.push_within_capacity(channel);
    }

    internal fn push_token(&mut self, kind: i32, start: i32, end: i32, triv_lo: i32, triv_hi: i32) {
        self.push_token_flagged(kind, start, end, triv_lo, triv_hi, TokenFlags::none());
    }

    internal fn push_token_flagged(
        &mut self,
        kind: i32,
        start: i32,
        end: i32,
        triv_lo: i32,
        triv_hi: i32,
        flags: TokenFlags,
    ) -> i32 {
        let idx = self.kinds.len();
        if idx >= self.kinds.capacity() {
            builtin::cold_path();
            self.kinds.grow();
            self.starts.grow();
            self.ends.grow();
            self.triv_lo.grow();
            self.triv_hi.grow();
            self.flags.grow();
            assert self.starts.capacity() == self.kinds.capacity()
                && self.ends.capacity() == self.kinds.capacity()
                && self.triv_lo.capacity() == self.kinds.capacity()
                && self.triv_hi.capacity() == self.kinds.capacity()
                && self.flags.capacity() == self.kinds.capacity(), "TokenStream token columns must grow in lockstep";
        }
        unchecked self.kinds.push_within_capacity(kind);
        unchecked self.starts.push_within_capacity(start);
        unchecked self.ends.push_within_capacity(end);
        unchecked self.triv_lo.push_within_capacity(triv_lo);
        unchecked self.triv_hi.push_within_capacity(triv_hi);
        unchecked self.flags.push_within_capacity(flags);
        return idx;
    }

    internal fn push_synthetic(&mut self, expected_kind: i32, at: i32) -> i32 {
        let m = self.trivia_mark();
        return self.push_token_flagged(expected_kind, at, at, m, m, TokenFlags::Synthetic);
    }

    pub fn flags_at(&self, i: i32) -> TokenFlags {
        return self.flags[i];
    }

    internal fn set_flag(&mut self, i: i32, flag: TokenFlags) {
        self.flags[i] |= flag;
    }

    internal fn mark_skipped(&mut self, i: i32) {
        self.set_flag(i, TokenFlags::Skipped);
    }

    pub fn is_synthetic(&self, i: i32) -> bool {
        return self.flags[i] & TokenFlags::Synthetic != TokenFlags::none();
    }

    pub fn is_skipped(&self, i: i32) -> bool {
        return self.flags[i] & TokenFlags::Skipped != TokenFlags::none();
    }

    pub fn is_lex_error(&self, i: i32) -> bool {
        return self.flags[i] & TokenFlags::LexError != TokenFlags::none();
    }

    pub fn kind_at(&self, i: i32) -> i32 {
        return self.kinds[i];
    }

    pub fn span_at(&self, i: i32) -> Span {
        return Span::new(self.starts[i], self.ends[i]);
    }

    pub fn is_empty_text(&self, i: i32) -> bool {
        return self.starts[i] >= self.ends[i];
    }

    pub fn token_text(&self, i: i32) -> String {
        return span_text(&self.src, self.starts[i], self.ends[i]);
    }

    pub fn push_token_text(&self, out: &mut String, i: i32) {
        out.push_str(self.src.slice(self.starts[i], self.ends[i]));
    }

    pub fn push_token_text_escaped(&self, out: &mut String, i: i32) {
        push_escaped(out, &self.src, self.starts[i], self.ends[i]);
    }

    pub fn rule_text(&self, start_tok: i32, end_tok: i32) -> String {
        let mut out = String::new();
        for let mut i = start_tok; i <= end_tok; i += 1 {
            if i > start_tok {
                for let mut j = self.triv_lo[i]; j < self.triv_hi[i]; j += 1 {
                    if self.triv_chans[j] != 0 {
                        out.push_str(self.src.slice(self.triv_starts[j], self.triv_ends[j]));
                    }
                }
            }
            self.push_token_text(&mut out, i);
        }
        return out;
    }
}
