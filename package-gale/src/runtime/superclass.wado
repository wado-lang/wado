pub struct LexerView {
    chars: &List<char>,
    start: i32,
    pos: i32,
}

impl LexerView {
    pub fn la(&self, k: i32) -> i32 {
        let i = if k > 0 { self.pos + k - 1 } else { self.pos + k };
        if i < 0 || i >= self.chars.len() {
            return -1;
        }
        return self.chars[i] as i32;
    }

    pub fn text(&self) -> String {
        let mut s = String::with_capacity(if self.pos > self.start { self.pos - self.start } else { 0 });
        for let mut i = self.start; i < self.pos; i += 1 {
            s.push(self.chars[i]);
        }
        return s;
    }

    pub fn start(&self) -> i32 {
        return self.start;
    }

    pub fn pos(&self) -> i32 {
        return self.pos;
    }

    pub fn char_at(&self, i: i32) -> i32 {
        if i < 0 || i >= self.chars.len() {
            return -1;
        }
        return self.chars[i] as i32;
    }

    pub fn input_len(&self) -> i32 {
        return self.chars.len();
    }
}
