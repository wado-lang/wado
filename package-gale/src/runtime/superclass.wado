use { char_at, span_text } from "./lex.wado";

pub struct LexerView {
    src: &StrSlice,
    start: i32,
    pos: i32,
}

impl LexerView {
    pub fn la(&self, k: i32) -> i32 {
        let mut i = self.pos;
        for let mut step = 1; step < k; step += 1 {
            if i >= self.src.len() {
                return -1;
            }
            i = self.src.ceil_char_boundary(i + 1);
        }
        for let mut step = 0; step > k; step -= 1 {
            if i == 0 {
                return -1;
            }
            i = self.src.floor_char_boundary(i - 1);
        }
        return self.char_at(i);
    }

    pub fn text(&self) -> String {
        return span_text(self.src, self.start, self.pos);
    }

    pub fn start(&self) -> i32 {
        return self.start;
    }

    pub fn pos(&self) -> i32 {
        return self.pos;
    }

    pub fn char_at(&self, i: i32) -> i32 {
        if i < 0 || i >= self.src.len() {
            return -1;
        }
        return char_at(self.src, i) as i32;
    }

    pub fn input_len(&self) -> i32 {
        return self.src.len();
    }
}
