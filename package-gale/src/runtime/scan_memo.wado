pub struct ScanMemo<G> {
    heads: Array<i32>,
    entries: List<ScanMemoEntry<G>>,
}

struct ScanMemoEntry<G> {
    next: i32,
    rule: i32,
    min_prec: i32,
    follow: i64,
    cont: i64,
    gate_in: G,
    end: i32,
    gate_out: G,
}

impl<G: Eq> ScanMemo<G> {
    pub fn new(positions: i32) -> ScanMemo<G> {
        return ScanMemo { heads: Array::<i32>::filled(positions + 1, -1), entries: [] };
    }

    pub fn find(&self, rule: i32, pos: i32, min_prec: i32, follow: i64, cont: i64, gate: &G) -> i32 {
        let mut at = self.heads[pos];
        while at >= 0 {
            let e = &self.entries[at];
            if e.rule == rule && e.min_prec == min_prec && e.follow == follow && e.cont == cont && e.gate_in == *gate {
                return at;
            }
            at = e.next;
        }
        return -1;
    }

    pub fn end_of(&self, entry: i32) -> i32 {
        return self.entries[entry].end;
    }

    pub fn gate_of(&self, entry: i32) -> G {
        return self.entries[entry].gate_out;
    }

    pub fn put(&mut self, rule: i32, pos: i32, min_prec: i32, follow: i64, cont: i64, gate_in: G, end: i32, gate_out: G) {
        self.entries.push(ScanMemoEntry { next: self.heads[pos], rule, min_prec, follow, cont, gate_in, end, gate_out });
        self.heads[pos] = self.entries.len() - 1;
    }
}
