#![allow(dead_code)]

use { HashMap, HashSeed } from "core:collections";

global INTERN_SEED: HashSeed = HashSeed::fixed(0x5BD1E9955BD1E995, 0x27D4EB2F165667C5);

internal struct Interner<K> {
    items: List<K>,
    ids: HashMap<K, i32>,
}

impl<K: Hash> Interner<K> {
    internal fn new() -> Interner<K> {
        return Interner { items: [], ids: HashMap::with_seed(INTERN_SEED) };
    }

    internal fn intern(&mut self, item: K) -> i32 {
        if let Some(id) = self.ids.get(item) {
            return id;
        }
        let id = self.items.len();
        self.items.push(item);
        self.ids[item] = id;
        return id;
    }

    internal fn at(&self, id: i32) -> K {
        return self.items[id];
    }
}
