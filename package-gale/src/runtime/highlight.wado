use { TokenStream } from "./lex.wado";

pub struct RuleCapture {
    pub rule_id: i32,
    pub capture_id: i32,
    pub order: i32,
}

pub struct HighlightMapping {
    pub capture_names: List<String>,
    pub capture_classes: List<String>,
    pub default_ids: List<i32>,
    pub overrides_by_kind: List<List<RuleCapture>>,
    pub rule_captures: List<RuleCapture>,
}

pub struct HighlightCapture {
    pub capture_id: i32,
    pub start: i32,
    pub end: i32,
}

pub struct HighlightVisitor {
    mapping: &HighlightMapping,
    rule_stack: List<i32>,
    rule_capture_stack: List<i32>,
    visited: List<bool>,
    pub captures: List<HighlightCapture>,
}

fn first_written(rule_capture: i32, other: i32) -> i32 {
    if rule_capture < 0 {
        return other;
    }
    if other < 0 {
        return rule_capture;
    }
    return i32::min(rule_capture, other);
}

impl HighlightVisitor {
    pub fn new(mapping: &HighlightMapping) -> HighlightVisitor {
        return HighlightVisitor { mapping, rule_stack: [], rule_capture_stack: [], visited: [], captures: [] };
    }

    fn enclosing_rule_capture(&self) -> i32 {
        let depth = self.rule_capture_stack.len();
        return if depth == 0 { -1 } else { self.rule_capture_stack[depth - 1] };
    }

    fn own_rule_capture(&self, rule_id: i32) -> i32 {
        for let mut i = 0; i < self.mapping.rule_captures.len(); i += 1 {
            if self.mapping.rule_captures[i].rule_id == rule_id {
                return i;
            }
        }
        return -1;
    }

    fn classify(&self, kind: i32, rule_capture: i32) -> i32 {
        let before = if rule_capture >= 0 { self.mapping.rule_captures[rule_capture].order } else { i32::MAX };
        if kind < self.mapping.overrides_by_kind.len() {
            for let candidate of &self.mapping.overrides_by_kind[kind] {
                if candidate.order > before {
                    break;
                }
                for let rule_id of &self.rule_stack {
                    if *rule_id == candidate.rule_id {
                        return candidate.capture_id;
                    }
                }
            }
        }
        if rule_capture >= 0 {
            return self.mapping.rule_captures[rule_capture].capture_id;
        }
        return self.mapping.default_ids[kind];
    }
}

impl HighlightVisitor {
    internal fn hl_enter(&mut self, rule_id: i32) {
        self.rule_stack.push(rule_id);
        if !self.mapping.rule_captures.is_empty() {
            let active = first_written(self.own_rule_capture(rule_id), self.enclosing_rule_capture());
            self.rule_capture_stack.push(active);
        }
    }

    internal fn hl_exit(&mut self) {
        self.rule_stack.pop();
        if !self.mapping.rule_captures.is_empty() {
            self.rule_capture_stack.pop();
        }
    }

    internal fn hl_visit_token(&mut self, toks: &TokenStream, idx: i32) {
        while self.visited.len() <= idx {
            self.visited.push(false);
        }
        self.visited[idx] = true;
        self.hl_capture_token(toks, idx);
    }

    fn hl_capture_token(&mut self, toks: &TokenStream, idx: i32) {
        for let mut t = toks.triv_lo[idx]; t < toks.triv_hi[idx]; t += 1 {
            let id = self.classify(toks.triv_kinds[t], -1);
            if id >= 0 {
                self.captures.push(
                    HighlightCapture { capture_id: id, start: toks.triv_starts[t], end: toks.triv_ends[t] },
                );
            }
        }
        if toks.is_empty_text(idx) {
            return;
        }
        let id = self.classify(toks.kinds[idx], self.enclosing_rule_capture());
        if id >= 0 {
            self.captures.push(
                HighlightCapture { capture_id: id, start: toks.starts[idx], end: toks.ends[idx] },
            );
        }
    }

    pub fn hl_cover_unvisited(&mut self, toks: &TokenStream) {
        let walked = self.captures.len();
        self.rule_stack = [];
        self.rule_capture_stack = [];
        for let mut i = 0; i < toks.len(); i += 1 {
            if i < self.visited.len() && self.visited[i] {
                continue;
            }
            self.hl_capture_token(toks, i);
        }
        self.visited = List::filled(toks.len(), true);
        if walked > 0 && self.captures.len() != walked {
            self.captures.sort_by(|a: &HighlightCapture, b: &HighlightCapture| {
                return a.start.cmp(&b.start);
            });
        }
    }
}

fn push_html_escaped<S: AsStrSlice>(out: &mut String, source: S, start: i32, end: i32) {
    let mut run = start;
    for let mut i = start; i < end; i += 1 {
        let b = unchecked source.byte_at(i);
        if b matches { b'&' | b'<' | b'>' | b'"' } {
            out.push_str(unchecked source.slice(run, i));
            out.push_str(match b {
                b'&' => "&amp;",
                b'<' => "&lt;",
                b'>' => "&gt;",
                _ => "&quot;",
            });
            run = i + 1;
        }
    }
    out.push_str(unchecked source.slice(run, end));
}

pub fn highlight_html<S: AsStrSlice>(source: S, captures: &List<HighlightCapture>, classes: &List<String>) -> String {
    let mut out = String::with_capacity(source.len() * 5);
    let mut at = 0;
    for let cap of captures {
        assert at <= cap.start <= cap.end, "captures are in source order and disjoint";
        push_html_escaped(&mut out, source, at, cap.start);
        out.push_str("<span class=\"");
        out.push_str(&classes[cap.capture_id]);
        out.push_str("\">");
        push_html_escaped(&mut out, source, cap.start, cap.end);
        out.push_str("</span>");
        at = cap.end;
    }
    push_html_escaped(&mut out, source, at, source.len());
    return out;
}
