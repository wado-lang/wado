//! Syntax-highlighting runtime: a `HighlightVisitor` that collects capture
//! ranges during a CST walk plus the HTML renderer. Emitted into a generated
//! parser only when the `highlight` generator option is on. The `./lex.wado`
//! import is stripped at `#include_str` time.

use { TokenStream } from "./lex.wado";

/// Highlight override: when inside a specific rule, override the capture for a token kind.
pub struct HighlightOverride {
    pub rule_name: String,
    pub token_kind: i32,
    pub capture: String,
}

/// Highlight mapping: defaults by token kind + context-aware overrides.
///
/// `rule_names` is the canonical name table used to resolve override
/// `rule_name`s into integer ids that match what the generated walker
/// passes to `hl_enter`. The generator emits the names in
/// parser-rule declaration order; index = rule id.
pub struct HighlightMapping {
    pub defaults: List<String>,
    pub rule_names: List<String>,
    pub overrides: List<HighlightOverride>,
}

/// A single highlight capture: a range in the source text tagged with an index
/// into the visitor's `capture_names` / `capture_classes` tables.
pub struct HighlightCapture {
    pub capture_id: i32,
    pub start: i32,
    pub end: i32,
}

/// Internal override form with the rule and capture resolved to integer ids.
struct ResolvedOverride {
    rule_id: i32,
    token_kind: i32,
    capture_id: i32,
}

/// HighlightVisitor collects highlight captures during a CST walk.
pub struct HighlightVisitor {
    /// Capture name per id, e.g. `punctuation.bracket`.
    pub capture_names: List<String>,
    /// `class` attribute text per id: the capture name with `.` → ` `.
    pub capture_classes: List<String>,
    /// Capture id per token kind, or -1 for a kind with no default capture.
    default_ids: List<i32>,
    overrides: List<ResolvedOverride>,
    rule_stack: List<i32>,
    /// Token indices the tree walk classified, so `hl_cover_unvisited` can
    /// default-classify the rest.
    visited: List<bool>,
    pub captures: List<HighlightCapture>,
}

impl HighlightVisitor {
    pub fn new(mapping: HighlightMapping) -> HighlightVisitor {
        let mut capture_names: List<String> = [];
        let mut capture_classes: List<String> = [];
        let mut default_ids: List<i32> = List::with_capacity(mapping.defaults.len());
        for let d of &mapping.defaults {
            if d.is_empty() {
                default_ids.push(-1);
            } else {
                default_ids.push(capture_names.len());
                capture_classes.push(class_text(d));
                capture_names.push(*d);
            }
        }
        let mut overrides: List<ResolvedOverride> = List::with_capacity(mapping.overrides.len());
        for let ov of &mapping.overrides {
            let mut id: i32 = -1;
            for let mut i = 0; i < mapping.rule_names.len(); i += 1 {
                if mapping.rule_names[i] == ov.rule_name {
                    id = i;
                    break;
                }
            }
            // Skip overrides whose rule_name matches no rule: they can never
            // fire and would waste a comparison on every classify() call.
            if id < 0 {
                continue;
            }
            let capture_id = capture_names.len();
            capture_classes.push(class_text(&ov.capture));
            capture_names.push(ov.capture);
            overrides.push(ResolvedOverride { rule_id: id, token_kind: ov.token_kind, capture_id });
        }
        return HighlightVisitor {
            capture_names,
            capture_classes,
            default_ids,
            overrides,
            rule_stack: [],
            visited: [],
            captures: [],
        };
    }

    fn classify(&self, kind: i32) -> i32 {
        for let ov of &self.overrides {
            if ov.token_kind == kind {
                for let rule_id of &self.rule_stack {
                    if *rule_id == ov.rule_id {
                        return ov.capture_id;
                    }
                }
            }
        }
        if kind >= 0 && kind < self.default_ids.len() {
            return self.default_ids[kind];
        }
        return -1;
    }
}

/// Inherent visit hooks. The walk (`highlight_walk` in `highlight_walk.wado`)
/// calls them directly off the flat CST store.
impl HighlightVisitor {
    pub fn hl_enter(&mut self, rule_id: i32) {
        self.rule_stack.push(rule_id);
    }

    pub fn hl_exit(&mut self) {
        self.rule_stack.pop();
    }

    pub fn hl_visit_token(&mut self, toks: &TokenStream, idx: i32) {
        while self.visited.len() <= idx {
            self.visited.push(false);
        }
        self.visited[idx] = true;
        for let mut t = toks.triv_lo[idx]; t < toks.triv_hi[idx]; t += 1 {
            let id = self.classify(toks.triv_kinds[t]);
            if id >= 0 {
                self.captures.push(
                    HighlightCapture { capture_id: id, start: toks.triv_starts[t], end: toks.triv_ends[t] },
                );
            }
        }
        if toks.is_empty_text(idx) {
            return;
        }
        let id = self.classify(toks.kinds[idx]);
        if id >= 0 {
            self.captures.push(
                HighlightCapture { capture_id: id, start: toks.starts[idx], end: toks.ends[idx] },
            );
        }
    }

    /// Default-classify every token the tree walk did not reach, then restore
    /// start order. A no-op on a clean parse (the walk covers every token).
    pub fn hl_cover_unvisited(&mut self, toks: &TokenStream) {
        let before = self.captures.len();
        self.rule_stack = [];
        for let mut i = 0; i < toks.len(); i += 1 {
            if i < self.visited.len() && self.visited[i] {
                continue;
            }
            self.hl_visit_token(toks, i);
        }
        if self.captures.len() != before {
            self.captures.sort_by(|a: &HighlightCapture, b: &HighlightCapture| {
                return a.start.cmp(&b.start);
            });
        }
    }
}

fn escape_html_char(out: &mut String, c: char) {
    match c {
        '&' => out.push_str(&"&amp;"),
        '<' => out.push_str(&"&lt;"),
        '>' => out.push_str(&"&gt;"),
        '"' => out.push_str(&"&quot;"),
        _ => out.push(c),
    }
}

/// The `class` attribute text of a capture name: `keyword.select` → `keyword select`.
fn class_text(capture: &String) -> String {
    let mut out = String::with_capacity(capture.len());
    for let c of capture.chars() {
        if c == '.' {
            out.push(' ');
        } else {
            out.push(c);
        }
    }
    return out;
}

/// Produce a highlighted HTML fragment from source text and captures.
/// Captures must be sorted by start position (as produced by HighlightVisitor);
/// `classes` is the producing visitor's `capture_classes` table.
pub fn highlight_html(source: &String, captures: &List<HighlightCapture>, classes: &List<String>) -> String {
    let mut out = String::with_capacity(source.len() * 5);
    let mut pos = 0;
    let mut iter = source.chars();
    for let cap of captures {
        while pos < cap.start {
            if let Some(c) = iter.next() {
                escape_html_char(&mut out, c);
            }
            pos += 1;
        }
        out.push_str(&"<span class=\"");
        out.push_str(&classes[cap.capture_id]);
        out.push_str(&"\">");
        let end = cap.end;
        while pos < end {
            if let Some(c) = iter.next() {
                escape_html_char(&mut out, c);
            }
            pos += 1;
        }
        out.push_str(&"</span>");
    }
    while let Some(c) = iter.next() {
        escape_html_char(&mut out, c);
    }
    return out;
}
