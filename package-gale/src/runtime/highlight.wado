use { TokenStream } from "./lex.wado";

pub struct HighlightOverride {
    pub rule_name: String,
    pub token_kind: i32,
    pub capture: String,
}

pub struct HighlightMapping {
    pub defaults: List<String>,
    pub rule_names: List<String>,
    pub overrides: List<HighlightOverride>,
}

pub struct HighlightCapture {
    pub capture_id: i32,
    pub start: i32,
    pub end: i32,
}

struct ResolvedOverride {
    rule_id: i32,
    token_kind: i32,
    capture_id: i32,
}

pub struct HighlightVisitor {
    pub capture_names: List<String>,
    pub capture_classes: List<String>,
    default_ids: List<i32>,
    overrides: List<ResolvedOverride>,
    rule_stack: List<i32>,
    visited: List<bool>,
    pub captures: List<HighlightCapture>,
}

impl HighlightVisitor {
    pub fn new(mapping: HighlightMapping) -> HighlightVisitor {
        let mut capture_names: List<String> = [];
        let mut capture_classes: List<String> = [];
        let mut default_ids: List<i32> = List::with_capacity(mapping.defaults.len());
        for let d of &mapping.defaults {
            if d.is_empty() {
                default_ids.push(-1);
            } else {
                default_ids.push(capture_names.len());
                capture_classes.push(class_text(d));
                capture_names.push(*d);
            }
        }
        let mut overrides: List<ResolvedOverride> = List::with_capacity(mapping.overrides.len());
        for let ov of &mapping.overrides {
            let mut id: i32 = -1;
            for let mut i = 0; i < mapping.rule_names.len(); i += 1 {
                if mapping.rule_names[i] == ov.rule_name {
                    id = i;
                    break;
                }
            }
            if id < 0 {
                continue;
            }
            let capture_id = capture_names.len();
            capture_classes.push(class_text(&ov.capture));
            capture_names.push(ov.capture);
            overrides.push(ResolvedOverride { rule_id: id, token_kind: ov.token_kind, capture_id });
        }
        return HighlightVisitor {
            capture_names,
            capture_classes,
            default_ids,
            overrides,
            rule_stack: [],
            visited: [],
            captures: [],
        };
    }

    fn classify(&self, kind: i32) -> i32 {
        for let ov of &self.overrides {
            if ov.token_kind == kind {
                for let rule_id of &self.rule_stack {
                    if *rule_id == ov.rule_id {
                        return ov.capture_id;
                    }
                }
            }
        }
        if kind >= 0 && kind < self.default_ids.len() {
            return self.default_ids[kind];
        }
        return -1;
    }
}

impl HighlightVisitor {
    pub fn hl_enter(&mut self, rule_id: i32) {
        self.rule_stack.push(rule_id);
    }

    pub fn hl_exit(&mut self) {
        self.rule_stack.pop();
    }

    pub fn hl_visit_token(&mut self, toks: &TokenStream, idx: i32) {
        while self.visited.len() <= idx {
            self.visited.push(false);
        }
        self.visited[idx] = true;
        self.hl_capture_token(toks, idx);
    }

    fn hl_capture_token(&mut self, toks: &TokenStream, idx: i32) {
        for let mut t = toks.triv_lo[idx]; t < toks.triv_hi[idx]; t += 1 {
            let id = self.classify(toks.triv_kinds[t]);
            if id >= 0 {
                self.captures.push(
                    HighlightCapture { capture_id: id, start: toks.triv_starts[t], end: toks.triv_ends[t] },
                );
            }
        }
        if toks.is_empty_text(idx) {
            return;
        }
        let id = self.classify(toks.kinds[idx]);
        if id >= 0 {
            self.captures.push(
                HighlightCapture { capture_id: id, start: toks.starts[idx], end: toks.ends[idx] },
            );
        }
    }

    pub fn hl_cover_unvisited(&mut self, toks: &TokenStream) {
        let walked = self.captures.len();
        self.rule_stack = [];
        for let mut i = 0; i < toks.len(); i += 1 {
            if i < self.visited.len() && self.visited[i] {
                continue;
            }
            self.hl_capture_token(toks, i);
        }
        self.visited = List::filled(toks.len(), true);
        if walked > 0 && self.captures.len() != walked {
            self.captures.sort_by(|a: &HighlightCapture, b: &HighlightCapture| {
                return a.start.cmp(&b.start);
            });
        }
    }
}

struct HtmlCursor {
    byte_index: i32,
    char_index: i32,
}

fn push_escaped_upto(out: &mut String, source: &String, cur: &mut HtmlCursor, target: i32) {
    let n = source.len();
    let mut bi = cur.byte_index;
    let mut pos = cur.char_index;
    let mut run = bi;
    while pos < target && bi < n {
        let b = source.get_byte_unchecked(bi);
        if b >= b'\x80' {
            if b < b'\xe0' {
                bi += 2;
            } else if b < b'\xf0' {
                bi += 3;
            } else {
                bi += 4;
            }
        } else {
            if b == b'&' || b == b'<' || b == b'>' || b == b'"' {
                out.push_str_range_unchecked(source, run, bi);
                if b == b'&' {
                    out.push_str(&"&amp;");
                } else if b == b'<' {
                    out.push_str(&"&lt;");
                } else if b == b'>' {
                    out.push_str(&"&gt;");
                } else {
                    out.push_str(&"&quot;");
                }
                run = bi + 1;
            }
            bi += 1;
        }
        pos += 1;
    }
    out.push_str_range_unchecked(source, run, bi);
    cur.byte_index = bi;
    cur.char_index = pos;
}

fn class_text(capture: &String) -> String {
    let mut out = String::with_capacity(capture.len());
    for let c of capture.chars() {
        if c == '.' {
            out.push(' ');
        } else {
            out.push(c);
        }
    }
    return out;
}

pub fn highlight_html(source: &String, captures: &List<HighlightCapture>, classes: &List<String>) -> String {
    let mut out = String::with_capacity(source.len() * 5);
    let mut cur = HtmlCursor { byte_index: 0, char_index: 0 };
    for let cap of captures {
        push_escaped_upto(&mut out, source, &mut cur, cap.start);
        out.push_str(&"<span class=\"");
        out.push_str(&classes[cap.capture_id]);
        out.push_str(&"\">");
        push_escaped_upto(&mut out, source, &mut cur, cap.end);
        out.push_str(&"</span>");
    }
    push_escaped_upto(&mut out, source, &mut cur, source.len());
    return out;
}
