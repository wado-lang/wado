//! Typed-CST navigation helper, split out of `tools.wado` so the
//! sink-independent tools (`normalize_tree`, `to_lexer_string`) carry no
//! typed-CST dependency. Emitted only for the typed-CST path; the homogeneous
//! path navigates with `CstNode::find_child` + `to_string_subtree` instead.

use { CstNode, CstChild } from "./cst.wado";

/// Find the first direct child Node of `parent` whose rule name equals
/// `name`. Returns `None` when no such child exists. Used by Stage B sub-tree
/// drivers (a labelled sub-tree rather than the start rule's full tree).
pub fn find_first_child_node(parent: &CstNode, name: &String) -> Option<CstNode> {
    for let child of &parent.children {
        if let Node(n) = *child {
            if n.name == *name {
                return Option::Some(n);
            }
        }
    }
    return null;
}
