//! The single (untyped) concrete syntax tree produced by every
//! generated error-resilient parser, the `TreeBuilder` the parser drives to
//! construct it, and the `ParseResult` the parser returns.
//!
//! Flat green tree: nodes and child slots live in the struct-of-arrays
//! `CstArena`; a `Cst` cursor (arena ref + node id) walks it without
//! materialising per-node objects. Building is a single forward pass that only
//! appends to the arena's flat arrays.
//!
//! `Cst` is a lightweight handle; because Wado is GC'd with no borrow checker,
//! a cursor carries its `&CstArena` freely (store it, return it, recurse with
//! it) with none of the lifetime cost a borrow-checked language would impose.
//! Methods that need terminal text or kinds take a `&TokenStream` argument; the
//! arena stores token *indices*, never the stream.
//!
//! Error tokens are first-class and lossless: `Missing` (an inserted synthetic
//! terminal), `Skipped` (a real terminal deleted during recovery), and a
//! `<error>` region node (kind `K_ERROR`) together capture every recovery edit
//! (insert / delete / region) so the original input round-trips. The token-
//! stream flags (`TOK_SYNTHETIC` / `TOK_SKIPPED`, see `lex.wado`) carry the same
//! facts at the terminal level.
//!
//! Imports `TokenStream` from `lex.wado` and `Diagnostic` from `diag.wado`;
//! those imports are stripped at `#include_str` time (see `gen_runtime` in
//! `codegen.wado`), where the fragments are concatenated into one module.

use { Span, TokenStream } from "./lex.wado";
use { Diagnostic } from "./diag.wado";

/// A node's kind: a parser-rule id (`0..num_rules`, in grammar declaration
/// order) or the reserved `K_ERROR` sentinel for a recovery region node. A
/// newtype over `i32` so the generated parser can give it a name-aware
/// `Display` (`Inspect` shows `name(id)`); the name table is grammar-specific,
/// so codegen emits those impls.
pub type NodeKind = i32;

/// The reserved kind for a `<error>` region node — a run of skipped tokens or
/// a partial sub-parse swept up during panic-mode recovery. Never collides with
/// a real rule id (those are non-negative).
pub global K_ERROR: NodeKind = -1;

/// Node `flags` bits.
///
/// - `NODE_ERROR` — this node, or some descendant, contains a recovery edit
///   (a missing/skipped terminal or an error region). Bubbles up so a consumer
///   can prune clean subtrees in one check.
/// - `NODE_INCOMPLETE` — this node is missing a required terminal that the
///   parser had to insert (it has a `Missing` child).
pub global NODE_ERROR: i32 = 1;
pub global NODE_INCOMPLETE: i32 = 2;

/// Child-slot tags in `CstArena.slot_tag`.
global SLOT_NODE: i32 = 0;
global SLOT_TOKEN: i32 = 1;
global SLOT_MISSING: i32 = 2;
global SLOT_SKIPPED: i32 = 3;

/// A child slot of a node, yielded by `Cst::children`. The full error-token
/// vocabulary lives here: `Missing` is an inserted terminal, `Skipped` a
/// deleted terminal, and an error region is a `Node` whose kind is `K_ERROR`.
pub variant CstChild {
    Token(i32),  // a real terminal: an index into the TokenStream
    Missing(i32),  // an inserted synthetic terminal (zero-width; TOK_SYNTHETIC)
    Skipped(i32),  // a real terminal deleted during recovery (TOK_SKIPPED)
    Node(Cst),  // a sub-rule (an error region when its kind is K_ERROR)
}

/// The flat green tree: per-node parallel arrays plus a flat child-slot table.
/// A node is an index into the per-node arrays; its children form a singly
/// linked list through `slot_next`, headed by `first_child`. Building only ever
/// appends, so a node is created exactly once with no per-node allocation.
pub struct CstArena {
    kinds: List<NodeKind>,
    span_lo: List<i32>,
    span_hi: List<i32>,
    flags: List<i32>,
    alts: List<i32>,
    first_child: List<i32>,  // first child slot, or -1
    slot_tag: List<i32>,  // SLOT_NODE / SLOT_TOKEN / SLOT_MISSING / SLOT_SKIPPED
    slot_payload: List<i32>,  // child node id (Node) or token index (terminals)
    slot_next: List<i32>,  // next sibling slot, or -1
}

impl CstArena {
    /// A cursor at the root node (id 0 — the first node opened during the
    /// parse, i.e. the start rule). Valid once the tree has been built.
    pub fn root(&self) -> Cst with stores[self] {
        return Cst { arena: self, id: 0 };
    }
}

/// A lightweight handle to one node: an arena reference plus a node id. Cheap
/// to copy and free to carry (no lifetime cost under GC).
pub struct Cst {
    arena: &CstArena,
    id: i32,
}

impl Cst {
    pub fn kind(&self) -> NodeKind {
        return self.arena.kinds[self.id];
    }

    pub fn span(&self) -> Span {
        return Span::new(self.arena.span_lo[self.id], self.arena.span_hi[self.id]);
    }

    pub fn flags(&self) -> i32 {
        return self.arena.flags[self.id];
    }

    /// The matched labeled-alternative index for this rule node (0-based, in
    /// grammar declaration order), or -1 when the rule's alternatives are
    /// unlabeled, or for `K_ERROR` / non-rule nodes. The generated parser
    /// turns this into a typed `<Rule>Alt` enum via a `<rule>_alt` accessor.
    pub fn alt(&self) -> i32 {
        return self.arena.alts[self.id];
    }

    pub fn is_error(&self) -> bool {
        return self.flags() & NODE_ERROR != 0;
    }

    pub fn is_incomplete(&self) -> bool {
        return self.flags() & NODE_INCOMPLETE != 0;
    }

    /// Iterate this node's child slots in order.
    pub fn children(&self) -> CstChildren with stores[self] {
        return CstChildren { arena: self.arena, slot: self.arena.first_child[self.id] };
    }

    /// Number of direct children.
    pub fn child_count(&self) -> i32 {
        let mut n = 0;
        let mut slot = self.arena.first_child[self.id];
        while slot >= 0 {
            n += 1;
            slot = self.arena.slot_next[slot];
        }
        return n;
    }

    /// The `i`-th direct child slot. Panics if out of range.
    pub fn child(&self, i: i32) -> CstChild with stores[self] {
        let mut slot = self.arena.first_child[self.id];
        let mut k = 0;
        while slot >= 0 {
            if k == i {
                return slot_child(self.arena, slot);
            }
            k += 1;
            slot = self.arena.slot_next[slot];
        }
        panic("Cst::child: index out of range");
    }

    /// First direct child node of rule `kind`, or `null`. Used by sub-tree
    /// rendering (e.g. an ANTLR4 descriptor whose `[output]` is a labelled
    /// child subtree, not the start rule's full tree).
    pub fn find_child(&self, kind: NodeKind) -> Option<Cst> with stores[self] {
        for let child of self.children() {
            if let Node(n) = child {
                if n.kind() == kind {
                    return Option::Some(n);
                }
            }
        }
        return null;
    }

    /// ANTLR4-style S-expression: `(name child ...)`, tokens as their text.
    /// `rule_names[kind]` names rule nodes (`K_ERROR` renders `<error>`);
    /// `token_names[kind]` names missing terminals. Real terminals with empty
    /// text (e.g. EOF) are omitted; missing/skipped terminals render markers.
    pub fn to_string_tree(&self, toks: &TokenStream, rule_names: &List<String>, token_names: &List<String>) -> String {
        let mut out = String::with_capacity(256);
        cst_to_string_tree_impl(&mut out, self, toks, rule_names, token_names);
        return out;
    }
}

/// Iterator over a node's child slots (follows the `slot_next` chain).
pub struct CstChildren {
    arena: &CstArena,
    slot: i32,  // current slot, -1 when exhausted
}

impl Iterator for CstChildren {
    type Item = CstChild;

    fn next(&mut self) -> Option<CstChild> {
        if self.slot < 0 {
            return null;
        }
        let slot = self.slot;
        self.slot = self.arena.slot_next[slot];
        return Option::Some(slot_child(self.arena, slot));
    }
}

/// Build the `CstChild` for one child slot.
fn slot_child(arena: &CstArena, slot: i32) -> CstChild with stores[arena] {
    let tag = arena.slot_tag[slot];
    let payload = arena.slot_payload[slot];
    if tag == SLOT_NODE {
        return CstChild::Node(Cst { arena, id: payload });
    }
    if tag == SLOT_TOKEN {
        return CstChild::Token(payload);
    }
    if tag == SLOT_MISSING {
        return CstChild::Missing(payload);
    }
    return CstChild::Skipped(payload);
}

fn cst_to_string_tree_impl(
    out: &mut String,
    node: &Cst,
    toks: &TokenStream,
    rule_names: &List<String>,
    token_names: &List<String>,
) {
    out.push_str(&"(");
    if node.kind() == K_ERROR {
        out.push_str(&"<error>");
    } else {
        out.push_str(&rule_names[node.kind() as i32]);
    }
    for let child of node.children() {
        match child {
            Token(i) => {
                if !toks.is_empty_text(i) {
                    out.push_str(&" ");
                    toks.push_token_text(out, i);
                }
            },
            Missing(i) => {
                out.push_str(&` <missing {token_names[toks.kind_at(i)]}>`);
            },
            Skipped(i) => {
                out.push_str(&" <skip ");
                toks.push_token_text(out, i);
                out.push_str(&">");
            },
            Node(n) => {
                out.push_str(&" ");
                cst_to_string_tree_impl(out, &n, toks, rule_names, token_names);
            },
        }
    }
    out.push_str(&")");
}

/// What a parse returns: the tree arena (root is node 0), the token stream its
/// terminal indices point into, and any diagnostics. A clean parse leaves
/// `diagnostics` empty. Owns the arena and the stream outright.
pub struct ParseResult {
    pub arena: CstArena,
    pub tokens: TokenStream,
    pub diagnostics: List<Diagnostic>,
}

impl ParseResult {
    /// A cursor at the root node.
    pub fn root(&self) -> Cst with stores[self] {
        return self.arena.root();
    }

    pub fn has_errors(&self) -> bool {
        for let d of &self.diagnostics {
            if d.is_error() {
                return true;
            }
        }
        return false;
    }

    /// True when the parse produced no error-severity diagnostics.
    pub fn ok(&self) -> bool {
        return !self.has_errors();
    }
}

/// A flat event recorded by the parser as it descends. `finish()` replays the
/// events once to materialise the flat arena, so each node is created exactly
/// once (no per-step deep copy of the in-progress subtree).
variant BuildEvent {
    Open([NodeKind, i32]),  // [kind, start byte offset]
    Close(i32),  // end byte offset
    Tok(i32),  // real terminal index
    Miss(i32),  // inserted synthetic terminal index
    Skip(i32),  // skipped real terminal index
    SetAlt(i32),  // stamp the labeled-alternative index on the open node
}

/// The builder the generated parser drives. It records a flat event stream
/// (`start_node` / `token` / `missing` / `skip` / `finish_node`) and replays it
/// in `finish()`. It is purely structural — it stores token *indices*, never the
/// stream itself; the parser owns the `TokenStream`, appending synthetic
/// "missing" tokens and marking skipped ones on its own copy.
pub struct TreeBuilder {
    events: List<BuildEvent>,
}

impl TreeBuilder {
    pub fn new() -> TreeBuilder {
        return TreeBuilder { events: [] };
    }

    /// Open a rule node of `kind` starting at byte offset `start`.
    pub fn start_node(&mut self, kind: NodeKind, start: i32) {
        self.events.push(BuildEvent::Open([kind, start]));
    }

    /// Open a `<error>` region node (kind `K_ERROR`) at byte offset `start`.
    pub fn start_error(&mut self, start: i32) {
        self.events.push(BuildEvent::Open([K_ERROR, start]));
    }

    /// Stamp the matched labeled-alternative index on the innermost currently
    /// open node. The generated parser calls this once it commits to a labeled
    /// alternative; it is a no-op shape for unlabeled rules (never emitted).
    pub fn set_alt(&mut self, alt: i32) {
        self.events.push(BuildEvent::SetAlt(alt));
    }

    /// A position in the event stream to retro-open a node at. Used for
    /// left-associative wrapping (precedence climbing): capture a checkpoint
    /// before the first operand, then `start_node_at` to make a new node whose
    /// first child is everything recorded since the checkpoint.
    pub fn checkpoint(&self) -> i32 {
        return self.events.len();
    }

    /// Retro-open a node of `kind` (starting at byte offset `start`) at a
    /// previously captured `checkpoint`, so all events recorded since wrap
    /// inside it. Close it with the matching `finish_node`. Re-using the same
    /// checkpoint across loop iterations nests left-associatively.
    pub fn start_node_at(&mut self, checkpoint: i32, kind: NodeKind, start: i32) {
        self.events.insert(checkpoint, BuildEvent::Open([kind, start]));
    }

    /// Discard every event recorded since `checkpoint`, rolling the builder
    /// back to that point. Used by a *speculative* parse that runs only to
    /// localise a deep error (and then restores the cursor): under the
    /// emitter the speculative subtree must not leak into the real
    /// tree, so the caller brackets it with `checkpoint()` / `truncate()`.
    pub fn truncate(&mut self, checkpoint: i32) {
        while self.events.len() > checkpoint {
            let _ = self.events.pop();
        }
    }

    /// Close the innermost open node at byte offset `end`.
    pub fn finish_node(&mut self, end: i32) {
        self.events.push(BuildEvent::Close(end));
    }

    /// Append a real terminal (`idx` into the stream) to the open node.
    pub fn token(&mut self, idx: i32) {
        self.events.push(BuildEvent::Tok(idx));
    }

    /// Append an inserted synthetic terminal. `syn_idx` is the index returned
    /// by `TokenStream::push_synthetic`.
    pub fn missing(&mut self, syn_idx: i32) {
        self.events.push(BuildEvent::Miss(syn_idx));
    }

    /// Append a skipped real terminal. The caller marks `idx` with
    /// `TokenStream::mark_skipped` first.
    pub fn skip(&mut self, idx: i32) {
        self.events.push(BuildEvent::Skip(idx));
    }

    /// Materialise the flat arena. Valid once the root node has been closed.
    pub fn finish(&self) -> CstArena {
        return build_arena(&self.events);
    }
}

/// Append a child slot to the node at the top of the build stack, linking it
/// into that node's sibling chain.
fn append_slot(
    a: &mut CstArena,
    stack_node: &List<i32>,
    stack_last: &mut List<i32>,
    tag: i32,
    payload: i32,
) {
    let slot = a.slot_tag.len();
    a.slot_tag.push(tag);
    a.slot_payload.push(payload);
    a.slot_next.push(-1);
    let top = stack_last.len() - 1;
    let last = stack_last[top];
    if last < 0 {
        a.first_child[stack_node[top]] = slot;
    } else {
        a.slot_next[last] = slot;
    }
    stack_last[top] = slot;
}

/// Replay the flat event stream into a `CstArena` in one forward pass. An
/// explicit stack tracks (open node id, last appended child slot) per frame, so
/// every step is a flat array append — no per-node allocation or recursion.
fn build_arena(events: &List<BuildEvent>) -> CstArena {
    let n = events.len();
    let mut node_count = 0;
    let mut term_count = 0;
    for let mut pos = 0; pos < n; pos += 1 {
        match events[pos] {
            Open(_) => node_count += 1,
            Tok(_) => term_count += 1,
            Miss(_) => term_count += 1,
            Skip(_) => term_count += 1,
            Close(_) => {},
            SetAlt(_) => {},
        }
    }
    let node_cap = node_count + 1;
    let slot_cap = term_count + node_count + 1;
    let mut a = CstArena {
        kinds: List::with_capacity(node_cap),
        span_lo: List::with_capacity(node_cap),
        span_hi: List::with_capacity(node_cap),
        flags: List::with_capacity(node_cap),
        alts: List::with_capacity(node_cap),
        first_child: List::with_capacity(node_cap),
        slot_tag: List::with_capacity(slot_cap),
        slot_payload: List::with_capacity(slot_cap),
        slot_next: List::with_capacity(slot_cap),
    };
    let mut stack_node: List<i32> = [];
    let mut stack_last: List<i32> = [];
    for let mut pos = 0; pos < n; pos += 1 {
        match events[pos] {
            Open(info) => {
                let kind = info.0;
                let start = info.1;
                let id = a.kinds.len();
                a.kinds.push(kind);
                a.span_lo.push(start);
                a.span_hi.push(start);
                a.flags.push(if kind == K_ERROR { NODE_ERROR } else { 0 });
                a.alts.push(-1);
                a.first_child.push(-1);
                if stack_node.len() > 0 {
                    append_slot(&mut a, &stack_node, &mut stack_last, SLOT_NODE, id);
                }
                stack_node.push(id);
                stack_last.push(-1);
            },
            Close(e) => {
                let top = stack_node.len() - 1;
                let id = stack_node[top];
                let end = if e > a.span_hi[id] { e } else { a.span_hi[id] };
                a.span_hi[id] = end;
                let _ = stack_node.pop();
                let _ = stack_last.pop();
                if stack_node.len() > 0 {
                    let parent = stack_node[stack_node.len() - 1];
                    if end > a.span_hi[parent] {
                        a.span_hi[parent] = end;
                    }
                    if a.flags[id] & NODE_ERROR != 0 {
                        a.flags[parent] = a.flags[parent] | NODE_ERROR;
                    }
                }
            },
            Tok(i) => {
                append_slot(&mut a, &stack_node, &mut stack_last, SLOT_TOKEN, i);
            },
            Miss(i) => {
                append_slot(&mut a, &stack_node, &mut stack_last, SLOT_MISSING, i);
                let top = stack_node[stack_node.len() - 1];
                a.flags[top] = a.flags[top] | NODE_INCOMPLETE | NODE_ERROR;
            },
            Skip(i) => {
                append_slot(&mut a, &stack_node, &mut stack_last, SLOT_SKIPPED, i);
                let top = stack_node[stack_node.len() - 1];
                a.flags[top] = a.flags[top] | NODE_ERROR;
            },
            SetAlt(alt) => {
                let top = stack_node[stack_node.len() - 1];
                a.alts[top] = alt;
            },
        }
    }
    return a;
}
