//! Unit tests for the FOLLOW gate queries (`follow.wado`).

use { follow_admits, follow_exit_viable, follow_open_set, follow_resumes } from "./follow.wado";

global EOF_KIND: i32 = -1;

// An empty set is a wildcard (`.`), whether it heads a reading in the slots or
// in the open field.
test "an empty open set admits any kind, as an empty slot set does" {
    let tokens = ([5] as List<i32>).to_array();
    let sets: List<List<i32>> = [[]];
    let open = follow_open_set(1);
    assert follow_admits(&tokens, 0, open, &sets, EOF_KIND);
    assert follow_resumes(&tokens, 0, open, &sets, EOF_KIND);
    assert follow_exit_viable(&tokens, 0, open, &sets, EOF_KIND);
    assert follow_admits(&tokens, 0, 1, &sets, EOF_KIND);
}

test "a non-empty open set admits only its kinds" {
    let tokens = ([5, 6] as List<i32>).to_array();
    let sets: List<List<i32>> = [
        [1 << 5],
    ];
    let open = follow_open_set(1);
    assert follow_admits(&tokens, 0, open, &sets, EOF_KIND);
    assert !follow_resumes(&tokens, 1, open, &sets, EOF_KIND);
}
