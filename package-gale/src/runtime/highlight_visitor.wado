//! Typed-CST bridge for the highlighter: a thin `Visitor` impl that delegates
//! to `HighlightVisitor`'s sink-independent `hl_*` hooks (`highlight.wado`).
//! Emitted only for the typed-CST highlight path; the generated `walk_<rule>`
//! functions drive it through the `Visitor` trait. The homogeneous path walks
//! the `CstNode` tree directly (`highlight_homog.wado`) and never needs this.

use { Span, TokenStream } from "./lex.wado";
use { Visitor } from "./cst.wado";
use { HighlightVisitor } from "./highlight.wado";

impl Visitor for HighlightVisitor {
    fn enter_rule(&mut self, rule_id: i32, name: &String, span: &Span) {
        self.hl_enter(rule_id);
    }

    fn exit_rule(&mut self, rule_id: i32, name: &String, span: &Span) {
        self.hl_exit();
    }

    fn visit_token(&mut self, toks: &TokenStream, idx: i32) {
        self.hl_visit_token(toks, idx);
    }
}
