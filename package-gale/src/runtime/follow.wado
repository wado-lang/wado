pub global EMPTY_FOLLOW: List<i32> = [];

pub global FOLLOW_MAX_DEPTH: i32 = 4;

fn follow_slot_alive(
    part: &List<i32>,
    tokens: &Array<i32>,
    pos: i32,
    sets: &List<List<i32>>,
    eof_kind: i32,
    depth: &mut i32,
    alive: &mut bool,
    constrained: &mut bool,
) {
    for let id of part {
        if *depth >= FOLLOW_MAX_DEPTH {
            return;
        }
        *constrained = true;
        if *alive {
            let set = &sets[*id];
            if !set.is_empty() {
                let idx = pos + *depth;
                let kind = if idx < tokens.len() { tokens[idx] } else { eof_kind };
                let mut hit = false;
                for let t of set {
                    if kind == *t {
                        hit = true;
                        break;
                    }
                }
                if !hit {
                    *alive = false;
                }
            }
        }
        *depth += 1;
    }
}

pub fn follow_yields(
    tokens: &Array<i32>,
    pos: i32,
    f0: &List<i32>,
    f1: &List<i32>,
    f2: &List<i32>,
    f3: &List<i32>,
    fs: i32,
    sets: &List<List<i32>>,
    eof_kind: i32,
) -> bool {
    if f0.is_empty() {
        return false;
    }
    let mut depth = 0;
    let mut alive = true;
    let mut constrained = false;
    follow_slot_alive(f0, tokens, pos, sets, eof_kind, &mut depth, &mut alive, &mut constrained);
    if fs >> 1 & 1 == 1 {
        if alive && constrained {
            return true;
        }
        depth = 0;
        alive = true;
        constrained = false;
    }
    follow_slot_alive(f1, tokens, pos, sets, eof_kind, &mut depth, &mut alive, &mut constrained);
    if fs >> 2 & 1 == 1 {
        if alive && constrained {
            return true;
        }
        depth = 0;
        alive = true;
        constrained = false;
    }
    follow_slot_alive(f2, tokens, pos, sets, eof_kind, &mut depth, &mut alive, &mut constrained);
    if fs >> 3 & 1 == 1 {
        if alive && constrained {
            return true;
        }
        depth = 0;
        alive = true;
        constrained = false;
    }
    follow_slot_alive(f3, tokens, pos, sets, eof_kind, &mut depth, &mut alive, &mut constrained);
    return alive && constrained;
}
