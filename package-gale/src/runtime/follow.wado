pub global EMPTY_FOLLOW: List<List<i32>> = [];

pub global FOLLOW_ALT_MARK: i32 = -1;

fn is_follow_alt_mark(depth: &List<i32>) -> bool {
    return depth.len() == 1 && depth[0] == FOLLOW_ALT_MARK;
}

pub fn follow_alt(first: &List<List<i32>>, second: &List<List<i32>>) -> List<List<i32>> {
    if first.is_empty() {
        return *second;
    }
    if second.is_empty() {
        return *first;
    }
    let mut joined: List<List<i32>> = List::with_capacity(first.len() + second.len() + 1);
    for let depth of first {
        joined.push(*depth);
    }
    joined.push([FOLLOW_ALT_MARK]);
    for let depth of second {
        joined.push(*depth);
    }
    return joined;
}

pub fn follow_prepend(prefix: &List<List<i32>>, follow: &List<List<i32>>) -> List<List<i32>> {
    if follow.is_empty() {
        return *prefix;
    }
    let mut combined: List<List<i32>> = List::with_capacity(prefix.len() + follow.len());
    for let depth of prefix {
        combined.push(*depth);
    }
    for let depth of follow {
        combined.push(*depth);
        if is_follow_alt_mark(depth) {
            for let head of prefix {
                combined.push(*head);
            }
        }
    }
    return combined;
}

pub fn follow_yields(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>>, eof_kind: i32) -> bool {
    if follow.is_empty() {
        return false;
    }
    let mut depth = 0;
    let mut alive = true;
    let mut constrained = false;
    for let mut i = 0; i < follow.len(); i += 1 {
        let set = &follow[i];
        if is_follow_alt_mark(set) {
            if alive && constrained {
                return true;
            }
            depth = 0;
            alive = true;
            constrained = false;
            continue;
        }
        constrained = true;
        if !alive {
            continue;
        }
        if !set.is_empty() {
            let idx = pos + depth;
            let kind = if idx < tokens.len() { tokens[idx] } else { eof_kind };
            let mut hit = false;
            for let t of set {
                if kind == *t {
                    hit = true;
                    break;
                }
            }
            if !hit {
                alive = false;
            }
        }
        depth += 1;
    }
    return alive && constrained;
}
