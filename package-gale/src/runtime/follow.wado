pub global EMPTY_FOLLOW: List<i32> = [];

pub global FOLLOW_ALT_MARK: i32 = -1;

pub global FOLLOW_MAX_DEPTH: i32 = 4;

fn append_capped(out: &mut List<i32>, follow: &List<i32>, start_depth: i32) {
    let mut depth = start_depth;
    for let set of follow {
        if *set == FOLLOW_ALT_MARK {
            out.push(*set);
            depth = 0;
        } else if depth < FOLLOW_MAX_DEPTH {
            out.push(*set);
            depth += 1;
        }
    }
}

pub fn follow_alt(first: &List<i32>, second: &List<i32>) -> List<i32> {
    if first.is_empty() {
        return *second;
    }
    if second.is_empty() {
        return *first;
    }
    let mut joined: List<i32> = List::with_capacity(first.len() + second.len() + 1);
    append_capped(&mut joined, first, 0);
    joined.push(FOLLOW_ALT_MARK);
    append_capped(&mut joined, second, 0);
    return joined;
}

pub fn follow_prepend(prefix: &List<i32>, follow: &List<i32>) -> List<i32> {
    if follow.is_empty() || prefix.len() >= FOLLOW_MAX_DEPTH {
        return *prefix;
    }
    let mut combined: List<i32> = List::with_capacity(prefix.len() + follow.len());
    for let set of prefix {
        combined.push(*set);
    }
    let mut depth = prefix.len();
    for let set of follow {
        if *set == FOLLOW_ALT_MARK {
            combined.push(*set);
            for let head of prefix {
                combined.push(*head);
            }
            depth = prefix.len();
        } else if depth < FOLLOW_MAX_DEPTH {
            combined.push(*set);
            depth += 1;
        }
    }
    return combined;
}

pub fn follow_yields(tokens: &Array<i32>, pos: i32, follow: &List<i32>, sets: &List<List<i32>>, eof_kind: i32) -> bool {
    if follow.is_empty() {
        return false;
    }
    let mut depth = 0;
    let mut alive = true;
    let mut constrained = false;
    for let mut i = 0; i < follow.len(); i += 1 {
        if follow[i] == FOLLOW_ALT_MARK {
            if alive && constrained {
                return true;
            }
            depth = 0;
            alive = true;
            constrained = false;
            continue;
        }
        constrained = true;
        if !alive {
            continue;
        }
        let set = &sets[follow[i]];
        if !set.is_empty() {
            let idx = pos + depth;
            let kind = if idx < tokens.len() { tokens[idx] } else { eof_kind };
            let mut hit = false;
            for let t of set {
                if kind == *t {
                    hit = true;
                    break;
                }
            }
            if !hit {
                alive = false;
            }
        }
        depth += 1;
    }
    return alive && constrained;
}
