pub global FOLLOW_MAX_DEPTH: i32 = 4;

pub global FOLLOW_SLOT_BITS: i64 = 8;

pub global FOLLOW_ID_MASK: i64 = 127;

pub global FOLLOW_OPENS_BIT: i64 = 128;

pub global FOLLOW_CONT_MASK: i64 = 0x00FF_FFFF_FFFF_FFFF;

pub fn follow_bitsets(kinds: &List<List<i32>>) -> List<List<i32>> {
    let mut out: List<List<i32>> = [];
    for let set of kinds {
        let mut words: List<i32> = [];
        for let kind of set {
            assert *kind >= 0, `follow_bitsets: negative token kind ${*kind}`;
            let w = *kind >> 5;
            while words.len() <= w {
                words.push(0);
            }
            words[w] = words[w] | 1 << (*kind & 31);
        }
        out.push(words);
    }
    return out;
}

fn follow_set_has(set: &List<i32>, kind: i32) -> bool {
    let w = kind >> 5;
    if w >= set.len() {
        return false;
    }
    return set[w] >> (kind & 31) & 1 == 1;
}

pub fn follow_yields(tokens: &Array<i32>, pos: i32, cont: i64, sets: &List<List<i32>>, eof_kind: i32) -> bool {
    let mut c = cont;
    let mut depth = 0;
    let mut alive = true;
    let mut constrained = false;
    while c & FOLLOW_ID_MASK != 0 {
        if c & FOLLOW_OPENS_BIT != 0 {
            if alive && constrained {
                return true;
            }
            depth = 0;
            alive = true;
            constrained = false;
        }
        if depth < FOLLOW_MAX_DEPTH {
            constrained = true;
            if alive {
                let set = &sets[((c & FOLLOW_ID_MASK) - 1) as i32];
                if !set.is_empty() {
                    let idx = pos + depth;
                    let kind = if idx < tokens.len() { tokens[idx] } else { eof_kind };
                    if !follow_set_has(set, kind) {
                        alive = false;
                    }
                }
            }
            depth += 1;
        }
        c = c >> FOLLOW_SLOT_BITS;
    }
    return alive && constrained;
}
