#![allow(dead_code)]

use { kind_set_has } from "./lex.wado";
use { HashMap, HashSeed } from "core:collections";

internal global FOLLOW_MAX_DEPTH: i32 = 4;

internal global FOLLOW_SLOT_BITS: i64 = 8;

internal global FOLLOW_ID_MASK: i64 = 127;

internal global FOLLOW_OPENS_BIT: i64 = 128;

internal global FOLLOW_CONT_MASK: i64 = 0x0000_FFFF_FFFF_FFFF;

internal global FOLLOW_SEQUENCED: i64 = 0x0000_7F7F_7F7F_7F7F;

internal global FOLLOW_OPEN_READING: i64 = 0x0001_0000_0000_0000;

internal global FOLLOW_OPEN_FIELD: i64 = ~0x0000_FFFF_FFFF_FFFF;

internal global FOLLOW_OPEN_SET_SHIFT: i64 = 49;

global FOLLOW_OPEN_ID_MASK: i64 = 0x7FFF;

global FOLLOW_OPEN_UNION_BASE: i64 = FOLLOW_ID_MASK + 1;

internal fn follow_open_mark(cont: i64) -> i64 {
    return if cont == 0 { FOLLOW_OPEN_READING } else { cont & FOLLOW_OPEN_FIELD };
}

internal fn follow_open_set(mask: i64) -> i64 {
    return FOLLOW_OPEN_READING | (mask & FOLLOW_ID_MASK) << FOLLOW_OPEN_SET_SHIFT;
}

internal fn follow_open_join(a: i64, b: i64) -> i64 {
    if a == 0 || a == b {
        return b;
    }
    if b == 0 {
        return a;
    }
    return FOLLOW_OPEN_READING | follow_open_union(follow_open_id(a), follow_open_id(b)) << FOLLOW_OPEN_SET_SHIFT;
}

fn follow_open_id(open: i64) -> i64 {
    return open >> FOLLOW_OPEN_SET_SHIFT & FOLLOW_OPEN_ID_MASK;
}

struct FollowOpenUnions {
    members: List<[i64, i64]>,
    joined: HashMap<i64, i64>,
}

global mut FOLLOW_OPEN_UNIONS: FollowOpenUnions = FollowOpenUnions { members: [], joined: HashMap::with_seed(
    FOLLOW_SEED,
) };

fn follow_open_union(a: i64, b: i64) -> i64 {
    let key = i64::min(a, b) | i64::max(a, b) << 16;
    if let Some(id) = FOLLOW_OPEN_UNIONS.joined.get(key) {
        return id;
    }
    let [a_low, a_high] = follow_open_members(a);
    let [b_low, b_high] = follow_open_members(b);
    let members = [a_low | b_low, a_high | b_high];
    let mut index = 0;
    while index < FOLLOW_OPEN_UNIONS.members.len() && FOLLOW_OPEN_UNIONS.members[index] != members {
        index += 1;
    }
    if index == FOLLOW_OPEN_UNIONS.members.len() {
        FOLLOW_OPEN_UNIONS.members.push(members);
    }
    let id = FOLLOW_OPEN_UNION_BASE + index as i64;
    assert id <= FOLLOW_OPEN_ID_MASK, "the open unions must fit the open field";
    FOLLOW_OPEN_UNIONS.joined[key] = id;
    return id;
}

fn follow_open_members(id: i64) -> [i64, i64] {
    if id >= FOLLOW_OPEN_UNION_BASE {
        return FOLLOW_OPEN_UNIONS.members[(id - FOLLOW_OPEN_UNION_BASE) as i32];
    }
    return if id < 64 { [1 << id, 0] } else { [0, 1 << id - 64] };
}

internal fn follow_open_with(cont: i64, open: i64) -> i64 {
    return cont & FOLLOW_CONT_MASK | follow_open_join(follow_open_mark(cont), open);
}

internal fn follow_then(prefix: i64, prefix_bits: i64, cont: i64) -> i64 {
    return prefix | (follow_behind(cont, prefix_bits) & FOLLOW_SEQUENCED) << prefix_bits;
}

internal fn follow_then_opening(prefix: i64, prefix_bits: i64, cont: i64) -> i64 {
    let opened = (follow_behind(cont, prefix_bits) | FOLLOW_OPENS_BIT) << prefix_bits;
    return prefix | opened | follow_open_mark(cont);
}

internal fn follow_or(prefix: i64, prefix_bits: i64, alternative: i64) -> i64 {
    let opened = (follow_behind(alternative, prefix_bits) | FOLLOW_OPENS_BIT) << prefix_bits;
    return prefix | opened | alternative & FOLLOW_OPEN_FIELD;
}

internal global FOLLOW_LINK_ID: i64 = 127;

internal global FOLLOW_CONT_BITS: i64 = 48;

global FOLLOW_INDEX_BITS: i64 = 7;

struct FollowLinks {
    conts: List<i64>,
    ids: HashMap<i64, i32>,
}

global FOLLOW_SEED: HashSeed = HashSeed::fixed(0x5BD1E9955BD1E995, 0x27D4EB2F165667C5);

global mut FOLLOW_LINKS: FollowLinks = FollowLinks { conts: [], ids: HashMap::with_seed(FOLLOW_SEED) };

internal fn follow_links_reset() {
    FOLLOW_LINKS = FollowLinks { conts: [], ids: HashMap::with_seed(FOLLOW_SEED) };
}

fn follow_behind(cont: i64, prefix_bits: i64) -> i64 {
    let slots = cont & FOLLOW_CONT_MASK;
    let room = FOLLOW_CONT_BITS - prefix_bits;
    if slots >> room == 0 {
        return slots;
    }
    assert !follow_is_link(slots), "a continuation starts with its prefix, never a link";
    let link = FOLLOW_LINK_ID | follow_spread_index(follow_link_id(cont)) << FOLLOW_SLOT_BITS;
    assert link >> room == 0, "a link must fit behind the prefix";
    return link;
}

fn follow_link_id(cont: i64) -> i32 {
    if let Some(id) = FOLLOW_LINKS.ids.get(cont) {
        return id;
    }
    let id = FOLLOW_LINKS.conts.len();
    FOLLOW_LINKS.conts.push(cont);
    FOLLOW_LINKS.ids[cont] = id;
    return id;
}

fn follow_spread_index(id: i32) -> i64 {
    let mut spread: i64 = 0;
    let mut shift: i64 = 0;
    let mut rest = id as i64;
    while rest != 0 {
        spread |= (rest & FOLLOW_ID_MASK) << shift;
        rest >>= FOLLOW_INDEX_BITS;
        shift += FOLLOW_SLOT_BITS;
    }
    return spread;
}

fn follow_gather_index(spread: i64) -> i32 {
    let mut id: i64 = 0;
    let mut shift: i64 = 0;
    let mut rest = spread;
    while rest != 0 {
        id |= (rest & FOLLOW_ID_MASK) << shift;
        rest >>= FOLLOW_SLOT_BITS;
        shift += FOLLOW_INDEX_BITS;
    }
    return id as i32;
}

fn follow_is_link(c: i64) -> bool {
    return c & FOLLOW_ID_MASK == FOLLOW_LINK_ID;
}

fn follow_link_opens(c: i64) -> bool {
    return c & FOLLOW_OPENS_BIT != 0;
}

fn follow_linked(c: i64) -> i64
    contract follow_is_link(c)
{
    let target = FOLLOW_LINKS.conts[follow_gather_index(c >> FOLLOW_SLOT_BITS)] & FOLLOW_CONT_MASK;
    return if follow_link_opens(c) { target | FOLLOW_OPENS_BIT } else { target & FOLLOW_SEQUENCED };
}

internal fn follow_admits(tokens: &Array<i32>, pos: i32, cont: i64, sets: &List<List<i32>>, eof_kind: i32) -> bool {
    return follow_heads_have(tokens, pos, cont, sets, eof_kind, true);
}

internal fn follow_resumes(tokens: &Array<i32>, pos: i32, cont: i64, sets: &List<List<i32>>, eof_kind: i32) -> bool {
    return follow_heads_have(tokens, pos, cont, sets, eof_kind, false);
}

internal fn follow_exit_viable(tokens: &Array<i32>, pos: i32, cont: i64, sets: &List<List<i32>>, eof_kind: i32) -> bool {
    if cont == 0 || follow_yields(tokens, pos, cont, sets, eof_kind) {
        return true;
    }
    let kind = follow_kind_at(tokens, pos, eof_kind);
    return follow_open_has(cont, kind, sets, true);
}

fn follow_open_has(cont: i64, kind: i32, sets: &List<List<i32>>, unknown_has: bool) -> bool {
    let open = cont & FOLLOW_OPEN_FIELD;
    if open == 0 {
        return false;
    }
    let id = follow_open_id(open);
    if id < FOLLOW_OPEN_UNION_BASE {
        return follow_open_member_has(id, kind, sets, unknown_has);
    }
    let [low, high] = follow_open_members(id);
    return follow_open_word_has(low, 0, kind, sets, unknown_has)
        || follow_open_word_has(high, 64, kind, sets, unknown_has);
}

fn follow_open_word_has(word: i64, base: i64, kind: i32, sets: &List<List<i32>>, unknown_has: bool) -> bool {
    let mut rest = word;
    while rest != 0 {
        if follow_open_member_has(base + i64::ctz(rest), kind, sets, unknown_has) {
            return true;
        }
        rest &= rest - 1;
    }
    return false;
}

fn follow_open_member_has(id: i64, kind: i32, sets: &List<List<i32>>, unknown_has: bool) -> bool {
    return if id == 0 { unknown_has } else { follow_set_has(sets, id, kind) };
}

fn follow_kind_at(tokens: &Array<i32>, pos: i32, eof_kind: i32) -> i32 {
    return if pos < tokens.len() { tokens[pos] } else { eof_kind };
}

fn follow_set_has(sets: &List<List<i32>>, id: i64, kind: i32) -> bool {
    let set = &sets[(id - 1) as i32];
    return set.is_empty() || kind_set_has(set, kind);
}

fn follow_heads_have(
    tokens: &Array<i32>,
    pos: i32,
    cont: i64,
    sets: &List<List<i32>>,
    eof_kind: i32,
    unknown_has: bool,
) -> bool {
    if cont == 0 {
        return unknown_has;
    }
    let kind = follow_kind_at(tokens, pos, eof_kind);
    if follow_open_has(cont, kind, sets, unknown_has) {
        return true;
    }
    let mut c = cont & FOLLOW_CONT_MASK;
    let mut head = true;
    while c & FOLLOW_ID_MASK != 0 {
        if follow_is_link(c) {
            if !follow_link_opens(c) {
                break;
            }
            c = follow_linked(c);
        }
        if c & FOLLOW_OPENS_BIT != 0 {
            head = true;
        }
        if head {
            if follow_set_has(sets, c & FOLLOW_ID_MASK, kind) {
                return true;
            }
            head = false;
        }
        c >>= FOLLOW_SLOT_BITS;
    }
    return false;
}

internal fn follow_yields(tokens: &Array<i32>, pos: i32, cont: i64, sets: &List<List<i32>>, eof_kind: i32) -> bool {
    let mut c = cont & FOLLOW_CONT_MASK;
    let mut depth = 0;
    let mut alive = true;
    let mut constrained = false;
    while c & FOLLOW_ID_MASK != 0 {
        if follow_is_link(c) {
            if !follow_link_opens(c) && depth >= FOLLOW_MAX_DEPTH {
                break;
            }
            c = follow_linked(c);
        }
        if c & FOLLOW_OPENS_BIT != 0 {
            if alive && constrained {
                return true;
            }
            depth = 0;
            alive = true;
            constrained = false;
        }
        if depth < FOLLOW_MAX_DEPTH {
            constrained = true;
            if alive {
                alive = follow_set_has(sets, c & FOLLOW_ID_MASK, follow_kind_at(tokens, pos + depth, eof_kind));
            }
            depth += 1;
        }
        c >>= FOLLOW_SLOT_BITS;
    }
    return alive && constrained;
}
