#![allow(dead_code)]

use { HashMap, HashSeed } from "core:collections";

internal global FOLLOW_MAX_DEPTH: i32 = 4;

internal global FOLLOW_SLOT_BITS: i64 = 10;

internal global FOLLOW_ID_MASK: i64 = 1023;

internal global FOLLOW_LINK_ID: i64 = FOLLOW_ID_MASK;

internal global FOLLOW_CONT_BITS: i64 = 60;

internal struct FollowTables {
    internal stride: i32,
    internal sets: List<i32>,
    internal starts: List<i32>,
    internal readings: List<i32>,
}

internal fn follow_push(site: i64, cont: i64) -> i64 {
    return site | follow_behind(cont, FOLLOW_SLOT_BITS) << FOLLOW_SLOT_BITS;
}

struct FollowLinks {
    conts: List<i64>,
    ids: HashMap<i64, i32>,
}

global FOLLOW_SEED: HashSeed = HashSeed::fixed(0x5BD1E9955BD1E995, 0x27D4EB2F165667C5);

global mut FOLLOW_LINKS: FollowLinks = FollowLinks { conts: [], ids: HashMap::with_seed(FOLLOW_SEED) };

internal fn follow_links_reset() {
    FOLLOW_LINKS = FollowLinks { conts: [], ids: HashMap::with_seed(FOLLOW_SEED) };
}

fn follow_behind(cont: i64, prefix_bits: i64) -> i64 {
    let room = FOLLOW_CONT_BITS - prefix_bits;
    if cont >> room == 0 {
        return cont;
    }
    assert !follow_is_link(cont), "a continuation starts with a site, never a link";
    let link = FOLLOW_LINK_ID | follow_link_id(cont) as i64 << FOLLOW_SLOT_BITS;
    assert link >> room == 0, "a link must fit behind the prefix";
    return link;
}

fn follow_link_id(cont: i64) -> i32 {
    if let Some(id) = FOLLOW_LINKS.ids.get(cont) {
        return id;
    }
    let id = FOLLOW_LINKS.conts.len();
    FOLLOW_LINKS.conts.push(cont);
    FOLLOW_LINKS.ids[cont] = id;
    return id;
}

fn follow_is_link(c: i64) -> bool {
    return c & FOLLOW_ID_MASK == FOLLOW_LINK_ID;
}

fn follow_linked(c: i64) -> i64
    contract follow_is_link(c)
{
    return FOLLOW_LINKS.conts[(c >> FOLLOW_SLOT_BITS) as i32];
}

internal fn follow_yields(tokens: &Array<i32>, pos: i32, cont: i64, tables: &FollowTables, eof_kind: i32) -> bool {
    return follow_reads(tokens, pos, cont, 0, FOLLOW_MAX_DEPTH, false, tables, eof_kind);
}

internal fn follow_admits(tokens: &Array<i32>, pos: i32, cont: i64, tables: &FollowTables, eof_kind: i32) -> bool {
    return follow_reads(tokens, pos, cont, 0, 1, true, tables, eof_kind);
}

internal fn follow_resumes(tokens: &Array<i32>, pos: i32, cont: i64, tables: &FollowTables, eof_kind: i32) -> bool {
    return follow_reads(tokens, pos, cont, 0, 1, false, tables, eof_kind);
}

fn follow_reads(
    tokens: &Array<i32>,
    pos: i32,
    cont: i64,
    depth: i32,
    budget: i32,
    unknown_reads: bool,
    tables: &FollowTables,
    eof_kind: i32,
) -> bool {
    let mut c = cont;
    loop {
        let site = c & FOLLOW_ID_MASK;
        if site == 0 {
            return depth > 0 || unknown_reads;
        }
        if site == FOLLOW_LINK_ID {
            c = follow_linked(c);
            continue;
        }
        let rest = c >> FOLLOW_SLOT_BITS;
        let readings = &tables.readings;
        let mut at = tables.starts[site as i32 - 1];
        let end = tables.starts[site as i32];
        let heads = readings[at];
        if !follow_set_has(tables, heads >> 1, follow_kind_at(tokens, pos + depth, eof_kind)) {
            if heads & 1 == 0 {
                return false;
            }
            c = rest;
            continue;
        }
        if depth + 1 >= budget {
            return true;
        }
        at += 1;
        while at < end {
            let len = readings[at] >> 1;
            let mut matched = 0;
            while matched < len
                && depth + matched < budget
                && follow_set_has(tables, readings[at + 1 + matched], follow_kind_at(
                    tokens,
                    pos + depth + matched,
                    eof_kind,
                )) {
                matched += 1;
            }
            if depth + matched >= budget {
                return true;
            }
            if matched == len
                && readings[at] & 1 != 0
                && follow_reads(tokens, pos, rest, depth + len, budget, unknown_reads, tables, eof_kind) {
                return true;
            }
            at += 1 + len;
        }
        return false;
    }
}

fn follow_kind_at(tokens: &Array<i32>, pos: i32, eof_kind: i32) -> i32 {
    return if pos < tokens.len() { tokens[pos] } else { eof_kind };
}

fn follow_set_has(tables: &FollowTables, set: i32, kind: i32) -> bool {
    let word = kind >> 5;
    return word < tables.stride && tables.sets[set * tables.stride + word] >> (kind & 31) & 1 != 0;
}
