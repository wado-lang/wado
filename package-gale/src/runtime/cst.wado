//! Generic (untyped) concrete syntax tree, the `Visitor` trait every
//! generated walker drives, and the `TreeRecorder` that materialises a
//! `CstNode` tree from a walk (`to_tree`). Always emitted into generated
//! parsers. Imports its lexing vocabulary from `lex.wado`; that import is
//! stripped at `#include_str` time (see `gen_runtime` in `codegen.wado`),
//! where `lex.wado` is concatenated first.

use { Span, TokenStream } from "./lex.wado";

/// A parse result: the typed root node plus the `TokenStream` its terminal
/// `i32` indices point into. A token is a bare index, so the tree is only
/// meaningful alongside its stream; bundling them keeps every consumer
/// self-contained without per-terminal allocation.
pub struct ParseResult<T> {
    pub root: T,
    pub tokens: TokenStream,
}

/// CstChild is either a terminal token (its `i32` index into the stream) or
/// a non-terminal sub-tree.
pub variant CstChild {
    Token(i32),
    Node(CstNode),
}

/// CstNode is a generic (untyped) concrete syntax tree node. It borrows the
/// `TokenStream` so terminal text/span render from the stored `i32` indices.
pub struct CstNode {
    pub name: String,
    pub span: Span,
    pub children: List<CstChild>,
    pub toks: &TokenStream,
}

impl CstNode {
    /// Produce an ANTLR4-style S-expression representation of this tree.
    /// Rule nodes become `(name child1 child2 ...)`, tokens become their text.
    /// Tokens with empty text (e.g. EOF) are omitted.
    pub fn to_string_tree(&self) -> String {
        let mut out = String::with_capacity(256);
        cst_to_string_tree_impl(&mut out, self);
        return out;
    }
}

fn cst_to_string_tree_impl(out: &mut String, node: &CstNode) {
    out.push_str(&`({node.name}`);
    for let child of &node.children {
        if let Token(i) = *child {
            if !node.toks.is_empty_text(i) {
                out.push_str(&" ");
                node.toks.push_token_text(out, i);
            }
        } else if let Node(n) = *child {
            out.push_str(&" ");
            cst_to_string_tree_impl(out, &n);
        }
    }
    out.push_str(&")");
}

/// Visitor trait for walking typed CST nodes.
/// Default methods are no-ops; override to add behavior.
///
/// `rule_id` is the parser-rule's index in the grammar's parser_rules array
/// (0..n in declaration order). It's passed alongside `name` so visitors
/// that want cheap dispatch (HighlightVisitor's rule stack) can avoid
/// String compares while visitors that care about the name (TreeRecorder)
/// can still use it.
///
/// `visit_token` receives the `TokenStream` plus the terminal's `i32` index
/// (tokens are bare indices), so a visitor reads kind/text/span/trivia from
/// the stream on demand.
pub trait Visitor {
    fn enter_rule(&mut self, rule_id: i32, name: &String, span: &Span) {
    }
    fn exit_rule(&mut self, rule_id: i32, name: &String, span: &Span) {
    }
    fn visit_token(&mut self, toks: &TokenStream, idx: i32) {
    }
}

/// TreeRecorder is a Visitor that records events for building a CstNode tree.
/// It holds the `TokenStream` so the built `CstNode`s can carry it.
pub struct TreeRecorder {
    events: List<TreeEvent>,
    toks: &TokenStream,
}

variant TreeEvent {
    Enter(TreeEnterInfo),
    Exit,
    VisitToken(i32),
}

struct TreeEnterInfo {
    name: String,
    span: Span,
}

impl TreeRecorder {
    pub fn new(toks: &TokenStream) -> TreeRecorder with stores[toks] {
        return TreeRecorder { events: [], toks };
    }

    pub fn build(&self) -> CstNode {
        let mut pos = 0;
        return tree_build_node(&self.events, self.toks, &mut pos);
    }
}

impl Visitor for TreeRecorder {
    fn enter_rule(&mut self, rule_id: i32, name: &String, span: &Span) {
        self.events.push(TreeEvent::Enter(TreeEnterInfo { name: *name, span: *span }));
    }

    fn exit_rule(&mut self, rule_id: i32, name: &String, span: &Span) {
        self.events.push(TreeEvent::Exit);
    }

    fn visit_token(&mut self, toks: &TokenStream, idx: i32) {
        self.events.push(TreeEvent::VisitToken(idx));
    }
}

fn tree_build_node(events: &List<TreeEvent>, toks: &TokenStream, pos: &mut i32) -> CstNode with stores[toks] {
    if let Enter(info) = events[*pos] {
        *pos += 1;
        let mut children: List<CstChild> = [];
        loop {
            if *pos >= events.len() {
                break;
            }
            let ev = events[*pos];
            if let Exit = ev {
                *pos += 1;
                break;
            }
            if let Enter(_) = ev {
                children.push(CstChild::Node(tree_build_node(events, toks, pos)));
            } else if let VisitToken(i) = ev {
                children.push(CstChild::Token(i));
                *pos += 1;
            }
        }
        return CstNode { name: info.name, span: info.span, children, toks };
    }
    panic("TreeRecorder: expected Enter event");
}
