#![allow(dead_code)]

use { Interner } from "./intern.wado";

internal struct LrFrame {
    internal rest: i32,
    internal min_prec: i32,
    internal follow: i64,
    internal cont: i64,
}

internal global LR_LOOP_REST: i32 = -1;

global mut LR_FRAMES: Interner<LrFrame> = Interner::<LrFrame>::new();

internal fn lr_frames_enter() -> Interner<LrFrame> {
    let outer = LR_FRAMES;
    LR_FRAMES = Interner::<LrFrame>::new();
    return outer;
}

internal fn lr_frames_leave(outer: Interner<LrFrame>) {
    LR_FRAMES = outer;
}

internal fn lr_loop_frame(min_prec: i32, follow: i64, cont: i64) -> i64 {
    return if cont == 0 { 0 } else { lr_frame(LR_LOOP_REST, min_prec, follow, cont) };
}

internal fn lr_frame(rest: i32, min_prec: i32, follow: i64, cont: i64) -> i64 {
    return (LR_FRAMES.intern(LrFrame { rest, min_prec, follow, cont }) + 1) as i64;
}

internal fn lr_frame_at(cont: i64) -> LrFrame {
    return LR_FRAMES.at((cont - 1) as i32);
}
