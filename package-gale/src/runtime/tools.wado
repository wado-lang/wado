use { TokenStream, line_starts, line_col_at, push_escaped, char_count } from "./lex.wado";

struct CharIndexCursor {
    byte: i32,
    char: i32,
}

impl CharIndexCursor {
    fn advance_to(&mut self, src: &StrSlice, byte: i32) -> i32 {
        if byte < self.byte {
            self.byte = 0;
            self.char = 0;
        }
        self.char += char_count(src, self.byte, byte);
        self.byte = byte;
        return self.char;
    }
}

pub fn to_lexer_string(tokens: &TokenStream, eof_kind: i32) -> String {
    let starts = line_starts(&tokens.src);
    let mut cursor = CharIndexCursor { byte: 0, char: 0 };
    let mut out = String::with_capacity(tokens.output.len() + tokens.len() * 32);
    out.push_str(&tokens.output);
    let mut index = 0;
    for let mut i = 0; i < tokens.len(); i += 1 {
        let lo = tokens.triv_lo[i];
        let hi = tokens.triv_hi[i];
        for let mut t = lo; t < hi; t += 1 {
            if tokens.triv_chans[t] != 0 {
                emit_lexer_token(
                    &mut out,
                    tokens,
                    tokens.triv_kinds[t],
                    tokens.triv_starts[t],
                    tokens.triv_ends[t],
                    tokens.triv_chans[t],
                    &starts,
                    &mut cursor,
                    index,
                    eof_kind,
                );
                index += 1;
            }
        }
        emit_lexer_token(
            &mut out,
            tokens,
            tokens.kinds[i],
            tokens.starts[i],
            tokens.ends[i],
            0,
            &starts,
            &mut cursor,
            index,
            eof_kind,
        );
        index += 1;
    }
    return out;
}

fn emit_lexer_token(
    out: &mut String,
    tokens: &TokenStream,
    kind: i32,
    start: i32,
    end: i32,
    channel: i32,
    starts: &List<i32>,
    cursor: &mut CharIndexCursor,
    index: i32,
    eof_kind: i32,
) {
    let is_eof = kind == eof_kind;
    let type_id = if is_eof { -1 } else { kind + 1 };
    let lc = line_col_at(&tokens.src, starts, start);
    let first = cursor.advance_to(&tokens.src, start);
    let stop = first + char_count(&tokens.src, start, end) - 1;
    out.push_str(`[@${index},${first}:${stop}='`);
    if is_eof {
        out.push_str("<EOF>");
    } else {
        push_escaped(out, &tokens.src, start, end);
    }
    out.push_str(`',<${type_id}>,`);
    if channel != 0 {
        out.push_str(`channel=${channel},`);
    }
    out.push_str(`${lc.0}:${lc.1}]\n`);
}
