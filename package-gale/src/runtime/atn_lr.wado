#![allow(dead_code)]

use {
    AtnSim,
    ATN_RULE_STOP,
    ATN_TR_EPSILON,
    ATN_TR_ATOM,
    ATN_TR_NOT_ATOM,
    ATN_TR_WILDCARD,
    ATN_TR_RULE,
    ATN_TR_PRECEDENCE,
} from "./atn.wado";
use { AtnPredictor, atn_invocation_prec, atn_predict_once } from "./atn_predict.wado";

global ATN_CONT_ANY: i32 = -1;
global ATN_CONT_NONE: i32 = -2;

internal fn atn_with_lr_tables(sim: AtnSim) -> AtnSim {
    let mut out = sim;
    let nrules = out.rule_start.len();
    for let mut r = 0; r < nrules; r += 1 {
        out.rule_nullable.push(false);
        out.rule_first.push([]);
        out.rule_first_neg.push([]);
        out.rule_first_open.push(false);
    }
    if out.tr_kind.contains(&ATN_TR_PRECEDENCE) {
        let mut kinds = 0;
        for let mut j = 0; j < out.tr_kind.len(); j += 1 {
            if out.tr_kind[j] == ATN_TR_ATOM || out.tr_kind[j] == ATN_TR_NOT_ATOM {
                kinds = i32::max(kinds, out.tr_label[j] + 1);
            }
        }
        out.cont_kinds = kinds;
        out.cont_words = (kinds + 63) / 64;
        let mut walk = AtnContWalk {
            seen: List::filled(out.state_kind.len(), 0),
            stamp: 0,
            has: List::filled(kinds, false),
            first: [],
            neg: [],
        };
        atn_compute_first_nullable(&mut out, &mut walk);
        atn_compute_state_cont(&mut out, &mut walk);
        atn_compute_collapse(&mut out);
    }
    return out;
}

struct AtnContWalk {
    seen: List<i32>,
    stamp: i32,
    has: List<bool>,
    first: List<i32>,
    neg: List<i32>,
}

impl AtnContWalk {
    fn begin(&mut self) {
        self.stamp += 1;
        for let t of &self.first {
            self.has[*t] = false;
        }
        self.first.clear();
        self.neg.clear();
    }

    fn enters(&mut self, state: i32) -> bool {
        if self.seen[state] == self.stamp {
            return false;
        }
        self.seen[state] = self.stamp;
        return true;
    }

    fn add_first(&mut self, t: i32) {
        if !self.has[t] {
            self.has[t] = true;
            self.first.push(t);
        }
    }

    fn add_neg(&mut self, t: i32) {
        if !self.neg.contains(&t) {
            self.neg.push(t);
        }
    }
}

fn atn_compute_collapse(sim: &mut AtnSim) {
    let nstates = sim.state_kind.len();
    sim.state_collapse_target = List::filled(nstates, false);
    for let mut st = 0; st < nstates; st += 1 {
        let entry = atn_lr_entry_reached(sim, st);
        sim.state_collapse_to.push(entry);
        if entry >= 0 {
            sim.state_collapse_target[entry] = true;
        }
    }
}

fn atn_lr_entry_reached(sim: &AtnSim, from: i32) -> i32 {
    let mut st = from;
    for let mut steps = 0; steps < 8; steps += 1 {
        let s = sim.state_tr_start[st];
        let c = sim.state_tr_count[st];
        for let mut j = 0; j < c; j += 1 {
            if sim.tr_kind[s + j] == ATN_TR_PRECEDENCE {
                return if steps > 0 { st } else { -1 };
            }
        }
        if c != 1 || sim.tr_kind[s] != ATN_TR_EPSILON {
            return -1;
        }
        st = sim.tr_target[s];
    }
    return -1;
}

fn atn_compute_state_cont(sim: &mut AtnSim, walk: &mut AtnContWalk) {
    let nstates = sim.state_kind.len();
    let mut entered_from = List::<i32>::filled(nstates, -1);
    for let mut st = 0; st < nstates; st += 1 {
        let s = sim.state_tr_start[st];
        for let mut j = s; j < s + sim.state_tr_count[st]; j += 1 {
            if sim.tr_kind[j] == ATN_TR_PRECEDENCE {
                entered_from[sim.tr_target[j]] = st;
            }
        }
    }
    for let mut st = 0; st < nstates; st += 1 {
        walk.begin();
        let nullable = atn_cont_nullable(sim, st, walk);
        walk.begin();
        if entered_from[st] >= 0 {
            let _ = walk.enters(entered_from[st]);
        }
        let open = atn_cont_first(sim, st, walk);
        sim.state_cont_nullable.push(nullable);
        atn_push_cont_admits(sim, &walk.first, &walk.neg, open);
    }
}

fn atn_push_cont_admits(sim: &mut AtnSim, first: &List<i32>, neg: &List<i32>, open: bool) {
    let row = sim.state_cont_first.len();
    for let mut w = 0; w < sim.cont_words; w += 1 {
        sim.state_cont_first.push(0);
    }
    for let t of first {
        sim.state_cont_first[row + *t / 64] |= 1 as i64 << (*t % 64) as i64;
    }
    let any_but = if open || neg.iter_ref().any(|x| *x != neg[0]) {
        ATN_CONT_ANY;
    } else if neg.is_empty() {
        ATN_CONT_NONE;
    } else {
        neg[0];
    };
    sim.state_cont_any_but.push(any_but);
}

fn atn_compute_first_nullable(sim: &mut AtnSim, walk: &mut AtnContWalk) {
    let nrules = sim.rule_start.len();
    let mut changed = true;
    while changed {
        changed = false;
        for let mut r = 0; r < nrules; r += 1 {
            walk.begin();
            if atn_cont_nullable(sim, sim.rule_start[r], walk) && !sim.rule_nullable[r] {
                sim.rule_nullable[r] = true;
                changed = true;
            }
            walk.begin();
            if atn_cont_first(sim, sim.rule_start[r], walk) && !sim.rule_first_open[r] {
                sim.rule_first_open[r] = true;
                changed = true;
            }
            assert walk.first.len() >= sim.rule_first[r].len() && walk.neg.len() >= sim.rule_first_neg[r].len(), "a rule's first set only grows as its callees' do";
            if walk.first.len() > sim.rule_first[r].len() || walk.neg.len() > sim.rule_first_neg[r].len() {
                sim.rule_first[r] = walk.first;
                sim.rule_first_neg[r] = walk.neg;
                changed = true;
            }
        }
    }
}

fn atn_cont_nullable(sim: &AtnSim, state: i32, walk: &mut AtnContWalk) -> bool {
    if !walk.enters(state) {
        return false;
    }
    if sim.state_kind[state] == ATN_RULE_STOP {
        return true;
    }
    let s = sim.state_tr_start[state];
    let c = sim.state_tr_count[state];
    for let mut j = 0; j < c; j += 1 {
        let k = sim.tr_kind[s + j];
        if k == ATN_TR_EPSILON || k == ATN_TR_PRECEDENCE {
            if atn_cont_nullable(sim, sim.tr_target[s + j], walk) {
                return true;
            }
        } else if k == ATN_TR_RULE {
            let callee = sim.tr_label[s + j];
            if callee >= 0 && sim.rule_nullable[callee] && atn_cont_nullable(sim, sim.tr_follow[s + j], walk) {
                return true;
            }
        }
    }
    return false;
}

fn atn_cont_first(sim: &AtnSim, state: i32, walk: &mut AtnContWalk) -> bool {
    if !walk.enters(state) {
        return false;
    }
    if sim.state_kind[state] == ATN_RULE_STOP {
        return false;
    }
    let mut open = false;
    let s = sim.state_tr_start[state];
    let c = sim.state_tr_count[state];
    for let mut j = 0; j < c; j += 1 {
        let k = sim.tr_kind[s + j];
        if k == ATN_TR_ATOM {
            walk.add_first(sim.tr_label[s + j]);
        } else if k == ATN_TR_WILDCARD {
            open = true;
        } else if k == ATN_TR_NOT_ATOM {
            walk.add_neg(sim.tr_label[s + j]);
        } else if k == ATN_TR_EPSILON || k == ATN_TR_PRECEDENCE {
            if atn_cont_first(sim, sim.tr_target[s + j], walk) {
                open = true;
            }
        } else if k == ATN_TR_RULE {
            let callee = sim.tr_label[s + j];
            if callee >= 0 {
                for let t of &sim.rule_first[callee] {
                    walk.add_first(*t);
                }
                for let x of &sim.rule_first_neg[callee] {
                    walk.add_neg(*x);
                }
                if sim.rule_first_open[callee] {
                    open = true;
                }
                if sim.rule_nullable[callee] && atn_cont_first(sim, sim.tr_follow[s + j], walk) {
                    open = true;
                }
            }
        }
    }
    return open;
}

internal fn atn_state_cont_admits(sim: &AtnSim, state: i32, t: i32, eof: i32) -> bool {
    let any_but = sim.state_cont_any_but[state];
    if t != eof && (any_but == ATN_CONT_ANY || any_but >= 0 && t != any_but) {
        return true;
    }
    return t < sim.cont_kinds && sim.state_cont_first[state * sim.cont_words + t / 64] >> (t % 64) as i64 & 1 != 0;
}

internal fn atn_lr_loop_decision(
    sim: &AtnSim,
    atn: &mut AtnPredictor,
    decision: i32,
    tokens: &Array<i32>,
    pos: i32,
    eof: i32,
    min_prec: i32 = 0,
) -> i32 {
    let dstate = sim.decision_state[decision];
    let t = if pos < tokens.len() { tokens[pos] } else { eof };
    let s = sim.state_tr_start[dstate];
    let c = sim.state_tr_count[dstate];
    let exit_alt = c - 1;
    let mut enter = -1;
    let mut contested = false;
    for let mut j = 0; j < c; j += 1 {
        if sim.tr_kind[s + j] == ATN_TR_PRECEDENCE
            && sim.tr_prec[s + j] >= min_prec
            && atn_state_cont_admits(sim, sim.tr_target[s + j], t, eof) {
            if enter >= 0 {
                contested = true;
                break;
            }
            enter = j;
        }
    }
    if enter < 0 {
        return exit_alt;
    }
    if !contested && !atn_caller_contests(sim, atn, dstate, t, eof, min_prec) {
        return enter;
    }
    return atn_lr_predict(sim, atn, decision, tokens, pos, t, eof, min_prec);
}

internal fn atn_lr_enter_or_ask(
    sim: &AtnSim,
    atn: &mut AtnPredictor,
    decision: i32,
    enter: i32,
    tokens: &Array<i32>,
    pos: i32,
    eof: i32,
    min_prec: i32,
) -> i32 {
    let t = if pos < tokens.len() { tokens[pos] } else { eof };
    if !atn_caller_contests(sim, atn, sim.decision_state[decision], t, eof, min_prec) {
        return enter;
    }
    return atn_lr_predict(sim, atn, decision, tokens, pos, t, eof, min_prec);
}

fn atn_lr_predict(
    sim: &AtnSim,
    atn: &mut AtnPredictor,
    decision: i32,
    tokens: &Array<i32>,
    pos: i32,
    t: i32,
    eof: i32,
    min_prec: i32,
) -> i32 {
    let alt = atn_predict_once(sim, decision, atn, tokens, pos, eof, min_prec);
    if alt == sim.state_tr_count[sim.decision_state[decision]] - 1 {
        atn_record_callers_exit(sim, atn, decision, pos, min_prec, t, eof);
    }
    return alt;
}

fn atn_record_callers_exit(
    sim: &AtnSim,
    atn: &mut AtnPredictor,
    decision: i32,
    pos: i32,
    min_prec: i32,
    t: i32,
    eof: i32,
) {
    let dstate = sim.decision_state[decision];
    let exit_alt = sim.state_tr_count[dstate] - 1;
    let mut mp = min_prec;
    for let mut k = atn.stack.len() - 1; k >= 1; k -= 1 {
        let ret = atn.stack[k];
        atn.read_down_to(k);
        if ret < 0 || sim.state_collapse_to[ret] != dstate {
            return;
        }
        let caller_mp = atn_invocation_prec(sim, &atn.stack, k - 1);
        atn.read_down_to(k - 1);
        if atn_caller_alone_enters(sim, dstate, t, eof, caller_mp, mp) {
            return;
        }
        atn.record_verdict(decision, pos, caller_mp, k, exit_alt, 0);
        mp = caller_mp;
    }
}

fn atn_caller_alone_enters(sim: &AtnSim, dstate: i32, t: i32, eof: i32, caller_mp: i32, mp: i32) -> bool {
    let s = sim.state_tr_start[dstate];
    for let mut j = s; j < s + sim.state_tr_count[dstate]; j += 1 {
        if sim.tr_kind[j] == ATN_TR_PRECEDENCE
            && sim.tr_prec[j] >= caller_mp
            && sim.tr_prec[j] < mp
            && atn_state_cont_admits(sim, sim.tr_target[j], t, eof) {
            return true;
        }
    }
    return false;
}

fn atn_caller_contests(sim: &AtnSim, atn: &mut AtnPredictor, dstate: i32, t: i32, eof: i32, min_prec: i32) -> bool {
    let [contests, lowest_read] = atn_callers_contest(sim, &atn.stack, dstate, t, eof, min_prec);
    atn.read_down_to(lowest_read);
    return contests;
}

fn atn_callers_contest(
    sim: &AtnSim,
    rule_stack: &List<i32>,
    dstate: i32,
    t: i32,
    eof: i32,
    min_prec: i32,
) -> [bool, i32] {
    let mut mp = min_prec;
    let mut same_loop = true;
    let mut i = rule_stack.len() - 1;
    while i >= 0 {
        let ret = rule_stack[i];
        if ret < 0 {
            return [i == 0 && t == eof, i];
        }
        same_loop = same_loop && i >= 1 && sim.state_collapse_to[ret] == dstate;
        if same_loop {
            let caller_mp = atn_invocation_prec(sim, rule_stack, i - 1);
            if atn_caller_alone_enters(sim, dstate, t, eof, caller_mp, mp) {
                return [true, i - 1];
            }
            mp = caller_mp;
        } else if atn_state_cont_admits(sim, ret, t, eof) {
            return [true, i];
        }
        if !sim.state_cont_nullable[ret] {
            return [false, i];
        }
        i -= 1;
    }
    return [false, 0];
}
