use {
    AtnSim,
    ATN_RULE_STOP,
    ATN_TR_EPSILON,
    ATN_TR_ATOM,
    ATN_TR_NOT_ATOM,
    ATN_TR_WILDCARD,
    ATN_TR_RULE,
    ATN_TR_PRECEDENCE,
} from "./atn.wado";
use { AtnState, atn_predict_once } from "./atn_predict.wado";

pub fn atn_with_lr_tables(sim: AtnSim) -> AtnSim {
    let mut out = sim;
    let nrules = out.rule_start.len();
    for let mut r = 0; r < nrules; r += 1 {
        out.rule_nullable.push(false);
        out.rule_first.push([]);
        out.rule_first_neg.push([]);
        out.rule_first_open.push(false);
    }
    if out.tr_kind.contains(&ATN_TR_PRECEDENCE) {
        atn_compute_first_nullable(&mut out);
        atn_compute_state_cont(&mut out);
        atn_compute_collapse(&mut out);
        atn_compute_call_prec(&mut out);
    }
    return out;
}

fn atn_compute_collapse(sim: &mut AtnSim) {
    let nstates = sim.state_kind.len();
    for let mut st = 0; st < nstates; st += 1 {
        sim.state_collapse_to.push(atn_lr_entry_reached(sim, st));
    }
}

fn atn_compute_call_prec(sim: &mut AtnSim) {
    sim.state_call_prec = List::filled(sim.state_kind.len(), 0);
    for let mut j = 0; j < sim.tr_kind.len(); j += 1 {
        if sim.tr_kind[j] == ATN_TR_RULE {
            assert sim.tr_follow[j] >= 0, "a rule transition returns to a follow state";
            sim.state_call_prec[sim.tr_follow[j]] = sim.tr_prec[j];
        }
    }
}

fn atn_lr_entry_reached(sim: &AtnSim, from: i32) -> i32 {
    let mut st = from;
    for let mut steps = 0; steps < 8; steps += 1 {
        let s = sim.state_tr_start[st];
        let c = sim.state_tr_count[st];
        for let mut j = 0; j < c; j += 1 {
            if sim.tr_kind[s + j] == ATN_TR_PRECEDENCE {
                return if steps > 0 { st } else { -1 };
            }
        }
        if c != 1 || sim.tr_kind[s] != ATN_TR_EPSILON {
            return -1;
        }
        st = sim.tr_target[s];
    }
    return -1;
}

fn atn_compute_state_cont(sim: &mut AtnSim) {
    let nstates = sim.state_kind.len();
    for let mut st = 0; st < nstates; st += 1 {
        let mut v1: List<i32> = [];
        let nullable = atn_cont_nullable(sim, st, &mut v1);
        let mut v2: List<i32> = [];
        let mut f: List<i32> = [];
        let mut fneg: List<i32> = [];
        let open = atn_cont_first(sim, st, &mut v2, &mut f, &mut fneg);
        sim.state_cont_nullable.push(nullable);
        sim.state_cont_first_start.push(sim.cont_first_label.len());
        sim.state_cont_first_count.push(f.len());
        for let t of &f {
            sim.cont_first_label.push(*t);
        }
        sim.state_cont_neg_start.push(sim.cont_neg_label.len());
        sim.state_cont_neg_count.push(fneg.len());
        for let x of &fneg {
            sim.cont_neg_label.push(*x);
        }
        sim.state_cont_first_open.push(open);
    }
}

fn atn_compute_first_nullable(sim: &mut AtnSim) {
    let nrules = sim.rule_start.len();
    let mut changed = true;
    while changed {
        changed = false;
        for let mut r = 0; r < nrules; r += 1 {
            let mut v1: List<i32> = [];
            if atn_cont_nullable(sim, sim.rule_start[r], &mut v1) && !sim.rule_nullable[r] {
                sim.rule_nullable[r] = true;
                changed = true;
            }
            let mut v2: List<i32> = [];
            let mut f: List<i32> = [];
            let mut fneg: List<i32> = [];
            if atn_cont_first(sim, sim.rule_start[r], &mut v2, &mut f, &mut fneg) && !sim.rule_first_open[r] {
                sim.rule_first_open[r] = true;
                changed = true;
            }
            for let t of &f {
                if !sim.rule_first[r].contains(t) {
                    sim.rule_first[r].push(*t);
                    changed = true;
                }
            }
            for let x of &fneg {
                if !sim.rule_first_neg[r].contains(x) {
                    sim.rule_first_neg[r].push(*x);
                    changed = true;
                }
            }
        }
    }
}

fn atn_cont_nullable(sim: &AtnSim, state: i32, visited: &mut List<i32>) -> bool {
    if visited.contains(&state) {
        return false;
    }
    visited.push(state);
    if sim.state_kind[state] == ATN_RULE_STOP {
        return true;
    }
    let s = sim.state_tr_start[state];
    let c = sim.state_tr_count[state];
    for let mut j = 0; j < c; j += 1 {
        let k = sim.tr_kind[s + j];
        if k == ATN_TR_EPSILON || k == ATN_TR_PRECEDENCE {
            if atn_cont_nullable(sim, sim.tr_target[s + j], visited) {
                return true;
            }
        } else if k == ATN_TR_RULE {
            let callee = sim.tr_label[s + j];
            if callee >= 0 && sim.rule_nullable[callee] && atn_cont_nullable(sim, sim.tr_follow[s + j], visited) {
                return true;
            }
        }
    }
    return false;
}

fn atn_cont_first(sim: &AtnSim, state: i32, visited: &mut List<i32>, out: &mut List<i32>, neg: &mut List<i32>) -> bool {
    if visited.contains(&state) {
        return false;
    }
    visited.push(state);
    if sim.state_kind[state] == ATN_RULE_STOP {
        return false;
    }
    let mut open = false;
    let s = sim.state_tr_start[state];
    let c = sim.state_tr_count[state];
    for let mut j = 0; j < c; j += 1 {
        let k = sim.tr_kind[s + j];
        if k == ATN_TR_ATOM {
            if !out.contains(&sim.tr_label[s + j]) {
                out.push(sim.tr_label[s + j]);
            }
        } else if k == ATN_TR_WILDCARD {
            open = true;
        } else if k == ATN_TR_NOT_ATOM {
            if !neg.contains(&sim.tr_label[s + j]) {
                neg.push(sim.tr_label[s + j]);
            }
        } else if k == ATN_TR_EPSILON || k == ATN_TR_PRECEDENCE {
            if atn_cont_first(sim, sim.tr_target[s + j], visited, out, neg) {
                open = true;
            }
        } else if k == ATN_TR_RULE {
            let callee = sim.tr_label[s + j];
            if callee >= 0 {
                for let t of &sim.rule_first[callee] {
                    if !out.contains(t) {
                        out.push(*t);
                    }
                }
                for let x of &sim.rule_first_neg[callee] {
                    if !neg.contains(x) {
                        neg.push(*x);
                    }
                }
                if sim.rule_first_open[callee] {
                    open = true;
                }
                if sim.rule_nullable[callee] && atn_cont_first(sim, sim.tr_follow[s + j], visited, out, neg) {
                    open = true;
                }
            }
        }
    }
    return open;
}

fn atn_state_cont_admits(sim: &AtnSim, state: i32, t: i32, eof: i32) -> bool {
    if sim.state_cont_first_open[state] && t != eof {
        return true;
    }
    let fs = sim.state_cont_first_start[state];
    let fc = sim.state_cont_first_count[state];
    for let mut j = 0; j < fc; j += 1 {
        if sim.cont_first_label[fs + j] == t {
            return true;
        }
    }
    if t != eof {
        let ns = sim.state_cont_neg_start[state];
        let nc = sim.state_cont_neg_count[state];
        for let mut j = 0; j < nc; j += 1 {
            if sim.cont_neg_label[ns + j] != t {
                return true;
            }
        }
    }
    return false;
}

pub fn atn_lr_loop_decision(
    sim: &AtnSim,
    atn: &mut AtnState,
    decision: i32,
    tokens: &Array<i32>,
    pos: i32,
    eof: i32,
    min_prec: i32 = 0,
) -> i32 {
    let dstate = sim.decision_state[decision];
    let t = if pos < tokens.len() { tokens[pos] } else { eof };
    let s = sim.state_tr_start[dstate];
    let c = sim.state_tr_count[dstate];
    let exit_alt = c - 1;
    let mut enter = -1;
    for let mut j = 0; j < c; j += 1 {
        if sim.tr_kind[s + j] == ATN_TR_PRECEDENCE
            && sim.tr_prec[s + j] >= min_prec
            && atn_state_cont_admits(sim, sim.tr_target[s + j], t, eof) {
            enter = j;
            break;
        }
    }
    if enter < 0 {
        return exit_alt;
    }
    if !atn_caller_mandates(sim, &atn.stack, t, eof) {
        return enter;
    }
    return atn_predict_once(sim, decision, atn, tokens, pos, eof, min_prec);
}

fn atn_caller_mandates(sim: &AtnSim, rule_stack: &List<i32>, t: i32, eof: i32) -> bool {
    let mut i = rule_stack.len() - 1;
    while i >= 0 {
        let ret = rule_stack[i];
        if ret < 0 {
            return i == 0 && t == eof;
        }
        if sim.state_cont_nullable[ret] {
            i -= 1;
            continue;
        }
        return atn_state_cont_admits(sim, ret, t, eof);
    }
    return false;
}
