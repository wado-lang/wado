use { TokenStream } from "./lex.wado";
use { CstStore, EventTag, K_ERROR } from "./tree.wado";
use { HighlightVisitor } from "./highlight.wado";

pub fn highlight_walk(visitor: &mut HighlightVisitor, toks: &TokenStream, s: &CstStore) {
    for let mut r = 0; r < s.row_count(); r += 1 {
        match s.tag[r] {
            Open => {
                if s.kind(r) as i32 != K_ERROR as i32 {
                    visitor.hl_enter(s.kind(r) as i32);
                }
            },
            Close => {
                if s.close_kind(r) as i32 != K_ERROR as i32 {
                    visitor.hl_exit();
                }
            },
            _ => visitor.hl_visit_token(toks, s.token_index(r)),
        }
    }
}
