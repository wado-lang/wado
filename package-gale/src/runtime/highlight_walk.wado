//! Highlight walk. A single generic pass over the flat CST store: enter each
//! rule on its `E_OPEN`, classify each terminal (`hl_visit_token`), exit on the
//! matching `E_CLOSE`. Because the store is uniform there is one walk regardless
//! of grammar, and it works on a *partial* tree too (broken input still
//! highlights). A `K_ERROR` recovery region contributes no rule context. The
//! walk is a flat forward scan threading `&CstStore` — it constructs no node or
//! cursor value, so it allocates nothing.

use { TokenStream } from "./lex.wado";
use { CstStore, E_OPEN, E_CLOSE, K_ERROR } from "./tree.wado";
use { HighlightVisitor } from "./highlight.wado";

pub fn highlight_walk(visitor: &mut HighlightVisitor, toks: &TokenStream, s: &CstStore) {
    for let mut r = 0; r < s.row_count(); r += 1 {
        let t = s.tag[r];
        if t == E_OPEN {
            if s.a[r] != K_ERROR as i32 {
                visitor.hl_enter(s.a[r]);
            }
        } else if t == E_CLOSE {
            if s.b[r] != K_ERROR as i32 {  // b stamped with the open's kind in finalize
                visitor.hl_exit();
            }
        } else {  // E_TOK / E_MISS / E_SKIP
            visitor.hl_visit_token(toks, s.a[r]);
        }
    }
}
