pub global ATN_BASIC: i32 = 1;
pub global ATN_RULE_START: i32 = 2;
pub global ATN_RULE_STOP: i32 = 3;
pub global ATN_BLOCK_START: i32 = 4;
pub global ATN_BLOCK_END: i32 = 5;
pub global ATN_STAR_LOOP_ENTRY: i32 = 6;
pub global ATN_STAR_LOOP_BACK: i32 = 7;
pub global ATN_PLUS_LOOP_BACK: i32 = 8;
pub global ATN_LOOP_END: i32 = 9;

pub global ATN_TR_EPSILON: i32 = 0;
pub global ATN_TR_ATOM: i32 = 1;
pub global ATN_TR_NOT_ATOM: i32 = 2;
pub global ATN_TR_WILDCARD: i32 = 3;
pub global ATN_TR_RULE: i32 = 4;
pub global ATN_TR_PRECEDENCE: i32 = 5;

pub struct AtnSim {
    pub state_kind: List<i32>,
    pub state_tr_start: List<i32>,
    pub state_tr_count: List<i32>,
    pub tr_kind: List<i32>,
    pub tr_target: List<i32>,
    pub tr_label: List<i32>,
    pub tr_follow: List<i32>,
    pub tr_prec: List<i32>,
    pub decision_state: List<i32>,
    pub rule_start: List<i32>,
    pub rule_nullable: List<bool> = [],
    pub rule_first: List<List<i32>> = [],
    pub rule_first_neg: List<List<i32>> = [],
    pub rule_first_open: List<bool> = [],
    pub state_cont_nullable: List<bool> = [],
    pub state_cont_first_start: List<i32> = [],
    pub state_cont_first_count: List<i32> = [],
    pub state_cont_neg_start: List<i32> = [],
    pub state_cont_neg_count: List<i32> = [],
    pub cont_first_label: List<i32> = [],
    pub cont_neg_label: List<i32> = [],
    pub state_cont_first_open: List<bool> = [],
}

fn atn_read_u8(bytes: &ByteList, pos: i32) -> i32 {
    return bytes.get_byte_unchecked(pos) as i32;
}

fn atn_read_u16(bytes: &ByteList, pos: i32) -> i32 {
    let b0 = bytes.get_byte_unchecked(pos) as i32;
    let b1 = bytes.get_byte_unchecked(pos + 1) as i32;
    return b0 | b1 << 8;
}

fn atn_read_u24(bytes: &ByteList, pos: i32) -> i32 {
    let b0 = bytes.get_byte_unchecked(pos) as i32;
    let b1 = bytes.get_byte_unchecked(pos + 1) as i32;
    let b2 = bytes.get_byte_unchecked(pos + 2) as i32;
    return b0 | b1 << 8 | b2 << 16;
}

pub fn atn_decode(bytes: &ByteList) -> AtnSim {
    let mut p = 0;
    let nrules = atn_read_u16(bytes, p);
    p += 2;
    let ndec = atn_read_u16(bytes, p);
    p += 2;
    let nstates = atn_read_u16(bytes, p);
    p += 2;

    let mut rule_start: List<i32> = List::with_capacity(nrules);
    for let mut i = 0; i < nrules; i += 1 {
        rule_start.push(atn_read_u16(bytes, p));
        p += 2;
    }
    let mut decision_state: List<i32> = List::with_capacity(ndec);
    for let mut i = 0; i < ndec; i += 1 {
        decision_state.push(atn_read_u16(bytes, p));
        p += 2;
    }

    let mut state_kind: List<i32> = List::with_capacity(nstates);
    for let mut i = 0; i < nstates; i += 1 {
        state_kind.push(atn_read_u8(bytes, p));
        p += 1;
    }
    let mut state_tr_start: List<i32> = List::with_capacity(nstates);
    let mut state_tr_count: List<i32> = List::with_capacity(nstates);
    let mut ntrans_total = 0;
    for let mut i = 0; i < nstates; i += 1 {
        let count = atn_read_u16(bytes, p);
        p += 2;
        state_tr_start.push(ntrans_total);
        state_tr_count.push(count);
        ntrans_total += count;
    }

    let mut tr_kind: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_kind.push(atn_read_u8(bytes, p));
        p += 1;
    }
    let mut tr_target: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_target.push(atn_read_u16(bytes, p) - 1);
        p += 2;
    }
    let mut tr_label: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_label.push(atn_read_u24(bytes, p) - 1);
        p += 3;
    }
    let mut tr_follow: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_follow.push(atn_read_u24(bytes, p) - 1);
        p += 3;
    }
    let mut tr_prec: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_prec.push(atn_read_u16(bytes, p));
        p += 2;
    }

    return AtnSim {
        state_kind,
        state_tr_start,
        state_tr_count,
        tr_kind,
        tr_target,
        tr_label,
        tr_follow,
        tr_prec,
        decision_state,
        rule_start,
    };
}
