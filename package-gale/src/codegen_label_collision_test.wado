// Regression: `e : a=e op=('+'|'-') b=e ;` — the labelled element's inner
// used a fresh `name_counts`, so both labels emitted one shared binding and
// the generated parser failed to compile on the redeclaration.

use { generate, GenerateOptions } from "./codegen.wado";
use { parse_checked } from "./g4/parser.wado";

test "label binding on repeated rule ref dedups against outer scope" {
    // Grammar shape from antlr4 runtime-testsuite descriptors
    // (LeftRecursion/MultipleActions_1) — three alts, action blocks
    // present, multi-alt path triggers the `parse_X_alt_*` backtrack
    // helpers where the bug originally reproduced.
    // A grammar with no action emits no label binding, so nothing to check.
    let g4 = "grammar T;
e : a=e op=('*'|'/') b=e { }
  | INT
  | '(' x=e ')'
  ;
INT : '0'..'9'+ ;
WS : (' '|'\\n') -> skip ;
";
    let mut grammar = match parse_checked(g4) {
        Ok(g) => g,
        Err(e) => panic(`parse_checked failed: ${e.message}`),
    };
    let out = generate(&mut grammar, &GenerateOptions {}).source;
    let labels: List<String> = ["a", "b", "x"];
    for let label of &labels {
        let needle = `let ${*label} = _parse_e(p`;
        assert_declared_once_per_fn(&out, &needle);
    }
    // `a=e` is the LR left operand, which the precedence loop carries rather
    // than binding. Pin `x=e`, so the check above cannot pass vacuously.
    assert out.find("let x = _parse_e(p") matches { Some(_) }, "no labelled binding emitted; the duplicate check would pass vacuously";
}

test "an element whose name is the recognizer handle does not shadow it" {
    // `P` snake_cases to `p`, the parser handle every emitted call reads. Binding
    // it verbatim shadowed the handle with an `i32`, so the next `p.` call in the
    // alternative no longer compiled.
    let g4 = "grammar T;
r : P { p.emit(\"x\") } ;
P : 'p' ;
WS : ' ' -> skip ;
";
    let mut grammar = match parse_checked(g4) {
        Ok(g) => g,
        Err(e) => panic(`parse_checked failed: ${e.message}`),
    };
    let out = generate(&mut grammar, &GenerateOptions {}).source;
    // The positive half: without it the negative assertion also passes on output
    // that binds nothing at all.
    assert out.contains("let p_ = p.expect(TK_P"), `the escaped binding must be emitted: ${out}`;
    assert !out.contains("let p = p."), `the handle must not be shadowed: ${out}`;
}

test "an element named after any generated parse-fn local does not shadow it" {
    // The handle is one of a set: the parse fn's parameters and the locals its
    // body opens. `KIND` is the multi-alt dispatch's lookahead, which lands in
    // the very function the binding does — the shape the handle collision had.
    let g4 = "grammar T;
r : KIND VALS { p.emit($KIND.text) } | VALS ;
KIND : 'k' ;
VALS : 'v' ;
WS : ' ' -> skip ;
";
    let mut grammar = match parse_checked(g4) {
        Ok(g) => g,
        Err(e) => panic(`parse_checked failed: ${e.message}`),
    };
    let out = generate(&mut grammar, &GenerateOptions {}).source;
    assert out.contains("let kind = p.peek_kind();"), "the dispatch still reads the lookahead";
    assert !out.contains("let kind = p.expect("), `the lookahead must not be shadowed: ${out}`;
    assert !out.contains("let vals = p.expect("), `the value channel must not be shadowed: ${out}`;
}

/// Fail if `decl` appears twice before the next `\nfn ` boundary.
fn assert_declared_once_per_fn(out: &String, decl: &String) {
    let mut pos = 0;
    loop {
        let rest = out.substr_bytes(pos, out.len());
        let opt_i = rest.find(*decl);
        if opt_i matches { None } {
            break;
        }
        let i = if let Some(j) = opt_i {
            j;
        } else {
            0;
        };
        let abs = pos + i;
        let after = out.substr_bytes(abs + decl.len(), out.len());
        let next_fn = if let Some(j) = after.find("\nfn ") {
            j;
        } else {
            after.len();
        };
        let next_decl = if let Some(j) = after.find(*decl) {
            j;
        } else {
            after.len();
        };
        assert next_decl >= next_fn, `two '${*decl}' in the same function body — bug repro at offset ${abs}`;
        pos = abs + decl.len();
    }
}
