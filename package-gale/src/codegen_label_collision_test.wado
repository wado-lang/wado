// Regression: label-on-rule-ref where the same rule appears under two
// different labels in one alternative used to emit a duplicate
// `let <rule> = _parse_<rule>(p)?;` binding, failing compilation with
// "cannot redeclare X" once Stage B exercised the generated parser.
//
// Smallest grammar exhibiting the bug:
//   e : a=e op=('+'|'-') b=e ;
//
// The inner `gen_element` for the labeled element used a fresh
// name_counts, so the RuleRef binding `e` did not dedup against the
// outer alt's bindings. Both `a=e` and `b=e` emitted a top-level
// `let e = _parse_e(p)?;` — the second redeclared the first.

use { generate, GenerateOptions } from "./codegen.wado";
use { parse_checked } from "./g4/parser.wado";

test "label binding on repeated rule ref dedups against outer scope" {
    // Grammar shape from antlr4 runtime-testsuite descriptors
    // (LeftRecursion/MultipleActions_1) — three alts, action blocks
    // present, multi-alt path triggers the `parse_X_alt_*` backtrack
    // helpers where the bug originally reproduced.
    // The `{ }` action is what makes the labels observable: a grammar with
    // no action emits no `let <label> = …` binding for a leaf at all.
    let g4 = "grammar T;
e : a=e op=('*'|'/') b=e { }
  | INT
  | '(' x=e ')'
  ;
INT : '0'..'9'+ ;
WS : (' '|'\\n') -> skip ;
";
    let mut grammar = match parse_checked(g4) {
        Ok(g) => g,
        Err(e) => panic(`parse_checked failed: ${e.message}`),
    };
    let out = generate(&mut grammar, &GenerateOptions {}).source;
    // Emit binds a labelled element under the LABEL, so the alt `a=e … b=e`
    // produces `let a = …` / `let b = …`. The bug was the inner `e` binding
    // leaking into the alternative's scope under one shared name, i.e. the
    // same `let` line twice before the next `fn ` boundary. Check each label
    // the grammar declares; different functions each having their own copy is
    // fine.
    let labels: List<String> = ["a", "b", "x"];
    for let label of &labels {
        let needle = `let ${*label} = _parse_e(p`;
        assert_declared_once_per_fn(&out, &needle);
    }
    // `a=e` is the LR left operand, which the precedence loop carries rather
    // than binding; `x=e` inside the parenthesised alt is a plain call. Pin
    // that one, so a future emit that stops binding labels at all cannot make
    // the duplicate check above pass vacuously.
    assert out.find("let x = _parse_e(p") matches { Some(_) }, "no labelled binding emitted; the duplicate check would pass vacuously";
}

/// Fail if `decl` appears twice before the next `\nfn ` boundary.
fn assert_declared_once_per_fn(out: &String, decl: &String) {
    let mut pos = 0;
    loop {
        let rest = out.substr_bytes(pos, out.len());
        let opt_i = rest.find(*decl);
        if opt_i matches { None } {
            break;
        }
        let i = if let Some(j) = opt_i {
            j;
        } else {
            0;
        };
        let abs = pos + i;
        let after = out.substr_bytes(abs + decl.len(), out.len());
        let next_fn = if let Some(j) = after.find("\nfn ") {
            j;
        } else {
            after.len();
        };
        let next_decl = if let Some(j) = after.find(*decl) {
            j;
        } else {
            after.len();
        };
        assert next_decl >= next_fn, `two '${*decl}' in the same function body — bug repro at offset ${abs}`;
        pos = abs + decl.len();
    }
}
