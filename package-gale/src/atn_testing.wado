//! Test support for the ATN: builds one straight from a grammar. Codegen calls
//! `build_atn_with` instead, to reuse the `LoweredGrammar` it has already
//! computed.

use { Grammar } from "./ir.wado";
use { Atn, build_atn_with } from "./atn.wado";
use { lower } from "./lower.wado";
use { collect_literal_tokens } from "./lexer_gen.wado";
use { TokenKinds, resolve_kind_ids } from "./token_kinds.wado";
use { LowerContext } from "./lower_context.wado";
use { GrammarAnalysis } from "./grammar_analysis.wado";
use { GenSettings } from "./gen_settings.wado";

/// Build the whole-grammar parser ATN, stamping and lowering the grammar on
/// demand.
pub fn build_atn(grammar: &Grammar) -> Atn {
    let mut stamped = *grammar;
    let kinds = TokenKinds::build(&stamped);
    resolve_kind_ids(&mut stamped, &kinds);
    let num_tokens = kinds.len();
    let mut ctx = LowerContext::new(GrammarAnalysis::new(&stamped.parser_rules, kinds), GenSettings {});
    let lowered = lower(&stamped, &collect_literal_tokens(&stamped.parser_rules), &mut ctx);
    return build_atn_with(&stamped, &lowered, num_tokens);
}
