//! SuperClass — effect-interface synthesis for `options { superClass = Foo }`.
//!
//! ANTLR's `superClass` is object inheritance; Wado has none, so a base class
//! becomes a Wado effect interface: `this.<method>()` action / predicate calls
//! lower to ambient `Foo::<method>()` operations, the user provides an
//! `impl Foo for Base` handler and installs it with `with Foo => &mut base do`.
//! See `action.md`, "SuperClass — an effect interface".
//!
//! This module is the language-independent core: extract the base name, scan
//! action / predicate bodies for `this.<method>` call sites, synthesize the
//! effect interface, and rewrite each call site to `Foo::<method>()`. Threading
//! the `with Foo` effect onto the op-reachable generated fns lives in codegen.

use {
    Grammar,
    GrammarOption,
    OptionValue,
    ActionKind,
    AltAction,
    LexerRule,
    LexerAlternative,
    LexerElement,
    LexerRepeatElement,
    LexerNotElement,
} from "./ir.wado";
use { scan_string, scan_line_comment, scan_block_comment, is_id_start_char, is_id_continue_char } from "./g4/scan.wado";
use { CodeWriter } from "./wadopoet.wado";
use { to_snake_case } from "./ident.wado";

/// One synthesized effect operation, from a distinct `this.<method>` call site.
/// `is_predicate` distinguishes a `{...}?` predicate call from a `{...}` action.
/// `has_args` marks a call site that passes arguments: the rewrite drops them
/// and the interface has no type to declare them with, so a base carrying one
/// is refused rather than wired to a signature that loses an argument.
pub struct SuperOp {
    pub name: String,
    pub is_predicate: bool,
    pub has_args: bool,
    /// The same name reached from both a predicate and an action body: the two
    /// call forms differ, so one site would mismatch the operation's signature.
    pub mixed_role: bool = false,
}

/// One `this.<method>(...)` call site found in a body.
pub struct SuperCall {
    pub name: String,
    /// The call passes something — `this.m(2)`, not `this.m()`.
    pub has_args: bool,
}

/// The base name from `options { superClass = Foo }`, or `null` when the
/// grammar declares no `superClass`. A dotted `a.b.Base` keeps its last
/// component (the Wado effect name).
pub fn superclass_base_name(grammar: &Grammar) -> Option<String> {
    for let o of &grammar.options {
        if o.name == "superClass" {
            return Option::<String>::Some(option_value_name(&o.value));
        }
    }
    return null;
}

fn option_value_name(v: &OptionValue) -> String {
    return match v {
        Ident(s) => *s,
        Qualified(parts) => if parts.is_empty() { "" } else { parts[parts.len() - 1] },
        Str(s) => *s,
        _ => "",
    };
}

/// The `this.<method>(` call sites in a body, in source order, skipping string
/// literals and comments so host text never yields a false hit. Only the
/// `this.` receiver is a superClass call; a bare `m()` or `other.m()` is not.
pub fn find_this_calls(body: &String) -> List<SuperCall> {
    let chars: List<char> = body.chars().collect();
    let n = chars.len();
    let mut out: List<SuperCall> = [];
    let mut i = 0;
    while i < n {
        i = match chars[i] {
            '"' | '\'' => scan_string(&chars, i),
            '/' && i + 1 < n && chars[i + 1] == '/' => scan_line_comment(&chars, i),
            '/' && i + 1 < n && chars[i + 1] == '*' => scan_block_comment(&chars, i),
            _ => match this_call_at(&chars, i, n) {
                Some([name, close]) => {
                    out.push(SuperCall { name, has_args: call_has_args(&chars, i, close) });
                    close;
                },
                None => i + 1,
            },
        };
    }
    return out;
}

/// Whether the call spanning `[start, close)` passes anything between its
/// parentheses. Only the receiver and the method name precede the first `(`,
/// so that one opens the argument list.
fn call_has_args(chars: &List<char>, start: i32, close: i32) -> bool {
    let mut open = start;
    for let mut i = start; i < close; i += 1 {
        if chars[i] == '(' {
            open = i;
            break;
        }
    }
    for let mut i = open + 1; i + 1 < close; i += 1 {
        if !chars[i].is_ascii_whitespace() {
            return true;
        }
    }
    return false;
}

/// If a `this.<method>(` call starts at `i` (whitespace allowed between
/// tokens), returns `[method, close]`: the method name and the index just past
/// the matching `)`. Else `null`. Shared by op collection and the call-site
/// rewrite, so both agree on what a call is and where it ends.
fn this_call_at(chars: &List<char>, i: i32, n: i32) -> Option<[String, i32]> {
    return call_at(chars, i, n, &THIS_WORD, &DOT_SEP);
}

/// The rewritten form: `Foo::<method>(...)`. Recognizing it too keeps
/// `body_is_base_calls_only` answering the same across the rewrite.
fn base_call_at(chars: &List<char>, i: i32, n: i32, base: &List<char>) -> Option<[String, i32]> {
    return call_at(chars, i, n, base, &PATH_SEP);
}

global THIS_WORD: List<char> = ['t', 'h', 'i', 's'];
global DOT_SEP: List<char> = ['.'];
global PATH_SEP: List<char> = [':', ':'];

fn call_at(chars: &List<char>, i: i32, n: i32, receiver: &List<char>, sep: &List<char>) -> Option<[String, i32]> {
    if !word_at(chars, i, n, receiver) {
        return null;
    }
    let after = skip_ws(chars, i + receiver.len(), n);
    if !text_at(chars, after, n, sep) {
        return null;
    }
    let name_start = skip_ws(chars, after + sep.len(), n);
    let name_end = scan_ident(chars, name_start, n);
    if name_end == name_start {
        return null;
    }
    let paren = skip_ws(chars, name_end, n);
    if paren >= n || chars[paren] != '(' {
        return null;
    }
    let name = collect_range(chars, name_start, name_end);
    return Option::Some([name, match_paren(chars, paren, n)]);
}

/// Whether `word` sits at `i` as a whole word (not part of a longer ident).
fn word_at(chars: &List<char>, i: i32, n: i32, word: &List<char>) -> bool {
    if !text_at(chars, i, n, word) {
        return false;
    }
    if i > 0 && is_id_continue_char(chars[i - 1]) {
        return false;
    }
    let end = i + word.len();
    return !(end < n && is_id_continue_char(chars[end]));
}

fn text_at(chars: &List<char>, i: i32, n: i32, text: &List<char>) -> bool {
    if i < 0 || i + text.len() > n {
        return false;
    }
    for let mut k = 0; k < text.len(); k += 1 {
        if chars[i + k] != text[k] {
            return false;
        }
    }
    return true;
}

fn scan_ident(chars: &List<char>, start: i32, n: i32) -> i32 {
    if start >= n || !is_id_start_char(chars[start]) {
        return start;
    }
    let mut i = start + 1;
    while i < n && is_id_continue_char(chars[i]) {
        i += 1;
    }
    return i;
}

fn skip_ws(chars: &List<char>, start: i32, n: i32) -> i32 {
    let mut i = start;
    while i < n && chars[i].is_ascii_whitespace() {
        i += 1;
    }
    return i;
}

fn collect_range(chars: &List<char>, start: i32, end: i32) -> String {
    let mut s = String::with_capacity(if end > start { end - start } else { 0 });
    for let mut i = start; i < end; i += 1 {
        s.push(chars[i]);
    }
    return s;
}

/// Add a scanned call to the op set; the first occurrence of a name fixes its
/// role (predicate vs action). A later occurrence still contributes its
/// `has_args`: one call site passing arguments makes the operation
/// unrepresentable.
pub fn add_super_op(ops: &mut List<SuperOp>, call: &SuperCall, kind: &ActionKind) {
    let is_predicate = kind matches { Predicate };
    for let mut i = 0; i < ops.len(); i += 1 {
        if ops[i].name == call.name {
            ops[i].has_args = ops[i].has_args || call.has_args;
            ops[i].mixed_role = ops[i].mixed_role || ops[i].is_predicate != is_predicate;
            return;
        }
    }
    ops.push(SuperOp { name: call.name, is_predicate, has_args: call.has_args });
}

/// Operations called with arguments anywhere in the grammar. A base is wired
/// only when this is empty (`action.md`, "SuperClass — an effect interface").
pub fn super_ops_with_args(ops: &List<SuperOp>) -> List<String> {
    let mut out: List<String> = [];
    for let op of ops {
        if op.has_args {
            out.push(op.name);
        }
    }
    return out;
}

/// A base is wired only when this is empty.
pub fn super_ops_mixed_role(ops: &List<SuperOp>) -> List<String> {
    let mut out: List<String> = [];
    for let op of ops {
        if op.mixed_role {
            out.push(op.name);
        }
    }
    return out;
}

/// Collect the superClass operations across a grammar's lexer rules: every
/// distinct `this.<method>` call in an action / predicate body, in source
/// order, deduped by name (first role wins).
pub fn collect_lexer_super_ops(grammar: &Grammar) -> List<SuperOp> {
    let mut ops: List<SuperOp> = [];
    for let rule of &grammar.lexer_rules {
        for let alt of &rule.body {
            collect_lexer_alt_ops(alt, &mut ops);
        }
    }
    return ops;
}

/// Whether `body` is nothing but base-method calls and separators — the source
/// form `this.m(...)` or the `Foo::m(...)` the rewrite leaves behind. Such a
/// body is plain Wado once `rewrite_superclass_calls` has run, so it runs
/// without the host translator a `superClass` grammar carves out; one carrying
/// host code around the call needs that translator. Both forms are accepted so
/// the answer does not move across the rewrite.
pub fn body_is_base_calls_only(body: &String, base_name: &String) -> bool {
    let chars: List<char> = body.chars().collect();
    let base: List<char> = base_name.chars().collect();
    let n = chars.len();
    let mut i = 0;
    while i < n {
        if chars[i].is_ascii_whitespace() || chars[i] == ';' {
            i += 1;
            continue;
        }
        // A comment is not host code; the rewrite copies it through verbatim.
        if chars[i] == '/' && i + 1 < n && chars[i + 1] == '/' {
            i = scan_line_comment(&chars, i);
            continue;
        }
        if chars[i] == '/' && i + 1 < n && chars[i + 1] == '*' {
            i = scan_block_comment(&chars, i);
            continue;
        }
        if let Some([_, close]) = this_call_at(&chars, i, n) {
            i = close;
            continue;
        }
        if let Some([_, close]) = base_call_at(&chars, i, n, &base) {
            i = close;
            continue;
        }
        return false;
    }
    return true;
}

/// Whether every `{ ... }` action body in the grammar's lexer is
/// base-calls-only, which is what lets a `language = Java` `superClass`
/// grammar run its actions at all. All-or-nothing per grammar: one body
/// carrying host code leaves every lexer action unexecuted, each reported.
pub fn lexer_action_bodies_are_base_calls(grammar: &Grammar, base_name: &String) -> bool {
    for let rule of &grammar.lexer_rules {
        for let alt of &rule.body {
            if !alt_actions_are_base_calls(alt, base_name) {
                return false;
            }
        }
    }
    return true;
}

fn alt_actions_are_base_calls(alt: &LexerAlternative, base_name: &String) -> bool {
    for let a of &alt.actions {
        if a.kind matches { Action } && !body_is_base_calls_only(&a.source.text, base_name) {
            return false;
        }
    }
    return alt.elements.iter_ref().all(|e| elem_actions_are_base_calls(e, base_name));
}

fn elem_actions_are_base_calls(elem: &LexerElement, base_name: &String) -> bool {
    return match elem {
        Group(alts) => alts.iter_ref().all(|a| alt_actions_are_base_calls(a, base_name)),
        Repeat(rep) => elem_actions_are_base_calls(&rep.element, base_name),
        Not(nn) => elem_actions_are_base_calls(&nn.element, base_name),
        _ => true,
    };
}

/// Whether the grammar declares a `superClass` Gale refuses to wire, because an
/// operation is called with arguments. Nothing reaching the base can then be
/// emitted — not the interface, and not a body still naming `this`, which the
/// rewrite would have replaced — so the lexer's actions and predicates stay
/// unexecuted, each reported.
pub fn superclass_is_refused(grammar: &Grammar) -> bool {
    return match superclass_base_name(grammar) {
        Some(_) => {
            let ops = collect_lexer_super_ops(grammar);
            !super_ops_with_args(&ops).is_empty() || !super_ops_mixed_role(&ops).is_empty();
        },
        None => false,
    };
}

/// Whether a rule's match fn (transitively, through referenced fragments)
/// evaluates a `Foo::op(...)` and so must declare `with Foo`. A non-recursive
/// fragment is inlined into its caller and a recursive one is called from it, so
/// either way the caller carries the effect; `RuleRef`s are followed through
/// `all_rules`, and `visited` breaks cycles. Matched on the rewritten `Foo::`
/// form, since op collection rewrote the `this.` sites first. Only predicates
/// count: a match fn never emits an action, which runs from the replay.
pub fn lexer_rule_match_calls_super(rule: &LexerRule, all_rules: &List<LexerRule>, base_name: &String) -> bool {
    return rule_calls_super_with(rule, all_rules, base_name, false);
}

/// The same for a rule's `apply_<rule>_actions` replay, which also runs the
/// alternatives' actions.
pub fn lexer_rule_replay_calls_super(rule: &LexerRule, all_rules: &List<LexerRule>, base_name: &String) -> bool {
    return rule_calls_super_with(rule, all_rules, base_name, true);
}

fn rule_calls_super_with(rule: &LexerRule, all_rules: &List<LexerRule>, base_name: &String, actions: bool) -> bool {
    let needle = `${*base_name}::`;
    let mut visited: List<String> = [];
    return rule_calls_super(rule, all_rules, &needle, actions, &mut visited);
}

fn rule_calls_super(
    rule: &LexerRule,
    all_rules: &List<LexerRule>,
    needle: &String,
    actions: bool,
    visited: &mut List<String>,
) -> bool {
    if visited.iter_ref().any(|v: &String| *v == rule.name) {
        return false;
    }
    visited.push(rule.name);
    return rule.body.iter_ref().any(|alt| alt_calls_super(alt, all_rules, needle, actions, visited));
}

fn alt_calls_super(
    alt: &LexerAlternative,
    all_rules: &List<LexerRule>,
    needle: &String,
    actions: bool,
    visited: &mut List<String>,
) -> bool {
    for let a of &alt.actions {
        if !actions && a.kind matches { Action } {
            continue;
        }
        if a.source.text.contains(*needle) {
            return true;
        }
    }
    return alt.elements.iter_ref().any(|e| elem_calls_super(e, all_rules, needle, actions, visited));
}

fn elem_calls_super(
    elem: &LexerElement,
    all_rules: &List<LexerRule>,
    needle: &String,
    actions: bool,
    visited: &mut List<String>,
) -> bool {
    match elem {
        Group(alts) => {
            for let alt of alts {
                if alt_calls_super(alt, all_rules, needle, actions, visited) {
                    return true;
                }
            }
        },
        Repeat(rep) => {
            return elem_calls_super(&rep.element, all_rules, needle, actions, visited);
        },
        Not(n) => {
            return elem_calls_super(&n.element, all_rules, needle, actions, visited);
        },
        RuleRef(name) => {
            for let r of all_rules {
                if r.name == *name {
                    return rule_calls_super(r, all_rules, needle, actions, visited);
                }
            }
        },
        _ => {
        },
    }
    return false;
}

fn collect_lexer_alt_ops(alt: &LexerAlternative, ops: &mut List<SuperOp>) {
    for let a of &alt.actions {
        for let call of &find_this_calls(&a.source.text) {
            add_super_op(ops, call, &a.kind);
        }
    }
    for let e of &alt.elements {
        collect_lexer_elem_ops(e, ops);
    }
}

fn collect_lexer_elem_ops(elem: &LexerElement, ops: &mut List<SuperOp>) {
    match elem {
        Group(alts) => {
            for let alt of alts {
                collect_lexer_alt_ops(alt, ops);
            }
        },
        Repeat(rep) => collect_lexer_elem_ops(&rep.element, ops),
        Not(n) => collect_lexer_elem_ops(&n.element, ops),
        _ => {
        },
    }
}

/// Emit `interface Foo { ... }`, one operation per op. A predicate takes the
/// read-only `LexerView` and returns `bool`; an action also takes the `Lexer`,
/// for the command surface. Names are snake_cased to match the call rewrite.
pub fn gen_super_interface(w: &mut CodeWriter, name: &String, ops: &List<SuperOp>) {
    w.line(&`pub interface ${*name} {`);
    for let op of ops {
        if op.is_predicate {
            w.line(&`    fn ${to_snake_case(&op.name)}(view: LexerView) -> bool;`);
        } else {
            w.line(&`    fn ${to_snake_case(&op.name)}(view: LexerView, lx: &mut Lexer);`);
        }
    }
    w.line(&"}");
    w.blank();
}

/// The ambient operation call, reading the match-fn locals in scope at every
/// lexer action / predicate site. An action also passes the replay fn's `lx`.
/// Arguments are dropped.
pub fn super_call_expr(base_name: &String, method: &String, is_action: bool) -> String {
    let lx = if is_action { ", lx" } else { "" };
    return `${*base_name}::${to_snake_case(method)}(LexerView { chars, start, pos }${lx})`;
}

/// Rewrite every lexer action / predicate body in place, turning each
/// `this.<method>(...)` into `Foo::<method>(...)`. Run after op collection, so
/// the identity translator then passes the body through as ordinary Wado.
pub fn rewrite_superclass_calls(grammar: &mut Grammar, base_name: &String) {
    for let rule of &mut grammar.lexer_rules {
        for let alt of &mut rule.body {
            rewrite_lexer_alt(alt, base_name);
        }
    }
}

fn rewrite_lexer_alt(alt: &mut LexerAlternative, base_name: &String) {
    for let a of &mut alt.actions {
        a.source.text = rewrite_this_calls(&a.source.text, base_name, a.kind matches { Action });
    }
    for let mut i = 0; i < alt.elements.len(); i += 1 {
        alt.elements[i] = rewrite_lexer_elem(&alt.elements[i], base_name);
    }
}

fn rewrite_lexer_elem(elem: &LexerElement, base_name: &String) -> LexerElement {
    return match elem {
        Group(alts) => {
            let mut new_alts: List<LexerAlternative> = [];
            for let alt of alts {
                let mut a = *alt;
                rewrite_lexer_alt(&mut a, base_name);
                new_alts.push(a);
            }
            LexerElement::Group(new_alts);
        },
        Repeat(rep) => LexerElement::Repeat(LexerRepeatElement {
            kind: rep.kind,
            element: rewrite_lexer_elem(&rep.element, base_name),
            non_greedy: rep.non_greedy,
        }),
        Not(nn) => LexerElement::Not(LexerNotElement { element: rewrite_lexer_elem(&nn.element, base_name) }),
        _ => *elem,
    };
}

/// Replace each `this.<method>(...)` call in `body` with `Foo::<method>()`,
/// copying everything else verbatim and skipping string / comment spans so a
/// `this.` inside host text is never rewritten. Call arguments are dropped
/// (zero-argument today).
pub fn rewrite_this_calls(body: &String, base_name: &String, is_action: bool) -> String {
    let chars: List<char> = body.chars().collect();
    let n = chars.len();
    let mut out = String::with_capacity(n + 8);
    let mut i = 0;
    while i < n {
        i = match chars[i] {
            '"' | '\'' => copy_span(&mut out, &chars, i, scan_string(&chars, i)),
            '/' && i + 1 < n && chars[i + 1] == '/' => copy_span(&mut out, &chars, i, scan_line_comment(&chars, i)),
            '/' && i + 1 < n && chars[i + 1] == '*' => copy_span(&mut out, &chars, i, scan_block_comment(&chars, i)),
            _ => match this_call_at(&chars, i, n) {
                Some([method, close]) => {
                    out.push_str(&super_call_expr(base_name, &method, is_action));
                    close;
                },
                None => {
                    out.push(chars[i]);
                    i + 1;
                },
            },
        };
    }
    return out;
}

/// Index just past the `)` matching the `(` at `open`, skipping nested parens
/// and string spans. Returns `n` if unbalanced (a malformed body the g4 parser
/// would already have rejected).
fn match_paren(chars: &List<char>, open: i32, n: i32) -> i32 {
    let mut depth = 0;
    for let mut i = open; i < n; i += 1 {
        match chars[i] {
            // Skip a string span; `- 1` because the loop step re-adds one.
            '"' | '\'' => i = scan_string(chars, i) - 1,
            '(' => depth += 1,
            ')' => {
                depth -= 1;
                if depth == 0 {
                    return i + 1;
                }
            },
            _ => {
            },
        }
    }
    return n;
}

/// Copy `chars[start..end]` into `out` and return `end` — the scanner's next
/// index, so a match arm reads `i = copy_span(...)`.
fn copy_span(out: &mut String, chars: &List<char>, start: i32, end: i32) -> i32 {
    for let mut i = start; i < end; i += 1 {
        out.push(chars[i]);
    }
    return end;
}
