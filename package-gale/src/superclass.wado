//! SuperClass — effect-interface synthesis for `options { superClass = Foo }`.
//!
//! ANTLR's `superClass` is object inheritance; Wado has none, so a base class
//! becomes a Wado effect interface: `this.<method>()` action / predicate calls
//! lower to ambient `Foo::<method>()` operations, the user provides an
//! `impl Foo for Base` handler and installs it with `with Foo => &mut base do`.
//! See `action.md`, "SuperClass — an effect interface".
//!
//! This module is the language-independent core: base name, call-site scan,
//! interface synthesis, call rewrite. Codegen threads the effect.

use {
    Alternative,
    Element,
    Grammar,
    ActionKind,
    LexerRule,
    LexerAlternative,
    LexerElement,
    LexerRepeatElement,
    LexerNotElement,
} from "./ir.wado";
use { scan_string, scan_line_comment, scan_block_comment, is_id_start_char, is_id_continue_char } from "./g4/scan.wado";
use { CodeWriter } from "./wadopoet.wado";
use { to_snake_case } from "./ident.wado";

/// One synthesized effect operation, from a distinct `this.<method>` call site.
/// `is_predicate` distinguishes a `{...}?` predicate call from a `{...}` action.
/// `params` are the Wado types the call sites agree on, inferred from their
/// literal arguments; `bad_args` marks sites that settle no signature at all.
pub struct SuperOp {
    pub name: String,
    pub is_predicate: bool,
    pub params: List<String> = [],
    pub bad_args: bool = false,
    /// The same name reached from both a predicate and an action body: the two
    /// call forms differ, so one site would mismatch the operation's signature.
    pub mixed_role: bool = false,
}

/// Where a `this.<method>` call sits, which fixes the operation's call form.
pub enum SuperSite {
    /// Lexer predicate: the read-only match window.
    LexerPredicate,
    /// Lexer action: the match window plus the lexer's command surface.
    LexerAction,
    /// Parser predicate: the recognizer, as an ANTLR base method reads `this`.
    ParserPredicate,
}

/// One `this.<method>(...)` call site found in a body.
pub struct SuperCall {
    pub name: String,
    /// The arguments as written, one per top-level comma-separated slot.
    pub args: List<String> = [],
}

/// One action or predicate body, with the kind that fixes its call form.
struct SuperBody {
    text: String,
    kind: ActionKind,
}

/// Every lexer action / predicate body, in source order. The one traversal both
/// whole-grammar questions and the op collection read.
fn lexer_bodies(grammar: &Grammar) -> List<SuperBody> {
    let mut out: List<SuperBody> = [];
    for let rule of &grammar.lexer_rules {
        for let alt of &rule.body {
            push_lexer_alt_bodies(alt, &mut out);
        }
    }
    return out;
}

fn push_lexer_alt_bodies(alt: &LexerAlternative, out: &mut List<SuperBody>) {
    for let a of &alt.actions {
        out.push(SuperBody { text: a.source.text, kind: a.kind });
    }
    for let e of &alt.elements {
        push_lexer_elem_bodies(e, out);
    }
}

fn push_lexer_elem_bodies(elem: &LexerElement, out: &mut List<SuperBody>) {
    match elem {
        Group(alts) => {
            for let alt of alts {
                push_lexer_alt_bodies(alt, out);
            }
        },
        Repeat(rep) => push_lexer_elem_bodies(&rep.element, out),
        Not(nn) => push_lexer_elem_bodies(&nn.element, out),
        _ => {
        },
    }
}

/// Every parser action / predicate body, in source order. An `@init` / `@after`
/// prequel is an action, which is what makes a base call in one refusable.
fn parser_bodies(grammar: &Grammar) -> List<SuperBody> {
    let mut out: List<SuperBody> = [];
    for let rule of &grammar.parser_rules {
        for let prequel of &[&rule.init_action, &rule.after_action] {
            if let Some(a) = *prequel {
                out.push(SuperBody { text: a.text, kind: ActionKind::Action });
            }
        }
        for let alt of &rule.alternatives {
            push_parser_alt_bodies(alt, &mut out);
        }
    }
    return out;
}

fn push_parser_alt_bodies(alt: &Alternative, out: &mut List<SuperBody>) {
    for let a of &alt.actions {
        out.push(SuperBody { text: a.source.text, kind: a.kind });
    }
    for let e of &alt.elements {
        push_parser_elem_bodies(e, out);
    }
}

fn push_parser_elem_bodies(elem: &Element, out: &mut List<SuperBody>) {
    match elem {
        Group(g) => {
            for let alt of &g.alternatives {
                push_parser_alt_bodies(alt, out);
            }
        },
        Repeat(rep) => push_parser_elem_bodies(&rep.element, out),
        Label(lab) => push_parser_elem_bodies(&lab.element, out),
        Not(n) => push_parser_elem_bodies(&n.element, out),
        _ => {
        },
    }
}

fn collect_super_ops(bodies: &List<SuperBody>) -> List<SuperOp> {
    let mut ops: List<SuperOp> = [];
    for let b of bodies {
        for let call of &find_this_calls(&b.text) {
            add_super_op(&mut ops, call, &b.kind);
        }
    }
    return ops;
}

/// The lexer's `superClass` base, or `null` when there is none.
pub fn lexer_superclass_name(grammar: &Grammar) -> Option<String> {
    return non_empty(&grammar.lexer_superclass);
}

/// The parser's `superClass` base, or `null` when there is none.
pub fn parser_superclass_name(grammar: &Grammar) -> Option<String> {
    return non_empty(&grammar.parser_superclass);
}

fn non_empty(s: &String) -> Option<String> {
    if s.is_empty() {
        return null;
    }
    return Option::<String>::Some(*s);
}

/// The `this.<method>(` call sites in a body, in source order, skipping string
/// and comment text — but not a template's `${ ... }`, which is code. Only the
/// `this.` receiver is a superClass call; `m()` or `other.m()` is not.
pub fn find_this_calls(body: &String) -> List<SuperCall> {
    let chars: List<char> = body.chars().collect();
    let n = chars.len();
    let mut out: List<SuperCall> = [];
    let mut i = 0;
    while i < n {
        let [end, spans] = inert_at(&chars, i, n);
        if end > i {
            for let s of &spans {
                for let c of &find_this_calls(&collect_range(&chars, s.0, s.1)) {
                    out.push(*c);
                }
            }
            i = end;
            continue;
        }
        i = match this_call_at(&chars, i, n) {
            Some([name, close]) => {
                out.push(SuperCall { name, args: call_args(&chars, i, close) });
                close;
            },
            None => i + 1,
        };
    }
    return out;
}

/// Whether the body names `this` at all — a call, a field read, or the bare
/// word. Wado has no such name, so nothing here can be emitted as written.
pub fn body_names_this(body: &String) -> bool {
    let chars: List<char> = body.chars().collect();
    let n = chars.len();
    let mut i = 0;
    while i < n {
        let [end, spans] = inert_at(&chars, i, n);
        if end > i {
            if spans.iter_ref().any(|s: &[i32, i32]| body_names_this(&collect_range(&chars, s.0, s.1))) {
                return true;
            }
            i = end;
            continue;
        }
        if word_at(&chars, i, n, &THIS_WORD) {
            return true;
        }
        i += 1;
    }
    return false;
}

/// The end of the inert span starting at `i` — a string, a comment, or a
/// template's literal text — with the `${ ... }` code spans inside it.
fn inert_at(chars: &List<char>, i: i32, n: i32) -> [i32, List<[i32, i32]>] {
    let none: List<[i32, i32]> = [];
    return match chars[i] {
        '"' | '\'' => [scan_string(chars, i), none],
        '`' => scan_template(chars, i, n),
        '/' && i + 1 < n && chars[i + 1] == '/' => [scan_line_comment(chars, i), none],
        '/' && i + 1 < n && chars[i + 1] == '*' => [scan_block_comment(chars, i), none],
        _ => [i, none],
    };
}

/// Split a template literal at `i` into `[end, spans]`: past the closing
/// backtick, and the `${ ... }` bodies. Only the text between them is inert.
fn scan_template(chars: &List<char>, i: i32, n: i32) -> [i32, List<[i32, i32]>] {
    let mut spans: List<[i32, i32]> = [];
    let mut k = i + 1;
    while k < n {
        if chars[k] == '\\' && k + 1 < n {
            k += 2;
            continue;
        }
        if chars[k] == '`' {
            return [k + 1, spans];
        }
        if chars[k] == '$' && k + 1 < n && chars[k + 1] == '{' {
            let close = match_brace(chars, k + 1, n);
            assert close > k + 1, "match_brace never returns before the brace it opened";
            spans.push([k + 2, close - 1]);
            k = close;
            continue;
        }
        k += 1;
    }
    return [n, spans];
}

/// The index just past the `}` matching the `{` at `open`.
fn match_brace(chars: &List<char>, open: i32, n: i32) -> i32 {
    let mut depth = 0;
    for let mut i = open; i < n; i += 1 {
        match chars[i] {
            '"' | '\'' => i = scan_string(chars, i) - 1,
            '`' => {
                let [end, _] = scan_template(chars, i, n);
                i = end - 1;
            },
            '{' => depth += 1,
            '}' => {
                depth -= 1;
                if depth == 0 {
                    return i + 1;
                }
            },
            _ => {
            },
        }
    }
    return n;
}

/// The arguments the call spanning `[start, close)` passes, split on its
/// top-level commas. Only the receiver and the method name precede the first
/// `(`, so that one opens the argument list.
fn call_args(chars: &List<char>, start: i32, close: i32) -> List<String> {
    let mut open = start;
    for let mut i = start; i < close; i += 1 {
        if chars[i] == '(' {
            open = i;
            break;
        }
    }
    let mut out: List<String> = [];
    let mut depth = 0;
    let mut arg_start = open + 1;
    let mut i = open + 1;
    while i + 1 < close {
        match chars[i] {
            '"' | '\'' => {
                i = scan_string(chars, i);
                continue;
            },
            '(' | '[' | '{' => depth += 1,
            ')' | ']' | '}' => depth -= 1,
            ',' => {
                if depth == 0 {
                    out.push(collect_range(chars, arg_start, i).trim());
                    arg_start = i + 1;
                }
            },
            _ => {
            },
        }
        i += 1;
    }
    let last = collect_range(chars, arg_start, close - 1).trim();
    if !last.is_empty() || !out.is_empty() {
        out.push(last);
    }
    return out;
}

/// The Wado type a literal argument evidently has, or `null` for anything a
/// signature would have to guess at.
fn literal_arg_type(text: &String) -> Option<String> {
    if text.is_empty() {
        return null;
    }
    if text.starts_with("\"") && text.ends_with("\"") && text.len() >= 2 {
        return Option::Some("String");
    }
    if *text == "true" || *text == "false" {
        return Option::Some("bool");
    }
    let digits: List<char> = text.chars().collect();
    let first = if digits[0] == '-' { 1 } else { 0 };
    if digits.len() > first && digits.iter_ref().skip(first).all(|c: &char| *c matches { '0'..='9' }) {
        return Option::Some("i32");
    }
    return null;
}

/// The Wado types of a call's arguments, or `null` when one has no evident
/// type — the whole call is then unrepresentable, not just that argument.
fn call_param_types(args: &List<String>) -> Option<List<String>> {
    let mut out: List<String> = [];
    for let a of args {
        match literal_arg_type(a) {
            Some(t) => out.push(t),
            None => {
                return null;
            },
        }
    }
    return Option::Some(out);
}

/// If a `this.<method>(` call starts at `i` (whitespace allowed between
/// tokens), returns `[method, close]`: the method name and the index just past
/// the matching `)`. Else `null`. Shared by op collection and the call-site
/// rewrite, so both agree on what a call is and where it ends.
fn this_call_at(chars: &List<char>, i: i32, n: i32) -> Option<[String, i32]> {
    return call_at(chars, i, n, &THIS_WORD, &DOT_SEP);
}

/// The rewritten form: `Foo::<method>(...)`. Recognizing it too keeps
/// `body_is_base_calls_only` answering the same across the rewrite.
fn base_call_at(chars: &List<char>, i: i32, n: i32, base: &List<char>) -> Option<[String, i32]> {
    return call_at(chars, i, n, base, &PATH_SEP);
}

global THIS_WORD: List<char> = ['t', 'h', 'i', 's'];
global DOT_SEP: List<char> = ['.'];
global PATH_SEP: List<char> = [':', ':'];

fn call_at(chars: &List<char>, i: i32, n: i32, receiver: &List<char>, sep: &List<char>) -> Option<[String, i32]> {
    if !word_at(chars, i, n, receiver) {
        return null;
    }
    let after = skip_ws(chars, i + receiver.len(), n);
    if !text_at(chars, after, n, sep) {
        return null;
    }
    let name_start = skip_ws(chars, after + sep.len(), n);
    let name_end = scan_ident(chars, name_start, n);
    if name_end == name_start {
        return null;
    }
    let paren = skip_ws(chars, name_end, n);
    if paren >= n || chars[paren] != '(' {
        return null;
    }
    let name = collect_range(chars, name_start, name_end);
    return Option::Some([name, match_paren(chars, paren, n)]);
}

/// Whether `word` sits at `i` as a whole word (not part of a longer ident).
fn word_at(chars: &List<char>, i: i32, n: i32, word: &List<char>) -> bool {
    if !text_at(chars, i, n, word) {
        return false;
    }
    if i > 0 && is_id_continue_char(chars[i - 1]) {
        return false;
    }
    let end = i + word.len();
    return !(end < n && is_id_continue_char(chars[end]));
}

fn text_at(chars: &List<char>, i: i32, n: i32, text: &List<char>) -> bool {
    if i < 0 || i + text.len() > n {
        return false;
    }
    for let mut k = 0; k < text.len(); k += 1 {
        if chars[i + k] != text[k] {
            return false;
        }
    }
    return true;
}

fn scan_ident(chars: &List<char>, start: i32, n: i32) -> i32 {
    if start >= n || !is_id_start_char(chars[start]) {
        return start;
    }
    let mut i = start + 1;
    while i < n && is_id_continue_char(chars[i]) {
        i += 1;
    }
    return i;
}

fn skip_ws(chars: &List<char>, start: i32, n: i32) -> i32 {
    let mut i = start;
    while i < n && chars[i].is_ascii_whitespace() {
        i += 1;
    }
    return i;
}

fn collect_range(chars: &List<char>, start: i32, end: i32) -> String {
    let mut s = String::with_capacity(if end > start { end - start } else { 0 });
    for let mut i = start; i < end; i += 1 {
        s.push(chars[i]);
    }
    return s;
}

/// Add a scanned call to the op set; the first occurrence of a name fixes its
/// role and its signature. A later occurrence still contributes `bad_args` and
/// `mixed_role`, either of which makes the operation unrepresentable.
pub fn add_super_op(ops: &mut List<SuperOp>, call: &SuperCall, kind: &ActionKind) {
    let is_predicate = kind matches { Predicate };
    let params = call_param_types(&call.args);
    for let mut i = 0; i < ops.len(); i += 1 {
        if ops[i].name == call.name {
            ops[i].mixed_role = ops[i].mixed_role || ops[i].is_predicate != is_predicate;
            match &params {
                Some(p) => {
                    if *p != ops[i].params {
                        ops[i].bad_args = true;
                    }
                },
                None => ops[i].bad_args = true,
            }
            return;
        }
    }
    match params {
        Some(p) => ops.push(SuperOp { name: call.name, is_predicate, params: p }),
        None => ops.push(SuperOp { name: call.name, is_predicate, bad_args: true }),
    }
}

/// A base is wired only when this is empty (`action.md`, "SuperClass — an
/// effect interface").
pub fn super_ops_without_signature(ops: &List<SuperOp>) -> List<String> {
    let mut out: List<String> = [];
    for let op of ops {
        if op.bad_args {
            out.push(op.name);
        }
    }
    return out;
}

/// The parameter list an operation's inferred argument types declare, after the
/// receiver: `, a0: String`. Empty for a zero-argument operation.
fn super_op_params(op: &SuperOp) -> String {
    let mut typed: List<String> = [];
    for let mut i = 0; i < op.params.len(); i += 1 {
        typed.push(`a${i}: ${op.params[i]}`);
    }
    return after_receiver(&typed);
}

/// What an operation's signature or call site appends after the receiver.
fn after_receiver(items: &List<String>) -> String {
    if items.is_empty() {
        return String::new();
    }
    return `, ${items.join(", ")}`;
}

/// The recognizer methods a base may override.
global SUPER_HOOKS: List<String> = ["emit"];

/// A base is wired only when this is empty.
pub fn super_ops_reserved(ops: &List<SuperOp>) -> List<String> {
    let mut out: List<String> = [];
    for let op of ops {
        if SUPER_HOOKS.contains(&to_snake_case(&op.name)) {
            out.push(op.name);
        }
    }
    return out;
}

/// A base is wired only when this is empty.
pub fn super_ops_mixed_role(ops: &List<SuperOp>) -> List<String> {
    let mut out: List<String> = [];
    for let op of ops {
        if op.mixed_role {
            out.push(op.name);
        }
    }
    return out;
}

/// The lexer's superClass operations: every distinct `this.<method>` call in an
/// action / predicate body, in source order, deduped by name.
pub fn collect_lexer_super_ops(grammar: &Grammar) -> List<SuperOp> {
    return collect_super_ops(&lexer_bodies(grammar));
}

/// Whether `body` is nothing but base-method calls and separators — the source
/// form `this.m(...)` or the `Foo::m(...)` the rewrite leaves behind. Such a
/// body is plain Wado once `rewrite_lexer_superclass_calls` has run, so it runs
/// without the host translator a `superClass` grammar carves out; one carrying
/// host code around the call needs that translator. Both forms are accepted so
/// the answer does not move across the rewrite.
pub fn body_is_base_calls_only(body: &String, base_name: &String) -> bool {
    let chars: List<char> = body.chars().collect();
    let base: List<char> = base_name.chars().collect();
    let n = chars.len();
    let mut i = 0;
    while i < n {
        if chars[i].is_ascii_whitespace() || chars[i] == ';' {
            i += 1;
            continue;
        }
        // A comment is not host code; the rewrite copies it through verbatim.
        if chars[i] == '/' && i + 1 < n && chars[i + 1] == '/' {
            i = scan_line_comment(&chars, i);
            continue;
        }
        if chars[i] == '/' && i + 1 < n && chars[i + 1] == '*' {
            i = scan_block_comment(&chars, i);
            continue;
        }
        if let Some([_, close]) = this_call_at(&chars, i, n) {
            i = close;
            continue;
        }
        if let Some([_, close]) = base_call_at(&chars, i, n, &base) {
            i = close;
            continue;
        }
        return false;
    }
    return true;
}

/// Whether every lexer `{ ... }` action body is base-calls-only, which is what
/// lets a `language = Java` `superClass` grammar run its actions at all.
pub fn lexer_action_bodies_are_base_calls(grammar: &Grammar, base_name: &String) -> bool {
    return lexer_bodies(grammar).iter_ref().all(|b: &SuperBody| !b.kind matches { Action }
        || body_is_base_calls_only(&b.text, base_name));
}

/// Whether a lexer body still names `this` after wiring. Only a `this.m()` call
/// under a lexer base lowers to an operation; anything else has no receiver.
pub fn lexer_bodies_name_unwired_base(grammar: &Grammar) -> bool {
    return lexer_bodies(grammar).iter_ref().any(|b: &SuperBody| body_names_this(&b.text));
}

/// Why a lexer base cannot be wired, or empty when it can. The message names
/// the operations that forced it.
pub fn lexer_super_refusal(ops: &List<SuperOp>) -> String {
    let with_args = args_refusal(ops);
    if !with_args.is_empty() {
        return with_args;
    }
    let mixed = super_ops_mixed_role(ops);
    if !mixed.is_empty() {
        return `calls (${mixed.join(", ")}) from both a predicate and an action; an operation is one or the other`;
    }
    let reserved = super_ops_reserved(ops);
    if !reserved.is_empty() {
        return `calls (${reserved.join(", ")}), which name a lifecycle hook the interface already declares`;
    }
    return "";
}

/// Why a parser base cannot be wired, or empty when it can. The parser side
/// carries no command surface, so an action op has nothing to drive.
pub fn parser_super_refusal(ops: &List<SuperOp>) -> String {
    let with_args = args_refusal(ops);
    if !with_args.is_empty() {
        return with_args;
    }
    let actions = super_ops_actions(ops);
    if !actions.is_empty() {
        return `calls (${actions.join(", ")}) from an action body; a parser base operation is a predicate`;
    }
    return "";
}

/// The refusal both recognizers share: a call site is an operation's only
/// signature source, so sites that settle none leave nothing to declare.
fn args_refusal(ops: &List<SuperOp>) -> String {
    let unsettled = super_ops_without_signature(ops);
    if unsettled.is_empty() {
        return "";
    }
    return `is called with arguments (${unsettled.join(", ")}) whose types its call sites do not settle; a base operation has no other signature source`;
}

/// Operations reached from an action body rather than a predicate.
fn super_ops_actions(ops: &List<SuperOp>) -> List<String> {
    let mut out: List<String> = [];
    for let op of ops {
        if !op.is_predicate || op.mixed_role {
            out.push(op.name);
        }
    }
    return out;
}

/// The parser's superClass operations: every distinct `this.<method>` call in
/// an action / predicate body, in source order, deduped by name.
pub fn collect_parser_super_ops(grammar: &Grammar) -> List<SuperOp> {
    return collect_super_ops(&parser_bodies(grammar));
}

/// Emit `interface Foo { ... }` for a parser base: one predicate operation per
/// op, each reading the recognizer the way an ANTLR base method reads `this`.
pub fn gen_parser_super_interface(w: &mut CodeWriter, name: &String, ops: &List<SuperOp>) {
    w.line(&`pub interface ${*name} {`);
    for let op of ops {
        w.line(&`    fn ${to_snake_case(&op.name)}(p: &Parser${super_op_params(op)}) -> bool;`);
    }
    w.line(&"}");
    w.blank();
}

/// Rewrite every parser predicate body in place, `this.<method>(...)` into
/// `Foo::<method>(p)`. Alternatives only: a prequel call is refused earlier.
pub fn rewrite_parser_superclass_calls(grammar: &mut Grammar, base_name: &String) {
    for let rule of &mut grammar.parser_rules {
        for let alt of &mut rule.alternatives {
            rewrite_parser_alt(alt, base_name);
        }
    }
}

fn rewrite_parser_alt(alt: &mut Alternative, base_name: &String) {
    for let a of &mut alt.actions {
        a.source.text = rewrite_this_calls(&a.source.text, base_name, SuperSite::ParserPredicate);
    }
    for let mut i = 0; i < alt.elements.len(); i += 1 {
        alt.elements[i] = rewrite_parser_elem(&alt.elements[i], base_name);
    }
}

fn rewrite_parser_elem(elem: &Element, base_name: &String) -> Element {
    return match elem {
        Group(g) => {
            let mut ng = *g;
            for let mut i = 0; i < ng.alternatives.len(); i += 1 {
                rewrite_parser_alt(&mut ng.alternatives[i], base_name);
            }
            Element::Group(ng);
        },
        Repeat(rep) => {
            let mut nr = *rep;
            nr.element = rewrite_parser_elem(&rep.element, base_name);
            Element::Repeat(nr);
        },
        Label(lab) => {
            let mut nl = *lab;
            nl.element = rewrite_parser_elem(&lab.element, base_name);
            Element::Label(nl);
        },
        Not(n) => {
            let mut nn = *n;
            nn.element = rewrite_parser_elem(&n.element, base_name);
            Element::Not(nn);
        },
        _ => *elem,
    };
}

/// Whether every parser action / predicate body is base-calls-only, which is
/// what lets a `language = Java` `superClass` grammar run them at all.
pub fn parser_bodies_are_base_calls(grammar: &Grammar, base_name: &String) -> bool {
    return parser_bodies(grammar).iter_ref().all(|b: &SuperBody| body_is_base_calls_only(&b.text, base_name));
}

/// Whether a rule's match fn (transitively, through referenced fragments)
/// evaluates a `Foo::op(...)` and so must declare `with Foo`. A non-recursive
/// fragment is inlined into its caller and a recursive one is called from it, so
/// either way the caller carries the effect; `RuleRef`s are followed through
/// `all_rules`, and `visited` breaks cycles. Matched on the rewritten `Foo::`
/// form, since op collection rewrote the `this.` sites first. Only predicates
/// count: a match fn never emits an action, which runs from the replay.
pub fn lexer_rule_match_calls_super(rule: &LexerRule, all_rules: &List<LexerRule>, base_name: &String) -> bool {
    return rule_calls_super_with(rule, all_rules, base_name, false);
}

/// The same for a rule's `apply_<rule>_actions` replay, which also runs the
/// alternatives' actions.
pub fn lexer_rule_replay_calls_super(rule: &LexerRule, all_rules: &List<LexerRule>, base_name: &String) -> bool {
    return rule_calls_super_with(rule, all_rules, base_name, true);
}

fn rule_calls_super_with(rule: &LexerRule, all_rules: &List<LexerRule>, base_name: &String, actions: bool) -> bool {
    let needle = `${*base_name}::`;
    let mut visited: List<String> = [];
    return rule_calls_super(rule, all_rules, &needle, actions, &mut visited);
}

fn rule_calls_super(
    rule: &LexerRule,
    all_rules: &List<LexerRule>,
    needle: &String,
    actions: bool,
    visited: &mut List<String>,
) -> bool {
    if visited.iter_ref().any(|v: &String| *v == rule.name) {
        return false;
    }
    visited.push(rule.name);
    return rule.body.iter_ref().any(|alt| alt_calls_super(alt, all_rules, needle, actions, visited));
}

fn alt_calls_super(
    alt: &LexerAlternative,
    all_rules: &List<LexerRule>,
    needle: &String,
    actions: bool,
    visited: &mut List<String>,
) -> bool {
    for let a of &alt.actions {
        if !actions && a.kind matches { Action } {
            continue;
        }
        if a.source.text.contains(*needle) {
            return true;
        }
    }
    return alt.elements.iter_ref().any(|e| elem_calls_super(e, all_rules, needle, actions, visited));
}

fn elem_calls_super(
    elem: &LexerElement,
    all_rules: &List<LexerRule>,
    needle: &String,
    actions: bool,
    visited: &mut List<String>,
) -> bool {
    match elem {
        Group(alts) => {
            for let alt of alts {
                if alt_calls_super(alt, all_rules, needle, actions, visited) {
                    return true;
                }
            }
        },
        Repeat(rep) => {
            return elem_calls_super(&rep.element, all_rules, needle, actions, visited);
        },
        Not(n) => {
            return elem_calls_super(&n.element, all_rules, needle, actions, visited);
        },
        RuleRef(name) => {
            for let r of all_rules {
                if r.name == *name {
                    return rule_calls_super(r, all_rules, needle, actions, visited);
                }
            }
        },
        _ => {
        },
    }
    return false;
}

/// Emit `interface Foo { ... }`, one operation per op, then the lifecycle hooks.
/// A predicate takes the read-only `LexerView` and returns `bool`; an action
/// also takes the `Lexer`, for the command surface.
pub fn gen_super_interface(w: &mut CodeWriter, name: &String, ops: &List<SuperOp>) {
    w.line(&`pub interface ${*name} {`);
    for let op of ops {
        if op.is_predicate {
            w.line(&`    fn ${to_snake_case(&op.name)}(view: LexerView${super_op_params(op)}) -> bool;`);
        } else {
            w.line(&`    fn ${to_snake_case(&op.name)}(view: LexerView, lx: &mut Lexer${super_op_params(op)});`);
        }
    }
    gen_super_hooks(w);
    w.line(&"}");
    w.blank();
}

/// A default body means a base opts in by implementing one, the way an
/// `@Override` does, and every other base is unaffected.
fn gen_super_hooks(w: &mut CodeWriter) {
    w.line(&"    /// Called with the span, type and channel of each token the lexer");
    w.line(&"    /// commits — not a skipped or `more`d match, and not the EOF");
    w.line(&"    /// sentinel. Returns the type to emit.");
    w.line(&"    fn emit(view: LexerView, ty: i32, channel: i32) -> i32 {");
    w.line(&"        return ty;");
    w.line(&"    }");
}

/// The tokenize-loop call to the `emit` hook, reading the loop's own locals.
pub fn super_emit_hook_expr(base_name: &String, channel: &String) -> String {
    return `${*base_name}::emit(LexerView { chars: &lexer.chars, start: tok_start, pos: best_end }, best_kind, ${*channel})`;
}

/// The ambient operation call for a call site, reading the locals in scope
/// there and passing `args` after the receiver.
pub fn super_call_expr(base_name: &String, method: &String, site: SuperSite, args: &List<String>) -> String {
    let recv = match site {
        LexerPredicate => "LexerView { chars, start, pos }",
        LexerAction => "LexerView { chars, start, pos }, lx",
        ParserPredicate => "p",
    };
    return `${*base_name}::${to_snake_case(method)}(${recv}${after_receiver(args)})`;
}

/// Rewrite every lexer action / predicate body in place, turning each
/// `this.<method>(...)` into `Foo::<method>(...)`. Run after op collection, so
/// the identity translator then passes the body through as ordinary Wado.
pub fn rewrite_lexer_superclass_calls(grammar: &mut Grammar, base_name: &String) {
    for let rule of &mut grammar.lexer_rules {
        for let alt of &mut rule.body {
            rewrite_lexer_alt(alt, base_name);
        }
    }
}

fn rewrite_lexer_alt(alt: &mut LexerAlternative, base_name: &String) {
    for let a of &mut alt.actions {
        let site = if a.kind matches { Action } { SuperSite::LexerAction } else { SuperSite::LexerPredicate };
        a.source.text = rewrite_this_calls(&a.source.text, base_name, site);
    }
    for let mut i = 0; i < alt.elements.len(); i += 1 {
        alt.elements[i] = rewrite_lexer_elem(&alt.elements[i], base_name);
    }
}

fn rewrite_lexer_elem(elem: &LexerElement, base_name: &String) -> LexerElement {
    return match elem {
        Group(alts) => {
            let mut new_alts: List<LexerAlternative> = [];
            for let alt of alts {
                let mut a = *alt;
                rewrite_lexer_alt(&mut a, base_name);
                new_alts.push(a);
            }
            LexerElement::Group(new_alts);
        },
        Repeat(rep) => LexerElement::Repeat(LexerRepeatElement {
            kind: rep.kind,
            element: rewrite_lexer_elem(&rep.element, base_name),
            non_greedy: rep.non_greedy,
        }),
        Not(nn) => LexerElement::Not(LexerNotElement { element: rewrite_lexer_elem(&nn.element, base_name) }),
        _ => *elem,
    };
}

/// Replace each `this.<method>(...)` call in `body` with the ambient operation
/// call for `site`, over the same spans `find_this_calls` reads.
pub fn rewrite_this_calls(body: &String, base_name: &String, site: SuperSite) -> String {
    let chars: List<char> = body.chars().collect();
    let n = chars.len();
    let mut out = String::with_capacity(n + 8);
    let mut i = 0;
    while i < n {
        let [end, spans] = inert_at(&chars, i, n);
        if end > i {
            let mut cur = i;
            for let s of &spans {
                copy_span(&mut out, &chars, cur, s.0);
                out.push_str(&rewrite_this_calls(&collect_range(&chars, s.0, s.1), base_name, site));
                cur = s.1;
            }
            copy_span(&mut out, &chars, cur, end);
            i = end;
            continue;
        }
        i = match this_call_at(&chars, i, n) {
            Some([method, close]) => {
                out.push_str(&super_call_expr(base_name, &method, site, &call_args(&chars, i, close)));
                close;
            },
            None => {
                out.push(chars[i]);
                i + 1;
            },
        };
    }
    return out;
}

/// Index just past the `)` matching the `(` at `open`, skipping nested parens
/// and string spans. Returns `n` if unbalanced (a malformed body the g4 parser
/// would already have rejected).
fn match_paren(chars: &List<char>, open: i32, n: i32) -> i32 {
    let mut depth = 0;
    for let mut i = open; i < n; i += 1 {
        match chars[i] {
            // Skip a string span; `- 1` because the loop step re-adds one.
            '"' | '\'' => i = scan_string(chars, i) - 1,
            '(' => depth += 1,
            ')' => {
                depth -= 1;
                if depth == 0 {
                    return i + 1;
                }
            },
            _ => {
            },
        }
    }
    return n;
}

/// Copy `chars[start..end]` into `out` and return `end` — the scanner's next
/// index, so a match arm reads `i = copy_span(...)`.
fn copy_span(out: &mut String, chars: &List<char>, start: i32, end: i32) -> i32 {
    for let mut i = start; i < end; i += 1 {
        out.push(chars[i]);
    }
    return end;
}
