use { translate_action, translate_predicate, translate_members, grammar_has_superclass } from "./java2wado.wado";
use { parse } from "./g4/parser.wado";
use { ActionLanguage } from "./ir.wado";

global NO_BINDINGS: List<[bool, String, String]> = [];

fn java_pred(src: &String, rule_src: &String, vals_in_scope: bool) -> String {
    let g = parse(`grammar T;
{*rule_src}
`).unwrap();
    let lang = ActionLanguage::Java;
    return translate_predicate(&lang, &g.parser_rules[0], &g.parser_rules, src, vals_in_scope, &NO_BINDINGS).unwrap();
}

test "java predicate: this.field with arithmetic and comparison" {
    let out = java_pred(&"this.i % 2 == 0", &"a : ID ;", false);
    assert out == "this.i % 2 == 0", `out: '{out}'`;
}

test "java predicate: rule arg reference" {
    let out = java_pred(&"$i == 1", &"a[i32 i] : ID ;", true);
    assert out == "vals.i == 1", `out: '{out}'`;
}

test "java predicate: negation with parens" {
    let out = java_pred(&"!(this.enumKeyword)", &"a : ID ;", false);
    assert out == "!(this.enumKeyword)", `out: '{out}'`;
}

test "java predicate: input lookahead vs token constant" {
    let out = java_pred(&"_input.LA(1) != TParser.ELSE", &"a : ID ;", false);
    assert out == "this.la(1) != TK_ELSE", `out: '{out}'`;
}

test "java predicate: token text equals" {
    let out = java_pred(&"_input.LT(1).getText().equals(\"x\")", &"a : ID ;", false);
    assert out == "this.token_text(this.lt(1)) == \"x\"", `out: '{out}'`;
}

test "java predicate: member method call snake-cases" {
    let out = java_pred(&"this.pred($i == 99)", &"a[i32 i] : ID ;", true);
    assert out == "this.pred(vals.i == 99)", `out: '{out}'`;
}

test "java predicate: boolean literal" {
    let out = java_pred(&"false", &"a : ID ;", false);
    assert out == "false", `out: '{out}'`;
}

test "java expr: numeric plus is not string concat" {
    let g = parse("grammar T;
r : x=e ;
e returns [i32 v] : ID ;
").unwrap();
    let lang = ActionLanguage::Java;
    let out = translate_predicate(&lang, &g.parser_rules[0], &g.parser_rules, &"$x.v + 1", false, &NO_BINDINGS).unwrap();
    assert out == "x.v + 1", `out: '{out}'`;
}

test "java expr: string concat becomes a template literal" {
    let g = parse("grammar T;
r : ID ;
").unwrap();
    let lang = ActionLanguage::Java;
    let out = translate_predicate(
        &lang,
        &g.parser_rules[0],
        &g.parser_rules,
        &"\"ID \" + $ID.text",
        false,
        &NO_BINDINGS,
    ).unwrap();
    assert out == "`ID {this.token_text(id)}`", `out: '{out}'`;
}

test "dispatcher routes language = Wado through the identity translator" {
    let g = parse("grammar T;
r returns [i32 v] : ID { $v = 1; } ;
").unwrap();
    let lang = ActionLanguage::Wado;
    let out = translate_action(&lang, &g.parser_rules[0], &g.parser_rules, &" $v = 1; ", true, &NO_BINDINGS).unwrap();
    assert out == " vals.v = 1; ", `out: '{out}'`;
}

fn java_action(src: &String, rule_src: &String, vals_in_scope: bool) -> String {
    let g = parse(`grammar T;
{*rule_src}
`).unwrap();
    let lang = ActionLanguage::Java;
    return translate_action(&lang, &g.parser_rules[0], &g.parser_rules, src, vals_in_scope, &NO_BINDINGS).unwrap();
}

test "java action: println appends a newline" {
    let out = java_action(&"System.out.println(\"enum\");", &"a : ID ;", false);
    assert out == "this.emit(`enum\\n`);", `out: '{out}'`;
}

test "java action: print omits the newline" {
    let out = java_action(&"System.out.print(\"a\");", &"a : ID ;", false);
    assert out == "this.emit(`a`);", `out: '{out}'`;
}

test "java action: println stringifies a value arg" {
    let out = java_action(&"System.out.println($x.v);", &"r : x=e ; e returns [i32 v] : ID ;", false);
    assert out == "this.emit(`{x.v}\\n`);", `out: '{out}'`;
}

test "java action: println with a concat arg" {
    let out = java_action(&"System.out.println(\"ID \" + $ID.text);", &"r : ID ;", false);
    assert out == "this.emit(`ID {this.token_text(id)}\\n`);", `out: '{out}'`;
}

test "java action: assignment to the value channel" {
    let out = java_action(
        &"$v = $a.v + $b.v;",
        &"r returns [i32 v] : a=e b=e ; e returns [i32 v] : ID ;",
        true,
    );
    assert out == "vals.v = a.v + b.v;", `out: '{out}'`;
}

test "java action: compound assignment on this.field" {
    let out = java_action(&"this.i += 1;", &"a : ID ;", false);
    assert out == "this.i += 1;", `out: '{out}'`;
}

test "java action: local declaration maps the type" {
    let out = java_action(&"int x = 0;", &"a : ID ;", false);
    assert out == "let mut x: i32 = 0;", `out: '{out}'`;
}

test "java action: multiple statements space-join" {
    let out = java_action(&"this.i += 1; System.out.print(\"i=\");", &"a : ID ;", false);
    assert out == "this.i += 1; this.emit(`i=`);", `out: '{out}'`;
}

test "java action: ctx-cast LR-binary value idiom" {
    let g = parse("grammar T;
e returns [i32 v] : e '+' e | INT ;
").unwrap();
    let lang = ActionLanguage::Java;
    let bindings: List<[bool, String, String]> = [
        [false, "e", "e"],
    ];
    let out = translate_action(
        &lang,
        &g.parser_rules[0],
        &g.parser_rules,
        &"$v = ((BinaryContext)$ctx).e(0).v + ((BinaryContext)$ctx).e(1).v;",
        true,
        &bindings,
    ).unwrap();
    assert out == "vals.v = _lr_acc.v + e.v;", `out: '{out}'`;
}

test "java predicate: ctx-cast child access maps to the LR accumulator" {
    let g = parse("grammar T;
e returns [i32 v] : e '+' e | INT ;
").unwrap();
    let lang = ActionLanguage::Java;
    let out = translate_predicate(
        &lang,
        &g.parser_rules[0],
        &g.parser_rules,
        &"((BinaryContext)$ctx).e(0).v > 0",
        true,
        &NO_BINDINGS,
    ).unwrap();
    assert out == "_lr_acc.v > 0", `out: '{out}'`;
}

test "java: ctx-cast in a non-left-recursive rule is a loud error" {
    let g = parse("grammar T;
r returns [i32 v] : INT ;
").unwrap();
    let lang = ActionLanguage::Java;
    let res = translate_predicate(
        &lang,
        &g.parser_rules[0],
        &g.parser_rules,
        &"((C)$ctx).r(0).v > 0",
        true,
        &NO_BINDINGS,
    );
    assert res.is_err(), "$ctx child access outside an LR rule must be a loud error";
}

test "java members: field declarations become struct fields" {
    let lang = ActionLanguage::Java;
    let m = translate_members(&lang, &"boolean enumKeyword = true; int i = 0;").unwrap();
    assert m.fields.len() == 2, `fields: {m.fields.len()}`;
    assert m.fields[0].name == "enumKeyword" && m.fields[0].ty == "bool" && m.fields[0].init == "true", `f0: {m.fields[0].name}:{m.fields[0].ty}={m.fields[0].init}`;
    assert m.fields[1].name == "i" && m.fields[1].ty == "i32" && m.fields[1].init == "0", `f1: {m.fields[1].name}:{m.fields[1].ty}={m.fields[1].init}`;
    assert m.methods.is_empty(), "no methods expected";
}

test "java members: method with a param, print, and return" {
    let lang = ActionLanguage::Java;
    let m = translate_members(
        &lang,
        &"boolean pred(boolean v) { System.out.println(\"eval=\" + v); return v; }",
    ).unwrap();
    assert m.fields.is_empty(), "no fields expected";
    assert m.methods.len() == 1, `methods: {m.methods.len()}`;
    assert m.methods[0] == "fn pred(&mut self, v: bool) -> bool { self.emit(`eval={v}\\n`); return v; }", `method: '{m.methods[0]}'`;
}

test "java members: void method, no params" {
    let lang = ActionLanguage::Java;
    let m = translate_members(&lang, &"public void foo() { System.out.println(\"foo\"); }").unwrap();
    assert m.methods.len() == 1, `methods: {m.methods.len()}`;
    assert m.methods[0] == "fn foo(&mut self) { self.emit(`foo\\n`); }", `method: '{m.methods[0]}'`;
}

test "grammar_has_superclass keys the Phase 4 carve-out" {
    let with_super = parse("grammar T;
options { superClass = TBase; }
a : A ;
").unwrap();
    assert grammar_has_superclass(&with_super), "superClass grammar must be detected";

    let plain = parse("grammar T;
a : A ;
").unwrap();
    assert !grammar_has_superclass(&plain), "grammar without superClass must not be detected";
}
