use { args, print, eprintln, Stdout, Stderr, Environment } from "core:cli";
use { Preopens, Descriptor, Filesize, PathFlags, OpenFlags, DescriptorFlags } from "wasi:filesystem";
use { parse } from "./g4/parser.wado";
use { Grammar, merge_grammars, check_references, synthesize_implicit_tokens, normalize_caches } from "./ir.wado";
use { generate, GenerateOptions } from "./codegen.wado";
use { lower_with_ctx } from "./lower.wado";
use { collect_literal_tokens } from "./lexer_gen.wado";
use { GenContext } from "./gen_context.wado";
use { render_dump } from "./dump.wado";

export fn run() with Stdout, Stderr, Environment, Preopens {
    let arguments = args();

    if arguments.len() >= 2 && arguments[0] == "gen" {
        let mut paths: List<String> = [];
        let mut options = GenerateOptions { highlight: false, trace: false };
        for let mut i = 1; i < arguments.len(); i += 1 {
            if arguments[i] == "--highlight" {
                options.highlight = true;
            } else if arguments[i] == "--trace" {
                options.trace = true;
            } else {
                paths.push(arguments[i]);
            }
        }
        cmd_gen(paths, &options);
        return;
    }

    if arguments.len() >= 2 && arguments[0] == "dump" {
        let mut paths: List<String> = [];
        for let mut i = 1; i < arguments.len(); i += 1 {
            paths.push(arguments[i]);
        }
        cmd_dump(paths);
        return;
    }

    eprintln("Usage: gale gen [--highlight] [--trace] <grammar.g4> [grammar2.g4 ...]");
    eprintln("       gale dump <grammar.g4> [grammar2.g4 ...]");
}

fn cmd_gen(paths: List<String>, options: &GenerateOptions) with Stdout, Stderr, Preopens {
    let dirs = Preopens::get_directories();
    if dirs.len() == 0 {
        eprintln("gale: no preopened directories available (try without --no-dir)");
        return;
    }
    let root = dirs[0].0;

    let mut grammars: List<Grammar> = [];
    for let path of paths {
        let open_result = root.open_at(
            PathFlags::none(),
            path,
            OpenFlags::none(),
            DescriptorFlags::Read,
        ).wait();

        if let Err(_) = open_result {
            eprintln(`gale: {path}: cannot open file`);
            return;
        }
        let file = open_result.unwrap();

        let bytes = read_all(&file);
        let content = String::from_utf8_unchecked(bytes);

        let mut grammar = match parse(content) {
            Ok(g) => g,
            Err(e) => {
                eprintln(`gale: {path}: parse error: {e.message}`);
                return;
            },
        };
        // Record the source path on the grammar so gen_header can emit it as
        // provenance metadata (`#![generated(sources = [...])]`).
        grammar.source_files.push(path);
        grammars.push(grammar);
    }

    let mut merged = merge_grammars(grammars);
    // Must run before `check_references`. See `ir.wado` for rationale.
    synthesize_implicit_tokens(&mut merged);
    // Run ANTLR4-compatible semantic rule-reference validation after the
    // split-grammar halves are combined. This is the same check ANTLR4's
    // `SymbolChecks.checkForUnresolvedRuleRefs` performs; we defer it
    // until post-merge so cross-grammar refs (parser-grammar token refs
    // resolving against a sibling lexer grammar) validate cleanly.
    if let Err(e) = check_references(&merged) {
        eprintln(`gale: {e.message}`);
        return;
    }

    // Generate once and surface the prediction-strategy diagnostics the
    // single lowering raised. `generate` runs `normalize_caches` and lowers
    // internally (matching `cmd_dump`), so there is no separate diagnostic
    // pass to keep in sync. Warnings are advisory; generation still
    // proceeds and must succeed.
    let generated = generate(&mut merged, options);
    for let d of &generated.diagnostics {
        eprintln(`gale: warning: {d.rule}: {d.message}`);
    }

    print(generated.source);
}

fn cmd_dump(paths: List<String>) with Stdout, Stderr, Preopens {
    if paths.len() == 0 {
        eprintln("gale dump: no grammar files given");
        return;
    }
    let dirs = Preopens::get_directories();
    if dirs.len() == 0 {
        eprintln("gale: no preopened directories available (try without --no-dir)");
        return;
    }
    let root = dirs[0].0;

    let mut grammars: List<Grammar> = [];
    for let path of paths {
        let open_result = root.open_at(
            PathFlags::none(),
            path,
            OpenFlags::none(),
            DescriptorFlags::Read,
        ).wait();
        if let Err(_) = open_result {
            eprintln(`gale: {path}: cannot open file`);
            return;
        }
        let file = open_result.unwrap();
        let bytes = read_all(&file);
        let content = String::from_utf8_unchecked(bytes);
        let mut grammar = match parse(content) {
            Ok(g) => g,
            Err(e) => {
                eprintln(`gale: {path}: parse error: {e.message}`);
                return;
            },
        };
        grammar.source_files.push(path);
        grammars.push(grammar);
    }

    // Mirror cmd_gen's front-end so lowering sees a valid grammar:
    // merge the split halves, synthesize implicit tokens, then run the
    // ANTLR4-compatible reference check before lowering to GIR.
    let mut merged = merge_grammars(grammars);
    synthesize_implicit_tokens(&mut merged);
    if let Err(e) = check_references(&merged) {
        eprintln(`gale: {e.message}`);
        return;
    }

    // Lower to GIR and render the per-rule report derived from the
    // actual prediction decisions (not the raw surface IR).
    normalize_caches(&mut merged);
    let lit_tokens = collect_literal_tokens(&merged.parser_rules);
    // Lower through the same ctx render_dump renders with, so the
    // follow-variant registry (with K-prefix masks) is populated and the
    // dump reflects the literal ctx that lowered the grammar.
    let mut ctx = GenContext::new(&merged.parser_rules, &lit_tokens);
    let lowered = lower_with_ctx(&merged, &lit_tokens, &mut ctx);
    print(render_dump(&merged, &lowered, &mut ctx));
}

fn read_all(file: &Descriptor) -> List<u8> {
    let [read_stream, _done] = file.read_via_stream(0 as Filesize);
    let mut result: List<u8> = [];
    loop {
        let chunk = read_stream.read(4096);
        if chunk.len() == 0 {
            break;
        }
        for let b of chunk {
            result.push(b);
        }
    }
    read_stream.drop();
    return result;
}
