use { args, print, eprintln, exit, Stdout, Stderr, Environment, Exit } from "core:cli";
use { Deserialize } from "core:serde";
use { parse, ArgsError } from "core:args";
use { Preopens, Descriptor, Filesize, PathFlags, OpenFlags, DescriptorFlags, ErrorCode } from "wasi:filesystem";
use { assemble_grammar, AssembleError } from "./g4/parser.wado";
use { Grammar, normalize_caches, canonicalize_empty_alt_groups, unwrap_labeled_transparent_groups } from "./ir.wado";
use { generate, GenerateOptions } from "./codegen.wado";
use { parse_highlight_query, HighlightRule } from "./highlight_query.wado";
use { lower } from "./lower.wado";
use { collect_literal_tokens } from "./lexer_gen.wado";
use { GenContext } from "./gen_context.wado";
use { render_dump } from "./dump.wado";
use { build_atn, dump_atn } from "./atn.wado";

// CLI shape, parsed by `core:args` from the `Command` subcommand variant.
// `grammars` is an optional variadic positional so the "no grammar files given"
// check stays in `cmd_*` with its specific message; long options only (`-o` is
// dropped). `name_policy` lower-cases the wire tags (`gen` / `dump`).
struct GenArgs {
    trace: bool = false,
    output: Option<String> = null,
    #[wire(positional)]
    grammars: List<String> = [],
}
impl Deserialize for GenArgs;

struct DumpArgs {
    atn: bool = false,
    #[wire(positional)]
    grammars: List<String> = [],
}
impl Deserialize for DumpArgs;

#[wire(name_policy = "kebab-case")]
variant Command {
    Gen(GenArgs),
    Dump(DumpArgs),
}
impl Deserialize for Command;

export fn run() with Stdout, Stderr, Environment, Preopens, Exit {
    let argv = args();
    match parse::<Command>(argv) {
        Ok(Command::Gen(g)) => {
            cmd_gen(g.grammars, &g.output, g.trace);
        },
        Ok(Command::Dump(d)) => {
            cmd_dump(d.grammars, d.atn);
        },
        Err(e) => {
            // Prefix with the subcommand (`core:args` reports only kind/message;
            // the program name and `gen`/`dump` context are gale's to add).
            let ctx = if argv.len() == 0 {
                "gale";
            } else if argv[0] == "gen" {
                "gale gen";
            } else if argv[0] == "dump" {
                "gale dump";
            } else {
                "gale";
            };
            eprintln(`${ctx}: ${e.message}`);
            usage();
            exit(1);
        },
    }
}

fn usage() with Stderr {
    eprintln("Usage: gale gen [--trace] [--output <file>] <grammar.g4> [grammar2.g4 ...] [highlights.scm]");
    eprintln("       gale dump [--atn] <grammar.g4> [grammar2.g4 ...]");
}

fn cmd_gen(paths: List<String>, output: &Option<String>, trace: bool) with Stdout, Stderr, Preopens, Exit {
    // Route inputs by extension: `.scm` is a highlight query, everything else
    // is a `.g4` grammar half.
    let mut g4_paths: List<String> = [];
    let mut scm_paths: List<String> = [];
    for let p of &paths {
        if p.ends_with(".scm") {
            scm_paths.push(*p);
        } else {
            g4_paths.push(*p);
        }
    }
    if g4_paths.len() == 0 {
        eprintln("gale gen: no grammar files given");
        exit(1);
    }
    let mut merged = load_and_merge(&g4_paths);

    // Parse each `.scm` separately so an error names the file it came from.
    let mut highlight_query: Option<List<HighlightRule>> = null;
    if scm_paths.len() > 0 {
        let mut all_rules: List<HighlightRule> = [];
        for let p of &scm_paths {
            let src = read_source_file(p);
            match parse_highlight_query(&src) {
                Ok(rules) => {
                    for let r of rules {
                        all_rules.push(r);
                    }
                },
                Err(e) => {
                    eprintln(`gale: ${*p}: highlight query ${e.line}:${e.col}: ${e.message}`);
                    exit(1);
                },
            }
        }
        highlight_query = Option::Some(all_rules);
    }
    let options = GenerateOptions { highlight_query, trace };

    // Generate once and surface the prediction-strategy diagnostics the
    // single lowering raised. `generate` runs `normalize_caches` and lowers
    // internally (matching `cmd_dump`), so there is no separate diagnostic
    // pass to keep in sync. Warnings are advisory; generation still
    // proceeds and must succeed.
    let generated = generate(&mut merged, &options);
    for let d of &generated.diagnostics {
        eprintln(`gale: warning: ${d.rule}: ${d.message}`);
    }

    match *output {
        Some(path) => write_output(&path, &generated.source),
        None => print(generated.source),
    }
}

/// Write the generated parser source to `path`, inside the first granted
/// directory.
fn write_output(path: &String, source: &String) with Stderr, Preopens, Exit {
    let file = create_granted(path);
    let bytes: List<u8> = source.bytes().collect();
    let [rx, tx] = Stream::<u8>::new();
    let sub = file.write_via_stream(rx, 0 as Filesize);
    tx.write(bytes);
    tx.drop();
    // Await the completion future so a partial or failed write is reported
    // rather than silently treated as success.
    if let Some(Err(_)) = sub.read() {
        eprintln(`gale: ${*path}: write failed`);
        exit(1);
    }
    sub.drop();
}

fn cmd_dump(paths: List<String>, atn: bool) with Stdout, Stderr, Preopens, Exit {
    if paths.len() == 0 {
        eprintln("gale dump: no grammar files given");
        exit(1);
    }
    let mut merged = load_and_merge(&paths);

    // `dump` reports what the emitter sees, so it runs `generate`'s surface
    // normalizations too — otherwise it can report a shape no parser is
    // built from.
    canonicalize_empty_alt_groups(&mut merged);
    unwrap_labeled_transparent_groups(&mut merged);

    // `--atn` short-circuits the GIR dump: build the surface-IR ATN (the
    // data the runtime simulator walks) and print it.
    if atn {
        normalize_caches(&mut merged);
        let built = build_atn(&merged);
        print(dump_atn(&built, &merged));
        return;
    }

    // Lower to GIR and render the per-rule report derived from the
    // actual prediction decisions (not the raw surface IR).
    normalize_caches(&mut merged);
    let lit_tokens = collect_literal_tokens(&merged.parser_rules);
    // Lower through the same ctx render_dump renders with, so the
    // follow-mask registry is populated and the dump reflects the
    // literal ctx that lowered the grammar.
    let mut ctx = GenContext::new(&merged.parser_rules, &lit_tokens);
    let lowered = lower(&merged, &lit_tokens, &mut ctx);
    print(render_dump(&merged, &lowered, &mut ctx));
}

/// Shared CLI front end for `gen` and `dump`: read every grammar file,
/// parse, merge the split halves, synthesize implicit tokens, and run the
/// rule-reference check (deferred until post-merge so cross-grammar refs
/// resolve). Any failure prints a message and exits with code 1.
fn load_and_merge(paths: &List<String>) -> Grammar with Stdout, Stderr, Preopens, Exit {
    let mut inputs: List<[String, String]> = [];
    for let path of paths {
        let file = open_granted(path);
        let bytes = match read_all(&file) {
            Ok(b) => b,
            Err(_) => {
                eprintln(`gale: ${*path}: read error`);
                exit(1);
            },
        };
        let content = match String::from_utf8(bytes) {
            Ok(s) => s,
            Err(_) => {
                eprintln(`gale: ${*path}: not valid UTF-8`);
                exit(1);
            },
        };
        inputs.push([*path, content]);
    }

    return match assemble_grammar(&inputs) {
        Ok(g) => g,
        Err(Parse(pe)) => {
            eprintln(`gale: ${pe.0}: parse error: ${pe.1}`);
            exit(1);
        },
        Err(Check(msg)) => {
            eprintln(`gale: ${msg}`);
            exit(1);
        },
    };
}

/// Read one source file to a UTF-8 string from a granted directory. Any failure
/// prints a message and exits with code 1 (mirrors `load_and_merge`'s per-file
/// read).
fn read_source_file(path: &String) -> String with Stderr, Preopens, Exit {
    let file = open_granted(path);
    let bytes = match read_all(&file) {
        Ok(b) => b,
        Err(_) => {
            eprintln(`gale: ${*path}: read error`);
            exit(1);
        },
    };
    return match String::from_utf8(bytes) {
        Ok(s) => s,
        Err(_) => {
            eprintln(`gale: ${*path}: not valid UTF-8`);
            exit(1);
        },
    };
}

/// Open `path` for reading under a granted directory, or report why no grant
/// reaches it and exit with code 1.
///
/// A path is resolved inside a preopened directory, so what `--dir` grants is
/// all the program can reach. Reading may search every grant — the file either
/// sits under one or under none — and a failure distinguishes the reason it
/// found nothing rather than reading as "no such file".
fn open_granted(path: &String) -> Descriptor with Stderr, Preopens, Exit {
    let dirs = Preopens::get_directories();
    let mut grants: List<String> = [];
    let mut denied = false;
    for let mut i = 0; i < dirs.len(); i += 1 {
        let root = dirs[i].0;
        match root.open_at(PathFlags::none(), *path, OpenFlags::none(), DescriptorFlags::Read).wait() {
            Ok(file) => return file,
            Err(e) => {
                if !(e matches { NoEntry }) {
                    denied = true;
                }
            },
        }
        grants.push(dirs[i].1);
    }
    eprintln(`gale: ${*path}: cannot open file`);
    if grants.is_empty() {
        eprintln("gale: no directory was granted to this program (try without --no-dir)");
    } else if path.starts_with("/") {
        eprintln(
            `gale: a path opens inside a granted directory, so an absolute path never does: ${grant_hint(path)}`,
        );
    } else if denied {
        eprintln(`gale: not readable under ${grants.join(", ")}`);
    } else {
        eprintln(
            `gale: not found under ${grants.join(", ")} — check the path, or grant the directory holding it with wado run --dir <dir> ...`,
        );
    }
    exit(1);
}

/// Create `path` for writing under the first granted directory.
///
/// Reading may search every grant, but creating cannot: the file does not exist
/// yet, so a search would pick the output's directory by grant order. `--output`
/// resolves inside the first grant and nowhere else.
fn create_granted(path: &String) -> Descriptor with Stderr, Preopens, Exit {
    let dirs = Preopens::get_directories();
    if dirs.is_empty() {
        eprintln(`gale: ${*path}: cannot open for writing`);
        eprintln("gale: no directory was granted to this program (try without --no-dir)");
        exit(1);
    }
    let root = dirs[0].0;
    let opened = root.open_at(
        PathFlags::none(),
        *path,
        OpenFlags::Create | OpenFlags::Truncate,
        DescriptorFlags::Read | DescriptorFlags::Write,
    ).wait();
    if let Ok(file) = opened {
        return file;
    }
    eprintln(`gale: ${*path}: cannot open for writing`);
    if path.starts_with("/") {
        eprintln(
            `gale: a path opens inside a granted directory, so an absolute path never does: ${grant_hint(path)}`,
        );
    } else {
        eprintln(`gale: --output resolves inside ${dirs[0].1}, the first granted directory`);
    }
    exit(1);
}

/// The `wado run` invocation that would grant `path`'s own directory and name
/// the file relative to it.
fn grant_hint(path: &String) -> String {
    let cut = path.rfind("/").unwrap();
    let dir = if cut == 0 { "/" } else { path.substr_bytes(0, cut) };
    let name = path.substr_bytes(cut + 1, path.len());
    return `wado run --dir ${dir} ... ${name}`;
}

/// Read a file to EOF. The stream's completion future is consumed so a
/// mid-stream error surfaces as `Err` instead of being silently treated as
/// EOF (truncated input).
fn read_all(file: &Descriptor) -> Result<ByteList, ErrorCode> {
    let [read_stream, done] = file.read_via_stream(0 as Filesize);
    let mut result: ByteList = [];
    loop {
        let chunk = read_stream.read(4096);
        if chunk.len() == 0 {
            break;
        }
        for let b of chunk {
            result.push(b);
        }
    }
    read_stream.drop();
    let read_result = done.read();
    done.drop();
    if let Some(Err(e)) = read_result {
        return Result::Err(e);
    }
    return Result::Ok(result);
}
