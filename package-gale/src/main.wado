use { args, print, eprintln, exit, Stdout, Stderr, Environment, Exit } from "core:cli";
use { Deserialize } from "core:serde";
use { parse } from "core:args";
use { Preopens, Descriptor, Filesize, PathFlags, OpenFlags, DescriptorFlags } from "wasi:filesystem";
use { GenerateOptions, canonicalize_for_analysis, lower_for_analysis } from "./codegen.wado";
use { gen_source, load_and_merge, absolute_path_hint } from "./gen_source.wado";
use { AtnMode } from "./gen_settings.wado";
use { Level, set_log_level } from "core:log";
use { render_dump, render_atn_dump } from "./dump.wado";
use { render_lexer_dump } from "./lexer_dump.wado";

// CLI shape, parsed by `core:args` from the `Command` subcommand variant.
// `grammars` is an optional variadic positional so the "no grammar files given"
// check stays in `cmd_*` with its specific message; long options only.
// `name_policy` lower-cases the wire tags (`gen` / `dump`).
struct GenArgs {
    trace: bool = false,
    atn: AtnMode = AtnMode::Auto,
    log_level: Option<String> = null,
    output: Option<String> = null,
    /// Highlight query files, each named by its own `--highlights`.
    highlights: List<String> = [],
    #[wire(positional)]
    grammars: List<String> = [],
}
impl Deserialize for GenArgs;

struct DumpArgs {
    atn: bool = false,
    lexer: bool = false,
    log_level: Option<String> = null,
    #[wire(positional)]
    grammars: List<String> = [],
}
impl Deserialize for DumpArgs;

#[wire(name_policy = "kebab-case")]
variant Command {
    Gen(GenArgs),
    Dump(DumpArgs),
}
impl Deserialize for Command;

export fn run() with (Stdout, Stderr, Environment, Preopens, Exit) {
    if let Err(report) = gale() {
        eprintln(report);
        exit(1);
    }
}

/// Run the subcommand the arguments name. A failure is the report for stderr,
/// returned rather than printed so `run` is the one place that ends the process.
internal fn gale() -> Result<(), String> with (Stdout, Environment, Preopens) {
    let argv = args();
    return match parse::<Command>(argv) {
        Ok(Command::Gen(g)) => {
            apply_log_level(&g.log_level)?;
            cmd_gen(g.grammars, g.highlights, &g.output, GenerateOptions { trace: g.trace, atn: g.atn });
        },
        Ok(Command::Dump(d)) => {
            apply_log_level(&d.log_level)?;
            cmd_dump(d.grammars, d.atn, d.lexer);
        },
        // `core:args` reports only what is wrong; the program name and the
        // subcommand are gale's to add.
        Err(e) => Result::Err(`${command_name(&argv)}: ${e.message}\n${USAGE}`),
    };
}

fn command_name(argv: &List<String>) -> String {
    if argv.len() > 0 && (argv[0] == "gen" || argv[0] == "dump") {
        return `gale ${argv[0]}`;
    }
    return "gale";
}

global USAGE: String = "Usage: gale gen [--trace] [--atn <mode>] [--log-level <level>] [--output <file>] [--highlights <query.scm> ...] <grammar.g4> [grammar2.g4 ...]
       gale dump [--atn | --lexer] [--log-level <level>] <grammar.g4> [grammar2.g4 ...]
       <mode> is auto, always, never or verify (default auto)
       <level> is trace, debug, info, warn or error (default warn)";

/// Set the process-wide threshold (`core:log` tier 2) from `--log-level`,
/// defaulting to `Warn` so a hand-run build reports what a Kiln build reports.
///
/// Tier 1 is a ceiling this cannot raise; `wado compile -D log.level=trace`
/// moves that one.
fn apply_log_level(spec: &Option<String>) -> Result<(), String> {
    let Some(name) = *spec else {
        set_log_level(Level::Warn);
        return Result::Ok(());
    };
    let Ok(level) = Level::from_str_lenient(&name) else {
        return Result::Err(`gale: unknown --log-level '${name}' (trace, debug, info, warn, error)`);
    };
    set_log_level(level);
    return Result::Ok(());
}

fn cmd_gen(
    g4_paths: List<String>,
    scm_paths: List<String>,
    output: &Option<String>,
    options: GenerateOptions,
) -> Result<(), String> with (Stdout, Preopens) {
    let source = gen_source(g4_paths, scm_paths, options)?;
    match *output {
        Some(path) => write_output(&path, &source)?,
        None => print(source),
    }
    return Result::Ok(());
}

/// Write the generated parser source to `path`, inside the first granted
/// directory.
fn write_output<S: AsStrSlice, S1: AsStrSlice>(path: S, source: S1) -> Result<(), String> with Preopens {
    let file = create_granted(path)?;
    let bytes: List<u8> = source.bytes().collect();
    let [rx, tx] = Stream::<u8>::new();
    let sub = file.write_via_stream(rx, 0 as Filesize);
    tx.write_all(bytes);
    tx.drop();
    // Await the completion future so a partial or failed write is reported
    // rather than silently treated as success.
    if let Some(Err(_)) = sub.read() {
        return Result::Err(`gale: ${path}: write failed`);
    }
    return Result::Ok(());
}

fn cmd_dump(paths: List<String>, atn: bool, lexer: bool) -> Result<(), String> with (Stdout, Preopens) {
    if paths.is_empty() {
        return Result::Err("gale dump: no grammar files given");
    }
    if atn && lexer {
        return Result::Err("gale dump: --atn and --lexer are separate reports; pass one");
    }
    let mut merged = load_and_merge(&paths)?;

    // `--lexer` reports the lexer emit instead of the GIR dump: the GIR dump
    // covers the parser only, and lexer strategies are decided at emit time
    // from the surface IR, so it needs no lowering.
    if lexer {
        print(render_lexer_dump(&merged));
        return Result::Ok(());
    }

    // `dump` reports what the emitter sees, so it canonicalizes and stamps the
    // grammar through `generate`'s own prologue — otherwise it reports a shape
    // no parser is built from, and lowering re-derives per query what the
    // prologue answers once.
    let token_kinds = canonicalize_for_analysis(&mut merged);
    let num_tokens = token_kinds.len();

    // `render_dump` renders with the context that lowered the grammar, whose
    // actions are wired: lowering asks whether actions execute, so the report
    // is of the grammar a parser is built from rather than of one with its
    // predicates ignored.
    let [lowered, mut ctx] = lower_for_analysis(&mut merged, token_kinds);

    // `--atn` reports the ATN off that same lowering rather than the GIR.
    if atn {
        print(render_atn_dump(&merged, &lowered, num_tokens));
        return Result::Ok(());
    }
    print(render_dump(&merged, &lowered, &mut ctx));
    return Result::Ok(());
}

/// Create `path` for writing under the first granted directory.
///
/// Reading may search every grant, but creating cannot: the file does not exist
/// yet, so a search would let grant order pick the output directory.
fn create_granted<S: AsStrSlice>(path: S) -> Result<Descriptor, String> with Preopens {
    let mut dirs = Preopens::get_directories();
    assert !dirs.is_empty(), "cmd_gen read the grammars through a grant";
    let [root, grant] = dirs.remove(0);
    let opened = root.open_at(
        PathFlags::none(),
        path.to_string(),
        OpenFlags::Create | OpenFlags::Truncate,
        DescriptorFlags::Read | DescriptorFlags::Write,
    ).wait();
    if let Ok(file) = opened {
        return Result::Ok(file);
    }
    let why = if path.starts_with("/") {
        absolute_path_hint(path);
    } else {
        `gale: --output resolves inside ${grant}, the first granted directory`;
    };
    return Result::Err(`gale: ${path}: cannot open for writing\n${why}`);
}
