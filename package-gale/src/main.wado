use { args, print, eprintln, Stdout, Stderr, Environment } from "core:cli";
use { Preopens, Descriptor, Filesize, PathFlags, OpenFlags, DescriptorFlags } from "wasi:filesystem";
use { parse } from "./g4/parser.wado";
use { Grammar, merge_grammars } from "./ir.wado";
use { generate, GenerateOptions } from "./generator.wado";

export fn run() with Stdout, Stderr, Environment, Preopens {
    let arguments = args();

    if arguments.len() >= 2 && arguments[0] == "gen" {
        let mut paths: Array<String> = [];
        let mut options = GenerateOptions { highlight: false };
        for let mut i = 1; i < arguments.len(); i += 1 {
            if arguments[i] == "--highlight" {
                options.highlight = true;
            } else {
                paths.push(arguments[i]);
            }
        }
        cmd_gen(paths, &options);
        return;
    }

    eprintln("Usage: gale gen [--highlight] <grammar.g4> [grammar2.g4 ...]");
}

fn cmd_gen(paths: Array<String>, options: &GenerateOptions) with Stdout, Stderr, Preopens {
    let dirs = Preopens::get_directories();
    if dirs.len() == 0 {
        eprintln("gale: no preopened directories available (try without --no-dir)");
        return;
    }
    let root = dirs[0].0;

    let mut grammars: Array<Grammar> = [];
    for let path of paths {
        let open_result = root.open_at(
            PathFlags::none(),
            path,
            OpenFlags::none(),
            DescriptorFlags::Read,
        );

        if let Err(_) = open_result {
            eprintln(`gale: {path}: cannot open file`);
            return;
        }
        let file = open_result.unwrap();

        let bytes = read_all(&file);
        let content = String::from_utf8_unchecked(bytes);

        let mut grammar = match parse(content) {
            Ok(g) => g,
            Err(e) => {
                eprintln(`gale: {path}: parse error: {e.message}`);
                return;
            },
        };
        // Record the source path on the grammar so gen_header can emit it as
        // provenance metadata (`#![generated(sources = [...])]`).
        grammar.source_files.push(path);
        grammars.push(grammar);
    }

    let merged = merge_grammars(grammars);
    print(generate(&merged, options));
}

fn read_all(file: &Descriptor) -> Array<u8> {
    let [read_stream, _done] = file.read_via_stream(0 as Filesize);
    let mut result: Array<u8> = [];
    loop {
        let chunk = read_stream.read(4096);
        if chunk.len() == 0 {
            break;
        }
        for let b of chunk {
            result.push(b);
        }
    }
    read_stream.drop();
    return result;
}
