use {
    translate_wado_action,
    rule_value_channel_ready,
    rule_returns_vals,
    rule_is_left_recursive,
    rule_threads_args,
    vals_struct_name,
    wado_type_default,
} from "./action_translate.wado";
use { parse } from "./g4/parser.wado";

global NO_BINDINGS: List<[bool, String, String]> = [];

test "translate rewrites value-channel refs to vals fields" {
    let g = parse("grammar T;
r returns [i32 v] : ID { $v = 1; } ;
").unwrap();
    let rule = &g.parser_rules[0];
    let out = translate_wado_action(rule, &g.parser_rules, &" $v = 1; ", true, &NO_BINDINGS).unwrap();
    assert out == " vals.v = 1; ", `out: '{out}'`;
}

test "translate rewrites a cross-rule $a.v to a child binding" {
    let g = parse("grammar T;
r : a=e { print($a.v); } ;
e returns [i32 v] : ID ;
").unwrap();
    let out = translate_wado_action(&g.parser_rules[0], &g.parser_rules, &" print($a.v); ", false, &NO_BINDINGS).unwrap();
    assert out == " print(a.v); ", `out: '{out}'`;
}

test "translate rewrites a token label member to the context API" {
    let g = parse("grammar T;
r : x=ID { print($x.text); } ;
").unwrap();
    let out = translate_wado_action(&g.parser_rules[0], &g.parser_rules, &" print($x.text); ", false, &NO_BINDINGS).unwrap();
    assert out == " print(p.token_text(x)); ", `out: '{out}'`;
}

test "translate rewrites token members to the context API" {
    let g = parse("grammar T;
r : x=NUM { print($x.int + $x.line + $x.pos + $x.type + $x.index); } ;
NUM : [0-9]+ ;
").unwrap();
    let out = translate_wado_action(
        &g.parser_rules[0],
        &g.parser_rules,
        &" print($x.int + $x.line + $x.pos + $x.type + $x.index); ",
        false,
        &NO_BINDINGS,
    ).unwrap();
    assert out == " print(p.token_int(x) + p.token_line(x) + p.token_col(x) + p.token_kind(x) + x); ", `out: '{out}'`;
}

test "translate rewrites $text / $start / $stop to the captured rule span" {
    let g = parse("grammar T;
r : NUM { print($text); print($start.int); print($stop.line); } ;
NUM : [0-9]+ ;
").unwrap();
    let out = translate_wado_action(
        &g.parser_rules[0],
        &g.parser_rules,
        &" print($text); print($start.int); print($stop.line); ",
        false,
        &NO_BINDINGS,
    ).unwrap();
    assert out == " print(p.text_span(p.token_start(_rule_start_tok), p.last_end())); print(p.token_int(_rule_start_tok)); print(p.token_line((p.pos - 1))); ", `out: '{out}'`;
}

test "translate rejects a value-channel ref with no vals in scope" {
    let g = parse("grammar T;
r returns [i32 v] : ID { $v = 1; } ;
").unwrap();
    let res = translate_wado_action(&g.parser_rules[0], &g.parser_rules, &" $v = 1; ", false, &NO_BINDINGS);
    assert res.is_err(), "$v needs vals in scope";
}

test "translate camelCase label uses the snake_case binding" {
    let g = parse("grammar T;
r : myTok=ID { print($myTok.text); } ;
ID : [a-z]+ ;
").unwrap();
    let out = translate_wado_action(&g.parser_rules[0], &g.parser_rules, &" print($myTok.text); ", false, &NO_BINDINGS).unwrap();
    assert out == " print(p.token_text(my_tok)); ", `out: '{out}'`;
}

test "translate rejects a cross-rule member when the child has no channel" {
    let g = parse("grammar T;
r : a=e { print($a.v); } ;
e : A | B ;
").unwrap();
    let res = translate_wado_action(&g.parser_rules[0], &g.parser_rules, &" print($a.v); ", false, &NO_BINDINGS);
    assert res.is_err(), "cross-rule member on a channel-less child must be an error";
}

test "translate rejects a value-channel field with a non-Wado type" {
    let g = parse("grammar T;
r returns [int v] : ID { $v = 1; } ;
").unwrap();
    let res = translate_wado_action(&g.parser_rules[0], &g.parser_rules, &" $v = 1; ", true, &NO_BINDINGS);
    assert res.is_err(), "non-Wado field type must be an error, not an uncompilable struct";
}

test "translate threads a single-alt rule argument through the value channel" {
    let g = parse("grammar T;
r[i32 n] : ID { $n = 2; } ;
").unwrap();
    let out = translate_wado_action(&g.parser_rules[0], &g.parser_rules, &" $n = 2; ", true, &NO_BINDINGS).unwrap();
    assert out == " vals.n = 2; ", `out: '{out}'`;
}

test "translate threads a multi-alt rule argument through the value channel" {
    let g = parse("grammar T;
r[i32 n] : A { $n = 1; } | B { $n = 2; } ;
").unwrap();
    let out = translate_wado_action(&g.parser_rules[0], &g.parser_rules, &" $n = 1; ", true, &NO_BINDINGS).unwrap();
    assert out == " vals.n = 1; ", `out: '{out}'`;
}

test "translate rejects a rule argument on a left-recursive rule" {
    let g = parse("grammar T;
e[i32 n] : e '+' e | INT { $n = 1; } ;
").unwrap();
    let res = translate_wado_action(&g.parser_rules[0], &g.parser_rules, &" $n = 1; ", false, &NO_BINDINGS);
    assert res.is_err(), "LR rule args are not threaded yet";
}

test "value channel readiness and return-vals detection" {
    let g = parse("grammar T;
r returns [i32 v] : ID { $v = 1; } ;
multi returns [i32 v] : ID | INT ;
plain : ID ;
").unwrap();
    assert rule_value_channel_ready(&g.parser_rules[0]), "r declares a defaultable channel";
    assert rule_returns_vals(&g.parser_rules[0]), "single-alt r returns vals";
    assert rule_returns_vals(&g.parser_rules[1]), "multi-alt non-LR rule returns vals";
    assert !rule_value_channel_ready(&g.parser_rules[2]), "plain has no channel";
    assert vals_struct_name(&g.parser_rules[0]) == "RVals", `name: {vals_struct_name(&g.parser_rules[0])}`;
}

test "left-recursive rules expose the value channel (threaded through the loop)" {
    let g = parse("grammar T;
e returns [i32 v] : e '+' e | INT ;
").unwrap();
    assert rule_value_channel_ready(&g.parser_rules[0]), "e declares a defaultable channel";
    assert rule_is_left_recursive(&g.parser_rules[0]), "e is left-recursive";
    assert rule_returns_vals(&g.parser_rules[0]), "LR rule value channel is threaded";
    assert !rule_threads_args(&g.parser_rules[0]), "LR rule args stay deferred";
}

test "translate maps $ctx.toStringTree to the render call and absorbs the call syntax" {
    let g = parse("grammar T;
s @after { p.emit($ctx.toStringTree()); } : e EOF ;
e : ID ;
").unwrap();
    let rule = &g.parser_rules[0];
    // Empty parens.
    let a = translate_wado_action(rule, &g.parser_rules, &" p.emit($ctx.toStringTree()); ", false, &NO_BINDINGS).unwrap();
    assert a == " p.emit(p.rule_string_tree()); ", `a: '{a}'`;
    // ANTLR / java2wado idiom `toStringTree(this)` — the `(this)` argument is absorbed.
    let b = translate_wado_action(rule, &g.parser_rules, &" p.emit($ctx.toStringTree(this)); ", false, &NO_BINDINGS).unwrap();
    assert b == " p.emit(p.rule_string_tree()); ", `b: '{b}'`;
    // Bare reference (no parens) still emits a complete call.
    let c = translate_wado_action(rule, &g.parser_rules, &" let t = $ctx.toStringTree; print(t); ", false, &NO_BINDINGS).unwrap();
    assert c == " let t = p.rule_string_tree(); print(t); ", `c: '{c}'`;
}

test "translate maps $ctx.toStringTree in a left-recursive rule to the final-node render" {
    let g = parse("grammar T;
e @after { p.emit($ctx.toStringTree()); } : e '+' e | INT ;
").unwrap();
    let out = translate_wado_action(&g.parser_rules[0], &g.parser_rules, &" p.emit($ctx.toStringTree()); ", false, &NO_BINDINGS).unwrap();
    assert out == " p.emit(p.rule_string_tree_final()); ", `out: '{out}'`;
}

test "wado_type_default covers the corpus surface" {
    assert wado_type_default(&"i32") matches { Some(_) };
    assert wado_type_default(&"bool") matches { Some(_) };
    assert wado_type_default(&"String") matches { Some(_) };
    assert wado_type_default(&"List<String>") matches { Some(_) };
    assert wado_type_default(&"SomeUserType") matches { None }, "unknown type has no default";
}
