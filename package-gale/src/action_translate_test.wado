use {
    translate_wado_action,
    rule_value_channel_ready,
    rule_returns_vals,
    vals_struct_name,
    wado_type_default,
} from "./action_translate.wado";
use { parse } from "./g4/parser.wado";

test "translate rewrites value-channel refs to vals fields" {
    let g = parse("grammar T;
r returns [i32 v] : ID { $v = 1; } ;
").unwrap();
    let rule = &g.parser_rules[0];
    let out = translate_wado_action(rule, &g.parser_rules, &" $v = 1; ", true).unwrap();
    assert out == " vals.v = 1; ", `out: '{out}'`;
}

test "translate rewrites a cross-rule $a.v to a child binding" {
    let g = parse("grammar T;
r : a=e { print($a.v); } ;
e returns [i32 v] : ID ;
").unwrap();
    let out = translate_wado_action(&g.parser_rules[0], &g.parser_rules, &" print($a.v); ", false).unwrap();
    assert out == " print(a.v); ", `out: '{out}'`;
}

test "translate rewrites a token label member to the context API" {
    let g = parse("grammar T;
r : x=ID { print($x.text); } ;
").unwrap();
    let out = translate_wado_action(&g.parser_rules[0], &g.parser_rules, &" print($x.text); ", false).unwrap();
    assert out == " print(p.token_text(x)); ", `out: '{out}'`;
}

test "translate rejects unsupported token members" {
    let g = parse("grammar T;
r : x=ID { print($x.line); } ;
").unwrap();
    let res = translate_wado_action(&g.parser_rules[0], &g.parser_rules, &" print($x.line); ", false);
    assert res.is_err(), "$x.line not yet emitted";
}

test "translate rejects a value-channel ref with no vals in scope" {
    let g = parse("grammar T;
r returns [i32 v] : ID { $v = 1; } ;
").unwrap();
    let res = translate_wado_action(&g.parser_rules[0], &g.parser_rules, &" $v = 1; ", false);
    assert res.is_err(), "$v needs vals in scope";
}

test "translate camelCase label uses the snake_case binding" {
    let g = parse("grammar T;
r : myTok=ID { print($myTok.text); } ;
ID : [a-z]+ ;
").unwrap();
    let out = translate_wado_action(&g.parser_rules[0], &g.parser_rules, &" print($myTok.text); ", false).unwrap();
    assert out == " print(p.token_text(my_tok)); ", `out: '{out}'`;
}

test "translate rejects a cross-rule member when the child returns no vals" {
    let g = parse("grammar T;
r : a=e { print($a.v); } ;
e returns [i32 v] : A | B ;
").unwrap();
    let res = translate_wado_action(&g.parser_rules[0], &g.parser_rules, &" print($a.v); ", false);
    assert res.is_err(), "cross-rule member on a non-vals child must be an error";
}

test "translate rejects a value-channel field with a non-Wado type" {
    let g = parse("grammar T;
r returns [int v] : ID { $v = 1; } ;
").unwrap();
    let res = translate_wado_action(&g.parser_rules[0], &g.parser_rules, &" $v = 1; ", true);
    assert res.is_err(), "non-Wado field type must be an error, not an uncompilable struct";
}

test "translate rejects rule-argument refs (not yet threaded)" {
    let g = parse("grammar T;
r[i32 n] : ID { $n = 2; } ;
").unwrap();
    let res = translate_wado_action(&g.parser_rules[0], &g.parser_rules, &" $n = 2; ", true);
    assert res.is_err(), "arg ref must be unsupported for now";
}

test "value channel readiness and return-vals detection" {
    let g = parse("grammar T;
r returns [i32 v] : ID { $v = 1; } ;
multi returns [i32 v] : ID | INT ;
plain : ID ;
").unwrap();
    assert rule_value_channel_ready(&g.parser_rules[0]), "r declares a defaultable channel";
    assert rule_returns_vals(&g.parser_rules[0]), "single-alt r returns vals";
    assert !rule_returns_vals(&g.parser_rules[1]), "multi-alt rule does not return vals yet";
    assert !rule_value_channel_ready(&g.parser_rules[2]), "plain has no channel";
    assert vals_struct_name(&g.parser_rules[0]) == "RVals", `name: {vals_struct_name(&g.parser_rules[0])}`;
}

test "wado_type_default covers the corpus surface" {
    assert wado_type_default(&"i32") matches { Some(_) };
    assert wado_type_default(&"bool") matches { Some(_) };
    assert wado_type_default(&"String") matches { Some(_) };
    assert wado_type_default(&"List<String>") matches { Some(_) };
    assert wado_type_default(&"SomeUserType") matches { None }, "unknown type has no default";
}
