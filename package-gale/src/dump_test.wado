//! Tests for `render_dump(Grammar, LoweredGrammar, GenContext) -> String`.
//!
//! Most tests build a minimal `Grammar` via struct-literal syntax (no
//! g4 parser), lower it, and assert on substrings of the rendered
//! report. The point is the report's MECE structure, not exact byte
//! layout — substring checks keep the tests robust to spacing. A few
//! tests that need LR shapes (awkward to hand-build) go through the
//! g4 front-end via `dump_source`.

use {
    Grammar,
    GrammarKind,
    ParserRule,
    Alternative,
    Element,
    RuleRefElement,
    TokenRefElement,
    Visibility,
    merge_grammars,
    synthesize_implicit_tokens,
} from "./ir.wado";
use { LitToken, collect_literal_tokens } from "./lexer_gen.wado";
use { lower } from "./lower.wado";
use { LoweredGrammar } from "./gir.wado";
use { GenContext } from "./gen_context.wado";
use { canonicalize_for_analysis, analysis_context, install_action_context, lower_for_analysis } from "./codegen.wado";
use { render_dump, render_atn_dump } from "./dump.wado";
use { parse } from "./g4/parser.wado";

/// Run the full front-end (parse → merge → synth → lower) and render,
/// through the very functions `cmd_dump` calls. Used by tests whose grammar
/// shape (left recursion) is impractical to hand-build.
///
/// The pipeline is `generate`'s, not a copy of it: the dump's whole claim is
/// that it reports what the emitter emits, and lowering asks `ctx` for FOLLOW
/// and for scannability. A hand-rolled prologue that skips either answers them
/// by re-deriving them per query, which on `RustParser.g4` cost three orders
/// of magnitude over generating the whole parser.
fn dump_pipeline<S: AsStrSlice>(input: S) -> [String, GenContext] {
    let mut merged = merge_grammars([parse(input.to_string()).unwrap()]);
    synthesize_implicit_tokens(&mut merged);
    let [lowered, mut ctx] = lower_pipeline(&mut merged);
    return [render_dump(&merged, &lowered, &mut ctx), ctx];
}

/// `cmd_dump`'s prologue, whole. The step this used to leave out —
/// `install_action_context` — is the one `lower_for_analysis` now asserts,
/// which is how the omission stopped being invisible.
fn lower_pipeline(merged: &mut Grammar) -> [LoweredGrammar, GenContext] {
    let token_kinds = canonicalize_for_analysis(merged);
    let lit = collect_literal_tokens(&merged.parser_rules);
    let mut ctx = analysis_context(merged, &lit, token_kinds);
    let _ = install_action_context(merged, &mut ctx);
    return [lower_for_analysis(merged, &lit, &mut ctx), ctx];
}

fn dump_source<S: AsStrSlice>(input: S) -> String {
    return dump_pipeline(input).0;
}

test "the dump lowers through the emitter's primed context" {
    let [_, ctx] = dump_pipeline("grammar G; a : B c ; c : C ; B : 'b' ; C : 'c' ;");
    assert ctx.rule_follow_is_exact(), "the dump must install FOLLOW before lowering, as `generate` does";
}

// `--atn` reports the same grammar the GIR dump does, so it reports the same
// lowering. Re-lowering it through `build_atn`'s fresh context instead reaches
// a table that knows none of the stamped ids.
test "the ATN dump builds off the lowering the dump already has" {
    let mut merged = merge_grammars([parse("grammar G; a : B c ; c : C ; B : 'b' ; C : 'c' ;").unwrap()]);
    synthesize_implicit_tokens(&mut merged);
    let [lowered, _] = lower_pipeline(&mut merged);
    let report = render_atn_dump(&merged, &lowered);
    assert report.contains("rule 0 'a'"), report;
    assert report.contains("rule 1 'c'"), report;
}

/// Render a hand-built `Grammar` as is. Not `cmd_dump`'s pipeline —
/// canonicalization would rewrite the very shape these tests assert on — so
/// what it pins is the report's structure, not the emitter's agreement with it.
/// `dump_pipeline` is the one that mirrors the command.
fn dump_grammar(g: &Grammar) -> String {
    let lit_tokens = no_lit_tokens();
    let mut ctx = GenContext::new(&g.parser_rules, &lit_tokens);
    let lowered = lower(g, &lit_tokens, &mut ctx);
    return render_dump(g, &lowered, &mut ctx);
}

fn empty_grammar<S: AsStrSlice>(name: S) -> Grammar {
    return Grammar {
        name: name.to_string(),
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
}

fn no_lit_tokens() -> List<LitToken> {
    return [];
}

fn alt_of(elements: List<Element>) -> Alternative {
    return Alternative {
        label: null,
        options: [],
        elements,
    };
}

test "render_dump shows simple rule name and shape" {
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "value",
            Visibility::Default,
            [],
            [alt_of([Element::TokenRef(TokenRefElement::new("INT"))])],
        ),
    ];

    let report = dump_grammar(&g);

    assert report.contains("value"), report;
    assert report.contains("Simple"), report;
    // No diagnostics: the summary reports none.
    assert report.contains("warnings: none"), report;
}

test "render_dump shows Direct dispatch for disjoint multi-alt" {
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [
                alt_of([Element::TokenRef(TokenRefElement::new("INT"))]),
                alt_of([Element::TokenRef(TokenRefElement::new("STRING"))]),
            ],
        ),
    ];

    let report = dump_grammar(&g);

    assert report.contains("expr"), report;
    assert report.contains("Direct"), report;
    // Each disjoint alt's first set appears.
    assert report.contains("TK_INT"), report;
    assert report.contains("TK_STRING"), report;
    assert report.contains("warnings: none"), report;
}

test "render_dump shows Tournament and overlap warning" {
    // `r : ID INT | ID STRING ;` — both alts start with ID, so lowering
    // resolves the overlap with a scan tournament and raises an
    // OverlapTournament diagnostic.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::TokenRef(TokenRefElement::new("INT")),
                ]),
                alt_of([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::TokenRef(TokenRefElement::new("STRING")),
                ]),
            ],
        ),
    ];

    let report = dump_grammar(&g);

    assert report.contains("Tournament"), report;
    // The diagnostic is inlined on the rule and listed in the summary.
    assert report.contains("warning"), report;
    // The diagnostic names the rule and the shared lookahead token.
    assert report.contains("'r'"), report;
    assert report.contains("TK_ID"), report;
    // Summary shows a non-empty warnings section.
    assert report.contains("warnings ("), report;
}

test "render_dump shows prediction tree for overlap group" {
    // `r : ID INT | ID STRING ;` — both alts start with ID, so the
    // overlap group runs the prediction tree: a depth-0 Consume on
    // TK_ID followed by a depth-1 Dispatch keyed on TK_INT / TK_STRING.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::TokenRef(TokenRefElement::new("INT")),
                ]),
                alt_of([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::TokenRef(TokenRefElement::new("STRING")),
                ]),
            ],
        ),
    ];

    let report = dump_grammar(&g);

    // The overlap-group prediction tree is rendered as its own section.
    assert report.contains("prediction"), report;
    // The Consume on the shared ID prefix is named.
    assert report.contains("Consume"), report;
    // The disambiguating Dispatch at depth 1 surfaces both branch
    // tokens and Leaf alt indices.
    assert report.contains("Dispatch"), report;
    assert report.contains("Leaf"), report;
    assert report.contains("TK_INT"), report;
    assert report.contains("TK_STRING"), report;
}

test "render_dump shows prediction tree for LR atom overlap" {
    // `expr : ID INT | ID STRING | expr '+' expr ;` — atom alts share
    // TK_ID; LR's atom dispatch therefore goes through the same
    // overlap-group prediction tree as a plain multi-alt rule.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::TokenRef(TokenRefElement::new("INT")),
                ]),
                alt_of([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::TokenRef(TokenRefElement::new("STRING")),
                ]),
                alt_of([
                    Element::RuleRef(RuleRefElement::new("expr")),
                    Element::TokenRef(TokenRefElement::new("PLUS")),
                    Element::RuleRef(RuleRefElement::new("expr")),
                ]),
            ],
        ),
    ];

    let report = dump_grammar(&g);

    assert report.contains("LeftRecursive"), report;
    assert report.contains("prediction"), report;
    assert report.contains("Consume"), report;
    assert report.contains("TK_INT"), report;
    assert report.contains("TK_STRING"), report;
}

test "render_dump annotates an Ambiguous leaf with its halt reason" {
    // `r : expr SEMI | expr DOT ; expr : ID | ID PLUS ID ;`
    //
    // Both alts of `r` start with the multi-token rule `expr`, so the
    // disambiguating SEMI / DOT sits behind a shared sub-rule the static
    // simulator cannot expand — an opaque-rule-ref halt. `expr` itself is
    // an at-end-vs-branch conflict: `ID` returns while `ID PLUS ID`
    // continues. The dump must name *why* each Ambiguous leaf appeared,
    // not just that it did.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::RuleRef(RuleRefElement::new("expr")),
                    Element::TokenRef(TokenRefElement::new("SEMI")),
                ]),
                alt_of([
                    Element::RuleRef(RuleRefElement::new("expr")),
                    Element::TokenRef(TokenRefElement::new("DOT")),
                ]),
            ],
        ),
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [
                alt_of([Element::TokenRef(TokenRefElement::new("ID"))]),
                alt_of([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::TokenRef(TokenRefElement::new("PLUS")),
                    Element::TokenRef(TokenRefElement::new("ID")),
                ]),
            ],
        ),
    ];

    let report = dump_grammar(&g);

    // The Ambiguous leaf still lists its alts ...
    assert report.contains("Ambiguous(["), report;
    // ... and now carries a halt reason after the em dash.
    assert report.contains("Ambiguous([alt 0, alt 1]) — "), report;
    // `r`'s shared `expr` prefix is an opaque-rule-ref halt.
    assert report.contains("opaque rule-ref prefix"), report;
    // `expr`'s `ID` vs `ID PLUS ID` is an at-end-vs-branch conflict.
    assert report.contains("at-end vs branch conflict"), report;
}

test "render_dump inlines a group-scoped diagnostic under its owning rule" {
    // The overlap lives in a nested group, not in `r`'s own alternatives, so
    // the diagnostic's owner is the group. It still belongs to `r` and must
    // appear in `r`'s section — the owner carries the rule name, which no
    // amount of substring-matching on a `General group rGroup0` label
    // recovers.
    let g = "grammar G;
r : (ID INT | ID STR) ;
ID : 'a' ;
INT : '1' ;
STR : '\"' ;";
    let report = dump_source(&g);

    let head = section_of(&report, "r");
    assert head.contains("warning: overlap-tournament"), report;
    assert head.contains("TK_ID"), report;
    // And it is still listed once in the summary, under the group's label.
    assert report.contains("General group rGroup0:"), report;
}

/// The `rule <name>` section of a dump report: from its header line to the
/// next rule header or the trailing summary, whichever comes first. A per-rule
/// assertion run against this cannot pass on text belonging to another rule or
/// to the summary, which repeats every diagnostic.
///
/// The header is matched whole (`rule r — Simple`, never a prefix of
/// `rule r2 — …`) and the summary opens with `warnings`, which is what bounds
/// the last rule's section.
fn section_of<S: AsStrSlice, S1: AsStrSlice>(report: S, rule_name: S1) -> String {
    let header = `rule ${rule_name} — `;
    let mut out = String::new();
    let mut inside = false;
    for let line of report.split("\n") {
        if line.starts_with("rule ") {
            inside = line.starts_with(header);
        } else if line.starts_with("warnings") {
            inside = false;
        }
        if inside {
            out.push_str(&line);
            out.push('\n');
        }
    }
    assert !out.is_empty(), `no '${header}' section in:\n${report}`;
    return out;
}

test "section_of isolates one rule from its neighbours and the summary" {
    // `r2` must not be swallowed by a `r` lookup, and the summary — which
    // repeats every diagnostic — must not leak into the last rule's section.
    let g = "grammar G;
r : (ID INT | ID STR) ;
r2 : ID ;
ID : 'a' ;
INT : '1' ;
STR : '\"' ;";
    let report = dump_source(&g);

    let r = section_of(&report, "r");
    assert r.contains("rule r — "), r;
    assert !r.contains("rule r2 — "), r;
    assert !r.contains("warnings ("), r;

    // The last rule's section still stops before the summary.
    let r2 = section_of(&report, "r2");
    assert r2.contains("rule r2 — "), r2;
    assert !r2.contains("warnings ("), r2;
    // ... which is where the group-scoped diagnostic is also listed.
    assert report.contains("General group rGroup0:"), report;
}

test "render_dump keeps an at-end alt out of an expanded opaque dispatch" {
    // `e : a | b | X ;` over `a : X Y ; b : X Z ;` — alts 0 and 1 enter
    // multi-token rules the opaque expansion can separate on the second
    // token, while alt 2 is complete after `X`. Dispatching on that second
    // token would drop alt 2: what follows it belongs to `e`'s caller, so
    // no branch at this depth can claim it — the halt is an at-end conflict,
    // exactly as it is when no opaque rule ref is in the way.
    let g = "grammar O;
e : a | b | X ;
a : X Y ;
b : X Z ;
X : 'X' ;
Y : 'Y' ;
Z : 'Z' ;";
    let report = dump_source(&g);

    assert report.contains("Ambiguous([alt 2, alt 0, alt 1]) — at-end vs branch conflict"), report;
    assert !report.contains("Leaf(alt "), report;
}

test "render_dump offers an open-ended alt on a token it does not name" {
    // `A? . C` admits every token through its `.`, so `b` is its token too:
    // the second token separates it from `B D` and `B E`, and only there is
    // `[TK_C]` a branch.
    let g = "grammar W;
r : A? . C | B D | B E ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
D : 'd' ;
E : 'e' ;";
    let r = section_of(&dump_source(&g), "r");

    assert r.contains("overlap group [alt 0, alt 1, alt 2]"), r;
    assert r.contains("Dispatch[d=1]"), r;
    assert r.contains("[TK_C] →"), r;
    assert r.contains("Leaf(alt 1)"), r;
    assert r.contains("Leaf(alt 2)"), r;
}

test "render_dump shows LR loop-entry dispatch with conflict-min" {
    // `e : e '.' ID | e '.' ID '(' ')' | ID ;` — both LR suffixes start
    // with '.', so the precedence loop's entry decision is NOT token-led:
    // it falls back to precedence + second-token disambiguation. The dump
    // must surface each alt's conflict-min and flag the overlapping
    // loop-entry group (the "drop loop entry branch" ATN-class territory).
    let g = "grammar L;
e : e '.' ID | e '.' ID '(' ')' | ID ;
ID : [a-z]+ ;";
    let report = dump_source(&g);

    // Per-LR-alt precedence loop-entry bound.
    assert report.contains("conflict-min="), report;
    // The loop-entry section itself.
    assert report.contains("loop-entry:"), report;
    // Both '.'-led suffixes land in one overlap group, flagged as
    // precedence-disambiguated (not token-led).
    assert report.contains("overlapping suffix first-sets"), report;
}

test "render_dump renders a multi-token tail-greedy repeat rule" {
    // `prog : item X Y ; item : (X Y)* ;` — `item`'s tail repeat has a
    // multi-token inner `(X Y)`. Under the runtime-FOLLOW redesign the
    // follow repair is no longer a per-(rule, mask) `__follow_<id>`
    // variant baked into the dump; the caller threads a `FOLLOW_MASK`
    // at runtime and `item`'s loop gates on it via `follow_yields`. The
    // dump therefore no longer prints a `follow-variants:` section — it
    // just renders the rules. (A per-call-site FollowArg dump view is a
    // possible follow-up.)
    let g = "grammar K;
prog : item X Y ;
item : (X Y)* ;
X : 'x' ;
Y : 'y' ;";
    let report = dump_source(&g);

    assert report.contains("prog"), report;
    assert report.contains("item"), report;
    // The retired variant section must NOT appear.
    assert !report.contains("follow-variants:"), report;
}

test "render_dump keeps a lossy repeat-body entry off the common-terminal path" {
    // Entering `('x' 'y' | 'x' 'z')?` yields one config per body alternative,
    // all carrying the same grammar alt index, so `sll_dedup_by_alt` keeps
    // only `'x' 'y'` and the walk claims `'y'` as a terminal every alt shares.
    // `'x' 'z'` is a valid prefix of both alts, so no such terminal exists.
    let g = "grammar D;
a : ('x' 'y' | 'x' 'z')? 'p'
  | ('x' 'y' | 'x' 'z')? 'q'
  ;";
    let report = dump_source(&g);

    assert !report.contains("Consume(TK_LIT_y)"), report;
}

test "render_dump walks a multi-token repeat body reached through an opaque rule-ref" {
    // `p` sees `t` and `q` as opaque rule-refs and expands them. Inside `t`
    // the walk used to step past `(ID '::')*` as one token, so `ID` at depth
    // 1 was claimed for `t` and `'::'` for `q` alone — committing `a matches`
    // to `t` and `a :: b` to `q`. Neither token separates the alts here.
    let g = "grammar R;
p : t | q ;
t : (ID '::')* ID '`' ;
q : ID ('::' ID)* ;
ID : [a-z]+ ;";
    let p = section_of(&dump_source(&g), "p");

    assert !p.contains("Leaf(alt 0)"), p;
    assert !p.contains("Leaf(alt 1)"), p;
    assert p.contains("Ambiguous([alt 0, alt 1]) — opaque rule-ref prefix"), p;
}
