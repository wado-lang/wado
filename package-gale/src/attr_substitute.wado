//! Attribute substitution: rewrite the `$`-reference spans in an action /
//! predicate body to Wado expressions.
//!
//! The engine is a pure span splicer. The decision of *what* each reference
//! becomes — a value-channel field (`$v` → `vals.v`), a context-API call
//! (`$x.text` → `p.token_text(...)`), a special (`$text` →
//! `p.rule_text()`) — belongs to codegen, which knows the runtime bindings
//! in scope. Codegen resolves each `ResolvedAttr` (from `attr_resolve`) to
//! its replacement string and hands the parallel list here; the engine
//! stitches the surrounding host text (already Wado under the identity
//! translator) around the replacements. Keeping the splice separate from
//! the expression mapping keeps both trivially testable.

use { ResolvedAttr } from "./attr_resolve.wado";

/// Rewrite `body`, replacing each `ResolvedAttr`'s `[start, end)` byte span
/// with the corresponding entry in `replacements`. `refs` must be in
/// ascending, non-overlapping span order (as `attr_resolve` produces them)
/// and the same length as `replacements`.
pub fn splice_attrs<S: AsStrSlice>(body: S, refs: &List<ResolvedAttr>, replacements: &List<String>) -> String
    contract refs.len() == replacements.len(), "one replacement per attribute reference"
{
    let src = body.as_str_slice();
    let n = src.len();
    let mut out = String::with_capacity(n);
    let mut cursor = 0;
    for let mut i = 0; i < refs.len(); i += 1 {
        let r = &refs[i];
        assert r.start >= cursor, "splice_attrs: refs must be ascending and non-overlapping";
        assert r.end <= n, "splice_attrs: ref span exceeds body";
        out.push_str(src.slice(cursor, r.start));
        out.push_str(&replacements[i]);
        cursor = r.end;
    }
    out.push_str(src.slice(cursor, n));
    return out;
}
