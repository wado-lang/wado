//! The token-set tables a generated parser declares once and names from its
//! rule bodies: `_kind_set_<id>` helpers, `SYNC_<id>` / `EXPECTED_<id>`
//! recovery sets and `FOLLOW_SITE_<id>` continuation sites. Lowering interns
//! the sites, emit the rest; ids are first-seen order, so the same grammar
//! always produces the same names.

use { HashMap } from "core:collections";
use { FOLLOW_MAX_DEPTH } from "./runtime/follow.wado";
use { Reading } from "./readings.wado";

/// A token-kind set interned during parser codegen. Multi-element
/// `<expr> matches { TK_X | TK_Y | ... }` checks are emitted as
/// `_kind_set_<id>(<expr>)`; the body is shared via a single
/// helper function emitted at the end of the parser section.
pub struct KindSetEntry {
    pub id: i32,
    /// Canonical (name-sorted, unique) token list, as kind ids. Emitted as the
    /// `TK_*` global names via `GrammarAnalysis::token_name` at codegen.
    pub tokens: List<i32>,
}

/// How many tokens deep a continuation site reads: as deep as the runtime gate.
pub global FOLLOW_SITE_DEPTH: i32 = FOLLOW_MAX_DEPTH;

/// The interned tables, each keyed by its canonical (`canonical_ids`) form.
pub struct TableRegistry {
    kind_sets: HashMap<List<i32>, KindSetEntry>,
    sync_sets: HashMap<List<i32>, KindSetEntry>,
    /// The id of each interned continuation site.
    follow_site_ids: HashMap<List<Reading>, i32>,
    /// The continuation sites, indexed by id: the readings of the rest of a
    /// rule past a call. Each is emitted once, as a row of `FOLLOW_TABLES`
    /// that `FOLLOW_SITE_<id>` names, so the generated parser grows with the
    /// distinct continuations rather than with the call graph.
    follow_sites: List<List<Reading>>,
}

impl TableRegistry {
    /// No table interned.
    pub fn new() -> TableRegistry {
        return TableRegistry {
            kind_sets: HashMap::new(),
            sync_sets: HashMap::new(),
            follow_site_ids: HashMap::new(),
            follow_sites: [],
        };
    }

    /// Intern a canonical token-kind set; the same set maps to a single `id`.
    pub fn intern_kind_set(&mut self, ids: List<i32>) -> i32 {
        if let Some(entry) = self.kind_sets.get(ids) {
            return entry.id;
        }
        let id = self.kind_sets.len();
        self.kind_sets[ids] = KindSetEntry { id, tokens: ids };
        return id;
    }

    /// All interned kind sets in helper-ID order (i.e. insertion order).
    /// Consumed by `gen_kind_set_helpers` to emit the helper functions.
    pub fn kind_sets(&self) -> List<KindSetEntry> {
        return self.kind_sets.values().iter_value().collect();
    }

    /// Intern a canonical recovery sync set (a leaf's FIRST-of-rest). Returns
    /// the `SYNC_<id>` global's id, or `null` for an empty set (the caller
    /// passes `&EMPTY_SYNC`).
    pub fn intern_sync_set(&mut self, ids: List<i32>) -> Option<i32> {
        if ids.is_empty() {
            return null;
        }
        if let Some(entry) = self.sync_sets.get(ids) {
            return Option::<i32>::Some(entry.id);
        }
        let id = self.sync_sets.len();
        self.sync_sets[ids] = KindSetEntry { id, tokens: ids };
        return Option::<i32>::Some(id);
    }

    /// The interned sync sets, in id order.
    pub fn sync_sets(&self) -> List<KindSetEntry> {
        return self.sync_sets.values().iter_value().collect();
    }

    /// Intern a continuation site given in canonical form: every position's
    /// kinds `canonical_ids`, the readings in `readings_add` order.
    pub fn intern_follow_site(&mut self, readings: List<Reading>) -> i32 {
        if let Some(id) = self.follow_site_ids.get(readings) {
            return id;
        }
        let id = self.follow_sites.len();
        self.follow_site_ids[readings] = id;
        self.follow_sites.push(readings);
        return id;
    }

    /// The interned continuation sites, indexed by id.
    pub fn follow_sites(&self) -> &List<List<Reading>> {
        return &self.follow_sites;
    }
}

/// The `SYNC_<id>` global: interned sync set `id` as membership bits.
pub fn sync_bits_name(id: i32) -> String {
    return `SYNC_${id}`;
}

/// The `EXPECTED_<id>` global: interned sync set `id` as the kinds a diagnostic names.
pub fn sync_list_name(id: i32) -> String {
    return `EXPECTED_${id}`;
}

/// The `FOLLOW_SITE_<id>` global.
pub fn follow_site_name(id: i32) -> String {
    return `FOLLOW_SITE_${id}`;
}

/// The `_kind_set_<id>` membership helper.
pub fn kind_set_fn_name(id: i32) -> String {
    return `_kind_set_${id}`;
}
