use { translate_wado_members } from "./wado_members.wado";
use { is_lexer_members, is_parser_members } from "./ir.wado";
use { NamedAction, ActionSource, GrammarKind } from "./ir.wado";

fn member_act(scope: Option<String>) -> NamedAction {
    return NamedAction { scope, name: "members", body: ActionSource {} };
}

test "translate_wado_members parses a defaulted field" {
    let m = translate_wado_members("count: i32 = 0").unwrap();
    assert m.fields.len() == 1, `fields: ${m.fields.len()}`;
    assert m.fields[0].name == "count";
    assert m.fields[0].ty == "i32";
    assert m.fields[0].init == "0";
    assert m.methods.is_empty();
}

test "translate_wado_members parses several fields and a method" {
    let src = "depth: i32 = 0; tag: String = \"\";\nfn deeper(&mut self) { self.depth += 1; }";
    let m = translate_wado_members(&src).unwrap();
    assert m.fields.len() == 2, `fields: ${m.fields.len()}`;
    assert m.fields[0].name == "depth";
    assert m.fields[1].name == "tag";
    assert m.fields[1].ty == "String";
    assert m.methods.len() == 1, `methods: ${m.methods.len()}`;
    assert m.methods[0].source.contains("fn deeper(&mut self)");
    assert m.methods[0].source.contains("self.depth += 1;");
}

test "translate_wado_members handles a generic field type" {
    let m = translate_wado_members("seen: List<i32> = []").unwrap();
    assert m.fields.len() == 1;
    assert m.fields[0].ty == "List<i32>", `ty: ${m.fields[0].ty}`;
    assert m.fields[0].init == "[]";
}

test "translate_wado_members rejects a field with no initializer" {
    assert translate_wado_members("count: i32") matches { Err(_) };
}

test "translate_wado_members keeps fields after a comparison-operator initializer" {
    let m = translate_wado_members("ok: bool = 1 < 2; count: i32 = 0").unwrap();
    assert m.fields.len() == 2, `fields: ${m.fields.len()}`;
    assert m.fields[0].name == "ok";
    assert m.fields[0].init == "1 < 2", `init: '${m.fields[0].init}'`;
    assert m.fields[1].name == "count";
    assert m.fields[1].init == "0";
}

test "translate_wado_members captures a method with a struct-literal default arg" {
    let m = translate_wado_members("fn reset(p: Pos = Pos { x: 0 }) { return p.x; }").unwrap();
    assert m.fields.is_empty(), `fields: ${m.fields.len()}`;
    assert m.methods.len() == 1, `methods: ${m.methods.len()}`;
    assert m.methods[0].source.contains("Pos { x: 0 }"), `method: '${m.methods[0].source}'`;
    assert m.methods[0].source.contains("return p.x;"), `method: '${m.methods[0].source}'`;
}

test "is_lexer_members claims explicit lexer scope in any grammar" {
    let act = member_act(Option::<String>::Some("lexer"));
    assert is_lexer_members(&act, &GrammarKind::Combined);
    assert !is_parser_members(&act, &GrammarKind::Combined);
}

test "bare @members is the parser's in a combined grammar, the lexer's in a lexer grammar" {
    let act = member_act(null);
    assert is_parser_members(&act, &GrammarKind::Combined);
    assert !is_lexer_members(&act, &GrammarKind::Combined);
    assert is_lexer_members(&act, &GrammarKind::Lexer);
    assert !is_parser_members(&act, &GrammarKind::Lexer);
}

test "translate_wado_members reads `pub` members and each method's receiver" {
    let m = translate_wado_members("pub count: i32 = 0; pub fn get(&self) -> i32 { return self.count; }").unwrap();
    assert m.fields.len() == 1 && m.fields[0].name == "count", `fields: ${m.fields.len()}`;
    assert m.methods.len() == 1 && m.methods[0].name == "get" && !m.methods[0].mutates, `methods: ${m.methods.len()}`;
    assert m.methods[0].source == "pub fn get(&self) -> i32 { return self.count; }", m.methods[0].source;
}

test "translate_wado_members steps over comments and strings holding delimiters" {
    let src = "// a `}` in a comment is not code
calls: i32 = 0;
/* \"a;b\" */ tag: String = \"a;\\\"}\";
fn bump(&mut self) {
    // }
    self.calls += 1; /* } */
}";
    let m = translate_wado_members(&src).unwrap();
    assert m.fields.len() == 2, `fields: ${m.fields.len()}`;
    assert m.fields[1].name == "tag" && m.fields[1].init == "\"a;\\\"}\"", `tag init: '${m.fields[1].init}'`;
    assert m.methods.len() == 1 && m.methods[0].name == "bump" && m.methods[0].mutates, `methods: ${m.methods.len()}`;
    assert m.methods[0].source.ends_with("/* } */\n}"), m.methods[0].source;
}
