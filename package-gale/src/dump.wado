//! `gale dump` rendering — a readable, per-rule report derived from
//! the lowered grammar (GIR), i.e. the actual prediction decisions
//! parser emission consumes.
//!
//! The output is plain text and stable across runs: every collection
//! is iterated in its stored (deterministic) order. Each rule appears
//! once, with non-overlapping sections (shape, alts, prediction tree,
//! repeats, diagnostics). The trailing summary lists
//! every diagnostic — including the group-scoped ones whose label
//! carries no quoted rule name and so are not inlined under a rule
//! (see `render_rule_diagnostics`; a structured owner id would let
//! them inline, tracked in TODO.md).
//!
//! GIR carries the lowered shape decisions (Direct vs Tournament,
//! repeat strategy, per-call-site FOLLOW args). The prediction-tree section is
//! re-built from the surface grammar + `GenContext` so it mirrors the
//! same `build_prediction` call the parser emitter performs — that
//! tree is computed at emit time, not stored on GIR, so reproducing
//! it here keeps the dump faithful to "what emit sees".

use {
    LoweredGrammar,
    Diagnostic,
    DiagnosticKind,
    Rule,
    RuleHeader,
    SimpleRule,
    MultiAltRule,
    LeftRecursiveRule,
    LrAlt,
    AltBody,
    Op,
    RepeatOp,
    RepeatStrategy,
    GroupOp,
    GroupShape,
    MultiAltDispatch,
    DirectDispatch,
    TournamentDispatch,
    rule_header,
} from "./gir.wado";
use { Grammar, ParserRule, Alternative, Element, RepeatKind } from "./ir.wado";
use { GenContext } from "./gen_context.wado";
use {
    PredictionNode,
    PredictionDispatch,
    PredictionBranch,
    ConsumeNode,
    AmbiguousNode,
    AmbiguityReason,
    build_prediction,
} from "./prediction.wado";
use {
    compute_overlap_groups,
    sort_group_by_specificity,
    sort_group_by_element_count,
} from "./alt_grouping.wado";
use { literal_const_name } from "./gen_util.wado";

/// Render the full per-rule dump report for a lowered grammar.
///
/// The surface `Grammar` and `GenContext` are required so the dump
/// can re-build the same `PredictionNode` trees the parser emitter
/// computes in `gen_multi_alt_body_bt` (parser_gen.wado). Without
/// them the per-overlap-group prediction section is unavailable;
/// the rest of the report would still render from GIR alone.
pub fn render_dump(grammar: &Grammar, lowered: &LoweredGrammar, ctx: &mut GenContext) -> String {
    // Pre-size: ~256 bytes of header / per-rule scaffolding plus a
    // generous per-alt allowance keeps the bulk of `push_str` calls
    // off the `String::grow` doubling path for typical grammars.
    let estimated = 256 + 512 * lowered.parser_rules.len();
    let mut out = String::with_capacity(estimated);

    out.push_str(&"grammar ");
    out.push_str(&lowered.name);
    out.push('\n');
    out.push('\n');

    for let rule of &lowered.parser_rules {
        render_rule(&mut out, rule, grammar, lowered, ctx);
        out.push('\n');
    }

    render_summary(&mut out, lowered);
    return out;
}

fn render_rule(out: &mut String, rule: &Rule, grammar: &Grammar, lowered: &LoweredGrammar, ctx: &mut GenContext) {
    let header = rule_header(rule);

    out.push_str(&"rule ");
    out.push_str(&header.name);
    out.push_str(&" — ");
    out.push_str(&rule_shape_label(rule));
    out.push('\n');

    match rule {
        Simple(s) => render_simple(out, s),
        MultiAlt(m) => render_multi_alt(out, m),
        LeftRecursive(l) => render_left_recursive(out, l),
    }

    render_prediction(out, rule, grammar, ctx);
    render_repeats(out, rule);
    render_rule_diagnostics(out, &header.name, lowered);
}

/// One-line shape label for a rule's header.
fn rule_shape_label(rule: &Rule) -> String {
    return match rule {
        Simple(_) => "Simple",
        MultiAlt(m) => match m.dispatch {
            Direct(_) => "MultiAlt: Direct",
            Tournament(_) => "MultiAlt: Tournament",
        },
        LeftRecursive(_) => "LeftRecursive",
    };
}

fn render_simple(out: &mut String, s: &SimpleRule) {
    // Simple rules carry a single body; the per-alt breakdown is
    // covered by the repeats section below. Nothing alt-shaped to list.
    out.push_str(&"  single alternative\n");
}

fn render_multi_alt(out: &mut String, m: &MultiAltRule) {
    match m.dispatch {
        Direct(d) => {
            out.push_str(&"  dispatch: Direct (token-led)\n");
            for let branch of &d.branches {
                out.push_str(&"  alt ");
                out.push_str(&`{branch.alt_index}`);
                out.push_str(&" first=");
                push_token_set(out, &branch.tokens);
                out.push('\n');
            }
        },
        Tournament(t) => {
            out.push_str(&"  dispatch: Tournament (longest-match scan)\n");
            for let mut i = 0; i < t.alts.len(); i += 1 {
                out.push_str(&"  alt ");
                out.push_str(&`{t.alts[i]}`);
                out.push_str(&" (tournament order ");
                out.push_str(&`{i}`);
                out.push_str(&")\n");
            }
        },
    }
}

fn render_left_recursive(out: &mut String, l: &LeftRecursiveRule) {
    // Atom alts: the non-LR alternatives, lowered as a multi-alt body.
    out.push_str(&"  atom alts:\n");
    match l.atom.dispatch {
        Direct(d) => {
            for let branch of &d.branches {
                out.push_str(&"    alt ");
                out.push_str(&`{branch.alt_index}`);
                out.push_str(&" first=");
                push_token_set(out, &branch.tokens);
                out.push('\n');
            }
        },
        Tournament(t) => {
            for let mut i = 0; i < t.alts.len(); i += 1 {
                out.push_str(&"    alt ");
                out.push_str(&`{t.alts[i]}`);
                out.push_str(&" (tournament order ");
                out.push_str(&`{i}`);
                out.push_str(&")\n");
            }
        },
    }

    // LR alts: each carries precedence and associativity.
    out.push_str(&"  lr alts:\n");
    for let lr of &l.lr_alts {
        out.push_str(&"    alt ");
        out.push_str(&`{lr.alt_index}`);
        out.push_str(&" (");
        out.push_str(&lr.case_name);
        out.push_str(&") prec=");
        out.push_str(&`{lr.own_prec}`);
        out.push_str(&" conflict-min=");
        out.push_str(&`{lr.conflict_min}`);
        out.push(' ');
        if lr.right_associative {
            out.push_str(&"right-assoc");
        } else {
            out.push_str(&"left-assoc");
        }
        out.push_str(&" suffix-first=");
        push_token_set(out, &lr.suffix_first);
        out.push('\n');
    }

    render_lr_loop_entry(out, l);
}

/// Render the LR precedence loop's entry decision: for each token the
/// loop could consume next, which LR suffix it enters. Each `lr_dispatch`
/// group lists the LR alts whose suffix first-sets overlap; a group with
/// ≥2 members is where the loop-entry choice is *not* token-led and
/// falls back to precedence (`conflict-min`) plus second-token
/// disambiguation — the "drop loop entry branch" decision that goes
/// ATN-class when precedence alone cannot separate the alts
/// (`DropLoopEntryBranchInLRRule_4`). Mirrors `LrDispatchData` exactly,
/// so a wrong precedence chain cross-references straight back here.
fn render_lr_loop_entry(out: &mut String, l: &LeftRecursiveRule) {
    let d = &l.lr_dispatch;
    if d.valid_lr_alts.is_empty() {
        return;
    }
    out.push_str(&"  loop-entry:\n");
    for let group of &d.groups {
        out.push_str(&"    group [");
        for let mut i = 0; i < group.len(); i += 1 {
            if i > 0 {
                out.push_str(&", ");
            }
            // group entries index into valid_lr_alts, which indexes lr_alts.
            let lr = &l.lr_alts[d.valid_lr_alts[group[i]]];
            out.push_str(&`alt {lr.alt_index} `);
            push_token_set(out, &lr.suffix_first);
        }
        out.push(']');
        if group.len() >= 2 {
            out.push_str(&" — overlapping suffix first-sets: precedence-disambiguated loop entry");
        }
        out.push('\n');
    }
}


// ==========================================================================
// Prediction tree
// ==========================================================================

/// Mirror `gen_parse_fn_named` (parser_gen.wado): collect the rule's
/// non-LR alt indices, compute their FIRST sets, partition into
/// overlap groups, and for each multi-alt group sort by specificity
/// + element count and run `build_prediction`. Each resulting tree
/// is rendered inline under the rule.
fn render_prediction(out: &mut String, rule: &Rule, grammar: &Grammar, ctx: &mut GenContext) {
    let header = rule_header(rule);
    let surface = find_parser_rule(grammar, &header.name);
    let surface = match surface {
        Some(r) => r,
        None => return,
    };

    let mut non_lr_indices: List<i32> = [];
    match rule {
        Simple(_) => return,
        MultiAlt(m) => {
            for let alt of &m.alts {
                non_lr_indices.push(alt.alt_index);
            }
        },
        LeftRecursive(l) => {
            for let alt of &l.atom.alts {
                non_lr_indices.push(alt.alt_index);
            }
        },
    }
    if non_lr_indices.len() < 2 {
        return;
    }

    let mut first_sets: List<List<String>> = [];
    for let idx of &non_lr_indices {
        let mut visiting: List<String> = [];
        first_sets.push(ctx.first_of_alt(&surface.alternatives[*idx], &mut visiting));
    }
    let mut groups = compute_overlap_groups(&first_sets);

    let mut printed_header = false;
    for let mut g = 0; g < groups.len(); g += 1 {
        let group = &groups[g];
        if group.len() < 2 {
            continue;
        }
        let mut sorted_group = group.sorted();
        sort_group_by_specificity(&mut sorted_group, &first_sets);
        let mut mapped_alts: List<Alternative> = [];
        for let gi of &sorted_group {
            mapped_alts.push(surface.alternatives[non_lr_indices[*gi]]);
        }
        let mut local_indices: List<i32> = [];
        for let mut i = 0; i < sorted_group.len(); i += 1 {
            local_indices.push(i);
        }
        sort_group_by_element_count(&mut local_indices, &mapped_alts);
        let mut reordered: List<i32> = [];
        for let li of &local_indices {
            reordered.push(sorted_group[*li]);
        }

        let mut pred_indices: List<i32> = [];
        let mut pred_elements: List<List<Element>> = [];
        let mut real_indices: List<i32> = [];
        for let mut k = 0; k < reordered.len(); k += 1 {
            let real_idx = non_lr_indices[reordered[k]];
            pred_indices.push(real_idx);
            pred_elements.push(surface.alternatives[real_idx].elements);
            real_indices.push(real_idx);
        }
        let tree = build_prediction(&pred_indices, &pred_elements, 5, ctx);

        if !printed_header {
            out.push_str(&"  prediction:\n");
            printed_header = true;
        }
        out.push_str(&"    overlap group [");
        for let mut i = 0; i < real_indices.len(); i += 1 {
            if i > 0 {
                out.push_str(&", ");
            }
            out.push_str(&`alt {real_indices[i]}`);
        }
        out.push_str(&"]:\n");
        render_prediction_node(out, &tree, 6);
    }
}

fn render_prediction_node(out: &mut String, node: &PredictionNode, indent: i32) {
    push_spaces(out, indent);
    match node {
        Leaf(idx) => {
            out.push_str(&`Leaf(alt {*idx})\n`);
        },
        Ambiguous(a) => {
            out.push_str(&"Ambiguous([");
            for let mut i = 0; i < a.alts.len(); i += 1 {
                if i > 0 {
                    out.push_str(&", ");
                }
                out.push_str(&`alt {a.alts[i]}`);
            }
            out.push_str(&"]) — ");
            out.push_str(&ambiguity_reason_label(&a.reason));
            out.push('\n');
        },
        Consume(c) => {
            out.push_str(&"Consume(");
            out.push_str(&prediction_element_label(&c.element));
            out.push_str(&")\n");
            render_prediction_node(out, &c.child, indent + 2);
        },
        Dispatch(d) => {
            out.push_str(&`Dispatch[d={d.depth}]\n`);
            for let branch of &d.branches {
                push_spaces(out, indent + 2);
                push_token_set(out, &branch.tokens);
                out.push_str(&" →\n");
                render_prediction_node(out, &branch.child, indent + 4);
            }
        },
    }
}

/// Short label for a `Consume`d element. Only `TokenRef` / `Literal`
/// can appear here because `sll_find_common_terminal` only returns
/// those shapes, but the match is exhaustive for safety.
fn prediction_element_label(elem: &Element) -> String {
    return match elem {
        TokenRef(t) => `TK_{t.name}`,
        Literal(l) => literal_const_name(&l.text),
        _ => "?",
    };
}

/// Human-readable halt reason for an `Ambiguous` leaf — why static
/// prediction could not isolate one alt here. Cross-references the
/// `AmbiguityReason` doc comments in prediction.wado.
fn ambiguity_reason_label(reason: &AmbiguityReason) -> String {
    return match *reason {
        MaxDepth => "lookahead exhausted (k=5): needs unbounded lookahead",
        ConfigExplosion => "config-set explosion (>200)",
        OpaqueRuleRef => "opaque rule-ref prefix: shared sub-rule hides the disambiguating tokens",
        AtEndConflict => "at-end vs branch conflict: an alt returns while another continues (adaptive prediction)",
        MultiAtEnd => "multiple alts end together: true ambiguity",
        NoViableAlt => "no viable alt",
    };
}

fn find_parser_rule(grammar: &Grammar, name: &String) -> Option<ParserRule> {
    for let r of &grammar.parser_rules {
        if r.name == *name {
            return Option::<ParserRule>::Some(*r);
        }
    }
    return null;
}

fn push_spaces(out: &mut String, n: i32) {
    for let mut i = 0; i < n; i += 1 {
        out.push(' ');
    }
}

// ==========================================================================
// Repeat strategies
// ==========================================================================

/// Walk every alt body in the rule and report each Repeat's strategy.
/// Recurses into Group alts and Repeat bodies so nested repeats are
/// surfaced too.
fn render_repeats(out: &mut String, rule: &Rule) {
    let mut lines: List<String> = [];
    match rule {
        Simple(s) => collect_repeats_in_alt(&s.body, &mut lines),
        MultiAlt(m) => {
            for let alt of &m.alts {
                collect_repeats_in_alt(alt, &mut lines);
            }
        },
        LeftRecursive(l) => {
            for let alt of &l.atom.alts {
                collect_repeats_in_alt(alt, &mut lines);
            }
            for let lr of &l.lr_alts {
                collect_repeats_in_alt(&lr.suffix, &mut lines);
            }
        },
    }

    if lines.is_empty() {
        return;
    }
    out.push_str(&"  repeats:\n");
    for let line of &lines {
        out.push_str(&"    ");
        out.push_str(line);
        out.push('\n');
    }
}

fn collect_repeats_in_alt(alt: &AltBody, lines: &mut List<String>) {
    for let op of &alt.ops {
        collect_repeats_in_op(op, lines);
    }
}

fn collect_repeats_in_op(op: &Op, lines: &mut List<String>) {
    match op {
        Repeat(rep) => {
            lines.push(repeat_line(rep));
            // Recurse into the repeat body for nested repeats.
            collect_repeats_in_op(&rep.body, lines);
        },
        Group(g) => {
            for let alt of &g.alts {
                collect_repeats_in_alt(alt, lines);
            }
        },
        ListLabel(ll) => collect_repeats_in_op(&ll.inner, lines),
        Token(_) => {
        },
        Literal(_) => {
        },
        RuleCall(_) => {
        },
        Wildcard(_) => {
        },
        Excluded(_) => {
        },
    }
}

fn repeat_line(rep: &RepeatOp) -> String {
    let kind = repeat_kind_label(&rep.kind);
    let strategy = repeat_strategy_label(&rep.strategy);
    return `{kind} → {strategy}`;
}

fn repeat_kind_label(kind: &RepeatKind) -> String {
    return match *kind {
        Star => "*",
        Plus => "+",
        Optional => "?",
    };
}

fn repeat_strategy_label(strategy: &RepeatStrategy) -> String {
    return match strategy {
        Plain => "Plain",
        NonGreedy(_) => "NonGreedy",
        OptionalLookahead(_) => "OptionalLookahead",
        OptionalShapeLookahead(_) => "OptionalShapeLookahead",
        OptionalScanGuard => "OptionalScanGuard",
    };
}

// ==========================================================================
// Diagnostics
// ==========================================================================

/// Inline any diagnostics whose `rule` label refers to this rule. The
/// diagnostic's `rule` is a human label like `rule 'r'` / `LR rule
/// 'expr' atom`, so match by the quoted rule name. Group-scoped labels
/// (`General group rGroup0`, `SimpleCst group`) carry no quoted name and
/// so never match here — they surface in the summary only. A structured
/// owner id on `Diagnostic` would let them inline (TODO.md).
fn render_rule_diagnostics(out: &mut String, rule_name: &String, lowered: &LoweredGrammar) {
    let needle = `'{*rule_name}'`;
    for let d of &lowered.diagnostics {
        if !contains(&d.rule, &needle) {
            continue;
        }
        out.push_str(&"  ! warning: ");
        out.push_str(&diagnostic_kind_label(&d.kind));
        out.push_str(&": ");
        out.push_str(&d.message);
        out.push('\n');
    }
}

fn diagnostic_kind_label(kind: &DiagnosticKind) -> String {
    return match *kind { OverlapTournament => "overlap-tournament" };
}

fn render_summary(out: &mut String, lowered: &LoweredGrammar) {
    if lowered.diagnostics.is_empty() {
        out.push_str(&"warnings: none\n");
        return;
    }
    out.push_str(&"warnings (");
    out.push_str(&`{lowered.diagnostics.len()}`);
    out.push_str(&"):\n");
    for let d of &lowered.diagnostics {
        out.push_str(&"  ");
        out.push_str(&d.rule);
        out.push_str(&": ");
        out.push_str(&d.message);
        out.push('\n');
    }
}

// ==========================================================================
// Small helpers
// ==========================================================================

/// Render a token-kind set as `[A, B, C]`.
fn push_token_set(out: &mut String, tokens: &List<String>) {
    out.push('[');
    for let mut i = 0; i < tokens.len(); i += 1 {
        if i > 0 {
            out.push_str(&", ");
        }
        out.push_str(&tokens[i]);
    }
    out.push(']');
}

/// Substring test (no dependency on the test-only `str_contains`).
fn contains(haystack: &String, needle: &String) -> bool {
    let h_len = haystack.len();
    let n_len = needle.len();
    if n_len == 0 {
        return true;
    }
    if n_len > h_len {
        return false;
    }
    for let mut i = 0; i <= h_len - n_len; i += 1 {
        let mut found = true;
        for let mut j = 0; j < n_len; j += 1 {
            if haystack.get_byte_unchecked(i + j) != needle.get_byte_unchecked(j) {
                found = false;
                break;
            }
        }
        if found {
            return true;
        }
    }
    return false;
}
