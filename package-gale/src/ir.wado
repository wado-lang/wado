/// Grammar is the top-level IR representing a parsed .g4 file.
pub struct Grammar {
    pub name: String,
    pub parser_rules: Array<ParserRule>,
    pub lexer_rules: Array<LexerRule>,
}

/// ParserRule represents a parser rule (lowercase name in .g4).
pub struct ParserRule {
    pub name: String,
    pub alternatives: Array<Alternative>,
}

/// Alternative is one branch of a parser rule, optionally labeled.
pub struct Alternative {
    pub label: Option<String>,
    pub elements: Array<Element>,
}

/// Element is a single unit within an alternative.
pub variant Element {
    RuleRef(String),
    TokenRef(String),
    Literal(String),
    Group(Array<Alternative>),
    Repeat(RepeatElement),
    Label(LabelElement),
}

pub struct RepeatElement {
    pub kind: RepeatKind,
    pub element: Element,
    pub non_greedy: bool,
}

pub struct LabelElement {
    pub name: String,
    pub element: Element,
}

/// RepeatKind indicates the repetition type.
pub enum RepeatKind {
    Star,
    Plus,
    Optional,
}

/// LexerRule represents a lexer rule (uppercase name in .g4).
pub struct LexerRule {
    pub name: String,
    pub is_fragment: bool,
    pub skip: bool,
    pub mode: String,
    pub push_mode: Option<String>,
    pub pop_mode: bool,
    pub body: Array<LexerAlt>,
}

impl LexerRule {
    pub fn new(name: String, is_fragment: bool, skip: bool, body: Array<LexerAlt>) -> LexerRule {
        return LexerRule { name, is_fragment, skip, mode: "DEFAULT_MODE", push_mode: null, pop_mode: false, body };
    }
}

/// LexerAlt is one alternative in a lexer rule.
pub struct LexerAlt {
    pub elements: Array<LexerElement>,
}

/// LexerElement is a single unit within a lexer alternative.
pub variant LexerElement {
    Literal(String),
    CharRange([char, char]),
    CharClass(CharClass),
    AnyChar,
    RuleRef(String),
    Group(Array<LexerAlt>),
    Repeat(LexerRepeatElement),
    Not(LexerNotElement),
}

pub struct LexerRepeatElement {
    pub kind: RepeatKind,
    pub element: LexerElement,
    pub non_greedy: bool,
}

pub struct LexerNotElement {
    pub element: LexerElement,
}

/// CharClass represents a character class like [a-zA-Z0-9].
pub struct CharClass {
    pub ranges: Array<CharRange>,
    pub negated: bool,
}

/// CharRange is a single range within a character class.
pub struct CharRange {
    pub start: char,
    pub end: char,
}

impl CharRange {
    pub fn single(c: char) -> CharRange {
        return CharRange { start: c, end: c };
    }

    pub fn range(start: char, end: char) -> CharRange {
        return CharRange { start, end };
    }
}

pub fn merge_grammars(grammars: Array<Grammar>) -> Grammar {
    if grammars.len() == 1 {
        return grammars[0];
    }
    let mut name = grammars[0].name;
    let mut parser_rules: Array<ParserRule> = [];
    let mut lexer_rules: Array<LexerRule> = [];
    for let g of grammars {
        for let r of g.parser_rules {
            parser_rules.push(r);
        }
        for let r of g.lexer_rules {
            lexer_rules.push(r);
        }
    }
    // Derive common name by stripping Lexer/Parser suffix
    if name.len() > 5 {
        let chars: Array<char> = name.chars().collect();
        let len = chars.len();
        if len >= 6 {
            let mut suffix = String::with_capacity(6);
            for let mut i = len - 6; i < len; i += 1 {
                suffix.push(chars[i]);
            }
            if suffix == "Parser" {
                let mut base = String::with_capacity(len - 6);
                for let mut i = 0; i < len - 6; i += 1 {
                    base.push(chars[i]);
                }
                name = base;
            }
        }
        if len >= 5 {
            let mut suffix = String::with_capacity(5);
            for let mut i = len - 5; i < len; i += 1 {
                suffix.push(chars[i]);
            }
            if suffix == "Lexer" {
                let mut base = String::with_capacity(len - 5);
                for let mut i = 0; i < len - 5; i += 1 {
                    base.push(chars[i]);
                }
                name = base;
            }
        }
    }
    return Grammar { name, parser_rules, lexer_rules };
}
