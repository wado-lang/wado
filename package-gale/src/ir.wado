use { Span, ParseError } from "./runtime/lex.wado";
use { escape_ident, to_snake_case, to_lower, to_pascal_case } from "./ident.wado";

/// OptionValue is the typed right-hand side of an ANTLR4 `key = value` option
/// entry. ANTLR4 options can be a bare identifier, a dotted qualified name,
/// a single-quoted string literal, a decimal integer, or an action-block
/// `{ ... }` body of host-language code. Using a variant (rather than a raw
/// string) means consumers can branch on kind without re-parsing, and
/// action-block bodies round-trip through the IR intact.
/// ANTLR4 spec: `vendor/antlr4/doc/options.md`.
pub variant OptionValue {
    /// Bare identifier: `true`, `right`, `Python`.
    Ident(String),
    /// Dotted qualified name: `my.pkg.BaseParser`. Components are kept
    /// separate so consumers don't have to re-split.
    Qualified(List<String>),
    /// Single-quoted string literal value, with the surrounding quotes
    /// stripped: `'foo.g4'` → `Str("foo.g4")`.
    Str(String),
    /// Decimal integer literal.
    Int(i64),
    /// Host-language action block `{ ... }`. The stored text is the raw
    /// body between the braces (delimiters excluded); Gale does not parse
    /// action-language code.
    Action(String),
}

/// GrammarOption is a single `key = value ;` entry from an ANTLR4
/// `options { ... }` block. ANTLR4 spec: `vendor/antlr4/doc/options.md`.
pub struct GrammarOption {
    pub name: String,
    pub value: OptionValue,
}

/// NamedAction records the presence and position of a grammar-level
/// `@name { ... }` or `@scope::name { ... }` prequel action. The action body
/// itself is always discarded (it would be host-language code Gale cannot
/// transpile), but downstream stages still need to know which actions were
/// declared and on what scope. ANTLR4 spec: `vendor/antlr4/doc/actions.md`.
pub struct NamedAction {
    /// Optional scope qualifier (`parser` in `@parser::members`). `None`
    /// for a bare `@name { ... }` action.
    pub scope: Option<String>,
    pub name: String,
}

/// GrammarKind records which of ANTLR4's three grammar-header forms the
/// source used. ANTLR4 spec: `vendor/antlr4/doc/grammars.md`.
///
/// The kind gates semantic validation: a bare `parser grammar` cannot
/// resolve token references locally because the lexer rules live in a
/// sibling `lexer grammar`, and those refs stay unresolved until
/// `merge_grammars` combines the two halves. `merge_grammars` always
/// produces `Combined` since a merged grammar has (or is intended to
/// have) both sides.
pub variant GrammarKind {
    /// `grammar Foo;` — combined grammar (parser + lexer in one file),
    /// or a grammar produced by `merge_grammars`.
    Combined,
    /// `lexer grammar Foo;` — lexer-only translation unit.
    Lexer,
    /// `parser grammar Foo;` — parser-only translation unit; token refs
    /// come from a sibling lexer grammar and are unresolvable until merge.
    Parser,
}

/// RefKind distinguishes the three flavors of pending (unresolved)
/// reference that `parse()` collects. The kind selects which rule table
/// `check_references` resolves against. See the variants for details.
pub variant RefKind {
    /// Reference to another parser rule from inside a parser-rule body.
    /// Resolves against `Grammar.parser_rules`.
    ParserRuleRef,
    /// Reference to a token from inside a parser-rule body (or an
    /// element like `TOK` in an alternative). Resolves against
    /// `Grammar.lexer_rules` (which includes virtual tokens from
    /// `tokens { }` blocks) plus the built-in `EOF` sentinel.
    TokenRef,
    /// Reference to another lexer rule (including fragment refs) from
    /// inside a lexer-rule body. Resolves against `Grammar.lexer_rules`.
    LexerRuleRef,
}

/// PendingRef is a single rule-reference occurrence captured during
/// parse. Each ref is validated by `check_references` against the
/// grammar's own rule tables — possibly after `merge_grammars` has
/// combined split-grammar halves, which is why the validator runs as a
/// separate pass rather than inline during parse.
pub struct PendingRef {
    pub kind: RefKind,
    /// Name of the rule in whose body this reference appeared. Used in
    /// the diagnostic message so the error report points to the caller,
    /// not just the missing name.
    pub containing_rule: String,
    /// Text of the referenced symbol (what we're trying to resolve).
    pub referenced_name: String,
    /// Source span of the reference occurrence, for diagnostics. Span
    /// positions are relative to the `.g4` file that was parsed; after
    /// `merge_grammars`, spans from different files coexist but each
    /// still points into its original source.
    pub span: Span,
}

/// Grammar is the top-level IR representing a parsed .g4 file.
pub struct Grammar {
    pub name: String,
    pub kind: GrammarKind,
    pub parser_rules: List<ParserRule>,
    pub lexer_rules: List<LexerRule>,
    pub mode_names: List<String>,
    /// User-defined channel names from `channels { }` blocks, in declaration
    /// order. Predefined channels (DEFAULT=0, HIDDEN=1) are NOT included —
    /// user channels receive sequential ids starting at 2.
    pub channels: List<String>,
    /// Grammar-level options from `options { ... }` prequel blocks
    /// (`caseInsensitive`, `language`, `tokenVocab`, `superClass`, ...).
    pub options: List<GrammarOption>,
    /// Grammar-level `@name { ... }` / `@scope::name { ... }` actions,
    /// in declaration order. Action bodies themselves are discarded.
    pub named_actions: List<NamedAction>,
    /// Rule / token references encountered during parse that have not
    /// yet been resolved against a rule table. `check_references`
    /// walks these and reports undefined refs. Populated by `parse()`;
    /// concatenated by `merge_grammars` so that a merged Grammar can be
    /// validated in one pass.
    pub pending_refs: List<PendingRef>,
    /// Source `.g4` paths that contributed to this grammar, in the order
    /// they were supplied on the command line. Populated by `cmd_gen` after
    /// parsing — `parse()` itself returns an empty array because it operates
    /// on the file contents, not the path.
    pub source_files: List<String>,
}

/// Push a `LexerRule::virtual_token` for every uppercase parser-rule
/// reference with no defining lexer rule, matching ANTLR4's silent
/// implicit-token-type behaviour (vendor/antlr4/doc/lexer-rules.md).
/// Must run before `check_references`; `Combined`-only because
/// split-grammar halves are about to merge a sibling lexer.
pub fn synthesize_implicit_tokens(grammar: &mut Grammar) {
    if !grammar.kind matches { Combined } {
        return;
    }
    let mut synthesized: List<String> = [];
    for let r of &grammar.pending_refs {
        if !r.kind matches { TokenRef } {
            continue;
        }
        if r.referenced_name == "EOF" {
            continue;
        }
        let mut defined = false;
        for let lr of &grammar.lexer_rules {
            if lr.name == r.referenced_name {
                defined = true;
                break;
            }
        }
        if defined {
            continue;
        }
        if synthesized.contains(&r.referenced_name) {
            continue;
        }
        grammar.lexer_rules.push(LexerRule::virtual_token(r.referenced_name));
        synthesized.push(r.referenced_name);
    }
}

/// Resolve every reference in `grammar.pending_refs` against
/// `grammar.parser_rules` / `grammar.lexer_rules`. Returns `Err` on the
/// first unresolved reference. Mirrors ANTLR4's
/// `SymbolChecks.checkForUnresolvedRuleRefs`.
///
/// The grammar's `kind` gates what can be checked:
///   - `Combined`: every pending ref is resolvable locally. This is the
///     post-merge case and the combined-grammar case.
///   - `Lexer`: only lexer-to-lexer refs exist (no parser bodies in a
///     `lexer grammar`); token refs and parser refs are vacuously absent.
///   - `Parser`: parser-rule refs are checked locally; token refs are
///     skipped because the sibling lexer grammar hasn't been merged yet.
pub fn check_references(grammar: &Grammar) -> Result<(), ParseError> {
    for let r of &grammar.pending_refs {
        match &r.kind {
            ParserRuleRef => {
                if grammar.kind matches { Lexer } {
                    continue;
                }
                let mut found = false;
                for let pr of &grammar.parser_rules {
                    if pr.name == r.referenced_name {
                        found = true;
                        break;
                    }
                }
                if !found {
                    return Result::<(), ParseError>::Err(
                        ParseError::new(
                            `reference to undefined rule "{r.referenced_name}" in "{r.containing_rule}"`,
                            r.span,
                            ["defined rule name"],
                        ),
                    );
                }
            },
            TokenRef => {
                // A `parser grammar` cannot resolve token refs until
                // merged with its sibling lexer grammar.
                if grammar.kind matches { Parser } {
                    continue;
                }
                // `EOF` is a built-in token recognized without a lexer rule.
                if r.referenced_name == "EOF" {
                    continue;
                }
                let mut found = false;
                for let lr of &grammar.lexer_rules {
                    if lr.name == r.referenced_name {
                        found = true;
                        break;
                    }
                }
                if !found {
                    return Result::<(), ParseError>::Err(
                        ParseError::new(
                            `reference to undefined token "{r.referenced_name}" in "{r.containing_rule}"`,
                            r.span,
                            ["defined token name"],
                        ),
                    );
                }
            },
            LexerRuleRef => {
                // Lexer-to-lexer refs (including fragment refs) are
                // always resolvable locally — lexer rules cannot cross
                // the lexer/parser grammar boundary.
                // `EOF` is a built-in that matches end-of-input inside
                // lexer rules (e.g. `'/*' .*? ('*/' | EOF)`); it has no
                // defining rule and is handled specially by codegen.
                if r.referenced_name == "EOF" {
                    continue;
                }
                let mut found = false;
                for let lr of &grammar.lexer_rules {
                    if lr.name == r.referenced_name {
                        found = true;
                        break;
                    }
                }
                if !found {
                    return Result::<(), ParseError>::Err(
                        ParseError::new(
                            `reference to undefined lexer rule "{r.referenced_name}" in "{r.containing_rule}"`,
                            r.span,
                            ["defined lexer rule name"],
                        ),
                    );
                }
            },
        }
    }
    return Result::<(), ParseError>::Ok(());
}

pub global DEFAULT_MODE: i32 = 0;
pub global NO_MODE: i32 = -1;

/// Predefined ANTLR4 channel ids. User channels declared via
/// `channels { }` start at 2.
pub global DEFAULT_CHANNEL: i32 = 0;
pub global HIDDEN_CHANNEL: i32 = 1;

/// Visibility of a rule (`public`/`private`/`protected` modifiers in ANTLR4).
///
/// ANTLR4 accepts these modifiers at the rule level but ignores them during
/// code generation — every rule is effectively public in the generated code.
/// Gale preserves the value on the IR so downstream tooling can observe it.
pub enum Visibility {
    Default,
    Public,
    Private,
    Protected,
}

/// ParserRule represents a parser rule (lowercase name in .g4).
pub struct ParserRule {
    pub name: String,
    pub visibility: Visibility,
    /// Rule-level options from `options { ... }` prequel blocks.
    pub options: List<GrammarOption>,
    pub alternatives: List<Alternative>,
    /// Cached `to_snake_case(name)` — used as the fragment in
    /// `parse_X` / `scan_X` function names. Populated by `ParserRule::new`
    /// so codegen never recomputes `to_snake_case` for the same rule name.
    /// Empty until populated; `normalize_caches` fills any leftover empties.
    pub snake_name: String = "",
    /// Cached `escape_ident(snake_name)` — used as the standalone field name
    /// when the rule itself appears as a field (e.g. the LR self-ref slot in
    /// the precedence-climbing helper struct).
    pub field_name: String = "",
    /// Cached `{to_pascal_case(name)}Node` — the rule's CST type name.
    /// Equivalent to `rule_type_name(name)`; populated so codegen never
    /// re-runs `to_pascal_case` for the same rule name.
    pub type_name: String = "",
}

impl ParserRule {
    pub fn new(
        name: String,
        visibility: Visibility,
        options: List<GrammarOption>,
        alternatives: List<Alternative>,
    ) -> ParserRule {
        let snake_name = to_snake_case(&name);
        let field_name = escape_ident(&snake_name);
        let type_name = `{to_pascal_case(&name)}Node`;
        return ParserRule { name, visibility, options, alternatives, snake_name, field_name, type_name };
    }
}

/// Alternative is one branch of a parser rule, optionally labeled.
///
/// `options` carries the alt-level element options parsed from a leading
/// `<key = value, ...>` before the first element (e.g. `<assoc=right>`
/// on a left-recursive alternative). See ANTLR4 `doc/left-recursion.md`
/// and `doc/options.md`.
pub struct Alternative {
    pub label: Option<String>,
    pub options: List<GrammarOption>,
    pub elements: List<Element>,
}

impl Alternative {
    pub fn new(elements: List<Element>) -> Alternative {
        return Alternative { label: null, options: [], elements };
    }
}

/// Element is a single unit within an alternative.
///
/// Option-bearing variants (`RuleRef`, `TokenRef`, `Literal`, `Wildcard`,
/// `Group`) each wrap a struct that carries the element's own
/// `options: List<GrammarOption>` field — parsed from a trailing
/// `<key=value, ...>` angle block in the `.g4` source, or (for `Group`)
/// from a leading `options { ... }` block prequel. See ANTLR4
/// `doc/options.md` for the accepted option names and value shapes.
/// Transformer variants (`Repeat`, `Label`, `Not`) carry no options of
/// their own — in ANTLR4 a `<...>` on `x=ID<opt>`, `~ID<opt>`, or
/// `ID<opt>*` attaches to the inner atom, not to the transformer.
pub variant Element {
    RuleRef(RuleRefElement),
    TokenRef(TokenRefElement),
    Literal(LiteralElement),
    Group(GroupElement),
    Repeat(RepeatElement),
    Label(LabelElement),
    /// `.` wildcard — matches any single token. ANTLR4 spec: doc/wildcard.md.
    Wildcard(WildcardElement),
    /// `~ X` set complement — matches any token NOT in the inner set.
    Not(NotElement),
}

pub struct RuleRefElement {
    pub name: String,
    pub options: List<GrammarOption>,
    /// Cached `to_snake_case(name)` — fragment in `scan_X` / `parse_X`.
    /// Empty by default; populated eagerly by `with_options` or lazily by
    /// `normalize_caches` on the path through `generate()`.
    pub snake_name: String = "",
    /// Cached `escape_ident(snake_name)` — standalone field name in CST structs.
    pub field_name: String = "",
    /// Unique call-site id, assigned by `assign_atn_call_sites` on the path
    /// through `generate()` (before lowering / `build_atn`). It is the stable
    /// key that ties this surface call site to its ATN return state: the same
    /// id is read by `build_atn` (which records `call_site -> return_state` in
    /// `Atn.call_site_returns`) and, in P4.2b, threaded onto the GIR
    /// `RuleCallOp` so codegen can push the exact return state. -1 until
    /// assigned. (Foundation for the full-context LR loop-entry predictor —
    /// see `TODO.md` P4.2.)
    pub atn_call_site: i32 = -1,
}

impl RuleRefElement {
    pub fn new(name: String) -> RuleRefElement {
        return RuleRefElement::with_options(name, []);
    }

    pub fn with_options(name: String, options: List<GrammarOption>) -> RuleRefElement {
        let snake_name = to_snake_case(&name);
        let field_name = escape_ident(&snake_name);
        return RuleRefElement { name, options, snake_name, field_name };
    }
}

pub struct TokenRefElement {
    pub name: String,
    pub options: List<GrammarOption>,
    /// Cached `to_lower(name)` — used in token field/identifier names.
    pub lower_name: String = "",
    /// Cached `escape_ident(lower_name)` — standalone field name in CST structs.
    pub field_name: String = "",
}

impl TokenRefElement {
    pub fn new(name: String) -> TokenRefElement {
        return TokenRefElement::with_options(name, []);
    }

    pub fn with_options(name: String, options: List<GrammarOption>) -> TokenRefElement {
        let lower_name = to_lower(&name);
        let field_name = escape_ident(&lower_name);
        return TokenRefElement { name, options, lower_name, field_name };
    }
}

pub struct LiteralElement {
    pub text: String,
    pub options: List<GrammarOption>,
}

impl LiteralElement {
    pub fn new(text: String) -> LiteralElement {
        return LiteralElement { text, options: [] };
    }
}

pub struct WildcardElement {
    pub options: List<GrammarOption>,
}

impl WildcardElement {
    pub fn new() -> WildcardElement {
        return WildcardElement { options: [] };
    }
}

pub struct GroupElement {
    pub alternatives: List<Alternative>,
    pub options: List<GrammarOption>,
}

impl GroupElement {
    pub fn new(alternatives: List<Alternative>) -> GroupElement {
        return GroupElement { alternatives, options: [] };
    }
}

pub struct RepeatElement {
    pub kind: RepeatKind,
    pub element: Element,
    pub non_greedy: bool,
}

pub struct LabelElement {
    pub name: String,
    /// `=` for single-value labels, `+=` for list labels.
    pub list: bool,
    pub element: Element,
    /// Cached `to_snake_case(name)`.
    pub snake_name: String = "",
    /// Cached `escape_ident(snake_name)` — standalone field name in CST structs.
    pub field_name: String = "",
}

impl LabelElement {
    pub fn new(name: String, list: bool, element: Element) -> LabelElement {
        let snake_name = to_snake_case(&name);
        let field_name = escape_ident(&snake_name);
        return LabelElement { name, list, element, snake_name, field_name };
    }
}

pub struct NotElement {
    pub element: Element,
}

/// RepeatKind indicates the repetition type.
pub enum RepeatKind {
    Star,
    Plus,
    Optional,
}

/// LexerRule represents a lexer rule (uppercase name in .g4).
///
/// Mode fields:
/// - `mode` is the index into `Grammar.mode_names` for the mode this rule
///   lives in (0 = DEFAULT_MODE).
/// - `push_mode` is an index into `Grammar.mode_names` for `pushMode(X)`,
///   or NO_MODE (-1) if no push.
/// - `set_mode` is an index into `Grammar.mode_names` for `mode(X)` (which
///   replaces the top of the mode stack), or NO_MODE (-1) if not set.
/// - `pop_mode` is true if `popMode` was specified.
///
/// Token semantics fields (lexer commands per ANTLR4):
/// - `skip` is true if `-> skip` was specified.
/// - `more` is true if `-> more` was specified (collect more text, no token).
/// - `type_override` is the target token name from `-> type(X)`.
/// - `channel` is the channel id (0 = default, 1 = HIDDEN; integer literals
///   like `channel(2)` are stored as-is). Named channels declared in a
///   `channels {}` block are looked up later by the code generator.
pub struct LexerRule {
    pub name: String,
    pub visibility: Visibility,
    pub is_fragment: bool,
    pub skip: bool,
    pub more: bool,
    pub type_override: Option<String>,
    pub channel: i32,
    pub mode: i32,
    pub set_mode: i32,
    pub push_mode: i32,
    pub pop_mode: bool,
    /// True when this entry originates from a `tokens { }` block and has no
    /// matching lexer rule body. Generators should still emit a token-id
    /// constant for it, but the tokenizer cannot produce it directly — only
    /// grammar actions or `type(X)` rewrites can.
    pub is_virtual: bool,
    /// Rule-level options from `options { ... }` prequel blocks.
    pub options: List<GrammarOption>,
    pub body: List<LexerAlt>,
}

impl LexerRule {
    pub fn new(name: String, is_fragment: bool, skip: bool, body: List<LexerAlt>) -> LexerRule {
        return LexerRule {
            name,
            visibility: Visibility::Default,
            is_fragment,
            skip,
            more: false,
            type_override: null,
            channel: 0,
            mode: DEFAULT_MODE,
            set_mode: NO_MODE,
            push_mode: NO_MODE,
            pop_mode: false,
            is_virtual: false,
            options: [],
            body,
        };
    }

    /// Construct a virtual lexer rule entry from a `tokens { }` declaration.
    pub fn virtual_token(name: String) -> LexerRule {
        let mut rule = LexerRule::new(name, false, false, []);
        rule.is_virtual = true;
        return rule;
    }
}

/// LexerAlt is one alternative in a lexer rule.
pub struct LexerAlt {
    pub elements: List<LexerElement>,
}

/// LexerElement is a single unit within a lexer alternative.
pub variant LexerElement {
    Literal(String),
    CharRange([char, char]),
    CharClass(CharClass),
    AnyChar,
    RuleRef(String),
    Group(List<LexerAlt>),
    Repeat(LexerRepeatElement),
    Not(LexerNotElement),
}

pub struct LexerRepeatElement {
    pub kind: RepeatKind,
    pub element: LexerElement,
    pub non_greedy: bool,
}

pub struct LexerNotElement {
    pub element: LexerElement,
}

/// CharClass represents a character class like [a-zA-Z0-9].
pub struct CharClass {
    pub ranges: List<CharRange>,
    pub negated: bool,
}

/// CharRange is a single range within a character class.
pub struct CharRange {
    pub start: char,
    pub end: char,
}

impl CharRange {
    pub fn single(c: char) -> CharRange {
        return CharRange { start: c, end: c };
    }

    pub fn range(start: char, end: char) -> CharRange {
        return CharRange { start, end };
    }
}

pub fn merge_grammars(grammars: List<Grammar>) -> Grammar {
    if grammars.len() == 1 {
        return grammars[0];
    }
    let mut name = grammars[0].name;
    let mut parser_rules: List<ParserRule> = [];
    let mut lexer_rules: List<LexerRule> = [];
    let mut mode_names: List<String> = ["DEFAULT_MODE"];
    let mut channels: List<String> = [];
    let mut options: List<GrammarOption> = [];
    let mut named_actions: List<NamedAction> = [];
    let mut pending_refs: List<PendingRef> = [];
    let mut source_files: List<String> = [];
    for let g of grammars {
        // Concatenate source paths so every input contributes a provenance entry.
        for let sf of &g.source_files {
            source_files.push(*sf);
        }
        // Concatenate pending refs from every split so `check_references`
        // can resolve cross-file references (token refs in a parser grammar
        // resolve against lexer rules from its sibling lexer grammar).
        for let pr of &g.pending_refs {
            pending_refs.push(*pr);
        }
        // Preserve grammar-level options from every split. Later splits
        // override earlier ones on collision — ANTLR4 leaves conflict
        // resolution to the tool, but keeping the last value is a sensible
        // default for Gale's merge.
        for let opt of &g.options {
            let mut found = false;
            for let mut i = 0; i < options.len(); i += 1 {
                if options[i].name == opt.name {
                    options[i] = *opt;
                    found = true;
                }
            }
            if !found {
                options.push(*opt);
            }
        }
        // Named actions are concatenated — they are position-bearing markers,
        // not key/value pairs, so duplicates are preserved.
        for let act of &g.named_actions {
            named_actions.push(*act);
        }
        // Build mode index remapping table for this grammar
        let mut remap: List<i32> = [];
        for let mn of g.mode_names {
            let idx = find_or_add_mode(&mut mode_names, &mn);
            remap.push(idx);
        }
        // Build channel id remapping table. User channels start at id 2
        // (0=DEFAULT, 1=HIDDEN). Preserve existing ids when names line up.
        let mut chan_remap: List<i32> = [];
        for let cn of &g.channels {
            let id = find_or_add_channel(&mut channels, cn);
            chan_remap.push(id);
        }
        for let r of g.parser_rules {
            parser_rules.push(r);
        }
        for let mut r of g.lexer_rules {
            // Remap mode indices
            r.mode = remap[r.mode];
            if r.push_mode >= 0 {
                r.push_mode = remap[r.push_mode];
            }
            if r.set_mode >= 0 {
                r.set_mode = remap[r.set_mode];
            }
            // Remap user-defined channel ids (>= 2). 0 and 1 are predefined.
            // `src_idx` indexes the source grammar's declared channels, and
            // every channel reference is validated at parse time, so it is
            // always in range — a miss is an internal inconsistency, not
            // input we should silently pass through with a stale id.
            if r.channel >= 2 {
                let src_idx = r.channel - 2;
                assert src_idx < chan_remap.len(),
                    `merge_grammars: channel id {r.channel} has no remap entry`;
                r.channel = chan_remap[src_idx];
            }
            lexer_rules.push(r);
        }
    }
    // Derive the common name by stripping a `Lexer` / `Parser` suffix
    // (`FooLexer` + `FooParser` both reduce to `Foo`). The suffixes are
    // ASCII, so byte-offset slicing is safe for multibyte names. Only strip
    // when a non-empty base remains, so a grammar literally named `Parser`
    // or `Lexer` keeps its name.
    if name.ends_with("Parser") && name.len() > 6 {
        name = name.substr_bytes(0, name.len() - 6);
    } else if name.ends_with("Lexer") && name.len() > 5 {
        name = name.substr_bytes(0, name.len() - 5);
    }
    return Grammar {
        name,
        kind: GrammarKind::Combined,
        parser_rules,
        lexer_rules,
        mode_names,
        channels,
        options,
        named_actions,
        pending_refs,
        source_files,
    };
}

fn find_or_add_mode(modes: &mut List<String>, name: &String) -> i32 {
    for let mut i = 0; i < modes.len(); i += 1 {
        if modes[i] == *name {
            return i;
        }
    }
    modes.push(*name);
    return modes.len() - 1;
}

/// Allocate a channel id for `name`. User channel ids start at 2
/// (0=DEFAULT, 1=HIDDEN are predefined by ANTLR4).
fn find_or_add_channel(channels: &mut List<String>, name: &String) -> i32 {
    for let mut i = 0; i < channels.len(); i += 1 {
        if channels[i] == *name {
            return i + 2;
        }
    }
    channels.push(*name);
    return channels.len() - 1 + 2;
}

/// Walk every parser rule in `grammar` and fill any `snake_name` / `field_name`
/// caches that were left empty (e.g. by struct-literal construction in tests).
/// IR nodes built via the smart constructors already have these populated, so
/// the production path only pays one `is_empty()` check per node — no array
/// rebuilds, no element re-wrapping. Mutates in place via `&mut` ref-bind
/// patterns, available since the boxing-pass param-shadow fix.
pub fn normalize_caches(grammar: &mut Grammar) {
    for let mut ri = 0; ri < grammar.parser_rules.len(); ri += 1 {
        let rule = &mut grammar.parser_rules[ri];
        if rule.snake_name.is_empty() {
            rule.snake_name = to_snake_case(&rule.name);
        }
        if rule.field_name.is_empty() {
            rule.field_name = escape_ident(&rule.snake_name);
        }
        if rule.type_name.is_empty() {
            rule.type_name = `{to_pascal_case(&rule.name)}Node`;
        }
        for let mut ai = 0; ai < rule.alternatives.len(); ai += 1 {
            let alt = &mut rule.alternatives[ai];
            for let mut ei = 0; ei < alt.elements.len(); ei += 1 {
                normalize_element(&mut alt.elements[ei]);
            }
        }
    }
}

/// Canonicalize two-alternative groups with exactly one empty alt into an
/// Optional repeat. `( | X)` (empty alt first) ≡ `(X)??` (non-greedy
/// optional: prefer to skip) and `(X | )` (empty alt last) ≡ `(X)?` (greedy
/// optional: prefer to enter) — a true EBNF equivalence (ANTLR4
/// `doc/wildcard.md` / parser-rules semantics). Folding the two surface
/// forms onto the one Optional path means a single prediction strategy
/// drives both, and the empty-first form reuses the runtime ATN simulator
/// that already resolves non-greedy `??` (e.g. the dangling-`else` binding
/// in `ParserExec/IfIfElseNonGreedyBinding2`).
///
/// Only the clean 2-alt case is rewritten: both-empty / both-non-empty
/// groups, groups carrying their own `options { ... }`, and a body alt
/// bearing an alt label are left untouched (rewriting them could drop
/// information or change the CST shape).
pub fn canonicalize_empty_alt_groups(grammar: &mut Grammar) {
    for let mut ri = 0; ri < grammar.parser_rules.len(); ri += 1 {
        let canon_alts = canon_empty_alt_alternatives(&grammar.parser_rules[ri].alternatives);
        grammar.parser_rules[ri].alternatives = canon_alts;
    }
}

/// Assign every parser-rule `RuleRefElement` a unique, increasing
/// `atn_call_site` id (a depth-first walk over rules, alternatives, and
/// nested elements). The id is the stable correspondence key between a
/// surface call site and its ATN return state: `build_atn` records
/// `call_site -> return_state`, and codegen (P4.2b) pushes that return state
/// around the call so the simulator pops to the exact caller continuation.
///
/// Runs on the `generate()` path after `canonicalize_empty_alt_groups` (so
/// the post-canonicalization element shape is what gets numbered) and before
/// lowering / `build_atn`. Value semantics: each rule's alternatives are
/// rebuilt with stamped elements and reassigned. Idempotent re-runs simply
/// re-number from 0.
pub fn assign_atn_call_sites(grammar: &mut Grammar) {
    let mut next: i32 = 0;
    for let mut ri = 0; ri < grammar.parser_rules.len(); ri += 1 {
        let stamped = stamp_call_sites_alternatives(&grammar.parser_rules[ri].alternatives, &mut next);
        grammar.parser_rules[ri].alternatives = stamped;
    }
}

fn stamp_call_sites_alternatives(alts: &List<Alternative>, next: &mut i32) -> List<Alternative> {
    let mut out: List<Alternative> = [];
    for let alt of alts {
        let mut elems: List<Element> = [];
        for let e of &alt.elements {
            elems.push(stamp_call_sites_element(e, next));
        }
        out.push(Alternative { label: alt.label, options: alt.options, elements: elems });
    }
    return out;
}

/// Stamp this element (and any nested elements) with call-site ids. Only
/// `RuleRef` leaves consume an id; transformer / group wrappers recurse.
fn stamp_call_sites_element(elem: &Element, next: &mut i32) -> Element {
    return match *elem {
        RuleRef(rr) => {
            let id = *next;
            *next += 1;
            Element::RuleRef(RuleRefElement {
                name: rr.name,
                options: rr.options,
                snake_name: rr.snake_name,
                field_name: rr.field_name,
                atn_call_site: id,
            });
        },
        Label(lab) => Element::Label(LabelElement {
            name: lab.name,
            list: lab.list,
            element: stamp_call_sites_element(&lab.element, next),
            snake_name: lab.snake_name,
            field_name: lab.field_name,
        }),
        Repeat(rep) => Element::Repeat(RepeatElement {
            kind: rep.kind,
            element: stamp_call_sites_element(&rep.element, next),
            non_greedy: rep.non_greedy,
        }),
        Not(n) => Element::Not(NotElement {
            element: stamp_call_sites_element(&n.element, next),
        }),
        Group(g) => Element::Group(GroupElement {
            alternatives: stamp_call_sites_alternatives(&g.alternatives, next),
            options: g.options,
        }),
        _ => *elem,
    };
}

/// Rebuild an alternative list with each element canonicalized. Returns a
/// fresh list (value semantics: in-place `&mut list[i]` mutation does not
/// persist, so the pass rebuilds and reassigns).
fn canon_empty_alt_alternatives(alts: &List<Alternative>) -> List<Alternative> {
    let mut out: List<Alternative> = [];
    for let alt of alts {
        let mut elems: List<Element> = [];
        for let e of &alt.elements {
            elems.push(canon_empty_alt_element(e));
        }
        out.push(Alternative { label: alt.label, options: alt.options, elements: elems });
    }
    return out;
}

/// Bottom-up rewrite: canonicalize nested groups first, then this element.
fn canon_empty_alt_element(elem: &Element) -> Element {
    let rebuilt = match *elem {
        Label(lab) => Element::Label(LabelElement {
            name: lab.name,
            list: lab.list,
            element: canon_empty_alt_element(&lab.element),
            snake_name: lab.snake_name,
            field_name: lab.field_name,
        }),
        Repeat(rep) => Element::Repeat(RepeatElement {
            kind: rep.kind,
            element: canon_empty_alt_element(&rep.element),
            non_greedy: rep.non_greedy,
        }),
        Not(n) => Element::Not(NotElement {
            element: canon_empty_alt_element(&n.element),
        }),
        Group(g) => Element::Group(GroupElement {
            alternatives: canon_empty_alt_alternatives(&g.alternatives),
            options: g.options,
        }),
        _ => *elem,
    };

    if let Group(g) = &rebuilt {
        if let Some(opt) = empty_alt_group_as_optional(g) {
            return opt;
        }
    }
    return rebuilt;
}

/// Returns the Optional-repeat equivalent of a two-alt group with exactly
/// one empty alternative, or `null` if the group is not that clean shape.
fn empty_alt_group_as_optional(g: &GroupElement) -> Option<Element> {
    if !g.options.is_empty() {
        return null;
    }
    if g.alternatives.len() != 2 {
        return null;
    }
    let a0_empty = g.alternatives[0].elements.is_empty();
    let a1_empty = g.alternatives[1].elements.is_empty();
    // Exactly one empty: both-empty `( | )` and both-non-empty `(a | b)`
    // are real decisions, not optionals.
    if a0_empty == a1_empty {
        return null;
    }
    // Empty alt first ⇒ prefer to skip ⇒ non-greedy.
    let non_greedy = a0_empty;
    let body_alt = if a0_empty { &g.alternatives[1] } else { &g.alternatives[0] };
    if body_alt.label matches { Some(_) } {
        return null;
    }
    // Wrap the body alt in a single-alt group so a multi-element body
    // (`'else' statement`) lowers exactly like the hand-written
    // `('else' statement)??` form (Binding1). A single-element body's
    // wrapper is flattened again by the transparent-group lowering.
    let inner = Element::Group(GroupElement::new([
        Alternative { label: null, options: body_alt.options, elements: body_alt.elements },
    ]));
    return Option::<Element>::Some(Element::Repeat(RepeatElement {
        kind: RepeatKind::Optional,
        element: inner,
        non_greedy,
    }));
}

fn normalize_element(elem: &mut Element) {
    if let RuleRef(r) = elem {
        if r.snake_name.is_empty() {
            r.snake_name = to_snake_case(&r.name);
        }
        if r.field_name.is_empty() {
            r.field_name = escape_ident(&r.snake_name);
        }
        return;
    }
    if let TokenRef(t) = elem {
        if t.lower_name.is_empty() {
            t.lower_name = to_lower(&t.name);
        }
        if t.field_name.is_empty() {
            t.field_name = escape_ident(&t.lower_name);
        }
        return;
    }
    if let Label(lab) = elem {
        if lab.snake_name.is_empty() {
            lab.snake_name = to_snake_case(&lab.name);
        }
        if lab.field_name.is_empty() {
            lab.field_name = escape_ident(&lab.snake_name);
        }
        normalize_element(&mut lab.element);
        return;
    }
    if let Repeat(rep) = elem {
        normalize_element(&mut rep.element);
        return;
    }
    if let Group(g) = elem {
        for let mut ai = 0; ai < g.alternatives.len(); ai += 1 {
            let alt = &mut g.alternatives[ai];
            for let mut ei = 0; ei < alt.elements.len(); ei += 1 {
                normalize_element(&mut alt.elements[ei]);
            }
        }
        return;
    }
    if let Not(n) = elem {
        normalize_element(&mut n.element);
        return;
    }
}
