test "generate scalar-labeled group `t=(a | b)`" {
    // Sets/ParserSet.txt: the op is a Group while the element is still
    // `Label(Group)`, so the walker peels the label before `gen_op_group`.
    let output = gen_source("grammar T; a : t=('x' | 'y') ;");
    assert output.contains("TK_LIT_x");
    assert output.contains("TK_LIT_y");
    assert output.contains("p.expect_set(&SYNC_");
    // A peel regression panics in `gen_op_group`; transparency is what is left.
    let bare_output = gen_source("grammar T; a : ('x' | 'y') ;");
    let labeled_body = extract_fn_body(&output, "fn _parse_a__inner(");
    let bare_body = extract_fn_body(&bare_output, "fn _parse_a__inner(");
    assert labeled_body == bare_body, `scalar label changed the emit:\nlabeled: ${labeled_body}\nbare:    ${bare_body}`;
}

test "generate scalar-labeled wildcard repeat `t=.*`" {
    // A suffix binds outside the label, so this is Repeat(Label(Wildcard)):
    // the walker peels the Label inside the body, not at the Repeat itself.
    let output = gen_source("grammar T; a : t=.* ; A : 'a' ;");
    assert output.contains("any");
}

test "generate lexer set_mode" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [
            LexerRule {
                name: "OPEN_TAG",
                visibility: Visibility::Default,
                is_fragment: false,
                skip: false,
                more: false,
                type_override: null,
                channel: 0,
                mode: 0,
                set_mode: 1,
                push_mode: -1,
                pop_mode: false,
                is_virtual: false,
                options: [],
                body: [
                    LexerAlternative {
                        elements: [LexerElement::Literal("<")],
                    },
                ],
            },
            LexerRule {
                name: "TAG_NAME",
                visibility: Visibility::Default,
                is_fragment: false,
                skip: false,
                more: false,
                type_override: null,
                channel: 0,
                mode: 1,
                set_mode: -1,
                push_mode: -1,
                pop_mode: false,
                is_virtual: false,
                options: [],
                body: [
                    LexerAlternative {
                        elements: [LexerElement::Literal("a")],
                    },
                ],
            },
        ],
        mode_names: ["DEFAULT_MODE", "TAG_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("best_set_mode");
    assert output.contains("best_set_mode = 1");
    assert output.contains("current_mode = best_set_mode");
}

