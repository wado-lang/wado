test "generate lexer type_override" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [
            LexerRule {
                name: "ID",
                visibility: Visibility::Default,
                is_fragment: false,
                skip: false,
                more: false,
                type_override: null,
                channel: 0,
                mode: 0,
                set_mode: -1,
                push_mode: -1,
                pop_mode: false,
                is_virtual: false,
                options: [],
                body: [
                    LexerAlternative {
                        elements: [LexerElement::Literal("x")],
                    },
                ],
            },
            LexerRule {
                name: "IF",
                visibility: Visibility::Default,
                is_fragment: false,
                skip: false,
                more: false,
                type_override: Option::<String>::Some("ID"),
                channel: 0,
                mode: 0,
                set_mode: -1,
                push_mode: -1,
                pop_mode: false,
                is_virtual: false,
                options: [],
                body: [
                    LexerAlternative {
                        elements: [LexerElement::Literal("if")],
                    },
                ],
            },
        ],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    // IF rule should produce tokens tagged as TK_ID (not TK_IF).
    assert output.contains("best_kind = TK_ID");
    // TK_IF should still exist as a token kind (not renamed), because
    // type_override only rewrites emission, not the rule identifier.
    assert output.contains("pub global TK_IF: i32 = ");
}

test "generate lexer channel" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [
            LexerRule {
                name: "COMMENT",
                visibility: Visibility::Default,
                is_fragment: false,
                skip: false,
                more: false,
                type_override: null,
                channel: 2,
                mode: 0,
                set_mode: -1,
                push_mode: -1,
                pop_mode: false,
                is_virtual: false,
                options: [],
                body: [
                    LexerAlternative {
                        elements: [LexerElement::Literal("#")],
                    },
                ],
            },
        ],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("best_channel");
    assert output.contains("best_channel = 2");
    // Non-default channels must be routed to trivia, not tokens — ANTLR4
    // hides channels other than DEFAULT from parser rules.
    assert output.contains("if best_channel != 0");
    assert output.contains("ts.push_trivia(best_kind, tok_start, best_end, best_channel);");
    // No `-> skip` rule and no action to latch one, so `is_skip` never exists.
    assert !output.contains("let is_skip");
}

test "generate lexer hidden channel routes to trivia" {
    // Hidden tokens go to trivia, not the tokens stream, so the parser never sees them.
    let input = "lexer grammar Test;
WS : [ \\t]+ -> channel(HIDDEN) ;
ID : [a-z]+ ;";
    let mut grammar = parse(input).unwrap();
    // Parser-side contract: HIDDEN channel must not degrade to skip.
    for let r of &grammar.lexer_rules {
        if r.name == "WS" {
            assert r.skip == false;
            assert r.channel == 1;
        }
    }
    // Generator-side contract: a nonzero channel routes to trivia.
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("if best_channel != 0");
    assert output.contains("ts.push_trivia(best_kind, tok_start, best_end, best_channel);");
    assert !output.contains("let is_skip");
}

test "generate left-associative LR alt passes own_prec+1 on right operand" {
    // Same-precedence operators associate left through the outer precedence loop,
    // not through nested recursion.
    let input = "grammar Test;
expr : expr '**' expr | NUMBER ;
NUMBER : [0-9]+ ;
WS : [ \\t\\r\\n]+ -> skip ;
";
    let output = gen_source(input);
    assert output.contains("_parse_expr(p, 2)");
}

test "generate right-associative LR alt passes own_prec on right operand" {
    // `<assoc=right>` lowers the inner threshold so same-precedence `**`
    // nests rightward: `2 ** 3 ** 4` parses as `2 ** (3 ** 4)`.
    let input = "grammar Test;
expr : <assoc=right> expr '**' expr | NUMBER ;
NUMBER : [0-9]+ ;
WS : [ \\t\\r\\n]+ -> skip ;
";
    let output = gen_source(input);
    assert output.contains("_parse_expr(p, 1)");
    // And the scan-side mirror must be kept in sync.
    assert output.contains("scan_expr(tokens, pos, 1)");
}

test "LR scan loop saves pos and backs off on a suffix failure" {
    // Both alts start with `a`, so a suffix scan can fail after its first token; the
    // loop then restores `pos` and stops, as ANTLR4 keeps the longest valid prefix.
    let input = "grammar Test;
prog : statement* EOF ;
statement : letterA | statement letterA 'b' ;
letterA : 'a' ;
";
    let output = gen_source(input);
    let scan_body = extract_fn_body(&output, "fn scan_statement(");
    // The LR loop must save `pos` before the suffix call and restore it on
    // failure. Look for the save+restore pair around `scan_statement_lr_1(`.
    assert scan_body.contains("let lr_saved_pos = pos;");
    assert scan_body.contains("pos = lr_saved_pos; break;");
}

test "LR helper stamps min_prec on a self-ref nested inside a Repeat group" {
    // A self-ref nested in `(',' b+=expr)*` kept min_prec 0 and ate the outer `>>`.
    // Two LR alts, so a `conflict_min` that always reads `lr_alts[0]` also trips.
    let input = "grammar Test;
s : expr EOF ;
expr :
    a=expr '*' a=expr #Factor
    | b+=expr (',' b+=expr)* '>>' c=expr #Send
    | ID #JustId
;
ID : 'a' ;
WS : [ \\t\\n]+ -> skip ;
";
    let output = gen_source(input);
    let helper = extract_fn_body(&output, "fn _parse_expr__inner(");
    // Send is the second LR alt of two left-assoc: own_prec=1, conflict_min=2.
    // The self-refs in the Send suffix must be stamped with min_prec 2.
    assert !helper.contains("_parse_expr(p)");
    assert helper.contains("_parse_expr(p, 2)");
    let scan_helper = extract_fn_body(&output, "fn scan_expr_lr_1");
    assert !scan_helper.contains("scan_expr(tokens, pos, 0)");
    assert scan_helper.contains("scan_expr(tokens, pos, 2)");
}

test "SimpleCst group emit threads min_prec_arg on a self-ref alt inside an LR suffix" {
    // The SimpleCst group emitters dropped `min_prec_arg`, so `(expr | INT)` inside
    // an LR suffix lost the stamp the deep walker set.
    let input = "grammar Test;
s : expr EOF ;
expr : expr ',' (expr | INT) | INT ;
INT : [0-9]+ ;
WS : [ \\t\\n]+ -> skip ;
";
    let output = gen_source(input);
    let helper = extract_fn_body(&output, "fn _parse_expr__inner(");
    assert !helper.contains("_parse_expr(p)");
    assert helper.contains("_parse_expr(p, 2)");
}

test "LR parse loop predicts via scan when suffix's first token is shared with the atom" {
    // The suffix call moves `p.pos`, so the parse loop asks the scan first; otherwise
    // a failed suffix leaves `p.pos` mid-suffix under the `statement*` driver.
    let input = "grammar Test;
prog : statement* EOF ;
statement : letterA | statement letterA 'b' ;
letterA : 'a' ;
";
    let output = gen_source(input);
    let parse_body = extract_fn_body(&output, "fn _parse_statement__inner(");
    assert parse_body.contains("scan_statement_lr_1(") || parse_body.contains("scan_statement_lr_1 (");
}

test "generate emits pub fn parse_<rule>(input) per parser rule" {
    // `parse_R(input)` is the start-rule API; `parse(input)` stays as the first rule's
    // alias, which driver tests and descriptors without a `[start]` call.
    let input = "grammar Test;
a : 'x' ;
b : 'y' ;
";
    let output = gen_source(input);
    assert output.contains("pub fn parse_a<S: AsStrSlice>(input: S");
    assert output.contains("pub fn parse_b<S: AsStrSlice>(input: S");
    // Each `parse_<rule>` hands its `_parse_<rule>` to the shared `_run_parse_entry`,
    // which builds the Parser and folds the error into the diagnostics.
    assert output.contains(
        "fn _run_parse_entry<S: AsStrSlice>(input: S, max_errors: i32, entry: fn(&mut Parser)) -> ParseResult",
    );
    assert output.contains("return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_a(p));");
    assert output.contains("return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_b(p));");
    // `pub fn parse` is a thin alias for the first rule's entry.
    assert output.contains("return parse_a(input, max_errors);");
}

test "trace option emits per-rule enter/ok/fail instrumentation" {
    // Tracing shows the recursive-descent path and the bail point on stderr
    // when a grammar rejects an input.
    let input = "grammar Test;
a : 'x' b ;
b : 'y' ;
";
    let traced = gen_with(input, &GenerateOptions { trace: true }).source;
    // The `core:log` import, the trace helpers, the opt-in sink installer, the
    // depth field, and the per-rule calls are all present.
    assert traced.contains(
        "use { Level, Log, TextSink, enabled, log_level, set_log_level, trace } from \"core:log\";",
    );
    assert traced.contains("fn trace_enter<S: AsStrSlice>(p: &Parser, rule: S)");
    assert traced.contains("pub fn trace_to_stderr<T, effect E>");
    assert traced.contains("trace_depth: i32,");
    assert traced.contains("trace_enter(p, \"a\");");
    assert traced.contains("trace_fail(p, \"a\", p.pending_message());");
    assert traced.contains("trace_ok(p, \"b\");");

    // Default generation (trace off) must contain none of it — the feature
    // is strictly opt-in and adds zero instrumentation otherwise.
    let plain = gen_source(input);
    assert !plain.contains("trace_enter");
    assert !plain.contains("trace_depth");
    assert !plain.contains("core:log");
}

test "token-led overlap dispatch emits no per-alt scan helpers" {
    // The alts split on the second token, so prediction is a `peek_kind` dispatch
    // and the per-alt scan helpers would be dead.
    let input = "grammar T;
r : '{' a '}' | '{' '}' ;
a : 'x' ;
";
    let output = gen_source(input);
    // Both alts are reached (the group resolved, not collapsed)...
    assert output.contains("fn _parse_r__inner_alt_0(");
    assert output.contains("fn _parse_r__inner_alt_1(");
    // ...but neither scan helper is emitted.
    assert !output.contains("fn _parse_r__inner_scan_");

    // A shared-prefix tournament rule still emits its scan helpers, so the
    // gate is not over-pruning.
    let tinput = "grammar T;
s : X s Y? | X ;
X : 'X' ;
Y : 'Y' ;
";
    let tout = gen_source(tinput);
    assert tout.contains("fn scan_s_alt_0(");
}

test "an alternative's scan helper is emitted once for the scan and the parse" {
    // Alt 0 is contested in `scan_r`, so the scan side emits its function; the
    // parse side's tournament scans it too, and must call that function.
    let input = "grammar T;
s : r EOF ;
r : a X | A a Y | B a Z ;
a : (A|B)+ ;
A : 'A' ;
B : 'B' ;
X : 'X' ;
Y : 'Y' ;
Z : 'Z' ;
";
    let output = gen_source(input);
    assert output.contains("fn scan_r_alt_0(");
    assert !output.contains("fn _parse_r__inner_scan_0(");
    assert output.contains("let _sd_p_0 = scan_r_alt_0(_sd_tokens, _sd_pos");
}

test "a scan never re-tests a token its guard already proved" {
    // `(',' b)*` enters on `','`, and `('*' | '/')` is one token out of two.
    let input = "grammar T;
s : r EOF ;
r : a | a X ;
a : b (',' b)* ('*' | '/') ;
b : Y ;
X : 'X' ;
Y : 'Y' ;
";
    let output = gen_source(input);
    let body = extract_fn_body(&output, "fn scan_a(");
    assert body.contains("while pos < tokens.len() && tokens[pos] == TK_LIT_COMMA");
    assert !body.contains("tokens[pos] != TK_LIT_COMMA"), `the loop guard proved ','\n${body}`;
    assert !body.contains("_best"), `a single-token alternation is a set test, not a tournament\n${body}`;
}

test "a token the dispatch decided is taken, not expected" {
    let input = "grammar T;
s : r EOF ;
r : A B | C B | t ;
t : A2 | C2 ;
A : 'A' ;
B : 'B' ;
C : 'C' ;
A2 : 'a' ;
C2 : 'c' ;
";
    let output = gen_source(input);
    let r = extract_fn_body(&output, "fn _parse_r__inner(");
    assert r.contains("p.take();"), r;
    assert !r.contains("p.expect(TK_A,"), `the dispatch proved A\n${r}`;
    assert r.contains("p.expect(TK_B,"), r;
    let t = extract_fn_body(&output, "fn _parse_t__inner(");
    assert t.contains("p.take();"), t;
    assert !t.contains("p.expect(kind"), `the dispatch proved the token\n${t}`;
}

test "a loop scans its body only where the token it enters on may also exit it" {
    // `fs`'s loop may end the rule, and `p` continues it with `','` too.
    let input = "grammar T;
s : e EOF | p EOF ;
e : t (('+' | '-') t)* ;
t : Y ;
p : '{' fs (',' '..')? '}' ;
fs : t (',' t)* ;
Y : 'Y' ;
";
    let output = gen_source(input);
    let e = extract_fn_body(&output, "fn _parse_e__inner(");
    assert e.contains("while !p.recovering && ("), e;
    assert e.contains("p.take();"), `the loop guard proved the operator\n${e}`;
    assert !e.contains("sync_alts"), `the loop guard proved the operator\n${e}`;
    let fs = extract_fn_body(&output, "fn _parse_fs__inner(");
    assert fs.contains("loop {"), fs;
}

test "a dispatch never re-tests the token its arm tested" {
    let input = "grammar T;
s : r e EOF ;
r : a | b ;
a : X Y* ;
b : X Y* Z ;
e : e '.' ID | e '.' ID '(' ')' | ID ;
X : 'x' ;
Y : 'y' ;
Z : 'z' ;
ID : [a-w]+ ;
";
    let output = gen_source(input);
    let mut prev = "";
    for let line of output.split("\n") {
        let t = line.trim().to_string();
        assert !(t.starts_with("if ") && t.ends_with("{") && t == prev), `nested re-test: ${t}`;
        prev = t;
    }
}

test "a scan tests a one-token rule inline, and trusts a callee that consumes" {
    let input = "grammar T;
s : (n | n K1)* EOF ;
n : a K2? ;
a : ID | k | '(' a ')' ;
k : K1 | K2 ;
ID : [a-z]+ ;
K1 : 'K' ;
K2 : 'J' ;
";
    let output = gen_source(input);
    let a = extract_fn_body(&output, "fn scan_a(");
    assert !a.contains("scan_k("), `the partition proved k's token\n${a}`;
    let n = extract_fn_body(&output, "fn scan_n(");
    assert !n.contains("scan_start"), `scan_a never matches empty\n${n}`;
}

test "a scan candidate that runs first does not rewind to where it is" {
    let input = "grammar T;
s : (a | a Z)* EOF ;
a : X | m ;
m : Y Y ;
X : 'x' ; Y : 'y' ; Z : 'z' ;
";
    let output = gen_source(input);
    let a = extract_fn_body(&output, "fn scan_a(");
    assert a.contains("scan_m("), a;
    assert !a.contains("pos = start;"), a;
}

test "a scan calls through a rule that only forwards to another" {
    let input = "grammar T;
s : (t | t Z)* EOF ;
t : n X ;
n : a ;
a : Y Y | X Y ;
X : 'x' ; Y : 'y' ; Z : 'z' ;
";
    let output = gen_source(input);
    let t = extract_fn_body(&output, "fn scan_t(");
    assert t.contains("scan_a("), t;
    assert !output.contains("fn scan_n("), output;
}

test "a decline check names each continuing token once" {
    let input = "grammar T;
s : (t | t X)* EOF ;
t : '(' fs? ')' ;
fs : f (',' f)* ','? ;
f : at* v? ty ;
at : '#' '[' ID ']' ;
v : 'pub' ;
ty : ID | '(' fs? ')' ;
X : 'x' ;
ID : [a-w]+ ;
";
    let output = gen_source(input);
    assert output.contains("decline_kind"), output;
    for let line of output.split("\n") {
        let terms: List<String> = line.split(" || ").map(|t| t.trim().to_string()).collect();
        for let i of 1..<terms.len() {
            assert terms[i] != terms[i - 1] || terms[i].contains("{"), `a repeated term: ${line}`;
        }
    }
}

test "a scan function nothing calls is not emitted" {
    let input = "grammar T;
s : a b EOF ;
a : X Y ;
b : (c | c Z)* ;
c : W+ ;
X : 'x' ; Y : 'y' ; Z : 'z' ; W : 'w' ;
";
    let output = gen_source(input);
    assert !output.contains("fn scan_a("), output;
    assert output.contains("fn scan_c("), output;
}

test "every emitted FOLLOW mask is named by a call" {
    let output = gen_source(#include_str("../tests/grammars/SQLite.g4"));
    let mut masks = 0;
    for let line of output.split("\n") {
        if !line.starts_with("global FOLLOW_MASK_") {
            continue;
        }
        masks += 1;
        let name = line.split(":").next().unwrap().to_string().split(" ").last().unwrap().to_string();
        assert output.contains(`${name},`) || output.contains(`${name})`) || output.contains(`${name} `), `${name} is never named`;
    }
    assert masks > 0, "SQLite interns FOLLOW masks";
}

test "an optional takes the token its guard tested" {
    let input = "grammar T;
s : A B? (C D)? (E | F)? G EOF ;
A : 'a' ; B : 'b' ; C : 'c' ; D : 'd' ; E : 'e' ; F : 'f' ; G : 'g' ;
";
    let output = gen_source(input);
    let body = extract_fn_body(&output, "fn _parse_s__inner(");
    assert !body.contains("p.expect(TK_B"), body;
    assert !body.contains("p.expect(TK_C"), body;
    assert !body.contains("p.expect_set("), body;
    assert body.contains("p.expect(TK_D"), body;
}

