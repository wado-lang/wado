    assert output.contains("// Grammar metadata from source .g4 prequels:");
    assert output.contains("//   @header");
    assert output.contains("//   @parser::members");
    assert output.contains("//   @lexer::members");
}

test "metadata block omitted when no options and no named actions" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
