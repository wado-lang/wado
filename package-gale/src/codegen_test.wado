use {
    Grammar,
    GrammarKind,
    GrammarOption,
    OptionValue,
    ActionSource,
    NamedAction,
    ParserRule,
    Alternative,
    Element,
    TokenRefElement,
    LexerRule,
    Visibility,
    merge_grammars,
} from "./ir.wado";
use { generate, GenerateOptions, GeneratedOutput } from "./codegen.wado";
use { render_lexer_dump } from "./lexer_dump.wado";
use { Diagnostic } from "./gir.wado";
use { parse_highlight_query } from "./highlight_query.wado";
use { parse, parse_checked, assemble_grammar } from "./g4/parser.wado";
use { count_occurrences } from "../tests/support/text.wado";
use { eval, Output } from "core:eval";
use { wado } from "lib:wadopoet";

global DEFAULT_OPTIONS: GenerateOptions = GenerateOptions {};

fn gen_with<S: AsStrSlice>(src: S, options: &GenerateOptions) -> GeneratedOutput {
    let mut g = parse_checked(src).unwrap();
    return generate(&mut g, options);
}

fn gen<S: AsStrSlice>(src: S) -> GeneratedOutput {
    return gen_with(src, &DEFAULT_OPTIONS);
}

fn gen_source<S: AsStrSlice>(src: S) -> String {
    return gen(src).source;
}

fn unsupported_count(out: &GeneratedOutput) -> i32 {
    return out.diagnostics.iter_ref().filter(|d: &Diagnostic| d.kind matches { UnsupportedAction }).count();
}

fn diagnostics_saying<S: AsStrSlice>(out: &GeneratedOutput, text: S) -> i32 {
    return out.diagnostics.iter_ref().filter(|d: &Diagnostic| d.message.contains(text)).count();
}

/// What the parser generated from `grammar` makes of each input to `rule`, one
/// line each: `input => tree`, or `error`, then any action output. The error's
/// wording is left out: compatibility covers what is rejected, not how it reads.
fn parses<S: AsStrSlice>(grammar: S, rule: String, inputs: List<String>) -> String {
    return parses_each(grammar, inputs.into_iter().map(|input| [rule, input]).collect());
}

/// `parses` for a grammar with several entry rules: each `[rule, input]` pair,
/// one line each.
fn parses_each<S: AsStrSlice>(grammar: S, cases: List<[String, String]>) -> String {
    let mut body = String::new();
    for let [rule, input] of cases {
        body.push_str(wado`show("${input}", parse_${rule}("${input}"));\n`);
    }
    return printed(grammar, body, SHOW_FN);
}

/// The tokens the lexer generated from `grammar` makes of each input, one line
/// each: `input => NAME:text ...`, with `error` naming what no rule matched,
/// then any action output.
fn lexes<S: AsStrSlice>(grammar: S, inputs: List<String>) -> String {
    let mut body = String::new();
    for let input of inputs {
        body.push_str(wado`lex("${input}");\n`);
    }
    return printed(grammar, body, LEX_FN);
}

/// Runs `body` beside the parser generated from `grammar` and the `items`
/// declared with it, and returns what it printed.
fn printed<S: AsStrSlice>(grammar: S, body: String, items: String = "") -> String {
    return run_beside(gen_source(grammar), body, items).stdout;
}

/// What the traced parser generated from `grammar` logs while `body` runs.
fn traced<S: AsStrSlice>(grammar: S, body: String) -> String {
    let source = gen_with(grammar, &GenerateOptions { trace: true }).source;
    return run_beside(source, `trace_to_stderr(|| ${body});\n`).stderr;
}

/// Runs `body` beside the parser `source` and the `items` declared with it.
fn run_beside(source: String, body: String, items: String = "") -> Output {
    // The generated source opens with inner attributes, which come first.
    let out = eval(`${source}
use { println, Stdout } from "core:cli";
${items}
export fn run() with Stdout {
${body}}
`).unwrap();
    assert out.status matches { Exited(0) }, `${out.status}\n${out.stderr}`;
    return out;
}

// `SHOW_FN` and `SHOW_TOKENS_FN` are `"..."` literals, so their holes are the
// generated program's own.

global SHOW_FN: String = "fn show(input: String, r: ParseResult) with Stdout {
    let shown = if r.ok() { to_string_tree(&r) } else { \"error\" };
    let output = if r.output.is_empty() { \"\" } else { ` [${r.output}]` };
    println(`${input} => ${shown}${output}`);
}";

global SHOW_TOKENS_FN: String = "fn show_tokens(label: String, toks: &TokenStream) with Stdout {
    let mut line = `${label} =>`;
    for let mut i = 0; toks.kind_at(i) != TK_EOF; i += 1 {
        let name = if toks.is_lex_error(i) { \"error\" } else { token_kind_name(toks.kind_at(i)) };
        line.push_str(` ${name}:${toks.token_text(i)}`);
    }
    if !toks.output.is_empty() {
        line.push_str(` [${toks.output}]`);
    }
    println(line);
}";

// A lexer base's handler calls `show_tokens` itself, since `tokenize` then
// carries the base's effect.
global LEX_FN: String = `${SHOW_TOKENS_FN}

fn lex(input: String) with Stdout {
    show_tokens(input, &tokenize(input));
}`;

test "generate header" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.len() > 0;
    // Grammar was constructed with no source_files, so gen_header emits an
    // empty sources list rather than fabricating a nonexistent `{name}.g4`.
    let header = `#![generated(by = "gale", sources = [])]`;
    for let mut i = 0; i < header.len(); i += 1 {
        assert output.get_byte_unchecked(i) == header.get_byte_unchecked(i);
    }
}

test "generate header with multiple source files" {
    let mut grammar = Grammar {
        name: "Html",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: ["HtmlLexer.g4", "HtmlParser.g4"],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let header = `#![generated(by = "gale", sources = ["HtmlLexer.g4", "HtmlParser.g4"])]`;
    for let mut i = 0; i < header.len(); i += 1 {
        assert output.get_byte_unchecked(i) == header.get_byte_unchecked(i);
    }
}

test "generate header escapes a source file name" {
    let mut grammar = Grammar {
        name: "Odd",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: ["a\"b\\c.g4"],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let header = "#![generated(by = \"gale\", sources = [\"a\\\"b\\\\c.g4\"])]";
    for let mut i = 0; i < header.len(); i += 1 {
        assert output.get_byte_unchecked(i) == header.get_byte_unchecked(i);
    }
}

test "generate token kind" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [
            LexerRule::new("NUMBER", false, false, []),
            LexerRule::new("DIGIT", true, false, []),
            LexerRule::new("WS", false, true, []),
        ],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("pub global TK_NUMBER: i32 = 0;");
    assert output.contains("pub global TK_WS: i32 = 1;");
    assert output.contains("pub global TK_EOF: i32 = 2;");
    assert output.contains("pub global TK_ERROR: i32 = 3;");
    assert !output.contains("TK_DIGIT");
    assert !output.contains("enum TokenKind");
}

test "node-kind constants are pub so consumers can dispatch on CstNode.kind" {
    let output = gen_source("grammar T; prog : expr ; expr : INT ; INT : [0-9]+ ;");
    assert output.contains("pub global RK_PROG:");
    assert output.contains("pub global RK_EXPR:");
    // No non-pub `global RK_` line should remain.
    assert !output.contains("\nglobal RK_");
}

test "duplicate same-rule alt labels coalesce to one enum case (valid in ANTLR4)" {
    // ANTLR4 shares one context class across a repeated `# Label`, so the `<Rule>Alt`
    // enum emits it once, and the accessor maps every alt index to it.
    let input = "grammar Test;
e : e '+' e # Bin | e '-' e # Bin | INT # Num ;
INT : [0-9]+ ;
WS : [ \\t\\r\\n]+ -> skip ;
";
    let got = printed(input, "for let s of [\"1+2\", \"1-2\", \"3\"] {
    println(`${s} => ${parse_e(s).cst.e_alt(0):?}`);
}
");
    assert got == "1+2 => Option::Some(EAlt::Bin)\n1-2 => Option::Some(EAlt::Bin)\n3 => Option::Some(EAlt::Num)\n", got;
}

test "reserved-word alt labels are escaped to valid identifiers" {
    // A reserved-word label (`# else`) is escaped with `_` or it does not compile; a
    // label the prelude also names (`# Add`) lives in its enum and stays unchanged.
    let input = "grammar Test;
r : A # else | B # loop | C # Keep | D # Add ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
D : 'd' ;
";
    let got = printed(input, "for let s of [\"a\", \"b\", \"c\", \"d\"] {
    println(`${s} => ${parse_r(s).cst.r_alt(0):?}`);
}
");
    assert got == "a => Option::Some(RAlt::else_)
b => Option::Some(RAlt::loop_)
c => Option::Some(RAlt::Keep)
d => Option::Some(RAlt::Add)
", got;
}

test "generate parser not element" {
    let got = parses("grammar T;
a : ~COMMA EOF ;
COMMA : ',' ;
X : 'x' ;
", "a", ["x", ","]);
    assert got == "x => (a x)\n, => error\n", got;
}

test "generate scalar-labeled group `t=(a | b)`" {
    // Sets/ParserSet.txt: the op is a Group while the element is still
    // `Label(Group)`, so the walker peels the label before `gen_op_group`.
    let got = parses("grammar T; a : t=('x' | 'y') ; B : 'b' ;", "a", ["x", "y", "b"]);
    assert got == "x => (a x)\ny => (a y)\nb => error\n", got;
}

test "generate scalar-labeled wildcard repeat `t=.*`" {
    // A suffix binds outside the label, so this is Repeat(Label(Wildcard)):
    // the walker peels the Label inside the body, not at the Repeat itself.
    let got = parses("grammar T; a : t=.* ; A : 'a' ;", "a", ["", "a", "aa"]);
    assert got == " => a\na => (a a)\naa => (a a a)\n", got;
}

test "LR scan loop saves pos and backs off on a suffix failure" {
    // Both alts start with `a`, so a suffix scan can fail after its first token; the
    // loop then restores `pos` and stops, as ANTLR4 keeps the longest valid prefix.
    // The two `prog` alternatives share `statement`, so the dispatch scans it.
    let input = "grammar Test;
prog : statement 'x' EOF | statement 'y' EOF ;
statement : letterA | statement letterA 'b' ;
letterA : 'a' ;
";
    let got = parses(input, "prog", ["ax", "aaby", "aax"]);
    assert got == "ax => (prog (statement (letterA a)) x)
aaby => (prog (statement (statement (letterA a)) (letterA a) b) y)
aax => error
", got;
}

test "generate emits pub fn parse_<rule>(input) per parser rule" {
    // `parse_R(input)` is the start-rule API; `parse(input)` stays as the first rule's
    // alias, which driver tests and descriptors without a `[start]` call.
    let input = "grammar Test;
a : 'x' ;
b : 'y' ;
";
    let output = gen_source(input);
    assert output.contains("pub fn parse_a<S: AsStrSlice>(input: S");
    assert output.contains("pub fn parse_b<S: AsStrSlice>(input: S");
    // Each `parse_<rule>` hands its `_parse_<rule>` to the shared `_run_parse_entry`,
    // which builds the Parser and folds the error into the diagnostics.
    assert output.contains(
        "fn _run_parse_entry<S: AsStrSlice>(input: S, max_errors: i32, entry: fn(&mut Parser)) -> ParseResult",
    );
    assert output.contains("return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_a(p));");
    assert output.contains("return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_b(p));");
    // `pub fn parse` is a thin alias for the first rule's entry.
    assert output.contains("return parse_a(input, max_errors);");
}

test "trace option emits per-rule enter/ok/fail instrumentation" {
    // Tracing shows the recursive-descent path and the bail point on stderr
    // when a grammar rejects an input.
    let input = "grammar Test;
c : a a EOF ;
a : 'x' b ;
b : 'y' ;
";
    // The first error is recovered from; with none left to report, the second
    // fails every rule it is inside.
    let log = traced(input, "parse_c(\"xzxz\", 1)");
    assert log == "TRACE gale.trace: enter c @0 'x' rule=c pos=0
TRACE gale.trace:   enter a @0 'x' rule=a pos=0
TRACE gale.trace:     enter b @1 'z' rule=b pos=1
TRACE gale.trace:     ok b rule=b
TRACE gale.trace:   ok a rule=a
TRACE gale.trace:   enter a @2 'x' rule=a pos=2
TRACE gale.trace:     enter b @3 'z' rule=b pos=3
TRACE gale.trace:     FAIL b: expected 'y'; got \"z\" rule=b reason=expected 'y'; got \"z\"
TRACE gale.trace:   FAIL a: expected 'y'; got \"z\" rule=a reason=expected 'y'; got \"z\"
TRACE gale.trace: FAIL c: expected 'y'; got \"z\" rule=c reason=expected 'y'; got \"z\"
", log;

    // Default generation (trace off) must contain none of it — the feature
    // is strictly opt-in and adds zero instrumentation otherwise.
    let plain = gen_source(input);
    assert !plain.contains("trace_enter");
    assert !plain.contains("trace_depth");
    assert !plain.contains("core:log");
}

test "token-led overlap dispatch emits no per-alt scan helpers" {
    // The alts split on the second token, so prediction is a `peek_kind` dispatch
    // and the per-alt scan helpers would be dead.
    let input = "grammar T;
r : '{' a '}' | '{' '}' ;
a : 'x' ;
";
    let output = gen_source(input);
    // Both alts are reached (the group resolved, not collapsed)...
    assert output.contains("fn _parse_r__inner_alt_0(");
    assert output.contains("fn _parse_r__inner_alt_1(");
    // ...but neither scan helper is emitted.
    assert !output.contains("fn scan_r__alt_");

    // A shared-prefix tournament rule still emits its scan helpers, so the
    // gate is not over-pruning.
    let tinput = "grammar T;
s : X s Y? | X ;
X : 'X' ;
Y : 'Y' ;
";
    let tout = gen_source(tinput);
    assert tout.contains("fn scan_s__alt_0(");
}

test "an alternative's scan helper is emitted once for the scan and the parse" {
    // Alt 0 is contested in `scan_r`, so the scan side emits its function; the
    // parse side's tournament scans it too, and must call that function.
    let input = "grammar T;
s : r EOF ;
r : a X | A a Y | B a Z ;
a : (A|B)+ ;
A : 'A' ;
B : 'B' ;
X : 'X' ;
Y : 'Y' ;
Z : 'Z' ;
";
    let output = gen_source(input);
    assert output.split("fn scan_r__alt_0(").count() == 2, "defined once";
    assert output.contains("let _sd_p_0 = scan_r__alt_0(_sd_tokens, _sd_pos");
}

test "a scan never re-tests a token its guard already proved" {
    // `(',' b)*` enters on `','`, and `('*' | '/')` is one token out of two.
    let input = "grammar T;
s : r EOF ;
r : a | a X ;
a : b (',' b)* ('*' | '/') ;
b : Y ;
X : 'X' ;
Y : 'Y' ;
";
    let output = gen_source(input);
    let body = extract_fn_body(&output, "fn scan_a(");
    assert body.contains("while pos < tokens.len() && tokens[pos] == TK_LIT_COMMA");
    assert !body.contains("tokens[pos] != TK_LIT_COMMA"), `the loop guard proved ','\n${body}`;
    assert !body.contains("_best"), `a single-token alternation is a set test, not a tournament\n${body}`;
}

test "a token the dispatch decided is taken, not expected" {
    let input = "grammar T;
s : r EOF ;
r : A B | C B | t ;
t : A2 | C2 ;
A : 'A' ;
B : 'B' ;
C : 'C' ;
A2 : 'a' ;
C2 : 'c' ;
";
    let output = gen_source(input);
    let r = extract_fn_body(&output, "fn _parse_r__inner(");
    assert r.contains("p.take();"), r;
    assert !r.contains("p.expect(TK_A,"), `the dispatch proved A\n${r}`;
    assert r.contains("p.expect(TK_B,"), r;
    let t = extract_fn_body(&output, "fn _parse_t__inner(");
    assert t.contains("p.take();"), t;
    assert !t.contains("p.expect(kind"), `the dispatch proved the token\n${t}`;
}

test "a loop scans its body only where the token it enters on may also exit it" {
    // `fs`'s loop may end the rule, and `p` continues it with `','` too.
    let input = "grammar T;
s : e EOF | p EOF ;
e : t (('+' | '-') t)* ;
t : Y ;
p : '{' fs (',' '..')? '}' ;
fs : t (',' t)* ;
Y : 'Y' ;
";
    let output = gen_source(input);
    let e = extract_fn_body(&output, "fn _parse_e__inner(");
    assert e.contains("while !p.recovering && ("), e;
    assert e.contains("p.take();"), `the loop guard proved the operator\n${e}`;
    assert !e.contains("sync_alts"), `the loop guard proved the operator\n${e}`;
    let fs = extract_fn_body(&output, "fn _parse_fs__inner(");
    assert fs.contains("loop {"), fs;
}

test "a dispatch never re-tests the token its arm tested" {
    let input = "grammar T;
s : r e EOF ;
r : a | b ;
a : X Y* ;
b : X Y* Z ;
e : e '.' ID | e '.' ID '(' ')' | ID ;
X : 'x' ;
Y : 'y' ;
Z : 'z' ;
ID : [a-w]+ ;
";
    let output = gen_source(input);
    let mut prev = "";
    for let line of output.split("\n") {
        let t = line.trim().to_string();
        assert !(t.starts_with("if ") && t.ends_with("{") && t == prev), `nested re-test: ${t}`;
        prev = t;
    }
}

test "a scan tests a one-token rule inline, and trusts a callee that consumes" {
    let input = "grammar T;
s : (n | n K1)* EOF ;
n : a K2? ;
a : ID | k | '(' a ')' ;
k : K1 | K2 ;
ID : [a-z]+ ;
K1 : 'K' ;
K2 : 'J' ;
";
    let output = gen_source(input);
    let a = extract_fn_body(&output, "fn scan_a(");
    assert !a.contains("scan_k("), `the partition proved k's token\n${a}`;
    let n = extract_fn_body(&output, "fn scan_n(");
    assert !n.contains("scan_start"), `scan_a never matches empty\n${n}`;
}

test "a scan candidate that runs first does not rewind to where it is" {
    let input = "grammar T;
s : (a | a Z)* EOF ;
a : X | m ;
m : Y Y ;
X : 'x' ; Y : 'y' ; Z : 'z' ;
";
    let output = gen_source(input);
    let a = extract_fn_body(&output, "fn scan_a(");
    assert a.contains("scan_m("), a;
    assert !a.contains("pos = start;"), a;
}

test "a scan calls through a rule that only forwards to another" {
    let input = "grammar T;
s : (t | t Z)* EOF ;
t : n X ;
n : a ;
a : Y Y | X Y ;
X : 'x' ; Y : 'y' ; Z : 'z' ;
";
    let output = gen_source(input);
    let t = extract_fn_body(&output, "fn scan_t(");
    assert t.contains("scan_a("), t;
    assert !output.contains("fn scan_n("), output;
}

test "a decline check names each continuing token once" {
    let input = "grammar T;
s : (t | t X)* EOF ;
t : '(' fs? ')' ;
fs : f (',' f)* ','? ;
f : at* v? ty ;
at : '#' '[' ID ']' ;
v : 'pub' ;
ty : ID | '(' fs? ')' ;
X : 'x' ;
ID : [a-w]+ ;
";
    let output = gen_source(input);
    assert output.contains("decline_kind"), output;
    for let line of output.split("\n") {
        let terms: List<String> = line.split(" || ").map(|t| t.trim().to_string()).collect();
        for let i of 1..<terms.len() {
            assert terms[i] != terms[i - 1] || terms[i].contains("{"), `a repeated term: ${line}`;
        }
    }
}

test "a scan function nothing calls is not emitted" {
    let input = "grammar T;
s : a b EOF ;
a : X Y ;
b : (c | c Z)* ;
c : W+ ;
X : 'x' ; Y : 'y' ; Z : 'z' ; W : 'w' ;
";
    let output = gen_source(input);
    assert !output.contains("fn scan_a("), output;
    assert output.contains("fn scan_c("), output;
}

// Generating SQLite alone takes about the default five seconds.
#[timeout_ms(30000)]
test "every emitted FOLLOW mask is named by a call" {
    let output = gen_source(#include_str("../tests/grammars/SQLite.g4"));
    let mut masks = 0;
    for let line of output.split("\n") {
        if !line.starts_with("global FOLLOW_MASK_") {
            continue;
        }
        masks += 1;
        let name = line.split(":").next().unwrap().to_string().split(" ").last().unwrap().to_string();
        assert output.contains(`${name},`) || output.contains(`${name})`) || output.contains(`${name} `), `${name} is never named`;
    }
    assert masks > 0, "SQLite interns FOLLOW masks";
}

test "an optional takes the token its guard tested" {
    let input = "grammar T;
s : A B? (C D)? (E | F)? G EOF ;
A : 'a' ; B : 'b' ; C : 'c' ; D : 'd' ; E : 'e' ; F : 'f' ; G : 'g' ;
";
    let output = gen_source(input);
    let body = extract_fn_body(&output, "fn _parse_s__inner(");
    assert !body.contains("p.expect(TK_B"), body;
    assert !body.contains("p.expect(TK_C"), body;
    assert !body.contains("p.expect_set("), body;
    assert body.contains("p.expect(TK_D"), body;
}

test "an LR suffix takes the operator its arm tested" {
    let input = "grammar T;
s : e EOF ;
e : e '+' e | e '.' ID | e '.' ID '(' ')' | ID ;
ID : [a-z]+ ;
";
    let output = gen_source(input);
    let body = extract_fn_body(&output, "fn _parse_e__inner(");
    assert !body.contains("p.expect(TK_LIT_PLUS"), body;
    assert !body.contains("p.expect(TK_LIT_DOT"), body;
}

test "a prefix operator set takes the token its arm tested" {
    let input = "grammar T;
s : e EOF ;
e : e '*' e | ('-' | '!') e | ID ;
ID : [a-z]+ ;
";
    let output = gen_source(input);
    let body = extract_fn_body(&output, "fn _parse_e__inner_atom(");
    assert !body.contains("p.expect_set("), body;
}

test "a function that only forwards is not emitted" {
    let input = "grammar T;
s : (r | r X)* EOF ;
r : n | n Y | z ;
n : A B ;
z : A ;
A : 'a' ; B : 'b' ; X : 'x' ; Y : 'y' ;
";
    let output = gen_source(input);
    for let name of ["fn _parse_r__inner_alt_0(", "fn scan_r_alt_0(", "fn _parse_z__inner("] {
        assert !output.contains(name), output;
    }
}

test "a rule's @after is emitted once, whichever alternative finished" {
    let input = "grammar T;
options { language = Wado; }
r returns [i32 v]
    @after { p.emit(`a${$v}`); }
    : A { $v = 1; }
    | B { $v = 2; }
    | s
    | s C
    ;
s : A+ ;
A : 'a' ; B : 'b' ; C : 'c' ;
";
    let output = gen_source(input);
    assert count_occurrences(&output, "p.emit(`a${") == 1, output;
}

test "arms that emit the same body are one arm" {
    let input = "grammar T;
s : (l | l X)* e EOF ;
l : A | B | C D ;
e : e NOT? (L | G) e | e NOT N | ID ;
A : 'a' ; B : 'b' ; C : 'c' ; D : 'd' ; X : 'x' ; L : 'l' ; G : 'g' ; N : 'n' ; NOT : '!' ;
ID : [e-k]+ ;
";
    let output = gen_source(input);
    for let f of ["fn scan_l(", "fn _parse_l__inner("] {
        let body = extract_fn_body(&output, f);
        assert !body.contains("if kind == TK_A {"), body;
    }
    for let arm of ["suffix_kind == TK_L", "_sk == TK_L"] {
        assert !output.contains(arm), output;
    }
}

test "a group arm takes the token its branch tested" {
    let input = "grammar T;
s : (A B | C D) e EOF ;
e : e '*' e | e (X | Y Z) | e (Q ID)? '!' | ID ;
A : 'a' ; B : 'b' ; C : 'c' ; D : 'd' ; X : 'x' ; Y : 'y' ; Z : 'z' ; Q : 'q' ;
ID : [e-p]+ ;
";
    let output = gen_source(input);
    for let kind of ["TK_A", "TK_C", "TK_Y", "TK_Q"] {
        assert !output.contains(`p.expect(${kind},`), output;
    }
}

test "an element is bound only where an action reads it" {
    let input = "grammar T;
options { language = Wado; }
s : x=A B {let _ = $x;} ;
A : 'A' ;
B : 'B' ;
";
    let output = gen_source(input);
    let body = extract_fn_body(&output, "fn _parse_s__inner(");
    assert body.contains("let x = p.expect(TK_A"), body;
    assert body.contains("    p.expect(TK_B"), `nothing reads B\n${body}`;
}

test "trace option instruments the scan tournament and alt picks" {
    // `b X` vs `b Y` hides the deciding token inside `b`, so this is the scan
    // tournament; trace shows each alt's scan length and the winner.
    let input = "grammar T;
r : a EOF ;
a : b X
  | b Y
  ;
b : Z Z ;
X : 'X' ;
Y : 'Y' ;
Z : 'Z' ;
";
    let log = traced(input, "parse_r(\"ZZY\")");
    assert log.contains("scan a alt#0: fail rule=a alt=0 end=-1
TRACE gale.trace:       scan a alt#1: -> @3 rule=a alt=1 end=3
TRACE gale.trace:       pick a alt#1 rule=a alt=1
"), log;

    // Default generation (trace off) emits none of the decision-point hooks.
    let plain = gen_source(input);
    assert !plain.contains("trace_scan_alt");
    assert !plain.contains("trace_pick");
    assert !plain.contains("trace_try");
}

test "trace suppresses the pick line for all-single-token rules" {
    // `tok`'s pick is evident from the `enter` line's lookahead, so it is dropped;
    // `sub`'s alts consume structure, so its pick stays.
    let input = "grammar T;
r : tok sub EOF ;
tok : A | B | C ;
sub : A x | B ;
x : A ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
";
    let log = traced(input, "parse_r(\"baa\")");
    assert !log.contains("pick tok"), log;
    assert log.contains("pick sub alt#0"), log;
}

test "generate emits pub fn parse_<rule>(input) for LR rule with min_prec=0" {
    // LR rules' `_parse_expr` wrapper defaults `min_prec` to 0, so the public
    // entry admits every LR alt (historic `parse` behaviour).
    let input = "grammar Test;
expr : expr '+' expr | NUMBER ;
NUMBER : [0-9]+ ;
WS : [ \\t\\n]+ -> skip ;
";
    let output = gen_source(input);
    assert output.contains("pub fn parse_expr<S: AsStrSlice>(input: S");
    assert output.contains("return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_expr(p));");
}

/// The top-level fn that `header` opens, up to the next one. Fails when `output`
/// has none, so an assertion on the body cannot pass against nothing.
fn extract_fn_body<S: AsStrSlice, S1: AsStrSlice>(output: S, header: S1) -> String {
    let text = output.as_str_slice();
    let start = text.find(&header).expect(`no \`${header.as_str_slice()}\` in the generated source`);
    let rest = text.slice(start + header.len(), text.len());
    let end = start + header.len() + rest.find("\nfn ").unwrap_or(rest.len());
    return text.slice(start, end).to_string();
}

/// Fail unless `body` holds `first` and, after it, `then`.
fn assert_in_order<S: AsStrSlice, S1: AsStrSlice, W: AsStrSlice>(body: &String, first: S, then: S1, why: W) {
    let first_at = body.find(&first).expect(`no \`${first.as_str_slice()}\`: ${body}`);
    let then_at = body.find(&then).expect(`no \`${then.as_str_slice()}\`: ${body}`);
    assert first_at < then_at, `${why.as_str_slice()}: ${body}`;
}

test "lexer rule caseInsensitive=false overrides grammar-level true" {
    let input = "lexer grammar Test;
options { caseInsensitive = true; }
IF : 'if' ;
STRICT options { caseInsensitive = false; } : 'x' ;
WS : [ \\t]+ -> skip ;";
    let got = lexes(input, ["if IF iF x", "X"]);
    assert got == "if IF iF x => IF:if IF:IF IF:iF STRICT:x\nX => error:X\n", got;
}

test "lexer rule caseInsensitive=true enables CI when grammar-level absent" {
    let input = "lexer grammar Test;
KW options { caseInsensitive = true; } : 'go' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;";
    let got = lexes(input, ["go GO Go ab", "AB"]);
    assert got == "go GO Go ab => KW:go KW:GO KW:Go ID:ab\nAB => error:A error:B\n", got;
}

test "virtual tokens are marked and not match-generated" {
    // A virtual token (`tokens { }`, no lexer rule) gets a TK_ constant and a name,
    // tagged `// virtual`, but no `try_` matcher: the tokenizer never produces it.
    let input = "grammar Test;
tokens { VIRTUAL_TOK }
rule : ID ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;";
    let output = gen_source(input);
    assert output.contains("global TK_VIRTUAL_TOK: i32 = ") && output.contains(";  // virtual");
    assert output.contains("TK_VIRTUAL_TOK => \"VIRTUAL_TOK\",  // virtual");
    assert !output.contains("fn try_VIRTUAL_TOK(");
}

test "caseInsensitive does not fold non-letters" {
    let input = "lexer grammar Test;
options { caseInsensitive = true; }
DIGITS : [0-9]+ ;
SEMI : ';' ;";
    let output = gen_source(input);
    // Digit range must not be duplicated.
    assert output.contains("'0'..='9'");
    // Non-letter literal must not be duplicated — plain mismatch form.
    assert output.contains("chars[pos] != ';'");
    assert !output.contains("chars[pos].eq_ignore_ascii_case(");
}

test "metadata comment lists grammar-level options" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [
            GrammarOption { name: "language", value: OptionValue::Ident("Python") },
            GrammarOption { name: "superClass", value: OptionValue::Qualified(["my", "pkg", "BaseParser"]) },
            GrammarOption { name: "tokenVocab", value: OptionValue::Ident("TestLexer") },
            GrammarOption { name: "caseInsensitive", value: OptionValue::Ident("true") },
            GrammarOption { name: "contextSuperClass", value: OptionValue::Qualified(["my", "pkg", "Ctx"]) },
        ],
        named_actions: [],
        pending_refs: [],
        source_files: [],
        parser_superclass: "BaseParser",
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("// Grammar metadata from source .g4 prequels:");
    assert output.contains("//   option language = Python");
    assert output.contains("//   option superClass = BaseParser (parser)");
    assert !output.contains("//   option superClass = my.pkg.BaseParser");
    assert output.contains("//   option tokenVocab = TestLexer");
    assert output.contains("//   option caseInsensitive = true");
    assert output.contains("//   option contextSuperClass = my.pkg.Ctx");
}

test "metadata comment formats string and int option values" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [
            GrammarOption { name: "tokenVocab", value: OptionValue::Str("foo.g4") },
            GrammarOption { name: "k", value: OptionValue::Int(3) },
            GrammarOption { name: "init", value: OptionValue::Action(ActionSource { text: "some code;" }) },
        ],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("//   option tokenVocab = \"foo.g4\"");
    assert output.contains("//   option k = 3");
    assert output.contains("//   option init = { ... }");
}

test "metadata comment lists named actions" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [
            NamedAction { scope: null, name: "header" },
            NamedAction { scope: Option::<String>::Some("parser"), name: "members" },
            NamedAction { scope: Option::<String>::Some("lexer"), name: "members" },
        ],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("// Grammar metadata from source .g4 prequels:");
    assert output.contains("//   @header");
    assert output.contains("//   @parser::members");
    assert output.contains("//   @lexer::members");
}

test "metadata block omitted when no options and no named actions" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert !output.contains("// Grammar metadata from source .g4 prequels:");
}

test "visibility comment emitted on non-default parser rule" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [
            ParserRule {
                name: "expr",
                visibility: Visibility::Public,
                options: [],
                alternatives: [
                    Alternative {
                        label: null,
                        options: [],
                        elements: [Element::TokenRef(TokenRefElement::new("ID"))],
                    },
                ],
            },
            ParserRule {
                name: "plain",
                visibility: Visibility::Default,
                options: [],
                alternatives: [
                    Alternative {
                        label: null,
                        options: [],
                        elements: [Element::TokenRef(TokenRefElement::new("ID"))],
                    },
                ],
            },
        ],
        lexer_rules: [LexerRule::new("ID", false, false, [])],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("// rule visibility: public (ignored by codegen, matches ANTLR4)");
    // Default visibility must not add any comment.
    assert !output.contains("// rule visibility: default");
}

test "visibility comment emitted on non-default lexer rule" {
    let mut id_rule = LexerRule::new("ID", false, false, []);
    id_rule.visibility = Visibility::Protected;
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [id_rule],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("// rule visibility: protected (ignored by codegen, matches ANTLR4)");
}

test "single-char literal lexer rule without an identifier carrier emits its own try_ matcher" {
    // The keyword classifier runs only after a longer carrier rule matched, and
    // this grammar has none, so single-letter literals keep their own matcher.
    let input = "grammar Test;
r : A B ;
A : 'A' ;
B : 'B' ;
WS : [ \\t\\n\\r]+ -> skip ;
";
    let output = gen_source(input);
    assert output.contains("fn try_A(");
    assert output.contains("fn try_B(");
    assert output.contains("'A' => {");
    assert output.contains("'B' => {");
}

test "set list-label `name+=(A | B)*` takes the token its loop guard proved" {
    let input = "grammar T;
b : ID val+=(INT | FLOAT)* ;
ID : 'a'..'z'+ ;
INT : '0'..'9'+ ;
FLOAT : [0-9]+ '.' [0-9]+ ;
WS : (' '|'\\n') -> skip ;
";
    let output = gen_source(input);
    let body = extract_fn_body(&output, "fn _parse_b__inner(");
    assert body.contains("while !p.recovering && (_kind_set_0(p.peek_kind()))"), body;
    assert body.contains("p.take();"), body;
    assert !body.contains("expect_set"), body;
}

test "a sync set is tested as bits, and listed only where a diagnostic names it" {
    let output = gen_source("grammar T;\ns : A B C EOF ;\nA : 'a' ;\nB : 'b' ;\nC : 'c' ;\n");
    assert output.contains("global SYNC_0: List<i32> = [2];"), output;
    assert !output.contains("global EXPECTED_"), output;
    assert !output.contains("fn in_set("), output;
}

test "non-greedy optional (??) emits Option<T> + single if" {
    let input = "grammar T;
start : statement+ EOF ;
statement : 'x' | ifStmt ;
ifStmt : 'if' 'y' statement ('else' statement)?? ;
";
    let output = gen_source(input);
    let body = extract_fn_body(&output, "fn _parse_if_stmt__inner(");
    // The `??` enter/skip decision is the ATN simulator's, stamped at compile time,
    // so the shape stays one `if` whose condition is the simulator call.
    assert body.contains("if atn_predict_once(&ATN_SIM,");
    assert body.contains(") == 1");
    assert !body.contains("atn_ng_optional_enter(");
    assert !body.contains("if p.peek_kind() == TK_LIT_else");
    assert !body.contains("while p.peek_kind() == TK_LIT_else");
}

test "single-char literal with an ID carrier stays a keyword (no try_ matcher)" {
    // `ID` covers 'A' as a first character, so the keyword classifier is reachable
    // and `A` needs no `try_A` of its own.
    let input = "grammar Test;
r : A ID ;
A : 'A' ;
ID : [a-zA-Z]+ ;
WS : [ \\t\\n\\r]+ -> skip ;
";
    let output = gen_source(input);
    assert !output.contains("fn try_A(");
    assert output.contains("classify_keyword");
}

test "generate returns source and lowering diagnostics from one lowering" {
    // Both alts start with `A`, so lowering raises one OverlapTournament; `generate`
    // returns it on `GeneratedOutput` so `gale gen` need not lower twice.
    let input = "grammar Test;
r : A B | A C ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
";
    let generated = gen(input);
    assert generated.diagnostics.len() == 1, `expected 1 diagnostic, got ${generated.diagnostics.len()}`;
    let d = &generated.diagnostics[0];
    assert d.owner.rule == "r", `expected the diagnostic to own rule "r", got "${d.owner.rule}"`;
    if let OverlapTournament = &d.kind {
    } else {
        panic("expected DiagnosticKind::OverlapTournament");
    }
}

test "one alternative overlaps nothing, whatever it admits" {
    let input = "grammar Test;
e : e '+' A | . ;
A : 'a' ;
";
    let generated = gen(input);
    assert generated.diagnostics.is_empty(), `a lone alternative has nothing to overlap: ${generated.diagnostics[0].message}`;
}

test "generate raises no diagnostics for disjoint alts" {
    let input = "grammar Test;
r : A | B ;
A : 'a' ;
B : 'b' ;
";
    let generated = gen(input);
    assert generated.diagnostics.is_empty(), `expected no diagnostics, got ${generated.diagnostics.len()}`;
}

test "an optional group's entry guard is the scan its dispatch decides on" {
    // Alts 0 and 2 share FIRST, so entry and choice are one longest-match question:
    // each alt is scanned once, and the dispatch reads the entry guard's winner.
    let input = "grammar Test;
stmt : 'k' ( a | b | a '.' b )? ;
a : A+ ;
b : B+ ;
A : 'a' ;
B : 'b' ;
";
    let output = gen_source(input);
    let body = extract_fn_body(&output, "fn _parse_stmt__inner(");
    let scans_a = count_occurrences(&body, "scan_a(");
    let scans_b = count_occurrences(&body, "scan_b(");
    assert scans_a == 2, `alts 0 and 2 name 'a' once each; scanned it ${scans_a} times`;
    assert scans_b == 2, `alts 1 and 2 name 'b' once each; scanned it ${scans_b} times`;
}

// `??` in an LR atom: its ATN prediction runs under the live `min_prec`, so an
// enter edge that would climb a lower LR suffix is pruned.
global QQ_IN_LR_G4: String = "
grammar T;
e : e '+' e | ID ('x')?? ;
ID : 'a'..'z'+ ;
WS : ' ' -> skip ;
";

test "non-greedy ?? inside a left-recursive rule threads min_prec" {
    let output = gen_source(QQ_IN_LR_G4);
    // The atom fn carries `min_prec`, and the `??` enter check forwards it
    // to the simulator (stamped decision number, `== 1` for ENTER).
    assert output.contains("fn _parse_e__inner_atom(p: &mut Parser, min_prec: i32");
    assert output.contains(", &mut p.atn, &p.kinds, p.pos, TK_EOF, min_prec) == 1");
    assert output.contains("atn_predict_once(&ATN_SIM,");
}

// A multi-alt `AtEndConflict` must route through the ATN simulator, not the
// `_sd_best_i` longest-match tournament.
global AT_END_CONFLICT_G4: String = "
grammar T;
s : x 'c' ;
x : 'a' 'b' | 'a' 'b' 'c' ;
WS : ' ' -> skip ;
";

global AT_END_DISJOINT_G4: String = "
grammar T;
s : x 'd' ;
x : 'a' 'b' | 'a' 'b' 'c' ;
WS : ' ' -> skip ;
";

test "FOLLOW-disjoint at-end conflict keeps the static tournament" {
    let output = gen_source(AT_END_DISJOINT_G4);
    let body = extract_fn_body(&output, "fn _parse_x__inner(");
    assert body.contains("_sd_best_i");
    assert !body.contains("atn_predict");
    assert !output.contains("global ATN_SIM");
}

global AT_END_WILDCARD_FOLLOW_G4: String = "
grammar T;
s : x . ;
x : 'a' 'b' | 'a' 'b' 'c' ;
WS : ' ' -> skip ;
";

test "a wildcard after the call leaves an at-end conflict to the token after it" {
    // Only the token after `x`'s longer alternative tells them apart.
    let got = parses(AT_END_WILDCARD_FOLLOW_G4, "s", ["a b c", "a b c a", "a b a"]);
    assert got == "a b c => (s (x a b) c)\na b c a => (s (x a b c) a)\na b a => (s (x a b) a)\n", got;
}

global LOOP_AFTER_NULLABLE_CALL_G4: String = "
grammar T;
s : a ws (c a ws)* '{' ;
c : '>' ws | SP ws ;
a : ID | '.' ID ;
ws : SP* ;
SP : ' ' ;
ID : [a-z]+ ;
";

test "a nullable callee yields a token to the caller loop that follows it" {
    // css3's `selector`: the `SP` after `x` is the descendant combinator, which
    // only another iteration of the caller's loop takes.
    let got = parses(LOOP_AFTER_NULLABLE_CALL_G4, "s", ["x y{", "x .y {", "x > y {", "x {"]);
    assert got == "x y{ => (s (a x) ws (c   ws) (a y) ws {)\nx .y { => (s (a x) ws (c   ws) (a . y) (ws  ) {)\nx > y { => (s (a x) (ws  ) (c > (ws  )) (a y) (ws  ) {)\nx { => (s (a x) (ws  ) {)\n", got;
}

global OPTIONAL_TOKEN_ALSO_NAME_G4: String = "
grammar T;
s : '{' m (';' m)* '}' ;
m : RO? name '?'? (':' ID)? ;
name : ID | RO ;
RO : 'readonly' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "an optional token that can also start what follows it is taken on the second token" {
    // TypeScript's `ReadOnly? propertyName`, where `readonly` is a name too.
    let got = parses(OPTIONAL_TOKEN_ALSO_NAME_G4, "s", [
        "{readonly id: x}", "{readonly: x}", "{readonly}", "{readonly id}", "{readonly readonly}", "{a; readonly b: x}",
    ]);
    assert got == "{readonly id: x} => (s { (m readonly (name id) : x) })\n{readonly: x} => (s { (m (name readonly) : x) })\n{readonly} => (s { (m (name readonly)) })\n{readonly id} => (s { (m readonly (name id)) })\n{readonly readonly} => (s { (m readonly (name readonly)) })\n{a; readonly b: x} => (s { (m (name a)) ; (m readonly (name b) : x) })\n", got;
}

global OPTIONAL_SEPARATOR_AFTER_LIST_G4: String = "
grammar T;
s : '{' body? '}' ;
body : list ';'? ;
list : m (';' m)* ;
m : RO? name (':' ID)? ;
name : ID | RO ;
RO : 'readonly' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "a probe accepts a token an optional suffix of its caller can take" {
    // TypeScript's `typeBody : typeMemberList (SemiColon | ',')?`: the `;`
    // after the last member is the suffix's, which the gate does not spell.
    let got = parses(OPTIONAL_SEPARATOR_AFTER_LIST_G4, "s", [
        "{readonly id: x;}", "{readonly id: x}", "{a; readonly b;}", "{readonly;}",
    ]);
    assert got == "{readonly id: x;} => (s { (body (list (m readonly (name id) : x)) ;) })\n{readonly id: x} => (s { (body (list (m readonly (name id) : x))) })\n{a; readonly b;} => (s { (body (list (m (name a)) ; (m readonly (name b))) ;) })\n{readonly;} => (s { (body (list (m (name readonly))) ;) })\n", got;
}

global TAIL_OPTIONAL_RECURSION_G4: String = "
grammar T;
s : e ';' ;
e : e '(' ')' | ID e? | '(' ')' '=>' ID ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "a tail optional enters only where its body can match" {
    // TypeScript's `identifierName singleExpression?`: `(` may begin an arrow
    // function, and in `f()` it begins the call's arguments instead.
    let got = parses(TAIL_OPTIONAL_RECURSION_G4, "s", ["f();", "f () => x;", "f g;", "f g();"]);
    assert got == "f(); => (s (e (e f) ( )) ;)\nf () => x; => (s (e f (e ( ) => x)) ;)\nf g; => (s (e f (e g)) ;)\nf g(); => (s (e f (e (e g) ( ))) ;)\n", got;
}

test "an optional probe that scans the rest of an alternative ends its scan" {
    let output = gen_source("
grammar T;
s : a ';' ;
a : 'b'? c | c 'd' ;
c : 'b'* 'c' 'c' ;
WS : ' ' -> skip ;
");
    let body = extract_fn_body(&output, "fn scan_a__alt_0(");
    assert body.contains("cont_done_"), `a probe that holds scans \`c\` once: ${body}`;
}

global TAIL_OPTIONAL_IN_TOURNAMENT_ATOM_G4: String = "
grammar T;
s : 'x' '=' e ';' ;
e : e '(' ')' | ID e? | ID '.' ID | '(' ')' '=>' ID ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "a tail optional in a contested atom alternative sees the suffix loop" {
    // TypeScript's `l: X = f();` in a class body: the caller's `;` cannot
    // start at `(`, but the call suffix can, so `(` is no arrow function.
    let got = parses(TAIL_OPTIONAL_IN_TOURNAMENT_ATOM_G4, "s", [
        "x = f();", "x = f () => y;", "x = a.b();", "x = f g();",
    ]);
    assert got == "x = f(); => (s x = (e (e f) ( )) ;)\nx = f () => y; => (s x = (e f (e ( ) => y)) ;)\nx = a.b(); => (s x = (e (e a . b) ( )) ;)\nx = f g(); => (s x = (e f (e (e g) ( ))) ;)\n", got;
}

global TAIL_OPTIONAL_BEFORE_ITS_FOLLOW_G4: String = "
grammar T;
s : '(' e ID e ')' ;
e : ID e? ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "a tail optional whose follow also matches enters while entering stays viable" {
    // TypeScript's `for (const x of list)`: `x of` starts the continuation
    // `identifier expressionSequence`, and ANTLR4 still enters at `x`.
    let got = parses(TAIL_OPTIONAL_BEFORE_ITS_FOLLOW_G4, "s", ["(a b c)", "(a b c d)", "(a b c d e)"]);
    assert got == "(a b c) => (s ( (e a) b (e c) ))\n(a b c d) => (s ( (e a (e b)) c (e d) ))\n(a b c d e) => (s ( (e a (e b (e c))) d (e e) ))\n", got;
}

global LOOP_BODY_CALL_G4: String = "
grammar T;
s : '{' cs? ('default' ':' cs?)? '}' ;
cs : c+ ;
c : 'case' ID ':' st* ;
st : ID ';' | 'case' ID ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "a rule that is a loop's whole body hears the loop's next iteration" {
    // TypeScript's `caseClauses : caseClause+`: a clause's statements stop at
    // the next `case b :`, which only the loop around the clause knows about.
    let got = parses(LOOP_BODY_CALL_G4, "s", [
        "{ case a: x; case b: y; }", "{ case a: case b: y; default: case c: z; }", "{ case a: case b x; }",
    ]);
    assert got == "{ case a: x; case b: y; } => (s { (cs (c case a : (st x ;)) (c case b : (st y ;))) })\n{ case a: case b: y; default: case c: z; } => (s { (cs (c case a :) (c case b : (st y ;))) default : (cs (c case c : (st z ;))) })\n{ case a: case b x; } => (s { (cs (c case a : (st case b) (st x ;))) })\n", got;
}

global LOOP_ENDING_RULE_G4: String = "
grammar T;
s : '{' cs? ('default' ':' st*)? '}' ;
cs : c+ ;
c : 'case' ID ':' sl? ;
sl : st+ ;
st : e ';'? ;
e : ID | 'default' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "a loop ending its rule declines an iteration its caller's token would strand" {
    // TypeScript's `statementList : statement+` inside a case clause: `default`
    // is a one-token statement, and taking it leaves `:` to nobody.
    let got = parses(LOOP_ENDING_RULE_G4, "s", [
        "{ case a: x; default: y; }", "{ case a: default; }", "{ case a: x default: y }", "{ case a: default }",
    ]);
    assert got == "{ case a: x; default: y; } => (s { (cs (c case a : (sl (st (e x) ;)))) default : (st (e y) ;) })\n{ case a: default; } => (s { (cs (c case a : (sl (st (e default) ;)))) })\n{ case a: x default: y } => (s { (cs (c case a : (sl (st (e x))))) default : (st (e y)) })\n{ case a: default } => (s { (cs (c case a : (sl (st (e default))))) })\n", got;
}

global TAIL_TOKEN_OPTIONAL_G4: String = "
grammar T;
m : base name ';' ;
base : 'static'? 'readonly'? ;
name : ID | 'readonly' | 'static' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "a tail token optional enters while entering stays viable" {
    // TypeScript's `propertyMemberBase : ... ReadOnly?` ahead of a
    // `propertyName` that `readonly` also spells.
    let got = parses(
        TAIL_TOKEN_OPTIONAL_G4,
        "m",
        ["readonly x;", "readonly;", "static readonly;", "static readonly x;"],
    );
    assert got == "readonly x; => (m (base readonly) (name x) ;)\nreadonly; => (m base (name readonly) ;)\nstatic readonly; => (m (base static) (name readonly) ;)\nstatic readonly x; => (m (base static readonly) (name x) ;)\n", got;
}

global TAIL_TOKEN_UNKNOWN_CALLER_G4: String = "
grammar T;
s : f+ EOF ;
f : 'fn' ID ret? w? (blk | ';') ;
ret : '->' ty ;
w : 'where' ID ':' ty ;
ty : tnb | tp '+' tp ;
tnb : tp | '&' tnb | '(' ty ')' ;
tp : '::'? seg ('::' seg)* ;
seg : ID '::'? ('<' ty '>' | '(' ')')? ;
blk : '{' '}' ;
ID : [a-zA-Z]+ ;
WS : ' ' -> skip ;
";

// The rejection case for the test above. Rust's `typePathSegment : ...
// PATHSEP? (genericArgs | typePathFn)?`, reached through rules that pass on no
// continuation: what the caller resumes with is unknown, so it cannot overturn
// the path's own `:: segment`.
test "a tail token optional yields to a definite continuation its unknown caller cannot overturn" {
    let got = parses(TAIL_TOKEN_UNKNOWN_CALLER_G4, "s", [
        "fn f -> a::T {}", "fn f -> a::T;", "fn f -> ::a::T<X> {}", "fn f -> a:: T where T: a::b {}",
    ]);
    assert got == "fn f -> a::T {} => (s (f fn f (ret -> (ty (tnb (tp (seg a) :: (seg T))))) (blk { })))\nfn f -> a::T; => (s (f fn f (ret -> (ty (tnb (tp (seg a) :: (seg T))))) ;))\nfn f -> ::a::T<X> {} => (s (f fn f (ret -> (ty (tnb (tp :: (seg a) :: (seg T < (ty (tnb (tp (seg X)))) >))))) (blk { })))\nfn f -> a:: T where T: a::b {} => (s (f fn f (ret -> (ty (tnb (tp (seg a) :: (seg T))))) (w where T : (ty (tnb (tp (seg a) :: (seg b))))) (blk { })))\n", got;
}

// The two parenthesised atoms share `'(' e`, so the tournament scans the inner
// `e` once per candidate. Unless a scan of `e` is answered once per reading,
// every level doubles the work, and forty levels never finish.
test "a nested operand is scanned once per reading, not once per enclosing candidate" {
    let grammar = "grammar T;
s : e EOF ;
e : e '+' e | '(' e ')' | '(' e ',' e ')' | ID ;
ID : [a-z]+ ;
";
    let mut input = "a";
    let mut tree = "(e a)";
    for let _ of 0..<40 {
        input = `(${input})`;
        tree = `(e ( ${tree} ))`;
    }
    let got = parses(grammar, "s", [input]);
    assert got == `${input} => (s ${tree})\n`, got;
}

global LR_ATOM_OPERAND_G4: String = "
grammar T;
s : e ';' ;
e : 'new' e '<'? args
  | 'new' e
  | e args
  | e '.' ID
  | ID
  ;
args : '(' ')' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "an operand inside an atom climbs only while its own continuation stays viable" {
    // TypeScript's `New singleExpression typeArguments? arguments`: the
    // operand's call suffix would take the arguments the `new` still owes.
    let got = parses(LR_ATOM_OPERAND_G4, "s", ["new a();", "new a;", "new a.b();", "new a()();"]);
    assert got == "new a(); => (s (e new (e a) (args ( ))) ;)\nnew a; => (s (e new (e a)) ;)\nnew a.b(); => (s (e new (e (e a) . b) (args ( ))) ;)\nnew a()(); => (s (e new (e (e a) (args ( ))) (args ( ))) ;)\n", got;
}

// The prefix atom's trailing operand is the atom's own, not a suffix's, and it
// owes `new` its arguments just the same. `'-' e '!'` puts the prefix atom in an
// overlap group, so the operand sits in a per-alternative helper.
test "a prefix atom's operand inside an atom leaves the arguments its enclosing atom owes" {
    let grammar = "grammar T;
s : e ';' ;
e : e args | 'new' e args | '-' e | '-' e '!' | ID ;
args : '(' ')' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";
    let got = parses(grammar, "s", ["new -a();", "-a();"]);
    assert got == "new -a(); => (s (e new (e - (e a)) (args ( ))) ;)\n-a(); => (s (e - (e (e a) (args ( )))) ;)\n", got;
}

global OPEN_READING_BEHIND_PREFIX_G4: String = "
grammar T;
s : d ';' ;
d : ID '=' e ('!' ID)? ;
e : e '(' ')' | e '.' ID | a | ID ;
a : '[' l ']' ;
l : ','* el? (','+ el)* ','* ;
el : e ','? ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "an open reading behind a prefix admits only what the prefix starts with" {
    // TypeScript's `arrayElement : ... ','?` in an initializer an optional
    // follows: the list's `]` comes first, so the `,` before `c` is the next
    // element's, not a trailing one.
    let got = parses(OPEN_READING_BEHIND_PREFIX_G4, "s", ["x = [b, c];", "x = [b,, c,];", "x = [b] ! y;"]);
    assert got == "x = [b, c]; => (s (d x = (e (a [ (l (el (e b)) , (el (e c))) ]))) ;)\nx = [b,, c,]; => (s (d x = (e (a [ (l (el (e b) ,) , (el (e c) ,)) ]))) ;)\nx = [b] ! y; => (s (d x = (e (a [ (l (el (e b))) ])) ! y) ;)\n", got;
}

test "a rule entry claims its call site's return state before returning early" {
    // Claimed after, a recovering entry would leave the stamp to the next
    // call from a site that stamps none.
    let output = gen_source(AT_END_CONFLICT_G4);
    let body = extract_fn_body(&output, "fn _parse_x(");
    assert body.find("p.atn_ret_pending = -1;").unwrap() < body.find("if p.recovering").unwrap(), body;
}

test "non-LR ATN grammar carries prediction without the LR tables" {
    let output = gen_source(AT_END_CONFLICT_G4);
    assert output.contains("global ATN_SIM: AtnSim = atn_decode(&b\"");
    assert !output.contains("atn_with_lr_tables");
    assert output.contains("pub fn atn_predict_with_stack(");
    assert !output.contains("fn atn_lr_loop_decision(");
}

global LATN_ONLY_G4: String = "
grammar T;
s : ID* EOF ;
ID : [a-z]+ ;
COMMENT : '/*' (COMMENT | .)*? '*/' -> skip ;
WS : ' ' -> skip ;
";

test "a lexer-ATN-only grammar carries the decoder and no parser simulator" {
    let output = gen_source(LATN_ONLY_G4);
    assert output.contains("pub fn latn_match(");
    assert output.contains("pub fn atn_decode(");
    assert !output.contains("fn atn_predict_with_stack(");
    assert !output.contains("struct CtxArena");
    assert !output.contains("fn atn_lr_loop_decision(");
}

test "runtime standard-library imports sit at the top of the file" {
    let output = gen_source(LATN_ONLY_G4);
    let std_use = output.find("use { HashMap, HashSet, HashSeed } from \"core:collections\";").unwrap();
    assert std_use < output.find("pub struct Span").unwrap();
}

global LR_WILDCARD_CODEGEN_G4: String = "
grammar T;
prog : e EOF ;
e : e '+' e | e . | INT ;
INT : [0-9]+ ;
WS : ' ' -> skip ;
";

test "ATN-class LR grammar keeps the decoder's LR tables" {
    let output = gen_source(LR_WILDCARD_CODEGEN_G4);
    assert output.contains("global ATN_SIM: AtnSim = atn_with_lr_tables(atn_decode(&b\"");
    assert output.contains("pub fn atn_lr_loop_decision(");
}

// TypeScript's `typeParameter` shape: every first token of `id` leads to the same
// depth-1 sub-dispatch, so the branches fold into one over their union.
global SHARED_SUBDISPATCH_G4: String = "
grammar T;
tp : id c? | id '=' t | '<' tp '>' ;
id : A | B | C ;
c : 'extends' t ;
t : A ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
WS : [ \\t\\r\\n]+ -> skip ;
";

// `C?` is nullable, so the follow reaches past the rule into the caller's FOLLOW.
// The local `C` is only a prefix of the answer.
global INEXACT_FOLLOW_EMPTY_ALT_G4: String = "
grammar T;
s : r SEMI EOF ;
r : ( A | | B ) C? ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
SEMI : ';' ;
";

// `A` and `A B` overlap, so the rule takes the overlap dispatch rather than
// the token-led one — a second rule-level emitter, with its own arms.
global RULE_OVERLAP_EMPTY_ALT_G4: String = "
grammar T;
x : | A | A B ;
A : 'a' ;
B : 'b' ;
";

// The `.` sits behind a nullable prefix, so the alternative has a first set
// (`{A}`) and is still open-ended: `c` reaches the wildcard.
global PREFIXED_WILDCARD_ALT_G4: String = "
grammar T;
s : ( A? . | B ) EOF ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
";

// The epsilon alternative reached through a rule must earn the same follow-set
// branch a written-empty one does.
global INDIRECT_EPSILON_ADMITS_G4: String = "
grammar T;
s : 'k' ( A | x | B ) EOF ;
x : ;
A : 'a' ;
B : 'b' ;
";

// `x` derives only epsilon, but through a rule reference — the mirror of an
// open-ended alternative reached the same way.
global INDIRECT_EPSILON_ALT_G4: String = "
grammar T;
s : ( x | A ) B EOF ;
x : ;
A : 'a' ;
B : 'b' ;
";

// `w` is open-ended, but through a rule reference: its first set is empty for
// the same reason a surface `.`'s is, and it is not the empty alternative.
global INDIRECT_WILDCARD_ALT_G4: String = "
grammar T;
s : w EOF # Wild
  | A EOF # Named
  ;
w : . ;
A : 'a' ;
";

// ANTLR4 takes the lowest viable alternative, so `. EOF` wins over `A EOF` on `a`.
// Unlike an empty alternative, a wildcard-led one must not be reordered.
global WILDCARD_FIRST_ALT_G4: String = "
grammar T;
s : . EOF # Wild
  | A EOF # Named
  ;
A : 'a' ;
";

// A rule's own alternatives are a decision too, and an empty one among them is
// selected by no lookahead.
global RULE_LEVEL_EMPTY_ALT_G4: String = "
grammar T;
x : A | | B ;
A : 'a' ;
B : 'b' ;
";

// An LR suffix's group body is walked by the op-only walker, which reads the
// dispatch lower baked rather than the surface alternatives.
global OP_WALKER_EMPTY_ALT_G4: String = "
grammar T;
e : e ( A x | | B x ) | C ;
x : C ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
";

test "an empty alternative keeps its fallback where the follow set is a prefix" {
    // A follow set the caller's FOLLOW still extends names only part of what selects
    // the empty alternative; as the whole set it rejects `;`, a legal parse.
    let got = parses(INEXACT_FOLLOW_EMPTY_ALT_G4, "s", [";", "c;", "a;", "bc;"]);
    assert got == "; => (s r ;)\nc; => (s (r c) ;)\na; => (s (r a) ;)\nbc; => (s (r b c) ;)\n", got;
}

test "the overlap rule dispatch orders its fallback last too" {
    // The follow set is exact, so the empty alternative is also tested by name;
    // its unconditional arm is still the last.
    let got = parses(RULE_OVERLAP_EMPTY_ALT_G4, "x", ["", "a", "ab"]);
    assert got == " => x\na => (x a)\nab => (x a b)\n", got;
}

test "a wildcard behind a nullable prefix still makes its alternative open-ended" {
    // Having a first set does not settle it: `A? .` is selected by `a` and also
    // by every other token, so partitioning by `{A}` leaves `c` no alternative.
    let got = parses(PREFIXED_WILDCARD_ALT_G4, "s", ["c", "ac", "a", "b"]);
    assert got == "c => (s c)\nac => (s a c)\na => (s a)\nb => (s b)\n", got;
}

test "an epsilon alternative earns its follow set however it is spelled" {
    // Which alternative earns the follow set is nullability's answer, not an
    // element count: `( A | x | B )` gets the branch `( A | | B )` gets.
    let got = parses(INDIRECT_EPSILON_ADMITS_G4, "s", ["k", "ka", "kb", "kc"]);
    assert got == "k => (s k x)
ka => (s k a)
kb => (s k b)
kc => error
", got;
}

test "an alternative that derives only epsilon through a rule is selected by its follow" {
    // `x` matches nothing, so what follows selects it, as for a written-empty one.
    // ANTLR4 parses `b` as `(s x b)` and `a b` as `(s a b)`.
    let got = parses(INDIRECT_EPSILON_ALT_G4, "s", ["b", "ab"]);
    assert got == "b => (s x b)\nab => (s a b)\n", got;
}


// The root's alternative, which the tree alone does not show when every
// alternative builds the same one.
global ROOT_ALT: String = "let r = parse_s(\"a\");
println(`${to_string_tree(&r)} ${r.cst.s_alt(0):?}`);
";

test "an alternative open-ended through a rule keeps its index too" {
    // An empty first set does not say which element produced it: reading the
    // elements catches a `.` written in place but not one reached through `w`.
    let got = printed(INDIRECT_WILDCARD_ALT_G4, ROOT_ALT);
    assert got == "(s (w a)) Option::Some(SAlt::Wild)\n", got;
}

test "a wildcard alternative keeps its index against a narrower one" {
    // It admits everything, `a` included, so it competes wherever the narrower
    // alternative does and the tie is its — lowest viable alternative wins.
    let got = printed(WILDCARD_FIRST_ALT_G4, ROOT_ALT);
    assert got == "(s a) Option::Some(SAlt::Wild)\n", got;
}

// `A? .` admits every token yet still has the first set `{A}`, which the unions
// built over the group's classes need.
global OPEN_ENDED_WITH_FIRST_G4: String = "
grammar T;
s : r EOF ;
r : ( A? . | B )+ ;
A : 'a' ;
B : 'b' ;
";

test "an open-ended alternative still contributes the first set it does have" {
    // The `no viable alternative` expected list and its SYNC set are unions over
    // the group's classes, so both must include an open-ended alternative's tokens.
    let output = gen_source(OPEN_ENDED_WITH_FIRST_G4);
    let both = ": List<i32> = [TK_A, TK_B];";
    assert output.contains(both), `expected ${both}, got: ${output}`;
}

test "a rule's empty alternative does not shadow the ones after it" {
    // A rule's arms are guarded `if`s that return, so an unconditional one shadows
    // the rest unless it comes after every arm a lookahead can select.
    let got = parses(RULE_LEVEL_EMPTY_ALT_G4, "x", ["a", "b", ""]);
    assert got == "a => (x a)\nb => (x b)\n => x\n", got;
}

test "the op walker's undecided chain keeps every alternative reachable" {
    // The op walker reads lower's baked branches, where an alternative no
    // lookahead selects has an empty token set, which would become `true` again.
    let got = parses(OP_WALKER_EMPTY_ALT_G4, "e", ["c", "cac", "cbc"]);
    assert got == "c => (e c)\ncac => (e (e c) a (x c))\ncbc => (e (e c) b (x c))\n", got;
}

test "dispatch branches sharing a sub-dispatch are emitted once" {
    let output = gen_source(SHARED_SUBDISPATCH_G4);
    let body = extract_fn_body(&output, "fn _parse_tp__inner(");
    let copies = count_occurrences(&body, "p.peek_at(1)");
    assert copies > 0, `expected a depth-1 sub-dispatch in tp: ${body}`;
    assert copies <= 2, `sub-dispatch duplicated once per first token (${copies} copies): ${body}`;
    assert !body.contains("if p.peek_kind() == TK_A"), `A got its own branch: ${body}`;
}

// Alts 0 and 1 share `A` and `B`, which the token after them tells apart. `s`
// scans `e` to choose between its alternatives, so `scan_e` is emitted.
global REPEATED_SCAN_ALT_G4: String = "
grammar T;
s : e X EOF | e Y EOF ;
X : 'x' ;
Y : 'y' ;
e : f '(' ')' | n | K ;
f : A | B ;
n : A | B | C ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
K : 'k' ;
WS : [ \\t\\r\\n]+ -> skip ;
";

test "a scan decides by the parse's lookahead, not by scanning every candidate" {
    let output = gen_source(REPEATED_SCAN_ALT_G4);
    let scan_e = extract_fn_body(&output, "fn scan_e(");
    assert scan_e.contains("if la_1 == TK_LIT_LPAREN {"), scan_e;
    assert scan_e.contains("return scan_e__alt_0(tokens, start"), scan_e;
    assert scan_e.contains("return scan_e__alt_1(tokens, start"), scan_e;
}

test "a gate the scan cannot evaluate does not put its untested arm first" {
    // The gate is false at `r`, so the parse falls through to `A`; an ungated
    // empty arm in the scan would end every scan of `r` before `A` is tried.
    let got = parses("grammar G;
options { language = Wado; }
s : r A B EOF | r A C EOF ;
r : { p.pos > 0 }? | A ;
A : 'a' ; B : 'b' ; C : 'c' ;
", "s", ["aab", "aac", "ab"]);
    assert got == "aab => (s (r a) a b)\naac => (s (r a) a c)\nab => error\n", got;
}

test "an uncontested alternative is scanned in place" {
    let output = gen_source(REPEATED_SCAN_ALT_G4);
    assert !output.contains("fn scan_e__alt_2("), output;
}

// `RustParser.g4`'s `crate : innerAttribute* item* EOF`: the reserve walks the
// whole rest of the file, so it runs only where the loop cannot go on.
global RESERVE_AFTER_LOOP_G4: String = "
grammar T;
r : inner* outer* EOF ;
inner : '#' '!' ID ;
outer : '#' ID | ID ;
ID : [a-z]+ ;
";

test "the reserve probe runs only after the loop's own lookahead declines" {
    let output = gen_source(RESERVE_AFTER_LOOP_G4);
    let body = extract_fn_body(&output, "fn _parse_r__inner(");
    assert_in_order(
        &body,
        "let rep_body_end_kind =",
        "rep_body_end_scan:",
        "the probe walks before the lookahead can skip it",
    );
}

// `e : a=e op=('+'|'-') b=e`: a labelled element's inner used a fresh
// `name_counts`, so two labels shared one binding and redeclared it.
test "label binding on repeated rule ref dedups against outer scope" {
    // A grammar with no action emits no label binding, and a binding declared
    // twice in one function does not compile.
    let got = parses("grammar T;
options { language = Wado; }
e : a=e op=('*'|'/') b=e { }
  | INT
  | '(' x=e ')' { p.emit($x.text) }
  ;
INT : '0'..'9'+ ;
WS : (' '|'\\n') -> skip ;
", "e", ["(1)", "1*2", "(1)/2"]);
    assert got == "(1) => (e ( (e 1) )) [1]
1*2 => (e (e 1) * (e 2))
(1)/2 => (e (e ( (e 1) )) / (e 2)) [1]
", got;
}

test "an element whose name is the recognizer handle does not shadow it" {
    // `P` snake_cases to `p`, the parser handle. Bound verbatim, it shadowed the
    // handle and the next `p.` call no longer compiled.
    let g4 = "grammar T;
options { language = Wado; }
r : P { p.emit($P.text) } ;
P : 'p' ;
WS : ' ' -> skip ;
";
    let got = parses(g4, "r", ["p"]);
    assert got == "p => (r p) [p]\n", got;
}

test "an element named after any generated parse-fn local does not shadow it" {
    // Every parse-fn parameter and body local is reserved, not just the handle.
    // `KIND` collides with the dispatch's lookahead local in the same function.
    let g4 = "grammar T;
options { language = Wado; }
r : KIND VALS { p.emit($KIND.text); p.emit($VALS.text) } | VALS ;
KIND : 'k' ;
VALS : 'v' ;
WS : ' ' -> skip ;
";
    let got = parses(g4, "r", ["k v", "v"]);
    assert got == "k v => (r k v) [kv]\nv => (r v)\n", got;
}

// "a prebound LR suffix scan is neither re-tested nor re-seeded" pins the guard's
// absence where every suffix consumes.
test "an LR loop never takes an iteration that consumes nothing" {
    // ANTLR rejects both grammars (error 148); `antlr4-compatibility.md` gives the
    // meaning Gale takes. `x` yields a `*` the caller takes, and `+` is reached
    // through an empty `x` as well as directly. The second grammar routes the
    // loop to the ATN.
    let rest = "x : '*'? ;
INT : '0'..'9'+ ;
WS : (' '|'\\n') -> skip ;
";
    let static_lr = `grammar T;
s : e '*' EOF | e '!' EOF ;
e : e x | '(' e ')' | INT ;
${rest}`;
    let got = parses(static_lr, "s", ["1*", "1**", "1*!"]);
    assert got == "1* => (s (e 1) *)
1** => (s (e (e 1) (x *)) *)
1*! => (s (e (e 1) (x *)) !)
", got;
    let atn_lr = `grammar T;
s : e '*' EOF | e '!' EOF ;
e : e x | e '+' e '+' | e '+' e | '(' e ')' | INT ;
${rest}`;
    let atn_got = parses(atn_lr, "s", ["1*", "1+2!", "1+2+*", "1+2**"]);
    assert atn_got == "1* => (s (e 1) *)
1+2! => (s (e (e 1) + (e 2)) !)
1+2+* => (s (e (e 1) + (e 2) +) *)
1+2** => (s (e (e 1) + (e (e 2) (x *))) *)
", atn_got;
    // The first token admits `(A B)?`, which then matches nothing: recovery skips
    // the `a` rather than wrapping an empty `e`.
    let stranded = printed("grammar T;
s : e EOF ;
e : e (A B)? | e '+' e '+' | e '+' e | INT ;
A : 'a' ; B : 'b' ;
INT : '0'..'9'+ ;
WS : ' ' -> skip ;
", "println(to_string_tree(&parse_s(\"1 a\")));");
    assert stranded == "(s (e 1) <skip a>)\n", stranded;
}

// An action or predicate nested inside a group must never vanish: it either
// runs — a group's alternatives decide like a rule's — or it is reported.

test "an empty-alt predicate gates the empty alternative" {
    // The predicate keeps the group from folding to an Optional, which would have
    // nowhere to put it.
    let src = "grammar T;
options { language = Wado; }
r : ( {false}? | A ) A ;
A : 'a' ;
";
    assert unsupported_count(&gen(src)) == 0, "a gated empty alternative must not warn";
    let got = parses(src, "r", ["aa", "a"]);
    assert got == "aa => (r a a)\na => error\n", got;
}

test "a plain action on an empty alternative does not cost it its follow set" {
    // Only a gateable alt-initial predicate takes the decision away from the
    // lookahead; a plain action does not.
    let src = "grammar T;
options { language = Wado; }
s : 'k' ( A | { p.emit(\"x\") } | B ) EOF ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
";
    assert unsupported_count(&gen(src)) == 0, "a plain action on an empty alternative must not warn";
    let got = parses(src, "s", ["k", "ka", "kb", "kc"]);
    assert got == "k => (s k) [x]
ka => (s k a)
kb => (s k b)
kc => error [x]
", got;
}

// A predicate in a host language Gale does not emit renders nothing, so it must not
// gate: `alt_has_gate` answers "reaches its arm", not "exists in the IR".
test "a predicate in an unemitted host language gates nothing" {
    let gated = "grammar T;
options { language = Cpp; }
s : 'k' ( A | {p()}? | B ) EOF ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
";
    let got = parses(gated, "s", ["k", "ka", "kc"]);
    assert got == "k => (s k)\nka => (s k a)\nkc => error\n", got;
}

// The rejection case: the same shape in a language Gale does emit is selected
// by the predicate, so the test above is not passing because nothing ever gates.
test "the same predicate in an emitted language does gate" {
    let gated = "grammar T;
options { language = Wado; }
s : 'k' ( A | {false}? | B ) EOF ;
A : 'a' ;
B : 'b' ;
";
    let got = parses(gated, "s", ["k", "ka"]);
    assert got == "k => error\nka => (s k a)\n", got;
}

// Parser-side `superClass` (Stage C): a `{this.m()}?` predicate in a parser
// rule lowers to an ambient operation on the parser base's effect interface.

test "the parse entries carry the parser base effect" {
    // `driver_action_prs_super_test` parses with a handler installed.
    let src = gen_source("grammar C;
options { superClass = PBase; language = Wado; }
shr : GT { this.next_gt() }? GT ;
GT : '>' ;
");
    let Err(CompileFailed(failure)) = eval(`${src}
export fn run() {
    parse(">>");
}
`) else {
        panic("a caller that installs no handler must fail to compile");
    };
    assert failure.rendered.contains("missing effect 'PBase' required by 'parse'"), failure.rendered;
}

test "the parser action-context API is public under a parser base" {
    let src = gen_source("grammar C;
options { superClass = PBase; language = Wado; }
shr : GT { this.next_gt() }? GT ;
GT : '>' ;
");
    assert src.contains("pub fn la(&self, k: i32) -> i32"), "the base reads lookahead through the recognizer";
    assert src.contains("pub fn token_start(&self, i: i32) -> i32"), "and token positions";
}

test "a parser base call whose argument has no evident type is refused" {
    let src = "grammar C;
options { superClass = PBase; language = Wado; }
r : A { this.p(x + 1) }? A ;
A : 'a' ;
";
    let generated = gen(src);
    assert unsupported_count(&generated) == 1, "the refusal is reported once";
    let out = generated.source;
    assert !out.contains("pub interface PBase"), "and nothing reaching the base is emitted";
    // The recognizer surface turns public only for a base that is wired, so it
    // and the interface emit cannot drift apart.
    assert !out.contains("pub struct Parser"), out;
    assert !out.contains("pub fn la("), out;
    // The rewrite never ran, so the body still names `this`.
    assert !out.contains("this."), out;
}

test "a parser base reached from an action body is refused" {
    // The parser side carries no command surface, so a unit-returning
    // operation would have nothing to drive.
    let src = "grammar C;
options { superClass = PBase; language = Wado; }
r : A { this.mark() } A ;
A : 'a' ;
";
    let generated = gen(src);
    assert unsupported_count(&generated) == 1, "the refusal is reported once";
    let out = generated.source;
    assert !out.contains("pub interface PBase"), "and nothing reaching the base is emitted";
    assert !out.contains("this."), out;
}

test "an alt-initial predicate on a refused base is not extracted either" {
    // The gate path has its own passthrough (`pred_<id>`), so it needs the
    // same guard as the inline one.
    let src = "grammar C;
options { superClass = PBase; language = Wado; }
r : { this.p(x + 1) }? A | B ;
A : 'a' ;
B : 'b' ;
";
    // The refusal, then the un-gated predicate the alt dispatch is left with.
    let out = gen(src);
    assert unsupported_count(&out) == 2, "both the refusal and the dropped gate are reported";
    assert !out.source.contains("this."), out.source;
}

test "a grammar with no parser base is unaffected" {
    let plain = gen_source("grammar C;
r : A ;
A : 'a' ;
");
    assert !plain.contains("interface"), "no interface";
    assert !plain.contains("with PBase"), "no effect clause";
    assert !plain.contains("pub fn la("), "the action-context API stays private";
}

test "an untranslatable body is dropped on its own, and the base still wires" {
    // warn-and-emit (`action.md`), as ANTLR4 leaves a bad body to the host compiler:
    // the untranslatable body is dropped and the other body's base still wires.
    let src = "grammar C;
options { superClass = PBase; }
@parser::members {
    int n = 0;
}
r : A { this.ok() }? A ;
s : A { System.out.print(n++); } ;
A : 'a' ;
";
    let out = gen(src);
    assert unsupported_count(&out) == 1, "the refusal is reported once";
    assert out.source.contains("pub interface PBase"), "and the base the other body calls still wires";
}

test "the metadata comment names each recognizer's base" {
    let lexer_g = parse("lexer grammar SLexer;
options { superClass = LBase; language = Wado; }
GT : { this.ok() }? '>' ;
").unwrap();
    let parser_g = parse("parser grammar SParser;
options { superClass = PBase; language = Wado; }
shr : GT { this.next_gt() }? GT ;
").unwrap();
    let mut merged = merge_grammars([lexer_g, parser_g]);
    let src = generate(&mut merged, &DEFAULT_OPTIONS).source;
    assert src.contains("//   option superClass = LBase (lexer)"), src;
    assert src.contains("//   option superClass = PBase (parser)"), src;
}

test "a this-call with no parser base declared is reported, not emitted" {
    // Nothing else reports it: there is no base to refuse.
    let src = "grammar C;
options { language = Wado; }
r : A { this.p() }? A ;
A : 'a' ;
";
    let out = gen(src);
    assert unsupported_count(&out) == 1, "the stray receiver is reported";
    assert !out.source.contains("this."), out.source;
}

test "a lexer this-call in a combined grammar is reported, not emitted" {
    // A combined grammar's `superClass` is the parser's, so a lexer body naming
    // `this` has no receiver at all.
    let src = "grammar C;
options { superClass = B; language = Wado; }
r : X ;
X : { this.ok() }? [a-z]+ ;
";
    let out = gen(src);
    assert unsupported_count(&out) == 1, "the stray lexer receiver is reported";
    assert !out.source.contains("this."), out.source;
}

test "a parser superClass does not carve out java members" {
    // The carve-out is the lexer's, whose base owns the action surface; a parser base
    // is predicate-only, so `@parser::members` translates as with no base.
    let src = gen_source("grammar C;
options { superClass = PBase; }
@parser::members {
    int calls = 0;
}
shr : GT { this.NextGT() }? GT ;
GT : '>' ;
");
    assert src.contains("PBase::next_gt(p)"), "the base predicate still runs";
    assert src.contains("calls: i32 = 0"), src;
}

test "fragment recovery reaches the base through expect" {
    // `expect` calls `_recover_try_descend`, which descends into rule entries,
    // so it must declare the effect those entries carry or nothing compiles.
    let src = gen_with("grammar C;
options { superClass = PsBase; language = Wado; }
prog : shr ;
shr : GT { this.next_gt() }? GT ;
GT : '>' ;
", &GenerateOptions {
        fragment_entries: ["shr"],
    }).source;
    let got = run_beside(src, "let mut base = Always {};
with PsBase => &mut base do {
    println(to_string_tree(&parse(\">>\")));
    println(`${parse(\">\").ok()}`);
};
", "struct Always {}
impl PsBase for Always {
    fn next_gt(&self, p: &Parser) -> bool {
        resume true;
    }
}
").stdout;
    assert got == "(prog (shr > >))\nfalse\n", got;
}

test "a this field read with no parser base is reported, not emitted" {
    let src = "grammar C;
options { language = Wado; }
r : A { this.flag }? A ;
A : 'a' ;
";
    let out = gen(src);
    assert unsupported_count(&out) == 1, "a receiver-less `this` is reported whatever follows it";
    assert !out.source.contains("this"), out.source;
}

// A lexer action runs at the tournament commit for the winning rule only, through
// its `apply_<rule>_actions` replay; what cannot run is reported.

test "a modeless action grammar emits no mode-op API (gated)" {
    let src = gen_source("lexer grammar L;
options { language = Wado; }
A : 'a' { lx.set_type(TK_B) } ;
B : 'b' ;
");
    assert !src.contains("act_push_mode"), "no mode fields without modes";
    assert !src.contains("MODE_"), "no mode constants without modes";
}

test "an actionless grammar keeps no action machinery (byte-identical guard)" {
    let src = gen_source("lexer grammar L;
A : 'a' ;
WS : ' ' -> skip ;
");
    assert !src.contains("reset_actions"), "no action-effect surface without actions";
    assert !src.contains("best_act"), "no best_act without actions";
    assert !src.contains("apply_"), "no apply fn without actions";
}

test "a predicate-only grammar keeps no action-replay machinery" {
    let src = gen_source("lexer grammar L;
options { language = Wado; }
KW : [a-z]+ { $text == \"cat\" }? ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
");
    assert !src.contains("reset_actions"), "predicates need no action-effect surface";
    assert !src.contains("best_act"), "predicates need no best_act";
}

test "an action or predicate the emitter runs is not also reported as unhandled" {
    // A driver shows each of these running. The report is only a warning, so a
    // body that runs and is reported anyway fails no driver.
    let grammars: List<String> = [
        "grammar T;
options { language = Wado; }
r : ( {false}? A | B ) ;
A : 'a' ;
B : 'b' ;
", "grammar T;
options { language = Wado; }
r : ( {false}? A B )+ A ;
A : 'a' ;
B : 'b' ;
", "grammar C;
options { superClass = PBase; }
shr : GT { this.NextGT() }? GT ;
GT : '>' ;
", "grammar C;
options { superClass = PBase; language = Wado; }
r : A { this.p(\"of\") }? A ;
A : 'a' ;
", "lexer grammar L;
options { language = Wado; }
A : 'a' { lx.set_type(TK_B) } ;
B : 'b' ;
WS : ' ' -> skip ;
", "lexer grammar L;
options { language = Wado; }
A : ('a' { lx.set_type(TK_B) } | 'c') ;
B : 'b' ;
WS : ' ' -> skip ;
", "lexer grammar L;
options { language = Wado; }
A : ('a' { lx.set_type(TK_B) })+ ;
B : 'b' ;
WS : ' ' -> skip ;
", "lexer grammar L;
options { language = Wado; }
A : F 'z' ;
fragment F : 'a' { lx.set_type(TK_B) } ;
B : 'b' ;
WS : ' ' -> skip ;
", "lexer grammar L;
options { language = Wado; }
A : 'a' (~'b' { lx.set_type(TK_B) })+ 'c' ;
B : 'b' ;
WS : ' ' -> skip ;
", "lexer grammar L;
options { language = Wado; }
A : 'a' .*? { pos > start + 2 }? 'c' { lx.set_type(TK_B) } ;
B : 'b' ;
", "lexer grammar L;
options { language = Wado; }
A : 'a' (~'b' { lx.set_type(TK_B) })*? 'c' ;
B : 'b' ;
WS : ' ' -> skip ;
", "lexer grammar L;
options { language = Wado; }
A : 'a' ~('b')+ { lx.set_type(TK_B) } 'c' ;
B : 'b' ;
WS : ' ' -> skip ;
", "lexer grammar L;
options { language = Wado; }
A : 'a' { lx.set_type(TK_X) } | 'c' { lx.set_type(TK_Y) } ;
B : 'b' ;
WS : ' ' -> skip ;
", "lexer grammar L;
options { language = Wado; }
A : 'a' { if $mode == 0 { $mode = MODE_TAIL } } ;
mode TAIL;
B : 'b' ;
",
    ];
    for let g4 of grammars {
        assert unsupported_count(&gen(g4)) == 0, g4;
    }
}

test "a Wado lexer body naming `this` is still reported, members or not" {
    // The identity translator analyses no host text, so `this` has nothing to
    // receive it whatever the grammar declares. Only java2wado resolves one.
    let src = "lexer grammar L;
options { language = Wado; }
@members { count: i32 = 0 }
A : 'a' { this.count += 1 } ;
WS : ' ' -> skip ;
";
    let out = gen(src);
    assert unsupported_count(&out) > 0, "a Wado body naming `this` must be reported";
    assert !out.source.contains("this.count"), "the untranslatable body must not be emitted";
}

test "a lexer predicate calling a writing member method is refused" {
    // The tournament evaluates every candidate's predicate, losers included, under
    // `&Lexer`, so neither spelling of a `&mut self` call can be emitted.
    let qualified = "lexer grammar L;
@members {
    int depth = 0;
    boolean bump() { this.depth = this.depth + 1; return true; }
}
A : 'a' { this.bump() }? ;
WS : ' ' -> skip ;
";
    let qualified_out = gen(qualified);
    assert unsupported_count(&qualified_out) == 1, "a mutating `this.m()` from a lexer predicate must be reported";
    assert !qualified_out.source.contains("lx.bump()"), "the refused call must not be emitted";

    let bare = "lexer grammar L;
@members {
    int depth = 0;
    boolean bump() { this.depth = this.depth + 1; return true; }
}
A : 'a' { bump() }? ;
WS : ' ' -> skip ;
";
    let bare_out = gen(bare);
    assert unsupported_count(&bare_out) == 1, "a mutating bare `m()` from a lexer predicate must be reported";
    assert !bare_out.source.contains("lx.bump()"), "the refused call must not be emitted";
}

test "a superClass grammar's `this` is not excused by its @lexer::members" {
    // A `superClass` grammar's bodies go through the identity translator, which
    // resolves no `this`; with the base refused too, every `this.` is reported.
    let src = "lexer grammar L;
options { superClass = B; }
@members { int n = 0; }
A : { this.m() }? 'a' { this.m() } ;
WS : ' ' -> skip ;
";
    let generated = gen(src);
    assert unsupported_count(&generated) > 0, "an unwired `this` must be reported, members or not";
    let out = generated.source;
    assert !out.contains("this.m()"), "the untranslatable body must not be emitted verbatim";
    assert !out.contains("fn apply_A_actions"), "and the rule must not run actions at all";
}

test "a camelCase Java member field reads the same by either spelling" {
    // The declaration is snake_cased like a method name, so `this.nestLevel` and
    // the bare `nestLevel` resolve to the one field the struct carries.
    let src = "lexer grammar L;
@members { int nestLevel = 0; }
A : 'a' { nestLevel = this.nestLevel + 1; System.out.println(nestLevel); } ;
WS : ' ' -> skip ;
";
    assert unsupported_count(&gen(src)) == 0, "both spellings must resolve";
    assert lexes(src, ["a a"]) == "a a => A:a A:a [1\n2\n]\n";
}

test "an undeclared Java lexer field is reported by either spelling" {
    // `lx.<name>` for a name `@members` never declared names no field on the `Lexer`,
    // so `this.<x>` is refused exactly as the bare `x` is.
    let qualified = "lexer grammar L;
@members { int depth = 0; }
A : 'a' { this.missing = 1; } ;
WS : ' ' -> skip ;
";
    let qualified_out = gen(qualified);
    assert unsupported_count(&qualified_out) == 1, "an undeclared `this.<field>` must be reported";
    assert !qualified_out.source.contains("lx.missing"), "the refused read must not be emitted";

    let bare = "lexer grammar L;
@members { int depth = 0; }
A : 'a' { missing = 1; } ;
WS : ' ' -> skip ;
";
    assert unsupported_count(&gen(bare)) == 1, "an undeclared bare field must be reported";
}

test "a lexer predicate that prints is reported, not wired to the sink" {
    // A predicate is evaluated for every candidate rule, losers included, so
    // printing from one would emit output the tournament discards.
    assert unsupported_count(&gen("lexer grammar L;
A : 'a'+ { System.out.println(\"x\") }? ;
WS : ' ' -> skip ;
")) == 1, "a printing lexer predicate must surface UnsupportedAction";
}

test "a Java lexer body can declare and read its own local" {
    let got = lexes("lexer grammar L;
A : 'a'+ { int n = 1; System.out.println(\"n=\" + n); } ;
WS : ' ' -> skip ;
", ["aa"]);
    assert got == "aa => A:aa [n=1\n]\n", got;
}

test "a lexer rule called from another matches through its later alternatives" {
    // css3's `Dimension : Number R E M`: `0.25` is `Number`'s second
    // alternative, and its first stops at `0`. `N` is called, and still takes
    // its longest arm as a token of its own.
    let got = lexes("lexer grammar L;
D : N 'rem' | N 'px' ;
E : 'x' N ;
N : [0-9]+ | [0-9]* '.' [0-9]+ ;
DOT : '.' ;
", ["0.25rem", "12px", ".5rem", "3.", "1.5", "x1.5", "x3."]);
    assert got == "0.25rem => D:0.25rem\n12px => D:12px\n.5rem => D:.5rem\n3. => N:3 DOT:.\n1.5 => N:1.5\nx1.5 => E:x1.5\nx3. => E:x3 DOT:.\n", got;
}

test "a called lexer rule keeps its own case folding" {
    let got = lexes("lexer grammar L;
A : B 'z' ;
B options { caseInsensitive = true; } : 'a' | 'ab' ;
", ["Az", "A"]);
    assert got == "Az => A:Az\nA => B:A\n", got;
}

test "a called lexer rule runs its actions only for a token of its own" {
    let got = lexes("lexer grammar L;
A : B 'z' ;
B : 'a' { System.out.println(\"x\"); } | 'ab' ;
", ["az", "abz", "a"]);
    assert got == "az => A:az\nabz => A:abz\na => B:a [x\n]\n", got;
}

test "an unmodelled ANTLR lexer field is a loud diagnostic, not broken code" {
    // `_hitEOF` is a recognizer field Gale does not model.
    let src = "lexer grammar L;
A : 'a'+ { _hitEOF }? ;
NL : '\n' ;
";
    let out = gen(src);
    assert unsupported_count(&out) == 1, "an unmodelled lexer field must surface UnsupportedAction";
    assert !out.source.contains("_hitEOF"), "the untranslatable body must not be emitted";
}

test "a predicate in an ATN-class lexer rule is refused, not silently dropped" {
    // The rule routes to `latn_match`, and the lexer ATN has no predicate
    // transition, so without a refusal it matches input the predicate rejects.
    let src = "lexer grammar L;
options { language = Wado; }
CMT : '/*' ( CMT | . )+? { false }? '*/' ;
WS : ' ' -> skip ;
";
    assert unsupported_count(&gen(src)) == 1, "an ATN-class rule's predicate must surface UnsupportedAction";
}

test "an ATN-class lexer rule with no predicate stays byte-identical" {
    let src = "lexer grammar L;
options { language = Wado; }
CMT : '/*' ( CMT | . )+? '*/' ;
WS : ' ' -> skip ;
";
    assert unsupported_count(&gen(src)) == 0, "the refusal must not fire on a predicate-free ATN-class rule";
}

test "an unresolvable lexer $-attribute is reported, not a generator panic" {
    // Staging runs where a `ctx` is in hand; emit has none to warn through.
    let src = "lexer grammar L;
options { language = Wado; }
A : 'a' { lx.set_type($nope) } ;
B : 'b' ;
";
    let out = gen(src);
    assert unsupported_count(&out) == 1, "an unresolvable $-attribute must surface UnsupportedAction";
    assert !out.source.contains("$nope"), "the untranslatable body must not be emitted";
}

test "$mode needs a grammar that has a mode to switch to" {
    let no_modes = "lexer grammar L;
options { language = Wado; }
A : 'a' { $mode = 1 } ;
B : 'b' ;
";
    assert unsupported_count(&gen(no_modes)) == 1, "$mode with no mode to switch to must be reported";
}

test "a $mode read only a predicate asks for turns nothing on" {
    // The predicate is refused (a latch answers nothing during the tournament),
    // so the read never reaches the field — which must therefore not be emitted.
    let src = "lexer grammar L;
options { language = Wado; }
A : 'a' { $mode == 0 }? ;
mode TAIL;
B : 'b' ;
";
    let generated = gen(src);
    assert unsupported_count(&generated) == 1, "a latch read from a lexer predicate must be reported";
    let out = generated.source;
    assert !out.contains("fn mode(&self)"), "no current-mode reader for a read that is refused";
    assert !out.contains("act_mode ="), "and no field to seed";
}

test "$mode cannot be read and assigned in one site" {
    // The read and the write are different fields, so `+=` has no single
    // expression to become.
    let src = "lexer grammar L;
options { language = Wado; }
A : 'a' { $mode += 1 } ;
mode TAIL;
B : 'b' ;
";
    assert unsupported_count(&gen(src)) == 1, "a compound assignment to $mode must be reported";
}

test "a lexer attribute over the match window is not assignable" {
    let src = "lexer grammar L;
options { language = Wado; }
A : 'a' { $text = \"b\" } ;
B : 'b' ;
";
    assert unsupported_count(&gen(src)) == 1, "$text is a read of the match window";
}

test "a keyword-shaped rule carrying a body is matched, not reclassified" {
    // The classifier rewrites only `best_kind`, so the replay would run the carrier's
    // actions, not this rule's; a rule with a body keeps its own matcher.
    let with_action = lexes("grammar T;
options { language = Wado; }
r : A ID ;
A : 'A' { lx.emit(\"!\") } ;
ID : [a-zA-Z]+ ;
WS : [ \\t\\n\\r]+ -> skip ;
", ["A Ab A"]);
    assert with_action == "A Ab A => A:A ID:Ab A:A [!!]\n", with_action;

    let with_pred = lexes("grammar T;
options { language = Wado; }
r : A ID ;
A : 'A' { start == 0 }? ;
ID : [a-zA-Z]+ ;
WS : [ \\t\\n\\r]+ -> skip ;
", ["A A"]);
    assert with_pred == "A A => A:A ID:A\n", with_pred;

    // The shortcut still applies to the plain shape it was written for.
    let plain = gen_source("grammar T;
options { language = Wado; }
r : A ID ;
A : 'A' ;
ID : [a-zA-Z]+ ;
WS : [ \\t\\n\\r]+ -> skip ;
");
    assert !plain.contains("fn try_A("), "a bare keyword is still reclassified from its carrier";
    assert plain.contains("fn classify_keyword("), "by the classifier";
}

test "a lexer predicate cannot reach the commit latches" {
    // A predicate is evaluated for every candidate rule, losers included, so it
    // settles nothing about the token that wins.
    let src = "lexer grammar L;
options { language = Wado; }
A : 'a'+ { $type == 1 }? ;
B : 'b' ;
";
    assert unsupported_count(&gen(src)) == 1, "a latch read from a lexer predicate must be reported";
}

test "a multi-alt rule around a restructured repeat replays instead of running flat" {
    // The replay now walks a lookahead-aware repeat, so each alt runs its own actions
    // in place instead of the flat emit's `winning_alt_` helper.
    let src = gen_source("lexer grammar L;
options { language = Wado; }
A : 'a' ~('b')+ 'c' { lx.set_type(TK_X) } | 'd' { lx.set_type(TK_Y) } ;
B : 'b' ;
WS : ' ' -> skip ;
");
    assert !src.contains("fn winning_alt_A"), "the replay selects the arm itself";
    assert src.contains("sel_alt_"), "the replay selects the winning arm match-only first";
}

test "a superClass action op runs from the replay, not from the match fn" {
    // The action op is the only base call, so `try_A` — which never emits an
    // action — stays effect-free and only the replay carries `with B`.
    let src = gen_source("lexer grammar L;
options { superClass = B; language = Wado; }
A : 'a' { this.hit() } ;
WS : ' ' -> skip ;
");
    assert src.contains("fn hit(view: LexerView, lx: &mut Lexer);"), "an action op returns unit and reaches the lexer";
    assert src.contains("fn apply_A_actions(lx: &mut Lexer, start: i32, end: i32) with B"), "the replay carries the base effect";
    assert src.contains("B::hit(LexerView { chars, start, pos }, lx);"), "the action op is called from the replay";
    assert src.contains("fn try_A(chars: &List<char>, start: i32) -> i32 {"), "a match fn with no predicate op stays effect-free";
}

test "a superClass action op reaches the lexer mode state" {
    // The depth is a tokenize-loop local, so it rides on the `Lexer`.
    let src = gen_source("lexer grammar L;
options { superClass = B; language = Wado; }
A : '[' { this.hit() } ;
WS : ' ' -> skip ;
mode Arg;
C : ']' ;
");
    assert src.contains("fn mode_depth(&self) -> i32 {"), "the base can read the mode-stack depth";
    assert src.contains("lexer.reset_actions(best_kind, best_channel, mode_stack.len());"), "the depth is seeded per token";
    assert src.contains("self.act_mode_depth += 1;"), "push_mode keeps the depth the base reads consistent";
    assert src.contains("self.act_mode_depth -= 1;"), "pop_mode keeps the depth the base reads consistent";
}

test "a base method used as both a predicate and an action is refused" {
    let src = "lexer grammar L;
options { superClass = B; language = Wado; }
A : { this.m() }? 'a' { this.m() } ;
WS : ' ' -> skip ;
";
    // Two reports: the refused base, and the action that can no longer run.
    let generated = gen(src);
    assert unsupported_count(&generated) == 2, "a mixed-role base method must be reported";
    let out = generated.source;
    assert !out.contains("pub interface B {"), "a refused base is not wired";
}

test "an action may issue at most one mode command per token" {
    let commands_only = gen_source("lexer grammar L;
options { superClass = B; language = Wado; }
A : '[' { this.hit() } ;
WS : ' ' -> skip ;
mode Arg;
C : ']' ;
");
    assert commands_only.contains("assert self.act_push_mode < 0 && !self.act_pop_mode && self.act_set_mode < 0,"), "each mode command guards against a second one";
    // Every command passes that guard, so a grammar whose only mode writes are
    // commands must not pay for the invariant again per token.
    assert !commands_only.contains("<= 1, \"a lexer action may issue at most one mode command per token\""), "no second check where every write passes a command";

    // A `$mode` assignment reaches the set latch without passing one, so there
    // the commit repeats the invariant over the latches themselves.
    let assigns_mode = gen_source("lexer grammar L;
options { language = Wado; }
A : 'a' { $mode = MODE_TAIL } ;
mode TAIL;
B : 'b' ;
");
    assert assigns_mode.contains("<= 1, \"a lexer action may issue at most one mode command per token\""), "the commit guards the latches a $mode assignment can reach";
}

test "the current-mode read is emitted only for a grammar that asks for it" {
    let unread = gen_source("lexer grammar L;
options { superClass = B; language = Wado; }
A : '[' { this.hit() } ;
WS : ' ' -> skip ;
mode Arg;
C : ']' ;
");
    assert !unread.contains("fn mode(&self)"), "no current-mode read where no body reads one";
    assert !unread.contains("act_mode ="), "and no field to seed";
    assert unread.contains("fn mode_depth(&self) -> i32 {"), "the depth a base branches on stays";
}

test "a predicate-only base gets the emit hook without the channel machinery" {
    // No action and no `-> channel` rule means no `best_channel` local.
    let src = gen_source("lexer grammar L;
options { superClass = B; }
A : { this.ok() }? 'a' ;
WS : ' ' -> skip ;
");
    assert !src.contains("best_channel"), "the channel machinery stays off";
    assert src.contains(
        "best_kind = B::emit(LexerView { chars: &lexer.chars, start: tok_start, pos: best_end }, best_kind, 0);",
    ), "the hook takes the default channel";
}

test "a base whose only override is the emit hook is still wired" {
    // No `this.<m>()` call anywhere, so the grammar contributes zero ops. The
    // hook fires once per emitted token, never for a skipped one.
    let src = gen_source("lexer grammar L;
options { superClass = B; language = Wado; }
A : 'a' ;
WS : ' ' -> skip ;
");
    let got = run_beside(src, "let mut base = Count {};
with B => &mut base do {
    tokenize(\"a a  a\");
};
println(`${base.emitted}`);
", "struct Count { emitted: i32 = 0 }
impl B for Count {
    fn emit(&mut self, view: LexerView, ty: i32, channel: i32) -> i32 {
        self.emitted += 1;
        resume ty;
    }
}
").stdout;
    assert got == "3\n", got;
}

test "a grammar with no base has no emit hook" {
    let src = gen_source("lexer grammar L;
options { language = Wado; }
A : 'a' { lx.set_type(TK_B) } ;
B : 'b' ;
WS : ' ' -> skip ;
");
    assert !src.contains("::emit(LexerView"), "no base, no lifecycle call";
}

test "a modeless grammar keeps the mode-state surface off" {
    let src = gen_source("lexer grammar L;
options { superClass = B; language = Wado; }
A : 'a' { this.hit() } ;
WS : ' ' -> skip ;
");
    assert !src.contains("fn mode_depth(&self)"), "no modes, no mode-state reads";
    assert src.contains("lexer.reset_actions(best_kind, best_channel);"), "a modeless reset takes no mode state";
}

test "a superClass grammar's host-code action body is reported, not emitted" {
    // java2wado is carved out for a superClass grammar, so a Java body only runs
    // when the base-call rewrite alone turns it into Wado. This one does not.
    let src = "lexer grammar L;
options { superClass = B; }
A : 'a' { int n = 1; this.hit(); } ;
WS : ' ' -> skip ;
";
    let generated = gen(src);
    assert unsupported_count(&generated) == 1, "an untranslatable superClass action body must be reported";
    let out = generated.source;
    assert !out.contains("fn apply_A_actions"), "no replay is emitted for an action that cannot run";
    assert out.contains("pub interface B {"), "the base stays wired for its other ops";
}

test "a superClass predicate-only grammar keeps its action surface off" {
    // RustLexer's shape: base calls, but no `{ ... }` action anywhere. Nothing
    // gains the action machinery.
    let src = gen_source("lexer grammar L;
options { superClass = B; }
A : { this.ok() }? 'a' ;
WS : ' ' -> skip ;
");
    assert !src.contains("fn apply_"), "a predicate-only base emits no replay fn";
    assert !src.contains("act_type"), "a predicate-only base emits no action-effect surface";
}

test "a superClass call's literal arguments settle its operation's signature" {
    let src = "lexer grammar L;
options { superClass = B; language = Wado; }
A : 'a' { this.setChannel(2) } ;
WS : ' ' -> skip ;
";
    let generated = gen(src);
    assert unsupported_count(&generated) == 0, "a literal argument needs no other signature source";
    let got = run_beside(generated.source, "let mut base = Seen {};
with B => &mut base do {
    tokenize(\"a a\");
};
println(`${base.args:?}`);
", "struct Seen { args: List<i32> = [] }
impl B for Seen {
    fn set_channel(&mut self, view: LexerView, lx: &mut Lexer, a0: i32) {
        self.args.push(a0);
        resume ();
    }
}
").stdout;
    assert got == "[2, 2]\n", got;
}

test "a superClass call whose argument has no evident type is refused" {
    // The interface would have to invent the type, so wiring the base would run
    // `set_channel` against a signature nothing settled. Refuse and say so.
    let src = "lexer grammar L;
options { superClass = B; language = Wado; }
A : 'a' { this.setChannel(n + 1) } ;
WS : ' ' -> skip ;
";
    // Two reports: the refused base, and the action that can no longer run.
    let generated = gen(src);
    assert unsupported_count(&generated) == 2, "an unsettled base call must be reported";
    let out = generated.source;
    assert !out.contains("pub interface B"), "no interface is emitted for a base Gale cannot represent";
    assert !out.contains("B::set_channel"), "the call must not be emitted against a guessed signature";
    assert !out.contains("this.setChannel"), "a body naming `this` must not reach the generated module";
}

test "an expression that merely starts and ends with a quote is not a literal" {
    let src = "lexer grammar L;
options { superClass = B; language = Wado; }
A : 'a' { this.setChannel(\"x\" + y + \"z\") } ;
WS : ' ' -> skip ;
";
    let generated = gen(src);
    assert unsupported_count(&generated) == 2, "concatenation settles no signature either";
    let out = generated.source;
    assert !out.contains("pub interface B"), "no interface for a base whose call takes an unrepresentable argument";
    assert !out.contains("+ y +"), "the host expression must not be spliced into the call";
}

// A members block the translator refuses declares nothing, so the fields its
// actions name have no type to copy and the gate goes unsimulated.
fn members_grammar<S: AsStrSlice>(members: S) -> String {
    return `grammar C;
options { language = Java; }
@parser::members {
${members}
}
r : A { n = 1; } A ;
A : 'a' ;
`;
}

test "a members block the translator refuses leaves the gate unsimulated" {
    let out = gen_source(&members_grammar(
        "    java.util.Map<String, Integer> seen = new java.util.HashMap<>();\n    int n = 0;",
    ));
    assert !out.contains("struct ScanGate"), `a field no member declares must not reach the scan gate: ${out}`;
}

// The rejection case for the test above: without it, that assertion would also
// hold for a grammar that simulates nothing.
test "the same action with a translatable members block reaches the gate" {
    let out = gen_source(&members_grammar("    int n = 0;"));
    assert out.contains("struct ScanGate"), `a declared field stays simulable: ${out}`;
    assert out.contains("n: i32 = 0"), `the gate copies the member's own type and initialiser: ${out}`;
}

// The gate is parser state that every scan walks by reference, never a global.
test "the scan gate lives on the parser" {
    let out = gen_source("grammar C;
options { language = Java; }
@parser::members {
    int n = 0;
}
s : (r | r B)* EOF ;
r : A { n = 1; } A+ ;
A : 'a' ;
B : 'b' ;
");
    assert out.contains("scan_gate: ScanGate = ScanGate {}"), out;
    assert out.contains("fn scan_r(tokens: &Array<i32>, pos: i32, gate: &mut ScanGate,"), out;
    assert !out.contains("global mut"), out;
}

// The LR dispatch launches a scan three ways (branch call, prebound fallback, ATN
// repick); each must start from the parser's gate, not a sibling's reading.
test "every parse-launched LR suffix scan is seeded" {
    let out = gen_source("grammar L;
@parser::members {
    int noStruct = 0;
}
start : e EOF ;
e : e OP a b
  | e OP a c
  | {noStruct == 0}? ID
  | LB {noStruct = 1;} e RB
  ;
a : A ;
b : B ;
c : C ;
OP : '+' ; A : 'a' ; B : 'b' ; C : 'c' ; ID : 'x' ; LB : '(' ; RB : ')' ;
WS : [ \\t\\r\\n]+ -> skip ;
");
    assert out.contains("let _lr_scan_"), `the grammar must reach the pre-bound fallbacks: ${out}`;
    let mut calls = 0;
    let mut seeded = 0;
    let mut after_seed = false;
    for let line of out.split("\n") {
        let l = line.trim();
        if l.contains("_lr_") && l.contains("(&p.kinds, p.pos") {
            calls += 1;
            if after_seed {
                seeded += 1;
            }
        }
        after_seed = l.starts_with("p.scan_gate.") && l.contains(" = p.");
    }
    assert calls > 0, `the grammar must reach a parse-launched LR scan: ${out}`;
    assert seeded == calls, `${calls - seeded} of ${calls} parse-launched LR scans start from a stale gate: ${out}`;
}

test "a prebound LR suffix scan is neither re-tested nor re-seeded" {
    let out = gen_source("grammar L;
@parser::members {
    int noStruct = 0;
}
start : e EOF ;
e : e OP a b
  | e OP a c
  | {noStruct == 0}? ID
  | LB {noStruct = 1;} e RB
  ;
a : A ;
b : B ;
c : C ;
OP : '+' ; A : 'a' ; B : 'b' ; C : 'c' ; ID : 'x' ; LB : '(' ; RB : ')' ;
WS : [ \\t\\r\\n]+ -> skip ;
");
    assert out.contains("let _lr_scan_"), `the grammar must reach the pre-bound fallbacks: ${out}`;
    assert !out.contains("_lr_pos0"), `every suffix opens on OP, so the loop always advances: ${out}`;
    let mut prev = "";
    for let line of out.split("\n") {
        let l = line.trim().to_string();
        assert !(l.starts_with("if _lr_scan_") && l.ends_with("< 0 {")), `a matched prebound scan is re-tested: ${out}`;
        assert !(l.starts_with("let _lr_scan_") && l.contains("_gate = p.scan_gate")), `the parse keeps a gate it never reads: ${out}`;
        assert !(prev.starts_with("let lr_pre") && l.starts_with("*gate = lr_pre")), `the gate is restored to itself: ${out}`;
        prev = l;
    }
}

test "a tournament leaves a simulable gate to the candidate's scan" {
    let out = gen_source("grammar L;
@parser::members {
    int noStruct = 0;
}
start : r EOF ;
r : {noStruct == 0}? ID xs
  | ID xs RB
  | LB {noStruct = 1;} r {noStruct = 0;} RB
  ;
xs : LB+ ;
ID : 'x' ; LB : '(' ; RB : ')' ;
WS : [ \\t\\r\\n]+ -> skip ;
");
    assert out.contains("let _sd_p_0 = "), `the grammar must reach a tournament: ${out}`;
    assert !out.contains("else { -1 }"), `the gate is tested twice: ${out}`;
    assert out.contains("if !((gate.no_struct == 0)) { return -1; }"), `the candidate scan tests the gate: ${out}`;
}

test "a single-token rule with a gated alternative keeps the gate in its scan" {
    // Inside the brackets the gate is false, so `body`'s first alternative cannot
    // start with `x`; scanned without it, it outmatches the second.
    let got = parses("grammar T;
@parser::members {
    int noStruct = 0;
}
start : LB {noStruct = 1;} body {noStruct = 0;} RB EOF | body EOF ;
body : r xs RB | ID xs ;
r : {noStruct == 0}? ID | RB ;
xs : LB+ ;
ID : 'x' ; LB : '(' ; RB : ')' ;
WS : [ \\t\\r\\n]+ -> skip ;
", "start", ["(x()", "x()"]);
    assert got == "(x() => (start ( (body x (xs ()) ))\nx() => (start (body (r x) (xs () )))\n", got;
}

/// The report `gale dump --lexer` prints for `input`.
fn lexer_dump<S: AsStrSlice>(input: S) -> String {
    let inputs: List<[String, String]> = [
        ["test.g4", input.to_string()],
    ];
    return render_lexer_dump(&assemble_grammar(&inputs).unwrap());
}

/// One strategy: the sentence the dump prints for it, and the local the emitter
/// mints when it takes it. Each local is named once per decision.
struct StrategyMarker {
    reported: String,
    emitted: String,
}

global STRATEGY_MARKERS: List<StrategyMarker> = [
    StrategyMarker {
        reported: "maximal munch: every arm scanned",
        emitted: "let mut alts_best_",
    },
    // Not `la_saved_`: the lookahead-aware repeat saves the cursor under that
    // name too, so it names two strategies rather than one.
    StrategyMarker {
        reported: "arm scoring: each arm scored",
        emitted: "let mut la_win_",
    },
    StrategyMarker {
        reported: "lookahead-aware: the inner can eat",
        emitted: "let mut accept_",
    },
    StrategyMarker {
        reported: "non-greedy: min-match loop",
        emitted: "let ng_saved_",
    },
];

// Action-free: a rule that runs actions emits its body twice, to match and to
// replay, so its locals would count double against a report naming each once.
test "every strategy the dump reports is one the emitter emitted" {
    for let src of &[
        "grammar T;\nr : A ;\nA : ('a' | 'ab') ;\nB : . ;", "grammar T;\nr : A ;\nA : 'a' (~'b')+ 'c' ;\nB : . ;",
        "grammar T;\nr : A ;\nA : 'a' .*? 'c' ;\nB : . ;", "grammar T;\nr : A ;\nA : ('a' | 'ab') 'c' ;\nB : . ;",
        "grammar T;\nr : A ;\nA : 'a' 'b'? 'b' ;\nB : . ;",
        "grammar T;\nr : A B ;\nA : 'a' (~'b')+ 'c' | ('x' | 'xy') 'z' ;\nB : 'q' .*? 'r' ;\nC : . ;",
    ] {
        let report = lexer_dump(src);
        let code = gen_source(src);
        for let m of &STRATEGY_MARKERS {
            let reported = count_occurrences(&report, &m.reported);
            let emitted = count_occurrences(&code, &m.emitted);
            assert reported == emitted, `'${m.reported}': the dump reports ${reported}, the emitter emitted ${emitted} — for ${*src}`;
        }
    }
}

test "java members: a refused block declares nothing an action can then resolve" {
    // ANTLR concatenates `@members` blocks, so one malformed block refuses them all,
    // and the refusal is the only diagnostic: no call to a member never declared.
    let out = gen("grammar T;
options { language = Java; }
@members { int good() { return 1; } }
@members { int ; }
a : ID { good(); } ;
ID : [a-z]+ ;
");
    assert !out.source.contains("p.good()"), "a member from a refused block must not be called";
    assert !out.source.contains("fn good"), "a member from a refused block must not be declared";
    assert unsupported_count(&out) >= 1, "the refusal must be reported";
}

test "java members: a well-formed block still resolves across its siblings" {
    let out = gen("grammar T;
options { language = Java; }
@members { int good() { return helper(); } }
@members { int helper() { return 1; } }
a : ID { good(); } ;
ID : [a-z]+ ;
");
    assert out.source.contains("fn good"), "a method declared in one block is emitted";
    assert out.source.contains("fn helper"), "a method declared in a sibling block is emitted";
    assert out.source.contains("p.good()"), "an action resolves a member the struct got";
    assert unsupported_count(&out) == 0, "a well-formed block is not reported";
}

test "each call site passes its own rule arguments, and a return value reaches the next call" {
    let got = parses("grammar T;
s : a=e[1, 2] e[$a.v, (10)] EOF ;
e[int x, int y] returns [int v] : ID { $v = $x + $y; System.out.print($v + \" \"); } ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["a b"]);
    assert got == "a b => (s (e a) (e b)) [3 13 ]\n", got;
}

// `args` scopes the gate for its own extent (`locals` + `@init` / `@after`), so
// the ban on the braced form resumes after the `)`; the scan has to restore it
// the same way or it disagrees with the parse about the head's tail.
test "a rule scoping a gate restores it for the rest of the enclosing head" {
    let got = parses("grammar T;
@parser::members {
    int noBrace = 0;
}
start : stmt+ EOF ;
stmt : IF {noBrace = 1;} expr {noBrace = 0;} block | expr SEMI ;
block : LB ID RB ;
args
locals [int sv]
@init { $sv = noBrace; noBrace = 0; }
@after { noBrace = $sv; }
    : expr
    ;
expr : expr OR expr | ID LP args RP | {noBrace == 0}? ID LB ID RB | ID ;
IF : 'if' ; OR : '||' ; LP : '(' ; RP : ')' ; LB : '{' ; RB : '}' ; SEMI : ';' ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "start", ["if f(x) || a { b }", "if f(a { b }) { c }", "a { b } ;"]);
    assert got == "if f(x) || a { b } => (start (stmt if (expr (expr f ( (args (expr x)) )) || (expr a)) (block { b })))
if f(a { b }) { c } => (start (stmt if (expr f ( (args (expr a { b })) )) (block { c })))
a { b } ; => (start (stmt (expr a { b }) ;))
", got;
}

global LR_SUFFIX_LOOPS: String = "grammar T;
s : e EOF ;
e : e '(' .*? ')'
  | e '[' ID+ ']'
  | e '{' (ID ',')+ '}'
  | e '<' ID*? '>'
  | ID ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
";

test "a left-recursive suffix runs its own loops, greedy and non-greedy" {
    let got = parses(LR_SUFFIX_LOOPS, "s", ["x[a b][c]", "x{a,b,}", "x<a b>", "x<>", "x(y)[z]{w,}<>"]);
    assert got == "x[a b][c] => (s (e (e (e x) [ a b ]) [ c ]))
x{a,b,} => (s (e (e x) { a , b , }))
x<a b> => (s (e (e x) < a b >))
x<> => (s (e (e x) < >))
x(y)[z]{w,}<> => (s (e (e (e (e (e x) ( y )) [ z ]) { w , }) < >))
", got;
}

test "a non-greedy wildcard in a left-recursive suffix exits only where the rest can match" {
    let got = parses(LR_SUFFIX_LOOPS, "s", ["x(a ) b)", "x(a)(b)", "x(a ) [b])"]);
    assert got == "x(a ) b) => (s (e (e x) ( a ) b )))
x(a)(b) => (s (e (e (e x) ( a )) ( b )))
x(a ) [b]) => (s (e (e x) ( a ) [ b ] )))
", got;
}

// The atom's alternatives share `(`, so each one gets a function of its own,
// and the simulator deciding the loop inside it reads the rule's precedence.
test "a non-greedy wildcard in a contested atom alternative decides at the rule's precedence" {
    let got = parses("grammar T;
s : e EOF ;
e : e '+' e | '(' .*? ')' | '(' ID ')' ']' | ID ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["(a b) + (c)", "(a ) b ) + c"]);
    assert got == "(a b) + (c) => (s (e (e ( a b )) + (e ( c ))))
(a ) b ) + c => (s (e (e ( a ) b )) + (e c)))
", got;
}

// Both alternatives of `a` scan `e` at one position, and `t` inside it decides
// by what `a` has left: `e` ends before the `!` under the first and after it
// under the second. The second reaches further only with its own answer, so
// the scan memo keeps no answer that read the caller.
test "a remembered scan answers only where no prediction read its caller" {
    let got = parses("grammar T;
s : a EOF ;
a : e '!' ';' | e ';' ';' ;
e : e '+' e | t ;
t : ID | ID '!' ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["a ! ;", "a ! ; ;", "a + b ! ; ;", "a + b ! ;"]);
    assert got == "a ! ; => (s (a (e (t a)) ! ;))
a ! ; ; => (s (a (e (t a !)) ; ;))
a + b ! ; ; => (s (a (e (e (t a)) + (e (t b !))) ; ;))
a + b ! ; => (s (a (e (e (t a)) + (e (t b))) ! ;))
", got;
}

test "a non-greedy optional in a contested alternative skips where the rest can match" {
    let lr = parses("grammar T;
s : e EOF ;
e : e '+' e | '(' ID?? ID ')' | '(' ID ')' ']' | ID ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["(a)", "(a b)", "(a)+(a b)"]);
    let plain = parses("grammar T;
s : e EOF ;
e : '(' ID?? ID ')' | '(' ID ')' ']' | ID ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["(a)", "(a b)"]);
    let got = `${lr}${plain}`;
    assert got == "(a) => (s (e ( a )))
(a b) => (s (e ( a b )))
(a)+(a b) => (s (e (e ( a )) + (e ( a b ))))
(a) => (s (e ( a )))
(a b) => (s (e ( a b )))
", got;
}

test "a non-greedy wildcard exits only where the whole rest of the input can match" {
    let rule = parses("grammar T;
s : '(' .*? ')' ';' ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["( a ) b ) ;", "( a ) ;"]);
    let group = parses("grammar T;
s : ( '(' .*? ')' | 'x' ) ';' ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["( a ) b ) ;", "x ;"]);
    let caller = parses("grammar T;
s : e 'b' 'c' EOF ;
e : '(' .*? ')' ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["( a ) b ) b c", "( a ) b c"]);
    let got = `${rule}${group}${caller}`;
    assert got == "( a ) b ) ; => (s ( a ) b ) ;)
( a ) ; => (s ( a ) ;)
( a ) b ) ; => (s ( a ) b ) ;)
x ; => (s x ;)
( a ) b ) b c => (s (e ( a ) b )) b c)
( a ) b c => (s (e ( a )) b c)
", got;
}

test "a redundant group around a loop body keeps the loop's decision" {
    let got = parses("grammar T;
s : 'a' (ID)* ID ';'
  | 'b' (ID)+ ID ';'
  | 'c' (ID)+ ';'
  | 'd' (ID)*? ID ';'
  | 'e' (ID)+? ID ';'
  | 'f' (ID)*? ';'
  ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["a x y z;", "a x;", "b x y z;", "b x;", "c x y;", "d x y z;", "e x y z;", "e x;", "f x y;", "f;"]);
    assert got == "a x y z; => (s a x y z ;)
a x; => (s a x ;)
b x y z; => (s b x y z ;)
b x; => error
c x y; => (s c x y ;)
d x y z; => (s d x y z ;)
e x y z; => (s e x y z ;)
e x; => error
f x y; => (s f x y ;)
f; => (s f ;)
", got;
}

test "a loop in a left-recursive suffix scans where its body overlaps what follows" {
    let got = parses("grammar T;
s : e EOF ;
e : e '[' (ID ',')* ID ']'
  | e '{' (ID ',')+ ID '}'
  | e '(' (ID ID | ID ',')* ')'
  | e '<' ID+? '>'
  | ID ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["x[a]", "x[a,b,c]", "x{a,b}", "x{a,b,c}", "x{a}", "x(a b c,)", "x()", "x<a b>", "x<>"]);
    assert got == "x[a] => (s (e (e x) [ a ]))
x[a,b,c] => (s (e (e x) [ a , b , c ]))
x{a,b} => (s (e (e x) { a , b }))
x{a,b,c} => (s (e (e x) { a , b , c }))
x{a} => error
x(a b c,) => (s (e (e x) ( a b c , )))
x() => (s (e (e x) ( )))
x<a b> => (s (e (e x) < a b >))
x<> => error
", got;
}

test "a shape-lookahead optional in a left-recursive suffix is decided per shape" {
    let got = parses("grammar T;
s : e EOF ;
e : ID | e 'in' ( 'a'? 'b' )? 'a' ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["x in a", "x in a b a", "x in b a", "x in a a"]);
    assert got == "x in a => (s (e (e x) in a))
x in a b a => (s (e (e x) in a b a))
x in b a => (s (e (e x) in b a))
x in a a => error
", got;
}

test "a non-greedy optional in a left-recursive suffix leaves the else to its caller" {
    let got = parses("grammar T;
s : e 'else' ID EOF ;
e : ID | e 'if' e ('else' e)?? ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["a else c", "a if b else c", "a if b else c else d"]);
    assert got == "a else c => (s (e a) else c)
a if b else c => (s (e (e a) if (e b)) else c)
a if b else c else d => (s (e (e a) if (e b) else (e c)) else d)
", got;
}

test "interchangeable alternatives are picked by their predicates in grammar order" {
    let got = parses("grammar T;
s : a EOF ;
a : {false}? ID ID {System.out.print(\"one\");}
  | {true}? ID ID {System.out.print(\"two\");}
  | ID ID {System.out.print(\"three\");} ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["a b"]);
    assert got == "a b => (s (a a b)) [two]\n", got;
}

test "interchangeable alternatives whose predicates all fail have no viable alternative" {
    let got = parses("grammar T;
s : a EOF ;
a : {false}? ID ID | {false}? ID ID ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["a b"]);
    assert got == "a b => error\n", got;
}

test "a left-recursive rule runs @after once per invocation, after its whole climb" {
    let got = parses("grammar T;
s : e EOF ;
e
@after { System.out.print(\"done;\"); }
  : e '+' e | INT ;
INT : [0-9]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["1", "1+2+3"]);
    assert got == "1 => (s (e 1)) [done;]\n1+2+3 => (s (e (e (e 1) + (e 2)) + (e 3))) [done;done;done;]\n", got;
}

test "a left-recursive rule's @after reads the value its whole climb computed" {
    let got = parses("grammar T;
options { language = Wado; }
s : x=e { p.emit(`v=${$x.v} `); } ;
e returns [i32 v]
    @init { $v = 1000; }
    @after { p.emit(`[after=${$v}]`); }
    : l=e '+' r=e { $v = $l.v + $r.v; }
    | n=INT { $v = $n.int + $v; }
    ;
INT : [0-9]+ ;
WS : ' ' -> skip ;
", "s", ["5", "5 + 3"]);
    assert got == "5 => (s (e 5)) [[after=1005]v=1005 ]\n5 + 3 => (s (e (e 5) + (e 3))) [[after=1003][after=2008]v=2008 ]\n", got;
}

test "a group in a left-recursive suffix picks the longest of its overlapping alternatives" {
    let got = parses("grammar T;
s : e EOF ;
e : e '.' (ID '(' ')' | ID | ID '[' ']' | '*')
  | ID ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["a.b()", "a.b", "a.b[]", "a.*", "a.b.c().d[].*"]);
    assert got == "a.b() => (s (e (e a) . b ( )))
a.b => (s (e (e a) . b))
a.b[] => (s (e (e a) . b [ ]))
a.* => (s (e (e a) . *))
a.b.c().d[].* => (s (e (e (e (e (e a) . b) . c ( )) . d [ ]) . *))
", got;
}

test "a decided group loop leaves its rule the tail it needs" {
    let got = parses("grammar T;
start : body EOF ;
body : (A Z | B Y)* A Z ;
A : 'a' ; B : 'b' ; X : 'x' ; Y : 'y' ; Z : 'z' ;
WS : [ \\t]+ -> skip ;
", "start", ["a z a z", "b y a z", "a z a z a z", "a z"]);
    assert got == "a z a z => (start (body a z a z))
b y a z => (start (body b y a z))
a z a z a z => (start (body a z a z a z))
a z => (start (body a z))
", got;
}

test "a scanned loop over a complement stops at the excluded tokens" {
    let got = parses("grammar T;
s : (a | b) EOF ;
a : '(' (~')')* ')' 'x' ;
b : '(' (~(')' | ';'))* ')' 'y' ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["(a b)x", "(a;b)x", "(a b)y", "()y", "(a;b)y"]);
    assert got == "(a b)x => (s (a ( a b ) x))
(a;b)x => (s (a ( a ; b ) x))
(a b)y => (s (b ( a b ) y))
()y => (s (b ( ) y))
(a;b)y => error
", got;
}

test "a list label outside a loop takes a token and a set" {
    let got = parses("grammar T;
s : xs+=ID ',' xs+=ID ys+=(A | B) ys+=(A | B) EOF ;
A : '+' ; B : '-' ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["a,b+-", "a,b"]);
    assert got == "a,b+- => (s a , b + -)\na,b => error\n", got;
}

test "left-recursive suffixes sharing an operator split on the token after it" {
    let got = parses("grammar T;
s : e EOF ;
e : e ('+' | '-') e | e ('+' '+') | ID ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["a + b", "a + +", "a + + - b", "a - b + +"]);
    assert got == "a + b => (s (e (e a) + (e b)))
a + + => (s (e (e a) + +))
a + + - b => (s (e (e (e a) + +) - (e b)))
a - b + + => (s (e (e (e a) - (e b)) + +))
", got;
}

test "a group undecided past the static lookahead depth asks the runtime ATN" {
    let got = parses("grammar T;
s : 'k' ( A A A A A A B | A A A A A A C ) EOF ;
A : 'a' ; B : 'b' ; C : 'c' ;
WS : [ \\t]+ -> skip ;
", "s", ["k a a a a a a b", "k a a a a a a c", "k a a a a a a a"]);
    assert got == "k a a a a a a b => (s k a a a a a a b)
k a a a a a a c => (s k a a a a a a c)
k a a a a a a a => error
", got;
}

test "prediction follows a loop body back out to the token after the loop" {
    let got = parses("grammar T;
s : a EOF ;
a : ('x' 'y')* 'z' | ('x' 'y')* 'w' ;
WS : [ \\t]+ -> skip ;
", "s", ["x y z", "x y x y w", "w", "x y"]);
    assert got == "x y z => (s (a x y z))\nx y x y w => (s (a x y x y w))\nw => (s (a w))\nx y => error\n", got;
}

// `xt` and its twins have `'a' 'b'` prefixing `'a' 'b' 'c'`, which the runtime
// ATN decides; an alt-initial predicate removes its alternative from the seed set.
test "a predicate at an ATN-routed decision disables its alternative" {
    let got = parses_each("grammar T;
options { language = Wado; }
takes : xt 'c' ;
xt : 'a' 'b' { p.emit(\"ab\"); }
   | { true }? 'a' 'b' 'c' { p.emit(\"abc\"); }
   ;
rejects : xr 'c' ;
xr : 'a' 'b' { p.emit(\"ab\"); }
   | { false }? 'a' 'b' 'c' { p.emit(\"abc\"); }
   ;
ctxkeep : ck 'c' ;
ck returns [i32 mode] @init { $mode = 1; }
   : 'a' 'b' { p.emit(\"ab\"); }
   | { $mode == 1 }? 'a' 'b' 'c' { p.emit(\"abc\"); }
   ;
ctxdrop : cd 'c' ;
cd returns [i32 mode] @init { $mode = 1; }
   : 'a' 'b' { p.emit(\"ab\"); }
   | { $mode == 0 }? 'a' 'b' 'c' { p.emit(\"abc\"); }
   ;
allfalse : af 'c' ;
af : { false }? 'a' 'b' { p.emit(\"ab\"); }
   | { false }? 'a' 'b' 'c' { p.emit(\"abc\"); }
   ;
scanned : xg 'c'? 'k'* 'x' { p.emit(\"x\"); }
        | xg 'c'? 'k'* 'y' { p.emit(\"y\"); }
        ;
xg : { false }? 'a' 'b' { p.emit(\"ab\"); }
   | 'a' 'b' 'c' { p.emit(\"abc\"); }
   ;
WS : ' ' -> skip ;
", [
        ["takes", "abcc"],
        ["rejects", "abc"],
        ["ctxkeep", "abcc"],
        ["ctxdrop", "abc"],
        ["allfalse", "abcc"],
        ["scanned", "abckx"],
        ["scanned", "abcky"],
    ]);
    assert got == "abcc => (takes (xt a b c) c) [abc]
abc => (rejects (xr a b) c) [ab]
abcc => (ctxkeep (ck a b c) c) [abc]
abc => (ctxdrop (cd a b) c) [ab]
abcc => error
abckx => (scanned (xg a b c) k x) [abcx]
abcky => (scanned (xg a b c) k y) [abcy]
", got;
}

test "a non-greedy loop in a left-recursive suffix stops where the rest of the suffix matches" {
    let got = parses("grammar T;
s : e EOF ;
e : e '<' ID*? ID '>' | e '(' ID+? ID ')' | ID ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["x<a b c>", "x<a>", "x(a b)", "x(a)", "x<>"]);
    assert got == "x<a b c> => (s (e (e x) < a b c >))
x<a> => (s (e (e x) < a >))
x(a b) => (s (e (e x) ( a b )))
x(a) => error
x<> => error
", got;
}

test "a group of rule calls undecided past the static lookahead depth asks the runtime ATN, in the parse and the scan" {
    let got = parses("grammar T;
s : r 'x' EOF | r 'y' EOF ;
r : 'k' ( a | b ) ;
a : A A A A A A B ;
b : A A A A A A C ;
A : 'a' ; B : 'b' ; C : 'c' ;
WS : [ \\t]+ -> skip ;
", "s", ["k a a a a a a b x", "k a a a a a a c y", "k a a a a a a a x"]);
    assert got == "k a a a a a a b x => (s (r k (a a a a a a a b)) x)
k a a a a a a c y => (s (r k (b a a a a a a c)) y)
k a a a a a a a x => error
", got;
}

/// `show_with(ok, input)` shows `parse_s(input)` under a `PBase` whose `ok()`
/// answers `ok`.
global SHOW_WITH_PBASE: String = `${SHOW_FN}
struct Allow {
    ok: bool,
}

impl PBase for Allow {
    fn ok(&self, p: &Parser) -> bool {
        resume self.ok;
    }
}

fn show_with(ok: bool, input: String) with Stdout {
    let mut base = Allow { ok };
    with PBase => &mut base do {
        show(\`\${ok} \${input}\`, parse_s(input));
    };
}
`;

test "a Java grammar's parser base call gates an alternative inside a loop" {
    let got = printed("grammar T;
options { superClass = PBase; }
s : ( {this.ok()}? A | B )* EOF ;
A : 'a' ; B : 'b' ;
", "show_with(true, \"ab\");\nshow_with(false, \"ab\");\nshow_with(false, \"b\");\n", SHOW_WITH_PBASE);
    assert got == "true ab => (s a b)\nfalse ab => error\nfalse b => (s b)\n", got;
}

test "past a shared first token, the next tokens pick the alternative through groups, loops, labels, optionals, sets and rule calls" {
    let got = parses_each("grammar T;
r : A (B|C) D EOF | A (B|C) E EOF ;
s : A B+ C EOF | A B+ D EOF ;
t : A x=B C EOF | A y=B D EOF ;
u : A B? C? D EOF | A B? C? E EOF ;
v : A ~B C EOF | A ~B D EOF ;
w : A ~B C EOF | A D E EOF ;
p : x EOF | y EOF ;
x : A (B | C) C? ;
y : A D ;
q : 'k' A EOF | 'k'* B EOF ;
m : A B X C EOF | A B X D EOF | A E X C EOF | A E X D EOF ;
A : 'a' ; B : 'b' ; C : 'c' ; D : 'd' ; E : 'e' ; X : 'x' ;
", [
        ["r", "acd"],
        ["r", "abe"],
        ["s", "abbc"],
        ["s", "abd"],
        ["t", "abc"],
        ["t", "abd"],
        ["u", "abce"],
        ["u", "ace"],
        ["u", "ad"],
        ["v", "acc"],
        ["v", "aad"],
        ["v", "acd"],
        ["w", "acc"],
        ["w", "adc"],
        ["w", "ade"],
        ["w", "aac"],
        ["p", "ab"],
        ["p", "abc"],
        ["p", "ad"],
        ["p", "acc"],
        ["q", "ka"],
        ["q", "kkb"],
        ["q", "b"],
        ["q", "k"],
        ["m", "abxd"],
        ["m", "aexc"],
    ]);
    assert got == "acd => (r a c d)
abe => (r a b e)
abbc => (s a b b c)
abd => (s a b d)
abc => (t a b c)
abd => (t a b d)
abce => (u a b c e)
ace => (u a c e)
ad => (u a d)
acc => (v a c c)
aad => (v a a d)
acd => (v a c d)
acc => (w a c c)
adc => (w a d c)
ade => (w a d e)
aac => (w a a c)
ab => (p (x a b))
abc => (p (x a b c))
ad => (p (y a d))
acc => (p (x a c c))
ka => (q k a)
kkb => (q k k b)
b => (q b)
k => error
abxd => (m a b x d)
aexc => (m a e x c)
", got;
}

test "a lexer base predicate gates its alternative inside a group, a loop and a fragment" {
    let items = `${SHOW_TOKENS_FN}
struct Gate {
    on: bool,
}

impl B for Gate {
    fn ok(&self, view: LexerView) -> bool {
        resume self.on;
    }
}

fn lex_with(on: bool, input: String) with Stdout {
    let mut base = Gate { on };
    with B => &mut base do {
        show_tokens(\`\${on}\`, &tokenize(input));
    };
}
`;
    let got = printed("lexer grammar L;
options { superClass = B; language = Wado; }
KW : ( { this.ok() }? 'ab' | 'xy' ) ;
NUM : ( { this.ok() }? '1' )+ ;
FR : 'q' G ;
fragment G : { this.ok() }? 'z' ;
ID : [a-z]+ ;
INT : [0-9]+ ;
WS : ' ' -> skip ;
", "lex_with(true, \"ab xy 11 qz\");\nlex_with(false, \"ab xy 11 qz\");\n", items);
    assert got == "true => KW:ab KW:xy NUM:11 FR:qz
false => ID:ab KW:xy INT:11 ID:qz
", got;
}

test "a greedy loop keeps a token its caller could also take, entered directly or not" {
    // `;` follows `list` inside `s`, so it is in `list`'s FOLLOW, but the loop
    // is greedy: the jar takes it into the loop whichever rule the parse
    // entered, as css3's `declarationList` must for a `style` attribute.
    let got = parses_each("grammar T;
s : '{' (list | ';')* '}' ;
list : X (';' X?)* ;
X : 'x' ;
WS : ' ' -> skip ;
", [
        ["list", "x;x"],
        ["list", "x;"],
        ["s", "{x;x}"],
        ["s", "{x;;x}"],
    ]);
    assert got == "x;x => (list x ; x)\nx; => (list x ;)\n{x;x} => (s { (list x ; x) })\n{x;;x} => (s { (list x ; ; x) })\n", got;
}

test "an alternative that also matches EOF does not outrank an earlier one covering the same input" {
    // JavaScript's `statement` shape: a declaration is also an expression
    // statement, whose `eos` takes EOF. Both cover the whole input, so the jar
    // takes the first.
    let got = parses("grammar T;
prog : stmt* EOF ;
stmt : decl | exprStmt ;
decl : 'function' ID '(' ')' block ;
exprStmt : expr eos ;
eos : ';' | EOF ;
expr : fn | ID | expr '(' ')' ;
fn : decl | 'function' '(' ')' block | ID '=>' expr ;
block : '{' stmt* '}' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
", "prog", ["function f() {}", "function f() {} x;"]);
    assert got == "function f() {} => (prog (stmt (decl function f ( ) (block { }))))\nfunction f() {} x; => (prog (stmt (decl function f ( ) (block { }))) (stmt (exprStmt (expr x) (eos ;))))\n", got;
}

test "unclosed elements scan in time linear in their number" {
    // Each `<a>`'s optional scans the rest of the input as its content, and
    // fails at the end; without a memo every element repeats that for each
    // element after it, which doubles per element.
    let mut input = "";
    let mut tree = "(s (c";
    for let _ of 0..<40 {
        input.push_str("<a> x ");
        tree.push_str(" (e < a >) x");
    }
    let got = parses("grammar T;
s : c EOF ;
c : (e | ID)* ;
e : '<' ID '>' (c '<' '/' ID '>')? ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
", "s", [input]);
    assert got == `${input} => ${tree}))\n`, got;
}

test "an optional group yields a token its continuation needs" {
    let got = parses("grammar T;
s : (S | ID)? m ;
m : ID '(' ')' ;
S : 'static' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
", "s", ["f()", "g f()", "static f()"]);
    assert got == "f() => (s (m f ( )))\ng f() => (s g (m f ( )))\nstatic f() => (s static (m f ( )))\n", got;
}

test "a false predicate in an optional prefix skips the prefix rather than the alternative" {
    // JavaScript's `classElement`: `static` is an identifier the predicate
    // recognises by its text, so `f()` is a method with no prefix at all. The
    // jar asks the predicate only where the tokens leave both paths open.
    let got = printed(
        "grammar T;
options { superClass = PBase; }
s : (S | {this.ok()}? ID)? m | ';' ;
m : ID '(' ')' ;
S : 'static' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
",
        "show_with(false, \"f()\");\nshow_with(true, \"f()\");\nshow_with(true, \"g f()\");\nshow_with(false, \"g f()\");\n",
        SHOW_WITH_PBASE,
    );
    assert got == "false f() => (s (m f ( )))\ntrue f() => (s (m f ( )))\ntrue g f() => (s g (m f ( )))\nfalse g f() => error\n", got;
}

test "a parser base call gates alternatives whose first tokens tie" {
    // Prediction cannot pick between `a` and `b` by tokens, so the predicate is
    // a standalone fn; its body must be the rewritten base call, not `this`.
    let got = printed("grammar T;
options { superClass = PBase; }
s : {this.ok()}? a | b ;
a : X ;
b : X ;
X : 'x' ;
", "show_with(true, \"x\");\nshow_with(false, \"x\");\n", SHOW_WITH_PBASE);
    assert got == "true x => (s (a x))\nfalse x => (s (b x))\n", got;
}

test "a parser base decides the tree a superClass grammar's highlighter walks" {
    let options = GenerateOptions { highlight_query: Option::Some(parse_highlight_query(
        "(a (X) @keyword)\n(b (X) @string)",
    ).unwrap()) };
    let out = gen_with("grammar T;
options { superClass = PBase; }
s : {this.ok()}? a | b ;
a : X ;
b : X ;
X : 'x' ;
", &options);
    let items = "struct Allow {
    ok: bool,
}

impl PBase for Allow {
    fn ok(&self, p: &Parser) -> bool {
        resume self.ok;
    }
}

fn highlight_with(ok: bool) with Stdout {
    let mut base = Allow { ok };
    with PBase => &mut base do {
        println(highlight(\"x\"));
    };
}
";
    let got = run_beside(out.source, "highlight_with(true);\nhighlight_with(false);\n", items).stdout;
    assert got == "<span class=\"keyword\">x</span>\n<span class=\"string\">x</span>\n", got;
}

test "a lexer base decides the tokens a lexer grammar's highlighter classifies" {
    let options = GenerateOptions { highlight_query: Option::Some(parse_highlight_query("(KW) @keyword").unwrap()) };
    let out = gen_with("lexer grammar L;
options { superClass = B; }
KW : {this.ok()}? 'ab' ;
ID : [a-z]+ ;
", &options);
    let items = "struct Gate {
    on: bool,
}

impl B for Gate {
    fn ok(&self, view: LexerView) -> bool {
        resume self.on;
    }
}

fn highlight_with(on: bool) with Stdout {
    let mut base = Gate { on };
    with B => &mut base do {
        println(highlight(\"ab\"));
    };
}
";
    let got = run_beside(out.source, "highlight_with(true);\nhighlight_with(false);\n", items).stdout;
    assert got == "<span class=\"keyword\">ab</span>\nab\n", got;
}

test "a parser base call runs in a grammar whose action language has no translator" {
    let got = printed("grammar T;
options { superClass = PBase; language = Cpp; }
s : {this.ok()}? A | B ;
A : 'a' ; B : 'b' ;
", "show_with(true, \"a\");\nshow_with(false, \"a\");\nshow_with(false, \"b\");\n", SHOW_WITH_PBASE);
    assert got == "true a => (s a)\nfalse a => error\nfalse b => (s b)\n", got;
}

test "a parser base is refused where an untranslatable @init carries host code" {
    let out = gen("grammar T;
options { superClass = PBase; language = Cpp; }
s @init { int n = 0; } : {this.ok()}? A | B ;
A : 'a' ; B : 'b' ;
");
    let refusal = "superClass 'PBase' is called from a body carrying host code the grammar's action language has no translator for";
    assert diagnostics_saying(&out, refusal) == 1, "the refused base must be reported";
    assert !out.source.contains("interface PBase"), "no interface is emitted for a refused base";
}

test "a caller argument holding a quoted comma is one argument, in Java and in Wado" {
    let in_java = parses("grammar T;
s : e[\"x,y\", 2] EOF ;
e[String t, int n] : ID { System.out.print($t); System.out.print($n); } ;
ID : [a-z]+ ;
", "s", ["a"]);
    assert in_java == "a => (s (e a)) [x,y2]\n", in_java;
    let in_wado = parses("grammar T;
options { language = Wado; }
s : e[\"x,y\", 2] EOF ;
e[String t, i32 n] : ID { p.emit(`${$t}${$n}`); } ;
ID : [a-z]+ ;
", "s", ["a"]);
    assert in_wado == "a => (s (e a)) [x,y2]\n", in_wado;
}

test "a Java action concatenating a string and an int prints both" {
    let got = parses("grammar T;
s : e[\"x\", 2] EOF ;
e[String t, int n] : ID { System.out.print($t + $n); } ;
ID : [a-z]+ ;
", "s", ["a"]);
    assert got == "a => (s (e a)) [x2]\n", got;
}

test "a Java action steps a member field declared without an initializer" {
    let got = parses("grammar T;
@members { int n; }
s : (ID { n++; })+ EOF { System.out.print(n); } ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
", "s", ["a b c"]);
    assert got == "a b c => (s a b c) [3]\n", got;
}

test "list labels on left-recursive operands keep each operand's precedence" {
    let got = parses("grammar T;
s : e EOF ;
e : e '(' (xs+=e (',' xs+=e)*)? ')'
  | e '*' ys+=e
  | ys+=e '+' e
  | '-' ys+=e
  | <assoc=right> e '?' ys+=e ':' e
  | ID
  ;
ID : [a-z]+ ;
", "s", ["f(a,b)", "a+b*c", "-a+b", "a?b:c+d", "f(a+b)", "a?b?c:d:e", "-f(a)"]);
    assert got == "f(a,b) => (s (e (e f) ( (e a) , (e b) )))
a+b*c => (s (e (e a) + (e (e b) * (e c))))
-a+b => (s (e - (e (e a) + (e b))))
a?b:c+d => (s (e (e a) ? (e b) : (e (e c) + (e d))))
f(a+b) => (s (e (e f) ( (e (e a) + (e b)) )))
a?b?c:d:e => (s (e (e a) ? (e (e b) ? (e c) : (e d)) : (e e)))
-f(a) => (s (e - (e (e f) ( (e a) ))))
", got;
}

test "a label on a negated token or set binds the token it matched" {
    let got = parses("grammar T;
s : x=~A y=~(A|B) z=. EOF { System.out.print($x.text + $y.text + $z.text); } ;
A : 'a' ; B : 'b' ; C : 'c' ;
", "s", ["ccc", "cca"]);
    assert got == "ccc => (s c c c) [ccc]\ncca => (s c c a) [cca]\n", got;
}

test "a fragment two rules share matches in each" {
    let got = lexes("lexer grammar L;
FLOAT : DIGITS '.' DIGITS? ;
INT : DIGITS ;
fragment DIGITS : [0-9]+ ;
WS : ' ' -> skip ;
", ["3.14 42 7.", "1.2.3"]);
    assert got == "3.14 42 7. => FLOAT:3.14 INT:42 FLOAT:7.\n1.2.3 => FLOAT:1.2 error:. INT:3\n", got;
}

test "a fragment's alternation takes its longest arm at the end of a rule, and before a suffix the arm the suffix can follow" {
    let got = lexes("lexer grammar L;
X : AB ;
Y : AB 'c' { System.out.println(\"y\"); } ;
fragment AB : 'a' | 'ab' ;
", ["ab", "abc", "ac", "a"]);
    assert got == "ab => X:ab\nabc => Y:abc [y\n]\nac => Y:ac [y\n]\na => X:a\n", got;
}

test "a number's radix prefix is matched before its digits" {
    let got = lexes("lexer grammar L;
HEX : ('0x' | '0X') [0-9a-fA-F]+ ;
BIN : ('0b') [01]+ ;
INT : [0-9]+ ;
WS : ' ' -> skip ;
", ["0x1F 0b101 0X2 0 0b2"]);
    assert got == "0x1F 0b101 0X2 0 0b2 => HEX:0x1F BIN:0b101 HEX:0X2 INT:0 INT:0 error:b INT:2\n", got;
}

test "an exponent's empty sign arm lets the digits follow the e" {
    let got = lexes("lexer grammar L;
NUM : [0-9]+ ('e' ('+' | '-' | ) [0-9]+)? ;
WS : ' ' -> skip ;
", ["1e5 2e-3 4e"]);
    assert got == "1e5 2e-3 4e => NUM:1e5 NUM:2e-3 NUM:4 error:e\n", got;
}

test "an alternation before an optional suffix takes the arm that reaches furthest" {
    let got = lexes("lexer grammar L;
INT : ('0' | [0-9]+) 'L'? ;
WS : ' ' -> skip ;
", ["0L 007 12L 0"]);
    assert got == "0L 007 12L 0 => INT:0L INT:007 INT:12L INT:0\n", got;
}

test "text up to a tag is one token, and a tag's names another mode's" {
    let got = lexes("lexer grammar L;
OPEN : '<' -> pushMode(TAG) ;
TEXT : ~[<]+ ;
mode TAG;
NAME : [a-z]+ ;
CLOSE : '>' -> popMode ;
", ["a<b>c d", "<x>"]);
    assert got == "a<b>c d => TEXT:a OPEN:< NAME:b CLOSE:> TEXT:c d\n<x> => OPEN:< NAME:x CLOSE:>\n", got;
}

test "a lexer member keeps its state across the parser's literal tokens" {
    let got = lexes("grammar T;
@lexer::members { int ids = 0; }
r : '(' ID+ ')' ;
ID : [a-z]+ { ids = ids + 1; System.out.println(ids); } ;
WS : ' ' -> skip ;
", ["(a b)"]);
    assert got == "(a b) => '(':( ID:a ID:b ')':) [1\n2\n]\n", got;
}

test "a caseInsensitive keyword is told apart from an identifier of ranges" {
    let got = lexes("lexer grammar L;
options { caseInsensitive = true; }
SELECT : 'select' ;
ID : 'a'..'z'+ ;
WS : ' ' -> skip ;
", ["Select FOO selects"]);
    assert got == "Select FOO selects => SELECT:Select ID:FOO ID:selects\n", got;
}

// The jar's tokens, over the same rules with `getText().equals(…)`: a predicate
// after a construct decides where it stops, the trailing one included.
test "a predicate after a loop, an optional or an alternation decides where it stops" {
    let got = lexes("lexer grammar L;
options { language = Wado; }
MID : 'a' .+ { $text == \"azz\" }? 'z' ;
END : 'b' .+ 'z' { $text == \"bzz\" }? ;
TAIL : 'c' .+ { $text == \"czz\" }? ;
OPT : 'd' 'z'? { $text == \"d\" }? ;
ARM : ('e' | 'ez') { $text == \"e\" }? 'z' ;
LAST : ('f' | 'fz') { $text == \"fz\" }? ;
X : . ;
", ["azzzz", "bzzzz", "czzzz", "dz", "ezz", "fz"]);
    assert got == "azzzz => MID:azzz X:z
bzzzz => END:bzz X:z X:z
czzzz => TAIL:czz X:z X:z
dz => OPT:d X:z
ezz => ARM:ez X:z
fz => LAST:fz
", got;
}

test "an optional leaves the char the rest of the rule needs" {
    let got = lexes("lexer grammar L;
OVER : 'g' 'z'? 'z' ;
X : . ;
", ["gz", "gzz"]);
    assert got == "gz => OVER:gz\ngzz => OVER:gzz\n", got;
}

// The jar's tokens; its predicates read `getText().equals(…)`.
test "a repeat over a string leaves the iterations the rest of the rule needs" {
    let got = lexes("lexer grammar L;
options { language = Wado; }
OPT : 'x' ('ab')? 'ab' ;
LOOP : 'y' ('ab')* 'ab' 'q' ;
PRED_OPT : 'b' ('xy')? { $text == \"b\" }? ;
PRED_LOOP : 'c' ('xy')+ { $text == \"cxy\" }? ;
X : . ;
", ["xab", "yababq", "bxy", "cxyxy"]);
    assert got == "xab => OPT:xab
yababq => LOOP:yababq
bxy => PRED_OPT:b X:x X:y
cxyxy => PRED_LOOP:cxy X:x X:y
", got;
}

test "a greedy loop hands back the chars a predicate-carrying suffix needs" {
    let got = lexes("lexer grammar L;
options { language = Wado; }
S : 'a' .+ END ;
fragment END : { true }? 'z' ;
", ["abz"]);
    assert got == "abz => S:abz\n", got;
}

test "an alternation before a predicate takes the arm the rest of the rule needs" {
    let after = lexes("lexer grammar L;
options { language = Wado; }
I : ('a' | 'ab') { true }? 'bc' ;
", ["abbc"]);
    let inside = lexes("lexer grammar L;
options { language = Wado; }
I : ('a' | 'ab') END ;
fragment END : { true }? 'bc' ;
", ["abbc"]);
    assert after == "abbc => I:abbc\n", after;
    assert inside == "abbc => I:abbc\n", inside;
}

test "an identifier made of another token's chars takes the longest match and the first rule on a tie" {
    let got = lexes("lexer grammar L;
ID : (LETTER | '_')+ ;
LETTER : [a-z] ;
WS : ' ' -> skip ;
", ["ab a _"]);
    assert got == "ab a _ => ID:ab ID:a ID:_\n", got;
}

test "a keyword declared after the identifier rule never wins" {
    // Both match `if` at the same length, and ANTLR4 gives a tie to the rule
    // declared first.
    let got = lexes("lexer grammar L;
ID : [a-z]+ ;
IF : 'if' ;
WS : ' ' -> skip ;
", ["if x"]);
    assert got == "if x => ID:if ID:x\n", got;
}

test "a mode whose only rule starts with any char still lexes" {
    let got = lexes("lexer grammar L;
HASH : '#' -> pushMode(LINE) ;
ID : [a-z]+ ;
mode LINE;
REST : ~[;]+ -> popMode ;
", ["#include foo", "ab#x"]);
    assert got == "#include foo => HASH:# REST:include foo\nab#x => ID:ab HASH:# REST:x\n", got;
}

test "a greedy star hands back the chars its suffix needs" {
    let got = lexes("lexer grammar L;
S : 'a' .* 'c' ;
", ["abcbc", "ac", "abcb"]);
    assert got == "abcbc => S:abcbc\nac => S:ac\nabcb => S:abc error:b\n", got;
}

test "a greedy plus stops where a fragment suffix can still match" {
    let got = lexes("lexer grammar L;
S : 'a' .+ END ;
fragment END : 'z' 'z' ;
", ["abzzczz", "azzz", "azz"]);
    assert got == "abzzczz => S:abzzczz\nazzz => S:azzz\nazz => error:a error:z error:z\n", got;
}

test "a greedy star before an alternation ending in EOF runs to the last match" {
    let got = lexes("lexer grammar L;
LINE : '#' .* (';' | EOF) ;
", ["#a;b;#c", "#a;"]);
    assert got == "#a;b;#c => LINE:#a;b;#c\n#a; => LINE:#a;\n", got;
}

test "a non-greedy plus consumes one char before it tries to exit" {
    let got = lexes("lexer grammar L;
CMT : '/*' .+? '*/' ;
SL : '/' ;
ST : '*' ;
", ["/**/", "/***/", "/*a*/*/"]);
    assert got == "/**/ => SL:/ ST:* ST:* SL:/\n/***/ => CMT:/***/\n/*a*/*/ => CMT:/*a*/ ST:* SL:/\n", got;
}

test "a scored alternation runs only the winning arm's action" {
    let got = lexes("lexer grammar L;
I : ('a' { System.out.println(\"short\"); } | 'ab' { System.out.println(\"long\"); }) 'bc' ;
", ["abc", "abbc"]);
    assert got == "abc => I:abc [short\n]\nabbc => I:abbc [long\n]\n", got;
}

test "a keyword is told apart from an identifier built of fragments and ranges" {
    let got = lexes("lexer grammar L;
IF : 'if' ;
ID : LETTER (LETTER | '0'..'9')* ;
fragment LETTER : 'a'..'z' | '_' ;
WS : ' ' -> skip ;
", ["if iff x_1 if1 _if"]);
    assert got == "if iff x_1 if1 _if => IF:if ID:iff ID:x_1 ID:if1 ID:_if\n", got;
}

test "a keyword is recognized only in the default mode" {
    // In `TAG`, `ATTR` retypes its match to `ID`, the kind `END` is classified
    // out of in the default mode; the mode, not the kind, keeps it an `ID` there.
    let got = lexes("lexer grammar L;
END : 'end' ;
NIL : 'NIL' ;
ID : [a-z]+ ;
CONST : [A-Z]+ ;
LT : '<' -> pushMode(TAG) ;
WS : ' ' -> skip ;
mode TAG;
ATTR : [a-z]+ -> type(ID) ;
GT : '>' -> popMode ;
TAG_WS : ' ' -> skip ;
", ["end ends NIL NILS <end x> end"]);
    assert got == "end ends NIL NILS <end x> end => END:end ID:ends NIL:NIL CONST:NILS LT:< ID:end ID:x GT:> END:end\n", got;
}

test "a keyword reclassified out of its carrier does not run the carrier's action" {
    let got = lexes("lexer grammar L;
IF : 'if' ;
ID : [a-z]+ { System.out.println(\"id\"); } ;
NUM : [0-9]+ { System.out.println(\"num\"); } ;
WS : ' ' -> skip ;
", ["if x 1"]);
    assert got == "if x 1 => IF:if ID:x NUM:1 [id\nnum\n]\n", got;
}

test "a hidden-channel token between two tokens does not reach the parser" {
    let got = parses("grammar T;
r : ID+ EOF ;
ID : [a-z]+ ;
CMT : '#' [a-z]* -> channel(HIDDEN) ;
WS : ' ' -> skip ;
", "r", ["a #bc d", "a#b"]);
    assert got == "a #bc d => (r a d)\na#b => (r a)\n", got;
}

test "a more rule's text joins the token its mode switch leads to" {
    let got = lexes("lexer grammar L;
TEXT : [a-z]+ ;
HASH : '#' -> more, mode(NUM) ;
DOT : '.' -> channel(HIDDEN) ;
WS : ' ' -> skip ;
mode NUM;
NUMBER : [0-9]+ -> mode(DEFAULT_MODE) ;
", ["ab #12 cd", "ab.cd"]);
    assert got == "ab #12 cd => TEXT:ab NUMBER:#12 TEXT:cd\nab.cd => TEXT:ab TEXT:cd\n", got;
}

test "a string whose escapes share a lead char is lexed by the lexer ATN" {
    let got = lexes("lexer grammar L;
STR : '\"' (~('\\\\' | '\"') | '\\\\' . | '\\\\x' HEX HEX? | '\\\\u{' HEX+ '}')* '\"' ;
fragment HEX : '0'..'9' | 'a'..'f' ;
", ["\"a\\x41\"", "\"\\\"\"", "\"\\x\"", "\"\\u{1f600}\""]);
    assert got == "\"a\\x41\" => STR:\"a\\x41\"\n\"\\\"\" => STR:\"\\\"\"\n\"\\x\" => STR:\"\\x\"\n\"\\u{1f600}\" => STR:\"\\u{1f600}\"\n", got;
}

// Each alternative that competes with a loop agrees with two of its
// iterations, so only a walk that re-enters the loop tells them apart.
test "a prediction walks a loop through more than one iteration" {
    let got = parses("grammar T;
t : s EOF ;
s : ('x' 'y' | 'x' 'z')* 'p' | 'x' 'y' 'x' 'w' | u | v ;
u : 'a'* 'p' | 'a' 'a' 'w' ;
v : ('b' 'c' | 'b' 'd')+ 'q' | 'b' 'c' 'b' 'w' ;
WS : [ \\t]+ -> skip ;
", "t", ["x y x z p", "x y x w", "x y x y p", "a a p", "a a w", "a a a p", "b c b d q", "b c b w", "b d q"]);
    assert got == "x y x z p => (t (s x y x z p))
x y x w => (t (s x y x w))
x y x y p => (t (s x y x y p))
a a p => (t (s (u a a p)))
a a w => (t (s (u a a w)))
a a a p => (t (s (u a a a p)))
b c b d q => (t (s (v b c b d q)))
b c b w => (t (s (v b c b w)))
b d q => (t (s (v b d q)))
", got;
}
