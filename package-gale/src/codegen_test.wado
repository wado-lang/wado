global DEFAULT_OPTIONS: GenerateOptions = GenerateOptions {};

test "generate header" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.len() > 0;
    // Grammar was constructed with no source_files, so gen_header emits an
    // empty sources list rather than fabricating a nonexistent `{name}.g4`.
    let header = `#![generated(by = "gale", sources = [])]`;
    for let mut i = 0; i < header.len(); i += 1 {
        assert output.get_byte_unchecked(i) == header.get_byte_unchecked(i);
    }
}

test "generate header with multiple source files" {
    let mut grammar = Grammar {
        name: "Html",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: ["HtmlLexer.g4", "HtmlParser.g4"],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let header = `#![generated(by = "gale", sources = ["HtmlLexer.g4", "HtmlParser.g4"])]`;
    for let mut i = 0; i < header.len(); i += 1 {
        assert output.get_byte_unchecked(i) == header.get_byte_unchecked(i);
    }
}

test "generate token kind" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [
            LexerRule::new("NUMBER", false, false, []),
            LexerRule::new("DIGIT", true, false, []),
            LexerRule::new("WS", false, true, []),
        ],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert str_contains(&output, &"pub enum TokenKind {");
    assert str_contains(&output, &"    NUMBER,");
    assert str_contains(&output, &"    WS,");
    assert str_contains(&output, &"    Eof,");
    assert str_contains(&output, &"    Error,");
    assert !str_contains(&output, &"    DIGIT,");
}

test "node-kind constants are pub so consumers can dispatch on CstNode.kind" {
    let mut grammar = parse("grammar T; prog : expr ; expr : INT ; INT : [0-9]+ ;").unwrap();
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert str_contains(&output, &"pub global RK_PROG:");
    assert str_contains(&output, &"pub global RK_EXPR:");
    // No non-pub `global RK_` line should remain.
    assert !str_contains(&output, &"\nglobal RK_");
}

test "duplicate same-rule alt labels coalesce to one enum case (valid in ANTLR4)" {
    // ANTLR4 accepts a `# Label` repeated within one rule: the alternatives
    // share one alternative kind (one context class). The generated
    // `<Rule>Alt` enum must emit the label once — a duplicate variant would
    // not compile — while the accessor maps every alt index to it.
    let input = "grammar Test;
e : e '+' e # Bin | e '-' e # Bin | INT # Num ;
INT : [0-9]+ ;
WS : [ \\t\\r\\n]+ -> skip ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert str_contains(&output, &"pub enum EAlt {");
    // The shared label appears once (no `Bin,\n    Bin,` duplicate variant).
    assert !str_contains(&output, &"    Bin,\n    Bin,");
    assert str_contains(&output, &"    Num,");
    // The accessor returns Option so an unstamped/error node is None, not a
    // silent first-alternative; both `# Bin` alts (0 and 1) map to one case.
    assert str_contains(&output, &"pub fn e_alt(&self, node: i32) -> Option<EAlt>");
    assert str_contains(&output, &"0 => Option::Some(EAlt::Bin),");
    assert str_contains(&output, &"1 => Option::Some(EAlt::Bin),");
    assert str_contains(&output, &"2 => Option::Some(EAlt::Num),");
    assert str_contains(&output, &"_ => null,");
}

test "reserved-word alt labels are escaped to valid identifiers" {
    // A `# Label` may be a Wado reserved word (ANTLR4's `ReservedWordsEscaping`
    // uses `# else`). The `<Rule>Alt` enum variant and accessor arm must escape
    // it (append `_`) or the generated code does not compile. Non-reserved
    // labels are left unchanged.
    let input = "grammar Test;
r : A # else | B # loop | C # Keep ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert str_contains(&output, &"pub enum RAlt {");
    assert str_contains(&output, &"    else_,");
    assert str_contains(&output, &"    loop_,");
    assert str_contains(&output, &"    Keep,");
    assert !str_contains(&output, &"    else,");
    assert !str_contains(&output, &"    loop,");
    assert str_contains(&output, &"0 => Option::Some(RAlt::else_),");
    assert str_contains(&output, &"1 => Option::Some(RAlt::loop_),");
    assert str_contains(&output, &"2 => Option::Some(RAlt::Keep),");
}

