test "generate scalar-labeled group `t=(a | b)`" {
    // Regression: Sets/ParserSet.txt — `a : t=('x' | 'y') ;` lowers the
    // scalar label so that the resulting op is `Op::Group(...)` while
    // the surface element stays `Label(Group(...))`. The op-driven
    // walker dispatches on the op shape and used to feed the Label
    // element straight into `gen_op_group`, which only accepted
    // `Element::Group`. The walker now peels scalar `Label(...)` once
    // before dispatching, so the callee sees the inner Group element
    // and the surface field name survives via the rebound op.
    let mut grammar = parse_grammar("grammar T; a : t=('x' | 'y') ;", "(test)");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("TK_LIT_x");
    assert output.contains("TK_LIT_y");
    assert output.contains("p.expect_set(&SYNC_");
    // A peel regression panics in `gen_op_group`; transparency is what is left.
    let mut bare = parse_grammar("grammar T; a : ('x' | 'y') ;", "(test)");
    let bare_output = generate(&mut bare, &DEFAULT_OPTIONS).source;
    let labeled_body = extract_fn_body(&output, "fn _parse_a__inner(");
    let bare_body = extract_fn_body(&bare_output, "fn _parse_a__inner(");
    assert labeled_body == bare_body, `scalar label changed the emit:\nlabeled: ${labeled_body}\nbare:    ${bare_body}`;
}

test "generate scalar-labeled wildcard repeat `t=.*`" {
    // A suffix binds outside the label, so this is Repeat(Label(Wildcard)):
    // the walker peels the Label inside the body, not at the Repeat itself.
    let mut grammar = parse_grammar("grammar T; a : t=.* ; A : 'a' ;", "(test)");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("any");
}

