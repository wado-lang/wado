    assert output.contains("//   @header");
    assert output.contains("//   @parser::members");
    assert output.contains("//   @lexer::members");
}

test "metadata block omitted when no options and no named actions" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert !output.contains("// Grammar metadata from source .g4 prequels:");
}

test "visibility comment emitted on non-default parser rule" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [
            ParserRule {
                name: "expr",
                visibility: Visibility::Public,
                options: [],
                alternatives: [
                    Alternative {
                        label: null,
                        options: [],
                        elements: [Element::TokenRef(TokenRefElement::new("ID"))],
                    },
                ],
            },
            ParserRule {
                name: "plain",
                visibility: Visibility::Default,
                options: [],
                alternatives: [
                    Alternative {
                        label: null,
                        options: [],
                        elements: [Element::TokenRef(TokenRefElement::new("ID"))],
                    },
                ],
            },
        ],
        lexer_rules: [LexerRule::new("ID", false, false, [])],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("// rule visibility: public (ignored by codegen, matches ANTLR4)");
    // Default visibility must not add any comment.
    assert !output.contains("// rule visibility: default");
}

test "visibility comment emitted on non-default lexer rule" {
    let mut id_rule = LexerRule::new("ID", false, false, []);
    id_rule.visibility = Visibility::Protected;
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [id_rule],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("// rule visibility: protected (ignored by codegen, matches ANTLR4)");
}

test "single-char literal lexer rule without an identifier carrier emits its own try_ matcher" {
    // The keyword classifier runs only after a longer carrier rule matched, and
    // this grammar has none, so single-letter literals keep their own matcher.
    let input = "grammar Test;
r : A B ;
A : 'A' ;
B : 'B' ;
WS : [ \\t\\n\\r]+ -> skip ;
";
    let output = gen_source(input);
    assert output.contains("fn try_A(");
    assert output.contains("fn try_B(");
    assert output.contains("'A' => {");
    assert output.contains("'B' => {");
}

test "set list-label `name+=(A | B)*` takes the token its loop guard proved" {
    let input = "grammar T;
b : ID val+=(INT | FLOAT)* ;
ID : 'a'..'z'+ ;
INT : '0'..'9'+ ;
FLOAT : [0-9]+ '.' [0-9]+ ;
WS : (' '|'\\n') -> skip ;
";
    let output = longest_source(input);
    let body = extract_fn_body(&output, "fn _parse_b__inner(");
    assert body.contains("while !p.recovering && _kind_set_0(p.peek_kind())");
    assert body.contains("p.take();");
    assert !body.contains("expect_set");
}

test "a sync set is tested as bits, and listed only where a diagnostic names it" {
    let output = gen_source("grammar T;\ns : A B C EOF ;\nA : 'a' ;\nB : 'b' ;\nC : 'c' ;\n");
    assert output.contains("global SYNC_0: List<i32> = [2];");
    assert !output.contains("global EXPECTED_");
    assert !output.contains("fn in_set(");
}

test "non-greedy optional (??) emits Option<T> + single if" {
    let input = "grammar T;
start : statement+ EOF ;
statement : 'x' | ifStmt ;
ifStmt : 'if' 'y' statement ('else' statement)?? ;
";
    let output = gen_source(input);
    let body = extract_fn_body(&output, "fn _parse_if_stmt__inner(");
    // The `??` enter/skip decision is the ATN simulator's, stamped at compile time,
    // so the shape stays one `if` on the simulator's pick.
    assert body.contains("let rs_pick_");
    assert body.contains(" = atn_decide_");
    assert body.contains("== 1 {");
    assert !body.contains("atn_ng_optional_enter(");
    assert !body.contains("if p.peek_kind() == TK_LIT_else");
    assert !body.contains("while p.peek_kind() == TK_LIT_else");
}

test "single-char literal with an ID carrier stays a keyword (no try_ matcher)" {
    // `ID` covers 'A' as a first character, so the keyword classifier is reachable
    // and `A` needs no `try_A` of its own.
    let input = "grammar Test;
r : A ID ;
A : 'A' ;
ID : [a-zA-Z]+ ;
WS : [ \\t\\n\\r]+ -> skip ;
";
    let output = gen_source(input);
    assert !output.contains("fn try_A(");
    assert output.contains("classify_keyword");
}

test "generate returns source and lowering diagnostics from one lowering" {
    // Both alts start with `A`, so lowering raises one OverlapTournament; `generate`
    // returns it on `GeneratedOutput` so `gale gen` need not lower twice.
    let input = "grammar Test;
r : A B | A C ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
";
    let generated = gen(input);
    assert generated.diagnostics.len() == 1;
    let d = &generated.diagnostics[0];
    assert d.owner.rule == "r", "expected the diagnostic to own rule \"r\"";
    if let OverlapTournament = &d.kind {
    } else {
        panic("expected DiagnosticKind::OverlapTournament");
    }
}

test "one alternative overlaps nothing, whatever it admits" {
    let input = "grammar Test;
e : e '+' A | . ;
A : 'a' ;
";
    let generated = gen(input);
    assert generated.diagnostics.is_empty(), "a lone alternative has nothing to overlap";
}

test "generate raises no diagnostics for disjoint alts" {
    let input = "grammar Test;
r : A | B ;
A : 'a' ;
B : 'b' ;
";
    let generated = gen(input);
    assert generated.diagnostics.is_empty(), "expected no diagnostics";
}

test "an optional group's entry guard is the scan its dispatch decides on" {
    // Alts 0 and 2 share FIRST, so entry and choice are one longest-match question:
    // each alt is scanned once, and the dispatch reads the entry guard's winner.
    let input = "grammar Test;
stmt : 'k' ( a | b | a '.' b )? ;
a : A+ ;
b : B+ ;
A : 'a' ;
B : 'b' ;
";
    let output = longest_source(input);
    let body = extract_fn_body(&output, "fn _parse_stmt__inner(");
    let scans_a = count_occurrences(&body, "scan_a(");
    let scans_b = count_occurrences(&body, "scan_b(");
    assert scans_a == 2, "alts 0 and 2 name 'a' once each";
    assert scans_b == 2, "alts 1 and 2 name 'b' once each";
}

// `??` in an LR atom: its ATN prediction runs under the live `min_prec`, so an
// enter edge that would climb a lower LR suffix is pruned.
global QQ_IN_LR_G4: String = "
grammar T;
e : e '+' e | ID ('x')?? ;
ID : 'a'..'z'+ ;
WS : ' ' -> skip ;
";

test "non-greedy ?? inside a left-recursive rule threads min_prec" {
    let output = gen_source(QQ_IN_LR_G4);
    // The atom fn carries `min_prec`, and the `??` enter check forwards it
    // to the simulator (stamped decision number, `== 1` for ENTER).
    assert output.contains("fn _parse_e__inner_atom(p: &mut Parser, min_prec: i32");
    assert output.contains("(&mut p.atn, &p.kinds, p.pos, min_prec);");
    assert output.contains("== 1 {");
    assert output.contains("atn_predict_once(&ATN_SIM,");
}

// A multi-alt `AtEndConflict` must route through the ATN simulator, not the
// `_sd_best_i` longest-match tournament.
global AT_END_CONFLICT_G4: String = "
grammar T;
s : x 'c' ;
x : 'a' 'b' | 'a' 'b' 'c' ;
WS : ' ' -> skip ;
";

global AT_END_DISJOINT_G4: String = "
grammar T;
s : x 'd' ;
x : 'a' 'b' | 'a' 'b' 'c' ;
WS : ' ' -> skip ;
";

test "FOLLOW-disjoint at-end conflict keeps the static tournament" {
    let output = gen_source(AT_END_DISJOINT_G4);
    let body = extract_fn_body(&output, "fn _parse_x__inner(");
    assert body.contains("_sd_best_i");
    assert !body.contains("atn_predict");
    assert !output.contains("global ATN_SIM");
}

global AT_END_WILDCARD_FOLLOW_G4: String = "
grammar T;
s : x . ;
x : 'a' 'b' | 'a' 'b' 'c' ;
WS : ' ' -> skip ;
";

test "a wildcard after the call leaves an at-end conflict to the token after it" {
    // Only the token after `x`'s longer alternative tells them apart.
    let got = parses(AT_END_WILDCARD_FOLLOW_G4, "s", ["a b c", "a b c a", "a b a"]);
    assert got == "a b c => (s (x a b) c)\na b c a => (s (x a b c) a)\na b a => (s (x a b) a)\n";
}

global LOOP_AFTER_NULLABLE_CALL_G4: String = "
grammar T;
s : a ws (c a ws)* '{' ;
c : '>' ws | SP ws ;
a : ID | '.' ID ;
ws : SP* ;
SP : ' ' ;
ID : [a-z]+ ;
";

test "a nullable callee yields a token to the caller loop that follows it" {
    // css3's `selector`: the `SP` after `x` is the descendant combinator, which
    // only another iteration of the caller's loop takes.
    let got = parses(LOOP_AFTER_NULLABLE_CALL_G4, "s", ["x y{", "x .y {", "x > y {", "x {"]);
    assert got == "x y{ => (s (a x) ws (c   ws) (a y) ws {)\nx .y { => (s (a x) ws (c   ws) (a . y) (ws  ) {)\nx > y { => (s (a x) (ws  ) (c > (ws  )) (a y) (ws  ) {)\nx { => (s (a x) (ws  ) {)\n";
}

global OPTIONAL_TOKEN_ALSO_NAME_G4: String = "
grammar T;
s : '{' m (';' m)* '}' ;
m : RO? name '?'? (':' ID)? ;
name : ID | RO ;
RO : 'readonly' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "an optional token that can also start what follows it is taken on the second token" {
    // TypeScript's `ReadOnly? propertyName`, where `readonly` is a name too.
    let got = parses(OPTIONAL_TOKEN_ALSO_NAME_G4, "s", [
        "{readonly id: x}", "{readonly: x}", "{readonly}", "{readonly id}", "{readonly readonly}", "{a; readonly b: x}",
    ]);
    assert got == "{readonly id: x} => (s { (m readonly (name id) : x) })\n{readonly: x} => (s { (m (name readonly) : x) })\n{readonly} => (s { (m (name readonly)) })\n{readonly id} => (s { (m readonly (name id)) })\n{readonly readonly} => (s { (m readonly (name readonly)) })\n{a; readonly b: x} => (s { (m (name a)) ; (m readonly (name b) : x) })\n";
}

global OPTIONAL_SEPARATOR_AFTER_LIST_G4: String = "
grammar T;
s : '{' body? '}' ;
body : list ';'? ;
list : m (';' m)* ;
m : RO? name (':' ID)? ;
name : ID | RO ;
RO : 'readonly' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "a continuation scan accepts a token an optional suffix of its caller can take" {
    // TypeScript's `typeBody : typeMemberList (SemiColon | ',')?`: the `;`
    // after the last member is the suffix's, which the gate does not spell.
    let got = parses(OPTIONAL_SEPARATOR_AFTER_LIST_G4, "s", [
        "{readonly id: x;}", "{readonly id: x}", "{a; readonly b;}", "{readonly;}",
    ]);
    assert got == "{readonly id: x;} => (s { (body (list (m readonly (name id) : x)) ;) })\n{readonly id: x} => (s { (body (list (m readonly (name id) : x))) })\n{a; readonly b;} => (s { (body (list (m (name a)) ; (m readonly (name b))) ;) })\n{readonly;} => (s { (body (list (m (name readonly))) ;) })\n";
}

global TAIL_OPTIONAL_RECURSION_G4: String = "
grammar T;
s : e ';' ;
e : e '(' ')' | ID e? | '(' ')' '=>' ID ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "a tail optional enters only where its body can match" {
    // TypeScript's `identifierName singleExpression?`: `(` may begin an arrow
    // function, and in `f()` it begins the call's arguments instead.
    let got = parses(TAIL_OPTIONAL_RECURSION_G4, "s", ["f();", "f () => x;", "f g;", "f g();"]);
    assert got == "f(); => (s (e (e f) ( )) ;)\nf () => x; => (s (e f (e ( ) => x)) ;)\nf g; => (s (e f (e g)) ;)\nf g(); => (s (e f (e (e g) ( ))) ;)\n";
}

test "an optional's continuation scan that covers the rest of an alternative ends its scan" {
    let output = longest_source("
grammar T;
s : (a ';' | a 'e') ;
a : 'b'? c ;
c : 'b'* 'c' 'c' ;
WS : ' ' -> skip ;
");
    let body = extract_fn_body(&output, "fn scan_a(");
    assert body.contains("cont_done_"), "a continuation scan that holds scans `c` once";
}

global TAIL_OPTIONAL_IN_TOURNAMENT_ATOM_G4: String = "
grammar T;
s : 'x' '=' e ';' ;
e : e '(' ')' | ID e? | ID '.' ID | '(' ')' '=>' ID ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "a tail optional in a contested atom alternative sees the suffix loop" {
    // TypeScript's `l: X = f();` in a class body: the caller's `;` cannot
    // start at `(`, but the call suffix can, so `(` is no arrow function.
    let got = parses(TAIL_OPTIONAL_IN_TOURNAMENT_ATOM_G4, "s", [
        "x = f();", "x = f () => y;", "x = a.b();", "x = f g();",
    ]);
    assert got == "x = f(); => (s x = (e (e f) ( )) ;)\nx = f () => y; => (s x = (e f (e ( ) => y)) ;)\nx = a.b(); => (s x = (e (e a . b) ( )) ;)\nx = f g(); => (s x = (e f (e (e g) ( ))) ;)\n";
}

global TAIL_OPTIONAL_BEFORE_ITS_FOLLOW_G4: String = "
grammar T;
s : '(' e ID e ')' ;
e : ID e? ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "a tail optional whose follow also matches enters while entering stays viable" {
    // TypeScript's `for (const x of list)`: `x of` starts the continuation
    // `identifier expressionSequence`, and ANTLR4 still enters at `x`.
    let got = parses(TAIL_OPTIONAL_BEFORE_ITS_FOLLOW_G4, "s", ["(a b c)", "(a b c d)", "(a b c d e)"]);
    assert got == "(a b c) => (s ( (e a) b (e c) ))\n(a b c d) => (s ( (e a (e b)) c (e d) ))\n(a b c d e) => (s ( (e a (e b (e c))) d (e e) ))\n";
}

global LOOP_BODY_CALL_G4: String = "
grammar T;
s : '{' cs? ('default' ':' cs?)? '}' ;
cs : c+ ;
c : 'case' ID ':' st* ;
st : ID ';' | 'case' ID ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "a rule that is a loop's whole body hears the loop's next iteration" {
    // TypeScript's `caseClauses : caseClause+`: a clause's statements stop at
    // the next `case b :`, which only the loop around the clause knows about.
    let got = parses(LOOP_BODY_CALL_G4, "s", [
        "{ case a: x; case b: y; }", "{ case a: case b: y; default: case c: z; }", "{ case a: case b x; }",
    ]);
    assert got == "{ case a: x; case b: y; } => (s { (cs (c case a : (st x ;)) (c case b : (st y ;))) })\n{ case a: case b: y; default: case c: z; } => (s { (cs (c case a :) (c case b : (st y ;))) default : (cs (c case c : (st z ;))) })\n{ case a: case b x; } => (s { (cs (c case a : (st case b) (st x ;))) })\n";
}

global LOOP_ENDING_RULE_G4: String = "
grammar T;
s : '{' cs? ('default' ':' st*)? '}' ;
cs : c+ ;
c : 'case' ID ':' sl? ;
sl : st+ ;
st : e ';'? ;
e : ID | 'default' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "a loop ending its rule declines an iteration its caller's token would strand" {
    // TypeScript's `statementList : statement+` inside a case clause: `default`
    // is a one-token statement, and taking it leaves `:` to nobody.
    let got = parses(LOOP_ENDING_RULE_G4, "s", [
        "{ case a: x; default: y; }", "{ case a: default; }", "{ case a: x default: y }", "{ case a: default }",
    ]);
    assert got == "{ case a: x; default: y; } => (s { (cs (c case a : (sl (st (e x) ;)))) default : (st (e y) ;) })\n{ case a: default; } => (s { (cs (c case a : (sl (st (e default) ;)))) })\n{ case a: x default: y } => (s { (cs (c case a : (sl (st (e x))))) default : (st (e y)) })\n{ case a: default } => (s { (cs (c case a : (sl (st (e default))))) })\n";
}

global LOOP_BODY_TAIL_G4: String = "
grammar T;
top : (s | m) EOF ;
s : 'a' (',' x)* 'k' ;
m : 'm' (x | 'c')* 'k' ;
x : 'b' 'k'? ;
WS : ' ' -> skip ;
";

test "a call ending a loop body hears what follows the loop, not its rule's end" {
    // SQLite's `result_column ( ',' result_column )* ( K_FROM … )?`: the body's
    // last call continues into another iteration or into the rest of the rule.
    let got = parses(LOOP_BODY_TAIL_G4, "top", ["a , b k", "a , b , b k", "a , b k k", "m b k", "m b c b k", "m b k k"]);
    assert got == "a , b k => (top (s a , (x b) k))\na , b , b k => (top (s a , (x b) , (x b) k))\na , b k k => (top (s a , (x b k) k))\nm b k => (top (m m (x b) k))\nm b c b k => (top (m m (x b) c (x b) k))\nm b k k => (top (m m (x b k) k))\n";
}

global OPENED_CONT_G4: String = "
grammar T;
s : '(' fs ')' EOF ;
fs : f (',' f)* ','? ;
f : g ('::' g)* ;
g : ID a? ;
a : '<' ID (',' ID)? ','? '>' | '<' ID ',' ID ','? '>' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "a loop's skippable iteration keeps every reading of what follows the loop" {
    // Rust's `E<'a, H>` as a tuple field: `fs` offers `g` a next `f` or its
    // `)`, and `f`'s `::` loop sits between them.
    let got = parses(OPENED_CONT_G4, "s", [
        "( e < h , h > )", "( e < h , h > , u )", "( e < h , h , > )", "( e :: d < h > , )",
    ]);
    assert got == "( e < h , h > ) => (s ( (fs (f (g e (a < h , h >)))) ))\n( e < h , h > , u ) => (s ( (fs (f (g e (a < h , h >))) , (f (g u))) ))\n( e < h , h , > ) => (s ( (fs (f (g e (a < h , h , >)))) ))\n( e :: d < h > , ) => (s ( (fs (f (g e) :: (g d (a < h >))) ,) ))\n";
}

global NON_GREEDY_TAIL_G4: String = "
grammar T;
s : list 'x' ')' 'x' ')' EOF ;
list : '(' item (',' item)*? ')' ;
item : ID 'x'? ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "a non-greedy loop's tail call does not read past what follows the loop" {
    // SQLite's `'(' column_def (',' column_def)*? … ')'`: the `)` stands
    // between the last `item` and what follows `list`, which here matches
    // `x )` as deep as the gate reads.
    let got = parses(NON_GREEDY_TAIL_G4, "s", ["( a , b x ) x ) x )", "( a x , b ) x ) x )"]);
    assert got == "( a , b x ) x ) x ) => (s (list ( (item a) , (item b x) )) x ) x ))\n( a x , b ) x ) x ) => (s (list ( (item a x) , (item b) )) x ) x ))\n";
}

global NON_GREEDY_SCAN_G4: String = "
grammar N;
p : (lst | '#')* EOF ;
lst : ';'* st (';'+ st)* ';'* ;
st : '(' item (',' item)*? (',' tc)* ')' ;
item : name name? ;
name : ID | 'pk' ;
tc : 'pk' '(' ID ')' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "a scan leaves a non-greedy loop where the parse does" {
    // SQLite's `( ',' column_def )*? ( ',' table_constraint )*`: a scan that
    // takes `pk` as another `item` fails at its `(`, so `lst` declines the
    // iteration the parse would have taken.
    let got = parses(NON_GREEDY_SCAN_G4, "p", ["( a ) ; ( b , pk ( c ) ) ;", "( a , pk ( c ) ) ; ( b ) ;"]);
    assert got == "( a ) ; ( b , pk ( c ) ) ; => (p (lst (st ( (item (name a)) )) ; (st ( (item (name b)) , (tc pk ( c )) )) ;))\n( a , pk ( c ) ) ; ( b ) ; => (p (lst (st ( (item (name a)) , (tc pk ( c )) )) ; (st ( (item (name b)) )) ;))\n";
}

// SQLite's `sql_stmt_list`: an iteration's `;`s are also the list's tail.
global SPECULATIVE_LOOP_G4: String = "
grammar S;
p : (lst | '#')* EOF ;
lst : ';'* st (';'+ st)* ';'* ;
st : ID ('.' ID)* | ID '(' ID ')' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "a loop that parses its iteration speculatively rewinds the one that fails" {
    // The second input's iteration takes `; ;` before `#` fails it.
    let got = parses(SPECULATIVE_LOOP_G4, "p", ["a ; b ( c ) ;", "a . b ; ; # c ;"]);
    assert got == "a ; b ( c ) ; => (p (lst (st a) ; (st b ( c )) ;))\na . b ; ; # c ; => (p (lst (st a . b) ; ;) # (lst (st c) ;))\n";
}

test "a loop speculates only where the parse runs no action" {
    assert longest_source(SPECULATIVE_LOOP_G4).contains("let sp_pending");
    let with_predicate = SPECULATIVE_LOOP_G4.replace("st : ID (", "st : {true}? ID (");
    assert !longest_source(&with_predicate).contains("let sp_pending"), "`speculating` skips a predicate";
}

// SQLite's SELECT statements: `simple` is `factored` without its loop.
global SUBSUMED_ALT_G4: String = "
grammar T;
s : (compound | factored | simple) ';' EOF ;
compound : core ('u' core)+ order? ;
factored : core ('u' core)* order? ;
simple : core order? ;
core : 's' ID (',' ID)* ;
order : 'o' ID ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "a tournament leaves out an alternative an earlier one subsumes" {
    let got = parses(SUBSUMED_ALT_G4, "s", ["s a ;", "s a , b u s c o d ;", "s a o b ;"]);
    assert got == "s a ; => (s (factored (core s a)) ;)\ns a , b u s c o d ; => (s (compound (core s a , b) u (core s c) (order o d)) ;)\ns a o b ; => (s (factored (core s a) (order o b)) ;)\n";
    assert !gen_source(SUBSUMED_ALT_G4).contains("scan_simple("), "ANTLR4 never takes `simple`, so nothing scans it";
}

// `.*` matches empty, so it subsumes the empty alternative after it.
global SUBSUMED_EMPTY_ALT_G4: String = "
grammar T;
s : ( X | .* | ) Y EOF ;
X : 'x' ;
Y : 'y' ;
WS : ' ' -> skip ;
";

test "a group's follow set selects no alternative an earlier one subsumes" {
    let got = parses(SUBSUMED_EMPTY_ALT_G4, "s", ["y", "x y", "x x y"]);
    assert got == "y => (s y)\nx y => (s x y)\nx x y => (s x x y)\n";
}

test "a wildcard loop leaves its alternative the token it needs" {
    let grammar = SUBSUMED_EMPTY_ALT_G4.replace("( X | .* | )", ".*");
    let got = parses(&grammar, "s", ["y", "x y", "y y"]);
    assert got == "y => (s y)\nx y => (s x y)\ny y => (s y y)\n";
}

test "a loop ending a group alternative leaves what follows the group" {
    let grammar = SUBSUMED_EMPTY_ALT_G4.replace("( X | .* | ) Y", "( X* | Y ) X");
    let got = parses(&grammar, "s", ["x", "x x x", "y x"]);
    assert got == "x => (s x)\nx x x => (s x x x)\ny x => (s y x)\n";
}

global LOOP_ENTERS_WHILE_VIABLE_G4: String = "
grammar T;
s : 'fn' ty '{' '}' EOF ;
ty : 'impl' tp ('+' tp)* ;
tp : seg ('::' seg)* ;
seg : ID fnp? ;
fnp : '(' ')' '->' tp ('+' tp)* ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

// Rust's `impl Fn() -> a::R + Send`: the outer path reads `:: r` too, but the
// inner one stays viable, and ANTLR4 resolves that by looping. The loop yields
// to its caller's continuation only where the iteration would strand it.
test "a greedy loop keeps an iteration its caller's continuation also reads" {
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        let got = parses(LOOP_ENTERS_WHILE_VIABLE_G4, "s", [
            "fn impl f ( ) -> a :: r + s { }", "fn impl f ( ) -> a :: r { }", "fn impl f ( ) -> a :: r :: q + s { }",
            "fn impl a :: b + c { }",
        ], &GenerateOptions { prediction });
        assert got == "fn impl f ( ) -> a :: r + s { } => (s fn (ty impl (tp (seg f (fnp ( ) -> (tp (seg a) :: (seg r)) + (tp (seg s)))))) { })\nfn impl f ( ) -> a :: r { } => (s fn (ty impl (tp (seg f (fnp ( ) -> (tp (seg a) :: (seg r)))))) { })\nfn impl f ( ) -> a :: r :: q + s { } => (s fn (ty impl (tp (seg f (fnp ( ) -> (tp (seg a) :: (seg r) :: (seg q)) + (tp (seg s)))))) { })\nfn impl a :: b + c { } => (s fn (ty impl (tp (seg a) :: (seg b)) + (tp (seg c))) { })\n", got;
    }
}

global TAIL_TOKEN_OPTIONAL_G4: String = "
grammar T;
m : base name ';' ;
base : 'static'? 'readonly'? ;
name : ID | 'readonly' | 'static' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "a tail token optional enters while entering stays viable" {
    // TypeScript's `propertyMemberBase : ... ReadOnly?` ahead of a
    // `propertyName` that `readonly` also spells.
    let got = parses(
        TAIL_TOKEN_OPTIONAL_G4,
        "m",
        ["readonly x;", "readonly;", "static readonly;", "static readonly x;"],
    );
    assert got == "readonly x; => (m (base readonly) (name x) ;)\nreadonly; => (m base (name readonly) ;)\nstatic readonly; => (m (base static) (name readonly) ;)\nstatic readonly x; => (m (base static readonly) (name x) ;)\n";
}

global TAIL_GROUP_OPTIONAL_G4: String = "
grammar T;
s : e ';' EOF ;
e : n (('<' | '>' | '==') n)* ;
n : ID ('as' t)* ;
t : ID ('<' t '>')? ;
ID : [a-zA-Z]+ ;
WS : ' ' -> skip ;
";

// Wado's `x == y as List<i32>`: the comparison loop around `t` reads `< i` too,
// and the type arguments are still entered wherever that leaves a viable parse.
// Where both readings do, as on `c == b as L < i > d`, the jar compares.
test "a tail group optional enters while entering stays viable" {
    let inputs: List<String> = [
        "b as L < i > ;", "c == b as L < i > ;", "c == b as L < i > d ;", "c < b as L < i > > d ;",
    ];
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        let got = parses(TAIL_GROUP_OPTIONAL_G4, "s", inputs, &GenerateOptions { prediction });
        assert got == "b as L < i > ; => (s (e (n b as (t L < (t i) >))) ;)
c == b as L < i > ; => (s (e (n c) == (n b as (t L < (t i) >))) ;)
c == b as L < i > d ; => (s (e (n c) == (n b as (t L)) < (n i) > (n d)) ;)
c < b as L < i > > d ; => (s (e (n c) < (n b as (t L < (t i) >)) > (n d)) ;)
", got;
    }
}

global DEEP_TAIL_GROUP_OPTIONAL_G4: String = "
grammar T;
s : e ';' EOF | 'k' e ID ';' EOF ;
e : a ('||' a)* ;
a : c ('&&' c)* ;
c : x (('<' | '>' | '==') x)* ;
x : m ('+' m)* ;
m : n ('*' n)* ;
n : ID ('as' t)* ;
t : ID ('<' t '>')? ;
ID : [a-zA-Z]+ ;
WS : ' ' -> skip ;
";

// The same decision five loops deep, as in Wado's precedence levels: the loops'
// readings push what follows `e` past the continuation's last slot, and `t`
// enters exactly where that, read from the actual caller, resumes after the
// type arguments. Only the `k` caller resumes on an `ID`.
test "a tail group optional enters while entering stays viable under deep loops" {
    let inputs: List<String> = [
        "c == b as L < i > ;", "c == b as L < i > d ;", "c == b as L < i > || d ;", "k c == b as L < i > d ;",
    ];
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        let got = parses(DEEP_TAIL_GROUP_OPTIONAL_G4, "s", inputs, &GenerateOptions { prediction });
        assert got == "c == b as L < i > ; => (s (e (a (c (x (m (n c))) == (x (m (n b as (t L < (t i) >))))))) ;)
c == b as L < i > d ; => (s (e (a (c (x (m (n c))) == (x (m (n b as (t L)))) < (x (m (n i))) > (x (m (n d)))))) ;)
c == b as L < i > || d ; => (s (e (a (c (x (m (n c))) == (x (m (n b as (t L < (t i) >)))))) || (a (c (x (m (n d)))))) ;)
k c == b as L < i > d ; => (s k (e (a (c (x (m (n c))) == (x (m (n b as (t L < (t i) >))))))) d ;)
", got;
    }
}

global SHAPE_TAIL_GROUP_OPTIONAL_G4: String = "
grammar T;
s : '{' (st ';')* st? '}' EOF ;
st : 'let' ID ('=' e ('else' ID)?)? ;
e : n (('<' | '>' | '==') n)* ;
n : ID ('as' t)* ;
t : ID ('<' t '>')? ;
ID : [a-zA-Z]+ ;
WS : ' ' -> skip ;
";

// The loop in `s` scans `st ';'` to choose between another iteration and
// `st? '}'`, and that scan walks `st`'s optional one shape at a time. Each
// shape's `e` hears what follows it in the shape, so `t` enters the type
// arguments where the `;` or the `else` resumes after them.
test "a tail group optional inside an optional's shape scan hears the shape's continuation" {
    let inputs: List<String> = [
        "{ let a = c == b as L < i > ; }", "{ let a = c == b as L < i > else d ; }", "{ let a = c == b as L < i > d ; }",
    ];
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        let got = parses(SHAPE_TAIL_GROUP_OPTIONAL_G4, "s", inputs, &GenerateOptions { prediction });
        assert got == "{ let a = c == b as L < i > ; } => (s { (st let a = (e (n c) == (n b as (t L < (t i) >)))) ; })
{ let a = c == b as L < i > else d ; } => (s { (st let a = (e (n c) == (n b as (t L < (t i) >))) else d) ; })
{ let a = c == b as L < i > d ; } => (s { (st let a = (e (n c) == (n b as (t L)) < (n i) > (n d))) ; })
", got;
    }
}

global NESTED_OPEN_TAILS_G4: String = "
grammar T;
s : '{' (st ';')* st? '}' EOF ;
st : 'let' ID ('=' e ('else' blk)?)? ;
e : m et ;
et : ('||' m)* ;
m : u mt ;
mt : ('/' u)* ;
u : 'if' ID blk ('else' blk)? | ID ;
blk : '{' ID '}' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

// `u` hears both `mt` and `et` as readings that may start where it ends, each
// known only by its first kinds. Holding both, the `else` belongs to the `if`
// wherever one of them resumes after it.
test "nested optional tails each stay a reading of the continuation" {
    let inputs: List<String> = [
        "{ let a = if c { x } else { y } / z ; }", "{ let a = if c { x } else { y } || z ; }",
        "{ let a = if c { x } else { y } ; }", "{ let a = b else { y } ; }", "{ let a = if c { x } else { y } }",
    ];
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        let got = parses(NESTED_OPEN_TAILS_G4, "s", inputs, &GenerateOptions { prediction });
        assert got == "{ let a = if c { x } else { y } / z ; } => (s { (st let a = (e (m (u if c (blk { x }) else (blk { y })) (mt / (u z))) et)) ; })
{ let a = if c { x } else { y } || z ; } => (s { (st let a = (e (m (u if c (blk { x }) else (blk { y })) mt) (et || (m (u z) mt)))) ; })
{ let a = if c { x } else { y } ; } => (s { (st let a = (e (m (u if c (blk { x }) else (blk { y })) mt) et)) ; })
{ let a = b else { y } ; } => (s { (st let a = (e (m (u b) mt) et) else (blk { y })) ; })
{ let a = if c { x } else { y } } => (s { (st let a = (e (m (u if c (blk { x }) else (blk { y })) mt) et)) })
", got;
    }
}

global TAIL_TOKEN_UNKNOWN_CALLER_G4: String = "
grammar T;
s : f+ EOF ;
f : 'fn' ID ret? w? (blk | ';') ;
ret : '->' ty ;
w : 'where' ID ':' ty ;
ty : tnb | tp '+' tp ;
tnb : tp | '&' tnb | '(' ty ')' ;
tp : '::'? seg ('::' seg)* ;
seg : ID '::'? ('<' ty '>' | '(' ')')? ;
blk : '{' '}' ;
ID : [a-zA-Z]+ ;
WS : ' ' -> skip ;
";

// The rejection case for the test above. Rust's `typePathSegment : ...
// PATHSEP? (genericArgs | typePathFn)?`, reached through rules that pass on no
// continuation: what the caller resumes with is unknown, so it cannot overturn
// the path's own `:: segment`.
test "a tail token optional yields to a definite continuation its unknown caller cannot overturn" {
    let got = parses(TAIL_TOKEN_UNKNOWN_CALLER_G4, "s", [
        "fn f -> a::T {}", "fn f -> a::T;", "fn f -> ::a::T<X> {}", "fn f -> a:: T where T: a::b {}",
    ]);
    assert got == "fn f -> a::T {} => (s (f fn f (ret -> (ty (tnb (tp (seg a) :: (seg T))))) (blk { })))\nfn f -> a::T; => (s (f fn f (ret -> (ty (tnb (tp (seg a) :: (seg T))))) ;))\nfn f -> ::a::T<X> {} => (s (f fn f (ret -> (ty (tnb (tp :: (seg a) :: (seg T < (ty (tnb (tp (seg X)))) >))))) (blk { })))\nfn f -> a:: T where T: a::b {} => (s (f fn f (ret -> (ty (tnb (tp (seg a) :: (seg T))))) (w where T : (ty (tnb (tp (seg a) :: (seg b))))) (blk { })))\n";
}

// The two parenthesised atoms share `'(' e`, so the tournament scans the inner
// `e` once per candidate. Unless a scan of `e` is answered once per reading,
// every level doubles the work, and forty levels never finish.
test "a nested operand is scanned once per reading, not once per enclosing candidate" {
    let grammar = "grammar T;
s : e EOF ;
e : e '+' e | '(' e ')' | '(' e ',' e ')' | ID ;
ID : [a-z]+ ;
";
    let mut input = "a";
    let mut tree = "(e a)";
    for let _ of 0..<40 {
        input = `(${input})`;
        tree = `(e ( ${tree} ))`;
    }
    let got = parses(grammar, "s", [input]);
    assert got == `${input} => (s ${tree})\n`;
}

global LR_ATOM_OPERAND_G4: String = "
grammar T;
s : e ';' ;
e : 'new' e '<'? args
  | 'new' e
  | e args
  | e '.' ID
  | ID
  ;
args : '(' ')' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "an operand inside an atom climbs only while its own continuation stays viable" {
    // TypeScript's `New singleExpression typeArguments? arguments`: the
    // operand's call suffix would take the arguments the `new` still owes.
    let got = parses(LR_ATOM_OPERAND_G4, "s", ["new a();", "new a;", "new a.b();", "new a()();"]);
    assert got == "new a(); => (s (e new (e a) (args ( ))) ;)\nnew a; => (s (e new (e a)) ;)\nnew a.b(); => (s (e new (e (e a) . b) (args ( ))) ;)\nnew a()(); => (s (e new (e (e a) (args ( ))) (args ( ))) ;)\n";
}

// The prefix atom's trailing operand is the atom's own, not a suffix's, and it
// owes `new` its arguments just the same. `'-' e '!'` puts the prefix atom in an
// overlap group, so the operand sits in a per-alternative helper.
test "a prefix atom's operand inside an atom leaves the arguments its enclosing atom owes" {
    let grammar = "grammar T;
s : e ';' ;
e : e args | 'new' e args | '-' e | '-' e '!' | ID ;
args : '(' ')' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";
    let got = parses(grammar, "s", ["new -a();", "-a();"]);
    assert got == "new -a(); => (s (e new (e - (e a)) (args ( ))) ;)\n-a(); => (s (e - (e (e a) (args ( )))) ;)\n";
}

global CONTINUATION_BEHIND_PREFIX_G4: String = "
grammar T;
s : d ';' ;
d : ID '=' e ('!' ID)? ;
e : e '(' ')' | e '.' ID | a | ID ;
a : '[' l ']' ;
l : ','* el? (','+ el)* ','* ;
el : e ','? ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "a continuation behind a prefix admits only what the prefix starts with" {
    // TypeScript's `arrayElement : ... ','?` in an initializer an optional
    // follows: the list's `]` comes first, so the `,` before `c` is the next
    // element's, not a trailing one.
    let got = parses(CONTINUATION_BEHIND_PREFIX_G4, "s", ["x = [b, c];", "x = [b,, c,];", "x = [b] ! y;"]);
    assert got == "x = [b, c]; => (s (d x = (e (a [ (l (el (e b)) , (el (e c))) ]))) ;)\nx = [b,, c,]; => (s (d x = (e (a [ (l (el (e b) ,) , (el (e c) ,)) ]))) ;)\nx = [b] ! y; => (s (d x = (e (a [ (l (el (e b))) ])) ! y) ;)\n";
}

global WILDCARD_SHAPE_G4: String = "
grammar T;
s : x (A C)* EOF ;
x : Y (. B? C)? ;
Y : 'y' ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
WS : ' ' -> skip ;
";

test "an optional group opening with a wildcard before a nested optional generates" {
    // The wildcard admits every kind, so no shape signature can test it.
    let got = parses(WILDCARD_SHAPE_G4, "s", ["y a c", "y a b c", "y a c a c"], &LONGEST);
    assert got == "y a c => (s (x y a c))\ny a b c => (s (x y a b c))\ny a c a c => (s (x y a c) a c)\n";
}

test "a rule entry claims its call site's return state before returning early" {
    // Claimed after, a recovering entry would leave the stamp to the next
    // call from a site that stamps none.
    let output = gen_source(AT_END_CONFLICT_G4);
    let body = extract_fn_body(&output, "fn _parse_x(");
    assert body.find("p.atn_ret_pending = -1;").unwrap() < body.find("if p.recovering").unwrap();
}

test "non-LR ATN grammar carries prediction without the LR tables" {
    let output = gen_source(AT_END_CONFLICT_G4);
    assert output.contains("global ATN_SIM: AtnSim = atn_decode(&b\"");
    assert !output.contains("atn_with_lr_tables");
    assert output.contains("internal fn atn_predict_with_stack(");
    assert !output.contains("fn atn_lr_loop_decision(");
}

global LATN_ONLY_G4: String = "
grammar T;
s : ID* EOF ;
ID : [a-z]+ ;
COMMENT : '/*' (COMMENT | .)*? '*/' -> skip ;
WS : ' ' -> skip ;
";

test "a lexer-ATN-only grammar carries the decoder and no parser simulator" {
    let output = gen_source(LATN_ONLY_G4);
    assert output.contains("internal fn latn_match(");
    assert output.contains("internal fn atn_decode(");
    assert !output.contains("fn atn_predict_with_stack(");
    assert !output.contains("struct CtxArena");
    assert !output.contains("fn atn_lr_loop_decision(");
}

test "runtime standard-library imports sit at the top of the file" {
    let output = gen_source(LATN_ONLY_G4);
    let std_use = output.find("use { HashMap, HashSet, HashSeed } from \"core:collections\";").unwrap();
    assert std_use < output.find("pub struct Span").unwrap();
}

global LR_WILDCARD_CODEGEN_G4: String = "
grammar T;
prog : e EOF ;
e : e '+' e | e . | INT ;
INT : [0-9]+ ;
WS : ' ' -> skip ;
";

test "ATN-class LR grammar keeps the decoder's LR tables" {
    let output = gen_source(LR_WILDCARD_CODEGEN_G4);
    assert output.contains("global ATN_SIM: AtnSim = atn_with_lr_tables(atn_decode(&b\"");
    assert output.contains("internal fn atn_lr_loop_decision(");
}

// TypeScript's `typeParameter` shape: every first token of `id` leads to the same
// depth-1 sub-dispatch, so the branches fold into one over their union.
global SHARED_SUBDISPATCH_G4: String = "
grammar T;
tp : id c? | id '=' t | '<' tp '>' ;
id : A | B | C ;
c : 'extends' t ;
t : A ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
WS : [ \\t\\r\\n]+ -> skip ;
";

// `C?` is nullable, so the follow reaches past the rule into the caller's FOLLOW.
// The local `C` is only a prefix of the answer.
global INEXACT_FOLLOW_EMPTY_ALT_G4: String = "
grammar T;
s : r SEMI EOF ;
r : ( A | | B ) C? ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
SEMI : ';' ;
";

// `A` and `A B` overlap, so the rule takes the overlap dispatch rather than
// the token-led one — a second rule-level emitter, with its own arms.
global RULE_OVERLAP_EMPTY_ALT_G4: String = "
grammar T;
x : | A | A B ;
A : 'a' ;
B : 'b' ;
";

// The `.` sits behind a nullable prefix, so the alternative has a first set
// (`{A}`) and is still open-ended: `c` reaches the wildcard.
global PREFIXED_WILDCARD_ALT_G4: String = "
grammar T;
s : ( A? . | B ) EOF ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
";

// The epsilon alternative reached through a rule must earn the same follow-set
// branch a written-empty one does.
global INDIRECT_EPSILON_ADMITS_G4: String = "
grammar T;
s : 'k' ( A | x | B ) EOF ;
x : ;
A : 'a' ;
B : 'b' ;
";

// `x` derives only epsilon, but through a rule reference — the mirror of an
// open-ended alternative reached the same way.
global INDIRECT_EPSILON_ALT_G4: String = "
grammar T;
s : ( x | A ) B EOF ;
x : ;
A : 'a' ;
B : 'b' ;
";

// `w` is open-ended, but through a rule reference: its first set is empty for
// the same reason a surface `.`'s is, and it is not the empty alternative.
global INDIRECT_WILDCARD_ALT_G4: String = "
grammar T;
s : w EOF # Wild
  | A EOF # Named
  ;
w : . ;
A : 'a' ;
";

// ANTLR4 takes the lowest viable alternative, so `. EOF` wins over `A EOF` on `a`.
// Unlike an empty alternative, a wildcard-led one must not be reordered.
global WILDCARD_FIRST_ALT_G4: String = "
grammar T;
s : . EOF # Wild
  | A EOF # Named
  ;
A : 'a' ;
";

// A rule's own alternatives are a decision too, and an empty one among them is
// selected by no lookahead.
global RULE_LEVEL_EMPTY_ALT_G4: String = "
grammar T;
x : A | | B ;
A : 'a' ;
B : 'b' ;
";

// An LR suffix's group body is walked by the op-only walker, which reads the
// dispatch lower baked rather than the surface alternatives.
global OP_WALKER_EMPTY_ALT_G4: String = "
grammar T;
e : e ( A x | | B x ) | C ;
x : C ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
";

test "an empty alternative keeps its fallback where the follow set is a prefix" {
    // A follow set the caller's FOLLOW still extends names only part of what selects
    // the empty alternative; as the whole set it rejects `;`, a legal parse.
    let got = parses(INEXACT_FOLLOW_EMPTY_ALT_G4, "s", [";", "c;", "a;", "bc;"]);
    assert got == "; => (s r ;)\nc; => (s (r c) ;)\na; => (s (r a) ;)\nbc; => (s (r b c) ;)\n";
}

test "the overlap rule dispatch orders its fallback last too" {
    // The follow set is exact, so the empty alternative is also tested by name;
    // its unconditional arm is still the last.
    let got = parses(RULE_OVERLAP_EMPTY_ALT_G4, "x", ["", "a", "ab"]);
    assert got == " => x\na => (x a)\nab => (x a b)\n";
}

test "a wildcard behind a nullable prefix still makes its alternative open-ended" {
    // Having a first set does not settle it: `A? .` is selected by `a` and also
    // by every other token, so partitioning by `{A}` leaves `c` no alternative.
    let got = parses(PREFIXED_WILDCARD_ALT_G4, "s", ["c", "ac", "a", "b"]);
    assert got == "c => (s c)\nac => (s a c)\na => (s a)\nb => (s b)\n";
}

test "an epsilon alternative earns its follow set however it is spelled" {
    // Which alternative earns the follow set is nullability's answer, not an
    // element count: `( A | x | B )` gets the branch `( A | | B )` gets.
    let got = parses(INDIRECT_EPSILON_ADMITS_G4, "s", ["k", "ka", "kb", "kc"]);
    assert got == "k => (s k x)
ka => (s k a)
kb => (s k b)
kc => error
";
}

test "an alternative that derives only epsilon through a rule is selected by its follow" {
    // `x` matches nothing, so what follows selects it, as for a written-empty one.
    // ANTLR4 parses `b` as `(s x b)` and `a b` as `(s a b)`.
    let got = parses(INDIRECT_EPSILON_ALT_G4, "s", ["b", "ab"]);
    assert got == "b => (s x b)\nab => (s a b)\n";
}


// The root's alternative, which the tree alone does not show when every
// alternative builds the same one.
global ROOT_ALT: String = "let r = parse_s(\"a\");
println(`${to_string_tree(&r)} ${r.cst.s_alt(0):?}`);
";

test "an alternative open-ended through a rule keeps its index too" {
    // An empty first set does not say which element produced it: reading the
    // elements catches a `.` written in place but not one reached through `w`.
    let got = printed(INDIRECT_WILDCARD_ALT_G4, ROOT_ALT);
    assert got == "(s (w a)) Option::Some(SAlt::Wild)\n";
}

test "a wildcard alternative keeps its index against a narrower one" {
    // It admits everything, `a` included, so it competes wherever the narrower
    // alternative does and the tie is its — lowest viable alternative wins.
    let got = printed(WILDCARD_FIRST_ALT_G4, ROOT_ALT);
    assert got == "(s a) Option::Some(SAlt::Wild)\n";
}

// `A? .` admits every token yet still has the first set `{A}`, which the unions
// built over the group's classes need.
global OPEN_ENDED_WITH_FIRST_G4: String = "
grammar T;
s : r EOF ;
r : ( A? . | B )+ ;
A : 'a' ;
B : 'b' ;
";

test "an open-ended alternative still contributes the first set it does have" {
    // The `no viable alternative` expected list and its SYNC set are unions over
    // the group's classes, so both must include an open-ended alternative's tokens.
    let output = longest_source(OPEN_ENDED_WITH_FIRST_G4);
    let both = ": List<i32> = [TK_A, TK_B];";
    assert output.contains(both);
}

test "a rule's empty alternative does not shadow the ones after it" {
    // A rule's arms are guarded `if`s that return, so an unconditional one shadows
    // the rest unless it comes after every arm a lookahead can select.
    let got = parses(RULE_LEVEL_EMPTY_ALT_G4, "x", ["a", "b", ""]);
    assert got == "a => (x a)\nb => (x b)\n => x\n";
}

test "the op walker's undecided chain keeps every alternative reachable" {
    // The op walker reads lower's baked branches, where an alternative no
    // lookahead selects has an empty token set, which would become `true` again.
    let got = parses(OP_WALKER_EMPTY_ALT_G4, "e", ["c", "cac", "cbc"]);
    assert got == "c => (e c)\ncac => (e (e c) a (x c))\ncbc => (e (e c) b (x c))\n";
}

test "dispatch branches sharing a sub-dispatch are emitted once" {
    let output = gen_source(SHARED_SUBDISPATCH_G4);
    let body = extract_fn_body(&output, "fn _parse_tp__inner(");
    let copies = count_occurrences(&body, "p.peek_at(1)");
    assert copies > 0, "expected a depth-1 sub-dispatch in tp";
    assert copies <= 2;
    assert !body.contains("if p.peek_kind() == TK_A"), "A got its own branch";
}

// Alts 0 and 1 share `A` and `B`, which the token after them tells apart. `s`
// scans `e` to choose between its group's alternatives, so `scan_e` is emitted.
global REPEATED_SCAN_ALT_G4: String = "
grammar T;
s : (e X | e Y) EOF ;
X : 'x' ;
Y : 'y' ;
e : f '(' ')' | n | K ;
f : A | B ;
n : A | B | C ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
K : 'k' ;
WS : [ \\t\\r\\n]+ -> skip ;
";

test "a scan decides by the parse's lookahead, not by scanning every candidate" {
    let output = longest_source(REPEATED_SCAN_ALT_G4);
    let scan_e = extract_fn_body(&output, "fn scan_e(");
    assert scan_e.contains("if la_1 == TK_LIT_LPAREN {");
    assert scan_e.contains("return scan_e__alt_0(tokens, start");
    assert scan_e.contains("return scan_e__alt_1(tokens, start");
}

test "a gate the scan cannot evaluate does not put its untested arm first" {
    // The gate is false at `r`, so the parse falls through to `A`; an ungated
    // empty arm in the scan would end every scan of `r` before `A` is tried.
    let got = parses("grammar G;
options { language = Wado; }
s : r A B EOF | r A C EOF ;
r : { p.pos > 0 }? | A ;
A : 'a' ; B : 'b' ; C : 'c' ;
", "s", ["aab", "aac", "ab"]);
    assert got == "aab => (s (r a) a b)\naac => (s (r a) a c)\nab => error\n";
}

test "an uncontested alternative is scanned in place" {
    let output = longest_source(REPEATED_SCAN_ALT_G4);
    assert !output.contains("fn scan_e__alt_2(");
}

// `RustParser.g4`'s `crate : innerAttribute* item* EOF`: the reserve walks the
// whole rest of the file, so it runs only where the loop cannot go on.
global RESERVE_AFTER_LOOP_G4: String = "
grammar T;
r : inner* outer* EOF ;
inner : '#' '!' ID ;
outer : '#' ID | ID ;
ID : [a-z]+ ;
";

test "the reserve walk runs only after the loop's own lookahead declines" {
    let output = longest_source(RESERVE_AFTER_LOOP_G4);
    let body = extract_fn_body(&output, "fn _parse_r__inner(");
    assert_in_order(
        &body,
        "let rep_body_end_kind =",
        "rep_body_end_scan:",
        "the reserve walks before the lookahead can skip it",
    );
}

// `e : a=e op=('+'|'-') b=e`: a labelled element's inner used a fresh
// `name_counts`, so two labels shared one binding and redeclared it.
test "label binding on repeated rule ref dedups against outer scope" {
    // A grammar with no action emits no label binding, and a binding declared
    // twice in one function does not compile.
    let got = parses("grammar T;
options { language = Wado; }
e : a=e op=('*'|'/') b=e { }
  | INT
  | '(' x=e ')' { p.emit($x.text) }
  ;
INT : '0'..'9'+ ;
WS : (' '|'\\n') -> skip ;
", "e", ["(1)", "1*2", "(1)/2"]);
    assert got == "(1) => (e ( (e 1) )) [1]
1*2 => (e (e 1) * (e 2))
(1)/2 => (e (e ( (e 1) )) / (e 2)) [1]
";
}

test "an element whose name is the recognizer handle does not shadow it" {
    // `P` snake_cases to `p`, the parser handle. Bound verbatim, it shadowed the
    // handle and the next `p.` call no longer compiled.
    let g4 = "grammar T;
options { language = Wado; }
r : P { p.emit($P.text) } ;
P : 'p' ;
WS : ' ' -> skip ;
";
    let got = parses(g4, "r", ["p"]);
    assert got == "p => (r p) [p]\n";
}

test "an element named after any generated parse-fn local does not shadow it" {
    // Every parse-fn parameter and body local is reserved, not just the handle.
    // `KIND` collides with the dispatch's lookahead local in the same function.
    let g4 = "grammar T;
options { language = Wado; }
r : KIND VALS { p.emit($KIND.text); p.emit($VALS.text) } | VALS ;
KIND : 'k' ;
VALS : 'v' ;
WS : ' ' -> skip ;
";
    let got = parses(g4, "r", ["k v", "v"]);
    assert got == "k v => (r k v) [kv]\nv => (r v)\n";
}

// "a prebound LR suffix scan is neither re-tested nor re-seeded" pins the guard's
// absence where every suffix consumes.
test "an LR loop never takes an iteration that consumes nothing" {
    // ANTLR rejects both grammars (error 148); `antlr4-compatibility.md` gives the
    // meaning Gale takes. `x` yields a `*` the caller takes, and `+` is reached
    // through an empty `x` as well as directly. The second grammar routes the
    // loop to the ATN.
    let rest = "x : '*'? ;
INT : '0'..'9'+ ;
WS : (' '|'\\n') -> skip ;
";
    let static_lr = `grammar T;
s : e '*' EOF | e '!' EOF ;
e : e x | '(' e ')' | INT ;
${rest}`;
    let got = parses(static_lr, "s", ["1*", "1**", "1*!"]);
    assert got == "1* => (s (e 1) *)
1** => (s (e (e 1) (x *)) *)
1*! => (s (e (e 1) (x *)) !)
";
    let atn_lr = `grammar T;
s : e '*' EOF | e '!' EOF ;
e : e x | e '+' e '+' | e '+' e | '(' e ')' | INT ;
${rest}`;
    let atn_got = parses(atn_lr, "s", ["1*", "1+2!", "1+2+*", "1+2**"]);
    assert atn_got == "1* => (s (e 1) *)
1+2! => (s (e (e 1) + (e 2)) !)
1+2+* => (s (e (e 1) + (e 2) +) *)
1+2** => (s (e (e 1) + (e (e 2) (x *))) *)
";
    // The first token admits `(A B)?`, which then matches nothing: recovery skips
    // the `a` rather than wrapping an empty `e`.
    let stranded = printed("grammar T;
s : e EOF ;
e : e (A B)? | e '+' e '+' | e '+' e | INT ;
A : 'a' ; B : 'b' ;
INT : '0'..'9'+ ;
WS : ' ' -> skip ;
", "println(to_string_tree(&parse_s(\"1 a\")));");
    assert stranded == "(s (e 1) <skip a>)\n";
}

// An action or predicate nested inside a group must never vanish: it either
// runs — a group's alternatives decide like a rule's — or it is reported.

test "an empty-alt predicate gates the empty alternative" {
    // The predicate keeps the group from folding to an Optional, which would have
    // nowhere to put it.
    let src = "grammar T;
options { language = Wado; }
r : ( {false}? | A ) A ;
A : 'a' ;
";
    assert unsupported_count(&gen(src)) == 0, "a gated empty alternative must not warn";
    let got = parses(src, "r", ["aa", "a"]);
    assert got == "aa => (r a a)\na => error\n";
}

test "a plain action on an empty alternative does not cost it its follow set" {
    // Only a gateable alt-initial predicate takes the decision away from the
    // lookahead; a plain action does not.
    let src = "grammar T;
options { language = Wado; }
s : 'k' ( A | { p.emit(\"x\") } | B ) EOF ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
";
    assert unsupported_count(&gen(src)) == 0, "a plain action on an empty alternative must not warn";
    let got = parses(src, "s", ["k", "ka", "kb", "kc"]);
    assert got == "k => (s k) [x]
ka => (s k a)
kb => (s k b)
kc => error [x]
";
}

// A predicate in a host language Gale does not emit renders nothing, so it must not
// gate: `alt_has_gate` answers "reaches its arm", not "exists in the IR".
test "a predicate in an unemitted host language gates nothing" {
    let gated = "grammar T;
options { language = Cpp; }
s : 'k' ( A | {p()}? | B ) EOF ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
";
    let got = parses(gated, "s", ["k", "ka", "kc"]);
    assert got == "k => (s k)\nka => (s k a)\nkc => error\n";
}

// The rejection case: the same shape in a language Gale does emit is selected
// by the predicate, so the test above is not passing because nothing ever gates.
test "the same predicate in an emitted language does gate" {
    let gated = "grammar T;
options { language = Wado; }
s : 'k' ( A | {false}? | B ) EOF ;
A : 'a' ;
B : 'b' ;
";
    let got = parses(gated, "s", ["k", "ka"]);
    assert got == "k => error\nka => (s k a)\n";
}

// Parser-side `superClass` (Stage C): a `{this.m()}?` predicate in a parser
// rule lowers to an ambient operation on the parser base's effect interface.

test "the parse entries carry the parser base effect" {
    // `driver_action_prs_super_test` parses with a handler installed.
    let src = gen_source("grammar C;
options { superClass = PBase; language = Wado; }
shr : GT { this.next_gt() }? GT ;
GT : '>' ;
");
    let Err(CompileFailed(failure)) = eval(`${src}
export fn run() {
    parse(">>");
}
`) else {
        panic("a caller that installs no handler must fail to compile");
    };
    assert failure.rendered.contains("missing effect 'PBase' required by 'parse'");
}

test "the parser action-context API is public under a parser base" {
    let src = gen_source("grammar C;
options { superClass = PBase; language = Wado; }
shr : GT { this.next_gt() }? GT ;
GT : '>' ;
");
    assert src.contains("pub fn la(&self, k: i32) -> i32"), "the base reads lookahead through the recognizer";
    assert src.contains("pub fn token_start(&self, i: i32) -> i32"), "and token positions";
}

// Eight levels of `e` push past the continuation's slots, so the `X?` after `y`
// reads its caller's through the link table, after the predicate ran a parse
// of its own.
test "a parse a predicate runs leaves the continuation of the parse it runs inside" {
    let grammar = "grammar N;
options { superClass = NBase; language = Wado; }
s : e EOF ;
e : A e X? | { this.nest() }? Y ;
t : X ;
A : 'a' ; X : 'x' ; Y : 'y' ; WS : ' ' -> skip ;
";
    let items = `${SHOW_FN}
struct Nesting {}

impl NBase for Nesting {
    fn nest(&self, p: &Parser) -> bool {
        let mut inner = Nesting {};
        with NBase => &mut inner do {
            let _ = parse_t(\"x\");
        }
        resume true;
    }
}
`;
    let body = "let mut base = Nesting {};
with NBase => &mut base do {
    show(\"a a a a a a a a y x x\", parse_s(\"a a a a a a a a y x x\"));
}
";
    let got = run_beside(gen_with(grammar, &LONGEST).source, body, items).stdout;
    assert got == "a a a a a a a a y x x => (s (e a (e a (e a (e a (e a (e a (e a (e a (e y) x) x))))))))\n";
}

test "a parser base call whose argument has no evident type is refused" {
    let src = "grammar C;
options { superClass = PBase; language = Wado; }
r : A { this.p(x + 1) }? A ;
A : 'a' ;
";
    let generated = gen(src);
    assert unsupported_count(&generated) == 1, "the refusal is reported once";
    let out = generated.source;
    assert !out.contains("pub interface PBase"), "and nothing reaching the base is emitted";
    // The recognizer surface turns public only for a base that is wired, so it
    // and the interface emit cannot drift apart.
    assert !out.contains("pub struct Parser");
    assert !out.contains("pub fn la(");
    // The rewrite never ran, so the body still names `this`.
    assert !out.contains("this.");
}

test "a parser base reached from an action body is refused" {
    // The parser side carries no command surface, so a unit-returning
    // operation would have nothing to drive.
    let src = "grammar C;
options { superClass = PBase; language = Wado; }
r : A { this.mark() } A ;
A : 'a' ;
";
    let generated = gen(src);
    assert unsupported_count(&generated) == 1, "the refusal is reported once";
    let out = generated.source;
    assert !out.contains("pub interface PBase"), "and nothing reaching the base is emitted";
    assert !out.contains("this.");
}

test "an alt-initial predicate on a refused base is not extracted either" {
    // The gate path has its own passthrough (`pred_<id>`), so it needs the
    // same guard as the inline one.
    let src = "grammar C;
options { superClass = PBase; language = Wado; }
r : { this.p(x + 1) }? A | B ;
A : 'a' ;
B : 'b' ;
";
    // The refusal, then the un-gated predicate the alt dispatch is left with.
    let out = gen(src);
    assert unsupported_count(&out) == 2, "both the refusal and the dropped gate are reported";
    assert !out.source.contains("this.");
}

test "a grammar with no parser base is unaffected" {
    let plain = gen_source("grammar C;
r : A ;
A : 'a' ;
");
    assert !plain.contains("interface"), "no interface";
    assert !plain.contains("with PBase"), "no effect clause";
    assert !plain.contains("pub fn la("), "the action-context API stays private";
}

test "an untranslatable body is dropped on its own, and the base still wires" {
    // warn-and-emit (`action.md`), as ANTLR4 leaves a bad body to the host compiler:
    // the untranslatable body is dropped and the other body's base still wires.
    let src = "grammar C;
options { superClass = PBase; }
@parser::members {
    int n = 0;
}
r : A { this.ok() }? A ;
s : A { System.out.print(n++); } ;
A : 'a' ;
";
    let out = gen(src);
    assert unsupported_count(&out) == 1, "the refusal is reported once";
    assert out.source.contains("pub interface PBase"), "and the base the other body calls still wires";
}

test "the metadata comment names each recognizer's base" {
    let lexer_g = parse("lexer grammar SLexer;
options { superClass = LBase; language = Wado; }
GT : { this.ok() }? '>' ;
").unwrap();
    let parser_g = parse("parser grammar SParser;
options { superClass = PBase; language = Wado; }
shr : GT { this.next_gt() }? GT ;
").unwrap();
    let mut merged = merge_grammars([lexer_g, parser_g]);
    let src = generate(&mut merged, &DEFAULT_OPTIONS).source;
    assert src.contains("//   option superClass = LBase (lexer)");
    assert src.contains("//   option superClass = PBase (parser)");
}

test "a this-call with no parser base declared is reported, not emitted" {
    // Nothing else reports it: there is no base to refuse.
    let src = "grammar C;
options { language = Wado; }
r : A { this.p() }? A ;
A : 'a' ;
";
    let out = gen(src);
    assert unsupported_count(&out) == 1, "the stray receiver is reported";
    assert !out.source.contains("this.");
}

test "a lexer this-call in a combined grammar is reported, not emitted" {
    // A combined grammar's `superClass` is the parser's, so a lexer body naming
    // `this` has no receiver at all.
    let src = "grammar C;
options { superClass = B; language = Wado; }
r : X ;
X : { this.ok() }? [a-z]+ ;
";
    let out = gen(src);
    assert unsupported_count(&out) == 1, "the stray lexer receiver is reported";
    assert !out.source.contains("this.");
}

test "a parser superClass does not carve out java members" {
    // The carve-out is the lexer's, whose base owns the action surface; a parser base
    // is predicate-only, so `@parser::members` translates as with no base.
    let src = gen_source("grammar C;
options { superClass = PBase; }
@parser::members {
    int calls = 0;
}
shr : GT { this.NextGT() }? GT ;
GT : '>' ;
");
    assert src.contains("PBase::next_gt(p)"), "the base predicate still runs";
    assert src.contains("calls: i32 = 0");
}

test "fragment recovery reaches the base through expect" {
    // `expect` calls `_recover_try_descend`, which descends into rule entries,
    // so it must declare the effect those entries carry or nothing compiles.
    let src = gen_with("grammar C;
options { superClass = PsBase; language = Wado; }
prog : shr ;
shr : GT { this.next_gt() }? GT ;
GT : '>' ;
", &GenerateOptions {
        fragment_entries: ["shr"],
    }).source;
    let got = run_beside(src, "let mut base = Always {};
with PsBase => &mut base do {
    println(to_string_tree(&parse(\">>\")));
    println(`${parse(\">\").ok()}`);
};
", "struct Always {}
impl PsBase for Always {
    fn next_gt(&self, p: &Parser) -> bool {
        resume true;
    }
}
").stdout;
    assert got == "(prog (shr > >))\nfalse\n";
}

test "a this field read with no parser base is reported, not emitted" {
    let src = "grammar C;
options { language = Wado; }
r : A { this.flag }? A ;
A : 'a' ;
";
    let out = gen(src);
    assert unsupported_count(&out) == 1, "a receiver-less `this` is reported whatever follows it";
    assert !out.source.contains("this");
}

// A lexer action runs at the tournament commit for the winning rule only, through
// its `apply_<rule>_actions` replay; what cannot run is reported.

test "a modeless action grammar emits no mode-op API (gated)" {
    let src = gen_source("lexer grammar L;
options { language = Wado; }
A : 'a' { lx.set_type(TK_B) } ;
B : 'b' ;
");
    assert !src.contains("act_push_mode"), "no mode fields without modes";
    assert !src.contains("MODE_"), "no mode constants without modes";
}

test "an actionless grammar keeps no action machinery (byte-identical guard)" {
    let src = gen_source("lexer grammar L;
A : 'a' ;
WS : ' ' -> skip ;
");
    assert !src.contains("reset_actions"), "no action-effect surface without actions";
    assert !src.contains("best_act"), "no best_act without actions";
    assert !src.contains("apply_"), "no apply fn without actions";
}

test "a predicate-only grammar keeps no action-replay machinery" {
    let src = gen_source("lexer grammar L;
options { language = Wado; }
KW : [a-z]+ { $text == \"cat\" }? ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
");
    assert !src.contains("reset_actions"), "predicates need no action-effect surface";
    assert !src.contains("best_act"), "predicates need no best_act";
}

test "gated predicates with one body share one predicate fn" {
    let grammar = "grammar T;
options { language = Wado; }
s : x EOF | y EOF ;
x : {false}? A | {true}? A B ;
y : { false }? B | B A ;
A : 'a' ;
B : 'b' ;
WS : ' ' -> skip ;
";
    let output = gen_source(grammar);
    assert count_occurrences(&output, "fn pred_") == 2;
    assert parses(grammar, "s", ["a b", "b a"]) == "a b => (s (x a b))\nb a => (s (y b a))\n";
}

test "a predicate fn keeps the line break that ends its body's comment" {
    let grammar = "grammar T;
options { language = Wado; }
s : x EOF ;
x : {true // always
}? A | B ;
A : 'a' ;
B : 'b' ;
";
    let pred = extract_fn_body(&gen_source(grammar), "fn pred_");
    assert !pred.contains("// always;");
    assert parses(grammar, "s", ["a"]) == "a => (s (x a))\n";
}

test "an action or predicate the emitter runs is not also reported as unhandled" {
    // A driver shows each of these running. The report is only a warning, so a
    // body that runs and is reported anyway fails no driver.
    let grammars: List<String> = [
        "grammar T;
options { language = Wado; }
r : ( {false}? A | B ) ;
A : 'a' ;
B : 'b' ;
", "grammar T;
options { language = Wado; }
r : ( {false}? A B )+ A ;
A : 'a' ;
B : 'b' ;
", "grammar C;
options { superClass = PBase; }
shr : GT { this.NextGT() }? GT ;
GT : '>' ;
", "grammar C;
options { superClass = PBase; language = Wado; }
r : A { this.p(\"of\") }? A ;
A : 'a' ;
", "lexer grammar L;
options { language = Wado; }
A : 'a' { lx.set_type(TK_B) } ;
B : 'b' ;
WS : ' ' -> skip ;
", "lexer grammar L;
options { language = Wado; }
A : ('a' { lx.set_type(TK_B) } | 'c') ;
B : 'b' ;
WS : ' ' -> skip ;
", "lexer grammar L;
options { language = Wado; }
A : ('a' { lx.set_type(TK_B) })+ ;
B : 'b' ;
WS : ' ' -> skip ;
", "lexer grammar L;
options { language = Wado; }
A : F 'z' ;
fragment F : 'a' { lx.set_type(TK_B) } ;
B : 'b' ;
WS : ' ' -> skip ;
", "lexer grammar L;
options { language = Wado; }
A : 'a' (~'b' { lx.set_type(TK_B) })+ 'c' ;
B : 'b' ;
WS : ' ' -> skip ;
", "lexer grammar L;
options { language = Wado; }
A : 'a' .*? { pos > start + 2 }? 'c' { lx.set_type(TK_B) } ;
B : 'b' ;
", "lexer grammar L;
options { language = Wado; }
A : 'a' (~'b' { lx.set_type(TK_B) })*? 'c' ;
B : 'b' ;
WS : ' ' -> skip ;
", "lexer grammar L;
options { language = Wado; }
A : 'a' ~('b')+ { lx.set_type(TK_B) } 'c' ;
B : 'b' ;
WS : ' ' -> skip ;
", "lexer grammar L;
options { language = Wado; }
A : 'a' { lx.set_type(TK_X) } | 'c' { lx.set_type(TK_Y) } ;
B : 'b' ;
WS : ' ' -> skip ;
", "lexer grammar L;
options { language = Wado; }
A : 'a' { if $mode == 0 { $mode = MODE_TAIL } } ;
mode TAIL;
B : 'b' ;
",
    ];
    for let g4 of grammars {
        assert unsupported_count(&gen(g4)) == 0;
    }
}

test "a Wado lexer body naming `this` is still reported, members or not" {
    // The identity translator analyses no host text, so `this` has nothing to
    // receive it whatever the grammar declares. Only java2wado resolves one.
    let src = "lexer grammar L;
options { language = Wado; }
@members { count: i32 = 0 }
A : 'a' { this.count += 1 } ;
WS : ' ' -> skip ;
";
    let out = gen(src);
    assert unsupported_count(&out) > 0, "a Wado body naming `this` must be reported";
    assert !out.source.contains("this.count"), "the untranslatable body must not be emitted";
}

test "a lexer predicate calling a writing member method is refused" {
    // The tournament evaluates every candidate's predicate, losers included, under
    // `&Lexer`, so neither spelling of a `&mut self` call can be emitted.
    let qualified = "lexer grammar L;
@members {
    int depth = 0;
    boolean bump() { this.depth = this.depth + 1; return true; }
}
A : 'a' { this.bump() }? ;
WS : ' ' -> skip ;
";
    let qualified_out = gen(qualified);
    assert unsupported_count(&qualified_out) == 1, "a mutating `this.m()` from a lexer predicate must be reported";
    assert !qualified_out.source.contains("lx.bump()"), "the refused call must not be emitted";

    let bare = "lexer grammar L;
@members {
    int depth = 0;
    boolean bump() { this.depth = this.depth + 1; return true; }
}
A : 'a' { bump() }? ;
WS : ' ' -> skip ;
";
    let bare_out = gen(bare);
    assert unsupported_count(&bare_out) == 1, "a mutating bare `m()` from a lexer predicate must be reported";
    assert !bare_out.source.contains("lx.bump()"), "the refused call must not be emitted";
}

test "a superClass grammar's `this` is not excused by its @lexer::members" {
    // A `superClass` grammar's bodies go through the identity translator, which
    // resolves no `this`; with the base refused too, every `this.` is reported.
    let src = "lexer grammar L;
options { superClass = B; }
@members { int n = 0; }
A : { this.m() }? 'a' { this.m() } ;
WS : ' ' -> skip ;
";
    let generated = gen(src);
    assert unsupported_count(&generated) > 0, "an unwired `this` must be reported, members or not";
    let out = generated.source;
    assert !out.contains("this.m()"), "the untranslatable body must not be emitted verbatim";
    assert !out.contains("fn apply_A_actions"), "and the rule must not run actions at all";
}

test "a camelCase Java member field reads the same by either spelling" {
    // The declaration is snake_cased like a method name, so `this.nestLevel` and
    // the bare `nestLevel` resolve to the one field the struct carries.
    let src = "lexer grammar L;
@members { int nestLevel = 0; }
A : 'a' { nestLevel = this.nestLevel + 1; System.out.println(nestLevel); } ;
WS : ' ' -> skip ;
";
    assert unsupported_count(&gen(src)) == 0, "both spellings must resolve";
    assert lexes(src, ["a a"]) == "a a => A:a A:a [1\n2\n]\n";
}

test "an undeclared Java lexer field is reported by either spelling" {
    // `lx.<name>` for a name `@members` never declared names no field on the `Lexer`,
    // so `this.<x>` is refused exactly as the bare `x` is.
    let qualified = "lexer grammar L;
@members { int depth = 0; }
A : 'a' { this.missing = 1; } ;
WS : ' ' -> skip ;
";
    let qualified_out = gen(qualified);
    assert unsupported_count(&qualified_out) == 1, "an undeclared `this.<field>` must be reported";
    assert !qualified_out.source.contains("lx.missing"), "the refused read must not be emitted";

    let bare = "lexer grammar L;
@members { int depth = 0; }
A : 'a' { missing = 1; } ;
WS : ' ' -> skip ;
";
    assert unsupported_count(&gen(bare)) == 1, "an undeclared bare field must be reported";
}

test "a lexer predicate that prints is reported, not wired to the sink" {
    // A predicate is evaluated for every candidate rule, losers included, so
    // printing from one would emit output the tournament discards.
    assert unsupported_count(&gen("lexer grammar L;
A : 'a'+ { System.out.println(\"x\") }? ;
WS : ' ' -> skip ;
")) == 1, "a printing lexer predicate must surface UnsupportedAction";
}

test "a Java lexer body can declare and read its own local" {
    let got = lexes("lexer grammar L;
A : 'a'+ { int n = 1; System.out.println(\"n=\" + n); } ;
WS : ' ' -> skip ;
", ["aa"]);
    assert got == "aa => A:aa [n=1\n]\n";
}

test "a lexer rule called from another matches through its later alternatives" {
    // css3's `Dimension : Number R E M`: `0.25` is `Number`'s second
    // alternative, and its first stops at `0`. `N` is called, and still takes
    // its longest arm as a token of its own.
    let got = lexes("lexer grammar L;
D : N 'rem' | N 'px' ;
E : 'x' N ;
N : [0-9]+ | [0-9]* '.' [0-9]+ ;
DOT : '.' ;
", ["0.25rem", "12px", ".5rem", "3.", "1.5", "x1.5", "x3."]);
    assert got == "0.25rem => D:0.25rem\n12px => D:12px\n.5rem => D:.5rem\n3. => N:3 DOT:.\n1.5 => N:1.5\nx1.5 => E:x1.5\nx3. => E:x3 DOT:.\n";
}

test "a chain of optionals lexes the longest match in a matcher linear in its length" {
    // css3's `UnicodeRange`. Each lookahead-aware `'?'?` peeks what follows it,
    // and an emit that nests the whole suffix at every stop doubles the matcher
    // per optional: five of them took 1,905 lines.
    let src = "lexer grammar L;
U : 'u+' '?'? '?'? '?'? '?'? '?'? ;
Q : '?' ;
";
    // One peek, saved and restored, per optional with another after it.
    assert count_occurrences(&gen_source(src), "peek_save_") == 8;
    let got = lexes(src, ["u+", "u+??", "u+?????", "u+??????"]);
    assert got == "u+ => U:u+\nu+?? => U:u+??\nu+????? => U:u+?????\nu+?????? => U:u+????? Q:?\n";
}

test "a called lexer rule keeps its own case folding" {
    let got = lexes("lexer grammar L;
A : B 'z' ;
B options { caseInsensitive = true; } : 'a' | 'ab' ;
", ["Az", "A"]);
    assert got == "Az => A:Az\nA => B:A\n";
}

test "a called lexer rule runs its actions only for a token of its own" {
    let got = lexes("lexer grammar L;
A : B 'z' ;
B : 'a' { System.out.println(\"x\"); } | 'ab' ;
", ["az", "abz", "a"]);
    assert got == "az => A:az\nabz => A:abz\na => B:a [x\n]\n";
}

test "an unmodelled ANTLR lexer field is a loud diagnostic, not broken code" {
    // `_hitEOF` is a recognizer field Gale does not model.
    let src = "lexer grammar L;
A : 'a'+ { _hitEOF }? ;
NL : '\n' ;
";
    let out = gen(src);
    assert unsupported_count(&out) == 1, "an unmodelled lexer field must surface UnsupportedAction";
    assert !out.source.contains("_hitEOF"), "the untranslatable body must not be emitted";
}

test "a predicate in an ATN-class lexer rule is refused, not silently dropped" {
    // The rule routes to `latn_match`, and the lexer ATN has no predicate
    // transition, so without a refusal it matches input the predicate rejects.
    let src = "lexer grammar L;
options { language = Wado; }
CMT : '/*' ( CMT | . )+? { false }? '*/' ;
WS : ' ' -> skip ;
";
    assert unsupported_count(&gen(src)) == 1, "an ATN-class rule's predicate must surface UnsupportedAction";
}

test "an ATN-class lexer rule with no predicate stays byte-identical" {
    let src = "lexer grammar L;
options { language = Wado; }
CMT : '/*' ( CMT | . )+? '*/' ;
WS : ' ' -> skip ;
";
    assert unsupported_count(&gen(src)) == 0, "the refusal must not fire on a predicate-free ATN-class rule";
}

test "an unresolvable lexer $-attribute is reported, not a generator panic" {
    // Staging runs where a `ctx` is in hand; emit has none to warn through.
    let src = "lexer grammar L;
options { language = Wado; }
A : 'a' { lx.set_type($nope) } ;
B : 'b' ;
";
    let out = gen(src);
    assert unsupported_count(&out) == 1, "an unresolvable $-attribute must surface UnsupportedAction";
    assert !out.source.contains("$nope"), "the untranslatable body must not be emitted";
}

test "$mode needs a grammar that has a mode to switch to" {
    let no_modes = "lexer grammar L;
options { language = Wado; }
A : 'a' { $mode = 1 } ;
B : 'b' ;
";
    assert unsupported_count(&gen(no_modes)) == 1, "$mode with no mode to switch to must be reported";
}

test "a $mode read only a predicate asks for turns nothing on" {
    // The predicate is refused (a latch answers nothing during the tournament),
    // so the read never reaches the field — which must therefore not be emitted.
    let src = "lexer grammar L;
options { language = Wado; }
A : 'a' { $mode == 0 }? ;
mode TAIL;
B : 'b' ;
";
    let generated = gen(src);
    assert unsupported_count(&generated) == 1, "a latch read from a lexer predicate must be reported";
    let out = generated.source;
    assert !out.contains("fn mode(&self)"), "no current-mode reader for a read that is refused";
    assert !out.contains("act_mode ="), "and no field to seed";
}

test "$mode cannot be read and assigned in one site" {
    // The read and the write are different fields, so `+=` has no single
    // expression to become.
    let src = "lexer grammar L;
options { language = Wado; }
A : 'a' { $mode += 1 } ;
mode TAIL;
B : 'b' ;
";
    assert unsupported_count(&gen(src)) == 1, "a compound assignment to $mode must be reported";
}

test "a lexer attribute over the match window is not assignable" {
    let src = "lexer grammar L;
options { language = Wado; }
A : 'a' { $text = \"b\" } ;
B : 'b' ;
";
    assert unsupported_count(&gen(src)) == 1, "$text is a read of the match window";
}

test "a keyword-shaped rule carrying a body is matched, not reclassified" {
    // The classifier rewrites only `best_kind`, so the replay would run the carrier's
    // actions, not this rule's; a rule with a body keeps its own matcher.
    let with_action = lexes("grammar T;
options { language = Wado; }
r : A ID ;
A : 'A' { lx.emit(\"!\") } ;
ID : [a-zA-Z]+ ;
WS : [ \\t\\n\\r]+ -> skip ;
", ["A Ab A"]);
    assert with_action == "A Ab A => A:A ID:Ab A:A [!!]\n";

    let with_pred = lexes("grammar T;
options { language = Wado; }
r : A ID ;
A : 'A' { start == 0 }? ;
ID : [a-zA-Z]+ ;
WS : [ \\t\\n\\r]+ -> skip ;
", ["A A"]);
    assert with_pred == "A A => A:A ID:A\n";

    // The shortcut still applies to the plain shape it was written for.
    let plain = gen_source("grammar T;
options { language = Wado; }
r : A ID ;
A : 'A' ;
ID : [a-zA-Z]+ ;
WS : [ \\t\\n\\r]+ -> skip ;
");
    assert !plain.contains("fn try_A("), "a bare keyword is still reclassified from its carrier";
    assert plain.contains("fn classify_keyword("), "by the classifier";
}

test "a lexer predicate cannot reach the commit latches" {
    // A predicate is evaluated for every candidate rule, losers included, so it
    // settles nothing about the token that wins.
    let src = "lexer grammar L;
options { language = Wado; }
A : 'a'+ { $type == 1 }? ;
B : 'b' ;
";
    assert unsupported_count(&gen(src)) == 1, "a latch read from a lexer predicate must be reported";
}

test "a multi-alt rule around a restructured repeat replays instead of running flat" {
    // The replay now walks a lookahead-aware repeat, so each alt runs its own actions
    // in place instead of the flat emit's `winning_alt_` helper.
    let src = gen_source("lexer grammar L;
options { language = Wado; }
A : 'a' ~('b')+ 'c' { lx.set_type(TK_X) } | 'd' { lx.set_type(TK_Y) } ;
B : 'b' ;
WS : ' ' -> skip ;
");
    assert !src.contains("fn winning_alt_A"), "the replay selects the arm itself";
    assert src.contains("sel_alt_"), "the replay selects the winning arm match-only first";
}

test "a superClass action op runs from the replay, not from the match fn" {
    // The action op is the only base call, so `try_A` — which never emits an
    // action — stays effect-free and only the replay carries `with B`.
    let src = gen_source("lexer grammar L;
options { superClass = B; language = Wado; }
A : 'a' { this.hit() } ;
WS : ' ' -> skip ;
");
    assert src.contains("fn hit(view: LexerView, lx: &mut Lexer);"), "an action op returns unit and reaches the lexer";
    assert src.contains("fn apply_A_actions(lx: &mut Lexer, start: i32, end: i32) with B"), "the replay carries the base effect";
    assert src.contains("B::hit(LexerView { src, start, pos }, lx);"), "the action op is called from the replay";
    assert src.contains("fn try_A(src: &StrSlice, start: i32) -> i32 {"), "a match fn with no predicate op stays effect-free";
}

test "a superClass action op reaches the lexer mode state" {
    // The depth is a tokenize-loop local, so it rides on the `Lexer`.
    let src = gen_source("lexer grammar L;
options { superClass = B; language = Wado; }
A : '[' { this.hit() } ;
WS : ' ' -> skip ;
mode Arg;
C : ']' ;
");
    assert src.contains("fn mode_depth(&self) -> i32 {"), "the base can read the mode-stack depth";
    assert src.contains("lexer.reset_actions(best_kind, best_channel, mode_stack.len());"), "the depth is seeded per token";
    assert src.contains("self.act_mode_depth += 1;"), "push_mode keeps the depth the base reads consistent";
    assert src.contains("self.act_mode_depth -= 1;"), "pop_mode keeps the depth the base reads consistent";
}

test "a base method used as both a predicate and an action is refused" {
    let src = "lexer grammar L;
options { superClass = B; language = Wado; }
A : { this.m() }? 'a' { this.m() } ;
WS : ' ' -> skip ;
";
    // Two reports: the refused base, and the action that can no longer run.
    let generated = gen(src);
    assert unsupported_count(&generated) == 2, "a mixed-role base method must be reported";
    let out = generated.source;
    assert !out.contains("pub interface B {"), "a refused base is not wired";
}

test "an action may issue at most one mode command per token" {
    let commands_only = gen_source("lexer grammar L;
options { superClass = B; language = Wado; }
A : '[' { this.hit() } ;
WS : ' ' -> skip ;
mode Arg;
C : ']' ;
");
    assert commands_only.contains("assert self.act_push_mode < 0 && !self.act_pop_mode && self.act_set_mode < 0,"), "each mode command guards against a second one";
    // Every command passes that guard, so a grammar whose only mode writes are
    // commands must not pay for the invariant again per token.
    assert !commands_only.contains("<= 1, \"a lexer action may issue at most one mode command per token\""), "no second check where every write passes a command";

    // A `$mode` assignment reaches the set latch without passing one, so there
    // the commit repeats the invariant over the latches themselves.
    let assigns_mode = gen_source("lexer grammar L;
options { language = Wado; }
A : 'a' { $mode = MODE_TAIL } ;
mode TAIL;
B : 'b' ;
");
    assert assigns_mode.contains("<= 1, \"a lexer action may issue at most one mode command per token\""), "the commit guards the latches a $mode assignment can reach";
}

test "the current-mode read is emitted only for a grammar that asks for it" {
    let unread = gen_source("lexer grammar L;
options { superClass = B; language = Wado; }
A : '[' { this.hit() } ;
WS : ' ' -> skip ;
mode Arg;
C : ']' ;
");
    assert !unread.contains("fn mode(&self)"), "no current-mode read where no body reads one";
    assert !unread.contains("act_mode ="), "and no field to seed";
    assert unread.contains("fn mode_depth(&self) -> i32 {"), "the depth a base branches on stays";
}

test "a predicate-only base gets the emit hook without the channel machinery" {
    // No action and no `-> channel` rule means no `best_channel` local.
    let src = gen_source("lexer grammar L;
options { superClass = B; }
A : { this.ok() }? 'a' ;
WS : ' ' -> skip ;
");
    assert !src.contains("best_channel"), "the channel machinery stays off";
    assert src.contains(
        "best_kind = B::emit(LexerView { src: &lexer.src, start: tok_start, pos: best_end }, best_kind, 0);",
    ), "the hook takes the default channel";
}

test "a base whose only override is the emit hook is still wired" {
    // No `this.<m>()` call anywhere, so the grammar contributes zero ops. The
    // hook fires once per emitted token, never for a skipped one.
    let src = gen_source("lexer grammar L;
options { superClass = B; language = Wado; }
A : 'a' ;
WS : ' ' -> skip ;
");
    let got = run_beside(src, "let mut base = Count {};
with B => &mut base do {
    tokenize(\"a a  a\");
};
println(`${base.emitted}`);
", "struct Count { emitted: i32 = 0 }
impl B for Count {
    fn emit(&mut self, view: LexerView, ty: i32, channel: i32) -> i32 {
        self.emitted += 1;
        resume ty;
    }
}
").stdout;
    assert got == "3\n";
}

test "a grammar with no base has no emit hook" {
    let src = gen_source("lexer grammar L;
options { language = Wado; }
A : 'a' { lx.set_type(TK_B) } ;
B : 'b' ;
WS : ' ' -> skip ;
");
    assert !src.contains("::emit(LexerView"), "no base, no lifecycle call";
}

test "a modeless grammar keeps the mode-state surface off" {
    let src = gen_source("lexer grammar L;
options { superClass = B; language = Wado; }
A : 'a' { this.hit() } ;
WS : ' ' -> skip ;
");
    assert !src.contains("fn mode_depth(&self)"), "no modes, no mode-state reads";
    assert src.contains("lexer.reset_actions(best_kind, best_channel);"), "a modeless reset takes no mode state";
}

test "a superClass grammar's host-code action body is reported, not emitted" {
    // java2wado is carved out for a superClass grammar, so a Java body only runs
    // when the base-call rewrite alone turns it into Wado. This one does not.
    let src = "lexer grammar L;
options { superClass = B; }
A : 'a' { int n = 1; this.hit(); } ;
WS : ' ' -> skip ;
";
    let generated = gen(src);
    assert unsupported_count(&generated) == 1, "an untranslatable superClass action body must be reported";
    let out = generated.source;
    assert !out.contains("fn apply_A_actions"), "no replay is emitted for an action that cannot run";
    assert out.contains("pub interface B {"), "the base stays wired for its other ops";
}

test "a superClass predicate-only grammar keeps its action surface off" {
    // RustLexer's shape: base calls, but no `{ ... }` action anywhere. Nothing
    // gains the action machinery.
    let src = gen_source("lexer grammar L;
options { superClass = B; }
A : { this.ok() }? 'a' ;
WS : ' ' -> skip ;
");
    assert !src.contains("fn apply_"), "a predicate-only base emits no replay fn";
    assert !src.contains("act_type"), "a predicate-only base emits no action-effect surface";
}

test "a superClass call's literal arguments settle its operation's signature" {
    let src = "lexer grammar L;
options { superClass = B; language = Wado; }
A : 'a' { this.setChannel(2) } ;
WS : ' ' -> skip ;
";
    let generated = gen(src);
    assert unsupported_count(&generated) == 0, "a literal argument needs no other signature source";
    let got = run_beside(generated.source, "let mut base = Seen {};
with B => &mut base do {
    tokenize(\"a a\");
};
println(`${base.args:?}`);
", "struct Seen { args: List<i32> = [] }
impl B for Seen {
    fn set_channel(&mut self, view: LexerView, lx: &mut Lexer, a0: i32) {
        self.args.push(a0);
        resume ();
    }
}
").stdout;
    assert got == "[2, 2]\n";
}

test "a superClass call whose argument has no evident type is refused" {
    // The interface would have to invent the type, so wiring the base would run
    // `set_channel` against a signature nothing settled. Refuse and say so.
    let src = "lexer grammar L;
options { superClass = B; language = Wado; }
A : 'a' { this.setChannel(n + 1) } ;
WS : ' ' -> skip ;
";
    // Two reports: the refused base, and the action that can no longer run.
    let generated = gen(src);
    assert unsupported_count(&generated) == 2, "an unsettled base call must be reported";
    let out = generated.source;
    assert !out.contains("pub interface B"), "no interface is emitted for a base Gale cannot represent";
    assert !out.contains("B::set_channel"), "the call must not be emitted against a guessed signature";
    assert !out.contains("this.setChannel"), "a body naming `this` must not reach the generated module";
}

test "an expression that merely starts and ends with a quote is not a literal" {
    let src = "lexer grammar L;
options { superClass = B; language = Wado; }
A : 'a' { this.setChannel(\"x\" + y + \"z\") } ;
WS : ' ' -> skip ;
";
    let generated = gen(src);
    assert unsupported_count(&generated) == 2, "concatenation settles no signature either";
    let out = generated.source;
    assert !out.contains("pub interface B"), "no interface for a base whose call takes an unrepresentable argument";
    assert !out.contains("+ y +"), "the host expression must not be spliced into the call";
}

// A members block the translator refuses declares nothing, so the fields its
// actions name have no type to copy and the gate goes unsimulated.
fn members_grammar<S: AsStrSlice>(members: S) -> String {
    return `grammar C;
options { language = Java; }
@parser::members {
${members}
}
r : A { n = 1; } A ;
A : 'a' ;
`;
}

test "a members block the translator refuses leaves the gate unsimulated" {
    let out = gen_source(&members_grammar(
        "    java.util.Map<String, Integer> seen = new java.util.HashMap<>();\n    int n = 0;",
    ));
    assert !out.contains("struct ScanGate"), "a field no member declares must not reach the scan gate";
}

// The rejection case for the test above: without it, that assertion would also
// hold for a grammar that simulates nothing.
test "the same action with a translatable members block reaches the gate" {
    let out = gen_source(&members_grammar("    int n = 0;"));
    assert out.contains("struct ScanGate"), "a declared field stays simulable";
    assert out.contains("n: i32 = 0"), "the gate copies the member's own type and initialiser";
}

// The gate is parser state that every scan walks by reference, never a global.
test "the scan gate lives on the parser" {
    let out = longest_source("grammar C;
options { language = Java; }
@parser::members {
    int n = 0;
}
s : (r | r B)* EOF ;
r : A { n = 1; } A+ ;
A : 'a' ;
B : 'b' ;
");
    assert out.contains("scan_gate: ScanGate = ScanGate {}");
    assert out.contains("fn scan_r(tokens: &Array<i32>, pos: i32, gate: &mut ScanGate,");
    for let line of out.lines() {
        assert !(line.starts_with("global") && line.contains("ScanGate")), line;
    }
}

// The LR dispatch launches a scan three ways (branch call, prebound fallback, ATN
// repick); each must start from the parser's gate, not a sibling's reading.
test "every parse-launched LR suffix scan is seeded" {
    let out = gen_source("grammar L;
@parser::members {
    int noStruct = 0;
}
start : e EOF ;
e : e OP a b
  | e OP a c
  | {noStruct == 0}? ID
  | LB {noStruct = 1;} e RB
  ;
a : A ;
b : B ;
c : C ;
OP : '+' ; A : 'a' ; B : 'b' ; C : 'c' ; ID : 'x' ; LB : '(' ; RB : ')' ;
WS : [ \\t\\r\\n]+ -> skip ;
");
    assert out.contains("let _lr_scan_"), "the grammar must reach the pre-bound fallbacks";
    let mut calls = 0;
    let mut seeded = 0;
    let mut after_seed = false;
    for let line of out.split("\n") {
        let l = line.trim();
        if l.contains("_lr_") && l.contains("(&p.kinds, p.pos") {
            calls += 1;
            if after_seed {
                seeded += 1;
            }
        }
        after_seed = l.starts_with("p.scan_gate.") && l.contains(" = p.");
    }
    assert calls > 0, "the grammar must reach a parse-launched LR scan";
    assert seeded == calls;
}

test "a prebound LR suffix scan is neither re-tested nor re-seeded" {
    let out = gen_source("grammar L;
@parser::members {
    int noStruct = 0;
}
start : e EOF ;
e : e OP a b
  | e OP a c
  | {noStruct == 0}? ID
  | LB {noStruct = 1;} e RB
  ;
a : A ;
b : B ;
c : C ;
OP : '+' ; A : 'a' ; B : 'b' ; C : 'c' ; ID : 'x' ; LB : '(' ; RB : ')' ;
WS : [ \\t\\r\\n]+ -> skip ;
");
    assert out.contains("let _lr_scan_"), "the grammar must reach the pre-bound fallbacks";
    assert !out.contains("_lr_pos0"), "every suffix opens on OP, so the loop always advances";
    let mut prev = "";
    for let line of out.split("\n") {
        let l = line.trim().to_string();
        assert !(l.starts_with("if _lr_scan_") && l.ends_with("< 0 {")), "a matched prebound scan is re-tested";
        assert !(l.starts_with("let _lr_scan_") && l.contains("_gate = p.scan_gate")), "the parse keeps a gate it never reads";
        assert !(prev.starts_with("let lr_pre") && l.starts_with("*gate = lr_pre")), "the gate is restored to itself";
        prev = l;
    }
}

test "a tournament leaves a simulable gate to the candidate's scan" {
    let out = longest_source("grammar L;
@parser::members {
    int noStruct = 0;
}
start : r EOF ;
r : {noStruct == 0}? ID LB
  | ID LB X
  | LB {noStruct = 1;} r {noStruct = 0;} RB
  ;
ID : 'x' ; LB : '(' ; RB : ')' ; X : 'y' ;
WS : [ \\t\\r\\n]+ -> skip ;
");
    assert out.contains("let _sd_p_0 = "), "the grammar must reach a tournament";
    assert !out.contains("else { -1 }"), "the gate is tested twice";
    assert out.contains("if !(gate._scan_edge != pos || gate.no_struct == 0) { return -1; }"), "the candidate scan tests the gate where its decision starts";
}

test "a single-token rule with a gated alternative keeps the gate in its scan" {
    // Inside the brackets the gate is false, so `body`'s first alternative cannot
    // start with `x`; scanned without it, it outmatches the second.
    let got = parses("grammar T;
@parser::members {
    int noStruct = 0;
}
start : LB {noStruct = 1;} body {noStruct = 0;} RB EOF | body EOF ;
body : r xs RB | ID xs ;
r : {noStruct == 0}? ID | RB ;
xs : LB+ ;
ID : 'x' ; LB : '(' ; RB : ')' ;
WS : [ \\t\\r\\n]+ -> skip ;
", "start", ["(x()", "x()"]);
    assert got == "(x() => (start ( (body x (xs ()) ))\nx() => (start (body (r x) (xs () )))\n";
}

test "a member named as the scan edge keeps both fields" {
    let got = parses("grammar T;
@parser::members {
    int _scan_edge = 0;
}
start : LB {_scan_edge = 1;} body {_scan_edge = 0;} RB EOF | body EOF ;
body : r xs RB | ID xs ;
r : {_scan_edge == 0}? ID | RB ;
xs : LB+ ;
ID : 'x' ; LB : '(' ; RB : ')' ;
WS : [ \\t\\r\\n]+ -> skip ;
", "start", ["(x()", "x()"]);
    assert got == "(x() => (start ( (body x (xs ()) ))\nx() => (start (body (r x) (xs () )))\n";
}

/// One strategy: the sentence the dump prints for it, and the local the emitter
/// mints when it takes it. Each local is named once per decision.
struct StrategyMarker {
    reported: String,
    emitted: String,
}

global STRATEGY_MARKERS: List<StrategyMarker> = [
    StrategyMarker {
        reported: "maximal munch: every arm scanned",
        emitted: "let mut alts_best_",
    },
    // Not `la_saved_`: the lookahead-aware repeat saves the cursor under that
    // name too, so it names two strategies rather than one.
    StrategyMarker {
        reported: "arm scoring: each arm scored",
        emitted: "let mut la_win_",
    },
    StrategyMarker {
        reported: "lookahead-aware: the inner can eat",
        emitted: "let mut la_end_",
    },
    StrategyMarker {
        reported: "non-greedy: min-match loop",
        emitted: "let ng_saved_",
    },
];

// Action-free: a rule that runs actions emits its body twice, to match and to
// replay, so its locals would count double against a report naming each once.
test "every strategy the dump reports is one the emitter emitted" {
    for let src of &[
        "grammar T;\nr : A ;\nA : ('a' | 'ab') ;\nB : . ;", "grammar T;\nr : A ;\nA : 'a' (~'b')+ 'c' ;\nB : . ;",
        "grammar T;\nr : A ;\nA : 'a' .*? 'c' ;\nB : . ;", "grammar T;\nr : A ;\nA : ('a' | 'ab') 'c' ;\nB : . ;",
        "grammar T;\nr : A ;\nA : 'a' 'b'? 'b' ;\nB : . ;",
        "grammar T;\nr : A B ;\nA : 'a' (~'b')+ 'c' | ('x' | 'xy') 'z' ;\nB : 'q' .*? 'r' ;\nC : . ;",
    ] {
        let report = lexer_dump(src);
        let code = gen_source(src);
        for let m of &STRATEGY_MARKERS {
            let reported = count_occurrences(&report, &m.reported);
            let emitted = count_occurrences(&code, &m.emitted);
            assert reported == emitted;
        }
    }
}

test "java members: a refused block declares nothing an action can then resolve" {
    // ANTLR concatenates `@members` blocks, so one malformed block refuses them all,
    // and the refusal is the only diagnostic: no call to a member never declared.
    let out = gen("grammar T;
options { language = Java; }
@members { int good() { return 1; } }
@members { int ; }
a : ID { good(); } ;
ID : [a-z]+ ;
");
    assert !out.source.contains("p.good()"), "a member from a refused block must not be called";
    assert !out.source.contains("fn good"), "a member from a refused block must not be declared";
    assert unsupported_count(&out) >= 1, "the refusal must be reported";
}

test "java members: a well-formed block still resolves across its siblings" {
    let out = gen("grammar T;
options { language = Java; }
@members { int good() { return helper(); } }
@members { int helper() { return 1; } }
a : ID { good(); } ;
ID : [a-z]+ ;
");
    assert out.source.contains("fn good"), "a method declared in one block is emitted";
    assert out.source.contains("fn helper"), "a method declared in a sibling block is emitted";
    assert out.source.contains("p.good()"), "an action resolves a member the struct got";
    assert unsupported_count(&out) == 0, "a well-formed block is not reported";
}

test "each call site passes its own rule arguments, and a return value reaches the next call" {
    let got = parses("grammar T;
s : a=e[1, 2] e[$a.v, (10)] EOF ;
e[int x, int y] returns [int v] : ID { $v = $x + $y; System.out.print($v + \" \"); } ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["a b"]);
    assert got == "a b => (s (e a) (e b)) [3 13 ]\n";
}

test "a returns or locals initializer holds when the rule is entered" {
    let got = parses("grammar T;
s : r {System.out.print($r.v + \" \" + $r.n);} EOF ;
r returns [int v = 5, int n] locals [int k = 2] : 'a' {$n = $k;} ;
WS : ' ' -> skip ;
", "s", ["a"]);
    assert got == "a => (s (r a)) [5 2]\n";
}

// A predicate reading the invocation it sits in is ignored where prediction
// meets it in another (`doc/predicates.md`). The outer `r` has cleared its `x`
// by the time it reaches `r?`; the second `r` of `s` is met through the first's
// empty alternative, and the first's `d` is not its own.
test "prediction ignores a context-dependent predicate outside its own invocation" {
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        let options = GenerateOptions { prediction };
        assert parses("grammar T;
s : r EOF ;
r locals [int x = 1] : {$x > 0}? 'a' {$x = 0;} r? ;
WS : ' ' -> skip ;
", "s", ["a a"], &options) == "a a => (s (r a (r a)))\n";
        assert parses("grammar T;
s : r[0] r[1] EOF ;
r[int d] : {$d > 0}? 'a' | ;
WS : ' ' -> skip ;
", "s", ["a", "a a"], &options) == "a => (s r (r a))\na a => error\n";
    }
}

test "a label read where its alternative did not bind it" {
    let got = parses("grammar T;
s : 'A' r1 EOF | 'B' r2 EOF | 'C' r3 EOF | 'D' r4 EOF ;
r1 : (x='b')? 'a' {String s = $x.text; System.out.println(\"r1 \" + \"null\".equals(s) + \" \" + (s == null));} ;
r2 : x='-'? 'a' {System.out.println(\"r2 \" + ($x == (null)) + \" \" + ((null) != $x));} ;
r3 : ID* 'a' {System.out.println(\"r3 \" + ($ctx.ID() != null));} ;
r4 : ID 'a' | ID 'c' | INT 'b' {System.out.println(\"r4 \" + ($ctx.ID() != null));} ;
INT : [0-9]+ ;
ID : [d-w]+ ;
WS : ' ' -> skip ;
", "s", ["A a", "B a", "C a", "D 1 b"]);
    assert got == "A a => (s A (r1 a)) [r1 false true\n]
B a => (s B (r2 a)) [r2 true false\n]
C a => (s C (r3 a)) [r3 true\n]
D 1 b => (s D (r4 1 b)) [r4 false\n]
";
}

test "@after reads a label of whichever alternative ran" {
    let got = parses("grammar T;
s : 'E' r5 EOF ;
r5 @after {System.out.println(\"r5 \" + $y.v);} : (y=q)? 'a' | 'b' ;
q returns [int v] : INT {$v = $INT.int;} ;
INT : [0-9]+ ;
WS : ' ' -> skip ;
", "s", ["E 7 a"]);
    assert got == "E 7 a => (s E (r5 (q 7) a)) [r5 7\n]\n";
}

test "@after reads a token-set label" {
    let got = parses("grammar T;
s : r EOF ;
r @after {System.out.println(\"x \" + $x.text);} : x=(A|B) | C ;
A : 'a' ; B : 'b' ; C : 'c' ;
", "s", ["b"]);
    assert got == "b => (s (r b)) [x b\n]\n";
}

test "a left-recursive suffix binds its token-set label" {
    let got = parses("grammar T;
s : e EOF ;
e : e (x=('b'|'c'))? '+' {System.out.println(\"e \" + $x.text);} | INT ;
INT : [0-9]+ ;
WS : ' ' -> skip ;
", "s", ["1 b +"]);
    assert got == "1 b + => (s (e (e 1) b +)) [e b\n]\n";
}

// The `.` suffix sends the loop to the simulator, whose table holds no
// predicate: `op`'s decides between the two suffixes `+` opens.
test "the left-recursion loop's simulator pick answers the predicates past the operand" {
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        assert parses("grammar T;
s : e EOF ;
e : e op 'b' | e . 'b' | INT ;
op : {false}? '+' | '-' ;
INT : [0-9]+ ;
WS : ' ' -> skip ;
", "s", ["1 + b", "1 - b", "1 + b - b"], &GenerateOptions { prediction }) == "1 + b => (s (e (e 1) + b))
1 - b => (s (e (e 1) (op -) b))
1 + b - b => (s (e (e (e 1) + b) (op -) b))
";
    }
}

// The jar never enters the gated suffix, so `s` takes the `+ 2` itself.
test "a predicate past the operand gates the left-recursive suffix in the simulator" {
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        assert parses("grammar T;
s : e ('+' INT)? EOF ;
e : e {false}? '+' INT | e . 'z' | INT ;
INT : [0-9]+ ;
WS : ' ' -> skip ;
", "s", ["1 + 2"], &GenerateOptions { prediction }) == "1 + 2 => (s (e 1) + 2)\n";
    }
}

// An action only hides the predicates behind it from the paths that run it: a
// path still empty there reaches the predicate past the group.
test "an action in one alternative leaves the others' predicates in view" {
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        assert parses("grammar T;
s : 'G' r7 EOF | 'H' r8 EOF ;
r7 : ({} 'b' | 'c' | ) {false}? 'a' | 'a' ;
r8 : ({} ({false}? 'a')?) 'b' | 'a' 'b' ;
WS : ' ' -> skip ;
", "s", ["G a", "H a b"], &GenerateOptions { prediction }) == "G a => (s G (r7 a))\nH a b => error\n";
    }
}

test "each left-recursive suffix starts from the initializer" {
    let got = parses("grammar T;
s : e EOF ;
e returns [int v = 5] : e '+' e {System.out.print($v + \" \"); $v = 0;} | INT {System.out.print($v + \" \"); $v = 1;} ;
INT : [0-9]+ ;
", "s", ["1+2+3"]);
    assert got == "1+2+3 => (s (e (e (e 1) + (e 2)) + (e 3))) [5 5 5 5 5 ]\n";
}

test "a `<` in a call argument is a comparison, not a bracket" {
    let got = parses("grammar T;
s : a=n e[$a.v < 2, $a.v] EOF ;
n returns [int v] : ID { $v = 1; } ;
e[boolean x, int y] : ID { System.out.print($x + \" \" + $y); } ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["a b"]);
    assert got == "a b => (s (n a) (e b)) [true 1]\n";
}

// `args` scopes the gate for its own extent (`locals` + `@init` / `@after`), so
// the ban on the braced form resumes after the `)`; the scan has to restore it
// the same way or it disagrees with the parse about the head's tail.
test "a rule scoping a gate restores it for the rest of the enclosing head" {
    let got = parses("grammar T;
@parser::members {
    int noBrace = 0;
}
start : stmt+ EOF ;
stmt : IF {noBrace = 1;} expr {noBrace = 0;} block | expr SEMI ;
block : LB ID RB ;
args
locals [int sv]
@init { $sv = noBrace; noBrace = 0; }
@after { noBrace = $sv; }
    : expr
    ;
expr : expr OR expr | ID LP args RP | {noBrace == 0}? ID LB ID RB | ID ;
IF : 'if' ; OR : '||' ; LP : '(' ; RP : ')' ; LB : '{' ; RB : '}' ; SEMI : ';' ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "start", ["if f(x) || a { b }", "if f(a { b }) { c }", "a { b } ;"]);
    assert got == "if f(x) || a { b } => (start (stmt if (expr (expr f ( (args (expr x)) )) || (expr a)) (block { b })))
if f(a { b }) { c } => (start (stmt if (expr f ( (args (expr a { b })) )) (block { c })))
a { b } ; => (start (stmt (expr a { b }) ;))
";
}

global LR_SUFFIX_LOOPS: String = "grammar T;
s : e EOF ;
e : e '(' .*? ')'
  | e '[' ID+ ']'
  | e '{' (ID ',')+ '}'
  | e '<' ID*? '>'
  | ID ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
";

test "a left-recursive suffix runs its own loops, greedy and non-greedy" {
    let got = parses(LR_SUFFIX_LOOPS, "s", ["x[a b][c]", "x{a,b,}", "x<a b>", "x<>", "x(y)[z]{w,}<>"]);
    assert got == "x[a b][c] => (s (e (e (e x) [ a b ]) [ c ]))
x{a,b,} => (s (e (e x) { a , b , }))
x<a b> => (s (e (e x) < a b >))
x<> => (s (e (e x) < >))
x(y)[z]{w,}<> => (s (e (e (e (e (e x) ( y )) [ z ]) { w , }) < >))
";
}

test "a non-greedy wildcard in a left-recursive suffix exits only where the rest can match" {
    let got = parses(LR_SUFFIX_LOOPS, "s", ["x(a ) b)", "x(a)(b)", "x(a ) [b])"]);
    assert got == "x(a ) b) => (s (e (e x) ( a ) b )))
x(a)(b) => (s (e (e (e x) ( a )) ( b )))
x(a ) [b]) => (s (e (e x) ( a ) [ b ] )))
";
}

// The atom's alternatives share `(`, so each one gets a function of its own,
// and the simulator deciding the loop inside it reads the rule's precedence.
test "a non-greedy wildcard in a contested atom alternative decides at the rule's precedence" {
    let got = parses("grammar T;
s : e EOF ;
e : e '+' e | '(' .*? ')' | '(' ID ')' ']' | ID ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["(a b) + (c)", "(a ) b ) + c"]);
    assert got == "(a b) + (c) => (s (e (e ( a b )) + (e ( c ))))
(a ) b ) + c => (s (e (e ( a ) b )) + (e c)))
";
}

// Both alternatives of `a` scan `e` at one position, and `t` inside it decides
// by what `a` has left: `e` ends before the `!` under the first and after it
// under the second. The second reaches further only with its own answer, so
// the scan memo keeps no answer that read the caller.
test "a remembered scan answers only where no prediction read its caller" {
    let got = parses("grammar T;
s : a EOF ;
a : e '!' ';' | e ';' ';' ;
e : e '+' e | t ;
t : ID | ID '!' ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["a ! ;", "a ! ; ;", "a + b ! ; ;", "a + b ! ;"]);
    assert got == "a ! ; => (s (a (e (t a)) ! ;))
a ! ; ; => (s (a (e (t a !)) ; ;))
a + b ! ; ; => (s (a (e (e (t a)) + (e (t b !))) ; ;))
a + b ! ; => (s (a (e (e (t a)) + (e (t b))) ! ;))
";
}

test "a non-greedy optional in a contested alternative skips where the rest can match" {
    let lr = parses("grammar T;
s : e EOF ;
e : e '+' e | '(' ID?? ID ')' | '(' ID ')' ']' | ID ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["(a)", "(a b)", "(a)+(a b)"]);
    let plain = parses("grammar T;
s : e EOF ;
e : '(' ID?? ID ')' | '(' ID ')' ']' | ID ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["(a)", "(a b)"]);
    let got = `${lr}${plain}`;
    assert got == "(a) => (s (e ( a )))
(a b) => (s (e ( a b )))
(a)+(a b) => (s (e (e ( a )) + (e ( a b ))))
(a) => (s (e ( a )))
(a b) => (s (e ( a b )))
";
}

test "a non-greedy wildcard exits only where the whole rest of the input can match" {
    let rule = parses("grammar T;
s : '(' .*? ')' ';' ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["( a ) b ) ;", "( a ) ;"]);
    let group = parses("grammar T;
s : ( '(' .*? ')' | 'x' ) ';' ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["( a ) b ) ;", "x ;"]);
    let caller = parses("grammar T;
s : e 'b' 'c' EOF ;
e : '(' .*? ')' ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["( a ) b ) b c", "( a ) b c"]);
    let got = `${rule}${group}${caller}`;
    assert got == "( a ) b ) ; => (s ( a ) b ) ;)
( a ) ; => (s ( a ) ;)
( a ) b ) ; => (s ( a ) b ) ;)
x ; => (s x ;)
( a ) b ) b c => (s (e ( a ) b )) b c)
( a ) b c => (s (e ( a )) b c)
";
}

test "a redundant group around a loop body keeps the loop's decision" {
    let got = parses("grammar T;
s : 'a' (ID)* ID ';'
  | 'b' (ID)+ ID ';'
  | 'c' (ID)+ ';'
  | 'd' (ID)*? ID ';'
  | 'e' (ID)+? ID ';'
  | 'f' (ID)*? ';'
  ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["a x y z;", "a x;", "b x y z;", "b x;", "c x y;", "d x y z;", "e x y z;", "e x;", "f x y;", "f;"]);
    assert got == "a x y z; => (s a x y z ;)
a x; => (s a x ;)
b x y z; => (s b x y z ;)
b x; => error
c x y; => (s c x y ;)
d x y z; => (s d x y z ;)
e x y z; => (s e x y z ;)
e x; => error
f x y; => (s f x y ;)
f; => (s f ;)
";
}

test "a loop in a left-recursive suffix scans where its body overlaps what follows" {
    let got = parses("grammar T;
s : e EOF ;
e : e '[' (ID ',')* ID ']'
  | e '{' (ID ',')+ ID '}'
  | e '(' (ID ID | ID ',')* ')'
  | e '<' ID+? '>'
  | ID ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["x[a]", "x[a,b,c]", "x{a,b}", "x{a,b,c}", "x{a}", "x(a b c,)", "x()", "x<a b>", "x<>"]);
    assert got == "x[a] => (s (e (e x) [ a ]))
x[a,b,c] => (s (e (e x) [ a , b , c ]))
x{a,b} => (s (e (e x) { a , b }))
x{a,b,c} => (s (e (e x) { a , b , c }))
x{a} => error
x(a b c,) => (s (e (e x) ( a b c , )))
x() => (s (e (e x) ( )))
x<a b> => (s (e (e x) < a b >))
x<> => error
";
}

test "a shape-lookahead optional in a left-recursive suffix is decided per shape" {
    let got = parses("grammar T;
s : e EOF ;
e : ID | e 'in' ( 'a'? 'b' )? 'a' ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["x in a", "x in a b a", "x in b a", "x in a a"]);
    assert got == "x in a => (s (e (e x) in a))
x in a b a => (s (e (e x) in a b a))
x in b a => (s (e (e x) in b a))
x in a a => error
";
}

test "a call after a prefix operand is the prefix's own when only it can take one" {
    let got = parses("grammar T;
s : e ';' EOF ;
e : e '.' ID
  | 'new' e targs? args
  | 'new' e targs?
  | e args
  | ID e?
  | '(' e ')' ;
targs : '<' ID '>' ;
args : '(' (arg (',' arg)*)? ')' ;
arg : e ;
ID : [a-zA-Z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["new E(a);", "new E(a.b);", "new E(f(a));"]);
    assert got == "new E(a); => (s (e new (e E) (args ( (arg (e a)) ))) ;)
new E(a.b); => (s (e new (e E) (args ( (arg (e (e a) . b)) ))) ;)
new E(f(a)); => (s (e new (e E) (args ( (arg (e f (e ( (e a) )))) ))) ;)
";
}

test "a non-greedy optional in a left-recursive suffix leaves the else to its caller" {
    let got = parses("grammar T;
s : e 'else' ID EOF ;
e : ID | e 'if' e ('else' e)?? ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["a else c", "a if b else c", "a if b else c else d"]);
    assert got == "a else c => (s (e a) else c)
a if b else c => (s (e (e a) if (e b)) else c)
a if b else c else d => (s (e (e a) if (e b) else (e c)) else d)
";
}

test "interchangeable alternatives are picked by their predicates in grammar order" {
    let got = parses("grammar T;
s : a EOF ;
a : {false}? ID ID {System.out.print(\"one\");}
  | {true}? ID ID {System.out.print(\"two\");}
  | ID ID {System.out.print(\"three\");} ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["a b"]);
    assert got == "a b => (s (a a b)) [two]\n";
}

test "interchangeable alternatives whose predicates all fail have no viable alternative" {
    let got = parses("grammar T;
s : a EOF ;
a : {false}? ID ID | {false}? ID ID ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["a b"]);
    assert got == "a b => error\n";
}

// `q` tells its alternatives apart on its second token, so the one `b c`
// leaves viable is predicated, and a false predicate leaves none. The jar
// reports no viable alternative at `b`.
test "a predicate on the one alternative deeper lookahead leaves removes it" {
    let g4 = "grammar X;\ns : x EOF ;\nx : 'a' q | 'a' 'b' 'c' ;\nq : {false}? 'b' 'c' | 'b' 'd' ;\nWS : ' ' -> skip ;\n";
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        let got = parses(g4, "s", ["a b c", "a b d"], &GenerateOptions { prediction });
        assert got == "a b c => error\na b d => (s (x a (q b d)))\n", got;
    }
}

// Both alternatives end on `a c d`, and only what follows `r` would tell them
// apart, but the first meets a false predicate inside its group: the jar takes
// the second.
test "a predicate inside a group decides a tie at the rule's end" {
    let g4 = "grammar Z;\ns : r EOF ;\nr : ({false}? 'a' 'b'? 'c')? 'd' | 'a' 'c' 'd' 'e'? ;\nWS : ' ' -> skip ;\n";
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        let got = parses(g4, "s", ["a c d", "d", "a c d e"], &GenerateOptions { prediction });
        assert got == "a c d => (s (r a c d))\nd => (s (r d))\na c d e => (s (r a c d e))\n", got;
    }
}

// As above, with a predicate a scan cannot answer, since it calls a member,
// and the second alternative calling a rule, so the tree names the pick. The
// tournament cannot weigh it, so exact hands the tie to the simulator, and
// `verify` reports where the tournament picks otherwise.
test "a member predicate inside a group decides a tie at the rule's end" {
    let g4 = |verdict: String| `grammar Y;
@parser::members {
boolean pred(boolean v) { return v; }
}
s : r EOF ;
r : ({this.pred(${verdict})}? 'a' 'b'? 'c')? 'd' | x 'd' 'e'? ;
x : 'a' 'c' ;
WS : ' ' -> skip ;
`;
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        assert parses(g4("true"), "s", ["a c d"], &GenerateOptions { prediction }) == "a c d => (s (r a c d))\n";
    }
    assert parses(g4("false"), "s", ["a c d"]) == "a c d => (s (r (x a c) d))\n";
    let verify = gen_with(g4("false"), &GenerateOptions { prediction: PredictionMode::Verify }).source;
    let out = eval_beside(verify, wado`show("a c d", parse_s("a c d"));\n`, SHOW_FN);
    assert out.stderr.contains(": the tournament picks 0, the simulator 1"), out.stderr;
}

// The scan cannot answer `$d>0`, a local it does not simulate, but it still
// answers the `{false}?` beside it, so the first alternative fails in the scan
// as in the parse. The tree is the jar's.
#[timeout_ms(120000)]
test "a gate keeps the predicates a scan answers beside one it cannot" {
    let g4 = "grammar F1;
s : r EOF ;
r : q B | {true}? A B C? ;
q locals [int d=1] : {false}? {$d>0}? A ;
A : 'a' ; B : 'b' ; C : 'c' ;
WS : ' ' -> skip ;
";
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        assert parses(g4, "s", ["a b"], &GenerateOptions { prediction }) == "a b => (s (r a b))\n";
    }
}

// A loop deciding its group's alternative as it enters leaves a group the
// simulator decides to the simulator, and `verify` checks it. The longest match
// takes `a B`; the jar takes `a`, then `b` on the next iteration.
#[timeout_ms(120000)]
test "a repeated group the simulator decides takes the simulator's pick" {
    let g4 = "grammar N4;
s : (a | a B | b)* C EOF ;
a : A ;
b : B ;
A : 'a' ; B : 'b' ; C : 'c' ;
WS : ' ' -> skip ;
";
    assert parses(g4, "s", ["a b c"], &GenerateOptions { prediction: PredictionMode::Exact }) == "a b c => (s (a a) (b b) c)\n";
    let verify = gen_with(g4, &GenerateOptions { prediction: PredictionMode::Verify }).source;
    let out = eval_beside(verify, wado`show("a b c", parse_s("a b c"));\n`, SHOW_FN);
    assert out.stderr.contains(": the tournament picks 1, the simulator 0"), out.stderr;
}

// A group inside a left-recursive suffix parses as the simulator picks where
// the simulator decides it, and `verify` checks the tournament's pick there.
// The longest match takes `a B`, which leaves the suffix's `B` nothing to
// match; the jar takes `a`.
#[timeout_ms(120000)]
test "a group in a left-recursive suffix takes the simulator's pick" {
    let g4 = |suffix: String| `grammar F2;
s : e EOF ;
e : e '.' ${suffix} | ID ;
a : A ;
A : 'a' ; B : 'b' ; ID : [x-z]+ ;
WS : ' ' -> skip ;
`;
    let tree = "x . a b => (s (e (e x) . (a a) b))\n";
    assert parses(g4("({true}? a | a B) B"), "s", ["x . a b"]) == tree;
    assert parses(g4("(a | a B) B"), "s", ["x . a b"]) == tree;
    let verify = gen_with(g4("(a | a B) B?"), &GenerateOptions { prediction: PredictionMode::Verify }).source;
    let out = eval_beside(verify, wado`show("x . a b", parse_s("x . a b"));\n`, SHOW_FN);
    assert out.stderr.contains(": the tournament picks 1, the simulator 0"), out.stderr;
}

// `x` matches empty, so entering it consumes nothing, but it still adds a node.
// The trees are the jar's.
#[timeout_ms(120000)]
test "verify takes an optional entered through an empty rule as entered" {
    let g4 = "grammar F5;
s : x? 'z' EOF ;
x : 'c'? ;
WS : ' ' -> skip ;
";
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify] {
        assert parses(g4, "s", ["z", "c z"], &GenerateOptions { prediction }) == "z => (s x z)\nc z => (s (x c) z)\n";
    }
}

#[timeout_ms(60000)]
test "a loop the simulator decides stops at the end of the input" {
    let g4 = "grammar L;
@parser::members {
boolean pred() { return true; }
}
s : '{' l '}' st* EOF ;
l : st+ ;
st : {this.pred()}? 'a' 'b' | 'c' ;
WS : ' ' -> skip ;
";
    for let prediction of [PredictionMode::Longest, PredictionMode::Exact] {
        let got = parses(g4, "s", ["{ a", "{ c", "{ c } c", "{ a c"], &GenerateOptions { prediction });
        assert got == "{ a => error\n{ c => error\n{ c } c => (s { (l (st c)) } (st c))\n{ a c => error\n";
    }
}

test "a left-recursive rule runs @after once per invocation, after its whole climb" {
    let got = parses("grammar T;
s : e EOF ;
e
@after { System.out.print(\"done;\"); }
  : e '+' e | INT ;
INT : [0-9]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["1", "1+2+3"]);
    assert got == "1 => (s (e 1)) [done;]\n1+2+3 => (s (e (e (e 1) + (e 2)) + (e 3))) [done;done;done;]\n";
}

test "a left-recursive rule's @after reads the value its whole climb computed" {
    let got = parses("grammar T;
options { language = Wado; }
s : x=e { p.emit(`v=${$x.v} `); } ;
e returns [i32 v]
    @init { $v = 1000; }
    @after { p.emit(`[after=${$v}]`); }
    : l=e '+' r=e { $v = $l.v + $r.v; }
    | n=INT { $v = $n.int + $v; }
    ;
INT : [0-9]+ ;
WS : ' ' -> skip ;
", "s", ["5", "5 + 3"]);
    assert got == "5 => (s (e 5)) [[after=1005]v=1005 ]\n5 + 3 => (s (e (e 5) + (e 3))) [[after=1003][after=2008]v=2008 ]\n";
}

test "a group in a left-recursive suffix picks the longest of its overlapping alternatives" {
    let got = parses("grammar T;
s : e EOF ;
e : e '.' (ID '(' ')' | ID | ID '[' ']' | '*')
  | ID ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["a.b()", "a.b", "a.b[]", "a.*", "a.b.c().d[].*"]);
    assert got == "a.b() => (s (e (e a) . b ( )))
a.b => (s (e (e a) . b))
a.b[] => (s (e (e a) . b [ ]))
a.* => (s (e (e a) . *))
a.b.c().d[].* => (s (e (e (e (e (e a) . b) . c ( )) . d [ ]) . *))
";
}

test "a decided group loop leaves its rule the tail it needs" {
    let got = parses("grammar T;
start : body EOF ;
body : (A Z | B Y)* A Z ;
A : 'a' ; B : 'b' ; X : 'x' ; Y : 'y' ; Z : 'z' ;
WS : [ \\t]+ -> skip ;
", "start", ["a z a z", "b y a z", "a z a z a z", "a z"]);
    assert got == "a z a z => (start (body a z a z))
b y a z => (start (body b y a z))
a z a z a z => (start (body a z a z a z))
a z => (start (body a z))
";
}

test "a scanned loop over a complement stops at the excluded tokens" {
    let got = parses("grammar T;
s : (a | b) EOF ;
a : '(' (~')')* ')' 'x' ;
b : '(' (~(')' | ';'))* ')' 'y' ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["(a b)x", "(a;b)x", "(a b)y", "()y", "(a;b)y"]);
    assert got == "(a b)x => (s (a ( a b ) x))
(a;b)x => (s (a ( a ; b ) x))
(a b)y => (s (b ( a b ) y))
()y => (s (b ( ) y))
(a;b)y => error
";
}

test "a list label outside a loop takes a token and a set" {
    let got = parses("grammar T;
s : xs+=ID ',' xs+=ID ys+=(A | B) ys+=(A | B) EOF ;
A : '+' ; B : '-' ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["a,b+-", "a,b"]);
    assert got == "a,b+- => (s a , b + -)\na,b => error\n";
}

test "left-recursive suffixes sharing an operator split on the token after it" {
    let got = parses("grammar T;
s : e EOF ;
e : e ('+' | '-') e | e ('+' '+') | ID ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["a + b", "a + +", "a + + - b", "a - b + +"]);
    assert got == "a + b => (s (e (e a) + (e b)))
a + + => (s (e (e a) + +))
a + + - b => (s (e (e (e a) + +) - (e b)))
a - b + + => (s (e (e (e a) - (e b)) + +))
";
}

test "a group undecided past the static lookahead depth asks the runtime ATN" {
    let got = parses("grammar T;
s : 'k' ( A A A A A A B | A A A A A A C ) EOF ;
A : 'a' ; B : 'b' ; C : 'c' ;
WS : [ \\t]+ -> skip ;
", "s", ["k a a a a a a b", "k a a a a a a c", "k a a a a a a a"]);
    assert got == "k a a a a a a b => (s k a a a a a a b)
k a a a a a a c => (s k a a a a a a c)
k a a a a a a a => error
";
}

test "prediction follows a loop body back out to the token after the loop" {
    let got = parses("grammar T;
s : a EOF ;
a : ('x' 'y')* 'z' | ('x' 'y')* 'w' ;
WS : [ \\t]+ -> skip ;
", "s", ["x y z", "x y x y w", "w", "x y"]);
    assert got == "x y z => (s (a x y z))\nx y x y w => (s (a x y x y w))\nw => (s (a w))\nx y => error\n";
}

// `xt` and its twins have `'a' 'b'` prefixing `'a' 'b' 'c'`, which the runtime
// ATN decides; an alt-initial predicate removes its alternative from the seed set.
test "a predicate at an ATN-routed decision disables its alternative" {
    let got = parses_each("grammar T;
options { language = Wado; }
takes : xt 'c' ;
xt : 'a' 'b' { p.emit(\"ab\"); }
   | { true }? 'a' 'b' 'c' { p.emit(\"abc\"); }
   ;
rejects : xr 'c' ;
xr : 'a' 'b' { p.emit(\"ab\"); }
   | { false }? 'a' 'b' 'c' { p.emit(\"abc\"); }
   ;
ctxkeep : ck 'c' ;
ck returns [i32 mode] @init { $mode = 1; }
   : 'a' 'b' { p.emit(\"ab\"); }
   | { $mode == 1 }? 'a' 'b' 'c' { p.emit(\"abc\"); }
   ;
ctxdrop : cd 'c' ;
cd returns [i32 mode] @init { $mode = 1; }
   : 'a' 'b' { p.emit(\"ab\"); }
   | { $mode == 0 }? 'a' 'b' 'c' { p.emit(\"abc\"); }
   ;
allfalse : af 'c' ;
af : { false }? 'a' 'b' { p.emit(\"ab\"); }
   | { false }? 'a' 'b' 'c' { p.emit(\"abc\"); }
   ;
scanned : xg 'c'? 'k'* 'x' { p.emit(\"x\"); }
        | xg 'c'? 'k'* 'y' { p.emit(\"y\"); }
        ;
xg : { false }? 'a' 'b' { p.emit(\"ab\"); }
   | 'a' 'b' 'c' { p.emit(\"abc\"); }
   ;
WS : ' ' -> skip ;
", [
        ["takes", "abcc"],
        ["rejects", "abc"],
        ["ctxkeep", "abcc"],
        ["ctxdrop", "abc"],
        ["allfalse", "abcc"],
        ["scanned", "abckx"],
        ["scanned", "abcky"],
    ]);
    assert got == "abcc => (takes (xt a b c) c) [abc]
abc => (rejects (xr a b) c) [ab]
abcc => (ctxkeep (ck a b c) c) [abc]
abc => (ctxdrop (cd a b) c) [ab]
abcc => error
abckx => (scanned (xg a b c) k x) [abcx]
abcky => (scanned (xg a b c) k y) [abcy]
";
}

test "a let chain after a simulated operand leaves its `&&` to the chain" {
    let got = parses("grammar T;
s : 'match' ID '{' arm* '}' EOF ;
arm : ID guard? '=>' '{' '}' ;
guard : 'if' 'let' ID '=' e tail* | 'if' e tail* ;
tail : '&&' 'let' ID '=' e ;
e : e '&&' e
  | e '.' ID
  | p '!'
  | p
  ;
p : ID ('::' ID)* ;
ID : [a-zA-Z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["match x { a if b && let q = c => {} }", "match x { a if b && c => {} }"]);
    assert got == "match x { a if b && let q = c => {} } => (s match x { (arm a (guard if (e (p b)) (tail && let q = (e (p c)))) => { }) })
match x { a if b && c => {} } => (s match x { (arm a (guard if (e (e (p b)) && (e (p c)))) => { }) })
";
}

// `x`'s first alternative opens with `g`, whose predicate prediction meets
// before any token, so it decides `x` as one written on the alternative does.
test "a predicate at the left edge of an invoked rule gates an ATN-routed decision" {
    let got = parses_each("grammar T;
options { language = Wado; }
off : x 'c'* EOF ;
x : g 'b'
  | 'a' 'b' 'c'
  ;
g : { false }? 'a' ;
on : y 'c'* EOF ;
y : h 'b'
  | 'a' 'b' 'c'
  ;
h : { true }? 'a' ;
WS : ' ' -> skip ;
", [
        ["off", "abc"],
        ["on", "abc"],
    ]);
    assert got == "abc => (off (x a b c))\nabc => (on (y (h a) b) c)\n";
}

test "a non-greedy loop in a left-recursive suffix stops where the rest of the suffix matches" {
    let got = parses("grammar T;
s : e EOF ;
e : e '<' ID*? ID '>' | e '(' ID+? ID ')' | ID ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;
", "s", ["x<a b c>", "x<a>", "x(a b)", "x(a)", "x<>"]);
    assert got == "x<a b c> => (s (e (e x) < a b c >))
x<a> => (s (e (e x) < a >))
x(a b) => (s (e (e x) ( a b )))
x(a) => error
x<> => error
";
}

test "a group of rule calls undecided past the static lookahead depth asks the runtime ATN, in the parse and the scan" {
    let got = parses("grammar T;
s : r 'x' EOF | r 'y' EOF ;
r : 'k' ( a | b ) ;
a : A A A A A A B ;
b : A A A A A A C ;
A : 'a' ; B : 'b' ; C : 'c' ;
WS : [ \\t]+ -> skip ;
", "s", ["k a a a a a a b x", "k a a a a a a c y", "k a a a a a a a x"]);
    assert got == "k a a a a a a b x => (s (r k (a a a a a a a b)) x)
k a a a a a a c y => (s (r k (b a a a a a a c)) y)
k a a a a a a a x => error
";
}

/// `show_with(ok, input)` shows `parse_s(input)` under a `PBase` whose `ok()`
/// answers `ok`.
global SHOW_WITH_PBASE: String = `${SHOW_FN}
struct Allow {
    ok: bool,
}

impl PBase for Allow {
    fn ok(&self, p: &Parser) -> bool {
        resume self.ok;
    }
}

fn show_with(ok: bool, input: String) with Stdout {
    let mut base = Allow { ok };
    with PBase => &mut base do {
        show(\`\${ok} \${input}\`, parse_s(input));
    };
}
`;

test "a Java grammar's parser base call gates an alternative inside a loop" {
    let got = printed("grammar T;
options { superClass = PBase; }
s : ( {this.ok()}? A | B )* EOF ;
A : 'a' ; B : 'b' ;
", "show_with(true, \"ab\");\nshow_with(false, \"ab\");\nshow_with(false, \"b\");\n", SHOW_WITH_PBASE);
    assert got == "true ab => (s a b)\nfalse ab => error\nfalse b => (s b)\n";
}

test "a negative offset to `_input.LT` and `_input.LA` counts back from the last consumed token" {
    let got = parses(
        "grammar T;
s : A {System.out.println(_input.LA(-1) != _input.LA(1));} B {System.out.println(_input.LT(-1).getText() + _input.LT(-2).getText());} EOF ;
A : 'a' ; B : 'b' ;
",
        "s",
        ["ab"],
    );
    assert got == "ab => (s a b) [true\nba\n]\n";
}

test "a diagnostic names a literal-alias token by its literal, whether it was missing or expected" {
    let got = printed("grammar T;
s : A LB B EOF | B (LB | RB) EOF ;
A : 'a' ; B : 'b' ; LB : '{' ; RB : '}' ;
", "for let input of [\"ab\", \"bb\"] {
    for let d of &parse(input).diagnostics { println(d.message); }
}
");
    assert got == "missing '{'\nexpected '{' or '}'; no viable alternative\n";
}

test "past a shared first token, the next tokens pick the alternative through groups, loops, labels, optionals, sets and rule calls" {
    let got = parses_each("grammar T;
r : A (B|C) D EOF | A (B|C) E EOF ;
s : A B+ C EOF | A B+ D EOF ;
t : A x=B C EOF | A y=B D EOF ;
u : A B? C? D EOF | A B? C? E EOF ;
v : A ~B C EOF | A ~B D EOF ;
w : A ~B C EOF | A D E EOF ;
p : x EOF | y EOF ;
x : A (B | C) C? ;
y : A D ;
q : 'k' A EOF | 'k'* B EOF ;
m : A B X C EOF | A B X D EOF | A E X C EOF | A E X D EOF ;
A : 'a' ; B : 'b' ; C : 'c' ; D : 'd' ; E : 'e' ; X : 'x' ;
", [
        ["r", "acd"],
        ["r", "abe"],
        ["s", "abbc"],
        ["s", "abd"],
        ["t", "abc"],
        ["t", "abd"],
        ["u", "abce"],
        ["u", "ace"],
        ["u", "ad"],
        ["v", "acc"],
        ["v", "aad"],
        ["v", "acd"],
        ["w", "acc"],
        ["w", "adc"],
        ["w", "ade"],
        ["w", "aac"],
        ["p", "ab"],
        ["p", "abc"],
        ["p", "ad"],
        ["p", "acc"],
        ["q", "ka"],
        ["q", "kkb"],
        ["q", "b"],
        ["q", "k"],
        ["m", "abxd"],
        ["m", "aexc"],
    ]);
    assert got == "acd => (r a c d)
abe => (r a b e)
abbc => (s a b b c)
abd => (s a b d)
abc => (t a b c)
abd => (t a b d)
abce => (u a b c e)
ace => (u a c e)
ad => (u a d)
acc => (v a c c)
aad => (v a a d)
acd => (v a c d)
acc => (w a c c)
adc => (w a d c)
ade => (w a d e)
aac => (w a a c)
ab => (p (x a b))
abc => (p (x a b c))
ad => (p (y a d))
acc => (p (x a c c))
ka => (q k a)
kkb => (q k k b)
b => (q b)
k => error
abxd => (m a b x d)
aexc => (m a e x c)
";
}

test "a lexer base predicate gates its alternative inside a group, a loop and a fragment" {
    let items = `${SHOW_TOKENS_FN}
struct Gate {
    on: bool,
}

impl B for Gate {
    fn ok(&self, view: LexerView) -> bool {
        resume self.on;
    }
}

fn lex_with(on: bool, input: String) with Stdout {
    let mut base = Gate { on };
    with B => &mut base do {
        show_tokens(\`\${on}\`, &tokenize(input));
    };
}
`;
    let got = printed("lexer grammar L;
options { superClass = B; language = Wado; }
KW : ( { this.ok() }? 'ab' | 'xy' ) ;
NUM : ( { this.ok() }? '1' )+ ;
FR : 'q' G ;
fragment G : { this.ok() }? 'z' ;
ID : [a-z]+ ;
INT : [0-9]+ ;
WS : ' ' -> skip ;
", "lex_with(true, \"ab xy 11 qz\");\nlex_with(false, \"ab xy 11 qz\");\n", items);
    assert got == "true => KW:ab KW:xy NUM:11 FR:qz
false => ID:ab KW:xy INT:11 ID:qz
";
}

test "a greedy loop keeps a token its caller could also take, entered directly or not" {
    // `;` follows `list` inside `s`, so it is in `list`'s FOLLOW, but the loop
    // is greedy: the jar takes it into the loop whichever rule the parse
    // entered, as css3's `declarationList` must for a `style` attribute.
    let got = parses_each("grammar T;
s : '{' (list | ';')* '}' ;
list : X (';' X?)* ;
X : 'x' ;
WS : ' ' -> skip ;
", [
        ["list", "x;x"],
        ["list", "x;"],
        ["s", "{x;x}"],
        ["s", "{x;;x}"],
    ]);
    assert got == "x;x => (list x ; x)\nx; => (list x ;)\n{x;x} => (s { (list x ; x) })\n{x;;x} => (s { (list x ; ; x) })\n";
}

global CALLER_ENDS_INPUT_G4: String = "grammar T;
s : (list) ';' EOF ;
t : list ';' EOF ;
list : X (';' X?)* ;
X : 'x' ;
WS : ' ' -> skip ;
";

test "a greedy loop leaves its last token to a caller that ends the input with it" {
    // The twin of the test above: here `list ;` ends the input, so the jar
    // exits the loop whether the parse entered `list` directly or called it
    // with no continuation (`s`) or with one (`t`).
    let got = parses_each(CALLER_ENDS_INPUT_G4, [
        ["s", "x;"],
        ["t", "x;"],
        ["list", "x;"],
        ["s", "x;x;"],
    ], &LONGEST);
    assert got == "x; => (s (list x) ;)\nx; => (t (list x) ;)\nx; => (list x)\nx;x; => (s (list x ; x) ;)\n";
}

// Where a parse enters a rule directly, the jar reads what follows it as what
// follows each call of it, through callers that are themselves called.
test "exact reads a directly entered rule's end as the jar does" {
    let got = parses_each(CALLER_ENDS_INPUT_G4, [
        ["list", "x;"],
        ["list", "x;;"],
    ]);
    assert got == "x; => (list x)\nx;; => (list x ;)\n";
    let chained = parses_each("grammar U;
s : a 'q' EOF ;
t : b ';' EOF ;
b : a ;
a : X (';' X?)* ;
X : 'x' ;
WS : ' ' -> skip ;
", [
        ["a", "x;"],
        ["a", "x;;"],
        ["a", "x;q"],
    ]);
    assert chained == "x; => (a x)\nx;; => (a x ;)\nx;q => (a x ;)\n";
}

test "an entered rule's end reads through a caller no rule calls to the end of the input" {
    // `u` is neither the first rule nor called, and the jar ends it where the
    // input ends: `x;` exits `t`'s loop for `u`'s `;`, `x;;` cannot.
    let got = parses_each("grammar U;
s : X ;
t : X (';' X?)* ;
u : t ';' ;
X : 'x' ;
", [
        ["t", "x;"],
        ["t", "x;;"],
    ], &LONGEST);
    assert got == "x; => (t x)\nx;; => (t x ;)\n";
}

test "the first rule, entered, reads on into the rule that calls it" {
    // Being first gives `s` no end of its own: the jar exits its loop for `u`'s
    // `;` as it does for any called rule.
    let got = parses_each("grammar R;
s : X (';' X?)* ;
u : s ';' ;
X : 'x' ;
", [
        ["s", "x;"],
        ["s", "x;;"],
    ], &LONGEST);
    assert got == "x; => (s x)\nx;; => (s x ;)\n";
}

test "an entered rule only a call cycle reaches still ends at the end of the input" {
    // `a` and `b` call only each other, so no caller reads past the cycle; the
    // jar still ends the entered `a` where the input ends.
    let got = parses_each("grammar C;
s : X ;
a : Y b? Z* ;
b : Z a ;
X : 'x' ; Y : 'y' ; Z : 'z' ;
WS : ' ' -> skip ;
", [
        ["a", "y z"],
        ["a", "y z y"],
        ["a", "y z y z"],
        ["a", "y z y z z"],
    ], &LONGEST);
    assert got == "y z => (a y z)\ny z y => (a y (b z (a y)))\ny z y z => (a y (b z (a y z)))\ny z y z z => (a y (b z (a y z z)))\n";
}

test "a loop the caller's continuation may start keeps looping where the iteration parses" {
    // `;` starts both another iteration of `l`'s loop and the next `l` in `s`.
    // The jar loops wherever the iteration parses, and the parse tries the
    // iteration itself rather than scanning it first and parsing it again.
    let grammar = "grammar L;
s : l* EOF ;
l : ';'* x (';'+ x)* ';'* ;
x : X | X '(' X ')' ;
X : [a-z]+ ;
WS : ' ' -> skip ;
";
    let got = parses(grammar, "s", ["a;b", "a;;b;", "a;", "a(b);c;;", ";a;b(c)"], &LONGEST);
    assert got == "a;b => (s (l (x a) ; (x b)))\na;;b; => (s (l (x a) ; ; (x b) ;))\na; => (s (l (x a) ;))\na(b);c;; => (s (l (x a ( b )) ; (x c) ; ;))\n;a;b(c) => (s (l ; (x a) ; (x b ( c ))))\n";
    let source = longest_source(grammar);
    assert source.contains("let sp_yielded = follow_yields(");
    assert !source.contains("iter_scan");
}

// `expression` calls only itself, so every continuation past its end comes
// back to it, and none reads the end of the input.
test "exact ends a directly entered rule that only calls itself at the end of the input" {
    let got = parses_each("grammar L;
expression
    : NOT expression
    | expression (AND expression)+
    | expression (OR expression)+
    | IDENTIFIER
    ;
AND : 'and' ;
OR : 'or' ;
NOT : 'not' ;
IDENTIFIER : [a-zA-Z_][a-zA-Z0-9_]* ;
WS : [ \\t\\r\\n]+ -> skip ;
", [
        ["expression", "a and b"],
        ["expression", "not a or b"],
        ["expression", "a"],
    ]);
    assert got == "a and b => (expression (expression a) and (expression b))\nnot a or b => (expression (expression not (expression a)) or (expression b))\na => (expression a)\n";
}

test "a loop whose first token no alternative takes is left to the recovery after it" {
    // The jar reports such a token where it syncs before the loop, not as a
    // no-viable-alternative at it. A fragment's first token passes that sync,
    // so the loop must decline it for the fragment to be reached.
    let src = gen_with("grammar P;
s : inner* outer* EOF ;
inner : H '!' A ;
outer : H B ;
stmt : Q E ;
A : 'a' ; B : 'b' ; E : 'e' ; H : '#' ; Q : 'q' ;
WS : ' ' -> skip ;
", &GenerateOptions {
        fragment_entries: ["stmt"],
    }).source;
    let got = run_beside(src, "let r = parse(\"q e\");
println(`${to_string_tree(&r)} ${r.diagnostics[0].code:?}`);
").stdout;
    assert got == "(s (<error> (stmt q e))) DiagnosticCode::UnexpectedToken\n";
}

test "a simulator walk that dies picks the alternative that finished the rule, or none" {
    // Each decision reads past depth 5, so exact asks the simulator. The jar:
    // `x` takes its second alternative, which had ended `x`, and `s` reports
    // the `c`. Under `q`, `r`, `o`, `p`, `t` and `n` no alternative had ended
    // its rule, so the decision itself is a no-viable-alternative, a loop's
    // (non-greedy too) or a `?`'s as much as a group's.
    let grammar = "grammar F;
s : x E EOF
  | 'q' ( A A A A A A B | A A A A A A C ) EOF
  | 'r' ( A A A A A A B | A A A A A A C )* E EOF
  | 'o' ( A A A A A A B )? A A A A A A C E EOF
  | 'p' ( A A A A A A B | A A A A A A C )+ E EOF
  | 't' ( A A A A A A B )* A A A A A A C E EOF
  | 'n' ( A A A A A A B )*? A A A A A A C E EOF
  ;
x : A A A A A A B | A A A A A A ;
A : 'a' ; B : 'b' ; C : 'c' ; E : 'e' ;
WS : ' ' -> skip ;
";
    let body = wado`for let input of ["a a a a a a c", "q a a a a a a e", "r a a a a a a e", "o a a a a a a e", "p a a a a a a b a a a a a a e", "p a a a a a a e", "t a a a a a a e", "n a a a a a a e"] {
    let r = parse_s(input);
    println(\`\${to_string_tree(&r)} \${r.diagnostics[0].code:?}\`);
}
`;
    let got = run_beside(gen_source(grammar), body).stdout;
    let lines: List<String> = got.split("\n").map(|l| l.to_string()).collect();
    let skipped = "<skip a> <skip a> <skip a> <skip a> <skip a> <skip a> <skip e>";
    let mut want: List<String> = [
        "(s (x a a a a a a) (<error> <skip c>) <missing 'e'>) DiagnosticCode::UnexpectedToken",
    ];
    for let parsed of ["q", "r", "o", "p a a a a a a b", "p", "t", "n"] {
        want.push(`(s ${parsed} ${skipped}) DiagnosticCode::NoViableAlternative`);
    }
    for let i of 0..<want.len() {
        assert lines[i] == want[i], lines[i];
    }
}

test "a greedy loop leaves a longer last iteration to a caller that ends the input with it" {
    // `x y` ends the input after `list` in `s` and `t` but not in `u`, so the
    // jar exits the loop wherever those rules call `list`, and keeps the
    // iteration where `u` alone does.
    let ends = parses_each("grammar M;
s : (list) X Y EOF ;
t : list X Y EOF ;
list : A (X Y)* ;
A : 'a' ;
X : 'x' ;
Y : 'y' ;
WS : ' ' -> skip ;
", [
        ["s", "a x y"],
        ["t", "a x y"],
        ["list", "a x y"],
    ], &LONGEST);
    assert ends == "a x y => (s (list a) x y)\na x y => (t (list a) x y)\na x y => (list a)\n";
    let goes_on = parses("grammar N;
u : '{' (list | X Y)* '}' ;
list : A (X Y)* ;
A : 'a' ;
X : 'x' ;
Y : 'y' ;
WS : ' ' -> skip ;
", "list", ["a x y"]);
    assert goes_on == "a x y => (list a x y)\n";
}

test "a single-token optional EOF does not outrank an earlier alternative" {
    // The optional's step is the guard's, so it must leave EOF to `prog` as
    // every other scanned EOF does.
    let got = parses("grammar V;
prog : stmt EOF ;
stmt : decl | exprStmt ;
decl : X Y ;
exprStmt : X Y EOF? ;
X : 'x' ;
Y : 'y' ;
WS : ' ' -> skip ;
", "prog", ["x y"]);
    assert got == "x y => (prog (stmt (decl x y)))\n";
}

test "an alternative that also matches EOF does not outrank an earlier one covering the same input" {
    // JavaScript's `statement` shape: a declaration is also an expression
    // statement, whose `eos` takes EOF. Both cover the whole input, so the jar
    // takes the first.
    let got = parses("grammar T;
prog : stmt* EOF ;
stmt : decl | exprStmt ;
decl : 'function' ID '(' ')' block ;
exprStmt : expr eos ;
eos : ';' | EOF ;
expr : fn | ID | expr '(' ')' ;
fn : decl | 'function' '(' ')' block | ID '=>' expr ;
block : '{' stmt* '}' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
", "prog", ["function f() {}", "function f() {} x;"]);
    assert got == "function f() {} => (prog (stmt (decl function f ( ) (block { }))))\nfunction f() {} x; => (prog (stmt (decl function f ( ) (block { }))) (stmt (exprStmt (expr x) (eos ;))))\n";
}

test "unclosed elements scan in time linear in their number" {
    // Each `<a>`'s optional scans the rest of the input as its content, and
    // fails at the end; without a memo every element repeats that for each
    // element after it, which doubles per element.
    let mut input = "";
    let mut tree = "(s (c";
    for let _ of 0..<40 {
        input.push_str("<a> x ");
        tree.push_str(" (e < a >) x");
    }
    let got = parses("grammar T;
s : c EOF ;
c : (e | ID)* ;
e : '<' ID '>' (c '<' '/' ID '>')? ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
", "s", [input]);
    assert got == `${input} => ${tree}))\n`;
}

test "an optional group yields a token its continuation needs" {
    let got = parses("grammar T;
s : (S | ID)? m ;
m : ID '(' ')' ;
S : 'static' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
", "s", ["f()", "g f()", "static f()"]);
    assert got == "f() => (s (m f ( )))\ng f() => (s g (m f ( )))\nstatic f() => (s static (m f ( )))\n";
}

test "a false predicate in an optional prefix skips the prefix rather than the alternative" {
    // JavaScript's `classElement`: `static` is an identifier the predicate
    // recognises by its text, so `f()` is a method with no prefix at all. The
    // jar asks the predicate only where the tokens leave both paths open.
    let got = printed(
        "grammar T;
options { superClass = PBase; }
s : (S | {this.ok()}? ID)? m | ';' ;
m : ID '(' ')' ;
S : 'static' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
",
        "show_with(false, \"f()\");\nshow_with(true, \"f()\");\nshow_with(true, \"g f()\");\nshow_with(false, \"g f()\");\n",
        SHOW_WITH_PBASE,
    );
    assert got == "false f() => (s (m f ( )))\ntrue f() => (s (m f ( )))\ntrue g f() => (s g (m f ( )))\nfalse g f() => error\n";
}

test "a parser base call gates alternatives whose first tokens tie" {
    // Prediction cannot pick between `a` and `b` by tokens, so the predicate is
    // a standalone fn; its body must be the rewritten base call, not `this`.
    let got = printed("grammar T;
options { superClass = PBase; }
s : {this.ok()}? a | b ;
a : X ;
b : X ;
X : 'x' ;
", "show_with(true, \"x\");\nshow_with(false, \"x\");\n", SHOW_WITH_PBASE);
    assert got == "true x => (s (a x))\nfalse x => (s (b x))\n";
}

test "a parser base decides the tree a superClass grammar's highlighter walks" {
    let options = GenerateOptions { highlight_query: Option::Some(parse_highlight_query(
        "(a (X) @keyword)\n(b (X) @string)",
    ).unwrap()) };
    let out = gen_with("grammar T;
options { superClass = PBase; }
s : {this.ok()}? a | b ;
a : X ;
b : X ;
X : 'x' ;
", &options);
    let items = "struct Allow {
    ok: bool,
}

impl PBase for Allow {
    fn ok(&self, p: &Parser) -> bool {
        resume self.ok;
    }
}

fn highlight_with(ok: bool) with Stdout {
    let mut base = Allow { ok };
    with PBase => &mut base do {
        println(highlight(\"x\"));
    };
}
";
    let got = run_beside(out.source, "highlight_with(true);\nhighlight_with(false);\n", items).stdout;
    assert got == "<span class=\"keyword\">x</span>\n<span class=\"string\">x</span>\n";
}

test "a lexer base decides the tokens a lexer grammar's highlighter classifies" {
    let options = GenerateOptions { highlight_query: Option::Some(parse_highlight_query("(KW) @keyword").unwrap()) };
    let out = gen_with("lexer grammar L;
options { superClass = B; }
KW : {this.ok()}? 'ab' ;
ID : [a-z]+ ;
", &options);
    let items = "struct Gate {
    on: bool,
}

impl B for Gate {
    fn ok(&self, view: LexerView) -> bool {
        resume self.on;
    }
}

fn highlight_with(on: bool) with Stdout {
    let mut base = Gate { on };
    with B => &mut base do {
        println(highlight(\"ab\"));
    };
}
";
    let got = run_beside(out.source, "highlight_with(true);\nhighlight_with(false);\n", items).stdout;
    assert got == "<span class=\"keyword\">ab</span>\nab\n";
}

test "a parser base call runs in a grammar whose action language has no translator" {
    let got = printed("grammar T;
options { superClass = PBase; language = Cpp; }
s : {this.ok()}? A | B ;
A : 'a' ; B : 'b' ;
", "show_with(true, \"a\");\nshow_with(false, \"a\");\nshow_with(false, \"b\");\n", SHOW_WITH_PBASE);
    assert got == "true a => (s a)\nfalse a => error\nfalse b => (s b)\n";
}

test "a parser base is refused where an untranslatable @init carries host code" {
    let out = gen("grammar T;
options { superClass = PBase; language = Cpp; }
s @init { int n = 0; } : {this.ok()}? A | B ;
A : 'a' ; B : 'b' ;
");
    let refusal = "superClass 'PBase' is called from a body carrying host code the grammar's action language has no translator for";
    assert diagnostics_saying(&out, refusal) == 1, "the refused base must be reported";
    assert !out.source.contains("interface PBase"), "no interface is emitted for a refused base";
}

test "a caller argument holding a quoted comma is one argument, in Java and in Wado" {
    let in_java = parses("grammar T;
s : e[\"x,y\", 2] EOF ;
e[String t, int n] : ID { System.out.print($t); System.out.print($n); } ;
ID : [a-z]+ ;
", "s", ["a"]);
    assert in_java == "a => (s (e a)) [x,y2]\n";
    let in_wado = parses("grammar T;
options { language = Wado; }
s : e[\"x,y\", 2] EOF ;
e[String t, i32 n] : ID { p.emit(`${$t}${$n}`); } ;
ID : [a-z]+ ;
", "s", ["a"]);
    assert in_wado == "a => (s (e a)) [x,y2]\n";
}

test "a Java action concatenating a string and an int prints both" {
    let got = parses("grammar T;
s : e[\"x\", 2] EOF ;
e[String t, int n] : ID { System.out.print($t + $n); } ;
ID : [a-z]+ ;
", "s", ["a"]);
    assert got == "a => (s (e a)) [x2]\n";
}

test "a Java action steps a member field declared without an initializer" {
    let got = parses("grammar T;
@members { int n; }
s : (ID { n++; })+ EOF { System.out.print(n); } ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
", "s", ["a b c"]);
    assert got == "a b c => (s a b c) [3]\n";
}

test "list labels on left-recursive operands keep each operand's precedence" {
    let got = parses("grammar T;
s : e EOF ;
e : e '(' (xs+=e (',' xs+=e)*)? ')'
  | e '*' ys+=e
  | ys+=e '+' e
  | '-' ys+=e
  | <assoc=right> e '?' ys+=e ':' e
  | ID
  ;
ID : [a-z]+ ;
", "s", ["f(a,b)", "a+b*c", "-a+b", "a?b:c+d", "f(a+b)", "a?b?c:d:e", "-f(a)"]);
    assert got == "f(a,b) => (s (e (e f) ( (e a) , (e b) )))
a+b*c => (s (e (e a) + (e (e b) * (e c))))
-a+b => (s (e - (e (e a) + (e b))))
a?b:c+d => (s (e (e a) ? (e b) : (e (e c) + (e d))))
f(a+b) => (s (e (e f) ( (e (e a) + (e b)) )))
a?b?c:d:e => (s (e (e a) ? (e (e b) ? (e c) : (e d)) : (e e)))
-f(a) => (s (e - (e (e f) ( (e a) ))))
";
}

// The left operand binds the label before the suffix rebinds it, so the
// predicate between reads the left operand.
test "a left-recursive alternative reusing its operand label reads the left operand first" {
    let g4 = "grammar L;
s : e EOF {System.out.println($e.v);} ;
e returns [int v] : a=e '+' {$a.v < 5}? a=e {$v = $a.v + 100;} | INT {$v = $INT.int;} ;
INT : [0-9]+ ;
WS : ' ' -> skip ;
";
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        assert parses(g4, "s", ["1 + 2", "7 + 2", "1 + 2 + 3"], &GenerateOptions { prediction }) == "1 + 2 => (s (e (e 1) + (e 2))) [102\n]
7 + 2 => error [0\n]
1 + 2 + 3 => error [0\n]
";
    }
    let text = "grammar M;
s : e EOF ;
e : a=e '+' {$a.text.equals(\"1\")}? a=e {System.out.println($a.text);} | INT ;
INT : [0-9]+ ;
WS : ' ' -> skip ;
";
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        assert parses(text, "s", ["1 + 2", "7 + 2", "1 + 2 + 3"], &GenerateOptions { prediction }) == "1 + 2 => (s (e (e 1) + (e 2))) [2\n]
7 + 2 => error
1 + 2 + 3 => error [2\n]
";
    }
}

test "an action reads the text of a left-recursive alternative's left operand" {
    let got = parses("grammar N;
s : e EOF ;
e : a=e '+' b=e {System.out.println($a.text + \" \" + $a.ctx.toStringTree(this));} | INT ;
INT : [0-9]+ ;
WS : ' ' -> skip ;
", "s", ["1 + 2 + 3"]);
    assert got == "1 + 2 + 3 => (s (e (e (e 1) + (e 2)) + (e 3))) [1 (e 1)\n1+2 (e (e 1) + (e 2))\n]\n";
}

test "a label on a negated token or set binds the token it matched" {
    let got = parses("grammar T;
s : x=~A y=~(A|B) z=. EOF { System.out.print($x.text + $y.text + $z.text); } ;
A : 'a' ; B : 'b' ; C : 'c' ;
", "s", ["ccc", "cca"]);
    assert got == "ccc => (s c c c) [ccc]\ncca => (s c c a) [cca]\n";
}

// A label belongs to the whole alternative, as a field of ANTLR4's context does:
// one bound inside a group, an optional or a loop reads as null where it did not
// match, and the last binding wins.
test "an action reads a label bound anywhere in its alternative" {
    let g4 = "grammar T;
s : 'A' r1 EOF | 'B' r2 EOF | 'C' r3 EOF | 'D' r4 EOF | 'E' r5 EOF | 'F' r6 EOF
  | 'G' r7 EOF | 'H' r8 EOF | 'I' r9 EOF | 'J' r10 EOF | 'K' r11 EOF | 'L' r12 EOF | 'M' r13 EOF
  | 'N' r14 EOF | 'O' r15 EOF | 'P' r16 EOF | 'Q' r17 EOF | 'R' r18 EOF | 'S' r19 EOF ;
r1 : x='-'? {$x == null}? 'a' | '-' 'a' 'b' ;
r12 : x='-'? {$x == null}? 'a' | '-' 'a' ;
r13 : ( x='-'? {$x == null}? 'a' | '-' 'a' ) {System.out.println(\"r13 \" + $x.text);} ;
r14 : {$x != null}? x='-' 'a' | '-' 'a' 'b' | '-' ;
r15 : ('a' 'b' 'c' 'd' 'e' 'f')? z=w {!\"z\".equals($z.text)}? 'a' 'b' 'c' 'd' 'e' 'g' ;
r16 : (y=q)? 'a' {System.out.println(\"r16 \" + $y.ctx);} ;
r17 : (x=('b'|'c'))? 'a' {System.out.println(\"r17 \" + $x.text);} ;
r18 @after {System.out.println(\"r18 \" + $y.v);} : (y=q)? 'a' ;
r19 : x='z'? x=('b'|'c') 'a' {System.out.println(\"r19 \" + $x.text);} ;
r2 : (x='-')? 'a' {System.out.println(\"r2 \" + $x.text + \" \" + $x.line + \" \" + $x.index + \" \" + ($x != null));} ;
r3 : X ( X Y {System.out.println(\"r3 \" + $X.text);} ) ;
r4 : (y=q)? 'a' {System.out.println(\"r4 \" + $y.text);} ;
r5 : (x='-' | x='+') 'a' {System.out.println(\"r5 \" + $x.text);} ;
r6 : (x='-')* 'a' {System.out.println(\"r6 \" + $x.text);} ;
r7 : X X {System.out.println(\"r7 \" + $X.text);} ;
r8 : {System.out.println(\"r8 \" + $x.text);} x=X {System.out.println(\"r8 \" + $x.text);} ;
r9 : (x=X {System.out.println(\"r9 \" + $x.text);} | Y {System.out.println(\"r9 \" + $x.text);}) ;
r10 : (y=q)+ {System.out.println(\"r10 \" + $y.text + \" \" + $y.v);} ;
r11 : y=q y=q {System.out.println(\"r11 \" + $y.text + \" \" + $y.v);} ;
q returns [int v] : X {$v = $X.int;} ;
w : ;
X : [0-9]+ ;
Y : 'y' ;
WS : ' ' -> skip ;
";
    let inputs: List<String> = [
        "A a", "A - a", "A - a b", "B a", "B - a", "C 1 2 y", "D a", "D 7 a", "E - a", "E + a", "F a", "F - - a",
        "G 1 2", "H 1", "I 1", "I y", "J 1 2 3", "K 1 2", "L a", "L - a", "M a", "M - a", "N - a", "N - a b", "N -",
        "O a b c d e f a b c d e g", "O a b c d e g", "P a", "Q a", "Q b a", "R 7 a", "S b a", "S z c a",
    ];
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        assert parses(g4, "s", inputs, &GenerateOptions { prediction }) == "A a => (s A (r1 a))
A - a => error
A - a b => (s A (r1 - a b))
B a => (s B (r2 a)) [r2 null 0 0 false\n]
B - a => (s B (r2 - a)) [r2 - 1 1 true\n]
C 1 2 y => (s C (r3 1 2 y)) [r3 2\n]
D a => (s D (r4 a)) [r4 null\n]
D 7 a => (s D (r4 (q 7) a)) [r4 7\n]
E - a => (s E (r5 - a)) [r5 -\n]
E + a => (s E (r5 + a)) [r5 +\n]
F a => (s F (r6 a)) [r6 null\n]
F - - a => (s F (r6 - - a)) [r6 -\n]
G 1 2 => (s G (r7 1 2)) [r7 2\n]
H 1 => (s H (r8 1)) [r8 null\nr8 1\n]
I 1 => (s I (r9 1)) [r9 1\n]
I y => (s I (r9 y)) [r9 null\n]
J 1 2 3 => (s J (r10 (q 1) (q 2) (q 3))) [r10 3 3\n]
K 1 2 => (s K (r11 (q 1) (q 2))) [r11 2 2\n]
L a => (s L (r12 a))
L - a => error
M a => (s M (r13 a)) [r13 null\n]
M - a => error
N - a => error
N - a b => (s N (r14 - a b))
N - => (s N (r14 -))
O a b c d e f a b c d e g => (s O (r15 a b c d e f w a b c d e g))
O a b c d e g => (s O (r15 w a b c d e g))
P a => (s P (r16 a)) [r16 null\n]
Q a => (s Q (r17 a)) [r17 null\n]
Q b a => (s Q (r17 b a)) [r17 b\n]
R 7 a => (s R (r18 (q 7) a)) [r18 7\n]
S b a => (s S (r19 b a)) [r19 b\n]
S z c a => (s S (r19 z c a)) [r19 c\n]
";
    }
}

test "an action asks whether a token matched as the jar answers" {
    let g4 = "grammar T;
s : 'A' r1 EOF | 'B' r2 EOF | 'C' r3 EOF | 'D' r4 EOF | 'E' r5 EOF | 'F' e EOF | 'G' r7 EOF | 'H' r8 EOF | 'I' r9 EOF ;
r1 : ID? 'a' {System.out.println(\"r1 \" + (((R1Context)$ctx).ID() != null) + \" \" + $ID.text);} ;
r2 : {System.out.println(\"r2 \" + (((R2Context)$ctx).ID() != null));} ID 'a' {System.out.println(\"r2 \" + (((R2Context)$ctx).ID() == null));} ;
r3 : ID? ID {System.out.println(\"r3 \" + (((R3Context)$ctx).ID() != null));} ;
r4 : ID? 'a' {System.out.println(\"r4 \" + (((AltaContext)$ctx).ID() != null));} # Alta | 'x' ID ID # Altb ;
r5 @init {System.out.println(\"r5 \" + ($ctx.ID() != null));} @after {System.out.println(\"r5 \" + ($ctx.ID() != null));} : ID? 'a' {System.out.println(\"r5 \" + ($ctx.ID() != null));} ;
e : e '+' ID? {System.out.println(\"e \" + (((EContext)$ctx).ID() != null));} | INT ;
r7 : x='-'? 'a' {System.out.println(\"r7 \" + (($x) == null) + \" \" + ((($x)) != null));} ;
r8 : (x='b')? (y='c')? 'a' {System.out.println(\"r8 \" + ($x.text == null) + \" \" + ($x.text != null) + \" \" + ($x.text == $y.text) + \" \" + ($x.text != \"b\") + \" \" + \"c\".equals($y.text) + \" \" + ($x.text == \"null\"));} ;
r9 : (x='b')? 'a' {System.out.println(\"r9 \" + $x.text.equals(\"b\"));} ;
INT : [0-9]+ ;
ID : [d-w]+ ;
WS : ' ' -> skip ;
";
    let inputs: List<String> = [
        "A a", "A d a", "B d a", "C d", "C d e", "D a", "D d a", "E a", "E d a", "F 1 +", "F 1 + d", "G a", "G - a",
        "H a", "H b a", "H c a", "H b c a", "I b a",
    ];
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        assert parses(g4, "s", inputs, &GenerateOptions { prediction }) == "A a => (s A (r1 a)) [r1 false null\n]
A d a => (s A (r1 d a)) [r1 true d\n]
B d a => (s B (r2 d a)) [r2 false\nr2 false\n]
C d => (s C (r3 d)) [r3 true\n]
C d e => (s C (r3 d e)) [r3 true\n]
D a => (s D (r4 a)) [r4 false\n]
D d a => (s D (r4 d a)) [r4 true\n]
E a => (s E (r5 a)) [r5 false\nr5 false\nr5 false\n]
E d a => (s E (r5 d a)) [r5 false\nr5 true\nr5 true\n]
F 1 + => (s F (e (e 1) +)) [e false\n]
F 1 + d => (s F (e (e 1) + d)) [e true\n]
G a => (s G (r7 a)) [r7 true false\n]
G - a => (s G (r7 - a)) [r7 false true\n]
H a => (s H (r8 a)) [r8 true false true true false false\n]
H b a => (s H (r8 b a)) [r8 false true false true false false\n]
H c a => (s H (r8 c a)) [r8 true false false true true false\n]
H b c a => (s H (r8 b c a)) [r8 false true false true true false\n]
I b a => (s I (r9 b a)) [r9 true\n]
";
    }
}

// The jar throws a NullPointerException calling a method on the text of a
// token label that did not match; the parser generated here traps.
test "an action calling a method on an unmatched label's text traps" {
    let source = gen_source("grammar T;
s : (x='b')? 'a' {System.out.println($x.text.equals(\"b\"));} EOF ;
WS : ' ' -> skip ;
");
    assert !eval_beside(source, wado`show("a", parse_s("a"));\n`, SHOW_FN).status matches { Exited(0) };
}

// The jar throws a NullPointerException reading a member of a rule label that
// did not match; the parser generated here traps.
test "an action reading a value of an unmatched rule label traps" {
    let source = gen_source("grammar T;
s : (y=q)? 'a' {System.out.println($y.v);} EOF ;
q returns [int v] : 'b' {$v = 3;} ;
WS : ' ' -> skip ;
");
    assert run_beside(source, wado`show("b a", parse_s("b a"));\n`, SHOW_FN).stdout == "b a => (s (q b) a) [3\n]\n";
    assert !eval_beside(source, wado`show("a", parse_s("a"));\n`, SHOW_FN).status matches { Exited(0) };
}

test "a fragment two rules share matches in each" {
    let got = lexes("lexer grammar L;
FLOAT : DIGITS '.' DIGITS? ;
INT : DIGITS ;
fragment DIGITS : [0-9]+ ;
WS : ' ' -> skip ;
", ["3.14 42 7.", "1.2.3"]);
    assert got == "3.14 42 7. => FLOAT:3.14 INT:42 FLOAT:7.\n1.2.3 => FLOAT:1.2 error:. INT:3\n";
}

test "a fragment's alternation takes its longest arm at the end of a rule, and before a suffix the arm the suffix can follow" {
    let got = lexes("lexer grammar L;
X : AB ;
Y : AB 'c' { System.out.println(\"y\"); } ;
fragment AB : 'a' | 'ab' ;
", ["ab", "abc", "ac", "a"]);
    assert got == "ab => X:ab\nabc => Y:abc [y\n]\nac => Y:ac [y\n]\na => X:a\n";
}

test "a number's radix prefix is matched before its digits" {
    let got = lexes("lexer grammar L;
HEX : ('0x' | '0X') [0-9a-fA-F]+ ;
BIN : ('0b') [01]+ ;
INT : [0-9]+ ;
WS : ' ' -> skip ;
", ["0x1F 0b101 0X2 0 0b2"]);
    assert got == "0x1F 0b101 0X2 0 0b2 => HEX:0x1F BIN:0b101 HEX:0X2 INT:0 INT:0 error:b INT:2\n";
}

test "an exponent's empty sign arm lets the digits follow the e" {
    let got = lexes("lexer grammar L;
NUM : [0-9]+ ('e' ('+' | '-' | ) [0-9]+)? ;
WS : ' ' -> skip ;
", ["1e5 2e-3 4e"]);
    assert got == "1e5 2e-3 4e => NUM:1e5 NUM:2e-3 NUM:4 error:e\n";
}

test "an alternation before an optional suffix takes the arm that reaches furthest" {
    let got = lexes("lexer grammar L;
INT : ('0' | [0-9]+) 'L'? ;
WS : ' ' -> skip ;
", ["0L 007 12L 0"]);
    assert got == "0L 007 12L 0 => INT:0L INT:007 INT:12L INT:0\n";
}

test "text up to a tag is one token, and a tag's names another mode's" {
    let got = lexes("lexer grammar L;
OPEN : '<' -> pushMode(TAG) ;
TEXT : ~[<]+ ;
mode TAG;
NAME : [a-z]+ ;
CLOSE : '>' -> popMode ;
", ["a<b>c d", "<x>"]);
    assert got == "a<b>c d => TEXT:a OPEN:< NAME:b CLOSE:> TEXT:c d\n<x> => OPEN:< NAME:x CLOSE:>\n";
}

test "a lexer member keeps its state across the parser's literal tokens" {
    let got = lexes("grammar T;
@lexer::members { int ids = 0; }
r : '(' ID+ ')' ;
ID : [a-z]+ { ids = ids + 1; System.out.println(ids); } ;
WS : ' ' -> skip ;
", ["(a b)"]);
    assert got == "(a b) => '(':( ID:a ID:b ')':) [1\n2\n]\n";
}

test "a caseInsensitive keyword is told apart from an identifier of ranges" {
    let got = lexes("lexer grammar L;
options { caseInsensitive = true; }
SELECT : 'select' ;
ID : 'a'..'z'+ ;
WS : ' ' -> skip ;
", ["Select FOO selects"]);
    assert got == "Select FOO selects => SELECT:Select ID:FOO ID:selects\n";
}

// The jar's tokens, over the same rules with `getText().equals(…)`: a predicate
// after a construct decides where it stops, the trailing one included.
test "a predicate after a loop, an optional or an alternation decides where it stops" {
    let got = lexes("lexer grammar L;
options { language = Wado; }
MID : 'a' .+ { $text == \"azz\" }? 'z' ;
END : 'b' .+ 'z' { $text == \"bzz\" }? ;
TAIL : 'c' .+ { $text == \"czz\" }? ;
OPT : 'd' 'z'? { $text == \"d\" }? ;
ARM : ('e' | 'ez') { $text == \"e\" }? 'z' ;
LAST : ('f' | 'fz') { $text == \"fz\" }? ;
X : . ;
", ["azzzz", "bzzzz", "czzzz", "dz", "ezz", "fz"]);
    assert got == "azzzz => MID:azzz X:z
bzzzz => END:bzz X:z X:z
czzzz => TAIL:czz X:z X:z
dz => OPT:d X:z
ezz => ARM:ez X:z
fz => LAST:fz
";
}

test "an optional leaves the char the rest of the rule needs" {
    let got = lexes("lexer grammar L;
OVER : 'g' 'z'? 'z' ;
X : . ;
", ["gz", "gzz"]);
    assert got == "gz => OVER:gz\ngzz => OVER:gzz\n";
}

// The jar's tokens; its predicates read `getText().equals(…)`.
test "a repeat over a string leaves the iterations the rest of the rule needs" {
    let got = lexes("lexer grammar L;
options { language = Wado; }
OPT : 'x' ('ab')? 'ab' ;
LOOP : 'y' ('ab')* 'ab' 'q' ;
PRED_OPT : 'b' ('xy')? { $text == \"b\" }? ;
PRED_LOOP : 'c' ('xy')+ { $text == \"cxy\" }? ;
X : . ;
", ["xab", "yababq", "bxy", "cxyxy"]);
    assert got == "xab => OPT:xab
yababq => LOOP:yababq
bxy => PRED_OPT:b X:x X:y
cxyxy => PRED_LOOP:cxy X:x X:y
";
}

test "a greedy loop hands back the chars a predicate-carrying suffix needs" {
    let got = lexes("lexer grammar L;
options { language = Wado; }
S : 'a' .+ END ;
fragment END : { true }? 'z' ;
", ["abz"]);
    assert got == "abz => S:abz\n";
}

test "an alternation before a predicate takes the arm the rest of the rule needs" {
    let after = lexes("lexer grammar L;
options { language = Wado; }
I : ('a' | 'ab') { true }? 'bc' ;
", ["abbc"]);
    let inside = lexes("lexer grammar L;
options { language = Wado; }
I : ('a' | 'ab') END ;
fragment END : { true }? 'bc' ;
", ["abbc"]);
    assert after == "abbc => I:abbc\n";
    assert inside == "abbc => I:abbc\n";
}

test "an identifier made of another token's chars takes the longest match and the first rule on a tie" {
    let got = lexes("lexer grammar L;
ID : (LETTER | '_')+ ;
LETTER : [a-z] ;
WS : ' ' -> skip ;
", ["ab a _"]);
    assert got == "ab a _ => ID:ab ID:a ID:_\n";
}

test "a keyword declared after the identifier rule never wins" {
    // Both match `if` at the same length, and ANTLR4 gives a tie to the rule
    // declared first.
    let got = lexes("lexer grammar L;
ID : [a-z]+ ;
IF : 'if' ;
WS : ' ' -> skip ;
", ["if x"]);
    assert got == "if x => ID:if ID:x\n";
}

test "a mode whose only rule starts with any char still lexes" {
    let got = lexes("lexer grammar L;
HASH : '#' -> pushMode(LINE) ;
ID : [a-z]+ ;
mode LINE;
REST : ~[;]+ -> popMode ;
", ["#include foo", "ab#x"]);
    assert got == "#include foo => HASH:# REST:include foo\nab#x => ID:ab HASH:# REST:x\n";
}

test "a greedy star hands back the chars its suffix needs" {
    let got = lexes("lexer grammar L;
S : 'a' .* 'c' ;
", ["abcbc", "ac", "abcb"]);
    assert got == "abcbc => S:abcbc\nac => S:ac\nabcb => S:abc error:b\n";
}

test "a greedy plus stops where a fragment suffix can still match" {
    let got = lexes("lexer grammar L;
S : 'a' .+ END ;
fragment END : 'z' 'z' ;
", ["abzzczz", "azzz", "azz"]);
    assert got == "abzzczz => S:abzzczz\nazzz => S:azzz\nazz => error:a error:z error:z\n";
}

test "a greedy star before an alternation ending in EOF runs to the last match" {
    let got = lexes("lexer grammar L;
LINE : '#' .* (';' | EOF) ;
", ["#a;b;#c", "#a;"]);
    assert got == "#a;b;#c => LINE:#a;b;#c\n#a; => LINE:#a;\n";
}

test "a non-greedy plus consumes one char before it tries to exit" {
    let got = lexes("lexer grammar L;
CMT : '/*' .+? '*/' ;
SL : '/' ;
ST : '*' ;
", ["/**/", "/***/", "/*a*/*/"]);
    assert got == "/**/ => SL:/ ST:* ST:* SL:/\n/***/ => CMT:/***/\n/*a*/*/ => CMT:/*a*/ ST:* SL:/\n";
}

test "a scored alternation runs only the winning arm's action" {
    let got = lexes("lexer grammar L;
I : ('a' { System.out.println(\"short\"); } | 'ab' { System.out.println(\"long\"); }) 'bc' ;
", ["abc", "abbc"]);
    assert got == "abc => I:abc [short\n]\nabbc => I:abbc [long\n]\n";
}

test "a keyword is told apart from an identifier built of fragments and ranges" {
    let got = lexes("lexer grammar L;
IF : 'if' ;
ID : LETTER (LETTER | '0'..'9')* ;
fragment LETTER : 'a'..'z' | '_' ;
WS : ' ' -> skip ;
", ["if iff x_1 if1 _if"]);
    assert got == "if iff x_1 if1 _if => IF:if ID:iff ID:x_1 ID:if1 ID:_if\n";
}

test "a keyword is recognized only in the default mode" {
    // In `TAG`, `ATTR` retypes its match to `ID`, the kind `END` is classified
    // out of in the default mode; the mode, not the kind, keeps it an `ID` there.
    let got = lexes("lexer grammar L;
END : 'end' ;
NIL : 'NIL' ;
ID : [a-z]+ ;
CONST : [A-Z]+ ;
LT : '<' -> pushMode(TAG) ;
WS : ' ' -> skip ;
mode TAG;
ATTR : [a-z]+ -> type(ID) ;
GT : '>' -> popMode ;
TAG_WS : ' ' -> skip ;
", ["end ends NIL NILS <end x> end"]);
    assert got == "end ends NIL NILS <end x> end => END:end ID:ends NIL:NIL CONST:NILS LT:< ID:end ID:x GT:> END:end\n";
}

test "a keyword reclassified out of its carrier does not run the carrier's action" {
    let got = lexes("lexer grammar L;
IF : 'if' ;
ID : [a-z]+ { System.out.println(\"id\"); } ;
NUM : [0-9]+ { System.out.println(\"num\"); } ;
WS : ' ' -> skip ;
", ["if x 1"]);
    assert got == "if x 1 => IF:if ID:x NUM:1 [id\nnum\n]\n";
}

test "a hidden-channel token between two tokens does not reach the parser" {
    let got = parses("grammar T;
r : ID+ EOF ;
ID : [a-z]+ ;
CMT : '#' [a-z]* -> channel(HIDDEN) ;
WS : ' ' -> skip ;
", "r", ["a #bc d", "a#b"]);
    assert got == "a #bc d => (r a d)\na#b => (r a)\n";
}

test "a more rule's text joins the token its mode switch leads to" {
    let got = lexes("lexer grammar L;
TEXT : [a-z]+ ;
HASH : '#' -> more, mode(NUM) ;
DOT : '.' -> channel(HIDDEN) ;
WS : ' ' -> skip ;
mode NUM;
NUMBER : [0-9]+ -> mode(DEFAULT_MODE) ;
", ["ab #12 cd", "ab.cd"]);
    assert got == "ab #12 cd => TEXT:ab NUMBER:#12 TEXT:cd\nab.cd => TEXT:ab TEXT:cd\n";
}

test "a string whose escapes share a lead char is lexed by the lexer ATN" {
    let got = lexes("lexer grammar L;
STR : '\"' (~('\\\\' | '\"') | '\\\\' . | '\\\\x' HEX HEX? | '\\\\u{' HEX+ '}')* '\"' ;
fragment HEX : '0'..'9' | 'a'..'f' ;
", ["\"a\\x41\"", "\"\\\"\"", "\"\\x\"", "\"\\u{1f600}\""]);
    assert got == "\"a\\x41\" => STR:\"a\\x41\"\n\"\\\"\" => STR:\"\\\"\"\n\"\\x\" => STR:\"\\x\"\n\"\\u{1f600}\" => STR:\"\\u{1f600}\"\n";
}

// Each alternative that competes with a loop agrees with two of its
// iterations, so only a walk that re-enters the loop tells them apart.
test "a prediction walks a loop through more than one iteration" {
    let got = parses("grammar T;
t : s EOF ;
s : ('x' 'y' | 'x' 'z')* 'p' | 'x' 'y' 'x' 'w' | u | v ;
u : 'a'* 'p' | 'a' 'a' 'w' ;
v : ('b' 'c' | 'b' 'd')+ 'q' | 'b' 'c' 'b' 'w' ;
WS : [ \\t]+ -> skip ;
", "t", ["x y x z p", "x y x w", "x y x y p", "a a p", "a a w", "a a a p", "b c b d q", "b c b w", "b d q"]);
    assert got == "x y x z p => (t (s x y x z p))
x y x w => (t (s x y x w))
x y x y p => (t (s x y x y p))
a a p => (t (s (u a a p)))
a a w => (t (s (u a a w)))
a a a p => (t (s (u a a a p)))
b c b d q => (t (s (v b c b d q)))
b c b w => (t (s (v b c b w)))
b d q => (t (s (v b d q)))
";
}

test "an optional nullable rule is entered, as the lower alternative, on what follows it too" {
    let got = parses("grammar T;
s : b? Z? EOF ;
b : Y | ;
Y : 'y' ; Z : 'z' ;
WS : ' ' -> skip ;
", "s", ["", "z", "y z"]);
    assert got == " => (s b)\nz => (s b z)\ny z => (s (b y) z)\n";
}

test "an optional rule whose only empty alternative is predicated is entered on what follows it as the predicate says" {
    for let [pred, tree] of [
        ["false", "(s z)"],
        ["true", "(s b z)"],
    ] {
        let got = parses(`grammar T;
s : b? Z EOF ;
b : {${pred}}? | Y ;
Y : 'y' ; Z : 'z' ;
WS : ' ' -> skip ;
`, "s", ["z"]);
        assert got == `z => ${tree}\n`;
    }
}

test "a catch-all declared first wins a one-char tie against a later rule" {
    let got = lexes("lexer grammar L;
OTHER : . ;
WS : ' ' -> skip ;
B : 'b' ;
", ["a b"]);
    assert got == "a b => OTHER:a OTHER:  OTHER:b\n";
}

// ===========================================================================
// The two ways a grammar reaches Gale from outside: the `gale` command line,
// and the Kiln generator a `use ... with { generator: ... }` site runs.
//
// The command line runs under handlers: its arguments come from `CommandLine`,
// its console is captured by `Console`, and `Grants` preopens each test's
// scratch directory, as `wado run --dir` would. The Kiln generator runs under
// `Inputs`, which serves the input files' streams, and `Host`, which keeps its
// diagnostics.
// ===========================================================================

use { gale, run } from "./main.wado";
use { generate as kiln_generate, Options } from "./generator.wado";
use { Console } from "../tests/support/console.wado";
use { scratch } from "../tests/support/scratch.wado";
use { Environment, Exit } from "core:cli";
use { Log } from "core:log";
use { Preopens, Descriptor, PathFlags, OpenFlags, DescriptorFlags } from "wasi:filesystem";
use fs from "core:fs";
use { TreeMap } from "core:collections";
use { Request, Response, Error as KilnError, InputFile } from "core:kiln";

global EXPR: String = "grammar Expr;
expr : expr '*' expr | expr '+' expr | INT ;
INT : [0-9]+ ;
WS : [ ]+ -> skip ;
";

global EXPR_QUERY: String = "(INT) @number\n";

global SPLIT_LEXER: String = "lexer grammar SplitLexer;
NUM : [0-9]+ ;
";

global SPLIT_PARSER: String = "parser grammar SplitParser;
options { tokenVocab = SplitLexer; }
start : NUM ;
";

global DANGLING: String = "grammar Dangling;\nstart : missing ;\n";

// `??` prefers to skip `A` while the rest of the input still parses, which only
// the ATN simulator decides.
global LAZY: String = "grammar Lazy;
r : A?? A B ;
A : 'a' ;
B : 'b' ;
";

global LAZY_REFUSAL: String = "a non-greedy `??` only the ATN simulator decides, and `prediction: \"longest\"` refuses it";

/// The program's arguments after its name.
struct CommandLine {
    argv: List<String>,
}

impl Environment for CommandLine {
    fn get_arguments(&self) -> List<String> {
        let mut all: List<String> = ["gale"];
        all.extend(&self.argv);
        resume all;
    }

    ..forward
}

/// Preopens `dirs`, each under the package root `wado test` grants and
/// named as written, so the program reaches those and no other.
struct Grants {
    dirs: List<String>,
}

impl Preopens for Grants {
    fn get_directories(&self) -> List<[Descriptor, String]> with Preopens {
        let cwd = Preopens::get_directories().remove(0).0;
        let mut granted: List<[Descriptor, String]> = [];
        for let dir of &self.dirs {
            let opened = cwd.open_at(
                PathFlags::none(),
                *dir,
                OpenFlags::Directory,
                DescriptorFlags::Read | DescriptorFlags::MutateDirectory,
            ).wait();
            granted.push([opened.unwrap(), *dir]);
        }
        resume granted;
    }
}

global SUITE: String = "gale-main-test";

fn put(dir: &String, name: String, text: String) with Preopens {
    let path = `${*dir}/${name}`;
    fs::write(&path, &text).unwrap();
}

/// What one `gale` run returned, printed and logged.
affine struct Run {
    result: Result<(), String>,
    console: Console,
}

impl Run {
    fn stdout(&self) -> String {
        return self.console.stdout();
    }

    /// The report `run` prints on a failure, or `""` on success.
    fn failure(&self) -> String {
        return match &self.result {
            Ok(_) => "",
            Err(report) => *report,
        };
    }
}

/// Run `gale argv` with `grants` preopened.
fn gale_with(grants: List<String>, argv: List<String>) -> Run with (Preopens, Environment, Log) {
    let line = CommandLine { argv };
    let dirs = Grants { dirs: grants };
    let mut console = Console {};
    let result = with &mut console, Environment => &line, Preopens => &dirs do {
        gale();
    };
    console.end_writes();
    return Run { result, console };
}

/// Run `gale argv` with `dir` as the only grant.
fn gale_in<S: AsStrSlice>(dir: S, argv: List<String>) -> Run with (Preopens, Environment, Log) {
    return gale_with([dir.to_string()], argv);
}

/// Serves each input file's content from its stream, by the stream's identity.
struct Inputs {
    contents: TreeMap<ResourceId, ByteList> = TreeMap::<ResourceId, ByteList>::new(),
}

impl Inputs {
    /// A stream serving `content`, made before the handler is installed, since
    /// it traps on `new`.
    fn serve(&mut self, content: ByteList) -> Stream<u8> {
        let [rx, tx] = Stream::<u8>::new();
        tx.drop();
        self.contents[ResourceId::of(&rx)] = content;
        return rx;
    }
}

impl Stream<u8> for Inputs {
    fn begin_read(&mut self, this: &Stream<u8>, max: i32, into: ReadInto) -> StartedRead<u8> {
        resume StartedRead::settled(StreamChunk {
            items: self.contents[ResourceId::of(this)] as List<u8>,
            result: CopyResult::Dropped,
        });
    }

    fn drop(&mut self, this: &Stream<u8>) {
        resume ();
    }

    ..trap
}

/// What one Kiln generator run returned, and the events it logged, each as
/// `<level>: <message>`.
struct KilnRun {
    result: Result<Response, KilnError>,
    events: List<String>,
}

impl KilnRun {
    /// The entry module's source; the run must have succeeded.
    fn source(&self) -> String {
        let Ok(response) = self.result else {
            panic(`generation failed: ${self.result:?}`);
        };
        assert response.files.len() == 1;
        return response.files[0].content;
    }

    fn error(&self) -> String {
        return match self.result {
            Ok(_) => "",
            Err(e) => `${e}`,
        };
    }
}

/// Run the Kiln generator on `primary`, `[path, content]` of `primary_type`,
/// and `supplementary`, each `[path, content, type]`.
fn kiln(
    primary: [String, ByteList],
    supplementary: List<[String, ByteList, Option<String>]>,
    options: Options,
    primary_type: Option<String> = null,
) -> KilnRun with Log {
    let mut inputs = Inputs {};
    let mut files: List<InputFile> = [];
    for let [path, content, type_] of supplementary {
        files.push(InputFile { path, content: inputs.serve(content), type: type_ });
    }
    let request = Request {
        primary: InputFile { path: primary.0, content: inputs.serve(primary.1), type: primary_type },
        inputs: files,
        module: "lib:gale",
        options,
    };
    let mut console = Console {};
    let result = with &mut inputs, Log => &mut console do {
        kiln_generate(request);
    };
    return KilnRun { result, events: console.events };
}

fn bytes_of(s: String) -> ByteList {
    return s.bytes().collect();
}

fn no_options() -> Options {
    return Options { fragment_entries: [] };
}

// ---------------------------------------------------------------------------
// gale gen
// ---------------------------------------------------------------------------

test "gen prints the parser the Kiln generator builds for the same grammar" {
    let dir = scratch(SUITE, "gen");
    put(&dir, "Expr.g4", EXPR);
    let outcome = gale_in(&dir, ["gen", "Expr.g4"]);
    assert outcome.result matches { Ok(_) };
    let built = kiln(["Expr.g4", bytes_of(EXPR)], [], no_options());
    assert outcome.stdout() == built.source();
    assert outcome.console.stderr() == "";
}

test "gen --output writes the parser into the first grant and prints nothing" {
    let out = scratch(SUITE, "gen-output/out");
    let src = scratch(SUITE, "gen-output/src");
    put(&src, "Expr.g4", EXPR);
    let outcome = gale_with([out, src], ["gen", "--output", "expr.wado", "Expr.g4"]);
    assert outcome.result matches { Ok(_) };
    assert outcome.stdout() == "";
    let stdout = gale_in(&src, ["gen", "Expr.g4"]).stdout();
    assert fs::read_to_string(`${out}/expr.wado`).unwrap() == stdout;
}

test "gen with a .scm query adds the highlighter" {
    let dir = scratch(SUITE, "gen-highlight");
    put(&dir, "Expr.g4", EXPR);
    put(&dir, "expr.scm", EXPR_QUERY);
    let plain = gale_in(&dir, ["gen", "Expr.g4"]);
    let highlighted = gale_in(&dir, ["gen", "--highlights", "expr.scm", "Expr.g4"]);
    assert highlighted.result matches { Ok(_) };
    assert !plain.stdout().contains("pub fn highlight<");
    assert highlighted.stdout().contains("pub fn highlight<");
}

test "gen --trace builds a parser that can log its decisions" {
    let dir = scratch(SUITE, "gen-trace");
    put(&dir, "Expr.g4", EXPR);
    let plain = gale_in(&dir, ["gen", "Expr.g4"]);
    let tracing = gale_in(&dir, ["gen", "--trace", "Expr.g4"]);
    assert !plain.stdout().contains("trace_to_stderr");
    assert tracing.stdout().contains("trace_to_stderr");
}

test "gen --prediction longest refuses a grammar only the simulator can parse" {
    let dir = scratch(SUITE, "gen-prediction-longest");
    put(&dir, "Lazy.g4", LAZY);
    assert gale_in(&dir, ["gen", "Lazy.g4"]).result matches { Ok(_) };
    let longest = gale_in(&dir, ["gen", "--prediction", "longest", "Lazy.g4"]);
    assert longest.failure() == "gale gen: no parser written; the errors above say why";
    assert longest.stdout() == "";
    assert longest.console.events == [`Error: ${LAZY_REFUSAL}`];
}

// A query naming a token the grammar lacks is a `Warn` diagnostic: the parser
// is built without that rule.
test "a warning is logged by default and silenced by --log-level error" {
    let dir = scratch(SUITE, "gen-log-level");
    put(&dir, "Expr.g4", EXPR);
    put(&dir, "bad.scm", "(FLOAT) @number\n");
    let default_level = gale_in(&dir, ["gen", "--highlights", "bad.scm", "Expr.g4"]);
    assert default_level.result matches { Ok(_) };
    assert default_level.console.events == ["Warn: highlight query: unknown token 'FLOAT'"];
    let quiet = gale_in(&dir, ["gen", "--log-level", "error", "--highlights", "bad.scm", "Expr.g4"]);
    assert quiet.console.events == [];
}

test "a grammar read from the second grant is found" {
    let empty = scratch(SUITE, "second-grant/empty");
    let src = scratch(SUITE, "second-grant/src");
    put(&src, "Expr.g4", EXPR);
    let outcome = gale_with([empty, src], ["dump", "Expr.g4"]);
    assert outcome.result matches { Ok(_) };
    assert outcome.stdout().starts_with("grammar Expr\n");
}

/// An `Exit` that traps on any use: the run must not end the process.
struct NoExit {
}

impl Exit for NoExit {
    ..trap
}

test "run prints what a successful command prints, and does not exit" {
    let dir = scratch(SUITE, "run");
    put(&dir, "Expr.g4", EXPR);
    let line = CommandLine {
        argv: ["dump", "--atn", "Expr.g4"],
    };
    let dirs = Grants {
        dirs: [dir],
    };
    let mut console = Console {};
    with &mut console, Environment => &line, Preopens => &dirs, Exit => &NoExit {} do {
        run();
    };
    console.end_writes();
    assert console.stdout().contains("rule 0 'expr'");
    assert console.stderr() == "";
}

// ---------------------------------------------------------------------------
// gale dump
// ---------------------------------------------------------------------------

test "dump prints the per-rule prediction report" {
    let dir = scratch(SUITE, "dump");
    put(&dir, "Expr.g4", EXPR);
    let outcome = gale_in(&dir, ["dump", "Expr.g4"]);
    assert outcome.result matches { Ok(_) };
    assert outcome.stdout().starts_with("grammar Expr\n\n");
    assert outcome.stdout().contains("expr");
}

test "dump --atn prints the ATN" {
    let dir = scratch(SUITE, "dump-atn");
    put(&dir, "Expr.g4", EXPR);
    let outcome = gale_in(&dir, ["dump", "--atn", "Expr.g4"]);
    assert outcome.result matches { Ok(_) };
    assert outcome.stdout().contains("rule 0 'expr'");
}

test "dump --lexer prints the lexer report" {
    let dir = scratch(SUITE, "dump-lexer");
    put(&dir, "Expr.g4", EXPR);
    let outcome = gale_in(&dir, ["dump", "--lexer", "Expr.g4"]);
    assert outcome.result matches { Ok(_) };
    assert outcome.stdout().contains("grammar Expr (lexer)");
    assert outcome.stdout().contains("rule INT");
}

test "every grammar file given is read and merged" {
    let dir = scratch(SUITE, "dump-split");
    put(&dir, "SplitLexer.g4", SPLIT_LEXER);
    put(&dir, "SplitParser.g4", SPLIT_PARSER);
    let both = gale_in(&dir, ["dump", "--lexer", "SplitParser.g4", "SplitLexer.g4"]);
    assert both.result matches { Ok(_) };
    assert both.stdout().contains("rule NUM");
}

test "a reference to a rule no grammar defines is reported" {
    let dir = scratch(SUITE, "dangling");
    put(&dir, "Dangling.g4", DANGLING);
    let outcome = gale_in(&dir, ["dump", "Dangling.g4"]);
    assert outcome.failure() == "gale: expected defined rule name; reference to undefined rule \"missing\" in \"start\"";
}

// ---------------------------------------------------------------------------
// What a failed run reports
// ---------------------------------------------------------------------------

global USAGE: String = "Usage: gale gen [--trace] [--prediction <mode>] [--log-level <level>] [--output <file>] [--highlights <query.scm> ...] <grammar.g4> [grammar2.g4 ...]
       gale dump [--atn | --lexer] [--log-level <level>] <grammar.g4> [grammar2.g4 ...]
       <mode> is exact, longest or verify (default exact)
       <level> is trace, debug, info, warn or error (default warn)";

test "an argument error names the subcommand and shows the usage" {
    let dir = scratch(SUITE, "usage");
    let unknown = gale_in(&dir, ["gen", "--frobnicate", "Expr.g4"]);
    assert unknown.failure().starts_with("gale gen: ");
    assert unknown.failure().ends_with(`\n${USAGE}`);
    let dump = gale_in(&dir, ["dump", "--frobnicate"]);
    assert dump.failure().starts_with("gale dump: ");
    let none = gale_in(&dir, []);
    assert none.failure().starts_with("gale: ");
    assert none.failure().ends_with(`\n${USAGE}`);
}

test "a subcommand given no grammar says so" {
    let dir = scratch(SUITE, "no-grammar");
    put(&dir, "expr.scm", EXPR_QUERY);
    assert gale_in(&dir, ["gen", "--highlights", "expr.scm"]).failure() == "gale gen: no grammar files given";
    assert gale_in(&dir, ["dump"]).failure() == "gale dump: no grammar files given";
}

test "--atn and --lexer together are refused" {
    let dir = scratch(SUITE, "atn-lexer");
    put(&dir, "Expr.g4", EXPR);
    let outcome = gale_in(&dir, ["dump", "--atn", "--lexer", "Expr.g4"]);
    assert outcome.failure() == "gale dump: --atn and --lexer are separate reports; pass one";
}

test "an unknown --log-level is refused" {
    let dir = scratch(SUITE, "bad-level");
    put(&dir, "Expr.g4", EXPR);
    let outcome = gale_in(&dir, ["gen", "--log-level", "loud", "Expr.g4"]);
    assert outcome.failure() == "gale: unknown --log-level 'loud' (trace, debug, info, warn, error)";
    assert outcome.stdout() == "";
}

test "a grammar that does not parse is reported with its path" {
    let dir = scratch(SUITE, "parse-error");
    put(&dir, "Broken.g4", "grammar Broken;\nr : ;;\n");
    let outcome = gale_in(&dir, ["gen", "Broken.g4"]);
    assert outcome.failure().starts_with("gale: Broken.g4: parse error: ");
}

test "a highlight query that does not parse is reported with its path and position" {
    let dir = scratch(SUITE, "bad-query");
    put(&dir, "Expr.g4", EXPR);
    put(&dir, "bad.scm", "(INT)\n");
    let outcome = gale_in(&dir, ["gen", "--highlights", "bad.scm", "Expr.g4"]);
    assert outcome.failure() == "gale: bad.scm: highlight query 2:1: expected '@capture'";
}

test "a missing grammar names the grants searched" {
    let dir = scratch(SUITE, "missing");
    let outcome = gale_in(&dir, ["gen", "Absent.g4"]);
    assert outcome.failure() == `gale: Absent.g4: cannot open file\ngale: not found under ${dir} — check the path, or grant the directory holding it with wado run --dir <dir> ...`;
}

global ABSOLUTE: String = "gale: a path opens inside a granted directory, so an absolute path never does";

test "an absolute path is answered with the grant that would reach it" {
    let dir = scratch(SUITE, "absolute");
    put(&dir, "Expr.g4", EXPR);
    let nested = gale_in(&dir, ["gen", "/grammars/Expr.g4"]);
    assert nested.failure() == `gale: /grammars/Expr.g4: cannot open file\n${ABSOLUTE}: wado run --dir /grammars ... Expr.g4`;
    let at_root = gale_in(&dir, ["gen", "/Expr.g4"]);
    assert at_root.failure() == `gale: /Expr.g4: cannot open file\n${ABSOLUTE}: wado run --dir / ... Expr.g4`;
    let unnamed = gale_in(&dir, ["gen", "/grammars/.."]);
    assert unnamed.failure() == `gale: /grammars/..: cannot open file\n${ABSOLUTE}: wado run --dir /grammars/.. ...`;
    let output = gale_in(&dir, ["gen", "--output", "/out/expr.wado", "Expr.g4"]);
    assert output.failure() == `gale: /out/expr.wado: cannot open for writing\n${ABSOLUTE}: wado run --dir /out ... expr.wado`;
}

test "a path the grant holds but cannot open says it is not readable" {
    let dir = scratch(SUITE, "not-readable");
    put(&dir, "Expr.g4", EXPR);
    let outcome = gale_in(&dir, ["gen", "Expr.g4/inner.g4"]);
    assert outcome.failure() == `gale: Expr.g4/inner.g4: cannot open file\ngale: not readable under ${dir}`;
}

test "with no grant there is nothing to read" {
    let outcome = gale_with([], ["gen", "Expr.g4"]);
    assert outcome.failure() == "gale: Expr.g4: cannot open file\ngale: no directory was granted to this program (try without --no-dir)";
}

test "a grammar that is not UTF-8 is refused" {
    let dir = scratch(SUITE, "not-utf8");
    fs::write(`${dir}/Bad.g4`, &([0xff as u8] as ByteList)).unwrap();
    let outcome = gale_in(&dir, ["gen", "Bad.g4"]);
    assert outcome.failure() == "gale: Bad.g4: not valid UTF-8: invalid utf-8 sequence of 1 bytes from index 0";
}

test "--output into a directory that does not exist names the grant it resolves in" {
    let dir = scratch(SUITE, "output-missing-dir");
    put(&dir, "Expr.g4", EXPR);
    let outcome = gale_in(&dir, ["gen", "--output", "absent/expr.wado", "Expr.g4"]);
    assert outcome.failure() == `gale: absent/expr.wado: cannot open for writing\ngale: --output resolves inside ${dir}, the first granted directory`;
}

test "a directory named as a grammar is a read error" {
    let dir = scratch(SUITE, "directory");
    fs::create_dir_all(`${dir}/Sub.g4`).unwrap();
    let outcome = gale_in(&dir, ["gen", "Sub.g4"]);
    assert outcome.failure() == "gale: Sub.g4: read error";
}

// ---------------------------------------------------------------------------
// The Kiln generator
// ---------------------------------------------------------------------------

test "the Kiln generator emits one entry module named after the grammar" {
    let built = kiln(["grammars/Expr.g4", bytes_of(EXPR)], [], no_options());
    let Ok(response) = built.result else {
        panic(built.error());
    };
    assert response.files.len() == 1;
    assert response.files[0].path == "expr.wado";
    assert response.files[0].is_entry;
    assert built.events == [];
}

test "a .scm input to the Kiln generator adds the highlighter" {
    let built = kiln(["Expr.g4", bytes_of(EXPR)], [
        [
            "expr.scm",
            bytes_of(EXPR_QUERY),
            Option::Some("tree-sitter-highlights"),
        ],
    ], no_options());
    assert built.source().contains("pub fn highlight<");
}

test "the primary input is a grammar, antlr4 by default" {
    for let grammar_type of [null, Option::Some("antlr4")] as List<Option<String>> {
        let built = kiln(["Expr.g4", bytes_of(EXPR)], [], no_options(), grammar_type);
        assert built.error() == "";
    }
    let other = kiln(["Expr.g4", bytes_of(EXPR)], [], no_options(), Option::Some("onnx"));
    assert other.error() == "unsupported: gale: 'Expr.g4' is given `type: \"onnx\"`; a grammar is `type: \"antlr4\"`";
}

test "an input's type, not its name, says it is a highlight query" {
    let unnamed = kiln(["Expr.g4", bytes_of(EXPR)], [
        [
            "expr.txt",
            bytes_of(EXPR_QUERY),
            Option::Some("tree-sitter-highlights"),
        ],
    ], no_options());
    assert unnamed.source().contains("pub fn highlight<");

    for let grammar_type of [null, Option::Some("antlr4")] as List<Option<String>> {
        let grammar = kiln(["Expr.g4", bytes_of(EXPR)], [
            ["expr.scm", bytes_of(EXPR_QUERY), grammar_type],
        ], no_options());
        assert grammar.error().contains("failed to parse supplementary grammar 'expr.scm'");
    }

    let unknown = kiln(["Expr.g4", bytes_of(EXPR)], [
        [
            "expr.scm",
            bytes_of(EXPR_QUERY),
            Option::Some("query"),
        ],
    ], no_options());
    assert unknown.error() == "unsupported: gale: 'expr.scm' is given `type: \"query\"`; an input is `type: \"antlr4\"` or `type: \"tree-sitter-highlights\"`";
}

test "the trace option builds a parser that can log its decisions" {
    let built = kiln(["Expr.g4", bytes_of(EXPR)], [], Options { trace: true, fragment_entries: [] });
    assert built.source().contains("trace_to_stderr");
}

test "the prediction option longest refuses a grammar only the simulator can parse" {
    let longest = kiln(["Lazy.g4", bytes_of(LAZY)], [], Options {
        fragment_entries: [],
        prediction: PredictionMode::Longest,
    });
    let refusal = `gale: rule 'r': ${LAZY_REFUSAL}`;
    assert longest.error() == `unsupported: ${refusal}`;
    assert longest.events == [], "the returned error alone reports a refusal";
}

test "Gale's diagnostics are logged at their own level" {
    let warned = kiln(["Expr.g4", bytes_of(EXPR)], [
        [
            "bad.scm",
            bytes_of("(FLOAT) @number\n"),
            Option::Some("tree-sitter-highlights"),
        ],
    ], no_options());
    assert warned.events == ["Warn: highlight: highlight query: unknown token 'FLOAT'"];
}

test "an unknown fragment entry is logged as a warning" {
    let built = kiln(["Expr.g4", bytes_of(EXPR)], [], Options {
        fragment_entries: ["nope"],
    });
    assert built.events == ["Warn: fragment_entries: fragment_entries: unknown parser rule 'nope'"];
}

test "a Kiln input that is not UTF-8 is an invalid schema" {
    let built = kiln(["Bad.g4", [0xff as u8] as ByteList], [], no_options());
    assert built.error() == "invalid schema: gale: 'Bad.g4' is not UTF-8: invalid utf-8 sequence of 1 bytes from index 0";
}

test "a Kiln parse error says which input it is in" {
    let broken = bytes_of("grammar Broken;\nr : ;;\n");
    let primary = kiln(["Broken.g4", broken], [], no_options());
    assert primary.error().starts_with("invalid schema: gale: failed to parse primary grammar 'Broken.g4': ");
    let supplementary = kiln(["Expr.g4", bytes_of(EXPR)], [
        ["Broken.g4", broken, null],
    ], no_options());
    assert supplementary.error().starts_with(
        "invalid schema: gale: failed to parse supplementary grammar 'Broken.g4': ",
    );
}

test "a Kiln grammar with unresolved references names the primary input" {
    let built = kiln(["Dangling.g4", bytes_of(DANGLING)], [], no_options());
    assert built.error() == "invalid schema: gale: unresolved rule references in 'Dangling.g4': expected defined rule name; reference to undefined rule \"missing\" in \"start\"";
}

test "a Kiln highlight query that does not parse names the query and position" {
    let built = kiln(["Expr.g4", bytes_of(EXPR)], [
        [
            "bad.scm",
            bytes_of("(INT)\n"),
            Option::Some("tree-sitter-highlights"),
        ],
    ], no_options());
    assert built.error() == "invalid schema: gale: invalid highlight query 'bad.scm' at 2:1: expected '@capture'";
}

// ===========================================================================
// `render_dump(Grammar, LoweredGrammar, LowerContext) -> String`.
//
// Most tests build a minimal `Grammar` via struct-literal syntax (no g4
// parser), lower it, and assert on substrings of the rendered report. The
// point is the report's MECE structure, not exact byte layout — substring
// checks keep the tests robust to spacing. A few tests that need LR shapes
// (awkward to hand-build) go through the g4 front-end via `dump_source`.
// ===========================================================================

use { RuleRefElement, synthesize_implicit_tokens } from "./ir.wado";
use { LitToken } from "./lexer_gen.wado";
use { lower } from "./lower.wado";
use { LoweredGrammar } from "./gir.wado";
use { LowerContext } from "./lower_context.wado";
use { GrammarAnalysis } from "./grammar_analysis.wado";
use { GenSettings } from "./gen_settings.wado";
use { canonicalize_for_analysis, lower_for_analysis, install_action_context } from "./codegen.wado";
use { render_dump, render_atn_dump } from "./dump.wado";
use { empty_grammar, alt } from "../tests/support/fixtures.wado";

/// Run the full front-end (parse → merge → synth → lower) and render,
/// through the very functions `cmd_dump` calls. Used by tests whose grammar
/// shape (left recursion) is impractical to hand-build.
///
/// The pipeline is `generate`'s, not a copy of it: the dump's whole claim is
/// that it reports what the emitter emits, and lowering asks `ctx` for FOLLOW
/// and for scannability. A hand-rolled prologue that skips either answers them
/// by re-deriving them per query, which on `RustParser.g4` cost three orders
/// of magnitude over generating the whole parser.
fn dump_pipeline<S: AsStrSlice>(input: S) -> [String, LowerContext] {
    let mut merged = merged_source(input);
    let [lowered, mut ctx] = lower_pipeline(&mut merged);
    return [render_dump(&merged, &lowered, &mut ctx), ctx];
}

fn merged_source<S: AsStrSlice>(input: S) -> Grammar {
    let mut merged = merge_grammars([parse(input.to_string()).unwrap()]);
    synthesize_implicit_tokens(&mut merged);
    return merged;
}

fn atn_dump_source<S: AsStrSlice>(input: S) -> String {
    let mut merged = merged_source(input);
    let token_kinds = canonicalize_for_analysis(&mut merged);
    let num_tokens = token_kinds.len();
    let [lowered, _] = lower_for_analysis(&mut merged, token_kinds);
    return render_atn_dump(&merged, &lowered, num_tokens);
}

/// `cmd_dump`'s prologue, whole.
fn lower_pipeline(merged: &mut Grammar) -> [LoweredGrammar, LowerContext] {
    let token_kinds = canonicalize_for_analysis(merged);
    return lower_for_analysis(merged, token_kinds);
}

fn dump_source<S: AsStrSlice>(input: S) -> String {
    return dump_pipeline(input).0;
}

test "the dump lowers through the emitter's primed context" {
    let [_, ctx] = dump_pipeline("grammar G; a : B c ; c : C ; B : 'b' ; C : 'c' ;");
    assert ctx.follow.is_exact("a"), "the dump must install FOLLOW before lowering, as `generate` does";
}

// `--atn` reports the same grammar the GIR dump does, so it reports the same
// lowering. Re-lowering it through `build_atn`'s fresh context instead reaches
// a table that knows none of the stamped ids.
test "the ATN dump builds off the lowering the dump already has" {
    let report = atn_dump_source("grammar G; a : B c ; c : C ; B : 'b' ; C : 'c' ;");
    assert report.contains("rule 0 'a'");
    assert report.contains("rule 1 'c'");
}

/// Render a hand-built `Grammar` as is. Not `cmd_dump`'s pipeline —
/// canonicalization would rewrite the very shape these tests assert on — so
/// what it pins is the report's structure, not the emitter's agreement with it.
/// `dump_pipeline` is the one that mirrors the command.
fn dump_grammar(g: &Grammar) -> String {
    let lit_tokens = no_lit_tokens();
    let mut ctx = LowerContext::new(GrammarAnalysis::new(&g.parser_rules), GenSettings {});
    let lowered = lower(g, &lit_tokens, &mut ctx);
    return render_dump(g, &lowered, &mut ctx);
}

fn no_lit_tokens() -> List<LitToken> {
    return [];
}

test "render_dump shows simple rule name and shape" {
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "value",
            Visibility::Default,
            [],
            [alt([Element::TokenRef(TokenRefElement::new("INT"))])],
        ),
    ];

    let report = dump_grammar(&g);

    assert report.contains("value");
    assert report.contains("Simple");
    // No diagnostics: the summary reports none.
    assert report.contains("warnings: none");
}

test "render_dump shows Direct dispatch for disjoint multi-alt" {
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [
                alt([Element::TokenRef(TokenRefElement::new("INT"))]),
                alt([Element::TokenRef(TokenRefElement::new("STRING"))]),
            ],
        ),
    ];

    let report = dump_grammar(&g);

    assert report.contains("expr");
    assert report.contains("Direct");
    // Each disjoint alt's first set appears.
    assert report.contains("TK_INT");
    assert report.contains("TK_STRING");
    assert report.contains("warnings: none");
}

test "render_dump shows Tournament and overlap warning" {
    // `r : ID INT | ID STRING ;` — both alts start with ID, so lowering
    // resolves the overlap with a scan tournament and raises an
    // OverlapTournament diagnostic.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::TokenRef(TokenRefElement::new("INT")),
                ]),
                alt([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::TokenRef(TokenRefElement::new("STRING")),
                ]),
            ],
        ),
    ];

    let report = dump_grammar(&g);

    assert report.contains("Tournament");
    // The diagnostic is inlined on the rule and listed in the summary.
    assert report.contains("warning");
    // The diagnostic names the rule and the shared lookahead token.
    assert report.contains("'r'");
    assert report.contains("TK_ID");
    // Summary shows a non-empty warnings section.
    assert report.contains("warnings (");
}

test "render_dump shows prediction tree for overlap group" {
    // `r : ID INT | ID STRING ;` — both alts start with ID, so the
    // overlap group runs the prediction tree: a depth-0 Consume on
    // TK_ID followed by a depth-1 Dispatch keyed on TK_INT / TK_STRING.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::TokenRef(TokenRefElement::new("INT")),
                ]),
                alt([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::TokenRef(TokenRefElement::new("STRING")),
                ]),
            ],
        ),
    ];

    let report = dump_grammar(&g);

    // The overlap-group prediction tree is rendered as its own section.
    assert report.contains("prediction");
    // The Consume on the shared ID prefix is named.
    assert report.contains("Consume");
    // The disambiguating Dispatch at depth 1 surfaces both branch
    // tokens and Leaf alt indices.
    assert report.contains("Dispatch");
    assert report.contains("Leaf");
    assert report.contains("TK_INT");
    assert report.contains("TK_STRING");
}

test "render_dump shows prediction tree for LR atom overlap" {
    // `expr : ID INT | ID STRING | expr '+' expr ;` — atom alts share
    // TK_ID; LR's atom dispatch therefore goes through the same
    // overlap-group prediction tree as a plain multi-alt rule.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [
                alt([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::TokenRef(TokenRefElement::new("INT")),
                ]),
                alt([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::TokenRef(TokenRefElement::new("STRING")),
                ]),
                alt([
                    Element::RuleRef(RuleRefElement::new("expr")),
                    Element::TokenRef(TokenRefElement::new("PLUS")),
                    Element::RuleRef(RuleRefElement::new("expr")),
                ]),
            ],
        ),
    ];

    let report = dump_grammar(&g);

    assert report.contains("LeftRecursive");
    assert report.contains("prediction");
    assert report.contains("Consume");
    assert report.contains("TK_INT");
    assert report.contains("TK_STRING");
}

test "render_dump annotates an Ambiguous leaf with its halt reason" {
    // `r : expr SEMI | expr DOT ; expr : ID | ID PLUS ID ;`
    //
    // Both alts of `r` start with the multi-token rule `expr`, so the
    // disambiguating SEMI / DOT sits behind a shared sub-rule the static
    // simulator cannot expand — an opaque-rule-ref halt. `expr` itself is
    // an at-end-vs-branch conflict: `ID` returns while `ID PLUS ID`
    // continues. The dump must name *why* each Ambiguous leaf appeared,
    // not just that it did.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::RuleRef(RuleRefElement::new("expr")),
                    Element::TokenRef(TokenRefElement::new("SEMI")),
                ]),
                alt([
                    Element::RuleRef(RuleRefElement::new("expr")),
                    Element::TokenRef(TokenRefElement::new("DOT")),
                ]),
            ],
        ),
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [
                alt([Element::TokenRef(TokenRefElement::new("ID"))]),
                alt([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::TokenRef(TokenRefElement::new("PLUS")),
                    Element::TokenRef(TokenRefElement::new("ID")),
                ]),
            ],
        ),
    ];

    let report = dump_grammar(&g);

    // The Ambiguous leaf still lists its alts ...
    assert report.contains("Ambiguous([");
    // ... and now carries a halt reason after the em dash.
    assert report.contains("Ambiguous([alt 0, alt 1]) — ");
    // `r`'s shared `expr` prefix is an opaque-rule-ref halt.
    assert report.contains("opaque rule-ref prefix");
    // `expr`'s `ID` vs `ID PLUS ID` is an at-end-vs-branch conflict.
    assert report.contains("at-end vs branch conflict");
}

test "render_dump inlines a group-scoped diagnostic under its owning rule" {
    // The overlap lives in a nested group, not in `r`'s own alternatives, so
    // the diagnostic's owner is the group. It still belongs to `r` and must
    // appear in `r`'s section — the owner carries the rule name, which no
    // amount of substring-matching on a `General group rGroup0` label
    // recovers.
    let g = "grammar G;
r : (ID INT | ID STR) ;
ID : 'a' ;
INT : '1' ;
STR : '\"' ;";
    let report = dump_source(&g);

    let head = section_of(&report, "r");
    assert head.contains("warning: overlap-tournament");
    assert head.contains("TK_ID");
    // And it is still listed once in the summary, under the group's label.
    assert report.contains("General group rGroup0:");
}

/// The `rule <name>` section of a dump report: from its header line to the
/// next rule header or the trailing summary, whichever comes first. A per-rule
/// assertion run against this cannot pass on text belonging to another rule or
/// to the summary, which repeats every diagnostic.
///
/// The header is matched whole (`rule r — Simple`, never a prefix of
/// `rule r2 — …`) and the summary opens with `warnings`, which is what bounds
/// the last rule's section.
fn section_of<S: AsStrSlice, S1: AsStrSlice>(report: S, rule_name: S1) -> String {
    let header = `rule ${rule_name} — `;
    let mut out = String::new();
    let mut inside = false;
    for let line of report.split("\n") {
        if line.starts_with("rule ") {
            inside = line.starts_with(header);
        } else if line.starts_with("warnings") {
            inside = false;
        }
        if inside {
            out.push_str(&line);
            out.push('\n');
        }
    }
    assert !out.is_empty();
    return out;
}

test "section_of isolates one rule from its neighbours and the summary" {
    // `r2` must not be swallowed by a `r` lookup, and the summary — which
    // repeats every diagnostic — must not leak into the last rule's section.
    let g = "grammar G;
r : (ID INT | ID STR) ;
r2 : ID ;
ID : 'a' ;
INT : '1' ;
STR : '\"' ;";
    let report = dump_source(&g);

    let r = section_of(&report, "r");
    assert r.contains("rule r — ");
    assert !r.contains("rule r2 — ");
    assert !r.contains("warnings (");

    // The last rule's section still stops before the summary.
    let r2 = section_of(&report, "r2");
    assert r2.contains("rule r2 — ");
    assert !r2.contains("warnings (");
    // ... which is where the group-scoped diagnostic is also listed.
    assert report.contains("General group rGroup0:");
}

test "render_dump keeps an at-end alt out of an expanded opaque dispatch" {
    // `e : a | b | X ;` over `a : X Y ; b : X Z ;` — alts 0 and 1 enter
    // multi-token rules the opaque expansion can separate on the second
    // token, while alt 2 is complete after `X`. Dispatching on that second
    // token would drop alt 2: what follows it belongs to `e`'s caller, so
    // no branch at this depth can claim it — the halt is an at-end conflict,
    // exactly as it is when no opaque rule ref is in the way.
    let g = "grammar O;
e : a | b | X ;
a : X Y ;
b : X Z ;
X : 'X' ;
Y : 'Y' ;
Z : 'Z' ;";
    let report = dump_source(&g);

    assert report.contains("Ambiguous([alt 2, alt 0, alt 1]) — at-end vs branch conflict");
    assert !report.contains("Leaf(alt ");
}

test "render_dump offers an open-ended alt on a token it does not name" {
    // `A? . C` admits every token through its `.`, so `b` is its token too:
    // the second token separates it from `B D` and `B E`, and only there is
    // `[TK_C]` a branch.
    let g = "grammar W;
r : A? . C | B D | B E ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
D : 'd' ;
E : 'e' ;";
    let r = section_of(&dump_source(&g), "r");

    assert r.contains("overlap group [alt 0, alt 1, alt 2]");
    assert r.contains("Dispatch[d=1]");
    assert r.contains("[TK_C] →");
    assert r.contains("Leaf(alt 1)");
    assert r.contains("Leaf(alt 2)");
}

test "render_dump shows LR loop-entry dispatch with conflict-min" {
    // `e : e '.' ID | e '.' ID '(' ')' | ID ;` — both LR suffixes start
    // with '.', so the precedence loop's entry decision is NOT token-led:
    // it falls back to precedence + second-token disambiguation. The dump
    // must surface each alt's conflict-min and flag the overlapping
    // loop-entry group (the "drop loop entry branch" ATN-class territory).
    let g = "grammar L;
e : e '.' ID | e '.' ID '(' ')' | ID ;
ID : [a-z]+ ;";
    let report = dump_source(&g);

    // Per-LR-alt precedence loop-entry bound.
    assert report.contains("conflict-min=");
    // The loop-entry section itself.
    assert report.contains("loop-entry:");
    // Both '.'-led suffixes land in one overlap group, flagged as
    // precedence-disambiguated (not token-led).
    assert report.contains("overlapping suffix first-sets");
}

test "render_dump renders a multi-token tail-greedy repeat rule" {
    // `item`'s loop gates on the FOLLOW its caller threads at runtime
    // (`follow_yields`), so there is no per-(rule, continuation) variant to print.
    let g = "grammar K;
prog : item X Y ;
item : (X Y)* ;
X : 'x' ;
Y : 'y' ;";
    let report = dump_source(&g);

    assert report.contains("prog");
    assert report.contains("item");
    assert !report.contains("follow-variants:");
}

test "render_dump keeps a lossy repeat-body entry off the common-terminal path" {
    // Entering `('x' 'y' | 'x' 'z')?` yields one config per body alternative,
    // all carrying the same grammar alt index. Keeping only `'x' 'y'` would
    // claim `'y'` as a terminal every alt shares, but `'x' 'z'` is a valid
    // prefix of both alts, so no such terminal exists.
    let g = "grammar D;
a : ('x' 'y' | 'x' 'z')? 'p'
  | ('x' 'y' | 'x' 'z')? 'q'
  ;";
    let report = dump_source(&g);

    assert !report.contains("Consume(TK_LIT_y)");
}

test "render_dump walks a multi-token repeat body reached through an opaque rule-ref" {
    // `p` sees `t` and `q` as opaque rule-refs and expands them. Stepping past
    // `(ID '::')*` inside `t` as one token would claim `ID` at depth 1 for `t`
    // and `'::'` for `q` alone — committing `a matches` to `t` and `a :: b` to
    // `q`. Neither token separates the alts here.
    let g = "grammar R;
p : t | q ;
t : (ID '::')* ID '`' ;
q : ID ('::' ID)* ;
ID : [a-z]+ ;";
    let p = section_of(&dump_source(&g), "p");

    assert !p.contains("Leaf(alt 0)");
    assert !p.contains("Leaf(alt 1)");
    assert p.contains("Ambiguous([alt 0, alt 1]) — opaque rule-ref prefix");
}

test "render_dump names each repeat's kind and the strategy that decides it" {
    let r = section_of(&dump_source("grammar D;
r : (A B)? C (A? B)? D (xs+=A)* E+ F .*? G ;
A : 'a' ; B : 'b' ; C : 'c' ; D : 'd' ; E : 'e' ; F : 'f' ; G : 'g' ;"), "r");

    assert r.contains("  repeats:
    ? → OptionalLookahead
    ? → OptionalShapeLookahead
    ? → Plain
    * → Plain
    + → Plain
    * → NonGreedy
");
}

test "render_dump marks a right-associative LR alt" {
    let e = section_of(&dump_source("grammar D;
e : <assoc=right> e '^' e | ID ;
ID : [a-z]+ ;"), "e");

    assert e.contains("alt 0 (Alt0) prec=1 conflict-min=1 right-assoc suffix-first=[TK_LIT_CARET]");
}

test "render_dump names a shared literal prefix by its token constant" {
    let k = section_of(&dump_source("grammar D;
k : 'k' A | 'k' B ;
A : 'a' ; B : 'b' ;"), "k");

    assert k.contains("Consume(TK_LIT_k)");
}

test "render_dump says why prediction halted: alts ending together, the depth limit, an open-ended alt" {
    let report = dump_source("grammar D;
dd : A | A {p()}? ;
deep : A (B|C) (B|C) (B|C) (B|C) (B|C) (B|C) D | A (B|C) (B|C) (B|C) (B|C) (B|C) (B|C) E ;
v : A ~B C | A ~B D ;
A : 'a' ; B : 'b' ; C : 'c' ; D : 'd' ; E : 'e' ;");

    let dd = section_of(&report, "dd");
    assert dd.contains("Ambiguous([alt 0, alt 1]) — multiple alts end together: true ambiguity");
    let deep = section_of(&report, "deep");
    assert deep.contains("Ambiguous([alt 0, alt 1]) — branch-depth limit (5) reached: needs unbounded lookahead");
    let v = section_of(&report, "v");
    assert v.contains("Ambiguous([alt 0, alt 1]) — no token named: an alt admits every one (`.` / `~X`)");
}

test "render_dump names an alternative an earlier one subsumes" {
    let report = dump_source("grammar D;
ee : A B? | A ;
A : 'a' ; B : 'b' ;");
    let ee = section_of(&report, "ee");
    assert ee.contains("alt 1 subsumed: an earlier alternative matches all it does, so it is never taken"), ee;
}

test "the ATN dump names every state and transition kind a grammar builds" {
    let report = atn_dump_source("grammar G;
e : e '+' e | A* B+ ~C . ;
A : 'a' ; B : 'b' ; C : 'c' ;");
    for let kind of ["StarLoopEntry", "StarLoopBack", "PlusLoopBack", "LoopEnd", "BlockStart", "BlockEnd"] {
        assert report.contains(` ${kind} rule=0`);
    }
    for let arrow of ["-notatom->", "-wild->", "-prec->", "-atom->", "-rule->", "-eps->"] {
        assert report.contains(arrow);
    }
}

// ===========================================================================
// Scan gates: which `@parser::members` fields a scan may simulate.
// ===========================================================================

use { gate_assignment, gate_scope_of, reads_only_scan_gate_fields } from "./scan_gate.wado";
use { Diagnostics } from "./gir.wado";

/// The simulable field set, reached as `generate` reaches it. Asked directly, it sees
/// no translated bodies, and every rejection below would pass for the wrong reason.
fn gate_fields(g: &Grammar) -> List<String> {
    let mut grammar = *g;
    canonicalize_for_analysis(&mut grammar);
    let mut diagnostics = Diagnostics {};
    return install_action_context(&mut grammar, GenSettings {}, &mut diagnostics).settings.scan_gate_fields;
}

// `gate_assignment` reads the translated body, not grammar text, so each input
// reaches the member through the parser handle under its declared name.
test "gate_assignment: a constant assignment" {
    let hit = gate_assignment("p.no_struct = 1;");
    assert hit matches { Some(_) };
    if let Some(h) = hit {
        assert h.0 == "no_struct";
        assert h.1 == 1;
    }
}

// A Wado grammar's member keeps its written name. Snake_casing it left every such
// grammar without a simulable gate.
test "gate_assignment: a member the translator did not rename" {
    let hit = gate_assignment("p.noBrace = 1;");
    assert hit matches { Some(_) };
    if let Some(h) = hit {
        assert h.0 == "noBrace";
        assert h.1 == 1;
    }
}

test "gate_assignment: whitespace and a missing semicolon" {
    let hit = gate_assignment("  p.no_struct   =   0  ");
    assert hit matches { Some(_) };
    if let Some(h) = hit {
        assert h.0 == "no_struct";
        assert h.1 == 0;
    }
}

test "gate_assignment: a negative constant" {
    let hit = gate_assignment("p.depth = -1;");
    assert hit matches { Some(_) };
    if let Some(h) = hit {
        assert h.1 == -1;
    }
}

// The rejection cases. Each is a body a scan cannot run by walking alone, so
// simulating it would answer with a value the parse never holds.
test "gate_assignment: a comparison is not an assignment" {
    assert gate_assignment("p.no_struct == 0") matches { None };
}

test "gate_assignment: an expression right-hand side" {
    assert gate_assignment("p.no_struct = p.no_struct + 1;") matches { None };
}

test "gate_assignment: a second statement" {
    assert gate_assignment("p.no_struct = 1; p.depth = 2;") matches { None };
}

test "gate_assignment: a call" {
    assert gate_assignment("p.reset();") matches { None };
}

// Not reached through the parser handle, so not a member write the scan can
// claim to run — a local, or a receiver the translator left standing.
test "gate_assignment: a write that does not go through the handle" {
    assert gate_assignment("no_struct = 1;") matches { None };
    assert gate_assignment("this.no_struct = 1;") matches { None };
}

test "gate_assignment: a subscript is not a member" {
    assert gate_assignment("p.stack[0] = 1;") matches { None };
}

// A gate scope is the save/restore a members field cannot express: each invocation
// keeps its own saved value. `$L` arrives as the rule's own value channel.
test "gate_scope: the @init / @after pair" {
    let s = gate_scope_of("vals.sv = p.no_struct; p.no_struct = 0;", "p.no_struct = vals.sv;");
    assert s matches { Some(_) };
    if let Some(g) = s {
        assert g.field == "no_struct";
        assert g.value == 0;
    }
}

test "gate_scope: a member the translator did not rename" {
    let s = gate_scope_of("vals.sv = p.noBrace; p.noBrace = 0;", "p.noBrace = vals.sv;");
    assert s matches { Some(_) };
    if let Some(g) = s {
        assert g.field == "noBrace";
    }
}

// The rejection cases. Each is a pair a scan cannot run as a save/restore, so
// running it anyway would leave the gate holding a value the parse never does.
test "gate_scope: a restore of a different field" {
    assert gate_scope_of("vals.sv = p.no_struct; p.no_struct = 0;", "p.depth = vals.sv;") matches { None };
}

test "gate_scope: a save the restore does not read" {
    assert gate_scope_of("vals.sv = p.no_struct; p.no_struct = 0;", "p.no_struct = vals.other;") matches { None };
}

test "gate_scope: a restore from something other than the value channel" {
    assert gate_scope_of("vals.sv = p.no_struct; p.no_struct = 0;", "p.no_struct = p.saved;") matches { None };
}

test "gate_scope: no @after is no scope" {
    assert gate_scope_of("vals.sv = p.no_struct; p.no_struct = 0;", "") matches { None };
}

// A field is simulated only if the scan runs every write, `@init` / `@after` included.
// Declared members give a bare name a field and `ScanGate` a type to copy.
global GATE_MEMBERS: String = "int noStruct = 0; int depth = 0; int other = 0;";

global SCOPE_BODY: String = "A";
global HEAD_BODY: String = "A { noStruct = 1; } A";

/// A grammar whose `scope` rule carries `init` and `after`, and whose `head` writes
/// the gate field plainly. Source, not IR, so the translator resolves `$sv`.
fn gate_source<S: AsStrSlice, S1: AsStrSlice = String, S2: AsStrSlice = String, S3: AsStrSlice = String>(
    init: S,
    after: S1 = "",
    scope_body: S2 = SCOPE_BODY,
    head_body: S3 = HEAD_BODY,
) -> String {
    let after_clause = if after.is_empty() { String::new() } else { `@after { ${after} }` };
    return `grammar G;
options { language = Java; }
@parser::members { ${GATE_MEMBERS} }
r : scope | head ;
scope
locals [int sv]
@init { ${init} }
${after_clause}
 : ${scope_body} ;
head : ${head_body} ;
A : 'a' ;
`;
}

fn gate_fields_of<S: AsStrSlice>(src: S) -> List<String> {
    let g = parse(src.to_string()).unwrap();
    return gate_fields(&g);
}

global GATE_SCOPE_INIT: String = "$sv = noStruct; noStruct = 0;";
global GATE_SCOPE_AFTER: String = "noStruct = $sv;";

test "scan_gate_fields: the recognised scope pair leaves its field simulable" {
    let f = gate_fields_of(&gate_source(&GATE_SCOPE_INIT, &GATE_SCOPE_AFTER));
    assert f == ["no_struct"];
}

// A left-recursive scan carries `min_prec`, so it takes no scope wrapper. The field
// goes everywhere, or other scans would restore a ban this one never lifts.
test "scan_gate_fields: a left-recursive rule's scope disqualifies its field" {
    let f = gate_fields_of(&gate_source(&GATE_SCOPE_INIT, &GATE_SCOPE_AFTER, "scope A | A"));
    assert f.is_empty();
}

test "scan_gate_fields: an unrunnable rule-level write disqualifies the field" {
    let f = gate_fields_of(&gate_source("noStruct = depth();"));
    assert f.is_empty();
}

// Every name in a body the scan cannot run is disqualified, not a list of write
// shapes. Any list misses one, and that field holds a value the parse never does.
test "scan_gate_fields: a compound assignment disqualifies the field" {
    for let op of ["+=", "|=", "&=", "^=", "%=", "<<=", ">>="] as List<String> {
        let f = gate_fields_of(&gate_source(`noStruct ${op} 1;`));
        assert f.is_empty();
    }
}

// Shapes an assignment-target matcher misses: the first hides a plain `f = 0` only
// a statement splitter finds, and the second has no `=` at all.
test "scan_gate_fields: a conditional write disqualifies the field" {
    for let body of ["if (c) noStruct = 0;", "while (c) noStruct = 0;", "for (;;) noStruct = 0;"] as List<String> {
        let f = gate_fields_of(&gate_source(&body));
        assert f.is_empty();
    }
}

test "scan_gate_fields: an increment disqualifies the field" {
    for let body of ["noStruct++;", "--noStruct;", "noStruct--;"] as List<String> {
        let f = gate_fields_of(&gate_source(&body));
        assert f.is_empty();
    }
}

// Naming the field disqualifies even a plain read. Over-rejecting only leaves the
// gate unsimulated.
test "scan_gate_fields: a body that merely names the field disqualifies it" {
    let f = gate_fields_of(&gate_source("noStruct;"));
    assert f.is_empty();
}

// A call names the method, not the field it writes, so no reading of the body
// says which fields it leaves alone. The whole set goes.
test "scan_gate_fields: a body that can call disqualifies every field" {
    let f = gate_fields_of(&gate_source("ban();"));
    assert f.is_empty();
}

// The rejection case for both rules above: a body that names something else and
// cannot call leaves the field alone, so the set is not simply always empty.
test "scan_gate_fields: a body naming other things leaves the field simulable" {
    let f = gate_fields_of(&gate_source("depth = depth + 1;"));
    assert f == ["no_struct"];
}

test "scan_gate_fields: a write through a receiver disqualifies the field" {
    let f = gate_fields_of(&gate_source("this.noStruct = depth();"));
    assert f.is_empty();
}

// The shapes an optional group is predicted by run no gate, so a scan cannot
// follow the group's actions however simply they are written.
test "scan_gate_fields: a write inside a group disqualifies the field" {
    let f = gate_fields_of(&gate_source(
        "other = 1;",
        "",
        &SCOPE_BODY,
        "A ( { noStruct = 0; } A | A ) A",
    ));
    assert f.is_empty();
}

// A condition the scan may evaluate reads simulated fields and nothing else.
test "reads_only_scan_gate_fields: a simulated field" {
    assert reads_only_scan_gate_fields("(gate.no_struct == 0)", &["no_struct"]);
}

test "reads_only_scan_gate_fields: two of them" {
    let fields = ["no_struct", "depth"] as List<String>;
    assert reads_only_scan_gate_fields("(gate.no_struct == 0 && gate.depth > 1)", &fields);
}

// One field name can be a prefix of another. Taking the short one out of the
// long one leaves `_tail`, which is a read of a field the gate does not have.
test "reads_only_scan_gate_fields: a field whose name extends a simulated one" {
    assert !reads_only_scan_gate_fields("(gate.no_struct_tail == 0)", &["no_struct"]);
}

test "reads_only_scan_gate_fields: the longer name, simulated, is read" {
    let fields = ["no_struct", "no_struct_tail"] as List<String>;
    assert reads_only_scan_gate_fields("(gate.no_struct_tail == 0)", &fields);
}

test "reads_only_scan_gate_fields: an unsimulated field" {
    assert !reads_only_scan_gate_fields("(gate.depth == 0)", &["no_struct"]);
}

test "reads_only_scan_gate_fields: a parser read" {
    assert !reads_only_scan_gate_fields("(p.no_struct == 0)", &["no_struct"]);
}

test "reads_only_scan_gate_fields: a constant, with no fields at all" {
    let none: List<String> = [];
    assert reads_only_scan_gate_fields("false", &none);
    assert reads_only_scan_gate_fields("(1 == 2 || true)", &none);
    assert !reads_only_scan_gate_fields("falsey", &none);
    assert !reads_only_scan_gate_fields("(p.no_struct == 0)", &none);
}

test "reads_only_scan_gate_fields: a call on the recognizer" {
    assert !reads_only_scan_gate_fields("pred_3(p)", &["no_struct"]);
}

// The caller reads three tokens past `a`, so a token after the body that the
// continuation could start with does not show it still parses there.
test "a tail repeat takes a token only where the continuation still parses past it, at its full depth" {
    let tokens = "X : 'x' ; Y : 'y' ; B : 'b' ; WS : ' ' -> skip ;\n";
    for let body of ["X?", "X*"] {
        let got = parses(`grammar R;\ns : a X X Y EOF ;\na : ${body} ;\n${tokens}`, "s", ["xxy", "xxxy"], &LONGEST);
        assert got == "xxy => (s a x x y)\nxxxy => (s (a x) x x y)\n", `${body}: ${got}`;
    }
    let got = parses(`grammar R;\ns : a X X Y EOF ;\na : X* ;\n${tokens}`, "s", ["xxxxy"], &LONGEST);
    assert got == "xxxxy => (s (a x x) x x y)\n";
    for let body of ["X?", "X*"] {
        let got = parses(
            `grammar R;\ns : t EOF ;\nt : a X X Y | a X B ;\na : ${body} ;\n${tokens}`,
            "s",
            ["xxy", "xb", "xxb"],
            &LONGEST,
        );
        assert got == "xxy => (s (t a x x y))\nxb => (s (t a x b))\nxxb => (s (t (a x) x b))\n", `${body}: ${got}`;
    }
}

// `.` takes any token but the end of the input, so the caller's `. EOF` cannot
// start at the last token's end, and a shape opening on `.` is still a shape.
test "a wildcard takes every kind but EOF, in a continuation and in a shape" {
    let tokens = "X : 'x' ; A : 'a' ; B : 'b' ; WS : ' ' -> skip ;\n";
    assert parses(`grammar R;\ns : a . EOF ;\na : X? ;\n${tokens}`, "s", ["x", "xx"], &LONGEST) == "x => (s a x)\nxx => (s (a x) x)\n";
    assert parses(`grammar R;\ns : r EOF ;\nr : (A? .)? ;\n${tokens}`, "s", ["b", "ab", "x"], &LONGEST) == "b => (s (r b))\nab => (s (r a b))\nx => (s (r x))\n";
    assert parses(`grammar R;\ns : r EOF ;\nr : (. A?)? ;\n${tokens}`, "s", ["b", "ba"], &LONGEST) == "b => (s (r b))\nba => (s (r b a))\n";
}

// Every shape of `(t A?)?` decides like any other optional: the caller's `X`
// starting at `x` does not stop the shape `t` that leaves it a parse.
test "a shape optional enters where its caller's continuation still parses after it" {
    let grammar = "grammar R;\ns : r X? EOF ;\nr : (t A?)? ;\nt : X ;\nX : 'x' ; A : 'a' ; WS : ' ' -> skip ;\n";
    let got = parses(grammar, "s", ["x", "xx", "xa"], &LONGEST);
    assert got == "x => (s (r (t x)))\nxx => (s (r (t x)) x)\nxa => (s (r (t x) a))\n";
}
