use {
    Grammar,
    GrammarKind,
    GrammarOption,
    OptionValue,
    ActionSource,
    NamedAction,
    ParserRule,
    Alternative,
    Element,
    TokenRefElement,
    LexerRule,
    Visibility,
    merge_grammars,
} from "./ir.wado";
use { generate, GenerateOptions, GeneratedOutput } from "./codegen.wado";
use { Diagnostic } from "./gir.wado";
use { PredictionMode } from "./gen_settings.wado";
use { parse_highlight_query } from "./highlight_query.wado";
use { parse, parse_checked } from "./g4/parser.wado";
use { count_occurrences } from "../tests/support/text.wado";
use { lexer_dump } from "../tests/support/fixtures.wado";
use { eval, EvalHost, Output } from "core:eval";
use { ModuleSpec, wado } from "lib:wadopoet";

global DEFAULT_OPTIONS: GenerateOptions = GenerateOptions {};

fn gen_with<S: AsStrSlice>(src: S, options: &GenerateOptions) -> GeneratedOutput {
    let mut g = parse_checked(src).unwrap();
    return generate(&mut g, options);
}

fn gen<S: AsStrSlice>(src: S) -> GeneratedOutput {
    return gen_with(src, &DEFAULT_OPTIONS);
}

fn gen_source<S: AsStrSlice>(src: S) -> String {
    return gen(src).source;
}

global LONGEST: GenerateOptions = GenerateOptions { prediction: PredictionMode::Longest };

/// The source a grammar generates where the static path settles every
/// decision, for a test of what that path emits.
fn longest_source<S: AsStrSlice>(src: S) -> String {
    return gen_with(src, &LONGEST).source;
}

fn unsupported_count(out: &GeneratedOutput) -> i32 {
    return out.diagnostics.iter_ref().filter(|d: &Diagnostic| d.kind matches { UnsupportedAction }).count();
}

fn diagnostics_saying<S: AsStrSlice>(out: &GeneratedOutput, text: S) -> i32 {
    return out.diagnostics.iter_ref().filter(|d: &Diagnostic| d.message.contains(text)).count();
}

/// What the parser generated from `grammar` makes of each input to `rule`, one
/// line each: `input => tree`, or `error`, then any action output. The error's
/// wording is left out: compatibility covers what is rejected, not how it reads.
fn parses<S: AsStrSlice>(
    grammar: S,
    rule: String,
    inputs: List<String>,
    options: &GenerateOptions = &DEFAULT_OPTIONS,
) -> String with EvalHost {
    return parses_each(grammar, inputs.into_iter().map(|input| [rule, input]).collect(), options);
}

/// `parses` for a grammar with several entry rules: each `[rule, input]` pair,
/// one line each.
fn parses_each<S: AsStrSlice>(
    grammar: S,
    cases: List<[String, String]>,
    options: &GenerateOptions = &DEFAULT_OPTIONS,
) -> String with EvalHost {
    let mut body = String::new();
    for let [rule, input] of cases {
        body.push_str(wado`show("${input}", parse_${rule}("${input}"));\n`);
    }
    return run_beside(gen_with(grammar, options).source, body, SHOW_FN).stdout;
}

/// The tokens the lexer generated from `grammar` makes of each input, one line
/// each: `input => NAME:text ...`, with `error` naming what no rule matched,
/// then any action output.
fn lexes<S: AsStrSlice>(grammar: S, inputs: List<String>) -> String with EvalHost {
    let mut body = String::new();
    for let input of inputs {
        body.push_str(wado`lex("${input}");\n`);
    }
    return printed(grammar, body, LEX_FN);
}

/// Runs `body` beside the parser generated from `grammar` and the `items`
/// declared with it, and returns what it printed.
fn printed<S: AsStrSlice>(grammar: S, body: String, items: String = "") -> String with EvalHost {
    return run_beside(gen_source(grammar), body, items).stdout;
}

/// What the traced parser generated from `grammar` logs while `body` runs.
fn traced<S: AsStrSlice>(grammar: S, body: String) -> String with EvalHost {
    let source = gen_with(grammar, &GenerateOptions { trace: true }).source;
    return run_beside(source, `trace_to_stderr(|| ${body});\n`).stderr;
}

/// Runs `body` beside the parser `source` and the `items` declared with it.
fn run_beside(source: String, body: String, items: String = "") -> Output with EvalHost {
    let out = eval_beside(source, body, items);
    assert out.status matches { Exited(0) };
    return out;
}

/// `run_beside` for a run that may trap.
fn eval_beside(source: String, body: String, items: String = "") -> Output with EvalHost {
    // The generated source opens with inner attributes, which come first.
    return eval(`${source}
use { println, Stdout } from "core:cli";
${items}
export fn run() with Stdout {
${body}}
`).unwrap();
}

// `SHOW_FN` and `SHOW_TOKENS_FN` are `"..."` literals, so their holes are the
// generated program's own.

global SHOW_FN: String = "fn show(input: String, r: ParseResult) with Stdout {
    let shown = if r.ok() { to_string_tree(&r) } else { \"error\" };
    let output = if r.output.is_empty() { \"\" } else { ` [${r.output}]` };
    println(`${input} => ${shown}${output}`);
}";

global SHOW_TOKENS_FN: String = "fn show_tokens(label: String, toks: &TokenStream) with Stdout {
    let mut line = `${label} =>`;
    for let mut i = 0; toks.kind_at(i) != TK_EOF; i += 1 {
        let name = if toks.is_lex_error(i) { \"error\" } else { token_kind_name(toks.kind_at(i)) };
        line.push_str(` ${name}:${toks.token_text(i)}`);
    }
    if !toks.output.is_empty() {
        line.push_str(` [${toks.output}]`);
    }
    println(line);
}";

// A lexer base's handler calls `show_tokens` itself, since `tokenize` then
// carries the base's effect.
global LEX_FN: String = `${SHOW_TOKENS_FN}

fn lex(input: String) with Stdout {
    show_tokens(input, &tokenize(input));
}`;

test "generate header" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.len() > 0;
    // No source file is recorded, so none is named, rather than a nonexistent
    // `{name}.g4`.
    let header = "#![generated(by = \"gale\")]\n";
    for let mut i = 0; i < header.len(); i += 1 {
        assert output.byte_at(i) == header.byte_at(i);
    }
}

test "generate header with multiple source files" {
    let mut grammar = Grammar {
        name: "Html",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: ["HtmlLexer.g4", "HtmlParser.g4"],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let header = `#![generated(by = "gale", sources = ["HtmlLexer.g4", "HtmlParser.g4"])]`;
    for let mut i = 0; i < header.len(); i += 1 {
        assert output.byte_at(i) == header.byte_at(i);
    }
}

test "generate opens with the module it is given" {
    let mut grammar = Grammar {
        name: "Calc",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: ["Calc.g4"],
    };
    let module = ModuleSpec::new("wado-lang:gale", ["src/Calc.g4"]);
    let output = generate(&mut grammar, &GenerateOptions { module: Option::Some(module) }).source;
    assert output.starts_with("#![generated(by = \"wado-lang:gale\", sources = [\"src/Calc.g4\"])]\n");
}

test "generate token kind" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [
            LexerRule::new("NUMBER", false, false, []),
            LexerRule::new("DIGIT", true, false, []),
            LexerRule::new("WS", false, true, []),
        ],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("pub global TK_NUMBER: i32 = 0;");
    assert output.contains("pub global TK_WS: i32 = 1;");
    assert output.contains("pub global TK_EOF: i32 = 2;");
    assert output.contains("pub global TK_ERROR: i32 = 3;");
    assert !output.contains("TK_DIGIT");
    assert !output.contains("enum TokenKind");
}

test "node-kind constants are pub so consumers can dispatch on CstNode.kind" {
    let output = gen_source("grammar T; prog : expr ; expr : INT ; INT : [0-9]+ ;");
    assert output.contains("pub global RK_PROG:");
    assert output.contains("pub global RK_EXPR:");
    // No non-pub `global RK_` line should remain.
    assert !output.contains("\nglobal RK_");
}

test "duplicate same-rule alt labels coalesce to one enum case (valid in ANTLR4)" {
    // ANTLR4 shares one context class across a repeated `# Label`, so the `<Rule>Alt`
    // enum emits it once, and the accessor maps every alt index to it.
    let input = "grammar Test;
e : e '+' e # Bin | e '-' e # Bin | INT # Num ;
INT : [0-9]+ ;
WS : [ \\t\\r\\n]+ -> skip ;
";
    let got = printed(input, "for let s of [\"1+2\", \"1-2\", \"3\"] {
    println(`${s} => ${parse_e(s).cst.e_alt(0):?}`);
}
");
    assert got == "1+2 => Option::Some(EAlt::Bin)\n1-2 => Option::Some(EAlt::Bin)\n3 => Option::Some(EAlt::Num)\n";
}

test "reserved-word alt labels are escaped to valid identifiers" {
    // A reserved-word label (`# else`) is escaped with `_` or it does not compile; a
    // label the prelude also names (`# Add`) lives in its enum and stays unchanged.
    let input = "grammar Test;
r : A # else | B # loop | C # Keep | D # Add ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
D : 'd' ;
";
    let got = printed(input, "for let s of [\"a\", \"b\", \"c\", \"d\"] {
    println(`${s} => ${parse_r(s).cst.r_alt(0):?}`);
}
");
    assert got == "a => Option::Some(RAlt::else_)
b => Option::Some(RAlt::loop_)
c => Option::Some(RAlt::Keep)
d => Option::Some(RAlt::Add)
";
}

test "generate parser not element" {
    let got = parses("grammar T;
a : ~COMMA EOF ;
COMMA : ',' ;
X : 'x' ;
", "a", ["x", ","]);
    assert got == "x => (a x)\n, => error\n";
}

test "generate scalar-labeled group `t=(a | b)`" {
    // Sets/ParserSet.txt: the op is a Group while the element is still
    // `Label(Group)`, so the walker peels the label before `gen_op_group`.
    let got = parses("grammar T; a : t=('x' | 'y') ; B : 'b' ;", "a", ["x", "y", "b"]);
    assert got == "x => (a x)\ny => (a y)\nb => error\n";
}

test "generate scalar-labeled wildcard repeat `t=.*`" {
    // A suffix binds outside the label, so this is Repeat(Label(Wildcard)):
    // the walker peels the Label inside the body, not at the Repeat itself.
    let got = parses("grammar T; a : t=.* ; A : 'a' ;", "a", ["", "a", "aa"]);
    assert got == " => a\na => (a a)\naa => (a a a)\n";
}

test "LR scan loop saves pos and backs off on a suffix failure" {
    // Both alts start with `a`, so a suffix scan can fail after its first token; the
    // loop then restores `pos` and stops, as ANTLR4 keeps the longest valid prefix.
    // The two `prog` alternatives share `statement`, so the dispatch scans it.
    let input = "grammar Test;
prog : statement 'x' EOF | statement 'y' EOF ;
statement : letterA | statement letterA 'b' ;
letterA : 'a' ;
";
    let got = parses(input, "prog", ["ax", "aaby", "aax"]);
    assert got == "ax => (prog (statement (letterA a)) x)
aaby => (prog (statement (statement (letterA a)) (letterA a) b) y)
aax => error
";
}

test "generate emits pub fn parse_<rule>(input) per parser rule" {
    // `parse_R(input)` is the start-rule API; `parse(input)` stays as the first rule's
    // alias, which driver tests and descriptors without a `[start]` call.
    let input = "grammar Test;
a : 'x' ;
b : 'y' ;
";
    let output = gen_source(input);
    assert output.contains("pub fn parse_a<S: AsStrSlice>(input: S");
    assert output.contains("pub fn parse_b<S: AsStrSlice>(input: S");
    // Each `parse_<rule>` hands its `_parse_<rule>` to the shared `_run_parse_entry`,
    // which builds the Parser and folds the error into the diagnostics.
    assert output.contains(
        "fn _run_parse_entry<S: AsStrSlice>(input: S, max_errors: i32, entry: fn(&mut Parser)) -> ParseResult",
    );
    assert output.contains("return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_a(p));");
    assert output.contains("return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_b(p));");
    // `pub fn parse` is a thin alias for the first rule's entry.
    assert output.contains("return parse_a(input, max_errors);");
}

test "trace option emits per-rule enter/ok/fail instrumentation" {
    // Tracing shows the recursive-descent path and the bail point on stderr
    // when a grammar rejects an input.
    let input = "grammar Test;
c : a a EOF ;
a : 'x' b ;
b : 'y' ;
";
    // The first error is recovered from; with none left to report, the second
    // fails every rule it is inside.
    let log = traced(input, "parse_c(\"xzxz\", 1)");
    assert log == "TRACE gale.trace: enter c @0 'x' rule=c pos=0
TRACE gale.trace:   enter a @0 'x' rule=a pos=0
TRACE gale.trace:     enter b @1 'z' rule=b pos=1
TRACE gale.trace:     ok b rule=b
TRACE gale.trace:   ok a rule=a
TRACE gale.trace:   enter a @2 'x' rule=a pos=2
TRACE gale.trace:     enter b @3 'z' rule=b pos=3
TRACE gale.trace:     FAIL b: expected 'y'; got \"z\" rule=b reason=expected 'y'; got \"z\"
TRACE gale.trace:   FAIL a: expected 'y'; got \"z\" rule=a reason=expected 'y'; got \"z\"
TRACE gale.trace: FAIL c: expected 'y'; got \"z\" rule=c reason=expected 'y'; got \"z\"
";

    // Default generation (trace off) must contain none of it — the feature
    // is strictly opt-in and adds zero instrumentation otherwise.
    let plain = gen_source(input);
    assert !plain.contains("trace_enter");
    assert !plain.contains("trace_depth");
    assert !plain.contains("core:log");
}

test "token-led overlap dispatch emits no per-alt scan helpers" {
    // The alts split on the second token, so prediction is a `peek_kind` dispatch
    // and the per-alt scan helpers would be dead.
    let input = "grammar T;
r : '{' a '}' | '{' '}' ;
a : 'x' ;
";
    let output = gen_source(input);
    // Both alts are reached (the group resolved, not collapsed)...
    assert output.contains("fn _parse_r__inner_alt_0(");
    assert output.contains("fn _parse_r__inner_alt_1(");
    // ...but neither scan helper is emitted.
    assert !output.contains("fn scan_r__alt_");

    // A shared-prefix tournament rule still emits its scan helpers, so the
    // gate is not over-pruning.
    let tinput = "grammar T;
s : X s Y? | X ;
X : 'X' ;
Y : 'Y' ;
";
    let tout = gen_source(tinput);
    assert tout.contains("fn scan_s__alt_0(");
}

test "an alternative's scan helper is emitted once for the scan and the parse" {
    // Alt 0 is contested in `scan_r`, which the group in `s` scans, so the scan
    // side emits its function; the parse side's tournament scans it too, and
    // must call that function.
    let input = "grammar T;
s : (r X | r Y) EOF ;
r : ID '=' e | e ;
e : ID | INT ;
ID : [a-z]+ ;
INT : [0-9]+ ;
X : 'X' ;
Y : 'Y' ;
";
    let output = gen_source(input);
    assert output.split("fn scan_r__alt_0(").count() == 2, "defined once";
    assert output.contains("let _sd_p_0 = scan_r__alt_0(_sd_tokens, _sd_pos");
}

test "a scan never re-tests a token its guard already proved" {
    // `(',' b)*` enters on `','`, and `('*' | '/')` is one token out of two.
    let input = "grammar T;
s : (a | a X) EOF ;
a : b (',' b)* ('*' | '/') ;
b : Y ;
X : 'X' ;
Y : 'Y' ;
";
    let output = longest_source(input);
    let body = extract_fn_body(&output, "fn scan_a(");
    assert body.contains("while pos < tokens.len() && tokens[pos] == TK_LIT_COMMA");
    assert !body.contains("tokens[pos] != TK_LIT_COMMA"), "the loop guard proved ','";
    assert !body.contains("_best"), "a single-token alternation is a set test, not a tournament";
}

test "a token the dispatch decided is taken, not expected" {
    let input = "grammar T;
s : r EOF ;
r : A B | C B | t ;
t : A2 | C2 ;
A : 'A' ;
B : 'B' ;
C : 'C' ;
A2 : 'a' ;
C2 : 'c' ;
";
    let output = gen_source(input);
    let r = extract_fn_body(&output, "fn _parse_r__inner(");
    assert r.contains("p.take();");
    assert !r.contains("p.expect(TK_A,"), "the dispatch proved A";
    assert r.contains("p.expect(TK_B,");
    let t = extract_fn_body(&output, "fn _parse_t__inner(");
    assert t.contains("p.take();");
    assert !t.contains("p.expect(kind"), "the dispatch proved the token";
}

test "a loop scans its body only where the token it enters on may also exit it" {
    // `fs`'s loop may end the rule, and `p` continues it with `','` too.
    let input = "grammar T;
s : e EOF | p EOF ;
e : t (('+' | '-') t)* ;
t : Y ;
p : '{' fs (',' '..')? '}' ;
fs : t (',' t)* ;
Y : 'Y' ;
";
    let output = longest_source(input);
    let e = extract_fn_body(&output, "fn _parse_e__inner(");
    assert e.contains("while !p.recovering && _kind_set_0(p.peek_kind())");
    assert e.contains("p.take();"), "the loop guard proved the operator";
    assert !e.contains("sync_alts"), "the loop guard proved the operator";
    let fs = extract_fn_body(&output, "fn _parse_fs__inner(");
    assert fs.contains("loop {");
}

test "a dispatch never re-tests the token its arm tested" {
    let input = "grammar T;
s : r e EOF ;
r : a | b ;
a : X Y* ;
b : X Y* Z ;
e : e '.' ID | e '.' ID '(' ')' | ID ;
X : 'x' ;
Y : 'y' ;
Z : 'z' ;
ID : [a-w]+ ;
";
    let output = gen_source(input);
    let mut prev = "";
    for let line of output.split("\n") {
        let t = line.trim().to_string();
        assert !(t.starts_with("if ") && t.ends_with("{") && t == prev);
        prev = t;
    }
}

test "a scan tests a one-token rule inline, and trusts a callee that consumes" {
    let input = "grammar T;
s : (n | n K1)* EOF ;
n : a K2? ;
a : ID | k | '(' a ')' ;
k : K1 | K2 ;
ID : [a-z]+ ;
K1 : 'K' ;
K2 : 'J' ;
";
    let output = longest_source(input);
    let a = extract_fn_body(&output, "fn scan_a(");
    assert !a.contains("scan_k("), "the partition proved k's token";
    let n = extract_fn_body(&output, "fn scan_n(");
    assert !n.contains("scan_start"), "scan_a never matches empty";
}

test "a scan candidate that runs first does not rewind to where it is" {
    let input = "grammar T;
s : (a | a Z)* EOF ;
a : X | m ;
m : Y Y ;
X : 'x' ; Y : 'y' ; Z : 'z' ;
";
    let output = longest_source(input);
    let a = extract_fn_body(&output, "fn scan_a(");
    assert a.contains("scan_m(");
    assert !a.contains("pos = start;");
}

test "a scan calls through a rule that only forwards to another" {
    let input = "grammar T;
s : (t | t Z)* EOF ;
t : n X ;
n : a ;
a : Y Y | X Y ;
X : 'x' ; Y : 'y' ; Z : 'z' ;
";
    let output = longest_source(input);
    let t = extract_fn_body(&output, "fn scan_t(");
    assert t.contains("scan_a(");
    assert !output.contains("fn scan_n(");
}

test "a scan function nothing calls is not emitted" {
    let input = "grammar T;
s : a b EOF ;
a : X Y ;
b : (c | c Z)* ;
c : W+ ;
X : 'x' ; Y : 'y' ; Z : 'z' ; W : 'w' ;
";
    let output = longest_source(input);
    assert !output.contains("fn scan_a(");
    assert output.contains("fn scan_c(");
}

// Generating SQLite alone takes about the default five seconds.
#[timeout_ms(30000)]
test "every emitted FOLLOW site is named by a call" {
    let output = gen_source(#include_str("../tests/grammars/SQLite.g4"));
    let mut sites = 0;
    for let line of output.split("\n") {
        if !line.starts_with("global FOLLOW_SITE_") {
            continue;
        }
        sites += 1;
        let name = line.split(":").next().unwrap().to_string().split(" ").last().unwrap().to_string();
        assert output.contains(`${name},`) || output.contains(`${name})`) || output.contains(`${name} `);
    }
    assert sites > 0, "SQLite interns FOLLOW sites";
}

test "an optional takes the token its guard tested" {
    let input = "grammar T;
s : A B? (C D)? (E | F)? G EOF ;
A : 'a' ; B : 'b' ; C : 'c' ; D : 'd' ; E : 'e' ; F : 'f' ; G : 'g' ;
";
    let output = gen_source(input);
    let body = extract_fn_body(&output, "fn _parse_s__inner(");
    assert !body.contains("p.expect(TK_B");
    assert !body.contains("p.expect(TK_C");
    assert !body.contains("p.expect_set(");
    assert body.contains("p.expect(TK_D");
}

test "an LR suffix takes the operator its arm tested" {
    let input = "grammar T;
s : e EOF ;
e : e '+' e | e '.' ID | e '.' ID '(' ')' | ID ;
ID : [a-z]+ ;
";
    let output = gen_source(input);
    let body = extract_fn_body(&output, "fn _parse_e__inner(");
    assert !body.contains("p.expect(TK_LIT_PLUS");
    assert !body.contains("p.expect(TK_LIT_DOT");
}

test "a ternary's last operand climbs past a suffix that opens with its `?`" {
    // TypeScript's `singleExpression '?'? '.' identifierName` beside its
    // ternary. Trees from the jar.
    let got = parses("grammar T;
s : e EOF ;
e : e '?'? '.' ID | e '*' e | e '?' e ':' e | ID ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
", "s", ["a ? s : x * y", "a ? s : x . y", "a ? s : x", "a ? . b"]);
    assert got == "a ? s : x * y => (s (e (e a) ? (e s) : (e (e x) * (e y))))
a ? s : x . y => (s (e (e a) ? (e s) : (e (e x) . y)))
a ? s : x => (s (e (e a) ? (e s) : (e x)))
a ? . b => (s (e (e a) ? . b))
";
}

test "a prefix operator set takes the token its arm tested" {
    let input = "grammar T;
s : e EOF ;
e : e '*' e | ('-' | '!') e | ID ;
ID : [a-z]+ ;
";
    let output = gen_source(input);
    let body = extract_fn_body(&output, "fn _parse_e__inner_atom(");
    assert !body.contains("p.expect_set(");
}

test "a function that only forwards is not emitted" {
    let input = "grammar T;
s : (r | r X)* EOF ;
r : n | n Y | z ;
n : A B ;
z : A ;
A : 'a' ; B : 'b' ; X : 'x' ; Y : 'y' ;
";
    let output = gen_source(input);
    for let name of ["fn _parse_r__inner_alt_0(", "fn scan_r_alt_0(", "fn _parse_z__inner("] {
        assert !output.contains(name);
    }
}

test "a rule's @after is emitted once, whichever alternative finished" {
    let input = "grammar T;
options { language = Wado; }
r returns [i32 v]
    @after { p.emit(`a${$v}`); }
    : A { $v = 1; }
    | B { $v = 2; }
    | s
    | s C
    ;
s : A+ ;
A : 'a' ; B : 'b' ; C : 'c' ;
";
    let output = gen_source(input);
    assert count_occurrences(&output, "p.emit(`a${") == 1;
}

test "arms that emit the same body are one arm" {
    let input = "grammar T;
s : (l | l X)* e EOF ;
l : A | B | C D ;
e : e NOT? (L | G) e | e NOT N | ID ;
A : 'a' ; B : 'b' ; C : 'c' ; D : 'd' ; X : 'x' ; L : 'l' ; G : 'g' ; N : 'n' ; NOT : '!' ;
ID : [e-k]+ ;
";
    let output = longest_source(input);
    for let f of ["fn scan_l(", "fn _parse_l__inner("] {
        let body = extract_fn_body(&output, f);
        assert !body.contains("if kind == TK_A {");
    }
    for let arm of ["suffix_kind == TK_L", "_sk == TK_L"] {
        assert !output.contains(arm);
    }
}

test "a group arm takes the token its branch tested" {
    let input = "grammar T;
s : (A B | C D) e EOF ;
e : e '*' e | e (X | Y Z) | e (Q ID)? '!' | ID ;
A : 'a' ; B : 'b' ; C : 'c' ; D : 'd' ; X : 'x' ; Y : 'y' ; Z : 'z' ; Q : 'q' ;
ID : [e-p]+ ;
";
    let output = gen_source(input);
    for let kind of ["TK_A", "TK_C", "TK_Y", "TK_Q"] {
        assert !output.contains(`p.expect(${kind},`);
    }
}

test "an element is bound only where an action reads it" {
    let input = "grammar T;
options { language = Wado; }
s : x=A B {let _ = $x;} ;
A : 'A' ;
B : 'B' ;
";
    let output = gen_source(input);
    let body = extract_fn_body(&output, "fn _parse_s__inner(");
    assert body.contains("let x = p.expect(TK_A");
    assert body.contains("    p.expect(TK_B");
}

test "trace option instruments the scan tournament and alt picks" {
    // `Z X` vs `b` share `Z`, and no caller continues on `X`. A second `Z`
    // matches no branch of the static tree, so the scan tournament decides;
    // trace shows each alt's scan length and the winner.
    let input = "grammar T;
r : a EOF ;
a : Z X
  | b
  ;
b : Z | X ;
X : 'X' ;
Z : 'Z' ;
";
    let log = traced(input, "parse_r(\"ZZ\")");
    assert log.contains("scan a alt#0: fail rule=a alt=0 end=-1
TRACE gale.trace:       scan a alt#1: -> @1 rule=a alt=1 end=1
TRACE gale.trace:       pick a alt#1 rule=a alt=1
");

    // Default generation (trace off) emits none of the decision-point hooks.
    let plain = gen_source(input);
    assert !plain.contains("trace_scan_alt");
    assert !plain.contains("trace_pick");
    assert !plain.contains("trace_try");
}

// `b` hides the token that tells `b X` from `b`, so the static tree gives up.
global OPAQUE_PREFIX_G4: String = "grammar T;
r : a EOF ;
a : b X | b ;
b : Z Z ;
X : 'X' ;
Z : 'Z' ;
";

test "longest leaves an ambiguity the simulator decides by default to the tournament" {
    assert gen_source(OPAQUE_PREFIX_G4).contains("atn_predict_once(&ATN_SIM, ");
    let longest = gen_with(OPAQUE_PREFIX_G4, &LONGEST);
    assert !longest.source.contains("ATN_SIM");
    assert longest.source.contains("scan_a__alt_0(_sd_tokens, _sd_pos)");
    assert !longest.diagnostics.iter_ref().any(|d: &Diagnostic| d.kind matches { SimulatorRequired });
}

// `c` takes what `f` takes with a `U A` at least, and wins the tie by its
// lower index, so `f` wins only where `c` fails.
global FALLBACK_LAST_G4: String = "grammar T;
s : t (c | f) EOF ;
t : c | f ;
c : A (U A)+ ;
f : A (U A)* ;
A : 'A' ;
U : 'U' ;
WS : ' ' -> skip ;
";

test "a tournament scans the alternative it falls back to only once another won" {
    let source = longest_source(FALLBACK_LAST_G4);
    let rule = extract_fn_body(&source, "fn _parse_t__inner(");
    assert rule.contains("let _sd_p_1 = if _sd_p_0 >= 0 { scan_"), rule;
    let group = extract_fn_body(&source, "fn _parse_s__inner(");
    assert group.contains("if gd_best >= 0 {"), group;
    let trees = parses(FALLBACK_LAST_G4, "s", ["A U A A", "A A U A"], &LONGEST);
    assert trees == "A U A A => (s (t (c A U A)) (f A))\nA A U A => (s (t (f A)) (c A U A))\n";
}

// `Z Z X` reads either way. The simulator takes the lower alternative, `b`, and
// the tournament the longer, `b X`.
global OPAQUE_CONTINUED_G4: String = "grammar T;
r : a X* EOF ;
a : b | b X ;
b : Z Z ;
X : 'X' ;
Z : 'Z' ;
WS : ' ' -> skip ;
";

test "verify builds exact's tree and reports where the tournament picks otherwise" {
    let verify = GenerateOptions { prediction: PredictionMode::Verify };
    assert parses(OPAQUE_CONTINUED_G4, "r", ["Z Z"], &verify) == "Z Z => (r (a (b Z Z)))\n";
    assert parses(OPAQUE_CONTINUED_G4, "r", ["Z Z X"]) == "Z Z X => (r (a (b Z Z)) X)\n";
    assert parses(OPAQUE_CONTINUED_G4, "r", ["Z Z X"], &LONGEST) == "Z Z X => (r (a (b Z Z) X))\n";
    let out = eval_beside(
        gen_with(OPAQUE_CONTINUED_G4, &verify).source,
        wado`show("Z Z X", parse_r("Z Z X"));\n`,
        SHOW_FN,
    );
    assert !out.status matches { Exited(0) };
    assert out.stderr.contains("prediction verify: decision "), out.stderr;
    assert out.stderr.contains(" at token 0: the tournament picks 1, the simulator 0"), out.stderr;
    // A syntax error later in the input outweighs the report.
    assert parses(OPAQUE_CONTINUED_G4, "r", ["Z Z X Z"], &verify) == "Z Z X Z => error\n";
}

// `(a | a B)` shares `a`, which hides the deciding token. The tournament takes
// the longest scan, `a B`, and strands the `B` the rule still owes.
global GROUP_LONGEST_G4: String = "grammar G;
s : (a | a B) B EOF ;
a : A+ ;
A : 'a' ;
B : 'b' ;
WS : ' ' -> skip ;
";

test "exact lets the simulator decide a group" {
    let inputs: List<String> = ["a b", "a b b"];
    assert parses(GROUP_LONGEST_G4, "s", inputs) == "a b => (s (a a) b)\na b b => (s (a a) b b)\n";
    assert parses(GROUP_LONGEST_G4, "s", inputs, &LONGEST) == "a b => error\na b b => (s (a a) b b)\n";
}

test "verify checks a group's tournament against the simulator" {
    let verify = GenerateOptions { prediction: PredictionMode::Verify };
    assert parses(GROUP_LONGEST_G4, "s", ["a b b"], &verify) == "a b b => (s (a a) b b)\n";
    let out = eval_beside(gen_with(GROUP_LONGEST_G4, &verify).source, wado`show("a b", parse_s("a b"));\n`, SHOW_FN);
    assert !out.status matches { Exited(0) };
    assert out.stderr.contains(" at token 0: the tournament picks 1, the simulator 0");
}

// The atoms `n …` and `f …` share `any`, and one holds a group tournament, so
// both checks run in helpers of a left-recursive rule, which read its
// `min_prec`.
global LR_GROUP_CHECK_G4: String = "grammar L;
s : e EOF ;
e : e '+' e | n (a | a B) | f '(' ')' | INT ;
n : any ;
f : any ;
any : ID | '(' any ')' ;
a : A+ ;
A : 'a' ;
B : 'b' ;
ID : [x-z]+ ;
INT : [0-9]+ ;
WS : ' ' -> skip ;
";

test "verify checks a group inside a left-recursive rule's atom" {
    let verify = GenerateOptions { prediction: PredictionMode::Verify };
    let inputs: List<String> = ["x a b + 1", "1 + y ( )"];
    assert parses(LR_GROUP_CHECK_G4, "s", inputs, &verify) == parses(LR_GROUP_CHECK_G4, "s", inputs);
}

// The atom choice reads past `any`'s nesting, so the simulator owns it, and the
// LR loop decides through its table.
global VERIFIED_LR_G4: String = "grammar L;
s : K_SEL e (K_ORD ID)? EOF ;
e : e '||' e | e '=' e | e 'and' e | e 'btw' e 'and' e | n | f '(' ')' | '(' e ')' | INT ;
n : any ;
f : any ;
any : ID | '(' any ')' ;
K_SEL : 'sel' ;
K_ORD : 'ord' ;
ID : [a-z]+ ;
INT : [0-9]+ ;
WS : ' ' -> skip ;
";

test "verify checks the atom's tournament against the simulator" {
    let verify = GenerateOptions { prediction: PredictionMode::Verify };
    let source = gen_with(VERIFIED_LR_G4, &verify).source;
    assert source.contains("atn_verified(");
    assert !gen_source(VERIFIED_LR_G4).contains("atn_verified(");
    let inputs: List<String> = [
        "sel a = 1 ord b", "sel (a) = f() ord b", "sel ((a)) || 1 = (b)", "sel a btw 1 and 2 and b = 3",
        "sel a and b btw c and d",
    ];
    assert parses(VERIFIED_LR_G4, "s", inputs, &verify) == parses(VERIFIED_LR_G4, "s", inputs);
}

// `type(99)` lexes a kind past the grammar's, which only `.` takes (see "Bugs
// in ANTLR4 itself"). Each table the generator builds covers the grammar's
// kinds, so it must not turn this one away: the lookahead DFA's widest edge
// here settles on the set, the LR loop's `_` exits, and a rule's sync set
// lists the grammar's kinds alone.
global FOREIGN_KIND_G4: String = "grammar T;
r : a X EOF ;
a : b (A | B | C | D | E | F | G) | b . ;
b : Z Z ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
D : 'd' ;
E : 'e' ;
F : 'f' ;
G : 'g' ;
X : 'x' ;
Z : 'z' ;
Q : 'q' -> type(99) ;
WS : ' ' -> skip ;
";

global FOREIGN_KIND_LR_G4: String = "grammar L;
s : e EOF ;
e : e '+' e | e . INT | INT ;
INT : [0-9]+ ;
Q : 'q' -> type(99) ;
WS : ' ' -> skip ;
";

global FOREIGN_KIND_STATIC_G4: String = "grammar S;
r : (A X | . Y) EOF ;
A : 'a' ;
X : 'x' ;
Y : 'y' ;
Q : 'q' -> type(99) ;
WS : ' ' -> skip ;
";

test "a wildcard takes a kind past the grammar's" {
    let dfa: List<String> = ["z z q x", "z z a x"];
    assert parses(FOREIGN_KIND_G4, "r", dfa) == "z z q x => (r (a (b z z) q) x)\nz z a x => (r (a (b z z) a) x)\n";
    let lr: List<String> = ["1 q 2", "1 + 2"];
    assert parses(FOREIGN_KIND_LR_G4, "s", lr) == "1 q 2 => (s (e (e 1) q 2))\n1 + 2 => (s (e (e 1) + (e 2)))\n";
    let static: List<String> = ["q y", "a x"];
    assert parses(FOREIGN_KIND_STATIC_G4, "r", static) == "q y => (r q y)\na x => (r a x)\n";
    let loop_g4 = "grammar N;\nr : (~A)* A EOF ;\nA : 'a' ;\nB : 'b' ;\nQ : 'q' -> type(99) ;\nWS : ' ' -> skip ;\n";
    let looped: List<String> = ["q b q a", "a"];
    assert parses(loop_g4, "r", looped) == "q b q a => (r q b q a)\na => (r a)\n";
}

// Each repeat's body can start what follows it, so its first token does not say
// whether it enters. The trees are the jar's.
global CONTESTED_REPEATS_G4: String = "grammar R;
s : a* a B EOF ;
t : C c? c EOF ;
u : (A | B)+ A B EOF ;
a : A ;
c : D+ ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
D : 'd' ;
WS : ' ' -> skip ;
";

test "exact lets the simulator decide a contested repeat" {
    let got = parses_each(CONTESTED_REPEATS_G4, [
        ["s", "a b"],
        ["s", "a a a b"],
        ["t", "c d d"],
        ["t", "c d d d"],
        ["u", "a a b"],
        ["u", "a b a b"],
    ]);
    assert got == "a b => (s (a a) b)
a a a b => (s (a a) (a a) (a a) b)
c d d => (t c (c d) (c d))
c d d d => (t c (c d d) (c d))
a a b => (u a a b)
a b a b => (u a b a b)
";
}

test "verify checks a contested repeat against the simulator" {
    let verify = GenerateOptions { prediction: PredictionMode::Verify };
    let agreed = parses_each(CONTESTED_REPEATS_G4, [
        ["s", "a b"],
        ["s", "a a a b"],
        ["t", "c d d"],
        ["t", "c d d d"],
    ], &verify);
    assert agreed == "a b => (s (a a) b)\na a a b => (s (a a) (a a) (a a) b)\nc d d => (t c (c d) (c d))\nc d d d => (t c (c d d) (c d))\n", agreed;
    let source = gen_with(CONTESTED_REPEATS_G4, &verify).source;
    for let [rule, input] of [
        ["u", "a a b"],
        ["u", "a b a b"],
    ] {
        let out = eval_beside(source, wado`show("${input}", parse_${rule}("${input}"));\n`, SHOW_FN);
        assert !out.status matches { Exited(0) }, input;
        assert out.stderr.contains(": the repeat picks "), out.stderr;
    }
}

// A loop in a left-recursion suffix whose body is decided by its own
// alternatives, and which must leave the suffix's `D` behind. The trees are the
// jar's.
test "a decided loop in a left-recursion suffix leaves what follows it" {
    let g4 = "grammar R;
s : e EOF ;
e : e C (D | D C)* D
  | A
  ;
A : 'a' ;
C : 'c' ;
D : 'd' ;
WS : ' ' -> skip ;
";
    let got = parses_each(g4, [
        ["s", "a c d"],
        ["s", "a c d d"],
        ["s", "a c d c d"],
        ["s", "a c d c d c d"],
    ]);
    assert got == "a c d => (s (e (e a) c d))
a c d d => (s (e (e a) c d d))
a c d c d => (s (e (e a) c d c d))
a c d c d c d => (s (e (e a) c d c d c d))
";
}

// The simulator decides a `??` under every mode, so `verify` has nothing to
// check there. The trees are the jar's.
test "verify leaves a decision the simulator makes unchecked" {
    let g4 = "grammar Q;\ns : (A B)?? A C EOF ;\nA : 'a' ;\nB : 'b' ;\nC : 'c' ;\nWS : ' ' -> skip ;\n";
    let got = parses_each(g4, [
        ["s", "a c"],
        ["s", "a b a c"],
    ], &GenerateOptions { prediction: PredictionMode::Verify });
    assert got == "a c => (s a c)\na b a c => (s a b a c)\n";
}

// On `a c d d` and `a c d d d` the jar enters the loop on the first `d` and
// takes `D` for the group, where the tournament takes `D D`. The trees are the
// jar's.
test "verify checks a contested repeat in a left-recursion suffix" {
    let g4 = "grammar R;
s : e EOF ;
e : e C (D | D D)* D
  | A
  ;
A : 'a' ;
C : 'c' ;
D : 'd' ;
WS : ' ' -> skip ;
";
    let verify = GenerateOptions { prediction: PredictionMode::Verify };
    let agreed = parses_each(g4, [
        ["s", "a c d"],
        ["s", "a c d c d"],
    ], &verify);
    assert agreed == "a c d => (s (e (e a) c d))
a c d c d => (s (e (e (e a) c d) c d))
";
    let source = gen_with(g4, &verify).source;
    for let input of ["a c d d", "a c d d d"] {
        let out = eval_beside(source, wado`show("${input}", parse_s("${input}"));\n`, SHOW_FN);
        assert !out.status matches { Exited(0) };
        assert out.stderr.contains(" at token 2: the tournament picks 1, the simulator 0"), out.stderr;
    }
}

// The atom choice between the two `new` alternatives is the simulator's, and
// the loop after it is static. The trees are the jar's.
global CONTESTED_NEW_G4: String = "grammar L;
s : e EOF ;
e : e '.' ID
  | 'new' e targs? '(' e? ')'
  | 'new' e targs?
  | e '(' e? ')'
  | e '<' e
  | e '>' e
  | ID
  ;
targs : '<' ID '>' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";

test "verify checks a left-recursion loop against the simulator" {
    let inputs: List<[String, String]> = [
        ["s", "new a < b > ( )"],
        ["s", "new a < b > c"],
        ["s", "new a < b"],
        ["s", "new a < b > ( ) . c"],
        ["s", "new a < b > . c"],
    ];
    let verify = GenerateOptions { prediction: PredictionMode::Verify };
    assert gen_with(CONTESTED_NEW_G4, &verify).source.contains("atn_verified(");
    assert parses_each(CONTESTED_NEW_G4, inputs, &verify) == "new a < b > ( ) => (s (e new (e a) (targs < b >) ( )))
new a < b > c => (s (e new (e (e (e a) < (e b)) > (e c))))
new a < b => (s (e new (e (e a) < (e b))))
new a < b > ( ) . c => (s (e (e new (e a) (targs < b >) ( )) . c))
new a < b > . c => (s (e (e new (e a) (targs < b >)) . c))
";
}

// The loop of a mid operand nested in another is decided statically, by the
// continuation gate standing in for the simulator's full context. The trees
// are the jar's.
test "verify checks a mid operand's loop against the simulator" {
    let inputs: List<[String, String]> = [
        ["s", "a between b between c and d and e"],
        ["s", "a between b between c and d and e and f"],
        ["s", "a between b and c and d and e"],
    ];
    let verify = GenerateOptions { prediction: PredictionMode::Verify };
    assert parses_each(#include_str("../tests/grammars/lr_mid_operand.g4"), inputs, &verify) == "a between b between c and d and e => (s (e (e a) between (e (e b) between (e c) and (e d)) and (e e)))
a between b between c and d and e and f => (s (e (e a) between (e (e b) between (e (e c) and (e d)) and (e e)) and (e f)))
a between b and c and d and e => (s (e (e a) between (e (e (e b) and (e c)) and (e d)) and (e e)))
";
}

// The first loop's iteration ends with a checked `?`, emitted into the loop's
// own scope, so each check's locals must be the loop's alone. The trees are
// the jar's.
test "verify checks a repeat nested in a checked loop's iteration" {
    let g4 = "grammar D;
s : '{' l? '}' EOF ;
l : (';' w)* d w (';' w d?)* ;
d : ID ':' ID w ;
w : C* ;
ID : [a-z]+ ;
C : '#' ;
WS : ' ' -> skip ;
";
    assert parses(
        g4,
        "s",
        ["{ a : b }", "{ ; a : b # ; c : d ; }", "{ a : b ; ; }"],
        &GenerateOptions { prediction: PredictionMode::Verify },
    ) == "{ a : b } => (s { (l (d a : b w) w) })
{ ; a : b # ; c : d ; } => (s { (l ; w (d a : b (w #)) w ; w (d c : d w) ; w) })
{ a : b ; ; } => (s { (l (d a : b w) w ; w ; w) })
";
}

// `ID e?` ends an atom, so its `?` competes with the loop's `args` and with
// the caller's FOLLOW. On the last two inputs the jar enters it, and so does
// the static pick computed beside the simulator's, though `longest`, whose
// loop around the atom differs, does not. The trees are the jar's.
test "verify checks an optional ending a left-recursive atom" {
    let g4 = "grammar N;
s : e EOF ;
e : e '.' ID | 'new' e args | 'new' e | e args | ID e? | args ;
args : '(' e? ')' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";
    let verify = GenerateOptions { prediction: PredictionMode::Verify };
    let inputs: List<String> = ["a", "a ( )", "new a ( )", "a . b", "new a ( ) ( )", "a new b ( ) ( )"];
    assert gen_with(g4, &verify).source.contains("atn_shadow(");
    assert parses(g4, "s", inputs, &verify) == "a => (s (e a))
a ( ) => (s (e a (e (args ( )))))
new a ( ) => (s (e new (e a) (args ( ))))
a . b => (s (e (e a) . b))
new a ( ) ( ) => (s (e new (e a (e (args ( )))) (args ( ))))
a new b ( ) ( ) => (s (e a (e new (e b (e (args ( )))) (args ( )))))
";
}

// The mid operand's rest opens with a group of loop operators, so it climbs
// only to where the group and the trailing operand still parse. The trees are
// the jar's.
test "a mid operand stops where a rest opening with a group still parses" {
    let g4 = "grammar M;
s : e EOF ;
e : e 'x' e ('y' | 'z') e
  | e 'y' e
  | e 'z' e
  | ID
  ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";
    assert parses_each(g4, [
        ["s", "a x b z c y d z e"],
        ["s", "a y b x c z d y e y f y g"],
    ]) == "a x b z c y d z e => (s (e (e a) x (e (e b) z (e (e c) y (e d))) z (e e)))
a y b x c z d y e y f y g => (s (e (e a) y (e (e b) x (e (e c) z (e (e (e d) y (e e)) y (e f))) y (e g))))
";
}

// An atom's mid operand owes `args` to its `new`, and climbs past a call whose
// end no `(` follows to the last end one does. The trees are the jar's.
test "an atom's mid operand climbs to the last boundary its rest parses at" {
    let g4 = "grammar N;
s : e EOF ;
e : 'new' e args
  | e args
  | e '.' ID
  | e '+' e
  | ID
  ;
args : '(' e? ')' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";
    assert parses_each(g4, [
        ["s", "new a . b ( c . d ) + e + new f ( ) ( g . h )"],
        ["s", "new a ( b ) . c ( d . e ) ( f )"],
        ["s", "new new a ( ) . b ( c ) + d . e"],
    ]) == "new a . b ( c . d ) + e + new f ( ) ( g . h ) => (s (e new (e (e (e (e (e a) . b) (args ( (e (e c) . d) ))) + (e e)) + (e new (e f) (args ( )))) (args ( (e (e g) . h) ))))
new a ( b ) . c ( d . e ) ( f ) => (s (e new (e (e (e (e a) (args ( (e b) ))) . c) (args ( (e (e d) . e) ))) (args ( (e f) ))))
new new a ( ) . b ( c ) + d . e => (s (e (e new (e (e new (e a) (args ( ))) . b) (args ( (e c) ))) + (e (e d) . e)))
";
}

// `'pre' e '!'?` can end with its operand, so the operand stops where the `new`
// around it still finds its `args`. The trees are the jar's.
test "a mid operand whose rest can be empty leaves the enclosing rest its tokens" {
    let g4 = "grammar N;
s : e EOF ;
e : 'new' e args | 'pre' e '!'? | e args | ID ;
args : '(' e? ')' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";
    assert parses(g4, "s", ["new pre a ( )", "new pre a ( ) ( )"]) == "new pre a ( ) => (s (e new (e pre (e a)) (args ( ))))
new pre a ( ) ( ) => (s (e new (e pre (e (e a) (args ( )))) (args ( ))))
";
}

// The rest `. e` opens with any token, so the operand stops where one is left
// for the wildcard. The trees are the jar's.
test "a mid operand whose rest opens with a wildcard leaves it a token" {
    let g4 = "grammar W;
s : e EOF ;
e : e 'x' e . e | e '+' e | ID ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";
    assert parses(g4, "s", ["a x b + c", "a x b x c + d + e + f"]) == "a x b + c => (s (e (e a) x (e b) + (e c)))
a x b x c + d + e + f => (s (e (e a) x (e (e b) x (e (e c) + (e d)) + (e e)) + (e f)))
";
}

// The rest is scanned under the gate the operand left: the `flag = 1` ahead of
// the operand already ran. The trees are the jar's.
test "a mid operand's rest is scanned under the gate the operand left" {
    let g4 = "grammar G;
@members { int flag = 0; }
s : e EOF ;
e : 'new' {flag=1;} e args | e args | ID {flag=0;} ;
args : {flag==0}? '(' ')' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
";
    assert parses(g4, "s", ["new a ( ) ( )", "new new a ( ) ( ) ( )"]) == "new a ( ) ( ) => (s (e new (e (e a) (args ( ))) (args ( ))))
new new a ( ) ( ) ( ) => (s (e new (e new (e (e a) (args ( ))) (args ( ))) (args ( ))))
";
}

// Each decision meets a predicate through a rule it calls: the loop's `op`, the
// repeat's `q`, the group's `r`. A simulator handed no verdict would enter
// each, where `longest` leaves it. `_vq_out` holds the output a check that asks
// a predicate takes back. The trees are the jar's.
test "verify hands the simulator the verdicts of the predicates a decision meets" {
    let verify = GenerateOptions { prediction: PredictionMode::Verify };
    let cases: List<[String, List<String>, String]> = [
        [
            "grammar P;\ns : e ('+' ID)? EOF ;\ne : e op e | ID ;\nop : {false}? '+' | '-' ;\nID : [a-z]+ ;\nWS : ' ' -> skip ;\n",
            ["a + b", "a - b + c"],
            "a + b => (s (e a) + b)\na - b + c => (s (e (e a) (op -) (e b)) + c)\n",
        ],
        [
            "grammar R;\ns : q* 'a'? EOF ;\nq : {false}? 'a' | 'b' ;\nWS : ' ' -> skip ;\n",
            ["a", "b a"],
            "a => (s a)\nb a => (s (q b) a)\n",
        ],
        [
            "grammar T;\ns : (r | 'a' 'c'?) EOF ;\nr : {false}? 'a' 'c' | 'b' ;\nWS : ' ' -> skip ;\n",
            ["a c", "b"],
            "a c => (s a c)\nb => (s (r b))\n",
        ],
    ];
    for let [g4, inputs, trees] of cases {
        assert gen_with(g4, &verify).source.contains("_vq_out"), g4;
        assert parses(g4, "s", inputs, &verify) == trees;
    }
}

// The repeat's check asks `q`'s predicate again, and takes back what it
// prints. The trees are the jar's.
test "verify prints what exact prints" {
    let g4 = "grammar P;
@parser::members {
boolean pred(boolean v) {
	System.out.println(\"eval=\" + v);
	return v;
}
}
s : q* 'a'? EOF ;
q : {this.pred(true)}? 'a' | 'b' ;
WS : ' ' -> skip ;
";
    let inputs: List<String> = ["a", "b a"];
    let exact = parses(g4, "s", inputs);
    assert exact.starts_with("a => (s (q a)) [eval=true\n"), exact;
    assert exact.contains("b a => (s (q b) (q a)) [eval=true\n"), exact;
    assert parses(g4, "s", inputs, &GenerateOptions { prediction: PredictionMode::Verify }) == exact;
}

// A contested decision meeting a predicate needs both the continuation and the
// verdict, so exact hands it the simulator: the loop's `q`, the group's and
// the `+`'s alternative. The trees and output are the jar's.
test "exact lets the simulator decide a contested decision meeting a predicate" {
    let p = "grammar P;
@parser::members {
boolean pred(boolean v) {
	System.out.println(\"eval=\" + v);
	return v;
}
}
s : q* 'a'? EOF ;
q : {this.pred(false)}? 'a' | 'b' ;
WS : ' ' -> skip ;
";
    let g = "grammar G;\ns : ({true}? a | a B) B EOF ;\na : A+ ;\nA : 'a' ;\nB : 'b' ;\nWS : ' ' -> skip ;\n";
    let r = "grammar R;\nu : ({true}? A | B)+ A B EOF ;\nA : 'a' ;\nB : 'b' ;\nWS : ' ' -> skip ;\n";
    assert parses(p, "s", ["b a", "a"]) == "b a => (s (q b) a) [eval=false\n]\na => (s a) [eval=false\n]\n";
    assert parses(g, "s", ["a b", "a b b"]) == "a b => (s (a a) b)\na b b => (s (a a) b b)\n";
    assert parses(r, "u", ["a a b", "a b a b"]) == "a a b => (u a a b)\na b a b => (u a b a b)\n";
}

// Each decision meets a predicate that holds, and on each input the jar takes
// another pick than `longest`: the jar parses `a b` and `a a b`, and reads
// `Z Z X` as `(r (a (b Z Z)) X)`.
test "verify checks a decision meeting a predicate" {
    let verify = GenerateOptions { prediction: PredictionMode::Verify };
    for let [g4, rule, input, picker] of [
        [
            "grammar T;\nr : a X* EOF ;\na : {true}? b | b X ;\nb : Z Z ;\nX : 'X' ;\nZ : 'Z' ;\nWS : ' ' -> skip ;\n",
            "r", "Z Z X", "the tournament",
        ],
        [
            "grammar G;\ns : ({true}? a | a B) B EOF ;\na : A+ ;\nA : 'a' ;\nB : 'b' ;\nWS : ' ' -> skip ;\n", "s",
            "a b", "the tournament",
        ],
        [
            "grammar R;\nu : ({true}? A | B)+ A B EOF ;\nA : 'a' ;\nB : 'b' ;\nWS : ' ' -> skip ;\n", "u", "a a b",
            "the repeat",
        ],
    ] {
        let out = eval_beside(
            gen_with(g4, &verify).source,
            wado`show("${input}", parse_${rule}("${input}"));\n`,
            SHOW_FN,
        );
        assert !out.status matches { Exited(0) }, input;
        assert out.stderr.contains(`: ${picker} picks `), out.stderr;
    }
}

// Prediction evaluates a predicate exactly where it reaches one before
// consuming a token. Behind a nullable prefix it does; past a consumed token,
// in a rule the decision scans into, it does not. The trees are the jar's.
test "prediction answers a predicate behind a nullable prefix" {
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        let options = GenerateOptions { prediction };
        assert parses("grammar Q;
s : r EOF ;
r : '-'? {false}? 'a' | 'a' ;
WS : ' ' -> skip ;
", "s", ["a", "- a"], &options) == "a => (s (r a))
- a => error
";
        assert parses("grammar L;
s : e ('+' ID)? EOF ;
e : e '-'? {false}? '+' e | e '*' e | ID ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
", "s", ["a + b", "a - + b", "a * b + c"], &options) == "a + b => (s (e a) + b)
a - + b => error
a * b + c => (s (e (e a) * (e b)) + c)
";
        // `w w` matches nothing however often `w` repeats on the path.
        assert parses("grammar W;
s : r EOF ;
r : u {false}? 'a' | 'a' ;
u : w w ;
w : ;
WS : ' ' -> skip ;
", "s", ["a"], &options) == "a => (s (r a))\n";
    }
}

test "prediction answers a predicate inside a group" {
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        assert parses(
            "grammar G;
s : 'A' r1 EOF | 'B' r2 EOF | 'C' r3 EOF | 'D' r4 EOF | 'E' r5 EOF | 'F' r6 EOF | 'G' r7 EOF | 'H' r8 EOF
  | 'I' r9 EOF | 'J' r10 EOF ;
r1 : ({false}? 'a' | 'b')+ 'x' | 'a' 'x' ;
r2 : ({false}? 'a' 'x' | 'b')? 'z' | 'a' 'x' 'z' ;
r3 : ('a' {false}? 'b' | 'c') 'x' | 'a' 'b' 'x' 'y' ;
r4 : (('-'? {false}? 'a' | 'b') | 'c') 'x' | 'a' 'x' ;
r5 : u 'd' | 'a' 'c' 'd' 'e'? ;
u : ({false}? 'a' 'b'? 'c')? ;
r6 : ('-'? {false}? 'a' | 'a') 'x' ;
r7 : ({false}? 'a')? 'x' | 'a' 'x' ;
r8 : v 'd' | 'a' 'z' 'c' 'd' 'e'? ;
v : (({false}? 'a' 'z')? 'b'? 'c')? ;
r9 : ('-'? {false}? 'a' | 'a') 'x' | 'a' 'x' 'y' ;
r10 : ('-'? {false}? 'a')* 'a'? 'b' ;
WS : ' ' -> skip ;
",
            "s",
            [
                "A a x", "A b a x", "B a x z", "B b z", "C a b x", "C a b x y", "D a x", "D - a x", "E a c d", "E d",
                "F a x", "F - a x", "G a x", "G x", "H a z c d", "H b c d", "I a x", "I a x y", "J a b", "J b",
            ],
            &GenerateOptions { prediction },
        ) == "A a x => (s A (r1 a x))
A b a x => error
B a x z => (s B (r2 a x z))
B b z => (s B (r2 b z))
C a b x => error
C a b x y => (s C (r3 a b x y))
D a x => (s D (r4 a x))
D - a x => error
E a c d => (s E (r5 a c d))
E d => (s E (r5 u d))
F a x => (s F (r6 a x))
F - a x => error
G a x => (s G (r7 a x))
G x => (s G (r7 x))
H a z c d => (s H (r8 a z c d))
H b c d => (s H (r8 (v b c) d))
I a x => (s I (r9 a x))
I a x y => (s I (r9 a x y))
J a b => (s J (r10 a b))
J b => (s J (r10 b))
";
    }
}

test "prediction walks past a call to a rule that matches nothing" {
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        assert parses(
            "grammar G;
s : 'A' r1 EOF | 'B' r2 EOF | 'C' r3 EOF | 'D' r4 EOF ;
r1 : w 'a' 'b' | 'a' 'c' ;
r2 : w 'a' | 'b' ;
r3 : w 'a' | 'a' ;
r4 : (w | 'b') 'a' 'b' | 'a' 'c' ;
w : ;
WS : ' ' -> skip ;
",
            "s",
            ["A a b", "A a c", "B a", "C a", "D a b", "D b a b", "D a c"],
            &GenerateOptions { prediction },
        ) == "A a b => (s A (r1 w a b))
A a c => (s A (r1 a c))
B a => (s B (r2 w a))
C a => (s C (r3 w a))
D a b => (s D (r4 w a b))
D b a b => (s D (r4 b a b))
D a c => (s D (r4 a c))
";
    }
}

test "prediction leaves a predicate behind a called rule's action to the parse" {
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        assert parses("grammar G;
s : r EOF ;
r : u {false}? 'a' | 'a' ;
u : {} ;
WS : ' ' -> skip ;
", "s", ["a"], &GenerateOptions { prediction }) == "a => error
";
    }
}

test "the simulator answers a called rule's predicate behind a nullable prefix" {
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        assert parses("grammar Q;
s : r EOF ;
r : q 'x' | 'a' 'y' | 'a' 'x' ;
q : '-'? {false}? 'a' | 'b' ;
WS : ' ' -> skip ;
", "s", ["a x", "b x", "- a x"], &GenerateOptions { prediction }) == "a x => (s (r a x))
b x => (s (r (q b) x))
- a x => error
";
    }
}

test "an optional enters only where entering leaves a viable parse, whatever decides its body" {
    let g4 = "grammar T;
s : 'A' ('-'? 'a')? 'a' EOF
  | 'B' ('-'? {false}? 'a')? 'a' EOF
  | 'C' ('-'? {false}? 'a' 'b' | 'a' 'd')? 'a' 'c' EOF
  | 'D' ('-'? 'a' 'b' | 'a' 'd')? 'a' 'c' EOF ;
WS : ' ' -> skip ;
";
    let inputs: List<String> = ["A a", "A a a", "A - a a", "B a", "B - a a", "C a c", "C a d a c", "D a c", "D a b a c"];
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        assert parses(g4, "s", inputs, &GenerateOptions { prediction }) == "A a => (s A a)
A a a => (s A a a)
A - a a => (s A - a a)
B a => (s B a)
B - a a => error
C a c => (s C a c)
C a d a c => (s C a d a c)
D a c => (s D a c)
D a b a c => (s D a b a c)
";
    }
}

// The actions written in a group's alternative run where the group sits in a
// left-recursive suffix too, a predicate included. On `x . a b` the simulator
// takes `a`, as the jar does, and its predicate fails; the tournament takes
// `a B`. The trees and the output are the jar's.
#[timeout_ms(240000)]
test "a group in a left-recursive suffix runs its alternative's actions" {
    let printing = "grammar N5;
s : e EOF ;
e : e '.' (a {System.out.println(\"p\");} | c) | ID ;
a : A ;
c : C ;
A : 'a' ; C : 'c' ; ID : [x-z]+ ;
WS : ' ' -> skip ;
";
    let gated = "grammar N5;
s : e EOF ;
e : e '.' (a {false}? | a B) B? | ID ;
a : A ;
A : 'a' ; B : 'b' ; ID : [x-z]+ ;
WS : ' ' -> skip ;
";
    for let prediction of [PredictionMode::Longest, PredictionMode::Exact] {
        assert parses(printing, "s", ["x . a"], &GenerateOptions { prediction }) == "x . a => (s (e (e x) . (a a))) [p\n]\n";
        assert parses(gated, "s", ["x . a"], &GenerateOptions { prediction }) == "x . a => error\n";
    }
    assert parses(gated, "s", ["x . a b"], &GenerateOptions { prediction: PredictionMode::Exact }) == "x . a b => error\n";
}

test "prediction answers a predicate only on the paths that reach it without running an action" {
    let g4 = "grammar T;
s : 'A' a EOF | 'B' b EOF | 'C' c EOF | 'D' d EOF | 'F' f EOF | 'G' h EOF
  | 'H' k EOF | 'I' m EOF | 'J' n EOF | 'K' o EOF | 'M' g EOF ;
a : (u | ) {false}? 'a' | 'a' ;
b : ({} | ) {false}? 'a' | 'a' ;
c : u? {false}? 'a' | 'a' ;
d : w {false}? 'a' | 'a' ;
f : (v | ) {false}? 'a' | 'a' ;
h : ({false}? u | ) {false}? 'a' | 'a' ;
k : {} {false}? 'a' | 'a' ;
m : u ({false}? 'a' | 'a' 'b') | 'a' 'c' ;
n : u ({false}? 'a') | 'a' ;
o : {} ({false}? 'a' | 'a' 'b') | 'a' ;
g : ({false}? 'a' | 'a' 'b') ;
u : {} ;
w : {} | ;
v : ;
WS : ' ' -> skip ;
";
    let inputs: List<String> = [
        "A a", "B a", "C a", "D a", "F a", "G a", "H a", "I a", "I a b", "J a", "K a", "K a b", "M a",
    ];
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        assert parses(g4, "s", inputs, &GenerateOptions { prediction }) == "A a => error
B a => error
C a => error
D a => error
F a => (s F (f a))
G a => (s G (h a))
H a => error
I a => error
I a b => (s I (m u a b))
J a => error
K a => error
K a b => (s K (o a b))
M a => error
";
    }
    // `( | u)` enters `u` only through the simulator.
    let lazy = "grammar T;
s : e EOF ;
e : ( | u) {false}? 'a' | 'a' ;
u : {} ;
WS : ' ' -> skip ;
";
    for let prediction of [PredictionMode::Verify, PredictionMode::Exact] {
        assert parses(lazy, "s", ["a"], &GenerateOptions { prediction }) == "a => error\n";
    }
}

test "prediction answers a predicate its caller places past the rule's end" {
    let g4 = "grammar T;
s : 'x' q {_input.LA(2) == B}? A .* EOF ;
q : .*? ;
A : 'a' ;
B : 'b' ;
WS : ' ' -> skip ;
";
    let inputs: List<String> = ["x a a b", "x a b", "x a a a b", "x a a"];
    for let prediction of [PredictionMode::Verify, PredictionMode::Exact] {
        assert parses(g4, "s", inputs, &GenerateOptions { prediction }) == "x a a b => (s x (q a) a b)
x a b => (s x q a b)
x a a a b => (s x (q a a) a b)
x a a => error
";
    }
    let nullable_first = "grammar T;
s : 'x' q {_input.LA(2) == B}? A .* EOF ;
q : | A ;
A : 'a' ;
B : 'b' ;
WS : ' ' -> skip ;
";
    // The tournament takes `A` by length, predicate or not, so `verify`
    // reports these inputs.
    assert parses(nullable_first, "s", ["x a a b", "x a b"]) == "x a a b => (s x (q a) a b)
x a b => (s x q a b)
";
}

// A wildcard leaves FOLLOW inexact only for the rules it may follow: `q`'s is
// `{A}` whatever `.*` follows, so the empty alternative still meets `A`.
test "a nullable alternative meets its FOLLOW in a grammar with a wildcard elsewhere" {
    let direct = "grammar T;
s : 'x' q A .* EOF ;
q : | A ;
A : 'a' ;
B : 'b' ;
WS : ' ' -> skip ;
";
    let nested = "grammar V;
s : r .* EOF ;
r : 'x' q A ;
q : A? ;
A : 'a' ;
B : 'b' ;
WS : ' ' -> skip ;
";
    let inputs: List<String> = ["x a b", "x a a b", "x a a", "x a"];
    // The tournament takes `A` by length, so `verify` reports `direct`.
    assert parses(direct, "s", inputs) == "x a b => (s x q a b)
x a a b => (s x q a a b)
x a a => (s x q a a)
x a => (s x q a)
";
    for let prediction of [PredictionMode::Verify, PredictionMode::Exact] {
        assert parses(nested, "s", inputs, &GenerateOptions { prediction }) == "x a b => (s (r x q a) b)
x a a b => (s (r x (q a) a) b)
x a a => (s (r x (q a) a))
x a => (s (r x q a))
";
    }
}

test "prediction leaves a predicate past a consumed token to the parse" {
    let g = "grammar G;
s : x EOF ;
x : 'a' q | 'a' 'b' 'c' ;
q : {false}? 'b' 'c' | 'd' ;
WS : ' ' -> skip ;
";
    let m = "grammar M;
s : e EOF ;
e : e 'x' e p | e '+' e | ID ;
p : {false}? '+' ID | 'z' ;
ID : [a-y]+ ;
WS : ' ' -> skip ;
";
    for let prediction of [PredictionMode::Longest, PredictionMode::Verify, PredictionMode::Exact] {
        let options = GenerateOptions { prediction };
        assert parses(g, "s", ["a b c"], &options) == "a b c => error\n";
        assert parses(m, "s", ["a x b + c + d"], &options) == "a x b + c + d => error\n";
        assert parses(g, "s", ["a d"], &options) == "a d => (s (x a (q d)))\n";
        assert parses(m, "s", ["a x b + c z", "a x b z", "a x b z + c"], &options) == "a x b + c z => (s (e (e a) x (e (e b) + (e c)) (p z)))
a x b z => (s (e (e a) x (e b) (p z)))
a x b z + c => (s (e (e (e a) x (e b) (p z)) + (e c)))
";
    }
}

test "longest refuses a decision only the simulator makes" {
    let longest = gen_with("grammar T;
r : A?? A B ;
A : 'a' ;
B : 'b' ;
", &LONGEST);
    let refusals: List<String> = longest.diagnostics.iter_ref().filter(
        |d: &Diagnostic| d.kind matches { SimulatorRequired },
    ).map(
        |d: &Diagnostic| `${d.owner.label()}: ${d.message}`,
    ).collect();
    assert refusals == [
        "rule 'r': a non-greedy `??` only the ATN simulator decides, and `prediction: \"longest\"` refuses it",
    ];
}

test "trace suppresses the pick line for all-single-token rules" {
    // `tok`'s pick is evident from the `enter` line's lookahead, so it is dropped;
    // `sub`'s alts consume structure, so its pick stays.
    let input = "grammar T;
r : tok sub EOF ;
tok : A | B | C ;
sub : A x | B ;
x : A ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
";
    let log = traced(input, "parse_r(\"baa\")");
    assert !log.contains("pick tok");
    assert log.contains("pick sub alt#0");
}

test "generate emits pub fn parse_<rule>(input) for LR rule with min_prec=0" {
    // LR rules' `_parse_expr` wrapper defaults `min_prec` to 0, so the public
    // entry admits every LR alt (historic `parse` behaviour).
    let input = "grammar Test;
expr : expr '+' expr | NUMBER ;
NUMBER : [0-9]+ ;
WS : [ \\t\\n]+ -> skip ;
";
    let output = gen_source(input);
    assert output.contains("pub fn parse_expr<S: AsStrSlice>(input: S");
    assert output.contains("return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_expr(p));");
}

/// The top-level fn that `header` opens, up to the next one. Fails when `output`
/// has none, so an assertion on the body cannot pass against nothing.
fn extract_fn_body<S: AsStrSlice, S1: AsStrSlice>(output: S, header: S1) -> String {
    let text = output.as_str_slice();
    let start = text.find(&header).expect(`no \`${header.as_str_slice()}\` in the generated source`);
    let rest = text.slice(start + header.len(), text.len());
    let end = start + header.len() + rest.find("\nfn ").unwrap_or(rest.len());
    return text.slice(start, end).to_string();
}

/// Fail unless `body` holds `first` and, after it, `then`.
fn assert_in_order<S: AsStrSlice, S1: AsStrSlice, W: AsStrSlice>(body: &String, first: S, then: S1, why: W) {
    let first_at = body.find(&first).expect(`no \`${first.as_str_slice()}\`: ${body}`);
    let then_at = body.find(&then).expect(`no \`${then.as_str_slice()}\`: ${body}`);
    assert first_at < then_at, why.to_string();
}

test "lexer rule caseInsensitive=false overrides grammar-level true" {
    let input = "lexer grammar Test;
options { caseInsensitive = true; }
IF : 'if' ;
STRICT options { caseInsensitive = false; } : 'x' ;
WS : [ \\t]+ -> skip ;";
    let got = lexes(input, ["if IF iF x", "X"]);
    assert got == "if IF iF x => IF:if IF:IF IF:iF STRICT:x\nX => error:X\n";
}

test "a first-char dispatch whose arms claim every char compiles without a `_` arm" {
    let input = "lexer grammar Test;
A : 'a' ;
ANY : [\\u0000-\\uD7FF\\uE000-\\u{10FFFF}] ;";
    let got = lexes(input, ["ab"]);
    assert got == "ab => A:a ANY:b\n";
}

test "a first-char arm spanning the surrogate block claims every char" {
    let input = "lexer grammar Test;
A : 'a' ;
ANY : [\\u0000-\\u{10FFFF}] ;";
    let got = lexes(input, ["ab"]);
    assert got == "ab => A:a ANY:b\n";
}

test "a lexer steps over multi-byte chars whole" {
    let input = "lexer grammar Test;
CAFE : 'café' ;
GREEK : [α-ω]+ ;
ID : [a-z]+ ;
DOT : '.' . ;
NOT_SPACE : ~[ a-zα-ω]+ ;
WS : ' ' -> skip ;";
    let got = lexes(input, ["café caf αβγ abc 日本 .é"]);
    assert got == "café caf αβγ abc 日本 .é => CAFE:café ID:caf GREEK:αβγ ID:abc NOT_SPACE:日本 DOT:.é\n";
}

// Pins "Positions an action reads are byte offsets" in antlr4-compatibility.md:
// `$index` counts bytes where the jar counts chars (4 here), while `$pos`,
// `getCharPositionInLine()` and `getText()` answer as the jar does.
test "a lexer action reads byte positions and char columns" {
    let input = "lexer grammar L;
E : 'é' ;
AB : 'ab' {
    System.out.println($index);
    System.out.println($pos);
    System.out.println(getCharPositionInLine());
    System.out.println(getText());
} ;
WS : ' ' -> skip ;";
    assert lexes(input, ["é ab"]) == "é ab => E:é AB:ab [5\n4\n4\nab\n]\n";
}

test "a lexer base reads byte positions through LexerView" {
    let items = `struct Probe {
    log: List<String>,
}

impl B for Probe {
    fn hit(&mut self, view: LexerView, lx: &mut Lexer) {
        let at = view.start();
        self.log.push(\`\${at} \${view.pos()} \${view.input_len()} \${view.char_at(0)} \${view.char_at(at)} \${view.la(-1)} \${view.text()}\`);
        resume ();
    }
}

fn probe(input: String) with Stdout {
    let mut base = Probe { log: [] };
    with B => &mut base do {
        let _ = tokenize(input);
    };
    println(base.log.join(","));
}
`;
    let got = printed("lexer grammar L;
options { superClass = B; language = Wado; }
E : 'é' ;
AB : 'ab' { this.hit() } ;
WS : ' ' -> skip ;
", "probe(\"é ab\");\n", items);
    assert got == "3 5 5 233 97 98 ab\n";
}

test "lexer rule caseInsensitive=true enables CI when grammar-level absent" {
    let input = "lexer grammar Test;
KW options { caseInsensitive = true; } : 'go' ;
ID : [a-z]+ ;
WS : ' ' -> skip ;";
    let got = lexes(input, ["go GO Go ab", "AB"]);
    assert got == "go GO Go ab => KW:go KW:GO KW:Go ID:ab\nAB => error:A error:B\n";
}

test "virtual tokens are marked and not match-generated" {
    // A virtual token (`tokens { }`, no lexer rule) gets a TK_ constant and a name,
    // tagged `// virtual`, but no `try_` matcher: the tokenizer never produces it.
    let input = "grammar Test;
tokens { VIRTUAL_TOK }
rule : ID ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;";
    let output = gen_source(input);
    assert output.contains("global TK_VIRTUAL_TOK: i32 = ") && output.contains(";  // virtual");
    assert output.contains("TK_VIRTUAL_TOK => \"VIRTUAL_TOK\",  // virtual");
    assert !output.contains("fn try_VIRTUAL_TOK(");
}

test "caseInsensitive does not fold non-letters" {
    let input = "lexer grammar Test;
options { caseInsensitive = true; }
DIGITS : [0-9]+ ;
SEMI : ';' ;";
    let output = gen_source(input);
    // Digit range must not be duplicated.
    assert output.contains("matches { b'0'..=b'9' }");
    // Non-letter literal must not be duplicated — plain mismatch form.
    assert output.contains("unchecked src.byte_at(pos) != b';'");
    assert !output.contains("b';' | b';'");
}

test "metadata comment lists grammar-level options" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [
            GrammarOption { name: "language", value: OptionValue::Ident("Python") },
            GrammarOption { name: "superClass", value: OptionValue::Qualified(["my", "pkg", "BaseParser"]) },
            GrammarOption { name: "tokenVocab", value: OptionValue::Ident("TestLexer") },
            GrammarOption { name: "caseInsensitive", value: OptionValue::Ident("true") },
            GrammarOption { name: "contextSuperClass", value: OptionValue::Qualified(["my", "pkg", "Ctx"]) },
        ],
        named_actions: [],
        pending_refs: [],
        source_files: [],
        parser_superclass: "BaseParser",
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("// Grammar metadata from source .g4 prequels:");
    assert output.contains("//   option language = Python");
    assert output.contains("//   option superClass = BaseParser (parser)");
    assert !output.contains("//   option superClass = my.pkg.BaseParser");
    assert output.contains("//   option tokenVocab = TestLexer");
    assert output.contains("//   option caseInsensitive = true");
    assert output.contains("//   option contextSuperClass = my.pkg.Ctx");
}

test "metadata comment formats string and int option values" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [
            GrammarOption { name: "tokenVocab", value: OptionValue::Str("foo.g4") },
            GrammarOption { name: "k", value: OptionValue::Int("3") },
            GrammarOption { name: "init", value: OptionValue::Action(ActionSource { text: "some code;" }) },
        ],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("//   option tokenVocab = \"foo.g4\"");
    assert output.contains("//   option k = 3");
    assert output.contains("//   option init = { ... }");
}

test "metadata comment lists named actions" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [
            NamedAction { scope: null, name: "header" },
            NamedAction { scope: Option::<String>::Some("parser"), name: "members" },
            NamedAction { scope: Option::<String>::Some("lexer"), name: "members" },
        ],
        pending_refs: [],
