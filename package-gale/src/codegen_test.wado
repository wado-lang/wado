test "generate lexer type_override" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [
            LexerRule {
                name: "ID",
                visibility: Visibility::Default,
                is_fragment: false,
                skip: false,
                more: false,
                type_override: null,
                channel: 0,
                mode: 0,
                set_mode: -1,
                push_mode: -1,
                pop_mode: false,
                is_virtual: false,
                options: [],
                body: [
                    LexerAlternative {
                        elements: [LexerElement::Literal("x")],
                    },
                ],
            },
            LexerRule {
                name: "IF",
                visibility: Visibility::Default,
                is_fragment: false,
                skip: false,
                more: false,
                type_override: Option::<String>::Some("ID"),
                channel: 0,
                mode: 0,
                set_mode: -1,
                push_mode: -1,
                pop_mode: false,
                is_virtual: false,
                options: [],
                body: [
                    LexerAlternative {
                        elements: [LexerElement::Literal("if")],
                    },
                ],
            },
        ],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    // IF rule should produce tokens tagged as TK_ID (not TK_IF).
    assert str_contains(&output, &"best_kind = TK_ID");
    // TK_IF should still exist as a token kind (not renamed), because
    // type_override only rewrites emission, not the rule identifier.
    assert str_contains(&output, &"    IF,");
}

test "generate lexer channel" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [
            LexerRule {
                name: "COMMENT",
                visibility: Visibility::Default,
                is_fragment: false,
                skip: false,
                more: false,
                type_override: null,
                channel: 2,
                mode: 0,
                set_mode: -1,
                push_mode: -1,
                pop_mode: false,
                is_virtual: false,
                options: [],
                body: [
                    LexerAlternative {
                        elements: [LexerElement::Literal("#")],
                    },
                ],
            },
        ],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert str_contains(&output, &"best_channel");
    assert str_contains(&output, &"best_channel = 2");
    // Non-default channels must be routed to trivia, not tokens — ANTLR4
    // hides channels other than DEFAULT from parser rules.
    assert str_contains(&output, &"if best_channel != 0");
    assert str_contains(&output, &"ts.push_trivia(best_kind, tok_start, best_end, best_channel);");
    // No `-> skip` rule and no action to latch one, so `is_skip` never exists.
    assert !str_contains(&output, &"let is_skip");
}

test "generate lexer hidden channel routes to trivia" {
    // `channel(HIDDEN)` must not set `skip`, and tokens matching the rule
    // must be routed to trivia (not the tokens stream) so the parser does
    // not see them.
    let input = "lexer grammar Test;
WS : [ \\t]+ -> channel(HIDDEN) ;
ID : [a-z]+ ;";
    let mut grammar = parse_grammar(input, "test.g4");
    // Parser-side contract: HIDDEN channel must not degrade to skip.
    for let r of &grammar.lexer_rules {
        if r.name == "WS" {
            assert r.skip == false;
            assert r.channel == 1;
        }
    }
    // Generator-side contract: the emitted dispatch must route `best_channel
    // != 0` matches to trivia via `Token::with_channel`, not to the tokens
    // stream.
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert str_contains(&output, &"if best_channel != 0");
    assert str_contains(&output, &"ts.push_trivia(best_kind, tok_start, best_end, best_channel);");
    assert !str_contains(&output, &"let is_skip");
}

test "generate left-associative LR alt passes own_prec+1 on right operand" {
    // Baseline without `<assoc=right>`: the recursive right operand runs at
    // `own_prec + 1` so same-precedence operators are left-associative
    // (handled by the outer precedence loop, not by nested recursion).
    let input = "grammar Test;
expr : expr '**' expr | NUMBER ;
NUMBER : [0-9]+ ;
WS : [ \\t\\r\\n]+ -> skip ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert str_contains(&output, &"_parse_expr(p, 2)");
}

test "generate right-associative LR alt passes own_prec on right operand" {
    // `<assoc=right>` lowers the inner threshold so same-precedence `**`
    // nests rightward: `2 ** 3 ** 4` parses as `2 ** (3 ** 4)`.
    let input = "grammar Test;
expr : <assoc=right> expr '**' expr | NUMBER ;
NUMBER : [0-9]+ ;
WS : [ \\t\\r\\n]+ -> skip ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert str_contains(&output, &"_parse_expr(p, 1)");
    // And the scan-side mirror must be kept in sync.
    assert str_contains(&output, &"scan_expr(tokens, pos, 1)");
}

fn parse_grammar(input: String, path: String) -> Grammar {
    let mut g = parse(input).unwrap();
    g.source_files.push(path);
    return g;
}

test "LR scan loop saves pos and backs off on a suffix failure" {
    // statement: letterA | statement letterA 'b' ;
    // Both alts start with TK_LIT_A (letterA = 'a'), so the LR suffix's
    // first-token check alone cannot decide whether the suffix will complete.
    // When `scan_statement_lr_1` returns -1 (e.g. the trailing 'b' is missing),
    // the LR loop must restore `pos` to the prior atom-end and `break` —
    // never propagate `-1` as the whole scan failing, which would prevent
    // the enclosing `statement*` repetition from matching anything (ANTLR4
    // stops after the longest valid prefix).
    let input = "grammar Test;
prog : statement* EOF ;
statement : letterA | statement letterA 'b' ;
letterA : 'a' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let scan_body = extract_fn_body(&output, &"fn scan_statement(");
    // The LR loop must save `pos` before the suffix call and restore it on
    // failure. Look for the save+restore pair around `scan_statement_lr_1(`.
    assert str_contains(&scan_body, &"let lr_saved_pos = pos;");
    assert str_contains(&scan_body, &"pos = lr_saved_pos; break;");
}

test "LR helper stamps min_prec on a self-ref nested inside a Repeat group" {
    // Regression: nested self-ref in `(',' b+=expr)*` kept min_prec=0
    // and ate the outer `'>>'`. Grammar mirrors `ReturnValueAndActionsList1_2`
    // with two LR alts so wrong-alt-index `conflict_min` reads (e.g.
    // always `lr_alts[0]`) also trip.
    let input = "grammar Test;
s : expr EOF ;
expr :
    a=expr '*' a=expr #Factor
    | b+=expr (',' b+=expr)* '>>' c=expr #Send
    | ID #JustId
;
ID : 'a' ;
WS : [ \\t\\n]+ -> skip ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let helper = extract_fn_body(&output, &"fn _parse_expr__inner(");
    // Send is the second LR alt of two left-assoc: own_prec=1, conflict_min=2.
    // The self-refs in the Send suffix must be stamped with min_prec 2.
    assert !str_contains(&helper, &"_parse_expr(p)");
    assert str_contains(&helper, &"_parse_expr(p, 2)");
    let scan_helper = extract_fn_body(&output, &"fn scan_expr_lr_1");
    assert !str_contains(&scan_helper, &"scan_expr(tokens, pos, 0)");
    assert str_contains(&scan_helper, &"scan_expr(tokens, pos, 2)");
}

test "SimpleCst group emit threads min_prec_arg on a self-ref alt inside an LR suffix" {
    // `gen_consume_group_store_op` / `_optional_op` and
    // `gen_rule_ref_group_scan_dispatch` used to emit `_parse_X(p)?`
    // without reading `min_prec_arg`, dropping the stamp set by the
    // deep walker. `(expr | INT)` inside the LR suffix is a SimpleCst
    // Group that exercises the path.
    let input = "grammar Test;
s : expr EOF ;
expr : expr ',' (expr | INT) | INT ;
INT : [0-9]+ ;
WS : [ \\t\\n]+ -> skip ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let helper = extract_fn_body(&output, &"fn _parse_expr__inner(");
    assert helper.len() > 0;
    assert !str_contains(&helper, &"_parse_expr(p)");
    assert str_contains(&helper, &"_parse_expr(p, 2)");
}

test "LR parse loop predicts via scan when suffix's first token is shared with the atom" {
    // Same grammar as the scan-side test. On the parse side the suffix call
    // mutates `p.pos`, so the LR loop must consult the scan twin first to
    // decide whether to commit. Without that check, `parse_statement_lr_1`
    // would consume `letterA` then fail on `'b'`, leaving `p.pos` mid-suffix
    // and corrupting the surrounding `statement*` driver.
    let input = "grammar Test;
prog : statement* EOF ;
statement : letterA | statement letterA 'b' ;
letterA : 'a' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let parse_body = extract_fn_body(&output, &"fn _parse_statement__inner(");
    assert str_contains(&parse_body, &"scan_statement_lr_1(") || str_contains(&parse_body, &"scan_statement_lr_1 (");
}

test "generate emits pub fn parse_<rule>(input) per parser rule" {
    // Per-rule input entries are the start-rule API: callers route an
    // input directly into rule R via `parse_R(input)` instead of having
    // to construct a Parser and call `_parse_R(p)`. Generated parsers
    // also keep `pub fn parse(input)` as a thin alias for the first
    // rule's entry — downstream callers (driver tests, descriptors with
    // no `[start]`) depend on it.
    let input = "grammar Test;
a : 'x' ;
b : 'y' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert str_contains(&output, &"pub fn parse_a(input: &String");
    assert str_contains(&output, &"pub fn parse_b(input: &String");
    // Each `parse_<rule>` is a thin wrapper that hands the rule's
    // `_parse_<rule>` entry to the shared `_run_parse_entry` helper as a fn value;
    // `_run_parse_entry` builds the Parser and folds the error into the diagnostics.
    assert str_contains(
        &output,
        &"fn _run_parse_entry(input: &String, max_errors: i32, entry: fn(&mut Parser)) -> ParseResult",
    );
    assert str_contains(&output, &"return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_a(p));");
    assert str_contains(&output, &"return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_b(p));");
    // `pub fn parse` is a thin alias for the first rule's entry.
    assert str_contains(&output, &"return parse_a(input, max_errors);");
}

test "trace option emits per-rule enter/ok/fail instrumentation" {
    // `gale gen --trace` / `options: { trace: true }` instruments every
    // rule-entry wrapper so the recursive-descent path and the bail point
    // are visible on stderr when a grammar rejects an input.
    let input = "grammar Test;
a : 'x' b ;
b : 'y' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let traced = generate(&mut grammar, &GenerateOptions { trace: true }).source;
    // The ambient logger import, the trace helpers, the depth field, and the
    // per-rule calls are all present.
    assert str_contains(&traced, &"use { log_stderr } from \"core:rt\";");
    assert str_contains(&traced, &"fn trace_enter(p: &Parser, rule: &String)");
    assert str_contains(&traced, &"trace_depth: i32,");
    assert str_contains(&traced, &"trace_enter(p, &\"a\");");
    assert str_contains(&traced, &"trace_fail(p, &\"a\", &p.pending_message());");
    assert str_contains(&traced, &"trace_ok(p, &\"b\");");

    // Default generation (trace off) must contain none of it — the feature
    // is strictly opt-in and adds zero instrumentation otherwise.
    let mut grammar2 = parse_grammar(input, "test.g4");
    let plain = generate(&mut grammar2, &GenerateOptions { trace: false }).source;
    assert !str_contains(&plain, &"trace_enter");
    assert !str_contains(&plain, &"trace_depth");
    assert !str_contains(&plain, &"log_stderr");
}

test "token-led overlap dispatch emits no per-alt scan helpers" {
    // `r`'s alts share the first token `'{'` but split on the second
    // (`a` vs `'}'`), so prediction resolves token-led: a `peek_kind`
    // dispatch that never calls a scan helper, leaving the per-alt
    // `_parse_r__inner_scan_<n>` helpers dead.
    let input = "grammar T;
r : '{' a '}' | '{' '}' ;
a : 'x' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    // Both alts are reached (the group resolved, not collapsed)...
    assert str_contains(&output, &"fn _parse_r__inner_alt_0(");
    assert str_contains(&output, &"fn _parse_r__inner_alt_1(");
    // ...but neither scan helper is emitted.
    assert !str_contains(&output, &"fn _parse_r__inner_scan_");

    // A shared-prefix tournament rule still emits its scan helpers, so the
    // gate is not over-pruning.
    let tinput = "grammar T;
s : X s Y? | X ;
X : 'X' ;
Y : 'Y' ;
";
    let mut tg = parse_grammar(tinput, "test.g4");
    let tout = generate(&mut tg, &DEFAULT_OPTIONS).source;
    assert str_contains(&tout, &"fn _parse_s__inner_scan_0(");
}

test "trace option instruments the scan tournament and alt picks" {
    // A rule whose alts share an opaque rule-ref prefix (`b X` vs `b Y`)
    // lowers to the longest-match scan tournament (the disambiguating token
    // is hidden inside `b`, and neither alt is at-end relative to the other,
    // so it is not an ATN-routed `AtEndConflict`). Trace must surface the
    // per-alt scan lengths and the committed winner so a mis-prediction is
    // visible.
    let input = "grammar T;
r : a EOF ;
a : b X
  | b Y
  ;
b : Z Z ;
X : 'X' ;
Y : 'Y' ;
Z : 'Z' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let traced = generate(&mut grammar, &GenerateOptions { trace: true }).source;
    assert str_contains(&traced, &"trace_scan_alt(p, &\"a\",");
    assert str_contains(&traced, &"trace_pick(p, &\"a\", _sd_best_i);");
    assert str_contains(&traced, &"fn trace_scan_alt(p: &Parser, rule: &String, alt: i32, end: i32)");

    // Default generation (trace off) emits none of the decision-point hooks.
    let mut grammar2 = parse_grammar(input, "test.g4");
    let plain = generate(&mut grammar2, &GenerateOptions { trace: false }).source;
    assert !str_contains(&plain, &"trace_scan_alt");
    assert !str_contains(&plain, &"trace_pick");
    assert !str_contains(&plain, &"trace_try");
}

test "trace suppresses the pick line for all-single-token rules" {
    // `tok` is a pure single-token choice: the committed alt is already
    // self-evident from the lookahead token on the `enter` line, so its
    // `pick` would be pure noise and must be suppressed. `sub` chooses
    // among alts that consume sub-structure (`A x` vs `B`), so its pick
    // carries real information and stays.
    let input = "grammar T;
r : tok sub EOF ;
tok : A | B | C ;
sub : A x | B ;
x : A ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let traced = generate(&mut grammar, &GenerateOptions { trace: true }).source;
    assert !str_contains(&traced, &"trace_pick(p, &\"tok\",");
    assert str_contains(&traced, &"trace_pick(p, &\"sub\",");
}

test "generate emits pub fn parse_<rule>(input) for LR rule with min_prec=0" {
    // LR rules' `_parse_expr` wrapper defaults `min_prec` to 0, so the public
    // entry admits every LR alt (historic `parse` behaviour).
    let input = "grammar Test;
expr : expr '+' expr | NUMBER ;
NUMBER : [0-9]+ ;
WS : [ \\t\\n]+ -> skip ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert str_contains(&output, &"pub fn parse_expr(input: &String");
    assert str_contains(&output, &"return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_expr(p));");
}

test "token-only group `(K_A | K_B)` gates p.advance() on a kind-check" {
    // Regression: a token-only group used to emit as a bare
    // `let lit_x_or_lit_y = p.advance();` with no `peek_kind` guard,
    // so any token at that position was silently consumed. Surfaced
    // by `ParserErrors/SingleTokenDeletionExpectingSet` and
    // `ParserErrors/SingleTokenDeletionBeforeAlt`. After the fix the
    // emit routes through `p.expect_set(&SYNC_<id>)` which fails when the
    // current token is outside the set. Regression fixture:
    // `tests/grammars/parser_set_group_dispatch.g4`.
    let input = "grammar Test;
a : 'a' ('b' | 'c') 'd' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_a__inner(");
    assert str_contains(&body, &"p.expect_set(&SYNC_");
    assert !str_contains(&body, &"p.advance();");
}

fn extract_fn_body(output: &String, header: &String) -> String {
    let start = find_substr(output, header);
    if start < 0 {
        return "";
    }
    // Find the next "\nfn " (start of the next top-level fn) or end of file.
    let after = start + header.len();
    let next = find_substr_from(output, &"\nfn ", after);
    let end = if next < 0 { output.len() } else { next };
    return output.substr_bytes(start, end);
}

fn find_substr(haystack: &String, needle: &String) -> i32 {
    return find_substr_from(haystack, needle, 0);
}

fn find_substr_from(haystack: &String, needle: &String, from: i32) -> i32 {
    let h_len = haystack.len();
    let n_len = needle.len();
    if n_len > h_len {
        return -1;
    }
    let limit = h_len - n_len;
    for let mut i = from; i <= limit; i += 1 {
        let mut ok = true;
        for let mut j = 0; j < n_len; j += 1 {
            if haystack.get_byte_unchecked(i + j) != needle.get_byte_unchecked(j) {
                ok = false;
                break;
            }
        }
        if ok {
            return i;
        }
    }
    return -1;
}

test "caseInsensitive grammar option makes literal match CI" {
    let input = "lexer grammar Test;
options { caseInsensitive = true; }
IF : 'if' ;
WS : [ \\t]+ -> skip ;";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    // A case-insensitive 'i' must use the branchless CI comparison helper.
    assert str_contains(&output, &"!chars[pos].eq_ignore_ascii_case(&'i')");
    assert str_contains(&output, &"!chars[pos].eq_ignore_ascii_case(&'f')");
}

test "caseInsensitive grammar option makes char-range match CI" {
    let input = "lexer grammar Test;
options { caseInsensitive = true; }
ID : [a-z]+ ;";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    // A case-insensitive [a-z] must also accept [A-Z].
    assert str_contains(&output, &"'A'..='Z'");
}

test "lexer rule caseInsensitive=false overrides grammar-level true" {
    let input = "lexer grammar Test;
options { caseInsensitive = true; }
IF : 'if' ;
STRICT options { caseInsensitive = false; } : 'x' ;
WS : [ \\t]+ -> skip ;";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    // IF still CI: the literal 'i' must use the branchless CI helper.
    assert str_contains(&output, &"!chars[pos].eq_ignore_ascii_case(&'i')");
    // STRICT: rule-level caseInsensitive=false means 'x' must NOT be folded,
    // regardless of which match path the optimisation chose for the rule
    // (keyword classifier, regular dispatch, or shared literal).
    assert !str_contains(&output, &"eq_ignore_ascii_case(&'x')");
}

test "lexer rule caseInsensitive=true enables CI when grammar-level absent" {
    let input = "lexer grammar Test;
KW options { caseInsensitive = true; } : 'go' ;
ID : [a-z]+ ;";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert str_contains(&output, &"!chars[pos].eq_ignore_ascii_case(&'g')");
    // ID is not CI; its range must stay [a-z] without a mirrored [A-Z].
    assert !str_contains(&output, &"'A'..='Z'");
}

test "virtual tokens are marked and not match-generated" {
    // Virtual tokens (declared in `tokens { }` without a real lexer rule) must
    // still appear in the TokenKind enum, the TK_<name> constant table, and
    // the token_kind_name dispatch — but they must not get a try_<name>
    // matcher (the tokenizer cannot produce them directly), and the emitted
    // entries should be tagged `// virtual` so downstream tooling can see the
    // distinction.
    let input = "grammar Test;
tokens { VIRTUAL_TOK }
rule : ID ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert str_contains(&output, &"    VIRTUAL_TOK,  // virtual");
    assert str_contains(&output, &"global TK_VIRTUAL_TOK: i32 = ") && str_contains(&output, &";  // virtual");
    assert str_contains(&output, &"TK_VIRTUAL_TOK => \"VIRTUAL_TOK\",  // virtual");
    assert !str_contains(&output, &"fn try_VIRTUAL_TOK(");
}

test "caseInsensitive does not fold non-letters" {
    let input = "lexer grammar Test;
options { caseInsensitive = true; }
DIGITS : [0-9]+ ;
SEMI : ';' ;";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    // Digit range must not be duplicated.
    assert str_contains(&output, &"'0'..='9'");
    // Non-letter literal must not be duplicated — plain mismatch form.
    assert str_contains(&output, &"chars[pos] != ';'");
    assert !str_contains(&output, &"chars[pos].eq_ignore_ascii_case(");
}

test "metadata comment lists grammar-level options" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [
            GrammarOption { name: "language", value: OptionValue::Ident("Python") },
            GrammarOption { name: "superClass", value: OptionValue::Qualified(["my", "pkg", "BaseParser"]) },
            GrammarOption { name: "tokenVocab", value: OptionValue::Ident("TestLexer") },
            GrammarOption { name: "caseInsensitive", value: OptionValue::Ident("true") },
        ],
        named_actions: [],
        pending_refs: [],
        source_files: [],
        parser_superclass: "BaseParser",
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert str_contains(&output, &"// Grammar metadata from source .g4 prequels:");
    assert str_contains(&output, &"//   option language = Python");
    assert str_contains(&output, &"//   option superClass = BaseParser (parser)");
    assert !str_contains(&output, &"//   option superClass = my.pkg.BaseParser");
    assert str_contains(&output, &"//   option tokenVocab = TestLexer");
    assert str_contains(&output, &"//   option caseInsensitive = true");
}

test "metadata comment formats string and int option values" {
