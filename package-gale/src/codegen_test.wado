test "generate lexer type_override" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [
            LexerRule {
                name: "ID",
                visibility: Visibility::Default,
                is_fragment: false,
                skip: false,
                more: false,
                type_override: null,
                channel: 0,
                mode: 0,
                set_mode: -1,
                push_mode: -1,
                pop_mode: false,
                is_virtual: false,
                options: [],
                body: [
                    LexerAlternative {
                        elements: [LexerElement::Literal("x")],
                    },
                ],
            },
            LexerRule {
                name: "IF",
                visibility: Visibility::Default,
                is_fragment: false,
                skip: false,
                more: false,
                type_override: Option::<String>::Some("ID"),
                channel: 0,
                mode: 0,
                set_mode: -1,
                push_mode: -1,
                pop_mode: false,
                is_virtual: false,
                options: [],
                body: [
                    LexerAlternative {
                        elements: [LexerElement::Literal("if")],
                    },
                ],
            },
        ],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    // IF rule should produce tokens tagged as TK_ID (not TK_IF).
    assert output.contains("best_kind = TK_ID");
    // TK_IF should still exist as a token kind (not renamed), because
    // type_override only rewrites emission, not the rule identifier.
    assert output.contains("pub global TK_IF: i32 = ");
}

test "generate lexer channel" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [
            LexerRule {
                name: "COMMENT",
                visibility: Visibility::Default,
                is_fragment: false,
                skip: false,
                more: false,
                type_override: null,
                channel: 2,
                mode: 0,
                set_mode: -1,
                push_mode: -1,
                pop_mode: false,
                is_virtual: false,
                options: [],
                body: [
                    LexerAlternative {
                        elements: [LexerElement::Literal("#")],
                    },
                ],
            },
        ],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("best_channel");
    assert output.contains("best_channel = 2");
    // Non-default channels must be routed to trivia, not tokens — ANTLR4
    // hides channels other than DEFAULT from parser rules.
    assert output.contains("if best_channel != 0");
    assert output.contains("ts.push_trivia(best_kind, tok_start, best_end, best_channel);");
    // No `-> skip` rule and no action to latch one, so `is_skip` never exists.
    assert !output.contains("let is_skip");
}

test "generate lexer hidden channel routes to trivia" {
    // `channel(HIDDEN)` must not set `skip`, and tokens matching the rule
    // must be routed to trivia (not the tokens stream) so the parser does
    // not see them.
    let input = "lexer grammar Test;
WS : [ \\t]+ -> channel(HIDDEN) ;
ID : [a-z]+ ;";
    let mut grammar = parse_grammar(input, "test.g4");
    // Parser-side contract: HIDDEN channel must not degrade to skip.
    for let r of &grammar.lexer_rules {
        if r.name == "WS" {
            assert r.skip == false;
            assert r.channel == 1;
        }
    }
    // Generator-side contract: the emitted dispatch must route `best_channel
    // != 0` matches to trivia via `Token::with_channel`, not to the tokens
    // stream.
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("if best_channel != 0");
    assert output.contains("ts.push_trivia(best_kind, tok_start, best_end, best_channel);");
    assert !output.contains("let is_skip");
}

test "generate left-associative LR alt passes own_prec+1 on right operand" {
    // Baseline without `<assoc=right>`: the recursive right operand runs at
    // `own_prec + 1` so same-precedence operators are left-associative
    // (handled by the outer precedence loop, not by nested recursion).
    let input = "grammar Test;
expr : expr '**' expr | NUMBER ;
NUMBER : [0-9]+ ;
WS : [ \\t\\r\\n]+ -> skip ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("_parse_expr(p, 2)");
}

test "generate right-associative LR alt passes own_prec on right operand" {
    // `<assoc=right>` lowers the inner threshold so same-precedence `**`
    // nests rightward: `2 ** 3 ** 4` parses as `2 ** (3 ** 4)`.
    let input = "grammar Test;
expr : <assoc=right> expr '**' expr | NUMBER ;
NUMBER : [0-9]+ ;
WS : [ \\t\\r\\n]+ -> skip ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("_parse_expr(p, 1)");
    // And the scan-side mirror must be kept in sync.
    assert output.contains("scan_expr(tokens, pos, 1)");
}

fn parse_grammar<S: AsStrSlice, S1: AsStrSlice>(input: S, path: S1) -> Grammar {
    let mut g = parse(input).unwrap();
    g.source_files.push(path.to_string());
    return g;
}

test "LR scan loop saves pos and backs off on a suffix failure" {
    // statement: letterA | statement letterA 'b' ;
    // Both alts start with TK_LIT_a (letterA = 'a'), so the LR suffix's
    // first-token check alone cannot decide whether the suffix will complete.
    // When `scan_statement_lr_1` returns -1 (e.g. the trailing 'b' is missing),
    // the LR loop must restore `pos` to the prior atom-end and `break` —
    // never propagate `-1` as the whole scan failing, which would prevent
    // the enclosing `statement*` repetition from matching anything (ANTLR4
    // stops after the longest valid prefix).
    let input = "grammar Test;
prog : statement* EOF ;
statement : letterA | statement letterA 'b' ;
letterA : 'a' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let scan_body = extract_fn_body(&output, "fn scan_statement(");
    // The LR loop must save `pos` before the suffix call and restore it on
    // failure. Look for the save+restore pair around `scan_statement_lr_1(`.
    assert scan_body.contains("let lr_saved_pos = pos;");
    assert scan_body.contains("pos = lr_saved_pos; break;");
}

test "LR helper stamps min_prec on a self-ref nested inside a Repeat group" {
    // Regression: nested self-ref in `(',' b+=expr)*` kept min_prec=0
    // and ate the outer `'>>'`. Grammar mirrors `ReturnValueAndActionsList1_2`
    // with two LR alts so wrong-alt-index `conflict_min` reads (e.g.
    // always `lr_alts[0]`) also trip.
    let input = "grammar Test;
s : expr EOF ;
expr :
    a=expr '*' a=expr #Factor
    | b+=expr (',' b+=expr)* '>>' c=expr #Send
    | ID #JustId
;
ID : 'a' ;
WS : [ \\t\\n]+ -> skip ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let helper = extract_fn_body(&output, "fn _parse_expr__inner(");
    // Send is the second LR alt of two left-assoc: own_prec=1, conflict_min=2.
    // The self-refs in the Send suffix must be stamped with min_prec 2.
    assert !helper.contains("_parse_expr(p)");
    assert helper.contains("_parse_expr(p, 2)");
    let scan_helper = extract_fn_body(&output, "fn scan_expr_lr_1");
    assert !scan_helper.contains("scan_expr(tokens, pos, 0)");
    assert scan_helper.contains("scan_expr(tokens, pos, 2)");
}

test "SimpleCst group emit threads min_prec_arg on a self-ref alt inside an LR suffix" {
    // `gen_consume_group_store_op` / `_optional_op` and
    // `gen_rule_ref_group_scan_dispatch` used to emit `_parse_X(p)?`
    // without reading `min_prec_arg`, dropping the stamp set by the
    // deep walker. `(expr | INT)` inside the LR suffix is a SimpleCst
    // Group that exercises the path.
    let input = "grammar Test;
s : expr EOF ;
expr : expr ',' (expr | INT) | INT ;
INT : [0-9]+ ;
WS : [ \\t\\n]+ -> skip ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let helper = extract_fn_body(&output, "fn _parse_expr__inner(");
    assert helper.len() > 0;
    assert !helper.contains("_parse_expr(p)");
    assert helper.contains("_parse_expr(p, 2)");
}

test "LR parse loop predicts via scan when suffix's first token is shared with the atom" {
    // Same grammar as the scan-side test. On the parse side the suffix call
    // mutates `p.pos`, so the LR loop must consult the scan twin first to
    // decide whether to commit. Without that check, `parse_statement_lr_1`
    // would consume `letterA` then fail on `'b'`, leaving `p.pos` mid-suffix
    // and corrupting the surrounding `statement*` driver.
    let input = "grammar Test;
prog : statement* EOF ;
statement : letterA | statement letterA 'b' ;
letterA : 'a' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let parse_body = extract_fn_body(&output, "fn _parse_statement__inner(");
    assert parse_body.contains("scan_statement_lr_1(") || parse_body.contains("scan_statement_lr_1 (");
}

test "generate emits pub fn parse_<rule>(input) per parser rule" {
    // Per-rule input entries are the start-rule API: callers route an
    // input directly into rule R via `parse_R(input)` instead of having
    // to construct a Parser and call `_parse_R(p)`. Generated parsers
    // also keep `pub fn parse(input)` as a thin alias for the first
    // rule's entry — downstream callers (driver tests, descriptors with
    // no `[start]`) depend on it.
    let input = "grammar Test;
a : 'x' ;
b : 'y' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("pub fn parse_a<S: AsStrSlice>(input: S");
    assert output.contains("pub fn parse_b<S: AsStrSlice>(input: S");
    // Each `parse_<rule>` is a thin wrapper that hands the rule's
    // `_parse_<rule>` entry to the shared `_run_parse_entry` helper as a fn value;
    // `_run_parse_entry` builds the Parser and folds the error into the diagnostics.
    assert output.contains(
        "fn _run_parse_entry<S: AsStrSlice>(input: S, max_errors: i32, entry: fn(&mut Parser)) -> ParseResult",
    );
    assert output.contains("return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_a(p));");
    assert output.contains("return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_b(p));");
    // `pub fn parse` is a thin alias for the first rule's entry.
    assert output.contains("return parse_a(input, max_errors);");
}

test "trace option emits per-rule enter/ok/fail instrumentation" {
    // `gale gen --trace` / `options: { trace: true }` instruments every
    // rule-entry wrapper so the recursive-descent path and the bail point
    // are visible on stderr when a grammar rejects an input.
    let input = "grammar Test;
a : 'x' b ;
b : 'y' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let traced = generate(&mut grammar, &GenerateOptions { trace: true }).source;
    // The `core:log` import, the trace helpers, the opt-in sink installer, the
    // depth field, and the per-rule calls are all present.
    assert traced.contains(
        "use { Level, Log, TextSink, enabled, log_level, set_log_level, trace } from \"core:log\";",
    );
    assert traced.contains("fn trace_enter<S: AsStrSlice>(p: &Parser, rule: S)");
    assert traced.contains("pub fn trace_to_stderr<T, effect E>");
    assert traced.contains("trace_depth: i32,");
    assert traced.contains("trace_enter(p, \"a\");");
    assert traced.contains("trace_fail(p, \"a\", p.pending_message());");
    assert traced.contains("trace_ok(p, \"b\");");

    // Default generation (trace off) must contain none of it — the feature
    // is strictly opt-in and adds zero instrumentation otherwise.
    let mut grammar2 = parse_grammar(input, "test.g4");
    let plain = generate(&mut grammar2, &GenerateOptions { trace: false }).source;
    assert !plain.contains("trace_enter");
    assert !plain.contains("trace_depth");
    assert !plain.contains("core:log");
}

test "token-led overlap dispatch emits no per-alt scan helpers" {
    // `r`'s alts share the first token `'{'` but split on the second
    // (`a` vs `'}'`), so prediction resolves token-led: a `peek_kind`
    // dispatch that never calls a scan helper, leaving the per-alt
    // `_parse_r__inner_scan_<n>` helpers dead.
    let input = "grammar T;
r : '{' a '}' | '{' '}' ;
a : 'x' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    // Both alts are reached (the group resolved, not collapsed)...
    assert output.contains("fn _parse_r__inner_alt_0(");
    assert output.contains("fn _parse_r__inner_alt_1(");
    // ...but neither scan helper is emitted.
    assert !output.contains("fn _parse_r__inner_scan_");

    // A shared-prefix tournament rule still emits its scan helpers, so the
    // gate is not over-pruning.
    let tinput = "grammar T;
s : X s Y? | X ;
X : 'X' ;
Y : 'Y' ;
";
    let mut tg = parse_grammar(tinput, "test.g4");
    let tout = generate(&mut tg, &DEFAULT_OPTIONS).source;
    assert tout.contains("fn scan_s_alt_0(");
}

test "an alternative's scan helper is emitted once for the scan and the parse" {
    // Alt 0 is contested in `scan_r`, so the scan side emits its function; the
    // parse side's tournament scans it too, and must call that function.
    let input = "grammar T;
s : r EOF ;
r : a X | A a Y | B a Z ;
a : (A|B)+ ;
A : 'A' ;
B : 'B' ;
X : 'X' ;
Y : 'Y' ;
Z : 'Z' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("fn scan_r_alt_0(");
    assert !output.contains("fn _parse_r__inner_scan_0(");
    assert output.contains("let _sd_p_0 = scan_r_alt_0(_sd_tokens, _sd_pos");
}

test "a scan never re-tests a token its guard already proved" {
    // `(',' b)*` enters on `','`, and `('*' | '/')` is one token out of two.
    let input = "grammar T;
s : r EOF ;
r : a | a X ;
a : b (',' b)* ('*' | '/') ;
b : Y ;
X : 'X' ;
Y : 'Y' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, "fn scan_a(");
    assert body.len() > 0, "expected a scan_a body";
    assert body.contains("while pos < tokens.len() && tokens[pos] == TK_LIT_COMMA");
    assert !body.contains("tokens[pos] != TK_LIT_COMMA"), `the loop guard proved ','\n${body}`;
    assert !body.contains("_best"), `a single-token alternation is a set test, not a tournament\n${body}`;
}

test "a token the dispatch decided is taken, not expected" {
    let input = "grammar T;
s : r EOF ;
r : A B | C B | t ;
t : A2 | C2 ;
A : 'A' ;
B : 'B' ;
C : 'C' ;
A2 : 'a' ;
C2 : 'c' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let r = extract_fn_body(&output, "fn _parse_r__inner(");
    assert r.contains("p.take();"), r;
    assert !r.contains("p.expect(TK_A,"), `the dispatch proved A\n${r}`;
    assert r.contains("p.expect(TK_B,"), r;
    let t = extract_fn_body(&output, "fn _parse_t__inner(");
    assert t.contains("p.take();"), t;
    assert !t.contains("p.expect(kind"), `the dispatch proved the token\n${t}`;
}

test "a dispatch never re-tests the token its arm tested" {
    let input = "grammar T;
s : r e EOF ;
r : a | b ;
a : X Y* ;
b : X Y* Z ;
e : e '.' ID | e '.' ID '(' ')' | ID ;
X : 'x' ;
Y : 'y' ;
Z : 'z' ;
ID : [a-w]+ ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let mut prev = "";
    for let line of output.split("\n") {
        let t = line.trim().to_string();
        assert !(t.starts_with("if ") && t.ends_with("{") && t == prev), `nested re-test: ${t}`;
        prev = t;
    }
}

test "a scan tests a one-token rule inline, and trusts a callee that consumes" {
    let input = "grammar T;
s : (n | n K1)* EOF ;
n : a K2? ;
a : ID | k | '(' a ')' ;
k : K1 | K2 ;
ID : [a-z]+ ;
K1 : 'K' ;
K2 : 'J' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let a = extract_fn_body(&output, "fn scan_a(");
    assert a.len() > 0, output;
    assert !a.contains("scan_k("), `the partition proved k's token\n${a}`;
    let n = extract_fn_body(&output, "fn scan_n(");
    assert n.len() > 0, output;
    assert !n.contains("scan_start"), `scan_a never matches empty\n${n}`;
}

test "a scan candidate that runs first does not rewind to where it is" {
    let input = "grammar T;
s : (a | a Z)* EOF ;
a : X | m ;
m : Y Y ;
X : 'x' ; Y : 'y' ; Z : 'z' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let a = extract_fn_body(&output, "fn scan_a(");
    assert a.contains("scan_m("), a;
    assert !a.contains("pos = start;"), a;
}

test "a scan calls through a rule that only forwards to another" {
    let input = "grammar T;
s : (t | t Z)* EOF ;
t : n X ;
n : a ;
a : Y Y | X Y ;
X : 'x' ; Y : 'y' ; Z : 'z' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let t = extract_fn_body(&output, "fn scan_t(");
    assert t.contains("scan_a("), t;
    assert !output.contains("fn scan_n("), output;
}

test "a decline check names each continuing token once" {
    let input = "grammar T;
s : (t | t X)* EOF ;
t : '(' fs? ')' ;
fs : f (',' f)* ','? ;
f : at* v? ty ;
at : '#' '[' ID ']' ;
v : 'pub' ;
ty : ID | '(' fs? ')' ;
X : 'x' ;
ID : [a-w]+ ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("decline_kind"), output;
    for let line of output.split("\n") {
        let terms: List<String> = line.split(" || ").map(|t| t.trim().to_string()).collect();
        for let i of 1..<terms.len() {
            assert terms[i] != terms[i - 1] || terms[i].contains("{"), `a repeated term: ${line}`;
        }
    }
}

test "a scan function nothing calls is not emitted" {
    let input = "grammar T;
s : a b EOF ;
a : X Y ;
b : (c | c Z)* ;
c : W+ ;
X : 'x' ; Y : 'y' ; Z : 'z' ; W : 'w' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert !output.contains("fn scan_a("), output;
    assert output.contains("fn scan_c("), output;
}

test "every emitted FOLLOW mask is named by a call" {
    let mut grammar = parse_grammar(#include_str("../tests/grammars/SQLite.g4"), "SQLite.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let mut masks = 0;
    for let line of output.split("\n") {
        if !line.starts_with("global FOLLOW_MASK_") {
            continue;
        }
        masks += 1;
        let name = line.split(":").next().unwrap().to_string().split(" ").last().unwrap().to_string();
        assert count_substr(&output, `${name},`) + count_substr(&output, `${name})`) + count_substr(&output, `${name} `) > 0, `${name} is never named`;
    }
    assert masks > 0, "SQLite interns FOLLOW masks";
}

test "an optional takes the token its guard tested" {
    let input = "grammar T;
s : A B? (C D)? (E | F)? G EOF ;
A : 'a' ; B : 'b' ; C : 'c' ; D : 'd' ; E : 'e' ; F : 'f' ; G : 'g' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, "fn _parse_s__inner(");
    assert !body.contains("p.expect(TK_B"), body;
    assert !body.contains("p.expect(TK_C"), body;
    assert !body.contains("p.expect_set("), body;
    assert body.contains("p.expect(TK_D"), body;
}

test "an LR suffix takes the operator its arm tested" {
    let input = "grammar T;
s : e EOF ;
e : e '+' e | e '.' ID | e '.' ID '(' ')' | ID ;
ID : [a-z]+ ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, "fn _parse_e__inner(");
    assert body.len() > 0, output;
    assert !body.contains("p.expect(TK_LIT_PLUS"), body;
    assert !body.contains("p.expect(TK_LIT_DOT"), body;
}

test "a prefix operator set takes the token its arm tested" {
    let input = "grammar T;
s : e EOF ;
e : e '*' e | ('-' | '!') e | ID ;
ID : [a-z]+ ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, "fn _parse_e__inner_atom(");
    assert body.len() > 0, output;
    assert !body.contains("p.expect_set("), body;
}

test "a function that only forwards is not emitted" {
    let input = "grammar T;
s : (r | r X)* EOF ;
r : n | n Y | z ;
n : A B ;
z : A ;
A : 'a' ; B : 'b' ; X : 'x' ; Y : 'y' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    for let name of ["fn _parse_r__inner_alt_0(", "fn scan_r_alt_0(", "fn _parse_z__inner("] {
        assert !output.contains(name), output;
    }
}

test "a rule's @after is emitted once, whichever alternative finished" {
    let input = "grammar T;
options { language = Wado; }
r returns [i32 v]
    @after { p.emit(`a${$v}`); }
    : A { $v = 1; }
    | B { $v = 2; }
    | s
    | s C
    ;
s : A+ ;
A : 'a' ; B : 'b' ; C : 'c' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert count_substr(&output, "p.emit(`a${") == 1, output;
}

test "arms that emit the same body are one arm" {
    let input = "grammar T;
s : (l | l X)* e EOF ;
l : A | B | C D ;
e : e NOT? (L | G) e | e NOT N | ID ;
A : 'a' ; B : 'b' ; C : 'c' ; D : 'd' ; X : 'x' ; L : 'l' ; G : 'g' ; N : 'n' ; NOT : '!' ;
ID : [e-k]+ ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    for let f of ["fn scan_l(", "fn _parse_l__inner("] {
        let body = extract_fn_body(&output, f);
        assert body.len() > 0, output;
        assert !body.contains("if kind == TK_A {"), body;
    }
    for let arm of ["suffix_kind == TK_L", "_sk == TK_L"] {
        assert !output.contains(arm), output;
    }
}

test "a group arm takes the token its branch tested" {
    let input = "grammar T;
s : (A B | C D) e EOF ;
e : e '*' e | e (X | Y Z) | e (Q ID)? '!' | ID ;
A : 'a' ; B : 'b' ; C : 'c' ; D : 'd' ; X : 'x' ; Y : 'y' ; Z : 'z' ; Q : 'q' ;
ID : [e-p]+ ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    for let kind of ["TK_A", "TK_C", "TK_Y", "TK_Q"] {
        assert !output.contains(`p.expect(${kind},`), output;
    }
}

test "an element is bound only where an action reads it" {
    let input = "grammar T;
options { language = Wado; }
s : x=A B {let _ = $x;} ;
A : 'A' ;
B : 'B' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, "fn _parse_s__inner(");
    assert body.contains("let x = p.expect(TK_A"), body;
    assert body.contains("    p.expect(TK_B"), `nothing reads B\n${body}`;
}

test "trace option instruments the scan tournament and alt picks" {
    // A rule whose alts share an opaque rule-ref prefix (`b X` vs `b Y`)
    // lowers to the longest-match scan tournament (the disambiguating token
    // is hidden inside `b`, and neither alt is at-end relative to the other,
    // so it is not an ATN-routed `AtEndConflict`). Trace must surface the
    // per-alt scan lengths and the committed winner so a mis-prediction is
    // visible.
    let input = "grammar T;
r : a EOF ;
a : b X
  | b Y
  ;
b : Z Z ;
X : 'X' ;
Y : 'Y' ;
Z : 'Z' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let traced = generate(&mut grammar, &GenerateOptions { trace: true }).source;
    assert traced.contains("trace_scan_alt(p, \"a\",");
    assert traced.contains("trace_pick(p, \"a\", _sd_best_i);");
    assert traced.contains("fn trace_scan_alt<S: AsStrSlice>(p: &Parser, rule: S, alt: i32, end: i32)");

    // Default generation (trace off) emits none of the decision-point hooks.
    let mut grammar2 = parse_grammar(input, "test.g4");
    let plain = generate(&mut grammar2, &GenerateOptions { trace: false }).source;
    assert !plain.contains("trace_scan_alt");
    assert !plain.contains("trace_pick");
    assert !plain.contains("trace_try");
}

test "trace suppresses the pick line for all-single-token rules" {
    // `tok` is a pure single-token choice: the committed alt is already
    // self-evident from the lookahead token on the `enter` line, so its
    // `pick` would be pure noise and must be suppressed. `sub` chooses
    // among alts that consume sub-structure (`A x` vs `B`), so its pick
    // carries real information and stays.
    let input = "grammar T;
r : tok sub EOF ;
tok : A | B | C ;
sub : A x | B ;
x : A ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let traced = generate(&mut grammar, &GenerateOptions { trace: true }).source;
    assert !traced.contains("trace_pick(p, \"tok\",");
    assert traced.contains("trace_pick(p, \"sub\",");
}

test "generate emits pub fn parse_<rule>(input) for LR rule with min_prec=0" {
    // LR rules' `_parse_expr` wrapper defaults `min_prec` to 0, so the public
    // entry admits every LR alt (historic `parse` behaviour).
    let input = "grammar Test;
expr : expr '+' expr | NUMBER ;
NUMBER : [0-9]+ ;
WS : [ \\t\\n]+ -> skip ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("pub fn parse_expr<S: AsStrSlice>(input: S");
    assert output.contains("return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_expr(p));");
}

test "token-only group `(K_A | K_B)` gates p.advance() on a kind-check" {
    // Regression: a token-only group used to emit as a bare
    // `let lit_x_or_lit_y = p.advance();` with no `peek_kind` guard,
    // so any token at that position was silently consumed. Surfaced
    // by `ParserErrors/SingleTokenDeletionExpectingSet` and
    // `ParserErrors/SingleTokenDeletionBeforeAlt`. After the fix the
    // emit routes through `p.expect_set(&SYNC_<id>)` which fails when the
    // current token is outside the set. Regression fixture:
    // `tests/grammars/parser_set_group_dispatch.g4`.
    let input = "grammar Test;
a : 'a' ('b' | 'c') 'd' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, "fn _parse_a__inner(");
    assert body.contains("p.expect_set(&SYNC_");
    assert !body.contains("p.advance();");
}

fn extract_fn_body<S: AsStrSlice, S1: AsStrSlice>(output: S, header: S1) -> String {
    let start = find_substr(output, header);
    if start < 0 {
        return "";
    }
    // Find the next "\nfn " (start of the next top-level fn) or end of file.
    let after = start + header.len();
    let next = find_substr_from(output, "\nfn ", after);
    let end = if next < 0 { output.len() } else { next };
    return output.substr_bytes(start, end);
}

/// Whether `body` tests `kind`, by name or through a `_kind_set_<id>` helper
/// that `output` defines.
fn body_tests_kind<S: AsStrSlice>(output: &String, body: &String, kind: S) -> bool {
    if body.contains(&kind) {
        return true;
    }
    let mut at = find_substr(body, "_kind_set_");
    while at >= 0 {
        let open = find_substr_from(body, "(", at);
        let def = extract_fn_body(output, `fn ${body.substr_bytes(at, open)}(`);
        if def.contains(&kind) {
            return true;
        }
        at = find_substr_from(body, "_kind_set_", open);
    }
    return false;
}

fn find_substr<S: AsStrSlice, S1: AsStrSlice>(haystack: S, needle: S1) -> i32 {
    return find_substr_from(haystack, needle, 0);
}

fn find_substr_from<S: AsStrSlice, S1: AsStrSlice>(haystack: S, needle: S1, from: i32) -> i32 {
    let h_len = haystack.len();
    let n_len = needle.len();
    if n_len > h_len {
        return -1;
    }
    let limit = h_len - n_len;
    for let mut i = from; i <= limit; i += 1 {
        let mut ok = true;
        for let mut j = 0; j < n_len; j += 1 {
            if haystack.get_byte_unchecked(i + j) != needle.get_byte_unchecked(j) {
                ok = false;
                break;
            }
        }
        if ok {
            return i;
        }
    }
    return -1;
}

test "caseInsensitive grammar option makes literal match CI" {
    let input = "lexer grammar Test;
options { caseInsensitive = true; }
IF : 'if' ;
WS : [ \\t]+ -> skip ;";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    // A case-insensitive 'i' must use the branchless CI comparison helper.
    assert output.contains("!chars[pos].eq_ignore_ascii_case(&'i')");
    assert output.contains("!chars[pos].eq_ignore_ascii_case(&'f')");
}

test "caseInsensitive grammar option makes char-range match CI" {
    let input = "lexer grammar Test;
options { caseInsensitive = true; }
ID : [a-z]+ ;";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    // A case-insensitive [a-z] must also accept [A-Z].
    assert output.contains("'A'..='Z'");
}

test "lexer rule caseInsensitive=false overrides grammar-level true" {
    let input = "lexer grammar Test;
options { caseInsensitive = true; }
IF : 'if' ;
STRICT options { caseInsensitive = false; } : 'x' ;
WS : [ \\t]+ -> skip ;";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    // IF still CI: the literal 'i' must use the branchless CI helper.
    assert output.contains("!chars[pos].eq_ignore_ascii_case(&'i')");
    // STRICT: rule-level caseInsensitive=false means 'x' must NOT be folded,
    // regardless of which match path the optimisation chose for the rule
    // (keyword classifier, regular dispatch, or shared literal).
    assert !output.contains("eq_ignore_ascii_case(&'x')");
}

test "lexer rule caseInsensitive=true enables CI when grammar-level absent" {
    let input = "lexer grammar Test;
KW options { caseInsensitive = true; } : 'go' ;
ID : [a-z]+ ;";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("!chars[pos].eq_ignore_ascii_case(&'g')");
    // ID is not CI; its range must stay [a-z] without a mirrored [A-Z].
    assert !output.contains("'A'..='Z'");
}

test "virtual tokens are marked and not match-generated" {
    // Virtual tokens (declared in `tokens { }` without a real lexer rule) must
    // still appear in the TK_<name> constant table and the token_kind_name
    // dispatch — but they must not get a try_<name> matcher (the tokenizer
    // cannot produce them directly), and the emitted entries should be tagged
    // `// virtual` so downstream tooling can see the distinction.
    let input = "grammar Test;
tokens { VIRTUAL_TOK }
rule : ID ;
ID : [a-z]+ ;
WS : [ \\t]+ -> skip ;";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("global TK_VIRTUAL_TOK: i32 = ") && output.contains(";  // virtual");
    assert output.contains("TK_VIRTUAL_TOK => \"VIRTUAL_TOK\",  // virtual");
    assert !output.contains("fn try_VIRTUAL_TOK(");
}

test "caseInsensitive does not fold non-letters" {
    let input = "lexer grammar Test;
options { caseInsensitive = true; }
DIGITS : [0-9]+ ;
SEMI : ';' ;";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    // Digit range must not be duplicated.
    assert output.contains("'0'..='9'");
    // Non-letter literal must not be duplicated — plain mismatch form.
    assert output.contains("chars[pos] != ';'");
    assert !output.contains("chars[pos].eq_ignore_ascii_case(");
}

test "metadata comment lists grammar-level options" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [
            GrammarOption { name: "language", value: OptionValue::Ident("Python") },
            GrammarOption { name: "superClass", value: OptionValue::Qualified(["my", "pkg", "BaseParser"]) },
            GrammarOption { name: "tokenVocab", value: OptionValue::Ident("TestLexer") },
            GrammarOption { name: "caseInsensitive", value: OptionValue::Ident("true") },
        ],
        named_actions: [],
        pending_refs: [],
        source_files: [],
        parser_superclass: "BaseParser",
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("// Grammar metadata from source .g4 prequels:");
    assert output.contains("//   option language = Python");
    assert output.contains("//   option superClass = BaseParser (parser)");
    assert !output.contains("//   option superClass = my.pkg.BaseParser");
    assert output.contains("//   option tokenVocab = TestLexer");
    assert output.contains("//   option caseInsensitive = true");
}

test "metadata comment formats string and int option values" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [
            GrammarOption { name: "tokenVocab", value: OptionValue::Str("foo.g4") },
            GrammarOption { name: "k", value: OptionValue::Int(3) },
            GrammarOption { name: "init", value: OptionValue::Action(ActionSource { text: "some code;" }) },
        ],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert output.contains("//   option tokenVocab = \"foo.g4\"");
    assert output.contains("//   option k = 3");
    assert output.contains("//   option init = { ... }");
}

test "metadata comment lists named actions" {
    let mut grammar = Grammar {
        name: "Test",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [
            NamedAction { scope: null, name: "header" },
            NamedAction { scope: Option::<String>::Some("parser"), name: "members" },
            NamedAction { scope: Option::<String>::Some("lexer"), name: "members" },
        ],
        pending_refs: [],
        source_files: [],
    };
