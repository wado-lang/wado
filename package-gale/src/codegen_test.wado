                            Element::RuleRef(RuleRefElement::new("expr")),
                            Element::TokenRef(TokenRefElement::new("PLUS")),
                            Element::RuleRef(RuleRefElement::new("term")),
                        ],
                    },
                    Alternative {
                        label: Option::<String>::Some("Pass"),
                        options: [],
                        elements: [Element::RuleRef(RuleRefElement::new("term"))],
                    },
                ],
