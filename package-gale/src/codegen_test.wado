    assert str_contains(&output, &"// rule visibility: protected (ignored by codegen, matches ANTLR4)");
}

test "single-char literal lexer rule without an identifier carrier emits its own try_ matcher" {
    // `A : 'A' ;` and `B : 'B' ;` look like keyword candidates (single-letter
    // literal rules). But the keyword classifier only fires after a longer
    // non-keyword rule has already matched the same characters — and this
    // grammar has no such carrier (only WS, which matches whitespace). Without
    // demotion the literals would be unreachable: the tokenize loop would not
    // dispatch on 'A'/'B', and `classify_keyword` would never run on them.
    let input = "grammar Test;
r : A B ;
A : 'A' ;
B : 'B' ;
WS : [ \\t\\n\\r]+ -> skip ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert str_contains(&output, &"fn try_A(");
    assert str_contains(&output, &"fn try_B(");
    assert str_contains(&output, &"first_char matches { 'A' }");
    assert str_contains(&output, &"first_char matches { 'B' }");
}

test "set list-label `name+=(A | B)*` emits List<Token> + expect_set" {
    let input = "grammar T;
b : ID val+=(INT | FLOAT)* ;
ID : 'a'..'z'+ ;
INT : '0'..'9'+ ;
FLOAT : [0-9]+ '.' [0-9]+ ;
WS : (' '|'\\n') -> skip ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_b__inner(");
    assert str_contains(&body, &"p.expect_set(&SYNC_");
    assert str_contains(&output, &"global SYNC_0: List<i32> = [TK_FLOAT, TK_INT];");
}

test "non-greedy optional (??) emits Option<T> + single if" {
    let input = "grammar T;
start : statement+ EOF ;
statement : 'x' | ifStmt ;
ifStmt : 'if' 'y' statement ('else' statement)?? ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_if_stmt__inner(");
    // The non-greedy `??` enter/skip decision is taken at runtime by the
    // ATN simulator (full context), not by a static first-set peek — so the
    // shape is still a single `Option<T>` if (not a `while` loop), but the
    // condition is the simulator call. The decision number is stamped at
    // compile time (`atn_predict_with_stack`), retiring the old
    // `atn_ng_optional_enter` exit-first BlockStart search.
    assert str_contains(&body, &"if atn_predict_with_stack(&ATN_SIM,");
    assert str_contains(&body, &") == 1");
    assert !str_contains(&body, &"atn_ng_optional_enter(");
    assert !str_contains(&body, &"if p.peek_kind() == TK_LIT_ELSE");
    assert !str_contains(&body, &"while p.peek_kind() == TK_LIT_ELSE");
}

test "single-char literal with an ID carrier stays a keyword (no try_ matcher)" {
    // `A : 'A'` is a keyword candidate, and `ID : [a-zA-Z]+` covers 'A' as a
    // first character. The classify_keyword path is therefore reachable, so
    // `A` must keep its keyword classification — no try_a is emitted.
    let input = "grammar Test;
r : A ID ;
A : 'A' ;
ID : [a-zA-Z]+ ;
WS : [ \\t\\n\\r]+ -> skip ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert !str_contains(&output, &"fn try_A(");
    assert str_contains(&output, &"classify_keyword");
}

test "keyword candidate declared after a colliding carrier falls back to its own matcher" {
    // `A : 'a' EOF ;` is a carrier for the single-char literal `B : 'a' ;`,
    // but B is declared *after* A. Under ANTLR4 longest-match-then-first-rule
    // both match `a` (A also consumes the trailing EOF), so A wins. The keyword
    // classifier reclassifies a carrier match into the keyword unconditionally,
    // so admitting B as a keyword would mis-tag A's match as B (the
    // `LexerExec/EOFSuffixInFirstRule_2` descriptor regression). B must instead
    // fall back to regular first-character dispatch, where the strict `>`
    // longest-match tiebreak keeps the earlier rule A.
    let input = "lexer grammar L;
A : 'a' EOF ;
B : 'a' ;
C : 'c' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert str_contains(&output, &"fn try_B(");
}

test "generate returns source and lowering diagnostics from one lowering" {
    // `r : A B | A C ;` — both alts start with `A`, so lowering resolves
    // the overlap with a scan tournament and raises one OverlapTournament
    // diagnostic. `generate` hands the diagnostics back on its
    // `GeneratedOutput`, so `gale gen` surfaces them on stderr without
    // lowering the grammar a second time.
    let input = "grammar Test;
r : A B | A C ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let generated = generate(&mut grammar, &DEFAULT_OPTIONS);
    assert generated.source.len() > 0;
    assert generated.diagnostics.len() == 1, `expected 1 diagnostic, got ${generated.diagnostics.len()}`;
    let d = &generated.diagnostics[0];
    assert d.owner.rule == "r", `expected the diagnostic to own rule "r", got "${d.owner.rule}"`;
    if let OverlapTournament = &d.kind {
    } else {
        panic("expected DiagnosticKind::OverlapTournament");
    }
}

test "both error paths name tokens through one vocabulary" {
    // `expect` and the no-viable fallback both report through
    // `token_kind_name`, so one token never reads `A` on one path and `TK_A`
    // on the other.
    let input = "grammar Test;
r : A B | A C ;
s : r ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let out = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert str_contains(&out, &"p.no_viable("), out;
    // Both paths read one vocabulary: `kind_names` over the interned kind ids.
    assert str_contains(&out, &"kind_names(expected)"), out;
    assert !str_contains(&out, &"\"TK_A\""), `a kind constant leaked into a user-facing list:\n${out}`;
}

test "the vocabulary names a literal by its source form" {
    // ANTLR4's `Vocabulary.getDisplayName` shows a literal as it appears in
    // the grammar, so `expected` sets and `<missing X>` read `'+'` rather than
    // the `TK_LIT_PLUS` constant Gale interned it under.
    let input = "grammar Test;
r : A '+' ;
A : 'a' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let out = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert str_contains(&out, &"TK_LIT_PLUS => \"'+'\""), out;
    // A lexer rule still answers with its rule name.
    assert str_contains(&out, &"TK_A => \"A\""), out;
}

test "generate raises no diagnostics for disjoint alts" {
    // `r : A | B ;` has disjoint first sets, so lowering dispatches
    // directly with nothing to warn about — `GeneratedOutput.diagnostics`
    // is empty.
    let input = "grammar Test;
r : A | B ;
A : 'a' ;
B : 'b' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let generated = generate(&mut grammar, &DEFAULT_OPTIONS);
    assert generated.source.len() > 0;
    assert generated.diagnostics.is_empty(), `expected no diagnostics, got ${generated.diagnostics.len()}`;
}

test "an optional group's entry guard is the scan its dispatch decides on" {
    // `stmt : 'k' ( a | b | a '.' b )? ;` — alts 0 and 2 share FIRST, so the
    // group needs a longest-match decision. Deciding entry and deciding the
    // alternative is one question: each alternative is scanned once, and the
    // dispatch reads the winner the entry guard already found.
    let input = "grammar Test;
stmt : 'k' ( a | b | a '.' b )? ;
a : A ;
b : B ;
A : 'a' ;
B : 'b' ;
";
    let mut grammar = parse_grammar(input, "test.g4");
    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_stmt__inner(");
    assert body.len() > 0, "expected a _parse_stmt__inner body";
    let scans_a = count_substr(&body, &"scan_a(");
    let scans_b = count_substr(&body, &"scan_b(");
    assert scans_a == 2, `alts 0 and 2 name 'a' once each; scanned it ${scans_a} times`;
    assert scans_b == 2, `alts 1 and 2 name 'b' once each; scanned it ${scans_b} times`;
}

fn str_contains(haystack: &String, needle: &String) -> bool {
    let h_len = haystack.len();
    let n_len = needle.len();
    if n_len > h_len {
        return false;
    }
    for let mut i = 0; i <= h_len - n_len; i += 1 {
        let mut found = true;
        for let mut j = 0; j < n_len; j += 1 {
            if haystack.get_byte_unchecked(i + j) != needle.get_byte_unchecked(j) {
                found = false;
                break;
            }
        }
        if found {
            return true;
        }
    }
    return false;
}

// A non-greedy `??` inside a left-recursive rule (`e` is LR via `e '+' e`; the
// `??` sits in its atom). The `??`'s ATN prediction must run with the rule's
// live `min_prec` so an enter edge that would climb an LR suffix below it is
// pruned. The atom fn carries `min_prec` and `atn_optional_enter_cond` forwards
// it to `atn_ng_optional_enter`.
global QQ_IN_LR_G4: String = "
grammar T;
e : e '+' e | ID ('x')?? ;
ID : 'a'..'z'+ ;
WS : ' ' -> skip ;
";

test "non-greedy ?? inside a left-recursive rule threads min_prec" {
    let mut g = parse(QQ_IN_LR_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    // The atom fn carries `min_prec`, and the `??` enter check forwards it
    // to the simulator (stamped decision number, `== 1` for ENTER).
    assert str_contains(&output, &"fn _parse_e__inner_atom(p: &mut Parser, min_prec: i32");
    assert str_contains(&output, &", &p.atn_stack, &p.kinds, p.pos, TK_EOF, min_prec) == 1");
    assert str_contains(&output, &"atn_predict_with_stack(&ATN_SIM,");
}

// Two non-greedy `??` in one rule must emit two distinct ATN decision numbers.
global TWO_QQ_CODEGEN_G4: String = "
grammar T;
s : 'a' ('b')?? 'c' ('d')?? EOF ;
WS : ' ' -> skip ;
";

test "multiple ?? in a rule emit distinct ATN decision numbers" {
    let mut g = parse(TWO_QQ_CODEGEN_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_s__inner(");
    assert str_contains(&body, &"atn_predict_with_stack(&ATN_SIM, 0, &p.atn_stack, &p.kinds, p.pos, TK_EOF, 0) == 1");
    assert str_contains(&body, &"atn_predict_with_stack(&ATN_SIM, 1, &p.atn_stack, &p.kinds, p.pos, TK_EOF, 0) == 1");
    assert !str_contains(&body, &"atn_ng_optional_enter(");
}

// A multi-alt `AtEndConflict` must route through the ATN simulator, not the
// `_sd_best_i` longest-match tournament.
global AT_END_CONFLICT_G4: String = "
grammar T;
s : x 'c' ;
x : 'a' 'b' | 'a' 'b' 'c' ;
WS : ' ' -> skip ;
";

test "at-end-conflict multi-alt rule routes through the ATN simulator" {
    let mut g = parse(AT_END_CONFLICT_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_x__inner(");
    assert str_contains(&body, &"let _atn_alt = atn_predict_with_stack(&ATN_SIM,");
    assert str_contains(&body, &"if _atn_alt ==");
    assert !str_contains(&body, &"_sd_best_i");
}

global AT_END_DISJOINT_G4: String = "
grammar T;
s : x 'd' ;
x : 'a' 'b' | 'a' 'b' 'c' ;
WS : ' ' -> skip ;
";

test "FOLLOW-disjoint at-end conflict keeps the static tournament" {
    let mut g = parse(AT_END_DISJOINT_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_x__inner(");
    assert str_contains(&body, &"_sd_best_i");
    assert !str_contains(&body, &"atn_predict_with_stack");
    assert !str_contains(&output, &"global ATN_SIM");
}

global AT_END_NULLABLE_GAP_G4: String = "
grammar T;
s : x nb 'c' ;
x : 'a' 'b' | 'a' 'b' 'c' ;
nb : 'w'? ;
WS : ' ' -> skip ;
";

test "at-end conflict routes through the ATN when a nullable rule hides the caller token" {
    let mut g = parse(AT_END_NULLABLE_GAP_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_x__inner(");
    assert str_contains(&body, &"let _atn_alt = atn_predict_with_stack(&ATN_SIM,");
    assert !str_contains(&body, &"_sd_best_i");
}

global AT_END_WILDCARD_FOLLOW_G4: String = "
grammar T;
s : x . ;
x : 'a' 'b' | 'a' 'b' 'c' ;
WS : ' ' -> skip ;
";

test "wildcard caller suffix keeps the at-end conflict on the ATN" {
    let mut g = parse(AT_END_WILDCARD_FOLLOW_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_x__inner(");
    assert str_contains(&body, &"let _atn_alt = atn_predict_with_stack(&ATN_SIM,");
    assert !str_contains(&body, &"_sd_best_i");
}

test "non-LR ATN grammar opts out of the decoder's LR tables" {
    let mut g = parse(AT_END_CONFLICT_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    assert str_contains(&output, &"global ATN_SIM: AtnSim = atn_decode(&b\"");
    assert str_contains(&output, &"\", false);");
}

global LR_WILDCARD_CODEGEN_G4: String = "
grammar T;
prog : e EOF ;
e : e '+' e | e . | INT ;
INT : [0-9]+ ;
WS : ' ' -> skip ;
";

test "ATN-class LR grammar keeps the decoder's LR tables" {
    let mut g = parse(LR_WILDCARD_CODEGEN_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    assert str_contains(&output, &"global ATN_SIM: AtnSim = atn_decode(&b\"");
    assert str_contains(&output, &"\", true);");
}

fn find_index(haystack: &String, needle: &String) -> i32 {
    return match haystack.find(*needle) {
        Some(idx) => idx,
        None => -1,
    };
}

fn count_substr(haystack: &String, needle: &String) -> i32 {
    let mut n = 0;
    let mut at = find_substr(haystack, needle);
    while at >= 0 {
        n += 1;
        at = find_substr_from(haystack, needle, at + needle.len());
    }
    return n;
}

// The TypeScript `typeParameter` shape: every first token of `id` leads to
// the same depth-1 sub-dispatch, so the branches must fold into one over the
// union of the tokens.
global SHARED_SUBDISPATCH_G4: String = "
grammar T;
tp : id c? | id '=' t | '<' tp '>' ;
id : A | B | C ;
c : 'extends' t ;
t : A ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
WS : [ \\t\\r\\n]+ -> skip ;
";

// A group whose empty alternative is admitted by nothing statically known:
// `r` is the whole rule, so what follows the group is the caller's FOLLOW.
global UNDECIDED_EMPTY_ALT_G4: String = "
grammar T;
r : ( A | | B ) ;
A : 'a' ;
B : 'b' ;
";

// Both a wildcard-led alternative and an empty one admit every lookahead.
global WILDCARD_AND_EMPTY_ALT_G4: String = "
grammar T;
r : ( A | . | ) ;
A : 'a' ;
B : 'b' ;
";

// `C?` leaves the group's suffix nullable, so what may follow it reaches past
// the rule into the caller's FOLLOW. The local part (`C`) is a prefix of the
// answer, not the answer.
global INEXACT_FOLLOW_EMPTY_ALT_G4: String = "
grammar T;
s : r SEMI EOF ;
r : ( A | | B ) C? ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
SEMI : ';' ;
";

// `A` and `A B` overlap, so the rule takes the overlap dispatch rather than
// the token-led one — a second rule-level emitter, with its own arms.
global RULE_OVERLAP_EMPTY_ALT_G4: String = "
grammar T;
x : | A | A B ;
A : 'a' ;
B : 'b' ;
";

// A wildcard body has no first set to narrow the guard by — nothing is
// excluded, so the optional is entered on any token. The same is true of `~X`.
global WILDCARD_OPTIONAL_G4: String = "
grammar T;
s : .? B EOF ;
B : 'b' ;
";

// `A?` is nullable and has a perfectly good first set: a lookahead selects it,
// so it is not the arm that belongs last.
global NULLABLE_BUT_SELECTABLE_ALT_G4: String = "
grammar T;
s : r B EOF ;
r : A? | B ;
A : 'a' ;
B : 'b' ;
";

// The `.` sits behind a nullable prefix, so the alternative has a first set
// (`{A}`) and is still open-ended: `c` reaches the wildcard.
global PREFIXED_WILDCARD_ALT_G4: String = "
grammar T;
s : ( A? . | B ) EOF ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
";

// The epsilon alternative reached through a rule must earn the same follow-set
// branch a written-empty one does.
global INDIRECT_EPSILON_ADMITS_G4: String = "
grammar T;
s : 'k' ( A | x | B ) EOF ;
x : ;
A : 'a' ;
B : 'b' ;
";

// `x` derives only epsilon, but through a rule reference — the mirror of an
// open-ended alternative reached the same way.
global INDIRECT_EPSILON_ALT_G4: String = "
grammar T;
s : ( x | A ) B EOF ;
x : ;
A : 'a' ;
B : 'b' ;
";

// The op walker's `Direct` chain sees only baked token sets, and an
// alternative open-ended through a rule keeps a Direct branch.
global OP_INDIRECT_WILDCARD_G4: String = "
grammar T;
e : e ( w | A ) | C ;
w : . ;
A : 'a' ;
C : 'c' ;
";

// `w` is open-ended, but through a rule reference: its first set is empty for
// the same reason a surface `.`'s is, and it is not the empty alternative.
global INDIRECT_WILDCARD_ALT_G4: String = "
grammar T;
s : w EOF # Wild
  | A EOF # Named
  ;
w : . ;
A : 'a' ;
";

// A wildcard-led alternative admits every token *exactly*, and its index still
// competes: ANTLR4 takes the lowest viable alternative, so `. EOF` wins over
// `A EOF` on `a`. Unlike an empty alternative, it must not be reordered.
global WILDCARD_FIRST_ALT_G4: String = "
grammar T;
s : . EOF # Wild
  | A EOF # Named
  ;
A : 'a' ;
";

// A rule's own alternatives are a decision too, and an empty one among them is
// selected by no lookahead.
global RULE_LEVEL_EMPTY_ALT_G4: String = "
grammar T;
x : A | | B ;
A : 'a' ;
B : 'b' ;
";

// An LR suffix's group body is walked by the op-only walker, which reads the
// dispatch lower baked rather than the surface alternatives.
global OP_WALKER_EMPTY_ALT_G4: String = "
grammar T;
e : e ( A x | | B x ) | C ;
x : C ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
";

test "an undecided dispatch keeps every alternative reachable" {
    // The chain that is not handed a decision built its own conditions, so the
    // empty alternative's absent first set rendered as `true` there and left
    // `B` behind a test that can never fail.
    let mut g = parse(UNDECIDED_EMPTY_ALT_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_r__inner(");
    assert count_substr(&body, &"else if true") == 0, `an unconditional arm shadows what follows it: ${body}`;
    assert count_substr(&body, &"TK_B") > 0, `alt B is unreachable: ${body}`;
}

test "an empty alternative keeps its fallback where the follow set is a prefix" {
    // A follow set the caller's FOLLOW still extends names only part of what
    // selects the empty alternative. Written in as the whole set, it rejects
    // every lookahead the caller could supply — here `;`, a legal parse where
    // `r` derives nothing.
    let mut g = parse(INEXACT_FOLLOW_EMPTY_ALT_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_r__inner(");
    assert count_substr(&body, &"grp_kind == TK_C") == 0, `a prefix of the follow set became the whole test: ${body}`;
    assert count_substr(&body, &"no_viable") == 0, `the group can match nothing, so it cannot report: ${body}`;
    assert count_substr(&body, &"TK_B") > 0, `alt B is unreachable: ${body}`;
}

test "the overlap rule dispatch orders its fallback last too" {
    let mut g = parse(RULE_OVERLAP_EMPTY_ALT_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_x__inner(");
    let empty_arm = find_index(&body, &"if true");
    let a_arm = find_index(&body, &"if kind == TK_A");
    assert a_arm >= 0, `the A-led alternatives lost their arm: ${body}`;
    assert empty_arm > a_arm, `the empty alternative runs before A can be tested: ${body}`;
}

test "an optional over a wildcard has no first set to guard on" {
    // A guard is a site where an empty set means "nothing is excluded". The
    // renderer no longer answers that for its callers, so a guard that can be
    // handed one has to say so — and this one panicked the generator until it
    // did.
    let mut g = parse(WILDCARD_OPTIONAL_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_s__inner(");
    assert count_substr(&body, &"p.any()") > 0, `the wildcard body must still be emitted: ${body}`;
}

test "a nullable alternative with a first set keeps its index" {
    // Nullable is not the same as untestable. `A?` can match nothing, but a
    // lookahead of `a` selects it, so it is not the arm that goes last —
    // demoting it lets `B` take the `b` that the rule's caller needs.
    let mut g = parse(NULLABLE_BUT_SELECTABLE_ALT_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_r__inner(");
    let opt_arm = find_index(&body, &"scope:");
    let b_arm = find_index(&body, &"kind == TK_B");
    assert opt_arm >= 0, `the nullable alternative lost its arm: ${body}`;
    assert b_arm < 0 || opt_arm < b_arm, `a nullable alternative is not the trailing arm: ${body}`;
}

test "a wildcard behind a nullable prefix still makes its alternative open-ended" {
    // Having a first set does not settle it: `A? .` is selected by `a` and also
    // by every other token. Reading the first set alone said "narrow", and the
    // group was then partitioned by `{A}` with `c` reaching no alternative.
    let mut g = parse(PREFIXED_WILDCARD_ALT_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_s__inner(");
    assert count_substr(&body, &"no_viable") == 0, `a token the wildcard matches must reach it: ${body}`;
}

test "an epsilon alternative earns its follow set however it is spelled" {
    // Lower decided which alternative gets the group's follow set by counting
    // elements while everything else on this path asks nullability, so
    // `( A | x | B )` lost the branch and the report that `( A | | B )` gets.
    let mut g = parse(INDIRECT_EPSILON_ADMITS_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_s__inner(");
    assert count_substr(&body, &"grp_kind == TK_EOF") > 0, `the epsilon alternative must test the follow set: ${body}`;
    assert count_substr(&body, &"no viable alternative") > 0, `a lookahead no alternative admits must report: ${body}`;
}

test "an alternative that derives only epsilon through a rule is selected by its follow" {
    // `x` matches nothing, so what selects it is what follows the group — the
    // same answer a written-empty alternative gets, and it earns it however it
    // is spelled. Reading the surface elements called `x` non-empty, so it
    // took neither the follow set nor the trailing arm and the `A` arm behind
    // it was dead. ANTLR4 parses `b` as `(s x b)` and `a b` as `(s a b)`.
    let mut g = parse(INDIRECT_EPSILON_ALT_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_s__inner(");
    assert count_substr(&body, &"else if true") == 0, `an unconditional arm shadows what follows it: ${body}`;
    assert count_substr(&body, &"grp_kind == TK_A") > 0, `the A alternative lost its test: ${body}`;
    assert count_substr(&body, &"grp_kind == TK_B") > 0, `the epsilon alternative must test the follow set: ${body}`;
}

test "the op walker keeps an alternative open-ended through a rule in place" {
    let mut g = parse(OP_INDIRECT_WILDCARD_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_e__inner(");
    let wild_arm = find_index(&body, &"_parse_w(p)");
    let named_arm = find_index(&body, &"_gk == TK_A");
    assert wild_arm >= 0, `the open-ended alternative lost its arm: ${body}`;
    assert named_arm < 0 || wild_arm < named_arm, `it was demoted behind a later alternative: ${body}`;
}

test "an alternative open-ended through a rule keeps its index too" {
    // An empty first set says nothing about the surface element that produced
    // it. Asking `alt_is_wildcard_led` answers for a `.` written in place and
    // not for one reached through `w`, so this alternative was read as the
    // empty one and demoted behind `A`.
    let mut g = parse(INDIRECT_WILDCARD_ALT_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_s__inner(");
    let wild_arm = find_index(&body, &"scope:");
    let named_arm = find_index(&body, &"TK_A");
    assert wild_arm >= 0, `the open-ended alternative lost its arm: ${body}`;
    assert named_arm < 0 || wild_arm < named_arm, `it was moved past a later alternative: ${body}`;
}

test "a wildcard alternative keeps its index against a narrower one" {
    // It admits everything and shadowing what follows is the correct answer
    // here — lowest viable alternative wins. Only an alternative no lookahead
    // can test belongs at the end.
    let mut g = parse(WILDCARD_FIRST_ALT_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_s__inner(");
    // A rule's unconditional arm is a bare `scope:` block, not `if true`.
    let wild_arm = find_index(&body, &"scope:");
    let named_arm = find_index(&body, &"TK_A");
    assert wild_arm >= 0, `the wildcard alternative lost its arm: ${body}`;
    assert named_arm < 0 || wild_arm < named_arm, `the wildcard alternative was moved past a later one: ${body}`;
}

test "a rule's empty alternative does not shadow the ones after it" {
    // A rule's arms are guarded `if`s that return, so an unconditional one is
    // the same dead-code hazard as an `else if true` in a group's chain: it
    // belongs after every arm a lookahead can select.
    let mut g = parse(RULE_LEVEL_EMPTY_ALT_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_x__inner(");
    let empty_arm = find_index(&body, &"scope:");
    let b_arm = find_index(&body, &"TK_B");
    assert b_arm >= 0, `alt B is missing: ${body}`;
    assert empty_arm > b_arm, `the empty alternative runs before B can be tested: ${body}`;
}

test "the op walker's undecided chain keeps every alternative reachable" {
    // The op walker reads lower's baked branches, where an alternative no
    // lookahead selects carries an empty token set — the same absence, and the
    // same `true`, one emitter further out.
    let mut g = parse(OP_WALKER_EMPTY_ALT_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_e__inner(");
    assert count_substr(&body, &"else if true") == 0, `an unconditional arm shadows what follows it: ${body}`;
    assert count_substr(&body, &"TK_B") > 0, `alt B is unreachable: ${body}`;
}

test "a wildcard puts every alternative in one branch, epsilon included" {
    // `( A | . | )`: the wildcard admits every token, so no lookahead test
    // separates any alternative from it — all three share the tournament and
    // the scan lengths decide, with the empty alternative ranked as epsilon.
    // Partitioned apart it became an arm behind the wildcard's unconditional
    // one, which no input could reach.
    let mut g = parse(WILDCARD_AND_EMPTY_ALT_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_r__inner(");
    assert count_substr(&body, &"if true") == 0, `one branch over every alternative needs no chain: ${body}`;
    assert count_substr(&body, &"gd_tourney") > 0, `the three alternatives must share a tournament: ${body}`;
    // Epsilon is `p.pos` — the empty alternative measured without scanning.
    assert count_substr(&body, &"= p.pos;") > 0, `the empty alternative must be ranked, not dropped: ${body}`;
}

test "dispatch branches sharing a sub-dispatch are emitted once" {
    let mut g = parse(SHARED_SUBDISPATCH_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    let body = extract_fn_body(&output, &"fn _parse_tp__inner(");
    let copies = count_substr(&body, &"p.peek_at(1)");
    assert copies > 0, `expected a depth-1 sub-dispatch in tp: ${body}`;
    assert copies <= 2, `sub-dispatch duplicated once per first token (${copies} copies): ${body}`;
    assert count_substr(&body, &"if p.peek_kind() == TK_A") == 0, `A got its own branch: ${body}`;
}

// Alt 1 (`n`) is reachable from the {A,B} partition it shares with alt 0 and
// from its own {C} partition, so its body must be hoisted, not copied twice.
global REPEATED_SCAN_ALT_G4: String = "
grammar T;
s : e EOF ;
e : f '(' ')' | n | K ;
f : A | B ;
n : A | B | C ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
K : 'k' ;
WS : [ \\t\\r\\n]+ -> skip ;
";

test "a scan alt reached from several partitions is emitted once" {
    let mut g = parse(REPEATED_SCAN_ALT_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    assert str_contains(&output, &"fn scan_e_alt_1("), `alt 1 was not hoisted into a helper: ${output}`;
    let scan_e = extract_fn_body(&output, &"fn scan_e(");
    assert count_substr(&scan_e, &"scan_e_alt_1(tokens, start") == 2, `both partitions must call the hoisted helper: ${scan_e}`;
    assert count_substr(&scan_e, &"scan_n(tokens, pos") == 0, `alt 1 body still inlined in scan_e: ${scan_e}`;
}

test "a scan alt reached once stays inline" {
    let mut g = parse(REPEATED_SCAN_ALT_G4).unwrap();
    let output = generate(&mut g, &DEFAULT_OPTIONS).source;
    assert !str_contains(&output, &"fn scan_e_alt_2("), `single-use alt 2 was hoisted: ${output}`;
}
