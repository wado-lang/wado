    let output = generate(&mut grammar, &DEFAULT_OPTIONS).source;
    assert str_contains(&output, &"best_set_mode");
    assert str_contains(&output, &"best_set_mode = 1");
    assert str_contains(&output, &"current_mode = best_set_mode");
}

