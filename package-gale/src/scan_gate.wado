//! Which gate actions a scan can simulate as it walks, so a tournament crossing
//! one measures the length the parse will take rather than one it refuses.
//!
//! Passing the parser in does not answer it. The flag is parse-time state and
//! the scan is lookahead, so an outer tournament scanning over an `if` head
//! reads the value from before the head. Only an action needing nothing but the
//! walk can be simulated: `field = <int literal>`, and the `locals` + `@init` /
//! `@after` pair that scopes one. Anything else leaves the gate unsimulated, as
//! it was before this existed.

use { Element, Grammar, ParserRule } from "./ir.wado";
use { to_snake_case } from "./ident.wado";

/// The generated global the scan mutates, and its struct type.
pub global SCAN_GATE_HANDLE: String = "SCAN_GATE";
pub global SCAN_GATE_TYPE: String = "ScanGate";

/// `field = <int literal>`, with an optional trailing `;` and any surrounding
/// whitespace — the whole body, not a prefix of it. Returns the snake_cased
/// field and the value.
pub fn gate_assignment(text: &String) -> Option<[String, i32]> {
    let stmts = statements(text);
    if stmts.len() != 1 {
        return null;
    }
    let [name, rhs] = match one_assignment(&stmts[0]) {
        Some(pair) => pair,
        None => {
            return null;
        },
    };
    if !is_plain_ident(&name) {
        return null;
    }
    return match i32::from_str_radix(&rhs, 10) {
        Ok(value) => Option::Some([to_snake_case(&name), value]),
        Err(_) => null,
    };
}

/// `lhs = rhs` with both sides trimmed, or `null` when the text is not one
/// assignment. `==` leaves the `=` on the right-hand side, which is how a
/// comparison is told from an assignment.
fn one_assignment(text: &String) -> Option<[String, String]> {
    let [lhs, rhs] = match text.split_once("=") {
        Some(pair) => pair,
        None => {
            return null;
        },
    };
    let name = lhs.trim();
    let value = rhs.trim();
    if name.is_empty() || value.is_empty() || value.starts_with("=") {
        return null;
    }
    return Option::Some([name, value]);
}

/// Whether a rendered predicate reads nothing but simulated gate fields.
///
/// Take the simulated reads out and see what is left. What a condition may keep
/// is operators, digits and space; any name still standing is a read the scan
/// cannot answer — an unsimulated field, or the parser — and leaves the gate
/// unsimulated, which is the behaviour before this existed.
///
/// Longest field first, because one field name can be a prefix of another:
/// taking `SCAN_GATE.no_struct` out of `SCAN_GATE.no_struct_tail` leaves
/// `_tail`. Asking for a name rather than for the handles is what sees that
/// leftover — and the parser handle is one letter, so asking whether it appears
/// anywhere answers yes inside `depth`.
pub fn reads_only_scan_gate_fields(code: &String, fields: &List<String>) -> bool {
    let mut rest = *code;
    for let f of fields.sorted_by(|a: &String, b: &String| b.len().cmp(&a.len())) {
        rest = rest.replace(`${SCAN_GATE_HANDLE}.${f}`, "");
    }
    return rest.find_char(|c| c == '_' || c.is_ascii_alphabetic()) matches { None };
}

/// Whether the assigned name is a bare identifier. A receiver (`this.f`) or a
/// subscript is a write a scan cannot claim to run, and both differ from a
/// field name only by a character the name may not hold.
fn is_plain_ident(name: &String) -> bool {
    if name.is_empty() {
        return false;
    }
    return name.find_char(|c| !(c == '_' || c.is_ascii_alphanumeric())) matches { None };
}

/// A rule that sets a gate field for its own extent and puts it back after.
///
/// ANTLR4 spells it `locals` + `@init` / `@after`. A members field alone
/// cannot express the restore, because the value to restore to is per
/// invocation.
///
/// The pair has to be exactly `@init { $L = <field>; <field> = <int>; }` and
/// `@after { <field> = $L; }`: a scan runs it by saving into a local of its own
/// and putting it back, which is the same thing the parse does with `vals`.
pub struct GateScope {
    pub field: String,
    pub value: i32,
}

/// The gate scope `rule` opens, or `null`.
pub fn gate_scope(rule: &ParserRule) -> Option<GateScope> {
    let init = match &rule.init_action {
        Some(a) => a.text,
        None => {
            return null;
        },
    };
    let after = match &rule.after_action {
        Some(a) => a.text,
        None => {
            return null;
        },
    };
    // `<field> = $L`, and the whole of `@after`: a body that does anything else
    // does more than a scan can put back.
    let restores = statements(&after);
    if restores.len() != 1 {
        return null;
    }
    let [restored, local] = match one_assignment(&restores[0]) {
        Some(pair) => pair,
        None => {
            return null;
        },
    };
    if !local.starts_with("$") {
        return null;
    }
    let stmts = statements(&init);
    if stmts.len() != 2 {
        return null;
    }
    // `$L = <field>` — the save fills the local the restore reads.
    let [saved_into, saved_from] = match one_assignment(&stmts[0]) {
        Some(pair) => pair,
        None => {
            return null;
        },
    };
    if saved_into != local || saved_from != restored {
        return null;
    }
    return match gate_assignment(&stmts[1]) {
        Some(w) => if w.0 == to_snake_case(&restored) {
            Option::Some(GateScope { field: w.0, value: w.1 });
        } else {
            null;
        },
        None => null,
    };
}

/// The `;`-separated statements of a body, empties dropped.
fn statements(text: &String) -> List<String> {
    let mut out: List<String> = [];
    for let part of text.split(";") {
        let stmt = part.trim();
        if !stmt.is_empty() {
            out.push(stmt);
        }
    }
    return out;
}

/// Every field the grammar's parser actions assign an integer literal to,
/// snake_cased, first-assignment order.
///
/// A field is simulable only while *every* body naming it is one the scan can
/// run — `gate_assignment`, or the `gate_scope` pair. One the scan cannot run
/// disqualifies every name in it, because what such a body does to a name it
/// mentions is exactly what we could not read.
///
/// "Every body" is the whole grammar: a rule's `@init` / `@after` reach a gate
/// field as much as an alternative's action does, and a group's alternatives
/// carry actions the parse runs where lowering puts no gate on the scan.
pub fn scan_gate_fields(grammar: &Grammar) -> List<String> {
    let mut simulable: List<String> = [];
    let mut rejected: List<String> = [];
    for let rule of &grammar.parser_rules {
        if gate_scope(rule) matches { None } {
            for let text of rule_prequel_bodies(rule) {
                push_new(&mut rejected, mentioned_names(&text));
            }
        }
        for let alt of &rule.alternatives {
            for let a of &alt.actions {
                if a.kind matches { Predicate } {
                    continue;
                }
                match gate_assignment(&a.source.text) {
                    Some(hit) => {
                        if !simulable.contains(&hit.0) {
                            simulable.push(hit.0);
                        }
                    },
                    None => {
                        push_new(&mut rejected, mentioned_names(&a.source.text));
                    },
                }
            }
            // An inline group's own alternatives carry actions too, and the
            // parse runs them. Lowering puts no gates on a group alternative's
            // scan body, so the scan cannot — a field written in there is one
            // the two sides would disagree about however it is written.
            reject_nested_writes(&alt.elements, &mut rejected);
        }
    }
    return simulable.iter_ref().filter(|f| !rejected.contains(f)).map(|f| *f).collect();
}

/// Every name an action inside a nested group mentions, added to the refused
/// set: lowering puts no gate on a group alternative's scan body, so the scan
/// cannot run any of them.
fn reject_nested_writes(elements: &List<Element>, rejected: &mut List<String>) {
    for let e of elements {
        reject_element_writes(e, rejected);
    }
}

fn reject_element_writes(e: &Element, rejected: &mut List<String>) {
    match e {
        Group(g) => {
            for let alt of &g.alternatives {
                for let a of &alt.actions {
                    if !a.kind matches { Predicate } {
                        push_new(rejected, mentioned_names(&a.source.text));
                    }
                }
                reject_nested_writes(&alt.elements, rejected);
            }
        },
        Repeat(r) => reject_element_writes(&r.element, rejected),
        Label(l) => reject_element_writes(&l.element, rejected),
        Not(n) => reject_element_writes(&n.element, rejected),
        // Named rather than left to a `_`, so an `Element` variant that can hold
        // an action does not silently keep its field simulable.
        RuleRef(_) | TokenRef(_) | Literal(_) | Wildcard(_) => {
        },
    }
}

fn push_new(out: &mut List<String>, names: List<String>) {
    for let name of names {
        if !out.contains(&name) {
            out.push(name);
        }
    }
}

/// A rule's `@init` and `@after` bodies, whichever it has.
fn rule_prequel_bodies(rule: &ParserRule) -> List<String> {
    let mut out: List<String> = [];
    if let Some(a) = &rule.init_action {
        out.push(a.text);
    }
    if let Some(a) = &rule.after_action {
        out.push(a.text);
    }
    return out;
}

/// Every name a body mentions, snake_cased — the disqualifying set.
///
/// The whole of it, not the assignment targets in it. Which names a body writes
/// is a question about the host language's syntax, and every answer that
/// enumerates write shapes has a shape it does not know: matching `f = 0` alone
/// misses `if (c) f = 0;`, and matching `=` at all misses `f++`. A body the scan
/// cannot run tells us nothing about which of its names it leaves alone, so all
/// of them stop being simulable.
///
/// Over-rejecting only ever leaves a gate unsimulated, which is the behaviour
/// before any of this existed. Under-rejecting is a scan reading a value the
/// parse never holds.
fn mentioned_names(text: &String) -> List<String> {
    let mut out: List<String> = [];
    let mut start = -1;
    for let [index, c] of text.char_indices() {
        let in_name = c == '_' || c.is_ascii_alphanumeric();
        if in_name && start < 0 {
            start = index;
        } else if !in_name && start >= 0 {
            push_name(&mut out, &text.substr_bytes(start, index));
            start = -1;
        }
    }
    if start >= 0 {
        push_name(&mut out, &text.substr_bytes(start, text.len()));
    }
    return out;
}

fn push_name(out: &mut List<String>, word: &String) {
    let name = to_snake_case(word);
    if !out.contains(&name) {
        out.push(name);
    }
}
