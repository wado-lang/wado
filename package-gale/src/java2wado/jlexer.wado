//! Java tokenizer for the java2wado expression subset. A `$name(.member)?`
//! attribute reference lexes as one opaque `Attr` token (resolved later by the
//! language-independent attribute engine); string literals keep raw escapes.

use {
    is_id_start_char,
    is_id_continue_char,
    scan_closed_string,
    scan_line_comment,
    scan_block_comment,
} from "../g4/scan.wado";
use { collect_range } from "../text.wado";
use { attr_ref_at } from "../attr_scan.wado";

pub variant JToken {
    Ident(String),
    /// Full `$name(.member)?` text, delimiters kept.
    Attr(String),
    Int(String),
    Str(String),
    Punct(String),
}

pub fn tokenize_java<S: AsStrSlice>(body: S) -> Result<List<JToken>, String> {
    let chars: List<char> = body.chars().collect();
    let n = chars.len();
    let mut out: List<JToken> = [];
    let mut i = 0;
    while i < n {
        let c = chars[i];
        if c.is_ascii_whitespace() {
            i += 1;
            continue;
        }
        if c == '/' && i + 1 < n && chars[i + 1] == '/' {
            i = scan_line_comment(&chars, i);
            continue;
        }
        if c == '/' && i + 1 < n && chars[i + 1] == '*' {
            i = scan_block_comment(&chars, i);
            continue;
        }
        if c == '"' {
            let Some(e) = scan_closed_string(&chars, i) else {
                return Result::Err("java2wado: unterminated string literal in action body");
            };
            out.push(JToken::Str(collect_range(&chars, i + 1, e - 1)));
            i = e;
            continue;
        }
        if let Some(r) = attr_ref_at(&chars, i, n) {
            out.push(JToken::Attr(collect_range(&chars, i, r.end)));
            i = r.end;
            continue;
        }
        if is_id_start_char(c) {
            let mut j = i + 1;
            while j < n && is_id_continue_char(chars[j]) {
                j += 1;
            }
            out.push(JToken::Ident(collect_range(&chars, i, j)));
            i = j;
            continue;
        }
        if c.is_ascii_digit() {
            let mut j = i + 1;
            while j < n && chars[j].is_ascii_digit() {
                j += 1;
            }
            out.push(JToken::Int(collect_range(&chars, i, j)));
            i = j;
            continue;
        }
        match scan_punct(&chars, i, n) {
            Some(p) => {
                i += p.chars().count();
                out.push(JToken::Punct(p));
            },
            None => {
                return Result::Err(`java2wado: unexpected character '${c}' in action body`);
            },
        }
    }
    return Result::Ok(out);
}

/// Longest operator / punctuation token at `pos` (two-char before one-char).
fn scan_punct(chars: &List<char>, pos: i32, n: i32) -> Option<String> {
    if pos + 1 < n {
        let two = collect_range(chars, pos, pos + 2);
        if is_two_char_op(&two) {
            return Option::Some(two);
        }
    }
    let c = chars[pos];
    if is_one_char_punct(c) {
        let mut s = String::with_capacity(1);
        s.push(c);
        return Option::Some(s);
    }
    return null;
}

fn is_two_char_op<S: AsStrSlice>(s: S) -> bool {
    return s matches { "==" | "!=" | ">=" | "<=" | "&&" | "||" | "+=" | "-=" | "*=" | "/=" | "++" | "--" };
}

fn is_one_char_punct(c: char) -> bool {
    return c == '+'
        || c == '-'
        || c == '*'
        || c == '/'
        || c == '%'
        || c == '<'
        || c == '>'
        || c == '!'
        || c == '='
        || c == '.'
        || c == ','
        || c == ':'
        || c == ';'
        || c == '('
        || c == ')'
        || c == '{'
        || c == '}';
}
