//! Java tokenizer for the java2wado expression subset. A `$name(.member)?`
//! attribute reference lexes as one opaque `Attr` token (resolved later by the
//! language-independent attribute engine); string literals keep raw escapes.

use { name_end, scan_closed_string, scan_line_comment, scan_block_comment } from "../g4/scan.wado";
use { char_at } from "../runtime/lex.wado";
use { attr_ref_span } from "../attr_scan.wado";

pub variant JToken {
    Ident(String),
    /// Full `$name(.member)?` text, delimiters kept.
    Attr(String),
    Int(String),
    Str(String),
    Punct(String),
}

pub fn tokenize_java<S: AsStrSlice>(body: S) -> Result<List<JToken>, String> {
    let src = body.as_str_slice();
    let n = src.len();
    let mut out: List<JToken> = [];
    let mut i = 0;
    while i < n {
        let b = src.byte_at(i);
        if b.is_ascii_whitespace() {
            i += 1;
            continue;
        }
        if b == b'/' && i + 1 < n && src.byte_at(i + 1) == b'/' {
            i = scan_line_comment(&src, i);
            continue;
        }
        if b == b'/' && i + 1 < n && src.byte_at(i + 1) == b'*' {
            i = scan_block_comment(&src, i);
            continue;
        }
        if b == b'"' {
            let Some(e) = scan_closed_string(&src, i) else {
                return Result::Err("java2wado: unterminated string literal in action body");
            };
            out.push(JToken::Str(src.slice(i + 1, e - 1).to_string()));
            i = e;
            continue;
        }
        if let Some([_, end]) = attr_ref_span(&src, i, n) {
            out.push(JToken::Attr(src.slice(i, end).to_string()));
            i = end;
            continue;
        }
        let name = name_end(&src, i, n);
        if name > i {
            out.push(JToken::Ident(src.slice(i, name).to_string()));
            i = name;
            continue;
        }
        if b.is_ascii_digit() {
            let mut j = i + 1;
            while j < n && src.byte_at(j).is_ascii_digit() {
                j += 1;
            }
            out.push(JToken::Int(src.slice(i, j).to_string()));
            i = j;
            continue;
        }
        match scan_punct(&src, i, n) {
            Some(p) => {
                i += p.len();
                out.push(JToken::Punct(p));
            },
            None => {
                return Result::Err(`java2wado: unexpected character '${char_at(&src, i)}' in action body`);
            },
        }
    }
    return Result::Ok(out);
}

/// Longest operator / punctuation token at `pos` (two-char before one-char).
fn scan_punct(src: &StrSlice, pos: i32, n: i32) -> Option<String> {
    if pos + 1 < n {
        let two = src.slice(pos, src.ceil_char_boundary(pos + 2));
        if is_two_char_op(two) {
            return Option::Some(two.to_string());
        }
    }
    let b = src.byte_at(pos);
    if is_one_char_punct(b) {
        return Option::Some(src.slice(pos, pos + 1).to_string());
    }
    return null;
}

fn is_two_char_op<S: AsStrSlice>(s: S) -> bool {
    return s matches { "==" | "!=" | ">=" | "<=" | "&&" | "||" | "+=" | "-=" | "*=" | "/=" | "++" | "--" };
}

fn is_one_char_punct(b: u8) -> bool {
    return b matches { b'+' | b'-' | b'*' | b'/' | b'%' | b'<' | b'>' | b'!' | b'=' | b'.' | b',' | b':' | b';' | b'(' | b')' | b'{' | b'}' };
}
