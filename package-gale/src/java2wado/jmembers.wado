//! Translate a Java `@members` class body to Wado struct fields + methods.
//! Method bodies reuse the statement translator with the recognizer handle bound
//! to `self`; a synthetic empty rule stands in for the absent value channel.

use { ParserRule, Visibility } from "../ir.wado";
use { JToken } from "./jlexer.wado";
use { tokenize_java } from "./jlexer.wado";
use { parse_java_stmts, parse_java_expr, punct_is, ident_at, JExpr, JStmt } from "./jparser.wado";
use { emit_java_stmts, emit_expr, map_java_type, with_locals, JEnv } from "./jemit.wado";
use { to_snake_case } from "../ident.wado";
use { AltBinding } from "../attr_resolve.wado";

/// One field on the generated recognizer struct, from a `@members` field decl.
pub struct MemberField {
    pub name: String,
    pub ty: String,
    pub init: String,
}

/// One method a `@members` block contributes: its snake_cased name, whether it
/// takes `&mut self`, and the ready-to-splice `fn ... { ... }` source.
pub struct MemberMethod {
    pub name: String,
    /// A lexer predicate holds `&Lexer` — the tournament must not mutate through
    /// a losing candidate — so a call to a mutating method from one is refused
    /// rather than emitted as Wado the compiler would reject.
    pub mutates: bool,
    pub source: String,
}

/// The struct fields and methods a `@members` block contributes.
pub struct MemberDecls {
    pub fields: List<MemberField>,
    pub methods: List<MemberMethod>,
}

/// What an action / predicate body may resolve a bare name against: the
/// `@members` methods and fields the grammar declares, plus which of the methods
/// write through the recognizer. All snake_cased, as the declarations are.
pub struct MemberNames {
    pub methods: List<String> = [],
    pub fields: List<String> = [],
    /// Only consulted where the handle is a shared reference (a lexer
    /// predicate); a name scan that has not translated the bodies leaves it
    /// empty, which is why the scan never feeds a lexer body.
    pub mutating: List<String> = [],
}

/// The names translated members declare.
pub fn member_names(members: &MemberDecls) -> MemberNames {
    let mut out = MemberNames {};
    for let m of &members.methods {
        out.methods.push(m.name);
        if m.mutates {
            out.mutating.push(m.name);
        }
    }
    for let f of &members.fields {
        out.fields.push(f.name);
    }
    return out;
}

/// A method as parsed, before its receiver is known: which methods mutate is a
/// fixed point over the whole block, so no body can be emitted until every one
/// has been read.
struct ParsedMethod {
    name: String,
    params: List<[String, String]>,
    ret_java: String,
    stmts: List<JStmt>,
}

/// Translate a `@members` block body to fields + methods. `grammar_name` keys the
/// `<Name>Parser` token-constant qualifier; a call inside a method body resolves
/// against the block's own method names.
pub fn translate_java_members(body: &String, grammar_name: &String) -> Result<MemberDecls, String> {
    let tokens = tokenize_java(body)?;
    // A method body resolves names against the whole block: its siblings, and
    // the fields declared after it as much as before it.
    let scanned = scan_member_names(&tokens);
    let env = JEnv {
        this_bind: "self",
        grammar: *grammar_name,
        methods: scanned.methods,
        fields: scanned.fields,
    };
    let mut fields: List<MemberField> = [];
    let mut parsed: List<ParsedMethod> = [];
    let mut pos = 0;
    while pos < tokens.len() {
        skip_modifiers(&tokens, &mut pos);
        if pos >= tokens.len() {
            break;
        }
        let ty = member_ident(&tokens, pos, &"type")?;
        pos += 1;
        let name = member_ident(&tokens, pos, &"name")?;
        pos += 1;
        if punct_is(&tokens, pos, &"(") {
            parsed.push(parse_method(&tokens, &mut pos, &name, &ty)?);
        } else {
            fields.push(parse_field(&tokens, &mut pos, &name, &ty, &env)?);
        }
    }
    let mut_methods = mutating_methods(&parsed);
    let mut methods: List<MemberMethod> = [];
    for let m of &parsed {
        let dummy = ParserRule::new("", Visibility::Default, [], []);
        let no_rules: List<ParserRule> = [];
        let no_bindings: List<AltBinding> = [];
        // The parameters shadow a field of the same name, as Java's scoping does,
        // and so do the body's own locals.
        let mut menv = env;
        for let p of &m.params {
            menv.locals.push(p.0);
        }
        let scoped = with_locals(&menv, &m.stmts);
        let body_wado = emit_java_stmts(&dummy, &no_rules, &m.stmts, false, &no_bindings, &scoped)?;
        let name = to_snake_case(&m.name);
        let mutates = mut_methods.contains(&name);
        let source = build_method(&name, &m.params, &m.ret_java, &body_wado, mutates)?;
        methods.push(MemberMethod { name, mutates, source });
    }
    return Result::Ok(MemberDecls { fields, methods });
}

/// The methods that write through the recognizer: one assigning a field, or
/// calling a method that does. Iterated to a fixed point, so a read-only method
/// keeps `&self` however deep its call chain.
fn mutating_methods(ms: &List<ParsedMethod>) -> List<String> {
    let mut out: List<String> = [];
    let mut changed = true;
    while changed {
        changed = false;
        for let m of ms {
            let name = to_snake_case(&m.name);
            if out.contains(&name) {
                continue;
            }
            let mut scope = param_names(&m.params);
            if stmts_mutate(&m.stmts, &mut scope, &out) {
                out.push(name);
                changed = true;
            }
        }
    }
    return out;
}

fn param_names(params: &List<[String, String]>) -> List<String> {
    let mut out: List<String> = [];
    for let p of params {
        out.push(p.0);
    }
    return out;
}

/// Whether these statements write a field or call a known-mutating method.
/// `scope` grows with each local the list declares, so an assignment to one is
/// not a field write.
fn stmts_mutate(stmts: &List<JStmt>, scope: &mut List<String>, mutators: &List<String>) -> bool {
    for let s of stmts {
        match s {
            Assign(a) => {
                if assigns_field(&a.target, scope) || expr_mutates(&a.value, scope, mutators) {
                    return true;
                }
            },
            Local(l) => {
                if let Some(e) = &l.init {
                    if expr_mutates(e, scope, mutators) {
                        return true;
                    }
                }
                scope.push(l.name);
            },
            Expr(e) => {
                if expr_mutates(e, scope, mutators) {
                    return true;
                }
            },
            Return(v) => {
                if let Some(e) = v {
                    if expr_mutates(e, scope, mutators) {
                        return true;
                    }
                }
            },
            Assert(a) => {
                if expr_mutates(&a.cond, scope, mutators) {
                    return true;
                }
            },
        }
    }
    return false;
}

/// Whether an assignment target names a recognizer field: `this.x`, or a bare
/// name the method did not declare.
fn assigns_field(target: &JExpr, scope: &List<String>) -> bool {
    return match target {
        Name(n) => !scope.contains(n),
        Member(m) => match &m.recv {
            Name(q) => *q == "this",
            _ => false,
        },
        _ => false,
    };
}

fn expr_mutates(e: &JExpr, scope: &List<String>, mutators: &List<String>) -> bool {
    return match e {
        Call(c) => {
            // `System.out.print` appends to the recognizer's output sink, which
            // is a write like any field's.
            if is_print_call(&c.callee) || mutators.contains(&to_snake_case(&call_method_name(&c.callee))) {
                return true;
            }
            // The callee too: `this.bump().toString()` hides the write one
            // receiver down.
            if expr_mutates(&c.callee, scope, mutators) {
                return true;
            }
            for let a of &c.args {
                if expr_mutates(a, scope, mutators) {
                    return true;
                }
            }
            false;
        },
        // `x++` / `--x` write their operand.
        Unary(u) => (u.op == "++" || u.op == "--") && assigns_field(&u.operand, scope)
            || expr_mutates(&u.operand, scope, mutators),
        Member(m) => expr_mutates(&m.recv, scope, mutators),
        Cast(c) => expr_mutates(&c.operand, scope, mutators),
        Binary(b) => expr_mutates(&b.lhs, scope, mutators) || expr_mutates(&b.rhs, scope, mutators),
        Paren(p) => expr_mutates(&p.inner, scope, mutators),
        Int(_) | Str(_) | Bool(_) | Attr(_) | Name(_) => false,
    };
}

/// Whether the callee is a qualified `print` / `println` — the sink write. A
/// bare one is a member method and resolves as such.
fn is_print_call(callee: &JExpr) -> bool {
    return match callee {
        Member(m) => m.name == "print" || m.name == "println",
        _ => false,
    };
}

/// The method name a callee names, whether written bare or through `this.`.
fn call_method_name(callee: &JExpr) -> String {
    return match callee {
        Name(n) => *n,
        Member(m) => m.name,
        _ => "",
    };
}

/// The snake_cased names a `@members` block declares, for resolving calls and
/// bare names in other action bodies. Best-effort: a malformed block yields the
/// names it can, and the real translation reports the error.
pub fn java_member_names(body: &String) -> MemberNames {
    return match tokenize_java(body) {
        Ok(tokens) => scan_member_names(&tokens),
        Err(_) => MemberNames {},
    };
}

fn scan_member_names(tokens: &List<JToken>) -> MemberNames {
    let mut out = MemberNames {};
    let mut pos = 0;
    while pos < tokens.len() {
        skip_modifiers(tokens, &mut pos);
        if pos + 1 >= tokens.len() {
            break;
        }
        if ident_at(tokens, pos) matches { None } {
            break;
        }
        let name_opt = ident_at(tokens, pos + 1);
        if name_opt matches { None } {
            break;
        }
        pos += 2;
        if punct_is(tokens, pos, &"(") {
            out.methods.push(to_snake_case(&name_opt.unwrap()));
            pos = skip_parens(tokens, pos);
            if !punct_is(tokens, pos, &"{") {
                break;
            }
            let close = find_braced_end(tokens, pos);
            if close matches { Err(_) } {
                break;
            }
            pos = close.unwrap() + 1;
        } else {
            out.fields.push(to_snake_case(&name_opt.unwrap()));
            while pos < tokens.len() && !punct_is(tokens, pos, &";") {
                pos += 1;
            }
            if pos < tokens.len() {
                pos += 1;
            }
        }
    }
    return out;
}

fn skip_parens(tokens: &List<JToken>, open: i32) -> i32 {
    let mut depth = 0;
    for let mut i = open; i < tokens.len(); i += 1 {
        if punct_is(tokens, i, &"(") {
            depth += 1;
        } else if punct_is(tokens, i, &")") {
            depth -= 1;
            if depth == 0 {
                return i + 1;
            }
        }
    }
    return tokens.len();
}

fn parse_field(
    tokens: &List<JToken>,
    pos: &mut i32,
    name: &String,
    ty_java: &String,
    env: &JEnv,
) -> Result<MemberField, String> {
    let ty = match map_java_type(ty_java) {
        Some(t) => t,
        None => {
            return Result::Err(`java2wado: @members: unsupported field type '${*ty_java}'`);
        },
    };
    let init = if punct_is(tokens, *pos, &"=") {
        *pos += 1;
        let slice = collect_until_semi(tokens, pos);
        let e = parse_java_expr(&slice)?;
        emit_member_expr(&e, env)?;
    } else {
        return Result::Err(`java2wado: @members: field '${*name}' needs an initializer`);
    };
    if !punct_is(tokens, *pos, &";") {
        return Result::Err(`java2wado: @members: expected ';' after field '${*name}'`);
    }
    *pos += 1;
    // snake_cased at the declaration, as a method name is: every read of it —
    // `this.nestLevel` and the bare `nestLevel` alike — resolves through
    // `to_snake_case`, so the field must be spelled the same way.
    return Result::Ok(MemberField { name: to_snake_case(name), ty, init });
}

fn parse_method(tokens: &List<JToken>, pos: &mut i32, name: &String, ret_java: &String) -> Result<ParsedMethod, String> {
    let params = parse_params(tokens, pos)?;
    if !punct_is(tokens, *pos, &"{") {
        return Result::Err(`java2wado: @members: expected '\{' for method '${*name}'`);
    }
    let close = find_braced_end(tokens, *pos)?;
    let body_tokens = slice_tokens(tokens, *pos + 1, close);
    *pos = close + 1;
    let stmts = parse_java_stmts(&body_tokens)?;
    return Result::Ok(ParsedMethod { name: *name, params, ret_java: *ret_java, stmts });
}

/// Emit a field initializer, which has no rule / value-channel context.
fn emit_member_expr(e: &JExpr, env: &JEnv) -> Result<String, String> {
    let dummy = ParserRule::new("", Visibility::Default, [], []);
    let no_rules: List<ParserRule> = [];
    let no_bindings: List<AltBinding> = [];
    return emit_expr(&dummy, &no_rules, e, false, &no_bindings, env);
}

/// `&self` unless the body writes: the narrower receiver is what lets a lexer
/// predicate, which holds `&Lexer`, reach a read-only member method at all.
fn build_method(
    name: &String,
    params: &List<[String, String]>,
    ret_java: &String,
    body_wado: &String,
    mutates: bool,
) -> Result<String, String> {
    let recv = if mutates { "&mut self" } else { "&self" };
    let mut sig = `fn ${*name}(${recv}`;
    for let p of params {
        sig.push_str(&`, ${p.0}: ${p.1}`);
    }
    sig.push(')');
    if *ret_java != "void" {
        let rty = match map_java_type(ret_java) {
            Some(t) => t,
            None => {
                return Result::Err(`java2wado: @members: unsupported return type '${*ret_java}'`);
            },
        };
        sig.push_str(&` -> ${rty}`);
    }
    return Result::Ok(`${sig} \{ ${*body_wado} \}`);
}

/// Parse a Java parameter list `( Type name (, Type name)* )`; `pos` at `(`,
/// left just past `)`. Each param is `[name, wado_type]`.
fn parse_params(tokens: &List<JToken>, pos: &mut i32) -> Result<List<[String, String]>, String> {
    *pos += 1;
    let mut ps: List<[String, String]> = [];
    if punct_is(tokens, *pos, &")") {
        *pos += 1;
        return Result::Ok(ps);
    }
    loop {
        let ty = member_ident(tokens, *pos, &"parameter type")?;
        *pos += 1;
        let nm = member_ident(tokens, *pos, &"parameter name")?;
        *pos += 1;
        let wty = match map_java_type(&ty) {
            Some(t) => t,
            None => {
                return Result::Err(`java2wado: @members: unsupported parameter type '${ty}'`);
            },
        };
        ps.push([nm, wty]);
        if punct_is(tokens, *pos, &",") {
            *pos += 1;
            continue;
        }
        if punct_is(tokens, *pos, &")") {
            *pos += 1;
            return Result::Ok(ps);
        }
        return Result::Err("java2wado: @members: expected ',' or ')' in parameter list");
    }
}

fn skip_modifiers(tokens: &List<JToken>, pos: &mut i32) {
    while is_modifier(tokens, *pos) {
        *pos += 1;
    }
}

fn is_modifier(tokens: &List<JToken>, pos: i32) -> bool {
    return match ident_at(tokens, pos) {
        Some(n) => n == "public" || n == "private" || n == "protected" || n == "static" || n == "final",
        None => false,
    };
}

fn member_ident(tokens: &List<JToken>, pos: i32, what: &String) -> Result<String, String> {
    return match ident_at(tokens, pos) {
        Some(n) => Result::Ok(n),
        None => Result::Err(`java2wado: @members: expected ${*what} identifier`),
    };
}

/// Collect tokens from `pos` up to (not including) the next top-level `;`;
/// leaves `pos` at the `;`. Field initializers carry no nested `;`.
fn collect_until_semi(tokens: &List<JToken>, pos: &mut i32) -> List<JToken> {
    let start = *pos;
    while *pos < tokens.len() && !punct_is(tokens, *pos, &";") {
        *pos += 1;
    }
    return slice_tokens(tokens, start, *pos);
}

/// Index of the `}` matching the `{` at `open`, tracking brace depth.
fn find_braced_end(tokens: &List<JToken>, open: i32) -> Result<i32, String> {
    let mut depth = 0;
    for let mut i = open; i < tokens.len(); i += 1 {
        if punct_is(tokens, i, &"{") {
            depth += 1;
        } else if punct_is(tokens, i, &"}") {
            depth -= 1;
            if depth == 0 {
                return Result::Ok(i);
            }
        }
    }
    return Result::Err("java2wado: @members: unterminated method body");
}

fn slice_tokens(tokens: &List<JToken>, start: i32, end: i32) -> List<JToken> {
    let mut out: List<JToken> = [];
    for let mut i = start; i < end; i += 1 {
        out.push(tokens[i]);
    }
    return out;
}
